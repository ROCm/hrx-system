# Public Bazel facade for source dependencies. Source declarations, locks, and
# CMake adapters live under build_tools/third_party/. See
# build_tools/third_party/README.md for dependency ownership and update policy.
# CMake facades are supplied by the dependency-specific adapters.
# bazel-to-cmake: skip

load("@bazel_skylib//lib:selects.bzl", "selects")

package(default_visibility = ["//visibility:private"])

package_group(
    name = "build_tool_users",
    packages = ["//build_tools/..."],
)

package_group(
    name = "runtime_users",
    packages = ["//runtime/..."],
)

package_group(
    name = "libhrx_users",
    packages = ["//libhrx/..."],
)

package_group(
    name = "libamdf_users",
    packages = ["//libamdf/..."],
)

package_group(
    name = "loom_users",
    packages = ["//loom/..."],
)

package_group(
    name = "benchmark_users",
    packages = [
        "//build_tools/...",
        "//libamdf/...",
        "//libhrx/...",
        "//loom/...",
        "//runtime/...",
    ],
)

package_group(
    name = "test_framework_users",
    packages = [
        "//build_tools/...",
        "//libamdf/...",
        "//libhrx/...",
        "//loom/...",
        "//runtime/...",
    ],
)

alias(
    name = "google_benchmark",
    actual = "@com_google_benchmark//:benchmark",
    visibility = [":benchmark_users"],
)

alias(
    name = "google_benchmark_main",
    actual = "@com_google_benchmark//:benchmark_main",
    visibility = [":benchmark_users"],
)

alias(
    name = "google_test",
    actual = "@com_google_googletest//:gtest",
    visibility = [":test_framework_users"],
)

alias(
    name = "google_test_main",
    actual = "@com_google_googletest//:gtest_main",
    visibility = [":test_framework_users"],
)

alias(
    name = "catch2",
    actual = "@catch2//:catch2",
    visibility = [":libhrx_users"],
)

alias(
    name = "amdf_wkmi",
    actual = "//build_tools/third_party/wkmi",
    visibility = [":libamdf_users"],
)

alias(
    name = "linux_drm_uapi",
    actual = "//build_tools/third_party/linux_uapi:linux_drm_uapi",
    tags = ["manual"],
    visibility = [":libamdf_users"],
)

alias(
    name = "linux_amdgpu_uapi",
    actual = "//build_tools/third_party/linux_uapi:linux_amdgpu_uapi",
    tags = ["manual"],
    visibility = [":libamdf_users"],
)

alias(
    name = "linux_kfd_uapi",
    actual = "//build_tools/third_party/linux_uapi:linux_kfd_uapi",
    tags = ["manual"],
    visibility = [":libamdf_users"],
)

alias(
    name = "linux_xdna_uapi",
    actual = "//build_tools/third_party/linux_uapi:linux_xdna_uapi",
    tags = ["manual"],
    visibility = [":libamdf_users"],
)

alias(
    name = "libbacktrace",
    actual = "//build_tools/third_party/libbacktrace",
    visibility = [":runtime_users"],
)

alias(
    name = "zstd",
    actual = "//build_tools/third_party/zstd",
    visibility = [":libhrx_users"],
)

filegroup(
    name = "empty_aqlprofile_sdk_headers",
)

filegroup(
    name = "empty_hsa_runtime_headers",
)

filegroup(
    name = "empty_spirv_tool",
)

filegroup(
    name = "empty_vulkan_headers",
)

alias(
    name = "aqlprofile_sdk_headers",
    actual = select({
        "//runtime/config/hal:driver_amdgpu": "@hsa_runtime_headers//:aqlprofile_sdk_headers",
        "//conditions:default": ":empty_aqlprofile_sdk_headers",
    }),
    tags = ["manual"],
    visibility = [":runtime_users"],
)

alias(
    name = "hsa_runtime_headers",
    actual = selects.with_or({
        (
            "//loom/config/target:amdgpu",
            "//runtime/config/hal:driver_amdgpu",
        ): "@hsa_runtime_headers//:hsa_runtime_headers",
        "//conditions:default": ":empty_hsa_runtime_headers",
    }),
    tags = ["manual"],
    visibility = [
        ":loom_users",
        ":runtime_users",
    ],
)

alias(
    name = "vulkan_headers",
    actual = select({
        "//runtime/config/hal:driver_vulkan": "@vulkan_headers//:headers",
        "//conditions:default": ":empty_vulkan_headers",
    }),
    tags = ["manual"],
    visibility = [
        ":loom_users",
        ":runtime_users",
    ],
)

alias(
    name = "spirv_as",
    actual = selects.with_or({
        (
            "//loom/config/target:spirv_artifacts",
            "//runtime/config/hal:driver_vulkan",
        ): "@spirv_tools//:spirv-as",
        "//conditions:default": ":empty_spirv_tool",
    }),
    tags = ["manual"],
    visibility = [
        ":build_tool_users",
        ":loom_users",
        ":runtime_users",
    ],
)

alias(
    name = "spirv_dis",
    actual = selects.with_or({
        (
            "//loom/config/target:spirv_artifacts",
            "//runtime/config/hal:driver_vulkan",
        ): "@spirv_tools//:spirv-dis",
        "//conditions:default": ":empty_spirv_tool",
    }),
    tags = ["manual"],
    visibility = [
        ":build_tool_users",
        ":loom_users",
        ":runtime_users",
    ],
)

alias(
    name = "spirv_val",
    actual = selects.with_or({
        (
            "//loom/config/target:spirv_artifacts",
            "//runtime/config/hal:driver_vulkan",
        ): "@spirv_tools//:spirv-val",
        "//conditions:default": ":empty_spirv_tool",
    }),
    tags = ["manual"],
    visibility = [
        ":build_tool_users",
        ":loom_users",
        ":runtime_users",
    ],
)
