load("//build_tools/bazel:select.bzl", "iree_select")
load(
    "//libhrx/build_tools/bazel:cc.bzl",
    "hrx_cc_library",
    "hrx_cc_shared_library",
    "hrx_cc_test",
)

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

HRX_SRCS = [
    "allocator.c",
    "buffer.c",
    "buffer_table.c",
    "buffer_view.c",
    "device.c",
    "event.c",
    "executable.c",
    "fence.c",
    "graph.c",
    "graph_analysis.c",
    "graph_exec.c",
    "host_allocator.c",
    "mem_pool.c",
    "pool.c",
    "queue_ops.c",
    "runtime.c",
    "semaphore.c",
    "status.c",
    "stream.c",
    "transfer.c",
    "vmm_slab_provider.c",
    "vmm_slab_provider.h",
]

HRX_HDRS = [
    "buffer_table.h",
    "hrx_internal.h",
    "mem_pool.h",
    "transfer.h",
    "//libhrx/src:iree_hal_compat.h",
]

HRX_INCLUDES = [
    ".",
    "..",
    "../../include",
]

HRX_DEPS = [
    "//build_tools/bazel:dl",
    "//runtime/src/iree/async",
    "//runtime/src/iree/base",
    "//runtime/src/iree/base:core_headers",
    "//runtime/src/iree/base/internal",
    "//runtime/src/iree/base/internal:arena",
    "//runtime/src/iree/base/threading",
    "//runtime/src/iree/async/util:proactor_pool",
    "//runtime/src/iree/hal",
    "//runtime/src/iree/hal/memory:asan",
    "//runtime/src/iree/hal/memory:passthrough_pool",
    "//runtime/src/iree/hal/memory:slab_provider",
    "//runtime/src/iree/hal/memory:tlsf_pool",
    "//runtime/src/iree/hal/drivers/task:driver",
    "//runtime/src/iree/hal/drivers/task/executable/loaders/registration",
    "//runtime/src/iree/hal/utils:profile_file",
    "//runtime/src/iree/hal/utils:resource_set",
    "//runtime/src/iree/io:file_handle",
    "//runtime/src/iree/task:api",
] + iree_select({
    "//runtime/config/hal:driver_amdgpu": [
        "//runtime/src/iree/hal/drivers/amdgpu/registration",
        "//runtime/src/iree/hal/drivers/amdgpu/target:selection",
    ],
    "//conditions:default": [],
})

HRX_AMDGPU_COPTS = iree_select({
    "//runtime/config/hal:driver_amdgpu": [
        "-DHRX_HAS_IREE_AMDGPU_DRIVER",
    ],
    "//conditions:default": [],
})

# Static implementation library for in-tree integrations that directly compose
# with private HRX surfaces. External consumers use the shared :hrx target.
hrx_cc_library(
    name = "hrx_static",
    srcs = HRX_SRCS,
    hdrs = HRX_HDRS,
    copts = HRX_AMDGPU_COPTS,
    defines = ["HRX_STATIC"],
    includes = HRX_INCLUDES,
    deps = HRX_DEPS,
)

hrx_cc_shared_library(
    name = "hrx",
    srcs = HRX_SRCS,
    hdrs = HRX_HDRS,
    copts = [
        "-DHRX_BUILDING_SHARED",
    ] + HRX_AMDGPU_COPTS,
    includes = HRX_INCLUDES,
    deps = HRX_DEPS,
)

hrx_cc_test(
    name = "graph_exec_test",
    srcs = ["graph_exec_test.cc"],
    deps = [
        ":hrx_static",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

hrx_cc_test(
    name = "graph_buffer_test",
    srcs = ["graph_buffer_test.cc"],
    deps = [
        ":hrx_static",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

hrx_cc_test(
    name = "pool_test",
    srcs = ["pool_test.cc"],
    deps = [
        ":hrx_static",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
