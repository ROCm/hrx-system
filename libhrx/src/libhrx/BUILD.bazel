    "memory_transition.c",
    "queue.c",
    "queue_ops.c",
    "runtime.c",
    "semaphore.c",
    "status.c",
    "stream.c",
    "transfer.c",
    "virtual_buffer.c",
]

HRX_HDRS = [
    "barrier.h",
    "buffer.h",
    "buffer_table.h",
    "device.h",
    "device_group.h",
    "event_timestamp.h",
    "graph_analysis.h",
    "graph_exec.h",
    "hrx_internal.h",
    "mem_pool.h",
    "mem_pool_backing.h",
    "queue.h",
    "runtime.h",
    "stream.h",
    "transfer.h",
    "//libhrx/src:iree_hal_compat.h",
]

HRX_INCLUDES = [
    ".",
    "..",
    "../../include",
]

HRX_DEPS = [
    "//build_tools/bazel:dl",
    "//runtime/src/iree/async",
    "//runtime/src/iree/base",
    "//runtime/src/iree/base:core_headers",
    "//runtime/src/iree/base/internal",
    "//runtime/src/iree/base/internal:arena",
    "//runtime/src/iree/base/internal:dynamic_library",
    "//runtime/src/iree/base/internal:path",
    "//runtime/src/iree/base/threading",
    "//runtime/src/iree/async/util:proactor_pool",
    "//runtime/src/iree/hal",
    "//runtime/src/iree/hal/memory:asan_pool",
    "//runtime/src/iree/hal/memory:fixed_block_pool",
    "//runtime/src/iree/hal/memory:slab_provider",
    "//runtime/src/iree/hal/memory:slab_cache",
    "//runtime/src/iree/hal/memory:tlsf_pool",
    "//runtime/src/iree/hal/driver/task:driver",
    "//runtime/src/iree/hal/driver/task/executable/loaders/registration",
    "//runtime/src/iree/hal/utils:resource_set",
    "//runtime/src/iree/io:file_handle",
    "//runtime/src/iree/task:api",
] + iree_select({
    "//runtime/config/hal:driver_amd": [
        "//runtime/src/iree/hal/driver/amd/registration",
    ],
    "//conditions:default": [],
}) + iree_select({
    "//runtime/config/hal:driver_amd_gpu": [
        "//runtime/src/iree/hal/driver/amd/gpu/target:selection",
    ],
    "//conditions:default": [],
}) + iree_select({
    "//runtime/config/hal:driver_amdgpu": [
        "//runtime/src/iree/hal/driver/amdgpu/registration",
        "//runtime/src/iree/hal/driver/amdgpu/target:selection",
    ],
    "//conditions:default": [],
})

HRX_AMDGPU_COPTS = iree_select({
    "//runtime/config/hal:driver_amd": [
        "-DHRX_HAS_IREE_AMD_DRIVER",
    ],
    "//conditions:default": [],
}) + iree_select({
    "//runtime/config/hal:driver_amd_gpu": [
        "-DHRX_HAS_IREE_AMD_GPU_DRIVER",
    ],
    "//conditions:default": [],
}) + iree_select({
    "//runtime/config/hal:driver_amdgpu": [
        "-DHRX_HAS_IREE_AMDGPU_DRIVER",
    ],
    "//conditions:default": [],
})

# Public declarations opt in to the shared-library ABI through HRX_API.
HRX_SHARED_VISIBILITY_COPTS = iree_select({
    "@platforms//os:windows": [],
    "//conditions:default": ["-fvisibility=hidden"],
})

# Static implementation library for in-tree integrations that directly compose
# with private HRX surfaces. External consumers use the shared :hrx target.
hrx_cc_library(
    name = "hrx_static",
    srcs = HRX_SRCS,
    hdrs = HRX_HDRS,
    copts = HRX_AMDGPU_COPTS,
    defines = ["HRX_STATIC"],
    includes = HRX_INCLUDES,
    deps = HRX_DEPS,
)

hrx_cc_shared_library(
    name = "hrx",
    srcs = HRX_SRCS,
    hdrs = HRX_HDRS,
    copts = [
        "-DHRX_BUILDING_SHARED",
    ] + HRX_AMDGPU_COPTS + HRX_SHARED_VISIBILITY_COPTS,
    includes = HRX_INCLUDES,
    deps = HRX_DEPS,
)

