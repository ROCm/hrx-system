load("//build_tools/bazel:cmake.bzl", "iree_cmake_extra_content")
load("//libhrx/build_tools/bazel:cc.bzl", "hrx_cc_shared_library", "hrx_cc_test")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_PASSTHROUGH_LIBRARIES = [
    (
        "hip_intercept",
        "hip_intercept.c",
        [
            "//build_tools/bazel:dl",
            "//build_tools/bazel:pthreads",
        ],
    ),
    (
        "hip_logging",
        "hip_logging.c",
        ["//build_tools/bazel:pthreads"],
    ),
    (
        "hip_noop",
        "//libhrx/src/passthrough/interceptors:passthrough_interceptor.c",
        [],
    ),
    (
        "hip_buffer_tracer",
        "hip_buffer_tracer.c",
        ["//build_tools/bazel:pthreads"],
    ),
]

[
    hrx_cc_shared_library(
        name = name,
        srcs = [source],
        hdrs = ["hip_function_table.h"],
        additional_linker_inputs = ["passthrough_full.map"] if name == "hip_intercept" else [],
        copts = ["-fvisibility=default"],
        includes = [".."],
        linkopts = [
            "-Wl,--undefined-version",
            "-Wl,--version-script=$(location :passthrough_full.map)",
        ] if name == "hip_intercept" else [],
        target_compatible_with = ["@platforms//os:linux"],
        deps = deps,
    )
    for name, source, deps in _PASSTHROUGH_LIBRARIES
]

hrx_cc_test(
    name = "hip_buffer_tracer_test",
    srcs = [
        "hip_buffer_tracer.c",
        "hip_buffer_tracer_test.cc",
        "hip_function_table.h",
    ],
    includes = [".."],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//build_tools/bazel:pthreads",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
        "//runtime/src/iree/testing:temp_file",
    ],
)

[
    iree_cmake_extra_content(
        content = "set_target_properties(libhrx_src_passthrough_" + name + " PROPERTIES OUTPUT_NAME " + name + " VERSION 1.0.0 SOVERSION 1)",
        inline = True,
    )
    for name, _, _ in _PASSTHROUGH_LIBRARIES
]

iree_cmake_extra_content(
    content = """
install(FILES "${_IREE_PACKAGE_SOURCE_DIR}/hip_function_table.h"
  DESTINATION include/passthrough
  COMPONENT HrxPassthroughDist)
""",
    inline = True,
)

iree_cmake_extra_content(
    content = """
if(NOT LIBHRX_BUILD_PASSTHROUGH)
  return()
endif()
""",
    inline = False,
)
