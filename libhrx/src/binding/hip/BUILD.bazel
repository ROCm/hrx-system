# The installed-test registration runs while this file's generated CMake is
# evaluated. Set the shared library's artifact name before the test records it
# as data or expands its target-file environment value.
iree_cmake_extra_content(
    content = """
if(TARGET libhrx_src_binding_hip_amdhip64)
set_target_properties(libhrx_src_binding_hip_amdhip64 PROPERTIES
  OUTPUT_NAME amdhip64
  VERSION 7.9999.0
  SOVERSION 7
  POSITION_INDEPENDENT_CODE ON
  INSTALL_RPATH "$ORIGIN"
)
endif()
""",
    inline = True,
)

hrx_cc_test(
    name = "hip_api_name_test",
    srcs = ["hip_api_name_test.cc"],
    data = [":amdhip64"],
    env = {
        "HRX_TEST_LIBAMDHIP64": "$(location :amdhip64)",
    },
    target_compatible_with = _LINUX_COMPATIBILITY,
    deps = [
        "//build_tools/bazel:dl",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

hrx_cc_test(
    name = "hip_device_attribute_validation_api_test",
    srcs = [
        "api.h",
        "hip_device_attribute_validation_api_test.cc",
        "hip_device_attribute_validation_test_shim.c",
        "hip_device_attribute_validation_test_shim.h",
    ],
    # Exercise validation and TLS behavior through the exact public shared
    # object built by this target graph.
    data = [":amdhip64"],
    env = {
        "HRX_TEST_LIBAMDHIP64": "$(location :amdhip64)",
    },
    tags = [
        "iree-run-requirement=runtime.resource.amd_gpu",
        "runtime-resource=amd-gpu",
    ],
    target_compatible_with = _LINUX_COMPATIBILITY,
    deps = [
        "//build_tools/bazel:dl",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

