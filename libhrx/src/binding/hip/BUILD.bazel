hrx_cc_test(
    name = "hip_get_proc_address_test",
    srcs = ["hip_get_proc_address_test.cc"],
    # The test dlopen()s the built libamdhip64 with RTLD_LOCAL to reproduce the
    # consumer scenario (e.g. Triton). CMake injects the exact artifact path via
    # HRX_TEST_LIBAMDHIP64_PATH; Bazel passes the shared object as test data.
    data = [":amdhip64"],
    env = {
        "HRX_TEST_LIBAMDHIP64": "$(location :amdhip64)",
    },
    target_compatible_with = _LINUX_COMPATIBILITY,
    deps = [
        # The test itself calls dlopen()/dlsym()/dlclose(); link libdl so the
        # executable resolves them (glibc that ships dl separately, ld.lld).
        "//build_tools/bazel:dl",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

hrx_cc_test(
    name = "hip_launch_validation_api_test",
    srcs = ["hip_launch_validation_api_test.cc"],
    # The test loads the built runtime through its public ABI and supplies a
