load("//build_tools/bazel:cmake.bzl", "iree_cmake_extra_content")
load("//libhrx/build_tools/bazel:cc.bzl", "hrx_cc_shared_library")

package(default_visibility = ["//visibility:public"])

hrx_cc_shared_library(
    name = "cuda",
    srcs = [
        "driver.c",
        "runtime.c",
    ],
    hdrs = [
        "driver.h",
        "runtime.h",
    ],
    defines = ["IREE_HAL_STREAMING_CUDA_EXPORTS"],
    includes = ["../.."],
    tags = ["manual"],
    deps = [
        "//libhrx/src/binding/common",
        "//libhrx/src/libhrx:hrx_static",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
    ],
)

iree_cmake_extra_content(
    content = """
if(NOT LIBHRX_BUILD_CUDA_BINDING)
  return()
endif()
""",
    inline = False,
)

iree_cmake_extra_content(
    content = "set_target_properties(libhrx_src_binding_cuda_cuda PROPERTIES OUTPUT_NAME cuda VERSION 1.0.0 SOVERSION 1)",
    inline = True,
)
