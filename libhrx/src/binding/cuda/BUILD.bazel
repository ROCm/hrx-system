load("//build_tools/bazel:cmake.bzl", "iree_cmake_extra_content")
load(
    "//libhrx/build_tools/bazel:cc.bzl",
    "hrx_cc_shared_library",
    "hrx_cc_test",
)

package(default_visibility = ["//visibility:public"])

_LINUX_COMPATIBILITY = ["@platforms//os:linux"]

hrx_cc_shared_library(
    name = "cuda",
    srcs = [
        "driver.c",
        "runtime.c",
    ],
    hdrs = [
        "driver.h",
        "runtime.h",
    ],
    defines = ["IREE_HAL_STREAMING_CUDA_EXPORTS"],
    includes = ["../.."],
    tags = ["manual"],
    deps = [
        "//libhrx/src/binding/common",
        "//libhrx/src/libhrx:hrx_static",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
    ],
)

hrx_cc_test(
    name = "synchronization_test",
    srcs = [
        "driver.h",
        "runtime.h",
        "synchronization_test.cc",
    ],
    data = [":cuda"],
    env = {
        "HRX_TEST_LIBCUDA": "$(location :cuda)",
    },
    target_compatible_with = _LINUX_COMPATIBILITY,
    deps = [
        "//build_tools/bazel:dl",
        "//libhrx/src/binding/common",
        "//libhrx/src/libhrx:hrx_static",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

hrx_cc_test(
    name = "runtime_test",
    srcs = [
        "driver.h",
        "runtime.c",
        "runtime.h",
        "runtime_test.cc",
    ],
    includes = ["../.."],
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

iree_cmake_extra_content(
    content = """
if(NOT LIBHRX_BUILD_CUDA_BINDING)
  return()
endif()
""",
    inline = False,
)

iree_cmake_extra_content(
    content = "set_target_properties(libhrx_src_binding_cuda_cuda PROPERTIES OUTPUT_NAME cuda VERSION 1.0.0 SOVERSION 1)",
    inline = True,
)
