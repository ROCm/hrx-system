load("//build_tools/amdgpu:binary.bzl", "iree_amdgpu_binary_variants_embed_data")
load("//libhrx/build_tools/bazel:cc.bzl", "hrx_cc_benchmark")
load("//libhrx/build_tools/bazel:cts.bzl", "hrx_cts_test")
load(
    "//libhrx/cts:defs.bzl",
    "AMDGPU_CTS_COMPATIBILITY_CONDITIONS",
    "AMD_GPU_CTS_RESOURCE_GROUP",
    "AMD_GPU_CTS_TAGS",
)
load("//loom/build_tools/amdgpu:target_config.bzl", "LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITIES")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")
load("//runtime/src/iree/hal/driver/amd/gpu/cts:testdata.bzl", "iree_hal_amd_gpu_cts_testdata")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_AMDGPU_CTS_COMPATIBILITY = select(AMDGPU_CTS_COMPATIBILITY_CONDITIONS)

_LOOM_CTS_COMPATIBILITY = _AMDGPU_CTS_COMPATIBILITY + loom_config_compatible_with([
    "//loom/config/emit:amdgpu_elf",
]) + select(dict([
    (
        "//loom/config/arch/amdgpu:" + capability,
        [],
    )
    for capability in LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITIES
] + [(
    "//conditions:default",
    ["@platforms//:incompatible"],
)]))

iree_hal_amd_gpu_cts_testdata(
    name = "dependent_chain_testdata",
    srcs = ["dependent_chain.loom"],
    backend_names = ["hrx_dependent_chain"],
    target_compatible_with = _LOOM_CTS_COMPATIBILITY,
)

hrx_cc_benchmark(
    name = "dependent_chain_benchmark",
    srcs = ["dependent_chain_benchmark.cpp"],
    resource_group = AMD_GPU_CTS_RESOURCE_GROUP,
    tags = AMD_GPU_CTS_TAGS,
    target_compatible_with = _LOOM_CTS_COMPATIBILITY,
    deps = [
        ":dependent_chain_testdata",
        "//libhrx/cts/core:loader",
        "//libhrx/src/binding/hip:launch_params",
        "//libhrx/src/libhrx:hrx_static",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/tooling:flags",
        "//runtime/src/iree/hal/cts/util:registry",
        "//runtime/src/iree/hal/driver/amd/gpu/cts:testdata",
        "//runtime/src/iree/hal/driver/amd/gpu/target:identity",
        "//runtime/src/iree/testing:benchmark_main",
    ],
)

iree_amdgpu_binary_variants_embed_data(
    name = "amdgpu_executable_test_kernels",
    testonly = True,
    srcs = ["executable_kernels.c"],
    binary_name_prefix = "hrx_cts_executable_kernel",
    c_file_output = "amdgpu_executable_test_kernels.c",
    h_file_output = "amdgpu_executable_test_kernels.h",
    identifier = "hrx_cts_amdgpu_executable_test_kernels",
    tags = ["manual"],
    target = "amdgcn-amd-amdhsa",
    target_compatible_with = _AMDGPU_CTS_COMPATIBILITY,
    target_selectors_flag = "//runtime/src/iree/hal/driver/amd/gpu:targets",
    visibility = ["//libhrx/cts/tests/hip:__pkg__"],
)

hrx_cts_test(
    name = "executable",
    srcs = [
        "executable_test.cpp",
        "//libhrx/cts/core:amdgpu_executable_test_data.hpp",
        "//libhrx/cts/core:amdgpu_test_data.hpp",
    ],
    args = ["--hrx-device=gpu:0"],
    resource_group = AMD_GPU_CTS_RESOURCE_GROUP,
    tags = AMD_GPU_CTS_TAGS,
    target_compatible_with = _AMDGPU_CTS_COMPATIBILITY,
    deps = [
        ":amdgpu_executable_test_kernels",
        "//build_tools/amdgpu:target_map_h",
    ],
)

hrx_cc_benchmark(
    name = "queue_benchmark",
    srcs = [
        "queue_benchmark.cpp",
        "//libhrx/cts/core:amdgpu_executable_test_data.hpp",
        "//libhrx/cts/core:amdgpu_test_data.hpp",
    ],
    resource_group = AMD_GPU_CTS_RESOURCE_GROUP,
    tags = AMD_GPU_CTS_TAGS,
    target_compatible_with = _AMDGPU_CTS_COMPATIBILITY,
    deps = [
        ":amdgpu_executable_test_kernels",
        "//build_tools/amdgpu:target_map_h",
        "//libhrx/src/libhrx:hrx_static",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/tooling:flags",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/testing:benchmark_main",
    ],
)

hrx_cc_benchmark(
    name = "graph_benchmark",
    srcs = [
        "graph_benchmark.cpp",
        "//libhrx/cts/core:amdgpu_executable_test_data.hpp",
        "//libhrx/cts/core:amdgpu_test_data.hpp",
    ],
    data = ["//libhrx/src/libhrx:hrx"] + select({
        "@platforms//os:linux": ["//libhrx/src/binding/hip:amdhip64"],
        "//conditions:default": [],
    }),
    env = {"HRX_LIBRARY": "$(rootpath //libhrx/src/libhrx:hrx)"},
    resource_group = AMD_GPU_CTS_RESOURCE_GROUP,
    tags = AMD_GPU_CTS_TAGS,
    target_compatible_with = _AMDGPU_CTS_COMPATIBILITY,
    deps = [
        ":amdgpu_executable_test_kernels",
        "//build_tools/amdgpu:target_map_h",
        "//libhrx/cts/core:loader",
        "//libhrx/src/binding/hip:launch_params",
        "//runtime/src/iree/base/tooling:flags",
        "//runtime/src/iree/testing:benchmark_main",
    ],
)
