load("@rules_python//python:defs.bzl", "py_test")
load("//libhrx/build_tools/bazel:cts.bzl", "hrx_cts_test")
load("//libhrx/cts:defs.bzl", "AMD_GPU_CTS_RESOURCE_GROUP", "AMD_GPU_CTS_TAGS")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

hrx_cts_test(
    name = "lifecycle",
    srcs = ["lifecycle_test.cpp"],
    args = ["--hrx-device=gpu:0"],
    resource_group = AMD_GPU_CTS_RESOURCE_GROUP,
    tags = AMD_GPU_CTS_TAGS,
)

py_test(
    name = "cleanup_test",
    srcs = ["cleanup_test.py"],
    args = [
        "$(location :hrx_cts_lifecycle)",
        "$(location //libhrx/src/libhrx:hrx)",
    ],
    data = [
        ":hrx_cts_lifecycle",
        "//libhrx/src/libhrx:hrx",
    ],
)
