load("//libhrx/build_tools/bazel:cts.bzl", "hrx_cts_test")
load("//libhrx/cts:defs.bzl", "AMDGPU_CTS_COMPATIBILITY_CONDITIONS", "AMD_GPU_CTS_RESOURCE_GROUP", "AMD_GPU_CTS_TAGS")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

hrx_cts_test(
    name = "device",
    srcs = ["device_test.cpp"],
    args = ["--hrx-device=gpu:0"],
    resource_group = AMD_GPU_CTS_RESOURCE_GROUP,
    tags = AMD_GPU_CTS_TAGS,
)

hrx_cts_test(
    name = "group",
    srcs = ["group_test.cpp"],
    args = ["--hrx-device=none"],
    resource_group = AMD_GPU_CTS_RESOURCE_GROUP,
    tags = AMD_GPU_CTS_TAGS,
    target_compatible_with = select(AMDGPU_CTS_COMPATIBILITY_CONDITIONS) + select({
        "//runtime/config/hal:driver_task": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

hrx_cts_test(
    name = "heterogeneous",
    srcs = ["heterogeneous_test.cpp"],
    args = ["--hrx-device=none"],
    resource_group = AMD_GPU_CTS_RESOURCE_GROUP,
    tags = [
        "iree-build-requirement=libamdf.gpu",
        "iree-build-requirement=libamdf.xdna",
        "iree-run-requirement=libamdf.resource.amd_gpu",
        "iree-run-requirement=libamdf.resource.xdna",
        "runtime-resource=amd-gpu",
        "runtime-resource=amd-xdna",
    ],
    target_compatible_with = select(AMDGPU_CTS_COMPATIBILITY_CONDITIONS) + select({
        "//runtime/config/hal:driver_task": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }) + select({
        "//runtime/config/hal:driver_amd_xdna": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }) + select({
        "//libamdf/config/family:gpu": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }) + select({
        "//libamdf/config/family:xdna": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//runtime/src/iree/hal/driver/amd/xdna/image/testdata:mul_i32",
        "//runtime/src/iree/hal/driver/amd/xdna/image/testdata:mul_i32_npu4",
    ],
)
