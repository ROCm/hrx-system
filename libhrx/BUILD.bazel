load("//build_tools/bazel:cc.bzl", "iree_cc_library")
load("//build_tools/bazel:cmake.bzl", "iree_cmake_extra_content")
load("//build_tools/bazel:package_boundary.bzl", "iree_package_boundary")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

iree_package_boundary(
    allowed_descendant_paths = ["include/**"],
    reason = "The installed HRX SDK preserves its public include tree.",
)

iree_cc_library(
    name = "defines",
    hdrs = [
        "include/hrx_base.h",
        "include/hrx_device.h",
        "include/hrx_memory.h",
        "include/hrx_runtime.h",
        "include/hrx_runtime_cxx.h",
    ],
    includes = ["include"],
)

alias(
    name = "hrx",
    actual = "//libhrx/src/libhrx:hrx",
)

iree_cmake_extra_content(
    content = """
include("${IREE_SOURCE_DIR}/libhrx/build_tools/cmake/hrx_source_root.cmake")
""",
    inline = False,
)

iree_cmake_extra_content(
    content = """
include("${IREE_SOURCE_DIR}/libhrx/build_tools/cmake/hrx_package.cmake")
""",
    inline = True,
)
