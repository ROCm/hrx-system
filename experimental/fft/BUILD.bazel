# bazel-to-cmake: skip

load("//build_tools/bazel:python.bzl", "iree_py_binary", "iree_py_library")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")
load("//loom/build_tools/bazel:defs.bzl", "loom_library")
load(":test_defs.bzl", "fft_composition_test", "fft_test", "workgroup_fft_test")

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "headers",
    srcs = [
        "complex_stages.h",
        "deinterleave.h",
        "fft.h",
        "frame_io.h",
        "frame_transpose.h",
        "frequency_packet.h",
        "geometry.h",
        "real_packet.h",
        "real_radix.h",
        "workgroup.h",
        "workgroup_edges.h",
        "workgroup_geometry.h",
    ],
)

loom_library(
    name = "layout",
    srcs = [
        "deinterleave.cxx",
        "frame_transpose.cxx",
    ],
    data = [":headers"],
    target_compatible_with = loom_config_compatible_with(["//loom/config/import:cxx"]),
)

loom_library(
    name = "example",
    srcs = ["example.cxx"],
    data = [":headers"],
    target_compatible_with = loom_config_compatible_with(["//loom/config/import:cxx"]),
    deps = [":layout"],
)

loom_library(
    name = "workgroup_example",
    srcs = ["workgroup_example.cxx"],
    data = [":headers"],
    target_compatible_with = loom_config_compatible_with(["//loom/config/import:cxx"]),
)

iree_py_library(
    name = "tables_lib",
    srcs = ["tables.py"],
)

iree_py_binary(
    name = "tables",
    srcs = ["tables.py"],
)

iree_py_binary(
    name = "test_data",
    testonly = True,
    srcs = ["test_data.py"],
    deps = [":tables_lib"],
)

iree_py_library(
    name = "test_data_lib",
    testonly = True,
    srcs = ["test_data.py"],
    deps = [":tables_lib"],
)

iree_py_binary(
    name = "workgroup_test_data",
    testonly = True,
    srcs = ["workgroup_test_data.py"],
    deps = [":test_data_lib"],
)

[
    fft_test(
        name = input_type + "_" + output_type,
        frames = 15,
        input_type = input_type,
        length = 10,
        output_type = output_type,
        width = 8,
    )
    for input_type in [
        "f32",
        "f16",
        "bf16",
    ]
    for output_type in [
        "f32",
        "f16",
        "bf16",
    ]
]

fft_test(
    name = "empty",
    frames = 0,
    length = 10,
    width = 8,
)

fft_test(
    name = "single",
    frames = 1,
    length = 8,
    width = 1,
)

fft_test(
    name = "minimal",
    frames = 31,
    length = 2,
    width = 16,
)

fft_test(
    name = "latency",
    frames = 3,
    frequency_only = True,
    input_type = "bf16",
    length = 10,
    output_type = "f16",
    width = 1,
)

fft_test(
    name = "radix4",
    frames = 3,
    length = 16,
    width = 2,
)

fft_test(
    name = "twiddles",
    frames = 3,
    length = 20,
    width = 2,
)

fft_composition_test(name = "composition")

_WORKGROUP_STORAGE_CASES = [
    (
        "workgroup_" + input_type + "_" + output_type,
        input_type,
        output_type,
    )
    for input_type in [
        "f32",
        "f16",
        "bf16",
    ]
    for output_type in [
        "f32",
        "f16",
        "bf16",
    ]
]

[
    workgroup_fft_test(
        name = name,
        input_type = input_type,
        length = 10,
        output_type = output_type,
    )
    for name, input_type, output_type in _WORKGROUP_STORAGE_CASES
]

# These lengths select distinct radix, reconstruction, and maximum-stage-width
# mechanisms. The large performance workloads stay out of ordinary checks.
_WORKGROUP_LENGTHS = [
    2,
    4,
    8,
    16,
    20,
    50,
    64,
    128,
    500,
]

[
    workgroup_fft_test(
        name = "workgroup_length_%s" % length,
        length = length,
    )
    for length in _WORKGROUP_LENGTHS
]

workgroup_fft_test(
    name = "workgroup_empty",
    frames = 0,
    length = 10,
)

test_suite(
    name = "workgroup_tests",
    tags = ["manual"],
    tests = [
        ":" + name + "_" + mode
        for name in [row[0] for row in _WORKGROUP_STORAGE_CASES] + ["workgroup_length_%s" % length for length in _WORKGROUP_LENGTHS] + ["workgroup_empty"]
        for mode in [
            "forward",
            "power",
        ]
    ],
)
