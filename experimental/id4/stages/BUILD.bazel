load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")
load("//runtime/build_tools/bazel:cc.bzl", "iree_runtime_cc_library")
load("//runtime/build_tools/bazel:cc_benchmark.bzl", "iree_runtime_cc_benchmark")
load("//runtime/build_tools/bazel:cc_test.bzl", "iree_runtime_cc_test")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_AMDGPU_HAL_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/execute:amdgpu_hal",
])

iree_runtime_cc_library(
    name = "qwen3_vl_prefill",
    srcs = ["qwen3_vl_prefill.c"],
    hdrs = ["qwen3_vl_prefill.h"],
    deps = [
        "//experimental/id4/pipeline:diagnostics",
        "//experimental/id4/pipeline:kernel_cache",
        "//experimental/id4/pipeline:kernel_library",
        "//experimental/id4/pipeline:parameter_slab",
        "//experimental/id4/pipeline:plan",
        "//experimental/id4/pipeline:region",
        "//experimental/id4/pipeline:stage",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/hal",
    ],
)

iree_runtime_cc_library(
    name = "smoke",
    srcs = ["smoke.c"],
    hdrs = ["smoke.h"],
    deps = [
        "//experimental/id4/pipeline:diagnostics",
        "//experimental/id4/pipeline:kernel_cache",
        "//experimental/id4/pipeline:kernel_library",
        "//experimental/id4/pipeline:parameter_slab",
        "//experimental/id4/pipeline:plan",
        "//experimental/id4/pipeline:region",
        "//experimental/id4/pipeline:stage",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/hal",
    ],
)

iree_runtime_cc_library(
    name = "test_util",
    testonly = True,
    srcs = ["test_util.cc"],
    hdrs = ["test_util.h"],
    deps = [
        "//experimental/id4/pipeline:diagnostics",
        "//runtime/src/iree/async",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/drivers/local_sync:sync_driver",
    ],
)

iree_runtime_cc_library(
    name = "hal_integration_util",
    testonly = True,
    srcs = ["hal_integration_util.cc"],
    hdrs = ["hal_integration_util.h"],
    deps = [
        "//experimental/id4/pipeline:diagnostics",
        "//runtime/src/iree/async",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/drivers",
        "//runtime/src/iree/io:parameter_index",
        "//runtime/src/iree/io:parameter_index_provider",
        "//runtime/src/iree/io:parameter_provider",
        "//runtime/src/iree/io:scope_map",
        "//runtime/src/iree/tooling:parameter_util",
    ],
)

iree_runtime_cc_test(
    name = "qwen3_vl_prefill_amdgpu_integration_test",
    srcs = ["qwen3_vl_prefill_amdgpu_integration_test.cc"],
    args = [
        "--rmsnorm_loom_source=$(location //experimental/id4/kernels:qwen3_vl/rmsnorm.loom)",
        "--linear_loom_source=$(location //experimental/id4/kernels:qwen3_vl/linear_bf16_f32.loom)",
        "--device_uri=amdgpu://0",
        "--amdgpu_processor=gfx1100",
    ],
    data = [
        "//experimental/id4/kernels:qwen3_vl/linear_bf16_f32.loom",
        "//experimental/id4/kernels:qwen3_vl/rmsnorm.loom",
    ],
    tags = [
        "iree-run-requirement=runtime.resource.amd_gpu",
        "manual",
        "requires-gpu-amd",
        "runtime-resource=amd-gpu",
    ],
    target_compatible_with = _AMDGPU_HAL_COMPATIBLE_WITH,
    deps = [
        ":hal_integration_util",
        ":qwen3_vl_prefill",
        "//experimental/id4/pipeline:diagnostics",
        "//experimental/id4/pipeline:kernel_cache",
        "//experimental/id4/pipeline:kernel_library",
        "//experimental/id4/pipeline:parameter_slab",
        "//experimental/id4/pipeline:plan",
        "//experimental/id4/pipeline:stage",
        "//runtime/src/iree/async",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal",
        "//runtime/src/iree/base/tooling:flags",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/drivers",
        "//runtime/src/iree/io:file_handle",
        "//runtime/src/iree/io:parameter_provider",
        "//runtime/src/iree/testing:gtest",
    ],
)

iree_runtime_cc_benchmark(
