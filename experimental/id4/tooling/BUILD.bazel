load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],
)

py_library(
    name = "fixture_compare_lib",
    srcs = ["fixture_compare.py"],
    imports = ["."],
    deps = ["//experimental/id4/build_tools:trace_reduce_lib"],
)

py_binary(
    name = "fixture_compare",
    srcs = ["fixture_compare.py"],
    deps = [":fixture_compare_lib"],
)

py_test(
    name = "fixture_compare_test",
    srcs = ["fixture_compare_test.py"],
    deps = [
        ":fixture_compare_lib",
        "//experimental/id4/build_tools:trace_reduce_lib",
    ],
)
