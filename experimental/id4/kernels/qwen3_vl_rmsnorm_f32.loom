config.decl @id4.qwen3_vl.rmsnorm.token_count : %value: index where [range(%value, 1, 65536)]
config.decl @id4.qwen3_vl.rmsnorm.hidden_size : %value: index where [range(%value, 1, 65536)]
config.decl @id4.qwen3_vl.rmsnorm.workgroup_size_x : %value: index where [range(%value, 1, 1024)]

kernel.def export("id4_qwen3_vl_rmsnorm_f32") @id4_qwen3_vl_rmsnorm_f32() {
  %unit = index.constant 1 : index
  %token_count = config.get @id4.qwen3_vl.rmsnorm.token_count : index
  %workgroup_size_x = config.get @id4.qwen3_vl.rmsnorm.workgroup_size_x : index
  kernel.launch.config workgroups(%token_count, %unit, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%input: buffer, %weight: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %row = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %hidden_size = config.get @id4.qwen3_vl.rmsnorm.hidden_size : index
  %workgroup_size_x = config.get @id4.qwen3_vl.rmsnorm.workgroup_size_x : index
  %zero_f32 = scalar.constant 0.0 : f32
  %epsilon = scalar.constant 0.000001 : f32
  %hidden_size_i32 = index.cast %hidden_size : index to i32
  %hidden_size_f32 = scalar.sitofp %hidden_size_i32 : i32 to f32

  %input_noalias, %weight_noalias, %output_noalias = buffer.assume.noalias %input, %weight, %output : buffer, buffer, buffer
  %input_global = buffer.assume.memory_space<global> %input_noalias : buffer
  %weight_global = buffer.assume.memory_space<global> %weight_noalias : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  %token_count = config.get @id4.qwen3_vl.rmsnorm.token_count : index
  %input_view = buffer.view %input_global[%base] : buffer -> view<[%token_count]x[%hidden_size]xf32, #dense>
  %weight_view = buffer.view %weight_global[%base] : buffer -> view<[%hidden_size]xf32, #dense>
  %output_view = buffer.view %output_global[%base] : buffer -> view<[%token_count]x[%hidden_size]xf32, #dense>

  %lane_square_sum = scf.for %column = [%lane to %hidden_size step %workgroup_size_x](%acc = %zero_f32 : f32) -> (f32) {
    %value = view.load %input_view[%row, %column] : view<[%token_count]x[%hidden_size]xf32, #dense> -> f32
    %square = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %value, %value : f32
    %next = scalar.addf<reassoc|nnan|ninf|nsz> %acc, %square : f32
    scf.yield %next : f32
  }
  %square_sum = kernel.workgroup.reduce<addf> %lane_square_sum : f32
  %mean_square = scalar.divf<nnan|ninf|nsz|arcp> %square_sum, %hidden_size_f32 : f32
  %mean_square_epsilon = scalar.addf<nnan|ninf|nsz> %mean_square, %epsilon : f32
  %row_scale = scalar.rsqrtf<nnan|ninf|nsz|afn> %mean_square_epsilon : f32

  scf.for %column = [%lane to %hidden_size step %workgroup_size_x] {
    %value = view.load %input_view[%row, %column] : view<[%token_count]x[%hidden_size]xf32, #dense> -> f32
    %weight_value = view.load %weight_view[%column] : view<[%hidden_size]xf32, #dense> -> f32
    %normalized = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %value, %row_scale : f32
    %weighted = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %normalized, %weight_value : f32
    view.store %weighted, %output_view[%row, %column] : f32, view<[%token_count]x[%hidden_size]xf32, #dense>
  }
  kernel.return
}

check.case public @id4_qwen3_vl_rmsnorm_f32_small_case {
  %input = check.generate.fill value(2.0) : tensor<1x4xf32>
  %weight = check.generate.iota offset(0.5) step(0.5) : tensor<4xf32>
  %output = check.generate.fill value(0.0) : tensor<1x4xf32>
  %expected = check.generate.iota offset(0.5) step(0.5) : tensor<1x4xf32>
  func.call @id4_qwen3_vl_rmsnorm_f32(%input, %weight, %output) : (tensor<1x4xf32>, tensor<4xf32>, tensor<1x4xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.00001) rtol(0.00001) nan(same) : tensor<1x4xf32>
  check.return
}

check.case public @id4_qwen3_vl_rmsnorm_f32_qwen_slice_case {
  %input = check.generate.fill value(2.0) : tensor<64x4096xf32>
  %weight = check.generate.fill value(1.0) : tensor<4096xf32>
  %output = check.generate.fill value(0.0) : tensor<64x4096xf32>
  %expected = check.generate.fill value(1.0) : tensor<64x4096xf32>
  func.call @id4_qwen3_vl_rmsnorm_f32(%input, %weight, %output) : (tensor<64x4096xf32>, tensor<4096xf32>, tensor<64x4096xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.00001) rtol(0.00001) nan(same) : tensor<64x4096xf32>
  check.return
}

check.benchmark<@id4_qwen3_vl_rmsnorm_f32_small_case> @id4_qwen3_vl_rmsnorm_f32_small
check.benchmark<@id4_qwen3_vl_rmsnorm_f32_qwen_slice_case> @id4_qwen3_vl_rmsnorm_f32_qwen_slice
