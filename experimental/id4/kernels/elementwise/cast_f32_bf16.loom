config.decl @id4.elementwise.cast_f32_bf16.element_count : %value: index where [range(%value, 1, 268435456)]

kernel.def export("id4_elementwise_cast_f32_bf16") @id4_elementwise_cast_f32_bf16() {
  %unit = index.constant 1 : index
  %workgroup_size_x = index.constant 256 : index
  %element_count = config.get @id4.elementwise.cast_f32_bf16.element_count : index
  %rounding = index.constant 255 : index
  %rounded = index.add %element_count, %rounding : index
  %workgroups_x = index.div %rounded, %workgroup_size_x : index
  kernel.launch.config workgroups(%workgroups_x, %unit, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %workgroup = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %workgroup_size_x = index.constant 256 : index
  %element_count = config.get @id4.elementwise.cast_f32_bf16.element_count : index
  %element_index = index.madd %workgroup, %workgroup_size_x, %lane : index
  %in_bounds = index.cmp ult, %element_index, %element_count : index

  %input_noalias, %output_noalias = buffer.assume.noalias %input, %output : buffer, buffer
  %input_global = buffer.assume.memory_space<global> %input_noalias : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  %input_view = buffer.view %input_global[%base] : buffer -> view<[%element_count]xf32, #dense>
  %output_view = buffer.view %output_global[%base] : buffer -> view<[%element_count]xbf16, #dense>

  scf.if %in_bounds {
    %value = view.load %input_view[%element_index] : view<[%element_count]xf32, #dense> -> f32
    %rounded = scalar.fptrunc %value : f32 to bf16
    view.store %rounded, %output_view[%element_index] : bf16, view<[%element_count]xbf16, #dense>
  }
  kernel.return
}

check.case public @id4_elementwise_cast_f32_bf16_small_case {
  %input = check.generate.fill value(1.0) : tensor<4xf32>
  %output = check.generate.fill value(0.0) : tensor<4xbf16>
  %expected = check.generate.fill value(1.0) : tensor<4xbf16>
  func.call @id4_elementwise_cast_f32_bf16(%input, %output) : (tensor<4xf32>, tensor<4xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<4xbf16>
  check.return
}

check.benchmark<@id4_elementwise_cast_f32_bf16_small_case> @id4_elementwise_cast_f32_bf16_small
