config.decl @id4.elementwise.add.element_count : %value: index where [range(%value, 1, 268435456)]

kernel.def export("id4_elementwise_add_f32") @id4_elementwise_add_f32() {
  %unit = index.constant 1 : index
  %workgroup_size_x = index.constant 256 : index
  %element_count = config.get @id4.elementwise.add.element_count : index
  %rounding = index.sub %workgroup_size_x, %unit : index
  %rounded = index.add %element_count, %rounding : index
  %workgroups_x = index.div %rounded, %workgroup_size_x : index
  kernel.launch.config workgroups(%workgroups_x, %unit, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%lhs: buffer, %rhs: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %workgroup = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %workgroup_size_x = index.constant 256 : index
  %element_count = config.get @id4.elementwise.add.element_count : index
  %element_index = index.madd %workgroup, %workgroup_size_x, %lane : index
  %in_bounds = index.cmp ult, %element_index, %element_count : index

  %lhs_noalias, %rhs_noalias, %output_noalias = buffer.assume.noalias %lhs, %rhs, %output : buffer, buffer, buffer
  %lhs_global = buffer.assume.memory_space<global> %lhs_noalias : buffer
  %rhs_global = buffer.assume.memory_space<global> %rhs_noalias : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  %lhs_view = buffer.view %lhs_global[%base] : buffer -> view<[%element_count]xf32, #dense>
  %rhs_view = buffer.view %rhs_global[%base] : buffer -> view<[%element_count]xf32, #dense>
  %output_view = buffer.view %output_global[%base] : buffer -> view<[%element_count]xf32, #dense>

  scf.if %in_bounds {
    %lhs_value = view.load %lhs_view[%element_index] : view<[%element_count]xf32, #dense> -> f32
    %rhs_value = view.load %rhs_view[%element_index] : view<[%element_count]xf32, #dense> -> f32
    %value = scalar.addf<reassoc|nnan|ninf|nsz> %lhs_value, %rhs_value : f32
    view.store %value, %output_view[%element_index] : f32, view<[%element_count]xf32, #dense>
  }
  kernel.return
}

check.case public @id4_elementwise_add_f32_small_case {
  %lhs = check.generate.iota offset(1.0) step(1.0) : tensor<4xf32>
  %rhs = check.generate.fill value(10.0) : tensor<4xf32>
  %output = check.generate.fill value(0.0) : tensor<4xf32>
  %expected = check.generate.iota offset(11.0) step(1.0) : tensor<4xf32>
  func.call @id4_elementwise_add_f32(%lhs, %rhs, %output) : (tensor<4xf32>, tensor<4xf32>, tensor<4xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<4xf32>
  check.return
}

check.case public @id4_elementwise_add_f32_flux2_mid_block_shape_case {
  %lhs = check.generate.fill value(1.0) : tensor<8388608xf32>
  %rhs = check.generate.fill value(2.0) : tensor<8388608xf32>
  %output = check.generate.fill value(0.0) : tensor<8388608xf32>
  %expected = check.generate.fill value(3.0) : tensor<8388608xf32>
  func.call @id4_elementwise_add_f32(%lhs, %rhs, %output) : (tensor<8388608xf32>, tensor<8388608xf32>, tensor<8388608xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<8388608xf32>
  check.return
}

check.benchmark<@id4_elementwise_add_f32_small_case> @id4_elementwise_add_f32_small
check.benchmark<@id4_elementwise_add_f32_flux2_mid_block_shape_case> @id4_elementwise_add_f32_flux2_mid_block_shape
