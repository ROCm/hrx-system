  %epsilon = scalar.constant 1.0000000000000001e-05 : f32
  %qkv_noalias, %norm_q_weight_noalias, %norm_k_weight_noalias, %position_embedding_noalias, %rotated_query_noalias, %rotated_key_noalias, %value_noalias = buffer.assume.noalias %qkv, %norm_q_weight, %norm_k_weight, %position_embedding, %rotated_query, %rotated_key, %value : buffer, buffer, buffer, buffer, buffer, buffer, buffer
  %qkv_global = buffer.assume.memory_space<global> %qkv_noalias : buffer
  %norm_q_weight_global = buffer.assume.memory_space<global> %norm_q_weight_noalias : buffer
