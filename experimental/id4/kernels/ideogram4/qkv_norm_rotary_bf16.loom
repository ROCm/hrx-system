    %query_lower_weight = scalar.extf %query_lower_weight_bf16 : bf16 to f32
    %query_upper_weight = scalar.extf %query_upper_weight_bf16 : bf16 to f32
    %query_lower_scaled = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %query_lower_raw, %query_row_scale : f32
    %query_upper_scaled = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %query_upper_raw, %query_row_scale : f32
    %query_lower = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %query_lower_scaled, %query_lower_weight : f32
    %query_upper = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %query_upper_scaled, %query_upper_weight : f32
    %query_lower_cos = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %query_lower, %cos0 : f32
    %query_upper_neg_sin = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %query_upper, %negative_sin : f32
    %rotated_query_lower = scalar.addf<reassoc|nnan|ninf|nsz> %query_lower_cos, %query_upper_neg_sin : f32
    %query_lower_sin = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %query_lower, %sin : f32
    %query_upper_cos = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %query_upper, %cos1 : f32
    %rotated_query_upper = scalar.addf<reassoc|nnan|ninf|nsz> %query_lower_sin, %query_upper_cos : f32
    %rotated_query_lower_bf16 = scalar.fptrunc %rotated_query_lower : f32 to bf16
    %rotated_query_upper_bf16 = scalar.fptrunc %rotated_query_upper : f32 to bf16
    view.store %rotated_query_lower_bf16, %rotated_query_view[%token, %lower_channel] : bf16, view<[%value_token_stride]x[%hidden_size]xbf16, #dense>
    view.store %rotated_query_upper_bf16, %rotated_query_view[%token, %upper_channel] : bf16, view<[%value_token_stride]x[%hidden_size]xbf16, #dense>
    %key_lower_raw_bf16 = view.load %qkv_view[%token, %key_lower_row] : view<[%token_count]x[%qkv_size]xbf16, #dense> -> bf16
    %key_upper_raw_bf16 = view.load %qkv_view[%token, %key_upper_row] : view<[%token_count]x[%qkv_size]xbf16, #dense> -> bf16
    %key_lower_raw = scalar.extf %key_lower_raw_bf16 : bf16 to f32
    %key_upper_raw = scalar.extf %key_upper_raw_bf16 : bf16 to f32
    %key_lower_weight_bf16 = view.load %norm_k_weight_view[%half_channel] : view<[%head_size]xbf16, #dense> -> bf16
    %key_upper_weight_bf16 = view.load %norm_k_weight_view[%upper_head_channel] : view<[%head_size]xbf16, #dense> -> bf16
    %key_lower_weight = scalar.extf %key_lower_weight_bf16 : bf16 to f32
    %key_upper_weight = scalar.extf %key_upper_weight_bf16 : bf16 to f32
    %key_lower_scaled = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %key_lower_raw, %key_row_scale : f32
    %key_upper_scaled = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %key_upper_raw, %key_row_scale : f32
    %key_lower = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %key_lower_scaled, %key_lower_weight : f32
    %key_upper = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %key_upper_scaled, %key_upper_weight : f32
    %key_lower_cos = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %key_lower, %cos0 : f32
    %key_upper_neg_sin = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %key_upper, %negative_sin : f32
    %rotated_key_lower = scalar.addf<reassoc|nnan|ninf|nsz> %key_lower_cos, %key_upper_neg_sin : f32
    %key_lower_sin = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %key_lower, %sin : f32
    %key_upper_cos = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %key_upper, %cos1 : f32
    %rotated_key_upper = scalar.addf<reassoc|nnan|ninf|nsz> %key_lower_sin, %key_upper_cos : f32
    %rotated_key_lower_bf16 = scalar.fptrunc %rotated_key_lower : f32 to bf16
    %rotated_key_upper_bf16 = scalar.fptrunc %rotated_key_upper : f32 to bf16
    view.store %rotated_key_lower_bf16, %rotated_key_view[%token, %lower_channel] : bf16, view<[%value_token_stride]x[%hidden_size]xbf16, #dense>
    view.store %rotated_key_upper_bf16, %rotated_key_view[%token, %upper_channel] : bf16, view<[%value_token_stride]x[%hidden_size]xbf16, #dense>
    %value_lower_raw_bf16 = view.load %qkv_view[%token, %value_lower_row] : view<[%token_count]x[%qkv_size]xbf16, #dense> -> bf16
    %value_upper_raw_bf16 = view.load %qkv_view[%token, %value_upper_row] : view<[%token_count]x[%qkv_size]xbf16, #dense> -> bf16
    %value_lower = scalar.extf %value_lower_raw_bf16 : bf16 to f32
    %value_upper = scalar.extf %value_upper_raw_bf16 : bf16 to f32
    %value_lower_bf16 = scalar.fptrunc %value_lower : f32 to bf16
    %value_upper_bf16 = scalar.fptrunc %value_upper : f32 to bf16
    view.store %value_lower_bf16, %value_view[%token, %lower_channel] : bf16, view<[%value_token_stride]x[%hidden_size]xbf16, %value_layout>
    view.store %value_upper_bf16, %value_view[%token, %upper_channel] : bf16, view<[%value_token_stride]x[%hidden_size]xbf16, %value_layout>
  }
  %is_first_token = index.cmp eq, %token, %zero : index
  scf.if %is_first_token {
    %tail_token_count = index.sub %value_token_stride, %token_count : index
    %tail_element_count = index.mul %tail_token_count, %head_size : index
    scf.for %tail_element = [%lane to %tail_element_count step %workgroup_size_x] {
      %tail_token_ordinal = index.div %tail_element, %head_size : index
      %tail_head_channel = index.rem %tail_element, %head_size : index
      %tail_token = index.add %token_count, %tail_token_ordinal : index
      %tail_channel = index.add %head_base, %tail_head_channel : index
      view.store %zero_bf16, %rotated_query_view[%tail_token, %tail_channel] : bf16, view<[%value_token_stride]x[%hidden_size]xbf16, #dense>
      view.store %zero_bf16, %rotated_key_view[%tail_token, %tail_channel] : bf16, view<[%value_token_stride]x[%hidden_size]xbf16, #dense>
      view.store %zero_bf16, %value_view[%tail_token, %tail_channel] : bf16, view<[%value_token_stride]x[%hidden_size]xbf16, %value_layout>
    }
  }
  kernel.return
}

check.case public @id4_ideogram4_qkv_norm_rotary_bf16_small_case {
  %qkv = check.generate.iota offset(1.0) step(1.0) : tensor<1x6xbf16>
  %norm_q_weight = check.generate.fill value(1.0) : tensor<2xbf16>
  %norm_k_weight = check.generate.fill value(1.0) : tensor<2xbf16>
  %position_embedding = check.generate.fill value(1.0) : tensor<2x2x1x1xf32>
  %rotated_query = check.generate.fill value(0.0) : tensor<1x2xbf16>
  %rotated_key = check.generate.fill value(0.0) : tensor<1x2xbf16>
  %value = check.generate.fill value(0.0) : tensor<1x2xbf16>
  %expected_query = check.generate.fill value(1.8984399999999999) : tensor<1x2xbf16>
  %expected_key = check.generate.fill value(1.9765600000000001) : tensor<1x2xbf16>
  %expected_value = check.generate.iota offset(5.0) step(1.0) : tensor<1x2xbf16>
  func.call @id4_ideogram4_qkv_norm_rotary_bf16(%qkv, %norm_q_weight, %norm_k_weight, %position_embedding, %rotated_query, %rotated_key, %value) : (tensor<1x6xbf16>, tensor<2xbf16>, tensor<2xbf16>, tensor<2x2x1x1xf32>, tensor<1x2xbf16>, tensor<1x2xbf16>, tensor<1x2xbf16>)
  check.expect.close actual(%rotated_query) expected(%expected_query) atol(0.0001) rtol(0.0001) nan(same) : tensor<1x2xbf16>
  check.expect.close actual(%rotated_key) expected(%expected_key) atol(0.0001) rtol(0.0001) nan(same) : tensor<1x2xbf16>
  check.expect.close actual(%value) expected(%expected_value) atol(0.0) rtol(0.0) nan(same) : tensor<1x2xbf16>
  check.return
}

