config.decl @id4.ideogram4.rmsnorm_gated_residual.token_count : %value: index where [range(%value, 1, 131072)]
config.decl @id4.ideogram4.rmsnorm_gated_residual.hidden_size : %value: index where [range(%value, 1, 65536)]

kernel.def export("id4_ideogram4_rmsnorm_gated_residual_f32") @id4_ideogram4_rmsnorm_gated_residual_f32() {
  %unit = index.constant 1 : index
  %workgroup_size_x = index.constant 256 : index
  %token_count = config.get @id4.ideogram4.rmsnorm_gated_residual.token_count : index
  kernel.launch.config workgroups(%token_count, %unit, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%input: buffer, %weight: buffer, %gate: buffer, %residual: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %workgroup_size_x = index.constant 256 : index
  %token = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %token_count = config.get @id4.ideogram4.rmsnorm_gated_residual.token_count : index
  %hidden_size = config.get @id4.ideogram4.rmsnorm_gated_residual.hidden_size : index
  %zero_f32 = scalar.constant 0.0 : f32
  %epsilon = scalar.constant 0.00001 : f32
  %hidden_size_i32 = index.cast %hidden_size : index to i32
  %hidden_size_f32 = scalar.sitofp %hidden_size_i32 : i32 to f32

  %input_noalias, %weight_noalias, %gate_noalias, %residual_noalias, %output_noalias = buffer.assume.noalias %input, %weight, %gate, %residual, %output : buffer, buffer, buffer, buffer, buffer
  %input_global = buffer.assume.memory_space<global> %input_noalias : buffer
  %weight_global = buffer.assume.memory_space<global> %weight_noalias : buffer
  %gate_global = buffer.assume.memory_space<global> %gate_noalias : buffer
  %residual_global = buffer.assume.memory_space<global> %residual_noalias : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  %input_view = buffer.view %input_global[%base] : buffer -> view<[%hidden_size]x[%token_count]xf32, #dense>
  %weight_view = buffer.view %weight_global[%base] : buffer -> view<[%hidden_size]xbf16, #dense>
  %gate_view = buffer.view %gate_global[%base] : buffer -> view<[%hidden_size]xf32, #dense>
  %residual_view = buffer.view %residual_global[%base] : buffer -> view<[%hidden_size]x[%token_count]xf32, #dense>
  %output_view = buffer.view %output_global[%base] : buffer -> view<[%hidden_size]x[%token_count]xf32, #dense>

  %lane_square_sum = scf.for %hidden = [%lane to %hidden_size step %workgroup_size_x](%acc = %zero_f32 : f32) -> (f32) {
    %value = view.load %input_view[%hidden, %token] : view<[%hidden_size]x[%token_count]xf32, #dense> -> f32
    %square = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %value, %value : f32
    %next = scalar.addf<reassoc|nnan|ninf|nsz> %acc, %square : f32
    scf.yield %next : f32
  }
  %square_sum = kernel.workgroup.reduce<addf> %lane_square_sum : f32
  %mean_square = scalar.divf<nnan|ninf|nsz|arcp> %square_sum, %hidden_size_f32 : f32
  %mean_square_epsilon = scalar.addf<nnan|ninf|nsz> %mean_square, %epsilon : f32
  %row_scale = scalar.rsqrtf<nnan|ninf|nsz|afn> %mean_square_epsilon : f32

  scf.for %hidden = [%lane to %hidden_size step %workgroup_size_x] {
    %value = view.load %input_view[%hidden, %token] : view<[%hidden_size]x[%token_count]xf32, #dense> -> f32
    %weight_bf16 = view.load %weight_view[%hidden] : view<[%hidden_size]xbf16, #dense> -> bf16
    %weight_value = scalar.extf %weight_bf16 : bf16 to f32
    %gate_value = view.load %gate_view[%hidden] : view<[%hidden_size]xf32, #dense> -> f32
    %residual_value = view.load %residual_view[%hidden, %token] : view<[%hidden_size]x[%token_count]xf32, #dense> -> f32
    %normalized = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %value, %row_scale : f32
    %weighted = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %normalized, %weight_value : f32
    %gated = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %weighted, %gate_value : f32
    %output_value = scalar.addf<reassoc|nnan|ninf|nsz> %residual_value, %gated : f32
    view.store %output_value, %output_view[%hidden, %token] : f32, view<[%hidden_size]x[%token_count]xf32, #dense>
  }
  kernel.return
}

check.case public @id4_ideogram4_rmsnorm_gated_residual_f32_small_case {
  %input = check.generate.fill value(2.0) : tensor<4x1xf32>
  %weight = check.generate.fill value(1.0) : tensor<4xbf16>
  %gate = check.generate.fill value(3.0) : tensor<4xf32>
  %residual = check.generate.fill value(10.0) : tensor<4x1xf32>
  %output = check.generate.fill value(0.0) : tensor<4x1xf32>
  %expected = check.generate.fill value(13.0) : tensor<4x1xf32>
  func.call @id4_ideogram4_rmsnorm_gated_residual_f32(%input, %weight, %gate, %residual, %output) : (tensor<4x1xf32>, tensor<4xbf16>, tensor<4xf32>, tensor<4x1xf32>, tensor<4x1xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.00001) rtol(0.00001) nan(same) : tensor<4x1xf32>
  check.return
}

check.case public @id4_ideogram4_rmsnorm_gated_residual_f32_ideogram_shape_case {
  %input = check.generate.fill value(2.0) : tensor<4608x2xf32>
  %weight = check.generate.fill value(1.0) : tensor<4608xbf16>
  %gate = check.generate.fill value(1.0) : tensor<4608xf32>
  %residual = check.generate.fill value(7.0) : tensor<4608x2xf32>
  %output = check.generate.fill value(0.0) : tensor<4608x2xf32>
  %expected = check.generate.fill value(8.0) : tensor<4608x2xf32>
  func.call @id4_ideogram4_rmsnorm_gated_residual_f32(%input, %weight, %gate, %residual, %output) : (tensor<4608x2xf32>, tensor<4608xbf16>, tensor<4608xf32>, tensor<4608x2xf32>, tensor<4608x2xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.00001) rtol(0.00001) nan(same) : tensor<4608x2xf32>
  check.return
}

check.benchmark<@id4_ideogram4_rmsnorm_gated_residual_f32_small_case> @id4_ideogram4_rmsnorm_gated_residual_f32_small
check.benchmark<@id4_ideogram4_rmsnorm_gated_residual_f32_ideogram_shape_case> @id4_ideogram4_rmsnorm_gated_residual_f32_ideogram_shape
