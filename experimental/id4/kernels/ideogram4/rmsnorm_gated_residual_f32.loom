  %input_view = buffer.view %input_global[%base] : buffer -> view<[%token_count]x[%hidden_size]xbf16, #dense>
  %weight_view = buffer.view %weight_global[%base] : buffer -> view<[%hidden_size]xbf16, #dense>
  %gate_view = buffer.view %gate_global[%base] : buffer -> view<[%hidden_size]xf32, #dense>
  %residual_view = buffer.view %residual_global[%base] : buffer -> view<[%hidden_size]x[%token_count]xf32, #dense>
  %output_view = buffer.view %output_global[%base] : buffer -> view<[%hidden_size]x[%token_count]xf32, #dense>
  %lane_square_sum = scf.for %hidden = [%lane to %hidden_size step %workgroup_size_x](%acc = %zero_f32 : f32) -> (f32) {
    %value_bf16 = view.load %input_view[%token, %hidden] : view<[%token_count]x[%hidden_size]xbf16, #dense> -> bf16
    %value = scalar.extf %value_bf16 : bf16 to f32
    %square = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %value, %value : f32
    %next = scalar.addf<reassoc|nnan|ninf|nsz> %acc, %square : f32
    scf.yield %next : f32
  }
  %square_sum = kernel.workgroup.reduce<addf> %lane_square_sum : f32
  %mean_square = scalar.divf<nnan|ninf|nsz|arcp> %square_sum, %hidden_size_f32 : f32
  %mean_square_epsilon = scalar.addf<nnan|ninf|nsz> %mean_square, %epsilon : f32
  %row_scale = scalar.rsqrtf<nnan|ninf|nsz|afn> %mean_square_epsilon : f32
  scf.for %hidden = [%lane to %hidden_size step %workgroup_size_x] {
    %value_bf16 = view.load %input_view[%token, %hidden] : view<[%token_count]x[%hidden_size]xbf16, #dense> -> bf16
    %value = scalar.extf %value_bf16 : bf16 to f32
    %weight_bf16 = view.load %weight_view[%hidden] : view<[%hidden_size]xbf16, #dense> -> bf16
    %weight_value = scalar.extf %weight_bf16 : bf16 to f32
    %gate_value = view.load %gate_view[%hidden] : view<[%hidden_size]xf32, #dense> -> f32
    %residual_value = view.load %residual_view[%hidden, %token] : view<[%hidden_size]x[%token_count]xf32, #dense> -> f32
    %normalized = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %value, %row_scale : f32
    %weighted = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %normalized, %weight_value : f32
    %weighted_bf16 = scalar.fptrunc %weighted : f32 to bf16
    %weighted_value = scalar.extf %weighted_bf16 : bf16 to f32
    %gate_bf16 = scalar.fptrunc %gate_value : f32 to bf16
    %gate_rounded = scalar.extf %gate_bf16 : bf16 to f32
    %gated = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %weighted_value, %gate_rounded : f32
    %gated_bf16 = scalar.fptrunc %gated : f32 to bf16
    %gated_value = scalar.extf %gated_bf16 : bf16 to f32
    %residual_bf16 = scalar.fptrunc %residual_value : f32 to bf16
    %residual_rounded = scalar.extf %residual_bf16 : bf16 to f32
    %output_value = scalar.addf<reassoc|nnan|ninf|nsz> %residual_rounded, %gated_value : f32
    %output_bf16 = scalar.fptrunc %output_value : f32 to bf16
    %output_rounded = scalar.extf %output_bf16 : bf16 to f32
    view.store %output_rounded, %output_view[%hidden, %token] : f32, view<[%hidden_size]x[%token_count]xf32, #dense>
  }
  kernel.return
}

