config.decl @id4.ideogram4.linear_fp8.token_count : %value: index where [range(%value, 1, 131072)]
config.decl @id4.ideogram4.linear_fp8.token_offset : %value: index where [range(%value, 0, 131071)]
config.decl @id4.ideogram4.linear_fp8.dispatch_token_count : %value: index where [range(%value, 1, 131072)]
config.decl @id4.ideogram4.linear_fp8.input_size : %value: index where [range(%value, 1, 131072)]
config.decl @id4.ideogram4.linear_fp8.output_size : %value: index where [range(%value, 1, 131072)]

kernel.def export("id4_ideogram4_linear_fp8_f32") @id4_ideogram4_linear_fp8_f32() {
  %unit = index.constant 1 : index
  %fifteen = index.constant 15 : index
  %workgroup_size_x = index.constant 256 : index
  %token_block = index.constant 16 : index
  %row_block = index.constant 16 : index
  %dispatch_token_count = config.get @id4.ideogram4.linear_fp8.dispatch_token_count : index
  %output_size = config.get @id4.ideogram4.linear_fp8.output_size : index
  %rounded_token_count = index.add %dispatch_token_count, %fifteen : index
  %token_tile_count = index.div %rounded_token_count, %token_block : index
  %rounded_output_size = index.add %output_size, %fifteen : index
  %row_tile_count = index.div %rounded_output_size, %row_block : index
  kernel.launch.config workgroups(%token_tile_count, %row_tile_count, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%input: buffer, %weight: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %scratch_bytes = index.constant 8192 : offset
  %workgroup_size_x = index.constant 256 : index
  %token_block = index.constant 16 : index
  %row_block = index.constant 16 : index
  %k_block = index.constant 128 : index
  %scratch_tile_elements = index.constant 2048 : index
  %token_tile = kernel.workgroup.id<x> : index
  %row_tile = kernel.workgroup.id<y> : index
  %lane = kernel.workitem.id<x> : index
  %token_count = config.get @id4.ideogram4.linear_fp8.token_count : index
  %token_base_offset = config.get @id4.ideogram4.linear_fp8.token_offset : index
  %dispatch_token_count = config.get @id4.ideogram4.linear_fp8.dispatch_token_count : index
  %input_size = config.get @id4.ideogram4.linear_fp8.input_size : index
  %output_size = config.get @id4.ideogram4.linear_fp8.output_size : index
  %base_dispatch_token = index.mul %token_tile, %token_block : index
  %base_row = index.mul %row_tile, %row_block : index
  %local_row = index.div %lane, %token_block : index
  %local_token = index.rem %lane, %token_block : index
  %output_row = index.add %base_row, %local_row : index
  %dispatch_token = index.add %base_dispatch_token, %local_token : index
  %token = index.add %token_base_offset, %dispatch_token : index
  %zero_f32 = scalar.constant 0.0 : f32

  %input_noalias, %weight_noalias, %output_noalias = buffer.assume.noalias %input, %weight, %output : buffer, buffer, buffer
  %input_global = buffer.assume.memory_space<global> %input_noalias : buffer
  %weight_global = buffer.assume.memory_space<global> %weight_noalias : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  %input_view = buffer.view %input_global[%base] : buffer -> view<[%input_size]x[%token_count]xf32, #dense>
  %weight_view = buffer.view %weight_global[%base] : buffer -> view<[%output_size]x[%input_size]xf8E4M3, #dense>
  %output_view = buffer.view %output_global[%base] : buffer -> view<[%output_size]x[%token_count]xf32, #dense>

  %scratch_weight = buffer.alloca %scratch_bytes {base_alignment = 16, memory_space = workgroup} : buffer
  %scratch_input = buffer.alloca %scratch_bytes {base_alignment = 16, memory_space = workgroup} : buffer
  %scratch_weight_view = buffer.view %scratch_weight[%base] : buffer -> view<2048xf32, #dense>
  %scratch_input_view = buffer.view %scratch_input[%base] : buffer -> view<2048xf32, #dense>

  %dot = scf.for %k_base = [%zero to %input_size step %k_block](%acc = %zero_f32 : f32) -> (f32) {
    scf.for %linear = [%lane to %scratch_tile_elements step %workgroup_size_x] {
      %weight_k_offset = index.rem %linear, %k_block : index
      %weight_row_offset = index.div %linear, %k_block : index
      %weight_row = index.add %base_row, %weight_row_offset : index
      %weight_k = index.add %k_base, %weight_k_offset : index
      %weight_row_valid = index.cmp ult, %weight_row, %output_size : index
      %weight_k_valid = index.cmp ult, %weight_k, %input_size : index
      %weight_valid = scalar.andi %weight_row_valid, %weight_k_valid : i1
      %weight_value = scf.if %weight_valid -> (f32) {
        %weight_fp8 = view.load %weight_view[%weight_row, %weight_k] : view<[%output_size]x[%input_size]xf8E4M3, #dense> -> f8E4M3
        %weight_f32 = scalar.extf %weight_fp8 : f8E4M3 to f32
        scf.yield %weight_f32 : f32
      } else {
        scf.yield %zero_f32 : f32
      }
      view.store %weight_value, %scratch_weight_view[%linear] : f32, view<2048xf32, #dense>

      %input_token_offset = index.rem %linear, %token_block : index
      %input_k_offset = index.div %linear, %token_block : index
      %input_dispatch_token = index.add %base_dispatch_token, %input_token_offset : index
      %input_token = index.add %token_base_offset, %input_dispatch_token : index
      %input_k = index.add %k_base, %input_k_offset : index
      %input_dispatch_token_valid = index.cmp ult, %input_dispatch_token, %dispatch_token_count : index
      %input_token_valid = index.cmp ult, %input_token, %token_count : index
      %input_k_valid = index.cmp ult, %input_k, %input_size : index
      %input_token_in_range = scalar.andi %input_dispatch_token_valid, %input_token_valid : i1
      %input_valid = scalar.andi %input_token_in_range, %input_k_valid : i1
      %input_value = scf.if %input_valid -> (f32) {
        %loaded = view.load %input_view[%input_k, %input_token] : view<[%input_size]x[%token_count]xf32, #dense> -> f32
        scf.yield %loaded : f32
      } else {
        scf.yield %zero_f32 : f32
      }
      view.store %input_value, %scratch_input_view[%linear] : f32, view<2048xf32, #dense>
    }

    kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}

    %block_dot = scf.for %k_offset = [%zero to %k_block step %one](%block_acc = %acc : f32) -> (f32) {
      %weight_scratch_row_base = index.mul %local_row, %k_block : index
      %weight_scratch_index = index.add %weight_scratch_row_base, %k_offset : index
      %input_scratch_k_base = index.mul %k_offset, %token_block : index
      %input_scratch_index = index.add %input_scratch_k_base, %local_token : index
      %weight_value = view.load %scratch_weight_view[%weight_scratch_index] : view<2048xf32, #dense> -> f32
      %input_value = view.load %scratch_input_view[%input_scratch_index] : view<2048xf32, #dense> -> f32
      %product = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %input_value, %weight_value : f32
      %next = scalar.addf<reassoc|nnan|ninf|nsz> %block_acc, %product : f32
      scf.yield %next : f32
    }

    kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
    scf.yield %block_dot : f32
  }

  %dispatch_token_valid = index.cmp ult, %dispatch_token, %dispatch_token_count : index
  %token_valid = index.cmp ult, %token, %token_count : index
  %row_valid = index.cmp ult, %output_row, %output_size : index
  %valid_token = scalar.andi %dispatch_token_valid, %token_valid : i1
  %valid_output = scalar.andi %valid_token, %row_valid : i1
  scf.if %valid_output {
    view.store %dot, %output_view[%output_row, %token] : f32, view<[%output_size]x[%token_count]xf32, #dense>
  }
  kernel.return
}

check.case public @id4_ideogram4_linear_fp8_f32_small_case {
  %input = check.generate.fill value(1.0) : tensor<16x2xf32>
  %weight = check.generate.fill value(1.0) : tensor<8x16xf8E4M3>
  %output = check.generate.fill value(0.0) : tensor<8x2xf32>
  %expected = check.generate.fill value(16.0) : tensor<8x2xf32>
  func.call @id4_ideogram4_linear_fp8_f32(%input, %weight, %output) : (tensor<16x2xf32>, tensor<8x16xf8E4M3>, tensor<8x2xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<8x2xf32>
  check.return
}

