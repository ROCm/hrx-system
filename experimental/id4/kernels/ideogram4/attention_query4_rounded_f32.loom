  %query = check.generate.fill value(0.0) : tensor<1x2xf32>
  %key = check.generate.fill value(0.0) : tensor<1x2xf32>
  %value = check.generate.iota offset(1.01) step(2.02) : tensor<1x2xf32>
  %output = check.generate.fill value(0.0) : tensor<2x1xf32>
  %expected = check.generate.iota offset(1.009765625) step(2.01953125) : tensor<2x1xf32>
  func.call @id4_ideogram4_attention_query4_rounded_f32(%query, %key, %value, %output) : (tensor<1x2xf32>, tensor<1x2xf32>, tensor<1x2xf32>, tensor<2x1xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<2x1xf32>
  check.return
}

