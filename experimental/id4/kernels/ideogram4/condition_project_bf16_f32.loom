config.decl @id4.ideogram4.condition_project.text_token_count : %value: index where [range(%value, 1, 65536)]

config.decl @id4.ideogram4.condition_project.total_token_count : %value: index where [range(%value, 1, 131072)]

config.decl @id4.ideogram4.condition_project.feature_count : %value: index where [range(%value, 4, 131072)]

config.decl @id4.ideogram4.condition_project.hidden_size : %value: index where [range(%value, 1, 65536)]

kernel.def export("id4_ideogram4_condition_project_bf16_f32") @id4_ideogram4_condition_project_bf16_f32() {
  %unit = index.constant 1 : index
  %fifteen = index.constant 15 : index
  %workgroup_size_x = index.constant 256 : index
  %token_block = index.constant 16 : index
  %row_block = index.constant 16 : index
  %text_token_count = config.get @id4.ideogram4.condition_project.text_token_count : index
  %rounded_token_count = index.add %text_token_count, %fifteen : index
  %token_tile_count = index.div %rounded_token_count, %token_block : index
  %hidden_size = config.get @id4.ideogram4.condition_project.hidden_size : index
  %rounded_hidden_size = index.add %hidden_size, %fifteen : index
  %row_tile_count = index.div %rounded_hidden_size, %row_block : index
  kernel.launch.config workgroups(%token_tile_count, %row_tile_count, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%input: buffer, %weight: buffer, %bias: buffer, %image_indicator: buffer, %indicator_embedding: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %scratch_bytes = index.constant 4096 : offset
  %workgroup_size_x = index.constant 256 : index
  %token_block = index.constant 16 : index
  %row_block = index.constant 16 : index
  %k_block = index.constant 64 : index
  %scratch_tile_elements = index.constant 1024 : index
  %token_tile = kernel.workgroup.id<x> : index
  %row_tile = kernel.workgroup.id<y> : index
  %lane = kernel.workitem.id<x> : index
  %text_token_count = config.get @id4.ideogram4.condition_project.text_token_count : index
  %total_token_count = config.get @id4.ideogram4.condition_project.total_token_count : index
  %feature_count = config.get @id4.ideogram4.condition_project.feature_count : index
  %hidden_size = config.get @id4.ideogram4.condition_project.hidden_size : index
  %base_text_token = index.mul %token_tile, %token_block : index
  %base_row = index.mul %row_tile, %row_block : index
  %local_row = index.div %lane, %token_block : index
  %local_token = index.rem %lane, %token_block : index
  %output_row = index.add %base_row, %local_row : index
  %text_token = index.add %base_text_token, %local_token : index
  %zero_f32 = scalar.constant 0.0 : f32
  %input_noalias, %weight_noalias, %bias_noalias, %image_indicator_noalias, %indicator_embedding_noalias, %output_noalias = buffer.assume.noalias %input, %weight, %bias, %image_indicator, %indicator_embedding, %output : buffer, buffer, buffer, buffer, buffer, buffer
  %input_global = buffer.assume.memory_space<global> %input_noalias : buffer
  %weight_global = buffer.assume.memory_space<global> %weight_noalias : buffer
  %bias_global = buffer.assume.memory_space<global> %bias_noalias : buffer
  %image_indicator_global = buffer.assume.memory_space<global> %image_indicator_noalias : buffer
  %indicator_embedding_global = buffer.assume.memory_space<global> %indicator_embedding_noalias : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  %input_view = buffer.view %input_global[%base] : buffer -> view<[%feature_count]x[%text_token_count]xf32, #dense>
  %weight_view = buffer.view %weight_global[%base] : buffer -> view<[%hidden_size]x[%feature_count]xbf16, #dense>
  %bias_view = buffer.view %bias_global[%base] : buffer -> view<[%hidden_size]xbf16, #dense>
  %image_indicator_view = buffer.view %image_indicator_global[%base] : buffer -> view<[%total_token_count]xi32, #dense>
  %indicator_embedding_view = buffer.view %indicator_embedding_global[%base] : buffer -> view<2x[%hidden_size]xbf16, #dense>
  %output_view = buffer.view %output_global[%base] : buffer -> view<[%hidden_size]x[%total_token_count]xf32, #dense>
  %scratch_weight = buffer.alloca %scratch_bytes {base_alignment = 16, memory_space = workgroup} : buffer
  %scratch_input = buffer.alloca %scratch_bytes {base_alignment = 16, memory_space = workgroup} : buffer
  %scratch_weight_view = buffer.view %scratch_weight[%base] : buffer -> view<1024xf32, #dense>
  %scratch_input_view = buffer.view %scratch_input[%base] : buffer -> view<1024xf32, #dense>
  %dot = scf.for %k_base = [%zero to %feature_count step %k_block](%acc = %zero_f32 : f32) -> (f32) {
    scf.for %linear = [%lane to %scratch_tile_elements step %workgroup_size_x] {
      %weight_k_offset = index.rem %linear, %k_block : index
      %weight_row_offset = index.div %linear, %k_block : index
      %weight_row = index.add %base_row, %weight_row_offset : index
      %weight_k = index.add %k_base, %weight_k_offset : index
      %weight_row_valid = index.cmp ult, %weight_row, %hidden_size : index
      %weight_k_valid = index.cmp ult, %weight_k, %feature_count : index
      %weight_valid = scalar.andi %weight_row_valid, %weight_k_valid : i1
      %weight_value = scf.if %weight_valid -> (f32) {
        %weight_bf16 = view.load %weight_view[%weight_row, %weight_k] : view<[%hidden_size]x[%feature_count]xbf16, #dense> -> bf16
        %weight_f32 = scalar.extf %weight_bf16 : bf16 to f32
        scf.yield %weight_f32 : f32
      } else {
        scf.yield %zero_f32 : f32
      }
      view.store %weight_value, %scratch_weight_view[%linear] : f32, view<1024xf32, #dense>
      %input_token_offset = index.rem %linear, %token_block : index
      %input_k_offset = index.div %linear, %token_block : index
      %input_text_token = index.add %base_text_token, %input_token_offset : index
      %input_k = index.add %k_base, %input_k_offset : index
      %input_token_valid = index.cmp ult, %input_text_token, %text_token_count : index
      %input_k_valid = index.cmp ult, %input_k, %feature_count : index
      %input_valid = scalar.andi %input_token_valid, %input_k_valid : i1
      %input_value = scf.if %input_valid -> (f32) {
        %loaded = view.load %input_view[%input_k, %input_text_token] : view<[%feature_count]x[%text_token_count]xf32, #dense> -> f32
        %loaded_bf16 = scalar.fptrunc %loaded : f32 to bf16
        %rounded = scalar.extf %loaded_bf16 : bf16 to f32
        scf.yield %rounded : f32
      } else {
        scf.yield %zero_f32 : f32
      }
      view.store %input_value, %scratch_input_view[%linear] : f32, view<1024xf32, #dense>
    }
    kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
    %block_dot = scf.for %k_offset = [%zero to %k_block step %one](%block_acc = %acc : f32) -> (f32) {
      %weight_scratch_row_base = index.mul %local_row, %k_block : index
      %weight_scratch_index = index.add %weight_scratch_row_base, %k_offset : index
      %input_scratch_k_base = index.mul %k_offset, %token_block : index
      %input_scratch_index = index.add %input_scratch_k_base, %local_token : index
      %weight_value = view.load %scratch_weight_view[%weight_scratch_index] : view<1024xf32, #dense> -> f32
      %input_value = view.load %scratch_input_view[%input_scratch_index] : view<1024xf32, #dense> -> f32
      %product = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %input_value, %weight_value : f32
      %next = scalar.addf<reassoc|nnan|ninf|nsz> %block_acc, %product : f32
      scf.yield %next : f32
    }
    kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
    scf.yield %block_dot : f32
  }
  %token_valid = index.cmp ult, %text_token, %text_token_count : index
  %row_valid = index.cmp ult, %output_row, %hidden_size : index
  %valid_output = scalar.andi %token_valid, %row_valid : i1
  scf.if %valid_output {
    %bias_bf16 = view.load %bias_view[%output_row] : view<[%hidden_size]xbf16, #dense> -> bf16
    %bias_f32 = scalar.extf %bias_bf16 : bf16 to f32
    %indicator = view.load %image_indicator_view[%text_token] : view<[%total_token_count]xi32, #dense> -> i32
    %indicator_index = index.cast %indicator : i32 to index
    %indicator_embedding_bf16 = view.load %indicator_embedding_view[%indicator_index, %output_row] : view<2x[%hidden_size]xbf16, #dense> -> bf16
    %indicator_embedding_f32 = scalar.extf %indicator_embedding_bf16 : bf16 to f32
    %with_bias = scalar.addf<reassoc|nnan|ninf|nsz> %dot, %bias_f32 : f32
    %with_bias_bf16 = scalar.fptrunc %with_bias : f32 to bf16
    %with_bias_value = scalar.extf %with_bias_bf16 : bf16 to f32
    %value = scalar.addf<reassoc|nnan|ninf|nsz> %with_bias_value, %indicator_embedding_f32 : f32
    %value_bf16 = scalar.fptrunc %value : f32 to bf16
    %value_rounded = scalar.extf %value_bf16 : bf16 to f32
    view.store %value_rounded, %output_view[%output_row, %text_token] : f32, view<[%hidden_size]x[%total_token_count]xf32, #dense>
  }
  kernel.return
}

check.case public @id4_ideogram4_condition_project_bf16_f32_small_case {
  %input = check.generate.fill value(1.01) : tensor<4x1xf32>
  %weight = check.generate.iota offset(1.0) step(1.0) : tensor<2x4xbf16>
  %bias = check.generate.fill value(2.0) : tensor<2xbf16>
  %image_indicator = check.generate.fill value(0) : tensor<1xi32>
  %indicator_embedding = check.generate.fill value(3.0) : tensor<2x2xbf16>
  %output = check.generate.fill value(0.0) : tensor<2x1xf32>
  %expected = check.generate.iota offset(15.0625) step(16.1875) : tensor<2x1xf32>
  func.call @id4_ideogram4_condition_project_bf16_f32(%input, %weight, %bias, %image_indicator, %indicator_embedding, %output) : (tensor<4x1xf32>, tensor<2x4xbf16>, tensor<2xbf16>, tensor<1xi32>, tensor<2x2xbf16>, tensor<2x1xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<2x1xf32>
  check.return
}

