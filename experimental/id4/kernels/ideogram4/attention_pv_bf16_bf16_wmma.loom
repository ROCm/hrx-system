amdgpu.target<gfx1100> @id4_gfx1100

config.decl @id4.ideogram4.attention_pv_wmma.token_count : %value: index where [range(%value, 16, 131072), mul(%value, 16)]
config.decl @id4.ideogram4.attention_pv_wmma.attention_head_count : %value: index where [range(%value, 1, 1024)]
config.decl @id4.ideogram4.attention_pv_wmma.head_size : %value: index where [range(%value, 16, 1024), mul(%value, 16)]
config.decl @id4.ideogram4.attention_pv_wmma.head_ordinal : %value: index where [range(%value, 0, 1023)]

kernel.def target(@id4_gfx1100) export("id4_ideogram4_attention_pv_bf16_bf16_wmma") @id4_ideogram4_attention_pv_bf16_bf16_wmma() {
  %unit = index.constant 1 : index
  %sixteen = index.constant 16 : index
  %workgroup_size_x = index.constant 32 : index
  %token_count = config.get @id4.ideogram4.attention_pv_wmma.token_count : index
  %head_size = config.get @id4.ideogram4.attention_pv_wmma.head_size : index
  %query_tile_count = index.div %token_count, %sixteen : index
  %channel_tile_count = index.div %head_size, %sixteen : index
  kernel.launch.config workgroups(%query_tile_count, %channel_tile_count, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%probabilities: buffer, %value: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %sixteen = index.constant 16 : index
  %query_tile = kernel.workgroup.id<x> : index
  %channel_tile = kernel.workgroup.id<y> : index
  %token_count = config.get @id4.ideogram4.attention_pv_wmma.token_count : index
  %attention_head_count = config.get @id4.ideogram4.attention_pv_wmma.attention_head_count : index
  %head_size = config.get @id4.ideogram4.attention_pv_wmma.head_size : index
  %head_ordinal = config.get @id4.ideogram4.attention_pv_wmma.head_ordinal : index
  %hidden_size = index.mul %attention_head_count, %head_size : index
  %head_base = index.mul %head_ordinal, %head_size : index
  %query_origin = index.mul %query_tile, %sixteen : index
  %head_channel_offset = index.mul %channel_tile, %sixteen : index
  %channel_origin = index.add %head_base, %head_channel_offset : index
  %key_tile_count = index.div %token_count, %sixteen : index
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %value_layout = encoding.layout.strided [1, %token_count] : encoding<layout>
  %zero_acc = vector.constant 0.0 : vector<8xf32>

  %probabilities_noalias, %value_noalias, %output_noalias = buffer.assume.noalias %probabilities, %value, %output : buffer, buffer, buffer
  %probabilities_global = buffer.assume.memory_space<global> %probabilities_noalias : buffer
  %value_global = buffer.assume.memory_space<global> %value_noalias : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  %probabilities_aligned = buffer.assume.alignment %probabilities_global {minimum_alignment = 16} : buffer
  %value_aligned = buffer.assume.alignment %value_global {minimum_alignment = 16} : buffer
  %output_aligned = buffer.assume.alignment %output_global {minimum_alignment = 16} : buffer
  %probabilities_view = buffer.view %probabilities_aligned[%base] : buffer -> view<[%token_count]x[%token_count]xbf16, #dense>
  %value_view = buffer.view %value_aligned[%base] : buffer -> view<[%token_count]x[%hidden_size]xbf16, %value_layout>
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<[%token_count]x[%hidden_size]xbf16, #dense>

  %init = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>
  %result = scf.for %key_tile = [%zero to %key_tile_count step %one](%acc = %init : vector<8xf32>) -> (vector<8xf32>) {
    %key_origin = index.mul %key_tile, %sixteen : index
    %lhs = vector.fragment.load<lhs> %probabilities_view[%query_origin, %key_origin] shape [%m, %k] : view<[%token_count]x[%token_count]xbf16, #dense> -> vector<16xbf16>
    %rhs = vector.fragment.load<rhs> %value_view[%key_origin, %channel_origin] shape [%k, %n] : view<[%token_count]x[%hidden_size]xbf16, %value_layout> -> vector<16xbf16>
    %next = vector.mma %lhs, %rhs, %acc : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    scf.yield %next : vector<8xf32>
  }
  vector.fragment.store<result> %result, %output_view[%query_origin, %channel_origin] shape [%m, %n] : vector<8xf32>, view<[%token_count]x[%hidden_size]xbf16, #dense>
  kernel.return
}

check.case public @id4_ideogram4_attention_pv_bf16_bf16_wmma_small_case {
  %probabilities = check.generate.fill value(0.0625) : tensor<16x16xbf16>
  %value = check.generate.fill value(2.0) : tensor<16x16xbf16>
  %output = check.generate.fill value(0.0) : tensor<16x16xbf16>
  %expected = check.generate.fill value(2.0) : tensor<16x16xbf16>
  func.call @id4_ideogram4_attention_pv_bf16_bf16_wmma(%probabilities, %value, %output) : (tensor<16x16xbf16>, tensor<16x16xbf16>, tensor<16x16xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<16x16xbf16>
  check.return
}

check.case public @id4_ideogram4_attention_pv_bf16_bf16_wmma_zero_1024_shape_case {
  %probabilities = check.generate.fill value(0.0) : tensor<4096x4096xbf16>
  %value = check.generate.fill value(1.0) : tensor<4096x4608xbf16>
  %output = check.generate.fill value(0.0) : tensor<4096x4608xbf16>
  %expected = check.generate.fill value(0.0) : tensor<4096x4608xbf16>
  func.call @id4_ideogram4_attention_pv_bf16_bf16_wmma(%probabilities, %value, %output) : (tensor<4096x4096xbf16>, tensor<4096x4608xbf16>, tensor<4096x4608xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<4096x4608xbf16>
  check.return
}

check.benchmark<@id4_ideogram4_attention_pv_bf16_bf16_wmma_small_case> @id4_ideogram4_attention_pv_bf16_bf16_wmma_small
check.benchmark<@id4_ideogram4_attention_pv_bf16_bf16_wmma_zero_1024_shape_case> @id4_ideogram4_attention_pv_bf16_bf16_wmma_zero_1024_shape
