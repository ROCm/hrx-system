config.decl @id4.ideogram4.linear_bias_fp8.token_count : %value: index where [range(%value, 1, 131072)]

config.decl @id4.ideogram4.linear_bias_fp8.token_offset : %value: index where [range(%value, 0, 131071)]

config.decl @id4.ideogram4.linear_bias_fp8.dispatch_token_count : %value: index where [range(%value, 1, 131072)]

config.decl @id4.ideogram4.linear_bias_fp8.input_size : %value: index where [range(%value, 4, 131072)]

config.decl @id4.ideogram4.linear_bias_fp8.output_size : %value: index where [range(%value, 1, 131072)]

kernel.def export("id4_ideogram4_linear_bias_fp8_f32") @id4_ideogram4_linear_bias_fp8_f32() {
  %unit = index.constant 1 : index
  %workgroup_size_x = index.constant 256 : index
  %dispatch_token_count = config.get @id4.ideogram4.linear_bias_fp8.dispatch_token_count : index
  %output_size = config.get @id4.ideogram4.linear_bias_fp8.output_size : index
  kernel.launch.config workgroups(%dispatch_token_count, %output_size, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%input: buffer, %weight: buffer, %scale: buffer, %bias: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %workgroup_size_x = index.constant 256 : index
  %token = kernel.workgroup.id<x> : index
  %output_row = kernel.workgroup.id<y> : index
  %lane = kernel.workitem.id<x> : index
  %token_count = config.get @id4.ideogram4.linear_bias_fp8.token_count : index
  %token_base_offset = config.get @id4.ideogram4.linear_bias_fp8.token_offset : index
  %dispatch_token_count = config.get @id4.ideogram4.linear_bias_fp8.dispatch_token_count : index
  %input_size_unaligned = config.get @id4.ideogram4.linear_bias_fp8.input_size : index
  %input_size = index.assume %input_size_unaligned [mul(%input_size_unaligned, 4)] : index
  %output_size = config.get @id4.ideogram4.linear_bias_fp8.output_size : index
  %input_token = index.add %token_base_offset, %token : index
  %zero_f32 = scalar.constant 0.0 : f32
  %dense_layout = encoding.define #dense : encoding<layout>
  %fp8_storage_schema = encoding.define #matrix_operand<element_format=f8e4m3, payload_elements=1, payload_registers=1, rounding=finite_only> : encoding<schema>
  %fp8_storage = encoding.define #physical_storage {layout = %dense_layout : encoding<layout>, schema = %fp8_storage_schema : encoding<schema>} : encoding<storage>
  %input_noalias, %weight_noalias, %scale_noalias, %bias_noalias, %output_noalias = buffer.assume.noalias %input, %weight, %scale, %bias, %output : buffer, buffer, buffer, buffer, buffer
  %input_global = buffer.assume.memory_space<global> %input_noalias : buffer
  %weight_global = buffer.assume.memory_space<global> %weight_noalias : buffer
  %scale_global = buffer.assume.memory_space<global> %scale_noalias : buffer
  %bias_global = buffer.assume.memory_space<global> %bias_noalias : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  %input_view = buffer.view %input_global[%base] : buffer -> view<[%input_size]x[%token_count]xf32, #dense>
  %weight_view = buffer.view %weight_global[%base] : buffer -> view<[%output_size]x[%input_size]xf8E4M3, %fp8_storage>
  %scale_view = buffer.view %scale_global[%base] : buffer -> view<[%output_size]xf32, #dense>
  %bias_view = buffer.view %bias_global[%base] : buffer -> view<[%output_size]xbf16, #dense>
  %output_view = buffer.view %output_global[%base] : buffer -> view<[%output_size]x[%dispatch_token_count]xf32, #dense>
  %scale_value = view.load %scale_view[%output_row] : view<[%output_size]xf32, #dense> -> f32
  %scale_bf16 = scalar.fptrunc %scale_value : f32 to bf16
  %scale_f32 = scalar.extf %scale_bf16 : bf16 to f32
  %lane_dot = scf.for %input_row = [%lane to %input_size step %workgroup_size_x](%acc = %zero_f32 : f32) -> (f32) {
    %loaded_input = view.load %input_view[%input_row, %input_token] : view<[%input_size]x[%token_count]xf32, #dense> -> f32
    %weight_fp8 = view.load %weight_view[%output_row, %input_row] : view<[%output_size]x[%input_size]xf8E4M3, %fp8_storage> -> f8E4M3
    %weight_f32 = scalar.extf %weight_fp8 : f8E4M3 to f32
    %scaled_weight_f32 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %weight_f32, %scale_f32 : f32
    %scaled_weight_bf16 = scalar.fptrunc %scaled_weight_f32 : f32 to bf16
    %scaled_weight = scalar.extf %scaled_weight_bf16 : bf16 to f32
    %product = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %loaded_input, %scaled_weight : f32
    %next = scalar.addf<reassoc|nnan|ninf|nsz> %acc, %product : f32
    scf.yield %next : f32
  }
  %dot = kernel.workgroup.reduce<addf> %lane_dot : f32
  %is_leader = index.cmp eq, %lane, %zero : index
  scf.if %is_leader {
    %bias_bf16 = view.load %bias_view[%output_row] : view<[%output_size]xbf16, #dense> -> bf16
    %bias_f32 = scalar.extf %bias_bf16 : bf16 to f32
    %value = scalar.addf<reassoc|nnan|ninf|nsz> %dot, %bias_f32 : f32
    view.store %value, %output_view[%output_row, %token] : f32, view<[%output_size]x[%dispatch_token_count]xf32, #dense>
  }
  kernel.return
}
