config.decl @id4.ideogram4.attention_score_mask.token_count : %value: index where [range(%value, 1, 131072)]
config.decl @id4.ideogram4.attention_score_mask.padded_token_count : %value: index where [range(%value, 16, 131072), mul(%value, 16)]
config.decl @id4.ideogram4.attention_score_mask.element_count : %value: index where [range(%value, 1, 268435456)]

kernel.def export("id4_ideogram4_attention_score_mask_f32") @id4_ideogram4_attention_score_mask_f32() {
  %unit = index.constant 1 : index
  %workgroup_size_x = index.constant 256 : index
  %element_count = config.get @id4.ideogram4.attention_score_mask.element_count : index
  %rounded = index.add %element_count, %workgroup_size_x : index
  %adjusted = index.sub %rounded, %unit : index
  %workgroups_x = index.div %adjusted, %workgroup_size_x : index
  kernel.launch.config workgroups(%workgroups_x, %unit, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%scores: buffer) {
  %base = index.constant 0 : offset
  %negative_large = scalar.constant -1000000000.0 : f32
  %workgroup_size_x = index.constant 256 : index
  %workgroup = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %token_count = config.get @id4.ideogram4.attention_score_mask.token_count : index
  %padded_token_count = config.get @id4.ideogram4.attention_score_mask.padded_token_count : index
  %element_count = config.get @id4.ideogram4.attention_score_mask.element_count : index
  %workgroup_base = index.mul %workgroup, %workgroup_size_x : index
  %element = index.add %workgroup_base, %lane : index
  %in_bounds = index.cmp ult, %element, %element_count : index

  %scores_global = buffer.assume.memory_space<global> %scores : buffer
  %scores_view = buffer.view %scores_global[%base] : buffer -> view<[%element_count]xf32, #dense>

  scf.if %in_bounds {
    %row = index.div %element, %padded_token_count : index
    %column = index.rem %element, %padded_token_count : index
    %valid_row = index.cmp ult, %row, %token_count : index
    %valid_column = index.cmp ult, %column, %token_count : index
    %valid_score = scalar.andi %valid_row, %valid_column : i1
    %old_score = view.load %scores_view[%element] : view<[%element_count]xf32, #dense> -> f32
    %new_score = scf.select %valid_score, %old_score, %negative_large : f32
    view.store %new_score, %scores_view[%element] : f32, view<[%element_count]xf32, #dense>
  }
  kernel.return
}

check.case public @id4_ideogram4_attention_score_mask_f32_small_case {
  %scores = check.generate.fill value(0.0) : tensor<16x16xf32>
  %expected = check.generate.fill value(0.0) : tensor<16x16xf32>
  func.call @id4_ideogram4_attention_score_mask_f32(%scores) : (tensor<16x16xf32>)
  check.expect.close actual(%scores) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<16x16xf32>
  check.return
}

check.benchmark<@id4_ideogram4_attention_score_mask_f32_small_case> @id4_ideogram4_attention_score_mask_f32_small
