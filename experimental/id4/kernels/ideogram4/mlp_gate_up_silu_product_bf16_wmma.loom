amdgpu.target<gfx1100> @id4_gfx1100

config.decl @id4.ideogram4.mlp_gate_up_silu_product_wmma.token_count : %value: index where [range(%value, 16, 131072)]

config.decl @id4.ideogram4.mlp_gate_up_silu_product_wmma.dispatch_token_count : %value: index where [range(%value, 16, 131072), mul(%value, 16)]

config.decl @id4.ideogram4.mlp_gate_up_silu_product_wmma.input_size : %value: index where [range(%value, 16, 131072), mul(%value, 16)]

config.decl @id4.ideogram4.mlp_gate_up_silu_product_wmma.intermediate_size : %value: index where [range(%value, 32, 65536), mul(%value, 32)]

kernel.def target(@id4_gfx1100) export("id4_ideogram4_mlp_gate_up_silu_product_bf16_wmma") @id4_ideogram4_mlp_gate_up_silu_product_bf16_wmma() {
  %unit = index.constant 1 : index
  %sixteen = index.constant 16 : index
  %thirty_two = index.constant 32 : index
  %workgroup_size_x = index.constant 32 : index
  %dispatch_token_count = config.get @id4.ideogram4.mlp_gate_up_silu_product_wmma.dispatch_token_count : index
  %intermediate_size = config.get @id4.ideogram4.mlp_gate_up_silu_product_wmma.intermediate_size : index
  %token_tile_count = index.div %dispatch_token_count, %sixteen : index
  %row_tile_count = index.div %intermediate_size, %thirty_two : index
  kernel.launch.config workgroups(%token_tile_count, %row_tile_count, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%input_bf16: buffer, %gate_weight: buffer, %up_weight: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %sixteen = index.constant 16 : index
  %thirty_two = index.constant 32 : index
  %token_tile = kernel.workgroup.id<x> : index
  %row_pair = kernel.workgroup.id<y> : index
  %token_count = config.get @id4.ideogram4.mlp_gate_up_silu_product_wmma.token_count : index
  %input_size = config.get @id4.ideogram4.mlp_gate_up_silu_product_wmma.input_size : index
  %intermediate_size = config.get @id4.ideogram4.mlp_gate_up_silu_product_wmma.intermediate_size : index
  %k_tile_count = index.div %input_size, %sixteen : index
  %token_origin = index.mul %token_tile, %sixteen : index
  %row_origin0 = index.mul %row_pair, %thirty_two : index
  %row_origin1 = index.add %row_origin0, %sixteen : index
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %weight_layout = encoding.layout.strided [1, %input_size] : encoding<layout>
  %zero_acc = vector.constant 0.0 : vector<8xf32>
  %input_noalias, %gate_weight_noalias, %up_weight_noalias, %output_noalias = buffer.assume.noalias %input_bf16, %gate_weight, %up_weight, %output : buffer, buffer, buffer, buffer
  %input_global = buffer.assume.memory_space<global> %input_noalias : buffer
  %gate_weight_global = buffer.assume.memory_space<global> %gate_weight_noalias : buffer
  %up_weight_global = buffer.assume.memory_space<global> %up_weight_noalias : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  %input_aligned = buffer.assume.alignment %input_global {minimum_alignment = 16} : buffer
  %gate_weight_aligned = buffer.assume.alignment %gate_weight_global {minimum_alignment = 16} : buffer
  %up_weight_aligned = buffer.assume.alignment %up_weight_global {minimum_alignment = 16} : buffer
  %output_aligned = buffer.assume.alignment %output_global {minimum_alignment = 16} : buffer
  %input_view = buffer.view %input_aligned[%base] : buffer -> view<[%token_count]x[%input_size]xbf16, #dense>
  %gate_weight_view = buffer.view %gate_weight_aligned[%base] : buffer -> view<[%input_size]x[%intermediate_size]xbf16, %weight_layout>
  %up_weight_view = buffer.view %up_weight_aligned[%base] : buffer -> view<[%input_size]x[%intermediate_size]xbf16, %weight_layout>
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<[%token_count]x[%intermediate_size]xbf16, #dense>
  %init0 = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>
  %init1 = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>
  %init2 = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>
  %init3 = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>
  %gate0, %gate1, %up0, %up1 = scf.for %k_tile = [%zero to %k_tile_count step %one](%acc0 = %init0 : vector<8xf32>, %acc1 = %init1 : vector<8xf32>, %acc2 = %init2 : vector<8xf32>, %acc3 = %init3 : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
    %k_origin = index.mul %k_tile, %sixteen : index
    %lhs = vector.fragment.load<lhs> %input_view[%token_origin, %k_origin] shape [%m, %k] : view<[%token_count]x[%input_size]xbf16, #dense> -> vector<16xbf16>
    %gate_rhs0 = vector.fragment.load<rhs> %gate_weight_view[%k_origin, %row_origin0] shape [%k, %n] : view<[%input_size]x[%intermediate_size]xbf16, %weight_layout> -> vector<16xbf16>
    %gate_rhs1 = vector.fragment.load<rhs> %gate_weight_view[%k_origin, %row_origin1] shape [%k, %n] : view<[%input_size]x[%intermediate_size]xbf16, %weight_layout> -> vector<16xbf16>
    %up_rhs0 = vector.fragment.load<rhs> %up_weight_view[%k_origin, %row_origin0] shape [%k, %n] : view<[%input_size]x[%intermediate_size]xbf16, %weight_layout> -> vector<16xbf16>
    %up_rhs1 = vector.fragment.load<rhs> %up_weight_view[%k_origin, %row_origin1] shape [%k, %n] : view<[%input_size]x[%intermediate_size]xbf16, %weight_layout> -> vector<16xbf16>
    %next0 = vector.mma %lhs, %gate_rhs0, %acc0 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %next1 = vector.mma %lhs, %gate_rhs1, %acc1 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %next2 = vector.mma %lhs, %up_rhs0, %acc2 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %next3 = vector.mma %lhs, %up_rhs1, %acc3 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    scf.yield %next0, %next1, %next2, %next3 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }
  %gate0_bf16 = vector.fptrunc %gate0 : vector<8xf32> to vector<8xbf16>
  %gate1_bf16 = vector.fptrunc %gate1 : vector<8xf32> to vector<8xbf16>
  %gate0_rounded = vector.extf %gate0_bf16 : vector<8xbf16> to vector<8xf32>
  %gate1_rounded = vector.extf %gate1_bf16 : vector<8xbf16> to vector<8xf32>
  %up0_bf16 = vector.fptrunc %up0 : vector<8xf32> to vector<8xbf16>
  %up1_bf16 = vector.fptrunc %up1 : vector<8xf32> to vector<8xbf16>
  %up0_rounded = vector.extf %up0_bf16 : vector<8xbf16> to vector<8xf32>
  %up1_rounded = vector.extf %up1_bf16 : vector<8xbf16> to vector<8xf32>
  %gate0_silu = vector.siluf %gate0_rounded : vector<8xf32>
  %gate1_silu = vector.siluf %gate1_rounded : vector<8xf32>
  %gate0_silu_bf16 = vector.fptrunc %gate0_silu : vector<8xf32> to vector<8xbf16>
  %gate1_silu_bf16 = vector.fptrunc %gate1_silu : vector<8xf32> to vector<8xbf16>
  %gate0_silu_rounded = vector.extf %gate0_silu_bf16 : vector<8xbf16> to vector<8xf32>
  %gate1_silu_rounded = vector.extf %gate1_silu_bf16 : vector<8xbf16> to vector<8xf32>
  %product0 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %gate0_silu_rounded, %up0_rounded : vector<8xf32>
  %product1 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %gate1_silu_rounded, %up1_rounded : vector<8xf32>
  vector.fragment.store<result> %product0, %output_view[%token_origin, %row_origin0] shape [%m, %n] : vector<8xf32>, view<[%token_count]x[%intermediate_size]xbf16, #dense>
  vector.fragment.store<result> %product1, %output_view[%token_origin, %row_origin1] shape [%m, %n] : vector<8xf32>, view<[%token_count]x[%intermediate_size]xbf16, #dense>
  kernel.return
}

