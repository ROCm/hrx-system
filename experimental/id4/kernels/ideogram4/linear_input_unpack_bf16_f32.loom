config.decl @id4.ideogram4.linear_input_unpack.token_count : %value: index where [range(%value, 1, 131072)]

config.decl @id4.ideogram4.linear_input_unpack.token_capacity : %value: index where [range(%value, 1, 131072)]

config.decl @id4.ideogram4.linear_input_unpack.input_size : %value: index where [range(%value, 1, 131072)]

config.decl @id4.ideogram4.linear_input_unpack.element_count : %value: index where [range(%value, 1, 268435456)]

kernel.def export("id4_ideogram4_linear_input_unpack_bf16_f32") @id4_ideogram4_linear_input_unpack_bf16_f32() {
  %unit = index.constant 1 : index
  %workgroup_size_x = index.constant 256 : index
  %element_count = config.get @id4.ideogram4.linear_input_unpack.element_count : index
  %rounding = index.constant 255 : index
  %rounded = index.add %element_count, %rounding : index
  %workgroups_x = index.div %rounded, %workgroup_size_x : index
  kernel.launch.config workgroups(%workgroups_x, %unit, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%packed_input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %workgroup = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %workgroup_size_x = index.constant 256 : index
  %token_count = config.get @id4.ideogram4.linear_input_unpack.token_count : index
  %token_capacity = config.get @id4.ideogram4.linear_input_unpack.token_capacity : index
  %input_size = config.get @id4.ideogram4.linear_input_unpack.input_size : index
  %element_count = config.get @id4.ideogram4.linear_input_unpack.element_count : index
  %element_index = index.madd %workgroup, %workgroup_size_x, %lane : index
  %in_bounds = index.cmp ult, %element_index, %element_count : index
  %packed_input_noalias, %output_noalias = buffer.assume.noalias %packed_input, %output : buffer, buffer
  %packed_input_global = buffer.assume.memory_space<global> %packed_input_noalias : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  %packed_input_view = buffer.view %packed_input_global[%base] : buffer -> view<[%token_capacity]x[%input_size]xbf16, #dense>
  %output_view = buffer.view %output_global[%base] : buffer -> view<[%input_size]x[%token_count]xf32, #dense>
  scf.if %in_bounds {
    %input_row = index.div %element_index, %token_count : index
    %token = index.rem %element_index, %token_count : index
    %loaded_bf16 = view.load %packed_input_view[%token, %input_row] : view<[%token_capacity]x[%input_size]xbf16, #dense> -> bf16
    %loaded = scalar.extf %loaded_bf16 : bf16 to f32
    view.store %loaded, %output_view[%input_row, %token] : f32, view<[%input_size]x[%token_count]xf32, #dense>
  }
  kernel.return
}

