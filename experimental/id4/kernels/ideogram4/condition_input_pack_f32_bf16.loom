config.decl @id4.ideogram4.condition_input_pack.text_token_count : %value: index where [range(%value, 1, 65536)]
config.decl @id4.ideogram4.condition_input_pack.padded_token_count : %value: index where [range(%value, 16, 65536), mul(%value, 16)]
config.decl @id4.ideogram4.condition_input_pack.feature_count : %value: index where [range(%value, 1, 131072)]
config.decl @id4.ideogram4.condition_input_pack.element_count : %value: index where [range(%value, 1, 268435456)]

kernel.def export("id4_ideogram4_condition_input_pack_f32_bf16") @id4_ideogram4_condition_input_pack_f32_bf16() {
  %unit = index.constant 1 : index
  %workgroup_size_x = index.constant 256 : index
  %element_count = config.get @id4.ideogram4.condition_input_pack.element_count : index
  %rounding = index.constant 255 : index
  %rounded = index.add %element_count, %rounding : index
  %workgroups_x = index.div %rounded, %workgroup_size_x : index
  kernel.launch.config workgroups(%workgroups_x, %unit, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%input: buffer, %packed_output: buffer) {
  %base = index.constant 0 : offset
  %zero_f32 = scalar.constant 0.0 : f32
  %workgroup = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %workgroup_size_x = index.constant 256 : index
  %text_token_count = config.get @id4.ideogram4.condition_input_pack.text_token_count : index
  %padded_token_count = config.get @id4.ideogram4.condition_input_pack.padded_token_count : index
  %feature_count = config.get @id4.ideogram4.condition_input_pack.feature_count : index
  %element_count = config.get @id4.ideogram4.condition_input_pack.element_count : index
  %element_index = index.madd %workgroup, %workgroup_size_x, %lane : index
  %in_bounds = index.cmp ult, %element_index, %element_count : index

  %input_noalias, %packed_output_noalias = buffer.assume.noalias %input, %packed_output : buffer, buffer
  %input_global = buffer.assume.memory_space<global> %input_noalias : buffer
  %packed_output_global = buffer.assume.memory_space<global> %packed_output_noalias : buffer
  %input_view = buffer.view %input_global[%base] : buffer -> view<[%feature_count]x[%text_token_count]xf32, #dense>
  %packed_output_view = buffer.view %packed_output_global[%base] : buffer -> view<[%padded_token_count]x[%feature_count]xbf16, #dense>

  scf.if %in_bounds {
    %token = index.div %element_index, %feature_count : index
    %feature = index.rem %element_index, %feature_count : index
    %token_valid = index.cmp ult, %token, %text_token_count : index
    %value = scf.if %token_valid -> (f32) {
      %loaded = view.load %input_view[%feature, %token] : view<[%feature_count]x[%text_token_count]xf32, #dense> -> f32
      scf.yield %loaded : f32
    } else {
      scf.yield %zero_f32 : f32
    }
    %rounded = scalar.fptrunc %value : f32 to bf16
    view.store %rounded, %packed_output_view[%token, %feature] : bf16, view<[%padded_token_count]x[%feature_count]xbf16, #dense>
  }
  kernel.return
}
