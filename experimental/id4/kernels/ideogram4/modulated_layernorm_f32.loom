config.decl @id4.ideogram4.modulated_layernorm.token_count : %value: index where [range(%value, 1, 131072)]
config.decl @id4.ideogram4.modulated_layernorm.hidden_size : %value: index where [range(%value, 1, 65536)]

kernel.def export("id4_ideogram4_modulated_layernorm_f32") @id4_ideogram4_modulated_layernorm_f32() {
  %unit = index.constant 1 : index
  %workgroup_size_x = index.constant 256 : index
  %token_count = config.get @id4.ideogram4.modulated_layernorm.token_count : index
  kernel.launch.config workgroups(%token_count, %unit, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%input: buffer, %scale: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %workgroup_size_x = index.constant 256 : index
  %token = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %token_count = config.get @id4.ideogram4.modulated_layernorm.token_count : index
  %hidden_size = config.get @id4.ideogram4.modulated_layernorm.hidden_size : index
  %zero_f32 = scalar.constant 0.0 : f32
  %one_f32 = scalar.constant 1.0 : f32
  %epsilon = scalar.constant 0.000001 : f32
  %hidden_size_i32 = index.cast %hidden_size : index to i32
  %hidden_size_f32 = scalar.sitofp %hidden_size_i32 : i32 to f32

  %input_noalias, %scale_noalias, %output_noalias = buffer.assume.noalias %input, %scale, %output : buffer, buffer, buffer
  %input_global = buffer.assume.memory_space<global> %input_noalias : buffer
  %scale_global = buffer.assume.memory_space<global> %scale_noalias : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  %input_view = buffer.view %input_global[%base] : buffer -> view<[%hidden_size]x[%token_count]xf32, #dense>
  %scale_view = buffer.view %scale_global[%base] : buffer -> view<[%hidden_size]xf32, #dense>
  %output_view = buffer.view %output_global[%base] : buffer -> view<[%hidden_size]x[%token_count]xf32, #dense>

  %lane_sum = scf.for %hidden = [%lane to %hidden_size step %workgroup_size_x](%acc = %zero_f32 : f32) -> (f32) {
    %value = view.load %input_view[%hidden, %token] : view<[%hidden_size]x[%token_count]xf32, #dense> -> f32
    %next = scalar.addf<reassoc|nnan|ninf|nsz> %acc, %value : f32
    scf.yield %next : f32
  }
  %sum = kernel.workgroup.reduce<addf> %lane_sum : f32
  %mean = scalar.divf<nnan|ninf|nsz|arcp> %sum, %hidden_size_f32 : f32

  %lane_square_sum = scf.for %hidden = [%lane to %hidden_size step %workgroup_size_x](%acc = %zero_f32 : f32) -> (f32) {
    %value = view.load %input_view[%hidden, %token] : view<[%hidden_size]x[%token_count]xf32, #dense> -> f32
    %delta = scalar.subf<reassoc|nnan|ninf|nsz> %value, %mean : f32
    %square = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %delta, %delta : f32
    %next = scalar.addf<reassoc|nnan|ninf|nsz> %acc, %square : f32
    scf.yield %next : f32
  }
  %square_sum = kernel.workgroup.reduce<addf> %lane_square_sum : f32
  %variance = scalar.divf<nnan|ninf|nsz|arcp> %square_sum, %hidden_size_f32 : f32
  %variance_epsilon = scalar.addf<nnan|ninf|nsz> %variance, %epsilon : f32
  %row_scale = scalar.rsqrtf<nnan|ninf|nsz|afn> %variance_epsilon : f32

  scf.for %hidden = [%lane to %hidden_size step %workgroup_size_x] {
    %value = view.load %input_view[%hidden, %token] : view<[%hidden_size]x[%token_count]xf32, #dense> -> f32
    %scale_value = view.load %scale_view[%hidden] : view<[%hidden_size]xf32, #dense> -> f32
    %delta = scalar.subf<reassoc|nnan|ninf|nsz> %value, %mean : f32
    %normalized = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %delta, %row_scale : f32
    %modulation = scalar.addf<reassoc|nnan|ninf|nsz> %one_f32, %scale_value : f32
    %output_value = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %normalized, %modulation : f32
    view.store %output_value, %output_view[%hidden, %token] : f32, view<[%hidden_size]x[%token_count]xf32, #dense>
  }
  kernel.return
}
