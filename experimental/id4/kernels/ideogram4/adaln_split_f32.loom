  %scale_mlp = check.generate.fill value(1.0) : tensor<4608xf32>
  %gate_mlp = check.generate.fill value(1.0) : tensor<4608xf32>
  %expected = check.generate.fill value(0.0) : tensor<4608xf32>
  func.call @id4_ideogram4_adaln_split_f32(%raw_modulation, %scale_msa, %gate_msa, %scale_mlp, %gate_mlp) : (tensor<4x4608xf32>, tensor<4608xf32>, tensor<4608xf32>, tensor<4608xf32>, tensor<4608xf32>)
  check.expect.close actual(%scale_msa) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<4608xf32>
  check.expect.close actual(%gate_msa) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<4608xf32>
  check.expect.close actual(%scale_mlp) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<4608xf32>
  check.expect.close actual(%gate_mlp) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<4608xf32>
  check.return
}

