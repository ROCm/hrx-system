amdgpu.target<gfx1100> @id4_gfx1100

config.decl @id4.ideogram4.linear_bias_bf16_wmma.token_count : %value: index where [range(%value, 32, 131072), mul(%value, 32)]

config.decl @id4.ideogram4.linear_bias_bf16_wmma.input_size : %value: index where [range(%value, 16, 131072), mul(%value, 16)]

config.decl @id4.ideogram4.linear_bias_bf16_wmma.output_size : %value: index where [range(%value, 64, 131072), mul(%value, 64)]

kernel.def target(@id4_gfx1100) export("id4_ideogram4_linear_bias_bf16_bf16_wmma") @id4_ideogram4_linear_bias_bf16_bf16_wmma() {
  %unit = index.constant 1 : index
  %thirty_two = index.constant 32 : index
  %sixty_four = index.constant 64 : index
  %workgroup_size_x = index.constant 32 : index
  %token_count = config.get @id4.ideogram4.linear_bias_bf16_wmma.token_count : index
  %output_size = config.get @id4.ideogram4.linear_bias_bf16_wmma.output_size : index
  %token_tile_count = index.div %token_count, %thirty_two : index
  %output_tile_count = index.div %output_size, %sixty_four : index
  kernel.launch.config workgroups(%token_tile_count, %output_tile_count, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%input: buffer, %weight: buffer, %bias: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %unit = index.constant 1 : index
  %two = index.constant 2 : index
  %eight = index.constant 8 : index
  %sixteen = index.constant 16 : index
  %thirty_two = index.constant 32 : index
  %sixty_four = index.constant 64 : index
  %token_tile = kernel.workgroup.id<x> : index
  %output_tile = kernel.workgroup.id<y> : index
  %lane = kernel.workitem.id<x> : index
  %token_count = config.get @id4.ideogram4.linear_bias_bf16_wmma.token_count : index
  %input_size = config.get @id4.ideogram4.linear_bias_bf16_wmma.input_size : index
  %output_size = config.get @id4.ideogram4.linear_bias_bf16_wmma.output_size : index
  %k_tile_count = index.div %input_size, %sixteen : index
  %token_origin0 = index.mul %token_tile, %thirty_two : index
  %token_origin1 = index.add %token_origin0, %sixteen : index
  %output_origin0 = index.mul %output_tile, %sixty_four : index
  %output_origin1 = index.add %output_origin0, %sixteen : index
  %output_origin2 = index.add %output_origin1, %sixteen : index
  %output_origin3 = index.add %output_origin2, %sixteen : index
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %weight_layout = encoding.layout.strided [1, %input_size] : encoding<layout>
  %zero_acc = vector.constant 0.0 : vector<8xf32>
  %input_noalias, %weight_noalias, %bias_noalias, %output_noalias = buffer.assume.noalias %input, %weight, %bias, %output : buffer, buffer, buffer, buffer
  %input_global = buffer.assume.memory_space<global> %input_noalias : buffer
  %weight_global = buffer.assume.memory_space<global> %weight_noalias : buffer
  %bias_global = buffer.assume.memory_space<global> %bias_noalias : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  %input_aligned = buffer.assume.alignment %input_global {minimum_alignment = 16} : buffer
  %weight_aligned = buffer.assume.alignment %weight_global {minimum_alignment = 16} : buffer
  %bias_aligned = buffer.assume.alignment %bias_global {minimum_alignment = 16} : buffer
  %output_aligned = buffer.assume.alignment %output_global {minimum_alignment = 16} : buffer
  %input_view = buffer.view %input_aligned[%base] : buffer -> view<[%token_count]x[%input_size]xbf16, #dense>
  %weight_view = buffer.view %weight_aligned[%base] : buffer -> view<[%input_size]x[%output_size]xbf16, %weight_layout>
  %bias_view = buffer.view %bias_aligned[%base] : buffer -> view<[%output_size]xbf16, #dense>
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<[%token_count]x[%output_size]xbf16, #dense>
  %init00 = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>
  %init01 = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>
  %init02 = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>
  %init03 = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>
  %init10 = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>
  %init11 = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>
  %init12 = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>
  %init13 = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>
  %result00, %result01, %result02, %result03, %result10, %result11, %result12, %result13 = scf.for %k_tile = [%zero to %k_tile_count step %unit](%acc00 = %init00 : vector<8xf32>, %acc01 = %init01 : vector<8xf32>, %acc02 = %init02 : vector<8xf32>, %acc03 = %init03 : vector<8xf32>, %acc10 = %init10 : vector<8xf32>, %acc11 = %init11 : vector<8xf32>, %acc12 = %init12 : vector<8xf32>, %acc13 = %init13 : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
    %k_origin = index.mul %k_tile, %sixteen : index
    %lhs0 = vector.fragment.load<lhs> %input_view[%token_origin0, %k_origin] shape [%m, %k] : view<[%token_count]x[%input_size]xbf16, #dense> -> vector<16xbf16>
    %lhs1 = vector.fragment.load<lhs> %input_view[%token_origin1, %k_origin] shape [%m, %k] : view<[%token_count]x[%input_size]xbf16, #dense> -> vector<16xbf16>
    %rhs0 = vector.fragment.load<rhs> %weight_view[%k_origin, %output_origin0] shape [%k, %n] : view<[%input_size]x[%output_size]xbf16, %weight_layout> -> vector<16xbf16>
    %rhs1 = vector.fragment.load<rhs> %weight_view[%k_origin, %output_origin1] shape [%k, %n] : view<[%input_size]x[%output_size]xbf16, %weight_layout> -> vector<16xbf16>
    %rhs2 = vector.fragment.load<rhs> %weight_view[%k_origin, %output_origin2] shape [%k, %n] : view<[%input_size]x[%output_size]xbf16, %weight_layout> -> vector<16xbf16>
    %rhs3 = vector.fragment.load<rhs> %weight_view[%k_origin, %output_origin3] shape [%k, %n] : view<[%input_size]x[%output_size]xbf16, %weight_layout> -> vector<16xbf16>
    %next00 = vector.mma %lhs0, %rhs0, %acc00 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %next01 = vector.mma %lhs0, %rhs1, %acc01 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %next02 = vector.mma %lhs0, %rhs2, %acc02 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %next03 = vector.mma %lhs0, %rhs3, %acc03 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %next10 = vector.mma %lhs1, %rhs0, %acc10 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %next11 = vector.mma %lhs1, %rhs1, %acc11 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %next12 = vector.mma %lhs1, %rhs2, %acc12 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %next13 = vector.mma %lhs1, %rhs3, %acc13 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    scf.yield %next00, %next01, %next02, %next03, %next10, %next11, %next12, %next13 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }
  %lane_column = index.rem %lane, %sixteen : index
  %lane_group = index.div %lane, %sixteen : index
  %column0 = index.add %output_origin0, %lane_column : index
  %column1 = index.add %output_origin1, %lane_column : index
  %column2 = index.add %output_origin2, %lane_column : index
  %column3 = index.add %output_origin3, %lane_column : index
  %bias0_bf16 = view.load %bias_view[%column0] : view<[%output_size]xbf16, #dense> -> bf16
  %bias1_bf16 = view.load %bias_view[%column1] : view<[%output_size]xbf16, #dense> -> bf16
  %bias2_bf16 = view.load %bias_view[%column2] : view<[%output_size]xbf16, #dense> -> bf16
  %bias3_bf16 = view.load %bias_view[%column3] : view<[%output_size]xbf16, #dense> -> bf16
  %bias0 = scalar.extf %bias0_bf16 : bf16 to f32
  %bias1 = scalar.extf %bias1_bf16 : bf16 to f32
  %bias2 = scalar.extf %bias2_bf16 : bf16 to f32
  %bias3 = scalar.extf %bias3_bf16 : bf16 to f32
  scf.for %register_index = [%zero to %eight step %unit] {
    %register_token_base = index.mul %register_index, %two : index
    %local_token = index.add %register_token_base, %lane_group : index
    %token0 = index.add %token_origin0, %local_token : index
    %token1 = index.add %token_origin1, %local_token : index
    %value00 = vector.extract %result00[%register_index] : vector<8xf32> -> f32
    %biased00 = scalar.addf<reassoc|nnan|ninf|nsz> %value00, %bias0 : f32
    %rounded00 = scalar.fptrunc %biased00 : f32 to bf16
    view.store %rounded00, %output_view[%token0, %column0] : bf16, view<[%token_count]x[%output_size]xbf16, #dense>
    %value01 = vector.extract %result01[%register_index] : vector<8xf32> -> f32
    %biased01 = scalar.addf<reassoc|nnan|ninf|nsz> %value01, %bias1 : f32
    %rounded01 = scalar.fptrunc %biased01 : f32 to bf16
    view.store %rounded01, %output_view[%token0, %column1] : bf16, view<[%token_count]x[%output_size]xbf16, #dense>
    %value02 = vector.extract %result02[%register_index] : vector<8xf32> -> f32
    %biased02 = scalar.addf<reassoc|nnan|ninf|nsz> %value02, %bias2 : f32
    %rounded02 = scalar.fptrunc %biased02 : f32 to bf16
    view.store %rounded02, %output_view[%token0, %column2] : bf16, view<[%token_count]x[%output_size]xbf16, #dense>
    %value03 = vector.extract %result03[%register_index] : vector<8xf32> -> f32
    %biased03 = scalar.addf<reassoc|nnan|ninf|nsz> %value03, %bias3 : f32
    %rounded03 = scalar.fptrunc %biased03 : f32 to bf16
    view.store %rounded03, %output_view[%token0, %column3] : bf16, view<[%token_count]x[%output_size]xbf16, #dense>
    %value10 = vector.extract %result10[%register_index] : vector<8xf32> -> f32
    %biased10 = scalar.addf<reassoc|nnan|ninf|nsz> %value10, %bias0 : f32
    %rounded10 = scalar.fptrunc %biased10 : f32 to bf16
    view.store %rounded10, %output_view[%token1, %column0] : bf16, view<[%token_count]x[%output_size]xbf16, #dense>
    %value11 = vector.extract %result11[%register_index] : vector<8xf32> -> f32
    %biased11 = scalar.addf<reassoc|nnan|ninf|nsz> %value11, %bias1 : f32
    %rounded11 = scalar.fptrunc %biased11 : f32 to bf16
    view.store %rounded11, %output_view[%token1, %column1] : bf16, view<[%token_count]x[%output_size]xbf16, #dense>
    %value12 = vector.extract %result12[%register_index] : vector<8xf32> -> f32
    %biased12 = scalar.addf<reassoc|nnan|ninf|nsz> %value12, %bias2 : f32
    %rounded12 = scalar.fptrunc %biased12 : f32 to bf16
    view.store %rounded12, %output_view[%token1, %column2] : bf16, view<[%token_count]x[%output_size]xbf16, #dense>
    %value13 = vector.extract %result13[%register_index] : vector<8xf32> -> f32
    %biased13 = scalar.addf<reassoc|nnan|ninf|nsz> %value13, %bias3 : f32
    %rounded13 = scalar.fptrunc %biased13 : f32 to bf16
    view.store %rounded13, %output_view[%token1, %column3] : bf16, view<[%token_count]x[%output_size]xbf16, #dense>
  }
  kernel.return
}

check.case public @id4_ideogram4_linear_bias_bf16_bf16_wmma_small_case {
  %input = check.generate.fill value(1.0) : tensor<32x16xbf16>
  %weight = check.generate.fill value(1.0) : tensor<64x16xbf16>
  %bias = check.generate.fill value(1.0) : tensor<64xbf16>
  %output = check.generate.fill value(0.0) : tensor<32x64xbf16>
  %expected = check.generate.fill value(17.0) : tensor<32x64xbf16>
  func.call @id4_ideogram4_linear_bias_bf16_bf16_wmma(%input, %weight, %bias, %output) : (tensor<32x16xbf16>, tensor<64x16xbf16>, tensor<64xbf16>, tensor<32x64xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<32x64xbf16>
  check.return
}

check.case public @id4_ideogram4_linear_bias_bf16_bf16_wmma_ideogram_shape_case {
  %input = check.generate.fill value(1.0) : tensor<4096x4608xbf16>
