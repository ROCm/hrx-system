  %output = check.generate.fill value(0.0) : tensor<32x16xf32>
  %expected = check.file.read.npy path("testdata/ideogram4_linear_bf16_f32_wmma_layout_expected.npy") : tensor<32x16xf32>
  func.call @id4_ideogram4_linear_bf16_f32_wmma(%input, %weight, %output) : (tensor<16x16xbf16>, tensor<32x16xbf16>, tensor<32x16xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.001) rtol(0.001) nan(same) : tensor<32x16xf32>
  check.return
}

