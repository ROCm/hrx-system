amdgpu.target<gfx1100> @id4_gfx1100

config.decl @id4.ideogram4.mlp_up_silu_product_wmma.token_count : %value: index where [range(%value, 16, 131072)]

config.decl @id4.ideogram4.mlp_up_silu_product_wmma.dispatch_token_count : %value: index where [range(%value, 32, 131072), mul(%value, 32)]

config.decl @id4.ideogram4.mlp_up_silu_product_wmma.input_size : %value: index where [range(%value, 16, 131072), mul(%value, 16)]

config.decl @id4.ideogram4.mlp_up_silu_product_wmma.intermediate_size : %value: index where [range(%value, 32, 65536), mul(%value, 32)]

kernel.def target(@id4_gfx1100) export("id4_ideogram4_mlp_up_silu_product_bf16_wmma") @id4_ideogram4_mlp_up_silu_product_bf16_wmma() {
  %unit = index.constant 1 : index
  %sixteen = index.constant 16 : index
  %thirty_two = index.constant 32 : index
  %workgroup_size_x = index.constant 32 : index
  %dispatch_token_count = config.get @id4.ideogram4.mlp_up_silu_product_wmma.dispatch_token_count : index
  %intermediate_size = config.get @id4.ideogram4.mlp_up_silu_product_wmma.intermediate_size : index
  %token_tile_count = index.div %dispatch_token_count, %thirty_two : index
  %row_tile_count = index.div %intermediate_size, %thirty_two : index
  kernel.launch.config workgroups(%token_tile_count, %row_tile_count, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%input_bf16: buffer, %up_weight: buffer, %gate: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %eight = index.constant 8 : index
  %sixteen = index.constant 16 : index
  %thirty_two = index.constant 32 : index
  %token_pair = kernel.workgroup.id<x> : index
  %row_pair = kernel.workgroup.id<y> : index
  %lane = kernel.workitem.id<x> : index
  %token_count = config.get @id4.ideogram4.mlp_up_silu_product_wmma.token_count : index
  %input_size = config.get @id4.ideogram4.mlp_up_silu_product_wmma.input_size : index
  %intermediate_size = config.get @id4.ideogram4.mlp_up_silu_product_wmma.intermediate_size : index
  %k_tile_count = index.div %input_size, %sixteen : index
  %token_origin0 = index.mul %token_pair, %thirty_two : index
  %token_origin1 = index.add %token_origin0, %sixteen : index
  %row_origin0 = index.mul %row_pair, %thirty_two : index
  %row_origin1 = index.add %row_origin0, %sixteen : index
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %weight_layout = encoding.layout.strided [1, %input_size] : encoding<layout>
  %zero_acc = vector.constant 0.0 : vector<8xf32>
  %input_noalias, %up_weight_noalias, %gate_noalias, %output_noalias = buffer.assume.noalias %input_bf16, %up_weight, %gate, %output : buffer, buffer, buffer, buffer
  %input_global = buffer.assume.memory_space<global> %input_noalias : buffer
  %up_weight_global = buffer.assume.memory_space<global> %up_weight_noalias : buffer
  %gate_global = buffer.assume.memory_space<global> %gate_noalias : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  %input_aligned = buffer.assume.alignment %input_global {minimum_alignment = 16} : buffer
  %up_weight_aligned = buffer.assume.alignment %up_weight_global {minimum_alignment = 16} : buffer
  %gate_aligned = buffer.assume.alignment %gate_global {minimum_alignment = 16} : buffer
  %output_aligned = buffer.assume.alignment %output_global {minimum_alignment = 16} : buffer
  %input_view = buffer.view %input_aligned[%base] : buffer -> view<[%token_count]x[%input_size]xbf16, #dense>
  %up_weight_view = buffer.view %up_weight_aligned[%base] : buffer -> view<[%input_size]x[%intermediate_size]xbf16, %weight_layout>
  %gate_view = buffer.view %gate_aligned[%base] : buffer -> view<[%token_count]x[%intermediate_size]xbf16, #dense>
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<[%token_count]x[%intermediate_size]xbf16, #dense>
  %init00 = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>
  %init01 = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>
  %init10 = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>
  %init11 = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>
  %up00, %up01, %up10, %up11 = scf.for %k_tile = [%zero to %k_tile_count step %one](%acc00 = %init00 : vector<8xf32>, %acc01 = %init01 : vector<8xf32>, %acc10 = %init10 : vector<8xf32>, %acc11 = %init11 : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
    %k_origin = index.mul %k_tile, %sixteen : index
    %lhs0 = vector.fragment.load<lhs> %input_view[%token_origin0, %k_origin] shape [%m, %k] : view<[%token_count]x[%input_size]xbf16, #dense> -> vector<16xbf16>
    %lhs1 = vector.fragment.load<lhs> %input_view[%token_origin1, %k_origin] shape [%m, %k] : view<[%token_count]x[%input_size]xbf16, #dense> -> vector<16xbf16>
    %rhs0 = vector.fragment.load<rhs> %up_weight_view[%k_origin, %row_origin0] shape [%k, %n] : view<[%input_size]x[%intermediate_size]xbf16, %weight_layout> -> vector<16xbf16>
    %rhs1 = vector.fragment.load<rhs> %up_weight_view[%k_origin, %row_origin1] shape [%k, %n] : view<[%input_size]x[%intermediate_size]xbf16, %weight_layout> -> vector<16xbf16>
    %next00 = vector.mma %lhs0, %rhs0, %acc00 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %next01 = vector.mma %lhs0, %rhs1, %acc01 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %next10 = vector.mma %lhs1, %rhs0, %acc10 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %next11 = vector.mma %lhs1, %rhs1, %acc11 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    scf.yield %next00, %next01, %next10, %next11 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }
  %lane_column = index.rem %lane, %sixteen : index
  %lane_group = index.div %lane, %sixteen : index
  %column0 = index.add %row_origin0, %lane_column : index
  %column1 = index.add %row_origin1, %lane_column : index
  scf.for %register_index = [%zero to %eight step %one] {
    %register_token_base = index.mul %register_index, %two : index
    %local_token = index.add %register_token_base, %lane_group : index
    %token0 = index.add %token_origin0, %local_token : index
    %token1 = index.add %token_origin1, %local_token : index
    %up_value00 = vector.extract %up00[%register_index] : vector<8xf32> -> f32
    %gate_bf16_value00 = view.load %gate_view[%token0, %column0] : view<[%token_count]x[%intermediate_size]xbf16, #dense> -> bf16
    %gate_value00 = scalar.extf %gate_bf16_value00 : bf16 to f32
    %gate_silu00 = scalar.siluf %gate_value00 : f32
    %gate_silu_bf16_00 = scalar.fptrunc %gate_silu00 : f32 to bf16
    %gate_silu_value00 = scalar.extf %gate_silu_bf16_00 : bf16 to f32
    %up_bf16_00 = scalar.fptrunc %up_value00 : f32 to bf16
    %up_rounded00 = scalar.extf %up_bf16_00 : bf16 to f32
    %value00 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %gate_silu_value00, %up_rounded00 : f32
    %rounded00 = scalar.fptrunc %value00 : f32 to bf16
    view.store %rounded00, %output_view[%token0, %column0] : bf16, view<[%token_count]x[%intermediate_size]xbf16, #dense>
    %up_value01 = vector.extract %up01[%register_index] : vector<8xf32> -> f32
    %gate_bf16_value01 = view.load %gate_view[%token0, %column1] : view<[%token_count]x[%intermediate_size]xbf16, #dense> -> bf16
    %gate_value01 = scalar.extf %gate_bf16_value01 : bf16 to f32
    %gate_silu01 = scalar.siluf %gate_value01 : f32
    %gate_silu_bf16_01 = scalar.fptrunc %gate_silu01 : f32 to bf16
    %gate_silu_value01 = scalar.extf %gate_silu_bf16_01 : bf16 to f32
    %up_bf16_01 = scalar.fptrunc %up_value01 : f32 to bf16
    %up_rounded01 = scalar.extf %up_bf16_01 : bf16 to f32
    %value01 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %gate_silu_value01, %up_rounded01 : f32
    %rounded01 = scalar.fptrunc %value01 : f32 to bf16
    view.store %rounded01, %output_view[%token0, %column1] : bf16, view<[%token_count]x[%intermediate_size]xbf16, #dense>
    %up_value10 = vector.extract %up10[%register_index] : vector<8xf32> -> f32
    %gate_bf16_value10 = view.load %gate_view[%token1, %column0] : view<[%token_count]x[%intermediate_size]xbf16, #dense> -> bf16
    %gate_value10 = scalar.extf %gate_bf16_value10 : bf16 to f32
    %gate_silu10 = scalar.siluf %gate_value10 : f32
    %gate_silu_bf16_10 = scalar.fptrunc %gate_silu10 : f32 to bf16
    %gate_silu_value10 = scalar.extf %gate_silu_bf16_10 : bf16 to f32
    %up_bf16_10 = scalar.fptrunc %up_value10 : f32 to bf16
    %up_rounded10 = scalar.extf %up_bf16_10 : bf16 to f32
    %value10 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %gate_silu_value10, %up_rounded10 : f32
    %rounded10 = scalar.fptrunc %value10 : f32 to bf16
    view.store %rounded10, %output_view[%token1, %column0] : bf16, view<[%token_count]x[%intermediate_size]xbf16, #dense>
    %up_value11 = vector.extract %up11[%register_index] : vector<8xf32> -> f32
    %gate_bf16_value11 = view.load %gate_view[%token1, %column1] : view<[%token_count]x[%intermediate_size]xbf16, #dense> -> bf16
    %gate_value11 = scalar.extf %gate_bf16_value11 : bf16 to f32
    %gate_silu11 = scalar.siluf %gate_value11 : f32
    %gate_silu_bf16_11 = scalar.fptrunc %gate_silu11 : f32 to bf16
    %gate_silu_value11 = scalar.extf %gate_silu_bf16_11 : bf16 to f32
    %up_bf16_11 = scalar.fptrunc %up_value11 : f32 to bf16
    %up_rounded11 = scalar.extf %up_bf16_11 : bf16 to f32
    %value11 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %gate_silu_value11, %up_rounded11 : f32
    %rounded11 = scalar.fptrunc %value11 : f32 to bf16
    view.store %rounded11, %output_view[%token1, %column1] : bf16, view<[%token_count]x[%intermediate_size]xbf16, #dense>
  }
  kernel.return
}

check.case public @id4_ideogram4_mlp_up_silu_product_bf16_wmma_small_case {
  %input = check.generate.fill value(1.0) : tensor<32x16xbf16>
  %up_weight = check.generate.fill value(2.0) : tensor<16x32xbf16>
  %gate = check.generate.fill value(1.0) : tensor<32x32xbf16>
  %output = check.generate.fill value(0.0) : tensor<32x32xbf16>
  %expected = check.generate.fill value(23.393874516160157) : tensor<32x32xbf16>
  func.call @id4_ideogram4_mlp_up_silu_product_bf16_wmma(%input, %up_weight, %gate, %output) : (tensor<32x16xbf16>, tensor<16x32xbf16>, tensor<32x32xbf16>, tensor<32x32xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.20000000000000001) rtol(0.01) nan(same) : tensor<32x32xbf16>
  check.return
}

