amdgpu.target<gfx1100> @id4_gfx1100

config.decl @id4.ideogram4.mlp_up_silu_product_wmma.token_count : %value: index where [range(%value, 16, 131072)]
config.decl @id4.ideogram4.mlp_up_silu_product_wmma.dispatch_token_count : %value: index where [range(%value, 16, 131072), mul(%value, 16)]
config.decl @id4.ideogram4.mlp_up_silu_product_wmma.input_size : %value: index where [range(%value, 16, 131072), mul(%value, 16)]
config.decl @id4.ideogram4.mlp_up_silu_product_wmma.intermediate_size : %value: index where [range(%value, 32, 65536), mul(%value, 32)]

kernel.def target(@id4_gfx1100) export("id4_ideogram4_mlp_up_silu_product_bf16_wmma") @id4_ideogram4_mlp_up_silu_product_bf16_wmma() {
  %unit = index.constant 1 : index
  %sixteen = index.constant 16 : index
  %thirty_two = index.constant 32 : index
  %workgroup_size_x = index.constant 32 : index
  %dispatch_token_count = config.get @id4.ideogram4.mlp_up_silu_product_wmma.dispatch_token_count : index
  %intermediate_size = config.get @id4.ideogram4.mlp_up_silu_product_wmma.intermediate_size : index
  %token_tile_count = index.div %dispatch_token_count, %sixteen : index
  %row_tile_count = index.div %intermediate_size, %thirty_two : index
  kernel.launch.config workgroups(%token_tile_count, %row_tile_count, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%input_bf16: buffer, %up_weight: buffer, %gate: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %eight = index.constant 8 : index
  %sixteen = index.constant 16 : index
  %thirty_two = index.constant 32 : index
  %token_tile = kernel.workgroup.id<x> : index
  %row_pair = kernel.workgroup.id<y> : index
  %lane = kernel.workitem.id<x> : index
  %token_count = config.get @id4.ideogram4.mlp_up_silu_product_wmma.token_count : index
  %input_size = config.get @id4.ideogram4.mlp_up_silu_product_wmma.input_size : index
  %intermediate_size = config.get @id4.ideogram4.mlp_up_silu_product_wmma.intermediate_size : index
  %k_tile_count = index.div %input_size, %sixteen : index
  %token_origin = index.mul %token_tile, %sixteen : index
  %row_origin0 = index.mul %row_pair, %thirty_two : index
  %row_origin1 = index.add %row_origin0, %sixteen : index
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %weight_layout = encoding.layout.strided [1, %input_size] : encoding<layout>
  %zero_acc = vector.constant 0.0 : vector<8xf32>

  %input_noalias, %up_weight_noalias, %gate_noalias, %output_noalias = buffer.assume.noalias %input_bf16, %up_weight, %gate, %output : buffer, buffer, buffer, buffer
  %input_global = buffer.assume.memory_space<global> %input_noalias : buffer
  %up_weight_global = buffer.assume.memory_space<global> %up_weight_noalias : buffer
  %gate_global = buffer.assume.memory_space<global> %gate_noalias : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  %input_aligned = buffer.assume.alignment %input_global {minimum_alignment = 16} : buffer
  %up_weight_aligned = buffer.assume.alignment %up_weight_global {minimum_alignment = 16} : buffer
  %gate_aligned = buffer.assume.alignment %gate_global {minimum_alignment = 16} : buffer
  %output_aligned = buffer.assume.alignment %output_global {minimum_alignment = 16} : buffer
  %input_view = buffer.view %input_aligned[%base] : buffer -> view<[%token_count]x[%input_size]xbf16, #dense>
  %up_weight_view = buffer.view %up_weight_aligned[%base] : buffer -> view<[%input_size]x[%intermediate_size]xbf16, %weight_layout>
  %gate_view = buffer.view %gate_aligned[%base] : buffer -> view<[%token_count]x[%intermediate_size]xbf16, #dense>
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<[%token_count]x[%intermediate_size]xbf16, #dense>

  %init0 = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>
  %init1 = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>
  %up0, %up1 = scf.for %k_tile = [%zero to %k_tile_count step %one](%acc0 = %init0 : vector<8xf32>, %acc1 = %init1 : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>) {
    %k_origin = index.mul %k_tile, %sixteen : index
    %lhs = vector.fragment.load<lhs> %input_view[%token_origin, %k_origin] shape [%m, %k] : view<[%token_count]x[%input_size]xbf16, #dense> -> vector<16xbf16>
    %rhs0 = vector.fragment.load<rhs> %up_weight_view[%k_origin, %row_origin0] shape [%k, %n] : view<[%input_size]x[%intermediate_size]xbf16, %weight_layout> -> vector<16xbf16>
    %rhs1 = vector.fragment.load<rhs> %up_weight_view[%k_origin, %row_origin1] shape [%k, %n] : view<[%input_size]x[%intermediate_size]xbf16, %weight_layout> -> vector<16xbf16>
    %next0 = vector.mma %lhs, %rhs0, %acc0 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %next1 = vector.mma %lhs, %rhs1, %acc1 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    scf.yield %next0, %next1 : vector<8xf32>, vector<8xf32>
  }

  %lane_column = index.rem %lane, %sixteen : index
  %lane_group = index.div %lane, %sixteen : index
  %column0 = index.add %row_origin0, %lane_column : index
  %column1 = index.add %row_origin1, %lane_column : index
  scf.for %register_index = [%zero to %eight step %one] {
    %register_token_base = index.mul %register_index, %two : index
    %local_token = index.add %register_token_base, %lane_group : index
    %token = index.add %token_origin, %local_token : index

    %up_value0 = vector.extract %up0[%register_index] : vector<8xf32> -> f32
    %gate_bf16_value0 = view.load %gate_view[%token, %column0] : view<[%token_count]x[%intermediate_size]xbf16, #dense> -> bf16
    %gate_value0 = scalar.extf %gate_bf16_value0 : bf16 to f32
    %gate_silu0 = scalar.siluf %gate_value0 : f32
    %value0 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %gate_silu0, %up_value0 : f32
    %rounded0 = scalar.fptrunc %value0 : f32 to bf16
    view.store %rounded0, %output_view[%token, %column0] : bf16, view<[%token_count]x[%intermediate_size]xbf16, #dense>

    %up_value1 = vector.extract %up1[%register_index] : vector<8xf32> -> f32
    %gate_bf16_value1 = view.load %gate_view[%token, %column1] : view<[%token_count]x[%intermediate_size]xbf16, #dense> -> bf16
    %gate_value1 = scalar.extf %gate_bf16_value1 : bf16 to f32
    %gate_silu1 = scalar.siluf %gate_value1 : f32
    %value1 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %gate_silu1, %up_value1 : f32
    %rounded1 = scalar.fptrunc %value1 : f32 to bf16
    view.store %rounded1, %output_view[%token, %column1] : bf16, view<[%token_count]x[%intermediate_size]xbf16, #dense>
  }
  kernel.return
}

check.case public @id4_ideogram4_mlp_up_silu_product_bf16_wmma_small_case {
  %input = check.generate.fill value(1.0) : tensor<16x16xbf16>
  %up_weight = check.generate.fill value(2.0) : tensor<16x32xbf16>
  %gate = check.generate.fill value(1.0) : tensor<16x32xbf16>
  %output = check.generate.fill value(0.0) : tensor<16x32xbf16>
  %expected = check.generate.fill value(23.393874516160157) : tensor<16x32xbf16>
  func.call @id4_ideogram4_mlp_up_silu_product_bf16_wmma(%input, %up_weight, %gate, %output) : (tensor<16x16xbf16>, tensor<16x32xbf16>, tensor<16x32xbf16>, tensor<16x32xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.2) rtol(0.01) nan(same) : tensor<16x32xbf16>
  check.return
}

check.case public @id4_ideogram4_mlp_up_silu_product_bf16_wmma_uncond_1024_shape_case {
  %input = check.generate.fill value(1.0) : tensor<4096x4608xbf16>
  %up_weight = check.generate.fill value(0.0) : tensor<12288x4608xbf16>
  %gate = check.generate.fill value(1.0) : tensor<4096x12288xbf16>
  %output = check.generate.fill value(1.0) : tensor<4096x12288xbf16>
  %expected = check.generate.fill value(0.0) : tensor<4096x12288xbf16>
  func.call @id4_ideogram4_mlp_up_silu_product_bf16_wmma(%input, %up_weight, %gate, %output) : (tensor<4096x4608xbf16>, tensor<12288x4608xbf16>, tensor<4096x12288xbf16>, tensor<4096x12288xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<4096x12288xbf16>
  check.return
}

check.benchmark<@id4_ideogram4_mlp_up_silu_product_bf16_wmma_small_case> @id4_ideogram4_mlp_up_silu_product_bf16_wmma_small
check.benchmark<@id4_ideogram4_mlp_up_silu_product_bf16_wmma_uncond_1024_shape_case> @id4_ideogram4_mlp_up_silu_product_bf16_wmma_uncond_1024_shape
