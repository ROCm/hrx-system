config.decl @id4.ideogram4.condition_rmsnorm_pack.text_token_count : %value: index where [range(%value, 1, 65536)]

config.decl @id4.ideogram4.condition_rmsnorm_pack.padded_token_count : %value: index where [range(%value, 16, 65536), mul(%value, 16)]

config.decl @id4.ideogram4.condition_rmsnorm_pack.feature_count : %value: index where [range(%value, 1, 131072)]

config.decl @id4.ideogram4.condition_rmsnorm_pack.hidden_state_layer_count : %value: index where [range(%value, 1, 64)]

func.def inline @id4_ideogram4_condition_rmsnorm_pack_f32_bf16_source_feature(%feature: index, %feature_layer_size: index, %hidden_state_layer_count: index) -> (index) {
  %state_layer = index.rem %feature, %hidden_state_layer_count : index
  %state_channel = index.div %feature, %hidden_state_layer_count : index
  %source_layer_offset = index.mul %feature_layer_size, %state_layer : index
  %source_feature = index.add %source_layer_offset, %state_channel : index
  func.return %source_feature : index
}

kernel.def export("id4_ideogram4_condition_rmsnorm_pack_f32_bf16") @id4_ideogram4_condition_rmsnorm_pack_f32_bf16() {
  %unit = index.constant 1 : index
  %workgroup_size_x = index.constant 256 : index
  %padded_token_count = config.get @id4.ideogram4.condition_rmsnorm_pack.padded_token_count : index
  kernel.launch.config workgroups(%padded_token_count, %unit, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%input: buffer, %weight: buffer, %packed_output: buffer) {
  %base = index.constant 0 : offset
  %workgroup_size_x = index.constant 256 : index
  %token = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %text_token_count = config.get @id4.ideogram4.condition_rmsnorm_pack.text_token_count : index
  %padded_token_count = config.get @id4.ideogram4.condition_rmsnorm_pack.padded_token_count : index
  %feature_count = config.get @id4.ideogram4.condition_rmsnorm_pack.feature_count : index
  %hidden_state_layer_count = config.get @id4.ideogram4.condition_rmsnorm_pack.hidden_state_layer_count : index
  %feature_layer_size = index.div %feature_count, %hidden_state_layer_count : index
  %token_valid = index.cmp ult, %token, %text_token_count : index
  %zero_f32 = scalar.constant 0.0 : f32
  %zero_bf16 = scalar.constant 0.0 : bf16
  %epsilon = scalar.constant 9.9999999999999995e-07 : f32
  %feature_count_i32 = index.cast %feature_count : index to i32
  %feature_count_f32 = scalar.sitofp %feature_count_i32 : i32 to f32
  %input_noalias, %weight_noalias, %packed_output_noalias = buffer.assume.noalias %input, %weight, %packed_output : buffer, buffer, buffer
  %input_global = buffer.assume.memory_space<global> %input_noalias : buffer
  %weight_global = buffer.assume.memory_space<global> %weight_noalias : buffer
  %packed_output_global = buffer.assume.memory_space<global> %packed_output_noalias : buffer
  %input_view = buffer.view %input_global[%base] : buffer -> view<[%feature_count]x[%text_token_count]xf32, #dense>
  %weight_view = buffer.view %weight_global[%base] : buffer -> view<[%feature_count]xbf16, #dense>
  %packed_output_view = buffer.view %packed_output_global[%base] : buffer -> view<[%padded_token_count]x[%feature_count]xbf16, #dense>
  %lane_square_sum = scf.if %token_valid -> (f32) {
    %sum = scf.for %feature = [%lane to %feature_count step %workgroup_size_x](%acc = %zero_f32 : f32) -> (f32) {
      %source_feature = func.call @id4_ideogram4_condition_rmsnorm_pack_f32_bf16_source_feature(%feature, %feature_layer_size, %hidden_state_layer_count) : (index, index, index) -> (index)
      %source_value = view.load %input_view[%source_feature, %token] : view<[%feature_count]x[%text_token_count]xf32, #dense> -> f32
      %value_bf16 = scalar.fptrunc %source_value : f32 to bf16
      %value = scalar.extf %value_bf16 : bf16 to f32
      %square = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %value, %value : f32
      %next = scalar.addf<reassoc|nnan|ninf|nsz> %acc, %square : f32
      scf.yield %next : f32
    }
    scf.yield %sum : f32
  } else {
    scf.yield %zero_f32 : f32
  }
  %square_sum = kernel.workgroup.reduce<addf> %lane_square_sum : f32
  %mean_square = scalar.divf<nnan|ninf|nsz|arcp> %square_sum, %feature_count_f32 : f32
  %mean_square_epsilon = scalar.addf<nnan|ninf|nsz> %mean_square, %epsilon : f32
  %row_scale = scalar.rsqrtf<nnan|ninf|nsz|afn> %mean_square_epsilon : f32
  scf.for %feature = [%lane to %feature_count step %workgroup_size_x] {
    %packed = scf.if %token_valid -> (bf16) {
      %source_feature = func.call @id4_ideogram4_condition_rmsnorm_pack_f32_bf16_source_feature(%feature, %feature_layer_size, %hidden_state_layer_count) : (index, index, index) -> (index)
      %source_value = view.load %input_view[%source_feature, %token] : view<[%feature_count]x[%text_token_count]xf32, #dense> -> f32
      %value_bf16 = scalar.fptrunc %source_value : f32 to bf16
      %value = scalar.extf %value_bf16 : bf16 to f32
      %weight_bf16 = view.load %weight_view[%feature] : view<[%feature_count]xbf16, #dense> -> bf16
      %weight_value = scalar.extf %weight_bf16 : bf16 to f32
      %normalized = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %value, %row_scale : f32
      %weighted = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %normalized, %weight_value : f32
      %rounded = scalar.fptrunc %weighted : f32 to bf16
      scf.yield %rounded : bf16
    } else {
      scf.yield %zero_bf16 : bf16
    }
    view.store %packed, %packed_output_view[%token, %feature] : bf16, view<[%padded_token_count]x[%feature_count]xbf16, #dense>
  }
  kernel.return
}

check.case public @id4_ideogram4_condition_rmsnorm_pack_f32_bf16_small_case {
  %input = check.generate.fill value(2.0) : tensor<4x16xf32>
  %weight = check.generate.fill value(1.0) : tensor<4xbf16>
  %output = check.generate.fill value(0.0) : tensor<16x4xbf16>
  %expected = check.generate.fill value(1.0) : tensor<16x4xbf16>
  func.call @id4_ideogram4_condition_rmsnorm_pack_f32_bf16(%input, %weight, %output) : (tensor<4x16xf32>, tensor<4xbf16>, tensor<16x4xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<16x4xbf16>
  check.return
}

check.benchmark<@id4_ideogram4_condition_rmsnorm_pack_f32_bf16_small_case> @id4_ideogram4_condition_rmsnorm_pack_f32_bf16_small
