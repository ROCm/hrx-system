  %up_scale1 = view.load %up_scale_view[%column1] : view<[%intermediate_size]xf32, #dense> -> f32
  scf.for %register_index = [%zero to %eight step %one] {
    %register_token_base = index.mul %register_index, %two : index
    %local_token = index.add %register_token_base, %lane_group : index
    %token0 = index.add %token_origin0, %local_token : index
    %token1 = index.add %token_origin1, %local_token : index
    %gate_value00 = vector.extract %gate_result00[%register_index] : vector<8xf32> -> f32
    %gate_scaled00 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %gate_value00, %gate_scale0 : f32
    %gate_bf16_00 = scalar.fptrunc %gate_scaled00 : f32 to bf16
    %gate_rounded00 = scalar.extf %gate_bf16_00 : bf16 to f32
    %gate_silu00 = scalar.siluf %gate_rounded00 : f32
    %gate_silu_bf16_00 = scalar.fptrunc %gate_silu00 : f32 to bf16
    %gate_silu_rounded00 = scalar.extf %gate_silu_bf16_00 : bf16 to f32
    %up_value00 = vector.extract %up_result00[%register_index] : vector<8xf32> -> f32
    %up_scaled00 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %up_value00, %up_scale0 : f32
    %up_bf16_00 = scalar.fptrunc %up_scaled00 : f32 to bf16
    %up_rounded00 = scalar.extf %up_bf16_00 : bf16 to f32
    %product00 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %gate_silu_rounded00, %up_rounded00 : f32
    %rounded00 = scalar.fptrunc %product00 : f32 to bf16
    view.store %rounded00, %output_view[%token0, %column0] : bf16, view<[%token_capacity]x[%intermediate_size]xbf16, #dense>
    %gate_value01 = vector.extract %gate_result01[%register_index] : vector<8xf32> -> f32
    %gate_scaled01 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %gate_value01, %gate_scale1 : f32
    %gate_bf16_01 = scalar.fptrunc %gate_scaled01 : f32 to bf16
    %gate_rounded01 = scalar.extf %gate_bf16_01 : bf16 to f32
    %gate_silu01 = scalar.siluf %gate_rounded01 : f32
    %gate_silu_bf16_01 = scalar.fptrunc %gate_silu01 : f32 to bf16
    %gate_silu_rounded01 = scalar.extf %gate_silu_bf16_01 : bf16 to f32
