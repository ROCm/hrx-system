kernel.def target(@id4_gfx1100) export("id4_ideogram4_mlp_gate_up_silu_product_fp8_bf16_wmma") @id4_ideogram4_mlp_gate_up_silu_product_fp8_bf16_wmma() {
  %unit = index.constant 1 : index
  %thirty_two = index.constant 32 : index
  %workgroup_size_x = index.constant 32 : index
  %dispatch_token_count = config.get @id4.ideogram4.mlp_gate_up_silu_product_fp8_wmma.dispatch_token_count : index
  %intermediate_size = config.get @id4.ideogram4.mlp_gate_up_silu_product_fp8_wmma.intermediate_size : index
  %token_tile_count = index.div %dispatch_token_count, %thirty_two : index
  %row_tile_count = index.div %intermediate_size, %thirty_two : index
  kernel.launch.config workgroups(%token_tile_count, %row_tile_count, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%input: buffer, %gate_weight: buffer, %gate_scale: buffer, %up_weight: buffer, %up_scale: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %eight = index.constant 8 : index
  %sixteen = index.constant 16 : index
  %thirty_two = index.constant 32 : index
  %token_tile = kernel.workgroup.id<x> : index
  %row_pair = kernel.workgroup.id<y> : index
  %lane = kernel.workitem.id<x> : index
  %token_capacity = config.get @id4.ideogram4.mlp_gate_up_silu_product_fp8_wmma.token_capacity : index
  %input_size = config.get @id4.ideogram4.mlp_gate_up_silu_product_fp8_wmma.input_size : index
  %intermediate_size = config.get @id4.ideogram4.mlp_gate_up_silu_product_fp8_wmma.intermediate_size : index
  %k_tile_count = index.div %input_size, %sixteen : index
  %token_origin0 = index.mul %token_tile, %thirty_two : index
  %token_origin1 = index.add %token_origin0, %sixteen : index
  %row_origin0 = index.mul %row_pair, %thirty_two : index
  %row_origin1 = index.add %row_origin0, %sixteen : index
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %weight_layout = encoding.layout.strided [1, %input_size] : encoding<layout>
  %fp8_storage_schema = encoding.define #matrix_operand<element_format=f8e4m3, payload_elements=1, payload_registers=1, rounding=finite_only> : encoding<schema>
  %fp8_storage = encoding.define #physical_storage {layout = %weight_layout : encoding<layout>, schema = %fp8_storage_schema : encoding<schema>} : encoding<storage>
  %zero_acc = vector.constant 0.0 : vector<8xf32>
  %input_noalias, %gate_weight_noalias, %gate_scale_noalias, %up_weight_noalias, %up_scale_noalias, %output_noalias = buffer.assume.noalias %input, %gate_weight, %gate_scale, %up_weight, %up_scale, %output : buffer, buffer, buffer, buffer, buffer, buffer
  %input_global = buffer.assume.memory_space<global> %input_noalias : buffer
  %gate_weight_global = buffer.assume.memory_space<global> %gate_weight_noalias : buffer
  %gate_scale_global = buffer.assume.memory_space<global> %gate_scale_noalias : buffer
  %up_weight_global = buffer.assume.memory_space<global> %up_weight_noalias : buffer
  %up_scale_global = buffer.assume.memory_space<global> %up_scale_noalias : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  %input_aligned = buffer.assume.alignment %input_global {minimum_alignment = 16} : buffer
  %gate_weight_aligned = buffer.assume.alignment %gate_weight_global {minimum_alignment = 16} : buffer
  %gate_scale_aligned = buffer.assume.alignment %gate_scale_global {minimum_alignment = 16} : buffer
  %up_weight_aligned = buffer.assume.alignment %up_weight_global {minimum_alignment = 16} : buffer
  %up_scale_aligned = buffer.assume.alignment %up_scale_global {minimum_alignment = 16} : buffer
  %output_aligned = buffer.assume.alignment %output_global {minimum_alignment = 16} : buffer
  %input_view = buffer.view %input_aligned[%base] : buffer -> view<[%token_capacity]x[%input_size]xbf16, #dense>
  %gate_weight_view = buffer.view %gate_weight_aligned[%base] : buffer -> view<[%input_size]x[%intermediate_size]xf8E4M3, %fp8_storage>
  %gate_scale_view = buffer.view %gate_scale_aligned[%base] : buffer -> view<[%intermediate_size]xf32, #dense>
  %up_weight_view = buffer.view %up_weight_aligned[%base] : buffer -> view<[%input_size]x[%intermediate_size]xf8E4M3, %fp8_storage>
  %up_scale_view = buffer.view %up_scale_aligned[%base] : buffer -> view<[%intermediate_size]xf32, #dense>
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<[%token_capacity]x[%intermediate_size]xbf16, #dense>
  %init00 = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>
  %init01 = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>
  %init10 = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>
  %init11 = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>
  %gate_result00, %gate_result01, %gate_result10, %gate_result11, %up_result00, %up_result01, %up_result10, %up_result11 = scf.for %k_tile = [%zero to %k_tile_count step %one](%gate_acc00 = %init00 : vector<8xf32>, %gate_acc01 = %init01 : vector<8xf32>, %gate_acc10 = %init10 : vector<8xf32>, %gate_acc11 = %init11 : vector<8xf32>, %up_acc00 = %init00 : vector<8xf32>, %up_acc01 = %init01 : vector<8xf32>, %up_acc10 = %init10 : vector<8xf32>, %up_acc11 = %init11 : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
