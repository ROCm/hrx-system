    %next_gate00 = vector.mma %lhs0, %gate_rhs0, %gate_acc00 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %next_gate01 = vector.mma %lhs0, %gate_rhs1, %gate_acc01 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %next_gate10 = vector.mma %lhs1, %gate_rhs0, %gate_acc10 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %next_gate11 = vector.mma %lhs1, %gate_rhs1, %gate_acc11 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %next_up00 = vector.mma %lhs0, %up_rhs0, %up_acc00 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %next_up01 = vector.mma %lhs0, %up_rhs1, %up_acc01 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %next_up10 = vector.mma %lhs1, %up_rhs0, %up_acc10 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %next_up11 = vector.mma %lhs1, %up_rhs1, %up_acc11 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    scf.yield %next_gate00, %next_gate01, %next_gate10, %next_gate11, %next_up00, %next_up01, %next_up10, %next_up11 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }
  %lane_column = index.rem %lane, %sixteen : index
  %lane_group = index.div %lane, %sixteen : index
  %column0 = index.add %row_origin0, %lane_column : index
  %column1 = index.add %row_origin1, %lane_column : index
  %gate_scale0 = view.load %gate_scale_view[%column0] : view<[%intermediate_size]xf32, #dense> -> f32
  %gate_scale1 = view.load %gate_scale_view[%column1] : view<[%intermediate_size]xf32, #dense> -> f32
