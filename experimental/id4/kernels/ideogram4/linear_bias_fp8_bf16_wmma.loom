    %rhs1_f32 = vector.extf %rhs1 : vector<16xbf16> to vector<16xf32>
    %scaled_rhs0_f32 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %rhs0_f32, %scale0_rhs_vector : vector<16xf32>
    %scaled_rhs1_f32 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %rhs1_f32, %scale1_rhs_vector : vector<16xf32>
    %scaled_rhs0 = vector.fptrunc %scaled_rhs0_f32 : vector<16xf32> to vector<16xbf16>
    %scaled_rhs1 = vector.fptrunc %scaled_rhs1_f32 : vector<16xf32> to vector<16xbf16>
    %next00 = vector.mma %lhs0, %scaled_rhs0, %acc00 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %next01 = vector.mma %lhs0, %scaled_rhs1, %acc01 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %next10 = vector.mma %lhs1, %scaled_rhs0, %acc10 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %next11 = vector.mma %lhs1, %scaled_rhs1, %acc11 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    scf.yield %next00, %next01, %next10, %next11 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }
  %bias0_bf16 = view.load %bias_view[%column0] : view<[%output_size]xbf16, #dense> -> bf16
  %bias1_bf16 = view.load %bias_view[%column1] : view<[%output_size]xbf16, #dense> -> bf16
  %bias0_f32 = scalar.extf %bias0_bf16 : bf16 to f32
  %bias1_f32 = scalar.extf %bias1_bf16 : bf16 to f32
  %bias0_values = vector.splat %bias0_f32 : vector<8xf32>
  %bias1_values = vector.splat %bias1_f32 : vector<8xf32>
  %biased00 = vector.addf<reassoc|nnan|ninf|nsz> %result00, %bias0_values : vector<8xf32>
  %biased01 = vector.addf<reassoc|nnan|ninf|nsz> %result01, %bias1_values : vector<8xf32>
  %biased10 = vector.addf<reassoc|nnan|ninf|nsz> %result10, %bias0_values : vector<8xf32>
  %biased11 = vector.addf<reassoc|nnan|ninf|nsz> %result11, %bias1_values : vector<8xf32>
  vector.fragment.store<result> %biased00, %output_view[%token_origin0, %row_origin0] shape [%m, %n] : vector<8xf32>, view<[%token_count]x[%output_size]xbf16, #dense>
  vector.fragment.store<result> %biased01, %output_view[%token_origin0, %row_origin1] shape [%m, %n] : vector<8xf32>, view<[%token_count]x[%output_size]xbf16, #dense>
  vector.fragment.store<result> %biased10, %output_view[%token_origin1, %row_origin0] shape [%m, %n] : vector<8xf32>, view<[%token_count]x[%output_size]xbf16, #dense>
  vector.fragment.store<result> %biased11, %output_view[%token_origin1, %row_origin1] shape [%m, %n] : vector<8xf32>, view<[%token_count]x[%output_size]xbf16, #dense>
