config.decl @id4.ideogram4.attention_softmax_probs.token_count : %value: index where [range(%value, 16, 131072), mul(%value, 16)]

kernel.def export("id4_ideogram4_attention_softmax_f32_bf16") @id4_ideogram4_attention_softmax_f32_bf16() {
  %unit = index.constant 1 : index
  %workgroup_size_x = index.constant 256 : index
  %token_count = config.get @id4.ideogram4.attention_softmax_probs.token_count : index
  kernel.launch.config workgroups(%token_count, %unit, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%scores: buffer, %probabilities: buffer) {
  %base = index.constant 0 : offset
  %workgroup_size_x = index.constant 256 : index
  %query_token = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %token_count = config.get @id4.ideogram4.attention_softmax_probs.token_count : index
  %zero_f32 = scalar.constant 0.0 : f32
  %one_f32 = scalar.constant 1.0 : f32
  %negative_large = scalar.constant -1000000000.0 : f32

  %scores_noalias, %probabilities_noalias = buffer.assume.noalias %scores, %probabilities : buffer, buffer
  %scores_global = buffer.assume.memory_space<global> %scores_noalias : buffer
  %probabilities_global = buffer.assume.memory_space<global> %probabilities_noalias : buffer
  %scores_view = buffer.view %scores_global[%base] : buffer -> view<[%token_count]x[%token_count]xf32, #dense>
  %probabilities_view = buffer.view %probabilities_global[%base] : buffer -> view<[%token_count]x[%token_count]xbf16, #dense>

  %query_valid = index.cmp ult, %query_token, %token_count : index
  scf.if %query_valid {
    %lane_max = scf.for %key_token = [%lane to %token_count step %workgroup_size_x](%current_max = %negative_large : f32) -> (f32) {
      %score = view.load %scores_view[%query_token, %key_token] : view<[%token_count]x[%token_count]xf32, #dense> -> f32
      %next_max = scalar.maxnumf %current_max, %score : f32
      scf.yield %next_max : f32
    }
    %row_max = kernel.workgroup.reduce<maxnumf> %lane_max : f32
    %lane_sum = scf.for %key_token = [%lane to %token_count step %workgroup_size_x](%current_sum = %zero_f32 : f32) -> (f32) {
      %score = view.load %scores_view[%query_token, %key_token] : view<[%token_count]x[%token_count]xf32, #dense> -> f32
      %centered = scalar.subf<reassoc|nnan|ninf|nsz> %score, %row_max : f32
      %weight = scalar.expf<afn> %centered : f32
      %next_sum = scalar.addf<reassoc|nnan|ninf|nsz> %current_sum, %weight : f32
      scf.yield %next_sum : f32
    }
    %row_sum = kernel.workgroup.reduce<addf> %lane_sum : f32
    %inverse_sum = scalar.divf<nnan|ninf|nsz|arcp> %one_f32, %row_sum : f32
    scf.for %key_token = [%lane to %token_count step %workgroup_size_x] {
      %score = view.load %scores_view[%query_token, %key_token] : view<[%token_count]x[%token_count]xf32, #dense> -> f32
      %centered = scalar.subf<reassoc|nnan|ninf|nsz> %score, %row_max : f32
      %weight = scalar.expf<afn> %centered : f32
      %probability = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %weight, %inverse_sum : f32
      %probability_bf16 = scalar.fptrunc %probability : f32 to bf16
      view.store %probability_bf16, %probabilities_view[%query_token, %key_token] : bf16, view<[%token_count]x[%token_count]xbf16, #dense>
    }
  }
  kernel.return
}

check.case public @id4_ideogram4_attention_softmax_f32_bf16_small_case {
  %scores = check.generate.fill value(0.0) : tensor<16x16xf32>
  %probabilities = check.generate.fill value(0.0) : tensor<16x16xbf16>
  %expected = check.generate.fill value(0.0625) : tensor<16x16xbf16>
  func.call @id4_ideogram4_attention_softmax_f32_bf16(%scores, %probabilities) : (tensor<16x16xf32>, tensor<16x16xbf16>)
  check.expect.close actual(%probabilities) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<16x16xbf16>
  check.return
}

check.case public @id4_ideogram4_attention_softmax_f32_bf16_zero_1024_shape_case {
  %scores = check.generate.fill value(0.0) : tensor<4096x4096xf32>
  %probabilities = check.generate.fill value(0.0) : tensor<4096x4096xbf16>
  %expected = check.generate.fill value(0.000244140625) : tensor<4096x4096xbf16>
  func.call @id4_ideogram4_attention_softmax_f32_bf16(%scores, %probabilities) : (tensor<4096x4096xf32>, tensor<4096x4096xbf16>)
  check.expect.close actual(%probabilities) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<4096x4096xbf16>
  check.return
}

check.benchmark<@id4_ideogram4_attention_softmax_f32_bf16_small_case> @id4_ideogram4_attention_softmax_f32_bf16_small
check.benchmark<@id4_ideogram4_attention_softmax_f32_bf16_zero_1024_shape_case> @id4_ideogram4_attention_softmax_f32_bf16_zero_1024_shape
