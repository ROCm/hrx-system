amdgpu.target<gfx1100> @id4_gfx1100

config.decl @id4.ideogram4.linear_wmma.token_count : %value: index where [range(%value, 16, 131072)]
config.decl @id4.ideogram4.linear_wmma.dispatch_token_count : %value: index where [range(%value, 32, 131072), mul(%value, 32)]
config.decl @id4.ideogram4.linear_wmma.input_size : %value: index where [range(%value, 16, 131072), mul(%value, 16)]
config.decl @id4.ideogram4.linear_wmma.output_size : %value: index where [range(%value, 32, 131072), mul(%value, 32)]

kernel.def target(@id4_gfx1100) export("id4_ideogram4_linear_bf16_bf16_wmma") @id4_ideogram4_linear_bf16_bf16_wmma() {
  %unit = index.constant 1 : index
  %sixteen = index.constant 16 : index
  %thirty_two = index.constant 32 : index
  %workgroup_size_x = index.constant 32 : index
  %dispatch_token_count = config.get @id4.ideogram4.linear_wmma.dispatch_token_count : index
  %output_size = config.get @id4.ideogram4.linear_wmma.output_size : index
  %token_tile_count = index.div %dispatch_token_count, %thirty_two : index
  %row_tile_count = index.div %output_size, %thirty_two : index
  kernel.launch.config workgroups(%token_tile_count, %row_tile_count, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%input_bf16: buffer, %weight: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %sixteen = index.constant 16 : index
  %thirty_two = index.constant 32 : index
  %token_pair = kernel.workgroup.id<x> : index
  %row_pair = kernel.workgroup.id<y> : index
  %token_count = config.get @id4.ideogram4.linear_wmma.token_count : index
  %input_size = config.get @id4.ideogram4.linear_wmma.input_size : index
  %output_size = config.get @id4.ideogram4.linear_wmma.output_size : index
  %k_tile_count = index.div %input_size, %sixteen : index
  %token_origin0 = index.mul %token_pair, %thirty_two : index
  %token_origin1 = index.add %token_origin0, %sixteen : index
  %row_origin0 = index.mul %row_pair, %thirty_two : index
  %row_origin1 = index.add %row_origin0, %sixteen : index
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %weight_layout = encoding.layout.strided [1, %input_size] : encoding<layout>
  %zero_acc = vector.constant 0.0 : vector<8xf32>

  %input_noalias, %weight_noalias, %output_noalias = buffer.assume.noalias %input_bf16, %weight, %output : buffer, buffer, buffer
  %input_global = buffer.assume.memory_space<global> %input_noalias : buffer
  %weight_global = buffer.assume.memory_space<global> %weight_noalias : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  %input_aligned = buffer.assume.alignment %input_global {minimum_alignment = 16} : buffer
  %weight_aligned = buffer.assume.alignment %weight_global {minimum_alignment = 16} : buffer
  %output_aligned = buffer.assume.alignment %output_global {minimum_alignment = 16} : buffer
  %input_view = buffer.view %input_aligned[%base] : buffer -> view<[%token_count]x[%input_size]xbf16, #dense>
  %weight_view = buffer.view %weight_aligned[%base] : buffer -> view<[%input_size]x[%output_size]xbf16, %weight_layout>
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<[%token_count]x[%output_size]xbf16, #dense>

  %init00 = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>
  %init01 = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>
  %init10 = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>
  %init11 = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>
  %lhs_first0 = vector.fragment.load<lhs> %input_view[%token_origin0, %zero] shape [%m, %k] : view<[%token_count]x[%input_size]xbf16, #dense> -> vector<16xbf16>
  %lhs_first1 = vector.fragment.load<lhs> %input_view[%token_origin1, %zero] shape [%m, %k] : view<[%token_count]x[%input_size]xbf16, #dense> -> vector<16xbf16>
  %rhs_first0 = vector.fragment.load<rhs> %weight_view[%zero, %row_origin0] shape [%k, %n] : view<[%input_size]x[%output_size]xbf16, %weight_layout> -> vector<16xbf16>
  %rhs_first1 = vector.fragment.load<rhs> %weight_view[%zero, %row_origin1] shape [%k, %n] : view<[%input_size]x[%output_size]xbf16, %weight_layout> -> vector<16xbf16>
  %first00 = vector.mma %lhs_first0, %rhs_first0, %init00 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
  %first01 = vector.mma %lhs_first0, %rhs_first1, %init01 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
  %first10 = vector.mma %lhs_first1, %rhs_first0, %init10 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
  %first11 = vector.mma %lhs_first1, %rhs_first1, %init11 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
  %result00, %result01, %result10, %result11 = scf.for %k_tile = [%one to %k_tile_count step %one](%acc00 = %first00 : vector<8xf32>, %acc01 = %first01 : vector<8xf32>, %acc10 = %first10 : vector<8xf32>, %acc11 = %first11 : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
    %k_origin = index.mul %k_tile, %sixteen : index
    %lhs0 = vector.fragment.load<lhs> %input_view[%token_origin0, %k_origin] shape [%m, %k] : view<[%token_count]x[%input_size]xbf16, #dense> -> vector<16xbf16>
    %lhs1 = vector.fragment.load<lhs> %input_view[%token_origin1, %k_origin] shape [%m, %k] : view<[%token_count]x[%input_size]xbf16, #dense> -> vector<16xbf16>
    %rhs0 = vector.fragment.load<rhs> %weight_view[%k_origin, %row_origin0] shape [%k, %n] : view<[%input_size]x[%output_size]xbf16, %weight_layout> -> vector<16xbf16>
    %rhs1 = vector.fragment.load<rhs> %weight_view[%k_origin, %row_origin1] shape [%k, %n] : view<[%input_size]x[%output_size]xbf16, %weight_layout> -> vector<16xbf16>
    %next00 = vector.mma %lhs0, %rhs0, %acc00 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %next01 = vector.mma %lhs0, %rhs1, %acc01 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %next10 = vector.mma %lhs1, %rhs0, %acc10 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %next11 = vector.mma %lhs1, %rhs1, %acc11 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    scf.yield %next00, %next01, %next10, %next11 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }
  vector.fragment.store<result> %result00, %output_view[%token_origin0, %row_origin0] shape [%m, %n] : vector<8xf32>, view<[%token_count]x[%output_size]xbf16, #dense>
  vector.fragment.store<result> %result01, %output_view[%token_origin0, %row_origin1] shape [%m, %n] : vector<8xf32>, view<[%token_count]x[%output_size]xbf16, #dense>
  vector.fragment.store<result> %result10, %output_view[%token_origin1, %row_origin0] shape [%m, %n] : vector<8xf32>, view<[%token_count]x[%output_size]xbf16, #dense>
  vector.fragment.store<result> %result11, %output_view[%token_origin1, %row_origin1] shape [%m, %n] : vector<8xf32>, view<[%token_count]x[%output_size]xbf16, #dense>
  kernel.return
}

check.case public @id4_ideogram4_linear_bf16_bf16_wmma_small_case {
  %input = check.generate.fill value(1.0) : tensor<32x16xbf16>
  %weight = check.generate.fill value(1.0) : tensor<16x32xbf16>
  %output = check.generate.fill value(0.0) : tensor<32x32xbf16>
  %expected = check.generate.fill value(16.0) : tensor<32x32xbf16>
  func.call @id4_ideogram4_linear_bf16_bf16_wmma(%input, %weight, %output) : (tensor<32x16xbf16>, tensor<16x32xbf16>, tensor<32x32xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<32x32xbf16>
  check.return
}

