config.decl @id4.ideogram4.head_rmsnorm.token_count : %value: index where [range(%value, 1, 131072)]
config.decl @id4.ideogram4.head_rmsnorm.attention_head_count : %value: index where [range(%value, 1, 1024)]
config.decl @id4.ideogram4.head_rmsnorm.head_size : %value: index where [range(%value, 1, 1024)]

kernel.def export("id4_ideogram4_head_rmsnorm_f32") @id4_ideogram4_head_rmsnorm_f32() {
  %unit = index.constant 1 : index
  %workgroup_size_x = index.constant 256 : index
  %token_count = config.get @id4.ideogram4.head_rmsnorm.token_count : index
  %attention_head_count = config.get @id4.ideogram4.head_rmsnorm.attention_head_count : index
  kernel.launch.config workgroups(%token_count, %attention_head_count, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%input: buffer, %weight: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %workgroup_size_x = index.constant 256 : index
  %token = kernel.workgroup.id<x> : index
  %head = kernel.workgroup.id<y> : index
  %lane = kernel.workitem.id<x> : index
  %token_count = config.get @id4.ideogram4.head_rmsnorm.token_count : index
  %attention_head_count = config.get @id4.ideogram4.head_rmsnorm.attention_head_count : index
  %head_size = config.get @id4.ideogram4.head_rmsnorm.head_size : index
  %hidden_size = index.mul %attention_head_count, %head_size : index
  %head_base = index.mul %head, %head_size : index
  %zero_f32 = scalar.constant 0.0 : f32
  %epsilon = scalar.constant 0.00001 : f32
  %head_size_i32 = index.cast %head_size : index to i32
  %head_size_f32 = scalar.sitofp %head_size_i32 : i32 to f32

  %input_noalias, %weight_noalias, %output_noalias = buffer.assume.noalias %input, %weight, %output : buffer, buffer, buffer
  %input_global = buffer.assume.memory_space<global> %input_noalias : buffer
  %weight_global = buffer.assume.memory_space<global> %weight_noalias : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  %input_view = buffer.view %input_global[%base] : buffer -> view<[%token_count]x[%hidden_size]xf32, #dense>
  %weight_view = buffer.view %weight_global[%base] : buffer -> view<[%head_size]xbf16, #dense>
  %output_view = buffer.view %output_global[%base] : buffer -> view<[%token_count]x[%hidden_size]xf32, #dense>

  %lane_square_sum = scf.for %head_channel = [%lane to %head_size step %workgroup_size_x](%acc = %zero_f32 : f32) -> (f32) {
    %channel = index.add %head_base, %head_channel : index
    %value = view.load %input_view[%token, %channel] : view<[%token_count]x[%hidden_size]xf32, #dense> -> f32
    %square = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %value, %value : f32
    %next = scalar.addf<reassoc|nnan|ninf|nsz> %acc, %square : f32
    scf.yield %next : f32
  }
  %square_sum = kernel.workgroup.reduce<addf> %lane_square_sum : f32
  %mean_square = scalar.divf<nnan|ninf|nsz|arcp> %square_sum, %head_size_f32 : f32
  %mean_square_epsilon = scalar.addf<nnan|ninf|nsz> %mean_square, %epsilon : f32
  %row_scale = scalar.rsqrtf<nnan|ninf|nsz|afn> %mean_square_epsilon : f32

  scf.for %head_channel = [%lane to %head_size step %workgroup_size_x] {
    %channel = index.add %head_base, %head_channel : index
    %value = view.load %input_view[%token, %channel] : view<[%token_count]x[%hidden_size]xf32, #dense> -> f32
    %weight_bf16 = view.load %weight_view[%head_channel] : view<[%head_size]xbf16, #dense> -> bf16
    %weight_value = scalar.extf %weight_bf16 : bf16 to f32
    %normalized = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %value, %row_scale : f32
    %weighted = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %normalized, %weight_value : f32
    view.store %weighted, %output_view[%token, %channel] : f32, view<[%token_count]x[%hidden_size]xf32, #dense>
  }
  kernel.return
}
