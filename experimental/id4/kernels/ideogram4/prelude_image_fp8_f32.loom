config.decl @id4.ideogram4.prelude_image.token_count : %value: index where [range(%value, 1, 65536)]

config.decl @id4.ideogram4.prelude_image.output_token_count : %value: index where [range(%value, 1, 131072)]

config.decl @id4.ideogram4.prelude_image.output_token_offset : %value: index where [range(%value, 0, 65536)]

config.decl @id4.ideogram4.prelude_image.image_width : %value: index where [range(%value, 1, 4096)]

config.decl @id4.ideogram4.prelude_image.image_height : %value: index where [range(%value, 1, 4096)]

config.decl @id4.ideogram4.prelude_image.input_channel_count : %value: index where [range(%value, 4, 1024)]

config.decl @id4.ideogram4.prelude_image.hidden_size : %value: index where [range(%value, 1, 65536)]

func.def inline @id4_ideogram4_prelude_image_fp8_f32_scaled_product(%input_value: f32, %weight_value: f8E4M3, %scale: f32) -> (f32) {
  %weight_f32 = scalar.extf %weight_value : f8E4M3 to f32
  %scale_bf16 = scalar.fptrunc %scale : f32 to bf16
  %scale_f32 = scalar.extf %scale_bf16 : bf16 to f32
  %scaled_weight_f32 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %weight_f32, %scale_f32 : f32
  %scaled_weight_bf16 = scalar.fptrunc %scaled_weight_f32 : f32 to bf16
  %scaled_weight = scalar.extf %scaled_weight_bf16 : bf16 to f32
  %product = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %input_value, %scaled_weight : f32
  func.return %product : f32
}

func.def inline @id4_ideogram4_prelude_image_fp8_f32_dot4(%input_values: vector<4xf32>, %weight0: f8E4M3, %weight1: f8E4M3, %weight2: f8E4M3, %weight3: f8E4M3, %scale: f32) -> (f32) {
  %zero_f32 = scalar.constant 0.0 : f32
  %input0 = vector.extract %input_values[0] : vector<4xf32> -> f32
  %input1 = vector.extract %input_values[1] : vector<4xf32> -> f32
  %input2 = vector.extract %input_values[2] : vector<4xf32> -> f32
  %input3 = vector.extract %input_values[3] : vector<4xf32> -> f32
  %product0 = func.call @id4_ideogram4_prelude_image_fp8_f32_scaled_product(%input0, %weight0, %scale) : (f32, f8E4M3, f32) -> (f32)
  %product1 = func.call @id4_ideogram4_prelude_image_fp8_f32_scaled_product(%input1, %weight1, %scale) : (f32, f8E4M3, f32) -> (f32)
  %product2 = func.call @id4_ideogram4_prelude_image_fp8_f32_scaled_product(%input2, %weight2, %scale) : (f32, f8E4M3, f32) -> (f32)
  %product3 = func.call @id4_ideogram4_prelude_image_fp8_f32_scaled_product(%input3, %weight3, %scale) : (f32, f8E4M3, f32) -> (f32)
  %sum01 = scalar.addf<reassoc|nnan|ninf|nsz> %product0, %product1 : f32
  %sum23 = scalar.addf<reassoc|nnan|ninf|nsz> %product2, %product3 : f32
  %sum = scalar.addf<reassoc|nnan|ninf|nsz> %sum01, %sum23 : f32
  %result = scalar.addf<reassoc|nnan|ninf|nsz> %sum, %zero_f32 : f32
  func.return %result : f32
}

func.def inline @id4_ideogram4_prelude_image_fp8_f32_source_channel(%linear_channel: index, %ae_channel_count: index) -> (index) {
  %two = index.constant 2 : index
  %four = index.constant 4 : index
  %ae_channel = index.rem %linear_channel, %ae_channel_count : index
  %patch_pair = index.div %linear_channel, %ae_channel_count : index
  %patch_h = index.rem %patch_pair, %two : index
  %patch_w = index.div %patch_pair, %two : index
  %ae_offset = index.mul %ae_channel, %four : index
  %patch_w_offset = index.mul %patch_w, %two : index
  %source_base = index.add %ae_offset, %patch_w_offset : index
  %source_channel = index.add %source_base, %patch_h : index
  func.return %source_channel : index
}

kernel.def export("id4_ideogram4_prelude_image_fp8_f32") @id4_ideogram4_prelude_image_fp8_f32() {
  %unit = index.constant 1 : index
  %workgroup_size_x = index.constant 256 : index
  %token_count = config.get @id4.ideogram4.prelude_image.token_count : index
  %hidden_size = config.get @id4.ideogram4.prelude_image.hidden_size : index
  kernel.launch.config workgroups(%token_count, %hidden_size, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%image_tokens: buffer, %weight: buffer, %scale: buffer, %bias: buffer, %image_indicator: buffer, %indicator_embedding: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %three = index.constant 3 : index
  %four = index.constant 4 : index
  %workgroup_size_x = index.constant 256 : index
  %vector_width = index.constant 4 : index
  %token = kernel.workgroup.id<x> : index
  %hidden = kernel.workgroup.id<y> : index
  %lane = kernel.workitem.id<x> : index
  %token_count = config.get @id4.ideogram4.prelude_image.token_count : index
  %output_token_count = config.get @id4.ideogram4.prelude_image.output_token_count : index
  %output_token_offset = config.get @id4.ideogram4.prelude_image.output_token_offset : index
  %image_width = config.get @id4.ideogram4.prelude_image.image_width : index
  %image_height = config.get @id4.ideogram4.prelude_image.image_height : index
  %input_channel_count_unaligned = config.get @id4.ideogram4.prelude_image.input_channel_count : index
  %input_channel_count = index.assume %input_channel_count_unaligned [mul(%input_channel_count_unaligned, 4)] : index
  %hidden_size = config.get @id4.ideogram4.prelude_image.hidden_size : index
  %ae_channel_count = index.div %input_channel_count, %four : index
  %vector_step0 = index.mul %workgroup_size_x, %vector_width : index
  %vector_step = index.assume %vector_step0 [mul(%vector_step0, 4)] : index
  %input_base0 = index.mul %lane, %vector_width : index
  %input_base = index.assume %input_base0 [mul(%input_base0, 4)] : index
  %source_token_w = index.rem %token, %image_width : index
  %source_token_h = index.div %token, %image_width : index
  %source_token_w_offset = index.mul %source_token_w, %image_height : index
  %source_token = index.add %source_token_w_offset, %source_token_h : index
  %zero_f32 = scalar.constant 0.0 : f32
  %dense_layout = encoding.define #dense : encoding<layout>
  %fp8_storage_schema = encoding.define #matrix_operand<element_format=f8e4m3, payload_elements=1, payload_registers=1, rounding=finite_only> : encoding<schema>
  %fp8_storage = encoding.define #physical_storage {layout = %dense_layout : encoding<layout>, schema = %fp8_storage_schema : encoding<schema>} : encoding<storage>
  %image_tokens_noalias, %weight_noalias, %scale_noalias, %bias_noalias, %image_indicator_noalias, %indicator_embedding_noalias, %output_noalias = buffer.assume.noalias %image_tokens, %weight, %scale, %bias, %image_indicator, %indicator_embedding, %output : buffer, buffer, buffer, buffer, buffer, buffer, buffer
  %image_tokens_global = buffer.assume.memory_space<global> %image_tokens_noalias : buffer
  %weight_global = buffer.assume.memory_space<global> %weight_noalias : buffer
  %scale_global = buffer.assume.memory_space<global> %scale_noalias : buffer
  %bias_global = buffer.assume.memory_space<global> %bias_noalias : buffer
  %image_indicator_global = buffer.assume.memory_space<global> %image_indicator_noalias : buffer
  %indicator_embedding_global = buffer.assume.memory_space<global> %indicator_embedding_noalias : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  %image_tokens_view = buffer.view %image_tokens_global[%base] : buffer -> view<[%token_count]x[%input_channel_count]xf32, #dense>
  %weight_view = buffer.view %weight_global[%base] : buffer -> view<[%hidden_size]x[%input_channel_count]xf8E4M3, %fp8_storage>
  %scale_view = buffer.view %scale_global[%base] : buffer -> view<[%hidden_size]xf32, #dense>
  %bias_view = buffer.view %bias_global[%base] : buffer -> view<[%hidden_size]xbf16, #dense>
  %image_indicator_view = buffer.view %image_indicator_global[%base] : buffer -> view<[%output_token_count]xi32, #dense>
  %indicator_embedding_view = buffer.view %indicator_embedding_global[%base] : buffer -> view<2x[%hidden_size]xbf16, #dense>
  %output_view = buffer.view %output_global[%base] : buffer -> view<[%hidden_size]x[%output_token_count]xf32, #dense>
  %scale_value = view.load %scale_view[%hidden] : view<[%hidden_size]xf32, #dense> -> f32
  %lane_dot = scf.for %input_channel = [%input_base to %input_channel_count step %vector_step](%acc = %zero_f32 : f32) -> (f32) {
    %input_channel1 = index.add %input_channel, %one : index
    %input_channel2 = index.add %input_channel, %two : index
    %input_channel3 = index.add %input_channel, %three : index
    %source_channel0 = func.call @id4_ideogram4_prelude_image_fp8_f32_source_channel(%input_channel, %ae_channel_count) : (index, index) -> (index)
    %source_channel1 = func.call @id4_ideogram4_prelude_image_fp8_f32_source_channel(%input_channel1, %ae_channel_count) : (index, index) -> (index)
    %source_channel2 = func.call @id4_ideogram4_prelude_image_fp8_f32_source_channel(%input_channel2, %ae_channel_count) : (index, index) -> (index)
    %source_channel3 = func.call @id4_ideogram4_prelude_image_fp8_f32_source_channel(%input_channel3, %ae_channel_count) : (index, index) -> (index)
    %input_value0 = view.load %image_tokens_view[%source_token, %source_channel0] : view<[%token_count]x[%input_channel_count]xf32, #dense> -> f32
    %input_value1 = view.load %image_tokens_view[%source_token, %source_channel1] : view<[%token_count]x[%input_channel_count]xf32, #dense> -> f32
    %input_value2 = view.load %image_tokens_view[%source_token, %source_channel2] : view<[%token_count]x[%input_channel_count]xf32, #dense> -> f32
    %input_value3 = view.load %image_tokens_view[%source_token, %source_channel3] : view<[%token_count]x[%input_channel_count]xf32, #dense> -> f32
    %input_bf16_0 = scalar.fptrunc %input_value0 : f32 to bf16
    %input_bf16_1 = scalar.fptrunc %input_value1 : f32 to bf16
    %input_bf16_2 = scalar.fptrunc %input_value2 : f32 to bf16
    %input_bf16_3 = scalar.fptrunc %input_value3 : f32 to bf16
    %rounded_input0 = scalar.extf %input_bf16_0 : bf16 to f32
    %rounded_input1 = scalar.extf %input_bf16_1 : bf16 to f32
    %rounded_input2 = scalar.extf %input_bf16_2 : bf16 to f32
    %rounded_input3 = scalar.extf %input_bf16_3 : bf16 to f32
    %input_zero_vector = vector.splat %zero_f32 : vector<4xf32>
    %input_values01 = vector.insert %rounded_input0 into %input_zero_vector[0] : f32, vector<4xf32>
    %input_values02 = vector.insert %rounded_input1 into %input_values01[1] : f32, vector<4xf32>
    %input_values03 = vector.insert %rounded_input2 into %input_values02[2] : f32, vector<4xf32>
    %input_values = vector.insert %rounded_input3 into %input_values03[3] : f32, vector<4xf32>
    %weight0 = view.load %weight_view[%hidden, %input_channel] : view<[%hidden_size]x[%input_channel_count]xf8E4M3, %fp8_storage> -> f8E4M3
    %weight1 = view.load %weight_view[%hidden, %input_channel1] : view<[%hidden_size]x[%input_channel_count]xf8E4M3, %fp8_storage> -> f8E4M3
    %weight2 = view.load %weight_view[%hidden, %input_channel2] : view<[%hidden_size]x[%input_channel_count]xf8E4M3, %fp8_storage> -> f8E4M3
    %weight3 = view.load %weight_view[%hidden, %input_channel3] : view<[%hidden_size]x[%input_channel_count]xf8E4M3, %fp8_storage> -> f8E4M3
    %partial = func.call @id4_ideogram4_prelude_image_fp8_f32_dot4(%input_values, %weight0, %weight1, %weight2, %weight3, %scale_value) : (vector<4xf32>, f8E4M3, f8E4M3, f8E4M3, f8E4M3, f32) -> (f32)
    %next = scalar.addf<reassoc|nnan|ninf|nsz> %acc, %partial : f32
    scf.yield %next : f32
  }
  %dot = kernel.workgroup.reduce<addf> %lane_dot : f32
  %is_leader = index.cmp eq, %lane, %zero : index
  scf.if %is_leader {
    %output_token = index.add %token, %output_token_offset : index
    %bias_bf16 = view.load %bias_view[%hidden] : view<[%hidden_size]xbf16, #dense> -> bf16
    %bias_f32 = scalar.extf %bias_bf16 : bf16 to f32
    %indicator = view.load %image_indicator_view[%output_token] : view<[%output_token_count]xi32, #dense> -> i32
    %indicator_index = index.cast %indicator : i32 to index
    %indicator_embedding_bf16 = view.load %indicator_embedding_view[%indicator_index, %hidden] : view<2x[%hidden_size]xbf16, #dense> -> bf16
    %indicator_embedding_f32 = scalar.extf %indicator_embedding_bf16 : bf16 to f32
    %with_bias = scalar.addf<reassoc|nnan|ninf|nsz> %dot, %bias_f32 : f32
    %value = scalar.addf<reassoc|nnan|ninf|nsz> %with_bias, %indicator_embedding_f32 : f32
    view.store %value, %output_view[%hidden, %output_token] : f32, view<[%hidden_size]x[%output_token_count]xf32, #dense>
  }
  kernel.return
}
