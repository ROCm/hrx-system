amdgpu.target<gfx1100> @id4_gfx1100

config.decl @id4.ideogram4.linear_fp8_wmma.token_count : %value: index where [range(%value, 32, 131072)]

config.decl @id4.ideogram4.linear_fp8_wmma.token_offset : %value: index where [range(%value, 0, 131071)]

config.decl @id4.ideogram4.linear_fp8_wmma.dispatch_token_count : %value: index where [range(%value, 32, 131072), mul(%value, 32)]

config.decl @id4.ideogram4.linear_fp8_wmma.input_size : %value: index where [range(%value, 16, 131072), mul(%value, 16)]

config.decl @id4.ideogram4.linear_fp8_wmma.output_size : %value: index where [range(%value, 32, 131072), mul(%value, 32)]

kernel.def target(@id4_gfx1100) export("id4_ideogram4_linear_fp8_bf16_wmma") @id4_ideogram4_linear_fp8_bf16_wmma() {
  %unit = index.constant 1 : index
  %thirty_two = index.constant 32 : index
  %workgroup_size_x = index.constant 32 : index
  %dispatch_token_count = config.get @id4.ideogram4.linear_fp8_wmma.dispatch_token_count : index
  %output_size = config.get @id4.ideogram4.linear_fp8_wmma.output_size : index
  %token_tile_count = index.div %dispatch_token_count, %thirty_two : index
  %row_tile_count = index.div %output_size, %thirty_two : index
  kernel.launch.config workgroups(%token_tile_count, %row_tile_count, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%input: buffer, %weight: buffer, %scale: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %sixteen = index.constant 16 : index
  %thirty_two = index.constant 32 : index
  %token_tile = kernel.workgroup.id<x> : index
  %row_pair = kernel.workgroup.id<y> : index
  %lane = kernel.workitem.id<x> : index
  %token_count = config.get @id4.ideogram4.linear_fp8_wmma.token_count : index
  %token_offset = config.get @id4.ideogram4.linear_fp8_wmma.token_offset : index
  %input_size = config.get @id4.ideogram4.linear_fp8_wmma.input_size : index
  %output_size = config.get @id4.ideogram4.linear_fp8_wmma.output_size : index
  %k_tile_count = index.div %input_size, %sixteen : index
  %dispatch_token_origin = index.mul %token_tile, %thirty_two : index
  %token_origin0 = index.add %token_offset, %dispatch_token_origin : index
  %token_origin1 = index.add %token_origin0, %sixteen : index
  %row_origin0 = index.mul %row_pair, %thirty_two : index
  %row_origin1 = index.add %row_origin0, %sixteen : index
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %weight_layout = encoding.layout.strided [1, %input_size] : encoding<layout>
  %zero_acc = vector.constant 0.0 : vector<8xf32>
  %input_noalias, %weight_noalias, %scale_noalias, %output_noalias = buffer.assume.noalias %input, %weight, %scale, %output : buffer, buffer, buffer, buffer
  %input_global = buffer.assume.memory_space<global> %input_noalias : buffer
  %weight_global = buffer.assume.memory_space<global> %weight_noalias : buffer
  %scale_global = buffer.assume.memory_space<global> %scale_noalias : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  %input_aligned = buffer.assume.alignment %input_global {minimum_alignment = 16} : buffer
  %weight_aligned = buffer.assume.alignment %weight_global {minimum_alignment = 16} : buffer
  %scale_aligned = buffer.assume.alignment %scale_global {minimum_alignment = 16} : buffer
  %output_aligned = buffer.assume.alignment %output_global {minimum_alignment = 16} : buffer
  %input_view = buffer.view %input_aligned[%base] : buffer -> view<[%token_count]x[%input_size]xbf16, #dense>
  %weight_view = buffer.view %weight_aligned[%base] : buffer -> view<[%input_size]x[%output_size]xf8E4M3, %weight_layout>
  %scale_view = buffer.view %scale_aligned[%base] : buffer -> view<[%output_size]xf32, #dense>
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<[%token_count]x[%output_size]xbf16, #dense>
  %init00 = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>
  %init01 = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>
  %init10 = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>
  %init11 = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>
  %result00, %result01, %result10, %result11 = scf.for %k_tile = [%zero to %k_tile_count step %one](%acc00 = %init00 : vector<8xf32>, %acc01 = %init01 : vector<8xf32>, %acc10 = %init10 : vector<8xf32>, %acc11 = %init11 : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
    %k_origin = index.mul %k_tile, %sixteen : index
    %lhs0 = vector.fragment.load<lhs> %input_view[%token_origin0, %k_origin] shape [%m, %k] : view<[%token_count]x[%input_size]xbf16, #dense> -> vector<16xbf16>
    %lhs1 = vector.fragment.load<lhs> %input_view[%token_origin1, %k_origin] shape [%m, %k] : view<[%token_count]x[%input_size]xbf16, #dense> -> vector<16xbf16>
    %rhs0 = vector.fragment.load<rhs> %weight_view[%k_origin, %row_origin0] shape [%k, %n] : view<[%input_size]x[%output_size]xf8E4M3, %weight_layout> -> vector<16xbf16>
    %rhs1 = vector.fragment.load<rhs> %weight_view[%k_origin, %row_origin1] shape [%k, %n] : view<[%input_size]x[%output_size]xf8E4M3, %weight_layout> -> vector<16xbf16>
    %next00 = vector.mma %lhs0, %rhs0, %acc00 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %next01 = vector.mma %lhs0, %rhs1, %acc01 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %next10 = vector.mma %lhs1, %rhs0, %acc10 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %next11 = vector.mma %lhs1, %rhs1, %acc11 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    scf.yield %next00, %next01, %next10, %next11 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }
  %lane_column = index.rem %lane, %sixteen : index
  %column0 = index.add %row_origin0, %lane_column : index
  %column1 = index.add %row_origin1, %lane_column : index
  %scale0 = view.load %scale_view[%column0] : view<[%output_size]xf32, #dense> -> f32
  %scale1 = view.load %scale_view[%column1] : view<[%output_size]xf32, #dense> -> f32
  %scale0_vector = vector.splat %scale0 : vector<8xf32>
  %scale1_vector = vector.splat %scale1 : vector<8xf32>
  %scaled00 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %result00, %scale0_vector : vector<8xf32>
  %scaled01 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %result01, %scale1_vector : vector<8xf32>
  %scaled10 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %result10, %scale0_vector : vector<8xf32>
  %scaled11 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %result11, %scale1_vector : vector<8xf32>
  vector.fragment.store<result> %scaled00, %output_view[%token_origin0, %row_origin0] shape [%m, %n] : vector<8xf32>, view<[%token_count]x[%output_size]xbf16, #dense>
  vector.fragment.store<result> %scaled01, %output_view[%token_origin0, %row_origin1] shape [%m, %n] : vector<8xf32>, view<[%token_count]x[%output_size]xbf16, #dense>
  vector.fragment.store<result> %scaled10, %output_view[%token_origin1, %row_origin0] shape [%m, %n] : vector<8xf32>, view<[%token_count]x[%output_size]xbf16, #dense>
  vector.fragment.store<result> %scaled11, %output_view[%token_origin1, %row_origin1] shape [%m, %n] : vector<8xf32>, view<[%token_count]x[%output_size]xbf16, #dense>
  kernel.return
}

