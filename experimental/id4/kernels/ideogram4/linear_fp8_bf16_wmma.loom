amdgpu.target<gfx1100> @id4_gfx1100

config.decl @id4.ideogram4.linear_fp8_wmma.token_count : %value: index where [range(%value, 32, 131072)]

config.decl @id4.ideogram4.linear_fp8_wmma.dispatch_token_count : %value: index where [range(%value, 32, 131072), mul(%value, 32)]

config.decl @id4.ideogram4.linear_fp8_wmma.input_size : %value: index where [range(%value, 16, 131072), mul(%value, 16)]

config.decl @id4.ideogram4.linear_fp8_wmma.output_size : %value: index where [range(%value, 32, 131072), mul(%value, 32)]

kernel.def target(@id4_gfx1100) export("id4_ideogram4_linear_fp8_bf16_wmma") @id4_ideogram4_linear_fp8_bf16_wmma() {
  %unit = index.constant 1 : index
  %thirty_two = index.constant 32 : index
  %workgroup_size_x = index.constant 32 : index
  %dispatch_token_count = config.get @id4.ideogram4.linear_fp8_wmma.dispatch_token_count : index
  %output_size = config.get @id4.ideogram4.linear_fp8_wmma.output_size : index
  %token_tile_count = index.div %dispatch_token_count, %thirty_two : index
  %row_tile_count = index.div %output_size, %thirty_two : index
  kernel.launch.config workgroups(%token_tile_count, %row_tile_count, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%input: buffer, %weight: buffer, %scale: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %sixteen = index.constant 16 : index
  %thirty_two = index.constant 32 : index
  %rhs_scratch_bytes = index.constant 1024 : offset
  %acc_scratch_bytes = index.constant 4096 : offset
  %token_tile = kernel.workgroup.id<x> : index
  %row_pair = kernel.workgroup.id<y> : index
  %lane = kernel.workitem.id<x> : index
  %token_count = config.get @id4.ideogram4.linear_fp8_wmma.token_count : index
  %input_size = config.get @id4.ideogram4.linear_fp8_wmma.input_size : index
  %output_size = config.get @id4.ideogram4.linear_fp8_wmma.output_size : index
  %k_tile_count = index.div %input_size, %sixteen : index
  %token_origin0 = index.mul %token_tile, %thirty_two : index
  %token_origin1 = index.add %token_origin0, %sixteen : index
  %row_origin0 = index.mul %row_pair, %thirty_two : index
  %row_origin1 = index.add %row_origin0, %sixteen : index
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %weight_layout = encoding.layout.strided [1, %input_size] : encoding<layout>
  %rhs_scratch_layout = encoding.layout.strided [1, %sixteen] : encoding<layout>
  %zero_f32 = scalar.constant 0.0 : f32
  %input_noalias, %weight_noalias, %scale_noalias, %output_noalias = buffer.assume.noalias %input, %weight, %scale, %output : buffer, buffer, buffer, buffer
  %input_global = buffer.assume.memory_space<global> %input_noalias : buffer
  %weight_global = buffer.assume.memory_space<global> %weight_noalias : buffer
  %scale_global = buffer.assume.memory_space<global> %scale_noalias : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  %input_aligned = buffer.assume.alignment %input_global {minimum_alignment = 16} : buffer
  %weight_aligned = buffer.assume.alignment %weight_global {minimum_alignment = 16} : buffer
  %scale_aligned = buffer.assume.alignment %scale_global {minimum_alignment = 16} : buffer
  %output_aligned = buffer.assume.alignment %output_global {minimum_alignment = 16} : buffer
  %input_view = buffer.view %input_aligned[%base] : buffer -> view<[%token_count]x[%input_size]xbf16, #dense>
  %weight_view = buffer.view %weight_aligned[%base] : buffer -> view<[%input_size]x[%output_size]xf8E4M3, %weight_layout>
  %scale_view = buffer.view %scale_aligned[%base] : buffer -> view<[%output_size]xf32, #dense>
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<[%token_count]x[%output_size]xbf16, #dense>
  %rhs_scratch = buffer.alloca %rhs_scratch_bytes {base_alignment = 16, memory_space = workgroup} : buffer
  %acc_scratch = buffer.alloca %acc_scratch_bytes {base_alignment = 16, memory_space = workgroup} : buffer
  %rhs_scratch_view = buffer.view %rhs_scratch[%base] : buffer -> view<16x32xbf16, %rhs_scratch_layout>
  %acc_scratch_view = buffer.view %acc_scratch[%base] : buffer -> view<32x32xf32, #dense>
  %acc_scratch_linear_view = buffer.view %acc_scratch[%base] : buffer -> view<1024xf32, #dense>
  %acc_element_count = index.constant 1024 : index
  scf.for %acc_linear = [%lane to %acc_element_count step %thirty_two] {
    view.store %zero_f32, %acc_scratch_linear_view[%acc_linear] : f32, view<1024xf32, #dense>
  }
  kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
  %rhs_element_count = index.constant 512 : index
  scf.for %k_tile = [%zero to %k_tile_count step %one] {
    %k_origin = index.mul %k_tile, %sixteen : index
    scf.for %rhs_linear = [%lane to %rhs_element_count step %thirty_two] {
      %local_k = index.rem %rhs_linear, %sixteen : index
      %local_row = index.div %rhs_linear, %sixteen : index
      %output_row = index.add %row_origin0, %local_row : index
      %weight_k = index.add %k_origin, %local_k : index
      %weight_value = view.load %weight_view[%weight_k, %output_row] : view<[%input_size]x[%output_size]xf8E4M3, %weight_layout> -> f8E4M3
      %weight_f32 = scalar.extf %weight_value : f8E4M3 to f32
      %scale_f32 = view.load %scale_view[%output_row] : view<[%output_size]xf32, #dense> -> f32
      %scaled = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %weight_f32, %scale_f32 : f32
      %weight_bf16 = scalar.fptrunc %scaled : f32 to bf16
      view.store %weight_bf16, %rhs_scratch_view[%local_k, %local_row] : bf16, view<16x32xbf16, %rhs_scratch_layout>
    }
    kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
    %acc00 = vector.fragment.load<init> %acc_scratch_view[%zero, %zero] shape [%m, %n] : view<32x32xf32, #dense> -> vector<8xf32>
    %acc01 = vector.fragment.load<init> %acc_scratch_view[%zero, %sixteen] shape [%m, %n] : view<32x32xf32, #dense> -> vector<8xf32>
    %acc10 = vector.fragment.load<init> %acc_scratch_view[%sixteen, %zero] shape [%m, %n] : view<32x32xf32, #dense> -> vector<8xf32>
    %acc11 = vector.fragment.load<init> %acc_scratch_view[%sixteen, %sixteen] shape [%m, %n] : view<32x32xf32, #dense> -> vector<8xf32>
    %lhs0 = vector.fragment.load<lhs> %input_view[%token_origin0, %k_origin] shape [%m, %k] : view<[%token_count]x[%input_size]xbf16, #dense> -> vector<16xbf16>
    %lhs1 = vector.fragment.load<lhs> %input_view[%token_origin1, %k_origin] shape [%m, %k] : view<[%token_count]x[%input_size]xbf16, #dense> -> vector<16xbf16>
    %rhs0 = vector.fragment.load<rhs> %rhs_scratch_view[%zero, %zero] shape [%k, %n] : view<16x32xbf16, %rhs_scratch_layout> -> vector<16xbf16>
    %rhs1 = vector.fragment.load<rhs> %rhs_scratch_view[%zero, %sixteen] shape [%k, %n] : view<16x32xbf16, %rhs_scratch_layout> -> vector<16xbf16>
    %result00 = vector.mma %lhs0, %rhs0, %acc00 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %result01 = vector.mma %lhs0, %rhs1, %acc01 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %result10 = vector.mma %lhs1, %rhs0, %acc10 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %result11 = vector.mma %lhs1, %rhs1, %acc11 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    vector.fragment.store<result> %result00, %acc_scratch_view[%zero, %zero] shape [%m, %n] : vector<8xf32>, view<32x32xf32, #dense>
    vector.fragment.store<result> %result01, %acc_scratch_view[%zero, %sixteen] shape [%m, %n] : vector<8xf32>, view<32x32xf32, #dense>
    vector.fragment.store<result> %result10, %acc_scratch_view[%sixteen, %zero] shape [%m, %n] : vector<8xf32>, view<32x32xf32, #dense>
    vector.fragment.store<result> %result11, %acc_scratch_view[%sixteen, %sixteen] shape [%m, %n] : vector<8xf32>, view<32x32xf32, #dense>
    kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
  }
  %final00 = vector.fragment.load<init> %acc_scratch_view[%zero, %zero] shape [%m, %n] : view<32x32xf32, #dense> -> vector<8xf32>
  %final01 = vector.fragment.load<init> %acc_scratch_view[%zero, %sixteen] shape [%m, %n] : view<32x32xf32, #dense> -> vector<8xf32>
  %final10 = vector.fragment.load<init> %acc_scratch_view[%sixteen, %zero] shape [%m, %n] : view<32x32xf32, #dense> -> vector<8xf32>
  %final11 = vector.fragment.load<init> %acc_scratch_view[%sixteen, %sixteen] shape [%m, %n] : view<32x32xf32, #dense> -> vector<8xf32>
  vector.fragment.store<result> %final00, %output_view[%token_origin0, %row_origin0] shape [%m, %n] : vector<8xf32>, view<[%token_count]x[%output_size]xbf16, #dense>
  vector.fragment.store<result> %final01, %output_view[%token_origin0, %row_origin1] shape [%m, %n] : vector<8xf32>, view<[%token_count]x[%output_size]xbf16, #dense>
  vector.fragment.store<result> %final10, %output_view[%token_origin1, %row_origin0] shape [%m, %n] : vector<8xf32>, view<[%token_count]x[%output_size]xbf16, #dense>
  vector.fragment.store<result> %final11, %output_view[%token_origin1, %row_origin1] shape [%m, %n] : vector<8xf32>, view<[%token_count]x[%output_size]xbf16, #dense>
  kernel.return
}

check.case public @id4_ideogram4_linear_fp8_bf16_wmma_small_case {
  %input = check.generate.fill value(1.0) : tensor<32x32xbf16>
  %weight = check.generate.fill value(1.0) : tensor<32x32xf8E4M3>
  %scale = check.generate.fill value(1.0) : tensor<32xf32>
  %output = check.generate.fill value(0.0) : tensor<32x32xbf16>
  %expected = check.generate.fill value(32.0) : tensor<32x32xbf16>
  func.call @id4_ideogram4_linear_fp8_bf16_wmma(%input, %weight, %scale, %output) : (tensor<32x32xbf16>, tensor<32x32xf8E4M3>, tensor<32xf32>, tensor<32x32xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<32x32xbf16>
  check.return
}

