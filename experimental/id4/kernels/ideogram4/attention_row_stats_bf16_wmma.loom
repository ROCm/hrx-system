amdgpu.target<gfx1100> @id4_gfx1100

config.decl @id4.ideogram4.attention_row_stats_wmma.valid_token_count : %value: index where [range(%value, 1, 131072)]

config.decl @id4.ideogram4.attention_row_stats_wmma.padded_token_count : %value: index where [range(%value, 16, 131072), mul(%value, 16)]

config.decl @id4.ideogram4.attention_row_stats_wmma.query_block_offset : %value: index where [range(%value, 0, 131071), mul(%value, 16)]

config.decl @id4.ideogram4.attention_row_stats_wmma.query_block_token_count : %value: index where [range(%value, 16, 4096), mul(%value, 16)]

config.decl @id4.ideogram4.attention_row_stats_wmma.attention_head_count : %value: index where [range(%value, 1, 1024)]

config.decl @id4.ideogram4.attention_row_stats_wmma.head_size : %value: index where [range(%value, 16, 1024), mul(%value, 16)]

kernel.def target(@id4_gfx1100) export("id4_ideogram4_attention_row_stats_bf16_f32_wmma") @id4_ideogram4_attention_row_stats_bf16_f32_wmma() {
  %unit = index.constant 1 : index
  %sixteen = index.constant 16 : index
  %workgroup_size_x = index.constant 32 : index
  %query_block_token_count = config.get @id4.ideogram4.attention_row_stats_wmma.query_block_token_count : index
  %attention_head_count = config.get @id4.ideogram4.attention_row_stats_wmma.attention_head_count : index
  %query_tile_count = index.div %query_block_token_count, %sixteen : index
  kernel.launch.config workgroups(%query_tile_count, %attention_head_count, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%query: buffer, %key: buffer, %row_max: buffer, %row_sum: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %eight = index.constant 8 : index
  %sixteen = index.constant 16 : index
  %four_bytes = index.constant 4 : offset
  %query_tile = kernel.workgroup.id<x> : index
  %query_head = kernel.workgroup.id<y> : index
  %lane = kernel.workitem.id<x> : index
  %lane_column = index.rem %lane, %sixteen : index
  %lane_group = index.div %lane, %sixteen : index
  %lane_group_even = index.cmp eq, %lane_group, %zero : index
  %store_lane = index.cmp eq, %lane_column, %zero : index
  %valid_token_count = config.get @id4.ideogram4.attention_row_stats_wmma.valid_token_count : index
  %padded_token_count = config.get @id4.ideogram4.attention_row_stats_wmma.padded_token_count : index
  %query_block_offset = config.get @id4.ideogram4.attention_row_stats_wmma.query_block_offset : index
  %query_block_token_count = config.get @id4.ideogram4.attention_row_stats_wmma.query_block_token_count : index
  %attention_head_count = config.get @id4.ideogram4.attention_row_stats_wmma.attention_head_count : index
  %head_size = config.get @id4.ideogram4.attention_row_stats_wmma.head_size : index
  %hidden_size = index.mul %attention_head_count, %head_size : index
  %head_base = index.mul %query_head, %head_size : index
  %head_tile_count = index.div %head_size, %sixteen : index
  %local_query_origin = index.mul %query_tile, %sixteen : index
  %query_origin = index.add %query_block_offset, %local_query_origin : index
  %key_tile_count = index.div %padded_token_count, %sixteen : index
  %head_size_i32 = index.cast %head_size : index to i32
  %head_size_f32 = scalar.sitofp %head_size_i32 : i32 to f32
  %attention_scale = scalar.rsqrtf<nnan|ninf|nsz|afn> %head_size_f32 : f32
  %attention_scale_vector = vector.splat %attention_scale : vector<8xf32>
  %zero_f32 = scalar.constant 0.0 : f32
  %negative_large = scalar.constant -1000000000.0 : f32
  %zero_vector = vector.splat %zero_f32 : vector<8xf32>
  %negative_vector = vector.splat %negative_large : vector<8xf32>
  %zero_acc = vector.constant 0.0 : vector<8xf32>
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %key_transposed_layout = encoding.layout.strided [1, %hidden_size] : encoding<layout>
  %query_noalias, %key_noalias, %row_max_noalias, %row_sum_noalias = buffer.assume.noalias %query, %key, %row_max, %row_sum : buffer, buffer, buffer, buffer
  %query_global = buffer.assume.memory_space<global> %query_noalias : buffer
  %key_global = buffer.assume.memory_space<global> %key_noalias : buffer
  %row_max_global = buffer.assume.memory_space<global> %row_max_noalias : buffer
  %row_sum_global = buffer.assume.memory_space<global> %row_sum_noalias : buffer
  %query_aligned = buffer.assume.alignment %query_global {minimum_alignment = 16} : buffer
  %key_aligned = buffer.assume.alignment %key_global {minimum_alignment = 16} : buffer
  %row_max_aligned = buffer.assume.alignment %row_max_global {minimum_alignment = 16} : buffer
  %row_sum_aligned = buffer.assume.alignment %row_sum_global {minimum_alignment = 16} : buffer
  %query_view = buffer.view %query_aligned[%base] : buffer -> view<[%padded_token_count]x[%hidden_size]xbf16, #dense>
  %key_transposed_view = buffer.view %key_aligned[%base] : buffer -> view<[%hidden_size]x[%padded_token_count]xbf16, %key_transposed_layout>
  %row_max_view = buffer.view %row_max_aligned[%base] : buffer -> view<[%attention_head_count]x[%query_block_token_count]xf32, #dense>
  %row_sum_view = buffer.view %row_sum_aligned[%base] : buffer -> view<[%attention_head_count]x[%query_block_token_count]xf32, #dense>
  %init = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>
  %final_max_even, %final_sum_even, %final_max_odd, %final_sum_odd = scf.for %key_tile = [%zero to %key_tile_count step %one](%current_max_even = %negative_vector : vector<8xf32>, %current_sum_even = %zero_vector : vector<8xf32>, %current_max_odd = %negative_vector : vector<8xf32>, %current_sum_odd = %zero_vector : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
    %key_origin = index.mul %key_tile, %sixteen : index
    %key_token = index.add %key_origin, %lane_column : index
    %key_valid = index.cmp ult, %key_token, %valid_token_count : index
    %raw_scores = scf.for %head_tile = [%zero to %head_tile_count step %one](%acc = %init : vector<8xf32>) -> (vector<8xf32>) {
      %head_tile_offset = index.mul %head_tile, %sixteen : index
      %channel_origin = index.add %head_base, %head_tile_offset : index
      %lhs = vector.fragment.load<lhs> %query_view[%query_origin, %channel_origin] shape [%m, %k] : view<[%padded_token_count]x[%hidden_size]xbf16, #dense> -> vector<16xbf16>
      %rhs = vector.fragment.load<rhs> %key_transposed_view[%channel_origin, %key_origin] shape [%k, %n] : view<[%hidden_size]x[%padded_token_count]xbf16, %key_transposed_layout> -> vector<16xbf16>
      %next = vector.mma %lhs, %rhs, %acc : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
      scf.yield %next : vector<8xf32>
    }
    %scaled_scores0 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %raw_scores, %attention_scale_vector : vector<8xf32>
    %scaled_scores = scf.if %key_valid -> (vector<8xf32>) {
      scf.yield %scaled_scores0 : vector<8xf32>
    } else {
      scf.yield %negative_vector : vector<8xf32>
    }
    %even_scores = scf.if %lane_group_even -> (vector<8xf32>) {
      scf.yield %scaled_scores : vector<8xf32>
    } else {
      scf.yield %negative_vector : vector<8xf32>
    }
    %odd_scores = scf.if %lane_group_even -> (vector<8xf32>) {
      scf.yield %negative_vector : vector<8xf32>
    } else {
      scf.yield %scaled_scores : vector<8xf32>
    }
    %tile_max_even = kernel.workgroup.reduce<maxnumf> %even_scores : vector<8xf32>
    %tile_max_odd = kernel.workgroup.reduce<maxnumf> %odd_scores : vector<8xf32>
    %next_max_even = vector.maxnumf %current_max_even, %tile_max_even : vector<8xf32>
    %next_max_odd = vector.maxnumf %current_max_odd, %tile_max_odd : vector<8xf32>
    %selected_next_max = scf.if %lane_group_even -> (vector<8xf32>) {
      scf.yield %next_max_even : vector<8xf32>
    } else {
      scf.yield %next_max_odd : vector<8xf32>
    }
    %score_delta = vector.subf<reassoc|nnan|ninf|nsz> %scaled_scores, %selected_next_max : vector<8xf32>
    %raw_weight = vector.expf<afn> %score_delta : vector<8xf32>
    %weight = scf.if %key_valid -> (vector<8xf32>) {
      scf.yield %raw_weight : vector<8xf32>
    } else {
      scf.yield %zero_vector : vector<8xf32>
    }
    %even_weight = scf.if %lane_group_even -> (vector<8xf32>) {
      scf.yield %weight : vector<8xf32>
    } else {
      scf.yield %zero_vector : vector<8xf32>
    }
    %odd_weight = scf.if %lane_group_even -> (vector<8xf32>) {
      scf.yield %zero_vector : vector<8xf32>
    } else {
      scf.yield %weight : vector<8xf32>
    }
    %tile_sum_even = kernel.workgroup.reduce<addf> %even_weight : vector<8xf32>
    %tile_sum_odd = kernel.workgroup.reduce<addf> %odd_weight : vector<8xf32>
    %old_delta_even = vector.subf<reassoc|nnan|ninf|nsz> %current_max_even, %next_max_even : vector<8xf32>
    %old_delta_odd = vector.subf<reassoc|nnan|ninf|nsz> %current_max_odd, %next_max_odd : vector<8xf32>
    %old_scale_even = vector.expf<afn> %old_delta_even : vector<8xf32>
    %old_scale_odd = vector.expf<afn> %old_delta_odd : vector<8xf32>
    %scaled_sum_even = vector.mulf<reassoc|nnan|ninf|nsz|contract> %current_sum_even, %old_scale_even : vector<8xf32>
    %scaled_sum_odd = vector.mulf<reassoc|nnan|ninf|nsz|contract> %current_sum_odd, %old_scale_odd : vector<8xf32>
    %next_sum_even = vector.addf<reassoc|nnan|ninf|nsz> %scaled_sum_even, %tile_sum_even : vector<8xf32>
    %next_sum_odd = vector.addf<reassoc|nnan|ninf|nsz> %scaled_sum_odd, %tile_sum_odd : vector<8xf32>
    scf.yield %next_max_even, %next_sum_even, %next_max_odd, %next_sum_odd : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }
  scf.if %store_lane {
    %selected_max = scf.if %lane_group_even -> (vector<8xf32>) {
      scf.yield %final_max_even : vector<8xf32>
    } else {
      scf.yield %final_max_odd : vector<8xf32>
    }
    %selected_sum = scf.if %lane_group_even -> (vector<8xf32>) {
      scf.yield %final_sum_even : vector<8xf32>
    } else {
      scf.yield %final_sum_odd : vector<8xf32>
    }
    scf.for %register_index = [%zero to %eight step %one] unroll {
      %local_query_pair_base = index.mul %register_index, %two : index
      %local_query = index.add %local_query_pair_base, %lane_group : index
      %query_token = index.add %local_query_origin, %local_query : index
      %max_value = vector.extract %selected_max[%register_index] : vector<8xf32> -> f32
      %sum_value = vector.extract %selected_sum[%register_index] : vector<8xf32> -> f32
      view.store %max_value, %row_max_view[%query_head, %query_token] : f32, view<[%attention_head_count]x[%query_block_token_count]xf32, #dense>
      view.store %sum_value, %row_sum_view[%query_head, %query_token] : f32, view<[%attention_head_count]x[%query_block_token_count]xf32, #dense>
    }
  }
  kernel.return
}

check.case public @id4_ideogram4_attention_row_stats_bf16_f32_wmma_small_case {
  %query = check.generate.fill value(1.0) : tensor<16x32xbf16>
  %key = check.generate.fill value(1.0) : tensor<16x32xbf16>
  %row_max = check.generate.fill value(0.0) : tensor<2x16xf32>
  %row_sum = check.generate.fill value(0.0) : tensor<2x16xf32>
  %expected_max = check.generate.fill value(4.0) : tensor<2x16xf32>
  %expected_sum = check.generate.fill value(16.0) : tensor<2x16xf32>
  func.call @id4_ideogram4_attention_row_stats_bf16_f32_wmma(%query, %key, %row_max, %row_sum) : (tensor<16x32xbf16>, tensor<16x32xbf16>, tensor<2x16xf32>, tensor<2x16xf32>)
  check.expect.close actual(%row_max) expected(%expected_max) atol(0.0) rtol(0.0) nan(same) : tensor<2x16xf32>
  check.expect.close actual(%row_sum) expected(%expected_sum) atol(0.0) rtol(0.0) nan(same) : tensor<2x16xf32>
  check.return
}

