  %row_sum = check.generate.fill value(0.0) : tensor<18x512xf32>
  %expected_max = check.generate.fill value(0.0) : tensor<18x512xf32>
  %expected_sum = check.generate.fill value(4096.0) : tensor<18x512xf32>
  func.call @id4_ideogram4_attention_row_stats_bf16_f32_wmma(%query, %key, %row_max, %row_sum) : (tensor<4096x4608xbf16>, tensor<4096x4608xbf16>, tensor<18x512xf32>, tensor<18x512xf32>)
  check.expect.close actual(%row_max) expected(%expected_max) atol(0.0) rtol(0.0) nan(same) : tensor<18x512xf32>
