config.decl @id4.ideogram4.linear_tail.token_count : %value: index where [range(%value, 1, 131072)]

config.decl @id4.ideogram4.linear_tail.token_offset : %value: index where [range(%value, 0, 131071)]

config.decl @id4.ideogram4.linear_tail.dispatch_token_count : %value: index where [range(%value, 1, 64)]

config.decl @id4.ideogram4.linear_tail.input_size : %value: index where [range(%value, 1, 131072)]

config.decl @id4.ideogram4.linear_tail.output_size : %value: index where [range(%value, 1, 131072)]

kernel.def export("id4_ideogram4_linear_bf16_bf16_tail") @id4_ideogram4_linear_bf16_bf16_tail() {
  %unit = index.constant 1 : index
  %fifteen = index.constant 15 : index
  %workgroup_size_x = index.constant 256 : index
  %token_block = index.constant 16 : index
  %row_block = index.constant 16 : index
  %dispatch_token_count = config.get @id4.ideogram4.linear_tail.dispatch_token_count : index
  %output_size = config.get @id4.ideogram4.linear_tail.output_size : index
  %rounded_token_count = index.add %dispatch_token_count, %fifteen : index
  %token_tile_count = index.div %rounded_token_count, %token_block : index
  %rounded_output_size = index.add %output_size, %fifteen : index
  %row_tile_count = index.div %rounded_output_size, %row_block : index
  kernel.launch.config workgroups(%token_tile_count, %row_tile_count, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%input_bf16: buffer, %weight: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %workgroup_size_x = index.constant 256 : index
  %token_block = index.constant 16 : index
  %row_block = index.constant 16 : index
  %token_tile = kernel.workgroup.id<x> : index
  %row_tile = kernel.workgroup.id<y> : index
  %lane = kernel.workitem.id<x> : index
  %token_count = config.get @id4.ideogram4.linear_tail.token_count : index
  %token_base_offset = config.get @id4.ideogram4.linear_tail.token_offset : index
  %dispatch_token_count = config.get @id4.ideogram4.linear_tail.dispatch_token_count : index
  %input_size = config.get @id4.ideogram4.linear_tail.input_size : index
  %output_size = config.get @id4.ideogram4.linear_tail.output_size : index
  %base_dispatch_token = index.mul %token_tile, %token_block : index
  %base_row = index.mul %row_tile, %row_block : index
  %local_row = index.div %lane, %token_block : index
  %local_token = index.rem %lane, %token_block : index
  %output_row = index.add %base_row, %local_row : index
  %dispatch_token = index.add %base_dispatch_token, %local_token : index
  %token = index.add %token_base_offset, %dispatch_token : index
  %zero_f32 = scalar.constant 0.0 : f32
  %input_noalias, %weight_noalias, %output_noalias = buffer.assume.noalias %input_bf16, %weight, %output : buffer, buffer, buffer
  %input_global = buffer.assume.memory_space<global> %input_noalias : buffer
  %weight_global = buffer.assume.memory_space<global> %weight_noalias : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  %input_view = buffer.view %input_global[%base] : buffer -> view<[%token_count]x[%input_size]xbf16, #dense>
  %weight_view = buffer.view %weight_global[%base] : buffer -> view<[%output_size]x[%input_size]xbf16, #dense>
  %output_view = buffer.view %output_global[%base] : buffer -> view<[%token_count]x[%output_size]xbf16, #dense>
  %dispatch_token_valid = index.cmp ult, %dispatch_token, %dispatch_token_count : index
  %token_valid = index.cmp ult, %token, %token_count : index
  %row_valid = index.cmp ult, %output_row, %output_size : index
  %valid_token = scalar.andi %dispatch_token_valid, %token_valid : i1
  %valid_output = scalar.andi %valid_token, %row_valid : i1
  scf.if %valid_output {
    %dot = scf.for %input_index = [%zero to %input_size step %one](%acc = %zero_f32 : f32) -> (f32) {
      %input_index_valid = index.cmp ult, %input_index, %input_size : index
      %input_value, %weight_value = scf.if %input_index_valid -> (f32, f32) {
        %input_bf16_value = view.load %input_view[%token, %input_index] : view<[%token_count]x[%input_size]xbf16, #dense> -> bf16
        %weight_bf16_value = view.load %weight_view[%output_row, %input_index] : view<[%output_size]x[%input_size]xbf16, #dense> -> bf16
        %input_f32 = scalar.extf %input_bf16_value : bf16 to f32
        %weight_f32 = scalar.extf %weight_bf16_value : bf16 to f32
        scf.yield %input_f32, %weight_f32 : f32, f32
      } else {
        scf.yield %zero_f32, %zero_f32 : f32, f32
      }
      %product = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %input_value, %weight_value : f32
      %next = scalar.addf<reassoc|nnan|ninf|nsz> %acc, %product : f32
      scf.yield %next : f32
    }
    %rounded = scalar.fptrunc %dot : f32 to bf16
    view.store %rounded, %output_view[%token, %output_row] : bf16, view<[%token_count]x[%output_size]xbf16, #dense>
  }
  kernel.return
}
