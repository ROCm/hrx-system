config.decl @id4.ideogram4.linear_bias.token_count : %value: index where [range(%value, 1, 131072)]
config.decl @id4.ideogram4.linear_bias.input_size : %value: index where [range(%value, 4, 131072)]
config.decl @id4.ideogram4.linear_bias.output_size : %value: index where [range(%value, 1, 131072)]

kernel.def export("id4_ideogram4_linear_bias_bf16_f32") @id4_ideogram4_linear_bias_bf16_f32() {
  %unit = index.constant 1 : index
  %workgroup_size_x = index.constant 256 : index
  %token_count = config.get @id4.ideogram4.linear_bias.token_count : index
  %output_size = config.get @id4.ideogram4.linear_bias.output_size : index
  kernel.launch.config workgroups(%token_count, %output_size, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%input: buffer, %weight: buffer, %bias: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %workgroup_size_x = index.constant 256 : index
  %token = kernel.workgroup.id<x> : index
  %output_row = kernel.workgroup.id<y> : index
  %lane = kernel.workitem.id<x> : index
  %token_count = config.get @id4.ideogram4.linear_bias.token_count : index
  %input_size_unaligned = config.get @id4.ideogram4.linear_bias.input_size : index
  %input_size = index.assume %input_size_unaligned [mul(%input_size_unaligned, 4)] : index
  %output_size = config.get @id4.ideogram4.linear_bias.output_size : index
  %zero_f32 = scalar.constant 0.0 : f32

  %input_noalias, %weight_noalias, %bias_noalias, %output_noalias = buffer.assume.noalias %input, %weight, %bias, %output : buffer, buffer, buffer, buffer
  %input_global = buffer.assume.memory_space<global> %input_noalias : buffer
  %weight_global = buffer.assume.memory_space<global> %weight_noalias : buffer
  %bias_global = buffer.assume.memory_space<global> %bias_noalias : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  %input_view = buffer.view %input_global[%base] : buffer -> view<[%input_size]x[%token_count]xf32, #dense>
  %weight_view = buffer.view %weight_global[%base] : buffer -> view<[%output_size]x[%input_size]xbf16, #dense>
  %bias_view = buffer.view %bias_global[%base] : buffer -> view<[%output_size]xbf16, #dense>
  %output_view = buffer.view %output_global[%base] : buffer -> view<[%output_size]x[%token_count]xf32, #dense>

  %lane_dot = scf.for %input_row = [%lane to %input_size step %workgroup_size_x](%acc = %zero_f32 : f32) -> (f32) {
    %input_value = view.load %input_view[%input_row, %token] : view<[%input_size]x[%token_count]xf32, #dense> -> f32
    %weight_bf16 = view.load %weight_view[%output_row, %input_row] : view<[%output_size]x[%input_size]xbf16, #dense> -> bf16
    %weight_value = scalar.extf %weight_bf16 : bf16 to f32
    %product = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %input_value, %weight_value : f32
    %next = scalar.addf<reassoc|nnan|ninf|nsz> %acc, %product : f32
    scf.yield %next : f32
  }
  %dot = kernel.workgroup.reduce<addf> %lane_dot : f32
  %is_leader = index.cmp eq, %lane, %zero : index
  scf.if %is_leader {
    %bias_bf16 = view.load %bias_view[%output_row] : view<[%output_size]xbf16, #dense> -> bf16
    %bias_f32 = scalar.extf %bias_bf16 : bf16 to f32
    %value = scalar.addf<reassoc|nnan|ninf|nsz> %dot, %bias_f32 : f32
    view.store %value, %output_view[%output_row, %token] : f32, view<[%output_size]x[%token_count]xf32, #dense>
  }
  kernel.return
}

check.case public @id4_ideogram4_linear_bias_bf16_f32_small_case {
  %input = check.generate.fill value(1.0) : tensor<4x2xf32>
  %weight = check.generate.fill value(1.0) : tensor<2x4xbf16>
  %bias = check.generate.fill value(2.0) : tensor<2xbf16>
  %output = check.generate.fill value(0.0) : tensor<2x2xf32>
  %expected = check.generate.fill value(6.0) : tensor<2x2xf32>
  func.call @id4_ideogram4_linear_bias_bf16_f32(%input, %weight, %bias, %output) : (tensor<4x2xf32>, tensor<2x4xbf16>, tensor<2xbf16>, tensor<2x2xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<2x2xf32>
  check.return
}

check.case public @id4_ideogram4_linear_bias_bf16_f32_ideogram_shape_case {
  %input = check.generate.fill value(1.0) : tensor<4608x2xf32>
  %weight = check.generate.fill value(0.0) : tensor<128x4608xbf16>
  %bias = check.generate.fill value(0.0) : tensor<128xbf16>
  %output = check.generate.fill value(1.0) : tensor<128x2xf32>
  %expected = check.generate.fill value(0.0) : tensor<128x2xf32>
  func.call @id4_ideogram4_linear_bias_bf16_f32(%input, %weight, %bias, %output) : (tensor<4608x2xf32>, tensor<128x4608xbf16>, tensor<128xbf16>, tensor<128x2xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<128x2xf32>
  check.return
}

check.benchmark<@id4_ideogram4_linear_bias_bf16_f32_small_case> @id4_ideogram4_linear_bias_bf16_f32_small
check.benchmark<@id4_ideogram4_linear_bias_bf16_f32_ideogram_shape_case> @id4_ideogram4_linear_bias_bf16_f32_ideogram_shape
