check.case public @id4_parameter_fp8_e4m3_linear_rhs_tile_small_case {
  %source = check.generate.fill value(1.0) : tensor<16x16xf8E4M3>
  %target = check.generate.fill value(0.0) : tensor<256xf8E4M3>
  %decoded = check.generate.fill value(0.0) : tensor<16x16xbf16>
  %expected = check.generate.fill value(1.0) : tensor<16x16xbf16>
  func.call @id4_parameter_fp8_e4m3_linear_rhs_tile(%source, %target) : (tensor<16x16xf8E4M3>, tensor<256xf8E4M3>)
  func.call @id4_parameter_fp8_e4m3_linear_rhs_tile_decode_bf16(%target, %decoded) : (tensor<256xf8E4M3>, tensor<16x16xbf16>)
  check.expect.close actual(%decoded) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<16x16xbf16>
  check.return
}

