check.case public @id4_parameter_fp8_e4m3_scaled_to_bf16_small_case {
  %weight = check.generate.fill value(1.0) : tensor<3x4xf8E4M3>
  %scale = check.generate.fill value(2.0) : tensor<3xf32>
  %output = check.generate.fill value(0.0) : tensor<3x4xbf16>
  %expected = check.generate.fill value(2.0) : tensor<3x4xbf16>
  func.call @id4_parameter_fp8_e4m3_scaled_to_bf16(%weight, %scale, %output) : (tensor<3x4xf8E4M3>, tensor<3xf32>, tensor<3x4xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<3x4xbf16>
  check.return
}

