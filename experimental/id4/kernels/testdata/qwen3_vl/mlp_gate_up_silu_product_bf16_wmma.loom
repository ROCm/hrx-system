check.case public @id4_qwen3_vl_mlp_gate_up_silu_product_bf16_wmma_small_case {
  %input = check.generate.fill value(1.0) : tensor<32x16xbf16>
  %gate_weight = check.generate.fill value(1.0) : tensor<32x16xbf16>
  %up_weight = check.generate.fill value(2.0) : tensor<32x16xbf16>
  %output = check.generate.fill value(0.0) : tensor<32x32xbf16>
  %expected = check.generate.fill value(512.0) : tensor<32x32xbf16>
  func.call @id4_qwen3_vl_mlp_gate_up_silu_product_bf16_wmma(%input, %gate_weight, %up_weight, %output) : (tensor<32x16xbf16>, tensor<32x16xbf16>, tensor<32x16xbf16>, tensor<32x32xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.5) rtol(0.01) nan(same) : tensor<32x32xbf16>
  check.return
}

