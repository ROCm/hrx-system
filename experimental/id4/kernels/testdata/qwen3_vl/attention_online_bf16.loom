check.case public @id4_qwen3_vl_attention_online_bf16_single_token_case {
  %query = check.generate.fill value(0.0) : tensor<1x2xbf16>
  %key = check.generate.fill value(0.0) : tensor<1x2xbf16>
  %packed_value = check.generate.iota offset(3.0) step(2.0) : tensor<2x1xbf16>
  %attention_mask = check.generate.fill value(0.0) : tensor<1x1xf32>
  %output = check.generate.fill value(0.0) : tensor<1x2xbf16>
  %expected = check.generate.iota offset(3.0) step(2.0) : tensor<1x2xbf16>
  func.call @id4_qwen3_vl_attention_online_bf16(%query, %key, %packed_value, %attention_mask, %output) : (tensor<1x2xbf16>, tensor<1x2xbf16>, tensor<2x1xbf16>, tensor<1x1xf32>, tensor<1x2xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<1x2xbf16>
  check.return
}

check.case public @id4_qwen3_vl_attention_online_bf16_uniform_softmax_case {
  %query = check.generate.fill value(0.0) : tensor<2x1xbf16>
  %key = check.generate.fill value(0.0) : tensor<2x1xbf16>
  %packed_value = check.generate.iota offset(1.0) step(2.0) : tensor<1x2xbf16>
  %attention_mask = check.generate.fill value(0.0) : tensor<2x2xf32>
  %output = check.generate.fill value(0.0) : tensor<2x1xbf16>
  %expected = check.generate.fill value(2.0) : tensor<2x1xbf16>
  func.call @id4_qwen3_vl_attention_online_bf16(%query, %key, %packed_value, %attention_mask, %output) : (tensor<2x1xbf16>, tensor<2x1xbf16>, tensor<1x2xbf16>, tensor<2x2xf32>, tensor<2x1xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<2x1xbf16>
  check.return
}

