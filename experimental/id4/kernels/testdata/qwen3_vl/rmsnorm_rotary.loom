check.case public @id4_qwen3_vl_rmsnorm_rotary_bf16_identity_case {
  %input = check.generate.fill value(2.0) : tensor<1x4xbf16>
  %weight = check.generate.iota offset(0.5) step(0.5) : tensor<4xbf16>
  %output = check.generate.fill value(0.0) : tensor<1x4xbf16>
  %expected = check.generate.iota offset(0.5) step(0.5) : tensor<1x4xbf16>
  func.call @id4_qwen3_vl_rmsnorm_rotary_bf16(%input, %weight, %output) : (tensor<1x4xbf16>, tensor<4xbf16>, tensor<1x4xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(1.0000000000000001e-05) rtol(1.0000000000000001e-05) nan(same) : tensor<1x4xbf16>
  check.return
}

check.benchmark<@id4_qwen3_vl_rmsnorm_rotary_bf16_identity_case> @id4_qwen3_vl_rmsnorm_rotary_bf16_identity
