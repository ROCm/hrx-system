check.case public @id4_qwen3_vl_selected_hidden_pack_bf16_bf16_small_case {
  %hidden_states = check.generate.iota offset(1.0) step(1.0) : tensor<4x1xbf16>
  %selected_hidden_states = check.generate.fill value(0.0) : tensor<1x4xbf16>
  %expected = check.generate.iota offset(1.0) step(1.0) : tensor<1x4xbf16>
  func.call @id4_qwen3_vl_selected_hidden_pack_bf16_bf16(%hidden_states, %selected_hidden_states) : (tensor<4x1xbf16>, tensor<1x4xbf16>)
  check.expect.close actual(%selected_hidden_states) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<1x4xbf16>
  check.return
}

check.case public @id4_qwen3_vl_selected_hidden_pack_bf16_bf16_layer_major_case {
  %hidden_states = check.generate.fill value(1.0) : tensor<2x3xbf16>
  %selected_hidden_states = check.generate.fill value(0.0) : tensor<3x2xbf16>
  %expected = check.generate.fill value(1.0) : tensor<3x2xbf16>
  func.call @id4_qwen3_vl_selected_hidden_pack_bf16_bf16(%hidden_states, %selected_hidden_states) : (tensor<2x3xbf16>, tensor<3x2xbf16>)
  check.expect.close actual(%selected_hidden_states) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<3x2xbf16>
  check.return
}

check.case public @id4_qwen3_vl_selected_hidden_pack_bf16_bf16_id4_text451_case {
  %hidden_states = check.generate.fill value(0.0) : tensor<451x4096xbf16>
  %selected_hidden_states = check.generate.fill value(0.0) : tensor<53248x451xbf16>
  %expected = check.generate.fill value(0.0) : tensor<53248x451xbf16>
  func.call @id4_qwen3_vl_selected_hidden_pack_bf16_bf16(%hidden_states, %selected_hidden_states) : (tensor<451x4096xbf16>, tensor<53248x451xbf16>)
  check.expect.close actual(%selected_hidden_states) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<53248x451xbf16>
  check.return
}

check.benchmark<@id4_qwen3_vl_selected_hidden_pack_bf16_bf16_small_case> @id4_qwen3_vl_selected_hidden_pack_bf16_bf16_small

check.benchmark<@id4_qwen3_vl_selected_hidden_pack_bf16_bf16_layer_major_case> @id4_qwen3_vl_selected_hidden_pack_bf16_bf16_layer_major

