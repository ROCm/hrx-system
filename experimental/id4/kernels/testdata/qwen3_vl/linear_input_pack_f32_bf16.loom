check.case public @id4_qwen3_vl_linear_input_pack_f32_bf16_small_case {
  %input = check.generate.fill value(1.0) : tensor<3x2xf32>
  %output = check.generate.fill value(0.0) : tensor<3x2xbf16>
  %expected = check.generate.fill value(1.0) : tensor<3x2xbf16>
  func.call @id4_qwen3_vl_linear_input_pack_f32_bf16(%input, %output) : (tensor<3x2xf32>, tensor<3x2xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<3x2xbf16>
  check.return
}

check.case public @id4_qwen3_vl_linear_input_pack_f32_bf16_qwen_projection_shape_case {
  %input = check.generate.fill value(1.0) : tensor<451x4096xf32>
  %output = check.generate.fill value(0.0) : tensor<451x4096xbf16>
  %expected = check.generate.fill value(1.0) : tensor<451x4096xbf16>
  func.call @id4_qwen3_vl_linear_input_pack_f32_bf16(%input, %output) : (tensor<451x4096xf32>, tensor<451x4096xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<451x4096xbf16>
  check.return
}

