check.case public @id4_qwen3_vl_linear_input_pack_transpose_bf16_bf16_padded_case {
  %input = check.generate.fill value(0.0) : tensor<3x2xbf16>
  %output = check.generate.fill value(7.0) : tensor<2x4xbf16>
  %expected = check.generate.fill value(0.0) : tensor<2x4xbf16>
  func.call @id4_qwen3_vl_linear_input_pack_transpose_bf16_bf16(%input, %output) : (tensor<3x2xbf16>, tensor<2x4xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<2x4xbf16>
  check.return
}

