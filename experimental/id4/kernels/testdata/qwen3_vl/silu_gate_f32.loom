check.case public @id4_qwen3_vl_silu_gate_f32_small_case {
  %gate = check.generate.fill value(1.0) : tensor<2x3xf32>
  %up = check.generate.fill value(2.0) : tensor<2x3xf32>
  %output = check.generate.fill value(0.0) : tensor<2x3xf32>
  %expected = check.generate.fill value(1.4621171572600098) : tensor<2x3xf32>
  func.call @id4_qwen3_vl_silu_gate_f32(%gate, %up, %output) : (tensor<2x3xf32>, tensor<2x3xf32>, tensor<2x3xf32>)
  check.expect.close actual(%output) expected(%expected) atol(1.0000000000000001e-05) rtol(1.0000000000000001e-05) nan(same) : tensor<2x3xf32>
  check.return
}

check.case public @id4_qwen3_vl_silu_gate_bf16_small_case {
