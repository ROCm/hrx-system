  %output = check.generate.fill value(0.0) : tensor<2x3xbf16>
  %expected = check.generate.fill value(1.4609375) : tensor<2x3xbf16>
  func.call @id4_qwen3_vl_silu_gate_bf16(%gate, %up, %output) : (tensor<2x3xbf16>, tensor<2x3xbf16>, tensor<2x3xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<2x3xbf16>
  check.return
}

