check.case public @id4_qwen3_vl_linear_bf16_bf16_wmma_m16n64_small_case {
  %input = check.generate.fill value(1.0) : tensor<16x16xbf16>
  %weight = check.generate.fill value(1.0) : tensor<64x16xbf16>
  %output = check.generate.fill value(0.0) : tensor<16x64xbf16>
  %expected = check.generate.fill value(16.0) : tensor<16x64xbf16>
  func.call @id4_qwen3_vl_linear_bf16_bf16_wmma_m16n64(%input, %weight, %output) : (tensor<16x16xbf16>, tensor<64x16xbf16>, tensor<16x64xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<16x64xbf16>
  check.return
}

