check.case public @id4_qwen3_vl_linear_bf16_bf16_wmma_m32n32_compact_rhs_small_case {
  %input = check.generate.fill value(0.0078125) : tensor<32x16xbf16>
  %weight = check.generate.fill value(0.5) : tensor<512xbf16>
  %output = check.generate.fill value(0.0) : tensor<32x32xbf16>
  %expected = check.generate.fill value(0.0625) : tensor<32x32xbf16>
  func.call @id4_qwen3_vl_linear_bf16_bf16_wmma_m32n32_compact_rhs(%input, %weight, %output) : (tensor<32x16xbf16>, tensor<512xbf16>, tensor<32x32xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<32x32xbf16>
  check.return
}

