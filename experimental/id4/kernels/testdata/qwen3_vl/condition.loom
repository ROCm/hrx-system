check.case public @id4_qwen3_vl_condition_forward_f32_small_case {
  %selected_hidden_states = check.generate.fill value(1.0) : tensor<1x4xf32>
  %token_weights = check.generate.iota offset(0.5) step(0.5) : tensor<4xf32>
  %condition = check.generate.fill value(0.0) : tensor<1x4xf32>
  %stats = check.generate.fill value(0.0) : tensor<1x2xf32>
  %expected = check.generate.iota offset(0.40000000000000001) step(0.40000000000000001) : tensor<1x4xf32>
  func.call @id4_qwen3_vl_condition_apply_token_weights_f32(%selected_hidden_states, %token_weights, %condition, %stats) : (tensor<1x4xf32>, tensor<4xf32>, tensor<1x4xf32>, tensor<1x2xf32>)
  func.call @id4_qwen3_vl_condition_reduce_token_weight_stats_f32(%stats) : (tensor<1x2xf32>)
  func.call @id4_qwen3_vl_condition_normalize_token_weights_f32(%condition, %stats) : (tensor<1x4xf32>, tensor<1x2xf32>)
  check.expect.close actual(%condition) expected(%expected) atol(0.0001) rtol(0.0001) nan(same) : tensor<1x4xf32>
  check.return
}

