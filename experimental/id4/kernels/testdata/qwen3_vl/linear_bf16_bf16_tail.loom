check.case public @id4_qwen3_vl_linear_bf16_bf16_tail_small_case {
  %input = check.generate.fill value(1.0) : tensor<2x4xbf16>
  %weight = check.generate.fill value(1.0) : tensor<2x4xbf16>
  %output = check.generate.fill value(0.0) : tensor<2x2xbf16>
  %expected = check.generate.fill value(4.0) : tensor<2x2xbf16>
  func.call @id4_qwen3_vl_linear_bf16_bf16_tail(%input, %weight, %output) : (tensor<2x4xbf16>, tensor<2x4xbf16>, tensor<2x2xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<2x2xbf16>
  check.return
}

check.benchmark<@id4_qwen3_vl_linear_bf16_bf16_tail_small_case> @id4_qwen3_vl_linear_bf16_bf16_tail_small
