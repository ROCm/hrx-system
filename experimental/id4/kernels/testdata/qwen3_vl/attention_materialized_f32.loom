  %value = check.generate.fill value(7.0) : tensor<2x1xbf16>
  %output = check.generate.fill value(1.0) : tensor<4x1xbf16>
  %expected = check.generate.fill value(0.0) : tensor<4x1xbf16>
  func.call @id4_qwen3_vl_attention_pv_bf16(%probabilities, %value, %output) : (tensor<1x2x2xbf16>, tensor<2x1xbf16>, tensor<4x1xbf16>)
