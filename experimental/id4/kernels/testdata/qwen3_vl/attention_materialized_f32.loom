check.case public @id4_qwen3_vl_attention_materialized_f32_single_token_case {
  %query = check.generate.fill value(0.0) : tensor<1x2xf32>
  %key = check.generate.fill value(0.0) : tensor<1x2xf32>
  %value = check.generate.iota offset(3.0) step(2.0) : tensor<1x2xf32>
  %attention_mask = check.generate.fill value(0.0) : tensor<1x1xf32>
  %scores = check.generate.fill value(0.0) : tensor<1x1x1xf32>
  %probabilities = check.generate.fill value(0.0) : tensor<1x1x1xf32>
  %output = check.generate.fill value(0.0) : tensor<1x2xf32>
  func.call @id4_qwen3_vl_attention_scores_f32(%query, %key, %attention_mask, %scores) : (tensor<1x2xf32>, tensor<1x2xf32>, tensor<1x1xf32>, tensor<1x1x1xf32>)
  func.call @id4_qwen3_vl_attention_softmax_f32(%scores, %probabilities) : (tensor<1x1x1xf32>, tensor<1x1x1xf32>)
  func.call @id4_qwen3_vl_attention_pv_f32(%probabilities, %value, %output) : (tensor<1x1x1xf32>, tensor<1x2xf32>, tensor<1x2xf32>)
  check.expect.close actual(%output) expected(%value) atol(0.0) rtol(0.0) nan(same) : tensor<1x2xf32>
  check.return
}

