  %attention_mask = check.generate.fill value(0.0) : tensor<2x2xf32>
  %scores = check.generate.fill value(0.0) : tensor<1x2x2xf32>
  %probabilities = check.generate.fill value(0.0) : tensor<1x2x2xf32>
  %output = check.generate.fill value(0.0) : tensor<2x1xf32>
  %expected = check.generate.fill value(2.0) : tensor<2x1xf32>
  func.call @id4_qwen3_vl_attention_scores_f32(%query, %key, %attention_mask, %scores) : (tensor<2x1xf32>, tensor<2x1xf32>, tensor<2x2xf32>, tensor<1x2x2xf32>)
  func.call @id4_qwen3_vl_attention_softmax_f32(%scores, %probabilities) : (tensor<1x2x2xf32>, tensor<1x2x2xf32>)
  func.call @id4_qwen3_vl_attention_pv_f32(%probabilities, %value, %output) : (tensor<1x2x2xf32>, tensor<2x1xf32>, tensor<2x1xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0001) rtol(0.0001) nan(same) : tensor<2x1xf32>
  check.return
}

