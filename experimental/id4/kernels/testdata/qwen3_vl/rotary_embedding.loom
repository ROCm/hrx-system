  %input = check.generate.iota offset(1.0) step(1.0) : tensor<1x1024xf32>
  %output = check.generate.fill value(0.0) : tensor<1x1024xf32>
  func.call @id4_qwen3_vl_rotary_embedding_f32(%input, %output) : (tensor<1x1024xf32>, tensor<1x1024xf32>)
  check.expect.close actual(%output) expected(%input) atol(0.0) rtol(0.0) nan(same) : tensor<1x1024xf32>
