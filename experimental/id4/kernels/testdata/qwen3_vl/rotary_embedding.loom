check.case public @id4_qwen3_vl_rotary_embedding_f32_qwen_slice_case {
  %input = check.generate.fill value(3.0) : tensor<64x4096xf32>
  %output = check.generate.fill value(0.0) : tensor<64x4096xf32>
  func.call @id4_qwen3_vl_rotary_embedding_f32(%input, %output) : (tensor<64x4096xf32>, tensor<64x4096xf32>)
  check.return
}

check.benchmark<@id4_qwen3_vl_rotary_embedding_f32_identity_case> @id4_qwen3_vl_rotary_embedding_f32_identity

check.benchmark<@id4_qwen3_vl_rotary_embedding_bf16_identity_case> @id4_qwen3_vl_rotary_embedding_bf16_identity

check.benchmark<@id4_qwen3_vl_rotary_embedding_f32_qwen_key_identity_case> @id4_qwen3_vl_rotary_embedding_f32_qwen_key_identity

