check.case public @id4_qwen3_vl_rotary_embedding_f32_identity_case {
  %input = check.generate.iota offset(1.0) step(1.0) : tensor<1x4xf32>
  %output = check.generate.fill value(0.0) : tensor<1x4xf32>
  func.call @id4_qwen3_vl_rotary_embedding_f32(%input, %output) : (tensor<1x4xf32>, tensor<1x4xf32>)
  check.expect.close actual(%output) expected(%input) atol(0.0) rtol(0.0) nan(same) : tensor<1x4xf32>
  check.return
}

check.case public @id4_qwen3_vl_rotary_embedding_bf16_identity_case {
  %input = check.generate.iota offset(1.0) step(1.0) : tensor<1x4xbf16>
  %output = check.generate.fill value(0.0) : tensor<1x4xbf16>
  func.call @id4_qwen3_vl_rotary_embedding_bf16(%input, %output) : (tensor<1x4xbf16>, tensor<1x4xbf16>)
  check.expect.close actual(%output) expected(%input) atol(0.0) rtol(0.0) nan(same) : tensor<1x4xbf16>
  check.return
}

