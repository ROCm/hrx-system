check.case public @id4_qwen3_vl_token_embedding_bf16_f32_small_case {
  %token_ids = check.generate.iota offset(1) step(1) : tensor<2xi32>
  %embedding = check.generate.iota offset(0.5) step(0.5) : tensor<3x4xbf16>
  %output = check.generate.fill value(0.0) : tensor<2x4xf32>
  %expected = check.generate.iota offset(2.5) step(0.5) : tensor<2x4xf32>
  func.call @id4_qwen3_vl_token_embedding_bf16_f32(%token_ids, %embedding, %output) : (tensor<2xi32>, tensor<3x4xbf16>, tensor<2x4xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<2x4xf32>
  check.return
}

