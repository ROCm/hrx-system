check.case public @id4_tensor_transpose_bf16_small_case {
  %input = check.generate.fill value(1.0) : tensor<3x2xbf16>
  %output = check.generate.fill value(0.0) : tensor<2x3xbf16>
  %expected = check.generate.fill value(1.0) : tensor<2x3xbf16>
  func.call @id4_tensor_transpose_bf16(%input, %output) : (tensor<3x2xbf16>, tensor<2x3xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<2x3xbf16>
  check.return
}

check.case public @id4_tensor_transpose_bf16_vae_value_case {
  %input = check.generate.fill value(2.0) : tensor<16x512xbf16>
  %output = check.generate.fill value(0.0) : tensor<512x16xbf16>
  %expected = check.generate.fill value(2.0) : tensor<512x16xbf16>
  func.call @id4_tensor_transpose_bf16(%input, %output) : (tensor<16x512xbf16>, tensor<512x16xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<512x16xbf16>
  check.return
}

check.benchmark<@id4_tensor_transpose_bf16_small_case> @id4_tensor_transpose_bf16_small

check.benchmark<@id4_tensor_transpose_bf16_vae_value_case> @id4_tensor_transpose_bf16_vae_value
