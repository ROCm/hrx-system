  %input = check.generate.fill value(1.0) : tensor<16384x32xbf16>
  %weight = check.generate.fill value(0.0) : tensor<32x32xbf16>
  %bias = check.generate.fill value(0.0) : tensor<32xf32>
  %output = check.generate.fill value(1.0) : tensor<16384x32xf32>
  %expected = check.generate.fill value(0.0) : tensor<16384x32xf32>
  func.call @id4_vae_conv1x1_bias_bf16_f32_wmma(%input, %weight, %bias, %output) : (tensor<16384x32xbf16>, tensor<32x32xbf16>, tensor<32xf32>, tensor<16384x32xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<16384x32xf32>
