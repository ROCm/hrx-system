check.case public @id4_vae_conv1x1_bias_bf16_wmma_small_case {
  %input = check.generate.fill value(1.0) : tensor<32x16xbf16>
  %weight = check.generate.fill value(1.0) : tensor<32x16xbf16>
  %bias = check.generate.fill value(1.0) : tensor<32xbf16>
  %output = check.generate.fill value(0.0) : tensor<32x32xbf16>
  %expected = check.generate.fill value(17.0) : tensor<32x32xbf16>
  func.call @id4_vae_conv1x1_bias_bf16_wmma(%input, %weight, %bias, %output) : (tensor<32x16xbf16>, tensor<32x16xbf16>, tensor<32xbf16>, tensor<32x32xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<32x32xbf16>
  check.return
}

check.case public @id4_vae_conv1x1_bias_bf16_wmma_flux2_post_quant_shape_case {
  %input = check.generate.fill value(1.0) : tensor<16384x32xbf16>
  %weight = check.generate.fill value(0.0) : tensor<32x32xbf16>
  %bias = check.generate.fill value(0.0) : tensor<32xbf16>
  %output = check.generate.fill value(1.0) : tensor<16384x32xbf16>
  %expected = check.generate.fill value(0.0) : tensor<16384x32xbf16>
  func.call @id4_vae_conv1x1_bias_bf16_wmma(%input, %weight, %bias, %output) : (tensor<16384x32xbf16>, tensor<32x32xbf16>, tensor<32xbf16>, tensor<16384x32xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<16384x32xbf16>
  check.return
}

