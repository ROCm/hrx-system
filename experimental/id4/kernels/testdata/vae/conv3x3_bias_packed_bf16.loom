check.case public @id4_vae_conv3x3_bias_ic4_oc16_packed_bf16_small_case {
  %input = check.generate.fill value(1.0) : tensor<2x4xbf16>
  %weight = check.generate.fill value(0.0) : tensor<4x3x3x16xbf16>
  %bias = check.generate.fill value(1.0) : tensor<16xbf16>
  %output = check.generate.fill value(0.0) : tensor<2x16xbf16>
  %expected = check.generate.fill value(1.0) : tensor<2x16xbf16>
  func.call @id4_vae_conv3x3_bias_ic4_oc16_packed_bf16(%input, %weight, %bias, %output) : (tensor<2x4xbf16>, tensor<4x3x3x16xbf16>, tensor<16xbf16>, tensor<2x16xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<2x16xbf16>
  check.return
}

check.case public @id4_vae_conv3x3_bias_add_ic4_oc16_packed_bf16_small_same_padding_case {
  %input = check.generate.fill value(1.0) : tensor<2x2x4x1xbf16>
  %weight = check.generate.fill value(1.0) : tensor<4x3x3x16xbf16>
  %bias = check.generate.fill value(1.0) : tensor<16xbf16>
  %shortcut = check.generate.fill value(3.0) : tensor<2x2x16x1xbf16>
  %output = check.generate.fill value(0.0) : tensor<2x2x16x1xbf16>
  %expected = check.generate.fill value(20.0) : tensor<2x2x16x1xbf16>
  func.call @id4_vae_conv3x3_bias_add_ic4_oc16_packed_bf16(%input, %weight, %bias, %shortcut, %output) : (tensor<2x2x4x1xbf16>, tensor<4x3x3x16xbf16>, tensor<16xbf16>, tensor<2x2x16x1xbf16>, tensor<2x2x16x1xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<2x2x16x1xbf16>
  check.return
}

check.case public @id4_vae_conv3x3_bias_ic4_oc16_packed_bf16_flux2_conv_in_shape_case {
  %input = check.generate.fill value(1.0) : tensor<16384x32xbf16>
  %weight = check.generate.fill value(0.0) : tensor<32x3x3x512xbf16>
  %bias = check.generate.fill value(0.0) : tensor<512xbf16>
  %output = check.generate.fill value(1.0) : tensor<16384x512xbf16>
  %expected = check.generate.fill value(0.0) : tensor<16384x512xbf16>
  func.call @id4_vae_conv3x3_bias_ic4_oc16_packed_bf16(%input, %weight, %bias, %output) : (tensor<16384x32xbf16>, tensor<32x3x3x512xbf16>, tensor<512xbf16>, tensor<16384x512xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<16384x512xbf16>
  check.return
}

check.case public @id4_vae_conv3x3_bias_add_ic4_oc16_packed_bf16_flux2_mid_block_shape_case {
  %input = check.generate.fill value(1.0) : tensor<128x128x512x1xbf16>
  %weight = check.generate.fill value(0.0) : tensor<512x3x3x512xbf16>
  %bias = check.generate.fill value(0.0) : tensor<512xbf16>
  %shortcut = check.generate.fill value(3.0) : tensor<128x128x512x1xbf16>
  %output = check.generate.fill value(0.0) : tensor<128x128x512x1xbf16>
  %expected = check.generate.fill value(3.0) : tensor<128x128x512x1xbf16>
  func.call @id4_vae_conv3x3_bias_add_ic4_oc16_packed_bf16(%input, %weight, %bias, %shortcut, %output) : (tensor<128x128x512x1xbf16>, tensor<512x3x3x512xbf16>, tensor<512xbf16>, tensor<128x128x512x1xbf16>, tensor<128x128x512x1xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<128x128x512x1xbf16>
  check.return
}

check.benchmark<@id4_vae_conv3x3_bias_ic4_oc16_packed_bf16_small_case> @id4_vae_conv3x3_bias_ic4_oc16_packed_bf16_small

