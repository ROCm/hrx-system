check.case public @id4_vae_tile_clear_f32_small_case {
  %target = check.generate.fill value(7.0) : tensor<4xf32>
  %expected = check.generate.fill value(0.0) : tensor<4xf32>
  func.call @id4_vae_tile_clear_f32(%target) : (tensor<4xf32>)
  check.expect.close actual(%target) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<4xf32>
  check.return
}

check.case public @id4_vae_tile_extract_f32_x_case {
  %source = check.generate.iota offset(0.0) step(1.0) : tensor<4x1x1x1xf32>
  %tile = check.generate.fill value(0.0) : tensor<2x1x1x1xf32>
  %expected = check.generate.iota offset(1.0) step(1.0) : tensor<2x1x1x1xf32>
  func.call @id4_vae_tile_extract_f32(%source, %tile) : (tensor<4x1x1x1xf32>, tensor<2x1x1x1xf32>)
  check.expect.close actual(%tile) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<2x1x1x1xf32>
  check.return
}

check.case public @id4_vae_tile_extract_f32_y_case {
  %source = check.generate.iota offset(0.0) step(1.0) : tensor<1x3x1x1xf32>
  %tile = check.generate.fill value(0.0) : tensor<1x2x1x1xf32>
  %expected = check.generate.iota offset(1.0) step(1.0) : tensor<1x2x1x1xf32>
  func.call @id4_vae_tile_extract_f32(%source, %tile) : (tensor<1x3x1x1xf32>, tensor<1x2x1x1xf32>)
  check.expect.close actual(%tile) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<1x2x1x1xf32>
  check.return
}

check.case public @id4_vae_tile_merge_f32_origin_case {
  %tile = check.generate.iota offset(1.0) step(1.0) : tensor<2x1x1x1xf32>
  %image = check.generate.fill value(0.0) : tensor<4x1x1x1xf32>
  %expected = check.file.read.npy path("vae/testdata/vae_tile_merge_f32_origin_expected.npy") : tensor<4x1x1x1xf32>
  func.call @id4_vae_tile_merge_f32(%tile, %image) : (tensor<2x1x1x1xf32>, tensor<4x1x1x1xf32>)
  check.expect.close actual(%image) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<4x1x1x1xf32>
  check.return
}

check.case public @id4_vae_tile_merge_f32_left_overlap_case {
  %tile = check.generate.fill value(2.0) : tensor<3x1x1x1xf32>
  %image = check.generate.fill value(0.0) : tensor<4x1x1x1xf32>
  %expected = check.file.read.npy path("vae/testdata/vae_tile_merge_f32_left_overlap_expected.npy") : tensor<4x1x1x1xf32>
  func.call @id4_vae_tile_merge_f32(%tile, %image) : (tensor<3x1x1x1xf32>, tensor<4x1x1x1xf32>)
  check.expect.close actual(%image) expected(%expected) atol(0.000001) rtol(0.000001) nan(same) : tensor<4x1x1x1xf32>
  check.return
}

check.benchmark<@id4_vae_tile_clear_f32_small_case> @id4_vae_tile_clear_f32_small
check.benchmark<@id4_vae_tile_extract_f32_x_case> @id4_vae_tile_extract_f32_x
check.benchmark<@id4_vae_tile_extract_f32_y_case> @id4_vae_tile_extract_f32_y
check.benchmark<@id4_vae_tile_merge_f32_origin_case> @id4_vae_tile_merge_f32_origin
check.benchmark<@id4_vae_tile_merge_f32_left_overlap_case> @id4_vae_tile_merge_f32_left_overlap
