check.case public @id4_vae_spatial_attention_vec8_bf16_single_token_case {
  %query = check.generate.fill value(0.0) : tensor<1x1x8x1xbf16>
  %key = check.generate.fill value(0.0) : tensor<1x1x8x1xbf16>
  %value = check.generate.iota offset(3.0) step(2.0) : tensor<1x1x8x1xbf16>
  %output = check.generate.fill value(0.0) : tensor<1x1x8x1xbf16>
  func.call @id4_vae_spatial_attention_vec8_bf16(%query, %key, %value, %output) : (tensor<1x1x8x1xbf16>, tensor<1x1x8x1xbf16>, tensor<1x1x8x1xbf16>, tensor<1x1x8x1xbf16>)
  check.expect.close actual(%output) expected(%value) atol(0.0) rtol(0.0) nan(same) : tensor<1x1x8x1xbf16>
  check.return
}

check.case public @id4_vae_spatial_attention_vec8_bf16_uniform_softmax_case {
  %query = check.generate.fill value(0.0) : tensor<2x1x8x1xbf16>
  %key = check.generate.fill value(0.0) : tensor<2x1x8x1xbf16>
  %value = check.generate.fill value(7.0) : tensor<2x1x8x1xbf16>
  %output = check.generate.fill value(0.0) : tensor<2x1x8x1xbf16>
  %expected = check.generate.fill value(7.0) : tensor<2x1x8x1xbf16>
  func.call @id4_vae_spatial_attention_vec8_bf16(%query, %key, %value, %output) : (tensor<2x1x8x1xbf16>, tensor<2x1x8x1xbf16>, tensor<2x1x8x1xbf16>, tensor<2x1x8x1xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<2x1x8x1xbf16>
  check.return
}

