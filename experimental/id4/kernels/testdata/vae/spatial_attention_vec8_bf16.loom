check.case public @id4_vae_spatial_attention_query2_vec8_bf16_nonuniform_equivalence_case {
  %query = check.generate.iota offset(0.0) step(0.001) : tensor<4x4x8x1xbf16>
  %key = check.generate.iota offset(0.25) step(0.001) : tensor<4x4x8x1xbf16>
  %value = check.generate.iota offset(1.0) step(0.01) : tensor<4x4x8x1xbf16>
  %reference_output = check.generate.fill value(0.0) : tensor<4x4x8x1xbf16>
  %query2_output = check.generate.fill value(0.0) : tensor<4x4x8x1xbf16>
  func.call @id4_vae_spatial_attention_vec8_bf16(%query, %key, %value, %reference_output) : (tensor<4x4x8x1xbf16>, tensor<4x4x8x1xbf16>, tensor<4x4x8x1xbf16>, tensor<4x4x8x1xbf16>)
  func.call @id4_vae_spatial_attention_query2_vec8_bf16(%query, %key, %value, %query2_output) : (tensor<4x4x8x1xbf16>, tensor<4x4x8x1xbf16>, tensor<4x4x8x1xbf16>, tensor<4x4x8x1xbf16>)
  check.expect.close actual(%query2_output) expected(%reference_output) atol(0.0) rtol(0.0) nan(same) : tensor<4x4x8x1xbf16>
  check.return
}

