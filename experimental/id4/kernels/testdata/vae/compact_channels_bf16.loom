check.case public @id4_vae_compact_channels_bf16_v8_small_case {
  %input = check.generate.fill value(2.0) : tensor<16x256xbf16>
  %output = check.generate.fill value(-1.0) : tensor<16x128xbf16>
  %expected = check.generate.fill value(2.0) : tensor<16x128xbf16>
  func.call @id4_vae_compact_channels_bf16_v8(%input, %output) : (tensor<16x256xbf16>, tensor<16x128xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<16x128xbf16>
  check.return
}

check.benchmark<@id4_vae_compact_channels_bf16_v8_small_case> @id4_vae_compact_channels_bf16_v8_small
