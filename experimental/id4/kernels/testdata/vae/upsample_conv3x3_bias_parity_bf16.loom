check.case public @id4_vae_upsample_conv3x3_bias_parity_bf16_wmma_oc64_small_shape_case {
  %parity_weight = check.generate.fill value(0.0) : tensor<4x4x64x64xbf16>
  %input = check.generate.fill value(1.0) : tensor<16x16x64x1xbf16>
  %bias = check.generate.fill value(0.0) : tensor<64xbf16>
  %parity_output = check.generate.fill value(1.0) : tensor<32x32x64x1xbf16>
  %expected = check.generate.fill value(0.0) : tensor<32x32x64x1xbf16>
  func.call @id4_vae_upsample_conv3x3_bias_parity_bf16_wmma_oc64(%input, %parity_weight, %bias, %parity_output) : (tensor<16x16x64x1xbf16>, tensor<4x4x64x64xbf16>, tensor<64xbf16>, tensor<32x32x64x1xbf16>)
  check.expect.close actual(%parity_output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<32x32x64x1xbf16>
  check.return
}

