check.case public @id4_vae_conv3x3_bias_bf16_rounded_f32_small_case {
  %input = check.generate.fill value(2.0) : tensor<1x1x4x1xbf16>
  %weight = check.generate.fill value(1.0) : tensor<3x4x3x3xbf16>
  %bias = check.generate.fill value(1.0) : tensor<3xbf16>
  %output = check.generate.fill value(0.0) : tensor<1x1x3x1xf32>
  %expected = check.generate.fill value(9.0) : tensor<1x1x3x1xf32>
  func.call @id4_vae_conv3x3_bias_bf16_rounded_f32(%input, %weight, %bias, %output) : (tensor<1x1x4x1xbf16>, tensor<3x4x3x3xbf16>, tensor<3xbf16>, tensor<1x1x3x1xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<1x1x3x1xf32>
  check.return
}

check.case public @id4_vae_conv3x3_bias_bf16_rgb_f32_matches_scalar_medium_case {
  %input = check.generate.iota offset(-1.0) step(0.00390625) : tensor<4x4x8x1xbf16>
  %weight = check.generate.iota offset(-0.125) step(0.001953125) : tensor<3x8x3x3xbf16>
  %bias = check.generate.iota offset(-0.5) step(0.25) : tensor<3xbf16>
  %scalar_output = check.generate.fill value(0.0) : tensor<4x4x3x1xf32>
  %rgb_output = check.generate.fill value(0.0) : tensor<4x4x3x1xf32>
  func.call @id4_vae_conv3x3_bias_bf16_rounded_f32(%input, %weight, %bias, %scalar_output) : (tensor<4x4x8x1xbf16>, tensor<3x8x3x3xbf16>, tensor<3xbf16>, tensor<4x4x3x1xf32>)
  func.call @id4_vae_conv3x3_bias_bf16_rgb_f32(%input, %weight, %bias, %rgb_output) : (tensor<4x4x8x1xbf16>, tensor<3x8x3x3xbf16>, tensor<3xbf16>, tensor<4x4x3x1xf32>)
  check.expect.close actual(%rgb_output) expected(%scalar_output) atol(0.0) rtol(0.0) nan(same) : tensor<4x4x3x1xf32>
  check.return
}

check.case public @id4_vae_conv3x3_bias_bf16_rgb_f32_wmma_matches_scalar_medium_case {
  %input = check.generate.iota offset(-1.0) step(0.00390625) : tensor<4x4x8x1xbf16>
  %weight = check.generate.iota offset(-0.125) step(0.001953125) : tensor<3x8x3x3xbf16>
  %bias = check.generate.iota offset(-0.5) step(0.25) : tensor<3xbf16>
  %scalar_output = check.generate.fill value(0.0) : tensor<4x4x3x1xf32>
  %wmma_output = check.generate.fill value(0.0) : tensor<4x4x3x1xf32>
  func.call @id4_vae_conv3x3_bias_bf16_rgb_f32(%input, %weight, %bias, %scalar_output) : (tensor<4x4x8x1xbf16>, tensor<3x8x3x3xbf16>, tensor<3xbf16>, tensor<4x4x3x1xf32>)
  func.call @id4_vae_conv3x3_bias_bf16_rgb_f32_wmma(%input, %weight, %bias, %wmma_output) : (tensor<4x4x8x1xbf16>, tensor<3x8x3x3xbf16>, tensor<3xbf16>, tensor<4x4x3x1xf32>)
  check.expect.close actual(%wmma_output) expected(%scalar_output) atol(1.0) rtol(0.05) nan(same) : tensor<4x4x3x1xf32>
  check.return
}

check.case public @id4_vae_conv3x3_bias_bf16_rgb_f32_flux2_final_shape_case {
  %input = check.generate.fill value(1.0) : tensor<1024x1024x128x1xbf16>
  %weight = check.generate.fill value(0.0) : tensor<3x128x3x3xbf16>
  %bias = check.generate.fill value(0.0) : tensor<3xbf16>
  %output = check.generate.fill value(1.0) : tensor<1024x1024x3x1xf32>
  %expected = check.generate.fill value(0.0) : tensor<1024x1024x3x1xf32>
  func.call @id4_vae_conv3x3_bias_bf16_rgb_f32(%input, %weight, %bias, %output) : (tensor<1024x1024x128x1xbf16>, tensor<3x128x3x3xbf16>, tensor<3xbf16>, tensor<1024x1024x3x1xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<1024x1024x3x1xf32>
  check.return
}

check.case public @id4_vae_conv3x3_bias_bf16_rgb_f32_wmma_flux2_final_shape_case {
  %input = check.generate.fill value(1.0) : tensor<1024x1024x128x1xbf16>
  %weight = check.generate.fill value(0.0) : tensor<3x128x3x3xbf16>
  %bias = check.generate.fill value(0.0) : tensor<3xbf16>
  %output = check.generate.fill value(1.0) : tensor<1024x1024x3x1xf32>
  %expected = check.generate.fill value(0.0) : tensor<1024x1024x3x1xf32>
  func.call @id4_vae_conv3x3_bias_bf16_rgb_f32_wmma(%input, %weight, %bias, %output) : (tensor<1024x1024x128x1xbf16>, tensor<3x128x3x3xbf16>, tensor<3xbf16>, tensor<1024x1024x3x1xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<1024x1024x3x1xf32>
  check.return
}

check.benchmark<@id4_vae_conv3x3_bias_bf16_rounded_f32_small_case> @id4_vae_conv3x3_bias_bf16_rounded_f32_small

check.benchmark<@id4_vae_conv3x3_bias_bf16_rgb_f32_matches_scalar_medium_case> @id4_vae_conv3x3_bias_bf16_rgb_f32_matches_scalar_medium

check.benchmark<@id4_vae_conv3x3_bias_bf16_rgb_f32_wmma_matches_scalar_medium_case> @id4_vae_conv3x3_bias_bf16_rgb_f32_wmma_matches_scalar_medium

check.benchmark<@id4_vae_conv3x3_bias_bf16_rgb_f32_flux2_final_shape_case> @id4_vae_conv3x3_bias_bf16_rgb_f32_flux2_final_shape

check.benchmark<@id4_vae_conv3x3_bias_bf16_rgb_f32_wmma_flux2_final_shape_case> @id4_vae_conv3x3_bias_bf16_rgb_f32_wmma_flux2_final_shape
