check.case public @id4_vae_upsample_conv3x3_bias_ic4_oc16_packed_2d_bf16_small_case {
  %input = check.generate.fill value(2.0) : tensor<1x1x16x1xbf16>
  %weight = check.generate.fill value(1.0) : tensor<16x3x3x16xbf16>
  %bias = check.generate.fill value(1.0) : tensor<16xbf16>
  %output = check.generate.fill value(0.0) : tensor<2x2x16x1xbf16>
  %expected = check.generate.fill value(129.0) : tensor<2x2x16x1xbf16>
  func.call @id4_vae_upsample_conv3x3_bias_ic4_oc16_packed_2d_bf16(%input, %weight, %bias, %output) : (tensor<1x1x16x1xbf16>, tensor<16x3x3x16xbf16>, tensor<16xbf16>, tensor<2x2x16x1xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<2x2x16x1xbf16>
  check.return
}

