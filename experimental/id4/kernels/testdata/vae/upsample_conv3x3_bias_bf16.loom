check.case public @id4_vae_upsample_conv3x3_bias_bf16_wmma_oc64_matches_scalar_medium_case {
  %input = check.generate.iota offset(0.0) step(0.0009765625) : tensor<4x4x64x1xbf16>
  %weight = check.generate.iota offset(0.0) step(1.52587890625e-05) : tensor<64x3x3x64xbf16>
  %bias = check.generate.iota offset(1.0) step(1.0) : tensor<64xbf16>
  %scalar_output = check.generate.fill value(0.0) : tensor<8x8x64x1xbf16>
  %wmma_output = check.generate.fill value(0.0) : tensor<8x8x64x1xbf16>
  func.call @id4_vae_upsample_conv3x3_bias_ic4_oc16_packed_2d_bf16(%input, %weight, %bias, %scalar_output) : (tensor<4x4x64x1xbf16>, tensor<64x3x3x64xbf16>, tensor<64xbf16>, tensor<8x8x64x1xbf16>)
  func.call @id4_vae_upsample_conv3x3_bias_bf16_wmma_oc64(%input, %weight, %bias, %wmma_output) : (tensor<4x4x64x1xbf16>, tensor<64x3x3x64xbf16>, tensor<64xbf16>, tensor<8x8x64x1xbf16>)
  check.expect.close actual(%wmma_output) expected(%scalar_output) atol(1.0) rtol(0.05) nan(same) : tensor<8x8x64x1xbf16>
  check.return
}

