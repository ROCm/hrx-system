  %bias = check.generate.fill value(1.0) : tensor<16xf32>
  %shortcut = check.generate.fill value(3.0) : tensor<2x2x16x1xf32>
  %output = check.generate.fill value(0.0) : tensor<2x2x16x1xf32>
  %expected = check.generate.fill value(20.0) : tensor<2x2x16x1xf32>
  func.call @id4_vae_conv3x3_bias_add_ic4_oc16_packed_f32(%input, %weight, %bias, %shortcut, %output) : (tensor<2x2x4x1xf32>, tensor<4x3x3x16xf32>, tensor<16xf32>, tensor<2x2x16x1xf32>, tensor<2x2x16x1xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<2x2x16x1xf32>
  check.return
}

