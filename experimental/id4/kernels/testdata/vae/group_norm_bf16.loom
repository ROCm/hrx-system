check.case public @id4_vae_group_norm_stats_bf16_small_case {
  %input = check.generate.fill value(1000.0) : tensor<1x1x4x1xbf16>
  %stats = check.generate.fill value(0.0) : tensor<1x1x2xf32>
  %expected = check.generate.fill value(1000.0) : tensor<1x1x2xf32>
  func.call @id4_vae_group_norm_stats_bf16(%input, %stats) : (tensor<1x1x4x1xbf16>, tensor<1x1x2xf32>)
  check.expect.close actual(%stats) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<1x1x2xf32>
  check.return
}

check.case public @id4_vae_group_norm_stats_onepass_bf16_small_case {
  %input = check.generate.fill value(1000.0) : tensor<1x1x4x1xbf16>
  %stats = check.generate.fill value(0.0) : tensor<1x1x2xf32>
  %expected = check.generate.fill value(1000.0) : tensor<1x1x2xf32>
  func.call @id4_vae_group_norm_stats_onepass_bf16(%input, %stats) : (tensor<1x1x4x1xbf16>, tensor<1x1x2xf32>)
  check.expect.close actual(%stats) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<1x1x2xf32>
  check.return
}

check.case public @id4_vae_group_norm_stats_onepass_bf16_nonuniform_equivalence_case {
  %input = check.generate.iota offset(-1.0) step(0.03125) : tensor<4x4x8x1xbf16>
  %reference_stats = check.generate.fill value(0.0) : tensor<1x2x2xf32>
  %onepass_stats = check.generate.fill value(0.0) : tensor<1x2x2xf32>
  func.call @id4_vae_group_norm_stats_bf16(%input, %reference_stats) : (tensor<4x4x8x1xbf16>, tensor<1x2x2xf32>)
  func.call @id4_vae_group_norm_stats_onepass_bf16(%input, %onepass_stats) : (tensor<4x4x8x1xbf16>, tensor<1x2x2xf32>)
  check.expect.close actual(%onepass_stats) expected(%reference_stats) atol(0.001) rtol(0.001) nan(same) : tensor<1x2x2xf32>
  check.return
}

