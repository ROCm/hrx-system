check.case public @id4_vae_spatial_attention_online_bf16_wmma_small_case {
  %query = check.generate.fill value(1.0) : tensor<16x16xbf16>
  %key = check.generate.fill value(1.0) : tensor<16x16xbf16>
  %packed_value = check.generate.fill value(2.0) : tensor<16x16xbf16>
  %output = check.generate.fill value(0.0) : tensor<16x16xbf16>
  %expected = check.generate.fill value(2.0) : tensor<16x16xbf16>
  func.call @id4_vae_spatial_attention_online_bf16_wmma(%query, %key, %packed_value, %output) : (tensor<16x16xbf16>, tensor<16x16xbf16>, tensor<16x16xbf16>, tensor<16x16xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<16x16xbf16>
  check.return
}

check.case public @id4_vae_spatial_attention_online_bf16_wmma_flux2_mid_block_shape_case {
  %query = check.generate.fill value(0.0) : tensor<16384x512xbf16>
  %key = check.generate.fill value(0.0) : tensor<16384x512xbf16>
  %packed_value = check.generate.fill value(0.0) : tensor<512x16384xbf16>
  %output = check.generate.fill value(0.0) : tensor<16384x512xbf16>
  %expected = check.generate.fill value(0.0) : tensor<16384x512xbf16>
  func.call @id4_vae_spatial_attention_online_bf16_wmma(%query, %key, %packed_value, %output) : (tensor<16384x512xbf16>, tensor<16384x512xbf16>, tensor<512x16384xbf16>, tensor<16384x512xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<16384x512xbf16>
  check.return
}

check.benchmark<@id4_vae_spatial_attention_online_bf16_wmma_small_case> @id4_vae_spatial_attention_online_bf16_wmma_small

check.benchmark<@id4_vae_spatial_attention_online_bf16_wmma_flux2_mid_block_shape_case> @id4_vae_spatial_attention_online_bf16_wmma_flux2_mid_block_shape
