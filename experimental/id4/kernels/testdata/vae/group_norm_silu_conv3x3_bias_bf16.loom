  %stats = check.generate.fill value(0.0) : tensor<1x4x2xf32>
  %weight = check.generate.fill value(1.0) : tensor<128x3x3x16xbf16>
  %bias = check.generate.fill value(0.0) : tensor<128xbf16>
  %shortcut = check.generate.fill value(3.0) : tensor<1x1x128x1xbf16>
  %output = check.generate.fill value(-1.0) : tensor<1x1x128x1xbf16>
  %expected = check.generate.fill value(11.6875) : tensor<1x1x128x1xbf16>
  func.call @id4_vae_group_norm_silu_conv3x3_bias_bf16_wmma_oc128(%input, %norm_weight, %norm_bias, %stats, %weight, %bias, %shortcut, %bias, %output) : (tensor<1x1x16x1xbf16>, tensor<16xbf16>, tensor<16xbf16>, tensor<1x4x2xf32>, tensor<128x3x3x16xbf16>, tensor<128xbf16>, tensor<1x1x128x1xbf16>, tensor<128xbf16>, tensor<1x1x128x1xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<1x1x128x1xbf16>
  check.return
}

