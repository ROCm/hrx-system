check.case public @id4_vae_group_norm_f32_small_case {
  %input = check.generate.iota offset(1.0) step(1.0) : tensor<2x1x2x1xf32>
  %weight = check.generate.fill value(1.0) : tensor<2xf32>
  %bias = check.generate.fill value(0.0) : tensor<2xf32>
  %stats = check.generate.fill value(0.0) : tensor<1x1x2xf32>
  %output = check.generate.fill value(0.0) : tensor<2x1x2x1xf32>
  %expected = check.generate.iota offset(-1.3416407864998738) step(0.89442719099991585) : tensor<2x1x2x1xf32>
  func.call @id4_vae_group_norm_stats_f32(%input, %stats) : (tensor<2x1x2x1xf32>, tensor<1x1x2xf32>)
  func.call @id4_vae_group_norm_f32(%input, %weight, %bias, %stats, %output) : (tensor<2x1x2x1xf32>, tensor<2xf32>, tensor<2xf32>, tensor<1x1x2xf32>, tensor<2x1x2x1xf32>)
  check.expect.close actual(%output) expected(%expected) atol(1.0000000000000001e-05) rtol(1.0000000000000001e-05) nan(same) : tensor<2x1x2x1xf32>
  check.return
}

