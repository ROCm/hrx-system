  func.call @id4_vae_conv3x3_bias_f32(%input, %weight, %bias, %output) : (tensor<128x128x32x1xf32>, tensor<512x32x3x3xf32>, tensor<512xf32>, tensor<128x128x512x1xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<128x128x512x1xf32>
