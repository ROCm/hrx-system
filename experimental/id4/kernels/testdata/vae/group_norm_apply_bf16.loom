check.case public @id4_vae_group_norm_silu_ic4_oc4_flat_bf16_small_case {
  %input = check.generate.fill value(0.0) : tensor<1x1x4x1xbf16>
  %weight = check.generate.fill value(1.0) : tensor<4xbf16>
  %bias = check.generate.fill value(1.0) : tensor<4xbf16>
  %stats = check.generate.fill value(0.0) : tensor<1x1x2xf32>
  %output = check.generate.fill value(0.0) : tensor<1x1x4x1xbf16>
  %expected = check.generate.fill value(0.73105857863000497) : tensor<1x1x4x1xbf16>
  func.call @id4_vae_group_norm_apply_bf16(%input, %weight, %bias, %stats, %output) : (tensor<1x1x4x1xbf16>, tensor<4xbf16>, tensor<4xbf16>, tensor<1x1x2xf32>, tensor<1x1x4x1xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<1x1x4x1xbf16>
  check.return
}

