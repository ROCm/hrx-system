check.case public @id4_vae_conv3x3_bias_bf16_wmma_matches_scalar_small_same_padding_case {
  %input = check.generate.fill value(1.0) : tensor<2x2x4x1xbf16>
  %weight = check.generate.fill value(1.0) : tensor<4x3x3x32xbf16>
  %bias = check.generate.fill value(1.0) : tensor<32xbf16>
  %scalar_output = check.generate.fill value(0.0) : tensor<2x2x32x1xbf16>
  %wmma_output = check.generate.fill value(0.0) : tensor<2x2x32x1xbf16>
  func.call @id4_vae_conv3x3_bias_ic4_oc16_packed_bf16(%input, %weight, %bias, %scalar_output) : (tensor<2x2x4x1xbf16>, tensor<4x3x3x32xbf16>, tensor<32xbf16>, tensor<2x2x32x1xbf16>)
  func.call @id4_vae_conv3x3_bias_bf16_wmma(%input, %weight, %bias, %wmma_output) : (tensor<2x2x4x1xbf16>, tensor<4x3x3x32xbf16>, tensor<32xbf16>, tensor<2x2x32x1xbf16>)
  check.expect.close actual(%wmma_output) expected(%scalar_output) atol(0.0) rtol(0.0) nan(same) : tensor<2x2x32x1xbf16>
  check.return
}

check.case public @id4_vae_conv3x3_bias_bf16_wmma_matches_scalar_medium_same_padding_case {
  %input = check.generate.iota offset(0.0) step(0.00390625) : tensor<8x8x32x1xbf16>
  %weight = check.generate.iota offset(0.0) step(1.52587890625e-05) : tensor<32x3x3x64xbf16>
  %bias = check.generate.iota offset(1.0) step(1.0) : tensor<64xbf16>
  %scalar_output = check.generate.fill value(0.0) : tensor<8x8x64x1xbf16>
  %wmma_output = check.generate.fill value(0.0) : tensor<8x8x64x1xbf16>
  func.call @id4_vae_conv3x3_bias_ic4_oc16_packed_bf16(%input, %weight, %bias, %scalar_output) : (tensor<8x8x32x1xbf16>, tensor<32x3x3x64xbf16>, tensor<64xbf16>, tensor<8x8x64x1xbf16>)
  func.call @id4_vae_conv3x3_bias_bf16_wmma(%input, %weight, %bias, %wmma_output) : (tensor<8x8x32x1xbf16>, tensor<32x3x3x64xbf16>, tensor<64xbf16>, tensor<8x8x64x1xbf16>)
  check.expect.close actual(%wmma_output) expected(%scalar_output) atol(0.25) rtol(0.01) nan(same) : tensor<8x8x64x1xbf16>
  check.return
}

check.case public @id4_vae_conv3x3_bias_add_bf16_wmma_matches_scalar_medium_same_padding_case {
  %input = check.generate.iota offset(0.0) step(0.00390625) : tensor<8x8x32x1xbf16>
  %weight = check.generate.iota offset(0.0) step(1.52587890625e-05) : tensor<32x3x3x64xbf16>
  %bias = check.generate.iota offset(1.0) step(1.0) : tensor<64xbf16>
  %shortcut = check.generate.iota offset(-0.5) step(0.001953125) : tensor<8x8x64x1xbf16>
  %scalar_output = check.generate.fill value(0.0) : tensor<8x8x64x1xbf16>
  %wmma_output = check.generate.fill value(0.0) : tensor<8x8x64x1xbf16>
  func.call @id4_vae_conv3x3_bias_add_ic4_oc16_packed_bf16(%input, %weight, %bias, %shortcut, %scalar_output) : (tensor<8x8x32x1xbf16>, tensor<32x3x3x64xbf16>, tensor<64xbf16>, tensor<8x8x64x1xbf16>, tensor<8x8x64x1xbf16>)
  func.call @id4_vae_conv3x3_bias_add_bf16_wmma(%input, %weight, %bias, %shortcut, %wmma_output) : (tensor<8x8x32x1xbf16>, tensor<32x3x3x64xbf16>, tensor<64xbf16>, tensor<8x8x64x1xbf16>, tensor<8x8x64x1xbf16>)
  check.expect.close actual(%wmma_output) expected(%scalar_output) atol(0.25) rtol(0.01) nan(same) : tensor<8x8x64x1xbf16>
  check.return
}

