check.case public @id4_elementwise_add_f32_small_case {
  %lhs = check.generate.iota offset(1.0) step(1.0) : tensor<4xf32>
  %rhs = check.generate.fill value(10.0) : tensor<4xf32>
  %output = check.generate.fill value(0.0) : tensor<4xf32>
  %expected = check.generate.iota offset(11.0) step(1.0) : tensor<4xf32>
  func.call @id4_elementwise_add_f32(%lhs, %rhs, %output) : (tensor<4xf32>, tensor<4xf32>, tensor<4xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<4xf32>
  check.return
}

check.case public @id4_elementwise_add_f32_flux2_mid_block_shape_case {
  %lhs = check.generate.fill value(1.0) : tensor<8388608xf32>
  %rhs = check.generate.fill value(2.0) : tensor<8388608xf32>
  %output = check.generate.fill value(0.0) : tensor<8388608xf32>
  %expected = check.generate.fill value(3.0) : tensor<8388608xf32>
  func.call @id4_elementwise_add_f32(%lhs, %rhs, %output) : (tensor<8388608xf32>, tensor<8388608xf32>, tensor<8388608xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<8388608xf32>
  check.return
}

check.benchmark<@id4_elementwise_add_f32_small_case> @id4_elementwise_add_f32_small
check.benchmark<@id4_elementwise_add_f32_flux2_mid_block_shape_case> @id4_elementwise_add_f32_flux2_mid_block_shape
