check.case public @id4_elementwise_add_bf16_small_case {
  %lhs = check.generate.fill value(1.0) : tensor<4xbf16>
  %rhs = check.generate.fill value(2.0) : tensor<4xbf16>
  %output = check.generate.fill value(0.0) : tensor<4xbf16>
  %expected = check.generate.fill value(3.0) : tensor<4xbf16>
  func.call @id4_elementwise_add_bf16(%lhs, %rhs, %output) : (tensor<4xbf16>, tensor<4xbf16>, tensor<4xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<4xbf16>
  check.return
}

check.case public @id4_elementwise_add_bf16_flux2_mid_block_shape_case {
  %lhs = check.generate.fill value(1.0) : tensor<8388608xbf16>
  %rhs = check.generate.fill value(2.0) : tensor<8388608xbf16>
  %output = check.generate.fill value(0.0) : tensor<8388608xbf16>
  %expected = check.generate.fill value(3.0) : tensor<8388608xbf16>
  func.call @id4_elementwise_add_bf16(%lhs, %rhs, %output) : (tensor<8388608xbf16>, tensor<8388608xbf16>, tensor<8388608xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<8388608xbf16>
  check.return
}

check.benchmark<@id4_elementwise_add_bf16_small_case> @id4_elementwise_add_bf16_small

check.benchmark<@id4_elementwise_add_bf16_flux2_mid_block_shape_case> @id4_elementwise_add_bf16_flux2_mid_block_shape
