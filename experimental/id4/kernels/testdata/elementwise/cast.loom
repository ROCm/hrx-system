check.case public @id4_elementwise_cast_f32_bf16_small_case {
  %input = check.generate.fill value(1.0) : tensor<4xf32>
  %output = check.generate.fill value(0.0) : tensor<4xbf16>
  %expected = check.generate.fill value(1.0) : tensor<4xbf16>
  func.call @id4_elementwise_cast_f32_bf16(%input, %output) : (tensor<4xf32>, tensor<4xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<4xbf16>
  check.return
}

check.case public @id4_elementwise_cast_bf16_f32_small_case {
  %input = check.generate.fill value(1.0) : tensor<4xbf16>
  %output = check.generate.fill value(0.0) : tensor<4xf32>
  %expected = check.generate.fill value(1.0) : tensor<4xf32>
  func.call @id4_elementwise_cast_bf16_f32(%input, %output) : (tensor<4xbf16>, tensor<4xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<4xf32>
  check.return
}

check.benchmark<@id4_elementwise_cast_f32_bf16_small_case> @id4_elementwise_cast_f32_bf16_small

check.benchmark<@id4_elementwise_cast_bf16_f32_small_case> @id4_elementwise_cast_bf16_f32_small
