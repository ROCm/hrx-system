check.case public @id4_ideogram4_modulated_rmsnorm_f32_small_case {
  %input = check.generate.fill value(2.0) : tensor<4x1xf32>
  %weight = check.generate.fill value(1.0) : tensor<4xbf16>
  %scale = check.generate.fill value(2.0) : tensor<4xf32>
  %output = check.generate.fill value(0.0) : tensor<4x1xf32>
  %expected = check.generate.fill value(2.0) : tensor<4x1xf32>
  func.call @id4_ideogram4_modulated_rmsnorm_f32(%input, %weight, %scale, %output) : (tensor<4x1xf32>, tensor<4xbf16>, tensor<4xf32>, tensor<4x1xf32>)
  check.expect.close actual(%output) expected(%expected) atol(1.0000000000000001e-05) rtol(1.0000000000000001e-05) nan(same) : tensor<4x1xf32>
  check.return
}

check.case public @id4_ideogram4_modulated_rmsnorm_f32_ideogram_shape_case {
  %input = check.generate.fill value(2.0) : tensor<4608x2xf32>
  %weight = check.generate.fill value(1.0) : tensor<4608xbf16>
  %scale = check.generate.fill value(1.0) : tensor<4608xf32>
  %output = check.generate.fill value(0.0) : tensor<4608x2xf32>
  %expected = check.generate.fill value(1.0) : tensor<4608x2xf32>
  func.call @id4_ideogram4_modulated_rmsnorm_f32(%input, %weight, %scale, %output) : (tensor<4608x2xf32>, tensor<4608xbf16>, tensor<4608xf32>, tensor<4608x2xf32>)
  check.expect.close actual(%output) expected(%expected) atol(1.0000000000000001e-05) rtol(1.0000000000000001e-05) nan(same) : tensor<4608x2xf32>
  check.return
}

