check.case public @id4_ideogram4_prelude_image_pack_f32_bf16_small_case {
  %input = check.generate.iota offset(1.0) step(1.0) : tensor<2x4xf32>
  %output = check.generate.fill value(0.0) : tensor<2x4xbf16>
  %expected = check.generate.iota offset(1.0) step(1.0) : tensor<2x4xbf16>
  func.call @id4_ideogram4_prelude_image_pack_f32_bf16(%input, %output) : (tensor<2x4xf32>, tensor<2x4xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<2x4xbf16>
  check.return
}

check.case public @id4_ideogram4_prelude_image_pack_f32_bf16_1024_shape_case {
  %input = check.generate.fill value(1.0) : tensor<4096x128xf32>
  %output = check.generate.fill value(0.0) : tensor<4096x128xbf16>
  %expected = check.generate.fill value(1.0) : tensor<4096x128xbf16>
  func.call @id4_ideogram4_prelude_image_pack_f32_bf16(%input, %output) : (tensor<4096x128xf32>, tensor<4096x128xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<4096x128xbf16>
  check.return
}

check.benchmark<@id4_ideogram4_prelude_image_pack_f32_bf16_small_case> @id4_ideogram4_prelude_image_pack_f32_bf16_small

check.benchmark<@id4_ideogram4_prelude_image_pack_f32_bf16_1024_shape_case> @id4_ideogram4_prelude_image_pack_f32_bf16_1024_shape
