check.case public @id4_ideogram4_linear_bias_bf16_bf16_wmma_small_case {
  %input = check.generate.fill value(1.0) : tensor<32x16xbf16>
  %weight = check.generate.fill value(1.0) : tensor<64x16xbf16>
  %bias = check.generate.fill value(1.0) : tensor<64xbf16>
  %output = check.generate.fill value(0.0) : tensor<32x64xbf16>
  %expected = check.generate.fill value(17.0) : tensor<32x64xbf16>
  func.call @id4_ideogram4_linear_bias_bf16_bf16_wmma(%input, %weight, %bias, %output) : (tensor<32x16xbf16>, tensor<64x16xbf16>, tensor<64xbf16>, tensor<32x64xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<32x64xbf16>
  check.return
}

check.case public @id4_ideogram4_linear_bias_bf16_bf16_wmma_ideogram_shape_case {
  %input = check.generate.fill value(1.0) : tensor<4096x4608xbf16>
  %weight = check.generate.fill value(0.0) : tensor<128x4608xbf16>
  %bias = check.generate.fill value(0.0) : tensor<128xbf16>
  %output = check.generate.fill value(1.0) : tensor<4096x128xbf16>
  %expected = check.generate.fill value(0.0) : tensor<4096x128xbf16>
  func.call @id4_ideogram4_linear_bias_bf16_bf16_wmma(%input, %weight, %bias, %output) : (tensor<4096x4608xbf16>, tensor<128x4608xbf16>, tensor<128xbf16>, tensor<4096x128xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<4096x128xbf16>
  check.return
}

check.benchmark<@id4_ideogram4_linear_bias_bf16_bf16_wmma_small_case> @id4_ideogram4_linear_bias_bf16_bf16_wmma_small

check.benchmark<@id4_ideogram4_linear_bias_bf16_bf16_wmma_ideogram_shape_case> @id4_ideogram4_linear_bias_bf16_bf16_wmma_ideogram_shape
