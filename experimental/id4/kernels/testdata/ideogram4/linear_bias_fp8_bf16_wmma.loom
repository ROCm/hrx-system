check.case public @id4_ideogram4_linear_bias_fp8_bf16_wmma_small_case {
  %input = check.generate.fill value(1.0) : tensor<32x16xbf16>
  %weight = check.generate.fill value(1.0) : tensor<32x16xf8E4M3>
  %scale = check.generate.fill value(2.0) : tensor<32xf32>
  %bias = check.generate.fill value(1.0) : tensor<32xbf16>
  %output = check.generate.fill value(0.0) : tensor<32x32xbf16>
  %expected = check.generate.fill value(33.0) : tensor<32x32xbf16>
  func.call @id4_ideogram4_linear_bias_fp8_bf16_wmma(%input, %weight, %scale, %bias, %output) : (tensor<32x16xbf16>, tensor<32x16xf8E4M3>, tensor<32xf32>, tensor<32xbf16>, tensor<32x32xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<32x32xbf16>
  check.return
}

check.case public @id4_ideogram4_linear_bias_fp8_bf16_wmma_bf16_scale_rounding_case {
  %input = check.generate.fill value(1.0) : tensor<32x16xbf16>
  %weight = check.generate.fill value(1.5) : tensor<32x16xf8E4M3>
  %scale = check.generate.fill value(1.0029999999999999) : tensor<32xf32>
  %bias = check.generate.fill value(1.0) : tensor<32xbf16>
  %output = check.generate.fill value(0.0) : tensor<32x32xbf16>
  %expected = check.generate.fill value(25.0) : tensor<32x32xbf16>
  func.call @id4_ideogram4_linear_bias_fp8_bf16_wmma(%input, %weight, %scale, %bias, %output) : (tensor<32x16xbf16>, tensor<32x16xf8E4M3>, tensor<32xf32>, tensor<32xbf16>, tensor<32x32xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<32x32xbf16>
  check.return
}

check.benchmark<@id4_ideogram4_linear_bias_fp8_bf16_wmma_small_case> @id4_ideogram4_linear_bias_fp8_bf16_wmma_small

