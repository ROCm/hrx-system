check.case public @id4_ideogram4_qkv_norm_rotary_f32_small_case {
  %qkv = check.generate.iota offset(1.0) step(1.0) : tensor<6x1xf32>
  %norm_q_weight = check.generate.fill value(1.0) : tensor<2xbf16>
  %norm_k_weight = check.generate.fill value(1.0) : tensor<2xbf16>
  %position_embedding = check.generate.fill value(1.0) : tensor<2x2x1x1xf32>
  %rotated_query = check.generate.fill value(0.0) : tensor<1x2xf32>
  %rotated_key = check.generate.fill value(0.0) : tensor<1x2xf16>
  %value = check.generate.fill value(0.0) : tensor<1x2xf16>
  %expected_query = check.generate.fill value(1.89736) : tensor<1x2xf32>
  %expected_key = check.generate.fill value(1.97949) : tensor<1x2xf16>
  %expected_value = check.generate.iota offset(5.0) step(1.0) : tensor<1x2xf16>
  func.call @id4_ideogram4_qkv_norm_rotary_f32(%qkv, %norm_q_weight, %norm_k_weight, %position_embedding, %rotated_query, %rotated_key, %value) : (tensor<6x1xf32>, tensor<2xbf16>, tensor<2xbf16>, tensor<2x2x1x1xf32>, tensor<1x2xf32>, tensor<1x2xf16>, tensor<1x2xf16>)
  check.expect.close actual(%rotated_query) expected(%expected_query) atol(0.0001) rtol(0.0001) nan(same) : tensor<1x2xf32>
  check.expect.close actual(%rotated_key) expected(%expected_key) atol(0.0001) rtol(0.0001) nan(same) : tensor<1x2xf16>
  check.expect.close actual(%value) expected(%expected_value) atol(0.0) rtol(0.0) nan(same) : tensor<1x2xf16>
  check.return
}

check.case public @id4_ideogram4_qkv_norm_rotary_f32_ideogram_shape_case {
  %qkv = check.generate.fill value(2.0) : tensor<13824x2xf32>
  %norm_q_weight = check.generate.fill value(1.0) : tensor<256xbf16>
  %norm_k_weight = check.generate.fill value(1.0) : tensor<256xbf16>
  %position_embedding = check.generate.fill value(1.0) : tensor<2x2x128x2xf32>
  %rotated_query = check.generate.fill value(0.0) : tensor<2x4608xf32>
  %rotated_key = check.generate.fill value(0.0) : tensor<2x4608xf16>
  %value = check.generate.fill value(0.0) : tensor<2x4608xf16>
  %expected_rotated = check.generate.fill value(2.0) : tensor<2x4608xf32>
  %expected_key = check.generate.fill value(2.0) : tensor<2x4608xf16>
  %expected_value = check.generate.fill value(2.0) : tensor<2x4608xf16>
  func.call @id4_ideogram4_qkv_norm_rotary_f32(%qkv, %norm_q_weight, %norm_k_weight, %position_embedding, %rotated_query, %rotated_key, %value) : (tensor<13824x2xf32>, tensor<256xbf16>, tensor<256xbf16>, tensor<2x2x128x2xf32>, tensor<2x4608xf32>, tensor<2x4608xf16>, tensor<2x4608xf16>)
  check.expect.close actual(%rotated_query) expected(%expected_rotated) atol(0.00005) rtol(0.00005) nan(same) : tensor<2x4608xf32>
  check.expect.close actual(%rotated_key) expected(%expected_key) atol(0.00005) rtol(0.00005) nan(same) : tensor<2x4608xf16>
  check.expect.close actual(%value) expected(%expected_value) atol(0.0) rtol(0.0) nan(same) : tensor<2x4608xf16>
  check.return
}

check.benchmark<@id4_ideogram4_qkv_norm_rotary_f32_small_case> @id4_ideogram4_qkv_norm_rotary_f32_small
check.benchmark<@id4_ideogram4_qkv_norm_rotary_f32_ideogram_shape_case> @id4_ideogram4_qkv_norm_rotary_f32_ideogram_shape
