check.case public @id4_ideogram4_unpatchify_scale_packed_bf16_small_case {
  %projected = check.generate.iota offset(1.0) step(1.0) : tensor<1x4xbf16>
  %output = check.generate.fill value(0.0) : tensor<1x1x4x1xf32>
  %expected = check.generate.iota offset(-1.0) step(-1.0) : tensor<1x1x4x1xf32>
  func.call @id4_ideogram4_unpatchify_scale_packed_bf16(%projected, %output) : (tensor<1x4xbf16>, tensor<1x1x4x1xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<1x1x4x1xf32>
  check.return
}

check.case public @id4_ideogram4_unpatchify_scale_packed_bf16_two_token_case {
  %projected = check.generate.iota offset(1.0) step(1.0) : tensor<2x4xbf16>
  %output = check.generate.fill value(0.0) : tensor<2x1x4x1xf32>
  %expected = check.generate.iota offset(-1.0) step(-1.0) : tensor<2x1x4x1xf32>
  func.call @id4_ideogram4_unpatchify_scale_packed_bf16(%projected, %output) : (tensor<2x4xbf16>, tensor<2x1x4x1xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<2x1x4x1xf32>
  check.return
}

check.benchmark<@id4_ideogram4_unpatchify_scale_packed_bf16_small_case> @id4_ideogram4_unpatchify_scale_packed_bf16_small

check.benchmark<@id4_ideogram4_unpatchify_scale_packed_bf16_two_token_case> @id4_ideogram4_unpatchify_scale_packed_bf16_two_token
