check.case public @id4_ideogram4_linear_bias_fp8_f32_small_case {
  %input = check.generate.iota offset(1.0) step(1.0) : tensor<4x3xf32>
  %weight = check.generate.fill value(1.0) : tensor<1x4xf8E4M3>
  %scale = check.generate.fill value(2.0) : tensor<1xf32>
  %bias = check.generate.fill value(2.0) : tensor<1xbf16>
  %output = check.generate.fill value(0.0) : tensor<1x2xf32>
  %expected = check.generate.iota offset(54.0) step(8.0) : tensor<1x2xf32>
  func.call @id4_ideogram4_linear_bias_fp8_f32(%input, %weight, %scale, %bias, %output) : (tensor<4x3xf32>, tensor<1x4xf8E4M3>, tensor<1xf32>, tensor<1xbf16>, tensor<1x2xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<1x2xf32>
  check.return
}

check.case public @id4_ideogram4_linear_bias_fp8_f32_ideogram_shape_case {
  %input = check.generate.fill value(1.0) : tensor<4608x2xf32>
  %weight = check.generate.fill value(0.0) : tensor<128x4608xf8E4M3>
  %scale = check.generate.fill value(1.0) : tensor<128xf32>
  %bias = check.generate.fill value(0.0) : tensor<128xbf16>
  %output = check.generate.fill value(1.0) : tensor<128x2xf32>
  %expected = check.generate.fill value(0.0) : tensor<128x2xf32>
  func.call @id4_ideogram4_linear_bias_fp8_f32(%input, %weight, %scale, %bias, %output) : (tensor<4608x2xf32>, tensor<128x4608xf8E4M3>, tensor<128xf32>, tensor<128xbf16>, tensor<128x2xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<128x2xf32>
  check.return
}

check.case public @id4_ideogram4_linear_bias_fp8_f32_bf16_scale_rounding_case {
  %input = check.generate.fill value(1.0) : tensor<16x1xf32>
  %weight = check.generate.fill value(1.5) : tensor<1x16xf8E4M3>
  %scale = check.generate.fill value(1.0029999999999999) : tensor<1xf32>
  %bias = check.generate.fill value(0.0) : tensor<1xbf16>
  %output = check.generate.fill value(0.0) : tensor<1x1xf32>
  %expected = check.generate.fill value(24.0) : tensor<1x1xf32>
  func.call @id4_ideogram4_linear_bias_fp8_f32(%input, %weight, %scale, %bias, %output) : (tensor<16x1xf32>, tensor<1x16xf8E4M3>, tensor<1xf32>, tensor<1xbf16>, tensor<1x1xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<1x1xf32>
  check.return
}

check.benchmark<@id4_ideogram4_linear_bias_fp8_f32_small_case> @id4_ideogram4_linear_bias_fp8_f32_small

check.benchmark<@id4_ideogram4_linear_bias_fp8_f32_ideogram_shape_case> @id4_ideogram4_linear_bias_fp8_f32_ideogram_shape
