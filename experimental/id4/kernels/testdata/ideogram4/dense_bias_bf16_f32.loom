check.case public @id4_ideogram4_dense_bias_bf16_f32_identity_case {
  %input = check.generate.iota offset(1.0) step(1.0) : tensor<4xf32>
  %weight = check.generate.iota offset(0.5) step(0.5) : tensor<2x4xbf16>
  %bias = check.generate.fill value(1.0) : tensor<2xbf16>
  %output = check.generate.fill value(0.0) : tensor<2xf32>
  %expected = check.generate.iota offset(16.0) step(20.0) : tensor<2xf32>
  func.call @id4_ideogram4_dense_bias_bf16_f32(%input, %weight, %bias, %output) : (tensor<4xf32>, tensor<2x4xbf16>, tensor<2xbf16>, tensor<2xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<2xf32>
  check.return
}

check.case public @id4_ideogram4_dense_bias_bf16_f32_silu_case {
  %input = check.generate.fill value(1.0) : tensor<4xf32>
  %weight = check.generate.fill value(0.0) : tensor<2x4xbf16>
  %bias = check.generate.fill value(1.0) : tensor<2xbf16>
  %output = check.generate.fill value(0.0) : tensor<2xf32>
  %expected = check.generate.fill value(0.7310585786300049) : tensor<2xf32>
  func.call @id4_ideogram4_dense_bias_bf16_f32(%input, %weight, %bias, %output) : (tensor<4xf32>, tensor<2x4xbf16>, tensor<2xbf16>, tensor<2xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.00001) rtol(0.00001) nan(same) : tensor<2xf32>
  check.return
}

check.case public @id4_ideogram4_dense_bias_bf16_f32_adaln_shape_case {
  %input = check.generate.fill value(1.0) : tensor<4608xf32>
  %weight = check.generate.fill value(0.0) : tensor<512x4608xbf16>
  %bias = check.generate.fill value(0.0) : tensor<512xbf16>
  %output = check.generate.fill value(1.0) : tensor<512xf32>
  %expected = check.generate.fill value(0.0) : tensor<512xf32>
  func.call @id4_ideogram4_dense_bias_bf16_f32(%input, %weight, %bias, %output) : (tensor<4608xf32>, tensor<512x4608xbf16>, tensor<512xbf16>, tensor<512xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<512xf32>
  check.return
}

check.case public @id4_ideogram4_dense_bias_bf16_f32_adaln_modulation_shape_case {
  %input = check.generate.fill value(1.0) : tensor<512xf32>
  %weight = check.generate.fill value(0.0) : tensor<18432x512xbf16>
  %bias = check.generate.fill value(0.0) : tensor<18432xbf16>
  %output = check.generate.fill value(1.0) : tensor<18432xf32>
  %expected = check.generate.fill value(0.0) : tensor<18432xf32>
  func.call @id4_ideogram4_dense_bias_bf16_f32(%input, %weight, %bias, %output) : (tensor<512xf32>, tensor<18432x512xbf16>, tensor<18432xbf16>, tensor<18432xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<18432xf32>
  check.return
}

check.benchmark<@id4_ideogram4_dense_bias_bf16_f32_identity_case> @id4_ideogram4_dense_bias_bf16_f32_identity
check.benchmark<@id4_ideogram4_dense_bias_bf16_f32_silu_case> @id4_ideogram4_dense_bias_bf16_f32_silu
check.benchmark<@id4_ideogram4_dense_bias_bf16_f32_adaln_shape_case> @id4_ideogram4_dense_bias_bf16_f32_adaln_shape
check.benchmark<@id4_ideogram4_dense_bias_bf16_f32_adaln_modulation_shape_case> @id4_ideogram4_dense_bias_bf16_f32_adaln_modulation_shape
