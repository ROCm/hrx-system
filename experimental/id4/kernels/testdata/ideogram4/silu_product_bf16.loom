check.case public @id4_ideogram4_silu_product_bf16_small_case {
  %gate = check.generate.fill value(1.0) : tensor<2x3xbf16>
  %up = check.generate.fill value(2.0) : tensor<2x3xbf16>
  %output = check.generate.fill value(0.0) : tensor<2x3xbf16>
  %expected = check.generate.fill value(1.4621171572600098) : tensor<2x3xbf16>
  func.call @id4_ideogram4_silu_product_bf16(%gate, %up, %output) : (tensor<2x3xbf16>, tensor<2x3xbf16>, tensor<2x3xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.01) rtol(0.01) nan(same) : tensor<2x3xbf16>
  check.return
}

check.case public @id4_ideogram4_silu_product_bf16_padded_case {
  %gate = check.generate.fill value(0.0) : tensor<4x3xbf16>
  %up = check.generate.fill value(7.0) : tensor<4x3xbf16>
  %output = check.generate.fill value(0.0) : tensor<4x3xbf16>
  %expected = check.generate.fill value(0.0) : tensor<4x3xbf16>
  func.call @id4_ideogram4_silu_product_bf16(%gate, %up, %output) : (tensor<4x3xbf16>, tensor<4x3xbf16>, tensor<4x3xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<4x3xbf16>
  check.return
}

check.case public @id4_ideogram4_silu_product_bf16_structured128_mlp_shape_case {
  %gate = check.generate.fill value(0.0) : tensor<256x12288xbf16>
  %up = check.generate.fill value(7.0) : tensor<256x12288xbf16>
  %output = check.generate.fill value(1.0) : tensor<256x12288xbf16>
  %expected = check.generate.fill value(0.0) : tensor<256x12288xbf16>
  func.call @id4_ideogram4_silu_product_bf16(%gate, %up, %output) : (tensor<256x12288xbf16>, tensor<256x12288xbf16>, tensor<256x12288xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<256x12288xbf16>
  check.return
}

check.benchmark<@id4_ideogram4_silu_product_bf16_small_case> @id4_ideogram4_silu_product_bf16_small

check.benchmark<@id4_ideogram4_silu_product_bf16_padded_case> @id4_ideogram4_silu_product_bf16_padded

check.benchmark<@id4_ideogram4_silu_product_bf16_structured128_mlp_shape_case> @id4_ideogram4_silu_product_bf16_structured128_mlp_shape
