check.case public @id4_ideogram4_linear_input_pack_f32_bf16_small_case {
  %input = check.generate.fill value(1.0) : tensor<2x3xf32>
  %output = check.generate.fill value(0.0) : tensor<3x2xbf16>
  %expected = check.generate.fill value(1.0) : tensor<3x2xbf16>
  func.call @id4_ideogram4_linear_input_pack_f32_bf16(%input, %output) : (tensor<2x3xf32>, tensor<3x2xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<3x2xbf16>
  check.return
}

check.case public @id4_ideogram4_linear_input_pack_f32_bf16_uncond_hidden_1024_shape_case {
  %input = check.generate.fill value(1.0) : tensor<4608x4096xf32>
  %output = check.generate.fill value(0.0) : tensor<4096x4608xbf16>
  %expected = check.generate.fill value(1.0) : tensor<4096x4608xbf16>
  func.call @id4_ideogram4_linear_input_pack_f32_bf16(%input, %output) : (tensor<4608x4096xf32>, tensor<4096x4608xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<4096x4608xbf16>
  check.return
}

check.case public @id4_ideogram4_linear_input_pack_f32_bf16_padded_zero_case {
  %input = check.generate.fill value(0.0) : tensor<2x3xf32>
  %output = check.generate.fill value(1.0) : tensor<4x2xbf16>
  %expected = check.generate.fill value(0.0) : tensor<4x2xbf16>
  func.call @id4_ideogram4_linear_input_pack_f32_bf16(%input, %output) : (tensor<2x3xf32>, tensor<4x2xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<4x2xbf16>
  check.return
}

check.case public @id4_ideogram4_linear_input_pack_f32_bf16_uncond_mlp_down_1024_shape_case {
  %input = check.generate.fill value(1.0) : tensor<12288x4096xf32>
  %output = check.generate.fill value(0.0) : tensor<4096x12288xbf16>
  %expected = check.generate.fill value(1.0) : tensor<4096x12288xbf16>
  func.call @id4_ideogram4_linear_input_pack_f32_bf16(%input, %output) : (tensor<12288x4096xf32>, tensor<4096x12288xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<4096x12288xbf16>
  check.return
}

check.benchmark<@id4_ideogram4_linear_input_pack_f32_bf16_small_case> @id4_ideogram4_linear_input_pack_f32_bf16_small

check.benchmark<@id4_ideogram4_linear_input_pack_f32_bf16_uncond_hidden_1024_shape_case> @id4_ideogram4_linear_input_pack_f32_bf16_uncond_hidden_1024_shape

check.benchmark<@id4_ideogram4_linear_input_pack_f32_bf16_padded_zero_case> @id4_ideogram4_linear_input_pack_f32_bf16_padded_zero

check.benchmark<@id4_ideogram4_linear_input_pack_f32_bf16_uncond_mlp_down_1024_shape_case> @id4_ideogram4_linear_input_pack_f32_bf16_uncond_mlp_down_1024_shape
