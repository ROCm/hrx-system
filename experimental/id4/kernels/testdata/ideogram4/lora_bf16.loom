check.case public @id4_ideogram4_lora_down_bf16_small_case {
  %input = check.generate.fill value(1.0) : tensor<2x4xbf16>
  %down = check.generate.fill value(0.5) : tensor<3x4xbf16>
  %low_rank = check.generate.fill value(0.0) : tensor<2x3xbf16>
  %expected = check.generate.fill value(2.0) : tensor<2x3xbf16>
  func.call @id4_ideogram4_lora_down_bf16(%input, %down, %low_rank) : (tensor<2x4xbf16>, tensor<3x4xbf16>, tensor<2x3xbf16>)
  check.expect.close actual(%low_rank) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<2x3xbf16>
  check.return
}

check.case public @id4_ideogram4_lora_up_add_bf16_small_case {
  %low_rank = check.generate.fill value(2.0) : tensor<2x4xbf16>
  %up = check.generate.fill value(0.25) : tensor<8xbf16>
  // [adapter_ordinal=0, rank_offset=1, rank=2, up_base=3].
  %segment_metadata = check.generate.iota offset(0) step(1) : tensor<4xi32>
  %strengths = check.generate.fill value(3.0) : tensor<1xf32>
  %output = check.generate.fill value(1.0) : tensor<2x2xbf16>
  %expected = check.generate.fill value(4.0) : tensor<2x2xbf16>
  func.call @id4_ideogram4_lora_up_add_bf16(%low_rank, %up, %segment_metadata, %strengths, %output) : (tensor<2x4xbf16>, tensor<8xbf16>, tensor<4xi32>, tensor<1xf32>, tensor<2x2xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<2x2xbf16>
  check.return
}

check.case public @id4_ideogram4_lora_up_add_bf16_composed_case {
  %low_rank = check.generate.fill value(2.0) : tensor<2x14xbf16>
  %up = check.generate.fill value(0.25) : tensor<14xbf16>
  // Segments [adapter=0, rank_offset=1, rank=2, up_base=3] and
  // [adapter=4, rank_offset=5, rank=6, up_base=7].
  %segment_metadata = check.generate.iota offset(0) step(1) : tensor<8xi32>
  // Strengths [-1, -0.5, 0, 0.5, 1] exercise negative and zero adapters.
  %strengths = check.generate.iota offset(-1.0) step(0.5) : tensor<5xf32>
  %output = check.generate.fill value(1.0) : tensor<2x1xbf16>
  %expected = check.generate.fill value(3.0) : tensor<2x1xbf16>
  func.call @id4_ideogram4_lora_up_add_bf16(%low_rank, %up, %segment_metadata, %strengths, %output) : (tensor<2x14xbf16>, tensor<14xbf16>, tensor<8xi32>, tensor<5xf32>, tensor<2x1xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<2x1xbf16>
  check.return
}

check.benchmark<@id4_ideogram4_lora_down_bf16_small_case> @id4_ideogram4_lora_down_bf16_small

check.benchmark<@id4_ideogram4_lora_up_add_bf16_small_case> @id4_ideogram4_lora_up_add_bf16_small

check.benchmark<@id4_ideogram4_lora_up_add_bf16_composed_case> @id4_ideogram4_lora_up_add_bf16_composed
