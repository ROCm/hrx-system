check.case public @id4_ideogram4_linear_fp8_f32_small_case {
  %input = check.generate.fill value(1.0) : tensor<16x2xf32>
  %weight = check.generate.fill value(1.0) : tensor<8x16xf8E4M3>
  %scale = check.generate.fill value(1.0) : tensor<8xf32>
  %output = check.generate.fill value(0.0) : tensor<8x2xf32>
  %expected = check.generate.fill value(16.0) : tensor<8x2xf32>
  func.call @id4_ideogram4_linear_fp8_f32(%input, %weight, %scale, %output) : (tensor<16x2xf32>, tensor<8x16xf8E4M3>, tensor<8xf32>, tensor<8x2xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<8x2xf32>
  check.return
}

