check.case public @id4_ideogram4_head_rmsnorm_f32_small_case {
  %input = check.generate.fill value(2.0) : tensor<1x4xf32>
  %weight = check.generate.fill value(1.0) : tensor<2xbf16>
  %output = check.generate.fill value(0.0) : tensor<1x4xf32>
  %expected = check.generate.fill value(1.0) : tensor<1x4xf32>
  func.call @id4_ideogram4_head_rmsnorm_f32(%input, %weight, %output) : (tensor<1x4xf32>, tensor<2xbf16>, tensor<1x4xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.00001) rtol(0.00001) nan(same) : tensor<1x4xf32>
  check.return
}

check.case public @id4_ideogram4_head_rmsnorm_f32_ideogram_shape_case {
  %input = check.generate.fill value(2.0) : tensor<2x4608xf32>
  %weight = check.generate.fill value(1.0) : tensor<256xbf16>
  %output = check.generate.fill value(0.0) : tensor<2x4608xf32>
  %expected = check.generate.fill value(1.0) : tensor<2x4608xf32>
  func.call @id4_ideogram4_head_rmsnorm_f32(%input, %weight, %output) : (tensor<2x4608xf32>, tensor<256xbf16>, tensor<2x4608xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.00001) rtol(0.00001) nan(same) : tensor<2x4608xf32>
  check.return
}

check.benchmark<@id4_ideogram4_head_rmsnorm_f32_small_case> @id4_ideogram4_head_rmsnorm_f32_small
check.benchmark<@id4_ideogram4_head_rmsnorm_f32_ideogram_shape_case> @id4_ideogram4_head_rmsnorm_f32_ideogram_shape
