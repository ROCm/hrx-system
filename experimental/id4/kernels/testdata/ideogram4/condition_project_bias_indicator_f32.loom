check.case public @id4_ideogram4_condition_project_bias_indicator_f32_small_case {
  %projected = check.generate.fill value(10.0) : tensor<2x16xf32>
  %bias = check.generate.fill value(2.0) : tensor<2xbf16>
  %image_indicator = check.generate.fill value(0) : tensor<3xi32>
  %indicator_embedding = check.generate.fill value(3.0) : tensor<2x2xbf16>
  %output = check.generate.fill value(0.0) : tensor<2x3xf32>
  %expected = check.generate.fill value(15.0) : tensor<2x3xf32>
  func.call @id4_ideogram4_condition_project_bias_indicator_f32(%projected, %bias, %image_indicator, %indicator_embedding, %output) : (tensor<2x16xf32>, tensor<2xbf16>, tensor<3xi32>, tensor<2x2xbf16>, tensor<2x3xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<2x3xf32>
  check.return
}

check.benchmark<@id4_ideogram4_condition_project_bias_indicator_f32_small_case> @id4_ideogram4_condition_project_bias_indicator_f32_small
