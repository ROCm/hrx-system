check.case public @id4_ideogram4_prelude_indicator_bf16_f32_small_case {
  %projected = check.generate.fill value(10.0) : tensor<2x2xbf16>
  %image_indicator = check.generate.fill value(1) : tensor<2xi32>
  %indicator_embedding = check.generate.fill value(3.0) : tensor<2x2xbf16>
  %output = check.generate.fill value(0.0) : tensor<2x2xf32>
  %expected = check.generate.fill value(13.0) : tensor<2x2xf32>
  func.call @id4_ideogram4_prelude_indicator_bf16_f32(%projected, %image_indicator, %indicator_embedding, %output) : (tensor<2x2xbf16>, tensor<2xi32>, tensor<2x2xbf16>, tensor<2x2xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<2x2xf32>
  check.return
}

check.case public @id4_ideogram4_prelude_indicator_bf16_f32_1024_shape_case {
  %projected = check.generate.fill value(1.0) : tensor<4096x4608xbf16>
  %image_indicator = check.generate.fill value(1) : tensor<4096xi32>
  %indicator_embedding = check.generate.fill value(2.0) : tensor<2x4608xbf16>
  %output = check.generate.fill value(0.0) : tensor<4608x4096xf32>
  %expected = check.generate.fill value(3.0) : tensor<4608x4096xf32>
  func.call @id4_ideogram4_prelude_indicator_bf16_f32(%projected, %image_indicator, %indicator_embedding, %output) : (tensor<4096x4608xbf16>, tensor<4096xi32>, tensor<2x4608xbf16>, tensor<4608x4096xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<4608x4096xf32>
  check.return
}

check.benchmark<@id4_ideogram4_prelude_indicator_bf16_f32_small_case> @id4_ideogram4_prelude_indicator_bf16_f32_small

check.benchmark<@id4_ideogram4_prelude_indicator_bf16_f32_1024_shape_case> @id4_ideogram4_prelude_indicator_bf16_f32_1024_shape
