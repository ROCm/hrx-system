check.case public @id4_ideogram4_linear_fp8_bf16_f32_wmma_small_case {
  %input = check.generate.fill value(1.0) : tensor<16x16xbf16>
  %weight = check.generate.fill value(1.0) : tensor<32x16xf8E4M3>
  %scale = check.generate.fill value(2.0) : tensor<32xf32>
  %output = check.generate.fill value(0.0) : tensor<32x16xf32>
  %expected = check.generate.fill value(32.0) : tensor<32x16xf32>
  func.call @id4_ideogram4_linear_fp8_bf16_f32_wmma(%input, %weight, %scale, %output) : (tensor<16x16xbf16>, tensor<32x16xf8E4M3>, tensor<32xf32>, tensor<32x16xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<32x16xf32>
  check.return
}

check.case public @id4_ideogram4_linear_fp8_bf16_f32_wmma_zero_case {
  %input = check.generate.fill value(1.0) : tensor<16x16xbf16>
  %weight = check.generate.fill value(0.0) : tensor<32x16xf8E4M3>
  %scale = check.generate.fill value(2.0) : tensor<32xf32>
  %output = check.generate.fill value(1.0) : tensor<32x16xf32>
  %expected = check.generate.fill value(0.0) : tensor<32x16xf32>
  func.call @id4_ideogram4_linear_fp8_bf16_f32_wmma(%input, %weight, %scale, %output) : (tensor<16x16xbf16>, tensor<32x16xf8E4M3>, tensor<32xf32>, tensor<32x16xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<32x16xf32>
  check.return
}

check.case public @id4_ideogram4_linear_fp8_bf16_f32_wmma_bf16_scale_rounding_case {
  %input = check.generate.fill value(1.0) : tensor<16x16xbf16>
  %weight = check.generate.fill value(1.5) : tensor<32x16xf8E4M3>
  %scale = check.generate.fill value(1.0029999999999999) : tensor<32xf32>
  %output = check.generate.fill value(0.0) : tensor<32x16xf32>
  %expected = check.generate.fill value(24.0) : tensor<32x16xf32>
  func.call @id4_ideogram4_linear_fp8_bf16_f32_wmma(%input, %weight, %scale, %output) : (tensor<16x16xbf16>, tensor<32x16xf8E4M3>, tensor<32xf32>, tensor<32x16xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<32x16xf32>
  check.return
}

check.case public @id4_ideogram4_linear_fp8_bf16_f32_wmma_cond_proj_128_shape_case {
  %input = check.generate.fill value(1.0) : tensor<464x53248xbf16>
  %weight = check.generate.fill value(0.0) : tensor<4608x53248xf8E4M3>
  %scale = check.generate.fill value(1.0) : tensor<4608xf32>
  %output = check.generate.fill value(1.0) : tensor<4608x464xf32>
  %expected = check.generate.fill value(0.0) : tensor<4608x464xf32>
  func.call @id4_ideogram4_linear_fp8_bf16_f32_wmma(%input, %weight, %scale, %output) : (tensor<464x53248xbf16>, tensor<4608x53248xf8E4M3>, tensor<4608xf32>, tensor<4608x464xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<4608x464xf32>
  check.return
}

check.benchmark<@id4_ideogram4_linear_fp8_bf16_f32_wmma_small_case> @id4_ideogram4_linear_fp8_bf16_f32_wmma_small

check.benchmark<@id4_ideogram4_linear_fp8_bf16_f32_wmma_zero_case> @id4_ideogram4_linear_fp8_bf16_f32_wmma_zero

check.benchmark<@id4_ideogram4_linear_fp8_bf16_f32_wmma_cond_proj_128_shape_case> @id4_ideogram4_linear_fp8_bf16_f32_wmma_cond_proj_128_shape
