check.case public @id4_ideogram4_attention_online_bf16_bf16_wmma_small_case {
  %query = check.generate.fill value(1.0) : tensor<16x512xbf16>
  %key = check.generate.fill value(1.0) : tensor<16x512xbf16>
  %value = check.generate.fill value(2.0) : tensor<16x512xbf16>
  %output = check.generate.fill value(0.0) : tensor<16x512xbf16>
  %expected = check.generate.fill value(2.0) : tensor<16x512xbf16>
  func.call @id4_ideogram4_attention_online_bf16_bf16_wmma(%query, %key, %value, %output) : (tensor<16x512xbf16>, tensor<16x512xbf16>, tensor<16x512xbf16>, tensor<16x512xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<16x512xbf16>
  check.return
}

