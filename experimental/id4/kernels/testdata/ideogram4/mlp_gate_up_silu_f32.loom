  %output = check.generate.fill value(1.0) : tensor<24x2xf32>
  %expected = check.generate.fill value(0.0) : tensor<24x2xf32>
  func.call @id4_ideogram4_mlp_gate_up_silu_f32(%input, %gate_weight, %up_weight, %output) : (tensor<16x2xf32>, tensor<24x16xbf16>, tensor<24x16xbf16>, tensor<24x2xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<24x2xf32>
  check.return
}

