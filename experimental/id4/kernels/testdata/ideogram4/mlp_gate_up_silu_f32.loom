check.case public @id4_ideogram4_mlp_gate_up_silu_f32_small_case {
  %input = check.generate.fill value(1.0) : tensor<1x2xf32>
  %gate_weight = check.generate.fill value(1.0) : tensor<3x1xbf16>
  %up_weight = check.generate.fill value(2.0) : tensor<3x1xbf16>
  %output = check.generate.fill value(0.0) : tensor<3x2xf32>
  %expected = check.generate.fill value(1.4621171572600098) : tensor<3x2xf32>
  func.call @id4_ideogram4_mlp_gate_up_silu_f32(%input, %gate_weight, %up_weight, %output) : (tensor<1x2xf32>, tensor<3x1xbf16>, tensor<3x1xbf16>, tensor<3x2xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.00001) rtol(0.00001) nan(same) : tensor<3x2xf32>
  check.return
}

