check.case public @id4_ideogram4_modulated_layernorm_f32_small_case {
  %input = check.generate.iota offset(1.0) step(1.0) : tensor<4x1xf32>
  %scale = check.generate.fill value(0.0) : tensor<4xf32>
  %output = check.generate.fill value(0.0) : tensor<4x1xf32>
  %expected = check.generate.iota offset(-1.341640249) step(0.894426833) : tensor<4x1xf32>
  func.call @id4_ideogram4_modulated_layernorm_f32(%input, %scale, %output) : (tensor<4x1xf32>, tensor<4xf32>, tensor<4x1xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.00001) rtol(0.00001) nan(same) : tensor<4x1xf32>
  check.return
}

check.case public @id4_ideogram4_modulated_layernorm_f32_ideogram_shape_case {
  %input = check.generate.fill value(2.0) : tensor<4608x2xf32>
  %scale = check.generate.fill value(0.0) : tensor<4608xf32>
  %output = check.generate.fill value(1.0) : tensor<4608x2xf32>
  %expected = check.generate.fill value(0.0) : tensor<4608x2xf32>
  func.call @id4_ideogram4_modulated_layernorm_f32(%input, %scale, %output) : (tensor<4608x2xf32>, tensor<4608xf32>, tensor<4608x2xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<4608x2xf32>
  check.return
}

check.benchmark<@id4_ideogram4_modulated_layernorm_f32_small_case> @id4_ideogram4_modulated_layernorm_f32_small
check.benchmark<@id4_ideogram4_modulated_layernorm_f32_ideogram_shape_case> @id4_ideogram4_modulated_layernorm_f32_ideogram_shape
