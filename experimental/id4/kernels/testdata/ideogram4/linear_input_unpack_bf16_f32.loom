check.case public @id4_ideogram4_linear_input_unpack_f32_f32_uncond_hidden_1024_shape_case {
  %input = check.generate.fill value(1.0) : tensor<4096x4608xf32>
  %output = check.generate.fill value(0.0) : tensor<4608x4096xf32>
  %expected = check.generate.fill value(1.0) : tensor<4608x4096xf32>
  func.call @id4_ideogram4_linear_input_unpack_f32_f32(%input, %output) : (tensor<4096x4608xf32>, tensor<4608x4096xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<4608x4096xf32>
