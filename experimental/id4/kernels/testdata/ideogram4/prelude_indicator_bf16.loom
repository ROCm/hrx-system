check.case public @id4_ideogram4_prelude_indicator_bf16_capacity_case {
  %projected = check.generate.iota offset(2.0) step(1.0) : tensor<4x2xbf16>
  %image_indicator = check.generate.fill value(0) : tensor<2xi32>
  %indicator_embedding = check.generate.fill value(0.0) : tensor<2x2xbf16>
  %output = check.generate.fill value(-1.0) : tensor<2x2xbf16>
  %expected = check.generate.iota offset(2.0) step(1.0) : tensor<2x2xbf16>
  func.call @id4_ideogram4_prelude_indicator_bf16(%projected, %image_indicator, %indicator_embedding, %output) : (tensor<4x2xbf16>, tensor<2xi32>, tensor<2x2xbf16>, tensor<2x2xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<2x2xbf16>
  check.return
}

check.case public @id4_ideogram4_prelude_indicator_bf16_rounding_case {
  %projected = check.generate.fill value(1.0) : tensor<2x2xbf16>
  %image_indicator = check.generate.fill value(1) : tensor<2xi32>
  %indicator_embedding = check.generate.fill value(0.00390625) : tensor<2x2xbf16>
  %output = check.generate.fill value(0.0) : tensor<2x2xbf16>
  %expected = check.generate.fill value(1.0) : tensor<2x2xbf16>
  func.call @id4_ideogram4_prelude_indicator_bf16(%projected, %image_indicator, %indicator_embedding, %output) : (tensor<2x2xbf16>, tensor<2xi32>, tensor<2x2xbf16>, tensor<2x2xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<2x2xbf16>
  check.return
}

check.benchmark<@id4_ideogram4_prelude_indicator_bf16_capacity_case> @id4_ideogram4_prelude_indicator_bf16_capacity

check.case public @id4_ideogram4_prelude_indicator_bf16_condition_1024_shape_case {
  %projected = check.generate.fill value(10.0) : tensor<480x4608xbf16>
  %image_indicator = check.generate.fill value(1) : tensor<451xi32>
  %indicator_embedding = check.generate.fill value(3.0) : tensor<2x4608xbf16>
  %output = check.generate.fill value(0.0) : tensor<451x4608xbf16>
  %expected = check.generate.fill value(13.0) : tensor<451x4608xbf16>
  func.call @id4_ideogram4_prelude_indicator_bf16(%projected, %image_indicator, %indicator_embedding, %output) : (tensor<480x4608xbf16>, tensor<451xi32>, tensor<2x4608xbf16>, tensor<451x4608xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<451x4608xbf16>
  check.return
}

check.benchmark<@id4_ideogram4_prelude_indicator_bf16_condition_1024_shape_case> @id4_ideogram4_prelude_indicator_bf16_condition_1024_shape

check.case public @id4_ideogram4_prelude_indicator_bf16_image_1024_shape_case {
  %projected = check.generate.fill value(10.0) : tensor<4096x4608xbf16>
  %image_indicator = check.generate.fill value(1) : tensor<4096xi32>
  %indicator_embedding = check.generate.fill value(3.0) : tensor<2x4608xbf16>
  %output = check.generate.fill value(0.0) : tensor<4096x4608xbf16>
  %expected = check.generate.fill value(13.0) : tensor<4096x4608xbf16>
  func.call @id4_ideogram4_prelude_indicator_bf16(%projected, %image_indicator, %indicator_embedding, %output) : (tensor<4096x4608xbf16>, tensor<4096xi32>, tensor<2x4608xbf16>, tensor<4096x4608xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<4096x4608xbf16>
  check.return
}

check.benchmark<@id4_ideogram4_prelude_indicator_bf16_image_1024_shape_case> @id4_ideogram4_prelude_indicator_bf16_image_1024_shape
