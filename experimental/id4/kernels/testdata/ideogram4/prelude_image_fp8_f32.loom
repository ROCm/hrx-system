check.case public @id4_ideogram4_prelude_image_fp8_f32_small_case {
  %image_tokens = check.generate.fill value(1.01) : tensor<2x4xf32>
  %weight = check.generate.fill value(1.0) : tensor<2x4xf8E4M3>
  %scale = check.generate.fill value(1.0) : tensor<2xf32>
  %bias = check.generate.fill value(2.0) : tensor<2xbf16>
  %image_indicator = check.generate.fill value(1) : tensor<2xi32>
  %indicator_embedding = check.generate.fill value(3.0) : tensor<2x2xbf16>
  %output = check.generate.fill value(0.0) : tensor<2x2xf32>
  %expected = check.generate.fill value(9.03125) : tensor<2x2xf32>
  func.call @id4_ideogram4_prelude_image_fp8_f32(%image_tokens, %weight, %scale, %bias, %image_indicator, %indicator_embedding, %output) : (tensor<2x4xf32>, tensor<2x4xf8E4M3>, tensor<2xf32>, tensor<2xbf16>, tensor<2xi32>, tensor<2x2xbf16>, tensor<2x2xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<2x2xf32>
  check.return
}

check.case public @id4_ideogram4_prelude_image_fp8_f32_zero_case {
  %image_tokens = check.generate.fill value(1.0) : tensor<2x128xf32>
  %weight = check.generate.fill value(0.0) : tensor<4608x128xf8E4M3>
  %scale = check.generate.fill value(1.0) : tensor<4608xf32>
  %bias = check.generate.fill value(0.0) : tensor<4608xbf16>
  %image_indicator = check.generate.fill value(1) : tensor<2xi32>
  %indicator_embedding = check.generate.fill value(0.0) : tensor<2x4608xbf16>
  %output = check.generate.fill value(1.0) : tensor<4608x2xf32>
  %expected = check.generate.fill value(0.0) : tensor<4608x2xf32>
  func.call @id4_ideogram4_prelude_image_fp8_f32(%image_tokens, %weight, %scale, %bias, %image_indicator, %indicator_embedding, %output) : (tensor<2x128xf32>, tensor<4608x128xf8E4M3>, tensor<4608xf32>, tensor<4608xbf16>, tensor<2xi32>, tensor<2x4608xbf16>, tensor<4608x2xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<4608x2xf32>
  check.return
}

check.case public @id4_ideogram4_prelude_image_fp8_f32_bf16_scale_rounding_case {
  %image_tokens = check.generate.fill value(1.0) : tensor<1x4xf32>
  %weight = check.generate.fill value(1.5) : tensor<2x4xf8E4M3>
  %scale = check.generate.fill value(1.0029999999999999) : tensor<2xf32>
  %bias = check.generate.fill value(0.0) : tensor<2xbf16>
  %image_indicator = check.generate.fill value(1) : tensor<1xi32>
  %indicator_embedding = check.generate.fill value(0.0) : tensor<2x2xbf16>
  %output = check.generate.fill value(0.0) : tensor<2x1xf32>
  %expected = check.generate.fill value(6.0) : tensor<2x1xf32>
  func.call @id4_ideogram4_prelude_image_fp8_f32(%image_tokens, %weight, %scale, %bias, %image_indicator, %indicator_embedding, %output) : (tensor<1x4xf32>, tensor<2x4xf8E4M3>, tensor<2xf32>, tensor<2xbf16>, tensor<1xi32>, tensor<2x2xbf16>, tensor<2x1xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<2x1xf32>
  check.return
}

check.case public @id4_ideogram4_prelude_image_fp8_f32_patchified_channel_case {
  %image_tokens = check.generate.iota offset(0.0) step(1.0) : tensor<1x128xf32>
  %weight = check.generate.fill value(1.0) : tensor<1x128xf8E4M3>
  %scale = check.generate.fill value(1.0) : tensor<1xf32>
  %bias = check.generate.fill value(0.0) : tensor<1xbf16>
  %image_indicator = check.generate.fill value(1) : tensor<1xi32>
  %indicator_embedding = check.generate.fill value(0.0) : tensor<2x1xbf16>
  %output = check.generate.fill value(0.0) : tensor<1x1xf32>
  %expected = check.generate.fill value(8128.0) : tensor<1x1xf32>
  func.call @id4_ideogram4_prelude_image_fp8_f32(%image_tokens, %weight, %scale, %bias, %image_indicator, %indicator_embedding, %output) : (tensor<1x128xf32>, tensor<1x128xf8E4M3>, tensor<1xf32>, tensor<1xbf16>, tensor<1xi32>, tensor<2x1xbf16>, tensor<1x1xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<1x1xf32>
  check.return
}

check.benchmark<@id4_ideogram4_prelude_image_fp8_f32_small_case> @id4_ideogram4_prelude_image_fp8_f32_small

check.benchmark<@id4_ideogram4_prelude_image_fp8_f32_zero_case> @id4_ideogram4_prelude_image_fp8_f32_zero

check.benchmark<@id4_ideogram4_prelude_image_fp8_f32_patchified_channel_case> @id4_ideogram4_prelude_image_fp8_f32_patchified_channel
