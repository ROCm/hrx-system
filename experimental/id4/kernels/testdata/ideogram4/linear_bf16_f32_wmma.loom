}

check.case public @id4_ideogram4_linear_bf16_f32_wmma_layout_case {
  %input = check.generate.iota offset(0.0) step(0.00390625) : tensor<16x16xbf16>
  %weight = check.generate.iota offset(-0.5) step(0.001953125) : tensor<32x16xbf16>
  %output = check.generate.fill value(0.0) : tensor<32x16xf32>
  %expected = check.file.read.npy path("ideogram4/testdata/ideogram4_linear_bf16_f32_wmma_layout_expected.npy") : tensor<32x16xf32>
  func.call @id4_ideogram4_linear_bf16_f32_wmma(%input, %weight, %output) : (tensor<16x16xbf16>, tensor<32x16xbf16>, tensor<32x16xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.001) rtol(0.001) nan(same) : tensor<32x16xf32>
  check.return
}

