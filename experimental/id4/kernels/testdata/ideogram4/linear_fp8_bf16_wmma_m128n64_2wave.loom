check.case public @id4_ideogram4_linear_fp8_bf16_wmma_m128n64_2wave_small_case {
  %input = check.generate.fill value(1.0) : tensor<128x16xbf16>
  %weight = check.generate.fill value(1.0) : tensor<64x16xf8E4M3>
  %scale = check.generate.fill value(2.0) : tensor<64xf32>
  %output = check.generate.fill value(0.0) : tensor<128x64xbf16>
  %expected = check.generate.fill value(32.0) : tensor<128x64xbf16>
  func.call @id4_ideogram4_linear_fp8_bf16_wmma_m128n64_2wave(%input, %weight, %scale, %output) : (tensor<128x16xbf16>, tensor<64x16xf8E4M3>, tensor<64xf32>, tensor<128x64xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<128x64xbf16>
  check.return
}

