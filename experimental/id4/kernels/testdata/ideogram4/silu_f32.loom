check.case public @id4_ideogram4_silu_f32_small_case {
  %input = check.generate.fill value(1.0) : tensor<4xf32>
  %output = check.generate.fill value(0.0) : tensor<4xf32>
  %expected = check.generate.fill value(0.7310585786300049) : tensor<4xf32>
  func.call @id4_ideogram4_silu_f32(%input, %output) : (tensor<4xf32>, tensor<4xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.00001) rtol(0.00001) nan(same) : tensor<4xf32>
  check.return
}

check.case public @id4_ideogram4_silu_f32_adaln_shape_case {
  %input = check.generate.fill value(0.0) : tensor<512xf32>
  %output = check.generate.fill value(1.0) : tensor<512xf32>
  %expected = check.generate.fill value(0.0) : tensor<512xf32>
  func.call @id4_ideogram4_silu_f32(%input, %output) : (tensor<512xf32>, tensor<512xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<512xf32>
  check.return
}

check.benchmark<@id4_ideogram4_silu_f32_small_case> @id4_ideogram4_silu_f32_small
check.benchmark<@id4_ideogram4_silu_f32_adaln_shape_case> @id4_ideogram4_silu_f32_adaln_shape
