check.case public @id4_ideogram4_linear_bf16_bf16_wmma_small_case {
  %input = check.generate.fill value(1.0) : tensor<32x16xbf16>
  %weight = check.generate.fill value(1.0) : tensor<16x32xbf16>
  %output = check.generate.fill value(0.0) : tensor<32x32xbf16>
  %expected = check.generate.fill value(16.0) : tensor<32x32xbf16>
  func.call @id4_ideogram4_linear_bf16_bf16_wmma(%input, %weight, %output) : (tensor<32x16xbf16>, tensor<16x32xbf16>, tensor<32x32xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<32x32xbf16>
  check.return
}

check.case public @id4_ideogram4_linear_bf16_bf16_wmma_zero_case {
  %input = check.generate.fill value(1.0) : tensor<32x16xbf16>
  %weight = check.generate.fill value(0.0) : tensor<16x32xbf16>
  %output = check.generate.fill value(1.0) : tensor<32x32xbf16>
  %expected = check.generate.fill value(0.0) : tensor<32x32xbf16>
  func.call @id4_ideogram4_linear_bf16_bf16_wmma(%input, %weight, %output) : (tensor<32x16xbf16>, tensor<16x32xbf16>, tensor<32x32xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<32x32xbf16>
  check.return
}

check.benchmark<@id4_ideogram4_linear_bf16_bf16_wmma_small_case> @id4_ideogram4_linear_bf16_bf16_wmma_small
check.benchmark<@id4_ideogram4_linear_bf16_bf16_wmma_zero_case> @id4_ideogram4_linear_bf16_bf16_wmma_zero
