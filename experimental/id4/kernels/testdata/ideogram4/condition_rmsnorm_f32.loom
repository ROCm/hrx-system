check.case public @id4_ideogram4_condition_rmsnorm_f32_small_case {
  %input = check.generate.fill value(2.0) : tensor<4x1xf32>
  %weight = check.generate.iota offset(0.5) step(0.5) : tensor<4xbf16>
  %output = check.generate.fill value(0.0) : tensor<4x1xf32>
  %expected = check.generate.iota offset(0.5) step(0.5) : tensor<4x1xf32>
  func.call @id4_ideogram4_condition_rmsnorm_f32(%input, %weight, %output) : (tensor<4x1xf32>, tensor<4xbf16>, tensor<4x1xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.00001) rtol(0.00001) nan(same) : tensor<4x1xf32>
  check.return
}

check.case public @id4_ideogram4_condition_rmsnorm_f32_ideogram_slice_case {
  %input = check.generate.fill value(2.0) : tensor<53248x2xf32>
  %weight = check.generate.fill value(1.0) : tensor<53248xbf16>
  %output = check.generate.fill value(0.0) : tensor<53248x2xf32>
  %expected = check.generate.fill value(1.0) : tensor<53248x2xf32>
  func.call @id4_ideogram4_condition_rmsnorm_f32(%input, %weight, %output) : (tensor<53248x2xf32>, tensor<53248xbf16>, tensor<53248x2xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.00001) rtol(0.00001) nan(same) : tensor<53248x2xf32>
  check.return
}

check.benchmark<@id4_ideogram4_condition_rmsnorm_f32_small_case> @id4_ideogram4_condition_rmsnorm_f32_small
check.benchmark<@id4_ideogram4_condition_rmsnorm_f32_ideogram_slice_case> @id4_ideogram4_condition_rmsnorm_f32_ideogram_slice
