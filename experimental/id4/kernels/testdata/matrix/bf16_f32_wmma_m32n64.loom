check.case public @id4_matrix_bf16_f32_wmma_m32n64_small_case {
  %input = check.generate.fill value(1.0) : tensor<32x16xbf16>
  %weight = check.generate.fill value(1.0) : tensor<64x16xbf16>
  %output = check.generate.fill value(0.0) : tensor<32x64xf32>
  %expected = check.generate.fill value(16.0) : tensor<32x64xf32>
  func.call @id4_matrix_bf16_f32_wmma_m32n64(%input, %weight, %output) : (tensor<32x16xbf16>, tensor<64x16xbf16>, tensor<32x64xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<32x64xf32>
  check.return
}

