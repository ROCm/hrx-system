func.template<id4.attention.scaled_qk_bf16_f32.m16n16> target(@gfx1100) priority(20) @id4_attention_qk_scores_all_heads_bf16_f32_wmma_gfx1100(%query: buffer, %key: buffer, %scores: buffer, %query_tile: index, %key_tile: index, %query_head: index) {
