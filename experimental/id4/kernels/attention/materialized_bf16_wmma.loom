amdgpu.target<gfx1100> @gfx1100

config.decl @id4.attention.materialized_wmma.valid_token_count : %value: index where [range(%value, 1, 131072)]

config.decl @id4.attention.materialized_wmma.padded_token_count : %value: index where [range(%value, 16, 131072), mul(%value, 16)]

config.decl @id4.attention.materialized_wmma.query_block_offset : %value: index where [range(%value, 0, 131071), mul(%value, 16)]

config.decl @id4.attention.materialized_wmma.query_block_token_count : %value: index where [range(%value, 16, 131072), mul(%value, 16)]

config.decl @id4.attention.materialized_wmma.attention_head_count : %value: index where [range(%value, 1, 1024)]

config.decl @id4.attention.materialized_wmma.head_size : %value: index where [range(%value, 16, 1024), mul(%value, 16)]

