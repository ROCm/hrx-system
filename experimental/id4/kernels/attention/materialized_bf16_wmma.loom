} launch(%scores: buffer, %probabilities: buffer) {
  %local_query_token = kernel.workgroup.id<x> : index
  %query_head = kernel.workgroup.id<y> : index
  %lane = kernel.workitem.id<x> : index
  func.apply<id4.attention.softmax_all_heads_f32_bf16.wg256>(%scores, %probabilities, %local_query_token, %query_head, %lane) : (buffer, buffer, index, index, index)
