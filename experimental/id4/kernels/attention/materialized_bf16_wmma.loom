func.template<id4.attention.softmax_all_heads_f32_bf16.wg256> target(@gfx1100) priority(20) @id4_attention_softmax_all_heads_f32_bf16_gfx1100(%scores: buffer, %probabilities: buffer, %local_query_token: index, %query_head: index, %lane: index) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %two_bytes = index.constant 2 : offset
  %four_bytes = index.constant 4 : offset
  %workgroup_size_x = index.constant 256 : index
  %valid_token_count = config.get @id4.attention.materialized_wmma.valid_token_count : index
  %query_block_offset = config.get @id4.attention.materialized_wmma.query_block_offset : index
  %query_block_token_count = config.get @id4.attention.materialized_wmma.query_block_token_count : index
  %padded_token_count = config.get @id4.attention.materialized_wmma.padded_token_count : index
  %query_token = index.add %query_block_offset, %local_query_token : index
  %score_head_elements = index.mul %query_block_token_count, %padded_token_count : index
  %score_head_base = index.mul %query_head, %score_head_elements : index
  %scores_offset = index.scale %score_head_base, %four_bytes : index, offset -> offset
  %probabilities_offset = index.scale %score_head_base, %two_bytes : index, offset -> offset
  %zero_f32 = scalar.constant 0.0 : f32
  %one_f32 = scalar.constant 1.0 : f32
  %negative_large = scalar.constant -1000000000.0 : f32
  %scores_noalias, %probabilities_noalias = buffer.assume.noalias %scores, %probabilities : buffer, buffer
  %scores_global = buffer.assume.memory_space<global> %scores_noalias : buffer
  %probabilities_global = buffer.assume.memory_space<global> %probabilities_noalias : buffer
  %scores_view = buffer.view %scores_global[%scores_offset] : buffer -> view<[%query_block_token_count]x[%padded_token_count]xf32, #dense>
  %probabilities_view = buffer.view %probabilities_global[%probabilities_offset] : buffer -> view<[%query_block_token_count]x[%padded_token_count]xbf16, #dense>
  %query_valid = index.cmp ult, %query_token, %valid_token_count : index
  scf.if %query_valid {
    %lane_max = scf.for %key_token = [%lane to %padded_token_count step %workgroup_size_x](%current_max = %negative_large : f32) -> (f32) {
      %key_valid = index.cmp ult, %key_token, %valid_token_count : index
      %score = scf.if %key_valid -> (f32) {
        %loaded = view.load %scores_view[%local_query_token, %key_token] : view<[%query_block_token_count]x[%padded_token_count]xf32, #dense> -> f32
        scf.yield %loaded : f32
      } else {
        scf.yield %negative_large : f32
      }
      %next_max = scalar.maxnumf %current_max, %score : f32
      scf.yield %next_max : f32
    }
    %row_max = kernel.workgroup.reduce<maxnumf> %lane_max : f32
    %lane_sum = scf.for %key_token = [%lane to %padded_token_count step %workgroup_size_x](%current_sum = %zero_f32 : f32) -> (f32) {
      %key_valid = index.cmp ult, %key_token, %valid_token_count : index
      %weight = scf.if %key_valid -> (f32) {
        %score = view.load %scores_view[%local_query_token, %key_token] : view<[%query_block_token_count]x[%padded_token_count]xf32, #dense> -> f32
        %centered = scalar.subf<reassoc|nnan|ninf|nsz> %score, %row_max : f32
        %exp = scalar.expf<afn> %centered : f32
        scf.yield %exp : f32
      } else {
        scf.yield %zero_f32 : f32
      }
      %next_sum = scalar.addf<reassoc|nnan|ninf|nsz> %current_sum, %weight : f32
      scf.yield %next_sum : f32
    }
    %row_sum = kernel.workgroup.reduce<addf> %lane_sum : f32
    %inverse_sum = scalar.divf<nnan|ninf|nsz|arcp> %one_f32, %row_sum : f32
    scf.for %key_token = [%lane to %padded_token_count step %workgroup_size_x] {
      %key_valid = index.cmp ult, %key_token, %valid_token_count : index
      %probability = scf.if %key_valid -> (f32) {
        %score = view.load %scores_view[%local_query_token, %key_token] : view<[%query_block_token_count]x[%padded_token_count]xf32, #dense> -> f32
        %centered = scalar.subf<reassoc|nnan|ninf|nsz> %score, %row_max : f32
        %weight = scalar.expf<afn> %centered : f32
        %normalized = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %weight, %inverse_sum : f32
        scf.yield %normalized : f32
      } else {
        scf.yield %zero_f32 : f32
      }
      %probability_bf16 = scalar.fptrunc %probability : f32 to bf16
      view.store %probability_bf16, %probabilities_view[%local_query_token, %key_token] : bf16, view<[%query_block_token_count]x[%padded_token_count]xbf16, #dense>
    }
  } else {
    scf.for %key_token = [%lane to %padded_token_count step %workgroup_size_x] {
      %probability_bf16 = scalar.fptrunc %zero_f32 : f32 to bf16
      view.store %probability_bf16, %probabilities_view[%local_query_token, %key_token] : bf16, view<[%query_block_token_count]x[%padded_token_count]xbf16, #dense>
    }
  }
  func.return
}

