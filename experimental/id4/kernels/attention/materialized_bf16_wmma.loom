  %four_bytes = index.constant 4 : offset
  %sixteen = index.constant 16 : index
  %query_block_offset = config.get @id4.attention.materialized_wmma.query_block_offset : index
  %query_block_token_count = config.get @id4.attention.materialized_wmma.query_block_token_count : index
  %padded_token_count = config.get @id4.attention.materialized_wmma.padded_token_count : index
  %attention_head_count = config.get @id4.attention.materialized_wmma.attention_head_count : index
  %head_size = config.get @id4.attention.materialized_wmma.head_size : index
  %hidden_size = index.mul %attention_head_count, %head_size : index
  %head_base = index.mul %query_head, %head_size : index
  %head_tile_count = index.div %head_size, %sixteen : index
  %local_query_origin = index.mul %query_tile, %sixteen : index
  %query_origin = index.add %query_block_offset, %local_query_origin : index
  %key_origin = index.mul %key_tile, %sixteen : index
  %score_head_elements = index.mul %query_block_token_count, %padded_token_count : index
  %score_head_base = index.mul %query_head, %score_head_elements : index
  %scores_offset = index.scale %score_head_base, %four_bytes : index, offset -> offset
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %zero_acc = vector.constant 0.0 : vector<8xf32>
  %head_size_i32 = index.cast %head_size : index to i32
  %head_size_f32 = scalar.sitofp %head_size_i32 : i32 to f32
  %attention_scale = scalar.rsqrtf<nnan|ninf|nsz|afn> %head_size_f32 : f32
  %attention_scale_vector = vector.splat %attention_scale : vector<8xf32>
  %key_transposed_layout = encoding.layout.strided [1, %hidden_size] : encoding<layout>
  %query_noalias, %key_noalias, %scores_noalias = buffer.assume.noalias %query, %key, %scores : buffer, buffer, buffer
  %query_global = buffer.assume.memory_space<global> %query_noalias : buffer
  %key_global = buffer.assume.memory_space<global> %key_noalias : buffer
  %scores_global = buffer.assume.memory_space<global> %scores_noalias : buffer
  %query_aligned = buffer.assume.alignment %query_global {minimum_alignment = 16} : buffer
  %key_aligned = buffer.assume.alignment %key_global {minimum_alignment = 16} : buffer
  %scores_aligned = buffer.assume.alignment %scores_global {minimum_alignment = 16} : buffer
  %query_view = buffer.view %query_aligned[%base] : buffer -> view<[%padded_token_count]x[%hidden_size]xbf16, #dense>
  %key_transposed_view = buffer.view %key_aligned[%base] : buffer -> view<[%hidden_size]x[%padded_token_count]xbf16, %key_transposed_layout>
  %scores_view = buffer.view %scores_aligned[%scores_offset] : buffer -> view<[%query_block_token_count]x[%padded_token_count]xf32, #dense>
  %init = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>
  %raw_scores = scf.for %head_tile = [%zero to %head_tile_count step %one](%acc = %init : vector<8xf32>) -> (vector<8xf32>) {
    %head_tile_offset = index.mul %head_tile, %sixteen : index
    %channel_origin = index.add %head_base, %head_tile_offset : index
    %lhs = vector.fragment.load<lhs> %query_view[%query_origin, %channel_origin] shape [%m, %k] : view<[%padded_token_count]x[%hidden_size]xbf16, #dense> -> vector<16xbf16>
    %rhs = vector.fragment.load<rhs> %key_transposed_view[%channel_origin, %key_origin] shape [%k, %n] : view<[%hidden_size]x[%padded_token_count]xbf16, %key_transposed_layout> -> vector<16xbf16>
    %next = vector.mma %lhs, %rhs, %acc : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    scf.yield %next : vector<8xf32>
  }
  %scaled_scores = vector.mulf<reassoc|nnan|ninf|nsz|contract> %raw_scores, %attention_scale_vector : vector<8xf32>
  vector.fragment.store<result> %scaled_scores, %scores_view[%local_query_origin, %key_origin] shape [%m, %n] : vector<8xf32>, view<[%query_block_token_count]x[%padded_token_count]xf32, #dense>
  func.return
}

