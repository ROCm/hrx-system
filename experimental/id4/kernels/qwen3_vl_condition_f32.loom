config.decl @id4.qwen3_vl.condition.hidden_row_count : %value: index where [range(%value, 1, 65536)]
config.decl @id4.qwen3_vl.condition.token_count : %value: index where [range(%value, 1, 65536)]
config.decl @id4.qwen3_vl.condition.workgroup_size_x : %value: index where [range(%value, 1, 1024)]

kernel.def export("id4_qwen3_vl_condition_apply_token_weights_f32") @id4_qwen3_vl_condition_apply_token_weights_f32() {
  %unit = index.constant 1 : index
  %workgroup_size_x = config.get @id4.qwen3_vl.condition.workgroup_size_x : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%selected_hidden_states: buffer, %token_weights: buffer, %condition: buffer, %stats: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %lane = kernel.workitem.id<x> : index
  %hidden_row_count = config.get @id4.qwen3_vl.condition.hidden_row_count : index
  %token_count = config.get @id4.qwen3_vl.condition.token_count : index
  %workgroup_size_x = config.get @id4.qwen3_vl.condition.workgroup_size_x : index
  %element_count = index.mul %hidden_row_count, %token_count : index
  %zero_f32 = scalar.constant 0.0 : f32

  %selected_noalias, %token_weights_noalias, %condition_noalias, %stats_noalias = buffer.assume.noalias %selected_hidden_states, %token_weights, %condition, %stats : buffer, buffer, buffer, buffer
  %selected_global = buffer.assume.memory_space<global> %selected_noalias : buffer
  %token_weights_global = buffer.assume.memory_space<global> %token_weights_noalias : buffer
  %condition_global = buffer.assume.memory_space<global> %condition_noalias : buffer
  %stats_global = buffer.assume.memory_space<global> %stats_noalias : buffer
  %selected_view = buffer.view %selected_global[%base] : buffer -> view<[%hidden_row_count]x[%token_count]xf32, #dense>
  %token_weights_view = buffer.view %token_weights_global[%base] : buffer -> view<[%token_count]xf32, #dense>
  %condition_view = buffer.view %condition_global[%base] : buffer -> view<[%hidden_row_count]x[%token_count]xf32, #dense>
  %stats_view = buffer.view %stats_global[%base] : buffer -> view<2xf32, #dense>

  %original_lane_sum = scf.for %element_index = [%lane to %element_count step %workgroup_size_x](%acc = %zero_f32 : f32) -> (f32) {
    %row = index.div %element_index, %token_count : index
    %column = index.rem %element_index, %token_count : index
    %value = view.load %selected_view[%row, %column] : view<[%hidden_row_count]x[%token_count]xf32, #dense> -> f32
    %next = scalar.addf<reassoc|nnan|ninf|nsz> %acc, %value : f32
    scf.yield %next : f32
  }
  %weighted_lane_sum = scf.for %element_index = [%lane to %element_count step %workgroup_size_x](%acc = %zero_f32 : f32) -> (f32) {
    %row = index.div %element_index, %token_count : index
    %column = index.rem %element_index, %token_count : index
    %value = view.load %selected_view[%row, %column] : view<[%hidden_row_count]x[%token_count]xf32, #dense> -> f32
    %weight = view.load %token_weights_view[%column] : view<[%token_count]xf32, #dense> -> f32
    %weighted = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %value, %weight : f32
    view.store %weighted, %condition_view[%row, %column] : f32, view<[%hidden_row_count]x[%token_count]xf32, #dense>
    %next = scalar.addf<reassoc|nnan|ninf|nsz> %acc, %weighted : f32
    scf.yield %next : f32
  }
  %original_sum = kernel.workgroup.reduce<addf> %original_lane_sum : f32
  %weighted_sum = kernel.workgroup.reduce<addf> %weighted_lane_sum : f32
  %is_lane0 = index.cmp eq, %lane, %zero : index
  scf.if %is_lane0 {
    view.store %original_sum, %stats_view[%zero] : f32, view<2xf32, #dense>
    view.store %weighted_sum, %stats_view[%one] : f32, view<2xf32, #dense>
  }
  kernel.return
}

kernel.def export("id4_qwen3_vl_condition_normalize_token_weights_f32") @id4_qwen3_vl_condition_normalize_token_weights_f32() {
  %unit = index.constant 1 : index
  %hidden_row_count = config.get @id4.qwen3_vl.condition.hidden_row_count : index
  %token_count = config.get @id4.qwen3_vl.condition.token_count : index
  %workgroup_size_x = config.get @id4.qwen3_vl.condition.workgroup_size_x : index
  %element_count = index.mul %hidden_row_count, %token_count : index
  %rounding = index.sub %workgroup_size_x, %unit : index
  %rounded = index.add %element_count, %rounding : index
  %workgroups_x = index.div %rounded, %workgroup_size_x : index
  kernel.launch.config workgroups(%workgroups_x, %unit, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%condition: buffer, %stats: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %zero_f32 = scalar.constant 0.0 : f32
  %one_f32 = scalar.constant 1.0 : f32
  %workgroup = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %hidden_row_count = config.get @id4.qwen3_vl.condition.hidden_row_count : index
  %token_count = config.get @id4.qwen3_vl.condition.token_count : index
  %workgroup_size_x = config.get @id4.qwen3_vl.condition.workgroup_size_x : index
  %element_count = index.mul %hidden_row_count, %token_count : index
  %element_index = index.madd %workgroup, %workgroup_size_x, %lane : index
  %in_bounds = index.cmp ult, %element_index, %element_count : index

  %condition_noalias, %stats_noalias = buffer.assume.noalias %condition, %stats : buffer, buffer
  %condition_global = buffer.assume.memory_space<global> %condition_noalias : buffer
  %stats_global = buffer.assume.memory_space<global> %stats_noalias : buffer
  %condition_view = buffer.view %condition_global[%base] : buffer -> view<[%hidden_row_count]x[%token_count]xf32, #dense>
  %stats_view = buffer.view %stats_global[%base] : buffer -> view<2xf32, #dense>

  scf.if %in_bounds {
    %original_sum = view.load %stats_view[%zero] : view<2xf32, #dense> -> f32
    %weighted_sum = view.load %stats_view[%one] : view<2xf32, #dense> -> f32
    %original_finite = scalar.cmpf ord, %original_sum, %original_sum : f32
    %weighted_finite = scalar.cmpf ord, %weighted_sum, %weighted_sum : f32
    %weighted_nonzero = scalar.cmpf one, %weighted_sum, %zero_f32 : f32
    %scale = scf.if %original_finite -> (f32) {
      %finite_scale = scf.if %weighted_finite -> (f32) {
        %nonzero_scale = scf.if %weighted_nonzero -> (f32) {
          %computed = scalar.divf %original_sum, %weighted_sum : f32
          scf.yield %computed : f32
        } else {
          scf.yield %one_f32 : f32
        }
        scf.yield %nonzero_scale : f32
      } else {
        scf.yield %one_f32 : f32
      }
      scf.yield %finite_scale : f32
    } else {
      scf.yield %one_f32 : f32
    }
    %row = index.div %element_index, %token_count : index
    %column = index.rem %element_index, %token_count : index
    %weighted = view.load %condition_view[%row, %column] : view<[%hidden_row_count]x[%token_count]xf32, #dense> -> f32
    %value = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %weighted, %scale : f32
    view.store %value, %condition_view[%row, %column] : f32, view<[%hidden_row_count]x[%token_count]xf32, #dense>
  }
  kernel.return
}

check.case public @id4_qwen3_vl_condition_forward_f32_small_case {
  %selected_hidden_states = check.generate.fill value(1.0) : tensor<1x4xf32>
  %token_weights = check.generate.iota offset(0.5) step(0.5) : tensor<4xf32>
  %condition = check.generate.fill value(0.0) : tensor<1x4xf32>
  %stats = check.generate.fill value(0.0) : tensor<2xf32>
  %expected = check.generate.iota offset(0.4) step(0.4) : tensor<1x4xf32>
  func.call @id4_qwen3_vl_condition_apply_token_weights_f32(%selected_hidden_states, %token_weights, %condition, %stats) : (tensor<1x4xf32>, tensor<4xf32>, tensor<1x4xf32>, tensor<2xf32>)
  func.call @id4_qwen3_vl_condition_normalize_token_weights_f32(%condition, %stats) : (tensor<1x4xf32>, tensor<2xf32>)
  check.expect.close actual(%condition) expected(%expected) atol(0.0001) rtol(0.0001) nan(same) : tensor<1x4xf32>
  check.return
}

check.case public @id4_qwen3_vl_condition_forward_f32_fixture_slice_case {
  %selected_hidden_states = check.generate.iota offset(1.0) step(1.0) : tensor<32x64xf32>
  %token_weights = check.generate.fill value(1.0) : tensor<64xf32>
  %condition = check.generate.fill value(0.0) : tensor<32x64xf32>
  %stats = check.generate.fill value(0.0) : tensor<2xf32>
  func.call @id4_qwen3_vl_condition_apply_token_weights_f32(%selected_hidden_states, %token_weights, %condition, %stats) : (tensor<32x64xf32>, tensor<64xf32>, tensor<32x64xf32>, tensor<2xf32>)
  func.call @id4_qwen3_vl_condition_normalize_token_weights_f32(%condition, %stats) : (tensor<32x64xf32>, tensor<2xf32>)
  check.expect.close actual(%condition) expected(%selected_hidden_states) atol(0.0) rtol(0.0) nan(same) : tensor<32x64xf32>
  check.return
}

check.benchmark<@id4_qwen3_vl_condition_forward_f32_small_case> @id4_qwen3_vl_condition_forward_f32_small
check.benchmark<@id4_qwen3_vl_condition_forward_f32_fixture_slice_case> @id4_qwen3_vl_condition_forward_f32_fixture_slice
