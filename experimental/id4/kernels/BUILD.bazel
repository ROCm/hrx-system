            "--config=id4.smoke.element_count=1",
        ],
        "source": "smoke_configured.loom",
        "target_name": "smoke_configured",
    },
    {
        "actual_case": "@id4_sampler_cfg_denoise_f32_small_case",
        "benchmark": "@id4_sampler_cfg_denoise_f32_small",
        "configs": [
            "--config=id4.sampler.element_count=257",
        ],
        "source": "sampler_cfg_denoise_f32.loom",
        "target_name": "sampler_cfg_denoise_f32_small",
    },
    {
        "actual_case": "@id4_sampler_cfg_denoise_f32_full_latent_case",
        "benchmark": "@id4_sampler_cfg_denoise_f32_full_latent",
        "configs": [
            "--config=id4.sampler.element_count=524288",
        ],
        "source": "sampler_cfg_denoise_f32.loom",
        "target_name": "sampler_cfg_denoise_f32_full_latent",
    },
    {
        "actual_case": "@id4_qwen3_vl_condition_forward_f32_small_case",
        "benchmark": "@id4_qwen3_vl_condition_forward_f32_small",
        "configs": [
