load("//build_tools/bazel:executable.bzl", "iree_executable_test")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_KERNEL_CASES = [
    {
        "actual_case": "@id4_configured_smoke_case",
        "benchmark": "@id4_configured_smoke_latency",
        "configs": [
            "--config=id4.smoke.workgroups_x=1",
            "--config=id4.smoke.workgroup_size_x=64",
        ],
        "source": "smoke_configured.loom",
        "target_name": "smoke_configured",
    },
]

exports_files([_case["source"] for _case in _KERNEL_CASES])

filegroup(
    name = "loom_sources",
    srcs = [_case["source"] for _case in _KERNEL_CASES],
)

_AMDGPU_HAL_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/execute:amdgpu_hal",
])

[
    iree_executable_test(
        name = _case["target_name"] + "_plan_test",
        src = "//loom/src/loom/tools/iree-benchmark-loom",
        args = [
            "$(location %s)" % _case["source"],
            "--benchmark=%s" % _case["benchmark"],
            "--dry-run",
            "--output-format=jsonl",
        ] + _case["configs"],
        data = [
            _case["source"],
        ],
        tags = ["hostonly"],
    )
    for _case in _KERNEL_CASES
]

[
    iree_executable_test(
        name = _case["target_name"] + "_amdgpu_test",
        src = "//loom/src/loom/tools/iree-test-loom",
        args = [
            "$(location %s)" % _case["source"],
            "--case=%s" % _case["actual_case"],
            "--device=amdgpu://0",
        ] + _case["configs"],
        data = [
            _case["source"],
        ],
        tags = [
            "iree-run-requirement=runtime.resource.amd_gpu",
            "manual",
            "requires-gpu-amd",
            "runtime-resource=amd-gpu",
        ],
        target_compatible_with = _AMDGPU_HAL_COMPATIBLE_WITH,
    )
    for _case in _KERNEL_CASES
]
