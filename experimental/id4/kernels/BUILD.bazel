    name = "loom_sources",
    srcs = _KERNEL_SOURCES,
)

iree_c_embed_data(
    name = "embedded_loom_sources",
    srcs = _KERNEL_SOURCES,
    c_file_output = "embedded_loom_sources.c",
    h_file_output = "embedded_loom_sources.h",
    identifier = "id4_kernel_embedded_loom_sources",
    strip_prefix = "experimental/id4/kernels/",
)

_HAL_EXECUTION_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/execute:amdgpu_hal",
])

_HAL_EXECUTION_DEVICE = "amdgpu://0"

[
    iree_executable_test(
        name = _case["target_name"] + "_plan_test",
        src = "//loom/src/loom/tools/iree-benchmark-loom",
        args = [
            "$(location %s)" % _case["source"],
            "--benchmark=%s" % _case["benchmark"],
            "--dry-run",
            "--output-format=jsonl",
        ] + _case["configs"],
        data = [
            _case["source"],
        ],
        tags = ["hostonly"],
    )
    for _case in _KERNEL_CASES
]

[
    iree_executable_test(
        name = _case["target_name"] + "_hal_test",
        src = "//loom/src/loom/tools/iree-test-loom",
        args = [
            "$(location %s)" % _case["source"],
            "--case=%s" % _case["actual_case"],
            "--device=%s" % _HAL_EXECUTION_DEVICE,
        ] + _case["configs"],
        data = [
            _case["source"],
        ],
        tags = [
            "iree-run-requirement=runtime.resource.amd_gpu",
            "manual",
            "requires-gpu-amd",
            "runtime-resource=amd-gpu",
        ],
        target_compatible_with = _HAL_EXECUTION_COMPATIBLE_WITH,
    )
    for _case in _KERNEL_CASES
]
