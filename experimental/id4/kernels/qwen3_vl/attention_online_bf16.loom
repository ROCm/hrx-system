kernel.def export("id4_qwen3_vl_attention_online_bf16") @id4_qwen3_vl_attention_online_bf16() {
  %unit = index.constant 1 : index
  %seven = index.constant 7 : index
  %eight = index.constant 8 : index
  %workgroup_size_x = index.constant 256 : index
