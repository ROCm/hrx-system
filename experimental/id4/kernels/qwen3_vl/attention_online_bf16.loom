  %attention_head_count = config.get @id4.qwen3_vl.attention_online.attention_head_count : index
  %rounded_token_count = index.add %token_count, %seven : index
  %query_tile_count = index.div %rounded_token_count, %eight : index
  kernel.launch.config workgroups(%query_tile_count, %attention_head_count, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%query: buffer, %key: buffer, %packed_value: buffer, %attention_mask: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %three = index.constant 3 : index
  %four = index.constant 4 : index
  %five = index.constant 5 : index
  %six = index.constant 6 : index
  %seven = index.constant 7 : index
  %eight = index.constant 8 : index
  %query_tile = kernel.workgroup.id<x> : index
  %query_head = kernel.workgroup.id<y> : index
  %lane = kernel.workitem.id<x> : index
  %zero_f32 = scalar.constant 0.0 : f32
  %negative_large = scalar.constant -1000000000.0 : f32
  %token_count = config.get @id4.qwen3_vl.attention_online.token_count : index
  %dispatch_token_count = config.get @id4.qwen3_vl.attention_online.dispatch_token_count : index
  %hidden_size = config.get @id4.qwen3_vl.attention_online.hidden_size : index
  %attention_head_count = config.get @id4.qwen3_vl.attention_online.attention_head_count : index
  %key_value_head_count = config.get @id4.qwen3_vl.attention_online.key_value_head_count : index
  %head_size = config.get @id4.qwen3_vl.attention_online.head_size : index
  %query_heads_per_key = index.div %attention_head_count, %key_value_head_count : index
  %key_value_width = index.mul %key_value_head_count, %head_size : index
  %lane_has_channel = index.cmp ult, %lane, %head_size : index
  %head_size_i32 = index.cast %head_size : index to i32
  %head_size_f32 = scalar.sitofp %head_size_i32 : i32 to f32
  %attention_scale = scalar.rsqrtf<nnan|ninf|nsz|afn> %head_size_f32 : f32
  %query_head_base = index.mul %query_head, %head_size : index
  %key_value_head = index.div %query_head, %query_heads_per_key : index
  %key_value_head_base = index.mul %key_value_head, %head_size : index
  %attention_channel = index.add %query_head_base, %lane : index
  %value_channel = index.add %key_value_head_base, %lane : index
  %query_base = index.mul %query_tile, %eight : index
  %query_token0 = index.add %query_base, %zero : index
  %query_token1 = index.add %query_base, %one : index
  %query_token2 = index.add %query_base, %two : index
  %query_token3 = index.add %query_base, %three : index
  %query_token4 = index.add %query_base, %four : index
  %query_token5 = index.add %query_base, %five : index
  %query_token6 = index.add %query_base, %six : index
  %query_token7 = index.add %query_base, %seven : index
  %query_valid0 = index.cmp ult, %query_token0, %token_count : index
  %query_valid1 = index.cmp ult, %query_token1, %token_count : index
  %query_valid2 = index.cmp ult, %query_token2, %token_count : index
  %query_valid3 = index.cmp ult, %query_token3, %token_count : index
  %query_valid4 = index.cmp ult, %query_token4, %token_count : index
  %query_valid5 = index.cmp ult, %query_token5, %token_count : index
  %query_valid6 = index.cmp ult, %query_token6, %token_count : index
  %query_valid7 = index.cmp ult, %query_token7, %token_count : index
  %query_channel_valid0 = scalar.andi %query_valid0, %lane_has_channel : i1
  %query_channel_valid1 = scalar.andi %query_valid1, %lane_has_channel : i1
  %query_channel_valid2 = scalar.andi %query_valid2, %lane_has_channel : i1
  %query_channel_valid3 = scalar.andi %query_valid3, %lane_has_channel : i1
  %query_channel_valid4 = scalar.andi %query_valid4, %lane_has_channel : i1
  %query_channel_valid5 = scalar.andi %query_valid5, %lane_has_channel : i1
  %query_channel_valid6 = scalar.andi %query_valid6, %lane_has_channel : i1
  %query_channel_valid7 = scalar.andi %query_valid7, %lane_has_channel : i1
  %query_noalias, %key_noalias, %packed_value_noalias, %attention_mask_noalias, %output_noalias = buffer.assume.noalias %query, %key, %packed_value, %attention_mask, %output : buffer, buffer, buffer, buffer, buffer
  %query_global = buffer.assume.memory_space<global> %query_noalias : buffer
  %key_global = buffer.assume.memory_space<global> %key_noalias : buffer
  %packed_value_global = buffer.assume.memory_space<global> %packed_value_noalias : buffer
  %attention_mask_global = buffer.assume.memory_space<global> %attention_mask_noalias : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  %query_view = buffer.view %query_global[%base] : buffer -> view<[%dispatch_token_count]x[%hidden_size]xbf16, #dense>
  %key_view = buffer.view %key_global[%base] : buffer -> view<[%dispatch_token_count]x[%key_value_width]xbf16, #dense>
  %packed_value_view = buffer.view %packed_value_global[%base] : buffer -> view<[%key_value_width]x[%dispatch_token_count]xbf16, #dense>
  %attention_mask_view = buffer.view %attention_mask_global[%base] : buffer -> view<[%dispatch_token_count]x[%dispatch_token_count]xf32, #dense>
  %output_view = buffer.view %output_global[%base] : buffer -> view<[%dispatch_token_count]x[%hidden_size]xbf16, #dense>
  %query_value0 = scf.if %query_channel_valid0 -> (f32) {
