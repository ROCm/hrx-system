  }
  scf.if %query_channel_valid4 {
    view.store %result4_bf16, %output_view[%query_token4, %attention_channel] : bf16, view<[%dispatch_token_count]x[%hidden_size]xbf16, #dense>
  }
  scf.if %query_channel_valid5 {
    view.store %result5_bf16, %output_view[%query_token5, %attention_channel] : bf16, view<[%dispatch_token_count]x[%hidden_size]xbf16, #dense>
  }
  scf.if %query_channel_valid6 {
    view.store %result6_bf16, %output_view[%query_token6, %attention_channel] : bf16, view<[%dispatch_token_count]x[%hidden_size]xbf16, #dense>
  }
  scf.if %query_channel_valid7 {
