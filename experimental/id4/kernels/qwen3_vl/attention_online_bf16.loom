    } else {
      scf.yield %negative_large : f32
    }
    %mask_values = vector.from_elements %mask_value0, %mask_value1, %mask_value2, %mask_value3, %mask_value4, %mask_value5, %mask_value6, %mask_value7 : vector<8xf32>
    %scaled_score = vector.mulf<reassoc|nnan|ninf|nsz|contract> %dot, %attention_scale_vector : vector<8xf32>
    %score = vector.addf<reassoc|nnan|ninf|nsz> %scaled_score, %mask_values : vector<8xf32>
    %next_max = vector.maxnumf %current_max, %score : vector<8xf32>
    %old_delta = vector.subf<reassoc|nnan|ninf|nsz> %current_max, %next_max : vector<8xf32>
    %old_scale = vector.expf<afn> %old_delta : vector<8xf32>
    %score_delta = vector.subf<reassoc|nnan|ninf|nsz> %score, %next_max : vector<8xf32>
    %weight = vector.expf<afn> %score_delta : vector<8xf32>
    %scaled_sum = vector.mulf<reassoc|nnan|ninf|nsz|contract> %current_sum, %old_scale : vector<8xf32>
    %next_sum = vector.addf<reassoc|nnan|ninf|nsz> %scaled_sum, %weight : vector<8xf32>
    %scaled_acc = vector.mulf<reassoc|nnan|ninf|nsz|contract> %value_acc, %old_scale : vector<8xf32>
    %value_component_f32 = scf.if %lane_has_channel -> (f32) {
      %value_component_bf16 = view.load %packed_value_view[%value_channel, %key_token] : view<[%key_value_width]x[%dispatch_token_count]xbf16, #dense> -> bf16
      %value_component = scalar.extf %value_component_bf16 : bf16 to f32
