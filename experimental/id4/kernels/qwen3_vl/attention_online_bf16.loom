    %value_component_vector = vector.splat %value_component_f32 : vector<8xf32>
    %weighted_component = vector.mulf<reassoc|nnan|ninf|nsz|contract> %weight, %value_component_vector : vector<8xf32>
    %next_value = vector.addf<reassoc|nnan|ninf|nsz> %scaled_acc, %weighted_component : vector<8xf32>
