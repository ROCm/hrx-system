    %lane_products = vector.mulf<reassoc|nnan|ninf|nsz|contract> %query_values, %key_value_vector : vector<8xf32>
    %dot = kernel.workgroup.reduce<addf> %lane_products : vector<8xf32>
    %mask_value0 = scf.if %query_valid0 -> (f32) {
      %loaded = view.load %attention_mask_view[%query_token0, %key_token] : view<[%dispatch_token_count]x[%dispatch_token_count]xf32, #dense> -> f32
