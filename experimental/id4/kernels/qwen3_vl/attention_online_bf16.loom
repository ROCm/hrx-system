config.decl @id4.qwen3_vl.attention_online.token_count : %value: index where [range(%value, 1, 4096)]

config.decl @id4.qwen3_vl.attention_online.dispatch_token_count : %value: index where [range(%value, 1, 4096)]

config.decl @id4.qwen3_vl.attention_online.hidden_size : %value: index where [range(%value, 1, 65536)]

config.decl @id4.qwen3_vl.attention_online.attention_head_count : %value: index where [range(%value, 1, 1024)]

config.decl @id4.qwen3_vl.attention_online.key_value_head_count : %value: index where [range(%value, 1, 1024)]

