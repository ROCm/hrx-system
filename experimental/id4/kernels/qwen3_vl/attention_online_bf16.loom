    } else {
      scf.yield %negative_large : f32
    }
    %mask_value1 = scf.if %query_valid1 -> (f32) {
      %loaded = view.load %attention_mask_view[%query_token1, %key_token] : view<[%dispatch_token_count]x[%dispatch_token_count]xf32, #dense> -> f32
