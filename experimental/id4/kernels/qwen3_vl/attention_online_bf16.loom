  }
  %query_value3 = scf.if %query_channel_valid3 -> (f32) {
    %loaded_bf16 = view.load %query_view[%query_token3, %attention_channel] : view<[%dispatch_token_count]x[%hidden_size]xbf16, #dense> -> bf16
    %loaded = scalar.extf %loaded_bf16 : bf16 to f32
    scf.yield %loaded : f32
  } else {
    scf.yield %zero_f32 : f32
  }
  %query_value4 = scf.if %query_channel_valid4 -> (f32) {
    %loaded_bf16 = view.load %query_view[%query_token4, %attention_channel] : view<[%dispatch_token_count]x[%hidden_size]xbf16, #dense> -> bf16
    %loaded = scalar.extf %loaded_bf16 : bf16 to f32
    scf.yield %loaded : f32
  } else {
    scf.yield %zero_f32 : f32
  }
  %query_value5 = scf.if %query_channel_valid5 -> (f32) {
    %loaded_bf16 = view.load %query_view[%query_token5, %attention_channel] : view<[%dispatch_token_count]x[%hidden_size]xbf16, #dense> -> bf16
    %loaded = scalar.extf %loaded_bf16 : bf16 to f32
    scf.yield %loaded : f32
  } else {
    scf.yield %zero_f32 : f32
  }
  %query_value6 = scf.if %query_channel_valid6 -> (f32) {
    %loaded_bf16 = view.load %query_view[%query_token6, %attention_channel] : view<[%dispatch_token_count]x[%hidden_size]xbf16, #dense> -> bf16
    %loaded = scalar.extf %loaded_bf16 : bf16 to f32
    scf.yield %loaded : f32
  } else {
