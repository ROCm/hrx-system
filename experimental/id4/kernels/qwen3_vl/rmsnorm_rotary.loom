config.decl @id4.qwen3_vl.rmsnorm_rotary.token_count : %value: index where [range(%value, 1, 65536)]

config.decl @id4.qwen3_vl.rmsnorm_rotary.head_count : %value: index where [range(%value, 1, 1024)]

config.decl @id4.qwen3_vl.rmsnorm_rotary.head_size : %value: index where [range(%value, 2, 1024)]

kernel.def export("id4_qwen3_vl_rmsnorm_rotary_bf16") @id4_qwen3_vl_rmsnorm_rotary_bf16() {
  %unit = index.constant 1 : index
  %workgroup_size_x = index.constant 256 : index
  %token_count = config.get @id4.qwen3_vl.rmsnorm_rotary.token_count : index
  %head_count = config.get @id4.qwen3_vl.rmsnorm_rotary.head_count : index
  kernel.launch.config workgroups(%token_count, %head_count, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%input: buffer, %weight: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %two = index.constant 2 : index
  %workgroup_size_x = index.constant 256 : index
  %token = kernel.workgroup.id<x> : index
  %head = kernel.workgroup.id<y> : index
  %lane = kernel.workitem.id<x> : index
  %token_count = config.get @id4.qwen3_vl.rmsnorm_rotary.token_count : index
  %head_count = config.get @id4.qwen3_vl.rmsnorm_rotary.head_count : index
  %head_size = config.get @id4.qwen3_vl.rmsnorm_rotary.head_size : index
  %half_head_size = index.div %head_size, %two : index
  %output_size = index.mul %head_count, %head_size : index
  %head_base = index.mul %head, %head_size : index
  %head_size_i32 = index.cast %head_size : index to i32
  %head_size_f32 = scalar.sitofp %head_size_i32 : i32 to f32
  %token_i32 = index.cast %token : index to i32
  %token_f32 = scalar.sitofp %token_i32 : i32 to f32
  %zero_f32 = scalar.constant 0.0 : f32
  %epsilon = scalar.constant 9.9999999999999995e-07 : f32
  %negative_two = scalar.constant -2.0 : f32
  %rope_theta_log2 = scalar.constant 22.253496664211536 : f32
  %inverse_two_pi = scalar.constant 0.15915494309189535 : f32
  %input_noalias, %weight_noalias, %output_noalias = buffer.assume.noalias %input, %weight, %output : buffer, buffer, buffer
  %input_global = buffer.assume.memory_space<global> %input_noalias : buffer
  %weight_global = buffer.assume.memory_space<global> %weight_noalias : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  %input_view = buffer.view %input_global[%base] : buffer -> view<[%token_count]x[%output_size]xbf16, #dense>
  %weight_view = buffer.view %weight_global[%base] : buffer -> view<[%head_size]xbf16, #dense>
  %output_view = buffer.view %output_global[%base] : buffer -> view<[%token_count]x[%output_size]xbf16, #dense>
  %lane_square_sum = scf.for %head_channel = [%lane to %head_size step %workgroup_size_x](%acc = %zero_f32 : f32) -> (f32) {
    %channel = index.add %head_base, %head_channel : index
    %input_bf16 = view.load %input_view[%token, %channel] : view<[%token_count]x[%output_size]xbf16, #dense> -> bf16
    %value = scalar.extf %input_bf16 : bf16 to f32
    %square = scalar.mulf %value, %value : f32
    %next = scalar.addf %acc, %square : f32
    scf.yield %next : f32
  }
  %square_sum = kernel.workgroup.reduce<addf> %lane_square_sum : f32
  %mean_square = scalar.divf %square_sum, %head_size_f32 : f32
  %mean_square_epsilon = scalar.addf %mean_square, %epsilon : f32
  %row_scale = scalar.rsqrtf %mean_square_epsilon : f32
  scf.for %freq_index = [%lane to %half_head_size step %workgroup_size_x] {
    %upper_head_channel = index.add %freq_index, %half_head_size : index
    %lower_channel = index.add %head_base, %freq_index : index
    %upper_channel = index.add %head_base, %upper_head_channel : index
    %freq_index_i32 = index.cast %freq_index : index to i32
    %freq_index_f32 = scalar.sitofp %freq_index_i32 : i32 to f32
    %freq_scale_numerator = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %freq_index_f32, %negative_two : f32
    %freq_scale = scalar.divf<nnan|ninf|nsz|arcp> %freq_scale_numerator, %head_size_f32 : f32
    %freq_log2 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %freq_scale, %rope_theta_log2 : f32
    %inverse_frequency = scalar.exp2f<afn> %freq_log2 : f32
    %angle = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %token_f32, %inverse_frequency : f32
    %turns = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %angle, %inverse_two_pi : f32
    %cosine = scalar.costurnsf<afn> %turns : f32
    %sine = scalar.sinturnsf<afn> %turns : f32
    %lower_bf16 = view.load %input_view[%token, %lower_channel] : view<[%token_count]x[%output_size]xbf16, #dense> -> bf16
    %upper_bf16 = view.load %input_view[%token, %upper_channel] : view<[%token_count]x[%output_size]xbf16, #dense> -> bf16
    %lower_weight_bf16 = view.load %weight_view[%freq_index] : view<[%head_size]xbf16, #dense> -> bf16
    %upper_weight_bf16 = view.load %weight_view[%upper_head_channel] : view<[%head_size]xbf16, #dense> -> bf16
    %lower_raw = scalar.extf %lower_bf16 : bf16 to f32
    %upper_raw = scalar.extf %upper_bf16 : bf16 to f32
    %lower_weight = scalar.extf %lower_weight_bf16 : bf16 to f32
    %upper_weight = scalar.extf %upper_weight_bf16 : bf16 to f32
    %lower_normalized = scalar.mulf %lower_raw, %row_scale : f32
    %upper_normalized = scalar.mulf %upper_raw, %row_scale : f32
    %lower_weighted = scalar.mulf %lower_normalized, %lower_weight : f32
    %upper_weighted = scalar.mulf %upper_normalized, %upper_weight : f32
    %lower_norm_bf16 = scalar.fptrunc %lower_weighted : f32 to bf16
    %upper_norm_bf16 = scalar.fptrunc %upper_weighted : f32 to bf16
    %lower_value = scalar.extf %lower_norm_bf16 : bf16 to f32
    %upper_value = scalar.extf %upper_norm_bf16 : bf16 to f32
    %lower_cos = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %lower_value, %cosine : f32
    %upper_sin = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %upper_value, %sine : f32
    %rotated_lower = scalar.subf<reassoc|nnan|ninf|nsz|contract> %lower_cos, %upper_sin : f32
    %lower_sin = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %lower_value, %sine : f32
    %upper_cos = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %upper_value, %cosine : f32
    %rotated_upper = scalar.addf<reassoc|nnan|ninf|nsz|contract> %lower_sin, %upper_cos : f32
    %rotated_lower_bf16 = scalar.fptrunc %rotated_lower : f32 to bf16
    %rotated_upper_bf16 = scalar.fptrunc %rotated_upper : f32 to bf16
    view.store %rotated_lower_bf16, %output_view[%token, %lower_channel] : bf16, view<[%token_count]x[%output_size]xbf16, #dense>
    view.store %rotated_upper_bf16, %output_view[%token, %upper_channel] : bf16, view<[%token_count]x[%output_size]xbf16, #dense>
  }
  kernel.return
}

check.case public @id4_qwen3_vl_rmsnorm_rotary_bf16_identity_case {
  %input = check.generate.fill value(2.0) : tensor<1x4xbf16>
  %weight = check.generate.iota offset(0.5) step(0.5) : tensor<4xbf16>
  %output = check.generate.fill value(0.0) : tensor<1x4xbf16>
  %expected = check.generate.iota offset(0.5) step(0.5) : tensor<1x4xbf16>
  func.call @id4_qwen3_vl_rmsnorm_rotary_bf16(%input, %weight, %output) : (tensor<1x4xbf16>, tensor<4xbf16>, tensor<1x4xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(1.0000000000000001e-05) rtol(1.0000000000000001e-05) nan(same) : tensor<1x4xbf16>
  check.return
}

check.benchmark<@id4_qwen3_vl_rmsnorm_rotary_bf16_identity_case> @id4_qwen3_vl_rmsnorm_rotary_bf16_identity
