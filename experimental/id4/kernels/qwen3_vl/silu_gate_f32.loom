  %in_bounds = index.cmp ult, %element_index, %element_count : index
  %gate_noalias, %up_noalias, %output_noalias = buffer.assume.noalias %gate, %up, %output : buffer, buffer, buffer
  %gate_global = buffer.assume.memory_space<global> %gate_noalias : buffer
  %up_global = buffer.assume.memory_space<global> %up_noalias : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  %gate_view = buffer.view %gate_global[%base] : buffer -> view<[%token_count]x[%intermediate_size]xbf16, #dense>
  %up_view = buffer.view %up_global[%base] : buffer -> view<[%token_count]x[%intermediate_size]xbf16, #dense>
  %output_view = buffer.view %output_global[%base] : buffer -> view<[%token_count]x[%intermediate_size]xbf16, #dense>
  scf.if %in_bounds {
    %token = index.div %element_index, %intermediate_size : index
    %channel = index.rem %element_index, %intermediate_size : index
    %gate_value_bf16 = view.load %gate_view[%token, %channel] : view<[%token_count]x[%intermediate_size]xbf16, #dense> -> bf16
    %up_value_bf16 = view.load %up_view[%token, %channel] : view<[%token_count]x[%intermediate_size]xbf16, #dense> -> bf16
    %gate_value = scalar.extf %gate_value_bf16 : bf16 to f32
    %up_value = scalar.extf %up_value_bf16 : bf16 to f32
    %gate_silu = scalar.siluf %gate_value : f32
    %value = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %gate_silu, %up_value : f32
    %rounded = scalar.fptrunc %value : f32 to bf16
    view.store %rounded, %output_view[%token, %channel] : bf16, view<[%token_count]x[%intermediate_size]xbf16, #dense>
  }
  kernel.return
}

