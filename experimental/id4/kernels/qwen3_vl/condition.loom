  }
  %original_sum = kernel.workgroup.reduce<addf> %original_lane_sum : f32
  %weighted_sum = kernel.workgroup.reduce<addf> %weighted_lane_sum : f32
  %is_lane0 = index.cmp eq, %lane, %zero : index
  scf.if %is_lane0 {
    view.store %original_sum, %stats_view[%partial_ordinal, %zero] : f32, view<[%partial_count]x2xf32, #dense>
