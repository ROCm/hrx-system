config.decl @id4.qwen3_vl.condition.hidden_row_count : %value: index where [range(%value, 1, 65536)]

config.decl @id4.qwen3_vl.condition.token_count : %value: index where [range(%value, 1, 65536)]

kernel.def export("id4_qwen3_vl_condition_apply_token_weights_f32") @id4_qwen3_vl_condition_apply_token_weights_f32() {
  %unit = index.constant 1 : index
  %block_element_count = index.constant 2048 : index
  %workgroup_size_x = index.constant 256 : index
  %hidden_row_count = config.get @id4.qwen3_vl.condition.hidden_row_count : index
  %token_count = config.get @id4.qwen3_vl.condition.token_count : index
  %element_count = index.mul %hidden_row_count, %token_count : index
  %rounding = index.sub %block_element_count, %unit : index
  %rounded = index.add %element_count, %rounding : index
  %partial_count = index.div %rounded, %block_element_count : index
  kernel.launch.config workgroups(%partial_count, %unit, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%selected_hidden_states: buffer, %token_weights: buffer, %condition: buffer, %stats: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %partial_ordinal = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %hidden_row_count = config.get @id4.qwen3_vl.condition.hidden_row_count : index
  %token_count = config.get @id4.qwen3_vl.condition.token_count : index
  %workgroup_size_x = index.constant 256 : index
  %block_element_count = index.constant 2048 : index
  %element_count = index.mul %hidden_row_count, %token_count : index
  %rounding = index.sub %block_element_count, %one : index
  %rounded = index.add %element_count, %rounding : index
  %partial_count = index.div %rounded, %block_element_count : index
  %block_origin = index.mul %partial_ordinal, %block_element_count : index
  %zero_f32 = scalar.constant 0.0 : f32
  %selected_noalias, %token_weights_noalias, %condition_noalias, %stats_noalias = buffer.assume.noalias %selected_hidden_states, %token_weights, %condition, %stats : buffer, buffer, buffer, buffer
  %selected_global = buffer.assume.memory_space<global> %selected_noalias : buffer
  %token_weights_global = buffer.assume.memory_space<global> %token_weights_noalias : buffer
  %condition_global = buffer.assume.memory_space<global> %condition_noalias : buffer
  %stats_global = buffer.assume.memory_space<global> %stats_noalias : buffer
  %selected_view = buffer.view %selected_global[%base] : buffer -> view<[%hidden_row_count]x[%token_count]xf32, #dense>
  %token_weights_view = buffer.view %token_weights_global[%base] : buffer -> view<[%token_count]xf32, #dense>
  %condition_view = buffer.view %condition_global[%base] : buffer -> view<[%hidden_row_count]x[%token_count]xf32, #dense>
  %stats_view = buffer.view %stats_global[%base] : buffer -> view<[%partial_count]x2xf32, #dense>
  %original_lane_sum, %weighted_lane_sum = scf.for %block_offset = [%lane to %block_element_count step %workgroup_size_x](%original_acc = %zero_f32 : f32, %weighted_acc = %zero_f32 : f32) -> (f32, f32) {
    %element_index = index.add %block_origin, %block_offset : index
    %in_bounds = index.cmp ult, %element_index, %element_count : index
    %next_original, %next_weighted = scf.if %in_bounds -> (f32, f32) {
      %row = index.div %element_index, %token_count : index
      %column = index.rem %element_index, %token_count : index
      %value = view.load %selected_view[%row, %column] : view<[%hidden_row_count]x[%token_count]xf32, #dense> -> f32
      %weight = view.load %token_weights_view[%column] : view<[%token_count]xf32, #dense> -> f32
      %weighted = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %value, %weight : f32
      view.store %weighted, %condition_view[%row, %column] : f32, view<[%hidden_row_count]x[%token_count]xf32, #dense>
      %original_next = scalar.addf<reassoc|nnan|ninf|nsz> %original_acc, %value : f32
      %weighted_next = scalar.addf<reassoc|nnan|ninf|nsz> %weighted_acc, %weighted : f32
      scf.yield %original_next, %weighted_next : f32, f32
    } else {
      scf.yield %original_acc, %weighted_acc : f32, f32
    }
    scf.yield %next_original, %next_weighted : f32, f32
  }
  %original_sum = kernel.workgroup.reduce<addf> %original_lane_sum : f32
  %weighted_sum = kernel.workgroup.reduce<addf> %weighted_lane_sum : f32
  %is_lane0 = index.cmp eq, %lane, %zero : index
  scf.if %is_lane0 {
    view.store %original_sum, %stats_view[%partial_ordinal, %zero] : f32, view<[%partial_count]x2xf32, #dense>
    view.store %weighted_sum, %stats_view[%partial_ordinal, %one] : f32, view<[%partial_count]x2xf32, #dense>
  }
  kernel.return
}

