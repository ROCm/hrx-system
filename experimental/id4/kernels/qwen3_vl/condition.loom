      %weighted_next = scalar.addf<reassoc|nnan|ninf|nsz> %weighted_acc, %weighted : f32
      scf.yield %original_next, %weighted_next : f32, f32
    } else {
      scf.yield %original_acc, %weighted_acc : f32, f32
