config.decl @id4.qwen3_vl.linear.token_count : %value: index where [range(%value, 1, 65536)]
config.decl @id4.qwen3_vl.linear.input_size : %value: index where [range(%value, 4, 65536)]
config.decl @id4.qwen3_vl.linear.output_size : %value: index where [range(%value, 1, 65536)]

func.def inline @id4_qwen3_vl_linear_bf16_f32_dot4(%input_values: vector<4xf32>, %weight_values: vector<4xbf16>) -> (f32) {
  %zero_f32 = scalar.constant 0.0 : f32
  %weight_f32 = vector.extf %weight_values : vector<4xbf16> to vector<4xf32>
  %products = vector.mulf<reassoc|nnan|ninf|nsz|contract> %input_values, %weight_f32 : vector<4xf32>
  %sum = vector.reduce<addf, reassoc|nnan|ninf|nsz> %products, %zero_f32 : vector<4xf32>, f32
  func.return %sum : f32
}

kernel.def export("id4_qwen3_vl_linear_bf16_f32") @id4_qwen3_vl_linear_bf16_f32() {
  %unit = index.constant 1 : index
  %workgroup_size_x = index.constant 256 : index
  %token_count = config.get @id4.qwen3_vl.linear.token_count : index
  %output_size = config.get @id4.qwen3_vl.linear.output_size : index
  kernel.launch.config workgroups(%token_count, %output_size, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%input: buffer, %weight: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %workgroup_size_x = index.constant 256 : index
  %vector_width = index.constant 4 : index
  %token = kernel.workgroup.id<x> : index
  %output_row = kernel.workgroup.id<y> : index
  %lane = kernel.workitem.id<x> : index
  %token_count = config.get @id4.qwen3_vl.linear.token_count : index
  %input_size_unaligned = config.get @id4.qwen3_vl.linear.input_size : index
  %input_size = index.assume %input_size_unaligned [mul(%input_size_unaligned, 4)] : index
  %output_size = config.get @id4.qwen3_vl.linear.output_size : index
  %vector_step0 = index.mul %workgroup_size_x, %vector_width : index
  %vector_step = index.assume %vector_step0 [mul(%vector_step0, 4)] : index
  %input_base0 = index.mul %lane, %vector_width : index
  %input_base = index.assume %input_base0 [mul(%input_base0, 4)] : index
  %zero_f32 = scalar.constant 0.0 : f32

  %input_noalias, %weight_noalias, %output_noalias = buffer.assume.noalias %input, %weight, %output : buffer, buffer, buffer
  %input_global = buffer.assume.memory_space<global> %input_noalias : buffer
  %weight_global = buffer.assume.memory_space<global> %weight_noalias : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  %input_view = buffer.view %input_global[%base] : buffer -> view<[%token_count]x[%input_size]xf32, #dense>
  %weight_view = buffer.view %weight_global[%base] : buffer -> view<[%output_size]x[%input_size]xbf16, #dense>
  %output_view = buffer.view %output_global[%base] : buffer -> view<[%token_count]x[%output_size]xf32, #dense>

  %lane_dot = scf.for %input_column = [%input_base to %input_size step %vector_step](%acc = %zero_f32 : f32) -> (f32) {
    %input_values = vector.load %input_view[%token, %input_column] : view<[%token_count]x[%input_size]xf32, #dense> -> vector<4xf32>
    %weight_values = vector.load %weight_view[%output_row, %input_column] : view<[%output_size]x[%input_size]xbf16, #dense> -> vector<4xbf16>
    %partial = func.call @id4_qwen3_vl_linear_bf16_f32_dot4(%input_values, %weight_values) : (vector<4xf32>, vector<4xbf16>) -> (f32)
    %next = scalar.addf<reassoc|nnan|ninf|nsz> %acc, %partial : f32
    scf.yield %next : f32
  }
  %dot = kernel.workgroup.reduce<addf> %lane_dot : f32
  %is_leader = index.cmp eq, %lane, %zero : index
  scf.if %is_leader {
    view.store %dot, %output_view[%token, %output_row] : f32, view<[%token_count]x[%output_size]xf32, #dense>
  }
  kernel.return
}

check.case public @id4_qwen3_vl_linear_bf16_f32_small_case {
  %input = check.generate.iota offset(1.0) step(1.0) : tensor<1x4xf32>
  %weight = check.generate.iota offset(0.5) step(0.5) : tensor<2x4xbf16>
  %output = check.generate.fill value(0.0) : tensor<1x2xf32>
  %expected = check.generate.iota offset(15.0) step(20.0) : tensor<1x2xf32>
  func.call @id4_qwen3_vl_linear_bf16_f32(%input, %weight, %output) : (tensor<1x4xf32>, tensor<2x4xbf16>, tensor<1x2xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<1x2xf32>
  check.return
}

check.case public @id4_qwen3_vl_linear_bf16_f32_qwen_projection_shape_case {
  %input = check.generate.fill value(1.0) : tensor<64x4096xf32>
  %weight = check.generate.fill value(0.0) : tensor<4096x4096xbf16>
  %output = check.generate.fill value(1.0) : tensor<64x4096xf32>
  %expected = check.generate.fill value(0.0) : tensor<64x4096xf32>
  func.call @id4_qwen3_vl_linear_bf16_f32(%input, %weight, %output) : (tensor<64x4096xf32>, tensor<4096x4096xbf16>, tensor<64x4096xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<64x4096xf32>
  check.return
}

check.benchmark<@id4_qwen3_vl_linear_bf16_f32_small_case> @id4_qwen3_vl_linear_bf16_f32_small
check.benchmark<@id4_qwen3_vl_linear_bf16_f32_qwen_projection_shape_case> @id4_qwen3_vl_linear_bf16_f32_qwen_projection_shape
