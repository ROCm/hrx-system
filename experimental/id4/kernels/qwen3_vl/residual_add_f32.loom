config.decl @id4.qwen3_vl.residual_add.token_count : %value: index where [range(%value, 1, 65536)]

config.decl @id4.qwen3_vl.residual_add.hidden_size : %value: index where [range(%value, 1, 65536)]

kernel.def export("id4_qwen3_vl_residual_add_f32") @id4_qwen3_vl_residual_add_f32() {
  %unit = index.constant 1 : index
  %workgroup_size_x = index.constant 256 : index
  %token_count = config.get @id4.qwen3_vl.residual_add.token_count : index
  %hidden_size = config.get @id4.qwen3_vl.residual_add.hidden_size : index
  %element_count = index.mul %token_count, %hidden_size : index
  %rounding = index.sub %workgroup_size_x, %unit : index
  %rounded = index.add %element_count, %rounding : index
  %workgroups_x = index.div %rounded, %workgroup_size_x : index
  kernel.launch.config workgroups(%workgroups_x, %unit, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%lhs: buffer, %rhs: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %workgroup = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %workgroup_size_x = index.constant 256 : index
  %token_count = config.get @id4.qwen3_vl.residual_add.token_count : index
  %hidden_size = config.get @id4.qwen3_vl.residual_add.hidden_size : index
  %element_count = index.mul %token_count, %hidden_size : index
  %element_index = index.madd %workgroup, %workgroup_size_x, %lane : index
  %in_bounds = index.cmp ult, %element_index, %element_count : index
  %lhs_noalias, %rhs_noalias, %output_noalias = buffer.assume.noalias %lhs, %rhs, %output : buffer, buffer, buffer
  %lhs_global = buffer.assume.memory_space<global> %lhs_noalias : buffer
  %rhs_global = buffer.assume.memory_space<global> %rhs_noalias : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  %lhs_view = buffer.view %lhs_global[%base] : buffer -> view<[%token_count]x[%hidden_size]xf32, #dense>
  %rhs_view = buffer.view %rhs_global[%base] : buffer -> view<[%token_count]x[%hidden_size]xf32, #dense>
  %output_view = buffer.view %output_global[%base] : buffer -> view<[%token_count]x[%hidden_size]xf32, #dense>
  scf.if %in_bounds {
    %token = index.div %element_index, %hidden_size : index
    %channel = index.rem %element_index, %hidden_size : index
    %lhs_value = view.load %lhs_view[%token, %channel] : view<[%token_count]x[%hidden_size]xf32, #dense> -> f32
    %rhs_value = view.load %rhs_view[%token, %channel] : view<[%token_count]x[%hidden_size]xf32, #dense> -> f32
    %value = scalar.addf<reassoc|nnan|ninf|nsz> %lhs_value, %rhs_value : f32
    view.store %value, %output_view[%token, %channel] : f32, view<[%token_count]x[%hidden_size]xf32, #dense>
  }
  kernel.return
}

kernel.def export("id4_qwen3_vl_residual_add_bf16") @id4_qwen3_vl_residual_add_bf16() {
  %unit = index.constant 1 : index
  %workgroup_size_x = index.constant 256 : index
  %token_count = config.get @id4.qwen3_vl.residual_add.token_count : index
  %hidden_size = config.get @id4.qwen3_vl.residual_add.hidden_size : index
  %element_count = index.mul %token_count, %hidden_size : index
  %rounding = index.sub %workgroup_size_x, %unit : index
  %rounded = index.add %element_count, %rounding : index
  %workgroups_x = index.div %rounded, %workgroup_size_x : index
  kernel.launch.config workgroups(%workgroups_x, %unit, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%lhs: buffer, %rhs: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %workgroup = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %workgroup_size_x = index.constant 256 : index
  %token_count = config.get @id4.qwen3_vl.residual_add.token_count : index
  %hidden_size = config.get @id4.qwen3_vl.residual_add.hidden_size : index
  %element_count = index.mul %token_count, %hidden_size : index
  %element_index = index.madd %workgroup, %workgroup_size_x, %lane : index
  %in_bounds = index.cmp ult, %element_index, %element_count : index
  %lhs_noalias, %rhs_noalias, %output_noalias = buffer.assume.noalias %lhs, %rhs, %output : buffer, buffer, buffer
  %lhs_global = buffer.assume.memory_space<global> %lhs_noalias : buffer
  %rhs_global = buffer.assume.memory_space<global> %rhs_noalias : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  %lhs_view = buffer.view %lhs_global[%base] : buffer -> view<[%token_count]x[%hidden_size]xbf16, #dense>
  %rhs_view = buffer.view %rhs_global[%base] : buffer -> view<[%token_count]x[%hidden_size]xbf16, #dense>
  %output_view = buffer.view %output_global[%base] : buffer -> view<[%token_count]x[%hidden_size]xbf16, #dense>
  scf.if %in_bounds {
    %token = index.div %element_index, %hidden_size : index
    %channel = index.rem %element_index, %hidden_size : index
    %lhs_value_bf16 = view.load %lhs_view[%token, %channel] : view<[%token_count]x[%hidden_size]xbf16, #dense> -> bf16
    %rhs_value_bf16 = view.load %rhs_view[%token, %channel] : view<[%token_count]x[%hidden_size]xbf16, #dense> -> bf16
    %lhs_value = scalar.extf %lhs_value_bf16 : bf16 to f32
    %rhs_value = scalar.extf %rhs_value_bf16 : bf16 to f32
    %value = scalar.addf<reassoc|nnan|ninf|nsz> %lhs_value, %rhs_value : f32
    %rounded = scalar.fptrunc %value : f32 to bf16
    view.store %rounded, %output_view[%token, %channel] : bf16, view<[%token_count]x[%hidden_size]xbf16, #dense>
  }
  kernel.return
}

kernel.def export("id4_qwen3_vl_residual_add_rmsnorm_bf16") @id4_qwen3_vl_residual_add_rmsnorm_bf16() {
  %unit = index.constant 1 : index
  %workgroup_size_x = index.constant 256 : index
  %token_count = config.get @id4.qwen3_vl.residual_add.token_count : index
  kernel.launch.config workgroups(%token_count, %unit, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%lhs: buffer, %rhs: buffer, %weight: buffer, %residual_output: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %workgroup_size_x = index.constant 256 : index
  %row = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %hidden_size = config.get @id4.qwen3_vl.residual_add.hidden_size : index
  %zero_f32 = scalar.constant 0.0 : f32
  %epsilon = scalar.constant 9.9999999999999995e-07 : f32
  %hidden_size_i32 = index.cast %hidden_size : index to i32
  %hidden_size_f32 = scalar.sitofp %hidden_size_i32 : i32 to f32
  %lhs_noalias, %rhs_noalias, %weight_noalias, %residual_output_noalias, %output_noalias = buffer.assume.noalias %lhs, %rhs, %weight, %residual_output, %output : buffer, buffer, buffer, buffer, buffer
  %lhs_global = buffer.assume.memory_space<global> %lhs_noalias : buffer
  %rhs_global = buffer.assume.memory_space<global> %rhs_noalias : buffer
  %weight_global = buffer.assume.memory_space<global> %weight_noalias : buffer
  %residual_output_global = buffer.assume.memory_space<global> %residual_output_noalias : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  %token_count = config.get @id4.qwen3_vl.residual_add.token_count : index
  %lhs_view = buffer.view %lhs_global[%base] : buffer -> view<[%token_count]x[%hidden_size]xbf16, #dense>
  %rhs_view = buffer.view %rhs_global[%base] : buffer -> view<[%token_count]x[%hidden_size]xbf16, #dense>
  %weight_view = buffer.view %weight_global[%base] : buffer -> view<[%hidden_size]xbf16, #dense>
  %residual_output_view = buffer.view %residual_output_global[%base] : buffer -> view<[%token_count]x[%hidden_size]xbf16, #dense>
  %output_view = buffer.view %output_global[%base] : buffer -> view<[%token_count]x[%hidden_size]xbf16, #dense>
  %lane_square_sum = scf.for %column = [%lane to %hidden_size step %workgroup_size_x](%acc = %zero_f32 : f32) -> (f32) {
    %lhs_bf16 = view.load %lhs_view[%row, %column] : view<[%token_count]x[%hidden_size]xbf16, #dense> -> bf16
    %rhs_bf16 = view.load %rhs_view[%row, %column] : view<[%token_count]x[%hidden_size]xbf16, #dense> -> bf16
    %lhs_value = scalar.extf %lhs_bf16 : bf16 to f32
    %rhs_value = scalar.extf %rhs_bf16 : bf16 to f32
    %sum = scalar.addf<reassoc|nnan|ninf|nsz> %lhs_value, %rhs_value : f32
    %sum_bf16 = scalar.fptrunc %sum : f32 to bf16
    view.store %sum_bf16, %residual_output_view[%row, %column] : bf16, view<[%token_count]x[%hidden_size]xbf16, #dense>
    %value = scalar.extf %sum_bf16 : bf16 to f32
    %square = scalar.mulf %value, %value : f32
    %next = scalar.addf %acc, %square : f32
    scf.yield %next : f32
  }
  %square_sum = kernel.workgroup.reduce<addf> %lane_square_sum : f32
  %mean_square = scalar.divf %square_sum, %hidden_size_f32 : f32
  %mean_square_epsilon = scalar.addf %mean_square, %epsilon : f32
  %row_scale = scalar.rsqrtf %mean_square_epsilon : f32
  scf.for %column = [%lane to %hidden_size step %workgroup_size_x] {
    %lhs_bf16 = view.load %lhs_view[%row, %column] : view<[%token_count]x[%hidden_size]xbf16, #dense> -> bf16
    %rhs_bf16 = view.load %rhs_view[%row, %column] : view<[%token_count]x[%hidden_size]xbf16, #dense> -> bf16
    %weight_bf16 = view.load %weight_view[%column] : view<[%hidden_size]xbf16, #dense> -> bf16
    %lhs_value = scalar.extf %lhs_bf16 : bf16 to f32
    %rhs_value = scalar.extf %rhs_bf16 : bf16 to f32
    %weight_value = scalar.extf %weight_bf16 : bf16 to f32
    %sum = scalar.addf<reassoc|nnan|ninf|nsz> %lhs_value, %rhs_value : f32
    %sum_bf16 = scalar.fptrunc %sum : f32 to bf16
    %value = scalar.extf %sum_bf16 : bf16 to f32
    %normalized = scalar.mulf %value, %row_scale : f32
    %weighted = scalar.mulf %normalized, %weight_value : f32
    %rounded = scalar.fptrunc %weighted : f32 to bf16
    view.store %rounded, %output_view[%row, %column] : bf16, view<[%token_count]x[%hidden_size]xbf16, #dense>
  }
  kernel.return
}
