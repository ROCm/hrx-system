  %query_token = index.div %element_index, %hidden_size : index
  %output_channel = index.rem %element_index, %hidden_size : index
  %query_head = index.div %output_channel, %head_size : index
  %channel_in_head = index.rem %output_channel, %head_size : index
  %key_value_head = index.div %query_head, %query_heads_per_key : index
  %key_value_head_base = index.mul %key_value_head, %head_size : index
  %value_channel = index.add %key_value_head_base, %channel_in_head : index
  %probabilities_noalias, %value_noalias, %output_noalias = buffer.assume.noalias %probabilities, %value, %output : buffer, buffer, buffer
  %probabilities_global = buffer.assume.memory_space<global> %probabilities_noalias : buffer
  %value_global = buffer.assume.memory_space<global> %value_noalias : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  %probabilities_view = buffer.view %probabilities_global[%base] : buffer -> view<[%attention_head_count]x[%token_count]x[%token_count]xbf16, #dense>
  %value_view = buffer.view %value_global[%base] : buffer -> view<[%token_count]x[%key_value_width]xbf16, #dense>
  %output_view = buffer.view %output_global[%base] : buffer -> view<[%dispatch_token_count]x[%hidden_size]xbf16, #dense>
  scf.if %in_bounds {
    %query_in_range = index.cmp ult, %query_token, %token_count : index
    scf.if %query_in_range {
      %weighted_value_sum = scf.for %key_token = [%zero to %token_count step %one](%value_acc = %zero_f32 : f32) -> (f32) {
        %probability_bf16 = view.load %probabilities_view[%query_head, %query_token, %key_token] : view<[%attention_head_count]x[%token_count]x[%token_count]xbf16, #dense> -> bf16
        %value_component_bf16 = view.load %value_view[%key_token, %value_channel] : view<[%token_count]x[%key_value_width]xbf16, #dense> -> bf16
        %probability = scalar.extf %probability_bf16 : bf16 to f32
        %value_component = scalar.extf %value_component_bf16 : bf16 to f32
        %weighted_component = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %probability, %value_component : f32
        %next_value = scalar.addf<reassoc|nnan|ninf|nsz> %value_acc, %weighted_component : f32
        scf.yield %next_value : f32
      }
      %output_bf16 = scalar.fptrunc %weighted_value_sum : f32 to bf16
      view.store %output_bf16, %output_view[%query_token, %output_channel] : bf16, view<[%dispatch_token_count]x[%hidden_size]xbf16, #dense>
    } else {
      view.store %zero_bf16, %output_view[%query_token, %output_channel] : bf16, view<[%dispatch_token_count]x[%hidden_size]xbf16, #dense>
    }
  }
  kernel.return
}

