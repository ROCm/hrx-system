amdgpu.target<gfx1100> @id4_gfx1100

config.decl @id4.qwen3_vl.linear_residual_wmma.token_count : %value: index where [range(%value, 1, 65536)]

config.decl @id4.qwen3_vl.linear_residual_wmma.dispatch_token_count : %value: index where [range(%value, 32, 65536), mul(%value, 32)]

config.decl @id4.qwen3_vl.linear_residual_wmma.input_size : %value: index where [range(%value, 16, 65536), mul(%value, 16)]

config.decl @id4.qwen3_vl.linear_residual_wmma.output_size : %value: index where [range(%value, 32, 65536), mul(%value, 32)]

kernel.def target(@id4_gfx1100) export("id4_qwen3_vl_linear_residual_bf16_bf16_wmma_m32n32_compact_rhs") @id4_qwen3_vl_linear_residual_bf16_bf16_wmma_m32n32_compact_rhs() {
  %unit = index.constant 1 : index
  %thirty_two = index.constant 32 : index
  %workgroup_size_x = index.constant 32 : index
  %dispatch_token_count = config.get @id4.qwen3_vl.linear_residual_wmma.dispatch_token_count : index
  %output_size = config.get @id4.qwen3_vl.linear_residual_wmma.output_size : index
  %token_pair_count = index.div %dispatch_token_count, %thirty_two : index
  %row_pair_count = index.div %output_size, %thirty_two : index
  kernel.launch.config workgroups(%token_pair_count, %row_pair_count, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%input_bf16: buffer, %weight: buffer, %residual: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %eight = index.constant 8 : index
  %sixteen = index.constant 16 : index
  %thirty_two = index.constant 32 : index
  %two_fifty_six = index.constant 256 : index
  %token_pair = kernel.workgroup.id<x> : index
  %row_pair = kernel.workgroup.id<y> : index
  %lane = kernel.workitem.id<x> : index
  %lane_column = index.rem %lane, %sixteen : index
  %lane_group = index.div %lane, %sixteen : index
  %token_count = config.get @id4.qwen3_vl.linear_residual_wmma.token_count : index
  %dispatch_token_count = config.get @id4.qwen3_vl.linear_residual_wmma.dispatch_token_count : index
  %input_size = config.get @id4.qwen3_vl.linear_residual_wmma.input_size : index
  %output_size = config.get @id4.qwen3_vl.linear_residual_wmma.output_size : index
  %k_tile_count = index.div %input_size, %sixteen : index
  %output_tile_count = index.div %output_size, %sixteen : index
  %packed_tile_count = index.mul %output_tile_count, %k_tile_count : index
  %packed_element_count = index.mul %packed_tile_count, %two_fifty_six : index
  %token_origin0 = index.mul %token_pair, %thirty_two : index
  %token_origin1 = index.add %token_origin0, %sixteen : index
  %row_origin0 = index.mul %row_pair, %thirty_two : index
  %row_origin1 = index.add %row_origin0, %sixteen : index
  %row_tile0 = index.div %row_origin0, %sixteen : index
  %row_tile1 = index.div %row_origin1, %sixteen : index
  %column0 = index.add %row_origin0, %lane_column : index
  %column1 = index.add %row_origin1, %lane_column : index
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %packed_weight_layout = encoding.layout.strided [1, %sixteen] : encoding<layout>
  %zero_acc = vector.constant 0.0 : vector<8xf32>
  %input_noalias, %weight_noalias, %residual_noalias, %output_noalias = buffer.assume.noalias %input_bf16, %weight, %residual, %output : buffer, buffer, buffer, buffer
  %input_global = buffer.assume.memory_space<global> %input_noalias : buffer
  %weight_global = buffer.assume.memory_space<global> %weight_noalias : buffer
  %residual_global = buffer.assume.memory_space<global> %residual_noalias : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  %input_aligned = buffer.assume.alignment %input_global {minimum_alignment = 16} : buffer
  %weight_aligned = buffer.assume.alignment %weight_global {minimum_alignment = 16} : buffer
  %residual_aligned = buffer.assume.alignment %residual_global {minimum_alignment = 16} : buffer
  %output_aligned = buffer.assume.alignment %output_global {minimum_alignment = 16} : buffer
  %input_view = buffer.view %input_aligned[%base] : buffer -> view<[%dispatch_token_count]x[%input_size]xbf16, #dense>
  %weight_view = buffer.view %weight_aligned[%base] : buffer -> view<[%packed_element_count]x16xbf16, %packed_weight_layout>
  %residual_view = buffer.view %residual_aligned[%base] : buffer -> view<[%dispatch_token_count]x[%output_size]xbf16, #dense>
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<[%dispatch_token_count]x[%output_size]xbf16, #dense>
  %init00 = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>
  %init01 = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>
  %init10 = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>
  %init11 = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>
  %result00, %result01, %result10, %result11 = scf.for %k_tile = [%zero to %k_tile_count step %one](%acc00 = %init00 : vector<8xf32>, %acc01 = %init01 : vector<8xf32>, %acc10 = %init10 : vector<8xf32>, %acc11 = %init11 : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
    %k_origin = index.mul %k_tile, %sixteen : index
    %lhs0 = vector.fragment.load<lhs> %input_view[%token_origin0, %k_origin] shape [%m, %k] : view<[%dispatch_token_count]x[%input_size]xbf16, #dense> -> vector<16xbf16>
    %lhs1 = vector.fragment.load<lhs> %input_view[%token_origin1, %k_origin] shape [%m, %k] : view<[%dispatch_token_count]x[%input_size]xbf16, #dense> -> vector<16xbf16>
    %rhs_tile0 = index.madd %row_tile0, %k_tile_count, %k_tile : index
    %rhs_tile1 = index.madd %row_tile1, %k_tile_count, %k_tile : index
    %rhs_row0 = index.mul %rhs_tile0, %two_fifty_six : index
    %rhs_row1 = index.mul %rhs_tile1, %two_fifty_six : index
    %rhs0 = vector.fragment.load<rhs> %weight_view[%rhs_row0, %zero] shape [%k, %n] : view<[%packed_element_count]x16xbf16, %packed_weight_layout> -> vector<16xbf16>
    %rhs1 = vector.fragment.load<rhs> %weight_view[%rhs_row1, %zero] shape [%k, %n] : view<[%packed_element_count]x16xbf16, %packed_weight_layout> -> vector<16xbf16>
    %next00 = vector.mma %lhs0, %rhs0, %acc00 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %next01 = vector.mma %lhs0, %rhs1, %acc01 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %next10 = vector.mma %lhs1, %rhs0, %acc10 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %next11 = vector.mma %lhs1, %rhs1, %acc11 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    scf.yield %next00, %next01, %next10, %next11 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }
  scf.for %register_index = [%zero to %eight step %one] {
    %register_token_base = index.mul %register_index, %two : index
    %local_token = index.add %register_token_base, %lane_group : index
    %token0 = index.add %token_origin0, %local_token : index
    %token1 = index.add %token_origin1, %local_token : index
    %token0_valid = index.cmp ult, %token0, %token_count : index
    %token1_valid = index.cmp ult, %token1, %token_count : index
    %value00 = vector.extract %result00[%register_index] : vector<8xf32> -> f32
    %rounded00 = scalar.fptrunc %value00 : f32 to bf16
    %linear00 = scalar.extf %rounded00 : bf16 to f32
    %residual00_bf16 = view.load %residual_view[%token0, %column0] : view<[%dispatch_token_count]x[%output_size]xbf16, #dense> -> bf16
    %residual00 = scalar.extf %residual00_bf16 : bf16 to f32
    %output00 = scf.if %token0_valid -> (f32) {
      %added00 = scalar.addf<reassoc|nnan|ninf|nsz> %linear00, %residual00 : f32
      scf.yield %added00 : f32
    } else {
      scf.yield %residual00 : f32
    }
    %output00_bf16 = scalar.fptrunc %output00 : f32 to bf16
    view.store %output00_bf16, %output_view[%token0, %column0] : bf16, view<[%dispatch_token_count]x[%output_size]xbf16, #dense>
    %value01 = vector.extract %result01[%register_index] : vector<8xf32> -> f32
    %rounded01 = scalar.fptrunc %value01 : f32 to bf16
    %linear01 = scalar.extf %rounded01 : bf16 to f32
    %residual01_bf16 = view.load %residual_view[%token0, %column1] : view<[%dispatch_token_count]x[%output_size]xbf16, #dense> -> bf16
    %residual01 = scalar.extf %residual01_bf16 : bf16 to f32
    %output01 = scf.if %token0_valid -> (f32) {
      %added01 = scalar.addf<reassoc|nnan|ninf|nsz> %linear01, %residual01 : f32
      scf.yield %added01 : f32
    } else {
      scf.yield %residual01 : f32
    }
    %output01_bf16 = scalar.fptrunc %output01 : f32 to bf16
    view.store %output01_bf16, %output_view[%token0, %column1] : bf16, view<[%dispatch_token_count]x[%output_size]xbf16, #dense>
    %value10 = vector.extract %result10[%register_index] : vector<8xf32> -> f32
    %rounded10 = scalar.fptrunc %value10 : f32 to bf16
    %linear10 = scalar.extf %rounded10 : bf16 to f32
    %residual10_bf16 = view.load %residual_view[%token1, %column0] : view<[%dispatch_token_count]x[%output_size]xbf16, #dense> -> bf16
    %residual10 = scalar.extf %residual10_bf16 : bf16 to f32
    %output10 = scf.if %token1_valid -> (f32) {
      %added10 = scalar.addf<reassoc|nnan|ninf|nsz> %linear10, %residual10 : f32
      scf.yield %added10 : f32
    } else {
      scf.yield %residual10 : f32
    }
    %output10_bf16 = scalar.fptrunc %output10 : f32 to bf16
    view.store %output10_bf16, %output_view[%token1, %column0] : bf16, view<[%dispatch_token_count]x[%output_size]xbf16, #dense>
    %value11 = vector.extract %result11[%register_index] : vector<8xf32> -> f32
    %rounded11 = scalar.fptrunc %value11 : f32 to bf16
    %linear11 = scalar.extf %rounded11 : bf16 to f32
    %residual11_bf16 = view.load %residual_view[%token1, %column1] : view<[%dispatch_token_count]x[%output_size]xbf16, #dense> -> bf16
    %residual11 = scalar.extf %residual11_bf16 : bf16 to f32
    %output11 = scf.if %token1_valid -> (f32) {
      %added11 = scalar.addf<reassoc|nnan|ninf|nsz> %linear11, %residual11 : f32
      scf.yield %added11 : f32
    } else {
      scf.yield %residual11 : f32
    }
    %output11_bf16 = scalar.fptrunc %output11 : f32 to bf16
    view.store %output11_bf16, %output_view[%token1, %column1] : bf16, view<[%dispatch_token_count]x[%output_size]xbf16, #dense>
  }
  kernel.return
}
