    %scores = vector.from_elements %masked_score0, %masked_score1, %masked_score2, %masked_score3, %masked_score4, %masked_score5, %masked_score6, %masked_score7 : vector<8xf32>
    %even_scores = scf.if %lane_group_even -> (vector<8xf32>) {
