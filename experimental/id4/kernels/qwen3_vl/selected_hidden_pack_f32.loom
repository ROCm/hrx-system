config.decl @id4.qwen3_vl.selected_hidden_pack.token_count : %value: index where [range(%value, 1, 65536)]

config.decl @id4.qwen3_vl.selected_hidden_pack.hidden_size : %value: index where [range(%value, 1, 65536)]

config.decl @id4.qwen3_vl.selected_hidden_pack.hidden_row_count : %value: index where [range(%value, 1, 1048576)]

config.decl @id4.qwen3_vl.selected_hidden_pack.selected_layer_index : %value: index where [range(%value, 0, 1024)]

kernel.def export("id4_qwen3_vl_selected_hidden_pack_f32") @id4_qwen3_vl_selected_hidden_pack_f32() {
  %unit = index.constant 1 : index
  %workgroup_size_x = index.constant 256 : index
  %token_count = config.get @id4.qwen3_vl.selected_hidden_pack.token_count : index
  %hidden_size = config.get @id4.qwen3_vl.selected_hidden_pack.hidden_size : index
  %element_count = index.mul %token_count, %hidden_size : index
  %rounding = index.sub %workgroup_size_x, %unit : index
  %rounded = index.add %element_count, %rounding : index
  %workgroups_x = index.div %rounded, %workgroup_size_x : index
  kernel.launch.config workgroups(%workgroups_x, %unit, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%hidden_states: buffer, %selected_hidden_states: buffer) {
  %base = index.constant 0 : offset
  %workgroup = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %workgroup_size_x = index.constant 256 : index
  %token_count = config.get @id4.qwen3_vl.selected_hidden_pack.token_count : index
  %hidden_size = config.get @id4.qwen3_vl.selected_hidden_pack.hidden_size : index
  %hidden_row_count = config.get @id4.qwen3_vl.selected_hidden_pack.hidden_row_count : index
  %selected_layer_index = config.get @id4.qwen3_vl.selected_hidden_pack.selected_layer_index : index
  %selected_layer_count = index.div %hidden_row_count, %hidden_size : index
  %element_count = index.mul %token_count, %hidden_size : index
  %element_index = index.madd %workgroup, %workgroup_size_x, %lane : index
  %in_bounds = index.cmp ult, %element_index, %element_count : index
  %hidden_noalias, %selected_noalias = buffer.assume.noalias %hidden_states, %selected_hidden_states : buffer, buffer
  %hidden_global = buffer.assume.memory_space<global> %hidden_noalias : buffer
  %selected_global = buffer.assume.memory_space<global> %selected_noalias : buffer
  %hidden_view = buffer.view %hidden_global[%base] : buffer -> view<[%token_count]x[%hidden_size]xf32, #dense>
  %selected_view = buffer.view %selected_global[%base] : buffer -> view<[%hidden_row_count]x[%token_count]xf32, #dense>
  scf.if %in_bounds {
    %token = index.div %element_index, %hidden_size : index
    %channel = index.rem %element_index, %hidden_size : index
    %channel_base = index.mul %channel, %selected_layer_count : index
    %row = index.add %channel_base, %selected_layer_index : index
    %value = view.load %hidden_view[%token, %channel] : view<[%token_count]x[%hidden_size]xf32, #dense> -> f32
    view.store %value, %selected_view[%row, %token] : f32, view<[%hidden_row_count]x[%token_count]xf32, #dense>
  }
  kernel.return
}

