config.decl @id4.tensor.zero_tail.element_count : %value: index where [range(%value, 0, 268435456)]

config.decl @id4.tensor.zero_tail.dispatch_element_count : %value: index where [range(%value, 1, 268435456)]

kernel.def export("id4_tensor_zero_tail_bf16") @id4_tensor_zero_tail_bf16() {
  %unit = index.constant 1 : index
  %workgroup_size_x = index.constant 256 : index
  %element_count = config.get @id4.tensor.zero_tail.element_count : index
  %dispatch_element_count = config.get @id4.tensor.zero_tail.dispatch_element_count : index
  %tail_element_count = index.sub %dispatch_element_count, %element_count : index
  %rounding = index.sub %workgroup_size_x, %unit : index
  %rounded = index.add %tail_element_count, %rounding : index
  %workgroups_x = index.div %rounded, %workgroup_size_x : index
  kernel.launch.config workgroups(%workgroups_x, %unit, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%output: buffer) {
  %base = index.constant 0 : offset
  %workgroup = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %workgroup_size_x = index.constant 256 : index
  %element_count = config.get @id4.tensor.zero_tail.element_count : index
  %dispatch_element_count = config.get @id4.tensor.zero_tail.dispatch_element_count : index
  %tail_element_count = index.sub %dispatch_element_count, %element_count : index
  %tail_index = index.madd %workgroup, %workgroup_size_x, %lane : index
  %in_bounds = index.cmp ult, %tail_index, %tail_element_count : index
  %output_noalias = buffer.assume.noalias %output : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  %output_view = buffer.view %output_global[%base] : buffer -> view<[%dispatch_element_count]xbf16, #dense>
  %zero = scalar.constant 0.0 : bf16
  scf.if %in_bounds {
    %element_index = index.add %element_count, %tail_index : index
    view.store %zero, %output_view[%element_index] : bf16, view<[%dispatch_element_count]xbf16, #dense>
  }
  kernel.return
}

check.case public @id4_tensor_zero_tail_bf16_all_case {
  %output = check.generate.fill value(1.0) : tensor<8xbf16>
  %expected = check.generate.fill value(0.0) : tensor<8xbf16>
  func.call @id4_tensor_zero_tail_bf16(%output) : (tensor<8xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<8xbf16>
  check.return
}

check.benchmark<@id4_tensor_zero_tail_bf16_all_case> @id4_tensor_zero_tail_bf16_all
