config.decl @id4.parameter.fp8_e4m3_scaled_to_bf16.output_size : %value: index where [range(%value, 1, 131072)]

config.decl @id4.parameter.fp8_e4m3_scaled_to_bf16.input_size : %value: index where [range(%value, 1, 131072)]

kernel.def export("id4_parameter_fp8_e4m3_scaled_to_bf16") @id4_parameter_fp8_e4m3_scaled_to_bf16() {
  %unit = index.constant 1 : index
  %workgroup_size_x = index.constant 256 : index
  %output_size = config.get @id4.parameter.fp8_e4m3_scaled_to_bf16.output_size : index
  %input_size = config.get @id4.parameter.fp8_e4m3_scaled_to_bf16.input_size : index
  %element_count = index.mul %output_size, %input_size : index
  %rounding = index.sub %workgroup_size_x, %unit : index
  %rounded = index.add %element_count, %rounding : index
  %workgroups_x = index.div %rounded, %workgroup_size_x : index
  kernel.launch.config workgroups(%workgroups_x, %unit, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%weight: buffer, %scale: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %workgroup_size_x = index.constant 256 : index
  %workgroup = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %output_size = config.get @id4.parameter.fp8_e4m3_scaled_to_bf16.output_size : index
  %input_size = config.get @id4.parameter.fp8_e4m3_scaled_to_bf16.input_size : index
  %element_count = index.mul %output_size, %input_size : index
  %element_index = index.madd %workgroup, %workgroup_size_x, %lane : index
  %in_bounds = index.cmp ult, %element_index, %element_count : index
  %weight_noalias, %scale_noalias, %output_noalias = buffer.assume.noalias %weight, %scale, %output : buffer, buffer, buffer
  %weight_global = buffer.assume.memory_space<global> %weight_noalias : buffer
  %scale_global = buffer.assume.memory_space<global> %scale_noalias : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  %dense = encoding.layout.dense : encoding<layout>
  %fp8_e4m3fn = encoding.define #fp8_e4m3fn : encoding<schema>
  %fp8_storage = encoding.define #physical_storage {layout = %dense : encoding<layout>, schema = %fp8_e4m3fn : encoding<schema>} : encoding<storage>
  %weight_view = buffer.view %weight_global[%base] : buffer -> view<[%output_size]x[%input_size]xf8E4M3, %fp8_storage>
  %scale_view = buffer.view %scale_global[%base] : buffer -> view<[%output_size]xf32, #dense>
  %output_view = buffer.view %output_global[%base] : buffer -> view<[%output_size]x[%input_size]xbf16, #dense>
  scf.if %in_bounds {
    %input = index.rem %element_index, %input_size : index
    %output_row = index.div %element_index, %input_size : index
    %weight_fp8 = view.load %weight_view[%output_row, %input] : view<[%output_size]x[%input_size]xf8E4M3, %fp8_storage> -> f8E4M3
    %weight_f32 = scalar.extf %weight_fp8 : f8E4M3 to f32
    %scale_f32 = view.load %scale_view[%output_row] : view<[%output_size]xf32, #dense> -> f32
    %scaled = scalar.mulf<reassoc|nsz|contract> %weight_f32, %scale_f32 : f32
    %rounded = scalar.fptrunc %scaled : f32 to bf16
    view.store %rounded, %output_view[%output_row, %input] : bf16, view<[%output_size]x[%input_size]xbf16, #dense>
  }
  kernel.return
}

