  %input_size = config.get @id4.parameter.fp8_e4m3_scaled_to_bf16_linear_rhs_tile.input_size : index
  %element_count = index.mul %output_size, %input_size : index
  %weight_noalias, %scale_noalias, %target_noalias = buffer.assume.noalias %weight, %scale, %target : buffer, buffer, buffer
  %weight_global = buffer.assume.memory_space<global> %weight_noalias : buffer
  %scale_global = buffer.assume.memory_space<global> %scale_noalias : buffer
  %target_global = buffer.assume.memory_space<global> %target_noalias : buffer
  %weight_view = buffer.view %weight_global[%base] : buffer -> view<[%output_size]x[%input_size]xf8E4M3, #dense>
  %scale_view = buffer.view %scale_global[%base] : buffer -> view<[%output_size]xf32, #dense>
  %target_view = buffer.view %target_global[%base] : buffer -> view<[%element_count]xbf16, #dense>
  %input_tile_count = index.div %input_size, %sixteen : index
  %segment = index.rem %lane, %two : index
  %output_lane = index.div %lane, %two : index
  %segment_offset = index.mul %segment, %eight : index
  %input = index.madd %input_tile, %sixteen, %segment_offset : index
  %output_row = index.madd %output_tile, %sixteen, %output_lane : index
  %tile = index.madd %output_tile, %input_tile_count, %input_tile : index
  %tile_element_count = index.constant 256 : index
  %tile_offset = index.mul %tile, %tile_element_count : index
  %row_offset = index.mul %output_lane, %sixteen : index
  %tile_element = index.add %row_offset, %segment_offset : index
  %target_index = index.add %tile_offset, %tile_element : index
  %weight_fp8 = vector.load %weight_view[%output_row, %input] : view<[%output_size]x[%input_size]xf8E4M3, #dense> -> vector<8xf8E4M3>
  %weight_f32 = vector.extf %weight_fp8 : vector<8xf8E4M3> to vector<8xf32>
  %scale_f32 = view.load %scale_view[%output_row] : view<[%output_size]xf32, #dense> -> f32
  %scale_values = vector.splat %scale_f32 : vector<8xf32>
  %scaled = vector.mulf<reassoc|nnan|ninf|nsz|contract> %weight_f32, %scale_values : vector<8xf32>
  %rounded = vector.fptrunc %scaled : vector<8xf32> to vector<8xbf16>
  vector.store %rounded, %target_view[%target_index] : vector<8xbf16>, view<[%element_count]xbf16, #dense>
