} launch(%weight: buffer, %scale: buffer, %target: buffer) {
  %base = index.constant 0 : offset
  %sixteen = index.constant 16 : index
  %two_fifty_six = index.constant 256 : index
  %workgroup = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %workgroup_size_x = index.constant 256 : index
  %output_size = config.get @id4.parameter.fp8_e4m3_scaled_to_bf16_linear_rhs_tile.output_size : index
  %input_size = config.get @id4.parameter.fp8_e4m3_scaled_to_bf16_linear_rhs_tile.input_size : index
  %element_count = index.mul %output_size, %input_size : index
  %element_index = index.madd %workgroup, %workgroup_size_x, %lane : index
  %in_bounds = index.cmp ult, %element_index, %element_count : index
  %weight_noalias, %scale_noalias, %target_noalias = buffer.assume.noalias %weight, %scale, %target : buffer, buffer, buffer
  %weight_global = buffer.assume.memory_space<global> %weight_noalias : buffer
  %scale_global = buffer.assume.memory_space<global> %scale_noalias : buffer
