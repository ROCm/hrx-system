config.decl @id4.vae.spatial_attention.width : %value: index where [range(%value, 1, 65536)]
config.decl @id4.vae.spatial_attention.height : %value: index where [range(%value, 1, 65536)]
config.decl @id4.vae.spatial_attention.channel_count : %value: index where [range(%value, 1, 4096)]
config.decl @id4.vae.spatial_attention.batch_count : %value: index where [range(%value, 1, 1024)]
config.decl @id4.vae.spatial_attention.token_count : %value: index where [range(%value, 1, 268435456)]

kernel.def export("id4_vae_spatial_attention_f32") @id4_vae_spatial_attention_f32() {
  %unit = index.constant 1 : index
  %workgroup_size_x = index.constant 256 : index
  %token_count = config.get @id4.vae.spatial_attention.token_count : index
  %batch_count = config.get @id4.vae.spatial_attention.batch_count : index
  kernel.launch.config workgroups(%token_count, %batch_count, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%query: buffer, %key: buffer, %value: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %unit = index.constant 1 : index
  %workgroup_size_x = index.constant 256 : index
  %query_token = kernel.workgroup.id<x> : index
  %batch = kernel.workgroup.id<y> : index
  %lane = kernel.workitem.id<x> : index
  %zero_f32 = scalar.constant 0.0 : f32
  %negative_large = scalar.constant -1000000000.0 : f32
  %width = config.get @id4.vae.spatial_attention.width : index
  %height = config.get @id4.vae.spatial_attention.height : index
  %channel_count = config.get @id4.vae.spatial_attention.channel_count : index
  %batch_count = config.get @id4.vae.spatial_attention.batch_count : index
  %token_count = config.get @id4.vae.spatial_attention.token_count : index
  %channel_count_i32 = index.cast %channel_count : index to i32
  %channel_count_f32 = scalar.sitofp %channel_count_i32 : i32 to f32
  %attention_scale = scalar.rsqrtf<nnan|ninf|nsz|afn> %channel_count_f32 : f32

  %query_noalias, %key_noalias, %value_noalias, %output_noalias = buffer.assume.noalias %query, %key, %value, %output : buffer, buffer, buffer, buffer
  %query_global = buffer.assume.memory_space<global> %query_noalias : buffer
  %key_global = buffer.assume.memory_space<global> %key_noalias : buffer
  %value_global = buffer.assume.memory_space<global> %value_noalias : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  %query_view = buffer.view %query_global[%base] : buffer -> view<[%width]x[%height]x[%channel_count]x[%batch_count]xf32, #dense>
  %key_view = buffer.view %key_global[%base] : buffer -> view<[%width]x[%height]x[%channel_count]x[%batch_count]xf32, #dense>
  %value_view = buffer.view %value_global[%base] : buffer -> view<[%width]x[%height]x[%channel_count]x[%batch_count]xf32, #dense>
  %output_view = buffer.view %output_global[%base] : buffer -> view<[%width]x[%height]x[%channel_count]x[%batch_count]xf32, #dense>

  %query_x = index.rem %query_token, %width : index
  %query_y = index.div %query_token, %width : index
  %channel1 = index.add %lane, %workgroup_size_x : index
  %valid0 = index.cmp ult, %lane, %channel_count : index
  %valid1 = index.cmp ult, %channel1, %channel_count : index

  %query0 = scf.if %valid0 -> (f32) {
    %loaded = view.load %query_view[%query_x, %query_y, %lane, %batch] : view<[%width]x[%height]x[%channel_count]x[%batch_count]xf32, #dense> -> f32
    scf.yield %loaded : f32
  } else {
    scf.yield %zero_f32 : f32
  }
  %query1 = scf.if %valid1 -> (f32) {
    %loaded = view.load %query_view[%query_x, %query_y, %channel1, %batch] : view<[%width]x[%height]x[%channel_count]x[%batch_count]xf32, #dense> -> f32
    scf.yield %loaded : f32
  } else {
    scf.yield %zero_f32 : f32
  }

  %softmax_max, %softmax_sum, %acc0, %acc1 = scf.for %key_token = [%zero to %token_count step %unit](%current_max = %negative_large : f32, %current_sum = %zero_f32 : f32, %current_acc0 = %zero_f32 : f32, %current_acc1 = %zero_f32 : f32) -> (f32, f32, f32, f32) {
    %key_x = index.rem %key_token, %width : index
    %key_y = index.div %key_token, %width : index
    %partial0 = scf.if %valid0 -> (f32) {
      %key0 = view.load %key_view[%key_x, %key_y, %lane, %batch] : view<[%width]x[%height]x[%channel_count]x[%batch_count]xf32, #dense> -> f32
      %product0 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %query0, %key0 : f32
      scf.yield %product0 : f32
    } else {
      scf.yield %zero_f32 : f32
    }
    %partial1 = scf.if %valid1 -> (f32) {
      %key1 = view.load %key_view[%key_x, %key_y, %channel1, %batch] : view<[%width]x[%height]x[%channel_count]x[%batch_count]xf32, #dense> -> f32
      %product1 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %query1, %key1 : f32
      scf.yield %product1 : f32
    } else {
      scf.yield %zero_f32 : f32
    }
    %lane_dot = scalar.addf<reassoc|nnan|ninf|nsz> %partial0, %partial1 : f32
    %dot = kernel.workgroup.reduce<addf> %lane_dot : f32
    %score = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %dot, %attention_scale : f32
    %next_max = scalar.maxnumf %current_max, %score : f32
    %old_delta = scalar.subf<reassoc|nnan|ninf|nsz> %current_max, %next_max : f32
    %old_scale = scalar.expf<afn> %old_delta : f32
    %score_delta = scalar.subf<reassoc|nnan|ninf|nsz> %score, %next_max : f32
    %weight = scalar.expf<afn> %score_delta : f32
    %scaled_sum = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %current_sum, %old_scale : f32
    %next_sum = scalar.addf<reassoc|nnan|ninf|nsz> %scaled_sum, %weight : f32
    %scaled_acc0 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %current_acc0, %old_scale : f32
    %next_acc0 = scf.if %valid0 -> (f32) {
      %value0 = view.load %value_view[%key_x, %key_y, %lane, %batch] : view<[%width]x[%height]x[%channel_count]x[%batch_count]xf32, #dense> -> f32
      %weighted_value0 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %weight, %value0 : f32
      %accumulated0 = scalar.addf<reassoc|nnan|ninf|nsz> %scaled_acc0, %weighted_value0 : f32
      scf.yield %accumulated0 : f32
    } else {
      scf.yield %scaled_acc0 : f32
    }
    %scaled_acc1 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %current_acc1, %old_scale : f32
    %next_acc1 = scf.if %valid1 -> (f32) {
      %value1 = view.load %value_view[%key_x, %key_y, %channel1, %batch] : view<[%width]x[%height]x[%channel_count]x[%batch_count]xf32, #dense> -> f32
      %weighted_value1 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %weight, %value1 : f32
      %accumulated1 = scalar.addf<reassoc|nnan|ninf|nsz> %scaled_acc1, %weighted_value1 : f32
      scf.yield %accumulated1 : f32
    } else {
      scf.yield %scaled_acc1 : f32
    }
    scf.yield %next_max, %next_sum, %next_acc0, %next_acc1 : f32, f32, f32, f32
  }

  scf.if %valid0 {
    %output0 = scalar.divf<nnan|ninf|nsz|arcp> %acc0, %softmax_sum : f32
    view.store %output0, %output_view[%query_x, %query_y, %lane, %batch] : f32, view<[%width]x[%height]x[%channel_count]x[%batch_count]xf32, #dense>
  }
  scf.if %valid1 {
    %output1 = scalar.divf<nnan|ninf|nsz|arcp> %acc1, %softmax_sum : f32
    view.store %output1, %output_view[%query_x, %query_y, %channel1, %batch] : f32, view<[%width]x[%height]x[%channel_count]x[%batch_count]xf32, #dense>
  }
  kernel.return
}

check.case public @id4_vae_spatial_attention_f32_single_token_case {
  %query = check.generate.fill value(0.0) : tensor<1x1x2x1xf32>
  %key = check.generate.fill value(0.0) : tensor<1x1x2x1xf32>
  %value = check.generate.iota offset(3.0) step(2.0) : tensor<1x1x2x1xf32>
  %output = check.generate.fill value(0.0) : tensor<1x1x2x1xf32>
  func.call @id4_vae_spatial_attention_f32(%query, %key, %value, %output) : (tensor<1x1x2x1xf32>, tensor<1x1x2x1xf32>, tensor<1x1x2x1xf32>, tensor<1x1x2x1xf32>)
  check.expect.close actual(%output) expected(%value) atol(0.0001) rtol(0.0001) nan(same) : tensor<1x1x2x1xf32>
  check.return
}

check.case public @id4_vae_spatial_attention_f32_uniform_softmax_case {
  %query = check.generate.fill value(0.0) : tensor<2x1x2x1xf32>
  %key = check.generate.fill value(0.0) : tensor<2x1x2x1xf32>
  %value = check.file.read.npy path("testdata/vae_spatial_attention_f32_uniform_value.npy") : tensor<2x1x2x1xf32>
  %output = check.generate.fill value(0.0) : tensor<2x1x2x1xf32>
  %expected = check.file.read.npy path("testdata/vae_spatial_attention_f32_uniform_expected.npy") : tensor<2x1x2x1xf32>
  func.call @id4_vae_spatial_attention_f32(%query, %key, %value, %output) : (tensor<2x1x2x1xf32>, tensor<2x1x2x1xf32>, tensor<2x1x2x1xf32>, tensor<2x1x2x1xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0001) rtol(0.0001) nan(same) : tensor<2x1x2x1xf32>
  check.return
}

check.case public @id4_vae_spatial_attention_f32_flux2_mid_block_shape_case {
  %query = check.generate.fill value(0.0) : tensor<128x128x512x1xf32>
  %key = check.generate.fill value(0.0) : tensor<128x128x512x1xf32>
  %value = check.generate.fill value(7.0) : tensor<128x128x512x1xf32>
  %output = check.generate.fill value(0.0) : tensor<128x128x512x1xf32>
  %expected = check.generate.fill value(7.0) : tensor<128x128x512x1xf32>
  func.call @id4_vae_spatial_attention_f32(%query, %key, %value, %output) : (tensor<128x128x512x1xf32>, tensor<128x128x512x1xf32>, tensor<128x128x512x1xf32>, tensor<128x128x512x1xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0001) rtol(0.0001) nan(same) : tensor<128x128x512x1xf32>
  check.return
}

check.benchmark<@id4_vae_spatial_attention_f32_single_token_case> @id4_vae_spatial_attention_f32_single_token
check.benchmark<@id4_vae_spatial_attention_f32_uniform_softmax_case> @id4_vae_spatial_attention_f32_uniform_softmax
check.benchmark<@id4_vae_spatial_attention_f32_flux2_mid_block_shape_case> @id4_vae_spatial_attention_f32_flux2_mid_block_shape
