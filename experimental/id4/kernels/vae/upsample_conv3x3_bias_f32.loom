config.decl @id4.vae.upsample_conv3x3_bias.input_width : %value: index where [range(%value, 1, 65536)]
config.decl @id4.vae.upsample_conv3x3_bias.input_height : %value: index where [range(%value, 1, 65536)]
config.decl @id4.vae.upsample_conv3x3_bias.channel_count : %value: index where [range(%value, 1, 4096)]
config.decl @id4.vae.upsample_conv3x3_bias.batch_count : %value: index where [range(%value, 1, 1024)]
config.decl @id4.vae.upsample_conv3x3_bias.output_width : %value: index where [range(%value, 1, 65536)]
config.decl @id4.vae.upsample_conv3x3_bias.output_height : %value: index where [range(%value, 1, 65536)]
config.decl @id4.vae.upsample_conv3x3_bias.output_element_count : %value: index where [range(%value, 1, 268435456)]

kernel.def export("id4_vae_upsample_conv3x3_bias_f32") @id4_vae_upsample_conv3x3_bias_f32() {
  %unit = index.constant 1 : index
  %workgroup_size_x = index.constant 256 : index
  %element_count = config.get @id4.vae.upsample_conv3x3_bias.output_element_count : index
  %rounding = index.sub %workgroup_size_x, %unit : index
  %rounded = index.add %element_count, %rounding : index
  %workgroups_x = index.div %rounded, %workgroup_size_x : index
  kernel.launch.config workgroups(%workgroups_x, %unit, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%input: buffer, %weight: buffer, %bias: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %unit = index.constant 1 : index
  %two = index.constant 2 : index
  %three = index.constant 3 : index
  %kernel_center = index.constant 1 : index
  %workgroup = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %workgroup_size_x = index.constant 256 : index
  %input_width = config.get @id4.vae.upsample_conv3x3_bias.input_width : index
  %input_height = config.get @id4.vae.upsample_conv3x3_bias.input_height : index
  %channel_count = config.get @id4.vae.upsample_conv3x3_bias.channel_count : index
  %batch_count = config.get @id4.vae.upsample_conv3x3_bias.batch_count : index
  %output_width = config.get @id4.vae.upsample_conv3x3_bias.output_width : index
  %output_height = config.get @id4.vae.upsample_conv3x3_bias.output_height : index
  %output_element_count = config.get @id4.vae.upsample_conv3x3_bias.output_element_count : index
  %element_index = index.madd %workgroup, %workgroup_size_x, %lane : index
  %in_bounds = index.cmp ult, %element_index, %output_element_count : index
  %zero_f32 = scalar.constant 0.0 : f32

  %input_noalias, %weight_noalias, %bias_noalias, %output_noalias = buffer.assume.noalias %input, %weight, %bias, %output : buffer, buffer, buffer, buffer
  %input_global = buffer.assume.memory_space<global> %input_noalias : buffer
  %weight_global = buffer.assume.memory_space<global> %weight_noalias : buffer
  %bias_global = buffer.assume.memory_space<global> %bias_noalias : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  %input_view = buffer.view %input_global[%base] : buffer -> view<[%input_width]x[%input_height]x[%channel_count]x[%batch_count]xf32, #dense>
  %weight_view = buffer.view %weight_global[%base] : buffer -> view<[%channel_count]x[%channel_count]x3x3xf32, #dense>
  %bias_view = buffer.view %bias_global[%base] : buffer -> view<[%channel_count]xf32, #dense>
  %output_view = buffer.view %output_global[%base] : buffer -> view<[%output_width]x[%output_height]x[%channel_count]x[%batch_count]xf32, #dense>

  scf.if %in_bounds {
    %output_x = index.rem %element_index, %output_width : index
    %row = index.div %element_index, %output_width : index
    %output_y = index.rem %row, %output_height : index
    %plane = index.div %row, %output_height : index
    %output_channel = index.rem %plane, %channel_count : index
    %batch = index.div %plane, %channel_count : index
    %last_output_x = index.sub %output_width, %unit : index
    %last_output_y = index.sub %output_height, %unit : index
    %is_left_edge = index.cmp eq, %output_x, %zero : index
    %kernel_x_begin = scf.if %is_left_edge -> (index) {
      scf.yield %unit : index
    } else {
      scf.yield %zero : index
    }
    %is_right_edge = index.cmp eq, %output_x, %last_output_x : index
    %kernel_x_end = scf.if %is_right_edge -> (index) {
      scf.yield %two : index
    } else {
      scf.yield %three : index
    }
    %is_top_edge = index.cmp eq, %output_y, %zero : index
    %kernel_y_begin = scf.if %is_top_edge -> (index) {
      scf.yield %unit : index
    } else {
      scf.yield %zero : index
    }
    %is_bottom_edge = index.cmp eq, %output_y, %last_output_y : index
    %kernel_y_end = scf.if %is_bottom_edge -> (index) {
      scf.yield %two : index
    } else {
      scf.yield %three : index
    }
    %dot_y = scf.for %kernel_y = [%kernel_y_begin to %kernel_y_end step %unit](%acc_y = %zero_f32 : f32) -> (f32) {
      %upsampled_y_with_kernel = index.add %output_y, %kernel_y : index
      %upsampled_y = index.sub %upsampled_y_with_kernel, %kernel_center : index
      %input_y = index.div %upsampled_y, %two : index
      %dot_x = scf.for %kernel_x = [%kernel_x_begin to %kernel_x_end step %unit](%acc_x = %acc_y : f32) -> (f32) {
        %upsampled_x_with_kernel = index.add %output_x, %kernel_x : index
        %upsampled_x = index.sub %upsampled_x_with_kernel, %kernel_center : index
        %input_x = index.div %upsampled_x, %two : index
        %dot_channel = scf.for %input_channel = [%zero to %channel_count step %unit](%acc_channel = %acc_x : f32) -> (f32) {
          %input_value = view.load %input_view[%input_x, %input_y, %input_channel, %batch] : view<[%input_width]x[%input_height]x[%channel_count]x[%batch_count]xf32, #dense> -> f32
          %weight_value = view.load %weight_view[%output_channel, %input_channel, %kernel_y, %kernel_x] : view<[%channel_count]x[%channel_count]x3x3xf32, #dense> -> f32
          %product = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %input_value, %weight_value : f32
          %next = scalar.addf<reassoc|nnan|ninf|nsz> %acc_channel, %product : f32
          scf.yield %next : f32
        }
        scf.yield %dot_channel : f32
      }
      scf.yield %dot_x : f32
    }
    %bias_value = view.load %bias_view[%output_channel] : view<[%channel_count]xf32, #dense> -> f32
    %value = scalar.addf<reassoc|nnan|ninf|nsz> %dot_y, %bias_value : f32
    view.store %value, %output_view[%output_x, %output_y, %output_channel, %batch] : f32, view<[%output_width]x[%output_height]x[%channel_count]x[%batch_count]xf32, #dense>
  }
  kernel.return
}

kernel.def export("id4_vae_upsample_conv3x3_bias_ic4_f32") @id4_vae_upsample_conv3x3_bias_ic4_f32() {
  %unit = index.constant 1 : index
  %workgroup_size_x = index.constant 256 : index
  %element_count = config.get @id4.vae.upsample_conv3x3_bias.output_element_count : index
  %rounding = index.sub %workgroup_size_x, %unit : index
  %rounded = index.add %element_count, %rounding : index
  %workgroups_x = index.div %rounded, %workgroup_size_x : index
  kernel.launch.config workgroups(%workgroups_x, %unit, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%input: buffer, %weight: buffer, %bias: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %unit = index.constant 1 : index
  %two = index.constant 2 : index
  %three = index.constant 3 : index
  %four = index.constant 4 : index
  %kernel_center = index.constant 1 : index
  %workgroup = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %workgroup_size_x = index.constant 256 : index
  %input_width = config.get @id4.vae.upsample_conv3x3_bias.input_width : index
  %input_height = config.get @id4.vae.upsample_conv3x3_bias.input_height : index
  %channel_count = config.get @id4.vae.upsample_conv3x3_bias.channel_count : index
  %batch_count0 = config.get @id4.vae.upsample_conv3x3_bias.batch_count : index
  %batch_count = index.assume %batch_count0 [range(%batch_count0, 1, 1)] : index
  %output_width = config.get @id4.vae.upsample_conv3x3_bias.output_width : index
  %output_height = config.get @id4.vae.upsample_conv3x3_bias.output_height : index
  %output_element_count = config.get @id4.vae.upsample_conv3x3_bias.output_element_count : index
  %element_index = index.madd %workgroup, %workgroup_size_x, %lane : index
  %in_bounds = index.cmp ult, %element_index, %output_element_count : index
  %zero_f32 = scalar.constant 0.0 : f32

  %input_noalias, %weight_noalias, %bias_noalias, %output_noalias = buffer.assume.noalias %input, %weight, %bias, %output : buffer, buffer, buffer, buffer
  %input_global = buffer.assume.memory_space<global> %input_noalias : buffer
  %weight_global = buffer.assume.memory_space<global> %weight_noalias : buffer
  %bias_global = buffer.assume.memory_space<global> %bias_noalias : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  %input_pixel_count = index.mul %input_width, %input_height : index
  %input_pixel_element_count = index.mul %input_pixel_count, %channel_count : index
  %input_element_count = index.mul %input_pixel_element_count, %batch_count : index
  %input_flat_view = buffer.view %input_global[%base] : buffer -> view<[%input_element_count]xf32, #dense>
  %weight_view = buffer.view %weight_global[%base] : buffer -> view<[%channel_count]x[%channel_count]x3x3xf32, #dense>
  %bias_view = buffer.view %bias_global[%base] : buffer -> view<[%channel_count]xf32, #dense>
  %output_view = buffer.view %output_global[%base] : buffer -> view<[%output_width]x[%output_height]x[%channel_count]x[%batch_count]xf32, #dense>

  scf.if %in_bounds {
    %output_x = index.rem %element_index, %output_width : index
    %row = index.div %element_index, %output_width : index
    %output_y = index.rem %row, %output_height : index
    %plane = index.div %row, %output_height : index
    %output_channel = index.rem %plane, %channel_count : index
    %batch = index.div %plane, %channel_count : index
    %last_output_x = index.sub %output_width, %unit : index
    %last_output_y = index.sub %output_height, %unit : index
    %is_left_edge = index.cmp eq, %output_x, %zero : index
    %kernel_x_begin = scf.if %is_left_edge -> (index) {
      scf.yield %unit : index
    } else {
      scf.yield %zero : index
    }
    %is_right_edge = index.cmp eq, %output_x, %last_output_x : index
    %kernel_x_end = scf.if %is_right_edge -> (index) {
      scf.yield %two : index
    } else {
      scf.yield %three : index
    }
    %is_top_edge = index.cmp eq, %output_y, %zero : index
    %kernel_y_begin = scf.if %is_top_edge -> (index) {
      scf.yield %unit : index
    } else {
      scf.yield %zero : index
    }
    %is_bottom_edge = index.cmp eq, %output_y, %last_output_y : index
    %kernel_y_end = scf.if %is_bottom_edge -> (index) {
      scf.yield %two : index
    } else {
      scf.yield %three : index
    }
    %vector_channel_tile_count = index.div %channel_count, %four : index
    %vector_channel_count = index.mul %vector_channel_tile_count, %four : index
    %dot_y = scf.for %kernel_y = [%kernel_y_begin to %kernel_y_end step %unit](%acc_y = %zero_f32 : f32) -> (f32) {
      %upsampled_y_with_kernel = index.add %output_y, %kernel_y : index
      %upsampled_y = index.sub %upsampled_y_with_kernel, %kernel_center : index
      %input_y = index.div %upsampled_y, %two : index
      %dot_x = scf.for %kernel_x = [%kernel_x_begin to %kernel_x_end step %unit](%acc_x = %acc_y : f32) -> (f32) {
        %upsampled_x_with_kernel = index.add %output_x, %kernel_x : index
        %upsampled_x = index.sub %upsampled_x_with_kernel, %kernel_center : index
        %input_x = index.div %upsampled_x, %two : index
        %dot_channel_vectors = scf.for %input_channel_base = [%zero to %vector_channel_count step %four](%acc_channel_vectors = %acc_x : f32) -> (f32) {
          %input_channel1 = index.add %input_channel_base, %unit : index
          %input_channel2 = index.add %input_channel_base, %two : index
          %input_channel3 = index.add %input_channel_base, %three : index
          %input_x_row_base = index.mul %input_x, %input_height : index
          %input_pixel_base = index.add %input_x_row_base, %input_y : index
          %input_pixel_element_base = index.mul %input_pixel_base, %channel_count : index
          %input_channel_element_base = index.add %input_pixel_element_base, %input_channel_base : index
          %input_batch_element_base = index.mul %input_channel_element_base, %batch_count : index
          %input_element0 = index.add %input_batch_element_base, %batch : index
          %last_valid_input_element = index.sub %input_element_count, %three : index
          %input_element = index.assume %input_element0 [ge(%input_element0, 0), lt(%input_element0, %last_valid_input_element)] : index
          %input_values = vector.load %input_flat_view[%input_element] : view<[%input_element_count]xf32, #dense> -> vector<4xf32>
          %weight_value0 = view.load %weight_view[%output_channel, %input_channel_base, %kernel_y, %kernel_x] : view<[%channel_count]x[%channel_count]x3x3xf32, #dense> -> f32
          %weight_value1 = view.load %weight_view[%output_channel, %input_channel1, %kernel_y, %kernel_x] : view<[%channel_count]x[%channel_count]x3x3xf32, #dense> -> f32
          %weight_value2 = view.load %weight_view[%output_channel, %input_channel2, %kernel_y, %kernel_x] : view<[%channel_count]x[%channel_count]x3x3xf32, #dense> -> f32
          %weight_value3 = view.load %weight_view[%output_channel, %input_channel3, %kernel_y, %kernel_x] : view<[%channel_count]x[%channel_count]x3x3xf32, #dense> -> f32
          %weight_values = vector.from_elements %weight_value0, %weight_value1, %weight_value2, %weight_value3 : vector<4xf32>
          %products = vector.mulf<reassoc|nnan|ninf|nsz|contract> %input_values, %weight_values : vector<4xf32>
          %partial = vector.reduce<addf, reassoc|nnan|ninf|nsz> %products, %zero_f32 : vector<4xf32>, f32
          %next = scalar.addf<reassoc|nnan|ninf|nsz> %acc_channel_vectors, %partial : f32
          scf.yield %next : f32
        }
        scf.yield %dot_channel_vectors : f32
      }
      scf.yield %dot_x : f32
    }
    %bias_value = view.load %bias_view[%output_channel] : view<[%channel_count]xf32, #dense> -> f32
    %value = scalar.addf<reassoc|nnan|ninf|nsz> %dot_y, %bias_value : f32
    view.store %value, %output_view[%output_x, %output_y, %output_channel, %batch] : f32, view<[%output_width]x[%output_height]x[%channel_count]x[%batch_count]xf32, #dense>
  }
  kernel.return
}

