  %eight = index.constant 8 : index
  %nine = index.constant 9 : index
  %sixteen = index.constant 16 : index
  %thirty_two = index.constant 32 : index
  %kernel_center = index.constant 1 : index
  %workgroup_size_x = index.constant 32 : index
  %width = config.get @id4.vae.conv3x3_bias.width : index
  %height = config.get @id4.vae.conv3x3_bias.height : index
  %input_channel_count = config.get @id4.vae.conv3x3_bias.input_channel_count : index
  %output_channel_count = config.get @id4.vae.conv3x3_bias.output_channel_count : index
  %batch_count0 = config.get @id4.vae.conv3x3_bias.batch_count : index
  %batch_count = index.assume %batch_count0 [range(%batch_count0, 1, 1)] : index
  %output_element_count = config.get @id4.vae.conv3x3_bias.output_element_count : index
  %zero_f32 = scalar.constant 0.0 : f32
  %zero_bf16 = scalar.fptrunc %zero_f32 : f32 to bf16
  %zero_acc = vector.constant 0.0 : vector<8xf32>
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %rhs_scratch_layout = encoding.layout.strided [1, %sixteen] : encoding<layout>
  %input_noalias, %weight_noalias, %bias_noalias, %shortcut_noalias, %output_noalias = buffer.assume.noalias %input, %weight, %bias, %shortcut, %output : buffer, buffer, buffer, buffer, buffer
  %input_global = buffer.assume.memory_space<global> %input_noalias : buffer
  %weight_global = buffer.assume.memory_space<global> %weight_noalias : buffer
  %bias_global = buffer.assume.memory_space<global> %bias_noalias : buffer
  %shortcut_global = buffer.assume.memory_space<global> %shortcut_noalias : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  %input_pixel_count = index.mul %width, %height : index
  %pixel_count = index.mul %input_pixel_count, %batch_count : index
  %input_pixel_element_count = index.mul %input_pixel_count, %input_channel_count : index
  %input_element_count = index.mul %input_pixel_element_count, %batch_count : index
  %input_flat_view = buffer.view %input_global[%base] : buffer -> view<[%input_element_count]xbf16, #dense>
  %weight_view = buffer.view %weight_global[%base] : buffer -> view<[%input_channel_count]x3x3x[%output_channel_count]xbf16, #dense>
  %bias_view = buffer.view %bias_global[%base] : buffer -> view<[%output_channel_count]xbf16, #dense>
  %shortcut_flat_view = buffer.view %shortcut_global[%base] : buffer -> view<[%output_element_count]xbf16, #dense>
  %output_flat_view = buffer.view %output_global[%base] : buffer -> view<[%output_element_count]xbf16, #dense>
  %lhs_scratch = buffer.alloca %lhs_scratch_bytes {base_alignment = 16, memory_space = workgroup} : buffer
  %rhs_scratch = buffer.alloca %rhs_scratch_bytes {base_alignment = 16, memory_space = workgroup} : buffer
  %lhs_scratch_view = buffer.view %lhs_scratch[%base] : buffer -> view<32x16xbf16, #dense>
  %rhs_scratch_view = buffer.view %rhs_scratch[%base] : buffer -> view<16x32xbf16, %rhs_scratch_layout>
  %pixel_origin = index.mul %pixel_tile, %thirty_two : index
  %pixel_origin_high = index.add %pixel_origin, %sixteen : index
  %output_channel_origin = index.mul %output_channel_tile, %thirty_two : index
  %output_channel_origin_high = index.add %output_channel_origin, %sixteen : index
  %reduction_count0 = index.mul %input_channel_count, %nine : index
  %reduction_count = index.assume %reduction_count0 [range(%reduction_count0, 9, 36864)] : index
  %reduction_rounding = index.sub %sixteen, %unit : index
  %reduction_rounded = index.add %reduction_count, %reduction_rounding : index
  %k_tile_count = index.div %reduction_rounded, %sixteen : index
  %kernel_y_span = index.mul %input_channel_count, %three : index
  %last_x = index.sub %width, %unit : index
  %last_y = index.sub %height, %unit : index
  %init00 = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>
  %init01 = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>
  %init10 = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>
  %init11 = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>
  %result00, %result01, %result10, %result11 = scf.for %k_tile = [%zero to %k_tile_count step %unit](%acc00 = %init00 : vector<8xf32>, %acc01 = %init01 : vector<8xf32>, %acc10 = %init10 : vector<8xf32>, %acc11 = %init11 : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
    %k_origin = index.mul %k_tile, %sixteen : index
    %lhs_element_count = index.constant 512 : index
    scf.for %lhs_linear = [%lane to %lhs_element_count step %workgroup_size_x] {
      %local_pixel = index.div %lhs_linear, %sixteen : index
      %local_crs = index.rem %lhs_linear, %sixteen : index
      %global_pixel = index.add %pixel_origin, %local_pixel : index
      %global_crs = index.add %k_origin, %local_crs : index
      %pixel_valid = index.cmp ult, %global_pixel, %pixel_count : index
      %crs_valid = index.cmp ult, %global_crs, %reduction_count : index
      %valid = scalar.andi %pixel_valid, %crs_valid : i1
      %lhs_value = scf.if %valid -> (bf16) {
        %global_pixel_valid = index.assume %global_pixel [ge(%global_pixel, 0), lt(%global_pixel, %pixel_count)] : index
        %global_crs_valid = index.assume %global_crs [ge(%global_crs, 0), lt(%global_crs, %reduction_count)] : index
        %kernel_y0 = index.div %global_crs_valid, %kernel_y_span : index
        %kernel_y = index.assume %kernel_y0 [range(%kernel_y0, 0, 2)] : index
        %after_y0 = index.rem %global_crs_valid, %kernel_y_span : index
        %after_y = index.assume %after_y0 [ge(%after_y0, 0), lt(%after_y0, %kernel_y_span)] : index
        %kernel_x0 = index.div %after_y, %input_channel_count : index
        %kernel_x = index.assume %kernel_x0 [range(%kernel_x0, 0, 2)] : index
        %input_channel0 = index.rem %after_y, %input_channel_count : index
        %input_channel = index.assume %input_channel0 [ge(%input_channel0, 0), lt(%input_channel0, %input_channel_count)] : index
        %y0 = index.rem %global_pixel_valid, %height : index
        %y = index.assume %y0 [ge(%y0, 0), lt(%y0, %height)] : index
        %row = index.div %global_pixel_valid, %height : index
        %x0 = index.rem %row, %width : index
        %x = index.assume %x0 [ge(%x0, 0), lt(%x0, %width)] : index
        %batch0 = index.div %row, %width : index
        %batch = index.assume %batch0 [range(%batch0, 0, 0)] : index
        %x_is_left = index.cmp eq, %x, %zero : index
        %x_is_right = index.cmp eq, %x, %last_x : index
        %y_is_top = index.cmp eq, %y, %zero : index
        %y_is_bottom = index.cmp eq, %y, %last_y : index
        %kernel_x_is_zero = index.cmp eq, %kernel_x, %zero : index
        %kernel_x_is_two = index.cmp eq, %kernel_x, %two : index
        %kernel_y_is_zero = index.cmp eq, %kernel_y, %zero : index
        %kernel_y_is_two = index.cmp eq, %kernel_y, %two : index
        %invalid_left = scalar.andi %x_is_left, %kernel_x_is_zero : i1
        %invalid_right = scalar.andi %x_is_right, %kernel_x_is_two : i1
        %invalid_top = scalar.andi %y_is_top, %kernel_y_is_zero : i1
        %invalid_bottom = scalar.andi %y_is_bottom, %kernel_y_is_two : i1
        %invalid_x = scalar.ori %invalid_left, %invalid_right : i1
        %invalid_y = scalar.ori %invalid_top, %invalid_bottom : i1
        %invalid_tap = scalar.ori %invalid_x, %invalid_y : i1
        %tap_value = scf.if %invalid_tap -> (bf16) {
          scf.yield %zero_bf16 : bf16
        } else {
          %input_y_with_kernel = index.add %y, %kernel_y : index
          %input_y_with_kernel_valid = index.assume %input_y_with_kernel [ge(%input_y_with_kernel, 1), le(%input_y_with_kernel, %height)] : index
          %input_y0 = index.sub %input_y_with_kernel_valid, %kernel_center : index
          %input_y = index.assume %input_y0 [ge(%input_y0, 0), lt(%input_y0, %height)] : index
          %input_x_with_kernel = index.add %x, %kernel_x : index
          %input_x_with_kernel_valid = index.assume %input_x_with_kernel [ge(%input_x_with_kernel, 1), le(%input_x_with_kernel, %width)] : index
          %input_x0 = index.sub %input_x_with_kernel_valid, %kernel_center : index
          %input_x = index.assume %input_x0 [ge(%input_x0, 0), lt(%input_x0, %width)] : index
          %input_x_row_base = index.mul %input_x, %height : index
          %input_pixel_base = index.add %input_x_row_base, %input_y : index
          %input_pixel_element_base = index.mul %input_pixel_base, %input_channel_count : index
          %input_channel_element = index.add %input_pixel_element_base, %input_channel : index
          %input_batch_base = index.mul %input_channel_element, %batch_count : index
          %input_element0 = index.add %input_batch_base, %batch : index
          %input_element = index.assume %input_element0 [ge(%input_element0, 0), lt(%input_element0, %input_element_count)] : index
          %loaded = view.load %input_flat_view[%input_element] : view<[%input_element_count]xbf16, #dense> -> bf16
          scf.yield %loaded : bf16
        }
        scf.yield %tap_value : bf16
      } else {
        scf.yield %zero_bf16 : bf16
      }
      view.store %lhs_value, %lhs_scratch_view[%local_pixel, %local_crs] : bf16, view<32x16xbf16, #dense>
    }
    %rhs_element_count = index.constant 512 : index
    scf.for %rhs_linear = [%lane to %rhs_element_count step %workgroup_size_x] {
      %local_crs = index.div %rhs_linear, %thirty_two : index
      %local_output_channel = index.rem %rhs_linear, %thirty_two : index
      %global_crs = index.add %k_origin, %local_crs : index
      %output_channel = index.add %output_channel_origin, %local_output_channel : index
      %crs_valid = index.cmp ult, %global_crs, %reduction_count : index
      %rhs_value = scf.if %crs_valid -> (bf16) {
        %global_crs_valid = index.assume %global_crs [ge(%global_crs, 0), lt(%global_crs, %reduction_count)] : index
        %kernel_y0 = index.div %global_crs_valid, %kernel_y_span : index
        %kernel_y = index.assume %kernel_y0 [range(%kernel_y0, 0, 2)] : index
        %after_y0 = index.rem %global_crs_valid, %kernel_y_span : index
        %after_y = index.assume %after_y0 [ge(%after_y0, 0), lt(%after_y0, %kernel_y_span)] : index
        %kernel_x0 = index.div %after_y, %input_channel_count : index
        %kernel_x = index.assume %kernel_x0 [range(%kernel_x0, 0, 2)] : index
        %input_channel0 = index.rem %after_y, %input_channel_count : index
        %input_channel = index.assume %input_channel0 [ge(%input_channel0, 0), lt(%input_channel0, %input_channel_count)] : index
        %loaded = view.load %weight_view[%input_channel, %kernel_y, %kernel_x, %output_channel] : view<[%input_channel_count]x3x3x[%output_channel_count]xbf16, #dense> -> bf16
        scf.yield %loaded : bf16
      } else {
        scf.yield %zero_bf16 : bf16
      }
      view.store %rhs_value, %rhs_scratch_view[%local_crs, %local_output_channel] : bf16, view<16x32xbf16, %rhs_scratch_layout>
    }
    kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
    %lhs0 = vector.fragment.load<lhs> %lhs_scratch_view[%zero, %zero] shape [%m, %k] : view<32x16xbf16, #dense> -> vector<16xbf16>
    %lhs1 = vector.fragment.load<lhs> %lhs_scratch_view[%sixteen, %zero] shape [%m, %k] : view<32x16xbf16, #dense> -> vector<16xbf16>
    %rhs0 = vector.fragment.load<rhs> %rhs_scratch_view[%zero, %zero] shape [%k, %n] : view<16x32xbf16, %rhs_scratch_layout> -> vector<16xbf16>
    %rhs1 = vector.fragment.load<rhs> %rhs_scratch_view[%zero, %sixteen] shape [%k, %n] : view<16x32xbf16, %rhs_scratch_layout> -> vector<16xbf16>
    %next00 = vector.mma %lhs0, %rhs0, %acc00 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %next01 = vector.mma %lhs0, %rhs1, %acc01 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %next10 = vector.mma %lhs1, %rhs0, %acc10 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %next11 = vector.mma %lhs1, %rhs1, %acc11 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
    scf.yield %next00, %next01, %next10, %next11 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }
  %lane_column = index.rem %lane, %sixteen : index
  %lane_group = index.div %lane, %sixteen : index
  %column0 = index.add %output_channel_origin, %lane_column : index
  %column1 = index.add %output_channel_origin_high, %lane_column : index
  %bias0_bf16 = view.load %bias_view[%column0] : view<[%output_channel_count]xbf16, #dense> -> bf16
  %bias1_bf16 = view.load %bias_view[%column1] : view<[%output_channel_count]xbf16, #dense> -> bf16
  %bias0 = scalar.extf %bias0_bf16 : bf16 to f32
  %bias1 = scalar.extf %bias1_bf16 : bf16 to f32
  scf.for %register_index = [%zero to %eight step %unit] {
    %register_pixel_base = index.mul %register_index, %two : index
    %local_pixel = index.add %register_pixel_base, %lane_group : index
    %pixel0 = index.add %pixel_origin, %local_pixel : index
    %pixel1 = index.add %pixel_origin_high, %local_pixel : index
    %pixel0_valid = index.cmp ult, %pixel0, %pixel_count : index
    scf.if %pixel0_valid {
      %y0 = index.rem %pixel0, %height : index
      %row0 = index.div %pixel0, %height : index
      %x0 = index.rem %row0, %width : index
      %batch0 = index.div %row0, %width : index
      %output_x_row_base0 = index.mul %x0, %height : index
      %output_pixel_base0 = index.add %output_x_row_base0, %y0 : index
      %output_pixel_element_base0 = index.mul %output_pixel_base0, %output_channel_count : index
      %output_channel_element_base00 = index.add %output_pixel_element_base0, %column0 : index
      %output_channel_element_base01 = index.add %output_pixel_element_base0, %column1 : index
      %output_batch_element_base00 = index.mul %output_channel_element_base00, %batch_count : index
      %output_batch_element_base01 = index.mul %output_channel_element_base01, %batch_count : index
      %output_element00 = index.add %output_batch_element_base00, %batch0 : index
      %output_element01 = index.add %output_batch_element_base01, %batch0 : index
      %value00 = vector.extract %result00[%register_index] : vector<8xf32> -> f32
      %value01 = vector.extract %result01[%register_index] : vector<8xf32> -> f32
      %biased00 = scalar.addf<reassoc|nnan|ninf|nsz> %value00, %bias0 : f32
      %biased01 = scalar.addf<reassoc|nnan|ninf|nsz> %value01, %bias1 : f32
      %shortcut00_bf16 = view.load %shortcut_flat_view[%output_element00] : view<[%output_element_count]xbf16, #dense> -> bf16
      %shortcut00 = scalar.extf %shortcut00_bf16 : bf16 to f32
      %residual00 = scalar.addf<reassoc|nnan|ninf|nsz> %biased00, %shortcut00 : f32
      %rounded00 = scalar.fptrunc %residual00 : f32 to bf16
      %shortcut01_bf16 = view.load %shortcut_flat_view[%output_element01] : view<[%output_element_count]xbf16, #dense> -> bf16
      %shortcut01 = scalar.extf %shortcut01_bf16 : bf16 to f32
      %residual01 = scalar.addf<reassoc|nnan|ninf|nsz> %biased01, %shortcut01 : f32
      %rounded01 = scalar.fptrunc %residual01 : f32 to bf16
      view.store %rounded00, %output_flat_view[%output_element00] : bf16, view<[%output_element_count]xbf16, #dense>
      view.store %rounded01, %output_flat_view[%output_element01] : bf16, view<[%output_element_count]xbf16, #dense>
    }
    %pixel1_valid = index.cmp ult, %pixel1, %pixel_count : index
    scf.if %pixel1_valid {
      %y1 = index.rem %pixel1, %height : index
      %row1 = index.div %pixel1, %height : index
      %x1 = index.rem %row1, %width : index
      %batch1 = index.div %row1, %width : index
      %output_x_row_base1 = index.mul %x1, %height : index
      %output_pixel_base1 = index.add %output_x_row_base1, %y1 : index
      %output_pixel_element_base1 = index.mul %output_pixel_base1, %output_channel_count : index
      %output_channel_element_base10 = index.add %output_pixel_element_base1, %column0 : index
      %output_channel_element_base11 = index.add %output_pixel_element_base1, %column1 : index
      %output_batch_element_base10 = index.mul %output_channel_element_base10, %batch_count : index
      %output_batch_element_base11 = index.mul %output_channel_element_base11, %batch_count : index
      %output_element10 = index.add %output_batch_element_base10, %batch1 : index
      %output_element11 = index.add %output_batch_element_base11, %batch1 : index
      %value10 = vector.extract %result10[%register_index] : vector<8xf32> -> f32
      %value11 = vector.extract %result11[%register_index] : vector<8xf32> -> f32
      %biased10 = scalar.addf<reassoc|nnan|ninf|nsz> %value10, %bias0 : f32
      %biased11 = scalar.addf<reassoc|nnan|ninf|nsz> %value11, %bias1 : f32
      %shortcut10_bf16 = view.load %shortcut_flat_view[%output_element10] : view<[%output_element_count]xbf16, #dense> -> bf16
      %shortcut10 = scalar.extf %shortcut10_bf16 : bf16 to f32
      %residual10 = scalar.addf<reassoc|nnan|ninf|nsz> %biased10, %shortcut10 : f32
      %rounded10 = scalar.fptrunc %residual10 : f32 to bf16
      %shortcut11_bf16 = view.load %shortcut_flat_view[%output_element11] : view<[%output_element_count]xbf16, #dense> -> bf16
      %shortcut11 = scalar.extf %shortcut11_bf16 : bf16 to f32
      %residual11 = scalar.addf<reassoc|nnan|ninf|nsz> %biased11, %shortcut11 : f32
      %rounded11 = scalar.fptrunc %residual11 : f32 to bf16
      view.store %rounded10, %output_flat_view[%output_element10] : bf16, view<[%output_element_count]xbf16, #dense>
      view.store %rounded11, %output_flat_view[%output_element11] : bf16, view<[%output_element_count]xbf16, #dense>
    }
  }
  func.return
}
