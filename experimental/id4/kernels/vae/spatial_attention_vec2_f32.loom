config.decl @id4.vae.spatial_attention.width : %value: index where [range(%value, 1, 65536)]

config.decl @id4.vae.spatial_attention.height : %value: index where [range(%value, 1, 65536)]

config.decl @id4.vae.spatial_attention.channel_count : %value: index where [range(%value, 2, 512), mul(%value, 2)]

config.decl @id4.vae.spatial_attention.batch_count : %value: index where [range(%value, 1, 1)]

config.decl @id4.vae.spatial_attention.token_count : %value: index where [range(%value, 1, 268435456)]

kernel.def export("id4_vae_spatial_attention_vec2_f32") @id4_vae_spatial_attention_vec2_f32() {
  %unit = index.constant 1 : index
  %workgroup_size_x = index.constant 256 : index
  %token_count = config.get @id4.vae.spatial_attention.token_count : index
  %batch_count = config.get @id4.vae.spatial_attention.batch_count : index
  kernel.launch.config workgroups(%token_count, %batch_count, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%query: buffer, %key: buffer, %value: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %unit = index.constant 1 : index
  %two = index.constant 2 : index
  %query_token = kernel.workgroup.id<x> : index
  %batch = kernel.workgroup.id<y> : index
  %lane = kernel.workitem.id<x> : index
  %zero_f32 = scalar.constant 0.0 : f32
  %negative_large = scalar.constant -1000000000.0 : f32
  %zero_vector = vector.splat %zero_f32 : vector<2xf32>
  %width = config.get @id4.vae.spatial_attention.width : index
  %height = config.get @id4.vae.spatial_attention.height : index
  %channel_count = config.get @id4.vae.spatial_attention.channel_count : index
  %batch_count0 = config.get @id4.vae.spatial_attention.batch_count : index
  %batch_count = index.assume %batch_count0 [range(%batch_count0, 1, 1)] : index
  %token_count = config.get @id4.vae.spatial_attention.token_count : index
  %channel_count_i32 = index.cast %channel_count : index to i32
  %channel_count_f32 = scalar.sitofp %channel_count_i32 : i32 to f32
  %attention_scale = scalar.rsqrtf<nnan|ninf|nsz|afn> %channel_count_f32 : f32
  %channel_base0 = index.mul %lane, %two : index
  %channel_valid = index.cmp ult, %channel_base0, %channel_count : index
  %query_noalias, %key_noalias, %value_noalias, %output_noalias = buffer.assume.noalias %query, %key, %value, %output : buffer, buffer, buffer, buffer
  %query_global = buffer.assume.memory_space<global> %query_noalias : buffer
  %key_global = buffer.assume.memory_space<global> %key_noalias : buffer
  %value_global = buffer.assume.memory_space<global> %value_noalias : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  %pixel_count = index.mul %width, %height : index
  %pixel_element_count = index.mul %pixel_count, %channel_count : index
  %element_count = index.mul %pixel_element_count, %batch_count : index
  %query_flat_view = buffer.view %query_global[%base] : buffer -> view<[%element_count]xf32, #dense>
  %key_flat_view = buffer.view %key_global[%base] : buffer -> view<[%element_count]xf32, #dense>
  %value_flat_view = buffer.view %value_global[%base] : buffer -> view<[%element_count]xf32, #dense>
  %output_flat_view = buffer.view %output_global[%base] : buffer -> view<[%element_count]xf32, #dense>
  %query_x = index.rem %query_token, %width : index
  %query_y = index.div %query_token, %width : index
  %query_x_row_base = index.mul %query_x, %height : index
  %query_pixel_base = index.add %query_x_row_base, %query_y : index
  %query_pixel_element_base = index.mul %query_pixel_base, %channel_count : index
  %query_channel_element_base = index.add %query_pixel_element_base, %channel_base0 : index
  %query_batch_element_base = index.mul %query_channel_element_base, %batch_count : index
  %query_element0 = index.add %query_batch_element_base, %batch : index
  %query_values = scf.if %channel_valid -> (vector<2xf32>) {
    %last_valid_element = index.sub %element_count, %unit : index
    %query_element = index.assume %query_element0 [ge(%query_element0, 0), lt(%query_element0, %last_valid_element)] : index
    %loaded = vector.load %query_flat_view[%query_element] : view<[%element_count]xf32, #dense> -> vector<2xf32>
    scf.yield %loaded : vector<2xf32>
  } else {
    scf.yield %zero_vector : vector<2xf32>
  }
  %softmax_max, %softmax_sum, %acc = scf.for %key_token = [%zero to %token_count step %unit](%current_max = %negative_large : f32, %current_sum = %zero_f32 : f32, %current_acc = %zero_vector : vector<2xf32>) -> (f32, f32, vector<2xf32>) {
    %key_x = index.rem %key_token, %width : index
    %key_y = index.div %key_token, %width : index
    %key_x_row_base = index.mul %key_x, %height : index
    %key_pixel_base = index.add %key_x_row_base, %key_y : index
    %key_pixel_element_base = index.mul %key_pixel_base, %channel_count : index
    %key_channel_element_base = index.add %key_pixel_element_base, %channel_base0 : index
    %key_batch_element_base = index.mul %key_channel_element_base, %batch_count : index
    %key_element0 = index.add %key_batch_element_base, %batch : index
    %key_values = scf.if %channel_valid -> (vector<2xf32>) {
      %last_valid_element = index.sub %element_count, %unit : index
      %key_element = index.assume %key_element0 [ge(%key_element0, 0), lt(%key_element0, %last_valid_element)] : index
      %loaded = vector.load %key_flat_view[%key_element] : view<[%element_count]xf32, #dense> -> vector<2xf32>
      scf.yield %loaded : vector<2xf32>
    } else {
      scf.yield %zero_vector : vector<2xf32>
    }
    %products = vector.mulf<reassoc|nnan|ninf|nsz|contract> %query_values, %key_values : vector<2xf32>
    %lane_dot = vector.reduce<addf, reassoc|nnan|ninf|nsz> %products, %zero_f32 : vector<2xf32>, f32
    %dot = kernel.workgroup.reduce<addf> %lane_dot : f32
    %score = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %dot, %attention_scale : f32
    %next_max = scalar.maxnumf %current_max, %score : f32
    %old_delta = scalar.subf<reassoc|nnan|ninf|nsz> %current_max, %next_max : f32
    %old_scale = scalar.expf<afn> %old_delta : f32
    %score_delta = scalar.subf<reassoc|nnan|ninf|nsz> %score, %next_max : f32
    %weight = scalar.expf<afn> %score_delta : f32
    %scaled_sum = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %current_sum, %old_scale : f32
    %next_sum = scalar.addf<reassoc|nnan|ninf|nsz> %scaled_sum, %weight : f32
    %old_scale_values = vector.splat %old_scale : vector<2xf32>
    %scaled_acc = vector.mulf<reassoc|nnan|ninf|nsz|contract> %current_acc, %old_scale_values : vector<2xf32>
    %next_acc = scf.if %channel_valid -> (vector<2xf32>) {
      %last_valid_element = index.sub %element_count, %unit : index
      %value_element = index.assume %key_element0 [ge(%key_element0, 0), lt(%key_element0, %last_valid_element)] : index
      %value_values = vector.load %value_flat_view[%value_element] : view<[%element_count]xf32, #dense> -> vector<2xf32>
      %weight_values = vector.splat %weight : vector<2xf32>
      %weighted_values = vector.mulf<reassoc|nnan|ninf|nsz|contract> %weight_values, %value_values : vector<2xf32>
      %accumulated = vector.addf<reassoc|nnan|ninf|nsz> %scaled_acc, %weighted_values : vector<2xf32>
      scf.yield %accumulated : vector<2xf32>
    } else {
      scf.yield %scaled_acc : vector<2xf32>
    }
    scf.yield %next_max, %next_sum, %next_acc : f32, f32, vector<2xf32>
  }
  scf.if %channel_valid {
    %sum_values = vector.splat %softmax_sum : vector<2xf32>
    %output_values = vector.divf<nnan|ninf|nsz|arcp> %acc, %sum_values : vector<2xf32>
    %last_valid_element = index.sub %element_count, %unit : index
    %output_element = index.assume %query_element0 [ge(%query_element0, 0), lt(%query_element0, %last_valid_element)] : index
    vector.store %output_values, %output_flat_view[%output_element] : vector<2xf32>, view<[%element_count]xf32, #dense>
  }
  kernel.return
}

check.case public @id4_vae_spatial_attention_vec2_f32_single_token_case {
  %query = check.generate.fill value(0.0) : tensor<1x1x8x1xf32>
  %key = check.generate.fill value(0.0) : tensor<1x1x8x1xf32>
  %value = check.generate.iota offset(3.0) step(2.0) : tensor<1x1x8x1xf32>
  %output = check.generate.fill value(0.0) : tensor<1x1x8x1xf32>
  func.call @id4_vae_spatial_attention_vec2_f32(%query, %key, %value, %output) : (tensor<1x1x8x1xf32>, tensor<1x1x8x1xf32>, tensor<1x1x8x1xf32>, tensor<1x1x8x1xf32>)
  check.expect.close actual(%output) expected(%value) atol(0.0001) rtol(0.0001) nan(same) : tensor<1x1x8x1xf32>
  check.return
}

check.case public @id4_vae_spatial_attention_vec2_f32_uniform_softmax_case {
  %query = check.generate.fill value(0.0) : tensor<2x1x8x1xf32>
  %key = check.generate.fill value(0.0) : tensor<2x1x8x1xf32>
  %value = check.generate.fill value(7.0) : tensor<2x1x8x1xf32>
  %output = check.generate.fill value(0.0) : tensor<2x1x8x1xf32>
  %expected = check.generate.fill value(7.0) : tensor<2x1x8x1xf32>
  func.call @id4_vae_spatial_attention_vec2_f32(%query, %key, %value, %output) : (tensor<2x1x8x1xf32>, tensor<2x1x8x1xf32>, tensor<2x1x8x1xf32>, tensor<2x1x8x1xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0001) rtol(0.0001) nan(same) : tensor<2x1x8x1xf32>
  check.return
}

check.case public @id4_vae_spatial_attention_vec2_f32_nonuniform_case {
  %query = check.file.read.npy path("testdata/vae_spatial_attention_vec2_f32_nonuniform_query.npy") : tensor<4x4x8x1xf32>
  %key = check.file.read.npy path("testdata/vae_spatial_attention_vec2_f32_nonuniform_key.npy") : tensor<4x4x8x1xf32>
  %value = check.file.read.npy path("testdata/vae_spatial_attention_vec2_f32_nonuniform_value.npy") : tensor<4x4x8x1xf32>
  %output = check.generate.fill value(0.0) : tensor<4x4x8x1xf32>
  %expected = check.file.read.npy path("testdata/vae_spatial_attention_vec2_f32_nonuniform_expected.npy") : tensor<4x4x8x1xf32>
  func.call @id4_vae_spatial_attention_vec2_f32(%query, %key, %value, %output) : (tensor<4x4x8x1xf32>, tensor<4x4x8x1xf32>, tensor<4x4x8x1xf32>, tensor<4x4x8x1xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0001) rtol(0.0001) nan(same) : tensor<4x4x8x1xf32>
  check.return
}

check.case public @id4_vae_spatial_attention_vec2_f32_flux2_mid_block_shape_case {
  %query = check.generate.fill value(0.0) : tensor<128x128x512x1xf32>
  %key = check.generate.fill value(0.0) : tensor<128x128x512x1xf32>
  %value = check.generate.fill value(7.0) : tensor<128x128x512x1xf32>
  %output = check.generate.fill value(0.0) : tensor<128x128x512x1xf32>
  %expected = check.generate.fill value(7.0) : tensor<128x128x512x1xf32>
  func.call @id4_vae_spatial_attention_vec2_f32(%query, %key, %value, %output) : (tensor<128x128x512x1xf32>, tensor<128x128x512x1xf32>, tensor<128x128x512x1xf32>, tensor<128x128x512x1xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0001) rtol(0.0001) nan(same) : tensor<128x128x512x1xf32>
  check.return
}

check.benchmark<@id4_vae_spatial_attention_vec2_f32_single_token_case> @id4_vae_spatial_attention_vec2_f32_single_token

check.benchmark<@id4_vae_spatial_attention_vec2_f32_uniform_softmax_case> @id4_vae_spatial_attention_vec2_f32_uniform_softmax

