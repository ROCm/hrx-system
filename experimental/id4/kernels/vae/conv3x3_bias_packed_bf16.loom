func.def inline @id4_vae_conv3x3_accumulate_input4_oc8_bf16(%input_values_bf16: vector<4xbf16>, %weights0_bf16: vector<8xbf16>, %weights1_bf16: vector<8xbf16>, %weights2_bf16: vector<8xbf16>, %weights3_bf16: vector<8xbf16>, %acc: vector<8xf32>) -> (vector<8xf32>) {
  %input_values = vector.extf %input_values_bf16 : vector<4xbf16> to vector<4xf32>
  %weights0 = vector.extf %weights0_bf16 : vector<8xbf16> to vector<8xf32>
  %weights1 = vector.extf %weights1_bf16 : vector<8xbf16> to vector<8xf32>
  %weights2 = vector.extf %weights2_bf16 : vector<8xbf16> to vector<8xf32>
  %weights3 = vector.extf %weights3_bf16 : vector<8xbf16> to vector<8xf32>
  %input_value0 = vector.extract %input_values[0] : vector<4xf32> -> f32
  %input_value1 = vector.extract %input_values[1] : vector<4xf32> -> f32
  %input_value2 = vector.extract %input_values[2] : vector<4xf32> -> f32
  %input_value3 = vector.extract %input_values[3] : vector<4xf32> -> f32
  %input0 = vector.splat %input_value0 : vector<8xf32>
  %input1 = vector.splat %input_value1 : vector<8xf32>
  %input2 = vector.splat %input_value2 : vector<8xf32>
  %input3 = vector.splat %input_value3 : vector<8xf32>
  %products0 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %input0, %weights0 : vector<8xf32>
  %products1 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %input1, %weights1 : vector<8xf32>
  %products2 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %input2, %weights2 : vector<8xf32>
  %products3 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %input3, %weights3 : vector<8xf32>
  %products01 = vector.addf<reassoc|nnan|ninf|nsz> %products0, %products1 : vector<8xf32>
  %products23 = vector.addf<reassoc|nnan|ninf|nsz> %products2, %products3 : vector<8xf32>
  %partial = vector.addf<reassoc|nnan|ninf|nsz> %products01, %products23 : vector<8xf32>
  %next = vector.addf<reassoc|nnan|ninf|nsz> %acc, %partial : vector<8xf32>
  func.return %next : vector<8xf32>
}

