config.decl @id4.vae.spatial_attention.token_count : %value: index where [range(%value, 1, 268435456)]

kernel.def export("id4_vae_spatial_attention_vec8_bf16") @id4_vae_spatial_attention_vec8_bf16() {
  %unit = index.constant 1 : index
