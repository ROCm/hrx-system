      %value_values = vector.extf %value_values_bf16 : vector<8xbf16> to vector<8xf32>
      %weight_values = vector.splat %weight : vector<8xf32>
      %weighted_values = vector.mulf<reassoc|nnan|ninf|nsz|contract> %weight_values, %value_values : vector<8xf32>
      %accumulated = vector.addf<reassoc|nnan|ninf|nsz> %scaled_acc, %weighted_values : vector<8xf32>
