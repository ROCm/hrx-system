amdgpu.target<gfx1100> @gfx1100

config.decl @id4.vae.spatial_attention_wmma.token_count : %value: index where [range(%value, 16, 268435456), mul(%value, 16)]

config.decl @id4.vae.spatial_attention_wmma.channel_count : %value: index where [range(%value, 16, 512), mul(%value, 16)]

config.decl @id4.vae.spatial_attention_wmma.channel_tile_count : %value: index where [range(%value, 1, 32)]

kernel.def export("id4_vae_spatial_attention_online_bf16_wmma") @id4_vae_spatial_attention_online_bf16_wmma() {
  %unit = index.constant 1 : index
  %sixteen = index.constant 16 : index
  %workgroup_size_x = index.constant 32 : index
  %token_count = config.get @id4.vae.spatial_attention_wmma.token_count : index
  %query_tile_count = index.div %token_count, %sixteen : index
  kernel.launch.config workgroups(%query_tile_count, %unit, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%query: buffer, %key: buffer, %packed_value: buffer, %output: buffer) {
  %query_tile = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  func.apply<id4.vae.spatial_attention_online_bf16.m16n16>(%query, %key, %packed_value, %output, %query_tile, %lane) : (buffer, buffer, buffer, buffer, index, index)
  kernel.return
}

func.template<id4.vae.spatial_attention_online_bf16.m16n16> target(@gfx1100) priority(20) @id4_vae_spatial_attention_online_bf16_wmma_gfx1100(%query: buffer, %key: buffer, %packed_value: buffer, %output: buffer, %query_tile: index, %lane: index) {
  %base = index.constant 0 : offset
  %probability_scratch_bytes = index.constant 512 : offset
  %accumulator_scratch_bytes = index.constant 32768 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %eight = index.constant 8 : index
  %fifteen = index.constant 15 : index
  %sixteen = index.constant 16 : index
  %thirty_two = index.constant 32 : index
  %lane_column = index.rem %lane, %sixteen : index
  %lane_group = index.div %lane, %sixteen : index
  %lane_group_even = index.cmp eq, %lane_group, %zero : index
  %token_count = config.get @id4.vae.spatial_attention_wmma.token_count : index
  %channel_count = config.get @id4.vae.spatial_attention_wmma.channel_count : index
  %channel_tile_count = config.get @id4.vae.spatial_attention_wmma.channel_tile_count : index
  %query_origin = index.mul %query_tile, %sixteen : index
  %key_tile_count = index.div %token_count, %sixteen : index
  %zero_f32 = scalar.constant 0.0 : f32
  %negative_large = scalar.constant -1000000000.0 : f32
  %zero_acc = vector.constant 0.0 : vector<8xf32>
  %zero_vector = vector.splat %zero_f32 : vector<8xf32>
  %negative_vector = vector.splat %negative_large : vector<8xf32>
  %channel_count_i32 = index.cast %channel_count : index to i32
  %channel_count_f32 = scalar.sitofp %channel_count_i32 : i32 to f32
  %attention_scale = scalar.rsqrtf<nnan|ninf|nsz|afn> %channel_count_f32 : f32
  %attention_scale_vector = vector.splat %attention_scale : vector<8xf32>
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %key_transposed_layout = encoding.layout.strided [1, %channel_count] : encoding<layout>
  %packed_value_layout = encoding.layout.strided [1, %token_count] : encoding<layout>
  %query_noalias, %key_noalias, %packed_value_noalias, %output_noalias = buffer.assume.noalias %query, %key, %packed_value, %output : buffer, buffer, buffer, buffer
  %query_global = buffer.assume.memory_space<global> %query_noalias : buffer
  %key_global = buffer.assume.memory_space<global> %key_noalias : buffer
  %packed_value_global = buffer.assume.memory_space<global> %packed_value_noalias : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  %query_aligned = buffer.assume.alignment %query_global {minimum_alignment = 16} : buffer
  %key_aligned = buffer.assume.alignment %key_global {minimum_alignment = 16} : buffer
  %packed_value_aligned = buffer.assume.alignment %packed_value_global {minimum_alignment = 16} : buffer
  %output_aligned = buffer.assume.alignment %output_global {minimum_alignment = 16} : buffer
  %query_view = buffer.view %query_aligned[%base] : buffer -> view<[%token_count]x[%channel_count]xbf16, #dense>
  %key_transposed_view = buffer.view %key_aligned[%base] : buffer -> view<[%channel_count]x[%token_count]xbf16, %key_transposed_layout>
  %packed_value_view = buffer.view %packed_value_aligned[%base] : buffer -> view<[%token_count]x[%channel_count]xbf16, %packed_value_layout>
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<[%token_count]x[%channel_count]xbf16, #dense>
  %probability_scratch = buffer.alloca %probability_scratch_bytes {base_alignment = 16, memory_space = workgroup} : buffer
  %probability_scratch_view = buffer.view %probability_scratch[%base] : buffer -> view<16x16xbf16, #dense>
  %accumulator_scratch = buffer.alloca %accumulator_scratch_bytes {base_alignment = 16, memory_space = workgroup} : buffer
  %accumulator_scratch_view = buffer.view %accumulator_scratch[%base] : buffer -> view<16x512xf32, #dense>
  %init = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>
  scf.for %channel_tile = [%zero to %channel_tile_count step %one] {
    %channel = index.mul %channel_tile, %sixteen : index
    vector.fragment.store<result> %init, %accumulator_scratch_view[%zero, %channel] shape [%m, %n] : vector<8xf32>, view<16x512xf32, #dense>
  }
  kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
  %final_max_even, %final_sum_even, %final_max_odd, %final_sum_odd = scf.for %key_tile = [%zero to %key_tile_count step %one](%current_max_even = %negative_vector : vector<8xf32>, %current_sum_even = %zero_vector : vector<8xf32>, %current_max_odd = %negative_vector : vector<8xf32>, %current_sum_odd = %zero_vector : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
    %key_origin = index.mul %key_tile, %sixteen : index
    %raw_scores = scf.for %channel_tile = [%zero to %channel_tile_count step %one](%qk_acc = %init : vector<8xf32>) -> (vector<8xf32>) {
      %channel = index.mul %channel_tile, %sixteen : index
      %lhs = vector.fragment.load<lhs> %query_view[%query_origin, %channel] shape [%m, %k] : view<[%token_count]x[%channel_count]xbf16, #dense> -> vector<16xbf16>
      %rhs = vector.fragment.load<rhs> %key_transposed_view[%channel, %key_origin] shape [%k, %n] : view<[%channel_count]x[%token_count]xbf16, %key_transposed_layout> -> vector<16xbf16>
      %next = vector.mma %lhs, %rhs, %qk_acc : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
      scf.yield %next : vector<8xf32>
    }
    %scaled_scores = vector.mulf<reassoc|nnan|ninf|nsz|contract> %raw_scores, %attention_scale_vector : vector<8xf32>
    %even_scores = scf.if %lane_group_even -> (vector<8xf32>) {
      scf.yield %scaled_scores : vector<8xf32>
    } else {
      scf.yield %negative_vector : vector<8xf32>
    }
    %odd_scores = scf.if %lane_group_even -> (vector<8xf32>) {
      scf.yield %negative_vector : vector<8xf32>
    } else {
      scf.yield %scaled_scores : vector<8xf32>
    }
    %tile_max_even = kernel.workgroup.reduce<maxnumf> %even_scores : vector<8xf32>
    %tile_max_odd = kernel.workgroup.reduce<maxnumf> %odd_scores : vector<8xf32>
    %next_max_even = vector.maxnumf %current_max_even, %tile_max_even : vector<8xf32>
    %next_max_odd = vector.maxnumf %current_max_odd, %tile_max_odd : vector<8xf32>
    %selected_next_max = scf.if %lane_group_even -> (vector<8xf32>) {
      scf.yield %next_max_even : vector<8xf32>
    } else {
      scf.yield %next_max_odd : vector<8xf32>
    }
    %score_delta = vector.subf<reassoc|nnan|ninf|nsz> %scaled_scores, %selected_next_max : vector<8xf32>
    %weight = vector.expf<afn> %score_delta : vector<8xf32>
    %even_weight = scf.if %lane_group_even -> (vector<8xf32>) {
      scf.yield %weight : vector<8xf32>
    } else {
      scf.yield %zero_vector : vector<8xf32>
    }
    %odd_weight = scf.if %lane_group_even -> (vector<8xf32>) {
      scf.yield %zero_vector : vector<8xf32>
    } else {
      scf.yield %weight : vector<8xf32>
    }
    %tile_sum_even = kernel.workgroup.reduce<addf> %even_weight : vector<8xf32>
    %tile_sum_odd = kernel.workgroup.reduce<addf> %odd_weight : vector<8xf32>
    %old_delta_even = vector.subf<reassoc|nnan|ninf|nsz> %current_max_even, %next_max_even : vector<8xf32>
    %old_delta_odd = vector.subf<reassoc|nnan|ninf|nsz> %current_max_odd, %next_max_odd : vector<8xf32>
    %old_scale_even = vector.expf<afn> %old_delta_even : vector<8xf32>
    %old_scale_odd = vector.expf<afn> %old_delta_odd : vector<8xf32>
    %scaled_sum_even = vector.mulf<reassoc|nnan|ninf|nsz|contract> %current_sum_even, %old_scale_even : vector<8xf32>
    %scaled_sum_odd = vector.mulf<reassoc|nnan|ninf|nsz|contract> %current_sum_odd, %old_scale_odd : vector<8xf32>
    %next_sum_even = vector.addf<reassoc|nnan|ninf|nsz> %scaled_sum_even, %tile_sum_even : vector<8xf32>
    %next_sum_odd = vector.addf<reassoc|nnan|ninf|nsz> %scaled_sum_odd, %tile_sum_odd : vector<8xf32>
    %selected_old_scale = scf.if %lane_group_even -> (vector<8xf32>) {
      scf.yield %old_scale_even : vector<8xf32>
    } else {
      scf.yield %old_scale_odd : vector<8xf32>
    }
    vector.fragment.store<result> %weight, %probability_scratch_view[%zero, %zero] shape [%m, %n] : vector<8xf32>, view<16x16xbf16, #dense>
    kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
    %probability_lhs = vector.fragment.load<lhs> %probability_scratch_view[%zero, %zero] shape [%m, %k] : view<16x16xbf16, #dense> -> vector<16xbf16>
    scf.for %channel_tile = [%zero to %channel_tile_count step %one] {
      %channel = index.mul %channel_tile, %sixteen : index
      %rhs = vector.fragment.load<rhs> %packed_value_view[%key_origin, %channel] shape [%k, %n] : view<[%token_count]x[%channel_count]xbf16, %packed_value_layout> -> vector<16xbf16>
      %tile = vector.mma %probability_lhs, %rhs, %init : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
      %acc = vector.fragment.load<init> %accumulator_scratch_view[%zero, %channel] shape [%m, %n] : view<16x512xf32, #dense> -> vector<8xf32>
      %scaled_acc = vector.mulf<reassoc|nnan|ninf|nsz|contract> %acc, %selected_old_scale : vector<8xf32>
      %next = vector.addf<reassoc|nnan|ninf|nsz> %scaled_acc, %tile : vector<8xf32>
      vector.fragment.store<result> %next, %accumulator_scratch_view[%zero, %channel] shape [%m, %n] : vector<8xf32>, view<16x512xf32, #dense>
    }
    kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
    scf.yield %next_max_even, %next_sum_even, %next_max_odd, %next_sum_odd : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }
  %selected_final_sum = scf.if %lane_group_even -> (vector<8xf32>) {
    scf.yield %final_sum_even : vector<8xf32>
  } else {
    scf.yield %final_sum_odd : vector<8xf32>
  }
  scf.for %channel_tile = [%zero to %channel_tile_count step %one] {
    %channel = index.mul %channel_tile, %sixteen : index
    %result = vector.fragment.load<init> %accumulator_scratch_view[%zero, %channel] shape [%m, %n] : view<16x512xf32, #dense> -> vector<8xf32>
    %output_value = vector.divf<nnan|ninf|nsz|arcp> %result, %selected_final_sum : vector<8xf32>
    vector.fragment.store<result> %output_value, %output_view[%query_origin, %channel] shape [%m, %n] : vector<8xf32>, view<[%token_count]x[%channel_count]xbf16, #dense>
  }
  func.return
}
