config.decl @id4.vae.group_norm.width : %value: index where [range(%value, 1, 65536)]
config.decl @id4.vae.group_norm.height : %value: index where [range(%value, 1, 65536)]
config.decl @id4.vae.group_norm.channel_count : %value: index where [range(%value, 1, 4096)]
config.decl @id4.vae.group_norm.group_count : %value: index where [range(%value, 1, 1024)]
config.decl @id4.vae.group_norm.channels_per_group : %value: index where [range(%value, 1, 1024)]
config.decl @id4.vae.group_norm.batch_count : %value: index where [range(%value, 1, 1024)]
config.decl @id4.vae.group_norm.group_element_count : %value: index where [range(%value, 1, 268435456)]
config.decl @id4.vae.group_norm.output_element_count : %value: index where [range(%value, 1, 268435456)]
config.decl @id4.vae.group_norm.output_channel_tile_count : %value: index where [range(%value, 1, 1024)]
config.decl @id4.vae.group_norm.output_tile_element_count : %value: index where [range(%value, 1, 67108864)]

kernel.def export("id4_vae_group_norm_stats_f32") @id4_vae_group_norm_stats_f32() {
  %unit = index.constant 1 : index
  %workgroup_size_x = index.constant 256 : index
  %group_count = config.get @id4.vae.group_norm.group_count : index
  %batch_count = config.get @id4.vae.group_norm.batch_count : index
  kernel.launch.config workgroups(%group_count, %batch_count, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%input: buffer, %stats: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %unit = index.constant 1 : index
  %workgroup_size_x = index.constant 256 : index
  %group = kernel.workgroup.id<x> : index
  %batch = kernel.workgroup.id<y> : index
  %lane = kernel.workitem.id<x> : index
  %width = config.get @id4.vae.group_norm.width : index
  %height = config.get @id4.vae.group_norm.height : index
  %channel_count = config.get @id4.vae.group_norm.channel_count : index
  %group_count = config.get @id4.vae.group_norm.group_count : index
  %channels_per_group = config.get @id4.vae.group_norm.channels_per_group : index
  %batch_count = config.get @id4.vae.group_norm.batch_count : index
  %group_element_count = config.get @id4.vae.group_norm.group_element_count : index
  %zero_f32 = scalar.constant 0.0 : f32
  %epsilon = scalar.constant 0.000001 : f32
  %group_element_count_i32 = index.cast %group_element_count : index to i32
  %group_element_count_f32 = scalar.sitofp %group_element_count_i32 : i32 to f32
  %channel_base = index.mul %group, %channels_per_group : index

  %input_noalias, %stats_noalias = buffer.assume.noalias %input, %stats : buffer, buffer
  %input_global = buffer.assume.memory_space<global> %input_noalias : buffer
  %stats_global = buffer.assume.memory_space<global> %stats_noalias : buffer
  %input_view = buffer.view %input_global[%base] : buffer -> view<[%width]x[%height]x[%channel_count]x[%batch_count]xf32, #dense>
  %stats_view = buffer.view %stats_global[%base] : buffer -> view<[%batch_count]x[%group_count]x2xf32, #dense>

  %lane_sum = scf.for %element_index = [%lane to %group_element_count step %workgroup_size_x](%acc = %zero_f32 : f32) -> (f32) {
    %x = index.rem %element_index, %width : index
    %row = index.div %element_index, %width : index
    %y = index.rem %row, %height : index
    %channel_in_group = index.div %row, %height : index
    %channel = index.add %channel_base, %channel_in_group : index
    %value = view.load %input_view[%x, %y, %channel, %batch] : view<[%width]x[%height]x[%channel_count]x[%batch_count]xf32, #dense> -> f32
    %next = scalar.addf<reassoc|nnan|ninf|nsz> %acc, %value : f32
    scf.yield %next : f32
  }
  %sum = kernel.workgroup.reduce<addf> %lane_sum : f32
  %mean = scalar.divf<nnan|ninf|nsz|arcp> %sum, %group_element_count_f32 : f32

  %lane_square_sum = scf.for %element_index = [%lane to %group_element_count step %workgroup_size_x](%acc = %zero_f32 : f32) -> (f32) {
    %x = index.rem %element_index, %width : index
    %row = index.div %element_index, %width : index
    %y = index.rem %row, %height : index
    %channel_in_group = index.div %row, %height : index
    %channel = index.add %channel_base, %channel_in_group : index
    %value = view.load %input_view[%x, %y, %channel, %batch] : view<[%width]x[%height]x[%channel_count]x[%batch_count]xf32, #dense> -> f32
    %delta = scalar.subf<reassoc|nnan|ninf|nsz> %value, %mean : f32
    %square = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %delta, %delta : f32
    %next = scalar.addf<reassoc|nnan|ninf|nsz> %acc, %square : f32
    scf.yield %next : f32
  }
  %square_sum = kernel.workgroup.reduce<addf> %lane_square_sum : f32
  %variance = scalar.divf<nnan|ninf|nsz|arcp> %square_sum, %group_element_count_f32 : f32
  %variance_epsilon = scalar.addf<nnan|ninf|nsz> %variance, %epsilon : f32
  %rstd = scalar.rsqrtf<nnan|ninf|nsz|afn> %variance_epsilon : f32

  %is_lane0 = index.cmp eq, %lane, %zero : index
  scf.if %is_lane0 {
    view.store %mean, %stats_view[%batch, %group, %zero] : f32, view<[%batch_count]x[%group_count]x2xf32, #dense>
    view.store %rstd, %stats_view[%batch, %group, %unit] : f32, view<[%batch_count]x[%group_count]x2xf32, #dense>
  }
  kernel.return
}

kernel.def export("id4_vae_group_norm_f32") @id4_vae_group_norm_f32() {
  %unit = index.constant 1 : index
  %workgroup_size_x = index.constant 256 : index
  %element_count = config.get @id4.vae.group_norm.output_element_count : index
  %rounding = index.sub %workgroup_size_x, %unit : index
  %rounded = index.add %element_count, %rounding : index
  %workgroups_x = index.div %rounded, %workgroup_size_x : index
  kernel.launch.config workgroups(%workgroups_x, %unit, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%input: buffer, %weight: buffer, %bias: buffer, %stats: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %unit = index.constant 1 : index
  %workgroup = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %workgroup_size_x = index.constant 256 : index
  %width = config.get @id4.vae.group_norm.width : index
  %height = config.get @id4.vae.group_norm.height : index
  %channel_count = config.get @id4.vae.group_norm.channel_count : index
  %group_count = config.get @id4.vae.group_norm.group_count : index
  %channels_per_group = config.get @id4.vae.group_norm.channels_per_group : index
  %batch_count = config.get @id4.vae.group_norm.batch_count : index
  %output_element_count = config.get @id4.vae.group_norm.output_element_count : index
  %element_index = index.madd %workgroup, %workgroup_size_x, %lane : index
  %in_bounds = index.cmp ult, %element_index, %output_element_count : index

  %input_noalias, %weight_noalias, %bias_noalias, %stats_noalias, %output_noalias = buffer.assume.noalias %input, %weight, %bias, %stats, %output : buffer, buffer, buffer, buffer, buffer
  %input_global = buffer.assume.memory_space<global> %input_noalias : buffer
  %weight_global = buffer.assume.memory_space<global> %weight_noalias : buffer
  %bias_global = buffer.assume.memory_space<global> %bias_noalias : buffer
  %stats_global = buffer.assume.memory_space<global> %stats_noalias : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  %input_view = buffer.view %input_global[%base] : buffer -> view<[%width]x[%height]x[%channel_count]x[%batch_count]xf32, #dense>
  %weight_view = buffer.view %weight_global[%base] : buffer -> view<[%channel_count]xf32, #dense>
  %bias_view = buffer.view %bias_global[%base] : buffer -> view<[%channel_count]xf32, #dense>
  %stats_view = buffer.view %stats_global[%base] : buffer -> view<[%batch_count]x[%group_count]x2xf32, #dense>
  %output_view = buffer.view %output_global[%base] : buffer -> view<[%width]x[%height]x[%channel_count]x[%batch_count]xf32, #dense>

  scf.if %in_bounds {
    %x = index.rem %element_index, %width : index
    %row = index.div %element_index, %width : index
    %y = index.rem %row, %height : index
    %plane = index.div %row, %height : index
    %channel = index.rem %plane, %channel_count : index
    %batch = index.div %plane, %channel_count : index
    %group = index.div %channel, %channels_per_group : index
    %value = view.load %input_view[%x, %y, %channel, %batch] : view<[%width]x[%height]x[%channel_count]x[%batch_count]xf32, #dense> -> f32
    %weight_value = view.load %weight_view[%channel] : view<[%channel_count]xf32, #dense> -> f32
    %bias_value = view.load %bias_view[%channel] : view<[%channel_count]xf32, #dense> -> f32
    %mean = view.load %stats_view[%batch, %group, %zero] : view<[%batch_count]x[%group_count]x2xf32, #dense> -> f32
    %rstd = view.load %stats_view[%batch, %group, %unit] : view<[%batch_count]x[%group_count]x2xf32, #dense> -> f32
    %delta = scalar.subf<reassoc|nnan|ninf|nsz> %value, %mean : f32
    %normalized = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %delta, %rstd : f32
    %weighted = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %normalized, %weight_value : f32
    %output_value = scalar.addf<reassoc|nnan|ninf|nsz> %weighted, %bias_value : f32
    view.store %output_value, %output_view[%x, %y, %channel, %batch] : f32, view<[%width]x[%height]x[%channel_count]x[%batch_count]xf32, #dense>
  }
  kernel.return
}

