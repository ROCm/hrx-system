      view.store %rounded02, %output_flat_view[%output_element02] : bf16, view<[%output_element_count]xbf16, #dense>
      view.store %rounded03, %output_flat_view[%output_element03] : bf16, view<[%output_element_count]xbf16, #dense>
    }
    %pixel1_valid = index.cmp ult, %pixel1, %pixel_count : index
    scf.if %pixel1_valid {
      %base_y0 = index.rem %pixel1, %input_height : index
      %base_y = index.assume %base_y0 [ge(%base_y0, 0), lt(%base_y0, %input_height)] : index
      %row1 = index.div %pixel1, %input_height : index
      %base_x0 = index.rem %row1, %input_width : index
      %base_x = index.assume %base_x0 [ge(%base_x0, 0), lt(%base_x0, %input_width)] : index
      %batch1 = index.div %row1, %input_width : index
      %output_x = index.madd %base_x, %two, %parity_x : index
      %output_y = index.madd %base_y, %two, %parity_y : index
      %output_x_row_base = index.mul %output_x, %output_height : index
      %output_pixel_base = index.add %output_x_row_base, %output_y : index
      %output_pixel_element_base = index.mul %output_pixel_base, %channel_count : index
      %output_channel_element_base10 = index.add %output_pixel_element_base, %column0 : index
      %output_channel_element_base11 = index.add %output_pixel_element_base, %column1 : index
      %output_channel_element_base12 = index.add %output_pixel_element_base, %column2 : index
      %output_channel_element_base13 = index.add %output_pixel_element_base, %column3 : index
      %output_batch_element_base10 = index.mul %output_channel_element_base10, %batch_count : index
      %output_batch_element_base11 = index.mul %output_channel_element_base11, %batch_count : index
      %output_batch_element_base12 = index.mul %output_channel_element_base12, %batch_count : index
      %output_batch_element_base13 = index.mul %output_channel_element_base13, %batch_count : index
      %output_element10 = index.add %output_batch_element_base10, %batch1 : index
      %output_element11 = index.add %output_batch_element_base11, %batch1 : index
      %output_element12 = index.add %output_batch_element_base12, %batch1 : index
      %output_element13 = index.add %output_batch_element_base13, %batch1 : index
      %value10 = vector.extract %result10[%register_index] : vector<8xf32> -> f32
      %value11 = vector.extract %result11[%register_index] : vector<8xf32> -> f32
      %value12 = vector.extract %result12[%register_index] : vector<8xf32> -> f32
      %value13 = vector.extract %result13[%register_index] : vector<8xf32> -> f32
      %biased10 = scalar.addf<reassoc|nnan|ninf|nsz> %value10, %bias0 : f32
      %biased11 = scalar.addf<reassoc|nnan|ninf|nsz> %value11, %bias1 : f32
      %biased12 = scalar.addf<reassoc|nnan|ninf|nsz> %value12, %bias2 : f32
      %biased13 = scalar.addf<reassoc|nnan|ninf|nsz> %value13, %bias3 : f32
      %rounded10 = scalar.fptrunc %biased10 : f32 to bf16
      %rounded11 = scalar.fptrunc %biased11 : f32 to bf16
      %rounded12 = scalar.fptrunc %biased12 : f32 to bf16
      %rounded13 = scalar.fptrunc %biased13 : f32 to bf16
      view.store %rounded10, %output_flat_view[%output_element10] : bf16, view<[%output_element_count]xbf16, #dense>
      view.store %rounded11, %output_flat_view[%output_element11] : bf16, view<[%output_element_count]xbf16, #dense>
      view.store %rounded12, %output_flat_view[%output_element12] : bf16, view<[%output_element_count]xbf16, #dense>
      view.store %rounded13, %output_flat_view[%output_element13] : bf16, view<[%output_element_count]xbf16, #dense>
    }
  }
  kernel.return
}

