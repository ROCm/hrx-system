    %bias_values0_bf16 = vector.load %bias_view[%output_channel_base] : view<[%channel_count]xbf16, #dense> -> vector<8xbf16>
    %bias_values1_bf16 = vector.load %bias_view[%output_channel_high] : view<[%channel_count]xbf16, #dense> -> vector<8xbf16>
