    %bias_values1 = vector.extf %bias_values1_bf16 : vector<8xbf16> to vector<8xf32>
    %value0 = vector.addf<reassoc|nnan|ninf|nsz> %dot_y0, %bias_values0 : vector<8xf32>
    %value1 = vector.addf<reassoc|nnan|ninf|nsz> %dot_y1, %bias_values1 : vector<8xf32>
