    %kernel_y_end = scf.if %is_bottom_edge -> (index) {
      scf.yield %two : index
    } else {
      scf.yield %three : index
    }
    %vector_channel_tile_count = index.div %channel_count, %four : index
    %vector_channel_count = index.mul %vector_channel_tile_count, %four : index
    %dot_y0, %dot_y1 = scf.for %kernel_y = [%kernel_y_begin to %kernel_y_end step %unit](%acc_y0 = %zero_vector : vector<8xf32>, %acc_y1 = %zero_vector : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>) {
      %upsampled_y_with_kernel = index.add %output_y, %kernel_y : index
      %upsampled_y = index.sub %upsampled_y_with_kernel, %kernel_center : index
      %input_y = index.div %upsampled_y, %two : index
      %dot_x0, %dot_x1 = scf.for %kernel_x = [%kernel_x_begin to %kernel_x_end step %unit](%acc_x0 = %acc_y0 : vector<8xf32>, %acc_x1 = %acc_y1 : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>) {
        %upsampled_x_with_kernel = index.add %output_x, %kernel_x : index
        %upsampled_x = index.sub %upsampled_x_with_kernel, %kernel_center : index
        %input_x = index.div %upsampled_x, %two : index
        %dot_channel0, %dot_channel1 = scf.for %input_channel_base = [%zero to %vector_channel_count step %four](%acc_channel0 = %acc_x0 : vector<8xf32>, %acc_channel1 = %acc_x1 : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>) {
          %input_channel1 = index.add %input_channel_base, %unit : index
          %input_channel2 = index.add %input_channel_base, %two : index
          %input_channel3 = index.add %input_channel_base, %three : index
          %input_x_row_base = index.mul %input_x, %input_height : index
          %input_pixel_base = index.add %input_x_row_base, %input_y : index
