          %weights13 = vector.load %weight_view[%input_channel3, %kernel_y, %kernel_x, %output_channel_high] : view<[%channel_count]x3x3x[%channel_count]xbf16, #dense> -> vector<8xbf16>
          %next0 = func.call @id4_vae_upsample_conv3x3_accumulate_input4_oc8_bf16(%input_values, %weights00, %weights01, %weights02, %weights03, %acc_channel0) : (vector<4xbf16>, vector<8xbf16>, vector<8xbf16>, vector<8xbf16>, vector<8xbf16>, vector<8xf32>) -> (vector<8xf32>)
          %next1 = func.call @id4_vae_upsample_conv3x3_accumulate_input4_oc8_bf16(%input_values, %weights10, %weights11, %weights12, %weights13, %acc_channel1) : (vector<4xbf16>, vector<8xbf16>, vector<8xbf16>, vector<8xbf16>, vector<8xbf16>, vector<8xf32>) -> (vector<8xf32>)
