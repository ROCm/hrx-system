          %weights01 = vector.load %weight_view[%input_channel1, %kernel_y, %kernel_x, %output_channel_base] : view<[%channel_count]x3x3x[%channel_count]xbf16, #dense> -> vector<8xbf16>
          %weights02 = vector.load %weight_view[%input_channel2, %kernel_y, %kernel_x, %output_channel_base] : view<[%channel_count]x3x3x[%channel_count]xbf16, #dense> -> vector<8xbf16>
          %weights03 = vector.load %weight_view[%input_channel3, %kernel_y, %kernel_x, %output_channel_base] : view<[%channel_count]x3x3x[%channel_count]xbf16, #dense> -> vector<8xbf16>
