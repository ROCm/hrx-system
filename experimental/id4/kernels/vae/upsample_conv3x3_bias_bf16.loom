} launch(%input: buffer, %weight: buffer, %bias: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %unit = index.constant 1 : index
  %two = index.constant 2 : index
  %three = index.constant 3 : index
  %four = index.constant 4 : index
  %eight = index.constant 8 : index
  %fifteen = index.constant 15 : index
  %sixteen = index.constant 16 : index
  %kernel_center = index.constant 1 : index
  %pixel_workgroup = kernel.workgroup.id<x> : index
  %output_channel_tile = kernel.workgroup.id<y> : index
  %lane = kernel.workitem.id<x> : index
  %workgroup_size_x = index.constant 256 : index
  %input_width = config.get @id4.vae.upsample_conv3x3_bias.input_width : index
  %input_height = config.get @id4.vae.upsample_conv3x3_bias.input_height : index
  %channel_count = config.get @id4.vae.upsample_conv3x3_bias.channel_count : index
  %batch_count0 = config.get @id4.vae.upsample_conv3x3_bias.batch_count : index
  %batch_count = index.assume %batch_count0 [range(%batch_count0, 1, 1)] : index
  %output_width = config.get @id4.vae.upsample_conv3x3_bias.output_width : index
  %output_height = config.get @id4.vae.upsample_conv3x3_bias.output_height : index
  %output_element_count = config.get @id4.vae.upsample_conv3x3_bias.output_element_count : index
  %output_pixel_count = index.mul %output_width, %output_height : index
  %output_pixel_element_count = index.mul %output_pixel_count, %batch_count : index
  %element_index = index.madd %pixel_workgroup, %workgroup_size_x, %lane : index
  %in_bounds = index.cmp ult, %element_index, %output_pixel_element_count : index
  %zero_f32 = scalar.constant 0.0 : f32
  %zero_vector = vector.splat %zero_f32 : vector<8xf32>
  %input_noalias, %weight_noalias, %bias_noalias, %output_noalias = buffer.assume.noalias %input, %weight, %bias, %output : buffer, buffer, buffer, buffer
  %input_global = buffer.assume.memory_space<global> %input_noalias : buffer
  %weight_global = buffer.assume.memory_space<global> %weight_noalias : buffer
  %bias_global = buffer.assume.memory_space<global> %bias_noalias : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  %input_pixel_count = index.mul %input_width, %input_height : index
  %input_pixel_element_count = index.mul %input_pixel_count, %channel_count : index
  %input_element_count = index.mul %input_pixel_element_count, %batch_count : index
