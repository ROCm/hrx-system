  %weight_view = buffer.view %weight_aligned[%base] : buffer -> view<[%input_channel_count]x[%output_channel_count]xbf16, %weight_layout>
  %bias_view = buffer.view %bias_aligned[%base] : buffer -> view<[%output_channel_count]xf32, #dense>
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<[%pixel_count]x[%output_channel_count]xf32, #dense>

