  %source_global = buffer.assume.memory_space<global> %source_noalias : buffer
  %target_global = buffer.assume.memory_space<global> %target_noalias : buffer
  %source_view = buffer.view %source_global[%base] : buffer -> view<[%output_channel_count]x[%input_channel_count]x3x3xf32, #dense>
  %target_view = buffer.view %target_global[%base] : buffer -> view<[%input_channel_count]x3x3x[%output_channel_count]xbf16, #dense>

