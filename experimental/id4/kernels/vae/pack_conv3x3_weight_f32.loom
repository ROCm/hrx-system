    %output_channel = index.rem %element_index, %output_channel_count : index
    %packed_row = index.div %element_index, %output_channel_count : index
    %kernel_x = index.rem %packed_row, %three : index
    %kernel_row = index.div %packed_row, %three : index
    %kernel_y = index.rem %kernel_row, %three : index
    %input_channel = index.div %packed_row, %nine : index
    %last_valid_input_channel = index.sub %input_channel_count, %unit : index
    %valid_input_channel = index.assume %input_channel [ge(%input_channel, 0), le(%input_channel, %last_valid_input_channel)] : index
    %value = view.load %source_view[%output_channel, %valid_input_channel, %kernel_y, %kernel_x] : view<[%output_channel_count]x[%input_channel_count]x3x3xf32, #dense> -> f32
    %rounded = scalar.fptrunc %value : f32 to bf16
    view.store %rounded, %target_view[%valid_input_channel, %kernel_y, %kernel_x, %output_channel] : bf16, view<[%input_channel_count]x3x3x[%output_channel_count]xbf16, #dense>
  }
