config.decl @id4.vae.pack_conv3x3_weight.input_channel_count : %value: index where [range(%value, 1, 4096)]
config.decl @id4.vae.pack_conv3x3_weight.output_channel_count : %value: index where [range(%value, 1, 4096)]
config.decl @id4.vae.pack_conv3x3_weight.element_count : %value: index where [range(%value, 1, 268435456)]

kernel.def export("id4_vae_pack_conv3x3_weight_f32") @id4_vae_pack_conv3x3_weight_f32() {
  %unit = index.constant 1 : index
  %workgroup_size_x = index.constant 256 : index
  %element_count = config.get @id4.vae.pack_conv3x3_weight.element_count : index
  %rounding = index.sub %workgroup_size_x, %unit : index
  %rounded = index.add %element_count, %rounding : index
  %workgroups_x = index.div %rounded, %workgroup_size_x : index
  kernel.launch.config workgroups(%workgroups_x, %unit, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%source: buffer, %target: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %unit = index.constant 1 : index
  %three = index.constant 3 : index
  %nine = index.constant 9 : index
  %workgroup = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %workgroup_size_x = index.constant 256 : index
  %input_channel_count = config.get @id4.vae.pack_conv3x3_weight.input_channel_count : index
  %output_channel_count = config.get @id4.vae.pack_conv3x3_weight.output_channel_count : index
  %element_count = config.get @id4.vae.pack_conv3x3_weight.element_count : index
  %element_index = index.madd %workgroup, %workgroup_size_x, %lane : index
  %in_bounds = index.cmp ult, %element_index, %element_count : index

  %source_noalias, %target_noalias = buffer.assume.noalias %source, %target : buffer, buffer
  %source_global = buffer.assume.memory_space<global> %source_noalias : buffer
  %target_global = buffer.assume.memory_space<global> %target_noalias : buffer
  %source_view = buffer.view %source_global[%base] : buffer -> view<[%output_channel_count]x[%input_channel_count]x3x3xf32, #dense>
  %target_view = buffer.view %target_global[%base] : buffer -> view<[%input_channel_count]x3x3x[%output_channel_count]xf32, #dense>

  scf.if %in_bounds {
    %output_channel = index.rem %element_index, %output_channel_count : index
    %packed_row = index.div %element_index, %output_channel_count : index
    %kernel_x = index.rem %packed_row, %three : index
    %kernel_row = index.div %packed_row, %three : index
    %kernel_y = index.rem %kernel_row, %three : index
    %input_channel = index.div %packed_row, %nine : index
    %last_valid_input_channel = index.sub %input_channel_count, %unit : index
    %valid_input_channel = index.assume %input_channel [ge(%input_channel, 0), le(%input_channel, %last_valid_input_channel)] : index
    %value = view.load %source_view[%output_channel, %valid_input_channel, %kernel_y, %kernel_x] : view<[%output_channel_count]x[%input_channel_count]x3x3xf32, #dense> -> f32
    view.store %value, %target_view[%valid_input_channel, %kernel_y, %kernel_x, %output_channel] : f32, view<[%input_channel_count]x3x3x[%output_channel_count]xf32, #dense>
  }
  kernel.return
}

