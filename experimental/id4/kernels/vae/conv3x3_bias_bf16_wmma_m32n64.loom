      %output_x_row_base1 = index.mul %x1, %height : index
      %output_pixel_base1 = index.add %output_x_row_base1, %y1 : index
      %output_pixel_element_base1 = index.mul %output_pixel_base1, %output_channel_count : index
      %output_channel_element_base10 = index.add %output_pixel_element_base1, %column0 : index
      %output_channel_element_base11 = index.add %output_pixel_element_base1, %column1 : index
      %output_channel_element_base12 = index.add %output_pixel_element_base1, %column2 : index
      %output_channel_element_base13 = index.add %output_pixel_element_base1, %column3 : index
      %output_batch_element_base10 = index.mul %output_channel_element_base10, %batch_count : index
      %output_batch_element_base11 = index.mul %output_channel_element_base11, %batch_count : index
      %output_batch_element_base12 = index.mul %output_channel_element_base12, %batch_count : index
      %output_batch_element_base13 = index.mul %output_channel_element_base13, %batch_count : index
      %output_element10 = index.add %output_batch_element_base10, %batch1 : index
      %output_element11 = index.add %output_batch_element_base11, %batch1 : index
      %output_element12 = index.add %output_batch_element_base12, %batch1 : index
      %output_element13 = index.add %output_batch_element_base13, %batch1 : index
      %value10 = vector.extract %result10[%register_index] : vector<8xf32> -> f32
      %value11 = vector.extract %result11[%register_index] : vector<8xf32> -> f32
      %value12 = vector.extract %result12[%register_index] : vector<8xf32> -> f32
      %value13 = vector.extract %result13[%register_index] : vector<8xf32> -> f32
      %biased10 = scalar.addf<reassoc|nnan|ninf|nsz> %value10, %bias0 : f32
      %biased11 = scalar.addf<reassoc|nnan|ninf|nsz> %value11, %bias1 : f32
      %biased12 = scalar.addf<reassoc|nnan|ninf|nsz> %value12, %bias2 : f32
      %biased13 = scalar.addf<reassoc|nnan|ninf|nsz> %value13, %bias3 : f32
      %shortcut10_bf16 = view.load %shortcut_flat_view[%output_element10] : view<[%output_element_count]xbf16, #dense> -> bf16
      %shortcut10 = scalar.extf %shortcut10_bf16 : bf16 to f32
      %residual10 = scalar.addf<reassoc|nnan|ninf|nsz> %biased10, %shortcut10 : f32
      %rounded10 = scalar.fptrunc %residual10 : f32 to bf16
      %shortcut11_bf16 = view.load %shortcut_flat_view[%output_element11] : view<[%output_element_count]xbf16, #dense> -> bf16
      %shortcut11 = scalar.extf %shortcut11_bf16 : bf16 to f32
      %residual11 = scalar.addf<reassoc|nnan|ninf|nsz> %biased11, %shortcut11 : f32
      %rounded11 = scalar.fptrunc %residual11 : f32 to bf16
      %shortcut12_bf16 = view.load %shortcut_flat_view[%output_element12] : view<[%output_element_count]xbf16, #dense> -> bf16
      %shortcut12 = scalar.extf %shortcut12_bf16 : bf16 to f32
      %residual12 = scalar.addf<reassoc|nnan|ninf|nsz> %biased12, %shortcut12 : f32
      %rounded12 = scalar.fptrunc %residual12 : f32 to bf16
      %shortcut13_bf16 = view.load %shortcut_flat_view[%output_element13] : view<[%output_element_count]xbf16, #dense> -> bf16
      %shortcut13 = scalar.extf %shortcut13_bf16 : bf16 to f32
      %residual13 = scalar.addf<reassoc|nnan|ninf|nsz> %biased13, %shortcut13 : f32
      %rounded13 = scalar.fptrunc %residual13 : f32 to bf16
      view.store %rounded10, %output_flat_view[%output_element10] : bf16, view<[%output_element_count]xbf16, #dense>
      view.store %rounded11, %output_flat_view[%output_element11] : bf16, view<[%output_element_count]xbf16, #dense>
      view.store %rounded12, %output_flat_view[%output_element12] : bf16, view<[%output_element_count]xbf16, #dense>
      view.store %rounded13, %output_flat_view[%output_element13] : bf16, view<[%output_element_count]xbf16, #dense>
    }
  }
  func.return
}
