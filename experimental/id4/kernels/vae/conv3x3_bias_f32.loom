  %bias_global = buffer.assume.memory_space<global> %bias_noalias : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  %input_view = buffer.view %input_global[%base] : buffer -> view<[%width]x[%height]x[%input_channel_count]x[%batch_count]xf32, #dense>
  %weight_view = buffer.view %weight_global[%base] : buffer -> view<[%output_channel_count]x[%input_channel_count]x3x3xf32, #dense>
  %bias_view = buffer.view %bias_global[%base] : buffer -> view<[%output_channel_count]xf32, #dense>
  %output_view = buffer.view %output_global[%base] : buffer -> view<[%width]x[%height]x[%output_channel_count]x[%batch_count]xf32, #dense>

  %x = index.rem %element_index, %width : index
  %row = index.div %element_index, %width : index
  %y = index.rem %row, %height : index
  %plane = index.div %row, %height : index
  %output_channel = index.rem %plane, %output_channel_count : index
  %batch = index.div %plane, %output_channel_count : index
  %last_x = index.sub %width, %unit : index
  %last_y = index.sub %height, %unit : index
  %x_is_left = index.cmp eq, %x, %zero : index
  %x_is_right = index.cmp eq, %x, %last_x : index
  %y_is_top = index.cmp eq, %y, %zero : index
  %y_is_bottom = index.cmp eq, %y, %last_y : index
  %reduction_count = index.mul %input_channel_count, %nine : index

  %lane_dot = scf.for %reduction_index = [%lane to %reduction_count step %workgroup_size_x](%acc = %zero_f32 : f32) -> (f32) {
    %input_channel = index.div %reduction_index, %nine : index
    %tap_index = index.rem %reduction_index, %nine : index
    %kernel_y = index.div %tap_index, %three : index
    %kernel_x = index.rem %tap_index, %three : index
    %kernel_x_is_zero = index.cmp eq, %kernel_x, %zero : index
    %kernel_x_is_two = index.cmp eq, %kernel_x, %two : index
    %kernel_y_is_zero = index.cmp eq, %kernel_y, %zero : index
    %kernel_y_is_two = index.cmp eq, %kernel_y, %two : index
    %invalid_left = scalar.andi %x_is_left, %kernel_x_is_zero : i1
    %invalid_right = scalar.andi %x_is_right, %kernel_x_is_two : i1
    %invalid_top = scalar.andi %y_is_top, %kernel_y_is_zero : i1
    %invalid_bottom = scalar.andi %y_is_bottom, %kernel_y_is_two : i1
    %invalid_x = scalar.ori %invalid_left, %invalid_right : i1
    %invalid_y = scalar.ori %invalid_top, %invalid_bottom : i1
    %invalid_tap = scalar.ori %invalid_x, %invalid_y : i1
    %partial = scf.if %invalid_tap -> (f32) {
      scf.yield %zero_f32 : f32
    } else {
      %input_y_with_kernel = index.add %y, %kernel_y : index
      %input_y = index.sub %input_y_with_kernel, %kernel_center : index
      %input_x_with_kernel = index.add %x, %kernel_x : index
      %input_x = index.sub %input_x_with_kernel, %kernel_center : index
      %input_value = view.load %input_view[%input_x, %input_y, %input_channel, %batch] : view<[%width]x[%height]x[%input_channel_count]x[%batch_count]xf32, #dense> -> f32
      %weight_value = view.load %weight_view[%output_channel, %input_channel, %kernel_y, %kernel_x] : view<[%output_channel_count]x[%input_channel_count]x3x3xf32, #dense> -> f32
      %product = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %input_value, %weight_value : f32
      scf.yield %product : f32
    }
    %next = scalar.addf<reassoc|nnan|ninf|nsz> %acc, %partial : f32
    scf.yield %next : f32
  }
  %dot = kernel.workgroup.reduce<addf> %lane_dot : f32
  %is_leader = index.cmp eq, %lane, %zero : index
  scf.if %is_leader {
    %bias_value = view.load %bias_view[%output_channel] : view<[%output_channel_count]xf32, #dense> -> f32
    %value = scalar.addf<reassoc|nnan|ninf|nsz> %dot, %bias_value : f32
    view.store %value, %output_view[%x, %y, %output_channel, %batch] : f32, view<[%width]x[%height]x[%output_channel_count]x[%batch_count]xf32, #dense>
  }
  kernel.return
}

