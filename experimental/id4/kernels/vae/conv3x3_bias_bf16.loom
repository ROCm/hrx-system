config.decl @id4.vae.conv3x3_bias.width : %value: index where [range(%value, 1, 65536)]

config.decl @id4.vae.conv3x3_bias.height : %value: index where [range(%value, 1, 65536)]

config.decl @id4.vae.conv3x3_bias.input_channel_count : %value: index where [range(%value, 1, 4096)]

config.decl @id4.vae.conv3x3_bias.output_channel_count : %value: index where [range(%value, 1, 4096)]

config.decl @id4.vae.conv3x3_bias.batch_count : %value: index where [range(%value, 1, 1024)]

config.decl @id4.vae.conv3x3_bias.output_element_count : %value: index where [range(%value, 1, 268435456)]

kernel.def export("id4_vae_conv3x3_bias_bf16_rounded_f32") @id4_vae_conv3x3_bias_bf16_rounded_f32() {
  %unit = index.constant 1 : index
  %workgroup_size_x = index.constant 256 : index
  %element_count = config.get @id4.vae.conv3x3_bias.output_element_count : index
  %rounding = index.sub %workgroup_size_x, %unit : index
  %rounded = index.add %element_count, %rounding : index
  %workgroups_x = index.div %rounded, %workgroup_size_x : index
  kernel.launch.config workgroups(%workgroups_x, %unit, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%input: buffer, %weight: buffer, %bias: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %unit = index.constant 1 : index
  %two = index.constant 2 : index
  %three = index.constant 3 : index
  %kernel_center = index.constant 1 : index
  %workgroup = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %workgroup_size_x = index.constant 256 : index
  %width = config.get @id4.vae.conv3x3_bias.width : index
  %height = config.get @id4.vae.conv3x3_bias.height : index
  %input_channel_count = config.get @id4.vae.conv3x3_bias.input_channel_count : index
  %output_channel_count = config.get @id4.vae.conv3x3_bias.output_channel_count : index
  %batch_count = config.get @id4.vae.conv3x3_bias.batch_count : index
  %output_element_count = config.get @id4.vae.conv3x3_bias.output_element_count : index
  %element_index = index.madd %workgroup, %workgroup_size_x, %lane : index
  %in_bounds = index.cmp ult, %element_index, %output_element_count : index
  %zero_f32 = scalar.constant 0.0 : f32
  %input_noalias, %weight_noalias, %bias_noalias, %output_noalias = buffer.assume.noalias %input, %weight, %bias, %output : buffer, buffer, buffer, buffer
  %input_global = buffer.assume.memory_space<global> %input_noalias : buffer
  %weight_global = buffer.assume.memory_space<global> %weight_noalias : buffer
  %bias_global = buffer.assume.memory_space<global> %bias_noalias : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  %input_view = buffer.view %input_global[%base] : buffer -> view<[%width]x[%height]x[%input_channel_count]x[%batch_count]xbf16, #dense>
  %weight_view = buffer.view %weight_global[%base] : buffer -> view<[%output_channel_count]x[%input_channel_count]x3x3xbf16, #dense>
  %bias_view = buffer.view %bias_global[%base] : buffer -> view<[%output_channel_count]xbf16, #dense>
  %output_view = buffer.view %output_global[%base] : buffer -> view<[%width]x[%height]x[%output_channel_count]x[%batch_count]xf32, #dense>
  scf.if %in_bounds {
    %x = index.rem %element_index, %width : index
    %row = index.div %element_index, %width : index
    %y = index.rem %row, %height : index
    %plane = index.div %row, %height : index
    %output_channel = index.rem %plane, %output_channel_count : index
    %batch = index.div %plane, %output_channel_count : index
    %last_x = index.sub %width, %unit : index
    %last_y = index.sub %height, %unit : index
    %is_left_edge = index.cmp eq, %x, %zero : index
    %kernel_x_begin = scf.if %is_left_edge -> (index) {
      scf.yield %unit : index
    } else {
      scf.yield %zero : index
    }
    %is_right_edge = index.cmp eq, %x, %last_x : index
    %kernel_x_end = scf.if %is_right_edge -> (index) {
      scf.yield %two : index
    } else {
      scf.yield %three : index
    }
    %is_top_edge = index.cmp eq, %y, %zero : index
    %kernel_y_begin = scf.if %is_top_edge -> (index) {
      scf.yield %unit : index
    } else {
      scf.yield %zero : index
    }
    %is_bottom_edge = index.cmp eq, %y, %last_y : index
    %kernel_y_end = scf.if %is_bottom_edge -> (index) {
      scf.yield %two : index
    } else {
      scf.yield %three : index
    }
    %dot_y = scf.for %kernel_y = [%kernel_y_begin to %kernel_y_end step %unit](%acc_y = %zero_f32 : f32) -> (f32) {
      %input_y_with_kernel = index.add %y, %kernel_y : index
      %input_y = index.sub %input_y_with_kernel, %kernel_center : index
      %dot_x = scf.for %kernel_x = [%kernel_x_begin to %kernel_x_end step %unit](%acc_x = %acc_y : f32) -> (f32) {
        %input_x_with_kernel = index.add %x, %kernel_x : index
        %input_x = index.sub %input_x_with_kernel, %kernel_center : index
        %dot_channel = scf.for %input_channel = [%zero to %input_channel_count step %unit](%acc_channel = %acc_x : f32) -> (f32) {
          %input_value_bf16 = view.load %input_view[%input_x, %input_y, %input_channel, %batch] : view<[%width]x[%height]x[%input_channel_count]x[%batch_count]xbf16, #dense> -> bf16
          %weight_value_bf16 = view.load %weight_view[%output_channel, %input_channel, %kernel_y, %kernel_x] : view<[%output_channel_count]x[%input_channel_count]x3x3xbf16, #dense> -> bf16
          %input_value = scalar.extf %input_value_bf16 : bf16 to f32
          %weight_value = scalar.extf %weight_value_bf16 : bf16 to f32
          %product = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %input_value, %weight_value : f32
          %next = scalar.addf<reassoc|nnan|ninf|nsz> %acc_channel, %product : f32
          scf.yield %next : f32
        }
        scf.yield %dot_channel : f32
      }
      scf.yield %dot_x : f32
    }
    %bias_value_bf16 = view.load %bias_view[%output_channel] : view<[%output_channel_count]xbf16, #dense> -> bf16
    %bias_value = scalar.extf %bias_value_bf16 : bf16 to f32
    %value = scalar.addf<reassoc|nnan|ninf|nsz> %dot_y, %bias_value : f32
    %rounded_bf16 = scalar.fptrunc %value : f32 to bf16
    %rounded = scalar.extf %rounded_bf16 : bf16 to f32
    view.store %rounded, %output_view[%x, %y, %output_channel, %batch] : f32, view<[%width]x[%height]x[%output_channel_count]x[%batch_count]xf32, #dense>
  }
  kernel.return
}

kernel.def export("id4_vae_conv3x3_bias_bf16_rgb_f32") @id4_vae_conv3x3_bias_bf16_rgb_f32() {
  %unit = index.constant 1 : index
  %three = index.constant 3 : index
  %workgroup_size_x = index.constant 256 : index
  %output_channel_count0 = config.get @id4.vae.conv3x3_bias.output_channel_count : index
  %output_channel_count = index.assume %output_channel_count0 [range(%output_channel_count0, 3, 3)] : index
  %output_element_count = config.get @id4.vae.conv3x3_bias.output_element_count : index
  %image_element_count = index.div %output_element_count, %output_channel_count : index
  %rounding = index.sub %workgroup_size_x, %unit : index
  %rounded = index.add %image_element_count, %rounding : index
  %workgroups_x = index.div %rounded, %workgroup_size_x : index
  kernel.launch.config workgroups(%workgroups_x, %unit, %unit) workgroup_size(%workgroup_size_x, %unit, %unit) : index
} launch(%input: buffer, %weight: buffer, %bias: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %unit = index.constant 1 : index
  %two = index.constant 2 : index
  %three = index.constant 3 : index
  %kernel_center = index.constant 1 : index
  %workgroup = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %workgroup_size_x = index.constant 256 : index
  %width = config.get @id4.vae.conv3x3_bias.width : index
  %height = config.get @id4.vae.conv3x3_bias.height : index
  %input_channel_count = config.get @id4.vae.conv3x3_bias.input_channel_count : index
  %output_channel_count0 = config.get @id4.vae.conv3x3_bias.output_channel_count : index
  %output_channel_count = index.assume %output_channel_count0 [range(%output_channel_count0, 3, 3)] : index
  %batch_count = config.get @id4.vae.conv3x3_bias.batch_count : index
  %output_element_count = config.get @id4.vae.conv3x3_bias.output_element_count : index
  %pixel_index = index.madd %workgroup, %workgroup_size_x, %lane : index
  %image_element_count = index.div %output_element_count, %output_channel_count : index
  %in_bounds = index.cmp ult, %pixel_index, %image_element_count : index
  %zero_f32 = scalar.constant 0.0 : f32
  %input_noalias, %weight_noalias, %bias_noalias, %output_noalias = buffer.assume.noalias %input, %weight, %bias, %output : buffer, buffer, buffer, buffer
  %input_global = buffer.assume.memory_space<global> %input_noalias : buffer
  %weight_global = buffer.assume.memory_space<global> %weight_noalias : buffer
  %bias_global = buffer.assume.memory_space<global> %bias_noalias : buffer
  %output_global = buffer.assume.memory_space<global> %output_noalias : buffer
  %input_view = buffer.view %input_global[%base] : buffer -> view<[%width]x[%height]x[%input_channel_count]x[%batch_count]xbf16, #dense>
  %weight_view = buffer.view %weight_global[%base] : buffer -> view<[%output_channel_count]x[%input_channel_count]x3x3xbf16, #dense>
  %bias_view = buffer.view %bias_global[%base] : buffer -> view<[%output_channel_count]xbf16, #dense>
  %output_view = buffer.view %output_global[%base] : buffer -> view<[%width]x[%height]x[%output_channel_count]x[%batch_count]xf32, #dense>
  scf.if %in_bounds {
    %x = index.rem %pixel_index, %width : index
    %row = index.div %pixel_index, %width : index
    %y = index.rem %row, %height : index
    %batch = index.div %row, %height : index
    %last_x = index.sub %width, %unit : index
    %last_y = index.sub %height, %unit : index
    %is_left_edge = index.cmp eq, %x, %zero : index
    %kernel_x_begin = scf.if %is_left_edge -> (index) {
      scf.yield %unit : index
    } else {
      scf.yield %zero : index
    }
    %is_right_edge = index.cmp eq, %x, %last_x : index
    %kernel_x_end = scf.if %is_right_edge -> (index) {
      scf.yield %two : index
    } else {
      scf.yield %three : index
    }
    %is_top_edge = index.cmp eq, %y, %zero : index
    %kernel_y_begin = scf.if %is_top_edge -> (index) {
      scf.yield %unit : index
    } else {
      scf.yield %zero : index
    }
    %is_bottom_edge = index.cmp eq, %y, %last_y : index
    %kernel_y_end = scf.if %is_bottom_edge -> (index) {
      scf.yield %two : index
    } else {
      scf.yield %three : index
    }
    %dot0, %dot1, %dot2 = scf.for %kernel_y = [%kernel_y_begin to %kernel_y_end step %unit](%acc_y0 = %zero_f32 : f32, %acc_y1 = %zero_f32 : f32, %acc_y2 = %zero_f32 : f32) -> (f32, f32, f32) {
      %input_y_with_kernel = index.add %y, %kernel_y : index
      %input_y = index.sub %input_y_with_kernel, %kernel_center : index
      %dot_x0, %dot_x1, %dot_x2 = scf.for %kernel_x = [%kernel_x_begin to %kernel_x_end step %unit](%acc_x0 = %acc_y0 : f32, %acc_x1 = %acc_y1 : f32, %acc_x2 = %acc_y2 : f32) -> (f32, f32, f32) {
        %input_x_with_kernel = index.add %x, %kernel_x : index
        %input_x = index.sub %input_x_with_kernel, %kernel_center : index
        %dot_channel0, %dot_channel1, %dot_channel2 = scf.for %input_channel = [%zero to %input_channel_count step %unit](%acc_channel0 = %acc_x0 : f32, %acc_channel1 = %acc_x1 : f32, %acc_channel2 = %acc_x2 : f32) -> (f32, f32, f32) {
          %input_value_bf16 = view.load %input_view[%input_x, %input_y, %input_channel, %batch] : view<[%width]x[%height]x[%input_channel_count]x[%batch_count]xbf16, #dense> -> bf16
          %weight_value0_bf16 = view.load %weight_view[%zero, %input_channel, %kernel_y, %kernel_x] : view<[%output_channel_count]x[%input_channel_count]x3x3xbf16, #dense> -> bf16
          %weight_value1_bf16 = view.load %weight_view[%unit, %input_channel, %kernel_y, %kernel_x] : view<[%output_channel_count]x[%input_channel_count]x3x3xbf16, #dense> -> bf16
          %weight_value2_bf16 = view.load %weight_view[%two, %input_channel, %kernel_y, %kernel_x] : view<[%output_channel_count]x[%input_channel_count]x3x3xbf16, #dense> -> bf16
          %input_value = scalar.extf %input_value_bf16 : bf16 to f32
          %weight_value0 = scalar.extf %weight_value0_bf16 : bf16 to f32
          %weight_value1 = scalar.extf %weight_value1_bf16 : bf16 to f32
          %weight_value2 = scalar.extf %weight_value2_bf16 : bf16 to f32
          %product0 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %input_value, %weight_value0 : f32
          %product1 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %input_value, %weight_value1 : f32
          %product2 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %input_value, %weight_value2 : f32
          %next0 = scalar.addf<reassoc|nnan|ninf|nsz> %acc_channel0, %product0 : f32
          %next1 = scalar.addf<reassoc|nnan|ninf|nsz> %acc_channel1, %product1 : f32
          %next2 = scalar.addf<reassoc|nnan|ninf|nsz> %acc_channel2, %product2 : f32
          scf.yield %next0, %next1, %next2 : f32, f32, f32
        }
        scf.yield %dot_channel0, %dot_channel1, %dot_channel2 : f32, f32, f32
      }
      scf.yield %dot_x0, %dot_x1, %dot_x2 : f32, f32, f32
    }
    %bias0_bf16 = view.load %bias_view[%zero] : view<[%output_channel_count]xbf16, #dense> -> bf16
    %bias1_bf16 = view.load %bias_view[%unit] : view<[%output_channel_count]xbf16, #dense> -> bf16
    %bias2_bf16 = view.load %bias_view[%two] : view<[%output_channel_count]xbf16, #dense> -> bf16
    %bias0 = scalar.extf %bias0_bf16 : bf16 to f32
    %bias1 = scalar.extf %bias1_bf16 : bf16 to f32
    %bias2 = scalar.extf %bias2_bf16 : bf16 to f32
    %value0 = scalar.addf<reassoc|nnan|ninf|nsz> %dot0, %bias0 : f32
    %value1 = scalar.addf<reassoc|nnan|ninf|nsz> %dot1, %bias1 : f32
    %value2 = scalar.addf<reassoc|nnan|ninf|nsz> %dot2, %bias2 : f32
    %rounded0_bf16 = scalar.fptrunc %value0 : f32 to bf16
    %rounded1_bf16 = scalar.fptrunc %value1 : f32 to bf16
    %rounded2_bf16 = scalar.fptrunc %value2 : f32 to bf16
    %rounded0 = scalar.extf %rounded0_bf16 : bf16 to f32
    %rounded1 = scalar.extf %rounded1_bf16 : bf16 to f32
    %rounded2 = scalar.extf %rounded2_bf16 : bf16 to f32
    view.store %rounded0, %output_view[%x, %y, %zero, %batch] : f32, view<[%width]x[%height]x[%output_channel_count]x[%batch_count]xf32, #dense>
    view.store %rounded1, %output_view[%x, %y, %unit, %batch] : f32, view<[%width]x[%height]x[%output_channel_count]x[%batch_count]xf32, #dense>
    view.store %rounded2, %output_view[%x, %y, %two, %batch] : f32, view<[%width]x[%height]x[%output_channel_count]x[%batch_count]xf32, #dense>
