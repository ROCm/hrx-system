    %rhs2 = vector.fragment.load<rhs> %weight_view[%k_origin, %output_channel_origin2] shape [%k, %n] : view<[%reduction_count]x[%output_channel_count]xbf16, %weight_layout> -> vector<16xbf16>
    %next02 = vector.mma %lhs0, %rhs2, %acc02 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %rhs3 = vector.fragment.load<rhs> %weight_view[%k_origin, %output_channel_origin3] shape [%k, %n] : view<[%reduction_count]x[%output_channel_count]xbf16, %weight_layout> -> vector<16xbf16>
    %next03 = vector.mma %lhs0, %rhs3, %acc03 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %rhs4 = vector.fragment.load<rhs> %weight_view[%k_origin, %output_channel_origin4] shape [%k, %n] : view<[%reduction_count]x[%output_channel_count]xbf16, %weight_layout> -> vector<16xbf16>
    %next10 = vector.mma %lhs0, %rhs4, %acc10 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %rhs5 = vector.fragment.load<rhs> %weight_view[%k_origin, %output_channel_origin5] shape [%k, %n] : view<[%reduction_count]x[%output_channel_count]xbf16, %weight_layout> -> vector<16xbf16>
    %next11 = vector.mma %lhs0, %rhs5, %acc11 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %rhs6 = vector.fragment.load<rhs> %weight_view[%k_origin, %output_channel_origin6] shape [%k, %n] : view<[%reduction_count]x[%output_channel_count]xbf16, %weight_layout> -> vector<16xbf16>
    %next12 = vector.mma %lhs0, %rhs6, %acc12 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %rhs7 = vector.fragment.load<rhs> %weight_view[%k_origin, %output_channel_origin7] shape [%k, %n] : view<[%reduction_count]x[%output_channel_count]xbf16, %weight_layout> -> vector<16xbf16>
    %next13 = vector.mma %lhs0, %rhs7, %acc13 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
    scf.yield %next00, %next01, %next02, %next03, %next10, %next11, %next12, %next13 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }
  %lane_column = index.rem %lane, %sixteen : index
  %lane_group = index.div %lane, %sixteen : index
  %column0 = index.add %output_channel_origin, %lane_column : index
  %column1 = index.add %output_channel_origin1, %lane_column : index
  %column2 = index.add %output_channel_origin2, %lane_column : index
  %column3 = index.add %output_channel_origin3, %lane_column : index
  %column4 = index.add %output_channel_origin4, %lane_column : index
  %column5 = index.add %output_channel_origin5, %lane_column : index
  %column6 = index.add %output_channel_origin6, %lane_column : index
  %column7 = index.add %output_channel_origin7, %lane_column : index
  %bias0_bf16 = view.load %bias_view[%column0] : view<[%output_channel_count]xbf16, #dense> -> bf16
  %bias1_bf16 = view.load %bias_view[%column1] : view<[%output_channel_count]xbf16, #dense> -> bf16
  %bias2_bf16 = view.load %bias_view[%column2] : view<[%output_channel_count]xbf16, #dense> -> bf16
  %bias3_bf16 = view.load %bias_view[%column3] : view<[%output_channel_count]xbf16, #dense> -> bf16
  %bias4_bf16 = view.load %bias_view[%column4] : view<[%output_channel_count]xbf16, #dense> -> bf16
  %bias5_bf16 = view.load %bias_view[%column5] : view<[%output_channel_count]xbf16, #dense> -> bf16
  %bias6_bf16 = view.load %bias_view[%column6] : view<[%output_channel_count]xbf16, #dense> -> bf16
  %bias7_bf16 = view.load %bias_view[%column7] : view<[%output_channel_count]xbf16, #dense> -> bf16
  %bias0 = scalar.extf %bias0_bf16 : bf16 to f32
  %bias1 = scalar.extf %bias1_bf16 : bf16 to f32
  %bias2 = scalar.extf %bias2_bf16 : bf16 to f32
  %bias3 = scalar.extf %bias3_bf16 : bf16 to f32
  %bias4 = scalar.extf %bias4_bf16 : bf16 to f32
  %bias5 = scalar.extf %bias5_bf16 : bf16 to f32
  %bias6 = scalar.extf %bias6_bf16 : bf16 to f32
  %bias7 = scalar.extf %bias7_bf16 : bf16 to f32
  %shortcut_bias0_bf16 = view.load %shortcut_bias_view[%column0] : view<[%output_channel_count]xbf16, #dense> -> bf16
  %shortcut_bias1_bf16 = view.load %shortcut_bias_view[%column1] : view<[%output_channel_count]xbf16, #dense> -> bf16
  %shortcut_bias2_bf16 = view.load %shortcut_bias_view[%column2] : view<[%output_channel_count]xbf16, #dense> -> bf16
  %shortcut_bias3_bf16 = view.load %shortcut_bias_view[%column3] : view<[%output_channel_count]xbf16, #dense> -> bf16
  %shortcut_bias4_bf16 = view.load %shortcut_bias_view[%column4] : view<[%output_channel_count]xbf16, #dense> -> bf16
  %shortcut_bias5_bf16 = view.load %shortcut_bias_view[%column5] : view<[%output_channel_count]xbf16, #dense> -> bf16
  %shortcut_bias6_bf16 = view.load %shortcut_bias_view[%column6] : view<[%output_channel_count]xbf16, #dense> -> bf16
  %shortcut_bias7_bf16 = view.load %shortcut_bias_view[%column7] : view<[%output_channel_count]xbf16, #dense> -> bf16
  %shortcut_bias0 = scalar.extf %shortcut_bias0_bf16 : bf16 to f32
  %shortcut_bias1 = scalar.extf %shortcut_bias1_bf16 : bf16 to f32
  %shortcut_bias2 = scalar.extf %shortcut_bias2_bf16 : bf16 to f32
  %shortcut_bias3 = scalar.extf %shortcut_bias3_bf16 : bf16 to f32
  %shortcut_bias4 = scalar.extf %shortcut_bias4_bf16 : bf16 to f32
  %shortcut_bias5 = scalar.extf %shortcut_bias5_bf16 : bf16 to f32
  %shortcut_bias6 = scalar.extf %shortcut_bias6_bf16 : bf16 to f32
  %shortcut_bias7 = scalar.extf %shortcut_bias7_bf16 : bf16 to f32
  %combined_bias0 = scf.if %add_shortcut_bias -> (f32) {
    %value = scalar.addf<reassoc|nnan|ninf|nsz> %bias0, %shortcut_bias0 : f32
