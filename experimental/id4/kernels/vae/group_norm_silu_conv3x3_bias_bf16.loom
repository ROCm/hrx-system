      %row1 = index.div %pixel1, %height : index
      %x1 = index.rem %row1, %width : index
      %batch1 = index.div %row1, %width : index
      %output_x_row_base1 = index.mul %x1, %height : index
      %output_pixel_base1 = index.add %output_x_row_base1, %y1 : index
      %output_pixel_element_base1 = index.mul %output_pixel_base1, %output_channel_stride : index
      %output_channel_element_base10 = index.add %output_pixel_element_base1, %column4 : index
      %output_channel_element_base11 = index.add %output_pixel_element_base1, %column5 : index
      %output_channel_element_base12 = index.add %output_pixel_element_base1, %column6 : index
      %output_channel_element_base13 = index.add %output_pixel_element_base1, %column7 : index
