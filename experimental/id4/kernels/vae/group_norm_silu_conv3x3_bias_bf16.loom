      view.store %rounded01, %output_flat_view[%output_element01] : bf16, view<[%output_storage_element_count]xbf16, #dense>
      view.store %rounded02, %output_flat_view[%output_element02] : bf16, view<[%output_storage_element_count]xbf16, #dense>
      view.store %rounded03, %output_flat_view[%output_element03] : bf16, view<[%output_storage_element_count]xbf16, #dense>
