      view.store %rounded11, %output_flat_view[%output_element11] : bf16, view<[%output_storage_element_count]xbf16, #dense>
      view.store %rounded12, %output_flat_view[%output_element12] : bf16, view<[%output_storage_element_count]xbf16, #dense>
