iree_py_binary(
    name = "assembly_pack_cases",
    testonly = True,
    srcs = ["assembly_pack_cases.py"],
    main = "assembly_pack_cases.py",
)

xdna_execution_test_suite(
    name = "assembly_pack_npu2_test",
    data = [
        "testdata/assembly_pack.cxx",
        "testdata/assembly_pack.loom",
        "//loom/src/loom/import/cxx:include/loomcxx/low.h",
    ],
    manifests = ["assembly_pack_npu2.test.json"],
    tags = ["manual"],
    target_compatible_with = select({
        "//loom/config/import:cxx": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }) + select({
        "//loom/config/target:xdna_artifacts": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }) + select({
        "@platforms//os:linux": [],
        "@platforms//os:windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    tools = {
        "generate-cases": ":assembly_pack_cases",
        "iree-xdna-run": "//experimental/xdna:iree-xdna-run",
        "loom-compile": "//loom/src/loom/tools/loom-compile",
        "loom-import-cxx": "//loom/src/loom/tools/loom-import-cxx",
        "loom-link": "//loom/src/loom/tools/loom-link",
    },
)

