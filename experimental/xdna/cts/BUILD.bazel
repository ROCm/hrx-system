load("//build_tools/bazel:python.bzl", "iree_py_binary")
load("//experimental/xdna:build_defs.bzl", "xdna_cc_test", "xdna_execution_test_suite")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

iree_py_binary(
    name = "vector_copy_cases",
    testonly = True,
    srcs = ["vector_copy_cases.py"],
    main = "vector_copy_cases.py",
)

# This packet corpus selects the NPU2 profile and runs explicitly on matching
# hardware; the consumer CTS below select images from the device family.
xdna_execution_test_suite(
    name = "vector_copy_npu2_test",
    data = [
        "testdata/vector_copy.cpp",
        "testdata/vector_copy.loom",
        "//loom/src/loom/import/cxx:include/loomcxx/kernel.h",
    ],
    manifests = ["vector_copy_npu2.test.json"],
    tags = ["manual"],
    target_compatible_with = select({
        "//loom/config/import:cxx": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }) + select({
        "//loom/config/target:xdna_artifacts": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }) + select({
        "@platforms//os:linux": [],
        "@platforms//os:windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    tools = {
        "generate-cases": ":vector_copy_cases",
        "iree-xdna-run": "//experimental/xdna:iree-xdna-run",
        "loom-compile": "//loom/src/loom/tools/loom-compile",
        "loom-import-cxx": "//loom/src/loom/tools/loom-import-cxx",
        "loom-link": "//loom/src/loom/tools/loom-link",
    },
)

[
    xdna_cc_test(
        name = "execution_test" + suffix,
        srcs = ["execution_test.cc"],
        args = ["--amdf_native_lifetime=" + lifetime],
        target_compatible_with = select({
            "@platforms//os:linux": [],
            "@platforms//os:windows": [],
            "//conditions:default": ["@platforms//:incompatible"],
        }),
        deps = [
            "//experimental/xdna:executable",
            "//libamdf:amdf_static",
            "//libamdf:headers",
            "//libamdf/cts/util:device_cache",
            "//libamdf/cts/util:linked_test_main",
            "//libamdf/cts/util:provider_headers",
            "//libamdf/cts/xdna:xdna_device_fixture",
            "//runtime/src/iree/base",
            "//runtime/src/iree/hal",
            "//runtime/src/iree/hal/drivers/amd/xdna/image/aie2p:npu2",
            "//runtime/src/iree/hal/drivers/amd/xdna/image/testdata:mul_i32",
            "//runtime/src/iree/hal/drivers/amd/xdna/image/testdata:mul_i32_npu4",
            "//runtime/src/iree/hal/drivers/amd/xdna/image/testing:image_fixture",
            "//runtime/src/iree/testing:gtest",
        ],
    )
    for lifetime, suffix in [
        ("process", ""),
        ("instance", "_instance"),
    ]
]
