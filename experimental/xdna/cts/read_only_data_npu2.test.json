{
  "version": 1,
  "cases": [
    {
      "name": "immutable worker-local data is initialized through its owner address on NPU2",
      "steps": [
        {
          "name": "fixtures",
          "run": {
            "tool": "generate-cases",
            "args": ["{tmp}/fixtures"]
          }
        },
        {
          "name": "compile",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{srcdir}/testdata/read_only_data.loom",
              "--root=@read_only_data",
              "--target=amd.xdna.aie2p:amd.xdna.strix_halo.17f0_11",
              "--output={tmp}/read-only-data.xdna"
            ]
          }
        },
        {
          "name": "execute",
          "run": {
            "tool": "iree-xdna-run",
            "args": [
              "--image={tmp}/read-only-data.xdna",
              "--columns=1",
              "--entry=read_only_data",
              "--invocation_count=1",
              "--binding_memory=system",
              "--binding={tmp}/fixtures/input.bin",
              "--binding={tmp}/fixtures/output.bin",
              "--output=0={tmp}/input-readback.bin",
              "--output=1={tmp}/output-readback.bin"
            ]
          },
          "files": [
            {
              "path": "{tmp}/input-readback.bin",
              "equals": "{tmp}/fixtures/input.bin"
            },
            {
              "path": "{tmp}/output-readback.bin",
              "equals": "{tmp}/fixtures/expected.bin"
            }
          ]
        }
      ]
    }
  ]
}
