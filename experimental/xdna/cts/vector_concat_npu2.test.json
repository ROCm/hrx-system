{
  "version": 1,
  "cases": [
    {
      "name": "Packed bytes_1_16 concatenation preserves payloads and guards on NPU2",
      "steps": [
        {
          "name": "fixtures",
          "run": {
            "tool": "generate-cases",
            "args": [
              "{tmp}/fixtures",
              "bytes_1_16"
            ]
          }
        },
        {
          "name": "compile",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{srcdir}/testdata/vector_concat.loom",
              "--root=@concat_bytes_1_16",
              "--target=amd.xdna.aie2p:amd.xdna.strix_halo.17f0_11",
              "--output={tmp}/concat.xdna"
            ]
          }
        },
        {
          "name": "execute",
          "run": {
            "tool": "iree-xdna-run",
            "args": [
              "--image={tmp}/concat.xdna",
              "--columns=1",
              "--entry=concat_bytes_1_16",
              "--invocation_count=1",
              "--binding_memory=system",
              "--binding={tmp}/fixtures/input.bin",
              "--binding={tmp}/fixtures/output.bin",
              "--output=0={tmp}/input-readback.bin",
              "--output=1={tmp}/output-readback.bin"
            ]
          },
          "files": [
            {
              "path": "{tmp}/input-readback.bin",
              "equals": "{tmp}/fixtures/input.bin"
            },
            {
              "path": "{tmp}/output-readback.bin",
              "equals": "{tmp}/fixtures/expected.bin"
            }
          ]
        }
      ]
    },
