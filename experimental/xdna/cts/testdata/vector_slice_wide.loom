// Every byte offset across two ordinary X carriers is checked natively.
aie2p.target<array> @array_target
aie2p.target<core> @core_target

pipeline.def<kernel> public retain target(@array_target) @slice_bytes_0() launch(%input: buffer, %output: buffer) {
  %count = index.constant 1 : index
  %origin = index.constant 0 : offset
  %workers = group.create %count : index -> group
  %input_view = buffer.view %input[%origin] : buffer -> view<1x16x32xi32>
  %output_view = buffer.view %output[%origin] : buffer -> view<1x16x256xi32>
  %packets = pipeline.scatter %input_view across %workers : view<1x16x32xi32>, group -> pipeline.flow<tile<32xi32>>
  %results = pipeline.stage @slice_bytes_0_entry on %workers(%packets) : (group, pipeline.flow<tile<32xi32>>) -> (pipeline.flow<tile<256xi32>>)
  pipeline.write %results to %output_view : pipeline.flow<tile<256xi32>>, view<1x16x256xi32>
  pipeline.return
}

