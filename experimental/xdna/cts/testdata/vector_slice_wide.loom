  vector.store %slice14, %destination_view14[0] : vector<2xi8>, view<2xi8>

  %offset15 = index.constant 960 : offset
  %padding_view15 = buffer.view %destination[%offset15] : buffer -> view<16xi32>
  vector.store %padding, %padding_view15[0] : vector<16xi32>, view<16xi32>
  %slice15 = vector.slice %value[127] : vector<128xi8> -> vector<1xi8>
  %destination_view15 = buffer.view %destination[%offset15] : buffer -> view<1xi8>
  vector.store %slice15, %destination_view15[0] : vector<1xi8>, view<1xi8>

  func.return
}
