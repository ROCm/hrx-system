global.rodata.def @lookup = align(32) bytes("443322118877665578563412f0debc9a")

aie2p.target<array> @array_target

aie2p.target<core> @core_target

pipeline.def<kernel> public retain target(@array_target) @read_only_data() launch(%input: buffer, %output: buffer) {
  %count = index.constant 1 : index
  %zero = index.constant 0 : offset
  %workers = group.create %count : index -> group
  %input_view = buffer.view %input[%zero] : buffer -> view<1xi32>
  %output_view = buffer.view %output[%zero] : buffer -> view<1xi32>
  %input_flow = pipeline.read %input_view on %workers : view<1xi32>, group -> pipeline.flow<tile<1xi32>>
  %result = pipeline.stage @add_table_value on %workers(%input_flow) : (group, pipeline.flow<tile<1xi32>>) -> (pipeline.flow<tile<1xi32>>)
  pipeline.write %result to %output_view : pipeline.flow<tile<1xi32>>, view<1xi32>
  pipeline.return
}

func.def target(@core_target) @add_table_value(%input: buffer, %output: buffer) {
  %table = global.load @lookup : buffer
  %zero = index.constant 0 : offset
  %input_view = buffer.view %input[%zero] : buffer -> view<1xi32>
  %output_view = buffer.view %output[%zero] : buffer -> view<1xi32>
  %table_view = buffer.view %table[%zero] : buffer -> view<4xi32>
  %input_value = view.load %input_view[0] : view<1xi32> -> i32
  %table_value = view.load %table_view[2] : view<4xi32> -> i32
  %result = scalar.addi %input_value, %table_value : i32
  view.store %result, %output_view[0] : i32, view<1xi32>
  func.return
}
