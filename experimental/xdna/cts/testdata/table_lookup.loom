  %output_view = buffer.view %output[%origin] : buffer -> view<1x64x32xi32>
  %packets = pipeline.scatter %input_view across %workers : view<1x64x32xi32>, group -> pipeline.flow<tile<32xi32>>
  %results = pipeline.stage @i8_odd_entry on %workers(%packets) : (group, pipeline.flow<tile<32xi32>>) -> (pipeline.flow<tile<32xi32>>)
