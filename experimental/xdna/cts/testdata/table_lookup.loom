func.def target(@core_target) @i8_odd_entry(%input: buffer, %output: buffer) {
  %source, %destination = buffer.assume.alignment %input, %output {minimum_alignment = 64} : buffer, buffer
  %origin = index.constant 0 : offset
  %offset = index.constant 64 : offset
  %table_view = buffer.view %source[%origin] : buffer -> view<3xi8>
  %table = vector.load %table_view[0] : view<3xi8> -> vector<3xi8>
