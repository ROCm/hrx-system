  vector.store %overwrite, %overwrite_view[0] : vector<16xi32>, view<32xi32>
  vector.store %overwrite, %overwrite_view[16] : vector<16xi32>, view<32xi32>
  %decoded = vector.table.lookup %table[%codes] : vector<3xi8>, vector<64xi8> -> vector<64xi8>
  %last = vector.constant 2 : vector<64xi8>
  %broadcast = vector.table.lookup %table[%last] : vector<3xi8>, vector<64xi8> -> vector<64xi8>
  %decoded_view = buffer.view %destination[%origin] : buffer -> view<64xi8>
  %broadcast_view = buffer.view %destination[%offset] : buffer -> view<64xi8>
  vector.store %decoded, %decoded_view[0] : vector<64xi8>, view<64xi8>
  vector.store %broadcast, %broadcast_view[0] : vector<64xi8>, view<64xi8>
  func.return
