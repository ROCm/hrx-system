  %decoded = vector.table.lookup %table[%first] : vector<8xf64>, vector<8xi8> -> vector<8xf64>
  %last = vector.constant 7 : vector<8xi8>
  %broadcast = vector.table.lookup %table[%last] : vector<8xf64>, vector<8xi8> -> vector<8xf64>
  %decoded_view = buffer.view %destination[%origin] : buffer -> view<8xf64>
  %broadcast_view = buffer.view %destination[%offset] : buffer -> view<8xf64>
  vector.store %decoded, %decoded_view[0] : vector<8xf64>, view<8xf64>
  vector.store %broadcast, %broadcast_view[0] : vector<8xf64>, view<8xf64>
  func.return
}
