  %input_view = buffer.view %input[%origin] : buffer -> view<1x4128x64xbf16>
  %output_view = buffer.view %output[%origin] : buffer -> view<1x4128x32xi16>
  %packets = pipeline.scatter %input_view across %workers : view<1x4128x64xbf16>, group -> pipeline.flow<tile<64xbf16>>
  %results = pipeline.stage @compare_bf16_entry on %workers(%packets) : (group, pipeline.flow<tile<64xbf16>>) -> (pipeline.flow<tile<32xi16>>)
  pipeline.write %results to %output_view : pipeline.flow<tile<32xi16>>, view<1x4128x32xi16>
  pipeline.return
}

