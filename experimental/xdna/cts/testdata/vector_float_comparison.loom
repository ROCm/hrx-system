  %input_view = buffer.view %input[%origin] : buffer -> view<1x578x32xf32>
  %output_view = buffer.view %output[%origin] : buffer -> view<1x578x16xi32>
  %packets = pipeline.scatter %input_view across %workers : view<1x578x32xf32>, group -> pipeline.flow<tile<32xf32>>
