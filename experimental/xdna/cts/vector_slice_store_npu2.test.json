{
  "version": 1,
  "cases": [
    {
      "name": "i8 slices and partial stores preserve snapshots and guards on NPU2",
      "steps": [
        {
          "name": "fixtures",
          "run": {
            "tool": "generate-cases",
            "args": [
              "{tmp}/fixtures",
              "1"
            ]
          }
        },
        {
          "name": "compile",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{srcdir}/testdata/vector_slice_store.loom",
              "--root=@store_i8",
              "--target=amd.xdna.aie2p:amd.xdna.strix_halo.17f0_11",
              "--output={tmp}/store.xdna"
            ]
          }
        },
        {
          "name": "execute",
          "run": {
            "tool": "iree-xdna-run",
            "args": [
              "--image={tmp}/store.xdna",
              "--columns=1",
              "--entry=store_i8",
              "--invocation_count=1",
              "--binding_memory=system",
              "--binding={tmp}/fixtures/input.bin",
              "--binding={tmp}/fixtures/output.bin",
              "--output=0={tmp}/input-readback.bin",
              "--output=1={tmp}/output-readback.bin"
            ]
          },
          "files": [
            {
              "path": "{tmp}/input-readback.bin",
              "equals": "{tmp}/fixtures/input.bin"
            },
            {
              "path": "{tmp}/output-readback.bin",
              "equals": "{tmp}/fixtures/expected.bin"
            }
          ]
        }
      ]
    },
