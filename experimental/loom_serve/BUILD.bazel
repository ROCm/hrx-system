load("//build_tools/bazel:test_resources.bzl", "GPU_DEVICE_RESOURCE_GROUP")
load("//build_tools/embed_data:build_defs.bzl", "iree_c_embed_data")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test", "loom_config_compatible_with", "loom_generated_file", "loom_generated_file_family")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

loom_cc_library(
    name = "command",
    srcs = ["command.c"],
    hdrs = ["command.h"],
    deps = [
        "//loom/src/loom/target/arch/cmd:program",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base:core_headers",
        "//runtime/src/iree/hal",
    ],
)

loom_generated_file(
    name = "control_model_binary",
    testonly = True,
    args = [
        "$(location :control_model.loom)",
        "--target=vm:core",
    ],
    generator = "//loom/src/loom/tools/loom-compile",
    inputs = [":control_model.loom"],
    output = "control_model.vm",
    output_flag = "--output=",
    target_compatible_with = loom_config_compatible_with(["//loom/config/target/arch:vm"]),
)

loom_generated_file_family(
    name = "control_commands",
    testonly = True,
    args = [
        "$(location :control_kernels.loom)",
        "--product=command",
        "--root=@prefill_to_decode",
        "--root=@decode_transition",
    ],
    generator = "//loom/src/loom/tools/loom-compile",
    inputs = [":control_kernels.loom"],
    output_directories = ["control_commands"],
    output_flags = [
        "--output=",
        "--emit-command-artifacts=",
    ],
    outputs = [
        "control_manifest.json",
        "control_commands",
    ],
)

[
    loom_generated_file(
        name = stage + "_binary",
        testonly = True,
        args = [
            "$(location :control_kernels.loom)",
            "--root=@qwen38_" + stage,
            "--target=amdgpu:gfx1151",
        ],
        generator = "//loom/src/loom/tools/loom-compile",
        inputs = [":control_kernels.loom"],
        output = stage + ".hsaco",
        output_flag = "--output=",
        target_compatible_with = loom_config_compatible_with(["//loom/config/target/arch:amdgpu"]),
    )
    for stage in [
        "prefill_finish_control",
        "decode_commit_token",
    ]
]

iree_c_embed_data(
    name = "control_data",
    testonly = True,
    srcs = [
        ":control_model_binary",
        ":decode_commit_token_binary",
        ":prefill_finish_control_binary",
    ],
    c_file_output = "control_data.c",
    h_file_output = "control_data.h",
    identifier = "loom_serve_control_data",
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:vm",
        "//loom/config/target/arch:amdgpu",
    ]),
)

loom_cc_test(
    name = "control_test",
    srcs = ["control_test.cc"],
    args = ["--control_manifest=$(rootpath :control_manifest.json)"],
    data = [
        ":control_commands",
        ":control_manifest.json",
    ],
    resource_group = GPU_DEVICE_RESOURCE_GROUP,
    tags = ["iree-run-requirement=runtime.resource.amd_gpu"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:vm",
        "//loom/config/target/arch:amdgpu",
        "//runtime/config/hal:driver_amdgpu",
    ]),
    deps = [
        ":command",
        ":control_data",
        ":execution",
        ":module",
        "//loom/src/loom/target/arch/cmd:program",
        "//runtime/src/iree/async",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/base/tooling:flags",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/drivers",
        "//runtime/src/iree/module/hal:types",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
        "//runtime/src/iree/vm",
        "//runtime/src/iree/vm/bytecode:module",
    ],
)

loom_cc_library(
    name = "execution",
    srcs = ["execution.c"],
    hdrs = ["execution.h"],
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/hal",
    ],
)

loom_cc_library(
    name = "module",
    srcs = ["module.c"],
    hdrs = ["module.h"],
    deps = [
        ":execution",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/module/hal:types",
        "//runtime/src/iree/vm",
    ],
)
