load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],
)

loom_cc_library(
    name = "signals",
    srcs = ["signals.c"],
    hdrs = ["signals.h"],
    deps = [
        "//runtime/src/iree/async",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
    ],
)

loom_cc_library(
    name = "host_flags",
    srcs = ["host_flags.c"],
    hdrs = ["host_flags.h"],
    deps = [
        "//loom/src/loom/serve/runtime/host",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/tooling:flags",
    ],
)

loom_cc_test(
    name = "signals_test",
    srcs = ["signals_test.cc"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":signals",
        "//runtime/src/iree/async",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "device_flags",
    srcs = ["device_flags.c"],
    hdrs = ["device_flags.h"],
    deps = [
        "//loom/src/loom/serve/runtime/device",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/tooling:flags",
    ],
)
