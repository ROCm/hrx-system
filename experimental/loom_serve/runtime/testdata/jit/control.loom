func.decl import("runner") @execute_1(%stage: i32, %storage: hal.buffer) -> (i64)
func.def public @step(%storage: hal.buffer) -> (i64) {
  %zero = scalar.constant 0 : i32
  %completion = func.call @execute_1(%zero, %storage) : (i32, hal.buffer) -> (i64)
  func.return %completion : i64
}
