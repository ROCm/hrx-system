config.def @increment.delta = 5 : index
config.def @increment.temporary_bytes = 64 : offset

// The catalog encounters declarations before the implementation provider.
command.program.decl @advance() launch(%storage: buffer)
command.program.decl @idle() launch()
command.program.decl @missing() launch()

command.program.def public @ambiguous() launch() {
  command.return
}

func.def public @not_command() {
  func.return
}
