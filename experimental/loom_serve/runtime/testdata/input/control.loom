func.decl import("input") @encode(%text: buffer, %flags: i32, %capacity: i64) -> (buffer, i64)
func.decl import("input") @lookup(%token: buffer) -> (i32)
func.decl import("input") @require(%condition: i32, %diagnostic: buffer)

func.def public @tokens(%text: buffer, %flags: i32, %capacity: i64) -> (buffer, i64) {
  %ids, %count = func.call @encode(%text, %flags, %capacity) : (buffer, i32, i64) -> (buffer, i64)
  func.return %ids, %count : buffer, i64
}
func.def public @find(%token: buffer) -> (i32) {
  %id = func.call @lookup(%token) : (buffer) -> (i32)
  func.return %id : i32
}
func.def public @check(%condition: i32, %diagnostic: buffer) {
  func.call @require(%condition, %diagnostic) : (i32, buffer) -> ()
  func.return
}
