func.decl import("prepare") @stage(%root: buffer, %tag: i64) -> (i32)
func.decl import("prepare") @config(%stage: i32, %key: buffer, %value: buffer)
func.decl import("prepare") @config_i64(%stage: i32, %key: buffer, %value: i64)
func.decl import("prepare") @parameter(%stage: i32, %binding: i32, %directory: buffer, %path: buffer, %policy: buffer)

// stage_root
global.rodata.def @root = bytes("73746167655f726f6f74")
// feature.enabled
global.rodata.def @key = bytes("666561747572652e656e61626c6564")
// true
global.rodata.def @value = bytes("74727565")
// /checkpoints
global.rodata.def @directory = bytes("2f636865636b706f696e7473")
// model.safetensors
global.rodata.def @path = bytes("6d6f64656c2e7361666574656e736f7273")
// weights.loom
global.rodata.def @policy = bytes("776569676874732e6c6f6f6d")

func.def public @text_config() {
  %root = global.load @root : buffer
  %tag = scalar.constant 0 : i64
  %stage = func.call @stage(%root, %tag) : (buffer, i64) -> (i32)
  %key = global.load @key : buffer
  %value = global.load @value : buffer
  func.call @config(%stage, %key, %value) : (i32, buffer, buffer) -> ()
  func.return
}

func.def public @missing_stage() {
  %stage = scalar.constant 0 : i32
  %key = global.load @key : buffer
  %value = global.load @value : buffer
  func.call @config(%stage, %key, %value) : (i32, buffer, buffer) -> ()
  func.return
}

func.def public @duplicate_parameter() {
  %root = global.load @root : buffer
  %tag = scalar.constant 0 : i64
  %stage = func.call @stage(%root, %tag) : (buffer, i64) -> (i32)
  %zero = scalar.constant 0 : i32
  %directory = global.load @directory : buffer
  %path = global.load @path : buffer
  %policy = global.load @policy : buffer
  func.call @parameter(%stage, %zero, %directory, %path, %policy) : (i32, i32, buffer, buffer, buffer) -> ()
  func.call @parameter(%stage, %zero, %directory, %path, %policy) : (i32, i32, buffer, buffer, buffer) -> ()
  func.return
}

func.def public @no_stages() {
  func.return
}

// Crosses multiple growth boundaries on each independently owned array.
// The key buffer is reused; every declaration must own its copied spelling.
func.def public @large_catalog() {
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %count = index.constant 33 : index
  %ten = index.constant 10 : index
  %digit_zero = scalar.constant 48 : i8
  %letter_k = scalar.constant 107 : i8
  %origin = index.constant 0 : offset
  %key_bytes = index.constant 3 : offset
  %key = buffer.alloca<private> align(1) %key_bytes : buffer
  %key_view = buffer.view %key[%origin] : buffer -> view<3xi8>
  view.store %letter_k, %key_view[0] : i8, view<3xi8>
  %root = global.load @root : buffer
  %directory = global.load @directory : buffer
  %path = global.load @path : buffer
  %policy = global.load @policy : buffer
  scf.for %i = [%zero to %count step %one] {
    %tag = index.cast %i : index to i64
    %stage = func.call @stage(%root, %tag) : (buffer, i64) -> (i32)
    scf.for %j = [%zero to %count step %one] {
      %tens = index.div %j, %ten : index
      %ones = index.rem %j, %ten : index
      %tens_byte = index.cast %tens : index to i8
      %ones_byte = index.cast %ones : index to i8
      %first = scalar.addi %tens_byte, %digit_zero : i8
      %second = scalar.addi %ones_byte, %digit_zero : i8
      view.store %first, %key_view[1] : i8, view<3xi8>
      view.store %second, %key_view[2] : i8, view<3xi8>
      %value = index.cast %j : index to i64
      %binding = index.cast %j : index to i32
      func.call @config_i64(%stage, %key, %value) : (i32, buffer, i64) -> ()
      func.call @parameter(%stage, %binding, %directory, %path, %policy) : (i32, i32, buffer, buffer, buffer) -> ()
      scf.yield
    }
    scf.yield
  }
  func.return
}
