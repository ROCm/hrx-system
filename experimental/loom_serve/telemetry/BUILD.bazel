load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],
)

loom_cc_library(
    name = "record",
    srcs = ["record.c"],
    hdrs = ["record.h"],
    deps = [
        "//loom/src/loom/util:json",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "stream",
    srcs = ["stream.c"],
    hdrs = ["stream.h"],
    deps = [
        ":record",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal",
    ],
)

loom_cc_test(
    name = "record_test",
    srcs = ["record_test.cc"],
    deps = [
        ":record",
        ":stream",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "weights",
    srcs = ["weights.c"],
    hdrs = ["weights.h"],
    deps = [
        ":record",
        ":stream",
        "//experimental/loom_serve/runtime:weights",
        "//runtime/src/iree/base",
    ],
)

loom_cc_test(
    name = "weights_test",
    srcs = ["weights_test.cc"],
    deps = [
        ":record",
        ":stream",
        ":weights",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_test(
    name = "stream_test",
    srcs = ["stream_test.cc"],
    deps = [
        ":stream",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
