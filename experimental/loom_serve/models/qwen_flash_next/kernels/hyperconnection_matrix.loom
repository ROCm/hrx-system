config.decl @flash_next.token_count : %value: index where [range(%value, 1, 32768)]

amdgpu.target<gfx11-generic> @flash_next_hc_matrix_wave32 {subgroup_size = 32}

func.decl @flash_next_token_count(%epoch: buffer, %capacity: index) -> (index)

template.decl @flash_next.q8_contract(%capacity: index, %inputs: index, %outputs: index, %streams: index, %tile_rows: index, %tile_columns: index, %wave_rows: index, %wave_columns: index, %pipeline_depth: index, %fragment_count: index, %first: index, %end: index, %channel_base: index, %split_scales: i1, %input: buffer, %weight: buffer) -> (vector<[%fragment_count]x8xf32>)

template.decl @flash_next.matrix_store_fragment(%remaining_rows: index, %outputs: index, %fragment_row: index, %result_column: index, %result: vector<8xf32>, %output_view: view<[%remaining_rows]x[%outputs]xbf16>)

// Up assigns all four stream fragments for sixteen features to each wave,
// retaining gates and their blend in F32 until the final BF16 store. The
// normalized source is disjoint from the low-rank input, weights, and output;
// no intermediate global gate tensor is needed.
func.def inline @hc_matrix_up_body(%span_arg: buffer, %normalized: buffer, %input_arg: buffer, %weight_arg: buffer, %output_arg: buffer) {
  %span, %input, %weight, %output = buffer.assume.noalias %span_arg, %input_arg, %weight_arg, %output_arg : buffer, buffer, buffer, buffer
  %capacity = config.get @flash_next.token_count : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %tile = index.constant 128 : index
  %rank = index.constant 320 : index
  %hidden = index.constant 2560 : index
  %logical_columns = index.div %tile, %c4 : index
  %batch = kernel.workgroup.id<y> : index
  %first = index.mul %batch, %tile : index
  %end = func.call @flash_next_token_count(%span, %capacity) : (buffer, index) -> (index)
  %active = index.cmp ult, %first, %end : index
  scf.if %active {
    %group = kernel.workgroup.id<x> : index
    %wave = kernel.subgroup.id : index
    %lane = kernel.subgroup.lane.id : index
    %channel_base = index.mul %group, %logical_columns : index
    %wave_column_group = index.rem %wave, %c2 : index
    %wave_row_group = index.div %wave, %c2 : index
    %wave_token = index.mul %wave_row_group, %c32 : index
    %origin = index.constant 0 : offset
    %remaining_rows = index.sub %end, %first : index
    %element_bytes = index.constant 2 : offset
    %output_row_bytes = index.scale %hidden, %element_bytes : index, offset -> offset
    %tile_byte_offset = index.scale %first, %output_row_bytes : index, offset -> offset
    %output_view = buffer.view %output[%tile_byte_offset] : buffer -> view<[%remaining_rows]x[%hidden]xbf16>
    %fragment_count = index.constant 8 : index
    %row_fragments = index.constant 2 : index
    %accumulator_zero = vector.constant 0.0 : vector<8xf32>
    %split_scales = scalar.constant false : i1
    %result_tile = template.apply<@flash_next.q8_contract>(%capacity, %rank, %hidden, %c4, %tile, %tile, %c4, %c2, %c1, %fragment_count, %first, %end, %channel_base, %split_scales, %input, %weight) : (index, index, index, index, index, index, index, index, index, index, index, index, index, i1, buffer, buffer) -> (vector<[%fragment_count]x8xf32>)
    %lane_column = index.rem %lane, %c16 : index
    %lane_row = index.div %lane, %c16 : index
    %quarter = vector.constant 0.25 : vector<8xf32>
    %c1_f32 = vector.constant 1.0 : vector<8xf32>
    %normalized_view = buffer.view %normalized[%origin] : buffer -> view<[%capacity]x4x2560xbf16>
    %c0_f32 = scalar.constant 0.0 : f32
    scf.for %row_fragment = [%c0 to %row_fragments step %c1] unroll schedule(linear) {
      %fragment_row = index.madd %row_fragment, %c16, %wave_token : index
      %wave_feature = index.mul %wave_column_group, %c16 : index
      %result_column = index.add %channel_base, %wave_feature : index
      %feature_value = index.add %result_column, %lane_column : index
      %last_feature = index.sub %hidden, %c1 : index
      %feature = index.assume %feature_value [range(%feature_value, 0, %last_feature)] : index
      %sum = scf.for %stream = [%c0 to %c4 step %c1](%partial = %accumulator_zero : vector<8xf32>) -> (vector<8xf32>) unroll schedule(linear) {
        %ordinal = index.madd %row_fragment, %c4, %stream : index
        %dot = vector.extract %result_tile[%ordinal] : vector<[%fragment_count]x8xf32> -> vector<8xf32>
        %negative = vector.negf %dot : vector<8xf32>
        %exponential = vector.expf<afn> %negative : vector<8xf32>
        %denominator = vector.addf %c1_f32, %exponential : vector<8xf32>
        %gate = vector.divf %c1_f32, %denominator : vector<8xf32>
        %values = scf.for %element = [%c0 to %c8 step %c1](%values = %accumulator_zero : vector<8xf32>) -> (vector<8xf32>) unroll schedule(linear) {
          %within_row = index.madd %element, %c2, %lane_row : index
          %local_row = index.add %fragment_row, %within_row : index
          %token = index.add %first, %local_row : index
          %live = index.cmp ult, %token, %end : index
          %safe_token = scf.select %live, %token, %c0 : index
          %packed = view.load %normalized_view[%safe_token, %stream, %feature] : view<[%capacity]x4x2560xbf16> -> bf16
          %wide = scalar.extf %packed : bf16 to f32
          %value = scf.select %live, %wide, %c0_f32 : f32
          %next = vector.insert %value into %values[%element] : f32, vector<8xf32>
          scf.yield %next : vector<8xf32>
        }
        %gated = vector.mulf %gate, %values : vector<8xf32>
        %next = vector.addf %partial, %gated : vector<8xf32>
        scf.yield %next : vector<8xf32>
      }
      %result = vector.mulf %sum, %quarter : vector<8xf32>
      template.apply<@flash_next.matrix_store_fragment>(%remaining_rows, %hidden, %fragment_row, %result_column, %result, %output_view) : (index, index, index, index, vector<8xf32>, view<[%remaining_rows]x[%hidden]xbf16>)
    }
  }
  func.return
}

// Share each reconstructed K64 panel across a 64x64 output tile. The high and
// residual BF16 weight planes preserve the original Q8 coefficient accuracy;
// each keeps an F32 accumulator until the final sum and quarter-scaled SiLU.
// Eight waves divide reconstruction evenly, and the next packed input/weight
// reads overlap the current matrix work without a global prepared-weight copy.
kernel.def target(@flash_next_hc_matrix_wave32) @hc_matrix_down() {
  %capacity = config.get @flash_next.token_count : index
  %c1 = index.constant 1 : index
  %rounding = index.constant 63 : index
  %tile = index.constant 64 : index
  %groups = index.constant 5 : index
  %threads = index.constant 256 : index
  %padded = index.add %capacity, %rounding : index
  %rows = index.div %padded, %tile : index
  kernel.launch.config workgroups(%groups, %rows, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%epoch_arg: buffer, %input_arg: buffer, %weight_arg: buffer, %output_arg: buffer) {
  %epoch, %input, %weight, %output = buffer.assume.noalias %epoch_arg, %input_arg, %weight_arg, %output_arg : buffer, buffer, buffer, buffer
  %capacity = config.get @flash_next.token_count : index
  %end = func.call @flash_next_token_count(%epoch, %capacity) : (buffer, index) -> (index)
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %tile = index.constant 64 : index
  %pitch = index.constant 72 : index
  %stages = index.constant 160 : index
  %threads = index.constant 256 : index
  %outputs = index.constant 320 : index
  %origin = index.constant 0 : offset
  %stage_bytes = index.constant 9216 : offset
  %row_bytes = index.constant 10880 : offset
  %pair_bytes = index.constant 68 : offset
  %block_bytes = index.constant 34 : offset
  %scale_bytes = index.constant 2 : offset
  %segment_bytes = index.constant 16 : offset
  %group = kernel.workgroup.id<x> : index
  %batch = kernel.workgroup.id<y> : index
  %first = index.mul %batch, %tile : index
  %active = index.cmp ult, %first, %end : index
  scf.if %active {
    %channel_base = index.mul %group, %tile : index
    %workitem = kernel.workitem.id<x> : index
    %wave = kernel.subgroup.id : index
    %wave_columns = index.rem %wave, %c2 : index
    %wave_rows = index.div %wave, %c2 : index
    %wave_channel = index.mul %wave_columns, %c32 : index
    %wave_token = index.mul %wave_rows, %c16 : index
    %input_view = buffer.view %input[%origin] : buffer -> view<[%capacity]x10240xbf16>
    %input_stage = buffer.alloca<workgroup> align(16) %stage_bytes : buffer
    %high_stage = buffer.alloca<workgroup> align(16) %stage_bytes : buffer
    %low_stage = buffer.alloca<workgroup> align(16) %stage_bytes : buffer
    %input_view_stage = buffer.view %input_stage[%origin] : buffer -> view<64x72xbf16>
    %high_view = buffer.view %high_stage[%origin] : buffer -> view<64x72xbf16>
    %low_view = buffer.view %low_stage[%origin] : buffer -> view<64x72xbf16>
    %layout = encoding.layout.strided [1, %pitch] : encoding<layout>
    %high_fragment = buffer.view %high_stage[%origin] : buffer -> view<64x64xbf16, %layout>
    %low_fragment = buffer.view %low_stage[%origin] : buffer -> view<64x64xbf16, %layout>
    %inactive = vector.constant 0.0 : vector<8xbf16>
    %initial = vector.constant 0.0 : vector<2x8xf32>
    // Four lanes share each original Q8 pair. Each reconstructs sixteen
    // coefficients; the two lanes in a block read the same F16 scale.
    // Consecutive groups of eight lanes publish distinct LDS bank groups.
    %row_group = index.div %workitem, %c32 : index
    %within_group = index.rem %workitem, %c8 : index
    %local_channel = index.madd %row_group, %c8, %within_group : index
    %segment_group = index.div %workitem, %c8 : index
    %segment = index.rem %segment_group, %c4 : index
    %block = index.div %segment, %c2 : index
    %within_block = index.rem %segment, %c2 : index
    %local_weight_k = index.mul %segment, %c16 : index
    %channel = index.add %channel_base, %local_channel : index
    %row_origin = index.scale %channel, %row_bytes : index, offset -> offset
    %block_delta = index.scale %block, %block_bytes : index, offset -> offset
    %segment_delta = index.scale %within_block, %segment_bytes : index, offset -> offset
    %code_delta = index.add %segment_delta, %scale_bytes : offset
    %high_result, %low_result = scf.for %stage = [%c0 to %stages step %c1](%high_accumulators = %initial : vector<2x8xf32>, %low_accumulators = %initial : vector<2x8xf32>) -> (vector<2x8xf32>, vector<2x8xf32>) pipeline(%c2) {
      %input_k = index.mul %stage, %tile : index
      %pair_delta = index.scale %stage, %pair_bytes : index, offset -> offset
      %pair_origin = index.add %row_origin, %pair_delta : offset
      %block_origin = index.add %pair_origin, %block_delta : offset
      %code_origin = index.add %block_origin, %code_delta : offset
      %scale_view = buffer.view %weight[%block_origin] : buffer -> view<1xf16>
      %code_view = buffer.view %weight[%code_origin] : buffer -> view<16xi8>
      %half_scale = view.load %scale_view[%c0] : view<1xf16> -> f16
      %codes = vector.load %code_view[%c0] : view<16xi8> -> vector<16xi8>
      %scale_value = scalar.extf %half_scale : f16 to f32
      %scale = vector.splat %scale_value : vector<16xf32>
      %integer_values = vector.sitofp %codes : vector<16xi8> to vector<16xf32>
      %values = vector.mulf %integer_values, %scale : vector<16xf32>
      %high = vector.fptrunc %values : vector<16xf32> to vector<16xbf16>
      %high_wide = vector.extf %high : vector<16xbf16> to vector<16xf32>
      %residual = vector.subf %values, %high_wide : vector<16xf32>
      %low = vector.fptrunc %residual : vector<16xf32> to vector<16xbf16>
      vector.store %high, %high_view[%local_channel, %local_weight_k] : vector<16xbf16>, view<64x72xbf16>
      vector.store %low, %low_view[%local_channel, %local_weight_k] : vector<16xbf16>, view<64x72xbf16>
      scf.for %round = [%c0 to %c2 step %c1] unroll schedule(linear) {
        %packet = index.madd %round, %threads, %workitem : index
        %local_row = index.div %packet, %c8 : index
        %within_row = index.rem %packet, %c8 : index
        %local_k = index.mul %within_row, %c8 : index
        %token = index.add %first, %local_row : index
        %k = index.add %input_k, %local_k : index
        %live = index.cmp ult, %token, %end : index
        %safe_token = scf.select %live, %token, %c0 : index
        %loaded = vector.load %input_view[%safe_token, %k] : view<[%capacity]x10240xbf16> -> vector<8xbf16>
        %mask = vector.splat %live : vector<8xi1>
        %values = vector.select %mask, %loaded, %inactive : vector<8xbf16>
        vector.store %values, %input_view_stage[%local_row, %local_k] : vector<8xbf16>, view<64x72xbf16>
      }
      kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
      %next_high, %next_low = scf.for %part = [%c0 to %c4 step %c1](%high_partial = %high_accumulators : vector<2x8xf32>, %low_partial = %low_accumulators : vector<2x8xf32>) -> (vector<2x8xf32>, vector<2x8xf32>) unroll schedule(linear) {
        %fragment_k = index.mul %part, %c16 : index
        %lhs = vector.fragment.load<lhs> %input_view_stage[%wave_token, %fragment_k] shape [%c16, %c16] : view<64x72xbf16> -> vector<16xbf16>
        %high_tile, %low_tile = scf.for %ordinal = [%c0 to %c2 step %c1](%high_current = %high_partial : vector<2x8xf32>, %low_current = %low_partial : vector<2x8xf32>) -> (vector<2x8xf32>, vector<2x8xf32>) unroll schedule(linear) {
          %column = index.madd %ordinal, %c16, %wave_channel : index
          %rhs_high = vector.fragment.load<rhs> %high_fragment[%fragment_k, %column] shape [%c16, %c16] : view<64x64xbf16, %layout> -> vector<16xbf16>
          %rhs_low = vector.fragment.load<rhs> %low_fragment[%fragment_k, %column] shape [%c16, %c16] : view<64x64xbf16, %layout> -> vector<16xbf16>
          %high_values = vector.extract %high_current[%ordinal] : vector<2x8xf32> -> vector<8xf32>
          %low_values = vector.extract %low_current[%ordinal] : vector<2x8xf32> -> vector<8xf32>
          %high_accumulator = vector.fragment<result> %high_values shape [%c16, %c16] : vector<8xf32>
          %low_accumulator = vector.fragment<result> %low_values shape [%c16, %c16] : vector<8xf32>
          %high_contracted = vector.mma %lhs, %rhs_high, %high_accumulator : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
          %low_contracted = vector.mma %lhs, %rhs_low, %low_accumulator : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
          %high_updated = vector.insert %high_contracted into %high_current[%ordinal] : vector<8xf32>, vector<2x8xf32>
          %low_updated = vector.insert %low_contracted into %low_current[%ordinal] : vector<8xf32>, vector<2x8xf32>
          scf.yield %high_updated, %low_updated : vector<2x8xf32>, vector<2x8xf32>
        }
        scf.yield %high_tile, %low_tile : vector<2x8xf32>, vector<2x8xf32>
      }
      kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
      scf.yield %next_high, %next_low : vector<2x8xf32>, vector<2x8xf32>
    }
    %remaining = index.sub %end, %first : index
    %output_row_bytes = index.constant 640 : offset
    %output_origin = index.scale %first, %output_row_bytes : index, offset -> offset
    %output_view = buffer.view %output[%output_origin] : buffer -> view<[%remaining]x[%outputs]xbf16>
    %quarter = vector.constant 0.25 : vector<8xf32>
    %c1_f32 = vector.constant 1.0 : vector<8xf32>
    scf.for %ordinal = [%c0 to %c2 step %c1] unroll schedule(linear) {
      %high = vector.extract %high_result[%ordinal] : vector<2x8xf32> -> vector<8xf32>
      %low = vector.extract %low_result[%ordinal] : vector<2x8xf32> -> vector<8xf32>
      %dot = vector.addf %high, %low : vector<8xf32>
      %scaled = vector.mulf %dot, %quarter : vector<8xf32>
      %negative = vector.negf %scaled : vector<8xf32>
      %exponential = vector.expf<afn> %negative : vector<8xf32>
      %denominator = vector.addf %c1_f32, %exponential : vector<8xf32>
      %result = vector.divf %scaled, %denominator : vector<8xf32>
      %local_column = index.madd %ordinal, %c16, %wave_channel : index
      %column = index.add %channel_base, %local_column : index
      template.apply<@flash_next.matrix_store_fragment>(%remaining, %outputs, %wave_token, %column, %result, %output_view) : (index, index, index, index, vector<8xf32>, view<[%remaining]x[%outputs]xbf16>)
    }
  }
  kernel.return
}

kernel.def target(@flash_next_hc_matrix_wave32) @hc_matrix_up() {
  %capacity = config.get @flash_next.token_count : index
  %c1 = index.constant 1 : index
  %rounding = index.constant 127 : index
  %tile_rows = index.constant 128 : index
  %groups = index.constant 80 : index
  %threads = index.constant 256 : index
  %padded = index.add %capacity, %rounding : index
  %rows = index.div %padded, %tile_rows : index
  kernel.launch.config workgroups(%groups, %rows, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%span: buffer, %normalized: buffer, %input: buffer, %weight: buffer, %output: buffer) {
  func.call @hc_matrix_up_body(%span, %normalized, %input, %weight, %output) : (buffer, buffer, buffer, buffer, buffer)
  kernel.return
}
