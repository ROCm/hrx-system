// Each row stores hi=f32(theta^(-pair/32)/(2*pi)) and
// lo=f32(theta^(-pair/32)/(2*pi)-hi), theta=10000000. The split preserves
// fractional turns when multiplied by an integer position up to 262143.
global.rodata.def @qsa_rotary_turns = align(16) bytes("")

func.def public inline @qsa_rotary_coefficients(%position: index, %pair_arg: index) -> (bf16, bf16) {
  %pair = index.assume %pair_arg [range(%pair_arg, 0, 31)] : index
  %table = global.load @qsa_rotary_turns : buffer
  %origin = index.constant 0 : offset
  %coefficients = buffer.view %table[%origin] : buffer -> view<32x2xf32>
  %packed = vector.load %coefficients[%pair, 0] : view<32x2xf32> -> vector<2xf32>
  %high = vector.extract %packed[0] : vector<2xf32> -> f32
  %low = vector.extract %packed[1] : vector<2xf32> -> f32
  %position_i32 = index.cast %position : index to i32
  %position_f32 = scalar.uitofp %position_i32 : i32 to f32
  %product = scalar.mulf %position_f32, %high : f32
  %negative_product = scalar.negf %product : f32
  %product_error = scalar.fmaf %position_f32, %high, %negative_product : f32
  %correction = scalar.fmaf %position_f32, %low, %product_error : f32
  %whole = scalar.floorf %product : f32
  %fraction = scalar.subf %product, %whole : f32
  %turns = scalar.addf %fraction, %correction : f32
  %sine = scalar.sinturnsf<afn> %turns : f32
  %cosine = scalar.costurnsf<afn> %turns : f32
  %sine_packed = scalar.fptrunc %sine : f32 to bf16
  %cosine_packed = scalar.fptrunc %cosine : f32 to bf16
  func.return %sine_packed, %cosine_packed : bf16, bf16
}
