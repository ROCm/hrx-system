        view.store %scale1, %dx[%c1, %wave, %lane] : f32, view<4x8x16xf32>
        view.store %scale2, %dx[%c2, %wave, %lane] : f32, view<4x8x16xf32>
        view.store %scale3, %dx[%c3, %wave, %lane] : f32, view<4x8x16xf32>
      }
      kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
      %next = scf.for %part = [%c0 to %c4 step %c1](%current = %accumulators : vector<2x2x8xf32>) -> (vector<2x2x8xf32>) {
        %updated = scf.for %token_fragment = [%c0 to %c2 step %c1](%tile = %current : vector<2x2x8xf32>) -> (vector<2x2x8xf32>) unroll schedule(linear) {
          %token_tile = index.madd %wave_token, %c2, %token_fragment : index
          %high_lane = index.add %sub_lane, %c16 : index
          %b0_data = vector.load %b[%part, %token_tile, %sub_lane, %c0] : view<4x8x32x4xi32> -> vector<4xi32>
          %b1_data = vector.load %b[%part, %token_tile, %high_lane, %c0] : view<4x8x32x4xi32> -> vector<4xi32>
          %b0 = vector.fragment<rhs> %b0_data shape [%c16, %c16] using {schema = %schema : encoding<schema>} : vector<4xi32>
          %b1 = vector.fragment<rhs> %b1_data shape [%c16, %c16] using {schema = %schema : encoding<schema>} : vector<4xi32>
          %activation_scale = view.load %dx[%part, %token_tile, %sub_lane] : view<4x8x16xf32> -> f32
          %activation_scales = vector.splat %activation_scale : vector<8xf32>
          %next_tile = scf.for %feature_fragment = [%c0 to %c2 step %c1](%values = %tile : vector<2x2x8xf32>) -> (vector<2x2x8xf32>) unroll schedule(linear) {
            %feature_tile = index.madd %wave_feature, %c2, %feature_fragment : index
            %a0_data = vector.load %a[%part, %feature_tile, %sub_lane, %c0] : view<4x4x32x4xi32> -> vector<4xi32>
            %a1_data = vector.load %a[%part, %feature_tile, %high_lane, %c0] : view<4x4x32x4xi32> -> vector<4xi32>
            %a0 = vector.fragment<lhs> %a0_data shape [%c16, %c16] using {schema = %schema : encoding<schema>} : vector<4xi32>
            %a1 = vector.fragment<lhs> %a1_data shape [%c16, %c16] using {schema = %schema : encoding<schema>} : vector<4xi32>
            %dot0 = vector.mma %a0, %b0, %integer_init : vector<4xi32>, vector<4xi32>, vector<8xi32>
            %dot1 = vector.mma %a1, %b1, %dot0 : vector<4xi32>, vector<4xi32>, vector<8xi32>
            %dot = vector.sitofp %dot1 : vector<8xi32> to vector<8xf32>
            %scale_first = index.mul %half_lane, %c8 : index
            %weight_scales = vector.load %dw[%part, %feature_tile, %scale_first] : view<4x4x16xf32> -> vector<8xf32>
            %scaled = vector.mulf %dot, %activation_scales : vector<8xf32>
            %old = vector.extract %values[%feature_fragment, %token_fragment] : vector<2x2x8xf32> -> vector<8xf32>
            %contracted = vector.fmaf %scaled, %weight_scales, %old : vector<8xf32>
            %next_values = vector.insert %contracted into %values[%feature_fragment, %token_fragment] : vector<8xf32>, vector<2x2x8xf32>
            scf.yield %next_values : vector<2x2x8xf32>
          }
          scf.yield %next_tile : vector<2x2x8xf32>
        }
        scf.yield %updated : vector<2x2x8xf32>
      }
      kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
      scf.yield %next : vector<2x2x8xf32>
    }
    // Each wave transposes a 16-token by 32-feature result through its own
    // padded LDS region, then stores sixteen contiguous BF16 features/lane.
    %transpose = buffer.view %storage[%origin] : buffer -> view<8x16x36xf32>
    %output_view = buffer.view %output[%origin] : buffer -> view<[%capacity]x320xbf16>
    %output_token_lane = index.div %lane, %c2 : index
    %output_feature_half = index.rem %lane, %c2 : index
    %output_feature_lane = index.mul %output_feature_half, %c16 : index
    %wave_feature_base = index.madd %wave_feature, %c32, %feature_base : index
    %output_feature = index.add %wave_feature_base, %output_feature_lane : index
    %quarter = vector.constant 0.25 : vector<16xf32>
    %one = vector.constant 1.0 : vector<16xf32>
    scf.for %token_fragment = [%c0 to %c2 step %c1] unroll schedule(linear) {
      scf.for %feature_fragment = [%c0 to %c2 step %c1] unroll schedule(linear) {
        %values = vector.extract %result[%feature_fragment, %token_fragment] : vector<2x2x8xf32> -> vector<8xf32>
        %feature_offset = index.mul %feature_fragment, %c16 : index
        scf.for %element = [%c0 to %c8 step %c1] unroll schedule(linear) {
          %within = index.madd %element, %c2, %half_lane : index
          %feature = index.add %feature_offset, %within : index
          %value = vector.extract %values[%element] : vector<8xf32> -> f32
          view.store %value, %transpose[%wave, %sub_lane, %feature] : f32, view<8x16x36xf32>
        }
      }
      kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
      %token_tile = index.madd %wave_token, %c2, %token_fragment : index
      %local_token = index.madd %token_tile, %c16, %output_token_lane : index
      %token = index.add %first, %local_token : index
      %live = index.cmp ult, %token, %end : index
      scf.if %live {
        %dot = vector.load %transpose[%wave, %output_token_lane, %output_feature_lane] : view<8x16x36xf32> -> vector<16xf32>
        %scaled = vector.mulf %dot, %quarter : vector<16xf32>
        %negative = vector.negf %scaled : vector<16xf32>
        %exponential = vector.expf<afn> %negative : vector<16xf32>
        %denominator = vector.addf %one, %exponential : vector<16xf32>
        %activated = vector.divf<arcp> %scaled, %denominator : vector<16xf32>
        %packed = vector.fptrunc %activated : vector<16xf32> to vector<16xbf16>
        vector.store %packed, %output_view[%token, %output_feature] : vector<16xbf16>, view<[%capacity]x320xbf16>
      }
      kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    }
  }
  kernel.return
}

kernel.def target(@flash_next_hc_wave32) @hc_normalize_inject_int8() {
  %tokens = config.get @flash_next.token_count : index
  %c1 = index.constant 1 : index
  %threads = index.constant 128 : index
  kernel.launch.config workgroups(%tokens, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%span_arg: buffer, %residual_arg: buffer, %gamma_arg: buffer, %normalized_arg: buffer, %next_weight_arg: buffer, %next_injection_arg: buffer, %quantized_arg: buffer) {
  %span, %residual, %gamma, %normalized, %next_weight, %next_injection, %quantized = buffer.assume.noalias %span_arg, %residual_arg, %gamma_arg, %normalized_arg, %next_weight_arg, %next_injection_arg, %quantized_arg : buffer, buffer, buffer, buffer, buffer, buffer, buffer
  %tokens = config.get @flash_next.token_count : index
  %token = kernel.workgroup.id<x> : index
  %end = func.call @flash_next_token_count(%span, %tokens) : (buffer, index) -> (index)
  %active = index.cmp ult, %token, %end : index
  scf.if %active {
    %stream = kernel.subgroup.id : index
    %lane = kernel.subgroup.lane.id : index
    %origin = index.constant 0 : offset
    %c8 = index.constant 8 : index
    %stride = index.constant 256 : index
    %width = index.constant 2560 : index
    %first = index.mul %lane, %c8 : index
    %input_view = buffer.view %residual[%origin] : buffer -> view<[%tokens]x4x2560xbf16>
    %gamma_view = buffer.view %gamma[%origin] : buffer -> view<4x2560xf32>
    %output_view = buffer.view %normalized[%origin] : buffer -> view<[%tokens]x4x2560xbf16>
    %c0 = scalar.constant 0.0 : f32
    %c0_vector = vector.constant 0.0 : vector<8xf32>
    %partial = scf.for %channel = [%first to %width step %stride](%accumulator = %c0_vector : vector<8xf32>) -> (vector<8xf32>) {
      %stored = vector.load %input_view[%token, %stream, %channel] : view<[%tokens]x4x2560xbf16> -> vector<8xbf16>
      %values = vector.extf %stored : vector<8xbf16> to vector<8xf32>
      %next = vector.fmaf %values, %values, %accumulator : vector<8xf32>
      scf.yield %next : vector<8xf32>
    }
    %lane_sum = vector.reduce<addf> %partial, %c0 : vector<8xf32>, f32
    %sum = kernel.subgroup.reduce<addf> %lane_sum : f32
    %reciprocal_width = scalar.constant 0.00039062500000000002 : f32
    %epsilon = scalar.constant 9.9999999999999995e-07 : f32
    %mean = scalar.mulf %sum, %reciprocal_width : f32
    %variance = scalar.addf %mean, %epsilon : f32
    %inverse = scalar.rsqrtf<afn> %variance : f32
    %inverse_vector = vector.splat %inverse : vector<8xf32>
    %initial_dots = vector.constant 0.0 : vector<4x8xf32>
    %dots = scf.for %channel = [%first to %width step %stride](%current_dots = %initial_dots : vector<4x8xf32>) -> (vector<4x8xf32>) {
      %stored = vector.load %input_view[%token, %stream, %channel] : view<[%tokens]x4x2560xbf16> -> vector<8xbf16>
      %values = vector.extf %stored : vector<8xbf16> to vector<8xf32>
      %scales = vector.load %gamma_view[%stream, %channel] : view<4x2560xf32> -> vector<8xf32>
      %unit = vector.mulf %values, %inverse_vector : vector<8xf32>
      %scaled = vector.mulf %unit, %scales : vector<8xf32>
      %packed = vector.fptrunc %scaled : vector<8xf32> to vector<8xbf16>
      vector.store %packed, %output_view[%token, %stream, %channel] : vector<8xbf16>, view<[%tokens]x4x2560xbf16>
      func.call @hc_quantize_chunk(%token, %stream, %channel, %packed, %quantized) : (index, index, index, vector<8xbf16>, buffer)
      %next_dots = func.call @hc_injection_chunk(%stream, %channel, %packed, %next_weight, %current_dots) : (index, index, vector<8xbf16>, buffer, vector<4x8xf32>) -> (vector<4x8xf32>)
      scf.yield %next_dots : vector<4x8xf32>
    }
    func.call @hc_injection_publish(%token, %stream, %lane, %dots, %next_injection) : (index, index, index, vector<4x8xf32>, buffer)
  }
  kernel.return
}

kernel.def target(@flash_next_hc_wave32) @hc_combine_normalize_inject_int8() {
  %tokens = config.get @flash_next.token_count : index
  %c1 = index.constant 1 : index
  %threads = index.constant 128 : index
  kernel.launch.config workgroups(%tokens, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%span_arg: buffer, %residual_arg: buffer, %projected_arg: buffer, %injection_arg: buffer, %gamma_arg: buffer, %output_arg: buffer, %normalized_arg: buffer, %next_weight_arg: buffer, %next_injection_arg: buffer, %quantized_arg: buffer) {
  %span, %residual, %projected, %injection, %gamma, %output, %normalized, %next_weight, %next_injection, %quantized = buffer.assume.noalias %span_arg, %residual_arg, %projected_arg, %injection_arg, %gamma_arg, %output_arg, %normalized_arg, %next_weight_arg, %next_injection_arg, %quantized_arg : buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer
  %tokens = config.get @flash_next.token_count : index
  %token = kernel.workgroup.id<x> : index
  %end = func.call @flash_next_token_count(%span, %tokens) : (buffer, index) -> (index)
  %active = index.cmp ult, %token, %end : index
  scf.if %active {
    %stream = kernel.subgroup.id : index
    %lane = kernel.subgroup.lane.id : index
    %origin = index.constant 0 : offset
    %c8 = index.constant 8 : index
    %stride = index.constant 256 : index
    %width = index.constant 2560 : index
    %first = index.mul %lane, %c8 : index
    %input_view = buffer.view %residual[%origin] : buffer -> view<[%tokens]x4x2560xbf16>
    %gamma_view = buffer.view %gamma[%origin] : buffer -> view<4x2560xf32>
    %output_view = buffer.view %normalized[%origin] : buffer -> view<[%tokens]x4x2560xbf16>
    %c0 = scalar.constant 0.0 : f32
    %c0_vector = vector.constant 0.0 : vector<8xf32>
    %projected_view = buffer.view %projected[%origin] : buffer -> view<[%tokens]x2560xbf16>
    %injection_view = buffer.view %injection[%origin] : buffer -> view<[%tokens]x4xf32>
    %residual_output = buffer.view %output[%origin] : buffer -> view<[%tokens]x4x2560xbf16>
    %gate = view.load %injection_view[%token, %stream] : view<[%tokens]x4xf32> -> f32
    %gates = vector.splat %gate : vector<8xf32>
    %c0_index = index.constant 0 : index
    %c1_index = index.constant 1 : index
    %chunks = index.constant 10 : index
    %initial = vector.constant 0.0 : vector<10x8xbf16>
    // Preserve the published BF16 residual before computing its norm.
    %partial, %retained = scf.for %chunk = [%c0_index to %chunks step %c1_index](%accumulator = %c0_vector : vector<8xf32>, %prior = %initial : vector<10x8xbf16>) -> (vector<8xf32>, vector<10x8xbf16>) unroll schedule(linear) {
      %channel = index.madd %chunk, %stride, %first : index
      %stored = vector.load %input_view[%token, %stream, %channel] : view<[%tokens]x4x2560xbf16> -> vector<8xbf16>
      %branch = vector.load %projected_view[%token, %channel] : view<[%tokens]x2560xbf16> -> vector<8xbf16>
      %old = vector.extf %stored : vector<8xbf16> to vector<8xf32>
      %branch_values = vector.extf %branch : vector<8xbf16> to vector<8xf32>
      %combined = vector.fmaf %branch_values, %gates, %old : vector<8xf32>
      %packed_residual = vector.fptrunc %combined : vector<8xf32> to vector<8xbf16>
      vector.store %packed_residual, %residual_output[%token, %stream, %channel] : vector<8xbf16>, view<[%tokens]x4x2560xbf16>
      %values = vector.extf %packed_residual : vector<8xbf16> to vector<8xf32>
      %next = vector.fmaf %values, %values, %accumulator : vector<8xf32>
      %retained_next = vector.insert %packed_residual into %prior[%chunk] : vector<8xbf16>, vector<10x8xbf16>
      scf.yield %next, %retained_next : vector<8xf32>, vector<10x8xbf16>
    }
    %lane_sum = vector.reduce<addf> %partial, %c0 : vector<8xf32>, f32
    %sum = kernel.subgroup.reduce<addf> %lane_sum : f32
    %reciprocal_width = scalar.constant 0.00039062500000000002 : f32
    %epsilon = scalar.constant 9.9999999999999995e-07 : f32
    %mean = scalar.mulf %sum, %reciprocal_width : f32
    %variance = scalar.addf %mean, %epsilon : f32
    %inverse = scalar.rsqrtf<afn> %variance : f32
    %inverse_vector = vector.splat %inverse : vector<8xf32>
    %initial_dots = vector.constant 0.0 : vector<4x8xf32>
    %dots = scf.for %chunk = [%c0_index to %chunks step %c1_index](%current_dots = %initial_dots : vector<4x8xf32>) -> (vector<4x8xf32>) unroll schedule(linear) {
      %channel = index.madd %chunk, %stride, %first : index
      %stored = vector.extract %retained[%chunk] : vector<10x8xbf16> -> vector<8xbf16>
      %values = vector.extf %stored : vector<8xbf16> to vector<8xf32>
      %scales = vector.load %gamma_view[%stream, %channel] : view<4x2560xf32> -> vector<8xf32>
      %unit = vector.mulf %values, %inverse_vector : vector<8xf32>
      %scaled = vector.mulf %unit, %scales : vector<8xf32>
      %packed = vector.fptrunc %scaled : vector<8xf32> to vector<8xbf16>
      vector.store %packed, %output_view[%token, %stream, %channel] : vector<8xbf16>, view<[%tokens]x4x2560xbf16>
      func.call @hc_quantize_chunk(%token, %stream, %channel, %packed, %quantized) : (index, index, index, vector<8xbf16>, buffer)
      %next_dots = func.call @hc_injection_chunk(%stream, %channel, %packed, %next_weight, %current_dots) : (index, index, vector<8xbf16>, buffer, vector<4x8xf32>) -> (vector<4x8xf32>)
      scf.yield %next_dots : vector<4x8xf32>
    }
    func.call @hc_injection_publish(%token, %stream, %lane, %dots, %next_injection) : (index, index, index, vector<4x8xf32>, buffer)
  }
  kernel.return
}

command.program.def public @flash_next_hc_mix_quantized(%down_weight: view<3481600xi8>, %up_weight: view<3481600xi8>) launch(%span: buffer, %normalized: buffer, %quantized: buffer, %mixed: buffer) {
  %tokens = config.get @flash_next.token_count : index
  %rank_row_bytes = index.constant 640 : offset
  %rank_bytes = index.scale %tokens, %rank_row_bytes : index, offset -> offset
  %lowrank = buffer.alloca<global> align(256) %rank_bytes : buffer
  kernel.launch @hc_matrix_down_int8(%span, %quantized, %down_weight, %lowrank) : (buffer, buffer, view<3481600xi8>, buffer)
  kernel.launch @hc_matrix_up(%span, %normalized, %lowrank, %up_weight, %mixed) : (buffer, buffer, buffer, view<3481600xi8>, buffer)
  command.return
}
