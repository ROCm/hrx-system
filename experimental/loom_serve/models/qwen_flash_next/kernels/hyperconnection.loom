  %span, %residual, %projected, %injection, %gamma, %output, %normalized, %next_weight, %next_injection = buffer.assume.noalias %span_arg, %residual_arg, %projected_arg, %injection_arg, %gamma_arg, %output_arg, %normalized_arg, %next_weight_arg, %next_injection_arg : buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer
  %tokens = config.get @flash_next.token_count : index
