kernel.decl @hc_matrix_down_half() launch(%epoch: buffer, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @hc_matrix_down() launch(%span: buffer, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @hc_matrix_up() launch(%span: buffer, %normalized: buffer, %input: buffer, %weight: buffer, %output: buffer)

config.decl @flash_next.token_count : %value: index where [range(%value, 1, 32768)]

amdgpu.target<gfx11-generic> @flash_next_hc_wave32 {subgroup_size = 32}

func.decl @flash_next_token_count(%epoch: buffer, %capacity: index) -> (index)

func.decl @flash_next_q8_batch_partial(%width: index, %batch_size: index, %first: index, %end: index, %row: index, %lane: index, %stride: index, %input: buffer, %weight: buffer) -> (vector<4xf32>)

// One wave normalizes each residual stream. GGUF already folded 1+gamma;
// multiplication retains that F32 value until the BF16 output publication.
kernel.def target(@flash_next_hc_wave32) @hc_normalize() {
  %tokens = config.get @flash_next.token_count : index
  %c1 = index.constant 1 : index
  %threads = index.constant 128 : index
  kernel.launch.config workgroups(%tokens, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%span_arg: buffer, %residual_arg: buffer, %gamma_arg: buffer, %normalized_arg: buffer) {
  %span, %residual, %gamma, %normalized = buffer.assume.noalias %span_arg, %residual_arg, %gamma_arg, %normalized_arg : buffer, buffer, buffer, buffer
  %tokens = config.get @flash_next.token_count : index
  %token = kernel.workgroup.id<x> : index
  %end = func.call @flash_next_token_count(%span, %tokens) : (buffer, index) -> (index)
  %active = index.cmp ult, %token, %end : index
  scf.if %active {
    %stream = kernel.subgroup.id : index
    %lane = kernel.subgroup.lane.id : index
    %origin = index.constant 0 : offset
    %c8 = index.constant 8 : index
    %stride = index.constant 256 : index
    %width = index.constant 2560 : index
    %first = index.mul %lane, %c8 : index
    %input_view = buffer.view %residual[%origin] : buffer -> view<[%tokens]x4x2560xbf16>
    %gamma_view = buffer.view %gamma[%origin] : buffer -> view<4x2560xf32>
    %output_view = buffer.view %normalized[%origin] : buffer -> view<[%tokens]x4x2560xbf16>
    %c0 = scalar.constant 0.0 : f32
    %c0_vector = vector.constant 0.0 : vector<8xf32>
    %partial = scf.for %channel = [%first to %width step %stride](%accumulator = %c0_vector : vector<8xf32>) -> (vector<8xf32>) {
      %stored = vector.load %input_view[%token, %stream, %channel] : view<[%tokens]x4x2560xbf16> -> vector<8xbf16>
      %values = vector.extf %stored : vector<8xbf16> to vector<8xf32>
      %next = vector.fmaf %values, %values, %accumulator : vector<8xf32>
      scf.yield %next : vector<8xf32>
    }
    %lane_sum = vector.reduce<addf> %partial, %c0 : vector<8xf32>, f32
    %sum = kernel.subgroup.reduce<addf> %lane_sum : f32
    %reciprocal_width = scalar.constant 0.00039062500000000002 : f32
    %epsilon = scalar.constant 9.9999999999999995e-07 : f32
    %mean = scalar.mulf %sum, %reciprocal_width : f32
    %variance = scalar.addf %mean, %epsilon : f32
    %inverse = scalar.rsqrtf<afn> %variance : f32
    %inverse_vector = vector.splat %inverse : vector<8xf32>
    scf.for %channel = [%first to %width step %stride] {
      %stored = vector.load %input_view[%token, %stream, %channel] : view<[%tokens]x4x2560xbf16> -> vector<8xbf16>
      %values = vector.extf %stored : vector<8xbf16> to vector<8xf32>
      %scales = vector.load %gamma_view[%stream, %channel] : view<4x2560xf32> -> vector<8xf32>
      %unit = vector.mulf %values, %inverse_vector : vector<8xf32>
      %scaled = vector.mulf %unit, %scales : vector<8xf32>
      %packed = vector.fptrunc %scaled : vector<8xf32> to vector<8xbf16>
      vector.store %packed, %output_view[%token, %stream, %channel] : vector<8xbf16>, view<[%tokens]x4x2560xbf16>
    }
  }
  kernel.return
}

// Down/inject keeps one token per workgroup at small capacities so each F32
// injection row can use all four waves. Larger epochs share each decoded Q8
// block across four tokens. Capacity selects the schedule during specialization.
func.def pure inline @hc_down_token_batch_size() -> (index) {
  %tokens = config.get @flash_next.token_count : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %large = index.cmp ugt, %tokens, %c4 : index
  %size = scf.if %large -> (index) {
    scf.yield %c4 : index
  } else {
    scf.yield %c1 : index
  }
  func.return %size : index
}

// Each wave owns one low-rank row or one of the four final injection rows.
// Injection weights are F32 in the target and Q8_0 in the predictor. Tokens
// share Q8 loads while retaining independent F32 accumulators and the original
// quarter-scaled SiLU/sigmoid publications.
func.def inline @hc_down_inject_body(%first_row: index, %q8_injection: i1, %span_arg: buffer, %normalized_arg: buffer, %down_weight_arg: buffer, %injection_weight_arg: buffer, %lowrank_arg: buffer, %injection_arg: buffer) {
  %span, %normalized, %down_weight, %injection_weight, %lowrank, %injection = buffer.assume.noalias %span_arg, %normalized_arg, %down_weight_arg, %injection_weight_arg, %lowrank_arg, %injection_arg : buffer, buffer, buffer, buffer, buffer, buffer
  %tokens = config.get @flash_next.token_count : index
  %token_group = kernel.workgroup.id<y> : index
  %batch_size = func.call pure @hc_down_token_batch_size() : () -> (index)
  %first = index.mul %token_group, %batch_size : index
  %end = func.call @flash_next_token_count(%span, %tokens) : (buffer, index) -> (index)
  %active = index.cmp ult, %first, %end : index
  scf.if %active {
    %group = kernel.workgroup.id<x> : index
    %wave = kernel.subgroup.id : index
    %lane = kernel.subgroup.lane.id : index
    %c0_index = index.constant 0 : index
    %c4 = index.constant 4 : index
    %c8 = index.constant 8 : index
    %wave_size = index.constant 32 : index
    %stride = index.constant 256 : index
    %rank = index.constant 320 : index
    %width = index.constant 10240 : index
    %origin = index.constant 0 : offset
    %local_row = index.madd %group, %c4, %wave : index
    %row = index.add %first_row, %local_row : index
    %is_projection = index.cmp ult, %row, %rank : index
    %c0 = scalar.constant 0.0 : f32
    %c1 = scalar.constant 1.0 : f32
    %c2 = scalar.constant 2.0 : f32
    %quarter = scalar.constant 0.25 : f32
    %partial = scf.if %is_projection -> (vector<4xf32>) {
      %value = func.call @flash_next_q8_batch_partial(%width, %batch_size, %first, %end, %row, %lane, %wave_size, %normalized, %down_weight) : (index, index, index, index, index, index, index, buffer, buffer) -> (vector<4xf32>)
      scf.yield %value : vector<4xf32>
    } else {
      %injection_row = index.sub %row, %rank : index
      %value = scf.if %q8_injection -> (vector<4xf32>) {
        %part = func.call @flash_next_q8_batch_partial(%width, %batch_size, %first, %end, %injection_row, %lane, %wave_size, %normalized, %injection_weight) : (index, index, index, index, index, index, index, buffer, buffer) -> (vector<4xf32>)
        scf.yield %part : vector<4xf32>
      } else {
        %step = index.constant 1 : index
        %empty = vector.constant 0.0 : vector<4xf32>
        %values = scf.for %ordinal = [%c0_index to %batch_size step %step](%current = %empty : vector<4xf32>) -> (vector<4xf32>) unroll schedule(linear) {
          %token = index.add %first, %ordinal : index
          %live = index.cmp ult, %token, %end : index
          %next_value = scf.if %live -> (vector<4xf32>) {
            %input_view = buffer.view %normalized[%origin] : buffer -> view<[%tokens]x10240xbf16>
            %weight_view = buffer.view %injection_weight[%origin] : buffer -> view<4x10240xf32>
            %first_channel = index.mul %lane, %c8 : index
            %initial = vector.constant 0.0 : vector<8xf32>
            %parts = scf.for %channel = [%first_channel to %width step %stride](%accumulator = %initial : vector<8xf32>) -> (vector<8xf32>) {
              %stored = vector.load %input_view[%token, %channel] : view<[%tokens]x10240xbf16> -> vector<8xbf16>
              %values = vector.extf %stored : vector<8xbf16> to vector<8xf32>
              %weights = vector.load %weight_view[%injection_row, %channel] : view<4x10240xf32> -> vector<8xf32>
              %next = vector.fmaf %values, %weights, %accumulator : vector<8xf32>
              scf.yield %next : vector<8xf32>
            }
            %sum = vector.reduce<addf> %parts, %c0 : vector<8xf32>, f32
            %updated = vector.insert %sum into %current[%ordinal] : f32, vector<4xf32>
            scf.yield %updated : vector<4xf32>
          } else {
            scf.yield %current : vector<4xf32>
          }
          scf.yield %next_value : vector<4xf32>
        }
        scf.yield %values : vector<4xf32>
      }
      scf.yield %value : vector<4xf32>
    }
    %dots = kernel.subgroup.reduce<addf> %partial : vector<4xf32>
    %leader = index.cmp eq, %lane, %c0_index : index
    scf.if %leader {
      %step = index.constant 1 : index
      scf.for %ordinal = [%c0_index to %batch_size step %step] unroll schedule(linear) {
        %token = index.add %first, %ordinal : index
        %live = index.cmp ult, %token, %end : index
        scf.if %live {
          %dot = vector.extract %dots[%ordinal] : vector<4xf32> -> f32
          %scaled = scalar.mulf %dot, %quarter : f32
          %negative = scalar.negf %scaled : f32
          %exponential = scalar.expf<afn> %negative : f32
          %denominator = scalar.addf %c1, %exponential : f32
          scf.if %is_projection {
            %activated = scalar.divf %scaled, %denominator : f32
            %packed = scalar.fptrunc %activated : f32 to bf16
            %output = buffer.view %lowrank[%origin] : buffer -> view<[%tokens]x320xbf16>
            view.store %packed, %output[%token, %row] : bf16, view<[%tokens]x320xbf16>
          } else {
            %injection_row = index.sub %row, %rank : index
            %gate = scalar.divf %c2, %denominator : f32
            %output = buffer.view %injection[%origin] : buffer -> view<[%tokens]x4xf32>
            view.store %gate, %output[%token, %injection_row] : f32, view<[%tokens]x4xf32>
          }
        }
      }
    }
  }
  func.return
}

// One workgroup reduces an injection row; each wave contributes a quarter.
// The active-token and projection guards are uniform for the whole group.
func.def inline @hc_down_inject_narrow(%span_arg: buffer, %normalized_arg: buffer, %down_weight_arg: buffer, %injection_weight_arg: buffer, %lowrank_arg: buffer, %injection_arg: buffer) {
  %span, %normalized, %down_weight, %injection_weight, %lowrank, %injection = buffer.assume.noalias %span_arg, %normalized_arg, %down_weight_arg, %injection_weight_arg, %lowrank_arg, %injection_arg : buffer, buffer, buffer, buffer, buffer, buffer
  %capacity = config.get @flash_next.token_count : index
  %token = kernel.workgroup.id<y> : index
  %end = func.call @flash_next_token_count(%span, %capacity) : (buffer, index) -> (index)
  %active = index.cmp ult, %token, %end : index
  scf.if %active {
    %group = kernel.workgroup.id<x> : index
    %projection_groups = index.constant 80 : index
    %projection = index.cmp ult, %group, %projection_groups : index
    scf.if %projection {
      %zero = index.constant 0 : index
      %f32_injection = scalar.constant false : i1
      func.call @hc_down_inject_body(%zero, %f32_injection, %span, %normalized, %down_weight, %injection_weight, %lowrank, %injection) : (index, i1, buffer, buffer, buffer, buffer, buffer, buffer)
    } else {
      %row = index.sub %group, %projection_groups : index
      %workitem = kernel.workitem.id<x> : index
      %wave = kernel.subgroup.id : index
      %lane = kernel.subgroup.lane.id : index
      %origin = index.constant 0 : offset
      %zero = index.constant 0 : index
      %eight = index.constant 8 : index
      %stride = index.constant 1024 : index
      %width = index.constant 10240 : index
      %first = index.mul %workitem, %eight : index
      %input_view = buffer.view %normalized[%origin] : buffer -> view<[%capacity]x10240xbf16>
      %weight_view = buffer.view %injection_weight[%origin] : buffer -> view<4x10240xf32>
      %initial = vector.constant 0.0 : vector<8xf32>
      %parts = scf.for %channel = [%first to %width step %stride](%accumulator = %initial : vector<8xf32>) -> (vector<8xf32>) {
        %stored = vector.load %input_view[%token, %channel] : view<[%capacity]x10240xbf16> -> vector<8xbf16>
        %values = vector.extf %stored : vector<8xbf16> to vector<8xf32>
        %weights = vector.load %weight_view[%row, %channel] : view<4x10240xf32> -> vector<8xf32>
        %next = vector.fmaf %values, %weights, %accumulator : vector<8xf32>
        scf.yield %next : vector<8xf32>
      }
      %scalar_zero = scalar.constant 0.0 : f32
      %lane_sum = vector.reduce<addf> %parts, %scalar_zero : vector<8xf32>, f32
      %wave_sum = kernel.subgroup.reduce<addf> %lane_sum : f32
      %exchange_bytes = index.constant 16 : offset
      %storage = buffer.alloca<workgroup> align(16) %exchange_bytes : buffer
      %exchange = buffer.view %storage[%origin] : buffer -> view<4xf32>
      %wave_leader = index.cmp eq, %lane, %zero : index
      scf.if %wave_leader {
        view.store %wave_sum, %exchange[%wave] : f32, view<4xf32>
      }
      kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
      %leader = index.cmp eq, %workitem, %zero : index
      scf.if %leader {
        %sums = vector.load %exchange[%zero] : view<4xf32> -> vector<4xf32>
        %dot = vector.reduce<addf> %sums, %scalar_zero : vector<4xf32>, f32
        %quarter = scalar.constant 0.25 : f32
        %one = scalar.constant 1.0 : f32
        %two = scalar.constant 2.0 : f32
        %scaled = scalar.mulf %dot, %quarter : f32
        %negative = scalar.negf %scaled : f32
        %exponential = scalar.expf<afn> %negative : f32
        %denominator = scalar.addf %one, %exponential : f32
        %gate = scalar.divf %two, %denominator : f32
        %output = buffer.view %injection[%origin] : buffer -> view<[%capacity]x4xf32>
        view.store %gate, %output[%token, %row] : f32, view<[%capacity]x4xf32>
      }
    }
  }
  func.return
}

kernel.def target(@flash_next_hc_wave32) @hc_down_inject() {
  %tokens = config.get @flash_next.token_count : index
  %original_groups = index.constant 81 : index
  %parallel_groups = index.constant 84 : index
  %narrow_limit = index.constant 4 : index
  %narrow = index.cmp ule, %tokens, %narrow_limit : index
  %groups = scf.select %narrow, %parallel_groups, %original_groups : index
  %c1 = index.constant 1 : index
  %threads = index.constant 128 : index
  %batch_size = func.call pure @hc_down_token_batch_size() : () -> (index)
  %tail = index.sub %batch_size, %c1 : index
  %padded = index.add %tokens, %tail : index
  %rows = index.div %padded, %batch_size : index
  kernel.launch.config workgroups(%groups, %rows, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%span: buffer, %normalized: buffer, %down_weight: buffer, %injection_weight: buffer, %lowrank: buffer, %injection: buffer) {
  %capacity = config.get @flash_next.token_count : index
  %narrow_limit = index.constant 4 : index
  %narrow = index.cmp ule, %capacity, %narrow_limit : index
  scf.if %narrow {
    func.call @hc_down_inject_narrow(%span, %normalized, %down_weight, %injection_weight, %lowrank, %injection) : (buffer, buffer, buffer, buffer, buffer, buffer)
  } else {
    %q8_injection = scalar.constant false : i1
    %first_row = index.constant 0 : index
    func.call @hc_down_inject_body(%first_row, %q8_injection, %span, %normalized, %down_weight, %injection_weight, %lowrank, %injection) : (index, i1, buffer, buffer, buffer, buffer, buffer, buffer)
  }
  kernel.return
}

kernel.def target(@flash_next_hc_wave32) @hc_down_inject_q8() {
  %tokens = config.get @flash_next.token_count : index
  %groups = index.constant 81 : index
  %c1 = index.constant 1 : index
  %threads = index.constant 128 : index
  %batch_size = func.call pure @hc_down_token_batch_size() : () -> (index)
  %tail = index.sub %batch_size, %c1 : index
  %padded = index.add %tokens, %tail : index
  %rows = index.div %padded, %batch_size : index
  kernel.launch.config workgroups(%groups, %rows, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%span: buffer, %normalized: buffer, %down_weight: buffer, %injection_weight: buffer, %lowrank: buffer, %injection: buffer) {
  %q8_injection = scalar.constant true : i1
  %first_row = index.constant 0 : index
  func.call @hc_down_inject_body(%first_row, %q8_injection, %span, %normalized, %down_weight, %injection_weight, %lowrank, %injection) : (index, i1, buffer, buffer, buffer, buffer, buffer, buffer)
  kernel.return
}

// Four injection waves retain the same F32/Q8 arithmetic when the low-rank
// projection runs as a matrix. Down weights and low-rank storage are unused
// after specialization; the command's complete HC bindings remain disjoint.
kernel.def target(@flash_next_hc_wave32) @hc_inject_only() {
  %tokens = config.get @flash_next.token_count : index
  %groups = index.constant 1 : index
  %c1 = index.constant 1 : index
  %threads = index.constant 128 : index
  %batch_size = func.call pure @hc_down_token_batch_size() : () -> (index)
  %tail = index.sub %batch_size, %c1 : index
  %padded = index.add %tokens, %tail : index
  %rows = index.div %padded, %batch_size : index
  kernel.launch.config workgroups(%groups, %rows, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%span: buffer, %normalized: buffer, %down_weight: buffer, %injection_weight: buffer, %lowrank: buffer, %injection: buffer) {
  %q8_injection = scalar.constant false : i1
  %first_row = index.constant 320 : index
  func.call @hc_down_inject_body(%first_row, %q8_injection, %span, %normalized, %down_weight, %injection_weight, %lowrank, %injection) : (index, i1, buffer, buffer, buffer, buffer, buffer, buffer)
  kernel.return
}

kernel.def target(@flash_next_hc_wave32) @hc_inject_only_q8() {
  %tokens = config.get @flash_next.token_count : index
  %groups = index.constant 1 : index
  %c1 = index.constant 1 : index
  %threads = index.constant 128 : index
  %batch_size = func.call pure @hc_down_token_batch_size() : () -> (index)
  %tail = index.sub %batch_size, %c1 : index
  %padded = index.add %tokens, %tail : index
  %rows = index.div %padded, %batch_size : index
  kernel.launch.config workgroups(%groups, %rows, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%span: buffer, %normalized: buffer, %down_weight: buffer, %injection_weight: buffer, %lowrank: buffer, %injection: buffer) {
  %q8_injection = scalar.constant true : i1
  %first_row = index.constant 320 : index
  func.call @hc_down_inject_body(%first_row, %q8_injection, %span, %normalized, %down_weight, %injection_weight, %lowrank, %injection) : (index, i1, buffer, buffer, buffer, buffer, buffer, buffer)
  kernel.return
}

// Four eight-lane clusters compute the four gates for one feature. Up to four
// tokens share each decoded weight block, including small verification cohorts.
// Each token retains its original contraction and four-stream reduction order;
// the wave publishes mixed values without materializing a gate tensor.
kernel.def target(@flash_next_hc_wave32) @hc_up_mix() {
  %tokens = config.get @flash_next.token_count : index
  %groups = index.constant 640 : index
  %c1 = index.constant 1 : index
  %threads = index.constant 128 : index
  %batch_limit = index.constant 4 : index
  %batch_size = index.min %tokens, %batch_limit : index
  %tail = index.sub %batch_size, %c1 : index
  %padded = index.add %tokens, %tail : index
  %rows = index.div %padded, %batch_size : index
  kernel.launch.config workgroups(%groups, %rows, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%span_arg: buffer, %normalized_arg: buffer, %lowrank_arg: buffer, %weight_arg: buffer, %mixed_arg: buffer) {
  %span, %normalized, %lowrank, %weight, %mixed = buffer.assume.noalias %span_arg, %normalized_arg, %lowrank_arg, %weight_arg, %mixed_arg : buffer, buffer, buffer, buffer, buffer
  %tokens = config.get @flash_next.token_count : index
  %token_group = kernel.workgroup.id<y> : index
  %batch_limit = index.constant 4 : index
  %batch_size = index.min %tokens, %batch_limit : index
  %first = index.mul %token_group, %batch_size : index
  %end = func.call @flash_next_token_count(%span, %tokens) : (buffer, index) -> (index)
  %active = index.cmp ult, %first, %end : index
  scf.if %active {
    %group = kernel.workgroup.id<x> : index
    %wave = kernel.subgroup.id : index
    %lane = kernel.subgroup.lane.id : index
    %c0_index = index.constant 0 : index
    %c4 = index.constant 4 : index
    %cluster = index.constant 8 : index
    %rank = index.constant 320 : index
    %hidden = index.constant 2560 : index
    %origin = index.constant 0 : offset
    %feature = index.madd %group, %c4, %wave : index
    %stream = index.div %lane, %cluster : index
    %cluster_lane = index.rem %lane, %cluster : index
    %row = index.madd %stream, %hidden, %feature : index
    %partial = func.call @flash_next_q8_batch_partial(%rank, %batch_size, %first, %end, %row, %cluster_lane, %cluster, %lowrank, %weight) : (index, index, index, index, index, index, index, buffer, buffer) -> (vector<4xf32>)
    %dots = kernel.subgroup.reduce<addf> %partial {cluster_size = 8} : vector<4xf32>
    %c1 = scalar.constant 1.0 : f32
    %quarter = scalar.constant 0.25 : f32
    %cluster_leader = index.cmp eq, %cluster_lane, %c0_index : index
    %step = index.constant 1 : index
    %empty = vector.constant 0.0 : vector<4xf32>
    %contribution = scf.if %cluster_leader -> (vector<4xf32>) {
      %contributions = scf.for %ordinal = [%c0_index to %batch_size step %step](%current = %empty : vector<4xf32>) -> (vector<4xf32>) unroll schedule(linear) {
        %token = index.add %first, %ordinal : index
        %live = index.cmp ult, %token, %end : index
        %next = scf.if %live -> (vector<4xf32>) {
          %dot = vector.extract %dots[%ordinal] : vector<4xf32> -> f32
          %negative = scalar.negf %dot : f32
          %exponential = scalar.expf<afn> %negative : f32
          %denominator = scalar.addf %c1, %exponential : f32
          %gate = scalar.divf %c1, %denominator : f32
          %input_view = buffer.view %normalized[%origin] : buffer -> view<[%tokens]x4x2560xbf16>
          %stored = view.load %input_view[%token, %stream, %feature] : view<[%tokens]x4x2560xbf16> -> bf16
          %value = scalar.extf %stored : bf16 to f32
          %gated = scalar.mulf %gate, %value : f32
          %updated = vector.insert %gated into %current[%ordinal] : f32, vector<4xf32>
          scf.yield %updated : vector<4xf32>
        } else {
          scf.yield %current : vector<4xf32>
        }
        scf.yield %next : vector<4xf32>
      }
      scf.yield %contributions : vector<4xf32>
    } else {
      scf.yield %empty : vector<4xf32>
    }
    %sums = kernel.subgroup.reduce<addf> %contribution : vector<4xf32>
    %leader = index.cmp eq, %lane, %c0_index : index
    scf.if %leader {
      scf.for %ordinal = [%c0_index to %batch_size step %step] unroll schedule(linear) {
        %token = index.add %first, %ordinal : index
        %live = index.cmp ult, %token, %end : index
        scf.if %live {
          %sum = vector.extract %sums[%ordinal] : vector<4xf32> -> f32
          %mean = scalar.mulf %sum, %quarter : f32
          %packed = scalar.fptrunc %mean : f32 to bf16
          %output = buffer.view %mixed[%origin] : buffer -> view<[%tokens]x2560xbf16>
          view.store %packed, %output[%token, %feature] : bf16, view<[%tokens]x2560xbf16>
        }
      }
    }
  }
  kernel.return
}

// One workgroup owns 512 features of one residual stream. The injection gate
// is uniform within that workgroup; accumulation rounds once into BF16.
kernel.def target(@flash_next_hc_wave32) @hc_combine() {
  %groups = index.constant 20 : index
  %tokens = config.get @flash_next.token_count : index
  %threads = index.constant 64 : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %tokens, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%span_arg: buffer, %residual_arg: buffer, %projected_arg: buffer, %injection_arg: buffer, %output_arg: buffer) {
  %span, %residual, %projected, %injection, %output = buffer.assume.noalias %span_arg, %residual_arg, %projected_arg, %injection_arg, %output_arg : buffer, buffer, buffer, buffer, buffer
  %tokens = config.get @flash_next.token_count : index
  %end = func.call @flash_next_token_count(%span, %tokens) : (buffer, index) -> (index)
  %token = kernel.workgroup.id<y> : index
  %active = index.cmp ult, %token, %end : index
  scf.if %active {
    %group = kernel.workgroup.id<x> : index
    %lane = kernel.workitem.id<x> : index
    %c5 = index.constant 5 : index
    %threads = index.constant 64 : index
    %stream = index.div %group, %c5 : index
    %feature_group = index.rem %group, %c5 : index
    %block = index.madd %feature_group, %threads, %lane : index
    %c0 = index.constant 0 : index
    %origin = index.constant 0 : offset
    %residual_view = buffer.view %residual[%origin] : buffer -> view<[%tokens]x4x320x8xbf16>
    %projected_view = buffer.view %projected[%origin] : buffer -> view<[%tokens]x320x8xbf16>
    %injection_view = buffer.view %injection[%origin] : buffer -> view<[%tokens]x4xf32>
    %output_view = buffer.view %output[%origin] : buffer -> view<[%tokens]x4x320x8xbf16>
    %stored_residual = vector.load %residual_view[%token, %stream, %block, %c0] : view<[%tokens]x4x320x8xbf16> -> vector<8xbf16>
    %stored_projected = vector.load %projected_view[%token, %block, %c0] : view<[%tokens]x320x8xbf16> -> vector<8xbf16>
    %gate = view.load %injection_view[%token, %stream] : view<[%tokens]x4xf32> -> f32
    %residual_values = vector.extf %stored_residual : vector<8xbf16> to vector<8xf32>
    %projected_values = vector.extf %stored_projected : vector<8xbf16> to vector<8xf32>
    %gates = vector.splat %gate : vector<8xf32>
    %sum = vector.fmaf %projected_values, %gates, %residual_values : vector<8xf32>
    %packed = vector.fptrunc %sum : vector<8xf32> to vector<8xbf16>
    vector.store %packed, %output_view[%token, %stream, %block, %c0] : vector<8xbf16>, view<[%tokens]x4x320x8xbf16>
  }
  kernel.return
}

// Attention and FFN bind different parameters to the same packed schedule.
command.program.def @flash_next_hc(%injection_bytes: index, %q8_injection: i1, %gamma: view<4x2560xf32>, %down_weight: view<3481600xi8>, %up_weight: view<3481600xi8>, %injection_weight: view<[%injection_bytes]xi8>) launch(%span: buffer, %residual: buffer, %injection: buffer, %mixed: buffer) {
  %tokens = config.get @flash_next.token_count : index
  %residual_row_bytes = index.constant 20480 : offset
  %rank_row_bytes = index.constant 640 : offset
  %residual_bytes = index.scale %tokens, %residual_row_bytes : index, offset -> offset
  %rank_bytes = index.scale %tokens, %rank_row_bytes : index, offset -> offset
  %normalized = buffer.alloca<global> align(256) %residual_bytes : buffer
  %lowrank = buffer.alloca<global> align(256) %rank_bytes : buffer
  kernel.launch @hc_normalize(%span, %residual, %gamma, %normalized) : (buffer, buffer, view<4x2560xf32>, buffer)
  // Matrix reuse wins once a prepared epoch can populate a 128-row tile.
  // The immutable live extent still guards partial and empty workgroups.
  %threshold = index.constant 128 : index
  %matrix = index.cmp uge, %tokens, %threshold : index
  scf.if %matrix {
    %half_threshold = index.constant 4096 : index
    %use_half = index.cmp uge, %tokens, %half_threshold : index
    scf.if %use_half {
      kernel.launch @hc_matrix_down_half(%span, %normalized, %down_weight, %lowrank) : (buffer, buffer, view<3481600xi8>, buffer)
    } else {
      kernel.launch @hc_matrix_down(%span, %normalized, %down_weight, %lowrank) : (buffer, buffer, view<3481600xi8>, buffer)
    }
    scf.if %q8_injection {
      kernel.launch @hc_inject_only_q8(%span, %normalized, %down_weight, %injection_weight, %lowrank, %injection) : (buffer, buffer, view<3481600xi8>, view<[%injection_bytes]xi8>, buffer, buffer)
    } else {
      kernel.launch @hc_inject_only(%span, %normalized, %down_weight, %injection_weight, %lowrank, %injection) : (buffer, buffer, view<3481600xi8>, view<[%injection_bytes]xi8>, buffer, buffer)
    }
    kernel.launch @hc_matrix_up(%span, %normalized, %lowrank, %up_weight, %mixed) : (buffer, buffer, buffer, view<3481600xi8>, buffer)
  } else {
    scf.if %q8_injection {
      kernel.launch @hc_down_inject_q8(%span, %normalized, %down_weight, %injection_weight, %lowrank, %injection) : (buffer, buffer, view<3481600xi8>, view<[%injection_bytes]xi8>, buffer, buffer)
    } else {
      kernel.launch @hc_down_inject(%span, %normalized, %down_weight, %injection_weight, %lowrank, %injection) : (buffer, buffer, view<3481600xi8>, view<[%injection_bytes]xi8>, buffer, buffer)
    }
    kernel.launch @hc_up_mix(%span, %normalized, %lowrank, %up_weight, %mixed) : (buffer, buffer, buffer, view<3481600xi8>, buffer)
  }
  command.return
}

command.program.def public @flash_next_hc_attn(%layer: index) launch(%parameters: buffer, %span: buffer, %residual: buffer, %injection: buffer, %mixed: buffer) {
  %gamma = command.parameter %parameters, "blk.{}.hc_attn_norm.weight"[%layer] : view<4x2560xf32>
  %down_weight = command.parameter %parameters, "blk.{}.hc_attn_down.weight"[%layer] : view<3481600xi8>
  %up_weight = command.parameter %parameters, "blk.{}.hc_attn_up.weight"[%layer] : view<3481600xi8>
  %predictor_layer = index.constant 48 : index
  %q8_injection = index.cmp eq, %layer, %predictor_layer : index
  %q8_bytes = index.constant 43520 : index
  %f32_bytes = index.constant 163840 : index
  %injection_bytes = scf.select %q8_injection, %q8_bytes, %f32_bytes : index
  %injection_weight = command.parameter %parameters, "blk.{}.hc_attn_inject.weight"[%layer] : view<[%injection_bytes]xi8>
  command.program.launch @flash_next_hc[%injection_bytes, %q8_injection, %gamma, %down_weight, %up_weight, %injection_weight](%span, %residual, %injection, %mixed) : [index, i1, view<4x2560xf32>, view<3481600xi8>, view<3481600xi8>, view<[%injection_bytes]xi8>](buffer, buffer, buffer, buffer)
  command.return
}

command.program.def public @flash_next_hc_ffn(%layer: index) launch(%parameters: buffer, %span: buffer, %residual: buffer, %injection: buffer, %mixed: buffer) {
  %gamma = command.parameter %parameters, "blk.{}.hc_ffn_norm.weight"[%layer] : view<4x2560xf32>
  %down_weight = command.parameter %parameters, "blk.{}.hc_ffn_down.weight"[%layer] : view<3481600xi8>
  %up_weight = command.parameter %parameters, "blk.{}.hc_ffn_up.weight"[%layer] : view<3481600xi8>
  %predictor_layer = index.constant 48 : index
  %q8_injection = index.cmp eq, %layer, %predictor_layer : index
  %q8_bytes = index.constant 43520 : index
  %f32_bytes = index.constant 163840 : index
  %injection_bytes = scf.select %q8_injection, %q8_bytes, %f32_bytes : index
  %injection_weight = command.parameter %parameters, "blk.{}.hc_ffn_inject.weight"[%layer] : view<[%injection_bytes]xi8>
  command.program.launch @flash_next_hc[%injection_bytes, %q8_injection, %gamma, %down_weight, %up_weight, %injection_weight](%span, %residual, %injection, %mixed) : [index, i1, view<4x2560xf32>, view<3481600xi8>, view<3481600xi8>, view<[%injection_bytes]xi8>](buffer, buffer, buffer, buffer)
  command.return
}

kernel.def target(@flash_next_hc_wave32) @hc_combine_normalize() {
  %tokens = config.get @flash_next.token_count : index
  %c1 = index.constant 1 : index
  %threads = index.constant 128 : index
  kernel.launch.config workgroups(%tokens, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%span_arg: buffer, %residual_arg: buffer, %projected_arg: buffer, %injection_arg: buffer, %gamma_arg: buffer, %output_arg: buffer, %normalized_arg: buffer) {
  %span, %residual, %projected, %injection, %gamma, %output, %normalized = buffer.assume.noalias %span_arg, %residual_arg, %projected_arg, %injection_arg, %gamma_arg, %output_arg, %normalized_arg : buffer, buffer, buffer, buffer, buffer, buffer, buffer
  %tokens = config.get @flash_next.token_count : index
  %token = kernel.workgroup.id<x> : index
  %end = func.call @flash_next_token_count(%span, %tokens) : (buffer, index) -> (index)
  %active = index.cmp ult, %token, %end : index
  scf.if %active {
    %stream = kernel.subgroup.id : index
    %lane = kernel.subgroup.lane.id : index
    %origin = index.constant 0 : offset
    %c8 = index.constant 8 : index
    %stride = index.constant 256 : index
    %width = index.constant 2560 : index
    %first = index.mul %lane, %c8 : index
    %input_view = buffer.view %residual[%origin] : buffer -> view<[%tokens]x4x2560xbf16>
    %gamma_view = buffer.view %gamma[%origin] : buffer -> view<4x2560xf32>
    %output_view = buffer.view %normalized[%origin] : buffer -> view<[%tokens]x4x2560xbf16>
    %c0 = scalar.constant 0.0 : f32
    %c0_vector = vector.constant 0.0 : vector<8xf32>
    %projected_view = buffer.view %projected[%origin] : buffer -> view<[%tokens]x2560xbf16>
    %injection_view = buffer.view %injection[%origin] : buffer -> view<[%tokens]x4xf32>
    %residual_output = buffer.view %output[%origin] : buffer -> view<[%tokens]x4x2560xbf16>
    %gate = view.load %injection_view[%token, %stream] : view<[%tokens]x4xf32> -> f32
    %gates = vector.splat %gate : vector<8xf32>
    %c0_index = index.constant 0 : index
    %c1_index = index.constant 1 : index
    %chunks = index.constant 10 : index
    %initial = vector.constant 0.0 : vector<10x8xbf16>
    // Preserve the published BF16 residual before computing its norm.
    %partial, %retained = scf.for %chunk = [%c0_index to %chunks step %c1_index](%accumulator = %c0_vector : vector<8xf32>, %prior = %initial : vector<10x8xbf16>) -> (vector<8xf32>, vector<10x8xbf16>) unroll schedule(linear) {
      %channel = index.madd %chunk, %stride, %first : index
      %stored = vector.load %input_view[%token, %stream, %channel] : view<[%tokens]x4x2560xbf16> -> vector<8xbf16>
      %branch = vector.load %projected_view[%token, %channel] : view<[%tokens]x2560xbf16> -> vector<8xbf16>
      %old = vector.extf %stored : vector<8xbf16> to vector<8xf32>
      %branch_values = vector.extf %branch : vector<8xbf16> to vector<8xf32>
      %combined = vector.fmaf %branch_values, %gates, %old : vector<8xf32>
      %packed_residual = vector.fptrunc %combined : vector<8xf32> to vector<8xbf16>
      vector.store %packed_residual, %residual_output[%token, %stream, %channel] : vector<8xbf16>, view<[%tokens]x4x2560xbf16>
      %values = vector.extf %packed_residual : vector<8xbf16> to vector<8xf32>
      %next = vector.fmaf %values, %values, %accumulator : vector<8xf32>
      %retained_next = vector.insert %packed_residual into %prior[%chunk] : vector<8xbf16>, vector<10x8xbf16>
      scf.yield %next, %retained_next : vector<8xf32>, vector<10x8xbf16>
    }
    %lane_sum = vector.reduce<addf> %partial, %c0 : vector<8xf32>, f32
    %sum = kernel.subgroup.reduce<addf> %lane_sum : f32
    %reciprocal_width = scalar.constant 0.00039062500000000002 : f32
    %epsilon = scalar.constant 9.9999999999999995e-07 : f32
    %mean = scalar.mulf %sum, %reciprocal_width : f32
    %variance = scalar.addf %mean, %epsilon : f32
    %inverse = scalar.rsqrtf<afn> %variance : f32
    %inverse_vector = vector.splat %inverse : vector<8xf32>
    scf.for %chunk = [%c0_index to %chunks step %c1_index] unroll schedule(linear) {
      %channel = index.madd %chunk, %stride, %first : index
      %stored = vector.extract %retained[%chunk] : vector<10x8xbf16> -> vector<8xbf16>
      %values = vector.extf %stored : vector<8xbf16> to vector<8xf32>
      %scales = vector.load %gamma_view[%stream, %channel] : view<4x2560xf32> -> vector<8xf32>
      %unit = vector.mulf %values, %inverse_vector : vector<8xf32>
      %scaled = vector.mulf %unit, %scales : vector<8xf32>
      %packed = vector.fptrunc %scaled : vector<8xf32> to vector<8xbf16>
      vector.store %packed, %output_view[%token, %stream, %channel] : vector<8xbf16>, view<[%tokens]x4x2560xbf16>
    }
  }
  kernel.return
}

command.program.def @flash_next_hc_normalized(%injection_bytes: index, %q8_injection: i1, %down_weight: view<3481600xi8>, %up_weight: view<3481600xi8>, %injection_weight: view<[%injection_bytes]xi8>) launch(%span: buffer, %normalized: buffer, %injection: buffer, %mixed: buffer) {
  %tokens = config.get @flash_next.token_count : index
  %rank_row_bytes = index.constant 640 : offset
  %rank_bytes = index.scale %tokens, %rank_row_bytes : index, offset -> offset
  %lowrank = buffer.alloca<global> align(256) %rank_bytes : buffer
  // Matrix reuse wins once a prepared epoch can populate a 128-row tile.
  // The immutable live extent still guards partial and empty workgroups.
  %threshold = index.constant 128 : index
  %matrix = index.cmp uge, %tokens, %threshold : index
  scf.if %matrix {
    %half_threshold = index.constant 4096 : index
    %use_half = index.cmp uge, %tokens, %half_threshold : index
    scf.if %use_half {
      kernel.launch @hc_matrix_down_half(%span, %normalized, %down_weight, %lowrank) : (buffer, buffer, view<3481600xi8>, buffer)
    } else {
      kernel.launch @hc_matrix_down(%span, %normalized, %down_weight, %lowrank) : (buffer, buffer, view<3481600xi8>, buffer)
    }
    scf.if %q8_injection {
      kernel.launch @hc_inject_only_q8(%span, %normalized, %down_weight, %injection_weight, %lowrank, %injection) : (buffer, buffer, view<3481600xi8>, view<[%injection_bytes]xi8>, buffer, buffer)
    } else {
      kernel.launch @hc_inject_only(%span, %normalized, %down_weight, %injection_weight, %lowrank, %injection) : (buffer, buffer, view<3481600xi8>, view<[%injection_bytes]xi8>, buffer, buffer)
    }
    kernel.launch @hc_matrix_up(%span, %normalized, %lowrank, %up_weight, %mixed) : (buffer, buffer, buffer, view<3481600xi8>, buffer)
  } else {
    scf.if %q8_injection {
      kernel.launch @hc_down_inject_q8(%span, %normalized, %down_weight, %injection_weight, %lowrank, %injection) : (buffer, buffer, view<3481600xi8>, view<[%injection_bytes]xi8>, buffer, buffer)
    } else {
      kernel.launch @hc_down_inject(%span, %normalized, %down_weight, %injection_weight, %lowrank, %injection) : (buffer, buffer, view<3481600xi8>, view<[%injection_bytes]xi8>, buffer, buffer)
    }
    kernel.launch @hc_up_mix(%span, %normalized, %lowrank, %up_weight, %mixed) : (buffer, buffer, buffer, view<3481600xi8>, buffer)
  }
  command.return
}

command.program.def public @flash_next_hc_ffn_normalized(%layer: index) launch(%parameters: buffer, %span: buffer, %normalized: buffer, %injection: buffer, %mixed: buffer) {
  %down_weight = command.parameter %parameters, "blk.{}.hc_ffn_down.weight"[%layer] : view<3481600xi8>
  %up_weight = command.parameter %parameters, "blk.{}.hc_ffn_up.weight"[%layer] : view<3481600xi8>
  %predictor_layer = index.constant 48 : index
  %q8_injection = index.cmp eq, %layer, %predictor_layer : index
  %q8_bytes = index.constant 43520 : index
  %f32_bytes = index.constant 163840 : index
  %injection_bytes = scf.select %q8_injection, %q8_bytes, %f32_bytes : index
  %injection_weight = command.parameter %parameters, "blk.{}.hc_ffn_inject.weight"[%layer] : view<[%injection_bytes]xi8>
  command.program.launch @flash_next_hc_normalized[%injection_bytes, %q8_injection, %down_weight, %up_weight, %injection_weight](%span, %normalized, %injection, %mixed) : [index, i1, view<3481600xi8>, view<3481600xi8>, view<[%injection_bytes]xi8>](buffer, buffer, buffer, buffer)
  command.return
}

command.program.def public @flash_next_hc_attn_normalized(%layer: index) launch(%parameters: buffer, %span: buffer, %normalized: buffer, %injection: buffer, %mixed: buffer) {
  %down_weight = command.parameter %parameters, "blk.{}.hc_attn_down.weight"[%layer] : view<3481600xi8>
  %up_weight = command.parameter %parameters, "blk.{}.hc_attn_up.weight"[%layer] : view<3481600xi8>
  %predictor_layer = index.constant 48 : index
  %q8_injection = index.cmp eq, %layer, %predictor_layer : index
  %q8_bytes = index.constant 43520 : index
  %f32_bytes = index.constant 163840 : index
  %injection_bytes = scf.select %q8_injection, %q8_bytes, %f32_bytes : index
  %injection_weight = command.parameter %parameters, "blk.{}.hc_attn_inject.weight"[%layer] : view<[%injection_bytes]xi8>
  command.program.launch @flash_next_hc_normalized[%injection_bytes, %q8_injection, %down_weight, %up_weight, %injection_weight](%span, %normalized, %injection, %mixed) : [index, i1, view<3481600xi8>, view<3481600xi8>, view<[%injection_bytes]xi8>](buffer, buffer, buffer, buffer)
  command.return
}

// One wave owns each input stream. Keep four independent vector dots on the
// published BF16 values; only sixteen F32 partials cross the wave boundary.
func.def inline @hc_injection_chunk(%stream: index, %channel: index, %packed: vector<8xbf16>, %weight: buffer, %partial: vector<4x8xf32>) -> (vector<4x8xf32>) {
  %origin = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %outputs = index.constant 4 : index
  %weights = buffer.view %weight[%origin] : buffer -> view<4x4x2560xf32>
  %values = vector.extf %packed : vector<8xbf16> to vector<8xf32>
  %result = scf.for %row = [%zero to %outputs step %one](%current = %partial : vector<4x8xf32>) -> (vector<4x8xf32>) unroll schedule(linear) {
    %prior = vector.extract %current[%row] : vector<4x8xf32> -> vector<8xf32>
    %coefficient = vector.load %weights[%row, %stream, %channel] : view<4x4x2560xf32> -> vector<8xf32>
    %next = vector.fmaf %values, %coefficient, %prior : vector<8xf32>
    %updated = vector.insert %next into %current[%row] : vector<8xf32>, vector<4x8xf32>
    scf.yield %updated : vector<4x8xf32>
  }
  func.return %result : vector<4x8xf32>
}

// The active-token guard is uniform for the whole workgroup. Each stream's
// leader publishes all four output partials before every wave joins the barrier.
func.def inline @hc_injection_publish(%token: index, %stream: index, %lane: index, %partial: vector<4x8xf32>, %output: buffer) {
  %capacity = config.get @flash_next.token_count : index
  %origin = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %three = index.constant 3 : index
  %four = index.constant 4 : index
  %bytes = index.constant 64 : offset
  %storage = buffer.alloca<workgroup> align(16) %bytes : buffer
  %exchange = buffer.view %storage[%origin] : buffer -> view<4x4xf32>
  %scalar_zero = scalar.constant 0.0 : f32
  %empty = vector.constant 0.0 : vector<4xf32>
  %lane_sums = scf.for %row = [%zero to %four step %one](%current = %empty : vector<4xf32>) -> (vector<4xf32>) unroll schedule(linear) {
    %vector_part = vector.extract %partial[%row] : vector<4x8xf32> -> vector<8xf32>
    %sum = vector.reduce<addf> %vector_part, %scalar_zero : vector<8xf32>, f32
    %updated = vector.insert %sum into %current[%row] : f32, vector<4xf32>
    scf.yield %updated : vector<4xf32>
  }
  %wave_sums = kernel.subgroup.reduce<addf> %lane_sums : vector<4xf32>
  %leader = index.cmp eq, %lane, %zero : index
  scf.if %leader {
    vector.store %wave_sums, %exchange[%stream, %zero] : vector<4xf32>, view<4x4xf32>
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  scf.if %leader {
    %a = view.load %exchange[%zero, %stream] : view<4x4xf32> -> f32
    %b = view.load %exchange[%one, %stream] : view<4x4xf32> -> f32
    %c = view.load %exchange[%two, %stream] : view<4x4xf32> -> f32
    %d = view.load %exchange[%three, %stream] : view<4x4xf32> -> f32
    %ab = scalar.addf %a, %b : f32
    %cd = scalar.addf %c, %d : f32
    %dot = scalar.addf %ab, %cd : f32
    %quarter = scalar.constant 0.25 : f32
    %scaled = scalar.mulf %dot, %quarter : f32
    %negative = scalar.negf %scaled : f32
    %exponential = scalar.expf<afn> %negative : f32
    %scalar_one = scalar.constant 1.0 : f32
    %scalar_two = scalar.constant 2.0 : f32
    %denominator = scalar.addf %scalar_one, %exponential : f32
    %gate = scalar.divf %scalar_two, %denominator : f32
    %gates = buffer.view %output[%origin] : buffer -> view<[%capacity]x4xf32>
    view.store %gate, %gates[%token, %stream] : f32, view<[%capacity]x4xf32>
  }
  func.return
}
kernel.def target(@flash_next_hc_wave32) @hc_normalize_inject() {
  %tokens = config.get @flash_next.token_count : index
  %c1 = index.constant 1 : index
  %threads = index.constant 128 : index
  kernel.launch.config workgroups(%tokens, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%span_arg: buffer, %residual_arg: buffer, %gamma_arg: buffer, %normalized_arg: buffer, %next_weight_arg: buffer, %next_injection_arg: buffer) {
  %span, %residual, %gamma, %normalized, %next_weight, %next_injection = buffer.assume.noalias %span_arg, %residual_arg, %gamma_arg, %normalized_arg, %next_weight_arg, %next_injection_arg : buffer, buffer, buffer, buffer, buffer, buffer
  %tokens = config.get @flash_next.token_count : index
