command.program.def public @flash_next_hc_mix_normalized(%down_weight: view<3481600xi8>, %up_weight: view<3481600xi8>) launch(%span: buffer, %normalized: buffer, %mixed: buffer) {
  %tokens = config.get @flash_next.token_count : index
  %rank_row_bytes = index.constant 640 : offset
  %rank_bytes = index.scale %tokens, %rank_row_bytes : index, offset -> offset
  %lowrank = buffer.alloca<global> align(256) %rank_bytes : buffer
  %half_threshold = index.constant 4096 : index
  %use_half = index.cmp uge, %tokens, %half_threshold : index
  scf.if %use_half {
    kernel.launch @hc_matrix_down_half(%span, %normalized, %down_weight, %lowrank) : (buffer, buffer, view<3481600xi8>, buffer)
  } else {
    kernel.launch @hc_matrix_down(%span, %normalized, %down_weight, %lowrank) : (buffer, buffer, view<3481600xi8>, buffer)
  }
  kernel.launch @hc_matrix_up(%span, %normalized, %lowrank, %up_weight, %mixed) : (buffer, buffer, buffer, view<3481600xi8>, buffer)
  command.return
}

amdgpu.target<gfx11-generic> @hc_int8_wave32 {subgroup_size = 32}

func.def inline @hc_quantize_chunk(%token: index, %stream: index, %channel: index, %values: vector<8xbf16>, %output: buffer) {
  %c0 = index.constant 0 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c80 = index.constant 80 : index
  %c320 = index.constant 320 : index
  %exchange1 = scalar.constant 1 : i32
  %exchange2 = scalar.constant 2 : i32
  %width = scalar.constant 32 : i32
  %zero = scalar.constant 0.0 : f32
  %one = scalar.constant 1.0 : f32
  %divisor = scalar.constant 127.0 : f32
  %minimum = scalar.constant 1.1754943508222875e-38 : f32
  %wide = vector.extf %values : vector<8xbf16> to vector<8xf32>
  %absolute = vector.absf %wide : vector<8xf32>
  %local = vector.reduce<maxnumf> %absolute, %zero : vector<8xf32>, f32
  %peer1, %valid1 = kernel.subgroup.shuffle<xor> %local, %exchange1, %width : f32, i32, i32
  %pair = scalar.maxnumf %local, %peer1 : f32
  %peer2, %valid2 = kernel.subgroup.shuffle<xor> %pair, %exchange2, %width : f32, i32, i32
  %maximum = scalar.maxnumf %pair, %peer2 : f32
  // Exact for every finite BF16 maximum, including subnormal intermediates.
  %scale_reciprocal = scalar.constant 0.007874015718698502 : f32
  %negative_divisor = scalar.constant -127.0 : f32
  %estimate = scalar.mulf %maximum, %scale_reciprocal : f32
  %remainder = scalar.fmaf %estimate, %negative_divisor, %maximum : f32
  %unbounded_scale = scalar.fmaf %remainder, %scale_reciprocal, %estimate : f32
  // A subnormal scale is represented as a zero block. The reciprocal's
  // denominator is then one, so finite inputs cannot overflow conversion.
  %normal = scalar.cmpf oge, %unbounded_scale, %minimum : f32
  %scale = scf.select %normal, %unbounded_scale, %zero : f32
  %denominator = scf.select %normal, %scale, %one : f32
  %reciprocal = scalar.divf<arcp> %one, %denominator : f32
  %inverse = scf.select %normal, %reciprocal, %zero : f32
  %inverses = vector.splat %inverse : vector<8xf32>
  %scaled = vector.mulf %wide, %inverses : vector<8xf32>
  %rounded = vector.roundf %scaled : vector<8xf32>
  %lowest = vector.constant -127.0 : vector<8xf32>
  %highest = vector.constant 127.0 : vector<8xf32>
  %bounded_low = vector.maxnumf %rounded, %lowest : vector<8xf32>
  %bounded = vector.minnumf %bounded_low, %highest : vector<8xf32>
  %codes = vector.fptosi %bounded : vector<8xf32> to vector<8xi8>
  %token_tile = index.div %token, %c16 : index
  %token_lane = index.rem %token, %c16 : index
  %local_block = index.div %channel, %c32 : index
  %block = index.madd %stream, %c80, %local_block : index
  %record = index.madd %token_tile, %c320, %block : index
  %record_bytes = index.constant 576 : offset
  %origin = index.scale %record, %record_bytes : index, offset -> offset
  %within = index.rem %channel, %c32 : index
  %half = index.div %within, %c16 : index
  %half_column = index.rem %within, %c16 : index
  %half_size = index.constant 256 : index
  %plane_base = index.mul %half, %half_size : index
  %token_base = index.madd %token_lane, %c16, %plane_base : index
  %position = index.add %token_base, %half_column : index
  %code_view = buffer.view %output[%origin] : buffer -> view<512xi8>
  vector.store %codes, %code_view[%position] : vector<8xi8>, view<512xi8>
  %leader = index.cmp eq, %within, %c0 : index
  scf.if %leader {
    %scale_delta = index.constant 512 : offset
    %scale_origin = index.add %origin, %scale_delta : offset
    %scale_view = buffer.view %output[%scale_origin] : buffer -> view<16xf32>
    view.store %scale, %scale_view[%token_lane] : f32, view<16xf32>
  }
  func.return
}

func.def inline @hc_int8_record(%input: buffer, %record_base: index, %first_block: index, %part: index, %half_position: index, %token_lane: index) -> (vector<4xi32>, f32) {
  %c0 = index.constant 0 : index
  %record_bytes = index.constant 576 : offset
  %scale_delta = index.constant 512 : offset
  %k_block = index.add %first_block, %part : index
  %record = index.add %record_base, %k_block : index
  %origin = index.scale %record, %record_bytes : index, offset -> offset
  %scale_origin = index.add %origin, %scale_delta : offset
  %code_view = buffer.view %input[%origin] : buffer -> view<32x4xi32>
  %scale_view = buffer.view %input[%scale_origin] : buffer -> view<16xf32>
  %codes = vector.load %code_view[%half_position, %c0] : view<32x4xi32> -> vector<4xi32>
  %scale = view.load %scale_view[%token_lane] : view<16xf32> -> f32
  func.return %codes, %scale : vector<4xi32>, f32
}

