// Original Q4_K/Q5_K/Q8_0 gate/up and Q5_1/Q8_0 down weights stay compressed. Selected
// experts publish BF16 SwiGLU and down results; routing and shared-expert
// weighting accumulate in F32 before the final BF16 branch publication.
config.decl @flash_next.token_count : %value: index where [range(%value, 1, 32768)]

amdgpu.target<gfx11-generic> @flash_next_expert_wave32 {subgroup_size = 32}

func.decl @flash_next_token_count(%epoch: buffer, %capacity: index) -> (index)

func.decl @flash_next_qk_partial(%q5_encoding: i1, %width: index, %token: index, %row: index, %lane: index, %stride: index, %input: buffer, %weight: buffer) -> (f32)

func.decl @flash_next_q51_partial(%width: index, %token: index, %row: index, %lane: index, %stride: index, %input: buffer, %weight: buffer) -> (f32)

func.decl @flash_next_q8_partial(%width: index, %token: index, %row: index, %lane: index, %stride: index, %input: buffer, %weight: buffer) -> (f32)

kernel.decl @flash_next_linear_q8(%output_capacity: index) launch(%input_width: index, %output_width: index, %span: buffer, %input: buffer, %weight: buffer, %output: buffer)

func.def inline @expert_swiglu(%gate: f32, %up: f32) -> (bf16) {
  %c1 = scalar.constant 1.0 : f32
  %negative = scalar.negf %gate : f32
  %exponential = scalar.expf<afn> %negative : f32
  %denominator = scalar.addf %c1, %exponential : f32
  %silu = scalar.divf %gate, %denominator : f32
  %product = scalar.mulf %silu, %up : f32
  %packed = scalar.fptrunc %product : f32 to bf16
  func.return %packed : bf16
}

func.def inline @expert_gate_up_body(%q8_encoding: i1, %q5_encoding: i1, %span_arg: buffer, %input_arg: buffer, %ids_arg: buffer, %gate_weight_arg: buffer, %up_weight_arg: buffer, %output_arg: buffer) {
  %span, %input, %ids, %gate_weight, %up_weight, %output = buffer.assume.noalias %span_arg, %input_arg, %ids_arg, %gate_weight_arg, %up_weight_arg, %output_arg : buffer, buffer, buffer, buffer, buffer, buffer
  %tokens = config.get @flash_next.token_count : index
  %end = func.call @flash_next_token_count(%span, %tokens) : (buffer, index) -> (index)
  %token = kernel.workgroup.id<y> : index
  %active = index.cmp ult, %token, %end : index
  scf.if %active {
    %group = kernel.workgroup.id<x> : index
    %slot = kernel.workgroup.id<z> : index
    %wave = kernel.subgroup.id : index
    %lane = kernel.subgroup.lane.id : index
    %c0 = index.constant 0 : index
    %input_width = index.constant 2560 : index
    %stride = index.constant 32 : index
    %c4 = index.constant 4 : index
    %width = index.constant 640 : index
    %origin = index.constant 0 : offset
    %feature = index.madd %group, %c4, %wave : index
    %ids_view = buffer.view %ids[%origin] : buffer -> view<[%tokens]x10xi32>
    %expert_i32 = view.load %ids_view[%token, %slot] : view<[%tokens]x10xi32> -> i32
    %expert_index = index.cast %expert_i32 : i32 to index
    %expert = index.assume %expert_index [range(%expert_index, 0, 511)] : index
    %row = index.madd %expert, %width, %feature : index
    %gate_partial, %up_partial = scf.if %q8_encoding -> (f32, f32) {
      %gate = func.call @flash_next_q8_partial(%input_width, %token, %row, %lane, %stride, %input, %gate_weight) : (index, index, index, index, index, buffer, buffer) -> (f32)
      %up = func.call @flash_next_q8_partial(%input_width, %token, %row, %lane, %stride, %input, %up_weight) : (index, index, index, index, index, buffer, buffer) -> (f32)
      scf.yield %gate, %up : f32, f32
    } else {
      %gate = func.call @flash_next_qk_partial(%q5_encoding, %input_width, %token, %row, %lane, %stride, %input, %gate_weight) : (i1, index, index, index, index, index, buffer, buffer) -> (f32)
      %up = func.call @flash_next_qk_partial(%q5_encoding, %input_width, %token, %row, %lane, %stride, %input, %up_weight) : (i1, index, index, index, index, index, buffer, buffer) -> (f32)
      scf.yield %gate, %up : f32, f32
    }
    %gate = kernel.subgroup.reduce<addf> %gate_partial : f32
    %up = kernel.subgroup.reduce<addf> %up_partial : f32
    %leader = index.cmp eq, %lane, %c0 : index
    scf.if %leader {
      %packed = func.call @expert_swiglu(%gate, %up) : (f32, f32) -> (bf16)
      %view = buffer.view %output[%origin] : buffer -> view<[%tokens]x10x640xbf16>
      view.store %packed, %view[%token, %slot, %feature] : bf16, view<[%tokens]x10x640xbf16>
    }
  }
  func.return
}

kernel.def target(@flash_next_expert_wave32) @expert_gate_up_q4k() {
  %groups = index.constant 160 : index
  %tokens = config.get @flash_next.token_count : index
  %selected = index.constant 10 : index
  %threads = index.constant 128 : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %tokens, %selected) workgroup_size(%threads, %c1, %c1) : index
} launch(%span_arg: buffer, %input_arg: buffer, %ids_arg: buffer, %gate_weight_arg: buffer, %up_weight_arg: buffer, %output_arg: buffer) {
  %q5_encoding = scalar.constant false : i1
  %q8_encoding = scalar.constant false : i1
  func.call @expert_gate_up_body(%q8_encoding, %q5_encoding, %span_arg, %input_arg, %ids_arg, %gate_weight_arg, %up_weight_arg, %output_arg) : (i1, i1, buffer, buffer, buffer, buffer, buffer, buffer)
  kernel.return
}

