    %output_fragment0_0 = vector.fragment<result> %normalized0_0 shape [%tile, %tile] : vector<8xf32>
    vector.fragment.store<result> %output_fragment0_0, %transposed[%half0_0, %c0] shape [%tile, %tile] : vector<8xf32>, view<32x16xf32, %stage_layout>

    %normalized0_1 = vector.divf %final0_1, %denominator0 : vector<8xf32>
    %output_fragment0_1 = vector.fragment<result> %normalized0_1 shape [%tile, %tile] : vector<8xf32>
    vector.fragment.store<result> %output_fragment0_1, %transposed[%half0_1, %c0] shape [%tile, %tile] : vector<8xf32>, view<32x16xf32, %stage_layout>

    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.for %round = [%c0 to %c4 step %c1] unroll {
      %local_head = index.madd %round, %c4, %stage_row : index
      %cohort_head = index.add %fragment_base0, %local_head : index
      %relative_query = index.div %cohort_head, %c12 : index
      %head_relative = index.rem %cohort_head, %c12 : index
      %output_head = index.add %head_base, %head_relative : index
      %live = index.cmp ult, %relative_query, %length : index
      scf.if %live {
