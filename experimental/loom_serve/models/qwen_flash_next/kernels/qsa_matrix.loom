    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    // Reuse the retired score plane to transpose once for coalesced output.
    %output_plane_bytes = index.constant 2048 : offset
    %output_plane = index.scale %wave, %output_plane_bytes : index, offset -> offset
    %stage = buffer.view %shared[%output_plane] : buffer -> view<16x32xf32>
    %stage_layout = encoding.layout.strided [1, 32] : encoding<layout>
    %transposed = buffer.view %shared[%output_plane] : buffer -> view<32x16xf32, %stage_layout>
    %stage_row = index.div %lane, %c8 : index
    %stage_packet = index.rem %lane, %c8 : index
    %stage_channel = index.mul %stage_packet, %c4 : index

    %sum0 = view.load %sums[%fragment0, %r] : view<3x16xf32> -> f32
    %nonzero0 = scalar.cmpf ogt, %sum0, %c0_f32 : f32
    %divisor0 = scf.select %nonzero0, %sum0, %c1_f32 : f32
    %denominator0 = vector.splat %divisor0 : vector<8xf32>

