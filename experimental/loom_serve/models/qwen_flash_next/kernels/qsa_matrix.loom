      %product1_0 = vector.mma %value0, %high1, %scaled1_0 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
      %next1_0 = vector.mma %value0, %low1, %product1_0 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>

      %scaled1_1 = vector.mulf %accumulator1_1, %scale1 : vector<8xf32>
      %product1_1 = vector.mma %value1, %high1, %scaled1_1 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
      %next1_1 = vector.mma %value1, %low1, %product1_1 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>

