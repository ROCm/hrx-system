    %sum1 = view.load %sums[%fragment1, %r] : view<3x16xf32> -> f32
    %nonzero1 = scalar.cmpf ogt, %sum1, %c0_f32 : f32
    %divisor1 = scf.select %nonzero1, %sum1, %c1_f32 : f32
    %denominator1 = vector.splat %divisor1 : vector<8xf32>

