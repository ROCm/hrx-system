      %low_values2 = vector.load %lows[%fragment2, %r, %c0] : view<3x16x16xbf16> -> vector<16xbf16>
      %high2 = vector.fragment<rhs> %high_values2 shape [%tile, %tile] : vector<16xbf16>
      %low2 = vector.fragment<rhs> %low_values2 shape [%tile, %tile] : vector<16xbf16>

      %scaled2_0 = vector.mulf %accumulator2_0, %scale2 : vector<8xf32>
      %product2_0 = vector.mma %value0, %high2, %scaled2_0 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
      %next2_0 = vector.mma %value0, %low2, %product2_0 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>

