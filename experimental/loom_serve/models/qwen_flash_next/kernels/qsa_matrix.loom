        %values = vector.load %stage[%local_head, %stage_channel] : view<16x32xf32> -> vector<4xf32>
        func.call @qsa_cohort_output(%query, %output_head, %channel, %values, %gates, %output) : (index, index, index, vector<4xf32>, buffer, buffer)
      }
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)

    %sum2 = view.load %sums[%fragment2, %r] : view<3x16xf32> -> f32
    %nonzero2 = scalar.cmpf ogt, %sum2, %c0_f32 : f32
    %divisor2 = scf.select %nonzero2, %sum2, %c1_f32 : f32
    %denominator2 = vector.splat %divisor2 : vector<8xf32>

    %normalized2_0 = vector.divf %final2_0, %denominator2 : vector<8xf32>
    %output_fragment2_0 = vector.fragment<result> %normalized2_0 shape [%tile, %tile] : vector<8xf32>
    vector.fragment.store<result> %output_fragment2_0, %transposed[%half2_0, %c0] shape [%tile, %tile] : vector<8xf32>, view<32x16xf32, %stage_layout>

    %normalized2_1 = vector.divf %final2_1, %denominator2 : vector<8xf32>
    %output_fragment2_1 = vector.fragment<result> %normalized2_1 shape [%tile, %tile] : vector<8xf32>
    vector.fragment.store<result> %output_fragment2_1, %transposed[%half2_1, %c0] shape [%tile, %tile] : vector<8xf32>, view<32x16xf32, %stage_layout>

    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.for %round = [%c0 to %c4 step %c1] unroll {
      %local_head = index.madd %round, %c4, %stage_row : index
      %cohort_head = index.add %fragment_base2, %local_head : index
      %relative_query = index.div %cohort_head, %c12 : index
      %head_relative = index.rem %cohort_head, %c12 : index
      %output_head = index.add %head_base, %head_relative : index
      %live = index.cmp ult, %relative_query, %length : index
      scf.if %live {
        %query_value = index.add %begin, %relative_query : index
        %query = index.assume %query_value [range(%query_value, 0, 32767), lt(%query_value, %tokens)] : index
        %channel = index.add %channel_base, %stage_channel : index
        %values = vector.load %stage[%local_head, %stage_channel] : view<16x32xf32> -> vector<4xf32>
        func.call @qsa_cohort_output(%query, %output_head, %channel, %values, %gates, %output) : (index, index, index, vector<4xf32>, buffer, buffer)
      }
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  }
  kernel.return
}
