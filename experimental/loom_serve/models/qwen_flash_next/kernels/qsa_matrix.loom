      %product2_1 = vector.mma %value1, %high2, %scaled2_1 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
      %next2_1 = vector.mma %value1, %low2, %product2_1 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
      scf.yield %next_max, %next_sum, %next_descriptors, %next_physical, %next_key0, %next_key1, %next0_0, %next0_1, %next1_0, %next1_1, %next2_0, %next2_1 : f32, f32, vector<4xi32>, vector<4xi32>, vector<16xbf16>, vector<16xbf16>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
    }
    %publish_sum = scalar.andi %softmax_wave, %publisher : i1
    scf.if %publish_sum {
