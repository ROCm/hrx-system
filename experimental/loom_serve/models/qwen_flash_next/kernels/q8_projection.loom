config.decl @flash_next.token_count : %value: index where [range(%value, 1, 32768)]

amdgpu.target<gfx11-generic> @flash_next_q8_wave32 {subgroup_size = 32}

kernel.decl @flash_next_linear_q8(%configured_outputs: index) launch(%inputs: index, %outputs: index, %span: buffer, %input: buffer, %weight: buffer, %output: buffer)

template.decl @flash_next.q8_schedule(%capacity: index, %input_width: index, %output_width: index, %tile_rows: index, %tile_columns: index, %wave_rows: index, %wave_columns: index, %pipeline_depth: index, %span: buffer, %input: buffer, %weight: buffer, %output: buffer)

// The command caller supplies exact dimensions. The policy balances output
// reuse against the number of independent workgroups: narrow output grids need
// smaller tiles, while short reductions can afford more accumulators per wave.
// These values disappear into each materialized kernel and its launch config.
func.def public pure inline @flash_next_q8_geometry(%capacity: index, %inputs: index, %outputs: index) -> (i1, index, index, index, index) {
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %c128 = index.constant 128 : index
  %c256 = index.constant 256 : index
  %c512 = index.constant 512 : index
  %c1024 = index.constant 1024 : index
  %c2560 = index.constant 2560 : index
  %small_batch = index.cmp ult, %capacity, %c16 : index
  %few_columns = index.cmp ule, %outputs, %c512 : index
  %few_rows = index.cmp ult, %capacity, %c64 : index
  %small_grid = scalar.andi %few_columns, %few_rows : i1
  %use_dot = scalar.ori %small_batch, %small_grid : i1
  %yes = scalar.constant true : i1
  %use_matrix = scalar.xori %use_dot, %yes : i1
  %rows, %columns, %wave_rows, %wave_columns = scf.if %few_columns -> (index, index, index, index) {
    %large_batch = index.cmp uge, %capacity, %c512 : index
    %tile = scf.select %large_batch, %c64, %c32 : index
    %waves = scf.select %large_batch, %c4, %c2 : index
    scf.yield %tile, %tile, %waves, %c2 : index, index, index, index
  } else {
    %narrow = index.cmp ule, %outputs, %c2560 : index
    %rows, %columns, %wave_rows, %wave_columns = scf.if %narrow -> (index, index, index, index) {
      %short_k = index.cmp ule, %inputs, %c1024 : index
      %large_batch = index.cmp uge, %capacity, %c256 : index
      %wide_tile = scalar.andi %short_k, %large_batch : i1
      %tile = scf.select %wide_tile, %c128, %c64 : index
      scf.yield %tile, %tile, %c4, %c2 : index, index, index, index
    } else {
      %under32 = index.cmp ult, %capacity, %c32 : index
      %under64 = index.cmp ult, %capacity, %c64 : index
      %under128 = index.cmp ult, %capacity, %c128 : index
      %small_rows = scf.select %under32, %c16, %c32 : index
      %large_rows = scf.select %under128, %c64, %c128 : index
      %rows = scf.select %under64, %small_rows, %large_rows : index
      %columns = scf.select %under128, %c64, %c128 : index
      %small_wave_rows = scf.select %under32, %c1, %c2 : index
      %wave_rows = scf.select %under128, %small_wave_rows, %c4 : index
      %wave_columns = scf.select %under32, %c4, %c2 : index
      scf.yield %rows, %columns, %wave_rows, %wave_columns : index, index, index, index
    }
    scf.yield %rows, %columns, %wave_rows, %wave_columns : index, index, index, index
  }
  func.return %use_matrix, %rows, %columns, %wave_rows, %wave_columns : i1, index, index, index, index
}

// Fixed physical launch sizes keep workitem and subgroup bounds available
// in each device entry. Both entries instantiate the same schedule family.
kernel.def target(@flash_next_q8_wave32) @flash_next_q8_matrix_128(%capacity: index, %outputs: index, %tile_rows: index, %tile_columns: index) {
  %one = index.constant 1 : index
  %row_rounding = index.sub %tile_rows, %one : index
  %column_rounding = index.sub %tile_columns, %one : index
  %rounded_rows = index.add %capacity, %row_rounding : index
  %rounded_columns = index.add %outputs, %column_rounding : index
  %row_tiles = index.div %rounded_rows, %tile_rows : index
  %column_tiles = index.div %rounded_columns, %tile_columns : index
  %threads = index.constant 128 : index
  kernel.launch.config workgroups(%column_tiles, %row_tiles, %one) workgroup_size(%threads, %one, %one) : index
} launch(%inputs: index, %outputs: index, %tile_rows: index, %tile_columns: index, %wave_rows: index, %wave_columns: index, %depth: index, %span: buffer, %input: buffer, %weight: buffer, %output: buffer) {
  %capacity = config.get @flash_next.token_count : index
  template.apply<@flash_next.q8_schedule>(%capacity, %inputs, %outputs, %tile_rows, %tile_columns, %wave_rows, %wave_columns, %depth, %span, %input, %weight, %output) : (index, index, index, index, index, index, index, index, buffer, buffer, buffer, buffer)
  kernel.return
}

kernel.def target(@flash_next_q8_wave32) @flash_next_q8_matrix_256(%capacity: index, %outputs: index, %tile_rows: index, %tile_columns: index) {
  %one = index.constant 1 : index
  %row_rounding = index.sub %tile_rows, %one : index
  %column_rounding = index.sub %tile_columns, %one : index
  %rounded_rows = index.add %capacity, %row_rounding : index
  %rounded_columns = index.add %outputs, %column_rounding : index
  %row_tiles = index.div %rounded_rows, %tile_rows : index
  %column_tiles = index.div %rounded_columns, %tile_columns : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%column_tiles, %row_tiles, %one) workgroup_size(%threads, %one, %one) : index
} launch(%inputs: index, %outputs: index, %tile_rows: index, %tile_columns: index, %wave_rows: index, %wave_columns: index, %depth: index, %span: buffer, %input: buffer, %weight: buffer, %output: buffer) {
  %capacity = config.get @flash_next.token_count : index
  template.apply<@flash_next.q8_schedule>(%capacity, %inputs, %outputs, %tile_rows, %tile_columns, %wave_rows, %wave_columns, %depth, %span, %input, %weight, %output) : (index, index, index, index, index, index, index, index, buffer, buffer, buffer, buffer)
  kernel.return
}

template.decl @flash_next.project_dense_q8(%inputs: index, %outputs: index, %blocks: index, %span: buffer, %input: buffer, %weight: view<[%outputs]x[%blocks]x34xi8>, %output: buffer)

template.def<@flash_next.project_dense_q8> @flash_next_project_dense_q8(%inputs: index, %outputs: index, %blocks: index, %span: buffer, %input: buffer, %weight: view<[%outputs]x[%blocks]x34xi8>, %output: buffer) {
  %capacity = config.get @flash_next.token_count : index
  %matrix, %rows, %columns, %wave_rows, %wave_columns = func.call pure @flash_next_q8_geometry(%capacity, %inputs, %outputs) : (index, index, index) -> (i1, index, index, index, index)
  scf.if %matrix {
    %depth = index.constant 1 : index
    %wave_count = index.mul %wave_rows, %wave_columns : index
    %four = index.constant 4 : index
    %four_waves = index.cmp eq, %wave_count, %four : index
    scf.if %four_waves {
      kernel.launch @flash_next_q8_matrix_128[%capacity, %outputs, %rows, %columns](%inputs, %outputs, %rows, %columns, %wave_rows, %wave_columns, %depth, %span, %input, %weight, %output) : [index, index, index, index](index, index, index, index, index, index, index, buffer, buffer, view<[%outputs]x[%blocks]x34xi8>, buffer)
    } else {
      kernel.launch @flash_next_q8_matrix_256[%capacity, %outputs, %rows, %columns](%inputs, %outputs, %rows, %columns, %wave_rows, %wave_columns, %depth, %span, %input, %weight, %output) : [index, index, index, index](index, index, index, index, index, index, index, buffer, buffer, view<[%outputs]x[%blocks]x34xi8>, buffer)
    }
  } else {
    kernel.launch @flash_next_linear_q8[%outputs](%inputs, %outputs, %span, %input, %weight, %output) : [index](index, index, buffer, buffer, view<[%outputs]x[%blocks]x34xi8>, buffer)
  }
  template.return
}
