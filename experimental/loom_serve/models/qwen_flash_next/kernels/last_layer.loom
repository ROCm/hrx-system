config.decl @flash_next.token_count : %value: index where [range(%value, 1, 32768)]

config.decl @flash_next.span_capacity : %value: index where [range(%value, 1, 16)]

func.decl @flash_next_token_count(%epoch: buffer, %capacity: index) -> (index)

// The output-only caller has one selected tail row per ordinary span. Retain
// its original four-query cohort so attention visits the same union of keys
// in the same order. Full cache publication precedes this private descriptor.
// The original epoch remains immutable for sampling and scheduler feedback.
kernel.def @flash_next_finish_plan() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%epoch: buffer, %compact: buffer, %origins: buffer) {
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %four = index.constant 4 : index
  %origin = index.constant 0 : offset
  %header_bytes = index.constant 12 : offset
  %header = buffer.view %epoch[%origin] : buffer -> view<3xi32>
  %source = buffer.view %epoch[%header_bytes] : buffer -> view<16x5xi32>
  %target = buffer.view %compact[%header_bytes] : buffer -> view<16x5xi32>
  %indices = buffer.view %origins[%origin] : buffer -> view<64xi32>
  %span_word = view.load %header[1] : view<3xi32> -> i32
  %span_value = index.cast %span_word : i32 to index
  %spans = config.get @flash_next.span_capacity : index
  %count = index.assume %span_value [range(%span_value, 0, %spans)] : index
  %tokens = config.get @flash_next.token_count : index
  %mask = scalar.constant 1023 : i32
  %zero_word = scalar.constant 0 : i32
  %rows, %selected_spans = scf.for %span = [%zero to %count step %one](%cursor = %zero : index, %selected = %zero : index) -> (index, index) {
    %descriptor = view.load %source[%span, 4] : view<16x5xi32> -> i32
    %selection = scalar.andi %descriptor, %mask : i32
    %needed = scalar.cmpi ne, %selection, %zero_word : i32
    %next_cursor, %next_selected = scf.if %needed -> (index, index) {
      %length_word = view.load %source[%span, 0] : view<16x5xi32> -> i32
      %position_word = view.load %source[%span, 1] : view<16x5xi32> -> i32
      %begin_word = view.load %source[%span, 2] : view<16x5xi32> -> i32
      %row_word = view.load %source[%span, 3] : view<16x5xi32> -> i32
      %length_value = index.cast %length_word : i32 to index
      %length = index.assume %length_value [range(%length_value, 1, %tokens)] : index
      %remainder = index.rem %length, %four : index
      %partial = index.cmp ne, %remainder, %zero : index
      %retained = scf.select %partial, %remainder, %four : index
      %relative = index.sub %length, %retained : index
      %relative_word = index.cast %relative : index to i32
      %retained_word = index.cast %retained : index to i32
      %cursor_word = index.cast %cursor : index to i32
      %position = scalar.addi %position_word, %relative_word : i32
      %begin = scalar.addi %begin_word, %relative_word : i32
      %slot = index.assume %selected [range(%selected, 0, 15)] : index
      view.store %retained_word, %target[%slot, 0] : i32, view<16x5xi32>
      view.store %position, %target[%slot, 1] : i32, view<16x5xi32>
      view.store %cursor_word, %target[%slot, 2] : i32, view<16x5xi32>
      view.store %row_word, %target[%slot, 3] : i32, view<16x5xi32>
      view.store %descriptor, %target[%slot, 4] : i32, view<16x5xi32>
      scf.for %lane = [%zero to %retained step %one] {
        %lane_word = index.cast %lane : index to i32
        %original = scalar.addi %begin, %lane_word : i32
        %index_value = index.add %cursor, %lane : index
        %index = index.assume %index_value [range(%index_value, 0, 63)] : index
        view.store %original, %indices[%index] : i32, view<64xi32>
      }
      %end = index.add %cursor, %retained : index
      %after = index.add %selected, %one : index
      scf.yield %end, %after : index, index
    } else {
      scf.yield %cursor, %selected : index, index
    }
    scf.yield %next_cursor, %next_selected : index, index
  }
  %destination = buffer.view %compact[%origin] : buffer -> view<3xi32>
  %rows_word = index.cast %rows : index to i32
  %selected_word = index.cast %selected_spans : index to i32
  view.store %rows_word, %destination[0] : i32, view<3xi32>
  view.store %selected_word, %destination[1] : i32, view<3xi32>
  view.store %selected_word, %destination[2] : i32, view<3xi32>
  kernel.return
}

// Gather all retained source rows before publishing any compact prefix. The
// two launches make overlapping source/destination indices harmless without
// allocating another prompt-sized residual. All staging is bounded by 64 rows.
func.def inline @flash_next_finish_copy(%gather: i1, %epoch: buffer, %origins: buffer, %residual: buffer, %mixed: buffer, %injection: buffer, %staging: buffer) {
  %row = kernel.workgroup.id<x> : index
  %thread = kernel.workitem.id<x> : index
  %capacity = index.constant 64 : index
  %count = func.call @flash_next_token_count(%epoch, %capacity) : (buffer, index) -> (index)
  %active = index.cmp ult, %row, %count : index
  scf.if %active {
    %tokens = config.get @flash_next.token_count : index
    %zero = index.constant 0 : index
    %origin = index.constant 0 : offset
    %mixed_origin = index.constant 1310720 : offset
    %injection_origin = index.constant 1638400 : offset
    %indices = buffer.view %origins[%origin] : buffer -> view<64xi32>
    %original_word = view.load %indices[%row] : view<64xi32> -> i32
    %original_value = index.cast %original_word : i32 to index
    %original = index.assume %original_value [range(%original_value, 0, 32767), lt(%original_value, %tokens)] : index
    %live_row = scf.select %gather, %original, %row : index
    %residual_view = buffer.view %residual[%origin] : buffer -> view<[%tokens]x1280x8xbf16>
    %mixed_view = buffer.view %mixed[%origin] : buffer -> view<[%tokens]x320x8xbf16>
    %injection_view = buffer.view %injection[%origin] : buffer -> view<[%tokens]x4xf32>
    %residual_stage = buffer.view %staging[%origin] : buffer -> view<64x1280x8xbf16>
    %mixed_stage = buffer.view %staging[%mixed_origin] : buffer -> view<64x320x8xbf16>
    %injection_stage = buffer.view %staging[%injection_origin] : buffer -> view<64x4xf32>
    %threads = index.constant 128 : index
    %residual_chunks = index.constant 1280 : index
    scf.for %chunk = [%thread to %residual_chunks step %threads] {
      scf.if %gather {
        %value = vector.load %residual_view[%live_row, %chunk, %zero] : view<[%tokens]x1280x8xbf16> -> vector<8xbf16>
        vector.store %value, %residual_stage[%row, %chunk, %zero] : vector<8xbf16>, view<64x1280x8xbf16>
      } else {
        %value = vector.load %residual_stage[%row, %chunk, %zero] : view<64x1280x8xbf16> -> vector<8xbf16>
        vector.store %value, %residual_view[%live_row, %chunk, %zero] : vector<8xbf16>, view<[%tokens]x1280x8xbf16>
      }
    }
    %mixed_chunks = index.constant 320 : index
    scf.for %chunk = [%thread to %mixed_chunks step %threads] {
      scf.if %gather {
        %value = vector.load %mixed_view[%live_row, %chunk, %zero] : view<[%tokens]x320x8xbf16> -> vector<8xbf16>
        vector.store %value, %mixed_stage[%row, %chunk, %zero] : vector<8xbf16>, view<64x320x8xbf16>
      } else {
        %value = vector.load %mixed_stage[%row, %chunk, %zero] : view<64x320x8xbf16> -> vector<8xbf16>
        vector.store %value, %mixed_view[%live_row, %chunk, %zero] : vector<8xbf16>, view<[%tokens]x320x8xbf16>
      }
    }
    %leader = index.cmp eq, %thread, %zero : index
    scf.if %leader {
      scf.if %gather {
        %value = vector.load %injection_view[%live_row, %zero] : view<[%tokens]x4xf32> -> vector<4xf32>
        vector.store %value, %injection_stage[%row, %zero] : vector<4xf32>, view<64x4xf32>
      } else {
        %value = vector.load %injection_stage[%row, %zero] : view<64x4xf32> -> vector<4xf32>
        vector.store %value, %injection_view[%live_row, %zero] : vector<4xf32>, view<[%tokens]x4xf32>
      }
    }
  }
  func.return
}

kernel.def @flash_next_finish_gather() {
  %rows = index.constant 64 : index
  %threads = index.constant 128 : index
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%rows, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%epoch: buffer, %origins: buffer, %residual: buffer, %mixed: buffer, %injection: buffer, %staging: buffer) {
  %gather = scalar.constant true : i1
  func.call @flash_next_finish_copy(%gather, %epoch, %origins, %residual, %mixed, %injection, %staging) : (i1, buffer, buffer, buffer, buffer, buffer, buffer)
  kernel.return
}

kernel.def @flash_next_finish_publish() {
  %rows = index.constant 64 : index
  %threads = index.constant 128 : index
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%rows, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%epoch: buffer, %origins: buffer, %residual: buffer, %mixed: buffer, %injection: buffer, %staging: buffer) {
  %gather = scalar.constant false : i1
  func.call @flash_next_finish_copy(%gather, %epoch, %origins, %residual, %mixed, %injection, %staging) : (i1, buffer, buffer, buffer, buffer, buffer, buffer)
  kernel.return
}

// The finished compact source is distinct from the caller-owned residual.
// Restore original row indices so the ordinary output head remains unchanged.
kernel.def @flash_next_finish_scatter() {
  %rows = index.constant 64 : index
  %threads = index.constant 128 : index
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%rows, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%epoch: buffer, %origins: buffer, %input: buffer, %output: buffer) {
  %row = kernel.workgroup.id<x> : index
  %thread = kernel.workitem.id<x> : index
  %capacity = index.constant 64 : index
  %count = func.call @flash_next_token_count(%epoch, %capacity) : (buffer, index) -> (index)
  %active = index.cmp ult, %row, %count : index
  scf.if %active {
    %tokens = config.get @flash_next.token_count : index
    %zero = index.constant 0 : index
    %origin = index.constant 0 : offset
    %indices = buffer.view %origins[%origin] : buffer -> view<64xi32>
    %original_word = view.load %indices[%row] : view<64xi32> -> i32
    %original_value = index.cast %original_word : i32 to index
    %original = index.assume %original_value [range(%original_value, 0, 32767), lt(%original_value, %tokens)] : index
    %source = buffer.view %input[%origin] : buffer -> view<[%tokens]x1280x8xbf16>
    %target = buffer.view %output[%origin] : buffer -> view<[%tokens]x1280x8xbf16>
    %threads = index.constant 128 : index
    %chunks = index.constant 1280 : index
    scf.for %chunk = [%thread to %chunks step %threads] {
      %value = vector.load %source[%row, %chunk, %zero] : view<[%tokens]x1280x8xbf16> -> vector<8xbf16>
      vector.store %value, %target[%original, %chunk, %zero] : vector<8xbf16>, view<[%tokens]x1280x8xbf16>
    }
  }
  kernel.return
}
