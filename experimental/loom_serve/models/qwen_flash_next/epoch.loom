}

// Only this root promises selected outputs rather than all target hidden rows.
// MTP and direct full-hidden consumers continue using flash_next_epoch/body.
command.program.def public @flash_next_epoch_output_only() launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %rows: buffer, %state: buffer, %input_tokens: buffer, %output_tokens: buffer) {
  %outputs_only = scalar.constant true : i1
  command.program.launch @flash_next_body_select[%outputs_only](%parameters, %residual, %epoch, %rows, %state, %input_tokens, %residual) : [i1](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.program.launch @flash_next_output_head(%parameters, %epoch, %residual, %output_tokens) : (buffer, buffer, buffer, buffer)
  command.return
}
