      }
      scf.yield %output, %next_normalized, %next_injection, %next_down, %next_up, %next_quantized : buffer, buffer, buffer, view<3481600xi8>, view<3481600xi8>, buffer
    }
    scf.yield %finished, %finished_normalized, %finished_injection, %finished_down, %finished_up, %finished_quantized : buffer, buffer, buffer, view<3481600xi8>, view<3481600xi8>, buffer
  }
