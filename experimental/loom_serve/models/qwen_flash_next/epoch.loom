    command.program.launch @flash_next_hc_mix_quantized[%attention_down, %attention_up](%epoch, %input_normalized, %input_quantized, %attention_mixed) : [view<3481600xi8>, view<3481600xi8>](buffer, buffer, buffer, buffer)
    %is_last = index.cmp eq, %layer, %last_layer : index
    %finish = scalar.andi %outputs_only, %is_last : i1
    %finished, %finished_normalized, %finished_injection, %finished_down, %finished_up, %finished_quantized = scf.if %finish -> (buffer, buffer, buffer, view<3481600xi8>, view<3481600xi8>, buffer) {
      %ordinal = index.div %layer, %c4 : index
      %key_plane = index.mul %ordinal, %c2 : index
      %key_origin = index.scale %key_plane, %main_plane_bytes : index, offset -> offset
      %value_origin = index.add %key_origin, %main_plane_bytes : offset
      %index_relative = index.scale %ordinal, %index_plane_bytes : index, offset -> offset
      %index_origin = index.add %index_base, %index_relative : offset
      %tail_relative = index.scale %ordinal, %tail_stride : index, offset -> offset
      %tail_origin = index.add %tail_base, %tail_relative : offset
      command.program.launch @flash_next_finish_output[%layer, %key_origin, %value_origin, %index_origin, %tail_origin](%parameters, %epoch, %mapping, %rows, %state, %input, %attention_mixed, %attention_injection, %residual, %capture) : [index, offset, offset, offset, offset](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
      scf.yield %residual, %input_normalized, %attention_injection, %attention_down, %attention_up, %input_quantized : buffer, buffer, buffer, view<3481600xi8>, view<3481600xi8>, buffer
    } else {
      %projected = buffer.alloca<global> align(256) %hidden_bytes : buffer
      %ordinal = index.div %layer, %c4 : index
      %kind = index.rem %layer, %c4 : index
      %indexed = index.cmp eq, %kind, %c3 : index
      scf.if %indexed {
        %key_plane = index.mul %ordinal, %c2 : index
        %key_origin = index.scale %key_plane, %main_plane_bytes : index, offset -> offset
        %value_origin = index.add %key_origin, %main_plane_bytes : offset
        %index_relative = index.scale %ordinal, %index_plane_bytes : index, offset -> offset
        %index_origin = index.add %index_base, %index_relative : offset
        %tail_relative = index.scale %ordinal, %tail_stride : index, offset -> offset
        %tail_origin = index.add %tail_base, %tail_relative : offset
        command.program.launch @flash_next_qsa_attention[%layer, %key_origin, %value_origin, %index_origin, %tail_origin](%parameters, %epoch, %mapping, %rows, %attention_mixed, %state, %projected, %capture) : [index, offset, offset, offset, offset](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
      } else {
        %gdn_ordinal = index.sub %layer, %ordinal : index
        %state_origin = index.scale %gdn_ordinal, %gdn_stride : index, offset -> offset
        command.program.launch @flash_next_gdn_attention[%layer, %state_origin](%parameters, %epoch, %attention_mixed, %rows, %state, %projected, %capture) : [index, offset](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
      }
      %attention = buffer.alloca<global> align(256) %activation_bytes : buffer
      %ffn_normalized = buffer.alloca<global> align(256) %activation_bytes : buffer
      %ffn_quantized = buffer.alloca<global> align(256) %quantized_bytes : buffer
      %ffn_injection = buffer.alloca<global> align(256) %injection_bytes : buffer
      %ffn_gamma = command.parameter %parameters, "blk.{}.hc_ffn_norm.weight"[%layer] : view<4x2560xf32>
      %ffn_down = command.parameter %parameters, "blk.{}.hc_ffn_down.weight"[%layer] : view<3481600xi8>
      %ffn_up = command.parameter %parameters, "blk.{}.hc_ffn_up.weight"[%layer] : view<3481600xi8>
      %ffn_weight = command.parameter %parameters, "blk.{}.hc_ffn_inject.weight"[%layer] : view<4x10240xf32>
      %ffn_mixed = buffer.alloca<global> align(256) %hidden_bytes : buffer
      // The final mixer matches the selected-output finisher. Only
      // row liveness differs between the two model entry points.
      scf.if %is_last {
        kernel.launch @hc_combine_normalize_inject(%epoch, %input, %projected, %attention_injection, %ffn_gamma, %attention, %ffn_normalized, %ffn_weight, %ffn_injection) : (buffer, buffer, buffer, buffer, view<4x2560xf32>, buffer, buffer, view<4x10240xf32>, buffer)
        command.program.launch @flash_next_hc_mix_normalized[%ffn_down, %ffn_up](%epoch, %ffn_normalized, %ffn_mixed) : [view<3481600xi8>, view<3481600xi8>](buffer, buffer, buffer)
      } else {
        kernel.launch @hc_combine_normalize_inject_int8(%epoch, %input, %projected, %attention_injection, %ffn_gamma, %attention, %ffn_normalized, %ffn_weight, %ffn_injection, %ffn_quantized) : (buffer, buffer, buffer, buffer, view<4x2560xf32>, buffer, buffer, view<4x10240xf32>, buffer, buffer)
        command.program.launch @flash_next_hc_mix_quantized[%ffn_down, %ffn_up](%epoch, %ffn_normalized, %ffn_quantized, %ffn_mixed) : [view<3481600xi8>, view<3481600xi8>](buffer, buffer, buffer, buffer)
      }
      %ids = buffer.alloca<global> align(256) %selection_bytes : buffer
      %weights = buffer.alloca<global> align(256) %selection_bytes : buffer
      %shared_gate = buffer.alloca<global> align(256) %gate_bytes : buffer
      command.program.launch @flash_next_route[%layer](%parameters, %epoch, %ffn_mixed, %ids, %weights, %shared_gate) : [index](buffer, buffer, buffer, buffer, buffer, buffer)
      %branch = buffer.alloca<global> align(256) %hidden_bytes : buffer
      command.program.launch @flash_next_experts[%layer](%parameters, %epoch, %ffn_mixed, %ids, %weights, %shared_gate, %branch) : [index](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
      %last = index.cmp eq, %layer, %last_layer : index
      %output = scf.if %last -> (buffer) {
        scf.yield %residual : buffer
      } else {
        %temporary = buffer.alloca<global> align(256) %activation_bytes : buffer
        scf.yield %temporary : buffer
      }
      %before_ple = index.cmp eq, %layer, %c0 : index
      %separate = scalar.ori %before_ple, %last : i1
      %next_normalized, %next_injection, %next_down, %next_up, %next_quantized = scf.if %separate -> (buffer, buffer, view<3481600xi8>, view<3481600xi8>, buffer) {
        kernel.launch @hc_combine(%epoch, %attention, %branch, %ffn_injection, %output) : (buffer, buffer, buffer, buffer, buffer)
        // PLE replaces this value before use; the final head gathers its own
        // rows. Neither boundary consumes an early normalized publication.
        scf.yield %input_normalized, %attention_injection, %attention_down, %attention_up, %input_quantized : buffer, buffer, view<3481600xi8>, view<3481600xi8>, buffer
      } else {
        %next_layer = index.add %layer, %c1 : index
        %next_gamma = command.parameter %parameters, "blk.{}.hc_attn_norm.weight"[%next_layer] : view<4x2560xf32>
        %next = buffer.alloca<global> align(256) %activation_bytes : buffer
        %quantized = buffer.alloca<global> align(256) %quantized_bytes : buffer
        %injection = buffer.alloca<global> align(256) %injection_bytes : buffer
        %down_weight = command.parameter %parameters, "blk.{}.hc_attn_down.weight"[%next_layer] : view<3481600xi8>
        %up_weight = command.parameter %parameters, "blk.{}.hc_attn_up.weight"[%next_layer] : view<3481600xi8>
        %next_weight = command.parameter %parameters, "blk.{}.hc_attn_inject.weight"[%next_layer] : view<4x10240xf32>
        kernel.launch @hc_combine_normalize_inject_int8(%epoch, %attention, %branch, %ffn_injection, %next_gamma, %output, %next, %next_weight, %injection, %quantized) : (buffer, buffer, buffer, buffer, view<4x2560xf32>, buffer, buffer, view<4x10240xf32>, buffer, buffer)
