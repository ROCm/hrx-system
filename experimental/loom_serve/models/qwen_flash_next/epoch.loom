      scf.yield %output, %next_normalized, %next_injection, %next_down, %next_up : buffer, buffer, buffer, view<3481600xi8>, view<3481600xi8>
    }
    scf.yield %finished, %finished_normalized, %finished_injection, %finished_down, %finished_up : buffer, buffer, buffer, view<3481600xi8>, view<3481600xi8>
  }
  command.return
}

kernel.decl @hc_normalize_inject_int8() launch(%span: buffer, %residual: buffer, %gamma: buffer, %normalized: buffer, %weight: buffer, %injection: buffer, %quantized: buffer)
kernel.decl @hc_combine_normalize_inject_int8() launch(%span: buffer, %residual: buffer, %projected: buffer, %injection: buffer, %gamma: buffer, %output: buffer, %normalized: buffer, %weight: buffer, %next_injection: buffer, %quantized: buffer)
command.program.decl @flash_next_hc_mix_quantized(%down_weight: view<3481600xi8>, %up_weight: view<3481600xi8>) launch(%span: buffer, %normalized: buffer, %quantized: buffer, %mixed: buffer)

command.program.def public @flash_next_body_quant_injection(%outputs_only: i1) launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %rows: buffer, %state: buffer, %input_tokens: buffer, %capture: buffer) {
  %tokens = config.get @flash_next.token_count : index
  %record_rows = index.constant 16 : index
  %record_rounding = index.constant 15 : index
  %record_bytes = index.constant 184320 : offset
  %padded_rows = index.add %tokens, %record_rounding : index
  %records = index.div %padded_rows, %record_rows : index
  %quantized_bytes = index.scale %records, %record_bytes : index, offset -> offset
  %pool = config.get @flash_next.pool_capacity : index
  %row_bytes = index.constant 20480 : offset
  %hidden_row_bytes = index.constant 5120 : offset
  %injection_row_bytes = index.constant 16 : offset
  %selection_row_bytes = index.constant 40 : offset
  %gate_row_bytes = index.constant 4 : offset
  %activation_bytes = index.scale %tokens, %row_bytes : index, offset -> offset
  %hidden_bytes = index.scale %tokens, %hidden_row_bytes : index, offset -> offset
  %injection_bytes = index.scale %tokens, %injection_row_bytes : index, offset -> offset
  %selection_bytes = index.scale %tokens, %selection_row_bytes : index, offset -> offset
  %gate_bytes = index.scale %tokens, %gate_row_bytes : index, offset -> offset
  %mapping_stride = index.constant 16 : offset
  %mapping_bytes = index.scale %tokens, %mapping_stride : index, offset -> offset
  %mapping = buffer.alloca<global> align(16) %mapping_bytes : buffer
  kernel.launch @flash_next_map_tokens(%epoch, %mapping) : (buffer, buffer)
  %embedding = command.parameter %parameters, "token_embd.weight" : view<675430400xi8>
  kernel.launch @flash_next_embedding_q8_0(%epoch, %input_tokens, %embedding, %residual) : (buffer, buffer, view<675430400xi8>, buffer)
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %last_layer = index.constant 47 : index
  %layers = index.constant 48 : index
  %main_planes = index.constant 24 : index
  %gdn_stride = index.constant 3207168 : offset
  %main_token_stride = index.constant 1024 : offset
  %index_token_stride = index.constant 64 : offset
  %main_plane_bytes = index.scale %pool, %main_token_stride : index, offset -> offset
  %index_plane_bytes = index.scale %pool, %index_token_stride : index, offset -> offset
  %index_base = index.scale %main_planes, %main_plane_bytes : index, offset -> offset
  %token_history = index.constant 115458048 : offset
  %conv_history = index.constant 115458304 : offset
  %tail_base = index.constant 115642624 : offset
  %tail_stride = index.constant 768 : offset
  %initial_normalized = buffer.alloca<global> align(256) %activation_bytes : buffer
  %initial_quantized = buffer.alloca<global> align(256) %quantized_bytes : buffer
  %initial_injection = buffer.alloca<global> align(256) %injection_bytes : buffer
  %initial_gamma = command.parameter %parameters, "blk.{}.hc_attn_norm.weight"[%c0] : view<4x2560xf32>
  %initial_down = command.parameter %parameters, "blk.{}.hc_attn_down.weight"[%c0] : view<3481600xi8>
  %initial_up = command.parameter %parameters, "blk.{}.hc_attn_up.weight"[%c0] : view<3481600xi8>
  %initial_weight = command.parameter %parameters, "blk.{}.hc_attn_inject.weight"[%c0] : view<4x10240xf32>
  kernel.launch @hc_normalize_inject_int8(%epoch, %residual, %initial_gamma, %initial_normalized, %initial_weight, %initial_injection, %initial_quantized) : (buffer, buffer, view<4x2560xf32>, buffer, view<4x10240xf32>, buffer, buffer)
  %final, %final_normalized, %final_injection, %final_down, %final_up, %final_quantized = scf.for %layer = [%c0 to %layers step %c1](%current = %residual : buffer, %current_normalized = %initial_normalized : buffer, %current_injection = %initial_injection : buffer, %current_down = %initial_down : view<3481600xi8>, %current_up = %initial_up : view<3481600xi8>, %current_quantized = %initial_quantized : buffer) -> (buffer, buffer, buffer, view<3481600xi8>, view<3481600xi8>, buffer) unroll {
    %has_ple = index.cmp eq, %layer, %c1 : index
    %input, %input_normalized, %attention_injection, %attention_down, %attention_up, %input_quantized = scf.if %has_ple -> (buffer, buffer, buffer, view<3481600xi8>, view<3481600xi8>, buffer) {
      %ple = buffer.alloca<global> align(256) %activation_bytes : buffer
      command.program.launch @flash_next_ple_residual[%layer, %token_history, %conv_history](%parameters, %epoch, %mapping, %rows, %input_tokens, %current, %state, %ple, %capture) : [index, offset, offset](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
      %ple_normalized = buffer.alloca<global> align(256) %activation_bytes : buffer
      %ple_quantized = buffer.alloca<global> align(256) %quantized_bytes : buffer
      %ple_injection = buffer.alloca<global> align(256) %injection_bytes : buffer
      %ple_gamma = command.parameter %parameters, "blk.{}.hc_attn_norm.weight"[%layer] : view<4x2560xf32>
      %ple_down = command.parameter %parameters, "blk.{}.hc_attn_down.weight"[%layer] : view<3481600xi8>
      %ple_up = command.parameter %parameters, "blk.{}.hc_attn_up.weight"[%layer] : view<3481600xi8>
      %ple_weight = command.parameter %parameters, "blk.{}.hc_attn_inject.weight"[%layer] : view<4x10240xf32>
      kernel.launch @hc_normalize_inject_int8(%epoch, %ple, %ple_gamma, %ple_normalized, %ple_weight, %ple_injection, %ple_quantized) : (buffer, buffer, view<4x2560xf32>, buffer, view<4x10240xf32>, buffer, buffer)
      scf.yield %ple, %ple_normalized, %ple_injection, %ple_down, %ple_up, %ple_quantized : buffer, buffer, buffer, view<3481600xi8>, view<3481600xi8>, buffer
    } else {
      scf.yield %current, %current_normalized, %current_injection, %current_down, %current_up, %current_quantized : buffer, buffer, buffer, view<3481600xi8>, view<3481600xi8>, buffer
    }
