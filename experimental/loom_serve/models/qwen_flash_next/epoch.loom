config.decl @flash_next.token_count : %value: index where [range(%value, 1, 32768)]

config.decl @flash_next.pool_capacity : %value: index where [range(%value, 64, 4194304), multiple_of(%value, 64)]

kernel.decl @flash_next_map_tokens() launch(%epoch: buffer, %mapping: buffer)

kernel.decl @flash_next_embedding_q8_0() launch(%epoch: buffer, %ids: buffer, %weight: buffer, %residual: buffer)

command.program.decl @flash_next_ple_residual(%layer: index, %token_history_origin: offset, %convolution_history_origin: offset) launch(%parameters: buffer, %span: buffer, %mapping: buffer, %origins: buffer, %tokens: buffer, %residual: buffer, %arena: buffer, %output: buffer)

command.program.decl @flash_next_qsa_residual(%layer: index, %key_origin: offset, %value_origin: offset, %index_origin: offset, %tail_origin: offset) launch(%parameters: buffer, %span: buffer, %mapping: buffer, %residual: buffer, %rows: buffer, %arena: buffer, %output: buffer)

command.program.decl @flash_next_ffn_residual(%layer: index) launch(%parameters: buffer, %span: buffer, %residual: buffer, %output: buffer)

command.program.decl @flash_next_gdn_layer(%layer: index, %state_origin: offset) launch(%parameters: buffer, %span: buffer, %residual: buffer, %rows: buffer, %arena: buffer, %output: buffer)

command.program.decl @flash_next_output_head() launch(%parameters: buffer, %epoch: buffer, %residual: buffer, %outputs: buffer)

// All layer decisions are cold specialization. Runtime packets contain only
// active tokens, span ownership, physical page IDs, and recurrent frontiers.
command.program.def public @flash_next_epoch() launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %rows: buffer, %state: buffer, %input_tokens: buffer, %output_tokens: buffer) {
  %tokens = config.get @flash_next.token_count : index
  %pool = config.get @flash_next.pool_capacity : index
  %row_bytes = index.constant 20480 : offset
  %activation_bytes = index.scale %tokens, %row_bytes : index, offset -> offset
  %mapping_stride = index.constant 16 : offset
  %mapping_bytes = index.scale %tokens, %mapping_stride : index, offset -> offset
  %mapping = buffer.alloca<global> align(16) %mapping_bytes : buffer
  kernel.launch @flash_next_map_tokens(%epoch, %mapping) : (buffer, buffer)
  %embedding = command.parameter %parameters, "token_embd.weight" : view<675430400xi8>
  kernel.launch @flash_next_embedding_q8_0(%epoch, %input_tokens, %embedding, %residual) : (buffer, buffer, view<675430400xi8>, buffer)
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %layers = index.constant 48 : index
  %main_planes = index.constant 24 : index
  %gdn_stride = index.constant 3207168 : offset
  %main_token_stride = index.constant 1024 : offset
  %index_token_stride = index.constant 64 : offset
  %main_plane_bytes = index.scale %pool, %main_token_stride : index, offset -> offset
  %index_plane_bytes = index.scale %pool, %index_token_stride : index, offset -> offset
  %index_base = index.scale %main_planes, %main_plane_bytes : index, offset -> offset
  // Recurrent slot: 36 GDN states, aligned token IDs, nine PLE vectors,
  // and twelve three-vector indexer tails. prepare.loom exposes this same
  // slot as one independently retained scheduler object.
  %token_history = index.constant 115458048 : offset
  %conv_history = index.constant 115458304 : offset
  %tail_base = index.constant 115642624 : offset
  %tail_stride = index.constant 768 : offset
  %final = scf.for %layer = [%c0 to %layers step %c1](%current = %residual : buffer) -> (buffer) unroll {
    %has_ple = index.cmp eq, %layer, %c1 : index
    %input = scf.if %has_ple -> (buffer) {
      %ple = buffer.alloca<global> align(256) %activation_bytes : buffer
      command.program.launch @flash_next_ple_residual[%layer, %token_history, %conv_history](%parameters, %epoch, %mapping, %rows, %input_tokens, %current, %state, %ple) : [index, offset, offset](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
      scf.yield %ple : buffer
    } else {
      scf.yield %current : buffer
    }
    %output = buffer.alloca<global> align(256) %activation_bytes : buffer
    %ordinal = index.div %layer, %c4 : index
    %kind = index.rem %layer, %c4 : index
    %indexed = index.cmp eq, %kind, %c3 : index
    scf.if %indexed {
      %key_plane = index.mul %ordinal, %c2 : index
      %key_origin = index.scale %key_plane, %main_plane_bytes : index, offset -> offset
      %value_origin = index.add %key_origin, %main_plane_bytes : offset
      %index_relative = index.scale %ordinal, %index_plane_bytes : index, offset -> offset
      %index_origin = index.add %index_base, %index_relative : offset
      %tail_relative = index.scale %ordinal, %tail_stride : index, offset -> offset
      %tail_origin = index.add %tail_base, %tail_relative : offset
      %attention = buffer.alloca<global> align(256) %activation_bytes : buffer
      command.program.launch @flash_next_qsa_residual[%layer, %key_origin, %value_origin, %index_origin, %tail_origin](%parameters, %epoch, %mapping, %input, %rows, %state, %attention) : [index, offset, offset, offset, offset](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
      command.program.launch @flash_next_ffn_residual[%layer](%parameters, %epoch, %attention, %output) : [index](buffer, buffer, buffer, buffer)
    } else {
      %gdn_ordinal = index.sub %layer, %ordinal : index
      %state_origin = index.scale %gdn_ordinal, %gdn_stride : index, offset -> offset
      command.program.launch @flash_next_gdn_layer[%layer, %state_origin](%parameters, %epoch, %input, %rows, %state, %output) : [index, offset](buffer, buffer, buffer, buffer, buffer, buffer)
    }
    scf.yield %output : buffer
  }
  command.program.launch @flash_next_output_head(%parameters, %epoch, %final, %output_tokens) : (buffer, buffer, buffer, buffer)
  command.return
}
