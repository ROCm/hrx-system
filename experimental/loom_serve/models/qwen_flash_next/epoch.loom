// Every publication starts at its producer and ends at its last consumer.
// Distinct SSA roots let the transient planner reuse their storage between
// mixers, attention, and expert stages without retaining one live buffer.
command.program.def public @flash_next_body_normalized() launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %rows: buffer, %state: buffer, %input_tokens: buffer, %capture: buffer) {
  %tokens = config.get @flash_next.token_count : index
  %pool = config.get @flash_next.pool_capacity : index
  %row_bytes = index.constant 20480 : offset
  %hidden_row_bytes = index.constant 5120 : offset
  %injection_row_bytes = index.constant 16 : offset
  %selection_row_bytes = index.constant 40 : offset
  %gate_row_bytes = index.constant 4 : offset
  %activation_bytes = index.scale %tokens, %row_bytes : index, offset -> offset
  %hidden_bytes = index.scale %tokens, %hidden_row_bytes : index, offset -> offset
  %injection_bytes = index.scale %tokens, %injection_row_bytes : index, offset -> offset
  %selection_bytes = index.scale %tokens, %selection_row_bytes : index, offset -> offset
  %gate_bytes = index.scale %tokens, %gate_row_bytes : index, offset -> offset
  %mapping_stride = index.constant 16 : offset
  %mapping_bytes = index.scale %tokens, %mapping_stride : index, offset -> offset
  %mapping = buffer.alloca<global> align(16) %mapping_bytes : buffer
  kernel.launch @flash_next_map_tokens(%epoch, %mapping) : (buffer, buffer)
  %embedding = command.parameter %parameters, "token_embd.weight" : view<675430400xi8>
  kernel.launch @flash_next_embedding_q8_0(%epoch, %input_tokens, %embedding, %residual) : (buffer, buffer, view<675430400xi8>, buffer)
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %last_layer = index.constant 47 : index
  %layers = index.constant 48 : index
  %main_planes = index.constant 24 : index
  %gdn_stride = index.constant 3207168 : offset
  %main_token_stride = index.constant 1024 : offset
  %index_token_stride = index.constant 64 : offset
  %main_plane_bytes = index.scale %pool, %main_token_stride : index, offset -> offset
  %index_plane_bytes = index.scale %pool, %index_token_stride : index, offset -> offset
  %index_base = index.scale %main_planes, %main_plane_bytes : index, offset -> offset
  %token_history = index.constant 115458048 : offset
  %conv_history = index.constant 115458304 : offset
  %tail_base = index.constant 115642624 : offset
  %tail_stride = index.constant 768 : offset
  %initial_normalized = buffer.alloca<global> align(256) %activation_bytes : buffer
  %initial_gamma = command.parameter %parameters, "blk.{}.hc_attn_norm.weight"[%c0] : view<4x2560xf32>
  kernel.launch @hc_normalize(%epoch, %residual, %initial_gamma, %initial_normalized) : (buffer, buffer, view<4x2560xf32>, buffer)
  %final, %final_normalized = scf.for %layer = [%c0 to %layers step %c1](%current = %residual : buffer, %current_normalized = %initial_normalized : buffer) -> (buffer, buffer) unroll {
    %has_ple = index.cmp eq, %layer, %c1 : index
    %input, %input_normalized = scf.if %has_ple -> (buffer, buffer) {
      %ple = buffer.alloca<global> align(256) %activation_bytes : buffer
      command.program.launch @flash_next_ple_residual[%layer, %token_history, %conv_history](%parameters, %epoch, %mapping, %rows, %input_tokens, %current, %state, %ple, %capture) : [index, offset, offset](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
      %ple_normalized = buffer.alloca<global> align(256) %activation_bytes : buffer
      %ple_gamma = command.parameter %parameters, "blk.{}.hc_attn_norm.weight"[%layer] : view<4x2560xf32>
      kernel.launch @hc_normalize(%epoch, %ple, %ple_gamma, %ple_normalized) : (buffer, buffer, view<4x2560xf32>, buffer)
      scf.yield %ple, %ple_normalized : buffer, buffer
    } else {
      scf.yield %current, %current_normalized : buffer, buffer
    }
    %attention_mixed = buffer.alloca<global> align(256) %hidden_bytes : buffer
    %attention_injection = buffer.alloca<global> align(256) %injection_bytes : buffer
    command.program.launch @flash_next_hc_attn_normalized[%layer](%parameters, %epoch, %input_normalized, %attention_injection, %attention_mixed) : [index](buffer, buffer, buffer, buffer, buffer)
    %projected = buffer.alloca<global> align(256) %hidden_bytes : buffer
    %ordinal = index.div %layer, %c4 : index
    %kind = index.rem %layer, %c4 : index
    %indexed = index.cmp eq, %kind, %c3 : index
    scf.if %indexed {
      %key_plane = index.mul %ordinal, %c2 : index
      %key_origin = index.scale %key_plane, %main_plane_bytes : index, offset -> offset
      %value_origin = index.add %key_origin, %main_plane_bytes : offset
      %index_relative = index.scale %ordinal, %index_plane_bytes : index, offset -> offset
      %index_origin = index.add %index_base, %index_relative : offset
      %tail_relative = index.scale %ordinal, %tail_stride : index, offset -> offset
      %tail_origin = index.add %tail_base, %tail_relative : offset
      command.program.launch @flash_next_qsa_attention[%layer, %key_origin, %value_origin, %index_origin, %tail_origin](%parameters, %epoch, %mapping, %rows, %attention_mixed, %state, %projected, %capture) : [index, offset, offset, offset, offset](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
    } else {
      %gdn_ordinal = index.sub %layer, %ordinal : index
      %state_origin = index.scale %gdn_ordinal, %gdn_stride : index, offset -> offset
      command.program.launch @flash_next_gdn_attention[%layer, %state_origin](%parameters, %epoch, %attention_mixed, %rows, %state, %projected, %capture) : [index, offset](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
    }
    %attention = buffer.alloca<global> align(256) %activation_bytes : buffer
    %ffn_normalized = buffer.alloca<global> align(256) %activation_bytes : buffer
    %ffn_gamma = command.parameter %parameters, "blk.{}.hc_ffn_norm.weight"[%layer] : view<4x2560xf32>
    kernel.launch @hc_combine_normalize(%epoch, %input, %projected, %attention_injection, %ffn_gamma, %attention, %ffn_normalized) : (buffer, buffer, buffer, buffer, view<4x2560xf32>, buffer, buffer)
    %ffn_mixed = buffer.alloca<global> align(256) %hidden_bytes : buffer
    %ffn_injection = buffer.alloca<global> align(256) %injection_bytes : buffer
    command.program.launch @flash_next_hc_ffn_normalized[%layer](%parameters, %epoch, %ffn_normalized, %ffn_injection, %ffn_mixed) : [index](buffer, buffer, buffer, buffer, buffer)
    %ids = buffer.alloca<global> align(256) %selection_bytes : buffer
    %weights = buffer.alloca<global> align(256) %selection_bytes : buffer
    %shared_gate = buffer.alloca<global> align(256) %gate_bytes : buffer
    command.program.launch @flash_next_route[%layer](%parameters, %epoch, %ffn_mixed, %ids, %weights, %shared_gate) : [index](buffer, buffer, buffer, buffer, buffer, buffer)
    %branch = buffer.alloca<global> align(256) %hidden_bytes : buffer
    command.program.launch @flash_next_experts[%layer](%parameters, %epoch, %ffn_mixed, %ids, %weights, %shared_gate, %branch) : [index](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
    %last = index.cmp eq, %layer, %last_layer : index
    %output = scf.if %last -> (buffer) {
      scf.yield %residual : buffer
    } else {
      %temporary = buffer.alloca<global> align(256) %activation_bytes : buffer
      scf.yield %temporary : buffer
    }
    %before_ple = index.cmp eq, %layer, %c0 : index
    %separate = scalar.ori %before_ple, %last : i1
    %next_normalized = scf.if %separate -> (buffer) {
      kernel.launch @hc_combine(%epoch, %attention, %branch, %ffn_injection, %output) : (buffer, buffer, buffer, buffer, buffer)
      // PLE replaces this value before use; the final head gathers its own
      // rows. Neither boundary consumes an early normalized publication.
      scf.yield %input_normalized : buffer
    } else {
      %next_layer = index.add %layer, %c1 : index
      %next_gamma = command.parameter %parameters, "blk.{}.hc_attn_norm.weight"[%next_layer] : view<4x2560xf32>
      %next = buffer.alloca<global> align(256) %activation_bytes : buffer
      kernel.launch @hc_combine_normalize(%epoch, %attention, %branch, %ffn_injection, %next_gamma, %output, %next) : (buffer, buffer, buffer, buffer, view<4x2560xf32>, buffer, buffer)
      scf.yield %next : buffer
    }
    scf.yield %output, %next_normalized : buffer, buffer
  }
  command.return
}

command.program.def public @flash_next_body() launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %rows: buffer, %state: buffer, %input_tokens: buffer, %capture: buffer) {
  %outputs_only = scalar.constant false : i1
  command.program.launch @flash_next_body_select[%outputs_only](%parameters, %residual, %epoch, %rows, %state, %input_tokens, %capture) : [i1](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}

command.program.def public @flash_next_body_select(%outputs_only: i1) launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %rows: buffer, %state: buffer, %input_tokens: buffer, %capture: buffer) {
  %tokens = config.get @flash_next.token_count : index
  %threshold = index.constant 128 : index
  %wide = index.cmp uge, %tokens, %threshold : index
  scf.if %wide {
    %fusion_threshold = index.constant 2048 : index
    %fused = index.cmp uge, %tokens, %fusion_threshold : index
    scf.if %fused {
      %quantized_capacity = index.constant 2048 : index
      %use_quantized = index.cmp eq, %tokens, %quantized_capacity : index
      scf.if %use_quantized {
        command.program.launch @flash_next_body_quant_injection[%outputs_only](%parameters, %residual, %epoch, %rows, %state, %input_tokens, %capture) : [i1](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
      } else {
        command.program.launch @flash_next_body_injection_fused[%outputs_only](%parameters, %residual, %epoch, %rows, %state, %input_tokens, %capture) : [i1](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
      }
    } else {
      command.program.launch @flash_next_body_normalized(%parameters, %residual, %epoch, %rows, %state, %input_tokens, %capture) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer)
    }
  } else {
    command.program.launch @flash_next_body_unfused(%parameters, %residual, %epoch, %rows, %state, %input_tokens, %capture) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  }
  command.return
}

