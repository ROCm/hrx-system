  %mapping = buffer.alloca<global> align(16) %mapping_bytes : buffer
  kernel.launch @flash_next_map_tokens(%epoch, %mapping) : (buffer, buffer)
  %embedding = command.parameter %parameters, "token_embd.weight" : view<675430400xi8>
  kernel.launch @flash_next_embedding_q8_0(%epoch, %input_tokens, %embedding, %residual) : (buffer, buffer, view<675430400xi8>, buffer)
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %last_layer = index.constant 47 : index
  %layers = index.constant 48 : index
  %main_planes = index.constant 24 : index
  %gdn_stride = index.constant 3207168 : offset
  %main_token_stride = index.constant 1024 : offset
  %index_token_stride = index.constant 64 : offset
  %main_plane_bytes = index.scale %pool, %main_token_stride : index, offset -> offset
  %index_plane_bytes = index.scale %pool, %index_token_stride : index, offset -> offset
  %index_base = index.scale %main_planes, %main_plane_bytes : index, offset -> offset
  %token_history = index.constant 115458048 : offset
  %conv_history = index.constant 115458304 : offset
  %tail_base = index.constant 115642624 : offset
  %tail_stride = index.constant 768 : offset
  %initial_normalized = buffer.alloca<global> align(256) %activation_bytes : buffer
  %initial_injection = buffer.alloca<global> align(256) %injection_bytes : buffer
  %initial_gamma = command.parameter %parameters, "blk.{}.hc_attn_norm.weight"[%c0] : view<4x2560xf32>
  %initial_down = command.parameter %parameters, "blk.{}.hc_attn_down.weight"[%c0] : view<3481600xi8>
  %initial_up = command.parameter %parameters, "blk.{}.hc_attn_up.weight"[%c0] : view<3481600xi8>
  %initial_weight = command.parameter %parameters, "blk.{}.hc_attn_inject.weight"[%c0] : view<4x10240xf32>
  kernel.launch @hc_normalize_inject(%epoch, %residual, %initial_gamma, %initial_normalized, %initial_weight, %initial_injection) : (buffer, buffer, view<4x2560xf32>, buffer, view<4x10240xf32>, buffer)
  %final, %final_normalized, %final_injection, %final_down, %final_up = scf.for %layer = [%c0 to %layers step %c1](%current = %residual : buffer, %current_normalized = %initial_normalized : buffer, %current_injection = %initial_injection : buffer, %current_down = %initial_down : view<3481600xi8>, %current_up = %initial_up : view<3481600xi8>) -> (buffer, buffer, buffer, view<3481600xi8>, view<3481600xi8>) unroll {
    %has_ple = index.cmp eq, %layer, %c1 : index
    %input, %input_normalized, %attention_injection, %attention_down, %attention_up = scf.if %has_ple -> (buffer, buffer, buffer, view<3481600xi8>, view<3481600xi8>) {
      %ple = buffer.alloca<global> align(256) %activation_bytes : buffer
      command.program.launch @flash_next_ple_residual[%layer, %token_history, %conv_history](%parameters, %epoch, %mapping, %rows, %input_tokens, %current, %state, %ple, %capture) : [index, offset, offset](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
      %ple_normalized = buffer.alloca<global> align(256) %activation_bytes : buffer
      %ple_injection = buffer.alloca<global> align(256) %injection_bytes : buffer
      %ple_gamma = command.parameter %parameters, "blk.{}.hc_attn_norm.weight"[%layer] : view<4x2560xf32>
      %ple_down = command.parameter %parameters, "blk.{}.hc_attn_down.weight"[%layer] : view<3481600xi8>
      %ple_up = command.parameter %parameters, "blk.{}.hc_attn_up.weight"[%layer] : view<3481600xi8>
      %ple_weight = command.parameter %parameters, "blk.{}.hc_attn_inject.weight"[%layer] : view<4x10240xf32>
      kernel.launch @hc_normalize_inject(%epoch, %ple, %ple_gamma, %ple_normalized, %ple_weight, %ple_injection) : (buffer, buffer, view<4x2560xf32>, buffer, view<4x10240xf32>, buffer)
      scf.yield %ple, %ple_normalized, %ple_injection, %ple_down, %ple_up : buffer, buffer, buffer, view<3481600xi8>, view<3481600xi8>
    } else {
      scf.yield %current, %current_normalized, %current_injection, %current_down, %current_up : buffer, buffer, buffer, view<3481600xi8>, view<3481600xi8>
    }
    %attention_mixed = buffer.alloca<global> align(256) %hidden_bytes : buffer
    command.program.launch @flash_next_hc_mix_normalized[%attention_down, %attention_up](%epoch, %input_normalized, %attention_mixed) : [view<3481600xi8>, view<3481600xi8>](buffer, buffer, buffer)
    %is_last = index.cmp eq, %layer, %last_layer : index
    %finish = scalar.andi %outputs_only, %is_last : i1
    %finished, %finished_normalized, %finished_injection, %finished_down, %finished_up = scf.if %finish -> (buffer, buffer, buffer, view<3481600xi8>, view<3481600xi8>) {
      %ordinal = index.div %layer, %c4 : index
      %key_plane = index.mul %ordinal, %c2 : index
      %key_origin = index.scale %key_plane, %main_plane_bytes : index, offset -> offset
      %value_origin = index.add %key_origin, %main_plane_bytes : offset
      %index_relative = index.scale %ordinal, %index_plane_bytes : index, offset -> offset
      %index_origin = index.add %index_base, %index_relative : offset
      %tail_relative = index.scale %ordinal, %tail_stride : index, offset -> offset
      %tail_origin = index.add %tail_base, %tail_relative : offset
