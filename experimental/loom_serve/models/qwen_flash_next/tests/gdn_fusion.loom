kernel.decl @flash_next_prepare_qkv_channels(%output_width: index) launch(%weight: buffer)

kernel.decl @gdn_fused_projection() launch(%epoch: buffer, %input: buffer, %weight: buffer, %conv: buffer, %halo: buffer, %output: buffer, %norm: buffer, %capture: buffer, %capture_origin: offset)

kernel.decl @gdn_fused_boundary() launch(%epoch: buffer, %rows: buffer, %history_origin: offset, %halo: buffer, %weight: buffer, %arena: buffer, %output: buffer, %norm: buffer)

kernel.decl @gdn_convolve() launch(%epoch: buffer, %rows: buffer, %history_origin: offset, %qkv: buffer, %weight: buffer, %arena: buffer, %output: buffer, %norm: buffer)

// Packed lengths 125/1/2/3/121/8 exercise both sides of tile boundaries 128
// and 256. Rows zero/four start fresh, row two reads its advancing writer,
// and rows one/three share an immutable anchor. Only the last span speculates.
kernel.def @packed_sessions() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%count: index, %epoch: buffer, %rows: buffer) {
  %origin = index.constant 0 : offset
  %descriptor_origin = index.constant 12 : offset
  %mode_origin = index.constant 1804 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c6 = index.constant 6 : index
  %c8 = index.constant 8 : index
  %c121 = index.constant 121 : index
  %c125 = index.constant 125 : index
  %row_bytes = index.constant 20480 : offset
  %header = buffer.view %epoch[%origin] : buffer -> view<3xi32>
  %descriptors = buffer.view %epoch[%descriptor_origin] : buffer -> view<16x5xi32>
  %modes = buffer.view %epoch[%mode_origin] : buffer -> view<16x2xi32>
  %origins = buffer.view %rows[%origin] : buffer -> view<16x4xi64>
  %empty = index.cmp eq, %count, %c0 : index
  %span_count = scf.select %empty, %c0, %c6 : index
  %count_word = index.cast %count : index to i32
  %span_word = index.cast %span_count : index to i32
  view.store %count_word, %header[0] : i32, view<3xi32>
  view.store %span_word, %header[1] : i32, view<3xi32>
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %frontier = scalar.constant 37 : i32
  %advanced = scalar.constant 38 : i32
  %frontier64 = scalar.constant 37 : i64
  %end = scf.for %span = [%c0 to %c6 step %c1](%begin = %c0 : index) -> (index) {
    %first = index.cmp eq, %span, %c0 : index
    %third = index.cmp eq, %span, %c2 : index
    %fourth = index.cmp eq, %span, %c3 : index
    %fifth = index.cmp eq, %span, %c4 : index
    %last = index.cmp eq, %span, %c5 : index
    %length0 = scf.select %first, %c125, %c1 : index
    %length1 = scf.select %third, %c2, %length0 : index
    %length2 = scf.select %fourth, %c3, %length1 : index
    %length3 = scf.select %fifth, %c121, %length2 : index
    %length = scf.select %last, %c8, %length3 : index
    %fresh = scalar.ori %first, %fifth : i1
    %retained_position = scf.select %third, %advanced, %frontier : i32
    %position = scf.select %fresh, %c0_i32, %retained_position : i32
    %length_word = index.cast %length : index to i32
    %begin_word = index.cast %begin : index to i32
    %row_word = index.cast %span : index to i32
    view.store %length_word, %descriptors[%span, 0] : i32, view<16x5xi32>
    view.store %position, %descriptors[%span, 1] : i32, view<16x5xi32>
    view.store %begin_word, %descriptors[%span, 2] : i32, view<16x5xi32>
    view.store %row_word, %descriptors[%span, 3] : i32, view<16x5xi32>
    %mode = scf.select %last, %c1_i32, %c0_i32 : i32
    view.store %mode, %modes[%span, 0] : i32, view<16x2xi32>
    // Eight physical rows hold two three-row histories and two guard rows.
    %anchor_span = scf.select %fourth, %c1, %span : index
    %anchor_row = index.mul %anchor_span, %c8 : index
    %writer_row = index.madd %span, %c8, %c4 : index
    %anchor = index.scale %anchor_row, %row_bytes : index, offset -> offset
    %writer = index.scale %writer_row, %row_bytes : index, offset -> offset
    %anchor_word = index.cast %anchor : offset to i64
    %writer_word = index.cast %writer : offset to i64
    view.store %anchor_word, %origins[%span, 0] : i64, view<16x4xi64>
    view.store %writer_word, %origins[%span, 1] : i64, view<16x4xi64>
    view.store %frontier64, %origins[%span, 3] : i64, view<16x4xi64>
    %next = index.add %begin, %length : index
    scf.yield %next : index
  }
  kernel.return
}

// Every code in a channel is (channel % 23 - 11); each K32 scale is
// (block % 5 + channel % 3 + 1)/1024. An input row is constant across K:
// (token % 17 - 8)/16. Summing 80 blocks gives the exact raw projection
// input * code * (3 + channel % 3) * 2.5 before BF16 publication. This
// closed-form oracle has no matrix fragments, preparation layout, or K loop.
kernel.def @projection_fixture() {
  %groups = index.constant 80 : index
  %threads = index.constant 128 : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%count: index, %input: buffer, %weight: buffer, %raw: buffer, %capture: buffer) where [range(%count, 0, 260)] {
  %group = kernel.workgroup.id<x> : index
  %thread = kernel.workitem.id<x> : index
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c3 = index.constant 3 : index
  %c5 = index.constant 5 : index
  %c17 = index.constant 17 : index
  %c23 = index.constant 23 : index
  %c80 = index.constant 80 : index
  %c128 = index.constant 128 : index
  %capacity = index.constant 384 : index
  %inputs = index.constant 2560 : index
  %channel = index.madd %group, %c128, %thread : index
  %code_index = index.rem %channel, %c23 : index
  %code_word = index.cast %code_index : index to i32
  %bias = scalar.constant 11 : i32
  %code = scalar.subi %code_word, %bias : i32
  %code_byte = scalar.trunci %code : i32 to i8
  %codes = vector.splat %code_byte : vector<32xi8>
  %scale_index = index.rem %channel, %c3 : index
  %block_bytes = index.constant 34 : offset
  %scale_bytes = index.constant 2 : offset
  %unit = scalar.constant 0.0009765625 : f32
  scf.for %block = [%c0 to %c80 step %c1] {
    %remainder = index.rem %block, %c5 : index
    %sum = index.add %remainder, %scale_index : index
    %numerator = index.add %sum, %c1 : index
    %numerator_word = index.cast %numerator : index to i32
    %numerator_value = scalar.uitofp %numerator_word : i32 to f32
    %scale = scalar.mulf %numerator_value, %unit : f32
    %packed_scale = scalar.fptrunc %scale : f32 to f16
    %ordinal = index.madd %channel, %c80, %block : index
    %position = index.scale %ordinal, %block_bytes : index, offset -> offset
    %payload = index.add %position, %scale_bytes : offset
    %header = buffer.view %weight[%position] : buffer -> view<1xf16>
    %bytes = buffer.view %weight[%payload] : buffer -> view<32xi8>
    view.store %packed_scale, %header[0] : f16, view<1xf16>
    vector.store %codes, %bytes[0] : vector<32xi8>, view<32xi8>
  }
  %input_view = buffer.view %input[%origin] : buffer -> view<384x2560xbf16>
  %raw_view = buffer.view %raw[%origin] : buffer -> view<384x10240xbf16>
  %capture_view = buffer.view %capture[%origin] : buffer -> view<130x10240xbf16>
  %input_owner = index.cmp ult, %channel, %inputs : index
  %safe_input_column = scf.select %input_owner, %channel, %c0 : index
  %code_value = scalar.sitofp %code : i32 to f32
  %scale_sum = index.add %scale_index, %c3 : index
  %scale_sum_word = index.cast %scale_sum : index to i32
  %scale_sum_value = scalar.uitofp %scale_sum_word : i32 to f32
  %factor = scalar.constant 2.5 : f32
  %coefficient = scalar.mulf %scale_sum_value, %factor : f32
  %input_bias = scalar.constant 8.0 : f32
  %input_scale = scalar.constant 0.0625 : f32
  %positive_zero = scalar.constant 0.0 : f32
  %nan_bits = scalar.constant 32705 : i16
  %nan = scalar.bitcast %nan_bits : i16 to bf16
  %speculative_begin = index.constant 252 : index
  %capture_begin = index.constant 41 : index
  scf.for %token = [%c0 to %capacity step %c1] {
    %remainder = index.rem %token, %c17 : index
    %word = index.cast %remainder : index to i32
    %value = scalar.uitofp %word : i32 to f32
    %centered = scalar.subf %value, %input_bias : f32
    %activation = scalar.mulf %centered, %input_scale : f32
    %packed_input = scalar.fptrunc %activation : f32 to bf16
    %live = index.cmp ult, %token, %count : index
    %published_input = scf.select %live, %packed_input, %nan : bf16
    scf.if %input_owner {
      view.store %published_input, %input_view[%token, %safe_input_column] : bf16, view<384x2560xbf16>
    }
    scf.if %live {
      %product = scalar.mulf %activation, %code_value : f32
      %projection = scalar.mulf %product, %coefficient : f32
      // The matrix sum starts at positive zero, including for zero products.
      %summed = scalar.addf %projection, %positive_zero : f32
      %packed = scalar.fptrunc %summed : f32 to bf16
      view.store %packed, %raw_view[%token, %channel] : bf16, view<384x10240xbf16>
      %speculative = index.cmp uge, %token, %speculative_begin : index
      scf.if %speculative {
        %relative = index.sub %token, %speculative_begin : index
        %row = index.add %capture_begin, %relative : index
        view.store %packed, %capture_view[%row, %channel] : bf16, view<130x10240xbf16>
      }
    }
  }
  kernel.return
}

// The ordinary convolution consumes analytical raw projections. The candidate
// must produce the same published values and history while writing only the
// speculative capture slots. Full-buffer comparisons retain inactive canaries.
check.case public @packed_projection_convolution {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %count = check.param.choice values([0, 260]) name("active") : index
  %seed = check.literal value(711261) : i64
  %epoch = check.generate.fill value(0) : tensor<515xi32>
  %rows = check.generate.fill value(0) : tensor<16x4xi64>
  kernel.launch @packed_sessions(%count, %epoch, %rows) : (index, tensor<515xi32>, tensor<16x4xi64>)
  %input = check.generate.fill value(0.0) : tensor<384x2560xbf16>
  %weight = check.generate.fill value(0) : tensor<10240x80x34xi8>
  %raw = check.generate.fill value(-17.0) : tensor<384x10240xbf16>
  %expected_capture = check.generate.fill value(-23.0) : tensor<130x10240xbf16>
  kernel.launch @projection_fixture(%count, %input, %weight, %raw, %expected_capture) : (index, tensor<384x2560xbf16>, tensor<10240x80x34xi8>, tensor<384x10240xbf16>, tensor<130x10240xbf16>)
  %width = check.literal value(10240) : index
  kernel.launch @flash_next_prepare_qkv_channels[%width](%weight) : [index](tensor<10240x80x34xi8>)
  %conv = check.generate.random.uniform seed(%seed) range(-0.02 to 0.02) : tensor<10240x4xf32>
  %arena = check.generate.random.uniform seed(%seed) range(-0.125 to 0.125) : tensor<16x8x10240xbf16>
  %expected_arena = check.generate.random.uniform seed(%seed) range(-0.125 to 0.125) : tensor<16x8x10240xbf16>
  %output = check.generate.fill value(-17.0) : tensor<384x10240xbf16>
  %expected = check.generate.fill value(-17.0) : tensor<384x10240xbf16>
  %norm = check.generate.fill value(-17.0) : tensor<384x32xf32>
  %expected_norm = check.generate.fill value(-17.0) : tensor<384x32xf32>
  %halo = check.generate.fill value(-19.0) : tensor<18x6x10240xbf16>
  %capture = check.generate.fill value(-23.0) : tensor<130x10240xbf16>
  %history_origin = check.literal value(0) : offset
  %capture_origin = check.literal value(20480) : offset
  kernel.launch @gdn_convolve(%epoch, %rows, %history_origin, %raw, %conv, %expected_arena, %expected, %expected_norm) : (tensor<515xi32>, tensor<16x4xi64>, offset, tensor<384x10240xbf16>, tensor<10240x4xf32>, tensor<16x8x10240xbf16>, tensor<384x10240xbf16>, tensor<384x32xf32>)
  kernel.launch @gdn_fused_projection(%epoch, %input, %weight, %conv, %halo, %output, %norm, %capture, %capture_origin) : (tensor<515xi32>, tensor<384x2560xbf16>, tensor<10240x80x34xi8>, tensor<10240x4xf32>, tensor<18x6x10240xbf16>, tensor<384x10240xbf16>, tensor<384x32xf32>, tensor<130x10240xbf16>, offset)
  kernel.launch @gdn_fused_boundary(%epoch, %rows, %history_origin, %halo, %conv, %arena, %output, %norm) : (tensor<515xi32>, tensor<16x4xi64>, offset, tensor<18x6x10240xbf16>, tensor<10240x4xf32>, tensor<16x8x10240xbf16>, tensor<384x10240xbf16>, tensor<384x32xf32>)
  check.expect.bitwise actual(%output) expected(%expected) : tensor<384x10240xbf16>
  check.expect.bitwise actual(%norm) expected(%expected_norm) : tensor<384x32xf32>
  check.expect.bitwise actual(%arena) expected(%expected_arena) : tensor<16x8x10240xbf16>
  check.expect.bitwise actual(%capture) expected(%expected_capture) : tensor<130x10240xbf16>
  check.return
}
