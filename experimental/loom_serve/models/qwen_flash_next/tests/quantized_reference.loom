// Decode original packed values one element at a time in F64. Dot-product
// and matrix tests reuse these oracles, independently of production vector
// decoders, coefficient planes, and reduction order. Format indices are
// Q8_0, Q5_1, Q4_K, and Q5_K.
func.def @quantized_qk_weight_arithmetic(%half_coefficients: i1, %q5_encoding: i1, %table: buffer, %inputs: index, %row0: index, %column: index) -> (f64) {
  %block_width = index.constant 256 : index
  %block = index.div %column, %block_width : index
  %channel0 = index.rem %column, %block_width : index
  %channel = index.assume %channel0 [range(%channel0, 0, 255)] : index
  %blocks = index.div %inputs, %block_width : index
  %row_start = index.mul %row0, %blocks : index
  %block_index = index.add %row_start, %block : index
  %q4_bytes = index.constant 144 : offset
  %q5_bytes = index.constant 176 : offset
  %block_bytes = scf.select %q5_encoding, %q5_bytes, %q4_bytes : offset
  %header_bytes = index.constant 4 : offset
  %q4_payload = index.constant 16 : offset
  %q5_payload = index.constant 48 : offset
  %payload_bytes = scf.select %q5_encoding, %q5_payload, %q4_payload : offset
  %base = index.scale %block_index, %block_bytes : index, offset -> offset
  %scales_base = index.add %base, %header_bytes : offset
  %codes_base = index.add %base, %payload_bytes : offset
  %header = buffer.view %table[%base] : buffer -> view<2xf16>
  %scales = buffer.view %table[%scales_base] : buffer -> view<12xi8>
  %codes = buffer.view %table[%codes_base] : buffer -> view<128xi8>
  %c4 = index.constant 4 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %group = index.div %channel, %c32 : index
  %group_plus4 = index.add %group, %c4 : index
  %shift4 = scalar.constant 4 : i32
  %shift6 = scalar.constant 6 : i32
  %mask4 = scalar.constant 15 : i32
  %mask6 = scalar.constant 63 : i32
  %low = index.cmp ult, %group, %c4 : index
  %scale, %minimum = scf.if %low -> (i32, i32) {
    %a = view.load %scales[%group] : view<12xi8> -> i8
    %b = view.load %scales[%group_plus4] : view<12xi8> -> i8
    %ua = scalar.extui %a : i8 to i32
    %ub = scalar.extui %b : i8 to i32
    %s = scalar.andi %ua, %mask6 : i32
    %m = scalar.andi %ub, %mask6 : i32
    scf.yield %s, %m : i32, i32
  } else {
    %group_minus4 = index.sub %group, %c4 : index
    %a = view.load %scales[%group_minus4] : view<12xi8> -> i8
    %b = view.load %scales[%group] : view<12xi8> -> i8
    %c = view.load %scales[%group_plus4] : view<12xi8> -> i8
    %ua = scalar.extui %a : i8 to i32
    %ub = scalar.extui %b : i8 to i32
    %uc = scalar.extui %c : i8 to i32
    %s_low = scalar.andi %uc, %mask4 : i32
    %m_low = scalar.shrui %uc, %shift4 : i32
    %s_high0 = scalar.shrui %ua, %shift6 : i32
    %m_high0 = scalar.shrui %ub, %shift6 : i32
    %s_high = scalar.shli %s_high0, %shift4 : i32
    %m_high = scalar.shli %m_high0, %shift4 : i32
    %s = scalar.ori %s_low, %s_high : i32
    %m = scalar.ori %m_low, %m_high : i32
    scf.yield %s, %m : i32, i32
  }
  %page = index.div %channel, %c64 : index
  %within = index.rem %channel, %c32 : index
  %page_base = index.mul %page, %c32 : index
  %code_index = index.add %page_base, %within : index
  %packed = view.load %codes[%code_index] : view<128xi8> -> i8
  %word = scalar.extui %packed : i8 to i32
  %half = index.rem %channel, %c64 : index
  %upper = index.cmp uge, %half, %c32 : index
  %high = scalar.shrui %word, %shift4 : i32
  %chosen = scf.select %upper, %high, %word : i32
  %low_code = scalar.andi %chosen, %mask4 : i32
  %code = scf.if %q5_encoding -> (i32) {
    %high_base = index.add %base, %q4_payload : offset
    %high_bits = buffer.view %table[%high_base] : buffer -> view<32xi8>
    %packed_high = view.load %high_bits[%within] : view<32xi8> -> i8
    %high_word = scalar.extui %packed_high : i8 to i32
    %shift = index.cast %group : index to i32
    %shifted = scalar.shrui %high_word, %shift : i32
    %c1 = scalar.constant 1 : i32
    %bit = scalar.andi %shifted, %c1 : i32
    %high_code = scalar.shli %bit, %shift4 : i32
    %joined = scalar.ori %low_code, %high_code : i32
    scf.yield %joined : i32
  } else {
    scf.yield %low_code : i32
  }
  %d16 = view.load %header[0] : view<2xf16> -> f16
  %m16 = view.load %header[1] : view<2xf16> -> f16
  %d = scalar.extf %d16 : f16 to f64
  %m = scalar.extf %m16 : f16 to f64
  %s = scalar.uitofp %scale : i32 to f64
  %minimum_f = scalar.uitofp %minimum : i32 to f64
  %q = scalar.uitofp %code : i32 to f64
  %scaled = scalar.mulf %d, %s : f64
  %negative = scalar.mulf %m, %minimum_f : f64
  // Native half reconstruction rounds the physical scale and bias before
  // its fused multiply-add, then rounds the resulting coefficient once.
  // Evaluate that contract with scalar F64 arithmetic, without sharing any
  // production vector decoding, lane mapping, or matrix operations.
  %value = scf.if %half_coefficients -> (f64) {
    %scale_half = scalar.fptrunc %scaled : f64 to f16
    %minimum_half = scalar.fptrunc %negative : f64 to f16
    %scale_rounded = scalar.extf %scale_half : f16 to f64
    %minimum_rounded = scalar.extf %minimum_half : f16 to f64
    %positive = scalar.mulf %scale_rounded, %q : f64
    %coefficient = scalar.subf %positive, %minimum_rounded : f64
    %half = scalar.fptrunc %coefficient : f64 to f16
    %rounded = scalar.extf %half : f16 to f64
    scf.yield %rounded : f64
  } else {
    %positive = scalar.mulf %scaled, %q : f64
    %coefficient = scalar.subf %positive, %negative : f64
    scf.yield %coefficient : f64
  }
  func.return %value : f64
}

func.def public @quantized_qk_weight(%q5_encoding: i1, %table: buffer, %inputs: index, %row: index, %column: index) -> (f64) {
  %half_coefficients = scalar.constant false : i1
  %value = func.call @quantized_qk_weight_arithmetic(%half_coefficients, %q5_encoding, %table, %inputs, %row, %column) : (i1, i1, buffer, index, index, index) -> (f64)
  func.return %value : f64
}

func.def public @quantized_small_weight(%q8: i1, %weight: buffer, %width: index, %row: index, %column: index) -> (f64) {
  %block_width = index.constant 32 : index
  %q8_bytes = index.constant 34 : offset
  %q5_bytes = index.constant 24 : offset
  %bytes = scf.select %q8, %q8_bytes, %q5_bytes : offset
  %blocks = index.div %width, %block_width : index
  %block = index.div %column, %block_width : index
  %element_value = index.rem %column, %block_width : index
  %element = index.assume %element_value [range(%element_value, 0, 31)] : index
  %block_index = index.madd %row, %blocks, %block : index
  %base = index.scale %block_index, %bytes : index, offset -> offset
  %header = buffer.view %weight[%base] : buffer -> view<2xf16>
  %scale16 = view.load %header[0] : view<2xf16> -> f16
  %scale = scalar.extf %scale16 : f16 to f64
  %value = scf.if %q8 -> (f64) {
    %header_bytes = index.constant 2 : offset
    %codes_base = index.add %base, %header_bytes : offset
    %codes = buffer.view %weight[%codes_base] : buffer -> view<32xi8>
    %code = view.load %codes[%element] : view<32xi8> -> i8
    %code64 = scalar.sitofp %code : i8 to f64
    %scaled = scalar.mulf %code64, %scale : f64
    scf.yield %scaled : f64
  } else {
    %high_offset = index.constant 4 : offset
    %codes_offset = index.constant 8 : offset
    %high_base = index.add %base, %high_offset : offset
    %codes_base = index.add %base, %codes_offset : offset
    %high_view = buffer.view %weight[%high_base] : buffer -> view<1xi32>
    %codes = buffer.view %weight[%codes_base] : buffer -> view<16xi8>
    %c16 = index.constant 16 : index
    %half = index.div %element, %c16 : index
    %within = index.rem %element, %c16 : index
    %packed = view.load %codes[%within] : view<16xi8> -> i8
    %word = scalar.extui %packed : i8 to i32
    %half32 = index.cast %half : index to i32
    %c4 = scalar.constant 4 : i32
    %shift = scalar.muli %half32, %c4 : i32
    %shifted = scalar.shrui %word, %shift : i32
    %mask = scalar.constant 15 : i32
    %low = scalar.andi %shifted, %mask : i32
    %high_word = view.load %high_view[0] : view<1xi32> -> i32
    %bit_index = index.cast %element : index to i32
    %high_shifted = scalar.shrui %high_word, %bit_index : i32
    %c1 = scalar.constant 1 : i32
    %bit = scalar.andi %high_shifted, %c1 : i32
    %high = scalar.shli %bit, %c4 : i32
    %code = scalar.ori %low, %high : i32
    %code64 = scalar.uitofp %code : i32 to f64
    %minimum16 = view.load %header[1] : view<2xf16> -> f16
    %minimum = scalar.extf %minimum16 : f16 to f64
    %scaled = scalar.mulf %code64, %scale : f64
    %result = scalar.addf %scaled, %minimum : f64
    scf.yield %result : f64
  }
  func.return %value : f64
}

func.def public @quantized_finite_headers(%format: index, %width: index, %rows: index, %scale: f16, %minimum: f16, %weight: buffer) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %q8 = index.cmp eq, %format, %c0 : index
  %q5k = index.cmp eq, %format, %c3 : index
  %large = index.cmp uge, %format, %c2 : index
  %small_width = index.constant 32 : index
  %large_width = index.constant 256 : index
  %block_width = scf.select %large, %large_width, %small_width : index
  %blocks = index.div %width, %block_width : index
  %count = index.mul %rows, %blocks : index
  %b24 = index.constant 24 : offset
  %b34 = index.constant 34 : offset
  %b144 = index.constant 144 : offset
  %b176 = index.constant 176 : offset
  %small_bytes = scf.select %q8, %b34, %b24 : offset
  %large_bytes = scf.select %q5k, %b176, %b144 : offset
  %bytes = scf.select %large, %large_bytes, %small_bytes : offset
  scf.for %block = [%c0 to %count step %c1] {
    %base = index.scale %block, %bytes : index, offset -> offset
    %header = buffer.view %weight[%base] : buffer -> view<2xf16>
    view.store %scale, %header[0] : f16, view<2xf16>
    %affine = index.cmp ne, %format, %c0 : index
    scf.if %affine {
      view.store %minimum, %header[1] : f16, view<2xf16>
    }
  }
  func.return
}

// Eight coordinates cover packed-code, scale-group, K-block, and final-block
// boundaries in the 640- and 2560-feature expert contractions.
func.def inline @quantized_sparse_coordinate(%ordinal: index, %width_value: index) -> (index) {
  %width = index.assume %width_value [range(%width_value, 640, 2560)] : index
  %c1 = index.constant 1 : index
  %last = index.sub %width, %c1 : index
  %last_word = index.cast %last : index to i32
  %c0_i32 = scalar.constant 0 : i32
  %c15 = scalar.constant 15 : i32
  %c31 = scalar.constant 31 : i32
  %c127 = scalar.constant 127 : i32
  %c255 = scalar.constant 255 : i32
  %c256 = scalar.constant 256 : i32
  %c511 = scalar.constant 511 : i32
  %coordinates = vector.from_elements %c0_i32, %c15, %c31, %c127, %c255, %c256, %c511, %last_word : vector<8xi32>
  %word = vector.extract %coordinates[%ordinal] : vector<8xi32> -> i32
  %coordinate = index.cast %word : i32 to index
  %bounded = index.assume %coordinate [range(%coordinate, 0, %last)] : index
  func.return %bounded : index
}

// Populate eight coordinates in otherwise zero-filled BF16 input. The caller
// owns the zero initialization; inactive rows receive NaNs to expose reads
// leaking into a live result. Routed and contiguous oracles share this fixture.
func.def public inline @quantized_sparse_input(%capacity_value: index, %count_value: index, %width: index, %input: buffer) {
  %capacity = index.assume %capacity_value [range(%capacity_value, 1, 327680)] : index
  %count = index.assume %count_value [range(%count_value, 0, %capacity)] : index
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  %values = buffer.view %input[%origin] : buffer -> view<[%capacity]x[%width]xbf16>
  %c4_i32 = scalar.constant 4 : i32
  %unit = scalar.constant 0.0625 : f32
  scf.for %row = [%c0 to %count step %c1] {
    scf.for %ordinal = [%c0 to %c8 step %c1] {
      %column_value = func.call @quantized_sparse_coordinate(%ordinal, %width) : (index, index) -> (index)
      %last_column = index.sub %width, %c1 : index
      %column = index.assume %column_value [range(%column_value, 0, %last_column)] : index
      %mixed = index.add %row, %ordinal : index
      %remainder = index.rem %mixed, %c8 : index
      %word = index.cast %remainder : index to i32
      %centered = scalar.subi %word, %c4_i32 : i32
      %wide = scalar.sitofp %centered : i32 to f32
      %scaled = scalar.mulf %wide, %unit : f32
      %value = scalar.fptrunc %scaled : f32 to bf16
      view.store %value, %values[%row, %column] : bf16, view<[%capacity]x[%width]xbf16>
    }
  }
  %nan_bits = scalar.constant 32705 : i16
  %nan = scalar.bitcast %nan_bits : i16 to bf16
  scf.for %row = [%count to %capacity step %c1] {
    scf.for %column = [%c0 to %width step %c1] {
      view.store %nan, %values[%row, %column] : bf16, view<[%capacity]x[%width]xbf16>
    }
  }
  func.return
}

// Decode original coefficients independently and accumulate nonzero input
// coordinates in F64. The device still traverses every K block, while the
// CPU oracle avoids a full model-sized matrix multiply for each trial.
func.def public inline @quantized_sparse_dot_arithmetic(%half_coefficients: i1, %format: index, %width: index, %input_row: index, %weight_row: index, %input: buffer, %weight: buffer) -> (f64) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c8 = index.constant 8 : index
  %element_bytes = index.constant 2 : offset
  %row_element = index.mul %input_row, %width : index
  %row_origin = index.scale %row_element, %element_bytes : index, offset -> offset
  %values = buffer.view %input[%row_origin] : buffer -> view<[%width]xbf16>
  %large = index.cmp uge, %format, %c2 : index
  %q8 = index.cmp eq, %format, %c0 : index
  %q5 = index.cmp eq, %format, %c3 : index
  %initial = scalar.constant 0.0 : f64
  %result = scf.for %ordinal = [%c0 to %c8 step %c1](%sum = %initial : f64) -> (f64) {
    %column_value = func.call @quantized_sparse_coordinate(%ordinal, %width) : (index, index) -> (index)
    %last_column = index.sub %width, %c1 : index
    %column = index.assume %column_value [range(%column_value, 0, %last_column)] : index
    %coefficient = scf.if %large -> (f64) {
      %value = func.call @quantized_qk_weight_arithmetic(%half_coefficients, %q5, %weight, %width, %weight_row, %column) : (i1, i1, buffer, index, index, index) -> (f64)
      scf.yield %value : f64
    } else {
      %value = func.call @quantized_small_weight(%q8, %weight, %width, %weight_row, %column) : (i1, buffer, index, index, index) -> (f64)
      scf.yield %value : f64
    }
    %packed = view.load %values[%column] : view<[%width]xbf16> -> bf16
    %x = scalar.extf %packed : bf16 to f64
    %input_value, %weight_value = scf.if %half_coefficients -> (f64, f64) {
      %input_half = scalar.fptrunc %x : f64 to f16
      %coefficient_half = scalar.fptrunc %coefficient : f64 to f16
      %input_rounded = scalar.extf %input_half : f16 to f64
      %coefficient_rounded = scalar.extf %coefficient_half : f16 to f64
      scf.yield %input_rounded, %coefficient_rounded : f64, f64
    } else {
      scf.yield %x, %coefficient : f64, f64
    }
    %product = scalar.mulf %input_value, %weight_value : f64
    %next = scalar.addf %sum, %product : f64
    scf.yield %next : f64
  }
  func.return %result : f64
}

// The small scalar consumers retain original coefficient arithmetic.
func.def public inline @quantized_sparse_dot(%format: index, %width: index, %input_row: index, %weight_row: index, %input: buffer, %weight: buffer) -> (f64) {
  %half_coefficients = scalar.constant false : i1
  %value = func.call @quantized_sparse_dot_arithmetic(%half_coefficients, %format, %width, %input_row, %weight_row, %input, %weight) : (i1, index, index, index, index, buffer, buffer) -> (f64)
  func.return %value : f64
}
