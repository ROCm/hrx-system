config.decl @flash_next.token_count : %value: index where [range(%value, 1, 32768)]

kernel.decl @flash_next_prepare_qkv_channels(%output_width: index) launch(%weight: buffer)

kernel.decl @flash_next_project_qkv(%configured_output_width: index) launch(%output_width: index, %epoch: buffer, %input: buffer, %weight: buffer, %output: buffer)

func.decl @flash_next_q8_fixture(%count: index, %inputs: index, %outputs: index, %epoch: buffer, %input: buffer, %weight: buffer)

func.decl @flash_next_q8_reference(%inputs: index, %outputs: index, %epoch: buffer, %input: buffer, %weight: buffer, %output: buffer)

// Copy original blocks into their logical planes independently of the GPU's
// thread assignment, staged word permutation, and vector publication.
func.def @prepare_reference(%weight: buffer) {
  %origin = index.constant 0 : offset
  %length = buffer.length %weight
  %source = buffer.alloca<private> align(16) %length : buffer
  buffer.copy %weight[%origin], %source[%origin], %length
  %row_bytes = index.constant 2720 : offset
  %row_size = index.constant 2720 : index
  %bytes = index.cast %length : offset to index
  %channels = index.div %bytes, %row_size : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %blocks = index.constant 80 : index
  %block_bytes = index.constant 34 : offset
  %scale_bytes = index.constant 2 : offset
  %code_bytes = index.constant 32 : offset
  %group_bytes = index.constant 10880 : offset
  %scale_plane_bytes = index.constant 640 : offset
  scf.for %row = [%c0 to %channels step %c1] {
    %group = index.div %row, %c4 : index
    %member = index.rem %row, %c4 : index
    %source_row = index.scale %row, %row_bytes : index, offset -> offset
    %group_origin = index.scale %group, %group_bytes : index, offset -> offset
    %code_plane = index.add %group_origin, %scale_plane_bytes : offset
    scf.for %block = [%c0 to %blocks step %c1] {
      %source_delta = index.scale %block, %block_bytes : index, offset -> offset
      %source_scale = index.add %source_row, %source_delta : offset
      %source_codes = index.add %source_scale, %scale_bytes : offset
      %ordinal = index.madd %block, %c4, %member : index
      %scale_delta = index.scale %ordinal, %scale_bytes : index, offset -> offset
      %target_scale = index.add %group_origin, %scale_delta : offset
      %code_delta = index.scale %ordinal, %code_bytes : index, offset -> offset
      %target_codes = index.add %code_plane, %code_delta : offset
      buffer.copy %source[%source_scale], %weight[%target_scale], %scale_bytes
      buffer.copy %source[%source_codes], %weight[%target_codes], %code_bytes
    }
  }
  func.return
}

func.def @channel_count(%configuration: index) -> (index) {
  %c0 = index.constant 0 : index
  %small = index.constant 4 : index
  %large = index.constant 68 : index
  %first = index.cmp eq, %configuration, %c0 : index
  %count = scf.select %first, %small, %large : index
  func.return %count : index
}

check.scenario public @prepared_q8_storage {
  check.trial[2](%trial: index, %entropy: check.entropy) {
    %outputs = check.generate<@channel_count>(%trial) : (index) -> (index)
    %seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %weight = check.generate.random.uniform seed(%seed) range(-128 to 127) : tensor<[%outputs]x80x34xi8>
    check.compare<@flash_next_prepare_qkv_channels, @prepare_reference>[%outputs](%weight) : [index](tensor<[%outputs]x80x34xi8>) -> () {
      check.expect.bitwise actual(%weight) expected(%weight) : tensor<[%outputs]x80x34xi8>
    }
  }
  check.return
}

// The scalar F64 oracle consumes the original bytes before preparation. Both
// implementations then publish into distinct outputs with the same canaries.
// These single-thread wrappers reuse the independent reference shared with
// the VM scenario tests of the original Q8 projection.
kernel.def @fixture() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%requested: index, %output_width: index, %epoch: buffer, %input: buffer, %weight: buffer) {
  %inputs = index.constant 2560 : index
  %outputs = index.assume %output_width [range(%output_width, 4, 68), multiple_of(%output_width, 4)] : index
  %capacity = config.get @flash_next.token_count : index
  %count = index.min %requested, %capacity : index
  func.call @flash_next_q8_fixture(%count, %inputs, %outputs, %epoch, %input, %weight) : (index, index, index, buffer, buffer, buffer)
  kernel.return
}

kernel.def @reference() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%output_width: index, %epoch: buffer, %input: buffer, %weight: buffer, %output: buffer) {
  %inputs = index.constant 2560 : index
  %outputs = index.assume %output_width [range(%output_width, 4, 68), multiple_of(%output_width, 4)] : index
  func.call @flash_next_q8_reference(%inputs, %outputs, %epoch, %input, %weight, %output) : (index, index, buffer, buffer, buffer, buffer)
  kernel.return
}

// Preparation and consumption share one mutable binding, as they do in serving.
// Empty, dot-only, matrix, and ragged matrix/dot epochs keep inactive rows intact.
// The 33-row backing allocations also retain canaries beyond smaller compiled
// capacities; the fixture limits the active count to the configured capacity.
check.case public @prepared_q8_projection {
  %requested = check.param.choice values([0, 1, 3, 4, 17, 33]) name("active") : index
  %outputs = check.param.choice values([4, 68]) name("channels") : index
  %tokens = check.literal value(33) : index
  %seed = check.literal value(7139) : i64
  %epoch = check.generate.fill value(0) : tensor<3xi32>
  %input = check.generate.random.uniform seed(%seed) range(-1.0 to 1.0) : tensor<[%tokens]x2560xbf16>
  %weight = check.generate.random.uniform seed(%seed) range(-127 to 127) : tensor<[%outputs]x80x34xi8>
  kernel.launch @fixture(%requested, %outputs, %epoch, %input, %weight) : (index, index, tensor<3xi32>, tensor<[%tokens]x2560xbf16>, tensor<[%outputs]x80x34xi8>)
  %output = check.generate.fill value(-17.0) : tensor<[%tokens]x[%outputs]xbf16>
  %expected = check.generate.fill value(-17.0) : tensor<[%tokens]x[%outputs]xbf16>
  kernel.launch @reference(%outputs, %epoch, %input, %weight, %expected) : (index, tensor<3xi32>, tensor<[%tokens]x2560xbf16>, tensor<[%outputs]x80x34xi8>, tensor<[%tokens]x[%outputs]xbf16>)
  kernel.launch @flash_next_prepare_qkv_channels[%outputs](%weight) : [index](tensor<[%outputs]x80x34xi8>)
  kernel.launch @flash_next_project_qkv[%outputs](%outputs, %epoch, %input, %weight, %output) : [index](index, tensor<3xi32>, tensor<[%tokens]x2560xbf16>, tensor<[%outputs]x80x34xi8>, tensor<[%tokens]x[%outputs]xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(6.103515625e-05) rtol(0.0078125) nan(different) : tensor<[%tokens]x[%outputs]xbf16>
  check.return
}
