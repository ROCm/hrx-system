  kernel.launch @expert_routes(%rows, %epoch, %ids, %ranks, %tasks) : (index, tensor<3xi32>, tensor<1310xi32>, tensor<1310xi32>, tensor<10675xi32>)
  kernel.launch @observe_routes(%rows, %tasks, %count, %counts, %experts) : (index, tensor<10675xi32>, tensor<2xi32>, tensor<1310xi32>, tensor<1310xi32>)
  %actual_count = check.tensor.view %count offset(0) : tensor<2xi32> -> tensor<1xi32>
  %padding_errors = check.tensor.view %count offset(4) : tensor<2xi32> -> tensor<1xi32>
  %active_counts = check.tensor.view %counts offset(0) : tensor<1310xi32> -> tensor<1300xi32>
  %active_experts = check.tensor.view %experts offset(0) : tensor<1310xi32> -> tensor<1300xi32>
  %inactive_counts = check.tensor.view %counts offset(5200) : tensor<1310xi32> -> tensor<10xi32>
  %inactive_experts = check.tensor.view %experts offset(5200) : tensor<1310xi32> -> tensor<10xi32>
  %expected_count = check.generate.fill value(90) : tensor<1xi32>
  %expected_counts = check.generate.fill value(1) : tensor<1300xi32>
  %expected_experts = check.generate.iota offset(1) step(1) period(10) : tensor<1300xi32>
  %zero_padding = check.generate.fill value(0) : tensor<1xi32>
