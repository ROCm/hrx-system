// Ten experts each receive 130 routes. Storage covers the maximum possible
// record count at capacity 131, independently of this particular population.
check.case public @largest_route_tail {
  %rows = check.literal value(256) : index
  %epoch = check.generate.fill value(130) : tensor<3xi32>
  %ids = check.generate.iota offset(0) step(1) period(10) : tensor<1310xi32>
  %ranks = check.generate.fill value(1515870810) : tensor<1310xi32>
  %tasks = check.generate.fill value(1515870810) : tensor<133387xi32>
  %count = check.generate.fill value(0) : tensor<2xi32>
  %counts = check.generate.fill value(0) : tensor<1310xi32>
  %experts = check.generate.fill value(0) : tensor<1310xi32>
  kernel.launch @expert_routes(%rows, %epoch, %ids, %ranks, %tasks) : (index, tensor<3xi32>, tensor<1310xi32>, tensor<1310xi32>, tensor<133387xi32>)
  kernel.launch @observe_routes(%rows, %tasks, %count, %counts, %experts) : (index, tensor<133387xi32>, tensor<2xi32>, tensor<1310xi32>, tensor<1310xi32>)
  %actual_count = check.tensor.view %count offset(0) : tensor<2xi32> -> tensor<1xi32>
  %padding_errors = check.tensor.view %count offset(4) : tensor<2xi32> -> tensor<1xi32>
  %active_counts = check.tensor.view %counts offset(0) : tensor<1310xi32> -> tensor<1300xi32>
  %active_experts = check.tensor.view %experts offset(0) : tensor<1310xi32> -> tensor<1300xi32>
  %inactive_counts = check.tensor.view %counts offset(5200) : tensor<1310xi32> -> tensor<10xi32>
  %inactive_experts = check.tensor.view %experts offset(5200) : tensor<1310xi32> -> tensor<10xi32>
  %expected_count = check.generate.fill value(10) : tensor<1xi32>
  %expected_counts = check.generate.fill value(1) : tensor<1300xi32>
  %expected_experts = check.generate.iota offset(1) step(1) period(10) : tensor<1300xi32>
  %zero_padding = check.generate.fill value(0) : tensor<1xi32>
  %zero = check.generate.fill value(0) : tensor<10xi32>
  check.expect.bitwise actual(%actual_count) expected(%expected_count) : tensor<1xi32>
  check.expect.bitwise actual(%padding_errors) expected(%zero_padding) : tensor<1xi32>
  check.expect.bitwise actual(%active_counts) expected(%expected_counts) : tensor<1300xi32>
  check.expect.bitwise actual(%active_experts) expected(%expected_experts) : tensor<1300xi32>
  check.expect.bitwise actual(%inactive_counts) expected(%zero) : tensor<10xi32>
  check.expect.bitwise actual(%inactive_experts) expected(%zero) : tensor<10xi32>
  check.return
}

// Every expert has a partial record. A subsequent empty epoch must hide all
// records in the same allocation without clearing the table first.
check.case public @distributed_then_empty {
  %rows = check.literal value(128) : index
  %epoch = check.generate.fill value(131) : tensor<3xi32>
  %ids = check.generate.iota offset(0) step(1) period(512) : tensor<1310xi32>
  %ranks = check.generate.fill value(1515870810) : tensor<1310xi32>
  %tasks = check.generate.fill value(1515870810) : tensor<67861xi32>
  %count = check.generate.fill value(0) : tensor<2xi32>
  %counts = check.generate.fill value(0) : tensor<1310xi32>
  %experts = check.generate.fill value(0) : tensor<1310xi32>
  kernel.launch @expert_routes(%rows, %epoch, %ids, %ranks, %tasks) : (index, tensor<3xi32>, tensor<1310xi32>, tensor<1310xi32>, tensor<67861xi32>)
  kernel.launch @observe_routes(%rows, %tasks, %count, %counts, %experts) : (index, tensor<67861xi32>, tensor<2xi32>, tensor<1310xi32>, tensor<1310xi32>)
  %actual_count = check.tensor.view %count offset(0) : tensor<2xi32> -> tensor<1xi32>
  %padding_errors = check.tensor.view %count offset(4) : tensor<2xi32> -> tensor<1xi32>
  %expected_count = check.generate.fill value(512) : tensor<1xi32>
  %expected_counts = check.generate.fill value(1) : tensor<1310xi32>
  %expected_experts = check.generate.iota offset(1) step(1) period(512) : tensor<1310xi32>
  %zero_padding = check.generate.fill value(0) : tensor<1xi32>
  check.expect.bitwise actual(%actual_count) expected(%expected_count) : tensor<1xi32>
  check.expect.bitwise actual(%padding_errors) expected(%zero_padding) : tensor<1xi32>
  check.expect.bitwise actual(%counts) expected(%expected_counts) : tensor<1310xi32>
  check.expect.bitwise actual(%experts) expected(%expected_experts) : tensor<1310xi32>

  %empty = check.generate.fill value(0) : tensor<3xi32>
  %empty_count = check.generate.fill value(0) : tensor<2xi32>
  %empty_counts = check.generate.fill value(0) : tensor<1310xi32>
  %empty_experts = check.generate.fill value(0) : tensor<1310xi32>
  %zero_count = check.generate.fill value(0) : tensor<2xi32>
  %zero = check.generate.fill value(0) : tensor<1310xi32>
  kernel.launch @expert_routes(%rows, %empty, %ids, %ranks, %tasks) : (index, tensor<3xi32>, tensor<1310xi32>, tensor<1310xi32>, tensor<67861xi32>)
  kernel.launch @observe_routes(%rows, %tasks, %empty_count, %empty_counts, %empty_experts) : (index, tensor<67861xi32>, tensor<2xi32>, tensor<1310xi32>, tensor<1310xi32>)
  check.expect.bitwise actual(%empty_count) expected(%zero_count) : tensor<2xi32>
  check.expect.bitwise actual(%empty_counts) expected(%zero) : tensor<1310xi32>
  check.expect.bitwise actual(%empty_experts) expected(%zero) : tensor<1310xi32>
  check.return
}
