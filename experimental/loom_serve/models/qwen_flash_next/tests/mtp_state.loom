kernel.decl @flash_next_mtp_compact() launch(%accepted: buffer, %compact: buffer, %origins: buffer)

kernel.decl @flash_next_mtp_restore() launch(%epoch: buffer, %carry: buffer, %cache: buffer, %hidden: buffer)

kernel.decl @flash_next_mtp_shift() launch(%epoch: buffer, %origins: buffer, %target: buffer, %target_tokens: buffer, %hidden: buffer, %tokens: buffer)

kernel.decl @flash_next_mtp_commit() launch(%epoch: buffer, %origins: buffer, %target: buffer, %cache: buffer, %carry: buffer)

kernel.decl @qsa_publish_tail() launch(%tail_origin: offset, %epoch: buffer, %rows: buffer, %raw: buffer, %arena: buffer)

// Four original spans leave holes, one is empty, and physical owner order
// differs from packed order. Positions cross both page and index boundaries;
// source coordinates deliberately differ from those causal positions.
kernel.def @fixture() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%epoch: buffer, %expected_epoch: buffer, %expected_origins: buffer, %rows: buffer, %expected_hidden: buffer, %expected_ids: buffer, %expected_carry: buffer) {
  %origin = index.constant 0 : offset
  %input = buffer.view %epoch[%origin] : buffer -> view<83xi32>
  %compact = buffer.view %expected_epoch[%origin] : buffer -> view<83xi32>
  %origins = buffer.view %expected_origins[%origin] : buffer -> view<16xi32>
  %row_table = buffer.view %rows[%origin] : buffer -> view<16x4xi64>
  %hidden = buffer.view %expected_hidden[%origin] : buffer -> view<16x5120xi32>
  %ids = buffer.view %expected_ids[%origin] : buffer -> view<16xi32>
  %carry = buffer.view %expected_carry[%origin] : buffer -> view<16x5312xi32>
  %c0_word = scalar.constant 0 : i32
  %c1_word = scalar.constant 1 : i32
  %c2_word = scalar.constant 2 : i32
  %c3_word = scalar.constant 3 : i32
  %c4_word = scalar.constant 4 : i32
  %c5_word = scalar.constant 5 : i32
  %c6_word = scalar.constant 6 : i32
  %c7_word = scalar.constant 7 : i32
  %c9_word = scalar.constant 9 : i32
  %c14_word = scalar.constant 14 : i32
  %c16_word = scalar.constant 16 : i32
  %c23_word = scalar.constant 23 : i32
  %c63_word = scalar.constant 63 : i32
  %c66_word = scalar.constant 66 : i32
  %c1001_word = scalar.constant 1001 : i32
  %c1002_word = scalar.constant 1002 : i32
  %c1009_word = scalar.constant 1009 : i32
  %c1010_word = scalar.constant 1010 : i32
  %c1011_word = scalar.constant 1011 : i32
  %c1014_word = scalar.constant 1014 : i32
  %c150000_word = scalar.constant 150000 : i32
  // Source positions 9, 23, 31, and 32 occupy the upper descriptor bits.
  %source0 = scalar.constant 9216 : i32
  %source1 = scalar.constant 23552 : i32
  %source2 = scalar.constant 31744 : i32
  %source3 = scalar.constant 32768 : i32
  %selected0 = scalar.constant 9217 : i32
  %selected2 = scalar.constant 31746 : i32
  %selected3 = scalar.constant 32771 : i32
  view.store %c16_word, %input[0] : i32, view<83xi32>
  view.store %c4_word, %input[1] : i32, view<83xi32>
  view.store %c0_word, %input[2] : i32, view<83xi32>
  view.store %c2_word, %input[3] : i32, view<83xi32>
  view.store %c0_word, %input[4] : i32, view<83xi32>
  view.store %c1_word, %input[5] : i32, view<83xi32>
  view.store %c7_word, %input[6] : i32, view<83xi32>
  view.store %source0, %input[7] : i32, view<83xi32>
  view.store %c0_word, %input[8] : i32, view<83xi32>
  view.store %c23_word, %input[9] : i32, view<83xi32>
  view.store %c5_word, %input[10] : i32, view<83xi32>
  view.store %c5_word, %input[11] : i32, view<83xi32>
  view.store %source1, %input[12] : i32, view<83xi32>
  view.store %c3_word, %input[13] : i32, view<83xi32>
  view.store %c63_word, %input[14] : i32, view<83xi32>
  view.store %c9_word, %input[15] : i32, view<83xi32>
  view.store %c2_word, %input[16] : i32, view<83xi32>
  view.store %source2, %input[17] : i32, view<83xi32>
  view.store %c1_word, %input[18] : i32, view<83xi32>
  view.store %c66_word, %input[19] : i32, view<83xi32>
  view.store %c14_word, %input[20] : i32, view<83xi32>
  view.store %c9_word, %input[21] : i32, view<83xi32>
  view.store %source3, %input[22] : i32, view<83xi32>
  view.store %c6_word, %compact[0] : i32, view<83xi32>
  view.store %c3_word, %compact[1] : i32, view<83xi32>
  view.store %c3_word, %compact[2] : i32, view<83xi32>
  view.store %c2_word, %compact[3] : i32, view<83xi32>
  view.store %c0_word, %compact[4] : i32, view<83xi32>
  view.store %c0_word, %compact[5] : i32, view<83xi32>
  view.store %c7_word, %compact[6] : i32, view<83xi32>
  view.store %selected0, %compact[7] : i32, view<83xi32>
  view.store %c3_word, %compact[8] : i32, view<83xi32>
  view.store %c63_word, %compact[9] : i32, view<83xi32>
  view.store %c2_word, %compact[10] : i32, view<83xi32>
  view.store %c2_word, %compact[11] : i32, view<83xi32>
  view.store %selected2, %compact[12] : i32, view<83xi32>
  view.store %c1_word, %compact[13] : i32, view<83xi32>
  view.store %c66_word, %compact[14] : i32, view<83xi32>
  view.store %c5_word, %compact[15] : i32, view<83xi32>
  view.store %c9_word, %compact[16] : i32, view<83xi32>
  view.store %selected3, %compact[17] : i32, view<83xi32>
  view.store %c1_word, %origins[0] : i32, view<16xi32>
  view.store %c9_word, %origins[1] : i32, view<16xi32>
  view.store %c14_word, %origins[2] : i32, view<16xi32>
  view.store %c1001_word, %ids[0] : i32, view<16xi32>
  view.store %c1002_word, %ids[1] : i32, view<16xi32>
  view.store %c1009_word, %ids[2] : i32, view<16xi32>
  view.store %c1010_word, %ids[3] : i32, view<16xi32>
  view.store %c1011_word, %ids[4] : i32, view<16xi32>
  view.store %c1014_word, %ids[5] : i32, view<16xi32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c16 = index.constant 16 : index
  %width = index.constant 5120 : index
  %tail_origin = index.constant 5120 : index
  %c64 = index.constant 64 : index
  %c128 = index.constant 128 : index
  %tail_bytes = scalar.constant 768 : i64
  scf.for %row = [%c0 to %c16 step %c1] {
    %row_word = index.cast %row : index to i64
    %base = scalar.muli %row_word, %tail_bytes : i64
    view.store %base, %row_table[%row, 0] : i64, view<16x4xi64>
    view.store %base, %row_table[%row, 1] : i64, view<16x4xi64>
  }
  scf.for %column = [%c0 to %width step %c1] {
    %word = index.cast %column : index to i32
    view.store %c0_word, %hidden[0, %column] : i32, view<16x5120xi32>
    %shift_base1 = scalar.constant 5120 : i32
    %shift_value1 = scalar.addi %word, %shift_base1 : i32
    view.store %shift_value1, %hidden[1, %column] : i32, view<16x5120xi32>
    %shift_base2 = scalar.constant 110624 : i32
    %shift_value2 = scalar.addi %word, %shift_base2 : i32
    view.store %shift_value2, %hidden[2, %column] : i32, view<16x5120xi32>
    %shift_base3 = scalar.constant 46080 : i32
    %shift_value3 = scalar.addi %word, %shift_base3 : i32
    view.store %shift_value3, %hidden[3, %column] : i32, view<16x5120xi32>
    %shift_base4 = scalar.constant 51200 : i32
    %shift_value4 = scalar.addi %word, %shift_base4 : i32
    view.store %shift_value4, %hidden[4, %column] : i32, view<16x5120xi32>
    %shift_base5 = scalar.constant 147808 : i32
    %shift_value5 = scalar.addi %word, %shift_base5 : i32
    view.store %shift_value5, %hidden[5, %column] : i32, view<16x5120xi32>
    %last_base7 = scalar.constant 10240 : i32
    %last_value7 = scalar.addi %word, %last_base7 : i32
    view.store %last_value7, %carry[7, %column] : i32, view<16x5312xi32>
    %last_base2 = scalar.constant 56320 : i32
    %last_value2 = scalar.addi %word, %last_base2 : i32
    view.store %last_value2, %carry[2, %column] : i32, view<16x5312xi32>
    %last_base9 = scalar.constant 71680 : i32
    %last_value9 = scalar.addi %word, %last_base9 : i32
    view.store %last_value9, %carry[9, %column] : i32, view<16x5312xi32>
  }
  scf.for %column = [%c0 to %c128 step %c1] {
    %word = index.cast %column : index to i32
    %destination = index.add %tail_origin, %column : index
    %fresh = scalar.addi %word, %c150000_word : i32
    %continued_base = scalar.constant 150192 : i32
    %continued = scalar.addi %word, %continued_base : i32
    view.store %fresh, %carry[7, %destination] : i32, view<16x5312xi32>
    view.store %continued, %carry[2, %destination] : i32, view<16x5312xi32>
  }
  scf.for %column = [%c0 to %c64 step %c1] {
    %word = index.cast %column : index to i32
    %slot = index.add %c128, %column : index
    %destination = index.add %tail_origin, %slot : index
    %base = scalar.constant 150320 : i32
    %value = scalar.addi %word, %base : i32
    view.store %value, %carry[9, %destination] : i32, view<16x5312xi32>
  }
  kernel.return
}

check.case public @accepted_carry_with_holes {
  %epoch = check.generate.fill value(-7) : tensor<83xi32>
  %compact = check.generate.fill value(-7) : tensor<83xi32>
  %expected_epoch = check.generate.fill value(-7) : tensor<83xi32>
  %origins = check.generate.fill value(-7) : tensor<16xi32>
  %expected_origins = check.generate.fill value(-7) : tensor<16xi32>
  %rows = check.generate.fill value(0) : tensor<16x4xi64>
  %source = check.generate.iota offset(0) step(1) : tensor<16x5120xi32>
  %source_ids = check.generate.iota offset(1000) step(1) : tensor<16xi32>
  %hidden = check.generate.fill value(-7) : tensor<16x5120xi32>
  %expected_hidden = check.generate.fill value(-7) : tensor<16x5120xi32>
  %ids = check.generate.fill value(-7) : tensor<16xi32>
  %expected_ids = check.generate.fill value(-7) : tensor<16xi32>
  %carry = check.generate.iota offset(100000) step(1) : tensor<16x5312xi32>
  %expected_carry = check.generate.iota offset(100000) step(1) : tensor<16x5312xi32>
  %cache = check.generate.fill value(-7) : tensor<16x192xi32>
  %raw = check.generate.iota offset(150000) step(1) : tensor<16x64xi32>
  %origin = check.literal value(0) : offset
  kernel.launch @fixture(%epoch, %expected_epoch, %expected_origins, %rows, %expected_hidden, %expected_ids, %expected_carry) : (tensor<83xi32>, tensor<83xi32>, tensor<16xi32>, tensor<16x4xi64>, tensor<16x5120xi32>, tensor<16xi32>, tensor<16x5312xi32>)
  kernel.launch @flash_next_mtp_compact(%epoch, %compact, %origins) : (tensor<83xi32>, tensor<83xi32>, tensor<16xi32>)
  check.expect.bitwise actual(%compact) expected(%expected_epoch) : tensor<83xi32>
  check.expect.bitwise actual(%origins) expected(%expected_origins) : tensor<16xi32>
  kernel.launch @flash_next_mtp_restore(%compact, %carry, %cache, %hidden) : (tensor<83xi32>, tensor<16x5312xi32>, tensor<16x192xi32>, tensor<16x5120xi32>)
  kernel.launch @flash_next_mtp_shift(%compact, %origins, %source, %source_ids, %hidden, %ids) : (tensor<83xi32>, tensor<16xi32>, tensor<16x5120xi32>, tensor<16xi32>, tensor<16x5120xi32>, tensor<16xi32>)
  check.expect.bitwise actual(%hidden) expected(%expected_hidden) : tensor<16x5120xi32>
  check.expect.bitwise actual(%ids) expected(%expected_ids) : tensor<16xi32>
  kernel.launch @qsa_publish_tail(%origin, %compact, %rows, %raw, %cache) : (offset, tensor<83xi32>, tensor<16x4xi64>, tensor<16x64xi32>, tensor<16x192xi32>)
  kernel.launch @flash_next_mtp_commit(%compact, %origins, %source, %cache, %carry) : (tensor<83xi32>, tensor<16xi32>, tensor<16x5120xi32>, tensor<16x192xi32>, tensor<16x5312xi32>)
  check.expect.bitwise actual(%carry) expected(%expected_carry) : tensor<16x5312xi32>
  check.return
}
