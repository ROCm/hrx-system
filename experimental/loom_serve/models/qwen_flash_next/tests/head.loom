kernel.decl @flash_next_select_output_rows() launch(%epoch: buffer, %residual: buffer, %head_epoch: buffer, %selected: buffer)

kernel.decl @flash_next_sample() launch(%epoch: buffer, %logits: buffer, %output: buffer)

// Four spans can request four verifier outputs apiece, but this packed shape
// has only eight inputs. Exercise empty, partial, and full output prefixes,
// reversed source rows, and preservation of inactive destination storage.
kernel.def @fixture() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%count_value: index, %epoch: buffer, %expected_header: buffer, %expected: buffer) {
  %count = index.assume %count_value [range(%count_value, 0, 8)] : index
  %origin = index.constant 0 : offset
  %header = buffer.view %epoch[%origin] : buffer -> view<3xi32>
  %output_header = buffer.view %expected_header[%origin] : buffer -> view<3xi32>
  %count_word = index.cast %count : index to i32
  view.store %count_word, %header[2] : i32, view<3xi32>
  view.store %count_word, %output_header[0] : i32, view<3xi32>
  %selection_origin = index.constant 1292 : offset
  %selections = buffer.view %epoch[%selection_origin] : buffer -> view<128xi32>
  %output = buffer.view %expected[%origin] : buffer -> view<8x5120xi32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %last = index.constant 7 : index
  %columns = index.constant 5120 : index
  %stride = scalar.constant 5120 : i32
  scf.for %row = [%c0 to %count step %c1] {
    %source = index.sub %last, %row : index
    %source_word = index.cast %source : index to i32
    view.store %source_word, %selections[%row] : i32, view<128xi32>
    %base = scalar.muli %source_word, %stride : i32
    scf.for %column = [%c0 to %columns step %c1] {
      %word = index.cast %column : index to i32
      %value = scalar.addi %base, %word : i32
      view.store %value, %output[%row, %column] : i32, view<8x5120xi32>
    }
  }
  kernel.return
}

check.case public @packed_output_capacity {
  %count = check.param.choice values([0, 3, 8]) name("outputs") : index
  %epoch = check.generate.fill value(0) : tensor<451xi32>
  %source = check.generate.iota offset(0) step(1) : tensor<8x5120xi32>
  %header = check.generate.fill value(-7) : tensor<3xi32>
  %expected_header = check.generate.fill value(-7) : tensor<3xi32>
  %output = check.generate.fill value(-7) : tensor<8x5120xi32>
  %expected = check.generate.fill value(-7) : tensor<8x5120xi32>
  kernel.launch @fixture(%count, %epoch, %expected_header, %expected) : (index, tensor<451xi32>, tensor<3xi32>, tensor<8x5120xi32>)
  kernel.launch @flash_next_select_output_rows(%epoch, %source, %header, %output) : (tensor<451xi32>, tensor<8x5120xi32>, tensor<3xi32>, tensor<8x5120xi32>)
  check.expect.bitwise actual(%header) expected(%expected_header) : tensor<3xi32>
  check.expect.bitwise actual(%output) expected(%expected) : tensor<8x5120xi32>
  check.return
}

func.def @sampling_fixture(%trial: index, %epoch: buffer, %logits: buffer) {
  %origin = index.constant 0 : offset
  %policy_origin = index.constant 4704 : offset
  %identity_origin = index.constant 5088 : offset
  %header = buffer.view %epoch[%origin] : buffer -> view<3xi32>
  %policies = buffer.view %epoch[%policy_origin] : buffer -> view<16x6xi32>
  %floats = buffer.view %epoch[%policy_origin] : buffer -> view<16x6xf32>
  %identities = buffer.view %epoch[%identity_origin] : buffer -> view<128x2xi32>
  %values = buffer.view %logits[%origin] : buffer -> view<8x248320xf32>
  %four = scalar.constant 4 : i32
  view.store %four, %header[2] : i32, view<3xi32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %zero = scalar.constant 0 : i32
  %one = scalar.constant 1 : i32
  %disabled = scalar.constant 2 : i32
  %fifteen = scalar.constant 15 : i32
  %high = scalar.constant 100.0 : f32
  %next = scalar.constant 10.0 : f32
  %padding = scalar.constant 1000.0 : f32
  %ordinal = index.cast %trial : index to i32
  %two = scalar.constant 2 : i32
  %three = scalar.constant 3 : i32
  %sampled_bit = scalar.andi %ordinal, %one : i32
  %sampled = scalar.cmpi ne, %sampled_bit, %zero : i32
  %zero_f32 = scalar.constant 0.0 : f32
  %sample_temperature = scalar.constant 0.7 : f32
  %temperature = scf.select %sampled, %sample_temperature, %zero_f32 : f32
  %pair = scalar.divui %ordinal, %two : i32
  %k_index = scalar.remui %pair, %three : i32
  %single = scalar.cmpi eq, %k_index, %one : i32
  %bounded = scalar.cmpi eq, %k_index, %two : i32
  %twenty = scalar.constant 20 : i32
  %wide_k = scf.select %bounded, %twenty, %zero : i32
  %top_k = scf.select %single, %one, %wide_k : i32
  %six = scalar.constant 6 : i32
  %nucleus = scalar.cmpi uge, %ordinal, %six : i32
  %all_mass = scalar.constant 1.0 : f32
  %partial_mass = scalar.constant 0.95 : f32
  %top_p = scf.select %nucleus, %partial_mass, %all_mass : f32
  scf.for %row = [%c0 to %c4 step %c1] {
    %row_word = index.cast %row : index to i32
    %odd = scalar.andi %row_word, %one : i32
    %forbidden = scalar.cmpi ne, %odd, %zero : i32
    %owner_word = scf.select %forbidden, %one, %fifteen : i32
    %owner_value = index.cast %owner_word : i32 to index
    %owner = index.assume %owner_value [range(%owner_value, 0, 15)] : index
    %flags = scf.select %forbidden, %disabled, %zero : i32
    view.store %owner_word, %identities[%row, 0] : i32, view<128x2xi32>
    view.store %row_word, %identities[%row, 1] : i32, view<128x2xi32>
    view.store %temperature, %floats[%owner, 0] : f32, view<16x6xf32>
    view.store %top_p, %floats[%owner, 1] : f32, view<16x6xf32>
    view.store %top_k, %policies[%owner, 2] : i32, view<16x6xi32>
    view.store %flags, %policies[%owner, 3] : i32, view<16x6xi32>
    view.store %high, %values[%row, 248058] : f32, view<8x248320xf32>
    view.store %next, %values[%row, 248059] : f32, view<8x248320xf32>
    view.store %padding, %values[%row, 248077] : f32, view<8x248320xf32>
  }
  func.return
}

// The shared request packet gates every verifier row, including repeated
// owners. Neither padded output rows nor padded vocabulary IDs may publish.
func.def @sampling_reference(%epoch: buffer, %logits: buffer, %outputs: buffer) {
  %origin = index.constant 0 : offset
  %output = buffer.view %outputs[%origin] : buffer -> view<8xi32>
  %opener = scalar.constant 248058 : i32
  %allowed = scalar.constant 248059 : i32
  view.store %opener, %output[0] : i32, view<8xi32>
  view.store %allowed, %output[1] : i32, view<8xi32>
  view.store %opener, %output[2] : i32, view<8xi32>
  view.store %allowed, %output[3] : i32, view<8xi32>
  func.return
}

check.scenario public @sampling_tool_permissions {
  check.trial[12](%trial: index, %entropy: check.entropy) {
    %epoch = check.generate.fill value(-1) : tensor<1528xi32>
    %logits = check.generate.fill value(-1000.0) : tensor<8x248320xf32>
    check.generate<@sampling_fixture>(%trial, %epoch, %logits) : (index, tensor<1528xi32>, tensor<8x248320xf32>) -> ()
    %outputs = check.generate.fill value(-99) : tensor<8xi32>
    check.compare<@flash_next_sample, @sampling_reference>(%epoch, %logits, %outputs) : (tensor<1528xi32>, tensor<8x248320xf32>, tensor<8xi32>) -> () {
      check.expect.equal actual(%outputs) expected(%outputs) : tensor<8xi32>
    }
  }
  check.return
}
