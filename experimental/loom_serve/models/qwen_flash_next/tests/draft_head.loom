template.decl @flash_next.draft_update(%position: index, %begin: index, %length: index, %owner: index, %ids: buffer, %carry: buffer)

kernel.decl @flash_next_draft_plan() launch(%epoch: buffer, %ids: buffer, %carry: buffer, %plan: buffer)

kernel.decl @flash_next_draft_common_head() launch(%epoch: buffer, %plan: buffer, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @flash_next_draft_rare_head() launch(%epoch: buffer, %plan: buffer, %carry: buffer, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @flash_next_draft_sample() launch(%epoch: buffer, %plan: buffer, %carry: buffer, %logits: buffer, %output: buffer)

kernel.decl @flash_next_vocabulary() launch(%epoch: buffer, %input: buffer, %weight: buffer, %output: buffer)

func.decl @flash_next_q8_reference_dot(%inputs: index, %token: index, %row: index, %input: buffer, %weight: buffer) -> (f64)

// Table insertion order deliberately opposes token-ID tie order. The fourth
// packed row is inactive; live resident owners are nonconsecutive and reordered.
kernel.def @seed_histories() {
  %one = index.constant 1 : index
  %three = index.constant 3 : index
  %threads = index.constant 128 : index
  kernel.launch.config workgroups(%three, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%ids: buffer, %carry: buffer) {
  %row = kernel.workgroup.id<x> : index
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %seven = index.constant 7 : index
  %nine = index.constant 9 : index
  %first = index.cmp eq, %row, %zero : index
  %second = index.cmp eq, %row, %one : index
  %other = scf.select %second, %two, %nine : index
  %owner = scf.select %first, %seven, %other : index
  template.apply<@flash_next.draft_update>(%zero, %zero, %two, %owner, %ids, %carry) : (index, index, index, index, buffer, buffer)
  kernel.return
}

kernel.def @setup() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%fallback: index, %epoch: buffer, %history_ids: buffer, %anchors: buffer, %logits: buffer, %expected_ids: buffer) {
  %origin = index.constant 0 : offset
  %records = index.constant 12 : offset
  %header = buffer.view %epoch[%origin] : buffer -> view<3xi32>
  %spans = buffer.view %epoch[%records] : buffer -> view<16x5xi32>
  %history = buffer.view %history_ids[%origin] : buffer -> view<4xi32>
  %tokens = buffer.view %anchors[%origin] : buffer -> view<4xi32>
  %scores = buffer.view %logits[%origin] : buffer -> view<4x248320xf32>
  %expected = buffer.view %expected_ids[%origin] : buffer -> view<4xi32>
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %three = index.constant 3 : index
  %zero_word = scalar.constant 0 : i32
  %one_word = scalar.constant 1 : i32
  %two_word = scalar.constant 2 : i32
  %three_word = scalar.constant 3 : i32
  %seven_word = scalar.constant 7 : i32
  %nine_word = scalar.constant 9 : i32
  %position = scalar.constant 128 : i32
  %lower = scalar.constant 100000 : i32
  %higher = scalar.constant 110000 : i32
  %unknown = scalar.constant 200000 : i32
  %control = scalar.constant 248076 : i32
  view.store %higher, %history[0] : i32, view<4xi32>
  view.store %lower, %history[1] : i32, view<4xi32>
  view.store %three_word, %header[0] : i32, view<3xi32>
  view.store %three_word, %header[1] : i32, view<3xi32>
  view.store %three_word, %header[2] : i32, view<3xi32>
  scf.for %row = [%zero to %three step %one] {
    %word = index.cast %row : index to i32
    view.store %one_word, %spans[%row, 0] : i32, view<16x5xi32>
    view.store %position, %spans[%row, 1] : i32, view<16x5xi32>
    view.store %word, %spans[%row, 2] : i32, view<16x5xi32>
    view.store %zero_word, %spans[%row, 4] : i32, view<16x5xi32>
    view.store %lower, %tokens[%row] : i32, view<4xi32>
  }
  view.store %seven_word, %spans[0, 3] : i32, view<16x5xi32>
  view.store %two_word, %spans[1, 3] : i32, view<16x5xi32>
  view.store %nine_word, %spans[2, 3] : i32, view<16x5xi32>
  %full = index.cmp ne, %fallback, %zero : index
  %anchor = scf.select %full, %unknown, %lower : i32
  view.store %anchor, %tokens[1] : i32, view<4xi32>
  %nine_score = scalar.constant 9.0 : f32
  %eleven = scalar.constant 11.0 : f32
  %twenty = scalar.constant 20.0 : f32
  // Unselected large scores must not participate in subset sampling. Two
  // equally good learned IDs must resolve by canonical ID, not table order.
  scf.for %row = [%zero to %three step %one] {
    view.store %nine_score, %scores[%row, 100000] : f32, view<4x248320xf32>
    view.store %nine_score, %scores[%row, 110000] : f32, view<4x248320xf32>
    view.store %twenty, %scores[%row, 200000] : f32, view<4x248320xf32>
  }
  view.store %eleven, %scores[2, 248076] : f32, view<4x248320xf32>
  view.store %lower, %expected[0] : i32, view<4xi32>
  view.store %anchor, %expected[1] : i32, view<4xi32>
  view.store %control, %expected[2] : i32, view<4xi32>
  kernel.return
}

// Copy only the union actually requested by this cohort from the original
// full vocabulary result. Untouched IDs and the inactive row retain poison.
kernel.def @select_reference() {
  %one = index.constant 1 : index
  %groups = index.constant 1280 : index
  %threads = index.constant 128 : index
  kernel.launch.config workgroups(%groups, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%fallback: index, %reference: buffer, %expected: buffer) {
  %origin = index.constant 0 : offset
  %source = buffer.view %reference[%origin] : buffer -> view<4x248320xf32>
  %output = buffer.view %expected[%origin] : buffer -> view<4x248320xf32>
  %group = kernel.workgroup.id<x> : index
  %thread = kernel.workitem.id<x> : index
  %threads = index.constant 128 : index
  %stride = index.constant 163840 : index
  %start = index.madd %group, %threads, %thread : index
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %three = index.constant 3 : index
  %columns = index.constant 248077 : index
  %prefix = index.constant 98304 : index
  %control_first = index.constant 248044 : index
  %rare0 = index.constant 100000 : index
  %rare1 = index.constant 110000 : index
  %full = index.cmp ne, %fallback, %zero : index
  scf.for %id = [%start to %columns step %stride] {
    %frequent = index.cmp ult, %id, %prefix : index
    %control = index.cmp uge, %id, %control_first : index
    %first = index.cmp eq, %id, %rare0 : index
    %second = index.cmp eq, %id, %rare1 : index
    %common = scalar.ori %frequent, %control : i1
    %rare = scalar.ori %first, %second : i1
    %subset = scalar.ori %common, %rare : i1
    %selected = scalar.ori %full, %subset : i1
    scf.if %selected {
      scf.for %row = [%zero to %three step %one] {
        %value = view.load %source[%row, %id] : view<4x248320xf32> -> f32
        view.store %value, %output[%row, %id] : f32, view<4x248320xf32>
      }
    }
  }
  kernel.return
}

// A small set of prefix, rare, and final control rows also gets a scalar F64
// oracle that shares neither the production dot tree nor its row addressing.
kernel.def @numerical_reference() {
  %one = index.constant 1 : index
  %threads = index.constant 8 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%input: buffer, %weight: buffer, %logits: buffer, %actual: buffer, %expected: buffer) {
  %slot = kernel.workitem.id<x> : index
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %three = index.constant 3 : index
  %four = index.constant 4 : index
  %five = index.constant 5 : index
  %six = index.constant 6 : index
  %rare0 = index.constant 100000 : index
  %rare1 = index.constant 110000 : index
  %control_first = index.constant 248075 : index
  %tail = index.sub %slot, %six : index
  %control = index.add %control_first, %tail : index
  %is_four = index.cmp eq, %slot, %four : index
  %is_five = index.cmp eq, %slot, %five : index
  %small = index.cmp ult, %slot, %four : index
  %last = scf.select %is_five, %rare1, %control : index
  %large = scf.select %is_four, %rare0, %last : index
  %id = scf.select %small, %slot, %large : index
  %width = index.constant 2560 : index
  %origin = index.constant 0 : offset
  %source = buffer.view %logits[%origin] : buffer -> view<4x248320xf32>
  %actuals = buffer.view %actual[%origin] : buffer -> view<3x8xf32>
  %references = buffer.view %expected[%origin] : buffer -> view<3x8xf32>
  scf.for %row = [%zero to %three step %one] {
    %sum = func.call @flash_next_q8_reference_dot(%width, %row, %id, %input, %weight) : (index, index, index, buffer, buffer) -> (f64)
    %packed = scalar.fptrunc %sum : f64 to bf16
    %reference = scalar.extf %packed : bf16 to f32
    %observed = view.load %source[%row, %id] : view<4x248320xf32> -> f32
    view.store %observed, %actuals[%row, %slot] : f32, view<3x8xf32>
    view.store %reference, %references[%row, %slot] : f32, view<3x8xf32>
  }
  kernel.return
}

check.case public @draft_heads_and_canonical_sampling {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %fallback = check.param.choice values([0, 1]) name("mixed_full_head") : index
  %input_seed = check.literal value(384781) : i64
  %input = check.generate.random.uniform seed(%input_seed) range(-0.125 to 0.125) : tensor<4x2560xbf16>
  // Every halfword made from bytes in [0, 30] is finite. The period varies
  // scales and codes across rows and blocks, without a stored weight fixture.
  %weight = check.generate.iota offset(0) step(1) period(31) : tensor<248320x80x34xi8>
  %epoch = check.generate.fill value(-7) : tensor<83xi32>
  %history = check.generate.fill value(-7) : tensor<4xi32>
  %anchors = check.generate.fill value(-7) : tensor<4xi32>
  %carry = check.generate.fill value(-7) : tensor<16x11008xi32>
  %plan = check.generate.fill value(-7) : tensor<20xi32>
  %sample_logits = check.generate.fill value(-4.0) : tensor<4x248320xf32>
  %predictions = check.generate.fill value(-7) : tensor<4xi32>
  %expected_ids = check.generate.fill value(-7) : tensor<4xi32>
  kernel.launch @setup(%fallback, %epoch, %history, %anchors, %sample_logits, %expected_ids) : (index, tensor<83xi32>, tensor<4xi32>, tensor<4xi32>, tensor<4x248320xf32>, tensor<4xi32>)
  kernel.launch @seed_histories(%history, %carry) : (tensor<4xi32>, tensor<16x11008xi32>)
  kernel.launch @flash_next_draft_plan(%epoch, %anchors, %carry, %plan) : (tensor<83xi32>, tensor<4xi32>, tensor<16x11008xi32>, tensor<20xi32>)
  %reference = check.generate.fill value(-17.0) : tensor<4x248320xf32>
  %expected = check.generate.fill value(-17.0) : tensor<4x248320xf32>
  %actual = check.generate.fill value(-17.0) : tensor<4x248320xf32>
  kernel.launch @flash_next_vocabulary(%epoch, %input, %weight, %reference) : (tensor<83xi32>, tensor<4x2560xbf16>, tensor<248320x80x34xi8>, tensor<4x248320xf32>)
  kernel.launch @select_reference(%fallback, %reference, %expected) : (index, tensor<4x248320xf32>, tensor<4x248320xf32>)
  kernel.launch @flash_next_draft_common_head(%epoch, %plan, %input, %weight, %actual) : (tensor<83xi32>, tensor<20xi32>, tensor<4x2560xbf16>, tensor<248320x80x34xi8>, tensor<4x248320xf32>)
  kernel.launch @flash_next_draft_rare_head(%epoch, %plan, %carry, %input, %weight, %actual) : (tensor<83xi32>, tensor<20xi32>, tensor<16x11008xi32>, tensor<4x2560xbf16>, tensor<248320x80x34xi8>, tensor<4x248320xf32>)
  check.expect.bitwise actual(%actual) expected(%expected) : tensor<4x248320xf32>
  %numerical = check.generate.fill value(0.0) : tensor<3x8xf32>
  %numerical_expected = check.generate.fill value(0.0) : tensor<3x8xf32>
  kernel.launch @numerical_reference(%input, %weight, %actual, %numerical, %numerical_expected) : (tensor<4x2560xbf16>, tensor<248320x80x34xi8>, tensor<4x248320xf32>, tensor<3x8xf32>, tensor<3x8xf32>)
  check.expect.close actual(%numerical) expected(%numerical_expected) atol(1.0000000000000001e-05) rtol(0.0080000000000000002) nan(different) : tensor<3x8xf32>
  kernel.launch @flash_next_draft_sample(%epoch, %plan, %carry, %sample_logits, %predictions) : (tensor<83xi32>, tensor<20xi32>, tensor<16x11008xi32>, tensor<4x248320xf32>, tensor<4xi32>)
  check.expect.bitwise actual(%predictions) expected(%expected_ids) : tensor<4xi32>
  check.return
}
