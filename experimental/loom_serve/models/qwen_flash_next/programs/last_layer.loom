config.decl @flash_next.token_count : %value: index where [range(%value, 1, 32768)]

kernel.decl @flash_next_finish_plan() launch(%epoch: buffer, %compact: buffer, %origins: buffer)
kernel.decl @flash_next_finish_gather() launch(%epoch: buffer, %origins: buffer, %residual: buffer, %mixed: buffer, %injection: buffer, %staging: buffer)
kernel.decl @flash_next_finish_publish() launch(%epoch: buffer, %origins: buffer, %residual: buffer, %mixed: buffer, %injection: buffer, %staging: buffer)
kernel.decl @flash_next_finish_scatter() launch(%epoch: buffer, %origins: buffer, %input: buffer, %output: buffer)
kernel.decl @flash_next_map_tokens() launch(%epoch: buffer, %mapping: buffer)
kernel.decl @hc_combine_normalize_inject() launch(%span: buffer, %residual: buffer, %projected: buffer, %injection: buffer, %gamma: buffer, %output: buffer, %normalized: buffer, %weight: buffer, %next_injection: buffer)
kernel.decl @hc_combine() launch(%span: buffer, %residual: buffer, %projected: buffer, %injection: buffer, %output: buffer)
command.program.decl @flash_next_qsa_append(%layer: index, %key_origin: offset, %value_origin: offset, %index_origin: offset, %tail_origin: offset) launch(%parameters: buffer, %span: buffer, %mapping: buffer, %rows: buffer, %input: buffer, %arena: buffer, %capture: buffer)
command.program.decl @flash_next_qsa_queries(%layer: index, %key_origin: offset, %value_origin: offset, %index_origin: offset, %tail_origin: offset) launch(%parameters: buffer, %span: buffer, %mapping: buffer, %rows: buffer, %input: buffer, %arena: buffer, %output: buffer, %capture: buffer)
command.program.decl @flash_next_hc_mix_normalized(%down_weight: view<3481600xi8>, %up_weight: view<3481600xi8>) launch(%span: buffer, %normalized: buffer, %mixed: buffer)
command.program.decl @flash_next_route(%layer: index) launch(%parameters: buffer, %span: buffer, %input: buffer, %ids: buffer, %weights: buffer, %shared_gate: buffer)
command.program.decl @flash_next_experts(%layer: index) launch(%parameters: buffer, %span: buffer, %input: buffer, %ids: buffer, %weights: buffer, %shared_gate: buffer, %output: buffer)

// The output-only epoch reaches this boundary after the final input mixer.
// Append every cache row before compacting scratch: later requests need all
// K/V/indexer history, including chunks that produce no sampled output.
command.program.def public @flash_next_finish_output(%layer: index, %key_origin: offset, %value_origin: offset, %index_origin: offset, %tail_origin: offset) launch(%parameters: buffer, %epoch: buffer, %mapping: buffer, %rows: buffer, %arena: buffer, %residual: buffer, %mixed: buffer, %injection: buffer, %output: buffer, %capture: buffer) {
  command.program.launch @flash_next_qsa_append[%layer, %key_origin, %value_origin, %index_origin, %tail_origin](%parameters, %epoch, %mapping, %rows, %mixed, %arena, %capture) : [index, offset, offset, offset, offset](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  %descriptor_bytes = index.constant 332 : offset
  %origin_bytes = index.constant 256 : offset
  %staging_bytes = index.constant 1639424 : offset
  %compact = buffer.alloca<global> align(16) %descriptor_bytes : buffer
  %origins = buffer.alloca<global> align(16) %origin_bytes : buffer
  %staging = buffer.alloca<global> align(256) %staging_bytes : buffer
  kernel.launch @flash_next_finish_plan(%epoch, %compact, %origins) : (buffer, buffer, buffer)
  kernel.launch @flash_next_finish_gather(%compact, %origins, %residual, %mixed, %injection, %staging) : (buffer, buffer, buffer, buffer, buffer, buffer)
  kernel.launch @flash_next_finish_publish(%compact, %origins, %residual, %mixed, %injection, %staging) : (buffer, buffer, buffer, buffer, buffer, buffer)
  // The full mapping has no remaining consumer after cache append. Compact
  // descriptors preserve absolute positions and resident physical-page owners.
  kernel.launch @flash_next_map_tokens(%compact, %mapping) : (buffer, buffer)
  %tokens = config.get @flash_next.token_count : index
  %residual_stride = index.constant 20480 : offset
  %hidden_stride = index.constant 5120 : offset
  %injection_stride = index.constant 16 : offset
  %selection_stride = index.constant 40 : offset
  %gate_stride = index.constant 4 : offset
  %residual_bytes = index.scale %tokens, %residual_stride : index, offset -> offset
  %hidden_bytes = index.scale %tokens, %hidden_stride : index, offset -> offset
  %injection_bytes = index.scale %tokens, %injection_stride : index, offset -> offset
  %selection_bytes = index.scale %tokens, %selection_stride : index, offset -> offset
  %gate_bytes = index.scale %tokens, %gate_stride : index, offset -> offset
  %projected = buffer.alloca<global> align(256) %hidden_bytes : buffer
  command.program.launch @flash_next_qsa_queries[%layer, %key_origin, %value_origin, %index_origin, %tail_origin](%parameters, %compact, %mapping, %rows, %mixed, %arena, %projected, %capture) : [index, offset, offset, offset, offset](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  %attention = buffer.alloca<global> align(256) %residual_bytes : buffer
  %normalized = buffer.alloca<global> align(256) %residual_bytes : buffer
  %ffn_injection = buffer.alloca<global> align(256) %injection_bytes : buffer
  %gamma = command.parameter %parameters, "blk.{}.hc_ffn_norm.weight"[%layer] : view<4x2560xf32>
  %down_weight = command.parameter %parameters, "blk.{}.hc_ffn_down.weight"[%layer] : view<3481600xi8>
  %up_weight = command.parameter %parameters, "blk.{}.hc_ffn_up.weight"[%layer] : view<3481600xi8>
  %inject_weight = command.parameter %parameters, "blk.{}.hc_ffn_inject.weight"[%layer] : view<4x10240xf32>
  kernel.launch @hc_combine_normalize_inject(%compact, %residual, %projected, %injection, %gamma, %attention, %normalized, %inject_weight, %ffn_injection) : (buffer, buffer, buffer, buffer, view<4x2560xf32>, buffer, buffer, view<4x10240xf32>, buffer)
  %ffn_mixed = buffer.alloca<global> align(256) %hidden_bytes : buffer
  command.program.launch @flash_next_hc_mix_normalized[%down_weight, %up_weight](%compact, %normalized, %ffn_mixed) : [view<3481600xi8>, view<3481600xi8>](buffer, buffer, buffer)
  %ids = buffer.alloca<global> align(256) %selection_bytes : buffer
  %weights = buffer.alloca<global> align(256) %selection_bytes : buffer
  %shared_gate = buffer.alloca<global> align(256) %gate_bytes : buffer
  command.program.launch @flash_next_route[%layer](%parameters, %compact, %ffn_mixed, %ids, %weights, %shared_gate) : [index](buffer, buffer, buffer, buffer, buffer, buffer)
  %branch = buffer.alloca<global> align(256) %hidden_bytes : buffer
  command.program.launch @flash_next_experts[%layer](%parameters, %compact, %ffn_mixed, %ids, %weights, %shared_gate, %branch) : [index](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  // Input residual is dead after the normalization/combine above. Reuse its
  // storage for compact results, then scatter to the distinct caller output.
  kernel.launch @hc_combine(%compact, %attention, %branch, %ffn_injection, %residual) : (buffer, buffer, buffer, buffer, buffer)
  kernel.launch @flash_next_finish_scatter(%compact, %origins, %residual, %output) : (buffer, buffer, buffer, buffer)
  command.return
}
