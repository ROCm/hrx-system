        AMDGPU_HARDWARE_PROFILE,
        AMDGPU_ACCESS_PROFILE,
        AMDGPU_TSAN_PROFILE,
    ],
    deps = [":residual_programs"],
)

loom_test(
    name = "quantized_test",
    srcs = ["tests/quantized.loom"],
    benchmark_smoke = False,
    execution_profiles = [
        AMDGPU_HARDWARE_PROFILE,
        AMDGPU_ACCESS_PROFILE,
    ],
    deps = [":residual_programs"],
