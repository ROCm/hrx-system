loom_test(
    name = "speculation_test",
    srcs = [
        "tests/speculation.loom",
    ],
    benchmark_smoke = False,
    configs = {
        "flash_next.span_capacity": "5",
        "flash_next.token_count": "20",
        "flash_next.verification_width": "4",
    },
    execution_profiles = [
        AMDGPU_HARDWARE_PROFILE,
        AMDGPU_ACCESS_PROFILE,
    ],
    deps = [":residual_programs"],
