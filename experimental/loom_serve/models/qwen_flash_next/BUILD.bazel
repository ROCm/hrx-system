loom_test(
    name = "head_test",
    srcs = ["tests/head.loom"],
    benchmark_smoke = False,
    configs = {
        "flash_next.span_capacity": "4",
        "flash_next.token_count": "8",
        "flash_next.verification_width": "4",
    },
    execution_profiles = [
        AMDGPU_HARDWARE_PROFILE,
        AMDGPU_ACCESS_PROFILE,
    ],
    deps = [":residual_programs"],
