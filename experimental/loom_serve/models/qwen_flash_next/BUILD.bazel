load("@rules_python//python:defs.bzl", "py_binary")
load("//loom/build_tools/bazel:defs.bzl", "loom_library", "loom_test")
load("//loom/target/amdgpu:execution_profiles.bzl", "AMDGPU_ACCESS_PROFILE", "AMDGPU_HARDWARE_PROFILE", "AMDGPU_TSAN_PROFILE")

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "sources",
    srcs = [
        "model.json",
        "//experimental/loom_serve/models/qwen:speculation_kernels",
        "//experimental/loom_serve/models/qwen:text_control",
        "//experimental/loom_serve/motifs/ggml:sources",
        "//experimental/loom_serve/motifs/tensor:sources",
    ] + glob([
        "*.loom",
        "kernels/*.loom",
        "programs/*.loom",
    ]),
    visibility = ["//visibility:public"],
)

py_binary(
    name = "check_service",
    testonly = True,
    srcs = ["check_service.py"],
    deps = [
        "//loom/src/loom/serve/testing:chat",
        "//loom/src/loom/serve/testing:http",
    ],
)

loom_library(
    name = "residual_programs",
    srcs = glob([
        "kernels/*.loom",
        "programs/*.loom",
    ]) + [
        "config.loom",
        "//experimental/loom_serve/models/qwen:speculation_library",
        "//experimental/loom_serve/motifs/ggml:library",
        "//experimental/loom_serve/motifs/tensor:library",
    ],
)

[
    loom_test(
        name = name + "_test",
        srcs = ["tests/" + name + ".loom"],
        benchmark_smoke = False,
        configs = {
            "flash_next.context_capacity": "2112",
            "flash_next.pool_capacity": "2112",
            "flash_next.token_count": "8",
        },
        execution_profiles = [
            AMDGPU_HARDWARE_PROFILE,
            AMDGPU_ACCESS_PROFILE,
        ],
        deps = [":residual_programs"],
    )
    for name in [
        "attention",
        "iq4",
        "retained",
        "selection",
    ]
]

loom_test(
    name = "projection_test",
    srcs = ["tests/projection.loom"],
    benchmark_smoke = False,
    configs = {"flash_next.token_count": "19"},
    execution_profiles = [
        AMDGPU_HARDWARE_PROFILE,
        AMDGPU_ACCESS_PROFILE,
    ],
    deps = [
        ":q8_reference",
        ":residual_programs",
    ],
)

loom_library(
    name = "q8_reference",
    srcs = ["tests/q8_reference.loom"],
)

[
    loom_test(
        name = "hyperconnection_{}_test".format(capacity),
        srcs = ["tests/hyperconnection.loom"],
        benchmark_smoke = False,
        configs = {"flash_next.token_count": str(capacity)},
        execution_profiles = [
            AMDGPU_HARDWARE_PROFILE,
            AMDGPU_ACCESS_PROFILE,
            AMDGPU_TSAN_PROFILE,
        ],
        deps = [
            ":q8_reference",
            ":residual_programs",
        ],
    )
    for capacity in [
        1,
        5,
    ]
]

[
    loom_test(
        name = "prepared_q8_{}_test".format(capacity),
        srcs = ["tests/prepared_q8.loom"],
        benchmark_smoke = False,
        configs = {"flash_next.token_count": str(capacity)},
        execution_profiles = [
            AMDGPU_HARDWARE_PROFILE,
            AMDGPU_ACCESS_PROFILE,
        ],
        deps = [
            ":q8_reference",
            ":residual_programs",
        ],
    )
    for capacity in [
        1,
        4,
        33,
    ]
]

loom_test(
    name = "gdn_test",
