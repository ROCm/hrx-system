loom_test(
    name = "mtp_state_test",
    srcs = ["tests/mtp_state.loom"],
    benchmark_smoke = False,
    configs = {
        "flash_next.span_capacity": "4",
        "flash_next.token_count": "16",
    },
    execution_profiles = [
        AMDGPU_HARDWARE_PROFILE,
