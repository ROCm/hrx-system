loom_test(
    name = "mtp_test",
    srcs = ["tests/mtp.loom"],
    benchmark_smoke = False,
    configs = {"flash_next.token_count": "2"},
    execution_profiles = [
        AMDGPU_HARDWARE_PROFILE,
