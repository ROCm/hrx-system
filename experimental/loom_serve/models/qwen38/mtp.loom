// One compact proposal step. Committed target carry is separate from hidden,
// which is overwritten after its last read and carried only within a proposal.

config.decl @runner.qwen38.prefill_token_count : %value: index where [range(%value, 1, 512)]
config.decl @runner.qwen38.span_capacity : %value: index where [range(%value, 1, 64)]

command.program.decl @qwen38_attention_layer_prefill(%token_count: index, %schedule_token_count: index, %layer: index, %attention_ordinal: index, %verification_depth: index, %span_capacity: index) launch(%parameters: buffer, %residual: buffer, %attention_cache: buffer, %control: buffer, %attention_output: buffer, %rows: buffer) where [range(%token_count, 1, 512), range(%schedule_token_count, 1, 512), range(%layer, 0, 64), range(%attention_ordinal, 0, 15), range(%verification_depth, 0, 4), range(%span_capacity, 0, 64)]
command.program.decl @qwen38_output_projection_greedy(%token_count: index, %normalized_origin: offset, %output_origin: offset) launch(%parameters: buffer, %normalized: buffer, %token_id: buffer) where [range(%token_count, 1, 64)]
kernel.decl @qwen38_linear_q8_0_f16_wmma_x128(%token_count: index, %input_size: index, %output_size: index) launch(%control: buffer, %input_size_data: index, %output_size_data: index, %input: buffer, %weight: buffer, %output: buffer)
kernel.decl @qwen38_linear_q6k_f16_wmma_x64(%token_count: index, %input_size: index, %output_size: index) launch(%control: buffer, %input_size_data: index, %output_size_data: index, %input: buffer, %weight: buffer, %output: buffer)
kernel.decl @qwen38_linear_q6k_f16_wmma_c64t32_f32acc(%token_count: index, %input_size: index, %output_size: index) launch(%control: buffer, %input_size_data: index, %output_size_data: index, %input: buffer, %weight: buffer, %output: buffer)
kernel.decl @qwen38_linear_q6k_f16_wmma_metadata_x128(%token_count: index, %input_size: index, %output_size: index) launch(%control: buffer, %input_size_data: index, %output_size_data: index, %input: buffer, %weight: buffer, %output: buffer)
kernel.decl @qwen38_attention_kv_prepare_spans(%token_capacity: index, %span_capacity: index) launch(%epoch: buffer, %rows: buffer, %layer_origin: offset, %epsilon: f32, %key_projection: buffer, %value_projection: buffer, %weight: buffer, %state: buffer)
kernel.decl @qwen38_mtp_rmsnorm_concat_embedding_f32_prefill(%token_count: index) launch(%token_capacity: index, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer)
kernel.decl @qwen38_mtp_rmsnorm_concat_hidden_f32_prefill(%token_count: index) launch(%token_capacity: index, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer)
kernel.decl @qwen38_token_embedding_q5k_f32_prefill(%token_count: index) launch(%token_ids: buffer, %weight: buffer, %output: buffer)
kernel.decl @qwen38_rmsnorm_f32_prefill(%token_count: index) launch(%token_capacity: index, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer)
kernel.decl @qwen38_mtp_shift_spans(%span_capacity: index) launch(%epoch: buffer, %normalized: buffer, %carry: buffer, %shifted: buffer)
kernel.decl @qwen38_mtp_save_carry(%span_capacity: index) launch(%epoch: buffer, %normalized: buffer, %carry: buffer)
kernel.decl @qwen38_mtp_gather_carry(%span_capacity: index) launch(%epoch: buffer, %carry: buffer, %hidden: buffer)
kernel.decl @qwen38_mtp_proposal_prepare() launch(%epoch: buffer, %target_tokens: buffer, %draft: buffer, %origins: buffer, %draft_tokens: buffer)
kernel.decl @qwen38_mtp_proposal_advance(%round: index) launch(%round_value: index, %draft: buffer, %origins: buffer, %predictions: buffer, %draft_tokens: buffer, %target_tokens: buffer)

// Materializes the pairing token[P], target_hidden[P-1] and rewrites private
// MTP KV from committed inputs. Only the K/V path is needed: query, attention
// output and feed-forward results have no consumer during catch-up. Separate
// parameter roots bind views of the proposal block's existing weight storage.
// Carry publication cannot race readers of the preceding committed hidden row.
command.program.def public @qwen38_mtp_warm() launch(%embedding_parameters: buffer, %input_parameters: buffer, %attention_norm_parameters: buffer, %key_parameters: buffer, %key_norm_parameters: buffer, %value_parameters: buffer, %norm_parameters: buffer, %target_residual: buffer, %epoch: buffer, %rows: buffer, %cache: buffer, %carry: buffer, %input_tokens: buffer) {
  %tokens = config.get @runner.qwen38.prefill_token_count : index
  %spans = config.get @runner.qwen38.span_capacity : index
  %capacity = index.constant 512 : index
  %hidden_size = index.constant 5120 : index
  %concat_size = index.constant 10240 : index
  %key_value_size = index.constant 1024 : index
  %zero = index.constant 0 : index
  %thirty_two = index.constant 32 : index
  %sixty_five = index.constant 65 : index
  %uses_narrow = index.cmp ult, %tokens, %sixty_five : index
  %uses_thirty_two = index.cmp eq, %tokens, %thirty_two : index
  %narrow_tokens = scf.if %uses_narrow -> (index) {
    scf.yield %tokens : index
  } else {
    scf.yield %zero : index
  }
  %thirty_two_tokens = scf.if %uses_thirty_two -> (index) {
    scf.yield %tokens : index
  } else {
    scf.yield %zero : index
  }
  %wide_tokens = scf.if %uses_narrow -> (index) {
    scf.yield %zero : index
  } else {
    scf.yield %tokens : index
  }
  %epsilon = scalar.constant 0.000001 : f32
  %embedding_weight = command.parameter %embedding_parameters, "token_embd.weight" : view<874086400xi8>
  %embedding_norm = command.parameter %input_parameters, "blk.64.nextn.enorm.weight" : view<5120xf32>
  %hidden_norm = command.parameter %input_parameters, "blk.64.nextn.hnorm.weight" : view<5120xf32>
  %embedding_hidden_weight = command.parameter %input_parameters, "blk.64.nextn.eh_proj.weight" : view<55705600xi8>
  %attention_norm_weight = command.parameter %attention_norm_parameters, "blk.64.attn_norm.weight" : view<5120xf32>
  %key_weight = command.parameter %key_parameters, "blk.64.attn_k.weight" : view<4300800xi8>
  %key_norm_weight = command.parameter %key_norm_parameters, "blk.64.attn_k_norm.weight" : view<256xf32>
  %value_weight = command.parameter %value_parameters, "blk.64.attn_v.weight" : view<5570560xi8>
  %target_norm = command.parameter %norm_parameters, "output_norm.weight" : view<5120xf32>
  %hidden_bytes = index.constant 10485760 : offset
  %concat_bytes = index.constant 20971520 : offset
  %key_value_bytes = index.constant 2097152 : offset
  %embedding = buffer.alloca<global> align(256) %hidden_bytes : buffer
  %normalized = buffer.alloca<global> align(256) %hidden_bytes : buffer
  %shifted = buffer.alloca<global> align(256) %hidden_bytes : buffer
  %concat = buffer.alloca<global> align(256) %concat_bytes : buffer
  %residual = buffer.alloca<global> align(256) %hidden_bytes : buffer
  command.concurrent {
    kernel.launch @qwen38_rmsnorm_f32_prefill[%tokens](%capacity, %epsilon, %target_residual, %target_norm, %normalized) : [index](index, f32, buffer, view<5120xf32>, buffer)
    kernel.launch @qwen38_token_embedding_q5k_f32_prefill[%tokens](%input_tokens, %embedding_weight, %embedding) : [index](buffer, view<874086400xi8>, buffer)
  }
  kernel.launch @qwen38_mtp_shift_spans[%spans](%epoch, %normalized, %carry, %shifted) : [index](buffer, buffer, buffer, buffer)
  kernel.launch @qwen38_mtp_save_carry[%spans](%epoch, %normalized, %carry) : [index](buffer, buffer, buffer)
  command.concurrent {
    kernel.launch @qwen38_mtp_rmsnorm_concat_embedding_f32_prefill[%tokens](%capacity, %epsilon, %embedding, %embedding_norm, %concat) : [index](index, f32, buffer, view<5120xf32>, buffer)
    kernel.launch @qwen38_mtp_rmsnorm_concat_hidden_f32_prefill[%tokens](%capacity, %epsilon, %shifted, %hidden_norm, %concat) : [index](index, f32, buffer, view<5120xf32>, buffer)
  }
  kernel.launch @qwen38_linear_q8_0_f16_wmma_x128[%tokens, %concat_size, %hidden_size](%epoch, %concat_size, %hidden_size, %concat, %embedding_hidden_weight, %residual) : [index, index, index](buffer, index, index, buffer, view<55705600xi8>, buffer)
  %attention_normalized = buffer.alloca<global> align(256) %hidden_bytes : buffer
  %key_projection = buffer.alloca<global> align(256) %key_value_bytes : buffer
  %value_projection = buffer.alloca<global> align(256) %key_value_bytes : buffer
  kernel.launch @qwen38_rmsnorm_f32_prefill[%tokens](%capacity, %epsilon, %residual, %attention_norm_weight, %attention_normalized) : [index](index, f32, buffer, view<5120xf32>, buffer)
  command.concurrent {
    scf.if %uses_narrow {
      scf.if %uses_thirty_two {
        kernel.launch @qwen38_linear_q6k_f16_wmma_c64t32_f32acc[%thirty_two_tokens, %hidden_size, %key_value_size](%epoch, %hidden_size, %key_value_size, %attention_normalized, %key_weight, %key_projection) : [index, index, index](buffer, index, index, buffer, view<4300800xi8>, buffer)
      } else {
        kernel.launch @qwen38_linear_q6k_f16_wmma_x64[%narrow_tokens, %hidden_size, %key_value_size](%epoch, %hidden_size, %key_value_size, %attention_normalized, %key_weight, %key_projection) : [index, index, index](buffer, index, index, buffer, view<4300800xi8>, buffer)
      }
    } else {
      kernel.launch @qwen38_linear_q6k_f16_wmma_metadata_x128[%wide_tokens, %hidden_size, %key_value_size](%epoch, %hidden_size, %key_value_size, %attention_normalized, %key_weight, %key_projection) : [index, index, index](buffer, index, index, buffer, view<4300800xi8>, buffer)
    }
    kernel.launch @qwen38_linear_q8_0_f16_wmma_x128[%tokens, %hidden_size, %key_value_size](%epoch, %hidden_size, %key_value_size, %attention_normalized, %value_weight, %value_projection) : [index, index, index](buffer, index, index, buffer, view<5570560xi8>, buffer)
  }
  %cache_origin = index.constant 0 : offset
  kernel.launch @qwen38_attention_kv_prepare_spans[%tokens, %spans](%epoch, %rows, %cache_origin, %epsilon, %key_projection, %value_projection, %key_norm_weight, %cache) : [index, index](buffer, buffer, offset, f32, buffer, buffer, view<256xf32>, buffer)
  command.return
}

command.program.def @qwen38_mtp_draft() launch(%embedding_parameters: buffer, %input_parameters: buffer, %layer_parameters: buffer, %head_parameters: buffer, %output_parameters: buffer, %residual: buffer, %epoch: buffer, %rows: buffer, %cache: buffer, %hidden: buffer, %input_tokens: buffer, %output_tokens: buffer) {
  %tokens = config.get @runner.qwen38.prefill_token_count : index
  %spans = config.get @runner.qwen38.span_capacity : index
  %capacity = index.constant 512 : index
  %hidden_size = index.constant 5120 : index
  %concat_size = index.constant 10240 : index
  %layer = index.constant 64 : index
  %zero = index.constant 0 : index
  %three = index.constant 3 : index
  %four = index.constant 4 : index
  %padded_spans = index.add %spans, %three : index
  %groups = index.div %padded_spans, %four : index
  %outputs = index.mul %groups, %four : index
  %epsilon = scalar.constant 0.000001 : f32
  %embedding_weight = command.parameter %embedding_parameters, "token_embd.weight" : view<874086400xi8>
  %embedding_norm = command.parameter %input_parameters, "blk.64.nextn.enorm.weight" : view<5120xf32>
  %hidden_norm = command.parameter %input_parameters, "blk.64.nextn.hnorm.weight" : view<5120xf32>
  %embedding_hidden_weight = command.parameter %input_parameters, "blk.64.nextn.eh_proj.weight" : view<55705600xi8>
  %head_norm = command.parameter %head_parameters, "blk.64.nextn.shared_head_norm.weight" : view<5120xf32>

  %hidden_bytes = index.constant 10485760 : offset
  %concat_bytes = index.constant 20971520 : offset
  %attention_bytes = index.constant 12582912 : offset
  %embedding = buffer.alloca<global> align(256) %hidden_bytes : buffer
  %concat = buffer.alloca<global> align(256) %concat_bytes : buffer
  %attention = buffer.alloca<global> align(256) %attention_bytes : buffer
  kernel.launch @qwen38_token_embedding_q5k_f32_prefill[%tokens](%input_tokens, %embedding_weight, %embedding) : [index](buffer, view<874086400xi8>, buffer)
  command.concurrent {
    kernel.launch @qwen38_mtp_rmsnorm_concat_embedding_f32_prefill[%tokens](%capacity, %epsilon, %embedding, %embedding_norm, %concat) : [index](index, f32, buffer, view<5120xf32>, buffer)
    kernel.launch @qwen38_mtp_rmsnorm_concat_hidden_f32_prefill[%tokens](%capacity, %epsilon, %hidden, %hidden_norm, %concat) : [index](index, f32, buffer, view<5120xf32>, buffer)
  }
  kernel.launch @qwen38_linear_q8_0_f16_wmma_x128[%tokens, %concat_size, %hidden_size](%epoch, %concat_size, %hidden_size, %concat, %embedding_hidden_weight, %residual) : [index, index, index](buffer, index, index, buffer, view<55705600xi8>, buffer)
  command.program.launch @qwen38_attention_layer_prefill[%tokens, %tokens, %layer, %zero, %zero, %spans](%layer_parameters, %residual, %cache, %epoch, %attention, %rows) : [index, index, index, index, index, index](buffer, buffer, buffer, buffer, buffer, buffer)
  kernel.launch @qwen38_rmsnorm_f32_prefill[%tokens](%capacity, %epsilon, %residual, %head_norm, %hidden) : [index](index, f32, buffer, view<5120xf32>, buffer)
  %origin = index.constant 0 : offset
  command.program.launch @qwen38_output_projection_greedy[%outputs, %origin, %origin](%output_parameters, %hidden, %output_tokens) : [index, offset, offset](buffer, buffer, buffer)
  command.return
}

// Three autoregressive proposals remain in device storage from committed
// carry through target verification. The transient allocator shares the same
// residency workspace as the target; no per-round queue transfer or host wait
// is needed. Only spans requesting generated candidates enter the draft batch.
command.program.def public @qwen38_mtp_propose() launch(%embedding_parameters: buffer, %input_parameters: buffer, %layer_parameters: buffer, %head_parameters: buffer, %output_parameters: buffer, %epoch: buffer, %target_tokens: buffer, %rows: buffer, %cache: buffer, %carry: buffer) {
  %spans = config.get @runner.qwen38.span_capacity : index
  %control_bytes = index.constant 1548 : offset
  %token_bytes = index.constant 2048 : offset
  %output_bytes = index.constant 32 : offset
  %hidden_bytes = index.constant 10485760 : offset
  %draft = buffer.alloca<global> align(256) %control_bytes : buffer
  %origins = buffer.alloca<global> align(256) %output_bytes : buffer
  %input_tokens = buffer.alloca<global> align(256) %token_bytes : buffer
  %output_tokens = buffer.alloca<global> align(256) %output_bytes : buffer
  %hidden = buffer.alloca<global> align(256) %hidden_bytes : buffer
  %residual = buffer.alloca<global> align(256) %hidden_bytes : buffer
  kernel.launch @qwen38_mtp_proposal_prepare(%epoch, %target_tokens, %draft, %origins, %input_tokens) : (buffer, buffer, buffer, buffer, buffer)
  kernel.launch @qwen38_mtp_gather_carry[%spans](%draft, %carry, %hidden) : [index](buffer, buffer, buffer)
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %three = index.constant 3 : index
  scf.for %round = [%zero to %three step %one] unroll {
    command.program.launch @qwen38_mtp_draft[](%embedding_parameters, %input_parameters, %layer_parameters, %head_parameters, %output_parameters, %residual, %draft, %rows, %cache, %hidden, %input_tokens, %output_tokens) : [](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
    kernel.launch @qwen38_mtp_proposal_advance[%round](%round, %draft, %origins, %output_tokens, %input_tokens, %target_tokens) : [index](index, buffer, buffer, buffer, buffer, buffer)
  }
  command.return
}
