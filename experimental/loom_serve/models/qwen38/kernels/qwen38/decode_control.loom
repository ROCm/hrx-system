// Device-resident generation control and token-history updates.

kernel.def export("qwen38_decode_commit_token") @qwen38_decode_commit_token() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%control: buffer, %token_ids: buffer, %progress: buffer) {
  %c0_offset = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c1_i32 = scalar.constant 1 : i32
  %control_view = buffer.view %control[%c0_offset] : buffer -> view<3xi32>
  %token_ids_view = buffer.view %token_ids[%c0_offset] : buffer -> view<129xi32>
  %progress_view = buffer.view %progress[%c0_offset] : buffer -> view<8xi32>
  %position = view.load %control_view[%c0] : view<3xi32> -> i32
  %generated_count = view.load %control_view[%c1] : view<3xi32> -> i32
  %eos_token = view.load %control_view[2] : view<3xi32> -> i32
  %generated_count0 = index.cast %generated_count : i32 to index
  %generated_index0 = index.add %generated_count0, %c1 : index
  %generated_index = index.assume %generated_index0 [range(%generated_index0, 1, 128)] : index
  %token_id = view.load %token_ids_view[%c0] : view<129xi32> -> i32
  %is_eos = scalar.cmpi eq, %token_id, %eos_token : i32
  %c0_i32 = scalar.constant 0 : i32
  %done = scf.select %is_eos, %c1_i32, %c0_i32 : i32
  %next_position = scalar.addi %position, %c1_i32 : i32
  %next_generated_count = scalar.addi %generated_count, %c1_i32 : i32
  view.store %token_id, %token_ids_view[%generated_index] : i32, view<129xi32>
  view.store %next_position, %control_view[%c0] : i32, view<3xi32>
  view.store %next_generated_count, %control_view[%c1] : i32, view<3xi32>
  view.store %next_generated_count, %progress_view[0] : i32, view<8xi32>
  view.store %done, %progress_view[7] : i32, view<8xi32>
  kernel.return
}

kernel.def @qwen38_decode_read_history_index3() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%token_ids: buffer, %result: buffer) {
  %c0_offset = index.constant 0 : offset
  %token_ids_view = buffer.view %token_ids[%c0_offset] : buffer -> view<5xi32>
  %result_view = buffer.view %result[%c0_offset] : buffer -> view<1xi32>
  %token_id = view.load %token_ids_view[3] : view<5xi32> -> i32
  view.store %token_id, %result_view[0] : i32, view<1xi32>
  kernel.return
}

check.case public @qwen38_decode_commit_token_case {
  %control = check.generate.iota offset(41) step(-39) : tensor<3xi32>
  %token_ids = check.generate.iota offset(7) step(-1) : tensor<5xi32>
  %progress = check.generate.fill value(0) : tensor<8xi32>
  %committed_token = check.generate.fill value(-1) : tensor<1xi32>
  %expected_control = check.generate.iota offset(42) step(-39) : tensor<2xi32>
  %expected_token = check.generate.fill value(7) : tensor<1xi32>
  kernel.launch @qwen38_decode_commit_token(%control, %token_ids, %progress) : (tensor<3xi32>, tensor<5xi32>, tensor<8xi32>)
  kernel.launch @qwen38_decode_read_history_index3(%token_ids, %committed_token) : (tensor<5xi32>, tensor<1xi32>)
  %control_pair = check.tensor.view %control offset(0) : tensor<3xi32> -> tensor<2xi32>
  %progress_count = check.tensor.view %progress offset(0) : tensor<8xi32> -> tensor<1xi32>
  %progress_done = check.tensor.view %progress offset(28) : tensor<8xi32> -> tensor<1xi32>
  %expected_count = check.generate.fill value(3) : tensor<1xi32>
  %expected_done = check.generate.fill value(0) : tensor<1xi32>
  check.expect.equal actual(%control_pair) expected(%expected_control) : tensor<2xi32>
  check.expect.equal actual(%committed_token) expected(%expected_token) : tensor<1xi32>
  check.expect.equal actual(%progress_count) expected(%expected_count) : tensor<1xi32>
  check.expect.equal actual(%progress_done) expected(%expected_done) : tensor<1xi32>
  check.return
}

// Converts the prefill control pair [token_count, position_base] in place to
// the decode pair [next_position, generated_count] and preserves the first
// selected token in the device-resident output history.
kernel.def export("qwen38_prefill_finish_control") @qwen38_prefill_finish_control() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%control: buffer, %token_ids: buffer, %progress: buffer) {
  %c0_offset = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %control_view = buffer.view %control[%c0_offset] : buffer -> view<3xi32>
  %token_ids_view = buffer.view %token_ids[%c0_offset] : buffer -> view<129xi32>
  %progress_view = buffer.view %progress[%c0_offset] : buffer -> view<8xi32>
  %token_count = view.load %control_view[%c0] : view<3xi32> -> i32
  %position_base = view.load %control_view[%c1] : view<3xi32> -> i32
  %eos_token = view.load %control_view[2] : view<3xi32> -> i32
  %first_token = view.load %token_ids_view[%c0] : view<129xi32> -> i32
  %is_eos = scalar.cmpi eq, %first_token, %eos_token : i32
  %next_position = scalar.addi %position_base, %token_count : i32
  view.store %next_position, %control_view[%c0] : i32, view<3xi32>
  %c1_i32 = scalar.constant 1 : i32
  %c0_i32 = scalar.constant 0 : i32
  %done = scf.select %is_eos, %c1_i32, %c0_i32 : i32
  view.store %c1_i32, %control_view[%c1] : i32, view<3xi32>
  view.store %first_token, %token_ids_view[%c1] : i32, view<129xi32>
  view.store %c1_i32, %progress_view[0] : i32, view<8xi32>
  view.store %done, %progress_view[7] : i32, view<8xi32>
  kernel.return
}

kernel.def @qwen38_prefill_read_history_index1() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%token_ids: buffer, %result: buffer) {
  %c0_offset = index.constant 0 : offset
  %token_ids_view = buffer.view %token_ids[%c0_offset] : buffer -> view<5xi32>
  %result_view = buffer.view %result[%c0_offset] : buffer -> view<1xi32>
  %token_id = view.load %token_ids_view[1] : view<5xi32> -> i32
  view.store %token_id, %result_view[0] : i32, view<1xi32>
  kernel.return
}

check.case public @qwen38_prefill_finish_control_case {
  %control = check.generate.iota offset(3) step(14) : tensor<3xi32>
  %token_ids = check.generate.iota offset(7) step(-1) : tensor<5xi32>
  %progress = check.generate.fill value(0) : tensor<8xi32>
  %committed_token = check.generate.fill value(-1) : tensor<1xi32>
  %expected = check.generate.iota offset(20) step(-19) : tensor<2xi32>
  %expected_token = check.generate.fill value(7) : tensor<1xi32>
  kernel.launch @qwen38_prefill_finish_control(%control, %token_ids, %progress) : (tensor<3xi32>, tensor<5xi32>, tensor<8xi32>)
  kernel.launch @qwen38_prefill_read_history_index1(%token_ids, %committed_token) : (tensor<5xi32>, tensor<1xi32>)
  %control_pair = check.tensor.view %control offset(0) : tensor<3xi32> -> tensor<2xi32>
  %progress_count = check.tensor.view %progress offset(0) : tensor<8xi32> -> tensor<1xi32>
  %progress_done = check.tensor.view %progress offset(28) : tensor<8xi32> -> tensor<1xi32>
  %expected_count = check.generate.fill value(1) : tensor<1xi32>
  %expected_done = check.generate.fill value(0) : tensor<1xi32>
  check.expect.equal actual(%control_pair) expected(%expected) : tensor<2xi32>
  check.expect.equal actual(%committed_token) expected(%expected_token) : tensor<1xi32>
  check.expect.equal actual(%progress_count) expected(%expected_count) : tensor<1xi32>
  check.expect.equal actual(%progress_done) expected(%expected_done) : tensor<1xi32>
  check.return
}
