kernel.decl @qwen38_ffn_gate_up_q5k_f16_wmma_c64_t128_wave32_owned_output_f16(%token_capacity: index, %input_size: index, %output_size: index) launch(%token_count_data: buffer, %input_size: index, %output_size: index, %input: buffer, %gate_weight: buffer, %up_weight: buffer, %output: buffer)
kernel.decl @qwen38_ffn_gate_up_q5k_f16_wmma_c64_t128_wave32_output_f16(%token_capacity: index, %input_size: index, %output_size: index) launch(%token_count_data: buffer, %input_size: index, %output_size: index, %input: buffer, %gate_weight: buffer, %up_weight: buffer, %output: buffer)

// Distinct activation rows and channel-varying packed weights exercise packet
// boundaries. Restricting weight bytes to [0, 31] keeps block scales finite.
// The paired-wave schedule provides independent staging and output ownership.
check.case public @ffn_gate_up_block_tails {
  %capacity = check.literal value(256) : index
  %hidden = check.literal value(768) : index
  %blocks = check.literal value(3) : index
  %channels = check.literal value(65) : index
  %count = check.generate.fill value(129) : tensor<1xi32>
  %seed = check.param.seed base(42961) count(3) name("seed") : i64
  %up_seed = check.literal value(89213) : i64
  %input = check.generate.random.uniform seed(%seed) range(-1.0 to 1.0) : tensor<256x[%hidden]xf16>
  %gate = check.generate.random.uniform seed(%seed) range(0 to 31) : tensor<65x[%blocks]x176xi8>
  %up = check.generate.random.uniform seed(%up_seed) range(0 to 31) : tensor<65x[%blocks]x176xi8>
  %expected = check.generate.fill value(-13.0) : tensor<256x65xf16>
  %actual = check.generate.fill value(-13.0) : tensor<256x65xf16>
  kernel.launch @qwen38_ffn_gate_up_q5k_f16_wmma_c64_t128_wave32_output_f16[%capacity, %hidden, %channels](%count, %hidden, %channels, %input, %gate, %up, %expected) : [index, index, index](tensor<1xi32>, index, index, tensor<256x[%hidden]xf16>, tensor<65x[%blocks]x176xi8>, tensor<65x[%blocks]x176xi8>, tensor<256x65xf16>)
  kernel.launch @qwen38_ffn_gate_up_q5k_f16_wmma_c64_t128_wave32_owned_output_f16[%capacity, %hidden, %channels](%count, %hidden, %channels, %input, %gate, %up, %actual) : [index, index, index](tensor<1xi32>, index, index, tensor<256x[%hidden]xf16>, tensor<65x[%blocks]x176xi8>, tensor<65x[%blocks]x176xi8>, tensor<256x65xf16>)
  check.expect.bitwise actual(%actual) expected(%expected) : tensor<256x65xf16>
  check.return
}
check.benchmark<@ffn_gate_up_block_tails> @ffn_gate_up_block_tails_benchmark

check.case public @ffn_gate_up_full_shape {
  %capacity = check.literal value(128) : index
  %hidden = check.literal value(5120) : index
  %blocks = check.literal value(20) : index
  %channels = check.literal value(17408) : index
  %count = check.generate.fill value(127) : tensor<1xi32>
  %seed = check.param.seed base(42961) count(3) name("seed") : i64
  %up_seed = check.literal value(89213) : i64
  %input = check.generate.random.uniform seed(%seed) range(-1.0 to 1.0) : tensor<128x[%hidden]xf16>
  %gate = check.generate.random.uniform seed(%seed) range(0 to 31) : tensor<17408x[%blocks]x176xi8>
  %up = check.generate.random.uniform seed(%up_seed) range(0 to 31) : tensor<17408x[%blocks]x176xi8>
  %expected = check.generate.fill value(-13.0) : tensor<128x17408xf16>
  %actual = check.generate.fill value(-13.0) : tensor<128x17408xf16>
  kernel.launch @qwen38_ffn_gate_up_q5k_f16_wmma_c64_t128_wave32_output_f16[%capacity, %hidden, %channels](%count, %hidden, %channels, %input, %gate, %up, %expected) : [index, index, index](tensor<1xi32>, index, index, tensor<128x[%hidden]xf16>, tensor<17408x[%blocks]x176xi8>, tensor<17408x[%blocks]x176xi8>, tensor<128x17408xf16>)
  kernel.launch @qwen38_ffn_gate_up_q5k_f16_wmma_c64_t128_wave32_owned_output_f16[%capacity, %hidden, %channels](%count, %hidden, %channels, %input, %gate, %up, %actual) : [index, index, index](tensor<1xi32>, index, index, tensor<128x[%hidden]xf16>, tensor<17408x[%blocks]x176xi8>, tensor<17408x[%blocks]x176xi8>, tensor<128x17408xf16>)
  check.expect.bitwise actual(%actual) expected(%expected) : tensor<128x17408xf16>
  check.return
}
check.benchmark<@ffn_gate_up_full_shape> @ffn_gate_up_full_shape_benchmark
