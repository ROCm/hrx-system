// Convolution input/output is packed; history and startup position follow
// the resident request. Overlap tails remain owned by that request across
// changing batch membership. Weights and biases broadcast with zero strides.
template.decl @pocket.batch.member(%membership: buffer) -> (i1, index, index)

template.decl pure @pocket.batch.origin(%row: index, %offset: offset, %stride: offset) -> (offset)

template.decl @pocket.transpose_convolution.body(%elements: index, %inputs: index, %times: index, %outputs: index, %raw_times: index, %group_outputs: index, %extent: index, %stride: index, %group_inputs: index, %x_storage: buffer, %w_storage: buffer, %y_storage: buffer, %x_origin: offset, %w_origin: offset, %y_origin: offset)

template.decl @pocket.batch.transpose_convolution(%membership: buffer, %elements: index, %inputs: index, %times: index, %outputs: index, %raw_times: index, %group_outputs: index, %extent: index, %stride: index, %group_inputs: index, %x_storage: buffer, %w_storage: buffer, %y_storage: buffer, %x_offset: offset, %x_stride: offset, %w_offset: offset, %w_stride: offset, %y_offset: offset, %y_stride: offset)

template.def<@pocket.batch.transpose_convolution> device @pocket_batch_transpose_convolution(%membership: buffer, %elements: index, %inputs: index, %times: index, %outputs: index, %raw_times: index, %group_outputs: index, %extent: index, %stride: index, %group_inputs: index, %x_storage: buffer, %w_storage: buffer, %y_storage: buffer, %x_offset: offset, %x_stride: offset, %w_offset: offset, %w_stride: offset, %y_offset: offset, %y_stride: offset) {
  %active, %packed, %resident = template.apply<@pocket.batch.member>(%membership) : (buffer) -> (i1, index, index)
  scf.if %active {
    %x_origin = template.apply<@pocket.batch.origin>(%packed, %x_offset, %x_stride) pure : (index, offset, offset) -> (offset)
    %w_origin = template.apply<@pocket.batch.origin>(%packed, %w_offset, %w_stride) pure : (index, offset, offset) -> (offset)
    %y_origin = template.apply<@pocket.batch.origin>(%packed, %y_offset, %y_stride) pure : (index, offset, offset) -> (offset)
    template.apply<@pocket.transpose_convolution.body>(%elements, %inputs, %times, %outputs, %raw_times, %group_outputs, %extent, %stride, %group_inputs, %x_storage, %w_storage, %y_storage, %x_origin, %w_origin, %y_origin) : (index, index, index, index, index, index, index, index, index, buffer, buffer, buffer, offset, offset, offset)
  }
  template.return
}

template.decl @pocket.overlap.body(%elements: index, %outputs: index, %raw_times: index, %length: index, %overlap: index, %x_storage: buffer, %history_storage: buffer, %y_storage: buffer, %x_origin: offset, %history_origin: offset, %y_origin: offset)

