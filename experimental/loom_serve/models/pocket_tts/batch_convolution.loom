  scf.if %active {
    %x_origin = template.apply<@pocket.batch.origin>(%packed, %x_offset, %x_stride) pure : (index, offset, offset) -> (offset)
    %history_origin = template.apply<@pocket.batch.origin>(%resident, %history_offset, %history_stride) pure : (index, offset, offset) -> (offset)
    %padded_origin = template.apply<@pocket.batch.origin>(%packed, %padded_offset, %padded_stride) pure : (index, offset, offset) -> (offset)
    template.apply<@pocket.history.body>(%elements, %channels, %times, %history_length, %padded_times, %x_storage, %history_storage, %padded_storage, %x_origin, %history_origin, %padded_origin) : (index, index, index, index, index, buffer, buffer, buffer, offset, offset, offset)
  }
  template.return
}

