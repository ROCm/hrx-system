    %y_origin = template.apply<@pocket.batch.origin>(%packed, %y_offset, %y_stride) pure : (index, offset, offset) -> (offset)
    template.apply<@pocket.overlap.body>(%elements, %outputs, %raw_times, %length, %overlap, %x_storage, %history_storage, %y_storage, %x_origin, %history_origin, %y_origin) : (index, index, index, index, index, buffer, buffer, buffer, offset, offset, offset)
  }
  template.return
}

