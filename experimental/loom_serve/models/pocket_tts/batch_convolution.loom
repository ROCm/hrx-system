config.decl @pocket.threads : %value: index where [range(%value, 1, 256)]

// Dispatch entry points specialize source geometry. Membership remains a
// runtime packet; changing request progress never changes the compiled shape.
target.decl @pocket

config.decl @pocket.batch_capacity : %value: index where [range(%value, 1, 65536)]

kernel.def target(@pocket) @pocket.batch.transpose_convolution_512x512_t1_g1x1_s16_kernel() {
  %elements = index.constant 16384 : index
  %threads = config.get @pocket.threads : index
  %one = index.constant 1 : index
  %tail = index.sub %threads, %one : index
  %rounded = index.add %elements, %tail : index
  %groups = index.div %rounded, %threads : index
  %batch_capacity = config.get @pocket.batch_capacity : index
  kernel.launch.config workgroups(%groups, %one, %batch_capacity) workgroup_size(%threads, %one, %one) : index
} launch(%membership: buffer, %x_storage: buffer, %w_storage: buffer, %y_storage: buffer, %x_offset: offset, %x_stride: offset, %w_offset: offset, %w_stride: offset, %y_offset: offset, %y_stride: offset) {
  %elements = index.constant 16384 : index
  %inputs = index.constant 512 : index
  %times = index.constant 1 : index
  %outputs = index.constant 512 : index
  %raw_times = index.constant 32 : index
  %group_outputs = index.constant 1 : index
  %extent = index.constant 32 : index
  %stride = index.constant 16 : index
  %group_inputs = index.constant 1 : index
  template.apply<@pocket.batch.transpose_convolution>(%membership, %elements, %inputs, %times, %outputs, %raw_times, %group_outputs, %extent, %stride, %group_inputs, %x_storage, %w_storage, %y_storage, %x_offset, %x_stride, %w_offset, %w_stride, %y_offset, %y_stride) : (buffer, index, index, index, index, index, index, index, index, index, buffer, buffer, buffer, offset, offset, offset, offset, offset, offset)
  kernel.return
}

kernel.def target(@pocket) @pocket.batch.overlap_512x16_h16_kernel() {
  %elements = index.constant 512 : index
  %threads = config.get @pocket.threads : index
  %one = index.constant 1 : index
  %tail = index.sub %threads, %one : index
  %rounded = index.add %elements, %tail : index
  %groups = index.div %rounded, %threads : index
  %batch_capacity = config.get @pocket.batch_capacity : index
  kernel.launch.config workgroups(%groups, %one, %batch_capacity) workgroup_size(%threads, %one, %one) : index
} launch(%membership: buffer, %x_storage: buffer, %history_storage: buffer, %y_storage: buffer, %x_offset: offset, %x_stride: offset, %history_offset: offset, %history_stride: offset, %y_offset: offset, %y_stride: offset) {
  %elements = index.constant 512 : index
  %outputs = index.constant 512 : index
  %raw_times = index.constant 32 : index
  %length = index.constant 16 : index
  %overlap = index.constant 16 : index
  template.apply<@pocket.batch.overlap>(%membership, %elements, %outputs, %raw_times, %length, %overlap, %x_storage, %history_storage, %y_storage, %x_offset, %x_stride, %history_offset, %history_stride, %y_offset, %y_stride) : (buffer, index, index, index, index, index, buffer, buffer, buffer, offset, offset, offset, offset, offset, offset)
  kernel.return
}

