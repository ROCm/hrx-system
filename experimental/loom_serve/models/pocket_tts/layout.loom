config.decl @pocket.context_capacity : %value: index where [range(%value, 1, 65536)]

template.decl @pocket.flow_state_size(%capacity: index) -> (offset)

template.decl @pocket.state_size(%capacity: index) -> (offset)

template.decl @pocket.flow_cache_origin(%layer: index) -> (offset)

template.decl @pocket.codec_state_origin(%relative: offset) -> (offset)

// The header contains three absolute positions, one reserved word, and the
// normalized 32-element latent. Six full-context layers follow, each with an
// F32 key/value pair of capacity x 1024. Codec state follows this prefix and
// has fixed size because Mimi alone uses a bounded causal attention window.
template.def<@pocket.flow_state_size> @pocket_flow_state_size(%capacity: index) -> (offset) {
  %header = index.constant 144 : offset
  %position_bytes = index.constant 49152 : offset
  %caches = index.scale %capacity, %position_bytes : index, offset -> offset
  %length = index.add %header, %caches : offset
  template.return %length : offset
}

template.def<@pocket.state_size> @pocket_state_size(%capacity: index) -> (offset) {
  %flow = template.apply<@pocket.flow_state_size>(%capacity) : (index) -> (offset)
  %codec = index.constant 4450840 : offset
  %length = index.add %flow, %codec : offset
  template.return %length : offset
}

template.def<@pocket.flow_cache_origin> @pocket_flow_cache_origin(%layer: index) -> (offset) {
  %capacity = config.get @pocket.context_capacity : index
  %pair_bytes = index.constant 8192 : offset
  %header = index.constant 144 : offset
  %layer_bytes = index.scale %capacity, %pair_bytes : index, offset -> offset
  %relative = index.scale %layer, %layer_bytes : index, offset -> offset
  %origin = index.add %header, %relative : offset
  template.return %origin : offset
}

template.def<@pocket.codec_state_origin> @pocket_codec_state_origin(%relative: offset) -> (offset) {
  %capacity = config.get @pocket.context_capacity : index
  %flow = template.apply<@pocket.flow_state_size>(%capacity) : (index) -> (offset)
  %origin = index.add %flow, %relative : offset
  template.return %origin : offset
}
