config.decl @pocket.context_capacity : %value: index where [range(%value, 1, 65536)]

template.decl pure @pocket.flow_state_words(%capacity: index) -> (index)

template.decl pure @pocket.state_words(%capacity: index) -> (index)

template.decl pure @pocket.flow_state_size(%capacity: index) -> (offset)

template.decl pure @pocket.state_size(%capacity: index) -> (offset)

template.decl pure @pocket.flow_cache_origin(%layer: index) -> (offset)

template.decl pure @pocket.codec_state_origin(%relative: offset) -> (offset)

// The header contains three absolute positions, one reserved word, and the
// normalized 32-element latent. Six full-context layers follow, each with an
// F32 key/value pair of capacity x 1024. Codec state follows this prefix and
// has fixed size because Mimi alone uses a bounded causal attention window.
template.def<@pocket.flow_state_words> pure @pocket_flow_state_words(%capacity: index) -> (index) {
  %header = index.constant 36 : index
  %position_words = index.constant 12288 : index
  %caches = index.mul %capacity, %position_words : index
  %length = index.add %header, %caches : index
  template.return %length : index
}

template.def<@pocket.state_words> pure @pocket_state_words(%capacity: index) -> (index) {
  %flow = template.apply<@pocket.flow_state_words>(%capacity) pure : (index) -> (index)
  %codec = index.constant 1112710 : index
  %length = index.add %flow, %codec : index
  template.return %length : index
}

template.def<@pocket.flow_state_size> pure @pocket_flow_state_size(%capacity: index) -> (offset) {
  %words = template.apply<@pocket.flow_state_words>(%capacity) pure : (index) -> (index)
  %word_bytes = index.constant 4 : offset
  %length = index.scale %words, %word_bytes : index, offset -> offset
  template.return %length : offset
}

template.def<@pocket.state_size> pure @pocket_state_size(%capacity: index) -> (offset) {
  %words = template.apply<@pocket.state_words>(%capacity) pure : (index) -> (index)
  %word_bytes = index.constant 4 : offset
  %length = index.scale %words, %word_bytes : index, offset -> offset
  template.return %length : offset
}

template.def<@pocket.flow_cache_origin> pure @pocket_flow_cache_origin(%layer: index) -> (offset) {
  %capacity = config.get @pocket.context_capacity : index
  %pair_bytes = index.constant 8192 : offset
  %header = index.constant 144 : offset
  %layer_bytes = index.scale %capacity, %pair_bytes : index, offset -> offset
  %relative = index.scale %layer, %layer_bytes : index, offset -> offset
  %origin = index.add %header, %relative : offset
  template.return %origin : offset
}

template.def<@pocket.codec_state_origin> pure @pocket_codec_state_origin(%relative: offset) -> (offset) {
  %capacity = config.get @pocket.context_capacity : index
  %flow = template.apply<@pocket.flow_state_size>(%capacity) pure : (index) -> (offset)
  %origin = index.add %flow, %relative : offset
  template.return %origin : offset
}
