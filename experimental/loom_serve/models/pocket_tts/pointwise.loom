  %elements = index.constant 8192 : index
  %threads = config.get @pocket.threads : index
  %one = index.constant 1 : index
  %tail = index.sub %threads, %one : index
  %rounded = index.add %elements, %tail : index
  %groups = index.div %rounded, %threads : index
  kernel.launch.config workgroups(%groups, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%x_storage: buffer, %update_storage: buffer, %y_storage: buffer, %scale_storage: buffer) {
  %elements = index.constant 8192 : index
  %channels = index.constant 512 : index
  %times = index.constant 16 : index
  %residual_scaled_origin = index.constant 0 : offset
  template.apply<@pocket.residual_scaled.body>(%elements, %channels, %times, %x_storage, %update_storage, %y_storage, %scale_storage, %residual_scaled_origin, %residual_scaled_origin, %residual_scaled_origin, %residual_scaled_origin) : (index, index, index, buffer, buffer, buffer, buffer, offset, offset, offset, offset)
  kernel.return
}

template.decl @pocket.elu.body(%elements: index, %x_storage: buffer, %y_storage: buffer, %x_origin: offset, %y_origin: offset)

template.def<@pocket.elu.body> device @elu_body(%elements: index, %x_storage: buffer, %y_storage: buffer, %x_origin: offset, %y_origin: offset) {
  %element = template.apply<@pocket.element>() : () -> (index)
  %f0 = scalar.constant 0.0 : f32
  %live = index.cmp ult, %element, %elements : index
  scf.if %live {
    %x_view = buffer.view %x_storage[%x_origin] : buffer -> view<[%elements]xf32>
    %y_view = buffer.view %y_storage[%y_origin] : buffer -> view<[%elements]xf32>
    %value = view.load %x_view[%element] : view<[%elements]xf32> -> f32
    %positive = scalar.cmpf oge, %value, %f0 : f32
    %activated = scf.if %positive -> (f32) {
      scf.yield %value : f32
    } else {
      %exponential = scalar.expf<afn> %value : f32
      %f1 = scalar.constant 1.0 : f32
      %negative = scalar.subf %exponential, %f1 : f32
      scf.yield %negative : f32
    }
    view.store %activated, %y_view[%element] : f32, view<[%elements]xf32>
  }
  template.return
}

