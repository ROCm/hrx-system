template.decl @pocket.silu.body(%elements: index, %x_storage: buffer, %y_storage: buffer, %x_origin: offset, %y_origin: offset)

template.def<@pocket.silu.body> device @silu_body(%elements: index, %x_storage: buffer, %y_storage: buffer, %x_origin: offset, %y_origin: offset) {
  %element = template.apply<@pocket.element>() : () -> (index)
  %f0 = scalar.constant 0.0 : f32
  %live = index.cmp ult, %element, %elements : index
  scf.if %live {
    %x_view = buffer.view %x_storage[%x_origin] : buffer -> view<[%elements]xf32>
    %y_view = buffer.view %y_storage[%y_origin] : buffer -> view<[%elements]xf32>
    %value = view.load %x_view[%element] : view<[%elements]xf32> -> f32
    %negative = scalar.subf %f0, %value : f32
    %exponential = scalar.expf<afn> %negative : f32
    %f1 = scalar.constant 1.0 : f32
    %denominator = scalar.addf %f1, %exponential : f32
    %activated = scalar.divf %value, %denominator : f32
    view.store %activated, %y_view[%element] : f32, view<[%elements]xf32>
  }
  template.return
}

kernel.def target(@pocket) @pocket.silu_512() {
  %elements = index.constant 512 : index
  %threads = config.get @pocket.threads : index
  %one = index.constant 1 : index
  %tail = index.sub %threads, %one : index
  %rounded = index.add %elements, %tail : index
  %groups = index.div %rounded, %threads : index
  kernel.launch.config workgroups(%groups, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%x_storage: buffer, %y_storage: buffer) {
  %elements = index.constant 512 : index
  %silu_origin = index.constant 0 : offset
  template.apply<@pocket.silu.body>(%elements, %x_storage, %y_storage, %silu_origin, %silu_origin) : (index, buffer, buffer, offset, offset)
  kernel.return
}

template.decl @pocket.residual_scaled.body(%elements: index, %channels: index, %times: index, %x_storage: buffer, %update_storage: buffer, %y_storage: buffer, %scale_storage: buffer, %x_origin: offset, %update_origin: offset, %y_origin: offset, %scale_origin: offset)

template.def<@pocket.residual_scaled.body> device @residual_scaled_body(%elements: index, %channels: index, %times: index, %x_storage: buffer, %update_storage: buffer, %y_storage: buffer, %scale_storage: buffer, %x_origin: offset, %update_origin: offset, %y_origin: offset, %scale_origin: offset) {
  %element = template.apply<@pocket.element>() : () -> (index)
  %live = index.cmp ult, %element, %elements : index
  scf.if %live {
    %x_view = buffer.view %x_storage[%x_origin] : buffer -> view<[%channels]x[%times]xf32>
    %update_view = buffer.view %update_storage[%update_origin] : buffer -> view<[%channels]x[%times]xf32>
    %y_view = buffer.view %y_storage[%y_origin] : buffer -> view<[%channels]x[%times]xf32>
    %scale_view = buffer.view %scale_storage[%scale_origin] : buffer -> view<[%channels]xbf16>
    %row = index.div %element, %times : index
    %column = index.rem %element, %times : index
    %base = view.load %x_view[%row, %column] : view<[%channels]x[%times]xf32> -> f32
    %delta = view.load %update_view[%row, %column] : view<[%channels]x[%times]xf32> -> f32
    %factor_stored = view.load %scale_view[%row] : view<[%channels]xbf16> -> bf16
    %factor = scalar.extf %factor_stored : bf16 to f32
    %scaled = scalar.mulf %delta, %factor : f32
    %combined = scalar.addf %base, %scaled : f32
    view.store %combined, %y_view[%row, %column] : f32, view<[%channels]x[%times]xf32>
  }
  template.return
}

