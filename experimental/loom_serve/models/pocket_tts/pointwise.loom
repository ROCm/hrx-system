template.decl @pocket.copy.body(%elements: index, %x_storage: buffer, %y_storage: buffer, %x_origin: offset, %y_origin: offset)

template.def<@pocket.copy.body> device @copy_body(%elements: index, %x_storage: buffer, %y_storage: buffer, %x_origin: offset, %y_origin: offset) {
  %element = template.apply<@pocket.element>() : () -> (index)
  %live = index.cmp ult, %element, %elements : index
  scf.if %live {
    %x_view = buffer.view %x_storage[%x_origin] : buffer -> view<[%elements]xf32>
    %y_view = buffer.view %y_storage[%y_origin] : buffer -> view<[%elements]xf32>
    %value = view.load %x_view[%element] : view<[%elements]xf32> -> f32
    view.store %value, %y_view[%element] : f32, view<[%elements]xf32>
  }
  template.return
}

