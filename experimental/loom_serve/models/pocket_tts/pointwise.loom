// Independent F32 maps and residual updates. Distinct input and output views
// preserve values that remain live across the source-composed command graph.
target.decl @pocket

config.decl @pocket.threads : %value: index where [range(%value, 1, 256)]

template.decl @pocket.element() -> (index)

template.decl @pocket.residual.body(%elements: index, %channels: index, %times: index, %x_storage: buffer, %update_storage: buffer, %y_storage: buffer, %x_origin: offset, %update_origin: offset, %y_origin: offset)

template.def<@pocket.residual.body> device @residual_body(%elements: index, %channels: index, %times: index, %x_storage: buffer, %update_storage: buffer, %y_storage: buffer, %x_origin: offset, %update_origin: offset, %y_origin: offset) {
  %element = template.apply<@pocket.element>() : () -> (index)
  %live = index.cmp ult, %element, %elements : index
  scf.if %live {
    %x_view = buffer.view %x_storage[%x_origin] : buffer -> view<[%channels]x[%times]xf32>
    %update_view = buffer.view %update_storage[%update_origin] : buffer -> view<[%channels]x[%times]xf32>
    %y_view = buffer.view %y_storage[%y_origin] : buffer -> view<[%channels]x[%times]xf32>
    %row = index.div %element, %times : index
    %column = index.rem %element, %times : index
    %base = view.load %x_view[%row, %column] : view<[%channels]x[%times]xf32> -> f32
    %delta = view.load %update_view[%row, %column] : view<[%channels]x[%times]xf32> -> f32

    %combined = scalar.addf %base, %delta : f32
    view.store %combined, %y_view[%row, %column] : f32, view<[%channels]x[%times]xf32>
  }
  template.return
}

kernel.def target(@pocket) @pocket.residual_1024x1() {
  %elements = index.constant 1024 : index
  %threads = config.get @pocket.threads : index
  %one = index.constant 1 : index
  %tail = index.sub %threads, %one : index
  %rounded = index.add %elements, %tail : index
  %groups = index.div %rounded, %threads : index
  kernel.launch.config workgroups(%groups, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%x_storage: buffer, %update_storage: buffer, %y_storage: buffer) {
  %elements = index.constant 1024 : index
  %channels = index.constant 1024 : index
  %times = index.constant 1 : index
  %residual_origin = index.constant 0 : offset
  template.apply<@pocket.residual.body>(%elements, %channels, %times, %x_storage, %update_storage, %y_storage, %residual_origin, %residual_origin, %residual_origin) : (index, index, index, buffer, buffer, buffer, offset, offset, offset)
  kernel.return
}

