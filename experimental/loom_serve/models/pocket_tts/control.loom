          %packet = buffer.view %packets[%packet_origin] : buffer -> view<4xi32>
          %tokens = view.load %packet[0] : view<4xi32> -> i32
          scf.yield %tokens : i32
        }
        %finished = scalar.cmpi eq, %next, %limit : i32
        %next_cursor = scf.select %finished, %zero, %next : i32
        %next_phase = scalar.addi %phase, %one : i32
        %phase_after = scf.select %finished, %next_phase, %phase : i32
        view.store %phase_after, %header[0] : i32, view<7xi32>
        view.store %next_cursor, %header[1] : i32, view<7xi32>
      }
    }
    scf.yield %zero64, %zero64 : i64, i64
  }
  func.return %state, %input_state, %normalizer, %normalized, %encoder, %sentences, %sentence_ids, %decoded, %prefix, %suffix, %groups, %group_text, %packets, %tokens, %sentence_set, %fallback_set, %position, %offset, %frames, %zero : buffer, buffer, buffer, buffer, input.encoder, buffer, buffer, buffer, input.decoder, input.decoder, buffer, buffer, buffer, buffer, buffer, buffer, i64, i64, i64, i32
}
