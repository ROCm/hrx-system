func.decl import("runner") @execute_5(%stage: i32, %work: hal.buffer, %request: hal.buffer, %conditioning: hal.buffer, %stream: hal.buffer, %output: hal.buffer) -> (i64)

func.decl import("runner") @feedback(%slot: i32, %source: hal.buffer, %offset: i64, %length: i64) -> (i64)

func.decl @pocket.check(%condition: i1, %diagnostic: buffer)

func.decl @pocket.voice_record(%model: buffer, %voice: i32) -> (view<4xi32>)

func.decl @pocket.input_create(%raw_limit: offset, %input_limit: index) -> (buffer, buffer, buffer, input.encoder, buffer, buffer, buffer, input.decoder, input.decoder, buffer, buffer, buffer, buffer, buffer, buffer)

func.decl @pocket.input_work(%state: buffer, %groups: buffer) -> (i32)

func.decl @pocket.input_prepare(%input_state: buffer, %normalizer: buffer, %normalized: buffer, %encoder: input.encoder, %sentences: buffer, %sentence_ids: buffer, %decoded: buffer, %prefix: input.decoder, %suffix: input.decoder, %groups: buffer, %group_text: buffer, %packets: buffer, %tokens: buffer, %sentence_set: buffer, %fallback_set: buffer, %text: buffer, %byte_offset: i64, %final: i32, %chunk_limit: index, %input_limit: index) -> (buffer, i64)

func.decl @pocket.packets_peek(%state: buffer) -> (i64, i64, i32)

func.decl @pocket.packets_consume(%state: buffer)

template.decl pure @pocket.packet_stride(%tokens: index) -> (offset)

template.decl pure @pocket.batch_work_header_size(%capacity: index) -> (offset)

template.decl pure @pocket.batch_work_size(%capacity: index) -> (offset)

// Pocket TTS requires speed 1 and empty instructions
global.rodata.def @pocket.request_error = bytes("506f636b657420545453207265717569726573207370656564203120616e6420656d70747920696e737472756374696f6e73")

// unknown registered Pocket TTS voice
global.rodata.def @pocket.voice_error = bytes("756e6b6e6f776e207265676973746572656420506f636b65742054545320766f696365")

// Pocket TTS did not terminate within the admitted generation extent
global.rodata.def @pocket.termination_error = bytes("506f636b65742054545320646964206e6f74207465726d696e6174652077697468696e207468652061646d69747465642067656e65726174696f6e20657874656e74")

// Pocket TTS produced a nonfinite EOS score
global.rodata.def @pocket.eos_error = bytes("506f636b6574205454532070726f64756365642061206e6f6e66696e69746520454f532073636f7265")

func.def @pocket.select_voice(%model: buffer, %voice: buffer) -> (i32, i32) {
  %origin = index.constant 0 : offset
  %header = buffer.view %model[%origin] : buffer -> view<12xi32>
  %count32 = view.load %header[7] : view<12xi32> -> i32
  %count = index.cast %count32 : i32 to index
  %length = buffer.length %voice
  %length64 = index.cast %length : offset to i64
  %begin = index.constant 0 : index
  %one = index.constant 1 : index
  %record_bytes = index.constant 80 : offset
  %header_bytes = index.constant 48 : offset
  %id_offset = index.constant 16 : offset
  %zero = scalar.constant 0 : i32
  %missing = scalar.constant -1 : i32
  %selected, %frames = scf.for %i = [%begin to %count step %one](%selected = %missing : i32, %frames = %zero : i32) -> (i32, i32) {
    %ordinal = index.cast %i : index to i32
    %record = func.call @pocket.voice_record(%model, %ordinal) : (buffer, i32) -> (view<4xi32>)
    %id_length32 = view.load %record[0] : view<4xi32> -> i32
    %id_length = scalar.extui %id_length32 : i32 to i64
    %same_length = scalar.cmpi eq, %id_length, %length64 : i64
    %matches = scf.if %same_length -> (i1) {
      %relative = index.scale %i, %record_bytes : index, offset -> offset
      %record_begin = index.add %header_bytes, %relative : offset
      %id_begin = index.add %record_begin, %id_offset : offset
      %order = buffer.compare %voice[%origin], %model[%id_begin], %length
      %equal = scalar.cmpi eq, %order, %zero : i32
      scf.yield %equal : i1
    } else {
      %false = scalar.constant false : i1
      scf.yield %false : i1
    }
    %entry_frames = view.load %record[1] : view<4xi32> -> i32
    %next_selected = scf.select %matches, %ordinal, %selected : i32
    %next_frames = scf.select %matches, %entry_frames, %frames : i32
    scf.yield %next_selected, %next_frames : i32, i32
  }
  %found = scalar.cmpi ne, %selected, %missing : i32
  %error = global.load @pocket.voice_error : buffer
  func.call @pocket.check(%found, %error) : (i1, buffer)
  func.return %selected, %frames : i32, i32
}

// Numerical request fields at byte offsets:
//  0: next numerical phase, advanced only after retirement.
//  4: current voice block or text token within that phase.
//  8: immutable registered voice ordinal.
// 12: immutable voice frame count.
// 16: absolute packet ordinal, also the sampling counter identity.
// 20: generated block index within the current packet.
// 24: first eligible EOS block, or -1 before prediction.
// 28: alignment padding before the I64 playback position.
// 32: cumulative published audio position in frames.
// Text owners and reusable packet storage are separate from numerical state.
func.def public @prepare_request(%model: buffer, %voice: buffer, %instructions: buffer, %seed: i64, %speed: f32) -> (buffer, buffer, buffer, buffer, input.encoder, buffer, buffer, buffer, input.decoder, input.decoder, buffer, buffer, buffer, buffer, buffer, buffer, buffer) {
  %origin = index.constant 0 : offset
  %instruction_bytes = buffer.length %instructions
  %plain = index.cmp eq, %instruction_bytes, %origin : offset
  %normal = scalar.constant 1.0 : f32
  %normal_speed = scalar.cmpf oeq, %speed, %normal : f32
  %supported = scalar.andi %plain, %normal_speed : i1
  %error = global.load @pocket.request_error : buffer
  func.call @pocket.check(%supported, %error) : (i1, buffer)
  %voice_id, %voice_frames = func.call @pocket.select_voice(%model, %voice) : (buffer, buffer) -> (i32, i32)
  %model_header = buffer.view %model[%origin] : buffer -> view<12xi32>
  %input_limit32 = view.load %model_header[3] : view<12xi32> -> i32
  %input_limit = index.cast %input_limit32 : i32 to index
  %raw_limit32 = view.load %model_header[10] : view<12xi32> -> i32
  %raw_limit_value = scalar.assume %raw_limit32 [range(%raw_limit32, 1, 16777216)] : i32
  %raw_limit = index.cast %raw_limit_value : i32 to offset
  %input_state, %normalizer, %normalized, %encoder, %sentences, %sentence_ids, %decoded, %prefix, %suffix, %groups, %group_text, %packets, %tokens, %sentence_set, %fallback_set = func.call @pocket.input_create(%raw_limit, %input_limit) : (offset, index) -> (buffer, buffer, buffer, input.encoder, buffer, buffer, buffer, input.decoder, input.decoder, buffer, buffer, buffer, buffer, buffer, buffer)
  %state_bytes = index.constant 40 : offset
  %state = buffer.alloca<private> align(8) %state_bytes : buffer
  %zero = scalar.constant 0 : i32
  buffer.fill %zero, %state[%origin], %state_bytes : i32
  %header = buffer.view %state[%origin] : buffer -> view<7xi32>
  view.store %voice_id, %header[2] : i32, view<7xi32>
  view.store %voice_frames, %header[3] : i32, view<7xi32>
  %missing = scalar.constant -1 : i32
  view.store %missing, %header[6] : i32, view<7xi32>
  %payload_bytes = index.constant 16 : offset
  %payload = buffer.alloca<private> align(8) %payload_bytes : buffer
  buffer.fill %zero, %payload[%origin], %payload_bytes : i32
  %seed_view = buffer.view %payload[%origin] : buffer -> view<1xi64>
  view.store %seed, %seed_view[0] : i64, view<1xi64>
  func.return %state, %input_state, %normalizer, %normalized, %encoder, %sentences, %sentence_ids, %decoded, %prefix, %suffix, %groups, %group_text, %packets, %tokens, %sentence_set, %fallback_set, %payload : buffer, buffer, buffer, buffer, input.encoder, buffer, buffer, buffer, input.decoder, input.decoder, buffer, buffer, buffer, buffer, buffer, buffer, buffer
}

func.def public @prepare_input(%model: buffer, %state: buffer, %input_state: buffer, %normalizer: buffer, %normalized: buffer, %encoder: input.encoder, %sentences: buffer, %sentence_ids: buffer, %decoded: buffer, %prefix: input.decoder, %suffix: input.decoder, %groups: buffer, %group_text: buffer, %packets: buffer, %tokens: buffer, %sentence_set: buffer, %fallback_set: buffer, %text: buffer, %byte_offset: i64, %final: i32) -> (buffer, buffer, buffer, buffer, input.encoder, buffer, buffer, buffer, input.decoder, input.decoder, buffer, buffer, buffer, buffer, buffer, buffer, i64) {
  %origin = index.constant 0 : offset
  %header = buffer.view %model[%origin] : buffer -> view<12xi32>
  %chunk_limit32 = view.load %header[2] : view<12xi32> -> i32
  %input_limit32 = view.load %header[3] : view<12xi32> -> i32
  %chunk_limit = index.cast %chunk_limit32 : i32 to index
  %input_limit = index.cast %input_limit32 : i32 to index
  %next_packets, %consumed = func.call @pocket.input_prepare(%input_state, %normalizer, %normalized, %encoder, %sentences, %sentence_ids, %decoded, %prefix, %suffix, %groups, %group_text, %packets, %tokens, %sentence_set, %fallback_set, %text, %byte_offset, %final, %chunk_limit, %input_limit) : (buffer, buffer, buffer, input.encoder, buffer, buffer, buffer, input.decoder, input.decoder, buffer, buffer, buffer, buffer, buffer, buffer, buffer, i64, i32, index, index) -> (buffer, i64)
  func.return %state, %input_state, %normalizer, %normalized, %encoder, %sentences, %sentence_ids, %decoded, %prefix, %suffix, %groups, %group_text, %next_packets, %tokens, %sentence_set, %fallback_set, %consumed : buffer, buffer, buffer, buffer, input.encoder, buffer, buffer, buffer, input.decoder, input.decoder, buffer, buffer, buffer, buffer, buffer, buffer, i64
}

func.def @pocket.current_packet(%model: buffer, %groups: buffer) -> (offset) {
  %origin = index.constant 0 : offset
  %header = buffer.view %model[%origin] : buffer -> view<12xi32>
  %tokens32 = view.load %header[2] : view<12xi32> -> i32
  %tokens = index.cast %tokens32 : i32 to index
  %position, %unused_count, %unused_complete = func.call @pocket.packets_peek(%groups) : (buffer) -> (i64, i64, i32)
  %packet = index.cast %position : i64 to index
  %stride = template.apply<@pocket.packet_stride>(%tokens) pure : (index) -> (offset)
  %relative = index.scale %packet, %stride : index, offset -> offset
  func.return %relative : offset
}

// A cache hit can replace unfinished private voice preparation at a retired
// cut. The offer changes neither the request cursor nor cache publication.
func.def @pocket.numerical_work(%model: buffer, %state: buffer, %groups: buffer, %packets: buffer) -> (buffer, i64, i64) {
  %origin = index.constant 0 : offset
  %header = buffer.view %state[%origin] : buffer -> view<7xi32>
  %phase = view.load %header[0] : view<7xi32> -> i32
  %voice = view.load %header[2] : view<7xi32> -> i32
  %record = func.call @pocket.voice_record(%model, %voice) : (buffer, i32) -> (view<4xi32>)
  %cached = view.load %record[2] : view<4xi32> -> i32
  %zero = scalar.constant 0 : i32
  %restore = scalar.constant 4 : i32
  %preparing_voice = scalar.cmpi ult, %phase, %restore : i32
  %ready = scalar.cmpi ne, %cached, %zero : i32
  %reuse = scalar.andi %preparing_voice, %ready : i1
  %selected = scf.select %reuse, %restore, %phase : i32
  %size = index.constant 160 : offset
  %work = buffer.alloca<private> align(8) %size : buffer
  buffer.fill %zero, %work[%origin], %size : i32
  %offer = buffer.view %work[%origin] : buffer -> view<8xi32>
  %cursor = view.load %header[1] : view<7xi32> -> i32
  %frames = view.load %header[3] : view<7xi32> -> i32
  %chunk = view.load %header[4] : view<7xi32> -> i32
  view.store %selected, %offer[0] : i32, view<8xi32>
  view.store %voice, %offer[1] : i32, view<8xi32>
  view.store %cursor, %offer[2] : i32, view<8xi32>
  view.store %chunk, %offer[3] : i32, view<8xi32>
  view.store %frames, %offer[4] : i32, view<8xi32>
  %text_phase = scalar.constant 5 : i32
  %text_work = scalar.cmpi eq, %selected, %text_phase : i32
  %bos = scalar.constant -1 : i32
  view.store %bos, %offer[6] : i32, view<8xi32>
  %one_count = scalar.constant 1 : i32
  view.store %one_count, %offer[7] : i32, view<8xi32>
  scf.if %text_work {
    %packet = func.call @pocket.current_packet(%model, %groups) : (buffer, buffer) -> (offset)
    %packet_view = buffer.view %packets[%packet] : buffer -> view<4xi32>
    %length = view.load %packet_view[0] : view<4xi32> -> i32
    %remaining = scalar.subi %length, %cursor : i32
    %block = scalar.constant 32 : i32
    %short = scalar.cmpi ult, %remaining, %block : i32
    %extent = scf.select %short, %remaining, %block : i32
    view.store %extent, %offer[7] : i32, view<8xi32>
    %cursor_index = index.cast %cursor : i32 to index
    %extent_index = index.cast %extent : i32 to index
    %word = index.constant 4 : offset
    %packet_header = index.constant 16 : offset
    %offer_header = index.constant 32 : offset
    %relative = index.scale %cursor_index, %word : index, offset -> offset
    %packet_tokens = index.add %packet, %packet_header : offset
    %source_offset = index.add %packet_tokens, %relative : offset
    %copy_bytes = index.scale %extent_index, %word : index, offset -> offset
    buffer.copy %packets[%source_offset], %work[%offer_header], %copy_bytes
  }
  %tag = scalar.extui %selected : i32 to i64
  %unit = scalar.constant 1 : i64
  func.return %work, %unit, %tag : buffer, i64, i64
}

// CPU/input outcomes do not allocate numerical work. Voice preparation can
// overlap text arrival; a finished packet epoch never implies request EOF.
func.def public @prepare_work(%model: buffer, %state: buffer, %input_state: buffer, %normalizer: buffer, %normalized: buffer, %encoder: input.encoder, %sentences: buffer, %sentence_ids: buffer, %decoded: buffer, %prefix: input.decoder, %suffix: input.decoder, %groups: buffer, %group_text: buffer, %packets: buffer, %tokens: buffer, %sentence_set: buffer, %fallback_set: buffer) -> (i32, buffer, i64, i64) {
  %input_kind = func.call @pocket.input_work(%input_state, %groups) : (buffer, buffer) -> (i32)
  %origin = index.constant 0 : offset
  %header = buffer.view %state[%origin] : buffer -> view<7xi32>
  %phase = view.load %header[0] : view<7xi32> -> i32
  %text_phase = scalar.constant 5 : i32
  %numerical = scalar.constant 0 : i32
  %terminal = scalar.constant 3 : i32
  %preparing_voice = scalar.cmpi ult, %phase, %text_phase : i32
  %finished = scalar.cmpi eq, %input_kind, %terminal : i32
  %pending = scf.select %preparing_voice, %numerical, %input_kind : i32
  %kind = scf.select %finished, %terminal, %pending : i32
  %dispatch = scalar.cmpi eq, %kind, %numerical : i32
  %work, %units, %tag = scf.if %dispatch -> (buffer, i64, i64) {
    %work, %units, %tag = func.call @pocket.numerical_work(%model, %state, %groups, %packets) : (buffer, buffer, buffer, buffer) -> (buffer, i64, i64)
    scf.yield %work, %units, %tag : buffer, i64, i64
  } else {
    %empty = global.load @pocket.no_work : buffer
    %zero = scalar.constant 0 : i64
    scf.yield %empty, %zero, %zero : buffer, i64, i64
  }
  func.return %kind, %work, %units, %tag : i32, buffer, i64, i64
}

global.rodata.def @pocket.no_work = bytes("")

func.def public @prepare_batch(%model: buffer, %tags: buffer, %ranges: buffer, %packed: buffer) -> (buffer, buffer) {
  %origin = index.constant 0 : offset
  %model_header = buffer.view %model[%origin] : buffer -> view<12xi32>
  %capacity32 = view.load %model_header[5] : view<12xi32> -> i32
  %capacity_value = scalar.assume %capacity32 [range(%capacity32, 1, 65536)] : i32
  %capacity = index.cast %capacity_value : i32 to index
  %length = buffer.length %ranges
  %bytes = index.cast %length : offset to i64
  %record_bytes = scalar.constant 24 : i64
  %count64 = scalar.divui %bytes, %record_bytes : i64
  %count_value = index.cast %count64 : i64 to index
  %count = index.assume %count_value [ge(%count_value, 1), le(%count_value, %capacity)] : index
  %records = buffer.view %ranges[%origin] : buffer -> view<[%count]x3xi64>
  %size = template.apply<@pocket.batch_work_size>(%capacity) pure : (index) -> (offset)
  %payload = buffer.alloca<private> align(8) %size : buffer
  %zero = scalar.constant 0 : i32
  %one32 = scalar.constant 1 : i32
  buffer.fill %zero, %payload[%origin], %size : i32
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %header_words = index.add %capacity, %two : index
  %header = buffer.view %payload[%origin] : buffer -> view<[%header_words]xi32>
  %first = buffer.view %packed[%origin] : buffer -> view<8xi32>
  %phase = view.load %first[0] : view<8xi32> -> i32
  %count32 = scalar.trunci %count64 : i64 to i32
  view.store %count32, %header[0] : i32, view<[%header_words]xi32>
  %phase_slot = index.add %capacity, %one : index
  view.store %phase, %header[%phase_slot] : i32, view<[%header_words]xi32>
  %work_header = template.apply<@pocket.batch_work_header_size>(%capacity) pure : (index) -> (offset)
  %work_stride = index.constant 160 : offset
  // At most one writer per voice, in linear time even for large cohorts.
  %voices32 = view.load %model_header[7] : view<12xi32> -> i32
  %voices = index.cast %voices32 : i32 to index
  %word_bytes = index.constant 4 : offset
  %seen_bytes = index.scale %voices, %word_bytes : index, offset -> offset
  %seen_buffer = buffer.alloca<private> align(4) %seen_bytes : buffer
  buffer.fill %zero, %seen_buffer[%origin], %seen_bytes : i32
  %seen = buffer.view %seen_buffer[%origin] : buffer -> view<[%voices]xi32>
  %position_capacity_scale = index.constant 32 : index
  %position_capacity = index.mul %capacity, %position_capacity_scale : index
  %work_records_bytes = index.scale %capacity, %work_stride : index, offset -> offset
  %position_header_offset = index.add %work_header, %work_records_bytes : offset
  %position_header_bytes = index.constant 16 : offset
  %positions_offset = index.add %position_header_offset, %position_header_bytes : offset
  %positions = buffer.view %payload[%positions_offset] : buffer -> view<[%position_capacity]x4xi32>
  %plan_header_bytes = index.constant 8 : offset
  %extent_bytes = index.scale %count, %word_bytes : index, offset -> offset
  %plan_bytes = index.add %plan_header_bytes, %extent_bytes : offset
  %plan = buffer.alloca<private> align(4) %plan_bytes : buffer
  %accepted = buffer.view %plan[%plan_header_bytes] : buffer -> view<[%count]xi32>
  %text_phase = scalar.constant 5 : i32
  %text = scalar.cmpi eq, %phase, %text_phase : i32
  %begin = index.constant 0 : index
  %position_count = scf.for %i = [%begin to %count step %one](%position_begin = %begin : index) -> (index) {
    %row64 = view.load %records[%i, 0] : view<[%count]x3xi64> -> i64
    %offset64 = view.load %records[%i, 1] : view<[%count]x3xi64> -> i64
    %offset_value = scalar.assume %offset64 [range(%offset64, 0, 10485600)] : i64
    %offset = index.cast %offset_value : i64 to offset
    %relative = index.scale %i, %work_stride : index, offset -> offset
    %target_offset = index.add %work_header, %relative : offset
    buffer.copy %packed[%offset], %payload[%target_offset], %work_stride
    %work = buffer.view %payload[%target_offset] : buffer -> view<8xi32>
    %voice32 = view.load %work[1] : view<8xi32> -> i32
    %voice_value = index.cast %voice32 : i32 to index
    %voice = index.assume %voice_value [ge(%voice_value, 0), lt(%voice_value, %voices)] : index
    %previous = view.load %seen[%voice] : view<[%voices]xi32> -> i32
    %writer = scalar.xori %previous, %one32 : i32
    view.store %writer, %work[5] : i32, view<8xi32>
    view.store %one32, %seen[%voice] : i32, view<[%voices]xi32>
    %row = scalar.trunci %row64 : i64 to i32
    %map_index_value = index.add %i, %one : index
    %map_index = index.assume %map_index_value [ge(%map_index_value, 1), lt(%map_index_value, %header_words)] : index
    view.store %row, %header[%map_index] : i32, view<[%header_words]xi32>
    %extent32 = view.load %work[7] : view<8xi32> -> i32
    view.store %extent32, %accepted[%i] : i32, view<[%count]xi32>
    %after = scf.if %text -> (index) {
      %extent_value = index.cast %extent32 : i32 to index
      %extent = index.assume %extent_value [range(%extent_value, 1, 32)] : index
      %first32 = index.cast %position_begin : index to i32
      view.store %first32, %work[6] : i32, view<8xi32>
      %cursor = view.load %work[2] : view<8xi32> -> i32
      %frames = view.load %work[4] : view<8xi32> -> i32
      %voice_end = scalar.addi %frames, %one32 : i32
      %absolute = scalar.addi %voice_end, %cursor : i32
      %ordinal = index.cast %i : index to i32
      %offer_header = index.constant 32 : offset
      %tokens_offset = index.add %target_offset, %offer_header : offset
      %tokens = buffer.view %payload[%tokens_offset] : buffer -> view<32xi32>
      scf.for %j = [%begin to %extent step %one] {
        %column_value = index.add %position_begin, %j : index
        %column = index.assume %column_value [ge(%column_value, 0), lt(%column_value, %position_capacity)] : index
        %increment = index.cast %j : index to i32
        %position = scalar.addi %absolute, %increment : i32
        %token = view.load %tokens[%j] : view<32xi32> -> i32
        view.store %row, %positions[%column, 0] : i32, view<[%position_capacity]x4xi32>
        view.store %position, %positions[%column, 1] : i32, view<[%position_capacity]x4xi32>
        view.store %token, %positions[%column, 2] : i32, view<[%position_capacity]x4xi32>
        view.store %ordinal, %positions[%column, 3] : i32, view<[%position_capacity]x4xi32>
      }
      %next = index.add %position_begin, %extent : index
      scf.yield %next : index
    } else {
      scf.yield %position_begin : index
    }
    scf.yield %after : index
  }
  %position_count32 = index.cast %position_count : index to i32
  %position_header = buffer.view %payload[%position_header_offset] : buffer -> view<4xi32>
  view.store %position_count32, %position_header[0] : i32, view<4xi32>
  // The retained CPU plan carries the phase and live count directly. Generation
  // has no model metadata and does not infer capacity from a payload's extent.
  %plan_header = buffer.view %plan[%origin] : buffer -> view<2xi32>
  view.store %phase, %plan_header[0] : i32, view<2xi32>
  view.store %count32, %plan_header[1] : i32, view<2xi32>
  func.return %payload, %plan : buffer, buffer
}

func.def public @generate(%plan: buffer, %work: hal.buffer, %request: hal.buffer, %conditioning: hal.buffer, %stream: hal.buffer, %output: hal.buffer) {
  %origin = index.constant 0 : offset
  %header = buffer.view %plan[%origin] : buffer -> view<2xi32>
  %phase = view.load %header[0] : view<2xi32> -> i32
  %execution = func.call @execute_5(%phase, %work, %request, %conditioning, %stream, %output) : (i32, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer) -> (i64)
  %decode = scalar.constant 6 : i32
  %audio = scalar.cmpi eq, %phase, %decode : i32
