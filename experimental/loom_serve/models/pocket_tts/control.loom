}

func.def public @complete(%model: buffer, %state: buffer, %input_state: buffer, %normalizer: buffer, %normalized: buffer, %encoder: input.encoder, %sentences: buffer, %sentence_ids: buffer, %decoded: buffer, %prefix: input.decoder, %suffix: input.decoder, %groups: buffer, %group_text: buffer, %packets: buffer, %tokens: buffer, %sentence_set: buffer, %fallback_set: buffer, %plan: buffer, %ordinal: i64, %feedback: buffer) -> (buffer, buffer, buffer, buffer, input.encoder, buffer, buffer, buffer, input.decoder, input.decoder, buffer, buffer, buffer, buffer, buffer, buffer, i64, i64, i64, i32) {
  %origin = index.constant 0 : offset
  %header = buffer.view %state[%origin] : buffer -> view<7xi32>
  %position_origin = index.constant 32 : offset
  %position_view = buffer.view %state[%position_origin] : buffer -> view<1xi64>
  %position = view.load %position_view[0] : view<1xi64> -> i64
  %batch = buffer.view %plan[%origin] : buffer -> view<2xi32>
  %phase = view.load %batch[0] : view<2xi32> -> i32
