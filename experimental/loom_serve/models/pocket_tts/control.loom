        view.store %four, %header[0] : i32, view<7xi32>
      }
      case 4 {
        view.store %five, %header[0] : i32, view<7xi32>
        view.store %zero, %header[1] : i32, view<7xi32>
        view.store %zero, %header[5] : i32, view<7xi32>
        view.store %missing, %header[6] : i32, view<7xi32>
      }
      default {
        %cursor = view.load %header[1] : view<7xi32> -> i32
        %extent_header = index.constant 8 : offset
        %extent_word = index.constant 4 : offset
        %ordinal_index = index.cast %ordinal : i64 to index
        %extent_relative = index.scale %ordinal_index, %extent_word : index, offset -> offset
        %extent_offset = index.add %extent_header, %extent_relative : offset
        %accepted = buffer.view %plan[%extent_offset] : buffer -> view<1xi32>
        %extent = view.load %accepted[0] : view<1xi32> -> i32
        %next = scalar.addi %cursor, %extent : i32
        %voice = scalar.cmpi eq, %phase, %two : i32
        %limit = scf.if %voice -> (i32) {
          %voice_frames = view.load %header[3] : view<7xi32> -> i32
          scf.yield %voice_frames : i32
