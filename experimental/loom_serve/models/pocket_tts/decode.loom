template.decl @pocket.codec_state_origin(%relative: offset) -> (offset)

// One normalized FlowLM step followed by one 80 ms Mimi waveform block.
// Request contains 32 F32 noise values and F32 flow times 0 and 1. Output contains
// one F32 EOS score followed by 1,920 F32 mono samples at 24 kHz.
// The caller bounds absolute positions by the selected context and rotary capacities.
kernel.decl @pocket.advance_1() launch(%position_storage: buffer)

kernel.decl @pocket.advance_16() launch(%position_storage: buffer)

kernel.decl @pocket.conditioning() launch(%c_storage: buffer, %s_storage: buffer, %t_storage: buffer, %y_storage: buffer)

