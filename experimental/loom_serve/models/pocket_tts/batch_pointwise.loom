config.decl @pocket.threads : %value: index where [range(%value, 1, 256)]

// Dispatch entry points specialize source geometry. Membership remains a
// runtime packet; changing request progress never changes the compiled shape.
target.decl @pocket

config.decl @pocket.batch_capacity : %value: index where [range(%value, 1, 65536)]

kernel.def target(@pocket) @pocket.batch.residual_1024x1_kernel() {
  %elements = index.constant 1024 : index
  %threads = config.get @pocket.threads : index
  %one = index.constant 1 : index
  %tail = index.sub %threads, %one : index
  %rounded = index.add %elements, %tail : index
  %groups = index.div %rounded, %threads : index
  %batch_capacity = config.get @pocket.batch_capacity : index
  kernel.launch.config workgroups(%groups, %one, %batch_capacity) workgroup_size(%threads, %one, %one) : index
} launch(%membership: buffer, %x_storage: buffer, %update_storage: buffer, %y_storage: buffer, %x_offset: offset, %x_stride: offset, %update_offset: offset, %update_stride: offset, %y_offset: offset, %y_stride: offset) {
  %elements = index.constant 1024 : index
  %channels = index.constant 1024 : index
  %times = index.constant 1 : index
  template.apply<@pocket.batch.residual>(%membership, %elements, %channels, %times, %x_storage, %update_storage, %y_storage, %x_offset, %x_stride, %update_offset, %update_stride, %y_offset, %y_stride) : (buffer, index, index, index, buffer, buffer, buffer, offset, offset, offset, offset, offset, offset)
  kernel.return
}

