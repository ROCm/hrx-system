  %rounded = index.add %elements, %tail : index
  %groups = index.div %rounded, %threads : index
  %batch_capacity = config.get @pocket.batch_capacity : index
  kernel.launch.config workgroups(%groups, %one, %batch_capacity) workgroup_size(%threads, %one, %one) : index
} launch(%membership: buffer, %x_storage: buffer, %y_storage: buffer, %x_offset: offset, %x_stride: offset, %y_offset: offset, %y_stride: offset) {
  %elements = index.constant 122880 : index
  template.apply<@pocket.batch.elu>(%membership, %elements, %x_storage, %y_storage, %x_offset, %x_stride, %y_offset, %y_stride) : (buffer, index, buffer, buffer, offset, offset, offset, offset)
  kernel.return
}
