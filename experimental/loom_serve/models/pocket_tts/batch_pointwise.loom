template.decl @pocket.residual_scaled.body(%elements: index, %channels: index, %times: index, %x_storage: buffer, %update_storage: buffer, %y_storage: buffer, %scale_storage: buffer, %x_origin: offset, %update_origin: offset, %y_origin: offset, %scale_origin: offset)

template.decl @pocket.batch.residual_scaled(%membership: buffer, %elements: index, %channels: index, %times: index, %x_storage: buffer, %update_storage: buffer, %y_storage: buffer, %scale_storage: buffer, %x_offset: offset, %x_stride: offset, %update_offset: offset, %update_stride: offset, %y_offset: offset, %y_stride: offset, %scale_offset: offset, %scale_stride: offset)

template.def<@pocket.batch.residual_scaled> device @pocket_batch_residual_scaled(%membership: buffer, %elements: index, %channels: index, %times: index, %x_storage: buffer, %update_storage: buffer, %y_storage: buffer, %scale_storage: buffer, %x_offset: offset, %x_stride: offset, %update_offset: offset, %update_stride: offset, %y_offset: offset, %y_stride: offset, %scale_offset: offset, %scale_stride: offset) {
