    %c_origin = template.apply<@pocket.batch.origin>(%packed, %c_offset, %c_stride) pure : (index, offset, offset) -> (offset)
    %s_origin = template.apply<@pocket.batch.origin>(%packed, %s_offset, %s_stride) pure : (index, offset, offset) -> (offset)
    %t_origin = template.apply<@pocket.batch.origin>(%packed, %t_offset, %t_stride) pure : (index, offset, offset) -> (offset)
    %y_origin = template.apply<@pocket.batch.origin>(%packed, %y_offset, %y_stride) pure : (index, offset, offset) -> (offset)
    template.apply<@pocket.conditioning.body>(%elements, %c_storage, %s_storage, %t_storage, %y_storage, %c_origin, %s_origin, %t_origin, %y_origin) : (index, buffer, buffer, buffer, buffer, offset, offset, offset, offset)
  }
  template.return
}

