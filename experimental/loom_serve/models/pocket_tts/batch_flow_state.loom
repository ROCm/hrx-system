template.def<@pocket.batch.conditioning> device @pocket_batch_conditioning(%membership: buffer, %elements: index, %c_storage: buffer, %s_storage: buffer, %t_storage: buffer, %y_storage: buffer, %c_offset: offset, %c_stride: offset, %s_offset: offset, %s_stride: offset, %t_offset: offset, %t_stride: offset, %y_offset: offset, %y_stride: offset) {
  %active, %packed, %resident = template.apply<@pocket.batch.member>(%membership) : (buffer) -> (i1, index, index)
