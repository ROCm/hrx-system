template.decl @pocket.batch.modulation(%membership: buffer, %elements: index, %x_storage: buffer, %modulation_storage: buffer, %y_storage: buffer, %x_offset: offset, %x_stride: offset, %modulation_offset: offset, %modulation_stride: offset, %y_offset: offset, %y_stride: offset)

template.def<@pocket.batch.modulation> device @pocket_batch_modulation(%membership: buffer, %elements: index, %x_storage: buffer, %modulation_storage: buffer, %y_storage: buffer, %x_offset: offset, %x_stride: offset, %modulation_offset: offset, %modulation_stride: offset, %y_offset: offset, %y_stride: offset) {
