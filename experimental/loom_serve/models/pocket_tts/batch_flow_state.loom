template.def<@pocket.batch.token> device @pocket_batch_token(%membership: buffer, %elements: index, %token_storage: buffer, %bos_storage: buffer, %embedding_storage: buffer, %y_storage: buffer, %token_offset: offset, %token_stride: offset, %bos_offset: offset, %bos_stride: offset, %embedding_offset: offset, %embedding_stride: offset, %y_offset: offset, %y_stride: offset) {
  %active, %packed, %resident = template.apply<@pocket.batch.member>(%membership) : (buffer) -> (i1, index, index)
