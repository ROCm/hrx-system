template.decl @pocket.latent_output.body(%elements: index, %noise_storage: buffer, %delta_storage: buffer, %previous_storage: buffer, %scale_storage: buffer, %mean_storage: buffer, %y_storage: buffer, %noise_origin: offset, %delta_origin: offset, %previous_origin: offset, %scale_origin: offset, %mean_origin: offset, %y_origin: offset)

template.decl @pocket.batch.latent_output(%membership: buffer, %elements: index, %noise_storage: buffer, %delta_storage: buffer, %previous_storage: buffer, %scale_storage: buffer, %mean_storage: buffer, %y_storage: buffer, %noise_offset: offset, %noise_stride: offset, %delta_offset: offset, %delta_stride: offset, %previous_offset: offset, %previous_stride: offset, %scale_offset: offset, %scale_stride: offset, %mean_offset: offset, %mean_stride: offset, %y_offset: offset, %y_stride: offset)

