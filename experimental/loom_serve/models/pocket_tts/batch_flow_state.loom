// Latents and positions belong to resident requests. Activations, tokens,
// solver inputs, and output blocks use packed rows. Shared checkpoint tensors
// have zero stride; no history moves when batch membership changes.
template.decl @pocket.batch.member(%membership: buffer) -> (i1, index, index)

template.decl pure @pocket.batch.origin(%row: index, %offset: offset, %stride: offset) -> (offset)

template.decl @pocket.previous_latent.body(%elements: index, %previous_storage: buffer, %position_storage: buffer, %bos_storage: buffer, %y_storage: buffer, %previous_origin: offset, %position_origin: offset, %bos_origin: offset, %y_origin: offset)

template.decl @pocket.batch.previous_latent(%membership: buffer, %elements: index, %previous_storage: buffer, %position_storage: buffer, %bos_storage: buffer, %y_storage: buffer, %previous_offset: offset, %previous_stride: offset, %position_offset: offset, %position_stride: offset, %bos_offset: offset, %bos_stride: offset, %y_offset: offset, %y_stride: offset)

template.def<@pocket.batch.previous_latent> device @pocket_batch_previous_latent(%membership: buffer, %elements: index, %previous_storage: buffer, %position_storage: buffer, %bos_storage: buffer, %y_storage: buffer, %previous_offset: offset, %previous_stride: offset, %position_offset: offset, %position_stride: offset, %bos_offset: offset, %bos_stride: offset, %y_offset: offset, %y_stride: offset) {
  %active, %packed, %resident = template.apply<@pocket.batch.member>(%membership) : (buffer) -> (i1, index, index)
  scf.if %active {
    %previous_origin = template.apply<@pocket.batch.origin>(%resident, %previous_offset, %previous_stride) pure : (index, offset, offset) -> (offset)
    %position_origin = template.apply<@pocket.batch.origin>(%resident, %position_offset, %position_stride) pure : (index, offset, offset) -> (offset)
    %bos_origin = template.apply<@pocket.batch.origin>(%packed, %bos_offset, %bos_stride) pure : (index, offset, offset) -> (offset)
    %y_origin = template.apply<@pocket.batch.origin>(%packed, %y_offset, %y_stride) pure : (index, offset, offset) -> (offset)
    template.apply<@pocket.previous_latent.body>(%elements, %previous_storage, %position_storage, %bos_storage, %y_storage, %previous_origin, %position_origin, %bos_origin, %y_origin) : (index, buffer, buffer, buffer, buffer, offset, offset, offset, offset)
  }
  template.return
}

template.decl @pocket.advance.body(%elements: index, %increment: i32, %position_storage: buffer, %position_origin: offset)

template.decl @pocket.batch.advance(%membership: buffer, %elements: index, %increment: i32, %position_storage: buffer, %position_offset: offset, %position_stride: offset)

template.def<@pocket.batch.advance> device @pocket_batch_advance(%membership: buffer, %elements: index, %increment: i32, %position_storage: buffer, %position_offset: offset, %position_stride: offset) {
  %active, %packed, %resident = template.apply<@pocket.batch.member>(%membership) : (buffer) -> (i1, index, index)
  scf.if %active {
    %position_origin = template.apply<@pocket.batch.origin>(%resident, %position_offset, %position_stride) pure : (index, offset, offset) -> (offset)
    template.apply<@pocket.advance.body>(%elements, %increment, %position_storage, %position_origin) : (index, i32, buffer, offset)
  }
  template.return
}

template.decl @pocket.time_embedding.body(%elements: index, %time_storage: buffer, %frequencies_storage: buffer, %y_storage: buffer, %time_origin: offset, %frequencies_origin: offset, %y_origin: offset)

template.decl @pocket.batch.time_embedding(%membership: buffer, %elements: index, %time_storage: buffer, %frequencies_storage: buffer, %y_storage: buffer, %time_offset: offset, %time_stride: offset, %frequencies_offset: offset, %frequencies_stride: offset, %y_offset: offset, %y_stride: offset)

template.def<@pocket.batch.time_embedding> device @pocket_batch_time_embedding(%membership: buffer, %elements: index, %time_storage: buffer, %frequencies_storage: buffer, %y_storage: buffer, %time_offset: offset, %time_stride: offset, %frequencies_offset: offset, %frequencies_stride: offset, %y_offset: offset, %y_stride: offset) {
  %active, %packed, %resident = template.apply<@pocket.batch.member>(%membership) : (buffer) -> (i1, index, index)
  scf.if %active {
    %time_origin = template.apply<@pocket.batch.origin>(%packed, %time_offset, %time_stride) pure : (index, offset, offset) -> (offset)
    %frequencies_origin = template.apply<@pocket.batch.origin>(%packed, %frequencies_offset, %frequencies_stride) pure : (index, offset, offset) -> (offset)
    %y_origin = template.apply<@pocket.batch.origin>(%packed, %y_offset, %y_stride) pure : (index, offset, offset) -> (offset)
    template.apply<@pocket.time_embedding.body>(%elements, %time_storage, %frequencies_storage, %y_storage, %time_origin, %frequencies_origin, %y_origin) : (index, buffer, buffer, buffer, offset, offset, offset)
  }
  template.return
}

template.decl @pocket.conditioning.body(%elements: index, %c_storage: buffer, %s_storage: buffer, %t_storage: buffer, %y_storage: buffer, %c_origin: offset, %s_origin: offset, %t_origin: offset, %y_origin: offset)

