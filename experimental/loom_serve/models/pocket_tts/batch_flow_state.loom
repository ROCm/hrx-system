  %active, %packed, %resident = template.apply<@pocket.batch.member>(%membership) : (buffer) -> (i1, index, index)
  scf.if %active {
    %noise_origin = template.apply<@pocket.batch.origin>(%packed, %noise_offset, %noise_stride) pure : (index, offset, offset) -> (offset)
    %delta_origin = template.apply<@pocket.batch.origin>(%packed, %delta_offset, %delta_stride) pure : (index, offset, offset) -> (offset)
    %previous_origin = template.apply<@pocket.batch.origin>(%resident, %previous_offset, %previous_stride) pure : (index, offset, offset) -> (offset)
    %scale_origin = template.apply<@pocket.batch.origin>(%packed, %scale_offset, %scale_stride) pure : (index, offset, offset) -> (offset)
    %mean_origin = template.apply<@pocket.batch.origin>(%packed, %mean_offset, %mean_stride) pure : (index, offset, offset) -> (offset)
    %y_origin = template.apply<@pocket.batch.origin>(%packed, %y_offset, %y_stride) pure : (index, offset, offset) -> (offset)
    template.apply<@pocket.latent_output.body>(%elements, %noise_storage, %delta_storage, %previous_storage, %scale_storage, %mean_storage, %y_storage, %noise_origin, %delta_origin, %previous_origin, %scale_origin, %mean_origin, %y_origin) : (index, buffer, buffer, buffer, buffer, buffer, buffer, offset, offset, offset, offset, offset, offset)
  }
  template.return
}

