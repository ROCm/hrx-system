  kernel.return
}

template.decl @pocket.convolution_f64.body(%elements: index, %inputs: index, %padded_times: index, %outputs: index, %times: index, %extent: index, %stride: index, %x_storage: buffer, %w_storage: buffer, %y_storage: buffer)

template.def<@pocket.convolution_f64.body> device @convolution_f64_body(%elements: index, %inputs: index, %padded_times: index, %outputs: index, %times: index, %extent: index, %stride: index, %x_storage: buffer, %w_storage: buffer, %y_storage: buffer) {
  %element = template.apply<@pocket.element>() : () -> (index)
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %live = index.cmp ult, %element, %elements : index
  scf.if %live {
    %origin = index.constant 0 : offset
    %x_view = buffer.view %x_storage[%origin] : buffer -> view<[%inputs]x[%padded_times]xf32>
    %w_view = buffer.view %w_storage[%origin] : buffer -> view<[%outputs]x[%inputs]x[%extent]xbf16>
    %y_view = buffer.view %y_storage[%origin] : buffer -> view<[%outputs]x[%times]xf32>
    %row = index.div %element, %times : index
    %column = index.rem %element, %times : index
    %start = index.mul %column, %stride : index
    %acc_zero = scalar.constant 0.0 : f64
    %wide_sum = scf.for %i = [%c0 to %inputs step %c1](%acc = %acc_zero : f64) -> (f64) {
      %partial = scf.for %tap = [%c0 to %extent step %c1](%inner = %acc : f64) -> (f64) {
        %position = index.add %start, %tap : index
        %input = view.load %x_view[%i, %position] : view<[%inputs]x[%padded_times]xf32> -> f32
        %weight_stored = view.load %w_view[%row, %i, %tap] : view<[%outputs]x[%inputs]x[%extent]xbf16> -> bf16
        %weight = scalar.extf %weight_stored : bf16 to f32
        %wide_input = scalar.extf %input : f32 to f64
        %wide_weight = scalar.extf %weight : f32 to f64
        %next = scalar.fmaf %wide_input, %wide_weight, %inner : f64
        scf.yield %next : f64
      }
      scf.yield %partial : f64
    }
    %sum = scalar.fptrunc %wide_sum : f64 to f32

    view.store %sum, %y_view[%row, %column] : f32, view<[%outputs]x[%times]xf32>
  }
  template.return
}

