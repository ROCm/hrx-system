// Activations use channel/time order; stored BF16 weights are extended at
// use. History is owned by one stream and updated after its padded input is
// complete. Transposed kernels have twice the stride in taps; their overlap
// retains the un-biased tail so a later block contributes its bias once.
target.decl @pocket

config.decl @pocket.threads : %value: index where [range(%value, 1, 256)]

template.decl @pocket.element() -> (index)

template.decl @pocket.transpose_convolution.body(%elements: index, %inputs: index, %times: index, %outputs: index, %raw_times: index, %group_outputs: index, %extent: index, %stride: index, %group_inputs: index, %x_storage: buffer, %w_storage: buffer, %y_storage: buffer)

template.def<@pocket.transpose_convolution.body> device @transpose_convolution_body(%elements: index, %inputs: index, %times: index, %outputs: index, %raw_times: index, %group_outputs: index, %extent: index, %stride: index, %group_inputs: index, %x_storage: buffer, %w_storage: buffer, %y_storage: buffer) {
  %element = template.apply<@pocket.element>() : () -> (index)
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %f0 = scalar.constant 0.0 : f32
  %live = index.cmp ult, %element, %elements : index
  scf.if %live {
    %origin = index.constant 0 : offset
    %x_view = buffer.view %x_storage[%origin] : buffer -> view<[%inputs]x[%times]xf32>
    %w_view = buffer.view %w_storage[%origin] : buffer -> view<[%inputs]x[%group_outputs]x[%extent]xbf16>
    %y_view = buffer.view %y_storage[%origin] : buffer -> view<[%outputs]x[%raw_times]xf32>
    %row = index.div %element, %raw_times : index
    %column = index.rem %element, %raw_times : index
    %channel_group = index.div %row, %group_outputs : index
    %weight_output = index.rem %row, %group_outputs : index
    %input_origin = index.mul %channel_group, %group_inputs : index
    %base = index.div %column, %stride : index
    %phase = index.rem %column, %stride : index
    %c2 = index.constant 2 : index
    %sum = scf.for %i = [%c0 to %group_inputs step %c1](%acc = %f0 : f32) -> (f32) {
      %channel = index.add %input_origin, %i : index
      %partial = scf.for %tap = [%c0 to %c2 step %c1](%inner = %acc : f32) -> (f32) {
        %position = index.sub %base, %tap : index
        %valid = index.cmp ult, %position, %times : index
        %next = scf.if %valid -> (f32) {
          %input = view.load %x_view[%channel, %position] : view<[%inputs]x[%times]xf32> -> f32
          %weight_tap = index.madd %tap, %stride, %phase : index
          %weight_stored = view.load %w_view[%channel, %weight_output, %weight_tap] : view<[%inputs]x[%group_outputs]x[%extent]xbf16> -> bf16
          %weight = scalar.extf %weight_stored : bf16 to f32
          %updated = scalar.fmaf %input, %weight, %inner : f32
          scf.yield %updated : f32
        } else {
          scf.yield %inner : f32
        }
        scf.yield %next : f32
      }
      scf.yield %partial : f32
    }

    view.store %sum, %y_view[%row, %column] : f32, view<[%outputs]x[%raw_times]xf32>
  }
  template.return
}

kernel.def target(@pocket) @pocket.transpose_convolution_512x512_t1_g1x1_s16() {
  %elements = index.constant 16384 : index
  %threads = config.get @pocket.threads : index
  %one = index.constant 1 : index
  %tail = index.sub %threads, %one : index
  %rounded = index.add %elements, %tail : index
  %groups = index.div %rounded, %threads : index
  kernel.launch.config workgroups(%groups, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%x_storage: buffer, %w_storage: buffer, %y_storage: buffer) {
  %elements = index.constant 16384 : index
  %inputs = index.constant 512 : index
  %times = index.constant 1 : index
  %outputs = index.constant 512 : index
  %raw_times = index.constant 32 : index
  %group_outputs = index.constant 1 : index
  %extent = index.constant 32 : index
  %stride = index.constant 16 : index
  %group_inputs = index.constant 1 : index
  template.apply<@pocket.transpose_convolution.body>(%elements, %inputs, %times, %outputs, %raw_times, %group_outputs, %extent, %stride, %group_inputs, %x_storage, %w_storage, %y_storage) : (index, index, index, index, index, index, index, index, index, buffer, buffer, buffer)
  kernel.return
}

template.decl @pocket.overlap.body(%elements: index, %outputs: index, %raw_times: index, %length: index, %overlap: index, %x_storage: buffer, %history_storage: buffer, %y_storage: buffer)

template.def<@pocket.overlap.body> device @overlap_body(%elements: index, %outputs: index, %raw_times: index, %length: index, %overlap: index, %x_storage: buffer, %history_storage: buffer, %y_storage: buffer) {
  %element = template.apply<@pocket.element>() : () -> (index)
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %live = index.cmp ult, %element, %elements : index
  scf.if %live {
    %origin = index.constant 0 : offset
    %x_view = buffer.view %x_storage[%origin] : buffer -> view<[%outputs]x[%raw_times]xf32>
    %history_view = buffer.view %history_storage[%origin] : buffer -> view<[%outputs]x[%overlap]xf32>
    %y_view = buffer.view %y_storage[%origin] : buffer -> view<[%outputs]x[%length]xf32>
    scf.for %t = [%c0 to %length step %c1] {
      %value = view.load %x_view[%element, %t] : view<[%outputs]x[%raw_times]xf32> -> f32
      %partial = index.cmp ult, %t, %overlap : index
      %sample = scf.if %partial -> (f32) {
        %old = view.load %history_view[%element, %t] : view<[%outputs]x[%overlap]xf32> -> f32
        %combined = scalar.addf %value, %old : f32
        scf.yield %combined : f32
      } else {
        scf.yield %value : f32
      }
      view.store %sample, %y_view[%element, %t] : f32, view<[%outputs]x[%length]xf32>
    }
    scf.for %t = [%c0 to %overlap step %c1] {
      %position = index.add %length, %t : index
      %tail = view.load %x_view[%element, %position] : view<[%outputs]x[%raw_times]xf32> -> f32

      view.store %tail, %history_view[%element, %t] : f32, view<[%outputs]x[%overlap]xf32>
    }
  }
  template.return
}

kernel.def target(@pocket) @pocket.overlap_512x16_h16() {
  %elements = index.constant 512 : index
  %threads = config.get @pocket.threads : index
  %one = index.constant 1 : index
  %tail = index.sub %threads, %one : index
  %rounded = index.add %elements, %tail : index
  %groups = index.div %rounded, %threads : index
  kernel.launch.config workgroups(%groups, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%x_storage: buffer, %history_storage: buffer, %y_storage: buffer) {
  %elements = index.constant 512 : index
  %outputs = index.constant 512 : index
  %raw_times = index.constant 32 : index
  %length = index.constant 16 : index
  %overlap = index.constant 16 : index
  template.apply<@pocket.overlap.body>(%elements, %outputs, %raw_times, %length, %overlap, %x_storage, %history_storage, %y_storage) : (index, index, index, index, index, buffer, buffer, buffer)
  kernel.return
}

template.decl @pocket.history.body(%elements: index, %channels: index, %times: index, %history_length: index, %padded_times: index, %x_storage: buffer, %history_storage: buffer, %padded_storage: buffer)

template.def<@pocket.history.body> device @history_body(%elements: index, %channels: index, %times: index, %history_length: index, %padded_times: index, %x_storage: buffer, %history_storage: buffer, %padded_storage: buffer) {
  %element = template.apply<@pocket.element>() : () -> (index)
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %live = index.cmp ult, %element, %elements : index
  scf.if %live {
    %origin = index.constant 0 : offset
    %x_view = buffer.view %x_storage[%origin] : buffer -> view<[%channels]x[%times]xf32>
    %history_view = buffer.view %history_storage[%origin] : buffer -> view<[%channels]x[%history_length]xf32>
    %padded_view = buffer.view %padded_storage[%origin] : buffer -> view<[%channels]x[%padded_times]xf32>
    scf.for %t = [%c0 to %history_length step %c1] {
      %old = view.load %history_view[%element, %t] : view<[%channels]x[%history_length]xf32> -> f32
      view.store %old, %padded_view[%element, %t] : f32, view<[%channels]x[%padded_times]xf32>
    }
    scf.for %t = [%c0 to %times step %c1] {
      %input = view.load %x_view[%element, %t] : view<[%channels]x[%times]xf32> -> f32
      %position = index.add %history_length, %t : index
      view.store %input, %padded_view[%element, %position] : f32, view<[%channels]x[%padded_times]xf32>
    }
    scf.for %t = [%c0 to %history_length step %c1] {
      %position = index.add %times, %t : index
      %tail = view.load %padded_view[%element, %position] : view<[%channels]x[%padded_times]xf32> -> f32
      view.store %tail, %history_view[%element, %t] : f32, view<[%channels]x[%history_length]xf32>
    }
  }
  template.return
}

