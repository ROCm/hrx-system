template.decl @pocket.convolution_f32_bias.body(%elements: index, %inputs: index, %padded_times: index, %outputs: index, %times: index, %extent: index, %stride: index, %x_storage: buffer, %w_storage: buffer, %y_storage: buffer, %b_storage: buffer)

template.def<@pocket.convolution_f32_bias.body> device @convolution_f32_bias_body(%elements: index, %inputs: index, %padded_times: index, %outputs: index, %times: index, %extent: index, %stride: index, %x_storage: buffer, %w_storage: buffer, %y_storage: buffer, %b_storage: buffer) {
  %element = template.apply<@pocket.element>() : () -> (index)
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %live = index.cmp ult, %element, %elements : index
  scf.if %live {
    %origin = index.constant 0 : offset
    %x_view = buffer.view %x_storage[%origin] : buffer -> view<[%inputs]x[%padded_times]xf32>
    %w_view = buffer.view %w_storage[%origin] : buffer -> view<[%outputs]x[%inputs]x[%extent]xbf16>
    %y_view = buffer.view %y_storage[%origin] : buffer -> view<[%outputs]x[%times]xf32>
    %b_view = buffer.view %b_storage[%origin] : buffer -> view<[%outputs]xbf16>
    %row = index.div %element, %times : index
    %column = index.rem %element, %times : index
    %start = index.mul %column, %stride : index
    %acc_zero = scalar.constant 0.0 : f32
    %sum = scf.for %i = [%c0 to %inputs step %c1](%acc = %acc_zero : f32) -> (f32) {
      %partial = scf.for %tap = [%c0 to %extent step %c1](%inner = %acc : f32) -> (f32) {
        %position = index.add %start, %tap : index
        %input = view.load %x_view[%i, %position] : view<[%inputs]x[%padded_times]xf32> -> f32
        %weight_stored = view.load %w_view[%row, %i, %tap] : view<[%outputs]x[%inputs]x[%extent]xbf16> -> bf16
        %weight = scalar.extf %weight_stored : bf16 to f32

        %next = scalar.fmaf %input, %weight, %inner : f32
        scf.yield %next : f32
      }
      scf.yield %partial : f32
    }

    %bias_stored = view.load %b_view[%row] : view<[%outputs]xbf16> -> bf16
    %bias = scalar.extf %bias_stored : bf16 to f32
    %output = scalar.addf %sum, %bias : f32
    view.store %output, %y_view[%row, %column] : f32, view<[%outputs]x[%times]xf32>
  }
  template.return
}

