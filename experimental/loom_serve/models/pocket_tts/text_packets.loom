func.decl @pocket.refine_sentence(%sentence: buffer, %tokens: index, %fallback: buffer, %fallback_count: index, %group: buffer, %state: buffer, %packets: buffer, %limit: index) -> (buffer)

func.decl @pocket.emit_text_packet(%group: buffer, %group_length: offset, %packets: buffer, %chunk: index, %limit: index) -> (buffer)

// The first three cursor words are the finite policy's accumulator:
// 0: unresolved group's byte length.
// 1: original token count of that group, before final normalization.
// 2: number of completed packets in the current storage epoch.
// Additional words retain independent streaming lifetime:
// 3: next packet in this epoch, advanced after numerical retirement.
// 4: whether any packet has ever been admitted, for empty-input rejection.
// 5: whether final input and the last group have been accepted.
// Packet storage is reusable after the epoch drains. Its local index never
// supplies the numerical request's absolute packet or sampling identity.
func.def public @pocket.packets_create(%input_limit: index) -> (buffer, buffer, buffer) {
  %origin = index.constant 0 : offset
  %state_bytes = index.constant 48 : offset
  %state = buffer.alloca<private> align(8) %state_bytes : buffer
  %zero = scalar.constant 0 : i32
  buffer.fill %zero, %state[%origin], %state_bytes : i32
  %bytes_per_token = index.constant 18 : offset
  %group_bytes = index.scale %input_limit, %bytes_per_token : index, offset -> offset
  %group = buffer.alloca<private> align(4) %group_bytes : buffer
  %packets = buffer.alloca<private> align(4) %origin : buffer
  func.return %state, %group, %packets : buffer, buffer, buffer
}

// Refine one complete sentence with the unchanged fallback and regrouping
// policy. The owner drains this epoch before supplying the next sentence.
func.def public @pocket.packets_feed(%state: buffer, %group: buffer, %packets: buffer, %sentence: buffer, %tokens: index, %fallback: buffer, %fallback_count: index, %limit: index) -> (buffer) {
  %output = func.call @pocket.refine_sentence(%sentence, %tokens, %fallback, %fallback_count, %group, %state, %packets, %limit) : (buffer, index, buffer, index, buffer, buffer, buffer, index) -> (buffer)
  %origin = index.constant 0 : offset
  %header = buffer.view %state[%origin] : buffer -> view<6xi64>
  %count = view.load %header[2] : view<6xi64> -> i64
  %previous = view.load %header[4] : view<6xi64> -> i64
  %zero = scalar.constant 0 : i64
  %one = scalar.constant 1 : i64
  %nonempty = scalar.cmpi ne, %count, %zero : i64
  %seen = scf.select %nonempty, %one, %previous : i64
  view.store %seen, %header[4] : i64, view<6xi64>
  func.return %output : buffer
}

func.def public @pocket.packets_peek(%state: buffer) -> (i64, i64, i32) {
  %origin = index.constant 0 : offset
  %header = buffer.view %state[%origin] : buffer -> view<6xi64>
  %count = view.load %header[2] : view<6xi64> -> i64
  %position = view.load %header[3] : view<6xi64> -> i64
  %final = view.load %header[5] : view<6xi64> -> i64
  %remaining = scalar.subi %count, %position : i64
  %zero = scalar.constant 0 : i64
  %drained = scalar.cmpi eq, %remaining, %zero : i64
  %finished = scalar.cmpi ne, %final, %zero : i64
  %complete = scalar.andi %drained, %finished : i1
  %complete32 = scalar.extui %complete : i1 to i32
  func.return %position, %remaining, %complete32 : i64, i64, i32
}

// Retiring a packet never moves another packet or the unresolved text group.
// Reset the epoch's indices only when no numerical borrower can reference it.
func.def public @pocket.packets_consume(%state: buffer) {
  %origin = index.constant 0 : offset
  %header = buffer.view %state[%origin] : buffer -> view<6xi64>
  %count = view.load %header[2] : view<6xi64> -> i64
  %position = view.load %header[3] : view<6xi64> -> i64
  %zero = scalar.constant 0 : i64
  %one = scalar.constant 1 : i64
  %next = scalar.addi %position, %one : i64
  %drained = scalar.cmpi eq, %next, %count : i64
  %next_count = scf.select %drained, %zero, %count : i64
  %next_position = scf.select %drained, %zero, %next : i64
  view.store %next_count, %header[2] : i64, view<6xi64>
  view.store %next_position, %header[3] : i64, view<6xi64>
  func.return
}

// The final group uses the same normalization and exact token-capacity check
// as every earlier packet. If no group or earlier packet exists, that shared
// constructor reports the model's empty-input rejection.
func.def public @pocket.packets_finish(%state: buffer, %group: buffer, %packets: buffer, %limit: index) -> (buffer) {
  %origin = index.constant 0 : offset
  %header = buffer.view %state[%origin] : buffer -> view<6xi64>
  %length64 = view.load %header[0] : view<6xi64> -> i64
  %count64 = view.load %header[2] : view<6xi64> -> i64
  %seen = view.load %header[4] : view<6xi64> -> i64
  %zero = scalar.constant 0 : i64
  %one = scalar.constant 1 : i64
  %has_group = scalar.cmpi ne, %length64, %zero : i64
  %no_packets = scalar.cmpi eq, %seen, %zero : i64
  %emit = scalar.ori %has_group, %no_packets : i1
  %output = scf.if %emit -> (buffer) {
    %length_value = scalar.assume %length64 [range(%length64, 0, 9223372036854775807)] : i64
    %length = index.cast %length_value : i64 to offset
    %count = index.cast %count64 : i64 to index
    %output = func.call @pocket.emit_text_packet(%group, %length, %packets, %count, %limit) : (buffer, offset, buffer, index, index) -> (buffer)
    %next_count = scalar.addi %count64, %one : i64
    view.store %next_count, %header[2] : i64, view<6xi64>
    view.store %one, %header[4] : i64, view<6xi64>
    scf.yield %output : buffer
  } else {
    scf.yield %packets : buffer
  }
  view.store %zero, %header[0] : i64, view<6xi64>
  view.store %zero, %header[1] : i64, view<6xi64>
  view.store %one, %header[5] : i64, view<6xi64>
  func.return %output : buffer
}
