func.decl import("input") @encoder_create(%flags: i32, %transform_capacity: i64, %token_capacity: i64) -> (input.encoder)

func.decl import("input") @encoder_feed(%state: input.encoder, %input: buffer, %input_offset: i64, %input_length: i64, %output: buffer, %output_offset: i64, %output_capacity: i64) -> (i64, i64)

func.decl import("input") @encoder_finalize(%state: input.encoder, %output: buffer, %output_offset: i64, %output_capacity: i64) -> (i64, i32)

func.decl @pocket.normalizer_create(%raw_limit: offset) -> (buffer, buffer)

func.decl @pocket.normalizer_feed(%state: buffer, %pending: buffer, %text: buffer, %begin: offset, %end: offset)

func.decl @pocket.normalizer_peek(%state: buffer) -> (i64, i64, i32)

func.decl @pocket.normalizer_consume(%state: buffer, %pending: buffer, %count: i64)

func.decl @pocket.normalizer_finish(%state: buffer, %pending: buffer)

// Each request owns its exact ambiguous Unigram history. Native staging bounds
// one CPU turn's output; it does not truncate the lifetime token sequence.
func.def public @pocket.text_stream_create(%raw_limit: offset, %transform_capacity: i64, %token_capacity: i64) -> (buffer, buffer, input.encoder) {
  %state, %pending = func.call @pocket.normalizer_create(%raw_limit) : (offset) -> (buffer, buffer)
  %flags = scalar.constant 4 : i32
  %encoder = func.call @encoder_create(%flags, %transform_capacity, %token_capacity) : (i32, i64, i64) -> (input.encoder)
  func.return %state, %pending, %encoder : buffer, buffer, input.encoder
}

// One bounded CPU turn accepts at most the supplied complete-scalar window and
// emits at most the caller's token credit. The raw window is reusable after the
// returned consumed count retires. Normalized bytes remain owned until the
// encoder accepts them, independently of when their tokens become committed.
// Returns raw bytes consumed, IDs written, encoder completion, and whether
// another CPU turn can progress without new raw input. Stop after completion.
func.def public @pocket.text_stream_feed(%state: buffer, %pending: buffer, %encoder: input.encoder, %text: buffer, %begin: offset, %end: offset, %final: i32, %tokens: buffer, %token_capacity: i64) -> (i64, i64, i32, i32) {
  %zero = scalar.constant 0 : i64
  %zero32 = scalar.constant 0 : i32
  %unused_position, %old_length, %old_complete = func.call @pocket.normalizer_peek(%state) : (buffer) -> (i64, i64, i32)
  %empty = scalar.cmpi eq, %old_length, %zero : i64
  %open = scalar.cmpi eq, %old_complete, %zero32 : i32
  %accept = scalar.andi %empty, %open : i1
  %consumed = scf.if %accept -> (i64) {
    %has_input = index.cmp ult, %begin, %end : offset
    scf.if %has_input {
      func.call @pocket.normalizer_feed(%state, %pending, %text, %begin, %end) : (buffer, buffer, buffer, offset, offset)
    }
    %unused_position, %length, %unused_complete = func.call @pocket.normalizer_peek(%state) : (buffer) -> (i64, i64, i32)
    %drained = scalar.cmpi eq, %length, %zero : i64
    %last = scalar.cmpi ne, %final, %zero32 : i32
    %finish = scalar.andi %drained, %last : i1
    scf.if %finish {
      func.call @pocket.normalizer_finish(%state, %pending) : (buffer, buffer)
    }
    %bytes = index.sub %end, %begin : offset
    %bytes64 = index.cast %bytes : offset to i64
    scf.yield %bytes64 : i64
  } else {
    scf.yield %zero : i64
  }
  %position, %length, %complete = func.call @pocket.normalizer_peek(%state) : (buffer) -> (i64, i64, i32)
  %finished = scalar.cmpi ne, %complete, %zero32 : i32
  %taken, %written, %done = scf.if %finished -> (i64, i64, i32) {
    %written, %done = func.call @encoder_finalize(%encoder, %tokens, %zero, %token_capacity) : (input.encoder, buffer, i64, i64) -> (i64, i32)
    scf.yield %zero, %written, %done : i64, i64, i32
  } else {
    %taken, %written = func.call @encoder_feed(%encoder, %pending, %position, %length, %tokens, %zero, %token_capacity) : (input.encoder, buffer, i64, i64, buffer, i64, i64) -> (i64, i64)
    scf.yield %taken, %written, %zero32 : i64, i64, i32
  }
  func.call @pocket.normalizer_consume(%state, %pending, %taken) : (buffer, buffer, i64)
  %remaining = scalar.subi %length, %taken : i64
  %has_bytes = scalar.cmpi ne, %remaining, %zero : i64
  %full = scalar.cmpi eq, %written, %token_capacity : i64
  %last = scalar.cmpi ne, %final, %zero32 : i32
  %more = scalar.ori %has_bytes, %full : i1
  %more_or_final = scalar.ori %more, %last : i1
  %incomplete = scalar.cmpi eq, %done, %zero32 : i32
  %runnable = scalar.andi %more_or_final, %incomplete : i1
  %runnable32 = scalar.extui %runnable : i1 to i32
  func.return %consumed, %written, %done, %runnable32 : i64, i64, i32, i32
}
