template.decl @pocket.softmax.body(%elements: index, %rows: index, %capacity: index, %scores_storage: buffer, %probabilities_storage: buffer)

template.def<@pocket.softmax.body> device @softmax_body(%elements: index, %rows: index, %capacity: index, %scores_storage: buffer, %probabilities_storage: buffer) {
  %element = template.apply<@pocket.element>() : () -> (index)
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %live = index.cmp ult, %element, %elements : index
  scf.if %live {
    %origin = index.constant 0 : offset
    %scores_view = buffer.view %scores_storage[%origin] : buffer -> view<[%rows]x[%capacity]xf32>
    %probabilities_view = buffer.view %probabilities_storage[%origin] : buffer -> view<[%rows]x[%capacity]xf32>
    %negative = scalar.constant -1e+30 : f32
    %maximum = scf.for %i = [%c0 to %capacity step %c1](%acc = %negative : f32) -> (f32) {
      %value = view.load %scores_view[%element, %i] : view<[%rows]x[%capacity]xf32> -> f32
      %larger = scalar.cmpf ogt, %value, %acc : f32
      %next = scf.select %larger, %value, %acc : f32
      scf.yield %next : f32
    }
    %acc_zero = scalar.constant 0.0 : f64
    %total_wide = scf.for %i = [%c0 to %capacity step %c1](%acc = %acc_zero : f64) -> (f64) {
      %value = view.load %scores_view[%element, %i] : view<[%rows]x[%capacity]xf32> -> f32
      %shifted = scalar.subf %value, %maximum : f32
      %exponential = scalar.expf<afn> %shifted : f32
      view.store %exponential, %probabilities_view[%element, %i] : f32, view<[%rows]x[%capacity]xf32>
      %exp_wide = scalar.extf %exponential : f32 to f64
      %next = scalar.addf %acc, %exp_wide : f64
      scf.yield %next : f64
    }
    %total = scalar.fptrunc %total_wide : f64 to f32
    scf.for %i = [%c0 to %capacity step %c1] {
      %value = view.load %probabilities_view[%element, %i] : view<[%rows]x[%capacity]xf32> -> f32
      %normalized = scalar.divf %value, %total : f32
      view.store %normalized, %probabilities_view[%element, %i] : f32, view<[%rows]x[%capacity]xf32>
    }
  }
  template.return
}

kernel.def target(@pocket) @pocket.softmax_flow() {
  %elements = index.constant 16 : index
  %threads = config.get @pocket.threads : index
  %one = index.constant 1 : index
  %tail = index.sub %threads, %one : index
  %rounded = index.add %elements, %tail : index
  %groups = index.div %rounded, %threads : index
  kernel.launch.config workgroups(%groups, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%scores_storage: buffer, %probabilities_storage: buffer) {
  %elements = index.constant 16 : index
  %rows = index.constant 16 : index
  %capacity = config.get @pocket.context_capacity : index
  template.apply<@pocket.softmax.body>(%elements, %rows, %capacity, %scores_storage, %probabilities_storage) : (index, index, index, buffer, buffer)
  kernel.return
}

