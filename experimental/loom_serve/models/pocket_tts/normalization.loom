  template.apply<@pocket.normalization_affine.body>(%elements, %channels, %times, %divisor, %variance_divisor, %epsilon, %x_storage, %y_storage, %scale_storage, %bias_storage) : (index, index, index, f64, f64, f32, buffer, buffer, buffer, buffer)
