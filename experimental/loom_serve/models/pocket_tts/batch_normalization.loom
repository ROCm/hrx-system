kernel.def target(@pocket) @pocket.batch.softmax_flow_kernel() {
  %elements = index.constant 16 : index
  %threads = config.get @pocket.threads : index
  %one = index.constant 1 : index
  %tail = index.sub %threads, %one : index
  %rounded = index.add %elements, %tail : index
  %groups = index.div %rounded, %threads : index
  %batch_capacity = config.get @pocket.batch_capacity : index
  kernel.launch.config workgroups(%groups, %one, %batch_capacity) workgroup_size(%threads, %one, %one) : index
} launch(%membership: buffer, %scores_storage: buffer, %probabilities_storage: buffer, %scores_offset: offset, %scores_stride: offset, %probabilities_offset: offset, %probabilities_stride: offset) {
  %elements = index.constant 16 : index
  %rows = index.constant 16 : index
  %capacity = config.get @pocket.context_capacity : index
  template.apply<@pocket.batch.softmax>(%membership, %elements, %rows, %capacity, %scores_storage, %probabilities_storage, %scores_offset, %scores_stride, %probabilities_offset, %probabilities_stride) : (buffer, index, index, index, buffer, buffer, offset, offset, offset, offset)
  kernel.return
}

