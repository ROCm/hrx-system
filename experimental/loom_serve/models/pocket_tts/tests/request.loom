amdgpu.target<gfx11-generic> @pocket {subgroup_size = 32}

kernel.decl @pocket.initialize_request() launch(%state: buffer)

kernel.decl @pocket.save_conditioning() launch(%state: buffer, %conditioning: buffer)

kernel.decl @pocket.restore_conditioning() launch(%conditioning: buffer, %state: buffer)

kernel.decl @pocket.text_token() launch(%request: buffer, %state: buffer, %output: buffer)

kernel.decl @pocket.voice_block() launch(%samples: buffer, %state: buffer, %output: buffer)

kernel.decl @pocket.sample_noise() launch(%request: buffer, %state: buffer, %output: buffer)

kernel.decl @pocket.batch.sample_noise() launch(%membership: buffer, %request: buffer, %state: buffer, %output: buffer, %request_stride: offset, %state_stride: offset, %output_stride: offset)

template.decl pure @pocket.flow_state_words(%capacity: index) -> (index)

template.decl pure @pocket.state_words(%capacity: index) -> (index)

template.decl pure @pocket.state_size(%capacity: index) -> (offset)

// Maximum admitted state exceeds signed 32-bit bytes while its word count
// remains representable. Logical counts must never narrow a byte offset.
func.def @maximum_layout() -> (i64, i64, i64) {
  %capacity = index.constant 65536 : index
  %flow = template.apply<@pocket.flow_state_words>(%capacity) pure : (index) -> (index)
  %words = template.apply<@pocket.state_words>(%capacity) pure : (index) -> (index)
  %bytes = template.apply<@pocket.state_size>(%capacity) pure : (index) -> (offset)
  %flow64 = index.cast %flow : index to i64
  %words64 = index.cast %words : index to i64
  %bytes64 = index.cast %bytes : offset to i64
  func.return %flow64, %words64, %bytes64 : i64, i64, i64
}

check.case public @maximum_context_geometry {
  %flow, %words, %bytes = func.call @maximum_layout() : () -> (i64, i64, i64)
  %expected_flow = check.literal value(805306404) : i64
  %expected_words = check.literal value(806419114) : i64
  %expected_bytes = check.literal value(3225676456) : i64
  check.expect.equal actual(%flow) expected(%expected_flow) : i64
  check.expect.equal actual(%words) expected(%expected_words) : i64
  check.expect.equal actual(%bytes) expected(%expected_bytes) : i64
  check.return
}

// Context capacity 1 gives 12,324 conditioning words, 1,112,710 codec words,
// and two request cursors. Observe every word, including fresh-stream reset.
check.case public @fresh_state_overwrites_all_storage {
  %state = check.generate.fill value(37) : tensor<1125036xi32>
  %numerical = check.tensor.view %state offset(0) : tensor<1125036xi32> -> tensor<1125034xi32>
  %chunk = check.tensor.view %state offset(4500136) : tensor<1125036xi32> -> tensor<1xi32>
  %token = check.tensor.view %state offset(4500140) : tensor<1125036xi32> -> tensor<1xi32>
  %zeros = check.generate.fill value(0) : tensor<1125034xi32>
  %zero = check.generate.fill value(0) : tensor<1xi32>
  %missing = check.generate.fill value(-1) : tensor<1xi32>
  kernel.launch @pocket.initialize_request(%state) : (tensor<1125036xi32>)
  check.expect.bitwise actual(%numerical) expected(%zeros) : tensor<1125034xi32>
  check.expect.bitwise actual(%chunk) expected(%missing) : tensor<1xi32>
  check.expect.bitwise actual(%token) expected(%zero) : tensor<1xi32>
  check.return
}

check.case public @conditioning_restore_resets_chunk_state {
  %state = check.generate.fill value(37) : tensor<1125036xi32>
  kernel.launch @pocket.initialize_request(%state) : (tensor<1125036xi32>)
  %voice_state = check.generate.iota offset(100) step(1) : tensor<1125036xi32>
  %flow_expected = check.tensor.view %voice_state offset(0) : tensor<1125036xi32> -> tensor<12324xi32>
  %conditioning = check.generate.fill value(-7) : tensor<12324xi32>
  kernel.launch @pocket.save_conditioning(%voice_state, %conditioning) : (tensor<1125036xi32>, tensor<12324xi32>)
  check.expect.bitwise actual(%conditioning) expected(%flow_expected) : tensor<12324xi32>
  kernel.launch @pocket.restore_conditioning(%conditioning, %state) : (tensor<12324xi32>, tensor<1125036xi32>)
  %request = check.generate.iota offset(100) step(1) : tensor<20xi32>
  %token_output = check.generate.fill value(-1) : tensor<1xi32>
  kernel.launch @pocket.text_token(%request, %state, %token_output) : (tensor<20xi32>, tensor<1125036xi32>, tensor<1xi32>)
  kernel.launch @pocket.restore_conditioning(%conditioning, %state) : (tensor<12324xi32>, tensor<1125036xi32>)
  %flow = check.tensor.view %state offset(0) : tensor<1125036xi32> -> tensor<12324xi32>
  %codec = check.tensor.view %state offset(49296) : tensor<1125036xi32> -> tensor<1112710xi32>
  %chunk = check.tensor.view %state offset(4500136) : tensor<1125036xi32> -> tensor<1xi32>
  %token = check.tensor.view %state offset(4500140) : tensor<1125036xi32> -> tensor<1xi32>
  %codec_expected = check.generate.fill value(0) : tensor<1112710xi32>
  %one = check.generate.fill value(1) : tensor<1xi32>
  %zero = check.generate.fill value(0) : tensor<1xi32>
  check.expect.bitwise actual(%flow) expected(%flow_expected) : tensor<12324xi32>
  check.expect.bitwise actual(%codec) expected(%codec_expected) : tensor<1112710xi32>
  check.expect.bitwise actual(%chunk) expected(%one) : tensor<1xi32>
  check.expect.bitwise actual(%token) expected(%zero) : tensor<1xi32>
  check.return
}

kernel.def target(@pocket) @set_positions() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%state: buffer, %chunk: i32, %token: i32, %position: i32) {
  %origin = index.constant 0 : offset
  %header = buffer.view %state[%origin] : buffer -> view<4xi32>
  view.store %position, %header[1] : i32, view<4xi32>
  view.store %position, %header[2] : i32, view<4xi32>
  %control_origin = index.constant 4500136 : offset
  %control = buffer.view %state[%control_origin] : buffer -> view<2xi32>
  view.store %chunk, %control[0] : i32, view<2xi32>
  view.store %token, %control[1] : i32, view<2xi32>
  kernel.return
}

check.case public @immutable_packets_and_voice_rows {
  %state = check.generate.fill value(0) : tensor<1125036xi32>
  %request = check.generate.iota offset(100) step(1) : tensor<20xi32>
  %chunk = check.literal value(1) : i32
  %cursor = check.literal value(2) : i32
  %position = check.literal value(16) : i32
  kernel.launch @set_positions(%state, %chunk, %cursor, %position) : (tensor<1125036xi32>, i32, i32, i32)
  %first = check.generate.fill value(-1) : tensor<1xi32>
  %second = check.generate.fill value(-1) : tensor<1xi32>
  %first_expected = check.generate.fill value(118) : tensor<1xi32>
  %second_expected = check.generate.fill value(119) : tensor<1xi32>
  kernel.launch @pocket.text_token(%request, %state, %first) : (tensor<20xi32>, tensor<1125036xi32>, tensor<1xi32>)
  kernel.launch @pocket.text_token(%request, %state, %second) : (tensor<20xi32>, tensor<1125036xi32>, tensor<1xi32>)
  check.expect.bitwise actual(%first) expected(%first_expected) : tensor<1xi32>
  check.expect.bitwise actual(%second) expected(%second_expected) : tensor<1xi32>
  %cursor_view = check.tensor.view %state offset(4500140) : tensor<1125036xi32> -> tensor<1xi32>
  %cursor_expected = check.generate.fill value(4) : tensor<1xi32>
  check.expect.bitwise actual(%cursor_view) expected(%cursor_expected) : tensor<1xi32>
  %request_expected = check.generate.iota offset(100) step(1) : tensor<20xi32>
  check.expect.bitwise actual(%request) expected(%request_expected) : tensor<20xi32>
  %samples = check.generate.iota offset(0.0) step(0.125) : tensor<2x1920xf32>
  %block = check.generate.fill value(-1.0) : tensor<1920xf32>
  %block_expected = check.generate.iota offset(240.0) step(0.125) : tensor<1920xf32>
  kernel.launch @pocket.voice_block(%samples, %state, %block) : (tensor<2x1920xf32>, tensor<1125036xi32>, tensor<1920xf32>)
  check.expect.bitwise actual(%block) expected(%block_expected) : tensor<1920xf32>
  check.return
}

// Independent Random123 Philox4x32-10 + Box-Muller answers. Both halves of
// the key are nonzero; counters select quadruple, frame, and chunk. Expected
// samples were rounded to F32 at each arithmetic boundary, with sigma sqrt(.3).
