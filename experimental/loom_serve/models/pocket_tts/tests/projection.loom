    %b = check.generate.iota offset(-0.5) step(0.03125) : tensor<33xbf16>
    %y = check.generate.fill value(-123.0) : tensor<33x5xf32>
    check.compare<@pocket.project_bias_f32, @projection_expected_bias>[%outputs, %times](%inputs, %outputs, %times, %x, %w, %b, %y) : [index, index](index, index, index, tensor<7x5xf32>, tensor<33x7xbf16>, tensor<33xbf16>, tensor<33x5xf32>) -> () {
      check.expect.bitwise actual(%y) expected(%y) : tensor<33x5xf32>
