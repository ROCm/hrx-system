func.decl @pocket.normalize_text(%text: buffer) -> (buffer, i32)

// Pinned upstream English prepare_text_prompt output, including full uppercase
// expansion, every whitespace codepoint, each terminal/weak punctuation and
// closer, word-count tail selection, and single-pass space-pair replacement.
// BEGIN GENERATED POCKET ORACLE
global.constant @normalization_count : index = 357

global.rodata.def @normalization_records = align(4) bytes("")

global.rodata.def @normalization_inputs = align(4) bytes("")

global.rodata.def @normalization_outputs = align(4) bytes("")

// END GENERATED POCKET ORACLE
func.def @normalization_observations() -> (i32) {
  %record_storage = global.load @normalization_records : buffer
  %inputs = global.load @normalization_inputs : buffer
  %outputs = global.load @normalization_outputs : buffer
  %count = global.load @normalization_count : index
  %origin = index.constant 0 : offset
  %records = buffer.view %record_storage[%origin] : buffer -> view<[%count]x5xi32>
  %begin = index.constant 0 : index
  %one = index.constant 1 : index
  %zero = scalar.constant 0 : i32
  %first_error = scf.for %i = [%begin to %count step %one](%first_error = %zero : i32) -> (i32) {
    %input_position32 = view.load %records[%i, 0] : view<[%count]x5xi32> -> i32
    %input_length32 = view.load %records[%i, 1] : view<[%count]x5xi32> -> i32
    %expected_position32 = view.load %records[%i, 2] : view<[%count]x5xi32> -> i32
    %expected_length32 = view.load %records[%i, 3] : view<[%count]x5xi32> -> i32
    %expected_tail = view.load %records[%i, 4] : view<[%count]x5xi32> -> i32
    %input_position = index.cast %input_position32 : i32 to offset
    %input_length = index.cast %input_length32 : i32 to offset
    %expected_position = index.cast %expected_position32 : i32 to offset
    %expected_length = index.cast %expected_length32 : i32 to offset
    %input = buffer.alloca<private> align(1) %input_length : buffer
    buffer.copy %inputs[%input_position], %input[%origin], %input_length
    %actual, %tail = func.call @pocket.normalize_text(%input) : (buffer) -> (buffer, i32)
    %actual_length = buffer.length %actual
    %same_length = index.cmp eq, %actual_length, %expected_length : offset
    %same = scf.if %same_length -> (i1) {
      %comparison = buffer.compare %actual[%origin], %outputs[%expected_position], %expected_length
      %same_text = scalar.cmpi eq, %comparison, %zero : i32
      %same_tail = scalar.cmpi eq, %tail, %expected_tail : i32
      %same = scalar.andi %same_text, %same_tail : i1
      scf.yield %same : i1
    } else {
      %false = scalar.constant false : i1
      scf.yield %false : i1
    }
    %ordinal = index.add %i, %one : index
    %ordinal32 = index.cast %ordinal : index to i32
    %error = scf.select %same, %zero, %ordinal32 : i32
    %no_error = scalar.cmpi eq, %first_error, %zero : i32
    %next_error = scf.select %no_error, %error, %first_error : i32
    scf.yield %next_error : i32
  }
  func.return %first_error : i32
}

check.case @upstream_english_normalization {
  %error = func.call @normalization_observations() : () -> (i32)
  %zero = check.literal value(0) : i32
  check.expect.equal actual(%error) expected(%zero) : i32
  check.return
}
