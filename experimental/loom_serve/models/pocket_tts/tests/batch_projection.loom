// Exact dyadic operands keep the scalar oracle independent of panel reduction
// order. Three K panels, row/time tails, and full guarded banks expose shared
// bank reuse, independent weight/bias sharing, inactive rows, and empty cohorts.
amdgpu.target<gfx11-generic> @pocket {subgroup_size = 32}

kernel.decl @pocket.batch.project_f32_kernel(%output_rows: index, %time_steps: index) launch(%membership: buffer, %inputs: index, %outputs: index, %times: index, %input: buffer, %weight: buffer, %bias: buffer, %output: buffer, %input_offset: offset, %input_stride: offset, %weight_offset: offset, %weight_stride: offset, %bias_offset: offset, %bias_stride: offset, %output_offset: offset, %output_stride: offset)

kernel.decl @pocket.batch.project_bias_f32_kernel(%output_rows: index, %time_steps: index) launch(%membership: buffer, %inputs: index, %outputs: index, %times: index, %input: buffer, %weight: buffer, %bias: buffer, %output: buffer, %input_offset: offset, %input_stride: offset, %weight_offset: offset, %weight_stride: offset, %bias_offset: offset, %bias_stride: offset, %output_offset: offset, %output_stride: offset)

kernel.decl @pocket.batch.project_f64_kernel(%output_rows: index, %time_steps: index) launch(%membership: buffer, %inputs: index, %outputs: index, %times: index, %input: buffer, %weight: buffer, %bias: buffer, %output: buffer, %input_offset: offset, %input_stride: offset, %weight_offset: offset, %weight_stride: offset, %bias_offset: offset, %bias_stride: offset, %output_offset: offset, %output_stride: offset)

kernel.decl @pocket.batch.project_bias_f64_kernel(%output_rows: index, %time_steps: index) launch(%membership: buffer, %inputs: index, %outputs: index, %times: index, %input: buffer, %weight: buffer, %bias: buffer, %output: buffer, %input_offset: offset, %input_stride: offset, %weight_offset: offset, %weight_stride: offset, %bias_offset: offset, %bias_stride: offset, %output_offset: offset, %output_stride: offset)

template.decl @pocket.projection(%wide: i1, %biased: i1, %inputs: index, %outputs: index, %times: index, %row: index, %time: index, %input: buffer, %weight: buffer, %bias: buffer, %input_origin: offset, %weight_origin: offset, %bias_origin: offset) -> (f32)

func.def @projection_geometry(%trial: index) -> (index, index, offset, offset) {
  %five = index.constant 5 : index
  %three = index.constant 3 : index
  %count = index.rem %trial, %five : index
  %group = index.div %trial, %five : index
  %time_group = index.rem %group, %three : index
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %sixteen = index.constant 16 : index
  %is_first = index.cmp eq, %time_group, %zero : index
  %is_second = index.cmp eq, %time_group, %one : index
  %tail = scf.select %is_second, %three, %sixteen : index
  %times = scf.select %is_first, %one, %tail : index
  %fifteen = index.constant 15 : index
  %two = index.constant 2 : index
  %parameter_group = index.div %trial, %fifteen : index
  %weight_group = index.rem %parameter_group, %two : index
  %shared = index.cmp eq, %weight_group, %zero : index
  %thirty = index.constant 30 : index
  %shared_bias = index.cmp ult, %trial, %thirty : index
  %zero_offset = index.constant 0 : offset
  %weight_stride = index.constant 16978 : offset
  %stride = scf.select %shared, %zero_offset, %weight_stride : offset
  %bias_stride = index.constant 82 : offset
  %selected_bias_stride = scf.select %shared_bias, %zero_offset, %bias_stride : offset
  func.return %count, %times, %stride, %selected_bias_stride : index, index, offset, offset
}

func.def @projection_membership(%count: index, %membership: buffer) {
  %origin = index.constant 0 : offset
  %view = buffer.view %membership[%origin] : buffer -> view<5xi32>
  %count32 = index.cast %count : index to i32
  %a = scalar.constant 9 : i32
  %b = scalar.constant 2 : i32
  %c = scalar.constant 7 : i32
  %d = scalar.constant 4 : i32
  view.store %count32, %view[0] : i32, view<5xi32>
  view.store %a, %view[1] : i32, view<5xi32>
  view.store %b, %view[2] : i32, view<5xi32>
  view.store %c, %view[3] : i32, view<5xi32>
  view.store %d, %view[4] : i32, view<5xi32>
  func.return
}

func.def @projection_expected(%wide: i1, %biased: i1, %membership: buffer, %inputs: index, %outputs: index, %times: index, %input: buffer, %weight: buffer, %bias: buffer, %output: buffer, %input_offset: offset, %input_stride: offset, %weight_offset: offset, %weight_stride: offset, %bias_offset: offset, %bias_stride: offset, %output_offset: offset, %output_stride: offset) {
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %origin = index.constant 0 : offset
  %map = buffer.view %membership[%origin] : buffer -> view<5xi32>
  %count32 = view.load %map[0] : view<5xi32> -> i32
  %count = index.cast %count32 : i32 to index
  scf.for %packed = [%zero to %count step %one] {
    %input_relative = index.scale %packed, %input_stride : index, offset -> offset
    %input_origin = index.add %input_offset, %input_relative : offset
    %weight_relative = index.scale %packed, %weight_stride : index, offset -> offset
    %weight_origin = index.add %weight_offset, %weight_relative : offset
    %bias_relative = index.scale %packed, %bias_stride : index, offset -> offset
    %bias_origin = index.add %bias_offset, %bias_relative : offset
    %output_relative = index.scale %packed, %output_stride : index, offset -> offset
    %output_origin = index.add %output_offset, %output_relative : offset
    %target = buffer.view %output[%output_origin] : buffer -> view<[%outputs]x[%times]xf32>
    scf.for %row = [%zero to %outputs step %one] {
      scf.for %time = [%zero to %times step %one] {
        %value = template.apply<@pocket.projection>(%wide, %biased, %inputs, %outputs, %times, %row, %time, %input, %weight, %bias, %input_origin, %weight_origin, %bias_origin) : (i1, i1, index, index, index, index, index, buffer, buffer, buffer, offset, offset, offset) -> (f32)
        view.store %value, %target[%row, %time] : f32, view<[%outputs]x[%times]xf32>
      }
    }
  }
  func.return
}

func.def @expected_f32(%membership: buffer, %inputs: index, %outputs: index, %times: index, %input: buffer, %weight: buffer, %bias: buffer, %output: buffer, %input_offset: offset, %input_stride: offset, %weight_offset: offset, %weight_stride: offset, %bias_offset: offset, %bias_stride: offset, %output_offset: offset, %output_stride: offset) {
  %wide = scalar.constant false : i1
  %biased = scalar.constant false : i1
  func.call @projection_expected(%wide, %biased, %membership, %inputs, %outputs, %times, %input, %weight, %bias, %output, %input_offset, %input_stride, %weight_offset, %weight_stride, %bias_offset, %bias_stride, %output_offset, %output_stride) : (i1, i1, buffer, index, index, index, buffer, buffer, buffer, buffer, offset, offset, offset, offset, offset, offset, offset, offset)
  func.return
}

check.scenario public @project_f32_packed_ownership {
  check.trial[30](%trial: index, %entropy: check.entropy) {
    %count, %times, %weight_stride, %bias_stride = check.generate<@projection_geometry>(%trial) : (index) -> (index, index, offset, offset)
    %inputs = check.literal value(257) : index
    %outputs = check.literal value(33) : index
    %origin = check.literal value(16) : offset
    %input_stride = check.literal value(16464) : offset
    %output_stride = check.literal value(2128) : offset
    %membership = check.generate.fill value(-1) : tensor<5xi32>
    %input = check.generate.iota offset(-1.0) step(0.03125) period(71) : tensor<16472xf32>
    %weight = check.generate.iota offset(-0.5) step(0.015625) period(67) : tensor<33972xbf16>
    %bias = check.generate.iota offset(-0.25) step(0.03125) period(17) : tensor<180xbf16>
    %output = check.generate.fill value(-123.0) : tensor<2136xf32>
    check.generate<@projection_membership>(%count, %membership) : (index, tensor<5xi32>) -> ()
    check.compare<@pocket.batch.project_f32_kernel, @expected_f32>[%outputs, %times](%membership, %inputs, %outputs, %times, %input, %weight, %bias, %output, %origin, %input_stride, %origin, %weight_stride, %origin, %bias_stride, %origin, %output_stride) : [index, index](tensor<5xi32>, index, index, index, tensor<16472xf32>, tensor<33972xbf16>, tensor<180xbf16>, tensor<2136xf32>, offset, offset, offset, offset, offset, offset, offset, offset) -> () {
      check.expect.bitwise actual(%membership) expected(%membership) : tensor<5xi32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<16472xf32>
      check.expect.bitwise actual(%weight) expected(%weight) : tensor<33972xbf16>
      check.expect.bitwise actual(%bias) expected(%bias) : tensor<180xbf16>
      check.expect.bitwise actual(%output) expected(%output) : tensor<2136xf32>
    }
  }
  check.return
}

func.def @expected_bias_f32(%membership: buffer, %inputs: index, %outputs: index, %times: index, %input: buffer, %weight: buffer, %bias: buffer, %output: buffer, %input_offset: offset, %input_stride: offset, %weight_offset: offset, %weight_stride: offset, %bias_offset: offset, %bias_stride: offset, %output_offset: offset, %output_stride: offset) {
  %wide = scalar.constant false : i1
  %biased = scalar.constant true : i1
  func.call @projection_expected(%wide, %biased, %membership, %inputs, %outputs, %times, %input, %weight, %bias, %output, %input_offset, %input_stride, %weight_offset, %weight_stride, %bias_offset, %bias_stride, %output_offset, %output_stride) : (i1, i1, buffer, index, index, index, buffer, buffer, buffer, buffer, offset, offset, offset, offset, offset, offset, offset, offset)
  func.return
}

