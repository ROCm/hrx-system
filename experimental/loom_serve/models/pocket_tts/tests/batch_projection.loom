  %input_0_2 = check.tensor.view %reference_input offset(192) : tensor<92xf32> -> tensor<15xf32>
  %weight_0_2 = check.tensor.view %reference_weight offset(16) : tensor<58xbf16> -> tensor<35xbf16>
  %bias_0_2 = check.tensor.view %reference_bias offset(16) : tensor<30xbf16> -> tensor<7xbf16>
  %output_0_2 = check.tensor.view %reference_output offset(240) : tensor<116xf32> -> tensor<21xf32>
