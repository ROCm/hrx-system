  %weight_0_0 = check.tensor.view %reference_weight offset(16) : tensor<58xbf16> -> tensor<35xbf16>
  %bias_0_0 = check.tensor.view %reference_bias offset(16) : tensor<30xbf16> -> tensor<7xbf16>
  %output_0_0 = check.tensor.view %reference_output offset(16) : tensor<116xf32> -> tensor<21xf32>
  kernel.launch @pocket.project_f32[%outputs, %times](%inputs, %outputs, %times, %input_0_0, %weight_0_0, %bias_0_0, %output_0_0) : [index, index](index, index, index, tensor<15xf32>, tensor<35xbf16>, tensor<7xbf16>, tensor<21xf32>)
  %input_0_1 = check.tensor.view %reference_input offset(104) : tensor<92xf32> -> tensor<15xf32>
  %weight_0_1 = check.tensor.view %reference_weight offset(16) : tensor<58xbf16> -> tensor<35xbf16>
  %bias_0_1 = check.tensor.view %reference_bias offset(16) : tensor<30xbf16> -> tensor<7xbf16>
  %output_0_1 = check.tensor.view %reference_output offset(128) : tensor<116xf32> -> tensor<21xf32>
