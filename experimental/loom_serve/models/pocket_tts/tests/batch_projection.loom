  kernel.launch @batched_project_f32(%membership, %actual_input, %actual_weight, %actual_bias, %actual_output) : (tensor<5xi32>, tensor<92xf32>, tensor<58xbf16>, tensor<30xbf16>, tensor<116xf32>)
