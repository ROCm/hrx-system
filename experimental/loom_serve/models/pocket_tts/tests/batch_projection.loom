// Reordered active rows use independent packed scratch and resident state.
// Every tensor has a nonzero origin and padding between rows. Comparing the
// complete banks with isolated calls also observes all guards and inactive rows.
amdgpu.target<gfx11-generic> @pocket {subgroup_size = 32}

config.decl @pocket.batch_capacity : %value: index where [range(%value, 1, 65536)]

kernel.decl @pocket.project_f32(%outputs$1: index, %times$2: index) launch(%inputs: index, %outputs$4: index, %times$5: index, %input: buffer, %weight: buffer, %bias: buffer, %output: buffer)

kernel.decl @pocket.project_bias_f32(%outputs$10: index, %times$11: index) launch(%inputs: index, %outputs$13: index, %times$14: index, %input: buffer, %weight: buffer, %bias: buffer, %output: buffer)

kernel.decl @pocket.project_f64(%outputs$19: index, %times$20: index) launch(%inputs: index, %outputs$22: index, %times$23: index, %input: buffer, %weight: buffer, %bias: buffer, %output: buffer)

kernel.decl @pocket.project_bias_f64(%outputs$28: index, %times$29: index) launch(%inputs: index, %outputs$31: index, %times$32: index, %input: buffer, %weight: buffer, %bias: buffer, %output: buffer)

kernel.def target(@pocket) @batch_metadata() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%count: i32, %first: i32, %second: i32, %third: i32, %fourth: i32, %membership: buffer) {
  %origin = index.constant 0 : offset
  %map = buffer.view %membership[%origin] : buffer -> view<5xi32>
  view.store %count, %map[0] : i32, view<5xi32>
  view.store %first, %map[1] : i32, view<5xi32>
  view.store %second, %map[2] : i32, view<5xi32>
  view.store %third, %map[3] : i32, view<5xi32>
  view.store %fourth, %map[4] : i32, view<5xi32>
  kernel.return
}

template.decl @pocket.batch.project(%membership: buffer, %wide: i1, %biased: i1, %inputs: index, %outputs: index, %times: index, %input: buffer, %weight: buffer, %bias: buffer, %output: buffer, %input_offset: offset, %input_stride: offset, %weight_offset: offset, %weight_stride: offset, %bias_offset: offset, %bias_stride: offset, %output_offset: offset, %output_stride: offset)

kernel.def target(@pocket) @batched_project_f32() {
  %groups = index.constant 1 : index
  %one = index.constant 1 : index
  %times = index.constant 3 : index
  %threads = index.constant 128 : index
  %batch = config.get @pocket.batch_capacity : index
  kernel.launch.config workgroups(%groups, %times, %batch) workgroup_size(%threads, %one, %one) : index
} launch(%membership: buffer, %input_storage: buffer, %weight_storage: buffer, %bias_storage: buffer, %output_storage: buffer) {
  %wide = scalar.constant false : i1
  %biased = scalar.constant false : i1
  %inputs = index.constant 5 : index
  %outputs = index.constant 7 : index
  %times = index.constant 3 : index
  %origin = index.constant 16 : offset
  %input_stride = index.constant 88 : offset
  %weight_stride = index.constant 0 : offset
  %bias_stride = index.constant 0 : offset
  %output_stride = index.constant 112 : offset
  template.apply<@pocket.batch.project>(%membership, %wide, %biased, %inputs, %outputs, %times, %input_storage, %weight_storage, %bias_storage, %output_storage, %origin, %input_stride, %origin, %weight_stride, %origin, %bias_stride, %origin, %output_stride) : (buffer, i1, i1, index, index, index, buffer, buffer, buffer, buffer, offset, offset, offset, offset, offset, offset, offset, offset)
  kernel.return
}

