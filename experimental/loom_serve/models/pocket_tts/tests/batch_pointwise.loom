check.case public @gelu_row_ownership {
  %membership = check.generate.fill value(-1) : tensor<5xi32>
  %unused = check.literal value(-1) : i32
  %word_0 = check.literal value(0) : i32
  %word_1 = check.literal value(1) : i32
  %word_2 = check.literal value(2) : i32
  %word_3 = check.literal value(3) : i32
  %word_4 = check.literal value(4) : i32
  %word_5 = check.literal value(5) : i32
  %word_6 = check.literal value(6) : i32
  %x_seed = check.literal value(100) : i64
  %actual_x = check.generate.random.uniform seed(%x_seed) range(-0.5 to 0.5) : tensor<180xf32>
  %reference_x = check.generate.random.uniform seed(%x_seed) range(-0.5 to 0.5) : tensor<180xf32>
  %y_seed = check.literal value(101) : i64
  %actual_y = check.generate.random.uniform seed(%y_seed) range(-0.5 to 0.5) : tensor<180xf32>
  %reference_y = check.generate.random.uniform seed(%y_seed) range(-0.5 to 0.5) : tensor<180xf32>
  kernel.launch @batch_metadata(%word_3, %word_5, %word_0, %word_1, %unused, %membership) : (i32, i32, i32, i32, i32, tensor<5xi32>)
  kernel.launch @batched_gelu(%membership, %actual_x, %actual_y) : (tensor<5xi32>, tensor<180xf32>, tensor<180xf32>)
  %x_0_0 = check.tensor.view %reference_x offset(16) : tensor<180xf32> -> tensor<37xf32>
  %y_0_0 = check.tensor.view %reference_y offset(16) : tensor<180xf32> -> tensor<37xf32>
  kernel.launch @isolated_gelu(%x_0_0, %y_0_0) : (tensor<37xf32>, tensor<37xf32>)
  %x_0_1 = check.tensor.view %reference_x offset(192) : tensor<180xf32> -> tensor<37xf32>
  %y_0_1 = check.tensor.view %reference_y offset(192) : tensor<180xf32> -> tensor<37xf32>
  kernel.launch @isolated_gelu(%x_0_1, %y_0_1) : (tensor<37xf32>, tensor<37xf32>)
  %x_0_2 = check.tensor.view %reference_x offset(368) : tensor<180xf32> -> tensor<37xf32>
  %y_0_2 = check.tensor.view %reference_y offset(368) : tensor<180xf32> -> tensor<37xf32>
  kernel.launch @isolated_gelu(%x_0_2, %y_0_2) : (tensor<37xf32>, tensor<37xf32>)
  check.expect.bitwise actual(%actual_x) expected(%reference_x) : tensor<180xf32>
  check.expect.bitwise actual(%actual_y) expected(%reference_y) : tensor<180xf32>
  kernel.launch @batch_metadata(%word_0, %unused, %unused, %unused, %unused, %membership) : (i32, i32, i32, i32, i32, tensor<5xi32>)
  kernel.launch @batched_gelu(%membership, %actual_x, %actual_y) : (tensor<5xi32>, tensor<180xf32>, tensor<180xf32>)
  check.expect.bitwise actual(%actual_x) expected(%reference_x) : tensor<180xf32>
  check.expect.bitwise actual(%actual_y) expected(%reference_y) : tensor<180xf32>
  check.return
}

