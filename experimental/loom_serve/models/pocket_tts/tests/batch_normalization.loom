// The serial oracle reduces complete columns independently of the cooperative
// implementation. Full banks retain nonzero origins, row padding, and inactive
// rows. Affine/plain normalization centers population moments; variance scaling
// uses sample variance and preserves the input mean.
amdgpu.target<gfx11-generic> @pocket {subgroup_size = 32}

config.decl @pocket.batch_capacity : %value: index where [range(%value, 1, 65536)]

template.decl @pocket.batch.normalization_panel(%membership: buffer, %center: i1, %scaled: i1, %biased: i1, %elements: index, %channels: index, %times: index, %divisor: f64, %variance_divisor: f64, %epsilon: f32, %input: buffer, %output: buffer, %scale: buffer, %bias: buffer, %input_offset: offset, %input_stride: offset, %output_offset: offset, %output_stride: offset, %scale_offset: offset, %scale_stride: offset, %bias_offset: offset, %bias_stride: offset)

func.def @normalization_controls(%trial: index) -> (index, index, offset) {
  %five = index.constant 5 : index
  %ten = index.constant 10 : index
  %count = index.rem %trial, %five : index
  %mode = index.div %trial, %ten : index
  %within = index.rem %trial, %ten : index
  %shared = index.cmp ult, %within, %five : index
  %separate = index.constant 2064 : offset
  %zero = index.constant 0 : offset
  %stride = scf.select %shared, %zero, %separate : offset
  func.return %count, %mode, %stride : index, index, offset
}

func.def @normalization_membership(%count: index, %storage: buffer) {
  %origin = index.constant 0 : offset
  %view = buffer.view %storage[%origin] : buffer -> view<5xi32>
  %count32 = index.cast %count : index to i32
  %first = scalar.constant 9 : i32
  %second = scalar.constant 2 : i32
  %third = scalar.constant 7 : i32
  %fourth = scalar.constant 4 : i32
  view.store %count32, %view[0] : i32, view<5xi32>
  view.store %first, %view[1] : i32, view<5xi32>
  view.store %second, %view[2] : i32, view<5xi32>
  view.store %third, %view[3] : i32, view<5xi32>
  view.store %fourth, %view[4] : i32, view<5xi32>
  func.return
}

func.def @normalization_expected(%membership: buffer, %input: buffer, %output: buffer, %scale: buffer, %bias: buffer, %mode: index, %channels: index, %times: index, %epsilon: f32, %input_offset: offset, %input_stride: offset, %output_offset: offset, %output_stride: offset, %scale_offset: offset, %scale_stride: offset, %bias_offset: offset, %bias_stride: offset) {
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %origin = index.constant 0 : offset
  %map = buffer.view %membership[%origin] : buffer -> view<5xi32>
  %count32 = view.load %map[0] : view<5xi32> -> i32
  %count = index.cast %count32 : i32 to index
  %channels32 = index.cast %channels : index to i32
  %divisor = scalar.uitofp %channels32 : i32 to f64
  %one64 = scalar.constant 1.0 : f64
  %sample_divisor = scalar.subf %divisor, %one64 : f64
  %sample = index.cmp eq, %mode, %two : index
  %affine = index.cmp eq, %mode, %zero : index
  %variance_divisor = scf.select %sample, %sample_divisor, %divisor : f64
  %zero64 = scalar.constant 0.0 : f64
  scf.for %packed = [%zero to %count step %one] {
    %input_relative = index.scale %packed, %input_stride : index, offset -> offset
    %input_origin = index.add %input_offset, %input_relative : offset
    %output_relative = index.scale %packed, %output_stride : index, offset -> offset
    %output_origin = index.add %output_offset, %output_relative : offset
    %scale_relative = index.scale %packed, %scale_stride : index, offset -> offset
    %scale_origin = index.add %scale_offset, %scale_relative : offset
    %bias_relative = index.scale %packed, %bias_stride : index, offset -> offset
    %bias_origin = index.add %bias_offset, %bias_relative : offset
    %x = buffer.view %input[%input_origin] : buffer -> view<[%channels]x[%times]xf32>
    %y = buffer.view %output[%output_origin] : buffer -> view<[%channels]x[%times]xf32>
    %factors = buffer.view %scale[%scale_origin] : buffer -> view<[%channels]xbf16>
    %shifts = buffer.view %bias[%bias_origin] : buffer -> view<[%channels]xbf16>
    scf.for %time = [%zero to %times step %one] {
      %total = scf.for %channel = [%zero to %channels step %one](%sum = %zero64 : f64) -> (f64) {
        %value = view.load %x[%channel, %time] : view<[%channels]x[%times]xf32> -> f32
        %wide = scalar.extf %value : f32 to f64
        %next = scalar.addf %sum, %wide : f64
        scf.yield %next : f64
      }
      %mean64 = scalar.divf %total, %divisor : f64
      %mean = scalar.fptrunc %mean64 : f64 to f32
      %squared = scf.for %channel = [%zero to %channels step %one](%sum = %zero64 : f64) -> (f64) {
        %value = view.load %x[%channel, %time] : view<[%channels]x[%times]xf32> -> f32
        %centered = scalar.subf %value, %mean : f32
        %wide = scalar.extf %centered : f32 to f64
        %next = scalar.fmaf %wide, %wide, %sum : f64
        scf.yield %next : f64
      }
      %variance64 = scalar.divf %squared, %variance_divisor : f64
      %variance = scalar.fptrunc %variance64 : f64 to f32
      %stabilized = scalar.addf %variance, %epsilon : f32
      %inverse = scalar.rsqrtf<afn> %stabilized : f32
      scf.for %channel = [%zero to %channels step %one] {
        %value = view.load %x[%channel, %time] : view<[%channels]x[%times]xf32> -> f32
        %result = scf.if %sample -> (f32) {
          %stored = view.load %factors[%channel] : view<[%channels]xbf16> -> bf16
          %factor = scalar.extf %stored : bf16 to f32
          %multiplier = scalar.mulf %factor, %inverse : f32
          %result = scalar.mulf %value, %multiplier : f32
          scf.yield %result : f32
        } else {
          %centered = scalar.subf %value, %mean : f32
          %normalized = scalar.mulf %centered, %inverse : f32
          %result = scf.if %affine -> (f32) {
            %factor_stored = view.load %factors[%channel] : view<[%channels]xbf16> -> bf16
            %factor = scalar.extf %factor_stored : bf16 to f32
            %shift_stored = view.load %shifts[%channel] : view<[%channels]xbf16> -> bf16
            %shift = scalar.extf %shift_stored : bf16 to f32
            %scaled = scalar.mulf %normalized, %factor : f32
            %shifted = scalar.addf %scaled, %shift : f32
            scf.yield %shifted : f32
          } else {
            scf.yield %normalized : f32
          }
          scf.yield %result : f32
        }
        view.store %result, %y[%channel, %time] : f32, view<[%channels]x[%times]xf32>
      }
    }
  }
  func.return
}

template.decl @normalization_case(%membership: buffer, %input: buffer, %output: buffer, %scale: buffer, %bias: buffer, %mode: index, %parameter_stride: offset, %channels: index, %times: index, %epsilon: f32)

template.def<@normalization_case> device @normalization_case_body(%membership: buffer, %input: buffer, %output: buffer, %scale: buffer, %bias: buffer, %mode: index, %parameter_stride: offset, %channels: index, %times: index, %epsilon: f32) {
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %center = index.cmp ne, %mode, %two : index
  %scaled = index.cmp ne, %mode, %one : index
  %biased = index.cmp eq, %mode, %zero : index
  %channels32 = index.cast %channels : index to i32
  %divisor = scalar.uitofp %channels32 : i32 to f64
  %one64 = scalar.constant 1.0 : f64
  %sample_divisor = scalar.subf %divisor, %one64 : f64
  %variance_divisor = scf.select %center, %divisor, %sample_divisor : f64
  %sample_epsilon = scalar.constant 1.0e-5 : f32
  %selected_epsilon = scf.select %center, %epsilon, %sample_epsilon : f32
  %origin = index.constant 16 : offset
  %stride = index.constant 32784 : offset
  template.apply<@pocket.batch.normalization_panel>(%membership, %center, %scaled, %biased, %times, %channels, %times, %divisor, %variance_divisor, %selected_epsilon, %input, %output, %scale, %bias, %origin, %stride, %origin, %stride, %origin, %parameter_stride, %origin, %parameter_stride) : (buffer, i1, i1, i1, index, index, index, f64, f64, f32, buffer, buffer, buffer, buffer, offset, offset, offset, offset, offset, offset, offset, offset)
  template.return
}

func.def @normalization_case_expected(%membership: buffer, %input: buffer, %output: buffer, %scale: buffer, %bias: buffer, %mode: index, %parameter_stride: offset, %channels: index, %times: index, %epsilon: f32) {
  %origin = index.constant 16 : offset
  %stride = index.constant 32784 : offset
  %two = index.constant 2 : index
  %sample = index.cmp eq, %mode, %two : index
  %sample_epsilon = scalar.constant 1.0e-5 : f32
  %selected_epsilon = scf.select %sample, %sample_epsilon, %epsilon : f32
  func.call @normalization_expected(%membership, %input, %output, %scale, %bias, %mode, %channels, %times, %selected_epsilon, %origin, %stride, %origin, %stride, %origin, %parameter_stride, %origin, %parameter_stride) : (buffer, buffer, buffer, buffer, buffer, index, index, index, f32, offset, offset, offset, offset, offset, offset, offset, offset)
  func.return
}

kernel.def target(@pocket) @normalization_panel_1024x1() {
  %one = index.constant 1 : index
  %groups = index.constant 1 : index
  %batch = config.get @pocket.batch_capacity : index
  %threads = index.constant 128 : index
  kernel.launch.config workgroups(%groups, %one, %batch) workgroup_size(%threads, %one, %one) : index
} launch(%membership: buffer, %input: buffer, %output: buffer, %scale: buffer, %bias: buffer, %mode: index, %parameter_stride: offset) {
  %channels = index.constant 1024 : index
  %times = index.constant 1 : index
  %epsilon = scalar.constant 1.0e-5 : f32
  template.apply<@normalization_case>(%membership, %input, %output, %scale, %bias, %mode, %parameter_stride, %channels, %times, %epsilon) : (buffer, buffer, buffer, buffer, buffer, index, offset, index, index, f32)
  kernel.return
}

func.def @expected_panel_1024x1(%membership: buffer, %input: buffer, %output: buffer, %scale: buffer, %bias: buffer, %mode: index, %parameter_stride: offset) {
  %channels = index.constant 1024 : index
  %times = index.constant 1 : index
  %epsilon = scalar.constant 1.0e-5 : f32
  func.call @normalization_case_expected(%membership, %input, %output, %scale, %bias, %mode, %parameter_stride, %channels, %times, %epsilon) : (buffer, buffer, buffer, buffer, buffer, index, offset, index, index, f32)
  func.return
}

check.scenario public @normalization_panel_1024x1_family {
  check.trial[30](%trial: index, %entropy: check.entropy) {
    %count, %mode, %parameter_stride = check.generate<@normalization_controls>(%trial) : (index) -> (index, index, offset)
    %membership = check.generate.fill value(-1) : tensor<5xi32>
    %input = check.generate.iota offset(-1.0) step(0.03125) period(71) : tensor<32792xf32>
    %output = check.generate.fill value(-123.0) : tensor<32792xf32>
    %scale = check.generate.iota offset(-0.5) step(0.015625) period(67) : tensor<4136xbf16>
    %bias = check.generate.iota offset(-0.25) step(0.03125) period(17) : tensor<4136xbf16>
    check.generate<@normalization_membership>(%count, %membership) : (index, tensor<5xi32>) -> ()
    check.compare<@normalization_panel_1024x1, @expected_panel_1024x1>(%membership, %input, %output, %scale, %bias, %mode, %parameter_stride) : (tensor<5xi32>, tensor<32792xf32>, tensor<32792xf32>, tensor<4136xbf16>, tensor<4136xbf16>, index, offset) -> () {
      check.expect.bitwise actual(%membership) expected(%membership) : tensor<5xi32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<32792xf32>
      check.expect.bitwise actual(%scale) expected(%scale) : tensor<4136xbf16>
      check.expect.bitwise actual(%bias) expected(%bias) : tensor<4136xbf16>
      check.expect.close actual(%output) expected(%output) atol(1.0e-6) rtol(1.0e-6) nan(different) : tensor<32792xf32>
    }
  }
  check.return
}

