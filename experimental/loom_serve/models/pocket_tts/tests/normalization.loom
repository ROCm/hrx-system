amdgpu.target<gfx11-generic> @pocket {subgroup_size = 32}

template.decl @pocket.normalization_affine.body(%elements: index, %channels: index, %times: index, %divisor: f64, %variance_divisor: f64, %epsilon: f32, %x_storage: buffer, %y_storage: buffer, %scale_storage: buffer, %bias_storage: buffer)

kernel.def target(@pocket) @test_normalization_affine() {
  %one = index.constant 1 : index
  %threads = index.constant 128 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%input: buffer, %output: buffer, %scale: buffer, %bias: buffer) {
  %elements = index.constant 3 : index
  %channels = index.constant 7 : index
  %times = index.constant 3 : index
  %divisor = scalar.constant 7.0 : f64
  %variance_divisor = scalar.constant 7.0 : f64
  %epsilon = scalar.constant 1.75 : f32
  template.apply<@pocket.normalization_affine.body>(%elements, %channels, %times, %divisor, %variance_divisor, %epsilon, %input, %output, %scale, %bias) : (index, index, index, f64, f64, f32, buffer, buffer, buffer, buffer)
  kernel.return
}

template.decl @pocket.normalization_variance.body(%elements: index, %channels: index, %times: index, %divisor: f64, %variance_divisor: f64, %epsilon: f32, %x_storage: buffer, %y_storage: buffer, %scale_storage: buffer)

kernel.def target(@pocket) @test_normalization_variance() {
  %one = index.constant 1 : index
  %threads = index.constant 128 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%input: buffer, %output: buffer, %scale: buffer, %bias: buffer) {
  %elements = index.constant 3 : index
  %channels = index.constant 7 : index
  %times = index.constant 3 : index
  %divisor = scalar.constant 7.0 : f64
  %variance_divisor = scalar.constant 6.0 : f64
  %epsilon = scalar.constant 1.375 : f32
  template.apply<@pocket.normalization_variance.body>(%elements, %channels, %times, %divisor, %variance_divisor, %epsilon, %input, %output, %scale) : (index, index, index, f64, f64, f32, buffer, buffer, buffer)
  kernel.return
}

template.decl @pocket.normalization_plain.body(%elements: index, %channels: index, %times: index, %divisor: f64, %variance_divisor: f64, %epsilon: f32, %x_storage: buffer, %y_storage: buffer)

kernel.def target(@pocket) @test_normalization_plain() {
  %one = index.constant 1 : index
  %threads = index.constant 128 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%input: buffer, %output: buffer, %scale: buffer, %bias: buffer) {
  %elements = index.constant 3 : index
  %channels = index.constant 7 : index
  %times = index.constant 3 : index
  %divisor = scalar.constant 7.0 : f64
  %variance_divisor = scalar.constant 7.0 : f64
  %epsilon = scalar.constant 1.75 : f32
  template.apply<@pocket.normalization_plain.body>(%elements, %channels, %times, %divisor, %variance_divisor, %epsilon, %input, %output) : (index, index, index, f64, f64, f32, buffer, buffer)
  kernel.return
}

// X[c,t] = 1 + 3*c/4 + t/4 has centered values 3*(c-3)/4.
// Its population variance is 2.25 and its sample variance is 2.625.
// The selected epsilon makes both stabilized variances exactly four. This
// separates centered affine/plain normalization from uncentered variance scaling.
func.def @normalization_expected(%variance_only: i1, %affine: i1, %output: buffer) {
  %origin = index.constant 0 : offset
  %view = buffer.view %output[%origin] : buffer -> view<7x3xf32>
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %channels = index.constant 7 : index
  %times = index.constant 3 : index
  %center_origin = scalar.constant -1.125 : f32
  %center_step = scalar.constant 0.375 : f32
  %half = scalar.constant 0.5 : f32
  %time_step = scalar.constant 0.125 : f32
  %scale_step = scalar.constant 0.125 : f32
  %bias_origin = scalar.constant -0.25 : f32
  %bias_step = scalar.constant 0.0625 : f32
  scf.for %channel = [%zero to %channels step %one] {
    %channel_word = index.cast %channel : index to i32
    %channel_float = scalar.uitofp %channel_word : i32 to f32
    %centered = scalar.fmaf %channel_float, %center_step, %center_origin : f32
    %uncentered = scalar.fmaf %channel_float, %center_step, %half : f32
    %scale = scalar.fmaf %channel_float, %scale_step, %half : f32
    %bias = scalar.fmaf %channel_float, %bias_step, %bias_origin : f32
    %scaled = scalar.mulf %centered, %scale : f32
    %shifted = scalar.addf %scaled, %bias : f32
    %normalized = scf.select %affine, %shifted, %centered : f32
    scf.for %time = [%zero to %times step %one] {
      %time_word = index.cast %time : index to i32
      %time_float = scalar.uitofp %time_word : i32 to f32
      %raw = scalar.fmaf %time_float, %time_step, %uncentered : f32
      %variance_scaled = scalar.mulf %raw, %scale : f32
      %value = scf.select %variance_only, %variance_scaled, %normalized : f32
      view.store %value, %view[%channel, %time] : f32, view<7x3xf32>
    }
  }
  func.return
}

func.def @expected_normalization_affine(%input: buffer, %output: buffer, %scale: buffer, %bias: buffer) {
  %variance_only = scalar.constant false : i1
  %affine = scalar.constant true : i1
  func.call @normalization_expected(%variance_only, %affine, %output) : (i1, i1, buffer)
  func.return
}

check.scenario public @normalization_affine {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(1.0) step(0.25) : tensor<7x3xf32>
    %output = check.generate.fill value(-123.0) : tensor<7x3xf32>
    %scale = check.generate.iota offset(0.5) step(0.125) : tensor<7xbf16>
    %bias = check.generate.iota offset(-0.25) step(0.0625) : tensor<7xbf16>
    check.compare<@test_normalization_affine, @expected_normalization_affine>(%input, %output, %scale, %bias) : (tensor<7x3xf32>, tensor<7x3xf32>, tensor<7xbf16>, tensor<7xbf16>) -> () {
      check.expect.close actual(%output) expected(%output) atol(9.9999999999999995e-07) rtol(9.9999999999999995e-07) nan(different) : tensor<7x3xf32>
    }
  }
  check.return
}

func.def @expected_normalization_variance(%input: buffer, %output: buffer, %scale: buffer, %bias: buffer) {
  %variance_only = scalar.constant true : i1
  %affine = scalar.constant false : i1
  func.call @normalization_expected(%variance_only, %affine, %output) : (i1, i1, buffer)
  func.return
}

check.scenario public @normalization_variance {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(1.0) step(0.25) : tensor<7x3xf32>
    %output = check.generate.fill value(-123.0) : tensor<7x3xf32>
    %scale = check.generate.iota offset(0.5) step(0.125) : tensor<7xbf16>
    %bias = check.generate.iota offset(-0.25) step(0.0625) : tensor<7xbf16>
    check.compare<@test_normalization_variance, @expected_normalization_variance>(%input, %output, %scale, %bias) : (tensor<7x3xf32>, tensor<7x3xf32>, tensor<7xbf16>, tensor<7xbf16>) -> () {
      check.expect.close actual(%output) expected(%output) atol(9.9999999999999995e-07) rtol(9.9999999999999995e-07) nan(different) : tensor<7x3xf32>
    }
  }
  check.return
}

func.def @expected_normalization_plain(%input: buffer, %output: buffer, %scale: buffer, %bias: buffer) {
  %variance_only = scalar.constant false : i1
  %affine = scalar.constant false : i1
  func.call @normalization_expected(%variance_only, %affine, %output) : (i1, i1, buffer)
  func.return
}

check.scenario public @normalization_plain {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(1.0) step(0.25) : tensor<7x3xf32>
    %output = check.generate.fill value(-123.0) : tensor<7x3xf32>
    %scale = check.generate.iota offset(0.5) step(0.125) : tensor<7xbf16>
    %bias = check.generate.iota offset(-0.25) step(0.0625) : tensor<7xbf16>
    check.compare<@test_normalization_plain, @expected_normalization_plain>(%input, %output, %scale, %bias) : (tensor<7x3xf32>, tensor<7x3xf32>, tensor<7xbf16>, tensor<7xbf16>) -> () {
      check.expect.close actual(%output) expected(%output) atol(9.9999999999999995e-07) rtol(9.9999999999999995e-07) nan(different) : tensor<7x3xf32>
    }
  }
  check.return
}
