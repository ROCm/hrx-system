check.case public @changing_membership_flow {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %keys_seed = check.literal value(43) : i64
  %actual_keys = check.generate.random.uniform seed(%keys_seed) range(-0.5 to 0.5) : tensor<4x320x1024xf32>
  %reference_keys = check.generate.random.uniform seed(%keys_seed) range(-0.5 to 0.5) : tensor<4x320x1024xf32>
  %values_seed = check.literal value(44) : i64
  %actual_values = check.generate.random.uniform seed(%values_seed) range(-0.5 to 0.5) : tensor<4x320x1024xf32>
  %reference_values = check.generate.random.uniform seed(%values_seed) range(-0.5 to 0.5) : tensor<4x320x1024xf32>
  %membership = check.generate.fill value(-1) : tensor<5xi32>
  %position = check.generate.fill value(-1) : tensor<4xi32>
  %cosine = check.generate.iota offset(0.0) step(7.62939453125e-06) : tensor<4096x32xf32>
  %sine = check.generate.fill value(0.125) : tensor<4096x32xf32>
  %seed_0 = check.literal value(70) : i64
  %x_0 = check.generate.random.uniform seed(%seed_0) range(-0.5 to 0.5) : tensor<1x3072x1xf32>
  %actual_q_0 = check.generate.fill value(-123.0) : tensor<1x1024x1xf32>
  %reference_q_0 = check.generate.fill value(-123.0) : tensor<1x1024x1xf32>
  %actual_scores_0 = check.generate.fill value(-123.0) : tensor<1x16x320xf32>
  %reference_scores_0 = check.generate.fill value(-123.0) : tensor<1x16x320xf32>
  %actual_probabilities_0 = check.generate.fill value(-123.0) : tensor<1x16x320xf32>
  %reference_probabilities_0 = check.generate.fill value(-123.0) : tensor<1x16x320xf32>
  %actual_y_0 = check.generate.fill value(-123.0) : tensor<1x1024x1xf32>
  %reference_y_0 = check.generate.fill value(-123.0) : tensor<1x1024x1xf32>
  kernel.launch @metadata_flow_0(%membership, %position) : (tensor<5xi32>, tensor<4xi32>)
  kernel.launch @batch.rotary_cache_flow(%membership, %x_0, %actual_q_0, %actual_keys, %actual_values, %position, %cosine, %sine) : (tensor<5xi32>, tensor<1x3072x1xf32>, tensor<1x1024x1xf32>, tensor<4x320x1024xf32>, tensor<4x320x1024xf32>, tensor<4xi32>, tensor<4096x32xf32>, tensor<4096x32xf32>)
  kernel.launch @batch.attention_scores_flow(%membership, %actual_q_0, %actual_keys, %position, %actual_scores_0) : (tensor<5xi32>, tensor<1x1024x1xf32>, tensor<4x320x1024xf32>, tensor<4xi32>, tensor<1x16x320xf32>)
  kernel.launch @batch.softmax_flow(%membership, %actual_scores_0, %actual_probabilities_0) : (tensor<5xi32>, tensor<1x16x320xf32>, tensor<1x16x320xf32>)
