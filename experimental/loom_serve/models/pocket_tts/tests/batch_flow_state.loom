// Reordered active rows use independent packed scratch and resident state.
// Every tensor has a nonzero origin and padding between rows. Comparing the
// complete banks with isolated calls also observes all guards and inactive rows.
amdgpu.target<gfx11-generic> @pocket {subgroup_size = 32}

config.decl @pocket.batch_capacity : %value: index where [range(%value, 1, 65536)]

kernel.def target(@pocket) @batch_metadata() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%count: i32, %first: i32, %second: i32, %third: i32, %fourth: i32, %membership: buffer) {
  %origin = index.constant 0 : offset
  %map = buffer.view %membership[%origin] : buffer -> view<5xi32>
  view.store %count, %map[0] : i32, view<5xi32>
  view.store %first, %map[1] : i32, view<5xi32>
  view.store %second, %map[2] : i32, view<5xi32>
  view.store %third, %map[3] : i32, view<5xi32>
  view.store %fourth, %map[4] : i32, view<5xi32>
  kernel.return
}

template.decl @pocket.batch.previous_latent(%membership: buffer, %elements: index, %previous_storage: buffer, %position_storage: buffer, %bos_storage: buffer, %y_storage: buffer, %previous_offset: offset, %previous_stride: offset, %position_offset: offset, %position_stride: offset, %bos_offset: offset, %bos_stride: offset, %y_offset: offset, %y_stride: offset)

template.decl @pocket.previous_latent.body(%elements: index, %previous_storage: buffer, %position_storage: buffer, %bos_storage: buffer, %y_storage: buffer, %previous_origin: offset, %position_origin: offset, %bos_origin: offset, %y_origin: offset)

kernel.def target(@pocket) @isolated_previous_latent() {
  %groups = index.constant 1 : index
  %one = index.constant 1 : index
  %times = index.constant 1 : index
  %threads = index.constant 128 : index
  %batch = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %times, %batch) workgroup_size(%threads, %one, %one) : index
} launch(%previous_storage: buffer, %position_storage: buffer, %bos_storage: buffer, %y_storage: buffer) {
  %elements = index.constant 32 : index
  %origin = index.constant 0 : offset
  template.apply<@pocket.previous_latent.body>(%elements, %previous_storage, %position_storage, %bos_storage, %y_storage, %origin, %origin, %origin, %origin) : (index, buffer, buffer, buffer, buffer, offset, offset, offset, offset)
  kernel.return
}

kernel.def target(@pocket) @batched_previous_latent() {
  %groups = index.constant 1 : index
  %one = index.constant 1 : index
  %times = index.constant 1 : index
  %threads = index.constant 128 : index
  %batch = config.get @pocket.batch_capacity : index
  kernel.launch.config workgroups(%groups, %times, %batch) workgroup_size(%threads, %one, %one) : index
} launch(%membership: buffer, %previous_storage: buffer, %position_storage: buffer, %bos_storage: buffer, %y_storage: buffer) {
  %elements = index.constant 32 : index
  %origin = index.constant 16 : offset
  %previous_stride = index.constant 156 : offset
  %position_stride = index.constant 32 : offset
  %bos_stride = index.constant 0 : offset
  %y_stride = index.constant 156 : offset
  template.apply<@pocket.batch.previous_latent>(%membership, %elements, %previous_storage, %position_storage, %bos_storage, %y_storage, %origin, %previous_stride, %origin, %position_stride, %origin, %bos_stride, %origin, %y_stride) : (buffer, index, buffer, buffer, buffer, buffer, offset, offset, offset, offset, offset, offset, offset, offset)
  kernel.return
}

kernel.def target(@pocket) @initialize_previous_latent() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%buffer: buffer) {
  %origin = index.constant 0 : offset
  %view = buffer.view %buffer[%origin] : buffer -> view<52xi32>
  %value_0 = scalar.constant 0 : i32
  view.store %value_0, %view[4] : i32, view<52xi32>
  %value_1 = scalar.constant 16 : i32
  view.store %value_1, %view[12] : i32, view<52xi32>
  %value_2 = scalar.constant 32 : i32
  view.store %value_2, %view[20] : i32, view<52xi32>
  %value_3 = scalar.constant 48 : i32
  view.store %value_3, %view[28] : i32, view<52xi32>
  %value_4 = scalar.constant 64 : i32
  view.store %value_4, %view[36] : i32, view<52xi32>
  %value_5 = scalar.constant 80 : i32
  view.store %value_5, %view[44] : i32, view<52xi32>
  kernel.return
}

check.case public @previous_latent_row_ownership {
  %membership = check.generate.fill value(-1) : tensor<5xi32>
  %unused = check.literal value(-1) : i32
  %word_0 = check.literal value(0) : i32
  %word_1 = check.literal value(1) : i32
  %word_2 = check.literal value(2) : i32
  %word_3 = check.literal value(3) : i32
  %word_4 = check.literal value(4) : i32
  %word_5 = check.literal value(5) : i32
  %word_6 = check.literal value(6) : i32
  %previous_seed = check.literal value(100) : i64
  %actual_previous = check.generate.random.uniform seed(%previous_seed) range(-0.5 to 0.5) : tensor<238xf32>
  %reference_previous = check.generate.random.uniform seed(%previous_seed) range(-0.5 to 0.5) : tensor<238xf32>
  %position_seed = check.literal value(101) : i64
  %actual_position = check.generate.fill value(-17) : tensor<52xi32>
  kernel.launch @initialize_previous_latent(%actual_position) : (tensor<52xi32>)
  %reference_position = check.generate.fill value(-17) : tensor<52xi32>
  kernel.launch @initialize_previous_latent(%reference_position) : (tensor<52xi32>)
  %bos_seed = check.literal value(102) : i64
  %actual_bos = check.generate.random.uniform seed(%bos_seed) range(-0.5 to 0.5) : tensor<54xbf16>
  %reference_bos = check.generate.random.uniform seed(%bos_seed) range(-0.5 to 0.5) : tensor<54xbf16>
  %y_seed = check.literal value(103) : i64
  %actual_y = check.generate.random.uniform seed(%y_seed) range(-0.5 to 0.5) : tensor<160xf32>
  %reference_y = check.generate.random.uniform seed(%y_seed) range(-0.5 to 0.5) : tensor<160xf32>
  kernel.launch @batch_metadata(%word_3, %word_5, %word_0, %word_1, %unused, %membership) : (i32, i32, i32, i32, i32, tensor<5xi32>)
  kernel.launch @batched_previous_latent(%membership, %actual_previous, %actual_position, %actual_bos, %actual_y) : (tensor<5xi32>, tensor<238xf32>, tensor<52xi32>, tensor<54xbf16>, tensor<160xf32>)
  %previous_0_0 = check.tensor.view %reference_previous offset(796) : tensor<238xf32> -> tensor<32xf32>
  %position_0_0 = check.tensor.view %reference_position offset(176) : tensor<52xi32> -> tensor<1xi32>
  %bos_0_0 = check.tensor.view %reference_bos offset(16) : tensor<54xbf16> -> tensor<32xbf16>
  %y_0_0 = check.tensor.view %reference_y offset(16) : tensor<160xf32> -> tensor<32xf32>
  kernel.launch @isolated_previous_latent(%previous_0_0, %position_0_0, %bos_0_0, %y_0_0) : (tensor<32xf32>, tensor<1xi32>, tensor<32xbf16>, tensor<32xf32>)
  %previous_0_1 = check.tensor.view %reference_previous offset(16) : tensor<238xf32> -> tensor<32xf32>
  %position_0_1 = check.tensor.view %reference_position offset(16) : tensor<52xi32> -> tensor<1xi32>
  %bos_0_1 = check.tensor.view %reference_bos offset(16) : tensor<54xbf16> -> tensor<32xbf16>
  %y_0_1 = check.tensor.view %reference_y offset(172) : tensor<160xf32> -> tensor<32xf32>
  kernel.launch @isolated_previous_latent(%previous_0_1, %position_0_1, %bos_0_1, %y_0_1) : (tensor<32xf32>, tensor<1xi32>, tensor<32xbf16>, tensor<32xf32>)
  %previous_0_2 = check.tensor.view %reference_previous offset(172) : tensor<238xf32> -> tensor<32xf32>
  %position_0_2 = check.tensor.view %reference_position offset(48) : tensor<52xi32> -> tensor<1xi32>
  %bos_0_2 = check.tensor.view %reference_bos offset(16) : tensor<54xbf16> -> tensor<32xbf16>
  %y_0_2 = check.tensor.view %reference_y offset(328) : tensor<160xf32> -> tensor<32xf32>
  kernel.launch @isolated_previous_latent(%previous_0_2, %position_0_2, %bos_0_2, %y_0_2) : (tensor<32xf32>, tensor<1xi32>, tensor<32xbf16>, tensor<32xf32>)
  check.expect.bitwise actual(%actual_previous) expected(%reference_previous) : tensor<238xf32>
  check.expect.bitwise actual(%actual_position) expected(%reference_position) : tensor<52xi32>
  check.expect.bitwise actual(%actual_bos) expected(%reference_bos) : tensor<54xbf16>
  check.expect.bitwise actual(%actual_y) expected(%reference_y) : tensor<160xf32>
  kernel.launch @batch_metadata(%word_2, %word_1, %word_5, %unused, %unused, %membership) : (i32, i32, i32, i32, i32, tensor<5xi32>)
  kernel.launch @batched_previous_latent(%membership, %actual_previous, %actual_position, %actual_bos, %actual_y) : (tensor<5xi32>, tensor<238xf32>, tensor<52xi32>, tensor<54xbf16>, tensor<160xf32>)
  %previous_1_0 = check.tensor.view %reference_previous offset(172) : tensor<238xf32> -> tensor<32xf32>
  %position_1_0 = check.tensor.view %reference_position offset(48) : tensor<52xi32> -> tensor<1xi32>
  %bos_1_0 = check.tensor.view %reference_bos offset(16) : tensor<54xbf16> -> tensor<32xbf16>
  %y_1_0 = check.tensor.view %reference_y offset(16) : tensor<160xf32> -> tensor<32xf32>
  kernel.launch @isolated_previous_latent(%previous_1_0, %position_1_0, %bos_1_0, %y_1_0) : (tensor<32xf32>, tensor<1xi32>, tensor<32xbf16>, tensor<32xf32>)
  %previous_1_1 = check.tensor.view %reference_previous offset(796) : tensor<238xf32> -> tensor<32xf32>
  %position_1_1 = check.tensor.view %reference_position offset(176) : tensor<52xi32> -> tensor<1xi32>
  %bos_1_1 = check.tensor.view %reference_bos offset(16) : tensor<54xbf16> -> tensor<32xbf16>
  %y_1_1 = check.tensor.view %reference_y offset(172) : tensor<160xf32> -> tensor<32xf32>
  kernel.launch @isolated_previous_latent(%previous_1_1, %position_1_1, %bos_1_1, %y_1_1) : (tensor<32xf32>, tensor<1xi32>, tensor<32xbf16>, tensor<32xf32>)
  check.expect.bitwise actual(%actual_previous) expected(%reference_previous) : tensor<238xf32>
  check.expect.bitwise actual(%actual_position) expected(%reference_position) : tensor<52xi32>
  check.expect.bitwise actual(%actual_bos) expected(%reference_bos) : tensor<54xbf16>
  check.expect.bitwise actual(%actual_y) expected(%reference_y) : tensor<160xf32>
  kernel.launch @batch_metadata(%word_0, %unused, %unused, %unused, %unused, %membership) : (i32, i32, i32, i32, i32, tensor<5xi32>)
  kernel.launch @batched_previous_latent(%membership, %actual_previous, %actual_position, %actual_bos, %actual_y) : (tensor<5xi32>, tensor<238xf32>, tensor<52xi32>, tensor<54xbf16>, tensor<160xf32>)
  check.expect.bitwise actual(%actual_previous) expected(%reference_previous) : tensor<238xf32>
  check.expect.bitwise actual(%actual_position) expected(%reference_position) : tensor<52xi32>
  check.expect.bitwise actual(%actual_bos) expected(%reference_bos) : tensor<54xbf16>
  check.expect.bitwise actual(%actual_y) expected(%reference_y) : tensor<160xf32>
  check.return
}

template.decl @pocket.batch.advance(%membership: buffer, %elements: index, %increment: i32, %position_storage: buffer, %position_offset: offset, %position_stride: offset)

template.decl @pocket.advance.body(%elements: index, %increment: i32, %position_storage: buffer, %position_origin: offset)

kernel.def target(@pocket) @isolated_advance() {
  %groups = index.constant 1 : index
  %one = index.constant 1 : index
  %times = index.constant 1 : index
  %threads = index.constant 128 : index
  %batch = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %times, %batch) workgroup_size(%threads, %one, %one) : index
} launch(%position_storage: buffer) {
  %elements = index.constant 1 : index
  %increment = scalar.constant 16 : i32
  %origin = index.constant 0 : offset
  template.apply<@pocket.advance.body>(%elements, %increment, %position_storage, %origin) : (index, i32, buffer, offset)
  kernel.return
}

kernel.def target(@pocket) @batched_advance() {
  %groups = index.constant 1 : index
  %one = index.constant 1 : index
  %times = index.constant 1 : index
  %threads = index.constant 128 : index
  %batch = config.get @pocket.batch_capacity : index
  kernel.launch.config workgroups(%groups, %times, %batch) workgroup_size(%threads, %one, %one) : index
} launch(%membership: buffer, %position_storage: buffer) {
  %elements = index.constant 1 : index
  %increment = scalar.constant 16 : i32
  %origin = index.constant 16 : offset
  %position_stride = index.constant 32 : offset
  template.apply<@pocket.batch.advance>(%membership, %elements, %increment, %position_storage, %origin, %position_stride) : (buffer, index, i32, buffer, offset, offset)
  kernel.return
}

kernel.def target(@pocket) @initialize_advance() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%buffer: buffer) {
  %origin = index.constant 0 : offset
  %view = buffer.view %buffer[%origin] : buffer -> view<52xi32>
  %value_0 = scalar.constant 0 : i32
