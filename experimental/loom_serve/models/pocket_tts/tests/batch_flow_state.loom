  %elements = index.constant 256 : index
  %origin = index.constant 16 : offset
  %time_stride = index.constant 32 : offset
  %frequencies_stride = index.constant 0 : offset
  %y_stride = index.constant 1052 : offset
  template.apply<@pocket.batch.time_embedding>(%membership, %elements, %time_storage, %frequencies_storage, %y_storage, %origin, %time_stride, %origin, %frequencies_stride, %origin, %y_stride) : (buffer, index, buffer, buffer, buffer, offset, offset, offset, offset, offset, offset)
