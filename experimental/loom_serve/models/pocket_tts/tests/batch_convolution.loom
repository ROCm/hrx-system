// Reordered active rows use independent packed scratch and resident state.
// Every tensor has a nonzero origin and padding between rows. Comparing the
// complete banks with isolated calls also observes all guards and inactive rows.
amdgpu.target<gfx11-generic> @pocket {subgroup_size = 32}

config.decl @pocket.batch_capacity : %value: index where [range(%value, 1, 65536)]

kernel.def target(@pocket) @batch_metadata() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%count: i32, %first: i32, %second: i32, %third: i32, %fourth: i32, %membership: buffer) {
  %origin = index.constant 0 : offset
  %map = buffer.view %membership[%origin] : buffer -> view<5xi32>
  view.store %count, %map[0] : i32, view<5xi32>
  view.store %first, %map[1] : i32, view<5xi32>
  view.store %second, %map[2] : i32, view<5xi32>
  view.store %third, %map[3] : i32, view<5xi32>
  view.store %fourth, %map[4] : i32, view<5xi32>
  kernel.return
}

template.decl @pocket.batch.transpose_convolution(%membership: buffer, %elements: index, %inputs: index, %times: index, %outputs: index, %raw_times: index, %group_outputs: index, %extent: index, %stride: index, %group_inputs: index, %x_storage: buffer, %w_storage: buffer, %y_storage: buffer, %x_offset: offset, %x_stride: offset, %w_offset: offset, %w_stride: offset, %y_offset: offset, %y_stride: offset)

template.decl @pocket.transpose_convolution.body(%elements: index, %inputs: index, %times: index, %outputs: index, %raw_times: index, %group_outputs: index, %extent: index, %stride: index, %group_inputs: index, %x_storage: buffer, %w_storage: buffer, %y_storage: buffer, %x_origin: offset, %w_origin: offset, %y_origin: offset)

kernel.def target(@pocket) @isolated_transpose_convolution() {
  %groups = index.constant 1 : index
  %one = index.constant 1 : index
  %times = index.constant 1 : index
  %threads = index.constant 128 : index
  %batch = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %times, %batch) workgroup_size(%threads, %one, %one) : index
} launch(%x_storage: buffer, %w_storage: buffer, %y_storage: buffer) {
  %elements = index.constant 48 : index
  %inputs = index.constant 4 : index
  %times = index.constant 3 : index
  %outputs = index.constant 6 : index
  %raw_times = index.constant 8 : index
  %group_outputs = index.constant 3 : index
  %extent = index.constant 4 : index
  %stride = index.constant 2 : index
  %group_inputs = index.constant 2 : index
  %origin = index.constant 0 : offset
  template.apply<@pocket.transpose_convolution.body>(%elements, %inputs, %times, %outputs, %raw_times, %group_outputs, %extent, %stride, %group_inputs, %x_storage, %w_storage, %y_storage, %origin, %origin, %origin) : (index, index, index, index, index, index, index, index, index, buffer, buffer, buffer, offset, offset, offset)
  kernel.return
}

kernel.def target(@pocket) @batched_transpose_convolution() {
  %groups = index.constant 1 : index
  %one = index.constant 1 : index
  %times = index.constant 1 : index
  %threads = index.constant 128 : index
  %batch = config.get @pocket.batch_capacity : index
  kernel.launch.config workgroups(%groups, %times, %batch) workgroup_size(%threads, %one, %one) : index
} launch(%membership: buffer, %x_storage: buffer, %w_storage: buffer, %y_storage: buffer) {
  %elements = index.constant 48 : index
  %inputs = index.constant 4 : index
  %times = index.constant 3 : index
  %outputs = index.constant 6 : index
  %raw_times = index.constant 8 : index
  %group_outputs = index.constant 3 : index
  %extent = index.constant 4 : index
  %stride = index.constant 2 : index
  %group_inputs = index.constant 2 : index
  %origin = index.constant 16 : offset
  %x_stride = index.constant 76 : offset
  %w_stride = index.constant 0 : offset
  %y_stride = index.constant 220 : offset
  template.apply<@pocket.batch.transpose_convolution>(%membership, %elements, %inputs, %times, %outputs, %raw_times, %group_outputs, %extent, %stride, %group_inputs, %x_storage, %w_storage, %y_storage, %origin, %x_stride, %origin, %w_stride, %origin, %y_stride) : (buffer, index, index, index, index, index, index, index, index, index, buffer, buffer, buffer, offset, offset, offset, offset, offset, offset)
  kernel.return
}

check.case public @transpose_convolution_row_ownership {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %membership = check.generate.fill value(-1) : tensor<5xi32>
  %unused = check.literal value(-1) : i32
  %word_0 = check.literal value(0) : i32
  %word_1 = check.literal value(1) : i32
  %word_2 = check.literal value(2) : i32
  %word_3 = check.literal value(3) : i32
  %word_4 = check.literal value(4) : i32
  %word_5 = check.literal value(5) : i32
  %word_6 = check.literal value(6) : i32
  %x_seed = check.literal value(100) : i64
  %actual_x = check.generate.random.uniform seed(%x_seed) range(-0.5 to 0.5) : tensor<80xf32>
  %reference_x = check.generate.random.uniform seed(%x_seed) range(-0.5 to 0.5) : tensor<80xf32>
  %w_seed = check.literal value(101) : i64
  %actual_w = check.generate.random.uniform seed(%w_seed) range(-0.5 to 0.5) : tensor<70xbf16>
  %reference_w = check.generate.random.uniform seed(%w_seed) range(-0.5 to 0.5) : tensor<70xbf16>
  %y_seed = check.literal value(102) : i64
  %actual_y = check.generate.random.uniform seed(%y_seed) range(-0.5 to 0.5) : tensor<224xf32>
  %reference_y = check.generate.random.uniform seed(%y_seed) range(-0.5 to 0.5) : tensor<224xf32>
  kernel.launch @batch_metadata(%word_3, %word_5, %word_0, %word_1, %unused, %membership) : (i32, i32, i32, i32, i32, tensor<5xi32>)
  kernel.launch @batched_transpose_convolution(%membership, %actual_x, %actual_w, %actual_y) : (tensor<5xi32>, tensor<80xf32>, tensor<70xbf16>, tensor<224xf32>)
  %x_0_0 = check.tensor.view %reference_x offset(16) : tensor<80xf32> -> tensor<12xf32>
  %w_0_0 = check.tensor.view %reference_w offset(16) : tensor<70xbf16> -> tensor<48xbf16>
  %y_0_0 = check.tensor.view %reference_y offset(16) : tensor<224xf32> -> tensor<48xf32>
  kernel.launch @isolated_transpose_convolution(%x_0_0, %w_0_0, %y_0_0) : (tensor<12xf32>, tensor<48xbf16>, tensor<48xf32>)
  %x_0_1 = check.tensor.view %reference_x offset(92) : tensor<80xf32> -> tensor<12xf32>
  %w_0_1 = check.tensor.view %reference_w offset(16) : tensor<70xbf16> -> tensor<48xbf16>
  %y_0_1 = check.tensor.view %reference_y offset(236) : tensor<224xf32> -> tensor<48xf32>
  kernel.launch @isolated_transpose_convolution(%x_0_1, %w_0_1, %y_0_1) : (tensor<12xf32>, tensor<48xbf16>, tensor<48xf32>)
  %x_0_2 = check.tensor.view %reference_x offset(168) : tensor<80xf32> -> tensor<12xf32>
  %w_0_2 = check.tensor.view %reference_w offset(16) : tensor<70xbf16> -> tensor<48xbf16>
  %y_0_2 = check.tensor.view %reference_y offset(456) : tensor<224xf32> -> tensor<48xf32>
  kernel.launch @isolated_transpose_convolution(%x_0_2, %w_0_2, %y_0_2) : (tensor<12xf32>, tensor<48xbf16>, tensor<48xf32>)
  check.expect.bitwise actual(%actual_x) expected(%reference_x) : tensor<80xf32>
  check.expect.bitwise actual(%actual_w) expected(%reference_w) : tensor<70xbf16>
  check.expect.bitwise actual(%actual_y) expected(%reference_y) : tensor<224xf32>
  kernel.launch @batch_metadata(%word_0, %unused, %unused, %unused, %unused, %membership) : (i32, i32, i32, i32, i32, tensor<5xi32>)
  kernel.launch @batched_transpose_convolution(%membership, %actual_x, %actual_w, %actual_y) : (tensor<5xi32>, tensor<80xf32>, tensor<70xbf16>, tensor<224xf32>)
  check.expect.bitwise actual(%actual_x) expected(%reference_x) : tensor<80xf32>
  check.expect.bitwise actual(%actual_w) expected(%reference_w) : tensor<70xbf16>
  check.expect.bitwise actual(%actual_y) expected(%reference_y) : tensor<224xf32>
  check.return
}

