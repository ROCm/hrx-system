config.decl @pocket.context_capacity : %value: index where [range(%value, 1, 65536)]

config.decl @pocket.rotary_capacity : %value: index where [range(%value, 16, 1048576)]

// Shared FlowLM layer bodies select original checkpoint keys by layer index.
// Each cache origin owns one key/value pair; six layers share the same
// absolute stream position and advance it only after the complete backbone.
kernel.decl @pocket.attention_scores_flow() launch(%q_storage: buffer, %keys_storage: buffer, %position_storage: buffer, %scores_storage: buffer)

kernel.decl @pocket.attention_values_flow() launch(%values_storage: buffer, %probabilities_storage: buffer, %position_storage: buffer, %y_storage: buffer)

kernel.decl @pocket.gated_residual() launch(%x_storage: buffer, %update_storage: buffer, %modulation_storage: buffer, %y_storage: buffer)

kernel.decl @pocket.gelu_4096() launch(%x_storage: buffer, %y_storage: buffer)

kernel.decl @pocket.modulation() launch(%x_storage: buffer, %modulation_storage: buffer, %y_storage: buffer)

kernel.decl @pocket.normalization_affine_1024x1_e1em05() launch(%x_storage: buffer, %y_storage: buffer, %scale_storage: buffer, %bias_storage: buffer)

kernel.decl @pocket.normalization_affine_512x1_e1em06() launch(%x_storage: buffer, %y_storage: buffer, %scale_storage: buffer, %bias_storage: buffer)

kernel.decl @pocket.project_bias_f64(%output_rows: index, %time_steps: index) launch(%inputs: index, %outputs: index, %times: index, %input: buffer, %weight: buffer, %bias: buffer, %output: buffer)

kernel.decl @pocket.project_f64(%output_rows: index, %time_steps: index) launch(%inputs: index, %outputs: index, %times: index, %input: buffer, %weight: buffer, %bias: buffer, %output: buffer)

kernel.decl @pocket.residual_1024x1() launch(%x_storage: buffer, %update_storage: buffer, %y_storage: buffer)

kernel.decl @pocket.rotary_cache_flow() launch(%x_storage: buffer, %q_storage: buffer, %keys_storage: buffer, %values_storage: buffer, %position_storage: buffer, %cosine_storage: buffer, %sine_storage: buffer)

kernel.decl @pocket.silu_512() launch(%x_storage: buffer, %y_storage: buffer)

kernel.decl @pocket.softmax_flow() launch(%scores_storage: buffer, %probabilities_storage: buffer)

template.decl @pocket.flow_layer(%layer: index, %cache_origin: offset, %backbone: buffer, %rotary: buffer, %state: buffer, %input: view<1024x1xf32>) -> (view<1024x1xf32>)

template.decl @pocket.flow_residual(%layer: index, %phase: buffer, %condition: view<512x1xf32>, %input: view<512x1xf32>) -> (view<512x1xf32>)

template.def<@pocket.flow_layer> @pocket_flow_layer(%layer: index, %cache_origin: offset, %backbone: buffer, %rotary: buffer, %state: buffer, %input: view<1024x1xf32>) -> (view<1024x1xf32>) {
  %capacity = config.get @pocket.context_capacity : index
  %rotary_capacity = config.get @pocket.rotary_capacity : index
  %tensor_offset = index.constant 0 : offset
  %tensor = buffer.view %state[%tensor_offset] : buffer -> view<1xi32>
  %normalization_storage_bytes = index.constant 4096 : offset
  %normalization_storage = buffer.alloca<global> align(16) %normalization_storage_bytes : buffer
  %normalization_tensor = buffer.view %normalization_storage[%tensor_offset] : buffer -> view<1024x1xf32>
  %normalization_parameter = command.parameter %backbone, "flow_lm.transformer.layers.{}.norm1.weight"[%layer] : view<1024xbf16>
  %normalization_parameter_2 = command.parameter %backbone, "flow_lm.transformer.layers.{}.norm1.bias"[%layer] : view<1024xbf16>
  kernel.launch @pocket.normalization_affine_1024x1_e1em05(%input, %normalization_tensor, %normalization_parameter, %normalization_parameter_2) : (view<1024x1xf32>, view<1024x1xf32>, view<1024xbf16>, view<1024xbf16>)
  %attention_tensor_offset_relative = index.constant 0 : offset
  %attention_tensor_offset = index.add %cache_origin, %attention_tensor_offset_relative : offset
  %attention_tensor = buffer.view %state[%attention_tensor_offset] : buffer -> view<[%capacity]x1024xf32>
  %key_position_bytes = index.constant 4096 : offset
  %attention_tensor_2_offset_relative = index.scale %capacity, %key_position_bytes : index, offset -> offset
  %attention_tensor_2_offset = index.add %cache_origin, %attention_tensor_2_offset_relative : offset
  %attention_tensor_2 = buffer.view %state[%attention_tensor_2_offset] : buffer -> view<[%capacity]x1024xf32>
  %attention_storage = buffer.alloca<global> align(16) %normalization_storage_bytes : buffer
  %attention_tensor_3 = buffer.view %attention_storage[%tensor_offset] : buffer -> view<1024x1xf32>
  %projection_parameter = command.parameter %backbone, "flow_lm.transformer.layers.{}.self_attn.in_proj.weight"[%layer] : view<3072x1024xbf16>
  %projection_storage_bytes = index.constant 12288 : offset
  %projection_storage = buffer.alloca<global> align(16) %projection_storage_bytes : buffer
  %projection_tensor = buffer.view %projection_storage[%tensor_offset] : buffer -> view<3072x1xf32>
  %projection_inputs = index.constant 1024 : index
  %projection_outputs = index.constant 3072 : index
  %projection_times = index.constant 1 : index
  kernel.launch @pocket.project_f64[%projection_outputs, %projection_times](%projection_inputs, %projection_outputs, %projection_times, %normalization_tensor, %projection_parameter, %projection_parameter, %projection_tensor) : [index, index](index, index, index, view<1024x1xf32>, view<3072x1024xbf16>, view<3072x1024xbf16>, view<3072x1xf32>)
  %attention_parameter = command.parameter %rotary, "rotary.cosine" : view<[%rotary_capacity]x32xf32>
  %attention_parameter_2 = command.parameter %rotary, "rotary.sine" : view<[%rotary_capacity]x32xf32>
  kernel.launch @pocket.rotary_cache_flow(%projection_tensor, %attention_tensor_3, %attention_tensor, %attention_tensor_2, %tensor, %attention_parameter, %attention_parameter_2) : (view<3072x1xf32>, view<1024x1xf32>, view<[%capacity]x1024xf32>, view<[%capacity]x1024xf32>, view<1xi32>, view<[%rotary_capacity]x32xf32>, view<[%rotary_capacity]x32xf32>)
  %score_position_bytes = index.constant 64 : offset
  %attention_storage_2_bytes = index.scale %capacity, %score_position_bytes : index, offset -> offset
  %attention_storage_2 = buffer.alloca<global> align(16) %attention_storage_2_bytes : buffer
  %attention_tensor_4 = buffer.view %attention_storage_2[%tensor_offset] : buffer -> view<16x[%capacity]xf32>
  kernel.launch @pocket.attention_scores_flow(%attention_tensor_3, %attention_tensor, %tensor, %attention_tensor_4) : (view<1024x1xf32>, view<[%capacity]x1024xf32>, view<1xi32>, view<16x[%capacity]xf32>)
  %attention_storage_3 = buffer.alloca<global> align(16) %attention_storage_2_bytes : buffer
  %attention_tensor_5 = buffer.view %attention_storage_3[%tensor_offset] : buffer -> view<16x[%capacity]xf32>
  kernel.launch @pocket.softmax_flow(%attention_tensor_4, %attention_tensor_5) : (view<16x[%capacity]xf32>, view<16x[%capacity]xf32>)
  %attention_storage_4 = buffer.alloca<global> align(16) %normalization_storage_bytes : buffer
  %attention_tensor_6 = buffer.view %attention_storage_4[%tensor_offset] : buffer -> view<1024x1xf32>
  kernel.launch @pocket.attention_values_flow(%attention_tensor_2, %attention_tensor_5, %tensor, %attention_tensor_6) : (view<[%capacity]x1024xf32>, view<16x[%capacity]xf32>, view<1xi32>, view<1024x1xf32>)
  %projection_parameter_2 = command.parameter %backbone, "flow_lm.transformer.layers.{}.self_attn.out_proj.weight"[%layer] : view<1024x1024xbf16>
  %projection_storage_2 = buffer.alloca<global> align(16) %normalization_storage_bytes : buffer
  %projection_tensor_2 = buffer.view %projection_storage_2[%tensor_offset] : buffer -> view<1024x1xf32>
  kernel.launch @pocket.project_f64[%projection_inputs, %projection_times](%projection_inputs, %projection_inputs, %projection_times, %attention_tensor_6, %projection_parameter_2, %projection_parameter_2, %projection_tensor_2) : [index, index](index, index, index, view<1024x1xf32>, view<1024x1024xbf16>, view<1024x1024xbf16>, view<1024x1xf32>)
  %residual_storage = buffer.alloca<global> align(16) %normalization_storage_bytes : buffer
  %residual_tensor = buffer.view %residual_storage[%tensor_offset] : buffer -> view<1024x1xf32>
  kernel.launch @pocket.residual_1024x1(%input, %projection_tensor_2, %residual_tensor) : (view<1024x1xf32>, view<1024x1xf32>, view<1024x1xf32>)
  %normalization_storage_2 = buffer.alloca<global> align(16) %normalization_storage_bytes : buffer
  %normalization_tensor_2 = buffer.view %normalization_storage_2[%tensor_offset] : buffer -> view<1024x1xf32>
  %normalization_parameter_3 = command.parameter %backbone, "flow_lm.transformer.layers.{}.norm2.weight"[%layer] : view<1024xbf16>
  %normalization_parameter_4 = command.parameter %backbone, "flow_lm.transformer.layers.{}.norm2.bias"[%layer] : view<1024xbf16>
  kernel.launch @pocket.normalization_affine_1024x1_e1em05(%residual_tensor, %normalization_tensor_2, %normalization_parameter_3, %normalization_parameter_4) : (view<1024x1xf32>, view<1024x1xf32>, view<1024xbf16>, view<1024xbf16>)
  %projection_parameter_3 = command.parameter %backbone, "flow_lm.transformer.layers.{}.linear1.weight"[%layer] : view<4096x1024xbf16>
  %feed_forward_bytes = index.constant 16384 : offset
  %projection_storage_3 = buffer.alloca<global> align(16) %feed_forward_bytes : buffer
  %projection_tensor_3 = buffer.view %projection_storage_3[%tensor_offset] : buffer -> view<4096x1xf32>
  %projection_outputs_3 = index.constant 4096 : index
  kernel.launch @pocket.project_f64[%projection_outputs_3, %projection_times](%projection_inputs, %projection_outputs_3, %projection_times, %normalization_tensor_2, %projection_parameter_3, %projection_parameter_3, %projection_tensor_3) : [index, index](index, index, index, view<1024x1xf32>, view<4096x1024xbf16>, view<4096x1024xbf16>, view<4096x1xf32>)
  %activation_storage = buffer.alloca<global> align(16) %feed_forward_bytes : buffer
  %activation_tensor = buffer.view %activation_storage[%tensor_offset] : buffer -> view<4096x1xf32>
  kernel.launch @pocket.gelu_4096(%projection_tensor_3, %activation_tensor) : (view<4096x1xf32>, view<4096x1xf32>)
  %projection_parameter_4 = command.parameter %backbone, "flow_lm.transformer.layers.{}.linear2.weight"[%layer] : view<1024x4096xbf16>
  %projection_storage_4 = buffer.alloca<global> align(16) %normalization_storage_bytes : buffer
  %projection_tensor_4 = buffer.view %projection_storage_4[%tensor_offset] : buffer -> view<1024x1xf32>
  kernel.launch @pocket.project_f64[%projection_inputs, %projection_times](%projection_outputs_3, %projection_inputs, %projection_times, %activation_tensor, %projection_parameter_4, %projection_parameter_4, %projection_tensor_4) : [index, index](index, index, index, view<4096x1xf32>, view<1024x4096xbf16>, view<1024x4096xbf16>, view<1024x1xf32>)
  %residual_storage_2 = buffer.alloca<global> align(16) %normalization_storage_bytes : buffer
  %residual_tensor_2 = buffer.view %residual_storage_2[%tensor_offset] : buffer -> view<1024x1xf32>
  kernel.launch @pocket.residual_1024x1(%residual_tensor, %projection_tensor_4, %residual_tensor_2) : (view<1024x1xf32>, view<1024x1xf32>, view<1024x1xf32>)
  template.return %residual_tensor_2 : view<1024x1xf32>
}

template.def<@pocket.flow_residual> @pocket_flow_residual(%layer: index, %phase: buffer, %condition: view<512x1xf32>, %input: view<512x1xf32>) -> (view<512x1xf32>) {
  %projection_parameter = command.parameter %phase, "flow_lm.flow_net.res_blocks.{}.adaLN_modulation.1.weight"[%layer] : view<1536x512xbf16>
  %projection_storage_bytes = index.constant 6144 : offset
  %projection_storage = buffer.alloca<global> align(16) %projection_storage_bytes : buffer
  %projection_tensor_offset = index.constant 0 : offset
  %projection_tensor = buffer.view %projection_storage[%projection_tensor_offset] : buffer -> view<1536x1xf32>
  %projection_parameter_2 = command.parameter %phase, "flow_lm.flow_net.res_blocks.{}.adaLN_modulation.1.bias"[%layer] : view<1536xbf16>
  %projection_inputs = index.constant 512 : index
  %projection_outputs = index.constant 1536 : index
  %projection_times = index.constant 1 : index
  kernel.launch @pocket.project_bias_f64[%projection_outputs, %projection_times](%projection_inputs, %projection_outputs, %projection_times, %condition, %projection_parameter, %projection_parameter_2, %projection_tensor) : [index, index](index, index, index, view<512x1xf32>, view<1536x512xbf16>, view<1536xbf16>, view<1536x1xf32>)
  %normalization_storage_bytes = index.constant 2048 : offset
  %normalization_storage = buffer.alloca<global> align(16) %normalization_storage_bytes : buffer
  %normalization_tensor = buffer.view %normalization_storage[%projection_tensor_offset] : buffer -> view<512x1xf32>
  %normalization_parameter = command.parameter %phase, "flow_lm.flow_net.res_blocks.{}.in_ln.weight"[%layer] : view<512xbf16>
  %normalization_parameter_2 = command.parameter %phase, "flow_lm.flow_net.res_blocks.{}.in_ln.bias"[%layer] : view<512xbf16>
  kernel.launch @pocket.normalization_affine_512x1_e1em06(%input, %normalization_tensor, %normalization_parameter, %normalization_parameter_2) : (view<512x1xf32>, view<512x1xf32>, view<512xbf16>, view<512xbf16>)
  %modulate_storage = buffer.alloca<global> align(16) %normalization_storage_bytes : buffer
  %modulate_tensor = buffer.view %modulate_storage[%projection_tensor_offset] : buffer -> view<512x1xf32>
  kernel.launch @pocket.modulation(%normalization_tensor, %projection_tensor, %modulate_tensor) : (view<512x1xf32>, view<1536x1xf32>, view<512x1xf32>)
  %projection_parameter_3 = command.parameter %phase, "flow_lm.flow_net.res_blocks.{}.mlp.0.weight"[%layer] : view<512x512xbf16>
  %projection_storage_2 = buffer.alloca<global> align(16) %normalization_storage_bytes : buffer
  %projection_tensor_2 = buffer.view %projection_storage_2[%projection_tensor_offset] : buffer -> view<512x1xf32>
  %projection_parameter_4 = command.parameter %phase, "flow_lm.flow_net.res_blocks.{}.mlp.0.bias"[%layer] : view<512xbf16>
  kernel.launch @pocket.project_bias_f64[%projection_inputs, %projection_times](%projection_inputs, %projection_inputs, %projection_times, %modulate_tensor, %projection_parameter_3, %projection_parameter_4, %projection_tensor_2) : [index, index](index, index, index, view<512x1xf32>, view<512x512xbf16>, view<512xbf16>, view<512x1xf32>)
  %activation_storage = buffer.alloca<global> align(16) %normalization_storage_bytes : buffer
  %activation_tensor = buffer.view %activation_storage[%projection_tensor_offset] : buffer -> view<512x1xf32>
  kernel.launch @pocket.silu_512(%projection_tensor_2, %activation_tensor) : (view<512x1xf32>, view<512x1xf32>)
  %projection_parameter_5 = command.parameter %phase, "flow_lm.flow_net.res_blocks.{}.mlp.2.weight"[%layer] : view<512x512xbf16>
  %projection_storage_3 = buffer.alloca<global> align(16) %normalization_storage_bytes : buffer
  %projection_tensor_3 = buffer.view %projection_storage_3[%projection_tensor_offset] : buffer -> view<512x1xf32>
  %projection_parameter_6 = command.parameter %phase, "flow_lm.flow_net.res_blocks.{}.mlp.2.bias"[%layer] : view<512xbf16>
  kernel.launch @pocket.project_bias_f64[%projection_inputs, %projection_times](%projection_inputs, %projection_inputs, %projection_times, %activation_tensor, %projection_parameter_5, %projection_parameter_6, %projection_tensor_3) : [index, index](index, index, index, view<512x1xf32>, view<512x512xbf16>, view<512xbf16>, view<512x1xf32>)
  %gated_residual_storage = buffer.alloca<global> align(16) %normalization_storage_bytes : buffer
  %gated_residual_tensor = buffer.view %gated_residual_storage[%projection_tensor_offset] : buffer -> view<512x1xf32>
  kernel.launch @pocket.gated_residual(%input, %projection_tensor_3, %projection_tensor, %gated_residual_tensor) : (view<512x1xf32>, view<512x1xf32>, view<1536x1xf32>, view<512x1xf32>)
  template.return %gated_residual_tensor : view<512x1xf32>
}
