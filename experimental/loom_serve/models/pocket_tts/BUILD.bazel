load("//loom/build_tools/bazel:defs.bzl", "loom_test")
load("//loom/target/amdgpu:execution_profiles.bzl", "AMDGPU_ACCESS_PROFILE", "AMDGPU_HARDWARE_PROFILE")
load("//loom/target/vm:execution_profiles.bzl", "VM_REFERENCE_PROFILE")

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "sources",
    srcs = glob(["*.loom"]),
    visibility = ["//visibility:public"],
)

loom_test(
    name = "request_test",
    srcs = glob(["*.loom"]) + [
        "tests/request.loom",
        "//experimental/loom_serve/motifs/tensor:sources",
        "//experimental/loom_serve/motifs/text:sources",
    ],
    benchmark_smoke = False,
    configs = {
        "pocket.chunk_tokens": "4",
        "pocket.context_capacity": "1",
        "pocket.rotary_capacity": "16",
        "pocket.threads": "128",
        "pocket.voice_frames": "2",
        "pocket.voice_index": "0",
    },
    execution_profiles = [
        AMDGPU_HARDWARE_PROFILE,
        AMDGPU_ACCESS_PROFILE,
    ],
)

loom_test(
    name = "text_normalization_test",
    srcs = [
        "tests/text_normalization.loom",
        "text_normalization.loom",
        "//experimental/loom_serve/motifs/text:sources",
    ],
    benchmark_smoke = False,
    execution_profiles = [VM_REFERENCE_PROFILE],
)

