load("//loom/build_tools/bazel:defs.bzl", "loom_test")
load("//loom/target/amdgpu:execution_profiles.bzl", "AMDGPU_ACCESS_PROFILE", "AMDGPU_HARDWARE_PROFILE")

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "sources",
    srcs = glob(["*.loom"]),
    visibility = ["//visibility:public"],
)

loom_test(
    name = "request_test",
    srcs = glob(["*.loom"]) + [
        "tests/request.loom",
        "//experimental/loom_serve/motifs/tensor:sources",
    ],
    benchmark_smoke = False,
    configs = {
        "pocket.chunk_tokens": "4",
        "pocket.context_capacity": "1",
        "pocket.rotary_capacity": "16",
        "pocket.threads": "128",
        "pocket.voice_frames": "2",
        "pocket.voice_index": "0",
    },
    execution_profiles = [
        AMDGPU_HARDWARE_PROFILE,
        AMDGPU_ACCESS_PROFILE,
    ],
)

loom_test(
    name = "projection_test",
    srcs = [
        "dispatch.loom",
        "projection.loom",
        "tests/projection.loom",
    ],
    benchmark_smoke = False,
    configs = {"pocket.threads": "128"},
    execution_profiles = [
        AMDGPU_HARDWARE_PROFILE,
        AMDGPU_ACCESS_PROFILE,
    ],
)

loom_test(
    name = "streaming_state_test",
    srcs = [
        "convolution.loom",
        "dispatch.loom",
        "flow_state.loom",
        "tests/streaming_state.loom",
    ],
    benchmark_smoke = False,
    configs = {"pocket.threads": "128"},
    execution_profiles = [
        AMDGPU_HARDWARE_PROFILE,
        AMDGPU_ACCESS_PROFILE,
    ],
)

