// Encoder and decoder share the 250-position causal-window contract. Their
// state and precision are independent: encoder projections accumulate in F64,
// decoder projections in F32. Both use F64 attention reductions.
kernel.decl @pocket.attention_scores_512x16_c265_p249() launch(%q_storage: buffer, %keys_storage: buffer, %position_storage: buffer, %scores_storage: buffer)

kernel.decl @pocket.attention_values_512x16_c265_p249() launch(%values_storage: buffer, %probabilities_storage: buffer, %position_storage: buffer, %y_storage: buffer)

kernel.decl @pocket.gelu_32768() launch(%x_storage: buffer, %y_storage: buffer)

kernel.decl @pocket.normalization_affine_512x16_e1em05() launch(%x_storage: buffer, %y_storage: buffer, %scale_storage: buffer, %bias_storage: buffer)

kernel.decl @pocket.project_f32(%output_rows: index, %time_steps: index) launch(%inputs: index, %outputs: index, %times: index, %input: buffer, %weight: buffer, %bias: buffer, %output: buffer)

kernel.decl @pocket.project_f64(%output_rows: index, %time_steps: index) launch(%inputs: index, %outputs: index, %times: index, %input: buffer, %weight: buffer, %bias: buffer, %output: buffer)

kernel.decl @pocket.residual_scaled_512x16() launch(%x_storage: buffer, %update_storage: buffer, %y_storage: buffer, %scale_storage: buffer)

kernel.decl @pocket.rotary_cache_512x16_c265_p249() launch(%x_storage: buffer, %q_storage: buffer, %keys_storage: buffer, %values_storage: buffer, %position_storage: buffer, %cosine_storage: buffer, %sine_storage: buffer)

kernel.decl @pocket.softmax_128x265() launch(%scores_storage: buffer, %probabilities_storage: buffer)

template.decl @pocket.mimi_decoder_layer(%layer: index, %cache_origin: offset, %phase: buffer, %rotary: buffer, %state: buffer, %input: view<512x16xf32>) -> (view<512x16xf32>)

template.decl @pocket.mimi_encoder_layer(%layer: index, %cache_origin: offset, %phase: buffer, %rotary: buffer, %state: buffer, %input: view<512x16xf32>) -> (view<512x16xf32>)

template.def<@pocket.mimi_encoder_layer> @pocket_mimi_encoder_layer(%layer: index, %cache_origin: offset, %phase: buffer, %rotary: buffer, %state: buffer, %input: view<512x16xf32>) -> (view<512x16xf32>) {
  %tensor_offset = index.constant 8 : offset
  %tensor = buffer.view %state[%tensor_offset] : buffer -> view<1xi32>
  %normalization_storage_bytes = index.constant 32768 : offset
  %normalization_storage = buffer.alloca<global> align(16) %normalization_storage_bytes : buffer
  %normalization_tensor_offset = index.constant 0 : offset
  %normalization_tensor = buffer.view %normalization_storage[%normalization_tensor_offset] : buffer -> view<512x16xf32>
  %normalization_parameter = command.parameter %phase, "mimi.encoder_transformer.transformer.layers.{}.norm1.weight"[%layer] : view<512xbf16>
  %normalization_parameter_2 = command.parameter %phase, "mimi.encoder_transformer.transformer.layers.{}.norm1.bias"[%layer] : view<512xbf16>
  kernel.launch @pocket.normalization_affine_512x16_e1em05(%input, %normalization_tensor, %normalization_parameter, %normalization_parameter_2) : (view<512x16xf32>, view<512x16xf32>, view<512xbf16>, view<512xbf16>)
  %attention_tensor_offset_relative = index.constant 0 : offset
  %attention_tensor_offset = index.add %cache_origin, %attention_tensor_offset_relative : offset
  %attention_tensor = buffer.view %state[%attention_tensor_offset] : buffer -> view<265x512xf32>
  %attention_tensor_2_offset_relative = index.constant 542720 : offset
  %attention_tensor_2_offset = index.add %cache_origin, %attention_tensor_2_offset_relative : offset
  %attention_tensor_2 = buffer.view %state[%attention_tensor_2_offset] : buffer -> view<265x512xf32>
  %attention_storage = buffer.alloca<global> align(16) %normalization_storage_bytes : buffer
  %attention_tensor_3 = buffer.view %attention_storage[%normalization_tensor_offset] : buffer -> view<512x16xf32>
  %projection_parameter = command.parameter %phase, "mimi.encoder_transformer.transformer.layers.{}.self_attn.in_proj.weight"[%layer] : view<1536x512xbf16>
  %projection_storage_bytes = index.constant 98304 : offset
  %projection_storage = buffer.alloca<global> align(16) %projection_storage_bytes : buffer
  %projection_tensor = buffer.view %projection_storage[%normalization_tensor_offset] : buffer -> view<1536x16xf32>
  %projection_inputs = index.constant 512 : index
  %projection_outputs = index.constant 1536 : index
  %projection_times = index.constant 16 : index
  kernel.launch @pocket.project_f64[%projection_outputs, %projection_times](%projection_inputs, %projection_outputs, %projection_times, %normalization_tensor, %projection_parameter, %projection_parameter, %projection_tensor) : [index, index](index, index, index, view<512x16xf32>, view<1536x512xbf16>, view<1536x512xbf16>, view<1536x16xf32>)
  %attention_parameter = command.parameter %rotary, "rotary.cosine" : view<2048x32xf32>
  %attention_parameter_2 = command.parameter %rotary, "rotary.sine" : view<2048x32xf32>
  kernel.launch @pocket.rotary_cache_512x16_c265_p249(%projection_tensor, %attention_tensor_3, %attention_tensor, %attention_tensor_2, %tensor, %attention_parameter, %attention_parameter_2) : (view<1536x16xf32>, view<512x16xf32>, view<265x512xf32>, view<265x512xf32>, view<1xi32>, view<2048x32xf32>, view<2048x32xf32>)
  %attention_storage_2_bytes = index.constant 135680 : offset
  %attention_storage_2 = buffer.alloca<global> align(16) %attention_storage_2_bytes : buffer
  %attention_tensor_4 = buffer.view %attention_storage_2[%normalization_tensor_offset] : buffer -> view<128x265xf32>
  kernel.launch @pocket.attention_scores_512x16_c265_p249(%attention_tensor_3, %attention_tensor, %tensor, %attention_tensor_4) : (view<512x16xf32>, view<265x512xf32>, view<1xi32>, view<128x265xf32>)
  %attention_storage_3 = buffer.alloca<global> align(16) %attention_storage_2_bytes : buffer
  %attention_tensor_5 = buffer.view %attention_storage_3[%normalization_tensor_offset] : buffer -> view<128x265xf32>
  kernel.launch @pocket.softmax_128x265(%attention_tensor_4, %attention_tensor_5) : (view<128x265xf32>, view<128x265xf32>)
  %attention_storage_4 = buffer.alloca<global> align(16) %normalization_storage_bytes : buffer
  %attention_tensor_6 = buffer.view %attention_storage_4[%normalization_tensor_offset] : buffer -> view<512x16xf32>
  kernel.launch @pocket.attention_values_512x16_c265_p249(%attention_tensor_2, %attention_tensor_5, %tensor, %attention_tensor_6) : (view<265x512xf32>, view<128x265xf32>, view<1xi32>, view<512x16xf32>)
  %projection_parameter_2 = command.parameter %phase, "mimi.encoder_transformer.transformer.layers.{}.self_attn.out_proj.weight"[%layer] : view<512x512xbf16>
  %projection_storage_2 = buffer.alloca<global> align(16) %normalization_storage_bytes : buffer
  %projection_tensor_2 = buffer.view %projection_storage_2[%normalization_tensor_offset] : buffer -> view<512x16xf32>
  kernel.launch @pocket.project_f64[%projection_inputs, %projection_times](%projection_inputs, %projection_inputs, %projection_times, %attention_tensor_6, %projection_parameter_2, %projection_parameter_2, %projection_tensor_2) : [index, index](index, index, index, view<512x16xf32>, view<512x512xbf16>, view<512x512xbf16>, view<512x16xf32>)
  %residual_storage = buffer.alloca<global> align(16) %normalization_storage_bytes : buffer
  %residual_tensor = buffer.view %residual_storage[%normalization_tensor_offset] : buffer -> view<512x16xf32>
  %residual_parameter = command.parameter %phase, "mimi.encoder_transformer.transformer.layers.{}.layer_scale_1.scale"[%layer] : view<512xbf16>
  kernel.launch @pocket.residual_scaled_512x16(%input, %projection_tensor_2, %residual_tensor, %residual_parameter) : (view<512x16xf32>, view<512x16xf32>, view<512x16xf32>, view<512xbf16>)
  %normalization_storage_2 = buffer.alloca<global> align(16) %normalization_storage_bytes : buffer
  %normalization_tensor_2 = buffer.view %normalization_storage_2[%normalization_tensor_offset] : buffer -> view<512x16xf32>
  %normalization_parameter_3 = command.parameter %phase, "mimi.encoder_transformer.transformer.layers.{}.norm2.weight"[%layer] : view<512xbf16>
  %normalization_parameter_4 = command.parameter %phase, "mimi.encoder_transformer.transformer.layers.{}.norm2.bias"[%layer] : view<512xbf16>
  kernel.launch @pocket.normalization_affine_512x16_e1em05(%residual_tensor, %normalization_tensor_2, %normalization_parameter_3, %normalization_parameter_4) : (view<512x16xf32>, view<512x16xf32>, view<512xbf16>, view<512xbf16>)
  %projection_parameter_3 = command.parameter %phase, "mimi.encoder_transformer.transformer.layers.{}.linear1.weight"[%layer] : view<2048x512xbf16>
  %projection_storage_3_bytes = index.constant 131072 : offset
  %projection_storage_3 = buffer.alloca<global> align(16) %projection_storage_3_bytes : buffer
  %projection_tensor_3 = buffer.view %projection_storage_3[%normalization_tensor_offset] : buffer -> view<2048x16xf32>
  %projection_outputs_3 = index.constant 2048 : index
  kernel.launch @pocket.project_f64[%projection_outputs_3, %projection_times](%projection_inputs, %projection_outputs_3, %projection_times, %normalization_tensor_2, %projection_parameter_3, %projection_parameter_3, %projection_tensor_3) : [index, index](index, index, index, view<512x16xf32>, view<2048x512xbf16>, view<2048x512xbf16>, view<2048x16xf32>)
  %activation_storage = buffer.alloca<global> align(16) %projection_storage_3_bytes : buffer
  %activation_tensor = buffer.view %activation_storage[%normalization_tensor_offset] : buffer -> view<2048x16xf32>
  kernel.launch @pocket.gelu_32768(%projection_tensor_3, %activation_tensor) : (view<2048x16xf32>, view<2048x16xf32>)
  %projection_parameter_4 = command.parameter %phase, "mimi.encoder_transformer.transformer.layers.{}.linear2.weight"[%layer] : view<512x2048xbf16>
  %projection_storage_4 = buffer.alloca<global> align(16) %normalization_storage_bytes : buffer
  %projection_tensor_4 = buffer.view %projection_storage_4[%normalization_tensor_offset] : buffer -> view<512x16xf32>
  kernel.launch @pocket.project_f64[%projection_inputs, %projection_times](%projection_outputs_3, %projection_inputs, %projection_times, %activation_tensor, %projection_parameter_4, %projection_parameter_4, %projection_tensor_4) : [index, index](index, index, index, view<2048x16xf32>, view<512x2048xbf16>, view<512x2048xbf16>, view<512x16xf32>)
  %residual_storage_2 = buffer.alloca<global> align(16) %normalization_storage_bytes : buffer
  %residual_tensor_2 = buffer.view %residual_storage_2[%normalization_tensor_offset] : buffer -> view<512x16xf32>
  %residual_parameter_2 = command.parameter %phase, "mimi.encoder_transformer.transformer.layers.{}.layer_scale_2.scale"[%layer] : view<512xbf16>
  kernel.launch @pocket.residual_scaled_512x16(%residual_tensor, %projection_tensor_4, %residual_tensor_2, %residual_parameter_2) : (view<512x16xf32>, view<512x16xf32>, view<512x16xf32>, view<512xbf16>)
  template.return %residual_tensor_2 : view<512x16xf32>
}

template.def<@pocket.mimi_decoder_layer> @pocket_mimi_decoder_layer(%layer: index, %cache_origin: offset, %phase: buffer, %rotary: buffer, %state: buffer, %input: view<512x16xf32>) -> (view<512x16xf32>) {
  %tensor_offset = index.constant 4 : offset
  %tensor = buffer.view %state[%tensor_offset] : buffer -> view<1xi32>
  %normalization_storage_bytes = index.constant 32768 : offset
  %normalization_storage = buffer.alloca<global> align(16) %normalization_storage_bytes : buffer
  %normalization_tensor_offset = index.constant 0 : offset
  %normalization_tensor = buffer.view %normalization_storage[%normalization_tensor_offset] : buffer -> view<512x16xf32>
  %normalization_parameter = command.parameter %phase, "mimi.decoder_transformer.transformer.layers.{}.norm1.weight"[%layer] : view<512xbf16>
  %normalization_parameter_2 = command.parameter %phase, "mimi.decoder_transformer.transformer.layers.{}.norm1.bias"[%layer] : view<512xbf16>
  kernel.launch @pocket.normalization_affine_512x16_e1em05(%input, %normalization_tensor, %normalization_parameter, %normalization_parameter_2) : (view<512x16xf32>, view<512x16xf32>, view<512xbf16>, view<512xbf16>)
  %attention_tensor_offset_relative = index.constant 0 : offset
  %attention_tensor_offset = index.add %cache_origin, %attention_tensor_offset_relative : offset
  %attention_tensor = buffer.view %state[%attention_tensor_offset] : buffer -> view<265x512xf32>
  %attention_tensor_2_offset_relative = index.constant 542720 : offset
  %attention_tensor_2_offset = index.add %cache_origin, %attention_tensor_2_offset_relative : offset
  %attention_tensor_2 = buffer.view %state[%attention_tensor_2_offset] : buffer -> view<265x512xf32>
  %attention_storage = buffer.alloca<global> align(16) %normalization_storage_bytes : buffer
  %attention_tensor_3 = buffer.view %attention_storage[%normalization_tensor_offset] : buffer -> view<512x16xf32>
  %projection_parameter = command.parameter %phase, "mimi.decoder_transformer.transformer.layers.{}.self_attn.in_proj.weight"[%layer] : view<1536x512xbf16>
  %projection_storage_bytes = index.constant 98304 : offset
  %projection_storage = buffer.alloca<global> align(16) %projection_storage_bytes : buffer
  %projection_tensor = buffer.view %projection_storage[%normalization_tensor_offset] : buffer -> view<1536x16xf32>
  %projection_inputs = index.constant 512 : index
  %projection_outputs = index.constant 1536 : index
  %projection_times = index.constant 16 : index
  kernel.launch @pocket.project_f32[%projection_outputs, %projection_times](%projection_inputs, %projection_outputs, %projection_times, %normalization_tensor, %projection_parameter, %projection_parameter, %projection_tensor) : [index, index](index, index, index, view<512x16xf32>, view<1536x512xbf16>, view<1536x512xbf16>, view<1536x16xf32>)
  %attention_parameter = command.parameter %rotary, "rotary.cosine" : view<2048x32xf32>
  %attention_parameter_2 = command.parameter %rotary, "rotary.sine" : view<2048x32xf32>
  kernel.launch @pocket.rotary_cache_512x16_c265_p249(%projection_tensor, %attention_tensor_3, %attention_tensor, %attention_tensor_2, %tensor, %attention_parameter, %attention_parameter_2) : (view<1536x16xf32>, view<512x16xf32>, view<265x512xf32>, view<265x512xf32>, view<1xi32>, view<2048x32xf32>, view<2048x32xf32>)
  %attention_storage_2_bytes = index.constant 135680 : offset
  %attention_storage_2 = buffer.alloca<global> align(16) %attention_storage_2_bytes : buffer
  %attention_tensor_4 = buffer.view %attention_storage_2[%normalization_tensor_offset] : buffer -> view<128x265xf32>
  kernel.launch @pocket.attention_scores_512x16_c265_p249(%attention_tensor_3, %attention_tensor, %tensor, %attention_tensor_4) : (view<512x16xf32>, view<265x512xf32>, view<1xi32>, view<128x265xf32>)
  %attention_storage_3 = buffer.alloca<global> align(16) %attention_storage_2_bytes : buffer
  %attention_tensor_5 = buffer.view %attention_storage_3[%normalization_tensor_offset] : buffer -> view<128x265xf32>
  kernel.launch @pocket.softmax_128x265(%attention_tensor_4, %attention_tensor_5) : (view<128x265xf32>, view<128x265xf32>)
  %attention_storage_4 = buffer.alloca<global> align(16) %normalization_storage_bytes : buffer
  %attention_tensor_6 = buffer.view %attention_storage_4[%normalization_tensor_offset] : buffer -> view<512x16xf32>
  kernel.launch @pocket.attention_values_512x16_c265_p249(%attention_tensor_2, %attention_tensor_5, %tensor, %attention_tensor_6) : (view<265x512xf32>, view<128x265xf32>, view<1xi32>, view<512x16xf32>)
  %projection_parameter_2 = command.parameter %phase, "mimi.decoder_transformer.transformer.layers.{}.self_attn.out_proj.weight"[%layer] : view<512x512xbf16>
  %projection_storage_2 = buffer.alloca<global> align(16) %normalization_storage_bytes : buffer
  %projection_tensor_2 = buffer.view %projection_storage_2[%normalization_tensor_offset] : buffer -> view<512x16xf32>
  kernel.launch @pocket.project_f32[%projection_inputs, %projection_times](%projection_inputs, %projection_inputs, %projection_times, %attention_tensor_6, %projection_parameter_2, %projection_parameter_2, %projection_tensor_2) : [index, index](index, index, index, view<512x16xf32>, view<512x512xbf16>, view<512x512xbf16>, view<512x16xf32>)
  %residual_storage = buffer.alloca<global> align(16) %normalization_storage_bytes : buffer
  %residual_tensor = buffer.view %residual_storage[%normalization_tensor_offset] : buffer -> view<512x16xf32>
  %residual_parameter = command.parameter %phase, "mimi.decoder_transformer.transformer.layers.{}.layer_scale_1.scale"[%layer] : view<512xbf16>
  kernel.launch @pocket.residual_scaled_512x16(%input, %projection_tensor_2, %residual_tensor, %residual_parameter) : (view<512x16xf32>, view<512x16xf32>, view<512x16xf32>, view<512xbf16>)
  %normalization_storage_2 = buffer.alloca<global> align(16) %normalization_storage_bytes : buffer
  %normalization_tensor_2 = buffer.view %normalization_storage_2[%normalization_tensor_offset] : buffer -> view<512x16xf32>
  %normalization_parameter_3 = command.parameter %phase, "mimi.decoder_transformer.transformer.layers.{}.norm2.weight"[%layer] : view<512xbf16>
  %normalization_parameter_4 = command.parameter %phase, "mimi.decoder_transformer.transformer.layers.{}.norm2.bias"[%layer] : view<512xbf16>
  kernel.launch @pocket.normalization_affine_512x16_e1em05(%residual_tensor, %normalization_tensor_2, %normalization_parameter_3, %normalization_parameter_4) : (view<512x16xf32>, view<512x16xf32>, view<512xbf16>, view<512xbf16>)
  %projection_parameter_3 = command.parameter %phase, "mimi.decoder_transformer.transformer.layers.{}.linear1.weight"[%layer] : view<2048x512xbf16>
  %projection_storage_3_bytes = index.constant 131072 : offset
  %projection_storage_3 = buffer.alloca<global> align(16) %projection_storage_3_bytes : buffer
  %projection_tensor_3 = buffer.view %projection_storage_3[%normalization_tensor_offset] : buffer -> view<2048x16xf32>
  %projection_outputs_3 = index.constant 2048 : index
  kernel.launch @pocket.project_f32[%projection_outputs_3, %projection_times](%projection_inputs, %projection_outputs_3, %projection_times, %normalization_tensor_2, %projection_parameter_3, %projection_parameter_3, %projection_tensor_3) : [index, index](index, index, index, view<512x16xf32>, view<2048x512xbf16>, view<2048x512xbf16>, view<2048x16xf32>)
  %activation_storage = buffer.alloca<global> align(16) %projection_storage_3_bytes : buffer
  %activation_tensor = buffer.view %activation_storage[%normalization_tensor_offset] : buffer -> view<2048x16xf32>
  kernel.launch @pocket.gelu_32768(%projection_tensor_3, %activation_tensor) : (view<2048x16xf32>, view<2048x16xf32>)
  %projection_parameter_4 = command.parameter %phase, "mimi.decoder_transformer.transformer.layers.{}.linear2.weight"[%layer] : view<512x2048xbf16>
  %projection_storage_4 = buffer.alloca<global> align(16) %normalization_storage_bytes : buffer
  %projection_tensor_4 = buffer.view %projection_storage_4[%normalization_tensor_offset] : buffer -> view<512x16xf32>
  kernel.launch @pocket.project_f32[%projection_inputs, %projection_times](%projection_outputs_3, %projection_inputs, %projection_times, %activation_tensor, %projection_parameter_4, %projection_parameter_4, %projection_tensor_4) : [index, index](index, index, index, view<2048x16xf32>, view<512x2048xbf16>, view<512x2048xbf16>, view<512x16xf32>)
  %residual_storage_2 = buffer.alloca<global> align(16) %normalization_storage_bytes : buffer
  %residual_tensor_2 = buffer.view %residual_storage_2[%normalization_tensor_offset] : buffer -> view<512x16xf32>
  %residual_parameter_2 = command.parameter %phase, "mimi.decoder_transformer.transformer.layers.{}.layer_scale_2.scale"[%layer] : view<512xbf16>
  kernel.launch @pocket.residual_scaled_512x16(%residual_tensor, %projection_tensor_4, %residual_tensor_2, %residual_parameter_2) : (view<512x16xf32>, view<512x16xf32>, view<512x16xf32>, view<512xbf16>)
  template.return %residual_tensor_2 : view<512x16xf32>
}
