template.decl @vad.matrix(%rows: index, %columns: index, %reduction: index, %input: buffer, %weights: view<[%rows]x[%reduction]xf32>, %output: buffer, %input_origin: offset, %output_origin: offset)

// Production shapes are fixed at compilation. BUILD variants enumerate the
// unique panel geometries across both rates without duplicating this oracle.
config.def @matrix.rows = 132 : index

config.def @matrix.columns = 32 : index

config.def @matrix.reduction = 128 : index

kernel.def @matrix() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%input: buffer, %weights: buffer, %output: buffer) {
  %rows = config.get @matrix.rows : index
  %columns = config.get @matrix.columns : index
  %reduction = config.get @matrix.reduction : index
  %origin = index.constant 0 : offset
  %weight_view = buffer.view %weights[%origin] : buffer -> view<[%rows]x[%reduction]xf32>
  template.apply<@vad.matrix>(%rows, %columns, %reduction, %input, %weight_view, %output, %origin, %origin) : (index, index, index, buffer, view<[%rows]x[%reduction]xf32>, buffer, offset, offset)
  kernel.return
}

// Independent scalar dots have no paneling, accumulator lanes, or padded
// execution dimensions. Dyadic inputs keep every sum exact in F32 as well.
func.def @matrix_reference(%input: buffer, %weights: buffer, %output: buffer) {
  %rows = config.get @matrix.rows : index
  %columns = config.get @matrix.columns : index
  %reduction = config.get @matrix.reduction : index
  %origin = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %values = buffer.view %input[%origin] : buffer -> view<[%reduction]x[%columns]xf32>
  %matrix = buffer.view %weights[%origin] : buffer -> view<[%rows]x[%reduction]xf32>
  %results = buffer.view %output[%origin] : buffer -> view<[%rows]x[%columns]xf32>
  %initial = scalar.constant 0.0 : f64
  scf.for %row = [%zero to %rows step %one] {
    scf.for %column = [%zero to %columns step %one] {
      %sum = scf.for %k = [%zero to %reduction step %one](%sum = %initial : f64) -> (f64) {
        %value = view.load %values[%k, %column] : view<[%reduction]x[%columns]xf32> -> f32
        %weight = view.load %matrix[%row, %k] : view<[%rows]x[%reduction]xf32> -> f32
        %value64 = scalar.extf %value : f32 to f64
        %weight64 = scalar.extf %weight : f32 to f64
        %next = scalar.fmaf %value64, %weight64, %sum : f64
        scf.yield %next : f64
      }
      %result = scalar.fptrunc %sum : f64 to f32
      view.store %result, %results[%row, %column] : f32, view<[%rows]x[%columns]xf32>
    }
  }
  func.return
}

check.scenario @both_rate_matrix_families {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-1.0) step(0.03125) period(71) : tensor<12384xf32>
    %weights = check.generate.iota offset(-0.5) step(0.015625) period(67) : tensor<199692xf32>
    %output = check.generate.fill value(-123.0) : tensor<16512xf32>
    check.compare<@matrix, @matrix_reference>(%input, %weights, %output) : (tensor<12384xf32>, tensor<199692xf32>, tensor<16512xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<16512xf32>
    }
  }
  check.return
}
