kernel.decl @silero_hop_8000() launch(%work: buffer, %bank_buffer: buffer, %output: buffer, %window_buffer: buffer, %previous_buffer: buffer, %next_buffer: buffer, %scratch: buffer, %stft_weights: view<132x128xf32>, %encoder0_weights: view<132x195xf32>, %encoder1_weights: view<72x384xf32>, %encoder2_weights: view<72x192xf32>, %encoder3_weights: view<132x192xf32>, %input_gates_weights: view<516x128xf32>, %recurrent_gates_weights: view<516x128xf32>, %encoder0_bias: view<128xf32>, %encoder1_bias: view<64xf32>, %encoder2_bias: view<64xf32>, %encoder3_bias: view<128xf32>, %gate_bias: view<512xf32>, %head_weight: view<128xf32>, %head_bias: view<1xf32>)

func.decl @state_fixture(%trial: index, %work: buffer, %bank: buffer, %expected_bank: buffer, %expected_windows: buffer, %expected_previous: buffer)

func.decl @copy_fixture(%source: buffer, %target: buffer)

// The fixture supplies independent expected tensors before either execution.
// This reference preserves them; it does not run the numerical subject.
func.def @state_reference(%work: buffer, %bank_buffer: buffer, %output: buffer, %window_buffer: buffer, %previous_buffer: buffer, %next_buffer: buffer, %scratch: buffer, %stft_weights: buffer, %encoder0_weights: buffer, %encoder1_weights: buffer, %encoder2_weights: buffer, %encoder3_weights: buffer, %input_gates_weights: buffer, %recurrent_gates_weights: buffer, %encoder0_bias: buffer, %encoder1_bias: buffer, %encoder2_bias: buffer, %encoder3_bias: buffer, %gate_bias: buffer, %head_weight: buffer, %head_bias: buffer) {
  func.return
}

check.scenario public @resident_history_and_padding {
  check.trial[8](%trial: index, %entropy: check.entropy) {
    %work = check.generate.fill value(0) : tensor<4164xi32>
    %bank = check.generate.iota offset(-0.5) step(0.001953125) : tensor<2560xf32>
    %expected_bank = check.generate.iota offset(-0.5) step(0.001953125) : tensor<2560xf32>
    %windows = check.generate.fill value(-123.0) : tensor<4612xf32>
    %expected_windows = check.generate.fill value(-123.0) : tensor<4612xf32>
    %previous = check.generate.fill value(-123.0) : tensor<4100xf32>
    %expected_previous = check.generate.fill value(-123.0) : tensor<4100xf32>
    %next = check.generate.fill value(-123.0) : tensor<2052xf32>
    %scratch = check.generate.fill value(-123.0) : tensor<44800xf32>
    %output = check.generate.fill value(-123.0) : tensor<10xf32>
    %window_prefix = check.tensor.view %expected_windows offset(0) : tensor<4612xf32> -> tensor<2304xf32>
    %window_zeros = check.generate.fill value(0.0) : tensor<2304xf32>
    check.generate<@copy_fixture>(%window_zeros, %window_prefix) : (tensor<2304xf32>, tensor<2304xf32>) -> ()
    %previous_prefix = check.tensor.view %expected_previous offset(0) : tensor<4100xf32> -> tensor<4096xf32>
    %previous_zeros = check.generate.fill value(0.0) : tensor<4096xf32>
    check.generate<@copy_fixture>(%previous_zeros, %previous_prefix) : (tensor<4096xf32>, tensor<4096xf32>) -> ()
    check.generate<@state_fixture>(%trial, %work, %bank, %expected_bank, %expected_windows, %expected_previous) : (index, tensor<4164xi32>, tensor<2560xf32>, tensor<2560xf32>, tensor<4612xf32>, tensor<4100xf32>) -> ()
    %stft_weights = check.generate.fill value(0.0) : view<132x128xf32>
    %encoder0_weights = check.generate.fill value(0.0) : view<132x195xf32>
    %encoder1_weights = check.generate.fill value(0.0) : view<72x384xf32>
    %encoder2_weights = check.generate.fill value(0.0) : view<72x192xf32>
    %encoder3_weights = check.generate.fill value(0.0) : view<132x192xf32>
    %input_gates_weights = check.generate.fill value(0.0) : view<516x128xf32>
    %recurrent_gates_weights = check.generate.fill value(0.0) : view<516x128xf32>
    %encoder0_bias = check.generate.fill value(0.0) : view<128xf32>
    %encoder1_bias = check.generate.fill value(0.0) : view<64xf32>
    %encoder2_bias = check.generate.fill value(0.0) : view<64xf32>
    %encoder3_bias = check.generate.fill value(0.0) : view<128xf32>
    %gate_bias = check.generate.fill value(0.0) : view<512xf32>
    %head_weight = check.generate.fill value(0.0) : view<128xf32>
    %head_bias = check.generate.fill value(0.0) : view<1xf32>
    %probabilities = check.tensor.view %output offset(0) : tensor<10xf32> -> tensor<8xf32>
    %half = check.generate.fill value(0.5) : tensor<8xf32>
    %output_guard = check.tensor.view %output offset(32) : tensor<10xf32> -> tensor<2xf32>
    %next_guard = check.tensor.view %next offset(8192) : tensor<2052xf32> -> tensor<4xf32>
    %guard2 = check.generate.fill value(-123.0) : tensor<2xf32>
    %guard4 = check.generate.fill value(-123.0) : tensor<4xf32>
    check.compare<@silero_hop_8000, @state_reference>(%work, %bank, %output, %windows, %previous, %next, %scratch, %stft_weights, %encoder0_weights, %encoder1_weights, %encoder2_weights, %encoder3_weights, %input_gates_weights, %recurrent_gates_weights, %encoder0_bias, %encoder1_bias, %encoder2_bias, %encoder3_bias, %gate_bias, %head_weight, %head_bias) : (tensor<4164xi32>, tensor<2560xf32>, tensor<10xf32>, tensor<4612xf32>, tensor<4100xf32>, tensor<2052xf32>, tensor<44800xf32>, view<132x128xf32>, view<132x195xf32>, view<72x384xf32>, view<72x192xf32>, view<132x192xf32>, view<516x128xf32>, view<516x128xf32>, view<128xf32>, view<64xf32>, view<64xf32>, view<128xf32>, view<512xf32>, view<128xf32>, view<1xf32>) -> () {
      check.expect.close actual(%bank) expected(%expected_bank) atol(9.9999999999999995e-07) rtol(9.9999999999999995e-07) nan(different) : tensor<2560xf32>
      check.expect.bitwise actual(%windows) expected(%expected_windows) : tensor<4612xf32>
      check.expect.bitwise actual(%previous) expected(%expected_previous) : tensor<4100xf32>
      check.expect.bitwise actual(%probabilities) expected(%half) : tensor<8xf32>
      check.expect.bitwise actual(%output_guard) expected(%guard2) : tensor<2xf32>
      check.expect.bitwise actual(%next_guard) expected(%guard4) : tensor<4xf32>
    }
  }
  check.return
}
