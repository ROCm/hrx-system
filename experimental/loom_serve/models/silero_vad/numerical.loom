      %delta6 = index.constant 6 : index
      %row6 = index.add %row, %delta6 : index
      %delta7 = index.constant 7 : index
      %row7 = index.add %row, %delta7 : index
      %delta8 = index.constant 8 : index
      %row8 = index.add %row, %delta8 : index
      %delta9 = index.constant 9 : index
      %row9 = index.add %row, %delta9 : index
      %delta10 = index.constant 10 : index
      %row10 = index.add %row, %delta10 : index
      %delta11 = index.constant 11 : index
      %row11 = index.add %row, %delta11 : index
      %result0, %result1, %result2, %result3, %result4, %result5, %result6, %result7, %result8, %result9, %result10, %result11 = scf.for %k = [%zero to %reduction step %one](%sum0 = %initial : vector<16xf32>, %sum1 = %initial : vector<16xf32>, %sum2 = %initial : vector<16xf32>, %sum3 = %initial : vector<16xf32>, %sum4 = %initial : vector<16xf32>, %sum5 = %initial : vector<16xf32>, %sum6 = %initial : vector<16xf32>, %sum7 = %initial : vector<16xf32>, %sum8 = %initial : vector<16xf32>, %sum9 = %initial : vector<16xf32>, %sum10 = %initial : vector<16xf32>, %sum11 = %initial : vector<16xf32>) -> (vector<16xf32>, vector<16xf32>, vector<16xf32>, vector<16xf32>, vector<16xf32>, vector<16xf32>, vector<16xf32>, vector<16xf32>, vector<16xf32>, vector<16xf32>, vector<16xf32>, vector<16xf32>) {
