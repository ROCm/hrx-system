        %broadcast1 = vector.splat %weight1 : vector<16xf32>
        %next1 = vector.fmaf %value, %broadcast1, %sum1 : vector<16xf32>
        %weight2 = view.load %weights[%row2, %k] : view<[%rows]x[%reduction]xf32> -> f32
        %broadcast2 = vector.splat %weight2 : vector<16xf32>
        %next2 = vector.fmaf %value, %broadcast2, %sum2 : vector<16xf32>
        %weight3 = view.load %weights[%row3, %k] : view<[%rows]x[%reduction]xf32> -> f32
        %broadcast3 = vector.splat %weight3 : vector<16xf32>
        %next3 = vector.fmaf %value, %broadcast3, %sum3 : vector<16xf32>
        %weight4 = view.load %weights[%row4, %k] : view<[%rows]x[%reduction]xf32> -> f32
        %broadcast4 = vector.splat %weight4 : vector<16xf32>
        %next4 = vector.fmaf %value, %broadcast4, %sum4 : vector<16xf32>
        %weight5 = view.load %weights[%row5, %k] : view<[%rows]x[%reduction]xf32> -> f32
        %broadcast5 = vector.splat %weight5 : vector<16xf32>
        %next5 = vector.fmaf %value, %broadcast5, %sum5 : vector<16xf32>
        %weight6 = view.load %weights[%row6, %k] : view<[%rows]x[%reduction]xf32> -> f32
        %broadcast6 = vector.splat %weight6 : vector<16xf32>
        %next6 = vector.fmaf %value, %broadcast6, %sum6 : vector<16xf32>
        %weight7 = view.load %weights[%row7, %k] : view<[%rows]x[%reduction]xf32> -> f32
        %broadcast7 = vector.splat %weight7 : vector<16xf32>
        %next7 = vector.fmaf %value, %broadcast7, %sum7 : vector<16xf32>
        %weight8 = view.load %weights[%row8, %k] : view<[%rows]x[%reduction]xf32> -> f32
        %broadcast8 = vector.splat %weight8 : vector<16xf32>
        %next8 = vector.fmaf %value, %broadcast8, %sum8 : vector<16xf32>
