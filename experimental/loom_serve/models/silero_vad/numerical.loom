// Twelve independent accumulator rows reuse each sixteen-column input load.
target.decl @vad

template.decl @vad.matrix(%rows: index, %columns: index, %reduction: index, %input: buffer, %weights: view<[%rows]x[%reduction]xf32>, %output: buffer, %input_origin: offset, %output_origin: offset)

template.def<@vad.matrix> device @vad_matrix(%rows: index, %columns: index, %reduction: index, %input: buffer, %weights: view<[%rows]x[%reduction]xf32>, %output: buffer, %input_origin: offset, %output_origin: offset) {
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %twelve = index.constant 12 : index
  %sixteen = index.constant 16 : index
  %zero_float = scalar.constant 0.0 : f32
