  %constant71 = index.constant 1 : index
  %constant72 = index.constant 1 : index
  %constant73 = index.constant 1 : index
  scf.for %k = [%zero to %constant69 step %one] {
    %channel = index.div %k, %three : index
    %tap = index.rem %k, %three : index
    scf.for %column = [%zero to %constant70 step %one] {
      %stream = index.div %column, %constant71 : index
      %time = index.rem %column, %constant71 : index
      %center = index.mul %time, %constant73 : index
      %padded = index.add %center, %tap : index
      %position = index.sub %padded, %one : index
      %valid_stream = index.cmp ult, %stream, %eight : index
      %valid_time = index.cmp ult, %position, %constant72 : index
      %live = scalar.andi %valid_stream, %valid_time : i1
      %value = scf.if %live -> (f32) {
        %stream_begin = index.mul %stream, %constant72 : index
        %source_column = index.add %stream_begin, %position : index
        %loaded = view.load %encoder3_source[%channel, %source_column] : view<64x16xf32> -> f32
        scf.yield %loaded : f32
      } else {
        scf.yield %zero_float : f32
      }
      view.store %value, %encoder3_input[%k, %column] : f32, view<192x16xf32>
    }
  }
  %constant74 = index.constant 132 : index
  %constant75 = index.constant 16 : index
  %constant76 = index.constant 192 : index
  %constant77 = index.constant 0 : offset
  %constant78 = index.constant 642688 : offset
  %constant79 = index.constant 51200 : offset
  %encoder3_weights_matrix = view.refine %encoder3_weights : view<132x192xf32> -> view<[%constant74]x[%constant76]xf32>
  template.apply<@vad.matrix>(%constant74, %constant75, %constant76, %scratch, %encoder3_weights_matrix, %scratch, %constant77, %constant79) : (index, index, index, buffer, view<[%constant74]x[%constant76]xf32>, buffer, offset, offset)
  %constant80 = index.constant 51200 : offset
  %encoder3_result = buffer.view %scratch[%constant80] : buffer -> view<132x16xf32>
  %constant81 = index.constant 744064 : offset
  %constant82 = index.constant 118784 : offset
  %encoder3_activation = buffer.view %scratch[%constant82] : buffer -> view<128x16xf32>
  %constant83 = index.constant 128 : index
  scf.for %channel = [%zero to %constant83 step %one] {
    %bias = view.load %encoder3_bias[%channel] : view<128xf32> -> f32
    %biases = vector.splat %bias : vector<16xf32>
    scf.for %column = [%zero to %constant70 step %sixteen] {
      %value = vector.load %encoder3_result[%channel, %column] : view<132x16xf32> -> vector<16xf32>
      %biased = vector.addf %value, %biases : vector<16xf32>
      %activated = vector.maxnumf %biased, %zeros : vector<16xf32>
      vector.store %activated, %encoder3_activation[%channel, %column] : vector<16xf32>, view<128x16xf32>
    }
  }
  %constant84 = index.constant 0 : offset
  %gate_input = buffer.view %scratch[%constant84] : buffer -> view<256x16xf32>
  %constant85 = index.constant 0 : offset
  %previous = buffer.view %previous_state[%constant85] : buffer -> view<2x128x16xf32>
  %constant86 = index.constant 128 : index
  scf.for %channel = [%zero to %constant86 step %one] {
    %x = vector.load %encoder3_activation[%channel, 0] : view<128x16xf32> -> vector<16xf32>
    %h = vector.load %previous[0, %channel, 0] : view<2x128x16xf32> -> vector<16xf32>
    %hidden_row = index.add %channel, %constant86 : index
    vector.store %x, %gate_input[%channel, 0] : vector<16xf32>, view<256x16xf32>
    vector.store %h, %gate_input[%hidden_row, 0] : vector<16xf32>, view<256x16xf32>
  }
  %constant87 = index.constant 516 : index
  %constant88 = index.constant 16 : index
  %constant89 = index.constant 128 : index
  %constant90 = index.constant 0 : offset
  %constant91 = index.constant 744576 : offset
  %constant92 = index.constant 51200 : offset
  %input_gates_weights_matrix = view.refine %input_gates_weights : view<516x128xf32> -> view<[%constant87]x[%constant89]xf32>
  template.apply<@vad.matrix>(%constant87, %constant88, %constant89, %scratch, %input_gates_weights_matrix, %scratch, %constant90, %constant92) : (index, index, index, buffer, view<[%constant87]x[%constant89]xf32>, buffer, offset, offset)
  %constant93 = index.constant 516 : index
  %constant94 = index.constant 16 : index
  %constant95 = index.constant 128 : index
  %constant96 = index.constant 8192 : offset
  %constant97 = index.constant 1010816 : offset
  %constant98 = index.constant 84224 : offset
  %recurrent_gates_weights_matrix = view.refine %recurrent_gates_weights : view<516x128xf32> -> view<[%constant93]x[%constant95]xf32>
  template.apply<@vad.matrix>(%constant93, %constant94, %constant95, %scratch, %recurrent_gates_weights_matrix, %scratch, %constant96, %constant98) : (index, index, index, buffer, view<[%constant93]x[%constant95]xf32>, buffer, offset, offset)
  %constant99 = index.constant 51200 : offset
  %gate_results = buffer.view %scratch[%constant99] : buffer -> view<516x16xf32>
  %constant100 = index.constant 84224 : offset
  %recurrent_results = buffer.view %scratch[%constant100] : buffer -> view<516x16xf32>
  %constant101 = index.constant 1008768 : offset
  %constant102 = index.constant 0 : offset
  %next = buffer.view %next_state[%constant102] : buffer -> view<2x128x8xf32>
  %constant103 = index.constant 1277056 : offset
  %constant104 = index.constant 1277568 : offset
  %constant105 = index.constant 0 : offset
  %probabilities = buffer.view %probability[%constant105] : buffer -> view<8xf32>
  %zeros_live = vector.splat %zero_float : vector<8xf32>
  %logits = scf.for %channel = [%zero to %constant86 step %one](%sum = %zeros_live : vector<8xf32>) -> (vector<8xf32>) {
    %constant106 = index.constant 0 : index
    %input_row = index.add %channel, %constant106 : index
    %input_bias = view.load %gate_bias[%input_row] : view<512xf32> -> f32
    %input_biases = vector.splat %input_bias : vector<8xf32>
    %input_input = vector.load %gate_results[%input_row, 0] : view<516x16xf32> -> vector<8xf32>
    %input_recurrent = vector.load %recurrent_results[%input_row, 0] : view<516x16xf32> -> vector<8xf32>
    %input_value = vector.addf %input_input, %input_recurrent : vector<8xf32>
    %input_biased = vector.addf %input_value, %input_biases : vector<8xf32>
    %input = vector.logisticf<afn> %input_biased : vector<8xf32>
    %constant107 = index.constant 128 : index
    %forget_row = index.add %channel, %constant107 : index
    %forget_bias = view.load %gate_bias[%forget_row] : view<512xf32> -> f32
    %forget_biases = vector.splat %forget_bias : vector<8xf32>
    %forget_input = vector.load %gate_results[%forget_row, 0] : view<516x16xf32> -> vector<8xf32>
    %forget_recurrent = vector.load %recurrent_results[%forget_row, 0] : view<516x16xf32> -> vector<8xf32>
    %forget_value = vector.addf %forget_input, %forget_recurrent : vector<8xf32>
    %forget_biased = vector.addf %forget_value, %forget_biases : vector<8xf32>
    %forget = vector.logisticf<afn> %forget_biased : vector<8xf32>
    %constant108 = index.constant 256 : index
    %candidate_row = index.add %channel, %constant108 : index
    %candidate_bias = view.load %gate_bias[%candidate_row] : view<512xf32> -> f32
    %candidate_biases = vector.splat %candidate_bias : vector<8xf32>
    %candidate_input = vector.load %gate_results[%candidate_row, 0] : view<516x16xf32> -> vector<8xf32>
    %candidate_recurrent = vector.load %recurrent_results[%candidate_row, 0] : view<516x16xf32> -> vector<8xf32>
    %candidate_value = vector.addf %candidate_input, %candidate_recurrent : vector<8xf32>
    %candidate_biased = vector.addf %candidate_value, %candidate_biases : vector<8xf32>
    %candidate = vector.tanhf<afn> %candidate_biased : vector<8xf32>
    %constant109 = index.constant 384 : index
    %output_row = index.add %channel, %constant109 : index
    %output_bias = view.load %gate_bias[%output_row] : view<512xf32> -> f32
    %output_biases = vector.splat %output_bias : vector<8xf32>
    %output_input = vector.load %gate_results[%output_row, 0] : view<516x16xf32> -> vector<8xf32>
    %output_recurrent = vector.load %recurrent_results[%output_row, 0] : view<516x16xf32> -> vector<8xf32>
    %output_value = vector.addf %output_input, %output_recurrent : vector<8xf32>
    %output_biased = vector.addf %output_value, %output_biases : vector<8xf32>
    %output = vector.logisticf<afn> %output_biased : vector<8xf32>
    %previous_cell = vector.load %previous[1, %channel, 0] : view<2x128x16xf32> -> vector<8xf32>
    %retained = vector.mulf %forget, %previous_cell : vector<8xf32>
    %incoming = vector.mulf %input, %candidate : vector<8xf32>
    %cell = vector.addf %retained, %incoming : vector<8xf32>
    %cell_activation = vector.tanhf<afn> %cell : vector<8xf32>
    %hidden = vector.mulf %output, %cell_activation : vector<8xf32>
    vector.store %hidden, %next[0, %channel, 0] : vector<8xf32>, view<2x128x8xf32>
    vector.store %cell, %next[1, %channel, 0] : vector<8xf32>, view<2x128x8xf32>
    %head_value = vector.maxnumf %hidden, %zeros_live : vector<8xf32>
    %weight = view.load %head_weight[%channel] : view<128xf32> -> f32
    %weights = vector.splat %weight : vector<8xf32>
    %next_sum = vector.fmaf %head_value, %weights, %sum : vector<8xf32>
    scf.yield %next_sum : vector<8xf32>
  }
  %bias = view.load %head_bias[0] : view<1xf32> -> f32
  %biases = vector.splat %bias : vector<8xf32>
  %biased = vector.addf %logits, %biases : vector<8xf32>
  %scores = vector.logisticf<afn> %biased : vector<8xf32>
  vector.store %scores, %probabilities[0] : vector<8xf32>, view<8xf32>
  template.return
}
