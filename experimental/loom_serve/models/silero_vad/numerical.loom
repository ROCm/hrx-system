      %row0 = index.add %row, %delta0 : index
      %delta1 = index.constant 1 : index
      %row1 = index.add %row, %delta1 : index
      %delta2 = index.constant 2 : index
      %row2 = index.add %row, %delta2 : index
      %delta3 = index.constant 3 : index
      %row3 = index.add %row, %delta3 : index
      %delta4 = index.constant 4 : index
      %row4 = index.add %row, %delta4 : index
