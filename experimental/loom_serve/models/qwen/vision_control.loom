func.decl import("runner") @execute_2(%stage: i32, %input: hal.buffer, %output: hal.buffer) -> (i64)

func.decl @qwen38_vision_pixel_packet(%request: buffer) -> (buffer)

func.decl @qwen38_vision_stage(%height: i64, %width: i64, %count: i64) -> (i32)

// Chat policy owns the selected geometry. Native admission owns codec bounds;
// only images with the same selected shape share a projection cohort.
func.def public @prepare_request(%state: buffer, %request: buffer) -> (buffer, i64, i64) {
  %origin = index.constant 0 : offset
  %header = buffer.view %request[%origin] : buffer -> view<16xi32>
  %metadata_word = view.load %header[8] : view<16xi32> -> i32
  %metadata_offset = index.cast %metadata_word : i32 to offset
  %metadata = buffer.view %request[%metadata_offset] : buffer -> view<2xi32>
  %width = view.load %metadata[0] : view<2xi32> -> i32
  %height = view.load %metadata[1] : view<2xi32> -> i32
  %width64 = scalar.extui %width : i32 to i64
  %height64 = scalar.extui %height : i32 to i64
  %shift = scalar.constant 32 : i64
  %width_bits = scalar.shli %width64, %shift : i64
  %tag = scalar.ori %width_bits, %height64 : i64
  %packet = func.call @qwen38_vision_pixel_packet(%request) : (buffer) -> (buffer)
  %units = scalar.constant 1 : i64
  func.return %packet, %units, %tag : buffer, i64, i64
}

// The native packer transfers ownership of its exact upload. Fill the reserved
// directory in place; the original decoded planes need no further cohort copy.
func.def public @prepare_batch(%state: buffer, %tags: buffer, %ranges: buffer, %packed: buffer) -> (i32, buffer, buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %range_bytes = buffer.length %ranges
  %range_bytes64 = index.cast %range_bytes : offset to i64
  %sixteen = scalar.constant 16 : i64
  %count_value = scalar.divui %range_bytes64, %sixteen : i64
  %count64 = scalar.assume %count_value [range(%count_value, 1, 4)] : i64
  %count = index.cast %count64 : i64 to index
  %tag_words = buffer.view %tags[%origin] : buffer -> view<[%count]xi64>
  %tag = view.load %tag_words[0] : view<[%count]xi64> -> i64
  %shift = scalar.constant 32 : i64
  %mask = scalar.constant 4294967295 : i64
  %width64 = scalar.shrui %tag, %shift : i64
  %height64 = scalar.andi %tag, %mask : i64
  %pixels = scalar.muli %width64, %height64 : i64
  %token_pixels = scalar.constant 1024 : i64
  %image_rows = scalar.divui %pixels, %token_pixels : i64
  %image_row_count = index.cast %image_rows : i64 to index
  %row_count = index.mul %count, %image_row_count : index
  %rows64 = index.cast %row_count : index to i64
  %header_bytes = index.constant 32 : offset
  %request_stride = index.constant 24 : offset
  %row_stride = index.constant 16 : offset
  %request_bytes = index.scale %count, %request_stride : index, offset -> offset
  %row_offset = index.add %header_bytes, %request_bytes : offset
  %row_bytes = index.scale %row_count, %row_stride : index, offset -> offset
  %plan_bytes = index.add %row_offset, %row_bytes : offset
  %plan = buffer.alloca<private> align(8) %plan_bytes : buffer
  %header = buffer.view %plan[%origin] : buffer -> view<4xi64>
  %feature_bytes = scalar.constant 20480 : i64
  %image_bytes = scalar.muli %image_rows, %feature_bytes : i64
  %output_bytes = scalar.muli %count64, %image_bytes : i64
  view.store %output_bytes, %header[0] : i64, view<4xi64>
  view.store %output_bytes, %header[1] : i64, view<4xi64>
  view.store %count64, %header[2] : i64, view<4xi64>
  view.store %rows64, %header[3] : i64, view<4xi64>
  %requests = buffer.view %plan[%header_bytes] : buffer -> view<[%count]x3xi64>
  %ranges_view = buffer.view %ranges[%origin] : buffer -> view<[%count]x2xi64>
  %directory = buffer.view %packed[%origin] : buffer -> view<4x2xi64>
  %prefix_bytes = scalar.constant 64 : i64
  scf.for %i = [%c0 to %count step %c1] {
    %packet_offset = view.load %ranges_view[%i, 0] : view<[%count]x2xi64> -> i64
    %packet_length = view.load %ranges_view[%i, 1] : view<[%count]x2xi64> -> i64
    %header_offset = scalar.addi %packet_offset, %prefix_bytes : i64
    %header_length = scalar.subi %packet_length, %prefix_bytes : i64
    view.store %header_offset, %directory[%i, 0] : i64, view<4x2xi64>
    view.store %header_length, %directory[%i, 1] : i64, view<4x2xi64>
    %i64 = index.cast %i : index to i64
    %first = scalar.muli %i64, %image_rows : i64
    view.store %first, %requests[%i, 0] : i64, view<[%count]x3xi64>
    view.store %image_rows, %requests[%i, 1] : i64, view<[%count]x3xi64>
    view.store %image_rows, %requests[%i, 2] : i64, view<[%count]x3xi64>
  }
  %records = buffer.view %plan[%row_offset] : buffer -> view<[%row_count]x2xi64>
  %elements = scalar.constant 5120 : i64
  scf.for %i = [%c0 to %row_count step %c1] {
    %i64 = index.cast %i : index to i64
    %offset = scalar.muli %i64, %feature_bytes : i64
    view.store %offset, %records[%i, 0] : i64, view<[%row_count]x2xi64>
    view.store %elements, %records[%i, 1] : i64, view<[%row_count]x2xi64>
  }
  %stage = func.call @qwen38_vision_stage(%height64, %width64, %count64) : (i64, i64, i64) -> (i32)
  func.return %stage, %packed, %plan : i32, buffer, buffer
}

func.def public @run(%stage: i32, %input: hal.buffer, %output: hal.buffer) {
  %work = func.call @execute_2(%stage, %input, %output) : (i32, hal.buffer, hal.buffer) -> (i64)
  func.return
}
