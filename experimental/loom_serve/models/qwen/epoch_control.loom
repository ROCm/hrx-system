func.decl import("runner") @execute_3(%stage: i32, %b0: hal.buffer, %b1: hal.buffer, %b2: hal.buffer) -> (i64)

func.decl import("runner") @execute_4(%stage: i32, %b0: hal.buffer, %b1: hal.buffer, %b2: hal.buffer, %b3: hal.buffer) -> (i64)

func.decl import("runner") @execute_5(%stage: i32, %b0: hal.buffer, %b1: hal.buffer, %b2: hal.buffer, %b3: hal.buffer, %b4: hal.buffer) -> (i64)

func.decl import("runner") @execute_6(%stage: i32, %b0: hal.buffer, %b1: hal.buffer, %b2: hal.buffer, %b3: hal.buffer, %b4: hal.buffer, %b5: hal.buffer) -> (i64)

func.decl import("runner") @execute_7(%stage: i32, %b0: hal.buffer, %b1: hal.buffer, %b2: hal.buffer, %b3: hal.buffer, %b4: hal.buffer, %b5: hal.buffer, %b6: hal.buffer) -> (i64)

func.decl import("runner") @feedback(%slot: i32, %source: hal.buffer, %offset: i64, %length: i64) -> (i64)

func.decl @encode_media_plan(%plan: buffer, %inputs: buffer, %media_plan: buffer, %media_begin: index, %media_end: index, %count: index, %first: index, %metadata: buffer, %tokens: buffer, %packet_begin: index)

func.decl @publish_media_positions(%plan: buffer, %media_plan: buffer, %count: index, %progress: buffer)

// Ownership events provide {row, read_origin, write_origin, fork_position}.
// The retained payload is source-owned; KV origins and unchanged rows survive.
func.def public @encode_state(%bindings: buffer, %count: i32, %origins: buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %bounded_count = scalar.assume %count [range(%count, 1, 16)] : i32
  %length = index.cast %bounded_count : i32 to index
  %records = buffer.view %bindings[%origin] : buffer -> view<16x4xi64>
  %rows = buffer.view %origins[%origin] : buffer -> view<16x4xi64>
  scf.for %i = [%c0 to %length step %c1] {
    %row_word = view.load %records[%i, 0] : view<16x4xi64> -> i64
    %bounded_row = scalar.assume %row_word [range(%row_word, 0, 15)] : i64
    %row = index.cast %bounded_row : i64 to index
    %read = view.load %records[%i, 1] : view<16x4xi64> -> i64
    %write = view.load %records[%i, 2] : view<16x4xi64> -> i64
    %position = view.load %records[%i, 3] : view<16x4xi64> -> i64
    view.store %read, %rows[%row, 0] : i64, view<16x4xi64>
    view.store %write, %rows[%row, 1] : i64, view<16x4xi64>
    view.store %position, %rows[%row, 3] : i64, view<16x4xi64>
  }
  func.return
}

// Host plans carry {length, position, source_position, row, input_begin,
// input_count, flags, output_credit, first_span}. Flags are SELECT=1 and
// PROPOSE=2. The second plan starts at record sixteen; known IDs form one
// contiguous host stream. Descriptor word four packs source_position in its
// high 22 bits and selected output + 1 in its low ten bits. Model-specific
// descriptor, selection and verifier layouts stay in source.
func.def @encode_plan(%plan: buffer, %inputs: buffer, %count: index, %first: index, %metadata: buffer, %metadata_origin: offset, %tokens: buffer, %token_origin: offset, %ordinary: i1) -> (i32) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : offset
  %descriptor_base = index.constant 12 : offset
  %selection_base = index.constant 1292 : offset
  %options_base = index.constant 1804 : offset
  %descriptor_origin = index.add %metadata_origin, %descriptor_base : offset
  %selection_origin = index.add %metadata_origin, %selection_base : offset
  %options_origin = index.add %metadata_origin, %options_base : offset
  %requests = buffer.view %plan[%origin] : buffer -> view<32x9xi32>
  %descriptors = buffer.view %metadata[%descriptor_origin] : buffer -> view<64x5xi32>
  %selections = buffer.view %metadata[%selection_origin] : buffer -> view<128xi32>
  %options = buffer.view %metadata[%options_origin] : buffer -> view<64x2xi32>
  %identity_origin = index.constant 5088 : offset
  %identities = buffer.view %metadata[%identity_origin] : buffer -> view<128x2xi32>
  %primary = index.cmp eq, %metadata_origin, %origin : offset
  %span_count = index.assume %count [range(%count, 1, 16)] : index
  %zero32 = scalar.constant 0 : i32
  %one32 = scalar.constant 1 : i32
  %two32 = scalar.constant 2 : i32
  %ten32 = scalar.constant 10 : i32
  %absent = scalar.constant -1 : i32
  %token_count, %output_count = scf.for %i = [%c0 to %span_count step %c1](%cursor = %zero32 : i32, %outputs = %zero32 : i32) -> (i32, i32) {
    %record_value = index.add %first, %i : index
    %record = index.assume %record_value [range(%record_value, 0, 31)] : index
    %length = view.load %requests[%record, 0] : view<32x9xi32> -> i32
    %position = view.load %requests[%record, 1] : view<32x9xi32> -> i32
    %source_position = view.load %requests[%record, 2] : view<32x9xi32> -> i32
    %row = view.load %requests[%record, 3] : view<32x9xi32> -> i32
    %input_begin = view.load %requests[%record, 4] : view<32x9xi32> -> i32
    %input_count = view.load %requests[%record, 5] : view<32x9xi32> -> i32
    %flags = view.load %requests[%record, 6] : view<32x9xi32> -> i32
    %credit = view.load %requests[%record, 7] : view<32x9xi32> -> i32
    %select_bits = scalar.andi %flags, %one32 : i32
    %selected = scalar.cmpi ne, %select_bits, %zero32 : i32
    %propose_bits = scalar.andi %flags, %two32 : i32
    %proposes = scalar.cmpi ne, %propose_bits, %zero32 : i32
    %speculative = scalar.cmpi ne, %credit, %zero32 : i32
    %speculative32 = scalar.extui %speculative : i1 to i32
    %mode = scf.select %proposes, %two32, %speculative32 : i32
    %selection = scf.select %selected, %outputs, %absent : i32
    %selection_code = scalar.addi %selection, %one32 : i32
    %source_bits = scalar.shli %source_position, %ten32 : i32
    %descriptor_word = scalar.ori %source_bits, %selection_code : i32
    view.store %length, %descriptors[%i, 0] : i32, view<64x5xi32>
    view.store %position, %descriptors[%i, 1] : i32, view<64x5xi32>
    view.store %cursor, %descriptors[%i, 2] : i32, view<64x5xi32>
    view.store %row, %descriptors[%i, 3] : i32, view<64x5xi32>
    view.store %descriptor_word, %descriptors[%i, 4] : i32, view<64x5xi32>
    view.store %mode, %options[%i, 0] : i32, view<64x2xi32>
    view.store %credit, %options[%i, 1] : i32, view<64x2xi32>
    %input_index = index.cast %input_begin : i32 to index
    %input_extent = index.cast %input_count : i32 to index
    %cursor_index = index.cast %cursor : i32 to index
    %source_offset = index.scale %input_index, %c4 : index, offset -> offset
    %input_bytes = index.scale %input_extent, %c4 : index, offset -> offset
    %cursor_bytes = index.scale %cursor_index, %c4 : index, offset -> offset
    %target_offset = index.add %token_origin, %cursor_bytes : offset
    scf.if %ordinary {
      buffer.copy %inputs[%source_offset], %tokens[%target_offset], %input_bytes
    }
    %end = scalar.addi %cursor, %length : i32
    %selected_count = scf.select %speculative, %length, %one32 : i32
    %active_selections = scf.select %selected, %selected_count, %zero32 : i32
    %bounded_selections = scalar.assume %active_selections [range(%active_selections, 0, 8)] : i32
    %selection_count = index.cast %bounded_selections : i32 to index
    %selection_first = scalar.subi %end, %active_selections : i32
    scf.for %j = [%c0 to %selection_count step %c1] {
      %j32 = index.cast %j : index to i32
      %slot32 = scalar.addi %outputs, %j32 : i32
      %slot_value = index.cast %slot32 : i32 to index
      %slot = index.assume %slot_value [range(%slot_value, 0, 127)] : index
      %token = scalar.addi %selection_first, %j32 : i32
      view.store %token, %selections[%slot] : i32, view<128xi32>
      scf.if %primary {
        %relative = scalar.subi %token, %cursor : i32
        %input_position = scalar.addi %position, %relative : i32
        %target_position = scalar.addi %input_position, %one32 : i32
        view.store %row, %identities[%slot, 0] : i32, view<128x2xi32>
        view.store %target_position, %identities[%slot, 1] : i32, view<128x2xi32>
      }
    }
    %next_outputs = scalar.addi %outputs, %active_selections : i32
    scf.yield %end, %next_outputs : i32, i32
  }
  %header = buffer.view %metadata[%metadata_origin] : buffer -> view<3xi32>
  %count32 = index.cast %count : index to i32
  view.store %token_count, %header[0] : i32, view<3xi32>
  view.store %count32, %header[1] : i32, view<3xi32>
  view.store %output_count, %header[2] : i32, view<3xi32>
  func.return %output_count : i32
}

// All backing is cold retained storage. The final 80 control bytes hold two
// {source binding, source offset, target binding, target offset, length} upload
// records. Both initialized packet buffers are uploaded in full. The caller
// consumes this plan synchronously and retains packet bytes through retirement.
func.def public @encode_epoch(%control_state: buffer, %plan: buffer, %inputs: buffer, %media_plan: buffer, %first_count: i32, %next_count: i32, %input_count: i32, %first_media_count: i32, %next_media_count: i32, %first_packet_capacity: i32, %next_packet_capacity: i32, %eos: i32, %metadata: buffer, %tokens: buffer) -> (i32, buffer, i64, i64) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c16 = index.constant 16 : index
  %zero32 = scalar.constant 0 : i32
  %token_bytes = buffer.length %tokens
  buffer.fill %zero32, %tokens[%origin], %token_bytes : i32
  %policy_source = index.constant 32 : offset
  %policy_target = index.constant 4704 : offset
  %policy_bytes = index.constant 384 : offset
  buffer.copy %control_state[%policy_source], %metadata[%policy_target], %policy_bytes
  %first_bounded = scalar.assume %first_count [range(%first_count, 1, 16)] : i32
  %first = index.cast %first_bounded : i32 to index
  %media_count = scalar.addi %first_media_count, %next_media_count : i32
  %ordinary = scalar.cmpi eq, %media_count, %zero32 : i32
  %outputs = func.call @encode_plan(%plan, %inputs, %first, %c0, %metadata, %origin, %tokens, %origin, %ordinary) : (buffer, buffer, index, index, buffer, offset, buffer, offset, i1) -> (i32)
  %eos_offset = index.constant 2316 : offset
  %terminal = buffer.view %metadata[%eos_offset] : buffer -> view<1xi32>
  view.store %eos, %terminal[0] : i32, view<1xi32>
  %continues = scalar.cmpi ne, %next_count, %zero32 : i32
  scf.if %continues {
    %next_bounded = scalar.assume %next_count [range(%next_count, 1, 16)] : i32
    %next = index.cast %next_bounded : i32 to index
    %metadata_base = index.constant 2320 : offset
    // The allocation contains two equal planes sized by the largest prepared
    // shape. The queued epoch may use a different shape than the active one.
    %token_byte_count = index.cast %token_bytes : offset to index
    %plane_count = index.constant 2 : index
    %plane_bytes = index.div %token_byte_count, %plane_count : index
    %token_base = index.cast %plane_bytes : index to offset
    %next_outputs = func.call @encode_plan(%plan, %inputs, %next, %c16, %metadata, %metadata_base, %tokens, %token_base, %ordinary) : (buffer, buffer, index, index, buffer, offset, buffer, offset, i1) -> (i32)
    %next_eos_offset = index.constant 4636 : offset
    %next_terminal = buffer.view %metadata[%next_eos_offset] : buffer -> view<1xi32>
    view.store %eos, %next_terminal[0] : i32, view<1xi32>
    %requests = buffer.view %plan[%origin] : buffer -> view<32x9xi32>
    %indices_origin = index.constant 4640 : offset
    %indices = buffer.view %metadata[%indices_origin] : buffer -> view<16xi32>
    scf.for %i = [%c0 to %next step %c1] {
      %record = index.add %c16, %i : index
      %first_span = view.load %requests[%record, 8] : view<32x9xi32> -> i32
      view.store %first_span, %indices[%i] : i32, view<16xi32>
    }
  }
  %mixed = scalar.cmpi ne, %media_count, %zero32 : i32
  scf.if %mixed {
    %packet_shape_origin = index.constant 6112 : offset
    %packet_shape = buffer.view %metadata[%packet_shape_origin] : buffer -> view<2xi32>
    view.store %first_packet_capacity, %packet_shape[0] : i32, view<2xi32>
    view.store %next_packet_capacity, %packet_shape[1] : i32, view<2xi32>
    %first_media = index.cast %first_media_count : i32 to index
    func.call @encode_media_plan(%plan, %inputs, %media_plan, %c0, %first_media, %first, %c0, %metadata, %tokens, %c0) : (buffer, buffer, buffer, index, index, index, index, buffer, buffer, index)
    scf.if %continues {
      %next = index.cast %next_count : i32 to index
      %all_media = index.cast %media_count : i32 to index
      %packet_begin = index.cast %first_packet_capacity : i32 to index
      func.call @encode_media_plan(%plan, %inputs, %media_plan, %first_media, %all_media, %next, %c16, %metadata, %tokens, %packet_begin) : (buffer, buffer, buffer, index, index, index, index, buffer, buffer, index)
    }
  }
  %transfer_offset = index.constant 416 : offset
  %transfers = buffer.view %control_state[%transfer_offset] : buffer -> view<2x5xi64>
  %zero64 = scalar.constant 0 : i64
  %one64 = scalar.constant 1 : i64
  %metadata_bytes = buffer.length %metadata
  %metadata_length = index.cast %metadata_bytes : offset to i64
  %input_length = index.cast %token_bytes : offset to i64
  view.store %zero64, %transfers[0, 0] : i64, view<2x5xi64>
  view.store %zero64, %transfers[0, 1] : i64, view<2x5xi64>
  view.store %zero64, %transfers[0, 2] : i64, view<2x5xi64>
  view.store %zero64, %transfers[0, 3] : i64, view<2x5xi64>
  view.store %metadata_length, %transfers[0, 4] : i64, view<2x5xi64>
  view.store %one64, %transfers[1, 0] : i64, view<2x5xi64>
  view.store %zero64, %transfers[1, 1] : i64, view<2x5xi64>
  view.store %one64, %transfers[1, 2] : i64, view<2x5xi64>
  view.store %zero64, %transfers[1, 3] : i64, view<2x5xi64>
  view.store %input_length, %transfers[1, 4] : i64, view<2x5xi64>
  %transfer_begin = scalar.constant 416 : i64
  %transfer_length = scalar.constant 80 : i64
  func.return %outputs, %control_state, %transfer_begin, %transfer_length : i32, buffer, i64, i64
}

// Semantic progress is {consumed, known, outputs, verifications,
// source_position, tokens[16]}. Only completed feedback enters this transform;
// bank contents are immutable.
func.def public @publish_epoch(%plan: buffer, %media_plan: buffer, %count: i32, %first_media_count: i32, %next_media_count: i32, %verified: i32, %continues: i32, %next_speculative_mask: i32, %ordinary: buffer, %first_results: buffer, %next_results: buffer, %progress: buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %zero32 = scalar.constant 0 : i32
  %one32 = scalar.constant 1 : i32
  %bounded_count = scalar.assume %count [range(%count, 1, 16)] : i32
  %extent = index.cast %bounded_count : i32 to index
  %progress_bytes = buffer.length %progress
  buffer.fill %zero32, %progress[%origin], %progress_bytes : i32
  %requests = buffer.view %plan[%origin] : buffer -> view<32x9xi32>
  %published = buffer.view %progress[%origin] : buffer -> view<16x21xi32>
  %verifies = scalar.cmpi ne, %verified, %zero32 : i32
  %outputs = scf.for %i = [%c0 to %extent step %c1](%ordinary_index = %c0 : index) -> (index) {
    %consumed, %known, %output_count, %verifications = scf.if %verifies -> (i32, i32, i32, i32) {
      %records = buffer.view %first_results[%origin] : buffer -> view<16x10xi32>
      %consumed = view.load %records[%i, 0] : view<16x10xi32> -> i32
      %output_count = view.load %records[%i, 1] : view<16x10xi32> -> i32
      %credit = view.load %requests[%i, 7] : view<32x9xi32> -> i32
      %speculative = scalar.cmpi ne, %credit, %zero32 : i32
      %verifications = scalar.extui %speculative : i1 to i32
      %known = scf.select %speculative, %zero32, %consumed : i32
      %bounded_outputs = scalar.assume %output_count [range(%output_count, 0, 8)] : i32
      %output_extent = index.cast %bounded_outputs : i32 to index
      scf.for %j = [%c0 to %output_extent step %c1] {
        %source = index.add %j, %c2 : index
        %target_value = index.add %j, %c4 : index
        %target = index.add %target_value, %c1 : index
        %token = view.load %records[%i, %source] : view<16x10xi32> -> i32
        view.store %token, %published[%i, %target] : i32, view<16x21xi32>
      }
      scf.yield %consumed, %known, %output_count, %verifications : i32, i32, i32, i32
    } else {
      %length = view.load %requests[%i, 0] : view<32x9xi32> -> i32
      %flags = view.load %requests[%i, 6] : view<32x9xi32> -> i32
      %selected_bits = scalar.andi %flags, %one32 : i32
      %selected = scalar.cmpi ne, %selected_bits, %zero32 : i32
      %selected_count = scalar.extui %selected : i1 to i32
      scf.if %selected {
        %tokens = buffer.view %ordinary[%origin] : buffer -> view<16xi32>
        %slot = index.assume %ordinary_index [range(%ordinary_index, 0, 15)] : index
        %token = view.load %tokens[%slot] : view<16xi32> -> i32
        view.store %token, %published[%i, 5] : i32, view<16x21xi32>
      }
      scf.yield %length, %length, %selected_count, %zero32 : i32, i32, i32, i32
    }
    view.store %consumed, %published[%i, 0] : i32, view<16x21xi32>
    view.store %known, %published[%i, 1] : i32, view<16x21xi32>
    view.store %output_count, %published[%i, 2] : i32, view<16x21xi32>
    view.store %verifications, %published[%i, 3] : i32, view<16x21xi32>
    %source_position = view.load %requests[%i, 2] : view<32x9xi32> -> i32
    %next_source_position = scalar.addi %source_position, %consumed : i32
    view.store %next_source_position, %published[%i, 4] : i32, view<16x21xi32>
    %advance = index.cast %output_count : i32 to index
    %next_index = index.add %ordinary_index, %advance : index
    scf.yield %next_index : index
  }
  %has_next = scalar.cmpi ne, %continues, %zero32 : i32
  scf.if %has_next {
    %records = buffer.view %next_results[%origin] : buffer -> view<16x10xi32>
    %tags_origin = index.constant 640 : offset
    %tags = buffer.view %next_results[%tags_origin] : buffer -> view<16xi32>
    scf.for %i = [%c0 to %extent step %c1] {
      %tag = view.load %tags[%i] : view<16xi32> -> i32
      %live = scalar.cmpi sge, %tag, %zero32 : i32
      scf.if %live {
        %tag_value = index.cast %tag : i32 to index
        %first = index.assume %tag_value [range(%tag_value, 0, 15)] : index
        %consumed = view.load %records[%i, 0] : view<16x10xi32> -> i32
        %output_count = view.load %records[%i, 1] : view<16x10xi32> -> i32
        %prior_consumed = view.load %published[%first, 0] : view<16x21xi32> -> i32
        %prior_known = view.load %published[%first, 1] : view<16x21xi32> -> i32
        %prior_outputs = view.load %published[%first, 2] : view<16x21xi32> -> i32
        %prior_verifications = view.load %published[%first, 3] : view<16x21xi32> -> i32
        %prior_source_position = view.load %published[%first, 4] : view<16x21xi32> -> i32
        %bit = scalar.shli %one32, %tag : i32
        %bits = scalar.andi %next_speculative_mask, %bit : i32
        %speculative = scalar.cmpi ne, %bits, %zero32 : i32
        %known = scf.select %speculative, %zero32, %consumed : i32
        %verification = scalar.extui %speculative : i1 to i32
        %total_consumed = scalar.addi %prior_consumed, %consumed : i32
        %total_known = scalar.addi %prior_known, %known : i32
        %total_outputs = scalar.addi %prior_outputs, %output_count : i32
        %total_verifications = scalar.addi %prior_verifications, %verification : i32
        %next_source_position = scalar.addi %prior_source_position, %consumed : i32
        view.store %total_consumed, %published[%first, 0] : i32, view<16x21xi32>
        view.store %total_known, %published[%first, 1] : i32, view<16x21xi32>
        view.store %total_outputs, %published[%first, 2] : i32, view<16x21xi32>
        view.store %total_verifications, %published[%first, 3] : i32, view<16x21xi32>
        view.store %next_source_position, %published[%first, 4] : i32, view<16x21xi32>
        %bounded_outputs = scalar.assume %output_count [range(%output_count, 0, 8)] : i32
        %output_extent = index.cast %bounded_outputs : i32 to index
        %prior_extent = index.cast %prior_outputs : i32 to index
        scf.for %j = [%c0 to %output_extent step %c1] {
          %source = index.add %j, %c2 : index
          %token_index = index.add %prior_extent, %j : index
          %target_base = index.add %token_index, %c4 : index
          %target_value = index.add %target_base, %c1 : index
          %target = index.assume %target_value [range(%target_value, 5, 20)] : index
          %token = view.load %records[%i, %source] : view<16x10xi32> -> i32
          view.store %token, %published[%first, %target] : i32, view<16x21xi32>
        }
      }
    }
  }
  %published_next_media = scf.select %has_next, %next_media_count, %zero32 : i32
  %media_count = scalar.addi %first_media_count, %published_next_media : i32
  %mixed = scalar.cmpi ne, %media_count, %zero32 : i32
  scf.if %mixed {
    %media_extent = index.cast %media_count : i32 to index
    func.call @publish_media_positions(%plan, %media_plan, %media_extent, %progress) : (buffer, buffer, index, buffer)
  }
  func.return
}

// The program is shared; all request state arrives as buffer bindings.
func.def public @step(%state: buffer, %initialize: i32, %source_position: i32, %input_count: i32, %residual: hal.buffer, %control: hal.buffer, %gdn: hal.buffer, %attention: hal.buffer, %tokens: hal.buffer, %progress: hal.buffer) -> (i64, i32) {
  %origin = index.constant 0 : offset
  %view = buffer.view %state[%origin] : buffer -> view<8xi32>
  %prefill = view.load %view[0] : view<8xi32> -> i32
  %decode = view.load %view[1] : view<8xi32> -> i32
  %c0 = scalar.constant 0 : i32
  %is_prefill = scalar.cmpi ne, %initialize, %c0 : i32
  %stage = scf.select %is_prefill, %prefill, %decode : i32
  %completion = func.call @execute_6(%stage, %residual, %control, %gdn, %attention, %tokens, %progress) : (i32, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer) -> (i64)
  %next_source_position = scalar.addi %source_position, %input_count : i32
  func.return %completion, %next_source_position : i64, i32
}

// Cold state supplies the first target shape, allowing models to omit
// isolated stages. Optional proposal, catch-up, and verifier catalogs retain
// their explicit origins. All sessions share these commands and one process;
// descriptors and buffers carry their live state.
// Feedback slot zero holds ordinary tokens; slots one/two hold separate
// verification banks. Neither branch waits: the owner joins both timelines
// before advancing host frontiers.
func.def @epoch_once(%control_state: buffer, %mixed: i1, %shape: i32, %proposes: i32, %verifies: i32, %span_count: i32, %output_count: i32, %feedback_slot: i32, %residual: hal.buffer, %metadata: hal.buffer, %origins: hal.buffer, %state: hal.buffer, %tokens: hal.buffer, %outputs: hal.buffer, %carry: hal.buffer, %committed: hal.buffer, %results: hal.buffer, %draft_cache: hal.buffer, %draft_origins: hal.buffer) -> (i64) {
  %origin = index.constant 0 : offset
  %view = buffer.view %control_state[%origin] : buffer -> view<8xi32>
  %shape_count = view.load %view[2] : view<8xi32> -> i32
  %ordinary_draft_first = view.load %view[3] : view<8xi32> -> i32
  %mixed_draft_first = view.load %view[7] : view<8xi32> -> i32
  %draft_first = scf.select %mixed, %mixed_draft_first, %ordinary_draft_first : i32
  %draft_kind = view.load %view[4] : view<8xi32> -> i32
  %ordinary_target_first = view.load %view[5] : view<8xi32> -> i32
  %mixed_target_first = view.load %view[6] : view<8xi32> -> i32
  %target_first = scf.select %mixed, %mixed_target_first, %ordinary_target_first : i32
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %c0_2 = scalar.constant 0 : i64
  %propose = scalar.cmpi ne, %proposes, %c0 : i32
  %verify = scalar.cmpi ne, %verifies, %c0 : i32
  %dflash = scalar.cmpi ne, %draft_kind, %c0 : i32
  scf.if %propose {
    scf.if %dflash {
      %proposal = func.call @execute_4(%draft_first, %metadata, %tokens, %draft_origins, %draft_cache) : (i32, hal.buffer, hal.buffer, hal.buffer, hal.buffer) -> (i64)
    } else {
      %proposal = func.call @execute_5(%draft_first, %metadata, %tokens, %draft_origins, %draft_cache, %carry) : (i32, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer) -> (i64)
    }
  }
  %warm_first = scalar.addi %draft_first, %c1 : i32
  %warm_stage = scalar.addi %warm_first, %shape : i32
  %target = scf.if %verify -> (i64) {
    %verify_stage = scalar.addi %warm_stage, %shape_count : i32
    %completion = func.call @execute_7(%verify_stage, %residual, %metadata, %origins, %state, %tokens, %committed, %results) : (i32, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer) -> (i64)
    %count = scalar.extui %span_count : i32 to i64
    %record_bytes = scalar.constant 40 : i64
    %record_length = scalar.muli %count, %record_bytes : i64
    %tagged = scalar.cmpi eq, %feedback_slot, %c2 : i32
    %tagged_length = scalar.constant 704 : i64
    %length = scf.select %tagged, %tagged_length, %record_length : i64
    %feedback = func.call @feedback(%feedback_slot, %results, %c0_2, %length) : (i32, hal.buffer, i64, i64) -> (i64)
    scf.yield %completion : i64
  } else {
    %target_stage = scalar.addi %shape, %target_first : i32
    %completion = func.call @execute_6(%target_stage, %residual, %metadata, %origins, %state, %tokens, %outputs) : (i32, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer) -> (i64)
    %has_output = scalar.cmpi ne, %output_count, %c0 : i32
    scf.if %has_output {
      %count = scalar.extui %output_count : i32 to i64
      %token_bytes = scalar.constant 4 : i64
      %length = scalar.muli %count, %token_bytes : i64
      %feedback = func.call @feedback(%c0, %outputs, %c0_2, %length) : (i32, hal.buffer, i64, i64) -> (i64)
    }
    scf.yield %completion : i64
  }
  // Catch-up only mutates the private draft cache and committed carry. Target
  // feedback stays immutable and can transfer concurrently with this command.
  %draft_enabled = scalar.cmpi ne, %draft_first, %c0 : i32
  %completion = scf.if %draft_enabled -> (i64) {
    %accepted = scf.if %verify -> (hal.buffer) {
      scf.yield %committed : hal.buffer
    } else {
      scf.yield %metadata : hal.buffer
    }
    %warm = scf.if %dflash -> (i64) {
      %completion = func.call @execute_4(%warm_stage, %residual, %accepted, %draft_origins, %draft_cache) : (i32, hal.buffer, hal.buffer, hal.buffer, hal.buffer) -> (i64)
      scf.yield %completion : i64
    } else {
      %completion = func.call @execute_6(%warm_stage, %residual, %accepted, %draft_origins, %draft_cache, %carry, %tokens) : (i32, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer) -> (i64)
      scf.yield %completion : i64
    }
    scf.yield %warm : i64
  } else {
    scf.yield %target : i64
  }
  func.return %completion : i64
}

// A bounded cohort reuses retained state on the work timeline, while each
// feedback bank stays immutable on its independent transfer branch. Acceptance
// produces the next input and position entirely on device; neither call waits.
func.def public @epoch(%control_state: buffer, %shape: i32, %proposes: i32, %verifies: i32, %span_count: i32, %output_count: i32, %epoch_count: i32, %continuation_shape: i32, %continuation_proposes: i32, %first_media_count: i32, %next_media_count: i32, %residual: hal.buffer, %metadata: hal.buffer, %origins: hal.buffer, %state: hal.buffer, %tokens: hal.buffer, %outputs: hal.buffer, %carry: hal.buffer, %committed: hal.buffer, %results: hal.buffer, %draft_cache: hal.buffer, %draft_origins: hal.buffer, %next_results: hal.buffer) -> (i64) {
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %c16 = scalar.constant 16 : i32
  %media_count = scalar.addi %first_media_count, %next_media_count : i32
  %mixed = scalar.cmpi ne, %media_count, %c0 : i32
  %first = func.call @epoch_once(%control_state, %mixed, %shape, %proposes, %verifies, %span_count, %output_count, %c1, %residual, %metadata, %origins, %state, %tokens, %outputs, %carry, %committed, %results, %draft_cache, %draft_origins) : (buffer, i1, i32, i32, i32, i32, i32, i32, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer) -> (i64)
  %continues = scalar.cmpi eq, %epoch_count, %c2 : i32
  %completion = scf.if %continues -> (i64) {
    %origin = index.constant 0 : offset
    %view = buffer.view %control_state[%origin] : buffer -> view<8xi32>
    %shape_count = view.load %view[2] : view<8xi32> -> i32
    %ordinary_proposal = view.load %view[3] : view<8xi32> -> i32
    %mixed_proposal = view.load %view[7] : view<8xi32> -> i32
    %proposal = scf.select %mixed, %mixed_proposal, %ordinary_proposal : i32
    %shapes = scalar.muli %shape_count, %c2 : i32
    %after_shapes = scalar.addi %proposal, %shapes : i32
    %continuation = scalar.addi %after_shapes, %c1 : i32
    %ready = func.call @execute_3(%continuation, %metadata, %tokens, %results) : (i32, hal.buffer, hal.buffer, hal.buffer) -> (i64)
    %next = func.call @epoch_once(%control_state, %mixed, %continuation_shape, %continuation_proposes, %c1, %c16, %c0, %c2, %residual, %metadata, %origins, %state, %tokens, %outputs, %carry, %committed, %next_results, %draft_cache, %draft_origins) : (buffer, i1, i32, i32, i32, i32, i32, i32, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer) -> (i64)
    scf.yield %next : i64
  } else {
    scf.yield %first : i64
  }
  func.return %completion : i64
}
