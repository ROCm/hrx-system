config.decl @runner.qwen38.prefill_token_count : %value: index where [range(%value, 1, 512)]
config.decl @runner.qwen38.span_capacity : %value: index where [range(%value, 1, 64)]

command.program.decl @qwen38_text_prefill_body_impl(%token_count: index, %schedule_token_count: index, %verification_depth: index, %span_capacity: index) launch(%parameters: buffer, %residual: buffer, %control: buffer, %gdn_state: buffer, %attention_cache: buffer, %transition_capture: buffer, %rows: buffer) where [range(%token_count, 1, 512), range(%schedule_token_count, 1, 512), range(%verification_depth, 0, 4), range(%span_capacity, 0, 64)]
command.program.decl @qwen38_output_projection_greedy(%token_count: index, %normalized_origin: offset, %output_origin: offset) launch(%parameters: buffer, %normalized: buffer, %token_id: buffer) where [range(%token_count, 1, 64)]
kernel.decl @qwen38_token_embedding_q5k_f32_prefill(%token_count: index) launch(%token_ids: buffer, %weight: buffer, %output: buffer)
kernel.decl @qwen38_output_normalize_spans(%output_capacity: index) launch(%epoch: buffer, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer)

// One weight traversal for a flat token matrix. Stateful layers receive the
// same resident arena and immutable span/row tables; neither packed activation
// placement nor changing cardinality moves retained state. Only requested
// final span rows reach the vocabulary head. The caller consumes output_count
// IDs; output padding and head grouping are internal to this fixed schedule.
command.program.def public @qwen38_epoch() launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %rows: buffer, %state: buffer, %input_tokens: buffer, %output_tokens: buffer) {
  %tokens = config.get @runner.qwen38.prefill_token_count : index
  %spans = config.get @runner.qwen38.span_capacity : index
  %zero = index.constant 0 : index
  %three = index.constant 3 : index
  %four = index.constant 4 : index
  %padded_spans = index.add %spans, %three : index
  %groups = index.div %padded_spans, %four : index
  %outputs = index.mul %groups, %four : index
  %hidden_row_bytes = index.constant 20480 : offset
  %hidden_bytes = index.scale %outputs, %hidden_row_bytes : index, offset -> offset
  %normalized = buffer.alloca<global> align(256) %hidden_bytes : buffer
  %embedding = command.parameter %parameters, "token_embd.weight" : view<874086400xi8>
  kernel.launch @qwen38_token_embedding_q5k_f32_prefill[%tokens](%input_tokens, %embedding, %residual) : [index](buffer, view<874086400xi8>, buffer)
  // Verification is disabled; its capture binding has no consumers.
  command.program.launch @qwen38_text_prefill_body_impl[%tokens, %tokens, %zero, %spans](%parameters, %residual, %epoch, %state, %state, %normalized, %rows) : [index, index, index, index](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  %epsilon = scalar.constant 0.000001 : f32
  %norm_weight = command.parameter %parameters, "output_norm.weight" : view<5120xf32>
  kernel.launch @qwen38_output_normalize_spans[%outputs](%epoch, %epsilon, %residual, %norm_weight, %normalized) : [index](buffer, f32, buffer, view<5120xf32>, buffer)
  %origin = index.constant 0 : offset
  command.program.launch @qwen38_output_projection_greedy[%outputs, %origin, %origin](%parameters, %normalized, %output_tokens) : [index, offset, offset](buffer, buffer, buffer)
  command.return
}
