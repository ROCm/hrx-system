// Prefills the target model, catches the stored MTP block up over the same
// prompt, and publishes the first target token and normalized hidden carry.
// The target and MTP caches are independent issue-time resources.
command.program.def @qwen38_text_prefill_mtp_greedy_impl(%token_count: index, %schedule_token_count: index) launch(%target_parameters: buffer, %embedding_parameters: buffer, %mtp_input_parameters: buffer, %mtp_layer_parameters: buffer, %residual: buffer, %control: buffer, %gdn_state: buffer, %attention_cache: buffer, %mtp_attention_cache: buffer, %normalized_hidden: buffer, %token_ids: buffer, %progress: buffer) where [range(%token_count, 1, 512), range(%schedule_token_count, 1, 512)] {
  %token_capacity = index.constant 512 : index
  %epsilon = scalar.constant 9.9999999999999995e-07 : f32
  %hidden_capacity_bytes = index.constant 10485760 : offset
  %token_capacity_bytes = index.constant 2048 : offset
  %control_bytes = index.constant 8 : offset
  %hidden_bytes = index.constant 20480 : offset
  %verification_depth = index.constant 0 : index

  %prompt_token_ids = buffer.alloca<global> align(256) %token_capacity_bytes : buffer
  %prefill_control = buffer.alloca<global> align(256) %control_bytes : buffer
  %prior_hidden = buffer.alloca<global> align(256) %hidden_bytes : buffer
  kernel.launch @qwen38_mtp_preserve_prefill_inputs(%token_ids, %control, %normalized_hidden, %prompt_token_ids, %prefill_control, %prior_hidden) : (buffer, buffer, buffer, buffer, buffer, buffer)

  command.program.launch @qwen38_text_prefill_transition[%token_count, %schedule_token_count](%target_parameters, %residual, %control, %gdn_state, %attention_cache, %normalized_hidden, %token_ids, %progress) : [index, index](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)

  %output_norm_weight = command.parameter %target_parameters, "output_norm.weight" : view<5120xf32>
  %normalized_rows = buffer.alloca<global> align(256) %hidden_capacity_bytes : buffer
  %shifted_hidden = buffer.alloca<global> align(256) %hidden_capacity_bytes : buffer
  kernel.launch @qwen38_rmsnorm_f32_prefill[%token_count](%token_capacity, %epsilon, %residual, %output_norm_weight, %normalized_rows) : [index](index, f32, buffer, view<5120xf32>, buffer)
  kernel.launch @qwen38_mtp_shift_hidden_rows[%token_count](%token_capacity, %normalized_rows, %prior_hidden, %shifted_hidden) : [index](index, buffer, buffer, buffer)

  %mtp_residual = buffer.alloca<global> align(256) %hidden_capacity_bytes : buffer
  command.program.launch @qwen38_mtp_catchup[%token_count, %schedule_token_count, %verification_depth](%embedding_parameters, %mtp_input_parameters, %mtp_layer_parameters, %mtp_residual, %prefill_control, %mtp_attention_cache, %shifted_hidden, %prompt_token_ids) : [index, index, index](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}

