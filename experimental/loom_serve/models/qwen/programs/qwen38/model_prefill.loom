command.program.def public @qwen38_text_prefill_body_schedule_c128(%token_count: index) launch(%parameters: buffer, %residual: buffer, %control: buffer, %gdn_state: buffer, %attention_cache: buffer) where [range(%token_count, 481, 512)] {
  %schedule_token_count = index.constant 512 : index
