// Qwen3.8-27B base-model prefill body.
//
// Four schedule-specialized command programs cover every prompt length through
// 512 tokens. Each remains reusable for the dynamic token counts in its range.
// Sixteen fixed architectural groups each advance three Gated DeltaNet layers
// followed by one full-attention layer. Preparation unrolls this model
// structure, specializes every parameter and state ordinal, and aliases the
// nested layer allocations into one transient root.

command.program.decl @qwen38_gdn_layer_prefill(%token_count: index, %schedule_token_count: index, %layer: index, %gdn_ordinal: index, %verification_depth: index, %span_capacity: index) launch(%parameters: buffer, %residual: buffer, %gdn_state: buffer, %control: buffer, %transition_capture: buffer, %rows: buffer) where [range(%token_count, 1, 512), range(%schedule_token_count, 1, 512), range(%layer, 0, 63), range(%gdn_ordinal, 0, 47), range(%verification_depth, 0, 8), range(%span_capacity, 0, 64)]

command.program.decl @qwen38_attention_layer_prefill(%token_count: index, %schedule_token_count: index, %layer: index, %attention_ordinal: index, %verification_depth: index, %span_capacity: index) launch(%parameters: buffer, %residual: buffer, %attention_cache: buffer, %control: buffer, %attention_output: buffer, %rows: buffer) where [range(%token_count, 1, 512), range(%schedule_token_count, 1, 512), range(%layer, 0, 64), range(%attention_ordinal, 0, 15), range(%verification_depth, 0, 8), range(%span_capacity, 0, 64)]

command.program.decl @qwen38_output_head_prefill_greedy_with_hidden() launch(%parameters: buffer, %residual: buffer, %control: buffer, %normalized: buffer, %token_id: buffer)

command.program.decl @qwen38_mtp_catchup(%token_count: index, %schedule_token_count: index, %verification_depth: index) launch(%embedding_parameters: buffer, %mtp_input_parameters: buffer, %mtp_layer_parameters: buffer, %residual: buffer, %control: buffer, %attention_cache: buffer, %shifted_hidden: buffer, %token_ids: buffer) where [range(%token_count, 1, 512), range(%schedule_token_count, 1, 512), range(%verification_depth, 0, 4)]

kernel.decl @qwen38_token_embedding_q5k_f32_prefill(%token_count: index) launch(%token_ids: buffer, %weight: buffer, %output: buffer)

kernel.decl @qwen38_rmsnorm_f32_prefill(%token_count: index) launch(%token_capacity: index, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @qwen38_mtp_shift_hidden_rows(%token_count: index) launch(%token_capacity: index, %normalized_rows: buffer, %pending_hidden: buffer, %shifted_rows: buffer)

kernel.decl @qwen38_mtp_publish_last_hidden(%token_count: index) launch(%control: buffer, %normalized_rows: buffer, %pending_hidden: buffer)

kernel.decl @qwen38_mtp_preserve_prefill_inputs() launch(%token_ids: buffer, %control: buffer, %pending_hidden: buffer, %saved_token_ids: buffer, %saved_control: buffer, %saved_pending_hidden: buffer)

kernel.decl @qwen38_prefill_finish_control() launch(%control: buffer, %token_ids: buffer, %progress: buffer)

kernel.decl @qwen38_capture_feature(%tokens: index) launch(%feature: index, %control: buffer, %residual: buffer, %features: buffer)

// The draft consumes post-residual outputs from layers 5, 19, 33, 47 and 61.
// Layer selection is static program structure; the JIT removes all other taps
// and removes the entire path when feature capture is disabled.
command.program.def @qwen38_capture_layer(%tokens: index, %enabled: index, %layer: index) launch(%control: buffer, %residual: buffer) where [range(%tokens, 1, 512), range(%enabled, 0, 1), range(%layer, 0, 63)] {
  %c0 = index.constant 0 : index
  %c1_2 = index.constant 1 : index
  %c2_2 = index.constant 2 : index
  %c3_2 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c19 = index.constant 19 : index
  %c33 = index.constant 33 : index
  %c47 = index.constant 47 : index
  %c61 = index.constant 61 : index
  %first = index.cmp eq, %layer, %c5 : index
  %second = index.cmp eq, %layer, %c19 : index
  %third = index.cmp eq, %layer, %c33 : index
  %fourth = index.cmp eq, %layer, %c47 : index
  %fifth = index.cmp eq, %layer, %c61 : index
  %pair0 = scalar.ori %first, %second : i1
  %pair1 = scalar.ori %third, %fourth : i1
  %early = scalar.ori %pair0, %pair1 : i1
  %selected = scalar.ori %early, %fifth : i1
  %enabled_bit = index.cmp ne, %enabled, %c0 : index
  %capture = scalar.andi %enabled_bit, %selected : i1
  scf.if %capture {
    %slot1 = scf.select %second, %c1_2, %c0 : index
    %slot2 = scf.select %third, %c2_2, %slot1 : index
    %slot3 = scf.select %fourth, %c3_2, %slot2 : index
    %slot = scf.select %fifth, %c4, %slot3 : index
    %origin = index.constant 10485760 : offset
    %features = buffer.view %residual[%origin] : buffer -> view<[%tokens]x25600xf32>
    kernel.launch @qwen38_capture_feature[%tokens](%slot, %control, %residual, %features) : [index](index, buffer, buffer, view<[%tokens]x25600xf32>)
  }
  command.return
}

// Advances the complete base-model body over the packed token matrix. With
// span_capacity zero, control describes one causal span and rows is unused.
// Otherwise control is an epoch and rows supplies stable resident origins.
// Dense math and layer order are identical; only stateful dispatches change.
command.program.def public @qwen38_text_prefill_body_impl(%token_count: index, %schedule_token_count: index, %verification_depth: index, %span_capacity: index, %capture_features: index) launch(%parameters: buffer, %residual: buffer, %control: buffer, %gdn_state: buffer, %attention_cache: buffer, %transition_capture: buffer, %rows: buffer) where [range(%token_count, 1, 512), range(%schedule_token_count, 1, 512), range(%verification_depth, 0, 8), range(%span_capacity, 0, 64), range(%capture_features, 0, 1)] {
  %group_begin = index.constant 0 : index
  %group_end = index.constant 16 : index
  %group_step = index.constant 1 : index
  %layers_per_group = index.constant 4 : index
  %gdn_layers_per_group = index.constant 3 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index

  // Full-attention layers reuse one maximum-capacity output. Nested layer
  // allocations remain semantic and are packed with it during preparation.
  %attention_bytes = index.constant 12582912 : offset
  %attention_output = buffer.alloca<global> align(256) %attention_bytes : buffer

  scf.for %group = [%group_begin to %group_end step %group_step] unroll {
    %layer0 = index.mul %group, %layers_per_group : index
    %layer1 = index.add %layer0, %c1 : index
    %layer2 = index.add %layer0, %c2 : index
    %attention_layer = index.add %layer0, %c3 : index

    %gdn_ordinal0 = index.mul %group, %gdn_layers_per_group : index
    %gdn_ordinal1 = index.add %gdn_ordinal0, %c1 : index
    %gdn_ordinal2 = index.add %gdn_ordinal0, %c2 : index

    command.program.launch @qwen38_gdn_layer_prefill[%token_count, %schedule_token_count, %layer0, %gdn_ordinal0, %verification_depth, %span_capacity](%parameters, %residual, %gdn_state, %control, %transition_capture, %rows) : [index, index, index, index, index, index](buffer, buffer, buffer, buffer, buffer, buffer)
    command.program.launch @qwen38_capture_layer[%token_count, %capture_features, %layer0](%control, %residual) : [index, index, index](buffer, buffer)
    command.program.launch @qwen38_gdn_layer_prefill[%token_count, %schedule_token_count, %layer1, %gdn_ordinal1, %verification_depth, %span_capacity](%parameters, %residual, %gdn_state, %control, %transition_capture, %rows) : [index, index, index, index, index, index](buffer, buffer, buffer, buffer, buffer, buffer)
    command.program.launch @qwen38_capture_layer[%token_count, %capture_features, %layer1](%control, %residual) : [index, index, index](buffer, buffer)
    command.program.launch @qwen38_gdn_layer_prefill[%token_count, %schedule_token_count, %layer2, %gdn_ordinal2, %verification_depth, %span_capacity](%parameters, %residual, %gdn_state, %control, %transition_capture, %rows) : [index, index, index, index, index, index](buffer, buffer, buffer, buffer, buffer, buffer)
    command.program.launch @qwen38_capture_layer[%token_count, %capture_features, %layer2](%control, %residual) : [index, index, index](buffer, buffer)
    command.program.launch @qwen38_attention_layer_prefill[%token_count, %schedule_token_count, %attention_layer, %group, %verification_depth, %span_capacity](%parameters, %residual, %attention_cache, %control, %attention_output, %rows) : [index, index, index, index, index, index](buffer, buffer, buffer, buffer, buffer, buffer)
    command.program.launch @qwen38_capture_layer[%token_count, %capture_features, %attention_layer](%control, %residual) : [index, index, index](buffer, buffer)
  }
  command.return
}

// Ordinary prefill specializes transition capture away. The small semantic
// allocation keeps the internal body ABI uniform and is removed with its only
// uses before command-program allocation planning.
command.program.def public @qwen38_text_prefill_body(%token_count: index) launch(%parameters: buffer, %residual: buffer, %control: buffer, %gdn_state: buffer, %attention_cache: buffer) where [range(%token_count, 1, 512)] {
  %verification_depth = index.constant 0 : index
  %transition_bytes = index.constant 165376 : offset
  %transition_capture = buffer.alloca<global> align(256) %transition_bytes : buffer
  %capture_features = index.constant 0 : index
  %span_capacity = index.constant 0 : index
  command.program.launch @qwen38_text_prefill_body_impl[%token_count, %token_count, %verification_depth, %span_capacity, %capture_features](%parameters, %residual, %control, %gdn_state, %attention_cache, %transition_capture, %control) : [index, index, index, index, index](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}

