  %schedule_token_count = index.constant 32 : index
  %verification_depth = index.constant 0 : index
  %transition_bytes = index.constant 165376 : offset
  %transition_capture = buffer.alloca<global> align(256) %transition_bytes : buffer
  %capture_features = index.constant 0 : index
  %span_capacity = index.constant 0 : index
  command.program.launch @qwen38_text_prefill_body_impl[%token_count, %schedule_token_count, %verification_depth, %span_capacity, %capture_features](%parameters, %residual, %control, %gdn_state, %attention_cache, %transition_capture, %control) : [index, index, index, index, index](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}

