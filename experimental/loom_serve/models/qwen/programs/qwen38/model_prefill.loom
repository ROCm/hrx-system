// Embeds one prompt span, advances every base-model layer, and publishes the
// first greedy continuation token plus the final normalized hidden row.
command.program.def @qwen38_text_prefill_transition(%token_count: index, %schedule_token_count: index) launch(%parameters: buffer, %residual: buffer, %control: buffer, %gdn_state: buffer, %attention_cache: buffer, %normalized_hidden: buffer, %token_ids: buffer, %progress: buffer) where [range(%token_count, 1, 512), range(%schedule_token_count, 1, 512)] {
  %verification_depth = index.constant 0 : index
  %transition_bytes = index.constant 165376 : offset
  %transition_capture = buffer.alloca<global> align(256) %transition_bytes : buffer
  %embedding_weight = command.parameter %parameters, "token_embd.weight" : view<874086400xi8>
  kernel.launch @qwen38_token_embedding_q5k_f32_prefill[%token_count](%token_ids, %embedding_weight, %residual) : [index](buffer, view<874086400xi8>, buffer)
  %capture_features = index.constant 0 : index
  %span_capacity = index.constant 0 : index
  command.program.launch @qwen38_text_prefill_body_impl[%token_count, %schedule_token_count, %verification_depth, %span_capacity, %capture_features](%parameters, %residual, %control, %gdn_state, %attention_cache, %transition_capture, %control) : [index, index, index, index, index](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.program.launch @qwen38_output_head_prefill_greedy_with_hidden(%parameters, %residual, %control, %normalized_hidden, %token_ids) : (buffer, buffer, buffer, buffer, buffer)
  kernel.launch @qwen38_prefill_finish_control(%control, %token_ids, %progress) : (buffer, buffer, buffer)
  command.return
}

// Advances one non-final prompt chunk without sampling or changing the
// prefill control ABI. The same materialized root can be replayed for every
// complete 512-token chunk while persistent GDN and attention state carry
// across executions.
command.program.def public @qwen38_text_prefill_chunk(%token_count: index) launch(%parameters: buffer, %residual: buffer, %control: buffer, %gdn_state: buffer, %attention_cache: buffer, %token_ids: buffer) where [range(%token_count, 1, 512)] {
  %schedule_token_count = index.constant 512 : index
  %verification_depth = index.constant 0 : index
  %transition_bytes = index.constant 165376 : offset
  %transition_capture = buffer.alloca<global> align(256) %transition_bytes : buffer
  %embedding_weight = command.parameter %parameters, "token_embd.weight" : view<874086400xi8>
  kernel.launch @qwen38_token_embedding_q5k_f32_prefill[%token_count](%token_ids, %embedding_weight, %residual) : [index](buffer, view<874086400xi8>, buffer)
  %capture_features = index.constant 0 : index
  %span_capacity = index.constant 0 : index
  command.program.launch @qwen38_text_prefill_body_impl[%token_count, %schedule_token_count, %verification_depth, %span_capacity, %capture_features](%parameters, %residual, %control, %gdn_state, %attention_cache, %transition_capture, %control) : [index, index, index, index, index](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}

// Advances one complete target and MTP prompt chunk without sampling. The
// target and MTP caches, recurrent state, and normalized-hidden carry become
// the exact inputs to the following chunk or final prefill program.
command.program.def public @qwen38_text_prefill_mtp_chunk(%token_count: index) launch(%target_parameters: buffer, %embedding_parameters: buffer, %mtp_input_parameters: buffer, %mtp_layer_parameters: buffer, %residual: buffer, %control: buffer, %gdn_state: buffer, %attention_cache: buffer, %mtp_attention_cache: buffer, %normalized_hidden: buffer, %token_ids: buffer) where [range(%token_count, 1, 512)] {
  %token_capacity = index.constant 512 : index
  %schedule_token_count = index.constant 512 : index
  %verification_depth = index.constant 0 : index
  %epsilon = scalar.constant 9.9999999999999995e-07 : f32
  %hidden_capacity_bytes = index.constant 10485760 : offset
  %token_capacity_bytes = index.constant 2048 : offset
  %control_bytes = index.constant 8 : offset
  %hidden_bytes = index.constant 20480 : offset
  %transition_bytes = index.constant 165376 : offset

  %prompt_token_ids = buffer.alloca<global> align(256) %token_capacity_bytes : buffer
  %prefill_control = buffer.alloca<global> align(256) %control_bytes : buffer
  %prior_hidden = buffer.alloca<global> align(256) %hidden_bytes : buffer
  kernel.launch @qwen38_mtp_preserve_prefill_inputs(%token_ids, %control, %normalized_hidden, %prompt_token_ids, %prefill_control, %prior_hidden) : (buffer, buffer, buffer, buffer, buffer, buffer)

  %embedding_weight = command.parameter %target_parameters, "token_embd.weight" : view<874086400xi8>
  kernel.launch @qwen38_token_embedding_q5k_f32_prefill[%token_count](%token_ids, %embedding_weight, %residual) : [index](buffer, view<874086400xi8>, buffer)
  %transition_capture = buffer.alloca<global> align(256) %transition_bytes : buffer
  %capture_features = index.constant 0 : index
  %span_capacity = index.constant 0 : index
  command.program.launch @qwen38_text_prefill_body_impl[%token_count, %schedule_token_count, %verification_depth, %span_capacity, %capture_features](%target_parameters, %residual, %control, %gdn_state, %attention_cache, %transition_capture, %control) : [index, index, index, index, index](buffer, buffer, buffer, buffer, buffer, buffer, buffer)

  %output_norm_weight = command.parameter %target_parameters, "output_norm.weight" : view<5120xf32>
  %normalized_rows = buffer.alloca<global> align(256) %hidden_capacity_bytes : buffer
  %shifted_hidden = buffer.alloca<global> align(256) %hidden_capacity_bytes : buffer
  kernel.launch @qwen38_rmsnorm_f32_prefill[%token_count](%token_capacity, %epsilon, %residual, %output_norm_weight, %normalized_rows) : [index](index, f32, buffer, view<5120xf32>, buffer)
  kernel.launch @qwen38_mtp_shift_hidden_rows[%token_count](%token_capacity, %normalized_rows, %prior_hidden, %shifted_hidden) : [index](index, buffer, buffer, buffer)

  %mtp_residual = buffer.alloca<global> align(256) %hidden_capacity_bytes : buffer
  command.program.launch @qwen38_mtp_catchup[%token_count, %schedule_token_count, %verification_depth](%embedding_parameters, %mtp_input_parameters, %mtp_layer_parameters, %mtp_residual, %prefill_control, %mtp_attention_cache, %shifted_hidden, %prompt_token_ids) : [index, index, index](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  kernel.launch @qwen38_mtp_publish_last_hidden[%token_count](%control, %normalized_rows, %normalized_hidden) : [index](buffer, buffer, buffer)
  command.return
}

// Prefills one token span and hands its persistent state directly to ordinary
// decode while keeping the normalized hidden row internal.
command.program.def public @qwen38_text_prefill_greedy(%token_count: index) launch(%parameters: buffer, %residual: buffer, %control: buffer, %gdn_state: buffer, %attention_cache: buffer, %token_ids: buffer, %progress: buffer) where [range(%token_count, 1, 512)] {
  %hidden_bytes = index.constant 20480 : offset
  %normalized_hidden = buffer.alloca<global> align(256) %hidden_bytes : buffer
  command.program.launch @qwen38_text_prefill_transition[%token_count, %token_count](%parameters, %residual, %control, %gdn_state, %attention_cache, %normalized_hidden, %token_ids, %progress) : [index, index](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}

// Prefills one token span while exposing the final normalized target hidden row
