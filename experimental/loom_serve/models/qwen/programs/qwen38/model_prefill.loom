  command.program.launch @qwen38_text_prefill_mtp_greedy_impl[%token_count, %token_count](%target_parameters, %embedding_parameters, %mtp_input_parameters, %mtp_layer_parameters, %residual, %control, %gdn_state, %attention_cache, %mtp_attention_cache, %normalized_hidden, %token_ids, %progress) : [index, index](buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
