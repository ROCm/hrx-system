kernel.decl @qwen38_gdn_conv_spans(%span_capacity: index) launch(%epoch: buffer, %rows: buffer, %layer_origin: offset, %epsilon: f32, %qkv: buffer, %weight: buffer, %state: buffer, %output: buffer, %inverse_norm: buffer)

kernel.decl @qwen38_gdn_recurrent_spans(%span_capacity: index) launch(%epoch: buffer, %rows: buffer, %layer_origin: offset, %qkv: buffer, %inverse_norm: buffer, %alpha: buffer, %beta: buffer, %a: buffer, %bias: buffer, %state: buffer, %output: buffer)

// Replays only accepted speculative transitions into their original resident
// state. The capture holds the dense projections; this never repeats the model
// traversal or copies the full recurrent state. Known spans are absent from
// replay, having published in the target traversal. Scratch and captured rows
// retain original_span*verification_width placement after descriptor compaction.
command.program.def public @qwen38_gdn_commit_layer(%span_capacity: index, %width: index, %layer: index, %ordinal: index) launch(%parameters: buffer, %capture: buffer, %replay: buffer, %rows: buffer, %state: buffer) where [range(%span_capacity, 1, 16), range(%width, 1, 8), range(%layer, 0, 63), range(%ordinal, 0, 47)] {
  %transition_bytes = index.constant 41344 : offset
  %qkv_row_bytes = index.constant 40960 : offset
  %gate_row_bytes = index.constant 192 : offset
  %span_bytes = index.scale %width, %transition_bytes : index, offset -> offset
  %qkv_span_bytes = index.scale %width, %qkv_row_bytes : index, offset -> offset
  %gate_span_bytes = index.scale %width, %gate_row_bytes : index, offset -> offset
  %qkv_channels = index.constant 10240 : index
  %gate_channels = index.constant 48 : index
  %qkv_extent = index.mul %width, %qkv_channels : index
  %gate_extent = index.mul %width, %gate_channels : index
  %layer_bytes = index.scale %span_capacity, %span_bytes : index, offset -> offset
  %alpha_offset = index.scale %span_capacity, %qkv_span_bytes : index, offset -> offset
  %gate_bytes = index.scale %span_capacity, %gate_span_bytes : index, offset -> offset
  %beta_offset = index.add %alpha_offset, %gate_bytes : offset
  %origin = index.scale %ordinal, %layer_bytes : index, offset -> offset
  %alpha_origin = index.add %origin, %alpha_offset : offset
  %beta_origin = index.add %origin, %beta_offset : offset
  %qkv = buffer.view %capture[%origin] : buffer -> view<[%span_capacity]x[%qkv_extent]xf32>
  %alpha = buffer.view %capture[%alpha_origin] : buffer -> view<[%span_capacity]x[%gate_extent]xf32>
  %beta = buffer.view %capture[%beta_origin] : buffer -> view<[%span_capacity]x[%gate_extent]xf32>
  %state_layer_bytes = index.constant 3268608 : offset
  %history_offset = index.constant 3145728 : offset
  %state_origin = index.scale %ordinal, %state_layer_bytes : index, offset -> offset
  %history_origin = index.add %state_origin, %history_offset : offset
  %conv_weight = command.parameter %parameters, "blk.{}.ssm_conv1d.weight"[%layer] : view<40960xf32>
  %a = command.parameter %parameters, "blk.{}.ssm_a"[%layer] : view<48xf32>
  %bias = command.parameter %parameters, "blk.{}.ssm_dt.bias"[%layer] : view<48xf32>
  %qkv_bytes = index.scale %span_capacity, %qkv_span_bytes : index, offset -> offset
  %norm_row_bytes = index.constant 128 : offset
  %output_row_bytes = index.constant 24576 : offset
  %norm_span_bytes = index.scale %width, %norm_row_bytes : index, offset -> offset
  %output_span_bytes = index.scale %width, %output_row_bytes : index, offset -> offset
  %norm_bytes = index.scale %span_capacity, %norm_span_bytes : index, offset -> offset
  %output_bytes = index.scale %span_capacity, %output_span_bytes : index, offset -> offset
  %qkv_silu = buffer.alloca<global> align(256) %qkv_bytes : buffer
  %inverse_norm = buffer.alloca<global> align(256) %norm_bytes : buffer
  %output = buffer.alloca<global> align(256) %output_bytes : buffer
  %epsilon = scalar.constant 9.9999999999999995e-07 : f32
  kernel.launch @qwen38_gdn_conv_spans[%span_capacity](%replay, %rows, %history_origin, %epsilon, %qkv, %conv_weight, %state, %qkv_silu, %inverse_norm) : [index](buffer, buffer, offset, f32, view<[%span_capacity]x[%qkv_extent]xf32>, view<40960xf32>, buffer, buffer, buffer)
  kernel.launch @qwen38_gdn_recurrent_spans[%span_capacity](%replay, %rows, %state_origin, %qkv_silu, %inverse_norm, %alpha, %beta, %a, %bias, %state, %output) : [index](buffer, buffer, offset, buffer, buffer, view<[%span_capacity]x[%gate_extent]xf32>, view<[%span_capacity]x[%gate_extent]xf32>, view<48xf32>, view<48xf32>, buffer, buffer)
  command.return
}

command.program.def public @qwen38_gdn_commit(%span_capacity: index, %width: index) launch(%parameters: buffer, %capture: buffer, %replay: buffer, %rows: buffer, %state: buffer) where [range(%span_capacity, 1, 16), range(%width, 1, 8)] {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %groups = index.constant 16 : index
  scf.for %group = [%c0 to %groups step %c1] unroll {
    %layer0 = index.mul %group, %c4 : index
    %layer1 = index.add %layer0, %c1 : index
    %layer2 = index.add %layer0, %c2 : index
    %ordinal0 = index.mul %group, %c3 : index
    %ordinal1 = index.add %ordinal0, %c1 : index
    %ordinal2 = index.add %ordinal0, %c2 : index
    command.program.launch @qwen38_gdn_commit_layer[%span_capacity, %width, %layer0, %ordinal0](%parameters, %capture, %replay, %rows, %state) : [index, index, index, index](buffer, buffer, buffer, buffer, buffer)
    command.program.launch @qwen38_gdn_commit_layer[%span_capacity, %width, %layer1, %ordinal1](%parameters, %capture, %replay, %rows, %state) : [index, index, index, index](buffer, buffer, buffer, buffer, buffer)
    command.program.launch @qwen38_gdn_commit_layer[%span_capacity, %width, %layer2, %ordinal2](%parameters, %capture, %replay, %rows, %state) : [index, index, index, index](buffer, buffer, buffer, buffer, buffer)
  }
  command.return
}
