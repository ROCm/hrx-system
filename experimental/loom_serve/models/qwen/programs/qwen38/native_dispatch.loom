// CDNA token tiles can share the current layer's packed weights in cache.
template.def<@qwen38.prefill.projection_schedule> target(@qwen38_dispatch_cdna) @qwen38_prefill_projection_schedule_cdna(%tokens: index) -> (index) {
  %tile = index.constant 64 : index
  %wide = index.cmp ugt, %tokens, %tile : index
  %schedule = scf.select %wide, %tile, %tokens : index
  template.return %schedule : index
}

