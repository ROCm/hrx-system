// Wide CDNA epochs amortize one Q8 activation panel across both FFN weights.
// Smaller cohorts retain their existing floating-point or integer recipes.
template.def<@qwen38.prefill.integer_ffn> target(@qwen38_dispatch_cdna) @qwen38_prefill_integer_ffn_cdna(%tokens: index) -> (i1) {
  %wide = index.constant 512 : index
  %enabled = index.cmp uge, %tokens, %wide : index
