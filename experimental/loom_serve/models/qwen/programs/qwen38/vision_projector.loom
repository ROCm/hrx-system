config.def @qwen38.vision.image_count = 1 : %value: index where [range(%value, 1, 4)]

config.decl @qwen38.vision.image_height : %value: index where [range(%value, 32, 4096), multiple_of(%value, 32)]

config.decl @qwen38.vision.image_width : %value: index where [range(%value, 32, 4096), multiple_of(%value, 32)]

kernel.decl @qwen38_vision_patch_embedding() launch(%source_offset: offset, %source: buffer, %weight0: buffer, %weight1: buffer, %bias: buffer, %output: buffer)

kernel.decl @qwen38_vision_position_layernorm_statistics() launch(%position_table: buffer, %residual: buffer, %statistics: buffer)

kernel.decl @qwen38_vision_statistics() launch(%residual: buffer, %statistics: buffer)

kernel.decl @qwen38_vision_key_value_cohort(%cohort: index) launch(%cohort_argument: index, %residual: buffer, %statistics: buffer, %layernorm_weight: buffer, %layernorm_bias: buffer, %qkv_weight: buffer, %qkv_bias: buffer, %key: buffer, %value: buffer) where [range(%cohort_argument, 0, 3)]

kernel.decl @qwen38_vision_attention_cohort(%cohort: index) launch(%cohort_argument: index, %residual: buffer, %statistics: buffer, %layernorm_weight: buffer, %layernorm_bias: buffer, %qkv_weight: buffer, %qkv_bias: buffer, %key: buffer, %value: buffer, %output_weight: buffer, %output_bias: buffer, %output: buffer) where [range(%cohort_argument, 0, 3)]

kernel.decl @qwen38_vision_attention_output() launch(%context: buffer, %weight: buffer, %bias: buffer, %residual: buffer, %output: buffer)

kernel.decl @qwen38_vision_ffn_up() launch(%residual: buffer, %statistics: buffer, %layernorm_weight: buffer, %layernorm_bias: buffer, %up_weight: buffer, %up_bias: buffer, %activation: buffer)

kernel.decl @qwen38_vision_ffn_down() launch(%activation: buffer, %down_weight: buffer, %down_bias: buffer, %residual: buffer)

kernel.decl @qwen38_vision_layernorm_apply() launch(%residual: buffer, %statistics: buffer, %weight: buffer, %bias: buffer, %output: buffer)

kernel.decl @qwen38_vision_merger_up() launch(%input: buffer, %weight: buffer, %bias: buffer, %activation: buffer)

kernel.decl @qwen38_vision_merger_down() launch(%activation: buffer, %weight: buffer, %bias: buffer, %output: buffer)

template.decl @qwen38_vision_block(%layer: index, %rows: index, %parameters: buffer, %input: view<[%rows]x1152xf32>, %output: view<[%rows]x1152xf32>, %statistics: buffer, %context: view<[%rows]x1152xf16>, %key: view<[%rows]x288xf16>, %value: view<288x[%rows]xf16>, %activation: buffer)

// Statistics for the input are prepared by the caller. Block zero reuses the
// position-add reduction; later blocks run the ordinary statistics kernel.
template.def<@qwen38_vision_block> @qwen38_vision_block_impl(%layer: index, %rows: index, %parameters: buffer, %input: view<[%rows]x1152xf32>, %output: view<[%rows]x1152xf32>, %statistics: buffer, %context: view<[%rows]x1152xf16>, %key: view<[%rows]x288xf16>, %value: view<288x[%rows]xf16>, %activation: buffer) {
  %ln1_weight = command.parameter %parameters, "v.blk.{}.ln1.weight"[%layer] : view<1152xf32>
  %ln1_bias = command.parameter %parameters, "v.blk.{}.ln1.bias"[%layer] : view<1152xf32>
  %qkv_weight = command.parameter %parameters, "v.blk.{}.attn_qkv.weight"[%layer] : view<3456x1152xf16>
  %qkv_bias = command.parameter %parameters, "v.blk.{}.attn_qkv.bias"[%layer] : view<3456xf32>
  %attention_weight = command.parameter %parameters, "v.blk.{}.attn_out.weight"[%layer] : view<1152x1152xf16>
  %attention_bias = command.parameter %parameters, "v.blk.{}.attn_out.bias"[%layer] : view<1152xf32>
  %ln2_weight = command.parameter %parameters, "v.blk.{}.ln2.weight"[%layer] : view<1152xf32>
  %ln2_bias = command.parameter %parameters, "v.blk.{}.ln2.bias"[%layer] : view<1152xf32>
  %up_weight = command.parameter %parameters, "v.blk.{}.ffn_up.weight"[%layer] : view<4304x1152xf16>
  %up_bias = command.parameter %parameters, "v.blk.{}.ffn_up.bias"[%layer] : view<4304xf32>
  %down_weight = command.parameter %parameters, "v.blk.{}.ffn_down.weight"[%layer] : view<1152x4304xf16>
  %down_bias = command.parameter %parameters, "v.blk.{}.ffn_down.bias"[%layer] : view<1152xf32>

  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  scf.for %cohort = [%c0 to %c4 step %c1] unroll {
    kernel.launch @qwen38_vision_key_value_cohort[%cohort](%cohort, %input, %statistics, %ln1_weight, %ln1_bias, %qkv_weight, %qkv_bias, %key, %value) : [index](index, view<[%rows]x1152xf32>, buffer, view<1152xf32>, view<1152xf32>, view<3456x1152xf16>, view<3456xf32>, view<[%rows]x288xf16>, view<288x[%rows]xf16>)
    kernel.launch @qwen38_vision_attention_cohort[%cohort](%cohort, %input, %statistics, %ln1_weight, %ln1_bias, %qkv_weight, %qkv_bias, %key, %value, %attention_weight, %attention_bias, %context) : [index](index, view<[%rows]x1152xf32>, buffer, view<1152xf32>, view<1152xf32>, view<3456x1152xf16>, view<3456xf32>, view<[%rows]x288xf16>, view<288x[%rows]xf16>, view<1152x1152xf16>, view<1152xf32>, view<[%rows]x1152xf16>)
  }
  kernel.launch @qwen38_vision_attention_output(%context, %attention_weight, %attention_bias, %input, %output) : (view<[%rows]x1152xf16>, view<1152x1152xf16>, view<1152xf32>, view<[%rows]x1152xf32>, view<[%rows]x1152xf32>)
  kernel.launch @qwen38_vision_statistics(%output, %statistics) : (view<[%rows]x1152xf32>, buffer)
  kernel.launch @qwen38_vision_ffn_up(%output, %statistics, %ln2_weight, %ln2_bias, %up_weight, %up_bias, %activation) : (view<[%rows]x1152xf32>, buffer, view<1152xf32>, view<1152xf32>, view<4304x1152xf16>, view<4304xf32>, buffer)
  kernel.launch @qwen38_vision_ffn_down(%activation, %down_weight, %down_bias, %output) : (buffer, view<1152x4304xf16>, view<1152xf32>, view<[%rows]x1152xf32>)
  template.return
}

// One command projects an exact cohort at the source-selected geometry. Each
// image's output range doubles as its transformer residual bank, overwritten by
// merger only after post-normalization has moved its input to scratch.
// All images reuse one residual/statistics/activation workspace. This bounds
// temporary storage independently of the cohort size; disjoint final rows stay
// live for the downstream language consumer.
command.program.def public @qwen38_vision_projector() launch(%parameters: buffer, %input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %header_bytes = index.constant 64 : offset
  %c4 = index.constant 4 : index
  %c16 = index.constant 16 : index
  %image_height = config.get @qwen38.vision.image_height : index
  %image_width = config.get @qwen38.vision.image_width : index
  %patch_height = index.div %image_height, %c16 : index
  %patch_width = index.div %image_width, %c16 : index
  %rows = index.mul %patch_height, %patch_width : index
  %merged_rows = index.div %rows, %c4 : index
  %pixels = index.mul %image_height, %image_width : index
  %pixel_stride = index.constant 3 : offset
  %pixel_bytes = index.scale %pixels, %pixel_stride : index, offset -> offset
  %input_stride = index.add %header_bytes, %pixel_bytes : offset
  %feature_stride = index.constant 20480 : offset
  %output_stride = index.scale %merged_rows, %feature_stride : index, offset -> offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %image_count = config.get @qwen38.vision.image_count : index
  %context_row_bytes = index.constant 2304 : offset
  %context_key_row_bytes = index.constant 2880 : offset
  %residual_row_bytes = index.constant 4608 : offset
  %statistics_row_bytes = index.constant 8 : offset
  %activation_row_bytes = index.constant 8608 : offset
  %key_offset = index.scale %rows, %context_row_bytes : index, offset -> offset
  %value_offset = index.scale %rows, %context_key_row_bytes : index, offset -> offset
  %residual_bytes = index.scale %rows, %residual_row_bytes : index, offset -> offset
  %statistics_bytes = index.scale %rows, %statistics_row_bytes : index, offset -> offset
  %activation_bytes = index.scale %rows, %activation_row_bytes : index, offset -> offset
  %state = buffer.alloca<global> align(256) %residual_bytes : buffer
  %statistics = buffer.alloca<global> align(256) %statistics_bytes : buffer
  %activation = buffer.alloca<global> align(256) %activation_bytes : buffer
  %state_view = buffer.view %state[%origin] : buffer -> view<[%rows]x1152xf32>
  %context = buffer.view %activation[%origin] : buffer -> view<[%rows]x1152xf16>
  %key = buffer.view %activation[%key_offset] : buffer -> view<[%rows]x288xf16>
  %value = buffer.view %activation[%value_offset] : buffer -> view<288x[%rows]xf16>

  scf.for %image = [%c0 to %image_count step %c1] unroll {
    %input_offset = index.scale %image, %input_stride : index, offset -> offset
    %pixel_offset = index.add %input_offset, %header_bytes : offset
    %output_offset = index.scale %image, %output_stride : index, offset -> offset
    %output_view = buffer.view %output[%output_offset] : buffer -> view<[%rows]x1152xf32>
    %result_view = buffer.view %output[%output_offset] : buffer -> view<[%merged_rows]x5120xf32>
    %patch_weight0 = command.parameter %parameters, "v.patch_embd.weight" : view<1152x768xf16>
    %patch_weight1 = command.parameter %parameters, "v.patch_embd.weight.1" : view<1152x768xf16>
    %patch_bias = command.parameter %parameters, "v.patch_embd.bias" : view<1152xf32>
    %position = command.parameter %parameters, "v.position_embd.weight" : view<2304x1152xf32>
    kernel.launch @qwen38_vision_patch_embedding(%pixel_offset, %input, %patch_weight0, %patch_weight1, %patch_bias, %state) : (offset, buffer, view<1152x768xf16>, view<1152x768xf16>, view<1152xf32>, buffer)
    kernel.launch @qwen38_vision_position_layernorm_statistics(%position, %state, %statistics) : (view<2304x1152xf32>, buffer, buffer)

    %layer0 = index.constant 0 : index
    template.apply<@qwen38_vision_block>(%layer0, %rows, %parameters, %state_view, %output_view, %statistics, %context, %key, %value, %activation) : (index, index, buffer, view<[%rows]x1152xf32>, view<[%rows]x1152xf32>, buffer, view<[%rows]x1152xf16>, view<[%rows]x288xf16>, view<288x[%rows]xf16>, buffer)
    %c2 = index.constant 2 : index
    %c27 = index.constant 27 : index
    scf.for %odd_layer = [%c1 to %c27 step %c2] unroll {
      kernel.launch @qwen38_vision_statistics(%output_view, %statistics) : (view<[%rows]x1152xf32>, buffer)
      template.apply<@qwen38_vision_block>(%odd_layer, %rows, %parameters, %output_view, %state_view, %statistics, %context, %key, %value, %activation) : (index, index, buffer, view<[%rows]x1152xf32>, view<[%rows]x1152xf32>, buffer, view<[%rows]x1152xf16>, view<[%rows]x288xf16>, view<288x[%rows]xf16>, buffer)
      %even_layer = index.add %odd_layer, %c1 : index
      kernel.launch @qwen38_vision_statistics(%state, %statistics) : (buffer, buffer)
      template.apply<@qwen38_vision_block>(%even_layer, %rows, %parameters, %state_view, %output_view, %statistics, %context, %key, %value, %activation) : (index, index, buffer, view<[%rows]x1152xf32>, view<[%rows]x1152xf32>, buffer, view<[%rows]x1152xf16>, view<[%rows]x288xf16>, view<288x[%rows]xf16>, buffer)
    }

    %postnorm_weight = command.parameter %parameters, "v.post_ln.weight" : view<1152xf32>
    %postnorm_bias = command.parameter %parameters, "v.post_ln.bias" : view<1152xf32>
    kernel.launch @qwen38_vision_statistics(%output_view, %statistics) : (view<[%rows]x1152xf32>, buffer)
    kernel.launch @qwen38_vision_layernorm_apply(%output_view, %statistics, %postnorm_weight, %postnorm_bias, %state) : (view<[%rows]x1152xf32>, buffer, view<1152xf32>, view<1152xf32>, buffer)

    %merger_up_weight = command.parameter %parameters, "mm.0.weight" : view<4608x4608xf16>
    %merger_up_bias = command.parameter %parameters, "mm.0.bias" : view<4608xf32>
    %merger_down_weight = command.parameter %parameters, "mm.2.weight" : view<5120x4608xf16>
    %merger_down_bias = command.parameter %parameters, "mm.2.bias" : view<5120xf32>
    kernel.launch @qwen38_vision_merger_up(%state, %merger_up_weight, %merger_up_bias, %activation) : (buffer, view<4608x4608xf16>, view<4608xf32>, buffer)
    kernel.launch @qwen38_vision_merger_down(%activation, %merger_down_weight, %merger_down_bias, %result_view) : (buffer, view<5120x4608xf16>, view<5120xf32>, view<[%merged_rows]x5120xf32>)
  }
  command.return
}
