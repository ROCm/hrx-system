// A mixed input record is eight u32 words: token ID, device feature offset,
// temporal/height/width rotary coordinates, following source frontier, and two
// reserved words. Zero feature offset selects the ordinary embedding table.
// Feature offsets are absolute within the immutable invocation packet, so
// continuation compaction moves records without moving their projected rows.
// Ordinary epochs retain their four-byte token array.
//
// A row-major rectangular grid advances the source frontier to one past the
// maximum consumed coordinate. Its width comes from the source-owned image
// metadata. The complete-image row index recovers the same base across epoch
// boundaries, including tall grids whose later rows advance the frontier again.
func.def @image_source_frontier(%consumed: i32, %width: i32) -> (i32) {
  %one = scalar.constant 1 : i32
  %bias = scalar.subi %width, %one : i32
  %rounded = scalar.addi %consumed, %bias : i32
  %height_frontier = scalar.divui %rounded, %width : i32
  %width_frontier = scalar.minui %consumed, %width : i32
  %frontier = scalar.maxui %height_frontier, %width_frontier : i32
  func.return %frontier : i32
}

func.def public @encode_media_plan(%plan: buffer, %inputs: buffer, %media_plan: buffer, %media_begin: index, %media_end: index, %count: index, %first: index, %metadata: buffer, %tokens: buffer, %packet_begin: index) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %descriptor_origin = index.constant 12 : offset
  %requests = buffer.view %plan[%origin] : buffer -> view<32x9xi32>
  %descriptors = buffer.view %metadata[%descriptor_origin] : buffer -> view<64x5xi32>
  %ids = buffer.view %inputs[%origin] : buffer -> view<1024xi32>
  %media = buffer.view %media_plan[%origin] : buffer -> view<[%media_end]x7xi32>
  %records = buffer.view %tokens[%origin] : buffer -> view<1024x8xi32>
  %token_placeholder = scalar.constant 0 : i32
  %position_step = scalar.constant 1 : i32
  %merged_patch = scalar.constant 32 : i32
  %primary = index.cmp eq, %first, %c0 : index
  %last_input, %last_media = scf.for %span = [%c0 to %count step %c1](%begin = %packet_begin : index, %media_cursor = %media_begin : index) -> (index, index) {
    %plan_index_value = index.add %first, %span : index
    %plan_index = index.assume %plan_index_value [range(%plan_index_value, 0, 31)] : index
    %length_word = view.load %requests[%plan_index, 0] : view<32x9xi32> -> i32
    %input_begin = view.load %requests[%plan_index, 4] : view<32x9xi32> -> i32
    %input_count = view.load %requests[%plan_index, 5] : view<32x9xi32> -> i32
    %source_position = scf.if %primary -> (i32) {
      %position = view.load %requests[%plan_index, 2] : view<32x9xi32> -> i32
      scf.yield %position : i32
    } else {
      // A known continuation follows the complete first span. Speculative
      // acceptance replaces its provisional coordinates on the device.
      %first_word = view.load %requests[%plan_index, 8] : view<32x9xi32> -> i32
      %first_value = index.cast %first_word : i32 to index
      %first_span = index.assume %first_value [range(%first_value, 0, 15)] : index
      %first_begin = view.load %descriptors[%first_span, 2] : view<64x5xi32> -> i32
      %first_length = view.load %descriptors[%first_span, 0] : view<64x5xi32> -> i32
      %first_end = scalar.addi %first_begin, %first_length : i32
      %last_word = scalar.subi %first_end, %position_step : i32
      %last_value = index.cast %last_word : i32 to index
      %last = index.assume %last_value [range(%last_value, 0, 511)] : index
      %position = view.load %records[%last, 5] : view<1024x8xi32> -> i32
      scf.yield %position : i32
    }
    %length_value = index.cast %length_word : i32 to index
    %length = index.assume %length_value [range(%length_value, 1, 512)] : index
    %next_source, %next_media = scf.for %relative = [%c0 to %length step %c1](%source = %source_position : i32, %cursor = %media_cursor : index) -> (i32, index) {
      %relative_word = index.cast %relative : index to i32
      %record_value = index.add %begin, %relative : index
      %record = index.assume %record_value [range(%record_value, 0, 1023)] : index
      %known = scalar.cmpi ult, %relative_word, %input_count : i32
      %id = scf.if %known -> (i32) {
        %input_word = scalar.addi %input_begin, %relative_word : i32
        %input_value = index.cast %input_word : i32 to index
        %input = index.assume %input_value [range(%input_value, 0, 1023)] : index
        %id = view.load %ids[%input] : view<1024xi32> -> i32
        scf.yield %id : i32
      } else {
        scf.yield %token_placeholder : i32
      }
      view.store %id, %records[%record, 0] : i32, view<1024x8xi32>
      %has_media = index.cmp ult, %cursor, %media_end : index
      %is_media = scf.if %has_media -> (i1) {
        %media_index = index.assume %cursor [range(%cursor, 0, 1023), lt(%cursor, %media_end)] : index
        %owner = view.load %media[%media_index, 0] : view<[%media_end]x7xi32> -> i32
        %offset = view.load %media[%media_index, 1] : view<[%media_end]x7xi32> -> i32
        %plan_word = index.cast %plan_index : index to i32
        %same_span = scalar.cmpi eq, %owner, %plan_word : i32
        %same_input = scalar.cmpi eq, %offset, %relative_word : i32
        %matches = scalar.andi %same_span, %same_input : i1
        scf.yield %matches : i1
      } else {
        %false = scalar.constant false : i1
        scf.yield %false : i1
      }
      %following, %following_media = scf.if %is_media -> (i32, index) {
        %media_index = index.assume %cursor [range(%cursor, 0, 1023), lt(%cursor, %media_end)] : index
        %feature_offset = view.load %media[%media_index, 2] : view<[%media_end]x7xi32> -> i32
        %feature_index = view.load %media[%media_index, 6] : view<[%media_end]x7xi32> -> i32
        %image_metadata_word = view.load %media[%media_index, 4] : view<[%media_end]x7xi32> -> i32
        %image_metadata_offset = index.cast %image_metadata_word : i32 to offset
        %image_metadata = buffer.view %media_plan[%image_metadata_offset] : buffer -> view<2xi32>
        %image_width = view.load %image_metadata[0] : view<2xi32> -> i32
        %grid_extent = scalar.divui %image_width, %merged_patch : i32
        %prefix_extent = func.call @image_source_frontier(%feature_index, %grid_extent) : (i32, i32) -> (i32)
        %base = scalar.subi %source, %prefix_extent : i32
        %height = scalar.divui %feature_index, %grid_extent : i32
        %width = scalar.remui %feature_index, %grid_extent : i32
        %height_position = scalar.addi %base, %height : i32
        %width_position = scalar.addi %base, %width : i32
        %consumed = scalar.addi %feature_index, %position_step : i32
        %suffix_extent = func.call @image_source_frontier(%consumed, %grid_extent) : (i32, i32) -> (i32)
        %advance = scalar.subi %suffix_extent, %prefix_extent : i32
        %following = scalar.addi %source, %advance : i32
        view.store %feature_offset, %records[%record, 1] : i32, view<1024x8xi32>
        view.store %base, %records[%record, 2] : i32, view<1024x8xi32>
        view.store %height_position, %records[%record, 3] : i32, view<1024x8xi32>
        view.store %width_position, %records[%record, 4] : i32, view<1024x8xi32>
        %following_media = index.add %cursor, %c1 : index
        scf.yield %following, %following_media : i32, index
      } else {
        view.store %source, %records[%record, 2] : i32, view<1024x8xi32>
        view.store %source, %records[%record, 3] : i32, view<1024x8xi32>
        view.store %source, %records[%record, 4] : i32, view<1024x8xi32>
        %following = scalar.addi %source, %position_step : i32
        scf.yield %following, %cursor : i32, index
      }
      view.store %following, %records[%record, 5] : i32, view<1024x8xi32>
      scf.yield %following, %following_media : i32, index
    }
    %next_begin = index.add %begin, %length : index
    scf.yield %next_begin, %next_media : index, index
  }
  func.return
}

// Media-bearing spans are known inputs and therefore consumed in full. The
// publication pass already advanced by consumed inputs; subtract only image
// rows whose rotary frontier does not advance. Continuation records retain
// first-plan ownership even when device compaction changes result slots.
func.def public @publish_media_positions(%plan: buffer, %media_plan: buffer, %count: index, %progress: buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c16 = index.constant 16 : index
  %position_step = scalar.constant 1 : i32
  %merged_patch = scalar.constant 32 : i32
  %requests = buffer.view %plan[%origin] : buffer -> view<32x9xi32>
  %media = buffer.view %media_plan[%origin] : buffer -> view<[%count]x7xi32>
  %published = buffer.view %progress[%origin] : buffer -> view<16x21xi32>
  scf.for %i = [%c0 to %count step %c1] {
    %feature_index = view.load %media[%i, 6] : view<[%count]x7xi32> -> i32
    %image_metadata_word = view.load %media[%i, 4] : view<[%count]x7xi32> -> i32
    %image_metadata_offset = index.cast %image_metadata_word : i32 to offset
    %image_metadata = buffer.view %media_plan[%image_metadata_offset] : buffer -> view<2xi32>
    %image_width = view.load %image_metadata[0] : view<2xi32> -> i32
    %grid_extent = scalar.divui %image_width, %merged_patch : i32
    %prefix_extent = func.call @image_source_frontier(%feature_index, %grid_extent) : (i32, i32) -> (i32)
    %consumed = scalar.addi %feature_index, %position_step : i32
    %suffix_extent = func.call @image_source_frontier(%consumed, %grid_extent) : (i32, i32) -> (i32)
    %compressed = scalar.cmpi eq, %prefix_extent, %suffix_extent : i32
    scf.if %compressed {
      %plan_word = view.load %media[%i, 0] : view<[%count]x7xi32> -> i32
      %plan_value = index.cast %plan_word : i32 to index
      %plan_index = index.assume %plan_value [range(%plan_value, 0, 31)] : index
      %primary = index.cmp ult, %plan_index, %c16 : index
      %owner = scf.if %primary -> (index) {
        scf.yield %plan_index : index
      } else {
        %first_word = view.load %requests[%plan_index, 8] : view<32x9xi32> -> i32
        %first = index.cast %first_word : i32 to index
        scf.yield %first : index
      }
      %slot = index.assume %owner [range(%owner, 0, 15)] : index
      %position = view.load %published[%slot, 4] : view<16x21xi32> -> i32
      %corrected = scalar.subi %position, %position_step : i32
      view.store %corrected, %published[%slot, 4] : i32, view<16x21xi32>
    }
  }
  func.return
}
