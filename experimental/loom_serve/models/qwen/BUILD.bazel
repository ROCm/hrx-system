loom_test(
    name = "output_projection_test",
    srcs = [
        "kernels/qwen38/output_projection.loom",
        "tests/output_projection.loom",
        "//experimental/loom_serve/motifs/ggml:sources",
    ],
    benchmark_smoke = False,
    configs = {
        "ggml.linear_q6k_q8_1_x4.output_capacity": "248320",
        "ggml.linear_q6k_q8_1_x4.token_capacity": "512",
        "ggml.quantize_q8_1_x4.group_capacity": "69632",
    },
    execution_profiles = [
        AMDGPU_HARDWARE_PROFILE,
        amdgpu_execution_profile(
            name = "amdgpu_access_trap",
            runner_args = [
                "--sanitizer=access",
                "--sanitizer-reporting=trap",
            ],
            tags = ["notsan"],
        ),
    ],
    variants = {
        "live_prefix": {"case": "@output_projection_live_prefix_case"},
        "m32": {"case": "@output_projection_m32_case"},
        "m8": {"case": "@output_projection_m8_case"},
    },
)

