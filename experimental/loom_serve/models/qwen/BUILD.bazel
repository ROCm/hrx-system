)

# Shared chat, sampling, and packed-epoch policy for Qwen model families.
filegroup(
    name = "text_control",
    srcs = [
        "control.loom",
        "epoch_control.loom",
        "epoch_media.loom",
        "vision_geometry.loom",
    ],
    visibility = ["//visibility:public"],
)

# Device acceptance, proposal, and continuation share the packed scheduler ABI.
_SPECULATION_KERNEL_SOURCES = [
    "kernels/qwen38/accept.loom",
    "kernels/qwen38/continuation.loom",
    "kernels/qwen38/inputs.loom",
    "kernels/qwen38/mtp_proposal.loom",
    "kernels/qwen38/spans.loom",
]

filegroup(
    name = "speculation_kernels",
    srcs = _SPECULATION_KERNEL_SOURCES,
    visibility = ["//visibility:public"],
)

loom_library(
    name = "speculation_library",
    srcs = _SPECULATION_KERNEL_SOURCES,
    visibility = ["//visibility:public"],
)

