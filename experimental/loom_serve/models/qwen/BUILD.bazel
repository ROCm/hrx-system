load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_binary", "loom_cc_test", "loom_config_compatible_with")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

filegroup(
    name = "sources",
    srcs = [
        "sources.txt",
        "//experimental/loom_serve/motifs/ggml:sources",
    ] + glob([
        "*.loom",
        "kernels/qwen38/*.loom",
        "programs/qwen38/*.loom",
    ]),
    visibility = ["//visibility:public"],
)

loom_cc_test(
    name = "weights_test",
    srcs = ["weights_test.cc"],
    args = ["--policy_source=$(rootpath :weights.loom)"],
    data = ["weights.loom"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:vm",
    ]),
    deps = [
        "//experimental/loom_serve/runtime:program",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/tooling:flags",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
        "//runtime/src/iree/vm",
    ],
)

loom_cc_test(
    name = "prepare_test",
    srcs = ["prepare_test.cc"],
    args = ["--prepare_source=$(rootpath :prepare.loom)"],
    data = ["prepare.loom"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:vm",
        "//runtime/config/hal:driver_amdgpu",
    ]),
    deps = [
        "//experimental/loom_serve/runtime:preparation",
        "//experimental/loom_serve/scheduling:packing",
        "//experimental/loom_serve/text:model",
        "//experimental/loom_serve/text:schedule",
        "//loom/binding/c:loomc",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/tooling:flags",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
        "//runtime/src/iree/vm",
    ],
)

