load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")
load("//loom/build_tools/bazel:defs.bzl", "loom_library", "loom_test")
load("//loom/src/loom/tooling/target/spirv:execution_profiles.bzl", "SPIRV_VULKAN_HARDWARE_PROFILE")
load("//loom/target/amdgpu:execution_profiles.bzl", "AMDGPU_ACCESS_PROFILE", "AMDGPU_HARDWARE_PROFILE", "amdgpu_execution_profile")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

# Shared chat, sampling, and packed-epoch policy for Qwen model families.
filegroup(
    name = "text_control",
    srcs = ["control.loom"],
    visibility = ["//visibility:public"],
)

# Device acceptance and proposal packets share the packed text scheduler ABI.
filegroup(
    name = "speculation_kernels",
    srcs = [
        "kernels/qwen38/accept.loom",
        "kernels/qwen38/mtp_proposal.loom",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "sources",
    srcs = [
        "model.json",
        ":text_control",
        "//experimental/loom_serve/motifs/ggml:sources",
        "//experimental/loom_serve/motifs/tensor:sources",
    ] + glob(
        [
            "*.loom",
            "kernels/qwen38/*.loom",
            "programs/qwen38/*.loom",
        ],
        exclude = ["control.loom"],
    ),
    visibility = ["//visibility:public"],
)

loom_test(
    name = "sampling_test",
    srcs = [
        "kernels/qwen38/sampling.loom",
        "tests/sampling.loom",
        "//experimental/loom_serve/motifs/tensor:sources",
    ],
    benchmark_smoke = False,
    execution_profiles = [
        AMDGPU_HARDWARE_PROFILE,
        AMDGPU_ACCESS_PROFILE,
    ],
)

loom_library(
    name = "projection_kernels",
    srcs = [
        "kernels/qwen38/ffn_gate_up_q5k_f16_wmma_wave32.loom",
        "kernels/qwen38/layer_prefill.loom",
        "kernels/qwen38/linear_q4k_f16_wmma.loom",
        "kernels/qwen38/linear_q5k_f16_wmma.loom",
        "kernels/qwen38/linear_q5k_f16_wmma_wave32.loom",
        "kernels/qwen38/linear_q6k_f16_wmma.loom",
        "kernels/qwen38/linear_q6k_f16_wmma_metadata.loom",
        "//experimental/loom_serve/motifs/ggml:sources",
    ],
)

loom_library(
    name = "vision_kernels",
    srcs = [
        "kernels/qwen38/vision_attention.loom",
        "kernels/qwen38/vision_ffn.loom",
        "kernels/qwen38/vision_key_value.loom",
        "kernels/qwen38/vision_merger.loom",
        "kernels/qwen38/vision_normalization.loom",
        "kernels/qwen38/vision_patch_embedding.loom",
    ],
)

loom_library(
    name = "vision_projector",
    srcs = ["programs/qwen38/vision_projector.loom"],
    deps = [":vision_kernels"],
)

loom_test(
    name = "vision_execution_test",
    srcs = ["tests/vision_projector.loom"],
    benchmark_smoke = False,
    configs = {
        "qwen38.vision.image_height": "256",
        "qwen38.vision.image_width": "256",
    },
    execution_profiles = [
        AMDGPU_HARDWARE_PROFILE,
        AMDGPU_ACCESS_PROFILE,
    ],
    deps = [":vision_kernels"],
)

