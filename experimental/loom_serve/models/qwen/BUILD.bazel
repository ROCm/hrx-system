filegroup(
    name = "sources",
    srcs = [
        "model.json",
        ":text_control",
        "//experimental/loom_serve/motifs/ggml:sources",
        "//experimental/loom_serve/motifs/tensor:sources",
    ] + glob(
        [
            "*.loom",
            "kernels/qwen38/*.loom",
            "programs/qwen38/*.loom",
