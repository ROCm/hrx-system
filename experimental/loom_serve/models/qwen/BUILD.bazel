# Link entry programs against separate providers, as registration does. Merging
# their source files would hide missing exports at these ownership boundaries.
loom_module(
    name = "request_control",
    srcs = ["control.loom"],
    include_input_exports = True,
    libraries = [":vision_geometry_library"],
    mode = "link",
    output_format = "bc",
)

