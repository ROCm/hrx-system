config.decl @runner.qwen38.prefill_token_count : %value: index where [range(%value, 1, 512)]

config.decl @runner.qwen38.span_capacity : %value: index where [range(%value, 1, 16)]

config.def @runner.qwen38.verification_width = 4 : index

config.decl @runner.qwen38.capture_features : index

command.program.decl @qwen38_text_prefill_body_impl(%token_count: index, %schedule_token_count: index, %verification_depth: index, %span_capacity: index, %capture_features: index) launch(%parameters: buffer, %residual: buffer, %control: buffer, %gdn_state: buffer, %attention_cache: buffer, %transition_capture: buffer, %rows: buffer) where [range(%token_count, 1, 512), range(%schedule_token_count, 1, 512), range(%verification_depth, 0, 8), range(%span_capacity, 0, 64), range(%capture_features, 0, 1)]

command.program.decl @qwen38_output_projection_sampled(%token_count: index) launch(%parameters: buffer, %epoch: buffer, %normalized: buffer, %token_ids: buffer) where [range(%token_count, 1, 128)]

command.program.decl @qwen38_gdn_commit(%span_capacity: index, %width: index) launch(%parameters: buffer, %capture: buffer, %replay: buffer, %rows: buffer, %state: buffer) where [range(%span_capacity, 1, 16), range(%width, 1, 8)]

kernel.decl @qwen38_token_embedding_q5k_f32_prefill(%token_count: index) launch(%token_ids: buffer, %weight: buffer, %output: buffer)

kernel.decl @qwen38_output_normalize_spans(%output_capacity: index) launch(%epoch: buffer, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @qwen38_accept_spans() launch(%width: index, %epoch: buffer, %inputs: buffer, %predictions: buffer, %committed: buffer, %replay: buffer, %results: buffer)

// Mixed known and speculative spans share the ordinary target token shape.
// GDN publishes known spans and captures speculative transitions. Attention
// may write beyond the accepted frontier; those entries remain unreachable.
// Device acceptance produces both the compact recurrent replay and the exact
// committed target-hidden/token pairing consumed by the following draft warm.
command.program.def public @qwen38_verify() launch(%parameters: buffer, %residual: buffer, %epoch: buffer, %rows: buffer, %state: buffer, %input_tokens: buffer, %committed: buffer, %results: buffer) {
  %tokens = config.get @runner.qwen38.prefill_token_count : index
  %spans = config.get @runner.qwen38.span_capacity : index
  %capture_value = config.get @runner.qwen38.capture_features : index
  %capture_features = index.assume %capture_value [range(%capture_value, 0, 1)] : index
  %width_value = config.get @runner.qwen38.verification_width : index
  %width = index.assume %width_value [range(%width_value, 1, 8)] : index
  %outputs = index.mul %spans, %width : index
  %hidden_row_bytes = index.constant 20480 : offset
  %output_row_bytes = index.constant 4 : offset
  %capture_token_bytes = index.constant 1984512 : offset
  %capture_span_bytes = index.scale %width, %capture_token_bytes : index, offset -> offset
  %capture_bytes = index.scale %spans, %capture_span_bytes : index, offset -> offset
  %replay_bytes = index.constant 1548 : offset
  %hidden_bytes = index.scale %outputs, %hidden_row_bytes : index, offset -> offset
  %output_bytes = index.scale %outputs, %output_row_bytes : index, offset -> offset
  %normalized = buffer.alloca<global> align(256) %hidden_bytes : buffer
  %predictions = buffer.alloca<global> align(256) %output_bytes : buffer
  %capture = buffer.alloca<global> align(256) %capture_bytes : buffer
  %replay = buffer.alloca<global> align(256) %replay_bytes : buffer
  %embedding = command.parameter %parameters, "token_embd.weight" : view<874086400xi8>
  kernel.launch @qwen38_token_embedding_q5k_f32_prefill[%tokens](%input_tokens, %embedding, %residual) : [index](buffer, view<874086400xi8>, buffer)
  command.program.launch @qwen38_text_prefill_body_impl[%tokens, %tokens, %width, %spans, %capture_features](%parameters, %residual, %epoch, %state, %state, %capture, %rows) : [index, index, index, index, index](buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  %epsilon = scalar.constant 9.9999999999999995e-07 : f32
  %norm_weight = command.parameter %parameters, "output_norm.weight" : view<5120xf32>
  kernel.launch @qwen38_output_normalize_spans[%outputs](%epoch, %epsilon, %residual, %norm_weight, %normalized) : [index](buffer, f32, buffer, view<5120xf32>, buffer)
  %origin = index.constant 0 : offset
  command.program.launch @qwen38_output_projection_sampled[%outputs](%parameters, %epoch, %normalized, %predictions) : [index](buffer, buffer, buffer, buffer)
  kernel.launch @qwen38_accept_spans(%width, %epoch, %input_tokens, %predictions, %committed, %replay, %results) : (index, buffer, buffer, buffer, buffer, buffer, buffer)
  command.program.launch @qwen38_gdn_commit[%spans, %width](%parameters, %capture, %replay, %rows, %state) : [index, index](buffer, buffer, buffer, buffer, buffer)
  command.return
}
