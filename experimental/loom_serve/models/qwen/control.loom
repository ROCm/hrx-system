    func.call @sampling_require(%valid) : (i1)
    scf.if %known {
      %value_begin = view.load %records[%i, 2] : view<[%extent]x5xi64> -> i64
      %value_length = view.load %records[%i, 3] : view<[%extent]x5xi64> -> i64
      %value_type = view.load %records[%i, 4] : view<[%extent]x5xi64> -> i64
      scf.if %is_choice {
        // Native chat validation owns the accepted choice vocabulary. Keep
        // turn permission in the device packet, not in the rendered history.
        %value = func.call @option_key(%source, %value_begin, %value_length) : (buffer, i64, i64) -> (buffer)
        %none = global.load @tool_choice_none : buffer
        %disabled = func.call @chat_equal(%value, %none) : (buffer, buffer) -> (i1)
        %flags = view.load %words[3] : view<6xi32> -> i32
        %choice_flag = scf.select %disabled, %two, %zero32 : i32
        %updated = scalar.ori %flags, %choice_flag : i32
        view.store %updated, %words[3] : i32, view<6xi32>
      } else {
        %number = scalar.cmpi eq, %value_type, %one64 : i64
        func.call @sampling_require(%number) : (i1)
        %floating = scalar.ori %is_temperature, %is_p : i1
        scf.if %floating {
          %value = func.call @parse_f64(%source, %value_begin, %value_length) : (buffer, i64, i64) -> (f64)
          %zero = scalar.constant 0.0 : f64
          %one = scalar.constant 1.0 : f64
          %largest = scalar.constant 3.4028234663852886e+38 : f64
          %smallest = scalar.constant 1.1754943508222875e-38 : f64
          %zero_value = scalar.cmpf oeq, %value, %zero : f64
          %normal = scalar.cmpf oge, %value, %smallest : f64
          %finite = scalar.cmpf ole, %value, %largest : f64
          %nonnegative = scalar.ori %zero_value, %normal : i1
          %valid_temperature = scalar.andi %nonnegative, %finite : i1
          %probability = scalar.cmpf ole, %value, %one : f64
          %valid_p = scalar.andi %normal, %probability : i1
          %valid = scf.select %is_temperature, %valid_temperature, %valid_p : i1
          func.call @sampling_require(%valid) : (i1)
          %value32 = scalar.fptrunc %value : f64 to f32
          %slot = scf.select %is_temperature, %c0, %c1 : index
          view.store %value32, %floats[%slot] : f32, view<6xf32>
        } else {
          %value = func.call @parse_i64(%source, %value_begin, %value_length) : (buffer, i64, i64) -> (i64)
          scf.if %is_seed {
            view.store %value, %seed_view[0] : i64, view<1xi64>
            %flags = view.load %words[3] : view<6xi32> -> i32
            %explicit_seed = scalar.ori %flags, %one32 : i32
            view.store %explicit_seed, %words[3] : i32, view<6xi32>
          } else {
            %limit = scalar.constant 2147483647 : i64
            %valid = scalar.cmpi ule, %value, %limit : i64
            func.call @sampling_require(%valid) : (i1)
            %value32 = scalar.trunci %value : i64 to i32
            view.store %value32, %words[2] : i32, view<6xi32>
          }
        }
      }
    }
    %next = scalar.ori %seen, %bit : i32
    scf.yield %next : i32
  }
  func.return
}

// Source-private request packet: F32 temperature/top-p, I32 top-k/flags, and
// I64 seed. Flag bit 0 records an explicit seed; bit 1 forbids tool calls.
// Native serving code only retains and transports the bytes.
func.def public @request_defaults(%options: buffer) -> (buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 24 : offset
  %configuration = buffer.alloca<private> align(8) %bytes : buffer
  %zero32 = scalar.constant 0 : i32
  buffer.fill %zero32, %configuration[%origin], %bytes : i32
  %floats = buffer.view %configuration[%origin] : buffer -> view<6xf32>
  %one = scalar.constant 1.0 : f32
  view.store %one, %floats[1] : f32, view<6xf32>
  %fields, %type, %count = func.call @members(%options) : (buffer) -> (buffer, i32, i64)
  %object_type = scalar.constant 2 : i32
  %object = scalar.cmpi eq, %type, %object_type : i32
  func.call @sampling_require(%object) : (i1)
  %bounded_count = scalar.assume %count [range(%count, 0, 2147483647)] : i64
  %extent = index.cast %bounded_count : i64 to index
  %records = buffer.view %fields[%origin] : buffer -> view<[%extent]x5xi64>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %sampling = global.load @sampling_key_name : buffer
  %draft = global.load @draft_weights_key : buffer
  %false = scalar.constant false : i1
  %true = scalar.constant true : i1
  %seen = scf.for %i = [%c0 to %extent step %c1](%seen = %false : i1) -> (i1) {
    %begin = view.load %records[%i, 0] : view<[%extent]x5xi64> -> i64
    %length = view.load %records[%i, 1] : view<[%extent]x5xi64> -> i64
    %key = func.call @option_key(%options, %begin, %length) : (buffer, i64, i64) -> (buffer)
    %is_sampling = func.call @chat_equal(%key, %sampling) : (buffer, buffer) -> (i1)
    %is_draft = func.call @chat_equal(%key, %draft) : (buffer, buffer) -> (i1)
    %allowed = scalar.ori %is_sampling, %is_draft : i1
    func.call @sampling_require(%allowed) : (i1)
    scf.if %is_sampling {
      %unique = scalar.cmpi eq, %seen, %false : i1
      func.call @sampling_require(%unique) : (i1)
      %value_begin = view.load %records[%i, 2] : view<[%extent]x5xi64> -> i64
      %value_length = view.load %records[%i, 3] : view<[%extent]x5xi64> -> i64
      %value = func.call @chat_range(%options, %value_begin, %value_length) : (buffer, i64, i64) -> (buffer)
      func.call @sampling_overlay(%value, %true, %configuration) : (buffer, i1, buffer)
    }
    %next = scalar.ori %seen, %is_sampling : i1
    scf.yield %next : i1
  }
  func.return %configuration : buffer
}

func.def public @request_options(%defaults: buffer, %request: buffer, %nonce: i64) -> (buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 24 : offset
  %configuration = buffer.alloca<private> align(8) %bytes : buffer
  buffer.copy %defaults[%origin], %configuration[%origin], %bytes
  %false = scalar.constant false : i1
  func.call @sampling_overlay(%request, %false, %configuration) : (buffer, i1, buffer)
  %words = buffer.view %configuration[%origin] : buffer -> view<6xi32>
  %flag = view.load %words[3] : view<6xi32> -> i32
  %one = scalar.constant 1 : i32
  %explicit_seed = scalar.andi %flag, %one : i32
  %zero = scalar.constant 0 : i32
  %implicit_seed = scalar.cmpi eq, %explicit_seed, %zero : i32
  scf.if %implicit_seed {
    %seed_origin = index.constant 16 : offset
    %seed = buffer.view %configuration[%seed_origin] : buffer -> view<1xi64>
    view.store %nonce, %seed[0] : i64, view<1xi64>
  }
  func.return %configuration : buffer
}

func.def public @bind_request(%state: buffer, %row: i32, %options: buffer) {
  %table = index.constant 32 : offset
  %stride = index.constant 24 : offset
  %bounded_row = scalar.assume %row [range(%row, 0, 15)] : i32
  %row_value = index.cast %bounded_row : i32 to index
  %row_offset = index.scale %row_value, %stride : index, offset -> offset
  %target = index.add %table, %row_offset : offset
  %origin = index.constant 0 : offset
  buffer.copy %options[%origin], %state[%target], %stride
  func.return
}

global.rodata.def @chat_image_budget_key = bytes("6d61785f696d6167655f746f6b656e73")

// A budget below 128 cannot contain the checkpoint's minimum-size aligned
// output at every supported aspect ratio. Larger budgets remain request-local.
func.def @chat_image_budget(%options: buffer, %default: i64) -> (i64) {
  %origin = index.constant 0 : offset
  %zero = scalar.constant 0 : i64
  %one = scalar.constant 1 : i64
  %object_type = scalar.constant 2 : i32
  %fields, %type, %count = func.call @members(%options) : (buffer) -> (buffer, i32, i64)
  %object = scalar.cmpi eq, %type, %object_type : i32
  %at_most_one = scalar.cmpi ule, %count, %one : i64
  %valid = scalar.andi %object, %at_most_one : i1
  %valid32 = scalar.extui %valid : i1 to i32
  %error = global.load @chat_options_error : buffer
  func.call @require(%valid32, %error) : (i32, buffer)
  %nonempty = scalar.cmpi ne, %count, %zero : i64
  %result = scf.if %nonempty -> (i64) {
    %record = buffer.view %fields[%origin] : buffer -> view<1x5xi64>
    %key_begin = view.load %record[0, 0] : view<1x5xi64> -> i64
    %key_length = view.load %record[0, 1] : view<1x5xi64> -> i64
    %key = func.call @option_key(%options, %key_begin, %key_length) : (buffer, i64, i64) -> (buffer)
    %name = global.load @chat_image_budget_key : buffer
    %known = func.call @chat_equal(%key, %name) : (buffer, buffer) -> (i1)
    %value_type = view.load %record[0, 4] : view<1x5xi64> -> i64
    %number = scalar.cmpi eq, %value_type, %one : i64
    %valid = scalar.andi %known, %number : i1
    %valid32 = scalar.extui %valid : i1 to i32
    func.call @require(%valid32, %error) : (i32, buffer)
    %value_begin = view.load %record[0, 2] : view<1x5xi64> -> i64
    %value_length = view.load %record[0, 3] : view<1x5xi64> -> i64
    %value = func.call @parse_i64(%options, %value_begin, %value_length) : (buffer, i64, i64) -> (i64)
    %minimum = scalar.constant 128 : i64
    %maximum = scalar.constant 16384 : i64
    %large_enough = scalar.cmpi uge, %value, %minimum : i64
    %small_enough = scalar.cmpi ule, %value, %maximum : i64
    %bounded = scalar.andi %large_enough, %small_enough : i1
    %bounded32 = scalar.extui %bounded : i1 to i32
    func.call @require(%bounded32, %error) : (i32, buffer)
    scf.yield %value : i64
  } else {
    scf.yield %default : i64
  }
  func.return %result : i64
}

func.def public @chat_begin(%request: buffer, %tools: buffer) -> (buffer, i64) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %origin = index.constant 0 : offset
  %zero64 = scalar.constant 0 : i64
  %four64 = scalar.constant 4 : i64
  %true_type = scalar.constant 4 : i64
  %empty = global.load @input_empty_boundary : buffer
  %fields, %type, %count = func.call @members(%request) : (buffer) -> (buffer, i32, i64)
  %bounded_count = scalar.assume %count [range(%count, 0, 2147483647)] : i64
  %extent = index.cast %bounded_count : i64 to index
  %records = buffer.view %fields[%origin] : buffer -> view<[%extent]x5xi64>
  %thinking_key = global.load @chat_thinking_key : buffer
  %false = scalar.constant false : i1
  %default_image_tokens = scalar.constant 1024 : i64
  %thinking, %image_tokens = scf.for %i = [%c0 to %extent step %c1](%selected = %false : i1, %budget = %default_image_tokens : i64) -> (i1, i64) {
    %key_origin = view.load %records[%i, 0] : view<[%extent]x5xi64> -> i64
    %key_length = view.load %records[%i, 1] : view<[%extent]x5xi64> -> i64
    %key = func.call @option_key(%request, %key_origin, %key_length) : (buffer, i64, i64) -> (buffer)
    %options_key = global.load @chat_options_key : buffer
    %is_options = func.call @chat_equal(%key, %options_key) : (buffer, buffer) -> (i1)
    %next_budget = scf.if %is_options -> (i64) {
      %value_origin = view.load %records[%i, 2] : view<[%extent]x5xi64> -> i64
      %value_length = view.load %records[%i, 3] : view<[%extent]x5xi64> -> i64
      %value = func.call @chat_range(%request, %value_origin, %value_length) : (buffer, i64, i64) -> (buffer)
      %tokens = func.call @chat_image_budget(%value, %budget) : (buffer, i64) -> (i64)
      scf.yield %tokens : i64
    } else {
      scf.yield %budget : i64
    }
    %is_thinking = func.call @chat_equal(%key, %thinking_key) : (buffer, buffer) -> (i1)
    %value_type = view.load %records[%i, 4] : view<[%extent]x5xi64> -> i64
    %enabled = scalar.cmpi eq, %value_type, %true_type : i64
    %next = scf.select %is_thinking, %enabled, %selected : i1
    scf.yield %next, %next_budget : i1, i64
  }
  %tool_fields, %tool_type, %tool_count = func.call @members(%tools) : (buffer) -> (buffer, i32, i64)
  %has_tools = scalar.cmpi ne, %tool_count, %zero64 : i64
  %result = scf.if %has_tools -> (buffer) {
    %tool_count_value = scalar.assume %tool_count [range(%tool_count, 1, 4096)] : i64
    %tool_extent = index.cast %tool_count_value : i64 to index
    %tool_records = buffer.view %tool_fields[%origin] : buffer -> view<[%tool_extent]x5xi64>
    %prefix = global.load @chat_tools_prefix : buffer
    %suffix = global.load @chat_tools_suffix : buffer
    %prefix_length = buffer.length %prefix
    %suffix_length = buffer.length %suffix
    %raw_length = buffer.length %tools
    %overhead = index.add %prefix_length, %suffix_length : offset
    %extra = index.cast %tool_count_value : i64 to offset
    %with_newlines = index.add %overhead, %extra : offset
    %capacity = index.add %raw_length, %with_newlines : offset
    %output = buffer.alloca<private> align(1) %capacity : buffer
    %start = func.call @tool_append(%output, %origin, %prefix) : (buffer, offset, buffer) -> (offset)
    %newline = global.load @input_terminated_boundary : buffer
    %end = scf.for %i = [%c0 to %tool_extent step %c1](%position = %start : offset) -> (offset) {
      %value_origin = view.load %tool_records[%i, 2] : view<[%tool_extent]x5xi64> -> i64
      %value_length = view.load %tool_records[%i, 3] : view<[%tool_extent]x5xi64> -> i64
      %value = func.call @chat_range(%tools, %value_origin, %value_length) : (buffer, i64, i64) -> (buffer)
      %after_newline = func.call @tool_append(%output, %position, %newline) : (buffer, offset, buffer) -> (offset)
      %next = func.call @tool_append(%output, %after_newline, %value) : (buffer, offset, buffer) -> (offset)
      scf.yield %next : offset
    }
    %final = func.call @tool_append(%output, %end, %suffix) : (buffer, offset, buffer) -> (offset)
    %exact = buffer.alloca<private> align(1) %final : buffer
    buffer.copy %output[%origin], %exact[%origin], %final
    scf.yield %exact : buffer
  } else {
    scf.yield %empty : buffer
  }
  %rendered = scf.if %thinking -> (buffer) {
    %prefix = global.load @chat_reasoning_prefix : buffer
    %tool_text = scf.if %has_tools -> (buffer) {
      %system_prefix = global.load @chat_system_prefix : buffer
      %skip = buffer.length %system_prefix
      %length = buffer.length %result
      %tail_length = index.sub %length, %skip : offset
      %tail = buffer.alloca<private> align(1) %tail_length : buffer
      buffer.copy %result[%skip], %tail[%origin], %tail_length
      %separator = global.load @text_tool_separator : buffer
      %value = func.call @chat_join(%separator, %tail, %empty, %empty, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
      scf.yield %value : buffer
    } else {
      scf.yield %empty : buffer
    }
    %value = func.call @chat_join(%prefix, %tool_text, %empty, %empty, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
    scf.yield %value : buffer
  } else {
    scf.yield %result : buffer
  }
  %open_system = scalar.ori %has_tools, %thinking : i1
  %system_bit = scf.select %open_system, %four64, %zero64 : i64
  %sixteen = scalar.constant 16 : i64
  %thinking_bit = scf.select %thinking, %sixteen, %zero64 : i64
  %flags = scalar.ori %system_bit, %thinking_bit : i64
  %budget_shift = scalar.constant 5 : i64
  %budget_bits = scalar.shli %image_tokens, %budget_shift : i64
  %state = scalar.ori %flags, %budget_bits : i64
  func.return %rendered, %state : buffer, i64
}

// Renders ordered user content with one logical image-input slot per projected
// row. Marker ranges cover only the repeated image-pad tokens; the surrounding
// vision delimiters remain ordinary language-model inputs.
func.def @chat_ordered_content(%content: buffer, %parts: buffer, %part_count: i64, %images_allowed: i1, %maximum_tokens: i32) -> (buffer, buffer, i64) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c24 = index.constant 24 : index
  %text_kind = scalar.constant 0 : i32
  %shape_capacity = index.constant 32 : offset
  %shapes = buffer.alloca<private> align(4) %shape_capacity : buffer
  %shape_records = buffer.view %shapes[%origin] : buffer -> view<4x2xi32>
  %token_pixels = scalar.constant 1024 : i32
  %bounded_part_count = scalar.assume %part_count [range(%part_count, 1, 4096)] : i64
  %part_extent = index.cast %bounded_part_count : i64 to index
  %records = buffer.view %parts[%origin] : buffer -> view<[%part_extent]x7xi32>
  %image_count_value, %total_rows = scf.for %i = [%c0 to %part_extent step %c1](%count = %c0 : index, %rows = %c0 : index) -> (index, index) {
    %kind = view.load %records[%i, 0] : view<[%part_extent]x7xi32> -> i32
    %is_text = scalar.cmpi eq, %kind, %text_kind : i32
    %next, %next_rows = scf.if %is_text -> (index, index) {
      scf.yield %count, %rows : index, index
    } else {
      %width = view.load %records[%i, 4] : view<[%part_extent]x7xi32> -> i32
      %height = view.load %records[%i, 5] : view<[%part_extent]x7xi32> -> i32
      %short_axis = scalar.minui %width, %height : i32
      %long_axis = scalar.maxui %width, %height : i32
      %ratio_limit = scalar.constant 200 : i32
      %long_limit = scalar.muli %short_axis, %ratio_limit : i32
      %aspect_valid = scalar.cmpi ule, %long_axis, %long_limit : i32
      %valid = scalar.andi %images_allowed, %aspect_valid : i1
      %valid32 = scalar.extui %valid : i1 to i32
      %error = global.load @chat_image_invalid : buffer
      func.call @require(%valid32, %error) : (i32, buffer)
      %selected_width, %selected_height = func.call @qwen38_vision_geometry(%width, %height, %maximum_tokens) : (i32, i32, i32) -> (i32, i32)
      %shape_index = index.assume %count [range(%count, 0, 3)] : index
      view.store %selected_width, %shape_records[%shape_index, 0] : i32, view<4x2xi32>
      view.store %selected_height, %shape_records[%shape_index, 1] : i32, view<4x2xi32>
      %pixels = scalar.muli %selected_width, %selected_height : i32
      %feature_count = scalar.divui %pixels, %token_pixels : i32
      %feature_extent = index.cast %feature_count : i32 to index
      %total = index.add %rows, %feature_extent : index
      %incremented = index.add %count, %c1 : index
      scf.yield %incremented, %total : index, index
    }
    scf.yield %next, %next_rows : index, index
  }
  %image_count64_value = index.cast %image_count_value : index to i64
  %image_count64 = scalar.assume %image_count64_value [range(%image_count64_value, 0, 4)] : i64
  %image_count = index.cast %image_count64 : i64 to index
  %vision_start = global.load @chat_vision_start : buffer
  %image_pad = global.load @chat_image_pad : buffer
  %vision_end = global.load @chat_vision_end : buffer
  %vision_start_length = buffer.length %vision_start
  %image_pad_length = buffer.length %image_pad
  %vision_end_length = buffer.length %vision_end
  %pad_bytes = index.scale %total_rows, %image_pad_length : index, offset -> offset
  %delimiter_bytes = index.add %vision_start_length, %vision_end_length : offset
  %all_delimiters = index.scale %image_count, %delimiter_bytes : index, offset -> offset
  %all_image_bytes = index.add %all_delimiters, %pad_bytes : offset
  %content_length = buffer.length %content
  %output_capacity = index.add %content_length, %all_image_bytes : offset
  %scratch = buffer.alloca<private> align(1) %output_capacity : buffer
  %plan_size = index.mul %image_count, %c24 : index
  %plan_size64_value = index.cast %plan_size : index to i64
  %plan_size64 = scalar.assume %plan_size64_value [range(%plan_size64_value, 0, 96)] : i64
  %metadata_begin = index.cast %plan_size64 : i64 to offset
  %shape_stride = index.constant 8 : offset
  %metadata_bytes = index.scale %image_count, %shape_stride : index, offset -> offset
  %plan_bytes = index.add %metadata_begin, %metadata_bytes : offset
  %plan = buffer.alloca<private> align(4) %plan_bytes : buffer
  buffer.copy %shapes[%origin], %plan[%metadata_begin], %metadata_bytes
  %markers = buffer.view %plan[%origin] : buffer -> view<[%image_count]x6xi32>
  %used, %final_image = scf.for %i = [%c0 to %part_extent step %c1](%cursor = %origin : offset, %image = %c0 : index) -> (offset, index) {
    %kind = view.load %records[%i, 0] : view<[%part_extent]x7xi32> -> i32
    %is_text = scalar.cmpi eq, %kind, %text_kind : i32
    %next_cursor, %next_image = scf.if %is_text -> (offset, index) {
      %source32 = view.load %records[%i, 1] : view<[%part_extent]x7xi32> -> i32
      %length32 = view.load %records[%i, 2] : view<[%part_extent]x7xi32> -> i32
      %source64 = scalar.extui %source32 : i32 to i64
      %length64 = scalar.extui %length32 : i32 to i64
      %source_value = scalar.assume %source64 [range(%source64, 0, 4294967295)] : i64
      %length_value = scalar.assume %length64 [range(%length64, 0, 4294967295)] : i64
      %source = index.cast %source_value : i64 to offset
      %length = index.cast %length_value : i64 to offset
      buffer.copy %content[%source], %scratch[%cursor], %length
      %after_text = index.add %cursor, %length : offset
      scf.yield %after_text, %image : offset, index
    } else {
      %shape_index = index.assume %image [range(%image, 0, 3)] : index
      %width = view.load %shape_records[%shape_index, 0] : view<4x2xi32> -> i32
      %height = view.load %shape_records[%shape_index, 1] : view<4x2xi32> -> i32
      %pixels = scalar.muli %width, %height : i32
      %feature_count = scalar.divui %pixels, %token_pixels : i32
      %feature_extent = index.cast %feature_count : i32 to index
      buffer.copy %vision_start[%origin], %scratch[%cursor], %vision_start_length
      %marker_begin = index.add %cursor, %vision_start_length : offset
      %after_pads = scf.for %j = [%c0 to %feature_extent step %c1](%pad_cursor = %marker_begin : offset) -> (offset) {
        buffer.copy %image_pad[%origin], %scratch[%pad_cursor], %image_pad_length
        %next = index.add %pad_cursor, %image_pad_length : offset
        scf.yield %next : offset
      }
      buffer.copy %vision_end[%origin], %scratch[%after_pads], %vision_end_length
      %after_image = index.add %after_pads, %vision_end_length : offset
      %image_index = view.load %records[%i, 3] : view<[%part_extent]x7xi32> -> i32
      %marker_begin64 = index.cast %marker_begin : offset to i64
      %marker_begin32 = scalar.trunci %marker_begin64 : i64 to i32
      %marker_length = index.sub %after_pads, %marker_begin : offset
      %marker_length64 = index.cast %marker_length : offset to i64
      %marker_length32 = scalar.trunci %marker_length64 : i64 to i32
      %bounded_image, %bounded_image_count = index.assume %image, %image_count [range(%image, 0, 3), range(%image_count, 1, 4), lt(%image, %image_count)] : index, index
      %bounded_markers = buffer.view %plan[%origin] : buffer -> view<[%bounded_image_count]x6xi32>
      view.store %image_index, %bounded_markers[%bounded_image, 0] : i32, view<[%bounded_image_count]x6xi32>
      view.store %marker_begin32, %bounded_markers[%bounded_image, 1] : i32, view<[%bounded_image_count]x6xi32>
      view.store %marker_length32, %bounded_markers[%bounded_image, 2] : i32, view<[%bounded_image_count]x6xi32>
      view.store %feature_count, %bounded_markers[%bounded_image, 3] : i32, view<[%bounded_image_count]x6xi32>
      %shape_offset = index.scale %image, %shape_stride : index, offset -> offset
      %metadata_position = index.add %metadata_begin, %shape_offset : offset
      %metadata_offset = index.cast %metadata_position : offset to i32
      %metadata_length = scalar.constant 8 : i32
      view.store %metadata_offset, %bounded_markers[%bounded_image, 4] : i32, view<[%bounded_image_count]x6xi32>
      view.store %metadata_length, %bounded_markers[%bounded_image, 5] : i32, view<[%bounded_image_count]x6xi32>
      %after_image_index = index.add %image, %c1 : index
      scf.yield %after_image, %after_image_index : offset, index
    }
    scf.yield %next_cursor, %next_image : offset, index
  }
  %trim_begin, %trim_end = func.call @chat_trim_bounds(%scratch) : (buffer) -> (offset, offset)
  %trim_begin64 = index.cast %trim_begin : offset to i64
  %trim_begin32 = scalar.trunci %trim_begin64 : i64 to i32
  scf.for %i = [%c0 to %image_count step %c1] {
    %absolute = view.load %markers[%i, 1] : view<[%image_count]x6xi32> -> i32
    %relative = scalar.subi %absolute, %trim_begin32 : i32
    view.store %relative, %markers[%i, 1] : i32, view<[%image_count]x6xi32>
  }
  %trimmed_length = index.sub %trim_end, %trim_begin : offset
  %ordered = buffer.alloca<private> align(1) %trimmed_length : buffer
  buffer.copy %scratch[%trim_begin], %ordered[%origin], %trimmed_length
  func.return %ordered, %plan, %image_count64 : buffer, buffer, i64
}

func.def @chat_shift_markers(%plan: buffer, %image_count64: i64, %base: offset) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %bounded_count = scalar.assume %image_count64 [range(%image_count64, 0, 4)] : i64
  %image_count = index.cast %bounded_count : i64 to index
  %markers = buffer.view %plan[%origin] : buffer -> view<[%image_count]x6xi32>
  %base64 = index.cast %base : offset to i64
  %base32 = scalar.trunci %base64 : i64 to i32
  scf.for %i = [%c0 to %image_count step %c1] {
    %relative = view.load %markers[%i, 1] : view<[%image_count]x6xi32> -> i32
    %absolute = scalar.addi %relative, %base32 : i32
    view.store %absolute, %markers[%i, 1] : i32, view<[%image_count]x6xi32>
  }
  func.return
}

// Low two bits hold the preceding role; bits 2/3 retain system/user presence,
// bit 4 selects thinking, and the upper bits hold the per-image token budget.
// This is source-private state. Native code carries it without interpreting it.
func.def public @chat_message(%raw: buffer, %role: buffer, %content: buffer, %parts: buffer, %reasoning: buffer, %calls: buffer, %state: i64, %ordinal: i64, %fields: i64, %part_count: i64) -> (buffer, i64, buffer) {
  %zero64 = scalar.constant 0 : i64
  %one64 = scalar.constant 1 : i64
  %two64 = scalar.constant 2 : i64
  %three64 = scalar.constant 3 : i64
  %four64 = scalar.constant 4 : i64
  %eight64 = scalar.constant 8 : i64
  %retained_mask = scalar.constant -4 : i64
  %c0 = index.constant 0 : offset
  %empty = global.load @input_empty_boundary : buffer
  %close = global.load @input_open_boundary : buffer
  %separator = global.load @text_tool_separator : buffer
  %system_role = global.load @chat_system : buffer
  %user_role = global.load @chat_user : buffer
  %assistant_role = global.load @chat_assistant : buffer
  %tool_role = global.load @chat_tool : buffer
  %system = func.call @chat_equal(%role, %system_role) : (buffer, buffer) -> (i1)
  %user = func.call @chat_equal(%role, %user_role) : (buffer, buffer) -> (i1)
  %assistant = func.call @chat_equal(%role, %assistant_role) : (buffer, buffer) -> (i1)
  %tool = func.call @chat_equal(%role, %tool_role) : (buffer, buffer) -> (i1)
  %first = scalar.cmpi eq, %ordinal, %zero64 : i64
  %prior_role = scalar.andi %state, %three64 : i64
  %prior_tool = scalar.cmpi eq, %prior_role, %three64 : i64
  %system_bit = scalar.andi %state, %four64 : i64
  %has_system_prefix = scalar.cmpi ne, %system_bit, %zero64 : i64
  %assistant_fields = scalar.andi %fields, %three64 : i64
  %has_assistant_fields = scalar.cmpi ne, %assistant_fields, %zero64 : i64
  %tool_field = scalar.andi %fields, %four64 : i64
  %has_tool_id = scalar.cmpi ne, %tool_field, %zero64 : i64
  %false = scalar.constant false : i1
  %not_assistant_fields = scalar.cmpi eq, %has_assistant_fields, %false : i1
  %valid_assistant_fields = scalar.ori %assistant, %not_assistant_fields : i1
  %valid_tool_fields = scalar.cmpi eq, %tool, %has_tool_id : i1
  %not_system = scalar.cmpi eq, %system, %false : i1
  %valid_system = scalar.ori %not_system, %first : i1
  %role_a = scalar.ori %system, %user : i1
  %role_b = scalar.ori %assistant, %tool : i1
  %known_role = scalar.ori %role_a, %role_b : i1
  %valid_a = scalar.andi %valid_assistant_fields, %valid_tool_fields : i1
  %valid_b = scalar.andi %valid_system, %known_role : i1
  %valid = scalar.andi %valid_a, %valid_b : i1
  %valid32 = scalar.extui %valid : i1 to i32
  %error = global.load @chat_invalid : buffer
  func.call @require(%valid32, %error) : (i32, buffer)
  %has_parts = scalar.cmpi ne, %part_count, %zero64 : i64
  %text, %plan, %image_count = scf.if %has_parts -> (buffer, buffer, i64) {
    %budget_shift = scalar.constant 5 : i64
    %budget = scalar.shrui %state, %budget_shift : i64
    %maximum_tokens = scalar.trunci %budget : i64 to i32
    %ordered, %markers, %images = func.call @chat_ordered_content(%content, %parts, %part_count, %user, %maximum_tokens) : (buffer, buffer, i64, i1, i32) -> (buffer, buffer, i64)
    scf.yield %ordered, %markers, %images : buffer, buffer, i64
  } else {
    %trimmed = func.call @chat_trim(%content) : (buffer) -> (buffer)
    scf.yield %trimmed, %empty, %zero64 : buffer, buffer, i64
  }
  %thought = func.call @chat_trim(%reasoning) : (buffer) -> (buffer)
  %text_length = buffer.length %text
  %nonempty = index.cmp ne, %text_length, %c0 : offset
  %calls_length = buffer.length %calls
  %has_calls = index.cmp ne, %calls_length, %c0 : offset
  %first_system = scalar.andi %first, %has_system_prefix : i1
  %close_system = scalar.andi %first_system, %not_system : i1
  %not_tool = scalar.cmpi eq, %tool, %false : i1
  %close_tools = scalar.andi %prior_tool, %not_tool : i1
  %closes = scalar.ori %close_system, %close_tools : i1
  %before = scf.select %closes, %close, %empty : buffer
  %body = scf.if %assistant -> (buffer) {
    %prefix = global.load @chat_assistant_prefix : buffer
    %think_close = global.load @chat_think_close : buffer
    %separate = scalar.andi %nonempty, %has_calls : i1
    %between = scf.select %separate, %separator, %empty : buffer
    %rendered = func.call @chat_join(%prefix, %thought, %think_close, %text, %between, %calls, %close, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
    scf.yield %rendered : buffer
  } else {
    %rendered = scf.if %system -> (buffer) {
      %with_prefix = scf.if %has_system_prefix -> (buffer) {
        %between = scf.select %nonempty, %separator, %empty : buffer
        %result = func.call @chat_join(%between, %text, %close, %empty, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
        scf.yield %result : buffer
      } else {
        %result = scf.if %nonempty -> (buffer) {
          %prefix = global.load @chat_system_prefix : buffer
          %value = func.call @chat_join(%prefix, %text, %close, %empty, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
          scf.yield %value : buffer
        } else {
          scf.yield %empty : buffer
        }
        scf.yield %result : buffer
      }
      scf.yield %with_prefix : buffer
    } else {
      %result = scf.if %tool -> (buffer) {
        %user_prefix = global.load @chat_tool_user : buffer
        %prefix = scf.select %prior_tool, %empty, %user_prefix : buffer
        %open = global.load @chat_tool_prefix : buffer
        %end = global.load @chat_tool_suffix : buffer
        %value = func.call @chat_join(%prefix, %open, %text, %end, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
        scf.yield %value : buffer
      } else {
        %prefix = global.load @input_user_prefix : buffer
        %value = func.call @chat_join(%prefix, %text, %close, %empty, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
        scf.yield %value : buffer
      }
      scf.yield %result : buffer
    }
    scf.yield %rendered : buffer
  }
  %result = func.call @chat_join(%before, %body, %empty, %empty, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
  %before_length = buffer.length %before
  %image_prefix = global.load @input_user_prefix : buffer
  %image_prefix_length = buffer.length %image_prefix
  %marker_base = index.add %before_length, %image_prefix_length : offset
  func.call @chat_shift_markers(%plan, %image_count, %marker_base) : (buffer, i64, offset)
  %role_c = scf.select %tool, %three64, %zero64 : i64
  %role_d = scf.select %assistant, %two64, %role_c : i64
  %new_role = scf.select %user, %one64, %role_d : i64
  %retained_bits = scalar.andi %state, %retained_mask : i64
  %user_bit = scf.select %user, %eight64, %zero64 : i64
  %new_bits = scalar.ori %retained_bits, %user_bit : i64
  %next = scalar.ori %new_bits, %new_role : i64
  func.return %result, %next, %plan : buffer, i64, buffer
}

func.def public @chat_end(%state: i64) -> (buffer, i64) {
  %c0 = scalar.constant 0 : i64
  %c2 = scalar.constant 2 : i64
  %c3 = scalar.constant 3 : i64
  %c8 = scalar.constant 8 : i64
  %user = scalar.andi %state, %c8 : i64
  %has_user = scalar.cmpi ne, %user, %c0 : i64
  %role = scalar.andi %state, %c3 : i64
  %not_assistant = scalar.cmpi ne, %role, %c2 : i64
  %valid = scalar.andi %has_user, %not_assistant : i1
  %valid32 = scalar.extui %valid : i1 to i32
  %error = global.load @chat_end_invalid : buffer
  func.call @require(%valid32, %error) : (i32, buffer)
  %tool = scalar.cmpi eq, %role, %c3 : i64
  %close = global.load @input_open_boundary : buffer
  %empty = global.load @input_empty_boundary : buffer
  %prefix = scf.select %tool, %close, %empty : buffer
  %c16 = scalar.constant 16 : i64
  %thinking_bit = scalar.andi %state, %c16 : i64
  %thinking = scalar.cmpi ne, %thinking_bit, %c0 : i64
  %closed_generation = global.load @chat_generation : buffer
  %open_generation = global.load @chat_assistant_prefix : buffer
  %generation = scf.select %thinking, %open_generation, %closed_generation : buffer
  %result = func.call @chat_join(%prefix, %generation, %empty, %empty, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
  %output_state = scalar.extui %thinking : i1 to i64
  func.return %result, %output_state : buffer, i64
}
