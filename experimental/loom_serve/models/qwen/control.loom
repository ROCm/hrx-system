      %value_length = view.load %records[%i, 3] : view<[%extent]x5xi64> -> i64
      %value = func.call @chat_range(%request, %value_origin, %value_length) : (buffer, i64, i64) -> (buffer)
      %options, %options_type, %options_count = func.call @members(%value) : (buffer) -> (buffer, i32, i64)
      %none = scalar.cmpi eq, %options_count, %zero64 : i64
      %none32 = scalar.extui %none : i1 to i32
      %options_error = global.load @chat_options_error : buffer
      func.call @require(%none32, %options_error) : (i32, buffer) -> ()
      scf.yield
    }
    %is_thinking = func.call @chat_equal(%key, %thinking_key) : (buffer, buffer) -> (i1)
    %value_type = view.load %records[%i, 4] : view<[%extent]x5xi64> -> i64
    %enabled = scalar.cmpi eq, %value_type, %true_type : i64
    %reject = scalar.andi %is_thinking, %enabled : i1
    %false = scalar.constant false : i1
    %allowed = scalar.cmpi eq, %reject, %false : i1
    %allowed32 = scalar.extui %allowed : i1 to i32
    func.call @require(%allowed32, %thinking_error) : (i32, buffer) -> ()
    scf.yield
  }
  %tool_fields, %tool_type, %tool_count = func.call @members(%tools) : (buffer) -> (buffer, i32, i64)
  %has_tools = scalar.cmpi ne, %tool_count, %zero64 : i64
  %result = scf.if %has_tools -> (buffer) {
    %tool_count_value = scalar.assume %tool_count [range(%tool_count, 1, 16)] : i64
    %tool_extent = index.cast %tool_count_value : i64 to index
    %tool_records = buffer.view %tool_fields[%origin] : buffer -> view<[%tool_extent]x5xi64>
    %prefix = global.load @chat_tools_prefix : buffer
    %suffix = global.load @chat_tools_suffix : buffer
    %prefix_length = buffer.length %prefix
    %suffix_length = buffer.length %suffix
    %raw_length = buffer.length %tools
    %overhead = index.add %prefix_length, %suffix_length : offset
    %extra = index.constant 16 : offset
    %with_newlines = index.add %overhead, %extra : offset
    %capacity = index.add %raw_length, %with_newlines : offset
    %output = buffer.alloca<private> align(1) %capacity : buffer
    %start = func.call @tool_append(%output, %origin, %prefix) : (buffer, offset, buffer) -> (offset)
    %newline = global.load @input_terminated_boundary : buffer
    %end = scf.for %i = [%zero to %tool_extent step %one](%position = %start : offset) -> (offset) {
      %value_origin = view.load %tool_records[%i, 2] : view<[%tool_extent]x5xi64> -> i64
      %value_length = view.load %tool_records[%i, 3] : view<[%tool_extent]x5xi64> -> i64
      %value = func.call @chat_range(%tools, %value_origin, %value_length) : (buffer, i64, i64) -> (buffer)
      %after_newline = func.call @tool_append(%output, %position, %newline) : (buffer, offset, buffer) -> (offset)
      %next = func.call @tool_append(%output, %after_newline, %value) : (buffer, offset, buffer) -> (offset)
      scf.yield %next : offset
    }
    %final = func.call @tool_append(%output, %end, %suffix) : (buffer, offset, buffer) -> (offset)
    %exact = buffer.alloca<private> align(1) %final : buffer
    buffer.copy %output[%origin], %exact[%origin], %final
    scf.yield %exact : buffer
  } else {
    scf.yield %empty : buffer
  }
  %state = scf.select %has_tools, %four64, %zero64 : i64
  func.return %result, %state : buffer, i64
}

// Low two bits hold the preceding role; bits 2/3 retain tools/user presence.
// This is source-private state. Native code carries it without interpreting it.
func.def public @chat_message(%raw: buffer, %role: buffer, %content: buffer, %reasoning: buffer, %calls: buffer, %state: i64, %ordinal: i64, %fields: i64) -> (buffer, i64) {
  %zero64 = scalar.constant 0 : i64
  %one64 = scalar.constant 1 : i64
  %two64 = scalar.constant 2 : i64
  %three64 = scalar.constant 3 : i64
  %four64 = scalar.constant 4 : i64
  %eight64 = scalar.constant 8 : i64
  %twelve64 = scalar.constant 12 : i64
  %zero = index.constant 0 : offset
  %empty = global.load @input_empty_boundary : buffer
  %close = global.load @input_open_boundary : buffer
  %separator = global.load @text_tool_separator : buffer
  %system_role = global.load @chat_system : buffer
  %user_role = global.load @chat_user : buffer
  %assistant_role = global.load @chat_assistant : buffer
  %tool_role = global.load @chat_tool : buffer
  %system = func.call @chat_equal(%role, %system_role) : (buffer, buffer) -> (i1)
  %user = func.call @chat_equal(%role, %user_role) : (buffer, buffer) -> (i1)
  %assistant = func.call @chat_equal(%role, %assistant_role) : (buffer, buffer) -> (i1)
  %tool = func.call @chat_equal(%role, %tool_role) : (buffer, buffer) -> (i1)
  %first = scalar.cmpi eq, %ordinal, %zero64 : i64
  %prior_role = scalar.andi %state, %three64 : i64
  %prior_tool = scalar.cmpi eq, %prior_role, %three64 : i64
  %tool_bit = scalar.andi %state, %four64 : i64
  %has_tools = scalar.cmpi ne, %tool_bit, %zero64 : i64
  %assistant_fields = scalar.andi %fields, %three64 : i64
  %has_assistant_fields = scalar.cmpi ne, %assistant_fields, %zero64 : i64
  %tool_field = scalar.andi %fields, %four64 : i64
  %has_tool_id = scalar.cmpi ne, %tool_field, %zero64 : i64
  %false = scalar.constant false : i1
  %not_assistant_fields = scalar.cmpi eq, %has_assistant_fields, %false : i1
  %valid_assistant_fields = scalar.ori %assistant, %not_assistant_fields : i1
  %valid_tool_fields = scalar.cmpi eq, %tool, %has_tool_id : i1
  %not_system = scalar.cmpi eq, %system, %false : i1
  %valid_system = scalar.ori %not_system, %first : i1
  %role_a = scalar.ori %system, %user : i1
  %role_b = scalar.ori %assistant, %tool : i1
  %known_role = scalar.ori %role_a, %role_b : i1
  %valid_a = scalar.andi %valid_assistant_fields, %valid_tool_fields : i1
  %valid_b = scalar.andi %valid_system, %known_role : i1
  %valid = scalar.andi %valid_a, %valid_b : i1
  %valid32 = scalar.extui %valid : i1 to i32
  %error = global.load @chat_invalid : buffer
  func.call @require(%valid32, %error) : (i32, buffer) -> ()
  %text = func.call @chat_trim(%content) : (buffer) -> (buffer)
  %thought = func.call @chat_trim(%reasoning) : (buffer) -> (buffer)
  %text_length = buffer.length %text
  %nonempty = index.cmp ne, %text_length, %zero : offset
  %calls_length = buffer.length %calls
  %has_calls = index.cmp ne, %calls_length, %zero : offset
  %first_tools = scalar.andi %first, %has_tools : i1
  %close_system = scalar.andi %first_tools, %not_system : i1
  %not_tool = scalar.cmpi eq, %tool, %false : i1
  %close_tools = scalar.andi %prior_tool, %not_tool : i1
  %closes = scalar.ori %close_system, %close_tools : i1
  %before = scf.select %closes, %close, %empty : buffer
  %body = scf.if %assistant -> (buffer) {
    %prefix = global.load @chat_assistant_prefix : buffer
    %think_close = global.load @chat_think_close : buffer
    %separate = scalar.andi %nonempty, %has_calls : i1
    %between = scf.select %separate, %separator, %empty : buffer
    %rendered = func.call @chat_join(%prefix, %thought, %think_close, %text, %between, %calls, %close, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
    scf.yield %rendered : buffer
  } else {
    %rendered = scf.if %system -> (buffer) {
      %with_tools = scf.if %has_tools -> (buffer) {
        %between = scf.select %nonempty, %separator, %empty : buffer
        %result = func.call @chat_join(%between, %text, %close, %empty, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
        scf.yield %result : buffer
      } else {
        %result = scf.if %nonempty -> (buffer) {
          %prefix = global.load @chat_system_prefix : buffer
          %value = func.call @chat_join(%prefix, %text, %close, %empty, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
          scf.yield %value : buffer
        } else {
          scf.yield %empty : buffer
        }
        scf.yield %result : buffer
      }
      scf.yield %with_tools : buffer
    } else {
      %result = scf.if %tool -> (buffer) {
        %user_prefix = global.load @chat_tool_user : buffer
        %prefix = scf.select %prior_tool, %empty, %user_prefix : buffer
        %open = global.load @chat_tool_prefix : buffer
        %end = global.load @chat_tool_suffix : buffer
        %value = func.call @chat_join(%prefix, %open, %text, %end, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
        scf.yield %value : buffer
      } else {
        %prefix = global.load @input_user_prefix : buffer
        %value = func.call @chat_join(%prefix, %text, %close, %empty, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
        scf.yield %value : buffer
      }
      scf.yield %result : buffer
    }
    scf.yield %rendered : buffer
  }
  %result = func.call @chat_join(%before, %body, %empty, %empty, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
  %role_c = scf.select %tool, %three64, %zero64 : i64
  %role_d = scf.select %assistant, %two64, %role_c : i64
  %new_role = scf.select %user, %one64, %role_d : i64
  %retained_bits = scalar.andi %state, %twelve64 : i64
  %user_bit = scf.select %user, %eight64, %zero64 : i64
  %new_bits = scalar.ori %retained_bits, %user_bit : i64
  %next = scalar.ori %new_bits, %new_role : i64
  func.return %result, %next : buffer, i64
}

func.def public @chat_end(%state: i64) -> (buffer) {
  %zero = scalar.constant 0 : i64
  %two = scalar.constant 2 : i64
  %three = scalar.constant 3 : i64
  %eight = scalar.constant 8 : i64
  %user = scalar.andi %state, %eight : i64
  %has_user = scalar.cmpi ne, %user, %zero : i64
  %role = scalar.andi %state, %three : i64
  %not_assistant = scalar.cmpi ne, %role, %two : i64
  %valid = scalar.andi %has_user, %not_assistant : i1
  %valid32 = scalar.extui %valid : i1 to i32
  %error = global.load @chat_end_invalid : buffer
  func.call @require(%valid32, %error) : (i32, buffer) -> ()
  %tool = scalar.cmpi eq, %role, %three : i64
  %close = global.load @input_open_boundary : buffer
  %empty = global.load @input_empty_boundary : buffer
  %prefix = scf.select %tool, %close, %empty : buffer
  %generation = global.load @chat_generation : buffer
  %result = func.call @chat_join(%prefix, %generation, %empty, %empty, %empty, %empty, %empty, %empty) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> (buffer)
  func.return %result : buffer
}

// The program is shared; all request state arrives as buffer bindings.
func.def public @step(%state: buffer, %initialize: i32, %residual: hal.buffer, %control: hal.buffer, %gdn: hal.buffer, %attention: hal.buffer, %tokens: hal.buffer, %progress: hal.buffer) -> (i64) {
  %origin = index.constant 0 : offset
  %view = buffer.view %state[%origin] : buffer -> view<4xi32>
  %prefill = view.load %view[0] : view<4xi32> -> i32
  %decode = view.load %view[1] : view<4xi32> -> i32
  %zero = scalar.constant 0 : i32
  %is_prefill = scalar.cmpi ne, %initialize, %zero : i32
  %stage = scf.select %is_prefill, %prefill, %decode : i32
  %completion = func.call @execute_6(%stage, %residual, %control, %gdn, %attention, %tokens, %progress) : (i32, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer) -> (i64)
  func.return %completion : i64
}

// Catalog order is isolated prefill/decode, target shapes, then optional
// proposal, catch-up shapes and verifier shapes. All sessions share these
// commands and one process; descriptors and buffers carry their live state.
// Feedback slot zero holds ordinary tokens; slots one/two hold separate
// verification banks. Neither branch waits: the owner joins both timelines
// before advancing host frontiers.
func.def @epoch_once(%control_state: buffer, %shape: i32, %proposes: i32, %verifies: i32, %span_count: i32, %output_count: i32, %feedback_slot: i32, %residual: hal.buffer, %metadata: hal.buffer, %origins: hal.buffer, %state: hal.buffer, %tokens: hal.buffer, %outputs: hal.buffer, %carry: hal.buffer, %committed: hal.buffer, %results: hal.buffer, %draft_cache: hal.buffer, %draft_origins: hal.buffer) -> (i64) {
  %origin = index.constant 0 : offset
  %view = buffer.view %control_state[%origin] : buffer -> view<4xi32>
  %shape_count = view.load %view[2] : view<4xi32> -> i32
  %mtp_first = view.load %view[3] : view<4xi32> -> i32
  %zero = scalar.constant 0 : i32
  %one = scalar.constant 1 : i32
  %two = scalar.constant 2 : i32
  %zero_offset = scalar.constant 0 : i64
  %propose = scalar.cmpi ne, %proposes, %zero : i32
  %verify = scalar.cmpi ne, %verifies, %zero : i32
  scf.if %propose {
    %proposal = func.call @execute_5(%mtp_first, %metadata, %tokens, %draft_origins, %draft_cache, %carry) : (i32, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer) -> (i64)
    scf.yield
  }
  %warm_first = scalar.addi %mtp_first, %one : i32
  %warm_stage = scalar.addi %warm_first, %shape : i32
  %target = scf.if %verify -> (i64) {
    %verify_stage = scalar.addi %warm_stage, %shape_count : i32
    %completion = func.call @execute_7(%verify_stage, %residual, %metadata, %origins, %state, %tokens, %committed, %results) : (i32, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer) -> (i64)
    %count = scalar.extui %span_count : i32 to i64
    %record_bytes = scalar.constant 24 : i64
    %record_length = scalar.muli %count, %record_bytes : i64
    %tagged = scalar.cmpi eq, %feedback_slot, %two : i32
    %tagged_length = scalar.constant 448 : i64
    %length = scf.select %tagged, %tagged_length, %record_length : i64
    %feedback = func.call @feedback(%feedback_slot, %results, %zero_offset, %length) : (i32, hal.buffer, i64, i64) -> (i64)
    scf.yield %completion : i64
  } else {
    %target_stage = scalar.addi %shape, %two : i32
    %completion = func.call @execute_6(%target_stage, %residual, %metadata, %origins, %state, %tokens, %outputs) : (i32, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer) -> (i64)
    %has_output = scalar.cmpi ne, %output_count, %zero : i32
    scf.if %has_output {
      %count = scalar.extui %output_count : i32 to i64
      %token_bytes = scalar.constant 4 : i64
      %length = scalar.muli %count, %token_bytes : i64
      %feedback = func.call @feedback(%zero, %outputs, %zero_offset, %length) : (i32, hal.buffer, i64, i64) -> (i64)
      scf.yield
    }
    scf.yield %completion : i64
  }
  // Catch-up only mutates the private draft cache and committed carry. Target
  // feedback stays immutable and can transfer concurrently with this command.
  %mtp_enabled = scalar.cmpi ne, %mtp_first, %zero : i32
  %completion = scf.if %mtp_enabled -> (i64) {
    %accepted = scf.if %verify -> (hal.buffer) {
      scf.yield %committed : hal.buffer
    } else {
      scf.yield %metadata : hal.buffer
    }
    %warm = func.call @execute_6(%warm_stage, %residual, %accepted, %draft_origins, %draft_cache, %carry, %tokens) : (i32, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer) -> (i64)
    scf.yield %warm : i64
  } else {
    scf.yield %target : i64
  }
  func.return %completion : i64
}

// A bounded cohort reuses retained state on the work timeline, while each
// feedback bank stays immutable on its independent transfer branch. Acceptance
// produces the next input and position entirely on device; neither call waits.
func.def public @epoch(%control_state: buffer, %shape: i32, %proposes: i32, %verifies: i32, %span_count: i32, %output_count: i32, %epoch_count: i32, %continuation_shape: i32, %continuation_proposes: i32, %residual: hal.buffer, %metadata: hal.buffer, %origins: hal.buffer, %state: hal.buffer, %tokens: hal.buffer, %outputs: hal.buffer, %carry: hal.buffer, %committed: hal.buffer, %results: hal.buffer, %draft_cache: hal.buffer, %draft_origins: hal.buffer, %next_results: hal.buffer) -> (i64) {
  %zero = scalar.constant 0 : i32
  %one = scalar.constant 1 : i32
  %two = scalar.constant 2 : i32
  %sixteen = scalar.constant 16 : i32
  %first = func.call @epoch_once(%control_state, %shape, %proposes, %verifies, %span_count, %output_count, %one, %residual, %metadata, %origins, %state, %tokens, %outputs, %carry, %committed, %results, %draft_cache, %draft_origins) : (buffer, i32, i32, i32, i32, i32, i32, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer) -> (i64)
  %continues = scalar.cmpi eq, %epoch_count, %two : i32
  %completion = scf.if %continues -> (i64) {
    %origin = index.constant 0 : offset
    %view = buffer.view %control_state[%origin] : buffer -> view<4xi32>
    %shape_count = view.load %view[2] : view<4xi32> -> i32
    %proposal = view.load %view[3] : view<4xi32> -> i32
    %shapes = scalar.muli %shape_count, %two : i32
    %after_shapes = scalar.addi %proposal, %shapes : i32
    %continuation = scalar.addi %after_shapes, %one : i32
    %ready = func.call @execute_3(%continuation, %metadata, %tokens, %results) : (i32, hal.buffer, hal.buffer, hal.buffer) -> (i64)
    %next = func.call @epoch_once(%control_state, %continuation_shape, %continuation_proposes, %one, %sixteen, %zero, %two, %residual, %metadata, %origins, %state, %tokens, %outputs, %carry, %committed, %next_results, %draft_cache, %draft_origins) : (buffer, i32, i32, i32, i32, i32, i32, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer) -> (i64)
    scf.yield %next : i64
  } else {
    scf.yield %first : i64
  }
  func.return %completion : i64
}
