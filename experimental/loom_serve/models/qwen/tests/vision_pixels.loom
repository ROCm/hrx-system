  %valid8 = scalar.andi %valid7, %weight_valid0 : i1
  %numerator1 = scalar.constant 1.0 : f32
  %denominator1 = scalar.constant 1.0 : f32
  %reference1 = scalar.divf %numerator1, %denominator1 : f32
  %weight1 = view.load %weights[1] : view<3xf32> -> f32
  %weight_valid1 = scalar.cmpf oeq, %weight1, %reference1 : f32
  %valid9 = scalar.andi %valid8, %weight_valid1 : i1
  %numerator2 = scalar.constant 1.0 : f32
  %denominator2 = scalar.constant 1.0 : f32
  %reference2 = scalar.divf %numerator2, %denominator2 : f32
  %weight2 = view.load %weights[2] : view<3xf32> -> f32
  %weight_valid2 = scalar.cmpf oeq, %weight2, %reference2 : f32
  %valid10 = scalar.andi %valid9, %weight_valid2 : i1
  %result = scalar.extui %valid10 : i1 to i32
  func.return %result : i32
}

check.case public @axis_single_pixel_coefficients {
  %actual = func.call @axis_single_pixel() : () -> (i32)
  %expected = check.literal value(1) : i32
