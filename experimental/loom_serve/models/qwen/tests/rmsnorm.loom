// F32 arithmetic may put an exact midpoint on either side of the final F16
// rounding boundary. One F16 ULP is the storage contract; F32 comparisons above
// retain their 1e-6 bound, and the uniform primitive case remains bit-exact.
check.scenario public @half_output {
  check.trial[2](%trial: index, %entropy: check.entropy) {
    %rows = check.literal value(3) : index
    %epsilon = check.literal value(9.9999999999999995e-07) : f32
    %input_seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %weight_seed = check.entropy.read %entropy[1] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%input_seed) range(-2.0 to 2.0) : tensor<3x5120xf32>
    %weight = check.generate.random.uniform seed(%weight_seed) range(-2.0 to 2.0) : tensor<5120xf32>
    %output = check.generate.fill value(-99.0) : tensor<3x5120xf16>
    check.compare<@qwen38_rmsnorm_f16_prefill, @prefill_half_reference>[%rows](%rows, %epsilon, %input, %weight, %output) : [index](index, f32, tensor<3x5120xf32>, tensor<5120xf32>, tensor<3x5120xf16>) -> () {
      check.expect.close actual(%output) expected(%output) atol(9.9999999999999995e-07) rtol(0.0009765625) nan(different) : tensor<3x5120xf16>
    }
  }
  check.return
}

