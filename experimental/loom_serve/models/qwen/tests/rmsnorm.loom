    check.compare<@qwen38_rmsnorm_f32_prefill, @prefill_reference>[%rows](%rows, %epsilon, %input, %weight, %output) : [index](index, f32, tensor<3x5120xf32>, tensor<5120xf32>, tensor<3x5120xf32>) -> () {
      check.expect.close actual(%output) expected(%output) atol(9.9999999999999995e-07) rtol(9.9999999999999995e-07) nan(different) : tensor<3x5120xf32>
    }
  }
  check.return
}

