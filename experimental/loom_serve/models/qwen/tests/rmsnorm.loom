// A different width and workgroup size exercise the shared motif's bank shape.
kernel.def @small_row() {
  %one = index.constant 1 : index
  %threads = index.constant 128 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%epsilon: f32, %input: buffer, %weight: buffer, %output: buffer) {
  %width = index.constant 1024 : index
  %threads = index.constant 128 : index
  %origin = index.constant 0 : offset
  %half = scalar.constant 0 : i1
  template.apply<@normalization.rms_row_f32>(%width, %threads, %origin, %origin, %half, %epsilon, %input, %weight, %output) : (index, index, offset, offset, i1, f32, buffer, buffer, buffer)
  kernel.return
}

func.def @small_row_reference(%epsilon: f32, %input: buffer, %weight: buffer, %output: buffer) {
  %rows = index.constant 1 : index
  %width = index.constant 1024 : index
  %column = index.constant 0 : index
  %half = scalar.constant 0 : i1
  func.call @rms_reference(%rows, %width, %width, %column, %half, %epsilon, %input, %weight, %output) : (index, index, index, index, i1, f32, buffer, buffer, buffer)
  func.return
}

check.scenario public @small_width {
  check.trial[2](%trial: index, %entropy: check.entropy) {
    %epsilon = check.literal value(9.9999999999999995e-07) : f32
    %seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-1.0000000000000001e-05 to 1.0000000000000001e-05) : tensor<1024xf32>
    %weight = check.generate.iota offset(-1.0) step(0.00390625) period(512) : tensor<1024xf32>
    %output = check.generate.fill value(-99.0) : tensor<1024xf32>
    check.compare<@small_row, @small_row_reference>(%epsilon, %input, %weight, %output) : (f32, tensor<1024xf32>, tensor<1024xf32>, tensor<1024xf32>) -> () {
      check.expect.close actual(%output) expected(%output) atol(9.9999999999999995e-07) rtol(9.9999999999999995e-07) nan(different) : tensor<1024xf32>
    }
  }
  check.return
}

check.case public @zero_decode_row {
  %epsilon = check.literal value(9.9999999999999995e-07) : f32
  %input = check.generate.fill value(0.0) : tensor<5120xf32>
  %weight = check.generate.iota offset(-1.0) step(0.00390625) period(512) : tensor<5120xf32>
  %output = check.generate.fill value(-99.0) : tensor<5120xf32>
  kernel.launch @qwen38_rmsnorm_f32_decode(%epsilon, %input, %weight, %output) : (f32, tensor<5120xf32>, tensor<5120xf32>, tensor<5120xf32>)
  check.expect.close actual(%output) expected(%input) atol(0.0) rtol(0.0) nan(different) : tensor<5120xf32>
  check.return
}
