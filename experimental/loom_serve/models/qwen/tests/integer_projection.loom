    %seed0 = check.entropy.read %entropy[0] : check.entropy -> i64
    %seed1 = check.entropy.read %entropy[1] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed0) range(-128 to -65) : tensor<18720xi8>
    %weight = check.generate.random.uniform seed(%seed1) range(-128 to -65) : tensor<4224xi8>
    %output = check.generate.fill value(-99.0) : tensor<129x24xf32>
