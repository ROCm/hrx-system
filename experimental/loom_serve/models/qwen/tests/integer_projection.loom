      check.expect.close actual(%output) expected(%output) atol(0.0001) rtol(0.00002) nan(different) : tensor<129x24xf32>
    }
  }
  check.return
}

check.scenario @integer_projection_long_check {
  check.requires<hal.amdgpu.target> {target = "gfx9-4-generic"}
  check.trial[2](%trial: index, %entropy: check.entropy) {
    %channels = check.literal value(8) : index
    %capacity = check.literal value(64) : index
    %inputs = check.literal value(5120) : index
    %outputs = check.literal value(136) : index
    %control = check.generate.fill value(3) : tensor<1xi32>
    %seed0 = check.entropy.read %entropy[0] : check.entropy -> i64
    %seed1 = check.entropy.read %entropy[1] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed0) range(-128 to -65) : tensor<17280xi8>
    %weight = check.generate.random.uniform seed(%seed1) range(-128 to -65) : tensor<478720xi8>
    %output = check.generate.fill value(-99.0) : tensor<65x136xf32>
    check.compare<@qwen38_linear_q5k_q8_1_matrix, @qwen_integer_projection_oracle>[%channels, %capacity, %inputs, %outputs](%channels, %control, %inputs, %outputs, %input, %weight, %output) : [index, index, index, index](index, tensor<1xi32>, index, index, tensor<17280xi8>, tensor<478720xi8>, tensor<65x136xf32>) -> () {
      check.expect.close actual(%output) expected(%output) atol(0.0001) rtol(0.00002) nan(different) : tensor<65x136xf32>
    }
  }
  check.return
}
