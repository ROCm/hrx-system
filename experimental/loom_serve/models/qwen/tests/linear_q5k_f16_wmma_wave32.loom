kernel.decl @qwen38_linear_q5k_f16_wmma_x128(%tokens: index, %inputs: index, %outputs: index) launch(%control: buffer, %inputs: index, %outputs: index, %input: buffer, %weight: buffer, %output: buffer)
kernel.decl @qwen38_linear_q5k_f16_wmma_c128_t128_wave32(%tokens: index, %inputs: index, %outputs: index) launch(%control: buffer, %inputs: index, %outputs: index, %input: buffer, %weight: buffer, %output: buffer)
kernel.decl @qwen38_linear_q5k_f16_wmma_c128_t128_wave32_input_f16(%tokens: index, %inputs: index, %outputs: index) launch(%control: buffer, %inputs: index, %outputs: index, %input: buffer, %weight: buffer, %output: buffer)

// The wave64 global-decoding schedule supplies independent acquisition and
// publication. Binary-exact iota inputs round identically into F16 from either
// storage type. Finite encoded scales and channel-varying codes exercise
// contraction order, all pipeline groups, tails, and untouched output padding.

check.case public @qwen38_q5_read_ahead_single {
  %capacity = check.literal value(128) : index
  %inputs = check.literal value(256) : index
  %outputs = check.param.choice values([1, 48, 129]) name("channels") : index
  %control = check.generate.fill value(1) : tensor<1xi32>
  %seed = check.param.seed base(98412) count(2) : i64
  %input = check.generate.iota offset(-0.75) step(0.0000002384185791015625) : tensor<128x256xf32>
  %input_f16 = check.generate.iota offset(-0.75) step(0.0000002384185791015625) : tensor<128x256xf16>
  %weight = check.generate.random.uniform seed(%seed) range(0 to 31) : tensor<[%outputs]x1x176xi8>
  %expected = check.generate.fill value(-17.0) : tensor<128x[%outputs]xf32>
  %actual = check.generate.fill value(-17.0) : tensor<128x[%outputs]xf32>
  %actual_f16 = check.generate.fill value(-17.0) : tensor<128x[%outputs]xf32>
  kernel.launch @qwen38_linear_q5k_f16_wmma_x128[%capacity, %inputs, %outputs](%control, %inputs, %outputs, %input, %weight, %expected) : [index, index, index](tensor<1xi32>, index, index, tensor<128x256xf32>, tensor<[%outputs]x1x176xi8>, tensor<128x[%outputs]xf32>)
  kernel.launch @qwen38_linear_q5k_f16_wmma_c128_t128_wave32[%capacity, %inputs, %outputs](%control, %inputs, %outputs, %input, %weight, %actual) : [index, index, index](tensor<1xi32>, index, index, tensor<128x256xf32>, tensor<[%outputs]x1x176xi8>, tensor<128x[%outputs]xf32>)
  kernel.launch @qwen38_linear_q5k_f16_wmma_c128_t128_wave32_input_f16[%capacity, %inputs, %outputs](%control, %inputs, %outputs, %input_f16, %weight, %actual_f16) : [index, index, index](tensor<1xi32>, index, index, tensor<128x256xf16>, tensor<[%outputs]x1x176xi8>, tensor<128x[%outputs]xf32>)
  check.expect.bitwise actual(%actual) expected(%expected) : tensor<128x[%outputs]xf32>
  check.expect.bitwise actual(%actual_f16) expected(%expected) : tensor<128x[%outputs]xf32>
  check.return
}

check.case public @qwen38_q5_read_ahead_tail {
  %capacity = check.literal value(256) : index
  %inputs = check.literal value(768) : index
  %outputs = check.param.choice values([65, 6144]) name("channels") : index
  %control = check.generate.fill value(129) : tensor<1xi32>
  %seed = check.param.seed base(98412) count(2) : i64
  %input = check.generate.iota offset(-0.75) step(0.0000002384185791015625) : tensor<256x768xf32>
  %input_f16 = check.generate.iota offset(-0.75) step(0.0000002384185791015625) : tensor<256x768xf16>
  %weight = check.generate.random.uniform seed(%seed) range(0 to 31) : tensor<[%outputs]x3x176xi8>
  %expected = check.generate.fill value(-17.0) : tensor<256x[%outputs]xf32>
  %actual = check.generate.fill value(-17.0) : tensor<256x[%outputs]xf32>
  %actual_f16 = check.generate.fill value(-17.0) : tensor<256x[%outputs]xf32>
  kernel.launch @qwen38_linear_q5k_f16_wmma_x128[%capacity, %inputs, %outputs](%control, %inputs, %outputs, %input, %weight, %expected) : [index, index, index](tensor<1xi32>, index, index, tensor<256x768xf32>, tensor<[%outputs]x3x176xi8>, tensor<256x[%outputs]xf32>)
  kernel.launch @qwen38_linear_q5k_f16_wmma_c128_t128_wave32[%capacity, %inputs, %outputs](%control, %inputs, %outputs, %input, %weight, %actual) : [index, index, index](tensor<1xi32>, index, index, tensor<256x768xf32>, tensor<[%outputs]x3x176xi8>, tensor<256x[%outputs]xf32>)
  kernel.launch @qwen38_linear_q5k_f16_wmma_c128_t128_wave32_input_f16[%capacity, %inputs, %outputs](%control, %inputs, %outputs, %input_f16, %weight, %actual_f16) : [index, index, index](tensor<1xi32>, index, index, tensor<256x768xf16>, tensor<[%outputs]x3x176xi8>, tensor<256x[%outputs]xf32>)
  check.expect.bitwise actual(%actual) expected(%expected) : tensor<256x[%outputs]xf32>
  check.expect.bitwise actual(%actual_f16) expected(%expected) : tensor<256x[%outputs]xf32>
  check.return
}

