    %inputs = check.literal value(768) : index
    %outputs = check.literal value(9) : index
    %input = check.generate.random.uniform seed(%seed0) range(-0.25 to 0.25) : tensor<16x768xf32>
    %weight = check.generate.random.uniform seed(%seed1) range(-128 to -65) : tensor<9x3x210xi8>
    %output = check.generate.fill value(-99.0) : tensor<17x9xf32>
