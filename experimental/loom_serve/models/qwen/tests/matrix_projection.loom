    check.generate<@q5_projection_headers>(%inputs, %outputs, %weight) : (index, index, tensor<72x2x176xi8>) -> ()
    %output = check.generate.fill value(-99.0) : tensor<17x72xf32>
    check.compare<@qwen38_linear_q5k_f16_mfma_channel8, @q5_projection_wmma_channel8_expected>[%tokens, %inputs, %outputs](%token_count_data, %inputs, %outputs, %input, %weight, %output) : [index, index, index](tensor<1xi32>, index, index, tensor<17x512xf32>, tensor<72x2x176xi8>, tensor<17x72xf32>) -> () {
      check.expect.close actual(%output) expected(%output) atol(0.0005) rtol(0.00003) nan(different) : tensor<17x72xf32>
    }
