kernel.decl @qwen38_mtp_proposal_prepare() launch(%target_capacity: index, %draft_capacity: index, %epoch: buffer, %target_tokens: buffer, %draft: buffer, %origins: buffer, %draft_tokens: buffer)

kernel.decl @qwen38_mtp_proposal_advance(%round: index) launch(%round_value: index, %target_capacity: index, %draft_capacity: index, %draft: buffer, %origins: buffer, %predictions: buffer, %draft_tokens: buffer, %target_tokens: buffer)

// Build real mixed descriptors and independently derive a proposal sequence's
// publication. A bit mask selects generated spans; other spans alternate
// variable-length known input and supplied eight-token candidates. Resident
// rows are reversed.
kernel.def @proposal_fixture() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%target_capacity_value: index, %span_count_value: index, %round_value: index, %step_count_value: index, %mask: i32, %epoch: buffer, %expected_draft: buffer, %expected_origins: buffer, %expected_anchors: buffer, %expected_inputs: buffer, %expected_target: buffer) {
  %target_capacity = index.assume %target_capacity_value [range(%target_capacity_value, 512, 32768)] : index
  %span_count = index.assume %span_count_value [range(%span_count_value, 1, 16)] : index
  %round = index.assume %round_value [range(%round_value, 0, 6)] : index
  %step_count = index.assume %step_count_value [range(%step_count_value, 1, 7)] : index
  %origin = index.constant 0 : offset
  %descriptor_origin = index.constant 12 : offset
  %options_origin = index.constant 1804 : offset
  %header = buffer.view %epoch[%origin] : buffer -> view<3xi32>
  %spans = buffer.view %epoch[%descriptor_origin] : buffer -> view<64x5xi32>
  %options = buffer.view %epoch[%options_origin] : buffer -> view<64x2xi32>
  %draft_header = buffer.view %expected_draft[%origin] : buffer -> view<3xi32>
  %draft = buffer.view %expected_draft[%descriptor_origin] : buffer -> view<64x5xi32>
  %origins = buffer.view %expected_origins[%origin] : buffer -> view<16xi32>
  %anchors = buffer.view %expected_anchors[%origin] : buffer -> view<16xi32>
  %inputs = buffer.view %expected_inputs[%origin] : buffer -> view<16xi32>
  %target = buffer.view %expected_target[%origin] : buffer -> view<[%target_capacity]xi32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c8 = index.constant 8 : index
  %c7 = index.constant 7 : index
  %last_row = index.constant 15 : index
  %resident_rows = index.constant 16 : index
  %per_span = index.div %target_capacity, %resident_rows : index
  %known_length = index.sub %per_span, %c8 : index
  %source_base = index.constant 23 : index
  %c100 = index.constant 100 : index
  %input_base = index.constant 1000 : index
  %prediction_base = index.constant 10000 : index
  %c0_2 = scalar.constant 0 : i32
  %c1_2 = scalar.constant 1 : i32
  %c2_2 = scalar.constant 2 : i32
  %c8_2 = scalar.constant 8 : i32
  %span_count_word = index.cast %span_count : index to i32
  %begin, %count = scf.for %span = [%c0 to %span_count step %c1](%begin_value = %c0 : index, %slot_value = %c0 : index) -> (index, index) {
    %begin = index.assume %begin_value [ge(%begin_value, 0), lt(%begin_value, %target_capacity)] : index
    %slot = index.assume %slot_value [range(%slot_value, 0, 15)] : index
    %span_word = index.cast %span : index to i32
    %shifted = scalar.shrui %mask, %span_word : i32
    %bit = scalar.andi %shifted, %c1_2 : i32
    %generated = scalar.cmpi ne, %bit, %c0_2 : i32
    %parity = index.rem %span, %c2 : index
    %ordinary_flag = index.cast %parity : index to i32
    %flag = scf.select %generated, %c2_2, %ordinary_flag : i32
    %known = scalar.cmpi eq, %flag, %c0_2 : i32
    %length = scf.select %known, %known_length, %c8 : index
    %length_word = index.cast %length : index to i32
    %begin_word = index.cast %begin : index to i32
    %row = index.sub %last_row, %span : index
    %row_word = index.cast %row : index to i32
    %position = index.add %c100, %span : index
    %position_word = index.cast %position : index to i32
    %source_position = index.add %source_base, %span : index
    %source_word = index.cast %source_position : index to i32
    %shift = scalar.constant 10 : i32
    %source_bits = scalar.shli %source_word, %shift : i32
    view.store %length_word, %spans[%span, 0] : i32, view<64x5xi32>
    view.store %position_word, %spans[%span, 1] : i32, view<64x5xi32>
    view.store %begin_word, %spans[%span, 2] : i32, view<64x5xi32>
    view.store %row_word, %spans[%span, 3] : i32, view<64x5xi32>
    view.store %source_bits, %spans[%span, 4] : i32, view<64x5xi32>
    view.store %flag, %options[%span, 0] : i32, view<64x2xi32>
    view.store %c8_2, %options[%span, 1] : i32, view<64x2xi32>
    %next_slot = scf.if %generated -> (index) {
      %slot_word = index.cast %slot : index to i32
      %selection_code = scalar.addi %slot_word, %c1_2 : i32
      %final_position = index.add %position, %step_count : index
      %final_position_word = index.cast %final_position : index to i32
      %final_source_position = index.add %source_position, %step_count : index
      %final_source_word = index.cast %final_source_position : index to i32
      %final_source_bits = scalar.shli %final_source_word, %shift : i32
      %draft_output = scalar.ori %final_source_bits, %selection_code : i32
      %stride = index.mul %slot, %c7 : index
      %prediction = index.add %prediction_base, %stride : index
      %prediction_word = index.cast %prediction : index to i32
      %anchor = index.add %input_base, %begin : index
      %anchor_word = index.cast %anchor : index to i32
      view.store %c1_2, %draft[%slot, 0] : i32, view<64x5xi32>
      view.store %final_position_word, %draft[%slot, 1] : i32, view<64x5xi32>
      view.store %slot_word, %draft[%slot, 2] : i32, view<64x5xi32>
      view.store %row_word, %draft[%slot, 3] : i32, view<64x5xi32>
      view.store %draft_output, %draft[%slot, 4] : i32, view<64x5xi32>
      view.store %begin_word, %origins[%slot] : i32, view<16xi32>
      view.store %anchor_word, %anchors[%slot] : i32, view<16xi32>
      view.store %prediction_word, %inputs[%slot] : i32, view<16xi32>
      %first = index.add %round, %c1 : index
      %end = index.add %first, %step_count : index
      scf.for %relative = [%first to %end step %c1] {
        %destination_value = index.add %begin, %relative : index
        %destination = index.assume %destination_value [ge(%destination_value, 0), lt(%destination_value, %target_capacity)] : index
        view.store %prediction_word, %target[%destination] : i32, view<[%target_capacity]xi32>
      }
      %next = index.add %slot, %c1 : index
      scf.yield %next : index
    } else {
      scf.yield %slot : index
    }
    %end = index.add %begin, %length : index
    scf.yield %end, %next_slot : index, index
  }
  %begin_word = index.cast %begin : index to i32
  %count_word = index.cast %count : index to i32
  view.store %begin_word, %header[0] : i32, view<3xi32>
  view.store %span_count_word, %header[1] : i32, view<3xi32>
  view.store %count_word, %draft_header[0] : i32, view<3xi32>
  view.store %count_word, %draft_header[1] : i32, view<3xi32>
  view.store %count_word, %draft_header[2] : i32, view<3xi32>
  kernel.return
}

check.case public @proposal_compaction {
  %target_capacity = check.param.choice values([512, 16384]) name("target_capacity") : index
  %draft_capacity = check.literal value(16) : index
  %span_count = check.param.range linear bounds(1 to 16) step(1) : index
  %round = check.literal value(0) : index
  %step_count = check.literal value(1) : index
  %mask = check.param.choice values([0, 1, 32769, 21845, 43691, 65535]) : i32
  %epoch = check.generate.fill value(-99) : tensor<580xi32>
  %draft = check.generate.fill value(-99) : tensor<387xi32>
  %origins = check.generate.fill value(-99) : tensor<16xi32>
  %inputs = check.generate.fill value(-99) : tensor<16xi32>
  %target = check.generate.iota offset(1000) step(1) : tensor<[%target_capacity]xi32>
  %expected_draft = check.generate.fill value(-99) : tensor<387xi32>
  %expected_origins = check.generate.fill value(-99) : tensor<16xi32>
  %expected_anchors = check.generate.fill value(0) : tensor<16xi32>
  %expected_inputs = check.generate.fill value(0) : tensor<16xi32>
  %expected_target = check.generate.iota offset(1000) step(1) : tensor<[%target_capacity]xi32>
  kernel.launch @proposal_fixture(%target_capacity, %span_count, %round, %step_count, %mask, %epoch, %expected_draft, %expected_origins, %expected_anchors, %expected_inputs, %expected_target) : (index, index, index, index, i32, tensor<580xi32>, tensor<387xi32>, tensor<16xi32>, tensor<16xi32>, tensor<16xi32>, tensor<[%target_capacity]xi32>)
  kernel.launch @qwen38_mtp_proposal_prepare(%target_capacity, %draft_capacity, %epoch, %target, %draft, %origins, %inputs) : (index, index, tensor<580xi32>, tensor<[%target_capacity]xi32>, tensor<387xi32>, tensor<16xi32>, tensor<16xi32>)
  check.expect.bitwise actual(%inputs) expected(%expected_anchors) : tensor<16xi32>
  check.expect.bitwise actual(%origins) expected(%expected_origins) : tensor<16xi32>
  check.return
}

check.case public @proposal_publication {
  %target_capacity = check.param.choice values([512, 16384]) name("target_capacity") : index
  %draft_capacity = check.literal value(16) : index
  %span_count = check.param.range linear bounds(1 to 16) step(1) : index
  %round = check.param.range linear bounds(0 to 6) step(1) : index
  %step_count = check.literal value(1) : index
  %mask = check.param.choice values([0, 1, 32769, 21845, 43691, 65535]) : i32
  %epoch = check.generate.fill value(-99) : tensor<580xi32>
  %draft = check.generate.fill value(-99) : tensor<387xi32>
  %origins = check.generate.fill value(-99) : tensor<16xi32>
  %inputs = check.generate.fill value(-99) : tensor<16xi32>
  %target = check.generate.iota offset(1000) step(1) : tensor<[%target_capacity]xi32>
  %predictions = check.generate.iota offset(10000) step(7) : tensor<16xi32>
  %expected_draft = check.generate.fill value(-99) : tensor<387xi32>
  %expected_origins = check.generate.fill value(-99) : tensor<16xi32>
  %expected_anchors = check.generate.fill value(0) : tensor<16xi32>
  %expected_inputs = check.generate.fill value(0) : tensor<16xi32>
  %expected_target = check.generate.iota offset(1000) step(1) : tensor<[%target_capacity]xi32>
  kernel.launch @proposal_fixture(%target_capacity, %span_count, %round, %step_count, %mask, %epoch, %expected_draft, %expected_origins, %expected_anchors, %expected_inputs, %expected_target) : (index, index, index, index, i32, tensor<580xi32>, tensor<387xi32>, tensor<16xi32>, tensor<16xi32>, tensor<16xi32>, tensor<[%target_capacity]xi32>)
  kernel.launch @qwen38_mtp_proposal_prepare(%target_capacity, %draft_capacity, %epoch, %target, %draft, %origins, %inputs) : (index, index, tensor<580xi32>, tensor<[%target_capacity]xi32>, tensor<387xi32>, tensor<16xi32>, tensor<16xi32>)
  kernel.launch @qwen38_mtp_proposal_advance[%round](%round, %target_capacity, %draft_capacity, %draft, %origins, %predictions, %inputs, %target) : [index](index, index, index, tensor<387xi32>, tensor<16xi32>, tensor<16xi32>, tensor<16xi32>, tensor<[%target_capacity]xi32>)
  check.expect.bitwise actual(%draft) expected(%expected_draft) : tensor<387xi32>
  check.expect.bitwise actual(%origins) expected(%expected_origins) : tensor<16xi32>
  check.expect.bitwise actual(%inputs) expected(%expected_inputs) : tensor<16xi32>
  check.expect.bitwise actual(%target) expected(%expected_target) : tensor<[%target_capacity]xi32>
  check.return
}

