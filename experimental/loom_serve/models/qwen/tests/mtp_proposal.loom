kernel.decl @qwen38_mtp_proposal_prepare() launch(%epoch: buffer, %target_tokens: buffer, %draft: buffer, %origins: buffer, %draft_tokens: buffer)

kernel.decl @qwen38_mtp_proposal_advance(%round: index) launch(%round_value: index, %draft: buffer, %origins: buffer, %predictions: buffer, %draft_tokens: buffer, %target_tokens: buffer)

// Build real mixed descriptors and independently derive the final three-round
// publication. A bit mask selects generated spans; other spans alternate known
// 16-token input and supplied four-token candidates. Resident rows are reversed.
kernel.def @proposal_fixture() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%span_count_value: index, %mask: i32, %epoch: buffer, %expected_draft: buffer, %expected_origins: buffer, %expected_anchors: buffer, %expected_inputs: buffer, %expected_target: buffer) {
  %span_count = index.assume %span_count_value [range(%span_count_value, 1, 16)] : index
  %origin = index.constant 0 : offset
  %descriptor_origin = index.constant 12 : offset
  %options_origin = index.constant 1804 : offset
  %header = buffer.view %epoch[%origin] : buffer -> view<3xi32>
  %spans = buffer.view %epoch[%descriptor_origin] : buffer -> view<64x5xi32>
  %options = buffer.view %epoch[%options_origin] : buffer -> view<64x2xi32>
  %draft_header = buffer.view %expected_draft[%origin] : buffer -> view<3xi32>
  %draft = buffer.view %expected_draft[%descriptor_origin] : buffer -> view<64x5xi32>
  %origins = buffer.view %expected_origins[%origin] : buffer -> view<16xi32>
  %anchors = buffer.view %expected_anchors[%origin] : buffer -> view<512xi32>
  %inputs = buffer.view %expected_inputs[%origin] : buffer -> view<512xi32>
  %target = buffer.view %expected_target[%origin] : buffer -> view<512xi32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c7 = index.constant 7 : index
  %last_row = index.constant 15 : index
  %known_length = index.constant 16 : index
  %c100 = index.constant 100 : index
  %input_base = index.constant 1000 : index
  %prediction_base = index.constant 10000 : index
  %c0_2 = scalar.constant 0 : i32
  %c1_2 = scalar.constant 1 : i32
  %c2_2 = scalar.constant 2 : i32
  %c4_2 = scalar.constant 4 : i32
  %span_count_word = index.cast %span_count : index to i32
  %begin, %count = scf.for %span = [%c0 to %span_count step %c1](%begin_value = %c0 : index, %slot_value = %c0 : index) -> (index, index) {
    %begin = index.assume %begin_value [range(%begin_value, 0, 508)] : index
    %slot = index.assume %slot_value [range(%slot_value, 0, 15)] : index
    %span_word = index.cast %span : index to i32
    %shifted = scalar.shrui %mask, %span_word : i32
    %bit = scalar.andi %shifted, %c1_2 : i32
    %generated = scalar.cmpi ne, %bit, %c0_2 : i32
    %parity = index.rem %span, %c2 : index
    %ordinary_flag = index.cast %parity : index to i32
    %flag = scf.select %generated, %c2_2, %ordinary_flag : i32
    %known = scalar.cmpi eq, %flag, %c0_2 : i32
    %length = scf.select %known, %known_length, %c4 : index
    %length_word = index.cast %length : index to i32
    %begin_word = index.cast %begin : index to i32
    %row = index.sub %last_row, %span : index
    %row_word = index.cast %row : index to i32
    %position = index.add %c100, %span : index
    %position_word = index.cast %position : index to i32
    view.store %length_word, %spans[%span, 0] : i32, view<64x5xi32>
    view.store %position_word, %spans[%span, 1] : i32, view<64x5xi32>
    view.store %begin_word, %spans[%span, 2] : i32, view<64x5xi32>
    view.store %row_word, %spans[%span, 3] : i32, view<64x5xi32>
    view.store %flag, %options[%span, 0] : i32, view<64x2xi32>
    view.store %c4_2, %options[%span, 1] : i32, view<64x2xi32>
    %next_slot = scf.if %generated -> (index) {
      %slot_word = index.cast %slot : index to i32
      %final_position = index.add %position, %c3 : index
      %final_position_word = index.cast %final_position : index to i32
      %stride = index.mul %slot, %c7 : index
      %prediction = index.add %prediction_base, %stride : index
      %prediction_word = index.cast %prediction : index to i32
      %anchor = index.add %input_base, %begin : index
      %anchor_word = index.cast %anchor : index to i32
      view.store %c1_2, %draft[%slot, 0] : i32, view<64x5xi32>
      view.store %final_position_word, %draft[%slot, 1] : i32, view<64x5xi32>
      view.store %slot_word, %draft[%slot, 2] : i32, view<64x5xi32>
      view.store %row_word, %draft[%slot, 3] : i32, view<64x5xi32>
      view.store %slot_word, %draft[%slot, 4] : i32, view<64x5xi32>
      view.store %begin_word, %origins[%slot] : i32, view<16xi32>
      view.store %anchor_word, %anchors[%slot] : i32, view<512xi32>
      view.store %prediction_word, %inputs[%slot] : i32, view<512xi32>
      scf.for %relative = [%c1 to %c4 step %c1] {
        %destination = index.add %begin, %relative : index
        view.store %prediction_word, %target[%destination] : i32, view<512xi32>
      }
      %next = index.add %slot, %c1 : index
      scf.yield %next : index
    } else {
      scf.yield %slot : index
    }
    %end = index.add %begin, %length : index
    scf.yield %end, %next_slot : index, index
  }
  %begin_word = index.cast %begin : index to i32
  %count_word = index.cast %count : index to i32
  view.store %begin_word, %header[0] : i32, view<3xi32>
  view.store %span_count_word, %header[1] : i32, view<3xi32>
  view.store %count_word, %draft_header[0] : i32, view<3xi32>
  view.store %count_word, %draft_header[1] : i32, view<3xi32>
  view.store %count_word, %draft_header[2] : i32, view<3xi32>
  kernel.return
}

check.case public @proposal_compaction {
  %span_count = check.param.range linear bounds(1 to 16) step(1) : index
  %mask = check.param.choice values([1, 32769, 21845, 43691, 65535]) : i32
  %epoch = check.generate.fill value(-99) : tensor<580xi32>
  %draft = check.generate.fill value(-99) : tensor<387xi32>
  %origins = check.generate.fill value(-99) : tensor<16xi32>
  %inputs = check.generate.fill value(-99) : tensor<512xi32>
  %target = check.generate.iota offset(1000) step(1) : tensor<512xi32>
  %expected_draft = check.generate.fill value(-99) : tensor<387xi32>
  %expected_origins = check.generate.fill value(-99) : tensor<16xi32>
  %expected_anchors = check.generate.fill value(0) : tensor<512xi32>
  %expected_inputs = check.generate.fill value(0) : tensor<512xi32>
  %expected_target = check.generate.iota offset(1000) step(1) : tensor<512xi32>
  kernel.launch @proposal_fixture(%span_count, %mask, %epoch, %expected_draft, %expected_origins, %expected_anchors, %expected_inputs, %expected_target) : (index, i32, tensor<580xi32>, tensor<387xi32>, tensor<16xi32>, tensor<512xi32>, tensor<512xi32>, tensor<512xi32>)
  kernel.launch @qwen38_mtp_proposal_prepare(%epoch, %target, %draft, %origins, %inputs) : (tensor<580xi32>, tensor<512xi32>, tensor<387xi32>, tensor<16xi32>, tensor<512xi32>)
  check.expect.bitwise actual(%inputs) expected(%expected_anchors) : tensor<512xi32>
  check.expect.bitwise actual(%origins) expected(%expected_origins) : tensor<16xi32>
  check.return
}

check.case public @proposal_publication {
  %span_count = check.param.range linear bounds(1 to 16) step(1) : index
  %mask = check.param.choice values([1, 32769, 21845, 43691, 65535]) : i32
  %epoch = check.generate.fill value(-99) : tensor<580xi32>
  %draft = check.generate.fill value(-99) : tensor<387xi32>
  %origins = check.generate.fill value(-99) : tensor<16xi32>
  %inputs = check.generate.fill value(-99) : tensor<512xi32>
  %target = check.generate.iota offset(1000) step(1) : tensor<512xi32>
  %predictions = check.generate.iota offset(10000) step(7) : tensor<16xi32>
  %expected_draft = check.generate.fill value(-99) : tensor<387xi32>
  %expected_origins = check.generate.fill value(-99) : tensor<16xi32>
  %expected_anchors = check.generate.fill value(0) : tensor<512xi32>
  %expected_inputs = check.generate.fill value(0) : tensor<512xi32>
  %expected_target = check.generate.iota offset(1000) step(1) : tensor<512xi32>
  kernel.launch @proposal_fixture(%span_count, %mask, %epoch, %expected_draft, %expected_origins, %expected_anchors, %expected_inputs, %expected_target) : (index, i32, tensor<580xi32>, tensor<387xi32>, tensor<16xi32>, tensor<512xi32>, tensor<512xi32>, tensor<512xi32>)
  kernel.launch @qwen38_mtp_proposal_prepare(%epoch, %target, %draft, %origins, %inputs) : (tensor<580xi32>, tensor<512xi32>, tensor<387xi32>, tensor<16xi32>, tensor<512xi32>)
  %c0 = check.literal value(0) : index
  %c1 = check.literal value(1) : index
  %c2 = check.literal value(2) : index
  kernel.launch @qwen38_mtp_proposal_advance[%c0](%c0, %draft, %origins, %predictions, %inputs, %target) : [index](index, tensor<387xi32>, tensor<16xi32>, tensor<16xi32>, tensor<512xi32>, tensor<512xi32>)
  kernel.launch @qwen38_mtp_proposal_advance[%c1](%c1, %draft, %origins, %predictions, %inputs, %target) : [index](index, tensor<387xi32>, tensor<16xi32>, tensor<16xi32>, tensor<512xi32>, tensor<512xi32>)
  kernel.launch @qwen38_mtp_proposal_advance[%c2](%c2, %draft, %origins, %predictions, %inputs, %target) : [index](index, tensor<387xi32>, tensor<16xi32>, tensor<16xi32>, tensor<512xi32>, tensor<512xi32>)
  check.expect.bitwise actual(%draft) expected(%expected_draft) : tensor<387xi32>
  check.expect.bitwise actual(%origins) expected(%expected_origins) : tensor<16xi32>
  check.expect.bitwise actual(%inputs) expected(%expected_inputs) : tensor<512xi32>
  check.expect.bitwise actual(%target) expected(%expected_target) : tensor<512xi32>
  check.return
}
