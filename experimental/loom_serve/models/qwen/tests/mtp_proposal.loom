  kernel.launch @qwen38_mtp_proposal_prepare(%target_capacity, %draft_capacity, %epoch, %target, %draft, %origins, %inputs) : (index, index, tensor<580xi32>, tensor<[%target_capacity]xi32>, tensor<387xi32>, tensor<16xi32>, tensor<16xi32>)
  %round0 = check.literal value(0) : index
  kernel.launch @qwen38_mtp_proposal_advance[%round0](%round0, %target_capacity, %draft_capacity, %draft, %origins, %predictions, %inputs, %target) : [index](index, index, index, tensor<387xi32>, tensor<16xi32>, tensor<16xi32>, tensor<16xi32>, tensor<[%target_capacity]xi32>)
  %round1 = check.literal value(1) : index
  kernel.launch @qwen38_mtp_proposal_advance[%round1](%round1, %target_capacity, %draft_capacity, %draft, %origins, %predictions, %inputs, %target) : [index](index, index, index, tensor<387xi32>, tensor<16xi32>, tensor<16xi32>, tensor<16xi32>, tensor<[%target_capacity]xi32>)
  %round2 = check.literal value(2) : index
  kernel.launch @qwen38_mtp_proposal_advance[%round2](%round2, %target_capacity, %draft_capacity, %draft, %origins, %predictions, %inputs, %target) : [index](index, index, index, tensor<387xi32>, tensor<16xi32>, tensor<16xi32>, tensor<16xi32>, tensor<[%target_capacity]xi32>)
  %round3 = check.literal value(3) : index
  kernel.launch @qwen38_mtp_proposal_advance[%round3](%round3, %target_capacity, %draft_capacity, %draft, %origins, %predictions, %inputs, %target) : [index](index, index, index, tensor<387xi32>, tensor<16xi32>, tensor<16xi32>, tensor<16xi32>, tensor<[%target_capacity]xi32>)
  %round4 = check.literal value(4) : index
  kernel.launch @qwen38_mtp_proposal_advance[%round4](%round4, %target_capacity, %draft_capacity, %draft, %origins, %predictions, %inputs, %target) : [index](index, index, index, tensor<387xi32>, tensor<16xi32>, tensor<16xi32>, tensor<16xi32>, tensor<[%target_capacity]xi32>)
  %round5 = check.literal value(5) : index
  kernel.launch @qwen38_mtp_proposal_advance[%round5](%round5, %target_capacity, %draft_capacity, %draft, %origins, %predictions, %inputs, %target) : [index](index, index, index, tensor<387xi32>, tensor<16xi32>, tensor<16xi32>, tensor<16xi32>, tensor<[%target_capacity]xi32>)
  %round6 = check.literal value(6) : index
  kernel.launch @qwen38_mtp_proposal_advance[%round6](%round6, %target_capacity, %draft_capacity, %draft, %origins, %predictions, %inputs, %target) : [index](index, index, index, tensor<387xi32>, tensor<16xi32>, tensor<16xi32>, tensor<16xi32>, tensor<[%target_capacity]xi32>)
