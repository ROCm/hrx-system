  %initial2_output = check.tensor.view %isolated_output offset(491520) : tensor<32x6144xf32> -> tensor<1x6144xf32>
  %initial3_count = check.literal value(1) : index
  %initial3_control = check.generate.iota offset(1) step(47) : tensor<2xi32>
  %initial3_projection = check.tensor.view %projection offset(1032192) : tensor<32x12288xf32> -> tensor<1x12288xf32>
  %initial3_key = check.tensor.view %key offset(86016) : tensor<32x1024xf32> -> tensor<1x1024xf32>
  %initial3_value = check.tensor.view %value offset(86016) : tensor<32x1024xf32> -> tensor<1x1024xf32>
  %initial3_query = check.tensor.view %isolated_query offset(516096) : tensor<32x6144xf32> -> tensor<1x6144xf32>
  %initial3_gate = check.tensor.view %isolated_gate offset(516096) : tensor<32x6144xf32> -> tensor<1x6144xf32>
  %initial3_output = check.tensor.view %isolated_output offset(516096) : tensor<32x6144xf32> -> tensor<1x6144xf32>
  %continuation0_count = check.literal value(2) : index
  %continuation0_control = check.generate.iota offset(2) step(76) : tensor<2xi32>
  %continuation0_projection = check.tensor.view %projection offset(0) : tensor<32x12288xf32> -> tensor<2x12288xf32>
  %continuation0_key = check.tensor.view %key offset(0) : tensor<32x1024xf32> -> tensor<2x1024xf32>
  %continuation0_value = check.tensor.view %value offset(0) : tensor<32x1024xf32> -> tensor<2x1024xf32>
  %continuation0_query = check.tensor.view %isolated_query offset(0) : tensor<32x6144xf32> -> tensor<2x6144xf32>
  %continuation0_gate = check.tensor.view %isolated_gate offset(0) : tensor<32x6144xf32> -> tensor<2x6144xf32>
  %continuation0_output = check.tensor.view %isolated_output offset(0) : tensor<32x6144xf32> -> tensor<2x6144xf32>
  %continuation1_count = check.literal value(1) : index
  %continuation1_control = check.generate.iota offset(1) step(129) : tensor<2xi32>
  %continuation1_projection = check.tensor.view %projection offset(98304) : tensor<32x12288xf32> -> tensor<1x12288xf32>
  %continuation1_key = check.tensor.view %key offset(8192) : tensor<32x1024xf32> -> tensor<1x1024xf32>
  %continuation1_value = check.tensor.view %value offset(8192) : tensor<32x1024xf32> -> tensor<1x1024xf32>
  %continuation1_query = check.tensor.view %isolated_query offset(49152) : tensor<32x6144xf32> -> tensor<1x6144xf32>
  %continuation1_gate = check.tensor.view %isolated_gate offset(49152) : tensor<32x6144xf32> -> tensor<1x6144xf32>
  %continuation1_output = check.tensor.view %isolated_output offset(49152) : tensor<32x6144xf32> -> tensor<1x6144xf32>

  kernel.launch @mixed_attention_metadata(%initial, %epoch, %rows) : (i1, tensor<43xi32>, tensor<6x4xi64>)
  kernel.launch @qwen38_attention_query_prepare_spans[%token_capacity, %span_capacity](%epoch, %epsilon, %projection, %weight, %packed_query, %packed_gate) : [index, index](tensor<43xi32>, f32, tensor<32x12288xf32>, tensor<256xf32>, tensor<32x6144xf32>, tensor<32x6144xf32>)
  kernel.launch @qwen38_attention_kv_prepare_spans[%token_capacity, %span_capacity](%epoch, %rows, %layer_origin, %epsilon, %key, %value, %weight, %packed_state) : [index, index](tensor<43xi32>, tensor<6x4xi64>, offset, f32, tensor<32x1024xf32>, tensor<32x1024xf32>, tensor<256xf32>, tensor<6317568xf16>)
  kernel.launch @qwen38_attention_spans_f16_wmma[%token_capacity, %span_capacity](%epoch, %rows, %layer_origin, %packed_query, %packed_gate, %packed_state, %packed_output) : [index, index](tensor<43xi32>, tensor<6x4xi64>, offset, tensor<32x6144xf32>, tensor<32x6144xf32>, tensor<6317568xf16>, tensor<32x6144xf32>)
  kernel.launch @qwen38_attention_query_prepare_prefill[%initial0_count](%initial0_control, %epsilon, %initial0_projection, %weight, %initial0_query, %initial0_gate) : [index](tensor<2xi32>, f32, tensor<17x12288xf32>, tensor<256xf32>, tensor<17x6144xf32>, tensor<17x6144xf32>)
