func.decl @qwen38_vision_geometry(%width: i32, %height: i32, %maximum_tokens: i32) -> (i32, i32)

check.case public @unchanged {
  %width = check.literal value(256) : i32
  %height = check.literal value(256) : i32
  %budget = check.literal value(1024) : i32
  %actual_width, %actual_height = func.call @qwen38_vision_geometry(%width, %height, %budget) : (i32, i32, i32) -> (i32, i32)
  %expected_width = check.literal value(256) : i32
  %expected_height = check.literal value(256) : i32
  check.expect.equal actual(%actual_width) expected(%expected_width) : i32
  check.expect.equal actual(%actual_height) expected(%expected_height) : i32
  check.return
}

