func.decl @qwen38_continue_spans(%mixed_inputs: index, %context: index, %capacity: index, %epoch: buffer, %tokens: buffer, %results: buffer)

kernel.def @continue_media() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%epoch: buffer, %tokens: buffer, %results: buffer) {
  %mixed = index.constant 1 : index
  %context = index.constant 256 : index
  %capacity = index.constant 12 : index
  func.call @qwen38_continue_spans(%mixed, %context, %capacity, %epoch, %tokens, %results) : (index, index, index, buffer, buffer, buffer)
  kernel.return
}

// The first continuation overwrites the second first-span record before that
// span's speculative continuation runs. Its accepted source frontier must have
// been retained before compaction, independently of the packed destination.
kernel.def @media_continuation_fixture() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%epoch: buffer, %tokens: buffer, %results: buffer, %expected: buffer) {
  %origin = index.constant 0 : offset
  %descriptor_origin = index.constant 12 : offset
  %plan_origin = index.constant 2320 : offset
  %plan_descriptors = index.constant 2332 : offset
  %plan_options = index.constant 4124 : offset
  %indices_origin = index.constant 4640 : offset
  %shape_origin = index.constant 6112 : offset
  %header = buffer.view %epoch[%origin] : buffer -> view<3xi32>
  %spans = buffer.view %epoch[%descriptor_origin] : buffer -> view<2x5xi32>
  %plan = buffer.view %epoch[%plan_origin] : buffer -> view<3xi32>
  %planned = buffer.view %epoch[%plan_descriptors] : buffer -> view<2x5xi32>
  %credits = buffer.view %epoch[%plan_options] : buffer -> view<2x2xi32>
  %indices = buffer.view %epoch[%indices_origin] : buffer -> view<2xi32>
  %shape = buffer.view %epoch[%shape_origin] : buffer -> view<2xi32>
  %records = buffer.view %tokens[%origin] : buffer -> view<18x8xi32>
  %prior = buffer.view %results[%origin] : buffer -> view<16x10xi32>
  %output = buffer.view %expected[%origin] : buffer -> view<12x8xi32>
  %zero = scalar.constant 0 : i32
  %one = scalar.constant 1 : i32
  %two = scalar.constant 2 : i32
  %four = scalar.constant 4 : i32
  %six = scalar.constant 6 : i32
  %eight = scalar.constant 8 : i32
  %ten = scalar.constant 10 : i32
  %twelve = scalar.constant 12 : i32
  %twenty = scalar.constant 20 : i32
  %seventy_one = scalar.constant 71 : i32
  %prediction = scalar.constant 42 : i32
  view.store %two, %header[1] : i32, view<3xi32>
  view.store %four, %spans[0, 0] : i32, view<2x5xi32>
  view.store %two, %spans[1, 0] : i32, view<2x5xi32>
  view.store %four, %spans[1, 2] : i32, view<2x5xi32>
  view.store %four, %prior[0, 0] : i32, view<16x10xi32>
  view.store %two, %prior[1, 0] : i32, view<16x10xi32>
  view.store %two, %prior[1, 1] : i32, view<16x10xi32>
  view.store %prediction, %prior[1, 3] : i32, view<16x10xi32>
  view.store %twenty, %records[3, 5] : i32, view<18x8xi32>
  view.store %seventy_one, %records[5, 5] : i32, view<18x8xi32>
  view.store %six, %shape[0] : i32, view<2xi32>
  view.store %twelve, %shape[1] : i32, view<2xi32>
  view.store %two, %plan[1] : i32, view<3xi32>
  view.store %eight, %planned[0, 0] : i32, view<2x5xi32>
  view.store %four, %planned[1, 0] : i32, view<2x5xi32>
  view.store %one, %planned[1, 3] : i32, view<2x5xi32>
  view.store %one, %planned[1, 4] : i32, view<2x5xi32>
  view.store %one, %credits[1, 0] : i32, view<2x2xi32>
  view.store %ten, %credits[1, 1] : i32, view<2x2xi32>
  view.store %one, %indices[1] : i32, view<2xi32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c6 = index.constant 6 : index
  %c8 = index.constant 8 : index
  %c12 = index.constant 12 : index
  scf.for %i = [%c0 to %c8 step %c1] {
    %queued = index.add %i, %c6 : index
    %relative = index.cast %i : index to i32
    %position = scalar.addi %twenty, %relative : i32
    %following = scalar.addi %position, %one : i32
    view.store %position, %records[%queued, 2] : i32, view<18x8xi32>
    view.store %position, %records[%queued, 3] : i32, view<18x8xi32>
    view.store %position, %records[%queued, 4] : i32, view<18x8xi32>
    view.store %following, %records[%queued, 5] : i32, view<18x8xi32>
    view.store %position, %output[%i, 2] : i32, view<12x8xi32>
    view.store %position, %output[%i, 3] : i32, view<12x8xi32>
    view.store %position, %output[%i, 4] : i32, view<12x8xi32>
    view.store %following, %output[%i, 5] : i32, view<12x8xi32>
  }
  scf.for %i = [%c8 to %c12 step %c1] {
    %relative_index = index.sub %i, %c8 : index
    %relative = index.cast %relative_index : index to i32
    %position = scalar.addi %seventy_one, %relative : i32
    %following = scalar.addi %position, %one : i32
    view.store %position, %output[%i, 2] : i32, view<12x8xi32>
    view.store %position, %output[%i, 3] : i32, view<12x8xi32>
    view.store %position, %output[%i, 4] : i32, view<12x8xi32>
    view.store %following, %output[%i, 5] : i32, view<12x8xi32>
  }
  view.store %prediction, %output[8, 0] : i32, view<12x8xi32>
  kernel.return
}

check.case public @media_continuation_retains_accepted_source_frontiers {
  %epoch = check.generate.fill value(0) : tensor<1532xi32>
  %tokens = check.generate.fill value(0) : tensor<18x8xi32>
  %results = check.generate.fill value(0) : tensor<336xi32>
  %expected = check.generate.fill value(0) : tensor<12x8xi32>
  kernel.launch @media_continuation_fixture(%epoch, %tokens, %results, %expected) : (tensor<1532xi32>, tensor<18x8xi32>, tensor<336xi32>, tensor<12x8xi32>)
  kernel.launch @continue_media(%epoch, %tokens, %results) : (tensor<1532xi32>, tensor<18x8xi32>, tensor<336xi32>)
  %active = check.tensor.view %tokens offset(0) : tensor<18x8xi32> -> tensor<12x8xi32>
  check.expect.bitwise actual(%active) expected(%expected) : tensor<12x8xi32>
  check.return
}
