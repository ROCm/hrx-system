func.decl @encode_epoch(%control_state: buffer, %plan: buffer, %inputs: buffer, %media_plan: buffer, %first_count: i32, %next_count: i32, %input_count: i32, %first_media_count: i32, %next_media_count: i32, %first_packet_capacity: i32, %next_packet_capacity: i32, %eos: i32, %metadata: buffer, %tokens: buffer) -> (i32)

func.decl @publish_epoch(%plan: buffer, %media_plan: buffer, %count: i32, %first_media_count: i32, %next_media_count: i32, %verified: i32, %continues: i32, %next_speculative_mask: i32, %ordinary: buffer, %first_results: buffer, %next_results: buffer, %progress: buffer)

// Native records carry distinct causal/source coordinates. Known IDs share
// one host stream but the queued continuation occupies its own device bank.
func.def @encode_observation() -> (i32, i32, i32, i32, i32, i32) {
  %origin = index.constant 0 : offset
  %plan_bytes = index.constant 1152 : offset
  %state_bytes = index.constant 416 : offset
  %input_bytes = index.constant 24 : offset
  %metadata_bytes = index.constant 6112 : offset
  %token_bytes = index.constant 4096 : offset
  %plan = buffer.alloca<private> align(4) %plan_bytes : buffer
  %state = buffer.alloca<private> align(4) %state_bytes : buffer
  %inputs = buffer.alloca<private> align(4) %input_bytes : buffer
  %metadata = buffer.alloca<private> align(4) %metadata_bytes : buffer
  %tokens = buffer.alloca<private> align(4) %token_bytes : buffer
  %zero = scalar.constant 0 : i32
  %one = scalar.constant 1 : i32
  %two = scalar.constant 2 : i32
  %three = scalar.constant 3 : i32
  %six = scalar.constant 6 : i32
  %row = scalar.constant 7 : i32
  %causal_position = scalar.constant 100 : i32
  %source_position = scalar.constant 23 : i32
  %eos = scalar.constant 42 : i32
  buffer.fill %zero, %plan[%origin], %plan_bytes : i32
  buffer.fill %zero, %state[%origin], %state_bytes : i32
  buffer.fill %zero, %metadata[%origin], %metadata_bytes : i32
  %requests = buffer.view %plan[%origin] : buffer -> view<32x9xi32>
  view.store %two, %requests[0, 0] : i32, view<32x9xi32>
  view.store %causal_position, %requests[0, 1] : i32, view<32x9xi32>
  view.store %source_position, %requests[0, 2] : i32, view<32x9xi32>
  view.store %row, %requests[0, 3] : i32, view<32x9xi32>
  view.store %one, %requests[0, 4] : i32, view<32x9xi32>
  view.store %two, %requests[0, 5] : i32, view<32x9xi32>
  view.store %one, %requests[0, 6] : i32, view<32x9xi32>
  view.store %three, %requests[16, 0] : i32, view<32x9xi32>
  view.store %causal_position, %requests[16, 1] : i32, view<32x9xi32>
  view.store %source_position, %requests[16, 2] : i32, view<32x9xi32>
  view.store %row, %requests[16, 3] : i32, view<32x9xi32>
  view.store %three, %requests[16, 4] : i32, view<32x9xi32>
  view.store %three, %requests[16, 5] : i32, view<32x9xi32>
  view.store %one, %requests[16, 6] : i32, view<32x9xi32>
  %ids = buffer.view %inputs[%origin] : buffer -> view<6xi32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c6 = index.constant 6 : index
  %base = scalar.constant 899 : i32
  scf.for %i = [%c0 to %c6 step %c1] {
    %index32 = index.cast %i : index to i32
    %token = scalar.addi %base, %index32 : i32
    view.store %token, %ids[%i] : i32, view<6xi32>
  }
  %outputs = func.call @encode_epoch(%state, %plan, %inputs, %plan, %one, %one, %six, %zero, %zero, %zero, %zero, %eos, %metadata, %tokens) : (buffer, buffer, buffer, buffer, i32, i32, i32, i32, i32, i32, i32, i32, buffer, buffer) -> (i32)
  %descriptor_origin = index.constant 12 : offset
  %descriptor = buffer.view %metadata[%descriptor_origin] : buffer -> view<5xi32>
  %actual_position = view.load %descriptor[1] : view<5xi32> -> i32
  %actual_row = view.load %descriptor[3] : view<5xi32> -> i32
  %actual_source = view.load %descriptor[4] : view<5xi32> -> i32
  %active = buffer.view %tokens[%origin] : buffer -> view<512xi32>
  %first_token = view.load %active[0] : view<512xi32> -> i32
  %queued_origin = index.constant 2048 : offset
  %queued = buffer.view %tokens[%queued_origin] : buffer -> view<512xi32>
  %last_token = view.load %queued[2] : view<512xi32> -> i32
  func.return %outputs, %actual_position, %actual_row, %actual_source, %first_token, %last_token : i32, i32, i32, i32, i32, i32
}

check.case public @encode_distinct_source_frontier {
  %outputs, %position, %row, %source, %first_token, %last_token = func.call @encode_observation() : () -> (i32, i32, i32, i32, i32, i32)
  %one = check.literal value(1) : i32
  %expected_position = check.literal value(100) : i32
  %expected_row = check.literal value(7) : i32
  %expected_source = check.literal value(23553) : i32
  %expected_first_token = check.literal value(900) : i32
  %expected_last_token = check.literal value(904) : i32
  check.expect.equal actual(%outputs) expected(%one) : i32
  check.expect.equal actual(%position) expected(%expected_position) : i32
  check.expect.equal actual(%row) expected(%expected_row) : i32
  check.expect.equal actual(%source) expected(%expected_source) : i32
  check.expect.equal actual(%first_token) expected(%expected_first_token) : i32
  check.expect.equal actual(%last_token) expected(%expected_last_token) : i32
  check.return
}

// One known span and one verified span share completion. The continuation
// refers to first-result slot one, independently of its compacted result slot.
func.def @publish_observation() -> (i32, i32, i32, i32, i32, i32, i32) {
  %origin = index.constant 0 : offset
  %plan_bytes = index.constant 1152 : offset
  %result_bytes = index.constant 704 : offset
  %progress_bytes = index.constant 1344 : offset
  %plan = buffer.alloca<private> align(4) %plan_bytes : buffer
  %first = buffer.alloca<private> align(4) %result_bytes : buffer
  %next = buffer.alloca<private> align(4) %result_bytes : buffer
  %progress = buffer.alloca<private> align(4) %progress_bytes : buffer
  %zero = scalar.constant 0 : i32
  %one = scalar.constant 1 : i32
  %two = scalar.constant 2 : i32
  %three = scalar.constant 3 : i32
  %four = scalar.constant 4 : i32
  %none = scalar.constant -1 : i32
  buffer.fill %zero, %plan[%origin], %plan_bytes : i32
  buffer.fill %zero, %first[%origin], %result_bytes : i32
  buffer.fill %zero, %next[%origin], %result_bytes : i32
  %tag_origin = index.constant 640 : offset
  %tag_bytes = index.constant 64 : offset
  buffer.fill %none, %next[%tag_origin], %tag_bytes : i32
  %requests = buffer.view %plan[%origin] : buffer -> view<32x9xi32>
  %source0 = scalar.constant 23 : i32
  %source1 = scalar.constant 41 : i32
  view.store %three, %requests[0, 0] : i32, view<32x9xi32>
  view.store %source0, %requests[0, 2] : i32, view<32x9xi32>
  view.store %four, %requests[1, 0] : i32, view<32x9xi32>
  view.store %source1, %requests[1, 2] : i32, view<32x9xi32>
  view.store %four, %requests[1, 7] : i32, view<32x9xi32>
  %first_records = buffer.view %first[%origin] : buffer -> view<16x10xi32>
  view.store %three, %first_records[0, 0] : i32, view<16x10xi32>
  view.store %two, %first_records[1, 0] : i32, view<16x10xi32>
  view.store %two, %first_records[1, 1] : i32, view<16x10xi32>
  %token0 = scalar.constant 900 : i32
  %token1 = scalar.constant 901 : i32
  %token2 = scalar.constant 902 : i32
  view.store %token0, %first_records[1, 2] : i32, view<16x10xi32>
  view.store %token1, %first_records[1, 3] : i32, view<16x10xi32>
  %next_records = buffer.view %next[%origin] : buffer -> view<16x10xi32>
  view.store %one, %next_records[0, 0] : i32, view<16x10xi32>
  view.store %one, %next_records[0, 1] : i32, view<16x10xi32>
  view.store %token2, %next_records[0, 2] : i32, view<16x10xi32>
  %tags = buffer.view %next[%tag_origin] : buffer -> view<16xi32>
  view.store %one, %tags[0] : i32, view<16xi32>
  func.call @publish_epoch(%plan, %plan, %two, %zero, %zero, %one, %one, %two, %first, %first, %next, %progress) : (buffer, buffer, i32, i32, i32, i32, i32, i32, buffer, buffer, buffer, buffer)
  %published = buffer.view %progress[%origin] : buffer -> view<16x21xi32>
  %known0 = view.load %published[0, 1] : view<16x21xi32> -> i32
  %advanced0 = view.load %published[0, 4] : view<16x21xi32> -> i32
  %known1 = view.load %published[1, 1] : view<16x21xi32> -> i32
  %outputs1 = view.load %published[1, 2] : view<16x21xi32> -> i32
  %verified1 = view.load %published[1, 3] : view<16x21xi32> -> i32
  %advanced1 = view.load %published[1, 4] : view<16x21xi32> -> i32
  %last_token = view.load %published[1, 7] : view<16x21xi32> -> i32
  func.return %known0, %advanced0, %known1, %outputs1, %verified1, %advanced1, %last_token : i32, i32, i32, i32, i32, i32, i32
}

check.case public @publish_known_and_speculative_frontiers {
  %known0, %source0, %known1, %outputs1, %verified1, %source1, %last_token = func.call @publish_observation() : () -> (i32, i32, i32, i32, i32, i32, i32)
  %zero = check.literal value(0) : i32
  %two = check.literal value(2) : i32
  %three = check.literal value(3) : i32
  %expected_source0 = check.literal value(26) : i32
  %expected_source1 = check.literal value(44) : i32
  %expected_token = check.literal value(902) : i32
  check.expect.equal actual(%known0) expected(%three) : i32
  check.expect.equal actual(%source0) expected(%expected_source0) : i32
  check.expect.equal actual(%known1) expected(%zero) : i32
  check.expect.equal actual(%outputs1) expected(%three) : i32
  check.expect.equal actual(%verified1) expected(%two) : i32
  check.expect.equal actual(%source1) expected(%expected_source1) : i32
  check.expect.equal actual(%last_token) expected(%expected_token) : i32
  check.return
}
