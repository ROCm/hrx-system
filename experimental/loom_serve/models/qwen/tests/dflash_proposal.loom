kernel.decl @qwen38_dflash_proposal_prepare() launch(%epoch: buffer, %target_tokens: buffer, %draft: buffer, %origins: buffer, %anchors: buffer, %draft_tokens: buffer, %selection: buffer)
kernel.decl @qwen38_dflash_proposal_publish() launch(%draft: buffer, %origins: buffer, %proposals: buffer, %target_tokens: buffer)
kernel.decl @qwen38_dflash_selection_rows(%blocks: index) launch(%blocks: index, %draft: buffer, %normalized: buffer, %output: buffer)

// Sixteen mixed spans pack long known inputs and eight-token verification
// spans. Reversed resident rows distinguish cache rows from compact slots.
func.def @dflash_epoch_fixture(%trial: index, %epoch: buffer) {
  %origin = index.constant 0 : offset
  %descriptor_origin = index.constant 12 : offset
  %options_origin = index.constant 1548 : offset
  %header = buffer.view %epoch[%origin] : buffer -> view<3xi32>
  %spans = buffer.view %epoch[%descriptor_origin] : buffer -> view<64x5xi32>
  %options = buffer.view %epoch[%options_origin] : buffer -> view<64x2xi32>
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %sixteen = index.constant 16 : index
  %stride = index.constant 32 : index
  %eight = index.constant 8 : index
  %last = index.constant 15 : index
  %base = index.constant 100 : index
  %all = index.cmp eq, %trial, %two : index
  %mixed = index.cmp eq, %trial, %one : index
  %n = scalar.constant 16 : i32
  %generated = scalar.constant 2 : i32
  %zero_word = scalar.constant 0 : i32
  view.store %n, %header[1] : i32, view<3xi32>
  %end = scf.for %i = [%zero to %sixteen step %one](%begin = %zero : index) -> (index) {
    %parity = index.rem %i, %two : index
    %odd = index.cmp eq, %parity, %one : index
    %some = scalar.andi %mixed, %odd : i1
    %selected = scalar.ori %all, %some : i1
    %flag = index.cast %parity : index to i32
    %mode = scf.select %selected, %generated, %flag : i32
    %verification = scalar.cmpi ne, %mode, %zero_word : i32
    %extent = scf.select %verification, %eight, %stride : index
    %length = index.cast %extent : index to i32
    %row = index.sub %last, %i : index
    %position = index.add %base, %i : index
    %begin_word = index.cast %begin : index to i32
    %row_word = index.cast %row : index to i32
    %position_word = index.cast %position : index to i32
    view.store %length, %spans[%i, 0] : i32, view<64x5xi32>
    view.store %position_word, %spans[%i, 1] : i32, view<64x5xi32>
    view.store %begin_word, %spans[%i, 2] : i32, view<64x5xi32>
    view.store %row_word, %spans[%i, 3] : i32, view<64x5xi32>
    view.store %mode, %options[%i, 0] : i32, view<64x2xi32>
    %next = index.add %begin, %extent : index
    scf.yield %next : index
  }
  %end_word = index.cast %end : index to i32
  view.store %end_word, %header[0] : i32, view<3xi32>
  func.return
}

func.def @dflash_prepare_reference(%epoch: buffer, %target_tokens: buffer, %draft: buffer, %origins: buffer, %anchors: buffer, %draft_tokens: buffer, %selection: buffer) {
  %origin = index.constant 0 : offset
  %descriptor_origin = index.constant 12 : offset
  %options_origin = index.constant 1548 : offset
  %header = buffer.view %epoch[%origin] : buffer -> view<3xi32>
  %spans = buffer.view %epoch[%descriptor_origin] : buffer -> view<64x5xi32>
  %options = buffer.view %epoch[%options_origin] : buffer -> view<64x2xi32>
  %tokens = buffer.view %target_tokens[%origin] : buffer -> view<512xi32>
  %out_header = buffer.view %draft[%origin] : buffer -> view<3xi32>
  %out_spans = buffer.view %draft[%descriptor_origin] : buffer -> view<64x5xi32>
  %mapping = buffer.view %origins[%origin] : buffer -> view<64xi32>
  %anchor_view = buffer.view %anchors[%origin] : buffer -> view<64xi32>
  %inputs = buffer.view %draft_tokens[%origin] : buffer -> view<512xi32>
  %selected = buffer.view %selection[%origin] : buffer -> view<3xi32>
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %seven = index.constant 7 : index
  %eight = index.constant 8 : index
  %slots = index.constant 64 : index
  %capacity = index.constant 512 : index
  %zero_word = scalar.constant 0 : i32
  %two_word = scalar.constant 2 : i32
  %eight_word = scalar.constant 8 : i32
  %mask = scalar.constant 248070 : i32
  scf.for %i = [%zero to %capacity step %one] {
    view.store %mask, %inputs[%i] : i32, view<512xi32>
  }
  scf.for %i = [%zero to %slots step %one] {
    view.store %zero_word, %anchor_view[%i] : i32, view<64xi32>
  }
  %length_word = view.load %header[1] : view<3xi32> -> i32
  %length0 = index.cast %length_word : i32 to index
  %length = index.assume %length0 [range(%length0, 0, 64)] : index
  %count = scf.for %i = [%zero to %length step %one](%count0 = %zero : index) -> (index) {
    %count = index.assume %count0 [range(%count0, 0, 63)] : index
    %flag = view.load %options[%i, 0] : view<64x2xi32> -> i32
    %generated = scalar.cmpi eq, %flag, %two_word : i32
    %next = scf.if %generated -> (index) {
      %start_word = view.load %spans[%i, 2] : view<64x5xi32> -> i32
      %start0 = index.cast %start_word : i32 to index
      %start = index.assume %start0 [range(%start0, 0, 504)] : index
      %token = view.load %tokens[%start] : view<512xi32> -> i32
      %position = view.load %spans[%i, 1] : view<64x5xi32> -> i32
      %row = view.load %spans[%i, 3] : view<64x5xi32> -> i32
      %begin = index.mul %count, %eight : index
      %output = index.mul %count, %seven : index
      %begin_word = index.cast %begin : index to i32
      %output_word = index.cast %output : index to i32
      view.store %eight_word, %out_spans[%count, 0] : i32, view<64x5xi32>
      view.store %position, %out_spans[%count, 1] : i32, view<64x5xi32>
      view.store %begin_word, %out_spans[%count, 2] : i32, view<64x5xi32>
      view.store %row, %out_spans[%count, 3] : i32, view<64x5xi32>
      view.store %output_word, %out_spans[%count, 4] : i32, view<64x5xi32>
      view.store %start_word, %mapping[%count] : i32, view<64xi32>
      view.store %token, %anchor_view[%count] : i32, view<64xi32>
      view.store %token, %inputs[%begin] : i32, view<512xi32>
      %next = index.add %count, %one : index
      scf.yield %next : index
    } else {
      scf.yield %count : index
    }
    scf.yield %next : index
  }
  %token_count = index.mul %count, %eight : index
  %selection_count = index.mul %count, %seven : index
  %count_word = index.cast %count : index to i32
  %token_word = index.cast %token_count : index to i32
  %selection_word = index.cast %selection_count : index to i32
  view.store %token_word, %out_header[0] : i32, view<3xi32>
  view.store %count_word, %out_header[1] : i32, view<3xi32>
  view.store %selection_word, %out_header[2] : i32, view<3xi32>
  view.store %selection_word, %selected[0] : i32, view<3xi32>
  view.store %count_word, %selected[1] : i32, view<3xi32>
  view.store %selection_word, %selected[2] : i32, view<3xi32>
  func.return
}

func.def @dflash_publish_reference(%draft: buffer, %origins: buffer, %proposals: buffer, %target_tokens: buffer) {
  %origin = index.constant 0 : offset
  %header = buffer.view %draft[%origin] : buffer -> view<3xi32>
  %count_word = view.load %header[1] : view<3xi32> -> i32
  %count0 = index.cast %count_word : i32 to index
  %count = index.assume %count0 [range(%count0, 0, 64)] : index
  %mapping = buffer.view %origins[%origin] : buffer -> view<64xi32>
  %predictions = buffer.view %proposals[%origin] : buffer -> view<64x7xi32>
  %tokens = buffer.view %target_tokens[%origin] : buffer -> view<512xi32>
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %seven = index.constant 7 : index
  scf.for %i = [%zero to %count step %one] {
    %begin_word = view.load %mapping[%i] : view<64xi32> -> i32
    %begin0 = index.cast %begin_word : i32 to index
    %begin = index.assume %begin0 [range(%begin0, 0, 504)] : index
    %first = index.add %begin, %one : index
    scf.for %j = [%zero to %seven step %one] {
      %token = view.load %predictions[%i, %j] : view<64x7xi32> -> i32
      %destination = index.add %first, %j : index
      view.store %token, %tokens[%destination] : i32, view<512xi32>
    }
  }
  func.return
}

func.def @dflash_rows_reference(%blocks: index, %draft: buffer, %normalized: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %header = buffer.view %draft[%origin] : buffer -> view<3xi32>
  %count_word = view.load %header[1] : view<3xi32> -> i32
  %count = index.cast %count_word : i32 to index
  %input = buffer.view %normalized[%origin] : buffer -> view<[%blocks]x8x5120xf32>
  %result = buffer.view %output[%origin] : buffer -> view<[%blocks]x7x5120xf32>
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %seven = index.constant 7 : index
  %width = index.constant 5120 : index
  %zero_f = scalar.constant 0.0 : f32
  scf.for %block = [%zero to %blocks step %one] {
    %active = index.cmp ult, %block, %count : index
    scf.for %position = [%zero to %seven step %one] {
      %source = index.add %position, %one : index
      scf.for %channel = [%zero to %width step %one] {
        %value = scf.if %active -> (f32) {
          %value = view.load %input[%block, %source, %channel] : view<[%blocks]x8x5120xf32> -> f32
          scf.yield %value : f32
        } else {
          scf.yield %zero_f : f32
        }
        view.store %value, %result[%block, %position, %channel] : f32, view<[%blocks]x7x5120xf32>
      }
    }
  }
  func.return
}

check.scenario public @dflash_proposal_control {
  check.trial[3](%trial: index, %entropy: check.entropy) {
    %epoch = check.generate.fill value(-99) : tensor<516xi32>
    check.generate<@dflash_epoch_fixture>(%trial, %epoch) : (index, tensor<516xi32>) -> ()
    %target = check.generate.iota offset(1000) step(1) : tensor<512xi32>
    %draft = check.generate.fill value(-99) : tensor<323xi32>
    %origins = check.generate.fill value(-99) : tensor<64xi32>
    %anchors = check.generate.fill value(-99) : tensor<64xi32>
    %inputs = check.generate.fill value(-99) : tensor<512xi32>
    %selection = check.generate.fill value(-99) : tensor<3xi32>
    check.compare<@qwen38_dflash_proposal_prepare, @dflash_prepare_reference>(%epoch, %target, %draft, %origins, %anchors, %inputs, %selection) : (tensor<516xi32>, tensor<512xi32>, tensor<323xi32>, tensor<64xi32>, tensor<64xi32>, tensor<512xi32>, tensor<3xi32>) -> () {
      check.expect.bitwise actual(%draft) expected(%draft) : tensor<323xi32>
      check.expect.bitwise actual(%origins) expected(%origins) : tensor<64xi32>
      check.expect.bitwise actual(%anchors) expected(%anchors) : tensor<64xi32>
      check.expect.bitwise actual(%inputs) expected(%inputs) : tensor<512xi32>
      check.expect.bitwise actual(%selection) expected(%selection) : tensor<3xi32>
    }
  }
  check.return
}

check.scenario public @dflash_proposal_publication {
  check.trial[3](%trial: index, %entropy: check.entropy) {
    %epoch = check.generate.fill value(-99) : tensor<516xi32>
    check.generate<@dflash_epoch_fixture>(%trial, %epoch) : (index, tensor<516xi32>) -> ()
    %target = check.generate.iota offset(1000) step(1) : tensor<512xi32>
    %draft = check.generate.fill value(-99) : tensor<323xi32>
    %origins = check.generate.fill value(-99) : tensor<64xi32>
    %anchors = check.generate.fill value(-99) : tensor<64xi32>
    %inputs = check.generate.fill value(-99) : tensor<512xi32>
    %selection = check.generate.fill value(-99) : tensor<3xi32>
    check.generate<@dflash_prepare_reference>(%epoch, %target, %draft, %origins, %anchors, %inputs, %selection) : (tensor<516xi32>, tensor<512xi32>, tensor<323xi32>, tensor<64xi32>, tensor<64xi32>, tensor<512xi32>, tensor<3xi32>) -> ()
    %proposals = check.generate.iota offset(10000) step(1) : tensor<64x7xi32>
    check.compare<@qwen38_dflash_proposal_publish, @dflash_publish_reference>(%draft, %origins, %proposals, %target) : (tensor<323xi32>, tensor<64xi32>, tensor<64x7xi32>, tensor<512xi32>) -> () {
      check.expect.bitwise actual(%target) expected(%target) : tensor<512xi32>
    }
  }
  check.return
}

check.scenario public @dflash_proposal_rows {
  check.trial[3](%trial: index, %entropy: check.entropy) {
    %epoch = check.generate.fill value(-99) : tensor<516xi32>
    check.generate<@dflash_epoch_fixture>(%trial, %epoch) : (index, tensor<516xi32>) -> ()
    %target = check.generate.iota offset(1000) step(1) : tensor<512xi32>
    %draft = check.generate.fill value(-99) : tensor<323xi32>
    %origins = check.generate.fill value(-99) : tensor<64xi32>
    %anchors = check.generate.fill value(-99) : tensor<64xi32>
    %inputs = check.generate.fill value(-99) : tensor<512xi32>
    %selection = check.generate.fill value(-99) : tensor<3xi32>
    check.generate<@dflash_prepare_reference>(%epoch, %target, %draft, %origins, %anchors, %inputs, %selection) : (tensor<516xi32>, tensor<512xi32>, tensor<323xi32>, tensor<64xi32>, tensor<64xi32>, tensor<512xi32>, tensor<3xi32>) -> ()
    %blocks = check.literal value(16) : index
    %normalized = check.generate.iota offset(0.0) step(0.0000152587890625) : tensor<16x8x5120xf32>
    %compact = check.generate.fill value(-99.0) : tensor<16x7x5120xf32>
    check.compare<@qwen38_dflash_selection_rows, @dflash_rows_reference>[%blocks](%blocks, %draft, %normalized, %compact) : [index](index, tensor<323xi32>, tensor<16x8x5120xf32>, tensor<16x7x5120xf32>) -> () {
      check.expect.bitwise actual(%compact) expected(%compact) : tensor<16x7x5120xf32>
    }
  }
  check.return
}
