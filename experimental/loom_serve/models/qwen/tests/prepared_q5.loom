check.case public @qwen38_prepared_narrow {
  %tokens = check.literal value(32) : index
  %inputs = check.literal value(5120) : index
  %outputs = check.param.choice values([48, 64, 80, 96, 112, 128, 17408]) name("channels") : index
  %control = check.generate.fill value(32) : tensor<1xi32>
  %seed = check.param.seed base(934871) count(2) : i64
  %input = check.generate.random.uniform seed(%seed) range(-1.0 to 1.0) : tensor<32x5120xf32>
  %weight = check.generate.random.uniform seed(%seed) range(0 to 31) : tensor<[%outputs]x20x176xi8>
  %expected = check.generate.fill value(-17.0) : tensor<32x[%outputs]xf32>
  %actual = check.generate.fill value(-17.0) : tensor<32x[%outputs]xf32>
  kernel.launch @qwen38_linear_q5k_f16_wmma_c64t32_f32acc[%tokens, %inputs, %outputs](%control, %inputs, %outputs, %input, %weight, %expected) : [index, index, index](tensor<1xi32>, index, index, tensor<32x5120xf32>, tensor<[%outputs]x20x176xi8>, tensor<32x[%outputs]xf32>)
  kernel.launch @qwen38_prepare_q5k_channel8[%outputs](%weight) : [index](tensor<[%outputs]x20x176xi8>)
  kernel.launch @qwen38_linear_q5k_f16_wmma_c64t32_f32acc_channel8[%tokens, %inputs, %outputs](%control, %inputs, %outputs, %input, %weight, %actual) : [index, index, index](tensor<1xi32>, index, index, tensor<32x5120xf32>, tensor<[%outputs]x20x176xi8>, tensor<32x[%outputs]xf32>)
  check.expect.bitwise actual(%actual) expected(%expected) : tensor<32x[%outputs]xf32>
  check.return
}

