kernel.decl @qwen38_gdn_conv_prepare_prefill(%token_count: index) launch(%control: buffer, %epsilon: f32, %input: buffer, %weight: buffer, %history: buffer, %output: buffer, %inverse_norm: buffer)
kernel.decl @qwen38_gdn_recurrent_prefill_x4(%token_count: index) launch(%control: buffer, %qkv: buffer, %inverse_norm: buffer, %alpha: buffer, %beta: buffer, %a: buffer, %bias: buffer, %state: buffer, %output: buffer)
kernel.decl @qwen38_gdn_conv_spans(%span_capacity: index) launch(%epoch: buffer, %rows: buffer, %layer_origin: offset, %epsilon: f32, %qkv: buffer, %weight: buffer, %state: buffer, %output: buffer, %inverse_norm: buffer)
kernel.decl @qwen38_gdn_recurrent_spans(%span_capacity: index) launch(%epoch: buffer, %rows: buffer, %layer_origin: offset, %qkv: buffer, %inverse_norm: buffer, %alpha: buffer, %beta: buffer, %a: buffer, %bias: buffer, %state: buffer, %output: buffer)
kernel.decl @qwen38_gdn_conv_verify_spans(%span_capacity: index) launch(%epoch: buffer, %rows: buffer, %layer_origin: offset, %epsilon: f32, %qkv: buffer, %weight: buffer, %state: buffer, %output: buffer, %inverse_norm: buffer)
kernel.decl @qwen38_gdn_recurrent_verify_spans(%span_capacity: index) launch(%epoch: buffer, %rows: buffer, %layer_origin: offset, %qkv: buffer, %inverse_norm: buffer, %alpha: buffer, %beta: buffer, %a: buffer, %bias: buffer, %state: buffer, %output: buffer)

// One immutable anchor and two private destinations contain complete layers.
// Verification considers four inputs per branch; replay accepts three and one.
kernel.def @fork_metadata() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%epoch: buffer, %accepted: buffer, %rows: buffer) {
  %origin = index.constant 0 : offset
  %descriptors_origin = index.constant 12 : offset
  %options_origin = index.constant 1548 : offset
  %header = buffer.view %epoch[%origin] : buffer -> view<3xi32>
  %spans = buffer.view %epoch[%descriptors_origin] : buffer -> view<2x5xi32>
  %options = buffer.view %epoch[%options_origin] : buffer -> view<2x2xi32>
  %accepted_header = buffer.view %accepted[%origin] : buffer -> view<3xi32>
  %accepted_spans = buffer.view %accepted[%descriptors_origin] : buffer -> view<2x5xi32>
  %table = buffer.view %rows[%origin] : buffer -> view<2x4xi64>
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %zero_word = scalar.constant 0 : i32
  %one_word = scalar.constant 1 : i32
  %two_word = scalar.constant 2 : i32
  %three_word = scalar.constant 3 : i32
  %four_word = scalar.constant 4 : i32
  %eight_word = scalar.constant 8 : i32
  %position = scalar.constant 127 : i32
  %none = scalar.constant -1 : i32
  %anchor = scalar.constant 256 : i64
  %stride = scalar.constant 3269120 : i64
  %first_writer = scalar.constant 3269376 : i64
  %frontier = scalar.constant 127 : i64
  %zero64 = scalar.constant 0 : i64
  view.store %eight_word, %header[0] : i32, view<3xi32>
  view.store %two_word, %header[1] : i32, view<3xi32>
  view.store %zero_word, %header[2] : i32, view<3xi32>
  view.store %eight_word, %accepted_header[0] : i32, view<3xi32>
  view.store %two_word, %accepted_header[1] : i32, view<3xi32>
  view.store %zero_word, %accepted_header[2] : i32, view<3xi32>
  scf.for %row = [%zero to %two step %one] {
    %row_word = index.cast %row : index to i32
    %begin = scalar.muli %row_word, %four_word : i32
    %difference = scalar.muli %row_word, %two_word : i32
    %count = scalar.subi %three_word, %difference : i32
    view.store %four_word, %spans[%row, 0] : i32, view<2x5xi32>
    view.store %position, %spans[%row, 1] : i32, view<2x5xi32>
    view.store %begin, %spans[%row, 2] : i32, view<2x5xi32>
    view.store %row_word, %spans[%row, 3] : i32, view<2x5xi32>
    view.store %none, %spans[%row, 4] : i32, view<2x5xi32>
    view.store %one_word, %options[%row, 0] : i32, view<2x2xi32>
    view.store %four_word, %options[%row, 1] : i32, view<2x2xi32>
    view.store %count, %accepted_spans[%row, 0] : i32, view<2x5xi32>
    view.store %position, %accepted_spans[%row, 1] : i32, view<2x5xi32>
    view.store %begin, %accepted_spans[%row, 2] : i32, view<2x5xi32>
    view.store %row_word, %accepted_spans[%row, 3] : i32, view<2x5xi32>
    view.store %none, %accepted_spans[%row, 4] : i32, view<2x5xi32>
    %wide_row = index.cast %row : index to i64
    %relative = scalar.muli %wide_row, %stride : i64
    %writer = scalar.addi %first_writer, %relative : i64
    view.store %anchor, %table[%row, 0] : i64, view<2x4xi64>
    view.store %writer, %table[%row, 1] : i64, view<2x4xi64>
    view.store %zero64, %table[%row, 2] : i64, view<2x4xi64>
    view.store %frontier, %table[%row, 3] : i64, view<2x4xi64>
  }
  kernel.return
}

// The queued successor advances position only. It has no row-table binding.
kernel.def @advance_fork_positions() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%epoch: buffer) {
  %origin = index.constant 12 : offset
  %spans = buffer.view %epoch[%origin] : buffer -> view<2x5xi32>
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  scf.for %row = [%zero to %two step %one] {
    %count = view.load %spans[%row, 0] : view<2x5xi32> -> i32
    %position = view.load %spans[%row, 1] : view<2x5xi32> -> i32
    %next = scalar.addi %position, %count : i32
    view.store %next, %spans[%row, 1] : i32, view<2x5xi32>
  }
  kernel.return
}

// Expectations observe final buffers. Read-only verification is a separate
// case from accepted replay followed by another queued advance.
check.case public @gdn_shared_read_only {
  %capacity = check.literal value(2) : index
  %state_origin = check.literal value(0) : offset
  %history_origin = check.literal value(3145728) : offset
  %epoch = check.generate.fill value(-99) : tensor<516xi32>
  %accepted = check.generate.fill value(-99) : tensor<516xi32>
  %rows = check.generate.fill value(-1) : tensor<2x4xi64>
  %epsilon = check.literal value(9.9999999999999995e-07) : f32
  %control = check.generate.fill value(4) : tensor<2xi32>
  %input = check.generate.iota offset(-0.5) step(1.52587890625e-05) period(65521) : tensor<8x10240xf32>
  %weight = check.generate.iota offset(-0.125) step(0.0001220703125) period(2048) : tensor<40960xf32>
  %alpha = check.generate.iota offset(-0.25) step(0.0013020833333333333) : tensor<8x48xf32>
  %beta = check.generate.iota offset(0.5) step(-0.00065104166666666663) : tensor<8x48xf32>
  %a = check.generate.fill value(-0.5) : tensor<48xf32>
  %bias = check.generate.iota offset(0.0625) step(0.001953125) : tensor<48xf32>
  %state = check.generate.iota offset(-0.03125) step(9.5367431640625e-07) period(8191) : tensor<2451840xf32>
  %untouched = check.generate.iota offset(-0.03125) step(9.5367431640625e-07) period(8191) : tensor<2451840xf32>
  %reference0 = check.generate.iota offset(-0.03125) step(9.5367431640625e-07) period(8191) : tensor<817280xf32>
  %reference1 = check.generate.iota offset(-0.03125) step(9.5367431640625e-07) period(8191) : tensor<817280xf32>
  %qkv = check.generate.fill value(9.125) : tensor<8x10240xf32>
  %expected_qkv = check.generate.fill value(9.125) : tensor<8x10240xf32>
  %norm = check.generate.fill value(9.125) : tensor<8x32xf32>
  %expected_norm = check.generate.fill value(9.125) : tensor<8x32xf32>
  %output = check.generate.fill value(9.125) : tensor<8x6144xf32>
  %expected_output = check.generate.fill value(9.125) : tensor<8x6144xf32>
  %count0 = check.literal value(4) : index
  %control0 = check.tensor.view %control offset(0) : tensor<2xi32> -> tensor<1xi32>
  %input0 = check.tensor.view %input offset(0) : tensor<8x10240xf32> -> tensor<4x10240xf32>
  %qkv0 = check.tensor.view %expected_qkv offset(0) : tensor<8x10240xf32> -> tensor<4x10240xf32>
  %norm0 = check.tensor.view %expected_norm offset(0) : tensor<8x32xf32> -> tensor<4x32xf32>
  %alpha0 = check.tensor.view %alpha offset(0) : tensor<8x48xf32> -> tensor<4x48xf32>
  %beta0 = check.tensor.view %beta offset(0) : tensor<8x48xf32> -> tensor<4x48xf32>
  %output0 = check.tensor.view %expected_output offset(0) : tensor<8x6144xf32> -> tensor<4x6144xf32>
  %reference_state0 = check.tensor.view %reference0 offset(256) : tensor<817280xf32> -> tensor<786432xf32>
  %reference_history0 = check.tensor.view %reference0 offset(3145984) : tensor<817280xf32> -> tensor<30720xf32>
  %reference_payload0 = check.tensor.view %reference0 offset(256) : tensor<817280xf32> -> tensor<817152xf32>
  %destination0 = check.tensor.view %state offset(3269376) : tensor<2451840xf32> -> tensor<817152xf32>
  %count1 = check.literal value(4) : index
  %control1 = check.tensor.view %control offset(4) : tensor<2xi32> -> tensor<1xi32>
  %input1 = check.tensor.view %input offset(163840) : tensor<8x10240xf32> -> tensor<4x10240xf32>
  %qkv1 = check.tensor.view %expected_qkv offset(163840) : tensor<8x10240xf32> -> tensor<4x10240xf32>
  %norm1 = check.tensor.view %expected_norm offset(512) : tensor<8x32xf32> -> tensor<4x32xf32>
  %alpha1 = check.tensor.view %alpha offset(768) : tensor<8x48xf32> -> tensor<4x48xf32>
  %beta1 = check.tensor.view %beta offset(768) : tensor<8x48xf32> -> tensor<4x48xf32>
  %output1 = check.tensor.view %expected_output offset(98304) : tensor<8x6144xf32> -> tensor<4x6144xf32>
  %reference_state1 = check.tensor.view %reference1 offset(256) : tensor<817280xf32> -> tensor<786432xf32>
  %reference_history1 = check.tensor.view %reference1 offset(3145984) : tensor<817280xf32> -> tensor<30720xf32>
  %reference_payload1 = check.tensor.view %reference1 offset(256) : tensor<817280xf32> -> tensor<817152xf32>
  %destination1 = check.tensor.view %state offset(6538496) : tensor<2451840xf32> -> tensor<817152xf32>
  %source = check.tensor.view %state offset(256) : tensor<2451840xf32> -> tensor<817152xf32>
  %initial_source = check.tensor.view %untouched offset(256) : tensor<2451840xf32> -> tensor<817152xf32>

  // Verification computes both branches without publishing any state.
  kernel.launch @fork_metadata(%epoch, %accepted, %rows) : (tensor<516xi32>, tensor<516xi32>, tensor<2x4xi64>)
  kernel.launch @qwen38_gdn_conv_verify_spans[%capacity](%epoch, %rows, %history_origin, %epsilon, %input, %weight, %state, %qkv, %norm) : [index](tensor<516xi32>, tensor<2x4xi64>, offset, f32, tensor<8x10240xf32>, tensor<40960xf32>, tensor<2451840xf32>, tensor<8x10240xf32>, tensor<8x32xf32>)
  kernel.launch @qwen38_gdn_recurrent_verify_spans[%capacity](%epoch, %rows, %state_origin, %qkv, %norm, %alpha, %beta, %a, %bias, %state, %output) : [index](tensor<516xi32>, tensor<2x4xi64>, offset, tensor<8x10240xf32>, tensor<8x32xf32>, tensor<8x48xf32>, tensor<8x48xf32>, tensor<48xf32>, tensor<48xf32>, tensor<2451840xf32>, tensor<8x6144xf32>)
  kernel.launch @qwen38_gdn_conv_prepare_prefill[%count0](%control0, %epsilon, %input0, %weight, %reference_history0, %qkv0, %norm0) : [index](tensor<1xi32>, f32, tensor<4x10240xf32>, tensor<40960xf32>, tensor<30720xf32>, tensor<4x10240xf32>, tensor<4x32xf32>)
  kernel.launch @qwen38_gdn_recurrent_prefill_x4[%count0](%control0, %qkv0, %norm0, %alpha0, %beta0, %a, %bias, %reference_state0, %output0) : [index](tensor<1xi32>, tensor<4x10240xf32>, tensor<4x32xf32>, tensor<4x48xf32>, tensor<4x48xf32>, tensor<48xf32>, tensor<48xf32>, tensor<786432xf32>, tensor<4x6144xf32>)
  kernel.launch @qwen38_gdn_conv_prepare_prefill[%count1](%control1, %epsilon, %input1, %weight, %reference_history1, %qkv1, %norm1) : [index](tensor<1xi32>, f32, tensor<4x10240xf32>, tensor<40960xf32>, tensor<30720xf32>, tensor<4x10240xf32>, tensor<4x32xf32>)
  kernel.launch @qwen38_gdn_recurrent_prefill_x4[%count1](%control1, %qkv1, %norm1, %alpha1, %beta1, %a, %bias, %reference_state1, %output1) : [index](tensor<1xi32>, tensor<4x10240xf32>, tensor<4x32xf32>, tensor<4x48xf32>, tensor<4x48xf32>, tensor<48xf32>, tensor<48xf32>, tensor<786432xf32>, tensor<4x6144xf32>)
  check.expect.bitwise actual(%qkv) expected(%expected_qkv) : tensor<8x10240xf32>
  check.expect.bitwise actual(%norm) expected(%expected_norm) : tensor<8x32xf32>
  check.expect.bitwise actual(%output) expected(%expected_output) : tensor<8x6144xf32>
  check.expect.bitwise actual(%source) expected(%initial_source) : tensor<817152xf32>
  check.expect.bitwise actual(%state) expected(%untouched) : tensor<2451840xf32>
  check.return
}

