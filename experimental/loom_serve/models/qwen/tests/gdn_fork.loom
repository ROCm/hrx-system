  check.expect.bitwise actual(%guard2) expected(%expected_guard2) : tensor<128xf32>
  %guard3 = check.tensor.view %state offset(9807104) : tensor<2451840xf32> -> tensor<64xf32>
  %expected_guard3 = check.tensor.view %untouched offset(9807104) : tensor<2451840xf32> -> tensor<64xf32>
  check.expect.bitwise actual(%guard3) expected(%expected_guard3) : tensor<64xf32>
  check.return
