  %verified_output = check.generate.fill value(9.125) : tensor<8x6144xf32>
  kernel.launch @qwen38_gdn_conv_verify_spans[%capacity](%epoch, %rows, %history_origin, %epsilon, %input, %weight, %state, %verified_qkv, %verified_norm) : [index](tensor<516xi32>, tensor<2x4xi64>, offset, f32, tensor<8x10240xf32>, tensor<40960xf32>, tensor<2451840xf32>, tensor<8x10240xf32>, tensor<8x32xf32>)
  kernel.launch @qwen38_gdn_recurrent_verify_spans[%capacity](%epoch, %rows, %state_origin, %verified_qkv, %verified_norm, %alpha, %beta, %a, %bias, %state, %verified_output) : [index](tensor<516xi32>, tensor<2x4xi64>, offset, tensor<8x10240xf32>, tensor<8x32xf32>, tensor<8x48xf32>, tensor<8x48xf32>, tensor<48xf32>, tensor<48xf32>, tensor<2451840xf32>, tensor<8x6144xf32>)
