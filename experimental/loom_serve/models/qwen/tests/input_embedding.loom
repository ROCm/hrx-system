  %zero = scalar.constant 0 : i32
  buffer.fill %zero, %packet[%origin], %record_bytes : i32
  %records = buffer.view %packet[%origin] : buffer -> view<4x8xi32>
  %two = scalar.constant 2 : i32
  %image_pad = scalar.constant 248056 : i32
  %first_feature = scalar.constant 128 : i32
  %second_feature = scalar.constant 20608 : i32
  view.store %two, %records[0, 0] : i32, view<4x8xi32>
  view.store %image_pad, %records[1, 0] : i32, view<4x8xi32>
  view.store %first_feature, %records[1, 1] : i32, view<4x8xi32>
  view.store %image_pad, %records[3, 0] : i32, view<4x8xi32>
  view.store %second_feature, %records[3, 1] : i32, view<4x8xi32>
  kernel.return
}

