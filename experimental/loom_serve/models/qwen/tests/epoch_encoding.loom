func.decl @encode_epoch(%control_state: buffer, %plan: buffer, %inputs: buffer, %media_plan: buffer, %first_count: i32, %next_count: i32, %input_count: i32, %first_media_count: i32, %next_media_count: i32, %first_packet_capacity: i32, %next_packet_capacity: i32, %eos: i32, %metadata: buffer, %tokens: buffer) -> (i32)

// A nearly full first epoch and a short second epoch share one contiguous host
// input stream. The expected device image uses two independent tensor rows,
// including the untouched padding between each epoch and the next plane.
func.def @encoding_fixture(%capacity_value: index, %plan: buffer, %inputs: buffer, %expected: buffer) {
  %capacity = index.assume %capacity_value [range(%capacity_value, 8, 32768)] : index
  %origin = index.constant 0 : offset
  %requests = buffer.view %plan[%origin] : buffer -> view<32x9xi32>
  %input = buffer.view %inputs[%origin] : buffer -> view<[%capacity]xi32>
  %output = buffer.view %expected[%origin] : buffer -> view<2x[%capacity]xi32>
  %zero = scalar.constant 0 : i32
  %one = scalar.constant 1 : i32
  %three = scalar.constant 3 : i32
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c3 = index.constant 3 : index
  %c5 = index.constant 5 : index
  %first_length = index.sub %capacity, %c5 : index
  %first_word = index.cast %first_length : index to i32
  %causal = scalar.constant 100 : i32
  %source = scalar.constant 23 : i32
  %row = scalar.constant 7 : i32
  view.store %first_word, %requests[0, 0] : i32, view<32x9xi32>
  view.store %causal, %requests[0, 1] : i32, view<32x9xi32>
  view.store %source, %requests[0, 2] : i32, view<32x9xi32>
  view.store %row, %requests[0, 3] : i32, view<32x9xi32>
  view.store %first_word, %requests[0, 5] : i32, view<32x9xi32>
  view.store %three, %requests[16, 0] : i32, view<32x9xi32>
  view.store %causal, %requests[16, 1] : i32, view<32x9xi32>
  view.store %source, %requests[16, 2] : i32, view<32x9xi32>
  view.store %row, %requests[16, 3] : i32, view<32x9xi32>
  view.store %first_word, %requests[16, 4] : i32, view<32x9xi32>
  view.store %three, %requests[16, 5] : i32, view<32x9xi32>
  view.store %one, %requests[16, 6] : i32, view<32x9xi32>
  %first_base = scalar.constant 1000 : i32
  %next_base = scalar.constant 9000 : i32
  scf.for %token = [%c0 to %capacity step %c1] {
    %word = index.cast %token : index to i32
    %first_id = scalar.addi %first_base, %word : i32
    view.store %first_id, %input[%token] : i32, view<[%capacity]xi32>
    %first_live = index.cmp ult, %token, %first_length : index
    %first = scf.select %first_live, %first_id, %zero : i32
    view.store %first, %output[0, %token] : i32, view<2x[%capacity]xi32>
    %next_id = scalar.addi %next_base, %word : i32
    %next_live = index.cmp ult, %token, %c3 : index
    %next = scf.select %next_live, %next_id, %zero : i32
    view.store %next, %output[1, %token] : i32, view<2x[%capacity]xi32>
  }
  scf.for %token = [%c0 to %c3 step %c1] {
    %destination = index.add %first_length, %token : index
    %word = index.cast %token : index to i32
    %id = scalar.addi %next_base, %word : i32
    view.store %id, %input[%destination] : i32, view<[%capacity]xi32>
  }
  func.return
}

// Exercise the real VM entry point and compare both complete planes with the
// independently constructed image. The output buffer begins with a sentinel.
func.def @encode_token_planes(%capacity: index) -> (i1, i32, i32, i32, i32) {
  %origin = index.constant 0 : offset
  %policy_bytes = index.constant 416 : offset
  %plan_bytes = index.constant 1152 : offset
  %metadata_bytes = index.constant 6112 : offset
  %word_bytes = index.constant 4 : offset
  %input_bytes = index.scale %capacity, %word_bytes : index, offset -> offset
  %token_bytes = index.add %input_bytes, %input_bytes : offset
  %policy = buffer.alloca<private> align(4) %policy_bytes : buffer
  %plan = buffer.alloca<private> align(4) %plan_bytes : buffer
  %inputs = buffer.alloca<private> align(4) %input_bytes : buffer
  %metadata = buffer.alloca<private> align(4) %metadata_bytes : buffer
  %tokens = buffer.alloca<private> align(4) %token_bytes : buffer
  %expected = buffer.alloca<private> align(4) %token_bytes : buffer
  %zero = scalar.constant 0 : i32
  %sentinel = scalar.constant -99 : i32
  buffer.fill %zero, %policy[%origin], %policy_bytes : i32
  buffer.fill %zero, %plan[%origin], %plan_bytes : i32
  buffer.fill %sentinel, %metadata[%origin], %metadata_bytes : i32
  buffer.fill %sentinel, %tokens[%origin], %token_bytes : i32
  func.call @encoding_fixture(%capacity, %plan, %inputs, %expected) : (index, buffer, buffer, buffer)
  %one = scalar.constant 1 : i32
  %eos = scalar.constant 42 : i32
  %capacity_word = index.cast %capacity : index to i32
  %two = scalar.constant 2 : i32
  %input_count = scalar.subi %capacity_word, %two : i32
  %outputs = func.call @encode_epoch(%policy, %plan, %inputs, %inputs, %one, %one, %input_count, %zero, %zero, %zero, %zero, %eos, %metadata, %tokens) : (buffer, buffer, buffer, buffer, i32, i32, i32, i32, i32, i32, i32, i32, buffer, buffer) -> (i32)
  %no_outputs = scalar.cmpi eq, %outputs, %zero : i32
  %actual_view = buffer.view %tokens[%origin] : buffer -> view<2x[%capacity]xi32>
  %expected_view = buffer.view %expected[%origin] : buffer -> view<2x[%capacity]xi32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %correct = scf.for %plane = [%c0 to %c2 step %c1](%planes_equal = %no_outputs : i1) -> (i1) {
    %equal = scf.for %token = [%c0 to %capacity step %c1](%tokens_equal = %planes_equal : i1) -> (i1) {
      %actual = view.load %actual_view[%plane, %token] : view<2x[%capacity]xi32> -> i32
      %expected = view.load %expected_view[%plane, %token] : view<2x[%capacity]xi32> -> i32
      %same = scalar.cmpi eq, %actual, %expected : i32
      %equal = scalar.andi %tokens_equal, %same : i1
      scf.yield %equal : i1
    }
    scf.yield %equal : i1
  }
  %first_origin = index.constant 12 : offset
  %next_origin = index.constant 2332 : offset
  %first_descriptor = buffer.view %metadata[%first_origin] : buffer -> view<5xi32>
  %next_descriptor = buffer.view %metadata[%next_origin] : buffer -> view<5xi32>
  %causal = view.load %first_descriptor[1] : view<5xi32> -> i32
  %row = view.load %first_descriptor[3] : view<5xi32> -> i32
  %first_source = view.load %first_descriptor[4] : view<5xi32> -> i32
  %next_source = view.load %next_descriptor[4] : view<5xi32> -> i32
  func.return %correct, %causal, %row, %first_source, %next_source : i1, i32, i32, i32, i32
}

check.case public @queued_epoch_token_planes {
  %capacity = check.param.choice values([8, 513, 16384]) : index
  %expected = check.literal value(true) : i1
  %actual, %causal, %row, %first_source, %next_source = func.call @encode_token_planes(%capacity) : (index) -> (i1, i32, i32, i32, i32)
  %expected_causal = check.literal value(100) : i32
  %expected_row = check.literal value(7) : i32
  // Source position 23 occupies the upper bits; the selected continuation also
  // carries selection code one. Both plans precede device-side advancement.
  %expected_first_source = check.literal value(23552) : i32
  %expected_next_source = check.literal value(23553) : i32
  check.expect.equal actual(%actual) expected(%expected) : i1
  check.expect.equal actual(%causal) expected(%expected_causal) : i32
  check.expect.equal actual(%row) expected(%expected_row) : i32
  check.expect.equal actual(%first_source) expected(%expected_first_source) : i32
  check.expect.equal actual(%next_source) expected(%expected_next_source) : i32
  check.return
}

func.decl @publish_epoch(%plan: buffer, %media_plan: buffer, %count: i32, %first_media_count: i32, %next_media_count: i32, %verified: i32, %continues: i32, %next_speculative_mask: i32, %ordinary: buffer, %first_results: buffer, %next_results: buffer, %progress: buffer)

// Two requests have causal positions 100/200 and source positions 23/71.
// Ordinary feedback selects only the second request. Verified feedback accepts
// three speculative tokens for the first request and two known tokens for the
// second. Continuation record zero then contributes to request one, exercising
// tag-based ownership independently of the record order.
func.def @publish_fixture(%verified: i32) -> (i32, i32, i32, i32, i32, i32, i32, i32, i32, i32) {
  %origin = index.constant 0 : offset
  %plan_bytes = index.constant 1152 : offset
  %ordinary_bytes = index.constant 64 : offset
  %result_bytes = index.constant 704 : offset
  %progress_bytes = index.constant 1344 : offset
  %plan = buffer.alloca<private> align(4) %plan_bytes : buffer
  %ordinary = buffer.alloca<private> align(4) %ordinary_bytes : buffer
  %first_results = buffer.alloca<private> align(4) %result_bytes : buffer
  %next_results = buffer.alloca<private> align(4) %result_bytes : buffer
  %progress = buffer.alloca<private> align(4) %progress_bytes : buffer
  %zero = scalar.constant 0 : i32
  %one = scalar.constant 1 : i32
  %two = scalar.constant 2 : i32
  %three = scalar.constant 3 : i32
  %absent = scalar.constant -1 : i32
  buffer.fill %zero, %plan[%origin], %plan_bytes : i32
  buffer.fill %zero, %ordinary[%origin], %ordinary_bytes : i32
  buffer.fill %zero, %first_results[%origin], %result_bytes : i32
  buffer.fill %zero, %next_results[%origin], %result_bytes : i32
  buffer.fill %absent, %progress[%origin], %progress_bytes : i32
  %requests = buffer.view %plan[%origin] : buffer -> view<32x9xi32>
  %tokens = buffer.view %ordinary[%origin] : buffer -> view<16xi32>
  %first = buffer.view %first_results[%origin] : buffer -> view<16x10xi32>
  %next = buffer.view %next_results[%origin] : buffer -> view<16x10xi32>
  %tags_origin = index.constant 640 : offset
  buffer.fill %absent, %next_results[%tags_origin], %ordinary_bytes : i32
  %tags = buffer.view %next_results[%tags_origin] : buffer -> view<16xi32>
  %source0 = scalar.constant 23 : i32
  %source1 = scalar.constant 71 : i32
  %token42 = scalar.constant 42 : i32
  %token100 = scalar.constant 100 : i32
  %token101 = scalar.constant 101 : i32
  %token102 = scalar.constant 102 : i32
  %token200 = scalar.constant 200 : i32
  %token201 = scalar.constant 201 : i32
  %token202 = scalar.constant 202 : i32
  view.store %three, %requests[0, 0] : i32, view<32x9xi32>
  view.store %token100, %requests[0, 1] : i32, view<32x9xi32>
  view.store %source0, %requests[0, 2] : i32, view<32x9xi32>
  %verifies = scalar.cmpi ne, %verified, %zero : i32
  %credit = scf.select %verifies, %three, %zero : i32
  %second_length = scf.select %verifies, %two, %one : i32
  view.store %verified, %requests[0, 6] : i32, view<32x9xi32>
  view.store %credit, %requests[0, 7] : i32, view<32x9xi32>
  view.store %second_length, %requests[1, 0] : i32, view<32x9xi32>
  view.store %token200, %requests[1, 1] : i32, view<32x9xi32>
  view.store %source1, %requests[1, 2] : i32, view<32x9xi32>
  view.store %one, %requests[1, 6] : i32, view<32x9xi32>
  view.store %token42, %tokens[0] : i32, view<16xi32>
  view.store %three, %first[0, 0] : i32, view<16x10xi32>
  view.store %three, %first[0, 1] : i32, view<16x10xi32>
  view.store %token100, %first[0, 2] : i32, view<16x10xi32>
  view.store %token101, %first[0, 3] : i32, view<16x10xi32>
  view.store %token102, %first[0, 4] : i32, view<16x10xi32>
  view.store %two, %first[1, 0] : i32, view<16x10xi32>
  view.store %one, %first[1, 1] : i32, view<16x10xi32>
  view.store %token200, %first[1, 2] : i32, view<16x10xi32>
  view.store %two, %next[0, 0] : i32, view<16x10xi32>
  view.store %two, %next[0, 1] : i32, view<16x10xi32>
  view.store %token201, %next[0, 2] : i32, view<16x10xi32>
  view.store %token202, %next[0, 3] : i32, view<16x10xi32>
  view.store %one, %tags[0] : i32, view<16xi32>
  func.call @publish_epoch(%plan, %ordinary, %two, %zero, %zero, %verified, %verified, %two, %ordinary, %first_results, %next_results, %progress) : (buffer, buffer, i32, i32, i32, i32, i32, i32, buffer, buffer, buffer, buffer)
  %published = buffer.view %progress[%origin] : buffer -> view<16x21xi32>
  %consumed = view.load %published[1, 0] : view<16x21xi32> -> i32
  %known = view.load %published[1, 1] : view<16x21xi32> -> i32
  %outputs = view.load %published[1, 2] : view<16x21xi32> -> i32
  %verifications = view.load %published[1, 3] : view<16x21xi32> -> i32
  %source = view.load %published[1, 4] : view<16x21xi32> -> i32
  %token0 = view.load %published[1, 5] : view<16x21xi32> -> i32
  %token1 = view.load %published[1, 6] : view<16x21xi32> -> i32
  %token2 = view.load %published[1, 7] : view<16x21xi32> -> i32
  %first_source = view.load %published[0, 4] : view<16x21xi32> -> i32
  %first_token2 = view.load %published[0, 7] : view<16x21xi32> -> i32
  func.return %consumed, %known, %outputs, %verifications, %source, %token0, %token1, %token2, %first_source, %first_token2 : i32, i32, i32, i32, i32, i32, i32, i32, i32, i32
}

check.case public @ordinary_progress {
  %ordinary = check.literal value(0) : i32
  %consumed, %known, %outputs, %verifications, %source, %token0, %token1, %token2, %first_source, %first_token2 = func.call @publish_fixture(%ordinary) : (i32) -> (i32, i32, i32, i32, i32, i32, i32, i32, i32, i32)
  %zero = check.literal value(0) : i32
  %one = check.literal value(1) : i32
  %source26 = check.literal value(26) : i32
  %source72 = check.literal value(72) : i32
  %token42 = check.literal value(42) : i32
  check.expect.equal actual(%consumed) expected(%one) : i32
  check.expect.equal actual(%known) expected(%one) : i32
  check.expect.equal actual(%outputs) expected(%one) : i32
  check.expect.equal actual(%verifications) expected(%zero) : i32
  check.expect.equal actual(%source) expected(%source72) : i32
  check.expect.equal actual(%token0) expected(%token42) : i32
  check.expect.equal actual(%token1) expected(%zero) : i32
  check.expect.equal actual(%token2) expected(%zero) : i32
  check.expect.equal actual(%first_source) expected(%source26) : i32
  check.expect.equal actual(%first_token2) expected(%zero) : i32
  check.return
}

check.case public @verified_continuation_progress {
  %verified = check.literal value(1) : i32
  %consumed, %known, %outputs, %verifications, %source, %token0, %token1, %token2, %first_source, %first_token2 = func.call @publish_fixture(%verified) : (i32) -> (i32, i32, i32, i32, i32, i32, i32, i32, i32, i32)
  %one = check.literal value(1) : i32
  %two = check.literal value(2) : i32
  %three = check.literal value(3) : i32
  %four = check.literal value(4) : i32
  %source26 = check.literal value(26) : i32
  %source75 = check.literal value(75) : i32
  %token102 = check.literal value(102) : i32
  %token200 = check.literal value(200) : i32
  %token201 = check.literal value(201) : i32
  %token202 = check.literal value(202) : i32
  check.expect.equal actual(%consumed) expected(%four) : i32
  check.expect.equal actual(%known) expected(%two) : i32
  check.expect.equal actual(%outputs) expected(%three) : i32
  check.expect.equal actual(%verifications) expected(%one) : i32
  check.expect.equal actual(%source) expected(%source75) : i32
  check.expect.equal actual(%token0) expected(%token200) : i32
  check.expect.equal actual(%token1) expected(%token201) : i32
  check.expect.equal actual(%token2) expected(%token202) : i32
  check.expect.equal actual(%first_source) expected(%source26) : i32
  check.expect.equal actual(%first_token2) expected(%token102) : i32
  check.return
}
