// The queued plan/input banks and first results remain immutable. The native
// boundary establishes first-plan indices and worst-case shape/page capacity.
// Device acceptance resolves actual positions, credit and generated anchors;
// compaction preserves both known input and speculative survivors.
func.decl @qwen38_descriptor_selection(%word: i32) -> (i32)

func.decl @qwen38_descriptor_source_position(%word: i32) -> (i32)

func.decl @qwen38_descriptor_pack(%source_position: i32, %selection: i32) -> (i32)

config.decl @runner.qwen38.mixed_inputs : %value: index where [range(%value, 0, 1)]

func.def public @qwen38_continue_spans(%mixed_inputs: index, %context: index, %capacity_value: index, %epoch: buffer, %tokens: buffer, %results: buffer) {
  %capacity = index.assume %capacity_value [range(%capacity_value, 1, 2147483647)] : index
  %origin = index.constant 0 : offset
  %descriptor_origin = index.constant 12 : offset
  %selection_origin = index.constant 1292 : offset
  %options_origin = index.constant 1804 : offset
  %eos_origin = index.constant 2316 : offset
  %plan_origin = index.constant 2320 : offset
  %plan_descriptors = index.constant 2332 : offset
  %plan_options = index.constant 4124 : offset
  %indices_origin = index.constant 4640 : offset
  %identity_origin = index.constant 5088 : offset
  // Preparation supplies the allocation's plane capacity, independently of
  // the smaller execution shapes selected for either queued epoch.
  %word_bytes = index.constant 4 : offset
  %queued_origin = index.scale %capacity, %word_bytes : index, offset -> offset
  %next_origin = index.constant 640 : offset
  %tags_origin = index.constant 1280 : offset
  %header = buffer.view %epoch[%origin] : buffer -> view<3xi32>
  %spans = buffer.view %epoch[%descriptor_origin] : buffer -> view<64x5xi32>
  %selections = buffer.view %epoch[%selection_origin] : buffer -> view<128xi32>
  %options = buffer.view %epoch[%options_origin] : buffer -> view<64x2xi32>
  %terminal = buffer.view %epoch[%eos_origin] : buffer -> view<1xi32>
  %plan = buffer.view %epoch[%plan_origin] : buffer -> view<3xi32>
  %planned = buffer.view %epoch[%plan_descriptors] : buffer -> view<64x5xi32>
  %credits = buffer.view %epoch[%plan_options] : buffer -> view<64x2xi32>
  %indices = buffer.view %epoch[%indices_origin] : buffer -> view<16xi32>
  %identities = buffer.view %epoch[%identity_origin] : buffer -> view<128x2xi32>
  %prior = buffer.view %results[%origin] : buffer -> view<16x10xi32>
  %next = buffer.view %results[%next_origin] : buffer -> view<160xi32>
  %tags = buffer.view %results[%tags_origin] : buffer -> view<16xi32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c16 = index.constant 16 : index
  %result_words = index.constant 160 : index
  %c0_2 = scalar.constant 0 : i32
  %c1_2 = scalar.constant 1 : i32
  %none = scalar.constant -1 : i32
  %true = scalar.constant true : i1
  %c0_3 = vector.constant 0 : vector<4xi32>
  %mixed = index.cmp ne, %mixed_inputs, %c0 : index
  %packet_capacity, %next_capacity = scf.if %mixed -> (index, index) {
    %shape_origin = index.constant 6112 : offset
    %shape = buffer.view %epoch[%shape_origin] : buffer -> view<2xi32>
    %first_word = view.load %shape[0] : view<2xi32> -> i32
    %next_word = view.load %shape[1] : view<2xi32> -> i32
    %first_value = index.cast %first_word : i32 to index
    %next_value = index.cast %next_word : i32 to index
    %first = index.assume %first_value [range(%first_value, 1, 512)] : index
    %next = index.assume %next_value [range(%next_value, 1, 512)] : index
    scf.yield %first, %next : index, index
  } else {
    scf.yield %capacity, %capacity : index, index
  }
  %inputs = buffer.view %tokens[%origin] : buffer -> view<[%next_capacity]xi32>
  %queued = buffer.view %tokens[%queued_origin] : buffer -> view<[%next_capacity]xi32>
  %first_records = buffer.view %tokens[%origin] : buffer -> view<[%packet_capacity]x8xi32>
  %records = buffer.view %tokens[%origin] : buffer -> view<[%next_capacity]x8xi32>
  %record_bytes = index.constant 32 : offset
  %queued_record_origin = index.scale %packet_capacity, %record_bytes : index, offset -> offset
  %queued_records = buffer.view %tokens[%queued_record_origin] : buffer -> view<[%next_capacity]x8xi32>
  // Snapshot accepted source frontiers before in-place record and descriptor
  // compaction. These sixteen words disappear in the ordinary specialization.
  %source_bytes = index.constant 64 : offset
  %sources = buffer.alloca<private> align(4) %source_bytes : buffer
  %source_positions = buffer.view %sources[%origin] : buffer -> view<16xi32>
  scf.if %mixed {
    %first_count_word = view.load %header[1] : view<3xi32> -> i32
    %first_count_value = index.cast %first_count_word : i32 to index
    %first_count = index.assume %first_count_value [range(%first_count_value, 1, 16)] : index
    scf.for %i = [%c0 to %first_count step %c1] {
      %begin_word = view.load %spans[%i, 2] : view<64x5xi32> -> i32
      %consumed_word = view.load %prior[%i, 0] : view<16x10xi32> -> i32
      %end_word = scalar.addi %begin_word, %consumed_word : i32
      %last_word = scalar.subi %end_word, %c1_2 : i32
      %last_value = index.cast %last_word : i32 to index
      %last = index.assume %last_value [ge(%last_value, 0), lt(%last_value, %packet_capacity)] : index
      %source = view.load %first_records[%last, 5] : view<[%packet_capacity]x8xi32> -> i32
      view.store %source, %source_positions[%i] : i32, view<16xi32>
    }
  } else {
    %packet_count = index.div %next_capacity, %c4 : index
    %packet_end = index.mul %packet_count, %c4 : index
    %input_packets = buffer.view %tokens[%origin] : buffer -> view<[%packet_count]x4xi32>
    scf.for %packet = [%c0 to %packet_count step %c1] {
      vector.store %c0_3, %input_packets[%packet, 0] : vector<4xi32>, view<[%packet_count]x4xi32>
    }
    scf.for %i = [%packet_end to %next_capacity step %c1] {
      view.store %c0_2, %inputs[%i] : i32, view<[%next_capacity]xi32>
    }
  }
  scf.for %i = [%c0 to %result_words step %c4] {
    vector.store %c0_3, %next[%i] : vector<4xi32>, view<160xi32>
  }
  scf.for %i = [%c0 to %c16 step %c1] {
    view.store %none, %tags[%i] : i32, view<16xi32>
  }
  %eos = view.load %terminal[0] : view<1xi32> -> i32
  %context_word = index.cast %context : index to i32
  %count_word = view.load %plan[1] : view<3xi32> -> i32
  %count_value = index.cast %count_word : i32 to index
  %count = index.assume %count_value [range(%count_value, 0, 16)] : index
  %live_count, %total, %output_count = scf.for %span = [%c0 to %count step %c1](%live = %c0 : index, %begin = %c0 : index, %selected = %c0 : index) -> (index, index, index) {
    %tag = view.load %indices[%span] : view<16xi32> -> i32
    %tag_value = index.cast %tag : i32 to index
    %first = index.assume %tag_value [range(%tag_value, 0, 15)] : index
    %consumed = view.load %prior[%first, 0] : view<16x10xi32> -> i32
    %emitted = view.load %prior[%first, 1] : view<16x10xi32> -> i32
    %length_word = view.load %planned[%span, 0] : view<64x5xi32> -> i32
    %position = view.load %planned[%span, 1] : view<64x5xi32> -> i32
    %source_word = view.load %planned[%span, 2] : view<64x5xi32> -> i32
    %row = view.load %planned[%span, 3] : view<64x5xi32> -> i32
    %descriptor_word = view.load %planned[%span, 4] : view<64x5xi32> -> i32
    %selection = func.call @qwen38_descriptor_selection(%descriptor_word) : (i32) -> (i32)
    %source_position = func.call @qwen38_descriptor_source_position(%descriptor_word) : (i32) -> (i32)
    %flag = view.load %credits[%span, 0] : view<64x2xi32> -> i32
    %credit = view.load %credits[%span, 1] : view<64x2xi32> -> i32
    %speculative = scalar.cmpi ne, %flag, %c0_2 : i32
    %advanced = scalar.addi %position, %consumed : i32
    %advanced_source = scf.if %mixed -> (i32) {
      %source = view.load %source_positions[%first] : view<16xi32> -> i32
      scf.yield %source : i32
    } else {
      %source = scalar.addi %source_position, %consumed : i32
      scf.yield %source : i32
    }
    %remaining = scalar.subi %credit, %emitted : i32
    %continues, %prediction = scf.if %speculative -> (i1, i32) {
      %last_word = scalar.addi %emitted, %c1_2 : i32
      %last_value = index.cast %last_word : i32 to index
      %last = index.assume %last_value [range(%last_value, 2, 9)] : index
      %prediction = view.load %prior[%first, %last] : view<16x10xi32> -> i32
      %extent = scalar.addi %advanced, %length_word : i32
      %fits = scalar.cmpi ule, %extent, %context_word : i32
      // A final single output uses ordinary decode. Admission reserves the
      // speculative high-water only while at least two outputs remain.
      %credited = scalar.cmpi sgt, %remaining, %c1_2 : i32
      %not_eos = scalar.cmpi ne, %prediction, %eos : i32
      %ready = scalar.andi %fits, %credited : i1
      %continues = scalar.andi %ready, %not_eos : i1
      scf.yield %continues, %prediction : i1, i32
    } else {
      scf.yield %true, %c0_2 : i1, i32
    }
    %next_live, %next_begin, %next_selected = scf.if %continues -> (index, index, index) {
      %slot = index.assume %live [range(%live, 0, 15)] : index
      %begin_word = index.cast %begin : index to i32
      %has_output = scalar.cmpi sge, %selection, %c0_2 : i32
      %selected_word = index.cast %selected : index to i32
      %output = scf.select %has_output, %selected_word, %none : i32
      %packed_descriptor = func.call @qwen38_descriptor_pack(%advanced_source, %output) : (i32, i32) -> (i32)
      %length_value = index.cast %length_word : i32 to index
      %length = index.assume %length_value [range(%length_value, 1, %next_capacity)] : index
      view.store %length_word, %spans[%slot, 0] : i32, view<64x5xi32>
      view.store %advanced, %spans[%slot, 1] : i32, view<64x5xi32>
      view.store %begin_word, %spans[%slot, 2] : i32, view<64x5xi32>
      view.store %row, %spans[%slot, 3] : i32, view<64x5xi32>
      view.store %packed_descriptor, %spans[%slot, 4] : i32, view<64x5xi32>
      view.store %flag, %options[%slot, 0] : i32, view<64x2xi32>
      view.store %remaining, %options[%slot, 1] : i32, view<64x2xi32>
      view.store %tag, %tags[%slot] : i32, view<16xi32>
      scf.if %speculative {
        %anchor = index.assume %begin [ge(%begin, 0), lt(%begin, %next_capacity)] : index
        scf.if %mixed {
          scf.for %token = [%c0 to %length step %c1] {
            %target_value = index.add %begin, %token : index
            %target = index.assume %target_value [ge(%target_value, 0), lt(%target_value, %next_capacity)] : index
            %relative = index.cast %token : index to i32
            %position = scalar.addi %advanced_source, %relative : i32
            %following = scalar.addi %position, %c1_2 : i32
            %first_token = index.cmp eq, %token, %c0 : index
            %id = scf.select %first_token, %prediction, %c0_2 : i32
            view.store %id, %records[%target, 0] : i32, view<[%next_capacity]x8xi32>
            view.store %c0_2, %records[%target, 1] : i32, view<[%next_capacity]x8xi32>
            view.store %position, %records[%target, 2] : i32, view<[%next_capacity]x8xi32>
            view.store %position, %records[%target, 3] : i32, view<[%next_capacity]x8xi32>
            view.store %position, %records[%target, 4] : i32, view<[%next_capacity]x8xi32>
            view.store %following, %records[%target, 5] : i32, view<[%next_capacity]x8xi32>
            view.store %c0_2, %records[%target, 6] : i32, view<[%next_capacity]x8xi32>
            view.store %c0_2, %records[%target, 7] : i32, view<[%next_capacity]x8xi32>
          }
        } else {
          view.store %prediction, %inputs[%anchor] : i32, view<[%next_capacity]xi32>
        }
      } else {
        %source = index.cast %source_word : i32 to index
        scf.for %token = [%c0 to %length step %c1] {
          %source_value = index.add %source, %token : index
          %source_index = index.assume %source_value [ge(%source_value, 0), lt(%source_value, %next_capacity)] : index
          %target_value = index.add %begin, %token : index
          %target = index.assume %target_value [ge(%target_value, 0), lt(%target_value, %next_capacity)] : index
          scf.if %mixed {
            %low = vector.load %queued_records[%source_index, 0] : view<[%next_capacity]x8xi32> -> vector<4xi32>
            %high = vector.load %queued_records[%source_index, 4] : view<[%next_capacity]x8xi32> -> vector<4xi32>
            vector.store %low, %records[%target, 0] : vector<4xi32>, view<[%next_capacity]x8xi32>
            vector.store %high, %records[%target, 4] : vector<4xi32>, view<[%next_capacity]x8xi32>
          } else {
            %id = view.load %queued[%source_index] : view<[%next_capacity]xi32> -> i32
            view.store %id, %inputs[%target] : i32, view<[%next_capacity]xi32>
          }
        }
      }
      %selection_count = scf.if %has_output -> (index) {
        %selection_count = scf.select %speculative, %length, %c1 : index
        %end = index.add %begin, %length : index
        %selection_begin = index.sub %end, %selection_count : index
        scf.for %token = [%c0 to %selection_count step %c1] {
          %selection_value = index.add %selected, %token : index
          %selection_index = index.assume %selection_value [range(%selection_value, 0, 127)] : index
          %selected_token = index.add %selection_begin, %token : index
          %word = index.cast %selected_token : index to i32
          view.store %word, %selections[%selection_index] : i32, view<128xi32>
          %relative = index.sub %selected_token, %begin : index
          %relative_word = index.cast %relative : index to i32
          %input_position = scalar.addi %advanced, %relative_word : i32
          %target_position = scalar.addi %input_position, %c1_2 : i32
          view.store %row, %identities[%selection_index, 0] : i32, view<128x2xi32>
          view.store %target_position, %identities[%selection_index, 1] : i32, view<128x2xi32>
        }
        scf.yield %selection_count : index
      } else {
        scf.yield %c0 : index
      }
      %next_live = index.add %slot, %c1 : index
      %next_begin = index.add %begin, %length : index
      %next_selected = index.add %selected, %selection_count : index
      scf.yield %next_live, %next_begin, %next_selected : index, index, index
    } else {
      scf.yield %live, %begin, %selected : index, index, index
    }
    scf.yield %next_live, %next_begin, %next_selected : index, index, index
  }
  scf.if %mixed {
    scf.for %i = [%total to %next_capacity step %c1] {
      %record = index.assume %i [ge(%i, 0), lt(%i, %next_capacity)] : index
      vector.store %c0_3, %records[%record, 0] : vector<4xi32>, view<[%next_capacity]x8xi32>
      vector.store %c0_3, %records[%record, 4] : vector<4xi32>, view<[%next_capacity]x8xi32>
    }
  }
  %total_word = index.cast %total : index to i32
  %live_word = index.cast %live_count : index to i32
  %output_word = index.cast %output_count : index to i32
  view.store %total_word, %header[0] : i32, view<3xi32>
  view.store %live_word, %header[1] : i32, view<3xi32>
  view.store %output_word, %header[2] : i32, view<3xi32>
  func.return
}

kernel.def @qwen38_continue_dispatch() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%context: index, %capacity: index, %epoch: buffer, %tokens: buffer, %results: buffer) {
  %mixed_inputs = config.get @runner.qwen38.mixed_inputs : index
  func.call @qwen38_continue_spans(%mixed_inputs, %context, %capacity, %epoch, %tokens, %results) : (index, index, index, buffer, buffer, buffer)
  kernel.return
}
