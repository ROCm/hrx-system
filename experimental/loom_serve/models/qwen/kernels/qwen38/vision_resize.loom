amdgpu.target<gfx11-generic> @qwen38_resize_wave32 {subgroup_size = 32}

// Each group owns 32 columns and sixteen destination rows. Eight horizontal
// source rows are staged at a time; no image-sized intermediate is allocated.
kernel.def target(@qwen38_resize_wave32) @qwen38_vision_resize(%groups_x: index, %groups_y: index) {
  %c1 = index.constant 1 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%groups_x, %groups_y, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%image: index, %input: buffer, %output: buffer) where [range(%image, 0, 3)] {
  %origin = index.constant 0 : offset
  %ranges = buffer.view %input[%origin] : buffer -> view<4x2xi64>
  %packet_word = view.load %ranges[%image, 0] : view<4x2xi64> -> i64
  %packet_bounded = scalar.assume %packet_word [range(%packet_word, 0, 268435456)] : i64
  %packet_offset = index.cast %packet_bounded : i64 to offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c8 = index.constant 8 : index
  %c15 = index.constant 15 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %zero = scalar.constant 0.0 : f32
  %input_noalias, %output_noalias = buffer.assume.noalias %input, %output : buffer, buffer
  %header = buffer.view %input_noalias[%packet_offset] : buffer -> view<16xi32>
  %source_height_word = view.load %header[0] : view<16xi32> -> i32
  %source_width_word = view.load %header[1] : view<16xi32> -> i32
  %target_height_word = view.load %header[2] : view<16xi32> -> i32
  %target_width_word = view.load %header[3] : view<16xi32> -> i32
  %horizontal_count_word = view.load %header[4] : view<16xi32> -> i32
  %vertical_count_word = view.load %header[5] : view<16xi32> -> i32
  %source_count_word = view.load %header[6] : view<16xi32> -> i32
  %output_count_word = view.load %header[7] : view<16xi32> -> i32
  %source_height0 = index.cast %source_height_word : i32 to index
  %source_width0 = index.cast %source_width_word : i32 to index
  %target_height0 = index.cast %target_height_word : i32 to index
  %target_width0 = index.cast %target_width_word : i32 to index
  %horizontal_count0 = index.cast %horizontal_count_word : i32 to index
  %vertical_count0 = index.cast %vertical_count_word : i32 to index
  %source_count0 = index.cast %source_count_word : i32 to index
  %output_count0 = index.cast %output_count_word : i32 to index
  %source_height = index.assume %source_height0 [range(%source_height0, 1, 4096)] : index
  %source_width = index.assume %source_width0 [range(%source_width0, 1, 4096)] : index
  %target_height = index.assume %target_height0 [range(%target_height0, 1, 4096)] : index
  %target_width = index.assume %target_width0 [range(%target_width0, 1, 4096)] : index
  %horizontal_count = index.assume %horizontal_count0 [range(%horizontal_count0, 1, 32768)] : index
  %vertical_count = index.assume %vertical_count0 [range(%vertical_count0, 1, 32768)] : index
  %source_count = index.assume %source_count0 [range(%source_count0, 3, 67108864)] : index
  %output_count = index.assume %output_count0 [range(%output_count0, 3, 50331648)] : index
  %source_offset_word = view.load %header[8] : view<16xi32> -> i32
  %horizontal_starts_word = view.load %header[9] : view<16xi32> -> i32
  %horizontal_offsets_word = view.load %header[10] : view<16xi32> -> i32
  %horizontal_weights_word = view.load %header[11] : view<16xi32> -> i32
  %vertical_starts_word = view.load %header[12] : view<16xi32> -> i32
  %vertical_offsets_word = view.load %header[13] : view<16xi32> -> i32
  %vertical_weights_word = view.load %header[14] : view<16xi32> -> i32
  // Layout bits select RGBA, transposed axes, and reversed logical X/Y axes.
  %layout = view.load %header[15] : view<16xi32> -> i32
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %c2_i32 = scalar.constant 2 : i32
  %c3_i32 = scalar.constant 3 : i32
  %c4_i32 = scalar.constant 4 : i32
  %c8_i32 = scalar.constant 8 : i32
  %alpha_bit = scalar.andi %layout, %c1_i32 : i32
  %transpose_bit = scalar.andi %layout, %c2_i32 : i32
  %reverse_x_bit = scalar.andi %layout, %c4_i32 : i32
  %reverse_y_bit = scalar.andi %layout, %c8_i32 : i32
  %has_alpha = scalar.cmpi ne, %alpha_bit, %c0_i32 : i32
  %transpose = scalar.cmpi ne, %transpose_bit, %c0_i32 : i32
  %reverse_x = scalar.cmpi ne, %reverse_x_bit, %c0_i32 : i32
  %reverse_y = scalar.cmpi ne, %reverse_y_bit, %c0_i32 : i32
  %channels = scalar.addi %c3_i32, %alpha_bit : i32
  %physical_width = scf.select %transpose, %source_height_word, %source_width_word : i32
  %column_magnitude = scf.select %transpose, %physical_width, %c1_i32 : i32
  %row_magnitude = scf.select %transpose, %c1_i32, %physical_width : i32
  %negative_column = scalar.subi %c0_i32, %column_magnitude : i32
  %negative_row = scalar.subi %c0_i32, %row_magnitude : i32
  %column_stride = scf.select %reverse_x, %negative_column, %column_magnitude : i32
  %row_stride = scf.select %reverse_y, %negative_row, %row_magnitude : i32
  %last_column = scalar.subi %source_width_word, %c1_i32 : i32
  %last_row = scalar.subi %source_height_word, %c1_i32 : i32
  %column_span = scalar.muli %last_column, %column_magnitude : i32
  %row_span = scalar.muli %last_row, %row_magnitude : i32
  %column_origin = scf.select %reverse_x, %column_span, %c0_i32 : i32
  %row_origin = scf.select %reverse_y, %row_span, %c0_i32 : i32
  %pixel_origin = scalar.addi %column_origin, %row_origin : i32
  %source_relative = index.cast %source_offset_word : i32 to offset
  %source_offset = index.add %packet_offset, %source_relative : offset
  %horizontal_starts_relative = index.cast %horizontal_starts_word : i32 to offset
  %horizontal_starts_offset = index.add %packet_offset, %horizontal_starts_relative : offset
  %horizontal_offsets_relative = index.cast %horizontal_offsets_word : i32 to offset
  %horizontal_offsets_offset = index.add %packet_offset, %horizontal_offsets_relative : offset
  %horizontal_weights_relative = index.cast %horizontal_weights_word : i32 to offset
  %horizontal_weights_offset = index.add %packet_offset, %horizontal_weights_relative : offset
  %vertical_starts_relative = index.cast %vertical_starts_word : i32 to offset
  %vertical_starts_offset = index.add %packet_offset, %vertical_starts_relative : offset
  %vertical_offsets_relative = index.cast %vertical_offsets_word : i32 to offset
  %vertical_offsets_offset = index.add %packet_offset, %vertical_offsets_relative : offset
  %vertical_weights_relative = index.cast %vertical_weights_word : i32 to offset
  %vertical_weights_offset = index.add %packet_offset, %vertical_weights_relative : offset
  %horizontal_offsets_count = index.add %target_width, %c1 : index
  %vertical_offsets_count = index.add %target_height, %c1 : index
  %source = buffer.view %input_noalias[%source_offset] : buffer -> view<[%source_count]xi8>
  %horizontal_starts = buffer.view %input_noalias[%horizontal_starts_offset] : buffer -> view<[%target_width]xi32>
  %horizontal_offsets = buffer.view %input_noalias[%horizontal_offsets_offset] : buffer -> view<[%horizontal_offsets_count]xi32>
  %horizontal_weights = buffer.view %input_noalias[%horizontal_weights_offset] : buffer -> view<[%horizontal_count]xf32>
  %vertical_starts = buffer.view %input_noalias[%vertical_starts_offset] : buffer -> view<[%target_height]xi32>
  %vertical_offsets = buffer.view %input_noalias[%vertical_offsets_offset] : buffer -> view<[%vertical_offsets_count]xi32>
  %vertical_weights = buffer.view %input_noalias[%vertical_weights_offset] : buffer -> view<[%vertical_count]xf32>
  %result = buffer.view %output_noalias[%origin] : buffer -> view<[%output_count]xi8>

  %thread = kernel.workitem.id<x> : index
  %column = index.rem %thread, %c32 : index
  %source_lane = index.div %thread, %c32 : index
  %group_x = kernel.workgroup.id<x> : index
  %group_y = kernel.workgroup.id<y> : index
  %x0 = index.madd %group_x, %c32, %column : index
  %first_y0 = index.mul %group_y, %c16 : index
  %first_y = index.assume %first_y0 [lt(%first_y0, %target_height)] : index
  %last_target_y = index.sub %target_height, %c1 : index
  %last_y0 = index.add %first_y, %c15 : index
  %last_y1 = index.min %last_y0, %last_target_y : index
  %last_y = index.assume %last_y1 [ge(%last_y1, 0), lt(%last_y1, %target_height)] : index
  %last_y_next0 = index.add %last_y, %c1 : index
  %last_y_next = index.assume %last_y_next0 [ge(%last_y_next0, 1), lt(%last_y_next0, %vertical_offsets_count)] : index
  %band_begin_word = view.load %vertical_starts[%first_y] : view<[%target_height]xi32> -> i32
  %last_start_word = view.load %vertical_starts[%last_y] : view<[%target_height]xi32> -> i32
  %last_begin_word = view.load %vertical_offsets[%last_y] : view<[%vertical_offsets_count]xi32> -> i32
  %last_end_word = view.load %vertical_offsets[%last_y_next] : view<[%vertical_offsets_count]xi32> -> i32
  %last_count_word = scalar.subi %last_end_word, %last_begin_word : i32
  %band_end_word = scalar.addi %last_start_word, %last_count_word : i32
  %band_begin0 = index.cast %band_begin_word : i32 to index
  %band_end0 = index.cast %band_end_word : i32 to index
  %band_begin = index.assume %band_begin0 [ge(%band_begin0, 0), lt(%band_begin0, %source_height)] : index
  %band_end = index.assume %band_end0 [ge(%band_end0, 1), le(%band_end0, %source_height)] : index
  %live_x = index.cmp ult, %x0, %target_width : index
  %panel_bytes = index.constant 3072 : offset
  %panel_buffer = buffer.alloca<workgroup> align(16) %panel_bytes : buffer
  %panel = buffer.view %panel_buffer[%origin] : buffer -> view<8x32x3xf32>
  %accumulator_bytes = index.constant 24 : offset
  %accumulator_buffer = buffer.alloca<private> align(4) %accumulator_bytes : buffer
  %accumulators = buffer.view %accumulator_buffer[%origin] : buffer -> view<2x3xf32>
  scf.for %pixel = [%c0 to %c2 step %c1] unroll {
    scf.for %channel = [%c0 to %c3 step %c1] unroll {
      view.store %zero, %accumulators[%pixel, %channel] : f32, view<2x3xf32>
    }
  }

  scf.for %panel_begin = [%band_begin to %band_end step %c8] {
    %source_y0 = index.add %panel_begin, %source_lane : index
    %live_source_y = index.cmp ult, %source_y0, %band_end : index
    %live_source = scalar.andi %live_x, %live_source_y : i1
    %red, %green, %blue = scf.if %live_source -> (f32, f32, f32) {
      %x = index.assume %x0 [lt(%x0, %target_width)] : index
      %source_y = index.assume %source_y0 [lt(%source_y0, %source_height)] : index
      %next_x = index.add %x, %c1 : index
      %start_word = view.load %horizontal_starts[%x] : view<[%target_width]xi32> -> i32
      %begin_word = view.load %horizontal_offsets[%x] : view<[%horizontal_offsets_count]xi32> -> i32
      %end_word = view.load %horizontal_offsets[%next_x] : view<[%horizontal_offsets_count]xi32> -> i32
      %start = index.cast %start_word : i32 to index
      %begin0 = index.cast %begin_word : i32 to index
      %end0 = index.cast %end_word : i32 to index
      %begin = index.assume %begin0 [ge(%begin0, 0), lt(%begin0, %horizontal_count)] : index
      %end = index.assume %end0 [ge(%end0, 1), le(%end0, %horizontal_count)] : index
      %red_sum, %green_sum, %blue_sum = scf.for %tap = [%begin to %end step %c1](%r = %zero : f32, %g = %zero : f32, %b = %zero : f32) -> (f32, f32, f32) {
        %relative = index.sub %tap, %begin : index
        %source_x = index.add %start, %relative : index
        %source_x_i32 = index.cast %source_x : index to i32
        %source_y_i32 = index.cast %source_y : index to i32
        %column_delta = scalar.muli %source_x_i32, %column_stride : i32
        %row_delta = scalar.muli %source_y_i32, %row_stride : i32
        %row_pixel = scalar.addi %pixel_origin, %row_delta : i32
        %source_pixel = scalar.addi %row_pixel, %column_delta : i32
        %byte_index = scalar.muli %source_pixel, %channels : i32
        %red_index0 = index.cast %byte_index : i32 to index
        %green_index0 = index.add %red_index0, %c1 : index
        %blue_index0 = index.add %red_index0, %c2 : index
        %red_index = index.assume %red_index0 [ge(%red_index0, 0), lt(%red_index0, %source_count)] : index
        %green_index = index.assume %green_index0 [ge(%green_index0, 0), lt(%green_index0, %source_count)] : index
        %blue_index = index.assume %blue_index0 [ge(%blue_index0, 0), lt(%blue_index0, %source_count)] : index
        %red_byte = view.load %source[%red_index] : view<[%source_count]xi8> -> i8
        %green_byte = view.load %source[%green_index] : view<[%source_count]xi8> -> i8
        %blue_byte = view.load %source[%blue_index] : view<[%source_count]xi8> -> i8
        %red_wide = scalar.extui %red_byte : i8 to i32
        %green_wide = scalar.extui %green_byte : i8 to i32
        %blue_wide = scalar.extui %blue_byte : i8 to i32
        // Composite straight-alpha samples over white before interpolation.
        %red_rgb, %green_rgb, %blue_rgb = scf.if %has_alpha -> (i32, i32, i32) {
          %alpha_index0 = index.add %red_index, %c3 : index
          %alpha_index = index.assume %alpha_index0 [ge(%alpha_index0, 0), lt(%alpha_index0, %source_count)] : index
          %alpha_byte = view.load %source[%alpha_index] : view<[%source_count]xi8> -> i8
          %alpha = scalar.extui %alpha_byte : i8 to i32
          %c127 = scalar.constant 127 : i32
          %c255 = scalar.constant 255 : i32
          %inverse_alpha = scalar.subi %c255, %alpha : i32
          %white = scalar.muli %inverse_alpha, %c255 : i32
          %rounded_white = scalar.addi %white, %c127 : i32
          %red_product = scalar.muli %red_wide, %alpha : i32
          %green_product = scalar.muli %green_wide, %alpha : i32
          %blue_product = scalar.muli %blue_wide, %alpha : i32
          %red_numerator = scalar.addi %red_product, %rounded_white : i32
          %green_numerator = scalar.addi %green_product, %rounded_white : i32
          %blue_numerator = scalar.addi %blue_product, %rounded_white : i32
          %red_composite = scalar.divui %red_numerator, %c255 : i32
          %green_composite = scalar.divui %green_numerator, %c255 : i32
          %blue_composite = scalar.divui %blue_numerator, %c255 : i32
          scf.yield %red_composite, %green_composite, %blue_composite : i32, i32, i32
        } else {
          scf.yield %red_wide, %green_wide, %blue_wide : i32, i32, i32
        }
        %red_float = scalar.uitofp %red_rgb : i32 to f32
        %green_float = scalar.uitofp %green_rgb : i32 to f32
        %blue_float = scalar.uitofp %blue_rgb : i32 to f32
        %weight_index = index.assume %tap [ge(%tap, 0), lt(%tap, %horizontal_count)] : index
        %weight = view.load %horizontal_weights[%weight_index] : view<[%horizontal_count]xf32> -> f32
        %red_product = scalar.mulf %red_float, %weight : f32
        %green_product = scalar.mulf %green_float, %weight : f32
        %blue_product = scalar.mulf %blue_float, %weight : f32
        %next_red = scalar.addf %r, %red_product : f32
        %next_green = scalar.addf %g, %green_product : f32
        %next_blue = scalar.addf %b, %blue_product : f32
        scf.yield %next_red, %next_green, %next_blue : f32, f32, f32
      }
      scf.yield %red_sum, %green_sum, %blue_sum : f32, f32, f32
    } else {
      scf.yield %zero, %zero, %zero : f32, f32, f32
    }
    view.store %red, %panel[%source_lane, %column, 0] : f32, view<8x32x3xf32>
    view.store %green, %panel[%source_lane, %column, 1] : f32, view<8x32x3xf32>
    view.store %blue, %panel[%source_lane, %column, 2] : f32, view<8x32x3xf32>
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.for %pixel = [%c0 to %c2 step %c1] unroll {
      %row_offset = index.madd %pixel, %c8, %source_lane : index
      %y0 = index.add %first_y, %row_offset : index
      %live_y = index.cmp ult, %y0, %target_height : index
      %live = scalar.andi %live_x, %live_y : i1
      scf.if %live {
        %y = index.assume %y0 [lt(%y0, %target_height)] : index
        %next_y = index.add %y, %c1 : index
        %start_word = view.load %vertical_starts[%y] : view<[%target_height]xi32> -> i32
        %begin_word = view.load %vertical_offsets[%y] : view<[%vertical_offsets_count]xi32> -> i32
        %end_word = view.load %vertical_offsets[%next_y] : view<[%vertical_offsets_count]xi32> -> i32
        %start = index.cast %start_word : i32 to index
        %begin = index.cast %begin_word : i32 to index
        %end = index.cast %end_word : i32 to index
        %count = index.sub %end, %begin : index
        %source_end = index.add %start, %count : index
        scf.for %panel_row = [%c0 to %c8 step %c1] unroll {
          %source_y = index.add %panel_begin, %panel_row : index
          %after_start = index.cmp uge, %source_y, %start : index
          %before_end = index.cmp ult, %source_y, %source_end : index
          %has_weight = scalar.andi %after_start, %before_end : i1
          scf.if %has_weight {
            %relative = index.sub %source_y, %start : index
            %weight_index0 = index.add %begin, %relative : index
            %weight_index = index.assume %weight_index0 [ge(%weight_index0, 0), lt(%weight_index0, %vertical_count)] : index
            %weight = view.load %vertical_weights[%weight_index] : view<[%vertical_count]xf32> -> f32
            scf.for %channel = [%c0 to %c3 step %c1] unroll {
              %value = view.load %panel[%panel_row, %column, %channel] : view<8x32x3xf32> -> f32
              %prior = view.load %accumulators[%pixel, %channel] : view<2x3xf32> -> f32
              %product = scalar.mulf %value, %weight : f32
              %next = scalar.addf %prior, %product : f32
              view.store %next, %accumulators[%pixel, %channel] : f32, view<2x3xf32>
            }
          }
        }
      }
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  }
  scf.for %pixel = [%c0 to %c2 step %c1] unroll {
    %row_offset = index.madd %pixel, %c8, %source_lane : index
    %y = index.add %first_y, %row_offset : index
    %live_y = index.cmp ult, %y, %target_height : index
    %live = scalar.andi %live_x, %live_y : i1
    scf.if %live {
      %destination_pixel = index.madd %y, %target_width, %x0 : index
      scf.for %channel = [%c0 to %c3 step %c1] unroll {
        %value = view.load %accumulators[%pixel, %channel] : view<2x3xf32> -> f32
        %rounded = scalar.roundevenf %value : f32
        %maximum = scalar.constant 255.0 : f32
        %clamped_low = scalar.maxnumf %rounded, %zero : f32
        %clamped = scalar.minnumf %clamped_low, %maximum : f32
        %integer = scalar.fptoui %clamped : f32 to i32
        %byte = scalar.trunci %integer : i32 to i8
        %element0 = index.madd %destination_pixel, %c3, %channel : index
        %element = index.assume %element0 [lt(%element0, %output_count)] : index
        view.store %byte, %result[%element] : i8, view<[%output_count]xi8>
      }
    }
  }
  kernel.return
}
