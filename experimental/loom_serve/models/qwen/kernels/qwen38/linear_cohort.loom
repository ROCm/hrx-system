kernel.def @qwen38_linear_q6k_f32_cohort(%inputs: index, %outputs: index) {
  %c1 = index.constant 1 : index
  %channels = index.constant 2 : index
  %padding = index.constant 1 : index
  %threads = target.subgroup.size : index
  %padded = index.add %outputs, %padding : index
  %groups = index.div %padded, %channels : index
  kernel.launch.config workgroups(%groups, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%inputs: index, %outputs: index, %input: buffer, %weight: buffer, %output: buffer) {
  %rows = config.get @runner.qwen38.prefill_token_count : index
  %bounded_outputs = index.assume %outputs [range(%outputs, 1, 5120)] : index
  func.call @ggml_linear_q6k_f32_cohort(%rows, %inputs, %bounded_outputs, %input, %weight, %output) : (index, index, index, buffer, buffer, buffer)
  kernel.return
}
