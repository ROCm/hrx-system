// Model leaves bind cohort capacity and projection bounds. Shared GGML motifs
// receive SSA geometry and retain all checkpoint bits and scale metadata.
config.decl @runner.qwen38.prefill_token_count : %value: index where [range(%value, 1, 512)]

func.decl @ggml_linear_q5k_q8_1_cohort(%rows: index, %weight_channels: index, %inputs: index, %outputs: index, %input: buffer, %weight: buffer, %output: buffer)

func.decl @ggml_linear_q6k_q8_1_cohort(%rows: index, %block_lanes: index, %inputs: index, %outputs: index, %input: buffer, %weight: buffer, %output: buffer)

func.decl @ggml_linear_q6k_f32_cohort(%rows: index, %inputs: index, %outputs: index, %input: buffer, %weight: buffer, %output: buffer)

kernel.def @qwen38_linear_q5k_q8_1_cohort(%inputs: index, %outputs: index) {
  %c1 = index.constant 1 : index
  %threads = index.constant 256 : index
  %width = target.subgroup.size : index
  %channels = index.div %threads, %width : index
  %padding = index.sub %channels, %c1 : index
  %padded = index.add %outputs, %padding : index
  %groups = index.div %padded, %channels : index
  kernel.launch.config workgroups(%groups, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%inputs: index, %outputs: index, %input: buffer, %weight: buffer, %output: buffer) {
  %rows = config.get @runner.qwen38.prefill_token_count : index
  %layout = index.constant 1 : index
  %bounded_outputs = index.assume %outputs [range(%outputs, 1, 10240)] : index
  func.call @ggml_linear_q5k_q8_1_cohort(%rows, %layout, %inputs, %bounded_outputs, %input, %weight, %output) : (index, index, index, index, buffer, buffer, buffer)
  kernel.return
}

kernel.def @qwen38_linear_q5k_q8_1_channel8_cohort(%inputs: index, %outputs: index) {
  %c1 = index.constant 1 : index
  %threads = index.constant 256 : index
  %width = target.subgroup.size : index
  %channels = index.div %threads, %width : index
  %padding = index.sub %channels, %c1 : index
  %padded = index.add %outputs, %padding : index
  %groups = index.div %padded, %channels : index
  kernel.launch.config workgroups(%groups, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%inputs: index, %outputs: index, %input: buffer, %weight: buffer, %output: buffer) {
  %rows = config.get @runner.qwen38.prefill_token_count : index
  %layout = index.constant 8 : index
  %bounded_outputs = index.assume %outputs [range(%outputs, 1, 17408)] : index
  func.call @ggml_linear_q5k_q8_1_cohort(%rows, %layout, %inputs, %bounded_outputs, %input, %weight, %output) : (index, index, index, index, buffer, buffer, buffer)
  kernel.return
}

kernel.def @qwen38_linear_q6k_q8_1_cohort(%inputs: index, %outputs: index) {
  %c1 = index.constant 1 : index
  %threads = index.constant 256 : index
  %width = target.subgroup.size : index
  %channels = index.div %threads, %width : index
  %padding = index.sub %channels, %c1 : index
  %padded = index.add %outputs, %padding : index
  %groups = index.div %padded, %channels : index
  kernel.launch.config workgroups(%groups, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%inputs: index, %outputs: index, %input: buffer, %weight: buffer, %output: buffer) {
  %rows = config.get @runner.qwen38.prefill_token_count : index
  %block_lanes = index.constant 32 : index
  %bounded_outputs = index.assume %outputs [range(%outputs, 1, 12288)] : index
  func.call @ggml_linear_q6k_q8_1_cohort(%rows, %block_lanes, %inputs, %bounded_outputs, %input, %weight, %output) : (index, index, index, index, buffer, buffer, buffer)
  kernel.return
