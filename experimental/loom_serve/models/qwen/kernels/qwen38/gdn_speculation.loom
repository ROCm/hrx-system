func.decl @qwen38_span_active(%epoch: buffer, %span: index) -> (i1)
func.decl @qwen38_span_binding(%epoch: buffer, %span: index) -> (offset, index, index)
func.decl @qwen38_row_gdn_binding(%epoch: buffer, %control_origin: offset, %rows: buffer, %row: index, %layer_origin: offset) -> (offset, offset, i1)
template.decl @qwen38.gdn_conv_prepare_prefill.body(%publish: i1, %head: index, %thread: index, %epoch: buffer, %epsilon: f32, %qkv: buffer, %weight: buffer, %state: buffer, %output: buffer, %inverse_norm: buffer, %control_origin: offset, %token_begin: index, %history_origin: offset, %next_history_origin: offset)
template.decl @qwen38.gdn_recurrent_prefill_x4.body(%publish: i1, %head: index, %column: index, %lane: index, %epoch: buffer, %qkv: buffer, %inverse_norm: buffer, %alpha: buffer, %beta: buffer, %a: buffer, %bias: buffer, %state: buffer, %output: buffer, %control_origin: offset, %token_begin: index, %state_origin: offset, %next_state_origin: offset)

// Verification extends the immutable epoch after its 128 selected-row slots:
// 64 pairs of {speculative, output_limit}, followed by the EOS token. Known
// spans publish in the traversal; speculative spans publish only
// after acceptance. The ordinary five-word span and cold row layouts match.
func.def public inline @qwen38_span_speculative(%epoch: buffer, %span: index) -> (i1) {
  %origin = index.constant 1804 : offset
  %zero = scalar.constant 0 : i32
  %metadata = buffer.assume.memory_space<constant> %epoch : buffer
  %options = buffer.view %metadata[%origin] : buffer -> view<64x2xi32>
  %flag = view.load %options[%span, 0] : view<64x2xi32> -> i32
  %speculative = scalar.cmpi ne, %flag, %zero : i32
  func.return %speculative : i1
}

kernel.def export("qwen38_gdn_conv_verify_spans") @qwen38_gdn_conv_verify_spans(%span_capacity: index) {
  %spans = index.assume %span_capacity [range(%span_capacity, 1, 16)] : index
  %heads = index.constant 16 : index
  %threads = index.constant 256 : index
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%heads, %spans, %one) workgroup_size(%threads, %one, %one) : index
} launch(%epoch: buffer, %rows: buffer, %layer_origin: offset, %epsilon: f32, %qkv: buffer, %weight: buffer, %state: buffer, %output: buffer, %inverse_norm: buffer) {
  %span = kernel.workgroup.id<y> : index
  %active = func.call @qwen38_span_active(%epoch, %span) : (buffer, index) -> (i1)
  scf.if %active {
    %head_value = kernel.workgroup.id<x> : index
    %head = index.assume %head_value [range(%head_value, 0, 15)] : index
    %thread_value = kernel.workitem.id<x> : index
    %thread = index.assume %thread_value [range(%thread_value, 0, 255)] : index
    %control, %begin, %row = func.call @qwen38_span_binding(%epoch, %span) : (buffer, index) -> (offset, index, index)
    %history, %next_history, %first_advance = func.call @qwen38_row_gdn_binding(%epoch, %control, %rows, %row, %layer_origin) : (buffer, offset, buffer, index, offset) -> (offset, offset, i1)
    %speculative = func.call @qwen38_span_speculative(%epoch, %span) : (buffer, index) -> (i1)
    %true = scalar.constant true : i1
    %publish = scalar.xori %speculative, %true : i1
    scf.if %first_advance {
      template.apply<@qwen38.gdn_conv_prepare_prefill.body>(%publish, %head, %thread, %epoch, %epsilon, %qkv, %weight, %state, %output, %inverse_norm, %control, %begin, %history, %next_history) : (i1, index, index, buffer, f32, buffer, buffer, buffer, buffer, buffer, offset, index, offset, offset)
    } else {
      template.apply<@qwen38.gdn_conv_prepare_prefill.body>(%publish, %head, %thread, %epoch, %epsilon, %qkv, %weight, %state, %output, %inverse_norm, %control, %begin, %next_history, %next_history) : (i1, index, index, buffer, f32, buffer, buffer, buffer, buffer, buffer, offset, index, offset, offset)
    }
  }
  kernel.return
}

kernel.def export("qwen38_gdn_recurrent_verify_spans") @qwen38_gdn_recurrent_verify_spans(%span_capacity: index) {
  %spans = index.assume %span_capacity [range(%span_capacity, 1, 16)] : index
  %heads = index.constant 48 : index
  %columns = index.constant 32 : index
  %threads = index.constant 32 : index
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%heads, %columns, %spans) workgroup_size(%threads, %one, %one) : index
} launch(%epoch: buffer, %rows: buffer, %layer_origin: offset, %qkv: buffer, %inverse_norm: buffer, %alpha: buffer, %beta: buffer, %a: buffer, %bias: buffer, %state: buffer, %output: buffer) {
  %span = kernel.workgroup.id<z> : index
  %active = func.call @qwen38_span_active(%epoch, %span) : (buffer, index) -> (i1)
  scf.if %active {
    %head_value = kernel.workgroup.id<x> : index
    %head = index.assume %head_value [range(%head_value, 0, 47)] : index
    %column_value = kernel.workgroup.id<y> : index
    %column = index.assume %column_value [range(%column_value, 0, 31)] : index
    %lane_value = kernel.workitem.id<x> : index
    %lane = index.assume %lane_value [range(%lane_value, 0, 31)] : index
    %control, %begin, %row = func.call @qwen38_span_binding(%epoch, %span) : (buffer, index) -> (offset, index, index)
    %origin, %next_origin, %first_advance = func.call @qwen38_row_gdn_binding(%epoch, %control, %rows, %row, %layer_origin) : (buffer, offset, buffer, index, offset) -> (offset, offset, i1)
    %speculative = func.call @qwen38_span_speculative(%epoch, %span) : (buffer, index) -> (i1)
    %true = scalar.constant true : i1
    %publish = scalar.xori %speculative, %true : i1
    scf.if %first_advance {
      template.apply<@qwen38.gdn_recurrent_prefill_x4.body>(%publish, %head, %column, %lane, %epoch, %qkv, %inverse_norm, %alpha, %beta, %a, %bias, %state, %output, %control, %begin, %origin, %next_origin) : (i1, index, index, index, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, offset, index, offset, offset)
    } else {
      template.apply<@qwen38.gdn_recurrent_prefill_x4.body>(%publish, %head, %column, %lane, %epoch, %qkv, %inverse_norm, %alpha, %beta, %a, %bias, %state, %output, %control, %begin, %next_origin, %next_origin) : (i1, index, index, index, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, offset, index, offset, offset)
    }
  }
  kernel.return
}

// Each layer retains verification_width transitions per compiled span,
// independently of its padded token capacity. Capture slots keep original span
// placement even when acceptance compacts the replay descriptors.
// Known prompt/decode spans leave their slots untouched and are never replayed.
kernel.def export("qwen38_gdn_capture_spans") @qwen38_gdn_capture_spans(%span_capacity: index, %verification_width: index) {
  %spans = index.assume %span_capacity [range(%span_capacity, 1, 16)] : index
  %width = index.assume %verification_width [range(%verification_width, 1, 8)] : index
  %tiles_per_row = index.constant 10 : index
  %qkv_tiles = index.mul %width, %tiles_per_row : index
  %threads = index.constant 256 : index
  %one = index.constant 1 : index
  %tiles = index.add %qkv_tiles, %one : index
  kernel.launch.config workgroups(%tiles, %spans, %one) workgroup_size(%threads, %one, %one) : index
} launch(%verification_width: index, %epoch: buffer, %qkv: buffer, %alpha: buffer, %beta: buffer, %capture: buffer, %layer_origin: offset) {
  %width = index.assume %verification_width [range(%verification_width, 1, 8)] : index
  %span = kernel.workgroup.id<y> : index
  %active = func.call @qwen38_span_active(%epoch, %span) : (buffer, index) -> (i1)
  scf.if %active {
    %speculative = func.call @qwen38_span_speculative(%epoch, %span) : (buffer, index) -> (i1)
    scf.if %speculative {
      %control, %begin, %row = func.call @qwen38_span_binding(%epoch, %span) : (buffer, index) -> (offset, index, index)
      %tile = kernel.workgroup.id<x> : index
      %thread = kernel.workitem.id<x> : index
      %four = index.constant 4 : index
      %tiles_per_row = index.constant 10 : index
      %qkv_tiles = index.mul %width, %tiles_per_row : index
      %threads = index.constant 256 : index
      %qkv_row_bytes = index.constant 40960 : offset
      %qkv_span_bytes = index.scale %width, %qkv_row_bytes : index, offset -> offset
      %gate_row_bytes = index.constant 192 : offset
      %gate_span_bytes = index.scale %width, %gate_row_bytes : index, offset -> offset
      %qkv_channels = index.constant 10240 : index
      %gate_channels = index.constant 48 : index
      %qkv_elements = index.mul %width, %qkv_channels : index
      %gate_elements = index.mul %width, %gate_channels : index
      %is_qkv = index.cmp ult, %tile, %qkv_tiles : index
      scf.if %is_qkv {
        %source_origin = index.scale %begin, %qkv_row_bytes : index, offset -> offset
        %span_origin = index.scale %span, %qkv_span_bytes : index, offset -> offset
        %target_origin = index.add %layer_origin, %span_origin : offset
        %input = buffer.view %qkv[%source_origin] : buffer -> view<[%qkv_elements]xf32>
        %output = buffer.view %capture[%target_origin] : buffer -> view<[%qkv_elements]xf32>
        %tile_begin = index.mul %tile, %threads : index
        %packet = index.add %tile_begin, %thread : index
        %element = index.mul %packet, %four : index
        %value = vector.load %input[%element] : view<[%qkv_elements]xf32> -> vector<4xf32>
        vector.store %value, %output[%element] : vector<4xf32>, view<[%qkv_elements]xf32>
      } else {
        %packets = index.div %gate_elements, %four : index
        %active_packet = index.cmp ult, %thread, %packets : index
        scf.if %active_packet {
          %source_origin = index.scale %begin, %gate_row_bytes : index, offset -> offset
          %span_origin = index.scale %span, %gate_span_bytes : index, offset -> offset
          %target_origin = index.add %layer_origin, %span_origin : offset
          %span_capacity = kernel.workgroup.count<y> : index
          %alpha_offset = index.scale %span_capacity, %qkv_span_bytes : index, offset -> offset
          %gate_bytes = index.scale %span_capacity, %gate_span_bytes : index, offset -> offset
          %beta_offset = index.add %alpha_offset, %gate_bytes : offset
          %alpha_origin = index.add %target_origin, %alpha_offset : offset
          %beta_origin = index.add %target_origin, %beta_offset : offset
          %input_a = buffer.view %alpha[%source_origin] : buffer -> view<[%gate_elements]xf32>
          %input_b = buffer.view %beta[%source_origin] : buffer -> view<[%gate_elements]xf32>
          %output_a = buffer.view %capture[%alpha_origin] : buffer -> view<[%gate_elements]xf32>
          %output_b = buffer.view %capture[%beta_origin] : buffer -> view<[%gate_elements]xf32>
          %element = index.mul %thread, %four : index
          %a = vector.load %input_a[%element] : view<[%gate_elements]xf32> -> vector<4xf32>
          %b = vector.load %input_b[%element] : view<[%gate_elements]xf32> -> vector<4xf32>
          vector.store %a, %output_a[%element] : vector<4xf32>, view<[%gate_elements]xf32>
          vector.store %b, %output_b[%element] : vector<4xf32>, view<[%gate_elements]xf32>
        }
      }
    }
  }
  kernel.return
}
