amdgpu.target<gfx11-generic> @qwen38_vision_gfx11 {subgroup_size = 32}

// Reconstructs one logical fragment from a 64-value row rotated by eight
// values for each successive row modulo eight.
func.def inline @qwen38_vision_merger_swizzled_weight_fragment(%stage: buffer, %row: index, %fragment_column: index) -> (vector<16xf16>) {
  %origin = index.constant 0 : offset
  %c8 = index.constant 8 : index
  %c64 = index.constant 64 : index
  %stage_local = buffer.assume.memory_space<workgroup> %stage : buffer
  %stage_view = buffer.view %stage_local[%origin] : buffer -> view<128x64xf16>
  %row_lane = index.rem %row, %c8 : index
  %rotation = index.mul %row_lane, %c8 : index
  %low_column0 = index.add %fragment_column, %rotation : index
  %low_column_raw = index.rem %low_column0, %c64 : index
  %low_column = index.assume %low_column_raw [range(%low_column_raw, 0, 56), multiple_of(%low_column_raw, 8)] : index
  %logical_high_column = index.add %fragment_column, %c8 : index
  %high_column0 = index.add %logical_high_column, %rotation : index
  %high_column_raw = index.rem %high_column0, %c64 : index
  %high_column = index.assume %high_column_raw [range(%high_column_raw, 0, 56), multiple_of(%high_column_raw, 8)] : index
  %low = vector.load %stage_view[%row, %low_column] : view<128x64xf16> -> vector<8xf16>
  %high = vector.load %stage_view[%row, %high_column] : view<128x64xf16> -> vector<8xf16>
  %values = vector.concat<0> %low, %high : vector<8xf16>, vector<8xf16> -> vector<16xf16>
  func.return %values : vector<16xf16>
}

func.def inline @qwen38_vision_merger_gelu_fragment(%input: vector<8xf32>) -> (vector<8xf32>) {
  %half = vector.constant 0.5 : vector<8xf32>
  %c1_f32x8 = vector.constant 1.0 : vector<8xf32>
  %coefficient = vector.constant 0.044714999999999998 : vector<8xf32>
  %scale = vector.constant 0.79788456080286541 : vector<8xf32>
  %square = vector.mulf %input, %input : vector<8xf32>
  %cubic = vector.mulf %square, %input : vector<8xf32>
  %scaled_cubic = vector.mulf %coefficient, %cubic : vector<8xf32>
  %inner = vector.addf %input, %scaled_cubic : vector<8xf32>
  %angle = vector.mulf %scale, %inner : vector<8xf32>
  %hyperbolic_tangent = vector.tanhf<afn> %angle : vector<8xf32>
  %factor = vector.addf %c1_f32x8, %hyperbolic_tangent : vector<8xf32>
  %half_input = vector.mulf %half, %input : vector<8xf32>
  %output = vector.mulf %half_input, %factor : vector<8xf32>
  func.return %output : vector<8xf32>
}

