template.decl @selection.topk_partial_f32(%rows: index, %columns: index, %count: index, %input: buffer, %output_values: buffer, %output_ids: buffer)
template.decl @selection.topk_merge_f32(%rows: index, %partitions: index, %count: index, %input_values: buffer, %input_ids: buffer, %output_values: buffer, %output_ids: buffer)
template.decl @selection.chain_q4k_256(%blocks: index, %length: index, %vocabulary: index, %anchors: buffer, %candidates: buffer, %unary: buffer, %hidden: buffer, %predecessors: buffer, %successors: buffer, %output: buffer)

kernel.def @qwen38_dflash_topk_partial(%rows: index) {
  %partitions = index.constant 61 : index
  %one = index.constant 1 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%partitions, %rows, %one) workgroup_size(%threads, %one, %one) : index
} launch(%rows: index, %control: buffer, %logits: buffer, %scores: buffer, %ids: buffer) {
  %origin = index.constant 0 : offset
  %metadata = buffer.assume.memory_space<constant> %control : buffer
  %header = buffer.view %metadata[%origin] : buffer -> view<1xi32>
  %live_word = view.load %header[0] : view<1xi32> -> i32
  %live = index.cast %live_word : i32 to index
  %row = kernel.workgroup.id<y> : index
  %active = index.cmp ult, %row, %live : index
  %vocabulary = index.constant 248320 : index
  %count = index.constant 16 : index
  scf.if %active {
    template.apply<@selection.topk_partial_f32>(%rows, %vocabulary, %count, %logits, %scores, %ids) : (index, index, index, buffer, buffer, buffer)
  }
  kernel.return
}

kernel.def @qwen38_dflash_topk_merge(%rows: index) {
  %one = index.constant 1 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%rows, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%rows: index, %control: buffer, %partial_scores: buffer, %partial_ids: buffer, %scores: buffer, %ids: buffer) {
  %origin = index.constant 0 : offset
  %metadata = buffer.assume.memory_space<constant> %control : buffer
  %header = buffer.view %metadata[%origin] : buffer -> view<1xi32>
  %live_word = view.load %header[0] : view<1xi32> -> i32
  %live = index.cast %live_word : i32 to index
  %row = kernel.workgroup.id<x> : index
  %active = index.cmp ult, %row, %live : index
  %partitions = index.constant 61 : index
  %count = index.constant 16 : index
  scf.if %active {
    template.apply<@selection.topk_merge_f32>(%rows, %partitions, %count, %partial_scores, %partial_ids, %scores, %ids) : (index, index, index, buffer, buffer, buffer, buffer)
  }
  kernel.return
}

kernel.def @qwen38_dflash_select(%blocks: index) {
  %one = index.constant 1 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%blocks, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%blocks: index, %control: buffer, %anchors: buffer, %candidates: buffer, %unary: buffer, %hidden: buffer, %predecessors: buffer, %successors: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %metadata = buffer.assume.memory_space<constant> %control : buffer
  %header = buffer.view %metadata[%origin] : buffer -> view<3xi32>
  %count_word = view.load %header[1] : view<3xi32> -> i32
  %count = index.cast %count_word : i32 to index
  %block = kernel.workgroup.id<x> : index
  %active = index.cmp ult, %block, %count : index
  %length = index.constant 7 : index
  %vocabulary = index.constant 248320 : index
  scf.if %active {
    template.apply<@selection.chain_q4k_256>(%blocks, %length, %vocabulary, %anchors, %candidates, %unary, %hidden, %predecessors, %successors, %output) : (index, index, index, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  }
  kernel.return
}
