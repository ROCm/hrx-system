func.decl @qwen38_span_active(%epoch: buffer, %span: index) -> (i1)

func.decl @qwen38_span_binding(%epoch: buffer, %span: index) -> (offset, index, index)

func.decl @qwen38_row_gdn_binding(%epoch: buffer, %control_origin: offset, %rows: buffer, %row: index, %layer_origin: offset) -> (offset, offset, i1)

template.decl @qwen38.gdn_conv_prepare_prefill.body(%publish_history: i1, %head: index, %thread: index, %token_count_data: buffer, %l2_epsilon: f32, %qkv_input: buffer, %conv_weight: buffer, %conv_history: buffer, %qkv_silu: buffer, %qk_inverse_norm: buffer, %control_origin: offset, %token_begin: index, %history_origin: offset, %next_history_origin: offset)

template.decl @qwen38.gdn_recurrent_prefill_x4.body(%publish_state: i1, %value_head: index, %column_tile: index, %lane: index, %token_count_data: buffer, %qkv_silu: buffer, %qk_inverse_norm: buffer, %alpha: buffer, %beta: buffer, %ssm_a: buffer, %dt_bias: buffer, %state: buffer, %raw_output: buffer, %control_origin: offset, %token_begin: index, %state_origin: offset, %next_state_origin: offset)

// One workgroup advances one span/head's convolution history. Its register
// recurrence has no cross-span predecessor and needs no history snapshot or
// array-wide rendezvous. The same body handles one decode input or a prompt
// suffix; only the validated span descriptor determines the length.
kernel.def export("qwen38_gdn_conv_spans") @qwen38_gdn_conv_spans(%span_capacity: index) {
  %spans = index.assume %span_capacity [range(%span_capacity, 1, 64)] : index
  %heads = index.constant 16 : index
  %threads = index.constant 256 : index
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%heads, %spans, %one) workgroup_size(%threads, %one, %one) : index
} launch(%epoch: buffer, %rows: buffer, %layer_origin: offset, %epsilon: f32, %qkv: buffer, %weight: buffer, %state: buffer, %output: buffer, %inverse_norm: buffer) {
  %span = kernel.workgroup.id<y> : index
  %active = func.call @qwen38_span_active(%epoch, %span) : (buffer, index) -> (i1)
  scf.if %active {
    %head_value = kernel.workgroup.id<x> : index
    %head = index.assume %head_value [range(%head_value, 0, 15)] : index
    %thread_value = kernel.workitem.id<x> : index
    %thread = index.assume %thread_value [range(%thread_value, 0, 255)] : index
    %control_origin, %token_begin, %row = func.call @qwen38_span_binding(%epoch, %span) : (buffer, index) -> (offset, index, index)
    %history_origin, %next_history_origin, %first_advance = func.call @qwen38_row_gdn_binding(%epoch, %control_origin, %rows, %row, %layer_origin) : (buffer, offset, buffer, index, offset) -> (offset, offset, i1)
    %publish = scalar.constant true : i1
    scf.if %first_advance {
      template.apply<@qwen38.gdn_conv_prepare_prefill.body>(%publish, %head, %thread, %epoch, %epsilon, %qkv, %weight, %state, %output, %inverse_norm, %control_origin, %token_begin, %history_origin, %next_history_origin) : (i1, index, index, buffer, f32, buffer, buffer, buffer, buffer, buffer, offset, index, offset, offset)
    } else {
      template.apply<@qwen38.gdn_conv_prepare_prefill.body>(%publish, %head, %thread, %epoch, %epsilon, %qkv, %weight, %state, %output, %inverse_norm, %control_origin, %token_begin, %next_history_origin, %next_history_origin) : (i1, index, index, buffer, f32, buffer, buffer, buffer, buffer, buffer, offset, index, offset, offset)
    }
  }
  kernel.return
}

// Each workgroup owns a state fragment for exactly one span. The fragment is
// loaded once, carried through the span, and published to its private writer.
// Compact activation placement is independent of persistent placement.
kernel.def export("qwen38_gdn_recurrent_spans") @qwen38_gdn_recurrent_spans(%span_capacity: index) {
  %spans = index.assume %span_capacity [range(%span_capacity, 1, 64)] : index
  %heads = index.constant 48 : index
  %columns = index.constant 32 : index
  %threads = index.constant 32 : index
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%heads, %columns, %spans) workgroup_size(%threads, %one, %one) : index
} launch(%epoch: buffer, %rows: buffer, %layer_origin: offset, %qkv: buffer, %inverse_norm: buffer, %alpha: buffer, %beta: buffer, %a: buffer, %bias: buffer, %state: buffer, %output: buffer) {
  %span = kernel.workgroup.id<z> : index
  %active = func.call @qwen38_span_active(%epoch, %span) : (buffer, index) -> (i1)
  scf.if %active {
    %head_value = kernel.workgroup.id<x> : index
    %head = index.assume %head_value [range(%head_value, 0, 47)] : index
    %column_value = kernel.workgroup.id<y> : index
    %column = index.assume %column_value [range(%column_value, 0, 31)] : index
    %lane_value = kernel.workitem.id<x> : index
    %lane = index.assume %lane_value [range(%lane_value, 0, 31)] : index
    %control_origin, %token_begin, %row = func.call @qwen38_span_binding(%epoch, %span) : (buffer, index) -> (offset, index, index)
    %state_origin, %next_state_origin, %first_advance = func.call @qwen38_row_gdn_binding(%epoch, %control_origin, %rows, %row, %layer_origin) : (buffer, offset, buffer, index, offset) -> (offset, offset, i1)
    %publish = scalar.constant true : i1
    scf.if %first_advance {
      template.apply<@qwen38.gdn_recurrent_prefill_x4.body>(%publish, %head, %column, %lane, %epoch, %qkv, %inverse_norm, %alpha, %beta, %a, %bias, %state, %output, %control_origin, %token_begin, %state_origin, %next_state_origin) : (i1, index, index, index, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, offset, index, offset, offset)
    } else {
      template.apply<@qwen38.gdn_recurrent_prefill_x4.body>(%publish, %head, %column, %lane, %epoch, %qkv, %inverse_norm, %alpha, %beta, %a, %bias, %state, %output, %control_origin, %token_begin, %next_state_origin, %next_state_origin) : (i1, index, index, index, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, offset, index, offset, offset)
    }
  }
  kernel.return
}
