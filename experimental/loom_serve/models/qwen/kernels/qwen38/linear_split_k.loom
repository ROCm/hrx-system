kernel.def target(@qwen38_split_cdna) @qwen38_linear_split_reduce(%partitions: index, %tokens: index, %outputs: index) {
  %one = index.constant 1 : index
  %threads = index.constant 256 : index
  %tile = index.constant 256 : index
  %padding = index.constant 255 : index
  %elements = index.mul %tokens, %outputs : index
  %padded = index.add %elements, %padding : index
  %groups = index.div %padded, %tile : index
  kernel.launch.config workgroups(%groups, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%partitions0: index, %control: buffer, %outputs0: index, %partials: buffer, %output: buffer) {
  %partitions = index.assume %partitions0 [range(%partitions0, 1, 16)] : index
  %outputs = index.assume %outputs0 [range(%outputs0, 1, 32768)] : index
  %origin = index.constant 0 : offset
  %count_view = buffer.view %control[%origin] : buffer -> view<1xi32>
  %count_i32 = view.load %count_view[0] : view<1xi32> -> i32
  %count0 = index.cast %count_i32 : i32 to index
  %count = index.assume %count0 [range(%count0, 1, 512)] : index
  %elements = index.mul %count, %outputs : index
  %input_view = buffer.view %partials[%origin] : buffer -> view<[%partitions]x[%elements]xf32>
  %output_view = buffer.view %output[%origin] : buffer -> view<[%elements]xf32>
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %tile = index.constant 256 : index
  %group = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %element = index.madd %group, %tile, %lane : index
  %active = index.cmp ult, %element, %elements : index
  scf.if %active {
    %bounded_element = index.assume %element [lt(%element, %elements)] : index
    %zeros = scalar.constant 0.0 : f32
    %sum = scf.for %partition = [%zero to %partitions step %one](%accumulator = %zeros : f32) -> (f32) {
      %values = view.load %input_view[%partition, %bounded_element] : view<[%partitions]x[%elements]xf32> -> f32
      %next = scalar.addf %accumulator, %values : f32
      scf.yield %next : f32
    }
    view.store %sum, %output_view[%bounded_element] : f32, view<[%elements]xf32>
  }
  kernel.return
}
