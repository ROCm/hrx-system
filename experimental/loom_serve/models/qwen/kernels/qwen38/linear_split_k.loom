// Split reductions keep complete 64-token weight reuse while distributing
// long contractions across the device. Each partition writes one F32 plane;
// the following reduction publishes the original token-major result layout.
amdgpu.target<gfx9-4-generic> @qwen38_split_cdna {subgroup_size = 64}

