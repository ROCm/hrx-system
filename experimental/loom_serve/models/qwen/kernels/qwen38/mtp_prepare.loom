template.decl @normalization.rms_row_f32(%width: index, %threads: index, %input_origin: offset, %output_origin: offset, %output_f16: i1, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer)

// Qwen3.8 NextN/MTP batched input preparation.
//
// Target-model hidden rows are already normalized by output_norm. The stored
// NextN block applies its own hnorm and combines each row with an independently
// normalized token embedding. These kernels write the concatenated activation
// directly and shift target rows without materializing duplicate dense inputs.
func.decl @qwen38_span_active(%epoch: buffer, %span: index) -> (i1)

func.decl @qwen38_span_binding(%epoch: buffer, %span: index) -> (offset, index, index)

// Shifts committed target hidden rows within each independent span. The prior
// carry is read-only for this dispatch; publication runs after all readers.
kernel.def export("qwen38_mtp_shift_spans") @qwen38_mtp_shift_spans(%span_capacity: index) {
  %spans = index.assume %span_capacity [range(%span_capacity, 1, 16)] : index
  %tiles = index.constant 5 : index
  %threads = index.constant 256 : index
  %c1_2 = index.constant 1 : index
  kernel.launch.config workgroups(%tiles, %spans, %c1_2) workgroup_size(%threads, %c1_2, %c1_2) : index
} launch(%epoch: buffer, %normalized: buffer, %carry: buffer, %shifted: buffer) {
  %span = kernel.workgroup.id<y> : index
  %active = func.call @qwen38_span_active(%epoch, %span) : (buffer, index) -> (i1)
  scf.if %active {
    %origin, %begin, %row = func.call @qwen38_span_binding(%epoch, %span) : (buffer, index) -> (offset, index, index)
    %metadata = buffer.assume.memory_space<constant> %epoch : buffer
    %descriptor = buffer.view %metadata[%origin] : buffer -> view<5xi32>
    %count_word = view.load %descriptor[0] : view<5xi32> -> i32
    %count_value = index.cast %count_word : i32 to index
    %count = index.assume %count_value [range(%count_value, 1, 512)] : index
    %tile_value = kernel.workgroup.id<x> : index
    %tile = index.assume %tile_value [range(%tile_value, 0, 4)] : index
    %thread_value = kernel.workitem.id<x> : index
    %thread = index.assume %thread_value [range(%thread_value, 0, 255)] : index
    %c0 = index.constant 0 : index
    %c1_2 = index.constant 1 : index
    %width = index.constant 256 : index
    %tile_begin = index.mul %tile, %width : index
    %packet = index.add %tile_begin, %thread : index
    %c4 = index.constant 4 : index
    %element = index.mul %packet, %c4 : index
    %c0_2 = index.constant 0 : offset
    %inputs = buffer.view %normalized[%c0_2] : buffer -> view<512x5120xf32>
    %carry_row_bytes = index.constant 20480 : offset
    %carry_origin = index.scale %row, %carry_row_bytes : index, offset -> offset
    %prior = buffer.view %carry[%carry_origin] : buffer -> view<5120xf32>
    %outputs = buffer.view %shifted[%c0_2] : buffer -> view<512x5120xf32>
    scf.for %token = [%c0 to %count step %c1_2] {
      // The validated packed partition fits the activation matrix, including
      // each span's begin plus length; separate descriptor words carry it.
      %destination_value = index.add %begin, %token : index
      %destination = index.assume %destination_value [range(%destination_value, 0, 511)] : index
      %first = index.cmp eq, %token, %c0 : index
      %hidden = scf.if %first -> (vector<4xf32>) {
        %value = vector.load %prior[%element] : view<5120xf32> -> vector<4xf32>
        scf.yield %value : vector<4xf32>
      } else {
        %source_value = index.sub %destination, %c1_2 : index
        %source = index.assume %source_value [range(%source_value, 0, 510)] : index
        %value = vector.load %inputs[%source, %element] : view<512x5120xf32> -> vector<4xf32>
        scf.yield %value : vector<4xf32>
      }
      vector.store %hidden, %outputs[%destination, %element] : vector<4xf32>, view<512x5120xf32>
    }
  }
  kernel.return
}

// Saves the last committed target hidden row only after shifting has consumed
// the previous carry. Distinct spans own distinct resident carry rows.
kernel.def export("qwen38_mtp_save_carry") @qwen38_mtp_save_carry(%span_capacity: index) {
  %spans = index.assume %span_capacity [range(%span_capacity, 1, 16)] : index
  %tiles = index.constant 5 : index
  %threads = index.constant 256 : index
  %c1_2 = index.constant 1 : index
  kernel.launch.config workgroups(%tiles, %spans, %c1_2) workgroup_size(%threads, %c1_2, %c1_2) : index
} launch(%epoch: buffer, %normalized: buffer, %carry: buffer) {
  %span = kernel.workgroup.id<y> : index
  %active = func.call @qwen38_span_active(%epoch, %span) : (buffer, index) -> (i1)
  scf.if %active {
    %origin, %begin, %row = func.call @qwen38_span_binding(%epoch, %span) : (buffer, index) -> (offset, index, index)
    %metadata = buffer.assume.memory_space<constant> %epoch : buffer
    %descriptor = buffer.view %metadata[%origin] : buffer -> view<5xi32>
    %count_word = view.load %descriptor[0] : view<5xi32> -> i32
    %count = index.cast %count_word : i32 to index
    %c1_2 = index.constant 1 : index
    %end = index.add %begin, %count : index
    // Every active packed span is nonempty and ends within 512 tokens.
    %last_value = index.sub %end, %c1_2 : index
    %last = index.assume %last_value [range(%last_value, 0, 511)] : index
    %tile = kernel.workgroup.id<x> : index
    %thread = kernel.workitem.id<x> : index
    %width = index.constant 256 : index
    %tile_begin = index.mul %tile, %width : index
    %packet = index.add %tile_begin, %thread : index
    %c4 = index.constant 4 : index
    %element = index.mul %packet, %c4 : index
    %c0_2 = index.constant 0 : offset
    %inputs = buffer.view %normalized[%c0_2] : buffer -> view<512x5120xf32>
    %carry_row_bytes = index.constant 20480 : offset
    %carry_origin = index.scale %row, %carry_row_bytes : index, offset -> offset
    %outputs = buffer.view %carry[%carry_origin] : buffer -> view<5120xf32>
    %value = vector.load %inputs[%last, %element] : view<512x5120xf32> -> vector<4xf32>
    vector.store %value, %outputs[%element] : vector<4xf32>, view<5120xf32>
  }
  kernel.return
}

// Copies committed resident carry into the compact private proposal matrix.
// Later draft rounds overwrite only that matrix, never committed target carry.
kernel.def export("qwen38_mtp_gather_carry") @qwen38_mtp_gather_carry(%span_capacity: index) {
  %spans = index.assume %span_capacity [range(%span_capacity, 1, 16)] : index
  %tiles = index.constant 5 : index
  %threads = index.constant 256 : index
  %c1_2 = index.constant 1 : index
  kernel.launch.config workgroups(%tiles, %spans, %c1_2) workgroup_size(%threads, %c1_2, %c1_2) : index
} launch(%epoch: buffer, %carry: buffer, %hidden: buffer) {
  %span = kernel.workgroup.id<y> : index
  %active = func.call @qwen38_span_active(%epoch, %span) : (buffer, index) -> (i1)
  scf.if %active {
    %origin, %begin, %row = func.call @qwen38_span_binding(%epoch, %span) : (buffer, index) -> (offset, index, index)
    %tile = kernel.workgroup.id<x> : index
    %thread = kernel.workitem.id<x> : index
    %width = index.constant 256 : index
    %tile_begin = index.mul %tile, %width : index
    %packet = index.add %tile_begin, %thread : index
    %c4 = index.constant 4 : index
    %element = index.mul %packet, %c4 : index
    %c0_2 = index.constant 0 : offset
    %carry_row_bytes = index.constant 20480 : offset
    %carry_origin = index.scale %row, %carry_row_bytes : index, offset -> offset
    %inputs = buffer.view %carry[%carry_origin] : buffer -> view<5120xf32>
    %outputs = buffer.view %hidden[%c0_2] : buffer -> view<512x5120xf32>
    %value = vector.load %inputs[%element] : view<5120xf32> -> vector<4xf32>
    vector.store %value, %outputs[%begin, %element] : vector<4xf32>, view<512x5120xf32>
  }
  kernel.return
}

// Normalizes one dense input matrix into one half of the interleaved
// [token_count, 10240] activation consumed by nextn.eh_proj. The exported
// wrappers make the two physical columns compile-time address facts.
template.decl @qwen38.mtp_rmsnorm_concat_f32_prefill.body(%token_capacity0: index, %column_offset: index, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer)

template.def<@qwen38.mtp_rmsnorm_concat_f32_prefill.body> device @qwen38_mtp_rmsnorm_concat_f32_prefill_body(%token_capacity0: index, %column_offset: index, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer) {
  %token_capacity = index.assume %token_capacity0 [range(%token_capacity0, 1, 512)] : index
  %token_value = kernel.workgroup.id<y> : index
  %token = index.assume %token_value [lt(%token_value, %token_capacity)] : index
  %width = index.constant 5120 : index
  %threads = index.constant 256 : index
  %input_row_bytes = index.constant 20480 : offset
  %output_row_bytes = index.constant 40960 : offset
  %element_bytes = index.constant 4 : offset
  %input_origin = index.scale %token, %input_row_bytes : index, offset -> offset
  %output_row_origin = index.scale %token, %output_row_bytes : index, offset -> offset
  %column_origin = index.scale %column_offset, %element_bytes : index, offset -> offset
  %output_origin = index.add %output_row_origin, %column_origin : offset
  %output_f16 = scalar.constant 0 : i1
  template.apply<@normalization.rms_row_f32>(%width, %threads, %input_origin, %output_origin, %output_f16, %epsilon, %input, %weight, %output) : (index, index, offset, offset, i1, f32, buffer, buffer, buffer)
  template.return
}

kernel.def export("qwen38_mtp_rmsnorm_concat_embedding_f32_prefill") @qwen38_mtp_rmsnorm_concat_embedding_f32_prefill(%token_count0: index) {
  %token_count = index.assume %token_count0 [range(%token_count0, 1, 512)] : index
  %c1 = index.constant 1 : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%c1, %token_count, %c1) workgroup_size(%workgroup_size, %c1, %c1) : index
} launch(%token_capacity: index, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer) {
  %column_offset = index.constant 0 : index
  template.apply<@qwen38.mtp_rmsnorm_concat_f32_prefill.body>(%token_capacity, %column_offset, %epsilon, %input, %weight, %output) : (index, index, f32, buffer, buffer, buffer)
  kernel.return
}

kernel.def export("qwen38_mtp_rmsnorm_concat_hidden_f32_prefill") @qwen38_mtp_rmsnorm_concat_hidden_f32_prefill(%token_count0: index) {
  %token_count = index.assume %token_count0 [range(%token_count0, 1, 512)] : index
  %c1 = index.constant 1 : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%c1, %token_count, %c1) workgroup_size(%workgroup_size, %c1, %c1) : index
} launch(%token_capacity: index, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer) {
  %column_offset = index.constant 5120 : index
  template.apply<@qwen38.mtp_rmsnorm_concat_f32_prefill.body>(%token_capacity, %column_offset, %epsilon, %input, %weight, %output) : (index, index, f32, buffer, buffer, buffer)
  kernel.return
}
