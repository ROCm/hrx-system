                %head_copy = kernel.async.copy %head_local to %head_external {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<8x512xbf16> to view<8x512xbf16, #encoding.layout.strided<strides=[4096, 1]>> -> kernel.async.token
                %head_group = kernel.async.group %head_copy : kernel.async.token -> kernel.async.group
                kernel.async.wait %head_group {newer_groups = 0} : kernel.async.group
              } else {

                %value_row_stride = index.constant 64 : offset
                %value_relative = index.scale %member, %value_row_stride : index, offset -> offset
                %value_base = index.add %value_initial, %episode_state_offset : offset
                %value_address = index.add %value_base, %value_relative : offset
                %value_external = buffer.view %state[%value_address] : buffer -> view<32x4x32xbf16, #encoding.layout.strided<strides=[4096, 128, 1]>>
                %value_local = view.bitcast %head_source : view<4096xbf16> -> view<32x4x32xbf16>
                %value_copy = kernel.async.copy %value_local to %value_external {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<32x4x32xbf16> to view<32x4x32xbf16, #encoding.layout.strided<strides=[4096, 128, 1]>> -> kernel.async.token
                %value_group = kernel.async.group %value_copy : kernel.async.token -> kernel.async.group
                kernel.async.wait %value_group {newer_groups = 0} : kernel.async.group
              }
            } else {
              scf.if %mlp_group {
                %mlp_panel_unbounded = index.sub %dense_group, %three : index
                %mlp_panel = index.assume %mlp_panel_unbounded [range(%mlp_panel_unbounded, 0, 2)] : index
                %mlp_panel_stride = index.constant 262144 : offset
                %mlp_panel_relative = index.scale %mlp_panel, %mlp_panel_stride : index, offset -> offset

                %mlp_base = index.add %mlp_initial, %episode_state_offset : offset
                %mlp_panel_base = index.add %mlp_base, %mlp_panel_relative : offset
                %mlp_row_relative = index.scale %member, %record_stride : index, offset -> offset
                %mlp_address = index.add %mlp_panel_base, %mlp_row_relative : offset
                %mlp_external = buffer.view %state[%mlp_address] : buffer -> view<4096xbf16>
                %mlp_output_copy = kernel.async.copy %head_source to %mlp_external {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<4096xbf16> to view<4096xbf16> -> kernel.async.token
                %mlp_output_completion = kernel.async.group %mlp_output_copy : kernel.async.token -> kernel.async.group
                kernel.async.wait %mlp_output_completion {newer_groups = 0} : kernel.async.group
              } else {
                %residual_row_stride = index.constant 65536 : offset
                %residual_row_relative = index.scale %member, %residual_row_stride : index, offset -> offset
                %residual_local = view.bitcast %head_source : view<4096xbf16> -> view<32x128xbf16>

                %residual_base = index.add %residual_initial, %episode_state_offset : offset
                %residual_address = index.add %residual_base, %residual_row_relative : offset
                %residual_external = buffer.view %state[%residual_address] : buffer -> view<32x128xbf16, #encoding.layout.strided<strides=[1024, 1]>>
                %residual_output_copy = kernel.async.copy %residual_local to %residual_external {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<32x128xbf16> to view<32x128xbf16, #encoding.layout.strided<strides=[1024, 1]>> -> kernel.async.token
                %residual_output_completion = kernel.async.group %residual_output_copy : kernel.async.token -> kernel.async.group
                kernel.async.wait %residual_output_completion {newer_groups = 0} : kernel.async.group
              }
            }
            channel.release %head_read : read<tile<4096xbf16>, mutable>
          }
          func.call @qwen3_embedding.wait(%incoming_arrival) : (channel<tile<16xi32>>)
          func.call @qwen3_embedding.signal(%outgoing_arrival) : (channel<tile<16xi32>>)
          func.call @qwen3_embedding.wait(%incoming_departure) : (channel<tile<16xi32>>)
          func.call @qwen3_embedding.signal(%outgoing_departure) : (channel<tile<16xi32>>)
        }
        %attention_group = index.cmp eq, %dense_group, %one : index
        scf.if %attention_group {
          func.call @qwen3_embedding.identity(%identity) : (view<8x8xbf16>)
          scf.for %right_record = [%zero to %thirty_two step %two] {
            %right_first_initial = index.constant 270336 : offset
            %right_first_base = index.add %right_first_initial, %episode_state_offset : offset
            %right_first_relative = index.scale %right_record, %record_stride : index, offset -> offset
            %right_first_address = index.add %right_first_base, %right_first_relative : offset
            %right_first_external = buffer.view %state[%right_first_address] : buffer -> view<4096xbf16>
            %right_first_write, %right_first_incoming = channel.reserve %activation_stream : channel<tile<2048xi32>> -> (write<tile<2048xi32>>, view<2048xi32>)
            %right_first_bf16 = view.bitcast %right_first_incoming : view<2048xi32> -> view<4096xbf16>
            %right_first_copy = kernel.async.copy %right_first_external to %right_first_bf16 {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<4096xbf16> to view<4096xbf16> -> kernel.async.token
            %right_first_group = kernel.async.group %right_first_copy : kernel.async.token -> kernel.async.group
            kernel.async.wait %right_first_group {newer_groups = 0} : kernel.async.group
            scf.for %right_first_word = [%zero to %chunk_words step %vector_step] {
              %right_first_source = index.add %column_offset, %right_first_word : index
              %right_first_value = vector.load %right_first_bf16[%right_first_source] : view<4096xbf16> -> vector<32xbf16>
              %right_first_destination = index.add %zero, %right_first_word : index
              vector.store %right_first_value, %raw[%right_first_destination] : vector<32xbf16>, view<4096xbf16>
            }
            channel.publish %right_first_write : write<tile<2048xi32>>
            %right_next = index.add %right_record, %one : index
            %right_second_initial = index.constant 270336 : offset
            %right_second_base = index.add %right_second_initial, %episode_state_offset : offset
            %right_second_relative = index.scale %right_next, %record_stride : index, offset -> offset
            %right_second_address = index.add %right_second_base, %right_second_relative : offset
            %right_second_external = buffer.view %state[%right_second_address] : buffer -> view<4096xbf16>
            %right_second_write, %right_second_incoming = channel.reserve %activation_stream : channel<tile<2048xi32>> -> (write<tile<2048xi32>>, view<2048xi32>)
            %right_second_bf16 = view.bitcast %right_second_incoming : view<2048xi32> -> view<4096xbf16>
            %right_second_copy = kernel.async.copy %right_second_external to %right_second_bf16 {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<4096xbf16> to view<4096xbf16> -> kernel.async.token
            %right_second_group = kernel.async.group %right_second_copy : kernel.async.token -> kernel.async.group
            kernel.async.wait %right_second_group {newer_groups = 0} : kernel.async.group
            scf.for %right_second_word = [%zero to %chunk_words step %vector_step] {
              %right_second_source = index.add %column_offset, %right_second_word : index
              %right_second_value = vector.load %right_second_bf16[%right_second_source] : view<4096xbf16> -> vector<32xbf16>
              %right_second_destination = index.add %chunk_words, %right_second_word : index
              vector.store %right_second_value, %raw[%right_second_destination] : vector<32xbf16>, view<4096xbf16>
            }
            channel.publish %right_second_write : write<tile<2048xi32>>
            func.call @qwen3_embedding.block_right(%raw_matrix, %blocked) : (view<32x128xbf16>, view<4096xbf16>)
            %right_panel = index.div %right_record, %two : index
            %right_relative = index.scale %right_panel, %right_stride : index, offset -> offset
            %high_destination = index.add %right_high, %right_relative : offset
            %low_destination = index.add %right_low, %right_relative : offset
            func.call @qwen3_embedding.pack_high(%local_storage, %result_offset, %high_destination, %right_count) : (buffer, offset, offset, i32)
            func.call @qwen3_embedding.pack_residual(%local_storage, %result_offset, %low_destination, %right_count) : (buffer, offset, offset, i32)
          }
          scf.for %query_block = [%zero to %four step %one] {
            %probability_read, %probability_view = channel.acquire<mutable> %probability_stream : channel<tile<4096xbf16>> -> (read<tile<4096xbf16>, mutable>, view<4096xbf16>)
            %probability_matrix = view.bitcast %probability_view : view<4096xbf16> -> view<32x128xbf16>
            %sequence_ids = buffer.view %sequence_storage[%origin] : buffer -> view<128xi32>
            %query_base = index.mul %query_block, %thirty_two : index
            func.call @qwen3_embedding.softmax(%probability_matrix, %scores, %sequence_ids, %query_base) : (view<32x128xbf16>, view<128xf32>, view<128xi32>, index)
            func.call @qwen3_embedding.block_left(%probability_matrix, %blocked) : (view<32x128xbf16>, view<4096xbf16>)
            func.call @qwen3_embedding.pack_high(%local_storage, %result_offset, %origin, %left_count) : (buffer, offset, offset, i32)
            func.call @qwen3_embedding.pack_residual(%local_storage, %result_offset, %packed_low, %left_count) : (buffer, offset, offset, i32)
            channel.release %probability_read : read<tile<4096xbf16>, mutable>
            %result_write, %result_view = channel.reserve %result_stream : channel<tile<4096xbf16>> -> (write<tile<4096xbf16>>, view<4096xbf16>)
            %result_matrix = view.bitcast %result_view : view<4096xbf16> -> view<16x4x64xbf16>
            func.call @qwen3_embedding.three_products_blocked(%local_storage, %temporary, %result_matrix) : (buffer, view<8x8xf32>, view<16x4x64xbf16>)
            channel.publish %result_write : write<tile<4096xbf16>>
            %result_read, %result_source = channel.acquire %result_stream : channel<tile<4096xbf16>> -> (read<tile<4096xbf16>>, view<4096xbf16>)

            %output_base = index.add %output_initial, %episode_state_offset : offset
            %output_relative = index.scale %query_block, %record_stride : index, offset -> offset
            %output_address = index.add %output_base, %output_relative : offset
            %output_external = buffer.view %state[%output_address] : buffer -> view<4096xbf16>
            %output_copy = kernel.async.copy %result_source to %output_external {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<4096xbf16> to view<4096xbf16> -> kernel.async.token
            %output_group = kernel.async.group %output_copy : kernel.async.token -> kernel.async.group
            kernel.async.wait %output_group {newer_groups = 0} : kernel.async.group
            channel.release %result_read : read<tile<4096xbf16>>
          }
          func.call @qwen3_embedding.wait(%incoming_arrival) : (channel<tile<16xi32>>)
          func.call @qwen3_embedding.signal(%outgoing_arrival) : (channel<tile<16xi32>>)
          func.call @qwen3_embedding.wait(%incoming_departure) : (channel<tile<16xi32>>)
          func.call @qwen3_embedding.signal(%outgoing_departure) : (channel<tile<16xi32>>)
        }
        channel.release %group_last_read : read<tile<4624xi32>, mutable>
      }
    }
  }
  func.return
}

// Gathers an interior token row group and participates in both barrier directions.
func.def public inline @qwen3_embedding.query_key_ingress(%sequence_storage: buffer, %origin: offset, %local_storage: buffer, %result_offset: offset, %peer_storage: buffer, %gather_storage: buffer, %activations: buffer, %activation_stream: channel<tile<2048xi32>>, %zero: index, %one: index, %weights: buffer, %state: buffer, %incoming_arrival: channel<tile<16xi32>>, %outgoing_arrival: channel<tile<16xi32>>, %incoming_departure: channel<tile<16xi32>>, %outgoing_departure: channel<tile<16xi32>>, %projection_stream: channel<tile<4096xbf16>>, %output: buffer, %weight_stream: channel<tile<4624xi32>>, %activation_offset: offset, %probability_stream: channel<tile<4096xbf16>>, %result_stream: channel<tile<4096xbf16>>) {
  %sequence_ids = buffer.view %sequence_storage[%origin] : buffer -> view<128xi32>
  %two = index.constant 2 : index
  %four = index.constant 4 : index
  %eight = index.constant 8 : index
  %thirty_two = index.constant 32 : index
  %capacity = index.constant 128 : index
  %chunk_words = index.constant 512 : index
  %vector_step = index.constant 32 : index
  %record_stride = index.constant 8192 : offset
  %episode_input_stride = index.constant 1056768 : offset
  %episode_output_stride = index.constant 262144 : offset
  %column_offset = index.constant 2048 : index
  %identity_offset = index.constant 27008 : offset
  %temporary_offset = index.constant 10368 : offset
  %scores_offset = index.constant 9344 : offset
  %packed_low = index.constant 4672 : offset
  %right_high = index.constant 27136 : offset
  %right_low = index.constant 45632 : offset
  %right_stride = index.constant 1152 : offset
  %right_count = scalar.constant 16 : i32
  %left_count = scalar.constant 64 : i32
  %identity = buffer.view %local_storage[%identity_offset] : buffer -> view<8x8xbf16>
  %temporary = buffer.view %local_storage[%temporary_offset] : buffer -> view<8x8xf32>
  %scores = buffer.view %local_storage[%scores_offset] : buffer -> view<128xf32>
  %raw = buffer.view %local_storage[%origin] : buffer -> view<4096xbf16>
  %raw_matrix = buffer.view %local_storage[%origin] : buffer -> view<32x128xbf16>
  %blocked = buffer.view %local_storage[%result_offset] : buffer -> view<4096xbf16>

  %last_chunk = index.constant 7 : index
  %dense_input_stride = index.constant 32768 : offset
  %dense_packed_offset = index.constant 27008 : offset
  %dense_result_offset = index.constant 31680 : offset
  %dense_primary = buffer.view %local_storage[%dense_result_offset] : buffer -> view<16x4x64xf32>
  %dense_secondary = buffer.view %peer_storage[%dense_result_offset] : buffer -> view<16x4x64xf32>
  %dense_primary_bits = buffer.view %local_storage[%dense_result_offset] : buffer -> view<4096xbf16>
  %dense_secondary_bits = buffer.view %peer_storage[%dense_result_offset] : buffer -> view<4096xbf16>
  %dense_transposed_values = buffer.view %peer_storage[%dense_result_offset] : buffer -> view<128x32xbf16>
  %dense_scale_offset = index.constant 8192 : offset
  %dense_scale_stride = index.constant 256 : offset
  %dense_rope_offset = index.constant 8704 : offset
  %dense_scales = buffer.view %local_storage[%dense_scale_offset] : buffer -> view<256xbf16>
  %dense_rope_bits = buffer.view %local_storage[%dense_rope_offset] : buffer -> view<4096xbf16>
  %dense_rope = buffer.view %local_storage[%dense_rope_offset] : buffer -> view<32x2x64xbf16>
  %scale_words = index.constant 256 : index
  %episode_state_stride = index.constant 2891776 : offset
  %three = index.constant 3 : index
  %six = index.constant 6 : index
  %seven = index.constant 7 : index
  %sixteen = index.constant 16 : index
  %twenty_four = index.constant 24 : index
  %layers = index.constant 29 : index
  %learned_layers = index.constant 28 : index
  %episode_input_offset = index.constant 0 : offset
  %episode_state_offset = index.constant 0 : offset
  %episode_output_offset = index.constant 0 : offset
  %gather_position_offset = index.constant 128 : offset
  %gather_tokens = buffer.view %gather_storage[%origin] : buffer -> view<32xi32>
  %gather_positions = buffer.view %gather_storage[%gather_position_offset] : buffer -> view<32xi16>
  %metadata_initial = index.constant 0 : offset
  %metadata_base = index.add %metadata_initial, %episode_input_offset : offset
  %metadata_external = buffer.view %activations[%metadata_base] : buffer -> view<4096xbf16>
  %metadata_write, %metadata_incoming = channel.reserve %activation_stream : channel<tile<2048xi32>> -> (write<tile<2048xi32>>, view<2048xi32>)
  %metadata_bf16 = view.bitcast %metadata_incoming : view<2048xi32> -> view<4096xbf16>
  %metadata_copy = kernel.async.copy %metadata_external to %metadata_bf16 {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<4096xbf16> to view<4096xbf16> -> kernel.async.token
  %metadata_group = kernel.async.group %metadata_copy : kernel.async.token -> kernel.async.group
  kernel.async.wait %metadata_group {newer_groups = 0} : kernel.async.group
  %metadata_rows = view.bitcast %metadata_incoming : view<2048xi32> -> view<128x16xi32>
  scf.for %token = [%zero to %capacity step %one] {
    %sequence = view.load %metadata_rows[%token, 1] : view<128x16xi32> -> i32
    view.store %sequence, %sequence_ids[%token] : i32, view<128xi32>
  }
  %gather_metadata = view.bitcast %metadata_incoming : view<2048xi32> -> view<128x16xi32>
  %gather_row_base = index.constant 64 : index
  %gather_invalid = scalar.constant -1 : i32
  %gather_sequence_zero = scalar.constant 0 : i32
  scf.for %gather_token = [%zero to %thirty_two step %one] {
    %gather_row = index.add %gather_row_base, %gather_token : index
    %gather_id = view.load %gather_metadata[%gather_row, 0] : view<128x16xi32> -> i32
    %gather_sequence = view.load %gather_metadata[%gather_row, 1] : view<128x16xi32> -> i32
    %gather_position = view.load %gather_metadata[%gather_row, 2] : view<128x16xi32> -> i32
    %gather_live = scalar.cmpi sge, %gather_sequence, %gather_sequence_zero : i32
    %gather_selected = scf.select %gather_live, %gather_id, %gather_invalid : i32
    %gather_position16 = scalar.trunci %gather_position : i32 to i16
    view.store %gather_selected, %gather_tokens[%gather_token] : i32, view<32xi32>
    view.store %gather_position16, %gather_positions[%gather_token] : i16, view<32xi16>
  }
  channel.publish %metadata_write : write<tile<2048xi32>>
  scf.for %layer = [%zero to %layers step %one] {
    %initial_layer = index.cmp eq, %layer, %zero : index
    %constant_base = index.constant 497172480 : offset
    %constant_stride = index.constant 8192 : offset
    %constant_relative = index.scale %layer, %constant_stride : index, offset -> offset
    %constant_offset = index.add %constant_base, %constant_relative : offset
    %final_layer = index.cmp eq, %layer, %learned_layers : index
    %learned_layer = index.cmp ult, %layer, %learned_layers : index
    %active_groups = scf.select %final_layer, %one, %seven : index
    scf.for %dense_group = [%zero to %active_groups step %one] {
      %query_key_group = index.cmp eq, %dense_group, %zero : index
      %head_group = index.cmp ult, %dense_group, %two : index
      %output_group = index.cmp eq, %dense_group, %two : index
      %down_group = index.cmp eq, %dense_group, %six : index
      %residual_group = scalar.ori %output_group, %down_group : i1
      %gate_or_later = index.cmp uge, %dense_group, %three : index
      %before_down = index.cmp ult, %dense_group, %six : index
      %mlp_group = scalar.andi %gate_or_later, %before_down : i1
      %post_norm_group = index.cmp eq, %dense_group, %three : index
      %normalize_rows = scalar.ori %query_key_group, %post_norm_group : i1
      %gather_initial = scalar.andi %initial_layer, %query_key_group : i1
      %wide_chunks = scf.select %down_group, %twenty_four, %sixteen : index
      %dense_chunks = scf.select %residual_group, %wide_chunks, %eight : index
      %dense_roles = scf.select %residual_group, %one, %two : index
      %last_dense_role = index.sub %dense_roles, %one : index
      %last_chunk = index.sub %dense_chunks, %one : index
      scf.if %normalize_rows {
        %row_raw = buffer.view %local_storage[%dense_result_offset] : buffer -> view<4096xbf16>
        %row_width = index.constant 1024 : index
        %row_bytes = index.constant 2048 : offset
        %row_slot_base = index.constant 31680 : offset
        %row_slot_stride = index.constant 16384 : offset
        %row_scale = buffer.view %peer_storage[%row_slot_base] : buffer -> view<1024xbf16>
        %row_column = index.constant 4 : index
        %row_gamma_external = buffer.view %weights[%constant_offset] : buffer -> view<4096xbf16>
        %row_gamma_write, %row_gamma_record = channel.reserve %activation_stream : channel<tile<2048xi32>> -> (write<tile<2048xi32>>, view<2048xi32>)
        %row_gamma_values = view.bitcast %row_gamma_record : view<2048xi32> -> view<4096xbf16>
        %row_gamma_copy = kernel.async.copy %row_gamma_external to %row_gamma_values {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<4096xbf16> to view<4096xbf16> -> kernel.async.token
        %row_gamma_group = kernel.async.group %row_gamma_copy : kernel.async.token -> kernel.async.group
        kernel.async.wait %row_gamma_group {newer_groups = 0} : kernel.async.group
        %input_gamma_word = index.constant 256 : index
        %post_gamma_word = index.constant 1280 : index
        %gamma_word = scf.select %query_key_group, %input_gamma_word, %post_gamma_word : index
        %row_gamma_selected = view.subview %row_gamma_values[%gamma_word] : view<4096xbf16> -> view<1024xbf16>
        scf.for %word = [%zero to %row_width step %vector_step] {
          %value = vector.load %row_gamma_selected[%word] : view<1024xbf16> -> vector<32xbf16>
          vector.store %value, %row_scale[%word] : vector<32xbf16>, view<1024xbf16>
        }
        channel.publish %row_gamma_write : write<tile<2048xi32>>
        scf.for %row_record = [%zero to %eight step %one] {
          %row_input_write, %row_input_record = channel.reserve %activation_stream : channel<tile<2048xi32>> -> (write<tile<2048xi32>>, view<2048xi32>)
          %row_input_values = view.bitcast %row_input_record : view<2048xi32> -> view<4096xbf16>
          %row_input_initial = index.constant 2760704 : offset
          %row_input_base = index.add %row_input_initial, %episode_state_offset : offset
          %row_input_relative = index.scale %row_record, %record_stride : index, offset -> offset
          %row_input_address = index.add %row_input_base, %row_input_relative : offset
          %row_input_external = buffer.view %state[%row_input_address] : buffer -> view<4096xbf16>
          scf.if %gather_initial {
            %gather_rows = view.bitcast %row_input_values : view<4096xbf16> -> view<4x1024xbf16>
            %gather_record_base = index.mul %row_record, %four : index
            %gather_embedding_base = index.constant 497418240 : offset
            %gather_embedding_stride = index.constant 2048 : offset
            %gather_width = index.constant 1024 : index
            %gather_vector_step = index.constant 32 : index
            %gather_zeros = vector.constant 0.0 : vector<32xbf16>
            scf.for %gather_member = [%zero to %four step %one] {
              %gather_token = index.add %gather_record_base, %gather_member : index
              %gather_id = view.load %gather_tokens[%gather_token] : view<32xi32> -> i32
              %gather_live = scalar.cmpi sge, %gather_id, %gather_sequence_zero : i32
              %gather_row = view.subview %gather_rows[%gather_member, 0] : view<4x1024xbf16> -> view<1x1024xbf16>
