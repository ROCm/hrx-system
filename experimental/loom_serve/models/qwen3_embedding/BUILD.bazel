load("//build_tools/bazel:python.bzl", "iree_py_binary")

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "sources",
    srcs = glob(["*.loom"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "model",
    srcs = ["model.json"],
    visibility = ["//visibility:public"],
)

iree_py_binary(
    name = "check_service",
    srcs = ["check_service.py"],
    main = "check_service.py",
    visibility = ["//visibility:public"],
)
