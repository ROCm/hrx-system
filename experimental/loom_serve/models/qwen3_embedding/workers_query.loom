            %finish_half = index.rem %output_record, %two : index
            %finish_half_bytes = index.scale %finish_half, %record_stride : index, offset -> offset
            %finish_member_stride = index.constant 131072 : offset
            %finish_member_bytes = index.scale %finish_member, %finish_member_stride : index, offset -> offset
            %finish_initial = index.constant 114688 : offset
            %finish_base = index.add %finish_initial, %finish_member_bytes : offset
            %finish_address = index.add %finish_base, %finish_half_bytes : offset
            %finish_external = buffer.view %output[%finish_address] : buffer -> view<4096xbf16>
            %finish_copy = kernel.async.copy %row_source to %finish_external {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<4096xbf16> to view<4096xbf16> -> kernel.async.token
            %finish_group = kernel.async.group %finish_copy : kernel.async.token -> kernel.async.group
            kernel.async.wait %finish_group {newer_groups = 0} : kernel.async.group
          } else {
            %normalized_initial = index.constant 1057216 : offset
            %normalized_relative = index.scale %output_record, %record_stride : index, offset -> offset
            %normalized_base = index.add %normalized_initial, %episode_state_offset : offset
            %normalized_address = index.add %normalized_base, %normalized_relative : offset
            %normalized_external = buffer.view %state[%normalized_address] : buffer -> view<8x16x32xbf16, #encoding.layout.strided<strides=[16384, 256, 1]>>
            %normalized_local = view.bitcast %row_source : view<4096xbf16> -> view<8x16x32xbf16>
            %normalized_copy = kernel.async.copy %normalized_local to %normalized_external {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<8x16x32xbf16> to view<8x16x32xbf16, #encoding.layout.strided<strides=[16384, 256, 1]>> -> kernel.async.token
            %normalized_group = kernel.async.group %normalized_copy : kernel.async.token -> kernel.async.group
            kernel.async.wait %normalized_group {newer_groups = 0} : kernel.async.group
          }
          channel.release %row_read : read<tile<4096xbf16>>
