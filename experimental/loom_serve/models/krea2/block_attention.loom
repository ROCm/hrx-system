config.decl @krea2.block_tokens : %value: index where [range(%value, 16, 65536), mul(%value, 16)]
amdgpu.target<gfx11-generic> @block_attention_wave64 {subgroup_size = 64}
template.decl @attention.masked_gqa_128_bf16(%tokens: index, %query_heads: index, %key_value_heads: index, %query: buffer, %key: buffer, %value: buffer, %mask: buffer) -> (vector<8xbf16>)
template.decl @attention.store_128_bf16(%tokens: index, %heads: index, %values: vector<8xbf16>, %output: buffer)
template.decl @attention.gate_128_bf16(%tokens: index, %heads: index, %values: vector<8xbf16>, %gate: buffer) -> (vector<8xbf16>)

kernel.def target(@block_attention_wave64) @block_attention() {
  %tokens = config.get @krea2.block_tokens : index
  %tile = index.constant 16 : index
  %groups = index.div %tokens, %tile : index
  %heads = index.constant 48 : index
  %unit = index.constant 1 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%groups, %heads, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%query: buffer, %key: buffer, %value: buffer, %mask: buffer, %output: buffer) {
  %tokens = config.get @krea2.block_tokens : index
  %query_heads = index.constant 48 : index
  %key_value_heads = index.constant 12 : index
  %result = template.apply<@attention.masked_gqa_128_bf16>(%tokens, %query_heads, %key_value_heads, %query, %key, %value, %mask) : (index, index, index, buffer, buffer, buffer, buffer) -> (vector<8xbf16>)
  template.apply<@attention.store_128_bf16>(%tokens, %query_heads, %result, %output) : (index, index, vector<8xbf16>, buffer)
  kernel.return
}

kernel.def target(@block_attention_wave64) @block_attention_gated() {
  %tokens = config.get @krea2.block_tokens : index
  %tile = index.constant 16 : index
  %groups = index.div %tokens, %tile : index
  %heads = index.constant 48 : index
  %unit = index.constant 1 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%groups, %heads, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%query: buffer, %key: buffer, %value: buffer, %mask: buffer, %gate: buffer, %output: buffer) {
  %tokens = config.get @krea2.block_tokens : index
  %query_heads = index.constant 48 : index
  %key_value_heads = index.constant 12 : index
  %result = template.apply<@attention.masked_gqa_128_bf16>(%tokens, %query_heads, %key_value_heads, %query, %key, %value, %mask) : (index, index, index, buffer, buffer, buffer, buffer) -> (vector<8xbf16>)
  %gated = template.apply<@attention.gate_128_bf16>(%tokens, %query_heads, %result, %gate) : (index, index, vector<8xbf16>, buffer) -> (vector<8xbf16>)
  template.apply<@attention.store_128_bf16>(%tokens, %query_heads, %gated, %output) : (index, index, vector<8xbf16>, buffer)
  kernel.return
}

command.program.def public @krea2.block_attention_ungated() launch(%query: buffer, %key: buffer, %value: buffer, %mask: buffer, %output: buffer) {
  %tokens = config.get @krea2.block_tokens : index
  %origin = index.constant 0 : offset
  %query_view = buffer.view %query[%origin] : buffer -> view<[%tokens]x6144xbf16>
  %key_view = buffer.view %key[%origin] : buffer -> view<[%tokens]x1536xbf16>
  %value_view = buffer.view %value[%origin] : buffer -> view<[%tokens]x1536xbf16>
  %mask_view = buffer.view %mask[%origin] : buffer -> view<[%tokens]xi8>
  %output_view = buffer.view %output[%origin] : buffer -> view<[%tokens]x6144xbf16>
  kernel.launch @block_attention(%query_view, %key_view, %value_view, %mask_view, %output_view) : (view<[%tokens]x6144xbf16>, view<[%tokens]x1536xbf16>, view<[%tokens]x1536xbf16>, view<[%tokens]xi8>, view<[%tokens]x6144xbf16>)
  command.return
}

command.program.def public @krea2.block_attention_context() launch(%query: buffer, %key: buffer, %value: buffer, %mask: buffer, %gate: buffer, %output: buffer) {
  %tokens = config.get @krea2.block_tokens : index
  %origin = index.constant 0 : offset
  %query_view = buffer.view %query[%origin] : buffer -> view<[%tokens]x6144xbf16>
  %key_view = buffer.view %key[%origin] : buffer -> view<[%tokens]x1536xbf16>
  %value_view = buffer.view %value[%origin] : buffer -> view<[%tokens]x1536xbf16>
  %mask_view = buffer.view %mask[%origin] : buffer -> view<[%tokens]xi8>
  %gate_view = buffer.view %gate[%origin] : buffer -> view<[%tokens]x6144xbf16>
  %output_view = buffer.view %output[%origin] : buffer -> view<[%tokens]x6144xbf16>
  kernel.launch @block_attention_gated(%query_view, %key_view, %value_view, %mask_view, %gate_view, %output_view) : (view<[%tokens]x6144xbf16>, view<[%tokens]x1536xbf16>, view<[%tokens]x1536xbf16>, view<[%tokens]xi8>, view<[%tokens]x6144xbf16>, view<[%tokens]x6144xbf16>)
  command.return
}
