config.decl @krea2.time_count : %value: index where [range(%value, 1, 256)]
amdgpu.target<gfx11-generic> @time_wave32 {subgroup_size = 32}
template.decl @time.sinusoidal_bf16(%count: index, %capacity: index, %input: buffer, %output: buffer)
template.decl @activation.gelu_bf16(%value: bf16) -> (bf16)
template.decl @projection.linear_f32_as_bf16(%rows: index, %inputs: index, %outputs: index, %input: buffer, %weight: buffer) -> (vector<8xf32>)
template.decl @projection.bias_f32_as_bf16(%outputs: index, %result: vector<8xf32>, %bias: buffer) -> (vector<8xf32>)
template.decl @projection.store_bf16(%rows: index, %outputs: index, %result: vector<8xf32>, %output: buffer)
template.decl @projection.adapter_epilogue_bf16(%rows: index, %outputs: index, %result: vector<8xf32>, %strength: buffer, %base: buffer) -> (vector<8xf32>)
template.decl @krea2.time_conditioning(%rows: index, %adapted: i1, %parameters: buffer, %adapter: buffer, %times: buffer, %strength: buffer, %output: buffer)

kernel.def target(@time_wave32) @krea_time_sinusoidal() {
  %count = config.get @krea2.time_count : index
  %tile = index.constant 16 : index
  %padding = index.constant 15 : index
  %padded_count = index.add %count, %padding : index
  %tiles = index.div %padded_count, %tile : index
  %rows = index.mul %tiles, %tile : index
  %one = index.constant 1 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%rows, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%input: buffer, %output: buffer) {
  %count = config.get @krea2.time_count : index
  %tile = index.constant 16 : index
  %padding = index.constant 15 : index
  %padded_count = index.add %count, %padding : index
  %tiles = index.div %padded_count, %tile : index
  %rows = index.mul %tiles, %tile : index
  template.apply<@time.sinusoidal_bf16>(%count, %rows, %input, %output) : (index, index, buffer, buffer)
  kernel.return
}

kernel.def target(@time_wave32) @krea_time_gelu() {
  %count = config.get @krea2.time_count : index
  %tile = index.constant 16 : index
  %padding = index.constant 15 : index
  %padded_count = index.add %count, %padding : index
  %tiles = index.div %padded_count, %tile : index
  %rows = index.mul %tiles, %tile : index
  %groups_per_row = index.constant 24 : index
  %groups = index.mul %rows, %groups_per_row : index
  %one = index.constant 1 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%groups, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%input: buffer, %output: buffer) {
  %count = config.get @krea2.time_count : index
  %tile = index.constant 16 : index
  %padding = index.constant 15 : index
  %padded_count = index.add %count, %padding : index
  %tiles = index.div %padded_count, %tile : index
  %rows = index.mul %tiles, %tile : index
  %width = index.constant 6144 : index
  %elements = index.mul %rows, %width : index
  %threads = index.constant 256 : index
  %group = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %element = index.madd %group, %threads, %lane : index
  %origin = index.constant 0 : offset
  %input_view = buffer.view %input[%origin] : buffer -> view<[%elements]xbf16>
  %output_view = buffer.view %output[%origin] : buffer -> view<[%elements]xbf16>
  %value = view.load %input_view[%element] : view<[%elements]xbf16> -> bf16
  %result = template.apply<@activation.gelu_bf16>(%value) : (bf16) -> (bf16)
  view.store %result, %output_view[%element] : bf16, view<[%elements]xbf16>
  kernel.return
}

// Each concrete model leaf fixes its contraction shape before JITing the
// shared arithmetic; no shape scalars remain in the device ABI.
kernel.def target(@time_wave32) @krea_time_linear_first() {
  %count = config.get @krea2.time_count : index
  %tile = index.constant 16 : index
  %padding = index.constant 15 : index
  %padded_count = index.add %count, %padding : index
  %tiles = index.div %padded_count, %tile : index
  %rows = index.mul %tiles, %tile : index

  %output_tiles = index.constant 384 : index
  %one = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%tiles, %output_tiles, %one) workgroup_size(%threads, %one, %one) : index
} launch(%input: buffer, %weight: buffer, %bias: buffer, %output: buffer) {
  %count = config.get @krea2.time_count : index
  %tile = index.constant 16 : index
  %padding = index.constant 15 : index
  %padded_count = index.add %count, %padding : index
  %tiles = index.div %padded_count, %tile : index
  %rows = index.mul %tiles, %tile : index

  %inputs = index.constant 256 : index
  %outputs = index.constant 6144 : index
  %result = template.apply<@projection.linear_f32_as_bf16>(%rows, %inputs, %outputs, %input, %weight) : (index, index, index, buffer, buffer) -> (vector<8xf32>)
  %final = template.apply<@projection.bias_f32_as_bf16>(%outputs, %result, %bias) : (index, vector<8xf32>, buffer) -> (vector<8xf32>)
  template.apply<@projection.store_bf16>(%rows, %outputs, %final, %output) : (index, index, vector<8xf32>, buffer)
  kernel.return
}

