command.program.def public @krea2.time_first(%adapted: i1, %output_offset: offset) launch(%parameters: buffer, %adapter: buffer, %input: buffer, %strength: buffer, %output: buffer) {
  %count = config.get @krea2.time_count : index
  %tile = index.constant 16 : index
  %padding = index.constant 15 : index
  %padded_count = index.add %count, %padding : index
  %tiles = index.div %padded_count, %tile : index
  %rows = index.mul %tiles, %tile : index
  %output_view = buffer.view %output[%output_offset] : buffer -> view<[%rows]x6144xbf16>
  %weight = command.parameter %parameters, "tmlp.0.weight" : view<6144x256xf32>
  %bias = command.parameter %parameters, "tmlp.0.bias" : view<6144xf32>
  scf.if %adapted {
    %rank_bytes = index.constant 64 : offset
    %low_bytes = index.scale %rows, %rank_bytes : index, offset -> offset
    %low = buffer.alloca<global> align(256) %low_bytes : buffer
    %down = command.parameter %adapter, "transformer.time_embed.linear_1.lora_A.weight" : view<32x256xf32>
    %up = command.parameter %adapter, "transformer.time_embed.linear_1.lora_B.weight" : view<6144x32xf32>
    command.concurrent {
      kernel.launch @krea_time_linear_first(%input, %weight, %bias, %output_view) : (buffer, view<6144x256xf32>, view<6144xf32>, view<[%rows]x6144xbf16>)
      kernel.launch @krea_time_adapter_down_features(%input, %down, %low) : (buffer, view<32x256xf32>, buffer)
    }
    kernel.launch @krea_time_adapter_add_hidden(%low, %up, %strength, %output_view, %output_view) : (buffer, view<6144x32xf32>, buffer, view<[%rows]x6144xbf16>, view<[%rows]x6144xbf16>)
    scf.yield
  } else {
    kernel.launch @krea_time_linear_first(%input, %weight, %bias, %output_view) : (buffer, view<6144x256xf32>, view<6144xf32>, view<[%rows]x6144xbf16>)
    scf.yield
  }
  command.return
}

command.program.def public @krea2.time_embedding(%adapted: i1, %output_offset: offset) launch(%parameters: buffer, %adapter: buffer, %input: buffer, %strength: buffer, %output: buffer) {
  %count = config.get @krea2.time_count : index
  %tile = index.constant 16 : index
  %padding = index.constant 15 : index
  %padded_count = index.add %count, %padding : index
  %tiles = index.div %padded_count, %tile : index
  %rows = index.mul %tiles, %tile : index
  %output_view = buffer.view %output[%output_offset] : buffer -> view<[%rows]x6144xbf16>
  %weight = command.parameter %parameters, "tmlp.2.weight" : view<6144x6144xf32>
  %bias = command.parameter %parameters, "tmlp.2.bias" : view<6144xf32>
  scf.if %adapted {
    %rank_bytes = index.constant 64 : offset
    %low_bytes = index.scale %rows, %rank_bytes : index, offset -> offset
    %low = buffer.alloca<global> align(256) %low_bytes : buffer
    %down = command.parameter %adapter, "transformer.time_embed.linear_2.lora_A.weight" : view<32x6144xf32>
    %up = command.parameter %adapter, "transformer.time_embed.linear_2.lora_B.weight" : view<6144x32xf32>
    command.concurrent {
      kernel.launch @krea_time_linear_embedding(%input, %weight, %bias, %output_view) : (buffer, view<6144x6144xf32>, view<6144xf32>, view<[%rows]x6144xbf16>)
      kernel.launch @krea_time_adapter_down_hidden(%input, %down, %low) : (buffer, view<32x6144xf32>, buffer)
    }
    kernel.launch @krea_time_adapter_add_hidden(%low, %up, %strength, %output_view, %output_view) : (buffer, view<6144x32xf32>, buffer, view<[%rows]x6144xbf16>, view<[%rows]x6144xbf16>)
    scf.yield
  } else {
    kernel.launch @krea_time_linear_embedding(%input, %weight, %bias, %output_view) : (buffer, view<6144x6144xf32>, view<6144xf32>, view<[%rows]x6144xbf16>)
    scf.yield
  }
  command.return
}

command.program.def public @krea2.time_modulation(%adapted: i1, %output_offset: offset) launch(%parameters: buffer, %adapter: buffer, %input: buffer, %strength: buffer, %output: buffer) {
  %count = config.get @krea2.time_count : index
  %tile = index.constant 16 : index
  %padding = index.constant 15 : index
  %padded_count = index.add %count, %padding : index
  %tiles = index.div %padded_count, %tile : index
  %rows = index.mul %tiles, %tile : index
  %output_view = buffer.view %output[%output_offset] : buffer -> view<[%rows]x36864xbf16>
  %weight = command.parameter %parameters, "tproj.1.weight" : view<36864x6144xf32>
  %bias = command.parameter %parameters, "tproj.1.bias" : view<36864xf32>
  scf.if %adapted {
    %rank_bytes = index.constant 64 : offset
    %low_bytes = index.scale %rows, %rank_bytes : index, offset -> offset
    %low = buffer.alloca<global> align(256) %low_bytes : buffer
    %down = command.parameter %adapter, "transformer.time_mod_proj.lora_A.weight" : view<32x6144xf32>
    %up = command.parameter %adapter, "transformer.time_mod_proj.lora_B.weight" : view<36864x32xf32>
    command.concurrent {
      kernel.launch @krea_time_linear_modulation(%input, %weight, %bias, %output_view) : (buffer, view<36864x6144xf32>, view<36864xf32>, view<[%rows]x36864xbf16>)
      kernel.launch @krea_time_adapter_down_hidden(%input, %down, %low) : (buffer, view<32x6144xf32>, buffer)
    }
    kernel.launch @krea_time_adapter_add_modulation(%low, %up, %strength, %output_view, %output_view) : (buffer, view<36864x32xf32>, buffer, view<[%rows]x36864xbf16>, view<[%rows]x36864xbf16>)
    scf.yield
  } else {
    kernel.launch @krea_time_linear_modulation(%input, %weight, %bias, %output_view) : (buffer, view<36864x6144xf32>, view<36864xf32>, view<[%rows]x36864xbf16>)
    scf.yield
  }
  command.return
}

// Output is two adjacent complete physical tables: rows*6144 BF16 embedding
// values, then rows*36864 BF16 modulation values. Padding is not a model step.
template.def<@krea2.time_conditioning> @krea2_time_conditioning(%rows: index, %adapted: i1, %parameters: buffer, %adapter: buffer, %times: buffer, %strength: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %feature_row_bytes = index.constant 512 : offset
  %hidden_row_bytes = index.constant 12288 : offset
  %feature_bytes = index.scale %rows, %feature_row_bytes : index, offset -> offset
  %hidden_bytes = index.scale %rows, %hidden_row_bytes : index, offset -> offset
  %features = buffer.alloca<global> align(256) %feature_bytes : buffer
  %hidden = buffer.alloca<global> align(256) %hidden_bytes : buffer
  %activated = buffer.alloca<global> align(256) %hidden_bytes : buffer
  kernel.launch @krea_time_sinusoidal(%times, %features) : (buffer, buffer)
  command.program.launch @krea2.time_first[%adapted, %origin](%parameters, %adapter, %features, %strength, %hidden) : [i1, offset](buffer, buffer, buffer, buffer, buffer)
  kernel.launch @krea_time_gelu(%hidden, %activated) : (buffer, buffer)
  command.program.launch @krea2.time_embedding[%adapted, %origin](%parameters, %adapter, %activated, %strength, %output) : [i1, offset](buffer, buffer, buffer, buffer, buffer)
  kernel.launch @krea_time_gelu(%output, %activated) : (buffer, buffer)
  command.program.launch @krea2.time_modulation[%adapted, %hidden_bytes](%parameters, %adapter, %activated, %strength, %output) : [i1, offset](buffer, buffer, buffer, buffer, buffer)
  template.return
}

command.program.def public @time_conditioning() launch(%parameters: buffer, %times: buffer, %output: buffer) {
  %count = config.get @krea2.time_count : index
  %tile = index.constant 16 : index
  %padding = index.constant 15 : index
  %padded_count = index.add %count, %padding : index
  %tiles = index.div %padded_count, %tile : index
  %rows = index.mul %tiles, %tile : index
  %adapted = scalar.constant false : i1
  template.apply<@krea2.time_conditioning>(%rows, %adapted, %parameters, %parameters, %times, %times, %output) : (index, i1, buffer, buffer, buffer, buffer, buffer)
  command.return
}

command.program.def public @time_conditioning_adapted() launch(%parameters: buffer, %adapter: buffer, %times: buffer, %strength: buffer, %output: buffer) {
  %count = config.get @krea2.time_count : index
  %tile = index.constant 16 : index
  %padding = index.constant 15 : index
  %padded_count = index.add %count, %padding : index
  %tiles = index.div %padded_count, %tile : index
  %rows = index.mul %tiles, %tile : index
  %adapted = scalar.constant true : i1
  template.apply<@krea2.time_conditioning>(%rows, %adapted, %parameters, %adapter, %times, %strength, %output) : (index, i1, buffer, buffer, buffer, buffer, buffer)
  command.return
}
