  %texts = config.get @krea2.text_tokens : index
  %layers = index.constant 12 : index
  %rows = index.mul %texts, %layers : index
  %heads = index.constant 20 : index
  %norm_rows = index.mul %rows, %heads : index
  %width = index.constant 128 : index
  %threads = index.constant 128 : index
  template.apply<@normalization.zero_centered_rows_bf16>(%norm_rows, %width, %threads, %input, %weight, %output) : (index, index, index, buffer, buffer, buffer)
  kernel.return
}

kernel.def target(@fusion_wave32) @fusion_layerwise_linear_2560_2560() {
  %texts = config.get @krea2.text_tokens : index
  %layers = index.constant 12 : index
  %rows = index.mul %texts, %layers : index
  %tile = index.constant 16 : index
  %groups = index.div %rows, %tile : index
  %columns = index.constant 160 : index
  %one = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%groups, %columns, %one) workgroup_size(%threads, %one, %one) : index
} launch(%input: buffer, %weight: buffer, %output: buffer) {
  %texts = config.get @krea2.text_tokens : index
  %layers = index.constant 12 : index
  %rows = index.mul %texts, %layers : index
  %inputs = index.constant 2560 : index
  %outputs = index.constant 2560 : index
  %result = template.apply<@projection.linear_bf16>(%rows, %inputs, %outputs, %input, %weight) : (index, index, index, buffer, buffer) -> (vector<8xf32>)
  %output_layout = encoding.layout.dense : encoding<layout>
  %projection_tile = index.constant 16 : index
  %row_tile = kernel.workgroup.id<x> : index
  %output_tile = kernel.workgroup.id<y> : index
  %row_origin = index.mul %row_tile, %projection_tile : index
  %output_origin = index.mul %output_tile, %projection_tile : index
  template.apply<@projection.store_bf16>(%rows, %outputs, %row_origin, %output_origin, %output_layout, %result, %output) : (index, index, index, index, encoding<layout>, vector<8xf32>, buffer)
  kernel.return
}

