kernel.def target(@fusion_wave32) @fusion_refiner_residual() {
  %rows = config.get @krea2.text_tokens : index
  %groups_per_row = index.constant 10 : index
  %groups = index.mul %rows, %groups_per_row : index
  %one = index.constant 1 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%groups, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%input: buffer, %update: buffer, %output: buffer) {
  %rows = config.get @krea2.text_tokens : index
  %width = index.constant 2560 : index
  %elements = index.mul %rows, %width : index
  %origin = index.constant 0 : offset
  %threads = index.constant 256 : index
  %group = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %element = index.madd %group, %threads, %lane : index
  %input_view = buffer.view %input[%origin] : buffer -> view<[%elements]xbf16>
  %output_view = buffer.view %output[%origin] : buffer -> view<[%elements]xbf16>
  %value = view.load %input_view[%element] : view<[%elements]xbf16> -> bf16
  %update_view = buffer.view %update[%origin] : buffer -> view<[%elements]xbf16>
  %delta = view.load %update_view[%element] : view<[%elements]xbf16> -> bf16
  %value_f32 = scalar.extf %value : bf16 to f32
  %delta_f32 = scalar.extf %delta : bf16 to f32
  %sum = scalar.addf %value_f32, %delta_f32 : f32
  %result = scalar.fptrunc %sum : f32 to bf16
  view.store %result, %output_view[%element] : bf16, view<[%elements]xbf16>
  kernel.return
}

kernel.def target(@fusion_wave32) @fusion_refiner_product() {
  %rows = config.get @krea2.text_tokens : index
