  %groups = index.mul %rows, %groups_per_row : index
  %one = index.constant 1 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%groups, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%input: buffer, %up: buffer, %output: buffer) {
  %rows = config.get @krea2.text_tokens : index
  %width = index.constant 6912 : index
  %elements = index.mul %rows, %width : index
  %origin = index.constant 0 : offset
  %threads = index.constant 256 : index
  %group = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %element = index.madd %group, %threads, %lane : index
  %input_view = buffer.view %input[%origin] : buffer -> view<[%elements]xbf16>
  %output_view = buffer.view %output[%origin] : buffer -> view<[%elements]xbf16>
  %value = view.load %input_view[%element] : view<[%elements]xbf16> -> bf16
  %up_view = buffer.view %up[%origin] : buffer -> view<[%elements]xbf16>
  %up_value = view.load %up_view[%element] : view<[%elements]xbf16> -> bf16
  %activated = template.apply<@activation.silu_bf16>(%value) : (bf16) -> (bf16)
  %activated_f32 = scalar.extf %activated : bf16 to f32
  %up_f32 = scalar.extf %up_value : bf16 to f32
  %product = scalar.mulf %activated_f32, %up_f32 : f32
  %result = scalar.fptrunc %product : f32 to bf16
  view.store %result, %output_view[%element] : bf16, view<[%elements]xbf16>
  kernel.return
}

kernel.def target(@fusion_wave32) @fusion_layerwise_attention_gated() {
  %texts = config.get @krea2.text_tokens : index
  %layers = index.constant 12 : index
  %rows = index.mul %texts, %layers : index
  %four = index.constant 4 : index
  %groups = index.div %rows, %four : index
  %heads = index.constant 20 : index
  %one = index.constant 1 : index
  %threads = index.constant 128 : index
  kernel.launch.config workgroups(%groups, %heads, %one) workgroup_size(%threads, %one, %one) : index
} launch(%query: buffer, %key: buffer, %value: buffer, %gate: buffer, %output: buffer) {
  %texts = config.get @krea2.text_tokens : index
  %layers = index.constant 12 : index
  %rows = index.mul %texts, %layers : index
  %length = index.constant 12 : index
  %heads = index.constant 20 : index
  %four = index.constant 4 : index
  %head_width = index.constant 128 : index
  %width = index.constant 2560 : index
  %group = kernel.workgroup.id<x> : index
  %head = kernel.workgroup.id<y> : index
  %wave = kernel.subgroup.id : index
  %lane = kernel.subgroup.lane.id : index
  %row = index.madd %group, %four, %wave : index
  %lane_column = index.mul %lane, %four : index
  %column = index.madd %head, %head_width, %lane_column : index
  %result = template.apply<@attention.segmented_128_bf16>(%rows, %length, %heads, %row, %head, %query, %key, %value) : (index, index, index, index, index, buffer, buffer, buffer) -> (vector<4xbf16>)
  %origin = index.constant 0 : offset
  %output_view = buffer.view %output[%origin] : buffer -> view<[%rows]x[%width]xbf16>
  %gate_view = buffer.view %gate[%origin] : buffer -> view<[%rows]x[%width]xbf16>
  %gate_values = vector.load %gate_view[%row, %column] : view<[%rows]x[%width]xbf16> -> vector<4xbf16>
  %gate_f32 = vector.extf %gate_values : vector<4xbf16> to vector<4xf32>
  %negative = vector.negf %gate_f32 : vector<4xf32>
  %exponential = vector.expf<afn> %negative : vector<4xf32>
  %ones = vector.constant 1.0 : vector<4xf32>
  %denominator = vector.addf %ones, %exponential : vector<4xf32>
  %sigmoid = vector.divf<arcp> %ones, %denominator : vector<4xf32>
  %rounded_sigmoid = vector.fptrunc %sigmoid : vector<4xf32> to vector<4xbf16>
  %sigmoid_f32 = vector.extf %rounded_sigmoid : vector<4xbf16> to vector<4xf32>
  %values_f32 = vector.extf %result : vector<4xbf16> to vector<4xf32>
  %product = vector.mulf %values_f32, %sigmoid_f32 : vector<4xf32>
  %gated = vector.fptrunc %product : vector<4xf32> to vector<4xbf16>
  vector.store %gated, %output_view[%row, %column] : vector<4xbf16>, view<[%rows]x[%width]xbf16>
  kernel.return
}

