// Rows and outputs are positive multiples of 16, inputs of 256; the positive
// group size selects the number of row tiles in a traversal panel. All are
// specialization facts. Input, weight and output storage do not overlap.
// Four waves share two temporal LDS banks and accumulate all K terms in F32.
// Missing rows are zero-filled, and only complete valid 16-row fragments store.
//
// A workgroup-uniform branch specializes the full contraction, not each packet.
// The interior path establishes the affine bound consumed by existing packet
// guards. The final partial tile retains its original zero-filled packet path.
// Both paths share one physical LDS allocation.
template.decl @projection.linear_temporal_bf16(%rows: index, %inputs: index, %outputs: index, %group_size: index, %input: buffer, %weight: buffer, %output: buffer)
template.def<@projection.linear_temporal_bf16> device @linear_temporal_bf16(%rows: index, %inputs: index, %outputs: index, %group_size: index, %input: buffer, %weight: buffer, %output: buffer) {
  %row_tile = index.constant 128 : index
  %output_tile = index.constant 96 : index
  %stage_bytes = index.constant 65024 : offset
  %stage = buffer.alloca<workgroup> align(16) %stage_bytes : buffer
  %row_group, %output_group = template.apply<@projection.temporal_coordinates>(%rows, %outputs, %group_size) : (index, index, index) -> (index, index)
  %row_origin = index.mul %row_group, %row_tile : index
  %output_origin = index.mul %output_group, %output_tile : index
  %full_output_tiles = index.div %outputs, %output_tile : index
  %interior = index.cmp ult, %output_group, %full_output_tiles : index
  scf.if %interior {
    %last_full_origin = index.sub %outputs, %output_tile : index
    %proven_output_origin = index.assume %output_origin [le(%output_origin, %last_full_origin)] : index
    template.apply<@projection.linear_temporal_at>(%rows, %inputs, %outputs, %row_origin, %proven_output_origin, %stage, %input, %weight, %output) : (index, index, index, index, index, buffer, buffer, buffer, buffer)
    scf.yield
  } else {
    template.apply<@projection.linear_temporal_at>(%rows, %inputs, %outputs, %row_origin, %output_origin, %stage, %input, %weight, %output) : (index, index, index, index, index, buffer, buffer, buffer, buffer)
    scf.yield
  }
  template.return
}
