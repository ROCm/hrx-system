// Temporal-bank BF16 X W^T. No model configuration lives here.
// M128 x N96, K64, four wave32s. Each wave owns two M16 tiles 64 rows apart
// and six N16 tiles: twelve full-K result fragments, 96 F32 values per lane.
// The caller provides positive M/N multiples of 16 and K >= 256, multiple 256.
// X, [N,K] weights and dense [M,N] output do not overlap.
//
// Two temporal banks each contain W[96,72] followed by X[128,72] BF16.
// Bank stride 32768 leaves a 512-byte gap; the complete allocation is 65024.
// All workitems reach one transition barrier per consumed K64, including tails.
// The fourteen explicit queued packets are not wrapped in scf.for pipeline.

template.decl @projection.temporal_coordinates(%rows: index, %outputs: index, %group_size: index) -> (index, index)
template.def<@projection.temporal_coordinates> device @temporal_coordinates(%rows: index, %outputs: index, %group_size: index) -> (index, index) {
  %zero = index.constant 0 : index
  %row_tile = index.constant 128 : index
  %output_tile = index.constant 96 : index
  %row_rounding = index.constant 127 : index
  %output_rounding = index.constant 95 : index
  %physical_row = kernel.workgroup.id<x> : index
  %physical_output = kernel.workgroup.id<y> : index
  %padded_rows = index.add %rows, %row_rounding : index
  %padded_outputs = index.add %outputs, %output_rounding : index
  %row_tiles = index.div %padded_rows, %row_tile : index
  %output_tiles = index.div %padded_outputs, %output_tile : index
  %whole_rows = index.cmp uge, %group_size, %row_tiles : index
  %row, %column = scf.if %whole_rows -> (index, index) {
    scf.yield %physical_row, %physical_output : index, index
  } else {
    %flat = index.madd %physical_output, %row_tiles, %physical_row : index
    %group_width = index.mul %group_size, %output_tiles : index
    %group = index.div %flat, %group_width : index
    %group_row = index.mul %group, %group_size : index
    %within_group = index.rem %flat, %group_width : index
    %tail_rows = index.rem %row_tiles, %group_size : index
    %has_tail = index.cmp ne, %tail_rows, %zero : index
    %within_row, %output_unbounded = scf.if %has_tail -> (index, index) {
      %full_rows = index.sub %row_tiles, %tail_rows : index
      %is_tail = index.cmp uge, %group_row, %full_rows : index
      %within, %output = scf.if %is_tail -> (index, index) {
        %within = index.rem %within_group, %tail_rows : index
        %output = index.div %within_group, %tail_rows : index
        scf.yield %within, %output : index, index
      } else {
        %within = index.rem %within_group, %group_size : index
        %output = index.div %within_group, %group_size : index
        scf.yield %within, %output : index, index
      }
      scf.yield %within, %output : index, index
    } else {
      %within = index.rem %within_group, %group_size : index
      %output = index.div %within_group, %group_size : index
      scf.yield %within, %output : index, index
    }
    %row_unbounded = index.add %group_row, %within_row : index
    %bounded_row = index.assume %row_unbounded [ge(%row_unbounded, 0), lt(%row_unbounded, %row_tiles)] : index
    %bounded_output = index.assume %output_unbounded [ge(%output_unbounded, 0), lt(%output_unbounded, %output_tiles)] : index
    scf.yield %bounded_row, %bounded_output : index, index
  }
  template.return %row, %column : index, index
}

// Row tails are guarded before any global access. The caller only requests
// valid K packets; the penultimate tile publishes without acquiring a refill.
template.decl @projection.temporal_packet(%rows: index, %inputs: index, %row: index, %column: index, %source: buffer) -> (vector<8xbf16>)
template.def<@projection.temporal_packet> device @temporal_packet(%rows: index, %inputs: index, %row: index, %column: index, %source: buffer) -> (vector<8xbf16>) {
  %origin = index.constant 0 : offset
  %row_valid = index.cmp ult, %row, %rows : index
  %values = scf.if %row_valid -> (vector<8xbf16>) {
    %view = buffer.view %source[%origin] : buffer -> view<[%rows]x[%inputs]xbf16>
    %loaded = vector.load %view[%row, %column] : view<[%rows]x[%inputs]xbf16> -> vector<8xbf16>
    scf.yield %loaded : vector<8xbf16>
  } else {
    %padding = vector.constant 0.0 : vector<8xbf16>
    scf.yield %padding : vector<8xbf16>
  }
  template.return %values : vector<8xbf16>
}

// Publish the old packet to the opposite temporal bank before acquiring its
// replacement. The old SSA value has no consumer after this store.
template.decl @projection.temporal_refill(%rows: index, %inputs: index, %row_origin: index, %stage_rows: index, %stage_row: index, %stage_column: index, %next_column: index, %source: buffer, %stage: buffer, %bank: offset, %operand_offset: offset, %queued: vector<8xbf16>) -> (vector<8xbf16>)
template.def<@projection.temporal_refill> device @temporal_refill(%rows: index, %inputs: index, %row_origin: index, %stage_rows: index, %stage_row: index, %stage_column: index, %next_column: index, %source: buffer, %stage: buffer, %bank: offset, %operand_offset: offset, %queued: vector<8xbf16>) -> (vector<8xbf16>) {
  %offset = index.add %bank, %operand_offset : offset
  %view = buffer.view %stage[%offset] : buffer -> view<[%stage_rows]x72xbf16>
  vector.store %queued, %view[%stage_row, %stage_column] : vector<8xbf16>, view<[%stage_rows]x72xbf16>
  %row = index.add %row_origin, %stage_row : index
  %column = index.add %next_column, %stage_column : index
  %replacement = template.apply<@projection.temporal_packet>(%rows, %inputs, %row, %column, %source) : (index, index, index, index, buffer) -> (vector<8xbf16>)
  template.return %replacement : vector<8xbf16>
}

// Current operands are acquired only after guarded packet publication/refill.
// Two RHS fragments are acquired before four row updates; the next pair
// cannot extend their lifetimes across this compile-time scheduling boundary.
template.decl @projection.temporal_mma(%stage: buffer, %bank: offset, %wave_row: index, %column: index, %acc00: vector<8xf32>, %acc01: vector<8xf32>, %acc02: vector<8xf32>, %acc03: vector<8xf32>, %acc04: vector<8xf32>, %acc05: vector<8xf32>, %acc10: vector<8xf32>, %acc11: vector<8xf32>, %acc12: vector<8xf32>, %acc13: vector<8xf32>, %acc14: vector<8xf32>, %acc15: vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>)
template.def<@projection.temporal_mma> device @temporal_mma(%stage: buffer, %bank: offset, %wave_row: index, %column: index, %acc00: vector<8xf32>, %acc01: vector<8xf32>, %acc02: vector<8xf32>, %acc03: vector<8xf32>, %acc04: vector<8xf32>, %acc05: vector<8xf32>, %acc10: vector<8xf32>, %acc11: vector<8xf32>, %acc12: vector<8xf32>, %acc13: vector<8xf32>, %acc14: vector<8xf32>, %acc15: vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
  // A compiler ordering boundary, not a runtime wait or workgroup barrier.
  scf.schedule.fence
  %tile = index.constant 16 : index
  %sixty_four = index.constant 64 : index
  %input_offset = index.constant 13824 : offset
  %input_bank = index.add %bank, %input_offset : offset
  %input_view = buffer.view %stage[%input_bank] : buffer -> view<128x72xbf16>
  %weight_view = buffer.view %stage[%bank] : buffer -> view<96x72xbf16>
  %second_row = index.add %wave_row, %sixty_four : index
  %lhs0 = vector.fragment.load<lhs> %input_view[%wave_row, %column] shape [%tile, %tile] : view<128x72xbf16> -> vector<16xbf16>
  %lhs1 = vector.fragment.load<lhs> %input_view[%second_row, %column] shape [%tile, %tile] : view<128x72xbf16> -> vector<16xbf16>
  %lane = kernel.subgroup.lane.id : index
  %lane_row = index.rem %lane, %tile : index
  %offset0 = index.constant 0 : index
  %row0 = index.add %lane_row, %offset0 : index
  %weight0 = vector.load %weight_view[%row0, %column] : view<96x72xbf16> -> vector<16xbf16>
  %rhs0 = vector.fragment<rhs> %weight0 shape [%tile, %tile] : vector<16xbf16>
  %offset1 = index.constant 16 : index
  %row1 = index.add %lane_row, %offset1 : index
  %weight1 = vector.load %weight_view[%row1, %column] : view<96x72xbf16> -> vector<16xbf16>
  %rhs1 = vector.fragment<rhs> %weight1 shape [%tile, %tile] : vector<16xbf16>
  %result00 = vector.mma %lhs0, %rhs0, %acc00 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
  %result10 = vector.mma %lhs1, %rhs0, %acc10 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
  %result01 = vector.mma %lhs0, %rhs1, %acc01 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
  %result11 = vector.mma %lhs1, %rhs1, %acc11 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
  scf.schedule.fence
  %offset2 = index.constant 32 : index
  %row2 = index.add %lane_row, %offset2 : index
  %weight2 = vector.load %weight_view[%row2, %column] : view<96x72xbf16> -> vector<16xbf16>
  %rhs2 = vector.fragment<rhs> %weight2 shape [%tile, %tile] : vector<16xbf16>
  %offset3 = index.constant 48 : index
  %row3 = index.add %lane_row, %offset3 : index
  %weight3 = vector.load %weight_view[%row3, %column] : view<96x72xbf16> -> vector<16xbf16>
  %rhs3 = vector.fragment<rhs> %weight3 shape [%tile, %tile] : vector<16xbf16>
  %result02 = vector.mma %lhs0, %rhs2, %acc02 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
  %result12 = vector.mma %lhs1, %rhs2, %acc12 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
  %result03 = vector.mma %lhs0, %rhs3, %acc03 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
  %result13 = vector.mma %lhs1, %rhs3, %acc13 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
  scf.schedule.fence
  %offset4 = index.constant 64 : index
  %row4 = index.add %lane_row, %offset4 : index
  %weight4 = vector.load %weight_view[%row4, %column] : view<96x72xbf16> -> vector<16xbf16>
  %rhs4 = vector.fragment<rhs> %weight4 shape [%tile, %tile] : vector<16xbf16>
  %offset5 = index.constant 80 : index
  %row5 = index.add %lane_row, %offset5 : index
  %weight5 = vector.load %weight_view[%row5, %column] : view<96x72xbf16> -> vector<16xbf16>
  %rhs5 = vector.fragment<rhs> %weight5 shape [%tile, %tile] : vector<16xbf16>
  %result04 = vector.mma %lhs0, %rhs4, %acc04 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
  %result14 = vector.mma %lhs1, %rhs4, %acc14 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
  %result05 = vector.mma %lhs0, %rhs5, %acc05 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
  %result15 = vector.mma %lhs1, %rhs5, %acc15 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
  scf.schedule.fence
  template.return %result00, %result01, %result02, %result03, %result04, %result05, %result10, %result11, %result12, %result13, %result14, %result15 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
}

// M/N are multiples of sixteen: each result fragment is wholly valid or absent.
template.decl @projection.temporal_store(%rows: index, %outputs: index, %row: index, %column: index, %output: buffer, %result: vector<8xf32>)
template.def<@projection.temporal_store> device @temporal_store(%rows: index, %outputs: index, %row: index, %column: index, %output: buffer, %result: vector<8xf32>) {
  %origin = index.constant 0 : offset
  %tile = index.constant 16 : index
  %last_row = index.sub %rows, %tile : index
  %last_column = index.sub %outputs, %tile : index
  %row_valid = index.cmp ule, %row, %last_row : index
  scf.if %row_valid {
    %column_valid = index.cmp ule, %column, %last_column : index
    scf.if %column_valid {
      %view = buffer.view %output[%origin] : buffer -> view<[%rows]x[%outputs]xbf16>
      vector.fragment.store<result> %result, %view[%row, %column] shape [%tile, %tile] : vector<8xf32>, view<[%rows]x[%outputs]xbf16>
      scf.yield
    }
    scf.yield
  }
  template.return
}

// Consume one temporal tile at the supplied workgroup-uniform origins.
// The caller owns the shared 65,024-byte LDS allocation and supplies the same
// dimensions and nonoverlapping storage required by the public motif.
template.decl @projection.linear_temporal_at(%rows: index, %inputs: index, %outputs: index, %row_origin: index, %output_origin: index, %stage: buffer, %input: buffer, %weight: buffer, %output: buffer)
template.def<@projection.linear_temporal_at> device @linear_temporal_at(%rows: index, %inputs: index, %outputs: index, %row_origin: index, %output_origin: index, %stage: buffer, %input: buffer, %weight: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %three = index.constant 3 : index
  %four = index.constant 4 : index
  %six = index.constant 6 : index
  %eight = index.constant 8 : index
  %tile = index.constant 16 : index
  %sixty_four = index.constant 64 : index
  %ninety_six = index.constant 96 : index
  %row_tile = index.constant 128 : index
  %bank_stride = index.constant 32768 : offset
  %input_offset = index.constant 13824 : offset
  %stage_bytes = index.constant 65024 : offset
  %workitem = kernel.workitem.id<x> : index
  %subgroup = kernel.subgroup.id : index
  %wave_row = index.mul %subgroup, %tile : index
  %packet_row_base = index.div %workitem, %eight : index
  %packet_column = index.rem %workitem, %eight : index
  %stage_column = index.mul %packet_column, %eight : index
  %input_noalias, %weight_noalias = buffer.assume.noalias %input, %weight : buffer, buffer
  %first_weights = buffer.view %stage[%origin] : buffer -> view<96x72xbf16>
  %first_inputs = buffer.view %stage[%input_offset] : buffer -> view<128x72xbf16>

  // Publish K64 tile zero, then keep tile one in the explicit packet record.
  scf.for %round = [%zero to %six step %one] unroll schedule(linear) {
    %stage_row = index.madd %round, %tile, %packet_row_base : index
    %row = index.add %output_origin, %stage_row : index
    %values = template.apply<@projection.temporal_packet>(%outputs, %inputs, %row, %stage_column, %weight_noalias) : (index, index, index, index, buffer) -> (vector<8xbf16>)
    vector.store %values, %first_weights[%stage_row, %stage_column] : vector<8xbf16>, view<96x72xbf16>
  }
  scf.for %round = [%zero to %eight step %one] unroll schedule(linear) {
    %stage_row = index.madd %round, %tile, %packet_row_base : index
    %row = index.add %row_origin, %stage_row : index
    %values = template.apply<@projection.temporal_packet>(%rows, %inputs, %row, %stage_column, %input_noalias) : (index, index, index, index, buffer) -> (vector<8xbf16>)
    vector.store %values, %first_inputs[%stage_row, %stage_column] : vector<8xbf16>, view<128x72xbf16>
  }
  %queued_column = index.add %sixty_four, %stage_column : index
  %packet_offset0 = index.constant 0 : index
  %stage_row0 = index.add %packet_row_base, %packet_offset0 : index
  %packet_offset1 = index.constant 16 : index
  %stage_row1 = index.add %packet_row_base, %packet_offset1 : index
  %packet_offset2 = index.constant 32 : index
  %stage_row2 = index.add %packet_row_base, %packet_offset2 : index
  %packet_offset3 = index.constant 48 : index
  %stage_row3 = index.add %packet_row_base, %packet_offset3 : index
  %packet_offset4 = index.constant 64 : index
  %stage_row4 = index.add %packet_row_base, %packet_offset4 : index
  %packet_offset5 = index.constant 80 : index
  %stage_row5 = index.add %packet_row_base, %packet_offset5 : index
  %packet_offset6 = index.constant 96 : index
  %stage_row6 = index.add %packet_row_base, %packet_offset6 : index
  %packet_offset7 = index.constant 112 : index
  %stage_row7 = index.add %packet_row_base, %packet_offset7 : index
  %global_weight0_row = index.add %output_origin, %stage_row0 : index
  %initial_weight0 = template.apply<@projection.temporal_packet>(%outputs, %inputs, %global_weight0_row, %queued_column, %weight_noalias) : (index, index, index, index, buffer) -> (vector<8xbf16>)
  %global_weight1_row = index.add %output_origin, %stage_row1 : index
  %initial_weight1 = template.apply<@projection.temporal_packet>(%outputs, %inputs, %global_weight1_row, %queued_column, %weight_noalias) : (index, index, index, index, buffer) -> (vector<8xbf16>)
  %global_weight2_row = index.add %output_origin, %stage_row2 : index
  %initial_weight2 = template.apply<@projection.temporal_packet>(%outputs, %inputs, %global_weight2_row, %queued_column, %weight_noalias) : (index, index, index, index, buffer) -> (vector<8xbf16>)
  %global_weight3_row = index.add %output_origin, %stage_row3 : index
  %initial_weight3 = template.apply<@projection.temporal_packet>(%outputs, %inputs, %global_weight3_row, %queued_column, %weight_noalias) : (index, index, index, index, buffer) -> (vector<8xbf16>)
  %global_weight4_row = index.add %output_origin, %stage_row4 : index
  %initial_weight4 = template.apply<@projection.temporal_packet>(%outputs, %inputs, %global_weight4_row, %queued_column, %weight_noalias) : (index, index, index, index, buffer) -> (vector<8xbf16>)
  %global_weight5_row = index.add %output_origin, %stage_row5 : index
  %initial_weight5 = template.apply<@projection.temporal_packet>(%outputs, %inputs, %global_weight5_row, %queued_column, %weight_noalias) : (index, index, index, index, buffer) -> (vector<8xbf16>)
  %global_input0_row = index.add %row_origin, %stage_row0 : index
  %initial_input0 = template.apply<@projection.temporal_packet>(%rows, %inputs, %global_input0_row, %queued_column, %input_noalias) : (index, index, index, index, buffer) -> (vector<8xbf16>)
  %global_input1_row = index.add %row_origin, %stage_row1 : index
  %initial_input1 = template.apply<@projection.temporal_packet>(%rows, %inputs, %global_input1_row, %queued_column, %input_noalias) : (index, index, index, index, buffer) -> (vector<8xbf16>)
  %global_input2_row = index.add %row_origin, %stage_row2 : index
  %initial_input2 = template.apply<@projection.temporal_packet>(%rows, %inputs, %global_input2_row, %queued_column, %input_noalias) : (index, index, index, index, buffer) -> (vector<8xbf16>)
  %global_input3_row = index.add %row_origin, %stage_row3 : index
  %initial_input3 = template.apply<@projection.temporal_packet>(%rows, %inputs, %global_input3_row, %queued_column, %input_noalias) : (index, index, index, index, buffer) -> (vector<8xbf16>)
  %global_input4_row = index.add %row_origin, %stage_row4 : index
  %initial_input4 = template.apply<@projection.temporal_packet>(%rows, %inputs, %global_input4_row, %queued_column, %input_noalias) : (index, index, index, index, buffer) -> (vector<8xbf16>)
  %global_input5_row = index.add %row_origin, %stage_row5 : index
  %initial_input5 = template.apply<@projection.temporal_packet>(%rows, %inputs, %global_input5_row, %queued_column, %input_noalias) : (index, index, index, index, buffer) -> (vector<8xbf16>)
  %global_input6_row = index.add %row_origin, %stage_row6 : index
  %initial_input6 = template.apply<@projection.temporal_packet>(%rows, %inputs, %global_input6_row, %queued_column, %input_noalias) : (index, index, index, index, buffer) -> (vector<8xbf16>)
  %global_input7_row = index.add %row_origin, %stage_row7 : index
  %initial_input7 = template.apply<@projection.temporal_packet>(%rows, %inputs, %global_input7_row, %queued_column, %input_noalias) : (index, index, index, index, buffer) -> (vector<8xbf16>)
  %zeros = vector.constant 0.0 : vector<8xf32>
  %initial = vector.fragment<init> %zeros shape [%tile, %tile] : vector<8xf32>
  %last_column = index.sub %inputs, %sixty_four : index
  %steady_limit = index.sub %inputs, %row_tile : index

  // Each steady iteration publishes the next tile and acquires a valid tile
  // after it. The last queued tile is published separately without a refill.
  %steady00, %steady01, %steady02, %steady03, %steady04, %steady05, %steady10, %steady11, %steady12, %steady13, %steady14, %steady15, %final_weight0, %final_weight1, %final_weight2, %final_weight3, %final_weight4, %final_weight5, %final_input0, %final_input1, %final_input2, %final_input3, %final_input4, %final_input5, %final_input6, %final_input7 = scf.for %column = [%zero to %steady_limit step %sixty_four](%running00 = %initial : vector<8xf32>, %running01 = %initial : vector<8xf32>, %running02 = %initial : vector<8xf32>, %running03 = %initial : vector<8xf32>, %running04 = %initial : vector<8xf32>, %running05 = %initial : vector<8xf32>, %running10 = %initial : vector<8xf32>, %running11 = %initial : vector<8xf32>, %running12 = %initial : vector<8xf32>, %running13 = %initial : vector<8xf32>, %running14 = %initial : vector<8xf32>, %running15 = %initial : vector<8xf32>, %queued_weight0 = %initial_weight0 : vector<8xbf16>, %queued_weight1 = %initial_weight1 : vector<8xbf16>, %queued_weight2 = %initial_weight2 : vector<8xbf16>, %queued_weight3 = %initial_weight3 : vector<8xbf16>, %queued_weight4 = %initial_weight4 : vector<8xbf16>, %queued_weight5 = %initial_weight5 : vector<8xbf16>, %queued_input0 = %initial_input0 : vector<8xbf16>, %queued_input1 = %initial_input1 : vector<8xbf16>, %queued_input2 = %initial_input2 : vector<8xbf16>, %queued_input3 = %initial_input3 : vector<8xbf16>, %queued_input4 = %initial_input4 : vector<8xbf16>, %queued_input5 = %initial_input5 : vector<8xbf16>, %queued_input6 = %initial_input6 : vector<8xbf16>, %queued_input7 = %initial_input7 : vector<8xbf16>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xbf16>, vector<8xbf16>, vector<8xbf16>, vector<8xbf16>, vector<8xbf16>, vector<8xbf16>, vector<8xbf16>, vector<8xbf16>, vector<8xbf16>, vector<8xbf16>, vector<8xbf16>, vector<8xbf16>, vector<8xbf16>, vector<8xbf16>) {
    %ordinal = index.div %column, %sixty_four : index
    %parity = index.rem %ordinal, %two : index
    %read_bank = index.scale %parity, %bank_stride : index, offset -> offset
