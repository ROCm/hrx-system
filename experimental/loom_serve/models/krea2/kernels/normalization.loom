template.decl @normalization.row_inverse(%rows: index, %width: index, %threads: index, %row: index, %input: buffer, %epsilon: f32) -> (f32)
template.decl @normalization.zero_centered_bf16(%value: bf16, %weight: f32, %inverse: f32) -> (bf16)
template.decl @modulation.affine_bf16(%value: bf16, %scale: bf16, %scale_table: f32, %shift: bf16, %shift_table: f32) -> (bf16)

// One workgroup reduces one row. Input width is divisible by the supplied
// workgroup size; concrete wrappers establish shape and launch facts.
template.def<@normalization.row_inverse> device @normalization_row_inverse(%rows: index, %width: index, %threads: index, %row: index, %input: buffer, %epsilon: f32) -> (f32) {
  %origin = index.constant 0 : offset
  %lane = kernel.workitem.id<x> : index
  %zero = scalar.constant 0.0 : f32
  %input_view = buffer.view %input[%origin] : buffer -> view<[%rows]x[%width]xbf16>
  %partial = scf.for %column = [%lane to %width step %threads](%acc = %zero : f32) -> (f32) {
    %stored = view.load %input_view[%row, %column] : view<[%rows]x[%width]xbf16> -> bf16
    %value = scalar.extf %stored : bf16 to f32
    %square = scalar.mulf %value, %value : f32
    %sum = scalar.addf %acc, %square : f32
    scf.yield %sum : f32
  }
  %sum = kernel.workgroup.reduce<addf> %partial : f32
  %width_i32 = index.cast %width : index to i32
  %width_f32 = scalar.uitofp %width_i32 : i32 to f32
  %mean = scalar.divf %sum, %width_f32 : f32
  %variance = scalar.addf %mean, %epsilon : f32
  %inverse = scalar.rsqrtf<afn> %variance : f32
  template.return %inverse : f32
}

// Matches a BF16-loaded zero-centered scale with F32 RMS arithmetic. The
// scale-plus-one operation rounds to BF16 before its F32 multiplication.
template.def<@normalization.zero_centered_bf16> device @normalization_zero_centered_bf16(%value: bf16, %weight: f32, %inverse: f32) -> (bf16) {
  %weight_bf16 = scalar.fptrunc %weight : f32 to bf16
  %weight_f32 = scalar.extf %weight_bf16 : bf16 to f32
  %one = scalar.constant 1.0 : f32
  %scale_f32 = scalar.addf %weight_f32, %one : f32
  %scale_bf16 = scalar.fptrunc %scale_f32 : f32 to bf16
  %scale = scalar.extf %scale_bf16 : bf16 to f32
  %value_f32 = scalar.extf %value : bf16 to f32
  %normalized = scalar.mulf %value_f32, %inverse : f32
  %result_f32 = scalar.mulf %normalized, %scale : f32
  %result = scalar.fptrunc %result_f32 : f32 to bf16
  template.return %result : bf16
}

// Fuses pointwise modulation without removing tensor-rounding boundaries:
// tables are loaded as BF16, each addition and multiply produces BF16.
template.def<@modulation.affine_bf16> device @modulation_affine_bf16(%value: bf16, %scale: bf16, %scale_table: f32, %shift: bf16, %shift_table: f32) -> (bf16) {
  %scale_table_bf16 = scalar.fptrunc %scale_table : f32 to bf16
  %shift_table_bf16 = scalar.fptrunc %shift_table : f32 to bf16
  %scale_table_f32 = scalar.extf %scale_table_bf16 : bf16 to f32
  %shift_table_f32 = scalar.extf %shift_table_bf16 : bf16 to f32
  %scale_f32 = scalar.extf %scale : bf16 to f32
  %shift_f32 = scalar.extf %shift : bf16 to f32
  %scale_sum = scalar.addf %scale_f32, %scale_table_f32 : f32
  %shift_sum = scalar.addf %shift_f32, %shift_table_f32 : f32
  %scale_sum_bf16 = scalar.fptrunc %scale_sum : f32 to bf16
  %shift_sum_bf16 = scalar.fptrunc %shift_sum : f32 to bf16
  %scale_sum_f32 = scalar.extf %scale_sum_bf16 : bf16 to f32
  %shift_sum_f32 = scalar.extf %shift_sum_bf16 : bf16 to f32
  %one = scalar.constant 1.0 : f32
  %affine_scale = scalar.addf %scale_sum_f32, %one : f32
  %affine_scale_bf16 = scalar.fptrunc %affine_scale : f32 to bf16
  %affine_scale_f32 = scalar.extf %affine_scale_bf16 : bf16 to f32
  %value_f32 = scalar.extf %value : bf16 to f32
  %scaled = scalar.mulf %value_f32, %affine_scale_f32 : f32
  %scaled_bf16 = scalar.fptrunc %scaled : f32 to bf16
  %scaled_f32 = scalar.extf %scaled_bf16 : bf16 to f32
  %result_f32 = scalar.addf %scaled_f32, %shift_sum_f32 : f32
  %result = scalar.fptrunc %result_f32 : f32 to bf16
  template.return %result : bf16
}
