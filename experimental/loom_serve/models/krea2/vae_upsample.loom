  %planes = index.constant 3 : index
  %upsample = index.constant 1 : index
  %add_residual = scalar.constant true : i1
  template.apply<@image.convolution_3x3_matrix_f32>(%height, %width, %channels, %channels, %planes, %upsample, %add_residual, %input, %weight, %bias, %residual, %output) : (index, index, index, index, index, index, i1, buffer, buffer, buffer, buffer, buffer)
