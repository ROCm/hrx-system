  command.return
}

// Stage 1 expands 192 input channels in block zero. That block requires
// distinct input/output storage: the shortcut writes output concurrently with
// input normalization. Later 384-channel blocks can advance their skip in place.
command.program.def public @krea2.vae_up1_residual(%block: index) launch(%parameters: buffer, %input: buffer, %output: buffer) {
  %latent_height = config.get @krea2.latent_height : index
  %latent_width = config.get @krea2.latent_width : index
  %scale = index.constant 2 : index
  %height = index.mul %latent_height, %scale : index
  %width = index.mul %latent_width, %scale : index
  %pixels = index.mul %height, %width : index
  %pixel_bytes = index.constant 1536 : offset
  %bytes = index.scale %pixels, %pixel_bytes : index, offset -> offset
  %zero = index.constant 0 : index
  %expand = index.cmp eq, %block, %zero : index
  %normalization_bytes = scf.if %expand -> (offset) {
    %input_pixel_bytes = index.constant 768 : offset
    %half = index.scale %pixels, %input_pixel_bytes : index, offset -> offset
    scf.yield %half : offset
  } else {
    scf.yield %bytes : offset
  }
  %normalized = buffer.alloca<global> align(256) %normalization_bytes : buffer
  %convolved = scf.if %expand -> (buffer) {
    %norm = command.parameter %parameters, "decoder.up_blocks.1.resnets.0.norm1.gamma" : view<192x1x1x1xf32>
    %skip_weight = command.parameter %parameters, "decoder.up_blocks.1.resnets.0.conv_shortcut.weight" : view<384x192x1x1x1xf32>
    %skip_bias = command.parameter %parameters, "decoder.up_blocks.1.resnets.0.conv_shortcut.bias" : view<384xf32>
    command.concurrent {
      kernel.launch @krea_vae_expand_norm(%input, %norm, %normalized) : (buffer, view<192x1x1x1xf32>, buffer)
      kernel.launch @krea_vae_expand_shortcut(%input, %skip_weight, %skip_bias, %output) : (buffer, view<384x192x1x1x1xf32>, view<384xf32>, buffer)
    }
    %weight = command.parameter %parameters, "decoder.up_blocks.1.resnets.0.conv1.weight" : view<384x192x3x3x3xf32>
    %bias = command.parameter %parameters, "decoder.up_blocks.1.resnets.0.conv1.bias" : view<384xf32>
    %result = buffer.alloca<global> align(256) %bytes : buffer
    kernel.launch @krea_vae_expand_convolution(%normalized, %weight, %bias, %result) : (buffer, view<384x192x3x3x3xf32>, view<384xf32>, buffer)
    scf.yield %result : buffer
  } else {
    %norm = command.parameter %parameters, "decoder.up_blocks.1.resnets.{}.norm1.gamma"[%block] : view<384x1x1x1xf32>
    %weight = command.parameter %parameters, "decoder.up_blocks.1.resnets.{}.conv1.weight"[%block] : view<384x384x3x3x3xf32>
    %bias = command.parameter %parameters, "decoder.up_blocks.1.resnets.{}.conv1.bias"[%block] : view<384xf32>
    kernel.launch @krea_vae_up1_norm(%input, %norm, %normalized) : (buffer, view<384x1x1x1xf32>, buffer)
    %result = buffer.alloca<global> align(256) %bytes : buffer
    kernel.launch @krea_vae_up1_convolution(%normalized, %weight, %bias, %result) : (buffer, view<384x384x3x3x3xf32>, view<384xf32>, buffer)
    scf.yield %result : buffer
  }
  %skip = scf.if %expand -> (buffer) {
    scf.yield %output : buffer
  } else {
    scf.yield %input : buffer
  }
  %norm2 = command.parameter %parameters, "decoder.up_blocks.1.resnets.{}.norm2.gamma"[%block] : view<384x1x1x1xf32>
  %weight2 = command.parameter %parameters, "decoder.up_blocks.1.resnets.{}.conv2.weight"[%block] : view<384x384x3x3x3xf32>
  %bias2 = command.parameter %parameters, "decoder.up_blocks.1.resnets.{}.conv2.bias"[%block] : view<384xf32>
  kernel.launch @krea_vae_up1_norm(%convolved, %norm2, %convolved) : (buffer, view<384x1x1x1xf32>, buffer)
  kernel.launch @krea_vae_up1_convolution_add(%convolved, %weight2, %bias2, %skip, %output) : (buffer, view<384x384x3x3x3xf32>, view<384xf32>, buffer, buffer)
  command.return
}

command.program.def public @krea2.vae_up1_resize() launch(%parameters: buffer, %input: buffer, %output: buffer) {
  %weight = command.parameter %parameters, "decoder.up_blocks.1.upsamplers.0.resample.1.weight" : view<192x384x3x3xf32>
  %bias = command.parameter %parameters, "decoder.up_blocks.1.upsamplers.0.resample.1.bias" : view<192xf32>
  kernel.launch @krea_vae_up1_resize(%input, %weight, %bias, %output) : (buffer, view<192x384x3x3xf32>, view<192xf32>, buffer)
  command.return
}

