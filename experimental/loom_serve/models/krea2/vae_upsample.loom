// Stage 0 keeps 384 output channels. The final convolution can update
// its skip storage in place after both normalizations have consumed the input.
command.program.def public @krea2.vae_up0_residual(%block: index) launch(%parameters: buffer, %input: buffer, %output: buffer) {
  %latent_height = config.get @krea2.latent_height : index
  %latent_width = config.get @krea2.latent_width : index
  %scale = index.constant 1 : index
  %height = index.mul %latent_height, %scale : index
  %width = index.mul %latent_width, %scale : index
  %pixels = index.mul %height, %width : index
  %pixel_bytes = index.constant 1536 : offset
  %bytes = index.scale %pixels, %pixel_bytes : index, offset -> offset
  %normalized = buffer.alloca<global> align(256) %bytes : buffer
  %norm1 = command.parameter %parameters, "decoder.up_blocks.0.resnets.{}.norm1.gamma"[%block] : view<384x1x1x1xf32>
  %weight1 = command.parameter %parameters, "decoder.up_blocks.0.resnets.{}.conv1.weight"[%block] : view<384x384x3x3x3xf32>
  %bias1 = command.parameter %parameters, "decoder.up_blocks.0.resnets.{}.conv1.bias"[%block] : view<384xf32>
  kernel.launch @krea_vae_up0_norm(%input, %norm1, %normalized) : (buffer, view<384x1x1x1xf32>, buffer)
  %convolved = buffer.alloca<global> align(256) %bytes : buffer
  kernel.launch @krea_vae_up0_convolution(%normalized, %weight1, %bias1, %convolved) : (buffer, view<384x384x3x3x3xf32>, view<384xf32>, buffer)
  %norm2 = command.parameter %parameters, "decoder.up_blocks.0.resnets.{}.norm2.gamma"[%block] : view<384x1x1x1xf32>
  %weight2 = command.parameter %parameters, "decoder.up_blocks.0.resnets.{}.conv2.weight"[%block] : view<384x384x3x3x3xf32>
  %bias2 = command.parameter %parameters, "decoder.up_blocks.0.resnets.{}.conv2.bias"[%block] : view<384xf32>
  kernel.launch @krea_vae_up0_norm(%convolved, %norm2, %convolved) : (buffer, view<384x1x1x1xf32>, buffer)
  kernel.launch @krea_vae_up0_convolution_add(%convolved, %weight2, %bias2, %input, %output) : (buffer, view<384x384x3x3x3xf32>, view<384xf32>, buffer, buffer)
  command.return
}

command.program.def public @krea2.vae_up0_resize() launch(%parameters: buffer, %input: buffer, %output: buffer) {
  %weight = command.parameter %parameters, "decoder.up_blocks.0.upsamplers.0.resample.1.weight" : view<192x384x3x3xf32>
  %bias = command.parameter %parameters, "decoder.up_blocks.0.upsamplers.0.resample.1.bias" : view<192xf32>
