config.decl @krea2.block_tokens : %value: index where [range(%value, 16, 65536), mul(%value, 16)]

amdgpu.target<gfx11-generic> @block_projection_wave32 {subgroup_size = 32}
template.decl @projection.linear_tiled_bf16(%rows: index, %inputs: index, %outputs: index, %row_tile_group_size: index, %output_layout: encoding<layout>, %input: buffer, %weight: buffer, %output: buffer)
template.decl @projection.linear_tiled_full_k_bf16(%rows: index, %inputs: index, %outputs: index, %row_tile_group_size: index, %output_layout: encoding<layout>, %input: buffer, %weight: buffer, %output: buffer)
template.decl @projection.linear_tiled_wide_bf16(%rows: index, %inputs: index, %outputs: index, %group_size: index, %input: buffer, %weight: buffer, %output: buffer)
template.decl @projection.linear_temporal_bf16(%rows: index, %inputs: index, %outputs: index, %group_size: index, %input: buffer, %weight: buffer, %output: buffer)
template.decl @krea2.projection_row_group_size(%rows: index, %minimum_grouped_rows: index) -> (index)

// Traversal selection belongs to the model's concrete contraction shapes.
// Whole-height traversal retains input reuse at small row counts; bounded
// groups reduce the revisited input panel for larger contractions. Both the
// selection and its coordinate arithmetic specialize before device execution.
template.def<@krea2.projection_row_group_size> device @block_projection_row_group_size(%rows: index, %minimum_grouped_rows: index) -> (index) {
  %use_grouped = index.cmp uge, %rows, %minimum_grouped_rows : index
  %group_size = scf.if %use_grouped -> (index) {
    %group = index.constant 8 : index
    scf.yield %group : index
  } else {
    %rounding = index.constant 63 : index
    %tile = index.constant 64 : index
    %padded_rows = index.add %rows, %rounding : index
    %row_tiles = index.div %padded_rows, %tile : index
    scf.yield %row_tiles : index
  }
  template.return %group_size : index
}

kernel.def target(@block_projection_wave32) @block_linear_6144_6144() {
  %rows = config.get @krea2.block_tokens : index
  %tile = index.constant 64 : index
  %rounding = index.constant 63 : index
  %padded_rows = index.add %rows, %rounding : index
  %row_tiles = index.div %padded_rows, %tile : index
  %short_text_rows = index.constant 4224 : index
  %wide = index.cmp eq, %rows, %short_text_rows : index
  %wide_output_tiles = index.constant 48 : index
  %square_output_tiles = index.constant 96 : index
  %output_tiles = scf.select %wide, %wide_output_tiles, %square_output_tiles : index
  %one = index.constant 1 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%row_tiles, %output_tiles, %one) workgroup_size(%threads, %one, %one) : index
} launch(%input: buffer, %weight: buffer, %output: buffer) {
  %rows = config.get @krea2.block_tokens : index
  %width = index.constant 6144 : index
  %minimum_grouped_rows = index.constant 2560 : index
  %group_size = template.apply<@krea2.projection_row_group_size>(%rows, %minimum_grouped_rows) : (index, index) -> (index)
  %output_layout = encoding.layout.dense : encoding<layout>
  %short_text_rows = index.constant 4224 : index
  %wide = index.cmp eq, %rows, %short_text_rows : index
  scf.if %wide {
    template.apply<@projection.linear_tiled_wide_bf16>(%rows, %width, %width, %group_size, %input, %weight, %output) : (index, index, index, index, buffer, buffer, buffer)
    scf.yield
  } else {
    template.apply<@projection.linear_tiled_bf16>(%rows, %width, %width, %group_size, %output_layout, %input, %weight, %output) : (index, index, index, index, encoding<layout>, buffer, buffer, buffer)
    scf.yield
  }
  kernel.return
}

kernel.def target(@block_projection_wave32) @block_linear_6144_1536() {
  %rows = config.get @krea2.block_tokens : index
  %tile = index.constant 64 : index
  %rounding = index.constant 63 : index
  %padded_rows = index.add %rows, %rounding : index
  %row_tiles = index.div %padded_rows, %tile : index
  %output_tiles = index.constant 24 : index
  %one = index.constant 1 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%row_tiles, %output_tiles, %one) workgroup_size(%threads, %one, %one) : index
} launch(%input: buffer, %weight: buffer, %output: buffer) {
  %rows = config.get @krea2.block_tokens : index
  %inputs = index.constant 6144 : index
  %outputs = index.constant 1536 : index
  %minimum_grouped_rows = index.constant 2560 : index
  %group_size = template.apply<@krea2.projection_row_group_size>(%rows, %minimum_grouped_rows) : (index, index) -> (index)
  %output_layout = encoding.layout.dense : encoding<layout>
  template.apply<@projection.linear_tiled_bf16>(%rows, %inputs, %outputs, %group_size, %output_layout, %input, %weight, %output) : (index, index, index, index, encoding<layout>, buffer, buffer, buffer)
  kernel.return
}

// V publishes the same logical result in the consumer's channel-major layout.
kernel.def target(@block_projection_wave32) @block_linear_6144_1536_column_major() {
  %rows = config.get @krea2.block_tokens : index
  %tile = index.constant 64 : index
  %rounding = index.constant 63 : index
  %padded_rows = index.add %rows, %rounding : index
  %row_tiles = index.div %padded_rows, %tile : index
  %output_tiles = index.constant 24 : index
  %one = index.constant 1 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%row_tiles, %output_tiles, %one) workgroup_size(%threads, %one, %one) : index
} launch(%input: buffer, %weight: buffer, %output: buffer) {
  %rows = config.get @krea2.block_tokens : index
  %inputs = index.constant 6144 : index
  %outputs = index.constant 1536 : index
  %minimum_grouped_rows = index.constant 2560 : index
  %group_size = template.apply<@krea2.projection_row_group_size>(%rows, %minimum_grouped_rows) : (index, index) -> (index)
  %output_layout = encoding.layout.strided [1, %rows] : encoding<layout>
  template.apply<@projection.linear_tiled_bf16>(%rows, %inputs, %outputs, %group_size, %output_layout, %input, %weight, %output) : (index, index, index, index, encoding<layout>, buffer, buffer, buffer)
  kernel.return
}

kernel.def target(@block_projection_wave32) @block_linear_6144_16384() {
  %rows = config.get @krea2.block_tokens : index
  %tile = index.constant 64 : index
  %rounding = index.constant 63 : index
  %padded_rows = index.add %rows, %rounding : index
  %row_tiles = index.div %padded_rows, %tile : index
  %short_text_rows = index.constant 4224 : index
  %wide = index.cmp eq, %rows, %short_text_rows : index
  %wide_output_tiles = index.constant 128 : index
  %square_output_tiles = index.constant 256 : index
  %output_tiles = scf.select %wide, %wide_output_tiles, %square_output_tiles : index
  %one = index.constant 1 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%row_tiles, %output_tiles, %one) workgroup_size(%threads, %one, %one) : index
} launch(%input: buffer, %weight: buffer, %output: buffer) {
  %rows = config.get @krea2.block_tokens : index
  %inputs = index.constant 6144 : index
  %outputs = index.constant 16384 : index
  %minimum_grouped_rows = index.constant 2048 : index
  %group_size = template.apply<@krea2.projection_row_group_size>(%rows, %minimum_grouped_rows) : (index, index) -> (index)
  %output_layout = encoding.layout.dense : encoding<layout>
  // The short-text shape shares each input panel across twice as many output
  // columns. Both image shapes retain full-K accumulation; other sequence
  // lengths retain the chunked strategy.
  %image_short_text = index.constant 4224 : index
  %image_full_text = index.constant 4608 : index
  %short_text = index.cmp eq, %rows, %image_short_text : index
  %full_text = index.cmp eq, %rows, %image_full_text : index
  scf.if %short_text {
    template.apply<@projection.linear_tiled_wide_bf16>(%rows, %inputs, %outputs, %group_size, %input, %weight, %output) : (index, index, index, index, buffer, buffer, buffer)
    scf.yield
  } else {
    scf.if %full_text {
      template.apply<@projection.linear_tiled_full_k_bf16>(%rows, %inputs, %outputs, %group_size, %output_layout, %input, %weight, %output) : (index, index, index, index, encoding<layout>, buffer, buffer, buffer)
      scf.yield
    } else {
      template.apply<@projection.linear_tiled_bf16>(%rows, %inputs, %outputs, %group_size, %output_layout, %input, %weight, %output) : (index, index, index, index, encoding<layout>, buffer, buffer, buffer)
      scf.yield
    }
    scf.yield
  }
  kernel.return
}

kernel.def target(@block_projection_wave32) @block_linear_16384_6144() {
  %rows = config.get @krea2.block_tokens : index
  %image_short_text = index.constant 4224 : index
  %image_full_text = index.constant 4608 : index
  %short_text = index.cmp eq, %rows, %image_short_text : index
  %full_text = index.cmp eq, %rows, %image_full_text : index
  %temporal = scalar.ori %short_text, %full_text : i1
  %temporal_row_tile = index.constant 128 : index
  %baseline_row_tile = index.constant 64 : index
  %tile = scf.select %temporal, %temporal_row_tile, %baseline_row_tile : index
  %one = index.constant 1 : index
  %rounding = index.sub %tile, %one : index
  %padded_rows = index.add %rows, %rounding : index
  %row_tiles = index.div %padded_rows, %tile : index
  %temporal_output_tiles = index.constant 64 : index
  %baseline_output_tiles = index.constant 96 : index
  %output_tiles = scf.select %temporal, %temporal_output_tiles, %baseline_output_tiles : index
  %temporal_threads = index.constant 128 : index
  %baseline_threads = index.constant 256 : index
  %threads = scf.select %temporal, %temporal_threads, %baseline_threads : index
  kernel.launch.config workgroups(%row_tiles, %output_tiles, %one) workgroup_size(%threads, %one, %one) : index
} launch(%input: buffer, %weight: buffer, %output: buffer) {
  %rows = config.get @krea2.block_tokens : index
  %inputs = index.constant 16384 : index
  %outputs = index.constant 6144 : index
  %image_short_text = index.constant 4224 : index
  %image_full_text = index.constant 4608 : index
  %short_text = index.cmp eq, %rows, %image_short_text : index
  %full_text = index.cmp eq, %rows, %image_full_text : index
  %temporal = scalar.ori %short_text, %full_text : i1
  scf.if %temporal {
    %group_size = index.constant 4 : index
    template.apply<@projection.linear_temporal_bf16>(%rows, %inputs, %outputs, %group_size, %input, %weight, %output) : (index, index, index, index, buffer, buffer, buffer)
    scf.yield
  } else {
    %minimum_grouped_rows = index.constant 1088 : index
    %group_size = template.apply<@krea2.projection_row_group_size>(%rows, %minimum_grouped_rows) : (index, index) -> (index)
    %output_layout = encoding.layout.dense : encoding<layout>
    template.apply<@projection.linear_tiled_bf16>(%rows, %inputs, %outputs, %group_size, %output_layout, %input, %weight, %output) : (index, index, index, index, encoding<layout>, buffer, buffer, buffer)
    scf.yield
  }
  kernel.return
}

command.program.def public @krea2.block_query(%layer: index) launch(%parameters: buffer, %input: buffer, %output: buffer) {
  %rows = config.get @krea2.block_tokens : index
  %origin = index.constant 0 : offset
  %input_view = buffer.view %input[%origin] : buffer -> view<[%rows]x6144xbf16>
  %output_view = buffer.view %output[%origin] : buffer -> view<[%rows]x6144xbf16>
  %weight = command.parameter %parameters, "blocks.{}.attn.wq.weight"[%layer] : view<6144x6144xbf16>
  kernel.launch @block_linear_6144_6144(%input_view, %weight, %output_view) : (view<[%rows]x6144xbf16>, view<6144x6144xbf16>, view<[%rows]x6144xbf16>)
  command.return
}

