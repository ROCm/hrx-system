  %input_view = buffer.view %input[%origin] : buffer -> view<[%rows]x6144xbf16>
  %output_view = buffer.view %output[%origin] : buffer -> view<1536x[%rows]xbf16>
  %weight = command.parameter %parameters, "blocks.{}.attn.wv.weight"[%layer] : view<1536x6144xbf16>
  kernel.launch @block_linear_6144_1536_column_major(%input_view, %weight, %output_view) : (view<[%rows]x6144xbf16>, view<1536x6144xbf16>, view<1536x[%rows]xbf16>)
  command.return
}

