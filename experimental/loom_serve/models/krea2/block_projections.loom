config.decl @krea2.block_tokens : %value: index where [range(%value, 16, 65536), mul(%value, 16)]

amdgpu.target<gfx11-generic> @block_projection_wave32 {subgroup_size = 32}
template.decl @projection.linear_bf16(%rows: index, %inputs: index, %outputs: index, %input: buffer, %weight: buffer) -> (vector<8xf32>)
template.decl @projection.store_bf16(%rows: index, %outputs: index, %result: vector<8xf32>, %output: buffer)

kernel.def target(@block_projection_wave32) @block_linear_6144_6144() {
  %rows = config.get @krea2.block_tokens : index
  %tile = index.constant 16 : index
  %row_tiles = index.div %rows, %tile : index
  %output_tiles = index.constant 384 : index
  %one = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%row_tiles, %output_tiles, %one) workgroup_size(%threads, %one, %one) : index
} launch(%input: buffer, %weight: buffer, %output: buffer) {
  %rows = config.get @krea2.block_tokens : index
  %width = index.constant 6144 : index
  %result = template.apply<@projection.linear_bf16>(%rows, %width, %width, %input, %weight) : (index, index, index, buffer, buffer) -> (vector<8xf32>)
  template.apply<@projection.store_bf16>(%rows, %width, %result, %output) : (index, index, vector<8xf32>, buffer)
  kernel.return
}

kernel.def target(@block_projection_wave32) @block_linear_6144_1536() {
  %rows = config.get @krea2.block_tokens : index
  %tile = index.constant 16 : index
  %row_tiles = index.div %rows, %tile : index
  %output_tiles = index.constant 96 : index
  %one = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%row_tiles, %output_tiles, %one) workgroup_size(%threads, %one, %one) : index
} launch(%input: buffer, %weight: buffer, %output: buffer) {
  %rows = config.get @krea2.block_tokens : index
  %inputs = index.constant 6144 : index
  %outputs = index.constant 1536 : index
  %result = template.apply<@projection.linear_bf16>(%rows, %inputs, %outputs, %input, %weight) : (index, index, index, buffer, buffer) -> (vector<8xf32>)
  template.apply<@projection.store_bf16>(%rows, %outputs, %result, %output) : (index, index, vector<8xf32>, buffer)
  kernel.return
}

