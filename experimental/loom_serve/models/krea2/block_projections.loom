  %weight = command.parameter %parameters, "blocks.{}.attn.wk.weight"[%layer] : view<1536x6144xbf16>
  kernel.launch @block_linear_6144_1536(%input_view, %weight, %output_view) : (view<[%rows]x6144xbf16>, view<1536x6144xbf16>, view<[%rows]x1536xbf16>)
  command.return
}

command.program.def public @krea2.block_value(%layer: index) launch(%parameters: buffer, %input: buffer, %output: buffer) {
  %rows = config.get @krea2.block_tokens : index
