config.decl @krea2.image_tokens : %value: index where [range(%value, 16, 65536), mul(%value, 16)]

amdgpu.target<gfx11-generic> @projection_wave32 {subgroup_size = 32}
template.decl @projection.linear_f32_as_bf16(%rows: index, %inputs: index, %outputs: index, %input: buffer, %weight: buffer) -> (vector<8xf32>)
template.decl @projection.store_bf16(%rows: index, %outputs: index, %result: vector<8xf32>, %output: buffer)
template.decl @projection.bias_f32_as_bf16(%outputs: index, %result: vector<8xf32>, %bias: buffer) -> (vector<8xf32>)
template.decl @projection.adapter_add_bf16(%elements: index, %delta: buffer, %strength: buffer, %output: buffer)

// Each wrapper fixes shape facts before applying the reusable arithmetic.
// No shape scalars remain in the device launch ABI.
kernel.def target(@projection_wave32) @krea_image_projection() {
  %rows = config.get @krea2.image_tokens : index
  %tile = index.constant 16 : index
  %row_tiles = index.div %rows, %tile : index
  %output_tiles = index.constant 384 : index
  %one = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%row_tiles, %output_tiles, %one) workgroup_size(%threads, %one, %one) : index
} launch(%input: buffer, %weight: buffer, %bias: buffer, %output: buffer) {
  %rows = config.get @krea2.image_tokens : index
  %inputs = index.constant 64 : index
  %outputs = index.constant 6144 : index
  %result = template.apply<@projection.linear_f32_as_bf16>(%rows, %inputs, %outputs, %input, %weight) : (index, index, index, buffer, buffer) -> (vector<8xf32>)
  %biased = template.apply<@projection.bias_f32_as_bf16>(%outputs, %result, %bias) : (index, vector<8xf32>, buffer) -> (vector<8xf32>)
  template.apply<@projection.store_bf16>(%rows, %outputs, %biased, %output) : (index, index, vector<8xf32>, buffer)
  kernel.return
}

kernel.def target(@projection_wave32) @krea_image_adapter_down() {
  %rows = config.get @krea2.image_tokens : index
  %tile = index.constant 16 : index
  %row_tiles = index.div %rows, %tile : index
  %output_tiles = index.constant 2 : index
  %one = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%row_tiles, %output_tiles, %one) workgroup_size(%threads, %one, %one) : index
} launch(%input: buffer, %weight: buffer, %output: buffer) {
  %rows = config.get @krea2.image_tokens : index
  %inputs = index.constant 64 : index
  %outputs = index.constant 32 : index
  %result = template.apply<@projection.linear_f32_as_bf16>(%rows, %inputs, %outputs, %input, %weight) : (index, index, index, buffer, buffer) -> (vector<8xf32>)
  template.apply<@projection.store_bf16>(%rows, %outputs, %result, %output) : (index, index, vector<8xf32>, buffer)
  kernel.return
}

kernel.def target(@projection_wave32) @krea_image_adapter_up() {
  %rows = config.get @krea2.image_tokens : index
  %tile = index.constant 16 : index
  %row_tiles = index.div %rows, %tile : index
  %output_tiles = index.constant 384 : index
  %one = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%row_tiles, %output_tiles, %one) workgroup_size(%threads, %one, %one) : index
} launch(%input: buffer, %weight: buffer, %output: buffer) {
  %rows = config.get @krea2.image_tokens : index
  %inputs = index.constant 32 : index
  %outputs = index.constant 6144 : index
  %result = template.apply<@projection.linear_f32_as_bf16>(%rows, %inputs, %outputs, %input, %weight) : (index, index, index, buffer, buffer) -> (vector<8xf32>)
  template.apply<@projection.store_bf16>(%rows, %outputs, %result, %output) : (index, index, vector<8xf32>, buffer)
  kernel.return
}

kernel.def target(@projection_wave32) @krea_image_adapter_add() {
  %rows = config.get @krea2.image_tokens : index
  %row_groups = index.constant 24 : index
  %groups = index.mul %rows, %row_groups : index
  %one = index.constant 1 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%groups, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%delta: buffer, %strength: buffer, %output: buffer) {
  %rows = config.get @krea2.image_tokens : index
  %outputs = index.constant 6144 : index
  %elements = index.mul %rows, %outputs : index
  template.apply<@projection.adapter_add_bf16>(%elements, %delta, %strength, %output) : (index, buffer, buffer, buffer)
  kernel.return
}

// Original Krea checkpoint namespace. The immutable base is independent of
// the adapter command's checkpoint namespace and runtime strength.
command.program.def public @image_projection() launch(%parameters: buffer, %input: buffer, %output: buffer) {
  %weight = command.parameter %parameters, "first.weight" : view<6144x64xf32>
  %bias = command.parameter %parameters, "first.bias" : view<6144xf32>
  kernel.launch @krea_image_projection(%input, %weight, %bias, %output) : (buffer, view<6144x64xf32>, view<6144xf32>, buffer)
  command.return
}

// This concrete official adapter has rank 32 and alpha/rank=1. Its factors
// stay separate from base weights; no merge or per-strength model copy occurs.
command.program.def public @image_projection_adapter() launch(%parameters: buffer, %input: buffer, %strength: buffer, %output: buffer) {
  %rows = config.get @krea2.image_tokens : index
  %low_row_bytes = index.constant 64 : offset
  %output_row_bytes = index.constant 12288 : offset
  %low_bytes = index.scale %rows, %low_row_bytes : index, offset -> offset
  %output_bytes = index.scale %rows, %output_row_bytes : index, offset -> offset
  %low_rank = buffer.alloca<global> align(256) %low_bytes : buffer
  %delta = buffer.alloca<global> align(256) %output_bytes : buffer
  %down = command.parameter %parameters, "transformer.img_in.lora_A.weight" : view<32x64xf32>
  %up = command.parameter %parameters, "transformer.img_in.lora_B.weight" : view<6144x32xf32>
  kernel.launch @krea_image_adapter_down(%input, %down, %low_rank) : (buffer, view<32x64xf32>, buffer)
  kernel.launch @krea_image_adapter_up(%low_rank, %up, %delta) : (buffer, view<6144x32xf32>, buffer)
  kernel.launch @krea_image_adapter_add(%delta, %strength, %output) : (buffer, buffer, buffer)
  command.return
}
