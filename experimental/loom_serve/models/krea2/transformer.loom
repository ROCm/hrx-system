config.decl @krea2.block_tokens : %value: index where [range(%value, 16, 65536), mul(%value, 16)]

command.program.decl @block0_attention_input() launch(%parameters: buffer, %input: buffer, %modulation: buffer, %output: buffer)
command.program.decl @block0_query() launch(%parameters: buffer, %input: buffer, %output: buffer)
command.program.decl @block0_key() launch(%parameters: buffer, %input: buffer, %output: buffer)
command.program.decl @block0_value() launch(%parameters: buffer, %input: buffer, %output: buffer)
command.program.decl @block0_gate() launch(%parameters: buffer, %input: buffer, %output: buffer)
command.program.decl @block0_query_rotary() launch(%parameters: buffer, %input: buffer, %cosine: buffer, %sine: buffer, %output: buffer)
command.program.decl @block0_key_rotary() launch(%parameters: buffer, %input: buffer, %cosine: buffer, %sine: buffer, %output: buffer)
command.program.decl @block0_attention_context() launch(%query: buffer, %key: buffer, %value: buffer, %mask: buffer, %gate: buffer, %output: buffer)
command.program.decl @block0_attention_output() launch(%parameters: buffer, %input: buffer, %output: buffer)
command.program.decl @block0_attention_residual() launch(%parameters: buffer, %residual: buffer, %update: buffer, %modulation: buffer, %output: buffer)
command.program.decl @block0_feed_forward_input() launch(%parameters: buffer, %input: buffer, %modulation: buffer, %output: buffer)
command.program.decl @block0_feed_forward_gate() launch(%parameters: buffer, %input: buffer, %output: buffer)
command.program.decl @block0_feed_forward_up() launch(%parameters: buffer, %input: buffer, %output: buffer)
command.program.decl @block0_feed_forward_product() launch(%gate: buffer, %up: buffer, %output: buffer)
command.program.decl @block0_feed_forward_down() launch(%parameters: buffer, %input: buffer, %output: buffer)
command.program.decl @block0_feed_forward_residual() launch(%parameters: buffer, %residual: buffer, %update: buffer, %modulation: buffer, %output: buffer)

// The caller supplies shared time modulation, rotary coordinates and key mask.
// All intermediate storage is reflected as one reusable slab. Independent
// projection branches may overlap; command dependencies order their consumers.
command.program.def public @block0_forward() launch(%parameters: buffer, %input: buffer, %modulation: buffer, %cosine: buffer, %sine: buffer, %mask: buffer, %output: buffer) {
  %tokens = config.get @krea2.block_tokens : index
  %hidden_stride = index.constant 12288 : offset
  %key_value_stride = index.constant 3072 : offset
  %feed_forward_stride = index.constant 32768 : offset
  %hidden_bytes = index.scale %tokens, %hidden_stride : index, offset -> offset
  %key_value_bytes = index.scale %tokens, %key_value_stride : index, offset -> offset
  %feed_forward_bytes = index.scale %tokens, %feed_forward_stride : index, offset -> offset

  %attention_input = buffer.alloca<global> align(256) %hidden_bytes : buffer
  command.program.launch @block0_attention_input(%parameters, %input, %modulation, %attention_input) : (buffer, buffer, buffer, buffer)
  %query = buffer.alloca<global> align(256) %hidden_bytes : buffer
  %key = buffer.alloca<global> align(256) %key_value_bytes : buffer
  %value = buffer.alloca<global> align(256) %key_value_bytes : buffer
  %gate = buffer.alloca<global> align(256) %hidden_bytes : buffer
  command.concurrent {
    command.program.launch @block0_query(%parameters, %attention_input, %query) : (buffer, buffer, buffer)
    command.program.launch @block0_key(%parameters, %attention_input, %key) : (buffer, buffer, buffer)
    command.program.launch @block0_value(%parameters, %attention_input, %value) : (buffer, buffer, buffer)
    command.program.launch @block0_gate(%parameters, %attention_input, %gate) : (buffer, buffer, buffer)
  }
  %rotated_query = buffer.alloca<global> align(256) %hidden_bytes : buffer
  %rotated_key = buffer.alloca<global> align(256) %key_value_bytes : buffer
  command.concurrent {
    command.program.launch @block0_query_rotary(%parameters, %query, %cosine, %sine, %rotated_query) : (buffer, buffer, buffer, buffer, buffer)
    command.program.launch @block0_key_rotary(%parameters, %key, %cosine, %sine, %rotated_key) : (buffer, buffer, buffer, buffer, buffer)
  }
  %context = buffer.alloca<global> align(256) %hidden_bytes : buffer
  command.program.launch @block0_attention_context(%rotated_query, %rotated_key, %value, %mask, %gate, %context) : (buffer, buffer, buffer, buffer, buffer, buffer)
  %attention_output = buffer.alloca<global> align(256) %hidden_bytes : buffer
  command.program.launch @block0_attention_output(%parameters, %context, %attention_output) : (buffer, buffer, buffer)
  %residual = buffer.alloca<global> align(256) %hidden_bytes : buffer
  command.program.launch @block0_attention_residual(%parameters, %input, %attention_output, %modulation, %residual) : (buffer, buffer, buffer, buffer, buffer)

  %feed_forward_input = buffer.alloca<global> align(256) %hidden_bytes : buffer
  command.program.launch @block0_feed_forward_input(%parameters, %residual, %modulation, %feed_forward_input) : (buffer, buffer, buffer, buffer)
  %feed_forward_gate = buffer.alloca<global> align(256) %feed_forward_bytes : buffer
  %feed_forward_up = buffer.alloca<global> align(256) %feed_forward_bytes : buffer
  command.concurrent {
    command.program.launch @block0_feed_forward_gate(%parameters, %feed_forward_input, %feed_forward_gate) : (buffer, buffer, buffer)
    command.program.launch @block0_feed_forward_up(%parameters, %feed_forward_input, %feed_forward_up) : (buffer, buffer, buffer)
  }
  %product = buffer.alloca<global> align(256) %feed_forward_bytes : buffer
  command.program.launch @block0_feed_forward_product(%feed_forward_gate, %feed_forward_up, %product) : (buffer, buffer, buffer)
  %feed_forward_output = buffer.alloca<global> align(256) %hidden_bytes : buffer
  command.program.launch @block0_feed_forward_down(%parameters, %product, %feed_forward_output) : (buffer, buffer, buffer)
  command.program.launch @block0_feed_forward_residual(%parameters, %residual, %feed_forward_output, %modulation, %output) : (buffer, buffer, buffer, buffer, buffer)
  command.return
}
