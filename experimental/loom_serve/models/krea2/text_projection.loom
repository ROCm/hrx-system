  %rows = config.get @krea2.text_tokens : index
  %inputs = index.constant 6144 : index
  %outputs = index.constant 6144 : index
  %result = template.apply<@projection.linear_f32_as_bf16>(%rows, %inputs, %outputs, %input, %weight) : (index, index, index, buffer, buffer) -> (vector<8xf32>)
  %final = template.apply<@projection.bias_f32_as_bf16>(%outputs, %result, %bias) : (index, vector<8xf32>, buffer) -> (vector<8xf32>)
  template.apply<@projection.store_bf16>(%rows, %outputs, %final, %output) : (index, index, vector<8xf32>, buffer)
  kernel.return
}

