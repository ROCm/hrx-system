config.decl @krea2.block_tokens : %value: index where [range(%value, 16, 65536), mul(%value, 16)]
amdgpu.target<gfx11-generic> @block_adapter_wave32 {subgroup_size = 32}
template.decl @projection.linear_f32_as_bf16(%rows: index, %inputs: index, %outputs: index, %row_origin: index, %output_origin: index, %input: buffer, %weight: buffer) -> (vector<8xf32>)
template.decl @projection.store_bf16(%rows: index, %outputs: index, %row_origin: index, %output_origin: index, %output_layout: encoding<layout>, %result: vector<8xf32>, %output: buffer)
template.decl @projection.adapter_epilogue_bf16(%rows: index, %outputs: index, %row_origin: index, %output_origin: index, %base_layout: encoding<layout>, %result: vector<8xf32>, %strength: buffer, %base: buffer) -> (vector<8xf32>)

command.program.decl @krea2.block_query(%layer: index) launch(%parameters: buffer, %input: buffer, %output: buffer)
command.program.decl @krea2.block_key(%layer: index) launch(%parameters: buffer, %input: buffer, %output: buffer)
command.program.decl @krea2.block_value(%layer: index) launch(%parameters: buffer, %input: buffer, %output: buffer)
command.program.decl @krea2.block_gate(%layer: index) launch(%parameters: buffer, %input: buffer, %output: buffer)
command.program.decl @krea2.block_attention_output(%layer: index) launch(%parameters: buffer, %input: buffer, %output: buffer)
command.program.decl @krea2.block_feed_forward_gate(%layer: index) launch(%parameters: buffer, %input: buffer, %output: buffer)
command.program.decl @krea2.block_feed_forward_up(%layer: index) launch(%parameters: buffer, %input: buffer, %output: buffer)
command.program.decl @krea2.block_feed_forward_down(%layer: index) launch(%parameters: buffer, %input: buffer, %output: buffer)

// Concrete wrappers bind the official rank-32 adapter's dimensions. Device
// arithmetic helpers receive SSA operands and contain no model configuration.
// The F32 file factors round to BF16 before the matrix contractions.

// Adjacent output halves of each rank-32 A projection share the same input
// panel instead of revisiting it after a complete sweep through the rows.
kernel.def target(@block_adapter_wave32) @block_adapter_linear_6144_32() {
  %rows = config.get @krea2.block_tokens : index
  %tile = index.constant 16 : index
  %row_tiles = index.div %rows, %tile : index
  %output_tiles = index.constant 2 : index
  %one = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%output_tiles, %row_tiles, %one) workgroup_size(%threads, %one, %one) : index
} launch(%input: buffer, %weight: buffer, %output: buffer) {
  %rows = config.get @krea2.block_tokens : index
  %inputs = index.constant 6144 : index
  %outputs = index.constant 32 : index
  %projection_tile = index.constant 16 : index
  %row_tile = kernel.workgroup.id<y> : index
  %output_tile = kernel.workgroup.id<x> : index
  %row_origin = index.mul %row_tile, %projection_tile : index
  %output_origin = index.mul %output_tile, %projection_tile : index
  %result = template.apply<@projection.linear_f32_as_bf16>(%rows, %inputs, %outputs, %row_origin, %output_origin, %input, %weight) : (index, index, index, index, index, buffer, buffer) -> (vector<8xf32>)
  %output_layout = encoding.layout.dense : encoding<layout>
  template.apply<@projection.store_bf16>(%rows, %outputs, %row_origin, %output_origin, %output_layout, %result, %output) : (index, index, index, index, encoding<layout>, vector<8xf32>, buffer)
  kernel.return
}

