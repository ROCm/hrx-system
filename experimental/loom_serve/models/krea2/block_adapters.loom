  kernel.launch @block_adapter_add_6144(%input, %weight, %strength, %base, %output) : (buffer, view<6144x32xf32>, buffer, buffer, buffer)
  command.return
}

command.program.def public @krea2.block_gate_adapted(%layer: index) launch(%parameters: buffer, %adapter: buffer, %input: buffer, %strength: buffer, %output: buffer) {
  %rows = config.get @krea2.block_tokens : index
  %rank_bytes = index.constant 64 : offset
  %low_bytes = index.scale %rows, %rank_bytes : index, offset -> offset
  %low = buffer.alloca<global> align(256) %low_bytes : buffer
  command.concurrent {
    command.program.launch @krea2.block_gate[%layer](%parameters, %input, %output) : [index](buffer, buffer, buffer)
    command.program.launch @krea2.block_gate_adapter_down[%layer](%adapter, %input, %low) : [index](buffer, buffer, buffer)
  }
  command.program.launch @krea2.block_gate_adapter_add[%layer](%adapter, %low, %strength, %output, %output) : [index](buffer, buffer, buffer, buffer, buffer)
  command.return
}

