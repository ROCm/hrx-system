// Factor commands expose independent numerical boundaries. The adapted
// commands overlap base and A contractions, then add B(Ax) in place without
// materializing a full-width delta. Base and adapter parameters never alias.

command.program.def public @krea2.block_query_adapter_down(%layer: index) launch(%adapter: buffer, %input: buffer, %output: buffer) {
  %weight = command.parameter %adapter, "transformer.transformer_blocks.{}.attn.to_q.lora_A.weight"[%layer] : view<32x6144xf32>
  kernel.launch @block_adapter_linear_6144_32(%input, %weight, %output) : (buffer, view<32x6144xf32>, buffer)
  command.return
}

command.program.def public @krea2.block_query_adapter_up(%layer: index) launch(%adapter: buffer, %input: buffer, %output: buffer) {
  %weight = command.parameter %adapter, "transformer.transformer_blocks.{}.attn.to_q.lora_B.weight"[%layer] : view<6144x32xf32>
  kernel.launch @block_adapter_linear_32_6144(%input, %weight, %output) : (buffer, view<6144x32xf32>, buffer)
  command.return
}

command.program.def public @krea2.block_query_adapter_add(%layer: index) launch(%adapter: buffer, %input: buffer, %strength: buffer, %base: buffer, %output: buffer) {
  %weight = command.parameter %adapter, "transformer.transformer_blocks.{}.attn.to_q.lora_B.weight"[%layer] : view<6144x32xf32>
  kernel.launch @block_adapter_add_6144(%input, %weight, %strength, %base, %output) : (buffer, view<6144x32xf32>, buffer, buffer, buffer)
  command.return
}

command.program.def public @krea2.block_query_adapted(%layer: index) launch(%parameters: buffer, %adapter: buffer, %input: buffer, %strength: buffer, %output: buffer) {
  %rows = config.get @krea2.block_tokens : index
  %rank_bytes = index.constant 64 : offset
  %low_bytes = index.scale %rows, %rank_bytes : index, offset -> offset
  %low = buffer.alloca<global> align(256) %low_bytes : buffer
  command.concurrent {
    command.program.launch @krea2.block_query[%layer](%parameters, %input, %output) : [index](buffer, buffer, buffer)
    command.program.launch @krea2.block_query_adapter_down[%layer](%adapter, %input, %low) : [index](buffer, buffer, buffer)
  }
  command.program.launch @krea2.block_query_adapter_add[%layer](%adapter, %low, %strength, %output, %output) : [index](buffer, buffer, buffer, buffer, buffer)
  command.return
}

command.program.def public @krea2.block_key_adapter_down(%layer: index) launch(%adapter: buffer, %input: buffer, %output: buffer) {
