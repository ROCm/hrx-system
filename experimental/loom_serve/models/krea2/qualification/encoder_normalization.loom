command.program.def public @qualify.encoder_key_rotary() launch(%parameters: buffer, %input: buffer, %cosine: buffer, %sine: buffer, %output: buffer) {
  %layer = config.get @qualify.encoder_layer : index
  command.program.launch @krea2.encoder_key_rotary[%layer](%parameters, %input, %cosine, %sine, %output) : [index](buffer, buffer, buffer, buffer, buffer)
