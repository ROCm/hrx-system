  %layer = config.get @krea2.block_index : index
  command.program.launch @krea2.block_feed_forward_up_adapted[%layer](%parameters, %adapter, %input, %strength, %output) : [index](buffer, buffer, buffer, buffer, buffer)
  command.return
}

