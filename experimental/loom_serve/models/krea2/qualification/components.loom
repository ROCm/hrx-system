command.program.def public @qualify.block_forward() launch(%parameters: buffer, %input: buffer, %modulation: buffer, %cosine: buffer, %sine: buffer, %mask: buffer, %output: buffer) {
  %tokens = config.get @krea2.block_tokens : index
  %layer = config.get @krea2.block_index : index
  %adapted = scalar.constant false : i1
  // The false specialization removes all uses of adapter and strength operands.
  template.apply<@krea2.block_forward>(%tokens, %layer, %adapted, %parameters, %parameters, %input, %modulation, %cosine, %sine, %mask, %input, %output) : (index, index, i1, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}

command.program.def public @qualify.block_forward_adapted() launch(%parameters: buffer, %adapter: buffer, %input: buffer, %modulation: buffer, %cosine: buffer, %sine: buffer, %mask: buffer, %strength: buffer, %output: buffer) {
  %tokens = config.get @krea2.block_tokens : index
  %layer = config.get @krea2.block_index : index
  %adapted = scalar.constant true : i1
  template.apply<@krea2.block_forward>(%tokens, %layer, %adapted, %parameters, %adapter, %input, %modulation, %cosine, %sine, %mask, %strength, %output) : (index, index, i1, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}
