template.decl @krea2.block_forward(%tokens: index, %layer: index, %adapted: i1, %parameters: buffer, %adapter: buffer, %input: buffer, %modulation: buffer, %cosine: buffer, %sine: buffer, %mask: buffer, %strength: buffer, %output: buffer)

command.program.def public @qualify.block_norm1() launch(%parameters: buffer, %input: buffer, %output: buffer) {
  %layer = config.get @krea2.block_index : index
  command.program.launch @krea2.block_norm1[%layer](%parameters, %input, %output) : [index](buffer, buffer, buffer)
  command.return
}

