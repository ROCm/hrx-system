command.program.def public @qualify.text_second_adapter_add() launch(%adapter: buffer, %input: buffer, %strength: buffer, %base: buffer, %output: buffer) {
  %weight = command.parameter %adapter, "transformer.txt_in.linear_2.lora_B.weight" : view<6144x32xf32>
  kernel.launch @krea_text_adapter_add(%input, %weight, %strength, %base, %output) : (buffer, view<6144x32xf32>, buffer, buffer, buffer)
