command.program.def public @qualify.text_second_adapter_down() launch(%adapter: buffer, %input: buffer, %output: buffer) {
  %weight = command.parameter %adapter, "transformer.txt_in.linear_2.lora_A.weight" : view<32x6144xf32>
  kernel.launch @krea_text_adapter_down_hidden(%input, %weight, %output) : (buffer, view<32x6144xf32>, buffer)
  command.return
}

command.program.def public @qualify.text_second_adapter_up() launch(%adapter: buffer, %input: buffer, %output: buffer) {
  %weight = command.parameter %adapter, "transformer.txt_in.linear_2.lora_B.weight" : view<6144x32xf32>
  kernel.launch @qualify_text_adapter_up(%input, %weight, %output) : (buffer, view<6144x32xf32>, buffer)
