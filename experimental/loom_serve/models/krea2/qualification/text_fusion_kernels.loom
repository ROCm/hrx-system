// Standalone B, SiLU, and ungated attention expose production fusion boundaries.
config.decl @krea2.text_tokens : %value: index where [range(%value, 16, 65536), mul(%value, 16)]
amdgpu.target<gfx11-generic> @fusion_qualification_wave32 {subgroup_size = 32}
amdgpu.target<gfx11-generic> @fusion_qualification_wave64 {subgroup_size = 64}
template.decl @projection.linear_f32_as_bf16(%rows: index, %inputs: index, %outputs: index, %input: buffer, %weight: buffer) -> (vector<8xf32>)
template.decl @projection.store_bf16(%rows: index, %outputs: index, %output_layout: encoding<layout>, %result: vector<8xf32>, %output: buffer)
template.decl @activation.silu_bf16(%value: bf16) -> (bf16)
template.decl @attention.segmented_128_bf16(%rows: index, %length: index, %heads: index, %row: index, %head: index, %query: buffer, %key: buffer, %value: buffer) -> (vector<4xbf16>)
template.decl @attention.expanded_masked_gqa_128_bf16(%tokens: index, %query_heads: index, %key_value_heads: index, %causal: i1, %value_layout: encoding<layout>, %query: buffer, %key: buffer, %value: buffer, %mask: buffer) -> (vector<8xbf16>)
template.decl @attention.store_128_bf16(%tokens: index, %heads: index, %values: vector<8xbf16>, %output: buffer)

kernel.def target(@fusion_qualification_wave32) @fusion_layerwise_linear_32_2560() {
  %texts = config.get @krea2.text_tokens : index
  %layers = index.constant 12 : index
  %rows = index.mul %texts, %layers : index
  %tile = index.constant 16 : index
  %groups = index.div %rows, %tile : index
  %columns = index.constant 160 : index
  %one = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%groups, %columns, %one) workgroup_size(%threads, %one, %one) : index
} launch(%input: buffer, %weight: buffer, %output: buffer) {
  %texts = config.get @krea2.text_tokens : index
  %layers = index.constant 12 : index
  %rows = index.mul %texts, %layers : index
  %inputs = index.constant 32 : index
  %outputs = index.constant 2560 : index
  %result = template.apply<@projection.linear_f32_as_bf16>(%rows, %inputs, %outputs, %input, %weight) : (index, index, index, buffer, buffer) -> (vector<8xf32>)
  %output_layout = encoding.layout.dense : encoding<layout>
  template.apply<@projection.store_bf16>(%rows, %outputs, %output_layout, %result, %output) : (index, index, encoding<layout>, vector<8xf32>, buffer)
  kernel.return
}

kernel.def target(@fusion_qualification_wave32) @fusion_layerwise_linear_32_6912() {
  %texts = config.get @krea2.text_tokens : index
  %layers = index.constant 12 : index
  %rows = index.mul %texts, %layers : index
  %tile = index.constant 16 : index
  %groups = index.div %rows, %tile : index
  %columns = index.constant 432 : index
  %one = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%groups, %columns, %one) workgroup_size(%threads, %one, %one) : index
} launch(%input: buffer, %weight: buffer, %output: buffer) {
  %texts = config.get @krea2.text_tokens : index
  %layers = index.constant 12 : index
  %rows = index.mul %texts, %layers : index
  %inputs = index.constant 32 : index
  %outputs = index.constant 6912 : index
  %result = template.apply<@projection.linear_f32_as_bf16>(%rows, %inputs, %outputs, %input, %weight) : (index, index, index, buffer, buffer) -> (vector<8xf32>)
  %output_layout = encoding.layout.dense : encoding<layout>
  template.apply<@projection.store_bf16>(%rows, %outputs, %output_layout, %result, %output) : (index, index, encoding<layout>, vector<8xf32>, buffer)
  kernel.return
}

kernel.def target(@fusion_qualification_wave32) @fusion_layerwise_silu() {
  %texts = config.get @krea2.text_tokens : index
  %layers = index.constant 12 : index
  %rows = index.mul %texts, %layers : index
  %groups_per_row = index.constant 27 : index
  %groups = index.mul %rows, %groups_per_row : index
  %one = index.constant 1 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%groups, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%input: buffer, %output: buffer) {
  %texts = config.get @krea2.text_tokens : index
  %layers = index.constant 12 : index
  %rows = index.mul %texts, %layers : index
  %width = index.constant 6912 : index
  %elements = index.mul %rows, %width : index
  %origin = index.constant 0 : offset
  %threads = index.constant 256 : index
  %group = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %element = index.madd %group, %threads, %lane : index
  %input_view = buffer.view %input[%origin] : buffer -> view<[%elements]xbf16>
  %output_view = buffer.view %output[%origin] : buffer -> view<[%elements]xbf16>
  %value = view.load %input_view[%element] : view<[%elements]xbf16> -> bf16
  %result = template.apply<@activation.silu_bf16>(%value) : (bf16) -> (bf16)
  view.store %result, %output_view[%element] : bf16, view<[%elements]xbf16>
  kernel.return
}

