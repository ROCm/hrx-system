  %rows = config.get @krea2.text_tokens : index
  %tile = index.constant 16 : index
  %groups = index.div %rows, %tile : index
  %columns = index.constant 160 : index
  %one = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%groups, %columns, %one) workgroup_size(%threads, %one, %one) : index
} launch(%input: buffer, %weight: buffer, %output: buffer) {
  %rows = config.get @krea2.text_tokens : index
  %inputs = index.constant 32 : index
  %outputs = index.constant 2560 : index
  %result = template.apply<@projection.linear_f32_as_bf16>(%rows, %inputs, %outputs, %input, %weight) : (index, index, index, buffer, buffer) -> (vector<8xf32>)
  %output_layout = encoding.layout.dense : encoding<layout>
  template.apply<@projection.store_bf16>(%rows, %outputs, %output_layout, %result, %output) : (index, index, encoding<layout>, vector<8xf32>, buffer)
  kernel.return
}

