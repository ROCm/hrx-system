kernel.def target(@fusion_qualification_wave32) @fusion_refiner_silu() {
  %rows = config.get @krea2.text_tokens : index
  %groups_per_row = index.constant 27 : index
  %groups = index.mul %rows, %groups_per_row : index
  %one = index.constant 1 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%groups, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%input: buffer, %output: buffer) {
  %rows = config.get @krea2.text_tokens : index
  %width = index.constant 6912 : index
  %elements = index.mul %rows, %width : index
  %origin = index.constant 0 : offset
  %threads = index.constant 256 : index
  %group = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %element = index.madd %group, %threads, %lane : index
  %input_view = buffer.view %input[%origin] : buffer -> view<[%elements]xbf16>
  %output_view = buffer.view %output[%origin] : buffer -> view<[%elements]xbf16>
  %value = view.load %input_view[%element] : view<[%elements]xbf16> -> bf16
  %result = template.apply<@activation.silu_bf16>(%value) : (bf16) -> (bf16)
  view.store %result, %output_view[%element] : bf16, view<[%elements]xbf16>
  kernel.return
}

kernel.def target(@fusion_qualification_wave32) @fusion_layerwise_attention() {
  %texts = config.get @krea2.text_tokens : index
  %layers = index.constant 12 : index
  %rows = index.mul %texts, %layers : index
  %four = index.constant 4 : index
  %groups = index.div %rows, %four : index
  %heads = index.constant 20 : index
  %one = index.constant 1 : index
  %threads = index.constant 128 : index
  kernel.launch.config workgroups(%groups, %heads, %one) workgroup_size(%threads, %one, %one) : index
} launch(%query: buffer, %key: buffer, %value: buffer, %output: buffer) {
  %texts = config.get @krea2.text_tokens : index
  %layers = index.constant 12 : index
  %rows = index.mul %texts, %layers : index
  %length = index.constant 12 : index
  %heads = index.constant 20 : index
  %four = index.constant 4 : index
  %head_width = index.constant 128 : index
  %width = index.constant 2560 : index
  %group = kernel.workgroup.id<x> : index
  %head = kernel.workgroup.id<y> : index
  %wave = kernel.subgroup.id : index
  %lane = kernel.subgroup.lane.id : index
  %row = index.madd %group, %four, %wave : index
  %lane_column = index.mul %lane, %four : index
  %column = index.madd %head, %head_width, %lane_column : index
  %result = template.apply<@attention.segmented_128_bf16>(%rows, %length, %heads, %row, %head, %query, %key, %value) : (index, index, index, index, index, buffer, buffer, buffer) -> (vector<4xbf16>)
  %origin = index.constant 0 : offset
  %output_view = buffer.view %output[%origin] : buffer -> view<[%rows]x[%width]xbf16>
  vector.store %result, %output_view[%row, %column] : vector<4xbf16>, view<[%rows]x[%width]xbf16>
  kernel.return
}

kernel.def target(@fusion_qualification_wave64) @fusion_refiner_attention() {
  %rows = config.get @krea2.text_tokens : index
  %tile = index.constant 16 : index
  %groups = index.div %rows, %tile : index
  %heads = index.constant 20 : index
  %one = index.constant 1 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%groups, %heads, %one) workgroup_size(%threads, %one, %one) : index
} launch(%query: buffer, %key: buffer, %value: buffer, %mask: buffer, %output: buffer) {
  %rows = config.get @krea2.text_tokens : index
  %heads = index.constant 20 : index
  %causal = scalar.constant false : i1
  %value_layout = encoding.layout.dense : encoding<layout>
  %result = template.apply<@attention.expanded_masked_gqa_128_bf16>(%rows, %heads, %heads, %causal, %value_layout, %query, %key, %value, %mask) : (index, index, index, i1, encoding<layout>, buffer, buffer, buffer, buffer) -> (vector<8xbf16>)
  template.apply<@attention.store_128_bf16>(%rows, %heads, %result, %output) : (index, index, vector<8xbf16>, buffer)
  kernel.return
}

command.program.def public @krea2.fusion_layerwise_attention_ungated() launch(%query: buffer, %key: buffer, %value: buffer, %output: buffer) {
  kernel.launch @fusion_layerwise_attention(%query, %key, %value, %output) : (buffer, buffer, buffer, buffer)
  command.return
}

command.program.def public @krea2.fusion_layerwise_silu() launch(%input: buffer, %output: buffer) {
  kernel.launch @fusion_layerwise_silu(%input, %output) : (buffer, buffer)
  command.return
}

command.program.def public @krea2.fusion_refiner_attention_ungated() launch(%query: buffer, %key: buffer, %value: buffer, %mask: buffer, %output: buffer) {
  kernel.launch @fusion_refiner_attention(%query, %key, %value, %mask, %output) : (buffer, buffer, buffer, buffer, buffer)
  command.return
}

command.program.def public @krea2.fusion_refiner_silu() launch(%input: buffer, %output: buffer) {
  kernel.launch @fusion_refiner_silu(%input, %output) : (buffer, buffer)
  command.return
}
