config.decl @krea2.time_count : %value: index where [range(%value, 1, 256)]
amdgpu.target<gfx11-generic> @time_qualification_wave32 {subgroup_size = 32}
template.decl @projection.linear_f32_as_bf16(%rows: index, %inputs: index, %outputs: index, %row_origin: index, %output_origin: index, %input: buffer, %weight: buffer) -> (vector<8xf32>)
template.decl @projection.store_bf16(%rows: index, %outputs: index, %row_origin: index, %output_origin: index, %output_layout: encoding<layout>, %result: vector<8xf32>, %output: buffer)
kernel.decl @krea_time_sinusoidal() launch(%input: buffer, %output: buffer)
kernel.decl @krea_time_gelu() launch(%input: buffer, %output: buffer)
kernel.decl @krea_time_adapter_down_features() launch(%input: buffer, %weight: buffer, %output: buffer)
kernel.decl @krea_time_adapter_down_hidden() launch(%input: buffer, %weight: buffer, %output: buffer)
kernel.decl @krea_time_adapter_add_hidden() launch(%input: buffer, %weight: buffer, %strength: buffer, %base: buffer, %output: buffer)
kernel.decl @krea_time_adapter_add_modulation() launch(%input: buffer, %weight: buffer, %strength: buffer, %base: buffer, %output: buffer)
command.program.decl @krea2.time_first(%adapted: i1, %output_offset: offset) launch(%parameters: buffer, %adapter: buffer, %input: buffer, %strength: buffer, %output: buffer)
command.program.decl @krea2.time_embedding(%adapted: i1, %output_offset: offset) launch(%parameters: buffer, %adapter: buffer, %input: buffer, %strength: buffer, %output: buffer)
command.program.decl @krea2.time_modulation(%adapted: i1, %output_offset: offset) launch(%parameters: buffer, %adapter: buffer, %input: buffer, %strength: buffer, %output: buffer)

kernel.def target(@time_qualification_wave32) @qualify_time_adapter_up_hidden() {
  %count = config.get @krea2.time_count : index
  %tile = index.constant 16 : index
  %padding = index.constant 15 : index
  %padded_count = index.add %count, %padding : index
  %tiles = index.div %padded_count, %tile : index
  %rows = index.mul %tiles, %tile : index

  %output_tiles = index.constant 384 : index
  %one = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%tiles, %output_tiles, %one) workgroup_size(%threads, %one, %one) : index
} launch(%input: buffer, %weight: buffer, %output: buffer) {
  %count = config.get @krea2.time_count : index
  %tile = index.constant 16 : index
  %padding = index.constant 15 : index
  %padded_count = index.add %count, %padding : index
  %tiles = index.div %padded_count, %tile : index
  %rows = index.mul %tiles, %tile : index

  %inputs = index.constant 32 : index
  %outputs = index.constant 6144 : index
  %projection_tile = index.constant 16 : index
  %row_tile = kernel.workgroup.id<x> : index
  %output_tile = kernel.workgroup.id<y> : index
  %row_origin = index.mul %row_tile, %projection_tile : index
  %output_origin = index.mul %output_tile, %projection_tile : index
  %result = template.apply<@projection.linear_f32_as_bf16>(%rows, %inputs, %outputs, %row_origin, %output_origin, %input, %weight) : (index, index, index, index, index, buffer, buffer) -> (vector<8xf32>)
  %output_layout = encoding.layout.dense : encoding<layout>
  template.apply<@projection.store_bf16>(%rows, %outputs, %row_origin, %output_origin, %output_layout, %result, %output) : (index, index, index, index, encoding<layout>, vector<8xf32>, buffer)
  kernel.return
}

kernel.def target(@time_qualification_wave32) @qualify_time_adapter_up_modulation() {
  %count = config.get @krea2.time_count : index
  %tile = index.constant 16 : index
  %padding = index.constant 15 : index
  %padded_count = index.add %count, %padding : index
  %tiles = index.div %padded_count, %tile : index
  %rows = index.mul %tiles, %tile : index

  %output_tiles = index.constant 2304 : index
  %one = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%tiles, %output_tiles, %one) workgroup_size(%threads, %one, %one) : index
} launch(%input: buffer, %weight: buffer, %output: buffer) {
  %count = config.get @krea2.time_count : index
  %tile = index.constant 16 : index
  %padding = index.constant 15 : index
  %padded_count = index.add %count, %padding : index
  %tiles = index.div %padded_count, %tile : index
  %rows = index.mul %tiles, %tile : index

  %inputs = index.constant 32 : index
  %outputs = index.constant 36864 : index
  %projection_tile = index.constant 16 : index
  %row_tile = kernel.workgroup.id<x> : index
  %output_tile = kernel.workgroup.id<y> : index
  %row_origin = index.mul %row_tile, %projection_tile : index
  %output_origin = index.mul %output_tile, %projection_tile : index
  %result = template.apply<@projection.linear_f32_as_bf16>(%rows, %inputs, %outputs, %row_origin, %output_origin, %input, %weight) : (index, index, index, index, index, buffer, buffer) -> (vector<8xf32>)
  %output_layout = encoding.layout.dense : encoding<layout>
  template.apply<@projection.store_bf16>(%rows, %outputs, %row_origin, %output_origin, %output_layout, %result, %output) : (index, index, index, index, encoding<layout>, vector<8xf32>, buffer)
  kernel.return
}

command.program.def public @qualify.time_sinusoidal() launch(%input: buffer, %output: buffer) {
  kernel.launch @krea_time_sinusoidal(%input, %output) : (buffer, buffer)
  command.return
}

command.program.def public @qualify.time_gelu() launch(%input: buffer, %output: buffer) {
  kernel.launch @krea_time_gelu(%input, %output) : (buffer, buffer)
  command.return
}

command.program.def public @qualify.time_first() launch(%parameters: buffer, %input: buffer, %output: buffer) {
  %adapted = scalar.constant false : i1
  %origin = index.constant 0 : offset
  command.program.launch @krea2.time_first[%adapted, %origin](%parameters, %parameters, %input, %input, %output) : [i1, offset](buffer, buffer, buffer, buffer, buffer)
  command.return
}

command.program.def public @qualify.time_first_adapted() launch(%parameters: buffer, %adapter: buffer, %input: buffer, %strength: buffer, %output: buffer) {
  %adapted = scalar.constant true : i1
  %origin = index.constant 0 : offset
  command.program.launch @krea2.time_first[%adapted, %origin](%parameters, %adapter, %input, %strength, %output) : [i1, offset](buffer, buffer, buffer, buffer, buffer)
  command.return
}

command.program.def public @qualify.time_first_adapter_down() launch(%adapter: buffer, %input: buffer, %output: buffer) {
  %weight = command.parameter %adapter, "transformer.time_embed.linear_1.lora_A.weight" : view<32x256xf32>
  kernel.launch @krea_time_adapter_down_features(%input, %weight, %output) : (buffer, view<32x256xf32>, buffer)
  command.return
}

command.program.def public @qualify.time_first_adapter_up() launch(%adapter: buffer, %input: buffer, %output: buffer) {
  %weight = command.parameter %adapter, "transformer.time_embed.linear_1.lora_B.weight" : view<6144x32xf32>
  kernel.launch @qualify_time_adapter_up_hidden(%input, %weight, %output) : (buffer, view<6144x32xf32>, buffer)
  command.return
}

command.program.def public @qualify.time_first_adapter_add() launch(%adapter: buffer, %input: buffer, %strength: buffer, %base: buffer, %output: buffer) {
  %weight = command.parameter %adapter, "transformer.time_embed.linear_1.lora_B.weight" : view<6144x32xf32>
