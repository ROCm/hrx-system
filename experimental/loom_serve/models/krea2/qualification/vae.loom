config.decl @qualify.height : %value: index where [range(%value, 1, 1024)]
config.decl @qualify.width : %value: index where [range(%value, 1, 1024)]
config.decl @qualify.inputs : %value: index where [range(%value, 1, 1152)]
config.decl @qualify.outputs : %value: index where [range(%value, 1, 1152)]
config.decl @qualify.extent : %value: index where [range(%value, 1, 3)]
config.decl @qualify.planes : %value: index where [range(%value, 1, 3)]
config.decl @qualify.upsample : %value: index where [range(%value, 1, 2)]
config.decl @qualify.attention_tokens : %value: index where [range(%value, 1, 1048576)]
config.decl @qualify.attention_channels : %value: index where [range(%value, 1, 512)]

template.decl @attention.single_head_nchw_f32(%tokens: index, %channels: index, %qkv: buffer, %output: buffer)

template.decl @image.convolution_nchw_f32(%height: index, %width: index, %inputs: index, %outputs: index, %extent: index, %planes: index, %upsample: index, %add_residual: i1, %input: buffer, %weight: buffer, %bias: buffer, %residual: buffer, %output: buffer)
amdgpu.target<gfx11-generic> @image_qualification_wave32 {subgroup_size = 32}

kernel.def target(@image_qualification_wave32) @qualify_image_convolution() {
  %height = config.get @qualify.height : index
  %width = config.get @qualify.width : index
  %outputs = config.get @qualify.outputs : index
  %upsample = config.get @qualify.upsample : index
  %output_height = index.mul %height, %upsample : index
  %output_width = index.mul %width, %upsample : index
  %pixels = index.mul %output_height, %output_width : index
  %padding = index.constant 127 : index
  %threads = index.constant 128 : index
  %rounded = index.add %pixels, %padding : index
  %groups = index.div %rounded, %threads : index
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %outputs, %one) workgroup_size(%threads, %one, %one) : index
} launch(%input: buffer, %weight: buffer, %bias: buffer, %output: buffer) {
  %height = config.get @qualify.height : index
  %width = config.get @qualify.width : index
  %inputs = config.get @qualify.inputs : index
  %outputs = config.get @qualify.outputs : index
  %extent = config.get @qualify.extent : index
  %planes = config.get @qualify.planes : index
  %upsample = config.get @qualify.upsample : index
  %add_residual = scalar.constant false : i1
  template.apply<@image.convolution_nchw_f32>(%height, %width, %inputs, %outputs, %extent, %planes, %upsample, %add_residual, %input, %weight, %bias, %output, %output) : (index, index, index, index, index, index, index, i1, buffer, buffer, buffer, buffer, buffer)
  kernel.return
}

command.program.def public @qualify.image_convolution() launch(%input: buffer, %weight: buffer, %bias: buffer, %output: buffer) {
  kernel.launch @qualify_image_convolution(%input, %weight, %bias, %output) : (buffer, buffer, buffer, buffer)
  command.return
}

kernel.def target(@image_qualification_wave32) @qualify_image_attention() {
  %tokens = config.get @qualify.attention_tokens : index
  %threads = index.constant 128 : index
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%tokens, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%input: buffer, %output: buffer) {
  %tokens = config.get @qualify.attention_tokens : index
  %channels = config.get @qualify.attention_channels : index
  template.apply<@attention.single_head_nchw_f32>(%tokens, %channels, %input, %output) : (index, index, buffer, buffer)
  kernel.return
}

command.program.def public @qualify.image_attention() launch(%input: buffer, %output: buffer) {
  kernel.launch @qualify_image_attention(%input, %output) : (buffer, buffer)
  command.return
}

config.decl @qualify.vae_block : %value: index where [range(%value, 0, 1)]
config.decl @qualify.vae_ordinal : %value: index where [range(%value, 1, 2)]
command.program.decl @krea2.vae_mid_norm(%block: index, %ordinal: index) launch(%parameters: buffer, %input: buffer, %output: buffer)
command.program.decl @krea2.vae_mid_convolution(%block: index, %ordinal: index) launch(%parameters: buffer, %input: buffer, %output: buffer)
command.program.decl @krea2.vae_mid_convolution_add(%block: index) launch(%parameters: buffer, %input: buffer, %residual: buffer, %output: buffer)
command.program.decl @krea2.vae_mid_residual(%block: index) launch(%parameters: buffer, %input: buffer, %output: buffer)

command.program.def public @qualify.vae_mid_norm() launch(%parameters: buffer, %input: buffer, %output: buffer) {
  %block = config.get @qualify.vae_block : index
  %ordinal = config.get @qualify.vae_ordinal : index
  command.program.launch @krea2.vae_mid_norm[%block, %ordinal](%parameters, %input, %output) : [index, index](buffer, buffer, buffer)
  command.return
}

command.program.def public @qualify.vae_mid_convolution() launch(%parameters: buffer, %input: buffer, %output: buffer) {
  %block = config.get @qualify.vae_block : index
  %ordinal = config.get @qualify.vae_ordinal : index
  command.program.launch @krea2.vae_mid_convolution[%block, %ordinal](%parameters, %input, %output) : [index, index](buffer, buffer, buffer)
  command.return
}

command.program.def public @qualify.vae_mid_convolution_add() launch(%parameters: buffer, %input: buffer, %residual: buffer, %output: buffer) {
  %block = config.get @qualify.vae_block : index
  command.program.launch @krea2.vae_mid_convolution_add[%block](%parameters, %input, %residual, %output) : [index](buffer, buffer, buffer, buffer)
  command.return
}

command.program.def public @qualify.vae_mid_residual() launch(%parameters: buffer, %input: buffer, %output: buffer) {
  %block = config.get @qualify.vae_block : index
  command.program.launch @krea2.vae_mid_residual[%block](%parameters, %input, %output) : [index](buffer, buffer, buffer)
  command.return
}

config.decl @qualify.vae_stage : %value: index where [range(%value, 0, 3)]
config.decl @qualify.vae_resize_stage : %value: index where [range(%value, 0, 2)]
config.decl @qualify.vae_up_block : %value: index where [range(%value, 0, 2)]
command.program.decl @krea2.vae_up0_residual(%block: index) launch(%parameters: buffer, %input: buffer, %output: buffer)
command.program.decl @krea2.vae_up0_resize() launch(%parameters: buffer, %input: buffer, %output: buffer)
command.program.decl @krea2.vae_up1_residual(%block: index) launch(%parameters: buffer, %input: buffer, %output: buffer)
command.program.decl @krea2.vae_up1_resize() launch(%parameters: buffer, %input: buffer, %output: buffer)
command.program.decl @krea2.vae_up2_residual(%block: index) launch(%parameters: buffer, %input: buffer, %output: buffer)
command.program.decl @krea2.vae_up2_resize() launch(%parameters: buffer, %input: buffer, %output: buffer)
command.program.decl @krea2.vae_up3_residual(%block: index) launch(%parameters: buffer, %input: buffer, %output: buffer)

command.program.def public @qualify.vae_up_residual() launch(%parameters: buffer, %input: buffer, %output: buffer) {
  %stage = config.get @qualify.vae_stage : index
  %block = config.get @qualify.vae_up_block : index
  %stage0 = index.constant 0 : index
  %is0 = index.cmp eq, %stage, %stage0 : index
  scf.if %is0 {
    command.program.launch @krea2.vae_up0_residual[%block](%parameters, %input, %output) : [index](buffer, buffer, buffer)
  }
  %stage1 = index.constant 1 : index
  %is1 = index.cmp eq, %stage, %stage1 : index
  scf.if %is1 {
    command.program.launch @krea2.vae_up1_residual[%block](%parameters, %input, %output) : [index](buffer, buffer, buffer)
  }
  %stage2 = index.constant 2 : index
  %is2 = index.cmp eq, %stage, %stage2 : index
  scf.if %is2 {
    command.program.launch @krea2.vae_up2_residual[%block](%parameters, %input, %output) : [index](buffer, buffer, buffer)
  }
  %stage3 = index.constant 3 : index
  %is3 = index.cmp eq, %stage, %stage3 : index
  scf.if %is3 {
    command.program.launch @krea2.vae_up3_residual[%block](%parameters, %input, %output) : [index](buffer, buffer, buffer)
  }
  command.return
}

command.program.def public @qualify.vae_up_resize() launch(%parameters: buffer, %input: buffer, %output: buffer) {
  %stage = config.get @qualify.vae_resize_stage : index
  %stage0 = index.constant 0 : index
  %is0 = index.cmp eq, %stage, %stage0 : index
  scf.if %is0 {
    command.program.launch @krea2.vae_up0_resize(%parameters, %input, %output) : (buffer, buffer, buffer)
  }
  %stage1 = index.constant 1 : index
  %is1 = index.cmp eq, %stage, %stage1 : index
  scf.if %is1 {
    command.program.launch @krea2.vae_up1_resize(%parameters, %input, %output) : (buffer, buffer, buffer)
  }
  %stage2 = index.constant 2 : index
  %is2 = index.cmp eq, %stage, %stage2 : index
  scf.if %is2 {
    command.program.launch @krea2.vae_up2_resize(%parameters, %input, %output) : (buffer, buffer, buffer)
  }
  command.return
}
