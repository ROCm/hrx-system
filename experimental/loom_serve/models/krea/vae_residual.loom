config.decl @krea2.latent_height : %value: index where [range(%value, 2, 1024), multiple_of(%value, 2)]

config.decl @krea2.latent_width : %value: index where [range(%value, 2, 1024), multiple_of(%value, 2)]

config.decl @krea2.vae_tile_height : %value: index where [range(%value, 2, 1024), multiple_of(%value, 2)]

config.decl @krea2.vae_tile_width : %value: index where [range(%value, 2, 1024), multiple_of(%value, 2)]

amdgpu.target<gfx11-generic> @vae_residual_wave32 {subgroup_size = 32}

template.decl @image.convolution_3x3_matrix_f32(%height: index, %width: index, %inputs: index, %outputs: index, %planes: index, %upsample: index, %add_residual: i1, %input: buffer, %weight: buffer, %bias: buffer, %residual: buffer, %output: buffer)

template.decl @image.channel_norm_f32(%pixels: index, %channels: index, %silu: i1, %input: buffer, %weight: buffer, %output: buffer)

command.program.decl @vae_input() launch(%parameters: buffer, %input: buffer, %affine: buffer, %output: buffer)

template.decl @krea2.vae_mid_normalize_f32(%height: index, %width: index, %input: buffer, %weight: buffer, %output: buffer)

template.decl @krea2.vae_mid_convolution_f32(%height: index, %width: index, %add_residual: i1, %input: buffer, %weight: buffer, %bias: buffer, %residual: buffer, %output: buffer)

// Shared mid-residual device bodies accept statically specialized geometry so
// full-image and decoder-tile entrypoints can bind distinct config domains.
template.def<@krea2.vae_mid_normalize_f32> device @krea2_vae_mid_normalize_f32(%height: index, %width: index, %input: buffer, %weight: buffer, %output: buffer) {
  %pixels = index.mul %height, %width : index
  %channels = index.constant 384 : index
  %silu = scalar.constant true : i1
  template.apply<@image.channel_norm_f32>(%pixels, %channels, %silu, %input, %weight, %output) : (index, index, i1, buffer, buffer, buffer)
  template.return
}

template.def<@krea2.vae_mid_convolution_f32> device @krea2_vae_mid_convolution_f32(%height: index, %width: index, %add_residual: i1, %input: buffer, %weight: buffer, %bias: buffer, %residual: buffer, %output: buffer) {
  %channels = index.constant 384 : index
  %c1 = index.constant 1 : index
  %c3 = index.constant 3 : index
  template.apply<@image.convolution_3x3_matrix_f32>(%height, %width, %channels, %channels, %c3, %c1, %add_residual, %input, %weight, %bias, %residual, %output) : (index, index, index, index, index, index, i1, buffer, buffer, buffer, buffer, buffer)
  template.return
}

kernel.def target(@vae_residual_wave32) @krea_vae_mid_norm() {
  %height = config.get @krea2.latent_height : index
  %width = config.get @krea2.latent_width : index
  %pixels = index.mul %height, %width : index
  %padding = index.constant 127 : index
  %threads = index.constant 128 : index
  %rounded = index.add %pixels, %padding : index
  %groups = index.div %rounded, %threads : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%input: buffer, %weight: buffer, %output: buffer) {
  %height = config.get @krea2.latent_height : index
  %width = config.get @krea2.latent_width : index
  template.apply<@krea2.vae_mid_normalize_f32>(%height, %width, %input, %weight, %output) : (index, index, buffer, buffer, buffer)
  kernel.return
}

kernel.def target(@vae_residual_wave32) @krea_vae_mid_convolution() {
  %height = config.get @krea2.latent_height : index
  %width = config.get @krea2.latent_width : index
  %pixels = index.mul %height, %width : index
  %padding = index.constant 31 : index
  %tile = index.constant 32 : index
  %threads = index.constant 128 : index
  %rounded = index.add %pixels, %padding : index
  %groups = index.div %rounded, %tile : index
  %channels = index.constant 384 : index
  %channel_groups = index.div %channels, %tile : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %channel_groups, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%input: buffer, %weight: buffer, %bias: buffer, %output: buffer) {
  %height = config.get @krea2.latent_height : index
  %width = config.get @krea2.latent_width : index
  %add_residual = scalar.constant false : i1
  template.apply<@krea2.vae_mid_convolution_f32>(%height, %width, %add_residual, %input, %weight, %bias, %output, %output) : (index, index, i1, buffer, buffer, buffer, buffer, buffer)
  kernel.return
}

kernel.def target(@vae_residual_wave32) @krea_vae_mid_convolution_add() {
  %height = config.get @krea2.latent_height : index
  %width = config.get @krea2.latent_width : index
  %pixels = index.mul %height, %width : index
  %padding = index.constant 31 : index
  %tile = index.constant 32 : index
  %threads = index.constant 128 : index
  %rounded = index.add %pixels, %padding : index
  %groups = index.div %rounded, %tile : index
  %channels = index.constant 384 : index
  %channel_groups = index.div %channels, %tile : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %channel_groups, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%input: buffer, %weight: buffer, %bias: buffer, %residual: buffer, %output: buffer) {
  %height = config.get @krea2.latent_height : index
  %width = config.get @krea2.latent_width : index
  %add_residual = scalar.constant true : i1
  template.apply<@krea2.vae_mid_convolution_f32>(%height, %width, %add_residual, %input, %weight, %bias, %residual, %output) : (index, index, i1, buffer, buffer, buffer, buffer, buffer)
  kernel.return
}

// Tile entrypoints bind the decoder-tail config domain while sharing the
// full-image mid-residual device bodies above.
kernel.def target(@vae_residual_wave32) @krea_vae_tile_mid_norm() {
  %height = config.get @krea2.vae_tile_height : index
  %width = config.get @krea2.vae_tile_width : index
  %pixels = index.mul %height, %width : index
  %padding = index.constant 127 : index
  %threads = index.constant 128 : index
  %rounded = index.add %pixels, %padding : index
  %groups = index.div %rounded, %threads : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%input: buffer, %weight: buffer, %output: buffer) {
  %height = config.get @krea2.vae_tile_height : index
  %width = config.get @krea2.vae_tile_width : index
  template.apply<@krea2.vae_mid_normalize_f32>(%height, %width, %input, %weight, %output) : (index, index, buffer, buffer, buffer)
  kernel.return
}

kernel.def target(@vae_residual_wave32) @krea_vae_tile_mid_convolution() {
  %height = config.get @krea2.vae_tile_height : index
  %width = config.get @krea2.vae_tile_width : index
  %pixels = index.mul %height, %width : index
  %padding = index.constant 31 : index
  %tile = index.constant 32 : index
  %threads = index.constant 128 : index
  %rounded = index.add %pixels, %padding : index
  %groups = index.div %rounded, %tile : index
  %channels = index.constant 384 : index
  %channel_groups = index.div %channels, %tile : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %channel_groups, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%input: buffer, %weight: buffer, %bias: buffer, %output: buffer) {
  %height = config.get @krea2.vae_tile_height : index
  %width = config.get @krea2.vae_tile_width : index
  %add_residual = scalar.constant false : i1
  template.apply<@krea2.vae_mid_convolution_f32>(%height, %width, %add_residual, %input, %weight, %bias, %output, %output) : (index, index, i1, buffer, buffer, buffer, buffer, buffer)
  kernel.return
}

kernel.def target(@vae_residual_wave32) @krea_vae_tile_mid_convolution_add() {
  %height = config.get @krea2.vae_tile_height : index
  %width = config.get @krea2.vae_tile_width : index
  %pixels = index.mul %height, %width : index
  %padding = index.constant 31 : index
  %tile = index.constant 32 : index
  %threads = index.constant 128 : index
  %rounded = index.add %pixels, %padding : index
  %groups = index.div %rounded, %tile : index
  %channels = index.constant 384 : index
  %channel_groups = index.div %channels, %tile : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %channel_groups, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%input: buffer, %weight: buffer, %bias: buffer, %residual: buffer, %output: buffer) {
  %height = config.get @krea2.vae_tile_height : index
  %width = config.get @krea2.vae_tile_width : index
  %add_residual = scalar.constant true : i1
  template.apply<@krea2.vae_mid_convolution_f32>(%height, %width, %add_residual, %input, %weight, %bias, %residual, %output) : (index, index, i1, buffer, buffer, buffer, buffer, buffer)
  kernel.return
}

command.program.def public @krea2.vae_mid_norm(%block: index, %ordinal: index, %tile: i1) launch(%parameters: buffer, %input: buffer, %output: buffer) {
  %weight = command.parameter %parameters, "decoder.mid_block.resnets.{}.norm{}.gamma"[%block, %ordinal] : view<384x1x1x1xf32>
  scf.if %tile {
    kernel.launch @krea_vae_tile_mid_norm(%input, %weight, %output) : (buffer, view<384x1x1x1xf32>, buffer)
  } else {
    kernel.launch @krea_vae_mid_norm(%input, %weight, %output) : (buffer, view<384x1x1x1xf32>, buffer)
  }
  command.return
}

command.program.def public @krea2.vae_mid_convolution(%block: index, %ordinal: index, %tile: i1) launch(%parameters: buffer, %input: buffer, %output: buffer) {
  %weight = command.parameter %parameters, "decoder.mid_block.resnets.{}.conv{}.weight"[%block, %ordinal] : view<384x384x3x3x3xf32>
  %bias = command.parameter %parameters, "decoder.mid_block.resnets.{}.conv{}.bias"[%block, %ordinal] : view<384xf32>
  scf.if %tile {
    kernel.launch @krea_vae_tile_mid_convolution(%input, %weight, %bias, %output) : (buffer, view<384x384x3x3x3xf32>, view<384xf32>, buffer)
  } else {
    kernel.launch @krea_vae_mid_convolution(%input, %weight, %bias, %output) : (buffer, view<384x384x3x3x3xf32>, view<384xf32>, buffer)
  }
  command.return
}

command.program.def public @krea2.vae_mid_convolution_add(%block: index, %tile: i1) launch(%parameters: buffer, %input: buffer, %residual: buffer, %output: buffer) {
  %weight = command.parameter %parameters, "decoder.mid_block.resnets.{}.conv2.weight"[%block] : view<384x384x3x3x3xf32>
  %bias = command.parameter %parameters, "decoder.mid_block.resnets.{}.conv2.bias"[%block] : view<384xf32>
  scf.if %tile {
    kernel.launch @krea_vae_tile_mid_convolution_add(%input, %weight, %bias, %residual, %output) : (buffer, view<384x384x3x3x3xf32>, view<384xf32>, buffer, buffer)
  } else {
    kernel.launch @krea_vae_mid_convolution_add(%input, %weight, %bias, %residual, %output) : (buffer, view<384x384x3x3x3xf32>, view<384xf32>, buffer, buffer)
  }
  command.return
}

// The last convolution fuses the skip addition and may write back into input.
// Its spatial input is the separate second-normalization buffer, so original
// input reads have completed before the only original-state writer executes.
command.program.def public @krea2.vae_mid_residual(%block: index, %tile: i1) launch(%parameters: buffer, %input: buffer, %output: buffer) {
  %height, %width = scf.if %tile -> (index, index) {
    %tile_height = config.get @krea2.vae_tile_height : index
    %tile_width = config.get @krea2.vae_tile_width : index
    scf.yield %tile_height, %tile_width : index, index
  } else {
    %full_height = config.get @krea2.latent_height : index
    %full_width = config.get @krea2.latent_width : index
    scf.yield %full_height, %full_width : index, index
  }
  %pixels = index.mul %height, %width : index
  %pixel_bytes = index.constant 1536 : offset
  %bytes = index.scale %pixels, %pixel_bytes : index, offset -> offset
  %normalized = buffer.alloca<global> align(256) %bytes : buffer
  %convolved = buffer.alloca<global> align(256) %bytes : buffer
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  command.program.launch @krea2.vae_mid_norm[%block, %c1, %tile](%parameters, %input, %normalized) : [index, index, i1](buffer, buffer, buffer)
  command.program.launch @krea2.vae_mid_convolution[%block, %c1, %tile](%parameters, %normalized, %convolved) : [index, index, i1](buffer, buffer, buffer)
  command.program.launch @krea2.vae_mid_norm[%block, %c2, %tile](%parameters, %convolved, %convolved) : [index, index, i1](buffer, buffer, buffer)
  command.program.launch @krea2.vae_mid_convolution_add[%block, %tile](%parameters, %convolved, %input, %output) : [index, i1](buffer, buffer, buffer, buffer)
  command.return
}

// The first full residual consumes the native input path directly and reuses
// the caller's feature storage. Its input producers precede its in-place write.
command.program.def public @vae_input_residual() launch(%parameters: buffer, %input: buffer, %affine: buffer, %output: buffer) {
  %block = index.constant 0 : index
  %tile = scalar.constant false : i1
  command.program.launch @vae_input(%parameters, %input, %affine, %output) : (buffer, buffer, buffer, buffer)
  command.program.launch @krea2.vae_mid_residual[%block, %tile](%parameters, %output, %output) : [index, i1](buffer, buffer, buffer)
  command.return
}
