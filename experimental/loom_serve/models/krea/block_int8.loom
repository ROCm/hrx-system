template.decl @krea2.block_quantized_input(%tokens: index, %columns: index, %use_int8: i1, %input: buffer) -> (buffer, buffer)

// A projection cohort owns one rotated input and one scale per token.
// The BF16 specialization returns unused aliases and allocates no extra storage.
template.def<@krea2.block_quantized_input> @krea2_block_quantized_input(%tokens: index, %columns: index, %use_int8: i1, %input: buffer) -> (buffer, buffer) {
  %quantized, %scales = scf.if %use_int8 -> (buffer, buffer) {
    %column_bytes = index.cast %columns : index to offset
    %bytes = index.scale %tokens, %column_bytes : index, offset -> offset
    %scale_stride = index.constant 4 : offset
    %scale_bytes = index.scale %tokens, %scale_stride : index, offset -> offset
    %quantized = buffer.alloca<global> align(256) %bytes : buffer
    %scales = buffer.alloca<global> align(256) %scale_bytes : buffer
    %hidden_width = index.constant 6144 : index
    %hidden = index.cmp eq, %columns, %hidden_width : index
    scf.if %hidden {
      command.program.launch @krea2.block_quantize_6144(%input, %quantized, %scales) : (buffer, buffer, buffer)
    } else {
      command.program.launch @krea2.block_quantize_16384(%input, %quantized, %scales) : (buffer, buffer, buffer)
    }
    scf.yield %quantized, %scales : buffer, buffer
  } else {
    scf.yield %input, %input : buffer, buffer
  }
  template.return %quantized, %scales : buffer, buffer
}
