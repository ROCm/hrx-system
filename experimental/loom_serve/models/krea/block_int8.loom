kernel.def target(@block_i8_wave32) @block_linear_i8_6144_6144() {
  %rows = config.get @krea2.block_tokens : index
  %tile = index.constant 128 : index
  %rounding = index.constant 127 : index
  %padded = index.add %rows, %rounding : index
  %row_tiles = index.div %padded, %tile : index
  %output_tiles = index.constant 48 : index
  %c1 = index.constant 1 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%row_tiles, %output_tiles, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%input: buffer, %input_scales: buffer, %weight: buffer, %weight_scales: buffer, %output: buffer) {
  %rows = config.get @krea2.block_tokens : index
  %inputs = index.constant 6144 : index
  %outputs = index.constant 6144 : index
  %group_size = index.constant 8 : index
  %layout = encoding.layout.dense : encoding<layout>
  template.apply<@projection.linear_tiled_i8>(%rows, %inputs, %outputs, %group_size, %layout, %input, %input_scales, %weight, %weight_scales, %output) : (index, index, index, index, encoding<layout>, buffer, buffer, buffer, buffer, buffer)
  kernel.return
}

