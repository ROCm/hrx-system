config.decl @krea2.block_tokens : %value: index where [range(%value, 16, 65536), multiple_of(%value, 16)]

amdgpu.target<gfx11-generic> @block_i8_wave32 {subgroup_size = 32}

template.decl @quantization.convrot256_i8(%rows: index, %columns: index, %input: buffer, %output: buffer, %scales: buffer)

template.decl @projection.linear_tiled_i8(%rows: index, %inputs: index, %outputs: index, %row_tile_group_size: index, %layout: encoding<layout>, %input: buffer, %input_scales: buffer, %weight: buffer, %weight_scales: buffer, %output: buffer)

// The input rotation is shared by every projection consuming the same rows.
// Source scheduling retains the unrotated BF16 input independently for LoRA.
kernel.def target(@block_i8_wave32) @block_quantize_6144() {
  %rows = config.get @krea2.block_tokens : index
  %c1 = index.constant 1 : index
  %threads = index.constant 128 : index
  kernel.launch.config workgroups(%rows, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%input: buffer, %output: buffer, %scales: buffer) {
  %rows = config.get @krea2.block_tokens : index
  %columns = index.constant 6144 : index
  template.apply<@quantization.convrot256_i8>(%rows, %columns, %input, %output, %scales) : (index, index, buffer, buffer, buffer)
  kernel.return
}

command.program.def public @krea2.block_quantize_6144() launch(%input: buffer, %output: buffer, %scales: buffer) {
  kernel.launch @block_quantize_6144(%input, %output, %scales) : (buffer, buffer, buffer)
  command.return
}

