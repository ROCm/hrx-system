// expected an object containing at most one int8_convrot_checkpoint string and one positive workspace_limit_bytes integer
global.rodata.def @options_error = bytes("657870656374656420616e206f626a65637420636f6e7461696e696e67206174206d6f7374206f6e6520696e74385f636f6e76726f745f636865636b706f696e7420737472696e6720616e64206f6e6520706f73697469766520776f726b73706163655f6c696d69745f627974657320696e7465676572")

func.def @check_options(%valid: i1) {
  %condition = scalar.extui %valid : i1 to i32
  %error = global.load @options_error : buffer
  func.call @require(%condition, %error) : (i32, buffer)
  func.return
}

func.def @option_key_equal(%decoded: buffer, %decoded_length: i64, %expected: buffer) -> (i1) {
  %expected_bytes = buffer.length %expected
  %expected_length = index.cast %expected_bytes : offset to i64
  %right_length = scalar.cmpi eq, %decoded_length, %expected_length : i64
  %equal = scf.if %right_length -> (i1) {
    %origin = index.constant 0 : offset
    %order = buffer.compare %decoded[%origin], %expected[%origin], %expected_bytes
    %zero32 = scalar.constant 0 : i32
    %matches = scalar.cmpi eq, %order, %zero32 : i32
    scf.yield %matches : i1
  } else {
    %false = scalar.constant false : i1
    scf.yield %false : i1
  }
  func.return %equal : i1
}

func.def @parse_options(%options: buffer) -> (buffer, i64) {
  %c0 = scalar.constant 0 : i64
  %c2 = scalar.constant 2 : i64
  %object_type = scalar.constant 2 : i32
  %fields, %type, %count = func.call @members(%options) : (buffer) -> (buffer, i32, i64)
  %object = scalar.cmpi eq, %type, %object_type : i32
  %bounded = scalar.cmpi ule, %count, %c2 : i64
  %valid = scalar.andi %object, %bounded : i1
  func.call @check_options(%valid) : (i1)
  %bounded_count = scalar.assume %count [range(%count, 0, 2)] : i64
  %extent = index.cast %bounded_count : i64 to index
  %origin = index.constant 0 : offset
  %records = buffer.view %fields[%origin] : buffer -> view<[%extent]x5xi64>
  %source_length = buffer.length %options
  %decoded = buffer.alloca<private> align(1) %source_length : buffer
  %empty = global.load @empty : buffer
  %false = scalar.constant false : i1
  %true = scalar.constant true : i1
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %checkpoint, %workspace, %checkpoint_seen, %workspace_seen = scf.for %i = [%begin to %extent step %step](%current_checkpoint = %empty : buffer, %current_workspace = %c0 : i64, %current_checkpoint_seen = %false : i1, %current_workspace_seen = %false : i1) -> (buffer, i64, i1, i1) {
    %key_begin = view.load %records[%i, 0] : view<[%extent]x5xi64> -> i64
    %key_length = view.load %records[%i, 1] : view<[%extent]x5xi64> -> i64
    %value_begin = view.load %records[%i, 2] : view<[%extent]x5xi64> -> i64
    %value_length = view.load %records[%i, 3] : view<[%extent]x5xi64> -> i64
    %value_type = view.load %records[%i, 4] : view<[%extent]x5xi64> -> i64
    %decoded_key_length = func.call @unescape(%options, %key_begin, %key_length, %decoded, %c0) : (buffer, i64, i64, buffer, i64) -> (i64)
    %int8_key = global.load @int8_option : buffer
    %workspace_key = global.load @workspace_option : buffer
    %is_int8 = func.call @option_key_equal(%decoded, %decoded_key_length, %int8_key) : (buffer, i64, buffer) -> (i1)
    %is_workspace = func.call @option_key_equal(%decoded, %decoded_key_length, %workspace_key) : (buffer, i64, buffer) -> (i1)
    %known = scalar.ori %is_int8, %is_workspace : i1
    func.call @check_options(%known) : (i1)
    %next_checkpoint, %next_workspace, %next_checkpoint_seen, %next_workspace_seen = scf.if %is_int8 -> (buffer, i64, i1, i1) {
      %not_seen = scalar.cmpi eq, %current_checkpoint_seen, %false : i1
      %string = scalar.cmpi eq, %value_type, %c0 : i64
      %nonempty = scalar.cmpi ugt, %value_length, %c0 : i64
      %typed = scalar.andi %string, %nonempty : i1
      %valid_checkpoint = scalar.andi %not_seen, %typed : i1
      func.call @check_options(%valid_checkpoint) : (i1)
      %decoded_length = func.call @unescape(%options, %value_begin, %value_length, %decoded, %c0) : (buffer, i64, i64, buffer, i64) -> (i64)
      %positive_length = scalar.assume %decoded_length [range(%decoded_length, 1, 9223372036854775807)] : i64
      %bytes = index.cast %positive_length : i64 to offset
      %path = buffer.alloca<private> align(1) %bytes : buffer
      buffer.copy %decoded[%origin], %path[%origin], %bytes
      scf.yield %path, %current_workspace, %true, %current_workspace_seen : buffer, i64, i1, i1
    } else {
      %not_seen = scalar.cmpi eq, %current_workspace_seen, %false : i1
      %number_type = scalar.constant 1 : i64
      %number = scalar.cmpi eq, %value_type, %number_type : i64
      %typed = scalar.andi %not_seen, %number : i1
      func.call @check_options(%typed) : (i1)
      %value = func.call @parse_i64(%options, %value_begin, %value_length) : (buffer, i64, i64) -> (i64)
      %positive = scalar.cmpi ugt, %value, %c0 : i64
      func.call @check_options(%positive) : (i1)
      %workspace_value = scalar.assume %value [range(%value, 1, 9223372036854775807)] : i64
      scf.yield %current_checkpoint, %workspace_value, %current_checkpoint_seen, %true : buffer, i64, i1, i1
    }
    scf.yield %next_checkpoint, %next_workspace, %next_checkpoint_seen, %next_workspace_seen : buffer, i64, i1, i1
  }
  func.return %checkpoint, %workspace : buffer, i64
}

func.def @declare_stage(%height: i64, %width: i64, %text: i64, %tile_height: i64, %tile_width: i64, %workspace_limit: i64, %directory: buffer, %adapter: buffer, %adapted: i1, %int8_checkpoint: buffer) {
  %root = scf.if %adapted -> (buffer) {
    %value = global.load @root_adapted : buffer
    scf.yield %value : buffer
  } else {
    %value = global.load @root_base : buffer
    scf.yield %value : buffer
  }
  %stage = func.call @stage(%root, %text) : (buffer, i64) -> (i32)
  %zero64 = scalar.constant 0 : i64
  %has_workspace_limit = scalar.cmpi ne, %workspace_limit, %zero64 : i64
  scf.if %has_workspace_limit {
    func.call @workspace_limit(%stage, %workspace_limit) : (i32, i64)
  }
  %int8_length = buffer.length %int8_checkpoint
  %empty_length = index.constant 0 : offset
  %is_int8 = index.cmp ne, %int8_length, %empty_length : offset
  %int8_flag = scalar.extui %is_int8 : i1 to i64
  %int8_key = global.load @int8_config : buffer
  func.call @config_i64(%stage, %int8_key, %int8_flag) : (i32, buffer, i64)
  %c8 = scalar.constant 8 : i64
  %c16 = scalar.constant 16 : i64
  %rows = scalar.divui %height, %c16 : i64
  %columns = scalar.divui %width, %c16 : i64
  %images = scalar.muli %rows, %columns : i64
  %blocks = scalar.addi %images, %text : i64
  %latent_height = scalar.divui %height, %c8 : i64
  %latent_width = scalar.divui %width, %c8 : i64
  %key_blocks = global.load @block_tokens : buffer
  %key_images = global.load @image_tokens : buffer
  %key_text = global.load @text_tokens : buffer
  %key_steps = global.load @time_count : buffer
  %key_height = global.load @latent_height : buffer
  %key_width = global.load @latent_width : buffer
  %key_tile_height = global.load @vae_tile_height : buffer
  %key_tile_width = global.load @vae_tile_width : buffer
  func.call @config_i64(%stage, %key_blocks, %blocks) : (i32, buffer, i64)
  func.call @config_i64(%stage, %key_images, %images) : (i32, buffer, i64)
  func.call @config_i64(%stage, %key_text, %text) : (i32, buffer, i64)
  func.call @config_i64(%stage, %key_steps, %c8) : (i32, buffer, i64)
  func.call @config_i64(%stage, %key_height, %latent_height) : (i32, buffer, i64)
  func.call @config_i64(%stage, %key_width, %latent_width) : (i32, buffer, i64)
  func.call @config_i64(%stage, %key_tile_height, %tile_height) : (i32, buffer, i64)
  func.call @config_i64(%stage, %key_tile_width, %tile_width) : (i32, buffer, i64)
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %encoder = global.load @encoder : buffer
  %transformer = global.load @transformer : buffer
  %policy = global.load @policy : buffer
  func.call @parameter(%stage, %c0, %directory, %encoder, %policy) : (i32, i32, buffer, buffer, buffer)
  scf.if %is_int8 {
    %empty = global.load @empty : buffer
    func.call @parameter(%stage, %c1, %int8_checkpoint, %empty, %policy) : (i32, i32, buffer, buffer, buffer)
  } else {
    func.call @parameter(%stage, %c1, %directory, %transformer, %policy) : (i32, i32, buffer, buffer, buffer)
  }
  %vae_binding = scf.if %adapted -> (i32) {
    %empty = global.load @empty : buffer
    func.call @parameter(%stage, %c2, %adapter, %empty, %policy) : (i32, i32, buffer, buffer, buffer)
    %c3 = scalar.constant 3 : i32
    scf.yield %c3 : i32
  } else {
    scf.yield %c2 : i32
  }
  %vae = global.load @vae : buffer
  func.call @parameter(%stage, %vae_binding, %directory, %vae, %policy) : (i32, i32, buffer, buffer, buffer)
  func.return
}

// Stage zero is the maximum prompt extent. The smaller command preserves the
// live-key partitions used by the attention kernels when the maximum is a
// multiple of 64; other valid extents retain only their full-size command.
func.def public @prepare(%height: i64, %width: i64, %text: i64, %directory: buffer, %adapter: buffer, %options: buffer) -> (i64, buffer, buffer, buffer) {
  %zero_geometry = scalar.constant 0 : i64
  %sixteen_geometry = scalar.constant 16 : i64
  %pixel_limit = scalar.constant 8192 : i64
  %token_limit = scalar.constant 65536 : i64
  %height_positive = scalar.cmpi ugt, %height, %zero_geometry : i64
  %width_positive = scalar.cmpi ugt, %width, %zero_geometry : i64
  %text_positive = scalar.cmpi ugt, %text, %zero_geometry : i64
  %height_bounded = scalar.cmpi ule, %height, %pixel_limit : i64
  %width_bounded = scalar.cmpi ule, %width, %pixel_limit : i64
  %text_bounded = scalar.cmpi ule, %text, %token_limit : i64
  %height_rem = scalar.remui %height, %sixteen_geometry : i64
  %width_rem = scalar.remui %width, %sixteen_geometry : i64
  %text_rem = scalar.remui %text, %sixteen_geometry : i64
  %height_aligned = scalar.cmpi eq, %height_rem, %zero_geometry : i64
  %width_aligned = scalar.cmpi eq, %width_rem, %zero_geometry : i64
  %text_aligned = scalar.cmpi eq, %text_rem, %zero_geometry : i64
  %h0 = scalar.andi %height_positive, %height_bounded : i1
  %w0 = scalar.andi %width_positive, %width_bounded : i1
  %t0 = scalar.andi %text_positive, %text_bounded : i1
  %h = scalar.andi %h0, %height_aligned : i1
  %w = scalar.andi %w0, %width_aligned : i1
  %t = scalar.andi %t0, %text_aligned : i1
  %hw = scalar.andi %h, %w : i1
  %valid_extents = scalar.andi %hw, %t : i1
  %valid_extents32 = scalar.extui %valid_extents : i1 to i32
  %diagnostic = global.load @geometry_error : buffer
  func.call @require(%valid_extents32, %diagnostic) : (i32, buffer)
  %rows_geometry = scalar.divui %height, %sixteen_geometry : i64
  %columns_geometry = scalar.divui %width, %sixteen_geometry : i64
  %patches = scalar.muli %rows_geometry, %columns_geometry : i64
  %combined = scalar.addi %patches, %text : i64
  %patch_rem = scalar.remui %patches, %sixteen_geometry : i64
  %patch_aligned = scalar.cmpi eq, %patch_rem, %zero_geometry : i64
  %patch_positive = scalar.cmpi uge, %patches, %sixteen_geometry : i64
  %combined_bounded = scalar.cmpi ule, %combined, %token_limit : i64
  %patch_valid = scalar.andi %patch_aligned, %patch_positive : i1
  %valid_tokens = scalar.andi %patch_valid, %combined_bounded : i1
  %valid_tokens32 = scalar.extui %valid_tokens : i1 to i32
  func.call @require(%valid_tokens32, %diagnostic) : (i32, buffer)
  %int8_checkpoint, %workspace_limit = func.call @parse_options(%options) : (buffer) -> (buffer, i64)
  %length = buffer.length %adapter
  %c0_2 = index.constant 0 : offset
  %adapted = index.cmp ne, %length, %c0_2 : offset
  %c8_geometry = scalar.constant 8 : i64
  %latent_height = scalar.divui %height, %c8_geometry : i64
  %latent_width = scalar.divui %width, %c8_geometry : i64
  %tile_height, %tile_width = func.call @krea2.vae_workspace_tile(%latent_height, %latent_width, %workspace_limit) : (i64, i64, i64) -> (i64, i64)
  func.call @declare_stage(%height, %width, %text, %tile_height, %tile_width, %workspace_limit, %directory, %adapter, %adapted, %int8_checkpoint) : (i64, i64, i64, i64, i64, i64, buffer, buffer, i1, buffer)
  %c0 = scalar.constant 0 : i64
  %alignment = scalar.constant 64 : i64
  %small = scalar.constant 128 : i64
  %larger = scalar.cmpi ugt, %text, %small : i64
  %remainder = scalar.remui %text, %alignment : i64
  %aligned = scalar.cmpi eq, %remainder, %c0 : i64
  %retain_small = scalar.andi %larger, %aligned : i1
  scf.if %retain_small {
    func.call @declare_stage(%height, %width, %small, %tile_height, %tile_width, %workspace_limit, %directory, %adapter, %adapted, %int8_checkpoint) : (i64, i64, i64, i64, i64, i64, buffer, buffer, i1, buffer)
  }
  %framing = scalar.constant 34 : i64
  %c4 = scalar.constant 4 : i64
  %header = scalar.constant 16 : i64
  %ids = scalar.addi %text, %framing : i64
  %id_bytes = scalar.muli %ids, %c4 : i64
  %capacity = scalar.addi %id_bytes, %header : i64
  %tokenizer = global.load @tokenizer : buffer
  %identifier = global.load @identifier : buffer
  %state_bytes = index.constant 8 : offset
  %state = buffer.alloca<private> align(8) %state_bytes : buffer
  %state_view = buffer.view %state[%c0_2] : buffer -> view<1xi64>
  %adapted64 = scalar.extui %adapted : i1 to i64
  view.store %adapted64, %state_view[0] : i64, view<1xi64>
  func.return %capacity, %tokenizer, %identifier, %state : i64, buffer, buffer, buffer
}
