// Cold bootstrap declares commands, parameter domains and request metadata.
// The runner compiles the configurations and streams each shared domain once.
func.decl import("input") @require(%condition: i32, %diagnostic: buffer)
func.decl import("prepare") @stage(%root: buffer, %tag: i64) -> (i32)
func.decl import("prepare") @config_i64(%stage: i32, %key: buffer, %value: i64)
func.decl import("prepare") @parameter(%stage: i32, %binding: i32, %directory: buffer, %path: buffer, %policy: buffer)

// tokenizer/tokenizer.json
global.rodata.def @tokenizer = bytes("746f6b656e697a65722f746f6b656e697a65722e6a736f6e")
// krea2-turbo
global.rodata.def @identifier = bytes("6b726561322d747572626f")
// expected supported 16-aligned pixel/text extents and at most 65536 combined tokens
global.rodata.def @geometry_error = bytes("657870656374656420737570706f727465642031362d616c69676e656420706978656c2f7465787420657874656e747320616e64206174206d6f737420363535333620636f6d62696e656420746f6b656e73")

// generate_image
global.rodata.def @root_base = bytes("67656e65726174655f696d616765")
// generate_image_adapted
global.rodata.def @root_adapted = bytes("67656e65726174655f696d6167655f61646170746564")
// krea2.block_tokens
global.rodata.def @block_tokens = bytes("6b726561322e626c6f636b5f746f6b656e73")
// krea2.image_tokens
global.rodata.def @image_tokens = bytes("6b726561322e696d6167655f746f6b656e73")
// krea2.text_tokens
global.rodata.def @text_tokens = bytes("6b726561322e746578745f746f6b656e73")
// krea2.time_count
global.rodata.def @time_count = bytes("6b726561322e74696d655f636f756e74")
// krea2.latent_height
global.rodata.def @latent_height = bytes("6b726561322e6c6174656e745f686569676874")
// krea2.latent_width
global.rodata.def @latent_width = bytes("6b726561322e6c6174656e745f7769647468")
// text_encoder/model.safetensors
global.rodata.def @encoder = bytes("746578745f656e636f6465722f6d6f64656c2e7361666574656e736f7273")
// turbo.safetensors
global.rodata.def @transformer = bytes("747572626f2e7361666574656e736f7273")
// vae/diffusion_pytorch_model.safetensors
global.rodata.def @vae = bytes("7661652f646966667573696f6e5f7079746f7263685f6d6f64656c2e7361666574656e736f7273")
// weights.loom
global.rodata.def @policy = bytes("776569676874732e6c6f6f6d")
// (empty path)
global.rodata.def @empty = bytes("")

func.def @declare_stage(%height: i64, %width: i64, %text: i64, %directory: buffer, %adapter: buffer, %adapted: i1) {
  %root = scf.if %adapted -> (buffer) {
    %value = global.load @root_adapted : buffer
    scf.yield %value : buffer
  } else {
    %value = global.load @root_base : buffer
    scf.yield %value : buffer
  }
  %stage = func.call @stage(%root, %text) : (buffer, i64) -> (i32)
  %eight = scalar.constant 8 : i64
  %sixteen = scalar.constant 16 : i64
  %rows = scalar.divui %height, %sixteen : i64
  %columns = scalar.divui %width, %sixteen : i64
  %images = scalar.muli %rows, %columns : i64
  %blocks = scalar.addi %images, %text : i64
  %latent_height = scalar.divui %height, %eight : i64
  %latent_width = scalar.divui %width, %eight : i64
  %key_blocks = global.load @block_tokens : buffer
  %key_images = global.load @image_tokens : buffer
  %key_text = global.load @text_tokens : buffer
  %key_steps = global.load @time_count : buffer
  %key_height = global.load @latent_height : buffer
  %key_width = global.load @latent_width : buffer
  func.call @config_i64(%stage, %key_blocks, %blocks) : (i32, buffer, i64) -> ()
  func.call @config_i64(%stage, %key_images, %images) : (i32, buffer, i64) -> ()
  func.call @config_i64(%stage, %key_text, %text) : (i32, buffer, i64) -> ()
  func.call @config_i64(%stage, %key_steps, %eight) : (i32, buffer, i64) -> ()
  func.call @config_i64(%stage, %key_height, %latent_height) : (i32, buffer, i64) -> ()
  func.call @config_i64(%stage, %key_width, %latent_width) : (i32, buffer, i64) -> ()
  %zero = scalar.constant 0 : i32
  %one = scalar.constant 1 : i32
  %two = scalar.constant 2 : i32
  %encoder = global.load @encoder : buffer
  %transformer = global.load @transformer : buffer
  %policy = global.load @policy : buffer
  func.call @parameter(%stage, %zero, %directory, %encoder, %policy) : (i32, i32, buffer, buffer, buffer) -> ()
  func.call @parameter(%stage, %one, %directory, %transformer, %policy) : (i32, i32, buffer, buffer, buffer) -> ()
  %vae_binding = scf.if %adapted -> (i32) {
    %empty = global.load @empty : buffer
    func.call @parameter(%stage, %two, %adapter, %empty, %policy) : (i32, i32, buffer, buffer, buffer) -> ()
    %three = scalar.constant 3 : i32
    scf.yield %three : i32
  } else {
    scf.yield %two : i32
  }
  %vae = global.load @vae : buffer
  func.call @parameter(%stage, %vae_binding, %directory, %vae, %policy) : (i32, i32, buffer, buffer, buffer) -> ()
  func.return
}

// Stage zero is the maximum prompt extent. The smaller command preserves the
// live-key partitions used by the attention kernels when the maximum is a
// multiple of 64; other valid extents retain only their full-size command.
func.def public @prepare(%height: i64, %width: i64, %text: i64, %directory: buffer, %adapter: buffer) -> (i64, buffer, buffer, buffer) {
  %zero_geometry = scalar.constant 0 : i64
  %sixteen_geometry = scalar.constant 16 : i64
  %pixel_limit = scalar.constant 8192 : i64
  %token_limit = scalar.constant 65536 : i64
  %height_positive = scalar.cmpi ugt, %height, %zero_geometry : i64
  %width_positive = scalar.cmpi ugt, %width, %zero_geometry : i64
  %text_positive = scalar.cmpi ugt, %text, %zero_geometry : i64
  %height_bounded = scalar.cmpi ule, %height, %pixel_limit : i64
  %width_bounded = scalar.cmpi ule, %width, %pixel_limit : i64
  %text_bounded = scalar.cmpi ule, %text, %token_limit : i64
  %height_rem = scalar.remui %height, %sixteen_geometry : i64
  %width_rem = scalar.remui %width, %sixteen_geometry : i64
  %text_rem = scalar.remui %text, %sixteen_geometry : i64
  %height_aligned = scalar.cmpi eq, %height_rem, %zero_geometry : i64
  %width_aligned = scalar.cmpi eq, %width_rem, %zero_geometry : i64
  %text_aligned = scalar.cmpi eq, %text_rem, %zero_geometry : i64
  %h0 = scalar.andi %height_positive, %height_bounded : i1
  %w0 = scalar.andi %width_positive, %width_bounded : i1
  %t0 = scalar.andi %text_positive, %text_bounded : i1
  %h = scalar.andi %h0, %height_aligned : i1
  %w = scalar.andi %w0, %width_aligned : i1
  %t = scalar.andi %t0, %text_aligned : i1
  %hw = scalar.andi %h, %w : i1
  %valid_extents = scalar.andi %hw, %t : i1
  %valid_extents32 = scalar.extui %valid_extents : i1 to i32
  %diagnostic = global.load @geometry_error : buffer
  func.call @require(%valid_extents32, %diagnostic) : (i32, buffer) -> ()
  %rows_geometry = scalar.divui %height, %sixteen_geometry : i64
  %columns_geometry = scalar.divui %width, %sixteen_geometry : i64
  %patches = scalar.muli %rows_geometry, %columns_geometry : i64
  %combined = scalar.addi %patches, %text : i64
  %patch_rem = scalar.remui %patches, %sixteen_geometry : i64
  %patch_aligned = scalar.cmpi eq, %patch_rem, %zero_geometry : i64
  %patch_positive = scalar.cmpi uge, %patches, %sixteen_geometry : i64
  %combined_bounded = scalar.cmpi ule, %combined, %token_limit : i64
  %patch_valid = scalar.andi %patch_aligned, %patch_positive : i1
  %valid_tokens = scalar.andi %patch_valid, %combined_bounded : i1
  %valid_tokens32 = scalar.extui %valid_tokens : i1 to i32
  func.call @require(%valid_tokens32, %diagnostic) : (i32, buffer) -> ()
  %length = buffer.length %adapter
  %zero_offset = index.constant 0 : offset
  %adapted = index.cmp ne, %length, %zero_offset : offset
  func.call @declare_stage(%height, %width, %text, %directory, %adapter, %adapted) : (i64, i64, i64, buffer, buffer, i1) -> ()
  %zero = scalar.constant 0 : i64
  %alignment = scalar.constant 64 : i64
  %small = scalar.constant 128 : i64
  %larger = scalar.cmpi ugt, %text, %small : i64
  %remainder = scalar.remui %text, %alignment : i64
  %aligned = scalar.cmpi eq, %remainder, %zero : i64
  %retain_small = scalar.andi %larger, %aligned : i1
  scf.if %retain_small {
    func.call @declare_stage(%height, %width, %small, %directory, %adapter, %adapted) : (i64, i64, i64, buffer, buffer, i1) -> ()
    scf.yield
  }
  %framing = scalar.constant 34 : i64
  %four = scalar.constant 4 : i64
  %header = scalar.constant 16 : i64
  %ids = scalar.addi %text, %framing : i64
  %id_bytes = scalar.muli %ids, %four : i64
  %capacity = scalar.addi %id_bytes, %header : i64
  %tokenizer = global.load @tokenizer : buffer
  %identifier = global.load @identifier : buffer
  %state_bytes = index.constant 8 : offset
  %state = buffer.alloca<private> align(8) %state_bytes : buffer
  %state_view = buffer.view %state[%zero_offset] : buffer -> view<1xi64>
  %adapted64 = scalar.extui %adapted : i1 to i64
  view.store %adapted64, %state_view[0] : i64, view<1xi64>
  func.return %capacity, %tokenizer, %identifier, %state : i64, buffer, buffer, buffer
}
