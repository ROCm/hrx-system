// Cold bootstrap declares commands, parameter domains and request metadata.
// The runner compiles the configurations and streams each shared domain once.
func.decl import("input") @require(%condition: i32, %diagnostic: buffer)

func.decl import("prepare") @stage(%root: buffer, %tag: i64) -> (i32)

func.decl import("prepare") @config_i64(%stage: i32, %key: buffer, %value: i64)

func.decl import("prepare") @workspace_limit(%stage: i32, %bytes: i64)

func.decl import("prepare") @parameter(%stage: i32, %binding: i32, %directory: buffer, %path: buffer, %policy: buffer)

// Chooses the exact decoder geometry for one source-owned workspace policy.
// Zero leaves the throughput path untiled. A positive limit below the
// conservative untiled decoder bound selects the smallest physical tile that
// covers the axis in at most two tiles with the required 30-pixel overlap.
func.def @krea2.vae_workspace_tile(%height: i64, %width: i64, %limit: i64) -> (i64, i64) {
  %c0 = scalar.constant 0 : i64
  %decoder_bytes_per_pixel = scalar.constant 98304 : i64
  %pixels = scalar.muli %height, %width : i64
  %untiled_bytes = scalar.muli %pixels, %decoder_bytes_per_pixel : i64
  %constrained = scalar.cmpi ne, %limit, %c0 : i64
  %below_untiled = scalar.cmpi ult, %limit, %untiled_bytes : i64
  %tiled = scalar.andi %constrained, %below_untiled : i1
  %tiled_height = func.call @krea2.vae_workspace_tile_axis(%height) : (i64) -> (i64)
  %tiled_width = func.call @krea2.vae_workspace_tile_axis(%width) : (i64) -> (i64)
  %selected_height = scf.select %tiled, %tiled_height, %height : i64
  %selected_width = scf.select %tiled, %tiled_width, %width : i64
  func.return %selected_height, %selected_width : i64, i64
}

func.def @krea2.vae_workspace_tile_axis(%extent: i64) -> (i64) {
  %overlap = scalar.constant 30 : i64
  %c1 = scalar.constant 1 : i64
  %c2 = scalar.constant 2 : i64
  %with_overlap = scalar.addi %extent, %overlap : i64
  %half = scalar.divui %with_overlap, %c2 : i64
  %rounding = scalar.addi %half, %c1 : i64
  %rounded_half = scalar.divui %rounding, %c2 : i64
  %even = scalar.muli %rounded_half, %c2 : i64
  %tile = scalar.minui %even, %extent : i64
  func.return %tile : i64
}

