command.program.def public @qualify.fusion_layerwise_norm1() launch(%parameters: buffer, %input: buffer, %output: buffer) {
  %layer = config.get @qualify.fusion_layer : index
  command.program.launch @krea2.fusion_layerwise_norm1[%layer](%parameters, %input, %output) : [index](buffer, buffer, buffer)
  command.return
}

