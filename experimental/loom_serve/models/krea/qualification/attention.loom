config.decl @krea2.block_tokens : %value: index where [range(%value, 16, 65536), mul(%value, 16)]
amdgpu.target<gfx11-generic> @qualification_attention_wave64 {subgroup_size = 64}
template.decl @attention.store_128_bf16(%tokens: index, %heads: index, %values: vector<8xbf16>, %output: buffer)
template.decl @attention.gate_128_bf16(%tokens: index, %heads: index, %values: vector<8xbf16>, %gate: buffer) -> (vector<8xbf16>)

// Observe the unchanged native gate on an already rounded context. The
// coordinates are the inverse of attention.store_128_bf16, not a new gate.
kernel.def target(@qualification_attention_wave64) @qualify_block_attention_gate() {
  %tokens = config.get @krea2.block_tokens : index
  %tile = index.constant 16 : index
  %groups = index.div %tokens, %tile : index
  %heads = index.constant 48 : index
  %unit = index.constant 1 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%groups, %heads, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%context: buffer, %gate: buffer, %output: buffer) {
  %tokens = config.get @krea2.block_tokens : index
  %origin = index.constant 0 : offset
  %unit = index.constant 1 : index
  %pair = index.constant 2 : index
  %triple = index.constant 3 : index
  %rows = index.constant 4 : index
  %tile = index.constant 16 : index
  %head_width = index.constant 128 : index
  %heads = index.constant 48 : index
  %query_tile = kernel.workgroup.id<x> : index
  %head = kernel.workgroup.id<y> : index
  %subgroup = kernel.subgroup.id : index
  %lane = kernel.subgroup.lane.id : index
  %tile_row = index.mul %query_tile, %tile : index
  %row0 = index.madd %subgroup, %rows, %tile_row : index
  %row1 = index.add %row0, %unit : index
  %row2 = index.add %row0, %pair : index
  %row3 = index.add %row0, %triple : index
  %head_column = index.mul %head, %head_width : index
  %column = index.madd %lane, %pair, %head_column : index
  %view = buffer.view %context[%origin] : buffer -> view<[%tokens]x6144xbf16>
  %value0 = vector.load %view[%row0, %column] : view<[%tokens]x6144xbf16> -> vector<2xbf16>
  %value1 = vector.load %view[%row1, %column] : view<[%tokens]x6144xbf16> -> vector<2xbf16>
  %value2 = vector.load %view[%row2, %column] : view<[%tokens]x6144xbf16> -> vector<2xbf16>
  %value3 = vector.load %view[%row3, %column] : view<[%tokens]x6144xbf16> -> vector<2xbf16>
  %values = vector.concat<0> %value0, %value1, %value2, %value3 : vector<2xbf16>, vector<2xbf16>, vector<2xbf16>, vector<2xbf16> -> vector<8xbf16>
  %gated = template.apply<@attention.gate_128_bf16>(%tokens, %heads, %values, %gate) : (index, index, vector<8xbf16>, buffer) -> (vector<8xbf16>)
  template.apply<@attention.store_128_bf16>(%tokens, %heads, %gated, %output) : (index, index, vector<8xbf16>, buffer)
  kernel.return
}

command.program.def public @qualify.block_attention_gate() launch(%context: buffer, %gate: buffer, %output: buffer) {
  %tokens = config.get @krea2.block_tokens : index
  %origin = index.constant 0 : offset
  %context_view = buffer.view %context[%origin] : buffer -> view<[%tokens]x6144xbf16>
  %gate_view = buffer.view %gate[%origin] : buffer -> view<[%tokens]x6144xbf16>
  %output_view = buffer.view %output[%origin] : buffer -> view<[%tokens]x6144xbf16>
  kernel.launch @qualify_block_attention_gate(%context_view, %gate_view, %output_view) : (view<[%tokens]x6144xbf16>, view<[%tokens]x6144xbf16>, view<[%tokens]x6144xbf16>)
  command.return
}
