command.program.def public @krea2.fusion_layerwise_norm1(%layer: index) launch(%parameters: buffer, %input: buffer, %output: buffer) {
  %weight = command.parameter %parameters, "txtfusion.layerwise_blocks.{}.prenorm.scale"[%layer] : view<2560xf32>
  kernel.launch @fusion_layerwise_norm(%input, %weight, %output) : (buffer, view<2560xf32>, buffer)
  command.return
}

