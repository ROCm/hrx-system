command.program.def public @krea2.fusion_layerwise_query(%layer: index, %adapted: i1) launch(%parameters: buffer, %adapter: buffer, %input: buffer, %strength: buffer, %output: buffer) {
  %weight = command.parameter %parameters, "txtfusion.layerwise_blocks.{}.attn.wq.weight"[%layer] : view<2560x2560xbf16>
  scf.if %adapted {
    %texts = config.get @krea2.text_tokens : index
    %layers = index.constant 12 : index
    %rows = index.mul %texts, %layers : index
    %rank_stride = index.constant 64 : offset
    %rank_bytes = index.scale %rows, %rank_stride : index, offset -> offset
    %low = buffer.alloca<global> align(256) %rank_bytes : buffer
    %down = command.parameter %adapter, "transformer.text_fusion.layerwise_blocks.{}.attn.to_q.lora_A.weight"[%layer] : view<32x2560xf32>
    %up = command.parameter %adapter, "transformer.text_fusion.layerwise_blocks.{}.attn.to_q.lora_B.weight"[%layer] : view<2560x32xf32>
    command.concurrent {
      kernel.launch @fusion_layerwise_linear_2560_2560(%input, %weight, %output) : (buffer, view<2560x2560xbf16>, buffer)
      kernel.launch @fusion_layerwise_linear_2560_32(%input, %down, %low) : (buffer, view<32x2560xf32>, buffer)
    }
    kernel.launch @fusion_layerwise_adapter_add_32_2560(%low, %up, %strength, %output, %output) : (buffer, view<2560x32xf32>, buffer, buffer, buffer)
    scf.yield
  } else {
    kernel.launch @fusion_layerwise_linear_2560_2560(%input, %weight, %output) : (buffer, view<2560x2560xbf16>, buffer)
    scf.yield
  }
  command.return
}

