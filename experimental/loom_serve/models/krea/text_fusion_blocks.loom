  command.return
}

// Source-owned query/key and feed-forward gate storage advance in place.
// The final residual may replace input: its last read precedes the FFN.
// Parameter domains remain immutable, including when the adapter is active.
command.program.def public @krea2.fusion_layerwise_block(%layer: index, %adapted: i1) launch(%parameters: buffer, %adapter: buffer, %input: buffer, %strength: buffer, %output: buffer) {
  %texts = config.get @krea2.text_tokens : index
  %layers = index.constant 12 : index
  %rows = index.mul %texts, %layers : index
  %hidden_stride = index.constant 5120 : offset
  %feed_forward_stride = index.constant 13824 : offset
  %hidden_bytes = index.scale %rows, %hidden_stride : index, offset -> offset
  %feed_forward_bytes = index.scale %rows, %feed_forward_stride : index, offset -> offset
  %normalized = buffer.alloca<global> align(256) %hidden_bytes : buffer
  command.program.launch @krea2.fusion_layerwise_norm1[%layer](%parameters, %input, %normalized) : [index](buffer, buffer, buffer)
  %query = buffer.alloca<global> align(256) %hidden_bytes : buffer
  %key = buffer.alloca<global> align(256) %hidden_bytes : buffer
  %value = buffer.alloca<global> align(256) %hidden_bytes : buffer
  %gate = buffer.alloca<global> align(256) %hidden_bytes : buffer
  command.concurrent {
    command.program.launch @krea2.fusion_layerwise_query[%layer, %adapted](%parameters, %adapter, %normalized, %strength, %query) : [index, i1](buffer, buffer, buffer, buffer, buffer)
    command.program.launch @krea2.fusion_layerwise_key[%layer, %adapted](%parameters, %adapter, %normalized, %strength, %key) : [index, i1](buffer, buffer, buffer, buffer, buffer)
    command.program.launch @krea2.fusion_layerwise_value[%layer, %adapted](%parameters, %adapter, %normalized, %strength, %value) : [index, i1](buffer, buffer, buffer, buffer, buffer)
    command.program.launch @krea2.fusion_layerwise_gate[%layer, %adapted](%parameters, %adapter, %normalized, %strength, %gate) : [index, i1](buffer, buffer, buffer, buffer, buffer)
  }
  command.concurrent {
    command.program.launch @krea2.fusion_layerwise_query_norm[%layer](%parameters, %query, %query) : [index](buffer, buffer, buffer)
    command.program.launch @krea2.fusion_layerwise_key_norm[%layer](%parameters, %key, %key) : [index](buffer, buffer, buffer)
  }
  %context = buffer.alloca<global> align(256) %hidden_bytes : buffer
  command.program.launch @krea2.fusion_layerwise_attention_context(%query, %key, %value, %gate, %context) : (buffer, buffer, buffer, buffer, buffer)
  %attention_output = buffer.alloca<global> align(256) %hidden_bytes : buffer
  command.program.launch @krea2.fusion_layerwise_attention_output[%layer, %adapted](%parameters, %adapter, %context, %strength, %attention_output) : [index, i1](buffer, buffer, buffer, buffer, buffer)
  %residual = buffer.alloca<global> align(256) %hidden_bytes : buffer
  command.program.launch @krea2.fusion_layerwise_residual(%input, %attention_output, %residual) : (buffer, buffer, buffer)
  %feed_forward_input = buffer.alloca<global> align(256) %hidden_bytes : buffer
  command.program.launch @krea2.fusion_layerwise_norm2[%layer](%parameters, %residual, %feed_forward_input) : [index](buffer, buffer, buffer)
  %feed_forward_gate = buffer.alloca<global> align(256) %feed_forward_bytes : buffer
  %feed_forward_up = buffer.alloca<global> align(256) %feed_forward_bytes : buffer
  command.concurrent {
    command.program.launch @krea2.fusion_layerwise_feed_forward_gate[%layer, %adapted](%parameters, %adapter, %feed_forward_input, %strength, %feed_forward_gate) : [index, i1](buffer, buffer, buffer, buffer, buffer)
    command.program.launch @krea2.fusion_layerwise_feed_forward_up[%layer, %adapted](%parameters, %adapter, %feed_forward_input, %strength, %feed_forward_up) : [index, i1](buffer, buffer, buffer, buffer, buffer)
  }
  command.program.launch @krea2.fusion_layerwise_product(%feed_forward_gate, %feed_forward_up, %feed_forward_gate) : (buffer, buffer, buffer)
  %feed_forward_output = buffer.alloca<global> align(256) %hidden_bytes : buffer
  command.program.launch @krea2.fusion_layerwise_feed_forward_down[%layer, %adapted](%parameters, %adapter, %feed_forward_gate, %strength, %feed_forward_output) : [index, i1](buffer, buffer, buffer, buffer, buffer)
  command.program.launch @krea2.fusion_layerwise_residual(%residual, %feed_forward_output, %output) : (buffer, buffer, buffer)
  command.return
}

