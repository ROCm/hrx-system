//
// The caller supplies dimensions, physical buffers and the compile-time gate
// choice; the helper does not depend on model configuration.

template.decl @attention.shared_four_head_store(%tokens: index, %query_width: index, %query_origin: index, %column: index, %values: vector<8xf32>, %gated: i1, %gate: buffer, %output: buffer)
template.decl @attention.shared_four_head_bf16(%tokens: index, %key_value_heads: index, %gated: i1, %query: buffer, %key: buffer, %value: buffer, %mask: buffer, %gate: buffer, %output: buffer)

// The incoming values have wave32 result coordinates:
// component j -> row 2*j + lane/16, column lane%16.
// Context and sigmoid each round to BF16 before their product, matching the
// model's gate boundary. A false gate choice removes every gate-buffer access.
template.def<@attention.shared_four_head_store> device @shared_four_head_store(%tokens: index, %query_width: index, %query_origin: index, %column: index, %values: vector<8xf32>, %gated: i1, %gate: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %tile = index.constant 16 : index
  %output_view = buffer.view %output[%origin] : buffer -> view<[%tokens]x[%query_width]xbf16>
  %result = scf.if %gated -> (vector<8xf32>) {
    %rounded_values = vector.fptrunc %values : vector<8xf32> to vector<8xbf16>
    %values_f32 = vector.extf %rounded_values : vector<8xbf16> to vector<8xf32>
    %gate_view = buffer.view %gate[%origin] : buffer -> view<[%tokens]x[%query_width]xbf16>
    %gate_values = vector.fragment.load<result> %gate_view[%query_origin, %column] shape [%tile, %tile] : view<[%tokens]x[%query_width]xbf16> -> vector<8xbf16>
    %gate_f32 = vector.extf %gate_values : vector<8xbf16> to vector<8xf32>
    %ones = vector.constant 1.0 : vector<8xf32>
    %negative = vector.negf %gate_f32 : vector<8xf32>
    %exponential = vector.expf<afn> %negative : vector<8xf32>
    %denominator = vector.addf %ones, %exponential : vector<8xf32>
    %sigmoid = vector.divf<arcp> %ones, %denominator : vector<8xf32>
    %rounded_sigmoid = vector.fptrunc %sigmoid : vector<8xf32> to vector<8xbf16>
    %sigmoid_f32 = vector.extf %rounded_sigmoid : vector<8xbf16> to vector<8xf32>
    %product = vector.mulf %values_f32, %sigmoid_f32 : vector<8xf32>
    scf.yield %product : vector<8xf32>
  } else {
    scf.yield %values : vector<8xf32>
  }
  %fragment = vector.fragment<result> %result shape [%tile, %tile] : vector<8xf32>
  vector.fragment.store<result> %fragment, %output_view[%query_origin, %column] shape [%tile, %tile] : vector<8xf32>, view<[%tokens]x[%query_width]xbf16>
  template.return
}

// Noncausal, width 128, exactly four query heads per KV head. Tokens are a
// positive multiple of 16. Launch (tokens/16, key_value_heads, 1), WG128/wave32.
// Workgroup (x, g), wave w owns queries 16*x..16*x+15 of head 4*g+w.
// Q, gate, output are row-major [tokens,4*key_value_heads*128]; K is row-major
// [tokens,key_value_heads*128]; V is physical [key_value_heads*128,tokens].
// The byte mask is nonzero for valid keys and has at least one valid key.
// Input buffers and output do not overlap; the unused gate may name output.
//
// Q channels 0..63 stay in registers; channels 64..127 have a wave-owned LDS
// plane. All waves cooperatively publish one K16/V16 pair and retire it
// before reuse. The next pair is read ahead through explicit loop carriers,
// clamped to tokens-16; there is no extra global allocation or padded read.
template.def<@attention.shared_four_head_bf16> device @shared_four_head_bf16(%tokens: index, %key_value_heads: index, %gated: i1, %query: buffer, %key: buffer, %value: buffer, %mask: buffer, %gate: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %four = index.constant 4 : index
  %eight = index.constant 8 : index
  %tile = index.constant 16 : index
  %wave_size = index.constant 32 : index
  %width = index.constant 128 : index
  %half_width = index.constant 64 : index
  %query_tile = kernel.workgroup.id<x> : index
  %key_value_head = kernel.workgroup.id<y> : index
  %workitem = kernel.workitem.id<x> : index
  %wave = kernel.subgroup.id : index
  %lane = kernel.subgroup.lane.id : index
  %lane_column = index.rem %lane, %tile : index
  %query_head = index.madd %key_value_head, %four, %wave : index
  %query_origin = index.mul %query_tile, %tile : index
  %query_channel = index.mul %query_head, %width : index
  %key_value_channel = index.mul %key_value_head, %width : index
  %key_value_width = index.mul %key_value_heads, %width : index
  %query_width = index.mul %key_value_width, %four : index
  %last_origin = index.sub %tokens, %tile : index
  %query_view = buffer.view %query[%origin] : buffer -> view<[%tokens]x[%query_width]xbf16>
  %key_view = buffer.view %key[%origin] : buffer -> view<[%tokens]x[%key_value_width]xbf16>
  %value_view = buffer.view %value[%origin] : buffer -> view<[%key_value_width]x[%tokens]xbf16>
  %mask_view = buffer.view %mask[%origin] : buffer -> view<[%tokens]xi8>

  %shared_bytes = index.constant 19712 : offset
  %value_offset = index.constant 4352 : offset
  %query_offset = index.constant 10496 : offset
  %query_wave_bytes = index.constant 2304 : offset
  %query_wave_offset = index.scale %wave, %query_wave_bytes : index, offset -> offset
  %query_stage_offset = index.add %query_offset, %query_wave_offset : offset
  %shared = buffer.alloca<workgroup> align(16) %shared_bytes : buffer
  %key_stage = buffer.view %shared[%origin] : buffer -> view<16x136xbf16>
  %value_stage = buffer.view %shared[%value_offset] : buffer -> view<128x24xbf16>
  %query_stage = buffer.view %shared[%query_stage_offset] : buffer -> view<16x72xbf16>

  // 128 threads cover each K row's eight 16-channel packets exactly once.
  // The same threads cover V's 128 channel rows, each with 16 contiguous keys.
  %stage_key = index.div %workitem, %eight : index
  %stage_packet = index.rem %workitem, %eight : index
  %stage_column = index.mul %stage_packet, %tile : index
  %key_column = index.add %key_value_channel, %stage_column : index
  %value_row = index.add %key_value_channel, %workitem : index
  %zeros = vector.constant 0.0 : vector<8xf32>
  %lowest = vector.constant -1e30 : vector<8xf32>
  %scale = vector.constant 0.08838834764831845 : vector<8xf32>
  %initial = vector.fragment<init> %zeros shape [%tile, %tile] : vector<8xf32>
  %shuffle_width = scalar.constant 16 : i32

  // Each wave fills its own 16x64 Q-half with two rounds of 32 vector packets.
  // The first K/V publication barrier also publishes these Q writes.
  scf.for %round = [%zero to %two step %one] unroll {
    %packet = index.madd %round, %wave_size, %lane : index
    %row = index.div %packet, %four : index
    %column_packet = index.rem %packet, %four : index
    %column = index.mul %column_packet, %tile : index
    %token = index.add %query_origin, %row : index
    %head_column = index.add %query_channel, %half_width : index
    %global_column = index.add %head_column, %column : index
    %values = vector.load %query_view[%token, %global_column] : view<[%tokens]x[%query_width]xbf16> -> vector<16xbf16>
    vector.store %values, %query_stage[%row, %column] : vector<16xbf16>, view<16x72xbf16>
  }
  %channel0 = index.constant 0 : index
  %channel1 = index.constant 16 : index
  %channel2 = index.constant 32 : index
  %channel3 = index.constant 48 : index
  %channel4 = index.constant 64 : index
  %channel5 = index.constant 80 : index
  %channel6 = index.constant 96 : index
  %channel7 = index.constant 112 : index
  %query_column0 = index.add %query_channel, %channel0 : index
  %lhs0 = vector.fragment.load<lhs> %query_view[%query_origin, %query_column0] shape [%tile, %tile] : view<[%tokens]x[%query_width]xbf16> -> vector<16xbf16>
  %query_column1 = index.add %query_channel, %channel1 : index
  %lhs1 = vector.fragment.load<lhs> %query_view[%query_origin, %query_column1] shape [%tile, %tile] : view<[%tokens]x[%query_width]xbf16> -> vector<16xbf16>
  %query_column2 = index.add %query_channel, %channel2 : index
  %lhs2 = vector.fragment.load<lhs> %query_view[%query_origin, %query_column2] shape [%tile, %tile] : view<[%tokens]x[%query_width]xbf16> -> vector<16xbf16>
  %query_column3 = index.add %query_channel, %channel3 : index
  %lhs3 = vector.fragment.load<lhs> %query_view[%query_origin, %query_column3] shape [%tile, %tile] : view<[%tokens]x[%query_width]xbf16> -> vector<16xbf16>
  %first_key = vector.load %key_view[%stage_key, %key_column] : view<[%tokens]x[%key_value_width]xbf16> -> vector<16xbf16>
  %first_value = vector.load %value_view[%value_row, %zero] : view<[%key_value_width]x[%tokens]xbf16> -> vector<16xbf16>
  %final_max, %final_sum, %final0, %final1, %final2, %final3, %final4, %final5, %final6, %final7, %last_key, %last_value = scf.for %key_origin = [%zero to %tokens step %tile](%current_max = %lowest : vector<8xf32>, %current_sum = %zeros : vector<8xf32>, %output0 = %initial : vector<8xf32>, %output1 = %initial : vector<8xf32>, %output2 = %initial : vector<8xf32>, %output3 = %initial : vector<8xf32>, %output4 = %initial : vector<8xf32>, %output5 = %initial : vector<8xf32>, %output6 = %initial : vector<8xf32>, %output7 = %initial : vector<8xf32>, %key_packet = %first_key : vector<16xbf16>, %value_packet = %first_value : vector<16xbf16>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<16xbf16>, vector<16xbf16>) {
    vector.store %key_packet, %key_stage[%stage_key, %stage_column] : vector<16xbf16>, view<16x136xbf16>
    vector.store %value_packet, %value_stage[%workitem, %zero] : vector<16xbf16>, view<128x24xbf16>
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %unclamped_next = index.add %key_origin, %tile : index
    %before_last = index.cmp ult, %unclamped_next, %last_origin : index
    %selected_next = scf.select %before_last, %unclamped_next, %last_origin : index
    %next_origin = index.assume %selected_next [le(%selected_next, %last_origin), mul(%selected_next, 16)] : index
    %next_key_row = index.add %next_origin, %stage_key : index
    %next_key = vector.load %key_view[%next_key_row, %key_column] : view<[%tokens]x[%key_value_width]xbf16> -> vector<16xbf16>
    %next_value = vector.load %value_view[%value_row, %next_origin] : view<[%key_value_width]x[%tokens]xbf16> -> vector<16xbf16>

    %key_values0 = vector.load %key_stage[%lane_column, %channel0] : view<16x136xbf16> -> vector<16xbf16>
    %rhs0 = vector.fragment<rhs> %key_values0 shape [%tile, %tile] : vector<16xbf16>
    %dot0 = vector.mma %lhs0, %rhs0, %initial : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %key_values1 = vector.load %key_stage[%lane_column, %channel1] : view<16x136xbf16> -> vector<16xbf16>
    %rhs1 = vector.fragment<rhs> %key_values1 shape [%tile, %tile] : vector<16xbf16>
    %dot1 = vector.mma %lhs1, %rhs1, %dot0 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %key_values2 = vector.load %key_stage[%lane_column, %channel2] : view<16x136xbf16> -> vector<16xbf16>
    %rhs2 = vector.fragment<rhs> %key_values2 shape [%tile, %tile] : vector<16xbf16>
    %dot2 = vector.mma %lhs2, %rhs2, %dot1 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %key_values3 = vector.load %key_stage[%lane_column, %channel3] : view<16x136xbf16> -> vector<16xbf16>
    %rhs3 = vector.fragment<rhs> %key_values3 shape [%tile, %tile] : vector<16xbf16>
    %dot3 = vector.mma %lhs3, %rhs3, %dot2 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %query_values4 = vector.load %query_stage[%lane_column, %channel0] : view<16x72xbf16> -> vector<16xbf16>
    %lhs4 = vector.fragment<lhs> %query_values4 shape [%tile, %tile] : vector<16xbf16>
    %key_values4 = vector.load %key_stage[%lane_column, %channel4] : view<16x136xbf16> -> vector<16xbf16>
    %rhs4 = vector.fragment<rhs> %key_values4 shape [%tile, %tile] : vector<16xbf16>
    %dot4 = vector.mma %lhs4, %rhs4, %dot3 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %query_values5 = vector.load %query_stage[%lane_column, %channel1] : view<16x72xbf16> -> vector<16xbf16>
    %lhs5 = vector.fragment<lhs> %query_values5 shape [%tile, %tile] : vector<16xbf16>
    %key_values5 = vector.load %key_stage[%lane_column, %channel5] : view<16x136xbf16> -> vector<16xbf16>
    %rhs5 = vector.fragment<rhs> %key_values5 shape [%tile, %tile] : vector<16xbf16>
    %dot5 = vector.mma %lhs5, %rhs5, %dot4 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %query_values6 = vector.load %query_stage[%lane_column, %channel2] : view<16x72xbf16> -> vector<16xbf16>
    %lhs6 = vector.fragment<lhs> %query_values6 shape [%tile, %tile] : vector<16xbf16>
    %key_values6 = vector.load %key_stage[%lane_column, %channel6] : view<16x136xbf16> -> vector<16xbf16>
    %rhs6 = vector.fragment<rhs> %key_values6 shape [%tile, %tile] : vector<16xbf16>
    %dot6 = vector.mma %lhs6, %rhs6, %dot5 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %query_values7 = vector.load %query_stage[%lane_column, %channel3] : view<16x72xbf16> -> vector<16xbf16>
    %lhs7 = vector.fragment<lhs> %query_values7 shape [%tile, %tile] : vector<16xbf16>
    %key_values7 = vector.load %key_stage[%lane_column, %channel7] : view<16x136xbf16> -> vector<16xbf16>
    %rhs7 = vector.fragment<rhs> %key_values7 shape [%tile, %tile] : vector<16xbf16>
    %raw_scores = vector.mma %lhs7, %rhs7, %dot6 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>

    %key_token = index.add %key_origin, %lane_column : index
    %mask_byte = view.load %mask_view[%key_token] : view<[%tokens]xi8> -> i8
    %unset = scalar.constant 0 : i8
    %enabled = scalar.cmpi ne, %mask_byte, %unset : i8
    %valid = vector.splat %enabled : vector<8xi1>
    %masked_scores = vector.select %valid, %raw_scores, %lowest : vector<8xf32>
    %max_offset8 = scalar.constant 8 : i32
    %max_peer8, %max_valid8 = kernel.subgroup.shuffle<xor> %masked_scores, %max_offset8, %shuffle_width : vector<8xf32>, i32, i32
    %max_stage8 = vector.maxnumf %masked_scores, %max_peer8 : vector<8xf32>
    %max_offset4 = scalar.constant 4 : i32
    %max_peer4, %max_valid4 = kernel.subgroup.shuffle<xor> %max_stage8, %max_offset4, %shuffle_width : vector<8xf32>, i32, i32
    %max_stage4 = vector.maxnumf %max_stage8, %max_peer4 : vector<8xf32>
    %max_offset2 = scalar.constant 2 : i32
    %max_peer2, %max_valid2 = kernel.subgroup.shuffle<xor> %max_stage4, %max_offset2, %shuffle_width : vector<8xf32>, i32, i32
    %max_stage2 = vector.maxnumf %max_stage4, %max_peer2 : vector<8xf32>
    %max_offset1 = scalar.constant 1 : i32
    %max_peer1, %max_valid1 = kernel.subgroup.shuffle<xor> %max_stage2, %max_offset1, %shuffle_width : vector<8xf32>, i32, i32
    %max_stage1 = vector.maxnumf %max_stage2, %max_peer1 : vector<8xf32>
    %next_max = vector.maxnumf %current_max, %max_stage1 : vector<8xf32>
    %raw_delta = vector.subf %masked_scores, %next_max : vector<8xf32>
    %delta = vector.mulf %raw_delta, %scale : vector<8xf32>
    %exponentials = vector.expf<afn> %delta : vector<8xf32>
    // Explicit post-exp masking keeps entirely masked leading tiles neutral.
    %probability = vector.select %valid, %exponentials, %zeros : vector<8xf32>
    %old_raw_delta = vector.subf %current_max, %next_max : vector<8xf32>
    %old_delta = vector.mulf %old_raw_delta, %scale : vector<8xf32>
    %old_scale = vector.expf<afn> %old_delta : vector<8xf32>
    %scaled_sum = vector.mulf %current_sum, %old_scale : vector<8xf32>
    %next_sum = vector.addf %scaled_sum, %probability : vector<8xf32>
    %probability_fragment = vector.fragment<result> %probability shape [%tile, %tile] : vector<8xf32>
    %probability_lhs = vector.fragment.repack<lhs> %probability_fragment shape [%tile, %tile] : vector<8xf32> -> vector<16xbf16>

    // Subgroup fences bound V-fragment hoisting between pairs. They are LDS
    // waits within each subgroup, without a workgroup rendezvous.
    %value_channel0 = index.add %lane_column, %channel0 : index
    %value_values0 = vector.load %value_stage[%value_channel0, %zero] : view<128x24xbf16> -> vector<16xbf16>
    %value_rhs0 = vector.fragment<rhs> %value_values0 shape [%tile, %tile] : vector<16xbf16>
    %rescaled0 = vector.mulf %output0, %old_scale : vector<8xf32>
    %next0 = vector.mma %probability_lhs, %value_rhs0, %rescaled0 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %value_channel1 = index.add %lane_column, %channel1 : index
    %value_values1 = vector.load %value_stage[%value_channel1, %zero] : view<128x24xbf16> -> vector<16xbf16>
    %value_rhs1 = vector.fragment<rhs> %value_values1 shape [%tile, %tile] : vector<16xbf16>
    %rescaled1 = vector.mulf %output1, %old_scale : vector<8xf32>
    %next1 = vector.mma %probability_lhs, %value_rhs1, %rescaled1 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
    %value_channel2 = index.add %lane_column, %channel2 : index
    %value_values2 = vector.load %value_stage[%value_channel2, %zero] : view<128x24xbf16> -> vector<16xbf16>
    %value_rhs2 = vector.fragment<rhs> %value_values2 shape [%tile, %tile] : vector<16xbf16>
    %rescaled2 = vector.mulf %output2, %old_scale : vector<8xf32>
    %next2 = vector.mma %probability_lhs, %value_rhs2, %rescaled2 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %value_channel3 = index.add %lane_column, %channel3 : index
    %value_values3 = vector.load %value_stage[%value_channel3, %zero] : view<128x24xbf16> -> vector<16xbf16>
    %value_rhs3 = vector.fragment<rhs> %value_values3 shape [%tile, %tile] : vector<16xbf16>
    %rescaled3 = vector.mulf %output3, %old_scale : vector<8xf32>
    %next3 = vector.mma %probability_lhs, %value_rhs3, %rescaled3 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
    %value_channel4 = index.add %lane_column, %channel4 : index
    %value_values4 = vector.load %value_stage[%value_channel4, %zero] : view<128x24xbf16> -> vector<16xbf16>
    %value_rhs4 = vector.fragment<rhs> %value_values4 shape [%tile, %tile] : vector<16xbf16>
    %rescaled4 = vector.mulf %output4, %old_scale : vector<8xf32>
    %next4 = vector.mma %probability_lhs, %value_rhs4, %rescaled4 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %value_channel5 = index.add %lane_column, %channel5 : index
    %value_values5 = vector.load %value_stage[%value_channel5, %zero] : view<128x24xbf16> -> vector<16xbf16>
    %value_rhs5 = vector.fragment<rhs> %value_values5 shape [%tile, %tile] : vector<16xbf16>
    %rescaled5 = vector.mulf %output5, %old_scale : vector<8xf32>
    %next5 = vector.mma %probability_lhs, %value_rhs5, %rescaled5 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
    %value_channel6 = index.add %lane_column, %channel6 : index
    %value_values6 = vector.load %value_stage[%value_channel6, %zero] : view<128x24xbf16> -> vector<16xbf16>
    %value_rhs6 = vector.fragment<rhs> %value_values6 shape [%tile, %tile] : vector<16xbf16>
    %rescaled6 = vector.mulf %output6, %old_scale : vector<8xf32>
    %next6 = vector.mma %probability_lhs, %value_rhs6, %rescaled6 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %value_channel7 = index.add %lane_column, %channel7 : index
    %value_values7 = vector.load %value_stage[%value_channel7, %zero] : view<128x24xbf16> -> vector<16xbf16>
    %value_rhs7 = vector.fragment<rhs> %value_values7 shape [%tile, %tile] : vector<16xbf16>
    %rescaled7 = vector.mulf %output7, %old_scale : vector<8xf32>
    %next7 = vector.mma %probability_lhs, %value_rhs7, %rescaled7 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.yield %next_max, %next_sum, %next0, %next1, %next2, %next3, %next4, %next5, %next6, %next7, %next_key, %next_value : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<16xbf16>, vector<16xbf16>
  }

  // Only now combine the 16 lane-local denominator partials for each query.
  %sum_offset8 = scalar.constant 8 : i32
  %sum_peer8, %sum_valid8 = kernel.subgroup.shuffle<xor> %final_sum, %sum_offset8, %shuffle_width : vector<8xf32>, i32, i32
  %sum_stage8 = vector.addf %final_sum, %sum_peer8 : vector<8xf32>
  %sum_offset4 = scalar.constant 4 : i32
  %sum_peer4, %sum_valid4 = kernel.subgroup.shuffle<xor> %sum_stage8, %sum_offset4, %shuffle_width : vector<8xf32>, i32, i32
  %sum_stage4 = vector.addf %sum_stage8, %sum_peer4 : vector<8xf32>
  %sum_offset2 = scalar.constant 2 : i32
  %sum_peer2, %sum_valid2 = kernel.subgroup.shuffle<xor> %sum_stage4, %sum_offset2, %shuffle_width : vector<8xf32>, i32, i32
  %sum_stage2 = vector.addf %sum_stage4, %sum_peer2 : vector<8xf32>
  %sum_offset1 = scalar.constant 1 : i32
  %sum_peer1, %sum_valid1 = kernel.subgroup.shuffle<xor> %sum_stage2, %sum_offset1, %shuffle_width : vector<8xf32>, i32, i32
  %sum_stage1 = vector.addf %sum_stage2, %sum_peer1 : vector<8xf32>
  %ones = vector.constant 1.0 : vector<8xf32>
  %inverse = vector.divf<arcp> %ones, %sum_stage1 : vector<8xf32>
  %normalized0 = vector.mulf %final0, %inverse : vector<8xf32>
  %output_column0 = index.add %query_channel, %channel0 : index
  template.apply<@attention.shared_four_head_store>(%tokens, %query_width, %query_origin, %output_column0, %normalized0, %gated, %gate, %output) : (index, index, index, index, vector<8xf32>, i1, buffer, buffer)
  %normalized1 = vector.mulf %final1, %inverse : vector<8xf32>
  %output_column1 = index.add %query_channel, %channel1 : index
  template.apply<@attention.shared_four_head_store>(%tokens, %query_width, %query_origin, %output_column1, %normalized1, %gated, %gate, %output) : (index, index, index, index, vector<8xf32>, i1, buffer, buffer)
  %normalized2 = vector.mulf %final2, %inverse : vector<8xf32>
  %output_column2 = index.add %query_channel, %channel2 : index
  template.apply<@attention.shared_four_head_store>(%tokens, %query_width, %query_origin, %output_column2, %normalized2, %gated, %gate, %output) : (index, index, index, index, vector<8xf32>, i1, buffer, buffer)
  %normalized3 = vector.mulf %final3, %inverse : vector<8xf32>
  %output_column3 = index.add %query_channel, %channel3 : index
  template.apply<@attention.shared_four_head_store>(%tokens, %query_width, %query_origin, %output_column3, %normalized3, %gated, %gate, %output) : (index, index, index, index, vector<8xf32>, i1, buffer, buffer)
  %normalized4 = vector.mulf %final4, %inverse : vector<8xf32>
  %output_column4 = index.add %query_channel, %channel4 : index
  template.apply<@attention.shared_four_head_store>(%tokens, %query_width, %query_origin, %output_column4, %normalized4, %gated, %gate, %output) : (index, index, index, index, vector<8xf32>, i1, buffer, buffer)
  %normalized5 = vector.mulf %final5, %inverse : vector<8xf32>
  %output_column5 = index.add %query_channel, %channel5 : index
  template.apply<@attention.shared_four_head_store>(%tokens, %query_width, %query_origin, %output_column5, %normalized5, %gated, %gate, %output) : (index, index, index, index, vector<8xf32>, i1, buffer, buffer)
  %normalized6 = vector.mulf %final6, %inverse : vector<8xf32>
  %output_column6 = index.add %query_channel, %channel6 : index
  template.apply<@attention.shared_four_head_store>(%tokens, %query_width, %query_origin, %output_column6, %normalized6, %gated, %gate, %output) : (index, index, index, index, vector<8xf32>, i1, buffer, buffer)
  %normalized7 = vector.mulf %final7, %inverse : vector<8xf32>
  %output_column7 = index.add %query_channel, %channel7 : index
  template.apply<@attention.shared_four_head_store>(%tokens, %query_width, %query_origin, %output_column7, %normalized7, %gated, %gate, %output) : (index, index, index, index, vector<8xf32>, i1, buffer, buffer)
  template.return
}
