command.program.def public @krea2.encoder_query(%layer: index) launch(%parameters: buffer, %input: buffer, %output: buffer) {
  %weight = command.parameter %parameters, "language_model.layers.{}.self_attn.q_proj.weight"[%layer] : view<4096x2560xbf16>
  kernel.launch @encoder_linear_2560_4096(%input, %weight, %output) : (buffer, view<4096x2560xbf16>, buffer)
  command.return
}

