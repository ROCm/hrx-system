func.decl import("runner") @execute_4(%stage: i32, %request: hal.buffer, %prompt: hal.buffer, %rgb: hal.buffer, %workspace: hal.buffer) -> (i64)
func.decl import("runner") @feedback(%slot: i32, %source: hal.buffer, %offset: i64, %length: i64) -> (i64)

// Tags are the immutable i64 values declared by prepare.loom, in stage order.
// Slot zero is the maximum. Short prompts may use any retained text128 slot
// while preserving the kernels' prompt/suffix live-key partitions.
func.def public @select_stage(%tags: buffer, %stage_count: i32, %token_count: i32) -> (i32) {
  %origin = index.constant 0 : offset
  // Preparation requires a nonempty catalog addressable by signed i32 IDs.
  %bounded = scalar.assume %stage_count [range(%stage_count, 1, 2147483647)] : i32
  %count = index.cast %bounded : i32 to index
  %view = buffer.view %tags[%origin] : buffer -> view<[%count]xi64>
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %maximum = scalar.constant 0 : i32
  %small = scalar.constant 128 : i64
  %limit = scalar.constant 98 : i32
  %fits = scalar.cmpi ule, %token_count, %limit : i32
  %selected = scf.for %i = [%zero to %count step %one](%current = %maximum : i32) -> (i32) {
    %tag = view.load %view[%i] : view<[%count]xi64> -> i64
    %compact = scalar.cmpi eq, %tag, %small : i64
    %eligible = scalar.andi %fits, %compact : i1
    %candidate = index.cast %i : index to i32
    %next = scf.select %eligible, %candidate, %current : i32
    scf.yield %next : i32
  }
  func.return %selected : i32
}

// One invocation submits the complete image and its final readback without
// waiting. The native image owner retires both accepted queue frontiers before
// returning the image or reusing request storage.
func.def public @generate(%stage: i32, %output_bytes: i64, %request: hal.buffer, %prompt: hal.buffer, %rgb: hal.buffer, %workspace: hal.buffer) {
  %work = func.call @execute_4(%stage, %request, %prompt, %rgb, %workspace) : (i32, hal.buffer, hal.buffer, hal.buffer, hal.buffer) -> (i64)
  %zero = scalar.constant 0 : i32
  %offset = scalar.constant 0 : i64
  %completion = func.call @feedback(%zero, %rgb, %offset, %output_bytes) : (i32, hal.buffer, i64, i64) -> (i64)
  func.return
}
