func.decl @krea2.image_geometry_valid(%height: i64, %width: i64, %text: i64) -> (i1)

check.case public @geometry_square {
  %height = check.literal value(1024) : i64
  %width = check.literal value(1024) : i64
  %text = check.literal value(512) : i64
  %expected = check.literal value(true) : i1
  %valid = func.call @krea2.image_geometry_valid(%height, %width, %text) : (i64, i64, i64) -> (i1)
  check.expect.equal actual(%valid) expected(%expected) : i1
  check.return
}

