config.decl @krea2.latent_height : %value: index where [range(%value, 2, 1024), multiple_of(%value, 2)]

config.decl @krea2.latent_width : %value: index where [range(%value, 2, 1024), multiple_of(%value, 2)]

config.decl @krea2.vae_tile_height : %value: index where [range(%value, 2, 1024), multiple_of(%value, 2)]

config.decl @krea2.vae_tile_width : %value: index where [range(%value, 2, 1024), multiple_of(%value, 2)]

template.decl @krea2.vae_tile_axis_plan(%extent: index, %tile: index) -> (index, index)

template.decl @krea2.vae_tile_axis_interval(%extent: index, %tile: index, %stride: index, %ordinal: index) -> (index, index, index)

kernel.decl @krea_vae_extract_tile() launch(%origin_y: index, %origin_x: index, %input: buffer, %output: buffer) where [range(%origin_y, 0, 1022), range(%origin_x, 0, 1022)]

kernel.decl @krea_vae_stitch_tile(%crop_y_begin: index, %crop_y_end: index, %crop_x_begin: index, %crop_x_end: index) launch(%origin_y: index, %origin_x: index, %crop_y_begin_argument: index, %crop_y_end_argument: index, %crop_x_begin_argument: index, %crop_x_end_argument: index, %input: buffer, %output: buffer) where [range(%origin_y, 0, 1022), range(%origin_x, 0, 1022), range(%crop_y_begin_argument, 0, 1024), range(%crop_y_end_argument, 0, 1024), range(%crop_x_begin_argument, 0, 1024), range(%crop_x_end_argument, 0, 1024)]

func.def @vae_tile_axis(%extent: index, %tile: index, %ordinal: index) -> (index, index, index, index, index) {
  %stride, %count = template.apply<@krea2.vae_tile_axis_plan>(%extent, %tile) : (index, index) -> (index, index)
  %origin, %begin, %end = template.apply<@krea2.vae_tile_axis_interval>(%extent, %tile, %stride, %ordinal) : (index, index, index, index) -> (index, index, index)
  func.return %stride, %count, %origin, %begin, %end : index, index, index, index, index
}

// Independent flat-address reference for the strided extraction kernel.
kernel.def @vae_extract_tile_oracle() {
  %tile_height = config.get @krea2.vae_tile_height : index
  %tile_width = config.get @krea2.vae_tile_width : index
  %tile_pixels = index.mul %tile_height, %tile_width : index
  %channels = index.constant 384 : index
  %elements = index.mul %tile_pixels, %channels : index
  %padding = index.constant 127 : index
  %threads = index.constant 128 : index
  %rounded = index.add %elements, %padding : index
  %groups = index.div %rounded, %threads : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%origin_y: index, %origin_x: index, %input: buffer, %output: buffer) where [range(%origin_y, 0, 1022), range(%origin_x, 0, 1022)] {
  %full_height = config.get @krea2.latent_height : index
  %full_width = config.get @krea2.latent_width : index
  %tile_height = config.get @krea2.vae_tile_height : index
  %tile_width = config.get @krea2.vae_tile_width : index
  %full_pixels = index.mul %full_height, %full_width : index
  %tile_pixels = index.mul %tile_height, %tile_width : index
  %channels = index.constant 384 : index
  %elements = index.mul %tile_pixels, %channels : index
  %threads = index.constant 128 : index
  %group = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %element = index.madd %group, %threads, %lane : index
  %live = index.cmp ult, %element, %elements : index
  %origin = index.constant 0 : offset
  %source_elements = index.mul %full_pixels, %channels : index
  %source = buffer.view %input[%origin] : buffer -> view<[%source_elements]xf32>
  %destination = buffer.view %output[%origin] : buffer -> view<[%elements]xf32>
  scf.if %live {
    %channel = index.div %element, %tile_pixels : index
    %pixel = index.rem %element, %tile_pixels : index
    %y = index.div %pixel, %tile_width : index
    %x = index.rem %pixel, %tile_width : index
    %source_y = index.add %origin_y, %y : index
    %source_x = index.add %origin_x, %x : index
    %source_channel = index.mul %channel, %full_pixels : index
    %source_row = index.madd %source_y, %full_width, %source_x : index
    %source_index = index.add %source_channel, %source_row : index
    %safe_source_index = index.assume %source_index [ge(%source_index, 0), lt(%source_index, %source_elements)] : index
    %value = view.load %source[%safe_source_index] : view<[%source_elements]xf32> -> f32
    view.store %value, %destination[%element] : f32, view<[%elements]xf32>
  }
  kernel.return
}

// Independent flat-address reference for the strided stitch kernel.
kernel.def @vae_stitch_tile_oracle(%crop_y_begin: index, %crop_y_end: index, %crop_x_begin: index, %crop_x_end: index) {
  %height0 = index.sub %crop_y_end, %crop_y_begin : index
  %width0 = index.sub %crop_x_end, %crop_x_begin : index
  %height, %width = index.assume %height0, %width0 [range(%height0, 1, 1024), range(%width0, 1, 1024)] : index, index
  %scale = index.constant 8 : index
  %output_height = index.mul %height, %scale : index
  %output_width = index.mul %width, %scale : index
  %padding = index.constant 127 : index
  %threads = index.constant 128 : index
  %rounded_width = index.add %output_width, %padding : index
  %column_groups = index.div %rounded_width, %threads : index
  %channels = index.constant 3 : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%column_groups, %output_height, %channels) workgroup_size(%threads, %c1, %c1) : index
} launch(%origin_y: index, %origin_x: index, %crop_y_begin: index, %crop_y_end: index, %crop_x_begin: index, %crop_x_end: index, %input: buffer, %output: buffer) where [range(%origin_y, 0, 1022), range(%origin_x, 0, 1022), range(%crop_y_begin, 0, 1024), range(%crop_y_end, 0, 1024), range(%crop_x_begin, 0, 1024), range(%crop_x_end, 0, 1024)] {
  %full_height = config.get @krea2.latent_height : index
  %full_width = config.get @krea2.latent_width : index
  %tile_height = config.get @krea2.vae_tile_height : index
  %tile_width = config.get @krea2.vae_tile_width : index
  %scale = index.constant 8 : index
  %full_output_height = index.mul %full_height, %scale : index
  %full_output_width = index.mul %full_width, %scale : index
  %tile_output_height = index.mul %tile_height, %scale : index
  %tile_output_width = index.mul %tile_width, %scale : index
  %crop_height_latent0 = index.sub %crop_y_end, %crop_y_begin : index
  %crop_width_latent0 = index.sub %crop_x_end, %crop_x_begin : index
  %local_latent_y0 = index.sub %crop_y_begin, %origin_y : index
  %local_latent_x0 = index.sub %crop_x_begin, %origin_x : index
  %crop_height_latent, %crop_width_latent, %local_latent_y, %local_latent_x = index.assume %crop_height_latent0, %crop_width_latent0, %local_latent_y0, %local_latent_x0 [range(%crop_height_latent0, 1, 1024), range(%crop_width_latent0, 1, 1024), range(%local_latent_y0, 0, 1024), range(%local_latent_x0, 0, 1024)] : index, index, index, index
  %crop_height0 = index.mul %crop_height_latent, %scale : index
  %crop_width0 = index.mul %crop_width_latent, %scale : index
  %crop_height, %crop_width = index.assume %crop_height0, %crop_width0 [range(%crop_height0, 8, 8192), range(%crop_width0, 8, 8192)] : index, index
  %channels = index.constant 3 : index
  %threads = index.constant 128 : index
  %column_group = kernel.workgroup.id<x> : index
  %y0 = kernel.workgroup.id<y> : index
  %channel0 = kernel.workgroup.id<z> : index
  %lane = kernel.workitem.id<x> : index
  %x0 = index.madd %column_group, %threads, %lane : index
  %live = index.cmp ult, %x0, %crop_width : index
  %tile_output_pixels = index.mul %tile_output_height, %tile_output_width : index
  %full_output_pixels = index.mul %full_output_height, %full_output_width : index
  %source_elements = index.mul %tile_output_pixels, %channels : index
  %destination_elements = index.mul %full_output_pixels, %channels : index
  %origin = index.constant 0 : offset
  %source = buffer.view %input[%origin] : buffer -> view<[%source_elements]xf32>
  %destination = buffer.view %output[%origin] : buffer -> view<[%destination_elements]xf32>
  scf.if %live {
    %channel, %y, %x = index.assume %channel0, %y0, %x0 [range(%channel0, 0, 2), ge(%y0, 0), lt(%y0, %crop_height), ge(%x0, 0), lt(%x0, %crop_width)] : index, index, index
    %local_y_begin = index.mul %local_latent_y, %scale : index
    %local_x_begin = index.mul %local_latent_x, %scale : index
    %global_y_begin = index.mul %crop_y_begin, %scale : index
    %global_x_begin = index.mul %crop_x_begin, %scale : index
    %source_y = index.add %local_y_begin, %y : index
    %source_x = index.add %local_x_begin, %x : index
    %destination_y = index.add %global_y_begin, %y : index
    %destination_x = index.add %global_x_begin, %x : index
    %source_channel = index.mul %channel, %tile_output_pixels : index
    %source_pixel = index.madd %source_y, %tile_output_width, %source_x : index
    %source_index = index.add %source_channel, %source_pixel : index
    %destination_channel = index.mul %channel, %full_output_pixels : index
    %destination_pixel = index.madd %destination_y, %full_output_width, %destination_x : index
    %destination_index = index.add %destination_channel, %destination_pixel : index
    %safe_source_index, %safe_destination_index = index.assume %source_index, %destination_index [ge(%source_index, 0), lt(%source_index, %source_elements), ge(%destination_index, 0), lt(%destination_index, %destination_elements)] : index, index
    %value = view.load %source[%safe_source_index] : view<[%source_elements]xf32> -> f32
    view.store %value, %destination[%safe_destination_index] : f32, view<[%destination_elements]xf32>
  }
  kernel.return
}

check.case public @vae_tile_axis_single {
  %extent = check.literal value(24) : index
  %tile = check.literal value(24) : index
  %ordinal = check.literal value(0) : index
  %stride, %count, %origin, %begin, %end = func.call @vae_tile_axis(%extent, %tile, %ordinal) : (index, index, index) -> (index, index, index, index, index)
  %expected_stride = check.literal value(1) : index
  %expected_count = check.literal value(1) : index
  %expected_origin = check.literal value(0) : index
  %expected_begin = check.literal value(0) : index
  %expected_end = check.literal value(24) : index
  check.expect.equal actual(%stride) expected(%expected_stride) : index
  check.expect.equal actual(%count) expected(%expected_count) : index
  check.expect.equal actual(%origin) expected(%expected_origin) : index
  check.expect.equal actual(%begin) expected(%expected_begin) : index
  check.expect.equal actual(%end) expected(%expected_end) : index
  check.return
}

check.case public @vae_tile_axis_two_tiles {
  %extent = check.literal value(128) : index
  %tile = check.literal value(80) : index
  %ordinal0 = check.literal value(0) : index
  %ordinal1 = check.literal value(1) : index
  %stride0, %count0, %origin0, %begin0, %end0 = func.call @vae_tile_axis(%extent, %tile, %ordinal0) : (index, index, index) -> (index, index, index, index, index)
  %stride1, %count1, %origin1, %begin1, %end1 = func.call @vae_tile_axis(%extent, %tile, %ordinal1) : (index, index, index) -> (index, index, index, index, index)
  %expected_stride = check.literal value(50) : index
  %expected_count = check.literal value(2) : index
  %expected_origin0 = check.literal value(0) : index
  %expected_origin1 = check.literal value(48) : index
  %expected_begin0 = check.literal value(0) : index
  %expected_boundary = check.literal value(64) : index
  %expected_end1 = check.literal value(128) : index
  check.expect.equal actual(%stride0) expected(%expected_stride) : index
  check.expect.equal actual(%stride1) expected(%expected_stride) : index
  check.expect.equal actual(%count0) expected(%expected_count) : index
  check.expect.equal actual(%count1) expected(%expected_count) : index
  check.expect.equal actual(%origin0) expected(%expected_origin0) : index
  check.expect.equal actual(%origin1) expected(%expected_origin1) : index
  check.expect.equal actual(%begin0) expected(%expected_begin0) : index
  check.expect.equal actual(%end0) expected(%expected_boundary) : index
  check.expect.equal actual(%begin1) expected(%expected_boundary) : index
  check.expect.equal actual(%end1) expected(%expected_end1) : index
  check.return
}

check.case public @vae_tile_axis_shifted_tail {
  %extent = check.literal value(128) : index
  %tile = check.literal value(64) : index
  %ordinal0 = check.literal value(0) : index
  %ordinal1 = check.literal value(1) : index
  %ordinal2 = check.literal value(2) : index
  %stride0, %count0, %origin0, %begin0, %end0 = func.call @vae_tile_axis(%extent, %tile, %ordinal0) : (index, index, index) -> (index, index, index, index, index)
  %stride1, %count1, %origin1, %begin1, %end1 = func.call @vae_tile_axis(%extent, %tile, %ordinal1) : (index, index, index) -> (index, index, index, index, index)
  %stride2, %count2, %origin2, %begin2, %end2 = func.call @vae_tile_axis(%extent, %tile, %ordinal2) : (index, index, index) -> (index, index, index, index, index)
  %expected_stride = check.literal value(34) : index
  %expected_count = check.literal value(3) : index
  %expected_origin0 = check.literal value(0) : index
  %expected_origin1 = check.literal value(34) : index
  %expected_origin2 = check.literal value(64) : index
  %expected_begin0 = check.literal value(0) : index
  %expected_boundary0 = check.literal value(49) : index
  %expected_boundary1 = check.literal value(81) : index
  %expected_end2 = check.literal value(128) : index
  check.expect.equal actual(%stride0) expected(%expected_stride) : index
  check.expect.equal actual(%stride1) expected(%expected_stride) : index
  check.expect.equal actual(%stride2) expected(%expected_stride) : index
  check.expect.equal actual(%count0) expected(%expected_count) : index
  check.expect.equal actual(%count1) expected(%expected_count) : index
  check.expect.equal actual(%count2) expected(%expected_count) : index
  check.expect.equal actual(%origin0) expected(%expected_origin0) : index
  check.expect.equal actual(%origin1) expected(%expected_origin1) : index
  check.expect.equal actual(%origin2) expected(%expected_origin2) : index
  check.expect.equal actual(%begin0) expected(%expected_begin0) : index
  check.expect.equal actual(%end0) expected(%expected_boundary0) : index
  check.expect.equal actual(%begin1) expected(%expected_boundary0) : index
  check.expect.equal actual(%end1) expected(%expected_boundary1) : index
  check.expect.equal actual(%begin2) expected(%expected_boundary1) : index
  check.expect.equal actual(%end2) expected(%expected_end2) : index
  check.return
}

check.case public @vae_extract_tile_values {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %origin_y = check.literal value(4) : index
  %origin_x = check.literal value(6) : index
  %input = check.generate.iota offset(-32.0) step(0.125) period(257) : tensor<384x36x40xf32>
  %actual = check.generate.fill value(-99.0) : tensor<384x32x34xf32>
  %expected = check.generate.fill value(-99.0) : tensor<384x32x34xf32>
  kernel.launch @krea_vae_extract_tile(%origin_y, %origin_x, %input, %actual) : (index, index, tensor<384x36x40xf32>, tensor<384x32x34xf32>)
  kernel.launch @vae_extract_tile_oracle(%origin_y, %origin_x, %input, %expected) : (index, index, tensor<384x36x40xf32>, tensor<384x32x34xf32>)
  check.expect.bitwise actual(%actual) expected(%expected) : tensor<384x32x34xf32>
  check.return
}

check.case public @vae_stitch_tile_values {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  %origin_y = check.literal value(4) : index
  %origin_x = check.literal value(6) : index
  %crop_y_begin = check.literal value(18) : index
  %crop_y_end = check.literal value(36) : index
  %crop_x_begin = check.literal value(19) : index
  %crop_x_end = check.literal value(40) : index
  %input = check.generate.iota offset(-16.0) step(0.0625) period(521) : tensor<3x256x272xf32>
  %actual = check.generate.fill value(-99.0) : tensor<3x288x320xf32>
  %expected = check.generate.fill value(-99.0) : tensor<3x288x320xf32>
  kernel.launch @krea_vae_stitch_tile[%crop_y_begin, %crop_y_end, %crop_x_begin, %crop_x_end](%origin_y, %origin_x, %crop_y_begin, %crop_y_end, %crop_x_begin, %crop_x_end, %input, %actual) : [index, index, index, index](index, index, index, index, index, index, tensor<3x256x272xf32>, tensor<3x288x320xf32>)
  kernel.launch @vae_stitch_tile_oracle[%crop_y_begin, %crop_y_end, %crop_x_begin, %crop_x_end](%origin_y, %origin_x, %crop_y_begin, %crop_y_end, %crop_x_begin, %crop_x_end, %input, %expected) : [index, index, index, index](index, index, index, index, index, index, tensor<3x256x272xf32>, tensor<3x288x320xf32>)
  check.expect.bitwise actual(%actual) expected(%expected) : tensor<3x288x320xf32>
  check.return
}
