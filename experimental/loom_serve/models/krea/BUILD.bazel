load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_binary", "loom_cc_test", "loom_config_compatible_with")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

filegroup(
    name = "sources",
    srcs = [
        "sources.txt",
        "//experimental/loom_serve/motifs/tensor:sources",
    ] + glob(["*.loom"]),
    visibility = ["//visibility:public"],
)

loom_cc_test(
    name = "prepare_test",
    srcs = ["prepare_test.cc"],
    args = ["--model_source=$(rootpath :prepare.loom)"],
    data = ["prepare.loom"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:vm",
    ]),
    deps = [
        "//experimental/loom_serve/runtime:input",
        "//experimental/loom_serve/runtime:preparation",
        "//loom/binding/c:loomc",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/tooling:flags",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
        "//runtime/src/iree/vm",
    ],
)

loom_cc_test(
    name = "control_test",
    srcs = ["control_test.cc"],
    args = ["--control_source=$(rootpath :control.loom)"],
    data = ["control.loom"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:vm",
    ]),
    deps = [
        "//experimental/loom_serve/runtime:input",
        "//experimental/loom_serve/runtime:program",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/tooling:flags",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
        "//runtime/src/iree/vm",
    ],
)

loom_cc_test(
    name = "model_test",
    srcs = ["model_test.cc"],
    args = ["--model_source=$(rootpath :prepare.loom)"],
    data = ["prepare.loom"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:vm",
        "//runtime/config/hal:driver_amdgpu",
    ]),
    deps = [
        "//experimental/loom_serve/image:model",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/tooling:flags",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_binary(
    name = "projection_check",
    testonly = True,
    srcs = ["projection_check.c"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:vm",
        "//runtime/config/hal:driver_amdgpu",
    ]),
    deps = [
        "//experimental/loom_serve/runtime:device",
        "//experimental/loom_serve/runtime:execution",
        "//experimental/loom_serve/runtime:jit",
        "//experimental/loom_serve/runtime:weights",
        "//loom/binding/c:loomc",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal",
        "//runtime/src/iree/base/internal:path",
        "//runtime/src/iree/base/tooling:flags",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/io:file_handle",
    ],
)
