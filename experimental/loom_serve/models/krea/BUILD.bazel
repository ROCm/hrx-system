load("//loom/build_tools/bazel:defs.bzl", "loom_test")
load("//loom/target/amdgpu:execution_profiles.bzl", "AMDGPU_ACCESS_PROFILE", "AMDGPU_HARDWARE_PROFILE")
load("//loom/target/vm:execution_profiles.bzl", "VM_REFERENCE_PROFILE")

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "sources",
    srcs = [
        "model.json",
        "//experimental/loom_serve/motifs/tensor:sources",
    ] + glob(["*.loom"]),
    visibility = ["//visibility:public"],
)

loom_test(
    name = "adapter_traversal_test",
    srcs = [
        "block_adapters.loom",
        "block_int8.loom",
        "block_projections.loom",
        "tests/adapter_down_traversal.loom",
        "tests/adapter_traversal.loom",
        "//experimental/loom_serve/motifs/tensor:library",
    ],
    benchmark_smoke = False,
    configs = {"krea2.block_tokens": "80"},
    execution_profiles = [
        AMDGPU_HARDWARE_PROFILE,
        AMDGPU_ACCESS_PROFILE,
    ],
)

loom_test(
    name = "value_adapter_test",
    srcs = [
        "block_adapters.loom",
        "block_int8.loom",
        "block_projections.loom",
        "tests/value_adapter.loom",
        "//experimental/loom_serve/motifs/tensor:library",
    ],
    benchmark_smoke = False,
    execution_profiles = [
        AMDGPU_HARDWARE_PROFILE,
        AMDGPU_ACCESS_PROFILE,
    ],
    variants = {
        "five_tiles": {
            "case": "@value_adapter_80",
            "configs": {"krea2.block_tokens": "80"},
        },
        "one_tile": {
            "case": "@value_adapter_16",
            "configs": {"krea2.block_tokens": "16"},
        },
    },
)

loom_test(
    name = "shared_attention_test",
    srcs = [
        "block_attention.loom",
        "tests/attention_shared_k32.loom",
        "//experimental/loom_serve/motifs/tensor:library",
    ],
    benchmark_smoke = False,
    configs = {"krea2.block_tokens": "64"},
    execution_profiles = [
        AMDGPU_HARDWARE_PROFILE,
        AMDGPU_ACCESS_PROFILE,
    ],
)

loom_test(
    name = "vae_workspace_test",
    srcs = [
        "prepare.loom",
        "tests/vae_workspace.loom",
    ],
    benchmark_smoke = False,
    execution_profiles = [VM_REFERENCE_PROFILE],
)

loom_test(
    name = "vae_tiles_test",
    srcs = [
        "tests/vae_tiles.loom",
        "vae_tiles.loom",
    ],
    benchmark_smoke = False,
    configs = {
        "krea2.latent_height": "36",
        "krea2.latent_width": "40",
        "krea2.vae_tile_height": "32",
        "krea2.vae_tile_width": "34",
    },
    execution_profiles = [
        AMDGPU_HARDWARE_PROFILE,
        AMDGPU_ACCESS_PROFILE,
    ],
)
