config.decl @krea2.block_tokens : %value: index where [range(%value, 16, 65536), mul(%value, 16)]
config.decl @krea2.image_tokens : %value: index where [range(%value, 16, 65536), mul(%value, 16)]
config.decl @krea2.text_tokens : %value: index where [range(%value, 16, 65536), mul(%value, 16)]
config.decl @krea2.latent_height : %value: index where [range(%value, 2, 1024), mul(%value, 2)]
config.decl @krea2.latent_width : %value: index where [range(%value, 2, 1024), mul(%value, 2)]
amdgpu.target<gfx11-generic> @sample_mask_wave32 {subgroup_size = 32}
command.program.decl @text_encoder() launch(%parameters: buffer, %token_ids: buffer, %cosine: buffer, %sine: buffer, %mask: buffer, %taps: buffer)
command.program.decl @denoise() launch(%parameters: buffer, %sample: buffer, %text: buffer, %times: buffer, %cosine: buffer, %sine: buffer, %mask: buffer, %deltas: buffer, %output: buffer)
command.program.decl @denoise_adapted() launch(%parameters: buffer, %adapter: buffer, %sample: buffer, %text: buffer, %times: buffer, %cosine: buffer, %sine: buffer, %mask: buffer, %deltas: buffer, %strength: buffer, %output: buffer)
command.program.decl @vae_decode() launch(%parameters: buffer, %input: buffer, %affine: buffer, %output: buffer)
template.decl @krea2.text_projection(%rows: index, %adapted: i1, %parameters: buffer, %adapter: buffer, %input: buffer, %strength: buffer, %output: buffer)
template.decl @krea2.text_fusion(%rows: index, %adapted: i1, %parameters: buffer, %adapter: buffer, %input: buffer, %mask: buffer, %strength: buffer, %output: buffer)
template.decl @krea2.sample_image(%tokens: index, %images: index, %patches: index, %texts: index, %prefix: index, %adapted: i1, %parameters: buffer, %adapter: buffer, %vae_parameters: buffer, %sample: buffer, %taps: buffer, %times: buffer, %cosine: buffer, %sine: buffer, %mask: buffer, %deltas: buffer, %strength: buffer, %affine: buffer, %output: buffer)

// The source owns the final latent between denoising and decoding. Parameter
// domains remain immutable and distinct. Encoder taps are fused and projected
// once, with the resulting prefix retained for every denoising step. Fusion
// consumes the text prefix of the combined text/image key mask directly.
// The geometry predicates are JIT selection requirements, not assumptions
// about incoming configurations or runtime checks on trusted device work.
template.def<@krea2.sample_image> @krea2_sample_image(%tokens: index, %images: index, %patches: index, %texts: index, %prefix: index, %adapted: i1, %parameters: buffer, %adapter: buffer, %vae_parameters: buffer, %sample: buffer, %taps: buffer, %times: buffer, %cosine: buffer, %sine: buffer, %mask: buffer, %deltas: buffer, %strength: buffer, %affine: buffer, %output: buffer) where [eq(%images, %patches), ge(%tokens, %images), eq(%texts, %prefix)] {
  %feature_stride = index.constant 5120 : offset
  %feature_bytes = index.scale %texts, %feature_stride : index, offset -> offset
  %features = buffer.alloca<global> align(256) %feature_bytes : buffer
  template.apply<@krea2.text_fusion>(%texts, %adapted, %parameters, %adapter, %taps, %mask, %strength, %features) : (index, i1, buffer, buffer, buffer, buffer, buffer, buffer)
  %text_stride = index.constant 12288 : offset
  %text_bytes = index.scale %texts, %text_stride : index, offset -> offset
  %projected = buffer.alloca<global> align(256) %text_bytes : buffer
  template.apply<@krea2.text_projection>(%texts, %adapted, %parameters, %adapter, %features, %strength, %projected) : (index, i1, buffer, buffer, buffer, buffer, buffer)
  %patch_bytes = index.constant 128 : offset
  %bytes = index.scale %images, %patch_bytes : index, offset -> offset
  %latent = buffer.alloca<global> align(256) %bytes : buffer
  scf.if %adapted {
    command.program.launch @denoise_adapted(%parameters, %adapter, %sample, %projected, %times, %cosine, %sine, %mask, %deltas, %strength, %latent) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
    scf.yield
  } else {
    command.program.launch @denoise(%parameters, %sample, %projected, %times, %cosine, %sine, %mask, %deltas, %latent) : (buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
    scf.yield
  }
  command.program.launch @vae_decode(%vae_parameters, %latent, %affine, %output) : (buffer, buffer, buffer, buffer)
  template.return
}

// Derive both downstream consumers' key visibility from the encoder mask.
// The prefix is discarded, and every generated image position is a live key.
kernel.def target(@sample_mask_wave32) @sample_mask() {
  %tokens = config.get @krea2.block_tokens : index
  %threads = index.constant 256 : index
  %padding = index.constant 255 : index
  %padded = index.add %tokens, %padding : index
  %groups = index.div %padded, %threads : index
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%encoder_mask: buffer, %output: buffer) {
  %tokens = config.get @krea2.block_tokens : index
  %texts = config.get @krea2.text_tokens : index
  %prefix = index.constant 34 : index
  %padding = index.constant 48 : index
  %encoder_rows = index.add %texts, %padding : index
  %threads = index.constant 256 : index
  %group = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %token = index.madd %group, %threads, %lane : index
  %origin = index.constant 0 : offset
  %source = buffer.view %encoder_mask[%origin] : buffer -> view<[%encoder_rows]xi8>
  %target = buffer.view %output[%origin] : buffer -> view<[%tokens]xi8>
  %valid = index.cmp ult, %token, %tokens : index
  scf.if %valid {
    %text = index.cmp ult, %token, %texts : index
    scf.if %text {
      %position = index.add %token, %prefix : index
      %value = view.load %source[%position] : view<[%encoder_rows]xi8> -> i8
      view.store %value, %target[%token] : i8, view<[%tokens]xi8>
      scf.yield
    } else {
      %one = scalar.constant 1 : i8
      view.store %one, %target[%token] : i8, view<[%tokens]xi8>
      scf.yield
    }
    scf.yield
  }
  kernel.return
}

// The output is distinct NCHW F32 RGB, clamped to [-1,1], at eight times
// latent height/width. Validated IDs and encoder tables/mask follow text_encoder's
// contract. Initial noise, request data and all checkpoint domains are immutable.
// Taps and the combined key mask are source-owned; the caller supplies neither
// external hidden states nor a duplicate text visibility mask.
command.program.def public @sample_image() launch(%encoder_parameters: buffer, %parameters: buffer, %vae_parameters: buffer, %sample: buffer, %token_ids: buffer, %encoder_cosine: buffer, %encoder_sine: buffer, %encoder_mask: buffer, %times: buffer, %cosine: buffer, %sine: buffer, %deltas: buffer, %affine: buffer, %output: buffer) {
  %tokens = config.get @krea2.block_tokens : index
  %images = config.get @krea2.image_tokens : index
  %texts = config.get @krea2.text_tokens : index
  %prefix = index.sub %tokens, %images : index
  %height = config.get @krea2.latent_height : index
  %width = config.get @krea2.latent_width : index
  %two = index.constant 2 : index
  %rows = index.div %height, %two : index
  %columns = index.div %width, %two : index
  %patches = index.mul %rows, %columns : index
  %adapted = scalar.constant false : i1
  %tap_stride = index.constant 61440 : offset
  %tap_bytes = index.scale %texts, %tap_stride : index, offset -> offset
  %taps = buffer.alloca<global> align(256) %tap_bytes : buffer
  %mask_stride = index.constant 1 : offset
  %mask_bytes = index.scale %tokens, %mask_stride : index, offset -> offset
  %mask = buffer.alloca<global> align(256) %mask_bytes : buffer
  command.concurrent {
    command.program.launch @text_encoder(%encoder_parameters, %token_ids, %encoder_cosine, %encoder_sine, %encoder_mask, %taps) : (buffer, buffer, buffer, buffer, buffer, buffer)
    kernel.launch @sample_mask(%encoder_mask, %mask) : (buffer, buffer)
  }
  template.apply<@krea2.sample_image>(%tokens, %images, %patches, %texts, %prefix, %adapted, %parameters, %parameters, %vae_parameters, %sample, %taps, %times, %cosine, %sine, %mask, %deltas, %sample, %affine, %output) : (index, index, index, index, index, i1, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}

command.program.def public @sample_image_adapted() launch(%encoder_parameters: buffer, %parameters: buffer, %adapter: buffer, %vae_parameters: buffer, %sample: buffer, %token_ids: buffer, %encoder_cosine: buffer, %encoder_sine: buffer, %encoder_mask: buffer, %times: buffer, %cosine: buffer, %sine: buffer, %deltas: buffer, %strength: buffer, %affine: buffer, %output: buffer) {
  %tokens = config.get @krea2.block_tokens : index
  %images = config.get @krea2.image_tokens : index
  %texts = config.get @krea2.text_tokens : index
  %prefix = index.sub %tokens, %images : index
  %height = config.get @krea2.latent_height : index
  %width = config.get @krea2.latent_width : index
  %two = index.constant 2 : index
  %rows = index.div %height, %two : index
  %columns = index.div %width, %two : index
  %patches = index.mul %rows, %columns : index
  %adapted = scalar.constant true : i1
  %tap_stride = index.constant 61440 : offset
  %tap_bytes = index.scale %texts, %tap_stride : index, offset -> offset
  %taps = buffer.alloca<global> align(256) %tap_bytes : buffer
  %mask_stride = index.constant 1 : offset
  %mask_bytes = index.scale %tokens, %mask_stride : index, offset -> offset
  %mask = buffer.alloca<global> align(256) %mask_bytes : buffer
  command.concurrent {
    command.program.launch @text_encoder(%encoder_parameters, %token_ids, %encoder_cosine, %encoder_sine, %encoder_mask, %taps) : (buffer, buffer, buffer, buffer, buffer, buffer)
    kernel.launch @sample_mask(%encoder_mask, %mask) : (buffer, buffer)
  }
  template.apply<@krea2.sample_image>(%tokens, %images, %patches, %texts, %prefix, %adapted, %parameters, %adapter, %vae_parameters, %sample, %taps, %times, %cosine, %sine, %mask, %deltas, %strength, %affine, %output) : (index, index, index, index, index, i1, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  command.return
}
