      %q_value = view.load %q[%packed, %element, 0] : view<4x320x1xf32> -> f32
      %k_value = view.load %k[%packed, %element, 0] : view<4x320x1xf32> -> f32
      %v_value = view.load %v[%packed, %element, 0] : view<4x320x1xf32> -> f32
      %x_value = view.load %x[%packed, %element, 0] : view<4x320x1xf32> -> f32
      view.store %q_value, %row_queries[%element, %slot] : f32, view<320x32xf32>
      view.store %k_value, %row_keys[%element, %slot] : f32, view<320x32xf32>
      view.store %v_value, %row_values[%element, %slot] : f32, view<320x32xf32>
      view.store %x_value, %row_residuals[%element, %slot] : f32, view<320x32xf32>
