    %row_values_offset = index.add %row_values_row, %row_values_base : offset
    %row_values = buffer.view %state_storage[%row_values_offset] : buffer -> view<320x32xf32>
    %row_residuals_stride = index.constant 40320208 : offset
    %row_residuals_row = index.scale %resident, %row_residuals_stride : index, offset -> offset
    %row_residuals_offset = index.add %row_residuals_row, %row_residuals_base : offset
    %row_residuals = buffer.view %state_storage[%row_residuals_offset] : buffer -> view<320x32xf32>
    %row_gate_stride = index.constant 40320208 : offset
    %row_gate_row = index.scale %resident, %row_gate_stride : index, offset -> offset
    %row_gate_offset = index.add %row_gate_row, %row_gate_base : offset
    %row_gate = buffer.view %state_storage[%row_gate_offset] : buffer -> view<6xi32>
    %gate32 = view.load %row_gate[3] : view<6xi32> -> i32
    %zero32 = scalar.constant 0 : i32
    %enabled = scalar.cmpi ne, %gate32, %zero32 : i32
