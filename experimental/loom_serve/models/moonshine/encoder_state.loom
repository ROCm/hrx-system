// Each encoder layer owns a 32-position ring and six control words per resident.
// Readiness uses that row's input count, retirement cursor, and final-input flag.
// Publishing appends cross-attention memory once; later decoder steps only read it.
target.decl @moonshine

config.decl @moonshine.threads : index

kernel.def target(@moonshine) @moonshine.encoder_state.append_input() {
  %items = index.constant 320 : index
  %threads = config.get @moonshine.threads : index
  %c1 = index.constant 1 : index
  %tail = index.sub %threads, %c1 : index
  %rounded = index.add %items, %tail : index
  %groups = index.div %rounded, %threads : index
  %capacity = index.constant 4 : index
  kernel.launch.config workgroups(%groups, %capacity, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%state_storage: buffer, %q: view<4x320x1xf32>, %k: view<4x320x1xf32>, %v: view<4x320x1xf32>, %x: view<4x320x1xf32>, %work_storage: buffer, %cohort: view<5xi32>, %row_control_base: offset, %row_queries_base: offset, %row_keys_base: offset, %row_values_base: offset, %row_residuals_base: offset, %row_gate_base: offset) {
  %group = kernel.workgroup.id<x> : index
  %packed_value = kernel.workgroup.id<y> : index
  %packed = index.assume %packed_value [range(%packed_value, 0, 3)] : index
  %count32 = view.load %cohort[0] : view<5xi32> -> i32
  %bounded_count = scalar.assume %count32 [range(%count32, 0, 4)] : i32
  %count = index.cast %bounded_count : i32 to index
  %active = index.cmp ult, %packed, %count : index
  %threads = config.get @moonshine.threads : index
  %lane = kernel.workitem.id<x> : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %element = index.madd %group, %threads, %lane : index
  %limit = index.constant 320 : index
  %live = index.cmp ult, %element, %limit : index
  %participating = scalar.andi %active, %live : i1
  %f0 = scalar.constant 0.0 : f32
  scf.if %participating {
    %member = index.add %packed, %c1 : index
    %resident32 = view.load %cohort[%member] : view<5xi32> -> i32
    %bounded_resident = scalar.assume %resident32 [range(%resident32, 0, 3)] : i32
    %resident = index.cast %bounded_resident : i32 to index
    %row_control_stride = index.constant 40320208 : offset
    %row_control_row = index.scale %resident, %row_control_stride : index, offset -> offset
    %row_control_offset = index.add %row_control_row, %row_control_base : offset
    %row_control = buffer.view %state_storage[%row_control_offset] : buffer -> view<6xi32>
    %row_queries_stride = index.constant 40320208 : offset
    %row_queries_row = index.scale %resident, %row_queries_stride : index, offset -> offset
    %row_queries_offset = index.add %row_queries_row, %row_queries_base : offset
    %row_queries = buffer.view %state_storage[%row_queries_offset] : buffer -> view<320x32xf32>
    %row_keys_stride = index.constant 40320208 : offset
    %row_keys_row = index.scale %resident, %row_keys_stride : index, offset -> offset
    %row_keys_offset = index.add %row_keys_row, %row_keys_base : offset
    %row_keys = buffer.view %state_storage[%row_keys_offset] : buffer -> view<320x32xf32>
    %row_values_stride = index.constant 40320208 : offset
    %row_values_row = index.scale %resident, %row_values_stride : index, offset -> offset
    %row_values_offset = index.add %row_values_row, %row_values_base : offset
    %row_values = buffer.view %state_storage[%row_values_offset] : buffer -> view<320x32xf32>
    %row_residuals_stride = index.constant 40320208 : offset
    %row_residuals_row = index.scale %resident, %row_residuals_stride : index, offset -> offset
    %row_residuals_offset = index.add %row_residuals_row, %row_residuals_base : offset
    %row_residuals = buffer.view %state_storage[%row_residuals_offset] : buffer -> view<320x32xf32>
    %row_gate_stride = index.constant 1312 : offset
    %row_gate_row = index.scale %packed, %row_gate_stride : index, offset -> offset
    %row_gate_offset = index.add %row_gate_row, %row_gate_base : offset
    %row_gate = buffer.view %work_storage[%row_gate_offset] : buffer -> view<6xi32>
    %gate32 = view.load %row_gate[4] : view<6xi32> -> i32
    %zero32 = scalar.constant 0 : i32
    %enabled = scalar.cmpi ne, %gate32, %zero32 : i32
    scf.if %enabled {

      %received32 = view.load %row_control[0] : view<6xi32> -> i32
      %bounded_received = scalar.assume %received32 [range(%received32, 0, 2047)] : i32
      %received = index.cast %bounded_received : i32 to index
      %capacity = index.constant 32 : index
      %slot = index.rem %received, %capacity : index
      %q_value = view.load %q[%packed, %element, 0] : view<4x320x1xf32> -> f32
      %k_value = view.load %k[%packed, %element, 0] : view<4x320x1xf32> -> f32
      %v_value = view.load %v[%packed, %element, 0] : view<4x320x1xf32> -> f32
      %x_value = view.load %x[%packed, %element, 0] : view<4x320x1xf32> -> f32
      view.store %q_value, %row_queries[%element, %slot] : f32, view<320x32xf32>
      view.store %k_value, %row_keys[%element, %slot] : f32, view<320x32xf32>
      view.store %v_value, %row_values[%element, %slot] : f32, view<320x32xf32>
      view.store %x_value, %row_residuals[%element, %slot] : f32, view<320x32xf32>
    }
  }
  kernel.return
}

kernel.def target(@moonshine) @moonshine.encoder_state.input_readiness() {
  %items = index.constant 1 : index
  %threads = config.get @moonshine.threads : index
  %c1 = index.constant 1 : index
  %tail = index.sub %threads, %c1 : index
  %rounded = index.add %items, %tail : index
  %groups = index.div %rounded, %threads : index
  %capacity = index.constant 4 : index
  kernel.launch.config workgroups(%groups, %capacity, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%state_storage: buffer, %work_storage: buffer, %cohort: view<5xi32>, %row_control_base: offset, %row_valid_base: offset, %row_final_base: offset) {
  %group = kernel.workgroup.id<x> : index
  %packed_value = kernel.workgroup.id<y> : index
  %packed = index.assume %packed_value [range(%packed_value, 0, 3)] : index
  %count32 = view.load %cohort[0] : view<5xi32> -> i32
  %bounded_count = scalar.assume %count32 [range(%count32, 0, 4)] : i32
  %count = index.cast %bounded_count : i32 to index
  %active = index.cmp ult, %packed, %count : index
  %threads = config.get @moonshine.threads : index
  %lane = kernel.workitem.id<x> : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %element = index.madd %group, %threads, %lane : index
  %limit = index.constant 1 : index
  %live = index.cmp ult, %element, %limit : index
  %participating = scalar.andi %active, %live : i1
  %f0 = scalar.constant 0.0 : f32
  scf.if %participating {
    %member = index.add %packed, %c1 : index
    %resident32 = view.load %cohort[%member] : view<5xi32> -> i32
    %bounded_resident = scalar.assume %resident32 [range(%resident32, 0, 3)] : i32
    %resident = index.cast %bounded_resident : i32 to index
    %row_control_stride = index.constant 40320208 : offset
    %row_control_row = index.scale %resident, %row_control_stride : index, offset -> offset
    %row_control_offset = index.add %row_control_row, %row_control_base : offset
    %row_control = buffer.view %state_storage[%row_control_offset] : buffer -> view<6xi32>
    %row_valid_stride = index.constant 1312 : offset
    %row_valid_row = index.scale %packed, %row_valid_stride : index, offset -> offset
    %row_valid_offset = index.add %row_valid_row, %row_valid_base : offset
    %row_valid = buffer.view %work_storage[%row_valid_offset] : buffer -> view<6xi32>
    %row_final_stride = index.constant 1312 : offset
    %row_final_row = index.scale %packed, %row_final_stride : index, offset -> offset
    %row_final_offset = index.add %row_final_row, %row_final_base : offset
    %row_final = buffer.view %work_storage[%row_final_offset] : buffer -> view<6xi32>

    %valid32 = view.load %row_valid[4] : view<6xi32> -> i32
    %final32 = view.load %row_final[5] : view<6xi32> -> i32
    %received32 = view.load %row_control[0] : view<6xi32> -> i32
    %emitted32 = view.load %row_control[1] : view<6xi32> -> i32
    %received = scalar.addi %received32, %valid32 : i32
    %zero32 = scalar.constant 0 : i32
    %one32 = scalar.constant 1 : i32
    %right32 = scalar.constant 3 : i32
    %left32 = scalar.constant 15 : i32
    %right_end32 = scalar.constant 4 : i32
    %final = scalar.cmpi ne, %final32, %zero32 : i32
    %lagged = scalar.subi %received, %right32 : i32
    %stable = scf.select %final, %received, %lagged : i32
    %ready = scalar.cmpi slt, %emitted32, %stable : i32
    %ready32 = scf.select %ready, %one32, %zero32 : i32
    %start_value = scalar.subi %emitted32, %left32 : i32
    %negative_start = scalar.cmpi slt, %start_value, %zero32 : i32
    %start = scf.select %negative_start, %zero32, %start_value : i32
    %end_value = scalar.addi %emitted32, %right_end32 : i32
    %shorter = scalar.cmpi slt, %received, %end_value : i32
    %end = scf.select %shorter, %received, %end_value : i32
    %count_value = scalar.subi %end, %start : i32
    %count = scf.select %ready, %count_value, %zero32 : i32
    view.store %received, %row_control[0] : i32, view<6xi32>
    view.store %count, %row_control[2] : i32, view<6xi32>
    view.store %ready32, %row_control[3] : i32, view<6xi32>
    view.store %start, %row_control[4] : i32, view<6xi32>
  }
  kernel.return
}

kernel.def target(@moonshine) @moonshine.encoder_state.pending_query() {
  %items = index.constant 320 : index
  %threads = config.get @moonshine.threads : index
  %c1 = index.constant 1 : index
  %tail = index.sub %threads, %c1 : index
  %rounded = index.add %items, %tail : index
  %groups = index.div %rounded, %threads : index
  %capacity = index.constant 4 : index
  kernel.launch.config workgroups(%groups, %capacity, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%state_storage: buffer, %q: view<4x320x1xf32>, %x: view<4x320x1xf32>, %cohort: view<5xi32>, %row_control_base: offset, %row_queries_base: offset, %row_residuals_base: offset, %row_gate_base: offset) {
  %group = kernel.workgroup.id<x> : index
  %packed_value = kernel.workgroup.id<y> : index
  %packed = index.assume %packed_value [range(%packed_value, 0, 3)] : index
  %count32 = view.load %cohort[0] : view<5xi32> -> i32
  %bounded_count = scalar.assume %count32 [range(%count32, 0, 4)] : i32
  %count = index.cast %bounded_count : i32 to index
  %active = index.cmp ult, %packed, %count : index
  %threads = config.get @moonshine.threads : index
  %lane = kernel.workitem.id<x> : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %element = index.madd %group, %threads, %lane : index
  %limit = index.constant 320 : index
  %live = index.cmp ult, %element, %limit : index
  %participating = scalar.andi %active, %live : i1
  %f0 = scalar.constant 0.0 : f32
  scf.if %participating {
    %member = index.add %packed, %c1 : index
    %resident32 = view.load %cohort[%member] : view<5xi32> -> i32
    %bounded_resident = scalar.assume %resident32 [range(%resident32, 0, 3)] : i32
    %resident = index.cast %bounded_resident : i32 to index
    %row_control_stride = index.constant 40320208 : offset
    %row_control_row = index.scale %resident, %row_control_stride : index, offset -> offset
    %row_control_offset = index.add %row_control_row, %row_control_base : offset
    %row_control = buffer.view %state_storage[%row_control_offset] : buffer -> view<6xi32>
    %row_queries_stride = index.constant 40320208 : offset
    %row_queries_row = index.scale %resident, %row_queries_stride : index, offset -> offset
    %row_queries_offset = index.add %row_queries_row, %row_queries_base : offset
    %row_queries = buffer.view %state_storage[%row_queries_offset] : buffer -> view<320x32xf32>
    %row_residuals_stride = index.constant 40320208 : offset
    %row_residuals_row = index.scale %resident, %row_residuals_stride : index, offset -> offset
    %row_residuals_offset = index.add %row_residuals_row, %row_residuals_base : offset
    %row_residuals = buffer.view %state_storage[%row_residuals_offset] : buffer -> view<320x32xf32>
    %row_gate_stride = index.constant 40320208 : offset
    %row_gate_row = index.scale %resident, %row_gate_stride : index, offset -> offset
    %row_gate_offset = index.add %row_gate_row, %row_gate_base : offset
    %row_gate = buffer.view %state_storage[%row_gate_offset] : buffer -> view<6xi32>
    %gate32 = view.load %row_gate[3] : view<6xi32> -> i32
    %zero32 = scalar.constant 0 : i32
    %enabled = scalar.cmpi ne, %gate32, %zero32 : i32
    scf.if %enabled {

      %emitted32 = view.load %row_control[1] : view<6xi32> -> i32
      %bounded_emitted = scalar.assume %emitted32 [range(%emitted32, 0, 2047)] : i32
      %emitted = index.cast %bounded_emitted : i32 to index
      %capacity = index.constant 32 : index
      %slot = index.rem %emitted, %capacity : index
      %query = view.load %row_queries[%element, %slot] : view<320x32xf32> -> f32
      %residual = view.load %row_residuals[%element, %slot] : view<320x32xf32> -> f32
      view.store %query, %q[%packed, %element, 0] : f32, view<4x320x1xf32>
      view.store %residual, %x[%packed, %element, 0] : f32, view<4x320x1xf32>
    }
  }
  kernel.return
}

kernel.def target(@moonshine) @moonshine.encoder_state.retire_input() {
  %items = index.constant 1 : index
  %threads = config.get @moonshine.threads : index
  %c1 = index.constant 1 : index
  %tail = index.sub %threads, %c1 : index
  %rounded = index.add %items, %tail : index
  %groups = index.div %rounded, %threads : index
  %capacity = index.constant 4 : index
  kernel.launch.config workgroups(%groups, %capacity, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%state_storage: buffer, %work_storage: buffer, %cohort: view<5xi32>, %row_control_base: offset, %row_final_base: offset) {
  %group = kernel.workgroup.id<x> : index
  %packed_value = kernel.workgroup.id<y> : index
  %packed = index.assume %packed_value [range(%packed_value, 0, 3)] : index
  %count32 = view.load %cohort[0] : view<5xi32> -> i32
  %bounded_count = scalar.assume %count32 [range(%count32, 0, 4)] : i32
  %count = index.cast %bounded_count : i32 to index
  %active = index.cmp ult, %packed, %count : index
  %threads = config.get @moonshine.threads : index
  %lane = kernel.workitem.id<x> : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %element = index.madd %group, %threads, %lane : index
  %limit = index.constant 1 : index
  %live = index.cmp ult, %element, %limit : index
  %participating = scalar.andi %active, %live : i1
  %f0 = scalar.constant 0.0 : f32
  scf.if %participating {
    %member = index.add %packed, %c1 : index
    %resident32 = view.load %cohort[%member] : view<5xi32> -> i32
    %bounded_resident = scalar.assume %resident32 [range(%resident32, 0, 3)] : i32
    %resident = index.cast %bounded_resident : i32 to index
    %row_control_stride = index.constant 40320208 : offset
    %row_control_row = index.scale %resident, %row_control_stride : index, offset -> offset
    %row_control_offset = index.add %row_control_row, %row_control_base : offset
    %row_control = buffer.view %state_storage[%row_control_offset] : buffer -> view<6xi32>
    %row_final_stride = index.constant 1312 : offset
    %row_final_row = index.scale %packed, %row_final_stride : index, offset -> offset
    %row_final_offset = index.add %row_final_row, %row_final_base : offset
    %row_final = buffer.view %work_storage[%row_final_offset] : buffer -> view<6xi32>

    %emitted = view.load %row_control[1] : view<6xi32> -> i32
    %ready = view.load %row_control[3] : view<6xi32> -> i32
    %received = view.load %row_control[0] : view<6xi32> -> i32
    %final = view.load %row_final[5] : view<6xi32> -> i32
    %next = scalar.addi %emitted, %ready : i32
    %drained = scalar.cmpi eq, %received, %next : i32
    %zero32 = scalar.constant 0 : i32
    %finished = scf.select %drained, %final, %zero32 : i32
    view.store %next, %row_control[1] : i32, view<6xi32>
    view.store %finished, %row_control[5] : i32, view<6xi32>
  }
  kernel.return
}

