// Self attention uses each row's decoder position; cross attention uses its
// published encoder length. Masked positions never contribute to the softmax.
target.decl @moonshine

config.decl @moonshine.threads : index

// One workgroup owns a head's complete softmax row. Consecutive lanes load
// consecutive positions, retaining scores and exponentials across reductions.
// Both widths are divisible by 128; each lane owns four or sixteen values.
template.decl @moonshine.decoder_attention.softmax(%width: index, %x: view<4x8x[%width]xf32>, %y: view<4x8x[%width]xf32>, %cohort: view<5xi32>)

template.def<@moonshine.decoder_attention.softmax> device @moonshine_decoder_attention_softmax(%width: index, %x: view<4x8x[%width]xf32>, %y: view<4x8x[%width]xf32>, %cohort: view<5xi32>) {
  %head_value = kernel.workgroup.id<x> : index
  %head = index.assume %head_value [range(%head_value, 0, 7)] : index
  %packed_value = kernel.workgroup.id<y> : index
  %packed = index.assume %packed_value [range(%packed_value, 0, 3)] : index
  %count32 = view.load %cohort[0] : view<5xi32> -> i32
  %bounded_count = scalar.assume %count32 [range(%count32, 0, 4)] : i32
  %count = index.cast %bounded_count : i32 to index
  %active = index.cmp ult, %packed, %count : index
  scf.if %active {
    %lane = kernel.workitem.id<x> : index
    %zero = index.constant 0 : index
    %one = index.constant 1 : index
    %threads = index.constant 128 : index
    %slots = index.div %width, %threads : index
    %zero32 = scalar.constant 0.0 : f32
    %negative = scalar.constant -1e+30 : f32
    %empty = vector.constant 0.0 : vector<16xf32>
    %samples, %partial_maximum = scf.for %slot = [%zero to %slots step %one](%values = %empty : vector<16xf32>, %maximum = %negative : f32) -> (vector<16xf32>, f32) unroll {
      %position = index.madd %slot, %threads, %lane : index
      %value = view.load %x[%packed, %head, %position] : view<4x8x[%width]xf32> -> f32
      %next_values = vector.insert %value into %values[%slot] : f32, vector<16xf32>
      %next_maximum = scalar.maximumf %maximum, %value : f32
      scf.yield %next_values, %next_maximum : vector<16xf32>, f32
    }
    %maximum = kernel.workgroup.reduce<maximumf> %partial_maximum : f32
    %exponentials, %partial_sum = scf.for %slot = [%zero to %slots step %one](%values = %empty : vector<16xf32>, %sum = %zero32 : f32) -> (vector<16xf32>, f32) unroll {
      %value = vector.extract %samples[%slot] : vector<16xf32> -> f32
      %shifted = scalar.subf %value, %maximum : f32
      %exponential = scalar.expf<afn> %shifted : f32
      %next_values = vector.insert %exponential into %values[%slot] : f32, vector<16xf32>
      %next_sum = scalar.addf %sum, %exponential : f32
      scf.yield %next_values, %next_sum : vector<16xf32>, f32
    }
    %sum = kernel.workgroup.reduce<addf> %partial_sum : f32
    %unit = scalar.constant 1.0 : f32
    %inverse = scalar.divf %unit, %sum : f32
    scf.for %slot = [%zero to %slots step %one] unroll {
      %position = index.madd %slot, %threads, %lane : index
      %value = vector.extract %exponentials[%slot] : vector<16xf32> -> f32
      %normalized = scalar.mulf %value, %inverse : f32
      view.store %normalized, %y[%packed, %head, %position] : f32, view<4x8x[%width]xf32>
    }
  }
  template.return
}

kernel.def target(@moonshine) @moonshine.decoder_attention.self_scores() {
  %items = index.constant 4096 : index
  %threads = config.get @moonshine.threads : index
  %c1 = index.constant 1 : index
  %tail = index.sub %threads, %c1 : index
  %rounded = index.add %items, %tail : index
  %groups = index.div %rounded, %threads : index
  %capacity = index.constant 4 : index
  kernel.launch.config workgroups(%groups, %capacity, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%q: view<4x320x1xf32>, %state_storage: buffer, %y: view<4x8x512xf32>, %work_storage: buffer, %cohort: view<5xi32>, %row_k_base: offset, %row_position_base: offset) {
  %group = kernel.workgroup.id<x> : index
  %packed_value = kernel.workgroup.id<y> : index
  %packed = index.assume %packed_value [range(%packed_value, 0, 3)] : index
  %count32 = view.load %cohort[0] : view<5xi32> -> i32
  %bounded_count = scalar.assume %count32 [range(%count32, 0, 4)] : i32
  %count = index.cast %bounded_count : i32 to index
  %active = index.cmp ult, %packed, %count : index
  %threads = config.get @moonshine.threads : index
  %lane = kernel.workitem.id<x> : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %element = index.madd %group, %threads, %lane : index
  %limit = index.constant 4096 : index
  %live = index.cmp ult, %element, %limit : index
  %participating = scalar.andi %active, %live : i1
  %f0 = scalar.constant 0.0 : f32
  scf.if %participating {
    %member = index.add %packed, %c1 : index
    %resident32 = view.load %cohort[%member] : view<5xi32> -> i32
    %bounded_resident = scalar.assume %resident32 [range(%resident32, 0, 3)] : i32
    %resident = index.cast %bounded_resident : i32 to index
    %row_k_stride = index.constant 40320208 : offset
    %row_k_row = index.scale %resident, %row_k_stride : index, offset -> offset
    %row_k_offset = index.add %row_k_row, %row_k_base : offset
    %row_k = buffer.view %state_storage[%row_k_offset] : buffer -> view<320x512xf32>
    %row_position_stride = index.constant 1312 : offset
    %row_position_row = index.scale %packed, %row_position_stride : index, offset -> offset
    %row_position_offset = index.add %row_position_row, %row_position_base : offset
    %row_position = buffer.view %work_storage[%row_position_offset] : buffer -> view<6xi32>
    %width = index.constant 512 : index
    %row = index.div %element, %width : index
    %column = index.rem %element, %width : index
    %query_times = index.constant 1 : index
    %head_width = index.constant 40 : index
    %head = index.div %row, %query_times : index
    %time = index.rem %row, %query_times : index
    %position32 = view.load %row_position[1] : view<6xi32> -> i32
    %position_value = index.cast %position32 : i32 to index
    %valid = index.cmp ule, %column, %position_value : index
    %score = scf.if %valid -> (f32) {
      %sum = scf.for %d = [%c0 to %head_width step %c1](%acc = %f0 : f32) -> (f32) {
        %channel = index.madd %head, %head_width, %d : index
        %q_value = view.load %q[%packed, %channel, %time] : view<4x320x1xf32> -> f32
        %k_value = view.load %row_k[%channel, %column] : view<320x512xf32> -> f32
        %next = scalar.fmaf %q_value, %k_value, %acc : f32
        scf.yield %next : f32
      }
      %scale = scalar.constant 0.15811388300841897 : f32
      %scaled = scalar.mulf %sum, %scale : f32
      scf.yield %scaled : f32
    } else {
      %masked = scalar.constant -1e+30 : f32
      scf.yield %masked : f32
    }
    view.store %score, %y[%packed, %row, %column] : f32, view<4x8x512xf32>
  }
  kernel.return
}

kernel.def target(@moonshine) @moonshine.decoder_attention.self_softmax() {
  %heads = index.constant 8 : index
  %threads = index.constant 128 : index
  %one = index.constant 1 : index
  %capacity = index.constant 4 : index
  kernel.launch.config workgroups(%heads, %capacity, %one) workgroup_size(%threads, %one, %one) : index
} launch(%x: view<4x8x512xf32>, %y: view<4x8x512xf32>, %cohort: view<5xi32>) {
  %width = index.constant 512 : index
  %input = view.refine %x : view<4x8x512xf32> -> view<4x8x[%width]xf32>
  %output = view.refine %y : view<4x8x512xf32> -> view<4x8x[%width]xf32>
  template.apply<@moonshine.decoder_attention.softmax>(%width, %input, %output, %cohort) : (index, view<4x8x[%width]xf32>, view<4x8x[%width]xf32>, view<5xi32>)
  kernel.return
}

kernel.def target(@moonshine) @moonshine.decoder_attention.self_values() {
  %items = index.constant 320 : index
  %threads = config.get @moonshine.threads : index
  %c1 = index.constant 1 : index
  %tail = index.sub %threads, %c1 : index
  %rounded = index.add %items, %tail : index
  %groups = index.div %rounded, %threads : index
  %capacity = index.constant 4 : index
  kernel.launch.config workgroups(%groups, %capacity, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%state_storage: buffer, %p: view<4x8x512xf32>, %y: view<4x320x1xf32>, %work_storage: buffer, %cohort: view<5xi32>, %row_v_base: offset, %row_position_base: offset) {
  %group = kernel.workgroup.id<x> : index
  %packed_value = kernel.workgroup.id<y> : index
  %packed = index.assume %packed_value [range(%packed_value, 0, 3)] : index
  %count32 = view.load %cohort[0] : view<5xi32> -> i32
  %bounded_count = scalar.assume %count32 [range(%count32, 0, 4)] : i32
  %count = index.cast %bounded_count : i32 to index
  %active = index.cmp ult, %packed, %count : index
  %threads = config.get @moonshine.threads : index
  %lane = kernel.workitem.id<x> : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %element = index.madd %group, %threads, %lane : index
  %limit = index.constant 320 : index
  %live = index.cmp ult, %element, %limit : index
  %participating = scalar.andi %active, %live : i1
  %f0 = scalar.constant 0.0 : f32
  scf.if %participating {
    %member = index.add %packed, %c1 : index
    %resident32 = view.load %cohort[%member] : view<5xi32> -> i32
    %bounded_resident = scalar.assume %resident32 [range(%resident32, 0, 3)] : i32
    %resident = index.cast %bounded_resident : i32 to index
    %row_v_stride = index.constant 40320208 : offset
    %row_v_row = index.scale %resident, %row_v_stride : index, offset -> offset
    %row_v_offset = index.add %row_v_row, %row_v_base : offset
    %row_v = buffer.view %state_storage[%row_v_offset] : buffer -> view<320x512xf32>
    %row_position_stride = index.constant 1312 : offset
    %row_position_row = index.scale %packed, %row_position_stride : index, offset -> offset
    %row_position_offset = index.add %row_position_row, %row_position_base : offset
    %row_position = buffer.view %work_storage[%row_position_offset] : buffer -> view<6xi32>
    %width = index.constant 1 : index
    %row = index.div %element, %width : index
    %column = index.rem %element, %width : index
    %position32 = view.load %row_position[1] : view<6xi32> -> i32
    %bounded_position = scalar.assume %position32 [range(%position32, 0, 511)] : i32
    %position_value = index.cast %bounded_position : i32 to index
    %times = index.add %position_value, %c1 : index
    %query_times = index.constant 1 : index
    %head_width = index.constant 40 : index
    %head = index.div %row, %head_width : index
    %score_row = index.madd %head, %query_times, %column : index
    %sum = scf.for %i = [%c0 to %times step %c1](%acc = %f0 : f32) -> (f32) {
      %probability = view.load %p[%packed, %score_row, %i] : view<4x8x512xf32> -> f32
      %value = view.load %row_v[%row, %i] : view<320x512xf32> -> f32
      %next = scalar.fmaf %probability, %value, %acc : f32
      scf.yield %next : f32
    }
    view.store %sum, %y[%packed, %row, %column] : f32, view<4x320x1xf32>
  }
  kernel.return
}

kernel.def target(@moonshine) @moonshine.decoder_attention.cross_scores() {
  %items = index.constant 16384 : index
  %threads = config.get @moonshine.threads : index
  %c1 = index.constant 1 : index
  %tail = index.sub %threads, %c1 : index
  %rounded = index.add %items, %tail : index
  %groups = index.div %rounded, %threads : index
  %capacity = index.constant 4 : index
  kernel.launch.config workgroups(%groups, %capacity, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%q: view<4x320x1xf32>, %state_storage: buffer, %y: view<4x8x2048xf32>, %work_storage: buffer, %cohort: view<5xi32>, %row_k_base: offset, %row_length_base: offset) {
  %group = kernel.workgroup.id<x> : index
  %packed_value = kernel.workgroup.id<y> : index
  %packed = index.assume %packed_value [range(%packed_value, 0, 3)] : index
  %count32 = view.load %cohort[0] : view<5xi32> -> i32
  %bounded_count = scalar.assume %count32 [range(%count32, 0, 4)] : i32
  %count = index.cast %bounded_count : i32 to index
  %active = index.cmp ult, %packed, %count : index
  %threads = config.get @moonshine.threads : index
  %lane = kernel.workitem.id<x> : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %element = index.madd %group, %threads, %lane : index
  %limit = index.constant 16384 : index
  %live = index.cmp ult, %element, %limit : index
  %participating = scalar.andi %active, %live : i1
  %f0 = scalar.constant 0.0 : f32
  scf.if %participating {
    %member = index.add %packed, %c1 : index
    %resident32 = view.load %cohort[%member] : view<5xi32> -> i32
    %bounded_resident = scalar.assume %resident32 [range(%resident32, 0, 3)] : i32
    %resident = index.cast %bounded_resident : i32 to index
    %row_k_stride = index.constant 40320208 : offset
    %row_k_row = index.scale %resident, %row_k_stride : index, offset -> offset
    %row_k_offset = index.add %row_k_row, %row_k_base : offset
    %row_k = buffer.view %state_storage[%row_k_offset] : buffer -> view<320x2048xf32>
    %row_length_stride = index.constant 1312 : offset
    %row_length_row = index.scale %packed, %row_length_stride : index, offset -> offset
    %row_length_offset = index.add %row_length_row, %row_length_base : offset
    %row_length = buffer.view %work_storage[%row_length_offset] : buffer -> view<6xi32>
    %width = index.constant 2048 : index
    %row = index.div %element, %width : index
    %column = index.rem %element, %width : index
    %query_times = index.constant 1 : index
    %head_width = index.constant 40 : index
    %head = index.div %row, %query_times : index
    %time = index.rem %row, %query_times : index
    %window_valid = scalar.constant true : i1
    %length32 = view.load %row_length[2] : view<6xi32> -> i32
    %length_value = index.cast %length32 : i32 to index
    %within_length = index.cmp ult, %column, %length_value : index
    %valid = scalar.andi %window_valid, %within_length : i1
    %score = scf.if %valid -> (f32) {
      %sum = scf.for %d = [%c0 to %head_width step %c1](%acc = %f0 : f32) -> (f32) {
        %channel = index.madd %head, %head_width, %d : index
        %q_value = view.load %q[%packed, %channel, %time] : view<4x320x1xf32> -> f32
        %k_value = view.load %row_k[%channel, %column] : view<320x2048xf32> -> f32
        %next = scalar.fmaf %q_value, %k_value, %acc : f32
        scf.yield %next : f32
      }
      %scale = scalar.constant 0.15811388300841897 : f32
      %scaled = scalar.mulf %sum, %scale : f32
      scf.yield %scaled : f32
    } else {
      %masked = scalar.constant -1e+30 : f32
      scf.yield %masked : f32
    }
    view.store %score, %y[%packed, %row, %column] : f32, view<4x8x2048xf32>
  }
  kernel.return
}

kernel.def target(@moonshine) @moonshine.decoder_attention.cross_softmax() {
  %heads = index.constant 8 : index
  %threads = index.constant 128 : index
  %one = index.constant 1 : index
  %capacity = index.constant 4 : index
  kernel.launch.config workgroups(%heads, %capacity, %one) workgroup_size(%threads, %one, %one) : index
} launch(%x: view<4x8x2048xf32>, %y: view<4x8x2048xf32>, %cohort: view<5xi32>) {
  %width = index.constant 2048 : index
  %input = view.refine %x : view<4x8x2048xf32> -> view<4x8x[%width]xf32>
  %output = view.refine %y : view<4x8x2048xf32> -> view<4x8x[%width]xf32>
  template.apply<@moonshine.decoder_attention.softmax>(%width, %input, %output, %cohort) : (index, view<4x8x[%width]xf32>, view<4x8x[%width]xf32>, view<5xi32>)
  kernel.return
}

kernel.def target(@moonshine) @moonshine.decoder_attention.cross_values() {
  %items = index.constant 320 : index
  %threads = config.get @moonshine.threads : index
  %c1 = index.constant 1 : index
  %tail = index.sub %threads, %c1 : index
  %rounded = index.add %items, %tail : index
  %groups = index.div %rounded, %threads : index
  %capacity = index.constant 4 : index
  kernel.launch.config workgroups(%groups, %capacity, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%state_storage: buffer, %p: view<4x8x2048xf32>, %y: view<4x320x1xf32>, %work_storage: buffer, %cohort: view<5xi32>, %row_v_base: offset, %row_length_base: offset) {
  %group = kernel.workgroup.id<x> : index
  %packed_value = kernel.workgroup.id<y> : index
  %packed = index.assume %packed_value [range(%packed_value, 0, 3)] : index
  %count32 = view.load %cohort[0] : view<5xi32> -> i32
  %bounded_count = scalar.assume %count32 [range(%count32, 0, 4)] : i32
  %count = index.cast %bounded_count : i32 to index
  %active = index.cmp ult, %packed, %count : index
  %threads = config.get @moonshine.threads : index
  %lane = kernel.workitem.id<x> : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %element = index.madd %group, %threads, %lane : index
  %limit = index.constant 320 : index
  %live = index.cmp ult, %element, %limit : index
  %participating = scalar.andi %active, %live : i1
  %f0 = scalar.constant 0.0 : f32
  scf.if %participating {
    %member = index.add %packed, %c1 : index
    %resident32 = view.load %cohort[%member] : view<5xi32> -> i32
    %bounded_resident = scalar.assume %resident32 [range(%resident32, 0, 3)] : i32
    %resident = index.cast %bounded_resident : i32 to index
    %row_v_stride = index.constant 40320208 : offset
    %row_v_row = index.scale %resident, %row_v_stride : index, offset -> offset
    %row_v_offset = index.add %row_v_row, %row_v_base : offset
    %row_v = buffer.view %state_storage[%row_v_offset] : buffer -> view<320x2048xf32>
    %row_length_stride = index.constant 1312 : offset
    %row_length_row = index.scale %packed, %row_length_stride : index, offset -> offset
    %row_length_offset = index.add %row_length_row, %row_length_base : offset
    %row_length = buffer.view %work_storage[%row_length_offset] : buffer -> view<6xi32>
    %width = index.constant 1 : index
    %row = index.div %element, %width : index
    %column = index.rem %element, %width : index
    %length32 = view.load %row_length[2] : view<6xi32> -> i32
    %bounded_length = scalar.assume %length32 [range(%length32, 1, 2048)] : i32
    %times = index.cast %bounded_length : i32 to index
    %query_times = index.constant 1 : index
    %head_width = index.constant 40 : index
    %head = index.div %row, %head_width : index
    %score_row = index.madd %head, %query_times, %column : index
    %sum = scf.for %i = [%c0 to %times step %c1](%acc = %f0 : f32) -> (f32) {
      %probability = view.load %p[%packed, %score_row, %i] : view<4x8x2048xf32> -> f32
      %value = view.load %row_v[%row, %i] : view<320x2048xf32> -> f32
      %next = scalar.fmaf %probability, %value, %acc : f32
      scf.yield %next : f32
    }
    view.store %sum, %y[%packed, %row, %column] : f32, view<4x320x1xf32>
  }
  kernel.return
}
