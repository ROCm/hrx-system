// Each 128-lane workgroup owns one packed row and retains its 320 input
// channels through both moment reductions. Encoder readiness is per resident
// row; decoder rows already name a compatible phase. Input and encoder scales
// store gamma minus one, while decoder scales store gamma directly.
target.decl @moonshine

template.decl @moonshine.normalization.row(%rows: index, %x: view<[%rows]x320x1xf32>, %y: view<[%rows]x320x1xf32>, %scale: view<320xf32>, %packed: index, %scale_offset: f32)

template.def<@moonshine.normalization.row> device @moonshine_normalization_row(%rows: index, %x: view<[%rows]x320x1xf32>, %y: view<[%rows]x320x1xf32>, %scale: view<320xf32>, %packed: index, %scale_offset: f32) {
  %lane = kernel.workitem.id<x> : index
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %slots = index.constant 3 : index
  %threads = index.constant 128 : index
  %channels = index.constant 320 : index
  %zero32 = scalar.constant 0.0 : f32
  %empty = vector.constant 0.0 : vector<3xf32>
  %samples, %partial = scf.for %slot = [%zero to %slots step %one](%values = %empty : vector<3xf32>, %sum = %zero32 : f32) -> (vector<3xf32>, f32) unroll {
    %channel = index.madd %slot, %threads, %lane : index
    %live = index.cmp ult, %channel, %channels : index
    %sample = scf.if %live -> (f32) {
      %value = view.load %x[%packed, %channel, 0] : view<[%rows]x320x1xf32> -> f32
      scf.yield %value : f32
    } else {
      scf.yield %zero32 : f32
    }
    %next_values = vector.insert %sample into %values[%slot] : f32, vector<3xf32>
    %next_sum = scalar.addf %sum, %sample : f32
    scf.yield %next_values, %next_sum : vector<3xf32>, f32
  }
  %sum = kernel.workgroup.reduce<addf> %partial : f32
  %inverse_count = scalar.constant 0.0031250000000000002 : f32
  %mean = scalar.mulf %sum, %inverse_count : f32
  %partial_squared = scf.for %slot = [%zero to %slots step %one](%sum = %zero32 : f32) -> (f32) unroll {
    %channel = index.madd %slot, %threads, %lane : index
    %live = index.cmp ult, %channel, %channels : index
    %next = scf.if %live -> (f32) {
      %sample = vector.extract %samples[%slot] : vector<3xf32> -> f32
      %centered = scalar.subf %sample, %mean : f32
      %value = scalar.fmaf %centered, %centered, %sum : f32
      scf.yield %value : f32
    } else {
      scf.yield %sum : f32
    }
    scf.yield %next : f32
  }
  %squared = kernel.workgroup.reduce<addf> %partial_squared : f32
  %variance = scalar.mulf %squared, %inverse_count : f32
  %epsilon = scalar.constant 1.0000000000000001e-05 : f32
  %stabilized = scalar.addf %variance, %epsilon : f32
  %inverse = scalar.rsqrtf<afn> %stabilized : f32
  scf.for %slot = [%zero to %slots step %one] unroll {
    %channel = index.madd %slot, %threads, %lane : index
    %live = index.cmp ult, %channel, %channels : index
    scf.if %live {
      %sample = vector.extract %samples[%slot] : vector<3xf32> -> f32
      %centered = scalar.subf %sample, %mean : f32
      %normalized = scalar.mulf %centered, %inverse : f32
      %stored = view.load %scale[%channel] : view<320xf32> -> f32
      %factor = scalar.addf %stored, %scale_offset : f32
      %output = scalar.mulf %normalized, %factor : f32
      view.store %output, %y[%packed, %channel, 0] : f32, view<[%rows]x320x1xf32>
    }
  }
  template.return
}

kernel.def target(@moonshine) @moonshine.normalization.input() {
  %one = index.constant 1 : index
  %threads = index.constant 128 : index
  %capacity = index.constant 4 : index
  kernel.launch.config workgroups(%one, %capacity, %one) workgroup_size(%threads, %one, %one) : index
} launch(%x: view<4x320x1xf32>, %y: view<4x320x1xf32>, %scale: view<320xf32>, %work_storage: buffer, %cohort: view<5xi32>, %row_gate_base: offset) {
  %packed_value = kernel.workgroup.id<y> : index
  %packed = index.assume %packed_value [range(%packed_value, 0, 3)] : index
  %count32 = view.load %cohort[0] : view<5xi32> -> i32
  %bounded_count = scalar.assume %count32 [range(%count32, 0, 4)] : i32
  %count = index.cast %bounded_count : i32 to index
  %active = index.cmp ult, %packed, %count : index
  scf.if %active {
    %row_gate_stride = index.constant 1312 : offset
    %row_gate_row = index.scale %packed, %row_gate_stride : index, offset -> offset
    %row_gate_offset = index.add %row_gate_row, %row_gate_base : offset
    %row_gate = buffer.view %work_storage[%row_gate_offset] : buffer -> view<6xi32>
    %gate32 = view.load %row_gate[4] : view<6xi32> -> i32
    %zero32 = scalar.constant 0 : i32
    %enabled = scalar.cmpi ne, %gate32, %zero32 : i32
    scf.if %enabled {
      %scale_offset = scalar.constant 1.0 : f32
      %row_extent = index.constant 4 : index
      %row_input = view.refine %x : view<4x320x1xf32> -> view<[%row_extent]x320x1xf32>
      %row_output = view.refine %y : view<4x320x1xf32> -> view<[%row_extent]x320x1xf32>
      template.apply<@moonshine.normalization.row>(%row_extent, %row_input, %row_output, %scale, %packed, %scale_offset) : (index, view<[%row_extent]x320x1xf32>, view<[%row_extent]x320x1xf32>, view<320xf32>, index, f32)
    }
  }
  kernel.return
}

kernel.def target(@moonshine) @moonshine.normalization.encoder() {
  %one = index.constant 1 : index
  %threads = index.constant 128 : index
  %capacity = index.constant 4 : index
  kernel.launch.config workgroups(%one, %capacity, %one) workgroup_size(%threads, %one, %one) : index
} launch(%x: view<4x320x1xf32>, %y: view<4x320x1xf32>, %scale: view<320xf32>, %state_storage: buffer, %cohort: view<5xi32>, %row_gate_base: offset) {
  %packed_value = kernel.workgroup.id<y> : index
  %packed = index.assume %packed_value [range(%packed_value, 0, 3)] : index
  %count32 = view.load %cohort[0] : view<5xi32> -> i32
  %bounded_count = scalar.assume %count32 [range(%count32, 0, 4)] : i32
  %count = index.cast %bounded_count : i32 to index
  %active = index.cmp ult, %packed, %count : index
  %c1 = index.constant 1 : index
  scf.if %active {
    %member = index.add %packed, %c1 : index
    %resident32 = view.load %cohort[%member] : view<5xi32> -> i32
    %bounded_resident = scalar.assume %resident32 [range(%resident32, 0, 3)] : i32
    %resident = index.cast %bounded_resident : i32 to index
    %row_gate_stride = index.constant 40320208 : offset
    %row_gate_row = index.scale %resident, %row_gate_stride : index, offset -> offset
    %row_gate_offset = index.add %row_gate_row, %row_gate_base : offset
    %row_gate = buffer.view %state_storage[%row_gate_offset] : buffer -> view<6xi32>
    %gate32 = view.load %row_gate[3] : view<6xi32> -> i32
    %zero32 = scalar.constant 0 : i32
    %enabled = scalar.cmpi ne, %gate32, %zero32 : i32
    scf.if %enabled {
      %scale_offset = scalar.constant 1.0 : f32
      %row_extent = index.constant 4 : index
      %row_input = view.refine %x : view<4x320x1xf32> -> view<[%row_extent]x320x1xf32>
      %row_output = view.refine %y : view<4x320x1xf32> -> view<[%row_extent]x320x1xf32>
      template.apply<@moonshine.normalization.row>(%row_extent, %row_input, %row_output, %scale, %packed, %scale_offset) : (index, view<[%row_extent]x320x1xf32>, view<[%row_extent]x320x1xf32>, view<320xf32>, index, f32)
    }
  }
  kernel.return
}

kernel.def target(@moonshine) @moonshine.normalization.decoder() {
  %one = index.constant 1 : index
  %threads = index.constant 128 : index
  %capacity = index.constant 16 : index
  kernel.launch.config workgroups(%one, %capacity, %one) workgroup_size(%threads, %one, %one) : index
} launch(%x: view<16x320x1xf32>, %y: view<16x320x1xf32>, %scale: view<320xf32>, %cohort: view<17xi32>) {
  %packed_value = kernel.workgroup.id<y> : index
  %packed = index.assume %packed_value [range(%packed_value, 0, 15)] : index
  %count32 = view.load %cohort[0] : view<17xi32> -> i32
  %bounded_count = scalar.assume %count32 [range(%count32, 0, 16)] : i32
  %count = index.cast %bounded_count : i32 to index
  %active = index.cmp ult, %packed, %count : index
  scf.if %active {
    %scale_offset = scalar.constant 0.0 : f32
    %row_extent = index.constant 16 : index
    %row_input = view.refine %x : view<16x320x1xf32> -> view<[%row_extent]x320x1xf32>
    %row_output = view.refine %y : view<16x320x1xf32> -> view<[%row_extent]x320x1xf32>
    template.apply<@moonshine.normalization.row>(%row_extent, %row_input, %row_output, %scale, %packed, %scale_offset) : (index, view<[%row_extent]x320x1xf32>, view<[%row_extent]x320x1xf32>, view<320xf32>, index, f32)
  }
  kernel.return
}
