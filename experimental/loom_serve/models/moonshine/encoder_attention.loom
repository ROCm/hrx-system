} launch(%v: view<4x320x19xf32>, %p: view<4x8x19xf32>, %y: view<4x320x1xf32>, %state_storage: buffer, %cohort: view<5xi32>, %row_length_base: offset, %row_gate_base: offset) {
  %group = kernel.workgroup.id<x> : index
