// Decoder positions and tokens belong to requests, independently of cohort order.
// Rotary cache writes use resident identity; logits and token feedback are packed.
target.decl @moonshine

config.decl @moonshine.threads : index

kernel.def target(@moonshine) @moonshine.decoder_state.embedding() {
  %items = index.constant 320 : index
  %threads = config.get @moonshine.threads : index
  %c1 = index.constant 1 : index
  %tail = index.sub %threads, %c1 : index
  %rounded = index.add %items, %tail : index
  %groups = index.div %rounded, %threads : index
  %capacity = index.constant 16 : index
  kernel.launch.config workgroups(%groups, %capacity, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%work_storage: buffer, %w: view<32768x320xf32>, %y: view<16x320x1xf32>, %cohort: view<17xi32>, %row_packet_base: offset) {
  %group = kernel.workgroup.id<x> : index
  %packed_value = kernel.workgroup.id<y> : index
  %packed = index.assume %packed_value [range(%packed_value, 0, 15)] : index
  %count32 = view.load %cohort[0] : view<17xi32> -> i32
  %bounded_count = scalar.assume %count32 [range(%count32, 0, 16)] : i32
  %count = index.cast %bounded_count : i32 to index
  %active = index.cmp ult, %packed, %count : index
  %threads = config.get @moonshine.threads : index
  %lane = kernel.workitem.id<x> : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %element = index.madd %group, %threads, %lane : index
  %limit = index.constant 320 : index
  %live = index.cmp ult, %element, %limit : index
  %participating = scalar.andi %active, %live : i1
  %f0 = scalar.constant 0.0 : f32
  scf.if %participating {
    %member = index.add %packed, %c1 : index
    %resident32 = view.load %cohort[%member] : view<17xi32> -> i32
    %bounded_resident = scalar.assume %resident32 [range(%resident32, 0, 3)] : i32
    %resident = index.cast %bounded_resident : i32 to index
    %row_packet_stride = index.constant 1312 : offset
    %row_packet_row = index.scale %packed, %row_packet_stride : index, offset -> offset
    %row_packet_offset = index.add %row_packet_row, %row_packet_base : offset
    %row_packet = buffer.view %work_storage[%row_packet_offset] : buffer -> view<6xi32>

    %token32 = view.load %row_packet[0] : view<6xi32> -> i32
    %bounded_token = scalar.assume %token32 [range(%token32, 0, 32767)] : i32
    %token = index.cast %bounded_token : i32 to index
    %value = view.load %w[%token, %element] : view<32768x320xf32> -> f32
    view.store %value, %y[%packed, %element, 0] : f32, view<16x320x1xf32>
  }
  kernel.return
}

kernel.def target(@moonshine) @moonshine.decoder_state.rotary_cache() {
  %items = index.constant 320 : index
  %threads = config.get @moonshine.threads : index
  %c1 = index.constant 1 : index
  %tail = index.sub %threads, %c1 : index
  %rounded = index.add %items, %tail : index
  %groups = index.div %rounded, %threads : index
  %capacity = index.constant 16 : index
  kernel.launch.config workgroups(%groups, %capacity, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%q: view<16x320x1xf32>, %k: view<16x320x1xf32>, %v: view<16x320x1xf32>, %work_storage: buffer, %frequencies: view<16xf32>, %state_storage: buffer, %y: view<16x320x1xf32>, %cohort: view<17xi32>, %row_packet_base: offset, %row_keys_base: offset, %row_values_base: offset) {
  %group = kernel.workgroup.id<x> : index
  %packed_value = kernel.workgroup.id<y> : index
  %packed = index.assume %packed_value [range(%packed_value, 0, 15)] : index
  %count32 = view.load %cohort[0] : view<17xi32> -> i32
  %bounded_count = scalar.assume %count32 [range(%count32, 0, 16)] : i32
  %count = index.cast %bounded_count : i32 to index
  %active = index.cmp ult, %packed, %count : index
  %threads = config.get @moonshine.threads : index
  %lane = kernel.workitem.id<x> : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %element = index.madd %group, %threads, %lane : index
  %limit = index.constant 320 : index
  %live = index.cmp ult, %element, %limit : index
  %participating = scalar.andi %active, %live : i1
  %f0 = scalar.constant 0.0 : f32
  scf.if %participating {
    %member = index.add %packed, %c1 : index
    %resident32 = view.load %cohort[%member] : view<17xi32> -> i32
    %bounded_resident = scalar.assume %resident32 [range(%resident32, 0, 3)] : i32
    %resident = index.cast %bounded_resident : i32 to index
    %row_packet_stride = index.constant 1312 : offset
    %row_packet_row = index.scale %packed, %row_packet_stride : index, offset -> offset
    %row_packet_offset = index.add %row_packet_row, %row_packet_base : offset
    %row_packet = buffer.view %work_storage[%row_packet_offset] : buffer -> view<6xi32>
    %row_keys_stride = index.constant 40320208 : offset
    %row_keys_row = index.scale %resident, %row_keys_stride : index, offset -> offset
    %row_keys_offset = index.add %row_keys_row, %row_keys_base : offset
    %row_keys = buffer.view %state_storage[%row_keys_offset] : buffer -> view<320x512xf32>
    %row_values_stride = index.constant 40320208 : offset
    %row_values_row = index.scale %resident, %row_values_stride : index, offset -> offset
    %row_values_offset = index.add %row_values_row, %row_values_base : offset
    %row_values = buffer.view %state_storage[%row_values_offset] : buffer -> view<320x512xf32>

    %head_width = index.constant 40 : index
    %rotary_width = index.constant 32 : index
    %pair_width = index.constant 2 : index
    %dimension = index.rem %element, %head_width : index
    %rotated = index.cmp ult, %dimension, %rotary_width : index
    %position32 = view.load %row_packet[1] : view<6xi32> -> i32
    %bounded_position = scalar.assume %position32 [range(%position32, 0, 511)] : i32
    %position = index.cast %bounded_position : i32 to index
    %position_float = scalar.sitofp %position32 : i32 to f32
    %q_input = view.load %q[%packed, %element, 0] : view<16x320x1xf32> -> f32
    %k_input = view.load %k[%packed, %element, 0] : view<16x320x1xf32> -> f32
    %q_result, %k_result = scf.if %rotated -> (f32, f32) {
      %frequency_index = index.div %dimension, %pair_width : index
      %frequency = view.load %frequencies[%frequency_index] : view<16xf32> -> f32
      %angle = scalar.mulf %position_float, %frequency : f32
      %cosine = scalar.cosf<afn> %angle : f32
      %sine = scalar.sinf<afn> %angle : f32
      %parity = index.rem %element, %pair_width : index
      %real = index.cmp eq, %parity, %c0 : index
      %pair = index.div %element, %pair_width : index
      %other_parity = index.sub %c1, %parity : index
      %other = index.madd %pair, %pair_width, %other_parity : index
      %q_other = view.load %q[%packed, %other, 0] : view<16x320x1xf32> -> f32
      %k_other = view.load %k[%packed, %other, 0] : view<16x320x1xf32> -> f32
      %negative_sine = scalar.negf %sine : f32
      %signed_sine = scf.select %real, %negative_sine, %sine : f32
      %q_sine = scalar.mulf %q_other, %signed_sine : f32
      %k_sine = scalar.mulf %k_other, %signed_sine : f32
      %q_product = scalar.mulf %q_input, %cosine : f32
      %k_product = scalar.mulf %k_input, %cosine : f32
      %q_rotated = scalar.addf %q_product, %q_sine : f32
      %k_rotated = scalar.addf %k_product, %k_sine : f32
      scf.yield %q_rotated, %k_rotated : f32, f32
    } else {
      scf.yield %q_input, %k_input : f32, f32
    }
    %value = view.load %v[%packed, %element, 0] : view<16x320x1xf32> -> f32
    view.store %q_result, %y[%packed, %element, 0] : f32, view<16x320x1xf32>
    view.store %k_result, %row_keys[%element, %position] : f32, view<320x512xf32>
    view.store %value, %row_values[%element, %position] : f32, view<320x512xf32>
  }
  kernel.return
}

kernel.def target(@moonshine) @moonshine.decoder_state.greedy() {
  %items = index.constant 128 : index
  %threads = config.get @moonshine.threads : index
  %c1 = index.constant 1 : index
  %tail = index.sub %threads, %c1 : index
  %rounded = index.add %items, %tail : index
  %groups = index.div %rounded, %threads : index
  %capacity = index.constant 16 : index
  kernel.launch.config workgroups(%groups, %capacity, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%x: view<16x32768x1xf32>, %output_storage: buffer, %cohort: view<17xi32>, %row_y_base: offset) {
  %group = kernel.workgroup.id<x> : index
  %packed_value = kernel.workgroup.id<y> : index
  %packed = index.assume %packed_value [range(%packed_value, 0, 15)] : index
  %count32 = view.load %cohort[0] : view<17xi32> -> i32
  %bounded_count = scalar.assume %count32 [range(%count32, 0, 16)] : i32
  %count = index.cast %bounded_count : i32 to index
  %active = index.cmp ult, %packed, %count : index
  %threads = config.get @moonshine.threads : index
  %lane = kernel.workitem.id<x> : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %element = index.madd %group, %threads, %lane : index
  %limit = index.constant 128 : index
  %live = index.cmp ult, %element, %limit : index
  %participating = scalar.andi %active, %live : i1
  %f0 = scalar.constant 0.0 : f32
  scf.if %participating {
    %member = index.add %packed, %c1 : index
    %resident32 = view.load %cohort[%member] : view<17xi32> -> i32
    %bounded_resident = scalar.assume %resident32 [range(%resident32, 0, 3)] : i32
    %resident = index.cast %bounded_resident : i32 to index
    %row_y_stride = index.constant 16 : offset
    %row_y_row = index.scale %packed, %row_y_stride : index, offset -> offset
    %row_y_offset = index.add %row_y_row, %row_y_base : offset
    %row_y = buffer.view %output_storage[%row_y_offset] : buffer -> view<1xi32>

    %vocabulary = index.constant 32768 : index
    %stride = index.constant 128 : index
    %initial = view.load %x[%packed, %element, 0] : view<16x32768x1xf32> -> f32
    %initial_id = index.cast %element : index to i32
    %begin = index.add %element, %stride : index
    %local, %id = scf.for %i = [%begin to %vocabulary step %stride](%best = %initial : f32, %best_id = %initial_id : i32) -> (f32, i32) {
      %candidate = view.load %x[%packed, %i, 0] : view<16x32768x1xf32> -> f32
      %candidate_id = index.cast %i : index to i32
      %greater = scalar.cmpf ogt, %candidate, %best : f32
      %next = scf.select %greater, %candidate, %best : f32
      %next_id = scf.select %greater, %candidate_id, %best_id : i32
      scf.yield %next, %next_id : f32, i32
    }
    %winner = kernel.workgroup.reduce<maxnumf> %local : f32
    %matches = scalar.cmpf oeq, %winner, %local : f32
    %maximum_id = scalar.constant 2147483647 : i32
    %candidate_id = scf.select %matches, %id, %maximum_id : i32
    %winner_id = kernel.workgroup.reduce<minsi> %candidate_id : i32
    %publishes = index.cmp eq, %element, %c0 : index
    scf.if %publishes {
      view.store %winner_id, %row_y[0] : i32, view<1xi32>
    }
  }
  kernel.return
}
