func.decl import("runner") @execute_5(%stage: i32, %work: hal.buffer, %requests: hal.buffer, %conditioning: hal.buffer, %streams: hal.buffer, %output: hal.buffer) -> (i64)

func.decl import("runner") @feedback(%slot: i32, %source: hal.buffer, %offset: i64, %length: i64) -> (i64)

func.decl import("input") @require(%condition: i32, %diagnostic: buffer)

func.decl import("input", "decode") @decode_tokens(%tokens: buffer, %flags: i32, %capacity: i64) -> (buffer, i64)

global.rodata.def @empty = bytes("")

// Moonshine requires English, an empty prompt, and greedy decoding.
global.rodata.def @options_error = bytes("4d6f6f6e7368696e6520726571756972657320456e676c6973682c20616e20656d7074792070726f6d70742c20616e6420677265656479206465636f64696e67")

// Moonshine hypothesis exceeded the 512-token decoder capacity.
global.rodata.def @tokens_error = bytes("4d6f6f6e7368696e65206879706f74686573697320657863656564656420746865203531322d746f6b656e206465636f646572206361706163697479")

func.def @copy(%source: buffer, %source_offset: offset, %target: buffer, %target_offset: offset, %length: offset) {
  buffer.copy %source[%source_offset], %target[%target_offset], %length
  func.return
}

// One stable utterance ID is revised in source sample time. The checkpoint
// supplies neither speaker identity nor word alignment, so neither is invented.
func.def @event(%text: buffer, %length64: i64, %revision: i32, %end: i32, %final: i32) -> (buffer) {
  %bounded_length = scalar.assume %length64 [range(%length64, 0, 16384)] : i64
  %length = index.cast %bounded_length : i64 to offset
  %header_length = index.constant 60 : offset
  %size = index.add %length, %header_length : offset
  %packet = buffer.alloca<private> align(8) %size : buffer
  %origin = index.constant 0 : offset
  %envelope = buffer.view %packet[%origin] : buffer -> view<3xi32>
  %one32 = scalar.constant 1 : i32
  %kind32 = scalar.constant 0 : i32
  %payload_header = scalar.constant 48 : i64
  %payload_bytes = scalar.addi %length64, %payload_header : i64
  %payload32 = scalar.trunci %payload_bytes : i64 to i32
  view.store %one32, %envelope[0] : i32, view<3xi32>
  view.store %kind32, %envelope[1] : i32, view<3xi32>
  view.store %payload32, %envelope[2] : i32, view<3xi32>
  %payload_offset = index.constant 12 : offset
  %header = buffer.view %packet[%payload_offset] : buffer -> view<4xi64>
  %c0 = scalar.constant 0 : i64
  %revision64 = scalar.extui %revision : i32 to i64
  %end64 = scalar.extui %end : i32 to i64
  view.store %c0, %header[0] : i64, view<4xi64>
  view.store %revision64, %header[1] : i64, view<4xi64>
  view.store %c0, %header[2] : i64, view<4xi64>
  view.store %end64, %header[3] : i64, view<4xi64>
  %fields_offset = index.constant 44 : offset
  %fields = buffer.view %packet[%fields_offset] : buffer -> view<4xi32>
  %length32 = scalar.trunci %length64 : i64 to i32
  %zero32 = scalar.constant 0 : i32
  view.store %final, %fields[0] : i32, view<4xi32>
  view.store %length32, %fields[1] : i32, view<4xi32>
  view.store %zero32, %fields[2] : i32, view<4xi32>
  view.store %zero32, %fields[3] : i32, view<4xi32>
  func.call @copy(%text, %origin, %packet, %header_length, %length) : (buffer, offset, buffer, offset, offset)
  func.return %packet : buffer
}

// CPU state is independent of device residency: phase, published features,
// encoder EOF, decoder position, revision, last hypothesis sample, and consumed
// sample end occupy words 0..6. Word 7 is the reusable draft length; the
// next word records a suffix retry after a mismatch. Matching predictions
// restore that allowance; a second mismatch abandons the remaining draft.
// The remaining words pad the 512-token buffer to 64 bytes.
// Phases 0/1/2 select reset/encode/decode; the phase is also the compatibility tag.
func.def public @prepare_request(%model: buffer, %language: buffer, %prompt: buffer, %temperature: f32, %outputs: i32) -> (buffer, buffer) {
  %language_length = buffer.length %language
  %prompt_length = buffer.length %prompt
  %origin = index.constant 0 : offset
  %two_bytes = index.constant 2 : offset
  %no_language = index.cmp eq, %language_length, %origin : offset
  %two_letters = index.cmp eq, %language_length, %two_bytes : offset
  %english = scf.if %two_letters -> (i1) {
    %letters = buffer.view %language[%origin] : buffer -> view<2xi8>
    %first = view.load %letters[0] : view<2xi8> -> i8
    %second = view.load %letters[1] : view<2xi8> -> i8
    %e = scalar.constant 101 : i8
    %n = scalar.constant 110 : i8
    %first_ok = scalar.cmpi eq, %first, %e : i8
    %second_ok = scalar.cmpi eq, %second, %n : i8
    %both = scalar.andi %first_ok, %second_ok : i1
    scf.yield %both : i1
  } else {
    scf.yield %no_language : i1
  }
  %no_prompt = index.cmp eq, %prompt_length, %origin : offset
  %f0 = scalar.constant 0.0 : f32
  %greedy = scalar.cmpf oeq, %temperature, %f0 : f32
  %text_ok = scalar.andi %english, %no_prompt : i1
  %valid = scalar.andi %text_ok, %greedy : i1
  %condition = scalar.extui %valid : i1 to i32
  %diagnostic = global.load @options_error : buffer
  func.call @require(%condition, %diagnostic) : (i32, buffer)
  %length = index.constant 2112 : offset
  %state = buffer.alloca<private> align(8) %length : buffer
  %fields = buffer.view %state[%origin] : buffer -> view<16xi32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %count = index.constant 16 : index
  %zero = scalar.constant 0 : i32
  scf.for %i = [%c0 to %count step %c1] {
    view.store %zero, %fields[%i] : i32, view<16xi32>
  }
  %empty = global.load @empty : buffer
  func.return %state, %empty : buffer, buffer
}

// Work packets own eight control words followed by 320 F32 samples. A partial
// final quantum is padded but reports only the real source frames as consumed.
func.def public @prepare_work(%model: buffer, %state: buffer, %pcm: buffer, %position: i64, %eof: i32) -> (buffer, i64, i64) {
  %origin = index.constant 0 : offset
  %fields = buffer.view %state[%origin] : buffer -> view<16xi32>
  %phase = view.load %fields[0] : view<16xi32> -> i32
  %features = view.load %fields[1] : view<16xi32> -> i32
  %decode_position = view.load %fields[3] : view<16xi32> -> i32
  %zero = scalar.constant 0 : i32
  %one = scalar.constant 1 : i32
  %c0 = scalar.constant 0 : i64
  %c4 = scalar.constant 4 : i64
  %quantum = scalar.constant 320 : i64
  %length = buffer.length %pcm
  %bytes = index.cast %length : offset to i64
  %frames = scalar.divui %bytes, %c4 : i64
  %encode = scalar.cmpi eq, %phase, %one : i32
  %short = scalar.cmpi ult, %frames, %quantum : i64
  %bounded = scf.select %short, %frames, %quantum : i64
  %count64 = scf.select %encode, %bounded, %c0 : i64
  %final_input = scalar.cmpi ne, %eof, %zero : i32
  %full = scalar.cmpi uge, %frames, %quantum : i64
  %input_ready = scalar.ori %full, %final_input : i1
  %not_encode = scalar.cmpi ne, %phase, %one : i32
  %ready = scalar.ori %not_encode, %input_ready : i1
  %two = scalar.constant 2 : i32
  %decoding = scalar.cmpi eq, %phase, %two : i32
  %draft_length = view.load %fields[7] : view<16xi32> -> i32
  %has_draft = scalar.cmpi uge, %draft_length, %decode_position : i32
  %remaining = scalar.subi %draft_length, %decode_position : i32
  %with_bonus = scalar.addi %remaining, %one : i32
  %available = scf.select %has_draft, %with_bonus, %one : i32
  %four = scalar.constant 4 : i32
  %fits = scalar.cmpi ult, %available, %four : i32
  %chunk = scf.select %fits, %available, %four : i32
  %limit = scalar.constant 512 : i32
  %room = scalar.subi %limit, %decode_position : i32
  %fits_room = scalar.cmpi ult, %chunk, %room : i32
  %bounded_chunk = scf.select %fits_room, %chunk, %room : i32
  %rows32 = scf.select %decoding, %bounded_chunk, %one : i32
  %rows64 = scalar.extui %rows32 : i32 to i64
  %units = scf.select %ready, %rows64, %c0 : i64
  %any = scalar.cmpi ne, %count64, %c0 : i64
  %valid32 = scalar.extui %any : i1 to i32
  %all = scalar.cmpi eq, %count64, %frames : i64
  %final = scalar.andi %all, %final_input : i1
  %final32 = scalar.extui %final : i1 to i32
  %count32 = scalar.trunci %count64 : i64 to i32
  %end64 = scalar.addi %position, %count64 : i64
  %end32 = scalar.trunci %end64 : i64 to i32
  %first = scalar.cmpi eq, %decode_position, %zero : i32
  %token = scf.if %first -> (i32) {
    scf.yield %one : i32
  } else {
    %previous32 = scalar.subi %decode_position, %one : i32
    %bounded_previous = scalar.assume %previous32 [range(%previous32, 0, 511)] : i32
    %previous = index.cast %bounded_previous : i32 to index
    %tokens_offset = index.constant 64 : offset
    %tokens = buffer.view %state[%tokens_offset] : buffer -> view<512xi32>
    %id = view.load %tokens[%previous] : view<512xi32> -> i32
    scf.yield %id : i32
  }
  %size = index.constant 1312 : offset
  %work = buffer.alloca<private> align(8) %size : buffer
  %words = buffer.view %work[%origin] : buffer -> view<328xi32>
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %extent = index.constant 328 : index
  scf.for %i = [%begin to %extent step %step] {
    view.store %zero, %words[%i] : i32, view<328xi32>
  }
  view.store %token, %words[0] : i32, view<328xi32>
  view.store %decode_position, %words[1] : i32, view<328xi32>
  view.store %features, %words[2] : i32, view<328xi32>
  view.store %count32, %words[3] : i32, view<328xi32>
  view.store %valid32, %words[4] : i32, view<328xi32>
  view.store %final32, %words[5] : i32, view<328xi32>
  view.store %phase, %words[6] : i32, view<328xi32>
  view.store %end32, %words[7] : i32, view<328xi32>
  %copy_bytes64 = scalar.muli %count64, %c4 : i64
  %bounded_bytes = scalar.assume %copy_bytes64 [range(%copy_bytes64, 0, 1280)] : i64
  %copy_bytes = index.cast %bounded_bytes : i64 to offset
  %audio_offset = index.constant 32 : offset
  func.call @copy(%pcm, %origin, %work, %audio_offset, %copy_bytes) : (buffer, offset, buffer, offset, offset)
  scf.if %decoding {
    // Decoder offers use the otherwise unused PCM area for their token draft.
    view.store %rows32, %words[8] : i32, view<328xi32>
    %bounded_rows = scalar.assume %rows32 [range(%rows32, 1, 4)] : i32
    %rows = index.cast %bounded_rows : i32 to index
    %tokens_offset = index.constant 64 : offset
    %tokens = buffer.view %state[%tokens_offset] : buffer -> view<512xi32>
    %eight = index.constant 8 : index
    scf.for %row = [%step to %rows step %step] {
      %row32 = index.cast %row : index to i32
      %next_position = scalar.addi %decode_position, %row32 : i32
      %previous32 = scalar.subi %next_position, %one : i32
      %bounded_previous = scalar.assume %previous32 [range(%previous32, 0, 510)] : i32
      %previous = index.cast %bounded_previous : i32 to index
      %id = view.load %tokens[%previous] : view<512xi32> -> i32
      %slot = index.add %eight, %row : index
      view.store %id, %words[%slot] : i32, view<328xi32>
    }
  }
  %tag = scalar.extui %phase : i32 to i64
  func.return %work, %units, %tag : buffer, i64, i64
}

// The device cohort maps token activations to resident identities. The CPU
// plan keeps each original request's header, first activation, and row count.
// Both survive actual retirement, independently of cancellation and membership.
func.def public @prepare_batch(%model: buffer, %tags: buffer, %ranges: buffer, %packed: buffer) -> (buffer, buffer) {
  %origin = index.constant 0 : offset
  %length = buffer.length %ranges
  %bytes = index.cast %length : offset to i64
  %record = scalar.constant 24 : i64
  %count64 = scalar.divui %bytes, %record : i64
  %bounded_count = scalar.assume %count64 [range(%count64, 1, 4)] : i64
  %count = index.cast %bounded_count : i64 to index
  %records = buffer.view %ranges[%origin] : buffer -> view<[%count]x3xi64>
  %capacity = index.constant 21072 : offset
  %payload = buffer.alloca<private> align(8) %capacity : buffer
  %header = buffer.view %payload[%origin] : buffer -> view<17xi32>
  %plan_bytes = index.constant 160 : offset
  %plan = buffer.alloca<private> align(8) %plan_bytes : buffer
  %plan_stride = index.constant 40 : offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %stride = index.constant 1312 : offset
  %header_length = index.constant 32 : offset
  %one32 = scalar.constant 1 : i32
  %two32 = scalar.constant 2 : i32
  %eight = index.constant 8 : index
  %total = scf.for %ordinal = [%begin to %count step %step](%first = %begin : index) -> (index) {
    %source64 = view.load %records[%ordinal, 1] : view<[%count]x3xi64> -> i64
    %bounded_source = scalar.assume %source64 [range(%source64, 0, 3936)] : i64
    %source_offset = index.cast %bounded_source : i64 to offset
    %input = buffer.view %packed[%source_offset] : buffer -> view<328xi32>
    %phase = view.load %input[6] : view<328xi32> -> i32
    %decoding = scalar.cmpi eq, %phase, %two32 : i32
    %rows32 = scf.if %decoding -> (i32) {
      %offered = view.load %input[8] : view<328xi32> -> i32
      scf.yield %offered : i32
    } else {
      scf.yield %one32 : i32
    }
    %bounded_rows = scalar.assume %rows32 [range(%rows32, 1, 4)] : i32
    %rows = index.cast %bounded_rows : i32 to index
    %plan_offset = index.scale %ordinal, %plan_stride : index, offset -> offset
    func.call @copy(%packed, %source_offset, %plan, %plan_offset, %header_length) : (buffer, offset, buffer, offset, offset)
    %planned = buffer.view %plan[%plan_offset] : buffer -> view<10xi32>
    %first32 = index.cast %first : index to i32
    view.store %first32, %planned[8] : i32, view<10xi32>
    view.store %rows32, %planned[9] : i32, view<10xi32>
    %resident64 = view.load %records[%ordinal, 0] : view<[%count]x3xi64> -> i64
    %resident32 = scalar.trunci %resident64 : i64 to i32
    %position32 = view.load %input[1] : view<328xi32> -> i32
    %token32 = view.load %input[0] : view<328xi32> -> i32
    %copy_length = scf.select %decoding, %header_length, %stride : offset
    %decoder_prefix = index.constant 80 : offset
    %packet_base = scf.select %decoding, %decoder_prefix, %header_length : offset
    scf.for %row = [%begin to %rows step %step] {
      %activation_value = index.add %first, %row : index
      %activation = index.assume %activation_value [range(%activation_value, 0, 15)] : index
      %scaled = index.scale %activation, %stride : index, offset -> offset
      %target_offset = index.add %scaled, %packet_base : offset
      func.call @copy(%packed, %source_offset, %payload, %target_offset, %copy_length) : (buffer, offset, buffer, offset, offset)
      %packet = buffer.view %payload[%target_offset] : buffer -> view<8xi32>
      %first_token = index.cmp eq, %row, %begin : index
      %id = scf.if %first_token -> (i32) {
        scf.yield %token32 : i32
      } else {
        %slot = index.add %eight, %row : index
        %draft = view.load %input[%slot] : view<328xi32> -> i32
        scf.yield %draft : i32
      }
      %row32 = index.cast %row : index to i32
      %position = scalar.addi %position32, %row32 : i32
      view.store %id, %packet[0] : i32, view<8xi32>
      view.store %position, %packet[1] : i32, view<8xi32>
      %member = index.add %activation, %step : index
      view.store %resident32, %header[%member] : i32, view<17xi32>
    }
    %next = index.add %first, %rows : index
    scf.yield %next : index
  }
  %total32 = index.cast %total : index to i32
  view.store %total32, %header[0] : i32, view<17xi32>
  func.return %payload, %plan : buffer, buffer
}

func.def public @generate(%plan: buffer, %work: hal.buffer, %requests: hal.buffer, %conditioning: hal.buffer, %streams: hal.buffer, %output: hal.buffer) {
  %phase_offset = index.constant 24 : offset
  %phase_view = buffer.view %plan[%phase_offset] : buffer -> view<1xi32>
  %phase = view.load %phase_view[0] : view<1xi32> -> i32
  %execution = func.call @execute_5(%phase, %work, %requests, %conditioning, %streams, %output) : (i32, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer) -> (i64)
  %zero = scalar.constant 0 : i32
  %origin = scalar.constant 0 : i64
  %length = scalar.constant 256 : i64
  %feedback = func.call @feedback(%zero, %output, %origin, %length) : (i32, hal.buffer, i64, i64) -> (i64)
  func.return
}

func.def @encoded(%state: buffer, %work: buffer, %feedback: buffer, %output_offset: offset) -> (i64, buffer, i32) {
  %origin = index.constant 0 : offset
  %fields = buffer.view %state[%origin] : buffer -> view<16xi32>
  %input = buffer.view %work[%origin] : buffer -> view<8xi32>
  %output = buffer.view %feedback[%output_offset] : buffer -> view<2xi32>
  %features = view.load %output[0] : view<2xi32> -> i32
  %finished = view.load %output[1] : view<2xi32> -> i32
  %count = view.load %input[3] : view<8xi32> -> i32
  %end = view.load %input[7] : view<8xi32> -> i32
  %last_hypothesis = view.load %fields[5] : view<16xi32> -> i32
  view.store %features, %fields[1] : i32, view<16xi32>
  view.store %finished, %fields[2] : i32, view<16xi32>
  view.store %end, %fields[6] : i32, view<16xi32>
  %zero = scalar.constant 0 : i32
  %one = scalar.constant 1 : i32
  %two = scalar.constant 2 : i32
  %period = scalar.constant 6400 : i32
  %since = scalar.subi %end, %last_hypothesis : i32
  %periodic = scalar.cmpi uge, %since, %period : i32
  %final = scalar.cmpi ne, %finished, %zero : i32
  %no_features = scalar.cmpi eq, %features, %zero : i32
  %empty_final = scalar.andi %final, %no_features : i1
  %empty = global.load @empty : buffer
  %packet, %complete = scf.if %empty_final -> (buffer, i32) {
    %length = scalar.constant 0 : i64
    %event = func.call @event(%empty, %length, %one, %end, %one) : (buffer, i64, i32, i32, i32) -> (buffer)
    scf.yield %event, %one : buffer, i32
  } else {
    %trigger = scalar.ori %periodic, %final : i1
    %nonempty = scalar.cmpi ne, %features, %zero : i32
    %decode = scalar.andi %trigger, %nonempty : i1
    scf.if %decode {
      %previous_length = view.load %fields[3] : view<16xi32> -> i32
      %has_previous = scalar.cmpi ugt, %previous_length, %zero : i32
      %without_eos = scalar.subi %previous_length, %one : i32
      %draft_length = scf.select %has_previous, %without_eos, %zero : i32
      view.store %draft_length, %fields[7] : i32, view<16xi32>
      view.store %zero, %fields[8] : i32, view<16xi32>
      view.store %two, %fields[0] : i32, view<16xi32>
      view.store %zero, %fields[3] : i32, view<16xi32>
    }
    scf.yield %empty, %zero : buffer, i32
  }
  %count64 = scalar.extui %count : i32 to i64
  func.return %count64, %packet, %complete : i64, buffer, i32
}

func.def @decoded_token(%state: buffer, %feedback: buffer, %output_offset: offset) -> (buffer, i32) {
  %origin = index.constant 0 : offset
  %fields = buffer.view %state[%origin] : buffer -> view<16xi32>
  %output = buffer.view %feedback[%output_offset] : buffer -> view<1xi32>
  %token = view.load %output[0] : view<1xi32> -> i32
  %position = view.load %fields[3] : view<16xi32> -> i32
  %finished = view.load %fields[2] : view<16xi32> -> i32
  %end = view.load %fields[6] : view<16xi32> -> i32
  %zero = scalar.constant 0 : i32
  %one = scalar.constant 1 : i32
  %eos = scalar.constant 2 : i32
  %limit = scalar.constant 511 : i32
  %is_eos = scalar.cmpi eq, %token, %eos : i32
  %room = scalar.cmpi ult, %position, %limit : i32
  %can_finish = scalar.ori %room, %is_eos : i1
  %condition = scalar.extui %can_finish : i1 to i32
  %error = global.load @tokens_error : buffer
  func.call @require(%condition, %error) : (i32, buffer)
  %token_offset = index.constant 64 : offset
  %tokens = buffer.view %state[%token_offset] : buffer -> view<512xi32>
  %bounded_position = scalar.assume %position [range(%position, 0, 511)] : i32
  %index = index.cast %bounded_position : i32 to index
  view.store %token, %tokens[%index] : i32, view<512xi32>
  %next = scalar.addi %position, %one : i32
  view.store %next, %fields[3] : i32, view<16xi32>
  %packet, %complete = scf.if %is_eos -> (buffer, i32) {
    %bounded_next = scalar.assume %next [range(%next, 1, 512)] : i32
    %count = index.cast %bounded_next : i32 to index
    %stride = index.constant 4 : offset
    %length = index.scale %count, %stride : index, offset -> offset
    %ids = buffer.alloca<private> align(4) %length : buffer
    func.call @copy(%state, %token_offset, %ids, %origin, %length) : (buffer, offset, buffer, offset, offset)
    %capacity = scalar.constant 16384 : i64
    %text, %written = func.call @decode_tokens(%ids, %one, %capacity) : (buffer, i32, i64) -> (buffer, i64)
    %previous_revision = view.load %fields[4] : view<16xi32> -> i32
    %revision = scalar.addi %previous_revision, %one : i32
    view.store %revision, %fields[4] : i32, view<16xi32>
    view.store %end, %fields[5] : i32, view<16xi32>
    view.store %one, %fields[0] : i32, view<16xi32>
    %event = func.call @event(%text, %written, %revision, %end, %finished) : (buffer, i64, i32, i32, i32) -> (buffer)
    scf.yield %event, %finished : buffer, i32
  } else {
    %empty = global.load @empty : buffer
    scf.yield %empty, %zero : buffer, i32
  }
  func.return %packet, %complete : buffer, i32
}

// Predictions are compared before overwriting the old draft. The first
// mismatch contributes its replacement token; later computed KV stays allocated
// but lies beyond the next accepted position and is never read by continuation.
// A retained token suffix is only a proposal: it is recomputed against the
// corrected prefix, and two consecutive mismatches retire that proposal.
func.def @decoded(%state: buffer, %feedback: buffer, %output_offset: offset, %count: index) -> (buffer, i32) {
  %origin = index.constant 0 : offset
  %fields = buffer.view %state[%origin] : buffer -> view<16xi32>
  %token_offset = index.constant 64 : offset
  %tokens = buffer.view %state[%token_offset] : buffer -> view<512xi32>
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %zero32 = scalar.constant 0 : i32
  %eos = scalar.constant 2 : i32
  %stride = index.constant 16 : offset
  %true = scalar.constant true : i1
  %empty = global.load @empty : buffer
  %ignored, %packet, %complete = scf.for %row = [%zero to %count step %one](%accepting = %true : i1, %event = %empty : buffer, %done = %zero32 : i32) -> (i1, buffer, i32) {
    %next_accepting, %next_event, %next_done = scf.if %accepting -> (i1, buffer, i32) {
      %scaled = index.scale %row, %stride : index, offset -> offset
      %offset = index.add %output_offset, %scaled : offset
      %output = buffer.view %feedback[%offset] : buffer -> view<1xi32>
      %token = view.load %output[0] : view<1xi32> -> i32
      %position32 = view.load %fields[3] : view<16xi32> -> i32
      %draft_length = view.load %fields[7] : view<16xi32> -> i32
      %in_draft = scalar.cmpi ult, %position32, %draft_length : i32
      %matches = scf.if %in_draft -> (i1) {
        %bounded_position = scalar.assume %position32 [range(%position32, 0, 510)] : i32
        %position = index.cast %bounded_position : i32 to index
        %expected = view.load %tokens[%position] : view<512xi32> -> i32
        %equal = scalar.cmpi eq, %token, %expected : i32
        scf.yield %equal : i1
      } else {
        %false = scalar.constant false : i1
        scf.yield %false : i1
      }
      %retry32 = view.load %fields[8] : view<16xi32> -> i32
      %retry_available = scalar.cmpi eq, %retry32, %zero32 : i32
      %useful = scalar.ori %matches, %retry_available : i1
      %retained = scalar.andi %in_draft, %useful : i1
      %still_draft = scf.select %retained, %draft_length, %zero32 : i32
      view.store %still_draft, %fields[7] : i32, view<16xi32>
      %mismatch = scalar.xori %matches, %true : i1
      %retrying = scalar.andi %retained, %mismatch : i1
      %next_retry = scalar.extui %retrying : i1 to i32
      view.store %next_retry, %fields[8] : i32, view<16xi32>
      %text, %finished = func.call @decoded_token(%state, %feedback, %offset) : (buffer, buffer, offset) -> (buffer, i32)
      %not_eos = scalar.cmpi ne, %token, %eos : i32
      %more = scalar.andi %matches, %not_eos : i1
      scf.yield %more, %text, %finished : i1, buffer, i32
    } else {
      scf.yield %accepting, %event, %done : i1, buffer, i32
    }
    scf.yield %next_accepting, %next_event, %next_done : i1, buffer, i32
  }
  func.return %packet, %complete : buffer, i32
}

func.def public @complete(%model: buffer, %state: buffer, %plan: buffer, %ordinal: i64, %feedback: buffer) -> (i64, buffer, i64, i32) {
  %origin = index.constant 0 : offset
  %bounded_ordinal = scalar.assume %ordinal [range(%ordinal, 0, 3)] : i64
  %ordinal_index = index.cast %bounded_ordinal : i64 to index
  %stride = index.constant 40 : offset
  %header_length = index.constant 32 : offset
  %work_offset = index.scale %ordinal_index, %stride : index, offset -> offset
  %planned = buffer.view %plan[%work_offset] : buffer -> view<10xi32>
  %first32 = view.load %planned[8] : view<10xi32> -> i32
  %count32 = view.load %planned[9] : view<10xi32> -> i32
  %bounded_first = scalar.assume %first32 [range(%first32, 0, 15)] : i32
  %bounded_count = scalar.assume %count32 [range(%count32, 1, 4)] : i32
  %first = index.cast %bounded_first : i32 to index
  %count_rows = index.cast %bounded_count : i32 to index
  %work = buffer.alloca<private> align(8) %header_length : buffer
  func.call @copy(%plan, %work_offset, %work, %origin, %header_length) : (buffer, offset, buffer, offset, offset)
  %input = buffer.view %work[%origin] : buffer -> view<8xi32>
  %phase = view.load %input[6] : view<8xi32> -> i32
  %zero = scalar.constant 0 : i32
  %one = scalar.constant 1 : i32
  %zero64 = scalar.constant 0 : i64
  %empty = global.load @empty : buffer
  %output_stride = index.constant 16 : offset
  %output_offset = index.scale %first, %output_stride : index, offset -> offset
  %initializing = scalar.cmpi eq, %phase, %zero : i32
  %count, %packet, %complete = scf.if %initializing -> (i64, buffer, i32) {
    %fields = buffer.view %state[%origin] : buffer -> view<16xi32>
    view.store %one, %fields[0] : i32, view<16xi32>
    scf.yield %zero64, %empty, %zero : i64, buffer, i32
  } else {
    %encoding = scalar.cmpi eq, %phase, %one : i32
    %consumed, %event, %done = scf.if %encoding -> (i64, buffer, i32) {
      %frames, %transcript, %finished = func.call @encoded(%state, %work, %feedback, %output_offset) : (buffer, buffer, buffer, offset) -> (i64, buffer, i32)
      scf.yield %frames, %transcript, %finished : i64, buffer, i32
    } else {
      %transcript, %finished = func.call @decoded(%state, %feedback, %output_offset, %count_rows) : (buffer, buffer, offset, index) -> (buffer, i32)
      scf.yield %zero64, %transcript, %finished : i64, buffer, i32
    }
    scf.yield %consumed, %event, %done : i64, buffer, i32
  }
  %packet_length = buffer.length %packet
  %packet_bytes = index.cast %packet_length : offset to i64
  func.return %count, %packet, %packet_bytes, %complete : i64, buffer, i64, i32
}
