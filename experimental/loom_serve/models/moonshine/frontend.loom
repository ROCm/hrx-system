// 80-sample frames are normalized and compressed before the learned projection.
// Four frames form one 20 ms encoder quantum; the final quantum is zero-padded.
target.decl @moonshine

config.decl @moonshine.threads : index

kernel.def target(@moonshine) @moonshine.frontend.frames() {
  %items = index.constant 320 : index
  %threads = config.get @moonshine.threads : index
  %c1 = index.constant 1 : index
  %tail = index.sub %threads, %c1 : index
  %rounded = index.add %items, %tail : index
  %groups = index.div %rounded, %threads : index
  %capacity = index.constant 4 : index
  kernel.launch.config workgroups(%groups, %capacity, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%work_storage: buffer, %y: view<4x80x4xf32>, %cohort: view<5xi32>, %row_x_base: offset, %row_gate_base: offset) {
  %group = kernel.workgroup.id<x> : index
  %packed_value = kernel.workgroup.id<y> : index
  %packed = index.assume %packed_value [range(%packed_value, 0, 3)] : index
  %count32 = view.load %cohort[0] : view<5xi32> -> i32
  %bounded_count = scalar.assume %count32 [range(%count32, 0, 4)] : i32
  %count = index.cast %bounded_count : i32 to index
  %active = index.cmp ult, %packed, %count : index
  %threads = config.get @moonshine.threads : index
  %lane = kernel.workitem.id<x> : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %element = index.madd %group, %threads, %lane : index
  %limit = index.constant 320 : index
  %live = index.cmp ult, %element, %limit : index
  %participating = scalar.andi %active, %live : i1
  %f0 = scalar.constant 0.0 : f32
  scf.if %participating {
    %member = index.add %packed, %c1 : index
    %resident32 = view.load %cohort[%member] : view<5xi32> -> i32
    %bounded_resident = scalar.assume %resident32 [range(%resident32, 0, 3)] : i32
    %resident = index.cast %bounded_resident : i32 to index
    %row_x_stride = index.constant 1312 : offset
    %row_x_row = index.scale %packed, %row_x_stride : index, offset -> offset
    %row_x_offset = index.add %row_x_row, %row_x_base : offset
    %row_x = buffer.view %work_storage[%row_x_offset] : buffer -> view<320xf32>
    %row_gate_stride = index.constant 1312 : offset
    %row_gate_row = index.scale %packed, %row_gate_stride : index, offset -> offset
    %row_gate_offset = index.add %row_gate_row, %row_gate_base : offset
    %row_gate = buffer.view %work_storage[%row_gate_offset] : buffer -> view<6xi32>
    %gate32 = view.load %row_gate[4] : view<6xi32> -> i32
    %zero32 = scalar.constant 0 : i32
    %enabled = scalar.cmpi ne, %gate32, %zero32 : i32
    scf.if %enabled {
      %width = index.constant 4 : index
      %row = index.div %element, %width : index
      %column = index.rem %element, %width : index
      %frame_size = index.constant 80 : index
      %sample = index.madd %column, %frame_size, %row : index
      %value = view.load %row_x[%sample] : view<320xf32> -> f32
      view.store %value, %y[%packed, %row, %column] : f32, view<4x80x4xf32>
    }
  }
  kernel.return
}

kernel.def target(@moonshine) @moonshine.frontend.normalize_frames() {
  %items = index.constant 4 : index
  %threads = config.get @moonshine.threads : index
  %c1 = index.constant 1 : index
  %tail = index.sub %threads, %c1 : index
  %rounded = index.add %items, %tail : index
  %groups = index.div %rounded, %threads : index
  %capacity = index.constant 4 : index
  kernel.launch.config workgroups(%groups, %capacity, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%x: view<4x80x4xf32>, %y: view<4x80x4xf32>, %work_storage: buffer, %cohort: view<5xi32>, %row_gate_base: offset) {
  %group = kernel.workgroup.id<x> : index
  %packed_value = kernel.workgroup.id<y> : index
  %packed = index.assume %packed_value [range(%packed_value, 0, 3)] : index
  %count32 = view.load %cohort[0] : view<5xi32> -> i32
  %bounded_count = scalar.assume %count32 [range(%count32, 0, 4)] : i32
  %count = index.cast %bounded_count : i32 to index
  %active = index.cmp ult, %packed, %count : index
  %threads = config.get @moonshine.threads : index
  %lane = kernel.workitem.id<x> : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %element = index.madd %group, %threads, %lane : index
  %limit = index.constant 4 : index
  %live = index.cmp ult, %element, %limit : index
  %participating = scalar.andi %active, %live : i1
  %f0 = scalar.constant 0.0 : f32
  scf.if %participating {
    %member = index.add %packed, %c1 : index
    %resident32 = view.load %cohort[%member] : view<5xi32> -> i32
    %bounded_resident = scalar.assume %resident32 [range(%resident32, 0, 3)] : i32
    %resident = index.cast %bounded_resident : i32 to index
    %row_gate_stride = index.constant 1312 : offset
    %row_gate_row = index.scale %packed, %row_gate_stride : index, offset -> offset
    %row_gate_offset = index.add %row_gate_row, %row_gate_base : offset
    %row_gate = buffer.view %work_storage[%row_gate_offset] : buffer -> view<6xi32>
    %gate32 = view.load %row_gate[4] : view<6xi32> -> i32
    %zero32 = scalar.constant 0 : i32
    %enabled = scalar.cmpi ne, %gate32, %zero32 : i32
    scf.if %enabled {

      %channels = index.constant 80 : index
      %divisor = scalar.constant 80.0 : f32
      %total = scf.for %channel = [%c0 to %channels step %c1](%acc = %f0 : f32) -> (f32) {
        %input = view.load %x[%packed, %channel, %element] : view<4x80x4xf32> -> f32
        %next = scalar.addf %acc, %input : f32
        scf.yield %next : f32
      }
      %mean = scalar.divf %total, %divisor : f32
      %squared = scf.for %channel = [%c0 to %channels step %c1](%acc = %f0 : f32) -> (f32) {
        %input = view.load %x[%packed, %channel, %element] : view<4x80x4xf32> -> f32
        %centered = scalar.subf %input, %mean : f32
        %next = scalar.fmaf %centered, %centered, %acc : f32
        scf.yield %next : f32
      }
      %variance = scalar.divf %squared, %divisor : f32
      %epsilon = scalar.constant 9.9999999999999995e-07 : f32
      %stabilized = scalar.addf %variance, %epsilon : f32
      %inverse = scalar.rsqrtf<afn> %stabilized : f32
      scf.for %channel = [%c0 to %channels step %c1] {
        %input = view.load %x[%packed, %channel, %element] : view<4x80x4xf32> -> f32
        %centered = scalar.subf %input, %mean : f32
        %normalized = scalar.mulf %centered, %inverse : f32
        %factor = scalar.constant 1.0 : f32
        %scaled = scalar.mulf %normalized, %factor : f32
        %output = scalar.addf %scaled, %f0 : f32
        view.store %output, %y[%packed, %channel, %element] : f32, view<4x80x4xf32>
      }
    }
  }
  kernel.return
}

kernel.def target(@moonshine) @moonshine.frontend.compress() {
  %items = index.constant 320 : index
  %threads = config.get @moonshine.threads : index
  %c1 = index.constant 1 : index
  %tail = index.sub %threads, %c1 : index
  %rounded = index.add %items, %tail : index
  %groups = index.div %rounded, %threads : index
  %capacity = index.constant 4 : index
  kernel.launch.config workgroups(%groups, %capacity, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%x: view<4x80x4xf32>, %k: view<1xf32>, %y: view<4x80x4xf32>, %work_storage: buffer, %cohort: view<5xi32>, %row_gate_base: offset) {
  %group = kernel.workgroup.id<x> : index
  %packed_value = kernel.workgroup.id<y> : index
  %packed = index.assume %packed_value [range(%packed_value, 0, 3)] : index
  %count32 = view.load %cohort[0] : view<5xi32> -> i32
  %bounded_count = scalar.assume %count32 [range(%count32, 0, 4)] : i32
  %count = index.cast %bounded_count : i32 to index
  %active = index.cmp ult, %packed, %count : index
  %threads = config.get @moonshine.threads : index
  %lane = kernel.workitem.id<x> : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %element = index.madd %group, %threads, %lane : index
  %limit = index.constant 320 : index
  %live = index.cmp ult, %element, %limit : index
  %participating = scalar.andi %active, %live : i1
  %f0 = scalar.constant 0.0 : f32
  scf.if %participating {
    %member = index.add %packed, %c1 : index
    %resident32 = view.load %cohort[%member] : view<5xi32> -> i32
    %bounded_resident = scalar.assume %resident32 [range(%resident32, 0, 3)] : i32
    %resident = index.cast %bounded_resident : i32 to index
    %row_gate_stride = index.constant 1312 : offset
    %row_gate_row = index.scale %packed, %row_gate_stride : index, offset -> offset
    %row_gate_offset = index.add %row_gate_row, %row_gate_base : offset
    %row_gate = buffer.view %work_storage[%row_gate_offset] : buffer -> view<6xi32>
    %gate32 = view.load %row_gate[4] : view<6xi32> -> i32
    %zero32 = scalar.constant 0 : i32
    %enabled = scalar.cmpi ne, %gate32, %zero32 : i32
    scf.if %enabled {
      %width = index.constant 4 : index
      %row = index.div %element, %width : index
      %column = index.rem %element, %width : index
      %value = view.load %x[%packed, %row, %column] : view<4x80x4xf32> -> f32
      %log_k = view.load %k[0] : view<1xf32> -> f32
      %k_value = scalar.expf<afn> %log_k : f32
      %scaled = scalar.mulf %value, %k_value : f32
      %compressed = scalar.asinhf<afn> %scaled : f32
      view.store %compressed, %y[%packed, %row, %column] : f32, view<4x80x4xf32>
    }
  }
  kernel.return
}

kernel.def target(@moonshine) @moonshine.frontend.project() {
  %items = index.constant 1280 : index
  %threads = config.get @moonshine.threads : index
  %c1 = index.constant 1 : index
  %tail = index.sub %threads, %c1 : index
  %rounded = index.add %items, %tail : index
  %groups = index.div %rounded, %threads : index
  %capacity = index.constant 4 : index
  kernel.launch.config workgroups(%groups, %capacity, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%x: view<4x80x4xf32>, %w: view<320x80xf32>, %y: view<4x320x4xf32>, %work_storage: buffer, %cohort: view<5xi32>, %row_gate_base: offset) {
  %group = kernel.workgroup.id<x> : index
  %packed_value = kernel.workgroup.id<y> : index
  %packed = index.assume %packed_value [range(%packed_value, 0, 3)] : index
  %count32 = view.load %cohort[0] : view<5xi32> -> i32
  %bounded_count = scalar.assume %count32 [range(%count32, 0, 4)] : i32
  %count = index.cast %bounded_count : i32 to index
  %active = index.cmp ult, %packed, %count : index
  %threads = config.get @moonshine.threads : index
  %lane = kernel.workitem.id<x> : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %element = index.madd %group, %threads, %lane : index
  %limit = index.constant 1280 : index
  %live = index.cmp ult, %element, %limit : index
  %participating = scalar.andi %active, %live : i1
  %f0 = scalar.constant 0.0 : f32
  scf.if %participating {
    %member = index.add %packed, %c1 : index
    %resident32 = view.load %cohort[%member] : view<5xi32> -> i32
    %bounded_resident = scalar.assume %resident32 [range(%resident32, 0, 3)] : i32
    %resident = index.cast %bounded_resident : i32 to index
    %row_gate_stride = index.constant 1312 : offset
    %row_gate_row = index.scale %packed, %row_gate_stride : index, offset -> offset
    %row_gate_offset = index.add %row_gate_row, %row_gate_base : offset
    %row_gate = buffer.view %work_storage[%row_gate_offset] : buffer -> view<6xi32>
    %gate32 = view.load %row_gate[4] : view<6xi32> -> i32
    %zero32 = scalar.constant 0 : i32
    %enabled = scalar.cmpi ne, %gate32, %zero32 : i32
    scf.if %enabled {
      %width = index.constant 4 : index
      %row = index.div %element, %width : index
      %column = index.rem %element, %width : index
      %inputs = index.constant 80 : index
      %stride = index.constant 8 : index
      %result0, %result1, %result2, %result3, %result4, %result5, %result6, %result7 = scf.for %base = [%c0 to %inputs step %stride](%acc0 = %f0 : f32, %acc1 = %f0 : f32, %acc2 = %f0 : f32, %acc3 = %f0 : f32, %acc4 = %f0 : f32, %acc5 = %f0 : f32, %acc6 = %f0 : f32, %acc7 = %f0 : f32) -> (f32, f32, f32, f32, f32, f32, f32, f32) {
        %offset0 = index.constant 0 : index
        %i0 = index.add %base, %offset0 : index
        %input0 = view.load %x[%packed, %i0, %column] : view<4x80x4xf32> -> f32
        %weight0 = view.load %w[%row, %i0] : view<320x80xf32> -> f32
        %next0 = scalar.fmaf %input0, %weight0, %acc0 : f32
        %offset1 = index.constant 1 : index
        %i1 = index.add %base, %offset1 : index
        %input1 = view.load %x[%packed, %i1, %column] : view<4x80x4xf32> -> f32
        %weight1 = view.load %w[%row, %i1] : view<320x80xf32> -> f32
        %next1 = scalar.fmaf %input1, %weight1, %acc1 : f32
        %offset2 = index.constant 2 : index
        %i2 = index.add %base, %offset2 : index
        %input2 = view.load %x[%packed, %i2, %column] : view<4x80x4xf32> -> f32
        %weight2 = view.load %w[%row, %i2] : view<320x80xf32> -> f32
        %next2 = scalar.fmaf %input2, %weight2, %acc2 : f32
        %offset3 = index.constant 3 : index
        %i3 = index.add %base, %offset3 : index
        %input3 = view.load %x[%packed, %i3, %column] : view<4x80x4xf32> -> f32
        %weight3 = view.load %w[%row, %i3] : view<320x80xf32> -> f32
        %next3 = scalar.fmaf %input3, %weight3, %acc3 : f32
        %offset4 = index.constant 4 : index
        %i4 = index.add %base, %offset4 : index
        %input4 = view.load %x[%packed, %i4, %column] : view<4x80x4xf32> -> f32
        %weight4 = view.load %w[%row, %i4] : view<320x80xf32> -> f32
        %next4 = scalar.fmaf %input4, %weight4, %acc4 : f32
        %offset5 = index.constant 5 : index
        %i5 = index.add %base, %offset5 : index
        %input5 = view.load %x[%packed, %i5, %column] : view<4x80x4xf32> -> f32
        %weight5 = view.load %w[%row, %i5] : view<320x80xf32> -> f32
        %next5 = scalar.fmaf %input5, %weight5, %acc5 : f32
        %offset6 = index.constant 6 : index
        %i6 = index.add %base, %offset6 : index
        %input6 = view.load %x[%packed, %i6, %column] : view<4x80x4xf32> -> f32
        %weight6 = view.load %w[%row, %i6] : view<320x80xf32> -> f32
        %next6 = scalar.fmaf %input6, %weight6, %acc6 : f32
        %offset7 = index.constant 7 : index
        %i7 = index.add %base, %offset7 : index
        %input7 = view.load %x[%packed, %i7, %column] : view<4x80x4xf32> -> f32
        %weight7 = view.load %w[%row, %i7] : view<320x80xf32> -> f32
        %next7 = scalar.fmaf %input7, %weight7, %acc7 : f32
        scf.yield %next0, %next1, %next2, %next3, %next4, %next5, %next6, %next7 : f32, f32, f32, f32, f32, f32, f32, f32
      }
      %sum0_0 = scalar.addf %result0, %result1 : f32
      %sum0_2 = scalar.addf %result2, %result3 : f32
      %sum0_4 = scalar.addf %result4, %result5 : f32
      %sum0_6 = scalar.addf %result6, %result7 : f32
      %sum1_0 = scalar.addf %sum0_0, %sum0_2 : f32
      %sum1_2 = scalar.addf %sum0_4, %sum0_6 : f32
      %sum = scalar.addf %sum1_0, %sum1_2 : f32

      view.store %sum, %y[%packed, %row, %column] : f32, view<4x320x4xf32>
    }
  }
  kernel.return
}

kernel.def target(@moonshine) @moonshine.frontend.activate_embedding() {
  %items = index.constant 1280 : index
  %threads = config.get @moonshine.threads : index
  %c1 = index.constant 1 : index
  %tail = index.sub %threads, %c1 : index
  %rounded = index.add %items, %tail : index
  %groups = index.div %rounded, %threads : index
  %capacity = index.constant 4 : index
  kernel.launch.config workgroups(%groups, %capacity, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%x: view<4x320x4xf32>, %y: view<4x320x4xf32>, %work_storage: buffer, %cohort: view<5xi32>, %row_gate_base: offset) {
  %group = kernel.workgroup.id<x> : index
  %packed_value = kernel.workgroup.id<y> : index
  %packed = index.assume %packed_value [range(%packed_value, 0, 3)] : index
  %count32 = view.load %cohort[0] : view<5xi32> -> i32
  %bounded_count = scalar.assume %count32 [range(%count32, 0, 4)] : i32
  %count = index.cast %bounded_count : i32 to index
  %active = index.cmp ult, %packed, %count : index
  %threads = config.get @moonshine.threads : index
  %lane = kernel.workitem.id<x> : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %element = index.madd %group, %threads, %lane : index
  %limit = index.constant 1280 : index
  %live = index.cmp ult, %element, %limit : index
  %participating = scalar.andi %active, %live : i1
  %f0 = scalar.constant 0.0 : f32
  scf.if %participating {
    %member = index.add %packed, %c1 : index
    %resident32 = view.load %cohort[%member] : view<5xi32> -> i32
    %bounded_resident = scalar.assume %resident32 [range(%resident32, 0, 3)] : i32
    %resident = index.cast %bounded_resident : i32 to index
    %row_gate_stride = index.constant 1312 : offset
    %row_gate_row = index.scale %packed, %row_gate_stride : index, offset -> offset
    %row_gate_offset = index.add %row_gate_row, %row_gate_base : offset
    %row_gate = buffer.view %work_storage[%row_gate_offset] : buffer -> view<6xi32>
    %gate32 = view.load %row_gate[4] : view<6xi32> -> i32
    %zero32 = scalar.constant 0 : i32
    %enabled = scalar.cmpi ne, %gate32, %zero32 : i32
    scf.if %enabled {
      %width = index.constant 4 : index
      %row = index.div %element, %width : index
      %column = index.rem %element, %width : index
      %value = view.load %x[%packed, %row, %column] : view<4x320x4xf32> -> f32
      %negative = scalar.subf %f0, %value : f32
      %exponential = scalar.expf<afn> %negative : f32
      %f1 = scalar.constant 1.0 : f32
      %denominator = scalar.addf %f1, %exponential : f32
      %activated = scalar.divf %value, %denominator : f32
      view.store %activated, %y[%packed, %row, %column] : f32, view<4x320x4xf32>
    }
  }
  kernel.return
}
