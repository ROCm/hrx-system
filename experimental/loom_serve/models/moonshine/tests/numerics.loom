amdgpu.target<gfx11-generic> @moonshine {subgroup_size = 32}

config.def @moonshine.threads = 128 : index

kernel.decl @moonshine.frontend.normalize_frames() launch(%x: view<4x80x4xf32>, %y: view<4x80x4xf32>, %work: buffer, %cohort: view<5xi32>, %gate_origin: offset)

global.rodata.def @members = bytes("0200000003000000010000000000000000000000")

func.def @initialize_cohort(%cohort: buffer, %work: buffer) {
  %zero = index.constant 0 : offset
  %bytes = index.constant 20 : offset
  %members = global.load @members : buffer
  buffer.copy %members[%zero], %cohort[%zero], %bytes
  %words = buffer.view %work[%zero] : buffer -> view<1320xi32>
  %one = scalar.constant 1 : i32
  view.store %one, %words[12] : i32, view<1320xi32>
  view.store %one, %words[340] : i32, view<1320xi32>
  func.return
}

// Each frame has channel step one, mean 39.5 plus its frame offset, and
// variance (80^2 - 1)/12. The inverse below includes the source's 1e-6 epsilon.
func.def @normalization_reference(%input: buffer, %storage: buffer, %work: buffer, %cohort: buffer, %gate: offset) {
  %origin = index.constant 0 : offset
  %output = buffer.view %storage[%origin] : buffer -> view<4x80x4xf32>
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %rows = index.constant 2 : index
  %channels = index.constant 80 : index
  %frames = index.constant 4 : index
  %mean = scalar.constant 39.5 : f64
  %inverse = scalar.constant 0.043304653456837608 : f64
  scf.for %row = [%zero to %rows step %one] {
    scf.for %channel = [%zero to %channels step %one] {
      %channel_word = index.cast %channel : index to i32
      %channel_value = scalar.sitofp %channel_word : i32 to f64
      %centered = scalar.subf %channel_value, %mean : f64
      %result = scalar.mulf %centered, %inverse : f64
      %value = scalar.fptrunc %result : f64 to f32
      scf.for %frame = [%zero to %frames step %one] {
        view.store %value, %output[%row, %channel, %frame] : f32, view<4x80x4xf32>
      }
    }
  }
  func.return
}

check.scenario public @independent_frame_normalization {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %cohort = check.generate.fill value(0) : view<5xi32>
    %work = check.generate.fill value(0) : tensor<1320xi32>
    check.generate<@initialize_cohort>(%cohort, %work) : (view<5xi32>, tensor<1320xi32>) -> ()
    %input = check.generate.iota offset(-10.0) step(0.25) : view<4x80x4xf32>
    %output = check.generate.fill value(-123.0) : view<4x80x4xf32>
    %gate = check.literal value(32) : offset
    check.compare<@moonshine.frontend.normalize_frames, @normalization_reference>(%input, %output, %work, %cohort, %gate) : (view<4x80x4xf32>, view<4x80x4xf32>, tensor<1320xi32>, view<5xi32>, offset) -> () {
      check.expect.close actual(%output) expected(%output) atol(1.9999999999999999e-06) rtol(1.9999999999999999e-06) nan(different) : view<4x80x4xf32>
    }
  }
  check.return
}
