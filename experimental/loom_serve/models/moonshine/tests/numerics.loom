amdgpu.target<gfx11-generic> @moonshine {subgroup_size = 32}

config.def @moonshine.threads = 128 : index

kernel.decl @moonshine.projection.decoder() launch(%x: view<4x320x1xf32>, %w: view<320x320xf32>, %y: view<4x320x1xf32>, %cohort: view<5xi32>)

kernel.decl @moonshine.frontend.normalize_frames() launch(%x: view<4x80x4xf32>, %y: view<4x80x4xf32>, %work: buffer, %cohort: view<5xi32>, %gate_origin: offset)

global.rodata.def @members = bytes("0200000003000000010000000000000000000000")

func.def @initialize_cohort(%cohort: buffer, %work: buffer) {
  %zero = index.constant 0 : offset
  %bytes = index.constant 20 : offset
  %members = global.load @members : buffer
  buffer.copy %members[%zero], %cohort[%zero], %bytes
  %words = buffer.view %work[%zero] : buffer -> view<1320xi32>
  %one = scalar.constant 1 : i32
  view.store %one, %words[12] : i32, view<1320xi32>
  view.store %one, %words[340] : i32, view<1320xi32>
  func.return
}

// X[r,i] = 1/4 + 40*r + i/8; W[o,i] = 5*o/16 - 1/2 + i/1024.
// Integrating their product over i=0..319 gives this closed-form F64 oracle.
// It shares neither the projection loop nor its eight-lane reduction tree.
func.def @projection_reference(%input: buffer, %weights: buffer, %storage: buffer, %cohort: buffer) {
  %origin = index.constant 0 : offset
  %output = buffer.view %storage[%origin] : buffer -> view<4x320x1xf32>
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %rows = index.constant 2 : index
  %columns = index.constant 320 : index
  %quarter = scalar.constant 0.25 : f64
  %forty = scalar.constant 40.0 : f64
  %weight_step = scalar.constant 0.3125 : f64
  %negative_half = scalar.constant -0.5 : f64
  %count = scalar.constant 320.0 : f64
  %input_step = scalar.constant 0.125 : f64
  %weight_input_step = scalar.constant 0.0009765625 : f64
  %sum = scalar.constant 51040.0 : f64
  %square_term = scalar.constant 1327.08984375 : f64
  scf.for %row = [%zero to %rows step %one] {
    %row_word = index.cast %row : index to i32
    %row_value = scalar.sitofp %row_word : i32 to f64
    %row_offset = scalar.mulf %row_value, %forty : f64
    %a = scalar.addf %row_offset, %quarter : f64
    scf.for %column = [%zero to %columns step %one] {
      %column_word = index.cast %column : index to i32
      %column_value = scalar.sitofp %column_word : i32 to f64
      %weight_offset = scalar.mulf %column_value, %weight_step : f64
      %b = scalar.addf %weight_offset, %negative_half : f64
      %ab = scalar.mulf %a, %b : f64
      %constant_term = scalar.mulf %ab, %count : f64
      %linear_a = scalar.mulf %a, %weight_input_step : f64
      %linear_b = scalar.mulf %b, %input_step : f64
      %linear = scalar.addf %linear_a, %linear_b : f64
      %linear_term = scalar.mulf %linear, %sum : f64
      %partial = scalar.addf %constant_term, %linear_term : f64
      %result = scalar.addf %partial, %square_term : f64
      %value = scalar.fptrunc %result : f64 to f32
      view.store %value, %output[%row, %column, 0] : f32, view<4x320x1xf32>
    }
  }
  func.return
}

check.scenario public @shared_projection_independent_rows {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %cohort = check.generate.fill value(0) : view<5xi32>
    %work = check.generate.fill value(0) : tensor<1320xi32>
    check.generate<@initialize_cohort>(%cohort, %work) : (view<5xi32>, tensor<1320xi32>) -> ()
    %input = check.generate.iota offset(0.25) step(0.125) : view<4x320x1xf32>
    %weights = check.generate.iota offset(-0.5) step(0.0009765625) : view<320x320xf32>
    %output = check.generate.fill value(-123.0) : view<4x320x1xf32>
    check.compare<@moonshine.projection.decoder, @projection_reference>(%input, %weights, %output, %cohort) : (view<4x320x1xf32>, view<320x320xf32>, view<4x320x1xf32>, view<5xi32>) -> () {
      check.expect.close actual(%output) expected(%output) atol(0.001) rtol(1.9999999999999999e-06) nan(different) : view<4x320x1xf32>
    }
  }
  check.return
}

// Each frame has channel step one, mean 39.5 plus its frame offset, and
// variance (80^2 - 1)/12. The inverse below includes the source's 1e-6 epsilon.
func.def @normalization_reference(%input: buffer, %storage: buffer, %work: buffer, %cohort: buffer, %gate: offset) {
  %origin = index.constant 0 : offset
  %output = buffer.view %storage[%origin] : buffer -> view<4x80x4xf32>
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %rows = index.constant 2 : index
  %channels = index.constant 80 : index
  %frames = index.constant 4 : index
  %mean = scalar.constant 39.5 : f64
  %inverse = scalar.constant 0.043304653456837608 : f64
  scf.for %row = [%zero to %rows step %one] {
    scf.for %channel = [%zero to %channels step %one] {
      %channel_word = index.cast %channel : index to i32
      %channel_value = scalar.sitofp %channel_word : i32 to f64
      %centered = scalar.subf %channel_value, %mean : f64
      %result = scalar.mulf %centered, %inverse : f64
      %value = scalar.fptrunc %result : f64 to f32
      scf.for %frame = [%zero to %frames step %one] {
        view.store %value, %output[%row, %channel, %frame] : f32, view<4x80x4xf32>
      }
    }
  }
  func.return
}

check.scenario public @independent_frame_normalization {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %cohort = check.generate.fill value(0) : view<5xi32>
    %work = check.generate.fill value(0) : tensor<1320xi32>
    check.generate<@initialize_cohort>(%cohort, %work) : (view<5xi32>, tensor<1320xi32>) -> ()
    %input = check.generate.iota offset(-10.0) step(0.25) : view<4x80x4xf32>
    %output = check.generate.fill value(-123.0) : view<4x80x4xf32>
    %gate = check.literal value(32) : offset
    check.compare<@moonshine.frontend.normalize_frames, @normalization_reference>(%input, %output, %work, %cohort, %gate) : (view<4x80x4xf32>, view<4x80x4xf32>, tensor<1320xi32>, view<5xi32>, offset) -> () {
      check.expect.close actual(%output) expected(%output) atol(1.9999999999999999e-06) rtol(1.9999999999999999e-06) nan(different) : view<4x80x4xf32>
    }
  }
  check.return
}
