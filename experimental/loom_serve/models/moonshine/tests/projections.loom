amdgpu.target<gfx11-generic> @moonshine {subgroup_size = 32}

config.def @moonshine.threads = 128 : index

func.def @projection_members(%trial: index, %storage: buffer) {
  %origin = index.constant 0 : offset
  %members = buffer.view %storage[%origin] : buffer -> view<17xi32>
  %trial32 = index.cast %trial : index to i32
  %one = scalar.constant 1 : i32
  %zero = scalar.constant 0 : i32
  %two = scalar.constant 2 : i32
  %three = scalar.constant 3 : i32
  %count = scalar.addi %trial32, %one : i32
  view.store %count, %members[0] : i32, view<17xi32>
  view.store %three, %members[1] : i32, view<17xi32>
  view.store %one, %members[2] : i32, view<17xi32>
  view.store %zero, %members[3] : i32, view<17xi32>
  view.store %two, %members[4] : i32, view<17xi32>
  func.return
}

// Integrate X[r,k] = 1/4 + (r*K+k)/8 and W[n,k] = -1/2 + (n*K+k)/1024.
// The polynomial sums are independent of the device dot-product/reduction loops.
func.def @projection_integral(%storage: buffer, %cohort: buffer, %input_count: i32, %output_count: i32, %biased: i32) {
  %origin = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %columns = index.cast %output_count : i32 to index
  %output = buffer.view %storage[%origin] : buffer -> view<16x[%columns]x1xf32>
  %members = buffer.view %cohort[%origin] : buffer -> view<17xi32>
  %count32 = view.load %members[0] : view<17xi32> -> i32
  %bounded_count = scalar.assume %count32 [range(%count32, 0, 16)] : i32
  %rows = index.cast %bounded_count : i32 to index
  %k = scalar.sitofp %input_count : i32 to f64
  %one64 = scalar.constant 1.0 : f64
  %two64 = scalar.constant 2.0 : f64
  %half = scalar.constant 0.5 : f64
  %sixth = scalar.constant 0.16666666666666666 : f64
  %quarter = scalar.constant 0.25 : f64
  %negative_half = scalar.constant -0.5 : f64
  %input_step = scalar.constant 0.125 : f64
  %weight_step = scalar.constant 0.0009765625 : f64
  %cross_step = scalar.constant 0.0001220703125 : f64
  %bias_first = scalar.constant -64.0 : f64
  %bias_step = scalar.constant 16.0 : f64
  %zero32 = scalar.constant 0 : i32
  %has_bias = scalar.cmpi ne, %biased, %zero32 : i32
  %previous = scalar.subf %k, %one64 : f64
  %product = scalar.mulf %k, %previous : f64
  %sum = scalar.mulf %product, %half : f64
  %twice = scalar.mulf %k, %two64 : f64
  %odd = scalar.subf %twice, %one64 : f64
  %square_product = scalar.mulf %product, %odd : f64
  %squares = scalar.mulf %square_product, %sixth : f64
  %square_term = scalar.mulf %squares, %cross_step : f64
  %input_row_step = scalar.mulf %k, %input_step : f64
  %weight_row_step = scalar.mulf %k, %weight_step : f64
  scf.for %row = [%zero to %rows step %one] {
    %row32 = index.cast %row : index to i32
    %row64 = scalar.sitofp %row32 : i32 to f64
    %input_offset = scalar.mulf %row64, %input_row_step : f64
    %a = scalar.addf %quarter, %input_offset : f64
    scf.for %column = [%zero to %columns step %one] {
      %column32 = index.cast %column : index to i32
      %column64 = scalar.sitofp %column32 : i32 to f64
      %weight_offset = scalar.mulf %column64, %weight_row_step : f64
      %b = scalar.addf %negative_half, %weight_offset : f64
      %ab = scalar.mulf %a, %b : f64
      %constant = scalar.mulf %ab, %k : f64
      %linear_a = scalar.mulf %a, %weight_step : f64
      %linear_b = scalar.mulf %b, %input_step : f64
      %linear = scalar.addf %linear_a, %linear_b : f64
      %linear_term = scalar.mulf %linear, %sum : f64
      %partial = scalar.addf %constant, %linear_term : f64
      %dot = scalar.addf %partial, %square_term : f64
      %result = scf.if %has_bias -> (f64) {
        %offset = scalar.mulf %column64, %bias_step : f64
        %bias = scalar.addf %bias_first, %offset : f64
        %value = scalar.addf %dot, %bias : f64
        scf.yield %value : f64
      } else {
        scf.yield %dot : f64
      }
      %value = scalar.fptrunc %result : f64 to f32
      view.store %value, %output[%row, %column, 0] : f32, view<16x[%columns]x1xf32>
    }
  }
  func.return
}

kernel.decl @moonshine.projection.decoder() launch(%x: view<16x320x1xf32>, %w: view<320x320xf32>, %y: view<16x320x1xf32>, %cohort: view<17xi32>)

func.def @decoder_reference(%input: buffer, %weight: buffer, %output: buffer, %cohort: buffer) {
  %inputs = scalar.constant 320 : i32
  %outputs = scalar.constant 320 : i32
  %biased = scalar.constant 0 : i32
  func.call @projection_integral(%output, %cohort, %inputs, %outputs, %biased) : (buffer, buffer, i32, i32, i32)
  func.return
}

check.scenario public @decoder_independent_rows {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[16](%trial: index, %entropy: check.entropy) {
    %cohort = check.generate.fill value(0) : view<17xi32>
    check.generate<@projection_members>(%trial, %cohort) : (index, view<17xi32>) -> ()
    %input = check.generate.iota offset(0.25) step(0.125) : view<16x320x1xf32>
    %weight = check.generate.iota offset(-0.5) step(0.0009765625) : view<320x320xf32>
    %output = check.generate.fill value(-123.0) : view<16x320x1xf32>
    check.compare<@moonshine.projection.decoder, @decoder_reference>(%input, %weight, %output, %cohort) : (view<16x320x1xf32>, view<320x320xf32>, view<16x320x1xf32>, view<17xi32>) -> () {
      check.expect.close actual(%output) expected(%output) atol(0.001) rtol(1.9999999999999999e-06) nan(different) : view<16x320x1xf32>
    }
  }
  check.return
}

kernel.decl @moonshine.projection.decoder_up() launch(%x: view<16x320x1xf32>, %w: view<2560x320xf32>, %y: view<16x2560x1xf32>, %b: view<2560xf32>, %cohort: view<17xi32>)

func.def @decoder_up_reference(%input: buffer, %weight: buffer, %output: buffer, %bias: buffer, %cohort: buffer) {
  %inputs = scalar.constant 320 : i32
  %outputs = scalar.constant 2560 : i32
  %biased = scalar.constant 1 : i32
  func.call @projection_integral(%output, %cohort, %inputs, %outputs, %biased) : (buffer, buffer, i32, i32, i32)
  func.return
}

check.scenario public @decoder_up_independent_rows {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[16](%trial: index, %entropy: check.entropy) {
    %cohort = check.generate.fill value(0) : view<17xi32>
    check.generate<@projection_members>(%trial, %cohort) : (index, view<17xi32>) -> ()
    %input = check.generate.iota offset(0.25) step(0.125) : view<16x320x1xf32>
    %weight = check.generate.iota offset(-0.5) step(0.0009765625) : view<2560x320xf32>
    %output = check.generate.fill value(-123.0) : view<16x2560x1xf32>
    %bias = check.generate.iota offset(-64.0) step(16.0) : view<2560xf32>
    check.compare<@moonshine.projection.decoder_up, @decoder_up_reference>(%input, %weight, %output, %bias, %cohort) : (view<16x320x1xf32>, view<2560x320xf32>, view<16x2560x1xf32>, view<2560xf32>, view<17xi32>) -> () {
      check.expect.close actual(%output) expected(%output) atol(0.001) rtol(1.9999999999999999e-06) nan(different) : view<16x2560x1xf32>
    }
  }
  check.return
}

kernel.decl @moonshine.projection.decoder_down() launch(%x: view<16x1280x1xf32>, %w: view<320x1280xf32>, %y: view<16x320x1xf32>, %b: view<320xf32>, %cohort: view<17xi32>)

func.def @decoder_down_reference(%input: buffer, %weight: buffer, %output: buffer, %bias: buffer, %cohort: buffer) {
  %inputs = scalar.constant 1280 : i32
  %outputs = scalar.constant 320 : i32
  %biased = scalar.constant 1 : i32
  func.call @projection_integral(%output, %cohort, %inputs, %outputs, %biased) : (buffer, buffer, i32, i32, i32)
  func.return
}

check.scenario public @decoder_down_independent_rows {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[16](%trial: index, %entropy: check.entropy) {
    %cohort = check.generate.fill value(0) : view<17xi32>
    check.generate<@projection_members>(%trial, %cohort) : (index, view<17xi32>) -> ()
    %input = check.generate.iota offset(0.25) step(0.125) : view<16x1280x1xf32>
    %weight = check.generate.iota offset(-0.5) step(0.0009765625) : view<320x1280xf32>
    %output = check.generate.fill value(-123.0) : view<16x320x1xf32>
    %bias = check.generate.iota offset(-64.0) step(16.0) : view<320xf32>
    check.compare<@moonshine.projection.decoder_down, @decoder_down_reference>(%input, %weight, %output, %bias, %cohort) : (view<16x1280x1xf32>, view<320x1280xf32>, view<16x320x1xf32>, view<320xf32>, view<17xi32>) -> () {
      check.expect.close actual(%output) expected(%output) atol(0.001) rtol(1.9999999999999999e-06) nan(different) : view<16x320x1xf32>
