kernel.decl @moonshine.projection.logits() launch(%x: view<16x320x1xf32>, %w: view<32768x320xf32>, %y: view<16x32768x1xf32>, %cohort: view<17xi32>)

func.def @logits_reference(%input: buffer, %weight: buffer, %output: buffer, %cohort: buffer) {
  %inputs = scalar.constant 320 : i32
  %outputs = scalar.constant 32768 : i32
  %biased = scalar.constant 0 : i32
  func.call @projection_integral(%output, %cohort, %inputs, %outputs, %biased) : (buffer, buffer, i32, i32, i32)
  func.return
}

check.scenario public @logits_independent_rows {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[16](%trial: index, %entropy: check.entropy) {
    %cohort = check.generate.fill value(0) : view<17xi32>
    check.generate<@projection_members>(%trial, %cohort) : (index, view<17xi32>) -> ()
    %input = check.generate.iota offset(0.25) step(0.125) : view<16x320x1xf32>
    %weight = check.generate.iota offset(-0.5) step(0.0009765625) : view<32768x320xf32>
    %output = check.generate.fill value(-123.0) : view<16x32768x1xf32>
    check.compare<@moonshine.projection.logits, @logits_reference>(%input, %weight, %output, %cohort) : (view<16x320x1xf32>, view<32768x320xf32>, view<16x32768x1xf32>, view<17xi32>) -> () {
      check.expect.close actual(%output) expected(%output) atol(0.001) rtol(1.9999999999999999e-06) nan(different) : view<16x32768x1xf32>
    }
  }
  check.return
}
