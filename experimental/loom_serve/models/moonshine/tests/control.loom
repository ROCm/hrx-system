func.decl @hypothesis_limit(%features: i32, %finished: i32) -> (i32)

func.decl @accept_token(%state: buffer, %token: i32) -> (i1, i1, i1)

func.decl @encoded(%state: buffer, %work: buffer, %feedback: buffer, %output_offset: offset) -> (i64, buffer, i32)

// Encoder positions: 1, 8, 28, 48, 748, and 2048.
global.rodata.def @feature_counts = align(4) bytes("01000000080000001c00000030000000ec02000000080000")

// Provisional predictions, rounded up; final input always retains 512.
global.rodata.def @prediction_limits = align(4) bytes("01000000020000000400000007000000620000000b010000")

func.def @observe_limits(%trial: index, %output: view<2xi32>) {
  %origin = index.constant 0 : offset
  %storage = global.load @feature_counts : buffer
  %counts = buffer.view %storage[%origin] : buffer -> view<6xi32>
  %row = index.assume %trial [range(%trial, 0, 5)] : index
  %features = view.load %counts[%row] : view<6xi32> -> i32
  %open = scalar.constant 0 : i32
  %finished = scalar.constant 1 : i32
  %provisional = func.call @hypothesis_limit(%features, %open) : (i32, i32) -> (i32)
  %final = func.call @hypothesis_limit(%features, %finished) : (i32, i32) -> (i32)
  view.store %provisional, %output[0] : i32, view<2xi32>
  view.store %final, %output[1] : i32, view<2xi32>
  func.return
}

func.def @expected_limits(%trial: index, %output: view<2xi32>) {
  %origin = index.constant 0 : offset
  %storage = global.load @prediction_limits : buffer
  %limits = buffer.view %storage[%origin] : buffer -> view<6xi32>
  %row = index.assume %trial [range(%trial, 0, 5)] : index
  %provisional = view.load %limits[%row] : view<6xi32> -> i32
  %final = scalar.constant 512 : i32
  view.store %provisional, %output[0] : i32, view<2xi32>
  view.store %final, %output[1] : i32, view<2xi32>
  func.return
}

// Input rows are final flag, decoder position, and predicted token. Provisional
// rows cover continuation, exhaustion, and EOS at the budget. Final rows cover
// continuation, missing EOS at capacity, and EOS at capacity.
global.rodata.def @token_cases = align(4) bytes("00000000600000000700000000000000610000000700000000000000610000000200000001000000fe0100000700000001000000ff0100000700000001000000ff01000002000000")

// Each row records EOS, valid extent, continuation, phase, position, attempt
// sample end, published revision, and next draft length. An exhausted
// provisional row resumes through twenty real control quanta before inspection.
global.rodata.def @token_results = align(4) bytes("")

func.def @observe_token(%trial: index, %output: view<8xi32>) {
  %origin = index.constant 0 : offset
  %storage = global.load @token_cases : buffer
  %cases = buffer.view %storage[%origin] : buffer -> view<6x3xi32>
  %row = index.assume %trial [range(%trial, 0, 5)] : index
  %finished = view.load %cases[%row, 0] : view<6x3xi32> -> i32
  %position = view.load %cases[%row, 1] : view<6x3xi32> -> i32
  %token = view.load %cases[%row, 2] : view<6x3xi32> -> i32
  %state_size = index.constant 2112 : offset
  %state = buffer.alloca<private> align(8) %state_size : buffer
  %fields = buffer.view %state[%origin] : buffer -> view<16xi32>
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %field_count = index.constant 16 : index
  %empty = scalar.constant 0 : i32
  scf.for %field = [%begin to %field_count step %step] {
    view.store %empty, %fields[%field] : i32, view<16xi32>
  }
  %decoding = scalar.constant 2 : i32
  %features = scalar.constant 748 : i32
  %revision = scalar.constant 7 : i32
  %previous_end = scalar.constant 236800 : i32
  %sample_end = scalar.constant 243200 : i32
  %limit = func.call @hypothesis_limit(%features, %finished) : (i32, i32) -> (i32)
  view.store %decoding, %fields[0] : i32, view<16xi32>
  view.store %features, %fields[1] : i32, view<16xi32>
  view.store %finished, %fields[2] : i32, view<16xi32>
  view.store %position, %fields[3] : i32, view<16xi32>
  view.store %revision, %fields[4] : i32, view<16xi32>
  view.store %previous_end, %fields[5] : i32, view<16xi32>
  view.store %sample_end, %fields[6] : i32, view<16xi32>
  view.store %limit, %fields[9] : i32, view<16xi32>
  %eos, %valid, %continuing = func.call @accept_token(%state, %token) : (buffer, i32) -> (i1, i1, i1)
  %eos32 = scalar.extui %eos : i1 to i32
  %valid32 = scalar.extui %valid : i1 to i32
  %continuing32 = scalar.extui %continuing : i1 to i32
  view.store %eos32, %output[0] : i32, view<8xi32>
  view.store %valid32, %output[1] : i32, view<8xi32>
  view.store %continuing32, %output[2] : i32, view<8xi32>
  %exhaustion_case = index.constant 1 : index
  %resuming = index.cmp eq, %row, %exhaustion_case : index
  scf.if %resuming {
    %header_size = index.constant 32 : offset
    %work = buffer.alloca<private> align(8) %header_size : buffer
    %input = buffer.view %work[%origin] : buffer -> view<8xi32>
    %feedback_size = index.constant 8 : offset
    %feedback = buffer.alloca<private> align(4) %feedback_size : buffer
    %encoded = buffer.view %feedback[%origin] : buffer -> view<2xi32>
    %quantum = scalar.constant 320 : i32
    view.store %quantum, %input[3] : i32, view<8xi32>
    view.store %empty, %encoded[1] : i32, view<2xi32>
    %quanta = index.constant 21 : index
    scf.for %packet = [%step to %quanta step %step] {
      %packet32 = index.cast %packet : index to i32
      %next_features = scalar.addi %features, %packet32 : i32
      %distance = scalar.muli %packet32, %quantum : i32
      %end = scalar.addi %sample_end, %distance : i32
      view.store %next_features, %encoded[0] : i32, view<2xi32>
      view.store %end, %input[7] : i32, view<8xi32>
      %consumed, %event, %complete = func.call @encoded(%state, %work, %feedback, %origin) : (buffer, buffer, buffer, offset) -> (i64, buffer, i32)
    }
  }
  %phase = view.load %fields[0] : view<16xi32> -> i32
  %next_position = view.load %fields[3] : view<16xi32> -> i32
  %attempt_end = view.load %fields[5] : view<16xi32> -> i32
  %published_revision = view.load %fields[4] : view<16xi32> -> i32
  %draft = view.load %fields[7] : view<16xi32> -> i32
  view.store %phase, %output[3] : i32, view<8xi32>
  view.store %next_position, %output[4] : i32, view<8xi32>
  view.store %attempt_end, %output[5] : i32, view<8xi32>
  view.store %published_revision, %output[6] : i32, view<8xi32>
  view.store %draft, %output[7] : i32, view<8xi32>
  func.return
}

func.def @expected_token(%trial: index, %output: view<8xi32>) {
  %origin = index.constant 0 : offset
  %storage = global.load @token_results : buffer
  %results = buffer.view %storage[%origin] : buffer -> view<6x8xi32>
  %row = index.assume %trial [range(%trial, 0, 5)] : index
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %count = index.constant 8 : index
  scf.for %column = [%begin to %count step %step] {
    %value = view.load %results[%row, %column] : view<6x8xi32> -> i32
    view.store %value, %output[%column] : i32, view<8xi32>
  }
  func.return
}

// Return the first unequal cell as 1 + trial * 10 + column. Each trial checks
// both budgets followed by all eight token-state observations.
func.def @control_observations() -> (i32) {
  %origin = index.constant 0 : offset
  %token_offset = index.constant 8 : offset
  %size = index.constant 40 : offset
  %actual = buffer.alloca<private> align(4) %size : buffer
  %expected = buffer.alloca<private> align(4) %size : buffer
  %actual_limits = buffer.view %actual[%origin] : buffer -> view<2xi32>
  %expected_limits = buffer.view %expected[%origin] : buffer -> view<2xi32>
  %actual_token = buffer.view %actual[%token_offset] : buffer -> view<8xi32>
  %expected_token = buffer.view %expected[%token_offset] : buffer -> view<8xi32>
  %actual_values = buffer.view %actual[%origin] : buffer -> view<10xi32>
  %expected_values = buffer.view %expected[%origin] : buffer -> view<10xi32>
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %trials = index.constant 6 : index
  %columns = index.constant 10 : index
  %zero = scalar.constant 0 : i32
  %error = scf.for %trial = [%begin to %trials step %step](%error = %zero : i32) -> (i32) {
    func.call @observe_limits(%trial, %actual_limits) : (index, view<2xi32>)
    func.call @expected_limits(%trial, %expected_limits) : (index, view<2xi32>)
    func.call @observe_token(%trial, %actual_token) : (index, view<8xi32>)
    func.call @expected_token(%trial, %expected_token) : (index, view<8xi32>)
    %next_error = scf.for %column = [%begin to %columns step %step](%error = %error : i32) -> (i32) {
      %observed = view.load %actual_values[%column] : view<10xi32> -> i32
      %wanted = view.load %expected_values[%column] : view<10xi32> -> i32
      %same = scalar.cmpi eq, %observed, %wanted : i32
      %row_offset = index.mul %trial, %columns : index
      %cell = index.add %row_offset, %column : index
      %ordinal = index.add %cell, %step : index
      %ordinal32 = index.cast %ordinal : index to i32
      %difference = scf.select %same, %zero, %ordinal32 : i32
      %first = scalar.cmpi eq, %error, %zero : i32
      %next = scf.select %first, %difference, %error : i32
      scf.yield %next : i32
    }
    scf.yield %next_error : i32
  }
  func.return %error : i32
}

check.case public @hypothesis_exhaustion_and_recovery {
  %error = func.call @control_observations() : () -> (i32)
  %zero = check.literal value(0) : i32
  check.expect.equal actual(%error) expected(%zero) : i32
  check.return
}
