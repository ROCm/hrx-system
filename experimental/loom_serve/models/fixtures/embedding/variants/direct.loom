config.decl @fixture.units : %value: index where [range(%value, 1, 256)]
target.decl @fixture_target

// The same ragged embedding oracle, with pooling and compact output in one
// native entry. No command program or global intermediate is required.
kernel.def target(@fixture_target) @resident_embed() {
  %units = config.get @fixture.units : index
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%units, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %row = kernel.workgroup.id<x> : index
  %units = config.get @fixture.units : index
  %header = buffer.view %input[%origin] : buffer -> view<4xi32>
  %count32 = view.load %header[0] : view<4xi32> -> i32
  %count = index.cast %count32 : i32 to index
  %live = index.cmp ult, %row, %count : index
  scf.if %live {
    %sixteen = index.constant 16 : offset
    %metadata = buffer.view %input[%sixteen] : buffer -> view<[%units]x4xi32>
    %begin32 = view.load %metadata[%row, 0] : view<[%units]x4xi32> -> i32
    %length32 = view.load %metadata[%row, 1] : view<[%units]x4xi32> -> i32
    %width32 = view.load %metadata[%row, 2] : view<[%units]x4xi32> -> i32
    %offset32 = view.load %metadata[%row, 3] : view<[%units]x4xi32> -> i32
    %zero = index.constant 0 : index
    %one = index.constant 1 : index
    %maximum = index.sub %units, %one : index
    %begin_value = index.cast %begin32 : i32 to index
    %begin = index.assume %begin_value [range(%begin_value, 0, %maximum)] : index
    %bounded_length = scalar.assume %length32 [range(%length32, 1, 31)] : i32
    %length = index.cast %bounded_length : i32 to index
    %token_base_scaled = index.scale %units, %sixteen : index, offset -> offset
    %token_base = index.add %token_base_scaled, %sixteen : offset
    %tokens = buffer.view %input[%token_base] : buffer -> view<[%units]xi32>
    %zero32 = scalar.constant 0 : i32
    %one32 = scalar.constant 1 : i32
    %sum = scf.for %i = [%zero to %length step %one](%previous = %zero32 : i32) -> (i32) {
      %offset_value = index.add %begin, %i : index
      %offset = index.assume %offset_value [range(%offset_value, 0, %maximum)] : index
      %id = view.load %tokens[%offset] : view<[%units]xi32> -> i32
      %value = scalar.addi %id, %one32 : i32
      %next = scalar.addi %previous, %value : i32
      scf.yield %next : i32
    }
    %first_id = view.load %tokens[%begin] : view<[%units]xi32> -> i32
    %first = scalar.addi %first_id, %one32 : i32
    %sum_f32 = scalar.uitofp %sum : i32 to f32
    %length_f32 = scalar.uitofp %length32 : i32 to f32
    %first_f32 = scalar.uitofp %first : i32 to f32
    %cohort_f32 = scalar.uitofp %count32 : i32 to f32
    %four = index.constant 4 : index
    %capacity = index.mul %units, %four : index
    %bounded_offset = scalar.assume %offset32 [range(%offset32, 0, 1023)] : i32
    %offset_value = index.cast %bounded_offset : i32 to index
    %last_start = index.sub %capacity, %four : index
    %offset = index.assume %offset_value [range(%offset_value, 0, %last_start)] : index
    %result = buffer.view %output[%origin] : buffer -> view<[%capacity]xf32>
    %next = index.add %offset, %one : index
    view.store %sum_f32, %result[%offset] : f32, view<[%capacity]xf32>
    view.store %length_f32, %result[%next] : f32, view<[%capacity]xf32>
    %four32 = scalar.constant 4 : i32
    %full = scalar.cmpi eq, %width32, %four32 : i32
    scf.if %full {
      %two = index.constant 2 : index
      %three = index.constant 3 : index
      %second = index.add %offset, %two : index
      %third = index.add %offset, %three : index
      view.store %first_f32, %result[%second] : f32, view<[%capacity]xf32>
      view.store %cohort_f32, %result[%third] : f32, view<[%capacity]xf32>
      scf.yield
    }
    scf.yield
  }
  kernel.return
}
