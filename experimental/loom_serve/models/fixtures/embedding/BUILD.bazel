load("//build_tools/bazel:test_resources.bzl", "GPU_DEVICE_RESOURCE_GROUP")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_test", "loom_config_compatible_with")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

exports_files([
    "prepare.loom",
    "model.json",
])

filegroup(
    name = "sources",
    srcs = [
        "config.loom",
        "control.loom",
        "embed.loom",
        "model.json",
        "prepare.loom",
        "tokenizer.json",
    ],
    visibility = ["//visibility:public"],
)

[
    loom_cc_test(
        name = name,
        srcs = ["service_test.cc"],
        args = [
            "--model_source=$(rootpath :prepare.loom)",
            "--test_device=" + device,
        ] + filters,
        data = [
            "prepare.loom",
            "variants/direct.loom",
            "variants/policy.loom",
            "variants/weights.loom",
            "variants/xdna.loom",
            ":sources",
        ],
        resource_group = resource_group,
        tags = tags,
        target_compatible_with = loom_config_compatible_with([
            "//loom/config/target/arch:vm",
        ] + capabilities) + select({
            "@platforms//os:linux": [],
            "//conditions:default": ["@platforms//:incompatible"],
        }),
        deps = [
            "//experimental/loom_serve/embedding:protocol",
            "//experimental/loom_serve/finite:model",
            "//experimental/loom_serve/finite:service",
            "//experimental/loom_serve/http:listener",
            "//experimental/loom_serve/http:server",
            "//experimental/loom_serve/models/fixtures:stalled_stderr",
            "//experimental/loom_serve/serving:model_registration",
            "//experimental/loom_serve/serving:registry",
            "//experimental/loom_serve/serving:router",
            "//experimental/loom_serve/testing:model",
            "//loom/src/loom/serve/runtime/device",
            "//loom/src/loom/serve/runtime/execution",
            "//loom/src/loom/serve/runtime/host",
            "//loom/src/loom/serve/runtime/parameter:residency",
            "//loom/src/loom/serve/runtime/program:compilation",
            "//runtime/src/iree/async",
            "//runtime/src/iree/base",
            "//runtime/src/iree/base/threading",
            "//runtime/src/iree/base/tooling:flags",
            "//runtime/src/iree/hal",
            "//runtime/src/iree/task",
            "//runtime/src/iree/testing:gtest",
            "//runtime/src/iree/testing:gtest_main",
            "//runtime/src/iree/testing:temp_file",
        ],
    )
    for name, device, capabilities, resource_group, tags, filters in [
        (
            "service_test",
            "amdgpu",
            ["//loom/config/execute:amdgpu_hal"],
            GPU_DEVICE_RESOURCE_GROUP,
            ["iree-run-requirement=runtime.resource.amd_gpu"],
            [],
        ),
        (
            "service_vulkan_test",
            "vulkan",
            ["//loom/config/execute:spirv_vulkan_hal"],
            GPU_DEVICE_RESOURCE_GROUP,
            ["iree-run-requirement=vulkan.resource.device"],
            ["--gtest_filter=Workers/SourceEmbeddingServiceTest.*"],
        ),
        (
            "service_xdna_test",
            "xdna",
            ["//loom/config/execute:xdna_hal"],
            GPU_DEVICE_RESOURCE_GROUP,
            [
                "iree-run-requirement=libamdf.resource.xdna",
                "runtime-resource=amd-xdna",
            ],
            [
                "--direct_stage_source=$(rootpath :variants/xdna.loom)",
                "--gtest_filter=*DirectDispatch*",
            ],
        ),
        (
            "service_cpu_test",
            "task",
            [
                "//loom/config/target/arch:x86",
                "//loom/config/execute:task_hal",
            ],
            None,
            [],
            ["--gtest_filter=Workers/SourceEmbeddingServiceTest.*"],
        ),
    ]
]
