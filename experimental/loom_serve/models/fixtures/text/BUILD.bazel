load("@rules_python//python:defs.bzl", "py_test")
load("//build_tools/bazel:test_resources.bzl", "GPU_DEVICE_RESOURCE_GROUP")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_test", "loom_config_compatible_with")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

py_test(
    name = "request_test",
    size = "small",
    srcs = ["request_test.py"],
    args = [
        "$(rootpath //experimental/loom_serve/text:request_check)",
        "$(rootpath //loom/src/loom/serve/fixture/text:control.loom)",
    ],
    data = [
        "//experimental/loom_serve/text:request_check",
        "//loom/src/loom/serve/fixture/text:control.loom",
        "//loom/src/loom/serve/fixture/text:sources",
    ],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:vm",
    ]),
)

py_test(
    name = "client_test",
    size = "small",
    srcs = ["client_test.py"],
    args = [
        "$(rootpath //loom/src/loom/tools/loom-serve:loom-serve)",
        "$(rootpath //loom/src/loom/serve/fixture/text:prepare.loom)",
    ],
    data = [
        "//loom/src/loom/serve/fixture/text:prepare.loom",
        "//loom/src/loom/serve/fixture/text:sources",
        "//loom/src/loom/tools/loom-serve",
    ],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:vm",
        "//loom/config/target/arch:x86",
        "//loom/config/execute:task_hal",
    ]) + select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = ["//loom/src/loom/serve/testing:http"],
)

[
    loom_cc_test(
        name = name,
        srcs = [
            "admission_service_test.cc",
            "checkpoint_test.cc",
            "oracle.h",
            "owner_turn.h",
            "prefix_service_test.cc",
            "service_test.cc",
            "service_test_fixture.cc",
            "service_test_fixture.h",
            "stalled_client_test_util.h",
        ],
        args = [
            "--model_source=$(rootpath //loom/src/loom/serve/fixture/text:prepare.loom)",
            "--test_device=" + device,
        ] + filters,
        data = [
            "//loom/src/loom/serve/fixture/text:prepare.loom",
            "//loom/src/loom/serve/fixture/text:sources",
        ],
        resource_group = resource_group,
        tags = tags,
        target_compatible_with = loom_config_compatible_with([
            "//loom/config/target/arch:vm",
        ] + capabilities) + select({
            "@platforms//os:linux": [],
            "//conditions:default": ["@platforms//:incompatible"],
        }),
        deps = [
            "//loom/src/loom/serve/runtime/device",
            "//loom/src/loom/serve/runtime/host",
            "//loom/src/loom/serve/server:model_registration",
            "//loom/src/loom/serve/server:registry",
            "//loom/src/loom/serve/server:router",
            "//loom/src/loom/serve/service/text:chat",
            "//loom/src/loom/serve/service/text:input",
            "//loom/src/loom/serve/service/text:model",
            "//loom/src/loom/serve/service/text:packing",
            "//loom/src/loom/serve/service/text:schedule",
            "//loom/src/loom/serve/service/text:service",
            "//loom/src/loom/serve/service/text:telemetry",
            "//loom/src/loom/serve/telemetry:stream",
            "//loom/src/loom/serve/testing:model",
            "//loom/src/loom/serve/testing:stalled_stderr",
            "//loom/src/loom/serve/transport/http:listener",
            "//loom/src/loom/serve/transport/http:server",
            "//runtime/src/iree/async",
            "//runtime/src/iree/async:platform",
            "//runtime/src/iree/base",
            "//runtime/src/iree/base/threading",
            "//runtime/src/iree/base/tooling:flags",
            "//runtime/src/iree/net:carrier",
            "//runtime/src/iree/net/carrier/loopback",
            "//runtime/src/iree/task",
            "//runtime/src/iree/testing:gtest",
            "//runtime/src/iree/testing:gtest_main",
            "//runtime/src/iree/testing:temp_file",
        ],
    )
    for name, device, capabilities, resource_group, tags, filters in [
        (
            "service_test",
            "amdgpu",
            ["//loom/config/execute:amdgpu_hal"],
            GPU_DEVICE_RESOURCE_GROUP,
            ["iree-run-requirement=runtime.resource.amd_gpu"],
            [],
        ),
        (
            "service_vulkan_test",
            "vulkan",
            ["//loom/config/execute:spirv_vulkan_hal"],
            GPU_DEVICE_RESOURCE_GROUP,
            ["iree-run-requirement=vulkan.resource.device"],
            ["--gtest_filter=Workers/SourceTextServiceTest.*:Workers/AdmissionServiceTest.*:SharedWorkers/PrefixServiceTest.*"],
        ),
        (
            "service_cpu_test",
            "task",
            [
                "//loom/config/target/arch:x86",
                "//loom/config/execute:task_hal",
            ],
            None,
            [],
            ["--gtest_filter=Workers/SourceTextServiceTest.*:Workers/AdmissionServiceTest.*:SharedWorkers/PrefixServiceTest.*"],
        ),
    ]
]
