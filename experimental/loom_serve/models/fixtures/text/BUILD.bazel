load("@rules_python//python:defs.bzl", "py_test")
load("//build_tools/bazel:test_resources.bzl", "GPU_DEVICE_RESOURCE_GROUP")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_test", "loom_config_compatible_with")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

exports_files(["prepare.loom"])

filegroup(
    name = "sources",
    srcs = [
        "advance.loom",
        "control.loom",
        "prepare.loom",
        "sources.txt",
        "tokenizer.json",
        "weights.loom",
    ],
    visibility = ["//visibility:public"],
)

py_test(
    name = "request_test",
    size = "small",
    srcs = ["request_test.py"],
    args = ["$(rootpath //experimental/loom_serve/text:request_check)"],
    data = [
        "control.loom",
        "tokenizer.json",
        "//experimental/loom_serve/text:request_check",
    ],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:vm",
    ]),
)

loom_cc_test(
    name = "service_test",
    srcs = ["service_test.cc"],
    args = ["--model_source=$(rootpath :prepare.loom)"],
    data = [
        "prepare.loom",
        ":sources",
    ],
    resource_group = GPU_DEVICE_RESOURCE_GROUP,
    tags = ["iree-run-requirement=runtime.resource.amd_gpu"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:vm",
        "//loom/config/execute:amdgpu_hal",
    ]) + select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//experimental/loom_serve/http:server",
        "//experimental/loom_serve/runtime:device",
        "//experimental/loom_serve/runtime:host",
        "//experimental/loom_serve/scheduling:packing",
        "//experimental/loom_serve/text:model",
        "//experimental/loom_serve/text:service",
        "//runtime/src/iree/async",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/base/tooling:flags",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
        "//runtime/src/iree/testing:temp_file",
    ],
)
