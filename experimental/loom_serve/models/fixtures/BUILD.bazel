load("@rules_python//python:defs.bzl", "py_test")
load("//build_tools/bazel:test_resources.bzl", "GPU_DEVICE_RESOURCE_GROUP")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_config_compatible_with")

package(default_visibility = ["//visibility:private"])

loom_cc_library(
    name = "stalled_stderr",
    testonly = True,
    hdrs = ["stalled_stderr.h"],
    visibility = [":__subpackages__"],
    deps = ["//runtime/src/iree/testing:gtest"],
)

[
    py_test(
        name = name,
        size = "medium",
        srcs = ["catalog_test.py"],
        args = [
            "--server=$(rootpath //experimental/loom_serve/serving:server)",
            "--catalog=$(rootpath :catalog.json)",
            "--device=" + device,
        ],
        data = [
            "catalog.json",
            "//experimental/loom_serve/models/fixtures/decision:sources",
            "//experimental/loom_serve/models/fixtures/embedding:sources",
            "//experimental/loom_serve/models/fixtures/image:sources",
            "//experimental/loom_serve/models/fixtures/text:sources",
            "//experimental/loom_serve/serving:server",
        ],
        main = "catalog_test.py",
        tags = [
            "iree-run-requirement=" + requirement,
            "resource_group:" + GPU_DEVICE_RESOURCE_GROUP,
        ],
        target_compatible_with = loom_config_compatible_with([
            "//loom/config/target/arch:vm",
            capability,
        ]) + select({
            "@platforms//os:linux": [],
            "//conditions:default": ["@platforms//:incompatible"],
        }),
        deps = [
            "//experimental/loom_serve/http:logs_client",
            "//experimental/loom_serve/testing:http",
            "//experimental/loom_serve/tools:observe_lib",
        ],
    )
    for name, device, capability, requirement in [
        (
            "catalog_test",
            "amdgpu",
            "//loom/config/execute:amdgpu_hal",
            "runtime.resource.amd_gpu",
        ),
        (
            "catalog_vulkan_test",
            "vulkan",
            "//loom/config/execute:spirv_vulkan_hal",
            "vulkan.resource.device",
        ),
    ]
]
