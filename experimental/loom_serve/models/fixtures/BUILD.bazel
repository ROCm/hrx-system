load("@rules_python//python:defs.bzl", "py_test")
load("//build_tools/bazel:test_resources.bzl", "GPU_DEVICE_RESOURCE_GROUP")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")

package(default_visibility = ["//visibility:private"])

py_test(
    name = "pressure_test",
    size = "medium",
    srcs = ["pressure_test.py"],
    args = [
        "--server=$(rootpath //loom/src/loom/tools/loom-serve:loom-serve)",
        "--source=$(rootpath //experimental/loom_serve/models/fixtures/text:prepare.loom)",
    ],
    data = [
        "//experimental/loom_serve/models/fixtures/text:prepare.loom",
        "//experimental/loom_serve/models/fixtures/text:sources",
        "//loom/src/loom/tools/loom-serve",
    ],
    tags = [
        "iree-run-requirement=runtime.resource.amd_gpu",
        "resource_group:" + GPU_DEVICE_RESOURCE_GROUP,
    ],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:vm",
        "//loom/config/execute:amdgpu_hal",
    ]) + select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = ["//loom/src/loom/serve/testing:http"],
)

[
    py_test(
        name = name,
        size = "medium",
        srcs = ["catalog_test.py"],
        args = [
            "--server=$(rootpath //loom/src/loom/tools/loom-serve:loom-serve)",
            "--fixture=$(rootpath //experimental/loom_serve/models/fixtures/image:model.json)",
            "--fixture=$(rootpath //experimental/loom_serve/models/fixtures/embedding:model.json)",
            "--fixture=$(rootpath //experimental/loom_serve/models/fixtures/decision:model.json)",
            "--fixture=$(rootpath //experimental/loom_serve/models/fixtures/text:model.json)",
            "--device=" + device,
            "--pool_backing=" + backing,
        ],
        data = [
            "//experimental/loom_serve/models/fixtures/decision:model.json",
            "//experimental/loom_serve/models/fixtures/decision:sources",
            "//experimental/loom_serve/models/fixtures/embedding:model.json",
            "//experimental/loom_serve/models/fixtures/embedding:sources",
            "//experimental/loom_serve/models/fixtures/image:model.json",
            "//experimental/loom_serve/models/fixtures/image:sources",
            "//experimental/loom_serve/models/fixtures/text:model.json",
            "//experimental/loom_serve/models/fixtures/text:sources",
            "//loom/src/loom/tools/loom-serve",
        ],
        main = "catalog_test.py",
        tags = [
            "iree-run-requirement=" + requirement,
            "resource_group:" + GPU_DEVICE_RESOURCE_GROUP,
        ],
        target_compatible_with = loom_config_compatible_with([
            "//loom/config/target/arch:vm",
            capability,
        ]) + select({
            "@platforms//os:linux": [],
            "//conditions:default": ["@platforms//:incompatible"],
        }),
        deps = [
            "//experimental/loom_serve/tools:observe_lib",
            "//loom/src/loom/serve/testing:http",
            "//loom/src/loom/serve/testing:logs",
        ],
    )
    for name, device, backing, capability, requirement in [
        (
            "catalog_test",
            "amdgpu",
            "fixed",
            "//loom/config/execute:amdgpu_hal",
            "runtime.resource.amd_gpu",
        ),
        (
            "catalog_elastic_test",
            "amdgpu",
            "elastic",
            "//loom/config/execute:amdgpu_hal",
            "runtime.resource.amd_gpu",
        ),
        (
            "catalog_vulkan_test",
            "vulkan",
            "fixed",
            "//loom/config/execute:spirv_vulkan_hal",
            "vulkan.resource.device",
        ),
    ]
]
