// Qwen generation-state transitions used to exercise retained device state.
// Token history has 128 entries; callers admit work within that capacity.
kernel.def @qwen38_prefill_finish_control() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%control: buffer, %token_ids: buffer, %progress: buffer) {
  %zero = index.constant 0 : offset
  %control_view = buffer.view %control[%zero] : buffer -> view<3xi32>
  %token_ids_view = buffer.view %token_ids[%zero] : buffer -> view<129xi32>
  %progress_view = buffer.view %progress[%zero] : buffer -> view<8xi32>
  %token_count = view.load %control_view[0] : view<3xi32> -> i32
  %position_base = view.load %control_view[1] : view<3xi32> -> i32
  %eos_token = view.load %control_view[2] : view<3xi32> -> i32
  %first_token = view.load %token_ids_view[0] : view<129xi32> -> i32
  %is_eos = scalar.cmpi eq, %first_token, %eos_token : i32
  %next_position = scalar.addi %position_base, %token_count : i32
  %one_i32 = scalar.constant 1 : i32
  %zero_i32 = scalar.constant 0 : i32
  %done = scf.select %is_eos, %one_i32, %zero_i32 : i32
  view.store %next_position, %control_view[0] : i32, view<3xi32>
  view.store %one_i32, %control_view[1] : i32, view<3xi32>
  view.store %first_token, %token_ids_view[1] : i32, view<129xi32>
  view.store %one_i32, %progress_view[0] : i32, view<8xi32>
  view.store %done, %progress_view[7] : i32, view<8xi32>
  kernel.return
}

kernel.def @qwen38_decode_commit_token() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%control: buffer, %token_ids: buffer, %progress: buffer) {
  %zero = index.constant 0 : offset
  %one = index.constant 1 : index
  %one_i32 = scalar.constant 1 : i32
  %zero_i32 = scalar.constant 0 : i32
  %control_view = buffer.view %control[%zero] : buffer -> view<3xi32>
  %token_ids_view = buffer.view %token_ids[%zero] : buffer -> view<129xi32>
  %progress_view = buffer.view %progress[%zero] : buffer -> view<8xi32>
  %position = view.load %control_view[0] : view<3xi32> -> i32
  %generated_count = view.load %control_view[1] : view<3xi32> -> i32
  %eos_token = view.load %control_view[2] : view<3xi32> -> i32
  %count = index.cast %generated_count : i32 to index
  %next_index = index.add %count, %one : index
  %history_index = index.assume %next_index [range(%next_index, 1, 128)] : index
  %token_id = view.load %token_ids_view[0] : view<129xi32> -> i32
  %is_eos = scalar.cmpi eq, %token_id, %eos_token : i32
  %done = scf.select %is_eos, %one_i32, %zero_i32 : i32
  %next_position = scalar.addi %position, %one_i32 : i32
  %next_count = scalar.addi %generated_count, %one_i32 : i32
  view.store %token_id, %token_ids_view[%history_index] : i32, view<129xi32>
  view.store %next_position, %control_view[0] : i32, view<3xi32>
  view.store %next_count, %control_view[1] : i32, view<3xi32>
  view.store %next_count, %progress_view[0] : i32, view<8xi32>
  view.store %done, %progress_view[7] : i32, view<8xi32>
  kernel.return
}

// Generic launch arguments retain whole-buffer ranges in the portable artifact.
command.program.def public @prefill_to_decode() launch(%control: buffer, %token_ids: buffer, %progress: buffer) {
  command.serial {
    kernel.launch @qwen38_prefill_finish_control(%control, %token_ids, %progress) : (buffer, buffer, buffer)
    kernel.launch @qwen38_decode_commit_token(%control, %token_ids, %progress) : (buffer, buffer, buffer)
  }
  command.return
}

command.program.def public @decode_transition() launch(%control: buffer, %token_ids: buffer, %progress: buffer) {
  %zero = index.constant 0 : offset
  %control_view = buffer.view %control[%zero] : buffer -> view<3xi32>
  %token_ids_view = buffer.view %token_ids[%zero] : buffer -> view<129xi32>
  %progress_view = buffer.view %progress[%zero] : buffer -> view<8xi32>
  kernel.launch @qwen38_decode_commit_token(%control_view, %token_ids_view, %progress_view) : (view<3xi32>, view<129xi32>, view<8xi32>)
  command.return
}

// The schedule alternates disabled and live grids. State contains the producer,
// consumer, and heartbeat counts followed by a canary.
kernel.def @continuation_counts() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%schedule: buffer, %state: buffer, %counts: buffer) {
  %c0_offset = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c3 = index.constant 3 : index
  %c1_i32 = scalar.constant 1 : i32
  %c7_i32 = scalar.constant 7 : i32
  %schedule_view = buffer.view %schedule[%c0_offset] : buffer -> view<24xi32>
  %state_view = buffer.view %state[%c0_offset] : buffer -> view<4xi32>
  %counts_view = buffer.view %counts[%c0_offset] : buffer -> view<3xi32>
  %iteration = view.load %state_view[0] : view<4xi32> -> i32
  %phase_word = scalar.andi %iteration, %c7_i32 : i32
  %phase_value = index.cast %phase_word : i32 to index
  %phase = index.assume %phase_value [range(%phase_value, 0, 7)] : index
  %base = index.mul %phase, %c3 : index
  scf.for %axis = [%c0 to %c3 step %c1] unroll {
    %source = index.add %base, %axis : index
    %count = view.load %schedule_view[%source] : view<24xi32> -> i32
    view.store %count, %counts_view[%axis] : i32, view<3xi32>
  }
  %next = scalar.addi %iteration, %c1_i32 : i32
  view.store %next, %state_view[0] : i32, view<4xi32>
  kernel.return
}

kernel.def @continuation_heartbeat() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%state: buffer) {
  %c0 = index.constant 0 : offset
  %c1 = scalar.constant 1 : i32
  %state_view = buffer.view %state[%c0] : buffer -> view<4xi32>
  %value = view.load %state_view[2] : view<4xi32> -> i32
  %next = scalar.addi %value, %c1 : i32
  view.store %next, %state_view[2] : i32, view<4xi32>
  kernel.return
}

// This entry has no internal mask: only the indirect grid suppresses mutation.
kernel.def @continuation_consume(%count: index) {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%count, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%state: buffer) {
  %c0 = index.constant 0 : offset
  %c1 = scalar.constant 1 : i32
  %state_view = buffer.view %state[%c0] : buffer -> view<4xi32>
  %value = view.load %state_view[1] : view<4xi32> -> i32
  %next = scalar.addi %value, %c1 : i32
  view.store %next, %state_view[1] : i32, view<4xi32>
  kernel.return
}

command.program.def public @device_continuation() launch(%schedule: buffer, %state: buffer) {
  %c0_offset = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  %count_bytes = index.constant 12 : offset
  %counts = buffer.alloca<global> align(16) %count_bytes : buffer
  %counts_view = buffer.view %counts[%c0_offset] : buffer -> view<3xi32>
  scf.for %iteration = [%c0 to %c8 step %c1] unroll {
    command.serial {
      kernel.launch @continuation_counts(%schedule, %state, %counts) : (buffer, buffer, buffer)
      command.concurrent {
        kernel.launch @continuation_heartbeat(%state) : (buffer)
        kernel.dispatch @continuation_consume[%counts_view](%state) : [view<3xi32>](buffer)
      }
    }
  }
  command.return
}
