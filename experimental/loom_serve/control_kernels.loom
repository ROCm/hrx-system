// Qwen generation-state transitions used to exercise retained device state.
// Token history has 128 entries; callers admit work within that capacity.
kernel.def @qwen38_prefill_finish_control() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%control: buffer, %token_ids: buffer, %progress: buffer) {
  %zero = index.constant 0 : offset
  %control_view = buffer.view %control[%zero] : buffer -> view<3xi32>
  %token_ids_view = buffer.view %token_ids[%zero] : buffer -> view<129xi32>
  %progress_view = buffer.view %progress[%zero] : buffer -> view<8xi32>
  %token_count = view.load %control_view[0] : view<3xi32> -> i32
  %position_base = view.load %control_view[1] : view<3xi32> -> i32
  %eos_token = view.load %control_view[2] : view<3xi32> -> i32
  %first_token = view.load %token_ids_view[0] : view<129xi32> -> i32
  %is_eos = scalar.cmpi eq, %first_token, %eos_token : i32
  %next_position = scalar.addi %position_base, %token_count : i32
  %one_i32 = scalar.constant 1 : i32
  %zero_i32 = scalar.constant 0 : i32
  %done = scf.select %is_eos, %one_i32, %zero_i32 : i32
  view.store %next_position, %control_view[0] : i32, view<3xi32>
  view.store %one_i32, %control_view[1] : i32, view<3xi32>
  view.store %first_token, %token_ids_view[1] : i32, view<129xi32>
  view.store %one_i32, %progress_view[0] : i32, view<8xi32>
  view.store %done, %progress_view[7] : i32, view<8xi32>
  kernel.return
}

kernel.def @qwen38_decode_commit_token() {
  %one = index.constant 1 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index
} launch(%control: buffer, %token_ids: buffer, %progress: buffer) {
  %zero = index.constant 0 : offset
  %one = index.constant 1 : index
  %one_i32 = scalar.constant 1 : i32
  %zero_i32 = scalar.constant 0 : i32
  %control_view = buffer.view %control[%zero] : buffer -> view<3xi32>
  %token_ids_view = buffer.view %token_ids[%zero] : buffer -> view<129xi32>
  %progress_view = buffer.view %progress[%zero] : buffer -> view<8xi32>
  %position = view.load %control_view[0] : view<3xi32> -> i32
  %generated_count = view.load %control_view[1] : view<3xi32> -> i32
  %eos_token = view.load %control_view[2] : view<3xi32> -> i32
  %count = index.cast %generated_count : i32 to index
  %next_index = index.add %count, %one : index
  %history_index = index.assume %next_index [range(%next_index, 1, 128)] : index
  %token_id = view.load %token_ids_view[0] : view<129xi32> -> i32
  %is_eos = scalar.cmpi eq, %token_id, %eos_token : i32
  %done = scf.select %is_eos, %one_i32, %zero_i32 : i32
  %next_position = scalar.addi %position, %one_i32 : i32
  %next_count = scalar.addi %generated_count, %one_i32 : i32
  view.store %token_id, %token_ids_view[%history_index] : i32, view<129xi32>
  view.store %next_position, %control_view[0] : i32, view<3xi32>
  view.store %next_count, %control_view[1] : i32, view<3xi32>
  view.store %next_count, %progress_view[0] : i32, view<8xi32>
  view.store %done, %progress_view[7] : i32, view<8xi32>
  kernel.return
}

// The state layout publishes exact operational ranges to the portable artifact.
command.program.def public @prefill_to_decode() launch(%control: buffer, %token_ids: buffer, %progress: buffer) {
  %zero = index.constant 0 : offset
  %control_view = buffer.view %control[%zero] : buffer -> view<3xi32>
  %token_ids_view = buffer.view %token_ids[%zero] : buffer -> view<129xi32>
  %progress_view = buffer.view %progress[%zero] : buffer -> view<8xi32>
  command.serial {
    kernel.launch @qwen38_prefill_finish_control(%control_view, %token_ids_view, %progress_view) : (view<3xi32>, view<129xi32>, view<8xi32>)
    kernel.launch @qwen38_decode_commit_token(%control_view, %token_ids_view, %progress_view) : (view<3xi32>, view<129xi32>, view<8xi32>)
  }
  command.return
}

command.program.def public @decode_transition() launch(%control: buffer, %token_ids: buffer, %progress: buffer) {
  %zero = index.constant 0 : offset
  %control_view = buffer.view %control[%zero] : buffer -> view<3xi32>
  %token_ids_view = buffer.view %token_ids[%zero] : buffer -> view<129xi32>
  %progress_view = buffer.view %progress[%zero] : buffer -> view<8xi32>
  kernel.launch @qwen38_decode_commit_token(%control_view, %token_ids_view, %progress_view) : (view<3xi32>, view<129xi32>, view<8xi32>)
  command.return
}
