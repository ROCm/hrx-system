load("@rules_python//python:defs.bzl", "py_test")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_binary", "loom_config_compatible_with")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],
)

loom_cc_binary(
    name = "server",
    srcs = ["server.c"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:vm",
    ]),
    deps = [
        "//experimental/loom_serve/runtime:device_flags",
        "//experimental/loom_serve/runtime:host_flags",
        "//experimental/loom_serve/runtime:signals",
        "//loom/src/loom/serve/runtime/device",
        "//loom/src/loom/serve/server:configuration",
        "//loom/src/loom/serve/server:model_registration",
        "//loom/src/loom/serve/server:registry",
        "//loom/src/loom/serve/server:router",
        "//loom/src/loom/serve/transport/http:listener",
        "//loom/src/loom/serve/transport/http:server",
        "//loom/src/loom/util:json",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/async",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/tooling:flags",
    ],
)

py_test(
    name = "server_test",
    size = "small",
    srcs = ["server_test.py"],
    args = [
        "$(rootpath :server)",
        "$(rootpath //experimental/loom_serve/models/fixtures/embedding:prepare.loom)",
        "$(rootpath //loom/src/loom/tools/loom-format)",
    ],
    data = [
        ":server",
        "//experimental/loom_serve/models/fixtures/embedding:prepare.loom",
        "//experimental/loom_serve/models/fixtures/embedding:sources",
        "//loom/src/loom/tools/loom-format",
    ],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:vm",
        "//loom/config/target/arch:x86",
        "//runtime/config/hal:driver_task",
    ]) + select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = ["//experimental/loom_serve/testing:http"],
)
