load("@rules_python//python:defs.bzl", "py_test")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_binary", "loom_cc_library", "loom_cc_test", "loom_config_compatible_with")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],
)

loom_cc_library(
    name = "router",
    srcs = ["router.c"],
    hdrs = ["router.h"],
    deps = [
        ":configuration",
        ":registry",
        ":resources",
        "//experimental/loom_serve/http:inspection",
        "//experimental/loom_serve/http:logs",
        "//experimental/loom_serve/http:request",
        "//experimental/loom_serve/http:server",
        "//experimental/loom_serve/http:service",
        "//experimental/loom_serve/http:tokenization",
        "//experimental/loom_serve/runtime:compilation",
        "//experimental/loom_serve/runtime:residency",
        "//experimental/loom_serve/telemetry:stream",
        "//loom/src/loom/util:json",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:json",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/task",
        "//runtime/src/iree/tokenizer",
    ],
)

loom_cc_library(
    name = "resources",
    srcs = ["resources.c"],
    hdrs = ["resources.h"],
    deps = [
        "//experimental/loom_serve/http:listener",
        "//experimental/loom_serve/runtime:device",
        "//experimental/loom_serve/storage:memory",
        "//loom/src/loom/util:json",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/async",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:json",
        "//runtime/src/iree/hal",
    ],
)

loom_cc_test(
    name = "resources_test",
    srcs = ["resources_test.cc"],
    target_compatible_with = loom_config_compatible_with([
        "//runtime/config/hal:driver_task",
    ]),
    deps = [
        ":resources",
        "//experimental/loom_serve/runtime:device",
        "//experimental/loom_serve/runtime:host",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_test(
    name = "router_test",
    srcs = [
        "router_registration_test.cc",
        "router_test.cc",
        "router_test_fixture.h",
    ],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":registry",
        ":router",
        "//experimental/loom_serve/http:listener",
        "//experimental/loom_serve/http:request",
        "//experimental/loom_serve/http:server",
        "//runtime/src/iree/async",
        "//runtime/src/iree/async:platform",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/base",
        "//runtime/src/iree/net:carrier",
        "//runtime/src/iree/net/carrier/loopback",
        "//runtime/src/iree/task",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
        "//runtime/src/iree/tokenizer",
        "//runtime/src/iree/tokenizer/format/huggingface:tokenizer_json",
    ],
)

loom_cc_library(
    name = "configuration",
    srcs = ["configuration.c"],
    hdrs = ["configuration.h"],
    deps = [
        "//experimental/loom_serve/runtime:sources",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:json",
        "//runtime/src/iree/base/internal:path",
        "//runtime/src/iree/base/internal:unicode",
        "//runtime/src/iree/io:file_handle",
    ],
)

loom_cc_binary(
    name = "server",
    srcs = ["server.c"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:vm",
    ]),
    deps = [
        ":configuration",
        ":model_registration",
        ":registry",
        ":router",
        "//experimental/loom_serve/http:listener",
        "//experimental/loom_serve/http:server",
        "//experimental/loom_serve/runtime:device",
        "//experimental/loom_serve/runtime:device_flags",
        "//experimental/loom_serve/runtime:host_flags",
        "//experimental/loom_serve/runtime:signals",
        "//loom/src/loom/util:json",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/async",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/tooling:flags",
    ],
)

loom_cc_library(
    name = "registry",
    srcs = ["registry.c"],
    hdrs = ["registry.h"],
    deps = [
        ":configuration",
        "//experimental/loom_serve/http:service",
        "//experimental/loom_serve/runtime:activation",
        "//experimental/loom_serve/runtime:compilation",
        "//experimental/loom_serve/runtime:residency",
        "//experimental/loom_serve/telemetry:record",
        "//experimental/loom_serve/telemetry:stream",
        "//runtime/src/iree/base",
    ],
)

py_test(
    name = "server_test",
    size = "small",
    srcs = ["server_test.py"],
    args = [
        "$(rootpath :server)",
        "$(rootpath //experimental/loom_serve/models/fixtures/embedding:prepare.loom)",
        "$(rootpath //loom/src/loom/tools/loom-format)",
    ],
    data = [
        ":server",
        "//experimental/loom_serve/models/fixtures/embedding:prepare.loom",
        "//experimental/loom_serve/models/fixtures/embedding:sources",
        "//loom/src/loom/tools/loom-format",
    ],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:vm",
        "//loom/config/target/arch:x86",
        "//runtime/config/hal:driver_task",
    ]) + select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = ["//experimental/loom_serve/testing:http"],
)

loom_cc_library(
    name = "model_registration",
    srcs = ["model_registration.c"],
    hdrs = ["model_registration.h"],
    deps = [
        ":configuration",
        ":registry",
        "//experimental/loom_serve/decision:protocol",
        "//experimental/loom_serve/embedding:protocol",
        "//experimental/loom_serve/finite:model",
        "//experimental/loom_serve/finite:service",
        "//experimental/loom_serve/http:service",
        "//experimental/loom_serve/image:model",
        "//experimental/loom_serve/image:service",
        "//experimental/loom_serve/runtime:activation",
        "//experimental/loom_serve/runtime:compilation",
        "//experimental/loom_serve/runtime:device",
        "//experimental/loom_serve/runtime:host",
        "//experimental/loom_serve/runtime:residency",
        "//experimental/loom_serve/storage:memory",
        "//experimental/loom_serve/text:model",
        "//experimental/loom_serve/text:schedule",
        "//experimental/loom_serve/text:service",
        "//runtime/src/iree/base",
    ],
)

loom_cc_test(
    name = "configuration_test",
    srcs = ["configuration_test.cc"],
    deps = [
        ":configuration",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
