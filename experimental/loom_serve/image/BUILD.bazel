load("//build_tools/bazel:test_resources.bzl", "GPU_DEVICE_RESOURCE_GROUP")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_binary", "loom_cc_library", "loom_cc_test", "loom_config_compatible_with")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],
)

loom_cc_library(
    name = "request",
    srcs = ["request.c"],
    hdrs = ["request.h"],
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:json",
        "//runtime/src/iree/base/internal:unicode",
    ],
)

loom_cc_test(
    name = "request_test",
    srcs = ["request_test.cc"],
    deps = [
        ":request",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "output",
    srcs = ["output.c"],
    hdrs = ["output.h"],
    deps = ["//runtime/src/iree/base"],
)

loom_cc_test(
    name = "output_test",
    srcs = ["output_test.cc"],
    deps = [
        ":output",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "generator",
    hdrs = ["generator.h"],
    deps = [
        ":request",
        "//loom/src/loom/serve/runtime/execution",
        "//loom/src/loom/serve/runtime/parameter:residency",
        "//runtime/src/iree/base",
        "//runtime/src/iree/tokenizer",
    ],
)

loom_cc_library(
    name = "telemetry",
    srcs = ["telemetry.c"],
    hdrs = ["telemetry.h"],
    deps = [
        ":generator",
        "//loom/src/loom/serve/telemetry:record",
        "//loom/src/loom/serve/telemetry:stream",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "service",
    srcs = ["service.c"],
    hdrs = ["service.h"],
    deps = [
        ":generator",
        ":output",
        ":request",
        ":telemetry",
        "//loom/src/loom/serve/runtime/execution",
        "//loom/src/loom/serve/runtime/host",
        "//loom/src/loom/serve/runtime/host:timer",
        "//loom/src/loom/serve/runtime/host:wake",
        "//loom/src/loom/serve/runtime/parameter:telemetry",
        "//loom/src/loom/serve/service",
        "//loom/src/loom/serve/telemetry:record",
        "//loom/src/loom/serve/telemetry:stream",
        "//loom/src/loom/serve/transport/http:request",
        "//loom/src/loom/serve/transport/http:server",
        "//loom/src/loom/util:json",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/async",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:base64",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/task",
    ],
)

loom_cc_test(
    name = "service_test",
    srcs = ["service_test.cc"],
    resource_group = GPU_DEVICE_RESOURCE_GROUP,
    tags = ["iree-run-requirement=runtime.resource.amd_gpu"],
    target_compatible_with = loom_config_compatible_with([
        "//runtime/config/hal:driver_amdgpu",
    ]),
    deps = [
        ":service",
        "//experimental/loom_serve/serving:registry",
        "//experimental/loom_serve/serving:router",
        "//loom/src/loom/serve/runtime/device",
        "//loom/src/loom/serve/runtime/execution",
        "//loom/src/loom/serve/runtime/host",
        "//loom/src/loom/serve/telemetry:record",
        "//loom/src/loom/serve/telemetry:stream",
        "//loom/src/loom/serve/transport/http:listener",
        "//loom/src/loom/serve/transport/http:server",
        "//runtime/src/iree/async",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_binary(
