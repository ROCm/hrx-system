load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_binary", "loom_cc_library", "loom_cc_test", "loom_config_compatible_with")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],
)

loom_cc_library(
    name = "request",
    srcs = ["request.c"],
    hdrs = ["request.h"],
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:json",
        "//runtime/src/iree/base/internal:unicode",
    ],
)

loom_cc_test(
    name = "request_test",
    srcs = ["request_test.cc"],
    deps = [
        ":request",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "output",
    srcs = ["output.c"],
    hdrs = ["output.h"],
    deps = ["//runtime/src/iree/base"],
)

loom_cc_test(
    name = "output_test",
    srcs = ["output_test.cc"],
    deps = [
        ":output",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "service",
    srcs = ["service.c"],
    hdrs = ["service.h"],
    deps = [
        ":output",
        ":request",
        "//experimental/loom_serve/http:request",
        "//experimental/loom_serve/http:server",
        "//loom/src/loom/util:json",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/async",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:base64",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/base/threading:thread",
    ],
)

loom_cc_test(
    name = "service_test",
    srcs = ["service_test.cc"],
    deps = [
        ":service",
        "//experimental/loom_serve/http:server",
        "//runtime/src/iree/async",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_binary(
    name = "request_check",
    testonly = True,
    srcs = ["request_check.c"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:vm",
    ]),
    deps = [
        "//experimental/loom_serve/runtime:input",
        "//experimental/loom_serve/runtime:preparation",
        "//experimental/loom_serve/runtime:program",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:json",
        "//runtime/src/iree/base/internal:path",
        "//runtime/src/iree/base/tooling:flags",
        "//runtime/src/iree/io:file_handle",
        "//runtime/src/iree/tokenizer",
        "//runtime/src/iree/tokenizer/format/huggingface:tokenizer_json",
        "//runtime/src/iree/vm",
    ],
)

loom_cc_binary(
    name = "model_check",
    testonly = True,
    srcs = ["model_check.c"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:vm",
        "//runtime/config/hal:driver_amdgpu",
    ]),
    deps = [
        ":model",
        "//experimental/loom_serve/runtime:device_flags",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:path",
        "//runtime/src/iree/base/tooling:flags",
        "//runtime/src/iree/io:file_handle",
    ],
)

loom_cc_library(
    name = "model",
    srcs = ["model.c"],
    hdrs = ["model.h"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:vm",
        "//runtime/config/hal:driver_amdgpu",
    ]),
    deps = [
        "//experimental/loom_serve/runtime:device",
        "//experimental/loom_serve/runtime:execution",
        "//experimental/loom_serve/runtime:input",
        "//experimental/loom_serve/runtime:jit",
        "//experimental/loom_serve/runtime:module",
        "//experimental/loom_serve/runtime:preparation",
        "//experimental/loom_serve/runtime:program",
        "//experimental/loom_serve/runtime:weights",
        "//loom/binding/c:loomc",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:path",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/io:file_handle",
        "//runtime/src/iree/module/hal:types",
        "//runtime/src/iree/tokenizer",
        "//runtime/src/iree/tokenizer/format/huggingface:tokenizer_json",
        "//runtime/src/iree/tooling:device_util",
        "//runtime/src/iree/vm",
    ],
)

loom_cc_binary(
    name = "generate",
    srcs = ["generate.c"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:vm",
        "//runtime/config/hal:driver_amdgpu",
    ]),
    deps = [
        ":model",
        "//experimental/loom_serve/runtime:device_flags",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal",
        "//runtime/src/iree/base/internal:json",
        "//runtime/src/iree/base/tooling:flags",
        "//runtime/src/iree/io:file_handle",
    ],
)

loom_cc_binary(
    name = "server",
    srcs = ["server.c"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:vm",
        "//runtime/config/hal:driver_amdgpu",
    ]),
    deps = [
        ":model",
        ":request",
        ":service",
        "//experimental/loom_serve/http:server",
        "//experimental/loom_serve/runtime:device_flags",
        "//runtime/src/iree/async",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/tooling:flags",
    ],
)
