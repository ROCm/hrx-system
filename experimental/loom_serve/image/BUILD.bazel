load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_binary", "loom_config_compatible_with")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],
)

loom_cc_binary(
    name = "request_check",
    testonly = True,
    srcs = ["request_check.c"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:vm",
    ]),
    deps = [
        "//loom/src/loom/serve/runtime/program",
        "//loom/src/loom/serve/runtime/program:compilation",
        "//loom/src/loom/serve/runtime/program:input",
        "//loom/src/loom/serve/runtime/program:preparation",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:json",
        "//runtime/src/iree/base/internal:path",
        "//runtime/src/iree/base/tooling:flags",
        "//runtime/src/iree/io:file_handle",
        "//runtime/src/iree/tokenizer",
        "//runtime/src/iree/tokenizer/format/huggingface:tokenizer_json",
        "//runtime/src/iree/vm",
    ],
)

loom_cc_binary(
    name = "model_check",
    testonly = True,
    srcs = ["model_check.c"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:vm",
    ]),
    deps = [
        "//experimental/loom_serve/runtime:device_flags",
        "//experimental/loom_serve/runtime:host_flags",
        "//loom/src/loom/serve/server:configuration",
        "//loom/src/loom/serve/service/image:model",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:path",
        "//runtime/src/iree/base/tooling:flags",
        "//runtime/src/iree/io:file_handle",
    ],
)

loom_cc_binary(
    name = "generate",
    srcs = ["generate.c"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:vm",
    ]),
    deps = [
        "//experimental/loom_serve/runtime:device_flags",
        "//experimental/loom_serve/runtime:host_flags",
        "//loom/src/loom/serve/server:configuration",
        "//loom/src/loom/serve/service/image:model",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal",
        "//runtime/src/iree/base/internal:json",
        "//runtime/src/iree/base/tooling:flags",
        "//runtime/src/iree/io:file_handle",
    ],
)

loom_cc_binary(
    name = "server",
    srcs = ["server.c"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:vm",
    ]),
    deps = [
        "//experimental/loom_serve/runtime:device_flags",
        "//experimental/loom_serve/runtime:host_flags",
        "//experimental/loom_serve/runtime:signals",
        "//loom/src/loom/serve/server:configuration",
        "//loom/src/loom/serve/server:registry",
        "//loom/src/loom/serve/server:router",
        "//loom/src/loom/serve/service/image:model",
        "//loom/src/loom/serve/service/image:request",
        "//loom/src/loom/serve/service/image:service",
        "//loom/src/loom/serve/transport/http:listener",
        "//loom/src/loom/serve/transport/http:server",
        "//runtime/src/iree/async",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/tooling:flags",
    ],
)
