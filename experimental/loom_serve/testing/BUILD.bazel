load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library")

package(default_visibility = ["//visibility:private"])

loom_cc_library(
    name = "model",
    testonly = True,
    hdrs = ["model.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//loom/src/loom/serve/server:configuration",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:json",
        "//runtime/src/iree/io:file_handle",
    ],
)

# Model checks and source-only fixtures share this child-process/HTTP boundary.
py_library(
    name = "http",
    testonly = True,
    srcs = ["http.py"],
    visibility = ["//visibility:public"],
    deps = ["//experimental/loom_serve/http:logs_client"],
)

py_test(
    name = "http_test",
    size = "small",
    srcs = ["http_test.py"],
    deps = [":http"],
)
