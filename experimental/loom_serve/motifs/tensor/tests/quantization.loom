amdgpu.target<gfx11-generic> @wave32 {subgroup_size = 32}

template.decl @quantization.convrot256_i8(%rows: index, %columns: index, %input: buffer, %output: buffer, %scales: buffer)

// Independent dense H256 oracle, not the butterfly decomposition above.
func.def @convrot_reference(%rows: index, %length: index, %input: buffer, %output: buffer, %scales: buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %width = index.constant 256 : index
  %groups = index.div %length, %width : index
  %element_bytes = index.constant 2 : offset
  %scratch_bytes = index.scale %length, %element_bytes : index, offset -> offset
  %scratch = buffer.alloca<private> align(16) %scratch_bytes : buffer
  %rotated = buffer.view %scratch[%origin] : buffer -> view<[%groups]x256xbf16>
  %x = buffer.view %input[%origin] : buffer -> view<[%rows]x[%groups]x256xbf16>
  %y = buffer.view %output[%origin] : buffer -> view<[%rows]x[%groups]x256xi8>
  %s = buffer.view %scales[%origin] : buffer -> view<[%rows]xf32>
  %c0_0 = scalar.constant 0.0 : f32
  %negative_f = scalar.constant -0.0625 : f32
  %positive_f = scalar.constant 0.0625 : f32
  %c1_2 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %c4 = scalar.constant 4 : i32
  %mask_i = scalar.constant 85 : i32
  %limit = scalar.constant 127.0 : f32
  %lower = scalar.constant -128.0 : f32
  %floor = scalar.constant 1.0000000000000001e-30 : f32
  scf.for %row = [%c0 to %rows step %c1] {
    %maximum = scf.for %group = [%c0 to %groups step %c1](%group_max = %c0_0 : f32) -> (f32) {
      %next_max = scf.for %column = [%c0 to %width step %c1](%column_max = %group_max : f32) -> (f32) {
        %column_i = index.cast %column : index to i32
        %sum = scf.for %k = [%c0 to %width step %c1](%partial = %c0_0 : f32) -> (f32) {
          %k_i = index.cast %k : index to i32
          %difference = scalar.xori %column_i, %k_i : i32
          %shifted = scalar.shrui %difference, %c1_2 : i32
          %both = scalar.andi %difference, %shifted : i32
          %negative_digits = scalar.andi %both, %mask_i : i32
          %upper = scalar.shrui %negative_digits, %c4 : i32
          %parity4 = scalar.xori %negative_digits, %upper : i32
          %high = scalar.shrui %parity4, %c2 : i32
          %parity2 = scalar.xori %parity4, %high : i32
          %parity = scalar.andi %parity2, %c1_2 : i32
          %negative = scalar.cmpi eq, %parity, %c1_2 : i32
          %coefficient = scf.select %negative, %negative_f, %positive_f : f32
          %element = view.load %x[%row, %group, %k] : view<[%rows]x[%groups]x256xbf16> -> bf16
          %wide = scalar.extf %element : bf16 to f32
          %product = scalar.mulf %coefficient, %wide : f32
          %next = scalar.addf %partial, %product : f32
          scf.yield %next : f32
        }
        %rounded = scalar.fptrunc %sum : f32 to bf16
        view.store %rounded, %rotated[%group, %column] : bf16, view<[%groups]x256xbf16>
        %wide = scalar.extf %rounded : bf16 to f32
        %absolute = scalar.absf %wide : f32
        %maximum = scalar.maxnumf %column_max, %absolute : f32
        scf.yield %maximum : f32
      }
      scf.yield %next_max : f32
    }
    %divided = scalar.divf %maximum, %limit : f32
    %scale = scalar.maxnumf %divided, %floor : f32
    view.store %scale, %s[%row] : f32, view<[%rows]xf32>
    %scale_bf16 = scalar.fptrunc %scale : f32 to bf16
    %scale_f = scalar.extf %scale_bf16 : bf16 to f32
    scf.for %group = [%c0 to %groups step %c1] {
      scf.for %within = [%c0 to %width step %c1] {
        %value = view.load %rotated[%group, %within] : view<[%groups]x256xbf16> -> bf16
        %wide = scalar.extf %value : bf16 to f32
        %quotient = scalar.divf %wide, %scale_f : f32
        %rounded_bf16 = scalar.fptrunc %quotient : f32 to bf16
        %rounded = scalar.extf %rounded_bf16 : bf16 to f32
        %nearest = scalar.roundevenf %rounded : f32
        %bounded_low = scalar.maxnumf %nearest, %lower : f32
        %bounded = scalar.minnumf %bounded_low, %limit : f32
        %integer = scalar.fptosi %bounded : f32 to i32
        %byte = scalar.trunci %integer : i32 to i8
        view.store %byte, %y[%row, %group, %within] : i8, view<[%rows]x[%groups]x256xi8>
      }
    }
  }
  func.return
}

kernel.def target(@wave32) @convrot_256() {
  %rows = index.constant 4 : index
  %c1 = index.constant 1 : index
  %threads = index.constant 128 : index
  kernel.launch.config workgroups(%rows, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%input: buffer, %output: buffer, %scales: buffer) {
  %rows = index.constant 4 : index
  %columns = index.constant 256 : index
  template.apply<@quantization.convrot256_i8>(%rows, %columns, %input, %output, %scales) : (index, index, buffer, buffer, buffer)
  kernel.return
}

func.def @reference_256(%input: buffer, %output: buffer, %scales: buffer) {
  %rows = index.constant 4 : index
  %columns = index.constant 256 : index
  func.call @convrot_reference(%rows, %columns, %input, %output, %scales) : (index, index, buffer, buffer, buffer)
  func.return
}

check.scenario public @convrot_256_pattern {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %x = check.generate.iota offset(-1.0) step(0.0625) period(37) : tensor<4x256xbf16>
    %y = check.generate.fill value(99) : tensor<4x256xi8>
    %s = check.generate.fill value(-1.0) : tensor<4xf32>
    check.compare<@convrot_256, @reference_256>(%x, %y, %s) : (tensor<4x256xbf16>, tensor<4x256xi8>, tensor<4xf32>) -> () {
      check.expect.bitwise actual(%y) expected(%y) : tensor<4x256xi8>
      check.expect.close actual(%s) expected(%s) atol(0.0) rtol(9.9999999999999995e-07) nan(different) : tensor<4xf32>
    }
  }
  check.return
}

check.scenario public @convrot_256_zero {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %x = check.generate.fill value(0.0) : tensor<4x256xbf16>
    %y = check.generate.fill value(99) : tensor<4x256xi8>
    %s = check.generate.fill value(-1.0) : tensor<4xf32>
    check.compare<@convrot_256, @reference_256>(%x, %y, %s) : (tensor<4x256xbf16>, tensor<4x256xi8>, tensor<4xf32>) -> () {
      check.expect.bitwise actual(%y) expected(%y) : tensor<4x256xi8>
      check.expect.close actual(%s) expected(%s) atol(0.0) rtol(9.9999999999999995e-07) nan(different) : tensor<4xf32>
    }
  }
  check.return
}

check.scenario public @convrot_256_tiny {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %x = check.generate.fill value(1.0000000000000001e-32) : tensor<4x256xbf16>
    %y = check.generate.fill value(99) : tensor<4x256xi8>
    %s = check.generate.fill value(-1.0) : tensor<4xf32>
    check.compare<@convrot_256, @reference_256>(%x, %y, %s) : (tensor<4x256xbf16>, tensor<4x256xi8>, tensor<4xf32>) -> () {
      check.expect.bitwise actual(%y) expected(%y) : tensor<4x256xi8>
      check.expect.close actual(%s) expected(%s) atol(0.0) rtol(9.9999999999999995e-07) nan(different) : tensor<4xf32>
    }
  }
  check.return
}

