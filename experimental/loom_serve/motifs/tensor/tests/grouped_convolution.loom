check.scenario public @residual_block_case {
  check.requires<hal.amdgpu.target> {target = "gfx11-generic"}
  check.trial[2](%trial: index, %entropy: check.entropy) {
    %input_seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %dynamic_seed = check.entropy.read %entropy[1] : check.entropy -> i64
    %base_seed = check.entropy.read %entropy[2] : check.entropy -> i64
