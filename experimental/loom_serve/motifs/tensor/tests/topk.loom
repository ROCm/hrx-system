  check.trial[1](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %input = check.generate.iota offset(0.0) step(1.0) period(17) : tensor<2x8201xf32>
    %ids = check.generate.iota offset(8200) step(-1) period(8201) : tensor<2x8201xi32>
    %values = check.generate.fill value(-99.0) : tensor<2x3x16xf32>
    %output_ids = check.generate.fill value(-99) : tensor<2x3x16xi32>
    check.compare<@short_tail, @short_tail_reference>(%input, %ids, %values, %output_ids) : (tensor<2x8201xf32>, tensor<2x8201xi32>, tensor<2x3x16xf32>, tensor<2x3x16xi32>) -> () {
      check.expect.bitwise actual(%values) expected(%values) : tensor<2x3x16xf32>
      check.expect.bitwise actual(%output_ids) expected(%output_ids) : tensor<2x3x16xi32>
    }
  }
  check.return
}

