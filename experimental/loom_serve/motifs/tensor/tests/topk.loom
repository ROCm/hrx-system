amdgpu.target<gfx11-generic> @wave32 {subgroup_size = 32}

template.decl @selection.topk_partial_f32(%rows: index, %columns: index, %count: index, %input: buffer, %output_values: buffer, %output_ids: buffer)

template.decl @selection.topk_merge_f32(%rows: index, %partitions: index, %count: index, %input_values: buffer, %input_ids: buffer, %output_values: buffer, %output_ids: buffer)

// Serial order-statistic oracle. Each rank scans the unmodified input using
// the preceding rank's strict (value descending, ID ascending) frontier.
func.def @topk_reference(%rows: index, %columns: index, %count: index, %partitions: index, %tile_width0: index, %indexed: i1, %input: buffer, %input_ids: buffer, %output_values: buffer, %output_ids: buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %tile_width = index.assume %tile_width0 [ge(%tile_width0, 1)] : index
  %x = buffer.view %input[%origin] : buffer -> view<[%rows]x[%columns]xf32>
  %t = buffer.view %input_ids[%origin] : buffer -> view<[%rows]x[%columns]xi32>
  %y = buffer.view %output_values[%origin] : buffer -> view<[%rows]x[%partitions]x[%count]xf32>
  %ids = buffer.view %output_ids[%origin] : buffer -> view<[%rows]x[%partitions]x[%count]xi32>
  %negative = scalar.constant -inf : f32
  %positive = scalar.constant inf : f32
  %largest = scalar.constant 2147483647 : i32
  %none = scalar.constant -1 : i32
  scf.for %row = [%c0 to %rows step %c1] {
    scf.for %partition = [%c0 to %partitions step %c1] {
      %begin = index.mul %partition, %tile_width : index
      %limit = index.add %begin, %tile_width : index
      %end = index.min %limit, %columns : index
      %last_value, %last_id = scf.for %rank = [%c0 to %count step %c1](%previous = %positive : f32, %previous_id = %none : i32) -> (f32, i32) {
        %value, %id = scf.for %column0 = [%begin to %end step %c1](%best = %negative : f32, %best_id = %largest : i32) -> (f32, i32) {
          %column = index.assume %column0 [ge(%column0, 0), lt(%column0, %columns)] : index
          %candidate = view.load %x[%row, %column] : view<[%rows]x[%columns]xf32> -> f32
          %candidate_id = scf.if %indexed -> (i32) {
            %id = view.load %t[%row, %column] : view<[%rows]x[%columns]xi32> -> i32
            scf.yield %id : i32
          } else {
            %id = index.cast %column : index to i32
            scf.yield %id : i32
          }
          %lower = scalar.cmpf olt, %candidate, %previous : f32
          %equal_previous = scalar.cmpf oeq, %candidate, %previous : f32
          %later_id = scalar.cmpi sgt, %candidate_id, %previous_id : i32
          %later_tie = scalar.andi %equal_previous, %later_id : i1
          %after = scalar.ori %lower, %later_tie : i1
          %valid = scalar.cmpi ne, %candidate_id, %largest : i32
          %eligible = scalar.andi %after, %valid : i1
          %greater = scalar.cmpf ogt, %candidate, %best : f32
          %equal_best = scalar.cmpf oeq, %candidate, %best : f32
          %earlier_id = scalar.cmpi slt, %candidate_id, %best_id : i32
          %earlier_tie = scalar.andi %equal_best, %earlier_id : i1
          %better = scalar.ori %greater, %earlier_tie : i1
          %take = scalar.andi %eligible, %better : i1
          %next = scf.select %take, %candidate, %best : f32
          %next_id = scf.select %take, %candidate_id, %best_id : i32
          scf.yield %next, %next_id : f32, i32
        }
        view.store %value, %y[%row, %partition, %rank] : f32, view<[%rows]x[%partitions]x[%count]xf32>
        view.store %id, %ids[%row, %partition, %rank] : i32, view<[%rows]x[%partitions]x[%count]xi32>
        scf.yield %value, %id : f32, i32
      }
    }
  }
  func.return
}

kernel.def target(@wave32) @vocabulary() {
  %x = index.constant 61 : index
  %y = index.constant 1 : index
  %threads = index.constant 256 : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%x, %y, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%input: buffer, %input_ids: buffer, %output_values: buffer, %output_ids: buffer) {
  %rows = index.constant 1 : index
  %columns = index.constant 248320 : index
  %partitions = index.constant 61 : index
  %count = index.constant 16 : index
  template.apply<@selection.topk_partial_f32>(%rows, %columns, %count, %input, %output_values, %output_ids) : (index, index, index, buffer, buffer, buffer)
  kernel.return
}

func.def @vocabulary_reference(%input: buffer, %input_ids: buffer, %output_values: buffer, %output_ids: buffer) {
  %rows = index.constant 1 : index
  %columns = index.constant 248320 : index
  %count = index.constant 16 : index
  %partitions = index.constant 61 : index
  %tile_width = index.constant 4096 : index
  %indexed = scalar.constant false : i1
  func.call @topk_reference(%rows, %columns, %count, %partitions, %tile_width, %indexed, %input, %input_ids, %output_values, %output_ids) : (index, index, index, index, index, i1, buffer, buffer, buffer, buffer)
  func.return
}

check.scenario public @vocabulary_case {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-2.0 to 2.0) : tensor<1x248320xf32>
    %ids = check.generate.iota offset(248319) step(-1) period(248320) : tensor<1x248320xi32>
    %values = check.generate.fill value(-99.0) : tensor<1x61x16xf32>
    %output_ids = check.generate.fill value(-99) : tensor<1x61x16xi32>
    check.compare<@vocabulary, @vocabulary_reference>(%input, %ids, %values, %output_ids) : (tensor<1x248320xf32>, tensor<1x248320xi32>, tensor<1x61x16xf32>, tensor<1x61x16xi32>) -> () {
      check.expect.bitwise actual(%values) expected(%values) : tensor<1x61x16xf32>
      check.expect.bitwise actual(%output_ids) expected(%output_ids) : tensor<1x61x16xi32>
    }
  }
  check.return
}

