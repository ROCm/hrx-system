// Equal winners in sixty separate vocabulary tiles must merge by token ID.
// This exercises the actual two-dispatch path, including the short last tile.
check.case public @vocabulary_merge_case {
  %input = check.generate.iota offset(0.0) step(1.0) period(4096) : tensor<1x248320xf32>
  %partial_values = check.generate.fill value(-99.0) : tensor<1x61x16xf32>
  %partial_ids = check.generate.fill value(-99) : tensor<1x61x16xi32>
  %values = check.generate.fill value(-99.0) : tensor<1x16xf32>
  %ids = check.generate.fill value(-99) : tensor<1x16xi32>
  %expected_values = check.generate.fill value(4095.0) : tensor<1x16xf32>
  %expected_ids = check.generate.iota offset(4095) step(4096) : tensor<1x16xi32>
  kernel.launch @vocabulary(%input, %input, %partial_values, %partial_ids) : (tensor<1x248320xf32>, tensor<1x248320xf32>, tensor<1x61x16xf32>, tensor<1x61x16xi32>)
  kernel.launch @merge_vocabulary(%partial_values, %partial_ids, %values, %ids) : (tensor<1x61x16xf32>, tensor<1x61x16xi32>, tensor<1x16xf32>, tensor<1x16xi32>)
  check.expect.bitwise actual(%values) expected(%expected_values) : tensor<1x16xf32>
  check.expect.bitwise actual(%ids) expected(%expected_ids) : tensor<1x16xi32>
  check.return
}
