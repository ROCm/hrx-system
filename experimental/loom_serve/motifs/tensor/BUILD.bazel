load("//loom/build_tools/bazel:defs.bzl", "loom_library", "loom_test")
load("//loom/src/loom/tooling/target/spirv:execution_profiles.bzl", "SPIRV_VULKAN_HARDWARE_PROFILE")
load("//loom/target/amdgpu:execution_profiles.bzl", "AMDGPU_ACCESS_PROFILE", "AMDGPU_HARDWARE_PROFILE")
load("//loom/target/vm:execution_profiles.bzl", "VM_REFERENCE_PROFILE")

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "sources",
    srcs = glob(["*.loom"]),
    visibility = ["//visibility:public"],
)

loom_library(
    name = "library",
    srcs = glob(["*.loom"]),
    visibility = ["//visibility:public"],
)

loom_test(
    name = "layer_gather_test",
    srcs = [
        "layer_mix.loom",
        "tests/layer_gather.loom",
    ],
    benchmark_smoke = False,
    execution_profiles = [
        AMDGPU_HARDWARE_PROFILE,
        AMDGPU_ACCESS_PROFILE,
        SPIRV_VULKAN_HARDWARE_PROFILE,
    ],
)

loom_test(
    name = "random_test",
    srcs = [
        "random.loom",
        "tests/random.loom",
    ],
    benchmark_smoke = False,
    execution_profiles = [VM_REFERENCE_PROFILE],
)

loom_test(
    name = "sampling_test",
    srcs = [
        "random.loom",
        "sampling.loom",
        "tests/sampling.loom",
    ],
    benchmark_smoke = False,
    execution_profiles = [
        AMDGPU_HARDWARE_PROFILE,
        AMDGPU_ACCESS_PROFILE,
    ],
)

loom_test(
    name = "grouped_convolution_test",
    srcs = [
        "grouped_convolution.loom",
        "tests/grouped_convolution.loom",
    ],
    benchmark_smoke = False,
    execution_profiles = [
        AMDGPU_HARDWARE_PROFILE,
        AMDGPU_ACCESS_PROFILE,
    ],
)

loom_test(
    name = "topk_test",
    srcs = [
        "tests/topk.loom",
        "topk.loom",
    ],
    benchmark_smoke = False,
    execution_profiles = [
        AMDGPU_HARDWARE_PROFILE,
        AMDGPU_ACCESS_PROFILE,
    ],
)

loom_test(
    name = "quantization_test",
    srcs = [
        "quantization.loom",
        "tests/quantization.loom",
    ],
    benchmark_smoke = False,
    execution_profiles = [AMDGPU_HARDWARE_PROFILE],
)

loom_test(
    name = "linear_i8_test",
    srcs = [
        "linear_i8.loom",
        "linear_tiled.loom",
        "tests/linear_i8.loom",
    ],
    benchmark_smoke = False,
    execution_profiles = [AMDGPU_HARDWARE_PROFILE],
)
