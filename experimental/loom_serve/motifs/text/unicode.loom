// Unicode 15.0 data is generated by generate_unicode.py from the UCD. The
// interpreter below owns the source contract independently of those rows.
// BEGIN GENERATED UNICODE DATA
global.constant @text.uppercase_count : index = 1525

global.rodata.def @text.uppercase_rows = align(4) bytes("")

global.constant @text.space_count : index = 10

global.rodata.def @text.space_rows = align(4) bytes("090000000d0000001c000000200000008500000085000000a0000000a00000008016000080160000002000000a20000028200000292000002f2000002f2000005f2000005f2000000030000000300000")

global.constant @text.digit_count : index = 83

global.rodata.def @text.digit_rows = align(4) bytes("")

// END GENERATED UNICODE DATA
// Full, locale-independent uppercase of one codepoint. Zero second/third
// results mark unused expansion positions; uppercase mappings never emit NUL.
func.def public @text.uppercase(%codepoint: i32) -> (i32, i32, i32) {
  %storage = global.load @text.uppercase_rows : buffer
  %count = global.load @text.uppercase_count : index
  %origin = index.constant 0 : offset
  %rows = buffer.view %storage[%origin] : buffer -> view<[%count]x4xi32>
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %position_value, %unused = scf.while(%lower = %zero : index, %upper = %count : index) -> (index, index) {
    %search = index.cmp ult, %lower, %upper : index
    scf.condition %search, %lower, %upper : i1, index, index
  } do(%lower: index, %upper: index) {
    %sum = index.add %lower, %upper : index
    %middle_value = index.div %sum, %two : index
    // The search interval remains within [0, count).
    %middle = index.assume %middle_value [ge(%middle_value, 0), lt(%middle_value, %count)] : index
    %key = view.load %rows[%middle, 0] : view<[%count]x4xi32> -> i32
    %before = scalar.cmpi ult, %key, %codepoint : i32
    %after = index.add %middle, %one : index
    %next_lower = scf.select %before, %after, %lower : index
    %next_upper = scf.select %before, %upper, %middle : index
    scf.yield %next_lower, %next_upper : index, index
  }
  %position = index.assume %position_value [ge(%position_value, 0), le(%position_value, %count)] : index
  %present = index.cmp ult, %position, %count : index
  %empty = scalar.constant 0 : i32
  %first, %second, %third = scf.if %present -> (i32, i32, i32) {
    %key = view.load %rows[%position, 0] : view<[%count]x4xi32> -> i32
    %matches = scalar.cmpi eq, %key, %codepoint : i32
    %a = view.load %rows[%position, 1] : view<[%count]x4xi32> -> i32
    %b = view.load %rows[%position, 2] : view<[%count]x4xi32> -> i32
    %c = view.load %rows[%position, 3] : view<[%count]x4xi32> -> i32
    %first = scf.select %matches, %a, %codepoint : i32
    %second = scf.select %matches, %b, %empty : i32
    %third = scf.select %matches, %c, %empty : i32
    scf.yield %first, %second, %third : i32, i32, i32
  } else {
    scf.yield %codepoint, %empty, %empty : i32, i32, i32
  }
  func.return %first, %second, %third : i32, i32, i32
}

func.def @text.in_ranges(%storage: buffer, %count: index, %codepoint: i32) -> (i1) {
  %origin = index.constant 0 : offset
  %rows = buffer.view %storage[%origin] : buffer -> view<[%count]x2xi32>
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %position_value, %unused = scf.while(%lower = %zero : index, %upper = %count : index) -> (index, index) {
    %search = index.cmp ult, %lower, %upper : index
    scf.condition %search, %lower, %upper : i1, index, index
  } do(%lower: index, %upper: index) {
    %sum = index.add %lower, %upper : index
    %middle_value = index.div %sum, %two : index
    // The search interval remains within [0, count).
    %middle = index.assume %middle_value [ge(%middle_value, 0), lt(%middle_value, %count)] : index
    %end = view.load %rows[%middle, 1] : view<[%count]x2xi32> -> i32
    %before = scalar.cmpi ult, %end, %codepoint : i32
    %after = index.add %middle, %one : index
    %next_lower = scf.select %before, %after, %lower : index
    %next_upper = scf.select %before, %upper, %middle : index
    scf.yield %next_lower, %next_upper : index, index
  }
  %position = index.assume %position_value [ge(%position_value, 0), le(%position_value, %count)] : index
  %present = index.cmp ult, %position, %count : index
  %inside = scf.if %present -> (i1) {
    %begin = view.load %rows[%position, 0] : view<[%count]x2xi32> -> i32
    %inside = scalar.cmpi uge, %codepoint, %begin : i32
    scf.yield %inside : i1
  } else {
    %false = scalar.constant false : i1
    scf.yield %false : i1
  }
  func.return %inside : i1
}

// Python-compatible whitespace: category Zs or bidi class WS, B, or S.
func.def public @text.is_space(%codepoint: i32) -> (i1) {
  %ascii_end = scalar.constant 128 : i32
  %ascii = scalar.cmpi ult, %codepoint, %ascii_end : i32
  %result = scf.if %ascii -> (i1) {
    %tab = scalar.constant 9 : i32
    %carriage_return = scalar.constant 13 : i32
    %separator = scalar.constant 28 : i32
    %space = scalar.constant 32 : i32
    %after_tab = scalar.cmpi uge, %codepoint, %tab : i32
    %before_return = scalar.cmpi ule, %codepoint, %carriage_return : i32
    %control = scalar.andi %after_tab, %before_return : i1
    %after_separator = scalar.cmpi uge, %codepoint, %separator : i32
    %before_space = scalar.cmpi ule, %codepoint, %space : i32
    %framing = scalar.andi %after_separator, %before_space : i1
    %inside = scalar.ori %control, %framing : i1
    scf.yield %inside : i1
  } else {
    %storage = global.load @text.space_rows : buffer
    %count = global.load @text.space_count : index
    %inside = func.call @text.in_ranges(%storage, %count, %codepoint) : (buffer, index, i32) -> (i1)
    scf.yield %inside : i1
  }
  func.return %result : i1
}

// Includes both Decimal and Digit numeric types, matching str.isdigit().
func.def public @text.is_digit(%codepoint: i32) -> (i1) {
  %ascii_end = scalar.constant 128 : i32
  %ascii = scalar.cmpi ult, %codepoint, %ascii_end : i32
  %result = scf.if %ascii -> (i1) {
    %zero = scalar.constant 48 : i32
    %nine = scalar.constant 57 : i32
    %after = scalar.cmpi uge, %codepoint, %zero : i32
    %before = scalar.cmpi ule, %codepoint, %nine : i32
    %inside = scalar.andi %after, %before : i1
    scf.yield %inside : i1
  } else {
    %storage = global.load @text.digit_rows : buffer
    %count = global.load @text.digit_count : index
    %inside = func.call @text.in_ranges(%storage, %count, %codepoint) : (buffer, index, i32) -> (i1)
    scf.yield %inside : i1
  }
  func.return %result : i1
}
