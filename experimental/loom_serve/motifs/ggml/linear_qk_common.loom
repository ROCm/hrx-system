template.decl @ggml.qk.scale_min(%weight: buffer, %block_byte_base: offset, %group: index) -> (f32, f32)

template.decl @ggml.qk.scale_min.header(%header_words: vector<4xi32>, %group: index) -> (f32, f32)

template.decl @ggml.qk.unsigned_q8_1_dot(%quantized_values: vector<16xi8>, %d_scale: f32, %dmin_scale: f32, %q8_values: vector<16xi8>, %q8_d: f32, %q8_s: f32) -> (f32)

// Q4_K and Q5_K share this 16-byte metadata header: two half scales followed
// by eight packed six-bit scale/minimum pairs. Their code payloads differ,
// but the metadata interpretation is identical. Callers retaining a loaded
// header can decode multiple groups without reloading it.
template.def<@ggml.qk.scale_min.header> device @ggml_qk_scale_min_header(%header_words: vector<4xi32>, %group: index) -> (f32, f32) {
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c4_i32 = scalar.constant 4 : i32
  %c6_i32 = scalar.constant 6 : i32
  %c15_i32 = scalar.constant 15 : i32
  %c63_i32 = scalar.constant 63 : i32
  %c255_i32 = scalar.constant 255 : i32
  %bounded_group = index.assume %group [range(%group, 0, 7)] : index
  %header_halves = vector.bitcast %header_words : vector<4xi32> to vector<8xf16>
  %d_f16 = vector.extract %header_halves[0] : vector<8xf16> -> f16
  %dmin_f16 = vector.extract %header_halves[1] : vector<8xf16> -> f16
  %d = scalar.extf %d_f16 : f16 to f32
  %dmin = scalar.extf %dmin_f16 : f16 to f32
  %scale_word = vector.extract %header_words[1] : vector<4xi32> -> i32
  %minimum_word = vector.extract %header_words[2] : vector<4xi32> -> i32
  %packed_word = vector.extract %header_words[3] : vector<4xi32> -> i32
  %word_byte = index.rem %bounded_group, %c4 : index
  %byte_shift_index = index.mul %word_byte, %c8 : index
  %byte_shift = index.cast %byte_shift_index : index to i32
  %shifted_scale_word = scalar.shrui %scale_word, %byte_shift : i32
  %shifted_minimum_word = scalar.shrui %minimum_word, %byte_shift : i32
  %shifted_packed_word = scalar.shrui %packed_word, %byte_shift : i32
  %scale_byte = scalar.andi %shifted_scale_word, %c255_i32 : i32
  %minimum_byte = scalar.andi %shifted_minimum_word, %c255_i32 : i32
  %packed_byte = scalar.andi %shifted_packed_word, %c255_i32 : i32
  %scale_low6 = scalar.andi %scale_byte, %c63_i32 : i32
  %minimum_low6 = scalar.andi %minimum_byte, %c63_i32 : i32
  %scale_low4 = scalar.andi %packed_byte, %c15_i32 : i32
  %minimum_low4 = scalar.shrui %packed_byte, %c4_i32 : i32
  %scale_high2_raw = scalar.shrui %scale_byte, %c6_i32 : i32
  %minimum_high2_raw = scalar.shrui %minimum_byte, %c6_i32 : i32
  %scale_high2 = scalar.shli %scale_high2_raw, %c4_i32 : i32
  %minimum_high2 = scalar.shli %minimum_high2_raw, %c4_i32 : i32
  %scale_high = scalar.ori %scale_low4, %scale_high2 : i32
  %minimum_high = scalar.ori %minimum_low4, %minimum_high2 : i32
  %uses_packed_low_bits = index.cmp uge, %bounded_group, %c4 : index
  %scale = scf.select %uses_packed_low_bits, %scale_high, %scale_low6 : i32
  %minimum = scf.select %uses_packed_low_bits, %minimum_high, %minimum_low6 : i32
  %scale_f32 = scalar.uitofp %scale : i32 to f32
  %minimum_f32 = scalar.uitofp %minimum : i32 to f32
  %d_scale = scalar.mulf %d, %scale_f32 : f32
  %dmin_scale = scalar.mulf %dmin, %minimum_f32 : f32
  template.return %d_scale, %dmin_scale : f32, f32
}

// Decodes one QK scale/minimum pair from the naturally aligned 16-byte
// header. Keeping the header in one vector load avoids lane-divergent byte-load
// paths inside the production contraction loop.
template.def<@ggml.qk.scale_min> device @ggml_qk_scale_min(%weight: buffer, %block_byte_base: offset, %group: index) -> (f32, f32) {
  %header_view = buffer.view %weight[%block_byte_base] : buffer -> view<4xi32>
  %header_words = vector.load %header_view[0] : view<4xi32> -> vector<4xi32>
  %d_scale, %dmin_scale = template.apply<@ggml.qk.scale_min.header>(%header_words, %group) : (vector<4xi32>, index) -> (f32, f32)
  template.return %d_scale, %dmin_scale : f32, f32
}

// Contracts one 16-value unsigned K-quant half-group with Q8_1. Paired lanes
// use the same minimum and each apply half the Q8_1 block sum; their subgroup
// reduction therefore applies the 32-value minimum correction exactly once.
template.def<@ggml.qk.unsigned_q8_1_dot> device @ggml_qk_unsigned_q8_1_dot(%quantized_values: vector<16xi8>, %d_scale: f32, %dmin_scale: f32, %q8_values: vector<16xi8>, %q8_d: f32, %q8_s: f32) -> (f32) {
  %c0_i32 = scalar.constant 0 : i32
  %c0_i32v = vector.constant 0 : vector<4xi32>
  %c0_5_f32 = scalar.constant 0.5 : f32
  %partial_dots = vector.dot4i<u8s8> %quantized_values, %q8_values, %c0_i32v : vector<16xi8>, vector<16xi8>, vector<4xi32>
  %quantized_sum = vector.reduce<addi> %partial_dots, %c0_i32 : vector<4xi32>, i32
  %quantized_sum_f32 = scalar.sitofp %quantized_sum : i32 to f32
  %scaled_dot0 = scalar.mulf<reassoc|nnan|ninf|nsz> %q8_d, %d_scale : f32
  %scaled_dot = scalar.mulf<reassoc|nnan|ninf|nsz> %scaled_dot0, %quantized_sum_f32 : f32
  %q8_half_sum = scalar.mulf<reassoc|nnan|ninf|nsz> %q8_s, %c0_5_f32 : f32
  %minimum_correction = scalar.mulf<reassoc|nnan|ninf|nsz> %dmin_scale, %q8_half_sum : f32
  %contribution = scalar.subf<reassoc|nnan|ninf|nsz> %scaled_dot, %minimum_correction : f32
  template.return %contribution : f32
}
