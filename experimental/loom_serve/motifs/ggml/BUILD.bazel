load("//loom/build_tools/bazel:defs.bzl", "loom_test")
load("//loom/src/loom/tooling/target/spirv:execution_profiles.bzl", "SPIRV_VULKAN_HARDWARE_PROFILE")
load("//loom/target/amdgpu:execution_profiles.bzl", "AMDGPU_ACCESS_PROFILE", "AMDGPU_HARDWARE_PROFILE")

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "sources",
    srcs = glob(["*.loom"]),
    visibility = ["//visibility:public"],
)

loom_test(
    name = "quantize_test",
    srcs = ["quantize_q8_1_x4.loom"],
    benchmark_smoke = False,
    configs = {"ggml.quantize_q8_1_x4.group_capacity": "8192"},
    execution_profiles = [
        AMDGPU_HARDWARE_PROFILE,
        AMDGPU_ACCESS_PROFILE,
        SPIRV_VULKAN_HARDWARE_PROFILE,
    ],
)

loom_test(
    name = "selection_test",
    srcs = [
        "linear_qk_common.loom",
        "q4k.loom",
        "selection.loom",
        "tests/selection.loom",
    ],
    benchmark_smoke = False,
    execution_profiles = [
        AMDGPU_HARDWARE_PROFILE,
        AMDGPU_ACCESS_PROFILE,
    ],
)

loom_test(
    name = "narrow_projection_test",
    srcs = [":sources"],
    benchmark_smoke = False,
    configs = {
        "ggml.linear_q5k_q8_1_x4.output_capacity": "65",
        "ggml.linear_q5k_q8_1_x4.token_capacity": "4",
        "ggml.linear_q6k_f32_decode.output_capacity": "9",
        "ggml.linear_q6k_q8_1_x4.output_capacity": "9",
        "ggml.linear_q6k_q8_1_x4.token_capacity": "4",
        "ggml.quantize_q8_1_x4.group_capacity": "2176",
    },
    execution_profiles = [
        AMDGPU_HARDWARE_PROFILE,
        AMDGPU_ACCESS_PROFILE,
    ],
    variants = {
        "q5_q8": {"case": "@ggml_linear_q5k_q8_1_x4_m4_differential_case"},
        "q6_f32": {"case": "@ggml_linear_q6k_f32_decode_m4_nonzero_tail_case"},
        "q6_q8": {"case": "@ggml_linear_q6k_q8_1_x4_m4_wave64_block4_differential_case"},
        "q6_q8_single": {"case": "@ggml_linear_q6k_q8_1_x4_wave64_block4_nonzero_tail_case"},
    },
)

loom_test(
    name = "q6_projection_test",
    srcs = [
        "linear_q6k_q8_1_x4.loom",
        "quantize_q8_1_x4.loom",
        "tests/linear_q6k_q8_1_x4.loom",
    ],
    benchmark_smoke = False,
    configs = {
        "ggml.linear_q6k_q8_1_x4.output_capacity": "9",
        "ggml.linear_q6k_q8_1_x4.token_capacity": "4",
        "ggml.quantize_q8_1_x4.group_capacity": "2176",
    },
    execution_profiles = [
        AMDGPU_HARDWARE_PROFILE,
        AMDGPU_ACCESS_PROFILE,
        SPIRV_VULKAN_HARDWARE_PROFILE,
    ],
    variants = {
        "m4": {"case": "@ggml_linear_q6k_q8_1_x4_m4_distinct_rows_case"},
        "single": {"case": "@ggml_linear_q6k_q8_1_x4_nonzero_tail_case"},
    },
)
