  check.return
}

// Exact Qwen3.8 four-row FFN down-projection shape reusing Q6_K packets.
check.case public @ggml_linear_q6k_f32_decode_m4_ffn_down_benchmark_case {
  %token_count = check.literal value(4) : index
  %input_size = check.literal value(17408) : index
  %output_size = check.literal value(5120) : index
  %input = check.generate.fill value(0.00390625) : tensor<4x17408xf32>
