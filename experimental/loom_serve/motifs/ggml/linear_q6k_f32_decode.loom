  kernel.launch @ggml_linear_q6k_f32_decode_m4[%token_count, %input_size, %output_size](%token_count, %input_size, %output_size, %input, %weight, %output) : [index, index, index](index, index, index, tensor<4x17408xf32>, tensor<5120x68x210xi8>, tensor<4x5120xf32>)
  check.return
}

