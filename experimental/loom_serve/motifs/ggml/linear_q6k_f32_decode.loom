// Contracts GGML Q6_K weight rows directly with resident F32 activation rows.
// Sixteen lanes decode one 256-value weight block. A subgroup therefore
// advances across two blocks on wave32 and four blocks on wave64 without
// changing the source or ABI. Each subgroup computes two output channels and
// shares its activation loads between them. The small token dimension is
// mapped to independent workgroups so one-row decode and four-row speculative
// verification retain exactly the same per-row accumulation structure.

config.decl @ggml.linear_q6k_f32_decode.output_capacity : %value: index where [range(%value, 1, 262144)]

// Contracts the 16 values owned by one lane for one Q6_K block and output row.
// The four activation vectors are supplied by the two-row caller so both rows
// reuse the same F32 loads.
func.def inline @ggml_q6k_f32_block_row_lane(%weight: buffer, %weight_row_byte_base: offset, %q6_block: index, %lane_in_block: index, %input0: vector<4xf32>, %input32: vector<4xf32>, %input64: vector<4xf32>, %input96: vector<4xf32>) -> (f32) {
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %block_bytes = index.constant 210 : offset
  %qh_byte_add = index.constant 128 : offset
  %scale_byte_add = index.constant 192 : offset
  %d_byte_add = index.constant 208 : offset
  %c2_i32v = vector.constant 2 : vector<1xi32>
  %c4_i32v = vector.constant 4 : vector<1xi32>
  %nibble_mask = vector.constant 252645135 : vector<1xi32>
  %qh0_mask = vector.constant 50529027 : vector<1xi32>
  %qh2_mask = vector.constant 202116108 : vector<1xi32>
  %qh4_mask = vector.constant 808464432 : vector<1xi32>
  %qh6_mask = vector.constant -1061109568 : vector<1xi32>
  %c32_f32v = vector.constant 32.0 : vector<4xf32>
  %c0_f32 = scalar.constant 0.0 : f32
  %bounded_lane = index.assume %lane_in_block [range(%lane_in_block, 0, 15)] : index
  %block_byte_add = index.scale %q6_block, %block_bytes : index, offset -> offset
  %block_byte_base = index.add %weight_row_byte_base, %block_byte_add : offset
  %qh_byte_base = index.add %block_byte_base, %qh_byte_add : offset
  %scale_byte_base = index.add %block_byte_base, %scale_byte_add : offset
  %d_byte_base = index.add %block_byte_base, %d_byte_add : offset
  %ql_view = buffer.view %weight[%block_byte_base] : buffer -> view<32xi32>
  %qh_view = buffer.view %weight[%qh_byte_base] : buffer -> view<16xi32>
  %scale_view = buffer.view %weight[%scale_byte_base] : buffer -> view<16xi8>
  %d_view = buffer.view %weight[%d_byte_base] : buffer -> view<1xf16>
  %half = index.div %bounded_lane, %c8 : index
  %lane_mod8 = index.rem %bounded_lane, %c8 : index
  %ql_half_base = index.mul %half, %c16 : index
  %ql_index0 = index.add %ql_half_base, %lane_mod8 : index
  %ql_index32 = index.add %ql_index0, %c8 : index
  %qh_half_base = index.mul %half, %c8 : index
  %qh_index = index.add %qh_half_base, %lane_mod8 : index
  %scale_pair = index.div %lane_mod8, %c4 : index
  %scale_half_base = index.mul %half, %c8 : index
  %scale0 = index.add %scale_half_base, %scale_pair : index
  %scale1 = index.add %scale0, %c2 : index
  %scale2 = index.add %scale0, %c4 : index
  %scale3 = index.add %scale1, %c4 : index
  %ql0_word = vector.load %ql_view[%ql_index0] : view<32xi32> -> vector<1xi32>
  %ql32_word = vector.load %ql_view[%ql_index32] : view<32xi32> -> vector<1xi32>
  %qh_word = vector.load %qh_view[%qh_index] : view<16xi32> -> vector<1xi32>
  %ql0_low = vector.andi %ql0_word, %nibble_mask : vector<1xi32>
  %ql32_low = vector.andi %ql32_word, %nibble_mask : vector<1xi32>
  %ql0_high0 = vector.shrui %ql0_word, %c4_i32v : vector<1xi32>
  %ql0_high = vector.andi %ql0_high0, %nibble_mask : vector<1xi32>
  %ql32_high0 = vector.shrui %ql32_word, %c4_i32v : vector<1xi32>
  %ql32_high = vector.andi %ql32_high0, %nibble_mask : vector<1xi32>
  %qh0_low = vector.andi %qh_word, %qh0_mask : vector<1xi32>
  %qh0 = vector.shli %qh0_low, %c4_i32v : vector<1xi32>
  %qh2_low = vector.andi %qh_word, %qh2_mask : vector<1xi32>
  %qh2 = vector.shli %qh2_low, %c2_i32v : vector<1xi32>
  %qh4 = vector.andi %qh_word, %qh4_mask : vector<1xi32>
  %qh6_high = vector.andi %qh_word, %qh6_mask : vector<1xi32>
  %qh6 = vector.shrui %qh6_high, %c2_i32v : vector<1xi32>
  %code0_word = vector.ori %ql0_low, %qh0 : vector<1xi32>
  %code1_word = vector.ori %ql32_low, %qh2 : vector<1xi32>
  %code2_word = vector.ori %ql0_high, %qh4 : vector<1xi32>
  %code3_word = vector.ori %ql32_high, %qh6 : vector<1xi32>
  %code0_i8 = vector.bitcast %code0_word : vector<1xi32> to vector<4xi8>
  %code1_i8 = vector.bitcast %code1_word : vector<1xi32> to vector<4xi8>
  %code2_i8 = vector.bitcast %code2_word : vector<1xi32> to vector<4xi8>
  %code3_i8 = vector.bitcast %code3_word : vector<1xi32> to vector<4xi8>
  %code0_f32 = vector.uitofp %code0_i8 : vector<4xi8> to vector<4xf32>
  %code1_f32 = vector.uitofp %code1_i8 : vector<4xi8> to vector<4xf32>
  %code2_f32 = vector.uitofp %code2_i8 : vector<4xi8> to vector<4xf32>
  %code3_f32 = vector.uitofp %code3_i8 : vector<4xi8> to vector<4xf32>
  %weight0 = vector.subf %code0_f32, %c32_f32v : vector<4xf32>
  %weight1 = vector.subf %code1_f32, %c32_f32v : vector<4xf32>
  %weight2 = vector.subf %code2_f32, %c32_f32v : vector<4xf32>
  %weight3 = vector.subf %code3_f32, %c32_f32v : vector<4xf32>
  %product0 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %weight0, %input0 : vector<4xf32>
  %product1 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %weight1, %input32 : vector<4xf32>
  %product2 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %weight2, %input64 : vector<4xf32>
  %product3 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %weight3, %input96 : vector<4xf32>
  %dot0 = vector.reduce<addf, reassoc|nnan|ninf|nsz|contract> %product0, %c0_f32 : vector<4xf32>, f32
  %dot1 = vector.reduce<addf, reassoc|nnan|ninf|nsz|contract> %product1, %c0_f32 : vector<4xf32>, f32
  %dot2 = vector.reduce<addf, reassoc|nnan|ninf|nsz|contract> %product2, %c0_f32 : vector<4xf32>, f32
  %dot3 = vector.reduce<addf, reassoc|nnan|ninf|nsz|contract> %product3, %c0_f32 : vector<4xf32>, f32
  %scale0_i8 = view.load %scale_view[%scale0] : view<16xi8> -> i8
  %scale1_i8 = view.load %scale_view[%scale1] : view<16xi8> -> i8
  %scale2_i8 = view.load %scale_view[%scale2] : view<16xi8> -> i8
  %scale3_i8 = view.load %scale_view[%scale3] : view<16xi8> -> i8
  %scale0_f32 = scalar.sitofp %scale0_i8 : i8 to f32
  %scale1_f32 = scalar.sitofp %scale1_i8 : i8 to f32
  %scale2_f32 = scalar.sitofp %scale2_i8 : i8 to f32
  %scale3_f32 = scalar.sitofp %scale3_i8 : i8 to f32
  %scaled0 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %dot0, %scale0_f32 : f32
  %scaled1 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %dot1, %scale1_f32 : f32
  %scaled2 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %dot2, %scale2_f32 : f32
  %scaled3 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %dot3, %scale3_f32 : f32
  %sum01 = scalar.addf<reassoc|nnan|ninf|nsz> %scaled0, %scaled1 : f32
  %sum23 = scalar.addf<reassoc|nnan|ninf|nsz> %scaled2, %scaled3 : f32
  %sum = scalar.addf<reassoc|nnan|ninf|nsz> %sum01, %sum23 : f32
  %d_f16 = view.load %d_view[0] : view<1xf16> -> f16
  %d = scalar.extf %d_f16 : f16 to f32
  %result = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %sum, %d : f32
  func.return %result : f32
}

// Computes two output rows while loading each F32 activation packet once.
func.def inline @ggml_q6k_f32_block_lane_row2(%input: buffer, %input_row_byte_base: offset, %weight: buffer, %weight_row0_byte_base: offset, %weight_row1_byte_base: offset, %q6_block: index, %lane_in_block: index) -> (f32, f32) {
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %c96 = index.constant 96 : index
  %c128 = index.constant 128 : index
  %c256 = index.constant 256 : index
  %f32_bytes = index.constant 4 : offset
  %bounded_lane = index.assume %lane_in_block [range(%lane_in_block, 0, 15)] : index
  %half = index.div %bounded_lane, %c8 : index
  %lane_mod8 = index.rem %bounded_lane, %c8 : index
  %half_element_base = index.mul %half, %c128 : index
  %lane_element_add = index.mul %lane_mod8, %c4 : index
  %block_element_base = index.mul %q6_block, %c256 : index
  %input_element0a = index.add %block_element_base, %half_element_base : index
  %input_element0 = index.add %input_element0a, %lane_element_add : index
  %input_element32 = index.add %input_element0, %c32 : index
  %input_element64 = index.add %input_element0, %c64 : index
  %input_element96 = index.add %input_element0, %c96 : index
  %input_byte_add0 = index.scale %input_element0, %f32_bytes : index, offset -> offset
  %input_byte_add32 = index.scale %input_element32, %f32_bytes : index, offset -> offset
  %input_byte_add64 = index.scale %input_element64, %f32_bytes : index, offset -> offset
  %input_byte_add96 = index.scale %input_element96, %f32_bytes : index, offset -> offset
  %input_byte_base0 = index.add %input_row_byte_base, %input_byte_add0 : offset
  %input_byte_base32 = index.add %input_row_byte_base, %input_byte_add32 : offset
  %input_byte_base64 = index.add %input_row_byte_base, %input_byte_add64 : offset
  %input_byte_base96 = index.add %input_row_byte_base, %input_byte_add96 : offset
  %input_view0 = buffer.view %input[%input_byte_base0] : buffer -> view<4xf32>
  %input_view32 = buffer.view %input[%input_byte_base32] : buffer -> view<4xf32>
  %input_view64 = buffer.view %input[%input_byte_base64] : buffer -> view<4xf32>
  %input_view96 = buffer.view %input[%input_byte_base96] : buffer -> view<4xf32>
  %input0 = vector.load %input_view0[0] : view<4xf32> -> vector<4xf32>
  %input32 = vector.load %input_view32[0] : view<4xf32> -> vector<4xf32>
  %input64 = vector.load %input_view64[0] : view<4xf32> -> vector<4xf32>
  %input96 = vector.load %input_view96[0] : view<4xf32> -> vector<4xf32>
  %row0 = func.call @ggml_q6k_f32_block_row_lane(%weight, %weight_row0_byte_base, %q6_block, %bounded_lane, %input0, %input32, %input64, %input96) : (buffer, offset, index, index, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) -> (f32)
  %row1 = func.call @ggml_q6k_f32_block_row_lane(%weight, %weight_row1_byte_base, %q6_block, %bounded_lane, %input0, %input32, %input64, %input96) : (buffer, offset, index, index, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) -> (f32)
  func.return %row0, %row1 : f32, f32
}

func.def inline @ggml_q6k_f32_row_lane2(%input_size: index, %input: buffer, %input_row_byte_base: offset, %weight: buffer, %weight_row0_byte_base: offset, %weight_row1_byte_base: offset, %lane: index) -> (f32, f32) {
  %bounded_input_size = index.assume %input_size [range(%input_size, 256, 17408), mul(%input_size, 256)] : index
  %subgroup_size = target.subgroup.size : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c16 = index.constant 16 : index
  %c256 = index.constant 256 : index
  %c0_f32 = scalar.constant 0.0 : f32
  %block_count = index.div %bounded_input_size, %c256 : index
  %blocks_per_iteration = index.div %subgroup_size, %c16 : index
  %iteration_padding = index.sub %blocks_per_iteration, %c1 : index
  %padded_block_count = index.add %block_count, %iteration_padding : index
  %iteration_count = index.div %padded_block_count, %blocks_per_iteration : index
  %block_in_iteration = index.div %lane, %c16 : index
  %lane_in_block0 = index.rem %lane, %c16 : index
  %lane_in_block = index.assume %lane_in_block0 [range(%lane_in_block0, 0, 15)] : index
  %row0, %row1 = scf.for %iteration = [%c0 to %iteration_count step %c1](%row0_acc = %c0_f32, %row1_acc = %c0_f32 : f32, f32) -> (f32, f32) {
    %block_base = index.mul %iteration, %blocks_per_iteration : index
    %block0 = index.add %block_base, %block_in_iteration : index
    %valid_block = index.cmp ult, %block0, %block_count : index
    %block_row0, %block_row1 = scf.if %valid_block -> (f32, f32) {
      %block = index.assume %block0 [lt(%block0, %block_count)] : index
      %value0, %value1 = func.call @ggml_q6k_f32_block_lane_row2(%input, %input_row_byte_base, %weight, %weight_row0_byte_base, %weight_row1_byte_base, %block, %lane_in_block) : (buffer, offset, buffer, offset, offset, index, index) -> (f32, f32)
      scf.yield %value0, %value1 : f32, f32
    } else {
      scf.yield %c0_f32, %c0_f32 : f32, f32
    }
    %next0 = scalar.addf<reassoc|nnan|ninf|nsz> %row0_acc, %block_row0 : f32
    %next1 = scalar.addf<reassoc|nnan|ninf|nsz> %row1_acc, %block_row1 : f32
    scf.yield %next0, %next1 : f32, f32
  }
  func.return %row0, %row1 : f32, f32
}

// Computes two output channels for four independent activation rows. The
// single block loop preserves the token-one contribution and reduction order;
// inlining exposes the repeated immutable Q6_K loads to canonical CSE.
func.def inline @ggml_q6k_f32_row_lane2_m4(%input_size: index, %input: buffer, %input_row0_byte_base: offset, %input_row1_byte_base: offset, %input_row2_byte_base: offset, %input_row3_byte_base: offset, %weight: buffer, %weight_row0_byte_base: offset, %weight_row1_byte_base: offset, %lane: index) -> (f32, f32, f32, f32, f32, f32, f32, f32) {
  %bounded_input_size = index.assume %input_size [range(%input_size, 256, 17408), mul(%input_size, 256)] : index
  %subgroup_size = target.subgroup.size : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c16 = index.constant 16 : index
  %c256 = index.constant 256 : index
  %c0_f32 = scalar.constant 0.0 : f32
  %block_count = index.div %bounded_input_size, %c256 : index
  %blocks_per_iteration = index.div %subgroup_size, %c16 : index
  %iteration_padding = index.sub %blocks_per_iteration, %c1 : index
  %padded_block_count = index.add %block_count, %iteration_padding : index
  %iteration_count = index.div %padded_block_count, %blocks_per_iteration : index
  %block_in_iteration = index.div %lane, %c16 : index
  %lane_in_block0 = index.rem %lane, %c16 : index
  %lane_in_block = index.assume %lane_in_block0 [range(%lane_in_block0, 0, 15)] : index
  %token0_row0, %token0_row1, %token1_row0, %token1_row1, %token2_row0, %token2_row1, %token3_row0, %token3_row1 = scf.for %iteration = [%c0 to %iteration_count step %c1](%token0_row0_acc = %c0_f32, %token0_row1_acc = %c0_f32, %token1_row0_acc = %c0_f32, %token1_row1_acc = %c0_f32, %token2_row0_acc = %c0_f32, %token2_row1_acc = %c0_f32, %token3_row0_acc = %c0_f32, %token3_row1_acc = %c0_f32 : f32, f32, f32, f32, f32, f32, f32, f32) -> (f32, f32, f32, f32, f32, f32, f32, f32) {
    %block_base = index.mul %iteration, %blocks_per_iteration : index
    %block0 = index.add %block_base, %block_in_iteration : index
    %valid_block = index.cmp ult, %block0, %block_count : index
    %block_token0_row0, %block_token0_row1, %block_token1_row0, %block_token1_row1, %block_token2_row0, %block_token2_row1, %block_token3_row0, %block_token3_row1 = scf.if %valid_block -> (f32, f32, f32, f32, f32, f32, f32, f32) {
      %block = index.assume %block0 [lt(%block0, %block_count)] : index
      %value00, %value01 = func.call @ggml_q6k_f32_block_lane_row2(%input, %input_row0_byte_base, %weight, %weight_row0_byte_base, %weight_row1_byte_base, %block, %lane_in_block) : (buffer, offset, buffer, offset, offset, index, index) -> (f32, f32)
      %value10, %value11 = func.call @ggml_q6k_f32_block_lane_row2(%input, %input_row1_byte_base, %weight, %weight_row0_byte_base, %weight_row1_byte_base, %block, %lane_in_block) : (buffer, offset, buffer, offset, offset, index, index) -> (f32, f32)
      %value20, %value21 = func.call @ggml_q6k_f32_block_lane_row2(%input, %input_row2_byte_base, %weight, %weight_row0_byte_base, %weight_row1_byte_base, %block, %lane_in_block) : (buffer, offset, buffer, offset, offset, index, index) -> (f32, f32)
      %value30, %value31 = func.call @ggml_q6k_f32_block_lane_row2(%input, %input_row3_byte_base, %weight, %weight_row0_byte_base, %weight_row1_byte_base, %block, %lane_in_block) : (buffer, offset, buffer, offset, offset, index, index) -> (f32, f32)
      scf.yield %value00, %value01, %value10, %value11, %value20, %value21, %value30, %value31 : f32, f32, f32, f32, f32, f32, f32, f32
    } else {
      scf.yield %c0_f32, %c0_f32, %c0_f32, %c0_f32, %c0_f32, %c0_f32, %c0_f32, %c0_f32 : f32, f32, f32, f32, f32, f32, f32, f32
    }
    %next00 = scalar.addf<reassoc|nnan|ninf|nsz> %token0_row0_acc, %block_token0_row0 : f32
    %next01 = scalar.addf<reassoc|nnan|ninf|nsz> %token0_row1_acc, %block_token0_row1 : f32
    %next10 = scalar.addf<reassoc|nnan|ninf|nsz> %token1_row0_acc, %block_token1_row0 : f32
    %next11 = scalar.addf<reassoc|nnan|ninf|nsz> %token1_row1_acc, %block_token1_row1 : f32
    %next20 = scalar.addf<reassoc|nnan|ninf|nsz> %token2_row0_acc, %block_token2_row0 : f32
    %next21 = scalar.addf<reassoc|nnan|ninf|nsz> %token2_row1_acc, %block_token2_row1 : f32
    %next30 = scalar.addf<reassoc|nnan|ninf|nsz> %token3_row0_acc, %block_token3_row0 : f32
    %next31 = scalar.addf<reassoc|nnan|ninf|nsz> %token3_row1_acc, %block_token3_row1 : f32
    scf.yield %next00, %next01, %next10, %next11, %next20, %next21, %next30, %next31 : f32, f32, f32, f32, f32, f32, f32, f32
  }
  func.return %token0_row0, %token0_row1, %token1_row0, %token1_row1, %token2_row0, %token2_row1, %token3_row0, %token3_row1 : f32, f32, f32, f32, f32, f32, f32, f32
}

kernel.def export("ggml_linear_q6k_f32_decode") @ggml_linear_q6k_f32_decode(%token_count: index, %input_size: index, %output_size: index) {
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 4)] : index
  %bounded_output_size = index.assume %output_size [range(%output_size, 1, 262144)] : index
  %subgroup_size = target.subgroup.size : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %padded_output_size = index.add %bounded_output_size, %c1 : index
  %output_tiles = index.div %padded_output_size, %c2 : index
  kernel.launch.config workgroups(%output_tiles, %bounded_token_count, %c1) workgroup_size(%subgroup_size, %c1, %c1) : index
} launch(%token_count: index, %input_size: index, %output_size: index, %input: buffer, %weight: buffer, %output: buffer) {
  %input_noalias, %weight_noalias, %output_noalias = buffer.assume.noalias %input, %weight, %output : buffer, buffer, buffer
  %output_capacity = config.get @ggml.linear_q6k_f32_decode.output_capacity : index
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 4)] : index
  %bounded_input_size = index.assume %input_size [range(%input_size, 256, 17408), mul(%input_size, 256)] : index
  %bounded_output_size = index.assume %output_size [range(%output_size, 1, 262144), le(%output_size, %output_capacity)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4_bytes = index.constant 4 : offset
  %c210_bytes = index.constant 210 : offset
  %c256 = index.constant 256 : index
  %row_tile = kernel.workgroup.id<x> : index
  %token0 = kernel.workgroup.id<y> : index
  %token = index.assume %token0 [lt(%token0, %bounded_token_count)] : index
  %lane = kernel.subgroup.lane.id : index
  %row0 = index.mul %row_tile, %c2 : index
  %row1 = index.add %row0, %c1 : index
  %valid_row0 = index.cmp ult, %row0, %bounded_output_size : index
  %valid_row1 = index.cmp ult, %row1, %bounded_output_size : index
  %safe_row0_raw = scf.select %valid_row0, %row0, %c0 : index
  %safe_row1_raw = scf.select %valid_row1, %row1, %c0 : index
  %safe_row0 = index.assume %safe_row0_raw [lt(%safe_row0_raw, %output_capacity)] : index
  %safe_row1 = index.assume %safe_row1_raw [lt(%safe_row1_raw, %output_capacity)] : index
  %block_count = index.div %bounded_input_size, %c256 : index
  %weight_row_bytes = index.scale %block_count, %c210_bytes : index, offset -> offset
  %weight_row0_byte_base = index.scale %safe_row0, %weight_row_bytes : index, offset -> offset
  %weight_row1_byte_base = index.scale %safe_row1, %weight_row_bytes : index, offset -> offset
  %input_row_bytes = index.scale %bounded_input_size, %c4_bytes : index, offset -> offset
  %input_row_byte_base = index.scale %token, %input_row_bytes : index, offset -> offset
  %lane_row0, %lane_row1 = scf.if %valid_row0 -> (f32, f32) {
    %value0, %value1 = func.call @ggml_q6k_f32_row_lane2(%bounded_input_size, %input_noalias, %input_row_byte_base, %weight_noalias, %weight_row0_byte_base, %weight_row1_byte_base, %lane) : (index, buffer, offset, buffer, offset, offset, index) -> (f32, f32)
    scf.yield %value0, %value1 : f32, f32
  } else {
    %c0_f32 = scalar.constant 0.0 : f32
    scf.yield %c0_f32, %c0_f32 : f32, f32
  }
  %dot0 = kernel.subgroup.reduce<addf> %lane_row0 : f32
  %dot1 = kernel.subgroup.reduce<addf> %lane_row1 : f32
  %is_lane_zero = index.cmp eq, %lane, %c0 : index
  scf.if %is_lane_zero {
    %c0_offset = index.constant 0 : offset
    %output_view = buffer.view %output_noalias[%c0_offset] : buffer -> view<[%bounded_token_count]x[%bounded_output_size]xf32>
    scf.if %valid_row0 {
      view.store %dot0, %output_view[%token, %row0] : f32, view<[%bounded_token_count]x[%bounded_output_size]xf32>
    }
    scf.if %valid_row1 {
      view.store %dot1, %output_view[%token, %row1] : f32, view<[%bounded_token_count]x[%bounded_output_size]xf32>
    }
  }
  kernel.return
}

// Four-row verifier schedule retaining the token-one F32 arithmetic while
// sharing immutable Q6_K decoding across all activation rows.
kernel.def export("ggml_linear_q6k_f32_decode_m4") @ggml_linear_q6k_f32_decode_m4(%token_count: index, %input_size: index, %output_size: index) {
  %bounded_token_count = index.assume %token_count [range(%token_count, 4, 4)] : index
  %bounded_output_size = index.assume %output_size [range(%output_size, 1, 262144)] : index
  %subgroup_size = target.subgroup.size : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %padded_output_size = index.add %bounded_output_size, %c1 : index
  %output_tiles = index.div %padded_output_size, %c2 : index
  kernel.launch.config workgroups(%output_tiles, %c1, %c1) workgroup_size(%subgroup_size, %c1, %c1) : index
} launch(%token_count: index, %input_size: index, %output_size: index, %input: buffer, %weight: buffer, %output: buffer) {
  %input_noalias, %weight_noalias, %output_noalias = buffer.assume.noalias %input, %weight, %output : buffer, buffer, buffer
  %output_capacity = config.get @ggml.linear_q6k_f32_decode.output_capacity : index
  %bounded_token_count = index.assume %token_count [range(%token_count, 4, 4)] : index
  %bounded_input_size = index.assume %input_size [range(%input_size, 256, 17408), mul(%input_size, 256)] : index
  %bounded_output_size = index.assume %output_size [range(%output_size, 1, 262144), le(%output_size, %output_capacity)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4_bytes = index.constant 4 : offset
  %c210_bytes = index.constant 210 : offset
  %c256 = index.constant 256 : index
  %row_tile = kernel.workgroup.id<x> : index
  %lane = kernel.subgroup.lane.id : index
  %row0 = index.mul %row_tile, %c2 : index
  %row1 = index.add %row0, %c1 : index
  %valid_row0 = index.cmp ult, %row0, %bounded_output_size : index
  %valid_row1 = index.cmp ult, %row1, %bounded_output_size : index
  %safe_row0_raw = scf.select %valid_row0, %row0, %c0 : index
  %safe_row1_raw = scf.select %valid_row1, %row1, %c0 : index
  %safe_row0 = index.assume %safe_row0_raw [lt(%safe_row0_raw, %output_capacity)] : index
  %safe_row1 = index.assume %safe_row1_raw [lt(%safe_row1_raw, %output_capacity)] : index
  %block_count = index.div %bounded_input_size, %c256 : index
  %weight_row_bytes = index.scale %block_count, %c210_bytes : index, offset -> offset
  %weight_row0_byte_base = index.scale %safe_row0, %weight_row_bytes : index, offset -> offset
  %weight_row1_byte_base = index.scale %safe_row1, %weight_row_bytes : index, offset -> offset
  %input_row_bytes = index.scale %bounded_input_size, %c4_bytes : index, offset -> offset
  %input_row0_byte_base = index.scale %c0, %input_row_bytes : index, offset -> offset
  %input_row1_byte_base = index.scale %c1, %input_row_bytes : index, offset -> offset
  %input_row2_byte_base = index.scale %c2, %input_row_bytes : index, offset -> offset
  %input_row3_byte_base = index.scale %c3, %input_row_bytes : index, offset -> offset
  %lane00, %lane01, %lane10, %lane11, %lane20, %lane21, %lane30, %lane31 = scf.if %valid_row0 -> (f32, f32, f32, f32, f32, f32, f32, f32) {
    %value00, %value01, %value10, %value11, %value20, %value21, %value30, %value31 = func.call @ggml_q6k_f32_row_lane2_m4(%bounded_input_size, %input_noalias, %input_row0_byte_base, %input_row1_byte_base, %input_row2_byte_base, %input_row3_byte_base, %weight_noalias, %weight_row0_byte_base, %weight_row1_byte_base, %lane) : (index, buffer, offset, offset, offset, offset, buffer, offset, offset, index) -> (f32, f32, f32, f32, f32, f32, f32, f32)
    scf.yield %value00, %value01, %value10, %value11, %value20, %value21, %value30, %value31 : f32, f32, f32, f32, f32, f32, f32, f32
  } else {
    %c0_f32 = scalar.constant 0.0 : f32
    scf.yield %c0_f32, %c0_f32, %c0_f32, %c0_f32, %c0_f32, %c0_f32, %c0_f32, %c0_f32 : f32, f32, f32, f32, f32, f32, f32, f32
  }
  %dot00 = kernel.subgroup.reduce<addf> %lane00 : f32
  %dot01 = kernel.subgroup.reduce<addf> %lane01 : f32
  %dot10 = kernel.subgroup.reduce<addf> %lane10 : f32
  %dot11 = kernel.subgroup.reduce<addf> %lane11 : f32
  %dot20 = kernel.subgroup.reduce<addf> %lane20 : f32
  %dot21 = kernel.subgroup.reduce<addf> %lane21 : f32
  %dot30 = kernel.subgroup.reduce<addf> %lane30 : f32
  %dot31 = kernel.subgroup.reduce<addf> %lane31 : f32
  %is_lane_zero = index.cmp eq, %lane, %c0 : index
  scf.if %is_lane_zero {
    %c0_offset = index.constant 0 : offset
    %output_row_bytes = index.scale %bounded_output_size, %c4_bytes : index, offset -> offset
    %output_row1_byte_base = index.scale %c1, %output_row_bytes : index, offset -> offset
    %output_row2_byte_base = index.scale %c2, %output_row_bytes : index, offset -> offset
    %output_row3_byte_base = index.scale %c3, %output_row_bytes : index, offset -> offset
    %output_row0 = buffer.view %output_noalias[%c0_offset] : buffer -> view<[%bounded_output_size]xf32>
    %output_row1 = buffer.view %output_noalias[%output_row1_byte_base] : buffer -> view<[%bounded_output_size]xf32>
    %output_row2 = buffer.view %output_noalias[%output_row2_byte_base] : buffer -> view<[%bounded_output_size]xf32>
    %output_row3 = buffer.view %output_noalias[%output_row3_byte_base] : buffer -> view<[%bounded_output_size]xf32>
    scf.if %valid_row0 {
      view.store %dot00, %output_row0[%row0] : f32, view<[%bounded_output_size]xf32>
      view.store %dot10, %output_row1[%row0] : f32, view<[%bounded_output_size]xf32>
      view.store %dot20, %output_row2[%row0] : f32, view<[%bounded_output_size]xf32>
      view.store %dot30, %output_row3[%row0] : f32, view<[%bounded_output_size]xf32>
    }
    scf.if %valid_row1 {
      view.store %dot01, %output_row0[%row1] : f32, view<[%bounded_output_size]xf32>
      view.store %dot11, %output_row1[%row1] : f32, view<[%bounded_output_size]xf32>
      view.store %dot21, %output_row2[%row1] : f32, view<[%bounded_output_size]xf32>
      view.store %dot31, %output_row3[%row1] : f32, view<[%bounded_output_size]xf32>
    }
  }
  kernel.return
}

// Uniform packed bytes exercise every Q6_K bit field, negative scales, the
// two-row reuse path, and an odd output tail.
check.case public @ggml_linear_q6k_f32_decode_nonzero_tail_case {
  %token_count = check.literal value(1) : index
  %input_size = check.literal value(2048) : index
  %output_size = check.literal value(9) : index
  %input = check.generate.fill value(0.00390625) : tensor<1x2048xf32>
  %weight = check.generate.fill value(-86) : tensor<9x8x210xi8>
  %output = check.generate.fill value(0.0) : tensor<1x9xf32>
  %expected = check.generate.fill value(358.1715087890625) : tensor<1x9xf32>
  kernel.launch @ggml_linear_q6k_f32_decode[%token_count, %input_size, %output_size](%token_count, %input_size, %output_size, %input, %weight, %output) : [index, index, index](index, index, index, tensor<1x2048xf32>, tensor<9x8x210xi8>, tensor<1x9xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.25) rtol(9.9999999999999995e-07) nan(same) : tensor<1x9xf32>
  check.return
}

// Four independent activation rows exercise the exact speculative-verifier
// shape while retaining the one-row kernel's accumulation and reduction order.
check.case public @ggml_linear_q6k_f32_decode_m4_nonzero_tail_case {
  %token_count = check.literal value(4) : index
  %input_size = check.literal value(2048) : index
  %output_size = check.literal value(9) : index
  %input = check.generate.fill value(0.00390625) : tensor<4x2048xf32>
  %weight = check.generate.fill value(-86) : tensor<9x8x210xi8>
  %expected = check.generate.fill value(0.0) : tensor<4x9xf32>
  %actual = check.generate.fill value(0.0) : tensor<4x9xf32>
  kernel.launch @ggml_linear_q6k_f32_decode[%token_count, %input_size, %output_size](%token_count, %input_size, %output_size, %input, %weight, %expected) : [index, index, index](index, index, index, tensor<4x2048xf32>, tensor<9x8x210xi8>, tensor<4x9xf32>)
  kernel.launch @ggml_linear_q6k_f32_decode_m4[%token_count, %input_size, %output_size](%token_count, %input_size, %output_size, %input, %weight, %actual) : [index, index, index](index, index, index, tensor<4x2048xf32>, tensor<9x8x210xi8>, tensor<4x9xf32>)
  check.expect.equal actual(%actual) expected(%expected) : tensor<4x9xf32>
  check.return
}

// Exact Qwen3.8 FFN down-projection decode shape.
check.case public @ggml_linear_q6k_f32_decode_ffn_down_benchmark_case {
  %token_count = check.literal value(1) : index
  %input_size = check.literal value(17408) : index
  %output_size = check.literal value(5120) : index
  %input = check.generate.fill value(0.00390625) : tensor<1x17408xf32>
  %weight = check.generate.fill value(0) : tensor<5120x68x210xi8>
  %output = check.generate.fill value(1.0) : tensor<1x5120xf32>
  %expected = check.generate.fill value(0.0) : tensor<1x5120xf32>
  kernel.launch @ggml_linear_q6k_f32_decode[%token_count, %input_size, %output_size](%token_count, %input_size, %output_size, %input, %weight, %output) : [index, index, index](index, index, index, tensor<1x17408xf32>, tensor<5120x68x210xi8>, tensor<1x5120xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<1x5120xf32>
  check.return
}

