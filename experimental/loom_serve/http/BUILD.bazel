load("@rules_python//python:defs.bzl", "py_library", "py_test")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],
)

py_library(
    name = "chat_client",
    srcs = ["chat.py"],
)

py_test(
    name = "chat_client_test",
    size = "small",
    srcs = ["chat_test.py"],
    main = "chat_test.py",
    deps = [":chat_client"],
)

py_library(
    name = "logs_client",
    srcs = ["logs.py"],
)

py_test(
    name = "logs_client_test",
    size = "small",
    srcs = ["logs_test.py"],
    main = "logs_test.py",
    deps = [":logs_client"],
)
