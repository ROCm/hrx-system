load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],
)

loom_cc_library(
    name = "timer",
    srcs = ["timer.c"],
    hdrs = ["timer.h"],
    deps = [
        ":server",
        "//runtime/src/iree/async",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
    ],
)

loom_cc_test(
    name = "timer_test",
    srcs = ["timer_test.cc"],
    deps = [
        ":timer",
        "//runtime/src/iree/async",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "request",
    srcs = ["request.c"],
    hdrs = ["request.h"],
    deps = ["//runtime/src/iree/base"],
)

loom_cc_test(
    name = "request_test",
    srcs = ["request_test.cc"],
    deps = [
        ":request",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "tokenization",
    srcs = ["tokenization.c"],
    hdrs = ["tokenization.h"],
    deps = [
        "//loom/src/loom/util:json",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:json",
        "//runtime/src/iree/base/internal:unicode",
        "//runtime/src/iree/tokenizer",
        "//runtime/src/iree/tokenizer/vocab",
    ],
)

py_library(
    name = "logs_client",
    srcs = ["logs.py"],
)

py_test(
    name = "logs_client_test",
    size = "small",
    srcs = ["logs_test.py"],
    main = "logs_test.py",
    deps = [":logs_client"],
)

loom_cc_library(
    name = "logs",
    srcs = ["logs.c"],
    hdrs = ["logs.h"],
    deps = [
        "//experimental/loom_serve/telemetry:stream",
        "//loom/src/loom/util:json",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "router",
    srcs = ["router.c"],
    hdrs = ["router.h"],
    deps = [
        ":logs",
        ":request",
        ":server",
        ":tokenization",
        "//experimental/loom_serve/telemetry:stream",
        "//loom/src/loom/util:json",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:json",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/task",
        "//runtime/src/iree/tokenizer",
    ],
)

loom_cc_test(
    name = "logs_test",
    srcs = ["logs_test.cc"],
    deps = [
        ":logs",
        "//experimental/loom_serve/telemetry:stream",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_test(
    name = "tokenization_test",
    srcs = ["tokenization_test.cc"],
    deps = [
        ":tokenization",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
        "//runtime/src/iree/tokenizer",
        "//runtime/src/iree/tokenizer/format/huggingface:tokenizer_json",
    ],
)

loom_cc_library(
    name = "server",
    srcs = ["server.c"],
    hdrs = ["server.h"],
    deps = [
        ":request",
        "//experimental/loom_serve/telemetry:stream",
        "//runtime/src/iree/async",
        "//runtime/src/iree/async:platform",
        "//runtime/src/iree/async/util:proactor_thread",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/net:carrier",
        "//runtime/src/iree/net/carrier/stream",
    ],
)

loom_cc_test(
    name = "router_test",
    srcs = ["router_test.cc"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":request",
        ":router",
        ":server",
        "//runtime/src/iree/async",
        "//runtime/src/iree/base",
        "//runtime/src/iree/task",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
        "//runtime/src/iree/tokenizer",
        "//runtime/src/iree/tokenizer/format/huggingface:tokenizer_json",
    ],
)

loom_cc_test(
    name = "server_test",
    srcs = ["server_test.cc"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":request",
        ":server",
        "//experimental/loom_serve/telemetry:stream",
        "//runtime/src/iree/async",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
