func.decl import("runner") @advance(%storage: hal.buffer) -> (i64)
func.def public @step(%storage: hal.buffer) -> (i64) {
  %completion = func.call @advance(%storage) : (hal.buffer) -> (i64)
  func.return %completion : i64
}
