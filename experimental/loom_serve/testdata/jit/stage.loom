command.program.def public @advance() launch(%storage: buffer) {
  kernel.launch @increment_0(%storage) : (buffer)
  kernel.launch @increment_1(%storage) : (buffer)
  kernel.launch @increment_2(%storage) : (buffer)
  kernel.launch @increment_3(%storage) : (buffer)
  kernel.launch @increment_4(%storage) : (buffer)
  kernel.launch @increment_5(%storage) : (buffer)
  kernel.launch @increment_6(%storage) : (buffer)
  kernel.launch @increment_7(%storage) : (buffer)
  command.return
}

// A CPU import cannot be resolved by native GPU compilation. Keeping this in a
// separate root exercises failure after the command product publishes its work.
func.decl import("host") @host_only(%value: i32) -> (i32)
kernel.def target(@wave32) @requires_host() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%storage: buffer) {
  %c0 = index.constant 0 : offset
  %data = buffer.view %storage[%c0] : buffer -> view<8xi32>
  %value = view.load %data[0] : view<8xi32> -> i32
  %result = func.call @host_only(%value) : (i32) -> (i32)
  view.store %result, %data[0] : i32, view<8xi32>
  kernel.return
}

command.program.def public @invalid_native() launch(%storage: buffer) {
  kernel.launch @increment_0(%storage) : (buffer)
  kernel.launch @increment_1(%storage) : (buffer)
  kernel.launch @increment_2(%storage) : (buffer)
  kernel.launch @increment_3(%storage) : (buffer)
  kernel.launch @increment_4(%storage) : (buffer)
  kernel.launch @increment_5(%storage) : (buffer)
  kernel.launch @increment_6(%storage) : (buffer)
  kernel.launch @increment_7(%storage) : (buffer)
  kernel.launch @requires_host(%storage) : (buffer)
  command.return
}

command.program.def public @idle() launch() {
  command.return
}

command.program.def public @ambiguous() launch() {
  command.return
}
