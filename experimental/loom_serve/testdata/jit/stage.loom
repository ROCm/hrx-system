config.decl @increment.delta : %value: index where [range(%value, 1, 8)]

amdgpu.target<gfx11-generic> @wave32 {subgroup_size = 32}

func.def @increment_element(%element: index, %delta: index, %storage: buffer) {
  %c0_offset = index.constant 0 : offset
  %data = buffer.view %storage[%c0_offset] : buffer -> view<8xi32>
  %value = view.load %data[%element] : view<8xi32> -> i32
  %delta_i32 = index.cast %delta : index to i32
  %element_i32 = index.cast %element : index to i32
  %increment = scalar.addi %delta_i32, %element_i32 : i32
  %next = scalar.addi %value, %increment : i32
  view.store %next, %data[%element] : i32, view<8xi32>
  func.return
}

kernel.def target(@wave32) @increment_0() {
  %width = target.subgroup.size : index
  %c32 = index.constant 32 : index
  %groups = index.div %width, %c32 : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%storage: buffer) {
  %element = index.constant 0 : index
  %delta = config.get @increment.delta : index
  func.call @increment_element(%element, %delta, %storage) : (index, index, buffer)
  kernel.return
}

kernel.def target(@wave32) @increment_1() {
  %width = target.subgroup.size : index
  %c32 = index.constant 32 : index
  %groups = index.div %width, %c32 : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
