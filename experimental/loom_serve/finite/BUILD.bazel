load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_config_compatible_with")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],
)

loom_cc_library(
    name = "protocol",
    hdrs = ["protocol.h"],
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/vm",
    ],
)

loom_cc_library(
    name = "service",
    srcs = ["service.c"],
    hdrs = ["service.h"],
    deps = [
        ":model",
        ":protocol",
        "//experimental/loom_serve/http:request",
        "//experimental/loom_serve/http:server",
        "//experimental/loom_serve/http:service",
        "//experimental/loom_serve/http:timer",
        "//experimental/loom_serve/runtime:execution",
        "//experimental/loom_serve/runtime:host",
        "//experimental/loom_serve/runtime:residency",
        "//experimental/loom_serve/telemetry:stream",
        "//loom/src/loom/util:json",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/async",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/task",
        "//runtime/src/iree/vm",
    ],
)

loom_cc_library(
    name = "model",
    srcs = ["model.c"],
    hdrs = ["model.h"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:vm",
    ]),
    deps = [
        "//experimental/loom_serve/runtime:compilation",
        "//experimental/loom_serve/runtime:device",
        "//experimental/loom_serve/runtime:dispatch",
        "//experimental/loom_serve/runtime:execution",
        "//experimental/loom_serve/runtime:host",
        "//experimental/loom_serve/runtime:input",
        "//experimental/loom_serve/runtime:jit",
        "//experimental/loom_serve/runtime:json",
        "//experimental/loom_serve/runtime:module",
        "//experimental/loom_serve/runtime:preparation",
        "//experimental/loom_serve/runtime:program",
        "//experimental/loom_serve/runtime:residency",
        "//experimental/loom_serve/runtime:weights",
        "//loom/binding/c:loomc",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:path",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/io:file_handle",
        "//runtime/src/iree/module/hal:types",
        "//runtime/src/iree/tokenizer",
        "//runtime/src/iree/tokenizer/format/huggingface:tokenizer_json",
        "//runtime/src/iree/tooling:device_util",
        "//runtime/src/iree/vm",
    ],
)
