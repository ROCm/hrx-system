load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_binary", "loom_cc_library", "loom_config_compatible_with")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],
)

loom_cc_library(
    name = "flags",
    srcs = ["flags.c"],
    hdrs = ["flags.h"],
    deps = [
        "//loom/binding/c:loomc",
        "//loom/src/loom/serve/server:configuration",
        "//loom/src/loom/serve/service/text:model",
        "//loom/src/loom/serve/service/text:schedule",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/tooling:flags",
    ],
)

loom_cc_binary(
    name = "server",
    srcs = ["server.c"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:vm",
    ]),
    deps = [
        ":flags",
        "//loom/src/loom/serve/server:registry",
        "//loom/src/loom/serve/server:router",
        "//loom/src/loom/serve/service/text:model",
        "//loom/src/loom/serve/service/text:service",
        "//loom/src/loom/serve/transport/http:listener",
        "//loom/src/loom/serve/transport/http:server",
        "//loom/src/loom/tools/loom-serve:options",
        "//loom/src/loom/tools/loom-serve:signals",
        "//runtime/src/iree/async",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/tooling:flags",
    ],
)

loom_cc_binary(
    name = "generate",
    srcs = ["generate.c"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:vm",
    ]),
    deps = [
        ":flags",
        "//loom/src/loom/serve/service/text:chat",
        "//loom/src/loom/serve/service/text:model",
        "//loom/src/loom/tools/loom-serve:options",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/tooling:flags",
        "//runtime/src/iree/io:file_handle",
        "//runtime/src/iree/tokenizer",
    ],
)

loom_cc_binary(
    name = "epoch_check",
    testonly = True,
    srcs = ["epoch_check.cc"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:vm",
    ]),
    deps = [
        ":flags",
        "//loom/src/loom/serve/runtime/host",
        "//loom/src/loom/serve/service/text:chat",
        "//loom/src/loom/serve/service/text:model",
        "//loom/src/loom/tools/loom-serve:options",
        "//runtime/src/iree/async",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/tooling:flags",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/task",
    ],
)

loom_cc_binary(
    name = "request_check",
    testonly = True,
    srcs = ["request_check.c"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:vm",
    ]),
    deps = [
        "//loom/src/loom/serve/runtime/program",
        "//loom/src/loom/serve/runtime/program:compilation",
        "//loom/src/loom/serve/runtime/program:input",
        "//loom/src/loom/serve/runtime/program:json",
        "//loom/src/loom/serve/service/text:chat",
        "//loom/src/loom/util:json",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/tooling:flags",
        "//runtime/src/iree/io:file_handle",
        "//runtime/src/iree/tokenizer",
        "//runtime/src/iree/tokenizer/format/huggingface:tokenizer_json",
        "//runtime/src/iree/vm",
    ],
)
