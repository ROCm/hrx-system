// Temporary, non-sanctioned one-function fork for Qwen bring-up. This is not a
// second kernel authoring path. Delete it when conditional facts carry the
// existing channel bound into the guarded output store and AMDGPU address
// planning can represent the canonical shape contract. It repeats those
// invariants, clamps the masked weight address, and narrows generic maxima to
// Qwen's fixed hidden and vocabulary dimensions.
func.decl @ggml_q6k_q8_1_x4_row_lane(%input_size: index, %weight: buffer, %weight_row_byte_base: offset, %q8_input: buffer, %q8_row_byte_base: offset, %lane: index) -> (f32)

kernel.def @ggml_linear_q6k_q8_1_x4(%token_count: index, %input_size: index, %output_size: index) {
  %eight = index.constant 8 : index
  %seven = index.constant 7 : index
  %one = index.constant 1 : index
  %workgroup_size = index.constant 256 : index
  %padded_output_size = index.add %output_size, %seven : index
  %output_tiles = index.div %padded_output_size, %eight : index
  kernel.launch.config workgroups(%output_tiles, %token_count, %one) workgroup_size(%workgroup_size, %one, %one) : index
} launch(%token_count: index, %input_size: index, %output_size: index, %q8_input: buffer, %weight: buffer, %output: buffer) {
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 2048)] : index
  %bounded_input_size = index.assume %input_size [range(%input_size, 256, 2048), mul(%input_size, 256)] : index
  %bounded_output_size = index.assume %output_size [range(%output_size, 1, 151936)] : index
  %channel_tile = kernel.workgroup.id<x> : index
  %token0 = kernel.workgroup.id<y> : index
  %subgroup0 = kernel.subgroup.id : index
  %lane = kernel.subgroup.lane.id : index
  %zero = index.constant 0 : index
  %eight = index.constant 8 : index
  %onetwentyeight = index.constant 128 : index
  %twohundredten = index.constant 210 : index
  %twofiftysix = index.constant 256 : index
  %onehundredfortyfour = index.constant 144 : index
  %zero_i32 = scalar.constant 0 : i32
  %zero_offset = index.constant 0 : offset
  %token, %launch_token_count = index.assume %token0, %bounded_token_count [lt(%token0, %bounded_token_count)] : index, index
  %subgroup = index.assume %subgroup0 [range(%subgroup0, 0, 7)] : index
  %channel_base = index.mul %channel_tile, %eight : index
  %channel = index.add %channel_base, %subgroup : index
  %valid_channel = index.cmp ult, %channel, %bounded_output_size : index
  %safe_channel0 = scf.select %valid_channel, %channel, %zero : index
  %safe_channel, %weight_output_bound = index.assume %safe_channel0, %bounded_output_size [range(%safe_channel0, 0, 151935), lt(%safe_channel0, %bounded_output_size)] : index, index
  %q6_block_count = index.div %bounded_input_size, %twofiftysix : index
  %weight_row_byte_count = index.mul %q6_block_count, %twohundredten : index
  %weight_row_byte_index = index.mul %safe_channel, %weight_row_byte_count : index
  %weight_row_byte_base = index.cast %weight_row_byte_index : index to offset
  %q8_group_count = index.div %bounded_input_size, %onetwentyeight : index
  %q8_row_byte_count = index.mul %q8_group_count, %onehundredfortyfour : index
  %q8_row_byte_index = index.mul %token, %q8_row_byte_count : index
  %q8_row_byte_base = index.cast %q8_row_byte_index : index to offset
  %q8_noalias, %weight_noalias, %output_noalias = buffer.assume.noalias %q8_input, %weight, %output : buffer, buffer, buffer
  %lane_acc = scf.if %valid_channel -> (f32) {
    %value = func.call @ggml_q6k_q8_1_x4_row_lane(%bounded_input_size, %weight_noalias, %weight_row_byte_base, %q8_noalias, %q8_row_byte_base, %lane) : (index, buffer, offset, buffer, offset, index) -> (f32)
    scf.yield %value : f32
  } else {
    %zero_f32 = scalar.constant 0.0 : f32
    scf.yield %zero_f32 : f32
  }
  %dot = kernel.subgroup.reduce<addf> %lane_acc : f32
  %lane_i32 = index.cast %lane : index to i32
  %is_lane_zero = scalar.cmpi eq, %lane_i32, %zero_i32 : i32
  %writes_output = scalar.andi %valid_channel, %is_lane_zero : i1
  scf.if %writes_output {
    %bounded_channel, %output_bound = index.assume %channel, %weight_output_bound [lt(%channel, %weight_output_bound)] : index, index
    %output_element_count = index.mul %launch_token_count, %output_bound : index
    %token_output_base = index.mul %token, %output_bound : index
    %output_index0 = index.add %token_output_base, %bounded_channel : index
    %output_index, %output_element_bound = index.assume %output_index0, %output_element_count [lt(%output_index0, %output_element_count)] : index, index
    %output_view = buffer.view %output_noalias[%zero_offset] : buffer -> view<[%output_element_bound]xf32, #dense>
    view.store %dot, %output_view[%output_index] : f32, view<[%output_element_bound]xf32, #dense>
  }
  kernel.return
}

check.case public @ggml_linear_q6k_q8_1_x4_bringup_workaround_tail_case {
  %token_count = check.literal value(2) : index
  %input_size = check.literal value(2048) : index
  %output_size = check.literal value(9) : index
  %q8_input = check.generate.fill value(0) : tensor<2x2304xi8>
  %weight = check.generate.fill value(-86) : tensor<9x8x210xi8>
  %output = check.generate.fill value(1.0) : tensor<2x9xf32>
  %expected = check.generate.fill value(0.0) : tensor<2x9xf32>
  func.call @ggml_linear_q6k_q8_1_x4(%token_count, %input_size, %output_size, %q8_input, %weight, %output) : (index, index, index, tensor<2x2304xi8>, tensor<9x8x210xi8>, tensor<2x9xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<2x9xf32>
  check.return
}

check.benchmark<@ggml_linear_q6k_q8_1_x4_bringup_workaround_tail_case> @ggml_linear_q6k_q8_1_x4_bringup_workaround_small

check.case public @ggml_linear_q6k_q8_1_x4_bringup_workaround_vocabulary_plan_case {
  %token_count = check.literal value(1) : index
  %input_size = check.literal value(2048) : index
  %output_size = check.literal value(151936) : index
  %q8_input = check.generate.fill value(0) : tensor<1x2304xi8>
  %weight = check.generate.fill value(0) : tensor<151936x8x210xi8>
  %output = check.generate.fill value(0.0) : tensor<1x151936xf32>
  func.call @ggml_linear_q6k_q8_1_x4(%token_count, %input_size, %output_size, %q8_input, %weight, %output) : (index, index, index, tensor<1x2304xi8>, tensor<151936x8x210xi8>, tensor<1x151936xf32>)
  check.return
}

check.benchmark<@ggml_linear_q6k_q8_1_x4_bringup_workaround_vocabulary_plan_case> @ggml_linear_q6k_q8_1_x4_bringup_workaround_vocabulary_plan
