// Temporary, non-sanctioned one-function fork for Qwen decode bring-up. This
// is not a second kernel authoring path. Delete it when exact model facts reach
// scalar footprint analysis and nested device-template requirements propagate
// to their eventual kernel caller. The contraction and physical-group pack
// delegate to canonical bodies; only the completion epilogue is repeated.
config.decl @qwen3_moe.routed_gate_up.input_size : %value: index where [range(%value, 2048, 2048), mul(%value, 512)]

kernel.def @qwen3_moe_routed_gate_up_swiglu_q4k_q8_1_x4_next_q8(%token_count: index, %route_count: index, %route_stride: index, %expert_count: index, %output_size: index) {
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 1)] : index
  %bounded_route_count = index.assume %route_count [range(%route_count, 8, 8)] : index
  %bounded_output_size = index.assume %output_size [range(%output_size, 768, 768), mul(%output_size, 128)] : index
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 32 : index
  kernel.launch.config workgroups(%bounded_output_size, %bounded_route_count, %bounded_token_count) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%token_count: index, %route_count: index, %route_stride: index, %expert_count: index, %output_size: index, %q8_input: buffer, %route_ids: buffer, %gate_weight: buffer, %up_weight: buffer, %output: buffer, %completion_counters: buffer, %next_q8_output: buffer) {
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 1)] : index
  %bounded_route_count = index.assume %route_count [range(%route_count, 8, 8)] : index
  %bounded_route_stride = index.assume %route_stride [range(%route_stride, 8, 8)] : index
  %bounded_expert_count = index.assume %expert_count [range(%expert_count, 128, 128)] : index
  %bounded_output_size = index.assume %output_size [range(%output_size, 768, 768), mul(%output_size, 128)] : index
  %q8_input_noalias, %route_ids_noalias, %gate_weight_noalias, %up_weight_noalias, %output_noalias, %completion_counters_noalias, %next_q8_output_noalias = buffer.assume.noalias %q8_input, %route_ids, %gate_weight, %up_weight, %output, %completion_counters, %next_q8_output : buffer, buffer, buffer, buffer, buffer, buffer, buffer
  func.apply<qwen3_moe.routed_gate_up.q4k_q8.body>(%bounded_token_count, %bounded_route_count, %bounded_route_stride, %bounded_expert_count, %bounded_output_size, %q8_input_noalias, %route_ids_noalias, %gate_weight_noalias, %up_weight_noalias, %output_noalias) : (index, index, index, index, index, buffer, buffer, buffer, buffer, buffer)

  %channel = kernel.workgroup.id<x> : index
  %route = kernel.workgroup.id<y> : index
  %token = kernel.workgroup.id<z> : index
  %lane = kernel.workitem.id<x> : index
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %onetwentyeight = index.constant 128 : index
  %zero_i32 = scalar.constant 0 : i32
  %one_i32 = scalar.constant 1 : i32
  %zero_offset = index.constant 0 : offset
  %physical_group_count = index.div %bounded_output_size, %onetwentyeight : index
  %row_count = index.mul %bounded_token_count, %bounded_route_count : index
  %completion_counter_count = index.mul %row_count, %physical_group_count : index
  %token_row_base = index.mul %token, %bounded_route_count : index
  %row = index.add %token_row_base, %route : index
  %row_group_base = index.mul %row, %physical_group_count : index
  %group_in_row = index.div %channel, %onetwentyeight : index
  %counter_index0 = index.add %row_group_base, %group_in_row : index
  %counter_index, %bounded_completion_counter_count = index.assume %counter_index0, %completion_counter_count [lt(%counter_index0, %completion_counter_count)] : index, index
  %completion_counters_global = buffer.assume.memory_space<global> %completion_counters_noalias : buffer
  %completion_counters_aligned = buffer.assume.alignment %completion_counters_global {minimum_alignment = 16} : buffer
  %completion_counters_view = buffer.view %completion_counters_aligned[%zero_offset] : buffer -> view<[%bounded_completion_counter_count]xi32, #dense>
  %is_arrival_lane = index.cmp eq, %lane, %zero : index
  kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
  %local_old_counter = scf.if %is_arrival_lane -> (i32) {
    %old_counter = view.atomic.rmw<addi> %one_i32, %completion_counters_view[%counter_index] {ordering = acq_rel, scope = device} : i32, view<[%bounded_completion_counter_count]xi32, #dense> -> i32
    scf.yield %old_counter : i32
  } else {
    scf.yield %zero_i32 : i32
  }
  %old_counter = kernel.workgroup.reduce<addi> %local_old_counter : i32
  %group_size_i32 = index.cast %onetwentyeight : index to i32
  %last_arrival_i32 = scalar.subi %group_size_i32, %one_i32 : i32
  %negative_group_size_i32 = scalar.subi %zero_i32, %group_size_i32 : i32
  // Temporary, non-sanctioned lowering workaround: AMDGPU scalar.cmpi cannot
  // consume the divergent reduction result. Both values are in [0, 127], so
  // their F32 representations and equality comparison remain exact.
  %old_counter_f32 = scalar.sitofp %old_counter : i32 to f32
  %last_arrival_f32 = scalar.sitofp %last_arrival_i32 : i32 to f32
  %is_last_arrival = scalar.cmpf oeq, %old_counter_f32, %last_arrival_f32 : f32
  scf.if %is_last_arrival {
    func.apply<ggml.quantize_q8_1_x4.group_body>(%row_count, %bounded_output_size, %counter_index, %output_noalias, %next_q8_output_noalias) : (index, index, index, buffer, buffer)
    kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
    scf.if %is_arrival_lane {
      view.atomic.reduce<addi> %negative_group_size_i32, %completion_counters_view[%counter_index] {ordering = release, scope = device} : i32, view<[%bounded_completion_counter_count]xi32, #dense>
    }
  }
  kernel.return
}
