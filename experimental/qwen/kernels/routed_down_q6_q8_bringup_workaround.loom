// Temporary, non-sanctioned one-function fork for Qwen decode bring-up. This
// is not a second kernel authoring path. Delete it when exact workload values
// reach source-to-low and make the canonical route loop's unroll trip count
// visible. The function retains the canonical ABI and body while making only
// this model's one-token dimensions structural.
func.decl @ggml_q6k_q8_1_x4_row_lane(%input_size: index, %weight: buffer, %weight_row_byte_base: offset, %q8_input: buffer, %q8_row_byte_base: offset, %lane: index) -> (f32)

kernel.def @qwen3_moe_routed_down_q6k_q8_1_x4(%token_count: index, %input_size: index, %route_count: index, %route_id_stride: index, %expert_count: index, %output_size: index) {
  %eight = index.constant 8 : index
  %seven = index.constant 7 : index
  %one = index.constant 1 : index
  %workgroup_size = index.constant 256 : index
  %padded_output_size = index.add %output_size, %seven : index
  %output_tiles = index.div %padded_output_size, %eight : index
  kernel.launch.config workgroups(%output_tiles, %token_count, %one) workgroup_size(%workgroup_size, %one, %one) : index
} launch(%token_count: index, %input_size: index, %route_count: index, %route_id_stride: index, %expert_count: index, %output_size: index, %q8_input: buffer, %route_ids: buffer, %route_weights: buffer, %weight: buffer, %output: buffer) {
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 1)] : index
  %bounded_input_size = index.assume %input_size [range(%input_size, 768, 768), mul(%input_size, 256)] : index
  %bounded_route_count = index.assume %route_count [range(%route_count, 8, 8)] : index
  %bounded_route_id_stride = index.assume %route_id_stride [range(%route_id_stride, 8, 8)] : index
  %bounded_expert_count = index.assume %expert_count [range(%expert_count, 128, 128)] : index
  %bounded_output_size = index.assume %output_size [range(%output_size, 2048, 2048)] : index
  %channel_tile = kernel.workgroup.id<x> : index
  %token0 = kernel.workgroup.id<y> : index
  %subgroup0 = kernel.subgroup.id : index
  %lane = kernel.subgroup.lane.id : index
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %eight = index.constant 8 : index
  %onetwentyeight = index.constant 128 : index
  %onehundredfortyfour = index.constant 144 : index
  %twohundredten = index.constant 210 : index
  %twofiftysix = index.constant 256 : index
  %zero_i32 = scalar.constant 0 : i32
  %zero_f32 = scalar.constant 0.0 : f32
  %zero_offset = index.constant 0 : offset
  %token, %launch_token_count = index.assume %token0, %bounded_token_count [lt(%token0, %bounded_token_count)] : index, index
  %subgroup = index.assume %subgroup0 [range(%subgroup0, 0, 7)] : index
  %channel_base = index.mul %channel_tile, %eight : index
  %channel = index.add %channel_base, %subgroup : index
  %valid_channel = index.cmp ult, %channel, %bounded_output_size : index
  %lane_i32 = index.cast %lane : index to i32
  %is_lane_zero = scalar.cmpi eq, %lane_i32, %zero_i32 : i32
  %route_id_element_count = index.mul %bounded_token_count, %bounded_route_id_stride : index
  %route_weight_element_count = index.mul %bounded_token_count, %bounded_route_count : index
  %output_element_count = index.mul %launch_token_count, %bounded_output_size : index
  %q6_block_count = index.div %bounded_input_size, %twofiftysix : index
  %weight_row_byte_count = index.mul %q6_block_count, %twohundredten : index
  %q8_group_count = index.div %bounded_input_size, %onetwentyeight : index
  %q8_row_byte_count = index.mul %q8_group_count, %onehundredfortyfour : index
  %q8_noalias, %route_id_noalias, %route_weight_noalias, %weight_noalias, %output_noalias = buffer.assume.noalias %q8_input, %route_ids, %route_weights, %weight, %output : buffer, buffer, buffer, buffer, buffer
  %route_id_view = buffer.view %route_id_noalias[%zero_offset] : buffer -> view<[%route_id_element_count]xi32, #dense>
  %route_weight_view = buffer.view %route_weight_noalias[%zero_offset] : buffer -> view<[%route_weight_element_count]xf32, #dense>
  %output_view = buffer.view %output_noalias[%zero_offset] : buffer -> view<[%output_element_count]xf32, #dense>
  %lane_has_route = index.cmp ult, %lane, %bounded_route_count : index
  %lane_within_route_stride = index.cmp ult, %lane, %bounded_route_id_stride : index
  %loads_route_metadata = scalar.andi %lane_has_route, %lane_within_route_stride : i1
  %lane_expert_i32, %lane_route_weight = scf.if %loads_route_metadata -> (i32, f32) {
    %route_lane0, %metadata_route_count = index.assume %lane, %bounded_route_count [lt(%lane, %bounded_route_count)] : index, index
    %route_lane, %metadata_route_id_stride = index.assume %route_lane0, %bounded_route_id_stride [lt(%route_lane0, %bounded_route_id_stride)] : index, index
    %route_id_row_base = index.mul %token, %metadata_route_id_stride : index
    %route_id_index = index.add %route_id_row_base, %route_lane : index
    %route_weight_row_base = index.mul %token, %metadata_route_count : index
    %route_weight_index = index.add %route_weight_row_base, %route_lane : index
    %expert_i32 = view.load %route_id_view[%route_id_index] : view<[%route_id_element_count]xi32, #dense> -> i32
    %route_weight = view.load %route_weight_view[%route_weight_index] : view<[%route_weight_element_count]xf32, #dense> -> f32
    scf.yield %expert_i32, %route_weight : i32, f32
  } else {
    scf.yield %zero_i32, %zero_f32 : i32, f32
  }
  %routed_lane_sum = scf.if %valid_channel -> (f32) {
    %sum = scf.for %route = [%zero to %bounded_route_count step %one](%route_acc = %zero_f32 : f32) -> (f32) unroll {
      %route_i32 = index.cast %route : index to i32
      %expert_i32 = kernel.subgroup.broadcast %lane_expert_i32 from %route_i32 : i32, i32
      %expert0 = index.cast %expert_i32 : i32 to index
      %expert1 = index.assume %expert0 [range(%expert0, 0, 511)] : index
      %expert, %weight_expert_count = index.assume %expert1, %bounded_expert_count [lt(%expert1, %bounded_expert_count)] : index, index
      %expert_output_base = index.mul %expert, %bounded_output_size : index
      %expert_channel = index.add %expert_output_base, %channel : index
      %weight_row_byte_index = index.mul %expert_channel, %weight_row_byte_count : index
      %weight_row_byte_base = index.cast %weight_row_byte_index : index to offset
      %q8_row_base0 = index.mul %token, %bounded_route_count : index
      %q8_row = index.add %q8_row_base0, %route : index
      %q8_row_byte_index = index.mul %q8_row, %q8_row_byte_count : index
      %q8_row_byte_base = index.cast %q8_row_byte_index : index to offset
      %lane_acc = func.call @ggml_q6k_q8_1_x4_row_lane(%bounded_input_size, %weight_noalias, %weight_row_byte_base, %q8_noalias, %q8_row_byte_base, %lane) : (index, buffer, offset, buffer, offset, index) -> (f32)
      %route_weight = kernel.subgroup.broadcast %lane_route_weight from %route_i32 : f32, i32
      %weighted_lane = scalar.mulf<reassoc|nnan|ninf|nsz> %lane_acc, %route_weight : f32
      %next = scalar.addf<reassoc|nnan|ninf|nsz> %route_acc, %weighted_lane : f32
      scf.yield %next : f32
    }
    scf.yield %sum : f32
  } else {
    scf.yield %zero_f32 : f32
  }
  %routed_sum = kernel.subgroup.reduce<addf> %routed_lane_sum : f32
  %writes_output = scalar.andi %valid_channel, %is_lane_zero : i1
  scf.if %writes_output {
    %token_output_base = index.mul %token, %bounded_output_size : index
    %output_index = index.add %token_output_base, %channel : index
    %residual = view.load %output_view[%output_index] : view<[%output_element_count]xf32, #dense> -> f32
    %result = scalar.addf %residual, %routed_sum : f32
    view.store %result, %output_view[%output_index] : f32, view<[%output_element_count]xf32, #dense>
  }
  kernel.return
}
