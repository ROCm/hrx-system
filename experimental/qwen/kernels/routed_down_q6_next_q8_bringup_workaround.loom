// Temporary, non-sanctioned one-function specialization for Qwen decode
// bring-up. This is not a second kernel authoring path. Delete it when exact
// workload values reach source-to-low and make the canonical route loop's
// unroll trip count visible. The specialization delegates contraction and
// residual arithmetic to the canonical body while making only this model's
// one-token dimensions structural.
kernel.def @qwen3_moe_routed_down_q6k_q8_1_x4_next_q8(%token_count: index, %input_size: index, %route_count: index, %route_id_stride: index, %expert_count: index, %output_size: index) {
  %eight = index.constant 8 : index
  %seven = index.constant 7 : index
  %one = index.constant 1 : index
  %workgroup_size = index.constant 256 : index
  %padded_output_size = index.add %output_size, %seven : index
  %output_tiles = index.div %padded_output_size, %eight : index
  kernel.launch.config workgroups(%output_tiles, %token_count, %one) workgroup_size(%workgroup_size, %one, %one) : index
} launch(%token_count: index, %input_size: index, %route_count: index, %route_id_stride: index, %expert_count: index, %output_size: index, %q8_input: buffer, %route_ids: buffer, %route_weights: buffer, %weight: buffer, %output: buffer, %norm_weight: buffer, %completion_counter: buffer, %next_q8_output: buffer) {
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 1)] : index
  %bounded_input_size = index.assume %input_size [range(%input_size, 768, 768), mul(%input_size, 256)] : index
  %bounded_route_count = index.assume %route_count [range(%route_count, 8, 8)] : index
  %bounded_route_id_stride = index.assume %route_id_stride [range(%route_id_stride, 8, 8)] : index
  %bounded_expert_count = index.assume %expert_count [range(%expert_count, 128, 128)] : index
  %bounded_output_size = index.assume %output_size [range(%output_size, 2048, 2048), mul(%output_size, 128)] : index
  func.apply<qwen3_moe.routed_down.q6k_q8_1_x4.body>(%bounded_token_count, %bounded_input_size, %bounded_route_count, %bounded_route_id_stride, %bounded_expert_count, %bounded_output_size, %q8_input, %route_ids, %route_weights, %weight, %output) : (index, index, index, index, index, index, buffer, buffer, buffer, buffer, buffer)

  %token0 = kernel.workgroup.id<y> : index
  %token = index.assume %token0 [lt(%token0, %bounded_token_count)] : index
  %zero = index.constant 0 : index
  %eight = index.constant 8 : index
  %workitem = kernel.workitem.id<x> : index
  %output_tile_count = index.div %bounded_output_size, %eight : index
  %is_arrival_workitem = index.cmp eq, %workitem, %zero : index
  %zero_i32 = scalar.constant 0 : i32
  %one_i32 = scalar.constant 1 : i32
  %zero_offset = index.constant 0 : offset
  %output_noalias, %norm_weight_noalias, %completion_counter_noalias, %next_q8_output_noalias = buffer.assume.noalias %output, %norm_weight, %completion_counter, %next_q8_output : buffer, buffer, buffer, buffer
  %completion_counter_global = buffer.assume.memory_space<global> %completion_counter_noalias : buffer
  %completion_counter_aligned = buffer.assume.alignment %completion_counter_global {minimum_alignment = 16} : buffer
  %completion_counter_view = buffer.view %completion_counter_aligned[%zero_offset] : buffer -> view<1xi32, #dense>
  kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
  %local_old_counter = scf.if %is_arrival_workitem -> (i32) {
    %old_counter = view.atomic.rmw<addi> %one_i32, %completion_counter_view[%zero] {ordering = acq_rel, scope = device} : i32, view<1xi32, #dense> -> i32
    scf.yield %old_counter : i32
  } else {
    scf.yield %zero_i32 : i32
  }
  %old_counter = kernel.workgroup.reduce<addi> %local_old_counter : i32
  %output_tile_count_i32 = index.cast %output_tile_count : index to i32
  %last_output_tile_i32 = scalar.subi %output_tile_count_i32, %one_i32 : i32
  %negative_output_tile_count_i32 = scalar.subi %zero_i32, %output_tile_count_i32 : i32
  %old_counter_f32 = scalar.sitofp %old_counter : i32 to f32
  %last_output_tile_f32 = scalar.sitofp %last_output_tile_i32 : i32 to f32
  %is_last_output_tile = scalar.cmpf oeq, %old_counter_f32, %last_output_tile_f32 : f32
  scf.if %is_last_output_tile {
    %publish_normalized = scalar.constant false : i1
    func.apply<qwen3_moe.rmsnorm_quantize_q8_1_x4.body>(%publish_normalized, %bounded_token_count, %token, %output_noalias, %norm_weight_noalias, %next_q8_output_noalias, %next_q8_output_noalias) : (i1, index, index, buffer, buffer, buffer, buffer)
    kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
    scf.if %is_arrival_workitem {
      view.atomic.reduce<addi> %negative_output_tile_count_i32, %completion_counter_view[%zero] {ordering = release, scope = device} : i32, view<1xi32, #dense>
    }
  }
  kernel.return
}
