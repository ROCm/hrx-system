loom_link_module(
    name = "flash_attention_prefill_f32_f16_runtime_module_unpatched",
    srcs = ["runtime_exports.loom"],
    libraries = [
        "//experimental/qwen_moe/kernels:qwen3_moe/flash_attention_f32_f16_wmma.loom",
    ],
    mode = "selective",
    output = "qwen3_moe_flash_attention_prefill_f32_f16_unpatched.loom",
    roots = ["@qwen3_moe_flash_attention_f32_f16_wmma"],
    strip_check = True,
