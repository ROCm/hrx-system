iree_c_embed_data(
    name = "runtime_modules",
    srcs = [
        ":attention_metadata_runtime_module",
        ":attention_postprocess_f32_f16_runtime_module",
        ":attention_prepare_quantized_runtime_module",
        ":attention_qkv_quantized_runtime_module",
