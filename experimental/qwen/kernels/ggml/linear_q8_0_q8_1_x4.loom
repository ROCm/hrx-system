// Contracts GGML Q8_0 weight rows directly with the Q8_1 x4 activation
// layout used by the other native GGUF projection kernels. One 34-byte Q8_0
// block represents 32 signed values as an F16 scale followed by 32 i8 codes.
//
// One subgroup owns one output row. Eight adjacent lanes consume one Q8_0
// block through native signed dot4 packets, while the active target subgroup
// size determines how many blocks advance together. The same source therefore
// uses four-block wave32 and eight-block wave64 schedules without cloning the
// kernel or naming an architecture in the model program.

config.decl @ggml.linear_q8_0_q8_1_x4.token_capacity : %value: index where [range(%value, 1, 2048)]

config.decl @ggml.linear_q8_0_q8_1_x4.output_capacity : %value: index where [range(%value, 1, 262144)]

kernel.decl @ggml_quantize_q8_1_x4_f32(%token_count: index, %input_size: index) launch(%token_count: index, %input_size: index, %input: buffer, %output: buffer)

func.decl @ggml_q8_1_x4_word(%q8_input: buffer, %row_byte_base: offset, %q8_block: index, %word_in_block: index) -> (vector<4xi8>, f32)

// Computes one lane's partial for a complete Q8_0 row. The active subgroup
// profile specializes the loop step before native emission.
func.def inline @ggml_q8_0_q8_1_x4_row_lane(%input_size: index, %weight: buffer, %weight_row_byte_base: offset, %q8_input: buffer, %q8_row_byte_base: offset, %lane0: index) -> (f32) {
  %bounded_input_size = index.assume %input_size [range(%input_size, 128, 32768), mul(%input_size, 128)] : index
  %lane = index.assume %lane0 [range(%lane0, 0, 63)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c32 = index.constant 32 : index
  %block_bytes = index.constant 34 : offset
  %word_bytes = index.constant 4 : offset
  %payload_byte_add = index.constant 2 : offset
  %c0_i32v = vector.constant 0 : vector<1xi32>
  %c0_f32 = scalar.constant 0.0 : f32
  %subgroup_size = target.subgroup.size : index
  %blocks_per_iteration = index.div %subgroup_size, %c8 : index
  %block_slot0 = index.div %lane, %c8 : index
  %block_slot = index.assume %block_slot0 [range(%block_slot0, 0, 7)] : index
  %word0 = index.rem %lane, %c8 : index
  %word = index.assume %word0 [range(%word0, 0, 7)] : index
  %block_count = index.div %bounded_input_size, %c32 : index
  %result = scf.for %block_base = [%c0 to %block_count step %blocks_per_iteration](%row_acc = %c0_f32 : f32) -> (f32) {
    %block0 = index.add %block_base, %block_slot : index
    %valid_block = index.cmp ult, %block0, %block_count : index
    %contribution = scf.if %valid_block -> (f32) {
      %block = index.assume %block0 [range(%block0, 0, 1023), lt(%block0, %block_count)] : index
      %block_byte_add = index.scale %block, %block_bytes : index, offset -> offset
      %block_byte_base = index.add %weight_row_byte_base, %block_byte_add : offset
      %payload_byte_base = index.add %block_byte_base, %payload_byte_add : offset
      %word_byte_add = index.scale %word, %word_bytes : index, offset -> offset
      %word_byte_base = index.add %payload_byte_base, %word_byte_add : offset
      %scale_view = buffer.view %weight[%block_byte_base] : buffer -> view<1xf16>
      %word_view = buffer.view %weight[%word_byte_base] : buffer -> view<1xi32>
      %weight_d_f16 = view.load %scale_view[0] : view<1xf16> -> f16
      %weight_word = vector.load %word_view[0] : view<1xi32> -> vector<1xi32>
      %weight_values = vector.bitcast %weight_word : vector<1xi32> to vector<4xi8>
      %q8_values, %q8_d = func.call @ggml_q8_1_x4_word(%q8_input, %q8_row_byte_base, %block, %word) : (buffer, offset, index, index) -> (vector<4xi8>, f32)
      %dot = vector.dot4i<s8s8> %weight_values, %q8_values, %c0_i32v : vector<4xi8>, vector<4xi8>, vector<1xi32>
      %dot_i32 = vector.extract %dot[0] : vector<1xi32> -> i32
      %dot_f32 = scalar.sitofp %dot_i32 : i32 to f32
      %weight_d = scalar.extf %weight_d_f16 : f16 to f32
      %scale = scalar.mulf<reassoc|nnan|ninf|nsz> %weight_d, %q8_d : f32
      %scaled_dot = scalar.mulf<reassoc|nnan|ninf|nsz> %dot_f32, %scale : f32
      scf.yield %scaled_dot : f32
    } else {
      scf.yield %c0_f32 : f32
    }
    %next = scalar.addf<reassoc|nnan|ninf|nsz> %row_acc, %contribution : f32
    scf.yield %next : f32
  }
  func.return %result : f32
}

kernel.def export("ggml_linear_q8_0_q8_1_x4") @ggml_linear_q8_0_q8_1_x4(%token_count: index, %input_size: index, %output_size: index) {
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 2048)] : index
  %bounded_output_size = index.assume %output_size [range(%output_size, 1, 262144)] : index
  %c1 = index.constant 1 : index
  %workgroup_size = index.constant 256 : index
  %subgroup_size = target.subgroup.size : index
  %subgroups_per_workgroup = index.div %workgroup_size, %subgroup_size : index
  %tile_tail = index.sub %subgroups_per_workgroup, %c1 : index
  %padded_output_size = index.add %bounded_output_size, %tile_tail : index
  %output_tiles = index.div %padded_output_size, %subgroups_per_workgroup : index
  kernel.launch.config workgroups(%output_tiles, %bounded_token_count, %c1) workgroup_size(%workgroup_size, %c1, %c1) : index
} launch(%token_count: index, %input_size: index, %output_size: index, %q8_input: buffer, %weight: buffer, %output: buffer) {
  %q8_noalias, %weight_noalias, %output_noalias = buffer.assume.noalias %q8_input, %weight, %output : buffer, buffer, buffer
  %token_capacity = config.get @ggml.linear_q8_0_q8_1_x4.token_capacity : index
  %output_capacity = config.get @ggml.linear_q8_0_q8_1_x4.output_capacity : index
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 2048), le(%token_count, %token_capacity)] : index
  %bounded_input_size = index.assume %input_size [range(%input_size, 128, 32768), mul(%input_size, 128)] : index
  %bounded_output_size = index.assume %output_size [range(%output_size, 1, 262144), le(%output_size, %output_capacity)] : index
  %token0 = kernel.workgroup.id<y> : index
  %token = index.assume %token0 [lt(%token0, %bounded_token_count)] : index
  %tile = kernel.workgroup.id<x> : index
  %subgroup = kernel.subgroup.id : index
  %lane = kernel.subgroup.lane.id : index
  %workgroup_size = index.constant 256 : index
  %subgroup_size = target.subgroup.size : index
  %subgroups_per_workgroup = index.div %workgroup_size, %subgroup_size : index
  %tile_channel_base = index.mul %tile, %subgroups_per_workgroup : index
  %channel0 = index.add %tile_channel_base, %subgroup : index
  %valid_channel = index.cmp ult, %channel0, %bounded_output_size : index
  %c0 = index.constant 0 : index
  %c32 = index.constant 32 : index
  %c34_bytes = index.constant 34 : offset
  %c128 = index.constant 128 : index
  %c144_bytes = index.constant 144 : offset
  %safe_channel0 = scf.select %valid_channel, %channel0, %c0 : index
  %safe_channel = index.assume %safe_channel0 [lt(%safe_channel0, %output_capacity)] : index
  %block_count = index.div %bounded_input_size, %c32 : index
  %weight_row_bytes = index.scale %block_count, %c34_bytes : index, offset -> offset
  %weight_row_byte_base = index.scale %safe_channel, %weight_row_bytes : index, offset -> offset
  %q8_group_count = index.div %bounded_input_size, %c128 : index
  %q8_row_bytes = index.scale %q8_group_count, %c144_bytes : index, offset -> offset
  %q8_row_byte_base = index.scale %token, %q8_row_bytes : index, offset -> offset
  %lane_acc = scf.if %valid_channel -> (f32) {
    %value = func.call @ggml_q8_0_q8_1_x4_row_lane(%bounded_input_size, %weight_noalias, %weight_row_byte_base, %q8_noalias, %q8_row_byte_base, %lane) : (index, buffer, offset, buffer, offset, index) -> (f32)
    scf.yield %value : f32
  } else {
    %c0_f32 = scalar.constant 0.0 : f32
    scf.yield %c0_f32 : f32
  }
  %dot = kernel.subgroup.reduce<addf> %lane_acc : f32
  %is_lane_zero = index.cmp eq, %lane, %c0 : index
  scf.if %valid_channel {
    scf.if %is_lane_zero {
      %channel = index.assume %channel0 [lt(%channel0, %bounded_output_size)] : index
      %c0_offset = index.constant 0 : offset
      %output_view = buffer.view %output_noalias[%c0_offset] : buffer -> view<[%bounded_token_count]x[%bounded_output_size]xf32>
      view.store %dot, %output_view[%token, %channel] : f32, view<[%bounded_token_count]x[%bounded_output_size]xf32>
    }
  }
  kernel.return
}

check.case public @ggml_linear_q8_0_q8_1_x4_zero_case {
  %token_count = check.literal value(1) : index
  %input_size = check.literal value(128) : index
  %output_size = check.literal value(9) : index
  %input = check.generate.fill value(1.0) : tensor<128xf32>
  %q8_input = check.generate.fill value(0) : tensor<144xi8>
  %weight = check.generate.fill value(0) : tensor<9x4x34xi8>
  %output = check.generate.fill value(1.0) : tensor<9xf32>
  %expected = check.generate.fill value(0.0) : tensor<9xf32>
  kernel.launch @ggml_quantize_q8_1_x4_f32[%token_count, %input_size](%token_count, %input_size, %input, %q8_input) : [index, index](index, index, tensor<128xf32>, tensor<144xi8>)
  kernel.launch @ggml_linear_q8_0_q8_1_x4[%token_count, %input_size, %output_size](%token_count, %input_size, %output_size, %q8_input, %weight, %output) : [index, index, index](index, index, index, tensor<144xi8>, tensor<9x4x34xi8>, tensor<9xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<9xf32>
  check.return
}

// Uniform 0x3c bytes encode an F16 block scale of 1.05859375 and signed
// payload values of 60. The independently calculated result exercises scale
// decoding, signed dot4 contraction, subgroup reduction, and a tail output
// tile.
check.case public @ggml_linear_q8_0_q8_1_x4_nonzero_tail_case {
  %token_count = check.literal value(1) : index
  %input_size = check.literal value(128) : index
  %output_size = check.literal value(9) : index
  %input = check.generate.fill value(1.0) : tensor<128xf32>
  %q8_input = check.generate.fill value(0) : tensor<144xi8>
  %weight = check.generate.fill value(60) : tensor<9x4x34xi8>
  %output = check.generate.fill value(0.0) : tensor<9xf32>
  %expected = check.generate.fill value(8129.50390625) : tensor<9xf32>
  kernel.launch @ggml_quantize_q8_1_x4_f32[%token_count, %input_size](%token_count, %input_size, %input, %q8_input) : [index, index](index, index, tensor<128xf32>, tensor<144xi8>)
  kernel.launch @ggml_linear_q8_0_q8_1_x4[%token_count, %input_size, %output_size](%token_count, %input_size, %output_size, %q8_input, %weight, %output) : [index, index, index](index, index, index, tensor<144xi8>, tensor<9x4x34xi8>, tensor<9xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.01) rtol(0.000001) nan(same) : tensor<9xf32>
  check.return
}

check.case public @ggml_linear_q8_0_q8_1_x4_v_projection_benchmark_case {
  %token_count = check.literal value(1) : index
  %input_size = check.literal value(5120) : index
  %output_size = check.literal value(1024) : index
  %q8_input = check.generate.fill value(1) : tensor<5760xi8>
  %weight = check.generate.fill value(0) : tensor<1024x160x34xi8>
  %output = check.generate.fill value(1.0) : tensor<1024xf32>
  %expected = check.generate.fill value(0.0) : tensor<1024xf32>
  kernel.launch @ggml_linear_q8_0_q8_1_x4[%token_count, %input_size, %output_size](%token_count, %input_size, %output_size, %q8_input, %weight, %output) : [index, index, index](index, index, index, tensor<5760xi8>, tensor<1024x160x34xi8>, tensor<1024xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<1024xf32>
  check.return
}

check.benchmark<@ggml_linear_q8_0_q8_1_x4_zero_case> @ggml_linear_q8_0_q8_1_x4_small

check.benchmark<@ggml_linear_q8_0_q8_1_x4_v_projection_benchmark_case> @ggml_linear_q8_0_q8_1_x4_v_projection
