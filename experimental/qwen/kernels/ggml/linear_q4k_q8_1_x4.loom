// Contracts canonical GGML Q4_K weight rows directly with Q8_1 x4
// activations. One 144-byte Q4_K block represents 256 unsigned four-bit
// codes with eight six-bit scale/minimum pairs:
//
//   f16 d;
//   f16 dmin;
//   i8 scales[12];
//   i8 qs[128];
//
// Sixteen lanes own one complete block. Paired lanes split each 32-value
// scale group into two 16-value dot products. Wave32 therefore contracts two
// blocks per iteration and wave64 contracts four without changing the row ABI.

config.decl @ggml.linear_q4k_q8_1_x4.token_capacity : %value: index where [range(%value, 1, 2048)]

config.decl @ggml.linear_q4k_q8_1_x4.output_capacity : %value: index where [range(%value, 1, 262144)]

kernel.decl @ggml_quantize_q8_1_x4_f32(%token_count: index, %input_size: index) launch(%token_count: index, %input_size: index, %input: buffer, %output: buffer)

// Decodes one 16-value half of a Q4_K scale group.
func.def inline @ggml_q4k_chunk(%weight: buffer, %row_byte_base: offset, %q4_block: index, %q4_group: index, %q4_half: index) -> (vector<16xi8>, f32, f32) {
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %block_bytes = index.constant 144 : offset
  %code_byte_add = index.constant 16 : offset
  %nibble_mask = vector.constant 252645135 : vector<4xi32>
  %c4_i32v = vector.constant 4 : vector<4xi32>
  %bounded_group = index.assume %q4_group [range(%q4_group, 0, 7)] : index
  %bounded_half = index.assume %q4_half [range(%q4_half, 0, 1)] : index
  %block_byte_add = index.scale %q4_block, %block_bytes : index, offset -> offset
  %block_byte_base = index.add %row_byte_base, %block_byte_add : offset
  %code_byte_base = index.add %block_byte_base, %code_byte_add : offset
  %code_view = buffer.view %weight[%code_byte_base] : buffer -> view<32xi32>
  %iqs_group = index.mul %bounded_group, %c8 : index
  %iqs_half = index.mul %bounded_half, %c4 : index
  %iqs = index.add %iqs_group, %iqs_half : index
  %code_page0 = index.div %iqs, %c16 : index
  %code_page = index.mul %code_page0, %c8 : index
  %code_lane = index.rem %iqs, %c8 : index
  %code_index0 = index.add %code_page, %code_lane : index
  %code_index = index.assume %code_index0 [range(%code_index0, 0, 28)] : index
  %iqs_mod16 = index.rem %iqs, %c16 : index
  %nibble_page = index.div %iqs_mod16, %c8 : index
  %nibble_shift_index = index.mul %nibble_page, %c4 : index
  %nibble_shift_i32 = index.cast %nibble_shift_index : index to i32
  %nibble_shift = vector.splat %nibble_shift_i32 : vector<4xi32>
  %packed_codes = vector.load %code_view[%code_index] : view<32xi32> -> vector<4xi32>
  %shifted_codes = vector.shrui %packed_codes, %nibble_shift : vector<4xi32>
  %q4_words = vector.andi %shifted_codes, %nibble_mask : vector<4xi32>
  %q4_values = vector.bitcast %q4_words : vector<4xi32> to vector<16xi8>
  %d_scale, %dmin_scale = func.apply<ggml.qk.scale_min>(%weight, %block_byte_base, %bounded_group) : (buffer, offset, index) -> (f32, f32)
  func.return %q4_values, %d_scale, %dmin_scale : vector<16xi8>, f32, f32
}

// Computes one lane's partial for a complete Q4_K row. The active target's
// subgroup size controls whether each loop iteration covers two or four
// consecutive 256-value blocks.
func.def inline @ggml_q4k_q8_1_x4_row_lane(%input_size: index, %weight: buffer, %weight_row_byte_base: offset, %q8_input: buffer, %q8_row_byte_base: offset, %lane: index) -> (f32) {
  %bounded_input_size = index.assume %input_size [range(%input_size, 256, 32768), mul(%input_size, 256)] : index
  %subgroup_size = target.subgroup.size : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c128 = index.constant 128 : index
  %c256 = index.constant 256 : index
  %q8_group_bytes = index.constant 144 : offset
  %q8_payload_byte_add = index.constant 16 : offset
  %c0_f32 = scalar.constant 0.0 : f32
  %q4_block_count = index.div %bounded_input_size, %c256 : index
  %q8_group_count = index.div %bounded_input_size, %c128 : index
  %blocks_per_iteration = index.div %subgroup_size, %c16 : index
  %q8_groups_per_iteration = index.div %subgroup_size, %c8 : index
  %values_per_iteration = index.mul %subgroup_size, %c16 : index
  %iteration_padding = index.sub %values_per_iteration, %c1 : index
  %padded_input_size = index.add %bounded_input_size, %iteration_padding : index
  %iteration_count = index.div %padded_input_size, %values_per_iteration : index
  %q4_group0 = index.div %lane, %c2 : index
  %q4_group1 = index.rem %q4_group0, %c8 : index
  %q4_group = index.assume %q4_group1 [range(%q4_group1, 0, 7)] : index
  %q4_half0 = index.rem %lane, %c2 : index
  %q4_half = index.assume %q4_half0 [range(%q4_half0, 0, 1)] : index
  %lane_q4_block = index.div %lane, %c16 : index
  %lane_q8_group = index.div %lane, %c8 : index
  %q8_inner_block0 = index.div %lane, %c2 : index
  %q8_inner_block1 = index.rem %q8_inner_block0, %c4 : index
  %q8_inner_block = index.assume %q8_inner_block1 [range(%q8_inner_block1, 0, 3)] : index
  %q8_inner_word_base = index.mul %q8_inner_block, %c8 : index
  %q8_half_word_add = index.mul %q4_half, %c4 : index
  %q8_word_index0 = index.add %q8_inner_word_base, %q8_half_word_add : index
  %q8_word_index = index.assume %q8_word_index0 [range(%q8_word_index0, 0, 28)] : index
  %q8_ds_index = index.mul %q8_inner_block, %c2 : index
  %q8_s_index = index.add %q8_ds_index, %c1 : index
  %sum = scf.for %iteration = [%c0 to %iteration_count step %c1](%iteration_acc = %c0_f32 : f32) -> (f32) {
    %iteration_q4_block = index.mul %iteration, %blocks_per_iteration : index
    %q4_block0 = index.add %iteration_q4_block, %lane_q4_block : index
    %valid_q4_block = index.cmp ult, %q4_block0, %q4_block_count : index
    %contribution = scf.if %valid_q4_block -> (f32) {
      %q4_block = index.assume %q4_block0 [lt(%q4_block0, %q4_block_count)] : index
      %iteration_q8_group = index.mul %iteration, %q8_groups_per_iteration : index
      %q8_group0 = index.add %iteration_q8_group, %lane_q8_group : index
      %q8_group = index.assume %q8_group0 [lt(%q8_group0, %q8_group_count)] : index
      %q8_group_byte_add = index.scale %q8_group, %q8_group_bytes : index, offset -> offset
      %q8_group_byte_base = index.add %q8_row_byte_base, %q8_group_byte_add : offset
      %q8_payload_byte_base = index.add %q8_group_byte_base, %q8_payload_byte_add : offset
      %q8_ds_view = buffer.view %q8_input[%q8_group_byte_base] : buffer -> view<8xf16>
      %q8_words_view = buffer.view %q8_input[%q8_payload_byte_base] : buffer -> view<32xi32>
      %q8_d_f16 = view.load %q8_ds_view[%q8_ds_index] : view<8xf16> -> f16
      %q8_s_f16 = view.load %q8_ds_view[%q8_s_index] : view<8xf16> -> f16
      %q8_d = scalar.extf %q8_d_f16 : f16 to f32
      %q8_s = scalar.extf %q8_s_f16 : f16 to f32
      %q8_words = vector.load %q8_words_view[%q8_word_index] : view<32xi32> -> vector<4xi32>
      %q8_values = vector.bitcast %q8_words : vector<4xi32> to vector<16xi8>
      %q4_values, %d_scale, %dmin_scale = func.call @ggml_q4k_chunk(%weight, %weight_row_byte_base, %q4_block, %q4_group, %q4_half) : (buffer, offset, index, index, index) -> (vector<16xi8>, f32, f32)
      %dot = func.apply<ggml.qk.unsigned_q8_1_dot>(%q4_values, %d_scale, %dmin_scale, %q8_values, %q8_d, %q8_s) : (vector<16xi8>, f32, f32, vector<16xi8>, f32, f32) -> (f32)
      scf.yield %dot : f32
    } else {
      scf.yield %c0_f32 : f32
    }
    %next = scalar.addf<reassoc|nnan|ninf|nsz> %iteration_acc, %contribution : f32
    scf.yield %next : f32
  }
  func.return %sum : f32
}

// Dense raw-layout projection. One subgroup owns one output channel while the
// 256-thread workgroup exposes enough independent rows to saturate decode.
kernel.def export("ggml_linear_q4k_q8_1_x4") @ggml_linear_q4k_q8_1_x4(%token_count: index, %input_size: index, %output_size: index) {
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 2048)] : index
  %bounded_output_size = index.assume %output_size [range(%output_size, 1, 262144)] : index
  %subgroup_size = target.subgroup.size : index
  %workgroup_size = index.constant 256 : index
  %c1 = index.constant 1 : index
  %subgroups_per_workgroup = index.div %workgroup_size, %subgroup_size : index
  %output_padding = index.sub %subgroups_per_workgroup, %c1 : index
  %padded_output_size = index.add %bounded_output_size, %output_padding : index
  %output_tiles = index.div %padded_output_size, %subgroups_per_workgroup : index
  kernel.launch.config workgroups(%output_tiles, %bounded_token_count, %c1) workgroup_size(%workgroup_size, %c1, %c1) : index
} launch(%token_count: index, %input_size: index, %output_size: index, %q8_input: buffer, %weight: buffer, %output: buffer) {
  %q8_noalias, %weight_noalias, %output_noalias = buffer.assume.noalias %q8_input, %weight, %output : buffer, buffer, buffer
  %token_capacity = config.get @ggml.linear_q4k_q8_1_x4.token_capacity : index
  %output_capacity = config.get @ggml.linear_q4k_q8_1_x4.output_capacity : index
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 2048), le(%token_count, %token_capacity)] : index
  %bounded_input_size = index.assume %input_size [range(%input_size, 256, 32768), mul(%input_size, 256)] : index
  %bounded_output_size = index.assume %output_size [range(%output_size, 1, 262144), le(%output_size, %output_capacity)] : index
  %subgroup_size = target.subgroup.size : index
  %workgroup_size = index.constant 256 : index
  %c0 = index.constant 0 : index
  %c128 = index.constant 128 : index
  %c144_bytes = index.constant 144 : offset
  %c256 = index.constant 256 : index
  %subgroups_per_workgroup = index.div %workgroup_size, %subgroup_size : index
  %channel_tile = kernel.workgroup.id<x> : index
  %token0 = kernel.workgroup.id<y> : index
  %token = index.assume %token0 [lt(%token0, %token_capacity)] : index
  %subgroup = kernel.subgroup.id : index
  %lane = kernel.subgroup.lane.id : index
  %channel_base = index.mul %channel_tile, %subgroups_per_workgroup : index
  %channel0 = index.add %channel_base, %subgroup : index
  %valid_channel = index.cmp ult, %channel0, %bounded_output_size : index
  %safe_channel0 = scf.select %valid_channel, %channel0, %c0 : index
  %safe_channel = index.assume %safe_channel0 [lt(%safe_channel0, %output_capacity)] : index
  %q4_block_count = index.div %bounded_input_size, %c256 : index
  %weight_row_bytes = index.scale %q4_block_count, %c144_bytes : index, offset -> offset
  %weight_row_byte_base = index.scale %safe_channel, %weight_row_bytes : index, offset -> offset
  %q8_group_count = index.div %bounded_input_size, %c128 : index
  %q8_row_bytes = index.scale %q8_group_count, %c144_bytes : index, offset -> offset
  %q8_row_byte_base = index.scale %token, %q8_row_bytes : index, offset -> offset
  %lane_acc = scf.if %valid_channel -> (f32) {
    %value = func.call @ggml_q4k_q8_1_x4_row_lane(%bounded_input_size, %weight_noalias, %weight_row_byte_base, %q8_noalias, %q8_row_byte_base, %lane) : (index, buffer, offset, buffer, offset, index) -> (f32)
    scf.yield %value : f32
  } else {
    %c0_f32 = scalar.constant 0.0 : f32
    scf.yield %c0_f32 : f32
  }
  %dot = kernel.subgroup.reduce<addf> %lane_acc : f32
  %is_lane_zero = index.cmp eq, %lane, %c0 : index
  scf.if %valid_channel {
    scf.if %is_lane_zero {
      %c0_offset = index.constant 0 : offset
      %output_view = buffer.view %output_noalias[%c0_offset] : buffer -> view<[%bounded_token_count]x[%bounded_output_size]xf32>
      view.store %dot, %output_view[%token, %channel0] : f32, view<[%bounded_token_count]x[%bounded_output_size]xf32>
    }
  }
  kernel.return
}

// Independent scalar dequantization used by the differential check.
kernel.def @ggml_q4k_f32_reference(%input_size: index) {
  %c1 = index.constant 1 : index
  %c65 = index.constant 65 : index
  %subgroup_size = target.subgroup.size : index
  kernel.launch.config workgroups(%c65, %c1, %c1) workgroup_size(%subgroup_size, %c1, %c1) : index
} launch(%input_size: index, %input: buffer, %weight: buffer, %output: buffer) {
  %bounded_input_size = index.assume %input_size [range(%input_size, 256, 256)] : index
  %output_row = kernel.workgroup.id<x> : index
  %lane = kernel.subgroup.lane.id : index
  %subgroup_size = target.subgroup.size : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c15_i32 = scalar.constant 15 : i32
  %c32 = index.constant 32 : index
  %c256 = index.constant 256 : index
  %block_bytes = index.constant 144 : offset
  %code_byte_add = index.constant 16 : offset
  %c4_i32 = scalar.constant 4 : i32
  %c0_f32 = scalar.constant 0.0 : f32
  %c0_offset = index.constant 0 : offset
  %weight_row_byte_base = index.scale %output_row, %block_bytes : index, offset -> offset
  %input_view = buffer.view %input[%c0_offset] : buffer -> view<256xf32>
  %output_view = buffer.view %output[%c0_offset] : buffer -> view<65xf32>
  %lane_sum = scf.for %channel0 = [%lane to %bounded_input_size step %subgroup_size](%running_sum = %c0_f32 : f32) -> (f32) {
    %channel = index.assume %channel0 [range(%channel0, 0, 255)] : index
    %q4_block = index.div %channel, %c256 : index
    %block_channel = index.rem %channel, %c256 : index
    %group = index.div %block_channel, %c32 : index
    %group_channel = index.rem %block_channel, %c32 : index
    %code_page = index.div %group, %c2 : index
    %code_page_base = index.mul %code_page, %c32 : index
    %code_index = index.add %code_page_base, %group_channel : index
    %block_byte_add = index.scale %q4_block, %block_bytes : index, offset -> offset
    %block_byte_base = index.add %weight_row_byte_base, %block_byte_add : offset
    %code_byte_base = index.add %block_byte_base, %code_byte_add : offset
    %code_view = buffer.view %weight[%code_byte_base] : buffer -> view<128xi8>
    %packed_code_i8 = view.load %code_view[%code_index] : view<128xi8> -> i8
    %packed_code = scalar.extui %packed_code_i8 : i8 to i32
    %group_nibble = index.rem %group, %c2 : index
    %uses_high_nibble = index.cmp eq, %group_nibble, %c1 : index
    %code = scf.if %uses_high_nibble -> (i32) {
      %shifted = scalar.shrui %packed_code, %c4_i32 : i32
      scf.yield %shifted : i32
    } else {
      %masked = scalar.andi %packed_code, %c15_i32 : i32
      scf.yield %masked : i32
    }
    %d_scale, %dmin_scale = func.apply<ggml.qk.scale_min>(%weight, %block_byte_base, %group) : (buffer, offset, index) -> (f32, f32)
    %code_f32 = scalar.uitofp %code : i32 to f32
    %scaled_code = scalar.mulf %d_scale, %code_f32 : f32
    %weight_value = scalar.subf %scaled_code, %dmin_scale : f32
    %input_value = view.load %input_view[%channel] : view<256xf32> -> f32
    %product = scalar.mulf %weight_value, %input_value : f32
    %next = scalar.addf %running_sum, %product : f32
    scf.yield %next : f32
  }
  %projection = kernel.subgroup.reduce<addf> %lane_sum : f32
  %is_lane_zero = index.cmp eq, %lane, %c0 : index
  scf.if %is_lane_zero {
    view.store %projection, %output_view[%output_row] : f32, view<65xf32>
  }
  kernel.return
}

// Supplies nonzero floating headers for deterministic packed-byte fixtures.
kernel.def @ggml_q4k_fix_differential_headers() {
  %c1 = index.constant 1 : index
  %output_size = index.constant 65 : index
  %subgroup_size = target.subgroup.size : index
  kernel.launch.config workgroups(%output_size, %c1, %c1) workgroup_size(%subgroup_size, %c1, %c1) : index
} launch(%weight: buffer) {
  %output_row = kernel.workgroup.id<x> : index
  %lane = kernel.subgroup.lane.id : index
  %c0 = index.constant 0 : index
  %block_bytes = index.constant 144 : offset
  %d = scalar.constant 0.125 : f32
  %dmin = scalar.constant 0.03125 : f32
  %d_f16 = scalar.fptrunc %d : f32 to f16
  %dmin_f16 = scalar.fptrunc %dmin : f32 to f16
  %row_byte_base = index.scale %output_row, %block_bytes : index, offset -> offset
  %half_view = buffer.view %weight[%row_byte_base] : buffer -> view<2xf16>
  %is_lane_zero = index.cmp eq, %lane, %c0 : index
  scf.if %is_lane_zero {
    view.store %d_f16, %half_view[0] : f16, view<2xf16>
    view.store %dmin_f16, %half_view[1] : f16, view<2xf16>
  }
  kernel.return
}

check.case public @ggml_linear_q4k_q8_1_x4_differential_case {
  %token_count = check.literal value(1) : index
  %input_size = check.literal value(256) : index
  %output_size = check.literal value(65) : index
  %input = check.generate.iota offset(-0.75) step(0.0078125) : tensor<256xf32>
  %q8_input = check.generate.fill value(0) : tensor<288xi8>
  %weight = check.generate.fill value(1) : tensor<65x144xi8>
  %expected = check.generate.fill value(0.0) : tensor<65xf32>
  %actual = check.generate.fill value(0.0) : tensor<65xf32>
  kernel.launch @ggml_q4k_fix_differential_headers(%weight) : (tensor<65x144xi8>)
  kernel.launch @ggml_quantize_q8_1_x4_f32[%token_count, %input_size](%token_count, %input_size, %input, %q8_input) : [index, index](index, index, tensor<256xf32>, tensor<288xi8>)
  kernel.launch @ggml_q4k_f32_reference[%input_size](%input_size, %input, %weight, %expected) : [index](index, tensor<256xf32>, tensor<65x144xi8>, tensor<65xf32>)
  kernel.launch @ggml_linear_q4k_q8_1_x4[%token_count, %input_size, %output_size](%token_count, %input_size, %output_size, %q8_input, %weight, %actual) : [index, index, index](index, index, index, tensor<288xi8>, tensor<65x144xi8>, tensor<65xf32>)
  check.expect.close actual(%actual) expected(%expected) atol(0.5) rtol(0.01) nan(same) : tensor<65xf32>
  check.return
}

check.case public @ggml_linear_q4k_q8_1_x4_benchmark_case {
  %token_count = check.param.choice values([1, 32, 128, 512]) name("token_count") : index
  %input_size = check.literal value(5120) : index
  %output_size = check.literal value(48) : index
  %q8_input = check.generate.fill value(1) : tensor<[%token_count]x5760xi8>
  %weight = check.generate.fill value(1) : tensor<48x20x144xi8>
  %output = check.generate.fill value(0.0) : tensor<[%token_count]x48xf32>
  kernel.launch @ggml_linear_q4k_q8_1_x4[%token_count, %input_size, %output_size](%token_count, %input_size, %output_size, %q8_input, %weight, %output) : [index, index, index](index, index, index, tensor<[%token_count]x5760xi8>, tensor<48x20x144xi8>, tensor<[%token_count]x48xf32>)
  check.return
}

check.benchmark<@ggml_linear_q4k_q8_1_x4_differential_case> @ggml_linear_q4k_q8_1_x4_small

check.benchmark<@ggml_linear_q4k_q8_1_x4_benchmark_case> @ggml_linear_q4k_q8_1_x4_decode {token_count = 1}

check.benchmark<@ggml_linear_q4k_q8_1_x4_benchmark_case> @ggml_linear_q4k_q8_1_x4_prefill_32 {token_count = 32}

check.benchmark<@ggml_linear_q4k_q8_1_x4_benchmark_case> @ggml_linear_q4k_q8_1_x4_prefill_128 {token_count = 128}

check.benchmark<@ggml_linear_q4k_q8_1_x4_benchmark_case> @ggml_linear_q4k_q8_1_x4_prefill_512 {token_count = 512}
