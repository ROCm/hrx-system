// Contracts GGML Q5_K weight rows directly with the Q8_1 x4 activation
// layout used by llama.cpp. One 176-byte Q5_K block represents 256 unsigned
// five-bit codes with eight six-bit scale/minimum pairs:
//
//   f16 d;            // block-wide scale
//   f16 dmin;         // block-wide minimum scale
//   i8 scales[12];    // packed six-bit scales and minima
//   i8 qh[32];        // one high bit per code
//   i8 qs[128];       // two low four-bit codes per byte
//
// Sixteen lanes own one complete block. Paired lanes split each 32-value
// scale group into two 16-value dot products. Wave32 therefore contracts two
// blocks per iteration and wave64 contracts four without changing the row ABI.

config.decl @ggml.linear_q5k_q8_1_x4.token_capacity : %value: index where [range(%value, 1, 2048)]

config.decl @ggml.linear_q5k_q8_1_x4.output_capacity : %value: index where [range(%value, 1, 262144)]

kernel.decl @ggml_quantize_q8_1_x4_f32(%token_count$2: index, %input_size$3: index) launch(%token_count$4: index, %input_size$5: index, %input: buffer, %output: buffer)

// Decodes one Q5_K scale/minimum pair from a loaded 16-byte block header.
func.template<ggml.q5k.scale_min.header> device @ggml_q5k_scale_min_header(%header_words: vector<4xi32>, %group: index) -> (f32, f32) {
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c4_i32 = scalar.constant 4 : i32
  %c6_i32 = scalar.constant 6 : i32
  %c15_i32 = scalar.constant 15 : i32
  %c63_i32 = scalar.constant 63 : i32
  %c255_i32 = scalar.constant 255 : i32
  %bounded_group = index.assume %group [range(%group, 0, 7)] : index
  %header_halves = vector.bitcast %header_words : vector<4xi32> to vector<8xf16>
  %d_f16 = vector.extract %header_halves[0] : vector<8xf16> -> f16
  %dmin_f16 = vector.extract %header_halves[1] : vector<8xf16> -> f16
  %d = scalar.extf %d_f16 : f16 to f32
  %dmin = scalar.extf %dmin_f16 : f16 to f32
  %scale_word = vector.extract %header_words[1] : vector<4xi32> -> i32
  %minimum_word = vector.extract %header_words[2] : vector<4xi32> -> i32
  %packed_word = vector.extract %header_words[3] : vector<4xi32> -> i32
  %word_byte = index.rem %bounded_group, %c4 : index
  %byte_shift_index = index.mul %word_byte, %c8 : index
  %byte_shift = index.cast %byte_shift_index : index to i32
  %shifted_scale_word = scalar.shrui %scale_word, %byte_shift : i32
  %shifted_minimum_word = scalar.shrui %minimum_word, %byte_shift : i32
  %shifted_packed_word = scalar.shrui %packed_word, %byte_shift : i32
  %scale_byte = scalar.andi %shifted_scale_word, %c255_i32 : i32
  %minimum_byte = scalar.andi %shifted_minimum_word, %c255_i32 : i32
  %packed_byte = scalar.andi %shifted_packed_word, %c255_i32 : i32
  %scale_low6 = scalar.andi %scale_byte, %c63_i32 : i32
  %minimum_low6 = scalar.andi %minimum_byte, %c63_i32 : i32
  %scale_low4 = scalar.andi %packed_byte, %c15_i32 : i32
  %minimum_low4 = scalar.shrui %packed_byte, %c4_i32 : i32
  %scale_high2_raw = scalar.shrui %scale_byte, %c6_i32 : i32
  %minimum_high2_raw = scalar.shrui %minimum_byte, %c6_i32 : i32
  %scale_high2 = scalar.shli %scale_high2_raw, %c4_i32 : i32
  %minimum_high2 = scalar.shli %minimum_high2_raw, %c4_i32 : i32
  %scale_high = scalar.ori %scale_low4, %scale_high2 : i32
  %minimum_high = scalar.ori %minimum_low4, %minimum_high2 : i32
  %uses_packed_low_bits = index.cmp uge, %bounded_group, %c4 : index
  %scale = scf.select %uses_packed_low_bits, %scale_high, %scale_low6 : i32
  %minimum = scf.select %uses_packed_low_bits, %minimum_high, %minimum_low6 : i32
  %scale_f32 = scalar.uitofp %scale : i32 to f32
  %minimum_f32 = scalar.uitofp %minimum : i32 to f32
  %d_scale = scalar.mulf %d, %scale_f32 : f32
  %dmin_scale = scalar.mulf %dmin, %minimum_f32 : f32
  func.return %d_scale, %dmin_scale : f32, f32
}

// Decodes one Q5_K scale/minimum pair from the naturally aligned 16-byte
// header. Keeping the header in one vector load avoids lane-divergent byte-load
// paths inside the production contraction loop.
func.template<ggml.q5k.scale_min> device @ggml_q5k_scale_min(%weight: buffer, %block_byte_base: offset, %group: index) -> (f32, f32) {
  %header_view = buffer.view %weight[%block_byte_base] : buffer -> view<4xi32>
  %header_words = vector.load %header_view[0] : view<4xi32> -> vector<4xi32>
  %d_scale, %dmin_scale = func.apply<ggml.q5k.scale_min.header>(%header_words, %group) : (vector<4xi32>, index) -> (f32, f32)
  func.return %d_scale, %dmin_scale : f32, f32
}

// Decodes one 16-value half of a Q5_K scale group and its two physical scales.
func.template<ggml.q5k.chunk> device @ggml_q5k_chunk(%weight: buffer, %row_byte_base: offset, %q5_block: index, %q5_group: index, %q5_half: index) -> (vector<16xi8>, f32, f32) {
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %block_bytes = index.constant 176 : offset
  %high_byte_add = index.constant 16 : offset
  %code_byte_add = index.constant 48 : offset
  %one_byte_mask = vector.constant 16843009 : vector<4xi32>
  %nibble_mask = vector.constant 252645135 : vector<4xi32>
  %c4_i32v = vector.constant 4 : vector<4xi32>
  %bounded_group = index.assume %q5_group [range(%q5_group, 0, 7)] : index
  %bounded_half = index.assume %q5_half [range(%q5_half, 0, 1)] : index
  %block_byte_add = index.scale %q5_block, %block_bytes : index, offset -> offset
  %block_byte_base = index.add %row_byte_base, %block_byte_add : offset
  %high_byte_base = index.add %block_byte_base, %high_byte_add : offset
  %code_byte_base = index.add %block_byte_base, %code_byte_add : offset
  %high_view = buffer.view %weight[%high_byte_base] : buffer -> view<8xi32>
  %code_view = buffer.view %weight[%code_byte_base] : buffer -> view<32xi32>
  %iqs_group = index.mul %bounded_group, %c8 : index
  %iqs_half = index.mul %bounded_half, %c4 : index
  %iqs = index.add %iqs_group, %iqs_half : index
  %code_page0 = index.div %iqs, %c16 : index
  %code_page = index.mul %code_page0, %c8 : index
  %code_lane = index.rem %iqs, %c8 : index
  %code_index0 = index.add %code_page, %code_lane : index
  %code_index = index.assume %code_index0 [range(%code_index0, 0, 28)] : index
  %iqs_mod16 = index.rem %iqs, %c16 : index
  %nibble_page = index.div %iqs_mod16, %c8 : index
  %nibble_shift_index = index.mul %nibble_page, %c4 : index
  %nibble_shift_i32 = index.cast %nibble_shift_index : index to i32
  %nibble_shift = vector.splat %nibble_shift_i32 : vector<4xi32>
  %packed_codes = vector.load %code_view[%code_index] : view<32xi32> -> vector<4xi32>
  %shifted_codes = vector.shrui %packed_codes, %nibble_shift : vector<4xi32>
  %low_codes = vector.andi %shifted_codes, %nibble_mask : vector<4xi32>
  %high_word_index = index.mul %bounded_half, %c4 : index
  %packed_high = vector.load %high_view[%high_word_index] : view<8xi32> -> vector<4xi32>
  %group_i32 = index.cast %bounded_group : index to i32
  %group_shift = vector.splat %group_i32 : vector<4xi32>
  %shifted_high = vector.shrui %packed_high, %group_shift : vector<4xi32>
  %high_bit01 = vector.andi %shifted_high, %one_byte_mask : vector<4xi32>
  %high_codes = vector.shli %high_bit01, %c4_i32v : vector<4xi32>
  %q5_words = vector.ori %low_codes, %high_codes : vector<4xi32>
  %q5_values = vector.bitcast %q5_words : vector<4xi32> to vector<16xi8>
  %d_scale, %dmin_scale = func.apply<ggml.q5k.scale_min>(%weight, %block_byte_base, %bounded_group) : (buffer, offset, index) -> (f32, f32)
  func.return %q5_values, %d_scale, %dmin_scale : vector<16xi8>, f32, f32
}

// Loads the Q8_1 values and scales paired with one Q5_K half-group. Keeping
// the activation access separate from weight decoding lets the four-row
// schedule reuse one decoded weight packet across all four activation rows.
func.def inline @ggml_q5k_q8_1_x4_activation_chunk(%q8_input: buffer, %q8_row_byte_base: offset, %q8_group: index, %q8_inner_block: index, %q5_half: index) -> (vector<16xi8>, f32, f32) {
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %q8_group_bytes = index.constant 144 : offset
  %q8_payload_byte_add = index.constant 16 : offset
  %bounded_inner_block = index.assume %q8_inner_block [range(%q8_inner_block, 0, 3)] : index
  %bounded_half = index.assume %q5_half [range(%q5_half, 0, 1)] : index
  %q8_group_byte_add = index.scale %q8_group, %q8_group_bytes : index, offset -> offset
  %q8_group_byte_base = index.add %q8_row_byte_base, %q8_group_byte_add : offset
  %q8_payload_byte_base = index.add %q8_group_byte_base, %q8_payload_byte_add : offset
  %q8_ds_view = buffer.view %q8_input[%q8_group_byte_base] : buffer -> view<8xf16>
  %q8_words_view = buffer.view %q8_input[%q8_payload_byte_base] : buffer -> view<32xi32>
  %q8_inner_word_base = index.mul %bounded_inner_block, %c8 : index
  %q8_half_word_add = index.mul %bounded_half, %c4 : index
  %q8_word_index = index.add %q8_inner_word_base, %q8_half_word_add : index
  %q8_ds_index = index.mul %bounded_inner_block, %c2 : index
  %q8_s_index = index.add %q8_ds_index, %c1 : index
  %q8_d_f16 = view.load %q8_ds_view[%q8_ds_index] : view<8xf16> -> f16
  %q8_s_f16 = view.load %q8_ds_view[%q8_s_index] : view<8xf16> -> f16
  %q8_words = vector.load %q8_words_view[%q8_word_index] : view<32xi32> -> vector<4xi32>
  %q8_values = vector.bitcast %q8_words : vector<4xi32> to vector<16xi8>
  %q8_d = scalar.extf %q8_d_f16 : f16 to f32
  %q8_s = scalar.extf %q8_s_f16 : f16 to f32
  func.return %q8_values, %q8_d, %q8_s : vector<16xi8>, f32, f32
}

// Computes one lane's partial for a complete Q5_K row. The active target's
// subgroup size controls whether each loop iteration covers two or four
// consecutive 256-value blocks.
func.def inline @ggml_q5k_q8_1_x4_row_lane(%input_size: index, %weight: buffer, %weight_row_byte_base: offset, %q8_input: buffer, %q8_row_byte_base: offset, %lane: index) -> (f32) {
  %bounded_input_size = index.assume %input_size [range(%input_size, 256, 32768), mul(%input_size, 256)] : index
  %subgroup_size = target.subgroup.size : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c128 = index.constant 128 : index
  %c256 = index.constant 256 : index
  %q8_group_bytes = index.constant 144 : offset
  %q8_payload_byte_add = index.constant 16 : offset
  %c0_f32 = scalar.constant 0.0 : f32
  %q5_block_count = index.div %bounded_input_size, %c256 : index
  %q8_group_count = index.div %bounded_input_size, %c128 : index
  %blocks_per_iteration = index.div %subgroup_size, %c16 : index
  %q8_groups_per_iteration = index.div %subgroup_size, %c8 : index
  %values_per_iteration = index.mul %subgroup_size, %c16 : index
  %iteration_padding = index.sub %values_per_iteration, %c1 : index
  %padded_input_size = index.add %bounded_input_size, %iteration_padding : index
  %iteration_count = index.div %padded_input_size, %values_per_iteration : index
  %q5_group0 = index.div %lane, %c2 : index
  %q5_group1 = index.rem %q5_group0, %c8 : index
  %q5_group = index.assume %q5_group1 [range(%q5_group1, 0, 7)] : index
  %q5_half0 = index.rem %lane, %c2 : index
  %q5_half = index.assume %q5_half0 [range(%q5_half0, 0, 1)] : index
  %lane_q5_block = index.div %lane, %c16 : index
  %lane_q8_group = index.div %lane, %c8 : index
  %q8_inner_block0 = index.div %lane, %c2 : index
  %q8_inner_block1 = index.rem %q8_inner_block0, %c4 : index
  %q8_inner_block = index.assume %q8_inner_block1 [range(%q8_inner_block1, 0, 3)] : index
  %q8_inner_word_base = index.mul %q8_inner_block, %c8 : index
  %q8_half_word_add = index.mul %q5_half, %c4 : index
  %q8_word_index0 = index.add %q8_inner_word_base, %q8_half_word_add : index
  %q8_word_index = index.assume %q8_word_index0 [range(%q8_word_index0, 0, 28)] : index
  %q8_ds_index = index.mul %q8_inner_block, %c2 : index
  %q8_s_index = index.add %q8_ds_index, %c1 : index
  %sum = scf.for %iteration = [%c0 to %iteration_count step %c1](%iteration_acc = %c0_f32 : f32) -> (f32) {
    %iteration_q5_block = index.mul %iteration, %blocks_per_iteration : index
    %q5_block0 = index.add %iteration_q5_block, %lane_q5_block : index
    %valid_q5_block = index.cmp ult, %q5_block0, %q5_block_count : index
    %contribution = scf.if %valid_q5_block -> (f32) {
      %q5_block = index.assume %q5_block0 [lt(%q5_block0, %q5_block_count)] : index
      %iteration_q8_group = index.mul %iteration, %q8_groups_per_iteration : index
      %q8_group0 = index.add %iteration_q8_group, %lane_q8_group : index
      %q8_group = index.assume %q8_group0 [lt(%q8_group0, %q8_group_count)] : index
      %q8_group_byte_add = index.scale %q8_group, %q8_group_bytes : index, offset -> offset
      %q8_group_byte_base = index.add %q8_row_byte_base, %q8_group_byte_add : offset
      %q8_payload_byte_base = index.add %q8_group_byte_base, %q8_payload_byte_add : offset
      %q8_ds_view = buffer.view %q8_input[%q8_group_byte_base] : buffer -> view<8xf16>
      %q8_words_view = buffer.view %q8_input[%q8_payload_byte_base] : buffer -> view<32xi32>
      %q8_d_f16 = view.load %q8_ds_view[%q8_ds_index] : view<8xf16> -> f16
      %q8_s_f16 = view.load %q8_ds_view[%q8_s_index] : view<8xf16> -> f16
      %q8_d = scalar.extf %q8_d_f16 : f16 to f32
      %q8_s = scalar.extf %q8_s_f16 : f16 to f32
      %q8_words = vector.load %q8_words_view[%q8_word_index] : view<32xi32> -> vector<4xi32>
      %q8_values = vector.bitcast %q8_words : vector<4xi32> to vector<16xi8>
      %q5_values, %d_scale, %dmin_scale = func.apply<ggml.q5k.chunk>(%weight, %weight_row_byte_base, %q5_block, %q5_group, %q5_half) : (buffer, offset, index, index, index) -> (vector<16xi8>, f32, f32)
      %dot = func.apply<ggml.qk.unsigned_q8_1_dot>(%q5_values, %d_scale, %dmin_scale, %q8_values, %q8_d, %q8_s) : (vector<16xi8>, f32, f32, vector<16xi8>, f32, f32) -> (f32)
      scf.yield %dot : f32
    } else {
      scf.yield %c0_f32 : f32
    }
    %next = scalar.addf<reassoc|nnan|ninf|nsz> %iteration_acc, %contribution : f32
    scf.yield %next : f32
  }
  func.return %sum : f32
}

// Computes four activation rows for one output channel while decoding every
// Q5_K weight packet once. Each returned scalar is reduced independently by
// the owning subgroup.
func.def inline @ggml_q5k_q8_1_x4_row_lane_m4(%input_size: index, %weight: buffer, %weight_row_byte_base: offset, %q8_input: buffer, %q8_row0_byte_base: offset, %q8_row1_byte_base: offset, %q8_row2_byte_base: offset, %q8_row3_byte_base: offset, %lane: index) -> (f32, f32, f32, f32) {
  %bounded_input_size = index.assume %input_size [range(%input_size, 256, 32768), mul(%input_size, 256)] : index
  %subgroup_size = target.subgroup.size : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c128 = index.constant 128 : index
  %c256 = index.constant 256 : index
  %c0_f32 = scalar.constant 0.0 : f32
  %q5_block_count = index.div %bounded_input_size, %c256 : index
  %q8_group_count = index.div %bounded_input_size, %c128 : index
  %blocks_per_iteration = index.div %subgroup_size, %c16 : index
  %q8_groups_per_iteration = index.div %subgroup_size, %c8 : index
  %values_per_iteration = index.mul %subgroup_size, %c16 : index
  %iteration_padding = index.sub %values_per_iteration, %c1 : index
  %padded_input_size = index.add %bounded_input_size, %iteration_padding : index
  %iteration_count = index.div %padded_input_size, %values_per_iteration : index
  %q5_group0 = index.div %lane, %c2 : index
  %q5_group1 = index.rem %q5_group0, %c8 : index
  %q5_group = index.assume %q5_group1 [range(%q5_group1, 0, 7)] : index
  %q5_half0 = index.rem %lane, %c2 : index
  %q5_half = index.assume %q5_half0 [range(%q5_half0, 0, 1)] : index
  %lane_q5_block = index.div %lane, %c16 : index
  %lane_q8_group = index.div %lane, %c8 : index
  %q8_inner_block0 = index.div %lane, %c2 : index
  %q8_inner_block1 = index.rem %q8_inner_block0, %c4 : index
  %q8_inner_block = index.assume %q8_inner_block1 [range(%q8_inner_block1, 0, 3)] : index
  %row0, %row1, %row2, %row3 = scf.for %iteration = [%c0 to %iteration_count step %c1](%row0_acc = %c0_f32, %row1_acc = %c0_f32, %row2_acc = %c0_f32, %row3_acc = %c0_f32 : f32, f32, f32, f32) -> (f32, f32, f32, f32) {
    %iteration_q5_block = index.mul %iteration, %blocks_per_iteration : index
    %q5_block0 = index.add %iteration_q5_block, %lane_q5_block : index
    %valid_q5_block = index.cmp ult, %q5_block0, %q5_block_count : index
    %dot0, %dot1, %dot2, %dot3 = scf.if %valid_q5_block -> (f32, f32, f32, f32) {
      %q5_block = index.assume %q5_block0 [lt(%q5_block0, %q5_block_count)] : index
      %iteration_q8_group = index.mul %iteration, %q8_groups_per_iteration : index
      %q8_group0 = index.add %iteration_q8_group, %lane_q8_group : index
      %q8_group = index.assume %q8_group0 [lt(%q8_group0, %q8_group_count)] : index
      %q5_values, %d_scale, %dmin_scale = func.apply<ggml.q5k.chunk>(%weight, %weight_row_byte_base, %q5_block, %q5_group, %q5_half) : (buffer, offset, index, index, index) -> (vector<16xi8>, f32, f32)
      %q8_values0, %q8_d0, %q8_s0 = func.call @ggml_q5k_q8_1_x4_activation_chunk(%q8_input, %q8_row0_byte_base, %q8_group, %q8_inner_block, %q5_half) : (buffer, offset, index, index, index) -> (vector<16xi8>, f32, f32)
      %q8_values1, %q8_d1, %q8_s1 = func.call @ggml_q5k_q8_1_x4_activation_chunk(%q8_input, %q8_row1_byte_base, %q8_group, %q8_inner_block, %q5_half) : (buffer, offset, index, index, index) -> (vector<16xi8>, f32, f32)
      %q8_values2, %q8_d2, %q8_s2 = func.call @ggml_q5k_q8_1_x4_activation_chunk(%q8_input, %q8_row2_byte_base, %q8_group, %q8_inner_block, %q5_half) : (buffer, offset, index, index, index) -> (vector<16xi8>, f32, f32)
      %q8_values3, %q8_d3, %q8_s3 = func.call @ggml_q5k_q8_1_x4_activation_chunk(%q8_input, %q8_row3_byte_base, %q8_group, %q8_inner_block, %q5_half) : (buffer, offset, index, index, index) -> (vector<16xi8>, f32, f32)
      %value0 = func.apply<ggml.qk.unsigned_q8_1_dot>(%q5_values, %d_scale, %dmin_scale, %q8_values0, %q8_d0, %q8_s0) : (vector<16xi8>, f32, f32, vector<16xi8>, f32, f32) -> (f32)
      %value1 = func.apply<ggml.qk.unsigned_q8_1_dot>(%q5_values, %d_scale, %dmin_scale, %q8_values1, %q8_d1, %q8_s1) : (vector<16xi8>, f32, f32, vector<16xi8>, f32, f32) -> (f32)
      %value2 = func.apply<ggml.qk.unsigned_q8_1_dot>(%q5_values, %d_scale, %dmin_scale, %q8_values2, %q8_d2, %q8_s2) : (vector<16xi8>, f32, f32, vector<16xi8>, f32, f32) -> (f32)
      %value3 = func.apply<ggml.qk.unsigned_q8_1_dot>(%q5_values, %d_scale, %dmin_scale, %q8_values3, %q8_d3, %q8_s3) : (vector<16xi8>, f32, f32, vector<16xi8>, f32, f32) -> (f32)
      scf.yield %value0, %value1, %value2, %value3 : f32, f32, f32, f32
    } else {
      scf.yield %c0_f32, %c0_f32, %c0_f32, %c0_f32 : f32, f32, f32, f32
    }
    %next0 = scalar.addf<reassoc|nnan|ninf|nsz> %row0_acc, %dot0 : f32
    %next1 = scalar.addf<reassoc|nnan|ninf|nsz> %row1_acc, %dot1 : f32
