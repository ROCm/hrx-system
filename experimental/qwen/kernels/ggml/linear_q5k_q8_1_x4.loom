// Workload values size the exact launch; configured capacities only constrain
// device-body specialization and buffer addressing.
kernel.def export("ggml_linear_q5k_q8_1_x4") @ggml_linear_q5k_q8_1_x4(%token_count: index, %input_size: index, %output_size: index) {
