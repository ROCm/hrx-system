// Independent scalar dequantization used only by the differential check.
kernel.def @ggml_q5k_f32_reference(%input_size: index) {
  %c1 = index.constant 1 : index
  %c65 = index.constant 65 : index
  %subgroup_size = target.subgroup.size : index
  kernel.launch.config workgroups(%c65, %c1, %c1) workgroup_size(%subgroup_size, %c1, %c1) : index
} launch(%input_size: index, %input: buffer, %weight: buffer, %output: buffer) {
  %bounded_input_size = index.assume %input_size [range(%input_size, 256, 256)] : index
  %output_row = kernel.workgroup.id<x> : index
  %lane = kernel.subgroup.lane.id : index
  %subgroup_size = target.subgroup.size : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c15 = index.constant 15 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c256 = index.constant 256 : index
  %block_bytes = index.constant 176 : offset
  %scale_byte_add = index.constant 4 : offset
  %high_byte_add = index.constant 16 : offset
  %code_byte_add = index.constant 48 : offset
  %c4_i32 = scalar.constant 4 : i32
  %c6_i32 = scalar.constant 6 : i32
  %c15_i32 = scalar.constant 15 : i32
  %c63_i32 = scalar.constant 63 : i32
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %c16_i32 = scalar.constant 16 : i32
  %c0_f32 = scalar.constant 0.0 : f32
  %c0_offset = index.constant 0 : offset
  %weight_row_byte_base = index.scale %output_row, %block_bytes : index, offset -> offset
  %input_view = buffer.view %input[%c0_offset] : buffer -> view<256xf32>
  %output_view = buffer.view %output[%c0_offset] : buffer -> view<65xf32>
  %lane_sum = scf.for %channel0 = [%lane to %bounded_input_size step %subgroup_size](%running_sum = %c0_f32 : f32) -> (f32) {
    %channel = index.assume %channel0 [range(%channel0, 0, 255)] : index
    %q5_block = index.div %channel, %c256 : index
    %block_channel = index.rem %channel, %c256 : index
    %group = index.div %block_channel, %c32 : index
    %group_channel = index.rem %block_channel, %c32 : index
    %code_page = index.div %group, %c2 : index
    %code_page_base = index.mul %code_page, %c32 : index
    %code_index = index.add %code_page_base, %group_channel : index
    %block_byte_add = index.scale %q5_block, %block_bytes : index, offset -> offset
    %block_byte_base = index.add %weight_row_byte_base, %block_byte_add : offset
    %scale_byte_base = index.add %block_byte_base, %scale_byte_add : offset
    %high_byte_base = index.add %block_byte_base, %high_byte_add : offset
    %code_byte_base = index.add %block_byte_base, %code_byte_add : offset
    %half_view = buffer.view %weight[%block_byte_base] : buffer -> view<2xf16>
    %scale_view = buffer.view %weight[%scale_byte_base] : buffer -> view<12xi8>
    %high_view = buffer.view %weight[%high_byte_base] : buffer -> view<32xi8>
    %code_view = buffer.view %weight[%code_byte_base] : buffer -> view<128xi8>
    %d_f16 = view.load %half_view[0] : view<2xf16> -> f16
    %dmin_f16 = view.load %half_view[1] : view<2xf16> -> f16
    %d = scalar.extf %d_f16 : f16 to f32
    %dmin = scalar.extf %dmin_f16 : f16 to f32
    %packed_code_i8 = view.load %code_view[%code_index] : view<128xi8> -> i8
    %packed_code = scalar.extui %packed_code_i8 : i8 to i32
    %group_nibble = index.rem %group, %c2 : index
    %uses_high_nibble = index.cmp eq, %group_nibble, %c1 : index
    %low_code = scf.if %uses_high_nibble -> (i32) {
      %value = scalar.shrui %packed_code, %c4_i32 : i32
      scf.yield %value : i32
    } else {
      %value = scalar.andi %packed_code, %c15_i32 : i32
      scf.yield %value : i32
    }
    %high_i8 = view.load %high_view[%group_channel] : view<32xi8> -> i8
    %high = scalar.extui %high_i8 : i8 to i32
    %group_i32 = index.cast %group : index to i32
    %high_mask = scalar.shli %c1_i32, %group_i32 : i32
    %high_bit = scalar.andi %high, %high_mask : i32
    %has_high_bit = scalar.cmpi ne, %high_bit, %c0_i32 : i32
    %code = scf.if %has_high_bit -> (i32) {
      %value = scalar.addi %low_code, %c16_i32 : i32
      scf.yield %value : i32
    } else {
      scf.yield %low_code : i32
    }
    %is_low_group = index.cmp ult, %group, %c4 : index
    %scale, %minimum = scf.if %is_low_group -> (i32, i32) {
      %minimum_index = index.add %group, %c4 : index
      %scale_i8 = view.load %scale_view[%group] : view<12xi8> -> i8
      %minimum_i8 = view.load %scale_view[%minimum_index] : view<12xi8> -> i8
      %scale_u8 = scalar.extui %scale_i8 : i8 to i32
      %minimum_u8 = scalar.extui %minimum_i8 : i8 to i32
      %scale_low6 = scalar.andi %scale_u8, %c63_i32 : i32
      %minimum_low6 = scalar.andi %minimum_u8, %c63_i32 : i32
      scf.yield %scale_low6, %minimum_low6 : i32, i32
    } else {
      %packed_index = index.add %group, %c4 : index
      %scale_high_index = index.sub %group, %c4 : index
      %packed_i8 = view.load %scale_view[%packed_index] : view<12xi8> -> i8
      %scale_high_i8 = view.load %scale_view[%scale_high_index] : view<12xi8> -> i8
      %minimum_high_i8 = view.load %scale_view[%group] : view<12xi8> -> i8
      %packed = scalar.extui %packed_i8 : i8 to i32
      %scale_high = scalar.extui %scale_high_i8 : i8 to i32
      %minimum_high = scalar.extui %minimum_high_i8 : i8 to i32
      %scale_low4 = scalar.andi %packed, %c15_i32 : i32
      %minimum_low4 = scalar.shrui %packed, %c4_i32 : i32
      %scale_high2_raw = scalar.shrui %scale_high, %c6_i32 : i32
      %minimum_high2_raw = scalar.shrui %minimum_high, %c6_i32 : i32
      %scale_high2 = scalar.shli %scale_high2_raw, %c4_i32 : i32
      %minimum_high2 = scalar.shli %minimum_high2_raw, %c4_i32 : i32
      %scale_value = scalar.ori %scale_low4, %scale_high2 : i32
      %minimum_value = scalar.ori %minimum_low4, %minimum_high2 : i32
      scf.yield %scale_value, %minimum_value : i32, i32
    }
    %scale_f32 = scalar.uitofp %scale : i32 to f32
    %minimum_f32 = scalar.uitofp %minimum : i32 to f32
    %code_f32 = scalar.uitofp %code : i32 to f32
    %scaled_code0 = scalar.mulf %d, %scale_f32 : f32
    %scaled_code = scalar.mulf %scaled_code0, %code_f32 : f32
    %minimum0 = scalar.mulf %dmin, %minimum_f32 : f32
    %weight_value = scalar.subf %scaled_code, %minimum0 : f32
    %input_value = view.load %input_view[%channel] : view<256xf32> -> f32
    %product = scalar.mulf %weight_value, %input_value : f32
    %next = scalar.addf %running_sum, %product : f32
    scf.yield %next : f32
  }
  %projection = kernel.subgroup.reduce<addf> %lane_sum : f32
  %is_lane_zero = index.cmp eq, %lane, %c0 : index
  scf.if %is_lane_zero {
    view.store %projection, %output_view[%output_row] : f32, view<65xf32>
  }
  kernel.return
}

// Supplies nonzero floating headers for deterministic packed-byte fixtures.
kernel.def @ggml_q5k_fix_differential_headers() {
  %c1 = index.constant 1 : index
  %output_size = index.constant 65 : index
  %subgroup_size = target.subgroup.size : index
  kernel.launch.config workgroups(%output_size, %c1, %c1) workgroup_size(%subgroup_size, %c1, %c1) : index
} launch(%weight: buffer) {
  %output_row = kernel.workgroup.id<x> : index
  %lane = kernel.subgroup.lane.id : index
  %c0 = index.constant 0 : index
  %block_bytes = index.constant 176 : offset
  %d = scalar.constant 0.125 : f32
  %dmin = scalar.constant 0.03125 : f32
  %d_f16 = scalar.fptrunc %d : f32 to f16
  %dmin_f16 = scalar.fptrunc %dmin : f32 to f16
  %row_byte_base = index.scale %output_row, %block_bytes : index, offset -> offset
  %half_view = buffer.view %weight[%row_byte_base] : buffer -> view<2xf16>
  %is_lane_zero = index.cmp eq, %lane, %c0 : index
  scf.if %is_lane_zero {
    view.store %d_f16, %half_view[0] : f16, view<2xf16>
    view.store %dmin_f16, %half_view[1] : f16, view<2xf16>
  }
  kernel.return
}

check.case public @ggml_linear_q5k_q8_1_x4_differential_case {
  %token_count = check.literal value(1) : index
  %input_size = check.literal value(256) : index
  %output_size = check.literal value(65) : index
  %input = check.generate.iota offset(-0.75) step(0.0078125) : tensor<256xf32>
  %q8_input = check.generate.fill value(0) : tensor<288xi8>
  %weight = check.generate.fill value(1) : tensor<65x176xi8>
  %expected = check.generate.fill value(0.0) : tensor<65xf32>
  %actual = check.generate.fill value(0.0) : tensor<65xf32>
  kernel.launch @ggml_q5k_fix_differential_headers(%weight) : (tensor<65x176xi8>)
  kernel.launch @ggml_quantize_q8_1_x4_f32[%token_count, %input_size](%token_count, %input_size, %input, %q8_input) : [index, index](index, index, tensor<256xf32>, tensor<288xi8>)
  kernel.launch @ggml_q5k_f32_reference[%input_size](%input_size, %input, %weight, %expected) : [index](index, tensor<256xf32>, tensor<65x176xi8>, tensor<65xf32>)
  kernel.launch @ggml_linear_q5k_q8_1_x4[%token_count, %input_size, %output_size](%token_count, %input_size, %output_size, %q8_input, %weight, %actual) : [index, index, index](index, index, index, tensor<288xi8>, tensor<65x176xi8>, tensor<65xf32>)
  check.expect.close actual(%actual) expected(%expected) atol(0.5) rtol(0.01) nan(same) : tensor<65xf32>
  check.return
}

// Compares the four-row weight-reuse schedule against four independent rows
// of the established raw-layout kernel on the same nonzero packed payload.
check.case public @ggml_linear_q5k_q8_1_x4_m4_differential_case {
  %token_count = check.literal value(4) : index
  %input_size = check.literal value(256) : index
  %output_size = check.literal value(65) : index
  %input = check.generate.fill value(0.00390625) : tensor<4x256xf32>
  %q8_input = check.generate.fill value(0) : tensor<4x288xi8>
  %weight = check.generate.fill value(1) : tensor<65x176xi8>
  %expected = check.generate.fill value(0.0) : tensor<4x65xf32>
  %actual = check.generate.fill value(0.0) : tensor<4x65xf32>
