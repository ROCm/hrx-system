// Temporary, non-sanctioned one-function fork for Qwen decode bring-up. This
// is not a second kernel authoring path. Delete it when exact workload values
// reach template selection and select the canonical cooperative reducer for
// context 513. The function retains the canonical public ABI and makes only
// the exact 9-block, 4-KV-head launch structural and carries context 513 to
// both canonical template applications.
kernel.def target(@qwen3_moe_decode_split_gfx11_wave64) @qwen3_moe_flash_attention_decode_split_f32_f16_wmma(%key_value_token_count: index) {
  %one = index.constant 1 : index
  %four = index.constant 4 : index
  %nine = index.constant 9 : index
  %twofiftysix = index.constant 256 : index
  kernel.launch.config workgroups(%nine, %four, %one) workgroup_size(%twofiftysix, %one, %one) : index
} launch(%key_value_token_count: index, %query: buffer, %key: buffer, %value: buffer, %mask: buffer, %partial_max: buffer, %partial_sum: buffer, %partial_output: buffer, %completion_counter: buffer, %output: buffer) {
  %bounded_key_value_token_count = index.assume %key_value_token_count [range(%key_value_token_count, 513, 513)] : index
  func.apply<qwen3_moe.attention.decode_split.produce_partials>(%bounded_key_value_token_count, %query, %key, %value, %mask, %partial_max, %partial_sum, %partial_output) : (index, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  func.apply<qwen3_moe.attention.decode_split.reduce_fused>(%bounded_key_value_token_count, %partial_max, %partial_sum, %partial_output, %completion_counter, %output) : (index, buffer, buffer, buffer, buffer, buffer)
  kernel.return
}
