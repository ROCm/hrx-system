// Qwen vocabulary endpoint kernels built on the canonical GGML Q6_K/Q8_1 x4
// contraction body. The ordinary full-logit export remains defined by the
// shared kernel corpus; this module owns only endpoint reductions and checks.

kernel.decl @qwen_greedy_argmax_partials(%partial_count: index, %context_increment: index) launch(%partial_count: index, %context_increment: index, %partial_logits: buffer, %partial_ids: buffer, %next_token_id: buffer, %next_control: buffer, %observed_token_id: buffer)

config.decl @ggml.linear_q6k_q8_1_x4.output_capacity : %value: index where [range(%value, 1, 262144)]

// Publishes one deterministic maximum pair per eight-channel projection tile
// so the owned model can finalize 18,992 pairs instead of rereading all
// 151,936 logits.
kernel.def @ggml_linear_q6k_q8_1_x4_partial_argmax(%token_count: index, %input_size: index, %output_size: index) {
  %output_capacity = config.get @ggml.linear_q6k_q8_1_x4.output_capacity : index
  %eight = index.constant 8 : index
  %seven = index.constant 7 : index
  %one = index.constant 1 : index
  %workgroup_size = index.constant 256 : index
  %padded_output_size = index.add %output_capacity, %seven : index
  %output_tiles = index.div %padded_output_size, %eight : index
  kernel.launch.config workgroups(%output_tiles, %one, %one) workgroup_size(%workgroup_size, %one, %one) : index
} launch(%token_count: index, %input_size: index, %output_size: index, %q8_input: buffer, %weight: buffer, %partial_logits: buffer, %partial_ids: buffer) {
  %output_capacity = config.get @ggml.linear_q6k_q8_1_x4.output_capacity : index
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 1)] : index
  %bounded_output_size = index.assume %output_size [range(%output_size, 1, 262144), eq(%output_size, %output_capacity)] : index
  %q8_noalias, %weight_noalias, %partial_logits_noalias, %partial_ids_noalias = buffer.assume.noalias %q8_input, %weight, %partial_logits, %partial_ids : buffer, buffer, buffer, buffer
  %publish_output = scalar.constant true : i1
  %token0 = kernel.workgroup.id<y> : index
  %dot, %token, %channel, %valid_channel, %launch_token_count, %output_bound = func.apply<ggml.linear_q6k_q8_1_x4.body>(%publish_output, %bounded_token_count, %token0, %input_size, %bounded_output_size, %q8_noalias, %weight_noalias) : (i1, index, index, index, index, buffer, buffer) -> (f32, index, index, i1, index, index)
  %zero = index.constant 0 : index
  %seven = index.constant 7 : index
  %eight = index.constant 8 : index
  %zero_i32 = scalar.constant 0 : i32
  %largest_i32 = scalar.constant 2147483647 : i32
  %negative_large = scalar.constant -3.4028234663852885e+38 : f32
  %zero_offset = index.constant 0 : offset
  %lane = kernel.subgroup.lane.id : index
  %lane_i32 = index.cast %lane : index to i32
  %is_lane_zero = scalar.cmpi eq, %lane_i32, %zero_i32 : i32
  %is_candidate = scalar.andi %valid_channel, %is_lane_zero : i1
  %candidate_logit = scf.select %is_candidate, %dot, %negative_large : f32
  %channel_i32 = index.cast %channel : index to i32
  %candidate_id = scf.select %is_candidate, %channel_i32, %largest_i32 : i32
  %winning_logit = kernel.workgroup.reduce<maxnumf> %candidate_logit : f32
  %owns_winning_logit = scalar.cmpf oeq, %candidate_logit, %winning_logit : f32
  %candidate_winning_id = scf.select %owns_winning_logit, %candidate_id, %largest_i32 : i32
  %winning_id = kernel.workgroup.reduce<minsi> %candidate_winning_id : i32
  %workitem = kernel.workitem.id<x> : index
  %publishes_partial = index.cmp eq, %workitem, %zero : index
  scf.if %publishes_partial {
    %padded_output_size = index.add %output_bound, %seven : index
    %partial_count0 = index.div %padded_output_size, %eight : index
    %partial_count = index.assume %partial_count0 [range(%partial_count0, 1, 18992)] : index
    %partial_index0 = kernel.workgroup.id<x> : index
    %partial_index, %partial_bound = index.assume %partial_index0, %partial_count [lt(%partial_index0, %partial_count)] : index, index
    %partial_logits_view = buffer.view %partial_logits_noalias[%zero_offset] : buffer -> view<[%partial_bound]xf32, #dense>
    %partial_ids_view = buffer.view %partial_ids_noalias[%zero_offset] : buffer -> view<[%partial_bound]xi32, #dense>
    view.store %winning_logit, %partial_logits_view[%partial_index] : f32, view<[%partial_bound]xf32, #dense>
    view.store %winning_id, %partial_ids_view[%partial_index] : i32, view<[%partial_bound]xi32, #dense>
  }
  kernel.return
}

// The final partial tile owns only token eight. Invalid tail subgroups must not
// participate in either the maximum or the deterministic ID reduction.
check.case public @ggml_linear_q6k_q8_1_x4_partial_argmax_tail_case {
  %token_count = check.literal value(1) : index
  %input_size = check.literal value(2048) : index
  %output_size = check.literal value(9) : index
  %q8_input = check.generate.fill value(0) : tensor<1x2304xi8>
  %weight = check.generate.fill value(-86) : tensor<9x8x210xi8>
  %partial_logits = check.generate.fill value(1.0) : tensor<2xf32>
  %partial_ids = check.generate.fill value(-1) : tensor<2xi32>
  %expected_logits = check.generate.fill value(0.0) : tensor<2xf32>
  %expected_ids = check.generate.iota offset(0) step(8) : tensor<2xi32>
  kernel.launch @ggml_linear_q6k_q8_1_x4_partial_argmax[%token_count, %input_size, %output_size](%token_count, %input_size, %output_size, %q8_input, %weight, %partial_logits, %partial_ids) : [index, index, index](index, index, index, tensor<1x2304xi8>, tensor<9x8x210xi8>, tensor<2xf32>, tensor<2xi32>)
  check.expect.close actual(%partial_logits) expected(%expected_logits) atol(0.0) rtol(0.0) nan(same) : tensor<2xf32>
  check.expect.equal actual(%partial_ids) expected(%expected_ids) : tensor<2xi32>
  check.return
}

// A fully tied production row forces every local and global tie to resolve to
// the lowest real vocabulary ID.
check.case public @ggml_linear_q6k_q8_1_x4_partial_argmax_vocabulary_differential_case {
  %token_count = check.literal value(1) : index
  %input_size = check.literal value(2048) : index
  %output_size = check.literal value(151936) : index
  %partial_count = check.literal value(18992) : index
  %context_increment = check.literal value(1) : index
  %q8_input = check.generate.fill value(0) : tensor<1x2304xi8>
  %weight = check.generate.fill value(0) : tensor<151936x8x210xi8>
  %partial_logits = check.generate.fill value(1.0) : tensor<18992xf32>
  %partial_ids = check.generate.fill value(-1) : tensor<18992xi32>
  %expected_partial_logits = check.generate.fill value(0.0) : tensor<18992xf32>
  %expected_partial_ids = check.generate.iota offset(0) step(8) : tensor<18992xi32>
  %expected_token = check.generate.fill value(0) : tensor<1xi32>
  %expected_control = check.generate.fill value(513) : tensor<1xi32>
  %actual_token = check.generate.fill value(-1) : tensor<1xi32>
  %next_control = check.generate.fill value(512) : tensor<1xi32>
  %observed_token = check.generate.fill value(-1) : tensor<1xi32>
  kernel.launch @ggml_linear_q6k_q8_1_x4_partial_argmax[%token_count, %input_size, %output_size](%token_count, %input_size, %output_size, %q8_input, %weight, %partial_logits, %partial_ids) : [index, index, index](index, index, index, tensor<1x2304xi8>, tensor<151936x8x210xi8>, tensor<18992xf32>, tensor<18992xi32>)
  kernel.launch @qwen_greedy_argmax_partials[%partial_count, %context_increment](%partial_count, %context_increment, %partial_logits, %partial_ids, %actual_token, %next_control, %observed_token) : [index, index](index, index, tensor<18992xf32>, tensor<18992xi32>, tensor<1xi32>, tensor<1xi32>, tensor<1xi32>)
  check.expect.close actual(%partial_logits) expected(%expected_partial_logits) atol(0.0) rtol(0.0) nan(same) : tensor<18992xf32>
  check.expect.equal actual(%partial_ids) expected(%expected_partial_ids) : tensor<18992xi32>
  check.expect.equal actual(%actual_token) expected(%expected_token) : tensor<1xi32>
  check.expect.equal actual(%next_control) expected(%expected_control) : tensor<1xi32>
  check.expect.equal actual(%observed_token) expected(%expected_token) : tensor<1xi32>
  check.return
}

check.case public @ggml_linear_q6k_q8_1_x4_partial_argmax_benchmark_case {
  %token_count = check.literal value(1) : index
  %input_size = check.literal value(2048) : index
  %output_size = check.literal value(151936) : index
  %partial_count = check.literal value(18992) : index
  %context_increment = check.literal value(1) : index
  %q8_input = check.generate.fill value(0) : tensor<1x2304xi8>
  %weight = check.generate.fill value(0) : tensor<151936x8x210xi8>
  %partial_logits = check.generate.fill value(1.0) : tensor<18992xf32>
  %partial_ids = check.generate.fill value(-1) : tensor<18992xi32>
  %token = check.generate.fill value(-1) : tensor<1xi32>
  %next_control = check.generate.fill value(512) : tensor<1xi32>
  %observed_token = check.generate.fill value(-1) : tensor<1xi32>
  kernel.launch @ggml_linear_q6k_q8_1_x4_partial_argmax[%token_count, %input_size, %output_size](%token_count, %input_size, %output_size, %q8_input, %weight, %partial_logits, %partial_ids) : [index, index, index](index, index, index, tensor<1x2304xi8>, tensor<151936x8x210xi8>, tensor<18992xf32>, tensor<18992xi32>)
  kernel.launch @qwen_greedy_argmax_partials[%partial_count, %context_increment](%partial_count, %context_increment, %partial_logits, %partial_ids, %token, %next_control, %observed_token) : [index, index](index, index, tensor<18992xf32>, tensor<18992xi32>, tensor<1xi32>, tensor<1xi32>, tensor<1xi32>)
  check.return
}

check.benchmark<@ggml_linear_q6k_q8_1_x4_partial_argmax_benchmark_case> @ggml_linear_q6k_q8_1_x4_partial_argmax_endpoint
