// Replaces only the floating-point Q5_K headers in the varied-byte
// differential fixture. Packed scales, high bits, and low nibbles retain the
// generated pattern so the witness exercises every physical code plane.
kernel.def target(@qwen38_dense_q5_i8_wave32) @qwen38_q5k_i8_wmma_fix_differential_headers() {
  %c1 = index.constant 1 : index
  %output_size = index.constant 128 : index
  %subgroup_size = target.subgroup.size : index
  kernel.launch.config workgroups(%output_size, %c1, %c1) workgroup_size(%subgroup_size, %c1, %c1) : index
} launch(%weight: buffer) {
  %output_row = kernel.workgroup.id<x> : index
  %lane = kernel.subgroup.lane.id : index
  %c0 = index.constant 0 : index
  %block_bytes = index.constant 176 : offset
  %d = scalar.constant 0.125 : f32
  %dmin = scalar.constant 0.03125 : f32
  %d_f16 = scalar.fptrunc %d : f32 to f16
  %dmin_f16 = scalar.fptrunc %dmin : f32 to f16
  %row_byte_base = index.scale %output_row, %block_bytes : index, offset -> offset
  %half_view = buffer.view %weight[%row_byte_base] : buffer -> view<2xf16>
  %is_lane_zero = index.cmp eq, %lane, %c0 : index
  scf.if %is_lane_zero {
    view.store %d_f16, %half_view[0] : f16, view<2xf16>
    view.store %dmin_f16, %half_view[1] : f16, view<2xf16>
  }
  kernel.return
}

check.case public @qwen38_linear_q5k_i8_wmma_differential_case {
  %token_count = check.literal value(64) : index
  %input_size = check.literal value(256) : index
  %output_size = check.literal value(128) : index
  %input = check.generate.iota offset(-0.75) step(0.00006103515625) : tensor<64x256xf32>
  %q8_input = check.generate.fill value(0) : tensor<64x288xi8>
  %weight = check.generate.iota offset(-127) step(17) period(15) : tensor<128x176xi8>
  %expected = check.generate.fill value(0.0) : tensor<64x128xf32>
  %actual = check.generate.fill value(0.0) : tensor<64x128xf32>
  kernel.launch @qwen38_q5k_i8_wmma_fix_differential_headers(%weight) : (tensor<128x176xi8>)
  kernel.launch @ggml_quantize_q8_1_x4_f32[%token_count, %input_size](%token_count, %input_size, %input, %q8_input) : [index, index](index, index, tensor<64x256xf32>, tensor<64x288xi8>)
  kernel.launch @ggml_linear_q5k_q8_1_x4[%token_count, %input_size, %output_size](%token_count, %input_size, %output_size, %q8_input, %weight, %expected) : [index, index, index](index, index, index, tensor<64x288xi8>, tensor<128x176xi8>, tensor<64x128xf32>)
  kernel.launch @qwen38_linear_q5k_i8_wmma[%token_count](%token_count, %q8_input, %weight, %actual) : [index](index, tensor<64x288xi8>, tensor<128x176xi8>, tensor<64x128xf32>)
  check.expect.close actual(%actual) expected(%expected) atol(0.5) rtol(0.01) nan(same) : tensor<64x128xf32>
  check.return
}

check.case public @qwen38_linear_q5k_i8_wmma_prefill_case {
  %token_count = check.param.choice values([64, 128, 512]) name("token_count") : index
  %input_size = check.literal value(5120) : index
  %output_size = check.literal value(17408) : index
  %q8_input = check.generate.fill value(1) : tensor<[%token_count]x5760xi8>
  %weight = check.generate.fill value(1) : tensor<17408x20x176xi8>
  %output = check.generate.fill value(0.0) : tensor<[%token_count]x17408xf32>
  kernel.launch @qwen38_linear_q5k_i8_wmma[%token_count](%token_count, %q8_input, %weight, %output) : [index](index, tensor<[%token_count]x5760xi8>, tensor<17408x20x176xi8>, tensor<[%token_count]x17408xf32>)
  check.return
}

