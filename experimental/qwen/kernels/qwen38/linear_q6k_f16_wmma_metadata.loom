    %block_result0, %block_result1, %block_result2, %block_result3 = scf.for %quant_group = [%c0 to %c8 step %c1](%acc0 = %block_acc0 : vector<4xf32>, %acc1 = %block_acc1 : vector<4xf32>, %acc2 = %block_acc2 : vector<4xf32>, %acc3 = %block_acc3 : vector<4xf32>) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) {
