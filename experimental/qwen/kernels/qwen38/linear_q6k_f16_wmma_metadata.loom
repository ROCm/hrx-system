// Exact-Q6_K metadata-staged prefill schedule experiment.
//
// Canonical Q6_K bytes are unchanged. The workgroup decodes each row/group
// scale pair once, stages it in LDS, and reuses it for all eight Q6 payload
// packets. F32 and producer-rounded F16 activation storage specialize into the
// same F16 WMMA operand stream.

kernel.decl @qwen38_linear_q6k_f16_wmma_x128(%token_count0: index, %input_size0: index, %output_size0: index) launch(%token_count_data: buffer, %input_size1: index, %output_size1: index, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @qwen38_residual_add_f32_prefill(%token_count: index) launch(%token_count1: index, %lhs: buffer, %rhs: buffer, %output: buffer)

amdgpu.target<gfx11-generic> @qwen38_q6k_metadata_gfx11_wave64 {subgroup_size = 64}

func.def inline @qwen38_q6k_scale_pair(%weight: buffer, %row_byte_base: offset, %q6_block: index, %q6_group: index) -> (vector<2xf32>) {
  %c2 = index.constant 2 : index
  %block_bytes = index.constant 210 : offset
  %scale_byte_add = index.constant 192 : offset
  %d_byte_add = index.constant 208 : offset
  %block_byte_add = index.scale %q6_block, %block_bytes : index, offset -> offset
  %block_byte_base = index.add %row_byte_base, %block_byte_add : offset
  %scale_byte_base = index.add %block_byte_base, %scale_byte_add : offset
  %d_byte_base = index.add %block_byte_base, %d_byte_add : offset
  %scale_pair_add = index.mul %q6_group, %c2 : index
  %scale_view = buffer.view %weight[%scale_byte_base] : buffer -> view<16xi8>
  %d_view = buffer.view %weight[%d_byte_base] : buffer -> view<1xf16>
  %scale_i8 = vector.load %scale_view[%scale_pair_add] : view<16xi8> -> vector<2xi8>
  %scale = vector.sitofp %scale_i8 : vector<2xi8> to vector<2xf32>
  %d_f16 = view.load %d_view[0] : view<1xf16> -> f16
  %d = scalar.extf %d_f16 : f16 to f32
  %d_pair = vector.splat %d : vector<2xf32>
  %combined = vector.mulf %scale, %d_pair : vector<2xf32>
  func.return %combined : vector<2xf32>
}

func.def inline @qwen38_q6k_f16_vector4_prescaled(%weight: buffer, %row_byte_base: offset, %q6_block: index, %q6_group: index, %packet: index, %combined_scale: f32) -> (vector<4xf16>) {
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %block_bytes = index.constant 210 : offset
  %qh_byte_add = index.constant 128 : offset
  %c4_i32v = vector.constant 4 : vector<1xi32>
  %nibble_mask = vector.constant 252645135 : vector<1xi32>
  %high_mask = vector.constant 50529027 : vector<1xi32>
  %c32_f32v = vector.constant 32.0 : vector<4xf32>
  %bounded_group = index.assume %q6_group [range(%q6_group, 0, 7)] : index
  %bounded_packet = index.assume %packet [range(%packet, 0, 7)] : index
  %block_byte_add = index.scale %q6_block, %block_bytes : index, offset -> offset
  %block_byte_base = index.add %row_byte_base, %block_byte_add : offset
  %qh_byte_base = index.add %block_byte_base, %qh_byte_add : offset
  %ql_view = buffer.view %weight[%block_byte_base] : buffer -> view<32xi32>
  %qh_view = buffer.view %weight[%qh_byte_base] : buffer -> view<16xi32>
  %group_in_half = index.rem %bounded_group, %c4 : index
  %half = index.div %bounded_group, %c4 : index
  %ql_side = index.rem %group_in_half, %c2 : index
  %ql_half_word_base = index.mul %half, %c16 : index
  %ql_side_word_add = index.mul %ql_side, %c8 : index
  %ql_word_base = index.add %ql_half_word_base, %ql_side_word_add : index
  %ql_word_index = index.add %ql_word_base, %bounded_packet : index
  %qh_half_word_base = index.mul %half, %c8 : index
  %qh_word_index = index.add %qh_half_word_base, %bounded_packet : index
  %nibble = index.div %group_in_half, %c2 : index
  %nibble_shift_index = index.mul %nibble, %c4 : index
  %nibble_shift_i32 = index.cast %nibble_shift_index : index to i32
  %nibble_shift = vector.splat %nibble_shift_i32 : vector<1xi32>
  %qh_shift_index = index.mul %group_in_half, %c2 : index
  %qh_shift_i32 = index.cast %qh_shift_index : index to i32
  %qh_shift = vector.splat %qh_shift_i32 : vector<1xi32>
  %ql_word = vector.load %ql_view[%ql_word_index] : view<32xi32> -> vector<1xi32>
  %qh_word = vector.load %qh_view[%qh_word_index] : view<16xi32> -> vector<1xi32>
  %ql_shifted = vector.shrui %ql_word, %nibble_shift : vector<1xi32>
  %ql = vector.andi %ql_shifted, %nibble_mask : vector<1xi32>
  %qh_shifted = vector.shrui %qh_word, %qh_shift : vector<1xi32>
  %qh_low = vector.andi %qh_shifted, %high_mask : vector<1xi32>
  %qh = vector.shli %qh_low, %c4_i32v : vector<1xi32>
  %code = vector.ori %ql, %qh : vector<1xi32>
  %code_i8 = vector.bitcast %code : vector<1xi32> to vector<4xi8>
  %code_f32 = vector.uitofp %code_i8 : vector<4xi8> to vector<4xf32>
  %centered = vector.subf %code_f32, %c32_f32v : vector<4xf32>
  %combined_scale_vector = vector.splat %combined_scale : vector<4xf32>
  %values_f32 = vector.mulf %centered, %combined_scale_vector : vector<4xf32>
  %values = vector.fptrunc %values_f32 : vector<4xf32> to vector<4xf16>
  func.return %values : vector<4xf16>
}

func.template<qwen38.dense_q6k_f16_wmma.metadata.body> device @qwen38_dense_q6k_f16_wmma_metadata_body(%weight_format: index, %weight_macro_block_byte_count: index, %input_is_f16: i1, %adds_residual: i1, %token_count: index, %input_size0: index, %output_size0: index, %channel_tile: index, %token_tile: index, %channel_tile_width: index, %token_tile_width: index, %channel_group_count: index, %workgroup_size: index, %subgroup_count: index, %workitem: index, %subgroup: index, %lane: index, %input: buffer, %weight: buffer, %output: buffer) {
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 512)] : index
  %bounded_input_size = index.assume %input_size0 [range(%input_size0, 256, 32768), mul(%input_size0, 256)] : index
  %bounded_output_size = index.assume %output_size0 [range(%output_size0, 1, 32768)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c15 = index.constant 15 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c40 = index.constant 40 : index
  %c48 = index.constant 48 : index
  %c64 = index.constant 64 : index
  %c128 = index.constant 128 : index
  %c256 = index.constant 256 : index
  %c0_offset = index.constant 0 : offset
  %f16_byte_count = index.constant 2 : offset
  %f32_byte_count = index.constant 4 : offset
  %wave_result_stage_bytes = index.constant 1024 : offset
  %weight_stage_elements = index.mul %channel_tile_width, %c40 : index
  %weight_stage_bytes = index.scale %weight_stage_elements, %f16_byte_count : index, offset -> offset
  %activation_stage_elements = index.mul %token_tile_width, %c40 : index
  %activation_stage_bytes = index.scale %activation_stage_elements, %f16_byte_count : index, offset -> offset
  %metadata_stage_pair_count = index.mul %channel_tile_width, %c8 : index
  %metadata_stage_elements = index.mul %metadata_stage_pair_count, %c2 : index
  %metadata_stage_bytes = index.scale %metadata_stage_elements, %f32_byte_count : index, offset -> offset
  // The c128 schedule reuses four result slots after contraction. Smaller
  // channel tiles retain one private result slot per subgroup.
  %uses_c128 = index.cmp eq, %channel_tile_width, %c128 : index
  %result_slot_count = scf.if %uses_c128 -> (index) {
    scf.yield %c4 : index
  } else {
    scf.yield %subgroup_count : index
  }
  %result_stage_bytes = index.scale %result_slot_count, %wave_result_stage_bytes : index, offset -> offset
  %c0_f16x4 = vector.constant 0.0 : vector<4xf16>
  %c0_f32x4 = vector.constant 0.0 : vector<4xf32>
  %zero_accumulator = vector.constant 0.0 : vector<4xf32>
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %quant_block_count = index.div %bounded_input_size, %c256 : index
  %input_f16_word_count = index.div %bounded_input_size, %c2 : index
  %last_input_f16_packet_start = index.sub %input_f16_word_count, %c1 : index
  %weight_row_bytes = index.mul %quant_block_count, %weight_macro_block_byte_count : index
  %input_noalias, %weight_noalias, %output_noalias = buffer.assume.noalias %input, %weight, %output : buffer, buffer, buffer
  %input_f32_view = buffer.view %input_noalias[%c0_offset] : buffer -> view<[%bounded_token_count]x[%bounded_input_size]xf32>
  %input_f16_packed_view = buffer.view %input_noalias[%c0_offset] : buffer -> view<[%bounded_token_count]x[%input_f16_word_count]xi32>
  %output_view = buffer.view %output_noalias[%c0_offset] : buffer -> view<[%bounded_token_count]x[%bounded_output_size]xf32>
  %weight_stage = buffer.alloca<workgroup> align(16) %weight_stage_bytes : buffer
  %activation_stage = buffer.alloca<workgroup> align(16) %activation_stage_bytes : buffer
  %metadata_stage = buffer.alloca<workgroup> align(16) %metadata_stage_bytes : buffer
  %result_stage = buffer.alloca<workgroup> align(16) %result_stage_bytes : buffer
  %weight_stage_view = buffer.view %weight_stage[%c0_offset] : buffer -> view<[%channel_tile_width]x40xf16>
  %activation_stage_physical_view = buffer.view %activation_stage[%c0_offset] : buffer -> view<[%token_tile_width]x40xf16>
  %metadata_stage_view = buffer.view %metadata_stage[%c0_offset] : buffer -> view<[%channel_tile_width]x8x2xf32>
  %activation_fragment_layout = encoding.layout.strided [1, %c40] : encoding<layout>
  %activation_fragment_view = buffer.view %activation_stage[%c0_offset] : buffer -> view<32x[%token_tile_width]xf16, %activation_fragment_layout>
  %result_slot = scf.if %uses_c128 -> (index) {
    %result_slot0 = index.rem %subgroup, %c4 : index
    %bounded_result_slot = index.assume %result_slot0 [range(%result_slot0, 0, 3)] : index
    scf.yield %bounded_result_slot : index
  } else {
    scf.yield %subgroup : index
  }
  %wave_result_stage_offset = index.scale %result_slot, %wave_result_stage_bytes : index, offset -> offset
  %result_fragment_layout = encoding.layout.strided [1, %c16] : encoding<layout>
  %result_fragment_view = buffer.view %result_stage[%wave_result_stage_offset] : buffer -> view<16x16xf32, %result_fragment_layout>
  %result_physical_view = buffer.view %result_stage[%wave_result_stage_offset] : buffer -> view<16x16xf32>
  %channel_tile_base = index.mul %channel_tile, %channel_tile_width : index
  %token_tile_base = index.mul %token_tile, %token_tile_width : index
  %channel_group0 = index.rem %subgroup, %channel_group_count : index
  %channel_group = index.assume %channel_group0 [lt(%channel_group0, %channel_group_count)] : index
  %subgroup_channel_add = index.mul %channel_group, %c16 : index
  %token_group0 = index.div %subgroup, %channel_group_count : index
  %token_group = index.assume %token_group0 [range(%token_group0, 0, 1)] : index
  %subgroup_token_add = index.mul %token_group, %c64 : index
  %weight_load_count = index.mul %channel_tile_width, %c8 : index
  %activation_load_count = index.mul %token_tile_width, %c8 : index
  %metadata_load_count = index.mul %channel_tile_width, %c8 : index
  %uses_x64 = index.cmp eq, %token_tile_width, %c64 : index
  %init00 = vector.fragment<init> %zero_accumulator shape [%m, %n] : vector<4xf32>
  %init01 = vector.fragment<init> %zero_accumulator shape [%m, %n] : vector<4xf32>
  %init10 = vector.fragment<init> %zero_accumulator shape [%m, %n] : vector<4xf32>
  %init11 = vector.fragment<init> %zero_accumulator shape [%m, %n] : vector<4xf32>
  %result00, %result01, %result10, %result11 = scf.for %quant_block = [%c0 to %quant_block_count step %c1](%block_acc00 = %init00 : vector<4xf32>, %block_acc01 = %init01 : vector<4xf32>, %block_acc10 = %init10 : vector<4xf32>, %block_acc11 = %init11 : vector<4xf32>) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) {
    scf.for %metadata_task = [%workitem to %metadata_load_count step %workgroup_size] unroll {
      %metadata_group0 = index.rem %metadata_task, %c8 : index
      %metadata_group = index.assume %metadata_group0 [range(%metadata_group0, 0, 7)] : index
      %metadata_row0 = index.div %metadata_task, %c8 : index
      %metadata_row = index.assume %metadata_row0 [lt(%metadata_row0, %channel_tile_width)] : index
      %metadata_channel = index.add %channel_tile_base, %metadata_row : index
      %valid_metadata_channel = index.cmp ult, %metadata_channel, %bounded_output_size : index
      %metadata_pair = scf.if %valid_metadata_channel -> (vector<2xf32>) {
        %metadata_channel_byte_index = index.mul %metadata_channel, %weight_row_bytes : index
        %metadata_row_byte_base = index.cast %metadata_channel_byte_index : index to offset
        %decoded_pair = func.call @qwen38_q6k_scale_pair(%weight_noalias, %metadata_row_byte_base, %quant_block, %metadata_group) : (buffer, offset, index, index) -> (vector<2xf32>)
        scf.yield %decoded_pair : vector<2xf32>
      } else {
        %zero_pair = vector.constant 0.0 : vector<2xf32>
        scf.yield %zero_pair : vector<2xf32>
      }
      vector.store %metadata_pair, %metadata_stage_view[%metadata_row, %metadata_group, %c0] : vector<2xf32>, view<[%channel_tile_width]x8x2xf32>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %block_result00, %block_result01, %block_result10, %block_result11 = scf.for %quant_group = [%c0 to %c8 step %c1](%acc00 = %block_acc00 : vector<4xf32>, %acc01 = %block_acc01 : vector<4xf32>, %acc10 = %block_acc10 : vector<4xf32>, %acc11 = %block_acc11 : vector<4xf32>) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) {
      %block_k_base = index.mul %quant_block, %c256 : index
      %group_k_add = index.mul %quant_group, %c32 : index
      %k_origin = index.add %block_k_base, %group_k_add : index
      scf.if %uses_x64 {
        %load_packet0 = index.rem %workitem, %c8 : index
        %load_packet = index.assume %load_packet0 [range(%load_packet0, 0, 7)] : index
        %load_k = index.mul %load_packet, %c4 : index
        %load_row0 = index.div %workitem, %c8 : index
        %load_row = index.assume %load_row0 [range(%load_row0, 0, 31)] : index
        scf.for %row_offset = [%c0 to %c64 step %c32] unroll {
          %local_row0 = index.add %load_row, %row_offset : index
          %local_row = index.assume %local_row0 [range(%local_row0, 0, 63)] : index
          %channel = index.add %channel_tile_base, %local_row : index
          %valid_channel = index.cmp ult, %channel, %bounded_output_size : index
          %weight_values = scf.if %valid_channel -> (vector<4xf16>) {
            %channel_byte_index = index.mul %channel, %weight_row_bytes : index
            %row_byte_base = index.cast %channel_byte_index : index to offset
            %packet_half = index.div %load_packet, %c4 : index
            %combined_scale = view.load %metadata_stage_view[%local_row, %quant_group, %packet_half] : view<[%channel_tile_width]x8x2xf32> -> f32
            %decoded = func.call @qwen38_q6k_f16_vector4_prescaled(%weight_noalias, %row_byte_base, %quant_block, %quant_group, %load_packet, %combined_scale) : (buffer, offset, index, index, index, f32) -> (vector<4xf16>)
            scf.yield %decoded : vector<4xf16>
          } else {
            scf.yield %c0_f16x4 : vector<4xf16>
          }
          vector.store %weight_values, %weight_stage_view[%local_row, %load_k] : vector<4xf16>, view<[%channel_tile_width]x40xf16>
          %token = index.add %token_tile_base, %local_row : index
          %valid_token = index.cmp ult, %token, %bounded_token_count : index
          %activation_values = scf.if %valid_token -> (vector<4xf16>) {
            %bounded_token, %input_token_count = index.assume %token, %bounded_token_count [lt(%token, %bounded_token_count)] : index, index
            %input_k = index.add %k_origin, %load_k : index
            %loaded = scf.if %input_is_f16 -> (vector<4xf16>) {
              %input_word0 = index.div %input_k, %c2 : index
              %input_word = index.assume %input_word0 [ge(%input_word0, 0), lt(%input_word0, %last_input_f16_packet_start)] : index
              %packed = vector.load %input_f16_packed_view[%bounded_token, %input_word] : view<[%bounded_token_count]x[%input_f16_word_count]xi32> -> vector<2xi32>
              %value = vector.bitcast %packed : vector<2xi32> to vector<4xf16>
              scf.yield %value : vector<4xf16>
            } else {
              %input_mask = vector.mask.range [%input_k to %bounded_input_size step %c1] : index -> vector<4xi1>
              %value_f32 = vector.load.mask %input_f32_view[%bounded_token, %input_k], %input_mask, %c0_f32x4 : view<[%bounded_token_count]x[%bounded_input_size]xf32>, vector<4xi1>, vector<4xf32>
              %value = vector.fptrunc %value_f32 : vector<4xf32> to vector<4xf16>
              scf.yield %value : vector<4xf16>
            }
            scf.yield %loaded : vector<4xf16>
          } else {
            scf.yield %c0_f16x4 : vector<4xf16>
          }
          vector.store %activation_values, %activation_stage_physical_view[%local_row, %load_k] : vector<4xf16>, view<[%token_tile_width]x40xf16>
        }
      } else {
        scf.for %weight_task = [%workitem to %weight_load_count step %workgroup_size] unroll {
          %load_packet0 = index.rem %weight_task, %c8 : index
          %load_packet = index.assume %load_packet0 [range(%load_packet0, 0, 7)] : index
          %load_k = index.mul %load_packet, %c4 : index
          %load_row0 = index.div %weight_task, %c8 : index
          %load_row = index.assume %load_row0 [lt(%load_row0, %channel_tile_width)] : index
          %channel = index.add %channel_tile_base, %load_row : index
          %valid_channel = index.cmp ult, %channel, %bounded_output_size : index
          %weight_values = scf.if %valid_channel -> (vector<4xf16>) {
            %channel_byte_index = index.mul %channel, %weight_row_bytes : index
            %row_byte_base = index.cast %channel_byte_index : index to offset
            %packet_half = index.div %load_packet, %c4 : index
            %combined_scale = view.load %metadata_stage_view[%load_row, %quant_group, %packet_half] : view<[%channel_tile_width]x8x2xf32> -> f32
            %decoded = func.call @qwen38_q6k_f16_vector4_prescaled(%weight_noalias, %row_byte_base, %quant_block, %quant_group, %load_packet, %combined_scale) : (buffer, offset, index, index, index, f32) -> (vector<4xf16>)
            scf.yield %decoded : vector<4xf16>
          } else {
            scf.yield %c0_f16x4 : vector<4xf16>
          }
          vector.store %weight_values, %weight_stage_view[%load_row, %load_k] : vector<4xf16>, view<[%channel_tile_width]x40xf16>
        }
        scf.for %activation_task = [%workitem to %activation_load_count step %workgroup_size] unroll {
          %load_packet0 = index.rem %activation_task, %c8 : index
          %load_packet = index.assume %load_packet0 [range(%load_packet0, 0, 7)] : index
          %load_k = index.mul %load_packet, %c4 : index
          %activation_row0 = index.div %activation_task, %c8 : index
          %activation_row = index.assume %activation_row0 [range(%activation_row0, 0, 127)] : index
          %token = index.add %token_tile_base, %activation_row : index
          %valid_token = index.cmp ult, %token, %bounded_token_count : index
          %activation_values = scf.if %valid_token -> (vector<4xf16>) {
            %bounded_token, %input_token_count = index.assume %token, %bounded_token_count [lt(%token, %bounded_token_count)] : index, index
            %input_k = index.add %k_origin, %load_k : index
            %loaded = scf.if %input_is_f16 -> (vector<4xf16>) {
              %input_word0 = index.div %input_k, %c2 : index
              %input_word = index.assume %input_word0 [ge(%input_word0, 0), lt(%input_word0, %last_input_f16_packet_start)] : index
              %packed = vector.load %input_f16_packed_view[%bounded_token, %input_word] : view<[%bounded_token_count]x[%input_f16_word_count]xi32> -> vector<2xi32>
              %value = vector.bitcast %packed : vector<2xi32> to vector<4xf16>
              scf.yield %value : vector<4xf16>
            } else {
              %input_mask = vector.mask.range [%input_k to %bounded_input_size step %c1] : index -> vector<4xi1>
              %value_f32 = vector.load.mask %input_f32_view[%bounded_token, %input_k], %input_mask, %c0_f32x4 : view<[%bounded_token_count]x[%bounded_input_size]xf32>, vector<4xi1>, vector<4xf32>
              %value = vector.fptrunc %value_f32 : vector<4xf32> to vector<4xf16>
              scf.yield %value : vector<4xf16>
            }
            scf.yield %loaded : vector<4xf16>
          } else {
            scf.yield %c0_f16x4 : vector<4xf16>
          }
          vector.store %activation_values, %activation_stage_physical_view[%activation_row, %load_k] : vector<4xf16>, view<[%token_tile_width]x40xf16>
        }
      }
      kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
      %next00, %next01, %next10, %next11 = scf.for %k_half = [%c0 to %c32 step %c16](%half_acc00 = %acc00 : vector<4xf32>, %half_acc01 = %acc01 : vector<4xf32>, %half_acc10 = %acc10 : vector<4xf32>, %half_acc11 = %acc11 : vector<4xf32>) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) unroll {
        %lhs0 = vector.fragment.load<lhs> %weight_stage_view[%subgroup_channel_add, %k_half] shape [%m, %k] : view<[%channel_tile_width]x40xf16> -> vector<16xf16>
        %rhs_token0 = index.add %subgroup_token_add, %c0 : index
        %rhs_token1 = index.add %subgroup_token_add, %c16 : index
        %rhs_token2 = index.add %subgroup_token_add, %c32 : index
        %rhs_token3 = index.add %subgroup_token_add, %c48 : index
