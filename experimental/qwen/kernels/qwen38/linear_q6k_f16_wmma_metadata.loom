      %combined_scale = view.load %metadata_stage_view[%load_row, %quant_group, %packet_half] : view<64x8x2xf32> -> f32
      %weight_values = func.call @qwen38_q6k_f16_vector4_prescaled(%weight_noalias, %row_byte_base, %quant_block, %quant_group, %load_packet, %combined_scale) : (buffer, offset, index, index, index, f32) -> (vector<4xf16>)
