// Exact paired Q5_K gate/up contraction with local SwiGLU and Q8_1 output.
//
// A workgroup owns 64 tokens by 64 FFN channels. Four wave32 subgroups
// contract gate weights while four contract up weights. Both projections
// reuse one staged Q8_1 activation tile and occupy disjoint halves of one
// 128-row Q5_K weight tile. Gate fragments rendezvous with the matching up
// fragments in LDS, and the workgroup publishes only the exact Q8_1 x4
// activation consumed by the down projection.

kernel.decl @ggml_quantize_q8_1_x4_f32(%token_count0: index, %input_size0: index) launch(%token_count1: index, %input_size1: index, %input: buffer, %output: buffer)

kernel.decl @qwen38_linear_q5k_i8_wmma(%token_count0: index) launch(%token_count1: index, %q8_input: buffer, %weight: buffer, %output: buffer)

kernel.decl @qwen38_q5k_i8_wmma_fix_differential_headers() launch(%weight: buffer)

kernel.decl @qwen38_swiglu_f32_prefill(%token_count: index) launch(%token_count: index, %gate: buffer, %up: buffer, %output: buffer)

func.decl @qwen38_q8_tile64_store_subgroup_block(%tile_byte_base: offset, %token_local: index, %block_in_tile: index, %value: f32, %output: buffer)

func.decl @qwen38_q8_stage_activation_tile(%token_count: index, %input_size: index, %token_tile_base: index, %q8_group: index, %workitem: index, %q8_input: buffer, %activation_stage: buffer, %activation_metadata: buffer)

func.decl @qwen38_q5k_stage_weight_tile(%input_size: index, %output_size: index, %channel_tile_base: index, %stage_channel_base: index, %stage_channel_count: index, %q5_block: index, %workitem: index, %weight: buffer, %weight_stage: buffer)

func.decl @qwen38_q5k_stage_weight_tile_pair(%input_size: index, %output_size: index, %channel_tile_base: index, %q5_block: index, %workitem: index, %gate_weight: buffer, %up_weight: buffer, %weight_stage: buffer)

func.decl @qwen38_q5k_contract_group(%weight_group: index, %activation_group: index, %wave: index, %lane: index, %weight_stage: buffer, %activation_stage: buffer, %activation_metadata: buffer, %accumulator0: vector<8xf32>, %accumulator1: vector<8xf32>, %accumulator2: vector<8xf32>, %accumulator3: vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>)

config.decl @qwen38.ffn_gate_up_q5k_i8_wmma.input_size : %value: index where [range(%value, 256, 32768), mul(%value, 256)]

config.decl @qwen38.ffn_gate_up_q5k_i8_wmma.output_size : %value: index where [range(%value, 128, 32768), mul(%value, 128)]

amdgpu.target<gfx11-generic> @qwen38_ffn_gate_up_q5_i8_wave32 {subgroup_size = 32}

// Parameterized reference boundary used to verify the fused packet at a small
// exact shape. Production baselines use the existing model-width SwiGLU root.
kernel.def target(@qwen38_ffn_gate_up_q5_i8_wave32) @qwen38_swiglu_f32_reference(%token_count0: index, %output_size0: index) {
  %token_count = index.assume %token_count0 [range(%token_count0, 1, 512)] : index
  %output_size = index.assume %output_size0 [range(%output_size0, 128, 32768), mul(%output_size0, 128)] : index
  %c1 = index.constant 1 : index
  %c128 = index.constant 128 : index
  %workgroup_count = index.div %output_size, %c128 : index
  kernel.launch.config workgroups(%workgroup_count, %token_count, %c1) workgroup_size(%c128, %c1, %c1) : index
} launch(%token_count0: index, %output_size0: index, %gate: buffer, %up: buffer, %output: buffer) {
  %token_count = index.assume %token_count0 [range(%token_count0, 1, 512)] : index
  %output_size = index.assume %output_size0 [range(%output_size0, 128, 32768), mul(%output_size0, 128)] : index
  %workgroup = kernel.workgroup.id<x> : index
  %token0 = kernel.workgroup.id<y> : index
  %token = index.assume %token0 [lt(%token0, %token_count)] : index
