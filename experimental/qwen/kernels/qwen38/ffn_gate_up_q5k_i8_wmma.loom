check.case public @qwen38_ffn_gate_up_q5k_i8_wmma_differential_case {
  %token_count = check.literal value(64) : index
  %input_size = check.literal value(256) : index
  %output_size = check.literal value(128) : index
  // Preserve the Q8 code distribution used by the projection differential
  // while keeping the paired SwiGLU result within finite Q8 metadata range.
  %input = check.generate.iota offset(-0.000732421875) step(0.000000059604644775390625) : tensor<64x256xf32>
  %q8_input = check.generate.fill value(0) : tensor<64x288xi8>
  %gate_weight = check.generate.iota offset(-127) step(17) period(15) : tensor<128x176xi8>
  %up_weight = check.generate.iota offset(-113) step(13) period(17) : tensor<128x176xi8>
  %gate = check.generate.fill value(0.0) : tensor<64x128xf32>
  %up = check.generate.fill value(0.0) : tensor<64x128xf32>
  %swiglu = check.generate.fill value(0.0) : tensor<64x128xf32>
  %expected = check.generate.fill value(0) : tensor<64x144xi8>
  %actual = check.generate.fill value(1) : tensor<64x144xi8>
  kernel.launch @qwen38_q5k_i8_wmma_fix_differential_headers(%gate_weight) : (tensor<128x176xi8>)
  kernel.launch @qwen38_q5k_i8_wmma_fix_differential_headers(%up_weight) : (tensor<128x176xi8>)
  kernel.launch @ggml_quantize_q8_1_x4_f32[%token_count, %input_size](%token_count, %input_size, %input, %q8_input) : [index, index](index, index, tensor<64x256xf32>, tensor<64x288xi8>)
  kernel.launch @qwen38_linear_q5k_i8_wmma[%token_count](%token_count, %q8_input, %gate_weight, %gate) : [index](index, tensor<64x288xi8>, tensor<128x176xi8>, tensor<64x128xf32>)
  kernel.launch @qwen38_linear_q5k_i8_wmma[%token_count](%token_count, %q8_input, %up_weight, %up) : [index](index, tensor<64x288xi8>, tensor<128x176xi8>, tensor<64x128xf32>)
