  %c128 = index.constant 128 : index
  %c0_offset = index.constant 0 : offset
  %element_base = index.mul %workgroup, %c128 : index
  %element0 = index.add %element_base, %workitem : index
  %element, %bounded_output_size = index.assume %element0, %output_size [ge(%element0, 0), lt(%element0, %output_size)] : index, index
  %gate_noalias, %up_noalias, %output_noalias = buffer.assume.noalias %gate, %up, %output : buffer, buffer, buffer
  %gate_view = buffer.view %gate_noalias[%c0_offset] : buffer -> view<[%token_count]x[%output_size]xf32>
  %up_view = buffer.view %up_noalias[%c0_offset] : buffer -> view<[%token_count]x[%output_size]xf32>
  %output_view = buffer.view %output_noalias[%c0_offset] : buffer -> view<[%token_count]x[%output_size]xf32>
  %gate_value = view.load %gate_view[%token, %element] : view<[%token_count]x[%output_size]xf32> -> f32
  %up_value = view.load %up_view[%token, %element] : view<[%token_count]x[%output_size]xf32> -> f32
  %activated_gate = scalar.siluf<afn> %gate_value : f32
  %result = scalar.mulf<nnan|ninf|nsz> %activated_gate, %up_value : f32
  view.store %result, %output_view[%token, %element] : f32, view<[%token_count]x[%output_size]xf32>
