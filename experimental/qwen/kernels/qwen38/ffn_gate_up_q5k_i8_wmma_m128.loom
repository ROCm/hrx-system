      %tile_result0, %tile_result1, %tile_result2, %tile_result3 = scf.for %activation_group = [%c0 to %c4 step %c1](%next_accumulator0 = %half0_result0 : vector<8xf32>, %next_accumulator1 = %half0_result1 : vector<8xf32>, %next_accumulator2 = %half0_result2 : vector<8xf32>, %next_accumulator3 = %half0_result3 : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) unroll schedule(recurrence) {
