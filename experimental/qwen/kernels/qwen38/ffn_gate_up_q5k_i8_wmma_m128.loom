// Exact paired Q5_K gate/up contraction with 128-token weight reuse.
//
// One workgroup owns 128 tokens by 64 FFN channels. Four wave32 subgroups
// contract gate while four contract up. Every Q5_K tile is staged once and
// reused across two 64-token activation tiles, halving weight traffic relative
// to the M64 schedule. Gate fragments rendezvous with matching up fragments in
// LDS, and the workgroup publishes two 64x64 tiled Q8_1 packets consumed by
// the exact Q6_K down projection.

kernel.decl @ggml_quantize_q8_1_x4_f32(%token_count0: index, %input_size0: index) launch(%token_count1: index, %input_size1: index, %input: buffer, %output: buffer)

kernel.decl @qwen38_linear_q5k_i8_wmma(%token_count0: index) launch(%token_count1: index, %q8_input: buffer, %weight: buffer, %output: buffer)

kernel.decl @qwen38_linear_q6k_i8_wmma_tiled(%token_count0: index) launch(%token_count1: index, %q8_input: buffer, %weight: buffer, %output: buffer)

kernel.decl @qwen38_q5k_i8_wmma_fix_differential_headers() launch(%weight: buffer)

