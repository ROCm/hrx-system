        %next0, %next1, %next2, %next3 = func.call @qwen38_q5k_contract_group(%activation_group, %activation_group, %projection_wave, %lane, %weight_stage, %activation_stage1, %activation_metadata1, %next_accumulator0, %next_accumulator1, %next_accumulator2, %next_accumulator3) : (index, index, index, index, buffer, buffer, buffer, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>)
