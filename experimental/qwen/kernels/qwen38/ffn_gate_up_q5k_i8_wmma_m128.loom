      func.call @qwen38_q8_stage_activation_tile(%token_count, %input_size, %activation_token_base, %q8_group0, %local_workitem, %q8_noalias, %activation_stage0, %activation_metadata0) : (index, index, index, index, index, buffer, buffer, buffer)
