    %stages_weight = index.cmp ult, %workitem, %c256 : index
    scf.if %stages_weight {
      func.call @qwen38_q5k_stage_weight_tile_pair(%input_size, %output_size, %channel_tile_base, %q5_block, %local_workitem, %gate_noalias, %up_noalias, %weight_stage) : (index, index, index, index, index, buffer, buffer, buffer)
    }
    %q8_group0 = index.mul %q5_block, %c2 : index
