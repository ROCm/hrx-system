  %token_count = index.assume %token_count0 [range(%token_count0, 128, 512), mul(%token_count0, 128)] : index
  %output_size = config.get @qwen38.ffn_gate_up_q5k_i8_wmma_m128.output_size : index
  %c1 = index.constant 1 : index
  %c64 = index.constant 64 : index
  %c128 = index.constant 128 : index
  %workgroup_size = index.constant 512 : index
