config.decl @qwen38.ffn_gate_up_q5k_i8_wmma_m128.output_size : %value: index where [range(%value, 64, 32768), mul(%value, 64)]

amdgpu.target<gfx11-generic> @qwen38_ffn_gate_up_q5_i8_m128_wave32 {subgroup_size = 32}

