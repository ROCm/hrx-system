    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %half0_result0, %half0_result1, %half0_result2, %half0_result3 = scf.if %is_token_half0 -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
      %tile_result0, %tile_result1, %tile_result2, %tile_result3 = scf.for %activation_group = [%c0 to %c4 step %c1](%next_accumulator0 = %accumulator0 : vector<8xf32>, %next_accumulator1 = %accumulator1 : vector<8xf32>, %next_accumulator2 = %accumulator2 : vector<8xf32>, %next_accumulator3 = %accumulator3 : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) unroll schedule(recurrence) {
        %next0, %next1, %next2, %next3 = func.call @qwen38_q5k_contract_group(%activation_group, %activation_group, %projection_wave, %lane, %weight_stage, %activation_stage0, %activation_metadata0, %next_accumulator0, %next_accumulator1, %next_accumulator2, %next_accumulator3) : (index, index, index, index, buffer, buffer, buffer, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>)
