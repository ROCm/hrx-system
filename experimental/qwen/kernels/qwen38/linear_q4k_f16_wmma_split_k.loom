  %partials = check.generate.fill value(0.0) : tensor<7x512x48xf32>
  %expected = check.generate.fill value(0.0) : tensor<32x48xf32>
  %actual = check.generate.fill value(0.0) : tensor<32x48xf32>
  kernel.launch @qwen38_q4k_f32_reference_5120[%token_count](%token_count, %input, %weight, %expected) : [index](index, tensor<32x5120xf16>, tensor<48x20x144xi8>, tensor<32x48xf32>)
  kernel.launch @qwen38_linear_q4k_f16_wmma_beta_split_k[%token_count, %input_size, %output_size](%token_count_data, %input_size, %output_size, %input, %weight, %partials) : [index, index, index](tensor<1xi32>, index, index, tensor<32x5120xf16>, tensor<48x20x144xi8>, tensor<7x512x48xf32>)
  kernel.launch @qwen38_linear_q4k_f16_wmma_beta_split_k_reduce[%token_count](%token_count_data, %partials, %actual) : [index](tensor<1xi32>, tensor<7x512x48xf32>, tensor<32x48xf32>)
  check.expect.close actual(%actual) expected(%expected) atol(0.5) rtol(0.02) nan(same) : tensor<32x48xf32>
