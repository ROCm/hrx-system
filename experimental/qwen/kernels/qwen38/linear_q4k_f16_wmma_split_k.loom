  %code_page = index.mul %code_page0, %c8 : index
  %code_lane = index.rem %iqs, %c8 : index
  %code_packet_base = index.add %code_page, %code_lane : index
  %code_index0 = index.add %code_packet_base, %packet_in_half : index
