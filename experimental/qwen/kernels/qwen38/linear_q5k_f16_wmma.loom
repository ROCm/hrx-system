// The issue-time token count controls launch geometry while the matching value
// in token_count_data controls body bounds. Keeping that dynamic scalar in a
// buffer lets one recorded command program serve every prefill length.
kernel.def target(@qwen38_dense_gfx11_wave64) export("qwen38_linear_q5k_f16_wmma") @qwen38_linear_q5k_f16_wmma(%token_count0: index, %input_size0: index, %output_size0: index) {
  %token_count = index.assume %token_count0 [range(%token_count0, 1, 512)] : index
  %input_size = index.assume %input_size0 [range(%input_size0, 256, 32768), mul(%input_size0, 256)] : index
  %output_size = index.assume %output_size0 [range(%output_size0, 1, 32768)] : index
  %c1 = index.constant 1 : index
  %c31 = index.constant 31 : index
  %c32 = index.constant 32 : index
  %c63 = index.constant 63 : index
  %c64 = index.constant 64 : index
  %c128 = index.constant 128 : index
  %padded_output_size = index.add %output_size, %c63 : index
  %output_tiles = index.div %padded_output_size, %c64 : index
  %padded_token_count = index.add %token_count, %c31 : index
  %token_tiles = index.div %padded_token_count, %c32 : index
  kernel.launch.config workgroups(%output_tiles, %token_tiles, %c1) workgroup_size(%c128, %c1, %c1) : index
} launch(%token_count_data: buffer, %input_size0: index, %output_size0: index, %input: buffer, %weight: buffer, %output: buffer) {
  %c0_offset = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %token_count_view = buffer.view %token_count_data[%c0_offset] : buffer -> view<1xi32>
  %token_count_i32 = view.load %token_count_view[%c0] : view<1xi32> -> i32
  %token_count0 = index.cast %token_count_i32 : i32 to index
  %token_count = index.assume %token_count0 [range(%token_count0, 1, 512)] : index
  %input_size = index.assume %input_size0 [range(%input_size0, 256, 32768), mul(%input_size0, 256)] : index
  %output_size = index.assume %output_size0 [range(%output_size0, 1, 32768)] : index
  %channel_tile = kernel.workgroup.id<x> : index
  %token_tile = kernel.workgroup.id<y> : index
  func.apply<qwen38.dense_q5k_f16_wmma.body>(%token_count, %input_size, %output_size, %channel_tile, %token_tile, %input, %weight, %output) : (index, index, index, index, index, buffer, buffer, buffer)
  kernel.return
}

// Uses the existing scalar Q5_K oracle to cover a partial output tile and all
// eight packed scale groups without depending on model data.
check.case public @qwen38_linear_q5k_f16_wmma_differential_case {
  %token_count = check.literal value(1) : index
  %input_size = check.literal value(256) : index
  %output_size = check.literal value(65) : index
  %token_count_data = check.generate.fill value(1) : tensor<1xi32>
  %input = check.generate.iota offset(-0.75) step(0.0078125) : tensor<256xf32>
  %weight = check.generate.fill value(1) : tensor<65x176xi8>
  %expected = check.generate.fill value(0.0) : tensor<65xf32>
