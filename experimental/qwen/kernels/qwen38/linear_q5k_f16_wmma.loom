// Qwen3.8 dense raw-Q5_K prefill projection experiment.
//
// Each two-wave workgroup reuses one 64x32 weight/activation tile across 32
// tokens. The kernel consumes the original GGUF Q5_K bytes and F32
// activations without a persistent repack.

func.decl @ggml_q5k_scale_min(%weight: buffer, %block_byte_base: offset, %group: index) -> (f32, f32)

kernel.decl @ggml_q5k_f32_reference(%input_size$5: index) launch(%input_size$6: index, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @ggml_q5k_fix_differential_headers() launch(%weight: buffer)

kernel.decl @ggml_linear_q5k_q8_1_x4(%token_count: index, %input_size: index, %output_size: index) launch(%token_count$1: index, %input_size$1: index, %output_size$1: index, %input: buffer, %weight: buffer, %output: buffer)

amdgpu.target<gfx11-generic> @qwen38_dense_gfx11_wave64 {subgroup_size = 64}

// Decodes four adjacent Q5_K values directly into the F16 matrix tile. The
// packet coordinate follows logical K order even though GGUF stores the low
// nibbles and high bits in separate physical planes.
func.def inline @qwen38_q5k_f16_vector4(%weight: buffer, %row_byte_base: offset, %q5_block: index, %q5_group: index, %packet: index) -> (vector<4xf16>) {
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %block_bytes = index.constant 176 : offset
  %high_byte_add = index.constant 16 : offset
  %code_byte_add = index.constant 48 : offset
  %one_byte_mask = vector.constant 16843009 : vector<1xi32>
  %nibble_mask = vector.constant 252645135 : vector<1xi32>
  %c4_i32v = vector.constant 4 : vector<1xi32>
  %bounded_group = index.assume %q5_group [range(%q5_group, 0, 7)] : index
  %bounded_packet = index.assume %packet [range(%packet, 0, 7)] : index
  %block_byte_add = index.scale %q5_block, %block_bytes : index, offset -> offset
  %block_byte_base = index.add %row_byte_base, %block_byte_add : offset
  %high_byte_base = index.add %block_byte_base, %high_byte_add : offset
  %code_byte_base = index.add %block_byte_base, %code_byte_add : offset
  %high_view = buffer.view %weight[%high_byte_base] : buffer -> view<8xi32>
  %code_view = buffer.view %weight[%code_byte_base] : buffer -> view<32xi32>
  %half = index.div %bounded_packet, %c4 : index
  %packet_in_half = index.rem %bounded_packet, %c4 : index
  %iqs_group = index.mul %bounded_group, %c8 : index
  %iqs_half = index.mul %half, %c4 : index
  %iqs = index.add %iqs_group, %iqs_half : index
  %code_page0 = index.div %iqs, %c16 : index
  %code_page = index.mul %code_page0, %c8 : index
  %code_lane = index.rem %iqs, %c8 : index
  %code_packet_base = index.add %code_page, %code_lane : index
  %code_index0 = index.add %code_packet_base, %packet_in_half : index
  %code_index = index.assume %code_index0 [range(%code_index0, 0, 31)] : index
  %iqs_mod16 = index.rem %iqs, %c16 : index
  %nibble_page = index.div %iqs_mod16, %c8 : index
  %nibble_shift_index = index.mul %nibble_page, %c4 : index
  %nibble_shift_i32 = index.cast %nibble_shift_index : index to i32
  %nibble_shift = vector.splat %nibble_shift_i32 : vector<1xi32>
  %packed_codes = vector.load %code_view[%code_index] : view<32xi32> -> vector<1xi32>
  %shifted_codes = vector.shrui %packed_codes, %nibble_shift : vector<1xi32>
  %low_codes = vector.andi %shifted_codes, %nibble_mask : vector<1xi32>
  %high_half_base = index.mul %half, %c4 : index
  %high_index = index.add %high_half_base, %packet_in_half : index
  %packed_high = vector.load %high_view[%high_index] : view<8xi32> -> vector<1xi32>
  %group_i32 = index.cast %bounded_group : index to i32
  %group_shift = vector.splat %group_i32 : vector<1xi32>
  %shifted_high = vector.shrui %packed_high, %group_shift : vector<1xi32>
  %high_bit01 = vector.andi %shifted_high, %one_byte_mask : vector<1xi32>
  %high_codes = vector.shli %high_bit01, %c4_i32v : vector<1xi32>
  %q5_word = vector.ori %low_codes, %high_codes : vector<1xi32>
  %q5_values = vector.bitcast %q5_word : vector<1xi32> to vector<4xi8>
  %q5_f32 = vector.uitofp %q5_values : vector<4xi8> to vector<4xf32>
  %d_scale, %dmin_scale = func.call @ggml_q5k_scale_min(%weight, %block_byte_base, %bounded_group) : (buffer, offset, index) -> (f32, f32)
  %d_scale_vector = vector.splat %d_scale : vector<4xf32>
  %dmin_scale_vector = vector.splat %dmin_scale : vector<4xf32>
  %scaled = vector.mulf %q5_f32, %d_scale_vector : vector<4xf32>
  %values_f32 = vector.subf %scaled, %dmin_scale_vector : vector<4xf32>
  %values = vector.fptrunc %values_f32 : vector<4xf32> to vector<4xf16>
  func.return %values : vector<4xf16>
}

func.template<qwen38.dense_q5k_f16_wmma.body> device @qwen38_dense_q5k_f16_wmma_body(%token_count: index, %input_size0: index, %output_size0: index, %channel_tile: index, %token_tile: index, %input: buffer, %weight: buffer, %output: buffer) {
