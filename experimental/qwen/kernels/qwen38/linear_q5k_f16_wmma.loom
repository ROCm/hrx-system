          %row_byte_base = index.cast %channel_byte_index : index to offset
          %decoded = func.call @qwen38_q5k_f16_vector4(%weight_noalias, %row_byte_base, %quant_block, %quant_group, %load_packet) : (buffer, offset, index, index, index) -> (vector<4xf16>)
          scf.yield %decoded : vector<4xf16>
