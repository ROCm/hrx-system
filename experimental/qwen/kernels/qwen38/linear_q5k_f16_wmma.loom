  %metadata_stage_view = buffer.view %metadata_stage[%c0_offset] : buffer -> view<64x8x2xf32>
  %weight_fragment_layout = encoding.layout.strided [1, %c40] : encoding<layout>
  %weight_fragment_view = buffer.view %weight_stage[%c0_offset] : buffer -> view<32x64xf16, %weight_fragment_layout>
  %activation_fragment_layout = encoding.layout.strided [%c40, 1] : encoding<layout>
  %activation_fragment_view = buffer.view %activation_stage[%c0_offset] : buffer -> view<32x32xf16, %activation_fragment_layout>
  %wave_result_stage_offset = index.scale %subgroup, %wave_result_stage_bytes : index, offset -> offset
  %result_fragment_view = buffer.view %result_stage[%wave_result_stage_offset] : buffer -> view<16x16xf32>
  %result_physical_view = buffer.view %result_stage[%wave_result_stage_offset] : buffer -> view<16x16xf32>
  %init0 = vector.fragment<init> %zero_accumulator shape [%m, %n] : vector<4xf32>
  %init1 = vector.fragment<init> %zero_accumulator shape [%m, %n] : vector<4xf32>
  %result0, %result1 = scf.for %quant_block = [%c0 to %quant_block_count step %c1](%block_acc0 = %init0 : vector<4xf32>, %block_acc1 = %init1 : vector<4xf32>) -> (vector<4xf32>, vector<4xf32>) {
    scf.for %metadata_task_offset = [%c0 to %c512 step %c256] unroll {
      %metadata_task0 = index.add %workitem, %metadata_task_offset : index
      %metadata_task = index.assume %metadata_task0 [range(%metadata_task0, 0, 511)] : index
      %metadata_group0 = index.rem %metadata_task, %c8 : index
      %metadata_group = index.assume %metadata_group0 [range(%metadata_group0, 0, 7)] : index
      %metadata_row0 = index.div %metadata_task, %c8 : index
      %metadata_row = index.assume %metadata_row0 [range(%metadata_row0, 0, 63)] : index
      %metadata_channel = index.add %channel_tile_base, %metadata_row : index
      %valid_metadata_channel = index.cmp ult, %metadata_channel, %output_size : index
      %metadata_pair = scf.if %valid_metadata_channel -> (vector<2xf32>) {
        %metadata_channel_byte_index = index.mul %metadata_channel, %weight_row_bytes : index
        %metadata_row_byte_base = index.cast %metadata_channel_byte_index : index to offset
        %metadata_block_byte_add = index.scale %quant_block, %weight_block_bytes : index, offset -> offset
        %metadata_block_byte_base = index.add %metadata_row_byte_base, %metadata_block_byte_add : offset
        %d_scale, %dmin_scale = func.apply<ggml.q5k.scale_min>(%weight_noalias, %metadata_block_byte_base, %metadata_group) : (buffer, offset, index) -> (f32, f32)
        %decoded_pair = vector.from_elements %d_scale, %dmin_scale : vector<2xf32>
        scf.yield %decoded_pair : vector<2xf32>
      } else {
        scf.yield %c0_f32x2 : vector<2xf32>
      }
      vector.store %metadata_pair, %metadata_stage_view[%metadata_row, %metadata_group, %c0] : vector<2xf32>, view<64x8x2xf32>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %block_result0, %block_result1 = scf.for %quant_group = [%c0 to %c8 step %c1](%acc0 = %block_acc0 : vector<4xf32>, %acc1 = %block_acc1 : vector<4xf32>) -> (vector<4xf32>, vector<4xf32>) {
      %block_k_base = index.mul %quant_block, %c256 : index
      %group_k_add = index.mul %quant_group, %c32 : index
      %k_origin = index.add %block_k_base, %group_k_add : index
      %load_packet0 = index.rem %workitem, %c8 : index
      %load_packet = index.assume %load_packet0 [range(%load_packet0, 0, 7)] : index
      %load_k = index.mul %load_packet, %c4 : index
      %load_row_base0 = index.div %workitem, %c8 : index
      %load_row_base = index.assume %load_row_base0 [range(%load_row_base0, 0, 31)] : index
      scf.for %load_row_offset = [%c0 to %c64 step %c32] unroll {
        %load_row0 = index.add %load_row_base, %load_row_offset : index
        %load_row = index.assume %load_row0 [range(%load_row0, 0, 63)] : index
        %channel = index.add %channel_tile_base, %load_row : index
        %valid_channel = index.cmp ult, %channel, %output_size : index
        %weight_values = scf.if %valid_channel -> (vector<4xf16>) {
          %channel_byte_index = index.mul %channel, %weight_row_bytes : index
          %row_byte_base = index.cast %channel_byte_index : index to offset
          %metadata_pair = vector.load %metadata_stage_view[%load_row, %quant_group, %c0] : view<64x8x2xf32> -> vector<2xf32>
          %d_scale = vector.extract %metadata_pair[0] : vector<2xf32> -> f32
          %dmin_scale = vector.extract %metadata_pair[1] : vector<2xf32> -> f32
          %decoded = func.call @qwen38_q5k_f16_vector4_prescaled(%weight_noalias, %row_byte_base, %quant_block, %quant_group, %load_packet, %d_scale, %dmin_scale) : (buffer, offset, index, index, index, f32, f32) -> (vector<4xf16>)
          scf.yield %decoded : vector<4xf16>
        } else {
          scf.yield %c0_f16x4 : vector<4xf16>
        }
        vector.store %weight_values, %weight_stage_view[%load_row, %load_k] : vector<4xf16>, view<64x40xf16>
      }
      %activation_pair0 = index.rem %workitem, %c16 : index
      %activation_pair = index.assume %activation_pair0 [range(%activation_pair0, 0, 15)] : index
      %activation_k = index.mul %activation_pair, %c2 : index
      %activation_row_base0 = index.div %workitem, %c16 : index
      %activation_row_base = index.assume %activation_row_base0 [range(%activation_row_base0, 0, 15)] : index
      scf.for %activation_row_offset = [%c0 to %c32 step %c16] unroll {
        %activation_row0 = index.add %activation_row_base, %activation_row_offset : index
        %activation_row = index.assume %activation_row0 [range(%activation_row0, 0, 31)] : index
        %token0 = index.add %token_tile_base, %activation_row : index
        %token, %input_token_count = index.assume %token0, %token_count [range(%token0, 0, 31), lt(%token0, %token_count)] : index, index
        %input_k0 = index.add %k_origin, %activation_k : index
        %input_k = index.assume %input_k0 [range(%input_k0, 0, 32766), mul(%input_k0, 2), lt(%input_k0, %last_input_pair_start)] : index
        %loaded = vector.load %input_view[%token, %input_k] : view<[%token_count]x[%input_size]xf32> -> vector<2xf32>
        %activation_values = vector.fptrunc %loaded : vector<2xf32> to vector<2xf16>
        vector.store %activation_values, %activation_stage_physical_view[%activation_row, %activation_k] : vector<2xf16>, view<32x40xf16>
      }
      kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
      %next0, %next1 = scf.for %k_half = [%c0 to %c32 step %c16](%half_acc0 = %acc0 : vector<4xf32>, %half_acc1 = %acc1 : vector<4xf32>) -> (vector<4xf32>, vector<4xf32>) unroll {
        %lhs0 = vector.fragment.load<lhs> %activation_fragment_view[%c0, %k_half] shape [%m, %k] : view<32x32xf16, %activation_fragment_layout> -> vector<16xf16>
        %lhs1 = vector.fragment.load<lhs> %activation_fragment_view[%c16, %k_half] shape [%m, %k] : view<32x32xf16, %activation_fragment_layout> -> vector<16xf16>
        %rhs = vector.fragment.load<rhs> %weight_fragment_view[%k_half, %subgroup_channel_add] shape [%k, %n] : view<32x64xf16, %weight_fragment_layout> -> vector<16xf16>
        %half_next0 = vector.mma %lhs0, %rhs, %half_acc0 : vector<16xf16>, vector<16xf16>, vector<4xf32>
        %half_next1 = vector.mma %lhs1, %rhs, %half_acc1 : vector<16xf16>, vector<16xf16>, vector<4xf32>
        scf.yield %half_next0, %half_next1 : vector<4xf32>, vector<4xf32>
      }
      kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
      scf.yield %next0, %next1 : vector<4xf32>, vector<4xf32>
    }
    scf.yield %block_result0, %block_result1 : vector<4xf32>, vector<4xf32>
  }
  %publish_token0 = index.div %lane, %c4 : index
  %publish_token = index.assume %publish_token0 [range(%publish_token0, 0, 15)] : index
  %publish_packet0 = index.rem %lane, %c4 : index
  %publish_packet = index.assume %publish_packet0 [range(%publish_packet0, 0, 3)] : index
  %publish_channel_add = index.mul %publish_packet, %c4 : index
  %token00 = index.add %token_tile_base, %publish_token : index
  %token0 = index.assume %token00 [range(%token00, 0, 15)] : index
  %publish_token1 = index.add %publish_token, %c16 : index
  %token10 = index.add %token_tile_base, %publish_token1 : index
  %token1 = index.assume %token10 [range(%token10, 16, 31)] : index
  %channel0 = index.add %channel_wave_base, %publish_channel_add : index
  %last_channel_packet_start = index.sub %output_size, %c3 : index
  %writes_channel = index.cmp ult, %channel0, %last_channel_packet_start : index
  vector.fragment.store<result> %result0, %result_fragment_view[%c0, %c0] shape [%m, %n] : vector<4xf32>, view<16x16xf32>
  kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
  scf.if %writes_channel {
    %channel = index.assume %channel0 [range(%channel0, 0, 17407), lt(%channel0, %last_channel_packet_start)] : index
    %values0 = vector.load %result_physical_view[%publish_token, %publish_channel_add] : view<16x16xf32> -> vector<4xf32>
    vector.store %values0, %output_view[%token0, %channel] : vector<4xf32>, view<[%token_count]x[%output_size]xf32>
  }
  kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
  vector.fragment.store<result> %result1, %result_fragment_view[%c0, %c0] shape [%m, %n] : vector<4xf32>, view<16x16xf32>
  kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
  scf.if %writes_channel {
    %channel = index.assume %channel0 [range(%channel0, 0, 17407), lt(%channel0, %last_channel_packet_start)] : index
    %values1 = vector.load %result_physical_view[%publish_token, %publish_channel_add] : view<16x16xf32> -> vector<4xf32>
    vector.store %values1, %output_view[%token1, %channel] : vector<4xf32>, view<[%token_count]x[%output_size]xf32>
  }
  kernel.return
}

// Uses the existing scalar Q5_K oracle to cover a partial output tile and all
// eight packed scale groups without depending on model data.
check.case public @qwen38_linear_q5k_f16_wmma_differential_case {
  %token_count = check.literal value(1) : index
  %input_size = check.literal value(256) : index
  %output_size = check.literal value(65) : index
  %token_count_data = check.generate.fill value(1) : tensor<1xi32>
  %input = check.generate.iota offset(-0.75) step(0.0078125) : tensor<256xf32>
  %weight = check.generate.fill value(1) : tensor<65x176xi8>
  %expected = check.generate.fill value(0.0) : tensor<65xf32>
  %actual = check.generate.fill value(0.0) : tensor<65xf32>
  kernel.launch @ggml_q5k_fix_differential_headers(%weight) : (tensor<65x176xi8>)
  kernel.launch @ggml_q5k_f32_reference[%input_size](%input_size, %input, %weight, %expected) : [index](index, tensor<256xf32>, tensor<65x176xi8>, tensor<65xf32>)
  kernel.launch @qwen38_linear_q5k_f16_wmma[%token_count, %input_size, %output_size](%token_count_data, %input_size, %output_size, %input, %weight, %actual) : [index, index, index](tensor<1xi32>, index, index, tensor<256xf32>, tensor<65x176xi8>, tensor<65xf32>)
  check.expect.close actual(%actual) expected(%expected) atol(0.5) rtol(0.02) nan(same) : tensor<65xf32>
  check.return
}

