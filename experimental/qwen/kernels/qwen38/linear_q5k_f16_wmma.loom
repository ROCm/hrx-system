// Covers the GDN alpha projection's 48-channel tail and requires bit-identical
// output from the generic and 32-token schedules.
check.case public @qwen38_linear_q5k_f16_wmma_c64t32_f32acc_alpha_32_case {
  %token_count = check.literal value(32) : index
