  %writes01 = scalar.andi %valid_token1, %valid_channel0 : i1
  %writes10 = scalar.andi %valid_token0, %valid_channel1 : i1
  %writes11 = scalar.andi %valid_token1, %valid_channel1 : i1
  vector.fragment.store<result> %result00, %result_fragment_view[%c0, %c0] shape [%m, %n] : vector<4xf32>, view<16x16xf32, %result_fragment_layout>
  kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
