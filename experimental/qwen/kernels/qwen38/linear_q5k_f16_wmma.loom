func.template<qwen38.dense_q5k_f16_wmma.x128.body> device @qwen38_dense_q5k_f16_wmma_x128_body(%token_count: index, %input_size0: index, %output_size0: index, %channel_tile: index, %token_tile: index, %channel_tile_width: index, %token_tile_width: index, %channel_group_count: index, %workgroup_size: index, %subgroup_count: index, %workitem: index, %subgroup: index, %lane: index, %input: buffer, %weight: buffer, %output: buffer) {
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 512)] : index
  %bounded_input_size = index.assume %input_size0 [range(%input_size0, 256, 32768), mul(%input_size0, 256)] : index
  %bounded_output_size = index.assume %output_size0 [range(%output_size0, 1, 32768)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c40 = index.constant 40 : index
  %c48 = index.constant 48 : index
  %c64 = index.constant 64 : index
  %c128 = index.constant 128 : index
  %c256 = index.constant 256 : index
  %c0_offset = index.constant 0 : offset
  %f16_byte_count = index.constant 2 : offset
  %f32_byte_count = index.constant 4 : offset
  %weight_block_byte_count = index.constant 176 : index
  %weight_block_bytes = index.constant 176 : offset
  %wave_result_stage_bytes = index.constant 1024 : offset
  %weight_stage_elements = index.mul %channel_tile_width, %c40 : index
  %weight_stage_bytes = index.scale %weight_stage_elements, %f16_byte_count : index, offset -> offset
  %activation_stage_elements = index.mul %token_tile_width, %c40 : index
  %activation_stage_bytes = index.scale %activation_stage_elements, %f16_byte_count : index, offset -> offset
  %metadata_stage_elements0 = index.mul %channel_tile_width, %c8 : index
  %metadata_stage_elements = index.mul %metadata_stage_elements0, %c2 : index
