// Elementwise and normalization primitives shared by Qwen3.8 decode layers.
// Quantized projections and attention/GDN state transitions remain in their
// own files so command programs can select and compose them independently.

amdgpu.target<gfx11-generic> @qwen38_layer_gfx11_wave32 {subgroup_size = 32}

// Normalizes one row from a row-major 5120-wide input. Decode provides its
// single row while prefill selects the final active row from its full slab.
func.template<qwen38.rmsnorm_f32.row> device @qwen38_rmsnorm_f32_row(%input_row_count: index, %input_row: index, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer) {
  %lane0 = kernel.workitem.id<x> : index
  %lane = index.assume %lane0 [range(%lane0, 0, 255)] : index
  %workgroup_size = index.constant 256 : index
  %hidden_size = index.constant 5120 : index
  %c0_offset = index.constant 0 : offset
  %c0_f32 = scalar.constant 0.0 : f32
  %input_noalias, %weight_noalias, %output_noalias = buffer.assume.noalias %input, %weight, %output : buffer, buffer, buffer
  %input_view = buffer.view %input_noalias[%c0_offset] : buffer -> view<[%input_row_count]x5120xf32>
  %weight_view = buffer.view %weight_noalias[%c0_offset] : buffer -> view<5120xf32>
  %output_view = buffer.view %output_noalias[%c0_offset] : buffer -> view<5120xf32>
  %thread_sum = scf.for %element = [%lane to %hidden_size step %workgroup_size](%partial_sum = %c0_f32 : f32) -> (f32) {
    %input_value = view.load %input_view[%input_row, %element] : view<[%input_row_count]x5120xf32> -> f32
    %square = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %input_value, %input_value : f32
    %next_sum = scalar.addf<reassoc|nnan|ninf|nsz> %partial_sum, %square : f32
    scf.yield %next_sum : f32
  }
  %sum = kernel.workgroup.reduce<addf> %thread_sum : f32
  %element_count_f32 = scalar.constant 5120.0 : f32
  %mean = scalar.divf<nnan|ninf|nsz|arcp> %sum, %element_count_f32 : f32
  %biased_mean = scalar.addf<nnan|ninf|nsz> %mean, %epsilon : f32
  %inverse_rms = scalar.rsqrtf<nnan|ninf|nsz|afn> %biased_mean : f32
  scf.for %element = [%lane to %hidden_size step %workgroup_size] {
    %input_value = view.load %input_view[%input_row, %element] : view<[%input_row_count]x5120xf32> -> f32
    %weight = view.load %weight_view[%element] : view<5120xf32> -> f32
    %normalized = scalar.mulf<nnan|ninf|nsz> %input_value, %inverse_rms : f32
    %result = scalar.mulf<nnan|ninf|nsz> %normalized, %weight : f32
    view.store %result, %output_view[%element] : f32, view<5120xf32>
  }
  func.return
}

// Computes one exact 5120-wide F32 RMSNorm row. Each lane owns 20 strided
// values so adjacent lanes issue coalesced accesses while preserving the
// contribution order shared with prefill and speculative verification.
kernel.def target(@qwen38_layer_gfx11_wave32) export("qwen38_rmsnorm_f32_decode") @qwen38_rmsnorm_f32_decode() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%epsilon: f32, %input: buffer, %weight: buffer, %output: buffer) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  func.apply<qwen38.rmsnorm_f32.row>(%c1, %c0, %epsilon, %input, %weight, %output) : (index, index, f32, buffer, buffer, buffer)
  kernel.return
}

// Selects the final active prefill row from control[0] without baking a
// prompt-specific residual offset into the reusable command buffer.
kernel.def target(@qwen38_layer_gfx11_wave32) export("qwen38_rmsnorm_f32_prefill_last") @qwen38_rmsnorm_f32_prefill_last() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%control: buffer, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c0_offset = index.constant 0 : offset
  %c512 = index.constant 512 : index
  %control_view = buffer.view %control[%c0_offset] : buffer -> view<2xi32>
  %token_count_i32 = view.load %control_view[%c0] : view<2xi32> -> i32
  %token_count0 = index.cast %token_count_i32 : i32 to index
  %token_count = index.assume %token_count0 [range(%token_count0, 1, 512)] : index
  %last_token0 = index.sub %token_count, %c1 : index
  %last_token = index.assume %last_token0 [range(%last_token0, 0, 511)] : index
  func.apply<qwen38.rmsnorm_f32.row>(%c512, %last_token, %epsilon, %input, %weight, %output) : (index, index, f32, buffer, buffer, buffer)
  kernel.return
}

// Adds one projection result into its residual stream. Four adjacent F32
// elements travel together so the common 5120-wide boundary launches only
// five workgroups.
kernel.def export("qwen38_residual_add_f32_decode") @qwen38_residual_add_f32_decode() {
  %c1 = index.constant 1 : index
  %workgroup_count = index.constant 5 : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%workgroup_count, %c1, %c1) workgroup_size(%workgroup_size, %c1, %c1) : index
} launch(%lhs: buffer, %rhs: buffer, %output: buffer) {
  %workgroup = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %c4 = index.constant 4 : index
  %workgroup_size = index.constant 256 : index
  %c0_offset = index.constant 0 : offset
  %workgroup_base = index.mul %workgroup, %workgroup_size : index
  %vector_ordinal = index.add %workgroup_base, %lane : index
  %element0 = index.mul %vector_ordinal, %c4 : index
  %element = index.assume %element0 [range(%element0, 0, 5116), mul(%element0, 4)] : index
  %lhs_view = buffer.view %lhs[%c0_offset] : buffer -> view<5120xf32>
  %rhs_view = buffer.view %rhs[%c0_offset] : buffer -> view<5120xf32>
  %output_view = buffer.view %output[%c0_offset] : buffer -> view<5120xf32>
  %lhs_values = vector.load %lhs_view[%element] : view<5120xf32> -> vector<4xf32>
  %rhs_values = vector.load %rhs_view[%element] : view<5120xf32> -> vector<4xf32>
  %result = vector.addf<nnan|ninf|nsz> %lhs_values, %rhs_values : vector<4xf32>
  vector.store %result, %output_view[%element] : vector<4xf32>, view<5120xf32>
  kernel.return
}

// Applies SwiGLU to paired gate and up projections. This ordinary F32 boundary
// is the correctness baseline; a later schedule may fuse Q8 publication when
// the command-program trace proves that extra materialization is significant.
kernel.def export("qwen38_swiglu_f32_decode") @qwen38_swiglu_f32_decode() {
  %c1 = index.constant 1 : index
  %workgroup_count = index.constant 68 : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%workgroup_count, %c1, %c1) workgroup_size(%workgroup_size, %c1, %c1) : index
} launch(%gate: buffer, %up: buffer, %output: buffer) {
  %workgroup = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %workgroup_size = index.constant 256 : index
  %c0_offset = index.constant 0 : offset
  %workgroup_base = index.mul %workgroup, %workgroup_size : index
  %element0 = index.add %workgroup_base, %lane : index
  %element = index.assume %element0 [range(%element0, 0, 17407)] : index
  %gate_view = buffer.view %gate[%c0_offset] : buffer -> view<17408xf32>
  %up_view = buffer.view %up[%c0_offset] : buffer -> view<17408xf32>
  %output_view = buffer.view %output[%c0_offset] : buffer -> view<17408xf32>
  %gate_value = view.load %gate_view[%element] : view<17408xf32> -> f32
  %up_value = view.load %up_view[%element] : view<17408xf32> -> f32
  %activated_gate = scalar.siluf<afn> %gate_value : f32
  %result = scalar.mulf<nnan|ninf|nsz> %activated_gate, %up_value : f32
  view.store %result, %output_view[%element] : f32, view<17408xf32>
  kernel.return
}

check.case public @qwen38_rmsnorm_f32_decode_known_case {
  %epsilon = check.literal value(0.000001) : f32
  %input = check.generate.fill value(2.0) : tensor<5120xf32>
  %weight = check.generate.fill value(0.5) : tensor<5120xf32>
  %output = check.generate.fill value(0.0) : tensor<5120xf32>
  %expected = check.generate.fill value(0.49999994) : tensor<5120xf32>
  kernel.launch @qwen38_rmsnorm_f32_decode(%epsilon, %input, %weight, %output) : (f32, tensor<5120xf32>, tensor<5120xf32>, tensor<5120xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.000001) rtol(0.000001) nan(same) : tensor<5120xf32>
  check.return
}

check.case public @qwen38_residual_add_f32_decode_known_case {
  %lhs = check.generate.fill value(0.125) : tensor<5120xf32>
  %rhs = check.generate.fill value(-0.0625) : tensor<5120xf32>
  %output = check.generate.fill value(0.0) : tensor<5120xf32>
  %expected = check.generate.fill value(0.0625) : tensor<5120xf32>
  kernel.launch @qwen38_residual_add_f32_decode(%lhs, %rhs, %output) : (tensor<5120xf32>, tensor<5120xf32>, tensor<5120xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<5120xf32>
  check.return
}

check.case public @qwen38_swiglu_f32_decode_known_case {
  %gate = check.generate.fill value(0.25) : tensor<17408xf32>
  %up = check.generate.fill value(0.5) : tensor<17408xf32>
  %output = check.generate.fill value(0.0) : tensor<17408xf32>
  %expected = check.generate.fill value(0.07027235627174377) : tensor<17408xf32>
  kernel.launch @qwen38_swiglu_f32_decode(%gate, %up, %output) : (tensor<17408xf32>, tensor<17408xf32>, tensor<17408xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.000001) rtol(0.000001) nan(same) : tensor<17408xf32>
  check.return
}

check.case public @qwen38_layer_decode_primitives_known_case {
  %epsilon = check.literal value(0.000001) : f32
  %norm_input = check.generate.fill value(2.0) : tensor<5120xf32>
  %norm_weight = check.generate.fill value(0.5) : tensor<5120xf32>
  %normalized = check.generate.fill value(0.0) : tensor<5120xf32>
  %expected_normalized = check.generate.fill value(0.49999994) : tensor<5120xf32>
  kernel.launch @qwen38_rmsnorm_f32_decode(%epsilon, %norm_input, %norm_weight, %normalized) : (f32, tensor<5120xf32>, tensor<5120xf32>, tensor<5120xf32>)
  check.expect.close actual(%normalized) expected(%expected_normalized) atol(0.000001) rtol(0.000001) nan(same) : tensor<5120xf32>

  %lhs = check.generate.fill value(0.125) : tensor<5120xf32>
  %rhs = check.generate.fill value(-0.0625) : tensor<5120xf32>
  %sum = check.generate.fill value(0.0) : tensor<5120xf32>
  %expected_sum = check.generate.fill value(0.0625) : tensor<5120xf32>
  kernel.launch @qwen38_residual_add_f32_decode(%lhs, %rhs, %sum) : (tensor<5120xf32>, tensor<5120xf32>, tensor<5120xf32>)
  check.expect.close actual(%sum) expected(%expected_sum) atol(0.0) rtol(0.0) nan(same) : tensor<5120xf32>

  %gate = check.generate.fill value(0.25) : tensor<17408xf32>
  %up = check.generate.fill value(0.5) : tensor<17408xf32>
  %swiglu = check.generate.fill value(0.0) : tensor<17408xf32>
  %expected_swiglu = check.generate.fill value(0.07027235627174377) : tensor<17408xf32>
  kernel.launch @qwen38_swiglu_f32_decode(%gate, %up, %swiglu) : (tensor<17408xf32>, tensor<17408xf32>, tensor<17408xf32>)
  check.expect.close actual(%swiglu) expected(%expected_swiglu) atol(0.000001) rtol(0.000001) nan(same) : tensor<17408xf32>
  check.return
}

check.benchmark<@qwen38_layer_decode_primitives_known_case> @qwen38_layer_decode_primitives
