// Device-resident control for bounded Qwen3.8 NextN/MTP generation.
//
// The draft model proposes a specialization-time number of tokens from the
// target model's pending token and normalized hidden row. The target model then
// verifies the causal input span [y0, d1, ...]. Acceptance publishes the
// longest matching draft prefix plus one target correction, or every draft on
// a full match.

// Initializes one proposal from the target model's pending token, position,
// and normalized hidden row. Draft steps mutate their private hidden copy so
// target verification can still pair its first row with the committed carry.
kernel.def export("qwen38_mtp_begin") @qwen38_mtp_begin(%draft_depth0: index) {
  %draft_depth = index.assume %draft_depth0 [range(%draft_depth0, 1, 8)] : index
  %workgroup_count = index.constant 5 : index
  %workgroup_size = index.constant 256 : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%workgroup_count, %c1, %c1) workgroup_size(%workgroup_size, %c1, %c1) : index
} launch(%draft_depth0: index, %target_control: buffer, %target_tokens: buffer, %target_hidden: buffer, %mtp_control: buffer, %current_token: buffer, %draft_hidden: buffer, %verify_tokens: buffer) {
  %draft_depth = index.assume %draft_depth0 [range(%draft_depth0, 1, 8)] : index
  %workgroup0 = kernel.workgroup.id<x> : index
  %workgroup = index.assume %workgroup0 [range(%workgroup0, 0, 4)] : index
  %workitem0 = kernel.workitem.id<x> : index
  %workitem = index.assume %workitem0 [range(%workitem0, 0, 255)] : index
  %c0 = index.constant 0 : index
  %c4 = index.constant 4 : index
  %workgroup_size = index.constant 256 : index
  %c0_offset = index.constant 0 : offset
  %target_hidden_noalias, %draft_hidden_noalias = buffer.assume.noalias %target_hidden, %draft_hidden : buffer, buffer
  %target_hidden_view = buffer.view %target_hidden_noalias[%c0_offset] : buffer -> view<5120xf32>
  %draft_hidden_view = buffer.view %draft_hidden_noalias[%c0_offset] : buffer -> view<5120xf32>
  %vector_ordinal0 = index.mul %workgroup, %workgroup_size : index
  %vector_ordinal = index.add %vector_ordinal0, %workitem : index
  %element0 = index.mul %vector_ordinal, %c4 : index
  %element = index.assume %element0 [range(%element0, 0, 5116), mul(%element0, 4)] : index
  %hidden_values = vector.load %target_hidden_view[%element] : view<5120xf32> -> vector<4xf32>
  vector.store %hidden_values, %draft_hidden_view[%element] : vector<4xf32>, view<5120xf32>

  %is_workgroup_zero = index.cmp eq, %workgroup, %c0 : index
  %is_workitem_zero = index.cmp eq, %workitem, %c0 : index
  %is_control_thread = scalar.andi %is_workgroup_zero, %is_workitem_zero : i1
  scf.if %is_control_thread {
    %target_control_view = buffer.view %target_control[%c0_offset] : buffer -> view<2xi32>
    %target_tokens_view = buffer.view %target_tokens[%c0_offset] : buffer -> view<129xi32>
    %mtp_control_view = buffer.view %mtp_control[%c0_offset] : buffer -> view<2xi32>
    %current_token_view = buffer.view %current_token[%c0_offset] : buffer -> view<1xi32>
    %verify_tokens_view = buffer.view %verify_tokens[%c0_offset] : buffer -> view<[%draft_depth]xi32>
    %position = view.load %target_control_view[0] : view<2xi32> -> i32
    %pending_token = view.load %target_tokens_view[0] : view<129xi32> -> i32
    %c0_i32 = scalar.constant 0 : i32
    view.store %position, %mtp_control_view[0] : i32, view<2xi32>
    view.store %c0_i32, %mtp_control_view[1] : i32, view<2xi32>
    view.store %pending_token, %current_token_view[0] : i32, view<1xi32>
    view.store %pending_token, %verify_tokens_view[0] : i32, view<[%draft_depth]xi32>
  }
  kernel.return
}

// Records one produced draft token and advances the private draft position.
// Every draft except the last also becomes a target verification input.
kernel.def export("qwen38_mtp_commit_draft") @qwen38_mtp_commit_draft(%draft_depth0: index) {
  %draft_depth = index.assume %draft_depth0 [range(%draft_depth0, 1, 8)] : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%draft_depth0: index, %mtp_control: buffer, %current_token: buffer, %draft_tokens: buffer, %verify_tokens: buffer) {
  %draft_depth = index.assume %draft_depth0 [range(%draft_depth0, 1, 8)] : index
  %c0_offset = index.constant 0 : offset
  %mtp_control_view = buffer.view %mtp_control[%c0_offset] : buffer -> view<2xi32>
  %current_token_view = buffer.view %current_token[%c0_offset] : buffer -> view<1xi32>
  %draft_tokens_view = buffer.view %draft_tokens[%c0_offset] : buffer -> view<[%draft_depth]xi32>
  %verify_tokens_view = buffer.view %verify_tokens[%c0_offset] : buffer -> view<[%draft_depth]xi32>
  %position = view.load %mtp_control_view[0] : view<2xi32> -> i32
  %draft_count_i32 = view.load %mtp_control_view[1] : view<2xi32> -> i32
  %draft_count0 = index.cast %draft_count_i32 : i32 to index
  %draft_count = index.assume %draft_count0 [range(%draft_count0, 0, 7), lt(%draft_count0, %draft_depth)] : index
  %draft_token = view.load %current_token_view[0] : view<1xi32> -> i32
  view.store %draft_token, %draft_tokens_view[%draft_count] : i32, view<[%draft_depth]xi32>
  %c1 = index.constant 1 : index
  %next_draft_index0 = index.add %draft_count, %c1 : index
  %next_draft_index = index.assume %next_draft_index0 [range(%next_draft_index0, 1, 8)] : index
  %has_verify_input = index.cmp ult, %next_draft_index, %draft_depth : index
  scf.if %has_verify_input {
    %verify_index = index.assume %next_draft_index [range(%next_draft_index, 1, 7), lt(%next_draft_index, %draft_depth)] : index
    view.store %draft_token, %verify_tokens_view[%verify_index] : i32, view<[%draft_depth]xi32>
  }
  %c1_i32 = scalar.constant 1 : i32
  %next_position = scalar.addi %position, %c1_i32 : i32
  %next_draft_count = scalar.addi %draft_count_i32, %c1_i32 : i32
  view.store %next_position, %mtp_control_view[0] : i32, view<2xi32>
  view.store %next_draft_count, %mtp_control_view[1] : i32, view<2xi32>
  kernel.return
}

// Initializes the target verification span at the current target position.
// This buffer uses the prefill control ABI.
kernel.def export("qwen38_mtp_begin_verify") @qwen38_mtp_begin_verify(%draft_depth0: index) {
  %draft_depth = index.assume %draft_depth0 [range(%draft_depth0, 1, 8)] : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%draft_depth0: index, %target_control: buffer, %verify_control: buffer) {
  %draft_depth = index.assume %draft_depth0 [range(%draft_depth0, 1, 8)] : index
  %c0_offset = index.constant 0 : offset
  %target_control_view = buffer.view %target_control[%c0_offset] : buffer -> view<2xi32>
  %verify_control_view = buffer.view %verify_control[%c0_offset] : buffer -> view<2xi32>
  %position = view.load %target_control_view[0] : view<2xi32> -> i32
  %draft_depth_i32 = index.cast %draft_depth : index to i32
  view.store %draft_depth_i32, %verify_control_view[0] : i32, view<2xi32>
  view.store %position, %verify_control_view[1] : i32, view<2xi32>
  kernel.return
}

// Accepts the longest draft prefix matching target predictions. The target
// control is advanced by the emitted token count, while replay_control retains
// the old position and uses the prefill ABI [token_count, position_base].
kernel.def export("qwen38_mtp_accept") @qwen38_mtp_accept(%draft_depth0: index) {
  %draft_depth = index.assume %draft_depth0 [range(%draft_depth0, 1, 8)] : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%draft_depth0: index, %draft_tokens: buffer, %target_predictions: buffer, %target_control: buffer, %target_tokens: buffer, %replay_control: buffer, %acceptance: buffer, %progress: buffer) {
  %draft_depth = index.assume %draft_depth0 [range(%draft_depth0, 1, 8)] : index
  %c0_offset = index.constant 0 : offset
  %draft_view = buffer.view %draft_tokens[%c0_offset] : buffer -> view<[%draft_depth]xi32>
  %target_view = buffer.view %target_predictions[%c0_offset] : buffer -> view<[%draft_depth]xi32>
  %control_view = buffer.view %target_control[%c0_offset] : buffer -> view<3xi32>
  %tokens_view = buffer.view %target_tokens[%c0_offset] : buffer -> view<129xi32>
  %replay_view = buffer.view %replay_control[%c0_offset] : buffer -> view<2xi32>
  %acceptance_view = buffer.view %acceptance[%c0_offset] : buffer -> view<2xi32>
  %progress_view = buffer.view %progress[%c0_offset] : buffer -> view<30xi32>

  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %accepted0, %full_match_index = scf.for %ordinal = [%c0 to %draft_depth step %c1](%prefix_count = %c0 : index, %prefix_matches = %c1 : index) -> (index, index) {
    %draft_ordinal = index.assume %ordinal [range(%ordinal, 0, 7), lt(%ordinal, %draft_depth)] : index
    %bounded_prefix_count = index.assume %prefix_count [range(%prefix_count, 0, 8), le(%prefix_count, %draft_depth)] : index
    %draft_token = view.load %draft_view[%draft_ordinal] : view<[%draft_depth]xi32> -> i32
    %target_token = view.load %target_view[%draft_ordinal] : view<[%draft_depth]xi32> -> i32
    %token_matches = scalar.cmpi eq, %draft_token, %target_token : i32
    %prefix_matches_bool = index.cmp ne, %prefix_matches, %c0 : index
    %prefix_still_matches = scalar.andi %prefix_matches_bool, %token_matches : i1
    %increment = scf.select %prefix_still_matches, %c1, %c0 : index
    %next_prefix_count0 = index.add %bounded_prefix_count, %increment : index
    %next_prefix_count = index.assume %next_prefix_count0 [range(%next_prefix_count0, 0, 8), le(%next_prefix_count0, %draft_depth)] : index
    %next_prefix_matches = scf.select %prefix_still_matches, %c1, %c0 : index
    scf.yield %next_prefix_count, %next_prefix_matches : index, index
  }
  %accepted = index.assume %accepted0 [range(%accepted0, 0, 8), le(%accepted0, %draft_depth)] : index
  %full_match = index.cmp ne, %full_match_index, %c0 : index
  %corrected_count = index.add %accepted, %c1 : index
  %candidate_commit_count0 = scf.select %full_match, %draft_depth, %corrected_count : index
  %candidate_commit_count = index.assume %candidate_commit_count0 [range(%candidate_commit_count0, 1, 8), le(%candidate_commit_count0, %draft_depth)] : index

  %position = view.load %control_view[0] : view<3xi32> -> i32
  %generated_count_i32 = view.load %control_view[1] : view<3xi32> -> i32
  %eos_token = view.load %control_view[2] : view<3xi32> -> i32
  %generated_count0 = index.cast %generated_count_i32 : i32 to index
  %generated_count = index.assume %generated_count0 [range(%generated_count0, 0, 120)] : index
  %draft_last = index.sub %draft_depth, %c1 : index
  %target_index0 = scf.select %full_match, %draft_last, %accepted : index
  %target_index = index.assume %target_index0 [range(%target_index0, 0, 7), lt(%target_index0, %draft_depth)] : index
  %target_correction = view.load %target_view[%target_index] : view<[%draft_depth]xi32> -> i32

  // Verification may match beyond the turn terminator because all target rows
  // execute together. Keep only the prefix through the first EOS so every
  // persistent state remains positioned immediately before that pending EOS.
  %commit_count0, %done_index = scf.for %ordinal = [%c0 to %candidate_commit_count step %c1](%current_commit_count = %candidate_commit_count : index, %found_eos = %c0 : index) -> (index, index) {
    %candidate_ordinal = index.assume %ordinal [range(%ordinal, 0, 7), lt(%ordinal, %candidate_commit_count), lt(%ordinal, %draft_depth)] : index
    %uses_draft = index.cmp ult, %candidate_ordinal, %accepted : index
    %draft_token = view.load %draft_view[%candidate_ordinal] : view<[%draft_depth]xi32> -> i32
    %emitted = scf.select %uses_draft, %draft_token, %target_correction : i32
    %is_eos = scalar.cmpi eq, %emitted, %eos_token : i32
    %eos_count = index.add %candidate_ordinal, %c1 : index
    %eos_commit_count = scf.select %is_eos, %eos_count, %current_commit_count : index
    %next_commit_count = index.min %current_commit_count, %eos_commit_count : index
    %found_eos_bool = index.cmp ne, %found_eos, %c0 : index
    %next_found_eos_bool = scalar.ori %found_eos_bool, %is_eos : i1
    %next_found_eos = scf.select %next_found_eos_bool, %c1, %c0 : index
    scf.yield %next_commit_count, %next_found_eos : index, index
  }
  %commit_count = index.assume %commit_count0 [range(%commit_count0, 1, 8), le(%commit_count0, %draft_depth)] : index
  %done = index.cmp ne, %done_index, %c0 : index
  %committed_accepted0 = index.min %accepted, %commit_count : index
  %committed_accepted = index.assume %committed_accepted0 [range(%committed_accepted0, 0, 8), le(%committed_accepted0, %draft_depth)] : index
  scf.for %ordinal = [%c0 to %commit_count step %c1] {
    %draft_index = index.assume %ordinal [range(%ordinal, 0, 7), lt(%ordinal, %draft_depth)] : index
    %uses_draft = index.cmp ult, %draft_index, %committed_accepted : index
    %draft_value = view.load %draft_view[%draft_index] : view<[%draft_depth]xi32> -> i32
    %emitted = scf.select %uses_draft, %draft_value, %target_correction : i32
    %history_add0 = index.add %draft_index, %c1 : index
    %history_add = index.assume %history_add0 [range(%history_add0, 1, 8)] : index
    %history_index0 = index.add %generated_count, %history_add : index
    %history_index = index.assume %history_index0 [range(%history_index0, 1, 128)] : index
    view.store %emitted, %tokens_view[%history_index] : i32, view<129xi32>
  }
  %pending_index0 = index.add %generated_count, %commit_count : index
  %pending_index = index.assume %pending_index0 [range(%pending_index0, 1, 128)] : index
  %pending_token = view.load %tokens_view[%pending_index] : view<129xi32> -> i32
  view.store %pending_token, %tokens_view[0] : i32, view<129xi32>

  %commit_count_i32 = index.cast %commit_count : index to i32
  %accepted_i32 = index.cast %committed_accepted : index to i32
  %next_position = scalar.addi %position, %commit_count_i32 : i32
  %next_generated_count = scalar.addi %generated_count_i32, %commit_count_i32 : i32
  view.store %next_position, %control_view[0] : i32, view<3xi32>
  view.store %next_generated_count, %control_view[1] : i32, view<3xi32>
  view.store %commit_count_i32, %replay_view[0] : i32, view<2xi32>
  view.store %position, %replay_view[1] : i32, view<2xi32>
  view.store %accepted_i32, %acceptance_view[0] : i32, view<2xi32>
  view.store %commit_count_i32, %acceptance_view[1] : i32, view<2xi32>

  // Publish cumulative progress for batched host scheduling. This buffer is
  // host-local/device-visible, but no host observes it until the timeline
  // semaphore for an entire queued batch has completed.
  %accepted_total = view.load %progress_view[1] : view<30xi32> -> i32
  %next_accepted_total = scalar.addi %accepted_total, %accepted_i32 : i32
  %depth_index0 = index.add %committed_accepted, %c2 : index
  %depth_index = index.assume %depth_index0 [range(%depth_index0, 2, 10)] : index
  %depth_count = view.load %progress_view[%depth_index] : view<30xi32> -> i32
  %c1_i32 = scalar.constant 1 : i32
  %next_depth_count = scalar.addi %depth_count, %c1_i32 : i32
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32_done = scalar.constant 1 : i32
  %done_i32 = scf.select %done, %c1_i32_done, %c0_i32 : i32
  view.store %next_generated_count, %progress_view[0] : i32, view<30xi32>
  view.store %next_accepted_total, %progress_view[1] : i32, view<30xi32>
  view.store %next_depth_count, %progress_view[%depth_index] : i32, view<30xi32>
  view.store %done_i32, %progress_view[11] : i32, view<30xi32>
  %draft_trace_base = index.constant 12 : index
  %target_trace_base = index.constant 20 : index
  scf.for %ordinal = [%c0 to %draft_depth step %c1] {
    %trace_ordinal = index.assume %ordinal [range(%ordinal, 0, 7), lt(%ordinal, %draft_depth)] : index
    %draft = view.load %draft_view[%trace_ordinal] : view<[%draft_depth]xi32> -> i32
    %target = view.load %target_view[%trace_ordinal] : view<[%draft_depth]xi32> -> i32
    %draft_trace_index = index.add %draft_trace_base, %trace_ordinal : index
    %target_trace_index = index.add %target_trace_base, %trace_ordinal : index
    view.store %draft, %progress_view[%draft_trace_index] : i32, view<30xi32>
    view.store %target, %progress_view[%target_trace_index] : i32, view<30xi32>
  }
  %accepted_trace_index = index.constant 28 : index
  %commit_trace_index = index.constant 29 : index
  view.store %accepted_i32, %progress_view[%accepted_trace_index] : i32, view<30xi32>
  view.store %commit_count_i32, %progress_view[%commit_trace_index] : i32, view<30xi32>
  kernel.return
}

// Publishes the normalized target hidden row immediately preceding the next
// pending token. The acceptance record guarantees a row within draft depth.
kernel.def export("qwen38_mtp_select_hidden") @qwen38_mtp_select_hidden(%draft_depth0: index) {
  %draft_depth = index.assume %draft_depth0 [range(%draft_depth0, 1, 8)] : index
  %workgroup_count = index.constant 5 : index
  %workgroup_size = index.constant 256 : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%workgroup_count, %c1, %c1) workgroup_size(%workgroup_size, %c1, %c1) : index
} launch(%draft_depth0: index, %normalized_rows: buffer, %acceptance: buffer, %normalized_hidden: buffer) {
  %draft_depth = index.assume %draft_depth0 [range(%draft_depth0, 1, 8)] : index
  %workgroup = kernel.workgroup.id<x> : index
  %workitem = kernel.workitem.id<x> : index
  %workgroup_size = index.constant 256 : index
  %c4 = index.constant 4 : index
  %vector_ordinal0 = index.mul %workgroup, %workgroup_size : index
  %vector_ordinal = index.add %vector_ordinal0, %workitem : index
  %element0 = index.mul %vector_ordinal, %c4 : index
  %element = index.assume %element0 [range(%element0, 0, 5116), mul(%element0, 4)] : index
  %c0_offset = index.constant 0 : offset
  %rows_view = buffer.view %normalized_rows[%c0_offset] : buffer -> view<[%draft_depth]x5120xf32>
  %acceptance_view = buffer.view %acceptance[%c0_offset] : buffer -> view<2xi32>
  %hidden_view = buffer.view %normalized_hidden[%c0_offset] : buffer -> view<5120xf32>
  %commit_count_i32 = view.load %acceptance_view[1] : view<2xi32> -> i32
  %commit_count0 = index.cast %commit_count_i32 : i32 to index
  %commit_count = index.assume %commit_count0 [range(%commit_count0, 1, 8), le(%commit_count0, %draft_depth)] : index
  %c1 = index.constant 1 : index
  %row0 = index.sub %commit_count, %c1 : index
  %row = index.assume %row0 [range(%row0, 0, 7), lt(%row0, %draft_depth)] : index
  %values = vector.load %rows_view[%row, %element] : view<[%draft_depth]x5120xf32> -> vector<4xf32>
  vector.store %values, %hidden_view[%element] : vector<4xf32>, view<5120xf32>
  kernel.return
}

// Test-only observers keep the production token-history ABI intact while
// allowing each committed prefix and pending token to be checked directly.
kernel.def @qwen38_mtp_read_committed(%token_count0: index) {
  %token_count = index.assume %token_count0 [range(%token_count0, 1, 4)] : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%token_count, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%token_count0: index, %tokens: buffer, %committed: buffer) {
  %token_count = index.assume %token_count0 [range(%token_count0, 1, 4)] : index
  %ordinal0 = kernel.workgroup.id<x> : index
  %ordinal = index.assume %ordinal0 [lt(%ordinal0, %token_count)] : index
  %c1 = index.constant 1 : index
  %history_index0 = index.add %ordinal, %c1 : index
  %history_index = index.assume %history_index0 [range(%history_index0, 1, 4)] : index
  %c0_offset = index.constant 0 : offset
  %tokens_view = buffer.view %tokens[%c0_offset] : buffer -> view<129xi32>
  %committed_view = buffer.view %committed[%c0_offset] : buffer -> view<[%token_count]xi32>
  %token = view.load %tokens_view[%history_index] : view<129xi32> -> i32
  view.store %token, %committed_view[%ordinal] : i32, view<[%token_count]xi32>
  kernel.return
}

kernel.def @qwen38_mtp_read_pending() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%tokens: buffer, %pending: buffer) {
  %c0_offset = index.constant 0 : offset
  %tokens_view = buffer.view %tokens[%c0_offset] : buffer -> view<129xi32>
  %pending_view = buffer.view %pending[%c0_offset] : buffer -> view<1xi32>
  %token = view.load %tokens_view[0] : view<129xi32> -> i32
  view.store %token, %pending_view[0] : i32, view<1xi32>
  kernel.return
}

// Exercises proposal initialization, four draft commits, every acceptance
// length, and selected-hidden publication as one production-shaped case.
check.case public @qwen38_mtp_control_depth4_case {
  %c4 = check.literal value(4) : index
  %target_control0 = check.generate.iota offset(100) step(-99) : tensor<2xi32>
  %target_tokens0 = check.generate.fill value(0) : tensor<129xi32>
  %target_hidden0 = check.generate.iota offset(-2560.0) step(1.0) : tensor<5120xf32>
  %mtp_control = check.generate.fill value(-1) : tensor<2xi32>
  %current_token0 = check.generate.fill value(-1) : tensor<1xi32>
  %draft_hidden0 = check.generate.fill value(0.0) : tensor<5120xf32>
  %verify_tokens0 = check.generate.fill value(-1) : tensor<4xi32>
  kernel.launch @qwen38_mtp_begin[%c4](%c4, %target_control0, %target_tokens0, %target_hidden0, %mtp_control, %current_token0, %draft_hidden0, %verify_tokens0) : [index](index, tensor<2xi32>, tensor<129xi32>, tensor<5120xf32>, tensor<2xi32>, tensor<1xi32>, tensor<5120xf32>, tensor<4xi32>)
