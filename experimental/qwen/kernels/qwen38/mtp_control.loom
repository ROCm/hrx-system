// Covers the first acceptance length unavailable to the depth-four verifier.
// Five matching drafts commit those drafts followed by target row five, and
// every state/progress consumer observes the resulting six-token prefix.
check.case public @qwen38_mtp_control_depth8_accept5_case {
  %depth = check.literal value(8) : index
  %drafts = check.generate.iota offset(10) step(1) period(5) : tensor<8xi32>
  %targets = check.generate.iota offset(10) step(1) : tensor<8xi32>
  %target_row5 = check.generate.fill value(15) : tensor<1xi32>
  %control = check.generate.iota offset(100) step(-100) : tensor<3xi32>
  %tokens = check.generate.fill value(-1) : tensor<129xi32>
  %replay = check.generate.fill value(-1) : tensor<2xi32>
  %acceptance = check.generate.fill value(-1) : tensor<2xi32>
  %progress = check.generate.fill value(0) : tensor<30xi32>
  kernel.launch @qwen38_mtp_accept[%depth](%depth, %drafts, %targets, %control, %tokens, %replay, %acceptance, %progress) : [index](index, tensor<8xi32>, tensor<8xi32>, tensor<3xi32>, tensor<129xi32>, tensor<2xi32>, tensor<2xi32>, tensor<30xi32>)

  %committed = check.tensor.view %tokens offset(4) : tensor<129xi32> -> tensor<6xi32>
  %pending = check.tensor.view %tokens offset(0) : tensor<129xi32> -> tensor<1xi32>
  %control_pair = check.tensor.view %control offset(0) : tensor<3xi32> -> tensor<2xi32>
  %progress_header = check.tensor.view %progress offset(0) : tensor<30xi32> -> tensor<2xi32>
  %depth5_count = check.tensor.view %progress offset(28) : tensor<30xi32> -> tensor<1xi32>
  %expected_committed_prefix = check.generate.iota offset(10) step(1) : tensor<5xi32>
  %actual_committed_prefix = check.tensor.view %committed offset(0) : tensor<6xi32> -> tensor<5xi32>
  %actual_correction = check.tensor.view %committed offset(20) : tensor<6xi32> -> tensor<1xi32>
  %expected_control = check.generate.iota offset(106) step(-100) : tensor<2xi32>
  %expected_replay = check.generate.iota offset(6) step(94) : tensor<2xi32>
  %expected_acceptance = check.generate.iota offset(5) step(1) : tensor<2xi32>
  %expected_progress = check.generate.iota offset(6) step(-1) : tensor<2xi32>
  %one = check.generate.fill value(1) : tensor<1xi32>
  check.expect.equal actual(%actual_committed_prefix) expected(%expected_committed_prefix) : tensor<5xi32>
  check.expect.equal actual(%actual_correction) expected(%target_row5) : tensor<1xi32>
  check.expect.equal actual(%pending) expected(%target_row5) : tensor<1xi32>
  check.expect.equal actual(%control_pair) expected(%expected_control) : tensor<2xi32>
  check.expect.equal actual(%replay) expected(%expected_replay) : tensor<2xi32>
  check.expect.equal actual(%acceptance) expected(%expected_acceptance) : tensor<2xi32>
  check.expect.equal actual(%progress_header) expected(%expected_progress) : tensor<2xi32>
  check.expect.equal actual(%depth5_count) expected(%one) : tensor<1xi32>
  check.return
}
