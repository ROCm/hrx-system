  %publish_token0 = index.assume %publish_token00 [ge(%publish_token00, 0), lt(%publish_token00, %token_count)] : index
  %values0 = vector.load %result_physical_view[%publish_token, %publish_channel_add] : view<16x16xf32> -> vector<4xf32>
  %residual0 = vector.load %output_view[%publish_token0, %publish_channel] : view<[%token_count]x[%output_size]xf32> -> vector<4xf32>
  %sum0 = vector.addf<nnan|ninf|nsz> %residual0, %values0 : vector<4xf32>
  vector.store %sum0, %output_view[%publish_token0, %publish_channel] : vector<4xf32>, view<[%token_count]x[%output_size]xf32>
  kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)

  vector.fragment.store<result> %result1, %result_fragment_view[%c0, %c0] shape [%m, %n] : vector<4xf32>, view<16x16xf32, %result_fragment_layout>
  kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
  %publish_token10 = index.add %token_origin1, %publish_token : index
  %publish_token1 = index.assume %publish_token10 [ge(%publish_token10, 0), lt(%publish_token10, %token_count)] : index
  %values1 = vector.load %result_physical_view[%publish_token, %publish_channel_add] : view<16x16xf32> -> vector<4xf32>
  %residual1 = vector.load %output_view[%publish_token1, %publish_channel] : view<[%token_count]x[%output_size]xf32> -> vector<4xf32>
  %sum1 = vector.addf<nnan|ninf|nsz> %residual1, %values1 : vector<4xf32>
  vector.store %sum1, %output_view[%publish_token1, %publish_channel] : vector<4xf32>, view<[%token_count]x[%output_size]xf32>
