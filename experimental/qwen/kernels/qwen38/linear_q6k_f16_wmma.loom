// Qwen3.8 dense raw-Q6_K/Q8_0 prefill projection experiment.
//
// Schedules reuse one channel-by-32 weight tile across 64 or 128 tokens. They
// consume the original GGUF bytes and F32 activations without a persistent
// repack. Q6_K and Q8_0 share the signed scaled-weight contraction body; value
// facts select the format-specific decoder before native lowering.

kernel.decl @ggml_quantize_q8_1_x4_f32(%token_count: index, %input_size: index) launch(%token_count$1: index, %input_size$1: index, %input: buffer, %output: buffer)

kernel.decl @ggml_linear_q6k_q8_1_x4(%token_count: index, %input_size: index, %output_size: index) launch(%token_count$1: index, %input_size$1: index, %output_size$1: index, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @ggml_linear_q8_0_q8_1_x4(%token_count: index, %input_size: index, %output_size: index) launch(%token_count_data: index, %input_size_data: index, %output_size_data: index, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @qwen38_residual_add_f32_prefill(%token_count: index) launch(%token_capacity: index, %lhs: buffer, %rhs: buffer, %output: buffer)

amdgpu.target<gfx11-generic> @qwen38_q6k_gfx11_wave64 {subgroup_size = 64}

func.def inline @qwen38_q6k_c64_scale_pair(%weight: buffer, %row_byte_base: offset, %q6_block: index, %q6_group: index) -> (vector<2xf32>) {
  %c2 = index.constant 2 : index
  %block_bytes = index.constant 210 : offset
  %scale_byte_add = index.constant 192 : offset
  %d_byte_add = index.constant 208 : offset
  %block_byte_add = index.scale %q6_block, %block_bytes : index, offset -> offset
  %block_byte_base = index.add %row_byte_base, %block_byte_add : offset
  %scale_byte_base = index.add %block_byte_base, %scale_byte_add : offset
  %d_byte_base = index.add %block_byte_base, %d_byte_add : offset
  %scale_pair_add = index.mul %q6_group, %c2 : index
  %scale_view = buffer.view %weight[%scale_byte_base] : buffer -> view<16xi8>
  %d_view = buffer.view %weight[%d_byte_base] : buffer -> view<1xf16>
  %scale_i8 = vector.load %scale_view[%scale_pair_add] : view<16xi8> -> vector<2xi8>
  %d_f16 = view.load %d_view[0] : view<1xf16> -> f16
  %scale = vector.sitofp %scale_i8 : vector<2xi8> to vector<2xf32>
  %d = scalar.extf %d_f16 : f16 to f32
  %d_pair = vector.splat %d : vector<2xf32>
  %combined = vector.mulf %scale, %d_pair : vector<2xf32>
  func.return %combined : vector<2xf32>
}

func.def inline @qwen38_q6k_c64_f16_vector8_prescaled(%weight: buffer, %row_byte_base: offset, %q6_block: index, %q6_group: index, %packet: index, %combined_scale: f32) -> (vector<8xf16>) {
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %block_bytes = index.constant 210 : offset
  %qh_byte_add = index.constant 128 : offset
  %c4_i32v = vector.constant 4 : vector<2xi32>
  %nibble_mask = vector.constant 252645135 : vector<2xi32>
  %high_mask = vector.constant 50529027 : vector<2xi32>
  %c32_f32v = vector.constant 32.0 : vector<8xf32>
  %bounded_group = index.assume %q6_group [range(%q6_group, 0, 7)] : index
  %bounded_packet = index.assume %packet [range(%packet, 0, 3)] : index
  %block_byte_add = index.scale %q6_block, %block_bytes : index, offset -> offset
  %block_byte_base = index.add %row_byte_base, %block_byte_add : offset
  %qh_byte_base = index.add %block_byte_base, %qh_byte_add : offset
  %ql_view = buffer.view %weight[%block_byte_base] : buffer -> view<32xi32>
  %qh_view = buffer.view %weight[%qh_byte_base] : buffer -> view<16xi32>
  %group_in_half = index.rem %bounded_group, %c4 : index
  %half = index.div %bounded_group, %c4 : index
  %ql_side = index.rem %group_in_half, %c2 : index
  %ql_half_word_base = index.mul %half, %c16 : index
  %ql_side_word_add = index.mul %ql_side, %c8 : index
  %ql_word_base = index.add %ql_half_word_base, %ql_side_word_add : index
  %packet_word = index.mul %bounded_packet, %c2 : index
  %ql_word_index = index.add %ql_word_base, %packet_word : index
  %qh_half_word_base = index.mul %half, %c8 : index
  %qh_word_index = index.add %qh_half_word_base, %packet_word : index
  %nibble = index.div %group_in_half, %c2 : index
  %nibble_shift_index = index.mul %nibble, %c4 : index
  %nibble_shift_i32 = index.cast %nibble_shift_index : index to i32
  %nibble_shift = vector.splat %nibble_shift_i32 : vector<2xi32>
  %qh_shift_index = index.mul %group_in_half, %c2 : index
  %qh_shift_i32 = index.cast %qh_shift_index : index to i32
  %qh_shift = vector.splat %qh_shift_i32 : vector<2xi32>
  %ql_word = vector.load %ql_view[%ql_word_index] : view<32xi32> -> vector<2xi32>
  %qh_word = vector.load %qh_view[%qh_word_index] : view<16xi32> -> vector<2xi32>
  %ql_shifted = vector.shrui %ql_word, %nibble_shift : vector<2xi32>
  %ql = vector.andi %ql_shifted, %nibble_mask : vector<2xi32>
  %qh_shifted = vector.shrui %qh_word, %qh_shift : vector<2xi32>
  %qh_low = vector.andi %qh_shifted, %high_mask : vector<2xi32>
  %qh = vector.shli %qh_low, %c4_i32v : vector<2xi32>
  %code = vector.ori %ql, %qh : vector<2xi32>
  %code_i8 = vector.bitcast %code : vector<2xi32> to vector<8xi8>
  %code_f32 = vector.uitofp %code_i8 : vector<8xi8> to vector<8xf32>
  %centered = vector.subf %code_f32, %c32_f32v : vector<8xf32>
  %combined_scale_vector = vector.splat %combined_scale : vector<8xf32>
  %values_f32 = vector.mulf %centered, %combined_scale_vector : vector<8xf32>
  %values = vector.fptrunc %values_f32 : vector<8xf32> to vector<8xf16>
  func.return %values : vector<8xf16>
}

func.template<qwen38.dense.signed_weight_f16_vector4> @qwen38_dense_q6k_f16_vector4(%format: index, %weight: buffer, %row_byte_base: offset, %quant_block: index, %quant_group: index, %packet: index) -> (vector<4xf16>) where [eq(%format, 6)] {
  %values = func.apply<ggml.q6k.f16_vector4>(%weight, %row_byte_base, %quant_block, %quant_group, %packet) : (buffer, offset, index, index, index) -> (vector<4xf16>)
  func.return %values : vector<4xf16>
}

func.template<qwen38.dense.signed_weight_f16_vector4> @qwen38_dense_q8_0_f16_vector4(%format: index, %weight: buffer, %row_byte_base: offset, %quant_block: index, %quant_group: index, %packet: index) -> (vector<4xf16>) where [eq(%format, 8)] {
  %c2_bytes = index.constant 2 : offset
  %c4_bytes = index.constant 4 : offset
  %c8 = index.constant 8 : index
  %c34_bytes = index.constant 34 : offset
  %q8_block_base = index.mul %quant_block, %c8 : index
  %q8_block = index.add %q8_block_base, %quant_group : index
  %block_byte_add = index.scale %q8_block, %c34_bytes : index, offset -> offset
  %block_byte_base = index.add %row_byte_base, %block_byte_add : offset
  %payload_byte_base = index.add %block_byte_base, %c2_bytes : offset
  %packet_byte_add = index.scale %packet, %c4_bytes : index, offset -> offset
  %packet_byte_base = index.add %payload_byte_base, %packet_byte_add : offset
  %scale_view = buffer.view %weight[%block_byte_base] : buffer -> view<1xf16>
  %packet_view = buffer.view %weight[%packet_byte_base] : buffer -> view<1xi32>
  %scale_f16 = view.load %scale_view[0] : view<1xf16> -> f16
  %scale = scalar.extf %scale_f16 : f16 to f32
  %scale_vector = vector.splat %scale : vector<4xf32>
  %word = vector.load %packet_view[0] : view<1xi32> -> vector<1xi32>
  %codes = vector.bitcast %word : vector<1xi32> to vector<4xi8>
  %codes_f32 = vector.sitofp %codes : vector<4xi8> to vector<4xf32>
  %scaled = vector.mulf %codes_f32, %scale_vector : vector<4xf32>
  %values = vector.fptrunc %scaled : vector<4xf32> to vector<4xf16>
  func.return %values : vector<4xf16>
}

func.template<qwen38.dense_q6k_f16_wmma.body> device @qwen38_dense_q6k_f16_wmma_body(%weight_format: index, %weight_macro_block_byte_count: index, %token_count: index, %input_size0: index, %output_size0: index, %channel_tile: index, %token_tile: index, %channel_tile_width: index, %token_tile_width: index, %channel_group_count: index, %workgroup_size: index, %subgroup_count: index, %workitem: index, %subgroup: index, %lane: index, %input: buffer, %weight: buffer, %output: buffer) {
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 512)] : index
  %bounded_input_size = index.assume %input_size0 [range(%input_size0, 256, 32768), mul(%input_size0, 256)] : index
  %bounded_output_size = index.assume %output_size0 [range(%output_size0, 1, 32768)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c15 = index.constant 15 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c40 = index.constant 40 : index
  %c48 = index.constant 48 : index
  %c64 = index.constant 64 : index
  %c128 = index.constant 128 : index
  %c256 = index.constant 256 : index
  %c0_offset = index.constant 0 : offset
  %f16_byte_count = index.constant 2 : offset
  %wave_result_stage_bytes = index.constant 1024 : offset
  %weight_stage_elements = index.mul %channel_tile_width, %c40 : index
  %weight_stage_bytes = index.scale %weight_stage_elements, %f16_byte_count : index, offset -> offset
  %activation_stage_elements = index.mul %token_tile_width, %c40 : index
  %activation_stage_bytes = index.scale %activation_stage_elements, %f16_byte_count : index, offset -> offset
  %result_stage_bytes = index.scale %subgroup_count, %wave_result_stage_bytes : index, offset -> offset
  %c0_f16x4 = vector.constant 0.0 : vector<4xf16>
  %c0_f32x4 = vector.constant 0.0 : vector<4xf32>
  %zero_accumulator = vector.constant 0.0 : vector<4xf32>
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %quant_block_count = index.div %bounded_input_size, %c256 : index
  %weight_row_bytes = index.mul %quant_block_count, %weight_macro_block_byte_count : index
  %input_noalias, %weight_noalias, %output_noalias = buffer.assume.noalias %input, %weight, %output : buffer, buffer, buffer
  %input_view = buffer.view %input_noalias[%c0_offset] : buffer -> view<[%bounded_token_count]x[%bounded_input_size]xf32>
  %output_view = buffer.view %output_noalias[%c0_offset] : buffer -> view<[%bounded_token_count]x[%bounded_output_size]xf32>
  %weight_stage = buffer.alloca<workgroup> align(16) %weight_stage_bytes : buffer
  %activation_stage = buffer.alloca<workgroup> align(16) %activation_stage_bytes : buffer
  %result_stage = buffer.alloca<workgroup> align(16) %result_stage_bytes : buffer
  %weight_stage_view = buffer.view %weight_stage[%c0_offset] : buffer -> view<[%channel_tile_width]x40xf16>
  %activation_stage_physical_view = buffer.view %activation_stage[%c0_offset] : buffer -> view<[%token_tile_width]x40xf16>
  %activation_fragment_layout = encoding.layout.strided [1, %c40] : encoding<layout>
  %activation_fragment_view = buffer.view %activation_stage[%c0_offset] : buffer -> view<32x[%token_tile_width]xf16, %activation_fragment_layout>
  %wave_result_stage_offset = index.scale %subgroup, %wave_result_stage_bytes : index, offset -> offset
  %result_fragment_layout = encoding.layout.strided [1, %c16] : encoding<layout>
  %result_fragment_view = buffer.view %result_stage[%wave_result_stage_offset] : buffer -> view<16x16xf32, %result_fragment_layout>
  %result_physical_view = buffer.view %result_stage[%wave_result_stage_offset] : buffer -> view<16x16xf32>
  %channel_tile_base = index.mul %channel_tile, %channel_tile_width : index
  %token_tile_base = index.mul %token_tile, %token_tile_width : index
  %channel_group0 = index.rem %subgroup, %channel_group_count : index
  %channel_group = index.assume %channel_group0 [lt(%channel_group0, %channel_group_count)] : index
  %subgroup_channel_add = index.mul %channel_group, %c16 : index
  %token_group0 = index.div %subgroup, %channel_group_count : index
  %token_group = index.assume %token_group0 [range(%token_group0, 0, 1)] : index
  %subgroup_token_add = index.mul %token_group, %c64 : index
  %weight_load_count = index.mul %channel_tile_width, %c8 : index
  %activation_load_count = index.mul %token_tile_width, %c8 : index
  %uses_x64 = index.cmp eq, %token_tile_width, %c64 : index
  %init00 = vector.fragment<init> %zero_accumulator shape [%m, %n] : vector<4xf32>
  %init01 = vector.fragment<init> %zero_accumulator shape [%m, %n] : vector<4xf32>
  %init10 = vector.fragment<init> %zero_accumulator shape [%m, %n] : vector<4xf32>
  %init11 = vector.fragment<init> %zero_accumulator shape [%m, %n] : vector<4xf32>
  %result00, %result01, %result10, %result11 = scf.for %quant_block = [%c0 to %quant_block_count step %c1](%block_acc00 = %init00 : vector<4xf32>, %block_acc01 = %init01 : vector<4xf32>, %block_acc10 = %init10 : vector<4xf32>, %block_acc11 = %init11 : vector<4xf32>) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) {
    %block_result00, %block_result01, %block_result10, %block_result11 = scf.for %quant_group = [%c0 to %c8 step %c1](%acc00 = %block_acc00 : vector<4xf32>, %acc01 = %block_acc01 : vector<4xf32>, %acc10 = %block_acc10 : vector<4xf32>, %acc11 = %block_acc11 : vector<4xf32>) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) {
      %block_k_base = index.mul %quant_block, %c256 : index
      %group_k_add = index.mul %quant_group, %c32 : index
      %k_origin = index.add %block_k_base, %group_k_add : index
      scf.if %uses_x64 {
        %load_packet0 = index.rem %workitem, %c8 : index
        %load_packet = index.assume %load_packet0 [range(%load_packet0, 0, 7)] : index
        %load_k = index.mul %load_packet, %c4 : index
        %load_row0 = index.div %workitem, %c8 : index
        %load_row = index.assume %load_row0 [range(%load_row0, 0, 31)] : index
        scf.for %row_offset = [%c0 to %c64 step %c32] unroll {
          %local_row0 = index.add %load_row, %row_offset : index
          %local_row = index.assume %local_row0 [range(%local_row0, 0, 63)] : index
          %channel = index.add %channel_tile_base, %local_row : index
          %valid_channel = index.cmp ult, %channel, %bounded_output_size : index
          %weight_values = scf.if %valid_channel -> (vector<4xf16>) {
            %channel_byte_index = index.mul %channel, %weight_row_bytes : index
            %row_byte_base = index.cast %channel_byte_index : index to offset
            %decoded = func.apply<qwen38.dense.signed_weight_f16_vector4>(%weight_format, %weight_noalias, %row_byte_base, %quant_block, %quant_group, %load_packet) : (index, buffer, offset, index, index, index) -> (vector<4xf16>)
            scf.yield %decoded : vector<4xf16>
          } else {
            scf.yield %c0_f16x4 : vector<4xf16>
          }
          vector.store %weight_values, %weight_stage_view[%local_row, %load_k] : vector<4xf16>, view<[%channel_tile_width]x40xf16>
          %token = index.add %token_tile_base, %local_row : index
          %valid_token = index.cmp ult, %token, %bounded_token_count : index
          %activation_values = scf.if %valid_token -> (vector<4xf16>) {
            %bounded_token, %input_token_count = index.assume %token, %bounded_token_count [lt(%token, %bounded_token_count)] : index, index
            %input_k = index.add %k_origin, %load_k : index
            %input_mask = vector.mask.range [%input_k to %bounded_input_size step %c1] : index -> vector<4xi1>
            %loaded = vector.load.mask %input_view[%bounded_token, %input_k], %input_mask, %c0_f32x4 : view<[%bounded_token_count]x[%bounded_input_size]xf32>, vector<4xi1>, vector<4xf32>
            %converted = vector.fptrunc %loaded : vector<4xf32> to vector<4xf16>
            scf.yield %converted : vector<4xf16>
          } else {
            scf.yield %c0_f16x4 : vector<4xf16>
          }
          vector.store %activation_values, %activation_stage_physical_view[%local_row, %load_k] : vector<4xf16>, view<[%token_tile_width]x40xf16>
        }
      } else {
        scf.for %weight_task = [%workitem to %weight_load_count step %workgroup_size] unroll {
          %load_packet0 = index.rem %weight_task, %c8 : index
          %load_packet = index.assume %load_packet0 [range(%load_packet0, 0, 7)] : index
          %load_k = index.mul %load_packet, %c4 : index
          %load_row0 = index.div %weight_task, %c8 : index
          %load_row = index.assume %load_row0 [lt(%load_row0, %channel_tile_width)] : index
          %channel = index.add %channel_tile_base, %load_row : index
          %valid_channel = index.cmp ult, %channel, %bounded_output_size : index
