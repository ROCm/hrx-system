// Workload token counts may be zero so a command program can select exactly one
// schedule without rerecording. token_count_data always carries the nonzero
// logical token count used for body bounds.
kernel.def target(@qwen38_q6k_gfx11_wave64) export("qwen38_linear_q6k_f16_wmma_x64") @qwen38_linear_q6k_f16_wmma_x64(%token_count0: index, %input_size0: index, %output_size0: index) {
  %token_count = index.assume %token_count0 [range(%token_count0, 0, 512)] : index
