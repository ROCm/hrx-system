// Exercises partial token and channel tiles with a canonical Q8_0 block. Each
// block has scale 0x3c3c (1.05859375) and 32 signed codes of value 60. The
// scaled values round to 63.5 as F16 matrix operands, so a 256-element row
// contracted with unit activations is exactly 16256 with F32 accumulation.
check.case public @qwen38_linear_q8_0_f16_wmma_x128_differential_case {
  %token_count = check.literal value(129) : index
  %input_size = check.literal value(256) : index
  %output_size = check.literal value(65) : index
  %token_count_data = check.generate.fill value(129) : tensor<1xi32>
  %input = check.generate.fill value(1.0) : tensor<129x256xf32>
  %weight = check.generate.fill value(60) : tensor<65x8x34xi8>
  %expected = check.generate.fill value(16256.0) : tensor<129x65xf32>
  %actual = check.generate.fill value(0.0) : tensor<129x65xf32>
  kernel.launch @qwen38_linear_q8_0_f16_wmma_x128[%token_count, %input_size, %output_size](%token_count_data, %input_size, %output_size, %input, %weight, %actual) : [index, index, index](tensor<1xi32>, index, index, tensor<129x256xf32>, tensor<65x8x34xi8>, tensor<129x65xf32>)
  check.expect.close actual(%actual) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<129x65xf32>
  check.return
}

