  %input_view = buffer.view %input_noalias[%c0_offset] : buffer -> view<[%token_count]x[%input_size]xf32>
  %weight_stage = buffer.alloca<workgroup> align(16) %weight_stage_bytes : buffer
  %activation_stage = buffer.alloca<workgroup> align(16) %activation_stage_bytes : buffer
  %metadata_stage = buffer.alloca<workgroup> align(16) %metadata_stage_bytes : buffer
