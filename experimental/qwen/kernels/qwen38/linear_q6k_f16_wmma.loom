// Assigns one 16-channel by 32-token tile to each of four waves. The waves
// share the activation tile while retaining independent F32 accumulators.
func.template<qwen38.dense_q6k_f16_wmma.c64t32.body> device @qwen38_dense_q6k_f16_wmma_c64t32_body(%epilogue: index, %token_count_data: buffer, %input_size0: index, %output_size0: index, %input: buffer, %weight: buffer, %output: buffer) {
