} launch(%weight: buffer) {
  %output_row = kernel.workgroup.id<x> : index
  %lane = kernel.subgroup.lane.id : index
  %c0 = index.constant 0 : index
  %block_bytes = index.constant 210 : offset
  %d_byte_add = index.constant 208 : offset
  %d = scalar.constant 0.125 : f32
  %d_f16 = scalar.fptrunc %d : f32 to f16
