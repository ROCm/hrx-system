// Compares the WMMA schedule against the existing Q8_1 contraction on the
// same F32 activations and raw Q6_K bytes.
check.case public @qwen38_linear_q6k_f16_wmma_differential_case {
  %token_count = check.literal value(1) : index
  %input_size = check.literal value(256) : index
  %output_size = check.literal value(65) : index
  %token_count_data = check.generate.fill value(1) : tensor<1xi32>
  %input = check.generate.iota offset(-0.75) step(0.0078125) : tensor<256xf32>
  %q8_input = check.generate.fill value(0) : tensor<288xi8>
  %weight = check.generate.fill value(1) : tensor<65x210xi8>
  %expected = check.generate.fill value(0.0) : tensor<65xf32>
  %actual = check.generate.fill value(0.0) : tensor<65xf32>
  kernel.launch @qwen38_q6k_fix_differential_headers(%weight) : (tensor<65x210xi8>)
  kernel.launch @ggml_quantize_q8_1_x4_f32[%token_count, %input_size](%token_count, %input_size, %input, %q8_input) : [index, index](index, index, tensor<256xf32>, tensor<288xi8>)
  kernel.launch @ggml_linear_q6k_q8_1_x4[%token_count, %input_size, %output_size](%token_count, %input_size, %output_size, %q8_input, %weight, %expected) : [index, index, index](index, index, index, tensor<288xi8>, tensor<65x210xi8>, tensor<65xf32>)
  kernel.launch @qwen38_linear_q6k_f16_wmma_x64[%token_count, %input_size, %output_size](%token_count_data, %input_size, %output_size, %input, %weight, %actual) : [index, index, index](tensor<1xi32>, index, index, tensor<256xf32>, tensor<65x210xi8>, tensor<65xf32>)
  check.expect.close actual(%actual) expected(%expected) atol(0.5) rtol(0.02) nan(same) : tensor<65xf32>
  check.return
}

