// Proves that the in-place residual epilogue is bit-identical to publishing
// the projection and adding it with the standalone layer primitive.
check.case public @qwen38_linear_q6k_f16_wmma_c64t32_f32acc_residual_differential_case {
  %token_count = check.literal value(32) : index
  %input_size = check.literal value(256) : index
  %output_size = check.literal value(5120) : index
  %token_count_data = check.generate.fill value(32) : tensor<1xi32>
  %input = check.generate.iota offset(-0.75) step(0.0078125) : tensor<32x256xf32>
  %weight = check.generate.fill value(1) : tensor<5120x210xi8>
  %projection = check.generate.fill value(0.0) : tensor<32x5120xf32>
  %expected = check.generate.fill value(0.5) : tensor<32x5120xf32>
  %actual = check.generate.fill value(0.5) : tensor<32x5120xf32>
  kernel.launch @qwen38_q6k_fix_differential_headers(%weight) : (tensor<5120x210xi8>)
  kernel.launch @qwen38_linear_q6k_f16_wmma_c64t32_f32acc_residual[%token_count, %input_size, %output_size](%token_count_data, %input_size, %output_size, %input, %weight, %projection) : [index, index, index](tensor<1xi32>, index, index, tensor<32x256xf32>, tensor<5120x210xi8>, tensor<32x5120xf32>)
  kernel.launch @qwen38_residual_add_f32_prefill[%token_count](%token_count, %expected, %projection, %expected) : [index](index, tensor<32x5120xf32>, tensor<32x5120xf32>, tensor<32x5120xf32>)
  kernel.launch @qwen38_linear_q6k_f16_wmma_c64t32_f32acc_residual[%token_count, %input_size, %output_size](%token_count_data, %input_size, %output_size, %input, %weight, %actual) : [index, index, index](tensor<1xi32>, index, index, tensor<32x256xf32>, tensor<5120x210xi8>, tensor<32x5120xf32>)
  check.expect.close actual(%actual) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<32x5120xf32>
  check.return
}

