        scf.yield %half_next00, %half_next01, %half_next10, %half_next11 : vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>
      }
      kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
      scf.yield %next00, %next01, %next10, %next11 : vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>
    }
    scf.yield %block_result00, %block_result01, %block_result10, %block_result11 : vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>
  }
  // WMMA owns [channel][token] fragments. Each wave transposes one fragment
  // through its private LDS slice so every lane publishes four contiguous F32
