  %publish_packet0 = index.rem %lane, %c4 : index
  %publish_packet = index.assume %publish_packet0 [range(%publish_packet0, 0, 3)] : index
  %publish_channel_add = index.mul %publish_packet, %c4 : index
  %publish_channel0 = index.add %channel_origin, %publish_channel_add : index
  %last_channel_packet_start = index.sub %output_size, %c3 : index
  %publish_channel = index.assume %publish_channel0 [ge(%publish_channel0, 0), lt(%publish_channel0, %last_channel_packet_start)] : index

  vector.fragment.store<result> %result0, %result_fragment_view[%c0, %c0] shape [%m, %n] : vector<4xf32>, view<16x16xf32, %result_fragment_layout>
  kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
