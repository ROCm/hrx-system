// Exact-Q5_K wave32 prefill schedule experiment.
//
// This candidate preserves the GGUF Q5_K bytes, F16 WMMA operands, and F32
// accumulation. F32 and producer-rounded F16 activation storage specialize
// into the same operand stream. Sixteen wave32 subgroups share a 128-channel
// by 128-token workgroup tile.

func.decl @qwen38_q5k_f16_vector4_prescaled(%weight: buffer, %row_byte_base: offset, %q5_block: index, %q5_group: index, %packet: index, %d_scale: f32, %dmin_scale: f32) -> (vector<4xf16>)

kernel.decl @qwen38_linear_q5k_f16_wmma_x128(%token_count0: index, %input_size0: index, %output_size0: index) launch(%token_count_data: buffer, %input_size1: index, %output_size1: index, %input: buffer, %weight: buffer, %output: buffer)

amdgpu.target<gfx11-generic> @qwen38_dense_gfx11_wave32_x128 {subgroup_size = 32}

func.template<qwen38.dense_q5k_f16_wmma.wave32_x128.compute> device @qwen38_dense_q5k_f16_wmma_wave32_x128_compute(%input_is_f16: i1, %token_count: index, %input_size0: index, %output_size0: index, %channel_tile: index, %token_tile: index, %channel_tile_width: index, %token_tile_width: index, %channel_group_count: index, %workgroup_size: index, %workitem: index, %subgroup: index, %input: buffer, %weight: buffer) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 512)] : index
  %bounded_input_size = index.assume %input_size0 [range(%input_size0, 256, 32768), mul(%input_size0, 256)] : index
  %bounded_output_size = index.assume %output_size0 [range(%output_size0, 1, 32768)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c40 = index.constant 40 : index
  %c48 = index.constant 48 : index
  %c64 = index.constant 64 : index
  %c128 = index.constant 128 : index
  %c256 = index.constant 256 : index
  %c0_offset = index.constant 0 : offset
  %f16_byte_count = index.constant 2 : offset
  %f32_byte_count = index.constant 4 : offset
  %weight_block_byte_count = index.constant 176 : index
  %weight_block_bytes = index.constant 176 : offset
  %weight_stage_elements = index.mul %channel_tile_width, %c40 : index
  %weight_stage_bytes = index.scale %weight_stage_elements, %f16_byte_count : index, offset -> offset
  %activation_stage_elements = index.mul %token_tile_width, %c40 : index
  %activation_stage_bytes = index.scale %activation_stage_elements, %f16_byte_count : index, offset -> offset
  %metadata_stage_elements0 = index.mul %channel_tile_width, %c8 : index
  %metadata_stage_elements = index.mul %metadata_stage_elements0, %c2 : index
  %metadata_stage_bytes = index.scale %metadata_stage_elements, %f32_byte_count : index, offset -> offset
  %c0_f32x2 = vector.constant 0.0 : vector<2xf32>
  %c0_f16x4 = vector.constant 0.0 : vector<4xf16>
  %c0_f32x4 = vector.constant 0.0 : vector<4xf32>
  %zero_accumulator = vector.constant 0.0 : vector<8xf32>
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %quant_block_count = index.div %bounded_input_size, %c256 : index
  %input_f16_word_count = index.div %bounded_input_size, %c2 : index
  %last_input_f16_packet_start = index.sub %input_f16_word_count, %c1 : index
  %weight_row_bytes = index.mul %quant_block_count, %weight_block_byte_count : index
  %input_f32_view = buffer.view %input[%c0_offset] : buffer -> view<[%bounded_token_count]x[%bounded_input_size]xf32>
  %input_f16_packed_view = buffer.view %input[%c0_offset] : buffer -> view<[%bounded_token_count]x[%input_f16_word_count]xi32>
  %weight_stage = buffer.alloca<workgroup> align(16) %weight_stage_bytes : buffer
  %activation_stage = buffer.alloca<workgroup> align(16) %activation_stage_bytes : buffer
  %metadata_stage = buffer.alloca<workgroup> align(16) %metadata_stage_bytes : buffer
  %weight_stage_view = buffer.view %weight_stage[%c0_offset] : buffer -> view<[%channel_tile_width]x40xf16>
  %activation_stage_physical_view = buffer.view %activation_stage[%c0_offset] : buffer -> view<[%token_tile_width]x40xf16>
  %metadata_stage_view = buffer.view %metadata_stage[%c0_offset] : buffer -> view<[%channel_tile_width]x8x2xf32>
  %activation_fragment_layout = encoding.layout.strided [1, %c40] : encoding<layout>
  %activation_fragment_view = buffer.view %activation_stage[%c0_offset] : buffer -> view<32x[%token_tile_width]xf16, %activation_fragment_layout>
  %channel_tile_base = index.mul %channel_tile, %channel_tile_width : index
  %token_tile_base = index.mul %token_tile, %token_tile_width : index
  %channel_group0 = index.rem %subgroup, %channel_group_count : index
  %channel_group = index.assume %channel_group0 [lt(%channel_group0, %channel_group_count)] : index
  %subgroup_channel_add = index.mul %channel_group, %c16 : index
  %token_group0 = index.div %subgroup, %channel_group_count : index
  %token_group = index.assume %token_group0 [range(%token_group0, 0, 1)] : index
  %subgroup_token_add = index.mul %token_group, %c64 : index
  %weight_load_count = index.mul %channel_tile_width, %c8 : index
  %activation_load_count = index.mul %token_tile_width, %c8 : index
  %metadata_load_count = index.mul %channel_tile_width, %c8 : index
  %init00 = vector.fragment<init> %zero_accumulator shape [%m, %n] : vector<8xf32>
  %init01 = vector.fragment<init> %zero_accumulator shape [%m, %n] : vector<8xf32>
  %init10 = vector.fragment<init> %zero_accumulator shape [%m, %n] : vector<8xf32>
  %init11 = vector.fragment<init> %zero_accumulator shape [%m, %n] : vector<8xf32>
  %result00, %result01, %result10, %result11 = scf.for %quant_block = [%c0 to %quant_block_count step %c1](%block_acc00 = %init00 : vector<8xf32>, %block_acc01 = %init01 : vector<8xf32>, %block_acc10 = %init10 : vector<8xf32>, %block_acc11 = %init11 : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
    scf.for %metadata_task = [%workitem to %metadata_load_count step %workgroup_size] unroll {
      %metadata_group0 = index.rem %metadata_task, %c8 : index
      %metadata_group = index.assume %metadata_group0 [range(%metadata_group0, 0, 7)] : index
      %metadata_row0 = index.div %metadata_task, %c8 : index
      %metadata_row = index.assume %metadata_row0 [lt(%metadata_row0, %channel_tile_width)] : index
      %metadata_channel = index.add %channel_tile_base, %metadata_row : index
      %valid_metadata_channel = index.cmp ult, %metadata_channel, %bounded_output_size : index
      %metadata_pair = scf.if %valid_metadata_channel -> (vector<2xf32>) {
        %metadata_channel_byte_index = index.mul %metadata_channel, %weight_row_bytes : index
        %metadata_row_byte_base = index.cast %metadata_channel_byte_index : index to offset
        %metadata_block_byte_add = index.scale %quant_block, %weight_block_bytes : index, offset -> offset
        %metadata_block_byte_base = index.add %metadata_row_byte_base, %metadata_block_byte_add : offset
        %d_scale, %dmin_scale = func.apply<ggml.q5k.scale_min>(%weight, %metadata_block_byte_base, %metadata_group) : (buffer, offset, index) -> (f32, f32)
        %decoded_pair = vector.from_elements %d_scale, %dmin_scale : vector<2xf32>
        scf.yield %decoded_pair : vector<2xf32>
      } else {
        scf.yield %c0_f32x2 : vector<2xf32>
      }
      vector.store %metadata_pair, %metadata_stage_view[%metadata_row, %metadata_group, %c0] : vector<2xf32>, view<[%channel_tile_width]x8x2xf32>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %block_result00, %block_result01, %block_result10, %block_result11 = scf.for %quant_group = [%c0 to %c8 step %c1](%acc00 = %block_acc00 : vector<8xf32>, %acc01 = %block_acc01 : vector<8xf32>, %acc10 = %block_acc10 : vector<8xf32>, %acc11 = %block_acc11 : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
      %block_k_base = index.mul %quant_block, %c256 : index
      %group_k_add = index.mul %quant_group, %c32 : index
      %k_origin = index.add %block_k_base, %group_k_add : index
      scf.for %weight_task = [%workitem to %weight_load_count step %workgroup_size] unroll {
        %load_packet0 = index.rem %weight_task, %c8 : index
        %load_packet = index.assume %load_packet0 [range(%load_packet0, 0, 7)] : index
        %load_k = index.mul %load_packet, %c4 : index
        %load_row0 = index.div %weight_task, %c8 : index
        %load_row = index.assume %load_row0 [lt(%load_row0, %channel_tile_width)] : index
        %channel = index.add %channel_tile_base, %load_row : index
        %valid_channel = index.cmp ult, %channel, %bounded_output_size : index
        %weight_values = scf.if %valid_channel -> (vector<4xf16>) {
          %channel_byte_index = index.mul %channel, %weight_row_bytes : index
          %row_byte_base = index.cast %channel_byte_index : index to offset
          %metadata_pair = vector.load %metadata_stage_view[%load_row, %quant_group, %c0] : view<[%channel_tile_width]x8x2xf32> -> vector<2xf32>
          %d_scale = vector.extract %metadata_pair[0] : vector<2xf32> -> f32
          %dmin_scale = vector.extract %metadata_pair[1] : vector<2xf32> -> f32
          %decoded = func.call @qwen38_q5k_f16_vector4_prescaled(%weight, %row_byte_base, %quant_block, %quant_group, %load_packet, %d_scale, %dmin_scale) : (buffer, offset, index, index, index, f32, f32) -> (vector<4xf16>)
          scf.yield %decoded : vector<4xf16>
        } else {
          scf.yield %c0_f16x4 : vector<4xf16>
        }
        vector.store %weight_values, %weight_stage_view[%load_row, %load_k] : vector<4xf16>, view<[%channel_tile_width]x40xf16>
      }
      scf.for %activation_task = [%workitem to %activation_load_count step %workgroup_size] unroll {
        %load_packet0 = index.rem %activation_task, %c8 : index
        %load_packet = index.assume %load_packet0 [range(%load_packet0, 0, 7)] : index
        %load_k = index.mul %load_packet, %c4 : index
        %activation_row0 = index.div %activation_task, %c8 : index
        %activation_row = index.assume %activation_row0 [range(%activation_row0, 0, 127)] : index
        %token = index.add %token_tile_base, %activation_row : index
        %valid_token = index.cmp ult, %token, %bounded_token_count : index
        %activation_values = scf.if %valid_token -> (vector<4xf16>) {
          %bounded_token, %input_token_count = index.assume %token, %bounded_token_count [lt(%token, %bounded_token_count)] : index, index
          %input_k = index.add %k_origin, %load_k : index
          %loaded = scf.if %input_is_f16 -> (vector<4xf16>) {
            %input_word0 = index.div %input_k, %c2 : index
            %input_word = index.assume %input_word0 [ge(%input_word0, 0), lt(%input_word0, %last_input_f16_packet_start)] : index
            %packed = vector.load %input_f16_packed_view[%bounded_token, %input_word] : view<[%bounded_token_count]x[%input_f16_word_count]xi32> -> vector<2xi32>
            %value = vector.bitcast %packed : vector<2xi32> to vector<4xf16>
            scf.yield %value : vector<4xf16>
          } else {
            %input_mask = vector.mask.range [%input_k to %bounded_input_size step %c1] : index -> vector<4xi1>
            %value_f32 = vector.load.mask %input_f32_view[%bounded_token, %input_k], %input_mask, %c0_f32x4 : view<[%bounded_token_count]x[%bounded_input_size]xf32>, vector<4xi1>, vector<4xf32>
            %value = vector.fptrunc %value_f32 : vector<4xf32> to vector<4xf16>
            scf.yield %value : vector<4xf16>
          }
          scf.yield %loaded : vector<4xf16>
        } else {
          scf.yield %c0_f16x4 : vector<4xf16>
        }
        vector.store %activation_values, %activation_stage_physical_view[%activation_row, %load_k] : vector<4xf16>, view<[%token_tile_width]x40xf16>
      }
      kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
      %next00, %next01, %next10, %next11 = scf.for %k_half = [%c0 to %c32 step %c16](%half_acc00 = %acc00 : vector<8xf32>, %half_acc01 = %acc01 : vector<8xf32>, %half_acc10 = %acc10 : vector<8xf32>, %half_acc11 = %acc11 : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) unroll {
        %lhs0 = vector.fragment.load<lhs> %weight_stage_view[%subgroup_channel_add, %k_half] shape [%m, %k] : view<[%channel_tile_width]x40xf16> -> vector<16xf16>
        %rhs_token0 = index.add %subgroup_token_add, %c0 : index
        %rhs_token1 = index.add %subgroup_token_add, %c16 : index
        %rhs_token2 = index.add %subgroup_token_add, %c32 : index
        %rhs_token3 = index.add %subgroup_token_add, %c48 : index
        %rhs0 = vector.fragment.load<rhs> %activation_fragment_view[%k_half, %rhs_token0] shape [%k, %n] : view<32x[%token_tile_width]xf16, %activation_fragment_layout> -> vector<16xf16>
        %rhs1 = vector.fragment.load<rhs> %activation_fragment_view[%k_half, %rhs_token1] shape [%k, %n] : view<32x[%token_tile_width]xf16, %activation_fragment_layout> -> vector<16xf16>
        %rhs2 = vector.fragment.load<rhs> %activation_fragment_view[%k_half, %rhs_token2] shape [%k, %n] : view<32x[%token_tile_width]xf16, %activation_fragment_layout> -> vector<16xf16>
        %rhs3 = vector.fragment.load<rhs> %activation_fragment_view[%k_half, %rhs_token3] shape [%k, %n] : view<32x[%token_tile_width]xf16, %activation_fragment_layout> -> vector<16xf16>
        %half_next00 = vector.mma %lhs0, %rhs0, %half_acc00 : vector<16xf16>, vector<16xf16>, vector<8xf32>
        %half_next01 = vector.mma %lhs0, %rhs1, %half_acc01 : vector<16xf16>, vector<16xf16>, vector<8xf32>
        %half_next10 = vector.mma %lhs0, %rhs2, %half_acc10 : vector<16xf16>, vector<16xf16>, vector<8xf32>
        %half_next11 = vector.mma %lhs0, %rhs3, %half_acc11 : vector<16xf16>, vector<16xf16>, vector<8xf32>
        scf.yield %half_next00, %half_next01, %half_next10, %half_next11 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
      }
      kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
      scf.yield %next00, %next01, %next10, %next11 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
    }
    scf.yield %block_result00, %block_result01, %block_result10, %block_result11 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }
  func.return %result00, %result01, %result10, %result11 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
}

// WMMA owns [channel][token] fragments. Each wave transposes one fragment
// through its private LDS slice so every lane publishes eight contiguous F32
// channels for one logical token.
func.template<qwen38.dense_q5k_f16_wmma.wave32_x128.publish> device @qwen38_dense_q5k_f16_wmma_wave32_x128_publish(%result00: vector<8xf32>, %result01: vector<8xf32>, %result10: vector<8xf32>, %result11: vector<8xf32>, %token_count: index, %output_size0: index, %channel_tile: index, %token_tile: index, %channel_tile_width: index, %token_tile_width: index, %channel_group_count: index, %subgroup_count: index, %subgroup: index, %lane: index, %output: buffer) {
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 512)] : index
  %bounded_output_size = index.assume %output_size0 [range(%output_size0, 1, 32768)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c48 = index.constant 48 : index
  %c64 = index.constant 64 : index
  %c0_offset = index.constant 0 : offset
  %wave_result_stage_bytes = index.constant 1024 : offset
  %result_stage_bytes = index.scale %subgroup_count, %wave_result_stage_bytes : index, offset -> offset
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %output_view = buffer.view %output[%c0_offset] : buffer -> view<[%bounded_token_count]x[%bounded_output_size]xf32>
  %result_stage = buffer.alloca<workgroup> align(16) %result_stage_bytes : buffer
  %wave_result_stage_offset = index.scale %subgroup, %wave_result_stage_bytes : index, offset -> offset
  %result_fragment_layout = encoding.layout.strided [1, %c16] : encoding<layout>
  %result_fragment_view = buffer.view %result_stage[%wave_result_stage_offset] : buffer -> view<16x16xf32, %result_fragment_layout>
  %result_physical_view = buffer.view %result_stage[%wave_result_stage_offset] : buffer -> view<16x16xf32>
  %channel_tile_base = index.mul %channel_tile, %channel_tile_width : index
  %token_tile_base = index.mul %token_tile, %token_tile_width : index
  %channel_group0 = index.rem %subgroup, %channel_group_count : index
  %channel_group = index.assume %channel_group0 [lt(%channel_group0, %channel_group_count)] : index
  %subgroup_channel_add = index.mul %channel_group, %c16 : index
  %token_group0 = index.div %subgroup, %channel_group_count : index
  %token_group = index.assume %token_group0 [range(%token_group0, 0, 1)] : index
  %subgroup_token_add = index.mul %token_group, %c64 : index
  %publish_token0 = index.div %lane, %c2 : index
  %publish_token = index.assume %publish_token0 [range(%publish_token0, 0, 15)] : index
  %publish_packet0 = index.rem %lane, %c2 : index
  %publish_packet = index.assume %publish_packet0 [range(%publish_packet0, 0, 1)] : index
  %publish_channel_add = index.mul %publish_packet, %c8 : index
  %wave_token_base = index.add %token_tile_base, %subgroup_token_add : index
  %token0 = index.add %wave_token_base, %publish_token : index
  %publish_token1 = index.add %publish_token, %c16 : index
  %token1 = index.add %wave_token_base, %publish_token1 : index
  %publish_token2 = index.add %publish_token, %c32 : index
  %token2 = index.add %wave_token_base, %publish_token2 : index
  %publish_token3 = index.add %publish_token, %c48 : index
  %token3 = index.add %wave_token_base, %publish_token3 : index
  %subgroup_channel_base = index.add %channel_tile_base, %subgroup_channel_add : index
  %channel0 = index.add %subgroup_channel_base, %publish_channel_add : index
  %valid_token0 = index.cmp ult, %token0, %bounded_token_count : index
  %valid_token1 = index.cmp ult, %token1, %bounded_token_count : index
  %valid_token2 = index.cmp ult, %token2, %bounded_token_count : index
  %valid_token3 = index.cmp ult, %token3, %bounded_token_count : index
  %valid_channel0 = index.cmp ult, %channel0, %bounded_output_size : index
  %writes00 = scalar.andi %valid_token0, %valid_channel0 : i1
  %writes01 = scalar.andi %valid_token1, %valid_channel0 : i1
  %writes10 = scalar.andi %valid_token2, %valid_channel0 : i1
  %writes11 = scalar.andi %valid_token3, %valid_channel0 : i1
  vector.fragment.store<result> %result00, %result_fragment_view[%c0, %c0] shape [%m, %n] : vector<8xf32>, view<16x16xf32, %result_fragment_layout>
  kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
  scf.if %writes00 {
    %bounded_token, %output_token_count = index.assume %token0, %bounded_token_count [lt(%token0, %bounded_token_count)] : index, index
    %values = vector.load %result_physical_view[%publish_token, %publish_channel_add] : view<16x16xf32> -> vector<8xf32>
    %mask = vector.mask.range [%channel0 to %bounded_output_size step %c1] : index -> vector<8xi1>
    vector.store.mask %values, %output_view[%bounded_token, %channel0], %mask : vector<8xf32>, view<[%bounded_token_count]x[%bounded_output_size]xf32>, vector<8xi1>
  }
  kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
  vector.fragment.store<result> %result01, %result_fragment_view[%c0, %c0] shape [%m, %n] : vector<8xf32>, view<16x16xf32, %result_fragment_layout>
  kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
  scf.if %writes01 {
    %bounded_token, %output_token_count = index.assume %token1, %bounded_token_count [lt(%token1, %bounded_token_count)] : index, index
    %values = vector.load %result_physical_view[%publish_token, %publish_channel_add] : view<16x16xf32> -> vector<8xf32>
    %mask = vector.mask.range [%channel0 to %bounded_output_size step %c1] : index -> vector<8xi1>
    vector.store.mask %values, %output_view[%bounded_token, %channel0], %mask : vector<8xf32>, view<[%bounded_token_count]x[%bounded_output_size]xf32>, vector<8xi1>
  }
  kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
  vector.fragment.store<result> %result10, %result_fragment_view[%c0, %c0] shape [%m, %n] : vector<8xf32>, view<16x16xf32, %result_fragment_layout>
  kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
  scf.if %writes10 {
    %bounded_token, %output_token_count = index.assume %token2, %bounded_token_count [lt(%token2, %bounded_token_count)] : index, index
    %values = vector.load %result_physical_view[%publish_token, %publish_channel_add] : view<16x16xf32> -> vector<8xf32>
    %mask = vector.mask.range [%channel0 to %bounded_output_size step %c1] : index -> vector<8xi1>
    vector.store.mask %values, %output_view[%bounded_token, %channel0], %mask : vector<8xf32>, view<[%bounded_token_count]x[%bounded_output_size]xf32>, vector<8xi1>
  }
  kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
  vector.fragment.store<result> %result11, %result_fragment_view[%c0, %c0] shape [%m, %n] : vector<8xf32>, view<16x16xf32, %result_fragment_layout>
  kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
  scf.if %writes11 {
    %bounded_token, %output_token_count = index.assume %token3, %bounded_token_count [lt(%token3, %bounded_token_count)] : index, index
    %values = vector.load %result_physical_view[%publish_token, %publish_channel_add] : view<16x16xf32> -> vector<8xf32>
    %mask = vector.mask.range [%channel0 to %bounded_output_size step %c1] : index -> vector<8xi1>
    vector.store.mask %values, %output_view[%bounded_token, %channel0], %mask : vector<8xf32>, view<[%bounded_token_count]x[%bounded_output_size]xf32>, vector<8xi1>
  }
