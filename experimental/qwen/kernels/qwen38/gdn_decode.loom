  %alpha = check.generate.iota offset(-0.25) step(0.0078125) : tensor<48xf32>
  %beta = check.generate.iota offset(-0.5) step(0.015625) : tensor<48xf32>
  %ssm_a = check.generate.iota offset(-0.75) step(0.0078125) : tensor<48xf32>
  %dt_bias = check.generate.iota offset(-0.125) step(0.00390625) : tensor<48xf32>
  %expected_state = check.generate.iota offset(-0.0625) step(0.000000125) : tensor<786432xf32>
  %actual_state = check.generate.iota offset(-0.0625) step(0.000000125) : tensor<786432xf32>
  %expected_output = check.generate.fill value(0.0) : tensor<6144xf32>
  %actual_output = check.generate.fill value(0.0) : tensor<6144xf32>
  kernel.launch @qwen38_gdn_recurrent_decode(%qkv_silu, %qk_inverse_norm, %alpha, %beta, %ssm_a, %dt_bias, %expected_state, %expected_output) : (tensor<10240xf32>, tensor<32xf32>, tensor<48xf32>, tensor<48xf32>, tensor<48xf32>, tensor<48xf32>, tensor<786432xf32>, tensor<6144xf32>)
  kernel.launch @qwen38_gdn_recurrent_decode_x4(%qkv_silu, %qk_inverse_norm, %alpha, %beta, %ssm_a, %dt_bias, %actual_state, %actual_output) : (tensor<10240xf32>, tensor<32xf32>, tensor<48xf32>, tensor<48xf32>, tensor<48xf32>, tensor<48xf32>, tensor<786432xf32>, tensor<6144xf32>)
  check.expect.close actual(%actual_state) expected(%expected_state) atol(0.00001) rtol(0.00001) nan(same) : tensor<786432xf32>
  check.expect.close actual(%actual_output) expected(%expected_output) atol(0.00001) rtol(0.00001) nan(same) : tensor<6144xf32>
  check.return
}

