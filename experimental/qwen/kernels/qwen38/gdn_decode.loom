// Qwen3.8-27B token-one Gated DeltaNet primitives. The kernels consume the
// model's native projection layout:
//
//   q: 16 heads x 128
//   k: 16 heads x 128
//   v: 48 heads x 128
//
// The convolution history stores three contiguous F32 values per channel.
// The recurrent state is transposed so each 128-value state column is
// contiguous. No parameter or state repacking is required.

// Applies the four-tap depthwise convolution for one physical QKV channel,
// advances its three-value history, and returns the SiLU activation.
func.def inline @qwen38_gdn_conv_channel(%channel: index, %qkv_input: buffer, %conv_weight: buffer, %conv_history: buffer) -> (f32) {
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c0_offset = index.constant 0 : offset
  %history_base = index.mul %channel, %c3 : index
  %history1_index = index.add %history_base, %c1 : index
  %history2_index = index.add %history_base, %c2 : index
  %weight_base = index.mul %channel, %c4 : index
  %weight1_index = index.add %weight_base, %c1 : index
  %weight2_index = index.add %weight_base, %c2 : index
  %weight3_index = index.add %weight_base, %c3 : index
  %input_view = buffer.view %qkv_input[%c0_offset] : buffer -> view<10240xf32>
  %weight_view = buffer.view %conv_weight[%c0_offset] : buffer -> view<40960xf32>
  %history_view = buffer.view %conv_history[%c0_offset] : buffer -> view<30720xf32>
  %history0 = view.load %history_view[%history_base] : view<30720xf32> -> f32
  %history1 = view.load %history_view[%history1_index] : view<30720xf32> -> f32
  %history2 = view.load %history_view[%history2_index] : view<30720xf32> -> f32
  %current = view.load %input_view[%channel] : view<10240xf32> -> f32
  %weight0 = view.load %weight_view[%weight_base] : view<40960xf32> -> f32
  %weight1 = view.load %weight_view[%weight1_index] : view<40960xf32> -> f32
  %weight2 = view.load %weight_view[%weight2_index] : view<40960xf32> -> f32
  %weight3 = view.load %weight_view[%weight3_index] : view<40960xf32> -> f32
  %product0 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %history0, %weight0 : f32
  %product1 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %history1, %weight1 : f32
  %product2 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %history2, %weight2 : f32
  %product3 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %current, %weight3 : f32
  %sum01 = scalar.addf<reassoc|nnan|ninf|nsz|contract> %product0, %product1 : f32
  %sum23 = scalar.addf<reassoc|nnan|ninf|nsz|contract> %product2, %product3 : f32
  %convolved = scalar.addf<reassoc|nnan|ninf|nsz|contract> %sum01, %sum23 : f32
  view.store %history1, %history_view[%history_base] : f32, view<30720xf32>
  view.store %history2, %history_view[%history1_index] : f32, view<30720xf32>
  view.store %current, %history_view[%history2_index] : f32, view<30720xf32>
  %activated = scalar.siluf<afn> %convolved : f32
  func.return %activated : f32
}

// One workgroup owns one Q/K head. Its first 128 lanes produce Q, its second
// 128 lanes produce K, and all lanes cooperatively produce the three matching
// V heads. Q/K reciprocal L2 norms remain separate metadata so the convolved
// values are written exactly once.
kernel.def export("qwen38_gdn_conv_prepare_decode") @qwen38_gdn_conv_prepare_decode() {
  %unit = index.constant 1 : index
  %key_head_count = index.constant 16 : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%key_head_count, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%l2_epsilon: f32, %qkv_input: buffer, %conv_weight: buffer, %conv_history: buffer, %qkv_silu: buffer, %qk_inverse_norm: buffer) {
  %head0 = kernel.workgroup.id<x> : index
  %head = index.assume %head0 [range(%head0, 0, 15)] : index
  %thread0 = kernel.workitem.id<x> : index
  %thread = index.assume %thread0 [range(%thread0, 0, 255)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c128 = index.constant 128 : index
  %c256 = index.constant 256 : index
  %c384 = index.constant 384 : index
  %q_channel_count = index.constant 2048 : index
  %v_channel_base = index.constant 4096 : index
  %values_per_key_head = index.constant 384 : index
  %c0_f32 = scalar.constant 0.0 : f32
  %c0_offset = index.constant 0 : offset
  %qkv_view = buffer.view %qkv_silu[%c0_offset] : buffer -> view<10240xf32>
  %inverse_norm_view = buffer.view %qk_inverse_norm[%c0_offset] : buffer -> view<32xf32>

  %head_channel_base = index.mul %head, %c128 : index
  %is_q_lane = index.cmp ult, %thread, %c128 : index
  %q_or_k_channel = scf.if %is_q_lane -> (index) {
    %q_channel0 = index.add %head_channel_base, %thread : index
    %q_channel = index.assume %q_channel0 [range(%q_channel0, 0, 2047)] : index
    scf.yield %q_channel : index
  } else {
    %k_lane = index.sub %thread, %c128 : index
    %k_head_channel = index.add %head_channel_base, %k_lane : index
    %k_channel0 = index.add %q_channel_count, %k_head_channel : index
    %k_channel = index.assume %k_channel0 [range(%k_channel0, 2048, 4095)] : index
    scf.yield %k_channel : index
  }
  %q_or_k_value = func.call @qwen38_gdn_conv_channel(%q_or_k_channel, %qkv_input, %conv_weight, %conv_history) : (index, buffer, buffer, buffer) -> (f32)
  view.store %q_or_k_value, %qkv_view[%q_or_k_channel] : f32, view<10240xf32>
  %q_or_k_square = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %q_or_k_value, %q_or_k_value : f32
  %q_square = scf.select %is_q_lane, %q_or_k_square, %c0_f32 : f32
  %k_square = scf.select %is_q_lane, %c0_f32, %q_or_k_square : f32

  %value_head_channel_base = index.mul %head, %values_per_key_head : index
  %value_thread1 = index.add %thread, %c256 : index
  %value0_channel_add = index.add %value_head_channel_base, %thread : index
  %value0_channel0 = index.add %v_channel_base, %value0_channel_add : index
  %value0_channel = index.assume %value0_channel0 [range(%value0_channel0, 4096, 10239)] : index
  %value0 = func.call @qwen38_gdn_conv_channel(%value0_channel, %qkv_input, %conv_weight, %conv_history) : (index, buffer, buffer, buffer) -> (f32)
  view.store %value0, %qkv_view[%value0_channel] : f32, view<10240xf32>
  %has_value1 = index.cmp ult, %value_thread1, %c384 : index
  scf.if %has_value1 {
    %value1_channel_add = index.add %value_head_channel_base, %value_thread1 : index
    %value1_channel0 = index.add %v_channel_base, %value1_channel_add : index
    %value1_channel = index.assume %value1_channel0 [range(%value1_channel0, 4096, 10239)] : index
    %value1 = func.call @qwen38_gdn_conv_channel(%value1_channel, %qkv_input, %conv_weight, %conv_history) : (index, buffer, buffer, buffer) -> (f32)
    view.store %value1, %qkv_view[%value1_channel] : f32, view<10240xf32>
  }

  %q_sum = kernel.workgroup.reduce<addf> %q_square : f32
  %k_sum = kernel.workgroup.reduce<addf> %k_square : f32
  %is_leader = index.cmp eq, %thread, %c0 : index
  scf.if %is_leader {
    %q_length = scalar.sqrtf<nnan|ninf|nsz|afn> %q_sum : f32
    %k_length = scalar.sqrtf<nnan|ninf|nsz|afn> %k_sum : f32
    %safe_q_length = scalar.maxnumf %q_length, %l2_epsilon : f32
    %safe_k_length = scalar.maxnumf %k_length, %l2_epsilon : f32
    %c1_f32 = scalar.constant 1.0 : f32
    %q_inverse = scalar.divf<nnan|ninf|nsz|arcp> %c1_f32, %safe_q_length : f32
    %k_inverse = scalar.divf<nnan|ninf|nsz|arcp> %c1_f32, %safe_k_length : f32
    %norm_base = index.mul %head, %c2 : index
    %k_norm_index = index.add %norm_base, %c1 : index
    view.store %q_inverse, %inverse_norm_view[%norm_base] : f32, view<32xf32>
    view.store %k_inverse, %inverse_norm_view[%k_norm_index] : f32, view<32xf32>
  }
  kernel.return
}

// Each 32-thread workgroup owns one recurrent-state column. Four coalesced
// loads per lane cover all 128 rows, and the state values stay live across the
// prediction reduction so the update performs no redundant state read.
kernel.def export("qwen38_gdn_recurrent_decode") @qwen38_gdn_recurrent_decode() {
  %unit = index.constant 1 : index
  %value_head_count = index.constant 48 : index
  %head_size = index.constant 128 : index
  %workgroup_size = index.constant 32 : index
  kernel.launch.config workgroups(%value_head_count, %head_size, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%qkv_silu: buffer, %qk_inverse_norm: buffer, %alpha: buffer, %beta: buffer, %ssm_a: buffer, %dt_bias: buffer, %state: buffer, %raw_output: buffer) {
  %value_head0 = kernel.workgroup.id<x> : index
  %value_head = index.assume %value_head0 [range(%value_head0, 0, 47)] : index
  %column0 = kernel.workgroup.id<y> : index
  %column = index.assume %column0 [range(%column0, 0, 127)] : index
  %lane0 = kernel.workitem.id<x> : index
  %lane = index.assume %lane0 [range(%lane0, 0, 31)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %c96 = index.constant 96 : index
  %c128 = index.constant 128 : index
  %q_channel_count = index.constant 2048 : index
  %v_channel_base = index.constant 4096 : index
  %value_heads_per_key_head = index.constant 3 : index
  %c0_offset = index.constant 0 : offset
  %qkv_view = buffer.view %qkv_silu[%c0_offset] : buffer -> view<10240xf32>
  %inverse_norm_view = buffer.view %qk_inverse_norm[%c0_offset] : buffer -> view<32xf32>
  %alpha_view = buffer.view %alpha[%c0_offset] : buffer -> view<48xf32>
  %beta_view = buffer.view %beta[%c0_offset] : buffer -> view<48xf32>
  %a_view = buffer.view %ssm_a[%c0_offset] : buffer -> view<48xf32>
  %bias_view = buffer.view %dt_bias[%c0_offset] : buffer -> view<48xf32>
  %state_view = buffer.view %state[%c0_offset] : buffer -> view<786432xf32>
  %output_view = buffer.view %raw_output[%c0_offset] : buffer -> view<6144xf32>

  %key_head = index.div %value_head, %value_heads_per_key_head : index
  %key_head_channel_base = index.mul %key_head, %c128 : index
  %q_row0 = index.add %key_head_channel_base, %lane : index
  %q_row1 = index.add %q_row0, %c32 : index
  %q_row2 = index.add %q_row0, %c64 : index
  %q_row3 = index.add %q_row0, %c96 : index
  %k_row0 = index.add %q_row0, %q_channel_count : index
  %k_row1 = index.add %q_row1, %q_channel_count : index
  %k_row2 = index.add %q_row2, %q_channel_count : index
  %k_row3 = index.add %q_row3, %q_channel_count : index
  %value_head_channel_base = index.mul %value_head, %c128 : index
  %value_channel_add = index.add %value_head_channel_base, %column : index
  %value_channel = index.add %v_channel_base, %value_channel_add : index
  %q_norm_index = index.mul %key_head, %c2 : index
  %k_norm_index = index.add %q_norm_index, %c1 : index
  %q_inverse = view.load %inverse_norm_view[%q_norm_index] : view<32xf32> -> f32
  %k_inverse = view.load %inverse_norm_view[%k_norm_index] : view<32xf32> -> f32
  %q0_raw = view.load %qkv_view[%q_row0] : view<10240xf32> -> f32
  %q1_raw = view.load %qkv_view[%q_row1] : view<10240xf32> -> f32
  %q2_raw = view.load %qkv_view[%q_row2] : view<10240xf32> -> f32
  %q3_raw = view.load %qkv_view[%q_row3] : view<10240xf32> -> f32
  %k0_raw = view.load %qkv_view[%k_row0] : view<10240xf32> -> f32
  %k1_raw = view.load %qkv_view[%k_row1] : view<10240xf32> -> f32
  %k2_raw = view.load %qkv_view[%k_row2] : view<10240xf32> -> f32
  %k3_raw = view.load %qkv_view[%k_row3] : view<10240xf32> -> f32
  %q0 = scalar.mulf<nnan|ninf|nsz> %q0_raw, %q_inverse : f32
  %q1 = scalar.mulf<nnan|ninf|nsz> %q1_raw, %q_inverse : f32
  %q2 = scalar.mulf<nnan|ninf|nsz> %q2_raw, %q_inverse : f32
  %q3 = scalar.mulf<nnan|ninf|nsz> %q3_raw, %q_inverse : f32
  %k0 = scalar.mulf<nnan|ninf|nsz> %k0_raw, %k_inverse : f32
  %k1 = scalar.mulf<nnan|ninf|nsz> %k1_raw, %k_inverse : f32
  %k2 = scalar.mulf<nnan|ninf|nsz> %k2_raw, %k_inverse : f32
  %k3 = scalar.mulf<nnan|ninf|nsz> %k3_raw, %k_inverse : f32

  %state_head_base = index.mul %value_head, %c128 : index
  %state_column = index.add %state_head_base, %column : index
  %state_column_base = index.mul %state_column, %c128 : index
  %state_index0 = index.add %state_column_base, %lane : index
  %state_index1 = index.add %state_index0, %c32 : index
  %state_index2 = index.add %state_index0, %c64 : index
  %state_index3 = index.add %state_index0, %c96 : index
  %state0 = view.load %state_view[%state_index0] : view<786432xf32> -> f32
  %state1 = view.load %state_view[%state_index1] : view<786432xf32> -> f32
  %state2 = view.load %state_view[%state_index2] : view<786432xf32> -> f32
  %state3 = view.load %state_view[%state_index3] : view<786432xf32> -> f32

  %alpha_raw = view.load %alpha_view[%value_head] : view<48xf32> -> f32
  %dt_bias_value = view.load %bias_view[%value_head] : view<48xf32> -> f32
  %alpha_biased = scalar.addf %alpha_raw, %dt_bias_value : f32
  %alpha_positive = scalar.softplusf<afn> %alpha_biased : f32
  %a = view.load %a_view[%value_head] : view<48xf32> -> f32
  %gate = scalar.mulf %alpha_positive, %a : f32
  %decay = scalar.expf<afn> %gate : f32
  %decayed0 = scalar.mulf<nnan|ninf|nsz> %state0, %decay : f32
  %decayed1 = scalar.mulf<nnan|ninf|nsz> %state1, %decay : f32
  %decayed2 = scalar.mulf<nnan|ninf|nsz> %state2, %decay : f32
  %decayed3 = scalar.mulf<nnan|ninf|nsz> %state3, %decay : f32
  %prediction0 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %decayed0, %k0 : f32
  %prediction1 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %decayed1, %k1 : f32
  %prediction2 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %decayed2, %k2 : f32
  %prediction3 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %decayed3, %k3 : f32
  %prediction01 = scalar.addf<reassoc|nnan|ninf|nsz|contract> %prediction0, %prediction1 : f32
  %prediction23 = scalar.addf<reassoc|nnan|ninf|nsz|contract> %prediction2, %prediction3 : f32
  %prediction_partial = scalar.addf<reassoc|nnan|ninf|nsz|contract> %prediction01, %prediction23 : f32
  %prediction = kernel.workgroup.reduce<addf> %prediction_partial : f32
  %value = view.load %qkv_view[%value_channel] : view<10240xf32> -> f32
  %residual = scalar.subf %value, %prediction : f32
  %beta_raw = view.load %beta_view[%value_head] : view<48xf32> -> f32
  %beta_value = scalar.logisticf<afn> %beta_raw : f32
  %delta = scalar.mulf %residual, %beta_value : f32
  %update0 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %k0, %delta : f32
  %update1 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %k1, %delta : f32
  %update2 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %k2, %delta : f32
  %update3 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %k3, %delta : f32
  %new_state0 = scalar.addf<reassoc|nnan|ninf|nsz|contract> %decayed0, %update0 : f32
  %new_state1 = scalar.addf<reassoc|nnan|ninf|nsz|contract> %decayed1, %update1 : f32
  %new_state2 = scalar.addf<reassoc|nnan|ninf|nsz|contract> %decayed2, %update2 : f32
  %new_state3 = scalar.addf<reassoc|nnan|ninf|nsz|contract> %decayed3, %update3 : f32
  view.store %new_state0, %state_view[%state_index0] : f32, view<786432xf32>
  view.store %new_state1, %state_view[%state_index1] : f32, view<786432xf32>
  view.store %new_state2, %state_view[%state_index2] : f32, view<786432xf32>
  view.store %new_state3, %state_view[%state_index3] : f32, view<786432xf32>
  %output0 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %new_state0, %q0 : f32
  %output1 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %new_state1, %q1 : f32
  %output2 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %new_state2, %q2 : f32
  %output3 = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %new_state3, %q3 : f32
  %output01 = scalar.addf<reassoc|nnan|ninf|nsz|contract> %output0, %output1 : f32
  %output23 = scalar.addf<reassoc|nnan|ninf|nsz|contract> %output2, %output3 : f32
  %output_partial = scalar.addf<reassoc|nnan|ninf|nsz|contract> %output01, %output23 : f32
  %output = kernel.workgroup.reduce<addf> %output_partial : f32
  %is_leader = index.cmp eq, %lane, %c0 : index
  scf.if %is_leader {
    %head_output_base = index.mul %value_head, %c128 : index
    %output_index = index.add %head_output_base, %column : index
    %attention_scale = scalar.constant 0.08838834764831845 : f32
    %scaled_output = scalar.mulf<nnan|ninf|nsz> %output, %attention_scale : f32
    view.store %scaled_output, %output_view[%output_index] : f32, view<6144xf32>
  }
  kernel.return
}

// Four-column schedule for the same recurrence. Each lane carries four state
// values for each of its four row stripes, amortizing Q/K and gate loads while
// retaining coalesced state transactions. Vector workgroup reductions keep the
// four independent columns in one source operation.
kernel.def export("qwen38_gdn_recurrent_decode_x4") @qwen38_gdn_recurrent_decode_x4() {
  %unit = index.constant 1 : index
  %value_head_count = index.constant 48 : index
  %column_tile_count = index.constant 32 : index
  %workgroup_size = index.constant 32 : index
  kernel.launch.config workgroups(%value_head_count, %column_tile_count, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%qkv_silu: buffer, %qk_inverse_norm: buffer, %alpha: buffer, %beta: buffer, %ssm_a: buffer, %dt_bias: buffer, %state: buffer, %raw_output: buffer) {
  %value_head0 = kernel.workgroup.id<x> : index
  %value_head = index.assume %value_head0 [range(%value_head0, 0, 47)] : index
  %column_tile0 = kernel.workgroup.id<y> : index
  %column_tile = index.assume %column_tile0 [range(%column_tile0, 0, 31)] : index
  %lane0 = kernel.workitem.id<x> : index
  %lane = index.assume %lane0 [range(%lane0, 0, 31)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %c96 = index.constant 96 : index
  %c128 = index.constant 128 : index
  %q_channel_count = index.constant 2048 : index
  %v_channel_base = index.constant 4096 : index
  %value_heads_per_key_head = index.constant 3 : index
  %c0_offset = index.constant 0 : offset
  %state_column_offsets = vector.iota %c0 step %c128 : vector<4xindex>
  %qkv_view = buffer.view %qkv_silu[%c0_offset] : buffer -> view<10240xf32>
  %inverse_norm_view = buffer.view %qk_inverse_norm[%c0_offset] : buffer -> view<32xf32>
  %alpha_view = buffer.view %alpha[%c0_offset] : buffer -> view<48xf32>
  %beta_view = buffer.view %beta[%c0_offset] : buffer -> view<48xf32>
  %a_view = buffer.view %ssm_a[%c0_offset] : buffer -> view<48xf32>
  %bias_view = buffer.view %dt_bias[%c0_offset] : buffer -> view<48xf32>
  %state_view = buffer.view %state[%c0_offset] : buffer -> view<786432xf32>
  %output_view = buffer.view %raw_output[%c0_offset] : buffer -> view<6144xf32>

  %key_head = index.div %value_head, %value_heads_per_key_head : index
  %key_head_channel_base = index.mul %key_head, %c128 : index
  %q_row0 = index.add %key_head_channel_base, %lane : index
  %q_row1 = index.add %q_row0, %c32 : index
  %q_row2 = index.add %q_row0, %c64 : index
  %q_row3 = index.add %q_row0, %c96 : index
  %k_row0 = index.add %q_row0, %q_channel_count : index
  %k_row1 = index.add %q_row1, %q_channel_count : index
  %k_row2 = index.add %q_row2, %q_channel_count : index
  %k_row3 = index.add %q_row3, %q_channel_count : index
  %q_norm_index = index.mul %key_head, %c2 : index
  %k_norm_index = index.add %q_norm_index, %c1 : index
  %q_inverse = view.load %inverse_norm_view[%q_norm_index] : view<32xf32> -> f32
  %k_inverse = view.load %inverse_norm_view[%k_norm_index] : view<32xf32> -> f32
  %q0_raw = view.load %qkv_view[%q_row0] : view<10240xf32> -> f32
  %q1_raw = view.load %qkv_view[%q_row1] : view<10240xf32> -> f32
  %q2_raw = view.load %qkv_view[%q_row2] : view<10240xf32> -> f32
  %q3_raw = view.load %qkv_view[%q_row3] : view<10240xf32> -> f32
  %k0_raw = view.load %qkv_view[%k_row0] : view<10240xf32> -> f32
  %k1_raw = view.load %qkv_view[%k_row1] : view<10240xf32> -> f32
  %k2_raw = view.load %qkv_view[%k_row2] : view<10240xf32> -> f32
  %k3_raw = view.load %qkv_view[%k_row3] : view<10240xf32> -> f32
  %q0 = scalar.mulf<nnan|ninf|nsz> %q0_raw, %q_inverse : f32
  %q1 = scalar.mulf<nnan|ninf|nsz> %q1_raw, %q_inverse : f32
  %q2 = scalar.mulf<nnan|ninf|nsz> %q2_raw, %q_inverse : f32
  %q3 = scalar.mulf<nnan|ninf|nsz> %q3_raw, %q_inverse : f32
  %k0 = scalar.mulf<nnan|ninf|nsz> %k0_raw, %k_inverse : f32
  %k1 = scalar.mulf<nnan|ninf|nsz> %k1_raw, %k_inverse : f32
  %k2 = scalar.mulf<nnan|ninf|nsz> %k2_raw, %k_inverse : f32
  %k3 = scalar.mulf<nnan|ninf|nsz> %k3_raw, %k_inverse : f32
  %q0_vector = vector.splat %q0 : vector<4xf32>
  %q1_vector = vector.splat %q1 : vector<4xf32>
  %q2_vector = vector.splat %q2 : vector<4xf32>
  %q3_vector = vector.splat %q3 : vector<4xf32>
  %k0_vector = vector.splat %k0 : vector<4xf32>
  %k1_vector = vector.splat %k1 : vector<4xf32>
  %k2_vector = vector.splat %k2 : vector<4xf32>
  %k3_vector = vector.splat %k3 : vector<4xf32>

  %column_base = index.mul %column_tile, %c4 : index
  %state_head_base = index.mul %value_head, %c128 : index
  %state_column = index.add %state_head_base, %column_base : index
  %state_column_base = index.mul %state_column, %c128 : index
  %state_index0 = index.add %state_column_base, %lane : index
  %state_index1 = index.add %state_index0, %c32 : index
  %state_index2 = index.add %state_index0, %c64 : index
  %state_index3 = index.add %state_index0, %c96 : index
  %state0 = vector.gather %state_view[%state_index0][%state_column_offsets] : view<786432xf32>, vector<4xindex> -> vector<4xf32>
  %state1 = vector.gather %state_view[%state_index1][%state_column_offsets] : view<786432xf32>, vector<4xindex> -> vector<4xf32>
  %state2 = vector.gather %state_view[%state_index2][%state_column_offsets] : view<786432xf32>, vector<4xindex> -> vector<4xf32>
  %state3 = vector.gather %state_view[%state_index3][%state_column_offsets] : view<786432xf32>, vector<4xindex> -> vector<4xf32>

  %alpha_raw = view.load %alpha_view[%value_head] : view<48xf32> -> f32
  %dt_bias_value = view.load %bias_view[%value_head] : view<48xf32> -> f32
  %alpha_biased = scalar.addf %alpha_raw, %dt_bias_value : f32
  %alpha_positive = scalar.softplusf<afn> %alpha_biased : f32
  %a = view.load %a_view[%value_head] : view<48xf32> -> f32
  %gate = scalar.mulf %alpha_positive, %a : f32
  %decay = scalar.expf<afn> %gate : f32
  %decay_vector = vector.splat %decay : vector<4xf32>
  %decayed0 = vector.mulf<nnan|ninf|nsz> %state0, %decay_vector : vector<4xf32>
  %decayed1 = vector.mulf<nnan|ninf|nsz> %state1, %decay_vector : vector<4xf32>
  %decayed2 = vector.mulf<nnan|ninf|nsz> %state2, %decay_vector : vector<4xf32>
  %decayed3 = vector.mulf<nnan|ninf|nsz> %state3, %decay_vector : vector<4xf32>
  %prediction0 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %decayed0, %k0_vector : vector<4xf32>
  %prediction1 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %decayed1, %k1_vector : vector<4xf32>
  %prediction2 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %decayed2, %k2_vector : vector<4xf32>
  %prediction3 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %decayed3, %k3_vector : vector<4xf32>
  %prediction01 = vector.addf<reassoc|nnan|ninf|nsz|contract> %prediction0, %prediction1 : vector<4xf32>
  %prediction23 = vector.addf<reassoc|nnan|ninf|nsz|contract> %prediction2, %prediction3 : vector<4xf32>
  %prediction_partial = vector.addf<reassoc|nnan|ninf|nsz|contract> %prediction01, %prediction23 : vector<4xf32>
  %prediction = kernel.workgroup.reduce<addf> %prediction_partial : vector<4xf32>
  %value_head_channel_base = index.mul %value_head, %c128 : index
  %value_channel0 = index.add %v_channel_base, %value_head_channel_base : index
  %value_channel = index.add %value_channel0, %column_base : index
  %value = vector.load %qkv_view[%value_channel] : view<10240xf32> -> vector<4xf32>
  %residual = vector.subf %value, %prediction : vector<4xf32>
  %beta_raw = view.load %beta_view[%value_head] : view<48xf32> -> f32
  %beta_value = scalar.logisticf<afn> %beta_raw : f32
  %beta_vector = vector.splat %beta_value : vector<4xf32>
  %delta = vector.mulf %residual, %beta_vector : vector<4xf32>
  %update0 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %k0_vector, %delta : vector<4xf32>
  %update1 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %k1_vector, %delta : vector<4xf32>
  %update2 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %k2_vector, %delta : vector<4xf32>
  %update3 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %k3_vector, %delta : vector<4xf32>
  %new_state0 = vector.addf<reassoc|nnan|ninf|nsz|contract> %decayed0, %update0 : vector<4xf32>
  %new_state1 = vector.addf<reassoc|nnan|ninf|nsz|contract> %decayed1, %update1 : vector<4xf32>
  %new_state2 = vector.addf<reassoc|nnan|ninf|nsz|contract> %decayed2, %update2 : vector<4xf32>
  %new_state3 = vector.addf<reassoc|nnan|ninf|nsz|contract> %decayed3, %update3 : vector<4xf32>
  vector.scatter %new_state0, %state_view[%state_index0][%state_column_offsets] : vector<4xf32>, view<786432xf32>, vector<4xindex>
  vector.scatter %new_state1, %state_view[%state_index1][%state_column_offsets] : vector<4xf32>, view<786432xf32>, vector<4xindex>
  vector.scatter %new_state2, %state_view[%state_index2][%state_column_offsets] : vector<4xf32>, view<786432xf32>, vector<4xindex>
  vector.scatter %new_state3, %state_view[%state_index3][%state_column_offsets] : vector<4xf32>, view<786432xf32>, vector<4xindex>
  %output0 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %new_state0, %q0_vector : vector<4xf32>
  %output1 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %new_state1, %q1_vector : vector<4xf32>
  %output2 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %new_state2, %q2_vector : vector<4xf32>
  %output3 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %new_state3, %q3_vector : vector<4xf32>
  %output01 = vector.addf<reassoc|nnan|ninf|nsz|contract> %output0, %output1 : vector<4xf32>
  %output23 = vector.addf<reassoc|nnan|ninf|nsz|contract> %output2, %output3 : vector<4xf32>
  %output_partial = vector.addf<reassoc|nnan|ninf|nsz|contract> %output01, %output23 : vector<4xf32>
  %output4 = kernel.workgroup.reduce<addf> %output_partial : vector<4xf32>
  %is_leader = index.cmp eq, %lane, %c0 : index
  scf.if %is_leader {
    %head_output_base = index.mul %value_head, %c128 : index
    %output_index = index.add %head_output_base, %column_base : index
    %attention_scale = vector.constant 0.08838834764831845 : vector<4xf32>
    %scaled_output = vector.mulf<nnan|ninf|nsz> %output4, %attention_scale : vector<4xf32>
    vector.store %scaled_output, %output_view[%output_index] : vector<4xf32>, view<6144xf32>
  }
  kernel.return
}

// Fuses per-head RMSNorm, the shared 128-value norm weight, and SiLU gating
// by the raw z projection. The result is ready for the Q6_K output projection.
kernel.def export("qwen38_gdn_norm_gate_decode") @qwen38_gdn_norm_gate_decode() {
  %unit = index.constant 1 : index
  %value_head_count = index.constant 48 : index
  %workgroup_size = index.constant 128 : index
  kernel.launch.config workgroups(%value_head_count, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%rms_epsilon: f32, %raw_output: buffer, %norm_weight: buffer, %z: buffer, %output: buffer) {
  %head0 = kernel.workgroup.id<x> : index
  %head = index.assume %head0 [range(%head0, 0, 47)] : index
  %lane0 = kernel.workitem.id<x> : index
  %lane = index.assume %lane0 [range(%lane0, 0, 127)] : index
  %c128 = index.constant 128 : index
  %c128_f32 = scalar.constant 128.0 : f32
  %c0_offset = index.constant 0 : offset
  %raw_view = buffer.view %raw_output[%c0_offset] : buffer -> view<6144xf32>
  %weight_view = buffer.view %norm_weight[%c0_offset] : buffer -> view<128xf32>
  %z_view = buffer.view %z[%c0_offset] : buffer -> view<6144xf32>
  %output_view = buffer.view %output[%c0_offset] : buffer -> view<6144xf32>
  %head_base = index.mul %head, %c128 : index
  %index = index.add %head_base, %lane : index
  %value = view.load %raw_view[%index] : view<6144xf32> -> f32
  %square = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %value, %value : f32
  %sum = kernel.workgroup.reduce<addf> %square : f32
  %mean = scalar.divf<nnan|ninf|nsz|arcp> %sum, %c128_f32 : f32
  %biased_mean = scalar.addf %mean, %rms_epsilon : f32
  %inverse_rms = scalar.rsqrtf<nnan|ninf|nsz|afn> %biased_mean : f32
  %weight = view.load %weight_view[%lane] : view<128xf32> -> f32
  %normalized0 = scalar.mulf<nnan|ninf|nsz> %value, %inverse_rms : f32
  %normalized = scalar.mulf<nnan|ninf|nsz> %normalized0, %weight : f32
  %z_value = view.load %z_view[%index] : view<6144xf32> -> f32
  %gate = scalar.siluf<afn> %z_value : f32
  %result = scalar.mulf<nnan|ninf|nsz> %normalized, %gate : f32
  view.store %result, %output_view[%index] : f32, view<6144xf32>
  kernel.return
}

// Production-shape timing boundary for the three recurrent primitives. The
// quantized projections on either side are benchmarked independently.
check.case public @qwen38_gdn_decode_benchmark_case {
  %l2_epsilon = check.literal value(0.000001) : f32
  %rms_epsilon = check.literal value(0.000001) : f32
  %qkv_input = check.generate.fill value(0.125) : tensor<10240xf32>
  %conv_weight = check.generate.fill value(0.25) : tensor<40960xf32>
  %conv_history = check.generate.fill value(-0.0625) : tensor<30720xf32>
  %qkv_silu = check.generate.fill value(0.0) : tensor<10240xf32>
  %qk_inverse_norm = check.generate.fill value(0.0) : tensor<32xf32>
  %alpha = check.generate.fill value(0.125) : tensor<48xf32>
  %beta = check.generate.fill value(-0.25) : tensor<48xf32>
  %ssm_a = check.generate.fill value(-0.5) : tensor<48xf32>
  %dt_bias = check.generate.fill value(0.0625) : tensor<48xf32>
  %state = check.generate.fill value(0.03125) : tensor<786432xf32>
  %raw_output = check.generate.fill value(0.0) : tensor<6144xf32>
  %norm_weight = check.generate.fill value(1.0) : tensor<128xf32>
  %z = check.generate.fill value(0.25) : tensor<6144xf32>
  %output = check.generate.fill value(0.0) : tensor<6144xf32>
  kernel.launch @qwen38_gdn_conv_prepare_decode(%l2_epsilon, %qkv_input, %conv_weight, %conv_history, %qkv_silu, %qk_inverse_norm) : (f32, tensor<10240xf32>, tensor<40960xf32>, tensor<30720xf32>, tensor<10240xf32>, tensor<32xf32>)
  kernel.launch @qwen38_gdn_recurrent_decode_x4(%qkv_silu, %qk_inverse_norm, %alpha, %beta, %ssm_a, %dt_bias, %state, %raw_output) : (tensor<10240xf32>, tensor<32xf32>, tensor<48xf32>, tensor<48xf32>, tensor<48xf32>, tensor<48xf32>, tensor<786432xf32>, tensor<6144xf32>)
  kernel.launch @qwen38_gdn_norm_gate_decode(%rms_epsilon, %raw_output, %norm_weight, %z, %output) : (f32, tensor<6144xf32>, tensor<128xf32>, tensor<6144xf32>, tensor<6144xf32>)
  check.return
}

check.benchmark<@qwen38_gdn_decode_benchmark_case> @qwen38_gdn_decode

check.case public @qwen38_gdn_conv_prepare_decode_known_case {
  %l2_epsilon = check.literal value(0.000001) : f32
  %qkv_input = check.generate.fill value(0.125) : tensor<10240xf32>
  %conv_weight = check.generate.fill value(0.25) : tensor<40960xf32>
  %conv_history = check.generate.fill value(-0.0625) : tensor<30720xf32>
  %qkv_silu = check.generate.fill value(0.0) : tensor<10240xf32>
  %qk_inverse_norm = check.generate.fill value(0.0) : tensor<32xf32>
  %expected_qkv = check.generate.fill value(-0.0077514660854831182) : tensor<10240xf32>
  %expected_inverse_norm = check.generate.fill value(11.402790991223119) : tensor<32xf32>
  kernel.launch @qwen38_gdn_conv_prepare_decode(%l2_epsilon, %qkv_input, %conv_weight, %conv_history, %qkv_silu, %qk_inverse_norm) : (f32, tensor<10240xf32>, tensor<40960xf32>, tensor<30720xf32>, tensor<10240xf32>, tensor<32xf32>)
  check.expect.close actual(%qkv_silu) expected(%expected_qkv) atol(0.000001) rtol(0.000001) nan(same) : tensor<10240xf32>
  check.expect.close actual(%qk_inverse_norm) expected(%expected_inverse_norm) atol(0.00001) rtol(0.000001) nan(same) : tensor<32xf32>
  check.return
}

