kernel.def target(@qwen38_dense_gfx11_wave64_split_k) export("qwen38_linear_q5k_f16_wmma_alpha_split_k_reduce") @qwen38_linear_q5k_f16_wmma_alpha_split_k_reduce(%token_count0: index) {
  %token_count = index.assume %token_count0 [range(%token_count0, 0, 32), mul(%token_count0, 32)] : index
  %c1 = index.constant 1 : index
  %c12 = index.constant 12 : index
  %c255 = index.constant 255 : index
  %c256 = index.constant 256 : index
  %packet_count = index.mul %token_count, %c12 : index
  %padded_packet_count = index.add %packet_count, %c255 : index
  %workgroups = index.div %padded_packet_count, %c256 : index
  kernel.launch.config workgroups(%workgroups, %c1, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%token_count_data: buffer, %partials: buffer, %output: buffer) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c7 = index.constant 7 : index
  %c12 = index.constant 12 : index
  %c48 = index.constant 48 : index
  %c256 = index.constant 256 : index
  %c384 = index.constant 384 : index
  %c0_offset = index.constant 0 : offset
  %zero = vector.constant 0.0 : vector<4xf32>
  %workgroup = kernel.workgroup.id<x> : index
  %workitem = kernel.workitem.id<x> : index
  %workgroup_base = index.mul %workgroup, %c256 : index
  %packet0 = index.add %workgroup_base, %workitem : index
  %valid = index.cmp ult, %packet0, %c384 : index
  %partials_view = buffer.view %partials[%c0_offset] : buffer -> view<7x32x48xf32>
  %output_view = buffer.view %output[%c0_offset] : buffer -> view<32x48xf32>
  scf.if %valid {
    %packet = index.assume %packet0 [range(%packet0, 0, 383)] : index
    %token0 = index.div %packet, %c12 : index
    %token = index.assume %token0 [range(%token0, 0, 31)] : index
    %channel_packet0 = index.rem %packet, %c12 : index
    %channel_packet = index.assume %channel_packet0 [range(%channel_packet0, 0, 11)] : index
    %channel = index.mul %channel_packet, %c4 : index
    %sum = scf.for %split = [%c0 to %c7 step %c1](%accumulator = %zero : vector<4xf32>) -> (vector<4xf32>) unroll {
      %partial = vector.load %partials_view[%split, %token, %channel] : view<7x32x48xf32> -> vector<4xf32>
      %next = vector.addf %accumulator, %partial : vector<4xf32>
      scf.yield %next : vector<4xf32>
    }
    vector.store %sum, %output_view[%token, %channel] : vector<4xf32>, view<32x48xf32>
  }
  kernel.return
}

