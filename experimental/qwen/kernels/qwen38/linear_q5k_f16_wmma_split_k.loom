  %publish_token = index.assume %publish_token0 [range(%publish_token0, 0, 15)] : index
  %publish_packet0 = index.rem %lane, %c4 : index
  %publish_packet = index.assume %publish_packet0 [range(%publish_packet0, 0, 3)] : index
  %publish_channel_add = index.mul %publish_packet, %c4 : index
  %publish_token1 = index.add %publish_token, %c16 : index
  %channel0 = index.add %subgroup_channel_add, %publish_channel_add : index
  %last_channel_packet_start = index.constant 45 : index
  %writes_channel = index.cmp ult, %channel0, %last_channel_packet_start : index
  vector.fragment.store<result> %result0, %result_fragment_view[%c0, %c0] shape [%m, %n] : vector<4xf32>, view<16x16xf32>
