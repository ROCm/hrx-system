// Exact-Q5_K split-K schedule for narrow prefill projections.
//
// Seven workgroups partition the canonical 5120-wide reduction into aligned
// Q5_K block ranges. Each produces F32 partials; a deterministic second kernel
// sums those partials in split order into the F32 model tensor.

func.decl @qwen38_q5k_f16_vector4_prescaled(%weight: buffer, %row_byte_base: offset, %q5_block: index, %q5_group: index, %packet: index, %d_scale: f32, %dmin_scale: f32) -> (vector<4xf16>)

kernel.decl @qwen38_linear_q5k_f16_wmma(%token_count: index, %input_size: index, %output_size: index) launch(%token_count_data: buffer, %input_size_data: index, %output_size_data: index, %input: buffer, %weight: buffer, %output: buffer)

amdgpu.target<gfx11-generic> @qwen38_dense_gfx11_wave64_split_k {subgroup_size = 64}

kernel.def target(@qwen38_dense_gfx11_wave64_split_k) export("qwen38_linear_q5k_f16_wmma_alpha_split_k") @qwen38_linear_q5k_f16_wmma_alpha_split_k(%token_count0: index, %input_size0: index, %output_size0: index) {
  %token_count = index.assume %token_count0 [range(%token_count0, 0, 32), mul(%token_count0, 32)] : index
  %input_size = index.assume %input_size0 [range(%input_size0, 5120, 5120)] : index
  %output_size = index.assume %output_size0 [range(%output_size0, 48, 48)] : index
  %c1 = index.constant 1 : index
  %c7 = index.constant 7 : index
  %c32 = index.constant 32 : index
  %c256 = index.constant 256 : index
  %token_tiles = index.div %token_count, %c32 : index
  kernel.launch.config workgroups(%c1, %token_tiles, %c7) workgroup_size(%c256, %c1, %c1) : index
} launch(%token_count_data: buffer, %input_size0: index, %output_size0: index, %input: buffer, %weight: buffer, %partials: buffer) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c20 = index.constant 20 : index
  %c32 = index.constant 32 : index
  %c40 = index.constant 40 : index
  %c48 = index.constant 48 : index
  %c64 = index.constant 64 : index
  %c256 = index.constant 256 : index
  %c512 = index.constant 512 : index
  %c0_offset = index.constant 0 : offset
  %weight_block_byte_count = index.constant 176 : index
  %weight_block_bytes = index.constant 176 : offset
  %weight_stage_bytes = index.constant 5120 : offset
  %activation_stage_bytes = index.constant 2560 : offset
  %metadata_stage_bytes = index.constant 4096 : offset
  %wave_result_stage_bytes = index.constant 1024 : offset
  %result_stage_bytes = index.constant 4096 : offset
  %partial_split_bytes = index.constant 6144 : offset
  %c0_f16x4 = vector.constant 0.0 : vector<4xf16>
  %c0_f32x2 = vector.constant 0.0 : vector<2xf32>
  %zero_accumulator = vector.constant 0.0 : vector<4xf32>
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %token_count_view = buffer.view %token_count_data[%c0_offset] : buffer -> view<1xi32>
  %token_count_i32 = view.load %token_count_view[%c0] : view<1xi32> -> i32
  %token_count_raw = index.cast %token_count_i32 : i32 to index
  %token_count = index.assume %token_count_raw [range(%token_count_raw, 32, 32)] : index
  %input_size = index.assume %input_size0 [range(%input_size0, 5120, 5120)] : index
  %output_size = index.assume %output_size0 [range(%output_size0, 48, 48)] : index
  %last_input_pair_start = index.sub %input_size, %c1 : index
  %quant_block_count = index.div %input_size, %c256 : index
  %weight_row_bytes = index.mul %quant_block_count, %weight_block_byte_count : index
  %split_index0 = kernel.workgroup.id<z> : index
  %split_index = index.assume %split_index0 [range(%split_index0, 0, 6)] : index
  %quant_block_start = index.mul %split_index, %c3 : index
  %quant_block_end0 = index.add %quant_block_start, %c3 : index
  %quant_block_end = index.min %quant_block_end0, %c20 : index
  %workitem0 = kernel.workitem.id<x> : index
  %workitem = index.assume %workitem0 [range(%workitem0, 0, 255)] : index
  %subgroup0 = kernel.subgroup.id : index
  %subgroup = index.assume %subgroup0 [range(%subgroup0, 0, 3)] : index
  %lane = kernel.subgroup.lane.id : index
  %subgroup_channel_add = index.mul %subgroup, %c16 : index
  %partial_offset = index.scale %split_index, %partial_split_bytes : index, offset -> offset
  %input_noalias, %weight_noalias, %partials_noalias = buffer.assume.noalias %input, %weight, %partials : buffer, buffer, buffer
  %input_view = buffer.view %input_noalias[%c0_offset] : buffer -> view<32x5120xf32>
  %partial_view = buffer.view %partials_noalias[%partial_offset] : buffer -> view<32x48xf32>
  %weight_stage = buffer.alloca<workgroup> align(16) %weight_stage_bytes : buffer
  %activation_stage = buffer.alloca<workgroup> align(16) %activation_stage_bytes : buffer
  %metadata_stage = buffer.alloca<workgroup> align(16) %metadata_stage_bytes : buffer
  %result_stage = buffer.alloca<workgroup> align(16) %result_stage_bytes : buffer
