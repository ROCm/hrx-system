check.case public @qwen38_mtp_preserve_prefill_inputs_case {
  %token_count = check.literal value(3) : index
  %token_ids = check.generate.iota offset(17) step(2) : tensor<512xi32>
  %control = check.generate.iota offset(3) step(41) : tensor<2xi32>
  %pending_hidden = check.generate.iota offset(-2560.0) step(1.0) : tensor<5120xf32>
  %saved_token_ids = check.generate.fill value(-1) : tensor<512xi32>
  %saved_control = check.generate.fill value(-1) : tensor<2xi32>
  %saved_pending_hidden = check.generate.fill value(0.0) : tensor<5120xf32>
  kernel.launch @qwen38_mtp_preserve_prefill_inputs[](%token_ids, %control, %pending_hidden, %saved_token_ids, %saved_control, %saved_pending_hidden) : [](tensor<512xi32>, tensor<2xi32>, tensor<5120xf32>, tensor<512xi32>, tensor<2xi32>, tensor<5120xf32>)
  %actual_tokens = check.tensor.view %saved_token_ids offset(0) : tensor<512xi32> -> tensor<3xi32>
  %expected_tokens = check.generate.iota offset(17) step(2) : tensor<3xi32>
  check.expect.equal actual(%actual_tokens) expected(%expected_tokens) : tensor<3xi32>
  check.expect.equal actual(%saved_control) expected(%control) : tensor<2xi32>
  check.expect.close actual(%saved_pending_hidden) expected(%pending_hidden) atol(0.0) rtol(0.0) nan(same) : tensor<5120xf32>
  check.return
}

