// Qwen3.8 NextN/MTP batched input preparation.
//
// Target-model hidden rows are already normalized by output_norm. The stored
// NextN block applies its own hnorm and combines each row with an independently
// normalized token embedding. These kernels write the concatenated activation
// directly and shift target rows without materializing duplicate dense inputs.

// Normalizes one dense input matrix into one half of the interleaved
// [token_count, 10240] activation consumed by nextn.eh_proj. The exported
// wrappers make the two physical columns compile-time address facts.
func.template<qwen38.mtp_rmsnorm_concat_f32_prefill.body> device @qwen38_mtp_rmsnorm_concat_f32_prefill_body(%token_capacity0: index, %column_offset: index, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer) {
  %token_capacity = index.assume %token_capacity0 [range(%token_capacity0, 1, 512)] : index
  %token0 = kernel.workgroup.id<y> : index
  %token = index.assume %token0 [lt(%token0, %token_capacity)] : index
  %lane0 = kernel.workitem.id<x> : index
  %lane = index.assume %lane0 [range(%lane0, 0, 255)] : index
  %c0_offset = index.constant 0 : offset
  %workgroup_size = index.constant 256 : index
  %hidden_size = index.constant 5120 : index
  %c0_f32 = scalar.constant 0.0 : f32
  %input_noalias, %weight_noalias, %output_noalias = buffer.assume.noalias %input, %weight, %output : buffer, buffer, buffer
  %input_view = buffer.view %input_noalias[%c0_offset] : buffer -> view<[%token_capacity]x5120xf32>
  %weight_view = buffer.view %weight_noalias[%c0_offset] : buffer -> view<5120xf32>
  %output_view = buffer.view %output_noalias[%c0_offset] : buffer -> view<[%token_capacity]x10240xf32>
  %thread_sum = scf.for %element = [%lane to %hidden_size step %workgroup_size](%partial_sum = %c0_f32 : f32) -> (f32) {
    %input_value = view.load %input_view[%token, %element] : view<[%token_capacity]x5120xf32> -> f32
    %square = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %input_value, %input_value : f32
    %next_sum = scalar.addf<reassoc|nnan|ninf|nsz> %partial_sum, %square : f32
    scf.yield %next_sum : f32
  }
  %sum = kernel.workgroup.reduce<addf> %thread_sum : f32
  %element_count_f32 = scalar.constant 5120.0 : f32
  %mean = scalar.divf<nnan|ninf|nsz|arcp> %sum, %element_count_f32 : f32
  %biased_mean = scalar.addf<nnan|ninf|nsz> %mean, %epsilon : f32
  %inverse_rms = scalar.rsqrtf<nnan|ninf|nsz|afn> %biased_mean : f32
  scf.for %element = [%lane to %hidden_size step %workgroup_size] {
    %input_value = view.load %input_view[%token, %element] : view<[%token_capacity]x5120xf32> -> f32
    %weight = view.load %weight_view[%element] : view<5120xf32> -> f32
    %normalized = scalar.mulf<nnan|ninf|nsz> %input_value, %inverse_rms : f32
    %result = scalar.mulf<nnan|ninf|nsz> %normalized, %weight : f32
    %output_element0 = index.add %column_offset, %element : index
    %output_element = index.assume %output_element0 [range(%output_element0, 0, 10239)] : index
    view.store %result, %output_view[%token, %output_element] : f32, view<[%token_capacity]x10240xf32>
  }
  func.return
}

kernel.def export("qwen38_mtp_rmsnorm_concat_embedding_f32_prefill") @qwen38_mtp_rmsnorm_concat_embedding_f32_prefill(%token_count0: index) {
  %token_count = index.assume %token_count0 [range(%token_count0, 1, 512)] : index
  %c1 = index.constant 1 : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%c1, %token_count, %c1) workgroup_size(%workgroup_size, %c1, %c1) : index
} launch(%token_capacity: index, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer) {
  %column_offset = index.constant 0 : index
  func.apply<qwen38.mtp_rmsnorm_concat_f32_prefill.body>(%token_capacity, %column_offset, %epsilon, %input, %weight, %output) : (index, index, f32, buffer, buffer, buffer)
  kernel.return
}

kernel.def export("qwen38_mtp_rmsnorm_concat_hidden_f32_prefill") @qwen38_mtp_rmsnorm_concat_hidden_f32_prefill(%token_count0: index) {
  %token_count = index.assume %token_count0 [range(%token_count0, 1, 512)] : index
  %c1 = index.constant 1 : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%c1, %token_count, %c1) workgroup_size(%workgroup_size, %c1, %c1) : index
} launch(%token_capacity: index, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer) {
  %column_offset = index.constant 5120 : index
  func.apply<qwen38.mtp_rmsnorm_concat_f32_prefill.body>(%token_capacity, %column_offset, %epsilon, %input, %weight, %output) : (index, index, f32, buffer, buffer, buffer)
  kernel.return
}

// Forms the hidden rows consumed while catching the MTP cache up to a target
// batch. Row zero comes from the target carry; every later row consumes the
// normalized target hidden produced by the preceding token.
kernel.def export("qwen38_mtp_shift_hidden_rows") @qwen38_mtp_shift_hidden_rows(%token_count0: index) {
  %token_count = index.assume %token_count0 [range(%token_count0, 1, 512)] : index
  %workgroup_count = index.constant 5 : index
  %workgroup_size = index.constant 256 : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%workgroup_count, %token_count, %c1) workgroup_size(%workgroup_size, %c1, %c1) : index
} launch(%token_capacity0: index, %normalized_rows: buffer, %pending_hidden: buffer, %shifted_rows: buffer) {
  %token_capacity = index.assume %token_capacity0 [range(%token_capacity0, 1, 512)] : index
  %workgroup0 = kernel.workgroup.id<x> : index
  %workgroup = index.assume %workgroup0 [range(%workgroup0, 0, 4)] : index
  %token0 = kernel.workgroup.id<y> : index
  %token = index.assume %token0 [lt(%token0, %token_capacity)] : index
  %workitem0 = kernel.workitem.id<x> : index
  %workitem = index.assume %workitem0 [range(%workitem0, 0, 255)] : index
  %workgroup_size = index.constant 256 : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %vector_ordinal0 = index.mul %workgroup, %workgroup_size : index
  %vector_ordinal = index.add %vector_ordinal0, %workitem : index
  %element0 = index.mul %vector_ordinal, %c4 : index
  %element = index.assume %element0 [range(%element0, 0, 5116), mul(%element0, 4)] : index
  %c0_offset = index.constant 0 : offset
  %normalized_view = buffer.view %normalized_rows[%c0_offset] : buffer -> view<[%token_capacity]x5120xf32>
  %pending_view = buffer.view %pending_hidden[%c0_offset] : buffer -> view<5120xf32>
  %shifted_view = buffer.view %shifted_rows[%c0_offset] : buffer -> view<[%token_capacity]x5120xf32>
  %is_first = index.cmp eq, %token, %c0 : index
  %values = scf.if %is_first -> (vector<4xf32>) {
    %pending_values = vector.load %pending_view[%element] : view<5120xf32> -> vector<4xf32>
    scf.yield %pending_values : vector<4xf32>
  } else {
    %source_row0 = index.sub %token, %c1 : index
    %source_row = index.assume %source_row0 [range(%source_row0, 0, 510)] : index
    %source_values = vector.load %normalized_view[%source_row, %element] : view<[%token_capacity]x5120xf32> -> vector<4xf32>
    scf.yield %source_values : vector<4xf32>
  }
  vector.store %values, %shifted_view[%token, %element] : vector<4xf32>, view<[%token_capacity]x5120xf32>
  kernel.return
}

// Publishes the normalized hidden row preceding the next prompt token. This
// carry lets independently replayed prefill chunks preserve the MTP pairing
// contract without retaining the preceding chunk's dense row tensor.
kernel.def export("qwen38_mtp_publish_last_hidden") @qwen38_mtp_publish_last_hidden(%token_count0: index) {
  %token_count = index.assume %token_count0 [range(%token_count0, 1, 512)] : index
  %workgroup_count = index.constant 5 : index
  %workgroup_size = index.constant 256 : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%workgroup_count, %c1, %c1) workgroup_size(%workgroup_size, %c1, %c1) : index
} launch(%control: buffer, %normalized_rows: buffer, %pending_hidden: buffer) {
  %workgroup0 = kernel.workgroup.id<x> : index
  %workgroup = index.assume %workgroup0 [range(%workgroup0, 0, 4)] : index
  %workitem0 = kernel.workitem.id<x> : index
  %workitem = index.assume %workitem0 [range(%workitem0, 0, 255)] : index
  %workgroup_size = index.constant 256 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c0_offset = index.constant 0 : offset
  %control_view = buffer.view %control[%c0_offset] : buffer -> view<2xi32>
  %token_count_i32 = view.load %control_view[0] : view<2xi32> -> i32
  %token_count0 = index.cast %token_count_i32 : i32 to index
  %token_count = index.assume %token_count0 [range(%token_count0, 1, 512)] : index
  %vector_ordinal0 = index.mul %workgroup, %workgroup_size : index
  %vector_ordinal = index.add %vector_ordinal0, %workitem : index
  %element0 = index.mul %vector_ordinal, %c4 : index
  %element = index.assume %element0 [range(%element0, 0, 5116), mul(%element0, 4)] : index
  %last_row0 = index.sub %token_count, %c1 : index
  %last_row = index.assume %last_row0 [range(%last_row0, 0, 511)] : index
  %normalized_view = buffer.view %normalized_rows[%c0_offset] : buffer -> view<512x5120xf32>
  %pending_view = buffer.view %pending_hidden[%c0_offset] : buffer -> view<5120xf32>
  %values = vector.load %normalized_view[%last_row, %element] : view<512x5120xf32> -> vector<4xf32>
  vector.store %values, %pending_view[%element] : vector<4xf32>, view<5120xf32>
  kernel.return
}

// Preserves the prompt inputs and prior target carry while the ordinary target
// transition rewrites its token, control, and hidden-state outputs in place.
kernel.def export("qwen38_mtp_preserve_prefill_inputs") @qwen38_mtp_preserve_prefill_inputs() {
  %workgroup_count = index.constant 5 : index
  %workgroup_size = index.constant 256 : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%workgroup_count, %c1, %c1) workgroup_size(%workgroup_size, %c1, %c1) : index
} launch(%token_ids: buffer, %control: buffer, %pending_hidden: buffer, %saved_token_ids: buffer, %saved_control: buffer, %saved_pending_hidden: buffer) {
  %workgroup0 = kernel.workgroup.id<x> : index
  %workgroup = index.assume %workgroup0 [range(%workgroup0, 0, 4)] : index
  %workitem0 = kernel.workitem.id<x> : index
  %workitem = index.assume %workitem0 [range(%workitem0, 0, 255)] : index
  %workgroup_size = index.constant 256 : index
  %c0 = index.constant 0 : index
  %c4 = index.constant 4 : index
  %c0_offset = index.constant 0 : offset
  %vector_ordinal0 = index.mul %workgroup, %workgroup_size : index
  %vector_ordinal = index.add %vector_ordinal0, %workitem : index
  %element0 = index.mul %vector_ordinal, %c4 : index
  %element = index.assume %element0 [range(%element0, 0, 5116), mul(%element0, 4)] : index
  %pending_view = buffer.view %pending_hidden[%c0_offset] : buffer -> view<5120xf32>
  %saved_pending_view = buffer.view %saved_pending_hidden[%c0_offset] : buffer -> view<5120xf32>
  %hidden_values = vector.load %pending_view[%element] : view<5120xf32> -> vector<4xf32>
  vector.store %hidden_values, %saved_pending_view[%element] : vector<4xf32>, view<5120xf32>

  %token_capacity = index.constant 512 : index
  %has_token = index.cmp ult, %vector_ordinal, %token_capacity : index
  scf.if %has_token {
    %token_index = index.assume %vector_ordinal [range(%vector_ordinal, 0, 511)] : index
    %token_view = buffer.view %token_ids[%c0_offset] : buffer -> view<512xi32>
    %saved_token_view = buffer.view %saved_token_ids[%c0_offset] : buffer -> view<512xi32>
    %token = view.load %token_view[%token_index] : view<512xi32> -> i32
    view.store %token, %saved_token_view[%token_index] : i32, view<512xi32>
  }

  %is_workgroup_zero = index.cmp eq, %workgroup, %c0 : index
  %is_workitem_zero = index.cmp eq, %workitem, %c0 : index
  %is_control_thread = scalar.andi %is_workgroup_zero, %is_workitem_zero : i1
  scf.if %is_control_thread {
    %control_view = buffer.view %control[%c0_offset] : buffer -> view<2xi32>
    %saved_control_view = buffer.view %saved_control[%c0_offset] : buffer -> view<2xi32>
    %control0 = view.load %control_view[0] : view<2xi32> -> i32
    %control1 = view.load %control_view[1] : view<2xi32> -> i32
    view.store %control0, %saved_control_view[0] : i32, view<2xi32>
    view.store %control1, %saved_control_view[1] : i32, view<2xi32>
  }
  kernel.return
}

check.case public @qwen38_mtp_rmsnorm_concat_f32_prefill_case {
  %token_count = check.literal value(1) : index
  %epsilon = check.literal value(0.000001) : f32
  %embedding = check.generate.fill value(4.0) : tensor<5120xf32>
  %hidden = check.generate.fill value(2.0) : tensor<5120xf32>
  %embedding_weight = check.generate.fill value(3.0) : tensor<5120xf32>
  %hidden_weight = check.generate.fill value(5.0) : tensor<5120xf32>
  %actual = check.generate.fill value(0.0) : tensor<10240xf32>
  %expected_embedding = check.generate.fill value(3.0) : tensor<5120xf32>
  %expected_hidden = check.generate.fill value(5.0) : tensor<5120xf32>
  kernel.launch @qwen38_mtp_rmsnorm_concat_embedding_f32_prefill[%token_count](%token_count, %epsilon, %embedding, %embedding_weight, %actual) : [index](index, f32, tensor<5120xf32>, tensor<5120xf32>, tensor<10240xf32>)
  kernel.launch @qwen38_mtp_rmsnorm_concat_hidden_f32_prefill[%token_count](%token_count, %epsilon, %hidden, %hidden_weight, %actual) : [index](index, f32, tensor<5120xf32>, tensor<5120xf32>, tensor<10240xf32>)
  %actual_embedding = check.tensor.view %actual offset(0) : tensor<10240xf32> -> tensor<5120xf32>
  %actual_hidden = check.tensor.view %actual offset(20480) : tensor<10240xf32> -> tensor<5120xf32>
  check.expect.close actual(%actual_embedding) expected(%expected_embedding) atol(0.00001) rtol(0.00001) nan(same) : tensor<5120xf32>
  check.expect.close actual(%actual_hidden) expected(%expected_hidden) atol(0.00001) rtol(0.00001) nan(same) : tensor<5120xf32>
  check.return
}

check.case public @qwen38_mtp_shift_hidden_rows_case {
  %token_count = check.literal value(3) : index
  %normalized_rows = check.generate.iota offset(0.0) step(1.0) : tensor<3x5120xf32>
  %pending_hidden = check.generate.iota offset(-5120.0) step(1.0) : tensor<5120xf32>
  %actual = check.generate.fill value(0.0) : tensor<3x5120xf32>
  %expected = check.generate.iota offset(-5120.0) step(1.0) : tensor<3x5120xf32>
  kernel.launch @qwen38_mtp_shift_hidden_rows[%token_count](%token_count, %normalized_rows, %pending_hidden, %actual) : [index](index, tensor<3x5120xf32>, tensor<5120xf32>, tensor<3x5120xf32>)
  check.expect.close actual(%actual) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<3x5120xf32>
  check.return
}

check.case public @qwen38_mtp_publish_last_hidden_case {
  %token_count = check.literal value(3) : index
  %control = check.generate.fill value(3) : tensor<2xi32>
  %normalized_rows = check.generate.iota offset(0.0) step(1.0) : tensor<512x5120xf32>
  %actual = check.generate.fill value(0.0) : tensor<5120xf32>
  %expected = check.generate.iota offset(10240.0) step(1.0) : tensor<5120xf32>
  kernel.launch @qwen38_mtp_publish_last_hidden[%token_count](%control, %normalized_rows, %actual) : [index](tensor<2xi32>, tensor<512x5120xf32>, tensor<5120xf32>)
  check.expect.close actual(%actual) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<5120xf32>
  check.return
