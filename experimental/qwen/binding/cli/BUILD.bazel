load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")
load("//runtime/build_tools/bazel:cc.bzl", "iree_runtime_cc_binary")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

iree_runtime_cc_binary(
    name = "qwen38-decode-greedy-cli",
    srcs = ["qwen38_decode_body_main.c"],
    tags = [
        "iree-run-requirement=runtime.resource.amd_gpu",
        "manual",
        "requires-gpu-amd",
        "runtime-resource=amd-gpu",
    ],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/execute:amdgpu_hal",
    ]),
    deps = [
        "//experimental/qwen/programs:qwen38_text_decode_body_source",
        "//experimental/qwen/tooling:command_program",
        "//experimental/qwen/tooling:runtime",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/tooling:flags",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/io:file_handle",
        "//runtime/src/iree/tooling:device_util",
    ],
)

