load("//build_tools/sanitizer:suppressions.bzl", "rocm_suppressions")
load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_config_compatible_with",
)
load("//runtime/build_tools/bazel:cc.bzl", "iree_runtime_cc_library")
load("//runtime/build_tools/bazel:cc_test.bzl", "iree_runtime_cc_test")

package(
    default_visibility = ["//experimental/qwen:__subpackages__"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

iree_runtime_cc_library(
    name = "loom_source",
    srcs = ["loom_source.c"],
    hdrs = ["loom_source.h"],
    deps = [
        "//experimental/qwen/kernels:runtime_modules",
        "//runtime/src/iree/base",
    ],
)

iree_runtime_cc_test(
    name = "loom_source_test",
    srcs = ["loom_source_test.cc"],
    deps = [
        ":loom_source",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

iree_runtime_cc_library(
    name = "loom_jit",
    srcs = ["loom_jit.c"],
    hdrs = ["loom_jit.h"],
    deps = [
        ":loom_source",
        "//loom/binding/c:loomc",
        "//loom/binding/c/target/amdgpu",
        "//loom/binding/c/target/amdgpu/iree_hal",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/hal",
    ],
)

iree_runtime_cc_test(
    name = "loom_jit_rmsnorm_test",
    srcs = ["loom_jit_rmsnorm_test.cc"],
    sanitizer_suppressions = rocm_suppressions,
    tags = [
        "iree-run-requirement=runtime.resource.amd_gpu",
        "manual",
        "requires-filesystem",
        "requires-gpu-amd",
        "runtime-resource=amd-gpu",
    ],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/execute:amdgpu_hal",
    ]),
    deps = [
        ":loom_jit",
        ":loom_source",
        "//runtime/src/iree/async",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/drivers",
        "//runtime/src/iree/io:stream",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
        "//runtime/src/iree/tooling:numpy_io",
    ],
)

iree_runtime_cc_library(
    name = "model_shape",
    srcs = ["model_shape.c"],
    hdrs = ["model_shape.h"],
    deps = [
        "//runtime/src/iree/base",
    ],
)

iree_runtime_cc_test(
    name = "model_shape_test",
    srcs = ["model_shape_test.cc"],
    deps = [
        ":model_shape",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

iree_runtime_cc_library(
    name = "parameters",
    srcs = ["parameters.c"],
    hdrs = ["parameters.h"],
    deps = [
        ":model_shape",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base:core_headers",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/io:parameter_index",
        "//runtime/src/iree/io:parameter_provider",
    ],
)

iree_runtime_cc_test(
    name = "parameters_test",
    srcs = ["parameters_test.cc"],
    deps = [
        ":parameters",
        "//runtime/src/iree/base",
        "//runtime/src/iree/io:parameter_index",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

iree_runtime_cc_library(
    name = "model",
    srcs = ["model.c"],
    hdrs = ["model.h"],
    deps = [
        ":loom_jit",
        ":parameters",
        "//loom/binding/c:loomc",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/io:parameter_provider",
    ],
)

iree_runtime_cc_library(
    name = "request",
    srcs = [
        "request.c",
        "request_state.c",
    ],
    hdrs = [
        "request.h",
        "request_state.h",
    ],
    deps = [
        ":model",
        ":model_shape",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal",
        "//runtime/src/iree/hal",
    ],
)

iree_runtime_cc_test(
    name = "request_state_test",
    srcs = ["request_state_test.cc"],
    deps = [
        ":model_shape",
        ":request",
