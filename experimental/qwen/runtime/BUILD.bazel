iree_runtime_cc_library(
    name = "program_layout",
    srcs = ["program_layout.c"],
    hdrs = ["program_layout.h"],
    deps = [
        ":model_shape",
        "//runtime/src/iree/base",
    ],
)

iree_runtime_cc_test(
    name = "program_layout_test",
    srcs = ["program_layout_test.cc"],
    deps = [
        ":program_layout",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

iree_runtime_cc_library(
    name = "program",
    srcs = ["program.c"],
    hdrs = ["program.h"],
    deps = [
        ":loom_jit",
        ":loom_source",
        ":model",
        ":model_shape",
        ":parameters",
        ":program_layout",
        ":request",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal",
        "//runtime/src/iree/hal",
    ],
)
