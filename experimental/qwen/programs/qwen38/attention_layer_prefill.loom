// Exact Qwen3.8-27B full-attention prefill layer.
//
// Token count is an issue-time specialization argument and the first word in
// the device-visible control buffer. The second control word is the absolute
// position of the first input row. One materialized command buffer therefore
// handles every prompt or appended span through 512 tokens.

config.decl @qwen38.attention.cache_capacity : %value: index where [range(%value, 1, 262144)]

kernel.decl @ggml_quantize_q8_1_x4_f32(%token_count: index, %input_size: index) launch(%token_capacity: index, %input_size_data: index, %input: buffer, %output: buffer)
kernel.decl @ggml_linear_q8_0_q8_1_x4(%token_count: index, %input_size: index, %output_size: index) launch(%token_capacity: index, %input_size_data: index, %output_size_data: index, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @qwen38_linear_q5k_f16_wmma(%token_count: index, %input_size: index, %output_size: index) launch(%control: buffer, %input_size_data: index, %output_size_data: index, %input: buffer, %weight: buffer, %output: buffer)
kernel.decl @qwen38_linear_q5k_f16_wmma_x128(%token_count: index, %input_size: index, %output_size: index) launch(%control: buffer, %input_size_data: index, %output_size_data: index, %input: buffer, %weight: buffer, %output: buffer)
kernel.decl @qwen38_linear_q6k_f16_wmma_x64(%token_count: index, %input_size: index, %output_size: index) launch(%control: buffer, %input_size_data: index, %output_size_data: index, %input: buffer, %weight: buffer, %output: buffer)
kernel.decl @qwen38_linear_q6k_f16_wmma_x128(%token_count: index, %input_size: index, %output_size: index) launch(%control: buffer, %input_size_data: index, %output_size_data: index, %input: buffer, %weight: buffer, %output: buffer)

kernel.decl @qwen38_rmsnorm_f32_prefill(%token_count: index) launch(%token_capacity: index, %epsilon: f32, %input: buffer, %weight: buffer, %output: buffer)
kernel.decl @qwen38_residual_add_f32_prefill(%token_count: index) launch(%token_capacity: index, %lhs: buffer, %rhs: buffer, %output: buffer)
kernel.decl @qwen38_swiglu_f32_prefill(%token_count: index) launch(%token_capacity: index, %gate: buffer, %up: buffer, %output: buffer)
kernel.decl @qwen38_attention_query_prepare_prefill(%token_count: index) launch(%control: buffer, %epsilon: f32, %query_gate_projection: buffer, %norm_weight: buffer, %query: buffer, %gate: buffer)
kernel.decl @qwen38_attention_kv_prepare_prefill(%token_count: index) launch(%control: buffer, %epsilon: f32, %key_projection: buffer, %value_projection: buffer, %norm_weight: buffer, %key_cache: buffer, %value_cache: buffer)
kernel.decl @qwen38_attention_prefill_f16_wmma(%token_count: index) launch(%control: buffer, %query: buffer, %gate: buffer, %key_cache: buffer, %value_cache: buffer, %output: buffer)

command.program.def @qwen38_attention_layer_prefill(%token_count: index, %layer: index, %attention_ordinal: index) launch(%parameters: buffer, %residual: buffer, %attention_cache: buffer, %control: buffer, %attention_output: buffer) where [range(%token_count, 1, 512), range(%layer, 0, 63), range(%attention_ordinal, 0, 15)] {
  %token_capacity = index.constant 512 : index
  %hidden_size = index.constant 5120 : index
  %query_gate_size = index.constant 12288 : index
  %key_value_size = index.constant 1024 : index
  %attention_size = index.constant 6144 : index
  %ffn_size = index.constant 17408 : index
  %c0 = index.constant 0 : index
  %c65 = index.constant 65 : index
  %epsilon = scalar.constant 0.000001 : f32

  %uses_x64 = index.cmp ult, %token_count, %c65 : index
  %x64_token_count = scf.if %uses_x64 -> (index) {
    scf.yield %token_count : index
  } else {
    scf.yield %c0 : index
  }
  %x128_token_count = scf.if %uses_x64 -> (index) {
    scf.yield %c0 : index
  } else {
    scf.yield %token_count : index
  }

  %attention_norm_weight = command.parameter %parameters, "blk.{}.attn_norm.weight"[%layer] : view<5120xf32>
  %query_weight = command.parameter %parameters, "blk.{}.attn_q.weight"[%layer] : view<51609600xi8>
  %query_norm_weight = command.parameter %parameters, "blk.{}.attn_q_norm.weight"[%layer] : view<256xf32>
  %key_weight = command.parameter %parameters, "blk.{}.attn_k.weight"[%layer] : view<4300800xi8>
  %key_norm_weight = command.parameter %parameters, "blk.{}.attn_k_norm.weight"[%layer] : view<256xf32>
  %value_weight = command.parameter %parameters, "blk.{}.attn_v.weight"[%layer] : view<5570560xi8>
  %output_weight = command.parameter %parameters, "blk.{}.attn_output.weight"[%layer] : view<25804800xi8>
  %post_attention_norm_weight = command.parameter %parameters, "blk.{}.post_attention_norm.weight"[%layer] : view<5120xf32>
  %ffn_down_weight = command.parameter %parameters, "blk.{}.ffn_down.weight"[%layer] : view<73113600xi8>
  %ffn_gate_weight = command.parameter %parameters, "blk.{}.ffn_gate.weight"[%layer] : view<61276160xi8>
  %ffn_up_weight = command.parameter %parameters, "blk.{}.ffn_up.weight"[%layer] : view<61276160xi8>

  %cache_capacity = config.get @qwen38.attention.cache_capacity : index
  %cache_token_bytes = index.constant 2048 : offset
  %cache_bytes = index.scale %cache_capacity, %cache_token_bytes : index, offset -> offset
  %attention_layer_cache_bytes, %key_cache_offset, %value_cache_offset = buffer.pack [align(256) %cache_bytes, align(256) %cache_bytes] : offset
  %layer_cache_offset = index.scale %attention_ordinal, %attention_layer_cache_bytes : index, offset -> offset
  %layer_key_cache_offset = index.add %layer_cache_offset, %key_cache_offset : offset
  %layer_value_cache_offset = index.add %layer_cache_offset, %value_cache_offset : offset
  %cache_element_count = index.mul %cache_capacity, %key_value_size : index
  %key_cache = buffer.view %attention_cache[%layer_key_cache_offset] : buffer -> view<[%cache_element_count]xf16>
  %value_cache = buffer.view %attention_cache[%layer_value_cache_offset] : buffer -> view<[%cache_element_count]xf16>

  %hidden_bytes = index.constant 10485760 : offset
  %hidden_q8_bytes = index.constant 2949120 : offset
  %query_gate_bytes = index.constant 25165824 : offset
  %key_value_bytes = index.constant 2097152 : offset
  %attention_bytes = index.constant 12582912 : offset
  %ffn_bytes = index.constant 35651584 : offset

  %normalized = buffer.alloca<global> align(256) %hidden_bytes : buffer
  %normalized_q8 = buffer.alloca<global> align(256) %hidden_q8_bytes : buffer
  kernel.launch @qwen38_rmsnorm_f32_prefill[%token_count](%token_capacity, %epsilon, %residual, %attention_norm_weight, %normalized) : [index](index, f32, buffer, view<5120xf32>, buffer)
  %query_gate_projection = buffer.alloca<global> align(256) %query_gate_bytes : buffer
  %key_projection = buffer.alloca<global> align(256) %key_value_bytes : buffer
  command.concurrent {
    kernel.launch @ggml_quantize_q8_1_x4_f32[%token_count, %hidden_size](%token_capacity, %hidden_size, %normalized, %normalized_q8) : [index, index](index, index, buffer, buffer)
    kernel.launch @qwen38_linear_q6k_f16_wmma_x64[%x64_token_count, %hidden_size, %query_gate_size](%control, %hidden_size, %query_gate_size, %normalized, %query_weight, %query_gate_projection) : [index, index, index](buffer, index, index, buffer, view<51609600xi8>, buffer)
    kernel.launch @qwen38_linear_q6k_f16_wmma_x128[%x128_token_count, %hidden_size, %query_gate_size](%control, %hidden_size, %query_gate_size, %normalized, %query_weight, %query_gate_projection) : [index, index, index](buffer, index, index, buffer, view<51609600xi8>, buffer)
    kernel.launch @qwen38_linear_q6k_f16_wmma_x64[%x64_token_count, %hidden_size, %key_value_size](%control, %hidden_size, %key_value_size, %normalized, %key_weight, %key_projection) : [index, index, index](buffer, index, index, buffer, view<4300800xi8>, buffer)
    kernel.launch @qwen38_linear_q6k_f16_wmma_x128[%x128_token_count, %hidden_size, %key_value_size](%control, %hidden_size, %key_value_size, %normalized, %key_weight, %key_projection) : [index, index, index](buffer, index, index, buffer, view<4300800xi8>, buffer)
  }

  %value_projection = buffer.alloca<global> align(256) %key_value_bytes : buffer
  kernel.launch @ggml_linear_q8_0_q8_1_x4[%token_count, %hidden_size, %key_value_size](%token_capacity, %hidden_size, %key_value_size, %normalized_q8, %value_weight, %value_projection) : [index, index, index](index, index, index, buffer, view<5570560xi8>, buffer)

  %query = buffer.alloca<global> align(256) %attention_bytes : buffer
  %gate = buffer.alloca<global> align(256) %attention_bytes : buffer
  command.concurrent {
    kernel.launch @qwen38_attention_query_prepare_prefill[%token_count](%control, %epsilon, %query_gate_projection, %query_norm_weight, %query, %gate) : [index](buffer, f32, buffer, view<256xf32>, buffer, buffer)
    kernel.launch @qwen38_attention_kv_prepare_prefill[%token_count](%control, %epsilon, %key_projection, %value_projection, %key_norm_weight, %key_cache, %value_cache) : [index](buffer, f32, buffer, buffer, view<256xf32>, view<[%cache_element_count]xf16>, view<[%cache_element_count]xf16>)
  }

  kernel.launch @qwen38_attention_prefill_f16_wmma[%token_count](%control, %query, %gate, %key_cache, %value_cache, %attention_output) : [index](buffer, buffer, buffer, view<[%cache_element_count]xf16>, view<[%cache_element_count]xf16>, buffer)

  %projected_attention = buffer.alloca<global> align(256) %hidden_bytes : buffer
  command.concurrent {
    kernel.launch @qwen38_linear_q6k_f16_wmma_x64[%x64_token_count, %attention_size, %hidden_size](%control, %attention_size, %hidden_size, %attention_output, %output_weight, %projected_attention) : [index, index, index](buffer, index, index, buffer, view<25804800xi8>, buffer)
    kernel.launch @qwen38_linear_q6k_f16_wmma_x128[%x128_token_count, %attention_size, %hidden_size](%control, %attention_size, %hidden_size, %attention_output, %output_weight, %projected_attention) : [index, index, index](buffer, index, index, buffer, view<25804800xi8>, buffer)
  }
  kernel.launch @qwen38_residual_add_f32_prefill[%token_count](%token_capacity, %residual, %projected_attention, %residual) : [index](index, buffer, buffer, buffer)

  %post_normalized = buffer.alloca<global> align(256) %hidden_bytes : buffer
  kernel.launch @qwen38_rmsnorm_f32_prefill[%token_count](%token_capacity, %epsilon, %residual, %post_attention_norm_weight, %post_normalized) : [index](index, f32, buffer, view<5120xf32>, buffer)

  %ffn_gate = buffer.alloca<global> align(256) %ffn_bytes : buffer
  %ffn_up = buffer.alloca<global> align(256) %ffn_bytes : buffer
  command.concurrent {
    kernel.launch @qwen38_linear_q5k_f16_wmma[%x64_token_count, %hidden_size, %ffn_size](%control, %hidden_size, %ffn_size, %post_normalized, %ffn_gate_weight, %ffn_gate) : [index, index, index](buffer, index, index, buffer, view<61276160xi8>, buffer)
    kernel.launch @qwen38_linear_q5k_f16_wmma_x128[%x128_token_count, %hidden_size, %ffn_size](%control, %hidden_size, %ffn_size, %post_normalized, %ffn_gate_weight, %ffn_gate) : [index, index, index](buffer, index, index, buffer, view<61276160xi8>, buffer)
    kernel.launch @qwen38_linear_q5k_f16_wmma[%x64_token_count, %hidden_size, %ffn_size](%control, %hidden_size, %ffn_size, %post_normalized, %ffn_up_weight, %ffn_up) : [index, index, index](buffer, index, index, buffer, view<61276160xi8>, buffer)
    kernel.launch @qwen38_linear_q5k_f16_wmma_x128[%x128_token_count, %hidden_size, %ffn_size](%control, %hidden_size, %ffn_size, %post_normalized, %ffn_up_weight, %ffn_up) : [index, index, index](buffer, index, index, buffer, view<61276160xi8>, buffer)
  }

  %swiglu = buffer.alloca<global> align(256) %ffn_bytes : buffer
  %ffn_output = buffer.alloca<global> align(256) %hidden_bytes : buffer
  kernel.launch @qwen38_swiglu_f32_prefill[%token_count](%token_capacity, %ffn_gate, %ffn_up, %swiglu) : [index](index, buffer, buffer, buffer)
  command.concurrent {
    kernel.launch @qwen38_linear_q6k_f16_wmma_x64[%x64_token_count, %ffn_size, %hidden_size](%control, %ffn_size, %hidden_size, %swiglu, %ffn_down_weight, %ffn_output) : [index, index, index](buffer, index, index, buffer, view<73113600xi8>, buffer)
    kernel.launch @qwen38_linear_q6k_f16_wmma_x128[%x128_token_count, %ffn_size, %hidden_size](%control, %ffn_size, %hidden_size, %swiglu, %ffn_down_weight, %ffn_output) : [index, index, index](buffer, index, index, buffer, view<73113600xi8>, buffer)
  }
  kernel.launch @qwen38_residual_add_f32_prefill[%token_count](%token_capacity, %residual, %ffn_output, %residual) : [index](index, buffer, buffer, buffer)
  command.return
}

command.program.def public @qwen38_attention_layer3_prefill(%token_count: index) launch(%parameters: buffer, %residual: buffer, %attention_cache: buffer, %control: buffer) where [range(%token_count, 1, 512)] {
  %layer = index.constant 3 : index
  %attention_ordinal = index.constant 0 : index
  %attention_bytes = index.constant 12582912 : offset
  %attention_output = buffer.alloca<global> align(256) %attention_bytes : buffer
  command.program.launch @qwen38_attention_layer_prefill[%token_count, %layer, %attention_ordinal](%parameters, %residual, %attention_cache, %control, %attention_output) : [index, index, index](buffer, buffer, buffer, buffer, buffer)
  command.return
}

command.program.def public @qwen38_attention_layer3_prefill_witness(%token_count: index) launch(%parameters: buffer, %residual: buffer, %attention_cache: buffer, %control: buffer, %attention_output: buffer) where [range(%token_count, 1, 512)] {
  %layer = index.constant 3 : index
  %attention_ordinal = index.constant 0 : index
  command.program.launch @qwen38_attention_layer_prefill[%token_count, %layer, %attention_ordinal](%parameters, %residual, %attention_cache, %control, %attention_output) : [index, index, index](buffer, buffer, buffer, buffer, buffer)
  command.return
}
