// Qwen3.8-27B base-model prefill body.
//
// The same command program serves every prompt length through 512 tokens.
// Sixteen fixed architectural groups each advance three Gated DeltaNet layers
// followed by one full-attention layer. Preparation unrolls this model
// structure, specializes every parameter and state ordinal, and aliases the
// nested layer allocations into one transient root.

command.program.decl @qwen38_gdn_layer_prefill(%token_count: index, %layer: index, %gdn_ordinal: index) launch(%parameters: buffer, %residual: buffer, %gdn_state: buffer, %control: buffer) where [range(%token_count, 1, 512), range(%layer, 0, 63), range(%gdn_ordinal, 0, 47)]

command.program.decl @qwen38_attention_layer_prefill(%token_count: index, %layer: index, %attention_ordinal: index) launch(%parameters: buffer, %residual: buffer, %attention_cache: buffer, %control: buffer, %attention_output: buffer) where [range(%token_count, 1, 512), range(%layer, 0, 63), range(%attention_ordinal, 0, 15)]

command.program.decl @qwen38_output_head_greedy(%residual_offset: offset) launch(%parameters: buffer, %residual: buffer, %token_id: buffer)

kernel.decl @qwen38_token_embedding_q5k_f32(%token_count: index) launch(%token_capacity: index, %token_ids: buffer, %weight: buffer, %output: buffer)

kernel.decl @qwen38_prefill_finish_control() launch(%control: buffer, %token_ids: buffer)

// Advances the complete base-model body over one causal token span. Token
// count and the absolute first-token position are also read from the issue-time
// control buffer, allowing one materialized command buffer to process prompts
// or appended spans without rerecording.
command.program.def public @qwen38_text_prefill_body(%token_count: index) launch(%parameters: buffer, %residual: buffer, %control: buffer, %gdn_state: buffer, %attention_cache: buffer) where [range(%token_count, 1, 512)] {
  %group_begin = index.constant 0 : index
  %group_end = index.constant 16 : index
  %group_step = index.constant 1 : index
  %layers_per_group = index.constant 4 : index
  %gdn_layers_per_group = index.constant 3 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index

  // Full-attention layers reuse one maximum-capacity output. Nested layer
  // allocations remain semantic and are packed with it during preparation.
  %attention_bytes = index.constant 12582912 : offset
  %attention_output = buffer.alloca<global> align(256) %attention_bytes : buffer

  scf.for %group = [%group_begin to %group_end step %group_step] unroll {
    %layer0 = index.mul %group, %layers_per_group : index
    %layer1 = index.add %layer0, %c1 : index
    %layer2 = index.add %layer0, %c2 : index
    %attention_layer = index.add %layer0, %c3 : index

    %gdn_ordinal0 = index.mul %group, %gdn_layers_per_group : index
    %gdn_ordinal1 = index.add %gdn_ordinal0, %c1 : index
    %gdn_ordinal2 = index.add %gdn_ordinal0, %c2 : index

    command.program.launch @qwen38_gdn_layer_prefill[%token_count, %layer0, %gdn_ordinal0](%parameters, %residual, %gdn_state, %control) : [index, index, index](buffer, buffer, buffer, buffer)
    command.program.launch @qwen38_gdn_layer_prefill[%token_count, %layer1, %gdn_ordinal1](%parameters, %residual, %gdn_state, %control) : [index, index, index](buffer, buffer, buffer, buffer)
    command.program.launch @qwen38_gdn_layer_prefill[%token_count, %layer2, %gdn_ordinal2](%parameters, %residual, %gdn_state, %control) : [index, index, index](buffer, buffer, buffer, buffer)
    command.program.launch @qwen38_attention_layer_prefill[%token_count, %attention_layer, %group](%parameters, %residual, %attention_cache, %control, %attention_output) : [index, index, index](buffer, buffer, buffer, buffer, buffer)
  }
  command.return
}

// Embeds one prompt span, advances every base-model layer, and publishes the
// first greedy continuation token. The final control update hands the same
// persistent state directly to qwen38_text_decode_greedy.
command.program.def public @qwen38_text_prefill_greedy(%token_count: index) launch(%parameters: buffer, %residual: buffer, %control: buffer, %gdn_state: buffer, %attention_cache: buffer, %token_ids: buffer) where [range(%token_count, 1, 512)] {
  %c1 = index.constant 1 : index
  %hidden_row_bytes = index.constant 20480 : offset
  %embedding_weight = command.parameter %parameters, "token_embd.weight" : view<874086400xi8>
  kernel.launch @qwen38_token_embedding_q5k_f32[%token_count](%token_count, %token_ids, %embedding_weight, %residual) : [index](index, buffer, view<874086400xi8>, buffer)
  command.program.launch @qwen38_text_prefill_body[%token_count](%parameters, %residual, %control, %gdn_state, %attention_cache) : [index](buffer, buffer, buffer, buffer, buffer)
  %last_token = index.sub %token_count, %c1 : index
  %last_residual_offset = index.scale %last_token, %hidden_row_bytes : index, offset -> offset
  command.program.launch @qwen38_output_head_greedy[%last_residual_offset](%parameters, %residual, %token_ids) : [offset](buffer, buffer, buffer)
  kernel.launch @qwen38_prefill_finish_control(%control, %token_ids) : (buffer, buffer)
  command.return
}
