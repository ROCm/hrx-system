load("//build_tools/embed_data:build_defs.bzl", "iree_c_embed_data")
load("//loom/build_tools/bazel:loom_link.bzl", "loom_link_module")

package(
    default_visibility = ["//experimental/qwen:__subpackages__"],
    licenses = ["notice"],  # Apache 2.0
)

exports_files([
    "qwen38/attention_layer_decode.loom",
    "qwen38/decode_config.loom",
    "qwen38/gdn_layer_decode.loom",
    "qwen38/model_decode.loom",
    "qwen38/output_head_decode.loom",
])

loom_link_module(
    name = "qwen38_text_decode_body_linked",
    srcs = ["qwen38/model_decode.loom"],
    libraries = [
        "qwen38/attention_layer_decode.loom",
        "qwen38/decode_config.loom",
        "qwen38/gdn_layer_decode.loom",
        "qwen38/output_head_decode.loom",
        "//experimental/qwen/kernels:ggml/linear_q4k_q8_1_x4.loom",
        "//experimental/qwen/kernels:ggml/linear_q5k_q8_1_x4.loom",
        "//experimental/qwen/kernels:ggml/linear_q6k_q8_1_x4.loom",
        "//experimental/qwen/kernels:ggml/linear_q8_0_q8_1_x4.loom",
        "//experimental/qwen/kernels:ggml/linear_qk_common.loom",
        "//experimental/qwen/kernels:ggml/quantize_q8_1_x4.loom",
        "//experimental/qwen/kernels:qwen38/attention_decode.loom",
        "//experimental/qwen/kernels:qwen38/gdn_decode.loom",
        "//experimental/qwen/kernels:qwen38/greedy_argmax.loom",
        "//experimental/qwen/kernels:qwen38/layer_decode.loom",
    ],
    mode = "selective",
    roots = [
        "@qwen38_text_decode_body",
        "@qwen38_text_decode_greedy",
    ],
    strip_check = True,
)

iree_c_embed_data(
    name = "qwen38_text_decode_body_source",
    srcs = [":qwen38_text_decode_body_linked"],
    c_file_output = "qwen38_text_decode_body_source.c",
    flatten = True,
    h_file_output = "qwen38_text_decode_body_source.h",
    identifier = "qwen38_text_decode_body_source",
)

loom_link_module(
    name = "qwen38_attention_layer_decode_linked",
    srcs = ["qwen38/attention_layer_decode.loom"],
    libraries = [
        "qwen38/decode_config.loom",
        "//experimental/qwen/kernels:ggml/linear_q5k_q8_1_x4.loom",
        "//experimental/qwen/kernels:ggml/linear_q6k_q8_1_x4.loom",
        "//experimental/qwen/kernels:ggml/linear_q8_0_q8_1_x4.loom",
        "//experimental/qwen/kernels:ggml/linear_qk_common.loom",
        "//experimental/qwen/kernels:ggml/quantize_q8_1_x4.loom",
        "//experimental/qwen/kernels:qwen38/attention_decode.loom",
        "//experimental/qwen/kernels:qwen38/layer_decode.loom",
    ],
    mode = "selective",
    roots = [
        "@qwen38_attention_layer3_decode",
        "@qwen38_attention_layer3_decode_witness",
    ],
    strip_check = True,
)

iree_c_embed_data(
    name = "qwen38_attention_layer_decode_source",
    srcs = [":qwen38_attention_layer_decode_linked"],
    c_file_output = "qwen38_attention_layer_decode_source.c",
    flatten = True,
    h_file_output = "qwen38_attention_layer_decode_source.h",
    identifier = "qwen38_attention_layer_decode_source",
)

loom_link_module(
    name = "qwen38_gdn_layer_decode_linked",
    srcs = ["qwen38/gdn_layer_decode.loom"],
    libraries = [
        "qwen38/decode_config.loom",
        "//experimental/qwen/kernels:ggml/linear_q4k_q8_1_x4.loom",
        "//experimental/qwen/kernels:ggml/linear_q5k_q8_1_x4.loom",
        "//experimental/qwen/kernels:ggml/linear_q6k_q8_1_x4.loom",
        "//experimental/qwen/kernels:ggml/linear_qk_common.loom",
        "//experimental/qwen/kernels:ggml/quantize_q8_1_x4.loom",
        "//experimental/qwen/kernels:qwen38/gdn_decode.loom",
        "//experimental/qwen/kernels:qwen38/layer_decode.loom",
    ],
    mode = "selective",
    roots = ["@qwen38_gdn_layer0_decode"],
    strip_check = True,
)

iree_c_embed_data(
    name = "qwen38_gdn_layer_decode_source",
    srcs = [":qwen38_gdn_layer_decode_linked"],
    c_file_output = "qwen38_gdn_layer_decode_source.c",
    flatten = True,
    h_file_output = "qwen38_gdn_layer_decode_source.h",
    identifier = "qwen38_gdn_layer_decode_source",
)
