load("//build_tools/bazel:cc.bzl", "iree_cc_binary")

iree_cc_binary(
    name = "jpeg_baseline",
    srcs = ["jpeg_baseline.cc"],
    tags = ["skip-bazel_to_cmake"],
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/task",
        "@libjpeg_turbo//:jpeg",
    ],
)

