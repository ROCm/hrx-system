kernel.decl @jpeg_classify_bytes() launch(%input: buffer, %output: buffer)
kernel.decl @jpeg_prefix_bytes() launch(%input: buffer, %output: buffer)
kernel.decl @jpeg_plan_jobs() launch(%input: buffer, %output: buffer)
kernel.decl @jpeg_compact_bytes() launch(%input: buffer, %output: buffer)
kernel.decl @jpeg_speculate(%launch_input: buffer, %input_offset: offset, %launch_output: buffer, %output_offset: offset) launch(%input: buffer, %output: buffer)
kernel.decl @jpeg_bridge(%launch_input: buffer, %input_offset: offset, %launch_output: buffer, %output_offset: offset) launch(%input: buffer, %output: buffer)
kernel.decl @jpeg_index() launch(%input: buffer, %output: buffer)
kernel.decl @jpeg_certify() launch(%input: buffer, %output: buffer)
kernel.decl @jpeg_intervals() launch(%input: buffer, %output: buffer)
kernel.decl @jpeg_resize_init() launch(%input: buffer, %output: buffer)
kernel.decl @jpeg_resize_stream() launch(%input: buffer, %output: buffer)
kernel.decl @jpeg_resize_publish() launch(%input: buffer, %output: buffer)

command.program.def public @jpeg_decode() launch(%input: buffer, %output: buffer) {
  %zero = index.constant 0 : offset
  command.serial {
    kernel.launch @jpeg_classify_bytes(%input, %output) : (buffer, buffer)
    kernel.launch @jpeg_prefix_bytes(%input, %output) : (buffer, buffer)
    kernel.launch @jpeg_plan_jobs(%input, %output) : (buffer, buffer)
    kernel.launch @jpeg_compact_bytes(%input, %output) : (buffer, buffer)
    kernel.launch @jpeg_speculate[%input, %zero, %output, %zero](%input, %output) : [buffer, offset, buffer, offset](buffer, buffer)
    kernel.launch @jpeg_bridge[%input, %zero, %output, %zero](%input, %output) : [buffer, offset, buffer, offset](buffer, buffer)
    kernel.launch @jpeg_index(%input, %output) : (buffer, buffer)
    kernel.launch @jpeg_certify(%input, %output) : (buffer, buffer)
    kernel.launch @jpeg_intervals(%input, %output) : (buffer, buffer)
    kernel.launch @jpeg_resize_init(%input, %output) : (buffer, buffer)
    kernel.launch @jpeg_resize_stream(%input, %output) : (buffer, buffer)
    kernel.launch @jpeg_resize_publish(%input, %output) : (buffer, buffer)
  }
  command.return
}
