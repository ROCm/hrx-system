load("//build_tools/bazel:cc.bzl", "iree_cc_binary")
load("//build_tools/bazel:python.bzl", "iree_py_test")

package(default_visibility = ["//visibility:private"])

iree_py_test(
    name = "check_test",
    srcs = [
        "check_test.py",
        "sequential.py",
    ],
    data = ["probe.jsonl"],
    imports = ["."],
)

iree_cc_binary(
    name = "color_oracle",
    srcs = ["color_oracle.cc"],
    tags = ["skip-bazel_to_cmake"],
    deps = ["@libjpeg_turbo//:jpeg"],
)

iree_cc_binary(
    name = "float_reference",
    srcs = [
        "float_factor.h",
        "float_reference.cc",
    ],
    tags = ["skip-bazel_to_cmake"],
    deps = ["@libjpeg_turbo//:jpeg"],
)
