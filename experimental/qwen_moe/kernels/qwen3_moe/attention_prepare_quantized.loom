// Qwen attention preparation for raw GGUF quantized projections.
//
// Decode contractions consume a shared Q8_1 x4 activation row. Producing that
// row directly from the residual stream removes the materialized F32 attention
// RMSNorm tensor and avoids rereading it solely for quantization. The fused
// producer preserves GGML's physical Q8_1 x4 contract:
//
//   struct block_q8_1_x4 {
//     f16 ds[4][2];
//     i32 qs[4][8];
//   };
//
// One 256-workitem workgroup owns one token. It first reduces the complete
// hidden row to one reciprocal RMS scale, then visits 1024-element stripes.
// Every workitem packs one four-value word per stripe; adjacent eight-lane
// cohorts reduce the maximum and quantized sum for one logical Q8_1 block.
// Scratch is fixed at 1152 bytes regardless of hidden size.
amdgpu.target<gfx11-generic> @qwen3_moe_attention_prepare_gfx11_wave32 {subgroup_size = 32}

// Shared Q8_1 x4 packer used by the standalone differential path.
func.decl @ggml_quantize_q8_1_x4_f32(%token_count: index, %input_size: index, %input: buffer, %output: buffer)

// Materializes the ordinary Qwen RMSNorm boundary. This remains useful for
// prefill schedules that reuse one normalized row across many output tiles;
// decode uses the fused Q8_1 producer below.
kernel.def target(@qwen3_moe_attention_prepare_gfx11_wave32) @qwen3_moe_rmsnorm_f32(%token_count: index) {
  %one = index.constant 1 : index
  %twofiftysix = index.constant 256 : index
  kernel.launch.config workgroups(%token_count, %one, %one) workgroup_size(%twofiftysix, %one, %one) : index
} launch(%token_count: index, %input: buffer, %weight: buffer, %output: buffer) {
  %hidden_size0 = config.get @qwen3_moe.model.hidden_size : index
  %epsilon = config.get @qwen3_moe.model.rms_epsilon : f32
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 2048)] : index
  %hidden_size = index.assume %hidden_size0 [range(%hidden_size0, 128, 32768), mul(%hidden_size0, 128)] : index
  %token0 = kernel.workgroup.id<x> : index
  %token, %launch_token_count = index.assume %token0, %bounded_token_count [lt(%token0, %bounded_token_count)] : index, index
  %workitem = kernel.workitem.id<x> : index
  %subgroup0 = kernel.subgroup.id : index
  %subgroup = index.assume %subgroup0 [range(%subgroup0, 0, 7)] : index
  %lane = kernel.subgroup.lane.id : index
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %eight = index.constant 8 : index
  %twofiftysix = index.constant 256 : index
  %scratch_bytes = index.constant 1024 : offset
  %zero_offset = index.constant 0 : offset
  %zero_f32 = scalar.constant 0.0 : f32
  %hidden_size_i32 = index.cast %hidden_size : index to i32
  %hidden_size_f32 = scalar.sitofp %hidden_size_i32 : i32 to f32
  %input_noalias, %weight_noalias, %output_noalias = buffer.assume.noalias %input, %weight, %output : buffer, buffer, buffer
  %input_view = buffer.view %input_noalias[%zero_offset] : buffer -> view<[%launch_token_count]x[%hidden_size]xf32, #dense>
  %weight_view = buffer.view %weight_noalias[%zero_offset] : buffer -> view<[%hidden_size]xf32, #dense>
  %output_view = buffer.view %output_noalias[%zero_offset] : buffer -> view<[%launch_token_count]x[%hidden_size]xf32, #dense>
  %thread_sum = scf.for %channel = [%workitem to %hidden_size step %twofiftysix](%running_sum = %zero_f32 : f32) -> (f32) {
    %value = view.load %input_view[%token, %channel] : view<[%launch_token_count]x[%hidden_size]xf32, #dense> -> f32
    %square = scalar.mulf<reassoc|nnan|ninf|nsz> %value, %value : f32
    %next_sum = scalar.addf<reassoc|nnan|ninf|nsz> %running_sum, %square : f32
    scf.yield %next_sum : f32
  }
  %subgroup_sum = kernel.subgroup.reduce<addf> %thread_sum : f32
  %scratch = buffer.alloca %scratch_bytes {base_alignment = 16, memory_space = workgroup} : buffer
  %scratch_view = buffer.view %scratch[%zero_offset] : buffer -> view<256xf32, #dense>
  %is_subgroup_leader = index.cmp eq, %lane, %zero : index
  scf.if %is_subgroup_leader {
    view.store %subgroup_sum, %scratch_view[%subgroup] : f32, view<256xf32, #dense>
  }
  kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
  %is_reduction_subgroup = index.cmp eq, %subgroup, %zero : index
  %is_reduction_lane = index.cmp ult, %lane, %eight : index
  %loads_subgroup_sum = scalar.andi %is_reduction_subgroup, %is_reduction_lane : i1
  %subgroup_partial = scf.if %loads_subgroup_sum -> (f32) {
    %value = view.load %scratch_view[%lane] : view<256xf32, #dense> -> f32
    scf.yield %value : f32
  } else {
    scf.yield %zero_f32 : f32
  }
  %row_sum = kernel.subgroup.reduce<addf> %subgroup_partial : f32
  %writes_scale = scalar.andi %is_reduction_subgroup, %is_subgroup_leader : i1
  scf.if %writes_scale {
    %mean = scalar.divf<reassoc|nnan|ninf|nsz|arcp> %row_sum, %hidden_size_f32 : f32
    %biased_mean = scalar.addf<reassoc|nnan|ninf|nsz> %mean, %epsilon : f32
    %scale = scalar.rsqrtf<nnan|ninf|nsz|afn> %biased_mean : f32
    view.store %scale, %scratch_view[%zero] : f32, view<256xf32, #dense>
  }
  kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
  %scale = view.load %scratch_view[%zero] : view<256xf32, #dense> -> f32
  scf.for %channel = [%workitem to %hidden_size step %twofiftysix] {
    %value = view.load %input_view[%token, %channel] : view<[%launch_token_count]x[%hidden_size]xf32, #dense> -> f32
    %learned_weight = view.load %weight_view[%channel] : view<[%hidden_size]xf32, #dense> -> f32
    %normalized = scalar.mulf<reassoc|nnan|ninf|nsz> %value, %scale : f32
    %result = scalar.mulf<reassoc|nnan|ninf|nsz> %normalized, %learned_weight : f32
    view.store %result, %output_view[%token, %channel] : f32, view<[%launch_token_count]x[%hidden_size]xf32, #dense>
  }
  kernel.return
}

// Shared RMSNorm and GGML Q8_1 x4 producer. The attention export discards the
// ordinary F32 row, while feed-forward publishes it for the router without
// rereading and requantizing the normalized values.
func.template<qwen3_moe.rmsnorm_quantize_q8_1_x4.body> device @qwen3_moe_rmsnorm_quantize_q8_1_x4_body(%publish_normalized: i1, %token_count: index, %input: buffer, %weight: buffer, %normalized_output: buffer, %q8_output: buffer) {
  %hidden_size0 = config.get @qwen3_moe.model.hidden_size : index
  %epsilon = config.get @qwen3_moe.model.rms_epsilon : f32
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 2048)] : index
  %hidden_size = index.assume %hidden_size0 [range(%hidden_size0, 128, 32768), mul(%hidden_size0, 128)] : index
  %token0 = kernel.workgroup.id<x> : index
  %token, %launch_token_count = index.assume %token0, %bounded_token_count [lt(%token0, %bounded_token_count)] : index, index
  %workitem = kernel.workitem.id<x> : index
  %subgroup0 = kernel.subgroup.id : index
  %subgroup = index.assume %subgroup0 [range(%subgroup0, 0, 7)] : index
  %lane = kernel.subgroup.lane.id : index
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %four = index.constant 4 : index
  %eight = index.constant 8 : index
  %sixteen = index.constant 16 : index
  %thirtytwo = index.constant 32 : index
  %onehundredtwentyeight = index.constant 128 : index
  %twofiftysix = index.constant 256 : index
  %onezerotwofour = index.constant 1024 : index
  %group_bytes = index.constant 144 : index
  %payload_byte_add = index.constant 16 : index
  %scratch_d_byte_add = index.constant 1024 : offset
  %scratch_bytes = index.constant 1152 : offset
  %zero_offset = index.constant 0 : offset
  %zero_f32 = scalar.constant 0.0 : f32
  %one_f32 = scalar.constant 1.0 : f32
  %one_twenty_seven = scalar.constant 127.0 : f32
  %zero_f32x4 = vector.constant 0.0 : vector<4xf32>
  %hidden_size_i32 = index.cast %hidden_size : index to i32
  %hidden_size_f32 = scalar.sitofp %hidden_size_i32 : i32 to f32
  %physical_group_count = index.div %hidden_size, %onehundredtwentyeight : index
  %row_byte_count = index.mul %physical_group_count, %group_bytes : index
  %token_output_byte_base = index.mul %token, %row_byte_count : index
  %input_noalias, %weight_noalias, %q8_output_noalias = buffer.assume.noalias %input, %weight, %q8_output : buffer, buffer, buffer
  %input_view = buffer.view %input_noalias[%zero_offset] : buffer -> view<[%launch_token_count]x[%hidden_size]xf32, #dense>
  %weight_view = buffer.view %weight_noalias[%zero_offset] : buffer -> view<[%hidden_size]xf32, #dense>
  %normalized_output_view = buffer.view %normalized_output[%zero_offset] : buffer -> view<[%launch_token_count]x[%hidden_size]xf32, #dense>
  %scratch = buffer.alloca %scratch_bytes {base_alignment = 16, memory_space = workgroup} : buffer
  %scratch_values = buffer.view %scratch[%zero_offset] : buffer -> view<256xf32, #dense>
  %scratch_d = buffer.view %scratch[%scratch_d_byte_add] : buffer -> view<32xf32, #dense>
  // Reduce the complete row before any block-local quantization.
  %thread_sum = scf.for %channel = [%workitem to %hidden_size step %twofiftysix](%running_sum = %zero_f32 : f32) -> (f32) {
    %value = view.load %input_view[%token, %channel] : view<[%launch_token_count]x[%hidden_size]xf32, #dense> -> f32
    %square = scalar.mulf<reassoc|nnan|ninf|nsz> %value, %value : f32
    %next_sum = scalar.addf<reassoc|nnan|ninf|nsz> %running_sum, %square : f32
    scf.yield %next_sum : f32
  }
  %subgroup_sum = kernel.subgroup.reduce<addf> %thread_sum : f32
  %is_subgroup_leader = index.cmp eq, %lane, %zero : index
  scf.if %is_subgroup_leader {
    view.store %subgroup_sum, %scratch_values[%subgroup] : f32, view<256xf32, #dense>
  }
  kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
  %is_reduction_subgroup = index.cmp eq, %subgroup, %zero : index
  %is_reduction_lane = index.cmp ult, %lane, %eight : index
  %loads_subgroup_sum = scalar.andi %is_reduction_subgroup, %is_reduction_lane : i1
  %subgroup_partial = scf.if %loads_subgroup_sum -> (f32) {
    %value = view.load %scratch_values[%lane] : view<256xf32, #dense> -> f32
    scf.yield %value : f32
  } else {
    scf.yield %zero_f32 : f32
  }
  %row_sum = kernel.subgroup.reduce<addf> %subgroup_partial : f32
  %writes_scale = scalar.andi %is_reduction_subgroup, %is_subgroup_leader : i1
  scf.if %writes_scale {
    %mean = scalar.divf<reassoc|nnan|ninf|nsz|arcp> %row_sum, %hidden_size_f32 : f32
    %biased_mean = scalar.addf<reassoc|nnan|ninf|nsz> %mean, %epsilon : f32
    %scale = scalar.rsqrtf<nnan|ninf|nsz|afn> %biased_mean : f32
    view.store %scale, %scratch_values[%zero] : f32, view<256xf32, #dense>
  }
  kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
  %row_scale = view.load %scratch_values[%zero] : view<256xf32, #dense> -> f32
  %row_scale_vector = vector.splat %row_scale : vector<4xf32>
  // Reuse one scratch frame for each 1024-element stripe. Hidden sizes need
  // only be divisible by 128; inactive workitems in the final stripe carry
  // zeros and never publish.
  scf.for %stripe_base = [%zero to %hidden_size step %onezerotwofour] {
    %word_element_add = index.mul %workitem, %four : index
    %channel = index.add %stripe_base, %word_element_add : index
    %valid_word = index.cmp ult, %channel, %hidden_size : index
    %mask = vector.mask.range [%channel to %hidden_size step %one] : index -> vector<4xi1>
    %input_values = vector.load.mask %input_view[%token, %channel], %mask, %zero_f32x4 : view<[%launch_token_count]x[%hidden_size]xf32, #dense>, vector<4xi1>, vector<4xf32>
    %learned_weights = vector.load.mask %weight_view[%channel], %mask, %zero_f32x4 : view<[%hidden_size]xf32, #dense>, vector<4xi1>, vector<4xf32>
    %normalized0 = vector.mulf %input_values, %row_scale_vector : vector<4xf32>
    %normalized = vector.mulf %normalized0, %learned_weights : vector<4xf32>
    scf.if %publish_normalized {
      vector.store.mask %normalized, %normalized_output_view[%token, %channel], %mask : vector<4xf32>, view<[%launch_token_count]x[%hidden_size]xf32, #dense>, vector<4xi1>
    }
    %absolute_values = vector.absf %normalized : vector<4xf32>
    %thread_max = vector.reduce<maxnumf> %absolute_values, %zero_f32 : vector<4xf32>, f32
    view.store %thread_max, %scratch_values[%workitem] : f32, view<256xf32, #dense>
    kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
    %word_in_block = index.rem %workitem, %eight : index
    %block_in_stripe = index.div %workitem, %eight : index
    %is_block_leader = index.cmp eq, %word_in_block, %zero : index
    %writes_block_d = scalar.andi %valid_word, %is_block_leader : i1
    scf.if %writes_block_d {
      %cohort_base = index.mul %block_in_stripe, %eight : index
      %cohort_maxima = vector.load %scratch_values[%cohort_base] : view<256xf32, #dense> -> vector<8xf32>
      %amax = vector.reduce<maxnumf> %cohort_maxima, %zero_f32 : vector<8xf32>, f32
      %d = scalar.divf<reassoc|nnan|ninf|nsz|arcp> %amax, %one_twenty_seven : f32
      view.store %d, %scratch_d[%block_in_stripe] : f32, view<32xf32, #dense>
    }
    kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
    %d = scf.if %valid_word -> (f32) {
      %block_d = view.load %scratch_d[%block_in_stripe] : view<32xf32, #dense> -> f32
      scf.yield %block_d : f32
    } else {
      scf.yield %zero_f32 : f32
    }
    %d_nonzero = scalar.cmpf one, %d, %zero_f32 : f32
    %d_inverse = scf.if %d_nonzero -> (f32) {
      %inverse = scalar.divf<reassoc|nnan|ninf|nsz|arcp> %one_f32, %d : f32
      scf.yield %inverse : f32
    } else {
      scf.yield %zero_f32 : f32
    }
    %d_inverse_vector = vector.splat %d_inverse : vector<4xf32>
    %scaled_values = vector.mulf %normalized, %d_inverse_vector : vector<4xf32>
    %rounded_values = vector.roundf %scaled_values : vector<4xf32>
    %quantized_values = vector.fptosi %rounded_values : vector<4xf32> to vector<4xi8>
    %packed_word = vector.bitcast %quantized_values : vector<4xi8> to vector<1xi32>
    scf.if %valid_word {
      %q8_block = index.div %channel, %thirtytwo : index
      %physical_group = index.div %q8_block, %four : index
      %block_in_group = index.rem %q8_block, %four : index
      %group_byte_add = index.mul %physical_group, %group_bytes : index
      %group_byte_index = index.add %token_output_byte_base, %group_byte_add : index
      %payload_byte_index = index.add %group_byte_index, %payload_byte_add : index
      %group_byte_offset = index.cast %group_byte_index : index to offset
      %payload_byte_offset = index.cast %payload_byte_index : index to offset
      %group_ds = buffer.view %q8_output_noalias[%group_byte_offset] : buffer -> view<8xf16, #dense>
      %group_qs = buffer.view %q8_output_noalias[%payload_byte_offset] : buffer -> view<32xi32, #dense>
      %block_word_base = index.mul %block_in_group, %eight : index
      %packed_word_index0 = index.add %block_word_base, %word_in_block : index
      %packed_word_index = index.assume %packed_word_index0 [range(%packed_word_index0, 0, 31)] : index
      vector.store %packed_word, %group_qs[%packed_word_index] : vector<1xi32>, view<32xi32, #dense>
    }
    %thread_quantized_sum = vector.reduce<addf> %rounded_values, %zero_f32 : vector<4xf32>, f32
    view.store %thread_quantized_sum, %scratch_values[%workitem] : f32, view<256xf32, #dense>
    kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
    scf.if %writes_block_d {
      %cohort_base = index.mul %block_in_stripe, %eight : index
      %cohort_sums = vector.load %scratch_values[%cohort_base] : view<256xf32, #dense> -> vector<8xf32>
      %quantized_sum = vector.reduce<addf> %cohort_sums, %zero_f32 : vector<8xf32>, f32
      %s = scalar.mulf<reassoc|nnan|ninf|nsz> %quantized_sum, %d : f32
      %q8_block = index.div %channel, %thirtytwo : index
      %physical_group = index.div %q8_block, %four : index
      %block_in_group = index.rem %q8_block, %four : index
      %group_byte_add = index.mul %physical_group, %group_bytes : index
      %group_byte_index = index.add %token_output_byte_base, %group_byte_add : index
      %group_byte_offset = index.cast %group_byte_index : index to offset
      %group_ds = buffer.view %q8_output_noalias[%group_byte_offset] : buffer -> view<8xf16, #dense>
      %d_f16 = scalar.fptrunc %d : f32 to f16
      %s_f16 = scalar.fptrunc %s : f32 to f16
      %ds_index = index.mul %block_in_group, %two : index
      %s_index = index.add %ds_index, %one : index
      view.store %d_f16, %group_ds[%ds_index] : f16, view<8xf16, #dense>
      view.store %s_f16, %group_ds[%s_index] : f16, view<8xf16, #dense>
    }
    kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
  }
  func.return
}

// Fuses attention RMSNorm directly into the Q8_1 x4 row consumed by decode
// projections. The output has hidden_size / 128 physical groups of 144 bytes.
kernel.def target(@qwen3_moe_attention_prepare_gfx11_wave32) @qwen3_moe_attention_rmsnorm_quantize_q8_1_x4(%token_count: index) {
  %one = index.constant 1 : index
  %twofiftysix = index.constant 256 : index
  kernel.launch.config workgroups(%token_count, %one, %one) workgroup_size(%twofiftysix, %one, %one) : index
} launch(%token_count: index, %input: buffer, %weight: buffer, %output: buffer) {
  %publish_normalized = scalar.constant false : i1
  %input_noalias, %weight_noalias, %output_noalias = buffer.assume.noalias %input, %weight, %output : buffer, buffer, buffer
  func.apply<qwen3_moe.rmsnorm_quantize_q8_1_x4.body>(%publish_normalized, %token_count, %input_noalias, %weight_noalias, %output_noalias, %output_noalias) : (i1, index, buffer, buffer, buffer, buffer)
  kernel.return
}

// Publishes both the ordinary F32 RMSNorm row required by routing and the Q8_1
// x4 row consumed by direct decode contractions.
kernel.def target(@qwen3_moe_attention_prepare_gfx11_wave32) @qwen3_moe_rmsnorm_f32_quantize_q8_1_x4(%token_count: index) {
  %one = index.constant 1 : index
  %twofiftysix = index.constant 256 : index
  kernel.launch.config workgroups(%token_count, %one, %one) workgroup_size(%twofiftysix, %one, %one) : index
} launch(%token_count: index, %input: buffer, %weight: buffer, %normalized_output: buffer, %q8_output: buffer) {
  %publish_normalized = scalar.constant true : i1
  %input_noalias, %weight_noalias, %normalized_output_noalias, %q8_output_noalias = buffer.assume.noalias %input, %weight, %normalized_output, %q8_output : buffer, buffer, buffer, buffer
  func.apply<qwen3_moe.rmsnorm_quantize_q8_1_x4.body>(%publish_normalized, %token_count, %input_noalias, %weight_noalias, %normalized_output_noalias, %q8_output_noalias) : (i1, index, buffer, buffer, buffer, buffer)
  kernel.return
}

// A uniform residual makes RMSNorm equal to the learned weight up to the
// configured epsilon. The nonuniform weights cross two physical Q8_1 groups,
// exercise signed values, and compare every packed metadata and payload byte
// against the ordinary RMSNorm-plus-packer path.
check.case public @qwen3_moe_attention_rmsnorm_quantize_q8_1_x4_differential_case {
  %token_count = check.literal value(1) : index
  %hidden_size = check.literal value(256) : index
  %input = check.generate.fill value(2.0) : tensor<256xf32>
  %weight = check.generate.iota offset(-1.0) step(0.0078125) : tensor<256xf32>
  %normalized = check.generate.fill value(0.0) : tensor<256xf32>
  %expected = check.generate.fill value(0) : tensor<288xi8>
  %actual = check.generate.fill value(1) : tensor<288xi8>
  %dual_normalized = check.generate.fill value(1.0) : tensor<256xf32>
  %dual_q8 = check.generate.fill value(1) : tensor<288xi8>
  func.call @qwen3_moe_rmsnorm_f32(%token_count, %input, %weight, %normalized) : (index, tensor<256xf32>, tensor<256xf32>, tensor<256xf32>)
  func.call @ggml_quantize_q8_1_x4_f32(%token_count, %hidden_size, %normalized, %expected) : (index, index, tensor<256xf32>, tensor<288xi8>)
  func.call @qwen3_moe_attention_rmsnorm_quantize_q8_1_x4(%token_count, %input, %weight, %actual) : (index, tensor<256xf32>, tensor<256xf32>, tensor<288xi8>)
  func.call @qwen3_moe_rmsnorm_f32_quantize_q8_1_x4(%token_count, %input, %weight, %dual_normalized, %dual_q8) : (index, tensor<256xf32>, tensor<256xf32>, tensor<256xf32>, tensor<288xi8>)
  check.expect.equal actual(%actual) expected(%expected) : tensor<288xi8>
  check.expect.close actual(%dual_normalized) expected(%normalized) atol(0.0) rtol(0.0) nan(same) : tensor<256xf32>
  check.expect.equal actual(%dual_q8) expected(%expected) : tensor<288xi8>
  check.return
}

// The production hidden width crosses two complete 1024-element scratch
// stripes. This independently locks the stripe reuse and row-byte addressing.
check.case public @qwen3_moe_attention_rmsnorm_quantize_q8_1_x4_multistripe_case {
  %token_count = check.literal value(1) : index
  %hidden_size = check.literal value(2048) : index
  %input = check.generate.fill value(2.0) : tensor<2048xf32>
  %weight = check.generate.iota offset(-1.0) step(0.0009765625) : tensor<2048xf32>
  %normalized = check.generate.fill value(0.0) : tensor<2048xf32>
  %expected = check.generate.fill value(0) : tensor<2304xi8>
  %actual = check.generate.fill value(1) : tensor<2304xi8>
  %dual_normalized = check.generate.fill value(1.0) : tensor<2048xf32>
  %dual_q8 = check.generate.fill value(1) : tensor<2304xi8>
