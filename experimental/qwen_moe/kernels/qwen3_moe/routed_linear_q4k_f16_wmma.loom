        kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
        scf.yield %next00, %next01, %next10, %next11 : vector<8xf16>, vector<8xf16>, vector<8xf16>, vector<8xf16>
      }
      scf.yield %block_result00, %block_result01, %block_result10, %block_result11 : vector<8xf16>, vector<8xf16>, vector<8xf16>, vector<8xf16>
    }
    // WMMA produces [channel][route] fragments. Store each through a
    // transposed, wave-private LDS slice so every lane can scatter four
