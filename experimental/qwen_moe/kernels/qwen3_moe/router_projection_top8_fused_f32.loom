// Fused decode router projection and deterministic normalized top-8 routing.
//
// Each wave64 computes four adjacent expert logits. A device-scope completion
// sequence publishes the row across workgroups, and the last arrival invokes
// the same row-selection contract as the standalone router. The completion
// counter is reset after route publication so reusable command buffers can
// issue the kernel repeatedly against the same storage.
//
// This schedule is decode-only. Prefill has enough token parallelism to keep
// projection and routing independent without paying completion atomics.
amdgpu.target<gfx11-generic> @qwen3_moe_router_fused_gfx11_wave64 {subgroup_size = 64}

kernel.def target(@qwen3_moe_router_fused_gfx11_wave64) @qwen3_moe_router_projection_top8_fused_decode_f32(%token_count: index, %route_id_stride: index) {
  %expert_count = config.get @qwen3_moe.router.expert_count : index
  %one = index.constant 1 : index
  %four = index.constant 4 : index
  %wave_size = index.constant 64 : index
  %expert_tiles = index.div %expert_count, %four : index
  kernel.launch.config workgroups(%expert_tiles, %one, %one) workgroup_size(%wave_size, %one, %one) : index
} launch(%token_count: index, %route_id_stride: index, %input: buffer, %weight: buffer, %logits: buffer, %completion_counter: buffer, %route_ids: buffer, %route_weights: buffer) {
  %hidden_size0 = config.get @qwen3_moe.model.hidden_size : index
  %expert_count0 = config.get @qwen3_moe.router.expert_count : index
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 1)] : index
  %bounded_route_id_stride = index.assume %route_id_stride [range(%route_id_stride, 1, 512)] : index
  %hidden_size, %expert_count = index.assume %hidden_size0, %expert_count0 [range(%hidden_size0, 128, 32768), mul(%hidden_size0, 128), range(%expert_count0, 64, 512), mul(%expert_count0, 64)] : index, index
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %two = index.constant 2 : index
  %three = index.constant 3 : index
  %four = index.constant 4 : index
  %twofiftysix = index.constant 256 : index
  %expert_tile_count0 = index.div %expert_count, %four : index
  %expert_tile_count = index.assume %expert_tile_count0 [range(%expert_tile_count0, 16, 128)] : index
  %expert_tile0 = kernel.workgroup.id<x> : index
  %expert_tile = index.assume %expert_tile0 [lt(%expert_tile0, %expert_tile_count)] : index
  %lane = kernel.subgroup.lane.id : index
  %zero_i32 = scalar.constant 0 : i32
  %one_i32 = scalar.constant 1 : i32
  %zero_f32 = scalar.constant 0.0 : f32
  %publishes_row = scalar.constant true : i1
  %zero_offset = index.constant 0 : offset
  %token = index.assume %zero [lt(%zero, %bounded_token_count)] : index
  %expert_base = index.mul %expert_tile, %four : index
  %expert1 = index.add %expert_base, %one : index
  %expert2 = index.add %expert_base, %two : index
  %expert3 = index.add %expert_base, %three : index
  %lane_channel = index.mul %lane, %four : index
  %input_noalias, %weight_noalias, %logits_noalias, %completion_counter_noalias, %route_ids_noalias, %route_weights_noalias = buffer.assume.noalias %input, %weight, %logits, %completion_counter, %route_ids, %route_weights : buffer, buffer, buffer, buffer, buffer, buffer
  %completion_counter_global = buffer.assume.memory_space<global> %completion_counter_noalias : buffer
  %completion_counter_aligned = buffer.assume.alignment %completion_counter_global {minimum_alignment = 16} : buffer
  %input_view = buffer.view %input_noalias[%zero_offset] : buffer -> view<[%bounded_token_count]x[%hidden_size]xf32, #dense>
  %weight_view = buffer.view %weight_noalias[%zero_offset] : buffer -> view<[%expert_count]x[%hidden_size]xf32, #dense>
  %logits_view = buffer.view %logits_noalias[%zero_offset] : buffer -> view<[%bounded_token_count]x[%expert_count]xf32, #dense>
  %completion_counter_view = buffer.view %completion_counter_aligned[%zero_offset] : buffer -> view<1xi32, #dense>

  %zero_f32x4 = vector.splat %zero_f32 : vector<4xf32>
  %lane_sums = scf.for %channel = [%lane_channel to %hidden_size step %twofiftysix](%accumulators = %zero_f32x4 : vector<4xf32>) -> (vector<4xf32>) unroll(%four) schedule(interleaved) {
    %input_values = vector.load %input_view[%token, %channel] : view<[%bounded_token_count]x[%hidden_size]xf32, #dense> -> vector<4xf32>
    %weight_values0 = vector.load %weight_view[%expert_base, %channel] : view<[%expert_count]x[%hidden_size]xf32, #dense> -> vector<4xf32>
    %weight_values1 = vector.load %weight_view[%expert1, %channel] : view<[%expert_count]x[%hidden_size]xf32, #dense> -> vector<4xf32>
    %weight_values2 = vector.load %weight_view[%expert2, %channel] : view<[%expert_count]x[%hidden_size]xf32, #dense> -> vector<4xf32>
    %weight_values3 = vector.load %weight_view[%expert3, %channel] : view<[%expert_count]x[%hidden_size]xf32, #dense> -> vector<4xf32>
    %accumulator0 = vector.extract %accumulators[0] : vector<4xf32> -> f32
    %accumulator1 = vector.extract %accumulators[1] : vector<4xf32> -> f32
    %accumulator2 = vector.extract %accumulators[2] : vector<4xf32> -> f32
    %accumulator3 = vector.extract %accumulators[3] : vector<4xf32> -> f32
    %next0 = vector.dotf %input_values, %weight_values0, %accumulator0 : vector<4xf32>, vector<4xf32>, f32
    %next1 = vector.dotf %input_values, %weight_values1, %accumulator1 : vector<4xf32>, vector<4xf32>, f32
    %next2 = vector.dotf %input_values, %weight_values2, %accumulator2 : vector<4xf32>, vector<4xf32>, f32
    %next3 = vector.dotf %input_values, %weight_values3, %accumulator3 : vector<4xf32>, vector<4xf32>, f32
    %next_accumulators = vector.from_elements %next0, %next1, %next2, %next3 : vector<4xf32>
    scf.yield %next_accumulators : vector<4xf32>
  }
  %sums = kernel.subgroup.reduce<addf> %lane_sums : vector<4xf32>
  %lane_i32 = index.cast %lane : index to i32
  %writes_projection = scalar.cmpi eq, %lane_i32, %zero_i32 : i32
  scf.if %writes_projection {
    vector.store %sums, %logits_view[%token, %expert_base] : vector<4xf32>, view<[%bounded_token_count]x[%expert_count]xf32, #dense>
  }

  // Every projection store precedes its workgroup's release. The last arrival
  // acquires all preceding releases before any lane loads the complete row.
  kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
  %local_old_counter = scf.if %writes_projection -> (i32) {
    %old_counter = view.atomic.rmw<addi> %one_i32, %completion_counter_view[%zero] {ordering = acq_rel, scope = device} : i32, view<1xi32, #dense> -> i32
    scf.yield %old_counter : i32
  } else {
    scf.yield %zero_i32 : i32
  }
  %old_counter = kernel.workgroup.reduce<addi> %local_old_counter : i32
  %expert_tile_count_i32 = index.cast %expert_tile_count : index to i32
  %last_expert_tile_i32 = scalar.subi %expert_tile_count_i32, %one_i32 : i32
  %negative_expert_tile_count_i32 = scalar.subi %zero_i32, %expert_tile_count_i32 : i32
  // AMDGPU cannot currently lower scalar.cmpi for the reduced VGPR value.
  // Equality through F32 is exact over this schedule's bounded [0, 127]
  // counter domain. This is a non-sanctioned compiler workaround, not the
  // intended integer comparison contract.
  %old_counter_f32 = scalar.sitofp %old_counter : i32 to f32
  %last_expert_tile_f32 = scalar.sitofp %last_expert_tile_i32 : i32 to f32
  %is_last_projection = scalar.cmpf oeq, %old_counter_f32, %last_expert_tile_f32 : f32
  scf.if %is_last_projection {
    func.apply<qwen3_moe.router.top8.row>(%publishes_row, %token, %bounded_token_count, %bounded_route_id_stride, %logits_noalias, %route_ids_noalias, %route_weights_noalias) : (i1, index, index, index, buffer, buffer, buffer)
    // The counter cannot become reusable until all route stores complete.
    kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
    scf.if %writes_projection {
      view.atomic.reduce<addi> %negative_expert_tile_count_i32, %completion_counter_view[%zero] {ordering = release, scope = device} : i32, view<1xi32, #dense>
    }
  }
  kernel.return
}

// Compare the fused output against the production composition, then invoke the
// fused route again against the same counter to make reset correctness visible.
check.case public @qwen3_moe_router_projection_top8_fused_differential_case {
  %token_count = check.literal value(1) : index
  %route_id_stride = check.literal value(8) : index
  %input = check.generate.iota offset(-0.25) step(0.0078125) period(17) : tensor<1x2048xf32>
  %weight = check.generate.iota offset(-0.5) step(0.015625) period(31) : tensor<128x2048xf32>
  %expected_logits = check.generate.fill value(0.0) : tensor<1x128xf32>
  %expected_route_ids = check.generate.fill value(-1) : tensor<1x8xi32>
  %expected_route_weights = check.generate.fill value(0.0) : tensor<1x8xf32>
  %actual_logits0 = check.generate.fill value(1.0) : tensor<1x128xf32>
  %actual_route_ids0 = check.generate.fill value(-1) : tensor<1x8xi32>
  %actual_route_weights0 = check.generate.fill value(0.0) : tensor<1x8xf32>
  %actual_logits1 = check.generate.fill value(1.0) : tensor<1x128xf32>
  %actual_route_ids1 = check.generate.fill value(-1) : tensor<1x8xi32>
  %actual_route_weights1 = check.generate.fill value(0.0) : tensor<1x8xf32>
  %completion_counter = check.generate.fill value(0) : tensor<1xi32>
  %expected_counter = check.generate.fill value(0) : tensor<1xi32>
  func.call @qwen3_moe_router_projection_f32_four_row_wave32(%token_count, %input, %weight, %expected_logits) : (index, tensor<1x2048xf32>, tensor<128x2048xf32>, tensor<1x128xf32>)
  func.call @qwen3_moe_router_top8_f32(%token_count, %route_id_stride, %expected_logits, %expected_route_ids, %expected_route_weights) : (index, index, tensor<1x128xf32>, tensor<1x8xi32>, tensor<1x8xf32>)
  func.call @qwen3_moe_router_projection_top8_fused_decode_f32(%token_count, %route_id_stride, %input, %weight, %actual_logits0, %completion_counter, %actual_route_ids0, %actual_route_weights0) : (index, index, tensor<1x2048xf32>, tensor<128x2048xf32>, tensor<1x128xf32>, tensor<1xi32>, tensor<1x8xi32>, tensor<1x8xf32>)
  func.call @qwen3_moe_router_projection_top8_fused_decode_f32(%token_count, %route_id_stride, %input, %weight, %actual_logits1, %completion_counter, %actual_route_ids1, %actual_route_weights1) : (index, index, tensor<1x2048xf32>, tensor<128x2048xf32>, tensor<1x128xf32>, tensor<1xi32>, tensor<1x8xi32>, tensor<1x8xf32>)
  check.expect.close actual(%actual_logits0) expected(%expected_logits) atol(0.001) rtol(0.001) nan(same) : tensor<1x128xf32>
  check.expect.close actual(%actual_logits1) expected(%expected_logits) atol(0.001) rtol(0.001) nan(same) : tensor<1x128xf32>
  check.expect.equal actual(%actual_route_ids0) expected(%expected_route_ids) : tensor<1x8xi32>
  check.expect.equal actual(%actual_route_ids1) expected(%expected_route_ids) : tensor<1x8xi32>
  check.expect.close actual(%actual_route_weights0) expected(%expected_route_weights) atol(0.0001) rtol(0.0001) nan(same) : tensor<1x8xf32>
  check.expect.close actual(%actual_route_weights1) expected(%expected_route_weights) atol(0.0001) rtol(0.0001) nan(same) : tensor<1x8xf32>
  check.expect.equal actual(%completion_counter) expected(%expected_counter) : tensor<1xi32>
  check.return
}

check.case public @qwen3_moe_router_projection_top8_fused_benchmark_case {
  %token_count = check.literal value(1) : index
  %route_id_stride = check.literal value(8) : index
  %input = check.generate.fill value(0.00390625) : tensor<1x2048xf32>
  %weight = check.generate.fill value(0.015625) : tensor<128x2048xf32>
  %logits = check.generate.fill value(0.0) : tensor<1x128xf32>
  %completion_counter = check.generate.fill value(0) : tensor<1xi32>
  %route_ids = check.generate.fill value(-1) : tensor<1x8xi32>
  %route_weights = check.generate.fill value(0.0) : tensor<1x8xf32>
  func.call @qwen3_moe_router_projection_top8_fused_decode_f32(%token_count, %route_id_stride, %input, %weight, %logits, %completion_counter, %route_ids, %route_weights) : (index, index, tensor<1x2048xf32>, tensor<128x2048xf32>, tensor<1x128xf32>, tensor<1xi32>, tensor<1x8xi32>, tensor<1x8xf32>)
  check.return
}

check.case public @qwen3_moe_router_projection_top8_composed_benchmark_case {
  %token_count = check.literal value(1) : index
  %route_id_stride = check.literal value(8) : index
  %input = check.generate.fill value(0.00390625) : tensor<1x2048xf32>
  %weight = check.generate.fill value(0.015625) : tensor<128x2048xf32>
  %logits = check.generate.fill value(0.0) : tensor<1x128xf32>
  %route_ids = check.generate.fill value(-1) : tensor<1x8xi32>
  %route_weights = check.generate.fill value(0.0) : tensor<1x8xf32>
  func.call @qwen3_moe_router_projection_f32_four_row_wave32(%token_count, %input, %weight, %logits) : (index, tensor<1x2048xf32>, tensor<128x2048xf32>, tensor<1x128xf32>)
  func.call @qwen3_moe_router_top8_f32(%token_count, %route_id_stride, %logits, %route_ids, %route_weights) : (index, index, tensor<1x128xf32>, tensor<1x8xi32>, tensor<1x8xf32>)
  check.return
}

check.benchmark<@qwen3_moe_router_projection_top8_fused_benchmark_case> @qwen3_moe_router_projection_top8_fused_decode

check.benchmark<@qwen3_moe_router_projection_top8_composed_benchmark_case> @qwen3_moe_router_projection_top8_composed_decode
