load("//build_tools/bazel:executable.bzl", "iree_executable_test")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],  # Apache 2.0
)

exports_files([
    "ggml/quantize_q8_1_x4.loom",
    "qwen3_moe/routed_gate_up_swiglu_q4k.loom",
])

iree_executable_test(
    name = "quantize_q8_1_x4_plan_test",
    src = "//loom/src/loom/tools/iree-benchmark-loom",
    args = [
        "$(location ggml/quantize_q8_1_x4.loom)",
        "--dry-run",
        "--output-format=jsonl",
    ],
    data = ["ggml/quantize_q8_1_x4.loom"],
    tags = ["hostonly"],
)

iree_executable_test(
    name = "quantize_q8_1_x4_hal_test",
    src = "//loom/src/loom/tools/iree-test-loom",
    args = [
        "$(location ggml/quantize_q8_1_x4.loom)",
        "--case=@ggml_quantize_q8_1_x4_f32_nonzero_case",
        "--device=amdgpu://0",
    ],
    data = ["ggml/quantize_q8_1_x4.loom"],
    tags = [
        "iree-run-requirement=runtime.resource.amd_gpu",
        "manual",
        "requires-gpu-amd",
        "runtime-resource=amd-gpu",
    ],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/execute:amdgpu_hal",
    ]),
)

iree_executable_test(
    name = "routed_gate_up_swiglu_q4k_plan_test",
    src = "//loom/src/loom/tools/iree-benchmark-loom",
    args = [
        "$(location qwen3_moe/routed_gate_up_swiglu_q4k.loom)",
        "--dry-run",
        "--output-format=jsonl",
    ],
    data = ["qwen3_moe/routed_gate_up_swiglu_q4k.loom"],
    tags = ["hostonly"],
)

iree_executable_test(
    name = "routed_gate_up_swiglu_q4k_hal_test",
    src = "//loom/src/loom/tools/iree-test-loom",
    args = [
        "$(location qwen3_moe/routed_gate_up_swiglu_q4k.loom)",
        "--case=@qwen3_moe_routed_gate_up_swiglu_q4k_nonzero_case",
        "--device=amdgpu://0",
    ],
    data = ["qwen3_moe/routed_gate_up_swiglu_q4k.loom"],
    tags = [
        "iree-run-requirement=runtime.resource.amd_gpu",
        "manual",
        "requires-gpu-amd",
        "runtime-resource=amd-gpu",
    ],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/execute:amdgpu_hal",
    ]),
)

test_suite(
    name = "tests",
    tests = [
        ":quantize_q8_1_x4_hal_test",
        ":quantize_q8_1_x4_plan_test",
        ":routed_gate_up_swiglu_q4k_hal_test",
        ":routed_gate_up_swiglu_q4k_plan_test",
    ],
)
