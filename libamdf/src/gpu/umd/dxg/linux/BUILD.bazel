load("//libamdf/build_tools/bazel:cc.bzl", "amdf_cc_library")
load("//libamdf/build_tools/bazel:cc_test.bzl", "amdf_cc_test")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

amdf_cc_library(
    name = "logical_device",
    srcs = ["logical_device.c"],
    hdrs = ["logical_device.h"],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = [
        "//libamdf/src/gpu/umd/dxg:adapter",
        "//libamdf/src/platform/linux/dxg:endpoint",
        "//libamdf/src/platform/linux/dxg:kmt",
    ],
)

amdf_cc_test(
    name = "logical_device_test",
    srcs = ["logical_device_test.cc"],
    linkopts = ["-Wl,--wrap=amdf_linux_dxg_connection_invoke"],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = [
        ":logical_device",
        "//libamdf/src:allocator",
        "//third_party:google_test",
        "//third_party:google_test_main",
    ],
)
