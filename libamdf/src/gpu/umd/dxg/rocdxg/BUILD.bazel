load("//libamdf/build_tools/bazel:cc.bzl", "amdf_cc_library")
load("//libamdf/build_tools/bazel:cc_test.bzl", "amdf_cc_test")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

amdf_cc_test(
    name = "allocation_test",
    srcs = [
        "adapter_state.cc",
        "adapter_state.h",
        "allocation.cc",
        "allocation.h",
        "allocation_test.cc",
    ],
    copts = ["-Wno-unknown-pragmas"],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = [
        "//libamdf/src:allocator",
        "//libamdf/src/gpu/umd/dxg:bridge_allocator",
        "//libamdf/src/gpu/umd/dxg:bridge_api",
        "//libamdf/src/gpu/umd/dxg:private_records",
        "//third_party:amdf_rocdxg_headers",
        "//third_party:google_test",
        "//third_party:google_test_main",
    ],
)

amdf_cc_library(
    name = "bridge",
    srcs = [
        "adapter_state.cc",
        "adapter_state.h",
        "allocation.cc",
        "allocation.h",
        "bridge.cc",
        "clock.cc",
        "clock.h",
        "kernel_queue.cc",
        "kernel_queue.h",
    ],
    hdrs = ["api.h"],
    copts = ["-Wno-unknown-pragmas"],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    visibility = ["//libamdf/src/gpu/umd/dxg/linux:__pkg__"],
    deps = [
        "//libamdf/src/gpu/umd/dxg:bridge_allocator",
        "//libamdf/src/gpu/umd/dxg:bridge_api",
        "//libamdf/src/gpu/umd/dxg:private_records",
        "//third_party:amdf_rocdxg_headers",
    ],
)

