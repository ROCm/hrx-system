load("//build_tools/bazel:dynamic_library_bundle.bzl", "iree_dynamic_library_bundle")
load("//libamdf/build_tools/bazel:cc.bzl", "amdf_cc_library")
load("//libamdf/build_tools/bazel:cc_test.bzl", "amdf_cc_test")
load("//libamdf/build_tools/bazel:linux_sidecar.bzl", "amdf_linux_sidecar_library")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

amdf_cc_library(
    name = "native_transport",
    srcs = ["dxcore_loader_compatibility.cc"],
    hdrs = ["native_transport.h"],
    copts = ["-Wno-unknown-pragmas"],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = [
        "//libamdf/src/gpu/umd/dxg:bridge_api",
        "//third_party:amdf_rocdxg_headers",
    ],
)

amdf_linux_sidecar_library(
    name = "amdf_rocdxg_bridge",
    srcs = [
        "adapter_state.cc",
        "adapter_state.h",
        "allocation.cc",
        "allocation.h",
        "bridge.cc",
        "clock.cc",
        "clock.h",
        "gfxip_compatibility.cc",
        "kernel_queue.cc",
        "kernel_queue.h",
        "native_allocation_flags.h",
    ],
    exports_file = "exports.map",
    visibility = ["//libamdf/src/gpu/umd/dxg/linux:__pkg__"],
    deps = [
        ":native_transport",
        "//libamdf/src/gpu/umd/dxg:bridge_allocator",
        "//libamdf/src/gpu/umd/dxg:bridge_api",
        "//third_party:amdf_rocdxg_headers",
        "//third_party:amdf_rocdxg_thunk_proxy",
        "//third_party:amdf_wkmi",
    ],
)

iree_dynamic_library_bundle(
    name = "runtime",
    environment = {
        ":amdf_rocdxg_bridge": "AMDF_DXG_BRIDGE_PATH",
    },
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    visibility = ["//libamdf:__pkg__"],
)

amdf_cc_library(
    name = "loader",
    srcs = ["loader.c"],
    hdrs = ["loader.h"],
    linkopts = ["-ldl"],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    visibility = ["//libamdf/src/gpu/umd/dxg/linux:__pkg__"],
    deps = [
        "//libamdf/src:allocator",
        "//libamdf/src/gpu/umd/dxg:bridge_api",
    ],
)

amdf_cc_test(
    name = "loader_test",
    srcs = ["loader_test.cc"],
    data = [":amdf_rocdxg_bridge"],
    env = {
        "AMDF_DXG_BRIDGE_PATH": "$(location :amdf_rocdxg_bridge)",
    },
    linkopts = ["-ldl"],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = [
        ":loader",
        "//libamdf/src:allocator",
        "//third_party:google_test",
        "//third_party:google_test_main",
    ],
)

amdf_cc_test(
    name = "native_allocation_flags_test",
    srcs = [
        "native_allocation_flags.h",
