load("//libamdf/build_tools/bazel:cc.bzl", "amdf_cc_library")
load("//libamdf/build_tools/bazel:cc_test.bzl", "amdf_cc_test")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

amdf_cc_library(
    name = "sparse_mapping_test_support",
    testonly = True,
    hdrs = ["sparse_mapping_test.h"],
    visibility = [
        "//libamdf/src/gpu/umd/kfd:__pkg__",
        "//libamdf/src/gpu/umd/wddm:__pkg__",
    ],
    deps = [
        "//libamdf/cts/gpu/sdma/encoding:commands",
        "//libamdf/cts/gpu/util:sparse_mapping_layout",
        "//third_party:google_test",
    ],
)

amdf_cc_library(
    name = "instance",
    hdrs = ["instance.h"],
    visibility = [
        "//libamdf/src/gpu:__subpackages__",
        "//libamdf/src/provider:__pkg__",
    ],
)

amdf_cc_library(
    name = "device",
    hdrs = ["device.h"],
    visibility = ["//libamdf/src/gpu:__subpackages__"],
    deps = [
        ":instance",
        "//libamdf/src/platform",
    ],
)

amdf_cc_library(
    name = "clock",
    hdrs = ["clock.h"],
    visibility = ["//libamdf/src/gpu:__subpackages__"],
    deps = [":device"],
)

amdf_cc_library(
    name = "endpoint_profile",
    hdrs = ["endpoint_profile.h"],
    visibility = ["//libamdf/src/gpu:__subpackages__"],
    deps = [
        "//libamdf/src/gpu:endpoint_profile",
        "//libamdf/src/platform",
    ],
)

amdf_cc_library(
    name = "memory",
    srcs = ["memory.c"],
    hdrs = ["memory.h"],
    visibility = ["//libamdf/src/gpu:__subpackages__"],
    deps = [
        "//libamdf/src:memory_pair",
        "//libamdf/src:memory_profile",
    ],
)

amdf_cc_test(
    name = "memory_test",
    srcs = ["memory_test.cc"],
    deps = [
        ":memory",
        "//third_party:google_test",
        "//third_party:google_test_main",
    ],
)

amdf_cc_library(
    name = "memory_reservation",
    hdrs = ["memory_reservation.h"],
    visibility = ["//libamdf/src/gpu:__subpackages__"],
    deps = [
        ":kernel_queue",
        ":memory",
    ],
)

amdf_cc_library(
    name = "kernel_queue",
    hdrs = ["kernel_queue.h"],
    visibility = ["//libamdf/src/gpu:__subpackages__"],
    deps = [
        ":device",
        "//libamdf/src:wait",
    ],
)

amdf_cc_library(
    name = "user_queue",
    hdrs = ["user_queue.h"],
    visibility = ["//libamdf/src/gpu:__subpackages__"],
    deps = [
        ":device",
        "//libamdf/src:wait",
    ],
)

amdf_cc_library(
    name = "event",
    hdrs = ["event.h"],
    visibility = ["//libamdf/src/gpu:__subpackages__"],
    deps = [":device"],
)

amdf_cc_library(
    name = "umd",
    target_compatible_with = ["@platforms//cpu:x86_64"] + select({
        "@platforms//os:linux": [],
        "@platforms//os:windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//libamdf/src/gpu:__pkg__"],
    deps = [
        ":device",
        ":endpoint_profile",
        ":event",
        ":instance",
        ":kernel_queue",
        ":memory",
        ":user_queue",
    ] + select({
        "@platforms//os:linux": ["//libamdf/src/gpu/umd/kfd"],
        "@platforms//os:windows": ["//libamdf/src/gpu/umd/wddm"],
        "//conditions:default": [],
    }),
)
