load("//build_tools/bazel:test_resources.bzl", "GPU_DEVICE_RESOURCE_GROUP")
load("//libamdf/build_tools/bazel:cc.bzl", "amdf_cc_library")
load("//libamdf/build_tools/bazel:cc_test.bzl", "amdf_cc_test")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_WINDOWS_X86_64 = [
    "@platforms//cpu:x86_64",
    "@platforms//os:windows",
]

amdf_cc_library(
    name = "api",
    hdrs = ["api.h"],
    target_compatible_with = _WINDOWS_X86_64,
    visibility = ["//libamdf/src/gpu/umd/wddm:__pkg__"],
    deps = [
        "//libamdf/src/gpu/umd/dxg:provider_api",
        "//libamdf/src/platform/windows:d3d12_api",
        "//libamdf/src/platform/windows:kmt_api",
    ],
)

amdf_cc_library(
    name = "provider",
    srcs = [
        "adapter_state.cc",
        "adapter_state.h",
        "allocation.cc",
        "allocation.h",
        "kernel_queue.cc",
        "kernel_queue.h",
        "provider.cc",
        "shared_buffer.cc",
        "shared_buffer.h",
    ],
    target_compatible_with = _WINDOWS_X86_64,
    visibility = ["//libamdf/src/gpu/umd/wddm:__pkg__"],
    deps = [
        ":api",
        "//libamdf/src/gpu/umd/dxg:private_records",
        "//libamdf/src/gpu/umd/dxg:provider_allocator",
        "//libamdf/src/gpu/umd/dxg:provider_api",
        "//libamdf/src/platform/windows:d3d12_api",
        "//libamdf/src/platform/windows:kmt_api",
    ],
)

amdf_cc_library(
    name = "fake_api",
    testonly = True,
    srcs = ["fake_api.cc"],
    hdrs = ["fake_api.h"],
    target_compatible_with = _WINDOWS_X86_64,
    visibility = ["//libamdf/src/gpu/umd/wddm:__pkg__"],
    deps = [
        ":api",
        "//libamdf/src/gpu/umd/dxg:provider_api",
    ],
)

amdf_cc_test(
    name = "adapter_info_system_test",
    srcs = ["adapter_info_system_test.cc"],
    linkopts = ["gdi32.lib"],
    resource_group = GPU_DEVICE_RESOURCE_GROUP,
    tags = [
        "iree-run-requirement=libamdf.resource.amd_gpu",
        "runtime-resource=amd-gpu",
    ],
    target_compatible_with = _WINDOWS_X86_64,
    deps = ["//libamdf/src/gpu/umd/dxg:private_records"],
)

amdf_cc_test(
    name = "allocation_test",
    srcs = [
        "adapter_state.cc",
        "adapter_state.h",
        "allocation.cc",
        "allocation.h",
        "allocation_test.cc",
    ],
    target_compatible_with = _WINDOWS_X86_64,
    deps = [
        "//libamdf/src/gpu/umd/dxg:private_records",
        "//libamdf/src/gpu/umd/dxg:provider_allocator",
        "//libamdf/src/gpu/umd/dxg:provider_api",
        "//libamdf/src/platform/windows:d3d12_api",
        "//libamdf/src/platform/windows:kmt_api",
    ],
)

amdf_cc_test(
    name = "kernel_queue_test",
    srcs = [
        "adapter_state.cc",
        "adapter_state.h",
        "kernel_queue.cc",
        "kernel_queue.h",
        "kernel_queue_test.cc",
    ],
    target_compatible_with = _WINDOWS_X86_64,
    deps = [
        "//libamdf/src/gpu/umd/dxg:private_records",
        "//libamdf/src/gpu/umd/dxg:provider_allocator",
        "//libamdf/src/gpu/umd/dxg:provider_api",
        "//libamdf/src/platform/windows:d3d12_api",
        "//libamdf/src/platform/windows:kmt_api",
    ],
)
