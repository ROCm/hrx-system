amdf_windows_sidecar_library(
    name = "sparse_mapping_queue_test_helper",
    testonly = True,
    srcs = [
        "sparse_mapping_queue_test.cc",
        "sparse_mapping_queue_test.h",
        "//libamdf/src/gpu/umd/wddm/wkmi:dxcore_loader_compatibility.cc",
    ],
    linkopts = ["gdi32.lib"],
    deps = ["//third_party:amdf_wkmi"],
)

amdf_cc_test(
    name = "sparse_mapping_test",
    size = "medium",
    srcs = [
        "sparse_mapping_queue_test.h",
        "sparse_mapping_test.cc",
    ],
    data = [":sparse_mapping_queue_test_helper"],
    env = {
        "AMDF_SPARSE_MAPPING_QUEUE_TEST_PATH": "$(location :sparse_mapping_queue_test_helper)",
    },
    resource_group = GPU_DEVICE_RESOURCE_GROUP,
    tags = ["iree-run-requirement=libamdf.resource.amd_gpu"],
    target_compatible_with = ["@platforms//os:windows"],
    deps = [
        ":device_state",
        "//libamdf:amdf_static",
        "//libamdf/src:allocator",
        "//libamdf/src:wait",
        "//libamdf/src/gpu/umd:endpoint_profile",
        "//libamdf/src/gpu/umd:kernel_queue",
        "//libamdf/src/gpu/umd:memory",
        "//libamdf/src/gpu/umd:memory_reservation",
        "//libamdf/src/gpu/umd:sparse_mapping_test_support",
        "//libamdf/src/platform",
        "//libamdf/src/platform/windows:endpoint",
        "//third_party:google_test",
        "//third_party:google_test_main",
    ],
)

