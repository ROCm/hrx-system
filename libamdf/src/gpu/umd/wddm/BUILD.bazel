load("//libamdf/build_tools/bazel:cc.bzl", "amdf_cc_library")
load("//libamdf/build_tools/bazel:cc_test.bzl", "amdf_cc_test")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

amdf_cc_library(
    name = "device_state",
    hdrs = ["device.h"],
    target_compatible_with = ["@platforms//os:windows"],
    deps = [
        ":memory_profile",
        "//libamdf/src/gpu/umd:device",
        "//libamdf/src/gpu/umd/wddm/wkmi:adapter",
        "//libamdf/src/platform/windows:device_status",
        "//libamdf/src/platform/windows:kmt_api",
    ],
)

amdf_cc_library(
    name = "memory_profile",
    srcs = ["memory_profile.c"],
    hdrs = ["memory_profile.h"],
    target_compatible_with = ["@platforms//os:windows"],
    deps = [
        "//libamdf/src:memory_profile",
        "//libamdf/src/platform",
        "//libamdf/src/platform/windows:endpoint",
    ],
)

amdf_cc_library(
    name = "memory",
    srcs = ["memory.c"],
    target_compatible_with = ["@platforms//os:windows"],
    deps = [
        ":device_state",
        ":memory_profile",
        "//libamdf/src:allocator",
        "//libamdf/src/gpu/umd:memory",
        "//libamdf/src/platform/windows:host_cache",
    ],
)

amdf_cc_library(
    name = "kernel_queue",
    srcs = ["kernel_queue.c"],
    target_compatible_with = ["@platforms//os:windows"],
    deps = [
        ":device_state",
        "//libamdf/src:allocator",
        "//libamdf/src:wait",
        "//libamdf/src/gpu/umd:kernel_queue",
        "//libamdf/src/gpu/umd/wddm/wkmi:adapter",
        "//libamdf/src/platform:wait",
        "//libamdf/src/platform/windows:kmt_api",
    ],
)

amdf_cc_library(
    name = "user_queue",
    srcs = ["user_queue.c"],
    target_compatible_with = ["@platforms//os:windows"],
    deps = ["//libamdf/src/gpu/umd:user_queue"],
)

amdf_cc_library(
    name = "instance",
    srcs = ["instance.c"],
    target_compatible_with = ["@platforms//os:windows"],
    deps = ["//libamdf/src/gpu/umd:instance"],
)

amdf_cc_library(
    name = "device",
    srcs = ["device.c"],
    target_compatible_with = ["@platforms//os:windows"],
    deps = [
        ":device_state",
        ":memory_profile",
        "//libamdf/src:allocator",
        "//libamdf/src/platform/windows:endpoint",
    ],
)

amdf_cc_library(
    name = "endpoint_profile",
    srcs = ["endpoint_profile.c"],
    target_compatible_with = ["@platforms//os:windows"],
    visibility = ["//libamdf/src/gpu/umd:__pkg__"],
    deps = [
        ":memory_profile",
        "//libamdf/src:allocator",
        "//libamdf/src/gpu:endpoint_profile",
        "//libamdf/src/gpu/umd:endpoint_profile",
        "//libamdf/src/gpu/umd/wddm/wkmi:adapter",
        "//libamdf/src/gpu/umd/wddm/wkmi:endpoint_properties",
        "//libamdf/src/platform/windows:endpoint",
    ],
)

amdf_cc_library(
    name = "wddm",
    target_compatible_with = ["@platforms//os:windows"],
    visibility = ["//libamdf/src/gpu/umd:__pkg__"],
    deps = [
        ":device",
        ":endpoint_profile",
        ":instance",
        ":kernel_queue",
        ":memory",
        ":user_queue",
    ],
)

amdf_cc_test(
    name = "endpoint_profile_test",
    srcs = ["endpoint_profile_test.cc"],
    data = ["//libamdf/src/gpu/umd/wddm/wkmi:fake_wkmi_bridge_test"],
    env = {
        "AMDF_WKMI_BRIDGE_PATH": "$(location //libamdf/src/gpu/umd/wddm/wkmi:fake_wkmi_bridge_test)",
    },
    target_compatible_with = ["@platforms//os:windows"],
    deps = [
        ":endpoint_profile",
        "//libamdf/src:allocator",
        "//libamdf/src/gpu/umd:endpoint_profile",
        "//libamdf/src/platform/windows:endpoint",
        "//third_party:google_test",
        "//third_party:google_test_main",
    ],
)

amdf_cc_test(
    name = "device_test",
    srcs = ["device_test.cc"],
    data = ["//libamdf/src/gpu/umd/wddm/wkmi:fake_wkmi_bridge_test"],
    env = {
        "AMDF_WKMI_BRIDGE_PATH": "$(location //libamdf/src/gpu/umd/wddm/wkmi:fake_wkmi_bridge_test)",
    },
    target_compatible_with = ["@platforms//os:windows"],
    deps = [
        ":device",
        "//libamdf/src:allocator",
        "//libamdf/src/gpu/umd:device",
        "//libamdf/src/platform/windows:endpoint",
        "//third_party:google_test",
        "//third_party:google_test_main",
    ],
)

amdf_cc_test(
    name = "kernel_queue_test",
    srcs = ["kernel_queue_test.cc"],
    target_compatible_with = ["@platforms//os:windows"],
    deps = [
        ":device_state",
        ":kernel_queue",
        "//libamdf/src:allocator",
        "//libamdf/src:wait",
        "//libamdf/src/gpu/umd:kernel_queue",
        "//third_party:google_test",
        "//third_party:google_test_main",
    ],
)

amdf_cc_test(
    name = "memory_test",
    srcs = ["memory_test.cc"],
    target_compatible_with = ["@platforms//os:windows"],
    deps = [
        ":device_state",
        ":memory",
        "//libamdf/src:allocator",
        "//libamdf/src/gpu/umd:memory",
        "//third_party:google_test",
        "//third_party:google_test_main",
    ],
)
