load("//libamdf/build_tools/bazel:cc.bzl", "amdf_cc_library")
load("//libamdf/build_tools/bazel:cc_test.bzl", "amdf_cc_test")

package(
    default_visibility = ["//visibility:private"],
    licenses = ["notice"],
)

KFD_COMPATIBILITY = [
    "@platforms//os:linux",
    "@platforms//cpu:x86_64",
]

amdf_cc_library(
    name = "compute_storage",
    srcs = ["compute_storage.c"],
    hdrs = ["compute_storage.h"],
    target_compatible_with = KFD_COMPATIBILITY,
    visibility = ["//libamdf/src/gpu/umd/kfd:__subpackages__"],
    deps = [
        "//libamdf/src/gpu/umd/kfd:buffer",
        "//libamdf/src/gpu/umd/kfd:topology",
        "//third_party:linux_kfd_uapi",
    ],
)

amdf_cc_test(
    name = "compute_storage_test",
    srcs = ["compute_storage_test.cc"],
    target_compatible_with = KFD_COMPATIBILITY,
    deps = [
        ":compute_storage",
        "//third_party:google_test",
        "//third_party:google_test_main",
    ],
)

amdf_cc_library(
    name = "queue_plan",
    hdrs = ["queue_plan.h"],
    target_compatible_with = KFD_COMPATIBILITY,
    visibility = ["//libamdf/src/gpu/umd/kfd:__subpackages__"],
    deps = [
        ":compute_storage",
        "//libamdf/src/gpu:endpoint_profile",
        "//libamdf/src/gpu/umd/kfd:buffer",
    ],
)

[amdf_cc_library(
    name = name,
    srcs = [name + ".c"],
    hdrs = [name + ".h"],
    target_compatible_with = KFD_COMPATIBILITY,
    deps = [
        ":queue_plan",
        "//libamdf/src/gpu/umd/kfd:topology",
        "//third_party:linux_kfd_uapi",
    ] + ([":compute_storage"] if name != "sdma_queue" else []) + (["//libamdf/src/gpu/umd/kfd:aql"] if name == "aql_queue" else []),
) for name in [
    "aql_queue",
    "pm4_queue",
    "sdma_queue",
]]

amdf_cc_library(
    name = "user_queue",
    srcs = ["user_queue.c"],
    hdrs = ["user_queue.h"],
    target_compatible_with = KFD_COMPATIBILITY,
    visibility = ["//libamdf/src/gpu/umd/kfd:__pkg__"],
    deps = [
        ":aql_queue",
        ":pm4_queue",
        ":queue_plan",
        ":sdma_queue",
        "//libamdf/src/gpu/umd/kfd:hdp",
        "//libamdf/src/gpu/umd/kfd:topology",
    ],
)

amdf_cc_test(
    name = "user_queue_test",
    srcs = ["user_queue_test.cc"],
    target_compatible_with = KFD_COMPATIBILITY,
    deps = [
        ":user_queue",
        "//third_party:google_test",
        "//third_party:google_test_main",
    ],
)
