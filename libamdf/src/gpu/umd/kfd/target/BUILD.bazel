load("//libamdf/build_tools/bazel:cc.bzl", "amdf_cc_library")
load("//libamdf/build_tools/bazel:cc_test.bzl", "amdf_cc_test")

package(
    default_visibility = ["//visibility:private"],
    licenses = ["notice"],
)

KFD_COMPATIBILITY = [
    "@platforms//os:linux",
    "@platforms//cpu:x86_64",
]

amdf_cc_library(
    name = "memory",
    srcs = ["memory.c"],
    hdrs = ["memory.h"],
    target_compatible_with = KFD_COMPATIBILITY,
    visibility = ["//libamdf/src/gpu/umd/kfd:__pkg__"],
    deps = ["//libamdf/src/gpu/umd/kfd:topology"],
)

amdf_cc_test(
    name = "memory_test",
    srcs = ["memory_test.cc"],
    target_compatible_with = KFD_COMPATIBILITY,
    deps = [
        ":memory",
        "//third_party:google_test",
        "//third_party:google_test_main",
    ],
)

amdf_cc_library(
    name = "queue_plan",
    hdrs = ["queue_plan.h"],
    target_compatible_with = KFD_COMPATIBILITY,
    visibility = ["//libamdf/src/gpu/umd/kfd:__subpackages__"],
    deps = [
        "//libamdf/src/gpu:endpoint_profile",
        "//libamdf/src/gpu/umd/kfd:buffer",
    ],
)

amdf_cc_library(
    name = "user_queue",
    srcs = ["user_queue.c"],
    hdrs = ["user_queue.h"],
    target_compatible_with = KFD_COMPATIBILITY,
    visibility = ["//libamdf/src/gpu/umd/kfd:__pkg__"],
    deps = [
        ":queue_plan",
        "//libamdf/src/gpu/umd/kfd:topology",
        "//libamdf/src/gpu/umd/kfd/target/gfx1151:pm4_queue",
        "//libamdf/src/gpu/umd/kfd/target/gfx1151:sdma_queue",
    ],
)

amdf_cc_test(
    name = "user_queue_test",
    srcs = ["user_queue_test.cc"],
    target_compatible_with = KFD_COMPATIBILITY,
    deps = [
        ":user_queue",
        "//third_party:google_test",
        "//third_party:google_test_main",
    ],
)
