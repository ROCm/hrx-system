load("//libamdf/build_tools/bazel:cc.bzl", "amdf_cc_library")
load("//libamdf/build_tools/bazel:cc_test.bzl", "amdf_cc_test")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

amdf_cc_library(
    name = "endpoint_profile",
    srcs = ["endpoint_profile.c"],
    hdrs = ["endpoint_profile.h"],
    visibility = ["//libamdf/src/gpu:__subpackages__"],
    deps = ["//libamdf/src:memory_profile"],
)

amdf_cc_library(
    name = "device",
    srcs = [
        "device.c",
        "memory.c",
    ],
    hdrs = [
        "device.h",
        "memory.h",
    ],
    deps = [
        ":endpoint_profile",
        "//libamdf/src:allocator",
        "//libamdf/src:device",
        "//libamdf/src:endpoint",
        "//libamdf/src:host_mapping",
        "//libamdf/src:instance",
        "//libamdf/src:memory",
        "//libamdf/src:memory_profile",
        "//libamdf/src:structure",
        "//libamdf/src/gpu/umd:device",
        "//libamdf/src/gpu/umd:instance",
        "//libamdf/src/gpu/umd:memory",
        "//libamdf/src/platform",
    ],
)

amdf_cc_library(
    name = "kernel_queue",
    srcs = ["kernel_queue.c"],
    hdrs = ["kernel_queue.h"],
    deps = [
        ":device",
        "//libamdf/src:allocator",
        "//libamdf/src:atomics",
        "//libamdf/src:device",
        "//libamdf/src:endpoint",
        "//libamdf/src:kernel_queue",
        "//libamdf/src:memory",
        "//libamdf/src:structure",
        "//libamdf/src:wait",
        "//libamdf/src/gpu/umd:kernel_queue",
        "//libamdf/src/platform:wait",
    ],
)

amdf_cc_library(
    name = "user_queue",
    srcs = ["user_queue.c"],
    hdrs = ["user_queue.h"],
    deps = [
        ":device",
        "//libamdf/src:allocator",
        "//libamdf/src:device",
        "//libamdf/src:endpoint",
        "//libamdf/src:memory",
        "//libamdf/src:structure",
        "//libamdf/src:user_queue",
        "//libamdf/src:wait",
        "//libamdf/src/gpu/umd:user_queue",
    ],
)

amdf_cc_library(
    name = "extension",
    srcs = ["extension.c"],
    hdrs = ["extension.h"],
    visibility = ["//libamdf/src/provider:__pkg__"],
    deps = [
        ":device",
        ":endpoint_profile",
        ":kernel_queue",
        ":user_queue",
        "//libamdf/src:endpoint",
        "//libamdf/src:instance",
        "//libamdf/src:structure",
        "//libamdf/src/gpu/umd:endpoint_profile",
    ],
)

amdf_cc_library(
    name = "gpu",
    target_compatible_with = ["@platforms//cpu:x86_64"] + select({
        "@platforms//os:linux": [],
        "@platforms//os:windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//libamdf/src/provider:__pkg__"],
    deps = [
        ":extension",
        "//libamdf/src/gpu/umd",
    ],
)

amdf_cc_test(
    name = "endpoint_profile_test",
    srcs = ["endpoint_profile_test.cc"],
    deps = [
        ":endpoint_profile",
        "//third_party:google_test",
        "//third_party:google_test_main",
    ],
)

amdf_cc_test(
    name = "user_queue_test",
    srcs = ["user_queue_test.cc"],
    deps = [
        ":device",
        ":user_queue",
        "//libamdf/src:allocator",
        "//libamdf/src:child_tracker",
        "//libamdf/src:device",
        "//libamdf/src:memory",
        "//libamdf/src:user_queue",
        "//libamdf/src/gpu/umd:user_queue",
        "//third_party:google_test",
        "//third_party:google_test_main",
    ],
)
