load("//libamdf/build_tools/bazel:cc.bzl", "amdf_cc_library")
load("//libamdf/build_tools/bazel:cc_test.bzl", "amdf_cc_test")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

DRM_COMPATIBILITY = [
    "@platforms//os:linux",
    "@platforms//cpu:x86_64",
]

amdf_cc_library(
    name = "drm",
    srcs = ["device.c"],
    target_compatible_with = DRM_COMPATIBILITY,
    visibility = ["//libamdf/src/provider:__pkg__"],
    deps = [
        ":device_state",
        ":execution",
        "//libamdf/src:allocator",
        "//libamdf/src:endpoint",
        "//libamdf/src:instance",
        "//libamdf/src:structure",
        "//libamdf/src/media:av1",
        "//libamdf/src/media:h264",
        "//libamdf/src/media:hevc",
        "//libamdf/src/platform/linux:endpoint",
        "//libamdf/src/platform/linux:file",
    ],
)

amdf_cc_library(
    name = "execution",
    srcs = [
        "av1_context.c",
        "av1_grain.c",
        "command.c",
        "jpeg.c",
        "queue.c",
        "session.c",
        "vcn.c",
        "vcn_encode.c",
        "vp9_context.c",
    ],
    hdrs = [
        "av1_context.h",
        "av1_grain.h",
        "command.h",
        "jpeg.h",
        "queue.h",
        "session.h",
        "vcn.h",
        "vcn_encode.h",
        "vp9_context.h",
    ],
    target_compatible_with = DRM_COMPATIBILITY,
    deps = [
        ":buffer",
        ":device_state",
        ":image",
        "//libamdf/src:allocator",
        "//libamdf/src:atomics",
        "//libamdf/src:structure",
        "//libamdf/src:wait",
        "//libamdf/src/media:av1",
        "//libamdf/src/media:h264",
        "//libamdf/src/media:hevc",
        "//libamdf/src/media:vp9",
        "//libamdf/src/platform:native_event",
        "//libamdf/src/platform:wait",
        "//libamdf/src/platform/linux:file",
        "//libamdf/src/platform/linux:native_event",
    ],
)

amdf_cc_library(
    name = "device_state",
    hdrs = ["device.h"],
    target_compatible_with = DRM_COMPATIBILITY,
    deps = [
        "//libamdf/src/media:provider",
        "//third_party:linux_amdgpu_uapi",
    ],
)

amdf_cc_library(
    name = "buffer",
    srcs = ["buffer.c"],
    hdrs = ["buffer.h"],
    target_compatible_with = DRM_COMPATIBILITY,
    deps = [
        ":device_state",
        "//libamdf/src:allocator",
        "//libamdf/src/platform/linux:file",
    ],
)

amdf_cc_library(
    name = "image",
    srcs = ["image.c"],
    hdrs = ["image.h"],
    target_compatible_with = DRM_COMPATIBILITY,
    deps = [
        ":memory",
        "//libamdf/src:allocator",
        "//libamdf/src:structure",
    ],
)

amdf_cc_library(
    name = "memory",
    srcs = ["memory.c"],
    hdrs = ["memory.h"],
    target_compatible_with = DRM_COMPATIBILITY,
    deps = [
        ":buffer",
        "//libamdf/src:allocator",
        "//libamdf/src:host_mapping",
        "//libamdf/src:memory_resource",
        "//libamdf/src/platform/linux:dma_buf",
        "//libamdf/src/platform/linux:file",
    ],
)

amdf_cc_test(
    name = "buffer_test",
    srcs = ["buffer_test.cc"],
    linkopts = ["-Wl,--wrap=ioctl"],
    target_compatible_with = DRM_COMPATIBILITY,
    deps = [
        ":buffer",
        "//libamdf/src:allocator",
        "//libamdf/src/platform/linux:file",
        "//third_party:google_test",
        "//third_party:google_test_main",
        "//third_party:linux_amdgpu_uapi",
        "//third_party:linux_drm_uapi",
    ],
)

amdf_cc_test(
    name = "queue_test",
    srcs = ["queue_test.cc"],
    linkopts = [
        "-Wl,--wrap=ioctl",
        "-Wl,--wrap=close",
    ],
    target_compatible_with = DRM_COMPATIBILITY,
    deps = [
        ":execution",
        ":image",
        "//libamdf/src:allocator",
        "//libamdf/src:kernel_queue",
        "//libamdf/src/platform/linux:endpoint",
        "//libamdf/src/platform/linux:file",
        "//third_party:google_test",
        "//third_party:google_test_main",
        "//third_party:linux_amdgpu_uapi",
        "//third_party:linux_drm_uapi",
    ],
)

amdf_cc_test(
    name = "av1_context_test",
    srcs = ["av1_context_test.cc"],
    target_compatible_with = DRM_COMPATIBILITY,
    deps = [
        ":execution",
        "//third_party:google_test",
        "//third_party:google_test_main",
    ],
)

amdf_cc_test(
    name = "vcn_encode_test",
    srcs = ["vcn_encode_test.cc"],
    target_compatible_with = DRM_COMPATIBILITY,
    deps = [
        ":execution",
        "//third_party:google_test",
        "//third_party:google_test_main",
    ],
)
