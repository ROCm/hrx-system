load("//libamdf/build_tools/bazel:cc.bzl", "amdf_cc_library")
load("//libamdf/build_tools/bazel:cc_test.bzl", "amdf_cc_test")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

amdf_cc_library(
    name = "provider",
    hdrs = ["provider.h"],
    visibility = ["//libamdf/src/media:__subpackages__"],
    deps = [
        "//libamdf/src:device",
        "//libamdf/src:kernel_queue",
    ],
)

amdf_cc_library(
    name = "encode",
    srcs = ["encode.c"],
    hdrs = ["encode.h"],
    visibility = ["//libamdf/src/media:__subpackages__"],
    deps = ["//libamdf/src:structure"],
)

amdf_cc_library(
    name = "h264",
    srcs = ["h264.c"],
    hdrs = ["h264.h"],
    visibility = ["//libamdf/src/media:__subpackages__"],
    deps = [
        ":encode",
        "//libamdf/src:structure",
    ],
)

amdf_cc_library(
    name = "hevc",
    srcs = ["hevc.c"],
    hdrs = ["hevc.h"],
    visibility = ["//libamdf/src/media:__subpackages__"],
    deps = [
        ":encode",
        "//libamdf/src:structure",
    ],
)

amdf_cc_library(
    name = "vp9",
    srcs = ["vp9.c"],
    hdrs = ["vp9.h"],
    visibility = ["//libamdf/src/media:__subpackages__"],
)

amdf_cc_library(
    name = "extension",
    srcs = ["extension.c"],
    hdrs = ["extension.h"],
    visibility = ["//libamdf/src/provider:__pkg__"],
    deps = [
        ":provider",
        "//libamdf/src:device",
        "//libamdf/src:kernel_queue",
        "//libamdf/src:structure",
    ],
)

amdf_cc_library(
    name = "av1",
    srcs = ["av1.c"],
    hdrs = ["av1.h"],
    visibility = ["//libamdf/src/media:__subpackages__"],
    deps = [
        ":encode",
        "//libamdf/src:structure",
    ],
)

amdf_cc_test(
    name = "encode_test",
    srcs = ["encode_test.cc"],
    deps = [
        ":av1",
        ":encode",
        ":h264",
        ":hevc",
        "//third_party:google_test",
        "//third_party:google_test_main",
    ],
)
