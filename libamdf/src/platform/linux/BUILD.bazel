load("//libamdf/build_tools/bazel:cc.bzl", "amdf_cc_library")
load("//libamdf/build_tools/bazel:cc_test.bzl", "amdf_cc_test")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

amdf_cc_library(
    name = "host_cache",
    srcs = ["host_cache_x86_64.c"],
    hdrs = ["host_cache.h"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    visibility = ["//libamdf/src:__subpackages__"],
)

amdf_cc_library(
    name = "host_memory",
    srcs = ["host_memory.c"],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//libamdf/src/platform:__pkg__"],
    deps = [
        ":file",
        ":host_cache",
        "//libamdf/src/platform:host_memory",
    ],
)

amdf_cc_library(
    name = "file",
    hdrs = ["file.h"],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//libamdf/src:__subpackages__"],
)

amdf_cc_library(
    name = "dma_buf",
    srcs = ["dma_buf.c"],
    hdrs = ["dma_buf.h"],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//libamdf/src:__subpackages__"],
    deps = [":file"],
)

amdf_cc_library(
    name = "wait",
    srcs = ["wait.c"],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//libamdf/src/platform:__pkg__"],
    deps = [
        ":file",
        "//libamdf/src/platform:wait",
    ],
)

amdf_cc_library(
    name = "instance",
    srcs = ["instance.c"],
    hdrs = ["instance.h"],
    linkopts = ["-pthread"],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//libamdf/src/platform:__pkg__"],
    deps = [
        ":file",
        "//libamdf/src:allocator",
        "//libamdf/src/platform",
    ],
)

amdf_cc_library(
    name = "endpoint",
    srcs = ["endpoint.c"],
    hdrs = ["endpoint.h"],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//libamdf/src:__subpackages__"],
    deps = [
        ":file",
        ":instance",
        "//libamdf/src:allocator",
        "//libamdf/src:pci",
        "//libamdf/src/platform",
        "//third_party:linux_drm_uapi",
    ],
)

amdf_cc_library(
    name = "linux",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//libamdf/src:__pkg__"],
    deps = [
        ":endpoint",
        ":instance",
    ],
)

amdf_cc_test(
    name = "dma_buf_test",
    srcs = ["dma_buf_test.cc"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":dma_buf",
        "//third_party:google_test",
        "//third_party:google_test_main",
    ],
)

amdf_cc_test(
    name = "endpoint_test",
    srcs = ["endpoint_test.cc"],
    resource_group = "iree-hal-drivers-amdgpu-tests",
    tags = [
        "iree-run-requirement=libamdf.resource.amd_gpu",
        "iree-run-requirement=libamdf.resource.xdna",
        "runtime-resource=amd-gpu",
        "runtime-resource=amd-xdna",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":endpoint",
        ":file",
        "//libamdf/src:allocator",
        "//libamdf/src/platform",
        "//third_party:google_test",
        "//third_party:google_test_main",
        "//third_party:linux_drm_uapi",
    ],
)

amdf_cc_test(
    name = "endpoint_metadata_test",
    srcs = ["endpoint_metadata_test.cc"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":endpoint",
        ":file",
        "//libamdf/src:allocator",
        "//libamdf/src/platform",
        "//third_party:google_test",
        "//third_party:google_test_main",
    ],
)
