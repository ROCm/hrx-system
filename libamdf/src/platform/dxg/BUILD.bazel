load("//libamdf/build_tools/bazel:cc.bzl", "amdf_cc_library")
load("//libamdf/build_tools/bazel:cc_test.bzl", "amdf_cc_test")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

amdf_cc_library(
    name = "endpoint_identity",
    srcs = ["endpoint_identity.c"],
    hdrs = ["endpoint_identity.h"],
    visibility = ["//libamdf/src:__subpackages__"],
)

amdf_cc_test(
    name = "endpoint_identity_test",
    srcs = ["endpoint_identity_test.cc"],
    deps = [
        ":endpoint_identity",
        "//third_party:google_test",
        "//third_party:google_test_main",
    ],
)
