load("//libamdf/build_tools/bazel:cc.bzl", "amdf_cc_library")
load("//libamdf/build_tools/bazel:cc_test.bzl", "amdf_cc_test")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

WINDOWS_COMPATIBILITY = ["@platforms//os:windows"]

amdf_cc_library(
    name = "wait",
    srcs = ["wait.c"],
    linkopts = ["mincore.lib"],
    target_compatible_with = WINDOWS_COMPATIBILITY,
    visibility = ["//libamdf/src/platform:__pkg__"],
    deps = ["//libamdf/src/platform:wait"],
)

amdf_cc_library(
    name = "host_cache",
    srcs = ["host_cache_x86_64.c"],
    hdrs = ["host_cache.h"],
    target_compatible_with = WINDOWS_COMPATIBILITY,
    visibility = ["//libamdf/src:__subpackages__"],
)

amdf_cc_library(
    name = "host_memory",
    srcs = ["host_memory.c"],
    target_compatible_with = WINDOWS_COMPATIBILITY,
    visibility = ["//libamdf/src/platform:__pkg__"],
    deps = [
        ":host_cache",
        "//libamdf/src/platform:host_memory",
    ],
)

amdf_cc_library(
    name = "kmt_api",
    srcs = ["kmt_api.c"],
    hdrs = ["kmt_api.h"],
    target_compatible_with = WINDOWS_COMPATIBILITY,
    visibility = ["//libamdf/src:__subpackages__"],
)

amdf_cc_library(
    name = "device_status",
    srcs = ["device_status.c"],
    hdrs = ["device_status.h"],
    target_compatible_with = WINDOWS_COMPATIBILITY,
    visibility = ["//libamdf/src:__subpackages__"],
    deps = [
        ":kmt_api",
        "//libamdf/src:atomics",
    ],
)

amdf_cc_library(
    name = "endpoint_properties",
    srcs = ["endpoint_properties.c"],
    hdrs = ["endpoint_properties.h"],
    target_compatible_with = WINDOWS_COMPATIBILITY,
    deps = [
        ":kmt_api",
        "//libamdf/src:pci",
    ],
)

amdf_cc_library(
    name = "endpoint_snapshot",
    srcs = ["endpoint_snapshot.c"],
    hdrs = ["endpoint_snapshot.h"],
    target_compatible_with = WINDOWS_COMPATIBILITY,
    deps = [
        ":endpoint_properties",
        ":kmt_api",
        "//libamdf/src:allocator",
        "//libamdf/src:pci",
    ],
)

amdf_cc_library(
    name = "instance",
    srcs = ["instance.c"],
    hdrs = ["instance.h"],
    target_compatible_with = WINDOWS_COMPATIBILITY,
    visibility = ["//libamdf/src/platform:__pkg__"],
    deps = [
        ":endpoint_snapshot",
        ":kmt_api",
        "//libamdf/src:allocator",
        "//libamdf/src/platform",
    ],
)

amdf_cc_library(
    name = "endpoint",
    srcs = ["endpoint.c"],
    hdrs = ["endpoint.h"],
    target_compatible_with = WINDOWS_COMPATIBILITY,
    visibility = ["//libamdf/src:__subpackages__"],
    deps = [
        ":endpoint_properties",
        ":instance",
        "//libamdf/src:allocator",
        "//libamdf/src/platform",
    ],
)

amdf_cc_library(
    name = "windows",
    target_compatible_with = WINDOWS_COMPATIBILITY,
    visibility = ["//libamdf/src:__pkg__"],
    deps = [
        ":endpoint",
        ":instance",
    ],
)

amdf_cc_test(
    name = "device_status_test",
    srcs = ["device_status_test.cc"],
    target_compatible_with = WINDOWS_COMPATIBILITY,
    deps = [
        ":device_status",
        "//third_party:google_test",
        "//third_party:google_test_main",
    ],
)

amdf_cc_test(
    name = "endpoint_snapshot_test",
    srcs = ["endpoint_snapshot_test.cc"],
    target_compatible_with = WINDOWS_COMPATIBILITY,
    deps = [
        ":endpoint",
        ":endpoint_snapshot",
        ":instance",
        "//libamdf/src:allocator",
        "//libamdf/src/platform",
        "//third_party:google_test",
        "//third_party:google_test_main",
    ],
)
