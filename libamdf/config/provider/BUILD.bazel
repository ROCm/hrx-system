# Provider settings have no CMake target surface. Their portable conditions
# are mapped by libamdf's Bazel-to-CMake project configuration.
# bazel-to-cmake: skip

load("@bazel_skylib//lib:selects.bzl", "selects")

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "windows",
    constraint_values = ["@platforms//os:windows"],
)

selects.config_setting_group(
    name = "wddm",
    match_all = [
        ":windows",
        "//libamdf/config/family:gpu",
    ],
)

config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

selects.config_setting_group(
    name = "dxg",
    match_any = [
        ":linux_x86_64",
        ":wddm",
    ],
)

selects.config_setting_group(
    name = "linux_xdna",
    match_all = [
        ":linux_x86_64",
        "//libamdf/config/family:xdna",
    ],
)

selects.config_setting_group(
    name = "windows_xdna",
    match_all = [
        ":windows",
        "//libamdf/config/family:xdna",
    ],
)

selects.config_setting_group(
    name = "xdna",
    match_any = [
        ":linux_xdna",
        ":windows_xdna",
    ],
)

selects.config_setting_group(
    name = "gpu_platform",
    match_any = [
        ":windows",
        ":linux_x86_64",
    ],
)

selects.config_setting_group(
    name = "gpu",
    match_all = [
        ":gpu_platform",
        "//libamdf/config/family:gpu",
    ],
)

selects.config_setting_group(
    name = "rocjitsu",
    match_all = [
        ":linux_x86_64",
        "//libamdf/config/family:gpu",
        "//libamdf/config:rocjitsu_enabled",
    ],
)
