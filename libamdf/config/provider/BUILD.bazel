# Provider settings have no CMake target surface. Their portable conditions
# are mapped by libamdf's Bazel-to-CMake project configuration.
# bazel-to-cmake: skip

load("@bazel_skylib//lib:selects.bzl", "selects")
load("@bazel_skylib//rules:common_settings.bzl", "string_flag")

package(default_visibility = ["//visibility:public"])

string_flag(
    name = "linux_gpu",
    build_setting_default = "kfd",
    values = [
        "dxg",
        "kfd",
    ],
)

config_setting(
    name = "linux_gpu_dxg",
    flag_values = {":linux_gpu": "dxg"},
)

config_setting(
    name = "linux_gpu_kfd",
    flag_values = {":linux_gpu": "kfd"},
)

config_setting(
    name = "windows",
    constraint_values = ["@platforms//os:windows"],
)

selects.config_setting_group(
    name = "wddm",
    match_all = [
        ":windows",
        "//libamdf/config/family:gpu",
    ],
)

config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

selects.config_setting_group(
    name = "linux_dxg",
    match_all = [
        ":linux_gpu_dxg",
        ":linux_x86_64",
    ],
)

selects.config_setting_group(
    name = "linux_kfd",
    match_all = [
        ":linux_gpu_kfd",
        ":linux_x86_64",
    ],
)

selects.config_setting_group(
    name = "dxg",
    match_any = [
        ":linux_dxg",
        ":wddm",
    ],
)

selects.config_setting_group(
    name = "linux_xdna",
    match_all = [
        ":linux_kfd",
        "//libamdf/config/family:xdna",
    ],
)

selects.config_setting_group(
    name = "windows_xdna",
    match_all = [
        ":windows",
        "//libamdf/config/family:xdna",
    ],
)

selects.config_setting_group(
    name = "xdna",
    match_any = [
        ":linux_xdna",
        ":windows_xdna",
    ],
)

selects.config_setting_group(
    name = "gpu_platform",
    match_any = [
        ":windows",
        ":linux_x86_64",
    ],
)

selects.config_setting_group(
    name = "gpu",
    match_all = [
        ":gpu_platform",
        "//libamdf/config/family:gpu",
    ],
)
