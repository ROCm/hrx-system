load("//build_tools/bazel:select.bzl", "iree_select")
load("//libamdf/build_tools/bazel:cc.bzl", "amdf_cc_library")
load("//libamdf/build_tools/bazel:cc_test.bzl", "amdf_cc_test")
load("//libamdf/build_tools/bazel:cts.bzl", "amdf_cts_test_suite")

package(
    default_visibility = [
        "//libamdf/benchmarks:__subpackages__",
        "//libamdf/cts:__subpackages__",
    ],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

amdf_cc_library(
    name = "provider_headers",
    testonly = True,
    hdrs = ["provider.h"],
    includes = [".."],
)

amdf_cc_library(
    name = "device_cache",
    testonly = True,
    srcs = ["device_cache.cc"],
    hdrs = ["device_cache.h"],
    deps = [
        ":native_identity",
        ":provider_headers",
    ],
)

amdf_cc_library(
    name = "native_identity",
    testonly = True,
    srcs = ["native_identity.cc"],
    hdrs = ["native_identity.h"],
    visibility = [
        "//libamdf/cts:__subpackages__",
        "//runtime/src/iree/hal/driver/amd/gpu/cts:__pkg__",
    ],
)

amdf_cc_test(
    name = "native_identity_test",
    srcs = ["native_identity_test.cc"],
    deps = [
        ":native_identity",
        "//third_party:google_test",
        "//third_party:google_test_main",
    ],
)

amdf_cc_library(
    name = "mapped_memory",
    testonly = True,
    srcs = ["mapped_memory.cc"],
    hdrs = ["mapped_memory.h"],
    includes = [".."],
    deps = ["//third_party:google_test"],
)

amdf_cc_library(
    name = "observation",
    testonly = True,
    hdrs = ["observation.h"],
    includes = [".."],
    deps = ["//third_party:google_test"],
)

amdf_cc_library(
    name = "wait",
    testonly = True,
    hdrs = ["wait.h"],
    includes = [".."],
    deps = ["//third_party:google_test"],
)

amdf_cts_test_suite(
    name = "wait_test",
    srcs = ["wait_test.cc"],
    deps = [
        ":native_event",
        ":native_event_headers",
        ":wait",
        "//third_party:google_test",
    ],
)

amdf_cc_library(
    name = "native_event_headers",
    testonly = True,
    hdrs = ["native_event.h"],
    includes = [".."],
    deps = [
        ":wait",
        "//third_party:google_test",
    ],
)

amdf_cc_library(
    name = "native_event",
    testonly = True,
    deps = iree_select({
        "@platforms//os:windows": ["//libamdf/cts/util/windows:native_event"],
        "//conditions:default": ["//libamdf/cts/util/linux:native_event"],
    }),
)

amdf_cc_library(
    name = "test_main",
    testonly = True,
    srcs = ["test_main.cc"],
    deps = [
        ":device_cache",
        ":native_identity",
        ":provider_headers",
        "//third_party:google_test",
    ],
)

amdf_cc_library(
    name = "static_provider",
    testonly = True,
    srcs = ["linked_provider.cc"],
    deps = [
        ":provider_headers",
        "//libamdf:amdf_static",
    ],
)

amdf_cc_library(
    name = "shared_provider",
    testonly = True,
    srcs = ["linked_provider.cc"],
    deps = [
        ":provider_headers",
        "//libamdf:amdf",
    ],
)

amdf_cc_library(
    name = "linked_test_main",
    testonly = True,
    deps = [
        ":static_provider",
        ":test_main",
    ],
)

amdf_cc_library(
    name = "dynamic_provider_posix",
    testonly = True,
    srcs = ["dynamic_provider_posix.cc"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":provider_headers",
        "//build_tools/bazel:dl",
    ],
)

amdf_cc_library(
    name = "dynamic_provider_win32",
    testonly = True,
    srcs = ["dynamic_provider_win32.cc"],
    target_compatible_with = ["@platforms//os:windows"],
    deps = [":provider_headers"],
)

amdf_cc_library(
    name = "dynamic_provider",
    testonly = True,
    deps = iree_select({
        "@platforms//os:windows": [":dynamic_provider_win32"],
        "//conditions:default": [":dynamic_provider_posix"],
    }),
)
