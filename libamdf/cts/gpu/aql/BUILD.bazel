load("//libamdf/build_tools/bazel:cc.bzl", "amdf_cc_library")
load("//libamdf/build_tools/bazel:cts.bzl", "amdf_cts_test_suite")

package(
    default_visibility = ["//libamdf/cts:__subpackages__"],
    features = ["layering_check"],
    licenses = ["notice"],
)

amdf_cc_library(
    name = "publication",
    testonly = True,
    hdrs = ["publication.h"],
    deps = [
        "//libamdf/cts/gpu/aql/encoding:packets",
        "//libamdf/cts/gpu/util:user_queue",
    ],
)

amdf_cc_library(
    name = "executable",
    testonly = True,
    srcs = ["executable.cc"],
    hdrs = ["executable.h"],
    deps = [
        ":publication",
        "//libamdf/cts/gpu:gpu_device_fixture",
        "//libamdf/cts/gpu/kernels:kernel",
        "//libamdf/cts/gpu/util:memory",
        "//libamdf/cts/gpu/util:user_queue",
    ],
)

amdf_cc_library(
    name = "queue_fixture",
    testonly = True,
    hdrs = ["queue_fixture.h"],
    deps = [
        ":publication",
        "//libamdf/cts/gpu/util:command_fixture",
    ],
)

amdf_cts_test_suite(
    name = "aql",
    srcs = [
        "barrier_test.cc",
        "byte_copy_test.cc",
        "dispatch_test.cc",
        "epoch_test.cc",
        "executable_test.cc",
        "fanin_test.cc",
        "geometry_test.cc",
        "lds_test.cc",
        "pattern_fill_test.cc",
        "private_test.cc",
        "publication_test.cc",
        "resource_test.cc",
        "scope_test.cc",
        "timestamp_test.cc",
        "transfer_test.cc",
        "workset_test.cc",
    ],
    target_compatible_with = ["@platforms//cpu:x86_64"] + select({
        "@platforms//os:linux": [],
        "@platforms//os:windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":dispatch_fixture",
        ":queue_fixture",
        "//libamdf/cts/gpu/kernels:byte_copy_unaligned",
        "//libamdf/cts/gpu/kernels:byte_copy_unaligned_kernels",
        "//libamdf/cts/gpu/kernels:geometry_ids",
        "//libamdf/cts/gpu/kernels:geometry_ids_kernels",
        "//libamdf/cts/gpu/kernels:lds_exchange",
        "//libamdf/cts/gpu/kernels:lds_exchange_kernels",
        "//libamdf/cts/gpu/kernels:pattern_fill_unaligned",
        "//libamdf/cts/gpu/kernels:pattern_fill_unaligned_kernels",
        "//libamdf/cts/gpu/kernels:private_roundtrip",
        "//libamdf/cts/gpu/kernels:private_roundtrip_kernels",
        "//libamdf/cts/gpu/kernels:transform",
        "//libamdf/cts/gpu/kernels:transform_alternate_kernels",
        "//libamdf/cts/gpu/kernels:transform_kernels",
        "//libamdf/cts/gpu/pm4/encoding:memory_commands",
        "//third_party:google_test",
    ],
)

amdf_cc_library(
    name = "dispatch_fixture",
    testonly = True,
    srcs = ["dispatch_fixture.cc"],
    hdrs = ["dispatch_fixture.h"],
    target_compatible_with = ["@platforms//cpu:x86_64"] + select({
        "@platforms//os:linux": [],
        "@platforms//os:windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":executable",
        ":queue_fixture",
        "//libamdf/cts/gpu/kernels:kernel",
        "//libamdf/cts/gpu/pm4/encoding:profile",
    ],
)
