load("//libamdf/build_tools/bazel:cc.bzl", "amdf_cc_library")
load("//libamdf/build_tools/bazel:cts.bzl", "amdf_cts_test_suite")

package(
    default_visibility = ["//libamdf/cts:__subpackages__"],
    features = ["layering_check"],
    licenses = ["notice"],
)

_AQL_TEST_COMPATIBILITY = ["@platforms//cpu:x86_64"] + select({
    "@platforms//os:linux": [],
    "@platforms//os:windows": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

amdf_cc_library(
    name = "publication",
    testonly = True,
    hdrs = ["publication.h"],
    deps = [
        "//libamdf/cts/gpu/aql/encoding:packets",
        "//libamdf/cts/gpu/util:user_queue",
        "//third_party:google_test",
    ],
)

amdf_cc_library(
    name = "executable",
    testonly = True,
    srcs = ["executable.cc"],
    hdrs = ["executable.h"],
    deps = [
        ":publication",
        "//libamdf/cts/gpu:gpu_device_fixture",
        "//libamdf/cts/gpu/kernels:kernel",
        "//libamdf/cts/gpu/util:memory",
        "//libamdf/cts/gpu/util:user_queue",
    ],
)

amdf_cc_library(
    name = "queue_fixture",
    testonly = True,
    hdrs = ["queue_fixture.h"],
    deps = [
        ":publication",
        "//libamdf/cts/gpu/util:command_fixture",
    ],
)

amdf_cc_library(
