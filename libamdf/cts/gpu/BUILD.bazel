load("//libamdf/build_tools/bazel:cc.bzl", "amdf_cc_library")
load("//libamdf/build_tools/bazel:cts.bzl", "amdf_cts_test_suite")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

amdf_cc_library(
    name = "gpu_device_fixture",
    testonly = True,
    hdrs = ["gpu_device_fixture.h"],
    visibility = [
        "//libamdf/cts/gpu:__subpackages__",
        "//libamdf/cts/interop/gpu:__subpackages__",
    ],
    deps = [
        "//libamdf/cts/util:device_cache",
        "//libamdf/cts/util:provider_headers",
        "//third_party:google_test",
    ],
)

amdf_cts_test_suite(
    name = "gpu_extension",
    srcs = [
        "gpu_extension_test.cc",
        "user_queue_test.cc",
    ],
    target_compatible_with = ["@platforms//cpu:x86_64"] + select({
        "@platforms//os:linux": [],
        "@platforms//os:windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":gpu_device_fixture",
        "//libamdf/cts/gpu/pm4/encoding:commands",
        "//libamdf/cts/gpu/sdma/encoding:commands",
        "//libamdf/cts/gpu/util:command_fixture",
        "//libamdf/cts/util:device_cache",
        "//libamdf/cts/util:provider_headers",
        "//third_party:google_test",
    ],
)

[amdf_cts_test_suite(
    name = name,
    srcs = [name + "_test.cc"],
    target_compatible_with = ["@platforms//cpu:x86_64"] + select({
        "@platforms//os:linux": [],
        "@platforms//os:windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":gpu_device_fixture",
        "//libamdf/cts/util:device_cache",
        "//libamdf/cts/util:provider_headers",
        "//third_party:google_test",
    ],
) for name in [
    "kernel_queue",
    "memory_interop",
]]

test_suite(
    name = "gpu",
    tests = [
        ":gpu_extension",
        ":kernel_queue",
        ":memory_interop",
        "//libamdf/cts/gpu/aql",
        "//libamdf/cts/gpu/aql/encoding:packets_test",
        "//libamdf/cts/gpu/linux:memory",
        "//libamdf/cts/gpu/linux/io_uring:file_io",
        "//libamdf/cts/gpu/peer",
        "//libamdf/cts/gpu/peer/aql",
        "//libamdf/cts/gpu/pm4",
        "//libamdf/cts/gpu/pm4/encoding:commands_test",
        "//libamdf/cts/gpu/recipes",
        "//libamdf/cts/gpu/sdma",
        "//libamdf/cts/gpu/sdma/encoding:commands_test",
        "//libamdf/cts/gpu/windows:memory",
    ],
    visibility = ["//visibility:public"],
)
