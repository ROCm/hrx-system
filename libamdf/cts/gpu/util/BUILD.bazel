load("//libamdf/build_tools/bazel:cc.bzl", "amdf_cc_library")

package(
    default_visibility = ["//libamdf/cts:__subpackages__"],
    features = ["layering_check"],
    licenses = ["notice"],
)

# The native witnesses and public CTS consume the same application layout and
# byte oracle. This fixture has no provider access or implementation dependency.
amdf_cc_library(
    name = "sparse_mapping_layout",
    testonly = True,
    hdrs = ["sparse_mapping_layout.h"],
    visibility = [
        "//libamdf/cts:__subpackages__",
        "//libamdf/src/gpu/umd:__pkg__",
    ],
    deps = ["//third_party:google_test"],
)

amdf_cc_library(
    name = "memory",
    testonly = True,
    srcs = ["memory.cc"],
    hdrs = ["memory.h"],
    deps = ["//third_party:google_test"],
)

amdf_cc_library(
    name = "user_queue",
    testonly = True,
    srcs = ["user_queue.cc"],
    hdrs = ["user_queue.h"],
    target_compatible_with = ["@platforms//cpu:x86_64"],
    deps = [
        "//libamdf/cts/util:wait",
        "//third_party:google_test",
    ],
)

amdf_cc_library(
    name = "command_queue",
    testonly = True,
    srcs = ["command_queue.cc"],
    hdrs = ["command_queue.h"],
    deps = [
        ":user_queue",
        "//libamdf/cts/gpu:gpu_device_fixture",
        "//libamdf/cts/util:mapped_memory",
        "//third_party:google_test",
    ],
)

amdf_cc_library(
    name = "command_fixture",
    testonly = True,
    srcs = ["command_fixture.cc"],
    hdrs = ["command_fixture.h"],
    deps = [
        ":command_queue",
        ":memory",
        ":user_queue",
        "//libamdf/cts/gpu:gpu_device_fixture",
    ],
)

amdf_cc_library(
    name = "shader_event_fixture",
    testonly = True,
    hdrs = ["shader_event_fixture.h"],
    target_compatible_with = ["@platforms//cpu:x86_64"],
    deps = [
        ":user_queue",
        "//libamdf/cts/util:wait",
        "//third_party:google_test",
    ],
)

amdf_cc_library(
    name = "program_atomic_fixture",
    testonly = True,
    hdrs = ["program_atomic_fixture.h"],
    target_compatible_with = ["@platforms//cpu:x86_64"],
    deps = [
        ":memory",
        ":user_queue",
        "//libamdf/cts/gpu/kernels:program_atomic",
        "//libamdf/cts/gpu/kernels:program_atomic_kernels",
        "//libamdf/cts/util:wait",
        "//third_party:google_test",
    ],
)
