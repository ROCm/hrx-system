# Every exact physical selector, including encoding overlays, shares the same
# authored kernels. Generic code-object processors are not physical endpoints.
_KERNEL_TARGETS = sorted([
    target
    for target in LOOM_AMDGPU_SUPPORTED_TARGETS
    if not target.endswith("-generic")
])

# Resident exchange programs are submitted through the RDNA PM4 path.
_RDNA_KERNEL_TARGETS = [target for target in _KERNEL_TARGETS if not target.startswith("gfx9")]

_CXX_COMPATIBILITY = loom_config_compatible_with(["//loom/config/import:cxx"])

_KERNEL_TARGETS_BY_CAPABILITY = {
    capability: [
        target
        for target in _KERNEL_TARGETS
        if LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITY_BY_TARGET[target] == capability
    ]
    for capability in LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITIES
}

# The completed-tick module deliberately carries every target specialization in
# one source. Compilers with a restricted representation vocabulary omit the
# dependent CTS products instead of selecting source fragments in the build.
_COMPLETED_TICK_CONFIGS = [
    "//loom/config/target/amdgpu:descriptor_set_gfx11_generic_core",
    "//loom/config/target/amdgpu:descriptor_set_gfx12_generic_core",
    "//loom/config/target/amdgpu:descriptor_set_gfx12_5_generic_core",
    "//loom/config/target/amdgpu:descriptor_set_rdna4m_core",
]

_COMPLETED_TICK_COMPATIBILITY = loom_config_compatible_with(_COMPLETED_TICK_CONFIGS)

_CXX_COMPLETED_TICK_COMPATIBILITY = loom_config_compatible_with(
    ["//loom/config/import:cxx"] + _COMPLETED_TICK_CONFIGS,
)

[
    loom_target_profile(
        name = target,
        family = "amdgpu",
        selector = target,
        target_compatible_with = select({
            "//loom/config/target/amdgpu:" + LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITY_BY_TARGET[target]: [],
            "//conditions:default": ["@platforms//:incompatible"],
        }),
        visibility = ["//visibility:private"],
    )
    for target in _KERNEL_TARGETS
]

