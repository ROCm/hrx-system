_EMBED_TEST_COMPATIBILITY = {
    "//loom/config/target/amdgpu:" + capability: []
    for capability, targets in _KERNEL_TARGETS_BY_CAPABILITY.items()
    if targets
}

_EMBED_TEST_COMPATIBILITY["//conditions:default"] = ["@platforms//:incompatible"]

py_test(
    name = "embed_test",
    size = "small",
    srcs = [
        "embed.py",
        "embed_test.py",
    ],
    args = loom_amdgpu_selected_descriptor_set_values({
        capability: (
            [
                "--variant=%s=$(rootpath :transform_kernels_%s)" % (target, target)
                for target in targets
            ] + [
                "--immutable-variant=%s=$(rootpath :immutable_data_kernels_%s)" % (target, target)
                for target in targets
            ] + [
                "--immutable-alternate-variant=%s=$(rootpath :immutable_data_alternate_kernels_%s)" % (target, target)
                for target in targets
            ]
        )
        for capability, targets in _KERNEL_TARGETS_BY_CAPABILITY.items()
    }),
    data = loom_amdgpu_selected_descriptor_set_values({
        capability: (
            [":transform_kernels_" + target for target in targets] +
            [":immutable_data_kernels_" + target for target in targets] +
            [":immutable_data_alternate_kernels_" + target for target in targets]
        )
        for capability, targets in _KERNEL_TARGETS_BY_CAPABILITY.items()
    }),
    main = "embed_test.py",
    tags = _KERNEL_POLICY["tags"],
    target_compatible_with = _KERNEL_POLICY["target_compatible_with"] + select(_EMBED_TEST_COMPATIBILITY),
)

