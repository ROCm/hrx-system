// One resident invocation publishes native reads and interrupts the host when
// no kernel I/O is pending. Only returned file bytes choose the next request.
// The host services io_uring but never reads payloads or supplies successors.
template.decl @shader_event_interrupt(%context: i32)

kernel.def export("file_notification") @file_notification() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%submission_entries: buffer, %submission_tail: buffer, %completion_entries: buffer, %completion_head: buffer, %completion_tail: buffer, %payload: buffer, %control: buffer, %host_payload: i64, %mailbox: buffer, %trigger: i64, %submission_mask: i32, %completion_mask: i32, %word_count: i32, %file_block_mask: i32, %round_count: i32, %interrupt_context: i32) {
  %origin = index.constant 0 : offset
  %first = index.constant 0 : index
  %step = index.constant 1 : index
  %sqe_bytes = index.constant 64 : offset
  %record_bytes = index.constant 16 : offset
  %header_bytes = index.constant 32 : offset
  %zero = scalar.constant 0 : i32
  %one = scalar.constant 1 : i32
  %four = scalar.constant 4 : i32
  %seed = scalar.constant 3 : i32
  %read_fixed_file = scalar.constant 260 : i32
  %true = scalar.constant true : i1
  %false = scalar.constant false : i1
  %terminal_mask = scalar.constant -9223372036854775808 : i64
  %submission = buffer.view %submission_tail[%origin] : buffer -> view<1xi32>
  %completion = buffer.view %completion_tail[%origin] : buffer -> view<1xi32>
  %consumption = buffer.view %completion_head[%origin] : buffer -> view<1xi32>
  %header = buffer.view %control[%origin] : buffer -> view<8xi32>
  %generation = buffer.view %control[%origin] : buffer -> view<4xi64>
  %event = buffer.view %mailbox[%origin] : buffer -> view<1xi64>
  %count_input = index.cast %word_count : i32 to index
  %count = index.assume %count_input [range(%count_input, 1, 16384)] : index
  %words = buffer.view %payload[%origin] : buffer -> view<[%count]xi32>
  %length = scalar.muli %word_count, %four : i32
  %length_wide = scalar.extui %length : i32 to i64

  %finished, %requests, %final_cause, %final_result, %active = scf.while(%round = %zero : i32, %ticket = %zero : i32, %cause = %seed : i32, %last_result = %zero : i32, %running = %true : i1) -> (i32, i32, i32, i32, i1) {
    %remaining = scalar.cmpi ult, %round, %round_count : i32
    %continue = scalar.andi %remaining, %running : i1
    scf.condition %continue, %round, %ticket, %cause, %last_result, %running : i1, i32, i32, i32, i32, i1
  } do(%round: i32, %ticket: i32, %cause: i32, %last_result: i32, %running: i1) {
    %block = scalar.andi %cause, %file_block_mask : i32
    %block_wide = scalar.extui %block : i32 to i64
    %file_offset = scalar.muli %block_wide, %length_wide : i64
    %sq_position = scalar.andi %ticket, %submission_mask : i32
    %sq_index = index.cast %sq_position : i32 to index
    %sq_offset = index.scale %sq_index, %sqe_bytes : index, offset -> offset
    %sq_words = buffer.view %submission_entries[%sq_offset] : buffer -> view<16xi32>
    %sq_longwords = buffer.view %submission_entries[%sq_offset] : buffer -> view<8xi64>
    %ticket_wide = scalar.extui %ticket : i32 to i64
    view.store %read_fixed_file, %sq_words[0] : i32, view<16xi32>
    view.store %file_offset, %sq_longwords[1] : i64, view<8xi64>
    view.store %host_payload, %sq_longwords[2] : i64, view<8xi64>
    view.store %length, %sq_words[6] : i32, view<16xi32>
    view.store %ticket_wide, %sq_longwords[4] : i64, view<8xi64>
    %next_ticket = scalar.addi %ticket, %one : i32
    view.atomic.store %next_ticket, %submission[0] {ordering = release, scope = system} : i32, view<1xi32>
    %published = scalar.extui %next_ticket : i32 to i64
    view.atomic.store %published, %generation[0] {ordering = release, scope = system} : i64, view<4xi64>
    view.atomic.store %trigger, %event[0] {ordering = release, scope = system} : i64, view<1xi64>
    template.apply<@shader_event_interrupt>(%interrupt_context) : (i32) -> ()

    %tail, %stopped = scf.while(%seen = %ticket : i32, %stop = %zero : i32) -> (i32, i32) {
      %pending = scalar.cmpi eq, %seen, %ticket : i32
      %not_stopped = scalar.cmpi eq, %stop, %zero : i32
      %waiting = scalar.andi %pending, %not_stopped : i1
      scf.condition %waiting, %seen, %stop : i1, i32, i32
    } do(%seen: i32, %stop: i32) {
      %observed = view.atomic.load %completion[0] {ordering = relaxed, scope = system} : view<1xi32> -> i32
      %requested_stop = view.atomic.load %header[2] {ordering = acquire, scope = system} : view<8xi32> -> i32
      scf.yield %observed, %requested_stop : i32, i32
    }
    %consume = scalar.cmpi eq, %stopped, %zero : i32
    %next_round, %next_cause, %result, %keep_running = scf.if %consume -> (i32, i32, i32, i1) {
      buffer.fence scope(system) ordering(acquire)
      %cq_position = scalar.andi %ticket, %completion_mask : i32
      %cq_index = index.cast %cq_position : i32 to index
      %cq_offset = index.scale %cq_index, %record_bytes : index, offset -> offset
      %cq_words = buffer.view %completion_entries[%cq_offset] : buffer -> view<4xi32>
      %cq_longwords = buffer.view %completion_entries[%cq_offset] : buffer -> view<2xi64>
      %read_result = view.load %cq_words[2] : view<4xi32> -> i32
      %identity = view.load %cq_longwords[0] : view<2xi64> -> i64
      view.atomic.store %next_ticket, %consumption[0] {ordering = release, scope = system} : i32, view<1xi32>
      %complete = scalar.cmpi eq, %read_result, %length : i32
      %completed_round, %loaded_cause = scf.if %complete -> (i32, i32) {
        %checksum = scf.for %element = [%first to %count step %step](%sum = %zero : i32) -> (i32) {
          %word = view.load %words[%element] : view<[%count]xi32> -> i32
          %added = scalar.addi %sum, %word : i32
          scf.yield %added : i32
        }
        %round_index = index.cast %round : i32 to index
        %round_offset = index.scale %round_index, %record_bytes : index, offset -> offset
        %record_offset = index.add %header_bytes, %round_offset : offset
        %record = buffer.view %control[%record_offset] : buffer -> view<4xi32>
        %record_identity = buffer.view %control[%record_offset] : buffer -> view<2xi64>
        view.store %identity, %record_identity[0] : i64, view<2xi64>
        view.store %block, %record[2] : i32, view<4xi32>
        view.store %checksum, %record[3] : i32, view<4xi32>
        %loaded = view.load %words[0] : view<[%count]xi32> -> i32
        %advanced = scalar.addi %round, %one : i32
        scf.yield %advanced, %loaded : i32, i32
      } else {
        scf.yield %round, %cause : i32, i32
      }
      scf.yield %completed_round, %loaded_cause, %read_result, %complete : i32, i32, i32, i1
    } else {
      scf.yield %round, %cause, %last_result, %false : i32, i32, i32, i1
    }
    scf.yield %next_round, %next_ticket, %next_cause, %result, %keep_running : i32, i32, i32, i32, i1
  }
  view.store %final_result, %header[3] : i32, view<8xi32>
  view.store %finished, %header[4] : i32, view<8xi32>
  view.store %final_cause, %header[5] : i32, view<8xi32>
  view.store %requests, %header[6] : i32, view<8xi32>
  %terminal_ticket = scalar.addi %requests, %one : i32
  %terminal_wide = scalar.extui %terminal_ticket : i32 to i64
  %terminal = scalar.ori %terminal_wide, %terminal_mask : i64
  view.atomic.store %terminal, %generation[0] {ordering = release, scope = system} : i64, view<4xi64>
  view.atomic.store %trigger, %event[0] {ordering = release, scope = system} : i64, view<1xi64>
  template.apply<@shader_event_interrupt>(%interrupt_context) : (i32) -> ()
  kernel.return
}
