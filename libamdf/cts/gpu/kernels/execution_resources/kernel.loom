// One active workitem per workgroup records its physical execution resource and
// a changing numerical witness. Each invocation writes only its own record.
template.decl @execution_resource_id() -> (i32)

kernel.def export("execution_resources") @execution_resources(%groups: index) {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%output: buffer, %epoch: i32) {
  %group = kernel.workgroup.id<x> : index
  %record_bytes = index.constant 8 : offset
  %offset = index.scale %group, %record_bytes : index, offset -> offset
  %record = buffer.view %output[%offset] : buffer -> view<2xi32>
  %identity = template.apply<@execution_resource_id>() : () -> (i32)
  %index = index.cast %group : index to i32
  %value = scalar.xori %index, %epoch : i32
  view.store %identity, %record[0] : i32, view<2xi32>
  view.store %value, %record[1] : i32, view<2xi32>
  kernel.return
}
