// Physical execution identity excludes transient wave and SIMD slots.
template.decl @execution_resource_id() -> (i32)

low.func.def target<amdgpu.rdna3_5.core> @execution_resource_rdna35() -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) asm {
  %hardware = s_getreg_b32 {hwreg = 63511}
  %domain = s_mov_b32 0
  return %hardware, %domain
}

amdgpu.target<gfx1150> @resource_gfx1150_target
template.def<@execution_resource_id> target(@resource_gfx1150_target) @resource_gfx1150() -> (i32) {
  %hardware, %domain = low.invoke @execution_resource_rdna35() : () -> (i32, i32)
  %mask = scalar.constant 1915904 : i32
  %id = scalar.andi %hardware, %mask : i32
  template.return %id : i32
}

