// Physical execution identity excludes transient wave and SIMD slots.
template.decl @execution_resource_id() -> (i32)

low.func.def target<amdgpu.rdna4.core> @execution_resource_rdna4() -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) asm {
  %hardware = s_getreg_b32 {hwreg = 63511}
  %domain = s_sendmsg_rtn_b32 {message = 135}
  s_wait_kmcnt {kmcnt = 0}
  return %hardware, %domain
}

amdgpu.target<gfx1200> @resource_gfx1200_target
template.def<@execution_resource_id> target(@resource_gfx1200_target) @resource_gfx1200() -> (i32) {
  %hardware, %domain = low.invoke @execution_resource_rdna4() : () -> (i32, i32)
  %mask = scalar.constant 80896 : i32
  %unit = scalar.andi %hardware, %mask : i32
  %domain_mask = scalar.constant 983055 : i32
  %selected_domain = scalar.andi %domain, %domain_mask : i32
  %shift = scalar.constant 18 : i32
  %se_mask = scalar.constant 15 : i32
  %se = scalar.andi %selected_domain, %se_mask : i32
  %positioned_se = scalar.shli %se, %shift : i32
  %xcc_mask = scalar.constant 983040 : i32
  %xcc = scalar.andi %selected_domain, %xcc_mask : i32
  %xcc_shift = scalar.constant 8 : i32
  %positioned_xcc = scalar.shli %xcc, %xcc_shift : i32
  %low_id = scalar.ori %unit, %positioned_se : i32
  %id = scalar.ori %low_id, %positioned_xcc : i32
  template.return %id : i32
}

amdgpu.target<gfx1201> @resource_gfx1201_target
template.def<@execution_resource_id> target(@resource_gfx1201_target) @resource_gfx1201() -> (i32) {
  %hardware, %domain = low.invoke @execution_resource_rdna4() : () -> (i32, i32)
  %mask = scalar.constant 80896 : i32
  %unit = scalar.andi %hardware, %mask : i32
  %domain_mask = scalar.constant 983055 : i32
  %selected_domain = scalar.andi %domain, %domain_mask : i32
  %shift = scalar.constant 18 : i32
  %se_mask = scalar.constant 15 : i32
  %se = scalar.andi %selected_domain, %se_mask : i32
  %positioned_se = scalar.shli %se, %shift : i32
  %xcc_mask = scalar.constant 983040 : i32
  %xcc = scalar.andi %selected_domain, %xcc_mask : i32
  %xcc_shift = scalar.constant 8 : i32
  %positioned_xcc = scalar.shli %xcc, %xcc_shift : i32
  %low_id = scalar.ori %unit, %positioned_se : i32
  %id = scalar.ori %low_id, %positioned_xcc : i32
  template.return %id : i32
}
