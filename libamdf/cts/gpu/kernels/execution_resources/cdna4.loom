// Physical execution identity excludes transient wave and SIMD slots.
template.decl @execution_resource_id() -> (i32)

low.func.def target<amdgpu.cdna4.core> @execution_resource_cdna4() -> (reg<amdgpu.sgpr>, reg<amdgpu.sgpr>) asm {
  %hardware = s_getreg_b32 {hwreg = 63492}
  %domain = s_getreg_b32 {hwreg = 6164}
  return %hardware, %domain
}

amdgpu.target<gfx950> @resource_gfx950_target
template.def<@execution_resource_id> target(@resource_gfx950_target) @resource_gfx950() -> (i32) {
  %hardware, %domain = low.invoke @execution_resource_cdna4() : () -> (i32, i32)
  %mask = scalar.constant 32512 : i32
  %unit = scalar.andi %hardware, %mask : i32
  %shift = scalar.constant 24 : i32
  %xcc = scalar.shli %domain, %shift : i32
  %id = scalar.ori %unit, %xcc : i32
  template.return %id : i32
}
