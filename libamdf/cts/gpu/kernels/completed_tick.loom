// Samples the low 32 bits of the constant-frequency reference clock after the
// resident program's prior vector loads and stores complete. Release/acquire
// operations in the caller separately own visibility to the peer device.
// Message 0x83 is RTN_GET_REALTIME. Its returned SGPR is asynchronous and must
// be waited on through LGKM or KM, according to the selected instruction set.
template.decl @completed_tick() -> (i32)

// Full-width samples bound the resident interval in this same shader domain.
// Request records keep the compact low word; no DRM epoch identity is assumed.
template.decl @completed_tick64() -> (i64)

amdgpu.target<gfx11-generic> @clock_gfx11
amdgpu.target<gfx12-generic> @clock_gfx12
amdgpu.target<gfx12-5-generic> @clock_gfx125
amdgpu.target<gfx1170> @clock_gfx1170
amdgpu.target<gfx1171> @clock_gfx1171
amdgpu.target<gfx1172> @clock_gfx1172

low.func.def target<amdgpu.gfx11.generic.core> @clock_rdna3() -> (reg<amdgpu.sgpr>) asm {
  s_waitcnt {vmcnt = 0}
  s_waitcnt_vscnt {vscnt = 0}
  %tick = s_sendmsg_rtn_b32 {message = 131}
  s_waitcnt {lgkmcnt = 0}
  return %tick
}

low.func.def target<amdgpu.gfx11.generic.core> @clock64_rdna3() -> (reg<amdgpu.sgpr x2>) asm {
  s_waitcnt {vmcnt = 0}
  s_waitcnt_vscnt {vscnt = 0}
  %tick = s_sendmsg_rtn_b64 {message = 131}
  s_waitcnt {lgkmcnt = 0}
  return %tick
}

low.func.def target<amdgpu.rdna4m.core> @clock_rdna4m() -> (reg<amdgpu.sgpr>) asm {
  s_waitcnt {vmcnt = 0}
  s_waitcnt_vscnt {vscnt = 0}
  %tick = s_sendmsg_rtn_b32 {message = 131}
  s_waitcnt {lgkmcnt = 0}
  return %tick
}

low.func.def target<amdgpu.rdna4m.core> @clock64_rdna4m() -> (reg<amdgpu.sgpr x2>) asm {
  s_waitcnt {vmcnt = 0}
  s_waitcnt_vscnt {vscnt = 0}
  %tick = s_sendmsg_rtn_b64 {message = 131}
  s_waitcnt {lgkmcnt = 0}
  return %tick
}

low.func.def target<amdgpu.gfx12.generic.core> @clock_rdna4() -> (reg<amdgpu.sgpr>) asm {
  s_wait_loadcnt {loadcnt = 0}
  s_wait_storecnt {storecnt = 0}
  %tick = s_sendmsg_rtn_b32 {message = 131}
  s_wait_kmcnt {kmcnt = 0}
  return %tick
}

low.func.def target<amdgpu.gfx12.generic.core> @clock64_rdna4() -> (reg<amdgpu.sgpr x2>) asm {
  s_wait_loadcnt {loadcnt = 0}
  s_wait_storecnt {storecnt = 0}
  %tick = s_sendmsg_rtn_b64 {message = 131}
  s_wait_kmcnt {kmcnt = 0}
  return %tick
}

low.func.def target<amdgpu.gfx12_5.generic.core> @clock_rdna45() -> (reg<amdgpu.sgpr>) asm {
  s_wait_loadcnt {loadcnt = 0}
  s_wait_storecnt {storecnt = 0}
  %tick = s_sendmsg_rtn_b32 {message = 131}
  s_wait_kmcnt {kmcnt = 0}
  return %tick
}

low.func.def target<amdgpu.gfx12_5.generic.core> @clock64_rdna45() -> (reg<amdgpu.sgpr x2>) asm {
  s_wait_loadcnt {loadcnt = 0}
  s_wait_storecnt {storecnt = 0}
  %tick = s_sendmsg_rtn_b64 {message = 131}
  s_wait_kmcnt {kmcnt = 0}
  return %tick
}

template.def<@completed_tick> target(@clock_gfx11) @tick_gfx11() -> (i32) {
  %tick = low.invoke @clock_rdna3() : () -> (i32)
  template.return %tick : i32
}

template.def<@completed_tick> target(@clock_gfx12) @tick_gfx12() -> (i32) {
  %tick = low.invoke @clock_rdna4() : () -> (i32)
  template.return %tick : i32
}

template.def<@completed_tick> target(@clock_gfx125) @tick_gfx125() -> (i32) {
  %tick = low.invoke @clock_rdna45() : () -> (i32)
  template.return %tick : i32
}

// RDNA4m has its own representation and no generic code-object selector.
// All three physical targets share the same clock fragment.
template.def<@completed_tick> target(@clock_gfx1170) @tick_gfx1170() -> (i32) {
  %tick = low.invoke @clock_rdna4m() : () -> (i32)
  template.return %tick : i32
}

template.def<@completed_tick> target(@clock_gfx1171) @tick_gfx1171() -> (i32) {
  %tick = low.invoke @clock_rdna4m() : () -> (i32)
  template.return %tick : i32
}

template.def<@completed_tick> target(@clock_gfx1172) @tick_gfx1172() -> (i32) {
  %tick = low.invoke @clock_rdna4m() : () -> (i32)
  template.return %tick : i32
}

template.def<@completed_tick64> target(@clock_gfx11) @tick64_gfx11() -> (i64) {
  %tick = low.invoke @clock64_rdna3() : () -> (i64)
  template.return %tick : i64
}

template.def<@completed_tick64> target(@clock_gfx12) @tick64_gfx12() -> (i64) {
  %tick = low.invoke @clock64_rdna4() : () -> (i64)
  template.return %tick : i64
}

template.def<@completed_tick64> target(@clock_gfx125) @tick64_gfx125() -> (i64) {
  %tick = low.invoke @clock64_rdna45() : () -> (i64)
  template.return %tick : i64
}

template.def<@completed_tick64> target(@clock_gfx1170) @tick64_gfx1170() -> (i64) {
  %tick = low.invoke @clock64_rdna4m() : () -> (i64)
  template.return %tick : i64
}

template.def<@completed_tick64> target(@clock_gfx1171) @tick64_gfx1171() -> (i64) {
  %tick = low.invoke @clock64_rdna4m() : () -> (i64)
  template.return %tick : i64
}

template.def<@completed_tick64> target(@clock_gfx1172) @tick64_gfx1172() -> (i64) {
  %tick = low.invoke @clock64_rdna4m() : () -> (i64)
  template.return %tick : i64
}
