// Complete the mailbox store before issuing the native shader interrupt.
template.decl @shader_event_interrupt(%context: i32)

low.func.def target<amdgpu.rdna4m.core> @shader_event_rdna4m(%context: reg<amdgpu.sgpr>) asm {
  s_waitcnt {vmcnt = 0}
  s_waitcnt_vscnt {vscnt = 0}
  %payload = s_mov_b32_m0 %context
  s_sendmsg %payload {message = 1}
  return
}

amdgpu.target<gfx1170> @shader_event_gfx1170_target
template.def<@shader_event_interrupt> target(@shader_event_gfx1170_target) @shader_event_gfx1170_impl(%context: i32) {
  low.invoke @shader_event_rdna4m(%context) : (i32) -> ()
  template.return
}

amdgpu.target<gfx1171> @shader_event_gfx1171_target
template.def<@shader_event_interrupt> target(@shader_event_gfx1171_target) @shader_event_gfx1171_impl(%context: i32) {
  low.invoke @shader_event_rdna4m(%context) : (i32) -> ()
  template.return
}

amdgpu.target<gfx1172> @shader_event_gfx1172_target
template.def<@shader_event_interrupt> target(@shader_event_gfx1172_target) @shader_event_gfx1172_impl(%context: i32) {
  low.invoke @shader_event_rdna4m(%context) : (i32) -> ()
  template.return
}
