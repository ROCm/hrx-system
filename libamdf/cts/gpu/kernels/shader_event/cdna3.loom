// Complete the mailbox store before issuing the native shader interrupt.
template.decl @shader_event_interrupt(%context: i32)

low.func.def target<amdgpu.cdna3.core> @shader_event_cdna3(%context: reg<amdgpu.sgpr>) asm {
  s_waitcnt {vmcnt = 0}
  %payload = s_mov_b32_m0 %context
  s_sendmsg %payload {message = 1}
  return
}

amdgpu.target<gfx940> @shader_event_gfx940_target
template.def<@shader_event_interrupt> target(@shader_event_gfx940_target) @shader_event_gfx940_impl(%context: i32) {
  low.invoke @shader_event_cdna3(%context) : (i32) -> ()
  template.return
}

amdgpu.target<gfx941> @shader_event_gfx941_target
template.def<@shader_event_interrupt> target(@shader_event_gfx941_target) @shader_event_gfx941_impl(%context: i32) {
  low.invoke @shader_event_cdna3(%context) : (i32) -> ()
  template.return
}

amdgpu.target<gfx942> @shader_event_gfx942_target
template.def<@shader_event_interrupt> target(@shader_event_gfx942_target) @shader_event_gfx942_impl(%context: i32) {
  low.invoke @shader_event_cdna3(%context) : (i32) -> ()
  template.return
}
