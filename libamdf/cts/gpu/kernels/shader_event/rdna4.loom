// Complete the mailbox store before issuing the native shader interrupt.
template.decl @shader_event_interrupt(%context: i32)

low.func.def target<amdgpu.rdna4.core> @shader_event_rdna4(%context: reg<amdgpu.sgpr>) asm {
  s_wait_loadcnt {loadcnt = 0}
  s_wait_storecnt {storecnt = 0}
  %payload = s_mov_b32_m0 %context
  s_sendmsg %payload {message = 1}
  return
}

amdgpu.target<gfx1200> @shader_event_gfx1200_target
template.def<@shader_event_interrupt> target(@shader_event_gfx1200_target) @shader_event_gfx1200_impl(%context: i32) {
  low.invoke @shader_event_rdna4(%context) : (i32) -> ()
  template.return
}

amdgpu.target<gfx1201> @shader_event_gfx1201_target
template.def<@shader_event_interrupt> target(@shader_event_gfx1201_target) @shader_event_gfx1201_impl(%context: i32) {
  low.invoke @shader_event_rdna4(%context) : (i32) -> ()
  template.return
}
