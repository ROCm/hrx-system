load("//libamdf/build_tools/bazel:cts.bzl", "amdf_cts_test_suite")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

# Explicit external simulator inputs are supplied by the embedding launcher.
amdf_cts_test_suite(
    name = "rocjitsu",
    srcs = ["lifecycle_test.cc"],
    tags = ["manual"],
    target_compatible_with = select({
        "//libamdf/config/provider:rocjitsu": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//build_tools/bazel:dl",
        "//libamdf/cts/gpu:gpu_device_fixture",
        "//libamdf/cts/gpu/aql/encoding:packets",
        "//libamdf/cts/gpu/aql/queue:publication",
        "//libamdf/cts/gpu/pm4/encoding:commands",
        "//libamdf/cts/gpu/pm4/encoding:profile",
        "//libamdf/cts/gpu/util:command_fixture",
        "//libamdf/cts/gpu/util:memory",
        "//libamdf/cts/gpu/util:user_queue",
        "//libamdf/cts/util:device_cache",
        "//libamdf/cts/util:provider_headers",
        "//third_party:google_test",
    ],
)
