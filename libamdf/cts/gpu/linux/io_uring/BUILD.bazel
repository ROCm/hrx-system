load("//libamdf/build_tools/bazel:cc.bzl", "amdf_cc_library")
load("//libamdf/build_tools/bazel:cts.bzl", "amdf_cts_test_suite")
load("//loom/build_tools/amdgpu:target_config.bzl", "LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITIES")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

exports_files([
    "README.md",
    "file-staged.md",
])

# The single-invocation file-I/O programs use PM4 and RDNA descriptor sets.
# The separate staged-file corpus uses AQL and the complete GPU target matrix.
_RDNA_COMPATIBILITY = {
    "//loom/config/target/amdgpu:" + capability: []
    for capability in LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITIES
    if capability.startswith("descriptor_set_rdna")
}

_RDNA_COMPATIBILITY["//conditions:default"] = ["@platforms//:incompatible"]

_FILE_IO_SRCS = [
    "file_gather_fixture.h",
    "file_gather_test.cc",
    "file_exchange_fixture.h",
    "file_io_test.cc",
    "file_latency_fixture.h",
    "file_latency_test.cc",
]

_FILE_IO_HOST_COMPATIBILITY = [
    "@platforms//os:linux",
    "@platforms//cpu:x86_64",
]

_COMPLETED_TICK_CONFIGS = [
    "//loom/config/target/amdgpu:descriptor_set_gfx11_generic_core",
    "//loom/config/target/amdgpu:descriptor_set_gfx12_generic_core",
    "//loom/config/target/amdgpu:descriptor_set_gfx12_5_generic_core",
    "//loom/config/target/amdgpu:descriptor_set_rdna4m_core",
]

_COMPLETED_TICK_COMPATIBILITY = loom_config_compatible_with(_COMPLETED_TICK_CONFIGS)

_FILE_IO_COMPATIBILITY = (
    _FILE_IO_HOST_COMPATIBILITY +
    _COMPLETED_TICK_COMPATIBILITY +
    select(_RDNA_COMPATIBILITY)
)

_FILE_IO_CXX_COMPATIBILITY = (
    _FILE_IO_HOST_COMPATIBILITY +
    loom_config_compatible_with(
        ["//loom/config/import:cxx"] + _COMPLETED_TICK_CONFIGS,
    ) +
    select(_RDNA_COMPATIBILITY)
)

_FILE_IO_DEPS = [
    "//libamdf/cts/util:wait",
    ":file_io_fixture",
    "//libamdf/cts/gpu/kernels:file_demand",
    "//libamdf/cts/gpu/kernels:file_exchange",
    "//libamdf/cts/gpu/kernels:file_gather",
    "//libamdf/cts/gpu/kernels:file_latency",
    "//third_party:google_test",
    "//third_party:linux_amdgpu_uapi",
]

amdf_cc_library(
    name = "file_io_resources",
    testonly = True,
    srcs = ["file_io_resources.cc"],
    hdrs = ["file_io_resources.h"],
    target_compatible_with = _FILE_IO_HOST_COMPATIBILITY,
    deps = [
        "//libamdf/cts/gpu:gpu_device_fixture",
        "//libamdf/cts/gpu/util:memory",
        "//libamdf/cts/gpu/util:user_queue",
        "//libamdf/cts/util:wait",
        "//third_party:google_test",
        "//third_party:linux_io_uapi",
    ],
)

amdf_cc_library(
    name = "file_io_fixture",
    testonly = True,
    srcs = ["file_io_fixture.cc"],
    hdrs = ["file_io_fixture.h"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    deps = [
        ":file_io_resources",
        "//libamdf/cts/gpu/kernels:kernel",
        "//libamdf/cts/gpu/pm4:dispatch_fixture",
        "//libamdf/cts/gpu/pm4/encoding:commands",
        "//libamdf/cts/util:wait",
        "//third_party:google_test",
        "//third_party:linux_io_uapi",
    ],
)

amdf_cts_test_suite(
    name = "file_io",
    srcs = _FILE_IO_SRCS,
    target_compatible_with = _FILE_IO_COMPATIBILITY,
    visibility = ["//visibility:public"],
    deps = _FILE_IO_DEPS + [
        "//libamdf/cts/gpu/kernels:file_demand_kernels",
        "//libamdf/cts/gpu/kernels:file_exchange_kernels",
        "//libamdf/cts/gpu/kernels:file_gather_kernels",
        "//libamdf/cts/gpu/kernels:file_latency_kernels",
    ],
)

amdf_cts_test_suite(
    name = "file_io_cxx",
    srcs = _FILE_IO_SRCS,
    defines = ["AMDF_FILE_IO_CXX_KERNELS=1"],
    target_compatible_with = _FILE_IO_CXX_COMPATIBILITY,
    visibility = ["//visibility:public"],
    deps = _FILE_IO_DEPS + [
        "//libamdf/cts/gpu/kernels:file_demand_cxx_kernels",
        "//libamdf/cts/gpu/kernels:file_exchange_cxx_kernels",
        "//libamdf/cts/gpu/kernels:file_gather_cxx_kernels",
        "//libamdf/cts/gpu/kernels:file_latency_cxx_kernels",
    ],
)

amdf_cts_test_suite(
    name = "file_io_stress",
    srcs = [
        "file_exchange_fixture.h",
        "file_gather_fixture.h",
        "file_gather_stress_test.cc",
        "file_io_stress_test.cc",
        "file_latency_fixture.h",
        "file_latency_stress_test.cc",
    ],
    tags = [
        "manual",
        "stress",
    ],
    target_compatible_with = _FILE_IO_COMPATIBILITY,
    visibility = ["//visibility:public"],
    deps = _FILE_IO_DEPS + [
        "//libamdf/cts/gpu/kernels:file_demand_kernels",
        "//libamdf/cts/gpu/kernels:file_exchange_kernels",
        "//libamdf/cts/gpu/kernels:file_gather_kernels",
        "//libamdf/cts/gpu/kernels:file_latency_kernels",
    ],
)

amdf_cc_library(
    name = "file_staged_fixture",
    testonly = True,
    srcs = ["file_staged_fixture.cc"],
    hdrs = ["file_staged_fixture.h"],
    target_compatible_with = _FILE_IO_HOST_COMPATIBILITY,
    deps = [
        ":file_io_resources",
        "//libamdf/cts/gpu/aql/queue:publication",
        "//libamdf/cts/gpu/kernels:file_staged",
        "//libamdf/cts/gpu/kernels:file_staged_read_kernels",
        "//libamdf/cts/gpu/kernels:file_staged_reader_kernels",
        "//libamdf/cts/gpu/kernels:file_staged_upload_kernels",
        "//libamdf/cts/gpu/recipes:device_sdma_fixture",
        "//libamdf/cts/gpu/sdma/encoding:commands",
        "//libamdf/cts/util:wait",
        "//third_party:google_test",
    ],
)

amdf_cts_test_suite(
    name = "file_staged",
    srcs = ["file_staged_test.cc"],
    target_compatible_with = _FILE_IO_HOST_COMPATIBILITY,
    visibility = ["//visibility:public"],
    deps = [
        ":file_staged_fixture",
        "//third_party:google_test",
    ],
)

amdf_cts_test_suite(
    name = "file_staged_stress",
    srcs = ["file_staged_stress_test.cc"],
    tags = [
        "manual",
        "stress",
    ],
    target_compatible_with = _FILE_IO_HOST_COMPATIBILITY,
    visibility = ["//visibility:public"],
    deps = [
        ":file_staged_fixture",
        "//third_party:google_test",
    ],
)
