load("//libamdf/build_tools/bazel:cts.bzl", "amdf_cts_test_suite")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

exports_files(["README.md"])

_CXX_DEFINES = select({
    "//loom/config/import:cxx": ["AMDF_CTS_XDNA_CXX_WORKER=1"],
    "//conditions:default": [],
})

_CXX_DEPS = select({
    "//loom/config/import:cxx": ["//libamdf/cts/xdna/programs:mul_i32_cxx"],
    "//conditions:default": [],
})

amdf_cts_test_suite(
    name = "execution",
    srcs = [
        "cpu_xdna_test.cc",
        "firmware_trace_test.cc",
        "reservation_test.cc",
    ],
    defines = _CXX_DEFINES,
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//libamdf/cts/util:mapped_memory",
        "//libamdf/cts/util:observation",
        "//libamdf/cts/util:wait",
        "//libamdf/cts/xdna:xdna_device_fixture",
        "//libamdf/cts/xdna/programs:mul_i32",
        "//libamdf/cts/xdna/programs:recurrence_i32",
        "//libamdf/cts/xdna/util:executable",
        "//libamdf/cts/xdna/util:execution",
        "//third_party:google_test",
    ] + _CXX_DEPS,
)
