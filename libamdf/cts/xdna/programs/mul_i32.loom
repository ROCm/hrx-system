aie2p.target<array> @array_target

func.decl @multiply_record(%lhs_layout: encoding<layout>, %lhs: view<16xi32, %lhs_layout>, %rhs_layout: encoding<layout>, %rhs: view<16xi32, %rhs_layout>, %output_layout: encoding<layout>, %output: view<16xi32, %output_layout>)

pipeline.def<kernel> public retain target(@array_target) @mul_i32() run(%lhs: buffer, %rhs: buffer, %output: buffer) {
  %lhs_aligned, %rhs_aligned, %output_aligned = buffer.assume.alignment %lhs, %rhs, %output {minimum_alignment = 64} : buffer, buffer, buffer
  %memory = pipeline.memory<workgroup>[0, 3] : pool
  %origin = index.constant 0 : offset
  %storage_bytes = index.constant 64 : offset
  %capacity = index.constant 1 : index
  %record_layout = encoding.layout.dense : encoding<layout>
  %lhs_storage = buffer.alloca<workgroup> pool(%memory) align(64) %storage_bytes : buffer
  %lhs_slots = buffer.view %lhs_storage[%origin] : buffer -> view<1x16xi32>
  %lhs_records = channel.bind<fifo> %lhs_slots, %capacity : view<1x16xi32>, index -> channel<tile<16xi32, %record_layout>>
  %rhs_storage = buffer.alloca<workgroup> pool(%memory) align(64) %storage_bytes : buffer
  %rhs_slots = buffer.view %rhs_storage[%origin] : buffer -> view<1x16xi32>
  %rhs_records = channel.bind<fifo> %rhs_slots, %capacity : view<1x16xi32>, index -> channel<tile<16xi32, %record_layout>>
  %output_storage = buffer.alloca<workgroup> pool(%memory) align(64) %storage_bytes : buffer
  %output_slots = buffer.view %output_storage[%origin] : buffer -> view<1x16xi32>
  %output_records = channel.bind<fifo> %output_slots, %capacity : view<1x16xi32>, index -> channel<tile<16xi32, %record_layout>>
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %lhs_external = buffer.view %lhs_aligned[%origin] : buffer -> view<16xi32>
    %lhs_write, %lhs_destination = channel.reserve %lhs_records : channel<tile<16xi32, %record_layout>> -> (write<tile<16xi32, %record_layout>>, view<16xi32, %record_layout>)
    %lhs_ingress = kernel.async.copy %lhs_external to %lhs_destination {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<16xi32> to view<16xi32, %record_layout> -> kernel.async.token
    %lhs_incoming = kernel.async.group %lhs_ingress : kernel.async.token -> kernel.async.group
    kernel.async.wait %lhs_incoming {newer_groups = 0} : kernel.async.group
    channel.publish %lhs_write : write<tile<16xi32, %record_layout>>
    %rhs_external = buffer.view %rhs_aligned[%origin] : buffer -> view<16xi32>
    %rhs_write, %rhs_destination = channel.reserve %rhs_records : channel<tile<16xi32, %record_layout>> -> (write<tile<16xi32, %record_layout>>, view<16xi32, %record_layout>)
    %rhs_ingress = kernel.async.copy %rhs_external to %rhs_destination {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<16xi32> to view<16xi32, %record_layout> -> kernel.async.token
    %rhs_incoming = kernel.async.group %rhs_ingress : kernel.async.token -> kernel.async.group
    kernel.async.wait %rhs_incoming {newer_groups = 0} : kernel.async.group
    channel.publish %rhs_write : write<tile<16xi32, %record_layout>>
    %output_read, %output_source = channel.acquire %output_records : channel<tile<16xi32, %record_layout>> -> (read<tile<16xi32, %record_layout>>, view<16xi32, %record_layout>)
    %output_external = buffer.view %output_aligned[%origin] : buffer -> view<16xi32>
    %egress = kernel.async.copy %output_source to %output_external {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<16xi32, %record_layout> to view<16xi32> -> kernel.async.token
    %outgoing = kernel.async.group %egress : kernel.async.token -> kernel.async.group
    kernel.async.wait %outgoing {newer_groups = 0} : kernel.async.group
    channel.release %output_read : read<tile<16xi32, %record_layout>>
  }
  pipeline.strand workers([0, 3], [1, 1], [1, 1]) {
    %lhs_read, %lhs_source = channel.acquire %lhs_records : channel<tile<16xi32, %record_layout>> -> (read<tile<16xi32, %record_layout>>, view<16xi32, %record_layout>)
    %rhs_read, %rhs_source = channel.acquire %rhs_records : channel<tile<16xi32, %record_layout>> -> (read<tile<16xi32, %record_layout>>, view<16xi32, %record_layout>)
    %output_write, %output_destination = channel.reserve %output_records : channel<tile<16xi32, %record_layout>> -> (write<tile<16xi32, %record_layout>>, view<16xi32, %record_layout>)
    func.call @multiply_record(%record_layout, %lhs_source, %record_layout, %rhs_source, %record_layout, %output_destination) : (encoding<layout>, view<16xi32, %record_layout>, encoding<layout>, view<16xi32, %record_layout>, encoding<layout>, view<16xi32, %record_layout>)
    channel.publish %output_write : write<tile<16xi32, %record_layout>>
    channel.release %rhs_read : read<tile<16xi32, %record_layout>>
    channel.release %lhs_read : read<tile<16xi32, %record_layout>>
  }
}
