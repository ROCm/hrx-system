load("//libamdf/build_tools/bazel:cc.bzl", "amdf_cc_library")
load("//libamdf/build_tools/bazel:cts.bzl", "amdf_cts_test_suite")
load("//libamdf/build_tools/bazel:cts_gpu_kernel.bzl", "amdf_cts_gpu_kernel_set")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")
load("//loom/build_tools/bazel:defs.bzl", "loom_target_profile")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

_MEDIA_GPU_KERNEL_COMPATIBILITY = loom_config_compatible_with([
    "//loom/config/import:cxx",
    "//loom/config/target:amdgpu_artifacts",
    "//loom/config/target/amdgpu:descriptor_set_rdna3_5_core",
])

_HOST_MEDIA_GPU_COMPATIBILITY = _MEDIA_GPU_KERNEL_COMPATIBILITY + [
    "@platforms//cpu:x86_64",
] + select({
    "@platforms//os:linux": [],
    "@platforms//os:windows": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

_WINDOWS_MEDIA_GPU_COMPATIBILITY = _MEDIA_GPU_KERNEL_COMPATIBILITY + [
    "@platforms//os:windows",
    "@platforms//cpu:x86_64",
]

test_suite(
    name = "media",
    tests = [
        ":av1",
        ":encode",
        ":h264",
        ":hevc",
        ":vp9",
    ],
    visibility = ["//visibility:public"],
)

loom_target_profile(
    name = "gfx1150",
    family = "amdgpu",
    selector = "gfx1150",
)

loom_target_profile(
    name = "gfx1151",
    family = "amdgpu",
    selector = "gfx1151",
)

amdf_cts_gpu_kernel_set(
    name = "consume",
    srcs = ["image.cxx"],
    entry_point = "media_consume",
    inputopts = ["cxx:root=media_consume"],
    namespace = "kernels::media_consume",
    target_compatible_with = _MEDIA_GPU_KERNEL_COMPATIBILITY,
    targets = [
        "gfx1150",
        "gfx1151",
    ],
)

amdf_cts_gpu_kernel_set(
    name = "produce",
    srcs = ["image.cxx"],
    entry_point = "media_produce",
    inputopts = ["cxx:root=media_produce"],
    namespace = "kernels::media_produce",
    target_compatible_with = _MEDIA_GPU_KERNEL_COMPATIBILITY,
    targets = [
        "gfx1150",
        "gfx1151",
    ],
)

amdf_cc_library(
    name = "decode_fixture",
    testonly = True,
    srcs = ["decode_fixture.cc"],
    hdrs = ["decode_fixture.h"],
    linkopts = [
        "d3d12.lib",
        "dxgi.lib",
    ],
    target_compatible_with = _WINDOWS_MEDIA_GPU_COMPATIBILITY,
    deps = [
        ":consume",
        "//libamdf/cts/gpu/pm4/encoding:commands",
        "//libamdf/cts/gpu/util:command_fixture",
        "//third_party:google_test",
    ],
)

amdf_cc_library(
    name = "encode_fixture",
    testonly = True,
    srcs = [
        "encode_decode.cc",
        "encode_fixture.cc",
    ],
    hdrs = ["encode_fixture.h"],
    linkopts = select({
        "@platforms//os:windows": [
            "d3d12.lib",
            "dxgi.lib",
        ],
        "//conditions:default": [],
    }),
    target_compatible_with = _HOST_MEDIA_GPU_COMPATIBILITY,
    deps = [
        ":consume",
        ":produce",
        "//libamdf/cts/gpu/pm4/encoding:commands",
        "//libamdf/cts/gpu/util:command_fixture",
        "//third_party:google_test",
    ],
)

amdf_cts_test_suite(
    name = "encode",
    srcs = ["encode_test.cc"],
    target_compatible_with = _HOST_MEDIA_GPU_COMPATIBILITY,
    visibility = ["//visibility:public"],
    deps = [
        ":encode_fixture",
        "//third_party:google_test",
    ],
)

amdf_cts_test_suite(
    name = "h264",
    srcs = ["h264_test.cc"],
    target_compatible_with = _WINDOWS_MEDIA_GPU_COMPATIBILITY,
    visibility = ["//visibility:public"],
    deps = [
        ":decode_fixture",
        "//libamdf/cts/media:h264_fixture",
        "//libamdf/cts/media:h264_profile_fixture",
        "//third_party:google_test",
    ],
)

amdf_cts_test_suite(
    name = "hevc",
    srcs = ["hevc_test.cc"],
    target_compatible_with = _WINDOWS_MEDIA_GPU_COMPATIBILITY,
    visibility = ["//visibility:public"],
    deps = [
        ":decode_fixture",
        "//libamdf/cts/media:hevc_fixture",
        "//third_party:google_test",
    ],
)

amdf_cts_test_suite(
    name = "vp9",
    srcs = ["vp9_test.cc"],
    target_compatible_with = _WINDOWS_MEDIA_GPU_COMPATIBILITY,
    visibility = ["//visibility:public"],
    deps = [
        ":decode_fixture",
        "//libamdf/cts/media:vp9_fixture",
        "//third_party:google_test",
    ],
)

amdf_cts_test_suite(
    name = "av1",
    srcs = ["av1_test.cc"],
    target_compatible_with = _WINDOWS_MEDIA_GPU_COMPATIBILITY,
    visibility = ["//visibility:public"],
    deps = [
        ":decode_fixture",
        "//libamdf/cts/media:av1_fixture",
        "//third_party:google_test",
    ],
)
