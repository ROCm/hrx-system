load("//libamdf/build_tools/bazel:cts.bzl", "amdf_cts_test_suite")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

amdf_cts_test_suite(
    name = "memory",
    srcs = ["memory_test.cc"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//build_tools/vulkan/testing:buffer",
        "//build_tools/vulkan/testing:compute",
        "//build_tools/vulkan/testing:context",
        "//build_tools/vulkan/testing:submission",
        "//build_tools/vulkan/testing/testdata:transform_spv",
        "//libamdf/cts/gpu:gpu_device_fixture",
        "//libamdf/cts/gpu:pm4_commands",
        "//third_party:google_test",
        "//third_party:vulkan_headers",
    ],
)
