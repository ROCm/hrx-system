load("//libamdf/build_tools/bazel:cc.bzl", "amdf_cc_library")
load("//libamdf/build_tools/bazel:cts.bzl", "amdf_cts_test_suite")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

_COMPLETED_TICK_COMPATIBILITY = loom_config_compatible_with([
    "//loom/config/target/amdgpu:descriptor_set_gfx11_generic_core",
    "//loom/config/target/amdgpu:descriptor_set_gfx12_generic_core",
    "//loom/config/target/amdgpu:descriptor_set_gfx12_5_generic_core",
    "//loom/config/target/amdgpu:descriptor_set_rdna4m_core",
])

exports_files(["README.md"])

amdf_cc_library(
    name = "device_fixture",
    testonly = True,
    srcs = ["device_fixture.cc"],
    hdrs = ["device_fixture.h"],
    deps = [
        "//libamdf/cts/gpu:gpu_device_fixture",
        "//libamdf/cts/gpu/pm4/encoding:commands",
        "//libamdf/cts/gpu/pm4/encoding:profile",
        "//libamdf/cts/util:mapped_memory",
        "//libamdf/cts/xdna/util:execution",
        "//third_party:google_test",
    ],
)

amdf_cc_library(
    name = "resident_transaction",
    testonly = True,
    srcs = ["resident_transaction.cc"],
    hdrs = ["resident_transaction.h"],
    deps = ["//third_party:google_test"],
)

amdf_cc_library(
    name = "pm4_queue",
    testonly = True,
    srcs = ["pm4_queue.cc"],
    hdrs = ["pm4_queue.h"],
    target_compatible_with = ["@platforms//cpu:x86_64"],
    deps = [
        "//libamdf/cts/gpu:gpu_device_fixture",
        "//libamdf/cts/gpu/pm4/encoding:memory_commands",
        "//libamdf/cts/gpu/util:user_queue",
        "//libamdf/cts/util:mapped_memory",
        "//third_party:google_test",
    ],
)

amdf_cts_test_suite(
    name = "execution",
    srcs = [
        "gpu_xdna_test.cc",
        "resident_test.cc",
    ],
    target_compatible_with = (
        ["@platforms//cpu:x86_64"] +
        _COMPLETED_TICK_COMPATIBILITY +
        select({
            "@platforms//os:linux": [],
            "@platforms//os:windows": [],
            "//conditions:default": ["@platforms//:incompatible"],
        })
    ),
    visibility = ["//visibility:public"],
    deps = [
        ":device_fixture",
        ":pm4_queue",
        ":resident_transaction",
        "//libamdf/cts/gpu:gpu_device_fixture",
        "//libamdf/cts/gpu/kernels:resident_channels",
        "//libamdf/cts/gpu/kernels:resident_channels_kernels",
        "//libamdf/cts/gpu/kernels:resident_exchange",
        "//libamdf/cts/gpu/kernels:resident_exchange_kernels",
        "//libamdf/cts/gpu/kernels:resident_npu_initiated",
        "//libamdf/cts/gpu/kernels:resident_npu_initiated_kernels",
        "//libamdf/cts/gpu/kernels:transform",
        "//libamdf/cts/gpu/kernels:transform_kernels",
        "//libamdf/cts/gpu/pm4/encoding:commands",
        "//libamdf/cts/util:device_cache",
        "//libamdf/cts/util:mapped_memory",
        "//libamdf/cts/xdna/programs:mul_i32",
        "//libamdf/cts/xdna/programs:resident_channels",
        "//libamdf/cts/xdna/programs:resident_exchange",
        "//libamdf/cts/xdna/programs:resident_npu_initiated",
        "//libamdf/cts/xdna/util:executable",
        "//libamdf/cts/xdna/util:execution",
        "//third_party:google_test",
    ],
)
