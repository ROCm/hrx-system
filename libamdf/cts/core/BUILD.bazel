load("//libamdf/build_tools/bazel:cts.bzl", "amdf_cts_test_suite")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

[amdf_cts_test_suite(
    name = name,
    srcs = [name + "_test.cc"] + (["telemetry_test.cc"] if name == "observation" else []),
    # API negotiation covers each binding; native behavior uses one provider.
    linkage_modes = [
        "static",
        "shared",
        "dynamic",
    ] if name == "query" else ["dynamic"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//libamdf/cts/util:device_cache",
        "//libamdf/cts/util:provider_headers",
        "//third_party:google_test",
    ],
) for name in [
    "allocator",
    "discovery",
    "memory",
    "memory_reservation",
    "observation",
    "query",
]]

test_suite(
    name = "core",
    tests = [
        ":allocator",
        ":discovery",
        ":memory",
        ":memory_reservation",
        ":observation",
        ":query",
    ],
    visibility = ["//visibility:public"],
)
