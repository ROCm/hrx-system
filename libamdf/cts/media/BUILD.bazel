load("//build_tools/embed_data:build_defs.bzl", "iree_c_embed_data")
load("//libamdf/build_tools/bazel:cc.bzl", "amdf_cc_library")
load("//libamdf/build_tools/bazel:cts.bzl", "amdf_cts_test_suite")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

test_suite(
    name = "media",
    tests = [
        ":av1",
        ":encode_configuration",
        ":h264",
        ":hevc",
        ":jpeg",
        ":vp9",
    ],
    visibility = ["//visibility:public"],
)

amdf_cts_test_suite(
    name = "encode_configuration",
    srcs = ["encode_configuration_test.cc"],
    target_compatible_with = ["@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"],
    deps = [
        "//libamdf/cts/util:device_cache",
        "//libamdf/cts/util:provider_headers",
        "//third_party:google_test",
    ],
)

iree_c_embed_data(
    name = "jpeg_fixtures",
    testonly = True,
    srcs = [
        "jpeg_128x96.jpg",
        "jpeg_128x96.nv12",
        "jpeg_128x96_inverse.jpg",
        "jpeg_128x96_inverse.nv12",
        "jpeg_320x240.jpg",
        "jpeg_320x240.nv12",
        "jpeg_320x240_inverse.jpg",
        "jpeg_320x240_inverse.nv12",
        "jpeg_80x72.jpg",
        "jpeg_80x72.nv12",
        "jpeg_80x72_inverse.jpg",
        "jpeg_80x72_inverse.nv12",
    ],
    c_file_output = "jpeg_fixtures.c",
    flatten = True,
    h_file_output = "jpeg_fixtures.h",
    identifier = "amdf_cts_jpeg_fixtures",
)

