load("//libamdf/build_tools/bazel:cc.bzl", "amdf_cc_binary", "amdf_cc_library", "amdf_cc_tool")
load("//libamdf/build_tools/bazel:cc_test.bzl", "amdf_cc_test")
load("//libamdf/build_tools/bazel:python.bzl", "amdf_py_test")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

exports_files(
    ["native_test.py"],
    visibility = ["//libamdf/tool/amdf-info:__subpackages__"],
)

# This tool-owned OS boundary is implemented by the native leaf packages. It
# exposes terminal facilities and path identity, not driver/discovery probing.
amdf_cc_library(
    name = "platform_headers",
    hdrs = ["platform.h"],
    visibility = ["//libamdf/tool/amdf-info:__subpackages__"],
)

amdf_cc_library(
    name = "platform",
    hdrs = ["platform.h"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = select({
        "@platforms//os:linux": ["//libamdf/tool/amdf-info/linux:platform"],
        "@platforms//os:windows": ["//libamdf/tool/amdf-info/windows:platform"],
        "//conditions:default": [],
    }),
)

amdf_cc_library(
    name = "implementation",
    srcs = [
        "activation.c",
        "inventory.c",
        "invocation.c",
        "options.c",
        "output.c",
        "report.c",
        "report_device.c",
        "report_endpoint.c",
        "report_memory.c",
        "report_queue.c",
        "selection.c",
    ],
    hdrs = [
        "activation.h",
        "inventory.h",
        "invocation.h",
        "options.h",
        "output.h",
        "report.h",
        "selection.h",
    ],
    deps = [":platform"],
)

amdf_cc_tool(
    name = "amdf-info",
    srcs = ["main.c"],
    visibility = ["//visibility:public"],
    deps = [
        ":implementation",
        "//libamdf:amdf",
    ],
)

amdf_cc_test(
    name = "selection_test",
    srcs = ["selection_test.cc"],
    deps = [
        ":implementation",
        "//third_party:google_test",
        "//third_party:google_test_main",
    ],
)

# Replaces only the public library dependency, not the executable under test.
amdf_cc_binary(
    name = "report_fixture",
    testonly = True,
    srcs = [
        "main.c",
        "report_fixture.c",
    ],
    deps = [":implementation"],
)

amdf_py_test(
    name = "invocation_test",
    srcs = ["invocation_test.py"],
    args = [
        "$(location :report_fixture)",
        "$(location :amdf-info)",
    ],
    data = [
        ":amdf-info",
        ":report_fixture",
    ],
)
