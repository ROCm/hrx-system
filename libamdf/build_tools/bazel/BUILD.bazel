load("@rules_python//python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "configure",
    srcs = ["configure.py"],
    deps = ["//build_tools/bazel:configure_api"],
)

py_test(
    name = "configure_test",
    srcs = ["configure_test.py"],
    deps = [
        ":configure",
        "//build_tools/bazel:configure",
    ],
)

exports_files([
    "cc.bzl",
    "cc_attrs.bzl",
    "cc_benchmark.bzl",
    "cc_test.bzl",
    "cts.bzl",
    "cts_gpu_kernel.bzl",
    "cts_gpu_targets.bzl",
    "library.bzl",
    "windows_sidecar.bzl",
])
