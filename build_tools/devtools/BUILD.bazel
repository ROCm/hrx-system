# Python developer tools have no CMake target surface.
# bazel-to-cmake: skip

load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("//build_tools/bazel:cc.bzl", "iree_cc_binary")

package(default_visibility = ["//visibility:public"])

# Repository tooling checks are owned by the changed-path-aware Presubmit lane.
# Keep product/platform wildcard builds from rediscovering them in every job.
_PRESUBMIT_TEST_SIZE = "small"

_PRESUBMIT_TEST_TAGS = ["manual"]

py_library(
    name = "run_requirements",
    srcs = ["run_requirements.py"],
    data = [
        "//build_tools/d3d12/requirements:defs.bzl",
        "//build_tools/vulkan/requirements:defs.bzl",
        "//libamdf/requirements:defs.bzl",
        "//loom/requirements:defs.bzl",
        "//runtime/requirements:defs.bzl",
    ],
    deps = ["//build_tools/bazel_to_cmake:declarative_loads"],
)

py_library(
    name = "devtools",
    srcs = [
        "__init__.py",
        "aliases.py",
        "bazel.py",
        "bazel_launcher.py",
        "ci.py",
        "ci_config.py",
        "cli.py",
        "cmake.py",
        "cmake_cache.py",
        "cmake_file_api.py",
        "cmake_fuzz.py",
        "cmake_make.py",
        "cmake_try.py",
        "command_plan.py",
        "ctest.py",
        "doctor.py",
        "environment.py",
        "fuzz.py",
        "help_text.py",
        "hooks.py",
        "importers.py",
        "presubmit.py",
        "project_presubmit.py",
        "setup.py",
        "smoke_test_lib.py",
        "source_lock.py",
    ],
    deps = [
        ":run_requirements",
        "//build_tools/bazel:compile_commands_merge_lib",
        "//build_tools/bazel:configure",
        "//build_tools/ci:windows_diagnostics",
    ],
)

py_binary(
    name = "ci",
    srcs = [
        "__init__.py",
        "ci.py",
        "ci_config.py",
    ],
    deps = [
        ":run_requirements",
        "//build_tools/ci:windows_diagnostics",
    ],
)

config_setting(
    name = "bazel_launcher_debug_configuration",
    values = {"compilation_mode": "dbg"},
)

iree_cc_binary(
    name = "bazel_launcher_integration_fixture",
    testonly = True,
    srcs = ["bazel_launcher_integration_fixture.c"],
    data = select({
        ":bazel_launcher_debug_configuration": [":bazel_launcher_tool_configuration"],
        "//conditions:default": [],
    }),
)

genrule(
    name = "bazel_launcher_tool_configuration",
    testonly = True,
    outs = ["bazel_launcher_tool_configuration.txt"],
    cmd = "$(location :bazel_launcher_integration_fixture) --exit-code 0 > $@",
    tags = _PRESUBMIT_TEST_TAGS,
    tools = [":bazel_launcher_integration_fixture"],
)

py_binary(
    name = "cli_smoke_test",
    srcs = [
        "__init__.py",
        "cli_smoke_test.py",
        "environment.py",
        "smoke_test_lib.py",
    ],
    imports = ["build_tools/devtools"],
    main = "cli_smoke_test.py",
    tags = _PRESUBMIT_TEST_TAGS,
)

