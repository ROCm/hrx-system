# Bazel rule and toolchain tests have no CMake surface.
# bazel-to-cmake: skip

load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//build_tools/bazel:cc_opts.bzl", "cc_opts")
load(
    "//build_tools/bazel:executable.bzl",
    "iree_executable_test",
    "iree_wasi_executable_alias",
)
load(":wasm_rules_test.bzl", "wasm_rules_test_suite")

package(default_visibility = ["//visibility:public"])

_CXX_OPTIONS = cc_opts.iree_cxx_standard_options()

platform(
    name = "wasm32_platform",
    constraint_values = ["@platforms//cpu:wasm32"],
)

wasm_rules_test_suite(name = "wasm_tests")

cc_binary(
    name = "wasi_toolchain_smoke",
    srcs = [
        "wasi_toolchain_smoke.c",
        "wasi_toolchain_smoke.cc",
    ],
    cxxopts = _CXX_OPTIONS.cxxopts,
    features = _CXX_OPTIONS.features,
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//cpu:wasm32",
        "@platforms//os:wasi",
    ],
)

iree_executable_test(
    name = "wasi_toolchain_smoke_test",
    src = ":wasi_toolchain_smoke",
    args = ["$(rootpath :wasi_toolchain_smoke.txt)"],
    data = [":wasi_toolchain_smoke.txt"],
    target_compatible_with = [
        "@platforms//cpu:wasm32",
        "@platforms//os:wasi",
    ],
)

iree_wasi_executable_alias(
    name = "hosted_wasi_toolchain_smoke",
    src = ":wasi_toolchain_smoke",
    wasm_main = "//build_tools/wasm:wasm_test_main.mjs",
)

iree_executable_test(
    name = "hosted_wasi_toolchain_smoke_test",
    src = ":hosted_wasi_toolchain_smoke",
    args = ["$(rootpath :wasi_toolchain_smoke.txt)"],
    data = [":wasi_toolchain_smoke.txt"],
)

sh_test(
    name = "hosted_wasi_failure_test",
    srcs = ["hosted_wasi_failure_test.sh"],
    args = ["$(rootpath :hosted_wasi_toolchain_smoke)"],
    data = [":hosted_wasi_toolchain_smoke"],
    env_inherit = [
        "IREE_WASM_NODE",
        "PATH",
    ],
)

sh_test(
    name = "hosted_wasi_stdout_test",
    srcs = ["hosted_wasi_stdout_test.sh"],
    args = ["$(rootpath :hosted_wasi_toolchain_smoke)"],
    data = [":hosted_wasi_toolchain_smoke"],
    env_inherit = [
        "IREE_WASM_NODE",
        "PATH",
    ],
)
