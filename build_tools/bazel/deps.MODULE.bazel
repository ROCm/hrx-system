"""Bazel module fragment for repository build-system dependencies."""

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.21")
bazel_dep(name = "rules_python", version = "2.4.3")
bazel_dep(name = "rules_shell", version = "0.6.1")

# Unix host profiles provide optimized and sanitizer debug-information features.
# Windows compiler features and artifacts are owned by this module's toolchains.
single_version_override(
    module_name = "rules_cc",
    patch_strip = 1,
    patches = [
        "//build_tools/third_party/rules_cc:sanitizer_debug_info.patch",
        "//build_tools/third_party/rules_cc:optimized_profile.patch",
    ],
    version = "0.2.21",
)

bazel_dep(name = "rules_testing", version = "0.9.0", dev_dependency = True)

wasi_sdk_repo = use_repo_rule(
    "//build_tools/wasm:wasi_sdk_repo.bzl",
    "wasi_sdk_repo",
)

wasi_sdk_repo(name = "wasi_sdk")

register_toolchains("@wasi_sdk//:cc_toolchain")

cc_configure = use_extension(
    "@rules_cc//cc:extensions.bzl",
    "cc_configure_extension",
)
use_repo(cc_configure, "local_config_cc")

windows_toolchain_repository = use_repo_rule(
    "//build_tools/windows:toolchain_repository.bzl",
    "windows_toolchain_repository",
)

windows_toolchain_repository(name = "iree_windows_toolchain")

native_windows_runtime_repository = use_repo_rule(
    "//build_tools/windows:native_runtime.bzl",
    "native_windows_runtime_repository",
)

native_windows_runtime_repository(
    name = "hrx_windows_clang_cl_runtime",
    compiler = "clang-cl",
)

native_windows_runtime_repository(
    name = "hrx_windows_msvc_runtime",
    compiler = "msvc",
)

register_toolchains("//build_tools/windows:all")

macos_toolchain_repository = use_repo_rule(
    "//build_tools/macos:toolchain_repository.bzl",
    "macos_toolchain_repository",
)

macos_toolchain_repository(name = "iree_macos_toolchain")

register_toolchains("//build_tools/macos:all")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(python_version = "3.12")
python.toolchain(python_version = "3.12")
use_repo(python, "python_3_12", "python_3_12_host")

# Runtime repositories and registrations belong to this module, including when
# it is a dependency. Python extension overrides only apply to the root module.
python_repository = use_repo_rule("@rules_python//python:repositories.bzl", "python_repository")

python_repository(
    name = "hrx_python_linux_x86_64_debug",
    platform = "x86_64-unknown-linux-gnu",
    python_version = "3.12.13",
    release_filename = "cpython-3.12.13+20260414-x86_64-unknown-linux-gnu-install_only.tar.gz",
    sha256 = "cdcf8724d46e4857f8db5ee9f4252dc2f5da34f7940294ec6b312389dd3f41e0",
    strip_prefix = "python",
    urls = ["https://github.com/astral-sh/python-build-standalone/releases/download/20260414/cpython-3.12.13+20260414-x86_64-unknown-linux-gnu-install_only.tar.gz"],
)

python_repository(
    name = "hrx_python_linux_x86_64_stripped",
    platform = "x86_64-unknown-linux-gnu",
    python_version = "3.12.13",
    release_filename = "cpython-3.12.13+20260414-x86_64-unknown-linux-gnu-install_only_stripped.tar.gz",
    sha256 = "3c3427e5628648478da2aa227472c350475a68bc58109f1b43849636a4aecb89",
    strip_prefix = "python",
    urls = ["https://github.com/astral-sh/python-build-standalone/releases/download/20260414/cpython-3.12.13+20260414-x86_64-unknown-linux-gnu-install_only_stripped.tar.gz"],
)

register_toolchains("//build_tools/bazel/python_runtime:all")

amdgpu_device_toolchain_repo = use_repo_rule(
    "//build_tools/amdgpu:device_toolchain_repository.bzl",
    "amdgpu_device_toolchain_repo",
)

amdgpu_device_toolchain_repo(
    name = "iree_amdgpu_device_toolchain",
)

clang_tidy_llvm_repo = use_repo_rule(
    "//build_tools/clang_tidy:llvm_repo.bzl",
    "clang_tidy_llvm_repo",
)

clang_tidy_llvm_repo(
    name = "iree_clang_tidy_llvm",
)
