"""Projects a Python Build Standalone archive into a compact Windows runtime."""

def _compact_windows_python_repository_impl(repository_ctx):
    version_parts = repository_ctx.attr.python_version.split(".")
    if len(version_parts) != 3:
        fail("Compact Windows Python version must have major.minor.micro form: %s" % repository_ctx.attr.python_version)
    major, minor, micro = version_parts
    standard_library_archive = "python%s%s.zip" % (major, minor)
    repository_ctx.download_and_extract(
        url = repository_ctx.attr.urls,
        sha256 = repository_ctx.attr.sha256,
        stripPrefix = repository_ctx.attr.strip_prefix,
    )
    for required_path in [
        "tcl/tcl8.6/init.tcl",
        "tcl/tk8.6/tk.tcl",
    ]:
        if not repository_ctx.path(required_path).exists:
            fail("Compact Windows Python runtime is missing %s" % required_path)
    compactor = repository_ctx.path(repository_ctx.attr._compactor)
    repository_ctx.watch(compactor)
    runtime_module = repository_ctx.path(repository_ctx.attr._runtime_module)
    repository_ctx.watch(runtime_module)
    host_python = repository_ctx.path(repository_ctx.attr._host_python)
    repository_ctx.watch(host_python)
    result = repository_ctx.execute(
        [
            host_python,
            compactor,
            repository_ctx.path("Lib"),
            runtime_module,
            repository_ctx.path(standard_library_archive),
        ],
        environment = {"PYTHONDONTWRITEBYTECODE": "1"},
        quiet = True,
    )
    if result.return_code:
        fail("Could not construct compact Windows Python standard library:\n%s\n%s" % (result.stdout, result.stderr))

    repository_ctx.symlink("python.exe", "python")
    repository_ctx.file(
        "STANDALONE_INTERPRETER",
        "# Identifies a hermetic interpreter repository to rules_python.\n",
    )
    build_content = """
# Generated by build_tools/bazel/python_runtime/repository.bzl.

load("@rules_python//python:py_runtime.bzl", "py_runtime")
load("@rules_python//python:py_runtime_pair.bzl", "py_runtime_pair")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "runtime_files",
    srcs = glob(
        [
            "*.dll",
            "*.exe",
            "*.zip",
            "DLLs/**",
            "Lib/ssl.py",
            "tcl/**",
        ],
        exclude = ["**/*.pdb"],
    ),
)

exports_files([
    "python",
    "python.exe",
])

py_runtime(
    name = "py3_runtime",
    files = [":runtime_files"],
    implementation_name = "cpython",
    interpreter = "python.exe",
    interpreter_version_info = {
        "major": "@PYTHON_MAJOR@",
        "micro": "@PYTHON_MICRO@",
        "minor": "@PYTHON_MINOR@",
        "releaselevel": "final",
        "serial": "0",
    },
    pyc_tag = "@PYC_TAG@",
    python_version = "PY3",
    # Windows resolves pythonXY.zip beside the venv interpreter before site
    # initialization can remap the base runtime paths.
    venv_bin_files = glob([
        "*.dll",
        "*.zip",
    ]),
)

py_runtime_pair(
    name = "python_runtimes",
    py3_runtime = ":py3_runtime",
)
"""
    build_content = build_content.replace("@PYTHON_MAJOR@", major)
    build_content = build_content.replace("@PYTHON_MINOR@", minor)
    build_content = build_content.replace("@PYTHON_MICRO@", micro)
    build_content = build_content.replace("@PYC_TAG@", "cpython-%s%s" % (major, minor))
    repository_ctx.file("BUILD.bazel", build_content)
    return repository_ctx.repo_metadata(
        reproducible = True,
        attrs_for_reproducibility = {},
    )

compact_windows_python_repository = repository_rule(
    implementation = _compact_windows_python_repository_impl,
    attrs = {
        "python_version": attr.string(mandatory = True),
        "sha256": attr.string(mandatory = True),
        "strip_prefix": attr.string(mandatory = True),
        "urls": attr.string_list(mandatory = True),
        "_compactor": attr.label(
            default = Label("//build_tools/bazel/python_runtime:compact_stdlib.py"),
        ),
        "_host_python": attr.label(
            default = Label("@python_3_12_host//:python"),
        ),
        "_runtime_module": attr.label(
            default = Label("//build_tools/bazel/python_runtime:windows_runtime.py"),
        ),
    },
)
