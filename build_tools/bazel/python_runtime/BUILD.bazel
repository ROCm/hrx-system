# Interpreter registrations have no CMake target surface.
# bazel-to-cmake: skip

load("@bazel_skylib//lib:selects.bzl", "selects")

# Keep Linux runtime, C-extension, and exec-tools registration semantics at the
# same upstream boundary used to create their runtime repositories.
# buildifier: disable=bzl-visibility
load("@rules_python//python/private:py_toolchain_suite.bzl", "py_toolchain_suite")
load("//build_tools/bazel:python.bzl", "iree_py_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "compact_stdlib.py",
    "repository.bzl",
    "windows_runtime.py",
])

config_setting(
    name = "version_default",
    flag_values = {"@rules_python//python/config_settings:python_version": ""},
)

config_setting(
    name = "version_minor",
    flag_values = {"@rules_python//python/config_settings:python_version": "3.12"},
)

config_setting(
    name = "version_exact",
    flag_values = {"@rules_python//python/config_settings:python_version": "3.12.13"},
)

config_setting(
    name = "debug_runtime",
    flag_values = {
        "//build_tools/bazel:python_runtime_debug": "true",
        "@rules_python//python/config_settings:py_freethreaded": "no",
        "@rules_python//python/config_settings:py_linux_libc": "glibc",
    },
)

config_setting(
    name = "windows_compact_runtime",
    flag_values = {
        "@rules_python//python/config_settings:py_freethreaded": "no",
    },
)

iree_py_test(
    name = "windows_runtime_test",
    srcs = ["windows_runtime_test.py"],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
)

py_toolchain_suite(
    prefix = "stripped",
    python_version = "3.12.13",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_settings = ["//build_tools/bazel:python_runtime_stripped"],
    user_repository_name = "hrx_python_linux_x86_64_stripped",
    version_settings = [
        ":version_default",
        ":version_minor",
        ":version_exact",
    ],
)

py_toolchain_suite(
    prefix = "debug",
    python_version = "3.12.13",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_settings = [":debug_runtime"],
    user_repository_name = "hrx_python_linux_x86_64_debug",
    version_settings = [
        ":version_default",
        ":version_minor",
        ":version_exact",
    ],
)

selects.config_setting_group(
    name = "windows_compact_version",
    match_any = [
        ":version_default",
        ":version_minor",
        ":version_exact",
    ],
)

# Python tools do not compile extensions at runtime. Keep the Windows target
# runtime compact while the separately registered upstream C-extension and
# execution-tools toolchains continue to own headers, import libraries, and
# precompilation.
toolchain(
    name = "windows_compact_toolchain",
    target_compatible_with = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
    target_settings = [
        ":windows_compact_runtime",
        ":windows_compact_version",
    ],
    toolchain = "@hrx_python_windows_x86_64_compact//:python_runtimes",
    toolchain_type = "@rules_python//python:toolchain_type",
)

iree_py_test(
    name = "compact_stdlib_test",
    srcs = [
        "compact_stdlib.py",
        "compact_stdlib_test.py",
        "windows_runtime.py",
    ],
    main = "compact_stdlib_test.py",
)
