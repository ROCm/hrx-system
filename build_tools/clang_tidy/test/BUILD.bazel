package(default_visibility = ["//visibility:private"])

_CXX_OPTIONS = cc_opts.iree_cxx_standard_options()

filegroup(
    name = "testdata",
    srcs = glob(
        ["*"],
        exclude = ["BUILD.bazel"],
    ) + ["//build_tools/clang_tidy/fixtures:status_macro_scope"],
    visibility = ["//build_tools/clang_tidy:__pkg__"],
)

clang_tidy_test_plugin(
    name = "test_plugin",
    testonly = True,
    tags = ["manual"],
    target_compatible_with = CLANG_TIDY_LLVM_TARGET_COMPATIBLE_WITH,
)

py_test(
    name = "action_runner_test",
    srcs = ["action_runner_test.py"],
    args = [
        "--clang-tidy=$(location @iree_clang_tidy_llvm//:clang-tidy)",
        "--plugin=$(location :test_plugin)",
        "--config-file=$(location //build_tools/clang_tidy:clang_tidy_config.yaml)",
        "--vfsoverlay=$(location @iree_clang_tidy_llvm//:clang_resource_overlay)",
        "--source=$(location :smoke.c)",
    ],
    data = [
        "smoke.c",
        ":test_plugin",
        "//build_tools/clang_tidy:clang_tidy_config.yaml",
        "@iree_clang_tidy_llvm//:clang-tidy",
        "@iree_clang_tidy_llvm//:clang_resource_headers",
        "@iree_clang_tidy_llvm//:clang_resource_overlay",
    ],
    main = "action_runner_test.py",
    tags = ["manual"],
    target_compatible_with = CLANG_TIDY_LLVM_TARGET_COMPATIBLE_WITH,
    deps = ["//build_tools/clang_tidy:run_clang_tidy_action_lib"],
)

