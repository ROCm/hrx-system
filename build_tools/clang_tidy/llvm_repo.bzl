_PREBUILT_TOOL_BZL = """\
\"\"\"Rule for exposing relocatable pre-built LLVM tools.\"\"\"

def _prebuilt_tool_impl(ctx):
    output = ctx.actions.declare_file(ctx.label.name)
    wrapper = \"\"\"#!/bin/sh
set -eu

runfiles_dir=
if [ -d \"$0.runfiles\" ]; then
  runfiles_dir=\"$0.runfiles\"
elif [ -n \"${RUNFILES_DIR:-}\" ] && [ -d \"$RUNFILES_DIR\" ]; then
  runfiles_dir=\"$RUNFILES_DIR\"
else
  case \"$0\" in
    *.runfiles/*)
      runfiles_dir=\"${0%%%%.runfiles/*}.runfiles\"
      ;;
  esac
fi
if [ -z \"$runfiles_dir\" ] || [ ! -d \"$runfiles_dir\" ]; then
  echo \"LLVM tool wrapper: unable to locate Bazel runfiles\" >&2
  exit 1
fi

tool_path=
for candidate in \"$runfiles_dir\"/*/bin/%s; do
  if [ ! -x \"$candidate\" ]; then
    continue
  fi
  if [ -n \"$tool_path\" ]; then
    echo \"LLVM tool wrapper: multiple runfiles match bin/%s\" >&2
    exit 1
  fi
  tool_path=\"$candidate\"
done
if [ -z \"$tool_path\" ]; then
  echo \"LLVM tool wrapper: missing runfile bin/%s\" >&2
  exit 1
fi

tool_root=$(dirname \"$(dirname \"$tool_path\")\")
dynamic_library_dir=\"$tool_root/host_dynamic_libraries\"
if [ -d \"$dynamic_library_dir\" ]; then
  export LD_LIBRARY_PATH=\"$dynamic_library_dir\"
fi
exec \"$tool_path\" \"$@\"
\"\"\" % (
        ctx.file.src.basename,
        ctx.file.src.basename,
        ctx.file.src.basename,
    )
    ctx.actions.write(
        output = output,
        content = wrapper,
        is_executable = True,
    )
    runfiles = ctx.runfiles(files = ctx.files.data + [ctx.file.src])
    return [DefaultInfo(
        executable = output,
        files = depset([output]),
        runfiles = runfiles,
    )]

prebuilt_tool = rule(
    implementation = _prebuilt_tool_impl,
    executable = True,
    attrs = {
        "src": attr.label(
            allow_single_file = True,
            mandatory = True,
            doc = "The pre-built binary file.",
        ),
        "data": attr.label_list(
            allow_files = True,
            doc = "Additional files the tool needs at runtime.",
        ),
    },
    doc = "Wraps a pre-built LLVM tool with its exact host dynamic libraries.",
)
"""

_LOCAL_BUILD = """\
