"""

def _join_path(left, right):
    if left.endswith("/"):
        return left + right
    return left + "/" + right

def _is_executable(repository_ctx, path):
    result = repository_ctx.execute(["test", "-x", path], quiet = True)
    return result.return_code == 0

def _executable_from_directory(repository_ctx, directory, names):
    for name in names:
        candidate = _join_path(directory, name)
        if _is_executable(repository_ctx, candidate):
            return candidate
    return ""

def _find_llvm_config(repository_ctx):
    configured = []
    for name in [
        "IREE_CLANG_TIDY_LLVM_CONFIG",
        "LLVM_CONFIG",
    ]:
        value = repository_ctx.getenv(name)
        if not value:
            continue
        if not _is_executable(repository_ctx, value):
            fail("{} is not executable: {}".format(name, value))
        configured.append((name, _canonical_path(repository_ctx, value, name)))
    for name in [
        "IREE_CLANG_TIDY_LLVM_ROOT",
        "IREE_LLVM_ROOT",
        "LLVM_ROOT",
    ]:
        root = repository_ctx.getenv(name)
        if not root:
            continue
        candidate = _executable_from_directory(
            repository_ctx,
            _join_path(root, "bin"),
            ["llvm-config", "llvm-config-22"],
        )
        if not candidate:
            fail("{} does not provide an LLVM config tool under bin/: {}".format(
                name,
                root,
            ))
        configured.append((name, _canonical_path(
            repository_ctx,
            candidate,
            name + " llvm-config",
        )))
    if configured:
        selected_path = configured[0][1]
        for name, path in configured[1:]:
            if path != selected_path:
                fail("Configured clang-tidy LLVM installations disagree: {} and {}={}".format(
                    configured[0][0] + "=" + selected_path,
                    name,
                    path,
                ))
        return selected_path

    for name in ["llvm-config", "llvm-config-22"]:
        llvm_config = repository_ctx.which(name)
        if llvm_config:
            return str(llvm_config)
    return ""

def _execute(repository_ctx, argv, description, loader_environment):
    result = repository_ctx.execute(
        argv,
        environment = loader_environment,
        quiet = True,
    )
    if result.return_code != 0:
        fail("Failed to {} with {}:\n{}".format(
            description,
            " ".join(argv),
            result.stderr,
        ))
    return result.stdout.strip()

def _required_tool(repository_ctx, bindir, names, description):
    candidate = _executable_from_directory(repository_ctx, bindir, names)
    if not candidate:
        fail("LLVM {} is not executable under {} (tried {})".format(
            description,
            bindir,
            ", ".join(names),
        ))
    return _canonical_path(repository_ctx, candidate, description)

def _filtered_copts(cxxflags):
    raw_flags = cxxflags.split(" ")
    filtered = []
    skip_next = False
    for flag in raw_flags:
        if not flag:
            continue
        if skip_next:
            skip_next = False
            continue
        if flag == "-I":
            skip_next = True
            continue
        if flag.startswith("-I"):
            continue
        filtered.append(flag)
    return filtered

def _starlark_string(value):
    return "\"" + value.replace("\\", "\\\\").replace("\"", "\\\"") + "\""

def _starlark_list(values):
    if not values:
        return "[]"
    return "[\n    " + ",\n    ".join([_starlark_string(value) for value in values]) + ",\n]"

def _canonical_path(repository_ctx, path, description):
    path = repository_ctx.path(path)
    if not path.exists:
        fail("{} does not exist: {}".format(description, path))
    return str(path.realpath)

def _local_config(info):
    return """\
# AUTO-GENERATED by llvm_repo.bzl - do not edit.

CLANG_TIDY_LLVM_AVAILABLE = True
CLANG_TIDY_LLVM_ERROR = ""
CLANG_TIDY_LLVM_VERSION = {version}
CLANG_TIDY_LLVM_HAS_RTTI = {has_rtti}
CLANG_TIDY_CLANG_RESOURCE_DIR = "/__iree_clang_resource__"
CLANG_TIDY_LLVM_COPTS = {copts}
CLANG_TIDY_LLVM_TARGET_COMPATIBLE_WITH = []
CLANG_TIDY_TOOL = "@iree_clang_tidy_llvm//:clang-tidy"
CLANG_TIDY_CLANGXX_TOOL = "@iree_clang_tidy_llvm//:clang++"
CLANG_TIDY_LLVM_CONFIG_TOOL = "@iree_clang_tidy_llvm//:llvm-config"
""".format(
        version = _starlark_string(info["version"]),
        has_rtti = _starlark_string(info["has_rtti"]),
        copts = _starlark_list(info["copts"]),
    )

def _write_stub(repository_ctx):
    repository_ctx.file("BUILD.bazel", _STUB_BUILD)
    repository_ctx.file("config.bzl", _STUB_CONFIG)
    repository_ctx.file("clang_resource_overlay.yaml", "{}\n")

def _resource_overlay():
    return """\
{
  "version": 0,
  "use-external-names": false,
  "overlay-relative": true,
  "roots": [
    {
      "type": "directory-remap",
      "name": "/__iree_clang_resource__",
      "external-contents": "clang-resource"
    }
  ]
}
"""

def _write_local(repository_ctx, info):
    repository_ctx.file("prebuilt_tool.bzl", _PREBUILT_TOOL_BZL)
    repository_ctx.file("bin/.keep", "")
    repository_ctx.symlink(repository_ctx.path(info["clang_tidy"]), "bin/clang-tidy")
    repository_ctx.symlink(repository_ctx.path(info["clangxx"]), "bin/clang++")
    repository_ctx.symlink(repository_ctx.path(info["llvm_config"]), "bin/llvm-config")
    repository_ctx.symlink(repository_ctx.path(info["include_dir"]), "include")
    repository_ctx.file("host_dynamic_libraries/.keep", "")
    for name in sorted(info["host_dynamic_libraries"].keys()):
        repository_ctx.symlink(
            repository_ctx.path(info["host_dynamic_libraries"][name]),
            "host_dynamic_libraries/" + name,
        )
    repository_ctx.file("clang-resource/.keep", "")
    repository_ctx.symlink(
        repository_ctx.path(info["resource_include_dir"]),
        "clang-resource/include",
    )
    repository_ctx.file("BUILD.bazel", _LOCAL_BUILD)
    repository_ctx.file("config.bzl", _local_config(info))
    repository_ctx.file("clang_resource_overlay.yaml", _resource_overlay())

def _clang_tidy_llvm_repo_impl(repository_ctx):
    mode = repository_ctx.getenv("IREE_CLANG_TIDY_LLVM") or "none"
    if mode == "none" and repository_ctx.getenv("IREE_CLANG_TIDY_LLVM_CONFIG"):
        mode = "auto"
    if mode not in ["none", "auto"]:
        fail("Unknown IREE_CLANG_TIDY_LLVM '{}'. Available: none, auto.".format(mode))

    if mode == "none":
        _write_stub(repository_ctx)
        return

    llvm_config = _find_llvm_config(repository_ctx)
    if not llvm_config:
        fail("IREE_CLANG_TIDY_LLVM=auto could not find llvm-config. Set IREE_CLANG_TIDY_LLVM_CONFIG or IREE_CLANG_TIDY_LLVM_ROOT.")

    llvm_config = _canonical_path(
        repository_ctx,
        llvm_config,
        "llvm-config",
    )
    loader_environment = elf_loader_environment()

    version = _execute(
        repository_ctx,
        [llvm_config, "--version"],
        "query LLVM version",
        loader_environment,
    )
    version_suffix = version.split(".")[0]
    info = {
        "bindir": _canonical_path(
            repository_ctx,
            _execute(repository_ctx, [llvm_config, "--bindir"], "query LLVM binary directory", loader_environment),
            "LLVM binary directory",
        ),
        "copts": _filtered_copts(_execute(repository_ctx, [llvm_config, "--cxxflags"], "query LLVM C++ flags", loader_environment)),
        "has_rtti": _execute(repository_ctx, [llvm_config, "--has-rtti"], "query LLVM RTTI mode", loader_environment),
        "include_dir": _canonical_path(
            repository_ctx,
            _execute(repository_ctx, [llvm_config, "--includedir"], "query LLVM include directory", loader_environment),
            "LLVM include directory",
        ),
        "llvm_config": llvm_config,
        "version": version,
    }
    info["clang_tidy"] = _required_tool(
        repository_ctx,
        info["bindir"],
        ["clang-tidy", "clang-tidy-" + version_suffix],
        "clang-tidy",
    )
    info["clangxx"] = _required_tool(
        repository_ctx,
        info["bindir"],
        ["clang++", "clang++-" + version_suffix],
        "clang++",
    )
    info["resource_dir"] = _canonical_path(
        repository_ctx,
        _execute(
            repository_ctx,
            [info["clangxx"], "-print-resource-dir"],
            "query Clang resource directory",
            loader_environment,
        ),
        "Clang resource directory",
    )
    info["resource_include_dir"] = _canonical_path(
        repository_ctx,
        _join_path(info["resource_dir"], "include"),
        "Clang resource include directory",
    )
    info["host_dynamic_libraries"] = resolve_elf_dynamic_library_closure(
        repository_ctx,
        {
            "clang++": info["clangxx"],
            "clang-tidy": info["clang_tidy"],
            "llvm-config": info["llvm_config"],
        },
    )
    _write_local(repository_ctx, info)

clang_tidy_llvm_repo = repository_rule(
    implementation = _clang_tidy_llvm_repo_impl,
    environ = [
        "IREE_CLANG_TIDY_LLVM",
        "IREE_CLANG_TIDY_LLVM_CONFIG",
        "IREE_CLANG_TIDY_LLVM_ROOT",
        "IREE_LLVM_ROOT",
        "LLVM_CONFIG",
        "LLVM_ROOT",
        "PATH",
    ],
    doc = "Exposes an optional LLVM install for IREE clang-tidy plugin builds.",
)
