load("@iree_clang_tidy_llvm//:config.bzl", "CLANG_TIDY_LLVM_COPTS", "CLANG_TIDY_LLVM_TARGET_COMPATIBLE_WITH")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load(":clang_tidy.bzl", "iree_clang_tidy", "iree_recursion_analysis")

package(default_visibility = ["//visibility:public"])

_CLANG_TIDY_TEST_ARGS = select({
    "@platforms//os:windows": [
        "--clang-tidy=$(location :iree-clang-tidy)",
    ],
    "//conditions:default": [
        "--clang-tidy=$(location @iree_clang_tidy_llvm//:clang-tidy)",
        "--plugin=$(location :IREEClangTidyPlugin.so)",
    ],
})

_CLANG_TIDY_TEST_DATA = select({
    "@platforms//os:windows": [":iree-clang-tidy"],
    "//conditions:default": [
        ":IREEClangTidyPlugin.so",
        "@iree_clang_tidy_llvm//:clang-tidy",
    ],
})

_WINDOWS_MSVC_ANALYZER_COPTS = select({
    "//build_tools/bazel:cc_compiler_msvc": [
        "/external:anglebrackets",
        "/external:W0",
        "/external:env:INCLUDE",
        "/external:Iexternal/+clang_tidy_llvm_repo+iree_clang_tidy_llvm/include",
        "/wd4244",
    ],
    "//conditions:default": [],
})

exports_files([
    "clang_tidy_config.yaml",
    "clang_tidy.bzl",
    "llvm_repo.bzl",
])

filegroup(
    name = "plugin_sources",
    srcs = glob([
        "iree/*.cc",
        "iree/*.h",
    ]),
)

filegroup(
    name = "cmake_project",
    srcs = [
        "CMakeLists.txt",
        "README.md",
        "aggregate_recursion_summaries.py",
        "clang_tidy_config.yaml",
        "iree_clang_tidy_main.cc",
        ":plugin_sources",
        ":testdata",
    ],
)

filegroup(
    name = "testdata",
    srcs = glob([
        "fixtures/*",
        "test/*",
    ]),
)

py_binary(
    name = "aggregate_recursion_summaries",
    srcs = ["aggregate_recursion_summaries.py"],
    main = "aggregate_recursion_summaries.py",
)

py_binary(
    name = "run_clang_tidy_action",
    srcs = ["run_clang_tidy_action.py"],
    main = "run_clang_tidy_action.py",
)

py_test(
    name = "aggregate_recursion_summaries_test",
    srcs = [
        "aggregate_recursion_summaries.py",
        "test/aggregate_recursion_summaries_test.py",
    ],
    imports = ["."],
    main = "test/aggregate_recursion_summaries_test.py",
)

cc_binary(
    name = "IREEClangTidyPlugin.so",
    srcs = [
        "iree/ExtentChecks.cc",
        "iree/ExtentChecks.h",
        "iree/IreeTidyModule.cc",
        "iree/LifecycleChecks.cc",
        "iree/LifecycleChecks.h",
        "iree/RecursionCheck.cc",
        "iree/RecursionCheck.h",
        "iree/RefCountChecks.cc",
        "iree/RefCountChecks.h",
        "iree/SmokeCheck.cc",
        "iree/SmokeCheck.h",
        "iree/StatusChecks.cc",
        "iree/StatusChecks.h",
        "iree/StyleChecks.cc",
        "iree/StyleChecks.h",
        "iree/TraceChecks.cc",
        "iree/TraceChecks.h",
    ],
    copts = CLANG_TIDY_LLVM_COPTS,
    includes = ["."],
    linkshared = True,
    tags = ["manual"],
    target_compatible_with = CLANG_TIDY_LLVM_TARGET_COMPATIBLE_WITH,
    deps = [
        "@iree_clang_tidy_llvm//:llvm_headers",
    ],
)

cc_binary(
    name = "iree-clang-tidy",
    srcs = [
        "iree_clang_tidy_main.cc",
        ":plugin_sources",
    ],
    copts = CLANG_TIDY_LLVM_COPTS + _WINDOWS_MSVC_ANALYZER_COPTS,
    defines = [
        "CLANG_BUILD_STATIC",
        "_HAS_EXCEPTIONS=0",
    ],
    features = ["static_link_msvcrt"],
    includes = ["."],
    linkopts = [
        "advapi32.lib",
        "ntdll.lib",
        "ole32.lib",
        "psapi.lib",
        "shell32.lib",
        "uuid.lib",
        "version.lib",
        "ws2_32.lib",
    ],
    tags = ["manual"],
    target_compatible_with = CLANG_TIDY_LLVM_TARGET_COMPATIBLE_WITH + select({
        "@platforms//os:windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "@iree_clang_tidy_llvm//:llvm_headers",
        "@iree_clang_tidy_llvm//:llvm_static_libraries",
    ],
)

alias(
    name = "clang-tidy-tool",
    actual = select({
        "@platforms//os:windows": ":iree-clang-tidy",
        "//conditions:default": "@iree_clang_tidy_llvm//:clang-tidy",
    }),
)

