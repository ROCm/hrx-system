load("@rules_python//python:defs.bzl", "py_library", "py_test")

# Declarative loading is also used by CI to consume canonical run requirements.
py_library(
    name = "declarative_loads",
    srcs = ["bazel_to_cmake_loads.py"],
    visibility = ["//build_tools/devtools:__pkg__"],
)

exports_files(
    ["deps.py"],
    visibility = ["//build_tools/lefthook:__pkg__"],
)

py_library(
    name = "dependency_metadata",
    srcs = ["deps.py"],
    visibility = ["//build_tools/third_party:__pkg__"],
)

py_library(
    name = "converter",
    srcs = [
        "bazel_to_cmake_config.py",
        "bazel_to_cmake_converter.py",
        "bazel_to_cmake_generated.py",
        "bazel_to_cmake_loads.py",
        "bazel_to_cmake_requirements.py",
        "bazel_to_cmake_targets.py",
        "cc.py",
        "conditions.py",
        "loom_binary.py",
    ],
    visibility = ["//loom/build_tools/bazel_to_cmake:__pkg__"],
)

py_test(
    name = "bazel_to_cmake_test",
    srcs = [
        "bazel_to_cmake.py",
        "bazel_to_cmake_test.py",
    ],
    deps = [":converter"],
)

py_test(
    name = "bazel_to_cmake_loads_test",
    srcs = [
        "bazel_to_cmake_loads.py",
        "bazel_to_cmake_loads_test.py",
    ],
)

py_test(
    name = "config_test",
    srcs = ["config_test.py"],
    deps = [":converter"],
)

py_test(
    name = "deps_test",
    srcs = [
        "deps.py",
        "deps_test.py",
    ],
)
