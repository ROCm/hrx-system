load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//build_tools/bazel:cmake.bzl", "iree_cmake_extra_content")
load("//build_tools/bazel:generate.bzl", "iree_generated_sources")
load(":settings.bzl", "OPTIONS")

iree_generated_sources(
    name = "header",
    tool = "//package/producer:generator",
    srcs = ["//package/producer:value.h"],
    args = ["--input=$(location //package/producer:value.h)"],
    outs = ["generated.h"],
    output_args = {"generated.h": "--output={path}"},
    use_param_file = True,
)

iree_cmake_extra_content(
    content = """
iree_package_binary_dir(_IREE_PACKAGE_BINARY_DIR)
configure_file("${_IREE_PACKAGE_SOURCE_DIR}/value.c"
  "${_IREE_PACKAGE_BINARY_DIR}/value_from_generated_input_with_long_output_name.c"
  COPYONLY)
""",
    inline = True,
)

cc_library(
    name = "library_with_generated_inputs_and_package_identity",
    srcs = glob(["value*.c"], exclude = ["value.c"]) + [
        "value_from_generated_input_with_long_output_name.c",
    ],
    hdrs = ["generated.h"],
    defines = OPTIONS + ["ADJUSTMENT=0"],
    includes = ["."],
)

cc_test(
    name = "probe",
    srcs = ["main.c"],
    deps = [
        ":library_with_generated_inputs_and_package_identity",
        ":scoped_requirements",
    ],
)

cc_binary(
    name = "tool",
    srcs = ["main.c"],
    deps = [
        ":library_with_generated_inputs_and_package_identity",
        ":scoped_requirements",
    ],
)

# The provider's private native import remains owned by its authored directory.
cc_library(
    name = "scoped_requirements",
    data = [
        ":runtime_data",
        "//package/producer:generator.py",
        "//package/producer:value.h",
    ],
    deps = [
        ":registration",
        "//package/authored/child:requirements",
    ],
)

cc_library(
    name = "registration",
    srcs = ["registration.cc"],
    alwayslink = True,
    sanitizer_suppressions = {"lsan": "//:lsan_suppressions_leaf.txt"},
    deps = ["//external:suppressions"],
)

cc_library(
    name = "runtime_data",
    sanitizer_suppressions = {"lsan": "//:lsan_suppressions_data.txt"},
)
