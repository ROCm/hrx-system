# CMake configures the upstream library through zstd.cmake.
# bazel-to-cmake: skip

load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:private"])

cc_library(
    name = "zstd",
    hdrs = [
        "@zstd//:lib/zstd.h",
        "@zstd//:lib/zstd_errors.h",
    ],
    defines = ["IREE_HAVE_ZSTD=1"],
    visibility = ["//third_party:__pkg__"],
    deps = ["@zstd"],
)
