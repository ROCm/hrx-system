+def _find_gcc_linker_path(repository_ctx, cc, linker):
+    executable = "ld." + linker
+    result = repository_ctx.execute([cc, "-print-prog-name=" + executable])
+    if result.return_code == 0:
+        compiler_path = result.stdout.strip()
+        if compiler_path.startswith("/"):
+            return compiler_path
+        if compiler_path:
+            path = repository_ctx.which(compiler_path)
+            if path:
+                return str(path)
+    path = repository_ctx.which(executable)
+    return str(path) if path else None
