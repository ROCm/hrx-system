+  [[nodiscard]] auto isDependentInitializer(ExpressionAST* initializer) -> bool {
+    for (auto visit = activeInitializer; visit; visit = visit->previous) {
+      // The active visit still checks the initializer's other operands. A back
+      // edge adds no dependence and does not cache a result for the symbol.
+      if (visit->initializer == initializer) return false;
+    }
+    const InitializerVisit visit{initializer, activeInitializer};
+    activeInitializer = &visit;
+    const auto dependent = isDependent(initializer);
+    activeInitializer = visit.previous;
+    return dependent;
   }

