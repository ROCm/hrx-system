+void ASTInterpreter::interpretVariable(VariableSymbol* var,
+                                       ExpressionAST* initializer) {
+  if (!var || aborted_) return;
+
+  if (traits.is_reference(var->type())) {
+    auto initExpr = Initializer{initializer}.clause();
+    if (auto slot = lvalue(initExpr)) {
+      bindReference(var, slot);
+    } else {
+      aborted_ = true;
+    }
+    return;
+  }
+
+  ExpressionResult initVal;
+  if (var->constructor() &&
+      !ast_cast<ConstExpressionAST>(Initializer{initializer}.clause())) {
+    initVal = evaluateConstructorFromExprs(
+        var->constructor(), var->type(), Initializer{initializer}.arguments());
+  } else {
+    initVal = expression(initializer);
+  }
+
+  if (!initVal.has_value() && !initializer) {
+    initVal = defaultConstruct(var->type());
+  }
+
+  if (initVal.has_value()) {
+    if (traits.is_class(traits.remove_cv(var->type())))
+      initVal = cloneValue(*initVal);
+    setLocal(var, *initVal);
+    registerAutomaticObject(var);
+  } else {
+    aborted_ = true;
+  }
