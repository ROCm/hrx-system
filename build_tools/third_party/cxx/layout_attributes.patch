+namespace {
+
+// These spellings affect object layout, but neither declaration binding nor
+// record layout implements their semantics. Reject them before attributes can
+// be discarded by type projection or speculative declaration parsing.
+void rejectUnsupportedLayoutAttributes(TranslationUnit* unit,
+                                       AttributeSpecifierAST* specifier) {
+  static constexpr AttributeSpelling spellings[] = {
+      {AttributeSyntax::kGnu, "", "packed"},
+      {AttributeSyntax::kGnu, "", "aligned"},
+      {AttributeSyntax::kCxx, "gnu", "packed"},
+      {AttributeSyntax::kCxx, "gnu", "aligned"},
+  };
+  List<AttributeSpecifierAST*> attributes{specifier};
+  if (auto attribute = findAttributeBySpelling(unit, &attributes, spellings)) {
+    unit->error(attribute.location,
+                std::format("layout attribute '{}' is not supported",
+                            attribute.spelling->name));
+  }
+}
+
+}  // namespace
