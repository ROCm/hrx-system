# CMake assembles the same pinned C API through rocjitsu.cmake.
# bazel-to-cmake: skip

load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//build_tools/bazel:cc.bzl", "iree_cc_binary")
load("//build_tools/bazel:cc_test.bzl", "iree_cc_test")

package(default_visibility = ["//visibility:private"])

exports_files(["runtime.bzl"])

iree_cc_binary(
    name = "launcher",
    srcs = ["launcher.c"],
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    visibility = ["//visibility:public"],
)

copy_file(
    name = "_rj_compiler",
    src = "@rocjitsu_rj_compiler_header//file:rocjitsu/base/rj_compiler.h",
    out = "include/rocjitsu/base/rj_compiler.h",
    tags = ["manual"],
)

copy_file(
    name = "_rj_status",
    src = "@rocjitsu_rj_status_header//file:rocjitsu/base/rj_status.h",
    out = "include/rocjitsu/base/rj_status.h",
    tags = ["manual"],
)

copy_file(
    name = "_rj_version",
    src = "@rocjitsu_rj_version_header//file:rocjitsu/base/rj_version.h",
    out = "include/rocjitsu/base/rj_version.h",
    tags = ["manual"],
)

copy_file(
    name = "_rj_vm",
    src = "@rocjitsu_rj_vm_header//file:rocjitsu/vm/rj_vm.h",
    out = "include/rocjitsu/vm/rj_vm.h",
    tags = ["manual"],
)

copy_file(
    name = "_rj_vm_config",
    src = "@rocjitsu_rj_vm_config_header//file:rocjitsu/vm/rj_vm_config.h",
    out = "include/rocjitsu/vm/rj_vm_config.h",
    tags = ["manual"],
)

cc_library(
    name = "headers",
    hdrs = [
        ":_rj_compiler",
        ":_rj_status",
        ":_rj_version",
        ":_rj_vm",
        ":_rj_vm_config",
    ],
    includes = ["include"],
    tags = ["manual"],
    visibility = ["//third_party:__pkg__"],
)

iree_cc_test(
    name = "runtime_test",
    srcs = ["runtime_test.cc"],
    args = ["$(rootpath @rocjitsu_runtime//:lib/librocjitsu.so)"],
    data = [
        "@rocjitsu_runtime//:lib/librocjitsu.so",
        "@rocjitsu_runtime//:runtime",
    ],
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    deps = [
        ":headers",
        "//build_tools/bazel:dl",
        "//build_tools/bazel:pthreads",
        "//third_party:google_test",
    ],
)
