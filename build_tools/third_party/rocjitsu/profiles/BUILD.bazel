# Runtime-only simulator configurations have no CMake target surface.
# bazel-to-cmake: skip

load("//build_tools/third_party/rocjitsu:profiles.bzl", "ROCJITSU_PROFILES")

package(default_visibility = ["//visibility:public"])

exports_files([
    "gfx942_two_gpu.json",
    "gfx950_two_gpu.json",
    "gfx1100_four_gpu.json",
    "gfx1151_four_gpu.json",
    "gfx1201_four_gpu.json",
    "gfx1250_two_gpu.json",
])

[
    config_setting(
        name = profile + "_selected",
        flag_values = {
            "//build_tools/bazel:gpu_execution": "rocjitsu",
            "//build_tools/bazel:rocjitsu_profiles": profile,
        },
    )
    for profile in ROCJITSU_PROFILES
]
