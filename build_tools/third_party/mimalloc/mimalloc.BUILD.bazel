load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "mimalloc",
    srcs = ["src/static.c"],
    hdrs = glob(["include/**/*.h"]),
    copts = select({
        "@platforms//os:windows": [],
        "//conditions:default": ["-ftls-model=initial-exec"],
    }),
    defines = ["MI_STATIC_LIB=1"],
    features = [
        "-thin_lto",
        "-thin_lto_link",
    ],
    includes = ["include"],
    linkopts = select({
        "@platforms//os:windows": [
            "/DEFAULTLIB:advapi32.lib",
            "/DEFAULTLIB:bcrypt.lib",
            "/DEFAULTLIB:psapi.lib",
            "/DEFAULTLIB:shell32.lib",
            "/DEFAULTLIB:user32.lib",
        ],
        "//conditions:default": [],
    }),
    local_defines = ["MI_DEFAULT_ARENA_EAGER_COMMIT=0"],
    target_compatible_with = select({
        "@hrx//build_tools/bazel:sanitizer_enabled": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    textual_hdrs = glob(
        [
            "src/**/*.c",
            "src/**/*.h",
        ],
        exclude = ["src/static.c"],
    ),
    deps = [
        "@hrx//build_tools/bazel:pthreads",
        "@hrx//build_tools/bazel:rt",
    ],
)
