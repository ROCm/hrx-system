# CMake configures the pinned source through mimalloc.cmake.
# bazel-to-cmake: skip

load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:private"])

exports_files([
    "c_new_handler.patch",
    "mimalloc.BUILD.bazel",
])

cc_library(
    name = "new_delete",
    srcs = ["new_delete.cc"],
    copts = select({
        "@platforms//os:windows": ["/EHsc"],
        "//conditions:default": ["-fexceptions"],
    }),
    features = [
        "-thin_lto",
        "-thin_lto_link",
    ],
    visibility = ["//third_party:__pkg__"],
    deps = ["@mimalloc"],
)
