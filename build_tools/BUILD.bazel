# bazel-to-cmake: skip
# CMake consumers map these Bazel-only support labels directly in
# build_tools/bazel_to_cmake/bazel_to_cmake_targets.py.

load("@rules_python//python:defs.bzl", "py_test")
load("//build_tools/bazel:cc.bzl", "iree_cc_library")
load("//build_tools/bazel:cc_link.bzl", "cc_link")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

iree_cc_library(
    name = "pthreads",
    linkopts = cc_link.pthreads_linkopts(),
)

iree_cc_library(
    name = "dl",
    linkopts = cc_link.dl_linkopts(),
)

iree_cc_library(
    name = "rt",
    linkopts = cc_link.rt_linkopts(),
)

py_test(
    name = "ci_core_linux_test",
    srcs = [
        "ci_core_common.py",
        "ci_core_linux.py",
        "ci_core_linux_test.py",
    ],
    main = "ci_core_linux_test.py",
    deps = ["//build_tools/devtools"],
)

py_test(
    name = "ci_core_windows_test",
    srcs = [
        "ci_core_common.py",
        "ci_core_windows.py",
        "ci_core_windows_test.py",
    ],
    main = "ci_core_windows_test.py",
)

py_test(
    name = "cmake_data_dependencies_test",
    srcs = ["cmake_data_dependencies_test.py"],
    data = [
        "cmake/iree_macros.cmake",
        "cmake/testdata/data_dependencies/CMakeLists.txt",
        "cmake/testdata/data_dependencies/fixture.txt",
        "cmake/testdata/data_dependencies/tool.c",
    ],
)

py_test(
    name = "cmake_test_metadata_test",
    srcs = ["cmake_test_metadata_test.py"],
    data = [
        "cmake/iree_configure_testing.cmake",
        "cmake/iree_macros.cmake",
        "cmake/testdata/test_metadata/CMakeLists.txt",
    ],
)

py_test(
    name = "msvc_response_file_test",
    srcs = [
        "msvc_response_file.py",
        "msvc_response_file_test.py",
    ],
    main = "msvc_response_file_test.py",
)

filegroup(
    name = "cmake_test_metadata_fixture",
    srcs = [
        "cmake/empty_file",
        "cmake/iree_configure_testing.cmake",
        "cmake/iree_macros.cmake",
        "cmake/testdata/test_metadata/CMakeLists.txt",
    ],
    visibility = ["//build_tools/devtools:__pkg__"],
)
