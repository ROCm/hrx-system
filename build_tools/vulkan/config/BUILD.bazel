# CMake API options are declared in ../vulkan.cmake.
# bazel-to-cmake: skip

load("@bazel_skylib//lib:selects.bzl", "selects")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "configure",
    srcs = ["configure.py"],
    deps = ["//build_tools/bazel:configure_api"],
)

bool_flag(
    name = "enabled",
    build_setting_default = True,
)

config_setting(
    name = "enabled_setting",
    flag_values = {":enabled": "true"},
)

# The HAL is a Vulkan client; raw API selection does not enable the HAL.
selects.config_setting_group(
    name = "available",
    match_any = [
        ":enabled_setting",
        "//runtime/config/hal:driver_vulkan",
    ],
)
