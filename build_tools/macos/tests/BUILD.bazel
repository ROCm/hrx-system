# These tests exercise Bazel toolchain actions and execution transitions.
# bazel-to-cmake: skip

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_cc//cc:objc_library.bzl", "objc_library")
load("//build_tools/embed_data:build_defs.bzl", "iree_c_embed_data")

package(default_testonly = True)

# This is a real host-built generator producing C for the destination compiler.
iree_c_embed_data(
    name = "shader",
    srcs = ["transform.metal"],
    c_file_output = "shader.c",
    h_file_output = "shader.h",
    identifier = "iree_macos_test_shader",
    target_compatible_with = ["@platforms//os:macos"],
)

objc_library(
    name = "shader_library",
    srcs = ["shader_library.m"],
    hdrs = ["shader_library.h"],
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        ":shader",
        "@iree_macos_toolchain//:Foundation",
        "@iree_macos_toolchain//:Metal",
    ],
)

objc_library(
    name = "metal_test_main",
    srcs = ["metal_test.mm"],
    copts = ["-std=c++20"],
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        ":shader_library",
        "//runtime/src/iree/testing:gtest",
        # Apple's command-line default-device API requires CoreGraphics.
        "@iree_macos_toolchain//:CoreGraphics",
    ],
    alwayslink = True,
)

cc_test(
    name = "metal_test",
    size = "small",
    linkstatic = True,
    # Execution requires a physical Mac with a Metal device.
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        ":metal_test_main",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

cc_library(
    name = "shader_data",
    srcs = ["shader_data.c"],
    hdrs = ["shader_data.h"],
    target_compatible_with = ["@platforms//os:macos"],
    deps = [":shader"],
)

cc_test(
    name = "dynamic_link_test",
    size = "small",
    srcs = ["dynamic_link_test.c"],
    linkstatic = False,
    target_compatible_with = ["@platforms//os:macos"],
    deps = [":shader_data"],
)
