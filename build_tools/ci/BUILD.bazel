# CI orchestration has no CMake target surface.
# bazel-to-cmake: skip

load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

py_binary(
    name = "prepare_llvm_dwp",
    srcs = ["prepare_llvm_dwp.py"],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
)

py_test(
    name = "prepare_llvm_dwp_test",
    size = "small",
    srcs = [
        "prepare_llvm_dwp.py",
        "prepare_llvm_dwp_test.py",
    ],
    main = "prepare_llvm_dwp_test.py",
    target_compatible_with = ["@platforms//os:linux"],
)

py_library(
    name = "windows_file_access",
    srcs = ["windows_file_access.py"],
)

py_library(
    name = "windows_diagnostics",
    srcs = ["windows_diagnostics.py"],
    visibility = ["//visibility:public"],
    deps = [":windows_file_access"],
)

py_test(
    name = "windows_diagnostics_test",
    size = "small",
    srcs = ["windows_diagnostics_test.py"],
    deps = [":windows_diagnostics"],
)

py_test(
    name = "windows_file_access_test",
    size = "small",
    srcs = ["windows_file_access_test.py"],
    deps = [":windows_diagnostics"],
)

py_test(
    name = "rocm_environment_test",
    size = "small",
    srcs = [
        "rocm_environment.py",
        "rocm_environment_test.py",
    ],
    main = "rocm_environment_test.py",
    # The changed-path-aware Linux presubmit owns these hardware-free checks.
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
)

py_test(
    name = "vulkan_environment_test",
    size = "small",
    srcs = [
        "vulkan_environment.py",
        "vulkan_environment_test.py",
    ],
    main = "vulkan_environment_test.py",
    # The changed-path-aware Linux presubmit owns these hardware-free checks.
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
)

py_test(
    name = "ci_core_common_test",
    srcs = [
        "ci_core_common.py",
        "ci_core_common_test.py",
        "ci_core_linux.py",
        "ci_core_windows.py",
    ],
    main = "ci_core_common_test.py",
