include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/loom_module.cmake")

function(_loom_cxx_quote_option OUTPUT VALUE)
  string(REPLACE "\\" "\\\\" _QUOTED "${VALUE}")
  string(REPLACE "'" "\\'" _QUOTED "${_QUOTED}")
  # Keep literal separators out of configure-time lists. The final command
  # evaluates them only after joining the complete option string.
  string(REPLACE ";" "$<SEMICOLON>" _QUOTED "${_QUOTED}")
  set(${OUTPUT} "'${_QUOTED}'" PARENT_SCOPE)
endfunction()

# C++ owns header/configuration propagation; Loom linking sees only modules.
# Interface properties are resolved with the module graph after all packages
# have registered their declarations, including forward dependency references.
function(loom_cxx_library)
  cmake_parse_arguments(PARSE_ARGV 0 _RULE "TESTONLY" "NAME;COMPONENT"
    "SRCS;HDRS;LIBRARIES;COPTS;DEFINES;LOCAL_DEFINES;INCLUDES;DATA")
  if(_RULE_TESTONLY AND NOT IREE_BUILD_TESTS)
    return()
  endif()
  if(_RULE_UNPARSED_ARGUMENTS)
    message(FATAL_ERROR "Unknown loom_cxx_library arguments: ${_RULE_UNPARSED_ARGUMENTS}")
  endif()
  if(NOT _RULE_NAME OR NOT (_RULE_SRCS OR _RULE_HDRS OR _RULE_LIBRARIES))
    message(FATAL_ERROR "loom_cxx_library requires NAME and sources, public headers, or dependencies")
  endif()
  iree_package_name(_PACKAGE_NAME)
  iree_package_source_dir(_SOURCE_DIRECTORY)
  iree_package_binary_dir(_BINARY_DIRECTORY)
  set(_TARGET "${_PACKAGE_NAME}_${_RULE_NAME}")
  if(NOT _RULE_COMPONENT)
    iree_package_path(_PACKAGE_PATH)
    set(_RULE_COMPONENT "//${_PACKAGE_PATH}:${_RULE_NAME}")
  endif()
  set(CMAKE_ADD_CUSTOM_COMMAND_DEPENDS_EXPLICIT_ONLY ON)
  _loom_link_input_paths(_INPUTS _INPUT_TARGETS _INPUT_FILES ${_RULE_SRCS})
  _loom_link_input_paths(_HEADERS _HEADER_TARGETS _HEADER_FILES ${_RULE_HDRS})
  set(_SOURCES)
  set(_PRIVATE_HEADERS)
  foreach(_INPUT IN LISTS _INPUTS)
    if(_INPUT MATCHES "\\.(h|hh|hpp|hxx|inc|inl|ipp|tcc|def)$")
      list(APPEND _PRIVATE_HEADERS "${_INPUT}")
    else()
      list(APPEND _SOURCES "${_INPUT}")
    endif()
  endforeach()
  if(NOT (_SOURCES OR _RULE_HDRS OR _RULE_LIBRARIES))
    message(FATAL_ERROR "loom_cxx_library requires translation units, public headers, or dependencies")
  endif()
  set(_LOCAL_OPTIONS)
  foreach(_OPTION IN LISTS _RULE_COPTS)
    _loom_cxx_quote_option(_QUOTED "${_OPTION}")
    list(APPEND _LOCAL_OPTIONS "${_QUOTED}")
  endforeach()
  set(_DEFINE_OPTIONS)
  foreach(_DEFINE IN LISTS _RULE_DEFINES)
    _loom_cxx_quote_option(_QUOTED "D=${_DEFINE}")
    list(APPEND _DEFINE_OPTIONS "${_QUOTED}")
  endforeach()
  set(_LOCAL_DEFINE_OPTIONS)
  foreach(_DEFINE IN LISTS _RULE_LOCAL_DEFINES)
    _loom_cxx_quote_option(_QUOTED "D=${_DEFINE}")
    list(APPEND _LOCAL_DEFINE_OPTIONS "${_QUOTED}")
  endforeach()
  set(_DIRECTORIES "${PROJECT_SOURCE_DIR}" "${PROJECT_BINARY_DIR}")
  foreach(_INCLUDE IN LISTS _RULE_INCLUDES)
    if(IS_ABSOLUTE "${_INCLUDE}")
      message(FATAL_ERROR "loom_cxx_library INCLUDES must be package-relative: ${_INCLUDE}")
    endif()
    cmake_path(IS_PREFIX PROJECT_SOURCE_DIR "${_SOURCE_DIRECTORY}/${_INCLUDE}" NORMALIZE _CONTAINED)
    if(NOT _CONTAINED)
      message(FATAL_ERROR "loom_cxx_library include directory escapes its repository: ${_INCLUDE}")
    endif()
    list(APPEND _DIRECTORIES "${_SOURCE_DIRECTORY}/${_INCLUDE}" "${_BINARY_DIRECTORY}/${_INCLUDE}")
  endforeach()
  set(_INCLUDE_OPTIONS)
  foreach(_DIRECTORY IN LISTS _DIRECTORIES)
    cmake_path(NORMAL_PATH _DIRECTORY)
    _loom_cxx_quote_option(_QUOTED "I=${_DIRECTORY}")
    list(APPEND _INCLUDE_OPTIONS "${_QUOTED}")
  endforeach()
  set(_PUBLIC_HEADERS "$<TARGET_PROPERTY:${_TARGET},LOOM_CXX_HEADERS>")
  string(JOIN " " _LOCAL_OPTIONS ${_LOCAL_OPTIONS})
  string(JOIN " " _LOCAL_DEFINE_OPTIONS ${_LOCAL_DEFINE_OPTIONS})
  set(_OPTIONS "${_LOCAL_OPTIONS} $<GENEX_EVAL:$<TARGET_PROPERTY:${_TARGET},LOOM_CXX_OPTIONS>> ${_LOCAL_DEFINE_OPTIONS}")
  set(_IMPORTS)
  set(_ORDINAL 0)
  if(_SOURCES)
    _loom_host_tool(_IMPORT_TOOL loom-import-cxx)
    file(MAKE_DIRECTORY "${_BINARY_DIRECTORY}/${_RULE_NAME}.imports")
  endif()
  foreach(_SOURCE IN LISTS _SOURCES)
    cmake_path(GET _SOURCE FILENAME _SOURCE_NAME)
    set(_OUTPUT "${_BINARY_DIRECTORY}/${_RULE_NAME}.imports/${_ORDINAL}-${_SOURCE_NAME}.loombc")
    add_custom_command(
      OUTPUT "${_OUTPUT}"
      COMMAND "${_IMPORT_TOOL}" "${_SOURCE}" --to=bc "--output=${_OUTPUT}"
        "--module-name=${_RULE_COMPONENT}/unit${_ORDINAL}"
        "--strip-debug=$<IF:$<CONFIG:Debug>,false,true>"
        "--options=${_OPTIONS}"
      DEPENDS "${_IMPORT_TOOL}" "${_SOURCE}" ${_PRIVATE_HEADERS} "${_PUBLIC_HEADERS}"
      COMMENT "Importing C/C++ source ${_SOURCE_NAME}"
      VERBATIM
    )
    list(APPEND _IMPORTS "${_OUTPUT}")
    math(EXPR _ORDINAL "${_ORDINAL} + 1")
  endforeach()
  if(_IMPORTS)
    loom_module(NAME "${_RULE_NAME}" SRCS ${_IMPORTS}
      LIBRARIES ${_RULE_LIBRARIES} DATA ${_RULE_DATA}
      COMPONENT "${_RULE_COMPONENT}" MODE merge OUTPUT_FORMAT bc STRICT_DEPS)
  else()
    _loom_link_input_paths(_LIBRARY_PATHS _LIBRARY_TARGETS _LIBRARY_FILES ${_RULE_LIBRARIES})
    add_custom_target("${_TARGET}")
    set_property(TARGET "${_TARGET}" PROPERTY LOOM_MODULE_LIBRARY_TARGETS "${_LIBRARY_TARGETS}")
    set_property(TARGET "${_TARGET}" PROPERTY LOOM_MODULE_LIBRARY_FILES "${_LIBRARY_FILES}")
    set_property(TARGET "${_TARGET}" PROPERTY LOOM_MODULE_DIRECT_DATA "${_RULE_DATA}")
    set_property(GLOBAL APPEND PROPERTY LOOM_MODULE_TARGETS "${_TARGET}")
    foreach(_DEPENDENCY IN LISTS _LIBRARY_TARGETS)
      iree_register_target_dependency(TARGET "${_TARGET}" DEPENDENCY "${_DEPENDENCY}")
    endforeach()
  endif()
  set_property(TARGET "${_TARGET}" PROPERTY LOOM_CXX_DIRECT_HEADERS "${_HEADERS}")
  set_property(TARGET "${_TARGET}" PROPERTY LOOM_CXX_DIRECT_INCLUDE_OPTIONS "${_INCLUDE_OPTIONS}")
  set_property(TARGET "${_TARGET}" PROPERTY LOOM_CXX_DIRECT_DEFINE_OPTIONS "${_DEFINE_OPTIONS}")
  foreach(_INPUT IN LISTS _HEADERS _PRIVATE_HEADERS)
    iree_generated_output_add_consumer("${_INPUT}" "${_TARGET}")
  endforeach()
endfunction()
