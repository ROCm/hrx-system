# bazel-to-cmake: skip

load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//build_tools/bazel:executable.bzl", "iree_executable_test")
load(
    "//loom/build_tools/bazel:defs.bzl",
    "loom_amdgpu_target_profile",
    "loom_kernel_binary",
    "loom_kernel_library",
    "loom_library",
    "loom_module",
    "loom_test_library",
)
load("//loom/build_tools/bazel:loom_check.bzl", "loom_check_test")
load(
    ":loom_binary_rules_test.bzl",
    "loom_binary_rules_test_suite",
    "test_target_profile",
)
load(":loom_check_rules_test.bzl", "loom_check_rules_test_suite")
load(
    ":loom_library_rules_test.bzl",
    "REFERENCE_PROFILE",
    "SERIALIZED_REFERENCE_PROFILE",
    "loom_library_rules_test_suite",
)
load(
    ":loom_target_profile_rules_test.bzl",
    "loom_target_profile_rules_test_suite",
)

package(default_visibility = ["//visibility:public"])

loom_amdgpu_target_profile(
    name = "test_amdgpu_profile",
    target = "gfx942",
)

test_target_profile(
    name = "test_spirv_profile",
    family = "spirv",
)

loom_kernel_library(
    name = "public_kernel_library",
    srcs = [
        "link_checks.loom",
        "link_kernels.loom",
    ],
    targets = ["//loom/target/amdgpu:gfx11-generic"],
)

loom_library(
    name = "library_dependency",
    srcs = ["link_kernels.loom"],
    tags = ["manual"],
)

loom_kernel_binary(
    name = "kernel_binary_deps",
    tags = ["manual"],
    target = "//loom/target/amdgpu:gfx11-generic",
    deps = [":public_kernel_library"],
)

loom_kernel_binary(
    name = "kernel_binary_srcs",
    srcs = ["link_kernels.loom"],
    tags = ["manual"],
    target = "//loom/target/amdgpu:gfx11-generic",
)

loom_kernel_binary(
    name = "kernel_binary_mixed",
    srcs = ["link_checks.loom"],
    configs = {
        "a.value": "1",
        "z.value": "2",
    },
    tags = ["manual"],
    target = "//loom/target/amdgpu:gfx11-generic",
    deps = [":library_dependency"],
)

loom_kernel_binary(
    name = "kernel_binary_explicit_root",
    roots = ["@scale"],
    tags = ["manual"],
    target = "//loom/target/amdgpu:gfx11-generic",
    deps = [":public_kernel_library"],
)

loom_library(
    name = "library_consumer",
    srcs = ["link_checks.loom"],
    tags = ["manual"],
    deps = [":library_dependency"],
)

loom_library(
    name = "library_aggregate",
    tags = ["manual"],
    deps = [":library_consumer"],
)

loom_library(
    name = "library_redundant_direct",
    srcs = ["link_checks.loom"],
    tags = ["manual"],
    deps = [
        ":library_consumer",
        ":library_dependency",
    ],
)

loom_library(
    name = "library_transitive_consumer",
    srcs = ["link_checks.loom"],
    tags = ["manual"],
    deps = [":library_aggregate"],
)

loom_test_library(
    name = "profiled_library",
    srcs = ["profile_cases.loom"],
    execution_profiles = [
        REFERENCE_PROFILE,
        SERIALIZED_REFERENCE_PROFILE,
    ],
    tags = ["manual"],
    deps = [":library_dependency"],
)

loom_check_test(
    name = "loom_check_wrapper_subject",
    src = "roundtrip.loom-test",
    runner = "loom_check_fixture_runner.sh",
    tags = ["manual"],
)

loom_check_rules_test_suite(name = "loom_check_rules_tests")

loom_library_rules_test_suite(name = "loom_library_rules_tests")

loom_binary_rules_test_suite(name = "loom_binary_rules_tests")

loom_target_profile_rules_test_suite(name = "loom_target_profile_rules_tests")

loom_module(
    name = "linked_module",
    srcs = ["link_checks.loom"],
    libraries = ["link_kernels.loom"],
)

iree_executable_test(
    name = "loom_module_direct_test",
    src = "//loom/src/loom/tools/loom-format",
    args = ["$(rootpath :linked_module)"],
    data = [":linked_module"],
)

iree_executable_test(
    name = "loom_library_module_direct_test",
    src = "//loom/src/loom/tools/loom-format",
    args = ["$(rootpath :library_consumer)"],
    data = [":library_consumer"],
)

iree_executable_test(
    name = "loom_library_aggregate_direct_test",
    src = "//loom/src/loom/tools/loom-format",
    args = ["$(rootpath :library_aggregate)"],
    data = [":library_aggregate"],
)

sh_test(
    name = "kernel_binary_direct_test",
    srcs = ["kernel_binary_direct_test.sh"],
    args = [
        "$(rootpath :kernel_binary_deps)",
        "$(rootpath :kernel_binary_deps_compile_report)",
    ],
    data = [
        ":kernel_binary_deps",
        ":kernel_binary_deps_compile_report",
    ],
)

filegroup(
    name = "kernel_binary_deps_compile_report",
    srcs = [":kernel_binary_deps"],
    output_group = "compile_reports",
)

filegroup(
    name = "kernel_binary_deps_linked_module",
    srcs = [":kernel_binary_deps"],
    output_group = "linked_modules",
)

iree_executable_test(
    name = "kernel_binary_linked_module_test",
    src = "//loom/src/loom/tools/loom-format",
    args = ["$(rootpath :kernel_binary_deps_linked_module)"],
    data = [":kernel_binary_deps_linked_module"],
)

sh_test(
    name = "loom_check_wrapper_direct_test",
    srcs = ["loom_check_wrapper_direct_test.sh"],
    args = ["$(rootpath :loom_check_wrapper_subject)"],
    data = [
        "loom_check_fixture_runner.sh",
        "roundtrip.loom-test",
        ":loom_check_wrapper_subject",
    ],
)

sh_test(
    name = "relocatable_library_direct_test",
    srcs = ["relocatable_library_direct_test.sh"],
    args = [
        "$(rootpath //loom/src/loom/tools/loom-link)",
        "$(rootpath //loom/src/loom/tools/loom-format)",
        "$(rootpath //loom/build_tools/bazel/test/testdata/relocatable_library:subject)",
        "$(rootpath //loom/build_tools/bazel/test/testdata/relocatable_library:dependency)",
        "$(rootpath //loom/build_tools/bazel/test/testdata/relocatable_library:duplicate_a.loom)",
        "$(rootpath //loom/build_tools/bazel/test/testdata/relocatable_library:duplicate_b.loom)",
    ],
    data = [
        "//loom/build_tools/bazel/test/testdata/relocatable_library:dependency",
        "//loom/build_tools/bazel/test/testdata/relocatable_library:duplicate_a.loom",
        "//loom/build_tools/bazel/test/testdata/relocatable_library:duplicate_b.loom",
        "//loom/build_tools/bazel/test/testdata/relocatable_library:subject",
        "//loom/src/loom/tools/loom-format",
        "//loom/src/loom/tools/loom-link",
    ],
)

test_suite(
    name = "test",
    tests = [
        ":kernel_binary_direct_test",
        ":kernel_binary_linked_module_test",
        ":loom_binary_rules_tests",
        ":loom_check_rules_tests",
        ":loom_check_wrapper_direct_test",
        ":loom_library_aggregate_direct_test",
        ":loom_library_module_direct_test",
        ":loom_library_rules_tests",
        ":loom_module_direct_test",
        ":loom_target_profile_rules_tests",
        ":profiled_library_execute_reference_test",
        ":profiled_library_plan_test",
        ":public_kernel_library_test",
        ":relocatable_library_direct_test",
        "//loom/build_tools/bazel/test/testdata/command_binary:test",
        "//loom/build_tools/bazel/test/testdata/kernel_binary:test",
        "//loom/build_tools/bazel/test/testdata/vm_binary:test",
    ],
)
