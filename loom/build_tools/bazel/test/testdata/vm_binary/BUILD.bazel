# bazel-to-cmake: skip

load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(
    "//loom/build_tools/bazel:defs.bzl",
    "loom_library",
    "loom_vm_binary",
)

package(default_visibility = ["//loom/build_tools/bazel/test:__pkg__"])

loom_library(
    name = "implementation",
    srcs = ["implementation.loom"],
    tags = ["manual"],
)

loom_library(
    name = "unused",
    srcs = ["unused.loom"],
    tags = ["manual"],
)

loom_library(
    name = "interface",
    srcs = ["interface.loom"],
    tags = ["manual"],
    deps = [
        ":implementation",
        ":unused",
    ],
)

loom_vm_binary(
    name = "deps_subject",
    tags = ["manual"],
    deps = [":interface"],
)

loom_vm_binary(
    name = "explicit_subject",
    roots = ["@double_once"],
    tags = ["manual"],
    deps = [":interface"],
)

loom_vm_binary(
    name = "srcs_subject",
    srcs = ["standalone.loom"],
    tags = ["manual"],
)

loom_vm_binary(
    name = "mixed_subject",
    srcs = ["interface.loom"],
    module_name = "mixed_runtime",
    tags = ["manual"],
    deps = [
        ":implementation",
        ":unused",
    ],
)

filegroup(
    name = "deps_subject_compile_report",
    srcs = [":deps_subject"],
    output_group = "compile_reports",
)

filegroup(
    name = "deps_subject_linked_module",
    srcs = [":deps_subject"],
    output_group = "linked_modules",
)

sh_test(
    name = "product_test",
    srcs = ["product_test.sh"],
    args = [
        "$(rootpath //loom/src/loom/tools/loom-format)",
        "$(rootpath //tools:iree-run-module)",
    ],
    data = [
        ":deps_subject",
        ":deps_subject_compile_report",
        ":deps_subject_linked_module",
        ":explicit_subject",
        ":mixed_subject",
        ":srcs_subject",
        "//loom/src/loom/tools/loom-format",
        "//tools:iree-run-module",
    ],
)

test_suite(
    name = "test",
    tests = [":product_test"],
)
