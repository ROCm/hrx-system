func.decl @support(%value: i32) -> (i32)

func.def public @entry(%value: i32) -> (i32) {
  %result = func.call @helper(%value) : (i32) -> (i32)
  func.return %result : i32
}

func.def @helper(%value: i32) -> (i32) {
  %result = func.call @support(%value) : (i32) -> (i32)
  func.return %result : i32
}
