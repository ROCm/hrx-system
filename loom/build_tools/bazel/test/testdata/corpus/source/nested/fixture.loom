func.def @supported() -> (i32) {
  %value = scalar.constant 42 : i32
  func.return %value : i32
}

func.def @unsupported() -> (i32) {
  %value = scalar.constant 72 : i32
  func.return %value : i32
}

check.scenario @fixture_scenario {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    check.compare<@supported>() : () -> [actual(%actual: i32), expected(%expected: i32)] {
      check.expect.equal actual(%actual) expected(%expected) : i32
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    check.compare<@unsupported>() : () -> [actual(%actual: i32), expected(%expected: i32)] {
      check.expect.equal actual(%actual) expected(%expected) : i32
    }
  }
  check.return
}
