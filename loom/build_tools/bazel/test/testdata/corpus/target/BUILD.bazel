load(
    "//loom/build_tools/bazel:defs.bzl",
    "loom_corpus_build",
    "loom_execution_profile",
    "loom_legacy_case_test",
    "loom_scenario_test",
    "loom_target_profile",
    "loom_target_set",
)
load(
    "//loom/build_tools/bazel/test/testdata/corpus:catalog.bzl",
    "TEST_CORPUS",
    "TEST_LEGACY_CASES",
    "TEST_SCENARIOS",
)

package(default_visibility = ["//visibility:public"])

loom_target_profile(
    name = "profile_a",
    family = "fake",
    selector = "a",
)

loom_target_profile(
    name = "profile_b",
    family = "fake",
    selector = "b",
)

loom_target_profile(
    name = "profile_c",
    family = "fake",
    selector = "c",
)

loom_target_set(
    name = "primary_profiles",
    targets = [
        ":profile_a",
        ":profile_b",
    ],
)

loom_target_set(
    name = "all_profiles",
    targets = [
        ":primary_profiles",
        ":profile_c",
    ],
)

loom_corpus_build(
    name = "all",
    all_roots_xfail = {
        ":profile_b": ["sample/other.loom"],
    },
    catalog = TEST_CORPUS,
    excludes = {
        ":all_profiles": {
            "sample/excluded.loom": "This fixture proves explicit whole-source exclusion.",
        },
        ":profile_c": {
            "sample/nested/fixture.loom": "Profile C deliberately exercises whole-file exclusion.",
            "sample/other.loom": "Profile C deliberately exercises whole-file exclusion.",
        },
    },
    profiles = [":all_profiles"],
    tags = ["manual"],
    xfails = {
        ":primary_profiles": {
            "sample/nested/fixture.loom:@unsupported_common": "TYPE/002",
        },
        ":profile_b": {
            "sample/nested/fixture.loom:@unsupported": "TARGET/072",
            "sample/nested/fixture.loom:@unsupported_other": "TYPE/001",
            "sample/other.loom:@other": "TARGET/033",
        },
    },
)

_EXECUTION_PROFILES = [
    loom_execution_profile(
        name = "reference",
        executor = "reference",
        runner_args = ["--max-samples-per-case=1"],
        target_class = "cpu",
        target_family = "test",
    ),
    loom_execution_profile(
        name = "selected_reference",
        executor = "reference",
        target_class = "cpu",
        target_family = "test",
    ),
]

loom_scenario_test(
    name = "scenario_execution",
    catalog = TEST_SCENARIOS,
    execution_profiles = _EXECUTION_PROFILES,
    tags = ["manual"],
    xfails = {
        "reference": {
            "sample/nested/fixture.loom:@fixture_scenario": "TARGET/003,EXPECT/003",
        },
    },
)

loom_legacy_case_test(
    name = "legacy_execution",
    allowed_failures = {
        "reference": {
            "sample/other.loom:@other_case": "TARGET/003,EXPECT/003",
        },
    },
    catalog = TEST_LEGACY_CASES,
    excludes = {
        "sample/excluded.loom": "This fixture is excluded from execution as well as compilation.",
    },
    execution_profiles = _EXECUTION_PROFILES,
    profile_sources = {
        "selected_reference": ["sample/other.loom"],
    },
    tags = ["manual"],
)
