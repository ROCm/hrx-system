# bazel-to-cmake: skip

load(":loom_toolchain.bzl", "loom_tools_toolchains")

package(default_visibility = ["//visibility:public"])

# The hosted test runner compiles reference VM and inner WebAssembly products
# but never opens a native HAL device. Keep that exact provider set in its WASI
# binary regardless of the developer's native build configuration.
platform(
    name = "loom_test_wasm32_wasi",
    constraint_values = [
        "@platforms//cpu:wasm32",
        "@platforms//os:wasi",
    ],
    flags = [
        "--//loom/config/execute:enable=",
        "--//loom/config/import:enable=",
        "--//loom/config/target:enable=vm,wasm",
        "--//runtime/config/hal:drivers=",
    ],
)

exports_files([
    "defs.bzl",
    "loom_binary.bzl",
    "loom_corpus_build.bzl",
    "loom_corpus_catalog.bzl",
    "loom_corpus_execution.bzl",
    "loom_library.bzl",
    "loom_linking.bzl",
    "loom_model.bzl",
    "loom_module.bzl",
    "loom_target_profile.bzl",
    "loom_toolchain.bzl",
])

toolchain_type(name = "benchmark_toolchain_type")

toolchain_type(name = "compile_toolchain_type")

toolchain_type(name = "format_toolchain_type")

toolchain_type(name = "lint_toolchain_type")

toolchain_type(name = "link_toolchain_type")

toolchain_type(name = "test_toolchain_type")

loom_tools_toolchains(
    name = "source_tools",
    benchmark_tool = "//loom/src/loom/tools/loom-benchmark",
    compile_tool = "//loom/src/loom/tools/loom-compile",
    format_tool = "//loom/src/loom/tools/loom-format",
    link_tool = "//loom/src/loom/tools/loom-link",
    lint_tool = "//loom/py/loom/tools:loom-lint",
    test_tool = "//loom/src/loom/tools/loom-test",
)
