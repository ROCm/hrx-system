load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_LOW_PASS_ENVIRONMENT_VISIBILITY = [
    "//loom/binding/c:implementation",
    "//loom/src/loom/codegen:__pkg__",
    "//loom/src/loom/codegen/low/testing:__pkg__",
    "//loom/src/loom/codegen/low/transforms:__pkg__",
    "//loom/src/loom/codegen/low/transforms/pipeline:__pkg__",
    "//loom/src/loom/pass:__pkg__",
    "//loom/src/loom/target/arch/amdgpu:__pkg__",
    "//loom/src/loom/target/arch/amdgpu/hal:__pkg__",
    "//loom/src/loom/target/arch/x86:__pkg__",
    "//loom/src/loom/transforms/cleanup:__pkg__",
    "//loom/src/loom/transforms/kernel:__pkg__",
    "//loom/src/loom/transforms/vector:__pkg__",
    "//loom/src/loom/tools/loom-check:__pkg__",
    "//loom/src/loom/tools/loom-opt:__pkg__",
]

_LOW_PIPELINE_VISIBILITY = [
    "//loom/src/loom/codegen/low/testing:__pkg__",
    "//loom/src/loom/target:__pkg__",
]

loom_cc_library(
    name = "legalizer_registry",
    srcs = ["legalizer_registry.c"],
    hdrs = ["legalizer_registry.h"],
    visibility = _LOW_PASS_ENVIRONMENT_VISIBILITY,
    deps = [
        "//loom/src/loom/target:legalization",
        "//loom/src/loom/transforms/buffer:target_legalization",
        "//loom/src/loom/transforms/conversion:target_legalization",
        "//loom/src/loom/transforms/index:target_legalization",
        "//loom/src/loom/transforms/kernel:target_legalization",
        "//loom/src/loom/transforms/math:legalize",
        "//loom/src/loom/transforms/scalar:target_legalization",
        "//loom/src/loom/transforms/scalar:wide_division_legalization",
        "//loom/src/loom/transforms/scf:lookup",
        "//loom/src/loom/transforms/vector:target_legalization",
        "//loom/src/loom/transforms/view:target_legalization",
        "//runtime/src/iree/base",
    ],
)

loom_cc_test(
    name = "legalizer_registry_test",
    srcs = ["legalizer_registry_test.cc"],
    deps = [
        ":legalizer_registry",
        "//loom/src/loom/ops/buffer",
        "//loom/src/loom/ops/index",
        "//loom/src/loom/ops/kernel",
        "//loom/src/loom/ops/scalar",
        "//loom/src/loom/ops/vector",
        "//loom/src/loom/ops/view",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "pass_environment",
    srcs = ["pass_environment.c"],
    hdrs = ["pass_environment.h"],
    visibility = _LOW_PASS_ENVIRONMENT_VISIBILITY,
    deps = [
        "//loom/src/loom/codegen/low:descriptors",
        "//loom/src/loom/codegen/low/lower",
        "//loom/src/loom/ir",
        "//loom/src/loom/pass:environment",
        "//loom/src/loom/pass:types",
        "//loom/src/loom/target:facts",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "pipeline",
    srcs = ["pipeline.c"],
    hdrs = ["pipeline.h"],
    visibility = _LOW_PIPELINE_VISIBILITY,
    deps = [
        "//loom/src/loom/pass:builder",
        "//runtime/src/iree/base",
    ],
)

loom_cc_test(
    name = "pipeline_test",
    srcs = ["pipeline_test.cc"],
    deps = [
        ":pipeline",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:op_registry",
        "//loom/src/loom/ops/pass",
        "//loom/src/loom/pass:builder",
        "//loom/src/loom/testing:module_ptr",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
