// RUN: emit low-allocation-json @entry test.i32=7

// Decomposing the invariant tuple reads the scalar seed on every header edge.
// Its semantic SSA use at the pre-loop concat does not describe that storage
// demand: the seed must survive the destructive body and the latch.
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @entry(%repeat: reg<test.i32>) -> (reg<test.i32 x4>) asm {
  %seed = test.const.i32 7
  %tuple = concat(%seed, %seed, %seed, %seed) : (reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>) -> reg<test.i32 x4>
  low.br ^header
^header:
  low.br ^body(%tuple: reg<test.i32 x4>)
^body(%state: reg<test.i32 x4>):
  %result = test.early_tied.v4i32 %state
  low.cond_br %repeat, ^latch, ^exit : reg<test.i32>
^latch:
  low.br ^header
^exit:
  return %result
}

