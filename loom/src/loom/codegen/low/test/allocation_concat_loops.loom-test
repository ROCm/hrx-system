// ====

// A repeated physical source cannot share a loop destination when it remains
// observable after the handoff, even though both destination units carry the
// same initial bits.
// RUN: emit low-allocation-json @retained_physical_broadcast test.i32=7
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @retained_physical_broadcast(%repeat: reg<test.i32>) -> (reg<test.explicit32 x2>, reg<test.explicit32>) asm {
  %seed = test.const.explicit32 7
  %tuple = concat(%seed, %seed) : (reg<test.explicit32>, reg<test.explicit32>) -> reg<test.explicit32 x2>
  low.br ^header(%tuple: reg<test.explicit32 x2>)
^header(%state: reg<test.explicit32 x2>):
  %later = copy %seed : reg<test.explicit32> -> reg<test.explicit32>
  %next_seed = test.const.explicit32 11
  %next = concat(%next_seed, %next_seed) : (reg<test.explicit32>, reg<test.explicit32>) -> reg<test.explicit32 x2>
  low.cond_br %repeat, ^latch, ^exit : reg<test.i32>
^latch:
  low.br ^header(%next: reg<test.explicit32 x2>)
^exit:
  return %state, %later
}

