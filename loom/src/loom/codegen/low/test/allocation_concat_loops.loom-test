// ====

// A one-source concat is legal and requires the scalar storage demand even
// when the function contains no multi-unit value.
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @entry(%repeat: reg<test.i32>) -> (reg<test.i32>) asm {
  %seed = test.const.i32 7
  %tuple = concat(%seed) : (reg<test.i32>) -> reg<test.i32>
  low.br ^header
^header:
  low.br ^body(%tuple: reg<test.i32>)
^body(%state: reg<test.i32>):
  %result = test.tied.any %state
  low.cond_br %repeat, ^latch, ^exit : reg<test.i32>
^latch:
  low.br ^header
^exit:
  return %result
}

