// ====

// Wide concat sources obey the same lifetime contract as scalar sources.
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @entry(%repeat: reg<test.i32>, %seed: reg<test.i32 x2>) -> (reg<test.i32 x4>) asm {
  %tuple = concat(%seed, %seed) : (reg<test.i32 x2>, reg<test.i32 x2>) -> reg<test.i32 x4>
  low.br ^header
^header:
  low.br ^body(%tuple: reg<test.i32 x4>)
^body(%state: reg<test.i32 x4>):
  %result = test.early_tied.v4i32 %state
  low.cond_br %repeat, ^latch, ^exit : reg<test.i32>
^latch:
  low.br ^header
^exit:
  return %result
}

