// ====

// Distinct invariant sources are retained independently. The seven-unit budget
// fits the condition, two seeds, and four-unit destination exactly; no second
// four-unit reservation may survive for the structural concat.
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @entry(%repeat: reg<test.i32>) -> (reg<test.i32 x4>) asm {
  %low = test.const.i32 7
  %high = test.const.i32 11
  %tuple = concat(%low, %high, %low, %high) : (reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>) -> reg<test.i32 x4>
  low.br ^header
^header:
  low.br ^body(%tuple: reg<test.i32 x4>)
^body(%state: reg<test.i32 x4>):
  %result = test.early_tied.v4i32 %state
  low.cond_br %repeat, ^latch, ^exit : reg<test.i32>
^latch:
  low.br ^header
^exit:
  return %result
}

