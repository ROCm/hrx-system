// Ordered physical views, not numeric base arithmetic, define aligned units.
// RUN: emit low-allocation-json @aligned_view diagnostics=placement-decisions fixed=%left:physical_register:0:1 fixed=%right:physical_register:2:1 fixed=%saved_left:physical_register:1:1 fixed=%saved_right:physical_register:3:1 fixed=%returned:physical_register:4:2 output=none

test.target<low_core> @target

low.func.def schedule(locked) target<test.low.core>(@target) @aligned_view(%left: reg<test.explicit32>, %right: reg<test.explicit32>) -> (reg<test.explicit32 x2>, reg<test.explicit32>, reg<test.explicit32>) asm {
  // REMARK@+1: BACKEND/043 {source_value_name="left", result_value_name="saved_left"}
  %saved_left = copy %left : reg<test.explicit32> -> reg<test.explicit32>
  // REMARK@+1: BACKEND/043 {source_value_name="right", result_value_name="saved_right"}
  %saved_right = copy %right : reg<test.explicit32> -> reg<test.explicit32>
  // REMARK@+2: BACKEND/043 {source_value_name="left", result_value_name="pair", source_unit_offset="0", result_unit_offset="0", unit_count="1"}
  // REMARK@+1: BACKEND/043 {source_value_name="right", result_value_name="pair", source_unit_offset="0", result_unit_offset="1", unit_count="1"}
  %pair = concat(%left, %right) : (reg<test.explicit32>, reg<test.explicit32>) -> reg<test.explicit32 x2>
  // REMARK@+1: BACKEND/043 {source_value_name="pair", result_value_name="returned"}
  low.br ^exit(%pair: reg<test.explicit32 x2>)
^exit(%returned: reg<test.explicit32 x2>):
  return %returned, %saved_left, %saved_right
}

// ====

// Equal aggregate storage is zero-copy only when logical units have the same
// order in both register classes.
// RUN: emit low-allocation-query @aligned_ordered_units copy-count values=%unit0,%unit1,%source,%result copies=%result fixed=%unit0:physical_register:0:1 fixed=%unit1:physical_register:2:1 fixed=%source:physical_register:4:2 fixed=%result:physical_register:4:2

test.target<low_core> @target

low.func.def schedule(locked) target<test.low.core>(@target) @aligned_ordered_units(%unit0: reg<test.explicit32>, %unit1: reg<test.explicit32>) -> (reg<test.packed.wide x2>) asm {
  %source = concat(%unit0, %unit1) : (reg<test.explicit32>, reg<test.explicit32>) -> reg<test.explicit32 x2>
  %result = copy %source : reg<test.explicit32 x2> -> reg<test.packed.wide x2>
  return %result
}

// ----
copies: coalesced=1 materialized=0
value %unit0: test.explicit32 -> physical_register[0:1]
value %unit1: test.explicit32 -> physical_register[2:1]
value %source: test.explicit32 -> physical_register[4:2]
value %result: test.packed.wide -> physical_register[4:2]
copy %source -> %result: coalesced

// ====

// The full aggregate has the same atomic footprint in both classes, but
// packed.wide orders the middle units as r2,r1 instead of r1,r2. The copy is a
// real permutation and cannot use q0 as a zero-copy alias.
// RUN: emit low-allocation-query @permuted_ordered_units failure copy-count values=%unit0,%unit1,%unit2,%unit3,%source,%result copies=%result fixed=%unit0:physical_register:0:1 fixed=%unit1:physical_register:1:1 fixed=%unit2:physical_register:2:1 fixed=%unit3:physical_register:3:1 fixed=%source:physical_register:6:4 fixed=%result:physical_register:6:4

test.target<low_core> @target

low.func.def schedule(locked) target<test.low.core>(@target) @permuted_ordered_units(%unit0: reg<test.explicit32>, %unit1: reg<test.explicit32>, %unit2: reg<test.explicit32>, %unit3: reg<test.explicit32>) -> (reg<test.packed.wide x4>) asm {
  %source = concat(%unit0, %unit1, %unit2, %unit3) : (reg<test.explicit32>, reg<test.explicit32>, reg<test.explicit32>, reg<test.explicit32>) -> reg<test.explicit32 x4>
  // ERROR@+1: BACKEND/005 {function_name="permuted_ordered_units", value_class="test.explicit32", budget="4", peak="1", failure_code="parallel-move-no-scratch-unit"}
  %result = copy %source : reg<test.explicit32 x4> -> reg<test.packed.wide x4>
  return %result
}

// ----
failure: parallel-move-no-scratch-unit kind=unknown class=test.explicit32 required=1 budget=4 peak=1
copies: coalesced=0 materialized=1
value %unit0: test.explicit32 -> physical_register[0:1]
value %unit1: test.explicit32 -> physical_register[1:1]
value %unit2: test.explicit32 -> physical_register[2:1]
value %unit3: test.explicit32 -> physical_register[3:1]
value %source: test.explicit32 -> physical_register[6:4]
value %result: test.packed.wide -> physical_register[6:4]
copy %source -> %result: materialized

// ====

// The same declared view requires transfers when its component order differs.
// RUN: emit low-allocation-json @swapped_view diagnostics=placement-decisions fixed=%left:physical_register:2:1 fixed=%right:physical_register:0:1 fixed=%saved_left:physical_register:1:1 fixed=%saved_right:physical_register:3:1 fixed=%returned:physical_register:4:2 output=none

test.target<low_core> @target

low.func.def schedule(locked) target<test.low.core>(@target) @swapped_view(%left: reg<test.explicit32>, %right: reg<test.explicit32>) -> (reg<test.explicit32 x2>, reg<test.explicit32>, reg<test.explicit32>) asm {
  // REMARK@+1: BACKEND/043 {source_value_name="left", result_value_name="saved_left"}
  %saved_left = copy %left : reg<test.explicit32> -> reg<test.explicit32>
  // REMARK@+1: BACKEND/043 {source_value_name="right", result_value_name="saved_right"}
  %saved_right = copy %right : reg<test.explicit32> -> reg<test.explicit32>
  // REMARK@+2: BACKEND/043 {source_value_name="saved_left", result_value_name="pair", source_unit_offset="0", result_unit_offset="0", unit_count="1"}
  // REMARK@+1: BACKEND/043 {source_value_name="saved_right", result_value_name="pair", source_unit_offset="0", result_unit_offset="1", unit_count="1"}
  %pair = concat(%left, %right) : (reg<test.explicit32>, reg<test.explicit32>) -> reg<test.explicit32 x2>
  // REMARK@+1: BACKEND/043 {source_value_name="pair", result_value_name="returned"}
  low.br ^exit(%pair: reg<test.explicit32 x2>)
^exit(%returned: reg<test.explicit32 x2>):
  return %returned, %saved_left, %saved_right
}
