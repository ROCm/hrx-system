// The two narrow results occupy r0 and r1 across the branch. Each aliases one
// of the wide value's two possible pairs, even though both classes separately
// fit their capacities. Retire the wide projection before opening those narrow
// lifetimes. Exact allocation must recover this order without memory traffic.
// RUN: emit low-allocation-query @overlapping_domains strategy=resource-stall spill-free spill-count values=%wide,%part,%first,%second lifetimes=%wide,%part,%first,%second

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @overlapping_domains(%input: reg<test.i32 x2>, %lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32>) asm {
  %wide = copy %input : reg<test.i32 x2> -> reg<test.explicit32 x2>
  %part = slice %wide[0] : reg<test.explicit32 x2> -> reg<test.explicit32>
  %result = copy %part : reg<test.explicit32> -> reg<test.i32>
  %first = test.packing.create %lhs
  %second = test.packing.create %rhs
  low.br ^consume(%result: reg<test.i32>, %first: reg<test.packed.narrow>, %second: reg<test.packed.narrow>)
^consume(%value: reg<test.i32>, %left: reg<test.packed.narrow>, %right: reg<test.packed.narrow>):
  %left_result = copy %left : reg<test.packed.narrow> -> reg<test.i32>
  %right_result = copy %right : reg<test.packed.narrow> -> reg<test.i32>
  return %value, %left_result, %right_result
}

// ----
spills: 0
materialized traffic: stores=0 reloads=0
value %wide: test.explicit32 -> physical_register[4:2]
value %part: test.explicit32 -> physical_register[0:1]
value %first: test.packed.narrow -> physical_register[0:1]
value %second: test.packed.narrow -> physical_register[1:1]
lifetime %wide[0]: [1, 2)
lifetime %wide[1]: [1, 1)
lifetime %part[0]: [2, 3)
lifetime %first[0]: [4, 6)
lifetime %second[0]: [5, 6)

// ====

// Locking the overlapping order makes the same storage conflict unavoidable.
// Allocation cannot reinterpret the author's schedule contract to repair it.
// RUN: emit low-allocation-query @locked_overlap strategy=resource-stall spill-free

test.target<low_core> @target

low.func.def schedule(locked) target<test.low.core>(@target) @locked_overlap(%input: reg<test.i32 x2>, %lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32>) asm {
  %first = test.packing.create %lhs
  %second = test.packing.create %rhs
  // ERROR@+1: BACKEND/005 "unspillable-register-exhausted"
  %wide = copy %input : reg<test.i32 x2> -> reg<test.explicit32 x2>
  %part = slice %wide[0] : reg<test.explicit32 x2> -> reg<test.explicit32>
  %result = copy %part : reg<test.explicit32> -> reg<test.i32>
  low.br ^consume(%result: reg<test.i32>, %first: reg<test.packed.narrow>, %second: reg<test.packed.narrow>)
^consume(%value: reg<test.i32>, %left: reg<test.packed.narrow>, %right: reg<test.packed.narrow>):
  %left_result = copy %left : reg<test.packed.narrow> -> reg<test.i32>
  %right_result = copy %right : reg<test.packed.narrow> -> reg<test.i32>
  return %value, %left_result, %right_result
}

// ====

// A single value wider than the entire class has no legal schedule.
// RUN: emit low-allocation-query @oversized_value strategy=resource-stall spill-free

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @oversized_value(%input: reg<test.i32 x8>) -> (reg<test.i32 x8>) asm {
  // ERROR@+1: BACKEND/005 "unspillable-register-exhausted"
  %wide = copy %input : reg<test.i32 x8> -> reg<test.explicit32 x8>
  %result = copy %wide : reg<test.explicit32 x8> -> reg<test.i32 x8>
  return %result
}

// ====

// Five derived values cross a block boundary in a four-register bank, forcing
// rematerialization. Repair owns those private producers, not the independent
// concatenations in the later store block. The first pair remains available
// before the shared address, and each store retires its pair before the held
// payloads are consumed. The final frame has no materialized spill traffic.
// RUN: emit low-allocation-query @private_repair_preserves_peer_storage strategy=resource-stall spill-free spill-count lifetimes=%address,%pair0,%pair1,%moved0

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @private_repair_preserves_peer_storage(%base: reg<test.spillable.explicit32>, %lhs: reg<test.i32>, %rhs: reg<test.i32>, %held: reg<test.phys x26>, %tail0: reg<test.phys>, %tail1: reg<test.phys>, %tail2: reg<test.phys>, %tail3: reg<test.phys>) -> (reg<test.i32 x5>, reg<test.i32 x26>, reg<test.i32>, reg<test.i32>) asm {
  %derived0 = test.rematerialize.pair.explicit32.spillable %base, %base
  %derived1 = test.rematerialize.pair.explicit32.spillable %base, %derived0
  %derived2 = test.rematerialize.pair.explicit32.spillable %base, %derived1
  %derived3 = test.rematerialize.pair.explicit32.spillable %base, %derived2
  %derived4 = test.rematerialize.pair.explicit32.spillable %base, %derived3
  low.br ^publish
^publish:
  %value0 = copy %derived0 : reg<test.spillable.explicit32> -> reg<test.i32>
  %value1 = copy %derived1 : reg<test.spillable.explicit32> -> reg<test.i32>
  %value2 = copy %derived2 : reg<test.spillable.explicit32> -> reg<test.i32>
  %value3 = copy %derived3 : reg<test.spillable.explicit32> -> reg<test.i32>
  %value4 = copy %derived4 : reg<test.spillable.explicit32> -> reg<test.i32>
  %result = concat(%value0, %value1, %value2, %value3, %value4) : (reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>) -> reg<test.i32 x5>
  low.br ^stores
^stores:
  %pair0 = concat(%tail0, %tail1) : (reg<test.phys>, reg<test.phys>) -> reg<test.phys x2>
  %pair1 = concat(%tail2, %tail3) : (reg<test.phys>, reg<test.phys>) -> reg<test.phys x2>
  %address = test.const.ptr 0
  %moved0 = test.move.to.phys %lhs
  %moved1 = test.move.to.phys %rhs
  test.store.v2phys %address, %pair0
  test.store.v2phys %address, %pair1
  low.schedule.fence
  %held_result = copy %held : reg<test.phys x26> -> reg<test.i32 x26>
  %moved_result0 = copy %moved0 : reg<test.phys> -> reg<test.i32>
  %moved_result1 = copy %moved1 : reg<test.phys> -> reg<test.i32>
  return %result, %held_result, %moved_result0, %moved_result1
}

