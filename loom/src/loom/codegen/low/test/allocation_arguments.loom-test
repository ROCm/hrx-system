// The early input is dead at the load, but recoloring changes the whole
// lifetime. Register 5 must retain that input until the preceding store.
// RUN: emit low-allocation @entry_history test.i32=6 entry=0:test.i32:target_id:2 entry=1:test.i32:target_id:0 entry=2:test.i32:target_id:5

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @entry_history(%first: reg<test.i32>, %second: reg<test.i32>, %early: reg<test.i32>, %address: reg<test.ptr>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32 x4>) asm {
  %storage = storage {byte_alignment = 4, byte_length = 4} : low.storage<private>
  low.spill %early, %storage : reg<test.i32>, low.storage<private>
  %wide = test.load.v4i32 %address
  return %first, %second, %wide
}

