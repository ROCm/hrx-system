load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")
load("//loom/build_tools/bazel:loom_check.bzl", "loom_check_test", "loom_check_test_suite")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_check_test_suite(
    name = "test",
    srcs = [
        "allocation.loom-test",
        "allocation_aliases.loom-test",
        "allocation_arguments.loom-test",
        "allocation_concat.loom-test",
        "allocation_concat_loops.loom-test",
        "allocation_copy_sources.loom-test",
        "allocation_destructive_concat.loom-test",
        "allocation_destructive_paths.loom-test",
        "allocation_fragmentation.loom-test",
        "allocation_identity_edges.loom-test",
        "allocation_modes.loom-test",
        "allocation_physical_domains.loom-test",
        "allocation_preferences.loom-test",
        "allocation_reachability.loom-test",
        "allocation_spill_materialization.loom-test",
        "allocation_structured_liveness.loom-test",
        "allocation_tied_domains.loom-test",
        "descriptor_constraints.loom-test",
        "enum_bitsets.loom-test",
        "guarded_motion.loom-test",
        "packet.loom-test",
        "register_parts.loom-test",
        "storage_transport.loom-test",
    ],
)

loom_check_test(
    name = "allocation_spill_storage_amdgpu",
    src = "allocation_spill_storage_amdgpu.loom-test",
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/arch:amdgpu",
    ]),
)
