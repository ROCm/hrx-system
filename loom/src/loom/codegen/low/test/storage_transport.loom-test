// Synchronous boundaries may consume private cells without simultaneously
// demanding registers. Source effects and ordinary instruction uses remain.

// RUN: emit low-schedule-query @entry_return storage-transport=stack

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @entry_return(%input: reg<test.i32>) -> (reg<test.i32>) asm {
  %slot = storage {byte_alignment = 4, byte_length = 4} : low.storage<stack>
  low.spill %input, %slot : reg<test.i32>, low.storage<stack>
  %loaded = low.reload %slot : low.storage<stack> -> reg<test.i32>
  return %loaded
}

// ----
stored %input: stack+0
stored %loaded: stack+0

// ====

// Pure register setup may remain between a reload and its boundary consumer.
// RUN: emit low-schedule-query @pure_interposition storage-transport=stack

test.target<low_core> @target

low.func.decl pure target<test.low.core>(@target) @consume_pair(%0: reg<test.i32>, %1: reg<test.i32>) -> (reg<test.i32>)

low.func.def target<test.low.core>(@target) @pure_interposition(%input: reg<test.i32>) -> (reg<test.i32>) asm {
  %slot = storage {byte_alignment = 4, byte_length = 4} : low.storage<stack>
  low.spill %input, %slot : reg<test.i32>, low.storage<stack>
  %loaded = low.reload %slot : low.storage<stack> -> reg<test.i32>
  %constant = test.const.i32 1
  %result = low.func.call pure @consume_pair(%loaded, %constant) : (reg<test.i32>, reg<test.i32>) -> (reg<test.i32>)
  return %result
}

// ----
stored %input: stack+0
stored %loaded: stack+0

// ====

// RUN: emit low-schedule-query @pure_call_order storage-transport=stack kind=effect consumer=3,4

test.target<low_core> @target

low.func.decl pure target<test.low.core>(@target) @helper(%0: reg<test.i32>) -> (reg<test.i32>)

low.func.def target<test.low.core>(@target) @pure_call_order(%first: reg<test.i32>, %second: reg<test.i32>) -> (reg<test.i32>) asm {
  %slot = storage {byte_alignment = 4, byte_length = 4} : low.storage<stack>
  low.spill %first, %slot : reg<test.i32>, low.storage<stack>
  %loaded = low.reload %slot : low.storage<stack> -> reg<test.i32>
  %result = low.func.call pure @helper(%loaded) : (reg<test.i32>) -> (reg<test.i32>)
  low.spill %second, %slot : reg<test.i32>, low.storage<stack>
  return %result
}

// ----
stored %loaded: stack+0
node 3 <- 2
node 4 <- 2, 3

// ====

// RUN: emit low-schedule-query @result_store storage-transport=stack kind=effect consumer=3

test.target<low_core> @target

low.func.decl pure target<test.low.core>(@target) @helper(%0: reg<test.i32>) -> (reg<test.i32>)

low.func.def target<test.low.core>(@target) @result_store(%input: reg<test.i32>) -> (reg<test.i32>) asm {
  %slot = storage {byte_alignment = 4, byte_length = 4} : low.storage<stack>
  %result = low.func.call pure @helper(%input) : (reg<test.i32>) -> (reg<test.i32>)
  low.spill %result, %slot : reg<test.i32>, low.storage<stack>
  %loaded = low.reload %slot : low.storage<stack> -> reg<test.i32>
  return %loaded
}

// ----
stored %result: stack+0
stored %loaded: stack+0
node 3 <- 2

