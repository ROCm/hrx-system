// ====

// One reload can supply repeated boundary operands without recreating registers.
// RUN: emit low-schedule-query @repeated_operand storage-transport=stack

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @repeated_operand(%input: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %slot = storage {byte_alignment = 4, byte_length = 4} : low.storage<stack>
  low.spill %input, %slot : reg<test.i32>, low.storage<stack>
  %loaded = low.reload %slot : low.storage<stack> -> reg<test.i32>
  return %loaded, %loaded
}

// ----
stored %input: stack+0
stored %loaded: stack+0

// ====

// The starting byte is valid; the target's full physical cell does not fit.
// RUN: emit low-schedule-query @full_cell_bounds storage-transport=stack

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @full_cell_bounds(%input: reg<test.i32>) -> (reg<test.i32>) asm {
  %slot = storage {byte_alignment = 4, byte_length = 4} : low.storage<stack>
  low.spill %input, %slot {offset = 1} : reg<test.i32>, low.storage<stack>
  %loaded = low.reload %slot {offset = 1} : low.storage<stack> -> reg<test.i32>
  return %loaded
}

