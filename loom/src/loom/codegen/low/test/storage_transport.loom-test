// RUN: emit low-schedule-query @projected_storage storage-transport=stack

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @projected_storage(%input: reg<test.i32>) -> (reg<test.i32>) asm {
  %slot = storage {byte_alignment = 4, byte_length = 16} : low.storage<stack>
  %view = storage_view %slot {byte_length = 4, offset = 8} : low.storage<stack> -> low.storage<stack>
  low.spill %input, %view : reg<test.i32>, low.storage<stack>
  %loaded = low.reload %view : low.storage<stack> -> reg<test.i32>
  return %loaded
}

