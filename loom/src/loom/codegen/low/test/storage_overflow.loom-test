// ====

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @alignment_overflow() asm {
  %first = storage {byte_alignment = 1, byte_length = 9223372036854775807} : low.storage<stack>
  %second = storage {byte_alignment = 1, byte_length = 9223372036854775807} : low.storage<stack>
  // ERROR@+1: TARGET/096 {function_name="alignment_overflow", storage_space="stack"}
  %overflow = storage {byte_alignment = 4, byte_length = 1} : low.storage<stack>
  return
}
