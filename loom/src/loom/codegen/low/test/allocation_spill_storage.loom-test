  %ab = test.add.v4i32 %a, %b
  %26 = low.reload %layouts_spill_storage_1 : low.storage<private> -> reg<test.i32 x4>
  %abc = test.add.v4i32 %ab, %26
  low.spill %abc, %output : reg<test.i32 x4>, low.storage<private>
  low.br ^scalar
^scalar:
  %one = test.const.i32 1
  %d = copy %one : reg<test.i32> -> reg<test.f32>
  %e = copy %one : reg<test.i32> -> reg<test.f32>
  %f = copy %one : reg<test.i32> -> reg<test.f32>
  low.spill %f, %layouts_spill_storage_2 : reg<test.f32>, low.storage<private>
  %de = test.add.f32 %d, %e
  %27 = low.reload %layouts_spill_storage_2 : low.storage<private> -> reg<test.f32>
  %def = test.add.f32 %de, %27
  low.spill %def, %output : reg<test.f32>, low.storage<private>
  low.br ^stack
^stack:
  %seed = test.const.i32 2
