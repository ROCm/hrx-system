  %17 = low.reload %same_block_spill_storage_2 : low.storage<private> -> reg<test.i32>
  %def = test.add.i32 %de, %17
  %previous = low.reload %output : low.storage<private> -> reg<test.i32>
  %sum = test.add.i32 %previous, %def
  low.br ^exit
^exit:
  return %sum
