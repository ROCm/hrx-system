  %a = test.const.i32 1
  %b = test.const.i32 2
  %c = test.const.i32 3
  low.spill %c, %same_block_spill_storage_1 : reg<test.i32>, low.storage<private>
  %ab = test.add.i32 %a, %b
  %16 = low.reload %same_block_spill_storage_1 : low.storage<private> -> reg<test.i32>
  %abc = test.add.i32 %ab, %16
  low.spill %abc, %output : reg<test.i32>, low.storage<private>
  %d = test.const.i32 4
  %e = test.const.i32 5
  %f = test.const.i32 6
