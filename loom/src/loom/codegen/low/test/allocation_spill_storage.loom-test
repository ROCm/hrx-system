traffic: 2 stores, 2 reloads
errors: 0

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @sequential() -> (reg<test.i32>) asm {
  %output = storage {byte_alignment = 4, byte_length = 4} : low.storage<private>
  %sequential_spill_storage_1 = storage {byte_alignment = 4, byte_length = 4} : low.storage<private>
  %a = test.const.i32 1
  %b = test.const.i32 2
  %c = test.const.i32 3
  low.spill %c, %sequential_spill_storage_1 : reg<test.i32>, low.storage<private>
  %ab = test.add.i32 %a, %b
  %15 = low.reload %sequential_spill_storage_1 : low.storage<private> -> reg<test.i32>
  %abc = test.add.i32 %ab, %15
  low.spill %abc, %output : reg<test.i32>, low.storage<private>
  low.br ^next
^next:
  %d = test.const.i32 4
  %e = test.const.i32 5
  %f = test.const.i32 6
  low.spill %f, %sequential_spill_storage_1 : reg<test.i32>, low.storage<private>
  %de = test.add.i32 %d, %e
  %16 = low.reload %sequential_spill_storage_1 : low.storage<private> -> reg<test.i32>
  %def = test.add.i32 %de, %16
  %previous = low.reload %output : low.storage<private> -> reg<test.i32>
  %sum = test.add.i32 %previous, %def
  return %sum
}

// ====

// Reordering within one block must not make two disjoint instruction ranges
// share storage. A second block keeps this off the single-block fast path.
// RUN: emit low-allocation-query @same_block spill-count materialize-spills test.i32=2

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @same_block() -> (reg<test.i32>) asm {
  %output = storage {byte_alignment = 4, byte_length = 4} : low.storage<private>
  %a = test.const.i32 1
  %b = test.const.i32 2
  %c = test.const.i32 3
  %ab = test.add.i32 %a, %b
  %abc = test.add.i32 %ab, %c
  low.spill %abc, %output : reg<test.i32>, low.storage<private>
  %d = test.const.i32 4
  %e = test.const.i32 5
  %f = test.const.i32 6
  %de = test.add.i32 %d, %e
  %def = test.add.i32 %de, %f
  %previous = low.reload %output : low.storage<private> -> reg<test.i32>
  %sum = test.add.i32 %previous, %def
  low.br ^exit
^exit:
  return %sum
}

