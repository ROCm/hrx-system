// ====

// Entry arguments and call results retain exclusive cells, preserving direct
// callable storage transport even when their block lifetimes are disjoint.
// RUN: emit low-allocation-query @callable_cells spill-count materialize-spills test.i32=2

test.target<low_core> @target

low.func.decl target<test.low.core>(@target) @produce() -> (reg<test.i32>)

low.func.def target<test.low.core>(@target) @callable_cells(%a: reg<test.i32>, %b: reg<test.i32>, %c: reg<test.i32>) -> (reg<test.i32>) asm {
  %output = storage {byte_alignment = 4, byte_length = 4} : low.storage<private>
  %ab = test.add.i32 %a, %b
  %abc = test.add.i32 %ab, %c
  low.spill %abc, %output : reg<test.i32>, low.storage<private>
  low.br ^call
^call:
  %result = low.func.call @produce() : () -> (reg<test.i32>)
  %d = test.const.i32 4
  %e = test.const.i32 5
  %de = test.add.i32 %d, %e
  %combined = test.add.i32 %de, %result
  low.spill %combined, %output : reg<test.i32>, low.storage<private>
  low.br ^last
^last:
  %f = test.const.i32 6
  %g = test.const.i32 7
  %h = test.const.i32 8
  %fg = test.add.i32 %f, %g
  %fgh = test.add.i32 %fg, %h
  %previous = low.reload %output : low.storage<private> -> reg<test.i32>
  %sum = test.add.i32 %previous, %fgh
  return %sum
}

