  %layouts_spill_storage_3 = storage {byte_alignment = 4, byte_length = 4} : low.storage<stack>
  %a = test.load.v4i32 %pointer
  %b = test.load.v4i32 %pointer
  %c = test.load.v4i32 %pointer
