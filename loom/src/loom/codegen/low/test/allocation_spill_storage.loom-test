  %h = test.rematerialize.spillable.explicit32 %seed
  %i = test.rematerialize.spillable.explicit32 %seed
  low.spill %i, %layouts_spill_storage_3 : reg<test.spillable.explicit32>, low.storage<stack>
  %gi = copy %g : reg<test.spillable.explicit32> -> reg<test.i32>
  %hi = copy %h : reg<test.spillable.explicit32> -> reg<test.i32>
  %28 = low.reload %layouts_spill_storage_3 : low.storage<stack> -> reg<test.spillable.explicit32>
  %ii = copy %28 : reg<test.spillable.explicit32> -> reg<test.i32>
  %gh = test.add.i32 %gi, %hi
  %sum = test.add.i32 %gh, %ii
  return %sum
}

// ====

// A sparse register range still owns spill contents across its entire block
// interval. An intervening path must not overwrite inactive-lane contents.
// RUN: emit low-allocation-query @sparse_path spill-count materialize-spills test.i32=2

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @sparse_path(%condition: reg<test.i32>) -> (reg<test.i32>) asm {
  %retained = test.const.i32 41
  low.cond_br %condition, ^other, ^read : reg<test.i32>
^other:
  %a = test.const.i32 1
  %b = test.const.i32 2
  %c = test.const.i32 3
  %ab = test.add.i32 %a, %b
  %abc = test.add.i32 %ab, %c
  return %abc
^read:
  %d = test.const.i32 4
  %e = test.const.i32 5
  %de = test.add.i32 %d, %e
  %sum = test.add.i32 %de, %retained
  return %sum
}

