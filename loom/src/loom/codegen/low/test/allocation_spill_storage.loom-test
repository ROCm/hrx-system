// ====

// A spilled loop argument occupies its incoming-store blocks, including the
// backedge, even when its register lifetime ends in the header.
// RUN: emit low-allocation-query @loop_edges spill-count materialize-spills test.i32=2

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @loop_edges(%condition: reg<test.i32>) -> (reg<test.i32>) asm {
  %seed = test.const.i32 0
  low.br ^loop(%seed: reg<test.i32>)
^loop(%state: reg<test.i32>):
  %a = test.const.i32 1
  %b = test.const.i32 2
  %c = test.const.i32 3
  %ab = test.add.i32 %a, %b
  %abc = test.add.i32 %ab, %c
  %next = test.add.i32 %abc, %state
  low.cond_br %condition, ^backedge, ^exit : reg<test.i32>
^backedge:
  %d = test.const.i32 4
  %e = test.const.i32 5
  %f = test.const.i32 6
  %de = test.add.i32 %d, %e
  %def = test.add.i32 %de, %f
  %updated = test.add.i32 %def, %next
  low.br ^loop(%updated: reg<test.i32>)
^exit:
  return %next
}

