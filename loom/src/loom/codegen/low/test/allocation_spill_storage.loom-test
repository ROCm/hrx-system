  %sparse_path_spill_storage_0 = storage {byte_alignment = 4, byte_length = 4} : low.storage<private>
  %sparse_path_spill_storage_1 = storage {byte_alignment = 4, byte_length = 4} : low.storage<private>
  %retained = test.const.i32 41
  low.spill %retained, %sparse_path_spill_storage_1 : reg<test.i32>, low.storage<private>
  low.cond_br %condition, ^other, ^read : reg<test.i32>
^other:
  %a = test.const.i32 1
  %b = test.const.i32 2
  %c = test.const.i32 3
  low.spill %c, %sparse_path_spill_storage_0 : reg<test.i32>, low.storage<private>
  %ab = test.add.i32 %a, %b
  %14 = low.reload %sparse_path_spill_storage_0 : low.storage<private> -> reg<test.i32>
  %abc = test.add.i32 %ab, %14
  return %abc
^read:
  %d = test.const.i32 4
  %e = test.const.i32 5
  %de = test.add.i32 %d, %e
  %15 = low.reload %sparse_path_spill_storage_1 : low.storage<private> -> reg<test.i32>
  %sum = test.add.i32 %de, %15
