spills: 5
storage: 4 reservations, 16 bytes
traffic: 6 stores, 6 reloads
errors: 0

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @loop_edges(%condition: reg<test.i32>) -> (reg<test.i32>) asm {
  %loop_edges_spill_storage_0 = storage {byte_alignment = 4, byte_length = 4} : low.storage<private>
  %loop_edges_spill_storage_1 = storage {byte_alignment = 4, byte_length = 4} : low.storage<private>
  %loop_edges_spill_storage_2 = storage {byte_alignment = 4, byte_length = 4} : low.storage<private>
  %loop_edges_spill_storage_3 = storage {byte_alignment = 4, byte_length = 4} : low.storage<private>
  low.spill %condition, %loop_edges_spill_storage_0 : reg<test.i32>, low.storage<private>
  %seed = test.const.i32 0
  low.spill %seed, %loop_edges_spill_storage_1 : reg<test.i32>, low.storage<private>
  low.br ^loop
^loop:
  %a = test.const.i32 1
  %b = test.const.i32 2
  %c = test.const.i32 3
  low.spill %c, %loop_edges_spill_storage_2 : reg<test.i32>, low.storage<private>
  %ab = test.add.i32 %a, %b
  %20 = low.reload %loop_edges_spill_storage_2 : low.storage<private> -> reg<test.i32>
  %abc = test.add.i32 %ab, %20
  %21 = low.reload %loop_edges_spill_storage_1 : low.storage<private> -> reg<test.i32>
  %next = test.add.i32 %abc, %21
  low.spill %next, %loop_edges_spill_storage_3 : reg<test.i32>, low.storage<private>
  %22 = low.reload %loop_edges_spill_storage_0 : low.storage<private> -> reg<test.i32>
  low.cond_br %22, ^backedge, ^exit : reg<test.i32>
^backedge:
  %d = test.const.i32 4
  %e = test.const.i32 5
  %f = test.const.i32 6
  low.spill %f, %loop_edges_spill_storage_2 : reg<test.i32>, low.storage<private>
  %de = test.add.i32 %d, %e
  %23 = low.reload %loop_edges_spill_storage_2 : low.storage<private> -> reg<test.i32>
  %def = test.add.i32 %de, %23
  %24 = low.reload %loop_edges_spill_storage_3 : low.storage<private> -> reg<test.i32>
  %updated = test.add.i32 %def, %24
  low.spill %updated, %loop_edges_spill_storage_1 : reg<test.i32>, low.storage<private>
  low.br ^loop
^exit:
  %25 = low.reload %loop_edges_spill_storage_3 : low.storage<private> -> reg<test.i32>
  return %25
}

// ====

// Private scalar and vector spills use distinct size/alignment groups. The
// same-sized explicit-register spill belongs to stack storage, not private.
// RUN: emit low-allocation-query @layouts spill-count materialize-spills test.i32=8 test.f32=2 test.spillable.explicit32=2

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @layouts(%pointer: reg<test.ptr>) -> (reg<test.i32>) asm {
  %output = storage {byte_alignment = 16, byte_length = 16} : low.storage<private>
  %a = test.load.v4i32 %pointer
  %b = test.load.v4i32 %pointer
  %c = test.load.v4i32 %pointer
  %ab = test.add.v4i32 %a, %b
  %abc = test.add.v4i32 %ab, %c
  low.spill %abc, %output : reg<test.i32 x4>, low.storage<private>
  low.br ^scalar
^scalar:
  %one = test.const.i32 1
  %d = copy %one : reg<test.i32> -> reg<test.f32>
  %e = copy %one : reg<test.i32> -> reg<test.f32>
  %f = copy %one : reg<test.i32> -> reg<test.f32>
  %de = test.add.f32 %d, %e
  %def = test.add.f32 %de, %f
  low.spill %def, %output : reg<test.f32>, low.storage<private>
  low.br ^stack
^stack:
  %seed = test.const.i32 2
  %g = test.rematerialize.spillable.explicit32 %seed
  %h = test.rematerialize.spillable.explicit32 %seed
  %i = test.rematerialize.spillable.explicit32 %seed
  %gi = copy %g : reg<test.spillable.explicit32> -> reg<test.i32>
  %hi = copy %h : reg<test.spillable.explicit32> -> reg<test.i32>
  %ii = copy %i : reg<test.spillable.explicit32> -> reg<test.i32>
  %gh = test.add.i32 %gi, %hi
  %sum = test.add.i32 %gh, %ii
  return %sum
}

