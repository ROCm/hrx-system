CHECK: *"name":"state","type":"reg<test.i32 x2>"*,"location":{"kind":"target_id","base":0,"count":2}*
CHECK: *"name":"candidate","type":"reg<test.i32 x2>"*,"location":{"kind":"target_id","base":5,"count":2}*

// ====

// RUN: with-checks emit low-allocation-json @tied_concat_in_sparse_branch fixed=%condition:target_id:8:1

// The wide input occupies the entry and exit, leaving a storage gap in the
// other branch. Its sparse reservation must also admit the final tied scalar,
// whose concat edge payload requires a continuous storage reservation.
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @tied_concat_in_sparse_branch(%condition: reg<test.i32>, %seed: reg<test.i32 x4>) -> (reg<test.i32 x4>) asm {
  low.cond_br %condition, ^body, ^exit : reg<test.i32>
^body:
  %initial = test.const.i32 7
  %partial = test.tied.any %initial
  %complete = test.tied.any %partial
  %tail0 = test.const.i32 11
  %tail1 = test.const.i32 13
  %tail2 = test.const.i32 17
  %tuple = concat(%complete, %tail0, %tail1, %tail2) : (reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>) -> reg<test.i32 x4>
  low.br ^returned(%tuple: reg<test.i32 x4>)
^returned(%result: reg<test.i32 x4>):
  return %result
^exit:
  %final = test.early_tied.v4i32 %seed
  return %final
}

// ----
CHECK: *"name":"complete","type":"reg<test.i32>"*,"location":{"kind":"target_id","base":0,"count":1}*
