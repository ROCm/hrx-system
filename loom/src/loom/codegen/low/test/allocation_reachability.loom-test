// RUN: with-checks emit low-allocation-json @reconverging_updates_preserve_old_units

// Both arms propose a new carried aggregate. Its old units remain observable
// after reconvergence, so neither arm may overwrite them before the join read.
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @reconverging_updates_preserve_old_units(%done: reg<test.i32>, %choose: reg<test.i32>, %seed: reg<test.i32 x2>, %step: reg<test.i32>) -> (reg<test.i32 x2>) asm {
  low.br ^loop(%seed: reg<test.i32 x2>)
^loop(%state: reg<test.i32 x2>):
  low.cond_br %done, ^exit, ^body : reg<test.i32>
^body:
  low.cond_br %choose, ^left, ^right : reg<test.i32>
^left:
  %left_old = slice %state[1] : reg<test.i32 x2> -> reg<test.i32>
  %left_new = test.add.i32 %left_old, %step
  %left_pair = concat(%left_new, %left_old) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32 x2>
  low.br ^join(%left_pair: reg<test.i32 x2>)
^right:
  %right_old = slice %state[0] : reg<test.i32 x2> -> reg<test.i32>
  %right_new = test.add.i32 %right_old, %step
  %right_pair = concat(%right_old, %right_new) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32 x2>
  low.br ^join(%right_pair: reg<test.i32 x2>)
^join(%candidate: reg<test.i32 x2>):
  %old_low = slice %state[0] : reg<test.i32 x2> -> reg<test.i32>
  %old_high = slice %state[1] : reg<test.i32 x2> -> reg<test.i32>
  %old_sum = test.add.i32 %old_low, %old_high
  %candidate_low = slice %candidate[0] : reg<test.i32 x2> -> reg<test.i32>
  %next = concat(%candidate_low, %old_sum) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32 x2>
  low.br ^loop(%next: reg<test.i32 x2>)
^exit:
  return %state
}

