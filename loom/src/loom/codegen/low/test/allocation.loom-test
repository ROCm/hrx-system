// RUN: emit low-allocation-query @compact_wide_concat_reuses_packet_storage values=%first,%second,%packed

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @compact_wide_concat_reuses_packet_storage(%input: reg<test.i32 x4>) -> (reg<test.i32 x8>, reg<test.i32>) asm {
  %first = test.add.v4i32 %input, %input
  %second = test.add.v4i32 %input, %input
  %packed = concat(%first, %second) : (reg<test.i32 x4>, reg<test.i32 x4>) -> reg<test.i32 x8>
  %packed0 = slice %packed[0] : reg<test.i32 x8> -> reg<test.i32>
  %consume = test.add.i32 %packed0, %packed0
  return %packed, %consume
}

