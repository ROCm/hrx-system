// RUN: emit low-allocation-json @multiple_edge_concats_remain_distinct

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @multiple_edge_concats_remain_distinct(
    %condition: reg<test.i32>, %lhs: reg<test.i32>, %rhs: reg<test.i32>,
    %zero: reg<test.i32>) -> (reg<test.i32>) asm {
  low.cond_br %condition, ^build, ^exit : reg<test.i32>
^build:
  %first = test.add.i32 %lhs, %zero
  %first_pair = concat(%first, %zero) :
      (reg<test.i32>, reg<test.i32>) -> reg<test.i32 x2>
  %second = test.mul.i32 %rhs, %zero
  %second_pair = concat(%second, %zero) :
      (reg<test.i32>, reg<test.i32>) -> reg<test.i32 x2>
  low.br ^join(%first_pair: reg<test.i32 x2>,
      %second_pair: reg<test.i32 x2>)
^join(%first_state: reg<test.i32 x2>, %second_state: reg<test.i32 x2>):
  %first_value = slice %first_state[0] :
      reg<test.i32 x2> -> reg<test.i32>
  %second_value = slice %second_state[0] :
      reg<test.i32 x2> -> reg<test.i32>
  %sum = test.add.i32 %first_value, %second_value
  return %sum
^exit:
  return %zero
}

