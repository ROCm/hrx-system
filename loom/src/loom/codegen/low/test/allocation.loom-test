value %suffix_result: test.i32 -> target_id[1:1]

// ====

// A carrier remains live along the loop continuation after one dynamic path
// captures it. The resume argument shares that carrier's storage while the
// continuing path can still read the original value.
// RUN: emit low-allocation-query @loop_branch_identity values=%source,%result

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @loop_branch_identity(%source: reg<test.i32>, %condition: reg<test.i32>) -> (reg<test.i32>) asm {
  low.br ^header
^header:
  low.cond_br %condition, ^capture, ^continue : reg<test.i32>
^capture:
  low.br.identity(0, 1) ^resume(%source: reg<test.i32>)
^resume(%result: reg<test.i32>):
  low.cond_br %condition, ^exit, ^continue : reg<test.i32>
^continue:
  %continued = test.add.i32 %source, %source
  low.br ^header
^exit:
  return %result
}

// ----
value %source: test.i32 -> target_id[0:1]
value %result: test.i32 -> target_id[0:1]
