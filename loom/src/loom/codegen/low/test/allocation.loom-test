// RUN: emit low-allocation-query @branch_concat_destination_layout values=%state,%out0,%out1

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @branch_concat_destination_layout(%cond: reg<test.i32>, %lhs: reg<test.i32 x2>, %rhs: reg<test.i32 x2>) -> (reg<test.i32 x2>) asm {
  low.cond_br %cond, ^then, ^else : reg<test.i32>
^then:
  %lhs0 = slice %lhs[0] : reg<test.i32 x2> -> reg<test.i32>
  %rhs0 = slice %rhs[0] : reg<test.i32 x2> -> reg<test.i32>
  %out0 = test.add.i32 %lhs0, %rhs0
  %lhs1 = slice %lhs[1] : reg<test.i32 x2> -> reg<test.i32>
  %rhs1 = slice %rhs[1] : reg<test.i32 x2> -> reg<test.i32>
  %out1 = test.add.i32 %lhs1, %rhs1
  %out = concat(%out0, %out1) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32 x2>
  low.br ^join(%out: reg<test.i32 x2>)
^else:
  low.br ^join(%rhs: reg<test.i32 x2>)
^join(%state: reg<test.i32 x2>):
  return %state
}

// ----
value %state: test.i32 -> target_id[0:2]
value %out0: test.i32 -> target_id[0:1]
value %out1: test.i32 -> target_id[1:1]

// ====

// RUN: emit low-allocation-query @multiple_edge_concats_remain_distinct spill-count edge-moves values=%first_state,%second_state

test.target<low_core> @test_target

// The shared zero remains live on the bypass path. Its hole at the join
// permits reuse, but eagerly reserving the join destination from the zero
// would grow the four-register placement to five just to avoid edge copies.
low.func.def target<test.low.core>(@test_target) @multiple_edge_concats_remain_distinct(%condition: reg<test.i32>, %lhs: reg<test.i32>, %rhs: reg<test.i32>, %zero: reg<test.i32>) -> (reg<test.i32>) asm {
  low.cond_br %condition, ^build, ^exit : reg<test.i32>
^build:
  %first = test.add.i32 %lhs, %zero
  %first_pair = concat(%first, %zero) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32 x2>
  %second = test.mul.i32 %rhs, %zero
  %second_pair = concat(%second, %zero) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32 x2>
  low.br ^join(%first_pair: reg<test.i32 x2>, %second_pair: reg<test.i32 x2>)
^join(%first_state: reg<test.i32 x2>, %second_state: reg<test.i32 x2>):
  %first_value = slice %first_state[0] : reg<test.i32 x2> -> reg<test.i32>
  %second_value = slice %second_state[0] : reg<test.i32 x2> -> reg<test.i32>
  %sum = test.add.i32 %first_value, %second_value
  return %sum
^exit:
  return %zero
}

// ----
spills: 0
edge moves: 3
move test.i32:target_id[1] <- test.i32:target_id[0]
move test.i32:target_id[0] <- test.i32:target_id[2]
move test.i32:target_id[2] <- test.i32:target_id[1]
value %first_state: test.i32 -> target_id[2:2]
value %second_state: test.i32 -> target_id[0:2]

