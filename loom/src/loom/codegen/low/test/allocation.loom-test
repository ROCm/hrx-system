// The short scalar inputs compete with a full-bank tuple, while the oversized
// tuple cannot fit at all. Their spills need disjoint, full-width slot ranges.
low.func.def target<test.low.core>(@test_target) @wide_spill_slot_ranges(%wide: reg<test.pressure.alias32 x8>, %scalar0: reg<test.pressure.alias32>, %scalar1: reg<test.pressure.alias32>, %huge: reg<test.pressure.alias32 x9>) -> (reg<test.pressure.alias32 x8>, reg<test.i32>, reg<test.pressure.alias32 x9>) asm {
  %left = copy %scalar0 : reg<test.pressure.alias32> -> reg<test.i32>
  %right = copy %scalar1 : reg<test.pressure.alias32> -> reg<test.i32>
  %use0 = test.add.i32 %left, %right
  return %wide, %use0, %huge
}

