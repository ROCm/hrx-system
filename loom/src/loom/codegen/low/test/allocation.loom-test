// WARNING@+1: BACKEND/008 {function_name="provisional_spill_skips_packet_move_planning", value_name="wide", value_class="test.pressure.alias32", spill_cause="register-budget-conflict"}
low.func.def target<test.low.core>(@test_target) @provisional_spill_skips_packet_move_planning(%source: reg<test.pressure.alias32 x8>, %wide: reg<test.pressure.alias32 x9>) -> (reg<test.pressure.alias32 x8>, reg<test.pressure.alias32 x9>) asm {
  %lhs = slice %source[0] : reg<test.pressure.alias32 x8> -> reg<test.pressure.alias32 x4>
  %rhs = slice %source[4] : reg<test.pressure.alias32 x8> -> reg<test.pressure.alias32 x4>
  %packed = concat(%rhs, %lhs) : (reg<test.pressure.alias32 x4>, reg<test.pressure.alias32 x4>) -> reg<test.pressure.alias32 x8>
  return %packed, %wide
}

