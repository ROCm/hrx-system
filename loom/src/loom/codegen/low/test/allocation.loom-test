// RUN: emit low-allocation-json @wide_concat_source_pressure_cliff fixed=%high_blocker:target_id:28:1

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @wide_concat_source_pressure_cliff(%lhs: reg<test.i32 x4>, %rhs: reg<test.i32 x4>, %block0: reg<test.i32 x4>, %block1: reg<test.i32 x4>, %block2: reg<test.i32 x4>, %block3: reg<test.i32 x4>, %high_blocker: reg<test.i32>) -> (reg<test.i32 x8>) asm {
  %early = test.add.v4i32 %lhs, %rhs
  %hold0 = test.add.v4i32 %lhs, %block0
  %hold1 = test.add.v4i32 %rhs, %block1
  %hold2 = test.add.v4i32 %block2, %block3
  %hold3 = test.add.v4i32 %hold0, %hold2
  %late = test.add.v4i32 %hold3, %hold1
  %late0 = slice %late[0] : reg<test.i32 x4> -> reg<test.i32>
  %consume = test.add.i32 %high_blocker, %late0
  %packed = concat(%early, %late) : (reg<test.i32 x4>, reg<test.i32 x4>) -> reg<test.i32 x8>
  return %packed
