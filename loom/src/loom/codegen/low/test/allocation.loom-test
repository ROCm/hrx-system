low.func.def target<test.low.core>(@test_target) @nested_tied_copy_loop_carried_value(
    %outer_condition: reg<test.i32>, %inner_condition: reg<test.i32>,
    %seed: reg<test.i32>) -> (reg<test.i32>) {
  low.br ^outer(%seed: reg<test.i32>)
^outer(%outer_state: reg<test.i32>):
  low.cond_br %outer_condition, ^inner_entry, ^exit : reg<test.i32>
^inner_entry:
  low.br ^inner(%outer_state: reg<test.i32>)
^inner(%inner_state: reg<test.i32>):
  low.cond_br %inner_condition, ^body, ^inner_exit : reg<test.i32>
^body:
  %copy = low.copy %inner_state : reg<test.i32> -> reg<test.i32>
  %next = low.op<test.tied.any>(%copy) :
      (reg<test.i32>) -> %copy as reg<test.i32>
  low.br ^inner(%next: reg<test.i32>)
^inner_exit:
  low.br ^outer(%inner_state: reg<test.i32>)
^exit:
  low.return %outer_state : reg<test.i32>
}

