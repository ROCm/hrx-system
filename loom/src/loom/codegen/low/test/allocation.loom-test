// RUN: emit low-allocation-query @wide_concat_reuses_early_source values=%high_blocker,%early,%late,%packed

test.target<low_core> @test_target

// The sources are separated by independent work. The complete tuple keeps
// the early source in place and transfers only the late source.
low.func.def target<test.low.core>(@test_target) @wide_concat_reuses_early_source(%lhs: reg<test.i32 x4>, %rhs: reg<test.i32 x4>, %block0: reg<test.i32 x4>, %block1: reg<test.i32 x4>, %block2: reg<test.i32 x4>, %block3: reg<test.i32 x4>) -> (reg<test.i32 x8>) asm {
  %early = test.add.v4i32 %lhs, %rhs
  %high_blocker = test.const.i32 7
  %hold0 = test.add.v4i32 %lhs, %block0
  %hold1 = test.add.v4i32 %rhs, %block1
  %hold2 = test.add.v4i32 %block2, %block3
  %hold3 = test.add.v4i32 %hold0, %hold2
  %late = test.add.v4i32 %hold3, %hold1
  %late0 = slice %late[0] : reg<test.i32 x4> -> reg<test.i32>
  %consume = test.add.i32 %high_blocker, %late0
  %packed = concat(%early, %late) : (reg<test.i32 x4>, reg<test.i32 x4>) -> reg<test.i32 x8>
  return %packed
}

