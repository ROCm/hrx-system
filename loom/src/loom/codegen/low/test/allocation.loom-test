^body:
  %source0 = test.const.i32 0
  %next0 = test.tied.any %source0
  %next1 = test.const.i32 1
  %next = concat(%next0, %next1) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32 x2>
  low.br ^loop(%next: reg<test.i32 x2>)
^exit:
  return %state
}

