// RUN: emit low-allocation-query @sequential_loop_relocation values=%seed,%first_state,%first_next,%second_state,%second_next

test.target<low_core> @test_target

// Both headers start in the seed's register and must relocate to their own
// backedge slices. The tuple widths place the slices at distinct nonzero
// locations, so relocating the first header cannot satisfy the second.
low.func.def target<test.low.core>(@test_target) @sequential_loop_relocation(%condition: reg<test.i32>, %seed: reg<test.pressure.alias32>, %first_input: reg<test.i32 x5>, %second_input: reg<test.i32 x6>) -> (reg<test.pressure.alias32>) asm {
  low.br ^first_loop(%seed: reg<test.pressure.alias32>)
^first_loop(%first_state: reg<test.pressure.alias32>):
  low.cond_br %condition, ^first_body, ^first_exit : reg<test.i32>
^first_body:
  %first_tuple = copy %first_input : reg<test.i32 x5> -> reg<test.pressure.alias32 x5>
  %first_next = slice %first_tuple[4] : reg<test.pressure.alias32 x5> -> reg<test.pressure.alias32>
  low.br ^first_loop(%first_next: reg<test.pressure.alias32>)
^first_exit:
  low.br ^second_loop(%first_state: reg<test.pressure.alias32>)
^second_loop(%second_state: reg<test.pressure.alias32>):
  low.cond_br %condition, ^second_body, ^exit : reg<test.i32>
^second_body:
  %second_tuple = copy %second_input : reg<test.i32 x6> -> reg<test.pressure.alias32 x6>
  %second_next = slice %second_tuple[5] : reg<test.pressure.alias32 x6> -> reg<test.pressure.alias32>
  low.br ^second_loop(%second_next: reg<test.pressure.alias32>)
^exit:
  return %second_state
}

