test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @compact_wide_concat_reserves_fragmented_span(
    %lhs: reg<test.i32 x4>, %rhs: reg<test.i32 x4>,
    %middle_blocker: reg<test.i32 x4>) ->
    (reg<test.i32 x8>, reg<test.i32 x4>, reg<test.i32>) asm {
  %first = test.add.v4i32 %lhs, %rhs
  %second = test.add.v4i32 %lhs, %rhs
  %packed = concat(%first, %second) :
      (reg<test.i32 x4>, reg<test.i32 x4>) -> reg<test.i32 x8>
  %packed0 = slice %packed[0] : reg<test.i32 x8> -> reg<test.i32>
  %consume = test.add.i32 %packed0, %packed0
  return %packed, %middle_blocker, %consume
}

