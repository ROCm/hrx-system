// RUN: emit low-allocation-query @rotating_header_values values=%seed0,%seed1,%x,%y,%next,%sum

// The backedge's old y is consumed, but the next iteration defines new x and y
// together. Recoloring x onto y would also overwrite the distinct entry seeds
// and turn the exit sum into a repeated read of one register.
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @rotating_header_values(%condition: reg<test.i32>, %seed0: reg<test.i32>, %seed1: reg<test.i32>) -> (reg<test.i32>) asm {
  low.br ^loop(%seed0: reg<test.i32>, %seed1: reg<test.i32>)
^loop(%x: reg<test.i32>, %y: reg<test.i32>):
  low.cond_br %condition, ^body, ^exit : reg<test.i32>
^body:
  %one = test.const.i32 1
  %next = test.add.i32 %x, %one
  low.br ^loop(%y: reg<test.i32>, %next: reg<test.i32>)
^exit:
  %sum = test.add.i32 %x, %y
  return %sum
}

// ----
value %seed0: test.i32 -> target_id[0:1]
value %seed1: test.i32 -> target_id[1:1]
value %x: test.i32 -> target_id[0:1]
value %y: test.i32 -> target_id[1:1]
value %next: test.i32 -> target_id[0:1]
value %sum: test.i32 -> target_id[0:1]

