// RUN: emit low-allocation-query @compact_wide_concat_reserves_fragmented_span values=%temporary,%middle_blocker,%first,%second,%packed

test.target<low_core> @test_target

// Consuming the temporary opens a four-unit hole while the two inputs and
// persistent blocker still prevent an eight-unit assembly there.
low.func.def target<test.low.core>(@test_target) @compact_wide_concat_reserves_fragmented_span(%lhs: reg<test.i32 x4>, %rhs: reg<test.i32 x4>) -> (reg<test.phys x4>, reg<test.i32 x8>, reg<test.i32 x4>, reg<test.i32>) asm {
  %temporary = test.add.v4i32 %lhs, %rhs
  %middle_blocker = test.add.v4i32 %lhs, %rhs
  %saved = copy %temporary : reg<test.i32 x4> -> reg<test.phys x4>
  %first = test.add.v4i32 %lhs, %rhs
  %second = test.add.v4i32 %lhs, %rhs
  %packed = concat(%first, %second) : (reg<test.i32 x4>, reg<test.i32 x4>) -> reg<test.i32 x8>
  %packed0 = slice %packed[0] : reg<test.i32 x8> -> reg<test.i32>
  %consume = test.add.i32 %packed0, %packed0
  return %saved, %packed, %middle_blocker, %consume
}

