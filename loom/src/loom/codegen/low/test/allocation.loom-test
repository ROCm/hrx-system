low.func.def target<test.low.core>(@test_target) @loop_backedge_concat_destination_layout(
    %condition: reg<test.i32>, %init: reg<test.i32 x4>, %a0: reg<test.i32>,
    %a1: reg<test.i32>, %a2: reg<test.i32>, %a3: reg<test.i32>)
    -> (reg<test.i32 x4>) asm {
  low.br ^loop(%init: reg<test.i32 x4>)
^loop(%state: reg<test.i32 x4>):
  low.cond_br %condition, ^body, ^exit : reg<test.i32>
^body:
  %s0 = slice %state[0] : reg<test.i32 x4> -> reg<test.i32>
  %s1 = slice %state[1] : reg<test.i32 x4> -> reg<test.i32>
  %s2 = slice %state[2] : reg<test.i32 x4> -> reg<test.i32>
  %s3 = slice %state[3] : reg<test.i32 x4> -> reg<test.i32>
  %n0 = test.add.i32 %s0, %a0
  %n1 = test.add.i32 %s1, %a1
  %n2 = test.add.i32 %s2, %a2
  %n3 = test.add.i32 %s3, %a3
  %next = concat(%n0, %n1, %n2, %n3) : (reg<test.i32>, reg<test.i32>,
      reg<test.i32>, reg<test.i32>) -> reg<test.i32 x4>
  low.br ^loop(%next: reg<test.i32 x4>)
^exit:
  return %state
}

