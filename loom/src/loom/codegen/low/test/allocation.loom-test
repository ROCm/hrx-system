// RUN: emit low-allocation-json @wide_tied_concat_sources_reserve_result_alignment

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @wide_tied_concat_sources_reserve_result_alignment(
    %lhs: reg<test.i32 x4>, %rhs: reg<test.i32 x4>,
    %pressure: reg<test.i32>) ->
    (reg<test.i32 x8>, reg<test.i32>) asm {
  %source0 = test.add.v4i32 %lhs, %rhs
  %tied0 = low.op<test.early_tied.v4i32>(%source0) :
      (reg<test.i32 x4>) -> %source0 as reg<test.i32 x4>
  %source1 = test.add.v4i32 %lhs, %rhs
  %tied1 = low.op<test.early_tied.v4i32>(%source1) :
      (reg<test.i32 x4>) -> %source1 as reg<test.i32 x4>
  %packed = concat(%tied0, %tied1) :
      (reg<test.i32 x4>, reg<test.i32 x4>) -> reg<test.i32 x8>
  return %packed, %pressure
}

