// RUN: emit low-allocation-json @loop_backedge_layout_recolors_shared_storage

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @loop_backedge_layout_recolors_shared_storage(
    %condition: reg<test.i32>, %seed0: reg<test.i32>,
    %seed1: reg<test.i32>, %lhs: reg<test.i32>, %rhs: reg<test.i32>)
    -> (reg<test.i32>, reg<test.i32>) asm {
  low.br ^loop(%seed0: reg<test.i32>, %seed1: reg<test.i32>)
^loop(%state0: reg<test.i32>, %state1: reg<test.i32>):
  low.cond_br %condition, ^body, ^exit : reg<test.i32>
^body:
  %early0 = test.add.i32 %lhs, %rhs
  %early1 = test.mul.i32 %early0, %rhs
  %early2 = test.add.i32 %early1, %rhs
  %used0 = test.add.i32 %state0, %early2
  %used1 = test.add.i32 %state1, %rhs
  %helper = test.add.i32 %used0, %used1
  %next0 = test.mul.i32 %lhs, %rhs
  %next1 = test.add.i32 %lhs, %rhs
  %sink = test.mul.i32 %helper, %rhs
  low.br ^loop(%next0: reg<test.i32>, %next1: reg<test.i32>)
^exit:
  return %state0, %state1 : reg<test.i32>, reg<test.i32>
}

