// RUN: emit low-allocation-query @contiguous_early_clobber_read values=%source,%result spill-count

test.target<low_core> @test_target

// The source spans three blocks but has one contiguous semantic segment. Its
// final physical read still overlaps the early-clobber destination write.
low.func.def target<test.low.core>(@test_target) @contiguous_early_clobber_read(%source: reg<test.i32 x4>) -> (reg<test.i32 x4>) asm {
  low.br ^forward
^forward:
  low.br ^read
^read:
  %result = test.early_clobber.v4i32 %source
  return %result
}

// ----
spills: 0
value %source: test.i32 -> target_id[0:4]
value %result: test.i32 -> target_id[4:4]

// ====

// The predicate uses a separate bank, leaving an aligned source whose sparse
// hole is reusable by %lhs. Its final physical read must still exclude %result.
// RUN: emit low-allocation-query @sparse_early_clobber_read values=%source,%lhs,%rhs,%result spill-count

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @sparse_early_clobber_read(%condition: reg<test.i8>, %source: reg<test.i32 x4>, %pointer: reg<test.ptr>) -> (reg<test.i32 x4>) asm {
  low.cond_br %condition, ^other_path, ^read_path : reg<test.i8>
^other_path:
  %lhs = test.load.v4i32 %pointer
  %rhs = test.load.v4i32 %pointer
  %sum = test.add.v4i32 %lhs, %rhs
  return %sum
^read_path:
  %result = test.early_clobber.v4i32 %source
  return %result
}

// ----
spills: 0
value %source: test.i32 -> target_id[0:4]
value %lhs: test.i32 -> target_id[0:4]
value %rhs: test.i32 -> target_id[4:4]
value %result: test.i32 -> target_id[4:4]

