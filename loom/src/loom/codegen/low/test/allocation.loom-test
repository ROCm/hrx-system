value %state: test.i32 -> target_id[0:1]
value %refilled: test.i32 -> target_id[0:1]
value %joined: test.i32 -> target_id[0:1]
value %next: test.i32 -> target_id[0:1]
value %final: test.i32 -> target_id[0:1]

// ====

// The middle payload retains its storage. Its neighbors must enter the
// instruction's low-register window after the wide input releases that window.
// RUN: emit low-allocation-query @branch_identity_range spill-count edge-moves values=%prefix,%retained,%suffix,%prefix_result,%retained_result,%suffix_result

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @branch_identity_range(%wide: reg<test.i32 x4>, %prefix: reg<test.i32>, %retained: reg<test.i32>, %suffix: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>, reg<test.pressure.alias32 x4>) asm {
  %saved_wide = copy %wide : reg<test.i32 x4> -> reg<test.pressure.alias32 x4>
  low.br.identity(1, 1) ^exit(%prefix: reg<test.i32>, %retained: reg<test.i32>, %suffix: reg<test.i32>)
^exit(%prefix_result: reg<test.i32>, %retained_result: reg<test.i32>, %suffix_result: reg<test.i32>):
  %prefix_use = test.add.low4.i32 %prefix_result, %suffix_result
  %sum = test.add.low4.i32 %suffix_result, %prefix_use
  return %sum, %retained_result, %saved_wide
}

