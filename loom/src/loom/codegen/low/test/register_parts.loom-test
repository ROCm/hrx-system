// CSE reuses a dominating full-register definition across block boundaries.
// RUN: pass low-cse
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @dominating_full_mask(%row: reg<test.i32>) -> (reg<test.i32>) asm {
  low.br ^define
^define:
  %row_bytes = test.add.i32 %row, %row
  low.br ^use
^use:
  %local_bytes = test.add.i32 %row, %row
  return %local_bytes
}

// ----
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @dominating_full_mask(%row: reg<test.i32>) -> (reg<test.i32>) asm {
  low.br ^define
^define:
  %row_bytes = test.add.i32 %row, %row
  low.br ^use
^use:
  return %row_bytes
}

// ====

// A loop header's definition is available in its body and exit.
// RUN: pass low-cse
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @loop_mask(%condition: reg<test.i32>, %row: reg<test.i32>) -> (reg<test.i32>) asm {
  low.br ^header
^header:
  %row_bytes = test.add.i32 %row, %row
  low.cond_br %condition, ^body, ^exit : reg<test.i32>
^body:
  %body_bytes = test.add.i32 %row, %row
  %body_result = test.add.i32 %body_bytes, %row
  low.br ^header
^exit:
  %exit_bytes = test.add.i32 %row, %row
  return %exit_bytes
}

// ----
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @loop_mask(%condition: reg<test.i32>, %row: reg<test.i32>) -> (reg<test.i32>) asm {
  low.br ^header
^header:
  %row_bytes = test.add.i32 %row, %row
  low.cond_br %condition, ^body, ^exit : reg<test.i32>
^body:
  %body_result = test.add.i32 %row_bytes, %row
  low.br ^header
^exit:
  return %row_bytes
}

// ====

// A partial write preserves the unwritten half of a dominating full source,
// even when neither incoming block defines that source.
// RUN: verify
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @dominating_tied_mask(%choose: reg<test.i32>, %route: reg<test.i32>, %row: reg<test.i32>, %address: reg<test.ptr>, %other_address: reg<test.ptr>) -> (reg<test.i32>) asm {
  low.cond_br %choose, ^define, ^warmup : reg<test.i32>
^define:
  %row_bytes = test.add.i32 %row, %row
  low.cond_br %route, ^left, ^right : reg<test.i32>
^use:
  %updated = test.write.high16.i32 %row_bytes, %address
  return %updated
^warmup:
  %prefetched = test.write.low16.i32 %address
  low.br ^define
^left:
  %left_half = test.write.low16.i32 %address
  low.br ^use
^right:
  %right_half = test.write.low16.i32 %other_address
  low.br ^use
}

// ====

// Later facts cannot turn an actual partial definition into a full register.
// RUN: verify
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @partial_use_stays_invalid(%address: reg<test.ptr>) -> (reg<test.i32>) asm {
  %low_half = test.write.low16.i32 %address
  // ERROR@+1: DOMINANCE/011 {required_mask="3", defined_mask="1"}
  return %low_half
}

// ====

// A tied write requires the preserved half to exist. Defining the other half
// later is a different SSA value and does not repair the earlier use.
// RUN: verify
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @missing_preserved_half(%address: reg<test.ptr>) -> (reg<test.i32>) asm {
  %low_half = test.write.low16.i32 %address
  // ERROR@+1: DOMINANCE/011 {required_mask="2", defined_mask="1"}
  %still_low = test.write.low16.tied.i32 %low_half, %address
  %full = test.write.high16.i32 %still_low, %address
  return %full
}

// ====

// A non-reading storage continuation preserves only the parts already present.
// Rewriting the low half is valid; writing the high half completes the value.
// RUN: verify
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @available_parts(%address: reg<test.ptr>) -> (reg<test.i32>) asm {
  %low_half = test.write.low16.i32 %address
  %still_low = test.write.low16.continue.i32 %low_half, %address
  %full = test.write.high16.continue.i32 %still_low, %address
  return %full
}

// ====

// Preserving available storage never makes the missing half readable.
// RUN: verify
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @continuation_missing_read(%address: reg<test.ptr>) -> (reg<test.i32>) asm {
  %low_half = test.write.low16.i32 %address
  %still_low = test.write.low16.continue.i32 %low_half, %address
  // ERROR@+1: DOMINANCE/011 {required_mask="2", defined_mask="1"}
  %missing = test.read.high16.i32 %still_low
  return %missing
}
