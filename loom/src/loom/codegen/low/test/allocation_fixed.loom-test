// Fixing any member constrains the complete required storage chain.
// RUN: emit low-allocation-json @fixed_tied_chain fixed=%last:target_id:6:1

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @fixed_tied_chain(%seed: reg<test.i32>) -> (reg<test.i32>) asm {
  %first = test.tied.any %seed
  %last = test.tied.any %first
  return %last
}

