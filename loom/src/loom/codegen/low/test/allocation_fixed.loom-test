// ====

// An offset slice may share fixed storage with its wider source and a tie.
// RUN: emit low-allocation-json @fixed_offset_slice fixed=%wide:target_id:4:4 fixed=%last:target_id:6:1

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @fixed_offset_slice(%wide: reg<test.i32 x4>) -> (reg<test.i32>) asm {
  %middle = slice %wide[2] : reg<test.i32 x4> -> reg<test.i32>
  %last = test.tied.any %middle
  return %last
}

