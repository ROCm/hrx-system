// ====

// Distinct fixed locations cannot split a required chain, even transitively.
// RUN: emit low-allocation-json @conflicting_fixed_chain fixed=%seed:target_id:6:1 fixed=%last:target_id:7:1 output=none

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @conflicting_fixed_chain(%seed: reg<test.i32>) -> (reg<test.i32>) asm {
  %first = test.tied.any %seed
  // ERROR@+1: BACKEND/049 {first_value_name="seed", first_location_base="6", second_value_name="last", second_location_base="7"}
  %last = test.tied.any %first
  return %last
}

// ====

// An optional copy does not authorize overwriting its still-live input.
// RUN: emit low-allocation-json @fixed_copy_live_conflict fixed=%source:target_id:2:1 fixed=%last:target_id:2:1 output=none

test.target<low_core> @target

// ERROR@+1: BACKEND/050 {value_name="source", location_kind="target_id", location_base="2", location_count="1"}
low.func.def target<test.low.core>(@target) @fixed_copy_live_conflict(%source: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %copy = copy %source : reg<test.i32> -> reg<test.i32>
  %last = test.tied.any %copy
  return %source, %last
}
