// RUN: emit low-allocation-query @pending_loop reverse-blocks spill-count edge-moves values=%seed,%initial,%state,%result fixed=%seed:target_id:0:1 fixed=%state:target_id:4:4

// A decomposed invariant is read on every loop iteration. Its source must
// survive initialization and the destructive body along the entire backedge.
test.target<low_core> @target

low.func.def schedule(locked) target<test.low.core>(@target) @pending_loop(%repeat: reg<test.i32>) -> (reg<test.i32 x4>, reg<test.i32>) asm {
  low.br ^producer
^producer:
  %seed = test.const.i32 7
  %tuple = concat(%seed, %seed, %seed, %seed) : (reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>) -> reg<test.i32 x4>
  low.br ^header
^header:
  %initial = test.const.i32 0
  low.br ^body(%tuple: reg<test.i32 x4>, %initial: reg<test.i32>)
^body(%state: reg<test.i32 x4>, %iteration: reg<test.i32>):
  %result = test.early_tied.v4i32 %state
  low.cond_br %repeat, ^latch, ^exit : reg<test.i32>
^latch:
  low.br ^header
^exit:
  return %result, %iteration
}

