spills: 0
edge moves: 2
move test.i32:target_id[4] <- test.i32:target_id[2]
move test.i32:target_id[5] <- test.i32:target_id[3]
value %wide: test.i32 -> target_id[0:4]
value %initial: test.i32 -> target_id[0:1]
value %unrelated: test.i32 -> target_id[0:1]
value %state: test.i32 -> target_id[4:2]

