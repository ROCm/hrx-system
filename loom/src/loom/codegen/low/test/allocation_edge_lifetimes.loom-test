// RUN: emit low-allocation-query @partial_pending_pair reverse-blocks spill-count edge-moves values=%wide,%initial,%unrelated,%state fixed=%wide:target_id:0:4 fixed=%initial:target_id:0:1 fixed=%unrelated:target_id:0:1 fixed=%state:target_id:4:2

// Only the upper half of the vector is transported. The lower half and the
// sibling path remain reusable even with the physically reversed block order.
test.target<low_core> @target

low.func.def schedule(locked) target<test.low.core>(@target) @partial_pending_pair(%seed: reg<test.i32>) -> (reg<test.i32 x2>, reg<test.i32>) asm {
  low.br ^producer
^producer:
  %wide = test.from_elements.v4i32 %seed, %seed, %seed, %seed
  %tail = slice %wide[2] : reg<test.i32 x4> -> reg<test.i32 x2>
  %pair = concat(%tail) : (reg<test.i32 x2>) -> reg<test.i32 x2>
  low.cond_br %seed, ^handoff, ^bypass : reg<test.i32>
^bypass:
  %unrelated = test.const.i32 37
  %unrelated_pair = concat(%unrelated, %unrelated) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32 x2>
  return %unrelated_pair, %unrelated
^handoff:
  %initial = test.const.i32 0
  low.br ^receive(%pair: reg<test.i32 x2>, %initial: reg<test.i32>)
^receive(%state: reg<test.i32 x2>, %iteration: reg<test.i32>):
  return %state, %iteration
}

