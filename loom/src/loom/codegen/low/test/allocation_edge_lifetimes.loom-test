move test.i32:target_id[5] <- test.i32:target_id[0]
move test.i32:target_id[6] <- test.i32:target_id[0]
move test.i32:target_id[7] <- test.i32:target_id[0]
value %seed: test.i32 -> target_id[0:1]
value %initial: test.i32 -> target_id[2:1]
value %state: test.i32 -> target_id[4:4]
value %result: test.i32 -> target_id[4:4]
