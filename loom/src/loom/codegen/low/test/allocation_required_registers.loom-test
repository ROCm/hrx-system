// Authored reloads cannot recursively spill. Their copies must drain the
// eight-register bank before a third four-register load is admitted.
// RUN: emit low-allocation-query @reloads_32 strategy=resource-stall spill-free spill-count values=%first,%second,%third

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @reloads_32(%input: reg<test.pressure.alias32 x4>) -> (reg<test.i32 x12>) asm {
  %storage = storage {byte_alignment = 4, byte_length = 16} : low.storage<stack>
  low.spill %input, %storage : reg<test.pressure.alias32 x4>, low.storage<stack>
  %first = low.reload %storage : low.storage<stack> -> reg<test.pressure.alias32 x4>
  %first_value = copy %first : reg<test.pressure.alias32 x4> -> reg<test.i32 x4>
  %second = low.reload %storage : low.storage<stack> -> reg<test.pressure.alias32 x4>
  %second_value = copy %second : reg<test.pressure.alias32 x4> -> reg<test.i32 x4>
  %third = low.reload %storage : low.storage<stack> -> reg<test.pressure.alias32 x4>
  %third_value = copy %third : reg<test.pressure.alias32 x4> -> reg<test.i32 x4>
  %result = concat(%first_value, %second_value, %third_value) : (reg<test.i32 x4>, reg<test.i32 x4>, reg<test.i32 x4>) -> reg<test.i32 x12>
  return %result
}

// ----
spills: 0
materialized traffic: stores=0 reloads=0
value %first: test.pressure.alias32 -> physical_register[0:4]
value %second: test.pressure.alias32 -> physical_register[0:4]
value %third: test.pressure.alias32 -> physical_register[0:4]

// ====

// Authored reloads cannot recursively spill. Their copies must drain the
// eight-register bank before a third four-register load is admitted.
// RUN: emit low-allocation-query @reloads_64 strategy=resource-stall spill-free spill-count values=%first,%second,%third

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @reloads_64(%input: reg<test.pressure.alias64 x4>) -> (reg<test.i64 x12>) asm {
  %storage = storage {byte_alignment = 8, byte_length = 32} : low.storage<stack>
  low.spill %input, %storage : reg<test.pressure.alias64 x4>, low.storage<stack>
  %first = low.reload %storage : low.storage<stack> -> reg<test.pressure.alias64 x4>
  %first_value = copy %first : reg<test.pressure.alias64 x4> -> reg<test.i64 x4>
  %second = low.reload %storage : low.storage<stack> -> reg<test.pressure.alias64 x4>
  %second_value = copy %second : reg<test.pressure.alias64 x4> -> reg<test.i64 x4>
  %third = low.reload %storage : low.storage<stack> -> reg<test.pressure.alias64 x4>
  %third_value = copy %third : reg<test.pressure.alias64 x4> -> reg<test.i64 x4>
  %result = concat(%first_value, %second_value, %third_value) : (reg<test.i64 x4>, reg<test.i64 x4>, reg<test.i64 x4>) -> reg<test.i64 x12>
  return %result
}

// ----
spills: 0
