// RUN: emit low-allocation-query @later_restricted_value values=%persistent,%restricted

test.target<low_core> @target

// The persistent broad value stays in general storage, leaving the restricted
// domain available to the later narrow value.
low.func.def target<test.low.core>(@target) @later_restricted_value(%persistent: reg<test.explicit32>) -> (reg<test.explicit32>, reg<test.packed.narrow>) asm {
  %restricted = test.const.packed.narrow 7
  return %persistent, %restricted
}

