value %source: test.explicit32 -> physical_register[2:1]
value %result: test.explicit32 -> physical_register[2:1]
copy %source -> %result: coalesced

// ====

// RUN: emit low-allocation-query @future_fixed_copy values=%source,%result copies=%result fixed=%result:physical_register:2:1

test.target<low_core> @target

// The later result location is known before interval assignment. Preserve that
// copy affinity instead of moving the source through idle narrower storage.
low.func.def target<test.low.core>(@target) @future_fixed_copy(%source: reg<test.explicit32>, %peer0: reg<test.explicit32>, %peer1: reg<test.explicit32>, %restricted: reg<test.packed.narrow>) -> (reg<test.explicit32>, reg<test.explicit32>, reg<test.explicit32>, reg<test.packed.narrow>) asm {
  %result = copy %source : reg<test.explicit32> -> reg<test.explicit32>
  return %result, %peer0, %peer1, %restricted
}

// ----
value %source: test.explicit32 -> physical_register[2:1]
value %result: test.explicit32 -> physical_register[2:1]
copy %source -> %result: coalesced

// ====

// RUN: emit low-allocation-query @loop_initializer_keeps_future_domain_available values=%initial,%state,%restricted

test.target<low_core> @target

// The initializer ends before the restricted value starts. Its loop affinity
// carries the state lifetime through one general candidate, leaving the
// restricted domain available inside the loop.
low.func.def target<test.low.core>(@target) @loop_initializer_keeps_future_domain_available(%condition: reg<test.i32>) -> (reg<test.explicit32>, reg<test.packed.narrow>) asm {
  %initial = test.const.explicit32 1
  low.br ^loop(%initial: reg<test.explicit32>)
^loop(%state: reg<test.explicit32>):
  %restricted = test.const.packed.narrow 7
  low.cond_br %condition, ^body, ^exit : reg<test.i32>
^body:
  low.br ^loop(%state: reg<test.explicit32>)
^exit:
  return %state, %restricted
}

// ----
value %initial: test.explicit32 -> physical_register[2:1]
value %state: test.explicit32 -> physical_register[2:1]
value %restricted: test.packed.narrow -> physical_register[0:1]

// ====

// RUN: emit low-allocation-query @loop_relocation_observes_atomic_alias values=%seed,%state,%next,%blocker_source,%blocker,%peer fixed=%seed:physical_register:2:1 fixed=%next:physical_register:0:1 fixed=%peer:physical_register:8:1

test.target<low_core> @target

// test.r0 and test.a0 have distinct physical-register IDs but own the same
// atomic storage unit. The exit-only alias can share with the backedge source,
// but it blocks relocating the loop header onto that source location. %peer
// occupies the other alias candidate without fixing the blocker itself.
low.func.def target<test.low.core>(@target) @loop_relocation_observes_atomic_alias(%condition: reg<test.i32>, %seed: reg<test.explicit32>, %peer: reg<test.alias.narrow>) -> (reg<test.explicit32>, reg<test.alias.narrow>, reg<test.alias.narrow>) asm {
  low.br ^loop(%seed: reg<test.explicit32>)
^loop(%state: reg<test.explicit32>):
  low.cond_br %condition, ^body, ^exit : reg<test.i32>
^body:
  %next = test.const.explicit32 1
  low.br ^loop(%next: reg<test.explicit32>)
^exit:
  %blocker_source = test.const.explicit32 2
  %blocker = copy %blocker_source : reg<test.explicit32> -> reg<test.alias.narrow>
  return %state, %blocker, %peer
}

// ----
value %seed: test.explicit32 -> physical_register[2:1]
value %state: test.explicit32 -> physical_register[2:1]
value %next: test.explicit32 -> physical_register[0:1]
value %blocker_source: test.explicit32 -> physical_register[3:1]
value %blocker: test.alias.narrow -> physical_register[7:1]
value %peer: test.alias.narrow -> physical_register[8:1]

