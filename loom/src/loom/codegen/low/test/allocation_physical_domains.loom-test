// RUN: emit low-allocation-query @copy_keeps_general_storage values=%source,%result copies=%result fixed=%source:physical_register:2:1

test.target<low_core> @target

// The source is already in general-only storage while one narrow candidate is
// idle. Preserve the copy affinity because it does not consume the candidate
// reserved for the overlapping restricted value.
low.func.def target<test.low.core>(@target) @copy_keeps_general_storage(%source: reg<test.explicit32>, %peer0: reg<test.explicit32>, %peer1: reg<test.explicit32>, %restricted: reg<test.packed.narrow>) -> (reg<test.explicit32>, reg<test.explicit32>, reg<test.explicit32>, reg<test.packed.narrow>) asm {
  %result = copy %source : reg<test.explicit32> -> reg<test.explicit32>
  return %result, %peer0, %peer1, %restricted
}

