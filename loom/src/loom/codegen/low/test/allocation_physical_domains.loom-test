low.func.def target<test.low.core>(@target) @coindexed_result_peer(%live: reg<test.coindexed.partner>) -> (reg<test.packed.narrow>, reg<test.coindexed.partner>, reg<test.coindexed.partner>) asm {
  %primary, %partner = test.coindexed.results
  return %primary, %partner, %live
}

