// ====

// RUN: emit low-allocation-query @rotating_versions_remain_distinct values=%first,%second,%left,%right,%restricted

test.target<low_core> @target

// The backedge connects both arguments through one affinity component. Their
// simultaneously live versions retain distinct locations while one narrow
// candidate remains reserved.
low.func.def target<test.low.core>(@target) @rotating_versions_remain_distinct(%condition: reg<test.i32>, %first: reg<test.explicit32>, %second: reg<test.explicit32>) -> (reg<test.explicit32>, reg<test.explicit32>, reg<test.packed.narrow>) asm {
  low.br ^loop(%first: reg<test.explicit32>, %second: reg<test.explicit32>)
^loop(%left: reg<test.explicit32>, %right: reg<test.explicit32>):
  %restricted = test.const.packed.narrow 7
  low.cond_br %condition, ^body, ^exit : reg<test.i32>
^body:
  low.br ^loop(%right: reg<test.explicit32>, %left: reg<test.explicit32>)
^exit:
  return %left, %right, %restricted
}

// ----
value %first: test.explicit32 -> physical_register[2:1]
value %second: test.explicit32 -> physical_register[1:1]
value %left: test.explicit32 -> physical_register[2:1]
value %right: test.explicit32 -> physical_register[1:1]
value %restricted: test.packed.narrow -> physical_register[0:1]

// ====

// RUN: emit low-allocation-query @soft_affinity_fallback_counts_as_broad_demand values=%probe,%affine0,%affine2

test.target<low_core> @target

// The fixed copies prefer r0 and r2, but their broad sources may fall back.
// Together with the probe, that class demand exceeds the sole general r1
// candidate. The probe borrows idle r3 before the restricted value needs it.
low.func.def target<test.low.core>(@target) @soft_affinity_fallback_counts_as_broad_demand(%probe: reg<test.explicit32>, %affine0: reg<test.explicit32>, %affine2: reg<test.explicit32>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.coindexed.partner>) asm {
  %probe_value = copy %probe : reg<test.explicit32> -> reg<test.i32>
  %fixed0 = copy %affine0 : reg<test.explicit32> -> reg<test.fixed.r0>
  %value0 = copy %fixed0 : reg<test.fixed.r0> -> reg<test.i32>
  %fixed2 = copy %affine2 : reg<test.explicit32> -> reg<test.fixed.r2>
  %value2 = copy %fixed2 : reg<test.fixed.r2> -> reg<test.i32>
  %narrow_source = test.const.explicit32 7
  %restricted = copy %narrow_source : reg<test.explicit32> -> reg<test.coindexed.partner>
  return %probe_value, %value0, %value2, %restricted
}

// ----
value %probe: test.explicit32 -> physical_register[3:1]
value %affine0: test.explicit32 -> physical_register[0:1]
value %affine2: test.explicit32 -> physical_register[2:1]

// ====

// Both inputs prefer a later R0 copy, but their fallback storage must leave
// both narrow registers available until those copies execute.
// RUN: emit low-allocation-query @fallback_reserves_narrow values=%first,%second,%narrow0,%narrow1,%fixed0,%fixed1

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @fallback_reserves_narrow(%first: reg<test.explicit32>, %second: reg<test.explicit32>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>) asm {
  %narrow0 = test.const.packed.narrow 7
  %narrow1 = test.const.packed.narrow 9
  %narrow_value0 = copy %narrow0 : reg<test.packed.narrow> -> reg<test.i32>
  %narrow_value1 = copy %narrow1 : reg<test.packed.narrow> -> reg<test.i32>
  %fixed0 = copy %first : reg<test.explicit32> -> reg<test.fixed.r0>
  %value0 = copy %fixed0 : reg<test.fixed.r0> -> reg<test.i32>
  %fixed1 = copy %second : reg<test.explicit32> -> reg<test.fixed.r0>
  %value1 = copy %fixed1 : reg<test.fixed.r0> -> reg<test.i32>
  return %narrow_value0, %narrow_value1, %value0, %value1
}

// ----
value %first: test.explicit32 -> physical_register[2:1]
value %second: test.explicit32 -> physical_register[3:1]
value %narrow0: test.packed.narrow -> physical_register[1:1]
value %narrow1: test.packed.narrow -> physical_register[0:1]
value %fixed0: test.fixed.r0 -> physical_register[0:1]
value %fixed1: test.fixed.r0 -> physical_register[0:1]

// ====

// The restricted register is a differently named pair of atomic scalar units.
// Copy preferences still leave both units available across the pair's lifetime.
// RUN: emit low-allocation-query @fallback_reserves_atomic_pair values=%first,%second,%narrow,%fixed0,%fixed1

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @fallback_reserves_atomic_pair(%first: reg<test.explicit32>, %second: reg<test.explicit32>, %source: reg<test.i64>) -> (reg<test.i64>, reg<test.i32>, reg<test.i32>) asm {
  %narrow = copy %source : reg<test.i64> -> reg<test.atomic.narrow>
  %narrow_value = copy %narrow : reg<test.atomic.narrow> -> reg<test.i64>
  %fixed0 = copy %first : reg<test.explicit32> -> reg<test.fixed.r0>
  %value0 = copy %fixed0 : reg<test.fixed.r0> -> reg<test.i32>
  %fixed1 = copy %second : reg<test.explicit32> -> reg<test.fixed.r0>
  %value1 = copy %fixed1 : reg<test.fixed.r0> -> reg<test.i32>
  return %narrow_value, %value0, %value1
}

// ----
value %first: test.explicit32 -> physical_register[1:1]
value %second: test.explicit32 -> physical_register[3:1]
value %narrow: test.atomic.narrow -> physical_register[4:1]
value %fixed0: test.fixed.r0 -> physical_register[0:1]
value %fixed1: test.fixed.r0 -> physical_register[0:1]

