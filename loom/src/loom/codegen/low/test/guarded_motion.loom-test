// ====

// Widening a lane-local execution mask preserves all previously active lanes.
// Its read must move before the narrowing write, not just before the branch.
// RUN: emit low-packet-json @mask_narrowing strategy=resource-stall
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @mask_narrowing(%base: reg<test.ptr>, %origin: reg<test.i32>, %pixel: reg<test.i32>, %color: reg<test.i32 x4>) asm {
  %condition = test.event.fast.i32 %origin, %pixel
  %active = test.mask.narrow.i32 %condition
  low.cond_br %active, ^store, ^done : reg<test.i32>
^store:
  %index = test.masked.add.i32 %origin, %pixel
  test.store.index.v4i32 %base, %index, %color
  low.br ^done
^done:
  return
}

