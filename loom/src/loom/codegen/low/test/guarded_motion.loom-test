// Independent total arithmetic fills issue slots while the guard waits for
// its condition. The indexed store remains conditional.
// RUN: emit low-packet-json @available_issue_slots strategy=resource-stall
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @available_issue_slots(%base: reg<test.ptr>, %origin: reg<test.i32>, %pixel: reg<test.i32>, %color: reg<test.i32 x4>) asm {
  %condition = test.event.fast.i32 %origin, %pixel
  low.cond_br %condition, ^store, ^done : reg<test.i32>
^store:
  %index = test.total.add.i32 %origin, %pixel
  test.store.index.v4i32 %base, %index, %color
  low.br ^done
^done:
  return
}

