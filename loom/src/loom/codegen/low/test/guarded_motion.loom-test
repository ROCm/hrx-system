// ====

// An immediately available condition leaves no issue slots to fill.
// RUN: emit low-packet-json @short_guard strategy=resource-stall
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @short_guard(%base: reg<test.ptr>, %origin: reg<test.i32>, %pixel: reg<test.i32>, %color: reg<test.i32 x4>) asm {
  low.cond_br %pixel, ^store, ^done : reg<test.i32>
^store:
  %index = test.total.add.i32 %origin, %pixel
  test.store.index.v4i32 %base, %index, %color
  low.br ^done
^done:
  return
}

