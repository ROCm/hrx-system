// ====

// The condition is ready after one cycle, but its producer occupies the scalar
// unit for four. Moving another scalar operation grows the predecessor despite
// passing the latency bound. Rejection restores the original instruction order.
// RUN: emit low-packet-json @occupied_issue_slots strategy=resource-stall
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @occupied_issue_slots(%base: reg<test.ptr>, %origin: reg<test.i32>, %pixel: reg<test.i32>, %color: reg<test.i32 x4>) asm {
  %condition = test.resource.serial.i32 %origin, %pixel
  low.cond_br %condition, ^store, ^done : reg<test.i32>
^store:
  %index = test.total.add.i32 %origin, %pixel
  test.store.index.v4i32 %base, %index, %color
  low.br ^done
^done:
  return
}

