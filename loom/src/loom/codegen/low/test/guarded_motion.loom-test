// ====

// The intervening load/store block keeps its schedule as the later arithmetic
// moves into the guard. Packet formation consumes the new node indices and
// memory records after the accepted trial retires the original frame.
// RUN: emit low-packet-json @intervening_memory strategy=resource-stall
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @intervening_memory(%base: reg<test.ptr>, %origin: reg<test.i32>, %pixel: reg<test.i32>, %color: reg<test.i32 x4>) asm {
  %condition = test.event.fast.i32 %origin, %pixel
  low.cond_br %condition, ^store, ^copy : reg<test.i32>
^copy:
  %loaded = test.load.v4i32 %base
  test.store.v4i32 %base, %loaded
  low.br ^done
^store:
  %index = test.total.add.i32 %origin, %pixel
  test.store.index.v4i32 %base, %index, %color
  low.br ^done
^done:
  return
}

