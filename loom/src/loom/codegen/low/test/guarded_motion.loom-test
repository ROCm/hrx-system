// ====

// Backedge placement moves %state away from its incoming %seed. Guarded
// scheduling must replay the final location while moving independent address
// arithmetic, rather than choosing the initial edge's old location again.
// RUN: emit low-packet-json @relocated_loop_header strategy=resource-stall fixed=%seed:target_id:0:1 fixed=%next:target_id:10:1

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @relocated_loop_header(%base: reg<test.ptr>, %origin: reg<test.i32>, %pixel: reg<test.i32>, %color: reg<test.i32 x4>, %seed: reg<test.i32>) -> (reg<test.i32>) asm {
  low.br ^loop(%seed: reg<test.i32>)
^loop(%state: reg<test.i32>):
  %condition = test.event.fast.i32 %origin, %pixel
  low.cond_br %condition, ^store, ^done : reg<test.i32>
^store:
  %index = test.total.add.i32 %origin, %pixel
  test.store.index.v4i32 %base, %index, %color
  %next = test.const.i32 1
  low.br ^loop(%next: reg<test.i32>)
^done:
  return %state
}

