// ====

// Reading the mask as data is total but depends on its exact value. It cannot
// cross the narrowing write using the permission for lane-local execution.
// RUN: emit low-packet-json @mask_as_data strategy=resource-stall
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @mask_as_data(%base: reg<test.ptr>, %origin: reg<test.i32>, %pixel: reg<test.i32>, %color: reg<test.i32 x4>) asm {
  %condition = test.event.fast.i32 %origin, %pixel
  %active = test.mask.narrow.i32 %condition
  low.cond_br %active, ^store, ^done : reg<test.i32>
^store:
  %index = test.mask.sample.i32
  test.store.index.v4i32 %base, %index, %color
  low.br ^done
^done:
  return
}

