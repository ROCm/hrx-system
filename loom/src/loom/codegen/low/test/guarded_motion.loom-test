// ====

// Authored locked schedules preserve placement even with available issue slots.
// RUN: emit low-packet-json @locked_guard strategy=resource-stall
test.target<low_core> @target

low.func.def schedule(locked) target<test.low.core>(@target) @locked_guard(%base: reg<test.ptr>, %origin: reg<test.i32>, %pixel: reg<test.i32>, %color: reg<test.i32 x4>) asm {
  %condition = test.event.fast.i32 %origin, %pixel
  low.cond_br %condition, ^store, ^done : reg<test.i32>
^store:
  %index = test.total.add.i32 %origin, %pixel
  test.store.index.v4i32 %base, %index, %color
  low.br ^done
^done:
  return
}

