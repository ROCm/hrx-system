low.func.def target<test.low.core>(@target) @while_entry_capture(%condition: reg<test.i32>, %seed: reg<test.i32>) -> (reg<test.i32>) asm {
  // REMARK@+1: BACKEND/043 {source_value_name="seed", result_value_name="before", decision="rejected"}
  %result = low.scf.while(%before = %seed : reg<test.i32>) -> (reg<test.i32>) {
    // REMARK@+2: BACKEND/043 {source_value_name="before", result_value_name="state", decision="accepted"}
    // REMARK@+1: BACKEND/043 {source_value_name="before", result_value_name="result", decision="accepted"}
    low.scf.condition %condition, %before : reg<test.i32>, reg<test.i32>
  } do(%state: reg<test.i32>) {
    %next = test.add.i32 %state, %seed
    // REMARK@+1: BACKEND/043 {source_value_name="next", result_value_name="before", decision="accepted"}
    low.scf.yield %next : reg<test.i32>
  }
  return %result
}

