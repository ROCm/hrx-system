// ====

// Storage handles stay in the shared SSA domain while only their materialized
// addresses participate in register allocation across blocks.
// RUN: emit low-allocation-query @storage_addresses values=%first,%second spill-count

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @storage_addresses() -> (reg<test.i32>, reg<test.i32>) asm {
  %slot = storage {byte_alignment = 8, byte_length = 16} : low.storage<private>
  %first = storage_address %slot : low.storage<private> -> reg<test.i32>
  low.br ^middle
^middle:
  low.br ^exit
^exit:
  %view = storage_view %slot {byte_length = 8, offset = 8} : low.storage<private> -> low.storage<private>
  %second = storage_address %view : low.storage<private> -> reg<test.i32>
  return %first, %second
}

