// RUN: with-checks emit low-allocation @if_live_out diagnostics=placement-decisions

test.target<low_core> @target

// A yield does not consume an external value needed after the enclosing if.
low.func.def target<test.low.core>(@target) @if_live_out(%condition: reg<test.i32>, %captured: reg<test.i32>, %alternate: reg<test.i32>) -> (reg<test.i32>) asm {
  %chosen = low.scf.if %condition -> (reg<test.i32>) {
    // REMARK@+1: BACKEND/043 {source_value_name="captured", result_value_name="chosen", decision="rejected"}
    low.scf.yield %captured : reg<test.i32>
  } else {
    // REMARK@+1: BACKEND/043 {source_value_name="alternate", result_value_name="chosen", decision="accepted"}
    low.scf.yield %alternate : reg<test.i32>
  }
  %result = test.add.i32 %chosen, %captured
  return %result
}

