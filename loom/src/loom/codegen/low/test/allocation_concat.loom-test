// RUN: emit low-allocation-query @shared_tail_concat_source spill-count values=%shared,%initial0,%initial1,%initial2,%initial,%temporary0,%renewed0,%temporary1,%renewed1,%blocker,%temporary2,%renewed2,%renewed

test.target<low_core> @target

// The shared tail first assembles with initial, then remains live for renewed.
// Its committed unit cannot anchor both aggregates. Renewed's unique sources
// reserve units 4..6, move the independent blocker, and copy only the shared
// tail into unit 7.
low.func.def schedule(locked) target<test.low.core>(@target) @shared_tail_concat_source(%shared: reg<test.phys>) -> (reg<test.phys x4>, reg<test.phys x4>, reg<test.phys>) asm {
  %initial0 = test.add.phys %shared, %shared
  %initial1 = test.add.phys %shared, %shared
  %initial2 = test.add.phys %shared, %shared
  %initial = concat(%initial0, %initial1, %initial2, %shared) : (reg<test.phys>, reg<test.phys>, reg<test.phys>, reg<test.phys>) -> reg<test.phys x4>
  %temporary0 = test.add.phys %shared, %shared
  %renewed0 = test.add.phys %temporary0, %temporary0
  %temporary1 = test.add.phys %shared, %shared
  %renewed1 = test.add.phys %temporary1, %temporary1
  %blocker = test.add.phys %shared, %shared
  %temporary2 = test.add.phys %shared, %shared
  %renewed2 = test.add.phys %temporary2, %temporary2
  %renewed = concat(%renewed0, %renewed1, %renewed2, %shared) : (reg<test.phys>, reg<test.phys>, reg<test.phys>, reg<test.phys>) -> reg<test.phys x4>
  return %initial, %renewed, %blocker
}

