CHECK: *"spill_count":0,*"name":"state"*"location":{"kind":"physical_register","base":5,"count":2}*"name":"low"*"location":{"kind":"physical_register","base":1,"count":1}*"name":"high"*"location":{"kind":"physical_register","base":3,"count":1}*"name":"pair"*"location":{"kind":"physical_register","base":5,"count":2}*

