// The lane3-last producer order initially strands lane2 outside of its compact
// result span. One independent temporary can move within the same five-register
// extent, allowing every concat source to use its retained result slice.
low.func.def target<test.low.core>(@target) @compact_concat_lane3_last(%seed: reg<test.phys>) -> (reg<test.phys x4>) asm {
  %temporary0 = test.add.phys %seed, %seed
  %lane0 = test.add.phys %temporary0, %temporary0
  %temporary1 = test.add.phys %seed, %seed
  %lane1 = test.add.phys %temporary1, %temporary1
  %temporary2 = test.add.phys %seed, %seed
  %lane2 = test.add.phys %temporary2, %temporary2
  %temporary3 = test.add.phys %seed, %seed
  %lane3 = test.add.phys %temporary3, %lane0
  %values = concat(%lane0, %lane1, %lane2, %lane3) : (reg<test.phys>, reg<test.phys>, reg<test.phys>, reg<test.phys>) -> reg<test.phys x4>
  return %values
}

