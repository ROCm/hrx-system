// RUN: with-checks emit low-allocation-json @partial_concat_keeps_live_source fixed=%low:physical_register:0:2 fixed=%high:physical_register:4:2

test.target<low_core> @target

// The tuple shares units 0..1 with low and copies high into units 2..3.
// Both original sources remain observable after the assembled tuple is copied.
low.func.def target<test.low.core>(@target) @partial_concat_keeps_live_source(%low: reg<test.phys x2>, %high: reg<test.phys x2>) -> (reg<test.phys x4>, reg<test.phys x4>, reg<test.phys x2>, reg<test.phys x2>) asm {
  %tuple = concat(%low, %high) : (reg<test.phys x2>, reg<test.phys x2>) -> reg<test.phys x4>
  %copy = copy %tuple : reg<test.phys x4> -> reg<test.phys x4>
  return %copy, %tuple, %low, %high
}

// ----
CHECK: *"spill_count":0,*"name":"low"*"base":0,"count":2}*"name":"high"*"base":4,"count":2}*"name":"tuple"*"base":0,"count":4}*

