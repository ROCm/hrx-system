// RUN: emit low-allocation-json @decomposed_scalar_backedge

test.target<low_core> @target

// Decomposed edge reads keep their original sources live across the backedge.
low.func.def target<test.low.core>(@target) @decomposed_scalar_backedge(%condition: reg<test.i32>, %seed: reg<test.i32>) -> (reg<test.i32>) asm {
  %packed = concat(%seed, %seed) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32 x2>
  low.br ^outer(%condition: reg<test.i32>)
^outer(%total: reg<test.i32>):
  low.cond_br %condition, ^initialize, ^exit : reg<test.i32>
^initialize:
  low.br ^body(%packed: reg<test.i32 x2>)
^body(%current: reg<test.i32 x2>):
  %lane = slice %current[0] : reg<test.i32 x2> -> reg<test.i32>
  %changed = test.add.i32 %lane, %total
  low.br ^outer(%changed: reg<test.i32>)
^exit:
  return %total
}

