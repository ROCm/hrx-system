// RUN: with-checks emit low-allocation-json @partial_concat_preserves_unmatched_sources fixed=%first:physical_register:0:2 fixed=%second:physical_register:4:2 fixed=%third:physical_register:2:2

test.target<low_core> @target

// Sharing first at base 0 would swap second and third over their live originals.
// Only matching subranges can be exempted from interference.
low.func.def target<test.low.core>(@target) @partial_concat_preserves_unmatched_sources(%first: reg<test.phys x2>, %second: reg<test.phys x2>, %third: reg<test.phys x2>) -> (reg<test.phys x6>, reg<test.phys x6>, reg<test.phys x2>, reg<test.phys x2>) asm {
  %tuple = concat(%first, %second, %third) : (reg<test.phys x2>, reg<test.phys x2>, reg<test.phys x2>) -> reg<test.phys x6>
  %copy = copy %tuple : reg<test.phys x6> -> reg<test.phys x6>
  return %copy, %tuple, %second, %third
}

// ----
CHECK: *"spill_count":0,*"name":"second"*"base":4,"count":2}*"name":"third"*"base":2,"count":2}*"name":"tuple"*"base":6,"count":6}*

