// RUN: emit low-allocation-query @nested_concat_preserves_blocker spill-count values=%state,%blocker,%lane0,%lane1,%low,%lane2,%lane3,%high,%tuple fixed=%state:physical_register:0:4 fixed=%seed:physical_register:8:1

test.target<low_core> @target

// An independent live value already occupies the preferred first state unit.
// A transitive preference must not relocate it to place a nested concat leaf.
low.func.def schedule(locked) target<test.low.core>(@target) @nested_concat_preserves_blocker(%condition: reg<test.i32>, %initial: reg<test.phys x4>, %seed: reg<test.phys>) -> (reg<test.phys x4>) asm {
  low.br ^loop(%initial: reg<test.phys x4>)
^loop(%state: reg<test.phys x4>):
  low.cond_br %condition, ^produce, ^exit : reg<test.i32>
^produce:
  %blocker = test.add.phys %seed, %seed
  %lane0 = test.add.phys %seed, %seed
  %lane1 = test.add.phys %seed, %seed
  %low = concat(%lane0, %lane1) : (reg<test.phys>, reg<test.phys>) -> reg<test.phys x2>
  %lane2 = test.add.phys %seed, %seed
  %lane3 = test.add.phys %blocker, %seed
  %high = concat(%lane2, %lane3) : (reg<test.phys>, reg<test.phys>) -> reg<test.phys x2>
  %tuple = concat(%low, %high) : (reg<test.phys x2>, reg<test.phys x2>) -> reg<test.phys x4>
  low.br ^loop(%tuple: reg<test.phys x4>)
^exit:
  return %state
}

// ----
spills: 0
value %state: test.phys -> physical_register[0:4]
value %blocker: test.phys -> physical_register[0:1]
value %lane0: test.phys -> physical_register[2:1]
value %lane1: test.phys -> physical_register[3:1]
value %low: test.phys -> physical_register[2:2]
value %lane2: test.phys -> physical_register[4:1]
value %lane3: test.phys -> physical_register[5:1]
value %high: test.phys -> physical_register[4:2]
value %tuple: test.phys -> physical_register[0:4]

// ====

// A reload result must occupy a register through its concat definition. The
// later block's decomposed edge read keeps that physical source reservation
// alive across a CFG boundary after its semantic SSA lifetime ends. When
// low-register pressure spills the concat, the store becomes the complete
// observation and the source reservation can retire so %candidate reuses
// register zero.
// RUN: emit low-allocation-query @spill_materializes_decomposed_concat_source strategy=source spill-count spill-plans=%packed values=%source,%packed,%candidate test.i32=8 fixed=%source:target_id:0:1 fixed=%blocker1:target_id:1:1 fixed=%blocker2:target_id:2:1 fixed=%blocker3:target_id:3:1 fixed=%other:target_id:4:1

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @spill_materializes_decomposed_concat_source(%other: reg<test.i32>, %blocker1: reg<test.i32>, %blocker2: reg<test.i32>, %blocker3: reg<test.i32>) -> (reg<test.i32 x2>, reg<test.i32>) asm {
  %source_storage = storage {byte_alignment = 4, byte_length = 4} : low.storage<private>
  %candidate_storage = storage {byte_alignment = 4, byte_length = 4} : low.storage<private>
  %source = low.reload %source_storage : low.storage<private> -> reg<test.i32>
  %packed = concat(%source, %other) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32 x2>
  low.br ^pressure
^pressure:
  %candidate = test.add.i32 %blocker1, %blocker2
  %bounded = test.add.low4.i32 %candidate, %blocker3
  low.spill %candidate, %candidate_storage : reg<test.i32>, low.storage<private>
  %keep1 = test.add.i32 %blocker1, %blocker1
  %keep2 = test.add.i32 %blocker2, %keep1
  %keep3 = test.add.i32 %blocker3, %keep2
  %result = test.add.i32 %bounded, %keep3
  low.br ^exit(%packed: reg<test.i32 x2>)
^exit(%state: reg<test.i32 x2>):
  return %state, %result
}

// ----
spills: 1
value %source: test.i32 -> target_id[0:1]
value %packed: test.i32 -> spill_slot[0:2]
value %candidate: test.i32 -> target_id[0:1]
spill %packed: private[0] bytes=8 align=8 stores=1 reloads=1

// ====

// RUN: emit low-allocation-query @compact_concat_uses_other_fallback_slot strategy=source spill-count copy-count values=%historical,%blocker,%lane0,%lane1,%lane2,%lane3,%values fixed=%seed:physical_register:6:1 fixed=%occupy0:physical_register:0:1 fixed=%occupy1:physical_register:1:1 fixed=%occupy3:physical_register:3:1 fixed=%historical:physical_register:4:1 fixed=%values:physical_register:0:4 fixed=%lane3:physical_register:3:1

test.target<low_core> @target

// The fixed occupiers force %blocker into lane 2's result slice, then die
// before the concat sources. Lane 2's ordinary fallback is v4, but %historical
// occupied it earlier in the blocker's lifetime. V5 remains legal inside the
// register extent already established by %seed.
low.func.def target<test.low.core>(@target) @compact_concat_uses_other_fallback_slot(%seed: reg<test.phys>) -> (reg<test.phys x4>) asm {
  %occupy0 = test.add.phys %seed, %seed
  %occupy1 = test.add.phys %seed, %seed
  %occupy3 = test.add.phys %seed, %seed
  %historical = test.add.phys %seed, %seed
  %blocker = test.add.phys %seed, %seed
  %occupy0_end = test.add.phys %occupy0, %occupy0
  %occupy1_end = test.add.phys %occupy1, %occupy1
  %occupy3_end = test.add.phys %occupy3, %occupy3
  %historical_end = test.add.phys %historical, %historical
  %lane0 = test.add.phys %seed, %seed
  %lane1 = test.add.phys %seed, %seed
  %lane2 = test.add.phys %seed, %seed
  %lane3 = test.add.phys %blocker, %seed
  %values = concat(%lane0, %lane1, %lane2, %lane3) : (reg<test.phys>, reg<test.phys>, reg<test.phys>, reg<test.phys>) -> reg<test.phys x4>
  return %values
}

// ----
spills: 0
copies: coalesced=0 materialized=0
value %historical: test.phys -> physical_register[4:1]
value %blocker: test.phys -> physical_register[5:1]
value %lane0: test.phys -> physical_register[0:1]
value %lane1: test.phys -> physical_register[1:1]
value %lane2: test.phys -> physical_register[2:1]
value %lane3: test.phys -> physical_register[3:1]
value %values: test.phys -> physical_register[0:4]

// ====

// RUN: emit low-allocation-query @compact_concat_lane2_last strategy=resource-stall spill-count values=%temporary0,%temporary1,%temporary2,%temporary3,%lane0,%lane1,%lane2,%lane3,%values fixed=%seed:physical_register:2:1 fixed=%values:physical_register:0:4 fixed=%lane3:physical_register:3:1

test.target<low_core> @target

// Reordering the two independent producer pairs already gives every source its
// result slice directly and must not perturb the compact assignment.
low.func.def target<test.low.core>(@target) @compact_concat_lane2_last(%seed: reg<test.phys>) -> (reg<test.phys x4>) asm {
  %temporary0 = test.add.phys %seed, %seed
  %lane0 = test.add.phys %temporary0, %temporary0
  %temporary1 = test.add.phys %seed, %seed
  %lane1 = test.add.phys %temporary1, %temporary1
  %temporary3 = test.add.phys %seed, %seed
  %lane3 = test.add.phys %temporary3, %lane0
  %temporary2 = test.add.phys %seed, %seed
  %lane2 = test.add.phys %temporary2, %temporary2
  %values = concat(%lane0, %lane1, %lane2, %lane3) : (reg<test.phys>, reg<test.phys>, reg<test.phys>, reg<test.phys>) -> reg<test.phys x4>
  return %values
}

