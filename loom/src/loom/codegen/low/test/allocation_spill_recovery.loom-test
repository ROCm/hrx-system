// Each pair is consumed immediately, while one scalar survives to the return.
// Scheduling every reload before those consumers exhausts the eight-register
// bank. Spill-free planning must recover a feasible order for the actual units.
// RUN: emit low-allocation-query @partial_reload_lifetimes_32 strategy=resource-stall spill-free spill-count values=%first,%second,%third,%fourth,%fifth,%parts

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @partial_reload_lifetimes_32(%input: reg<test.pressure.alias32 x2>) -> (reg<test.i32 x10>, reg<test.pressure.alias32 x5>) asm {
  %storage = storage {byte_alignment = 4, byte_length = 8} : low.storage<stack>
  low.spill %input, %storage : reg<test.pressure.alias32 x2>, low.storage<stack>
  %first = low.reload %storage : low.storage<stack> -> reg<test.pressure.alias32 x2>
  %value0 = copy %first : reg<test.pressure.alias32 x2> -> reg<test.i32 x2>
  %part0 = slice %first[0] : reg<test.pressure.alias32 x2> -> reg<test.pressure.alias32>
  %second = low.reload %storage : low.storage<stack> -> reg<test.pressure.alias32 x2>
  %value1 = copy %second : reg<test.pressure.alias32 x2> -> reg<test.i32 x2>
  %part1 = slice %second[0] : reg<test.pressure.alias32 x2> -> reg<test.pressure.alias32>
  %third = low.reload %storage : low.storage<stack> -> reg<test.pressure.alias32 x2>
  %value2 = copy %third : reg<test.pressure.alias32 x2> -> reg<test.i32 x2>
  %part2 = slice %third[0] : reg<test.pressure.alias32 x2> -> reg<test.pressure.alias32>
  %fourth = low.reload %storage : low.storage<stack> -> reg<test.pressure.alias32 x2>
  %value3 = copy %fourth : reg<test.pressure.alias32 x2> -> reg<test.i32 x2>
  %part3 = slice %fourth[0] : reg<test.pressure.alias32 x2> -> reg<test.pressure.alias32>
  %fifth = low.reload %storage : low.storage<stack> -> reg<test.pressure.alias32 x2>
  %value4 = copy %fifth : reg<test.pressure.alias32 x2> -> reg<test.i32 x2>
  %part4 = slice %fifth[0] : reg<test.pressure.alias32 x2> -> reg<test.pressure.alias32>
  %payload = concat(%value0, %value1, %value2, %value3, %value4) : (reg<test.i32 x2>, reg<test.i32 x2>, reg<test.i32 x2>, reg<test.i32 x2>, reg<test.i32 x2>) -> reg<test.i32 x10>
  %parts = concat(%part0, %part1, %part2, %part3, %part4) : (reg<test.pressure.alias32>, reg<test.pressure.alias32>, reg<test.pressure.alias32>, reg<test.pressure.alias32>, reg<test.pressure.alias32>) -> reg<test.pressure.alias32 x5>
  return %payload, %parts
}

