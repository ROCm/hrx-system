spills: 0
materialized traffic: stores=2 reloads=2
value %first: test.pressure.alias32 -> physical_register[0:2]
value %second: test.pressure.alias32 -> physical_register[1:2]
value %third: test.pressure.alias32 -> physical_register[2:2]
value %fourth: test.pressure.alias32 -> physical_register[3:2]
value %fifth: test.pressure.alias32 -> physical_register[4:2]
value %parts: test.pressure.alias32 -> physical_register[0:5]

