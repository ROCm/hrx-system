// ====

// A single reload wider than the physical bank cannot be repaired by a new
// schedule or by recursively spilling its result.
// RUN: emit low-allocation-query @oversized_reload strategy=resource-stall spill-free

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @oversized_reload() -> (reg<test.i32 x9>) asm {
  %storage = storage {byte_alignment = 4, byte_length = 36} : low.storage<stack>
  // ERROR@+1: BACKEND/005 "spill-traffic-register-exhausted"
  %value = low.reload %storage : low.storage<stack> -> reg<test.pressure.alias32 x9>
  %result = copy %value : reg<test.pressure.alias32 x9> -> reg<test.i32 x9>
  return %result
}
