// ====

// A single reload wider than the physical bank cannot be repaired by a new
// schedule or by recursively spilling its result.
// RUN: emit low-allocation-query @oversized_reload strategy=resource-stall spill-free

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @oversized_reload() -> (reg<test.i32 x9>) asm {
  %storage = storage {byte_alignment = 4, byte_length = 36} : low.storage<stack>
  // ERROR@+1: BACKEND/005 "spill-traffic-register-exhausted"
  %value = low.reload %storage : low.storage<stack> -> reg<test.pressure.alias32 x9>
  %result = copy %value : reg<test.pressure.alias32 x9> -> reg<test.i32 x9>
  return %result
}

// ====

// A scalar projection can reserve its final aggregate unit while the wider
// source is still live. The other aggregate units are acquired only as their
// producers execute; this must fit the same six-register extent.
// RUN: emit low-allocation-query @slice_before_full_use strategy=source spill-free spill-count values=%first,%second,%third,%fourth,%fifth,%parts

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @slice_before_full_use(%input: reg<test.pressure.alias32 x2>) -> (reg<test.i32 x10>, reg<test.pressure.alias32 x5>) asm {
