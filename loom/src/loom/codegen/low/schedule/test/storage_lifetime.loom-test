// ====

// Repacking lanes in a different order gives the tuple a new home. A read
// through that tuple must not pin the old header's registers to the new order.
// RUN: emit low-schedule-query @reordered_header kind=storage-lifetime strategy=resource-stall consumer=6

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @reordered_header(%seed: reg<test.i32 x2>, %rhs: reg<test.i32>) asm {
  low.br ^loop(%seed: reg<test.i32 x2>)
^loop(%carried: reg<test.i32 x2>):
  %lo = slice %carried[0] : reg<test.i32 x2> -> reg<test.i32>
  %hi = slice %carried[1] : reg<test.i32 x2> -> reg<test.i32>
  %flipped = concat(%hi, %lo) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32 x2>
  %field = slice %flipped[0] : reg<test.i32 x2> -> reg<test.i32>
  %read = test.add.i32 %field, %rhs
  %next = test.mul.i32 %rhs, %rhs
  %reuse = concat(%next, %lo) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32 x2>
  test.event.memory.write.i32 %read
  low.br ^loop(%reuse: reg<test.i32 x2>)
}

