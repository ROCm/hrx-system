node 6 <- none

// ====

// An incoming detached copy may write the header only after its reader; its
// producer writes different storage and remains free to issue early.
// RUN: emit low-schedule-query @detached_incoming kind=storage-lifetime strategy=resource-stall consumer=2,3

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @detached_incoming(%seed: reg<test.i32>, %rhs: reg<test.i32>) asm {
  low.br ^loop(%seed: reg<test.i32>)
^loop(%carried: reg<test.i32>):
  %read = test.add.i32 %carried, %rhs
  %next = test.mul.i32 %rhs, %rhs
  %home = move %next {detached = true} : reg<test.i32> -> reg<test.i32>
  test.event.memory.write.i32 %read
  low.br ^loop(%home: reg<test.i32>)
}

