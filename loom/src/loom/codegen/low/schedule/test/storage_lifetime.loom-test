// A conditional endpoint consumes its predicate rather than forwarding it.
// Fixed-register setup therefore remains independent from ordinary arithmetic.
// RUN: emit low-schedule @consuming_condition_endpoint strategy=resource-stall diagnostics=candidates output=none

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @consuming_condition_endpoint(%condition_source: reg<test.i32>, %lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>) asm {
  %condition = copy %condition_source : reg<test.i32> -> reg<test.fixed.r0>
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="0", chosen_packet="test.mul.i32", rejected_packet="low.copy", rejected_pressure_cliff_source="test.fixed.r0"}
  %result = test.mul.i32 %lhs, %rhs
  low.cond_br %condition, ^taken, ^not_taken : reg<test.fixed.r0>
^taken:
  return %result
^not_taken:
  return %result
}
