node 4 <- 3

// ====

// Each scalar producer replaces one unit of a header defined in another block.
// A nonzero nested slice passes through a move and an ordered reassembly.
// Reading unit 2 constrains its replacement independently of units 0, 1, and 3.
// RUN: emit low-schedule-query @projected_unit kind=storage-lifetime strategy=resource-stall consumer=9,10,11,12

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @projected_unit(%seed: reg<test.i32 x4>, %rhs: reg<test.i32>, %again: reg<test.i32>) -> (reg<test.i32 x4>) asm {
  low.br ^loop(%seed: reg<test.i32 x4>)
^loop(%carried: reg<test.i32 x4>):
  low.cond_br %again, ^body, ^exit : reg<test.i32>
^body:
  %pair = slice %carried[2] : reg<test.i32 x4> -> reg<test.i32 x2>
  %lo = slice %pair[0] : reg<test.i32 x2> -> reg<test.i32>
  %hi = slice %pair[1] : reg<test.i32 x2> -> reg<test.i32>
  %joined = concat(%lo, %hi) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32 x2>
  %view = move %joined : reg<test.i32 x2> -> reg<test.i32 x2>
  %lane = slice %view[0] : reg<test.i32 x2> -> reg<test.i32>
  %read = test.add.i32 %lane, %rhs
  %a = test.mul.i32 %rhs, %rhs
  %b = test.mul.i32 %rhs, %rhs
  %c = test.mul.i32 %rhs, %rhs
  %d = test.mul.i32 %rhs, %rhs
  %next = concat(%a, %b, %c, %d) : (reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>) -> reg<test.i32 x4>
  test.event.memory.write.i32 %read
  low.br ^loop(%next: reg<test.i32 x4>)
^exit:
  return %carried
}

