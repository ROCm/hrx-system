// Independent scopes may interleave, but each phase waits for every operation
// in the preceding phase of the same scope.
// RUN: emit low-schedule @independent_scopes strategy=resource-stall diagnostics=candidates output=none

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @independent_scopes(%pointer: reg<test.ptr>) -> (reg<test.i32 x4>, reg<test.i32 x4>) asm {
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="0", chosen_packet="low.schedule.begin", rejected_packet="low.schedule.begin"}
  low.schedule.begin
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="2", chosen_packet="test.load.v4i32", rejected_packet="test.load.v4i32"}
  %first = test.load.v4i32 %pointer
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="3", chosen_packet="low.schedule.phase", rejected_packet="test.load.v4i32"}
  low.schedule.phase
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="6", chosen_packet="test.add.v4i32", rejected_packet="test.add.v4i32"}
  %first_sum = test.add.v4i32 %first, %first
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="7", chosen_packet="low.schedule.end", rejected_packet="test.add.v4i32"}
  low.schedule.end
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="1", chosen_packet="low.schedule.begin", rejected_packet="test.load.v4i32"}
  low.schedule.begin
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="4", chosen_packet="test.load.v4i32", rejected_packet="test.add.v4i32"}
  %second = test.load.v4i32 %pointer
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="5", chosen_packet="low.schedule.phase", rejected_packet="test.add.v4i32"}
  low.schedule.phase
  %second_sum = test.add.v4i32 %second, %second
  low.schedule.end
  return %first_sum, %second_sum
}

// ====

// Unrelated payload may overlap a nested scope, while the nested scope itself
// remains one ordered member of its parent's current phase.
// RUN: emit low-schedule @nested_scopes strategy=resource-stall diagnostics=candidates output=none

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @nested_scopes(%pointer: reg<test.ptr>, %lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>, reg<test.i32 x4>) asm {
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="1", chosen_packet="low.schedule.begin", rejected_packet="test.add.v4i32"}
  low.schedule.begin
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="2", chosen_packet="low.schedule.phase", rejected_packet="test.add.v4i32"}
  low.schedule.phase
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="3", chosen_packet="low.schedule.begin", rejected_packet="test.add.v4i32"}
  low.schedule.begin
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="4", chosen_packet="test.add.i32", rejected_packet="test.add.v4i32"}
  %sum = test.add.i32 %lhs, %rhs
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="5", chosen_packet="low.schedule.phase", rejected_packet="test.add.v4i32"}
  low.schedule.phase
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="6", chosen_packet="low.schedule.end", rejected_packet="test.add.v4i32"}
  low.schedule.end
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="7", chosen_packet="low.schedule.phase", rejected_packet="test.add.v4i32"}
  low.schedule.phase
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="8", chosen_packet="test.mul.i32", rejected_packet="test.add.v4i32"}
  %product = test.mul.i32 %sum, %rhs
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="9", chosen_packet="low.schedule.end", rejected_packet="test.add.v4i32"}
  low.schedule.end
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="0", chosen_packet="test.load.v4i32", rejected_packet="low.schedule.begin"}
  %loaded = test.load.v4i32 %pointer
  %used = test.add.v4i32 %loaded, %loaded
  return %product, %used
}

// ====

// The entry scope reaches both successors. Each branch therefore schedules its
// scalar operation before the phase and its vector operation after it. Losing
// that inherited scope makes the independent operations compete.
// RUN: emit low-schedule @scope_across_cfg strategy=resource-stall diagnostics=candidates output=none

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @scope_across_cfg(%condition: reg<test.i32>, %pointer: reg<test.ptr>, %lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32 x4>, reg<test.i32>) asm {
  low.schedule.begin
  %loaded = test.load.v4i32 %pointer
  low.cond_br %condition, ^left, ^right : reg<test.i32>
^left:
  %left_tag = test.add.i32 %lhs, %rhs
  low.schedule.phase
  %left_value = test.add.v4i32 %loaded, %loaded
  low.br ^join(%left_value: reg<test.i32 x4>, %left_tag: reg<test.i32>)
^right:
  %right_tag = test.mul.i32 %lhs, %rhs
  low.schedule.phase
  %right_value = test.add.v4i32 %loaded, %loaded
  low.br ^join(%right_value: reg<test.i32 x4>, %right_tag: reg<test.i32>)
^join(%result: reg<test.i32 x4>, %tag: reg<test.i32>):
  low.schedule.end
  return %result, %tag
}

// ====

// Operations inside one implicit function phase remain freely schedulable. The
// next phase becomes ready only after both have issued.
// RUN: emit low-schedule @function_phases strategy=resource-stall diagnostics=candidates output=none

test.target<low_core> @target

low.func.def schedule(phased) target<test.low.core>(@target) @function_phases(%pointer: reg<test.ptr>, %lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32 x4>, reg<test.i32>) asm {
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="0", chosen_packet="test.load.v4i32", rejected_packet="test.add.i32"}
  %loaded = test.load.v4i32 %pointer
  %tag = test.add.i32 %lhs, %rhs
  low.schedule.phase
  %result = test.add.v4i32 %loaded, %loaded
  return %result, %tag
}
