// Scratch descriptors order reads and writes across access widths, including
// the read that precedes a partial overwrite. Addresses come from Low storage.
// RUN: emit low-schedule-query @scratch_chain strategy=resource-stall kind=effect consumer=2,4,6,8

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @scratch_chain(%live: reg<test.i32 x2>) -> (reg<test.i32 x2>) asm {
  %storage = storage {byte_alignment = 8, byte_length = 8} : low.storage<private>
  %initial_address = storage_address %storage : low.storage<private> -> reg<test.ptr>
  test.private.store.v2i32 %initial_address, %live
  %narrow_load_address = storage_address %storage : low.storage<private> -> reg<test.ptr>
  %narrow = test.private.load.i32 %narrow_load_address
  %narrow_store_address = storage_address %storage : low.storage<private> -> reg<test.ptr>
  test.private.store.i32 %narrow_store_address, %narrow
  %final_address = storage_address %storage : low.storage<private> -> reg<test.ptr>
  %wide = test.private.load.v2i32 %final_address
  return %wide
}

// ----
node 2 <- 0
node 4 <- 0, 2
node 6 <- 0, 2, 4
node 8 <- 0, 6

// ====

// Materialized literal addresses preserve the same scratch access ordering.
// RUN: emit low-schedule-query @literal_chain strategy=resource-stall kind=effect consumer=1,3,5,7

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @literal_chain(%live: reg<test.i32 x2>) -> (reg<test.i32 x2>) asm {
  %initial_address = test.const.ptr 0
  test.private.store.v2i32 %initial_address, %live
  %narrow_load_address = test.const.ptr 0
  %narrow = test.private.load.i32 %narrow_load_address
  %narrow_store_address = test.const.ptr 0
  test.private.store.i32 %narrow_store_address, %narrow
  %final_address = test.const.ptr 0
  %wide = test.private.load.v2i32 %final_address
  return %wide
}

// ----
node 1 <- none
node 3 <- 1
node 5 <- 1, 3
node 7 <- 5

// ====

// Arithmetic and private transfers read state before its saved value is
// restored. Address materialization can wait until the stored sum is ready.
// RUN: emit low-schedule-query @scratch_arithmetic strategy=resource-stall order=* scheduled-pressure=test.i32 kind=state consumer=7

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @scratch_arithmetic(%input: reg<test.i32>, %held: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %saved_state = test.state.sample.i32
  %storage = storage {byte_alignment = 4, byte_length = 4} : low.storage<private>
  %left = test.state.read.i32 %input
  %right = test.state.read.i32 %held
  %address = storage_address %storage : low.storage<private> -> reg<test.ptr>
  %sum = test.add.i32 %left, %right
  test.private.store.i32 %address, %sum
  test.state.assign.i32 %saved_state
  return %input, %held
}

// ----
block 0 order: 2, 1, 3, 5, 4, 6, 0, 7, 8
scheduled pressure test.i32: peak-live-units=4 peak-live-values=4
node 7 <- 0, 2, 3, 6
