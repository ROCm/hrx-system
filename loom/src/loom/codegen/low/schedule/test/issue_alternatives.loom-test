// Encoding-equivalent forms let independent source-identical operations use
// distinct resources in the same issue cycle.
// RUN: emit low-schedule-query @encoding_equivalent_schedule_alternatives strategy=resource-stall issue=0,1 descriptor=0,1

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @encoding_equivalent_schedule_alternatives(%lhs0: reg<test.i32>, %rhs0: reg<test.i32>, %lhs1: reg<test.i32>, %rhs1: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %a = test.schedule.alternative.a.i32 %lhs0, %rhs0
  %b = test.schedule.alternative.a.i32 %lhs1, %rhs1
  return %a, %b
}

// ----
node 0 issue-cycle: 0
node 1 issue-cycle: 0
node 0 descriptor: test.schedule.alternative.a.i32
node 1 descriptor: test.schedule.alternative.b.i32

// ====

// The dependent add must use A, even though it is not ready when the first
// operation issues. On equal issue cycles the movable operation leaves A free.
// RUN: emit low-schedule-query @fixed_a strategy=resource-stall descriptor=0,1

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @fixed_a(%lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>) asm {
  %either = test.schedule.alternative.a.i32 %lhs, %rhs
  %fixed = test.add.i32 %either, %rhs
  return %fixed
}

// ----
node 0 descriptor: test.schedule.alternative.b.i32
node 1 descriptor: test.add.i32

// ====

// The same movable operation has the opposite choice when the fixed
// consumer uses B. Fixed demand belongs to one block at a time.
// RUN: emit low-schedule-query @successive_blocks strategy=resource-stall descriptor=0,1,3,4

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @successive_blocks(%lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>) asm {
  %first = test.schedule.alternative.a.i32 %lhs, %rhs
  %fixed_a = test.add.i32 %first, %rhs
  low.br ^next(%fixed_a: reg<test.i32>)
^next(%partial: reg<test.i32>):
  %second = test.schedule.alternative.a.i32 %partial, %rhs
  %fixed_b = test.schedule.alternative.b.i32 %second, %rhs
  return %fixed_b
}

// ----
node 0 descriptor: test.schedule.alternative.b.i32
node 1 descriptor: test.add.i32
node 3 descriptor: test.schedule.alternative.a.i32
node 4 descriptor: test.schedule.alternative.b.i32
