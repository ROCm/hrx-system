// RUN: emit low-schedule-json @scheduled_hazards strategy=source

test.target<low_core> @target

// Resource distances and counter waits retain distinct descriptor identities.
// Block-local timing restarts at the branch, so the last load has no gap.
low.func.def target<test.low.core>(@target) @scheduled_hazards(%pointer: reg<test.ptr>) asm {
  %first = test.load.v4i32 %pointer
  %second = test.load.v4i32 %pointer
  %counted = test.counter_load.v4i32 %pointer
  low.br ^next
^next:
  %last = test.load.v4i32 %pointer
  return
}

