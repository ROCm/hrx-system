// ====

// The source remains live after expansion, so the ordinary result really
// grows the packed footprint. Release the independent input before expanding.
// RUN: emit low-schedule-json @register_packing_persistent_growth strategy=resource-stall diagnostics=candidates output=none

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @register_packing_persistent_growth(%source: reg<test.packed.narrow>, %releasable: reg<test.packed.narrow>) -> (reg<test.packed.narrow>, reg<test.i32>, reg<test.i32>) asm {
  %expanded = test.packing.expand %source
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="0", chosen_packet="low.copy", rejected_packet="test.packing.expand", chosen_pressure_cliff_penalty="0", rejected_pressure_cliff_source="test.pair_slots", rejected_pressure_cliff_units="3"}
  %released = copy %releasable : reg<test.packed.narrow> -> reg<test.i32>
  %result = test.packing.retire %expanded, %expanded
  return %source, %released, %result
}

// ====

// An early-clobber result overlaps both inputs before either can retire.
// Release the independent narrow input first to make room for that overlap.
// RUN: emit low-schedule-json @register_packing_early_overlap strategy=resource-stall diagnostics=candidates output=none

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @register_packing_early_overlap(%source: reg<test.packed.narrow>, %releasable: reg<test.packed.narrow>) -> (reg<test.i32>, reg<test.i32>) asm {
  %expanded = test.packing.early.expand %source
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="0", chosen_packet="low.copy", rejected_packet="test.packing.early.expand", chosen_pressure_cliff_penalty="0", rejected_pressure_cliff_source="test.pair_slots", rejected_pressure_cliff_penalty="1"}
  %released = copy %releasable : reg<test.packed.narrow> -> reg<test.i32>
  %result = test.packing.retire %expanded, %expanded
  return %released, %result
}

// ====

// One producer publishes a temporary and a forwarded sibling in the same
// packing resource. The temporary's completion is not the sibling's release.
// RUN: emit low-schedule-query @register_packing_forwarded_sibling strategy=resource-stall order=0,1,2,3,4,5,6,7

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @register_packing_forwarded_sibling(%first_source: reg<test.i32>, %configuration: reg<test.i32>, %second_source: reg<test.i32>) -> (reg<test.packed.wide x2>, reg<test.i32>, reg<test.i32>) asm {
  %first_narrow = test.packing.create %first_source
  %carried, %temporary = test.packing.configured.expand %first_narrow, %configuration
  %second_narrow = test.packing.create %second_source
  %second_temporary = test.packing.expand %second_narrow
  %first_result = test.packing.retire %temporary, %temporary
  %second_result = test.packing.retire %second_temporary, %second_temporary
  low.br ^exit(%carried: reg<test.packed.wide x2>, %first_result: reg<test.i32>, %second_result: reg<test.i32>)
^exit(%kept: reg<test.packed.wide x2>, %first: reg<test.i32>, %second: reg<test.i32>):
  return %kept, %first, %second
}

