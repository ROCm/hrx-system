block 0 order: 0, 2, 4, 6, 8, 1, 3, 5, 7, 9

// ====

// RUN: emit low-schedule-json @register_packing_retains_active_completion_during_pressure_recovery strategy=resource-stall diagnostics=candidates output=none

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @register_packing_retains_active_completion_during_pressure_recovery(%source0: reg<test.i32>, %source1: reg<test.i32>, %lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32>) asm {
  // Isolate setup and the first transaction so the second narrow value owns
  // the active aggregate completion when pressure recovery begins.
  %narrow0 = test.packing.create %source0
  low.schedule.fence
  %narrow1 = test.packing.create %source1
  low.schedule.fence
  %config0 = test.const.i32 0
  %lhs_wide0, %rhs_wide0 = test.packing.configured.expand %narrow0, %config0
  %result0 = test.packing.retire %lhs_wide0, %rhs_wide0
  low.schedule.fence
  // The scalar add has more immediate headroom, but cannot displace the
  // retained completion when candidate comparison enters pressure recovery.
  %unrelated = test.add.i32 %lhs, %rhs
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="8", chosen_packet="test.const.i32", rejected_packet="test.add.i32", chosen_pressure_cliff_penalty="1", rejected_pressure_cliff_penalty="0"}
  %config1 = test.const.i32 1
  low.schedule.fence
  %lhs_wide1, %rhs_wide1 = test.packing.configured.expand %narrow1, %config1
  %result1 = test.packing.retire %lhs_wide1, %rhs_wide1
  return %result0, %result1, %unrelated
}

// ====

// Keep a shared producer live while preparing the peer needed to retire each
// expanded branch. Opening more branches cannot replace their shared source.
// The source, branch, and peer necessarily exceed the two-slot bank. This
// exercises scheduling under unavoidable debt, not successful allocation.
// RUN: emit low-schedule-json @register_packing_fanout strategy=resource-stall diagnostics=candidates output=none

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @register_packing_fanout(%source: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32>) asm {
  // REMARK@+1: BACKEND/015 {chosen_packet="test.packing.create", rejected_packet="test.const.packed.narrow"}
  %table = test.packing.create %source
  // REMARK@+1: BACKEND/015 {chosen_packet="test.packing.expand", rejected_packet="test.const.packed.narrow"}
  %first = test.packing.expand %table
  // REMARK@+1: BACKEND/015 {chosen_packet="test.packing.expand", rejected_packet="test.packing.expand"}
  %second = test.packing.expand %table
  %third = test.packing.expand %table
  // REMARK@+1: BACKEND/015 {chosen_packet="test.const.packed.narrow", rejected_packet="test.packing.expand"}
  %peer = test.const.packed.narrow 1
  // REMARK@+1: BACKEND/015 {chosen_packet="test.packing.expand", rejected_packet="test.packing.expand"}
  %wide_peer = test.packing.expand %peer
  // REMARK@+1: BACKEND/015 {chosen_packet="test.packing.retire", rejected_packet="test.packing.expand"}
  %result0 = test.packing.retire %first, %wide_peer
  // REMARK@+1: BACKEND/015 {chosen_packet="test.packing.retire", rejected_packet="test.packing.expand"}
  %result1 = test.packing.retire %second, %wide_peer
  %result2 = test.packing.retire %third, %wide_peer
  return %result0, %result1, %result2
}

// ====

// Non-final uses preserve the shared narrow source while each expansion is
// retired. Repeated operands still complete their producer in one instruction.
// RUN: emit low-schedule-json @register_packing_fanout_repeated_operand strategy=resource-stall diagnostics=candidates output=none

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @register_packing_fanout_repeated_operand(%source: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %table = test.packing.create %source
  // REMARK@+1: BACKEND/015 {chosen_packet="test.packing.expand", rejected_packet="test.packing.expand"}
  %first = test.packing.expand %table
  %second = test.packing.expand %table
  // Both occurrences consume the final uses of the expanded value.
  // REMARK@+1: BACKEND/015 {chosen_killed_live_units="2", chosen_packet="test.packing.retire", rejected_packet="test.packing.expand"}
  %r0 = test.packing.retire %first, %first
  %r1 = test.packing.retire %second, %second
  return %r0, %r1
}

// ====

// Values produced by an earlier source range are already live when the next
// range opens and do not add another copy of their packed-resource footprint.
// RUN: emit low-schedule-json @register_packing_excludes_prior_range_activation strategy=resource-stall diagnostics=candidates output=none

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @register_packing_excludes_prior_range_activation(%source0: reg<test.i32>, %source1: reg<test.i32>, %lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %prior_narrow = test.packing.create %source0
  %prior_wide = test.packing.expand %prior_narrow
  low.schedule.fence
  // REMARK@+1: BACKEND/015 {chosen_packet="test.packing.create", rejected_packet="test.add.i32", chosen_pressure_cliff_source="test.packed.wide", chosen_pressure_cliff_penalty="2"}
  %new_narrow = test.packing.create %source1
  %unrelated = test.add.i32 %lhs, %rhs
  // REMARK@+1: BACKEND/015 {chosen_packet="test.packing.expand", rejected_packet="test.add.i32"}
  %new_wide = test.packing.expand %new_narrow
  // REMARK@+1: BACKEND/015 {chosen_packet="test.packing.retire", rejected_packet="test.add.i32"}
  %result = test.packing.retire %prior_wide, %new_wide
  return %result, %unrelated
}

// ====

// Live-ins can fill a packing resource without establishing a producer-owned
// completion sink. Advance the config that exposes their continuation before
// unrelated pressure relief.
// RUN: emit low-schedule-query @register_packing_advances_live_in_continuations strategy=resource-stall order=0,1,2,3,4

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @register_packing_advances_live_in_continuations(%live_narrow: reg<test.packed.narrow>, %live_wide: reg<test.packed.wide>, %address: reg<test.ptr>, %value: reg<test.i32 x4>, %config_lhs: reg<test.i32>, %config_rhs: reg<test.i32>) -> (reg<test.i32>, reg<test.packed.wide>) asm {
  test.store.v4i32 %address, %value
  %config = test.mul.i32 %config_lhs, %config_rhs
  %wide0, %wide1 = test.packing.configured.expand %live_narrow, %config
  %result = test.packing.retire %wide0, %wide1
  return %result, %live_wide
}

