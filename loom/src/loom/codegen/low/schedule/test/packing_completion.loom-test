block 0 order: 0, 2, 1, 3, 5, 4, 6, 8, 7, 9, 10

// ====

// The peer remains owned by the successor, but each temporary really retires.
// Finish the first temporary before opening the second packed transaction.
// RUN: emit low-schedule-query @register_packing_forwarded_peer strategy=resource-stall order=0,1,2,3,4,5,6,7

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @register_packing_forwarded_peer(%carried_peer: reg<test.packed.wide x2>, %first_source: reg<test.i32>, %second_source: reg<test.i32>) -> (reg<test.packed.wide x2>, reg<test.i32>, reg<test.i32>) asm {
  %first_narrow = test.packing.create %first_source
  %first_temporary = test.packing.expand %first_narrow
  %second_narrow = test.packing.create %second_source
  %second_temporary = test.packing.expand %second_narrow
  %first_result = test.packing.retire %first_temporary, %carried_peer
  %second_result = test.packing.retire %second_temporary, %carried_peer
  low.br ^exit(%carried_peer: reg<test.packed.wide x2>, %first_result: reg<test.i32>, %second_result: reg<test.i32>)
^exit(%kept: reg<test.packed.wide x2>, %first: reg<test.i32>, %second: reg<test.i32>):
  return %kept, %first, %second
}

