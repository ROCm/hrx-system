// ====

// Both expansions retain the shared narrow input. The early-clobber branch
// reaches the selected packing exit even though issuing it cannot release
// that input. Following the retained exit keeps the ordinary expansion from
// opening a competing pair before the early-clobber result retires.
// RUN: emit low-schedule-json @register_packing_completion_through_shared_input strategy=resource-stall diagnostics=candidates output=none

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @register_packing_completion_through_shared_input(%source: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %shared = test.packing.create %source
  %ordinary = test.packing.expand %shared
  // REMARK@+1: BACKEND/015 {chosen_packet="test.packing.early.expand", rejected_packet="test.packing.expand"}
  %overlapping = test.packing.early.expand %shared
  // REMARK@+1: BACKEND/015 {chosen_packet="test.packing.retire", rejected_packet="test.packing.expand"}
  %overlapping_result = test.packing.retire %overlapping, %overlapping
  %ordinary_result = test.packing.retire %ordinary, %ordinary
  return %ordinary_result, %overlapping_result
}
