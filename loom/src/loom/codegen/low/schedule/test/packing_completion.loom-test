// ====

// Two narrow inputs fill the pair slots. Replacing one with a wide result
// still fits: the dying input and ordinary result occupy different phases.
// Repeated-operand consumers require no additional packed peers.
// RUN: emit low-schedule-query @register_packing_replacement_phases strategy=resource-stall order=0,1,2,3

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @register_packing_replacement_phases(%first: reg<test.packed.narrow>, %second: reg<test.packed.narrow>) -> (reg<test.i32>, reg<test.i32>) asm {
  %first_wide = test.packing.expand %first
  %second_wide = test.packing.expand %second
  %first_result = test.packing.retire %first_wide, %first_wide
  %second_result = test.packing.retire %second_wide, %second_wide
  return %first_result, %second_result
}

