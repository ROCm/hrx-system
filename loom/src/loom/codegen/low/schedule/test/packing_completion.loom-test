// ====

// Retiring a derived value cannot release its forwarded source. The independent
// transaction completes while that source stays live; the derived value then
// retains its own genuine local completion.
// RUN: emit low-schedule-query @register_packing_forwarded_source_derived_release strategy=resource-stall order=0,1,2,3,4,5,6,7

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @register_packing_forwarded_source_derived_release(%first_source: reg<test.i32>, %second_source: reg<test.i32>) -> (reg<test.packed.narrow>, reg<test.i32>, reg<test.i32>) asm {
  %carried = test.packing.create %first_source
  %derived = test.packing.expand %carried
  %second_narrow = test.packing.create %second_source
  %second_temporary = test.packing.expand %second_narrow
  %derived_result = test.packing.retire %derived, %derived
  %second_result = test.packing.retire %second_temporary, %second_temporary
  low.br ^exit(%carried: reg<test.packed.narrow>, %derived_result: reg<test.i32>, %second_result: reg<test.i32>)
^exit(%kept: reg<test.packed.narrow>, %first: reg<test.i32>, %second: reg<test.i32>):
  return %kept, %first, %second
}

