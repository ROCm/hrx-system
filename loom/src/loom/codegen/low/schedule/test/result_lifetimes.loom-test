// A dead carry needs a destination at issue, but has no live storage demand.
// RUN: emit low-schedule-query @dead_carry strategy=resource-stall order=* scheduled-pressure=test.alias32

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @dead_carry(%lhs: reg<test.phys>, %rhs: reg<test.phys>) -> (reg<test.phys>) asm {
  %first = test.add.phys %lhs, %rhs
  %second = test.add.phys %rhs, %lhs
  %sum, %carry = test.add.carry.phys %first, %second
  return %sum
}

// ----
block 0 order: 0, 1, 2, 3
scheduled pressure test.alias32: none

// ====

// A returned carry retains its physical storage.
// RUN: emit low-schedule-query @returned_carry strategy=resource-stall order=* scheduled-pressure=test.alias32

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @returned_carry(%lhs: reg<test.phys>, %rhs: reg<test.phys>) -> (reg<test.phys>, reg<test.alias32>) asm {
  %first = test.add.phys %lhs, %rhs
  %second = test.add.phys %rhs, %lhs
  %sum, %carry = test.add.carry.phys %first, %second
  return %sum, %carry
}

// ----
block 0 order: 0, 1, 2, 3
scheduled pressure test.alias32: peak-live-units=1 peak-live-values=1
