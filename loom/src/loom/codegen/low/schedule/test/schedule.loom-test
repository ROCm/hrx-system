  // REMARK@+1: BACKEND/015 {scheduled_ordinal="0", chosen_packet="test.load.v4i32", rejected_packet="test.add.i32"}
  %load0 = test.load.v4i32 %ptr0
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="1", chosen_packet="test.add.i32", rejected_packet="test.extract_lane.i32", rejected_data_ready_stall_cycles="4"}
  %gap0 = test.add.i32 %index, %index
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="2", chosen_packet="test.add.i32", rejected_packet="test.extract_lane.i32", chosen_data_ready_stall_cycles="1", rejected_data_ready_stall_cycles="4"}
  %gap1 = test.add.i32 %gap0, %index
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="3", chosen_packet="test.add.i32", rejected_packet="test.extract_lane.i32", chosen_data_ready_stall_cycles="1", rejected_data_ready_stall_cycles="3"}
  %gap2 = test.add.i32 %gap1, %index
  %lane = test.extract_lane.i32 %load0, 0
  %lane1 = test.add.i32 %lane, %index
  %lane2 = test.add.i32 %lane1, %index
  // The indexed load is one cycle away while the older lane extraction is two
  // cycles away, so the actual issue timeline opens the load first.
