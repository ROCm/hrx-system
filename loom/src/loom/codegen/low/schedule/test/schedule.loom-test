// RUN: emit low-schedule-json @early_tied_pressure_reuses_storage strategy=resource-stall diagnostics=candidates test.i32=16 output=none

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @early_tied_pressure_reuses_storage(
    %src: reg<test.i32 x4>, %lhs: reg<test.i32 x4>,
    %rhs: reg<test.i32 x4>) -> (reg<test.i32 x4>, reg<test.i32 x4>) {
  %tied = low.op<test.early_tied.v4i32>(%src) :
      (reg<test.i32 x4>) -> %src as reg<test.i32 x4>
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="0", scored_candidate_count="2", chosen_packet="test.add.v4i32", rejected_packet="test.early_tied.v4i32", chosen_pressure_cliff_penalty="0", rejected_pressure_cliff_penalty="0"}
  %sum = low.op<test.add.v4i32>(%lhs, %rhs) :
      (reg<test.i32 x4>, reg<test.i32 x4>) -> reg<test.i32 x4>
  low.return %tied, %sum : reg<test.i32 x4>, reg<test.i32 x4>
}

