    %state_lhs: reg<test.schedule_state>, %state_rhs: reg<test.schedule_state>) {
  %snapshot = low.op<test.add.schedule_state>(%state_lhs, %state_rhs) : (reg<test.schedule_state>, reg<test.schedule_state>) -> reg<test.schedule_state>
  %first_clobber = low.op<test.state.add.schedule_state>(%state_lhs, %state_rhs) : (reg<test.schedule_state>, reg<test.schedule_state>) -> reg<test.schedule_state>
  %second_clobber = low.op<test.state.add.schedule_state>(%state_lhs, %state_rhs) : (reg<test.schedule_state>, reg<test.schedule_state>) -> reg<test.schedule_state>
  %read = low.op<test.explicit.state.add.schedule_state>(%state_lhs, %snapshot) : (reg<test.schedule_state>, reg<test.schedule_state>) -> reg<test.schedule_state>
  low.return
}

