  // REMARK@+1: BACKEND/015
  %lane6 = test.extract_lane.i32 %load0, 2
  // REMARK@+1: BACKEND/015
  %lane7 = test.extract_lane.i32 %load0, 3
  // REMARK@+1: BACKEND/015
  %lane8 = test.extract_lane.i32 %load0, 0
  // REMARK@+1: BACKEND/015
  %lane9 = test.extract_lane.i32 %load0, 1
  // REMARK@+1: BACKEND/015
