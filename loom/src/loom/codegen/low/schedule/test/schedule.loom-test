// ====
// RUN: emit low-schedule-json @resource_stall_fills_unconstrained_issue_gap strategy=resource-stall diagnostics=candidates output=none

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @resource_stall_fills_unconstrained_issue_gap(%lhs0: reg<test.i32>, %rhs0: reg<test.i32>, %lhs1: reg<test.i32>, %rhs1: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  // REMARK@+1: BACKEND/015
  %prepared0 = test.mul.i32 %lhs0, %rhs0
  %prepared1 = test.mul.i32 %lhs1, %rhs1
  // REMARK@+1: BACKEND/015
  %constant0 = test.const.i32 1
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="3", chosen_packet="test.add.i32", rejected_packet="test.mul.i32"}
  %result0 = test.add.i32 %prepared0, %constant0
  // With no physical pressure limit, issue the ready constant while the
  // first result waits on its multiply instead of introducing a data stall.
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="2", chosen_packet="test.const.i32", rejected_packet="test.add.i32", chosen_data_ready_stall_cycles="0", rejected_data_ready_stall_cycles="1"}
  %constant1 = test.const.i32 2
  %result1 = test.add.i32 %prepared1, %constant1
  return %result0, %result1
}

