// ====
// RUN: emit low-schedule-query @resource_stall_accounts_for_future_unspillable_activation strategy=resource-stall order=0,3

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @resource_stall_accounts_for_future_unspillable_activation(%live0: reg<test.explicit32>, %live1: reg<test.explicit32>, %live2: reg<test.explicit32>, %lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.explicit32>, reg<test.explicit32>, reg<test.explicit32>, reg<test.i32>, reg<test.i32>) asm {
  // This branch eventually occupies the last explicit register. Keep the
  // virtual branch ahead until it completes instead of opening that pressure.
  %physical_path = test.add.i32 %lhs, %rhs
  %physical = copy %physical_path : reg<test.i32> -> reg<test.explicit32>
  %physical_result = copy %physical : reg<test.explicit32> -> reg<test.i32>
  %virtual_path = test.mul.i32 %lhs, %rhs
  %virtual0 = copy %virtual_path : reg<test.i32> -> reg<test.i32>
  %virtual1 = copy %virtual0 : reg<test.i32> -> reg<test.i32>
  return %live0, %live1, %live2, %physical_result, %virtual1
}

