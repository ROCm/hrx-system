test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @resource_stall_forwards_storage_setup_readiness(%ptr: reg<test.ptr>, %lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32 x4>, reg<test.i32>) asm {
  // REMARK@+1: BACKEND/015
  %load = test.load.v4i32 %ptr
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="1", chosen_packet="low.copy", rejected_packet="test.mul.i32", chosen_data_ready_stall_cycles="0"}
  %copy = copy %load : reg<test.i32 x4> -> reg<test.i32 x4>
  %use = test.add.v4i32 %copy, %copy
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="2", chosen_packet="test.mul.i32", rejected_packet="test.add.v4i32", rejected_data_ready_stall_cycles="4"}
  %independent = test.mul.i32 %lhs, %rhs
  return %use, %independent
}

// ====
// RUN: emit low-schedule-json @resource_stall_defers_non_actionable_storage_setup strategy=resource-stall diagnostics=candidates output=none

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @resource_stall_defers_non_actionable_storage_setup(%source: reg<test.i32>, %lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>) asm {
  %copy = copy %source : reg<test.i32> -> reg<test.i32>
  // The copy cannot expose its consumer until the delayed operand is ready, so
  // opening its destination live range now would only hold storage early.
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="0", chosen_packet="test.mul.i32", rejected_packet="low.copy"}
  %delay0 = test.mul.i32 %lhs, %rhs
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="1", chosen_packet="test.add.i32", rejected_packet="low.copy", chosen_data_ready_stall_cycles="1", rejected_data_ready_stall_cycles="0"}
  %delay1 = test.add.i32 %delay0, %rhs
  %result = test.add.i32 %copy, %delay1
  return %result
}

// ====
// RUN: emit low-schedule-query @resource_stall_closes_unspillable_storage_before_reopening kind=order strategy=resource-stall order=0,1,2,3,4 consumer=*

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @resource_stall_closes_unspillable_storage_before_reopening(%condition: reg<test.i32>, %lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  // The first fixed-register setup cannot expose its consumer until the
  // multiply is scheduled.
  %prepared = test.mul.i32 %lhs, %rhs
  %fixed0 = copy %condition : reg<test.i32> -> reg<test.fixed.r0>
  // Completing the open unspillable value must beat a zero-stall setup that
  // would require a second physical register in a one-register class.
  %select0 = test.fixed.select.i32 %prepared, %rhs, %fixed0
  %fixed1 = copy %prepared : reg<test.i32> -> reg<test.fixed.r0>
  %select1 = test.fixed.select.i32 %lhs, %rhs, %fixed1
  return %select0, %select1
}

