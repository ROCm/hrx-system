// RUN: emit low-schedule-json @mixed_early_clobber_pressure strategy=resource-stall diagnostics=candidates test.i32=24 output=none

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @mixed_early_clobber_pressure(
    %early_src: reg<test.i32 x4>, %normal_src: reg<test.i32 x4>,
    %lhs: reg<test.i32 x4>, %rhs: reg<test.i32 x4>) ->
    (reg<test.i32 x4>, reg<test.i32 x4>, reg<test.i32 x4>) {
  %early, %normal =
      low.op<test.mixed_early_clobber.v4i32>(%early_src, %normal_src) :
      (reg<test.i32 x4>, reg<test.i32 x4>) ->
      reg<test.i32 x4>, reg<test.i32 x4>
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="0", scored_candidate_count="2", chosen_packet="test.add.v4i32", rejected_packet="test.mixed_early_clobber.v4i32", chosen_pressure_cliff_penalty="0", rejected_pressure_cliff_penalty="0"}
  %sum = low.op<test.add.v4i32>(%lhs, %rhs) :
      (reg<test.i32 x4>, reg<test.i32 x4>) -> reg<test.i32 x4>
  low.return %early, %normal, %sum :
      reg<test.i32 x4>, reg<test.i32 x4>, reg<test.i32 x4>
}

