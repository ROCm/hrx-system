// ====
// RUN: emit low-schedule-query @resource_stall_accounts_for_non_ssa_unlock_activation strategy=resource-stall order=0,5

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @resource_stall_accounts_for_non_ssa_unlock_activation(%live0: reg<test.explicit32>, %live1: reg<test.explicit32>, %live2: reg<test.explicit32>, %address: reg<test.ptr>, %value: reg<test.i32 x4>, %lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.explicit32>, reg<test.explicit32>, reg<test.explicit32>, reg<test.i32>, reg<test.i32>, reg<test.i32 x4>, reg<test.i32>, reg<test.i32>) asm {
  // Memory ordering makes the store the last non-SSA predecessor of a load
  // chain that opens the final explicit register. Carry that activation to
  // the ready store and finish the virtual branch first.
  test.store.v4i32 %address, %value
  %loaded = test.load.v4i32 %address
  %lane = test.extract_lane.i32 %loaded, 0
  %physical = copy %lane : reg<test.i32> -> reg<test.explicit32>
  %physical_result = copy %physical : reg<test.explicit32> -> reg<test.i32>
  %virtual_path = test.mul.i32 %lhs, %rhs
  %virtual0 = copy %virtual_path : reg<test.i32> -> reg<test.i32>
  %virtual1 = copy %virtual0 : reg<test.i32> -> reg<test.i32>
  return %live0, %live1, %live2, %physical_result, %virtual1, %value, %lhs, %rhs
}

