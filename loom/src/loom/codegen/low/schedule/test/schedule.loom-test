  // REMARK@+1: BACKEND/015 {scheduled_ordinal="5", chosen_packet="test.add.i32", rejected_packet="test.add.i32"}
  %lane5 = test.add.i32 %lhs5, %rhs
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="6", chosen_packet="test.add.i32", rejected_packet="test.add.i32"}
