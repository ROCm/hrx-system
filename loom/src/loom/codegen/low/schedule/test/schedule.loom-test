// ====
// RUN: emit low-schedule-json @resource_stall_materializes_operand_before_pressure_growth strategy=resource-stall diagnostics=candidates test.i32=10 output=none

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @resource_stall_materializes_operand_before_pressure_growth(%pointer: reg<test.ptr>, %lhs: reg<test.i32>, %rhs: reg<test.i32>, %padding: reg<test.i32 x4>) -> (reg<test.i32 x4>, reg<test.i32 x4>, reg<test.i32>) asm {
  // Issuing the load first leaves no headroom for the scalar chain's operand.
  // Materializing that operand allows both scalar inputs to die before the
  // load result opens, keeping the ten-unit budget instead of peaking at eleven.
  %loaded = test.load.v4i32 %pointer
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="0", chosen_packet="test.const.i32", rejected_packet="test.load.v4i32"}
  %constant = test.const.i32 1
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="1", chosen_packet="test.add.i32", rejected_packet="test.load.v4i32"}
  %intermediate = test.add.i32 %lhs, %constant
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="2", chosen_packet="test.add.i32", rejected_packet="test.load.v4i32"}
  %result = test.add.i32 %intermediate, %rhs
  return %loaded, %padding, %result
}

