test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @resource_stall_recovers_descriptor_storage_beyond_source_window(%lhs: reg<test.i32>, %rhs: reg<test.i32>, %part0: reg<test.i32>, %part1: reg<test.i32>, %part2: reg<test.i32>, %part3: reg<test.i32>) -> (reg<test.i32 x4>, reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>) asm {
  // Independent arithmetic fills the source-order nominee window. Once its
  // issue resource is occupied, a ready descriptor-bound alias beyond that
  // window can expose work for another resource without opening new storage.
