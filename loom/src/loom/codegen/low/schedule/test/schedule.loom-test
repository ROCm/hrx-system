// ====
// RUN: emit low-schedule-query @resource_stall_excludes_loop_handoffs_from_unspillable_activation strategy=resource-stall order=1,2,3,4,5,6

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @resource_stall_excludes_loop_handoffs_from_unspillable_activation(%seed0: reg<test.explicit32>, %seed1: reg<test.explicit32>, %seed2: reg<test.explicit32>, %lhs: reg<test.i32>, %rhs: reg<test.i32>) asm {
  low.br ^loop(%seed0: reg<test.explicit32>, %seed1: reg<test.explicit32>, %seed2: reg<test.explicit32>)
^loop(%state0: reg<test.explicit32>, %state1: reg<test.explicit32>, %state2: reg<test.explicit32>):
  // Each backedge value replaces an already-live loop argument. Keep the
  // first update moving instead of charging both replacements as new storage.
  %value0 = copy %state0 : reg<test.explicit32> -> reg<test.i32>
  %path0 = test.add.i32 %value0, %lhs
  %next0 = copy %path0 : reg<test.i32> -> reg<test.explicit32>
  %value1 = copy %state1 : reg<test.explicit32> -> reg<test.i32>
  %path1 = test.add.i32 %value1, %rhs
  %next1 = copy %path1 : reg<test.i32> -> reg<test.explicit32>
  low.br ^loop(%next0: reg<test.explicit32>, %next1: reg<test.explicit32>, %state2: reg<test.explicit32>)
}

