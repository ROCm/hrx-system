low.func.def target<test.low.core>(@test_target) @branch_edge_composed_storage_antidependency(
    %condition: reg<test.i32>, %seed: reg<test.i32 x4>,
    %rhs0: reg<test.i32 x4>, %rhs1: reg<test.i32 x4>) -> (reg<test.i32 x4>) {
  low.br ^loop(%seed: reg<test.i32 x4>)
^loop(%state: reg<test.i32 x4>):
  low.cond_br %condition, ^body, ^exit : reg<test.i32>
^body:
  %read = low.op<test.add.v4i32>(%state, %rhs0) : (reg<test.i32 x4>, reg<test.i32 x4>) -> reg<test.i32 x4>
  %next_low = low.op<test.add.v4i32>(%rhs0, %rhs1) : (reg<test.i32 x4>, reg<test.i32 x4>) -> reg<test.i32 x4>
  %next_high = low.op<test.add.v4i32>(%rhs1, %rhs0) : (reg<test.i32 x4>, reg<test.i32 x4>) -> reg<test.i32 x4>
  %wide = low.concat(%next_low, %next_high) : (reg<test.i32 x4>, reg<test.i32 x4>) -> reg<test.i32 x8>
  %next_slice = low.slice %wide[0] : reg<test.i32 x8> -> reg<test.i32 x4>
  %next = low.copy %next_slice : reg<test.i32 x4> -> reg<test.i32 x4>
  low.br ^loop(%next: reg<test.i32 x4>)
^exit:
  low.return %state : reg<test.i32 x4>
}

