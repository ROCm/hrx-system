  // REMARK@+1: BACKEND/015
  %lane11 = test.extract_lane.i32 %load0, 3
  // REMARK@+1: BACKEND/015
  %lane12 = test.extract_lane.i32 %load0, 0
  // REMARK@+1: BACKEND/015
  %lane13 = test.extract_lane.i32 %load0, 1
  // REMARK@+1: BACKEND/015
  %lane14 = test.extract_lane.i32 %load0, 2
  %lane15 = test.extract_lane.i32 %load0, 3
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="4", ready_candidate_count="18", scored_candidate_count="18", chosen_packet="test.load.index.v4i32", rejected_packet="test.add.i32", rejected_dependency_latency_cycles="0", chosen_data_ready_stall_cycles="1", rejected_resource_stall_cycles="1"}
  %load1 = test.load.index.v4i32 %ptr1, %gap1
  // This longer critical path is visible through the schedule view, but its
