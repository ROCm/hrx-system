low.func.def target<test.low.core>(@test_target) @resource_stall_preserves_cross_bank_headroom(%wide0: reg<test.pressure.alias64>, %wide1: reg<test.pressure.alias64>, %alias: reg<test.pressure.alias32 x5>, %alias_source: reg<test.i32>, %phys_lhs: reg<test.phys>, %phys_rhs: reg<test.phys>) -> (reg<test.pressure.alias64>, reg<test.pressure.alias64>, reg<test.pressure.alias32 x5>, reg<test.pressure.alias32>, reg<test.phys>, reg<test.phys>, reg<test.phys>) asm {
  // Moving a final scalar into the crowded alias bank is aggregate-neutral,
  // while retaining both add operands grows total live units. The physical
  // bank with available headroom must decide the order.
  %new_alias = test.move.to.pressure.alias32 %alias_source
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="0", chosen_packet="test.add.phys", rejected_packet="test.move.to.pressure.alias32", chosen_pressure_cliff_penalty="0", rejected_pressure_cliff_penalty="1"}
  %phys = test.add.phys %phys_lhs, %phys_rhs
  return %wide0, %wide1, %alias, %new_alias, %phys, %phys_lhs, %phys_rhs
}

