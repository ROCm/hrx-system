// RUN: emit low-schedule-query @branch_edge_storage_antidependency kind=storage-lifetime strategy=resource-stall consumer=* timing=2:4

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @branch_edge_storage_antidependency(%condition: reg<test.i32>, %seed: reg<test.i32>, %rhs0: reg<test.i32>, %rhs1: reg<test.i32>) -> (reg<test.i32>) asm {
  low.br ^loop(%seed: reg<test.i32>)
^loop(%state: reg<test.i32>):
  low.cond_br %condition, ^body, ^exit : reg<test.i32>
^body:
  %read0 = test.add.i32 %state, %rhs0
  %read1 = test.mul.i32 %state, %rhs1
  %next = test.add.i32 %state, %rhs1
  low.br ^loop(%next: reg<test.i32>)
^exit:
  return %state
}

