low.func.def target<test.low.core>(@test_target) @resource_stall_completes_started_storage_setup(%lhs0: reg<test.i32>, %rhs0: reg<test.i32>, %lhs1: reg<test.i32>, %rhs1: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
