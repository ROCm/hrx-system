// ====
// RUN: emit low-schedule-json @fences_do_not_hide_load_latency strategy=resource-stall diagnostics=candidates output=none

test.target<low_core> @test_target

// Fences preserve source order but emit no instructions. Even several fences
// leave the same three-cycle load window available for independent work.
low.func.def target<test.low.core>(@test_target) @fences_do_not_hide_load_latency(%pointer: reg<test.ptr>, %lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>, reg<test.i32 x4>) asm {
  %loaded = test.load.v4i32 %pointer
  low.schedule.fence
  low.schedule.fence
  low.schedule.fence
  low.schedule.fence
  %used = test.add.v4i32 %loaded, %loaded
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="5", chosen_packet="test.add.i32", rejected_packet="test.add.v4i32", chosen_data_ready_stall_cycles="0", rejected_data_ready_stall_cycles="3", rejected_effective_stall_cycles="3"}
  %independent = test.add.i32 %lhs, %rhs
  return %independent, %used
}

