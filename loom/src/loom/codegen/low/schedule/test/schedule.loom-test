  %old = test.add.schedule_state %lhs, %rhs
  // ERROR@+1: BACKEND/044 {scheduled_node_count="1", block_node_count="4", producer_node="2", consumer_node="1", dependency_kind="state", operand_index="1", cycle_path_truncated="false", witness_edge_only="false"}
