// RUN: emit low-schedule-query @repeated_barrier_schedule_segments kind=effect strategy=resource-stall order=0,1,2,3,4 consumer=*

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @repeated_barrier_schedule_segments(%lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32>) asm {
  %before = test.add.i32 %lhs, %rhs
  test.barrier
  %middle = test.mul.i32 %lhs, %rhs
  test.barrier
  %after = test.add.i32 %lhs, %rhs
  return %before, %middle, %after
}

