low.func.def target<test.low.core>(@test_target) @resource_stall_completes_long_path_on_equal_stall(%short_lhs: reg<test.i32>, %short_rhs: reg<test.i32>, %long_lhs: reg<test.i32>, %long_rhs: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %short = test.mul.i32 %short_lhs, %short_rhs
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="0", scored_candidate_count="2", chosen_packet="test.add.i32", rejected_packet="test.mul.i32"}
  %long0 = test.add.i32 %long_lhs, %long_rhs
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="1", scored_candidate_count="2", chosen_packet="test.add.i32", rejected_packet="test.mul.i32"}
  %long1 = test.add.i32 %long0, %long_rhs
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="2", scored_candidate_count="2", chosen_packet="test.add.i32", rejected_packet="test.mul.i32"}
  %long2 = test.add.i32 %long1, %long_rhs
  // Equal one-cycle data and resource stalls favor the remaining critical
  // path packet over the independent scalar packet.
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="3", scored_candidate_count="2", chosen_packet="test.add.i32", rejected_packet="test.mul.i32", chosen_data_ready_stall_cycles="1", rejected_resource_stall_cycles="1", chosen_effective_stall_cycles="1", rejected_effective_stall_cycles="1"}
  %long3 = test.add.i32 %long2, %long_rhs
  return %short, %long3
}

// ====
// RUN: emit low-schedule-json @resource_stall_preserves_source_order_without_pressure_progress strategy=resource-stall diagnostics=candidates test.i32=6 output=none

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @resource_stall_preserves_source_order_without_pressure_progress(%short_lhs: reg<test.i32>, %short_rhs: reg<test.i32>, %long_lhs: reg<test.i32>, %long_rhs: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>) asm {
  // Both candidates grow pressure by one unit and issue after one cycle. Keep
  // the older multiply instead of opening the later add's live range merely
  // because its delay is a data stall rather than a resource stall.
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="1", chosen_packet="test.mul.i32", rejected_packet="test.add.i32", chosen_data_ready_stall_cycles="0", chosen_resource_stall_cycles="1", rejected_data_ready_stall_cycles="1", rejected_resource_stall_cycles="0"}
  %short = test.mul.i32 %short_lhs, %short_rhs
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="0", chosen_packet="test.add.i32", rejected_packet="test.mul.i32"}
  %long0 = test.add.i32 %long_lhs, %long_rhs
  %long1 = test.add.i32 %long0, %long_rhs
  return %short, %long1, %short_lhs, %short_rhs, %long0, %long_rhs
}

