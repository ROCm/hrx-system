  %resource = resource<native_pointer> {index = 0, source_type = buffer} : reg<test.ptr>
  %live0 = live_in<test.arg0> : reg<test.i32>
  %live1 = live_in<test.arg0> : reg<test.i32>
  %value = test.add.i32 %lhs, %rhs
  return %value
}

