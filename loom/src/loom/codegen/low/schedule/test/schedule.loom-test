  // REMARK@+1: BACKEND/015 {scheduled_ordinal="0", chosen_packet="test.mul.i32", rejected_packet="test.add.i32"}
  %producer = test.mul.i32 %lhs1, %rhs1
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="1", chosen_packet="low.copy", rejected_packet="test.add.i32", chosen_resource_stall_cycles="0", rejected_resource_stall_cycles="1"}
  %copy = copy %producer : reg<test.i32> -> reg<test.i32>
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="2", chosen_packet="test.add.i32", rejected_packet="test.add.i32", chosen_data_ready_stall_cycles="1", rejected_resource_stall_cycles="1", chosen_effective_stall_cycles="1", rejected_effective_stall_cycles="1"}
