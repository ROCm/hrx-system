// ====
// RUN: emit low-schedule-json @resource_stall_prices_counter_completion_for_effect_edge strategy=resource-stall diagnostics=candidates output=none

test.target<low_core> @test_target

// The target models result readiness after one cycle and completion after four.
// The read/write effect edge must therefore make the store more expensive than
// the ready SSA consumer.
low.func.def target<test.low.core>(@test_target) @resource_stall_prices_counter_completion_for_effect_edge(%address: reg<test.ptr>, %payload: reg<test.i32 x4>) -> (reg<test.i32 x4>) asm {
  %loaded = test.counter_load.v4i32 %address
  test.store.v4i32 %address, %payload
  // REMARK@+1: BACKEND/015 {chosen_packet="test.add.v4i32", rejected_packet="test.store.v4i32", chosen_data_ready_stall_cycles="1", chosen_completion_wait_cycles="0", chosen_effective_stall_cycles="1", rejected_data_ready_stall_cycles="4", rejected_completion_wait_cycles="1", rejected_effective_stall_cycles="4"}
  %used = test.add.v4i32 %loaded, %loaded
  return %used
}

