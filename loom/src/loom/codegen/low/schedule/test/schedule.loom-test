  // REMARK@+1: BACKEND/015
  %independent5 = test.mul.i32 %lhs, %rhs
  // REMARK@+1: BACKEND/015
  %independent6 = test.mul.i32 %lhs, %rhs
  // REMARK@+1: BACKEND/015
  %independent7 = test.mul.i32 %lhs, %rhs
  // REMARK@+1: BACKEND/015
  %independent8 = test.mul.i32 %lhs, %rhs
  // REMARK@+1: BACKEND/015
  %independent9 = test.mul.i32 %lhs, %rhs
  // REMARK@+1: BACKEND/015
  %independent10 = test.mul.i32 %lhs, %rhs
  // REMARK@+1: BACKEND/015
  %independent11 = test.mul.i32 %lhs, %rhs
  // REMARK@+1: BACKEND/015
  %independent12 = test.mul.i32 %lhs, %rhs
  // REMARK@+1: BACKEND/015
  %independent13 = test.mul.i32 %lhs, %rhs
  // REMARK@+1: BACKEND/015
  %independent14 = test.mul.i32 %lhs, %rhs
  // REMARK@+1: BACKEND/015
  %independent15 = test.mul.i32 %lhs, %rhs
  // REMARK@+1: BACKEND/015
  %independent16 = test.mul.i32 %lhs, %rhs
  // REMARK@+1: BACKEND/015
  %independent17 = test.mul.i32 %lhs, %rhs
  // REMARK@+1: BACKEND/015
  %independent18 = test.mul.i32 %lhs, %rhs
  %independent19 = test.mul.i32 %lhs, %rhs
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="1", chosen_packet="low.concat", rejected_packet="test.mul.i32", chosen_effective_stall_cycles="0", rejected_effective_stall_cycles="1"}
  %packed = concat(%part0, %part1, %part2, %part3) : (reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>) -> reg<test.i32 x4>
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="2", chosen_packet="test.add.v4i32", chosen_effective_stall_cycles="0"}
  %first = test.add.v4i32 %packed, %packed
  // REMARK@+1: BACKEND/015
  %second = test.add.v4i32 %first, %first
