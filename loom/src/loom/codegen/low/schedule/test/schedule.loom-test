// ====

// An issued constant fills the producer latency before the dependent adds.
// RUN: emit low-schedule-query @constant_latency strategy=resource-stall order=0,1,2,3 issue=0,1,2,3

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @constant_latency(%lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>) asm {
  %producer = test.event.slow.i32 %lhs, %rhs
  %constant = test.const.issued.i32 1
  %consumer = test.add.i32 %producer, %rhs
  %result = test.add.i32 %consumer, %constant
  return %result
}

