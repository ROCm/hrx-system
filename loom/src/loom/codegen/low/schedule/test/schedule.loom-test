// RUN: emit low-schedule-json @repeated_barrier_schedule_segments strategy=resource-stall

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @repeated_barrier_schedule_segments(
    %lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32>) asm {
  %before = test.add.i32 %lhs, %rhs
  test.barrier
  %middle = test.mul.i32 %lhs, %rhs
  test.barrier
  %after = test.add.i32 %lhs, %rhs
  return %before, %middle, %after
}

