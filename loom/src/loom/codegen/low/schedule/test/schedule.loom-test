// RUN: emit low-schedule-json @branch_edge_storage_antidependency strategy=resource-stall

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @branch_edge_storage_antidependency(
    %condition: reg<test.i32>, %seed: reg<test.i32>,
    %rhs0: reg<test.i32>, %rhs1: reg<test.i32>) -> (reg<test.i32>) {
  low.br ^loop(%seed: reg<test.i32>)
^loop(%state: reg<test.i32>):
  low.cond_br %condition, ^body, ^exit : reg<test.i32>
^body:
  %read0 = low.op<test.add.i32>(%state, %rhs0) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32>
  %read1 = low.op<test.mul.i32>(%state, %rhs1) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32>
  %next = low.op<test.add.i32>(%state, %rhs1) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32>
  low.br ^loop(%next: reg<test.i32>)
^exit:
  low.return %state : reg<test.i32>
}

