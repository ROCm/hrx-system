// ====
// RUN: emit low-schedule-json @resource_stall_advances_smallest_active_unspillable_completion strategy=resource-stall diagnostics=candidates output=none

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @resource_stall_advances_smallest_active_unspillable_completion(%condition: reg<test.i32>, %lhs: reg<test.i32>, %rhs: reg<test.i32>, %packed0: reg<test.packed.narrow>, %packed1: reg<test.packed.narrow>) -> (reg<test.i32>, reg<test.i32>, reg<test.packed.narrow>, reg<test.packed.narrow>) asm {
  %fixed0 = copy %condition : reg<test.i32> -> reg<test.fixed.r0>
  low.schedule.fence
  // Both ready candidates would exceed a full unspillable class: %fixed1
  // opens a second value in a singleton class, while %prepared_narrow opens a
  // third value in a two-register class. The latter is a prerequisite of the
  // sole consumer that releases %fixed0, so the tighter active transaction
  // must determine the order instead of either candidate's local debt.
  %fixed1 = copy %condition : reg<test.i32> -> reg<test.fixed.r0>
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="2", chosen_packet="test.const.packed.narrow", rejected_packet="low.copy"}
  %prepared_narrow = test.const.packed.narrow 1
  // REMARK@+1: BACKEND/015
  %prepared = copy %prepared_narrow : reg<test.packed.narrow> -> reg<test.i32>
  // REMARK@+1: BACKEND/015
  %select0 = test.fixed.select.i32 %prepared, %rhs, %fixed0
  %select1 = test.fixed.select.i32 %lhs, %rhs, %fixed1
  return %select0, %select1, %packed0, %packed1
}

