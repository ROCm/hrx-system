// RUN: emit low-schedule-json @resource_stall_fills_open_issue_lane_before_storage_compaction strategy=resource-stall diagnostics=candidates output=none

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @resource_stall_fills_open_issue_lane_before_storage_compaction(%lhs0: reg<test.i32 x4>, %rhs0: reg<test.i32 x4>, %lhs1: reg<test.i32 x4>, %rhs1: reg<test.i32 x4>, %lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32 x8>, reg<test.i32>) asm {
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="0", scored_candidate_count="3", chosen_packet="test.add.v4i32", rejected_packet="test.add.v4i32"}
  %part0 = test.add.v4i32 %lhs0, %rhs0
  %part1 = test.add.v4i32 %lhs1, %rhs1
  %packed = concat(%part0, %part1) : (reg<test.i32 x4>, reg<test.i32 x4>) -> reg<test.i32 x8>
  // The scalar lane remains open while the second vector packet waits for the
  // occupied vector issue resource.
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="1", chosen_packet="test.mul.i32", rejected_packet="test.add.v4i32", chosen_resource_stall_cycles="0", chosen_effective_stall_cycles="0", rejected_resource_stall_cycles="1", rejected_effective_stall_cycles="1"}
  %independent = test.mul.i32 %lhs, %rhs
  return %packed, %independent
}

