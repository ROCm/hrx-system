// ====
// RUN: emit low-schedule-query @resource_stall_advances_exact_two_consumer_handoff strategy=resource-stall order=0,1,2,3,4

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @resource_stall_advances_exact_two_consumer_handoff(%condition: reg<test.i32>, %lhs: reg<test.i32>, %rhs: reg<test.i32>, %other_lhs: reg<test.i32>, %other_rhs: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %fixed = copy %condition : reg<test.i32> -> reg<test.fixed.r0>
  low.schedule.fence
  // The fixed value has two consumers, so ordinary sole-consumer demand
  // cannot nominate either one. The first select consumes one branch and
  // exposes the other as the exact remaining consumer of the full register.
  %unrelated = test.add.i32 %other_lhs, %other_rhs
  %handoff = test.fixed.select.i32 %lhs, %rhs, %fixed
  %completed = test.fixed.select.i32 %handoff, %rhs, %fixed
  return %completed, %unrelated
}

