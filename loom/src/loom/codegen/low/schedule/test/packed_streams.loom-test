// Four independent accumulators reuse each packed weight across four MACs.
// Fresh activation FIFO groups release their state every sixteen records;
// those releases compete with matrix operand storage in its native bank.
// The weight pop must precede the final activation pop: freeing its FIFO
// first would fill the matrix bank before the remaining MACs can start.
// RUN: emit low-schedule-query @fresh_groups strategy=resource-stall order=26,51 scheduled-pressure=aie2p.mexa

aie2p.target<core> @target

low.func.def target<amd.xdna.aie2p.core>(@target) @fresh_groups(%weights: reg<aie2p.ep>, %weight_offset: reg<aie2p.er>, %activations: reg<aie2p.ep>, %activation_offset: reg<aie2p.er>, %initial0: reg<aie2p.mbms x4>, %initial1: reg<aie2p.mbms x4>, %initial2: reg<aie2p.mbms x4>, %initial3: reg<aie2p.mbms x4>) -> (reg<aie2p.mbms x4>, reg<aie2p.mbms x4>, reg<aie2p.mbms x4>, reg<aie2p.mbms x4>) asm {
  %control = mova.i32 780
  %w_modifier = mov.modifier %weight_offset
