load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")
load("//loom/build_tools/bazel:loom_check.bzl", "loom_check_test", "loom_check_test_suite")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_check_test_suite(
    name = "test",
    srcs = [
        "completion_headroom.loom-test",
        "hazards.loom-test",
        "memory_access_flags.loom-test",
        "memory_frontier.loom-test",
        "packing_completion.loom-test",
        "pressure_cfg.loom-test",
        "pressure_headroom.loom-test",
        "ready_nomination.loom-test",
        "required_pressure.loom-test",
        "schedule.loom-test",
        "schedule_locked.loom-test",
        "schedule_scopes.loom-test",
        "setup_order.loom-test",
        "state_updates.loom-test",
        "storage_lifetime.loom-test",
    ],
)

loom_check_test(
    name = "spill_traffic",
    src = "spill_traffic.loom-test",
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/arch:amdgpu",
    ]),
)

loom_check_test(
    name = "result_lifetimes",
    src = "result_lifetimes.loom-test",
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/arch:amdgpu",
    ]),
)
