  %private = test.mul.i32 %lhs, %rhs
  %result = test.add.i32 %private, %dependency
  %structural = copy %seed : reg<test.i32> -> reg<test.i32>
  %other = test.mul.i32 %lhs, %seed
  %joint = test.add.i32 %structural, %other
