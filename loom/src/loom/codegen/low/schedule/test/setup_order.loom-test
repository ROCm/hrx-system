// ====

// A state writer orders earlier readers but does not consume their results.
// RUN: emit low-schedule-query @state_is_not_a_value_consumer kind=order consumer=0,2 per-user-placement-values=%left,%right

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @state_is_not_a_value_consumer(%a: reg<test.i32>, %b: reg<test.i32>, %c: reg<test.i32>) -> (reg<test.i32>) asm {
  %left = test.state.read.i32 %a
  %late = test.mul.i32 %b, %c
  %right = test.state.read.i32 %late
  test.state.assign.i32.immediate 1
  low.br ^consume
^consume:
  %sum = test.add.i32 %left, %right
  return %sum
}

// ----
node 0 <- none
node 2 <- none

// ====

// A distinct state successor is dependency fan-out even after the value user.
// The reader remains available for pressure scheduling rather than joining a
// private chain.
// RUN: emit low-schedule-query @state_after_value_consumer kind=order consumer=1 per-user-placement-values=%private

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @state_after_value_consumer(%a: reg<test.i32>, %b: reg<test.i32>) -> (reg<test.i32>) asm {
  %dependency = test.mul.i32 %a, %b
  %private = test.state.read.i32 %a
  %result = test.add.i32 %private, %dependency
  test.state.assign.i32.immediate 1
  return %result
}

// ----
node 1 <- none

// ====

// The value user cannot pull a reader past an intervening state change.
// RUN: emit low-schedule-query @state_before_value_consumer kind=order consumer=0 per-user-placement-values=%private

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @state_before_value_consumer(%a: reg<test.i32>, %b: reg<test.i32>) -> (reg<test.i32>) asm {
  %private = test.state.read.i32 %a
  test.state.assign.i32.immediate 1
  %dependency = test.state.read.i32 %b
  %result = test.add.i32 %private, %dependency
  return %result
}

// ----
node 0 <- none

// ====

// A state dependency prevents extending the chain through its earlier reader.
// RUN: emit low-schedule-query @state_inside_setup_chain kind=order consumer=0,1 per-user-placement-values=%private,%intermediate

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @state_inside_setup_chain(%a: reg<test.i32>, %b: reg<test.i32>) -> (reg<test.i32>) asm {
  %private = test.state.read.i32 %a
  %intermediate = test.add.i32 %private, %b
  test.state.assign.i32.immediate 1
  %dependency = test.state.read.i32 %b
  %result = test.add.i32 %intermediate, %dependency
  return %result
}

// ----
node 0 <- none
node 1 <- 3

// ====

// An aliasing store also prevents extending a chain through an earlier load.
// RUN: emit low-schedule-query @store_inside_setup_chain kind=order consumer=0,1 per-user-placement-values=%loaded,%intermediate

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @store_inside_setup_chain(%address: reg<test.ptr>, %value: reg<test.i32 x4>) -> (reg<test.i32 x4>) asm {
  %loaded = test.load.v4i32 %address
  %intermediate = test.add.v4i32 %loaded, %value
  test.store.v4i32 %address, %value
  %dependency = test.load.v4i32 %address
  %result = test.add.v4i32 %intermediate, %dependency
  return %result
}

