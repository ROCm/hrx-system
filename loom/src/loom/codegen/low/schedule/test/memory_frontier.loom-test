// Reads do not order one another and remain available to the scheduler
// together.
// RUN: emit low-schedule @read_only strategy=resource-stall diagnostics=candidates output=none

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @read_only(%address: reg<test.ptr>) asm {
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="0", chosen_packet="test.load.v4i32", rejected_packet="test.load.v4i32"}
  %loaded0 = test.load.v4i32 %address
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="1", chosen_packet="test.load.v4i32", rejected_packet="test.load.v4i32"}
  %loaded1 = test.load.v4i32 %address
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="2", chosen_packet="test.load.v4i32", rejected_packet="test.load.v4i32"}
  %loaded2 = test.load.v4i32 %address
  %loaded3 = test.load.v4i32 %address
  return
}

// ====

// A memory barrier orders the surrounding memory operations without fencing
// independent arithmetic.
// RUN: emit low-schedule @memory_barrier_exposes_independent_work strategy=resource-stall diagnostics=candidates output=none

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @memory_barrier_exposes_independent_work(%pointer: reg<test.ptr>, %lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>) asm {
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="0", chosen_packet="test.load.v4i32", rejected_packet="test.add.i32"}
  %loaded = test.load.v4i32 %pointer
  test.memory.barrier
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="1", chosen_packet="test.add.i32", rejected_packet="test.memory.barrier"}
  %independent = test.add.i32 %lhs, %rhs
  test.store.v4i32 %pointer, %loaded
  return %independent
}

// ====

// An explicit source fence holds independent arithmetic behind the barrier.
// The store remains free to issue first once the fence opens.
// RUN: emit low-schedule @source_fence_preserves_independent_work_order strategy=resource-stall diagnostics=candidates output=none

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @source_fence_preserves_independent_work_order(%pointer: reg<test.ptr>, %lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>) asm {
  %loaded = test.load.v4i32 %pointer
  test.barrier
  %independent = test.add.i32 %lhs, %rhs
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="2", chosen_packet="test.store.v4i32", rejected_packet="test.add.i32"}
  test.store.v4i32 %pointer, %loaded
  return %independent
}

// ====

// A locked function preserves the authored order around a memory barrier and
// therefore exposes no candidate decisions.
// RUN: emit low-schedule @locked_memory_barrier_preserves_source_order strategy=resource-stall diagnostics=candidates output=none

test.target<low_core> @target

low.func.def schedule(locked) target<test.low.core>(@target) @locked_memory_barrier_preserves_source_order(%pointer: reg<test.ptr>, %lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>) asm {
  %loaded = test.load.v4i32 %pointer
  test.memory.barrier
  %independent = test.add.i32 %lhs, %rhs
  test.store.v4i32 %pointer, %loaded
  return %independent
}
