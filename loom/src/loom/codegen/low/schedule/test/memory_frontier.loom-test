// RUN: emit low-schedule-query @read_only kind=effect strategy=resource-stall consumer=*

// Reads alone acquire no memory-ordering edges.
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @read_only(%address: reg<test.ptr>, %value: reg<test.i32 x4>) asm {
  %loaded0 = test.load.v4i32 %address
  %loaded1 = test.load.v4i32 %address
  %loaded2 = test.load.v4i32 %address
  %loaded3 = test.load.v4i32 %address
  return
}

// ----
none

// ====
// RUN: emit low-schedule-query @unobserved_stores kind=effect strategy=resource-stall consumer=*

// Homogeneous WAW order forms a chain, while all three stores remain direct
// predecessors of the read because WAW issue order does not establish
// completion.
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @unobserved_stores(%address: reg<test.ptr>, %value: reg<test.i32 x4>) asm {
  test.store.v4i32 %address, %value
  test.store.v4i32 %address, %value
  test.store.v4i32 %address, %value
  %loaded3 = test.load.v4i32 %address
  return
}

// ----
node 1 <- 0
node 2 <- 1
node 3 <- 0, 1, 2

// ====
// RUN: emit low-schedule-query @heterogeneous_store_timing kind=effect strategy=resource-stall consumer=*

// A different descriptor timing identity breaks the homogeneous chain. Keep
// the direct edge from the first store to the third.
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @heterogeneous_store_timing(%address: reg<test.ptr>, %vector: reg<test.i32 x4>, %scalar: reg<test.i32>) asm {
  test.store.v4i32 %address, %vector
  test.event.memory.write.i32 %scalar
  test.store.v4i32 %address, %vector
  return
}

// ----
node 1 <- 0
node 2 <- 0, 1

// ====
// RUN: emit low-schedule-query @read_write_read_chain kind=effect strategy=resource-stall consumer=2,3,4,5

// The write completes the first two reads. Later reads carry their ordering to
// the final write.
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @read_write_read_chain(%address: reg<test.ptr>, %value: reg<test.i32 x4>) asm {
  %loaded0 = test.load.v4i32 %address
  %loaded1 = test.load.v4i32 %address
  test.store.v4i32 %address, %value
  %loaded3 = test.load.v4i32 %address
  %loaded4 = test.load.v4i32 %address
  test.store.v4i32 %address, %value
  return
}

// ----
node 2 <- 0, 1
node 3 <- 2
node 4 <- 2
node 5 <- 2, 3, 4

// ====
// RUN: emit low-schedule-query @write_read_write_chain kind=effect strategy=resource-stall consumer=1,2,3,4,5

// The first read completes the first two stores. Both later stores remain live
// for the final read.
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @write_read_write_chain(%address: reg<test.ptr>, %value: reg<test.i32 x4>) asm {
  test.store.v4i32 %address, %value
  test.store.v4i32 %address, %value
  %loaded2 = test.load.v4i32 %address
  test.store.v4i32 %address, %value
  test.store.v4i32 %address, %value
  %loaded5 = test.load.v4i32 %address
  return
}

// ----
node 1 <- 0
node 2 <- 0, 1
node 3 <- 1, 2
node 4 <- 2, 3
node 5 <- 3, 4

// ====
// RUN: emit low-schedule-query @alternating_accesses kind=effect strategy=resource-stall consumer=1,2,3,4,5,6

// Each opposite-kind pivot carries earlier completion through the next repeated
// access.
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @alternating_accesses(%address: reg<test.ptr>, %value: reg<test.i32 x4>) asm {
  %loaded0 = test.load.v4i32 %address
  test.store.v4i32 %address, %value
  %loaded2 = test.load.v4i32 %address
  test.store.v4i32 %address, %value
  %loaded4 = test.load.v4i32 %address
  test.store.v4i32 %address, %value
  %loaded6 = test.load.v4i32 %address
  return
}

// ----
node 1 <- 0
node 2 <- 1
node 3 <- 1, 2
node 4 <- 3
node 5 <- 3, 4
node 6 <- 5

// ====
// RUN: emit low-schedule-query @batched_accesses kind=effect strategy=resource-stall consumer=3,4,5,6,7,8,9

// Read and write bursts retain their unobserved members while completed bursts
// retire.
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @batched_accesses(%address: reg<test.ptr>, %value: reg<test.i32 x4>) asm {
  %loaded0 = test.load.v4i32 %address
  %loaded1 = test.load.v4i32 %address
  %loaded2 = test.load.v4i32 %address
  test.store.v4i32 %address, %value
  test.store.v4i32 %address, %value
  %loaded5 = test.load.v4i32 %address
  %loaded6 = test.load.v4i32 %address
  test.store.v4i32 %address, %value
  test.store.v4i32 %address, %value
  %loaded9 = test.load.v4i32 %address
  return
}

// ----
node 3 <- 0, 1, 2
node 4 <- 0, 1, 2, 3
node 5 <- 3, 4
node 6 <- 3, 4
node 7 <- 4, 5, 6
node 8 <- 5, 6, 7
node 9 <- 7, 8

// ====
// RUN: emit low-schedule-query @ordered_effect_preserves_frontier kind=effect strategy=resource-stall consumer=4,7

// An ordered effect preserves memory predecessors until opposite-kind accesses
// complete them.
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @ordered_effect_preserves_frontier(%address: reg<test.ptr>, %value: reg<test.i32 x4>) asm {
  test.store.v4i32 %address, %value
  test.store.v4i32 %address, %value
  %loaded2 = test.load.v4i32 %address
  test.barrier
  %loaded4 = test.load.v4i32 %address
  test.store.v4i32 %address, %value
  test.store.v4i32 %address, %value
  %loaded7 = test.load.v4i32 %address
  return
}

// ----
node 4 <- 0, 1, 3
node 7 <- 3, 5, 6

// ====
// RUN: emit low-schedule-query @block_frontiers kind=effect strategy=resource-stall consumer=1,2,3,5,6,7

// Block-local retirement cutoffs cannot hide dependencies in a later block.
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @block_frontiers(%address: reg<test.ptr>, %value: reg<test.i32 x4>) asm {
  %first = test.load.v4i32 %address
  test.store.v4i32 %address, %value
  %second = test.load.v4i32 %address
  low.br ^next
^next:
  %third = test.load.v4i32 %address
  test.store.v4i32 %address, %value
  %fourth = test.load.v4i32 %address
  test.store.v4i32 %address, %value
  return
}

// ----
node 1 <- 0
node 2 <- 1
node 3 <- 1
node 5 <- 4
node 6 <- 5
node 7 <- 5, 6

// ====
// RUN: emit low-schedule-query @memory_barrier_exposes_independent_work kind=effect strategy=resource-stall order=0,1,2,3 consumer=1,3

// Memory ordering constrains the load and store while independent arithmetic
// crosses the barrier and issues alongside the load.
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @memory_barrier_exposes_independent_work(%pointer: reg<test.ptr>, %lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>) asm {
  %loaded = test.load.v4i32 %pointer
  test.memory.barrier
  %independent = test.add.i32 %lhs, %rhs
  test.store.v4i32 %pointer, %loaded
  return %independent
}

// ----
block 0 order: 0, 2, 1, 3
node 1 <- 0
node 3 <- 0, 1

// ====
// RUN: emit low-schedule-query @source_fence_preserves_independent_work_order kind=effect strategy=resource-stall order=0,1,2,3 consumer=1,3

// An explicit source fence additionally keeps independent arithmetic after
// the barrier.
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @source_fence_preserves_independent_work_order(%pointer: reg<test.ptr>, %lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>) asm {
  %loaded = test.load.v4i32 %pointer
  test.barrier
  %independent = test.add.i32 %lhs, %rhs
  test.store.v4i32 %pointer, %loaded
  return %independent
}

// ----
block 0 order: 0, 1, 3, 2
node 1 <- 0
node 3 <- 0, 1

// ====
// RUN: emit low-schedule-query @locked_memory_barrier_preserves_source_order kind=effect strategy=resource-stall order=0,1,2,3 consumer=1,3

// A locked function preserves source order even when its memory barrier is
// not a source fence.
test.target<low_core> @target

low.func.def schedule(locked) target<test.low.core>(@target) @locked_memory_barrier_preserves_source_order(%pointer: reg<test.ptr>, %lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>) asm {
  %loaded = test.load.v4i32 %pointer
  test.memory.barrier
  %independent = test.add.i32 %lhs, %rhs
  test.store.v4i32 %pointer, %loaded
  return %independent
}

