// ====
// RUN: emit low-schedule-json @unobserved_stores strategy=resource-stall

// All three stores must remain predecessors of the read; WAW issue order does not establish completion.
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @unobserved_stores(%address: reg<test.ptr>, %value: reg<test.i32 x4>) asm {
  test.store.v4i32 %address, %value
  test.store.v4i32 %address, %value
  test.store.v4i32 %address, %value
  %loaded3 = test.load.v4i32 %address
  return
}

