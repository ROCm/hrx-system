// ====
// RUN: emit low-schedule-json @block_frontiers strategy=resource-stall

// Block-local retirement cutoffs cannot hide dependencies in a later block.
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @block_frontiers(%address: reg<test.ptr>, %value: reg<test.i32 x4>) asm {
  %first = test.load.v4i32 %address
  test.store.v4i32 %address, %value
  %second = test.load.v4i32 %address
  low.br ^next
^next:
  %third = test.load.v4i32 %address
  test.store.v4i32 %address, %value
  %fourth = test.load.v4i32 %address
  test.store.v4i32 %address, %value
  return
}

