// ====
// RUN: emit low-schedule-json @write_read_write_chain strategy=resource-stall

// The first read completes the first two stores. Both later stores remain live for the final read.
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @write_read_write_chain(%address: reg<test.ptr>, %value: reg<test.i32 x4>) asm {
  test.store.v4i32 %address, %value
  test.store.v4i32 %address, %value
  %loaded2 = test.load.v4i32 %address
  test.store.v4i32 %address, %value
  test.store.v4i32 %address, %value
  %loaded5 = test.load.v4i32 %address
  return
}

