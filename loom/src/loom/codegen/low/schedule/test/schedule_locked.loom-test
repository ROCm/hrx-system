// A function lock overrides candidate selection without changing true data
// dependencies. The free and constrained controls move independent work into
// the load latency window; every locked strategy preserves the source order.

// RUN: emit low-schedule @free_resource_stall strategy=resource-stall diagnostics=candidates output=none

test.target<low_core> @target

low.func.def schedule(free) target<test.low.core>(@target) @free_resource_stall(%pointer: reg<test.ptr>, %lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>, reg<test.i32 x4>) asm {
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="0", chosen_packet="test.load.v4i32", rejected_packet="test.add.i32"}
  %loaded = test.load.v4i32 %pointer
  %used = test.add.v4i32 %loaded, %loaded
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="1", chosen_packet="test.add.i32", rejected_packet="test.add.v4i32", rejected_data_ready_stall_cycles="4"}
  %independent = test.add.i32 %lhs, %rhs
  return %independent, %used
}

// ====

// RUN: emit low-schedule @constrained_resource_stall strategy=resource-stall diagnostics=candidates output=none

test.target<low_core> @target

low.func.def schedule(constrained) target<test.low.core>(@target) @constrained_resource_stall(%pointer: reg<test.ptr>, %lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>, reg<test.i32 x4>) asm {
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="0", chosen_packet="test.load.v4i32", rejected_packet="test.add.i32"}
  %loaded = test.load.v4i32 %pointer
  %used = test.add.v4i32 %loaded, %loaded
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="1", chosen_packet="test.add.i32", rejected_packet="test.add.v4i32", rejected_data_ready_stall_cycles="4"}
  %independent = test.add.i32 %lhs, %rhs
  return %independent, %used
}

