// RUN: emit low-schedule @locked_resource_stall strategy=resource-stall diagnostics=candidates output=none

test.target<low_core> @target

low.func.def schedule(locked) target<test.low.core>(@target) @locked_resource_stall(%pointer: reg<test.ptr>, %lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>, reg<test.i32 x4>) asm {
  %loaded = test.load.v4i32 %pointer
