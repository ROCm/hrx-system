// ====

// The packet still reads its original input after writing the result.
// With all 32 registers live, that temporary overlap exceeds the
// physical bank even though the final live demand remains 32 units.
// RUN: emit low-schedule-json @late_read_overlap strategy=resource-stall diagnostics=candidates output=none

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @late_read_overlap(%held: reg<test.phys x31>, %source: reg<test.phys>) -> (reg<test.phys>, reg<test.i32 x31>) asm {
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="0", chosen_packet="test.late_update.phys", chosen_projected_live_units="32", chosen_pressure_cliff_source="test.phys", chosen_pressure_cliff_units="32", chosen_pressure_cliff_penalty="2"}
  %result = test.late_update.phys %source
  %released = copy %held : reg<test.phys x31> -> reg<test.i32 x31>
  return %result, %released
}
