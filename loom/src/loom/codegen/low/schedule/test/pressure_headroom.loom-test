  // REMARK@+1: BACKEND/015 {chosen_packet="test.accumulate.v4phys", rejected_packet="low.storage.reserve", chosen_projected_live_units="4", chosen_units_until_pressure_cliff="4294967295"}
  %result = test.accumulate.v4phys %lhs, %rhs, %accumulator
  %scratch = storage {byte_alignment = 4, byte_length = 4} : low.storage<private>
  return %result
}

// ====

