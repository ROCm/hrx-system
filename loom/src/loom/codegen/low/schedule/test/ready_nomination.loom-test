  // REMARK@+1: BACKEND/015
  %independent4 = test.mul.i32 %lhs, %rhs
  // REMARK@+1: BACKEND/015
  %independent5 = test.mul.i32 %lhs, %rhs
  // REMARK@+1: BACKEND/015
  %independent6 = test.mul.i32 %lhs, %rhs
  // REMARK@+1: BACKEND/015
  %independent7 = test.mul.i32 %lhs, %rhs
  // REMARK@+1: BACKEND/015
  %independent8 = test.mul.i32 %lhs, %rhs
  // REMARK@+1: BACKEND/015
  %independent9 = test.mul.i32 %lhs, %rhs
  // REMARK@+1: BACKEND/015
  %independent10 = test.mul.i32 %lhs, %rhs
  // REMARK@+1: BACKEND/015
  %independent11 = test.mul.i32 %lhs, %rhs
  // REMARK@+1: BACKEND/015
  %independent12 = test.mul.i32 %lhs, %rhs
  // REMARK@+1: BACKEND/015
  %independent13 = test.mul.i32 %lhs, %rhs
  // REMARK@+1: BACKEND/015
  %independent14 = test.mul.i32 %lhs, %rhs
  // REMARK@+1: BACKEND/015
  %independent15 = test.mul.i32 %lhs, %rhs
  // REMARK@+1: BACKEND/015
  %independent16 = test.mul.i32 %lhs, %rhs
  // REMARK@+1: BACKEND/015
  %independent17 = test.mul.i32 %lhs, %rhs
  // REMARK@+1: BACKEND/015
  %independent18 = test.mul.i32 %lhs, %rhs
  %independent19 = test.mul.i32 %lhs, %rhs
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="0", ready_candidate_count="21", scored_candidate_count="17", chosen_packet="low.concat", rejected_packet="test.mul.i32", chosen_effective_stall_cycles="0"}
  %packed = concat(%part0, %part1, %part2, %part3) : (reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>) -> reg<test.i32 x4>
  // REMARK@+1: BACKEND/015 {scheduled_ordinal="1", chosen_packet="test.add.v4i32", chosen_effective_stall_cycles="0"}
  %first = test.add.v4i32 %packed, %packed
  // REMARK@+1: BACKEND/015
  %second = test.add.v4i32 %first, %first
  return %second, %independent0, %independent1, %independent2, %independent3, %independent4, %independent5, %independent6, %independent7, %independent8, %independent9, %independent10, %independent11, %independent12, %independent13, %independent14, %independent15, %independent16, %independent17, %independent18, %independent19
}

// ====
// RUN: emit low-schedule-query @resource_stall_refreshes_ready_sole_consumer strategy=resource-stall order=*

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @resource_stall_refreshes_ready_sole_consumer(%shared: reg<test.pressure.alias32 x5>, %source: reg<test.i32>) -> (reg<test.pressure.alias32>, reg<test.pressure.alias32>, reg<test.pressure.alias32>, reg<test.pressure.alias32>, reg<test.pressure.alias32>, reg<test.pressure.alias32>, reg<test.pressure.alias32>, reg<test.pressure.alias32>, reg<test.pressure.alias32>, reg<test.pressure.alias32>, reg<test.pressure.alias32>, reg<test.pressure.alias32>, reg<test.pressure.alias32>, reg<test.pressure.alias32>, reg<test.pressure.alias32>, reg<test.pressure.alias32>, reg<test.pressure.alias32>, reg<test.pressure.alias32>, reg<test.i32 x5>) asm {
  // The shared input occupies five of the bank's eight physical units. After
  // the dead bridge, only the final read can retire it. That read starts beyond
  // the bounded source window; its refreshed pressure key must nominate it
  // before unrelated ready work grows the bank's live footprint.
  %bridge = test.move.from.pressure.alias32.x5 %shared
  %independent0 = test.move.to.pressure.alias32 %source
  %independent1 = test.move.to.pressure.alias32 %source
  %independent2 = test.move.to.pressure.alias32 %source
  %independent3 = test.move.to.pressure.alias32 %source
  %independent4 = test.move.to.pressure.alias32 %source
  %independent5 = test.move.to.pressure.alias32 %source
  %independent6 = test.move.to.pressure.alias32 %source
  %independent7 = test.move.to.pressure.alias32 %source
  %independent8 = test.move.to.pressure.alias32 %source
  %independent9 = test.move.to.pressure.alias32 %source
  %independent10 = test.move.to.pressure.alias32 %source
  %independent11 = test.move.to.pressure.alias32 %source
  %independent12 = test.move.to.pressure.alias32 %source
  %independent13 = test.move.to.pressure.alias32 %source
  %independent14 = test.move.to.pressure.alias32 %source
  %independent15 = test.move.to.pressure.alias32 %source
  %independent16 = test.move.to.pressure.alias32 %source
  %independent17 = test.move.to.pressure.alias32 %source
  %final = test.move.from.pressure.alias32.x5 %shared
  return %independent0, %independent1, %independent2, %independent3, %independent4, %independent5, %independent6, %independent7, %independent8, %independent9, %independent10, %independent11, %independent12, %independent13, %independent14, %independent15, %independent16, %independent17, %final
}

