  %scalar16 = copy %independent16 : reg<test.explicit32> -> reg<test.i32>
  %other_results = concat(%scalar0, %scalar1, %scalar2, %scalar3, %scalar4, %scalar5, %scalar6, %scalar7, %scalar8, %scalar9, %scalar10, %scalar11, %scalar12, %scalar13, %scalar14, %scalar15, %scalar16) : (reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>) -> reg<test.i32 x17>
  return %held, %other_results, %finished
