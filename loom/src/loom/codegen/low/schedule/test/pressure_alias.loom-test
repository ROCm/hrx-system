// ====

// Explicit moves consume their source. The writable result replaces the
// original owner instead of adding another live register.
// RUN: emit low-schedule-query @moved_update strategy=resource-stall order=* scheduled-pressure=test.i32

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @moved_update(%source: reg<test.i32>, %ptr: reg<test.ptr>) -> (reg<test.i32>, reg<test.i32 x4>) asm {
  %owner = move %source : reg<test.i32> -> reg<test.i32>
  %load = test.load.v4i32 %ptr
  %updated = test.tied.any %owner
  return %updated, %load
}

