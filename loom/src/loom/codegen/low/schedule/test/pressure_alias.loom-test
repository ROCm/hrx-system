// A read-only copy can share the live source's register. Its acquisition adds
// no pressure even though both values survive the independent load.
// RUN: emit low-schedule-query @read_only_copy strategy=resource-stall diagnostics=candidates order=*

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @read_only_copy(%source: reg<test.i32>, %ptr: reg<test.ptr>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32 x4>) asm {
  %alias = copy %source : reg<test.i32> -> reg<test.i32>
  // REMARK@+1: BACKEND/015 {rejected_packet="low.copy", rejected_produced_live_units="0"}
  %load = test.load.v4i32 %ptr
  %sum = test.add.i32 %alias, %source
  return %source, %sum, %load
}

