// ====

// A writable aggregate owns all four units, including the lane that a
// read-only concatenation could borrow from the repeated source.
// RUN: emit low-schedule-query @concatenated_update strategy=resource-stall diagnostics=candidates order=*

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @concatenated_update(%source: reg<test.i32>, %ptr: reg<test.ptr>) -> (reg<test.i32>, reg<test.i32 x4>, reg<test.i32 x4>) asm {
  %owner = concat(%source, %source, %source, %source) : (reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>) -> reg<test.i32 x4>
  // REMARK@+1: BACKEND/015 {rejected_packet="low.concat", rejected_produced_live_units="4"}
  %load = test.load.v4i32 %ptr
  %updated = test.early_tied.v4i32 %owner
  return %source, %updated, %load
}

