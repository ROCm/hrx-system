block 0 order: 0, 1, 2, 3
scheduled pressure test.i32: peak-live-units=5 peak-live-values=2

// ====

// When acquisition is the original value's final read, retiring its register
// pays for the writable result. The copy adds no net live storage.
// RUN: emit low-schedule-query @retired_source strategy=resource-stall diagnostics=candidates order=*

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @retired_source(%source: reg<test.i32>, %ptr: reg<test.ptr>) -> (reg<test.i32>, reg<test.i32 x4>) asm {
  %owner = copy %source : reg<test.i32> -> reg<test.i32>
  // REMARK@+1: BACKEND/015 {rejected_packet="low.copy", rejected_killed_live_units="1", rejected_produced_live_units="1"}
  %load = test.load.v4i32 %ptr
  %updated = test.tied.any %owner
  return %updated, %load
}

