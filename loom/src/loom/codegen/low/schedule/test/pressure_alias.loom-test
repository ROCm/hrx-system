// ====

// A writable slice owns only the selected unit, not the complete four-unit
// source. The source keeps its original contents after the update.
// RUN: emit low-schedule-query @sliced_update strategy=resource-stall diagnostics=candidates order=*

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @sliced_update(%source: reg<test.i32 x4>, %ptr: reg<test.ptr>) -> (reg<test.i32 x4>, reg<test.i32>, reg<test.i32 x4>) asm {
  %owner = slice %source[1] : reg<test.i32 x4> -> reg<test.i32>
  // REMARK@+1: BACKEND/015 {rejected_packet="low.slice", rejected_produced_live_units="1"}
  %load = test.load.v4i32 %ptr
  %updated = test.tied.any %owner
  return %source, %updated, %load
}

