// ====

// The tied update needs an independently writable copy while the original
// survives. Count its register at acquisition, before the consuming update.
// RUN: emit low-schedule-query @copied_update strategy=resource-stall diagnostics=candidates order=*

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @copied_update(%source: reg<test.i32>, %ptr: reg<test.ptr>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32 x4>) asm {
  %owner = copy %source : reg<test.i32> -> reg<test.i32>
  // REMARK@+1: BACKEND/015 {rejected_packet="low.copy", rejected_produced_live_units="1"}
  %load = test.load.v4i32 %ptr
  %updated = test.tied.any %owner
  return %source, %updated, %load
}

