// ====

// A scheduling fence still partitions source ranges without inventing state
// observations or restoring an otherwise unnecessary WAW edge.
// RUN: emit low-schedule-query @fenced_updates kind=state strategy=resource-stall order=1,2,3 consumer=*
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @fenced_updates(%lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %slow = test.event.slow.i32 %lhs, %rhs
  %first = test.state.update.i32 %slow
  low.schedule.fence
  %ready = test.state.update.i32 %lhs
  return %first, %ready
}

