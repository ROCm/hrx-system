// ====

// Structural operands observe architectural state even without descriptor
// STATE_READ rows. The ordinary-data snapshot survives subsequent updates.
// RUN: emit low-schedule-query @explicit_state_operand kind=state strategy=resource-stall consumer=1,2
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @explicit_state_operand(%state: reg<test.special>, %value: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32>) asm {
  %snapshot = copy %state : reg<test.special> -> reg<test.i32>
  %first = test.state.update.i32 %value
  %second = test.state.update.i32 %value
  return %snapshot, %first, %second
}

