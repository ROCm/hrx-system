node 2 <- 1

// ====

// Replacement is not a commutative update to the same state.
// RUN: emit low-schedule-query @replacement_between_updates kind=state strategy=resource-stall consumer=1,2
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @replacement_between_updates(%value: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %first = test.state.update.i32 %value
  test.state.assign.i32.immediate 0
  %second = test.state.update.i32 %value
  return %first, %second
}

