block 0 order: 1, 0, 2

// ====

// Explicit state carried across a block with updates cannot preserve its old
// value. The existing state-clobber diagnostic still owns this rejection.
// RUN: emit low-schedule @state_live_out_clobber output=none
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @state_live_out_clobber(%state: reg<test.special>, %value: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32>) asm {
  low.br ^updates
^updates:
  // ERROR@+1: BACKEND/048 {value_name="state", clobber_packet="test.state.update.i32"}
  %first = test.state.update.i32 %value
  %second = test.state.update.i32 %value
  low.br ^observe
^observe:
  %snapshot = copy %state : reg<test.special> -> reg<test.i32>
  return %snapshot, %first, %second
}
