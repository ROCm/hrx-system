// Independent commutative updates can retire in either order. The ready
// update fills the producer's latency instead of waiting for the first update.
// RUN: emit low-schedule-query @ready_update kind=state strategy=resource-stall order=1,2 consumer=*
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @ready_update(%lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %slow = test.event.slow.i32 %lhs, %rhs
  %first = test.state.update.i32 %slow
  %ready = test.state.update.i32 %lhs
  return %first, %ready
}

// ----
block 0 order: 2, 1
none

// ====

// A certified assignment affects only its own class, even though its generic
// trait is UNKNOWN_EFFECTS. The independent update class remains commutative.
// RUN: emit low-schedule-query @independent_assignment kind=state strategy=resource-stall consumer=*
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @independent_assignment(%value: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %first = test.schedule_state.update.i32 %value
  test.state.assign.i32.immediate 12
  %second = test.schedule_state.update.i32 %value
  return %first, %second
}

// ----
none

// ====

// Ordinary readers do not serialize each other when there are no writers.
// RUN: emit low-schedule-query @read_only_state kind=state strategy=resource-stall consumer=*
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @read_only_state(%value: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %first = test.state.read.i32 %value
  %second = test.state.read.i32 %value
  return %first, %second
}

