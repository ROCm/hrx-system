// ====

// A live-in explicit state value is also an observable snapshot. Its reader
// must run before the first clobber even though the value has no local producer.
// RUN: emit low-schedule-query @live_in_state_snapshot kind=state strategy=source order=0,2 consumer=0,1
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @live_in_state_snapshot(%state: reg<test.schedule_state>, %rhs: reg<test.schedule_state>) asm {
  %first = test.state.add.schedule_state %state, %rhs
  %second = test.state.add.schedule_state %state, %rhs
  %read = test.explicit.state.add.schedule_state %rhs, %state
  return
}

