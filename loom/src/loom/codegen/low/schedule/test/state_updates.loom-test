// ====

// A reader in the predecessor block does not inhibit later-block commutation.
// The later block still begins after the existing control boundary.
// RUN: emit low-schedule-query @block_local_observations kind=state strategy=resource-stall order=5,6 consumer=2,6
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @block_local_observations(%lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>) asm {
  %observed = test.state.read.i32 %lhs
  %before0 = test.state.update.i32 %lhs
  %before1 = test.state.update.i32 %rhs
  low.br ^next
^next:
  %slow = test.event.slow.i32 %lhs, %rhs
  %after0 = test.state.update.i32 %slow
  %after1 = test.state.update.i32 %lhs
  return %observed, %before0, %before1, %after0, %after1
}

