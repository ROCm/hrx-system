// RUN: emit low-schedule-query @reader_between_updates kind=state strategy=resource-stall consumer=1,2
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @reader_between_updates(%value: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32>) asm {
  %first = test.state.update.i32 %value
  %observed = test.state.read.i32 %value
  %second = test.state.update.i32 %value
  return %observed, %first, %second
}

