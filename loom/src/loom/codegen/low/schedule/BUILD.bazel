        "//loom/src/loom/util:segmented_storage",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
    ],
)

loom_cc_library(
    name = "ready_frontier",
    srcs = ["ready_frontier.c"],
    hdrs = ["ready_frontier.h"],
