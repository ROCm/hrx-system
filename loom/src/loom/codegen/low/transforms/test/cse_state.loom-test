// Repeating one result-coupled sticky update adds no state after any number of
// commutative updates to the same class. The distinct peer result remains.
// RUN: pass low-cse
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @idempotent_update_reuses_through_commutative_peers(%lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32>) asm {
  %first = test.state.update.i32 %lhs
  %peer = test.state.update.i32 %rhs
  %same = test.state.update.i32 %lhs
  return %first, %peer, %same
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @idempotent_update_reuses_through_commutative_peers(%lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32>) asm {
  %first = test.state.update.i32 %lhs
  %peer = test.state.update.i32 %rhs
  return %first, %peer, %first
}

// ====

// An ordinary read/write of the same state class invalidates sticky-update
// reuse even when the later packet has the same explicit operands.
// RUN: pass low-cse
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @idempotent_update_stops_at_noncommutative_write(%lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32>) asm {
  %before = test.state.update.i32 %lhs
  %clobber = test.state.add.i32 %rhs, %rhs
  %after = test.state.update.i32 %lhs
  return %before, %clobber, %after
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @idempotent_update_stops_at_noncommutative_write(%lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32>) asm {
  %before = test.state.update.i32 %lhs
  %clobber = test.state.add.i32 %rhs, %rhs
  %after = test.state.update.i32 %lhs
  return %before, %clobber, %after
}

// ====

// State read by the result computation retains its ordinary epoch. A write to
// that disjoint class changes the result and prevents reuse.
// RUN: pass low-cse
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @idempotent_update_preserves_hidden_read_epochs(%value: reg<test.i32>, %schedule: reg<test.schedule_state>) -> (reg<test.i32>, reg<test.schedule_state>, reg<test.i32>) asm {
  %before = test.state.update.read_schedule.i32 %value
  %schedule_update = test.state.add.schedule_state %schedule, %schedule
  %after = test.state.update.read_schedule.i32 %value
  return %before, %schedule_update, %after
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @idempotent_update_preserves_hidden_read_epochs(%value: reg<test.i32>, %schedule: reg<test.schedule_state>) -> (reg<test.i32>, reg<test.schedule_state>, reg<test.i32>) asm {
  %before = test.state.update.read_schedule.i32 %value
  %schedule_update = test.state.add.schedule_state %schedule, %schedule
  %after = test.state.update.read_schedule.i32 %value
  return %before, %schedule_update, %after
}

// ====

// Storage constructors retain distinct virtual-register identities. The
// idempotent descriptor alone compares their carried content, including
// direct aliases and independently reconstructed concat/slice values.
// RUN: pass low-cse
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @idempotent_update_uses_structural_content(%lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %copy0 = copy %lhs : reg<test.i32> -> reg<test.i32>
  %moved0 = move %copy0 : reg<test.i32> -> reg<test.i32>
  %assumed0 = low.assume %moved0 [range(%moved0, -2147483648, 2147483647)] : reg<test.i32>
  %pair0 = concat(%assumed0, %rhs) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32 x2>
  %lane0 = slice %pair0[0] : reg<test.i32 x2> -> reg<test.i32>
  %first = test.state.update.i32 %lane0
  %copy1 = copy %lhs : reg<test.i32> -> reg<test.i32>
  %moved1 = move %copy1 : reg<test.i32> -> reg<test.i32>
  %assumed1 = low.assume %moved1 [range(%moved1, -2147483648, 2147483647)] : reg<test.i32>
  %pair1 = concat(%assumed1, %rhs) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32 x2>
  %lane1 = slice %pair1[0] : reg<test.i32 x2> -> reg<test.i32>
  %same = test.state.update.i32 %lane1
  return %first, %same
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @idempotent_update_uses_structural_content(%lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %copy0 = copy %lhs : reg<test.i32> -> reg<test.i32>
  %moved0 = move %copy0 : reg<test.i32> -> reg<test.i32>
  %assumed0 = low.assume %moved0 [range(%moved0, -2147483648, 2147483647)] : reg<test.i32>
  %pair0 = concat(%assumed0, %rhs) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32 x2>
  %lane0 = slice %pair0[0] : reg<test.i32 x2> -> reg<test.i32>
  %first = test.state.update.i32 %lane0
  %copy1 = copy %lhs : reg<test.i32> -> reg<test.i32>
  %moved1 = move %copy1 : reg<test.i32> -> reg<test.i32>
  %assumed1 = low.assume %moved1 [range(%moved1, -2147483648, 2147483647)] : reg<test.i32>
  %pair1 = concat(%assumed1, %rhs) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32 x2>
  %lane1 = slice %pair1[0] : reg<test.i32 x2> -> reg<test.i32>
  return %first, %first
}

// ====

// A consumer that transfers each result's storage ownership keeps both
// otherwise identical updates and their independent result identities.
// RUN: pass low-cse
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @idempotent_update_preserves_result_ownership(%value: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %first = test.state.update.i32 %value
  %second = test.state.update.i32 %value
  %first_tied = test.tied.any %first
  %second_tied = test.tied.any %second
  return %first_tied, %second_tied
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @idempotent_update_preserves_result_ownership(%value: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %first = test.state.update.i32 %value
  %second = test.state.update.i32 %value
  %first_tied = test.tied.any %first
  %second_tied = test.tied.any %second
  return %first_tied, %second_tied
}

// ====

// Hidden state reads are reusable until their class is written. A write to
// another class must preserve the single-class read and expire the pair.
// RUN: pass low-cse
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @selective_state_classes(%value: reg<test.i32>, %schedule: reg<test.schedule_state>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>) asm {
  %special_before = test.state.read.i32 %value
  %pair_before = test.state.read_pair.i32 %value
  %schedule_write = test.state.add.schedule_state %schedule, %schedule
  %special_after = test.state.read.i32 %value
  %pair_after = test.state.read_pair.i32 %value
  %pair_copy = test.state.read_pair.i32 %value
  %special_write = test.state.add.i32 %value, %value
  %special_final = test.state.read.i32 %value
  %pair_final = test.state.read_pair.i32 %value
  return %special_after, %pair_copy, %special_final, %pair_final
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @selective_state_classes(%value: reg<test.i32>, %schedule: reg<test.schedule_state>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>) asm {
  %special_before = test.state.read.i32 %value
  %pair_before = test.state.read_pair.i32 %value
  %schedule_write = test.state.add.schedule_state %schedule, %schedule
  %pair_after = test.state.read_pair.i32 %value
  %special_write = test.state.add.i32 %value, %value
  %special_final = test.state.read.i32 %value
  %pair_final = test.state.read_pair.i32 %value
  return %special_before, %pair_after, %special_final, %pair_final
}

// ====

// Upfront CFG scopes inherit state memberships when their parent executes,
// not when scopes are allocated. Empty intermediate scopes forward the map.
// RUN: pass low-cse
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @state_through_empty_scopes(%value: reg<test.i32>, %schedule: reg<test.schedule_state>) -> (reg<test.i32>, reg<test.i32>) asm {
  %special = test.state.read.i32 %value
  %pair = test.state.read_pair.i32 %value
  low.br ^bridge
^bridge:
  low.br ^next_bridge
^next_bridge:
  low.br ^finish
^finish:
  %schedule_write = test.state.add.schedule_state %schedule, %schedule
  %special_copy = test.state.read.i32 %value
  %pair_after = test.state.read_pair.i32 %value
  return %special_copy, %pair_after
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @state_through_empty_scopes(%value: reg<test.i32>, %schedule: reg<test.schedule_state>) -> (reg<test.i32>, reg<test.i32>) asm {
  %special = test.state.read.i32 %value
  %pair = test.state.read_pair.i32 %value
  low.br ^bridge
^bridge:
  low.br ^next_bridge
^next_bridge:
  low.br ^finish
^finish:
  %schedule_write = test.state.add.schedule_state %schedule, %schedule
  %pair_after = test.state.read_pair.i32 %value
  return %special, %pair_after
}

// ====

// Writes expire shared ancestors, but not sibling-local definitions. The right
// subtree's write must preserve reuse in the left finish block; a global state
// epoch would lose that reuse.
// RUN: pass low-cse
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @sibling_state_snapshots(%condition: reg<test.i32>, %value: reg<test.i32>) -> (reg<test.i32>) asm {
  %outer = test.state.read.i32 %value
  low.cond_br %condition, ^left, ^right : reg<test.i32>
^left:
  %left_write = test.state.add.i32 %value, %value
  %left_value = test.state.read.i32 %value
  low.br ^left_finish
^right:
  %right_write = test.state.add.i32 %value, %value
  %right_value = test.state.read.i32 %value
  low.br ^right_finish
^left_finish:
  %left_copy = test.state.read.i32 %value
  return %left_copy
^right_finish:
  %right_copy = test.state.read.i32 %value
  return %right_copy
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @sibling_state_snapshots(%condition: reg<test.i32>, %value: reg<test.i32>) -> (reg<test.i32>) asm {
  %outer = test.state.read.i32 %value
  low.cond_br %condition, ^left, ^right : reg<test.i32>
^left:
  %left_write = test.state.add.i32 %value, %value
  %left_value = test.state.read.i32 %value
  low.br ^left_finish
^right:
  %right_write = test.state.add.i32 %value, %value
  %right_value = test.state.read.i32 %value
  low.br ^right_finish
^left_finish:
  return %left_value
^right_finish:
  return %right_value
}

// ====

// The pair expires through one class, then its slot is reused by another
// insertion. The second class must still reach the newly registered pair,
// rather than treating a reused slot as an already-expired membership.
// RUN: pass low-cse
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @state_membership_epochs(%value: reg<test.i32>, %schedule: reg<test.schedule_state>) -> (reg<test.i32>, reg<test.i32>) asm {
  %before = test.state.read_pair.i32 %value
  %special_write = test.state.add.i32 %value, %value
  %middle = test.state.read_pair.i32 %value
  %schedule_write = test.state.add.schedule_state %schedule, %schedule
  %after = test.state.read_pair.i32 %value
  %special = test.state.read.i32 %value
  %next_schedule_write = test.state.add.schedule_state %schedule, %schedule
  %special_copy = test.state.read.i32 %value
  %last = test.state.read_pair.i32 %value
  %last_copy = test.state.read_pair.i32 %value
  return %special_copy, %last_copy
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @state_membership_epochs(%value: reg<test.i32>, %schedule: reg<test.schedule_state>) -> (reg<test.i32>, reg<test.i32>) asm {
  %before = test.state.read_pair.i32 %value
  %special_write = test.state.add.i32 %value, %value
  %middle = test.state.read_pair.i32 %value
  %schedule_write = test.state.add.schedule_state %schedule, %schedule
  %after = test.state.read_pair.i32 %value
  %special = test.state.read.i32 %value
  %next_schedule_write = test.state.add.schedule_state %schedule, %schedule
  %last = test.state.read_pair.i32 %value
  return %special, %last
}

// ====
// A join cuts off older mutable-state candidates without hiding pure ones.
// Its straight-line descendant can reuse the new read below that boundary.
// RUN: pass low-cse
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @join_visibility_boundary(%condition: reg<test.i32>, %pointer: reg<test.ptr>) -> (reg<test.i32 x4>, reg<test.i32>) asm {
  %entry_read = test.load.v4i32 %pointer
  %bias = test.const.i32 7
  low.cond_br %condition, ^left, ^right : reg<test.i32>
^left:
  low.br ^join
^right:
  low.br ^join
^join:
  %joined_read = test.load.v4i32 %pointer
  %joined_bias = test.const.i32 7
  low.br ^finish
^finish:
  %final_read = test.load.v4i32 %pointer
  %final_bias = test.const.i32 7
  return %final_read, %final_bias
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @join_visibility_boundary(%condition: reg<test.i32>, %pointer: reg<test.ptr>) -> (reg<test.i32 x4>, reg<test.i32>) asm {
  %entry_read = test.load.v4i32 %pointer
  %bias = test.const.i32 7
  low.cond_br %condition, ^left, ^right : reg<test.i32>
^left:
  low.br ^join
^right:
  low.br ^join
^join:
  %joined_read = test.load.v4i32 %pointer
  low.br ^finish
^finish:
  return %joined_read, %bias
}

// ====

// A loop's backedge also cuts off older reads. The loop-local candidate is
// visible to its body and exit, while pure candidates remain visible above it.
// RUN: pass low-cse
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @backedge_visibility_boundary(%condition: reg<test.i32>, %pointer: reg<test.ptr>) -> (reg<test.i32 x4>, reg<test.i32>) asm {
  %entry_read = test.load.v4i32 %pointer
  %bias = test.const.i32 7
  low.br ^header
^header:
  %loop_read = test.load.v4i32 %pointer
  %loop_bias = test.const.i32 7
  low.cond_br %condition, ^body, ^finish : reg<test.i32>
^body:
  %body_read = test.load.v4i32 %pointer
  low.br ^header
^finish:
  %final_read = test.load.v4i32 %pointer
  %final_bias = test.const.i32 7
  return %final_read, %final_bias
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @backedge_visibility_boundary(%condition: reg<test.i32>, %pointer: reg<test.ptr>) -> (reg<test.i32 x4>, reg<test.i32>) asm {
  %entry_read = test.load.v4i32 %pointer
  %bias = test.const.i32 7
  low.br ^header
^header:
  %loop_read = test.load.v4i32 %pointer
  low.cond_br %condition, ^body, ^finish : reg<test.i32>
^body:
  low.br ^header
^finish:
  return %loop_read, %bias
}

// ====

// Reading a class does not invalidate its assignment. Removing the repeated
// assignment also preserves the epoch used by ordinary state-read CSE.
// RUN: pass low-cse
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @identical_state_assignment(%value: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  test.state.assign.i32 %value
  %before = test.state.read.i32 %value
  test.state.assign.i32 %value
  %after = test.state.read.i32 %value
  return %before, %after
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @identical_state_assignment(%value: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  test.state.assign.i32 %value
  %before = test.state.read.i32 %value
  return %before, %before
}

// ====

// A write to another architectural class preserves the remembered assignment.
// RUN: pass low-cse
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @assignment_survives_disjoint_write(%value: reg<test.i32>, %schedule: reg<test.schedule_state>) -> (reg<test.schedule_state>) asm {
  test.state.assign.i32 %value
  %updated = test.state.add.schedule_state %schedule, %schedule
  test.state.assign.i32 %value
  return %updated
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @assignment_survives_disjoint_write(%value: reg<test.i32>, %schedule: reg<test.schedule_state>) -> (reg<test.schedule_state>) asm {
  test.state.assign.i32 %value
  %updated = test.state.add.schedule_state %schedule, %schedule
  return %updated
}

// ====

// Immediate assignments use exact structural identity even when no operation
// produces an SSA value. Changed values and the final reset remain observable.
// RUN: pass low-cse
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @immediate_assignment_and_reset() asm {
  test.state.assign.i32.immediate 12
  test.state.assign.i32.immediate 12
  test.state.assign.i32.immediate 0
  test.state.assign.i32.immediate 12
  return
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @immediate_assignment_and_reset() asm {
  test.state.assign.i32.immediate 12
  test.state.assign.i32.immediate 0
  test.state.assign.i32.immediate 12
  return
}

// ====

// Explicit SSA inputs are compared by identity, not by the setter's opcode.
// An arbitrary same-class writer also expires the remembered assignment.
// RUN: pass low-cse
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @assignment_inputs_and_clobbers(%first: reg<test.i32>, %second: reg<test.i32>) -> (reg<test.i32>) asm {
  test.state.assign.i32 %first
  test.state.assign.i32 %second
  test.state.assign.i32 %first
  %updated = test.state.add.i32 %first, %second
  test.state.assign.i32 %first
  return %updated
}

// ====

// No value epoch advances in this body. Distinct zero-result fences still
// prevent assignment reuse across their source-order boundaries.
// RUN: pass low-cse
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @assignment_zero_result_boundaries() asm {
  test.state.assign.i32.immediate 12
  test.barrier
  test.state.assign.i32.immediate 12
  low.schedule.fence
  test.state.assign.i32.immediate 12
  return
}

// ====

// Call purity promises deterministic memory-free results, not preservation of
// a caller's architectural configuration. Unknown calls are boundaries too.
// RUN: pass low-cse
test.target<low_core> @test_target

low.func.decl pure target<test.low.core>(@test_target) @pure_helper()

low.func.decl target<test.low.core>(@test_target) @unknown_helper()

low.func.def target<test.low.core>(@test_target) @assignment_call_boundaries() asm {
  test.state.assign.i32.immediate 12
  low.func.call pure @pure_helper() : ()
  test.state.assign.i32.immediate 12
  low.func.call @unknown_helper() : ()
  test.state.assign.i32.immediate 12
  return
}

// ====

// Assignment availability is block-local. A conditional region cannot import
// the outer assignment or publish its branch-local replacement to the caller.
// RUN: pass low-cse
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @assignment_nested_regions(%condition: reg<test.i32>) asm {
  test.state.assign.i32.immediate 12
  low.scf.if %condition {
    test.state.assign.i32.immediate 12
    test.state.assign.i32.immediate 12
  } else {
    test.state.assign.i32.immediate 12
    test.state.assign.i32.immediate 12
  }
  test.state.assign.i32.immediate 12
  return
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @assignment_nested_regions(%condition: reg<test.i32>) asm {
  test.state.assign.i32.immediate 12
  low.scf.if %condition {
    test.state.assign.i32.immediate 12
  } else {
    test.state.assign.i32.immediate 12
  }
  test.state.assign.i32.immediate 12
  return
}

// ====

// Sibling blocks and their join each need an assignment. Repeated assignments
// within each sibling still fold without importing another path's state.
// RUN: pass low-cse
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @assignment_cfg_boundaries(%condition: reg<test.i32>) asm {
  test.state.assign.i32.immediate 12
  low.cond_br %condition, ^left, ^right : reg<test.i32>
^left:
  test.state.assign.i32.immediate 12
  test.state.assign.i32.immediate 12
  low.br ^join
^right:
  test.state.assign.i32.immediate 12
  test.state.assign.i32.immediate 12
  low.br ^join
^join:
  test.state.assign.i32.immediate 12
  return
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @assignment_cfg_boundaries(%condition: reg<test.i32>) asm {
  test.state.assign.i32.immediate 12
  low.cond_br %condition, ^left, ^right : reg<test.i32>
^left:
  test.state.assign.i32.immediate 12
  low.br ^join
^right:
  test.state.assign.i32.immediate 12
  low.br ^join
^join:
  test.state.assign.i32.immediate 12
  return
}

// ====

// Ordinary described memory writes do not change architectural configuration.
// An individually observable access remains a conservative boundary.
// RUN: pass low-cse
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @assignment_memory_observations(%configuration: reg<test.i32>, %address: reg<test.ptr>, %payload: reg<test.i32 x4>) asm {
  test.state.assign.i32 %configuration
  test.store.v4i32 %address, %payload
  test.state.assign.i32 %configuration
  test.store.v4i32<volatile> %address, %payload
  test.state.assign.i32 %configuration
  return
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @assignment_memory_observations(%configuration: reg<test.i32>, %address: reg<test.ptr>, %payload: reg<test.i32 x4>) asm {
  test.state.assign.i32 %configuration
  test.store.v4i32 %address, %payload
  test.store.v4i32<volatile> %address, %payload
  test.state.assign.i32 %configuration
  return
}

// ====

// Dynamic participant changes invalidate assignment availability even when
// they leave this particular architectural class alone.
// RUN: pass low-cse
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @assignment_convergent_boundary(%value: reg<test.i32>) -> (reg<test.i32>) asm {
  test.state.assign.i32.immediate 12
  %participating = test.convergent.i32 %value
  test.state.assign.i32.immediate 12
  return %participating
}
