// RUN: pass source-to-low

// The descriptor program emits one shared zero before its per-lane tail.
// Each lane multiplies its operands and adds the same setup value.
test.target<low_core> @test_target

func.def target(@test_target) @shared_lane_setup(%lhs: vector<2xi32>, %rhs: vector<2xi32>) -> (vector<2xi32>) {
  %result = vector.muli %lhs, %rhs : vector<2xi32>
  func.return %result : vector<2xi32>
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) abi(object_function) @shared_lane_setup(%lhs: reg<test.i32 x2>, %rhs: reg<test.i32 x2>) -> (reg<test.i32 x2>) {
  %7 = low.const<test.const.i32> {i32_value = 0} : reg<test.i32>
  %8 = low.slice %lhs[0] : reg<test.i32 x2> -> reg<test.i32>
  %9 = low.slice %rhs[0] : reg<test.i32 x2> -> reg<test.i32>
  %10 = low.op<test.mul.i32>(%8, %9) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32>
  %11 = low.op<test.add.i32>(%10, %7) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32>
  %12 = low.slice %lhs[1] : reg<test.i32 x2> -> reg<test.i32>
  %13 = low.slice %rhs[1] : reg<test.i32 x2> -> reg<test.i32>
  %14 = low.op<test.mul.i32>(%12, %13) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32>
  %15 = low.op<test.add.i32>(%14, %7) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32>
  %result = low.concat(%11, %15) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32 x2>
  low.return %result : reg<test.i32 x2>
}
