// Eager legalization leaves lane programs available for source-level sharing.
func.def target(@target) @share_before_lane_expansion(%lhs: vector<2xi64>, %rhs: vector<2xi64>) -> (vector<2xi64>, vector<2xi64>) {
  %first = vector.divsi %lhs, %rhs : vector<2xi64>
  %second = vector.divsi %lhs, %rhs : vector<2xi64>
  func.return %first, %second : vector<2xi64>, vector<2xi64>
}

