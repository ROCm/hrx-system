  %35 = vector.extract %rhs[3] : vector<4xi32> -> i32
  %36 = scalar.shrsi %34, %35 : i32
  %38 = vector.splat %27 : vector<4xi32>
  %39 = vector.insert %30 into %38[1] : i32, vector<4xi32>
  %40 = vector.insert %33 into %39[2] : i32, vector<4xi32>
  %shrs = vector.insert %36 into %40[3] : i32, vector<4xi32>
  %8 = vector.extract %lhs[0] : vector<4xi32> -> i32
  %9 = vector.extract %rhs[0] : vector<4xi32> -> i32
  %10 = scalar.shrui %8, %9 : i32
  %11 = vector.extract %lhs[1] : vector<4xi32> -> i32
  %12 = vector.extract %rhs[1] : vector<4xi32> -> i32
  %13 = scalar.shrui %11, %12 : i32
  %14 = vector.extract %lhs[2] : vector<4xi32> -> i32
  %15 = vector.extract %rhs[2] : vector<4xi32> -> i32
  %16 = scalar.shrui %14, %15 : i32
  %17 = vector.extract %lhs[3] : vector<4xi32> -> i32
  %18 = vector.extract %rhs[3] : vector<4xi32> -> i32
  %19 = scalar.shrui %17, %18 : i32
  %21 = vector.splat %10 : vector<4xi32>
  %22 = vector.insert %13 into %21[1] : i32, vector<4xi32>
  %23 = vector.insert %16 into %22[2] : i32, vector<4xi32>
  %shru = vector.insert %19 into %23[3] : i32, vector<4xi32>
  func.return %shl, %shrs, %shru : vector<4xi32>, vector<4xi32>, vector<4xi32>
}

