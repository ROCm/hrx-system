}

// ====
// RUN: pass target-legalize{mode=complete},dce

test.target<low_core> @test_target

// Range coordinates retain their narrow modular arithmetic while the target
// fallback materializes each mask lane and its signed upper-bound comparison.
func.def target(@test_target) @narrow_range_mask_reference(%lower: i8, %upper: i8, %step: i8) {
  %mask = vector.mask.range [%lower to %upper step %step] : i8 -> vector<2xi1>
  test.use %mask : vector<2xi1>
  func.return
}

// ----
test.target<low_core> @test_target

func.def target(@test_target) @narrow_range_mask_reference(%lower: i8, %upper: i8, %step: i8) {
  %4 = scalar.constant 0 : i8
  %33 = scalar.extui %4 : i8 to i32
  %34 = scalar.extui %step : i8 to i32
  %35 = scalar.muli %33, %34 : i32
  %36 = scalar.trunci %35 : i32 to i8
  %29 = scalar.extui %lower : i8 to i32
  %30 = scalar.extui %36 : i8 to i32
  %31 = scalar.addi %29, %30 : i32
  %32 = scalar.trunci %31 : i32 to i8
  %26 = scalar.extsi %32 : i8 to i32
  %27 = scalar.extsi %upper : i8 to i32
  %28 = scalar.cmpi slt, %26, %27 : i32
  %8 = scalar.constant 1 : i8
  %22 = scalar.extui %8 : i8 to i32
  %23 = scalar.extui %step : i8 to i32
  %24 = scalar.muli %22, %23 : i32
  %25 = scalar.trunci %24 : i32 to i8
  %18 = scalar.extui %lower : i8 to i32
  %19 = scalar.extui %25 : i8 to i32
  %20 = scalar.addi %18, %19 : i32
  %21 = scalar.trunci %20 : i32 to i8
  %15 = scalar.extsi %21 : i8 to i32
  %16 = scalar.extsi %upper : i8 to i32
  %17 = scalar.cmpi slt, %15, %16 : i32
  %13 = vector.splat %28 : vector<2xi1>
  %mask = vector.insert %17 into %13[1] : i1, vector<2xi1>
  test.use %mask : vector<2xi1>
  func.return
}

