  %15 = scalar.shli %13, %14 : i32
  %16 = scalar.shrsi %15, %14 : i32
  %11 = scalar.shrsi %20, %16 : i32
  %shifted = scalar.trunci %11 : i32 to i16
  func.return %quotient, %remainder, %shifted : i16, i16, i16
}

