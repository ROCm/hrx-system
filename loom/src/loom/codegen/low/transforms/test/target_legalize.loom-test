test.target<low_core> @target

func.def target(@target) @share_before_lane_expansion(%lhs: vector<2xi64>, %rhs: vector<2xi64>) -> (vector<2xi64>, vector<2xi64>) {
  %first = vector.divsi %lhs, %rhs : vector<2xi64>
  func.return %first, %first : vector<2xi64>, vector<2xi64>
}

// ====
// RUN: pass target-legalize{mode=eager},canonicalize,cse,target-legalize{mode=complete},canonicalize,cse

test.target<low_core> @target

// Complete legalization expands the shared program once, retaining both uses.
func.def target(@target) @expand_shared_lanes(%lhs: vector<2xi64>, %rhs: vector<2xi64>) -> (vector<2xi64>, vector<2xi64>) {
  %first = vector.divsi %lhs, %rhs : vector<2xi64>
  %second = vector.divsi %lhs, %rhs : vector<2xi64>
  func.return %first, %second : vector<2xi64>, vector<2xi64>
}

// ----
test.target<low_core> @target

func.def target(@target) @expand_shared_lanes(%lhs: vector<2xi64>, %rhs: vector<2xi64>) -> (vector<2xi64>, vector<2xi64>) {
  %6 = vector.extract %lhs[0] : vector<2xi64> -> i64
  %7 = vector.extract %rhs[0] : vector<2xi64> -> i64
  %8 = scalar.divsi %6, %7 : i64
  %9 = vector.extract %lhs[1] : vector<2xi64> -> i64
  %10 = vector.extract %rhs[1] : vector<2xi64> -> i64
  %11 = scalar.divsi %9, %10 : i64
  %13 = vector.splat %8 : vector<2xi64>
  %first = vector.insert %11 into %13[1] : i64, vector<2xi64>
  func.return %first, %first : vector<2xi64>, vector<2xi64>
}
