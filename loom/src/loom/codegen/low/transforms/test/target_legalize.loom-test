func.def target(@test_target) @narrow_unsigned_operands(%left: i8, %right: i8, %shift: i8) -> (i8, i8, i8, i8, i8, i8, i8, i8) {
  %difference = scalar.subi<nsw> %left, %right : i8
  %product = scalar.muli<nuw> %left, %right : i8
  %quotient = scalar.divui %left, %right : i8
  %remainder = scalar.remui %left, %right : i8
  %intersection = scalar.andi %left, %right : i8
  %union = scalar.ori %left, %right : i8
  %exclusive = scalar.xori %left, %right : i8
  %shifted = scalar.shli<nuw> %left, %shift : i8
  func.return %difference, %product, %quotient, %remainder, %intersection, %union, %exclusive, %shifted : i8, i8, i8, i8, i8, i8, i8, i8
}

