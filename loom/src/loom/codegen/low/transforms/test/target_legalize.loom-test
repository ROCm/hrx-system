test.target<low_core> @test_target

func.def target(@test_target) @narrow_unsigned_operands(%left: i8, %right: i8, %shift: i8) -> (i8, i8, i8, i8, i8, i8, i8, i8) {
  %55 = scalar.extui %left : i8 to i32
  %56 = scalar.extui %right : i8 to i32
  %57 = scalar.subi %55, %56 : i32
  %difference = scalar.trunci %57 : i32 to i8
  %51 = scalar.extui %left : i8 to i32
  %52 = scalar.extui %right : i8 to i32
  %53 = scalar.muli %51, %52 : i32
  %product = scalar.trunci %53 : i32 to i8
  %47 = scalar.extui %left : i8 to i32
  %48 = scalar.extui %right : i8 to i32
  %49 = scalar.divui %47, %48 : i32
  %quotient = scalar.trunci %49 : i32 to i8
  %43 = scalar.extui %left : i8 to i32
  %44 = scalar.extui %right : i8 to i32
  %45 = scalar.remui %43, %44 : i32
  %remainder = scalar.trunci %45 : i32 to i8
  %39 = scalar.extui %left : i8 to i32
  %40 = scalar.extui %right : i8 to i32
  %41 = scalar.andi %39, %40 : i32
  %intersection = scalar.trunci %41 : i32 to i8
  %35 = scalar.extui %left : i8 to i32
  %36 = scalar.extui %right : i8 to i32
  %37 = scalar.ori %35, %36 : i32
  %union = scalar.trunci %37 : i32 to i8
  %31 = scalar.extui %left : i8 to i32
  %32 = scalar.extui %right : i8 to i32
  %33 = scalar.xori %31, %32 : i32
  %exclusive = scalar.trunci %33 : i32 to i8
  %27 = scalar.extui %left : i8 to i32
  %28 = scalar.constant 24 : i32
  %29 = scalar.shli %27, %28 : i32
  %30 = scalar.shrsi %29, %28 : i32
  %23 = scalar.extui %shift : i8 to i32
  %24 = scalar.constant 24 : i32
  %25 = scalar.shli %23, %24 : i32
  %26 = scalar.shrsi %25, %24 : i32
  %21 = scalar.shli %30, %26 : i32
  %shifted = scalar.trunci %21 : i32 to i8
  func.return %difference, %product, %quotient, %remainder, %intersection, %union, %exclusive, %shifted : i8, i8, i8, i8, i8, i8, i8, i8
}

// ====
// RUN: with-checks pass target-legalize{mode=final,policy=reference-only},canonicalize,dce

test.target<low_core> @test_target

// Generic canonicalization may move a proven left shift before zero extension.
// The target fallback must remain in the supported i32 domain after cleanup.
func.def target(@test_target) @narrow_shift_survives_cleanup(%input: i8, %amount: i8) -> (i8) {
  %bounded = scalar.assume %input [range(%input, 0, 1)] : i8
  %exact_amount = scalar.assume %amount [range(%amount, 7, 7)] : i8
  %shifted = scalar.shli %bounded, %exact_amount : i8
  func.return %shifted : i8
}

// ----
CHECK: * = scalar.shli * : i32
CHECK-NOT: * = scalar.shli * : i8

