func.def target(@test_target) @signed_floor(%lhs: vector<2xi32>, %rhs: vector<2xi32>) -> (vector<2xi32>) {
  %70 = vector.extract %lhs[0] : vector<2xi32> -> i32
  %71 = vector.extract %rhs[0] : vector<2xi32> -> i32
  %72 = scalar.floordivsi %70, %71 : i32
  %73 = vector.extract %lhs[1] : vector<2xi32> -> i32
  %74 = vector.extract %rhs[1] : vector<2xi32> -> i32
  %75 = scalar.floordivsi %73, %74 : i32
  %result = vector.from_elements %72, %75 : vector<2xi32>
