// RUN: pass target-legalize{mode=complete,policy=prefer-native},dce

test.target<low_core> @test_target

func.def target(@test_target) @signed_quotient(%lhs: vector<2xi64>, %rhs: vector<2xi64>) -> (vector<2xi64>) {
  %result = vector.divsi %lhs, %rhs : vector<2xi64>
  func.return %result : vector<2xi64>
}

func.def target(@test_target) @unsigned_quotient(%lhs: vector<2xi64>, %rhs: vector<2xi64>) -> (vector<2xi64>) {
  %result = vector.divui %lhs, %rhs : vector<2xi64>
  func.return %result : vector<2xi64>
}

func.def target(@test_target) @signed_remainder(%lhs: vector<2xi64>, %rhs: vector<2xi64>) -> (vector<2xi64>) {
  %result = vector.remsi %lhs, %rhs : vector<2xi64>
  func.return %result : vector<2xi64>
}

func.def target(@test_target) @unsigned_remainder(%lhs: vector<2xi64>, %rhs: vector<2xi64>) -> (vector<2xi64>) {
  %result = vector.remui %lhs, %rhs : vector<2xi64>
  func.return %result : vector<2xi64>
}

func.def target(@test_target) @signed_ceil(%lhs: vector<2xi64>, %rhs: vector<2xi64>) -> (vector<2xi64>) {
  %result = vector.ceildivsi %lhs, %rhs : vector<2xi64>
  func.return %result : vector<2xi64>
}

func.def target(@test_target) @unsigned_ceil(%lhs: vector<2xi64>, %rhs: vector<2xi64>) -> (vector<2xi64>) {
  %result = vector.ceildivui %lhs, %rhs : vector<2xi64>
  func.return %result : vector<2xi64>
}

func.def target(@test_target) @signed_floor(%lhs: vector<2xi64>, %rhs: vector<2xi64>) -> (vector<2xi64>) {
  %result = vector.floordivsi %lhs, %rhs : vector<2xi64>
  func.return %result : vector<2xi64>
}

// ----
test.target<low_core> @test_target

func.def target(@test_target) @signed_quotient(%lhs: vector<2xi64>, %rhs: vector<2xi64>) -> (vector<2xi64>) {
  %28 = vector.extract %lhs[0] : vector<2xi64> -> i64
  %29 = vector.extract %rhs[0] : vector<2xi64> -> i64
  %30 = scalar.divsi %28, %29 : i64
  %31 = vector.extract %lhs[1] : vector<2xi64> -> i64
  %32 = vector.extract %rhs[1] : vector<2xi64> -> i64
  %33 = scalar.divsi %31, %32 : i64
  %35 = vector.splat %30 : vector<2xi64>
  %result = vector.insert %33 into %35[1] : i64, vector<2xi64>
  func.return %result : vector<2xi64>
}

