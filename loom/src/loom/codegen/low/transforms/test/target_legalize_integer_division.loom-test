func.def target(@test_target) @signed_ceil(%lhs: vector<2xi32>, %rhs: vector<2xi32>) -> (vector<2xi32>) {
  %56 = vector.extract %lhs[0] : vector<2xi32> -> i32
  %57 = vector.extract %rhs[0] : vector<2xi32> -> i32
  %58 = scalar.ceildivsi %56, %57 : i32
  %59 = vector.extract %lhs[1] : vector<2xi32> -> i32
  %60 = vector.extract %rhs[1] : vector<2xi32> -> i32
  %61 = scalar.ceildivsi %59, %60 : i32
  %result = vector.from_elements %58, %61 : vector<2xi32>
  func.return %result : vector<2xi32>
}

func.def target(@test_target) @unsigned_ceil(%lhs: vector<2xi32>, %rhs: vector<2xi32>) -> (vector<2xi32>) {
  %63 = vector.extract %lhs[0] : vector<2xi32> -> i32
  %64 = vector.extract %rhs[0] : vector<2xi32> -> i32
  %65 = scalar.ceildivui %63, %64 : i32
  %66 = vector.extract %lhs[1] : vector<2xi32> -> i32
  %67 = vector.extract %rhs[1] : vector<2xi32> -> i32
  %68 = scalar.ceildivui %66, %67 : i32
  %result = vector.from_elements %65, %68 : vector<2xi32>
