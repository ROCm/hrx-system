// RUN: pass target-legalize{mode=complete,policy=prefer-native},dce

// Word-sized lanes isolate scalarization from wide-division decomposition.
test.target<low_core> @test_target

func.def target(@test_target) @signed_quotient(%lhs: vector<2xi32>, %rhs: vector<2xi32>) -> (vector<2xi32>) {
  %result = vector.divsi %lhs, %rhs : vector<2xi32>
  func.return %result : vector<2xi32>
}

func.def target(@test_target) @unsigned_quotient(%lhs: vector<2xi32>, %rhs: vector<2xi32>) -> (vector<2xi32>) {
  %result = vector.divui %lhs, %rhs : vector<2xi32>
  func.return %result : vector<2xi32>
}

func.def target(@test_target) @signed_remainder(%lhs: vector<2xi32>, %rhs: vector<2xi32>) -> (vector<2xi32>) {
  %result = vector.remsi %lhs, %rhs : vector<2xi32>
  func.return %result : vector<2xi32>
}

func.def target(@test_target) @unsigned_remainder(%lhs: vector<2xi32>, %rhs: vector<2xi32>) -> (vector<2xi32>) {
  %result = vector.remui %lhs, %rhs : vector<2xi32>
  func.return %result : vector<2xi32>
}

func.def target(@test_target) @signed_ceil(%lhs: vector<2xi32>, %rhs: vector<2xi32>) -> (vector<2xi32>) {
  %result = vector.ceildivsi %lhs, %rhs : vector<2xi32>
  func.return %result : vector<2xi32>
}

func.def target(@test_target) @unsigned_ceil(%lhs: vector<2xi32>, %rhs: vector<2xi32>) -> (vector<2xi32>) {
  %result = vector.ceildivui %lhs, %rhs : vector<2xi32>
  func.return %result : vector<2xi32>
}

func.def target(@test_target) @signed_floor(%lhs: vector<2xi32>, %rhs: vector<2xi32>) -> (vector<2xi32>) {
  %result = vector.floordivsi %lhs, %rhs : vector<2xi32>
  func.return %result : vector<2xi32>
}

// ----
test.target<low_core> @test_target

func.def target(@test_target) @signed_quotient(%lhs: vector<2xi32>, %rhs: vector<2xi32>) -> (vector<2xi32>) {
  %28 = vector.extract %lhs[0] : vector<2xi32> -> i32
  %29 = vector.extract %rhs[0] : vector<2xi32> -> i32
  %30 = scalar.divsi %28, %29 : i32
  %31 = vector.extract %lhs[1] : vector<2xi32> -> i32
  %32 = vector.extract %rhs[1] : vector<2xi32> -> i32
  %33 = scalar.divsi %31, %32 : i32
  %result = vector.from_elements %30, %33 : vector<2xi32>
  func.return %result : vector<2xi32>
}

func.def target(@test_target) @unsigned_quotient(%lhs: vector<2xi32>, %rhs: vector<2xi32>) -> (vector<2xi32>) {
  %35 = vector.extract %lhs[0] : vector<2xi32> -> i32
  %36 = vector.extract %rhs[0] : vector<2xi32> -> i32
  %37 = scalar.divui %35, %36 : i32
  %38 = vector.extract %lhs[1] : vector<2xi32> -> i32
  %39 = vector.extract %rhs[1] : vector<2xi32> -> i32
  %40 = scalar.divui %38, %39 : i32
  %result = vector.from_elements %37, %40 : vector<2xi32>
  func.return %result : vector<2xi32>
}

func.def target(@test_target) @signed_remainder(%lhs: vector<2xi32>, %rhs: vector<2xi32>) -> (vector<2xi32>) {
  %42 = vector.extract %lhs[0] : vector<2xi32> -> i32
  %43 = vector.extract %rhs[0] : vector<2xi32> -> i32
  %44 = scalar.remsi %42, %43 : i32
  %45 = vector.extract %lhs[1] : vector<2xi32> -> i32
  %46 = vector.extract %rhs[1] : vector<2xi32> -> i32
  %47 = scalar.remsi %45, %46 : i32
  %result = vector.from_elements %44, %47 : vector<2xi32>
  func.return %result : vector<2xi32>
}

func.def target(@test_target) @unsigned_remainder(%lhs: vector<2xi32>, %rhs: vector<2xi32>) -> (vector<2xi32>) {
  %49 = vector.extract %lhs[0] : vector<2xi32> -> i32
  %50 = vector.extract %rhs[0] : vector<2xi32> -> i32
  %51 = scalar.remui %49, %50 : i32
  %52 = vector.extract %lhs[1] : vector<2xi32> -> i32
  %53 = vector.extract %rhs[1] : vector<2xi32> -> i32
  %54 = scalar.remui %52, %53 : i32
  %result = vector.from_elements %51, %54 : vector<2xi32>
  func.return %result : vector<2xi32>
