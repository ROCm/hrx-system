// RUN: pass source-to-low,low-dce

test.target<low_core> @test_target

func.def target(@test_target) @fuses_forward_producer_consumer(%lhs: i32, %rhs: i32, %factor: i32) -> (i32) {
  %sum = scalar.addi %lhs, %rhs : i32
  %product = scalar.muli %sum, %factor : i32
  func.return %product : i32
}

