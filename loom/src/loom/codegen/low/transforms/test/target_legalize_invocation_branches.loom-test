// RUN: pass specialize-target-callgraph,target-legalize{mode=final}

// Joining two callers proves the entire guarded range check unreachable.
test.target<low_core> @target

func.def public target(@target) @entry(%value: i32) -> (i32) {
  %c3 = scalar.constant 3 : i32
  %c4 = scalar.constant 4 : i32
  %first = func.call @helper(%c3, %value) : (i32, i32) -> (i32)
  %second = func.call @helper(%c4, %value) : (i32, i32) -> (i32)
  %result = scalar.addi %first, %second : i32
  func.return %result : i32
}

func.def target(@target) @helper(%index: i32, %value: i32) -> (i32) {
  %c3 = scalar.constant 3 : i32
  %condition = scalar.cmpi ult, %index, %c3 : i32
  %result = scf.if %condition -> (i32) {
    %checked = scalar.assume %index [ge(%index, 0), lt(%index, 3)] : i32
    %sum = scalar.addi %checked, %value : i32
    scf.yield %sum : i32
  } else {
    scf.yield %value : i32
  }
  func.return %result : i32
}

// ----
test.target<low_core> @target

func.def public target(@target) @entry(%value: i32) -> (i32) {
  %c3 = scalar.constant 3 : i32
  %c4 = scalar.constant 4 : i32
  %first = func.call @helper(%c3, %value) : (i32, i32) -> (i32)
  %second = func.call @helper(%c4, %value) : (i32, i32) -> (i32)
  %result = scalar.addi %first, %second : i32
  func.return %result : i32
}

func.def target(@target) @helper(%index: i32, %value: i32) -> (i32) {
  func.return %value : i32
}

// ====

// Signed index predicates use the same branch decision and diagnostic boundary.
test.target<low_core> @target

func.def public target(@target) @entry(%value: index) -> (index) {
  %upper_index = index.constant -3 : index
  %lower_index = index.constant -4 : index
  %first = func.call @helper(%upper_index, %value) : (index, index) -> (index)
  %second = func.call @helper(%lower_index, %value) : (index, index) -> (index)
  %result = index.add %first, %second : index
  func.return %result : index
}

func.def target(@target) @helper(%index: index, %value: index) -> (index) {
  %c0 = index.constant 0 : index
  %condition = index.cmp slt, %index, %c0 : index
  %result = scf.if %condition -> (index) {
    scf.yield %value : index
  } else {
    %checked = index.assume %index [range(%index, 0, 2)] : index
    %sum = index.add %checked, %value : index
    scf.yield %sum : index
  }
  func.return %result : index
}

// ----
test.target<low_core> @target

func.def public target(@target) @entry(%value: index) -> (index) {
  %upper_index = index.constant -3 : index
  %lower_index = index.constant -4 : index
  %first = func.call @helper(%upper_index, %value) : (index, index) -> (index)
  %second = func.call @helper(%lower_index, %value) : (index, index) -> (index)
  %result = index.add %first, %second : index
  func.return %result : index
}

func.def target(@target) @helper(%index: index, %value: index) -> (index) {
  func.return %value : index
}

// ====

// Result summaries can make a caller's branch unreachable too.
test.target<low_core> @target

func.def public target(@target) @entry(%condition: i1, %value: i32) -> (i32) {
  %index = func.call @choose(%condition) : (i1) -> (i32)
  %c3 = scalar.constant 3 : i32
  %below = scalar.cmpi slt, %index, %c3 : i32
  %result = scf.if %below -> (i32) {
    %checked = scalar.assume %index [range(%index, 0, 2)] : i32
    scf.yield %checked : i32
  } else {
    scf.yield %value : i32
  }
  func.return %result : i32
}

func.def target(@target) @choose(%condition: i1) -> (i32) {
  %c3 = scalar.constant 3 : i32
  %c4 = scalar.constant 4 : i32
  %result = scf.select %condition, %c3, %c4 : i32
  func.return %result : i32
}

// ----
test.target<low_core> @target

func.def public target(@target) @entry(%condition: i1, %value: i32) -> (i32) {
  %index = func.call @choose(%condition) : (i1) -> (i32)
  func.return %value : i32
}

func.def target(@target) @choose(%condition: i1) -> (i32) {
  %c3 = scalar.constant 3 : i32
  %c4 = scalar.constant 4 : i32
  %result = scf.select %condition, %c3, %c4 : i32
  func.return %result : i32
}

// ====

// Selected keyed arms may move another selected branch into the parent block.
// Neither unreachable scalar assumptions nor vector operations need lowering.
test.target<low_core> @target

func.def public target(@target) @entry(%values: vector<4xf32>) -> (vector<4xf32>) {
  %key = index.constant 7 : index
  %result = func.call @helper(%key, %values) : (index, vector<4xf32>) -> (vector<4xf32>)
  func.return %result : vector<4xf32>
}

func.def target(@target) @helper(%key: index, %values: vector<4xf32>) -> (vector<4xf32>) {
  %result = scf.switch %key -> (vector<4xf32>) {
    case 7 {
      %c7 = index.constant 7 : index
      %matches = index.cmp eq, %key, %c7 : index
      %selected = scf.if %matches -> (vector<4xf32>) {
        scf.yield %values : vector<4xf32>
      } else {
        %unsupported = vector.logisticf %values : vector<4xf32>
        scf.yield %unsupported : vector<4xf32>
      }
      scf.yield %selected : vector<4xf32>
    }
    default {
      %checked = index.assume %key [range(%key, 0, 2)] : index
      %picked = vector.extract %values[%checked] : vector<4xf32> -> f32
      %splat = vector.splat %picked : vector<4xf32>
      scf.yield %splat : vector<4xf32>
    }
  }
  func.return %result : vector<4xf32>
}

// ----
test.target<low_core> @target

func.def public target(@target) @entry(%values: vector<4xf32>) -> (vector<4xf32>) {
  %key = index.constant 7 : index
  %result = func.call @helper(%key, %values) : (index, vector<4xf32>) -> (vector<4xf32>)
  func.return %result : vector<4xf32>
}

func.def target(@target) @helper(%key: index, %values: vector<4xf32>) -> (vector<4xf32>) {
  func.return %values : vector<4xf32>
}

// ====

// A keyed selector outside the explicit cases selects the default arm.
test.target<low_core> @target

func.def public target(@target) @entry(%value: index) -> (index) {
  %key = index.constant 9 : index
  %result = func.call @helper(%key, %value) : (index, index) -> (index)
  func.return %result : index
}

func.def target(@target) @helper(%key: index, %value: index) -> (index) {
  %result = scf.switch %key -> (index) {
    case 7 {
      %checked = index.assume %key [eq(%key, 7)] : index
      scf.yield %checked : index
    }
    default {
      %sum = index.add %value, %key : index
      scf.yield %sum : index
    }
  }
  func.return %result : index
}

// ----
test.target<low_core> @target

func.def public target(@target) @entry(%value: index) -> (index) {
  %key = index.constant 9 : index
  %result = func.call @helper(%key, %value) : (index, index) -> (index)
  func.return %result : index
}

func.def target(@target) @helper(%key: index, %value: index) -> (index) {
  %sum = index.add %value, %key : index
  func.return %sum : index
}

// ====

// A live contradiction remains an error after the same argument refinement.
test.target<low_core> @target

func.def public target(@target) @entry() -> (i32) {
  %c3 = scalar.constant 3 : i32
  %c4 = scalar.constant 4 : i32
  %first = func.call @helper(%c3) : (i32) -> (i32)
  %second = func.call @helper(%c4) : (i32) -> (i32)
  %result = scalar.addi %first, %second : i32
  func.return %result : i32
}

func.def target(@target) @helper(%index: i32) -> (i32) {
  // ERROR@+1: TARGET/059 {predicate_name="range", value_name="index", required_min="0", required_max="2", known_min="3", known_max="4"}
  %checked = scalar.assume %index [range(%index, 0, 2)] : i32
  func.return %checked : i32
}

// ====

// A reachable arm exposed by folding still checks its assumption.
test.target<low_core> @target

func.def public target(@target) @entry() -> (index) {
  %c3 = index.constant 3 : index
  %result = func.call @helper(%c3) : (index) -> (index)
  func.return %result : index
}

func.def target(@target) @helper(%index: index) -> (index) {
  %c0 = index.constant 0 : index
  %condition = index.cmp sge, %index, %c0 : index
  %result = scf.if %condition -> (index) {
    // ERROR@+1: TARGET/059 {predicate_name="range", value_name="index", required_min="0", required_max="2", known_min="3", known_max="3"}
    %checked = index.assume %index [range(%index, 0, 2)] : index
    scf.yield %checked : index
  } else {
    scf.yield %c0 : index
  }
  func.return %result : index
}

// ====

// An unknown condition cannot hide a contradiction on a possibly taken path.
test.target<low_core> @target

func.def public target(@target) @entry(%condition: i1) -> (i32) {
  %c3 = scalar.constant 3 : i32
  %result = func.call @helper(%c3, %condition) : (i32, i1) -> (i32)
  func.return %result : i32
}

func.def target(@target) @helper(%index: i32, %condition: i1) -> (i32) {
  %result = scf.if %condition -> (i32) {
    // ERROR@+1: TARGET/059 {predicate_name="range", value_name="index", required_min="0", required_max="2", known_min="3", known_max="3"}
    %checked = scalar.assume %index [range(%index, 0, 2)] : i32
    scf.yield %checked : i32
  } else {
    scf.yield %index : i32
  }
  func.return %result : i32
}
