// RUN: pass target-legalize{mode=eager,policy=reference-only},dce

test.target<low_core> @test_target

func.def target(@test_target) @float_width_casts(%half: vector<1xf16>, %single: vector<1xf32>) -> (vector<1xf32>, vector<1xf16>) {
  %extended = vector.extf %half : vector<1xf16> to vector<1xf32>
  %truncated = vector.fptrunc %single : vector<1xf32> to vector<1xf16>
  func.return %extended, %truncated : vector<1xf32>, vector<1xf16>
}

func.def target(@test_target) @integer_width_casts(%byte: vector<1xi8>, %word: vector<1xi32>) -> (vector<1xi32>, vector<1xi32>, vector<1xi8>) {
  %signed = vector.extsi %byte : vector<1xi8> to vector<1xi32>
  %unsigned = vector.extui %byte : vector<1xi8> to vector<1xi32>
  %truncated = vector.trunci %word : vector<1xi32> to vector<1xi8>
  func.return %signed, %unsigned, %truncated : vector<1xi32>, vector<1xi32>, vector<1xi8>
}

func.def target(@test_target) @integer_float_casts(%integer: vector<1xi32>, %single: vector<1xf32>) -> (vector<1xf32>, vector<1xf32>, vector<1xi32>, vector<1xi32>) {
  %signed_float = vector.sitofp %integer : vector<1xi32> to vector<1xf32>
  %unsigned_float = vector.uitofp %integer : vector<1xi32> to vector<1xf32>
  %signed_integer = vector.fptosi %single : vector<1xf32> to vector<1xi32>
  %unsigned_integer = vector.fptoui %single : vector<1xf32> to vector<1xi32>
  func.return %signed_float, %unsigned_float, %signed_integer, %unsigned_integer : vector<1xf32>, vector<1xf32>, vector<1xi32>, vector<1xi32>
}

func.def target(@test_target) @representation_casts(%integer: vector<1xi32>) -> (vector<1xf32>, vector<1xindex>) {
  %single = vector.bitcast %integer : vector<1xi32> to vector<1xf32>
  %address = vector.index_cast %integer : vector<1xi32> to vector<1xindex>
  func.return %single, %address : vector<1xf32>, vector<1xindex>
}

// ----
test.target<low_core> @test_target

func.def target(@test_target) @float_width_casts(%half: vector<1xf16>, %single: vector<1xf32>) -> (vector<1xf32>, vector<1xf16>) {
  %33 = vector.extract %half[0] : vector<1xf16> -> f16
  %34 = scalar.extf %33 : f16 to f32
  %extended = vector.splat %34 : vector<1xf32>
  %29 = vector.extract %single[0] : vector<1xf32> -> f32
  %30 = scalar.fptrunc %29 : f32 to f16
  %truncated = vector.splat %30 : vector<1xf16>
  func.return %extended, %truncated : vector<1xf32>, vector<1xf16>
}

func.def target(@test_target) @integer_width_casts(%byte: vector<1xi8>, %word: vector<1xi32>) -> (vector<1xi32>, vector<1xi32>, vector<1xi8>) {
  %signed = vector.extsi %byte : vector<1xi8> to vector<1xi32>
  %unsigned = vector.extui %byte : vector<1xi8> to vector<1xi32>
  %truncated = vector.trunci %word : vector<1xi32> to vector<1xi8>
  func.return %signed, %unsigned, %truncated : vector<1xi32>, vector<1xi32>, vector<1xi8>
}

func.def target(@test_target) @integer_float_casts(%integer: vector<1xi32>, %single: vector<1xf32>) -> (vector<1xf32>, vector<1xf32>, vector<1xi32>, vector<1xi32>) {
  %49 = vector.extract %integer[0] : vector<1xi32> -> i32
  %50 = scalar.sitofp %49 : i32 to f32
  %signed_float = vector.splat %50 : vector<1xf32>
  %45 = vector.extract %integer[0] : vector<1xi32> -> i32
  %46 = scalar.uitofp %45 : i32 to f32
  %unsigned_float = vector.splat %46 : vector<1xf32>
  %41 = vector.extract %single[0] : vector<1xf32> -> f32
  %42 = scalar.fptosi %41 : f32 to i32
  %signed_integer = vector.splat %42 : vector<1xi32>
  %37 = vector.extract %single[0] : vector<1xf32> -> f32
  %38 = scalar.fptoui %37 : f32 to i32
  %unsigned_integer = vector.splat %38 : vector<1xi32>
  func.return %signed_float, %unsigned_float, %signed_integer, %unsigned_integer : vector<1xf32>, vector<1xf32>, vector<1xi32>, vector<1xi32>
}

func.def target(@test_target) @representation_casts(%integer: vector<1xi32>) -> (vector<1xf32>, vector<1xindex>) {
  %57 = vector.extract %integer[0] : vector<1xi32> -> i32
  %58 = scalar.bitcast %57 : i32 to f32
  %single = vector.splat %58 : vector<1xf32>
  %53 = vector.extract %integer[0] : vector<1xi32> -> i32
  %54 = index.cast %53 : i32 to index
  %address = vector.splat %54 : vector<1xindex>
  func.return %single, %address : vector<1xf32>, vector<1xindex>
}

// ====

// Conversion staging must keep vector operations legalizable instead of
// leaving an intermediate cast behind when its consumer is scalarized.
// RUN: pass target-legalize{mode=eager,policy=reference-only},dce

test.target<low_core> @test_target

func.def target(@test_target) @integer_to_narrow_float(%halfword: vector<1xi16>) -> (vector<1xbf16>) {
  %bfloat = vector.sitofp %halfword : vector<1xi16> to vector<1xbf16>
  func.return %bfloat : vector<1xbf16>
}

func.def target(@test_target) @narrow_float_to_integer(%half: vector<1xf16>) -> (vector<1xi32>) {
  %word = vector.fptosi %half : vector<1xf16> to vector<1xi32>
  func.return %word : vector<1xi32>
}

func.def target(@test_target) @integer_to_standard_float(%flag: vector<1xi1>, %halfword: vector<1xi16>) -> (vector<1xf32>, vector<1xf32>, vector<1xf64>, vector<1xf64>) {
  %signed_flag = vector.sitofp %flag : vector<1xi1> to vector<1xf32>
  %unsigned_flag = vector.uitofp %flag : vector<1xi1> to vector<1xf32>
  %signed_halfword = vector.sitofp %halfword : vector<1xi16> to vector<1xf64>
  %unsigned_halfword = vector.uitofp %halfword : vector<1xi16> to vector<1xf64>
  func.return %signed_flag, %unsigned_flag, %signed_halfword, %unsigned_halfword : vector<1xf32>, vector<1xf32>, vector<1xf64>, vector<1xf64>
}

// ----
test.target<low_core> @test_target

func.def target(@test_target) @integer_to_narrow_float(%halfword: vector<1xi16>) -> (vector<1xbf16>) {
  %18 = vector.extract %halfword[0] : vector<1xi16> -> i16
  %23 = scalar.extsi %18 : i16 to i32
  %24 = scalar.sitofp %23 : i32 to f32
  %20 = scalar.fptrunc %24 : f32 to bf16
  %bfloat = vector.splat %20 : vector<1xbf16>
  func.return %bfloat : vector<1xbf16>
}

func.def target(@test_target) @narrow_float_to_integer(%half: vector<1xf16>) -> (vector<1xi32>) {
  %27 = vector.extract %half[0] : vector<1xf16> -> f16
  %28 = scalar.extf %27 : f16 to f32
  %29 = scalar.fptosi %28 : f32 to i32
  %word = vector.splat %29 : vector<1xi32>
  func.return %word : vector<1xi32>
}

func.def target(@test_target) @integer_to_standard_float(%flag: vector<1xi1>, %halfword: vector<1xi16>) -> (vector<1xf32>, vector<1xf32>, vector<1xf64>, vector<1xf64>) {
  %55 = vector.extract %flag[0] : vector<1xi1> -> i1
  %56 = scalar.extsi %55 : i1 to i32
  %57 = scalar.sitofp %56 : i32 to f32
  %signed_flag = vector.splat %57 : vector<1xf32>
  %48 = vector.extract %flag[0] : vector<1xi1> -> i1
  %49 = scalar.extui %48 : i1 to i32
  %50 = scalar.uitofp %49 : i32 to f32
  %unsigned_flag = vector.splat %50 : vector<1xf32>
  %41 = vector.extract %halfword[0] : vector<1xi16> -> i16
  %42 = scalar.extsi %41 : i16 to i32
  %43 = scalar.sitofp %42 : i32 to f64
  %signed_halfword = vector.splat %43 : vector<1xf64>
  %34 = vector.extract %halfword[0] : vector<1xi16> -> i16
  %35 = scalar.extui %34 : i16 to i32
  %36 = scalar.uitofp %35 : i32 to f64
  %unsigned_halfword = vector.splat %36 : vector<1xf64>
  func.return %signed_flag, %unsigned_flag, %signed_halfword, %unsigned_halfword : vector<1xf32>, vector<1xf32>, vector<1xf64>, vector<1xf64>
}
