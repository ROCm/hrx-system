// RUN: pass target-legalize{mode=final},dce,canonicalize

test.target<low_core> @test_target

func.def target(@test_target) @legalizes_bitfield_extractu_i32(%source: i32) -> (i32) {
  %result = scalar.bitfield.extractu %source {offset = 8, width = 8} : i32 -> i32
  func.return %result : i32
}

func.def target(@test_target) @legalizes_bitfield_extracts_i32(%source: i32) -> (i32) {
  %result = scalar.bitfield.extracts %source {offset = 16, width = 8} : i32 -> i32
  func.return %result : i32
}

// ----
test.target<low_core> @test_target

func.def target(@test_target) @legalizes_bitfield_extractu_i32(%source: i32) -> (i32) {
  %6 = scalar.constant 8 : i32
  %7 = scalar.shrui %source, %6 : i32
  %8 = scalar.constant 255 : i32
  %result = scalar.andi %7, %8 : i32
  func.return %result : i32
}

func.def target(@test_target) @legalizes_bitfield_extracts_i32(%source: i32) -> (i32) {
  %10 = scalar.constant 8 : i32
  %11 = scalar.shli %source, %10 : i32
  %12 = scalar.constant 24 : i32
  %result = scalar.shrsi %11, %12 : i32
  func.return %result : i32
}
