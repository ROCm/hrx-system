// ====

// RUN: pass target-legalize{mode=eager,policy=reference-only},dce

test.target<low_core> @test_target

func.def target(@test_target) @scalar_integer_widths(%flag: i1, %wide: i64) -> (bf16, f16, f8E4M3, f8E5M2) {
  %signed_flag = scalar.sitofp %flag : i1 to bf16
  %unsigned_flag = scalar.uitofp %flag : i1 to f16
  %signed_wide = scalar.sitofp %wide : i64 to f8E4M3
  %unsigned_wide = scalar.uitofp %wide : i64 to f8E5M2
  func.return %signed_flag, %unsigned_flag, %signed_wide, %unsigned_wide : bf16, f16, f8E4M3, f8E5M2
}

// ----
test.target<low_core> @test_target

func.def target(@test_target) @scalar_integer_widths(%flag: i1, %wide: i64) -> (bf16, f16, f8E4M3, f8E5M2) {
  %16 = scalar.sitofp %flag : i1 to f32
  %signed_flag = scalar.fptrunc %16 : f32 to bf16
  %14 = scalar.uitofp %flag : i1 to f32
  %unsigned_flag = scalar.fptrunc %14 : f32 to f16
  %12 = scalar.sitofp %wide : i64 to f32
  %signed_wide = scalar.fptrunc %12 : f32 to f8E4M3
  %10 = scalar.uitofp %wide : i64 to f32
  %unsigned_wide = scalar.fptrunc %10 : f32 to f8E5M2
  func.return %signed_flag, %unsigned_flag, %signed_wide, %unsigned_wide : bf16, f16, f8E4M3, f8E5M2
}

// ====
// RUN: pass target-legalize{mode=complete,policy=reference-only},dce

test.target<low_core> @test_target

func.def target(@test_target) @narrow_integer_extensions(%byte: i8, %halfword: i16) -> (i16, i16, i32, i32, i64, i64, i32, i32, i64, i64) {
  %byte_signed_halfword = scalar.extsi %byte : i8 to i16
  %byte_unsigned_halfword = scalar.extui %byte : i8 to i16
  %byte_signed_word = scalar.extsi %byte : i8 to i32
  %byte_unsigned_word = scalar.extui %byte : i8 to i32
  %byte_signed_wide = scalar.extsi %byte : i8 to i64
  %byte_unsigned_wide = scalar.extui %byte : i8 to i64
  %halfword_signed_word = scalar.extsi %halfword : i16 to i32
  %halfword_unsigned_word = scalar.extui %halfword : i16 to i32
  %halfword_signed_wide = scalar.extsi %halfword : i16 to i64
  %halfword_unsigned_wide = scalar.extui %halfword : i16 to i64
  func.return %byte_signed_halfword, %byte_unsigned_halfword, %byte_signed_word, %byte_unsigned_word, %byte_signed_wide, %byte_unsigned_wide, %halfword_signed_word, %halfword_unsigned_word, %halfword_signed_wide, %halfword_unsigned_wide : i16, i16, i32, i32, i64, i64, i32, i32, i64, i64
}

// ----
test.target<low_core> @test_target

func.def target(@test_target) @narrow_integer_extensions(%byte: i8, %halfword: i16) -> (i16, i16, i32, i32, i64, i64, i32, i32, i64, i64) {
  %46 = scalar.extui %byte : i8 to i32
  %47 = scalar.constant 24 : i32
  %48 = scalar.shli %46, %47 : i32
  %49 = scalar.shrsi %48, %47 : i32
  %byte_signed_halfword = scalar.trunci %49 : i32 to i16
  %44 = scalar.extui %byte : i8 to i32
  %byte_unsigned_halfword = scalar.trunci %44 : i32 to i16
  %40 = scalar.extui %byte : i8 to i32
  %41 = scalar.constant 24 : i32
  %42 = scalar.shli %40, %41 : i32
  %byte_signed_word = scalar.shrsi %42, %41 : i32
  %byte_unsigned_word = scalar.extui %byte : i8 to i32
  %35 = scalar.extui %byte : i8 to i32
  %36 = scalar.constant 24 : i32
  %37 = scalar.shli %35, %36 : i32
  %38 = scalar.shrsi %37, %36 : i32
  %byte_signed_wide = scalar.extsi %38 : i32 to i64
  %33 = scalar.extui %byte : i8 to i32
  %byte_unsigned_wide = scalar.extui %33 : i32 to i64
  %29 = scalar.extui %halfword : i16 to i32
  %30 = scalar.constant 16 : i32
  %31 = scalar.shli %29, %30 : i32
  %halfword_signed_word = scalar.shrsi %31, %30 : i32
  %halfword_unsigned_word = scalar.extui %halfword : i16 to i32
  %24 = scalar.extui %halfword : i16 to i32
  %25 = scalar.constant 16 : i32
  %26 = scalar.shli %24, %25 : i32
  %27 = scalar.shrsi %26, %25 : i32
  %halfword_signed_wide = scalar.extsi %27 : i32 to i64
  %22 = scalar.extui %halfword : i16 to i32
  %halfword_unsigned_wide = scalar.extui %22 : i32 to i64
  func.return %byte_signed_halfword, %byte_unsigned_halfword, %byte_signed_word, %byte_unsigned_word, %byte_signed_wide, %byte_unsigned_wide, %halfword_signed_word, %halfword_unsigned_word, %halfword_signed_wide, %halfword_unsigned_wide : i16, i16, i32, i32, i64, i64, i32, i32, i64, i64
}
