// RUN: pass target-legalize{mode=eager,policy=reference-only},dce

test.target<low_core> @test_target

func.def target(@test_target) @e4m3_to_integer(%value: f8E4M3) -> (i8) {
  %result = scalar.fptosi %value : f8E4M3 to i8
  func.return %result : i8
}

// ----
test.target<low_core> @test_target

func.def target(@test_target) @e4m3_to_integer(%value: f8E4M3) -> (i8) {
  %5 = scalar.bitcast %value : f8E4M3 to i8
  %6 = scalar.extui %5 : i8 to i32
  %7 = scalar.constant 128 : i32
  %8 = scalar.andi %6, %7 : i32
  %9 = scalar.constant 24 : i32
  %10 = scalar.shli %8, %9 : i32
  %11 = scalar.constant 120 : i32
  %12 = scalar.andi %6, %11 : i32
  %13 = scalar.constant 3 : i32
  %14 = scalar.shrui %12, %13 : i32
  %15 = scalar.constant 7 : i32
  %16 = scalar.andi %6, %15 : i32
  %17 = scalar.constant 120 : i32
  %18 = scalar.addi %14, %17 : i32
  %19 = scalar.constant 23 : i32
  %20 = scalar.shli %18, %19 : i32
  %21 = scalar.constant 20 : i32
  %22 = scalar.shli %16, %21 : i32
  %23 = scalar.ori %10, %20 : i32
  %24 = scalar.ori %23, %22 : i32
  %25 = scalar.constant 0 : i32
  %26 = scalar.constant 2 : i32
  %27 = scalar.andi %16, %26 : i32
  %28 = scalar.constant 0 : i32
  %29 = scalar.cmpi ne, %27, %28 : i32
  %30 = scalar.constant 1 : i32
  %31 = scf.select %29, %30, %25 : i32
  %32 = scalar.constant 4 : i32
  %33 = scalar.andi %16, %32 : i32
  %34 = scalar.constant 0 : i32
  %35 = scalar.cmpi ne, %33, %34 : i32
  %36 = scalar.constant 2 : i32
  %37 = scf.select %35, %36, %31 : i32
  %38 = scalar.constant 118 : i32
  %39 = scalar.addi %37, %38 : i32
  %40 = scalar.constant 23 : i32
  %41 = scalar.shli %39, %40 : i32
  %42 = scalar.constant 23 : i32
  %43 = scalar.subi %42, %37 : i32
  %44 = scalar.shli %16, %43 : i32
  %45 = scalar.constant 8388607 : i32
  %46 = scalar.andi %44, %45 : i32
  %47 = scalar.ori %10, %41 : i32
  %48 = scalar.ori %47, %46 : i32
  %49 = scalar.constant 0 : i32
  %50 = scalar.cmpi eq, %16, %49 : i32
  %51 = scf.select %50, %10, %48 : i32
  %52 = scalar.constant 0 : i32
  %53 = scalar.cmpi eq, %14, %52 : i32
  %54 = scf.select %53, %51, %24 : i32
  %55 = scalar.constant 15 : i32
  %56 = scalar.cmpi eq, %14, %55 : i32
  %57 = scalar.constant 2143289344 : i32
  %58 = scalar.constant 7 : i32
  %59 = scalar.cmpi eq, %16, %58 : i32
  %60 = scalar.constant 0 : i1
  %61 = scf.select %56, %59, %60 : i1
  %62 = scf.select %61, %57, %54 : i32
  %63 = scalar.bitcast %62 : i32 to f32
  %result = scalar.fptosi %63 : f32 to i8
  func.return %result : i8
}

