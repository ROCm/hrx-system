// Cleanup is idempotent, including dead arguments and nonwriting aliases.
// RUN: with-low-asm pass low-borrow-lifetime,low-borrow-lifetime
type.decl import("provider", "object") @Object

low.func.def target<test.low.core> @select(%unused: reg<test.ref : ptr<@Object>>, %value: reg<test.ref : ptr<@Object>>, %condition: reg<test.i32 : i1>) -> (reg<test.ref : ptr<@Object>>) asm {
  %alias = low.assume %value [] : reg<test.ref : ptr<@Object>>
  %selected = test.select.ref %condition, %alias, %alias : reg<test.ref : ptr<@Object>>
  return %selected
}

// ----
type.decl import("provider", "object") @Object

low.func.def target<test.low.core> @select(%unused: reg<test.ref : ptr<@Object>>, %value: reg<test.ref : ptr<@Object>>, %condition: reg<test.i32 : i1>) -> (reg<test.ref : ptr<@Object>>) asm {
  low.release %unused : reg<test.ref : ptr<@Object>>
  %alias = low.assume %value [] : reg<test.ref : ptr<@Object>>
  %selected = test.select.ref %condition, %alias, %alias : reg<test.ref : ptr<@Object>>
  low.release %value : reg<test.ref : ptr<@Object>>
  return %selected
}

// ====
// A dead copied result retires independently. The source's final-use copy
// transfers its carrier, so it does not need an extra release.
// RUN: with-low-asm pass low-borrow-lifetime,low-borrow-lifetime
type.decl import("provider", "object") @Object

low.func.def target<test.low.core> @copy(%value: reg<test.ref : ptr<@Object>>) asm {
  %copied = copy %value {detached = true} : reg<test.ref : ptr<@Object>> -> reg<test.ref : ptr<@Object>>
  return
}

// ----
type.decl import("provider", "object") @Object

low.func.def target<test.low.core> @copy(%value: reg<test.ref : ptr<@Object>>) asm {
  %copied = copy %value {detached = true} : reg<test.ref : ptr<@Object>> -> reg<test.ref : ptr<@Object>>
  low.release %copied : reg<test.ref : ptr<@Object>>
  return
}

// ====
// A pointer that only one successor needs must retire on the other edge.
// RUN: with-low-asm pass low-borrow-lifetime,low-borrow-lifetime
type.decl import("provider", "object") @Object

low.func.decl import(native, "observe", module = "provider") target<test.low.core> @observe()

low.func.def target<test.low.core> @choose(%value: reg<test.ref : ptr<@Object>>, %condition: reg<test.i32 : i1>) asm {
  low.cond_br %condition, ^read, ^skip : reg<test.i32 : i1>
^read:
  low.release %value : reg<test.ref : ptr<@Object>>
  return
^skip:
  low.func.call @observe() : ()
  return
}

// ----
type.decl import("provider", "object") @Object

low.func.decl import(native, "observe", module = "provider") target<test.low.core> @observe()

low.func.def target<test.low.core> @choose(%value: reg<test.ref : ptr<@Object>>, %condition: reg<test.i32 : i1>) asm {
  low.cond_br %condition, ^read, ^_bb3 : reg<test.i32 : i1>
^read:
  low.release %value : reg<test.ref : ptr<@Object>>
  return
^_bb3:
  low.release %value : reg<test.ref : ptr<@Object>>
  low.br ^skip
^skip:
  low.func.call @observe() : ()
  return
}
