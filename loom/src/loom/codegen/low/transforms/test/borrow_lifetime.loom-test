// Cleanup is idempotent, including dead arguments and nonwriting aliases.
// RUN: with-low-asm pass low-borrow-lifetime,low-borrow-lifetime
type.decl import("provider", "object") @Object

low.func.def target<vm.core> @select(%unused: reg<vm.ref : ptr<@Object>>, %value: reg<vm.ref : ptr<@Object>>, %condition: reg<vm.value : i1>) -> (reg<vm.ref : ptr<@Object>>) asm {
  %alias = low.assume %value [] : reg<vm.ref : ptr<@Object>>
  %selected = ref.select %condition, %alias, %alias : reg<vm.ref : ptr<@Object>>
  return %selected
}

// ----
type.decl import("provider", "object") @Object

low.func.def target<vm.core> @select(%unused: reg<vm.ref : ptr<@Object>>, %value: reg<vm.ref : ptr<@Object>>, %condition: reg<vm.value : i1>) -> (reg<vm.ref : ptr<@Object>>) asm {
  low.release %unused : reg<vm.ref : ptr<@Object>>
  %alias = low.assume %value [] : reg<vm.ref : ptr<@Object>>
  %selected = ref.select %condition, %alias, %alias : reg<vm.ref : ptr<@Object>>
  low.release %value : reg<vm.ref : ptr<@Object>>
  return %selected
}

// ====
// A dead copied result retires independently. The source's final-use copy
// transfers its carrier, so it does not need an extra release.
// RUN: with-low-asm pass low-borrow-lifetime,low-borrow-lifetime
type.decl import("provider", "object") @Object

low.func.def target<vm.core> @copy(%value: reg<vm.ref : ptr<@Object>>) asm {
  %copied = copy %value {detached = true} : reg<vm.ref : ptr<@Object>> -> reg<vm.ref : ptr<@Object>>
  return
}

// ----
type.decl import("provider", "object") @Object

low.func.def target<vm.core> @copy(%value: reg<vm.ref : ptr<@Object>>) asm {
  %copied = copy %value {detached = true} : reg<vm.ref : ptr<@Object>> -> reg<vm.ref : ptr<@Object>>
  low.release %copied : reg<vm.ref : ptr<@Object>>
  return
}

// ====
// A pointer that only one successor needs must retire on the other edge.
// RUN: with-low-asm pass low-borrow-lifetime,low-borrow-lifetime
type.decl import("provider", "object") @Object

low.func.decl import(native, "observe", module = "provider") target<vm.core> @observe()

low.func.def target<vm.core> @choose(%value: reg<vm.ref : ptr<@Object>>, %condition: reg<vm.value : i1>) asm {
  low.cond_br %condition, ^read, ^skip : reg<vm.value : i1>
^read:
  low.release %value : reg<vm.ref : ptr<@Object>>
  return
^skip:
  low.func.call @observe() : ()
  return
}

// ----
type.decl import("provider", "object") @Object

low.func.decl import(native, "observe", module = "provider") target<vm.core> @observe()

low.func.def target<vm.core> @choose(%value: reg<vm.ref : ptr<@Object>>, %condition: reg<vm.value : i1>) asm {
  low.cond_br %condition, ^read, ^_bb3 : reg<vm.value : i1>
^read:
  low.release %value : reg<vm.ref : ptr<@Object>>
  return
^_bb3:
  low.release %value : reg<vm.ref : ptr<@Object>>
  low.br ^skip
^skip:
  low.func.call @observe() : ()
  return
}
