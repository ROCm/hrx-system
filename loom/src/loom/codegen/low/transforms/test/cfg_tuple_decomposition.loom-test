// RUN: pass low-decompose-cfg-tuples,low-dce

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @decomposes_lane_sliced_block_arg(%cond: reg<test.i32>, %init: reg<test.i32 x4>, %a0: reg<test.i32>, %a1: reg<test.i32>, %a2: reg<test.i32>, %a3: reg<test.i32>) -> (reg<test.i32>) {
  low.cond_br %cond, ^init_edge, ^concat_edge : reg<test.i32>
^init_edge:
  low.br<test.br> ^join(%init: reg<test.i32 x4>)
^concat_edge:
  %next = low.concat(%a0, %a1, %a2, %a3) : (reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>) -> reg<test.i32 x4>
  low.br ^join(%next: reg<test.i32 x4>)
^join(%state: reg<test.i32 x4>):
  %s0 = low.slice %state[0] : reg<test.i32 x4> -> reg<test.i32>
  %s1 = low.slice %state[1] : reg<test.i32 x4> -> reg<test.i32>
  %sum = low.op<test.add.i32>(%s0, %s1) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32>
  low.return %sum : reg<test.i32>
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @decomposes_lane_sliced_block_arg(%cond: reg<test.i32>, %init: reg<test.i32 x4>, %a0: reg<test.i32>, %a1: reg<test.i32>, %a2: reg<test.i32>, %a3: reg<test.i32>) -> (reg<test.i32>) {
  low.cond_br %cond, ^init_edge, ^concat_edge : reg<test.i32>
^init_edge:
  %16 = low.slice %init[0] : reg<test.i32 x4> -> reg<test.i32>
  %17 = low.slice %init[1] : reg<test.i32 x4> -> reg<test.i32>
  %18 = low.slice %init[2] : reg<test.i32 x4> -> reg<test.i32>
  %19 = low.slice %init[3] : reg<test.i32 x4> -> reg<test.i32>
  low.br<test.br> ^join(%16: reg<test.i32>, %17: reg<test.i32>, %18: reg<test.i32>, %19: reg<test.i32>)
^concat_edge:
  low.br ^join(%a0: reg<test.i32>, %a1: reg<test.i32>, %a2: reg<test.i32>, %a3: reg<test.i32>)
^join(%12: reg<test.i32>, %13: reg<test.i32>, %14: reg<test.i32>, %15: reg<test.i32>):
  %sum = low.op<test.add.i32>(%12, %13) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32>
  low.return %sum : reg<test.i32>
}

// ====

// Whole-tuple uses remain unchanged because the pass cannot prove that replacing
// the block argument with lanes preserves every consumer.
// RUN: pass low-decompose-cfg-tuples,low-dce

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @preserves_whole_tuple_uses(%init: reg<test.i32 x2>) -> (reg<test.i32 x2>) {
  low.br ^join(%init: reg<test.i32 x2>)
^join(%state: reg<test.i32 x2>):
  %s0 = low.slice %state[0] : reg<test.i32 x2> -> reg<test.i32>
  %s1 = low.slice %state[1] : reg<test.i32 x2> -> reg<test.i32>
  %copy = low.copy %state : reg<test.i32 x2> -> reg<test.i32 x2>
  low.return %copy : reg<test.i32 x2>
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @preserves_whole_tuple_uses(%init: reg<test.i32 x2>) -> (reg<test.i32 x2>) {
  low.br ^join(%init: reg<test.i32 x2>)
^join(%state: reg<test.i32 x2>):
  %copy = low.copy %state : reg<test.i32 x2> -> reg<test.i32 x2>
  low.return %copy : reg<test.i32 x2>
}

// ====

// Loop-carried tuple values can be decomposed when the loop body only consumes
// scalar lane projections and each backedge reconstructs the next tuple.
// RUN: pass low-decompose-cfg-tuples,low-dce

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @decomposes_loop_carried_lane_tuple(%cond: reg<test.i32>, %init: reg<test.i32 x4>, %step: reg<test.i32>) -> (reg<test.i32>) {
  low.br ^loop(%init: reg<test.i32 x4>)
^loop(%state: reg<test.i32 x4>):
  %s0 = low.slice %state[0] : reg<test.i32 x4> -> reg<test.i32>
  %s1 = low.slice %state[1] : reg<test.i32 x4> -> reg<test.i32>
  %s2 = low.slice %state[2] : reg<test.i32 x4> -> reg<test.i32>
  %s3 = low.slice %state[3] : reg<test.i32 x4> -> reg<test.i32>
  %n0 = low.op<test.add.i32>(%s0, %step) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32>
  %n1 = low.op<test.add.i32>(%s1, %step) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32>
  %n2 = low.op<test.add.i32>(%s2, %step) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32>
  %n3 = low.op<test.add.i32>(%s3, %step) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32>
  %next = low.concat(%n0, %n1, %n2, %n3) : (reg<test.i32>, reg<test.i32>,
      reg<test.i32>, reg<test.i32>) -> reg<test.i32 x4>
  low.cond_br %cond, ^backedge, ^exit_edge : reg<test.i32>
^backedge:
  low.br ^loop(%next: reg<test.i32 x4>)
^exit_edge:
  low.br ^exit(%s0: reg<test.i32>)
^exit(%result: reg<test.i32>):
  low.return %result : reg<test.i32>
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @decomposes_loop_carried_lane_tuple(%cond: reg<test.i32>, %init: reg<test.i32 x4>, %step: reg<test.i32>) -> (reg<test.i32>) {
  %19 = low.slice %init[0] : reg<test.i32 x4> -> reg<test.i32>
  %20 = low.slice %init[1] : reg<test.i32 x4> -> reg<test.i32>
  %21 = low.slice %init[2] : reg<test.i32 x4> -> reg<test.i32>
  %22 = low.slice %init[3] : reg<test.i32 x4> -> reg<test.i32>
  low.br ^loop(%19: reg<test.i32>, %20: reg<test.i32>, %21: reg<test.i32>, %22: reg<test.i32>)
^loop(%15: reg<test.i32>, %16: reg<test.i32>, %17: reg<test.i32>, %18: reg<test.i32>):
  %n0 = low.op<test.add.i32>(%15, %step) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32>
  %n1 = low.op<test.add.i32>(%16, %step) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32>
  %n2 = low.op<test.add.i32>(%17, %step) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32>
  %n3 = low.op<test.add.i32>(%18, %step) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32>
  low.cond_br %cond, ^backedge, ^exit_edge : reg<test.i32>
^backedge:
  low.br ^loop(%n0: reg<test.i32>, %n1: reg<test.i32>, %n2: reg<test.i32>, %n3: reg<test.i32>)
^exit_edge:
  low.br ^exit(%15: reg<test.i32>)
^exit(%result: reg<test.i32>):
  low.return %result : reg<test.i32>
}
