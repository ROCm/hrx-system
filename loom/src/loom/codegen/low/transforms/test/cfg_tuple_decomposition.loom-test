// RUN: pass low-decompose-cfg-tuples,low-dce

// Decomposed lanes are defined at the outer join, not at every inner iteration.
// Each destructive slice inside the loop must retain its own capture.
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @retains_repeated_lane_capture(%again: reg<test.i32>, %initial: reg<test.i32 x2>) -> (reg<test.i32>) asm {
  low.br ^join(%initial: reg<test.i32 x2>)
^join(%state: reg<test.i32 x2>):
  low.br ^loop
^loop:
  %saved = slice %state[0] : reg<test.i32 x2> -> reg<test.i32>
  %changed = test.tied.any %saved
  low.cond_br %again, ^loop, ^exit : reg<test.i32>
^exit:
  return %changed
}

// ----
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @retains_repeated_lane_capture(%again: reg<test.i32>, %initial: reg<test.i32 x2>) -> (reg<test.i32>) asm {
  %8 = slice %initial[0] : reg<test.i32 x2> -> reg<test.i32>
  %9 = slice %initial[1] : reg<test.i32 x2> -> reg<test.i32>
  low.br ^join(%8: reg<test.i32>, %9: reg<test.i32>)
^join(%6: reg<test.i32>, %7: reg<test.i32>):
  low.br ^loop
^loop:
  %saved = slice %6[0] : reg<test.i32> -> reg<test.i32>
  %changed = test.tied.any %saved
  low.cond_br %again, ^loop, ^exit : reg<test.i32>
^exit:
  return %changed
}

// ====

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @decomposes_lane_sliced_block_arg(%cond: reg<test.i32>, %init: reg<test.i32 x4>, %a0: reg<test.i32>, %a1: reg<test.i32>, %a2: reg<test.i32>, %a3: reg<test.i32>) -> (reg<test.i32>) asm {
  low.cond_br %cond, ^init_edge, ^concat_edge : reg<test.i32>
^init_edge:
  low.br ^join(%init: reg<test.i32 x4>)
^concat_edge:
  %next = concat(%a0, %a1, %a2, %a3) : (reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>) -> reg<test.i32 x4>
  low.br ^join(%next: reg<test.i32 x4>)
^join(%state: reg<test.i32 x4>):
  %s0 = slice %state[0] : reg<test.i32 x4> -> reg<test.i32>
  %s1 = slice %state[1] : reg<test.i32 x4> -> reg<test.i32>
  %sum = test.add.i32 %s0, %s1
  return %sum
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @decomposes_lane_sliced_block_arg(%cond: reg<test.i32>, %init: reg<test.i32 x4>, %a0: reg<test.i32>, %a1: reg<test.i32>, %a2: reg<test.i32>, %a3: reg<test.i32>) -> (reg<test.i32>) asm {
  low.cond_br %cond, ^init_edge, ^concat_edge : reg<test.i32>
^init_edge:
  %16 = slice %init[0] : reg<test.i32 x4> -> reg<test.i32>
  %17 = slice %init[1] : reg<test.i32 x4> -> reg<test.i32>
  %18 = slice %init[2] : reg<test.i32 x4> -> reg<test.i32>
  %19 = slice %init[3] : reg<test.i32 x4> -> reg<test.i32>
  low.br ^join(%16: reg<test.i32>, %17: reg<test.i32>, %18: reg<test.i32>, %19: reg<test.i32>)
^concat_edge:
  low.br ^join(%a0: reg<test.i32>, %a1: reg<test.i32>, %a2: reg<test.i32>, %a3: reg<test.i32>)
^join(%12: reg<test.i32>, %13: reg<test.i32>, %14: reg<test.i32>, %15: reg<test.i32>):
  %sum = test.add.i32 %12, %13
  return %sum
}

// ====

// Whole-tuple uses remain unchanged because the pass cannot prove that replacing
// the block argument with lanes preserves every consumer.
// RUN: pass low-decompose-cfg-tuples,low-dce

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @preserves_whole_tuple_uses(%init: reg<test.i32 x2>) -> (reg<test.i32 x2>) asm {
  low.br ^join(%init: reg<test.i32 x2>)
^join(%state: reg<test.i32 x2>):
  %s0 = slice %state[0] : reg<test.i32 x2> -> reg<test.i32>
  %s1 = slice %state[1] : reg<test.i32 x2> -> reg<test.i32>
  %copy = copy %state : reg<test.i32 x2> -> reg<test.i32 x2>
  return %copy
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @preserves_whole_tuple_uses(%init: reg<test.i32 x2>) -> (reg<test.i32 x2>) asm {
  low.br ^join(%init: reg<test.i32 x2>)
^join(%state: reg<test.i32 x2>):
  %copy = copy %state : reg<test.i32 x2> -> reg<test.i32 x2>
  return %copy
}

// ====

// Loop-carried tuple values can be decomposed when the loop body only consumes
// scalar lane projections and each backedge reconstructs the next tuple.
// RUN: pass low-decompose-cfg-tuples,low-dce

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @decomposes_loop_carried_lane_tuple(%cond: reg<test.i32>, %init: reg<test.i32 x4>, %step: reg<test.i32>) -> (reg<test.i32>) asm {
  low.br ^loop(%init: reg<test.i32 x4>)
^loop(%state: reg<test.i32 x4>):
  %s0 = slice %state[0] : reg<test.i32 x4> -> reg<test.i32>
  %s1 = slice %state[1] : reg<test.i32 x4> -> reg<test.i32>
  %s2 = slice %state[2] : reg<test.i32 x4> -> reg<test.i32>
  %s3 = slice %state[3] : reg<test.i32 x4> -> reg<test.i32>
  %n0 = test.add.i32 %s0, %step
  %n1 = test.add.i32 %s1, %step
  %n2 = test.add.i32 %s2, %step
  %n3 = test.add.i32 %s3, %step
  %next = concat(%n0, %n1, %n2, %n3) : (reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>) -> reg<test.i32 x4>
  low.cond_br %cond, ^backedge, ^exit_edge : reg<test.i32>
^backedge:
  low.br ^loop(%next: reg<test.i32 x4>)
^exit_edge:
  low.br ^exit(%s0: reg<test.i32>)
^exit(%result: reg<test.i32>):
  return %result
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @decomposes_loop_carried_lane_tuple(%cond: reg<test.i32>, %init: reg<test.i32 x4>, %step: reg<test.i32>) -> (reg<test.i32>) asm {
  %19 = slice %init[0] : reg<test.i32 x4> -> reg<test.i32>
  %20 = slice %init[1] : reg<test.i32 x4> -> reg<test.i32>
  %21 = slice %init[2] : reg<test.i32 x4> -> reg<test.i32>
  %22 = slice %init[3] : reg<test.i32 x4> -> reg<test.i32>
  low.br ^loop(%19: reg<test.i32>, %20: reg<test.i32>, %21: reg<test.i32>, %22: reg<test.i32>)
^loop(%15: reg<test.i32>, %16: reg<test.i32>, %17: reg<test.i32>, %18: reg<test.i32>):
  %n0 = test.add.i32 %15, %step
  %n1 = test.add.i32 %16, %step
  %n2 = test.add.i32 %17, %step
  %n3 = test.add.i32 %18, %step
  low.cond_br %cond, ^backedge, ^exit_edge : reg<test.i32>
^backedge:
  low.br ^loop(%n0: reg<test.i32>, %n1: reg<test.i32>, %n2: reg<test.i32>, %n3: reg<test.i32>)
^exit_edge:
  low.br ^exit(%15: reg<test.i32>)
^exit(%result: reg<test.i32>):
  return %result
}

// ====

// A backedge concat may directly consume slices that elimination rewrites.
// Retained source recipes follow the concat operands after that rewrite instead
// of preserving the erased slice result identities.
// RUN: pass low-decompose-cfg-tuples,low-dce

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @decomposes_permuted_tuple_cycle(%cond: reg<test.i32>, %init: reg<test.i32 x2>) -> (reg<test.i32>) asm {
  low.br ^loop(%init: reg<test.i32 x2>)
^loop(%state: reg<test.i32 x2>):
  %low = slice %state[0] : reg<test.i32 x2> -> reg<test.i32>
  %high = slice %state[1] : reg<test.i32 x2> -> reg<test.i32>
  %next = concat(%high, %low) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32 x2>
  low.cond_br %cond, ^backedge, ^exit_edge : reg<test.i32>
^backedge:
  low.br ^loop(%next: reg<test.i32 x2>)
^exit_edge:
  low.br ^exit(%low: reg<test.i32>)
^exit(%result: reg<test.i32>):
  return %result
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @decomposes_permuted_tuple_cycle(%cond: reg<test.i32>, %init: reg<test.i32 x2>) -> (reg<test.i32>) asm {
  %10 = slice %init[0] : reg<test.i32 x2> -> reg<test.i32>
  %11 = slice %init[1] : reg<test.i32 x2> -> reg<test.i32>
  low.br ^loop(%10: reg<test.i32>, %11: reg<test.i32>)
^loop(%8: reg<test.i32>, %9: reg<test.i32>):
  low.cond_br %cond, ^backedge, ^exit_edge : reg<test.i32>
^backedge:
  low.br ^loop(%9: reg<test.i32>, %8: reg<test.i32>)
^exit_edge:
  low.br ^exit(%8: reg<test.i32>)
^exit(%result: reg<test.i32>):
  return %result
}

// ====

// Several independent tuple slots on the same CFG edges are planned together.
// A neighboring tuple with a whole-value use remains intact. Concat sources
// forward unit lanes directly and slice only multi-unit source fragments.
// RUN: pass low-decompose-cfg-tuples,low-dce

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @decomposes_multiple_tuple_slots(%cond: reg<test.i32>, %first_init: reg<test.i32 x2>, %second_init: reg<test.i32 x3>, %preserved_init: reg<test.i32 x2>, %a0: reg<test.i32>, %a1: reg<test.i32>, %b01: reg<test.i32 x2>, %b2: reg<test.i32>) -> (reg<test.i32>, reg<test.i32 x2>) asm {
  low.cond_br %cond, ^direct, ^composed : reg<test.i32>
^direct:
  low.br ^join(%first_init: reg<test.i32 x2>, %second_init: reg<test.i32 x3>, %preserved_init: reg<test.i32 x2>)
^composed:
  %first_next = concat(%a0, %a1) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32 x2>
  %second_next = concat(%b01, %b2) : (reg<test.i32 x2>, reg<test.i32>) -> reg<test.i32 x3>
  low.br ^join(%first_next: reg<test.i32 x2>, %second_next: reg<test.i32 x3>, %preserved_init: reg<test.i32 x2>)
^join(%first: reg<test.i32 x2>, %second: reg<test.i32 x3>, %preserved: reg<test.i32 x2>):
  %first_high = slice %first[1] : reg<test.i32 x2> -> reg<test.i32>
  %first_low = slice %first[0] : reg<test.i32 x2> -> reg<test.i32>
  %first_high_again = slice %first[1] : reg<test.i32 x2> -> reg<test.i32>
  %second_high = slice %second[2] : reg<test.i32 x3> -> reg<test.i32>
  %second_low = slice %second[0] : reg<test.i32 x3> -> reg<test.i32>
  %preserved_low = slice %preserved[0] : reg<test.i32 x2> -> reg<test.i32>
  %preserved_copy = copy %preserved : reg<test.i32 x2> -> reg<test.i32 x2>
  %sum0 = test.add.i32 %first_high, %first_low
  %sum1 = test.add.i32 %sum0, %first_high_again
  %sum2 = test.add.i32 %sum1, %second_high
  %sum3 = test.add.i32 %sum2, %second_low
  %sum4 = test.add.i32 %sum3, %preserved_low
  return %sum4, %preserved_copy
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @decomposes_multiple_tuple_slots(%cond: reg<test.i32>, %first_init: reg<test.i32 x2>, %second_init: reg<test.i32 x3>, %preserved_init: reg<test.i32 x2>, %a0: reg<test.i32>, %a1: reg<test.i32>, %b01: reg<test.i32 x2>, %b2: reg<test.i32>) -> (reg<test.i32>, reg<test.i32 x2>) asm {
  low.cond_br %cond, ^direct, ^composed : reg<test.i32>
^direct:
  %32 = slice %first_init[0] : reg<test.i32 x2> -> reg<test.i32>
  %33 = slice %first_init[1] : reg<test.i32 x2> -> reg<test.i32>
  %34 = slice %second_init[0] : reg<test.i32 x3> -> reg<test.i32>
  %35 = slice %second_init[1] : reg<test.i32 x3> -> reg<test.i32>
  %36 = slice %second_init[2] : reg<test.i32 x3> -> reg<test.i32>
  low.br ^join(%32: reg<test.i32>, %33: reg<test.i32>, %34: reg<test.i32>, %35: reg<test.i32>, %36: reg<test.i32>, %preserved_init: reg<test.i32 x2>)
^composed:
  %37 = slice %b01[0] : reg<test.i32 x2> -> reg<test.i32>
  %38 = slice %b01[1] : reg<test.i32 x2> -> reg<test.i32>
  low.br ^join(%a0: reg<test.i32>, %a1: reg<test.i32>, %37: reg<test.i32>, %38: reg<test.i32>, %b2: reg<test.i32>, %preserved_init: reg<test.i32 x2>)
^join(%27: reg<test.i32>, %28: reg<test.i32>, %29: reg<test.i32>, %30: reg<test.i32>, %31: reg<test.i32>, %preserved: reg<test.i32 x2>):
  %preserved_low = slice %preserved[0] : reg<test.i32 x2> -> reg<test.i32>
  %preserved_copy = copy %preserved : reg<test.i32 x2> -> reg<test.i32 x2>
  %sum0 = test.add.i32 %28, %27
  %sum1 = test.add.i32 %sum0, %28
  %sum2 = test.add.i32 %sum1, %31
  %sum3 = test.add.i32 %sum2, %29
  %sum4 = test.add.i32 %sum3, %preserved_low
  return %sum4, %preserved_copy
}

// ====

// Two tuple recurrences share the same entry and cyclic backedges. All
// component identities must exist before the backedge is rebuilt once.
// RUN: pass low-decompose-cfg-tuples,low-dce

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @decomposes_parallel_tuple_cycles(%cond: reg<test.i32>, %first_init: reg<test.i32 x2>, %second_init: reg<test.i32 x3>, %step: reg<test.i32>) -> (reg<test.i32>) asm {
  low.br ^loop(%first_init: reg<test.i32 x2>, %second_init: reg<test.i32 x3>)
^loop(%first: reg<test.i32 x2>, %second: reg<test.i32 x3>):
  %first0 = slice %first[0] : reg<test.i32 x2> -> reg<test.i32>
  %first1 = slice %first[1] : reg<test.i32 x2> -> reg<test.i32>
  %second0 = slice %second[0] : reg<test.i32 x3> -> reg<test.i32>
  %second1 = slice %second[1] : reg<test.i32 x3> -> reg<test.i32>
  %second2 = slice %second[2] : reg<test.i32 x3> -> reg<test.i32>
  %next_first0 = test.add.i32 %first0, %step
  %next_first1 = test.add.i32 %first1, %step
  %next_second0 = test.add.i32 %second0, %step
  %next_second1 = test.add.i32 %second1, %step
  %next_second2 = test.add.i32 %second2, %step
  %next_first = concat(%next_first0, %next_first1) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32 x2>
  %next_second = concat(%next_second0, %next_second1, %next_second2) : (reg<test.i32>, reg<test.i32>, reg<test.i32>) -> reg<test.i32 x3>
  low.cond_br %cond, ^backedge, ^exit_edge : reg<test.i32>
^backedge:
  low.br ^loop(%next_first: reg<test.i32 x2>, %next_second: reg<test.i32 x3>)
^exit_edge:
  low.br ^exit(%first0: reg<test.i32>, %second2: reg<test.i32>)
^exit(%left: reg<test.i32>, %right: reg<test.i32>):
  %result = test.add.i32 %left, %right
  return %result
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @decomposes_parallel_tuple_cycles(%cond: reg<test.i32>, %first_init: reg<test.i32 x2>, %second_init: reg<test.i32 x3>, %step: reg<test.i32>) -> (reg<test.i32>) asm {
  %27 = slice %first_init[0] : reg<test.i32 x2> -> reg<test.i32>
  %28 = slice %first_init[1] : reg<test.i32 x2> -> reg<test.i32>
  %29 = slice %second_init[0] : reg<test.i32 x3> -> reg<test.i32>
  %30 = slice %second_init[1] : reg<test.i32 x3> -> reg<test.i32>
  %31 = slice %second_init[2] : reg<test.i32 x3> -> reg<test.i32>
  low.br ^loop(%27: reg<test.i32>, %28: reg<test.i32>, %29: reg<test.i32>, %30: reg<test.i32>, %31: reg<test.i32>)
^loop(%22: reg<test.i32>, %23: reg<test.i32>, %24: reg<test.i32>, %25: reg<test.i32>, %26: reg<test.i32>):
  %next_first0 = test.add.i32 %22, %step
  %next_first1 = test.add.i32 %23, %step
  %next_second0 = test.add.i32 %24, %step
  %next_second1 = test.add.i32 %25, %step
  %next_second2 = test.add.i32 %26, %step
  low.cond_br %cond, ^backedge, ^exit_edge : reg<test.i32>
^backedge:
  low.br ^loop(%next_first0: reg<test.i32>, %next_first1: reg<test.i32>, %next_second0: reg<test.i32>, %next_second1: reg<test.i32>, %next_second2: reg<test.i32>)
^exit_edge:
  low.br ^exit(%22: reg<test.i32>, %26: reg<test.i32>)
^exit(%left: reg<test.i32>, %right: reg<test.i32>):
  %result = test.add.i32 %left, %right
  return %result
}

// ====

// Two tuple recurrences may source their next lanes from one another. Retained
// concat recipes must observe both sets of rewritten slice operands before the
// shared cyclic backedge is rebuilt.
// RUN: pass low-decompose-cfg-tuples,low-dce

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @decomposes_cross_coupled_tuple_cycles(%cond: reg<test.i32>, %left_init: reg<test.i32 x2>, %right_init: reg<test.i32 x2>) -> (reg<test.i32>) asm {
  low.br ^loop(%left_init: reg<test.i32 x2>, %right_init: reg<test.i32 x2>)
^loop(%left: reg<test.i32 x2>, %right: reg<test.i32 x2>):
  %left0 = slice %left[0] : reg<test.i32 x2> -> reg<test.i32>
  %left1 = slice %left[1] : reg<test.i32 x2> -> reg<test.i32>
  %right0 = slice %right[0] : reg<test.i32 x2> -> reg<test.i32>
  %right1 = slice %right[1] : reg<test.i32 x2> -> reg<test.i32>
  %next_left = concat(%right1, %left0) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32 x2>
  %next_right = concat(%left1, %right0) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32 x2>
  low.cond_br %cond, ^backedge, ^exit_edge : reg<test.i32>
^backedge:
  low.br ^loop(%next_left: reg<test.i32 x2>, %next_right: reg<test.i32 x2>)
^exit_edge:
  low.br ^exit(%left0: reg<test.i32>, %right1: reg<test.i32>)
^exit(%left_result: reg<test.i32>, %right_result: reg<test.i32>):
  %result = test.add.i32 %left_result, %right_result
  return %result
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @decomposes_cross_coupled_tuple_cycles(%cond: reg<test.i32>, %left_init: reg<test.i32 x2>, %right_init: reg<test.i32 x2>) -> (reg<test.i32>) asm {
  %19 = slice %left_init[0] : reg<test.i32 x2> -> reg<test.i32>
  %20 = slice %left_init[1] : reg<test.i32 x2> -> reg<test.i32>
  %21 = slice %right_init[0] : reg<test.i32 x2> -> reg<test.i32>
  %22 = slice %right_init[1] : reg<test.i32 x2> -> reg<test.i32>
  low.br ^loop(%19: reg<test.i32>, %20: reg<test.i32>, %21: reg<test.i32>, %22: reg<test.i32>)
^loop(%15: reg<test.i32>, %16: reg<test.i32>, %17: reg<test.i32>, %18: reg<test.i32>):
  low.cond_br %cond, ^backedge, ^exit_edge : reg<test.i32>
^backedge:
  low.br ^loop(%18: reg<test.i32>, %15: reg<test.i32>, %16: reg<test.i32>, %17: reg<test.i32>)
^exit_edge:
  low.br ^exit(%15: reg<test.i32>, %18: reg<test.i32>)
^exit(%left_result: reg<test.i32>, %right_result: reg<test.i32>):
  %result = test.add.i32 %left_result, %right_result
  return %result
}

// ====
// RUN: with-checks pass-report low-decompose-cfg-tuples

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @reports_shared_edge_rebuild(%first_init: reg<test.i32 x2>, %second_init: reg<test.i32 x3>) -> (reg<test.i32>) asm {
  low.br ^join(%first_init: reg<test.i32 x2>, %second_init: reg<test.i32 x3>)
^join(%first: reg<test.i32 x2>, %second: reg<test.i32 x3>):
  %first_lane = slice %first[1] : reg<test.i32 x2> -> reg<test.i32>
  %second_lane = slice %second[2] : reg<test.i32 x3> -> reg<test.i32>
  %result = test.add.i32 %first_lane, %second_lane
  return %result
}

low.func.def target<test.low.core>(@test_target) @scalar_control(%input: reg<test.i32>) -> (reg<test.i32>) asm {
  low.br ^join(%input: reg<test.i32>)
^join(%value: reg<test.i32>):
  return %value
}

// ----
CHECK: *"changed":true,*
CHECK: *"block-args-decomposed":2,"group-block-args-inserted":5,"branch-edges-decomposed":1,"slices-removed":2}*
CHECK: *"category":"value-facts","acquisition_count":1,*"recomputation_count":1,*

// ====

// RUN: pass low-decompose-cfg-tuples,canonicalize,low-cse,low-dce
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @independent_lane_captures(%initial: reg<test.i32 x2>) -> (reg<test.i32>, reg<test.i32>) asm {
  low.br ^join(%initial: reg<test.i32 x2>)
^join(%state: reg<test.i32 x2>):
  %first = slice %state[0] : reg<test.i32 x2> -> reg<test.i32>
  %second = slice %state[0] : reg<test.i32 x2> -> reg<test.i32>
  %first_changed = test.tied.any %first
  %second_changed = test.tied.any %second
  return %first_changed, %second_changed
}

// ----
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @independent_lane_captures(%initial: reg<test.i32 x2>) -> (reg<test.i32>, reg<test.i32>) asm {
  %10 = slice %initial[0] : reg<test.i32 x2> -> reg<test.i32>
  %11 = slice %initial[1] : reg<test.i32 x2> -> reg<test.i32>
  low.br ^join(%10: reg<test.i32>, %11: reg<test.i32>)
^join(%8: reg<test.i32>, %9: reg<test.i32>):
  %first = slice %8[0] : reg<test.i32> -> reg<test.i32>
  %second = slice %8[0] : reg<test.i32> -> reg<test.i32>
  %first_changed = test.tied.any %first
  %second_changed = test.tied.any %second
  return %first_changed, %second_changed
}

// ====

// RUN: pass low-decompose-cfg-tuples,canonicalize,low-cse,low-dce
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @aliased_lane_capture_and_observer(%initial: reg<test.i32 x2>) -> (reg<test.i32>, reg<test.i32>) asm {
  low.br ^join(%initial: reg<test.i32 x2>)
^join(%state: reg<test.i32 x2>):
  %first = slice %state[0] : reg<test.i32 x2> -> reg<test.i32>
  %second = slice %state[0] : reg<test.i32 x2> -> reg<test.i32>
  %alias = low.assume %first [range(%first, 0, 1024)] : reg<test.i32>
  %changed = test.tied.any %alias
  return %changed, %second
}

// ----
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @aliased_lane_capture_and_observer(%initial: reg<test.i32 x2>) -> (reg<test.i32>, reg<test.i32>) asm {
  %10 = slice %initial[0] : reg<test.i32 x2> -> reg<test.i32>
  %11 = slice %initial[1] : reg<test.i32 x2> -> reg<test.i32>
  low.br ^join(%10: reg<test.i32>, %11: reg<test.i32>)
^join(%8: reg<test.i32>, %9: reg<test.i32>):
  %first = slice %8[0] : reg<test.i32> -> reg<test.i32>
  %alias = low.assume %first [range(%first, 0, 1024)] : reg<test.i32>
  %changed = test.tied.any %alias
  return %changed, %8
}

// ====

// A mixed-width join projects overlapping ranges without retaining a whole
// tuple owner. Concat inputs are captured where the source tuple was created.
// RUN: pass low-decompose-cfg-tuples,low-dce

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @mixed_width_join(%condition: reg<test.i32>, %initial: reg<test.i32 x5>, %first: reg<test.i32 x2>, %second: reg<test.i32 x3>) -> (reg<test.i32 x2>, reg<test.i32 x3>, reg<test.i32>) asm {
  low.cond_br %condition, ^direct, ^composed : reg<test.i32>
^direct:
  low.br ^join(%initial: reg<test.i32 x5>)
^composed:
  %next = concat(%first, %second) : (reg<test.i32 x2>, reg<test.i32 x3>) -> reg<test.i32 x5>
  low.br ^join(%next: reg<test.i32 x5>)
^join(%state: reg<test.i32 x5>):
  %low = slice %state[0] : reg<test.i32 x5> -> reg<test.i32 x2>
  %middle = slice %state[1] : reg<test.i32 x5> -> reg<test.i32 x3>
  %last = slice %state[4] : reg<test.i32 x5> -> reg<test.i32>
  return %low, %middle, %last
}

// ----
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @mixed_width_join(%condition: reg<test.i32>, %initial: reg<test.i32 x5>, %first: reg<test.i32 x2>, %second: reg<test.i32 x3>) -> (reg<test.i32 x2>, reg<test.i32 x3>, reg<test.i32>) asm {
  low.cond_br %condition, ^direct, ^composed : reg<test.i32>
^direct:
  %19 = slice %initial[0] : reg<test.i32 x5> -> reg<test.i32>
  %20 = slice %initial[1] : reg<test.i32 x5> -> reg<test.i32>
  %21 = slice %initial[2] : reg<test.i32 x5> -> reg<test.i32>
  %22 = slice %initial[3] : reg<test.i32 x5> -> reg<test.i32>
  %23 = slice %initial[4] : reg<test.i32 x5> -> reg<test.i32>
  low.br ^join(%19: reg<test.i32>, %20: reg<test.i32>, %21: reg<test.i32>, %22: reg<test.i32>, %23: reg<test.i32>)
^composed:
  %24 = slice %first[0] : reg<test.i32 x2> -> reg<test.i32>
  %25 = slice %first[1] : reg<test.i32 x2> -> reg<test.i32>
  %26 = slice %second[0] : reg<test.i32 x3> -> reg<test.i32>
  %27 = slice %second[1] : reg<test.i32 x3> -> reg<test.i32>
  %28 = slice %second[2] : reg<test.i32 x3> -> reg<test.i32>
  low.br ^join(%24: reg<test.i32>, %25: reg<test.i32>, %26: reg<test.i32>, %27: reg<test.i32>, %28: reg<test.i32>)
^join(%12: reg<test.i32>, %13: reg<test.i32>, %14: reg<test.i32>, %15: reg<test.i32>, %16: reg<test.i32>):
  %17 = concat(%12, %13) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32 x2>
  %18 = concat(%13, %14, %15) : (reg<test.i32>, reg<test.i32>, reg<test.i32>) -> reg<test.i32 x3>
  return %17, %18, %16
}

// ====

// The projected unit is a register of the original class, not an assumed
// 32-bit scalar. Wide backedge fragments may permute and overlap.
// RUN: pass low-decompose-cfg-tuples,canonicalize,low-cse,low-dce

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @wide_register_cycle(%condition: reg<test.i32>, %initial: reg<test.i64 x4>) -> (reg<test.i64 x3>) asm {
  low.br ^loop(%initial: reg<test.i64 x4>)
^loop(%state: reg<test.i64 x4>):
  %low = slice %state[0] : reg<test.i64 x4> -> reg<test.i64 x2>
  %high = slice %state[2] : reg<test.i64 x4> -> reg<test.i64 x2>
  %observed = slice %state[1] : reg<test.i64 x4> -> reg<test.i64 x3>
  %next = concat(%high, %low) : (reg<test.i64 x2>, reg<test.i64 x2>) -> reg<test.i64 x4>
  low.cond_br %condition, ^backedge, ^exit : reg<test.i32>
^backedge:
  low.br ^loop(%next: reg<test.i64 x4>)
^exit:
  return %observed
}

// ----
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @wide_register_cycle(%condition: reg<test.i32>, %initial: reg<test.i64 x4>) -> (reg<test.i64 x3>) asm {
  %15 = slice %initial[0] : reg<test.i64 x4> -> reg<test.i64>
  %16 = slice %initial[1] : reg<test.i64 x4> -> reg<test.i64>
  %17 = slice %initial[2] : reg<test.i64 x4> -> reg<test.i64>
  %18 = slice %initial[3] : reg<test.i64 x4> -> reg<test.i64>
  low.br ^loop(%15: reg<test.i64>, %16: reg<test.i64>, %17: reg<test.i64>, %18: reg<test.i64>)
^loop(%8: reg<test.i64>, %9: reg<test.i64>, %10: reg<test.i64>, %11: reg<test.i64>):
  %14 = concat(%9, %10, %11) : (reg<test.i64>, reg<test.i64>, reg<test.i64>) -> reg<test.i64 x3>
  low.cond_br %condition, ^backedge, ^exit : reg<test.i32>
^backedge:
  low.br ^loop(%10: reg<test.i64>, %11: reg<test.i64>, %8: reg<test.i64>, %9: reg<test.i64>)
^exit:
  return %14
}

// ====

// A full-width observation still requires the original tuple ownership.
// RUN: pass low-decompose-cfg-tuples,low-dce

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @whole_range_slice(%initial: reg<test.i32 x4>) -> (reg<test.i32 x4>, reg<test.i32 x2>) asm {
  low.br ^join(%initial: reg<test.i32 x4>)
^join(%state: reg<test.i32 x4>):
  %whole = slice %state[0] : reg<test.i32 x4> -> reg<test.i32 x4>
  %part = slice %state[1] : reg<test.i32 x4> -> reg<test.i32 x2>
  return %whole, %part
}

// ----
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @whole_range_slice(%initial: reg<test.i32 x4>) -> (reg<test.i32 x4>, reg<test.i32 x2>) asm {
  low.br ^join(%initial: reg<test.i32 x4>)
^join(%state: reg<test.i32 x4>):
  %whole = slice %state[0] : reg<test.i32 x4> -> reg<test.i32 x4>
  %part = slice %state[1] : reg<test.i32 x4> -> reg<test.i32 x2>
  return %whole, %part
}

// ====

// Each matrix observation captures its own accumulator even when ranges
// overlap, and even when an inner loop repeatedly observes an outer owner.
// RUN: pass low-decompose-cfg-tuples,canonicalize,low-cse,low-dce

amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @repeated_matrix_captures(%condition: reg<amdgpu.sgpr>, %initial: reg<amdgpu.vgpr x8>, %lhs: reg<amdgpu.vgpr x2>, %rhs: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr>) asm {
  low.br ^join(%initial: reg<amdgpu.vgpr x8>)
^join(%state: reg<amdgpu.vgpr x8>):
  low.br ^loop
^loop:
  %first = slice %state[0] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr x4>
  %second = slice %state[2] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr x4>
  %observed = slice %state[3] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %changed_first = v_mfma_f32_16x16x16_bf16 %lhs, %rhs, %first
  %changed_second = v_mfma_f32_16x16x16_bf16 %lhs, %rhs, %second
  low.cond_br %condition, ^loop, ^exit : reg<amdgpu.sgpr>
^exit:
  return %changed_first, %changed_second, %observed
}

// ----
amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @repeated_matrix_captures(%condition: reg<amdgpu.sgpr>, %initial: reg<amdgpu.vgpr x8>, %lhs: reg<amdgpu.vgpr x2>, %rhs: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr>) asm {
  %23 = slice %initial[0] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %24 = slice %initial[1] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %25 = slice %initial[2] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %26 = slice %initial[3] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %27 = slice %initial[4] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %28 = slice %initial[5] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %29 = slice %initial[6] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %30 = slice %initial[7] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  low.br ^join(%23: reg<amdgpu.vgpr>, %24: reg<amdgpu.vgpr>, %25: reg<amdgpu.vgpr>, %26: reg<amdgpu.vgpr>, %27: reg<amdgpu.vgpr>, %28: reg<amdgpu.vgpr>, %29: reg<amdgpu.vgpr>, %30: reg<amdgpu.vgpr>)
^join(%13: reg<amdgpu.vgpr>, %14: reg<amdgpu.vgpr>, %15: reg<amdgpu.vgpr>, %16: reg<amdgpu.vgpr>, %17: reg<amdgpu.vgpr>, %18: reg<amdgpu.vgpr>, %19: reg<amdgpu.vgpr>, %20: reg<amdgpu.vgpr>):
  low.br ^loop
^loop:
  %21 = concat(%13, %14, %15, %16) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %22 = concat(%15, %16, %17, %18) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %changed_first = v_mfma_f32_16x16x16_bf16 %lhs, %rhs, %21
  %changed_second = v_mfma_f32_16x16x16_bf16 %lhs, %rhs, %22
  low.cond_br %condition, ^loop, ^exit : reg<amdgpu.sgpr>
^exit:
  return %changed_first, %changed_second, %16
}

// ====

// A matrix loop carries independent accumulator fragments; only their partial
// observations need contiguous register ownership within the loop body.
// RUN: pass low-decompose-cfg-tuples,canonicalize,low-cse,low-dce

amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @matrix_fragment_cycle(%condition: reg<amdgpu.sgpr>, %initial: reg<amdgpu.vgpr x8>, %lhs: reg<amdgpu.vgpr x2>, %rhs: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr>) asm {
  low.br ^loop(%initial: reg<amdgpu.vgpr x8>)
^loop(%state: reg<amdgpu.vgpr x8>):
  %low = slice %state[0] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr x4>
  %high = slice %state[4] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr x4>
  %changed_low = v_mfma_f32_16x16x16_bf16 %lhs, %rhs, %low
  %changed_high = v_mfma_f32_16x16x16_bf16 %lhs, %rhs, %high
  %next = concat(%changed_low, %changed_high) : (reg<amdgpu.vgpr x4>, reg<amdgpu.vgpr x4>) -> reg<amdgpu.vgpr x8>
  %observed = slice %state[7] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  low.cond_br %condition, ^backedge, ^exit : reg<amdgpu.sgpr>
^backedge:
  low.br ^loop(%next: reg<amdgpu.vgpr x8>)
^exit:
  return %observed
}

// ----
amdgpu.target<gfx942> @target

low.func.def target<amdgpu.cdna3.core>(@target) @matrix_fragment_cycle(%condition: reg<amdgpu.sgpr>, %initial: reg<amdgpu.vgpr x8>, %lhs: reg<amdgpu.vgpr x2>, %rhs: reg<amdgpu.vgpr x2>) -> (reg<amdgpu.vgpr>) asm {
  %22 = slice %initial[0] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %23 = slice %initial[1] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %24 = slice %initial[2] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %25 = slice %initial[3] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %26 = slice %initial[4] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %27 = slice %initial[5] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %28 = slice %initial[6] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  %29 = slice %initial[7] : reg<amdgpu.vgpr x8> -> reg<amdgpu.vgpr>
  low.br ^loop(%22: reg<amdgpu.vgpr>, %23: reg<amdgpu.vgpr>, %24: reg<amdgpu.vgpr>, %25: reg<amdgpu.vgpr>, %26: reg<amdgpu.vgpr>, %27: reg<amdgpu.vgpr>, %28: reg<amdgpu.vgpr>, %29: reg<amdgpu.vgpr>)
^loop(%12: reg<amdgpu.vgpr>, %13: reg<amdgpu.vgpr>, %14: reg<amdgpu.vgpr>, %15: reg<amdgpu.vgpr>, %16: reg<amdgpu.vgpr>, %17: reg<amdgpu.vgpr>, %18: reg<amdgpu.vgpr>, %19: reg<amdgpu.vgpr>):
  %20 = concat(%12, %13, %14, %15) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %21 = concat(%16, %17, %18, %19) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  %changed_low = v_mfma_f32_16x16x16_bf16 %lhs, %rhs, %20
  %changed_high = v_mfma_f32_16x16x16_bf16 %lhs, %rhs, %21
  %30 = slice %changed_low[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %31 = slice %changed_low[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %32 = slice %changed_low[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %33 = slice %changed_low[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %34 = slice %changed_high[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %35 = slice %changed_high[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %36 = slice %changed_high[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  %37 = slice %changed_high[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  low.cond_br %condition, ^backedge, ^exit : reg<amdgpu.sgpr>
^backedge:
  low.br ^loop(%30: reg<amdgpu.vgpr>, %31: reg<amdgpu.vgpr>, %32: reg<amdgpu.vgpr>, %33: reg<amdgpu.vgpr>, %34: reg<amdgpu.vgpr>, %35: reg<amdgpu.vgpr>, %36: reg<amdgpu.vgpr>, %37: reg<amdgpu.vgpr>)
^exit:
  return %19
}
