// RUN: pass source-to-low

test.target<low_core> @test_target

func.def target(@test_target) @copied_scalar_operand(%a: index, %b: index, %c: index) -> (index) {
  %result = index.madd %a, %b, %c : index
  func.return %result : index
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) abi(object_function) @copied_scalar_operand(%a: reg<test.i32>, %b: reg<test.i32>, %c: reg<test.i32>) -> (reg<test.i32>) asm {
  %9 = test.mul.i32 %a, %b
  %10 = copy %c : reg<test.i32> -> reg<test.phys>
  %result = test.add.i32.phys_rhs %9, %10
  return %result
}

// ====
// RUN: pass source-to-low

// The selected extract recipe projects in the source class, constrains its
// temporary to another class, then returns to the result representation.
test.target<low_core> @test_target

func.def target(@test_target) @sliced_temporary_carrier(%pair: vector<2xi32>) -> (i32) {
  %element = vector.extract %pair[1] : vector<2xi32> -> i32
  func.return %element : i32
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) abi(object_function) @sliced_temporary_carrier(%pair: reg<test.i32 x2>) -> (reg<test.i32>) asm {
  %5 = slice %pair[1] : reg<test.i32 x2> -> reg<test.i32>
  %6 = copy %5 : reg<test.i32> -> reg<test.f32>
  %element = copy %6 : reg<test.f32> -> reg<test.i32>
  return %element
}

// ====
// RUN: pass source-to-low

test.target<low_core> @test_target

func.def target(@test_target) @copied_per_lane_aggregate(%lhs: vector<4xi32>, %rhs: vector<4xi32>) -> (vector<4xi32>) {
  %result = vector.addi %lhs, %rhs : vector<4xi32>
  func.return %result : vector<4xi32>
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) abi(object_function) @copied_per_lane_aggregate(%lhs: reg<test.i32 x4>, %rhs: reg<test.i32 x4>) -> (reg<test.i32 x4>) asm {
  %7 = copy %rhs : reg<test.i32 x4> -> reg<test.phys x4>
  %8 = slice %lhs[0] : reg<test.i32 x4> -> reg<test.i32>
  %9 = slice %7[0] : reg<test.phys x4> -> reg<test.phys>
  %10 = test.add.i32.phys_rhs %8, %9
  %11 = slice %lhs[1] : reg<test.i32 x4> -> reg<test.i32>
  %12 = slice %7[1] : reg<test.phys x4> -> reg<test.phys>
  %13 = test.add.i32.phys_rhs %11, %12
  %14 = slice %lhs[2] : reg<test.i32 x4> -> reg<test.i32>
  %15 = slice %7[2] : reg<test.phys x4> -> reg<test.phys>
  %16 = test.add.i32.phys_rhs %14, %15
  %17 = slice %lhs[3] : reg<test.i32 x4> -> reg<test.i32>
  %18 = slice %7[3] : reg<test.phys x4> -> reg<test.phys>
  %19 = test.add.i32.phys_rhs %17, %18
  %result = concat(%10, %13, %16, %19) : (reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>) -> reg<test.i32 x4>
  return %result
}

// ====
// RUN: pass source-to-low

test.target<low_core> @test_target

func.def target(@test_target) @concatenated_temporary_carriers(%a: i32, %b: i32) -> (vector<2xi32>) {
  %result = vector.from_elements %a, %b : vector<2xi32>
  func.return %result : vector<2xi32>
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) abi(object_function) @concatenated_temporary_carriers(%a: reg<test.i32>, %b: reg<test.i32>) -> (reg<test.i32 x2>) asm {
  %7 = concat(%a, %b) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32 x2>
  %result = move %7 : reg<test.i32 x2> -> reg<test.i32 x2>
  return %result
}

// ====
// RUN: pass source-to-low

test.target<low_core> @test_target

func.def target(@test_target) @duplicated_scalar(%value: i32) -> (i32, i32) {
  %copy = scalar.duplicate %value : i32
  func.return %value, %copy : i32, i32
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) abi(object_function) @duplicated_scalar(%value: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %copy = copy %value : reg<test.i32> -> reg<test.i32>
  return %value, %copy
}

