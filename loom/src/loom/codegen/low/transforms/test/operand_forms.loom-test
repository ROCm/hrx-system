test.target<low_core> @target

low.func.def target<test.low.core>(@target) @select_alias_before_parent_write(%condition: reg<test.i32>, %value: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %alias = low.assume %value [range(%value, 0, 1024)] : reg<test.i32>
  %selected = test.select.i32 %condition, %alias, %alias
  %changed = test.tied.any %value
  return %selected, %changed
}

