// ====

// A native register move can initialize a constant in another register bank.
// Rebuilding the complete input-free recipe replaces a loop reload without
// carrying either register lifetime across the backedge.
// RUN: with-low-asm pass low-materialize-allocation

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @loop_register_constant(%again: reg<test.i32>, %block0: reg<test.explicit32>, %block1: reg<test.explicit32>, %block2: reg<test.explicit32>, %block3: reg<test.explicit32>) -> (reg<test.i32>) asm {
  %literal = test.const.i32 7
  %transport = test.rematerialize.spillable.explicit32 %literal
  %value0 = copy %block0 : reg<test.explicit32> -> reg<test.i32>
  %value1 = copy %block1 : reg<test.explicit32> -> reg<test.i32>
  %value2 = copy %block2 : reg<test.explicit32> -> reg<test.i32>
  %value3 = copy %block3 : reg<test.explicit32> -> reg<test.i32>
  %pair0 = test.add.i32 %value0, %value1
  %pair1 = test.add.i32 %value2, %value3
  %seed = test.add.i32 %pair0, %pair1
  low.br ^loop
^loop:
  %mapped = copy %transport : reg<test.spillable.explicit32> -> reg<test.i32>
  %sum = test.add.i32 %seed, %mapped
  low.cond_br %again, ^loop, ^exit : reg<test.i32>
^exit:
  return %sum
}

// ----
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @loop_register_constant(%again: reg<test.i32>, %block0: reg<test.explicit32>, %block1: reg<test.explicit32>, %block2: reg<test.explicit32>, %block3: reg<test.explicit32>) -> (reg<test.i32>) asm {
  %literal = test.const.i32 7
  %value0 = copy %block0 : reg<test.explicit32> -> reg<test.i32>
  %value1 = copy %block1 : reg<test.explicit32> -> reg<test.i32>
  %value2 = copy %block2 : reg<test.explicit32> -> reg<test.i32>
  %value3 = copy %block3 : reg<test.explicit32> -> reg<test.i32>
  %pair0 = test.add.i32 %value0, %value1
  %pair1 = test.add.i32 %value2, %value3
  %seed = test.add.i32 %pair0, %pair1
  low.br ^loop
^loop:
  %transport_remat = test.rematerialize.spillable.explicit32 %literal
  %mapped = copy %transport_remat : reg<test.spillable.explicit32> -> reg<test.i32>
  %sum = test.add.i32 %seed, %mapped
  low.cond_br %again, ^loop, ^exit : reg<test.i32>
^exit:
  return %sum
}
