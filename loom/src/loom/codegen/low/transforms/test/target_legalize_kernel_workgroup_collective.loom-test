test.target<low_core> @target {subgroup_size = 2}

kernel.def target(@target) @hierarchical_reverse_exclusive_scan() {
  %c1 = index.constant 1 : index
  %c3 = index.constant 3 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c3, %c1, %c1) : index
} launch(%value: i64) {
  %prefix = kernel.workgroup.scan<addi> %value {direction = reverse, mode = exclusive} : i64
  test.use %prefix : i64
  kernel.return
}

