// RUN: pass target-legalize{mode=eager,policy=reference-only}

test.target<low_core> @target {subgroup_size = 2}

kernel.def target(@target) @hierarchical_variadic_reduce() {
  %c1 = index.constant 1 : index
  %c3 = index.constant 3 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c3, %c1, %c1) : index
} launch(%wide: i64, %pair: vector<2xi32>, %flag: i1) {
  %wide_sum, %pair_sum, %flag_sum = kernel.workgroup.reduce<addi> %wide, %pair, %flag : i64, vector<2xi32>, i1
  test.use %wide_sum : i64
  test.use %pair_sum : vector<2xi32>
  test.use %flag_sum : i1
  kernel.return
}

