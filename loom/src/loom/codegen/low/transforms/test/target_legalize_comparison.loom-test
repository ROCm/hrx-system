test.target<low_core> @test_target

func.def target(@test_target) @wide_vector_comparison(%lhs: vector<2xi64>, %rhs: vector<2xi64>) -> (vector<2xi1>) {
  %mask = vector.cmpi ugt, %lhs, %rhs : vector<2xi64> -> vector<2xi1>
  func.return %mask : vector<2xi1>
}

// ----
test.target<low_core> @test_target

func.def target(@test_target) @wide_vector_comparison(%lhs: vector<2xi64>, %rhs: vector<2xi64>) -> (vector<2xi1>) {
  %4 = vector.extract %lhs[0] : vector<2xi64> -> i64
  %5 = vector.extract %rhs[0] : vector<2xi64> -> i64
  %6 = scalar.cmpi ugt, %4, %5 : i64
  %7 = vector.extract %lhs[1] : vector<2xi64> -> i64
  %8 = vector.extract %rhs[1] : vector<2xi64> -> i64
  %9 = scalar.cmpi ugt, %7, %8 : i64
  %11 = vector.splat %6 : vector<2xi1>
  %mask = vector.insert %9 into %11[1] : i1, vector<2xi1>
  func.return %mask : vector<2xi1>
}

