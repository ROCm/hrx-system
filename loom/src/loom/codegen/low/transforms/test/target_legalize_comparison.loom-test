// RUN: pass target-legalize{mode=eager,policy=reference-only},dce

test.target<low_core> @test_target

func.def target(@test_target) @floating_vector_comparison_flags(%lhs: vector<2xf32>, %rhs: vector<2xf32>) -> (vector<2xi1>) {
  %mask = vector.cmpf<nnan|ninf> olt, %lhs, %rhs : vector<2xf32> -> vector<2xi1>
  func.return %mask : vector<2xi1>
}

// ----
test.target<low_core> @test_target

func.def target(@test_target) @floating_vector_comparison_flags(%lhs: vector<2xf32>, %rhs: vector<2xf32>) -> (vector<2xi1>) {
  %4 = vector.extract %lhs[0] : vector<2xf32> -> f32
  %5 = vector.extract %rhs[0] : vector<2xf32> -> f32
  %6 = scalar.cmpf<nnan|ninf> olt, %4, %5 : f32
  %7 = vector.extract %lhs[1] : vector<2xf32> -> f32
  %8 = vector.extract %rhs[1] : vector<2xf32> -> f32
  %9 = scalar.cmpf<nnan|ninf> olt, %7, %8 : f32
  %11 = vector.splat %6 : vector<2xi1>
  %mask = vector.insert %9 into %11[1] : i1, vector<2xi1>
  func.return %mask : vector<2xi1>
}

// ====
// RUN: with-checks pass combine,target-legalize{mode=final,policy=reference-only},canonicalize,canonicalize

// Cleanup preserves the comparison/selection representation after legalization.
test.target<low_core> @test_target

func.def target(@test_target) @integer_extrema_i16(%lhs: i16, %rhs: i16) -> (i16, i16, i16, i16) {
  %slt = scalar.cmpi slt, %lhs, %rhs : i16
  %ugt = scalar.cmpi ugt, %lhs, %rhs : i16
  %smin = scf.select %slt, %lhs, %rhs : i16
  %smax = scf.select %slt, %rhs, %lhs : i16
  %umin = scf.select %ugt, %rhs, %lhs : i16
  %umax = scf.select %ugt, %lhs, %rhs : i16
  func.return %smin, %smax, %umin, %umax : i16, i16, i16, i16
}

// ----
CHECK: %smin = scf.select * : i16
CHECK: %smax = scf.select * : i16
CHECK: %umin = scf.select * : i16
CHECK: %umax = scf.select * : i16
CHECK: * = scalar.cmpi slt, * : i32
CHECK: * = scalar.cmpi sgt, * : i32
CHECK: * = scalar.cmpi ult, * : i32
CHECK: * = scalar.cmpi ugt, * : i32
CHECK-NOT: * = scalar.minsi *
CHECK-NOT: * = scalar.maxsi *
CHECK-NOT: * = scalar.minui *
CHECK-NOT: * = scalar.maxui *

