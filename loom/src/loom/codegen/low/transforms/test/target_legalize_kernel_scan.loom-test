// RUN: pass target-legalize{mode=eager,policy=reference-only}

test.target<low_core> @target {subgroup_size = 7}

kernel.def target(@target) @sparse_clustered_reverse_exclusive() {
  %c1 = index.constant 1 : index
  %c7 = index.constant 7 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c7, %c1, %c1) : index
} launch(%value: vector<2xf32>) {
  %lane = kernel.subgroup.lane.id : index
  %c4 = index.constant 4 : index
  %participates = index.cmp ult, %lane, %c4 : index
  %result = scf.if %participates -> (vector<2xf32>) {
    %prefix = kernel.subgroup.scan<addf> %value {cluster_size = 3, cluster_stride = 2, direction = reverse, mode = exclusive} : vector<2xf32>
    scf.yield %prefix : vector<2xf32>
  } else {
    scf.yield %value : vector<2xf32>
  }
  test.use %result : vector<2xf32>
  kernel.return
}

