// RUN: pass source-to-low{control-flow=structured-low}

test.target<low_core> @test_target

func.def target(@test_target) @structured_if_without_results(%cond: i1) {
  scf.if %cond {
  }
  func.return
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) abi(object_function) @structured_if_without_results(%cond: reg<test.i32>) asm {
  low.scf.if %cond {
  }
  return
}

// ====
// RUN: pass source-to-low{control-flow=structured-low}

test.target<low_core> @test_target

func.def target(@test_target) @structured_if_with_results(%cond: i1, %lhs: i32, %rhs: i32, %fallback: i32) -> (i32) {
  %result = scf.if %cond -> (i32) {
    %then = scalar.addi %lhs, %rhs : i32
    scf.yield %then : i32
  } else {
    %else = scalar.addi %fallback, %rhs : i32
    scf.yield %else : i32
  }
  func.return %result : i32
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) abi(object_function) @structured_if_with_results(%cond: reg<test.i32>, %lhs: reg<test.i32>, %rhs: reg<test.i32>, %fallback: reg<test.i32>) -> (reg<test.i32>) asm {
  %result = low.scf.if %cond -> (reg<test.i32>) {
    %then = test.add.i32 %lhs, %rhs
    low.scf.yield %then : reg<test.i32>
  } else {
    %else = test.add.i32 %fallback, %rhs
    low.scf.yield %else : reg<test.i32>
  }
  return %result
}

// ====
// RUN: pass source-to-low{control-flow=structured-low}

test.target<low_core> @test_target

func.def target(@test_target) @structured_for_with_iter_arg(%lo: index, %hi: index, %step: index, %factor: index, %init: i32, %bias: i32) -> (i32) {
  %result = scf.for %iv = [%lo to %hi step %step](%acc = %init : i32) -> (i32) unroll(%factor) {
    %next = scalar.addi %acc, %bias : i32
    scf.yield %next : i32
  }
  func.return %result : i32
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) abi(object_function) @structured_for_with_iter_arg(%lo: reg<test.i32>, %hi: reg<test.i32>, %step: reg<test.i32>, %factor: reg<test.i32>, %init: reg<test.i32>, %bias: reg<test.i32>) -> (reg<test.i32>) asm {
  %result = low.scf.for signed [%lo to %hi step %step] iter_args(%init: reg<test.i32>) -> (reg<test.i32>) unroll(%factor) do(%iv: reg<test.i32>, %acc: reg<test.i32>) {
    %next = test.add.i32 %acc, %bias
    low.scf.yield %next : reg<test.i32>
  }
  return %result
}

// ====
// RUN: pass source-to-low{control-flow=structured-low}

test.target<low_core> @test_target

func.def target(@test_target) @structured_while_with_iter_arg(%cond: i1, %init: i32, %bias: i32) -> (i32) {
  %result = scf.while(%before = %init : i32) -> (i32) {
    %forwarded = scalar.addi %before, %bias : i32
    scf.condition %cond, %forwarded : i1, i32
  } do(%body: i32) {
    %next = scalar.addi %body, %bias : i32
    scf.yield %next : i32
  }
  func.return %result : i32
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) abi(object_function) @structured_while_with_iter_arg(%cond: reg<test.i32>, %init: reg<test.i32>, %bias: reg<test.i32>) -> (reg<test.i32>) asm {
  %result = low.scf.while(%before = %init : reg<test.i32>) -> (reg<test.i32>) {
    %forwarded = test.add.i32 %before, %bias
    low.scf.condition %cond, %forwarded : reg<test.i32>, reg<test.i32>
  } do(%body: reg<test.i32>) {
    %next = test.add.i32 %body, %bias
    low.scf.yield %next : reg<test.i32>
  }
  return %result
}

// ====
// RUN: pass source-to-low{control-flow=structured-low}

test.target<low_core> @test_target

func.def target(@test_target) @structured_while_with_condition_payload(%cond: i1, %init: i32, %bias: i32) -> (i32, i32) {
  %state, %payload = scf.while(%before = %init : i32) -> (i32, i32) {
    %forwarded = scalar.addi %before, %bias : i32
    scf.condition %cond, %before, %forwarded : i1, i32, i32
  } do(%body_state: i32, %body_payload: i32) {
    %next = scalar.addi %body_state, %body_payload : i32
    scf.yield %next : i32
  }
  func.return %state, %payload : i32, i32
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) abi(object_function) @structured_while_with_condition_payload(%cond: reg<test.i32>, %init: reg<test.i32>, %bias: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %state, %payload = low.scf.while(%before = %init : reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) {
    %forwarded = test.add.i32 %before, %bias
    low.scf.condition %cond, %before, %forwarded : reg<test.i32>, reg<test.i32>, reg<test.i32>
  } do(%body_state: reg<test.i32>, %body_payload: reg<test.i32>) {
    %next = test.add.i32 %body_state, %body_payload
    low.scf.yield %next : reg<test.i32>
  }
  return %state, %payload
}

// ====
// RUN: pass source-to-low{control-flow=structured-low}

test.target<low_core> @test_target

func.def target(@test_target) @nested_if_inside_for(%cond: i1, %lo: index, %hi: index, %step: index, %init: i32, %bias: i32) -> (i32) {
  %result = scf.for %iv = [%lo to %hi step %step](%acc = %init : i32) -> (i32) {
    %next = scf.if %cond -> (i32) {
      %then = scalar.addi %acc, %bias : i32
      scf.yield %then : i32
    } else {
      scf.yield %acc : i32
    }
    scf.yield %next : i32
  }
  func.return %result : i32
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) abi(object_function) @nested_if_inside_for(%cond: reg<test.i32>, %lo: reg<test.i32>, %hi: reg<test.i32>, %step: reg<test.i32>, %init: reg<test.i32>, %bias: reg<test.i32>) -> (reg<test.i32>) asm {
  %result = low.scf.for signed [%lo to %hi step %step] iter_args(%init: reg<test.i32>) -> (reg<test.i32>) do(%iv: reg<test.i32>, %acc: reg<test.i32>) {
    %next = low.scf.if %cond -> (reg<test.i32>) {
      %then = test.add.i32 %acc, %bias
      low.scf.yield %then : reg<test.i32>
    } else {
      low.scf.yield %acc : reg<test.i32>
    }
    low.scf.yield %next : reg<test.i32>
  }
  return %result
}

// ====
// RUN: pass source-to-low{control-flow=structured-low}

test.target<low_core> @test_target

func.def target(@test_target) @projects_switch_at_structured_boundary(%selector: index, %a: i32, %b: i32) -> (i32) {
  %result = scf.switch %selector -> (i32) {
    case 0 {
      scf.yield %a : i32
    }
    default {
      scf.yield %b : i32
    }
  }
  func.return %result : i32
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) abi(object_function) @projects_switch_at_structured_boundary(%selector: reg<test.i32>, %a: reg<test.i32>, %b: reg<test.i32>) -> (reg<test.i32>) asm {
  %12 = test.const.i32 0
  %13 = test.cmp.eq.i32 %selector, %12
  %result = low.scf.if %13 -> (reg<test.i32>) {
    low.scf.yield %a : reg<test.i32>
  } else {
    low.scf.yield %b : reg<test.i32>
  }
  return %result
}
