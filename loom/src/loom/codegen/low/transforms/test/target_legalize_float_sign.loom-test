  %33 = scalar.extui %18 : i16 to i32
  %34 = scalar.andi %32, %33 : i32
  %35 = scalar.trunci %34 : i32 to i16
  %20 = scalar.constant -32768 : i16
  %28 = scalar.extui %17 : i16 to i32
  %29 = scalar.extui %20 : i16 to i32
  %30 = scalar.andi %28, %29 : i32
  %31 = scalar.trunci %30 : i32 to i16
  %24 = scalar.extui %35 : i16 to i32
  %25 = scalar.extui %31 : i16 to i32
  %26 = scalar.ori %24, %25 : i32
  %27 = scalar.trunci %26 : i32 to i16
  %f16_copied = scalar.bitcast %27 : i16 to f16
  func.return %fp8_absolute, %fp8_negated, %fp8_copied, %f16_absolute, %f16_negated, %f16_copied : f8E5M2, f8E5M2, f8E5M2, f16, f16, f16
