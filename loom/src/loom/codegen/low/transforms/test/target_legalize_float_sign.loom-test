  %54 = scalar.constant 127 : i8
  %68 = scalar.extui %52 : i8 to i32
  %69 = scalar.extui %54 : i8 to i32
  %70 = scalar.andi %68, %69 : i32
  %71 = scalar.trunci %70 : i32 to i8
