  %fp8_absolute = vector.absf %fp8_magnitude : vector<4xf8E4M3>
  %fp8_negated = vector.negf %fp8_magnitude : vector<4xf8E4M3>
  %fp8_copied = vector.copysignf %fp8_magnitude, %fp8_sign : vector<4xf8E4M3>
  %bf16_absolute = vector.absf %bf16_magnitude : vector<3xbf16>
  %bf16_negated = vector.negf %bf16_magnitude : vector<3xbf16>
  %bf16_copied = vector.copysignf %bf16_magnitude, %bf16_sign : vector<3xbf16>
  func.return %fp8_absolute, %fp8_negated, %fp8_copied, %bf16_absolute, %bf16_negated, %bf16_copied : vector<4xf8E4M3>, vector<4xf8E4M3>, vector<4xf8E4M3>, vector<3xbf16>, vector<3xbf16>, vector<3xbf16>
}

