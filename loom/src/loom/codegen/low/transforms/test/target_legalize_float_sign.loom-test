  %65 = scalar.extui %56 : i8 to i32
  %66 = scalar.andi %64, %65 : i32
  %67 = scalar.trunci %66 : i32 to i8
  %60 = scalar.extui %71 : i8 to i32
  %61 = scalar.extui %67 : i8 to i32
  %62 = scalar.ori %60, %61 : i32
  %63 = scalar.trunci %62 : i32 to i8
  %fp8_copied = scalar.bitcast %63 : i8 to f8E5M2
