// RUN: pass target-legalize{mode=eager,policy=reference-only},dce

test.target<low_core> @test_target

func.def target(@test_target) @scalar_narrow_float_signs(%fp8_magnitude: f8E5M2, %fp8_sign: f8E5M2, %f16_magnitude: f16, %f16_sign: f16) -> (f8E5M2, f8E5M2, f8E5M2, f16, f16, f16) {
  %fp8_absolute = scalar.absf %fp8_magnitude : f8E5M2
  %fp8_negated = scalar.negf %fp8_magnitude : f8E5M2
  %fp8_copied = scalar.copysignf %fp8_magnitude, %fp8_sign : f8E5M2
  %f16_absolute = scalar.absf %f16_magnitude : f16
  %f16_negated = scalar.negf %f16_magnitude : f16
  %f16_copied = scalar.copysignf %f16_magnitude, %f16_sign : f16
  func.return %fp8_absolute, %fp8_negated, %fp8_copied, %f16_absolute, %f16_negated, %f16_copied : f8E5M2, f8E5M2, f8E5M2, f16, f16, f16
}

// ----
test.target<low_core> @test_target

func.def target(@test_target) @scalar_narrow_float_signs(%fp8_magnitude: f8E5M2, %fp8_sign: f8E5M2, %f16_magnitude: f16, %f16_sign: f16) -> (f8E5M2, f8E5M2, f8E5M2, f16, f16, f16) {
  %92 = scalar.bitcast %fp8_magnitude : f8E5M2 to i8
  %93 = scalar.constant 127 : i8
  %96 = scalar.extui %92 : i8 to i32
  %97 = scalar.extui %93 : i8 to i32
  %98 = scalar.andi %96, %97 : i32
  %99 = scalar.trunci %98 : i32 to i8
  %fp8_absolute = scalar.bitcast %99 : i8 to f8E5M2
  %84 = scalar.bitcast %fp8_magnitude : f8E5M2 to i8
  %85 = scalar.constant -128 : i8
  %88 = scalar.extui %84 : i8 to i32
  %89 = scalar.extui %85 : i8 to i32
  %90 = scalar.xori %88, %89 : i32
  %91 = scalar.trunci %90 : i32 to i8
  %fp8_negated = scalar.bitcast %91 : i8 to f8E5M2
  %58 = scalar.bitcast %fp8_magnitude : f8E5M2 to i8
  %59 = scalar.bitcast %fp8_sign : f8E5M2 to i8
  %60 = scalar.constant 127 : i8
  %77 = scalar.extui %58 : i8 to i32
  %78 = scalar.extui %60 : i8 to i32
  %79 = scalar.andi %77, %78 : i32
  %62 = scalar.constant -128 : i8
  %70 = scalar.extui %59 : i8 to i32
  %71 = scalar.extui %62 : i8 to i32
  %72 = scalar.andi %70, %71 : i32
  %82 = scalar.constant 255 : i32
  %83 = scalar.andi %79, %82 : i32
  %75 = scalar.constant 255 : i32
  %76 = scalar.andi %72, %75 : i32
  %68 = scalar.ori %83, %76 : i32
  %69 = scalar.trunci %68 : i32 to i8
  %fp8_copied = scalar.bitcast %69 : i8 to f8E5M2
  %50 = scalar.bitcast %f16_magnitude : f16 to i16
  %51 = scalar.constant 32767 : i16
  %54 = scalar.extui %50 : i16 to i32
  %55 = scalar.extui %51 : i16 to i32
  %56 = scalar.andi %54, %55 : i32
  %57 = scalar.trunci %56 : i32 to i16
  %f16_absolute = scalar.bitcast %57 : i16 to f16
  %42 = scalar.bitcast %f16_magnitude : f16 to i16
  %43 = scalar.constant -32768 : i16
  %46 = scalar.extui %42 : i16 to i32
  %47 = scalar.extui %43 : i16 to i32
  %48 = scalar.xori %46, %47 : i32
  %49 = scalar.trunci %48 : i32 to i16
  %f16_negated = scalar.bitcast %49 : i16 to f16
  %16 = scalar.bitcast %f16_magnitude : f16 to i16
  %17 = scalar.bitcast %f16_sign : f16 to i16
  %18 = scalar.constant 32767 : i16
  %35 = scalar.extui %16 : i16 to i32
  %36 = scalar.extui %18 : i16 to i32
  %37 = scalar.andi %35, %36 : i32
  %20 = scalar.constant -32768 : i16
  %28 = scalar.extui %17 : i16 to i32
  %29 = scalar.extui %20 : i16 to i32
  %30 = scalar.andi %28, %29 : i32
  %40 = scalar.constant 65535 : i32
  %41 = scalar.andi %37, %40 : i32
  %33 = scalar.constant 65535 : i32
  %34 = scalar.andi %30, %33 : i32
  %26 = scalar.ori %41, %34 : i32
  %27 = scalar.trunci %26 : i32 to i16
  %f16_copied = scalar.bitcast %27 : i16 to f16
  func.return %fp8_absolute, %fp8_negated, %fp8_copied, %f16_absolute, %f16_negated, %f16_copied : f8E5M2, f8E5M2, f8E5M2, f16, f16, f16
}

// ====

// RUN: with-checks compile-report target-legalize{mode=eager,policy=reference-only},dce

test.target<low_core> @test_target

// Source sign rewrites preserve vector shape. Their generated bitwise combines
// may independently take the requested reference path at the fixed point.
func.def target(@test_target) @vector_fp8_signs(%fp8_magnitude: vector<4xf8E4M3>, %fp8_sign: vector<4xf8E4M3>) -> (vector<4xf8E4M3>, vector<4xf8E4M3>, vector<4xf8E4M3>) {
  %fp8_absolute = vector.absf %fp8_magnitude : vector<4xf8E4M3>
  %fp8_negated = vector.negf %fp8_magnitude : vector<4xf8E4M3>
  %fp8_copied = vector.copysignf %fp8_magnitude, %fp8_sign : vector<4xf8E4M3>
  func.return %fp8_absolute, %fp8_negated, %fp8_copied : vector<4xf8E4M3>, vector<4xf8E4M3>, vector<4xf8E4M3>
}

func.def target(@test_target) @vector_bf16_signs(%bf16_magnitude: vector<3xbf16>, %bf16_sign: vector<3xbf16>) -> (vector<3xbf16>, vector<3xbf16>, vector<3xbf16>) {
  %bf16_absolute = vector.absf %bf16_magnitude : vector<3xbf16>
  %bf16_negated = vector.negf %bf16_magnitude : vector<3xbf16>
  %bf16_copied = vector.copysignf %bf16_magnitude, %bf16_sign : vector<3xbf16>
  func.return %bf16_absolute, %bf16_negated, %bf16_copied : vector<3xbf16>, vector<3xbf16>, vector<3xbf16>
}

// ----
CHECK: COMPILE-REPORT: target_legalization[*] function=vector_fp8_signs source_op=vector.absf * action=rewritten * legalizer=math strategy=reference * scalarized=true *
CHECK: COMPILE-REPORT: target_legalization[*] function=vector_fp8_signs source_op=vector.negf * action=rewritten * legalizer=math strategy=reference * scalarized=true *
CHECK: COMPILE-REPORT: target_legalization[*] function=vector_fp8_signs source_op=vector.copysignf * action=rewritten * legalizer=math strategy=reference * scalarized=true *
CHECK: COMPILE-REPORT: target_legalization[*] function=vector_bf16_signs source_op=vector.absf * action=rewritten * legalizer=math strategy=reference * scalarized=true *
CHECK: COMPILE-REPORT: target_legalization[*] function=vector_bf16_signs source_op=vector.negf * action=rewritten * legalizer=math strategy=reference * scalarized=true *
CHECK: COMPILE-REPORT: target_legalization[*] function=vector_bf16_signs source_op=vector.copysignf * action=rewritten * legalizer=math strategy=reference * scalarized=true *
