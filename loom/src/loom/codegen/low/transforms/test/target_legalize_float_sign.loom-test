  %45 = scalar.constant 32767 : i16
  %48 = scalar.extui %44 : i16 to i32
  %49 = scalar.extui %45 : i16 to i32
  %50 = scalar.andi %48, %49 : i32
  %51 = scalar.trunci %50 : i32 to i16
  %f16_absolute = scalar.bitcast %51 : i16 to f16
