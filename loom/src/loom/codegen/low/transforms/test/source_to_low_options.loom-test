// RUN: pass source-to-low{control-flow=structured-low}

test.target<low_core> @test_target

func.def target(@test_target) @structured_control_option_smoke(%lhs: i32, %rhs: i32) -> (i32) {
  %sum = scalar.addi %lhs, %rhs : i32
  func.return %sum : i32
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) abi(object_function) @structured_control_option_smoke(%lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>) asm {
  %sum = test.add.i32 %lhs, %rhs
  return %sum
}

// ====

// RUN: pass source-to-low

test.target<low_core> @test_target

func.def target(@test_target) @preserves_schedule_fence() {
  scf.schedule.fence
  func.return
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) abi(object_function) @preserves_schedule_fence() asm {
  low.schedule.fence
  return
}

// ====

// RUN: with-locations pass source-to-low

test.target<low_core> @test_target loc("target.loom":1:1)

func.def target(@test_target) @preserves_sanitizer_site_location(%lhs: i32, %rhs: i32) -> (i32) {
  %sum = scalar.addi %lhs, %rhs : i32 loc(tagged<sanitizer_site, "0405", "source-low.loom":3:1>)
  func.return %sum : i32 loc("source-low.loom":4:1)
} loc("source-low.loom":1:1 to 5:1)

// ----
test.target<low_core> @test_target loc("target.loom":1:1)

low.func.def target<test.low.core>(@test_target) abi(object_function) @preserves_sanitizer_site_location(%lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>) asm {
  %sum = test.add.i32 %lhs, %rhs loc(tagged<sanitizer_site, "0405", "source-low.loom":3:1>)
  return %sum loc("source-low.loom":4:1)
} loc("source-low.loom":1:1 to 5:1)

// ====

// RUN: pass source-to-low

test.target<low_core> @test_target

func.def target(@test_target) @lowered_source(%value: i32) -> (i32) {
  func.return %value : i32
}

low.func.decl import(native, "callback") target<test.low.core>(@test_target) abi(object_function) @callback(%value: reg<test.i32>) -> (reg<test.i32>)

low.func.def public target<test.low.core>(@test_target) abi(object_function) @preserved_low(%value: reg<test.i32>) -> (reg<test.i32>) asm {
  return %value
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) abi(object_function) @lowered_source(%value: reg<test.i32>) -> (reg<test.i32>) asm {
  return %value
}

low.func.decl import(native, "callback") target<test.low.core>(@test_target) abi(object_function) @callback(%value: reg<test.i32>) -> (reg<test.i32>)

low.func.def public target<test.low.core>(@test_target) abi(object_function) @preserved_low(%value: reg<test.i32>) -> (reg<test.i32>) asm {
  return %value
}

// ====

// RUN: pass source-to-low

test.target<low_core> @test_target

func.def target(@test_target) @structural_register_emits(%lo: i32, %hi: i32) -> (i32, i32) {
  %pair = vector.from_elements %lo, %hi : vector<2xi32>
  %result_lo = vector.extract %pair[0] : vector<2xi32> -> i32
  %result_hi = vector.extract %pair[1] : vector<2xi32> -> i32
  func.return %result_lo, %result_hi : i32, i32
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) abi(object_function) @structural_register_emits(%lo: reg<test.i32>, %hi: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %pair = concat(%lo, %hi) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32 x2>
  %12 = slice %pair[0] : reg<test.i32 x2> -> reg<test.i32>
  %13 = copy %12 : reg<test.i32> -> reg<test.f32>
  %result_lo = copy %13 : reg<test.f32> -> reg<test.i32>
  %15 = slice %pair[1] : reg<test.i32 x2> -> reg<test.i32>
  %16 = copy %15 : reg<test.i32> -> reg<test.f32>
  %result_hi = copy %16 : reg<test.f32> -> reg<test.i32>
  return %result_lo, %result_hi
}
