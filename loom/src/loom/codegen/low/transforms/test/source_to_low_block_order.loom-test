// RUN: pass inline-callables,cse,source-to-low

// Inlining appends a continuation; CSE shares its constant with a consumer
// whose physical block precedes it. Lowering follows dominance, not storage.
test.target<low_core> @target

func.def inline target(@target) @produce(%input: i32) -> (i32) {
  cfg.br ^body
^body:
  %value = scalar.muli %input, %input : i32
  func.return %value : i32
}

func.def public target(@target) @late_dominator(%input: i32) -> (i32) {
  %value = func.call @produce(%input) : (i32) -> (i32)
  %first = scalar.constant 5 : i32
  %factor = scalar.addi %value, %first : i32
  cfg.br ^consumer(%factor: i32)
^consumer(%carried: i32):
  %second = scalar.constant 5 : i32
  %result = scalar.muli %carried, %second : i32
  func.return %result : i32
}

// ----
test.target<low_core> @target

low.func.def public target<test.low.core>(@target) abi(object_function) @late_dominator(%input: reg<test.i32>) -> (reg<test.i32>) asm {
  low.br ^_bb1
^_bb1:
  low.br ^_bb2
^_bb2:
  %value$16 = test.mul.i32 %input, %input
  low.br ^_bb3(%value$16: reg<test.i32>)
^_bb3(%value$15: reg<test.i32>):
  %first = test.const.i32 5
  %factor = test.add.i32 %value$15, %first
  low.br ^consumer(%factor: reg<test.i32>)
^consumer(%carried: reg<test.i32>):
  %result = test.mul.i32 %carried, %first
  return %result
}

// ====
// RUN: pass source-to-low

test.target<low_core> @target

// Unreachable blocks remain after reachable definitions in planning order.
func.def target(@target) @unreachable_block(%input: i32) -> (i32) {
  cfg.br ^live
^live:
  %result = scalar.addi %input, %input : i32
  func.return %result : i32
^dead:
  %unused = scalar.muli %input, %input : i32
  func.return %unused : i32
}

// ----
test.target<low_core> @target

low.func.def target<test.low.core>(@target) abi(object_function) @unreachable_block(%input: reg<test.i32>) -> (reg<test.i32>) asm {
  low.br ^live
^live:
  %result = test.add.i32 %input, %input
  return %result
^dead:
  %unused = test.mul.i32 %input, %input
  return %unused
}
