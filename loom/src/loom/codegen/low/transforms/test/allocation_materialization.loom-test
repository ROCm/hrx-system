  %result = low.scf.for signed [%lower to %upper step %step] iter_args(%init: reg<test.i32>) -> (reg<test.i32>) do(%iv: reg<test.i32>, %state: reg<test.i32>) {
    %next = test.add.i32 %state, %iv
    low.scf.yield %next : reg<test.i32>
  }
  return %result
}

