// Inlining appends the producer continuation after the existing loop. Two
// helper returns and two loop predecessors keep both blocks through CFG
// simplification, which forwards the loop argument to the later identity.
// Allocation must reserve the identity's source first despite that layout.
// RUN: pass inline-callables,cfg-simplify,low-materialize-allocation{budgets=test.i32=5}

test.target<low_core> @target

low.func.def inline target<test.low.core>(@target) @select_seed(%choose: reg<test.i32>, %seed: reg<test.i32>) -> (reg<test.i32>) asm {
  low.cond_br %choose, ^left, ^right : reg<test.i32>
^left:
  return %seed
^right:
  %doubled = test.add.i32 %seed, %seed
  return %doubled
}

low.func.def public target<test.low.core>(@target) @identity_after_inlined_continuation(%choose: reg<test.i32>, %again: reg<test.i32>, %seed: reg<test.i32>) -> (reg<test.i32>) asm {
  %selected = low.func.call @select_seed(%choose, %seed) : (reg<test.i32>, reg<test.i32>) -> (reg<test.i32>)
  %source = test.add.i32 %selected, %seed
  %identity = low.assume %source [] : reg<test.i32>
  low.br ^loop(%identity: reg<test.i32>)
^loop(%forwarded: reg<test.i32>):
  %sum = test.add.i32 %forwarded, %seed
  low.cond_br %again, ^backedge, ^returned : reg<test.i32>
^backedge:
  low.br ^loop(%forwarded: reg<test.i32>)
^returned:
  return %sum
}

// ----
test.target<low_core> @target

low.func.def public target<test.low.core>(@target) @identity_after_inlined_continuation(%choose: reg<test.i32>, %again: reg<test.i32>, %seed: reg<test.i32>) -> (reg<test.i32>) asm {
  low.cond_br %choose, ^_bb3, ^_bb4 : reg<test.i32>
^_bb5(%selected: reg<test.i32>):
  %source = test.add.i32 %selected, %seed
  %identity = low.assume %source [] : reg<test.i32>
  low.br ^loop
^loop:
  %sum = test.add.i32 %identity, %seed
  low.cond_br %again, ^loop, ^returned : reg<test.i32>
^returned:
  return %sum
^_bb3:
  low.br ^_bb5(%seed: reg<test.i32>)
^_bb4:
  %doubled = test.add.i32 %seed, %seed
  low.br ^_bb5(%doubled: reg<test.i32>)
}

