// RUN: pass low-materialize-allocation{budgets=test.i32=3,diagnostics=spills}

test.target<low_core> @test_target

// REMARK@+1: BACKEND/045 {function_name="rematerialize_spill_plan_diagnostics", trigger_value_class="test.i32", trigger_kind="spill-plan", repaired_value_count="1", cloned_packet_count="2", rewritten_operand_count="2", retained_placement_count="0", reason_key="descriptor-rematerializable"}
low.func.def target<test.low.core>(@test_target) @rematerialize_spill_plan_diagnostics(%a: reg<test.i32>, %b: reg<test.i32>, %c: reg<test.i32>) -> (reg<test.i32>) asm {
