  low.spill %wide, %wide_slice_reload_cluster_spill_storage_0 : reg<test.i32 x4>, low.storage<private>
  %blocker_use = low.op<test.add.i32>(%blocker, %blocker) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32>
  %13 = low.reload %wide_slice_reload_cluster_spill_storage_0 : low.storage<private> -> reg<test.i32>
  %14 = low.reload %wide_slice_reload_cluster_spill_storage_0 {offset = 4} : low.storage<private> -> reg<test.i32>
  %sum0 = low.op<test.add.i32>(%13, %14) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32>
  %15 = low.reload %wide_slice_reload_cluster_spill_storage_0 {offset = 8} : low.storage<private> -> reg<test.i32>
  %sum1 = low.op<test.add.i32>(%sum0, %15) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32>
  %16 = low.reload %wide_slice_reload_cluster_spill_storage_0 {offset = 12} : low.storage<private> -> reg<test.i32>
  %sum2 = low.op<test.add.i32>(%sum1, %16) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32>
  %out = low.op<test.add.i32>(%sum2, %blocker_use) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32>
  low.return %out : reg<test.i32>
