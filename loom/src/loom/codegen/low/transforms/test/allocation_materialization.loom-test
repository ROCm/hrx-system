low.func.def target<test.low.core>(@test_target) @reports_released_allocation_attempt_storage(%row: reg<test.i32>, %carry: reg<test.i32>) -> (reg<test.i32>) asm {
  low.br ^late
^late:
  %late_state = test.const.i32 7
  low.br ^join(%late_state: reg<test.i32>)
^join(%state: reg<test.i32>):
  %sum = test.add.i32 %row, %carry
  %out = test.add.i32 %sum, %state
  return %out
}

