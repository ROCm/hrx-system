// ====

// Register-required spill sources can still be rematerialized. Recreating a
// constant near its store repairs pressure without another spill slot.
// The storage handle and unused argument have ordinals but no live interval.
// RUN: pass low-materialize-allocation{budgets=test.i32=2}

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @spill_constants(%unused: reg<test.i32>) asm {
  %storage = storage {byte_alignment = 4, byte_length = 12} : low.storage<private>
  %first = test.const.i32 1
  %second = test.const.i32 2
  %third = test.const.i32 3
  low.spill %first, %storage : reg<test.i32>, low.storage<private>
  low.spill %second, %storage {offset = 4} : reg<test.i32>, low.storage<private>
  low.spill %third, %storage {offset = 8} : reg<test.i32>, low.storage<private>
  return
}
// ----
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @spill_constants(%unused: reg<test.i32>) asm {
  %storage = storage {byte_alignment = 4, byte_length = 12} : low.storage<private>
  %first = test.const.i32 1
  low.spill %first, %storage : reg<test.i32>, low.storage<private>
  %second_remat = test.const.i32 2
  low.spill %second_remat, %storage {offset = 4} : reg<test.i32>, low.storage<private>
  %third_remat = test.const.i32 3
  low.spill %third_remat, %storage {offset = 8} : reg<test.i32>, low.storage<private>
  return
}

// ====

// Storage addresses carry their reservation and byte offset through each clone.
// RUN: pass low-materialize-allocation{budgets=test.i32=3}

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @storage_address(%a: reg<test.i32>, %b: reg<test.i32>, %c: reg<test.i32>) -> (reg<test.i32>) asm {
  %storage = storage {byte_alignment = 16, byte_length = 64} : low.storage<private>
  %address = storage_address %storage {offset = 16} : low.storage<private> -> reg<test.i32>
  %ab = test.add.i32 %a, %b
  %bc = test.add.i32 %b, %c
  %first = test.add.i32 %ab, %address
  %second = test.add.i32 %bc, %address
  %result = test.add.i32 %first, %second
  return %result
}

// ----
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @storage_address(%a: reg<test.i32>, %b: reg<test.i32>, %c: reg<test.i32>) -> (reg<test.i32>) asm {
  %storage = storage {byte_alignment = 16, byte_length = 64} : low.storage<private>
  %ab = test.add.i32 %a, %b
  %bc = test.add.i32 %b, %c
  %address_remat$11 = storage_address %storage {offset = 16} : low.storage<private> -> reg<test.i32>
  %first = test.add.i32 %ab, %address_remat$11
  %address_remat$12 = storage_address %storage {offset = 16} : low.storage<private> -> reg<test.i32>
  %second = test.add.i32 %bc, %address_remat$12
  %result = test.add.i32 %first, %second
  return %result
}

// ====

// One user with repeated operands receives one address materialization.
// RUN: pass low-materialize-allocation{budgets=test.i32=3}

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @repeated_storage_address(%a: reg<test.i32>, %b: reg<test.i32>, %c: reg<test.i32>) -> (reg<test.i32>) asm {
  %storage = storage {byte_alignment = 8, byte_length = 8} : low.storage<scratch>
  %address = storage_address %storage : low.storage<scratch> -> reg<test.i32>
  %ab = test.add.i32 %a, %b
  %bc = test.add.i32 %b, %c
  %twice = test.add.i32 %address, %address
  %first = test.add.i32 %ab, %twice
  %result = test.add.i32 %first, %bc
  return %result
}

// ----
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @repeated_storage_address(%a: reg<test.i32>, %b: reg<test.i32>, %c: reg<test.i32>) -> (reg<test.i32>) asm {
  %storage = storage {byte_alignment = 8, byte_length = 8} : low.storage<scratch>
  %ab = test.add.i32 %a, %b
  %bc = test.add.i32 %b, %c
  %address_remat = storage_address %storage : low.storage<scratch> -> reg<test.i32>
  %twice = test.add.i32 %address_remat, %address_remat
  %first = test.add.i32 %ab, %twice
  %result = test.add.i32 %first, %bc
  return %result
}
