  %temporary = test.add.i32 %blocker, %blocker
  %blocker_use = test.add.i32 %blocker, %temporary
  %wide0 = slice %wide[0] : reg<test.i32 x4> -> reg<test.i32>
  %wide1 = slice %wide[1] : reg<test.i32 x4> -> reg<test.i32>
  %sum0 = test.add.i32 %wide0, %wide1
  %wide2 = slice %wide[2] : reg<test.i32 x4> -> reg<test.i32>
  %sum1 = test.add.i32 %sum0, %wide2
  %wide3 = slice %wide[3] : reg<test.i32 x4> -> reg<test.i32>
  %sum2 = test.add.i32 %sum1, %wide3
  %out = test.add.i32 %sum2, %blocker_use
  return %out
}

