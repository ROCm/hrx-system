// ====

// Per-use definitions cannot become repair candidates again merely because
// another operand's definition was inserted between them and their shared user.
// Three simultaneous operands in two physical registers remain unallocatable;
// each original constant is attempted once before reporting that real failure.
// RUN: with-low-asm pass low-materialize-allocation{diagnostics=spills}

test.target<low_core> @test_target

// REMARK@+2: BACKEND/045 {repaired_value_count="2", cloned_packet_count="2", rewritten_operand_count="2", retained_placement_count="0"}
// REMARK@+1: BACKEND/045 {repaired_value_count="1", cloned_packet_count="1", rewritten_operand_count="1", retained_placement_count="0"}
low.func.def target<test.low.core>(@test_target) @irreducible_constants() -> (reg<test.packed.narrow>, reg<test.packed.narrow>, reg<test.packed.narrow>) asm {
  %first = test.const.packed.narrow 7
  %second = test.const.packed.narrow 11
  // ERROR@+1: BACKEND/005 "budget 2" "peak 3" "unspillable-register-exhausted"
  %third = test.const.packed.narrow 13
  return %first, %second, %third
}

// ----

// ====

// The temporary forces a spill. The overlapping three- and two-unit slices
// together read more than the four-unit source, so they share a full reload.
// RUN: with-low-asm pass low-materialize-allocation{budgets=test.i32=5}

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @overlapping_slice_reloads(%blocker: reg<test.i32>, %wide: reg<test.i32 x4>) -> (reg<test.i32>) asm {
  %temporary = test.add.i32 %blocker, %blocker
  %pressure = test.add.i32 %blocker, %temporary
  %head = slice %wide[0] : reg<test.i32 x4> -> reg<test.i32 x3>
  %first = slice %head[0] : reg<test.i32 x3> -> reg<test.i32>
  %second = slice %head[1] : reg<test.i32 x3> -> reg<test.i32>
  %sum = test.add.i32 %first, %second
  %tail = slice %wide[2] : reg<test.i32 x4> -> reg<test.i32 x2>
  %third = slice %tail[0] : reg<test.i32 x2> -> reg<test.i32>
  %fourth = slice %tail[1] : reg<test.i32 x2> -> reg<test.i32>
  %sum1 = test.add.i32 %sum, %third
  %sum2 = test.add.i32 %sum1, %fourth
  %out = test.add.i32 %sum2, %pressure
  return %out
}

// ----
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @overlapping_slice_reloads(%blocker: reg<test.i32>, %wide: reg<test.i32 x4>) -> (reg<test.i32>) asm {
  %overlapping_slice_reloads_spill_storage_0 = storage {byte_alignment = 16, byte_length = 16} : low.storage<private>
  low.spill %wide, %overlapping_slice_reloads_spill_storage_0 : reg<test.i32 x4>, low.storage<private>
  %temporary = test.add.i32 %blocker, %blocker
  %pressure = test.add.i32 %blocker, %temporary
  %16 = low.reload %overlapping_slice_reloads_spill_storage_0 : low.storage<private> -> reg<test.i32 x4>
  %head = slice %16[0] : reg<test.i32 x4> -> reg<test.i32 x3>
  %first = slice %head[0] : reg<test.i32 x3> -> reg<test.i32>
  %second = slice %head[1] : reg<test.i32 x3> -> reg<test.i32>
  %sum = test.add.i32 %first, %second
  %tail = slice %16[2] : reg<test.i32 x4> -> reg<test.i32 x2>
  %third = slice %tail[0] : reg<test.i32 x2> -> reg<test.i32>
  %fourth = slice %tail[1] : reg<test.i32 x2> -> reg<test.i32>
  %sum1 = test.add.i32 %sum, %third
  %sum2 = test.add.i32 %sum1, %fourth
  %out = test.add.i32 %sum2, %pressure
  return %out
}

// ====

// Repeated operands of one instruction share a single rematerialization.
// Three registers hold both live sums and one literal without spill traffic.
// RUN: pass low-materialize-allocation{budgets=test.i32=3}

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @rematerialize_duplicate_operands(%a: reg<test.i32>, %b: reg<test.i32>, %c: reg<test.i32>) -> (reg<test.i32>) asm {
  %literal = test.const.i32 7
  %ab = test.add.i32 %a, %b
  %bc = test.add.i32 %b, %c
  %twice = test.add.i32 %literal, %literal
  %partial = test.add.i32 %ab, %twice
  %result = test.add.i32 %partial, %bc
  return %result
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @rematerialize_duplicate_operands(%a: reg<test.i32>, %b: reg<test.i32>, %c: reg<test.i32>) -> (reg<test.i32>) asm {
  %ab = test.add.i32 %a, %b
  %bc = test.add.i32 %b, %c
  %literal_remat = test.const.i32 7
  %twice = test.add.i32 %literal_remat, %literal_remat
  %partial = test.add.i32 %ab, %twice
  %result = test.add.i32 %partial, %bc
  return %result
}

// ====

// CSE appends the second literal's use after the first literal's later user.
// The two uses by twice are therefore separated in the captured use list.
// RUN: pass low-cse,low-materialize-allocation{budgets=test.i32=3}

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @rematerialize_interleaved_operands(%a: reg<test.i32>, %b: reg<test.i32>, %c: reg<test.i32>) -> (reg<test.i32>) asm {
  %literal = test.const.i32 7
  %same = test.const.i32 7
  %ab = test.add.i32 %a, %b
  %bc = test.add.i32 %b, %c
  %twice = test.add.i32 %literal, %same
  %partial = test.add.i32 %ab, %twice
  %tail = test.add.i32 %bc, %literal
  %result = test.add.i32 %partial, %tail
  return %result
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @rematerialize_interleaved_operands(%a: reg<test.i32>, %b: reg<test.i32>, %c: reg<test.i32>) -> (reg<test.i32>) asm {
  %ab = test.add.i32 %a, %b
  %bc = test.add.i32 %b, %c
  %literal_remat$12 = test.const.i32 7
  %twice = test.add.i32 %literal_remat$12, %literal_remat$12
  %partial = test.add.i32 %ab, %twice
  %literal_remat$13 = test.const.i32 7
  %tail = test.add.i32 %bc, %literal_remat$13
  %result = test.add.i32 %partial, %tail
  return %result
}

// ====

// Five cross-block constants exceed the four physical registers. Repair all
// original sources in one snapshot and keep each clone at its actual user.
// RUN: pass low-materialize-allocation

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @cross_block_constants() -> (reg<test.i32>) asm {
  %first = test.const.explicit32 1
  %second = test.const.explicit32 2
  %third = test.const.explicit32 3
  %fourth = test.const.explicit32 4
  %fifth = test.const.explicit32 5
  low.br ^consume
^consume:
  %a = copy %first : reg<test.explicit32> -> reg<test.i32>
  %b = copy %second : reg<test.explicit32> -> reg<test.i32>
  %c = copy %third : reg<test.explicit32> -> reg<test.i32>
  %d = copy %fourth : reg<test.explicit32> -> reg<test.i32>
  %e = copy %fifth : reg<test.explicit32> -> reg<test.i32>
  %ab = test.add.i32 %a, %b
  %cd = test.add.i32 %c, %d
  %abcd = test.add.i32 %ab, %cd
  %result = test.add.i32 %abcd, %e
  return %result
}

// ----
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @cross_block_constants() -> (reg<test.i32>) asm {
  low.br ^consume
^consume:
  %first_remat = test.const.explicit32 1
  %a = copy %first_remat : reg<test.explicit32> -> reg<test.i32>
  %second_remat = test.const.explicit32 2
  %b = copy %second_remat : reg<test.explicit32> -> reg<test.i32>
  %third_remat = test.const.explicit32 3
  %c = copy %third_remat : reg<test.explicit32> -> reg<test.i32>
  %fourth_remat = test.const.explicit32 4
  %d = copy %fourth_remat : reg<test.explicit32> -> reg<test.i32>
  %fifth_remat = test.const.explicit32 5
  %e = copy %fifth_remat : reg<test.explicit32> -> reg<test.i32>
  %ab = test.add.i32 %a, %b
  %cd = test.add.i32 %c, %d
  %abcd = test.add.i32 %ab, %cd
  %result = test.add.i32 %abcd, %e
  return %result
}

// ====

// Both spilled literals rematerialize in one batch. The three attempts are
// the initial allocation, the batch retry, and one materialized storage spill.
// RUN: with-checks pass-report low-materialize-allocation{budgets=test.i32=2}

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @spill_batch_rebuilds_once(%input: reg<test.i32>) -> (reg<test.i32>) asm {
  %one = test.const.i32 1
  %two = test.const.i32 2
  %three = test.const.i32 3
  %pressure = test.add.i32 %input, %input
  %pair = test.add.i32 %one, %two
  %sum = test.add.i32 %pair, %three
  %result = test.add.i32 %sum, %pressure
  return %result
}

// ----
CHECK: *"rematerializations":2,*"attempts":3,*

// ====

// Folding the fallback edge makes the late producer dominate the early loop.
// Consumer-first repair must use CFG order after that change, not source points.
// RUN: with-checks pass-report cfg-simplify,low-materialize-allocation{budgets=test.i32=2}

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @dependent_spills_reordered_cfg(%a: reg<test.i32>, %b: reg<test.i32>) -> (reg<test.i32>) asm {
  low.cond_br %a, ^produce, ^fallback : reg<test.i32>
^derive(%incoming_literal: reg<test.i32>):
  %derived = test.rematerialize.i32 %incoming_literal
  low.cond_br %b, ^repeat, ^finish : reg<test.i32>
^repeat:
  low.br ^derive(%incoming_literal: reg<test.i32>)
^finish:
  low.br ^consume(%incoming_literal: reg<test.i32>, %derived: reg<test.i32>)
^consume(%literal_value: reg<test.i32>, %derived_value: reg<test.i32>):
  %ab = test.add.i32 %a, %b
  %ba = test.add.i32 %b, %a
  %first = test.add.i32 %ab, %derived_value
  %second = test.add.i32 %ba, %derived_value
  %both = test.add.i32 %literal_value, %derived_value
  %partial = test.add.i32 %first, %second
  %result = test.add.i32 %partial, %both
  return %result
^fallback:
  %false = test.const.i32 0
  low.cond_br %false, ^alternate, ^exit : reg<test.i32>
^alternate:
  %other_literal = test.const.i32 13
  low.br ^derive(%other_literal: reg<test.i32>)
^exit:
  return %a
^produce:
  %literal = test.const.i32 7
  low.br ^derive(%literal: reg<test.i32>)
}

// ----
CHECK: *"rematerializations":7,*"attempts":8,*

// ====

// Nested definitions use their analyzed enclosing block's point range;
// cloning a consumer must preserve its producer until all new uses are repaired.
// RUN: with-checks pass-report low-materialize-allocation{budgets=test.i32=2}

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @nested_dependent_spills(%condition: reg<test.i32>, %a: reg<test.i32>) -> (reg<test.i32>) asm {
  %result = low.scf.if %condition -> (reg<test.i32>) {
    %literal = test.const.i32 7
    %derived = test.rematerialize.i32 %literal
    %first_pair = test.add.i32 %a, %a
    %second_pair = test.add.i32 %a, %a
    %first = test.add.i32 %first_pair, %derived
    %second = test.add.i32 %second_pair, %derived
    %both = test.add.i32 %literal, %derived
    %partial = test.add.i32 %first, %second
    %sum = test.add.i32 %partial, %both
    low.scf.yield %sum : reg<test.i32>
  } else {
    low.scf.yield %a : reg<test.i32>
  }
  return %result
}

// ----
CHECK: *"rematerializations":7,*"attempts":8,*

