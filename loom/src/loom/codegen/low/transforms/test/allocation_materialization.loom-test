// ====

// An operand can refer to a non-immediate ancestor in the replay chain. The
// recipe result index keeps that operand internal even when its original value
// is consumed after the recipe definition.
// RUN: pass low-materialize-allocation{budgets=test.explicit32=2,spill-storage-spaces=none}

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @rematerialize_recipe_internal_cross_edge(%seed: reg<test.i32>) -> (reg<test.i32>) asm {
  %root = test.const.explicit32 3
  %chain0 = test.rematerialize.pair.explicit32 %root, %root
