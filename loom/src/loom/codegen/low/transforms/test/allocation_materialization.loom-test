^right:
  %38 = low.reload %dense_slice_reloads_per_cfg_block_spill_storage_0 : low.storage<private> -> reg<test.i32 x8>
  %right0 = slice %38[0] : reg<test.i32 x8> -> reg<test.i32>
  %right1 = slice %38[1] : reg<test.i32 x8> -> reg<test.i32>
  %right_sum0 = test.add.i32 %right0, %right1
  %right2 = slice %38[2] : reg<test.i32 x8> -> reg<test.i32>
  %right_sum1 = test.add.i32 %right_sum0, %right2
  %right3 = slice %38[3] : reg<test.i32 x8> -> reg<test.i32>
  %right_sum2 = test.add.i32 %right_sum1, %right3
  %right4 = slice %38[4] : reg<test.i32 x8> -> reg<test.i32>
  %right_sum3 = test.add.i32 %right_sum2, %right4
  %right5 = slice %38[5] : reg<test.i32 x8> -> reg<test.i32>
  %right_sum4 = test.add.i32 %right_sum3, %right5
  %right6 = slice %38[6] : reg<test.i32 x8> -> reg<test.i32>
  %right_sum5 = test.add.i32 %right_sum4, %right6
  %right7 = slice %38[7] : reg<test.i32 x8> -> reg<test.i32>
  %right_sum6 = test.add.i32 %right_sum5, %right7
  return %right_sum6
}

