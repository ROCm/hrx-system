// ====

// Tied packets consume their predecessors' storage. Rebuild the complete
// ownership chain for each user so the clones consume distinct roots near
// their uses.
// RUN: pass low-materialize-allocation{spill-storage-spaces=none}

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @rematerialize_tied_chain(%block0: reg<test.explicit32>, %block1: reg<test.explicit32>, %block2: reg<test.explicit32>, %seed: reg<test.i32>) -> (reg<test.i32>) asm {
  %root = test.const.explicit32 3
  %chain0 = test.rematerialize.tied.explicit32 %root
  %chain1 = test.rematerialize.tied.explicit32 %chain0
  %late = copy %seed : reg<test.i32> -> reg<test.explicit32>
  %use0 = copy %block0 : reg<test.explicit32> -> reg<test.i32>
  %use1 = copy %block1 : reg<test.explicit32> -> reg<test.i32>
  %use2 = copy %block2 : reg<test.explicit32> -> reg<test.i32>
  %use3 = copy %late : reg<test.explicit32> -> reg<test.i32>
  %chain_use0 = copy %chain1 : reg<test.explicit32> -> reg<test.i32>
  %chain_use1 = copy %chain1 : reg<test.explicit32> -> reg<test.i32>
  %sum01 = test.add.i32 %use0, %use1
  %sum23 = test.add.i32 %use2, %use3
  %sum0123 = test.add.i32 %sum01, %sum23
  %sum_chain = test.add.i32 %chain_use0, %chain_use1
  %result = test.add.i32 %sum0123, %sum_chain
  return %result
}

