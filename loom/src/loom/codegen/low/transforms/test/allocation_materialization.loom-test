// ====

// Removing the first use swaps a later slice to the front of the use list.
// The shared reload must still precede the first slice in program order.
// RUN: pass low-dce,low-materialize-allocation{budgets=test.i32=3}

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @shared_reload_after_dce(%blocker: reg<test.i32>, %wide: reg<test.i32 x2>) -> (reg<test.i32>) asm {
  %temporary = test.add.i32 %blocker, %blocker
  %pressure = test.add.i32 %blocker, %temporary
  %dead = slice %wide[1] : reg<test.i32 x2> -> reg<test.i32>
  %first = slice %wide[0] : reg<test.i32 x2> -> reg<test.i32>
  %second = slice %wide[1] : reg<test.i32 x2> -> reg<test.i32>
  %pair = test.add.i32 %first, %second
  %third = slice %wide[0] : reg<test.i32 x2> -> reg<test.i32>
  %sum = test.add.i32 %pair, %third
  %result = test.add.i32 %sum, %pressure
  return %result
}

// ----
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @shared_reload_after_dce(%blocker: reg<test.i32>, %wide: reg<test.i32 x2>) -> (reg<test.i32>) asm {
  %shared_reload_after_dce_spill_storage_0 = storage {byte_alignment = 8, byte_length = 8} : low.storage<private>
  low.spill %wide, %shared_reload_after_dce_spill_storage_0 : reg<test.i32 x2>, low.storage<private>
  %temporary = test.add.i32 %blocker, %blocker
  %pressure = test.add.i32 %blocker, %temporary
  %13 = low.reload %shared_reload_after_dce_spill_storage_0 : low.storage<private> -> reg<test.i32 x2>
  %first = slice %13[0] : reg<test.i32 x2> -> reg<test.i32>
  %second = slice %13[1] : reg<test.i32 x2> -> reg<test.i32>
  %pair = test.add.i32 %first, %second
  %third = slice %13[0] : reg<test.i32 x2> -> reg<test.i32>
  %sum = test.add.i32 %pair, %third
  %result = test.add.i32 %sum, %pressure
  return %result
}

// ====

// Each branch gets its own reload even when dead-use removal changes the order
// of uses both within a block and between blocks.
// RUN: pass low-dce,low-materialize-allocation{budgets=test.i32=9}

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @dense_slice_reloads_per_cfg_block(%condition: reg<test.i32>, %wide: reg<test.i32 x8>) -> (reg<test.i32>) asm {
  %temporary = test.add.i32 %condition, %condition
  %selector = test.add.i32 %condition, %temporary
  low.cond_br %selector, ^left, ^right : reg<test.i32>
^left:
  %dead_left = slice %wide[7] : reg<test.i32 x8> -> reg<test.i32>
  %left0 = slice %wide[0] : reg<test.i32 x8> -> reg<test.i32>
  %left1 = slice %wide[1] : reg<test.i32 x8> -> reg<test.i32>
  %left_sum0 = test.add.i32 %left0, %left1
  %left2 = slice %wide[2] : reg<test.i32 x8> -> reg<test.i32>
  %left_sum1 = test.add.i32 %left_sum0, %left2
  %left3 = slice %wide[3] : reg<test.i32 x8> -> reg<test.i32>
  %left_sum2 = test.add.i32 %left_sum1, %left3
  %left4 = slice %wide[4] : reg<test.i32 x8> -> reg<test.i32>
  %left_sum3 = test.add.i32 %left_sum2, %left4
  %left5 = slice %wide[5] : reg<test.i32 x8> -> reg<test.i32>
  %left_sum4 = test.add.i32 %left_sum3, %left5
  %left6 = slice %wide[6] : reg<test.i32 x8> -> reg<test.i32>
  %left_sum5 = test.add.i32 %left_sum4, %left6
  %left7 = slice %wide[7] : reg<test.i32 x8> -> reg<test.i32>
  %left_sum6 = test.add.i32 %left_sum5, %left7
  return %left_sum6
^right:
  %dead_right = slice %wide[7] : reg<test.i32 x8> -> reg<test.i32>
  %right0 = slice %wide[0] : reg<test.i32 x8> -> reg<test.i32>
  %right1 = slice %wide[1] : reg<test.i32 x8> -> reg<test.i32>
  %right_sum0 = test.add.i32 %right0, %right1
  %right2 = slice %wide[2] : reg<test.i32 x8> -> reg<test.i32>
  %right_sum1 = test.add.i32 %right_sum0, %right2
  %right3 = slice %wide[3] : reg<test.i32 x8> -> reg<test.i32>
  %right_sum2 = test.add.i32 %right_sum1, %right3
  %right4 = slice %wide[4] : reg<test.i32 x8> -> reg<test.i32>
  %right_sum3 = test.add.i32 %right_sum2, %right4
  %right5 = slice %wide[5] : reg<test.i32 x8> -> reg<test.i32>
  %right_sum4 = test.add.i32 %right_sum3, %right5
  %right6 = slice %wide[6] : reg<test.i32 x8> -> reg<test.i32>
  %right_sum5 = test.add.i32 %right_sum4, %right6
  %right7 = slice %wide[7] : reg<test.i32 x8> -> reg<test.i32>
  %right_sum6 = test.add.i32 %right_sum5, %right7
  return %right_sum6
}

