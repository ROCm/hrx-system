  %short_value = copy %short : reg<test.coindexed.partner> -> reg<test.i32>
  %partner = copy %source : reg<test.i32> -> reg<test.coindexed.partner>
  test.coindexed.operands %primary, %partner
  %primary_value = copy %primary : reg<test.packed.narrow> -> reg<test.i32>
  %guard_value = copy %guard : reg<test.packed.narrow> -> reg<test.i32>
  %long_value = copy %long : reg<test.coindexed.partner> -> reg<test.i32>
  return %primary_value, %guard_value, %short_value, %long_value
}

