// ====

// Neither narrow-register blocker can replay. Recreate constants elsewhere
// in their broader class so reallocation can move both stream results.
// RUN: with-low-asm pass low-materialize-allocation{spill-storage-spaces=none}

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @narrow_domain_repair(%state: reg<test.recolor32>, %input: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.recolor32>) asm {
  %first = test.const.explicit32 1
  %second = test.const.explicit32 2
  %blocked0, %state1 = test.stream.step.i32 %state, %input
  %blocked1, %state2 = test.stream.step.i32 %state1, %input
  %needed = test.packing.create %input
  %needed_other = test.packing.create %input
  %needed_other_value = copy %needed_other : reg<test.packed.narrow> -> reg<test.i32>
  %needed_value = copy %needed : reg<test.packed.narrow> -> reg<test.i32>
  %blocked0_value = copy %blocked0 : reg<test.explicit32> -> reg<test.i32>
  %blocked1_value = copy %blocked1 : reg<test.explicit32> -> reg<test.i32>
  %first_value = copy %first : reg<test.explicit32> -> reg<test.i32>
  %second_value = copy %second : reg<test.explicit32> -> reg<test.i32>
  return %needed_other_value, %needed_value, %blocked0_value, %blocked1_value, %first_value, %second_value, %state2
}

// ----
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @narrow_domain_repair(%state: reg<test.recolor32>, %input: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.recolor32>) asm {
  %blocked0, %state1 = test.stream.step.i32 %state, %input
  %blocked1, %state2 = test.stream.step.i32 %state1, %input
  %needed = test.packing.create %input
  %needed_other = test.packing.create %input
  %needed_other_value = copy %needed_other : reg<test.packed.narrow> -> reg<test.i32>
  %needed_value = copy %needed : reg<test.packed.narrow> -> reg<test.i32>
  %blocked0_value = copy %blocked0 : reg<test.explicit32> -> reg<test.i32>
  %blocked1_value = copy %blocked1 : reg<test.explicit32> -> reg<test.i32>
  %first_remat = test.const.explicit32 1
  %first_value = copy %first_remat : reg<test.explicit32> -> reg<test.i32>
  %second_remat = test.const.explicit32 2
  %second_value = copy %second_remat : reg<test.explicit32> -> reg<test.i32>
  return %needed_other_value, %needed_value, %blocked0_value, %blocked1_value, %first_value, %second_value, %state2
