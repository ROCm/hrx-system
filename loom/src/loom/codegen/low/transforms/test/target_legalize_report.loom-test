test.target<low_core> @test_target

// The scalar operations remain outside the applicable reference domains. The
// vector casts contribute rows so rejected native contracts remain visible.
func.def target(@test_target) @cast_reference_domains(%left: i32, %right: i32, %wide_left: i64, %wide_right: i64, %condition: i1, %other_condition: i1, %bytes: vector<4xi8>, %halfwords: vector<4xi16>) -> (i32, i64, i1, vector<4xi32>, vector<4xi32>) {
  %sum = scalar.addi %left, %right : i32
  %wide_sum = scalar.addi %wide_left, %wide_right : i64
  %predicate = scalar.andi %condition, %other_condition : i1
  %signed_values = vector.extsi %bytes : vector<4xi8> to vector<4xi32>
  %unsigned_values = vector.extui %halfwords : vector<4xi16> to vector<4xi32>
  func.return %sum, %wide_sum, %predicate, %signed_values, %unsigned_values : i32, i64, i1, vector<4xi32>, vector<4xi32>
}

