test.target<low_core> @test_target

// The combining vocabulary is one reference family. This report surface
// records selection without checking in the lane-by-lane reference IR.
func.def target(@test_target) @integer_combining_reference_family(%lhs: vector<2xi64>, %rhs: vector<2xi64>) -> (vector<2xi64>, vector<2xi64>, vector<2xi64>, vector<2xi64>, vector<2xi64>, vector<2xi64>, vector<2xi64>, vector<2xi64>, vector<2xi64>) {
  %sum = vector.addi %lhs, %rhs : vector<2xi64>
  %product = vector.muli %lhs, %rhs : vector<2xi64>
  %signed_minimum = vector.minsi %lhs, %rhs : vector<2xi64>
  %signed_maximum = vector.maxsi %lhs, %rhs : vector<2xi64>
  %unsigned_minimum = vector.minui %lhs, %rhs : vector<2xi64>
  %unsigned_maximum = vector.maxui %lhs, %rhs : vector<2xi64>
  %bitwise_and = vector.andi %lhs, %rhs : vector<2xi64>
  %bitwise_or = vector.ori %lhs, %rhs : vector<2xi64>
  %bitwise_xor = vector.xori %lhs, %rhs : vector<2xi64>
  func.return %sum, %product, %signed_minimum, %signed_maximum, %unsigned_minimum, %unsigned_maximum, %bitwise_and, %bitwise_or, %bitwise_xor : vector<2xi64>, vector<2xi64>, vector<2xi64>, vector<2xi64>, vector<2xi64>, vector<2xi64>, vector<2xi64>, vector<2xi64>, vector<2xi64>
}

func.def target(@test_target) @float_combining_reference_family(%lhs: vector<2xf64>, %rhs: vector<2xf64>) -> (vector<2xf64>, vector<2xf64>, vector<2xf64>, vector<2xf64>, vector<2xf64>, vector<2xf64>) {
  %sum = vector.addf %lhs, %rhs : vector<2xf64>
  %product = vector.mulf %lhs, %rhs : vector<2xf64>
  %minimum = vector.minimumf %lhs, %rhs : vector<2xf64>
  %maximum = vector.maximumf %lhs, %rhs : vector<2xf64>
  %min_number = vector.minnumf %lhs, %rhs : vector<2xf64>
  %max_number = vector.maxnumf %lhs, %rhs : vector<2xf64>
  func.return %sum, %product, %minimum, %maximum, %min_number, %max_number : vector<2xf64>, vector<2xf64>, vector<2xf64>, vector<2xf64>, vector<2xf64>, vector<2xf64>
}

