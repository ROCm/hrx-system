  %bound = index.assume %bound_value [range(%bound_value, 1, 32), eq(%bound_value, %equal), ne(%bound_value, %different), lt(%bound_value, %greater), le(%bound_value, %greater_equal), gt(%bound_value, %less), ge(%bound_value, %less_equal)] : offset
  %begin = index.constant 0 : offset
