// RUN: pass canonicalize

// A dynamic counted range owns both order relations. Aliases retain them,
// while the original bounds retain their independent outer-scope intervals.
func.def @counted_distances(%lower0: index, %upper0: index, %step0: index) {
  %lower = index.assume %lower0 [range(%lower0, 0, 10)] : index
  %upper = index.assume %upper0 [range(%upper0, 1, 10)] : index
  %step = index.assume %step0 [range(%step0, 1, 64)] : index
  scf.for %iv = [%lower to %upper step %step] {
    %alias, %end = index.assume %iv, %upper [] : index, index
    %remaining = index.sub %end, %alias : index
    %negative = index.sub %alias, %end : index
    %elapsed = index.sub %alias, %lower : index
    %remaining_lower = test.fact_range_lo %remaining : index -> i64
    %remaining_upper = test.fact_range_hi %remaining : index -> i64
    %negative_lower = test.fact_range_lo %negative : index -> i64
    %negative_upper = test.fact_range_hi %negative : index -> i64
    %elapsed_lower = test.fact_range_lo %elapsed : index -> i64
    %elapsed_upper = test.fact_range_hi %elapsed : index -> i64
    test.use %remaining_lower, %remaining_upper, %negative_lower, %negative_upper, %elapsed_lower, %elapsed_upper : i64, i64, i64, i64, i64, i64
  }
  %outside = index.sub %upper, %lower : index
  %outside_lower = test.fact_range_lo %outside : index -> i64
  test.use %outside_lower : i64
  func.return
}

// ----
func.def @counted_distances(%lower0: index, %upper0: index, %step0: index) {
  %lower = index.assume %lower0 [range(%lower0, 0, 10)] : index
  %upper = index.assume %upper0 [range(%upper0, 1, 10)] : index
  %step = index.assume %step0 [range(%step0, 1, 64)] : index
  scf.for %iv = [%lower to %upper step %step] {
    %remaining_lower = scalar.constant 1 : i64
    %remaining_upper = scalar.constant 10 : i64
    %negative_lower = scalar.constant -10 : i64
    %negative_upper = scalar.constant -1 : i64
    %elapsed_lower = scalar.constant 0 : i64
    %elapsed_upper = scalar.constant 9 : i64
    test.use %remaining_lower, %remaining_upper, %negative_lower, %negative_upper, %elapsed_lower, %elapsed_upper : i64, i64, i64, i64, i64, i64
  }
  %outside_lower = scalar.constant -9 : i64
  test.use %outside_lower : i64
  func.return
}

// ====

// Offset-domain loops publish the same ordering contract.
func.def @offset_distance(%lower0: offset, %upper0: offset) {
  %lower = index.assume %lower0 [range(%lower0, 0, 10)] : offset
  %upper = index.assume %upper0 [range(%upper0, 1, 10)] : offset
  %step = index.constant 4 : offset
  scf.for %iv = [%lower to %upper step %step] {
    %remaining = index.sub %upper, %iv : offset
    %remaining_lower = test.fact_range_lo %remaining : offset -> i64
    %remaining_upper = test.fact_range_hi %remaining : offset -> i64
    test.use %remaining_lower, %remaining_upper : i64, i64
  }
  func.return
}

// ----
func.def @offset_distance(%lower0: offset, %upper0: offset) {
  %lower = index.assume %lower0 [range(%lower0, 0, 10)] : offset
  %upper = index.assume %upper0 [range(%upper0, 1, 10)] : offset
  %step = index.constant 4 : offset
  scf.for %iv = [%lower to %upper step %step] {
    %remaining_lower = scalar.constant 1 : i64
    %remaining_upper = scalar.constant 10 : i64
    test.use %remaining_lower, %remaining_upper : i64, i64
  }
  func.return
}

// ====

// The order alone cannot prove the sign of an overflowing subtraction.
func.def @unbounded_distance(%lower: index, %upper: index) {
  %step = index.constant 1 : index
  scf.for %iv = [%lower to %upper step %step] {
    %remaining = index.sub %upper, %iv : index
    %negative = index.sub %iv, %upper : index
    %remaining_lower = test.fact_range_lo %remaining : index -> i64
    %remaining_upper = test.fact_range_hi %remaining : index -> i64
    %negative_lower = test.fact_range_lo %negative : index -> i64
    %negative_upper = test.fact_range_hi %negative : index -> i64
    test.use %remaining_lower, %remaining_upper, %negative_lower, %negative_upper : i64, i64, i64, i64
  }
  func.return
}

// ----
func.def @unbounded_distance(%lower: index, %upper: index) {
  %step = index.constant 1 : index
  scf.for %iv = [%lower to %upper step %step] {
    %remaining_lower = scalar.constant -9223372036854775808 : i64
    %remaining_upper = scalar.constant 9223372036854775807 : i64
    %negative_lower = scalar.constant -9223372036854775808 : i64
    %negative_upper = scalar.constant 9223372036854775807 : i64
    test.use %remaining_lower, %remaining_upper, %negative_lower, %negative_upper : i64, i64, i64, i64
  }
  func.return
}

// ====

// RUN: pass unroll-scf-for,canonicalize

// Unrolling exposes an impossible tail arm. Its unsigned guard can fold only
// when the remaining count retains the positive loop-body distance.
func.def @unrolled_tail(%input: buffer, %begin0: index, %end0: index) -> (f32) {
  %begin = index.assume %begin0 [range(%begin0, 0, 10)] : index
  %end = index.assume %end0 [range(%end0, 1, 10)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %packet_count = index.constant 2 : index
  %tile_rows = index.constant 16 : index
  %base = index.constant 0 : offset
  %view = buffer.view %input[%base] : buffer -> view<10xf32>
  %initial = scalar.constant 0.0 : f32
  %sum = scf.for %iv = [%begin to %end step %tile_rows](%sum0 = %initial : f32) -> (f32) {
    %remaining = index.sub %end, %iv : index
    %next = scf.for %packet = [%c0 to %packet_count step %c1](%sum1 = %sum0 : f32) -> (f32) unroll {
      %row = index.mul %packet, %tile_rows : index
      %valid = index.cmp ult, %row, %remaining : index
      %value = scf.if %valid -> (f32) {
        %position = index.add %iv, %row : index
        %loaded = view.load %view[%position] : view<10xf32> -> f32
        scf.yield %loaded : f32
      } else {
        scf.yield %initial : f32
      }
      %added = scalar.addf %sum1, %value : f32
      scf.yield %added : f32
    }
    scf.yield %next : f32
  }
  func.return %sum : f32
}

// ----
func.def @unrolled_tail(%input: buffer, %begin0: index, %end0: index) -> (f32) {
  %begin = index.assume %begin0 [range(%begin0, 0, 10)] : index
  %end = index.assume %end0 [range(%end0, 1, 10)] : index
  %tile_rows = index.constant 16 : index
  %base = index.constant 0 : offset
  %view = buffer.view %input[%base] : buffer -> view<10xf32>
  %initial = scalar.constant 0.0 : f32
  %sum = scf.for %iv = [%begin to %end step %tile_rows](%sum0 = %initial : f32) -> (f32) {
    %loaded = view.load %view[%iv] : view<10xf32> -> f32
    %added = scalar.addf %sum0, %loaded : f32
    %added_1 = scalar.addf %added, %initial : f32
    scf.yield %added_1 : f32
  }
  func.return %sum : f32
}
