// ====

// RUN: pass canonicalize

// Nested induction values inherit the outer endpoint's retained relations.
// Alias forwarding retains them; neither loop changes the ambient values.
func.def @nested_endpoint_aliases(%capacity_value: index, %count_value: index, %step_value: index) {
  %capacity = index.assume %capacity_value [range(%capacity_value, 2, 1024)] : index
  %count = index.assume %count_value [range(%count_value, 0, %capacity)] : index
  %end = index.assume %count [] : index
  %step = index.assume %step_value [range(%step_value, 1, 16)] : index
  %begin = index.constant 0 : index
  %stride = index.constant 1 : index
  scf.for %outer = [%begin to %end step %step] {
    %upper_alias = index.assume %outer [] : index
    scf.for %inner = [%begin to %upper_alias step %stride] {
      %alias = index.assume %inner [] : index
      %remaining = index.sub %capacity, %alias : index
      %minimum = test.fact_range_lo %remaining : index -> i64
      test.use %minimum : i64
    }
  }
  %outside = index.sub %capacity_value, %count_value : index
  %outside_minimum = test.fact_range_lo %outside : index -> i64
  test.use %outside_minimum : i64
  func.return
}
// ----
func.def @nested_endpoint_aliases(%capacity_value: index, %count_value: index, %step_value: index) {
  %capacity = index.assume %capacity_value [range(%capacity_value, 2, 1024)] : index
  %count = index.assume %count_value [range(%count_value, 0, %capacity)] : index
  %step = index.assume %step_value [range(%step_value, 1, 16)] : index
  %begin = index.constant 0 : index
  %stride = index.constant 1 : index
  scf.for %outer = [%begin to %count step %step] {
    scf.for %inner = [%begin to %outer step %stride] {
      %minimum = scalar.constant 1 : i64
      test.use %minimum : i64
    }
  }
  %outside_minimum = scalar.constant -9223372036854775808 : i64
  test.use %outside_minimum : i64
  func.return
}

// ====

// RUN: pass unroll-scf-for,canonicalize

// Unrolling exposes an impossible tail arm. Its unsigned guard can fold only
// when the remaining count retains the positive loop-body distance.
func.def @unrolled_tail(%input: buffer, %begin0: index, %end0: index) -> (f32) {
  %begin = index.assume %begin0 [range(%begin0, 0, 10)] : index
  %end = index.assume %end0 [range(%end0, 1, 10)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %packet_count = index.constant 2 : index
  %tile_rows = index.constant 16 : index
  %base = index.constant 0 : offset
  %view = buffer.view %input[%base] : buffer -> view<10xf32>
  %initial = scalar.constant 0.0 : f32
  %sum = scf.for %iv = [%begin to %end step %tile_rows](%sum0 = %initial : f32) -> (f32) {
    %remaining = index.sub %end, %iv : index
    %next = scf.for %packet = [%c0 to %packet_count step %c1](%sum1 = %sum0 : f32) -> (f32) unroll {
      %row = index.mul %packet, %tile_rows : index
      %valid = index.cmp ult, %row, %remaining : index
      %value = scf.if %valid -> (f32) {
        %position = index.add %iv, %row : index
        %loaded = view.load %view[%position] : view<10xf32> -> f32
        scf.yield %loaded : f32
      } else {
        scf.yield %initial : f32
      }
      %added = scalar.addf %sum1, %value : f32
      scf.yield %added : f32
    }
    scf.yield %next : f32
  }
  func.return %sum : f32
}

// ----
func.def @unrolled_tail(%input: buffer, %begin0: index, %end0: index) -> (f32) {
  %begin = index.assume %begin0 [range(%begin0, 0, 10)] : index
  %end = index.assume %end0 [range(%end0, 1, 10)] : index
  %tile_rows = index.constant 16 : index
  %base = index.constant 0 : offset
  %view = buffer.view %input[%base] : buffer -> view<10xf32>
  %initial = scalar.constant 0.0 : f32
  %sum = scf.for %iv = [%begin to %end step %tile_rows](%sum0 = %initial : f32) -> (f32) {
    %loaded = view.load %view[%iv] : view<10xf32> -> f32
    %added = scalar.addf %sum0, %loaded : f32
    %added_1 = scalar.addf %added, %initial : f32
    scf.yield %added_1 : f32
  }
  func.return %sum : f32
}
