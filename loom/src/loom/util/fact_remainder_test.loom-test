// RUN: pass canonicalize

// Every signed and unsigned remainder is below its positive runtime divisor.
// Keeping both quotients alive distinguishes the paired result roles.
func.def @remainder_bounds_i8(%input: i8, %divisor_input: i8) -> (i1, i1, i1, i1, i8, i8) {
  %divisor = scalar.assume %divisor_input [range(%divisor_input, 1, 127)] : i8
  %signed = scalar.remsi %input, %divisor : i8
  %unsigned = scalar.remui %input, %divisor : i8
  %signed_quotient, %signed_tail = scalar.divremsi %input, %divisor : i8
  %unsigned_quotient, %unsigned_tail = scalar.divremui %input, %divisor : i8
  %signed_below = scalar.cmpi slt, %signed, %divisor : i8
  %unsigned_below = scalar.cmpi slt, %unsigned, %divisor : i8
  %signed_pair_below = scalar.cmpi slt, %signed_tail, %divisor : i8
  %unsigned_pair_below = scalar.cmpi slt, %unsigned_tail, %divisor : i8
  func.return %signed_below, %unsigned_below, %signed_pair_below, %unsigned_pair_below, %signed_quotient, %unsigned_quotient : i1, i1, i1, i1, i8, i8
}

// ----
func.def @remainder_bounds_i8(%input: i8, %divisor_input: i8) -> (i1, i1, i1, i1, i8, i8) {
  %divisor = scalar.assume %divisor_input [range(%divisor_input, 1, 127)] : i8
  %signed_quotient = scalar.divsi %input, %divisor : i8
  %unsigned_quotient = scalar.divui %input, %divisor : i8
  %signed_below = scalar.constant true : i1
  %unsigned_below = scalar.constant true : i1
  %signed_pair_below = scalar.constant true : i1
  %unsigned_pair_below = scalar.constant true : i1
  func.return %signed_below, %unsigned_below, %signed_pair_below, %unsigned_pair_below, %signed_quotient, %unsigned_quotient : i1, i1, i1, i1, i8, i8
}

