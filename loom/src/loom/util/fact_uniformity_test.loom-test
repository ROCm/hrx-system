// Local agreement propagates through arithmetic; exit observations stay varying.
// RUN: pass canonicalize

target.generic<reference> @target {abi = hal_kernel, subgroup_size = 64}

kernel.def target(@target) @local_and_escaping() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%choice: i1) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %lane = kernel.subgroup.lane.id : index
  %word = index.cast %lane : index to i32
  %increment = scalar.constant 7 : i32
  cfg.br ^header(%begin: index)
^header(%counter: index):
  %observed = kernel.subgroup.broadcast.first %word : i32
  %derived = scalar.addi %observed, %increment : i32
  %local = test.fact_observation_scope %observed : i32 -> i32
  %composed = test.fact_observation_scope %derived : i32 -> i32
  %global = test.fact_subgroup_uniform %derived : i32 -> i1
  test.use %local, %composed, %global : i32, i32, i1
  %more = index.cmp ult, %counter, %lane : index
  cfg.cond_br %more, ^body, ^exit
^body:
  %body_scope = test.fact_observation_scope %derived : i32 -> i32
  test.use %body_scope : i32
  %next = index.add %counter, %step : index
  cfg.br ^header(%next: index)
^exit:
  %escaping = test.fact_observation_scope %observed : i32 -> i32
  %escaping_expression = test.fact_observation_scope %derived : i32 -> i32
  test.use %escaping, %escaping_expression : i32, i32
  kernel.return
}

// ----
target.generic<reference> @target {abi = hal_kernel, subgroup_size = 64}

kernel.def target(@target) @local_and_escaping() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%choice: i1) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %lane = kernel.subgroup.lane.id : index
  %word = index.cast %lane : index to i32
  cfg.br ^header(%begin: index)
^header(%counter: index):
  %observed = kernel.subgroup.broadcast.first %word : i32
  %local = scalar.constant 1 : i32
  %composed = scalar.constant 1 : i32
  %global = scalar.constant false : i1
  test.use %local, %composed, %global : i32, i32, i1
  %more = index.cmp ult, %counter, %lane : index
  cfg.cond_br %more, ^body, ^exit
^body:
  %body_scope = scalar.constant 1 : i32
  test.use %body_scope : i32
  %next = index.add %counter, %step : index
  cfg.br ^header(%next: index)
^exit:
  %escaping = scalar.constant 0 : i32
  %escaping_expression = scalar.constant 0 : i32
  test.use %escaping, %escaping_expression : i32, i32
  kernel.return
}

// ====

// Dominated branch uses stay in the definition iteration, including two latches.
// RUN: pass canonicalize

target.generic<reference> @target {abi = hal_kernel, subgroup_size = 64}

kernel.def target(@target) @branch_observation() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%choice: i1) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %lane = kernel.subgroup.lane.id : index
  %word = index.cast %lane : index to i32
  cfg.br ^header(%begin: index)
^header(%counter: index):
  %observed = kernel.subgroup.broadcast.first %word : i32
  %more = index.cmp ult, %counter, %lane : index
  cfg.cond_br %more, ^dispatch, ^exit
^dispatch:
  cfg.cond_br %choice, ^left, ^right
^left:
  %left_scope = test.fact_observation_scope %observed : i32 -> i32
  test.use %left_scope : i32
  %left_next = index.add %counter, %step : index
  cfg.br ^header(%left_next: index)
^right:
  %right_scope = test.fact_observation_scope %observed : i32 -> i32
  test.use %right_scope : i32
  %right_next = index.add %counter, %step : index
  cfg.br ^header(%right_next: index)
^exit:
  %exit_scope = test.fact_observation_scope %observed : i32 -> i32
  test.use %exit_scope : i32
  kernel.return
}

