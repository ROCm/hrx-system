load("//build_tools/bazel:query.bzl", "iree_assert_dependency_boundary")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

# The compiler produces these bytes; independent runtimes consume them without
# retaining compiler IR, source, or process state.
loom_cc_library(
    name = "program",
    srcs = [
        "format.c",
        "program.c",
    ],
    hdrs = [
        "format.h",
        "program.h",
    ],
    tags = ["LINKABLE_MORE_THAN_ONCE"],
    visibility = ["//visibility:public"],
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/base:core_headers",
    ],
)

loom_cc_library(
    name = "hal_command_buffer",
    srcs = ["hal_command_buffer.c"],
    hdrs = ["hal_command_buffer.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":program",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base:core_headers",
        "//runtime/src/iree/hal",
    ],
)

iree_assert_dependency_boundary(
    name = "command_runtime_is_independent",
    forbidden_subtrees = [
        "//loom/binding/...",
        "//loom/src/loom/ir/...",
        "//loom/src/loom/serve/...",
        "//loom/src/loom/service/...",
        "//loom/src/loom/target/...",
    ],
    message = "Command artifact loading and HAL materialization must not depend on the compiler, server, or services",
    target = ":hal_command_buffer",
)

loom_cc_test(
    name = "program_test",
    srcs = ["program_test.cc"],
    deps = [
        ":program",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base:core_headers",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
