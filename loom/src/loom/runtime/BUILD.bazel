load("//build_tools/bazel:query.bzl", "iree_assert_dependency_boundary")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

loom_cc_library(
    name = "wake",
    hdrs = ["wake.h"],
    visibility = ["//visibility:public"],
)

loom_cc_library(
    name = "service",
    hdrs = ["service.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":wake",
        "//runtime/src/iree/base",
    ],
)

iree_assert_dependency_boundary(
    name = "service_progress_is_runtime_only",
    forbidden_subtrees = [
        "//loom/binding/...",
        "//loom/src/loom/serve/...",
        "//loom/src/loom/service/...",
        "//loom/src/loom/target/...",
    ],
    message = "Service progress must not depend on transports, modalities, or compiler implementation",
    target = ":service",
)

loom_cc_library(
    name = "driver",
    srcs = ["driver.c"],
    hdrs = ["driver.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":service",
        ":wake",
        "//runtime/src/iree/base",
    ],
)

loom_cc_test(
    name = "driver_test",
    srcs = ["driver_test.cc"],
    deps = [
        ":driver",
        ":service",
        ":wake",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

iree_assert_dependency_boundary(
    name = "driver_is_runtime_only",
    forbidden_subtrees = [
        "//loom/binding/...",
        "//loom/src/loom/serve/...",
        "//loom/src/loom/service/...",
        "//loom/src/loom/target/...",
    ],
    message = "The service driver must not depend on a catalogue, transport, modality, or compiler implementation",
    target = ":driver",
)
