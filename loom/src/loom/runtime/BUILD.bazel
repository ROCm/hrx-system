load("//build_tools/bazel:query.bzl", "iree_assert_dependency_boundary")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

loom_cc_library(
    name = "wake",
    hdrs = ["wake.h"],
    visibility = ["//visibility:public"],
)

loom_cc_library(
    name = "service",
    hdrs = ["service.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":wake",
        "//runtime/src/iree/base",
    ],
)

iree_assert_dependency_boundary(
    name = "service_progress_is_runtime_only",
    forbidden_subtrees = [
        "//loom/binding/...",
        "//loom/src/loom/serve/...",
        "//loom/src/loom/service/...",
        "//loom/src/loom/target/...",
    ],
    message = "Service progress must not depend on transports, modalities, or compiler implementation",
    target = ":service",
)
