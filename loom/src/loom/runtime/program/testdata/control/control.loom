func.decl import("runner") @execute_3(%stage: i32, %control: hal.buffer, %tokens: hal.buffer, %progress: hal.buffer) -> (i64)

func.decl import("runner") @feedback(%slot: i32, %source: hal.buffer, %offset: i64, %length: i64) -> (i64)

func.decl import("runner") @fence(%work: i64) -> (hal.fence)

func.decl import("runner") @join(%ready: hal.fence)

// This model entry selects prepared stages without owning per-session state.
// Its result is an accepted submission on the hosting runner's execution domain.
func.def public @step(%initialize: i32, %control: hal.buffer, %tokens: hal.buffer, %progress: hal.buffer) -> (i64) {
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %is_prefill = scalar.cmpi ne, %initialize, %c0 : i32
  %completion = scf.if %is_prefill -> (i64) {
    %prefill = func.call @execute_3(%c0, %control, %tokens, %progress) : (i32, hal.buffer, hal.buffer, hal.buffer) -> (i64)
    scf.yield %prefill : i64
  } else {
    %decode = func.call @execute_3(%c1, %control, %tokens, %progress) : (i32, hal.buffer, hal.buffer, hal.buffer) -> (i64)
    scf.yield %decode : i64
  }
  func.return %completion : i64
}

// The source owns the same producer/feedback/independent-work fork as packed
// inference. An invalid final stage exercises failure after both submissions.
func.def public @fork(%next_stage: i32, %control: hal.buffer, %tokens: hal.buffer, %progress: hal.buffer, %next_control: hal.buffer, %next_tokens: hal.buffer, %next_progress: hal.buffer) -> (i64) {
  %c0 = scalar.constant 0 : i32
  %offset = scalar.constant 0 : i64
  %length = scalar.constant 516 : i64
  %producer = func.call @execute_3(%c0, %control, %tokens, %progress) : (i32, hal.buffer, hal.buffer, hal.buffer) -> (i64)
  %download = func.call @feedback(%c0, %tokens, %offset, %length) : (i32, hal.buffer, i64, i64) -> (i64)
  %next = func.call @execute_3(%next_stage, %next_control, %next_tokens, %next_progress) : (i32, hal.buffer, hal.buffer, hal.buffer) -> (i64)
  func.return %next : i64
}

// Export the producer before importing an independent, delayed completion.
// A caller can consume the first result while the second stage remains gated.
func.def public @dependencies(%ready: hal.fence, %control: hal.buffer, %tokens: hal.buffer, %progress: hal.buffer, %next_control: hal.buffer, %next_tokens: hal.buffer, %next_progress: hal.buffer) -> (hal.fence) {
  %c0 = scalar.constant 0 : i32
  %producer = func.call @execute_3(%c0, %control, %tokens, %progress) : (i32, hal.buffer, hal.buffer, hal.buffer) -> (i64)
  %produced = func.call @fence(%producer) : (i64) -> (hal.fence)
  func.call @join(%ready) : (hal.fence)
  %next = func.call @execute_3(%c0, %next_control, %next_tokens, %next_progress) : (i32, hal.buffer, hal.buffer, hal.buffer) -> (i64)
  func.return %produced : hal.fence
}
