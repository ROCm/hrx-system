type.decl import("hal", "buffer") @HalBuffer

func.decl @dispatch_step(%stage: i32, %storage: ptr<@HalBuffer>) -> (i64)

func.def public @step(%stage: i32, %storage: ptr<@HalBuffer>) -> (i64) {
  %completion = func.call @dispatch_step(%stage, %storage) : (i32, ptr<@HalBuffer>) -> (i64)
  func.return %completion : i64
}
