template.decl pure @first_stage() -> (i32)

func.decl @submit_step(%stage: i32, %storage: hal.buffer) -> (i64)

func.def public @step(%storage: hal.buffer) -> (i64) {
  %c0 = template.apply<@first_stage>() pure : () -> (i32)
  %completion = func.call @submit_step(%c0, %storage) : (i32, hal.buffer) -> (i64)
  func.return %completion : i64
}

func.def public @selected_step(%stage: i32, %storage: hal.buffer) -> (i64) {
  %completion = func.call @submit_step(%stage, %storage) : (i32, hal.buffer) -> (i64)
  func.return %completion : i64
}
