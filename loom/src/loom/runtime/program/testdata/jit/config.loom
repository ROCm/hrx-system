config.def @increment.delta = 5 : index

config.def @increment.groups = 2 : index

config.def @increment.temporary_bytes = 64 : offset

// The catalog encounters declarations before the implementation provider.
command.decl @advance() launch(%storage: buffer)

command.decl @idle() launch()

command.decl @missing() launch()

command.def public @ambiguous() launch() {
  command.return
}

func.def public @not_command() {
  func.return
}
