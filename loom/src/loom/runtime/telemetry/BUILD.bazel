load("//build_tools/bazel:query.bzl", "iree_assert_dependency_boundary")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

loom_cc_library(
    name = "sample",
    hdrs = ["sample.h"],
    visibility = ["//visibility:public"],
    deps = ["//runtime/src/iree/base"],
)

loom_cc_library(
    name = "pool",
    srcs = ["pool.c"],
    hdrs = ["pool.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":sample",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
    ],
)

iree_assert_dependency_boundary(
    name = "sampling_is_runtime_only",
    forbidden_subtrees = [
        "//loom/binding/...",
        "//loom/src/loom/serve/...",
        "//loom/src/loom/service/...",
        "//loom/src/loom/target/...",
    ],
    message = "Runtime telemetry sampling must not depend on serving, services, or compiler implementation",
    target = ":pool",
)

loom_cc_test(
    name = "pool_test",
    srcs = ["pool_test.cc"],
    deps = [
        ":pool",
        ":sample",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
