load("//build_tools/bazel:query.bzl", "iree_assert_dependency_boundary")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

loom_cc_library(
    name = "sample",
    hdrs = ["sample.h"],
    visibility = ["//visibility:public"],
    deps = ["//runtime/src/iree/base"],
)

loom_cc_library(
    name = "field",
    hdrs = ["field.h"],
    visibility = ["//visibility:public"],
    deps = ["//runtime/src/iree/base"],
)

_DOMAIN_SUBTREES = [
    "//loom/binding/...",
    "//loom/src/loom/runtime/parameter/...",
    "//loom/src/loom/runtime/storage/...",
    "//loom/src/loom/serve/...",
    "//loom/src/loom/service/...",
    "//loom/src/loom/target/...",
]

iree_assert_dependency_boundary(
    name = "sampling_is_runtime_only",
    forbidden_subtrees = _DOMAIN_SUBTREES,
    message = "Generic telemetry contracts must not depend on domain schemas, serving, services, or compiler implementation",
    target = ":sample",
)

iree_assert_dependency_boundary(
    name = "fields_are_runtime_only",
    forbidden_subtrees = _DOMAIN_SUBTREES,
    message = "Generic telemetry fields must not depend on domain schemas, serving, services, or compiler implementation",
    target = ":field",
)

loom_cc_library(
    name = "record",
    hdrs = ["record.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":field",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "stream",
    srcs = ["stream.c"],
    hdrs = ["stream.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":record",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal",
    ],
)

loom_cc_test(
    name = "stream_test",
    srcs = ["stream_test.cc"],
    deps = [
        ":stream",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

iree_assert_dependency_boundary(
    name = "record_is_runtime_only",
    forbidden_subtrees = _DOMAIN_SUBTREES,
    message = "Generic telemetry must not depend on concrete domains or serving",
    target = ":record",
)

iree_assert_dependency_boundary(
    name = "stream_is_runtime_only",
    forbidden_subtrees = _DOMAIN_SUBTREES,
    message = "Generic telemetry must not depend on concrete domains or serving",
    target = ":stream",
)
