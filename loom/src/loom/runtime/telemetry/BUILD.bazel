load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

loom_cc_library(
    name = "sample",
    hdrs = ["sample.h"],
    visibility = ["//visibility:public"],
    deps = ["//runtime/src/iree/base"],
)

loom_cc_library(
    name = "field",
    hdrs = ["field.h"],
    visibility = ["//visibility:public"],
    deps = ["//runtime/src/iree/base"],
)

loom_cc_library(
    name = "record",
    hdrs = ["record.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":field",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "stream",
    srcs = ["stream.c"],
    hdrs = ["stream.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":record",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal",
    ],
)

loom_cc_test(
    name = "stream_test",
    srcs = ["stream_test.cc"],
    deps = [
        ":stream",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
