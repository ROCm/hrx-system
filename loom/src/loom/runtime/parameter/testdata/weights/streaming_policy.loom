func.decl import("weights") @input(%source: i32, %key: buffer, %key_offset: i64, %key_length: i64, %offset: i64, %length: i64, %alignment: i64) -> (i64)

func.decl import("prepare") @stage(%root: buffer, %tag: i64) -> (i32)

func.decl import("prepare") @config_i64(%stage: i32, %key: buffer, %value: i64)

// Capture a half as many independent ranges so activation must refill its
// bounded submission windows before the final preparation can run.
func.def @capture_half(%source: i32, %key: buffer, %key_length: i64, %base: i64, %alignment: i64) -> (i64) {
  %c0 = scalar.constant 0 : i64
  %chunk = scalar.constant 4096 : i64
  %first = func.call @input(%source, %key, %c0, %key_length, %base, %chunk, %alignment) : (i32, buffer, i64, i64, i64, i64, i64) -> (i64)
  %begin = index.constant 1 : index
  %end = index.constant 256 : index
  %step = index.constant 1 : index
  %word_alignment = scalar.constant 4 : i64
  scf.for %i = [%begin to %end step %step] {
    %ordinal = index.cast %i : index to i64
    %relative = scalar.muli %ordinal, %chunk : i64
    %offset = scalar.addi %base, %relative : i64
    %ignored = func.call @input(%source, %key, %c0, %key_length, %offset, %chunk, %word_alignment) : (i32, buffer, i64, i64, i64, i64, i64) -> (i64)
  }
  %tail_offset = scalar.constant 1048576 : i64
  %tail_length = scalar.constant 16 : i64
  %offset = scalar.addi %base, %tail_offset : i64
  %ignored = func.call @input(%source, %key, %c0, %key_length, %offset, %tail_length, %word_alignment) : (i32, buffer, i64, i64, i64, i64, i64) -> (i64)
  func.return %first : i64
}

func.def public @prepare_weight(%key: buffer) -> (i64) {
  %origin = index.constant 0 : offset
  %letter = buffer.load.i8.u %key[%origin]
  %w = scalar.constant 119 : i32
  %wide = scalar.cmpi eq, %letter, %w : i32
  %c0 = scalar.constant 0 : i64
  %key_extent = buffer.length %key
  %key_length = index.cast %key_extent : offset to i64
  %bytes = scf.if %wide -> (i64) {
    %first_source = scalar.constant 0 : i32
    %second_source = scalar.constant 1 : i32
    %half = scalar.constant 1048592 : i64
    %alignment = scalar.constant 64 : i64
    %first = func.call @capture_half(%first_source, %key, %key_length, %c0, %alignment) : (i32, buffer, i64, i64, i64) -> (i64)
    %second = func.call @capture_half(%second_source, %key, %key_length, %half, %alignment) : (i32, buffer, i64, i64, i64) -> (i64)
    %root = buffer.constant utf8("combine_wide") : buffer
    %stage = func.call @stage(%root, %c0) : (buffer, i64) -> (i32)
    %first_key = buffer.constant utf8("wide_first_offset") : buffer
    %second_key = buffer.constant utf8("wide_second_offset") : buffer
    func.call @config_i64(%stage, %first_key, %first) : (i32, buffer, i64)
    func.call @config_i64(%stage, %second_key, %second) : (i32, buffer, i64)
    %bytes = scalar.constant 2097184 : i64
    scf.yield %bytes : i64
  } else {
    // Direct ranges and staged transforms share the same mapped windows.
    %source = scalar.constant 0 : i32
    %length = scalar.constant 32 : i64
    %alignment = scalar.constant 4 : i64
    %offset = func.call @input(%source, %key, %c0, %key_length, %c0, %length, %alignment) : (i32, buffer, i64, i64, i64, i64, i64) -> (i64)
    scf.yield %length : i64
  }
  func.return %bytes : i64
}
