load("//build_tools/bazel:query.bzl", "iree_assert_dependency_boundary")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

loom_cc_library(
    name = "activity",
    hdrs = ["activity.h"],
    visibility = ["//visibility:public"],
    deps = ["//runtime/src/iree/base"],
)

loom_cc_library(
    name = "telemetry",
    srcs = ["telemetry.c"],
    hdrs = ["telemetry.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":activity",
        "//loom/src/loom/runtime/telemetry:field",
        "//loom/src/loom/runtime/telemetry:stream",
        "//runtime/src/iree/base",
    ],
)

iree_assert_dependency_boundary(
    name = "telemetry_is_parameter_only",
    forbidden_subtrees = [
        "//loom/binding/...",
        "//loom/src/loom/runtime/storage/...",
        "//loom/src/loom/serve/...",
        "//loom/src/loom/service/...",
        "//loom/src/loom/target/...",
    ],
    message = "Parameter telemetry must not import storage telemetry, serving, services, or compiler implementation",
    target = ":telemetry",
)

loom_cc_test(
    name = "telemetry_test",
    srcs = ["telemetry_test.cc"],
    deps = [
        ":telemetry",
        "//loom/src/loom/runtime/telemetry:stream",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
