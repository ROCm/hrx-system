load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test")

package(
    default_visibility = ["//loom/src/loom/runtime:__subpackages__"],
    features = ["layering_check"],
    licenses = ["notice"],
)

loom_cc_library(
    name = "clock",
    srcs = ["clock.c"],
    hdrs = ["clock.h"],
    visibility = ["//visibility:public"],
    deps = ["//runtime/src/iree/base"],
)

loom_cc_library(
    name = "host",
    srcs = ["host.c"],
    hdrs = ["host.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//loom/binding/c:loomc",
        "//loom/binding/c:task_pool",
        "//loom/binding/c:task_queue",
        "//loom/binding/c/target/vm",
        "//loom/src/loom/runtime:wake",
        "//loom/src/loom/runtime/execution:plan",
        "//loom/src/loom/runtime/program:native_artifact",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/async/util:proactor_thread",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/driver/task:driver",
        "//runtime/src/iree/hal/driver/task/executable:loader",
        "//runtime/src/iree/hal/driver/task/executable/loaders/registration",
        "//runtime/src/iree/task",
    ],
)

loom_cc_test(
    name = "host_test",
    srcs = ["host_test.cc"],
    deps = [
        ":host",
        "//loom/binding/c:task_pool",
        "//loom/src/loom/runtime/execution:plan",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/task",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "timer",
    srcs = ["timer.c"],
    hdrs = ["timer.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//loom/src/loom/runtime:wake",
        "//runtime/src/iree/async",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
    ],
)

loom_cc_test(
    name = "timer_test",
    srcs = ["timer_test.cc"],
    deps = [
        ":timer",
        "//runtime/src/iree/async",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "readiness",
    srcs = ["readiness.c"],
    hdrs = ["readiness.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//loom/src/loom/runtime:wake",
        "//runtime/src/iree/async",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/task",
    ],
)

loom_cc_library(
    name = "reclamation",
    srcs = ["reclamation.c"],
    hdrs = ["reclamation.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":host",
        ":readiness",
        ":timer",
        "//loom/src/loom/runtime:wake",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/base",
    ],
)

loom_cc_test(
    name = "reclamation_test",
    srcs = ["reclamation_test.cc"],
    deps = [
        ":host",
        ":readiness",
        ":reclamation",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
