load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_cc_library(
    name = "verify",
    srcs = [
        "verify.c",
        "verify_constraints.c",
        "verify_consumption.c",
        "verify_diagnostics.c",
        "verify_ownership.c",
        "verify_state.c",
        "verify_structure.c",
        "verify_value_types.c",
    ],
    hdrs = [
        "verify.h",
        "verify_constraints.h",
        "verify_consumption.h",
        "verify_diagnostics.h",
        "verify_ownership.h",
        "verify_state.h",
        "verify_structure.h",
        "verify_value_types.h",
    ],
    deps = [
        "//loom/src/loom/analysis:ownership",
        "//loom/src/loom/analysis:value_relation",
        "//loom/src/loom/error:diagnostic",
        "//loom/src/loom/error:emitter",
        "//loom/src/loom/error:error_defs",
        "//loom/src/loom/error:renderer",
        "//loom/src/loom/error:source",
        "//loom/src/loom/format/text:printer",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:callable_effects",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/ops:special_values",
        "//loom/src/loom/target:registers",
        "//loom/src/loom/util:adaptive_sort",
        "//loom/src/loom/util:cfg_dominance",
        "//loom/src/loom/util:cfg_graph",
        "//loom/src/loom/util:segmented_storage",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
    ],
)

