load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_library",
    "loom_cc_test",
)

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_cc_library(
    name = "plan",
    srcs = ["plan.c"],
    hdrs = ["plan.h"],
    deps = [
        "//loom/src/loom/ir:builders",
        "//loom/src/loom/ops:headers",
        "//loom/src/loom/tooling/testbench:api",
        "//loom/src/loom/tooling/testbench:operation_plan",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
    ],
)

loom_cc_library(
    name = "entropy",
    srcs = ["entropy.c"],
    hdrs = ["entropy.h"],
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal",
    ],
)

loom_cc_library(
    name = "values",
    srcs = ["values.c"],
    hdrs = ["values.h"],
    deps = [
        ":entropy",
        "//loom/src/loom/tooling/testbench",
        "//loom/src/loom/tooling/testbench:invocation",
        "//loom/src/loom/tooling/testbench:value_materializer",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "executor",
    srcs = ["executor.c"],
    hdrs = ["executor.h"],
    deps = [
        ":values",
        "//loom/src/loom/tooling/execution:benchmark",
        "//loom/src/loom/tooling/testbench",
        "//loom/src/loom/tooling/testbench:device_event",
        "//loom/src/loom/tooling/testbench:expectation",
        "//loom/src/loom/tooling/testbench:source_report",
        "//loom/src/loom/tooling/testbench:value_materializer",
        "//loom/src/loom/util:adaptive_sort",
        "//loom/src/loom/util:json",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/base",
    ],
)

loom_cc_test(
    name = "values_test",
    srcs = ["values_test.cc"],
    deps = [
        ":entropy",
        ":values",
        "//loom/src/loom/format/text:parser",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops/check",
        "//loom/src/loom/ops/test",
        "//loom/src/loom/tooling/testbench",
        "//loom/src/loom/tooling/testbench:expectation",
        "//loom/src/loom/tooling/testbench:value_materializer",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/memory:heap_pool",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_test(
    name = "executor_test",
    srcs = ["executor_test.cc"],
    deps = [
        ":entropy",
        ":executor",
        ":values",
        "//loom/src/loom/format/text:parser",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops/check",
        "//loom/src/loom/ops/test",
        "//loom/src/loom/tooling/testbench",
        "//loom/src/loom/tooling/testbench:value_materializer",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/memory:heap_pool",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
