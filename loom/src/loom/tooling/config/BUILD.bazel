load("//build_tools/bazel:query.bzl", "iree_assert_dependency_boundary")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_cc_library(
    name = "input",
    srcs = ["input.c"],
    hdrs = ["input.h"],
    deps = [
        "//loom/src/loom/config:text_binding",
        "//loom/src/loom/tooling/io:file",
        "//runtime/src/iree/base",
    ],
)

loom_cc_test(
    name = "input_test",
    srcs = ["input_test.cc"],
    deps = [
        ":input",
        "//runtime/src/iree/base",
        "//runtime/src/iree/io:file_handle",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
        "//runtime/src/iree/testing:temp_file",
    ],
)

iree_assert_dependency_boundary(
    name = "input_has_no_compiler_dependencies",
    forbidden_subtrees = [
        "//loom/binding/...",
        "//loom/src/loom/format/...",
        "//loom/src/loom/ir/...",
        "//loom/src/loom/ops/...",
        "//loom/src/loom/pass/...",
        "//loom/src/loom/target/...",
    ],
    message = "Configuration input collection must remain independent of compiler IR and schema reporting",
    target = ":input",
)
