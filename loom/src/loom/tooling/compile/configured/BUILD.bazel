load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "iree_select",
    "loom_cc_library",
    "loom_cc_test",
)

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_CONFIGURED_PRODUCT_COPTS = (
    iree_select({
        "//loom/config/target:amdgpu_artifacts": [
            "-DLOOM_CONFIG_PRODUCT_HAVE_AMDGPU_HSACO=1",
        ],
        "//conditions:default": [],
    }) +
    iree_select({
        "//loom/config/target:spirv_artifacts": [
            "-DLOOM_CONFIG_PRODUCT_HAVE_SPIRV_BINARY=1",
        ],
        "//conditions:default": [],
    }) +
    iree_select({
        "//loom/config/target:xdna_artifacts": [
            "-DLOOM_CONFIG_PRODUCT_HAVE_XDNA=1",
        ],
        "//conditions:default": [],
    })
)

_CONFIGURED_PRODUCT_DEPS = (
    iree_select({
        "//loom/config/target:amdgpu_artifacts": [
            "//loom/src/loom/tooling/target/amdgpu:product_provider",
        ],
        "//conditions:default": [],
    }) +
    iree_select({
        "//loom/config/target:spirv_artifacts": [
            "//loom/src/loom/tooling/target/spirv:product_provider",
        ],
        "//conditions:default": [],
    }) +
    iree_select({
        "//loom/config/target:xdna_artifacts": [
            "//loom/src/loom/tooling/target/amd/xdna:product_provider",
        ],
        "//conditions:default": [],
    })
)

_CONFIGURED_EMITTER_COPTS = (
    iree_select({
        "//loom/config/target:llvmir_artifacts": [
            "-DLOOM_CONFIG_EMITTER_HAVE_LLVMIR=1",
        ],
        "//conditions:default": [],
    }) +
    iree_select({
        "//loom/config/target:llvmir_amdgpu_target_env": [
            "-DLOOM_CONFIG_EMITTER_HAVE_LLVMIR_AMDGPU=1",
        ],
        "//conditions:default": [],
    }) +
    iree_select({
        "//loom/config/target:llvmir_x86_target_env": [
            "-DLOOM_CONFIG_EMITTER_HAVE_LLVMIR_X86=1",
        ],
        "//conditions:default": [],
    })
)

_CONFIGURED_EMITTER_DEPS = (
    iree_select({
        "//loom/config/target:llvmir_artifacts": [
            "//loom/src/loom/target/emit/llvmir:artifact_emitter",
        ],
        "//conditions:default": [],
    }) +
    iree_select({
        "//loom/config/target:llvmir_amdgpu_target_env": [
            "//loom/src/loom/target/emit/llvmir/amdgpu:target_env",
        ],
        "//conditions:default": [],
    }) +
    iree_select({
        "//loom/config/target:llvmir_x86_target_env": [
            "//loom/src/loom/target/emit/llvmir/x86:target_env",
        ],
        "//conditions:default": [],
    })
)

loom_cc_library(
    name = "emitter",
    srcs = ["emitter.c"],
    hdrs = ["emitter.h"],
    copts = _CONFIGURED_EMITTER_COPTS,
    visibility = ["//loom/src/loom/tools:__subpackages__"],
    deps = [
        "//loom/src/loom/target:provider",
        "//runtime/src/iree/base",
    ] + _CONFIGURED_EMITTER_DEPS,
)

loom_cc_library(
    name = "registry",
    srcs = ["registry.c"],
    hdrs = ["registry.h"],
    copts = _CONFIGURED_PRODUCT_COPTS,
    visibility = ["//loom/src/loom/tools:__subpackages__"],
    deps = [
        "//loom/src/loom/product:kernel",
        "//loom/src/loom/product:registry",
        "//loom/src/loom/target/arch/cmd:product",
        "//loom/src/loom/tooling/target/cmd:product_provider",
        "//runtime/src/iree/base",
    ] + _CONFIGURED_PRODUCT_DEPS,
)

loom_cc_test(
    name = "registry_test",
    srcs = ["registry_test.cc"],
    copts = _CONFIGURED_PRODUCT_COPTS,
    deps = [
        ":registry",
        "//loom/src/loom/product:kernel",
        "//loom/src/loom/target/arch/cmd:product",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ] + _CONFIGURED_PRODUCT_DEPS,
)
