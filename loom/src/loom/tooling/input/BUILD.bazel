load("//loom/build_tools/bazel:build_defs.bzl", "iree_select", "loom_cc_library", "loom_cc_test")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],
)

exports_files(["testdata/duplicate_symbols.loom-test"])

loom_cc_library(
    name = "format",
    srcs = ["format.c"],
    hdrs = ["format.h"],
    deps = [
        "//loom/src/loom/tooling/io:source_path",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:path",
    ],
)

loom_cc_library(
    name = "input",
    srcs = ["input.c"],
    hdrs = ["input.h"],
    deps = [
        ":format",
        "//loom/src/loom/error:diagnostic",
        "//loom/src/loom/error:source",
        "//loom/src/loom/format:low_repr",
        "//loom/src/loom/format/bytecode:reader",
        "//loom/src/loom/format/text:parser",
        "//loom/src/loom/ir",
        "//loom/src/loom/tooling/io:source_path",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
    ],
)

loom_cc_library(
    name = "flags",
    srcs = ["flags.c"],
    hdrs = ["flags.h"],
    deps = [
        ":format",
        "//runtime/src/iree/base/tooling:flags",
    ],
)

loom_cc_library(
    name = "loomc",
    srcs = ["loomc.c"],
    hdrs = ["loomc.h"],
    deps = [
        ":format",
        "//loom/binding/c:loomc",
        "//loom/src/loom/tooling/io:file",
        "//loom/src/loom/tooling/io:source_path",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
    ],
)

loom_cc_library(
    name = "loomc_configured",
    srcs = ["loomc_configured.c"],
    hdrs = ["loomc_configured.h"],
    defines = iree_select({
        "//loom/config/import:cxx": ["LOOM_TOOLING_INPUT_LOOMC_CONFIGURED_HAVE_CXX=1"],
        "//conditions:default": [],
    }),
    deps = [":loomc"] + iree_select({
        "//loom/config/import:cxx": [
            "//loom/src/loom/import/cxx/tooling:loomc_input",
            "//loom/src/loom/import/cxx/tooling:options",
            "//runtime/src/iree/base",
        ],
        "//conditions:default": [],
    }),
)

loom_cc_test(
    name = "format_test",
    srcs = ["format_test.cc"],
    deps = [
        ":format",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_test(
    name = "input_test",
    srcs = ["input_test.cc"],
    deps = [
        ":input",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:op_registry",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
