load("//build_tools/bazel:test_resources.bzl", "GPU_DEVICE_RESOURCE_GROUP")
load("//build_tools/testing:build_defs.bzl", "iree_execution_test_suite")
load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_config_compatible_with",
)
load("//loom/build_tools/bazel:loom_check.bzl", "loom_check_test")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_XDNA_COMPILE_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/target:xdna_artifacts",
])

iree_execution_test_suite(
    name = "loom_opt_trace",
    data = ["test/resident_publication.loom"],
    manifests = ["test/loom-opt.test.json"],
    tags = ["hostonly"],
    target_compatible_with = _XDNA_COMPILE_COMPATIBLE_WITH,
    tools = {
        "loom-opt": "//loom/src/loom/tools/loom-opt",
    },
)

iree_execution_test_suite(
    name = "hal_execution_test",
    data = ["test/hal_execution.loom"],
    manifests = ["test/hal_execution.test.json"],
    resource_group = GPU_DEVICE_RESOURCE_GROUP,
    tags = [
        "iree-run-requirement=libamdf.resource.xdna",
        "runtime-resource=amd-xdna",
    ],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/execute:xdna_hal",
        "//loom/config/target/arch:vm",
    ]),
    tools = {"iree-test-loom": "//loom/src/loom/tools/iree-test-loom"},
)

loom_check_test(
    name = "assembly_lowering",
    src = "test/assembly.cxx-test",
    runner = "//loom/src/loom/tools/loom-check",
    target_compatible_with = _XDNA_COMPILE_COMPATIBLE_WITH + loom_config_compatible_with(["//loom/config/import:cxx"]),
)

loom_check_test(
    name = "boolean_storage_lowering",
    src = "test/boolean_storage.cxx-test",
    data = ["//loom/src/loom/import/cxx/test:boolean_storage.cxx"],
    runner = "//loom/src/loom/tools/loom-check",
    target_compatible_with = _XDNA_COMPILE_COMPATIBLE_WITH + loom_config_compatible_with(["//loom/config/import:cxx"]),
)

loom_check_test(
    name = "mxfp_group_dot_lowering",
    src = "test/mxfp_group_dot.cxx-test",
    data = ["//loom/src/loom/import/cxx/test:mxfp_group_dot.cxx"],
    runner = "//loom/src/loom/tools/loom-check",
    target_compatible_with = _XDNA_COMPILE_COMPATIBLE_WITH + loom_config_compatible_with(["//loom/config/import:cxx"]),
)

loom_check_test(
    name = "vector_lookup_lowering",
    src = "test/vector_lookup.cxx-test",
    data = ["//loom/src/loom/import/cxx/test:vector_lookup.cxx"],
    runner = "//loom/src/loom/tools/loom-check",
    target_compatible_with = _XDNA_COMPILE_COMPATIBLE_WITH + loom_config_compatible_with(["//loom/config/import:cxx"]),
)
