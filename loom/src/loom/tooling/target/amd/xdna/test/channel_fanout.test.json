{
  "version": 1,
  "cases": [
    {
      "name": "executes finite strided and repeated ingress with replay",
      "run": {
        "tool": "iree-test-loom",
        "args": [
          "{srcdir}/finite_ingress.loom",
          "--device=xdna://0?columns=1"
        ]
      },
      "stdout": {
        "contains": [
          "\"trial_count\":24",
          "\"failed_trial_count\":0",
          "\"planning_issue_count\":0",
          "\"failure_count\":0"
        ]
      }
    },
    {
      "name": "executes finite multicast tasks through compute and SRAM rings with replay",
      "run": {
        "tool": "iree-test-loom",
        "args": [
          "{srcdir}/channel_fanout.loom",
          "--device=xdna://0?columns=2"
        ]
      },
      "stdout": {
        "contains": [
          "\"case_count\":6",
          "\"sample_count\":6",
          "\"failed_sample_count\":0",
          "\"planning_issue_count\":0",
          "\"failure_count\":0"
        ]
      }
    },
    {
      "name": "executes two SRAM broadcasts across all four compute rows",
      "run": {
        "tool": "iree-test-loom",
        "args": [
          "{srcdir}/channel_sram.loom",
          "--device=xdna://0?columns=3",
          "--case=@rotating_four_row_sram_handoff"
        ]
      },
      "stdout": {
        "contains": [
          "\"case_count\":1",
          "\"failed_sample_count\":0",
          "\"trial_count\":0",
          "\"failed_trial_count\":0",
          "\"case\":\"rotating_four_row_sram_handoff\"",
          "\"failure_count\":0"
        ]
      }
    },
    {
      "name": "retires terminal compute and SRAM DMA before replay",
      "run": {
        "tool": "iree-test-loom",
        "args": [
          "{srcdir}/channel_sram.loom",
          "--device=xdna://0?columns=1",
          "--case=@terminal_prefetch_replay"
        ]
      },
      "stdout": {
        "contains": [
          "\"case_count\":1",
          "\"failed_sample_count\":0",
          "\"trial_count\":0",
          "\"failed_trial_count\":0",
          "\"case\":\"terminal_prefetch_replay\"",
          "\"failure_count\":0"
        ]
      }
    }
  ]
}
