[
    loom_generated_file(
        name = "temporal_fold_image_" + suffix,
        testonly = True,
        args = [
            "$(location temporal_fold.loom)",
            "--target=amd.xdna.aie2p:" + profile,
        ],
        generator = "//loom/src/loom/tools/loom-compile",
        inputs = ["temporal_fold.loom"],
        output = "temporal_fold_" + suffix + ".xdna",
        output_flag = "--output=",
        target_compatible_with = _XDNA_COMPILE_COMPATIBLE_WITH,
    )
    for suffix, profile in [
        ("npu4", "amd.xdna.strix.17f0_10"),
        ("npu5", "amd.xdna.strix_halo.17f0_11"),
    ]
]

loom_cc_binary(
    name = "temporal_fold_test_bin",
    testonly = True,
    srcs = ["temporal_fold_test.cc"],
    target_compatible_with = loom_config_compatible_with(["//loom/config/execute:aie2p_xdna_hal"]),
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/tooling:flags",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/cts/util:registry",
        "//runtime/src/iree/hal/cts/util:test_base",
        "//runtime/src/iree/hal/cts/util:test_main",
        "//runtime/src/iree/hal/drivers/amd:driver",
        "//runtime/src/iree/testing:gtest",
    ],
)

iree_executable_test(
    name = "temporal_fold_execution_test",
