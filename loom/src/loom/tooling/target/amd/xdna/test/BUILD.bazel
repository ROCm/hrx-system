# This topology reserves all eight columns of the Strix Halo array.
_XDNA_EIGHT_COLUMN_PROFILE = loom_execution_profile(
    name = "xdna_eight_columns",
    build_requirements = XDNA_HARDWARE_PROFILE.build_requirements,
    executor = XDNA_HARDWARE_PROFILE.executor,
    resource_group = XDNA_HARDWARE_PROFILE.resource_group,
    run_requirements = XDNA_HARDWARE_PROFILE.run_requirements,
    runner_args = ["--device=xdna://0?columns=8"],
    target_class = XDNA_HARDWARE_PROFILE.target_class,
    target_family = XDNA_HARDWARE_PROFILE.target_family,
)

