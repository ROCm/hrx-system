load("//build_tools/bazel:test_resources.bzl", "GPU_DEVICE_RESOURCE_GROUP")
load("//build_tools/testing:build_defs.bzl", "iree_execution_test_suite")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_XDNA_COMPILE_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/emit:aie2p_elf",
])

iree_execution_test_suite(
    name = "loom_compile_execution_test",
    data = ["//loom/src/loom/tooling/target/amd/xdna/testdata:resident_xdna.loom"],
    manifests = ["loom-compile.test.json"],
    tags = ["hostonly"],
    target_compatible_with = _XDNA_COMPILE_COMPATIBLE_WITH,
    tools = {
        "loom-compile": "//loom/src/loom/tools/loom-compile",
    },
)

iree_execution_test_suite(
    name = "loom_opt_trace",
    data = ["//loom/src/loom/tooling/target/amd/xdna/testdata:resident_publication.loom"],
    manifests = ["loom-opt.test.json"],
    tags = ["hostonly"],
    target_compatible_with = _XDNA_COMPILE_COMPATIBLE_WITH,
    tools = {
        "loom-opt": "//loom/src/loom/tools/loom-opt",
    },
)

iree_execution_test_suite(
    name = "loom_benchmark_execution_test",
    data = ["//loom/target/amd/xdna/test/native:hal_execution.loom"],
    manifests = ["loom-benchmark.test.json"],
    resource_group = GPU_DEVICE_RESOURCE_GROUP,
    tags = [
        "iree-run-requirement=libamdf.resource.xdna",
        "runtime-resource=amd-xdna",
    ],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/execute:aie2p_xdna_hal",
        "//loom/config/execute:vm_iree_vm",
    ]),
    tools = {"loom-benchmark": "//loom/src/loom/tools/loom-benchmark"},
)
