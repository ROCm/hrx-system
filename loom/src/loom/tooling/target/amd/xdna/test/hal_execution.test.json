{
  "version": 1,
  "cases": [
    {
      "name": "compiles and executes rebound XDNA pipelines through the HAL",
      "run": {
        "tool": "iree-test-loom",
        "args": [
          "{srcdir}/hal_execution.loom",
          "--device=xdna"
        ]
      },
      "stdout": {
        "contains": [
          "\"case_count\":3",
          "\"failed_sample_count\":0",
          "\"trial_count\":12",
          "\"failed_trial_count\":0",
          "\"case\":\"serial_array_programs\"",
          "\"case\":\"concurrent_array_programs\"",
          "\"case\":\"serial_route_reestablishment\"",
          "\"scenario\":\"rebound_pipeline\"",
          "\"scenario\":\"aliased_inputs\"",
          "\"scenario\":\"kernel_aliases\"",
          "\"failure_count\":0"
        ]
      }
    },
    {
      "name": "benchmarks recorded XDNA sequences across native queue windows",
      "run": {
        "tool": "iree-benchmark-loom",
        "args": [
          "{srcdir}/hal_execution.loom",
          "--device=xdna",
          "--benchmark=@serial_array_latency",
          "--measure=dispatch_complete",
          "--batch-size=65",
          "--iterations=3",
          "--warmup-iterations=1",
          "--min-time-ms=0",
          "--warmup-time-ms=0",
          "--max-batches=3",
          "--profile-final-batch=true",
          "--profile-data=queue-events,host-execution"
        ]
      },
      "stdout": {
        "contains": [
          "\"failed_sample_count\":0",
          "\"state\":\"ok\"",
          "\"physical_dispatches_per_batch\":195",
          "\"command_buffer_ring_count\":1",
          "\"requested\":true,\"executed\":true",
          "\"dropped_record_count\":0"
        ]
      }
    }
  ]
}
