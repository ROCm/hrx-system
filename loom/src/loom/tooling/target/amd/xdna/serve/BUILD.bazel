load("//build_tools/bazel:test_resources.bzl", "GPU_DEVICE_RESOURCE_GROUP")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test", "loom_config_compatible_with")
load("//loom/src/loom/serve/fixture/embedding:sources.bzl", EMBEDDING_SOURCES = "SOURCES", EMBEDDING_VARIANT_SOURCES = "VARIANT_SOURCES")

package(default_visibility = ["//visibility:private"])

exports_files(
    [
        "testdata/resident_checkpoint.loom",
        "testdata/resident_embedding.loom",
    ],
    visibility = ["//visibility:public"],
)

loom_cc_library(
    name = "test_compiler",
    testonly = True,
    srcs = ["test_compiler.c"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target:xdna_artifacts",
    ]),
    deps = [
        "//loom/binding/c/target/amd/xdna",
        "//loom/binding/c/target/amd/xdna:iree_hal",
        "//loom/src/loom/serve/testing:compiler",
    ],
    alwayslink = True,
)

loom_cc_library(
    name = "test_device",
    testonly = True,
    srcs = ["test_device.c"],
    target_compatible_with = loom_config_compatible_with([
        "//runtime/config/hal:driver_amd",
    ]),
    deps = [
        "//loom/src/loom/serve/testing:device",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/drivers/amd/registration",
    ],
    alwayslink = True,
)

loom_cc_test(
    name = "source_embedding_service_test",
    data = EMBEDDING_SOURCES + EMBEDDING_VARIANT_SOURCES + [
        "//loom/src/loom/tooling/target/amd/xdna/serve:testdata/resident_checkpoint.loom",
        "//loom/src/loom/tooling/target/amd/xdna/serve:testdata/resident_embedding.loom",
    ],
    env = {
        "LOOM_SERVE_TEST_CHECKPOINT_STAGE_SOURCE": "$(rootpath //loom/src/loom/tooling/target/amd/xdna/serve:testdata/resident_checkpoint.loom)",
        "LOOM_SERVE_TEST_DIRECT_STAGE_SOURCE": "$(rootpath //loom/src/loom/tooling/target/amd/xdna/serve:testdata/resident_embedding.loom)",
        "LOOM_SERVE_TEST_MODEL_SOURCE": "$(rootpath //loom/src/loom/serve/fixture/embedding:prepare.loom)",
    },
    resource_group = GPU_DEVICE_RESOURCE_GROUP,
    tags = [
        "iree-run-requirement=libamdf.resource.xdna",
        "runtime-resource=amd-xdna",
    ],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/execute:xdna_hal",
    ]) + select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":test_compiler",
        ":test_device",
        "//loom/src/loom/serve/service/finite/embedding:checkpoint_preparation_tests",
        "//loom/src/loom/serve/service/finite/embedding:direct_dispatch_tests",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
