config.decl @fixture.units : %value: index where [range(%value, 1, 256)]

aie2p.target<array> @parameter_target

// The checkpoint contains one F32 scale factor, prepared from 1.0 to 2.0 on
// first activation. Scaling the output detects missing or repeated preparation.
// The parameter buffer is a runtime binding; its extent is a staged input.
// The resident consumer transports the factor and packets through device-local
// channels without a global workspace.
pipeline.def<kernel> public retain target(@parameter_target) @resident_with_parameters(%factor_width: index) run(%parameters: buffer, %input: buffer, %output: buffer) {
  %input_aligned, %output_aligned = buffer.assume.alignment %input, %output {minimum_alignment = 16} : buffer, buffer
  %parameters_aligned = buffer.assume.alignment %parameters {minimum_alignment = 4} : buffer
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c4_bytes = index.constant 4 : offset
  %units = config.get @fixture.units : index
  %input_data_words = index.mul %units, %c5 : index
  %input_words = index.add %input_data_words, %c4 : index
  %output_words = index.mul %units, %c4 : index
  %input_bytes = index.scale %input_words, %c4_bytes : index, offset -> offset
  %output_bytes = index.scale %output_words, %c4_bytes : index, offset -> offset
  %memory = pipeline.memory<workgroup>[0, 3] : pool
  %factor_bytes = index.scale %factor_width, %c4_bytes : index, offset -> offset
  %factor_storage = buffer.alloca<workgroup> pool(%memory) align(64) %factor_bytes : buffer
  %factor_slots = buffer.view %factor_storage[%origin] : buffer -> view<1x[%factor_width]xf32>
  %factors = channel.bind<fifo> %factor_slots, %c1 : view<1x[%factor_width]xf32>, index -> channel<tile<[%factor_width]xf32>>
  %input_storage = buffer.alloca<workgroup> pool(%memory) align(64) %input_bytes : buffer
  %input_slots = buffer.view %input_storage[%origin] : buffer -> view<1x[%input_words]xi32>
  %inputs = channel.bind<fifo> %input_slots, %c1 : view<1x[%input_words]xi32>, index -> channel<tile<[%input_words]xi32>>
  %output_storage = buffer.alloca<workgroup> pool(%memory) align(64) %output_bytes : buffer
  %output_slots = buffer.view %output_storage[%origin] : buffer -> view<1x[%output_words]xf32>
  %outputs = channel.bind<fifo> %output_slots, %c1 : view<1x[%output_words]xf32>, index -> channel<tile<[%output_words]xf32>>
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %external_factor = buffer.view %parameters_aligned[%origin] : buffer -> view<[%factor_width]xf32>
    %factor_write, %factor_destination = channel.reserve %factors : channel<tile<[%factor_width]xf32>> -> (write<tile<[%factor_width]xf32>>, view<[%factor_width]xf32>)
    %factor_ingress = kernel.async.copy %external_factor to %factor_destination {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<[%factor_width]xf32> to view<[%factor_width]xf32> -> kernel.async.token
    %factor_incoming = kernel.async.group %factor_ingress : kernel.async.token -> kernel.async.group
    kernel.async.wait %factor_incoming {newer_groups = 0} : kernel.async.group
    channel.publish %factor_write : write<tile<[%factor_width]xf32>>
    %external_input = buffer.view %input_aligned[%origin] : buffer -> view<[%input_words]xi32>
    %input_write, %input_destination = channel.reserve %inputs : channel<tile<[%input_words]xi32>> -> (write<tile<[%input_words]xi32>>, view<[%input_words]xi32>)
    %ingress = kernel.async.copy %external_input to %input_destination {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<[%input_words]xi32> to view<[%input_words]xi32> -> kernel.async.token
    %incoming = kernel.async.group %ingress : kernel.async.token -> kernel.async.group
    kernel.async.wait %incoming {newer_groups = 0} : kernel.async.group
    channel.publish %input_write : write<tile<[%input_words]xi32>>
    %output_read, %output_source = channel.acquire %outputs : channel<tile<[%output_words]xf32>> -> (read<tile<[%output_words]xf32>>, view<[%output_words]xf32>)
    %external_output = buffer.view %output_aligned[%origin] : buffer -> view<[%output_words]xf32>
    %egress = kernel.async.copy %output_source to %external_output {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<[%output_words]xf32> to view<[%output_words]xf32> -> kernel.async.token
    %outgoing = kernel.async.group %egress : kernel.async.token -> kernel.async.group
    kernel.async.wait %outgoing {newer_groups = 0} : kernel.async.group
    channel.release %output_read : read<tile<[%output_words]xf32>>
  }
  pipeline.strand workers([0, 3], [1, 1], [1, 1]) {
    %factor_read, %factor_view = channel.acquire %factors : channel<tile<[%factor_width]xf32>> -> (read<tile<[%factor_width]xf32>>, view<[%factor_width]xf32>)
    %factor = view.load %factor_view[0] : view<[%factor_width]xf32> -> f32
    %input_read, %packet = channel.acquire %inputs : channel<tile<[%input_words]xi32>> -> (read<tile<[%input_words]xi32>>, view<[%input_words]xi32>)
    %output_write, %result = channel.reserve %outputs : channel<tile<[%output_words]xf32>> -> (write<tile<[%output_words]xf32>>, view<[%output_words]xf32>)
    %count32 = view.load %packet[0] : view<[%input_words]xi32> -> i32
    %bounded_count = scalar.assume %count32 [range(%count32, 0, 256)] : i32
    %count_value = index.cast %bounded_count : i32 to index
    %count = index.assume %count_value [range(%count_value, 0, %units)] : index
    %token_base = index.add %output_words, %c4 : index
    %c2 = index.constant 2 : index
    %c3 = index.constant 3 : index
    %maximum_input = index.sub %input_words, %c1 : index
    %last_output_start = index.sub %output_words, %c4 : index
    %c0_i32 = scalar.constant 0 : i32
    %c1_i32 = scalar.constant 1 : i32
    %c4_i32 = scalar.constant 4 : i32
    scf.for %row = [%c0 to %count step %c1] {
      %row_scaled = index.mul %row, %c4 : index
      %row_base = index.add %row_scaled, %c4 : index
      %begin_slot = index.assume %row_base [range(%row_base, 4, %maximum_input)] : index
      %length_slot = index.add %begin_slot, %c1 : index
      %width_slot = index.add %begin_slot, %c2 : index
      %offset_slot = index.add %begin_slot, %c3 : index
      %begin32 = view.load %packet[%begin_slot] : view<[%input_words]xi32> -> i32
      %length32 = view.load %packet[%length_slot] : view<[%input_words]xi32> -> i32
      %width32 = view.load %packet[%width_slot] : view<[%input_words]xi32> -> i32
      %offset32 = view.load %packet[%offset_slot] : view<[%input_words]xi32> -> i32
      %bounded_begin = scalar.assume %begin32 [range(%begin32, 0, 255)] : i32
      %bounded_length = scalar.assume %length32 [range(%length32, 1, 31)] : i32
      %begin = index.cast %bounded_begin : i32 to index
      %length_value = index.cast %bounded_length : i32 to index
      %length = index.assume %length_value [range(%length_value, 1, 31)] : index
      %first_value = index.add %token_base, %begin : index
      %first_slot = index.assume %first_value [range(%first_value, 0, %maximum_input)] : index
      %first_id = view.load %packet[%first_slot] : view<[%input_words]xi32> -> i32
      %first = scalar.addi %first_id, %c1_i32 : i32
      %sum = scf.for %i = [%c0 to %length step %c1](%previous = %c0_i32 : i32) -> (i32) {
        %token_value = index.add %first_slot, %i : index
        %token_slot = index.assume %token_value [range(%token_value, 0, %maximum_input)] : index
        %id = view.load %packet[%token_slot] : view<[%input_words]xi32> -> i32
        %value = scalar.addi %id, %c1_i32 : i32
        %next = scalar.addi %previous, %value : i32
        scf.yield %next : i32
      }
      %sum_f32 = scalar.uitofp %sum : i32 to f32
      %length_f32 = scalar.uitofp %length32 : i32 to f32
      %first_f32 = scalar.uitofp %first : i32 to f32
      %cohort_f32 = scalar.uitofp %count32 : i32 to f32
      %bounded_offset = scalar.assume %offset32 [range(%offset32, 0, 1023)] : i32
      %offset_value = index.cast %bounded_offset : i32 to index
      %offset = index.assume %offset_value [range(%offset_value, 0, %last_output_start)] : index
      %next = index.add %offset, %c1 : index
      view.store %sum_f32, %result[%offset] : f32, view<[%output_words]xf32>
      view.store %length_f32, %result[%next] : f32, view<[%output_words]xf32>
      %full = scalar.cmpi eq, %width32, %c4_i32 : i32
      scf.if %full {
        %second = index.add %offset, %c2 : index
        %third = index.add %offset, %c3 : index
        view.store %first_f32, %result[%second] : f32, view<[%output_words]xf32>
        view.store %cohort_f32, %result[%third] : f32, view<[%output_words]xf32>
      }
      %bounded_width = scalar.assume %width32 [range(%width32, 2, 4)] : i32
      %width = index.cast %bounded_width : i32 to index
      scf.for %component = [%c0 to %width step %c1] {
        %position_value = index.add %offset, %component : index
        %maximum_output = index.sub %output_words, %c1 : index
        %position = index.assume %position_value [range(%position_value, 0, %maximum_output)] : index
        %value = view.load %result[%position] : view<[%output_words]xf32> -> f32
        %scaled = scalar.mulf %value, %factor : f32
        view.store %scaled, %result[%position] : f32, view<[%output_words]xf32>
      }
    }
    channel.publish %output_write : write<tile<[%output_words]xf32>>
    channel.release %factor_read : read<tile<[%factor_width]xf32>>
    channel.release %input_read : read<tile<[%input_words]xi32>>
  }
}

// Activation transforms the canonical checkpoint directly in its final buffer.
pipeline.def<kernel> target(@parameter_target) @double_factor() run(%storage: buffer) {
  %aligned = buffer.assume.alignment %storage {minimum_alignment = 4} : buffer
  %origin = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %capacity = index.constant 1 : index
  %memory = pipeline.memory<workgroup>[0, 3] : pool
  %input_storage = buffer.alloca<workgroup> pool(%memory) align(64) %bytes : buffer
  %input_slots = buffer.view %input_storage[%origin] : buffer -> view<1x1xf32>
  %inputs = channel.bind<fifo> %input_slots, %capacity : view<1x1xf32>, index -> channel<tile<1xf32>>
  %output_storage = buffer.alloca<workgroup> pool(%memory) align(64) %bytes : buffer
  %output_slots = buffer.view %output_storage[%origin] : buffer -> view<1x1xf32>
  %outputs = channel.bind<fifo> %output_slots, %capacity : view<1x1xf32>, index -> channel<tile<1xf32>>
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %external = buffer.view %aligned[%origin] : buffer -> view<1xf32>
    %write, %destination = channel.reserve %inputs : channel<tile<1xf32>> -> (write<tile<1xf32>>, view<1xf32>)
    %ingress = kernel.async.copy %external to %destination {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<1xf32> to view<1xf32> -> kernel.async.token
    %incoming = kernel.async.group %ingress : kernel.async.token -> kernel.async.group
    kernel.async.wait %incoming {newer_groups = 0} : kernel.async.group
    channel.publish %write : write<tile<1xf32>>
    %read, %source = channel.acquire %outputs : channel<tile<1xf32>> -> (read<tile<1xf32>>, view<1xf32>)
    %egress = kernel.async.copy %source to %external {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<1xf32> to view<1xf32> -> kernel.async.token
    %outgoing = kernel.async.group %egress : kernel.async.token -> kernel.async.group
    kernel.async.wait %outgoing {newer_groups = 0} : kernel.async.group
    channel.release %read : read<tile<1xf32>>
  }
  pipeline.strand workers([0, 3], [1, 1], [1, 1]) {
    %read, %source = channel.acquire %inputs : channel<tile<1xf32>> -> (read<tile<1xf32>>, view<1xf32>)
    %write, %destination = channel.reserve %outputs : channel<tile<1xf32>> -> (write<tile<1xf32>>, view<1xf32>)
    %value = view.load %source[0] : view<1xf32> -> f32
    %scale = scalar.constant 2.0 : f32
    %prepared = scalar.mulf %value, %scale : f32
    view.store %prepared, %destination[0] : f32, view<1xf32>
    channel.publish %write : write<tile<1xf32>>
    channel.release %read : read<tile<1xf32>>
  }
}

command.def public @prepare_factor() launch(%storage: buffer) {
  kernel.launch @double_factor(%storage) : (buffer)
  command.return
}

command.def public @embed_with_parameters() launch(%parameters: buffer, %input: buffer, %output: buffer) {
  %factor = command.parameter %parameters, "factor" : view<1xf32>
  %width = index.constant 1 : index
  kernel.launch @resident_with_parameters[%width](%factor, %input, %output) : [index](view<1xf32>, buffer, buffer)
  command.return
}
