load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_config_compatible_with")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_VM_BINARY_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/emit:vm_binary",
])

loom_cc_library(
    name = "loom_check",
    srcs = ["loom_check.c"],
    hdrs = ["loom_check.h"],
    target_compatible_with = _VM_BINARY_COMPATIBLE_WITH,
    deps = [
        "//loom/binding/c:loomc",
        "//loom/src/loom/tools/loom-check:execute",
        "//runtime/src/iree/base",
        "//runtime/src/iree/vm/bytecode:disassembler",
    ],
)

loom_cc_library(
    name = "provider",
    srcs = ["provider.c"],
    hdrs = ["provider.h"],
    target_compatible_with = _VM_BINARY_COMPATIBLE_WITH,
    visibility = ["//loom/src/loom/tools/loom-check:__pkg__"],
    deps = [
        ":loom_check",
        "//loom/src/loom/tools/loom-check:provider",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "object_lifetime",
    testonly = True,
    srcs = ["object_lifetime.cc"],
    hdrs = ["object_lifetime.h"],
    target_compatible_with = _VM_BINARY_COMPATIBLE_WITH,
    visibility = ["//loom/src/loom/tools/loom-check:__pkg__"],
    deps = [
        "//loom/binding/c:loomc",
        "//loom/src/loom/tools/loom-check:execute",
        "//loom/src/loom/tools/loom-check:provider",
        "//runtime/src/iree/base",
        "//runtime/src/iree/vm",
        "//runtime/src/iree/vm:test_support",
        "//runtime/src/iree/vm/bytecode:module",
    ],
)
