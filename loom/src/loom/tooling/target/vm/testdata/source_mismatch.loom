func.def @mismatch_value(%value: i32) -> (i32) {
  %increment = scalar.constant 1 : i32
  %result = scalar.addi %value, %increment : i32
  func.return %result : i32
}

check.case @mismatch {
  %input = check.literal value(4) : i32
  %actual = func.call @mismatch_value(%input) : (i32) -> (i32)
  %expected = check.literal value(6) : i32
  check.expect.equal actual(%actual) expected(%expected) : i32
  check.return
}

check.benchmark<@mismatch> @mismatch_benchmark
