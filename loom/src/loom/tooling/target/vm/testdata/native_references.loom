// Private storage cells own references independently of the register bank.
// Replacing a cell must preserve earlier reloads and repeated reloads must
// each produce an owner that survives frame teardown.
low.func.def public target<vm.core>(@vm) abi(vm_function) @reference_storage(%left: reg<vm.ref : hal.buffer_view>, %right: reg<vm.ref : hal.buffer_view>) -> (reg<vm.ref : hal.buffer_view>, reg<vm.ref : hal.buffer_view>, reg<vm.ref : hal.buffer_view>) asm {
  %storage = storage {byte_alignment = 16, byte_length = 32} : low.storage<private>
  %cell = storage_view %storage {byte_length = 16, offset = 16} : low.storage<private> -> low.storage<private>
  low.spill %left, %cell : reg<vm.ref : hal.buffer_view>, low.storage<private>
  %original = low.reload %cell : low.storage<private> -> reg<vm.ref : hal.buffer_view>
  low.spill %right, %cell : reg<vm.ref : hal.buffer_view>, low.storage<private>
  %replacement = low.reload %cell : low.storage<private> -> reg<vm.ref : hal.buffer_view>
  %alias = low.reload %cell : low.storage<private> -> reg<vm.ref : hal.buffer_view>
  return %original, %replacement, %alias
}

// Native errors unwind references retained only by a private storage cell.
low.func.decl import(native, "fail", module = "resources") target<vm.core>(@vm) @fail_with_storage(%left: reg<vm.ref : hal.buffer_view>, %right: reg<vm.ref : hal.buffer_view>, %site: reg<vm.ref : buffer>)

low.func.def public target<vm.core>(@vm) abi(vm_function) @reference_storage_failure(%view: reg<vm.ref : hal.buffer_view>, %site: reg<vm.ref : buffer>) asm {
  %storage = storage {byte_alignment = 16, byte_length = 16} : low.storage<private>
  low.spill %view, %storage : reg<vm.ref : hal.buffer_view>, low.storage<private>
  low.func.call @fail_with_storage(%view, %view, %site) : (reg<vm.ref : hal.buffer_view>, reg<vm.ref : hal.buffer_view>, reg<vm.ref : buffer>)
  return
}

