load("//build_tools/embed_data:build_defs.bzl", "iree_c_embed_data")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test", "loom_config_compatible_with", "loom_generated_file")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],
)

_VM_BINARY_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/emit:vm_binary",
])

_VM_EXECUTION_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/execute:vm_iree_vm",
])

_IREE_VM_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/execute:iree_vm",
])

loom_cc_library(
    name = "buffer",
    srcs = ["buffer.c"],
    hdrs = ["buffer.h"],
    target_compatible_with = _IREE_VM_COMPATIBLE_WITH,
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/vm",
    ],
)

loom_cc_test(
    name = "buffer_test",
    srcs = ["buffer_test.cc"],
    target_compatible_with = _IREE_VM_COMPATIBLE_WITH,
    deps = [
        ":buffer",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/testing:mapped_transfer_buffer",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
        "//runtime/src/iree/vm",
    ],
)

loom_cc_library(
    name = "testbench",
    srcs = ["testbench.c"],
    hdrs = ["testbench.h"],
    target_compatible_with = _VM_EXECUTION_COMPATIBLE_WITH,
    deps = [
        ":buffer",
        "//loom/binding/c:interop",
        "//loom/binding/c:loomc",
        "//loom/binding/c/target/vm",
        "//loom/src/loom/target:view_boundary",
        "//loom/src/loom/tooling/testbench:compiled_provider",
        "//loom/src/loom/tooling/testbench/scenario:executor",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/module/string",
        "//runtime/src/iree/vm",
        "//runtime/src/iree/vm/bytecode:module",
    ],
)

loom_generated_file(
    name = "imports_binary",
    testonly = True,
    args = [
        "$(location //loom/src/loom/tooling/target/vm/testdata:imports.loom)",
        "--target=vm:core",
    ],
    generator = "//loom/src/loom/tools/loom-compile",
    inputs = ["//loom/src/loom/tooling/target/vm/testdata:imports.loom"],
    output = "imports.vm",
    output_flag = "--output=",
    target_compatible_with = _VM_BINARY_COMPATIBLE_WITH,
)

iree_c_embed_data(
    name = "imports_bytecode",
    testonly = True,
    srcs = [":imports_binary"],
    c_file_output = "imports_bytecode.c",
    h_file_output = "imports_bytecode.h",
    identifier = "loom_vm_imports_bytecode",
    target_compatible_with = _VM_BINARY_COMPATIBLE_WITH,
)

loom_cc_test(
    name = "imports_test",
    srcs = ["imports_test.cc"],
    target_compatible_with = _VM_EXECUTION_COMPATIBLE_WITH,
    deps = [
        ":imports_bytecode",
        "//loom/binding/c:loomc",
        "//loom/binding/c/target/vm",
        "//loom/src/loom/format:location",
        "//loom/src/loom/format/bytecode:writer",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/ops:op_registry",
        "//loom/src/loom/ops/func",
        "//loom/src/loom/ops/func:location_capture",
        "//loom/src/loom/ops/func:location_capture_test_data",
        "//loom/src/loom/tooling/input",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/io:stream",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
        "//runtime/src/iree/vm",
        "//runtime/src/iree/vm/bytecode:module",
    ],
)

loom_generated_file(
    name = "native_references_binary",
    testonly = True,
    args = [
        "$(location //loom/src/loom/tooling/target/vm/testdata:native_references.loom)",
        "--target=vm:core",
    ],
    generator = "//loom/src/loom/tools/loom-compile",
    inputs = ["//loom/src/loom/tooling/target/vm/testdata:native_references.loom"],
    output = "native_references.vm",
    output_flag = "--output=",
    target_compatible_with = _VM_BINARY_COMPATIBLE_WITH,
)

iree_c_embed_data(
    name = "native_references_bytecode",
    testonly = True,
    srcs = [":native_references_binary"],
    c_file_output = "native_references_bytecode.c",
    h_file_output = "native_references_bytecode.h",
    identifier = "loom_vm_native_references_bytecode",
    target_compatible_with = _VM_BINARY_COMPATIBLE_WITH,
)

iree_c_embed_data(
    name = "emission_test_data",
    testonly = True,
    srcs = ["//loom/src/loom/tooling/target/vm/testdata:native_references.loom"],
    c_file_output = "emission_test_data.c",
    h_file_output = "emission_test_data.h",
    identifier = "loom_vm_emission_test_data",
)

loom_cc_test(
    name = "emission_test",
    srcs = ["emission_test.cc"],
    target_compatible_with = _VM_BINARY_COMPATIBLE_WITH,
    deps = [
        ":emission_test_data",
        ":native_references_bytecode",
        "//loom/binding/c:interop",
        "//loom/binding/c:loomc",
        "//loom/binding/c/target/vm",
        "//loom/src/loom/target/emit/vm:module_compiler",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_test(
    name = "native_references_test",
    srcs = ["native_references_test.cc"],
    target_compatible_with = _VM_EXECUTION_COMPATIBLE_WITH,
    deps = [
        ":native_references_bytecode",
        "//loom/src/loom/format:location",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/module/hal:types",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
        "//runtime/src/iree/vm",
        "//runtime/src/iree/vm/bytecode:module",
    ],
)
