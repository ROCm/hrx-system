load("//build_tools/testing:build_defs.bzl", "iree_execution_test_suite")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")
load("//loom/build_tools/bazel:defs.bzl", "loom_test")
load("//loom/target/vm:execution_profiles.bzl", "VM_REFERENCE_PROFILE")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],
)

exports_files([
    "imports.loom",
    "native_references.loom",
])

loom_test(
    name = "buffer_selection_test",
    srcs = ["buffer_selection.loom"],
    execution_profiles = [VM_REFERENCE_PROFILE],
)

loom_test(
    name = "callable_returns_test",
    srcs = ["callable_returns.loom"],
    execution_profiles = [VM_REFERENCE_PROFILE],
)

iree_execution_test_suite(
    name = "tools_test",
    data = [
        "boolean_comparison.loom",
        "duplicate_exports.loom",
        "empty_export.loom",
        "invalid_operand.loom",
        "invalid_storage.loom",
        "module.loom",
        "source_call_context.loom",
        "source_cases.loom",
        "source_config.loom",
        "source_library_cases.loom",
        "source_math.loom",
        "source_math_case.loom",
        "source_mismatch.loom",
        "source_unavailable.loom",
        "//loom/src/loom/test/corpus/source_low:numeric_boolean_comparison.loom-test",
    ],
    manifests = ["vm.test.json"],
    target_compatible_with = loom_config_compatible_with(["//loom/config/target/arch:vm"]),
    tools = {
        "iree-benchmark-loom": "//loom/src/loom/tools/iree-benchmark-loom",
        "iree-test-loom": "//loom/src/loom/tools/iree-test-loom",
        "loom-compile": "//loom/src/loom/tools/loom-compile",
        "vm-dis": "//tools:vm-dis",
    },
)
