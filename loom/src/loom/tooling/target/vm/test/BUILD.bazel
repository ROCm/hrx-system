load("//build_tools/testing:build_defs.bzl", "iree_execution_test_suite")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],
)

iree_execution_test_suite(
    name = "tools_test",
    data = ["//loom/src/loom/tooling/target/vm/testdata:" + name + ".loom" for name in [
        "duplicate_exports",
        "empty_export",
        "invalid_operand",
        "invalid_storage",
        "module",
        "source_cases",
        "source_config",
        "source_library_cases",
        "source_mismatch",
        "source_template",
        "source_template_case",
        "source_unavailable",
        "source_views",
        "source_views_invalid",
        "unicode",
    ]] + ["//loom/target/vm/test:call_target_context.loom"],
    manifests = ["vm.test.json"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/execute:vm_iree_vm",
    ]),
    tools = {
        "loom-benchmark": "//loom/src/loom/tools/loom-benchmark",
        "loom-compile": "//loom/src/loom/tools/loom-compile",
        "loom-link": "//loom/src/loom/tools/loom-link",
        "loom-test": "//loom/src/loom/tools/loom-test",
        "vm-dis": "//tools:vm-dis",
    },
)
