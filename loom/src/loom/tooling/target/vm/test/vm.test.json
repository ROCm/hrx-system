{
  "version": 1,
  "cases": [
    {
      "name": "typed views preserve values, subranges, aliases, and lifetimes across host calls",
      "steps": [
        {
          "name": "execute source",
          "run": {
            "tool": "loom-test",
            "args": [
              "{srcdir}/source_views.loom"
            ]
          },
          "stdout": {
            "contains": [
              "\"case_count\":9",
              "\"failed_sample_count\":0",
              "\"skipped_case_count\":0",
              "\"planning_issue_count\":0"
            ]
          }
        },
        {
          "name": "benchmark the same calls",
          "run": {
            "tool": "loom-benchmark",
            "args": [
              "{srcdir}/source_views.loom",
              "--iterations=1",
              "--warmup-iterations=0"
            ]
          },
          "stdout": {
            "contains": [
              "view_argument_benchmark",
              "returned_subview_benchmark",
              "dynamic_view_benchmark",
              "mixed_owned_benchmark",
              "multidimensional_view_benchmark",
              "empty_dynamic_view_benchmark",
              "owned_rank_zero_view_benchmark"
            ]
          }
        },
        {
          "name": "link typed calls",
          "run": {
            "tool": "loom-link",
            "args": [
              "{srcdir}/source_views.loom",
              "--mode=link",
              "--root=@returned_subview_alias",
              "--root=@dynamic_view_results",
              "--root=@mixed_owned_results",
              "--to=bc",
              "--output={tmp}/views.loombc"
            ]
          }
        },
        {
          "name": "execute linked bytecode",
          "run": {
            "tool": "loom-test",
            "args": [
              "{tmp}/views.loombc"
            ]
          },
          "stdout": {
            "contains": [
              "\"case_count\":3",
              "\"failed_sample_count\":0",
              "\"skipped_case_count\":0",
              "\"planning_issue_count\":0"
            ]
          }
        }
      ]
    },
    {
      "name": "typed view boundary diagnoses non_dense_input",
      "run": {
        "tool": "loom-test",
        "args": [
          "{srcdir}/source_views_invalid.loom",
          "--case=non_dense_input"
        ]
      },
      "exit": 1,
      "stderr": {
        "contains": [
          "testbench buffer views require dense row-major storage without an encoding"
        ]
      }
    },
    {
      "name": "typed view boundary diagnoses non_dense_result",
      "run": {
        "tool": "loom-test",
        "args": [
          "{srcdir}/source_views_invalid.loom",
          "--case=non_dense_result"
        ]
      },
      "exit": 1,
      "stderr": {
        "contains": [
          "testbench buffer views require dense row-major storage without an encoding"
        ]
      }
    },
    {
      "name": "typed view boundary diagnoses extent_outside",
      "run": {
        "tool": "loom-test",
        "args": [
          "{srcdir}/source_views_invalid.loom",
          "--case=extent_outside"
        ]
      },
      "exit": 1,
      "stderr": {
        "contains": [
          "buffer view byte range [0, 2) exceeds source byte length 1"
        ]
      }
    },
    {
      "name": "typed view boundary diagnoses offset_outside",
      "run": {
        "tool": "loom-test",
        "args": [
          "{srcdir}/source_views_invalid.loom",
          "--case=offset_outside"
        ]
      },
      "exit": 1,
      "stderr": {
        "contains": [
          "returned VM view byte offset is outside its buffer"
        ]
      }
    },
    {
      "name": "compiles an explicitly specialized root calling an authored VM helper",
      "steps": [
        {
          "name": "compile",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{srcdir}/../../../../../../target/vm/test/call_target_context.loom",
              "--root=@unbound_caller",
              "--target=vm:core",
              "--format=vm",
              "--output={tmp}/specialized.vm"
            ]
          }
        },
        {
          "name": "disassemble",
          "run": {
            "tool": "vm-dis",
            "args": [
              "{tmp}/specialized.vm"
            ]
          },
          "stdout": {
            "contains": [
              "unbound_caller",
              "control.call",
              "control.return"
            ]
          }
        }
      ]
    },
    {
      "name": "loom-test applies invocation config 5 before VM compilation",
      "run": {
        "tool": "loom-test",
        "args": [
          "{srcdir}/source_config.loom",
          "--case=five",
          "--config=tuning.factor=5"
        ]
      },
      "stdout": {
        "contains": [
          "\"case_count\":1",
          "\"sample_count\":1",
          "\"failed_sample_count\":0"
        ]
      }
    },
    {
      "name": "loom-benchmark applies invocation config 5 before VM compilation",
      "run": {
        "tool": "loom-benchmark",
        "args": [
          "{srcdir}/source_config.loom",
          "--case=five",
          "--config=tuning.factor=5",
          "--iterations=1",
          "--warmup-iterations=0"
        ]
      },
      "stdout": {
        "contains": [
          "five_benchmark",
          "\"failed_sample_count\":0"
        ]
      }
    },
    {
      "name": "loom-test applies invocation config 9 before VM compilation",
      "run": {
        "tool": "loom-test",
        "args": [
          "{srcdir}/source_config.loom",
          "--case=nine",
          "--config=tuning.factor=9"
        ]
      },
      "stdout": {
        "contains": [
          "\"case_count\":1",
          "\"sample_count\":1",
          "\"failed_sample_count\":0"
        ]
      }
    },
    {
      "name": "loom-benchmark applies invocation config 9 before VM compilation",
      "run": {
        "tool": "loom-benchmark",
        "args": [
          "{srcdir}/source_config.loom",
          "--case=nine",
          "--config=tuning.factor=9",
          "--iterations=1",
          "--warmup-iterations=0"
        ]
      },
      "stdout": {
        "contains": [
          "nine_benchmark",
          "\"failed_sample_count\":0"
        ]
      }
    },
    {
      "name": "VM compilation resolves a linked helper source snapshot",
      "run": {
        "tool": "loom-test",
        "args": [
          "{srcdir}/source_template_case.loom",
          "--library={srcdir}/source_template.loom"
        ]
      },
      "exit": {
        "nonzero": true
      },
      "stderr": {
        "contains": [
          "source_template.loom:4:3",
          "select-templates",
          "template.apply<@required_transform>(%value)"
        ]
      },
      "stdout": {
        "contains": [
          "\"category\":\"compile_rejected\"",
          "\"provider\":\"vm\"",
          "\"stage\":\"compile\"",
          "\"kind\":\"LOWERING/045\"",
          "required_transform"
        ]
      }
    },
    {
      "name": "compiler root materialization retains original source text",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/source_template.loom",
          "--root=@missing_implementation",
          "--target=vm:core",
          "--output={tmp}/output.vm"
        ]
      },
      "exit": {"nonzero": true},
      "stderr": {
        "contains": [
          "source_template.loom:4:3",
          "select-templates",
          "template.apply<@required_transform>(%value)",
          "^"
        ]
      }
    },
    {
      "name": "benchmark correctness failure reports the authored assertion range",
      "run": {
        "tool": "loom-benchmark",
        "args": [
          "{srcdir}/source_mismatch.loom",
          "--iterations=1",
          "--warmup-iterations=0",
          "--output-format=jsonl"
        ]
      },
      "exit": {
        "nonzero": true
      },
      "stdout": {
        "contains": [
          "\"failure_count\":1",
          "\"source_location\":{\"filename\":",
          "source_mismatch.loom",
          "\"start_line\":11,\"start_column\":3"
        ]
      }
    },
    {
      "name": "loom-test reports the authored assertion range after linking",
      "run": {
        "tool": "loom-test",
        "args": [
          "{srcdir}/source_cases.loom",
          "--library={srcdir}/source_mismatch.loom",
          "--case=mismatch"
        ]
      },
      "exit": {
        "nonzero": true
      },
      "stdout": {
        "contains": [
          "\"failure_count\":1",
          "\"source_location\":{\"filename\":",
          "source_mismatch.loom",
          "\"start_line\":11,\"start_column\":3"
        ]
      }
    },
    {
      "name": "rejects an unavailable callee when a case actually invokes it",
      "run": {
        "tool": "loom-test",
        "args": [
          "{srcdir}/source_unavailable.loom",
          "--library={srcdir}/source_cases.loom"
        ]
      },
      "exit": {
        "nonzero": true
      },
      "stderr": {
        "contains": [
          "VM callee '@unavailable' has no definition or runtime import"
        ]
      }
    },
    {
      "name": "executes a selected source closure with public and private invocation roots",
      "run": {
        "tool": "loom-test",
        "args": [
          "{srcdir}/source_cases.loom"
        ]
      },
      "stdout": {
        "contains": [
          "\"case_count\":3",
          "\"sample_count\":3",
          "\"failed_sample_count\":0",
          "\"planning_issue_count\":0"
        ]
      }
    },
    {
      "name": "uses the same invocation closure after execution library linking",
      "run": {
        "tool": "loom-test",
        "args": [
          "{srcdir}/source_library_cases.loom",
          "--library={srcdir}/source_cases.loom"
        ]
      },
      "stdout": {
        "contains": [
          "\"case_count\":4",
          "\"sample_count\":4",
          "\"failed_sample_count\":0"
        ]
      }
    },
    {
      "name": "benchmarks a source case after its VM correctness gate",
      "run": {
        "tool": "loom-benchmark",
        "args": [
          "{srcdir}/source_cases.loom",
          "--iterations=1",
          "--warmup-iterations=0"
        ]
      },
      "stdout": {
        "contains": [
          "public_entry_benchmark"
        ]
      }
    },
    {
      "name": "rejects a target opcode with incompatible source registers",
      "run": {
        "tool": "loom-compile",
        "args": ["{srcdir}/invalid_operand.loom", "--format=vm", "--output={tmp}/invalid.vm"]
      },
      "exit": 1,
      "stderr": {
        "contains": [
          "TYPE/003",
          "operand 'left_v8' has type reg<vm.ref : buffer>, expected register class in [vm.value] with 1 unit(s)"
        ]
      },
      "files": [{"path": "{tmp}/invalid.vm", "exists": false}]
    },
    {
      "name": "compiles target-free functions and private callees into standalone VM bytecode",
      "steps": [
        {
          "name": "compile",
          "run": {
            "tool": "loom-compile",
            "args": ["{srcdir}/module.loom", "--target=vm:core", "--output={tmp}/module.vm", "--dump-ir-after-all", "--dump-ir-output={tmp}/module.ir"]
          },
          "files": [{"path": "{tmp}/module.ir", "contains": ["vm.target<core>", "integer.mul.i32"]}]
        },
        {
          "name": "disassemble",
          "run": {
            "tool": "vm-dis",
            "args": ["{tmp}/module.vm"]
          },
          "stdout": {
            "contains": [
              "vm.module core(0.0)",
              "\"arithmetic\"",
              "\"swap\"",
              "control.call",
              "integer.mul.i32",
              "value.copy",
              "control.return"
            ],
            "not_contains": ["\"multiply\""]
          }
        }
      ]
    },
    {
      "name": "specializes selected roots and their callees without retaining other exports",
      "steps": [
        {
          "name": "compile",
          "run": {
            "tool": "loom-compile",
            "args": ["{srcdir}/module.loom", "--root=arithmetic", "--target=vm:core", "--output={tmp}/selected.vm"]
          }
        },
        {
          "name": "disassemble",
          "run": {
            "tool": "vm-dis",
            "args": ["{tmp}/selected.vm"]
          },
          "stdout": {
            "contains": ["\"arithmetic\"", "control.call", "integer.mul.i32"],
            "not_contains": ["\"swap\"", "\"multiply\""]
          }
        }
      ]
    },
    {
      "name": "excludes module roots before dependency materialization",
      "steps": [
        {
          "name": "compile",
          "run": {
            "tool": "loom-compile",
            "args": ["{srcdir}/module.loom", "--exclude-root=swap", "--target=vm:core", "--output={tmp}/excluded.vm"]
          }
        },
        {
          "name": "disassemble",
          "run": {
            "tool": "vm-dis",
            "args": ["{tmp}/excluded.vm"]
          },
          "stdout": {
            "contains": ["\"arithmetic\"", "control.call", "integer.mul.i32"],
            "not_contains": ["\"swap\""]
          }
        }
      ]
    },
    {
      "name": "rejects colliding host export names",
      "run": {
        "tool": "loom-compile",
        "args": ["{srcdir}/duplicate_exports.loom", "--format=vm", "--output={tmp}/invalid.vm"]
      },
      "exit": 1,
      "stderr": {"contains": ["duplicate VM export 'collision'"]}
    },
    {
      "name": "rejects an explicitly empty export name",
      "run": {
        "tool": "loom-compile",
        "args": ["{srcdir}/empty_export.loom", "--format=vm", "--output={tmp}/invalid.vm"]
      },
      "exit": 1,
      "stderr": {"contains": ["VM export names must not be empty"]}
    },
    {
      "name": "rejects storage exceeding the Core frame extent",
      "run": {
        "tool": "loom-compile",
        "args": ["{srcdir}/invalid_storage.loom", "--root=oversized", "--format=vm", "--output={tmp}/invalid.vm"]
      },
      "exit": 1,
      "stderr": {"contains": ["VM local storage exceeds 65535 bytes"]}
    },
    {
      "name": "rejects a narrow scalar spill that does not hold a complete value cell",
      "run": {
        "tool": "loom-compile",
        "args": ["{srcdir}/invalid_storage.loom", "--root=short", "--format=vm", "--output={tmp}/invalid.vm"]
      },
      "exit": 1,
      "stderr": {"contains": ["VM register transfer exceeds its storage span"]}
    },
    {
      "name": "rejects workgroup storage in a Core host function",
      "run": {
        "tool": "loom-compile",
        "args": ["{srcdir}/invalid_storage.loom", "--root=wrong_space", "--format=vm", "--output={tmp}/invalid.vm"]
      },
      "exit": 1,
      "stderr": {"contains": ["VM local storage requires stack or private space"]}
    }
  ]
}
