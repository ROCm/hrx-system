{
  "version": 1,
  "cases": [
    {
      "name": "compiles an explicitly specialized root calling an authored VM helper",
      "steps": [
        {
          "name": "compile",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{srcdir}/source_call_context.loom",
              "--root=@unbound_caller",
              "--target=vm:core",
              "--format=vm",
              "--output={tmp}/specialized.vm"
            ]
          }
        },
        {
          "name": "disassemble",
          "run": {
            "tool": "vm-dis",
            "args": [
              "{tmp}/specialized.vm"
            ]
          },
          "stdout": {
            "contains": [
              "unbound_caller",
              "control.call",
              "control.return"
            ]
          }
        }
      ]
    },
    {
      "name": "executes calls between authored and inherited compatible target contexts",
      "run": {
        "tool": "iree-test-loom",
        "args": [
          "{srcdir}/source_call_context.loom"
        ]
      },
      "stdout": {
        "contains": [
          "\"case_count\":1",
          "\"failed_sample_count\":0",
          "\"planning_issue_count\":0"
        ]
      }
    },
    {
      "name": "iree-test-loom applies invocation config 5 before VM compilation",
      "run": {
        "tool": "iree-test-loom",
        "args": [
          "{srcdir}/source_config.loom",
          "--case=five",
          "--config=tuning.factor=5"
        ]
      },
      "stdout": {
        "contains": [
          "\"case_count\":1",
          "\"sample_count\":1",
          "\"failed_sample_count\":0"
        ]
      }
    },
    {
      "name": "iree-benchmark-loom applies invocation config 5 before VM compilation",
      "run": {
        "tool": "iree-benchmark-loom",
        "args": [
          "{srcdir}/source_config.loom",
          "--case=five",
          "--config=tuning.factor=5",
          "--iterations=1",
          "--warmup-iterations=0"
        ]
      },
      "stdout": {
        "contains": [
          "five_benchmark",
          "\"failed_sample_count\":0"
        ]
      }
    },
    {
      "name": "iree-test-loom applies invocation config 9 before VM compilation",
      "run": {
        "tool": "iree-test-loom",
        "args": [
          "{srcdir}/source_config.loom",
          "--case=nine",
          "--config=tuning.factor=9"
        ]
      },
      "stdout": {
        "contains": [
          "\"case_count\":1",
          "\"sample_count\":1",
          "\"failed_sample_count\":0"
        ]
      }
    },
    {
      "name": "iree-benchmark-loom applies invocation config 9 before VM compilation",
      "run": {
        "tool": "iree-benchmark-loom",
        "args": [
          "{srcdir}/source_config.loom",
          "--case=nine",
          "--config=tuning.factor=9",
          "--iterations=1",
          "--warmup-iterations=0"
        ]
      },
      "stdout": {
        "contains": [
          "nine_benchmark",
          "\"failed_sample_count\":0"
        ]
      }
    },
    {
      "name": "executes every boolean comparison predicate with signed one-bit ordering",
      "run": {
        "tool": "iree-test-loom",
        "args": [
          "{srcdir}/boolean_comparison.loom",
          "--library={srcdir}/../../../../test/corpus/source_low/numeric_boolean_comparison.loom-test"
        ]
      },
      "stdout": {
        "contains": [
          "\"case_count\":7",
          "\"failed_sample_count\":0",
          "\"skipped_case_count\":0",
          "\"planning_issue_count\":0"
        ]
      }
    },
    {
      "name": "VM compilation resolves a linked helper source snapshot",
      "run": {
        "tool": "iree-test-loom",
        "args": [
          "{srcdir}/source_math_case.loom",
          "--library={srcdir}/source_math.loom"
        ]
      },
      "exit": {
        "nonzero": true
      },
      "stderr": {
        "contains": [
          "source_math.loom:2:3",
          "vm-math",
          "scalar.sinf %value : f32"
        ]
      },
      "stdout": {
        "contains": [
          "\"category\":\"compile_rejected\"",
          "\"provider\":\"vm\"",
          "\"stage\":\"pipeline\"",
          "\"kind\":\"ERR_LOWERING_036\"",
          "Math legalization policy rejected an operation."
        ]
      }
    },
    {
      "name": "compiler root materialization retains original source text",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/source_math.loom",
          "--root=@exact_sine",
          "--target=vm:core",
          "--output={tmp}/output.vm"
        ]
      },
      "exit": {"nonzero": true},
      "stderr": {
        "contains": [
          "source_math.loom:2:3",
          "vm-math",
          "scalar.sinf %value : f32",
          "^"
        ]
      }
    },
    {
      "name": "benchmark correctness failure reports the authored assertion range",
      "run": {
        "tool": "iree-benchmark-loom",
        "args": [
          "{srcdir}/source_mismatch.loom",
          "--iterations=1",
          "--warmup-iterations=0",
          "--output-format=jsonl"
        ]
      },
      "exit": {
        "nonzero": true
      },
      "stdout": {
        "contains": [
          "\"failure_count\":1",
          "\"source_location\":{\"filename\":",
          "source_mismatch.loom",
          "\"start_line\":11,\"start_column\":3"
        ]
      }
    },
    {
      "name": "iree-test-loom reports the authored assertion range after linking",
      "run": {
        "tool": "iree-test-loom",
        "args": [
          "{srcdir}/source_cases.loom",
          "--library={srcdir}/source_mismatch.loom",
          "--case=mismatch"
        ]
      },
      "exit": {
        "nonzero": true
      },
      "stdout": {
        "contains": [
          "\"failure_count\":1",
          "\"source_location\":{\"filename\":",
          "source_mismatch.loom",
          "\"start_line\":11,\"start_column\":3"
        ]
      }
    },
    {
      "name": "rejects an unavailable callee when a case actually invokes it",
      "run": {
        "tool": "iree-test-loom",
        "args": [
          "{srcdir}/source_unavailable.loom",
          "--library={srcdir}/source_cases.loom"
        ]
      },
      "exit": {
        "nonzero": true
      },
      "stderr": {
        "contains": [
          "VM callee '@unavailable' has no definition or runtime import"
        ]
      }
    },
    {
      "name": "executes a selected source closure with public and private invocation roots",
      "run": {
        "tool": "iree-test-loom",
        "args": [
          "{srcdir}/source_cases.loom"
        ]
      },
      "stdout": {
        "contains": [
          "\"case_count\":3",
          "\"sample_count\":3",
          "\"failed_sample_count\":0",
          "\"planning_issue_count\":0"
        ]
      }
    },
    {
      "name": "uses the same invocation closure after execution library linking",
      "run": {
        "tool": "iree-test-loom",
        "args": [
          "{srcdir}/source_library_cases.loom",
          "--library={srcdir}/source_cases.loom"
        ]
      },
      "stdout": {
        "contains": [
          "\"case_count\":4",
          "\"sample_count\":4",
          "\"failed_sample_count\":0"
        ]
      }
    },
    {
      "name": "benchmarks a source case after its VM correctness gate",
      "run": {
        "tool": "iree-benchmark-loom",
        "args": [
          "{srcdir}/source_cases.loom",
          "--iterations=1",
          "--warmup-iterations=0"
        ]
      },
      "stdout": {
        "contains": [
          "public_entry_benchmark"
        ]
      }
    },
    {
      "name": "rejects a target opcode with incompatible source registers",
      "run": {
        "tool": "loom-compile",
        "args": ["{srcdir}/invalid_operand.loom", "--format=vm", "--output={tmp}/invalid.vm"]
      },
      "exit": 1,
      "stderr": {"contains": ["input module failed Low verification"]},
      "files": [{"path": "{tmp}/invalid.vm", "exists": false}]
    },
    {
      "name": "compiles target-free functions and private callees into standalone VM bytecode",
      "steps": [
        {
          "name": "compile",
          "run": {
            "tool": "loom-compile",
            "args": ["{srcdir}/module.loom", "--target=vm:core", "--output={tmp}/module.vm", "--dump-ir-after-all", "--dump-ir-output={tmp}/module.ir"]
          },
          "files": [{"path": "{tmp}/module.ir", "contains": ["vm.target<core>", "integer.mul.i32"]}]
        },
        {
          "name": "disassemble",
          "run": {
            "tool": "vm-dis",
            "args": ["{tmp}/module.vm"]
          },
          "stdout": {
            "contains": [
              "vm.module core(0.0)",
              "\"arithmetic\"",
              "\"swap\"",
              "control.call",
              "integer.mul.i32",
              "value.copy",
              "control.return"
            ],
            "not_contains": ["\"multiply\""]
          }
        }
      ]
    },
    {
      "name": "specializes selected roots and their callees without retaining other exports",
      "steps": [
        {
          "name": "compile",
          "run": {
            "tool": "loom-compile",
            "args": ["{srcdir}/module.loom", "--root=arithmetic", "--target=vm:core", "--output={tmp}/selected.vm"]
          }
        },
        {
          "name": "disassemble",
          "run": {
            "tool": "vm-dis",
            "args": ["{tmp}/selected.vm"]
          },
          "stdout": {
            "contains": ["\"arithmetic\"", "control.call", "integer.mul.i32"],
            "not_contains": ["\"swap\"", "\"multiply\""]
          }
        }
      ]
    },
    {
      "name": "rejects colliding host export names",
      "run": {
        "tool": "loom-compile",
        "args": ["{srcdir}/duplicate_exports.loom", "--format=vm", "--output={tmp}/invalid.vm"]
      },
      "exit": 1,
      "stderr": {"contains": ["duplicate VM export 'collision'"]}
    },
    {
      "name": "rejects an explicitly empty export name",
      "run": {
        "tool": "loom-compile",
        "args": ["{srcdir}/empty_export.loom", "--format=vm", "--output={tmp}/invalid.vm"]
      },
      "exit": 1,
      "stderr": {"contains": ["VM export names must not be empty"]}
    },
    {
      "name": "rejects storage exceeding the Core frame extent",
      "run": {
        "tool": "loom-compile",
        "args": ["{srcdir}/invalid_storage.loom", "--root=oversized", "--format=vm", "--output={tmp}/invalid.vm"]
      },
      "exit": 1,
      "stderr": {"contains": ["VM local storage exceeds 65535 bytes"]}
    },
    {
      "name": "rejects a narrow scalar spill that does not hold a complete value cell",
      "run": {
        "tool": "loom-compile",
        "args": ["{srcdir}/invalid_storage.loom", "--root=short", "--format=vm", "--output={tmp}/invalid.vm"]
      },
      "exit": 1,
      "stderr": {"contains": ["VM register transfer exceeds its storage span"]}
    },
    {
      "name": "rejects workgroup storage in a Core host function",
      "run": {
        "tool": "loom-compile",
        "args": ["{srcdir}/invalid_storage.loom", "--root=wrong_space", "--format=vm", "--output={tmp}/invalid.vm"]
      },
      "exit": 1,
      "stderr": {"contains": ["VM local storage requires the stack space"]}
    }
  ]
}
