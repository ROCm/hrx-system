load("//build_tools/bazel:test_resources.bzl", "GPU_DEVICE_RESOURCE_GROUP")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_test", "loom_config_compatible_with")

package(default_visibility = ["//visibility:private"])

loom_cc_test(
    name = "source_image_service_test",
    args = [
        "--model_source=$(rootpath //loom/src/loom/serve/fixture/image:prepare.loom)",
        "--test_device=vulkan",
    ],
    data = [
        "//loom/src/loom/serve/fixture/image:prepare.loom",
        "//loom/src/loom/serve/fixture/image:sources",
    ],
    resource_group = GPU_DEVICE_RESOURCE_GROUP,
    tags = [
        "iree-run-requirement=vulkan.resource.device",
    ],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:vm",
        "//loom/config/execute:spirv_vulkan_hal",
    ]) + select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//loom/src/loom/serve/service/image:source_service_tests",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

