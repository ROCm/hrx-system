load("//build_tools/bazel:python.bzl", "iree_py_test")
load("//build_tools/bazel:test_resources.bzl", "GPU_DEVICE_RESOURCE_GROUP")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_binary", "loom_cc_library", "loom_cc_test", "loom_config_compatible_with")
load("//loom/src/loom/serve/fixture/decision:sources.bzl", DECISION_SOURCES = "SOURCES")
load("//loom/src/loom/serve/fixture/embedding:sources.bzl", EMBEDDING_SOURCES = "SOURCES", EMBEDDING_VARIANT_SOURCES = "VARIANT_SOURCES")
load("//loom/src/loom/serve/fixture/image:sources.bzl", IMAGE_SOURCES = "SOURCES")
load("//loom/src/loom/serve/fixture/speech:sources.bzl", SPEECH_SOURCES = "SOURCES", SPEECH_VARIANT_SOURCES = "VARIANT_SOURCES")
load("//loom/src/loom/serve/fixture/text:sources.bzl", TEXT_SOURCES = "SOURCES")

package(default_visibility = ["//visibility:private"])

loom_cc_library(
    name = "test_compiler",
    testonly = True,
    srcs = ["test_compiler.c"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target:spirv_vulkan_artifacts",
    ]),
    deps = [
        "//loom/binding/c/target/spirv",
        "//loom/binding/c/target/spirv:iree_hal",
        "//loom/src/loom/serve/testing:compiler",
    ],
    alwayslink = True,
)

loom_cc_binary(
    name = "loom-serve-test-tool",
    testonly = True,
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:vm",
        "//loom/config/target:spirv_artifacts",
        "//runtime/config/hal:driver_vulkan",
    ]),
    deps = [
        ":test_compiler",
        ":test_device",
        "//loom/src/loom/serve/testing:server_test_tool",
    ],
)

loom_cc_library(
    name = "test_device",
    testonly = True,
    srcs = ["test_device.c"],
    target_compatible_with = loom_config_compatible_with([
        "//runtime/config/hal:driver_vulkan",
    ]),
    deps = [
        "//loom/src/loom/serve/testing:device",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/drivers/vulkan/registration",
    ],
    alwayslink = True,
)

loom_cc_test(
    name = "source_image_service_test",
    data = IMAGE_SOURCES,
    env = {
        "LOOM_SERVE_TEST_MODEL_SOURCE": "$(rootpath //loom/src/loom/serve/fixture/image:prepare.loom)",
    },
    resource_group = GPU_DEVICE_RESOURCE_GROUP,
    tags = [
        "iree-run-requirement=vulkan.resource.device",
    ],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:vm",
        "//loom/config/execute:spirv_vulkan_hal",
    ]) + select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":test_compiler",
        ":test_device",
        "//loom/src/loom/serve/service/image:source_service_tests",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_test(
    name = "source_speech_service_test",
    args = [
        "--model_source=$(rootpath //loom/src/loom/serve/fixture/speech:prepare.loom)",
    ],
    data = SPEECH_SOURCES + SPEECH_VARIANT_SOURCES,
    resource_group = GPU_DEVICE_RESOURCE_GROUP,
    tags = [
        "iree-run-requirement=vulkan.resource.device",
    ],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:vm",
        "//loom/config/execute:spirv_vulkan_hal",
    ]) + select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":test_compiler",
        ":test_device",
        "//loom/src/loom/serve/service/speech:source_service_tests",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_test(
    name = "source_speech_service_parallel_test",
    args = [
        "--test_workers=2",
        "--model_source=$(rootpath //loom/src/loom/serve/fixture/speech:prepare.loom)",
    ],
    data = SPEECH_SOURCES + SPEECH_VARIANT_SOURCES,
    resource_group = GPU_DEVICE_RESOURCE_GROUP,
    tags = [
        "iree-run-requirement=vulkan.resource.device",
    ],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:vm",
        "//loom/config/execute:spirv_vulkan_hal",
    ]) + select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":test_compiler",
        ":test_device",
        "//loom/src/loom/serve/service/speech:source_service_tests",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

iree_py_test(
    name = "catalog_test",
    size = "medium",
    srcs = ["//loom/src/loom/serve/server:catalog_test.py"],
    args = [
        "--server=$(rootpath :loom-serve-test-tool)",
        "--fixture=$(rootpath //loom/src/loom/serve/fixture/image:model.json)",
        "--fixture=$(rootpath //loom/src/loom/serve/fixture/embedding:model.json)",
        "--fixture=$(rootpath //loom/src/loom/serve/fixture/decision:model.json)",
        "--fixture=$(rootpath //loom/src/loom/serve/fixture/speech:model.json)",
        "--fixture=$(rootpath //loom/src/loom/serve/fixture/text:model.json)",
        "--device=vulkan",
        "--pool_backing=fixed",
    ],
    data = DECISION_SOURCES + EMBEDDING_SOURCES + IMAGE_SOURCES + SPEECH_SOURCES + TEXT_SOURCES + [
        ":loom-serve-test-tool",
    ],
    main = "catalog_test.py",
    resource_group = GPU_DEVICE_RESOURCE_GROUP,
    tags = [
        "iree-run-requirement=vulkan.resource.device",
    ],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:vm",
        "//loom/config/execute:spirv_vulkan_hal",
    ]) + select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//loom/src/loom/serve/server:catalog_test_util",
        "//loom/src/loom/serve/testing:http",
        "//loom/src/loom/serve/testing:logs",
    ],
)

