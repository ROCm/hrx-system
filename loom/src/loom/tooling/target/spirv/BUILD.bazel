load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_library",
    "loom_cc_test",
    "loom_config_compatible_with",
)
load("//loom/build_tools/bazel:defs.bzl", "loom_test")
load(
    ":execution_profiles.bzl",
    "SPIRV_VULKAN_HARDWARE_PROFILE",
)

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

LOOM_SPIRV_VULKAN_COMPATIBLE_WITH = loom_config_compatible_with([
    "//runtime/config/hal:driver_vulkan",
])

_SPIRV_COMPILE_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/target:spirv_artifacts",
])

_SPIRV_VULKAN_HAL_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/execute:iree_hal_vulkan",
])

loom_cc_library(
    name = "artifact_provider",
    srcs = ["artifact_provider.c"],
    hdrs = ["artifact_provider.h"],
    target_compatible_with = _SPIRV_COMPILE_COMPATIBLE_WITH,
    deps = [
        "//loom/src/loom/target:entry_selection",
        "//loom/src/loom/target:function_contract",
        "//loom/src/loom/target:low_descriptor_registry",
        "//loom/src/loom/target:types",
        "//loom/src/loom/target/arch/spirv:low_verify",
        "//loom/src/loom/target/arch/spirv/descriptors:low_registry",
        "//loom/src/loom/target/emit/spirv:module_builder",
        "//loom/src/loom/target/emit/spirv:module_emitter",
        "//loom/src/loom/target/reporting:artifact_manifest_collect",
        "//loom/src/loom/target/reporting:report",
        "//loom/src/loom/tooling/compile:artifact",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "device_provider",
    srcs = ["device_provider.c"],
    hdrs = ["device_provider.h"],
    target_compatible_with = _SPIRV_VULKAN_HAL_COMPATIBLE_WITH,
    deps = [
        ":artifact_provider",
        ":vulkan_profile",
        "//loom/src/loom/target/arch/spirv:facts",
        "//loom/src/loom/tooling/execution/hal:device_provider",
        "//loom/src/loom/tooling/execution/hal:runtime",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "execution_provider",
    srcs = ["execution_provider.c"],
    hdrs = ["execution_provider.h"],
    target_compatible_with = _SPIRV_VULKAN_HAL_COMPATIBLE_WITH,
    deps = [
        ":device_provider",
        "//loom/src/loom/target/arch/spirv:provider",
        "//loom/src/loom/tooling/execution:execution_provider",
        "//loom/src/loom/tooling/execution/hal:execution_backend",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "testbench_requirements",
