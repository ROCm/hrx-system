iree_executable_test(
    name = "aliased_entry_test",
    src = "//loom/src/loom/tools/iree-run-loom",
    args = [
        "$(rootpath test/multiple_entries.loom)",
        "--device=vulkan",
        "--vulkan_validation_layers=false",
        "--function=@combine",
        "--kernel-input-buffer=1xi32=6",
        "--kernel-input-buffer=1xi32=10",
        "--kernel-input-buffer=1xi32=0",
        "--kernel-input-value=i32=4",
        "--kernel-input-value=i32=5",
        "--expected-kernel-buffer=1xi32=6",
        "--expected-kernel-buffer=1xi32=10",
        "--expected-kernel-buffer=1xi32=25",
    ],
    data = [
        "test/multiple_entries.loom",
    ],
    resource_group = GPU_DEVICE_RESOURCE_GROUP,
    tags = [
        "iree-run-requirement=vulkan.resource.device",
        "runtime-resource=vulkan-device",
    ],
    target_compatible_with = _SPIRV_COMPILE_COMPATIBLE_WITH + _SPIRV_VULKAN_HAL_COMPATIBLE_WITH,
)

loom_generated_file(
    name = "multiple_entries_binary",
    testonly = True,
    args = [
        "$(location test/multiple_entries.loom)",
        "--product=kernel",
        "--target=spirv:vulkan1.3+bda",
    ],
    generator = "//loom/src/loom/tools/loom-compile:loom-compile",
    inputs = ["test/multiple_entries.loom"],
    output = "multiple_entries.spv",
    output_flag = "--output=",
    target_compatible_with = _SPIRV_COMPILE_COMPATIBLE_WITH,
)

iree_c_embed_data(
    name = "multiple_entries_spv",
    testonly = True,
    srcs = [":multiple_entries_binary"],
    c_file_output = "multiple_entries_spv.c",
    h_file_output = "multiple_entries_spv.h",
    identifier = "loom_spirv_multiple_entries",
    target_compatible_with = _SPIRV_COMPILE_COMPATIBLE_WITH,
)

