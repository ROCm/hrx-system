load("//build_tools/bazel:executable.bzl", "iree_executable_test")
load("//build_tools/bazel:test_resources.bzl", "GPU_DEVICE_RESOURCE_GROUP")
load("//build_tools/embed_data:build_defs.bzl", "iree_c_embed_data")
load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_library",
    "loom_cc_test",
    "loom_config_compatible_with",
    "loom_generated_file",
)
load("//loom/build_tools/bazel:defs.bzl", "loom_test")
load(
    ":execution_profiles.bzl",
    "SPIRV_VULKAN_EXPLICIT_TARGET_HARDWARE_PROFILE",
    "SPIRV_VULKAN_HARDWARE_PROFILE",
)

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

LOOM_SPIRV_VULKAN_COMPATIBLE_WITH = loom_config_compatible_with([
    "//runtime/config/hal:driver_vulkan",
])

_SPIRV_COMPILE_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/target:spirv_artifacts",
])

_SPIRV_VULKAN_HAL_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/execute:iree_hal_vulkan",
])

_SPIRV_CHECK_VISIBILITY = ["//loom/src/loom/tools/loom-check:__pkg__"]

_CONFIGURED_WORKGROUP_STORAGE_VARIANTS = {
    "four_stages": {
        "case": "configured_workgroup_four_stages",
        "configs": {"test.buffer.stage_count": "4"},
    },
    "one_stage": {
        "case": "configured_workgroup_one_stage",
        "configs": {"test.buffer.stage_count": "1"},
    },
}

loom_cc_library(
    name = "loom_check",
    srcs = ["check/loom_check.c"],
    hdrs = ["check/loom_check.h"],
    deps = [
        "//loom/src/loom/target/tool:spirv",
        "//loom/src/loom/tools/loom-check:execute",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "check_provider",
    srcs = ["check/provider.c"],
    hdrs = ["check/provider.h"],
    visibility = _SPIRV_CHECK_VISIBILITY,
    deps = [
        ":loom_check",
        "//loom/src/loom/tools/loom-check:provider",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "testbench_requirements",
    srcs = ["testbench_requirements.c"],
    hdrs = ["testbench_requirements.h"],
    target_compatible_with = LOOM_SPIRV_VULKAN_COMPATIBLE_WITH,
    deps = [
        "//loom/binding/c:loomc",
        "//loom/binding/c/target/spirv",
        "//loom/src/loom/tooling/execution/hal:testbench_actual",
        "//loom/src/loom/tooling/testbench:requirements",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal/drivers/vulkan:device_spec",
    ],
)

loom_test(
    name = "vulkan_explicit_target_tests",
    srcs = ["test/spirv_vulkan_hal_actual.loom"],
    compile_targets = ["//loom/target/spirv:vulkan1.3+bda"],
    execution_profiles = [SPIRV_VULKAN_EXPLICIT_TARGET_HARDWARE_PROFILE],
)

loom_test(
    name = "cxx_configured_workgroup_storage_test",
    benchmark_smoke = False,
    execution_profiles = [SPIRV_VULKAN_HARDWARE_PROFILE],
    module = "//loom/src/loom/import/cxx/test:configured_workgroup_storage_module",
    target_compatible_with = loom_config_compatible_with(["//loom/config/import:cxx"]),
    variants = _CONFIGURED_WORKGROUP_STORAGE_VARIANTS,
)

[
    loom_test(
        name = "cxx_" + module + "_test",
        execution_profiles = [SPIRV_VULKAN_HARDWARE_PROFILE],
        module = "//loom/src/loom/import/cxx/test:" + module + "_module",
        target_compatible_with = loom_config_compatible_with(["//loom/config/import:cxx"]),
    )
    for module in [
        "packed_byte_arithmetic",
        "packed_float8_conversion",
        "pointer_origins",
        "vector_lookup",
        "workload_configuration",
    ]
]

loom_test(
    name = "buffer_selection_test",
    srcs = ["//loom/src/loom/test/corpus/source_low:buffer_selection.loom"],
    compile_targets = ["//loom/target/spirv:vulkan1.3+bda"],
    execution_profiles = [SPIRV_VULKAN_HARDWARE_PROFILE],
)

loom_test(
    name = "vulkan_tests",
    srcs = [
        "test/multiple_entries.loom",
        "test/spirv_vulkan_atomic_hal_actual.loom",
        "test/spirv_vulkan_coop_hal_actual.loom",
        "test/spirv_vulkan_coop_u8_hal_actual.loom",
        "test/spirv_vulkan_hal_actual.loom",
        "test/spirv_vulkan_integer_hal_actual.loom",
        "test/spirv_vulkan_quantized_hal_actual.loom",
        "test/spirv_vulkan_vector_float.loom",
        "test/spirv_vulkan_workgroup_offsets.loom",
        "//loom/src/loom/test/corpus/checked_benchmarks:moe_routed_combine_loop_f32.loom",
    ],
    execution_profiles = [SPIRV_VULKAN_HARDWARE_PROFILE],
)

loom_test(
    name = "vulkan_extended_types_tests",
    srcs = [
        "//loom/src/loom/test/corpus/checked_benchmarks:split_kv_online_softmax_combine_f32.loom",
        "//loom/src/loom/test/corpus/checked_benchmarks:split_kv_online_softmax_combine_f32_benchmark.loom",
    ],
    compile_targets = ["//loom/target/spirv:vulkan1.3+bda+extended-types"],
)

iree_executable_test(
    name = "aliased_entry_test",
    src = "//loom/src/loom/tools/iree-run-loom",
    args = [
        "$(rootpath test/multiple_entries.loom)",
        "--device=vulkan",
        "--vulkan_validation_layers=false",
        "--root=@combine",
        "--kernel-input-buffer=1xi32=6",
        "--kernel-input-buffer=1xi32=10",
        "--kernel-input-buffer=1xi32=0",
        "--kernel-input-value=i32=4",
        "--kernel-input-value=i32=5",
        "--expected-kernel-buffer=1xi32=6",
        "--expected-kernel-buffer=1xi32=10",
        "--expected-kernel-buffer=1xi32=25",
    ],
    data = [
        "test/multiple_entries.loom",
    ],
    resource_group = GPU_DEVICE_RESOURCE_GROUP,
    tags = [
        "iree-run-requirement=vulkan.resource.device",
        "runtime-resource=vulkan-device",
    ],
    target_compatible_with = _SPIRV_COMPILE_COMPATIBLE_WITH + _SPIRV_VULKAN_HAL_COMPATIBLE_WITH,
)

loom_generated_file(
    name = "multiple_entries_binary",
    testonly = True,
    args = [
        "$(location test/multiple_entries.loom)",
        "--target=spirv:vulkan1.3+bda",
    ],
    generator = "//loom/src/loom/tools/loom-compile:loom-compile",
    inputs = ["test/multiple_entries.loom"],
    output = "multiple_entries.spv",
    output_flag = "--output=",
    target_compatible_with = _SPIRV_COMPILE_COMPATIBLE_WITH,
)

iree_c_embed_data(
    name = "multiple_entries_spv",
    testonly = True,
    srcs = [":multiple_entries_binary"],
    c_file_output = "multiple_entries_spv.c",
    h_file_output = "multiple_entries_spv.h",
    identifier = "loom_spirv_multiple_entries",
    target_compatible_with = _SPIRV_COMPILE_COMPATIBLE_WITH,
)

loom_cc_test(
    name = "artifact_execution_test",
    srcs = [
        "artifact_execution_test.cc",
        "//runtime/src/iree/hal/cts/util:test_main.cc",
    ],
    args = ["--vulkan_validation_layers=false"],
    resource_group = GPU_DEVICE_RESOURCE_GROUP,
    tags = [
        "iree-run-requirement=vulkan.resource.device",
        "runtime-resource=vulkan-device",
    ],
    target_compatible_with = LOOM_SPIRV_VULKAN_COMPATIBLE_WITH,
    deps = [
        ":multiple_entries_spv",
        "//runtime/src/iree/base/tooling:flags",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/cts/util:registry",
        "//runtime/src/iree/hal/cts/util:test_base",
        "//runtime/src/iree/hal/drivers/vulkan/cts:backends",
        "//runtime/src/iree/testing:gtest",
    ],
)

loom_generated_file(
    name = "float8_memory_binary",
    testonly = True,
    args = [
        "$(location //loom/src/loom/test/corpus/source_low:memory_float8_conversion.loom)",
        "--target=spirv:vulkan1.3+bda+extended-types",
    ],
    generator = "//loom/src/loom/tools/loom-compile:loom-compile",
    inputs = ["//loom/src/loom/test/corpus/source_low:memory_float8_conversion.loom"],
    output = "float8_memory.spv",
    output_flag = "--output=",
    target_compatible_with = _SPIRV_COMPILE_COMPATIBLE_WITH,
)

iree_c_embed_data(
    name = "float8_memory_spv",
    testonly = True,
    srcs = [":float8_memory_binary"],
    c_file_output = "float8_memory_spv.c",
    h_file_output = "float8_memory_spv.h",
    identifier = "loom_spirv_float8_memory",
    target_compatible_with = _SPIRV_COMPILE_COMPATIBLE_WITH,
)

loom_cc_test(
    name = "float8_memory_test",
    srcs = [
        "float8_memory_test.cc",
        "//runtime/src/iree/hal/cts/util:test_main.cc",
    ],
    args = ["--vulkan_validation_layers=false"],
    resource_group = GPU_DEVICE_RESOURCE_GROUP,
    tags = [
        "iree-run-requirement=vulkan.resource.device",
        "runtime-resource=vulkan-device",
    ],
    target_compatible_with = _SPIRV_COMPILE_COMPATIBLE_WITH + LOOM_SPIRV_VULKAN_COMPATIBLE_WITH,
    deps = [
        ":float8_memory_spv",
        "//runtime/src/iree/base/tooling:flags",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/cts/util:registry",
        "//runtime/src/iree/hal/cts/util:test_base",
        "//runtime/src/iree/hal/drivers/vulkan/cts:backends",
        "//runtime/src/iree/testing:gtest",
    ],
)
