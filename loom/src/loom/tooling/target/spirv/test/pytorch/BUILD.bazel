load("@loom_oracle_test_pip//:requirements.bzl", "requirement")
load("//build_tools/bazel:test_resources.bzl", "GPU_DEVICE_RESOURCE_GROUP")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")
load("//loom/build_tools/bazel:python.bzl", "loom_py_test")

package(default_visibility = ["//visibility:private"])

loom_py_test(
    name = "capture_test",
    size = "small",
    srcs = [
        "//loom/docs/examples/workflows/oracles/pytorch:capture_test.py",
    ],
    args = [
        "$(rootpath //loom/src/loom/tools/loom-test)",
        "$(rootpath //loom/src/loom/tools/loom-benchmark)",
        "$(rootpath //loom/docs/examples/workflows/oracles/pytorch:replay.loom)",
        "vulkan",
        "CaptureTest.test_real_reference_capture_replays_through_loom",
        "CaptureTest.test_benchmark_capture_is_only_in_correctness_phase",
    ],
    data = [
        "//loom/docs/examples/workflows/oracles/pytorch:replay.loom",
        "//loom/src/loom/tools/loom-benchmark",
        "//loom/src/loom/tools/loom-test",
    ],
    env = {"OMP_NUM_THREADS": "1"},
    main = "//loom/docs/examples/workflows/oracles/pytorch:capture_test.py",
    resource_group = GPU_DEVICE_RESOURCE_GROUP,
    tags = [
        "iree-run-requirement=vulkan.resource.device",
        "manual",
    ],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/execute:spirv_vulkan_hal",
        "//loom/config/execute:vm_iree_vm",
    ]) + [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = [
        "//loom/docs/examples/workflows/oracles/pytorch:capture",
        requirement("numpy"),
        requirement("torch"),
    ],
)
