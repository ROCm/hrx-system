{
  "version": 1,
  "cases": [
    {
      "name": "runs spirv vulkan scalar benchmark with bundle",
      "run": {
        "tool": "iree-benchmark-loom",
        "args": [
          "{srcdir}/spirv_vulkan_hal_actual.loom",
          "--benchmark=@double_i32_at_byte_offset",
          "--device=vulkan",
          "--vulkan_validation_layers=false",
          "--measure=dispatch_complete",
          "--iterations=1",
          "--warmup-iterations=0",
          "--batch-size=1",
          "--min-time-ms=0",
          "--max-batches=1",
          "--input-ring-count=1",
          "--output-format=jsonl",
          "--artifact-bundle-dir={tmp}/spirv.bundle",
          "--artifact-bundle-policy=debug"
        ]
      },
      "files": [
        {
          "path": "{tmp}/spirv.bundle/results.jsonl",
          "non_empty": true
        },
        {
          "path": "{tmp}/spirv.bundle/manifest.json",
          "non_empty": true
        }
      ]
    },
    {
      "name": "runs spirv vulkan scalar case end to end benchmark",
      "run": {
        "tool": "iree-benchmark-loom",
        "args": [
          "{srcdir}/spirv_vulkan_hal_actual.loom",
          "--benchmark=@double_i32_at_byte_offset",
          "--device=vulkan",
          "--vulkan_validation_layers=false",
          "--measure=case_end_to_end",
          "--iterations=1",
          "--warmup-iterations=0",
          "--output-format=jsonl"
        ]
      },
      "stdout": {
        "contains": [
          "\"measure\":\"case_end_to_end\"",
          "\"row\":\"compile\"",
          "\"entry\":\"double_i32_at_byte_offset\"",
          "\"row\":\"sample\"",
          "\"passed\":true",
          "\"row\":\"benchmark\"",
          "\"failures\":{\"row_count\":0,\"failed_benchmark_count\":0}"
        ]
      }
    },
    {
      "name": "runs ordered spirv vulkan A/B/A dispatch benchmark",
      "run": {
        "tool": "iree-benchmark-loom",
        "args": [
          "{srcdir}/spirv_vulkan_hal_actual.loom",
          "--benchmark=@ordered_dispatch_aba",
          "--device=vulkan",
          "--vulkan_validation_layers=false",
          "--measure=dispatch_complete",
          "--iterations=1",
          "--warmup-iterations=0",
          "--batch-size=1",
          "--min-time-ms=0",
          "--max-batches=1",
          "--input-ring-count=1",
          "--output-format=jsonl"
        ]
      },
      "stdout": {
        "contains": [
          "\"row\":\"sample\"",
          "\"case\":\"ordered_dispatch_aba_case\"",
          "\"passed\":true",
          "\"row\":\"benchmark\"",
          "\"benchmark\":\"ordered_dispatch_aba\"",
          "\"physical_dispatches_per_logical_operation\":3",
          "\"failures\":{\"row_count\":0,\"failed_benchmark_count\":0}"
        ]
      }
    },
    {
      "name": "runs ordered spirv vulkan A/B/A case end to end benchmark",
      "run": {
        "tool": "iree-benchmark-loom",
        "args": [
          "{srcdir}/spirv_vulkan_hal_actual.loom",
          "--benchmark=@ordered_dispatch_aba",
          "--device=vulkan",
          "--vulkan_validation_layers=false",
          "--measure=case_end_to_end",
          "--iterations=1",
          "--warmup-iterations=0",
          "--output-format=jsonl"
        ]
      },
      "stdout": {
        "contains": [
          "\"measure\":\"case_end_to_end\"",
          "\"kernel_launch_count\":3",
          "\"entry\":\"increment_i32\"",
          "\"entry\":\"double_i32\"",
          "\"case\":\"ordered_dispatch_aba_case\"",
          "\"passed\":true",
          "\"failures\":{\"row_count\":0,\"failed_benchmark_count\":0}"
        ]
      }
    },
    {
      "name": "runs spirv vulkan cooperative f16 benchmark",
      "run": {
        "tool": "iree-benchmark-loom",
        "args": [
          "{srcdir}/spirv_vulkan_coop_hal_actual.loom",
          "--benchmark=@dense_projection_tiled_f16_128",
          "--device=vulkan",
          "--vulkan_validation_layers=false",
          "--measure=dispatch_complete",
          "--iterations=1",
          "--warmup-iterations=0",
          "--batch-size=1",
          "--min-time-ms=0",
          "--max-batches=1",
          "--input-ring-count=1",
          "--output-format=jsonl"
        ]
      },
      "stdout": {
        "contains": [
          "\"row\":\"plan\"",
          "\"benchmark\":\"dense_projection_tiled_f16_128\"",
          "\"measure\":\"dispatch_complete\"",
          "\"row\":\"benchmark\"",
          "\"row\":\"summary\"",
          "\"failures\":{\"row_count\":0,\"failed_benchmark_count\":0}"
        ]
      }
    },
    {
      "name": "runs spirv vulkan comparison benchmark",
      "run": {
        "tool": "iree-benchmark-loom",
        "args": [
          "{srcdir}/spirv_vulkan_coop_hal_actual.loom",
          "--compare=@narrow_score_tiled_f16_128x16_m1,@narrow_score_tiled_f16_128x16_m2",
          "--device=vulkan",
          "--vulkan_validation_layers=false",
          "--measure=dispatch_complete",
          "--iterations=1",
          "--warmup-iterations=0",
          "--batch-size=1",
          "--min-time-ms=0",
          "--max-batches=1",
          "--input-ring-count=1",
          "--repetitions=1",
          "--output-format=jsonl"
        ]
      },
      "stdout": {
        "contains": [
          "\"row\":\"comparison\"",
          "\"method\":\"ABABA\"",
          "\"benchmark_count\":3",
          "\"selected_benchmark_count\":2",
          "\"failures\":{\"row_count\":0,\"failed_benchmark_count\":0}"
        ]
      }
    },
    {
      "name": "runs explicit serial spirv vulkan dispatch benchmark",
      "run": {
        "tool": "iree-benchmark-loom",
        "args": [
          "{srcdir}/../../../execution/hal/testdata/launch_schedule_hal_actual.loom",
          "--benchmark=@launch_schedule_serial",
          "--device=vulkan",
          "--vulkan_validation_layers=false",
          "--measure=dispatch_complete",
          "--iterations=1",
          "--warmup-iterations=0",
          "--batch-size=1",
          "--min-time-ms=0",
          "--max-batches=1",
          "--input-ring-count=1",
          "--output-format=jsonl"
        ]
      },
      "stdout": {
        "contains": [
          "\"row\":\"plan\"",
          "\"benchmark\":\"launch_schedule_serial\"",
          "\"case\":\"launch_schedule_serial_case\"",
          "\"kernel_launch_count\":3",
          "\"correctness\":{\"sample_count\":1,\"failed_sample_count\":0}",
          "\"physical_dispatches_per_logical_operation\":3",
          "\"failures\":{\"row_count\":0,\"failed_benchmark_count\":0}"
        ]
      }
    }
  ]
}
