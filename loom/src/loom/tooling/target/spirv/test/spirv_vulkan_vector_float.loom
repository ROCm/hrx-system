// Component-wise float arithmetic through the Vulkan source compiler.
// Distinct negative lanes expose dropped components and signed remainders.
// Loop-carried results exercise native vector values through control flow.
spirv.target<vulkan1_3> @target {abi = hal_kernel}

kernel.def target(@target) @vector_float_f16_2() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%count: index, %lhs_buffer: buffer, %rhs_buffer: buffer, %add_buffer: buffer, %sub_buffer: buffer, %mul_buffer: buffer, %div_buffer: buffer, %rem_buffer: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %lhs_aligned = buffer.assume.alignment %lhs_buffer {minimum_alignment = 2} : buffer
  %lhs_view = buffer.view %lhs_aligned[%base] : buffer -> view<2xf16>
  %rhs_aligned = buffer.assume.alignment %rhs_buffer {minimum_alignment = 2} : buffer
  %rhs_view = buffer.view %rhs_aligned[%base] : buffer -> view<2xf16>
  %add_aligned = buffer.assume.alignment %add_buffer {minimum_alignment = 2} : buffer
  %add_view = buffer.view %add_aligned[%base] : buffer -> view<2xf16>
  %sub_aligned = buffer.assume.alignment %sub_buffer {minimum_alignment = 2} : buffer
  %sub_view = buffer.view %sub_aligned[%base] : buffer -> view<2xf16>
  %mul_aligned = buffer.assume.alignment %mul_buffer {minimum_alignment = 2} : buffer
  %mul_view = buffer.view %mul_aligned[%base] : buffer -> view<2xf16>
  %div_aligned = buffer.assume.alignment %div_buffer {minimum_alignment = 2} : buffer
  %div_view = buffer.view %div_aligned[%base] : buffer -> view<2xf16>
  %rem_aligned = buffer.assume.alignment %rem_buffer {minimum_alignment = 2} : buffer
  %rem_view = buffer.view %rem_aligned[%base] : buffer -> view<2xf16>
  %lhs = vector.load %lhs_view[0] : view<2xf16> -> vector<2xf16>
  %rhs = vector.load %rhs_view[0] : view<2xf16> -> vector<2xf16>
  %add, %sub, %mul, %div, %rem = scf.for %iteration = [%begin to %count step %step](%add_accumulator = %lhs : vector<2xf16>, %sub_accumulator = %lhs : vector<2xf16>, %mul_accumulator = %lhs : vector<2xf16>, %div_accumulator = %lhs : vector<2xf16>, %rem_accumulator = %lhs : vector<2xf16>) -> (vector<2xf16>, vector<2xf16>, vector<2xf16>, vector<2xf16>, vector<2xf16>) {
    %add_next = vector.addf %add_accumulator, %rhs : vector<2xf16>
    %sub_next = vector.subf %sub_accumulator, %rhs : vector<2xf16>
    %mul_next = vector.mulf %mul_accumulator, %rhs : vector<2xf16>
    %div_next = vector.divf %div_accumulator, %rhs : vector<2xf16>
    %rem_next = vector.remf %rem_accumulator, %rhs : vector<2xf16>
    scf.yield %add_next, %sub_next, %mul_next, %div_next, %rem_next : vector<2xf16>, vector<2xf16>, vector<2xf16>, vector<2xf16>, vector<2xf16>
  }
  vector.store %add, %add_view[0] : vector<2xf16>, view<2xf16>
  vector.store %sub, %sub_view[0] : vector<2xf16>, view<2xf16>
  vector.store %mul, %mul_view[0] : vector<2xf16>, view<2xf16>
  vector.store %div, %div_view[0] : vector<2xf16>, view<2xf16>
  vector.store %rem, %rem_view[0] : vector<2xf16>, view<2xf16>
  kernel.return
}

check.case @vector_float_f16_2_case {
  check.requires<hal.vulkan.feature> {feature = "shader_float16"}
  check.requires<hal.vulkan.feature> {feature = "storage_buffer_16bit_access"}
  %lhs = check.generate.iota offset(-15.0) step(4.0) : tensor<2xf16>
  %rhs = check.generate.fill value(2.0) : tensor<2xf16>
  %add = check.generate.fill value(99.0) : tensor<2xf16>
  %sub = check.generate.fill value(99.0) : tensor<2xf16>
  %mul = check.generate.fill value(99.0) : tensor<2xf16>
  %div = check.generate.fill value(99.0) : tensor<2xf16>
  %rem = check.generate.fill value(99.0) : tensor<2xf16>
  %count = check.literal value(1) : index
  kernel.launch @vector_float_f16_2(%count, %lhs, %rhs, %add, %sub, %mul, %div, %rem) : (index, tensor<2xf16>, tensor<2xf16>, tensor<2xf16>, tensor<2xf16>, tensor<2xf16>, tensor<2xf16>, tensor<2xf16>)
  %add_expected = check.generate.iota offset(-13.0) step(4.0) : tensor<2xf16>
  %sub_expected = check.generate.iota offset(-17.0) step(4.0) : tensor<2xf16>
  %mul_expected = check.generate.iota offset(-30.0) step(8.0) : tensor<2xf16>
  %div_expected = check.generate.iota offset(-7.5) step(2.0) : tensor<2xf16>
  %rem_expected = check.generate.iota offset(-1.0) step(0.0) : tensor<2xf16>
  check.expect.bitwise actual(%add) expected(%add_expected) : tensor<2xf16>
  check.expect.bitwise actual(%sub) expected(%sub_expected) : tensor<2xf16>
  check.expect.bitwise actual(%mul) expected(%mul_expected) : tensor<2xf16>
  check.expect.bitwise actual(%div) expected(%div_expected) : tensor<2xf16>
  check.expect.bitwise actual(%rem) expected(%rem_expected) : tensor<2xf16>
  check.return
}

