template.decl @uniform_matrix_s8(%output: buffer, %a: i8, %b: i8, %c: i32)

template.def<@uniform_matrix_s8> @uniform_matrix_s8_impl(%output: buffer, %a: i8, %b: i8, %c: i32) {
  %lanes = config.get @initializer.carrier_width : index
  %base = index.constant 0 : offset
  %m = index.constant 16 : index
  %k = index.constant 32 : index
  %unit = index.constant 1 : index
  %aligned = buffer.assume.alignment %output {minimum_alignment = 16} : buffer
  %output_storage = encoding.define #encoding.storage<layout=#encoding.layout.dense, schema=#encoding.operand<element_format=i32, payload_elements=8, payload_registers=8>> : encoding<storage>
  %view = buffer.view %aligned[%base] : buffer -> view<16x16xi32, %output_storage>
  %a_values = vector.splat %a : vector<[%lanes]xi8>
  %b_values = vector.splat %b : vector<[%lanes]xi8>
  %c_values = vector.splat %c : vector<[%lanes]xi32>
  %lhs = vector.fragment<lhs> %a_values shape [blocks(%unit), %m, %k] : vector<[%lanes]xi8>
  %rhs = vector.fragment<rhs> %b_values shape [blocks(%unit), %k, %m] : vector<[%lanes]xi8>
  %init = vector.fragment<init> %c_values shape [blocks(%unit), %m, %m] : vector<[%lanes]xi32>
  %result = vector.mma<saturate> %lhs, %rhs, %init : vector<[%lanes]xi8>, vector<[%lanes]xi8>, vector<[%lanes]xi32>
  vector.fragment.store<result> %result, %view[0, 0] shape [%m, %m] : vector<[%lanes]xi32>, view<16x16xi32, %output_storage>
  template.return
}

