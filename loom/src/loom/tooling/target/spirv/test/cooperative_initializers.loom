// The same runtime splat feeds ordinary vector storage and an opaque
// accumulator. A zero-trip loop must publish the initializer unchanged.
template.decl @initializer_loop(%count: index, %value: f32, %output: buffer, %ordinary: buffer)

template.def<@initializer_loop> @initializer_loop_impl(%count: index, %value: f32, %output: buffer, %ordinary: buffer) {
  %lanes = config.get @initializer.carrier_width : index
  %base = index.constant 0 : offset
  %start = index.constant 0 : index
  %unit = index.constant 1 : index
  %size = index.constant 16 : index
  %aligned = buffer.assume.alignment %output {minimum_alignment = 16} : buffer
  %view = buffer.view %aligned[%base] : buffer -> view<16x16xf32>
  %ordinary_aligned = buffer.assume.alignment %ordinary {minimum_alignment = 16} : buffer
  %ordinary_view = buffer.view %ordinary_aligned[%base] : buffer -> view<8xf32>
  %ordinary_size = index.constant 8 : index
  %a = vector.splatf -2.0 : vector<[%lanes]xf16>
  %b = vector.splatf 3.0 : vector<[%lanes]xf16>
  %initial_values = vector.splat %value : vector<[%lanes]xf32>
  %lhs = vector.fragment<lhs> %a shape [%size, %size] : vector<[%lanes]xf16>
  %rhs = vector.fragment<rhs> %b shape [%size, %size] : vector<[%lanes]xf16>
  %init = vector.fragment<init> %initial_values shape [%size, %size] : vector<[%lanes]xf32>
  %lane = kernel.workitem.id<x> : index
  %writer = index.cmp eq, %lane, %start : index
  scf.if %writer {
    scf.for %chunk = [%start to %ordinary_size step %lanes] {
      vector.store %initial_values, %ordinary_view[%chunk] : vector<[%lanes]xf32>, view<8xf32>
    }
  }
  %result = scf.for %iteration = [%start to %count step %unit](%accumulator = %init : vector<[%lanes]xf32>) -> (vector<[%lanes]xf32>) {
    %next = vector.mma %lhs, %rhs, %accumulator : vector<[%lanes]xf16>, vector<[%lanes]xf16>, vector<[%lanes]xf32>
    scf.yield %next : vector<[%lanes]xf32>
  }
  vector.fragment.store<result> %result, %view[0, 0] shape [%size, %size] : vector<[%lanes]xf32>, view<16x16xf32>
  template.return
}

kernel.def target(@wave32) @initializer_loop32() {
  %unit = index.constant 1 : index
  %width = target.subgroup.size : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%count: index, %value: f32, %output: buffer, %ordinary: buffer) {
  template.apply<@initializer_loop>(%count, %value, %output, %ordinary) : (index, f32, buffer, buffer)
  kernel.return
}

check.case @initializer_loop32_count0 {
  check.requires<hal.vulkan.feature> {feature = "cooperative_matrix_khr"}
  check.requires<hal.vulkan.feature> {feature = "shader_float16"}
  check.requires<hal.spirv.cooperative_matrix> {row = "khr.cooperative_matrix.f16.16x16x16.f32.subgroup"}
  %count = check.literal value(0) : index
  %value = check.literal value(7.0) : f32
  %output = check.generate.fill value(19.0) : tensor<16x16xf32>
  %ordinary = check.generate.fill value(19.0) : tensor<8xf32>
  %expected = check.generate.fill value(7.0) : tensor<16x16xf32>
  %ordinary_expected = check.generate.fill value(7.0) : tensor<8xf32>
  kernel.launch @initializer_loop32(%count, %value, %output, %ordinary) : (index, f32, tensor<16x16xf32>, tensor<8xf32>)
  check.expect.bitwise actual(%output) expected(%expected) : tensor<16x16xf32>
  check.expect.bitwise actual(%ordinary) expected(%ordinary_expected) : tensor<8xf32>
  check.return
}

