  check.requires<hal.spirv.cooperative_matrix> {row = "khr.cooperative_matrix.u8.16x16x32.u32.subgroup"}
  %output = check.generate.fill value(19) : tensor<16x16xi32>
  %expected = check.generate.fill value(16317) : tensor<16x16xi32>
  kernel.launch @uniform_matrix_u8_constant_32(%output) : (tensor<16x16xi32>)
  check.expect.bitwise actual(%output) expected(%expected) : tensor<16x16xi32>
  check.return
}

