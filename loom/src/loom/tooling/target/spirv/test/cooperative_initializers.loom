// Uniform constructors cover floating-point and integer cooperative matrices.
// Carrier widths vary independently of subgroup width. The full output tile
// checks K*a*b+c, with modulo-2^32 accumulation for the unsigned payload.

config.decl @initializer.carrier_width : %value: index where [range(%value, 1, 8)]

spirv.target<vulkan1_3> @wave32 {abi = hal_kernel, subgroup_size = 32}

spirv.target<vulkan1_3> @wave64 {abi = hal_kernel, subgroup_size = 64}

template.decl @uniform_matrix_f16(%output: buffer, %a: f16, %b: f16, %c: f32)

template.def<@uniform_matrix_f16> @uniform_matrix_f16_impl(%output: buffer, %a: f16, %b: f16, %c: f32) {
  %lanes = config.get @initializer.carrier_width : index
  %base = index.constant 0 : offset
  %m = index.constant 16 : index
  %k = index.constant 16 : index
  %unit = index.constant 1 : index
  %aligned = buffer.assume.alignment %output {minimum_alignment = 16} : buffer
  %view = buffer.view %aligned[%base] : buffer -> view<16x16xf32>
  %a_values = vector.splat %a : vector<[%lanes]xf16>
  %b_values = vector.splat %b : vector<[%lanes]xf16>
  %c_values = vector.splat %c : vector<[%lanes]xf32>
  %lhs = vector.fragment<lhs> %a_values shape [blocks(%unit), %m, %k] : vector<[%lanes]xf16>
  %rhs = vector.fragment<rhs> %b_values shape [blocks(%unit), %k, %m] : vector<[%lanes]xf16>
  %init = vector.fragment<init> %c_values shape [blocks(%unit), %m, %m] : vector<[%lanes]xf32>
  %result = vector.mma %lhs, %rhs, %init : vector<[%lanes]xf16>, vector<[%lanes]xf16>, vector<[%lanes]xf32>
  vector.fragment.store<result> %result, %view[0, 0] shape [%m, %m] : vector<[%lanes]xf32>, view<16x16xf32>
  template.return
}

kernel.def target(@wave32) @uniform_matrix_f16_constant_32() {
  %unit = index.constant 1 : index
  %width = target.subgroup.size : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%output: buffer) {
  %a = scalar.constant -2.0 : f16
  %b = scalar.constant 3.0 : f16
  %c = scalar.constant 7.0 : f32
  template.apply<@uniform_matrix_f16>(%output, %a, %b, %c) : (buffer, f16, f16, f32)
  kernel.return
}

check.case @uniform_matrix_f16_constant_32_case {
  check.requires<hal.vulkan.feature> {feature = "cooperative_matrix_khr"}
  check.requires<hal.vulkan.feature> {feature = "shader_float16"}
  check.requires<hal.spirv.cooperative_matrix> {row = "khr.cooperative_matrix.f16.16x16x16.f32.subgroup"}
  %output = check.generate.fill value(19.0) : tensor<16x16xf32>
  %expected = check.generate.fill value(-89.0) : tensor<16x16xf32>
  kernel.launch @uniform_matrix_f16_constant_32(%output) : (tensor<16x16xf32>)
  check.expect.bitwise actual(%output) expected(%expected) : tensor<16x16xf32>
  check.return
}

kernel.def target(@wave32) @uniform_matrix_f16_runtime_32() {
  %unit = index.constant 1 : index
  %width = target.subgroup.size : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%output: buffer, %a: f16, %b: f16, %c: f32) {
  template.apply<@uniform_matrix_f16>(%output, %a, %b, %c) : (buffer, f16, f16, f32)
  kernel.return
}

