template.decl @uniform_matrix_bf16(%output: buffer, %a: bf16, %b: bf16, %c: f32)

template.def<@uniform_matrix_bf16> @uniform_matrix_bf16_impl(%output: buffer, %a: bf16, %b: bf16, %c: f32) {
  %lanes = config.get @initializer.carrier_width : index
  %base = index.constant 0 : offset
  %m = index.constant 16 : index
  %k = index.constant 16 : index
  %unit = index.constant 1 : index
  %aligned = buffer.assume.alignment %output {minimum_alignment = 16} : buffer
  %input_schema = encoding.define #encoding.operand<element_format=bf16, payload_elements=32, payload_registers=8> : encoding<schema>
  %acc_schema = encoding.define #encoding.operand<element_format=f32, payload_elements=8, payload_registers=8> : encoding<schema>
  %output_storage = encoding.define #encoding.storage<layout=#encoding.layout.dense, schema=#encoding.operand<element_format=f32, payload_elements=8, payload_registers=8>> : encoding<storage>
  %view = buffer.view %aligned[%base] : buffer -> view<16x16xf32, %output_storage>
  %a_values = vector.splat %a : vector<[%lanes]xbf16>
  %b_values = vector.splat %b : vector<[%lanes]xbf16>
  %c_values = vector.splat %c : vector<[%lanes]xf32>
  %lhs = vector.fragment<lhs> %a_values shape [blocks(%unit), %m, %k] using {schema = %input_schema : encoding<schema>} : vector<[%lanes]xbf16>
  %rhs = vector.fragment<rhs> %b_values shape [blocks(%unit), %k, %m] using {schema = %input_schema : encoding<schema>} : vector<[%lanes]xbf16>
  %init = vector.fragment<init> %c_values shape [blocks(%unit), %m, %m] using {schema = %acc_schema : encoding<schema>} : vector<[%lanes]xf32>
  %result = vector.mma %lhs, %rhs, %init : vector<[%lanes]xbf16>, vector<[%lanes]xbf16>, vector<[%lanes]xf32>
  vector.fragment.store<result> %result, %view[0, 0] shape [%m, %m] : vector<[%lanes]xf32>, view<16x16xf32, %output_storage>
  template.return
}

