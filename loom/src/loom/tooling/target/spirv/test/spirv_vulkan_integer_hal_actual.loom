spirv.target<vulkan1_3> @target {abi = hal_kernel}

kernel.def target(@target) @integer_i32_truth_table() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %value_output: buffer, %comparison_output: buffer, %boolean_output: buffer) {
  %offset0 = index.constant 0 : offset
  %offset4 = index.constant 4 : offset
  %offset8 = index.constant 8 : offset
  %offset12 = index.constant 12 : offset
  %offset16 = index.constant 16 : offset
  %offset20 = index.constant 20 : offset
  %offset24 = index.constant 24 : offset
  %offset28 = index.constant 28 : offset
  %offset32 = index.constant 32 : offset
  %offset36 = index.constant 36 : offset
  %offset40 = index.constant 40 : offset
  %offset44 = index.constant 44 : offset
  %offset48 = index.constant 48 : offset
  %offset52 = index.constant 52 : offset
  %offset56 = index.constant 56 : offset
  %offset60 = index.constant 60 : offset
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %value_output_aligned = buffer.assume.alignment %value_output {minimum_alignment = 4} : buffer
  %comparison_output_aligned = buffer.assume.alignment %comparison_output {minimum_alignment = 4} : buffer
  %boolean_output_aligned = buffer.assume.alignment %boolean_output {minimum_alignment = 4} : buffer
  %input_lhs_view = buffer.view %input_aligned[%offset0] : buffer -> view<1xi32>
  %input_rhs_view = buffer.view %input_aligned[%offset4] : buffer -> view<1xi32>
  %value_output0_view = buffer.view %value_output_aligned[%offset0] : buffer -> view<1xi32>
  %value_output1_view = buffer.view %value_output_aligned[%offset4] : buffer -> view<1xi32>
  %value_output2_view = buffer.view %value_output_aligned[%offset8] : buffer -> view<1xi32>
  %value_output3_view = buffer.view %value_output_aligned[%offset12] : buffer -> view<1xi32>
  %value_output4_view = buffer.view %value_output_aligned[%offset16] : buffer -> view<1xi32>
  %value_output5_view = buffer.view %value_output_aligned[%offset20] : buffer -> view<1xi32>
  %value_output6_view = buffer.view %value_output_aligned[%offset24] : buffer -> view<1xi32>
  %value_output7_view = buffer.view %value_output_aligned[%offset28] : buffer -> view<1xi32>
  %comparison_output0_view = buffer.view %comparison_output_aligned[%offset0] : buffer -> view<1xi32>
  %comparison_output1_view = buffer.view %comparison_output_aligned[%offset4] : buffer -> view<1xi32>
  %comparison_output2_view = buffer.view %comparison_output_aligned[%offset8] : buffer -> view<1xi32>
  %comparison_output3_view = buffer.view %comparison_output_aligned[%offset12] : buffer -> view<1xi32>
  %comparison_output4_view = buffer.view %comparison_output_aligned[%offset16] : buffer -> view<1xi32>
  %comparison_output5_view = buffer.view %comparison_output_aligned[%offset20] : buffer -> view<1xi32>
  %comparison_output6_view = buffer.view %comparison_output_aligned[%offset24] : buffer -> view<1xi32>
  %comparison_output7_view = buffer.view %comparison_output_aligned[%offset28] : buffer -> view<1xi32>
  %comparison_output8_view = buffer.view %comparison_output_aligned[%offset32] : buffer -> view<1xi32>
  %comparison_output9_view = buffer.view %comparison_output_aligned[%offset36] : buffer -> view<1xi32>
  %boolean_output0_view = buffer.view %boolean_output_aligned[%offset0] : buffer -> view<1xi32>
  %boolean_output1_view = buffer.view %boolean_output_aligned[%offset4] : buffer -> view<1xi32>
  %boolean_output2_view = buffer.view %boolean_output_aligned[%offset8] : buffer -> view<1xi32>
  %boolean_output3_view = buffer.view %boolean_output_aligned[%offset12] : buffer -> view<1xi32>
  %boolean_output4_view = buffer.view %boolean_output_aligned[%offset16] : buffer -> view<1xi32>
  %boolean_output5_view = buffer.view %boolean_output_aligned[%offset20] : buffer -> view<1xi32>
  %boolean_output6_view = buffer.view %boolean_output_aligned[%offset24] : buffer -> view<1xi32>
  %boolean_output7_view = buffer.view %boolean_output_aligned[%offset28] : buffer -> view<1xi32>
  %boolean_output8_view = buffer.view %boolean_output_aligned[%offset32] : buffer -> view<1xi32>
  %boolean_output9_view = buffer.view %boolean_output_aligned[%offset36] : buffer -> view<1xi32>
  %boolean_output10_view = buffer.view %boolean_output_aligned[%offset40] : buffer -> view<1xi32>
  %boolean_output11_view = buffer.view %boolean_output_aligned[%offset44] : buffer -> view<1xi32>
  %boolean_output12_view = buffer.view %boolean_output_aligned[%offset48] : buffer -> view<1xi32>
  %boolean_output13_view = buffer.view %boolean_output_aligned[%offset52] : buffer -> view<1xi32>
  %boolean_output14_view = buffer.view %boolean_output_aligned[%offset56] : buffer -> view<1xi32>
  %boolean_output15_view = buffer.view %boolean_output_aligned[%offset60] : buffer -> view<1xi32>

  %lhs = view.load %input_lhs_view[0] : view<1xi32> -> i32
  %rhs = view.load %input_rhs_view[0] : view<1xi32> -> i32
  %cn8 = scalar.constant -8 : i32
  %cn6 = scalar.constant -6 : i32
  %cn1 = scalar.constant -1 : i32
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %c3 = scalar.constant 3 : i32
  %c8 = scalar.constant 8 : i32
  %bitwise_and = scalar.andi %cn6, %cn1 : i32
  %shift_right_arithmetic = scalar.shrsi %cn8, %c1 : i32
  %bitwise_xor = scalar.xori %cn1, %c1 : i32
  %equal = scalar.cmpi eq, %lhs, %rhs : i32
  %selected = scf.select %equal, %c8, %c0 : i32
  %bitwise_or = scalar.ori %c0, %c2 : i32
  %shift_right_logical = scalar.shrui %c8, %c1 : i32
  %shift_left = scalar.shli %c3, %c1 : i32
  view.store %cn8, %value_output0_view[0] : i32, view<1xi32>
  view.store %bitwise_and, %value_output1_view[0] : i32, view<1xi32>
