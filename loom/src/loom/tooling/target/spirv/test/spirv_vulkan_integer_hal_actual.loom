check.case @integer_i8_truth_table_case {
  check.requires<hal.vulkan.feature> {feature = "shader_int8"}
  check.requires<hal.vulkan.feature> {feature = "storage_buffer_8bit_access"}
  %input = check.generate.iota offset(-8) step(14) : tensor<2xi8>
  %value_output = check.generate.fill value(99) : tensor<8xi8>
  %comparison_output = check.generate.fill value(99) : tensor<10xi32>
  kernel.launch @integer_i8_truth_table(%input, %value_output, %comparison_output) : (tensor<2xi8>, tensor<8xi8>, tensor<10xi32>)
  %expected_values = check.generate.iota offset(-8) step(2) : tensor<8xi8>
  %expected_comparisons = check.generate.iota offset(0) step(1) period(2) : tensor<10xi32>
  check.expect.equal actual(%value_output) expected(%expected_values) : tensor<8xi8>
  check.expect.equal actual(%comparison_output) expected(%expected_comparisons) : tensor<10xi32>
  check.return
}

