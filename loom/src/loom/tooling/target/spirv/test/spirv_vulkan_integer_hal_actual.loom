  view.store %bitwise_xor, %value_output3_view[0] : i32, view<1xi32>
  view.store %selected, %value_output4_view[0] : i32, view<1xi32>
  view.store %bitwise_or, %value_output5_view[0] : i32, view<1xi32>
  view.store %shift_right_logical, %value_output6_view[0] : i32, view<1xi32>
  view.store %shift_left, %value_output7_view[0] : i32, view<1xi32>

  %not_equal = scalar.cmpi ne, %lhs, %rhs : i32
  %signed_less = scalar.cmpi slt, %lhs, %rhs : i32
  %signed_less_equal = scalar.cmpi sle, %lhs, %rhs : i32
  %signed_greater = scalar.cmpi sgt, %lhs, %rhs : i32
  %signed_greater_equal = scalar.cmpi sge, %lhs, %rhs : i32
  %unsigned_less = scalar.cmpi ult, %lhs, %rhs : i32
  %unsigned_less_equal = scalar.cmpi ule, %lhs, %rhs : i32
  %unsigned_greater = scalar.cmpi ugt, %lhs, %rhs : i32
  %unsigned_greater_equal = scalar.cmpi uge, %lhs, %rhs : i32
  %equal_i32 = scf.select %equal, %c1, %c0 : i32
  %not_equal_i32 = scf.select %not_equal, %c1, %c0 : i32
  %signed_greater_i32 = scf.select %signed_greater, %c1, %c0 : i32
  %signed_less_i32 = scf.select %signed_less, %c1, %c0 : i32
  %signed_greater_equal_i32 = scf.select %signed_greater_equal, %c1, %c0 : i32
  %signed_less_equal_i32 = scf.select %signed_less_equal, %c1, %c0 : i32
  %unsigned_less_i32 = scf.select %unsigned_less, %c1, %c0 : i32
  %unsigned_greater_i32 = scf.select %unsigned_greater, %c1, %c0 : i32
  %unsigned_less_equal_i32 = scf.select %unsigned_less_equal, %c1, %c0 : i32
  %unsigned_greater_equal_i32 = scf.select %unsigned_greater_equal, %c1, %c0 : i32
  view.store %equal_i32, %comparison_output0_view[0] : i32, view<1xi32>
  view.store %not_equal_i32, %comparison_output1_view[0] : i32, view<1xi32>
  view.store %signed_greater_i32, %comparison_output2_view[0] : i32, view<1xi32>
  view.store %signed_less_i32, %comparison_output3_view[0] : i32, view<1xi32>
  view.store %signed_greater_equal_i32, %comparison_output4_view[0] : i32, view<1xi32>
  view.store %signed_less_equal_i32, %comparison_output5_view[0] : i32, view<1xi32>
  view.store %unsigned_less_i32, %comparison_output6_view[0] : i32, view<1xi32>
  view.store %unsigned_greater_i32, %comparison_output7_view[0] : i32, view<1xi32>
  view.store %unsigned_less_equal_i32, %comparison_output8_view[0] : i32, view<1xi32>
  view.store %unsigned_greater_equal_i32, %comparison_output9_view[0] : i32, view<1xi32>

  %constant_false = scalar.constant false : i1
  %constant_true = scalar.constant true : i1
  %and_false_false = scalar.andi %equal, %equal : i1
  %and_true_true = scalar.andi %not_equal, %not_equal : i1
  %and_false_true = scalar.andi %equal, %not_equal : i1
  %or_false_true = scalar.ori %equal, %not_equal : i1
  %and_true_false = scalar.andi %not_equal, %equal : i1
  %or_true_false = scalar.ori %not_equal, %equal : i1
  %or_false_false = scalar.ori %equal, %equal : i1
  %or_true_true = scalar.ori %not_equal, %not_equal : i1
  %xor_false_false = scalar.xori %equal, %equal : i1
  %xor_false_true = scalar.xori %equal, %not_equal : i1
  %xor_true_true = scalar.xori %not_equal, %not_equal : i1
  %xor_true_false = scalar.xori %not_equal, %equal : i1
  %select_false = scf.select %equal, %not_equal, %equal : i1
  %select_true = scf.select %not_equal, %not_equal, %equal : i1
  %constant_false_i32 = scf.select %constant_false, %c1, %c0 : i32
  %constant_true_i32 = scf.select %constant_true, %c1, %c0 : i32
  %and_false_false_i32 = scf.select %and_false_false, %c1, %c0 : i32
  %and_true_true_i32 = scf.select %and_true_true, %c1, %c0 : i32
  %and_false_true_i32 = scf.select %and_false_true, %c1, %c0 : i32
  %or_false_true_i32 = scf.select %or_false_true, %c1, %c0 : i32
  %and_true_false_i32 = scf.select %and_true_false, %c1, %c0 : i32
  %or_true_false_i32 = scf.select %or_true_false, %c1, %c0 : i32
  %or_false_false_i32 = scf.select %or_false_false, %c1, %c0 : i32
  %or_true_true_i32 = scf.select %or_true_true, %c1, %c0 : i32
  %xor_false_false_i32 = scf.select %xor_false_false, %c1, %c0 : i32
  %xor_false_true_i32 = scf.select %xor_false_true, %c1, %c0 : i32
  %xor_true_true_i32 = scf.select %xor_true_true, %c1, %c0 : i32
  %xor_true_false_i32 = scf.select %xor_true_false, %c1, %c0 : i32
  %select_false_i32 = scf.select %select_false, %c1, %c0 : i32
  %select_true_i32 = scf.select %select_true, %c1, %c0 : i32
  view.store %constant_false_i32, %boolean_output0_view[0] : i32, view<1xi32>
  view.store %constant_true_i32, %boolean_output1_view[0] : i32, view<1xi32>
  view.store %and_false_false_i32, %boolean_output2_view[0] : i32, view<1xi32>
  view.store %and_true_true_i32, %boolean_output3_view[0] : i32, view<1xi32>
  view.store %and_false_true_i32, %boolean_output4_view[0] : i32, view<1xi32>
  view.store %or_false_true_i32, %boolean_output5_view[0] : i32, view<1xi32>
  view.store %and_true_false_i32, %boolean_output6_view[0] : i32, view<1xi32>
  view.store %or_true_false_i32, %boolean_output7_view[0] : i32, view<1xi32>
  view.store %or_false_false_i32, %boolean_output8_view[0] : i32, view<1xi32>
  view.store %or_true_true_i32, %boolean_output9_view[0] : i32, view<1xi32>
  view.store %xor_false_false_i32, %boolean_output10_view[0] : i32, view<1xi32>
  view.store %xor_false_true_i32, %boolean_output11_view[0] : i32, view<1xi32>
  view.store %xor_true_true_i32, %boolean_output12_view[0] : i32, view<1xi32>
  view.store %xor_true_false_i32, %boolean_output13_view[0] : i32, view<1xi32>
  view.store %select_false_i32, %boolean_output14_view[0] : i32, view<1xi32>
  view.store %select_true_i32, %boolean_output15_view[0] : i32, view<1xi32>
  kernel.return
}

check.case @integer_i32_truth_table_case {
  %input = check.generate.iota offset(-8) step(14) : tensor<2xi32>
  %value_output = check.generate.fill value(99) : tensor<8xi32>
  %comparison_output = check.generate.fill value(99) : tensor<10xi32>
  %boolean_output = check.generate.fill value(99) : tensor<16xi32>
  kernel.launch @integer_i32_truth_table(%input, %value_output, %comparison_output, %boolean_output) : (tensor<2xi32>, tensor<8xi32>, tensor<10xi32>, tensor<16xi32>)
  %expected_values = check.generate.iota offset(-8) step(2) : tensor<8xi32>
  %expected_comparisons = check.generate.iota offset(0) step(1) period(2) : tensor<10xi32>
  %expected_booleans = check.generate.iota offset(0) step(1) period(2) : tensor<16xi32>
  check.expect.equal actual(%value_output) expected(%expected_values) : tensor<8xi32>
  check.expect.equal actual(%comparison_output) expected(%expected_comparisons) : tensor<10xi32>
  check.expect.equal actual(%boolean_output) expected(%expected_booleans) : tensor<16xi32>
  check.return
}

