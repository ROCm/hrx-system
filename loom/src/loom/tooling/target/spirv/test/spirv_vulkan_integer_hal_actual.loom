  %mul = index.mul %value2, %value1 : index
  %div = index.div %dividend, %divisor : index
  %rem = index.rem %remainder_lhs, %remainder_rhs : index
  %min = index.min %value5, %value6 : index
  %max = index.max %value5, %value6 : index
  %madd = index.madd %value2, %value3, %value1 : index
  %scaled = index.scale %scale_index, %stride : index, offset -> offset
  %condition = index.cmp ult, %value8, %value9 : index
  %selected = scf.select %condition, %value9, %value0 : index
  %add_i32 = index.cast %add : index to i32
  %sub_i32 = index.cast %sub : index to i32
  %mul_i32 = index.cast %mul : index to i32
  %div_i32 = index.cast %div : index to i32
  %rem_i32 = index.cast %rem : index to i32
  %min_i32 = index.cast %min : index to i32
  %max_i32 = index.cast %max : index to i32
  %madd_i32 = index.cast %madd : index to i32
  %scaled_i32 = index.cast %scaled : offset to i32
  %selected_i32 = index.cast %selected : index to i32
  view.store %add_i32, %arithmetic0_view[0] : i32, view<1xi32>
  view.store %sub_i32, %arithmetic1_view[0] : i32, view<1xi32>
  view.store %mul_i32, %arithmetic2_view[0] : i32, view<1xi32>
  view.store %div_i32, %arithmetic3_view[0] : i32, view<1xi32>
  view.store %rem_i32, %arithmetic4_view[0] : i32, view<1xi32>
  view.store %min_i32, %arithmetic5_view[0] : i32, view<1xi32>
  view.store %max_i32, %arithmetic6_view[0] : i32, view<1xi32>
  view.store %madd_i32, %arithmetic7_view[0] : i32, view<1xi32>
  view.store %scaled_i32, %arithmetic8_view[0] : i32, view<1xi32>
  view.store %selected_i32, %arithmetic9_view[0] : i32, view<1xi32>

  %bitwise_and = index.andi %value1, %value2 : index
  %bitwise_or = index.ori %value1, %value0 : index
  %bitwise_xor = index.xori %value3, %value1 : index
  %shift_left = index.shli %value3, %amount0 : index
  %shift_right_signed = index.shrsi %value8, %amount1 : index
  %shift_right_unsigned = index.shrui %value10, %amount1 : index
  %rotate_left = index.rotli %value3, %amount1 : index
  %rotate_right = index.rotri %value14, %amount1 : index
  %rotate_left_zero = index.rotli %value8, %amount0 : index
  %rotate_right_zero = index.rotri %value9, %amount0 : index
  %leading_zero_input = index.shli %value1, %amount21 : index
  %leading_zero_count = index.ctlzi %leading_zero_input : index
  %trailing_zero_input = index.shli %value1, %amount11 : index
  %trailing_zero_count = index.cttzi %trailing_zero_input : index
  %population_high = index.shli %value1, %amount12 : index
  %population_input = index.sub %population_high, %value1 : index
  %population_count = index.ctpopi %population_input : index
  %bitwise_and_i32 = index.cast %bitwise_and : index to i32
  %bitwise_or_i32 = index.cast %bitwise_or : index to i32
  %bitwise_xor_i32 = index.cast %bitwise_xor : index to i32
  %shift_left_i32 = index.cast %shift_left : index to i32
  %shift_right_signed_i32 = index.cast %shift_right_signed : index to i32
  %shift_right_unsigned_i32 = index.cast %shift_right_unsigned : index to i32
  %rotate_left_i32 = index.cast %rotate_left : index to i32
  %rotate_right_i32 = index.cast %rotate_right : index to i32
  %rotate_left_zero_i32 = index.cast %rotate_left_zero : index to i32
  %rotate_right_zero_i32 = index.cast %rotate_right_zero : index to i32
  %leading_zero_count_i32 = index.cast %leading_zero_count : index to i32
  %trailing_zero_count_i32 = index.cast %trailing_zero_count : index to i32
  %population_count_i32 = index.cast %population_count : index to i32
  view.store %bitwise_and_i32, %bitwise0_view[0] : i32, view<1xi32>
  view.store %bitwise_or_i32, %bitwise1_view[0] : i32, view<1xi32>
  view.store %bitwise_xor_i32, %bitwise2_view[0] : i32, view<1xi32>
  view.store %shift_left_i32, %bitwise3_view[0] : i32, view<1xi32>
  view.store %shift_right_signed_i32, %bitwise4_view[0] : i32, view<1xi32>
  view.store %shift_right_unsigned_i32, %bitwise5_view[0] : i32, view<1xi32>
  view.store %rotate_left_i32, %bitwise6_view[0] : i32, view<1xi32>
  view.store %rotate_right_i32, %bitwise7_view[0] : i32, view<1xi32>
  view.store %rotate_left_zero_i32, %bitwise8_view[0] : i32, view<1xi32>
  view.store %rotate_right_zero_i32, %bitwise9_view[0] : i32, view<1xi32>
  view.store %leading_zero_count_i32, %bitwise10_view[0] : i32, view<1xi32>
  view.store %trailing_zero_count_i32, %bitwise11_view[0] : i32, view<1xi32>
  view.store %population_count_i32, %bitwise12_view[0] : i32, view<1xi32>
  kernel.return
}

check.case @index_numeric_truth_table_case {
  check.requires<hal.vulkan.feature> {feature = "shader_int64"}
  %input = check.generate.iota offset(0) step(1) : tensor<22xi32>
  %arithmetic_output = check.generate.fill value(-1) : tensor<10xi32>
  %bitwise_output = check.generate.fill value(-1) : tensor<13xi32>
  kernel.launch @index_numeric_truth_table(%input, %arithmetic_output, %bitwise_output) : (tensor<22xi32>, tensor<10xi32>, tensor<13xi32>)
  %expected_arithmetic = check.generate.iota offset(0) step(1) : tensor<10xi32>
  %expected_bitwise = check.generate.iota offset(0) step(1) : tensor<13xi32>
  check.expect.equal actual(%arithmetic_output) expected(%expected_arithmetic) : tensor<10xi32>
  check.expect.equal actual(%bitwise_output) expected(%expected_bitwise) : tensor<13xi32>
  check.return
}
