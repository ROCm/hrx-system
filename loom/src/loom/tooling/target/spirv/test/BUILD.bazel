loom_generated_file(
    name = "multiple_entries_bytecode",
    testonly = True,
    args = [
        "$(location multiple_entries.loom)",
        "--to=bytecode",
    ],
    generator = "//loom/src/loom/tools/loom-format",
    inputs = ["multiple_entries.loom"],
    output = "multiple_entries.loombc",
    output_flag = "--output=",
    target_compatible_with = _SPIRV_COMPILE_COMPATIBLE_WITH,
)

[
    iree_executable_test(
        name = name,
        src = "//loom/src/loom/tools/loom-run",
        args = [
            "$(rootpath " + source + ")",
            "--device=vulkan",
            "--vulkan_validation_layers=false",
            "--root=@combine",
            "--kernel-input-buffer=1xi32=6",
            "--kernel-input-buffer=1xi32=10",
            "--kernel-input-buffer=1xi32=0",
            "--kernel-input-value=i32=4",
            "--kernel-input-value=i32=5",
            "--expected-kernel-buffer=1xi32=6",
            "--expected-kernel-buffer=1xi32=10",
            "--expected-kernel-buffer=1xi32=25",
        ],
        data = [source],
        resource_group = GPU_DEVICE_RESOURCE_GROUP,
        tags = [
            "iree-run-requirement=vulkan.resource.device",
            "runtime-resource=vulkan-device",
        ],
        target_compatible_with = _SPIRV_COMPILE_COMPATIBLE_WITH + _SPIRV_VULKAN_HAL_COMPATIBLE_WITH,
    )
    for name, source in [
        ("aliased_entry_test", "multiple_entries.loom"),
        ("aliased_entry_bytecode_test", ":multiple_entries_bytecode"),
    ]
]

loom_generated_file(
    name = "multiple_entries_binary",
