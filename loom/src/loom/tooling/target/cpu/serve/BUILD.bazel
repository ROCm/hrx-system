package(default_visibility = ["//visibility:private"])

loom_cc_library(
    name = "test_compiler",
    testonly = True,
    srcs = ["test_compiler.c"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:x86",
    ]),
    deps = [
        "//loom/binding/c/target/cpu:iree_hal",
        "//loom/binding/c/target/x86",
        "//loom/src/loom/serve/testing:compiler",
    ],
    alwayslink = True,
)

loom_cc_library(
    name = "test_device",
    testonly = True,
    srcs = ["test_device.c"],
    target_compatible_with = loom_config_compatible_with([
        "//runtime/config/hal:driver_task",
    ]),
    deps = [
        "//loom/src/loom/serve/testing:device",
    ],
    alwayslink = True,
)

loom_cc_binary(
    name = "loom-serve-test-tool",
    testonly = True,
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:vm",
        "//loom/config/target/arch:x86",
        "//runtime/config/hal:driver_task",
    ]),
    deps = [
        ":test_compiler",
        ":test_device",
        "//loom/src/loom/serve/testing:server_test_tool",
    ],
)

# JITs an external source package and executes its command program through the
# task HAL using the exact CPU serving composition.
py_test(
    name = "serve_command_test",
    size = "small",
    srcs = ["//loom/src/loom/tools/loom-serve:server_test.py"],
    args = [
        "$(rootpath :loom-serve-test-tool)",
        "$(rootpath //loom/src/loom/serve/fixture/embedding:prepare.loom)",
        "$(rootpath //loom/src/loom/tools/loom-format)",
    ],
    data = EMBEDDING_SOURCES + [
        ":loom-serve-test-tool",
        "//loom/src/loom/tools/loom-format",
    ],
    main = "server_test.py",
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:vm",
        "//loom/config/target/arch:x86",
        "//runtime/config/hal:driver_task",
        "//runtime/config/hal:executable_loader_embedded_elf",
    ]) + ["@platforms//cpu:x86_64"] + select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = ["//loom/src/loom/serve/testing:http"],
)

loom_cc_test(
    name = "projector_fixture_test",
    args = [
