load("//build_tools/bazel:executable.bzl", "iree_executable_test")
load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_config_compatible_with",
)
load(
    "//loom/build_tools/bazel:defs.bzl",
    "loom_execution_profile",
    "loom_test",
)
load(
    "//loom/requirements:defs.bzl",
    "EXECUTE_IREE_HAL",
    "TARGET_ARCH_VM",
    "TARGET_ARCH_X86",
)
load(
    "//runtime/requirements:defs.bzl",
    "HAL_EXECUTABLE_LOADER_EMBEDDED_ELF",
    "HAL_TASK",
)

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_X86_TASK_HARDWARE_PROFILE = loom_execution_profile(
    name = "x86_task_hardware",
    build_requirements = [
        TARGET_ARCH_X86,
        TARGET_ARCH_VM,
        EXECUTE_IREE_HAL,
        HAL_TASK,
        HAL_EXECUTABLE_LOADER_EMBEDDED_ELF,
    ],
    executor = "hardware",
    runner_args = ["--device=task"],
    target_class = "cpu",
    target_family = "x86",
)

iree_executable_test(
    name = "benchmark_task_smoke_test",
    src = "//loom/src/loom/tools/iree-benchmark-loom",
    args = [
        "$(rootpath :test/x86_approximate_roots.loom)",
        "--device=task",
        "--benchmark=@x86_root_approximate_benchmark",
        "--iterations=1",
        "--warmup-iterations=0",
        "--min-time-ms=0",
        "--max-batches=1",
        "--stable-p90-to-p50-ppm=0",
    ],
    data = [":test/x86_approximate_roots.loom"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:x86",
        "//loom/config/target/arch:vm",
        "//runtime/config/hal:executable_loader_embedded_elf",
        "//loom/config/execute:task_hal",
    ]) + ["@platforms//cpu:x86_64"],
)

# Addressable C++ locals preserve independent storage across native calls.
[
    loom_test(
        name = name + "_test",
        benchmark_smoke = False,
        execution_profiles = [_X86_TASK_HARDWARE_PROFILE],
        module = "//loom/src/loom/import/cxx/test:" + name + "_module",
        target_compatible_with = loom_config_compatible_with([
            "//loom/config/import:cxx",
        ]) + ["@platforms//cpu:x86_64"],
    )
    for name in [
        "array_records",
        "call_lifetimes",
    ]
]

# Executes the complete shared integer bit-count family through the task HAL.
iree_executable_test(
    name = "integer_bit_counts_scenario_test",
    src = "//loom/src/loom/tools/iree-test-loom",
    args = [
        "$(rootpath //loom/src/loom/test/corpus/numeric:integer/bit_count.loom)",
        "--device=task",
    ],
    data = ["//loom/src/loom/test/corpus/numeric:integer/bit_count.loom"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:x86",
        "//runtime/config/hal:executable_loader_embedded_elf",
        "//loom/config/execute:task_hal",
        "//loom/config/target/arch:vm",
    ]) + ["@platforms//cpu:x86_64"],
)

# Exercises shared corpus programs through the task HAL and independent VM oracle.
# Two workers retain concurrent scheduling without a machine-sized test pool.
[
    iree_executable_test(
        name = name + "_scenario_test",
        src = "//loom/src/loom/tools/iree-test-loom",
        args = [
            "$(rootpath " + source + ")",
            "--device=task",
            "--task_topology_max_group_count=2",
            "--case=@" + scenario,
        ],
        data = [source],
        target_compatible_with = loom_config_compatible_with([
            "//loom/config/target/arch:x86",
            "//runtime/config/hal:executable_loader_embedded_elf",
            "//loom/config/execute:task_hal",
            "//loom/config/target/arch:vm",
        ]) + ["@platforms//cpu:x86_64"],
    )
    for name, source, scenario in [
        ("ranked_exchange_packets", "//loom/src/loom/test/corpus/memory:view/scalar_exchange.loom", "ranked_exchange_packet_values"),
        ("scalar_loop", "//loom/src/loom/test/corpus/control:loop/scalar_state.loom", "scalar_loop_state_values"),
        ("scalar_arithmetic", "//loom/src/loom/test/corpus/numeric:integer/scalar_observations.loom", "scalar_i32_arithmetic_values"),
        ("portable_index_arithmetic", "//loom/src/loom/test/corpus/numeric:integer/scalar_observations.loom", "portable_index_arithmetic_values"),
        ("scalar_bitfield", "//loom/src/loom/test/corpus/numeric:integer/scalar_observations.loom", "scalar_i32_bitfield_values"),
        ("bitfield", "//loom/src/loom/test/corpus/numeric:integer/bitfield.loom", "bitfield_values"),
        ("scalar_integer_float", "//loom/src/loom/test/corpus/numeric:conversion/conversion.loom", "scalar_integer_float_values"),
        ("wide_integer_conversion", "//loom/src/loom/test/corpus/numeric:vector/conversion.loom", "wide_integer_values"),
        ("packed_float_widening", "//loom/src/loom/test/corpus/numeric:conversion/narrow_widening.loom", "packed_f32_to_f64_values"),
        ("packed_float_narrowing", "//loom/src/loom/test/corpus/numeric:conversion/narrow_widening.loom", "packed_f64_to_f32_values"),
        ("half_narrowing", "//loom/src/loom/test/corpus/numeric:conversion/f32_narrowing.loom", "f32_half_packet_values"),
        ("half_double_widening", "//loom/src/loom/test/corpus/numeric:conversion/narrow_widening.loom", "float16_to_f64_all_bits"),
        ("half_widening", "//loom/src/loom/test/corpus/numeric:conversion/narrow_widening.loom", "float16_to_f32_all_bits"),
        ("packet_concatenation", "//loom/src/loom/test/corpus/numeric:vector/concatenation.loom", "packet_concatenation_values"),
        ("bfloat_widening", "//loom/src/loom/test/corpus/numeric:conversion/narrow_widening.loom", "bfloat_to_f32_all_bits"),
        ("bfloat_double_widening", "//loom/src/loom/test/corpus/numeric:conversion/narrow_widening.loom", "bfloat_to_f64_all_bits"),
        ("uniform_word_shifts", "//loom/src/loom/test/corpus/numeric:vector/integer_bitwise.loom", "uniform_word_shift_values"),
        ("uniform_dword_shifts", "//loom/src/loom/test/corpus/numeric:vector/integer_bitwise.loom", "uniform_dword_shift_values"),
        ("uniform_qword_shifts", "//loom/src/loom/test/corpus/numeric:vector/integer_bitwise.loom", "uniform_qword_shift_values"),
        ("rodata", "//loom/src/loom/test/corpus/function:rodata.loom", "rodata_values"),
        ("scalar_division", "//loom/src/loom/test/corpus/numeric:integer/constant_division.loom", "constant_scalar_quotient_values"),
        ("float_roots", "//loom/src/loom/test/corpus/numeric:float/roots.loom", "root_values"),
        ("float_approximate_roots", "//loom/src/loom/tooling/target/cpu:test/x86_approximate_roots.loom", "x86_root_approximate_values"),
        ("float64_roots", "//loom/src/loom/test/corpus/numeric:float/roots.loom", "root_f64_values"),
        ("float64_approximate_roots", "//loom/src/loom/tooling/target/cpu:test/x86_approximate_roots.loom", "x86_root_f64_approximate_values"),
        ("float_approximate_root_guards", "//loom/src/loom/tooling/target/cpu:test/x86_approximate_roots.loom", "x86_root_approximate_guard_values"),
        ("float_exponential", "//loom/src/loom/test/corpus/numeric:float/exponential.loom", "exponential_values"),
        ("float_turns", "//loom/src/loom/test/corpus/numeric:float/turns.loom", "turn_approximate_values"),
        ("float_activations", "//loom/src/loom/test/corpus/numeric:float/activations.loom", "activation_core_values"),
    ]
]
