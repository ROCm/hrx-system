load("@rules_python//python:defs.bzl", "py_test")
load("//build_tools/bazel:executable.bzl", "iree_executable_test")
load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_config_compatible_with",
)
load(
    "//loom/build_tools/bazel:defs.bzl",
    "loom_execution_profile",
    "loom_test",
)
load(
    "//loom/requirements:defs.bzl",
    "EXECUTE_IREE_HAL",
    "TARGET_ARCH_VM",
    "TARGET_ARCH_X86",
)
load(
    "//runtime/requirements:defs.bzl",
    "HAL_EXECUTABLE_LOADER_EMBEDDED_ELF",
    "HAL_TASK",
)

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_X86_TASK_HARDWARE_PROFILE = loom_execution_profile(
    name = "x86_task_hardware",
    build_requirements = [
        TARGET_ARCH_X86,
        TARGET_ARCH_VM,
        EXECUTE_IREE_HAL,
        HAL_TASK,
        HAL_EXECUTABLE_LOADER_EMBEDDED_ELF,
    ],
    executor = "hardware",
    runner_args = ["--device=task"],
    target_class = "cpu",
    target_family = "x86",
)

# The command test JITs external source packages and executes through task HAL.
py_test(
    name = "serve_command_test",
    size = "small",
    srcs = ["//loom/src/loom/tools/loom-serve:server_test.py"],
    args = [
        "$(rootpath //loom/src/loom/tools/loom-serve)",
        "$(rootpath //experimental/loom_serve/models/fixtures/embedding:prepare.loom)",
        "$(rootpath //loom/src/loom/tools/loom-format)",
    ],
    data = [
        "//experimental/loom_serve/models/fixtures/embedding:prepare.loom",
        "//experimental/loom_serve/models/fixtures/embedding:sources",
        "//loom/src/loom/tools/loom-format",
        "//loom/src/loom/tools/loom-serve",
    ],
    main = "server_test.py",
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:vm",
        "//loom/config/target/arch:x86",
        "//runtime/config/hal:driver_task",
        "//runtime/config/hal:executable_loader_embedded_elf",
    ]) + ["@platforms//cpu:x86_64"] + select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = ["//loom/src/loom/serve/testing:http"],
)

# Addressable C++ locals preserve independent storage across native calls.
[
    loom_test(
        name = name + "_test",
        benchmark_smoke = False,
        execution_profiles = [_X86_TASK_HARDWARE_PROFILE],
        module = "//loom/src/loom/import/cxx/test:" + name + "_module",
        target_compatible_with = loom_config_compatible_with([
            "//loom/config/import:cxx",
        ]) + ["@platforms//cpu:x86_64"],
    )
    for name in [
        "array_records",
        "call_lifetimes",
    ]
]

# Exercises shared corpus programs through the task HAL and independent VM oracle.
[
    iree_executable_test(
        name = name + "_scenario_test",
        src = "//loom/src/loom/tools/iree-test-loom",
        args = [
            "$(rootpath " + source + ")",
            "--device=task",
            "--case=@" + scenario,
        ],
        data = [source],
        target_compatible_with = loom_config_compatible_with([
            "//loom/config/target/arch:x86",
            "//runtime/config/hal:executable_loader_embedded_elf",
            "//loom/config/execute:task_hal",
            "//loom/config/target/arch:vm",
        ]) + ["@platforms//cpu:x86_64"],
    )
    for name, source, scenario in [
        ("scalar_loop", "//loom/src/loom/test/corpus/control:loop/scalar_state.loom", "scalar_loop_state_values"),
        ("scalar_arithmetic", "//loom/src/loom/test/corpus/numeric:integer/scalar_observations.loom", "scalar_i32_arithmetic_values"),
        ("scalar_bitfield", "//loom/src/loom/test/corpus/numeric:integer/scalar_observations.loom", "scalar_i32_bitfield_values"),
        ("scalar_integer_float", "//loom/src/loom/test/corpus/numeric:conversion/conversion.loom", "scalar_integer_float_values"),
        ("uniform_word_shifts", "//loom/src/loom/test/corpus/numeric:vector/integer_bitwise.loom", "uniform_word_shift_values"),
        ("uniform_dword_shifts", "//loom/src/loom/test/corpus/numeric:vector/integer_bitwise.loom", "uniform_dword_shift_values"),
        ("uniform_qword_shifts", "//loom/src/loom/test/corpus/numeric:vector/integer_bitwise.loom", "uniform_qword_shift_values"),
        ("rodata", "//loom/src/loom/test/corpus/function:rodata.loom", "rodata_values"),
        ("scalar_division", "//loom/src/loom/test/corpus/numeric:integer/constant_division.loom", "constant_scalar_quotient_values"),
    ]
]
