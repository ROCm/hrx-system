load("//build_tools/bazel:executable.bzl", "iree_executable_test")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")

package(default_visibility = ["//visibility:private"])

# The public CLI admits C++ directly through its configured LoomC importer.
iree_executable_test(
    name = "run_cxx_input_test",
    src = "//loom/src/loom/tools/loom-run",
    args = [
        "$(rootpath array_records.cxx)",
        "--device=task",
        "--kernel-input-buffer=4xi32=37",
        "--kernel-input-buffer=4xi32=97",
        "--expected-kernel-buffer=4xi32=37",
        "--expected-kernel-buffer=4xi32=[42,37,40,37]",
    ],
    data = ["array_records.cxx"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/import:cxx",
        "//loom/config/execute:x86_task_hal",
    ]) + ["@platforms//cpu:x86_64"],
)
