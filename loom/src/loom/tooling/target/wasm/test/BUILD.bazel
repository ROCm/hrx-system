# Hosted Wasm tests run through a Bazel platform wrapper and have no native
# CMake execution surface.
# bazel-to-cmake: skip

load("//build_tools/testing:build_defs.bzl", "iree_execution_test_suite")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")

package(
    default_visibility = ["//visibility:private"],
    licenses = ["notice"],  # Apache 2.0
)

iree_execution_test_suite(
    name = "hosted_diagnostics_test",
    data = ["unresolved_function.loom"],
    env_inherit = [
        "IREE_WASM_NODE",
        "PATH",
    ],
    manifests = ["hosted_diagnostics.test.json"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/execute:vm_iree_vm",
        "//loom/config/execute:wasm_hosted",
    ]),
    tools = {
        "loom-test": "//loom/src/loom/tools/loom-test:loom-test-wasi",
    },
)
