# Hosted Wasm tests run through a Bazel platform wrapper and have no native
# CMake execution surface.
# bazel-to-cmake: skip

load("//build_tools/bazel:executable.bzl", "iree_executable_test")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")
load("//loom/build_tools/bazel:defs.bzl", "loom_test")
load("//loom/src/loom/tooling/target/wasm:execution_profiles.bzl", "WASM_HOSTED_PROFILE")

package(
    default_visibility = ["//visibility:private"],
    licenses = ["notice"],  # Apache 2.0
)

iree_executable_test(
    name = "hosted_scenario_test",
    src = "//loom/src/loom/tools/loom-test:loom-test-wasi",
    args = [
        "$(rootpath :hosted_scenario.loom)",
        "--case=@hosted_wasm_transport",
    ],
    data = ["hosted_scenario.loom"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:vm",
        "//loom/config/target/arch:wasm",
    ]),
)

loom_test(
    name = "cxx_pointer_origins_test",
    execution_profiles = [WASM_HOSTED_PROFILE],
    module = "//loom/src/loom/import/cxx/test:pointer_origins_module",
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/import:cxx",
    ]),
)

loom_test(
    name = "cxx_padded_vectors_test",
    case = "padded_vectors_functions",
    execution_profiles = [WASM_HOSTED_PROFILE],
    module = "//loom/src/loom/import/cxx/test:padded_vectors_module",
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/import:cxx",
    ]),
)
