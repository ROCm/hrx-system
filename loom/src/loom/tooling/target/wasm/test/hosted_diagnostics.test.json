{
  "version": 1,
  "cases": [
    {
      "name": "unresolved function roots fail at the compile boundary",
      "run": {
        "tool": "loom-test",
        "args": [
          "{srcdir}/../testdata/unresolved_function.loom",
          "--case=@probe"
        ]
      },
      "exit": {"nonzero": true},
      "stderr": {
        "contains": [
          "unresolved_function.loom:1:1: error [SYMBOL/002]",
          "symbol '@unresolved' is referenced but not defined",
          "func.decl @unresolved(%input: i32) -> (i32)",
          "Wasm scenario compilation rejected 'unresolved'"
        ]
      }
    }
  ]
}
