load("//build_tools/testing:build_defs.bzl", "iree_execution_test_suite")
load(
    "//build_tools/wasm:build_defs.bzl",
    "iree_wasm_cc_library",
)
load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_library",
    "loom_config_compatible_with",
)

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_WASM_BINARY_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/emit:wasm_binary",
])

_WASM_EXECUTION_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/execute:wasm_hosted",
])

_WASM_HOST_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/execute:wasm_host",
])

iree_execution_test_suite(
    name = "loom_compile_execution_test",
    manifests = ["loom-compile.test.json"],
    tags = ["hostonly"],
    target_compatible_with = _WASM_BINARY_COMPATIBLE_WITH,
    tools = {
        "loom-compile": "//loom/src/loom/tools/loom-compile",
    },
)

iree_wasm_cc_library(
    name = "host_js",
    srcs = ["host.mjs"],
    module = "loom_wasm_host",
    target_compatible_with = _WASM_HOST_COMPATIBLE_WITH,
)

loom_cc_library(
    name = "host",
    srcs = ["host.c"],
    hdrs = ["host.h"],
    target_compatible_with = _WASM_HOST_COMPATIBLE_WITH,
    deps = [
        ":host_js",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "testbench",
    srcs = ["testbench.c"],
    hdrs = ["testbench.h"],
    target_compatible_with = _WASM_EXECUTION_COMPATIBLE_WITH,
    visibility = ["//loom/src/loom/tools/loom-test:__pkg__"],
    deps = [
        ":host",
        "//loom/binding/c:loomc",
        "//loom/binding/c/target/wasm",
        "//loom/src/loom/tooling/testbench:compiled_provider",
        "//loom/src/loom/tooling/testbench/scenario:executor",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
    ],
)

loom_cc_library(
    name = "loom_check",
    srcs = ["loom_check.c"],
    hdrs = ["loom_check.h"],
    deps = [
        "//loom/binding/c:loomc",
        "//loom/src/loom/target/tool:wasm",
        "//loom/src/loom/tools/loom-check:execute",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "check_provider",
    srcs = ["loom_check_provider.c"],
    hdrs = ["loom_check_provider.h"],
    visibility = ["//loom/src/loom/tools/loom-check:__pkg__"],
    deps = [
        ":loom_check",
        "//loom/src/loom/tools/loom-check:provider",
        "//runtime/src/iree/base",
    ],
)
