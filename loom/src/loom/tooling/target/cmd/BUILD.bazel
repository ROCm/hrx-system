        "//loom/src/loom/product:registry",
        "//loom/src/loom/target:entry_selection",
        "//loom/src/loom/target/arch/cmd:artifact_builder",
        "//loom/src/loom/target/arch/cmd:product",
        "//loom/src/loom/tooling/compile:product",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
    ],
