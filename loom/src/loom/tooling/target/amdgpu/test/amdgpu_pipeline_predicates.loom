  %actual = check.generate.fill value(-1.0) : tensor<2xf32>
  %expected = check.generate.iota offset(1.0) step(0.0) : tensor<2xf32>
  kernel.launch @predicate_fallback(%count, %fallback, %flags, %actual) : (index, i32, tensor<2xi32>, tensor<2xf32>)
  check.expect.close actual(%actual) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<2xf32>
