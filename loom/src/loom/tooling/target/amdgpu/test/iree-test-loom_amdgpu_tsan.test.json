{
  "version": 1,
  "cases": [
    {
      "name": "isolates sequential loom-authored amdgpu tsan dispatches",
      "run": {
        "tool": "iree-test-loom",
        "args": [
          "{srcdir}/../../../../test/corpus/sanitizer/amdgpu_tsan_actual.loom",
          "--device=amdgpu",
          "--sanitizer=tsan",
          "--sanitizer-reporting=report-only",
          "--amdgpu_tsan=true",
          "--amdgpu_tsan_report_policy=report-only"
        ]
      },
      "stdout": {
        "contains": {
          "unordered": [
            "\"format\":\"loom.test.v0\"",
            {
              "regex": "\"case\":\"tsan_workgroup_write_race_case\"[^}]*\"passed\":true"
            },
            {
              "regex": "\"case\":\"tsan_workgroup_barrier_safe_write_case\"[^}]*\"passed\":true"
            },
            "\"failed_sample_count\":0"
          ]
        }
      }
    }
  ]
}
