])

iree_py_test(
    name = "qualification_test",
    srcs = ["qualification_test.py"],
    args = [
        "$(location //loom/src/loom/tools/loom-check:loom-check)",
        "$(location //loom/src/loom/test/corpus/source_low:memory_global_atomic.loom-test)",
        "$(location //loom/src/loom/target/arch/amdgpu:test/source_low/source_low_memory_global_atomic_gfx9_4_generic.loom-test)",
        "$(location //loom/src/loom/tools/loom-compile:loom-compile)",
        "$(location //loom/src/loom/test/corpus/source_low:memory_address_realizations.loom-test)",
        "$(location qualification_rejected.loom-test)",
    ],
    data = [
        "qualification_rejected.loom-test",
        "//loom/src/loom/target/arch/amdgpu:test/source_low/source_low_memory_global_atomic_gfx9_4_generic.loom-test",
        "//loom/src/loom/test/corpus/source_low:memory_address_realizations.loom-test",
        "//loom/src/loom/test/corpus/source_low:memory_global_atomic.loom-test",
        "//loom/src/loom/tools/loom-check",
        "//loom/src/loom/tools/loom-compile",
    ],
    target_compatible_with = _AMDGPU_ARTIFACTS_COMPATIBLE_WITH,
)

