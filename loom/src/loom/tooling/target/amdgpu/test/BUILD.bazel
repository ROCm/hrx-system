load("//build_tools/bazel:python.bzl", "iree_py_test")
load("//build_tools/bazel:test_resources.bzl", "GPU_DEVICE_RESOURCE_GROUP")
load("//build_tools/testing:build_defs.bzl", "iree_execution_test_suite")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_AMDGPU_ARTIFACTS_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/emit:amdgpu_elf",
])

_AMDGPU_EXECUTION_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/execute:amdgpu_hal",
    "//runtime/config/hal:driver_amd_gpu",
])

iree_execution_test_suite(
    name = "device_failure_test",
    data = ["device_failure.loom"],
    manifests = ["device_failure.test.json"],
    resource_group = GPU_DEVICE_RESOURCE_GROUP,
    tags = [
        "iree-run-requirement=libamdf.resource.amd_gpu",
        "requires-amd-gpu-feedback",
    ],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/execute:amdgpu_hal",
        "//runtime/config/hal:driver_amd_gpu",
        "//libamdf/config:enabled_setting",
        "//libamdf/config/family:gpu",
    ]),
    tools = {
        "loom-benchmark": "//loom/src/loom/tools/loom-benchmark",
        "loom-test": "//loom/src/loom/tools/loom-test",
    },
)

iree_execution_test_suite(
    name = "benchmark_scenario_correctness_test",
    data = ["//loom/src/loom/tooling/testbench/testdata:benchmark_scenarios.loom"],
    manifests = ["benchmark_scenario_correctness.test.json"],
    resource_group = GPU_DEVICE_RESOURCE_GROUP,
    tags = [
        "iree-run-requirement=libamdf.resource.amd_gpu",
    ],
    target_compatible_with = _AMDGPU_EXECUTION_COMPATIBLE_WITH + loom_config_compatible_with([
        "//loom/config/execute:vm_iree_vm",
    ]),
    tools = {"benchmark": "//loom/src/loom/tools/loom-benchmark"},
)

iree_execution_test_suite(
