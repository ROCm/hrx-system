load("//build_tools/testing:build_defs.bzl", "iree_execution_test_suite")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")
load(
    "//loom/build_tools/bazel:defs.bzl",
    "loom_test",
    "loom_test_suite",
)
load(
    "//loom/src/loom/tooling/target/amdgpu:execution_profiles.bzl",
    "AMDGPU_ACCESS_PROFILE",
    "AMDGPU_ASAN_PROFILE",
    "AMDGPU_HARDWARE_PROFILE",
    "AMDGPU_TSAN_PROFILE",
)

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_AMDGPU_ARTIFACTS_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/target:amdgpu_artifacts",
])

iree_execution_test_suite(
    name = "loom_compile_execution_test",
    data = [
        "complete_authoring_module.loom",
        "gfx1250_configured_fragment_bank.loom",
        "selected_root_amdgpu.loom",
    ],
    manifests = ["loom-compile-amdgpu.test.json"],
    tags = ["hostonly"],
    target_compatible_with = _AMDGPU_ARTIFACTS_COMPATIBLE_WITH,
    tools = {
        "loom-compile": "//loom/src/loom/tools/loom-compile",
        "loom-compile-report": "//loom/py/loom/tools:loom-compile-report",
    },
)

iree_execution_test_suite(
    name = "loom_opt_execution_test",
    data = ["loom_opt_f32_arith.loom"],
    manifests = ["loom-opt-amdgpu.test.json"],
    tags = ["hostonly"],
    target_compatible_with = _AMDGPU_ARTIFACTS_COMPATIBLE_WITH,
    tools = {
        "loom-opt": "//loom/src/loom/tools/loom-opt",
    },
)

loom_test_suite(
    name = "hal_tests",
    srcs = [
        "amdgpu_hal_actual.loom",
        "generated_tensor_cases.loom",
        "//loom/src/loom/tooling/execution/hal:testdata/buffer_bulk_hal_actual.loom",
        "//loom/src/loom/tooling/execution/hal:testdata/dynamic_workgroup_hal_actual.loom",
        "//loom/src/loom/tooling/execution/hal:testdata/launch_schedule_hal_actual.loom",
    ],
    execution_profile = AMDGPU_HARDWARE_PROFILE,
)

loom_test(
    name = "kernarg_hardware_test",
    src = "amdgpu_unused_kernargs.loom",
    execution_profile = AMDGPU_HARDWARE_PROFILE,
)

loom_test(
    name = "kernarg_access_test",
    src = "amdgpu_unused_kernargs.loom",
    execution_profile = AMDGPU_ACCESS_PROFILE,
)

loom_test(
    name = "asan_test",
    src = "//loom/src/loom/test/corpus/sanitizer:amdgpu_asan_actual.loom",
    execution_profile = AMDGPU_ASAN_PROFILE,
)

loom_test(
    name = "tsan_test",
    src = "//loom/src/loom/test/corpus/sanitizer:amdgpu_tsan_actual.loom",
    execution_profile = AMDGPU_TSAN_PROFILE,
)
