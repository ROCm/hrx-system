load("//build_tools/testing:build_defs.bzl", "iree_execution_test_suite")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")
load(
    "//loom/build_tools/bazel:defs.bzl",
    "loom_test",
)
load(
    "//loom/target/amdgpu:execution_profiles.bzl",
    "AMDGPU_ACCESS_PROFILE",
    "AMDGPU_ASAN_PROFILE",
    "AMDGPU_HARDWARE_PROFILE",
    "AMDGPU_TSAN_PROFILE",
)

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_AMDGPU_ARTIFACTS_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/target:amdgpu_artifacts",
])

iree_execution_test_suite(
    name = "loom_compile_execution_test",
    data = [
        "complete_authoring_module.loom",
        "gfx1250_configured_fragment_bank.loom",
        "loom_opt_f32_arith.loom",
        "selected_root_amdgpu.loom",
        "//loom/src/loom/tooling/target/amdgpu/test/corpus:gfx11/schedule_scopes.loom",
    ],
    manifests = ["loom-compile-amdgpu.test.json"],
    tags = ["hostonly"],
    target_compatible_with = _AMDGPU_ARTIFACTS_COMPATIBLE_WITH,
    tools = {
        "loom-compile": "//loom/src/loom/tools/loom-compile",
        "loom-compile-report": "//loom/py/loom/tools:loom-compile-report",
        "loom-format": "//loom/src/loom/tools/loom-format",
        "loom-opt": "//loom/src/loom/tools/loom-opt",
    },
)

iree_execution_test_suite(
    name = "loom_opt_execution_test",
    data = ["loom_opt_f32_arith.loom"],
    manifests = ["loom-opt-amdgpu.test.json"],
    tags = ["hostonly"],
    target_compatible_with = _AMDGPU_ARTIFACTS_COMPATIBLE_WITH,
    tools = {
        "loom-opt": "//loom/src/loom/tools/loom-opt",
    },
)

loom_test(
    name = "hal_tests",
    srcs = [
        "amdgpu_hal_actual.loom",
        "generated_tensor_cases.loom",
        "//loom/src/loom/tooling/execution/hal:testdata/buffer_bulk_hal_actual.loom",
        "//loom/src/loom/tooling/execution/hal:testdata/dynamic_workgroup_hal_actual.loom",
        "//loom/src/loom/tooling/execution/hal:testdata/launch_schedule_hal_actual.loom",
    ],
    execution_profile = AMDGPU_HARDWARE_PROFILE,
)

loom_test(
    name = "kernarg_hardware_test",
    srcs = ["amdgpu_unused_kernargs.loom"],
    execution_profile = AMDGPU_HARDWARE_PROFILE,
)

loom_test(
    name = "kernarg_access_test",
    srcs = ["amdgpu_unused_kernargs.loom"],
    execution_profile = AMDGPU_ACCESS_PROFILE,
)

loom_test(
    name = "asan_test",
    srcs = ["//loom/src/loom/test/corpus/sanitizer:amdgpu_asan_actual.loom"],
    execution_profile = AMDGPU_ASAN_PROFILE,
)

loom_test(
    name = "unroll_fences_access_test",
    srcs = ["amdgpu_unroll_fences.loom"],
    execution_profile = AMDGPU_ACCESS_PROFILE,
)

loom_test(
    name = "indirection_access_test",
    srcs = [
        "//loom/src/loom/test/corpus/checked_benchmarks:moe_routed_combine_loop_f32.loom",
        "//loom/src/loom/test/corpus/checked_benchmarks:paged_online_softmax_loop_f32.loom",
    ],
    execution_profile = AMDGPU_ACCESS_PROFILE,
)

loom_test(
    name = "pipeline_predicates_serial_test",
    srcs = [
        "amdgpu_pipeline_predicates.loom",
        "//loom/binding/c/benchmark/kernels:synthetic/segmented_guarded_read_ahead.loom",
    ],
    args = [
        "--config=test.depth=1",
        "--config=test.factor=1",
        "--config=benchmark.loop_count=8",
        "--config=benchmark.pipeline_depth=1",
    ],
    execution_profile = AMDGPU_ACCESS_PROFILE,
)

loom_test(
    name = "pipeline_predicates_depth_three_test",
    srcs = [
        "amdgpu_pipeline_predicates.loom",
        "//loom/binding/c/benchmark/kernels:synthetic/segmented_guarded_read_ahead.loom",
    ],
    args = [
        "--config=test.depth=3",
        "--config=test.factor=1",
        "--config=benchmark.loop_count=8",
        "--config=benchmark.pipeline_depth=3",
    ],
    execution_profile = AMDGPU_ACCESS_PROFILE,
)

loom_test(
    name = "pipeline_predicates_unrolled_test",
    srcs = [
        "amdgpu_pipeline_predicates.loom",
        "//loom/binding/c/benchmark/kernels:synthetic/segmented_guarded_read_ahead.loom",
    ],
    args = [
        "--config=test.depth=4",
        "--config=test.factor=2",
        "--config=benchmark.loop_count=8",
        "--config=benchmark.pipeline_depth=4",
    ],
    execution_profile = AMDGPU_ACCESS_PROFILE,
)

loom_test(
    name = "tsan_test",
    srcs = ["//loom/src/loom/test/corpus/sanitizer:amdgpu_tsan_actual.loom"],
    execution_profile = AMDGPU_TSAN_PROFILE,
)
