iree_py_test(
    name = "qualification_test",
    srcs = ["qualification_test.py"],
    args = [
        "$(location //loom/src/loom/tools/loom-check:loom-check)",
        "$(location qualification_accepted.loom-test)",
        "$(location //loom/src/loom/tools/loom-compile:loom-compile)",
        "$(location memory_address_realizations.loom-test)",
        "$(location qualification_rejected.loom-test)",
    ],
    data = [
        "memory_address_realizations.loom-test",
        "qualification_accepted.loom-test",
        "qualification_rejected.loom-test",
        "//loom/src/loom/tools/loom-check",
        "//loom/src/loom/tools/loom-compile",
    ],
    target_compatible_with = _AMDGPU_ARTIFACTS_COMPATIBLE_WITH,
)

iree_execution_test_suite(
    name = "loom_compile_execution_test",
    data = [
        "compile_requests.loom",
        "complete_authoring_module.loom",
        "feature_distinct_code_objects.loom",
        "loom_opt_f32_arith.loom",
        "selected_root_amdgpu.loom",
    ],
    manifests = ["loom-compile-amdgpu.test.json"],
    tags = ["hostonly"],
    target_compatible_with = _AMDGPU_ARTIFACTS_COMPATIBLE_WITH,
    tools = {
        "loom-benchmark": "//loom/src/loom/tools/loom-benchmark",
        "loom-compile": "//loom/src/loom/tools/loom-compile",
        "loom-compile-report": "//loom/py/loom/tools:loom-compile-report",
        "loom-format": "//loom/src/loom/tools/loom-format",
        "loom-opt": "//loom/src/loom/tools/loom-opt",
    },
)

