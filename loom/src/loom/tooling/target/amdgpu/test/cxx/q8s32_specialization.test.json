{
  "version": 1,
  "cases": [
    {
      "name": "selects Q8S32 providers from imported target and config facts",
      "steps": [
        {
          "name": "import-provider-library-once",
          "run": {
            "tool": "loom-import-cxx",
            "args": [
              "{srcdir}/q8s32_specialization_providers.cxx",
              "--to=bc",
              "--output={tmp}/providers.loombc"
            ]
          },
          "files": [
            {"path": "{tmp}/providers.loombc", "non_empty": true}
          ]
        },
        {
          "name": "import-root-once",
          "run": {
            "tool": "loom-import-cxx",
            "args": [
              "{srcdir}/q8s32_specialization.cxx",
              "--to=bc",
              "--output={tmp}/root.loombc"
            ]
          },
          "files": [{"path": "{tmp}/root.loombc", "non_empty": true}]
        },
        {
          "name": "import-ambiguous-diagnostic-overlay-once",
          "run": {
            "tool": "loom-import-cxx",
            "args": [
              "{srcdir}/q8s32_specialization_ambiguous_provider.cxx",
              "--to=bc",
              "--output={tmp}/ambiguous-provider.loombc"
            ]
          },
          "files": [
            {"path": "{tmp}/ambiguous-provider.loombc", "non_empty": true}
          ]
        },
        {
          "name": "select-wave32-values32",
          "run": {
            "tool": "loom-link",
            "args": [
              "{tmp}/root.loombc",
              "--library={tmp}/providers.loombc",
              "--root=@q8s32_specialize",
              "--target=amdgpu:gfx1151",
              "--config=model.q8s32.input_capacity=512",
              "--require-resolved-config",
              "--output={tmp}/gfx1151-values32.loom"
            ]
          },
          "files": [
            {
              "path": "{tmp}/gfx1151-values32.loom",
              "contains": [
                "config.def @model.q8s32.input_capacity = 512",
                "func.def linkonce inline @q8s32_lane_dot_combined",
                "@q8s32_wave32_values32",
                "{cluster_size = 32}",
                "amdgpu.target<gfx1151>"
              ],
              "not_contains": [
                "@q8s32_lane_dot_split",
                "@q8s32_wave32_values16",
                "@q8s32_wave64_values32",
                "@q8s32_wave64_values16",
                "@q8s32_generic_lanes8"
              ]
            }
          ]
        },
        {
          "name": "select-wave32-values16",
          "run": {
            "tool": "loom-link",
            "args": [
              "{tmp}/root.loombc",
              "--library={tmp}/providers.loombc",
              "--root=@q8s32_specialize",
              "--target=amdgpu:gfx1151",
              "--config=model.q8s32.input_capacity=768",
              "--require-resolved-config",
              "--output={tmp}/gfx1151-values16.loom"
            ]
          },
          "files": [
            {
              "path": "{tmp}/gfx1151-values16.loom",
              "contains": [
                "config.def @model.q8s32.input_capacity = 768",
                "func.def linkonce inline @q8s32_lane_dot_combined",
                "@q8s32_wave32_values16",
                "{cluster_size = 16}",
                "amdgpu.target<gfx1151>"
              ],
              "not_contains": [
                "@q8s32_lane_dot_split",
                "@q8s32_wave32_values32",
                "@q8s32_wave64_values32",
                "@q8s32_wave64_values16",
                "@q8s32_generic_lanes8"
              ]
            }
          ]
        },
        {
          "name": "select-wave64-values32",
          "run": {
            "tool": "loom-link",
            "args": [
              "{tmp}/root.loombc",
              "--library={tmp}/providers.loombc",
              "--root=@q8s32_specialize",
              "--target=amdgpu:gfx942",
              "--config=model.q8s32.input_capacity=512",
              "--require-resolved-config",
              "--output={tmp}/gfx942-values32.loom"
            ]
          },
          "files": [
            {
              "path": "{tmp}/gfx942-values32.loom",
              "contains": [
                "config.def @model.q8s32.input_capacity = 512",
                "func.def linkonce inline @q8s32_lane_dot_split",
                "@q8s32_wave64_values32",
                "{cluster_size = 32}",
                "amdgpu.target<gfx942>"
              ],
              "not_contains": [
                "@q8s32_lane_dot_combined",
                "@q8s32_wave32_values32",
                "@q8s32_wave32_values16",
                "@q8s32_wave64_values16",
                "@q8s32_generic_lanes8"
              ]
            }
          ]
        },
        {
          "name": "select-wave64-values16",
          "run": {
            "tool": "loom-link",
            "args": [
              "{tmp}/root.loombc",
              "--library={tmp}/providers.loombc",
              "--root=@q8s32_specialize",
              "--target=amdgpu:gfx942",
              "--config=model.q8s32.input_capacity=768",
              "--require-resolved-config",
              "--output={tmp}/gfx942-values16.loom"
            ]
          },
          "files": [
            {
              "path": "{tmp}/gfx942-values16.loom",
              "contains": [
                "config.def @model.q8s32.input_capacity = 768",
                "func.def linkonce inline @q8s32_lane_dot_split",
                "@q8s32_wave64_values16",
                "{cluster_size = 16}",
                "amdgpu.target<gfx942>"
              ],
              "not_contains": [
                "@q8s32_lane_dot_combined",
                "@q8s32_wave32_values32",
                "@q8s32_wave32_values16",
                "@q8s32_wave64_values32",
                "@q8s32_generic_lanes8"
              ]
            }
          ]
        },
        {
          "name": "select-authored-wave64-values16",
          "run": {
            "tool": "loom-link",
            "args": [
              "{tmp}/root.loombc",
              "--library={srcdir}/q8s32_specialization_providers.loom",
              "--root=@q8s32_specialize",
              "--target=amdgpu:gfx942",
              "--config=model.q8s32.input_capacity=768",
              "--require-resolved-config",
              "--output={tmp}/authored-gfx942-values16.loom"
            ]
          },
          "files": [
            {
              "path": "{tmp}/authored-gfx942-values16.loom",
              "contains": [
                "config.def @model.q8s32.input_capacity = 768",
                "func.def inline @q8s32_lane_dot_split",
                "@q8s32_wave64_values16",
                "{cluster_size = 16}",
                "amdgpu.target<gfx942>"
              ],
              "not_contains": [
                "@q8s32_lane_dot_combined",
                "@q8s32_wave32_values32",
                "@q8s32_wave32_values16",
                "@q8s32_wave64_values32",
                "@q8s32_generic_lanes8"
              ]
            }
          ]
        },
        {
          "name": "select-generic-values8",
          "run": {
            "tool": "loom-link",
            "args": [
              "{tmp}/root.loombc",
              "--library={tmp}/providers.loombc",
              "--root=@q8s32_specialize",
              "--target=amdgpu:gfx1151",
              "--config=model.q8s32.input_capacity=1280",
              "--require-resolved-config",
              "--output={tmp}/gfx1151-values8.loom"
            ]
          },
          "files": [
            {
              "path": "{tmp}/gfx1151-values8.loom",
              "contains": [
                "config.def @model.q8s32.input_capacity = 1280",
                "func.def linkonce inline @q8s32_lane_dot_split",
                "@q8s32_generic_lanes8",
                "{cluster_size = 8}",
                "amdgpu.target<gfx1151>"
              ],
              "not_contains": [
                "@q8s32_lane_dot_combined",
                "@q8s32_wave32_values32",
                "@q8s32_wave32_values16",
                "@q8s32_wave64_values32",
                "@q8s32_wave64_values16"
              ]
            }
          ]
        },
        {
          "name": "merge-generic-selection-evidence",
          "run": {
            "tool": "loom-link",
            "args": [
              "{tmp}/root.loombc",
              "{tmp}/providers.loombc",
              "--mode=merge",
              "--target=amdgpu:gfx1151",
              "--config=model.q8s32.input_capacity=1280",
              "--require-resolved-config",
              "--output={tmp}/generic-report-input.loom"
            ]
          }
        },
        {
          "name": "report-every-generic-selection-decision",
          "run": {
            "tool": "loom-opt",
            "args": [
              "{tmp}/generic-report-input.loom",
              "--pass=select-templates{mode=final,rewrite=inline}",
              "--pass-report=json",
              "--output={tmp}/generic-report-selected.loom"
            ]
          },
          "stderr": {
            "contains": {
              "unordered": [
                "\"category\":\"template-selection\",\"outcome\":\"fallback_selected\",\"function\":\"q8s32_specialize\",\"application_op\":\"template.apply\",\"family\":\"model.q8s32.project\",\"target\":\"gfx1151\",\"selected_provider\":\"q8s32_generic_lanes8\",\"selected_priority\":1",
                "\"provider\":\"q8s32_wave32_values32\",\"priority\":40,\"selected\":false,\"constraint\":\"value_predicate\",\"predicate\":\"multiple_of\"",
                "\"provider\":\"q8s32_wave64_values32\",\"priority\":40,\"selected\":false,\"constraint\":\"target_condition\",\"condition\":\"target.subgroup.size\"",
                "\"provider\":\"q8s32_wave32_values16\",\"priority\":30,\"selected\":false,\"constraint\":\"value_predicate\",\"predicate\":\"multiple_of\"",
                "\"provider\":\"q8s32_wave64_values16\",\"priority\":30,\"selected\":false,\"constraint\":\"target_condition\",\"condition\":\"target.subgroup.size\"",
                "\"provider\":\"q8s32_generic_lanes8\",\"priority\":1,\"selected\":true"
              ]
            }
          },
          "files": [
            {
              "path": "{tmp}/generic-report-selected.loom",
              "contains": ["{cluster_size = 8}"],
              "not_contains": ["template.apply<@model.q8s32.project>"]
            }
          ]
        },
        {
          "name": "merge-no-applicable-provider",
          "run": {
            "tool": "loom-link",
            "args": [
              "{tmp}/root.loombc",
              "{tmp}/providers.loombc",
              "--mode=merge",
              "--target=amdgpu:gfx1151",
              "--config=model.q8s32.input_capacity=2816",
              "--require-resolved-config",
              "--output={tmp}/no-applicable-report-input.loom"
            ]
          }
        },
        {
          "name": "reject-no-applicable-provider",
          "run": {
            "tool": "loom-opt",
            "args": [
              "{tmp}/no-applicable-report-input.loom",
              "--pass=select-templates{mode=final,rewrite=inline}",
              "--pass-report=json",
              "--diagnostic-format=json",
              "--output={tmp}/no-applicable-selected.loom"
            ]
          },
          "exit": {"nonzero": true},
          "stderr": {
            "contains": {
              "unordered": [
                "\"error_id\":\"ERR_LOWERING_045\"",
                "\"failure_code\":\"all_rejected\"",
                "\"category\":\"template-selection\",\"outcome\":\"rejected\",\"function\":\"q8s32_specialize\"",
                "\"provider_count\":5,\"target_identity_match_count\":5,\"target_identity_unresolved_count\":0,\"possible_count\":0,\"best_match_count\":0",
                "\"provider\":\"q8s32_generic_lanes8\",\"priority\":1,\"selected\":false,\"constraint\":\"value_predicate\",\"predicate\":\"range\""
              ]
            }
          }
        },
        {
          "name": "merge-ambiguous-provider-overlay",
          "run": {
            "tool": "loom-link",
            "args": [
              "{tmp}/root.loombc",
              "{tmp}/providers.loombc",
              "{tmp}/ambiguous-provider.loombc",
              "--mode=merge",
              "--target=amdgpu:gfx1151",
              "--config=model.q8s32.input_capacity=512",
              "--require-resolved-config",
              "--output={tmp}/ambiguous-report-input.loom"
            ]
          }
        },
        {
          "name": "reject-ambiguous-best-providers",
          "run": {
            "tool": "loom-opt",
            "args": [
              "{tmp}/ambiguous-report-input.loom",
              "--pass=select-templates{mode=final,rewrite=inline}",
              "--pass-report=json",
              "--diagnostic-format=json",
              "--output={tmp}/ambiguous-selected.loom"
            ]
          },
          "exit": {"nonzero": true},
          "stderr": {
            "contains": {
              "unordered": [
                "\"error_id\":\"ERR_LOWERING_045\"",
                "\"failure_code\":\"ambiguous\"",
                "\"category\":\"template-selection\",\"outcome\":\"ambiguous\",\"function\":\"q8s32_specialize\"",
                "\"provider_count\":6,\"target_identity_match_count\":6,\"target_identity_unresolved_count\":0,\"possible_count\":3,\"best_match_count\":2",
                "\"provider\":\"q8s32_wave32_values32\",\"priority\":40,\"selected\":false",
                "\"provider\":\"q8s32_wave32_values32_ambiguous\",\"priority\":40,\"selected\":false",
                "\"provider\":\"q8s32_generic_lanes8\",\"priority\":1,\"selected\":false"
              ]
            }
          }
        },
        {
          "name": "compile-wave32-selection",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{tmp}/gfx1151-values32.loom",
              "--target=amdgpu:gfx1151",
              "--output={tmp}/gfx1151-values32.hsaco"
            ]
          },
          "files": [
            {"path": "{tmp}/gfx1151-values32.hsaco", "non_empty": true}
          ]
        },
        {
          "name": "compile-wave64-selection",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{tmp}/gfx942-values16.loom",
              "--target=amdgpu:gfx942",
              "--output={tmp}/gfx942-values16.hsaco"
            ]
          },
          "files": [
            {"path": "{tmp}/gfx942-values16.hsaco", "non_empty": true}
          ]
        },
        {
          "name": "compile-authored-wave64-selection",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{tmp}/authored-gfx942-values16.loom",
              "--target=amdgpu:gfx942",
              "--output={tmp}/authored-gfx942-values16.hsaco"
            ]
          },
          "files": [
            {
              "path": "{tmp}/authored-gfx942-values16.hsaco",
              "non_empty": true
            }
          ]
        },
        {
          "name": "compile-generic-selection",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{tmp}/gfx1151-values8.loom",
              "--target=amdgpu:gfx1151",
              "--output={tmp}/gfx1151-values8.hsaco"
            ]
          },
          "files": [
            {"path": "{tmp}/gfx1151-values8.hsaco", "non_empty": true}
          ]
        }
      ]
    }
  ]
}
