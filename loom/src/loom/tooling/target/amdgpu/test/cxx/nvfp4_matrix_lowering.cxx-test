  %371 = v_lshlrev_b32_src0_inline %370, 2
  %372 = v_lshrrev_b32_src0_inline %lane, 4
  %373 = v_lshl_add_u32_shift_imm %372, %371, 8
  %374 = slice %result[0] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  global_store_dword_saddr %373, %374, %output_view
  %375 = slice %result[1] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  global_store_dword_saddr %373, %375, %output_view {offset = 64}
  %376 = slice %result[2] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  global_store_dword_saddr %373, %376, %output_view {offset = 128}
  %377 = slice %result[3] : reg<amdgpu.vgpr x4> -> reg<amdgpu.vgpr>
  global_store_dword_saddr %373, %377, %output_view {offset = 192}
  return
}
