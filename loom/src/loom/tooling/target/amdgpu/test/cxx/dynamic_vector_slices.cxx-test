// RUN: emit source-low @sum_packets target=amdgpu:gfx1151 output=low

#include <loomcxx/kernel.h>
#include <loomcxx/vector.h>

using Values = unsigned __attribute__((ext_vector_type(16)));
using Packet = unsigned __attribute__((ext_vector_type(4)));

[[loom::config("dynamic_slice.packet_count")]] const unsigned packet_count = 4u;

[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]] void sum_packets(const unsigned* input, Packet* output) {
  Values values = {input[0],  input[1],  input[2],  input[3],
                   input[4],  input[5],  input[6],  input[7],
                   input[8],  input[9],  input[10], input[11],
                   input[12], input[13], input[14], input[15]};
  Packet sum = {};
  [[loom::unroll]]
  for (unsigned index = 0; index < packet_count; ++index) {
    sum += loom::vector::slice<Packet>(values, index * 4u);
  }
  output[0] = sum;
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @sum_packets() asm {
  %input = resource<hal_binding> {extent = 64, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output = resource<hal_binding> {extent = 16, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %316 = v_mov_b32 0
  %317 = global_load_b32_saddr %316, %input
  %319 = global_load_b32_saddr %316, %input {offset = 4}
  %321 = global_load_b32_saddr %316, %input {offset = 8}
  %323 = global_load_b32_saddr %316, %input {offset = 12}
  %325 = global_load_b32_saddr %316, %input {offset = 16}
  %327 = global_load_b32_saddr %316, %input {offset = 20}
  %329 = global_load_b32_saddr %316, %input {offset = 24}
  %331 = global_load_b32_saddr %316, %input {offset = 28}
  %333 = global_load_b32_saddr %316, %input {offset = 32}
  %335 = global_load_b32_saddr %316, %input {offset = 36}
  %337 = global_load_b32_saddr %316, %input {offset = 40}
  %339 = global_load_b32_saddr %316, %input {offset = 44}
  %341 = global_load_b32_saddr %316, %input {offset = 48}
  %343 = global_load_b32_saddr %316, %input {offset = 52}
  %345 = global_load_b32_saddr %316, %input {offset = 56}
  %347 = global_load_b32_saddr %316, %input {offset = 60}
  %352 = v_add_u32 %317, %325
  %355 = v_add_u32 %319, %327
  %358 = v_add_u32 %321, %329
  %361 = v_add_u32 %323, %331
  %366 = v_add_u32 %352, %333
  %369 = v_add_u32 %355, %335
  %372 = v_add_u32 %358, %337
  %375 = v_add_u32 %361, %339
  %380 = v_add_u32 %366, %341
  %383 = v_add_u32 %369, %343
  %386 = v_add_u32 %372, %345
  %389 = v_add_u32 %375, %347
  %sum_3 = concat(%380, %383, %386, %389) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x4>
  global_store_b128_saddr %316, %sum_3, %output
  return
}
