load(
    "//loom/build_tools/amdgpu:descriptor_sets.bzl",
    "loom_amdgpu_descriptor_set_compatible_with",
    "loom_amdgpu_iree_hal_representation_compatible_with",
)
load(
    "//loom/build_tools/amdgpu:target_config.bzl",
    "LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITY_BY_KEY",
)
load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with", "loom_generated_file_family")
load("//loom/build_tools/bazel:defs.bzl", "loom_test")
load("//loom/build_tools/bazel:loom_check.bzl", "loom_check_test")
load("//loom/target/amdgpu:execution_profiles.bzl", "amdgpu_execution_profile")

package(default_visibility = ["//visibility:public"])

# These sources assert zero access reports against independent reference data.
_EXECUTION_PROFILES = [
    amdgpu_execution_profile(
        name = "amdgpu",
    ),
    amdgpu_execution_profile(
        name = "amdgpu_access",
        runner_args = [
            "--sanitizer=access",
            "--sanitizer-reporting=report-only",
        ],
    ),
]

_GFX11_GENERIC_REPRESENTATION = LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITY_BY_KEY["amdgpu.gfx11.generic.core"]

_GFX11_ASSEMBLY_COMPATIBLE_WITH = (
    loom_amdgpu_descriptor_set_compatible_with(_GFX11_GENERIC_REPRESENTATION) +
    loom_amdgpu_iree_hal_representation_compatible_with(_GFX11_GENERIC_REPRESENTATION)
)

# Qualification is explicit: publishing a source module does not imply support
# for its operations on every target.
_MODULES = [
    "aiter_swiglu_f16",
    "assumptions",
    "atomics",
    "constant_loops",
    "control_flow",
    "early_returns",
    "enum_values",
    "flash_attention",
    "increment_values",
    "integer_increment",
    "llama_rms_norm",
    "packed_byte_arithmetic",
    "packed_float16_conversion",
    "packed_float8_conversion",
    "packed_memory",
    "pointer_walk",
    "record_memory",
    "record_values",
    "scheduled_sum",
    "shaped_intrinsics",
    "short_circuit",
    "storage_updates",
    "structured_continue",
    "symbol_exports",
    "typed_views",
    "vector_depth",
    "vector_initializers",
    "vector_lookup",
    "vector_values",
    "volatile_memory",
]

[
    loom_test(
        name = module + "_test",
        execution_profiles = _EXECUTION_PROFILES,
        module = "//loom/src/loom/import/cxx/test:" + module + "_module",
        target_compatible_with = loom_config_compatible_with(["//loom/config/import:cxx"]),
    )
    for module in _MODULES
]

test_suite(
    name = "kernels_test",
    tests = [":" + module + "_test" for module in _MODULES],
)

loom_test(
    name = "bitcast_test",
    srcs = ["bitcast.cxx"],
    execution_profiles = _EXECUTION_PROFILES,
    target_compatible_with = loom_config_compatible_with(["//loom/config/import:cxx"]),
)

