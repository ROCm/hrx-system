[
    loom_check_test(
        name = name,
        src = name + ".cxx-test",
        runner = "//loom/src/loom/tools/loom-check",
        target_compatible_with = loom_config_compatible_with([
            "//loom/config/import:cxx",
            "//loom/config/target/arch:amdgpu",
        ]),
    )
    for name in [
        "assembly_lowering",
        "assembly_invalid",
        "integer_extrema",
        "opaque_pointers",
        "parameter_alignment",
        "parameter_noalias",
        "vector_lookup",
    ]
]

