_AUTHORING_MODULES = {
    "flash_attention": "//loom/src/loom/test/corpus/authoring/cxx:flash_attention_module",
}

_XFAILS = {
    "vector_values": {},
}

[
    loom_test(
        name = module + "_test",
        execution_profiles = _EXECUTION_PROFILES,
        module = _AUTHORING_MODULES.get(
            module,
            "//loom/src/loom/import/cxx/test:" + module + "_module",
        ),
        target_compatible_with = loom_config_compatible_with(["//loom/config/import:cxx"]),
    )
    for module in _MODULES
    if module not in _XFAILS
]

[
    loom_test(
        name = module + "_test",
        args = [
            "--xfail=%s=%s" % (
                record,
                _XFAILS[module][record],
            )
            for record in sorted(_XFAILS[module])
        ],
        execution_profiles = _EXECUTION_PROFILES,
        module = _AUTHORING_MODULES.get(
            module,
            "//loom/src/loom/import/cxx/test:" + module + "_module",
        ),
        target_compatible_with = loom_config_compatible_with(["//loom/config/import:cxx"]),
    )
    for module in _MODULES
    if module in _XFAILS
]

test_suite(
    name = "kernels_test",
