package(default_visibility = ["//visibility:public"])

_AMDGPU_EXECUTION_PROFILE = amdgpu_execution_profile(
    name = "amdgpu",
)

# Access-instrumented execution fails automatically when a report is emitted.
_EXECUTION_PROFILES = [
    _AMDGPU_EXECUTION_PROFILE,
    amdgpu_execution_profile(
        name = "amdgpu_access",
        runner_args = [
            "--sanitizer=access",
            "--sanitizer-reporting=report-only",
        ],
    ),
]

_GFX11_GENERIC_REPRESENTATION = LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITY_BY_KEY["amdgpu.gfx11.generic.core"]

_GFX11_ASSEMBLY_COMPATIBLE_WITH = (
    loom_amdgpu_descriptor_set_compatible_with(_GFX11_GENERIC_REPRESENTATION) +
    loom_amdgpu_iree_hal_representation_compatible_with(_GFX11_GENERIC_REPRESENTATION)
)

_CDNA3_COMPATIBLE_WITH = loom_config_compatible_with([
