// RUN: with-checks emit source-low target=amdgpu:gfx1250 output=low
// INPUT: cxx root=mxfp4_group_dot I=../../../../../import/cxx/test
#include "mxfp_group_dot.cxx"

// The compact packed-DOT target test owns exact BF16 composition wiring. This
// large CXX integration case verifies that the 32-element MXFP group scales
// that composition across all 16 result lanes while retaining native decode.
// ----
CHECK: low.func.def public target<amdgpu.rdna4.gfx125x.core> abi(hal_kernel) @mxfp4_group_dot*
CHECK-COUNT-4: * = v_cvt_scale_pk8_bf16_fp4 *, %scale
CHECK-COUNT-32: * = v_lshlrev_b32_lit *, 16
CHECK-COUNT-32: * = v_and_b32_lit *, 4294901760
CHECK-COUNT-32: * = v_fma_f32 *, *, *
CHECK-COUNT-1: * = v_add_f32_lit *, 0
CHECK-COUNT-15: * = v_add_f32 *, *
CHECK-NOT: *v_dot2_f32_bf16*
CHECK: return *

// ====
// INPUT: cxx root=mxfp8_group_dot I=../../../../../import/cxx/test
#include "mxfp_group_dot.cxx"

// FP8 uses a different native decoder and the same complete BF16 dot family.
// ----
CHECK: low.func.def public target<amdgpu.rdna4.gfx125x.core> abi(hal_kernel) @mxfp8_group_dot*
CHECK-COUNT-4: * = v_cvt_scale_pk8_bf16_fp8 *, %scale
CHECK-COUNT-32: * = v_lshlrev_b32_lit *, 16
CHECK-COUNT-32: * = v_and_b32_lit *, 4294901760
CHECK-COUNT-32: * = v_fma_f32 *, *, *
CHECK-COUNT-1: * = v_add_f32_lit *, 0
CHECK-COUNT-15: * = v_add_f32 *, *
CHECK-NOT: *v_dot2_f32_bf16*
CHECK: return *
