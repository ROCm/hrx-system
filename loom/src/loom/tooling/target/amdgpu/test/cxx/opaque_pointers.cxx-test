// RUN: emit source-low @copy target=amdgpu:gfx1151 output=low
// Erased interior pointers lower to the same code as typed element addressing.
struct Opaque;
static const Opaque* handle(const void* pointer) {
  return static_cast<const Opaque*>(pointer);
}
[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void copy(const void* input, void* output) {
  auto* opaque = handle(static_cast<const unsigned*>(input) + 5);
  auto* source = static_cast<const unsigned*>(static_cast<const void*>(opaque));
  auto* destination = static_cast<unsigned*>(output) + 2;
  *destination = *source;
}

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @copy() asm {
  %input = resource<hal_binding> {extent = 24, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output = resource<hal_binding> {extent = 12, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %39 = v_mov_b32 0
  %40 = global_load_b32_saddr %39, %input {offset = 20}
  global_store_b32_saddr %39, %40, %output {offset = 8}
  return
}

// ====
[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void copy(const unsigned* input, unsigned* output) { output[2] = input[5]; }

// ----
low.kernel.def target<amdgpu.rdna3_5.core> abi_layout({constant_count = 0, direct_arg_count = 0, direct_arg_names = {}, direct_arg_offsets = [], direct_arg_parameter_indices = [], direct_arg_sizes = [], parameter_count = 2, resource_count = 2, resource_offsets = [0, 8], resource_parameter_indices = [0, 1], uses_kernarg_segment_ptr = true}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @copy() asm {
  %input = resource<hal_binding> {extent = 24, index = 0, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %output = resource<hal_binding> {extent = 12, index = 1, source_type = hal.buffer} : reg<amdgpu.sgpr x2>
  %33 = v_mov_b32 0
  %34 = global_load_b32_saddr %33, %input {offset = 20}
  global_store_b32_saddr %33, %34, %output {offset = 8}
  return
}
