{
  "version": 1,
  "cases": [
    {
      "name": "runs amdgpu cases",
      "run": {
        "tool": "iree-test-loom",
        "args": [
          "{srcdir}/amdgpu_hal_actual.loom",
          "--device=amdgpu"
        ]
      },
      "stdout": {
        "contains": {
          "unordered": [
            "\"format\":\"loom.test.v0\"",
            { "regex": "\"case\":\"store_i32_case\"[^}]*\"passed\":true" },
            {
              "regex": "\"case\":\"store_then_double_i32_case\"[^}]*\"passed\":true"
            },
            "\"failed_sample_count\":0"
          ]
        }
      }
    },
    {
      "name": "reports amdgpu compile rejection as sample issue",
      "run": {
        "tool": "iree-test-loom",
        "args": [
          "{srcdir}/amdgpu_compile_rejection.loom",
          "--case=@dynamic_workgroup_count_case",
          "--device=amdgpu"
        ]
      },
      "exit": {
        "nonzero": true
      },
      "stdout": {
        "contains": {
          "unordered": [
            "\"format\":\"loom.test.v0\"",
            "\"case_count\":1",
            "\"sample_count\":1",
            "\"failed_sample_count\":1",
            {
              "regex": "\"case\":\"dynamic_workgroup_count_case\"[^}]*\"passed\":false"
            },
            "\"issues\":[",
            "\"category\":\"compile_rejected\"",
            "\"provider\":\"actual\"",
            "\"stage\":\"compile\"",
            "\"kind\":\"unresolved_workgroup_count\"",
            "HAL actual invocation requires a statically resolved workgroup count"
          ]
        }
      },
      "stderr": {
        "not_contains": [
          "HAL actual invocation compile was rejected before dispatch",
          "FAILED_PRECONDITION"
        ]
      }
    },
    {
      "name": "runs generated fp8 tensor case",
      "run": {
        "tool": "iree-test-loom",
        "args": [
          "{srcdir}/generated_tensor_cases.loom",
          "--case=@fp8_generated_fill",
          "--device=amdgpu"
        ]
      },
      "stdout": {
        "contains": {
          "unordered": [
            "\"format\":\"loom.test.v0\"",
            {
              "regex": "\"case\":\"fp8_generated_fill\"[^}]*\"passed\":true"
            },
            "\"failed_sample_count\":0"
          ]
        }
      }
    },
    {
      "name": "runs kernels with unused and selected kernargs",
      "run": {
        "tool": "iree-test-loom",
        "args": [
          "{srcdir}/amdgpu_unused_kernargs.loom",
          "--device=amdgpu"
        ]
      },
      "stdout": {
        "contains": {
          "unordered": [
            "\"format\":\"loom.test.v0\"",
            {
              "regex": "\"case\":\"unused_kernargs_case\"[^}]*\"passed\":true"
            },
            {
              "regex": "\"case\":\"unused_middle_binding_case\"[^}]*\"passed\":true"
            },
            {
              "regex": "\"case\":\"selected_lhs_case\"[^}]*\"passed\":true"
            },
            {
              "regex": "\"case\":\"selected_rhs_case\"[^}]*\"passed\":true"
            },
            {
              "regex": "\"case\":\"selected_buffer_per_workgroup_case\"[^}]*\"passed\":true"
            },
            "\"failed_sample_count\":0"
          ]
        }
      }
    }
  ]
}
