{
  "version": 1,
  "cases": [
    {
      "name": "one kernel invocation produces a dispatch event",
      "steps": [
        {
          "name": "capture",
          "run": {
            "tool": "loom-run",
            "args": [
              "{srcdir}/../testdata/benchmark_profile_policy.loom",
              "--root=increment",
              "--device=amdgpu",
              "--kernel-input-buffer=1xi32=7",
              "--kernel-input-buffer=1xi32=-1",
              "--expected-kernel-buffer=1xi32=7",
              "--expected-kernel-buffer=1xi32=8",
              "--device_profiling_mode=dispatch-events",
              "--device_profiling_output={tmp}/increment.irpf"
            ]
          }
        },
        {
          "name": "read-event",
          "run": {
            "tool": "iree-profile",
            "args": ["dispatch", "--format=jsonl", "--dispatch_events", "{tmp}/increment.irpf"]
          },
          "stdout": {"contains": ["\"type\":\"dispatch_event\""]}
        }
      ]
    },
    {
      "name": "single-dispatch comparisons omit suppressed profile artifacts",
      "run": {
        "tool": "loom-benchmark",
        "args": [
          "{srcdir}/../testdata/benchmark_profile_policy.loom",
          "--device=amdgpu",
          "--measure=dispatch_complete",
          "--compare=@single_baseline,@single_candidate",
          "--repetitions=1",
          "--iterations=1",
          "--warmup-iterations=0",
          "--batch-size=1",
          "--min-time-ms=0",
          "--warmup-time-ms=0",
          "--max-batches=1",
          "--profile-data=counter-ranges",
          "--profile-artifacts-dir={tmp}/profiles",
          "--artifact-bundle-dir={tmp}/bundle",
          "--output-format=jsonl"
        ]
      },
      "files": [
        {
          "path": "{tmp}/bundle/results.jsonl",
          "contains": ["\"profile_suppressed_for_interleave\":true"]
        },
        {
          "path": "{tmp}/bundle/manifest.json",
          "non_empty": true,
          "not_contains": [".irpf"]
        },
        {
          "path": "{tmp}/profiles",
          "exists": false
        }
      ]
    },
    {
      "name": "dispatch-sequence comparisons preserve suppression in snapshots",
      "run": {
        "tool": "loom-benchmark",
        "args": [
          "{srcdir}/../testdata/benchmark_profile_policy.loom",
          "--device=amdgpu",
          "--measure=dispatch_complete",
          "--compare=@sequence_baseline,@sequence_candidate",
          "--repetitions=1",
          "--iterations=1",
          "--warmup-iterations=0",
          "--batch-size=1",
          "--min-time-ms=0",
          "--warmup-time-ms=0",
          "--max-batches=1",
          "--profile-data=counter-ranges",
          "--profile-artifacts-dir={tmp}/profiles",
          "--artifact-bundle-dir={tmp}/bundle",
          "--output-format=snapshot"
        ]
      },
      "files": [
        {
          "path": "{tmp}/bundle/results.json",
          "contains": ["\"profile_suppressed_for_interleave\":true"]
        },
        {
          "path": "{tmp}/bundle/manifest.json",
          "non_empty": true,
          "not_contains": [".irpf"]
        },
        {
          "path": "{tmp}/profiles",
          "exists": false
        }
      ]
    }
  ]
}
