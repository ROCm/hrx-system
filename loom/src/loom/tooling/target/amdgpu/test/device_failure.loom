// A finite, instrumented race reports DATA_LOSS through the native HAL's
// fail-device policy without triggering a raw hardware fault.
kernel.def @write_race() {
  %unit = index.constant 1 : index
  %threads = index.constant 2 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%output: buffer) {
  %base = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %value = scalar.constant 1 : i32
  %continued_value = scalar.constant 9 : i32
  %global = buffer.assume.memory_space<global> %output : buffer
  %view = buffer.view %global[%base] : buffer -> view<1xi32>
  view.store %value, %view[0] : i32, view<1xi32>
  %scratch = buffer.alloca<workgroup> align(4) %bytes : buffer
  %shared = buffer.view %scratch[%base] : buffer -> view<1xi32>
  view.store %value, %shared[0] : i32, view<1xi32>
  view.store %continued_value, %view[0] : i32, view<1xi32>
  kernel.return
}

check.scenario @terminal_failure {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %output = check.generate.fill value(0) : tensor<1xi32>
    check.invoke<@write_race>(%output) : (tensor<1xi32>) -> ()
  }
  check.return
}

check.benchmark<@terminal_failure> @terminal_failure_latency
