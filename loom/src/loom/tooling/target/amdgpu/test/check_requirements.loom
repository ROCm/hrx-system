kernel.def @device_kernel() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch() {
  kernel.return
}

check.case @device_case {
  check.requires<hal.amdgpu.descriptor_set> {descriptor_set = "amdgpu.rdna3_5.core"}
  kernel.launch @device_kernel() : ()
  check.return
}

check.case @scalar_case {
  %value = check.literal value(42) : i32
  check.expect.equal actual(%value) expected(%value) : i32
  check.return
}

check.benchmark<@device_case> @device_benchmark

check.case @target_case {
  check.requires<hal.amdgpu.target> {target = "gfx942:xnack-"}
  kernel.launch @device_kernel() : ()
  check.return
}

check.benchmark<@target_case> @target_benchmark
