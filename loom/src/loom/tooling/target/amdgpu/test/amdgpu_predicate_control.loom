// A Boolean select produces a mask while uniform queue arguments use scalars.
kernel.def @uniform_predicate_queue() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%selector: i32, %first_flag: i32, %second_flag: i32, %limit: i32, %output: buffer) {
  %begin = scalar.constant 0 : i32
  %step = scalar.constant 1 : i32
  %base = index.constant 0 : offset
  %output_view = buffer.view %output[%base] : buffer -> view<1xi32>
  %pick_first = scalar.cmpi ne, %selector, %begin : i32
  %first = scalar.cmpi ne, %first_flag, %begin : i32
  %second = scalar.cmpi ne, %second_flag, %begin : i32
  %selected = scf.select %pick_first, %first, %second : i1
  cfg.br ^loop(%begin: i32, %selected: i1, %first: i1)
^loop(%iteration: i32, %head: i1, %tail: i1):
  %again = scalar.cmpi slt, %iteration, %limit : i32
  cfg.cond_br %again, ^body, ^exit
^body:
  %next = scalar.addi %iteration, %step : i32
  cfg.br ^loop(%next: i32, %tail: i1, %head: i1)
^exit:
  cfg.cond_br %head, ^enabled, ^disabled
^enabled:
  view.store %step, %output_view[0] : i32, view<1xi32>
  kernel.return
^disabled:
  view.store %begin, %output_view[0] : i32, view<1xi32>
  kernel.return
}

check.case @uniform_predicate_queue_selected_false {
  %selector = check.literal value(0) : i32
  %first = check.literal value(1) : i32
  %second = check.literal value(0) : i32
  %count = check.literal value(2) : i32
  %actual = check.generate.fill value(-1) : tensor<1xi32>
  %expected = check.generate.fill value(0) : tensor<1xi32>
  kernel.launch @uniform_predicate_queue(%selector, %first, %second, %count, %actual) : (i32, i32, i32, i32, tensor<1xi32>)
  check.expect.equal actual(%actual) expected(%expected) : tensor<1xi32>
  check.return
}

check.case @uniform_predicate_queue_selected_true {
  %selector = check.literal value(0) : i32
  %first = check.literal value(0) : i32
