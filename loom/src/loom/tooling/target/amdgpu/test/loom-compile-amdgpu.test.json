{
  "version": 1,
  "cases": [
    {
      "name": "preserves native emission diagnostic locations",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/feature_distinct_code_objects.loom",
          "--pipeline=none",
          "--format=amdgpu-hsaco",
          "--output={tmp}/feature-distinct.hsaco"
        ]
      },
      "exit": 1,
      "stderr": {
        "contains": [
          "feature_distinct_code_objects.loom:9:1",
          "AMDGPU/051",
          "first code-object target selected here",
          "feature_distinct_code_objects.loom:5:1"
        ]
      },
      "files": [
        {"path": "{tmp}/feature-distinct.hsaco", "exists": false}
      ]
    },
    {
      "name": "resumes explicit kernel roots from Low text and bytecode",
      "steps": [
        {
          "name": "compile-source",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{srcdir}/loom_opt_f32_arith.loom",
              "--root=@f32_arith",
              "--format=amdgpu-hsaco",
              "--output={tmp}/source.hsaco"
            ]
          },
          "files": [{"path": "{tmp}/source.hsaco", "non_empty": true}]
        },
        {
          "name": "save-low-text",
          "run": {
            "tool": "loom-opt",
            "args": [
              "{srcdir}/loom_opt_f32_arith.loom",
              "--pipeline=source-low",
              "--output={tmp}/prepared.loom"
            ]
          },
          "files": [{"path": "{tmp}/prepared.loom", "contains": ["low.kernel.def"]}]
        },
        {
          "name": "compile-low-text",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{tmp}/prepared.loom",
              "--root=@f32_arith",
              "--format=amdgpu-hsaco",
              "--output={tmp}/text.hsaco"
            ]
          },
          "files": [{"path": "{tmp}/text.hsaco", "equals": "{tmp}/source.hsaco"}]
        },
        {
          "name": "save-low-bytecode",
          "run": {
            "tool": "loom-format",
            "args": [
              "{tmp}/prepared.loom",
              "--to=bc",
              "--output={tmp}/prepared.loombc"
            ]
          },
          "files": [{"path": "{tmp}/prepared.loombc", "non_empty": true}]
        },
        {
          "name": "compile-low-bytecode",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{tmp}/prepared.loombc",
              "--root=@f32_arith",
              "--format=amdgpu-hsaco",
              "--output={tmp}/bytecode.hsaco"
            ]
          },
          "files": [{"path": "{tmp}/bytecode.hsaco", "equals": "{tmp}/source.hsaco"}]
        },
        {
          "name": "infer-low-kernel-root-and-format",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{tmp}/prepared.loom",
              "--output={tmp}/implicit.hsaco"
            ]
          },
          "files": [{"path": "{tmp}/implicit.hsaco", "equals": "{tmp}/source.hsaco"}]
        }
      ]
    },
    {
      "name": "reports invocation-specialized targets to suggestion providers",
      "steps": [
        {
          "name": "compile-generic-root-for-gfx1151",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{srcdir}/selected_root_amdgpu.loom",
              "--format=amdgpu-hsaco",
              "--root=@selected_store_i32",
              "--target=amdgpu:gfx1151",
              "--output={tmp}/specialized_report.hsaco",
              "--compile-report=summary",
              "--compile-report-output={tmp}/specialized_report.json"
            ]
          },
          "files": [
            {
              "path": "{tmp}/specialized_report.hsaco",
              "non_empty": true
            },
            {
              "path": "{tmp}/specialized_report.json",
              "contains": {"unordered": [
                "\"artifact_kind\":\"hal-executable\"",
                "\"backend\":\"amdgpu-hal\"",
                "\"target_family\":\"amdgpu\"",
                "\"target_key\":\"gfx1151\"",
                "\"residency_constraints\":{\"count\":4,\"rows\":[",
                "\"name\":\"amdgpu.lds\",\"kind\":\"pooled_resource\",\"unit\":\"bytes\",\"allocation_scope\":\"workgroup\"",
                "\"name\":\"amdgpu.workgroup_slots\",\"kind\":\"fixed_limit\""
              ]}
            }
          ]
        },
        {
          "name": "suggest-for-effective-gfx1151-target",
          "run": {
            "tool": "loom-compile-report",
            "args": [
              "suggest",
              "{tmp}/specialized_report.json",
              "--format=json"
            ]
          },
          "stdout": {
            "contains": [
              "\"provider\":\"amdgpu\"",
              "\"status\":\"available\"",
              "\"target\":{\"family\":\"amdgpu\",\"key\":\"gfx1151\"}"
            ]
          }
        }
      ]
    },
    {
      "name": "excludes kernel roots before target specialization",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/selected_root_amdgpu.loom",
          "--exclude-root=configured_targetless_store_i32",
          "--target=amdgpu:gfx1151",
          "--format=amdgpu-hsaco",
          "--output={tmp}/excluded.hsaco",
          "--compile-report=summary",
          "--compile-report-output={tmp}/excluded.json"
        ]
      },
      "files": [
        {
          "path": "{tmp}/excluded.json",
          "contains": ["selected_store_i32", "targetless_math_f32"],
          "not_contains": ["configured_targetless_store_i32"]
        },
        {
          "path": "{tmp}/excluded.hsaco",
          "non_empty": true
        }
      ]
    },
    {
      "name": "preserves independent motif scopes and partial waits in native compilation",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/corpus/gfx11/schedule_scopes.loom",
          "--root=@paired_scope",
          "--target=amdgpu:gfx1151",
          "--format=amdgpu-hsaco",
          "--output={tmp}/scoped.hsaco",
          "--compile-report=details",
          "--compile-report-output={tmp}/scoped.json"
        ]
      },
      "files": [
        {
          "path": "{tmp}/scoped.json",
          "contains": {"unordered": [
            "\"scope_count\":2",
            "\"schedule_scope_count\":2",
            {"regex": "\"wait_plan\":\\{[^}]*\"partial_wait_count\":[1-9][0-9]*[,}]"}
          ]}
        },
        {
          "path": "{tmp}/scoped.hsaco",
          "non_empty": true
        }
      ]
    }
  ]
}
