{
  "version": 1,
  "cases": [
    {
      "name": "does not publish output after a compiler diagnostic",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/feature_distinct_code_objects.loom",
          "--pipeline=none",
          "--format=amdgpu-hsaco",
          "--output={tmp}/feature-distinct.hsaco"
        ]
      },
      "exit": 1,
      "stderr": {"non_empty": true},
      "files": [
        {"path": "{tmp}/feature-distinct.hsaco", "exists": false}
      ]
    },
    {
      "name": "infers kernel roots from a complete authoring module",
      "steps": [
        {
          "name": "compile-inferred-root",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{srcdir}/complete_authoring_module.loom",
              "--target=amdgpu:gfx1100",
              "--format=amdgpu-hsaco",
              "--output={tmp}/inferred-root.hsaco"
            ]
          },
          "files": [
            {"path": "{tmp}/inferred-root.hsaco", "non_empty": true}
          ]
        },
        {
          "name": "compile-explicit-root",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{srcdir}/complete_authoring_module.loom",
              "--root=@complete_authoring_copy_i32",
              "--target=amdgpu:gfx1100",
              "--format=amdgpu-hsaco",
              "--output={tmp}/explicit-root.hsaco"
            ]
          },
          "files": [
            {
              "path": "{tmp}/explicit-root.hsaco",
              "equals": "{tmp}/inferred-root.hsaco"
            }
          ]
        }
      ]
    },
    {
      "name": "resumes explicit kernel roots from Low text and bytecode",
      "steps": [
        {
          "name": "compile-source",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{srcdir}/loom_opt_f32_arith.loom",
              "--root=@f32_arith",
              "--format=amdgpu-hsaco",
              "--output={tmp}/source.hsaco",
              "--dump-ir-before=source-to-low",
              "--dump-ir-after=source-to-low",
              "--dump-ir-output={tmp}/compile-trace/"
            ]
          },
          "files": [
            {"path": "{tmp}/source.hsaco", "non_empty": true},
            {"path": "{tmp}/compile-trace/ir/000000-before-source-to-low.loom", "non_empty": true},
            {"path": "{tmp}/compile-trace/ir/000001-after-source-to-low.loom", "non_empty": true}
          ]
        },
        {
          "name": "save-low-text",
          "run": {
            "tool": "loom-opt",
            "args": [
              "{srcdir}/loom_opt_f32_arith.loom",
              "--pipeline=source-low",
              "--output={tmp}/prepared.loom"
            ]
          },
          "files": [{"path": "{tmp}/prepared.loom", "non_empty": true}]
        },
        {
          "name": "compile-low-text",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{tmp}/prepared.loom",
              "--root=@f32_arith",
              "--format=amdgpu-hsaco",
              "--output={tmp}/text.hsaco"
            ]
          },
          "files": [{"path": "{tmp}/text.hsaco", "equals": "{tmp}/source.hsaco"}]
        },
        {
          "name": "save-low-bytecode",
          "run": {
            "tool": "loom-opt",
            "args": [
              "{srcdir}/loom_opt_f32_arith.loom",
              "--pipeline=source-low",
              "--to=bytecode",
              "--output={tmp}/prepared.loombc"
            ]
          },
          "files": [{"path": "{tmp}/prepared.loombc", "non_empty": true}]
        },
        {
          "name": "compile-low-bytecode",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{tmp}/prepared.loombc",
              "--root=@f32_arith",
              "--format=amdgpu-hsaco",
              "--output={tmp}/bytecode.hsaco"
            ]
          },
          "files": [{"path": "{tmp}/bytecode.hsaco", "equals": "{tmp}/source.hsaco"}]
        },
        {
          "name": "infer-low-kernel-root-and-format",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{tmp}/prepared.loom",
              "--output={tmp}/implicit.hsaco"
            ]
          },
          "files": [{"path": "{tmp}/implicit.hsaco", "non_empty": true}]
        }
      ]
    },
    {
      "name": "routes compile report output to the suggestion tool",
      "steps": [
        {
          "name": "compile-generic-root-for-gfx1151",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{srcdir}/selected_root_amdgpu.loom",
              "--format=amdgpu-hsaco",
              "--root=@selected_store_i32",
              "--target=amdgpu:gfx1151",
              "--output={tmp}/specialized_report.hsaco",
              "--compile-report=summary",
              "--compile-report-output={tmp}/specialized_report.json"
            ]
          },
          "files": [
            {
              "path": "{tmp}/specialized_report.hsaco",
              "non_empty": true
            },
            {
              "path": "{tmp}/specialized_report.json",
              "non_empty": true
            }
          ]
        },
        {
          "name": "suggest-for-effective-gfx1151-target",
          "run": {
            "tool": "loom-compile-report",
            "args": [
              "suggest",
              "{tmp}/specialized_report.json",
              "--format=json"
            ]
          },
          "stdout": {
            "non_empty": true
          }
        }
      ]
    },
    {
      "name": "routes a detailed compile report through public report tools",
      "steps": [
        {
          "name": "capture-math-expansions",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{srcdir}/selected_root_amdgpu.loom",
              "--root=@targetless_math_f32",
              "--target=amdgpu:gfx1151",
              "--output={tmp}/math.hsaco",
              "--compile-report=details",
              "--compile-report-output={tmp}/math.json"
            ]
          },
          "files": [{"path": "{tmp}/math.hsaco", "non_empty": true}]
        },
        {
          "name": "show-math-expansions",
          "run": {
            "tool": "loom-compile-report",
            "args": ["show", "{tmp}/math.json"]
          },
          "stdout": {"non_empty": true}
        },
        {
          "name": "suggest-math-expansion-investigation",
          "run": {
            "tool": "loom-compile-report",
            "args": ["suggest", "{tmp}/math.json", "--format=json"]
          },
          "stdout": {"non_empty": true}
        }
      ]
    },
    {
      "name": "accepts root exclusion with report output",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/selected_root_amdgpu.loom",
          "--exclude-root=configured_targetless_store_i32",
          "--target=amdgpu:gfx1151",
          "--format=amdgpu-hsaco",
          "--output={tmp}/excluded.hsaco",
          "--compile-report=summary",
          "--compile-report-output={tmp}/excluded.json"
        ]
      },
      "files": [
        {
          "path": "{tmp}/excluded.json",
          "non_empty": true
        },
        {
          "path": "{tmp}/excluded.hsaco",
          "non_empty": true
        }
      ]
    },
    {
      "name": "rejects correctness execution during compile-only capture",
      "run": {
        "tool": "loom-benchmark",
        "args": [
          "{srcdir}/compile_requests.loom",
          "--compile-only",
          "--scenario-correctness=true",
          "--target=amdgpu:gfx1100",
          "--artifact-bundle-dir={tmp}/compile-request-bundle"
        ]
      },
      "exit": {"nonzero": true},
      "stderr": {
        "contains": ["--scenario-correctness is unavailable with --compile-only"]
      },
      "files": [
        {
          "path": "{tmp}/compile-request-bundle/compile_requests/manifest.json",
          "exists": false
        }
      ]
    },
    {
      "name": "captures selected benchmark samples as portable compile requests",
      "steps": [
        {
          "name": "capture",
          "run": {
            "tool": "loom-benchmark",
            "args": [
              "{srcdir}/compile_requests.loom",
              "--compile-only",
              "--target=amdgpu:gfx1100",
              "--config=compile_requests.alpha=4",
              "--config=compile_requests.beta=8",
              "--artifact-bundle-dir={tmp}/compile-request-bundle"
            ]
          },
          "files": [
            {
              "path": "{tmp}/compile-request-bundle/compile_requests/manifest.json",
              "contains": [
                "\"target\":\"amdgpu:gfx1100\"",
                "\"config\":[{\"key\":\"compile_requests.alpha\",\"value\":\"4\"},{\"key\":\"compile_requests.beta\",\"value\":\"8\"}]",
                "\"parameters\":{\"width\":4}",
                "\"parameters\":{\"width\":8}",
                "\"symbol\":\"sample_kernel\"",
                "\"selection_count\":2,\"selected_sample_count\":3,\"capture_count\":2,\"request_count\":2,\"failure_count\":0,\"failed_selection_count\":0"
              ]
            },
            {
              "path": "{tmp}/compile-request-bundle/results.json",
              "contains": [
                "\"mode\":\"compile_only\"",
                "\"compile_request_count\":2",
                "\"compile_request_manifest_count\":1"
              ]
            },
            {
              "path": "{tmp}/compile-request-bundle/compile_requests/capture0000-r0000.loombc",
              "non_empty": true
            },
            {
              "path": "{tmp}/compile-request-bundle/compile_requests/capture0001-r0000.loombc",
              "non_empty": true
            }
          ]
        },
        {
          "name": "compile-captured-request",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{tmp}/compile-request-bundle/compile_requests/capture0001-r0000.loombc",
              "--root=@sample_kernel",
              "--target=amdgpu:gfx1100",
              "--format=amdgpu-hsaco",
              "--output={tmp}/sample.hsaco"
            ]
          },
          "files": [
            {
              "path": "{tmp}/sample.hsaco",
              "non_empty": true
            }
          ]
        }
      ]
    }
  ]
}
