{
  "version": 1,
  "cases": [
    {
      "name": "lowers single-subgroup workgroup barriers to memory ordering waits",
      "steps": [
        {
          "name": "compile-gfx11-generic",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{srcdir}/single_subgroup_barrier.loom",
              "--backend=amdgpu-hal",
              "--target=gfx11-generic",
              "--output={tmp}/single_subgroup_barrier_gfx11.hal",
              "--emit-target-artifact={tmp}/single_subgroup_barrier_gfx11.hsaco",
              "--compile-report=details",
              "--compile-report-output={tmp}/single_subgroup_barrier_gfx11_report.json"
            ]
          },
          "files": [
            {
              "path": "{tmp}/single_subgroup_barrier_gfx11.hal",
              "non_empty": true
            },
            {
              "path": "{tmp}/single_subgroup_barrier_gfx11.hsaco",
              "non_empty": true
            },
            {
              "path": "{tmp}/single_subgroup_barrier_gfx11_report.json",
              "contains": [
                "amdgpu.kernel_barrier.strategy.lds_wait.single_subgroup_workgroup"
              ]
            }
          ]
        },
        {
          "name": "compile-gfx1151",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{srcdir}/single_subgroup_barrier.loom",
              "--backend=amdgpu-hal",
              "--target=gfx1151",
              "--output={tmp}/single_subgroup_barrier_gfx1151.hal",
              "--emit-target-artifact={tmp}/single_subgroup_barrier_gfx1151.hsaco"
            ]
          },
          "files": [
            {
              "path": "{tmp}/single_subgroup_barrier_gfx1151.hal",
              "non_empty": true
            },
            {
              "path": "{tmp}/single_subgroup_barrier_gfx1151.hsaco",
              "non_empty": true
            }
          ]
        }
      ]
    },
    {
      "name": "compiles exact and uniform dynamic wave64 broadcasts across native wave32 halves",
      "steps": [
        {
          "name": "compile-gfx11-generic",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{srcdir}/wave64_named_lane_broadcast.loom",
              "--backend=amdgpu-hal",
              "--target=gfx11-generic",
              "--output={tmp}/wave64_named_lane_broadcast_gfx11.hal",
              "--emit-target-artifact={tmp}/wave64_named_lane_broadcast_gfx11.hsaco",
              "--compile-report=details",
              "--compile-report-output={tmp}/wave64_named_lane_broadcast_gfx11_report.json"
            ]
          },
          "files": [
            {
              "path": "{tmp}/wave64_named_lane_broadcast_gfx11.hal",
              "non_empty": true
            },
            {
              "path": "{tmp}/wave64_named_lane_broadcast_gfx11.hsaco",
              "non_empty": true
            },
            {
              "path": "{tmp}/wave64_named_lane_broadcast_gfx11_report.json",
              "contains": [
                "amdgpu.subgroup_broadcast.strategy.scalar_readlane.named_lane"
              ]
            }
          ]
        },
        {
          "name": "compile-gfx1151",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{srcdir}/wave64_named_lane_broadcast.loom",
              "--backend=amdgpu-hal",
              "--target=gfx1151",
              "--output={tmp}/wave64_named_lane_broadcast_gfx1151.hal",
              "--emit-target-artifact={tmp}/wave64_named_lane_broadcast_gfx1151.hsaco"
            ]
          },
          "files": [
            {
              "path": "{tmp}/wave64_named_lane_broadcast_gfx1151.hal",
              "non_empty": true
            },
            {
              "path": "{tmp}/wave64_named_lane_broadcast_gfx1151.hsaco",
              "non_empty": true
            }
          ]
        }
      ]
    },
    {
      "name": "compiles HAL kernel closures from complete authoring modules",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/complete_authoring_module.loom",
          "--backend=amdgpu-hal",
          "--target=gfx1100",
          "--output={tmp}/complete_authoring_module.hal",
          "--emit-target-artifact={tmp}/complete_authoring_module.hsaco"
        ]
      },
      "files": [
        {
          "path": "{tmp}/complete_authoring_module.hal",
          "non_empty": true
        },
        {
          "path": "{tmp}/complete_authoring_module.hsaco",
          "non_empty": true
        }
      ]
    },
    {
      "name": "retains lane preamble inputs selected by fragment repacks",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/fragment_repack_lane_preamble.loom",
          "--backend=amdgpu-hal",
          "--target=gfx1100",
          "--output={tmp}/fragment_repack_lane_preamble.hal",
          "--emit-target-artifact={tmp}/fragment_repack_lane_preamble.hsaco",
          "--compile-report=details",
          "--compile-report-output={tmp}/fragment_repack_lane_preamble_report.json"
        ]
      },
      "files": [
        {
          "path": "{tmp}/fragment_repack_lane_preamble.hal",
          "non_empty": true
        },
        {
          "path": "{tmp}/fragment_repack_lane_preamble.hsaco",
          "non_empty": true
        },
        {
          "path": "{tmp}/fragment_repack_lane_preamble_report.json",
          "contains": [
            "amdgpu.fragment_repack.strategy.result_to_lhs_bf16_transpose_bpermute"
          ]
        }
      ]
    },
    {
      "name": "preserves HAL binding identity without authored export names",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/amdgpu_unused_kernargs.loom",
          "--backend=amdgpu-hal",
          "--target=gfx1100",
          "--root=@unused_middle_binding",
          "--output={tmp}/binding_identity.hal",
          "--emit-target-artifact={tmp}/binding_identity.hsaco"
        ]
      },
      "files": [
        {
          "path": "{tmp}/binding_identity.hal",
          "non_empty": true
        },
        {
          "path": "{tmp}/binding_identity.hsaco",
          "non_empty": true
        }
      ]
    },
    {
      "name": "compiles runtime-selected HAL binding descriptors",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/amdgpu_unused_kernargs.loom",
          "--backend=amdgpu-hal",
          "--target=gfx1100",
          "--root=@selected_buffer",
          "--output={tmp}/selected_buffer.hal",
          "--emit-target-artifact={tmp}/selected_buffer.hsaco"
        ]
      },
      "files": [
        {
          "path": "{tmp}/selected_buffer.hal",
          "non_empty": true
        },
        {
          "path": "{tmp}/selected_buffer.hsaco",
          "non_empty": true
        }
      ]
    },
    {
      "name": "compiles parameterized gfx1250 matrix kernel",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/gfx1250_configured_fragment_bank.loom",
          "--backend=amdgpu-hal",
          "--target=gfx1250",
          "--config=test.fragment_bank.m_fragments=8",
          "--config=test.fragment_bank.n_fragments=4",
          "--config=test.fragment_bank.k_fragments=2",
          "--config=test.fragment_bank.workgroup_size=32",
          "--config=test.fragment_bank.scratch_elements=32",
          "--output={tmp}/configured_fragment_bank.hal",
          "--emit-target-artifact={tmp}/configured_fragment_bank.hsaco"
        ]
      },
      "files": [
        {
          "path": "{tmp}/configured_fragment_bank.hal",
          "non_empty": true
        },
        {
          "path": "{tmp}/configured_fragment_bank.hsaco",
          "non_empty": true
        }
      ]
    },
    {
      "name": "selects invocation-compatible AMDGPU template families",
      "steps": [
        {
          "name": "compile-gfx1100-exact",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{srcdir}/target_family_template_provider_amdgpu.loom",
              "--backend=amdgpu-hal",
              "--target=gfx1100",
              "--output={tmp}/target_family_gfx1100.hal",
              "--emit-target-artifact={tmp}/target_family_gfx1100.hsaco"
            ]
          },
          "files": [
            {
              "path": "{tmp}/target_family_gfx1100.hal",
              "non_empty": true
            },
            {
              "path": "{tmp}/target_family_gfx1100.hsaco",
              "non_empty": true
            }
          ]
        },
        {
          "name": "compile-gfx1251-exact",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{srcdir}/target_family_template_provider_amdgpu.loom",
              "--backend=amdgpu-hal",
              "--target=gfx1251",
              "--output={tmp}/target_family_gfx1251.hal",
              "--emit-target-artifact={tmp}/target_family_gfx1251.hsaco"
            ]
          },
          "files": [
            {
              "path": "{tmp}/target_family_gfx1251.hal",
              "non_empty": true
            },
            {
              "path": "{tmp}/target_family_gfx1251.hsaco",
              "non_empty": true
            }
          ]
        },
        {
          "name": "reject-incompatible-gfx1200-family",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{srcdir}/target_family_template_provider_amdgpu.loom",
              "--backend=amdgpu-hal",
              "--target=gfx1200",
              "--output={tmp}/target_family_gfx1200.hal"
            ]
          },
          "exit": {
            "nonzero": true
          },
          "stderr": {
            "contains": [
              "error [LOWERING/045]",
              "target_mismatch"
            ]
          }
        }
      ]
    },
    {
      "name": "resolves target selection after root and config selection",
      "steps": [
        {
          "name": "compile-authored-target-root",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{srcdir}/selected_root_amdgpu.loom",
              "--backend=amdgpu-hal",
              "--root=@selected_store_i32",
              "--output={tmp}/selected_root_amdgpu.hal",
              "--emit-target-artifact={tmp}/selected_root_amdgpu.hsaco"
            ]
          },
          "files": [
            {
              "path": "{tmp}/selected_root_amdgpu.hal",
              "non_empty": true
            },
            {
              "path": "{tmp}/selected_root_amdgpu.hsaco",
              "non_empty": true
            }
          ]
        },
        {
          "name": "compile-configured-invocation-target-root",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{srcdir}/selected_root_amdgpu.loom",
              "--backend=amdgpu-hal",
              "--root=@configured_targetless_store_i32",
              "--target=gfx1151",
              "--config=test.targetless.workgroups_x=2",
              "--config=test.targetless.workgroup_size_x=64",
              "--output={tmp}/targetless_root_amdgpu.hal",
              "--emit-target-artifact={tmp}/targetless_root_amdgpu.hsaco"
            ]
          },
          "files": [
            {
              "path": "{tmp}/targetless_root_amdgpu.hal",
              "non_empty": true
            },
            {
              "path": "{tmp}/targetless_root_amdgpu.hsaco",
              "non_empty": true
            }
          ]
        },
        {
          "name": "compile-targetless-math-with-invocation-target",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{srcdir}/selected_root_amdgpu.loom",
              "--backend=amdgpu-hal",
              "--root=@targetless_math_f32",
              "--target=gfx1100",
              "--output={tmp}/targetless_math_amdgpu.hal",
              "--emit-target-artifact={tmp}/targetless_math_amdgpu.hsaco"
            ]
          },
          "files": [
            {
              "path": "{tmp}/targetless_math_amdgpu.hal",
              "non_empty": true
            },
            {
              "path": "{tmp}/targetless_math_amdgpu.hsaco",
              "non_empty": true
            }
          ]
        },
        {
          "name": "reject-targetless-root-without-invocation-target",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{srcdir}/selected_root_amdgpu.loom",
              "--backend=amdgpu-hal",
              "--root=@configured_targetless_store_i32",
              "--config=test.targetless.workgroups_x=2",
              "--config=test.targetless.workgroup_size_x=64",
              "--output={tmp}/missing_target_amdgpu.hal"
            ]
          },
          "exit": {
            "nonzero": true
          },
          "stderr": {
            "contains": [
              "HAL backend 'amdgpu-hal' requires --target= when 1 kernel.def root omit target(...) attrs"
            ]
          }
        }
      ]
    },
    {
      "name": "relaxes long SOPP branches after sanitizer expansion",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/long_sopp_branch.loom",
          "--backend=amdgpu-hal",
          "--target=gfx11-generic",
          "--root=long_sopp_branch",
          "--sanitizer=access",
          "--output={tmp}/long_sopp_branch.hal",
          "--emit-target-artifact={tmp}/long_sopp_branch.hsaco",
          "--compile-report=details",
          "--compile-report-output={tmp}/long_sopp_branch_report.json"
        ]
      },
      "files": [
        {
          "path": "{tmp}/long_sopp_branch.hal",
          "non_empty": true
        },
        {
          "path": "{tmp}/long_sopp_branch.hsaco",
          "non_empty": true
        },
        {
          "path": "{tmp}/long_sopp_branch_report.json",
          "contains": [
            "\"packet_key\":\"amdgpu.s_branch\""
          ]
        }
      ]
    },
    {
      "name": "reports invocation-specialized targets to suggestion providers",
      "steps": [
        {
          "name": "compile-generic-root-for-gfx1151",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{srcdir}/selected_root_amdgpu.loom",
              "--backend=amdgpu-hal",
              "--root=@selected_store_i32",
              "--target=gfx1151",
              "--output={tmp}/specialized_report.hal",
              "--emit-target-artifact={tmp}/specialized_report.hsaco",
              "--compile-report=summary",
              "--compile-report-output={tmp}/specialized_report.json"
            ]
          },
          "files": [
            {
              "path": "{tmp}/specialized_report.json",
              "contains": [
                "\"target_family\":\"AMDGPU\"",
                "\"target_key\":\"gfx1151\""
              ]
            }
          ]
        },
        {
          "name": "suggest-for-effective-gfx1151-target",
          "run": {
            "tool": "loom-compile-report",
            "args": [
              "suggest",
              "{tmp}/specialized_report.json",
              "--format=json"
            ]
          },
          "stdout": {
            "contains": [
              "\"provider\":\"amdgpu\"",
              "\"status\":\"available\"",
              "\"target\":{\"family\":\"AMDGPU\",\"key\":\"gfx1151\"}"
            ]
          }
        }
      ]
    }
  ]
}
