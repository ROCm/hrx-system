{
  "version": 1,
  "cases": [
    {
      "name": "resumes explicit kernel roots from Low text and bytecode",
      "steps": [
        {
          "name": "compile-source",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{srcdir}/loom_opt_f32_arith.loom",
              "--root=@f32_arith",
              "--format=amdgpu-hsaco",
              "--output={tmp}/source.hsaco"
            ]
          },
          "files": [{"path": "{tmp}/source.hsaco", "non_empty": true}]
        },
        {
          "name": "save-low-text",
          "run": {
            "tool": "loom-opt",
            "args": [
              "{srcdir}/loom_opt_f32_arith.loom",
              "--pipeline=source-low",
              "--output={tmp}/prepared.loom"
            ]
          },
          "files": [{"path": "{tmp}/prepared.loom", "contains": ["low.kernel.def"]}]
        },
        {
          "name": "compile-low-text",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{tmp}/prepared.loom",
              "--root=@f32_arith",
              "--format=amdgpu-hsaco",
              "--output={tmp}/text.hsaco"
            ]
          },
          "files": [{"path": "{tmp}/text.hsaco", "equals": "{tmp}/source.hsaco"}]
        },
        {
          "name": "save-low-bytecode",
          "run": {
            "tool": "loom-format",
            "args": [
              "{tmp}/prepared.loom",
              "--to=bc",
              "--output={tmp}/prepared.loombc"
            ]
          },
          "files": [{"path": "{tmp}/prepared.loombc", "non_empty": true}]
        },
        {
          "name": "compile-low-bytecode",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{tmp}/prepared.loombc",
              "--root=@f32_arith",
              "--format=amdgpu-hsaco",
              "--output={tmp}/bytecode.hsaco"
            ]
          },
          "files": [{"path": "{tmp}/bytecode.hsaco", "equals": "{tmp}/source.hsaco"}]
        },
        {
          "name": "infer-low-kernel-root",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{tmp}/prepared.loom",
              "--format=amdgpu-hsaco",
              "--output={tmp}/implicit.hsaco"
            ]
          },
          "files": [{"path": "{tmp}/implicit.hsaco", "equals": "{tmp}/source.hsaco"}]
        }
      ]
    },
    {
      "name": "compiles HAL kernel closures from complete authoring modules",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/complete_authoring_module.loom",
          "--target=amdgpu:gfx1100",
          "--output={tmp}/complete_authoring_module.hal",
          "--emit-target-artifact={tmp}/complete_authoring_module.hsaco"
        ]
      },
      "files": [
        {
          "path": "{tmp}/complete_authoring_module.hal",
          "non_empty": true
        },
        {
          "path": "{tmp}/complete_authoring_module.hsaco",
          "non_empty": true
        }
      ]
    },
    {
      "name": "compiles parameterized gfx1250 matrix kernel",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/gfx1250_configured_fragment_bank.loom",
          "--product=kernel",
          "--format=amdgpu-hsaco",
          "--target=amdgpu:gfx1250",
          "--config=test.fragment_bank.m_fragments=8",
          "--config=test.fragment_bank.n_fragments=4",
          "--config=test.fragment_bank.k_fragments=2",
          "--config=test.fragment_bank.workgroup_size=32",
          "--config=test.fragment_bank.scratch_elements=32",
          "--output={tmp}/configured_fragment_bank.hal",
          "--emit-target-artifact={tmp}/configured_fragment_bank.hsaco"
        ]
      },
      "files": [
        {
          "path": "{tmp}/configured_fragment_bank.hal",
          "non_empty": true
        },
        {
          "path": "{tmp}/configured_fragment_bank.hsaco",
          "non_empty": true
        }
      ]
    },
    {
      "name": "reports invocation-specialized targets to suggestion providers",
      "steps": [
        {
          "name": "compile-generic-root-for-gfx1151",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{srcdir}/selected_root_amdgpu.loom",
              "--product=kernel",
              "--format=amdgpu-hsaco",
              "--root=@selected_store_i32",
              "--target=amdgpu:gfx1151",
              "--output={tmp}/specialized_report.hal",
              "--emit-target-artifact={tmp}/specialized_report.hsaco",
              "--compile-report=summary",
              "--compile-report-output={tmp}/specialized_report.json"
            ]
          },
          "files": [
            {
              "path": "{tmp}/specialized_report.json",
              "contains": [
                "\"target_family\":\"amdgpu\"",
                "\"target_key\":\"gfx1151\"",
                "\"residency_constraints\":{\"count\":4,\"rows\":[",
                "\"name\":\"amdgpu.lds\",\"kind\":\"pooled_resource\",\"unit\":\"bytes\",\"allocation_scope\":\"workgroup\"",
                "\"name\":\"amdgpu.workgroup_slots\",\"kind\":\"fixed_limit\""
              ]
            }
          ]
        },
        {
          "name": "suggest-for-effective-gfx1151-target",
          "run": {
            "tool": "loom-compile-report",
            "args": [
              "suggest",
              "{tmp}/specialized_report.json",
              "--format=json"
            ]
          },
          "stdout": {
            "contains": [
              "\"provider\":\"amdgpu\"",
              "\"status\":\"available\"",
              "\"target\":{\"family\":\"amdgpu\",\"key\":\"gfx1151\"}"
            ]
          }
        }
      ]
    },
    {
      "name": "preserves independent motif scopes and partial waits in native compilation",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/corpus/gfx11/schedule_scopes.loom",
          "--root=@paired_scope",
          "--target=amdgpu:gfx1151",
          "--format=amdgpu-hsaco",
          "--output={tmp}/scoped.hal",
          "--emit-target-artifact={tmp}/scoped.hsaco",
          "--compile-report=details",
          "--compile-report-output={tmp}/scoped.json"
        ]
      },
      "files": [
        {
          "path": "{tmp}/scoped.json",
          "contains": [
            "\"scope_count\":2",
            "\"schedule_scope_count\":2",
            "\"action_count\":4,\"explicit_action_count\":0,\"planned_action_count\":4,\"full_drain_count\":1,\"partial_wait_count\":3",
            "\"register_class\":\"amdgpu.vgpr\",\"final\":{\"register_count\":56",
            "\"code_byte_count\":252"
          ]
        },
        {
          "path": "{tmp}/scoped.hsaco",
          "non_empty": true
        }
      ]
    }
  ]
}
