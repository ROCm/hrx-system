{
  "version": 1,
  "cases": [
    {
      "name": "dumps AMDGPU source-low stage as JSONL",
      "run": {
        "tool": "loom-opt",
        "args": [
          "{srcdir}/loom_opt_f32_arith.loom",
          "--pipeline=source-low",
          "--dump-ir-after=source-to-low",
          "--dump-ir-format=jsonl",
          "--dump-ir-output=stderr",
          "--output={tmp}/source-low.loom"
        ]
      },
      "stderr": {
        "contains": [
          "\"tool\":\"loom-opt\"",
          "\"stage\":\"source-low\"",
          "\"pipeline\":\"__loom_opt_source_low\"",
          "\"pass\":\"source-to-low\"",
          "\"point\":\"after\""
        ]
      },
      "files": [
        {
          "path": "{tmp}/source-low.loom",
          "non_empty": true
        }
      ]
    },
    {
      "name": "default and prepared-low preserve the same serialized target facts",
      "steps": [
        {
          "run": {
            "tool": "loom-opt",
            "args": [
              "{srcdir}/loom_opt_f32_arith.loom",
              "--pipeline=prepared-low",
              "--output={tmp}/prepared.loom"
            ]
          },
          "stderr": {
            "empty": true
          }
        },
        {
          "run": {
            "tool": "loom-opt",
            "args": [
              "{srcdir}/loom_opt_f32_arith.loom",
              "--pipeline=default",
              "--require-resolved-config",
              "--to=bytecode",
              "--output={tmp}/default.loombc"
            ]
          },
          "stderr": {
            "empty": true
          }
        },
        {
          "run": {
            "tool": "loom-opt",
            "args": [
              "{tmp}/default.loombc",
              "--output={tmp}/default.loom"
            ]
          },
          "stderr": {
            "empty": true
          },
          "files": [
            {
              "path": "{tmp}/default.loom",
              "equals": "{tmp}/prepared.loom"
            }
          ]
        }
      ]
    }
  ]
}
