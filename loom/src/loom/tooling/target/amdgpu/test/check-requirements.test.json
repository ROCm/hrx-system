{
  "version": 1,
  "cases": [
    {
      "name": "runs scalar cases and skips unavailable device requirements",
      "run": {
        "tool": "iree-test-loom",
        "args": [
          "{srcdir}/check_requirements.loom"
        ]
      },
      "stdout": {
        "contains": [
          "\"case_count\":3",
          "\"sample_count\":1",
          "\"skipped_case_count\":2",
          "\"case\":\"scalar_case\"",
          "\"failure_count\":0",
          "\"code\":\"provider_unavailable\"",
          "\"provider\":\"hal.amdgpu.target\"",
          "\"provider_code\":\"hal_driver_mismatch\""
        ]
      }
    },
    {
      "name": "skips benchmarks whose device requirement is unavailable",
      "run": {
        "tool": "iree-benchmark-loom",
        "args": [
          "{srcdir}/check_requirements.loom",
          "--iterations=1",
          "--warmup-iterations=0",
          "--output-format=jsonl"
        ]
      },
      "stdout": {
        "contains": [
          "\"state\":\"skipped\"",
          "\"failed_benchmark_count\":0"
        ]
      }
    },
    {
      "name": "missing target",
      "run": {
        "tool": "iree-test-loom",
        "args": [
          "{srcdir}/check_requirements_invalid.loom",
          "--case=@missing_target"
        ]
      },
      "exit": 1,
      "stderr": {
        "contains": [
          "requirement attr 'target' is required"
        ]
      }
    },
    {
      "name": "wrong target type",
      "run": {
        "tool": "iree-test-loom",
        "args": [
          "{srcdir}/check_requirements_invalid.loom",
          "--case=@wrong_target_type"
        ]
      },
      "exit": 1,
      "stderr": {
        "contains": [
          "requirement attr 'target' must be string"
        ]
      }
    },
    {
      "name": "unknown target",
      "run": {
        "tool": "iree-test-loom",
        "args": [
          "{srcdir}/check_requirements_invalid.loom",
          "--case=@unknown_target"
        ]
      },
      "exit": 1,
      "stderr": {
        "contains": [
          "AMDGPU target 'gfx-unknown' is not supported"
        ]
      }
    },
    {
      "name": "invalid feature",
      "run": {
        "tool": "iree-test-loom",
        "args": [
          "{srcdir}/check_requirements_invalid.loom",
          "--case=@invalid_feature"
        ]
      },
      "exit": 1,
      "stderr": {
        "contains": [
          "xnack?"
        ]
      }
    }
  ]
}
