{
  "version": 1,
  "cases": [
    {
      "name": "prints selected Low text input as target assembly",
      "run": {
        "tool": "loom-link",
        "args": ["--root=sum", "{srcdir}/loom_link_low.loom"]
      },
      "stdout": {
        "contains": [
          "@sum(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {",
          "%sum = v_add_f32 %lhs, %rhs",
          "return %sum"
        ],
        "not_contains": ["@unselected", "low.op<", "low.return"]
      },
      "stderr": {"empty": true}
    },
    {
      "name": "writes merged Low assembly that can be parsed again",
      "steps": [
        {
          "name": "merge",
          "run": {
            "tool": "loom-link",
            "args": [
              "--mode=merge",
              "--output={tmp}/merged.loom",
              "{srcdir}/loom_link_low.loom"
            ]
          },
          "files": [
            {
              "path": "{tmp}/merged.loom",
              "contains": [
                "%sum = v_add_f32 %lhs, %rhs",
                "@unselected(%value: reg<amdgpu.vgpr : f32>) -> (reg<amdgpu.vgpr : f32>) asm {"
              ],
              "not_contains": ["low.op<", "low.return"]
            }
          ],
          "stderr": {"empty": true}
        },
        {
          "name": "check-assembly",
          "run": {
            "tool": "loom-format",
            "args": ["--check", "{tmp}/merged.loom"]
          },
          "stderr": {"empty": true}
        }
      ]
    },
    {
      "name": "prints selected Low bytecode input as target assembly",
      "steps": [
        {
          "name": "encode",
          "run": {
            "tool": "loom-format",
            "args": [
              "--to=bc",
              "--output={tmp}/input.loombc",
              "{srcdir}/loom_link_low.loom"
            ]
          }
        },
        {
          "name": "link",
          "run": {
            "tool": "loom-link",
            "args": ["--root=sum", "{tmp}/input.loombc"]
          },
          "stdout": {
            "contains": [
              "@sum(%lhs: reg<amdgpu.vgpr>, %rhs: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {",
              "%sum = v_add_f32 %lhs, %rhs",
              "return %sum"
            ],
            "not_contains": ["@unselected", "low.op<", "low.return"]
          },
          "stderr": {"empty": true}
        }
      ]
    },
    {
      "name": "preserves scoped Low types through selected bytecode linking",
      "steps": [
        {
          "name": "encode",
          "run": {
            "tool": "loom-format",
            "args": [
              "--to=bc",
              "--output={tmp}/bindings.loombc",
              "{srcdir}/loom_link_type_bindings.loom"
            ]
          }
        },
        {
          "name": "register-value-type",
          "run": {
            "tool": "loom-link",
            "args": ["--root=register_type_binding", "{tmp}/bindings.loombc"]
          },
          "stdout": {
            "contains": [
              "@register_type_binding(%width: reg<amdgpu.sgpr : index>, %value: reg<amdgpu.vgpr : vector<[%width]xf32>>) asm {",
              "return"
            ],
            "not_contains": ["@resource_type_binding", "vector<?", "low.return"]
          },
          "stderr": {"empty": true}
        },
        {
          "name": "resource-type-attribute",
          "run": {
            "tool": "loom-link",
            "args": ["--root=resource_type_binding", "{tmp}/bindings.loombc"]
          },
          "stdout": {
            "contains": [
              "@resource_type_binding(%width: reg<amdgpu.sgpr : index>) asm {",
              "source_type = vector<[%width]xf32>"
            ],
            "not_contains": ["@register_type_binding", "vector<?", "low.return"]
          },
          "stderr": {"empty": true}
        },
        {
          "name": "project-register-signature",
          "run": {
            "tool": "loom-link",
            "args": [
              "--root=register_type_binding",
              "{tmp}/bindings.loombc",
              "{srcdir}/loom_link_type_binding_declaration.loom"
            ]
          },
          "stdout": {
            "contains": [
              "low.func.def public retain target<amdgpu.rdna3.core> @register_type_binding(%width: reg<amdgpu.sgpr : index>, %value: reg<amdgpu.vgpr : vector<[%width]xf32>>) asm {"
            ],
            "not_contains": [
              "@resource_type_binding",
              "$link",
              "low.func.decl",
              "vector<?",
              "low.return"
            ]
          },
          "stderr": {"empty": true}
        },
        {
          "name": "call-projected-register-signature",
          "run": {
            "tool": "loom-link",
            "args": [
              "--root=call_register_type_binding",
              "{tmp}/bindings.loombc",
              "{srcdir}/loom_link_type_binding_declaration.loom"
            ]
          },
          "stdout": {
            "contains": [
              "@register_type_binding(%width: reg<amdgpu.sgpr : index>, %value: reg<amdgpu.vgpr : vector<[%width]xf32>>) asm {",
              "@call_register_type_binding(%width: reg<amdgpu.sgpr : index>, %value: reg<amdgpu.vgpr : vector<[%width]xf32>>) asm {",
              "low.func.call @register_type_binding"
            ],
            "not_contains": [
              "@resource_type_binding",
              "$link",
              "low.func.decl",
              "vector<?",
              "low.return"
            ]
          },
          "stderr": {"empty": true}
        }
      ]
    }
  ]
}
