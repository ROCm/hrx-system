// Subgroup global-to-LDS transfers with cross-lane publication and slot reuse.
// Each lane consumes its mirrored lane's value. Distinct records make stale
// transfers visible, and the ordered integer sum has an exact analytic oracle.
// The serial loop waits before each read and before reusing its LDS slot; the
// two-group case waits for the older transfer with one younger group pending.

kernel.def @async_gather_reference() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%record_count: index, %input: buffer, %output: buffer) {
  %count = index.assume %record_count [range(%record_count, 0, 257)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %last_lane = index.constant 63 : index
  %lane = kernel.workitem.id<x> : index
  %neighbor = index.sub %last_lane, %lane : index
  %base = index.constant 0 : offset
  %storage_bytes = index.constant 256 : offset
  %initial = scalar.constant 0 : i32
  %global = buffer.assume.memory_space<global> %input : buffer
  %source_storage, %output_storage = buffer.assume.noalias %global, %output : buffer, buffer
  %source_base = buffer.view %source_storage[%base] : buffer -> view<257x64xi32>
  %output_view = buffer.view %output_storage[%base] : buffer -> view<64xi32>
  %scratch = buffer.alloca<workgroup> align(16) %storage_bytes : buffer
  %slot0 = buffer.view %scratch[%base] : buffer -> view<64x1x1xi32>
  %total = scf.for %record = [%c0 to %count step %c1](%sum = %initial : i32) -> (i32) {
    %current = view.load %source_base[%record, %lane] : view<257x64xi32> -> i32
    view.store %current, %slot0[%lane, %c0, %c0] : i32, view<64x1x1xi32>
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %value = view.load %slot0[%neighbor, %c0, %c0] : view<64x1x1xi32> -> i32
    %updated = scalar.addi %sum, %value : i32
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.yield %updated : i32
  }
  view.store %total, %output_view[%lane] : i32, view<64xi32>
  kernel.return
}

kernel.def @async_gather_serial() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%record_count: index, %input: buffer, %output: buffer) {
  %count = index.assume %record_count [range(%record_count, 0, 257)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %last_lane = index.constant 63 : index
  %lane = kernel.workitem.id<x> : index
  %neighbor = index.sub %last_lane, %lane : index
  %base = index.constant 0 : offset
  %storage_bytes = index.constant 256 : offset
  %initial = scalar.constant 0 : i32
  %global = buffer.assume.memory_space<global> %input : buffer
  %source_storage, %output_storage = buffer.assume.noalias %global, %output : buffer, buffer
  %source_base = buffer.view %source_storage[%base] : buffer -> view<257x64xi32>
  %output_view = buffer.view %output_storage[%base] : buffer -> view<64xi32>
  %scratch = buffer.alloca<workgroup> align(16) %storage_bytes : buffer
  %slot0 = buffer.view %scratch[%base] : buffer -> view<64x1x1xi32>
  %total = scf.for %record = [%c0 to %count step %c1](%sum = %initial : i32) -> (i32) {
    %source = view.subview %source_base[%record, %lane] : view<257x64xi32> -> view<1x1xi32>
    %copy = kernel.async.gather %source to %slot0 {cache_scope = device, cache_temporal = regular} : view<1x1xi32> to view<64x1x1xi32> -> kernel.async.token
    %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
    kernel.async.wait %group {newer_groups = 0} : kernel.async.group
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %value = view.load %slot0[%neighbor, %c0, %c0] : view<64x1x1xi32> -> i32
    %updated = scalar.addi %sum, %value : i32
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.yield %updated : i32
  }
  view.store %total, %output_view[%lane] : i32, view<64xi32>
  kernel.return
}

kernel.def @async_gather_two_groups() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %last_lane = index.constant 63 : index
  %lane = kernel.workitem.id<x> : index
  %neighbor = index.sub %last_lane, %lane : index
  %base = index.constant 0 : offset
  %slot_bytes = index.constant 256 : offset
  %storage_bytes = index.constant 512 : offset
  %global = buffer.assume.memory_space<global> %input : buffer
  %source_storage, %output_storage = buffer.assume.noalias %global, %output : buffer, buffer
  %source_base = buffer.view %source_storage[%base] : buffer -> view<257x64xi32>
  %output_view = buffer.view %output_storage[%base] : buffer -> view<64xi32>
  %scratch = buffer.alloca<workgroup> align(16) %storage_bytes : buffer
  %slot0 = buffer.view %scratch[%base] : buffer -> view<64x1x1xi32>
  %slot1 = buffer.view %scratch[%slot_bytes] : buffer -> view<64x1x1xi32>
  // Seed both destinations so a misaddressed transfer cannot inherit a valid
  // result from unspecified LDS contents.
  %unwritten0 = scalar.constant -1 : i32
  %unwritten1 = scalar.constant -2 : i32
  view.store %unwritten0, %slot0[%lane, %c0, %c0] : i32, view<64x1x1xi32>
  view.store %unwritten1, %slot1[%lane, %c0, %c0] : i32, view<64x1x1xi32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %source0 = view.subview %source_base[%c0, %lane] : view<257x64xi32> -> view<1x1xi32>
  %copy0 = kernel.async.gather %source0 to %slot0 {cache_scope = device, cache_temporal = regular} : view<1x1xi32> to view<64x1x1xi32> -> kernel.async.token
  %group0 = kernel.async.group %copy0 : kernel.async.token -> kernel.async.group
  %source1 = view.subview %source_base[%c1, %lane] : view<257x64xi32> -> view<1x1xi32>
  %copy1 = kernel.async.gather %source1 to %slot1 {cache_scope = device, cache_temporal = regular} : view<1x1xi32> to view<64x1x1xi32> -> kernel.async.token
  %group1 = kernel.async.group %copy1 : kernel.async.token -> kernel.async.group
  kernel.async.wait %group0 {newer_groups = 1} : kernel.async.group
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %old = view.load %slot0[%neighbor, %c0, %c0] : view<64x1x1xi32> -> i32
  kernel.async.wait %group1 {newer_groups = 0} : kernel.async.group
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %new = view.load %slot1[%neighbor, %c0, %c0] : view<64x1x1xi32> -> i32
  %total = scalar.addi %old, %new : i32
  view.store %total, %output_view[%lane] : i32, view<64xi32>
  kernel.return
}

check.case public @async_gather_finite_counts {
  check.requires<hal.amdgpu.descriptor_set> {descriptor_set = "amdgpu.cdna3.core"}
  %count = check.param.choice values([0, 1, 2, 3, 8, 127, 128, 257]) : index
  %input = check.generate.iota offset(1) step(1) : tensor<257x64xi32>
  %reference = check.generate.fill value(-1) : tensor<64xi32>
  %gathered = check.generate.fill value(-2) : tensor<64xi32>
  kernel.launch @async_gather_reference(%count, %input, %reference) : (index, tensor<257x64xi32>, tensor<64xi32>)
  kernel.launch @async_gather_serial(%count, %input, %gathered) : (index, tensor<257x64xi32>, tensor<64xi32>)
  check.expect.bitwise actual(%gathered) expected(%reference) : tensor<64xi32>
  check.return
}

// Input[record, lane] = 1 + 64*record + lane, so N records produce
// N*(64-lane) + 32*N*(N-1) after mirrored-lane consumption.
check.case public @async_gather_repeated_reuse {
  check.requires<hal.amdgpu.descriptor_set> {descriptor_set = "amdgpu.cdna3.core"}
  %count = check.literal value(257) : index
  %input = check.generate.iota offset(1) step(1) : tensor<257x64xi32>
  %output = check.generate.fill value(-1) : tensor<64xi32>
  %expected = check.generate.iota offset(2121792) step(-257) : tensor<64xi32>
  kernel.launch @async_gather_serial(%count, %input, %output) : (index, tensor<257x64xi32>, tensor<64xi32>)
  check.expect.bitwise actual(%output) expected(%expected) : tensor<64xi32>
  check.return
}

check.case public @async_gather_distinct_groups {
  check.requires<hal.amdgpu.descriptor_set> {descriptor_set = "amdgpu.cdna3.core"}
  %input = check.generate.iota offset(1) step(1) : tensor<257x64xi32>
  %output = check.generate.fill value(-1) : tensor<64xi32>
  %expected = check.generate.iota offset(192) step(-2) : tensor<64xi32>
  kernel.launch @async_gather_two_groups(%input, %output) : (tensor<257x64xi32>, tensor<64xi32>)
  check.expect.bitwise actual(%output) expected(%expected) : tensor<64xi32>
  check.return
}
