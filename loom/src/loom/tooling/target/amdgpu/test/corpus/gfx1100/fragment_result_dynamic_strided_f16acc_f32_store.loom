// Fragment result stores through a dynamic strided destination layout.
//
// The four tile origins force both row and column origin terms to participate
// in address formation. The destination column stride is a runtime launch
// argument so the fragment store must preserve the physical layout through
// target lowering. A padded stride makes an accidental dense store observable.
amdgpu.target<gfx1100> @fragment_result_dynamic_gfx1100_wave64 {subgroup_size = 64}

kernel.def target(@fragment_result_dynamic_gfx1100_wave64) @fragment_result_dynamic_strided_f16acc_f32_store() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%column_stride0: index, %out_buffer: buffer) {
  %base = index.constant 0 : offset
  %tile_origin = index.constant 0 : index
  %tile_extent = index.constant 16 : index
  %column_stride = index.assume %column_stride0 [range(%column_stride0, 64, 128), mul(%column_stride0, 64)] : index
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %layout = encoding.layout.strided [1, %column_stride] : encoding<layout>

  %out_global = buffer.assume.memory_space<global> %out_buffer : buffer
  %out_aligned = buffer.assume.alignment %out_global {minimum_alignment = 16} : buffer
  %out_view = buffer.view %out_aligned[%base] : buffer -> view<64x64xf32, %layout>

  %lhs_values = vector.constant 0.0 : vector<16xf16>
  %rhs_values = vector.constant 0.0 : vector<16xf16>
  %init_values0 = vector.constant 1.0 : vector<8xf16>
  %init_values1 = vector.constant 2.0 : vector<8xf16>
  %init_values2 = vector.constant 3.0 : vector<8xf16>
  %init_values3 = vector.constant 4.0 : vector<8xf16>

  %lhs = vector.fragment<lhs> %lhs_values shape [%m, %k] : vector<16xf16>
  %rhs = vector.fragment<rhs> %rhs_values shape [%k, %n] : vector<16xf16>
  %init0 = vector.fragment<init> %init_values0 shape [%m, %n] : vector<8xf16>
  %init1 = vector.fragment<init> %init_values1 shape [%m, %n] : vector<8xf16>
  %init2 = vector.fragment<init> %init_values2 shape [%m, %n] : vector<8xf16>
  %init3 = vector.fragment<init> %init_values3 shape [%m, %n] : vector<8xf16>

  %result0 = vector.mma %lhs, %rhs, %init0 : vector<16xf16>, vector<16xf16>, vector<8xf16>
  %result1 = vector.mma %lhs, %rhs, %init1 : vector<16xf16>, vector<16xf16>, vector<8xf16>
  %result2 = vector.mma %lhs, %rhs, %init2 : vector<16xf16>, vector<16xf16>, vector<8xf16>
  %result3 = vector.mma %lhs, %rhs, %init3 : vector<16xf16>, vector<16xf16>, vector<8xf16>

  vector.fragment.store<result> %result0, %out_view[%tile_origin, %tile_origin] shape [%m, %n] : vector<8xf16>, view<64x64xf32, %layout>
  vector.fragment.store<result> %result1, %out_view[%tile_origin, %tile_extent] shape [%m, %n] : vector<8xf16>, view<64x64xf32, %layout>
  vector.fragment.store<result> %result2, %out_view[%tile_extent, %tile_origin] shape [%m, %n] : vector<8xf16>, view<64x64xf32, %layout>
  vector.fragment.store<result> %result3, %out_view[%tile_extent, %tile_extent] shape [%m, %n] : vector<8xf16>, view<64x64xf32, %layout>
  kernel.return
}

kernel.def @fill_fragment_result_dynamic_strided_f16acc_f32_store_expected() {
  %unit = index.constant 1 : index
  %workgroups = index.constant 4 : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%workgroups, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%out_buffer: buffer) {
  %base = index.constant 0 : offset
  %wg = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %tile_value_bias = index.constant 1 : index
  %tile_grid_width = index.constant 2 : index
  %tile_extent = index.constant 16 : index
  %column_stride = index.constant 128 : index

  %tile_row = index.div %wg, %tile_grid_width : index
  %tile_column = index.rem %wg, %tile_grid_width : index
  %row_origin = index.mul %tile_row, %tile_extent : index
  %column_origin = index.mul %tile_column, %tile_extent : index
  %local_row = index.rem %lane, %tile_extent : index
  %local_column = index.div %lane, %tile_extent : index
  %row = index.add %row_origin, %local_row : index
  %column = index.add %column_origin, %local_column : index
  %element_index = index.madd %column, %column_stride, %row : index

  %tile_value_index = index.add %wg, %tile_value_bias : index
  %tile_value_i32 = index.cast %tile_value_index : index to i32
  %tile_value = scalar.uitofp %tile_value_i32 : i32 to f32

  %out_global = buffer.assume.memory_space<global> %out_buffer : buffer
  %out_view = buffer.view %out_global[%base] : buffer -> view<8192xf32>
  view.store %tile_value, %out_view[%element_index] : f32, view<8192xf32>
  kernel.return
}

check.case public @fragment_result_dynamic_strided_f16acc_f32_store_case {
  %column_stride = check.literal value(128) : index
  %actual = check.generate.fill value(0.0) : tensor<8192xf32>
  %expected = check.generate.fill value(0.0) : tensor<8192xf32>
  kernel.launch @fragment_result_dynamic_strided_f16acc_f32_store(%column_stride, %actual) : (index, tensor<8192xf32>)
  kernel.launch @fill_fragment_result_dynamic_strided_f16acc_f32_store_expected(%expected) : (tensor<8192xf32>)
  check.expect.close actual(%actual) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<8192xf32>
  check.return
}

check.benchmark<@fragment_result_dynamic_strided_f16acc_f32_store_case> @fragment_result_dynamic_strided_f16acc_f32_store_smoke
