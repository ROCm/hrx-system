// Target provider selection must expand the launch region and device body
// against the same exact device profile. Gfx1151 wave32 uses two items per
// workgroup, a target-independent wave64 implementation uses four, and the
// fallback uses eight. Every path must cover the same 128-item workload. The
// kernel remains targetless so the same source executes on every
// Loom-supported AMDGPU device.
amdgpu.target<gfx1151> @gfx1151

template.decl @test.items_per_workgroup() -> (index)

template.def<@test.items_per_workgroup> target(@gfx1151) requires [#target.subgroup.size<32>] priority(20) @gfx1151_wave32_items_per_workgroup() -> (index) {
  %c2 = index.constant 2 : index
  template.return %c2 : index
}

template.def<@test.items_per_workgroup> requires [#target.subgroup.size<64>] priority(10) @wave64_items_per_workgroup() -> (index) {
  %c4 = index.constant 4 : index
  template.return %c4 : index
}

template.def<@test.items_per_workgroup> priority(1) @default_items_per_workgroup() -> (index) {
  %c8 = index.constant 8 : index
  template.return %c8 : index
}

kernel.def @target_specialized_launch_config(%item_count: index) {
  %c1 = index.constant 1 : index
  %wave_size = target.subgroup.size : index
  %items_per_workgroup = template.apply<@test.items_per_workgroup>() : () -> (index)
  %workgroup_count = index.div %item_count, %items_per_workgroup : index
  kernel.launch.config workgroups(%workgroup_count, %c1, %c1) workgroup_size(%wave_size, %c1, %c1) : index
} launch(%output: buffer) {
  %c0 = index.constant 0 : index
  %base = index.constant 0 : offset
  %workgroup = kernel.workgroup.id<x> : index
  %is_first_workgroup = index.cmp eq, %workgroup, %c0 : index
  scf.if %is_first_workgroup {
    %workitem = kernel.workitem.id<x> : index
    %is_first_workitem = index.cmp eq, %workitem, %c0 : index
    scf.if %is_first_workitem {
      %items_per_workgroup = template.apply<@test.items_per_workgroup>() : () -> (index)
      %workgroup_count = kernel.workgroup.count<x> : index
      %covered_item_count = index.mul %items_per_workgroup, %workgroup_count : index
      %covered_item_count_i32 = index.cast %covered_item_count : index to i32
      %output_global = buffer.assume.memory_space<global> %output : buffer
      %output_view = buffer.view %output_global[%base] : buffer -> view<1xi32>
      view.store %covered_item_count_i32, %output_view[%c0] : i32, view<1xi32>
    }
  }
  kernel.return
}

check.case public @target_specialized_launch_config_case {
  %item_count = check.literal value(128) : index
  %actual = check.generate.fill value(0) : tensor<1xi32>
  %expected = check.generate.fill value(128) : tensor<1xi32>
  kernel.launch @target_specialized_launch_config[%item_count](%actual) : [index](tensor<1xi32>)
  check.expect.equal actual(%actual) expected(%expected) : tensor<1xi32>
  check.return
}
