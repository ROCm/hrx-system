// Compares direct F32-result-fragment publication to F16 memory with scalar
// conversion of the same logical F32 matrix. Distinct midpoint values exercise
// every fragment position, cross-lane pairing, packed lane order, and RNE.
amdgpu.target<gfx1100> @fragment_result_f32_to_f16_gfx1100

kernel.def target(@fragment_result_f32_to_f16_gfx1100) @publish_f32_result_to_f16() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%input_buffer: buffer, %direct_buffer: buffer, %transposed_direct_buffer: buffer, %reference_buffer: buffer, %transposed_reference_buffer: buffer) {
  %base = index.constant 0 : offset
  %fragment_origin = index.constant 0 : index
  %physical_values_per_lane = index.constant 8 : index
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index

  %lane0 = kernel.workitem.id<x> : index
  %lane = index.assume %lane0 [range(%lane0, 0, 31)] : index
  %physical_base = index.mul %lane, %physical_values_per_lane : index
  %input_global = buffer.assume.memory_space<global> %input_buffer : buffer
  %direct_global = buffer.assume.memory_space<global> %direct_buffer : buffer
  %transposed_direct_global = buffer.assume.memory_space<global> %transposed_direct_buffer : buffer
  %reference_global = buffer.assume.memory_space<global> %reference_buffer : buffer
  %transposed_reference_global = buffer.assume.memory_space<global> %transposed_reference_buffer : buffer
  %transposed_layout = encoding.layout.strided [1, 16] : encoding<layout>
  %input_view = buffer.view %input_global[%base] : buffer -> view<256xf32>
  %direct_view = buffer.view %direct_global[%base] : buffer -> view<16x16xf16>
  %transposed_direct_view = buffer.view %transposed_direct_global[%base] : buffer -> view<16x16xf16, %transposed_layout>
  %reference_view = buffer.view %reference_global[%base] : buffer -> view<16x16xf32>
  %transposed_reference_view = buffer.view %transposed_reference_global[%base] : buffer -> view<16x16xf32, %transposed_layout>

  %initial_values = vector.load %input_view[%physical_base] : view<256xf32> -> vector<8xf32>
  %inactive_operand_values = vector.constant 0.0 : vector<16xf16>
  %lhs = vector.fragment<lhs> %inactive_operand_values shape [%m, %k] : vector<16xf16>
  %rhs = vector.fragment<rhs> %inactive_operand_values shape [%k, %n] : vector<16xf16>
  %initial = vector.fragment<init> %initial_values shape [%m, %n] : vector<8xf32>
  %result = vector.mma %lhs, %rhs, %initial : vector<16xf16>, vector<16xf16>, vector<8xf32>
  vector.fragment.store<result> %result, %direct_view[%fragment_origin, %fragment_origin] shape [%m, %n] : vector<8xf32>, view<16x16xf16>
  vector.fragment.store<result> %result, %transposed_direct_view[%fragment_origin, %fragment_origin] shape [%m, %n] : vector<8xf32>, view<16x16xf16, %transposed_layout>
  vector.fragment.store<result> %result, %reference_view[%fragment_origin, %fragment_origin] shape [%m, %n] : vector<8xf32>, view<16x16xf32>
  vector.fragment.store<result> %result, %transposed_reference_view[%fragment_origin, %fragment_origin] shape [%m, %n] : vector<8xf32>, view<16x16xf32, %transposed_layout>
  kernel.return
}

kernel.def target(@fragment_result_f32_to_f16_gfx1100) @convert_f32_reference_to_f16() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 256 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%input_buffer: buffer, %output_buffer: buffer) {
  %base = index.constant 0 : offset
  %element0 = kernel.workitem.id<x> : index
  %element = index.assume %element0 [range(%element0, 0, 255)] : index
  %input_global = buffer.assume.memory_space<global> %input_buffer : buffer
  %output_global = buffer.assume.memory_space<global> %output_buffer : buffer
  %input_view = buffer.view %input_global[%base] : buffer -> view<256xf32>
  %output_view = buffer.view %output_global[%base] : buffer -> view<256xf16>
  %value = view.load %input_view[%element] : view<256xf32> -> f32
  %converted = scalar.fptrunc %value : f32 to f16
  view.store %converted, %output_view[%element] : f16, view<256xf16>
  kernel.return
}

check.case public @fragment_result_f32_to_f16_publication_case {
  // Every value is halfway between adjacent F16 values near one. The two-ULP
  // step keeps the rounded values distinct so movement errors remain visible.
  %input = check.generate.iota offset(1.00048828125) step(0.001953125) : tensor<256xf32>
  %direct = check.generate.fill value(0.0) : tensor<256xf16>
  %transposed_direct = check.generate.fill value(0.0) : tensor<256xf16>
  %reference_f32 = check.generate.fill value(0.0) : tensor<256xf32>
  %transposed_reference_f32 = check.generate.fill value(0.0) : tensor<256xf32>
  %reference_f16 = check.generate.fill value(0.0) : tensor<256xf16>
  %transposed_reference_f16 = check.generate.fill value(0.0) : tensor<256xf16>
  kernel.launch @publish_f32_result_to_f16(%input, %direct, %transposed_direct, %reference_f32, %transposed_reference_f32) : (tensor<256xf32>, tensor<256xf16>, tensor<256xf16>, tensor<256xf32>, tensor<256xf32>)
  kernel.launch @convert_f32_reference_to_f16(%reference_f32, %reference_f16) : (tensor<256xf32>, tensor<256xf16>)
  kernel.launch @convert_f32_reference_to_f16(%transposed_reference_f32, %transposed_reference_f16) : (tensor<256xf32>, tensor<256xf16>)
  check.expect.bitwise actual(%direct) expected(%reference_f16) : tensor<256xf16>
  check.expect.bitwise actual(%transposed_direct) expected(%transposed_reference_f16) : tensor<256xf16>
  check.return
}
