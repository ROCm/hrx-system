// Execute every portable GFX9.4 dense and sparse matrix numeric family.
//
// Dense floating-point and integer rows multiply constant one matrices. Sparse
// rows use two stored nonzero values in every group of four, so their expected
// results distinguish the compact sparse payload from a dense interpretation.
amdgpu.target<gfx9-4-generic> @gfx9_4_generic

kernel.def target(@gfx9_4_generic) @gfx9_4_mfma_families() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%f16_output: buffer, %bf16_output: buffer, %f32_output: buffer, %f64_output: buffer, %i8_output: buffer, %sparse_f16_output: buffer, %sparse_bf16_output: buffer, %sparse_i8_output: buffer) {
  %base = index.constant 0 : offset
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k4 = index.constant 4 : index
  %k16 = index.constant 16 : index
  %k32 = index.constant 32 : index
  %k64 = index.constant 64 : index
  %f16_output_view = buffer.view %f16_output[%base] : buffer -> view<16x16xf32>
  %bf16_output_view = buffer.view %bf16_output[%base] : buffer -> view<16x16xf32>
  %f32_output_view = buffer.view %f32_output[%base] : buffer -> view<16x16xf32>
  %f64_output_view = buffer.view %f64_output[%base] : buffer -> view<16x16xf64>
  %i8_output_view = buffer.view %i8_output[%base] : buffer -> view<16x16xi32>
  %sparse_f16_output_view = buffer.view %sparse_f16_output[%base] : buffer -> view<16x16xf32>
  %sparse_bf16_output_view = buffer.view %sparse_bf16_output[%base] : buffer -> view<16x16xf32>
  %sparse_i8_output_view = buffer.view %sparse_i8_output[%base] : buffer -> view<16x16xi32>

  %f16_operand_elements = vector.constant 1.0 : vector<4xf16>
  %f16_lhs = vector.fragment<lhs> %f16_operand_elements shape [%m, %k16] : vector<4xf16>
  %f16_rhs = vector.fragment<rhs> %f16_operand_elements shape [%k16, %n] : vector<4xf16>
  %f32_accumulator_elements = vector.constant 0.0 : vector<4xf32>
  %f32_init = vector.fragment<init> %f32_accumulator_elements shape [%m, %n] : vector<4xf32>
  %f16_result = vector.mma %f16_lhs, %f16_rhs, %f32_init : vector<4xf16>, vector<4xf16>, vector<4xf32>
  vector.fragment.store<result> %f16_result, %f16_output_view[0, 0] shape [%m, %n] : vector<4xf32>, view<16x16xf32>

  %bf16_operand_elements = vector.constant 1.0 : vector<4xbf16>
  %bf16_lhs = vector.fragment<lhs> %bf16_operand_elements shape [%m, %k16] : vector<4xbf16>
  %bf16_rhs = vector.fragment<rhs> %bf16_operand_elements shape [%k16, %n] : vector<4xbf16>
  %bf16_result = vector.mma %bf16_lhs, %bf16_rhs, %f32_init : vector<4xbf16>, vector<4xbf16>, vector<4xf32>
  vector.fragment.store<result> %bf16_result, %bf16_output_view[0, 0] shape [%m, %n] : vector<4xf32>, view<16x16xf32>

  %f32_operand_elements = vector.constant 1.0 : vector<1xf32>
  %f32_lhs = vector.fragment<lhs> %f32_operand_elements shape [%m, %k4] : vector<1xf32>
  %f32_rhs = vector.fragment<rhs> %f32_operand_elements shape [%k4, %n] : vector<1xf32>
  %f32_result = vector.mma %f32_lhs, %f32_rhs, %f32_init : vector<1xf32>, vector<1xf32>, vector<4xf32>
  vector.fragment.store<result> %f32_result, %f32_output_view[0, 0] shape [%m, %n] : vector<4xf32>, view<16x16xf32>

  %f64_operand_elements = vector.constant 1.0 : vector<1xf64>
  %f64_lhs = vector.fragment<lhs> %f64_operand_elements shape [%m, %k4] : vector<1xf64>
  %f64_rhs = vector.fragment<rhs> %f64_operand_elements shape [%k4, %n] : vector<1xf64>
  %f64_accumulator_elements = vector.constant 0.0 : vector<4xf64>
  %f64_init = vector.fragment<init> %f64_accumulator_elements shape [%m, %n] : vector<4xf64>
  %f64_result = vector.mma %f64_lhs, %f64_rhs, %f64_init : vector<1xf64>, vector<1xf64>, vector<4xf64>
  vector.fragment.store<result> %f64_result, %f64_output_view[0, 0] shape [%m, %n] : vector<4xf64>, view<16x16xf64>

  %i8_schema = encoding.define #encoding.operand<element_format=i8, payload_elements=8, payload_registers=2> : encoding<schema>
  %i8_operand_words = vector.constant 16843009 : vector<2xi32>
  %i8_lhs = vector.fragment<lhs> %i8_operand_words shape [%m, %k32] using {schema = %i8_schema : encoding<schema>} : vector<2xi32>
  %i8_rhs = vector.fragment<rhs> %i8_operand_words shape [%k32, %n] using {schema = %i8_schema : encoding<schema>} : vector<2xi32>
  %i32_accumulator_elements = vector.constant 0 : vector<4xi32>
  %i32_init = vector.fragment<init> %i32_accumulator_elements shape [%m, %n] : vector<4xi32>
  %i8_result = vector.mma %i8_lhs, %i8_rhs, %i32_init : vector<2xi32>, vector<2xi32>, vector<4xi32>
  vector.fragment.store<result> %i8_result, %i8_output_view[0, 0] shape [%m, %n] : vector<4xi32>, view<16x16xi32>

  %metadata_value = scalar.constant 1145324612 : i32
  %metadata = vector.splat %metadata_value : vector<1xi32>

  %sparse_f16_lhs_schema = encoding.define #encoding.operand<element_format=f16, payload_elements=4, payload_registers=2, sparsity=n_m_structured, sparsity_group_elements=4, sparsity_group_nonzero_elements=2> : encoding<schema>
  %sparse_f16_rhs_schema = encoding.define #encoding.operand<element_format=f16, payload_elements=8, payload_registers=4> : encoding<schema>
  %sparse_f16_lhs_words = vector.constant 1006648320 : vector<2xi32>
  %sparse_f16_rhs_words = vector.constant 1006648320 : vector<4xi32>
  %sparse_f16_lhs = vector.fragment<lhs> %sparse_f16_lhs_words shape [%m, %k32] using {schema = %sparse_f16_lhs_schema : encoding<schema>, sparsity = %metadata : vector<1xi32>} : vector<2xi32>
  %sparse_f16_rhs = vector.fragment<rhs> %sparse_f16_rhs_words shape [%k32, %n] using {schema = %sparse_f16_rhs_schema : encoding<schema>} : vector<4xi32>
  %sparse_f16_result = vector.mma %sparse_f16_lhs, %sparse_f16_rhs, %f32_init : vector<2xi32>, vector<4xi32>, vector<4xf32>
  vector.fragment.store<result> %sparse_f16_result, %sparse_f16_output_view[0, 0] shape [%m, %n] : vector<4xf32>, view<16x16xf32>

  %sparse_bf16_lhs_schema = encoding.define #encoding.operand<element_format=bf16, payload_elements=4, payload_registers=2, sparsity=n_m_structured, sparsity_group_elements=4, sparsity_group_nonzero_elements=2> : encoding<schema>
  %sparse_bf16_rhs_schema = encoding.define #encoding.operand<element_format=bf16, payload_elements=8, payload_registers=4> : encoding<schema>
  %sparse_bf16_lhs_words = vector.constant 1065369472 : vector<2xi32>
  %sparse_bf16_rhs_words = vector.constant 1065369472 : vector<4xi32>
  %sparse_bf16_lhs = vector.fragment<lhs> %sparse_bf16_lhs_words shape [%m, %k32] using {schema = %sparse_bf16_lhs_schema : encoding<schema>, sparsity = %metadata : vector<1xi32>} : vector<2xi32>
  %sparse_bf16_rhs = vector.fragment<rhs> %sparse_bf16_rhs_words shape [%k32, %n] using {schema = %sparse_bf16_rhs_schema : encoding<schema>} : vector<4xi32>
  %sparse_bf16_result = vector.mma %sparse_bf16_lhs, %sparse_bf16_rhs, %f32_init : vector<2xi32>, vector<4xi32>, vector<4xf32>
  vector.fragment.store<result> %sparse_bf16_result, %sparse_bf16_output_view[0, 0] shape [%m, %n] : vector<4xf32>, view<16x16xf32>

  %sparse_i8_lhs_schema = encoding.define #encoding.operand<element_format=i8, payload_elements=8, payload_registers=2, sparsity=n_m_structured, sparsity_group_elements=4, sparsity_group_nonzero_elements=2> : encoding<schema>
  %sparse_i8_rhs_schema = encoding.define #encoding.operand<element_format=i8, payload_elements=16, payload_registers=4> : encoding<schema>
  %sparse_i8_lhs_words = vector.constant 16843009 : vector<2xi32>
  %sparse_i8_rhs_words = vector.constant 16843009 : vector<4xi32>
  %sparse_i8_lhs = vector.fragment<lhs> %sparse_i8_lhs_words shape [%m, %k64] using {schema = %sparse_i8_lhs_schema : encoding<schema>, sparsity = %metadata : vector<1xi32>} : vector<2xi32>
  %sparse_i8_rhs = vector.fragment<rhs> %sparse_i8_rhs_words shape [%k64, %n] using {schema = %sparse_i8_rhs_schema : encoding<schema>} : vector<4xi32>
  %sparse_i8_result = vector.mma %sparse_i8_lhs, %sparse_i8_rhs, %i32_init : vector<2xi32>, vector<4xi32>, vector<4xi32>
  vector.fragment.store<result> %sparse_i8_result, %sparse_i8_output_view[0, 0] shape [%m, %n] : vector<4xi32>, view<16x16xi32>
  kernel.return
}

check.case public @gfx9_4_mfma_families_case {
  %f16_output = check.generate.fill value(0.0) : tensor<16x16xf32>
  %bf16_output = check.generate.fill value(0.0) : tensor<16x16xf32>
  %f32_output = check.generate.fill value(0.0) : tensor<16x16xf32>
  %f64_output = check.generate.fill value(0.0) : tensor<16x16xf64>
  %i8_output = check.generate.fill value(0) : tensor<16x16xi32>
  %sparse_f16_output = check.generate.fill value(0.0) : tensor<16x16xf32>
  %sparse_bf16_output = check.generate.fill value(0.0) : tensor<16x16xf32>
  %sparse_i8_output = check.generate.fill value(0) : tensor<16x16xi32>
  %f16_expected = check.generate.fill value(16.0) : tensor<16x16xf32>
  %bf16_expected = check.generate.fill value(16.0) : tensor<16x16xf32>
  %f32_expected = check.generate.fill value(4.0) : tensor<16x16xf32>
  %f64_expected = check.generate.fill value(4.0) : tensor<16x16xf64>
  %i8_expected = check.generate.fill value(32) : tensor<16x16xi32>
  %sparse_f16_expected = check.generate.fill value(16.0) : tensor<16x16xf32>
  %sparse_bf16_expected = check.generate.fill value(16.0) : tensor<16x16xf32>
  %sparse_i8_expected = check.generate.fill value(32) : tensor<16x16xi32>
  kernel.launch @gfx9_4_mfma_families(%f16_output, %bf16_output, %f32_output, %f64_output, %i8_output, %sparse_f16_output, %sparse_bf16_output, %sparse_i8_output) : (tensor<16x16xf32>, tensor<16x16xf32>, tensor<16x16xf32>, tensor<16x16xf64>, tensor<16x16xi32>, tensor<16x16xf32>, tensor<16x16xf32>, tensor<16x16xi32>)
  check.expect.equal actual(%f16_output) expected(%f16_expected) : tensor<16x16xf32>
  check.expect.equal actual(%bf16_output) expected(%bf16_expected) : tensor<16x16xf32>
  check.expect.equal actual(%f32_output) expected(%f32_expected) : tensor<16x16xf32>
  check.expect.equal actual(%f64_output) expected(%f64_expected) : tensor<16x16xf64>
  check.expect.equal actual(%i8_output) expected(%i8_expected) : tensor<16x16xi32>
  check.expect.equal actual(%sparse_f16_output) expected(%sparse_f16_expected) : tensor<16x16xf32>
  check.expect.equal actual(%sparse_bf16_output) expected(%sparse_bf16_expected) : tensor<16x16xf32>
  check.expect.equal actual(%sparse_i8_output) expected(%sparse_i8_expected) : tensor<16x16xi32>
  check.return
}

check.benchmark<@gfx9_4_mfma_families_case>
