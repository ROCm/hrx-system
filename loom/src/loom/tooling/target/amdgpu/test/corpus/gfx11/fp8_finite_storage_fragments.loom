check.case public @fp8_finite_storage_rhs_fragment_decode_bf16_case {
  %input = check.generate.fill value(1.0) : tensor<16x16xf8E4M3>
  %output = check.generate.fill value(0.0) : tensor<16xbf16>
  %expected = check.generate.fill value(1.0) : tensor<16xbf16>
  kernel.launch @fp8_finite_storage_rhs_fragment_decode_bf16(%input, %output) : (tensor<16x16xf8E4M3>, tensor<16xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<16xbf16>
  check.return
}

