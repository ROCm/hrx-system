load("//build_tools/bazel:executable.bzl", "iree_executable_test")
load("//build_tools/bazel:test_resources.bzl", "GPU_DEVICE_RESOURCE_GROUP")
load(
    "//loom/build_tools/amdgpu:descriptor_sets.bzl",
    "loom_amdgpu_descriptor_set_compatible_with",
    "loom_amdgpu_iree_hal_representation_compatible_with",
)
load(
    "//loom/build_tools/amdgpu:target_config.bzl",
    "LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITY_BY_KEY",
    "LOOM_AMDGPU_SUPPORTED_TARGETS",
)
load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")
load("//loom/build_tools/bazel:defs.bzl", "loom_module", "loom_test", "loom_test_module")
load("//loom/target/amdgpu:execution_profiles.bzl", "AMDGPU_ACCESS_PROFILE", "AMDGPU_HARDWARE_PROFILE")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

exports_files([
    "gfx11/loop_entry_wave32.loom",
    "gfx11/schedule_scopes.loom",
])

_EXECUTION_TAGS = [
    "iree-run-requirement=runtime.resource.amd_gpu",
    "requires-gpu-amd",
    "runtime-resource=amd-gpu",
]

_GENERIC_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/execute:amdgpu_hal",
])

_GFX11_GENERIC_REPRESENTATION = LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITY_BY_KEY["amdgpu.gfx11.generic.core"]

_GFX11_ARTIFACT_COMPATIBLE_WITH = loom_amdgpu_descriptor_set_compatible_with(
    _GFX11_GENERIC_REPRESENTATION,
)

_GFX11_COMPATIBLE_WITH = (
    _GENERIC_COMPATIBLE_WITH +
    loom_amdgpu_iree_hal_representation_compatible_with(
        _GFX11_GENERIC_REPRESENTATION,
    )
)

_CDNA3_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/execute:amdgpu_hal",
    "//loom/config/target/amdgpu:iree_hal_descriptor_set_cdna3_core",
])

_CDNA4_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/execute:amdgpu_hal",
    "//loom/config/target/amdgpu:iree_hal_descriptor_set_cdna4_core",
])

loom_test(
    name = "buffer_selection_test",
    srcs = ["//loom/src/loom/test/corpus/source_low:buffer_selection.loom"],
    compile_targets = [
        "//loom/target/amdgpu:gfx942",
        "//loom/target/amdgpu:gfx950",
        "//loom/target/amdgpu:gfx1151",
        "//loom/target/amdgpu:gfx1170",
        "//loom/target/amdgpu:gfx1200",
        "//loom/target/amdgpu:gfx1250",
    ],
    execution_profiles = [
        AMDGPU_HARDWARE_PROFILE,
        AMDGPU_ACCESS_PROFILE,
    ],
)

loom_test(
    name = "mx_decode_test",
    srcs = [
        "//loom/src/loom/test/corpus/encoding:mxfp4_decode_bf16.loom",
        "//loom/src/loom/test/corpus/encoding:mxfp8_decode.loom",
    ],
    compile_targets = ["//loom/target/amdgpu:" + target for target in LOOM_AMDGPU_SUPPORTED_TARGETS],
)

loom_module(
    name = "generic_test_module",
    srcs = [
        "//loom/src/loom/test/corpus/authoring:authoring_cases",
        "//loom/src/loom/test/corpus/authoring/hip:portable_cases",
        "//loom/src/loom/test/corpus/checked_benchmarks:checked_benchmark_cases",
        "//loom/src/loom/test/corpus/conformance:conformance_cases",
        "//loom/src/loom/test/corpus/encoding:numeric_conversion_cases",
    ] + glob(["generic/*.loom"]),
    output_format = "bc",
)

iree_executable_test(
    name = "generic_test",
    src = "//loom/src/loom/tools/iree-test-loom",
    args = [
        "$(rootpath :generic_test_module)",
        "--device=amdgpu",
    ],
    data = [":generic_test_module"],
    resource_group = GPU_DEVICE_RESOURCE_GROUP,
    tags = _EXECUTION_TAGS,
    target_compatible_with = _GENERIC_COMPATIBLE_WITH,
)

loom_module(
    name = "gfx11_test_module",
    srcs = [
        "//loom/binding/c/benchmark/kernels:attention/prefill_f16_wmma_amdgpu.loom",
        "//loom/binding/c/benchmark/kernels:synthetic/paired_matrix_helpers.loom",
        "//loom/binding/c/benchmark/kernels:synthetic/paired_scoped_matrix_helpers.loom",
        "//loom/src/loom/test/corpus/authoring/hip:gfx11_cases",
    ] + glob(["gfx11/*.loom"]),
    output_format = "bc",
    target_compatible_with = _GFX11_ARTIFACT_COMPATIBLE_WITH,
)

iree_executable_test(
    name = "gfx11_test",
    src = "//loom/src/loom/tools/iree-test-loom",
    args = [
        "$(rootpath :gfx11_test_module)",
        "--device=amdgpu",
        "--config=benchmark.pair_count=16",
    ],
    data = [":gfx11_test_module"],
    resource_group = GPU_DEVICE_RESOURCE_GROUP,
    tags = _EXECUTION_TAGS,
    target_compatible_with = _GFX11_COMPATIBLE_WITH,
)

loom_module(
    name = "gfx11_loop_entry_module",
    srcs = [
        "gfx11/loop_entry.loom",
        "gfx11/loop_entry_wave32.loom",
    ],
    output_format = "bc",
    target_compatible_with = _GFX11_ARTIFACT_COMPATIBLE_WITH,
)

iree_executable_test(
    name = "loop_count_access_test",
    src = "//loom/src/loom/tools/iree-test-loom",
    args = [
        "$(rootpath //loom/src/loom/test/corpus/conformance:loop_count.loom)",
        "--device=amdgpu",
        "--sanitizer=access",
    ],
    data = ["//loom/src/loom/test/corpus/conformance:loop_count.loom"],
    resource_group = GPU_DEVICE_RESOURCE_GROUP,
    tags = _EXECUTION_TAGS + ["notsan"],
    target_compatible_with = _GENERIC_COMPATIBLE_WITH,
)

iree_executable_test(
    name = "gfx11_loop_entry_access_test",
    src = "//loom/src/loom/tools/iree-test-loom",
    args = [
        "$(rootpath :gfx11_loop_entry_module)",
        "--device=amdgpu",
        "--sanitizer=access",
    ],
    data = [":gfx11_loop_entry_module"],
    resource_group = GPU_DEVICE_RESOURCE_GROUP,
    tags = _EXECUTION_TAGS + ["notsan"],
    target_compatible_with = _GFX11_COMPATIBLE_WITH,
)

loom_module(
    name = "gfx1100_test_module",
    srcs = glob(["gfx1100/*.loom"]),
    output_format = "bc",
)

iree_executable_test(
    name = "gfx1100_test",
    src = "//loom/src/loom/tools/iree-test-loom",
    args = [
        "$(rootpath :gfx1100_test_module)",
        "--device=amdgpu",
    ],
    data = [":gfx1100_test_module"],
    resource_group = GPU_DEVICE_RESOURCE_GROUP,
    tags = _EXECUTION_TAGS + ["manual"],
    target_compatible_with = _GENERIC_COMPATIBLE_WITH,
)

loom_module(
    name = "gfx9_4_test_module",
    srcs = glob(["gfx9_4/*.loom"]),
    output_format = "bc",
)

iree_executable_test(
    name = "gfx9_4_test",
    src = "//loom/src/loom/tools/iree-test-loom",
    args = [
        "$(rootpath :gfx9_4_test_module)",
        "--device=amdgpu",
    ],
    data = [":gfx9_4_test_module"],
    resource_group = GPU_DEVICE_RESOURCE_GROUP,
    tags = _EXECUTION_TAGS + ["manual"],
    target_compatible_with = _GENERIC_COMPATIBLE_WITH,
)

iree_executable_test(
    name = "gfx9_4_async_gather_test",
    src = "//loom/src/loom/tools/iree-test-loom",
    args = [
        "$(rootpath gfx9_4/gfx9_4_async_gather.loom)",
        "--device=amdgpu",
    ],
    data = ["gfx9_4/gfx9_4_async_gather.loom"],
    resource_group = GPU_DEVICE_RESOURCE_GROUP,
    tags = _EXECUTION_TAGS,
    target_compatible_with = _CDNA3_COMPATIBLE_WITH,
)

loom_test_module(
    name = "gfx950_v4_lds_shared_qk_module",
    srcs = ["gfx950/v4_lds_shared_qk.loom"],
)

loom_test(
    name = "gfx950_v4_lds_shared_qk_compile_test",
    compile_targets = ["//loom/target/amdgpu:gfx950"],
    module = ":gfx950_v4_lds_shared_qk_module",
)

loom_test(
    name = "gfx950_v4_lds_shared_qk_execution_test",
    execution_profiles = [
        AMDGPU_HARDWARE_PROFILE,
        AMDGPU_ACCESS_PROFILE,
    ],
    module = ":gfx950_v4_lds_shared_qk_module",
    target_compatible_with = _CDNA4_COMPATIBLE_WITH,
)

loom_module(
    name = "gfx1250_test_module",
    srcs = [
        "//loom/src/loom/test/corpus/authoring/hip:gfx1250_cases",
    ],
    output_format = "bc",
)

iree_executable_test(
    name = "gfx1250_test",
    src = "//loom/src/loom/tools/iree-test-loom",
    args = [
        "$(rootpath :gfx1250_test_module)",
        "--device=amdgpu",
    ],
    data = [":gfx1250_test_module"],
    resource_group = GPU_DEVICE_RESOURCE_GROUP,
    tags = _EXECUTION_TAGS + ["manual"],
    target_compatible_with = _GENERIC_COMPATIBLE_WITH,
)
