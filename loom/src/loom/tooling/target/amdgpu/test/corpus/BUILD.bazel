load(
    "//loom/build_tools/amdgpu:descriptor_sets.bzl",
    "loom_amdgpu_descriptor_set_compatible_with",
    "loom_amdgpu_iree_hal_representation_compatible_with",
)
load(
    "//loom/build_tools/amdgpu:target_config.bzl",
    "LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITY_BY_KEY",
)
load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")
load("//loom/build_tools/bazel:defs.bzl", "loom_test", "loom_test_module")
load(
    "//loom/target/amdgpu:execution_profiles.bzl",
    "AMDGPU_ACCESS_PROFILE",
    "AMDGPU_HARDWARE_PROFILE",
)

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

exports_files([
    "gfx11/loop_entry_wave32.loom",
    "gfx11/schedule_scopes.loom",
])

_GFX11_GENERIC_REPRESENTATION = LOOM_AMDGPU_DESCRIPTOR_SET_CAPABILITY_BY_KEY["amdgpu.gfx11.generic.core"]

_GFX11_ARTIFACT_COMPATIBLE_WITH = loom_amdgpu_descriptor_set_compatible_with(
    _GFX11_GENERIC_REPRESENTATION,
)

_GFX11_COMPATIBLE_WITH = loom_amdgpu_iree_hal_representation_compatible_with(
    _GFX11_GENERIC_REPRESENTATION,
)

_CDNA3_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/target/amdgpu:iree_hal_descriptor_set_cdna3_core",
])

loom_test(
    name = "buffer_selection_test",
    srcs = ["//loom/src/loom/test/corpus/source_low:buffer_selection.loom"],
    compile_targets = [
        "//loom/target/amdgpu:gfx942",
        "//loom/target/amdgpu:gfx950",
        "//loom/target/amdgpu:gfx1151",
        "//loom/target/amdgpu:gfx1170",
        "//loom/target/amdgpu:gfx1200",
        "//loom/target/amdgpu:gfx1250",
    ],
    execution_profiles = [
        AMDGPU_HARDWARE_PROFILE,
        AMDGPU_ACCESS_PROFILE,
    ],
)

_GENERIC_CORPORA = [
    (
        "generic_authoring",
        ["//loom/src/loom/test/corpus/authoring:authoring_cases"],
    ),
    (
        "generic_hip",
        ["//loom/src/loom/test/corpus/authoring/hip:portable_cases"],
    ),
    (
        "generic_paged_attention_benchmarks",
        ["//loom/src/loom/test/corpus/checked_benchmarks:paged_attention_cases"],
    ),
    (
        "generic_attention_math_benchmarks",
        ["//loom/src/loom/test/corpus/checked_benchmarks:attention_math_cases"],
    ),
    (
        "generic_routing_benchmarks",
        ["//loom/src/loom/test/corpus/checked_benchmarks:routing_cases"],
    ),
    (
        "generic_quantization_benchmarks",
        ["//loom/src/loom/test/corpus/checked_benchmarks:quantization_cases"],
    ),
    (
        "generic_conformance",
        ["//loom/src/loom/test/corpus/conformance:conformance_cases"],
    ),
    (
        "generic_numeric_conversion",
        ["//loom/src/loom/test/corpus/encoding:numeric_conversion_cases"],
    ),
    (
        "generic_target",
        glob(["generic/*.loom"]),
    ),
]

[
    loom_test_module(
        name = name + "_test_module",
        srcs = srcs,
    )
    for name, srcs in _GENERIC_CORPORA
]

[
    loom_test(
        name = name + "_test",
        execution_profiles = [AMDGPU_HARDWARE_PROFILE],
        module = ":" + name + "_test_module",
    )
    for name, _ in _GENERIC_CORPORA
]

test_suite(
    name = "generic_test",
    tests = [":" + name + "_test" for name, _ in _GENERIC_CORPORA],
)

loom_test_module(
    name = "gfx11_test_module",
    srcs = [
        "//loom/binding/c/benchmark/kernels:attention/prefill_f16_wmma_amdgpu.loom",
        "//loom/binding/c/benchmark/kernels:synthetic/paired_matrix_helpers.loom",
        "//loom/binding/c/benchmark/kernels:synthetic/paired_scoped_matrix_helpers.loom",
        "//loom/src/loom/test/corpus/authoring/hip:gfx11_cases",
    ] + glob(["gfx11/*.loom"]),
    target_compatible_with = _GFX11_ARTIFACT_COMPATIBLE_WITH,
)

loom_test(
    name = "gfx11_test",
    configs = {"benchmark.pair_count": "16"},
    execution_profiles = [AMDGPU_HARDWARE_PROFILE],
    module = ":gfx11_test_module",
    target_compatible_with = _GFX11_COMPATIBLE_WITH,
)

loom_test_module(
    name = "gfx11_loop_entry_module",
    srcs = [
        "gfx11/loop_entry.loom",
        "gfx11/loop_entry_wave32.loom",
    ],
    target_compatible_with = _GFX11_ARTIFACT_COMPATIBLE_WITH,
)

loom_test(
    name = "gfx11_loop_entry_access_test",
    execution_profiles = [AMDGPU_ACCESS_PROFILE],
    module = ":gfx11_loop_entry_module",
    target_compatible_with = _GFX11_COMPATIBLE_WITH,
)

loom_test_module(
    name = "gfx1100_test_module",
    srcs = glob(["gfx1100/*.loom"]),
)

loom_test(
    name = "gfx1100_test",
    execution_profiles = [AMDGPU_HARDWARE_PROFILE],
    module = ":gfx1100_test_module",
    tags = ["manual"],
)

loom_test_module(
    name = "gfx9_4_test_module",
    srcs = glob(["gfx9_4/*.loom"]),
)

loom_test(
    name = "gfx9_4_test",
    execution_profiles = [AMDGPU_HARDWARE_PROFILE],
    module = ":gfx9_4_test_module",
    tags = ["manual"],
)

loom_test(
    name = "gfx9_4_async_gather_test",
    srcs = ["gfx9_4/gfx9_4_async_gather.loom"],
    execution_profiles = [AMDGPU_HARDWARE_PROFILE],
    target_compatible_with = _CDNA3_COMPATIBLE_WITH,
)

loom_test_module(
    name = "gfx1250_test_module",
    srcs = [
        "//loom/src/loom/test/corpus/authoring/hip:gfx1250_cases",
    ],
)

loom_test(
    name = "gfx1250_test",
    execution_profiles = [AMDGPU_HARDWARE_PROFILE],
    module = ":gfx1250_test_module",
    tags = ["manual"],
)
