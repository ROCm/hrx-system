// Reusing a scalar-splat accumulator initializer across nested loops must
// preserve its decomposed component storage through the outer backedge.
amdgpu.target<gfx11-generic> @wave32 {subgroup_size = 32}

kernel.def target(@wave32) @nested_wmma_wave32() {
  %unit = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%output: buffer) {
  %start = index.constant 0 : index
  %unit = index.constant 1 : index
  %repetitions = index.constant 4 : index
  %tile = index.constant 16 : index
  %origin = index.constant 0 : offset
  %operand_elements = vector.constant 1.0 : vector<16xbf16>
  %accumulator_elements = vector.constant 0.0 : vector<8xf32>
  %lhs = vector.fragment<lhs> %operand_elements shape [%tile, %tile] : vector<16xbf16>
  %rhs = vector.fragment<rhs> %operand_elements shape [%tile, %tile] : vector<16xbf16>
  %initial = vector.fragment<init> %accumulator_elements shape [%tile, %tile] : vector<8xf32>
  %result = scf.for %block = [%start to %repetitions step %unit](%total = %initial : vector<8xf32>) -> (vector<8xf32>) {
    %a, %b, %c, %d = scf.for %step = [%start to %repetitions step %unit](%acc0 = %initial : vector<8xf32>, %acc1 = %initial : vector<8xf32>, %acc2 = %initial : vector<8xf32>, %acc3 = %initial : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
      %next0 = vector.mma %lhs, %rhs, %acc0 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
      %next1 = vector.mma %lhs, %rhs, %acc1 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
      %next2 = vector.mma %lhs, %rhs, %acc2 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
      %next3 = vector.mma %lhs, %rhs, %acc3 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
      scf.yield %next0, %next1, %next2, %next3 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
    }
    %ab = vector.addf %a, %b : vector<8xf32>
    %cd = vector.addf %c, %d : vector<8xf32>
    %partial = vector.addf %ab, %cd : vector<8xf32>
    %next = vector.addf %total, %partial : vector<8xf32>
    scf.yield %next : vector<8xf32>
  }
  %output_view = buffer.view %output[%origin] : buffer -> view<16x16xf32>
  vector.fragment.store<result> %result, %output_view[%start, %start] shape [%tile, %tile] : vector<8xf32>, view<16x16xf32>
  kernel.return
}

amdgpu.target<gfx11-generic> @wave64 {subgroup_size = 64}

kernel.def target(@wave64) @nested_wmma_wave64() {
  %unit = index.constant 1 : index
  %threads = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%output: buffer) {
  %start = index.constant 0 : index
  %unit = index.constant 1 : index
  %repetitions = index.constant 4 : index
  %tile = index.constant 16 : index
  %origin = index.constant 0 : offset
  %operand_elements = vector.constant 1.0 : vector<16xbf16>
  %accumulator_elements = vector.constant 0.0 : vector<4xf32>
  %lhs = vector.fragment<lhs> %operand_elements shape [%tile, %tile] : vector<16xbf16>
  %rhs = vector.fragment<rhs> %operand_elements shape [%tile, %tile] : vector<16xbf16>
  %initial = vector.fragment<init> %accumulator_elements shape [%tile, %tile] : vector<4xf32>
  %result = scf.for %block = [%start to %repetitions step %unit](%total = %initial : vector<4xf32>) -> (vector<4xf32>) {
    %a, %b, %c, %d = scf.for %step = [%start to %repetitions step %unit](%acc0 = %initial : vector<4xf32>, %acc1 = %initial : vector<4xf32>, %acc2 = %initial : vector<4xf32>, %acc3 = %initial : vector<4xf32>) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) {
      %next0 = vector.mma %lhs, %rhs, %acc0 : vector<16xbf16>, vector<16xbf16>, vector<4xf32>
      %next1 = vector.mma %lhs, %rhs, %acc1 : vector<16xbf16>, vector<16xbf16>, vector<4xf32>
      %next2 = vector.mma %lhs, %rhs, %acc2 : vector<16xbf16>, vector<16xbf16>, vector<4xf32>
      %next3 = vector.mma %lhs, %rhs, %acc3 : vector<16xbf16>, vector<16xbf16>, vector<4xf32>
      scf.yield %next0, %next1, %next2, %next3 : vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>
    }
    %ab = vector.addf %a, %b : vector<4xf32>
    %cd = vector.addf %c, %d : vector<4xf32>
    %partial = vector.addf %ab, %cd : vector<4xf32>
    %next = vector.addf %total, %partial : vector<4xf32>
    scf.yield %next : vector<4xf32>
  }
  %output_view = buffer.view %output[%origin] : buffer -> view<16x16xf32>
  vector.fragment.store<result> %result, %output_view[%start, %start] shape [%tile, %tile] : vector<4xf32>, view<16x16xf32>
  kernel.return
}

func.def @nested_wmma_oracle(%output: buffer) {
  %origin = index.constant 0 : offset
  %start = index.constant 0 : index
  %unit = index.constant 1 : index
  %elements = index.constant 256 : index
  %expected = scalar.constant 1024.0 : f32
  %view = buffer.view %output[%origin] : buffer -> view<256xf32>
  scf.for %element = [%start to %elements step %unit] {
    view.store %expected, %view[%element] : f32, view<256xf32>
  }
  func.return
}

check.scenario public @nested_accumulator_reset_wave32 {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %output = check.generate.fill value(0.0) : tensor<16x16xf32>
    check.compare<@nested_wmma_wave32, @nested_wmma_oracle>(%output) : (tensor<16x16xf32>) -> () {
      check.expect.equal actual(%output) expected(%output) : tensor<16x16xf32>
    }
  }
  check.return
}

check.scenario public @nested_accumulator_reset_wave64 {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %output = check.generate.fill value(0.0) : tensor<16x16xf32>
    check.compare<@nested_wmma_wave64, @nested_wmma_oracle>(%output) : (tensor<16x16xf32>) -> () {
      check.expect.equal actual(%output) expected(%output) : tensor<16x16xf32>
    }
  }
  check.return
}
