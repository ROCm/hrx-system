{
  "version": 1,
  "cases": [
    {
      "name": "native benchmark defaults to unchecked target-only timing",
      "run": {
        "tool": "benchmark",
        "args": ["{srcdir}/../../../testbench/testdata/benchmark_scenarios.loom", "--device=legacy-amdgpu", "--benchmark=@wrong_latency", "--iterations=1", "--warmup-iterations=0", "--batch-size=1", "--min-time-ms=0", "--max-batches=1"]
      },
      "stdout": {
        "contains": {"unordered": ["\"sample_count\":0,\"failed_sample_count\":0,\"state\":\"unchecked\"", "\"validity\":\"unchecked\"", "\"operation_timing_ns\""]},
        "not_contains": ["EXPECT/001", "\"correctness_materialization\""]
      }
    },
    {
      "name": "native command timing does not require a VM command oracle",
      "run": {
        "tool": "benchmark",
        "args": ["{srcdir}/../../../testbench/testdata/benchmark_scenarios.loom", "--device=legacy-amdgpu", "--benchmark=@command_without_vm_oracle_latency", "--iterations=1", "--warmup-iterations=0", "--batch-size=2", "--input-ring-count=2", "--min-time-ms=0", "--max-batches=1"]
      },
      "stdout": {
        "contains": {"unordered": ["\"state\":\"unchecked\"", "\"physical_dispatches_per_batch\":4", "\"operation_timing_ns\""]},
        "not_contains": ["\"correctness_materialization\""]
      }
    },
    {
      "name": "native command correctness checks the complete program",
      "run": {
        "tool": "benchmark",
        "args": ["{srcdir}/../../../testbench/testdata/benchmark_scenarios.loom", "--device=legacy-amdgpu", "--benchmark=@wrong_command_latency", "--scenario-correctness=true"]
      },
      "exit": {"nonzero": true},
      "stdout": {
        "contains": {"unordered": ["EXPECT/001", "\"sample_count\":1,\"failed_sample_count\":1,\"state\":\"failed\""]},
        "not_contains": ["\"operation_timing_ns\""]
      }
    },
    {
      "name": "native target differs from its independent VM oracle",
      "run": {
        "tool": "benchmark",
        "args": ["{srcdir}/../../../testbench/testdata/benchmark_scenarios.loom", "--scenario-correctness=true", "--device=legacy-amdgpu", "--benchmark=@wrong_latency", "--output-format=jsonl", "--iterations=1", "--warmup-iterations=0", "--batch-size=1", "--min-time-ms=0", "--max-batches=1"]
      },
      "exit": {"nonzero": true},
      "stdout": {
        "contains": {"unordered": ["EXPECT/001", "\"sample_count\":1,\"failed_sample_count\":1"]},
        "not_contains": ["\"passed\":true", "\"operation_timing_ns\""]
      }
    },
    {
      "name": "native target agrees with its independent VM oracle",
      "run": {
        "tool": "benchmark",
        "args": ["{srcdir}/../../../testbench/testdata/benchmark_scenarios.loom", "--scenario-correctness=true", "--device=legacy-amdgpu", "--benchmark=@right_latency", "--iterations=1", "--warmup-iterations=0", "--batch-size=1", "--min-time-ms=0", "--max-batches=1"]
      },
      "stdout": {
        "contains": {"unordered": ["\"state\":\"ok\"", "\"sample_count\":1,\"failed_sample_count\":0"]}
      }
    },
    {
      "name": "invoke-only trials reject unhandled device assertions before timing",
      "run": {
        "tool": "benchmark",
        "args": ["{srcdir}/../../../testbench/testdata/benchmark_device_events.loom", "--scenario-correctness=true", "--device=legacy-amdgpu", "--sanitizer=ubsan", "--sanitizer-reporting=report-only", "--iterations=1", "--warmup-iterations=0", "--batch-size=1", "--min-time-ms=0", "--max-batches=1"]
      },
      "exit": {"nonzero": true},
      "stdout": {
        "contains": {"unordered": ["\"action\":\"invoke\"", "\"unhandled_error_count\":1", "\"sample_count\":1,\"failed_sample_count\":1"]},
        "not_contains": ["\"state\":\"ok\""]
      }
    }
  ]
}
