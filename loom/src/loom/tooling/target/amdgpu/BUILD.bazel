load("//build_tools/testing:build_defs.bzl", "iree_execution_test_suite")
load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_library",
    "loom_cc_test",
    "loom_config_compatible_with",
)

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_AMDGPU_ARTIFACTS_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/target:amdgpu_artifacts",
])

_AMDGPU_HAL_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/execute:amdgpu_hal",
])

_AMDGPU_EXECUTION_TEST_TAGS = [
    "iree-run-requirement=runtime.resource.amd_gpu",
    "requires-gpu-amd",
    "runtime-resource=amd-gpu",
]

loom_cc_library(
    name = "artifact_provider",
    srcs = ["artifact_provider.c"],
    hdrs = ["artifact_provider.h"],
    deps = [
        "//loom/src/loom/ir",
        "//loom/src/loom/target:types",
        "//loom/src/loom/target/arch/amdgpu:facts",
        "//loom/src/loom/target/arch/amdgpu:profile",
        "//loom/src/loom/target/arch/amdgpu:runtime_requirements",
        "//loom/src/loom/target/arch/amdgpu:target_info",
        "//loom/src/loom/target/arch/amdgpu/target_id",
        "//loom/src/loom/target/emit/native/amdgpu:hal_kernel_library",
        "//loom/src/loom/target/emit/native/amdgpu:runtime_globals",
        "//loom/src/loom/target/reporting:report",
        "//loom/src/loom/tooling/execution:compile_options",
        "//loom/src/loom/tooling/execution/hal:artifact",
        "//loom/src/loom/tooling/execution/hal:runtime",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/executable/amdgpu:target_id",
    ],
)

loom_cc_library(
    name = "testbench_requirements",
    srcs = ["testbench_requirements.c"],
    hdrs = ["testbench_requirements.h"],
    deps = [
        "//loom/src/loom/target/arch/amdgpu:profile",
        "//loom/src/loom/target/arch/amdgpu:target_info_defs",
        "//loom/src/loom/tooling/execution/hal:testbench_actual",
        "//loom/src/loom/tooling/testbench:requirements",
        "//runtime/src/iree/base",
    ],
)

loom_cc_test(
    name = "artifact_provider_test",
    srcs = ["artifact_provider_test.cc"],
    deps = [
        ":artifact_provider",
        "//loom/src/loom/codegen/low:text_asm",
        "//loom/src/loom/format/text:parser",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:op_registry",
        "//loom/src/loom/sanitizer:options",
        "//loom/src/loom/target:entry_selection",
        "//loom/src/loom/target/arch/amdgpu:profile",
        "//loom/src/loom/target/arch/amdgpu:target_info",
        "//loom/src/loom/target/arch/amdgpu/descriptors:low_registry",
        "//loom/src/loom/target/arch/amdgpu/ops",
        "//loom/src/loom/target/arch/amdgpu/target_id",
        "//loom/src/loom/target/emit/native/amdgpu:runtime_globals",
        "//loom/src/loom/target/reporting:report",
        "//loom/src/loom/testing:module_ptr",
        "//loom/src/loom/tooling/execution/hal:runtime",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

iree_execution_test_suite(
    name = "loom_compile_execution_test",
    data = [
        "test/amdgpu_bad_return.loom",
        "test/amdgpu_unused_kernargs.loom",
        "test/complete_authoring_module.loom",
        "test/gfx1250_configured_fragment_bank.loom",
        "test/selected_root_amdgpu.loom",
        "test/target_family_template_provider_amdgpu.loom",
    ],
    manifests = ["test/loom-compile-amdgpu.test.json"],
    tags = ["hostonly"],
    target_compatible_with = _AMDGPU_ARTIFACTS_COMPATIBLE_WITH,
    tools = {
        "loom-compile": "//loom/src/loom/tools/loom-compile",
    },
)

iree_execution_test_suite(
    name = "loom_opt_execution_test",
    data = [
        "test/amdgpu_bad_return.loom",
        "test/loom_opt_f32_arith.loom",
    ],
    manifests = ["test/loom-opt-amdgpu.test.json"],
    tags = ["hostonly"],
    target_compatible_with = _AMDGPU_ARTIFACTS_COMPATIBLE_WITH,
    tools = {
        "loom-opt": "//loom/src/loom/tools/loom-opt",
    },
)

iree_execution_test_suite(
    name = "iree_test_loom_execution_test",
    data = [
        "test/amdgpu_compile_rejection.loom",
        "test/amdgpu_hal_actual.loom",
        "test/amdgpu_unused_kernargs.loom",
        "test/generated_tensor_cases.loom",
        "//loom/src/loom/tooling/execution/hal:testdata/dynamic_workgroup_hal_actual.loom",
        "//loom/src/loom/tooling/execution/hal:testdata/launch_schedule_hal_actual.loom",
    ],
    manifests = ["test/iree-test-loom_amdgpu.test.json"],
    tags = _AMDGPU_EXECUTION_TEST_TAGS,
    target_compatible_with = _AMDGPU_HAL_COMPATIBLE_WITH,
    tools = {
        "iree-test-loom": "//loom/src/loom/tools/iree-test-loom",
    },
)

# Host TSAN and AMDGPU ASAN require incompatible process address-space layouts.
iree_execution_test_suite(
    name = "iree_test_loom_asan_execution_test",
    data = [
        "test/amdgpu_unused_kernargs.loom",
        "//loom/src/loom/test/corpus/sanitizer:amdgpu_asan_actual.loom",
    ],
    manifests = ["test/iree-test-loom_amdgpu_asan.test.json"],
    tags = _AMDGPU_EXECUTION_TEST_TAGS + ["notsan"],
    target_compatible_with = _AMDGPU_HAL_COMPATIBLE_WITH,
    tools = {
        "iree-test-loom": "//loom/src/loom/tools/iree-test-loom",
    },
)

iree_execution_test_suite(
    name = "iree_test_loom_tsan_execution_test",
    data = [
        "//loom/src/loom/test/corpus/sanitizer:amdgpu_tsan_actual.loom",
    ],
    manifests = ["test/iree-test-loom_amdgpu_tsan.test.json"],
    tags = _AMDGPU_EXECUTION_TEST_TAGS,
    target_compatible_with = _AMDGPU_HAL_COMPATIBLE_WITH,
    tools = {
        "iree-test-loom": "//loom/src/loom/tools/iree-test-loom",
    },
)

iree_execution_test_suite(
    name = "iree_benchmark_loom_execution_test",
    data = [
        "test/amdgpu_hal_actual.loom",
        "//loom/src/loom/tooling/execution/hal:testdata/launch_schedule_hal_actual.loom",
    ],
    manifests = ["test/iree-benchmark-loom_amdgpu.test.json"],
    tags = _AMDGPU_EXECUTION_TEST_TAGS + ["manual"],
    target_compatible_with = _AMDGPU_HAL_COMPATIBLE_WITH,
    tools = {
        "iree-benchmark-loom": "//loom/src/loom/tools/iree-benchmark-loom",
    },
)
