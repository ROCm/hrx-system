load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_library",
    "loom_cc_test",
    "loom_config_compatible_with",
)

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_AMDGPU_HAL_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/execute:iree_hal_amdgpu",
])

loom_cc_library(
    name = "artifact_provider",
    srcs = ["artifact_provider.c"],
    hdrs = ["artifact_provider.h"],
    deps = [
        "//loom/src/loom/ir",
        "//loom/src/loom/target/arch/amdgpu:profile",
        "//loom/src/loom/target/arch/amdgpu:runtime_requirements",
        "//loom/src/loom/target/emit/native/amdgpu:hal_kernel_library",
        "//loom/src/loom/target/emit/native/amdgpu:runtime_globals",
        "//loom/src/loom/tooling/compile:artifact",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "device_provider",
    srcs = ["device_provider.c"],
    hdrs = ["device_provider.h"],
    target_compatible_with = _AMDGPU_HAL_COMPATIBLE_WITH,
    deps = [
        ":artifact_provider",
        "//loom/src/loom/target/arch/amdgpu:facts",
        "//loom/src/loom/target/arch/amdgpu:profile",
        "//loom/src/loom/target/arch/amdgpu:target_info",
        "//loom/src/loom/tooling/execution/hal:device_provider",
        "//loom/src/loom/tooling/execution/hal:runtime",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
    ],
)

loom_cc_library(
    name = "execution_provider",
    srcs = ["execution_provider.c"],
    hdrs = ["execution_provider.h"],
    target_compatible_with = _AMDGPU_HAL_COMPATIBLE_WITH,
    deps = [
        ":device_provider",
        "//loom/src/loom/target/arch/amdgpu:provider",
        "//loom/src/loom/tooling/execution:execution_provider",
        "//loom/src/loom/tooling/execution/hal:execution_backend",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "testbench_requirements",
    srcs = ["testbench_requirements.c"],
    hdrs = ["testbench_requirements.h"],
    deps = [
        "//loom/src/loom/target/arch/amdgpu:profile",
        "//loom/src/loom/target/arch/amdgpu:target_info_defs",
        "//loom/src/loom/tooling/execution/hal:testbench_actual",
        "//loom/src/loom/tooling/testbench:requirements",
        "//runtime/src/iree/base",
    ],
)

loom_cc_test(
    name = "artifact_provider_test",
    srcs = ["artifact_provider_test.cc"],
    deps = [
        ":artifact_provider",
        "//loom/src/loom/codegen/low:text_asm",
        "//loom/src/loom/format/text:parser",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:op_registry",
        "//loom/src/loom/sanitizer:options",
        "//loom/src/loom/target/arch/amdgpu:artifact_key",
        "//loom/src/loom/target/arch/amdgpu:profile",
        "//loom/src/loom/target/arch/amdgpu:target_info",
        "//loom/src/loom/target/arch/amdgpu/descriptors:low_registry",
        "//loom/src/loom/target/arch/amdgpu/ops",
        "//loom/src/loom/target/emit/native/amdgpu:runtime_globals",
        "//loom/src/loom/target/reporting:report",
        "//loom/src/loom/testing:byte_sequence",
        "//loom/src/loom/testing:module_ptr",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_test(
    name = "device_provider_test",
    srcs = ["device_provider_test.cc"],
    target_compatible_with = _AMDGPU_HAL_COMPATIBLE_WITH,
    deps = [
        ":device_provider",
        "//loom/src/loom/target/arch/amdgpu:artifact_key",
        "//loom/src/loom/target/arch/amdgpu:facts",
        "//loom/src/loom/target/arch/amdgpu:profile",
        "//loom/src/loom/target/arch/amdgpu:target_info",
        "//loom/src/loom/tooling/execution/hal:runtime",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
