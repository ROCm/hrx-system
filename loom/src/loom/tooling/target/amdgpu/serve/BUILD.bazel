loom_py_test(
    name = "catalog_test",
    size = "medium",
    srcs = ["//loom/src/loom/serve/server:catalog_test.py"],
    args = [
        "--server=$(rootpath :loom-serve-test-tool)",
        "--fixture=$(rootpath //loom/src/loom/serve/fixture/image:model.json)",
        "--fixture=$(rootpath //loom/src/loom/serve/fixture/embedding:model.json)",
        "--fixture=$(rootpath //loom/src/loom/serve/fixture/decision:model.json)",
        "--fixture=$(rootpath //loom/src/loom/serve/fixture/speech:model.json)",
        "--fixture=$(rootpath //loom/src/loom/serve/fixture/text:model.json)",
        "--device=amdgpu",
        "--pool_backing=fixed",
    ],
    data = DECISION_SOURCES + EMBEDDING_SOURCES + IMAGE_SOURCES + SPEECH_SOURCES + TEXT_SOURCES + [
        ":loom-serve-test-tool",
    ],
    main = "catalog_test.py",
    resource_group = GPU_DEVICE_RESOURCE_GROUP,
    tags = _ROCR_TEST_TAGS,
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/execute:amdgpu_hal",
        "//runtime/config/hal:driver_amdgpu",
    ]) + select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//loom/src/loom/serve/server:catalog_test_util",
        "//loom/src/loom/serve/testing:http",
        "//loom/src/loom/serve/testing:logs",
        "//loom/src/loom/serve/testing:workload",
    ],
)

