package(
    default_visibility = ["//loom/src/loom/serve:implementation"],
    features = ["layering_check"],
    licenses = ["notice"],
)

# ROCr's uninstrumented loader and event threads perform synchronization that
# host TSan cannot attribute. Keep this package enabled in every other
# configuration and retain host TSan coverage in the CPU serving package.
_ROCR_TEST_TAGS = [
    "iree-run-requirement=runtime.resource.amd_gpu",
    "notsan",
]

loom_cc_library(
    name = "test_compiler",
    testonly = True,
    srcs = ["test_compiler.c"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target:amdgpu_artifacts",
    ]),
    deps = [
        "//loom/binding/c/target/amdgpu",
        "//loom/binding/c/target/amdgpu:iree_hal",
        "//loom/src/loom/serve/testing:compiler",
    ],
    alwayslink = True,
)

loom_cc_binary(
    name = "loom-serve-test-tool",
    testonly = True,
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target:amdgpu_artifacts",
        "//runtime/config/hal:driver_amdgpu",
    ]),
