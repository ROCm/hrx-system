// Matching this declaration to a bytecode definition projects its signature
// before the selected function body is loaded.
low.func.decl public target<amdgpu.rdna3.core> @register_type_binding(%width: reg<amdgpu.sgpr : index>, %value: reg<amdgpu.vgpr : vector<[%width]xf32>>)

low.func.def target<amdgpu.rdna3.core> @call_register_type_binding(%width: reg<amdgpu.sgpr : index>, %value: reg<amdgpu.vgpr : vector<[%width]xf32>>) asm {
  low.func.call @register_type_binding(%width, %value) : (reg<amdgpu.sgpr : index>, reg<amdgpu.vgpr : vector<[%width]xf32>>)
  return
}
