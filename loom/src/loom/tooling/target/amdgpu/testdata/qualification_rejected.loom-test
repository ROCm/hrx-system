// CDNA3 only supports wave64. This qualification rejection is independent of
// source operation coverage and cannot be repaired by adding a lowering.
// ERROR@+1: AMDGPU/026 {target_name="wave32", subgroup_size="32", processor="gfx942"}
amdgpu.target<gfx942> @wave32 {subgroup_size = 32}

kernel.def target(@wave32) @unsupported_wave_size() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch() {
  kernel.return
}
