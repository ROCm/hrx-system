load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "iree_select",
    "loom_cc_library",
    "loom_cc_test",
)

_CONFIGURED_EXECUTION_COPTS = (
    iree_select({
        "//loom/config/execute:amdgpu_hal": [
            "-DLOOM_CONFIG_EXECUTION_HAVE_AMDGPU=1",
        ],
        "//conditions:default": [],
    }) +
    iree_select({
        "//loom/config/execute:spirv_vulkan_hal": [
            "-DLOOM_CONFIG_EXECUTION_HAVE_SPIRV=1",
        ],
        "//conditions:default": [],
    })
)

_CONFIGURED_EXECUTION_DEPS = (
    iree_select({
        "//loom/config/execute:amdgpu_hal": [
            "//loom/src/loom/tooling/target/amdgpu:device_provider",
            "//loom/src/loom/tooling/target/amdgpu:execution_provider",
        ],
        "//conditions:default": [],
    }) +
    iree_select({
        "//loom/config/execute:spirv_vulkan_hal": [
            "//loom/src/loom/tooling/target/spirv:device_provider",
            "//loom/src/loom/tooling/target/spirv:execution_provider",
        ],
        "//conditions:default": [],
    })
)

_CONFIGURED_TESTBENCH_DEPS = (
    iree_select({
        "//loom/config/execute:amdgpu_hal": [
            "//loom/src/loom/tooling/target/amdgpu:testbench_requirements",
        ],
        "//conditions:default": [],
    }) +
    iree_select({
        "//loom/config/execute:spirv_vulkan_hal": [
            "//loom/src/loom/tooling/target/spirv:testbench_requirements",
        ],
        "//conditions:default": [],
    })
)

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_cc_library(
    name = "benchmark",
    srcs = ["benchmark.c"],
    hdrs = ["benchmark.h"],
    deps = [
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "execution_provider",
    srcs = ["execution_provider.c"],
    hdrs = ["execution_provider.h"],
    deps = [
        ":execution_backend",
        ":session",
        "//loom/src/loom/target:provider",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "configured",
    srcs = ["configured.c"],
    hdrs = ["configured.h"],
    copts = _CONFIGURED_EXECUTION_COPTS,
    deps = [
        ":execution_provider",
        "//loom/src/loom/tooling/execution/hal:device_provider",
        "//runtime/src/iree/base",
    ] + _CONFIGURED_EXECUTION_DEPS,
)

loom_cc_test(
    name = "configured_test",
    srcs = ["configured_test.cc"],
    copts = _CONFIGURED_EXECUTION_COPTS,
    deps = [
        ":configured",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "configured_testbench",
    srcs = ["configured_testbench.c"],
    hdrs = ["configured_testbench.h"],
    copts = _CONFIGURED_EXECUTION_COPTS,
    deps = [
        "//loom/src/loom/tooling/execution/hal:testbench_requirement_provider",
        "//runtime/src/iree/base",
    ] + _CONFIGURED_TESTBENCH_DEPS,
)

loom_cc_test(
    name = "configured_testbench_test",
    srcs = ["configured_testbench_test.cc"],
    copts = _CONFIGURED_EXECUTION_COPTS,
    deps = [
        ":configured_testbench",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "execution_backend",
    srcs = ["execution_backend.c"],
    hdrs = ["execution_backend.h"],
    deps = [
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "measurement",
    srcs = ["measurement.c"],
    hdrs = ["measurement.h"],
    deps = [
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "one_shot",
    srcs = ["one_shot.c"],
    hdrs = ["one_shot.h"],
    deps = [
        ":session",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops/kernel",
        "//loom/src/loom/tooling/compile:options",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "session",
    srcs = ["session.c"],
    hdrs = ["session.h"],
    deps = [
        "//loom/src/loom/codegen/low:repr",
        "//loom/src/loom/codegen/low:text_asm",
        "//loom/src/loom/error:diagnostic",
        "//loom/src/loom/format/bytecode:format",
        "//loom/src/loom/format/bytecode:reader",
        "//loom/src/loom/format/text:parser",
        "//loom/src/loom/ir",
        "//loom/src/loom/target:low_descriptor_registry",
        "//loom/src/loom/verify",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
    ],
)

loom_cc_test(
    name = "benchmark_test",
    srcs = ["benchmark_test.cc"],
    deps = [
        ":benchmark",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_test(
    name = "one_shot_test",
    srcs = ["one_shot_test.cc"],
    deps = [
        ":one_shot",
        ":session",
        "//loom/src/loom/ops:op_registry",
        "//loom/src/loom/target:low_descriptor_registry_core_test",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_test(
    name = "measurement_test",
    srcs = ["measurement_test.cc"],
    deps = [
        ":measurement",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
