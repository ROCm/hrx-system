kernel.def @launch_schedule_increment_i32() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %input_view = buffer.view %input_aligned[%base] : buffer -> view<1xi32>
  %value = view.load %input_view[0] : view<1xi32> -> i32
  %increment = scalar.constant 1 : i32
  %incremented = scalar.addi %value, %increment : i32
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<1xi32>
  view.store %incremented, %output_view[0] : i32, view<1xi32>
  kernel.return
}

kernel.def @launch_schedule_double_i32() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %input_view = buffer.view %input_aligned[%base] : buffer -> view<1xi32>
  %value = view.load %input_view[0] : view<1xi32> -> i32
  %doubled = scalar.addi %value, %value : i32
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<1xi32>
  view.store %doubled, %output_view[0] : i32, view<1xi32>
  kernel.return
}

check.case @launch_schedule_serial_case {
  %input = check.generate.fill value(7) : tensor<1xi32>
  %intermediate = check.generate.fill value(-4) : tensor<1xi32>
  // If the second serial edge is missing, the terminal value remains -18.
  %output = check.generate.fill value(-19) : tensor<1xi32>
  %terminal = check.generate.fill value(-99) : tensor<1xi32>
  kernel.launch.serial {
    kernel.launch @launch_schedule_increment_i32(%input, %intermediate) : (tensor<1xi32>, tensor<1xi32>)
    kernel.launch @launch_schedule_double_i32(%intermediate, %output) : (tensor<1xi32>, tensor<1xi32>)
    kernel.launch @launch_schedule_increment_i32(%output, %terminal) : (tensor<1xi32>, tensor<1xi32>)
  }
  %expected = check.generate.fill value(17) : tensor<1xi32>
  check.expect.equal actual(%terminal) expected(%expected) : tensor<1xi32>
  check.return
}

check.benchmark<@launch_schedule_serial_case>

check.case @launch_schedule_concurrent_case {
  %input_a = check.generate.fill value(7) : tensor<1xi32>
  %input_b = check.generate.fill value(9) : tensor<1xi32>
  %output_a = check.generate.fill value(-1) : tensor<1xi32>
  %output_b = check.generate.fill value(-1) : tensor<1xi32>
  kernel.launch.concurrent {
    kernel.launch @launch_schedule_increment_i32(%input_a, %output_a) : (tensor<1xi32>, tensor<1xi32>)
    kernel.launch @launch_schedule_double_i32(%input_b, %output_b) : (tensor<1xi32>, tensor<1xi32>)
  }
  %expected_a = check.generate.fill value(8) : tensor<1xi32>
  %expected_b = check.generate.fill value(18) : tensor<1xi32>
  check.expect.equal actual(%output_a) expected(%expected_a) : tensor<1xi32>
  check.expect.equal actual(%output_b) expected(%expected_b) : tensor<1xi32>
  check.return
}

check.benchmark<@launch_schedule_concurrent_case>
