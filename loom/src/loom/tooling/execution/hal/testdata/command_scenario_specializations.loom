target.decl @execution

kernel.def @write_specialization_marker() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%output: buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %marker = scalar.constant 1 : i32
  %view = buffer.view %output[%origin] : buffer -> view<1xi32>
  view.store %marker, %view[%c0] : i32, view<1xi32>
  kernel.return
}

// Every scalar specialization must reach command lowering with its exact
// value. Float checks compare raw negative-zero encodings so numeric conversion
// through a wider host type cannot silently erase representation identity.
command.def target(@execution) @all_scalar_specializations(%index_value: index, %offset_value: offset, %boolean_value: i1, %byte_value: i8, %halfword_value: i16, %word_value: i32, %doubleword_value: i64, %e4m3_value: f8E4M3, %e5m2_value: f8E5M2, %half_value: f16, %brain_value: bf16, %single_value: f32, %double_value: f64) launch(%output: buffer) where [range(%index_value, 17, 17), finite(%single_value)] {
  %expected_index = index.constant 17 : index
  %expected_offset = index.constant 23 : offset
  %expected_boolean = scalar.constant true : i1
  %expected_byte = scalar.constant -7 : i8
  %expected_halfword = scalar.constant -300 : i16
  %expected_word = scalar.constant -70000 : i32
  %expected_doubleword = scalar.constant -5000000000 : i64
  %expected_float8_bits = scalar.constant -128 : i8
  %expected_float16_bits = scalar.constant -32768 : i16
  %expected_float32_bits = scalar.constant -2147483648 : i32
  %expected_float64_bits = scalar.constant -9223372036854775808 : i64
  %e4m3_bits = scalar.bitcast %e4m3_value : f8E4M3 to i8
  %e5m2_bits = scalar.bitcast %e5m2_value : f8E5M2 to i8
  %half_bits = scalar.bitcast %half_value : f16 to i16
  %brain_bits = scalar.bitcast %brain_value : bf16 to i16
  %single_bits = scalar.bitcast %single_value : f32 to i32
  %double_bits = scalar.bitcast %double_value : f64 to i64
  %index_matches = index.cmp eq, %index_value, %expected_index : index
  %offset_matches = index.cmp eq, %offset_value, %expected_offset : offset
  %boolean_matches = scalar.cmpi eq, %boolean_value, %expected_boolean : i1
  %byte_matches = scalar.cmpi eq, %byte_value, %expected_byte : i8
  %halfword_matches = scalar.cmpi eq, %halfword_value, %expected_halfword : i16
  %word_matches = scalar.cmpi eq, %word_value, %expected_word : i32
  %doubleword_matches = scalar.cmpi eq, %doubleword_value, %expected_doubleword : i64
  %e4m3_matches = scalar.cmpi eq, %e4m3_bits, %expected_float8_bits : i8
  %e5m2_matches = scalar.cmpi eq, %e5m2_bits, %expected_float8_bits : i8
  %half_matches = scalar.cmpi eq, %half_bits, %expected_float16_bits : i16
  %brain_matches = scalar.cmpi eq, %brain_bits, %expected_float16_bits : i16
  %single_matches = scalar.cmpi eq, %single_bits, %expected_float32_bits : i32
  %double_matches = scalar.cmpi eq, %double_bits, %expected_float64_bits : i64
  %index_offset_match = scalar.andi %index_matches, %offset_matches : i1
  %boolean_byte_match = scalar.andi %boolean_matches, %byte_matches : i1
  %narrow_integer_match = scalar.andi %boolean_byte_match, %halfword_matches : i1
  %wide_integer_match = scalar.andi %word_matches, %doubleword_matches : i1
  %integer_match = scalar.andi %narrow_integer_match, %wide_integer_match : i1
  %float8_match = scalar.andi %e4m3_matches, %e5m2_matches : i1
  %float16_match = scalar.andi %half_matches, %brain_matches : i1
  %narrow_float_match = scalar.andi %float8_match, %float16_match : i1
  %wide_float_match = scalar.andi %single_matches, %double_matches : i1
  %float_match = scalar.andi %narrow_float_match, %wide_float_match : i1
  %index_integer_match = scalar.andi %index_offset_match, %integer_match : i1
  %all_match = scalar.andi %index_integer_match, %float_match : i1
  scf.if %all_match {
    kernel.launch @write_specialization_marker(%output) : (buffer)
  }
  command.return
}

func.def @write_expected_specialization_marker(%output: buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %marker = scalar.constant 1 : i32
  %view = buffer.view %output[%origin] : buffer -> view<1xi32>
  view.store %marker, %view[%c0] : i32, view<1xi32>
  func.return
}

check.scenario public @command_scalar_specializations {
  %index_value = check.literal value(17) : index
  %offset_value = check.literal value(23) : offset
  %boolean_value = check.literal value(true) : i1
  %byte_value = check.literal value(-7) : i8
  %halfword_value = check.literal value(-300) : i16
  %word_value = check.literal value(-70000) : i32
  %doubleword_value = check.literal value(-5000000000) : i64
  %e4m3_value = check.literal value(-0.0) : f8E4M3
  %e5m2_value = check.literal value(-0.0) : f8E5M2
  %half_value = check.literal value(-0.0) : f16
  %brain_value = check.literal value(-0.0) : bf16
  %single_value = check.literal value(-0.0) : f32
  %double_value = check.literal value(-0.0) : f64
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %output = check.generate.fill value(0) : tensor<1xi32>
    check.compare<@all_scalar_specializations, @write_expected_specialization_marker>[%index_value, %offset_value, %boolean_value, %byte_value, %halfword_value, %word_value, %doubleword_value, %e4m3_value, %e5m2_value, %half_value, %brain_value, %single_value, %double_value](%output) : [index, offset, i1, i8, i16, i32, i64, f8E4M3, f8E5M2, f16, bf16, f32, f64](tensor<1xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<1xi32>
    }
  }
  check.return
}
