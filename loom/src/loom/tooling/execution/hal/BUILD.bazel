load("//build_tools/bazel:executable.bzl", "iree_executable_test")
load("//build_tools/bazel:test_resources.bzl", "GPU_DEVICE_RESOURCE_GROUP")
load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_library",
    "loom_cc_test",
    "loom_config_compatible_with",
)
load("//loom/build_tools/bazel:defs.bzl", "loom_test")
load("//loom/target:execution_profiles.bzl", "GPU_HARDWARE_PROFILES")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_TASK_DRIVER_COMPATIBLE_WITH = loom_config_compatible_with([
    "//runtime/config/hal:driver_task",
])

_AMDGPU_EXECUTION_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/execute:amdgpu_hal",
])

_AMDGPU_EXECUTION_TAGS = [
    "iree-run-requirement=runtime.resource.amd_gpu",
    "requires-gpu-amd",
    "runtime-resource=amd-gpu",
]

exports_files([
    "testdata/buffer_bulk_hal_actual.loom",
    "testdata/dynamic_workgroup_hal_actual.loom",
    "testdata/launch_schedule_hal_actual.loom",
    "testdata/scenario_batch_hal_actual.loom",
    "testdata/scenario_compare_hal_vm.loom",
])

loom_test(
    name = "hardware_test",
    srcs = [
        "testdata/buffer_bulk_hal_actual.loom",
        "testdata/dynamic_workgroup_hal_actual.loom",
        "testdata/launch_schedule_hal_actual.loom",
        "testdata/scenario_batch_hal_actual.loom",
    ],
    execution_profiles = GPU_HARDWARE_PROFILES,
)

loom_test(
    name = "scenario_compare_test",
    srcs = ["testdata/scenario_compare_hal_vm.loom"],
    execution_profiles = GPU_HARDWARE_PROFILES,
)

iree_executable_test(
    name = "scenario_benchmark_test",
    src = "//loom/src/loom/tools/iree-benchmark-loom",
    args = [
        "$(rootpath testdata/scenario_compare_hal_vm.loom)",
        "--device=amdgpu",
        "--case=@scenario_compare_hal_vm",
        "--benchmark=@scenario_compare_hal_vm_throughput",
        "--sample=2",
        "--batch-size=2",
        "--iterations=1",
        "--warmup-iterations=0",
        "--min-time-ms=0",
        "--warmup-time-ms=0",
        "--max-batches=1",
    ],
    data = ["testdata/scenario_compare_hal_vm.loom"],
    resource_group = GPU_DEVICE_RESOURCE_GROUP,
    tags = _AMDGPU_EXECUTION_TAGS,
    target_compatible_with = _AMDGPU_EXECUTION_COMPATIBLE_WITH,
)

loom_cc_library(
    name = "artifact",
    hdrs = ["artifact.h"],
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
    ],
)

