// Two functions spell the same address computation with different value
// names. loom-analyze reports the shared sequence as one duplicate-sequence finding.
func.def @row_address(%row: index, %col: index, %stride: index, %base: index) -> (index) {
  %scaled = index.mul %row, %stride : index
  %offset = index.add %scaled, %col : index
  %shifted = index.add %base, %offset : index
  %wrapped = index.rem %shifted, %stride : index
  %bucket = index.div %shifted, %stride : index
  %address = index.add %bucket, %wrapped : index
  func.return %address : index
}

func.def @tile_address(%tile_row: index, %tile_col: index, %pitch: index, %origin: index) -> (index) {
  %row_bytes = index.mul %tile_row, %pitch : index
  %local = index.add %row_bytes, %tile_col : index
  %global = index.add %origin, %local : index
  %lane = index.rem %global, %pitch : index
  %group = index.div %global, %pitch : index
  %result = index.add %group, %lane : index
  func.return %result : index
}
