load("//build_tools/testing:build_defs.bzl", "iree_cli_test")
load("//loom/binding/c:shared.bzl", "loomc_cc_binary")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_cc_library(
    name = "clone_analysis",
    srcs = [
        "clone_analysis.c",
        "report.c",
    ],
    hdrs = [
        "clone_analysis.h",
        "report.h",
    ],
    deps = [
        "//loom/src/loom/error:source",
        "//loom/src/loom/format/text:printer",
        "//loom/src/loom/ir",
        "//loom/src/loom/ir:storage",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/util:json",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "inputs",
    srcs = ["inputs.c"],
    hdrs = ["inputs.h"],
    deps = ["//runtime/src/iree/base"],
)

loomc_cc_binary(
    name = "loom-analyze",
    srcs = ["loom-analyze.c"],
    deps = [
        ":clone_analysis",
        ":inputs",
        "//loom/binding/c:interop",
        "//loom/binding/c:loomc",
        "//loom/binding/c/target/configured:ir",
        "//loom/src/loom/tooling/cli:help",
        "//loom/src/loom/tooling/cli:loomc_result",
        "//loom/src/loom/tooling/io:file",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/tooling:flags",
    ],
)

iree_cli_test(
    name = "execution_test",
    data = [
        "testdata/clean.loom",
        "testdata/duplicates.loom",
        "testdata/invalid.loom",
        "testdata/motif.loom",
        "testdata/type_variant.loom",
    ],
    manifests = ["loom-analyze.test.json"],
    tags = ["hostonly"],
    tools = {
        "loom-analyze": ":loom-analyze",
    },
)
