{
  "version": 1,
  "cases": [
    {
      "name": "selects canonical Wasm module format",
      "run": {
        "tool": "loom-compile",
        "args": [
          "--target=wasm:simd128",
          "--output={tmp}/module.wasm",
          "--compile-report=details",
          "--compile-report-output={tmp}/compile-report.json"
        ],
        "stdin": {
          "text": "func.def public @add(%lhs: i32, %rhs: i32) -> (i32) {\n  %result = scalar.addi %lhs, %rhs : i32\n  func.return %result : i32\n}\n"
        }
      },
      "files": [
        {
          "path": "{tmp}/module.wasm",
          "non_empty": true
        },
        {
          "path": "{tmp}/compile-report.json",
          "non_empty": true
        }
      ]
    },
    {
      "name": "rejects artifact manifests for module formats",
      "run": {
        "tool": "loom-compile",
        "args": [
          "--target=wasm:simd128",
          "--output={tmp}/module-with-manifest.wasm",
          "--artifact-manifest=summary",
          "--emit-artifact-manifest={tmp}/module.manifest.json"
        ],
        "stdin": {
          "text": "func.def public @entry() {\n  func.return\n}\n"
        }
      },
      "exit": 1,
      "stderr": {
        "contains": [
          "--artifact-manifest is only valid for loadable kernel formats"
        ]
      },
      "files": [
        {"path": "{tmp}/module-with-manifest.wasm", "exists": false},
        {"path": "{tmp}/module.manifest.json", "exists": false}
      ]
    }
  ]
}
