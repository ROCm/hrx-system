{
  "version": 1,
  "cases": [
    {
      "name": "emits LLVM bitcode from source",
      "steps": [
        {
          "name": "write-source",
          "write": {
            "path": "{tmp}/mul.loom",
            "text": "llvmir.target<object> @target {\n  triple = \"loom-direct64-unknown-none\",\n  data_layout = \"e-p:64:64-i64:64-n8:16:32:64-S128\"\n}\n\nfunc.def public target(@target) @mul(%lhs: i32, %rhs: i32) -> (i32) {\n  %product = scalar.muli %lhs, %rhs : i32\n  func.return %product : i32\n}\n"
          }
        },
        {
          "name": "compile",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{tmp}/mul.loom",
              "--backend=llvmir-bitcode",
              "--output={tmp}/mul.bc"
            ]
          },
          "files": [
            {
              "path": "{tmp}/mul.bc",
              "non_empty": true
            }
          ]
        }
      ]
    },
    {
      "name": "rejects HAL sidecar path for LLVMIR emitters",
      "steps": [
        {
          "name": "write-source",
          "write": {
            "path": "{tmp}/sidecar.loom",
            "text": "llvmir.target<object> @target {\n  triple = \"loom-direct64-unknown-none\",\n  data_layout = \"e-p:64:64-i64:64-n8:16:32:64-S128\"\n}\n\nfunc.def public target(@target) @sidecar(%lhs: i32) -> (i32) {\n  func.return %lhs : i32\n}\n"
          }
        },
        {
          "name": "compile",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{tmp}/sidecar.loom",
              "--backend=llvmir-text",
              "--emit-target-artifact={tmp}/unused.ll",
              "--output={tmp}/sidecar.ll"
            ]
          },
          "exit": {
            "nonzero": true
          },
          "stderr": {
            "contains": [
              "--emit-target-artifact is only valid for HAL artifact providers"
            ]
          }
        }
      ]
    },
    {
      "name": "rejects command artifacts for another backend",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/testdata/llvmir_program.loom",
          "--backend=llvmir-text",
          "--emit-command-artifacts={tmp}/commands",
          "--output={tmp}/program.ll"
        ]
      },
      "exit": {
        "nonzero": true
      },
      "stderr": {
        "contains": [
          "--emit-command-artifacts requires --backend=command"
        ]
      }
    },
    {
      "name": "routes pipeline IR tracing",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/testdata/llvmir_program.loom",
          "--backend=llvmir-text",
          "--output={tmp}/program.ll",
          "--dump-ir-after-all",
          "--dump-ir-format=jsonl",
          "--dump-ir-output=stderr"
        ]
      },
      "stderr": {
        "contains": [
          "\"tool\":\"loom-compile\"",
          "\"point\":\"after\""
        ]
      },
      "files": [
        {
          "path": "{tmp}/program.ll",
          "non_empty": true
        }
      ]
    },
    {
      "name": "applies sanitizer flags to the default pipeline",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/testdata/llvmir_program.loom",
          "--backend=llvmir-text",
          "--output={tmp}/program.ll",
          "--sanitizer=access",
          "--dump-ir-before=sanitizer-insert-assertions",
          "--dump-ir-format=jsonl",
          "--dump-ir-output=stderr"
        ]
      },
      "stderr": {
        "contains": [
          "\"pass\":\"sanitizer-insert-assertions\"",
          "\"point\":\"before\""
        ]
      },
      "files": [
        {
          "path": "{tmp}/program.ll",
          "non_empty": true
        }
      ]
    },
    {
      "name": "loads config file",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/testdata/configured_llvmir.loom",
          "--config-file={srcdir}/testdata/configured_values.json",
          "--backend=llvmir-text",
          "--output={tmp}/configured.ll"
        ]
      },
      "files": [
        {
          "path": "{tmp}/configured.ll",
          "non_empty": true
        }
      ]
    }
  ]
}
