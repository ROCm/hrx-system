amdgpu.target<gfx11-generic> @gfx11_generic_target

kernel.def target(@gfx11_generic_target) export("compile_report_carried_loop_memory_economics") @compile_report_carried_loop_memory_economics() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %zero_offset = index.constant 0 : offset
  %zero_index = index.constant 0 : index
  %one_index = index.constant 1 : index
  %four_index = index.constant 4 : index
  %zero_f32 = scalar.constant 0.0 : f32
  %global_input = buffer.assume.memory_space<global> %input : buffer
  %global_output = buffer.assume.memory_space<global> %output : buffer
  %input_view = buffer.view %global_input[%zero_offset] : buffer -> view<4xf32, #dense>
  %output_view = buffer.view %global_output[%zero_offset] : buffer -> view<4xf32, #dense>
  %sum = scf.for %i = [%zero_index to %four_index step %one_index](%acc = %zero_f32 : f32) -> (f32) {
    %value = view.load %input_view[%i] : view<4xf32, #dense> -> f32
    %next = scalar.addf<reassoc|nnan|nsz> %acc, %value : f32
    view.store %next, %output_view[%i] : f32, view<4xf32, #dense>
    scf.yield %next : f32
  }
  view.store %sum, %output_view[%zero_index] : f32, view<4xf32, #dense>
  kernel.return
}
