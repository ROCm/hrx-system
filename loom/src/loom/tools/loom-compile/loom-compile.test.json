{
  "version": 1,
  "cases": [
    {
      "name": "rejects invalid source before target selection",
      "run": {
        "tool": "loom-compile",
        "args": [
          "--pipeline=none",
          "--output={tmp}/invalid.bin"
        ],
        "stdin": {
          "text": "func.def public @out_of_domain() -> (i32) {\n  %value = scalar.constant 2147483648 : i32\n  func.return %value : i32\n}\n"
        }
      },
      "exit": 1,
      "stderr": {"contains": ["STRUCTURE/014", "input module failed verification"]},
      "files": [{"path": "{tmp}/invalid.bin", "exists": false}]
    },
    {
      "name": "runs target-owned Low verification",
      "run": {
        "tool": "loom-compile",
        "args": [
          "--pipeline=none",
          "--output={tmp}/invalid.bin"
        ],
        "stdin": {
          "text": "x86.target<scalar> @target\n\nlow.func.def target<x86.scalar.core>(@target) abi(object_function) abi_layout({argument_locations = [6], calling_convention = \"sysv_x86_64\", result_locations = [0], stack_argument_bytes = 0}) @invalid_layout(%value: reg<x86.gpr64>) -> (reg<x86.gpr64>) asm {\n  return %value\n}\n"
        }
      },
      "exit": 1,
      "stderr": {"contains": ["X86/001", "input module failed Low verification"]},
      "files": [{"path": "{tmp}/invalid.bin", "exists": false}]
    },
    {
      "name": "prints agent documentation",
      "run": {
        "tool": "loom-compile",
        "args": ["--agents_md"]
      },
      "stdout": {
        "non_empty": true
      }
    },
    {
      "name": "writes command artifact outputs",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/testdata/command_artifacts.loom",
          "--product=command",
          "--format=loom-command",
          "--output={tmp}/manifest.json",
          "--emit-command-artifacts={tmp}/commands"
        ]
      },
      "files": [
        {
          "path": "{tmp}/manifest.json",
          "non_empty": true
        },
        {
          "path": "{tmp}/commands/program-0.loomcmd",
          "non_empty": true
        },
        {
          "path": "{tmp}/commands/program-1.loomcmd",
          "non_empty": true
        }
      ]
    },
    {
      "name": "writes kernel request outputs",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/testdata/command_kernel_requests.loom",
          "--product=command",
          "--format=loom-command",
          "--output={tmp}/manifest.json",
          "--emit-command-artifacts={tmp}/commands",
          "--emit-kernel-requests={tmp}/requests"
        ]
      },
      "files": [
        {
          "path": "{tmp}/requests/kernel-0.loombc",
          "non_empty": true
        },
        {
          "path": "{tmp}/requests/kernel-1.loombc",
          "non_empty": true
        }
      ]
    },
    {
      "name": "selects a command root",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/testdata/command_artifacts.loom",
          "--product=command",
          "--format=loom-command",
          "--root=@increment_then_double",
          "--output={tmp}/manifest.json",
          "--emit-command-artifacts={tmp}/commands"
        ]
      },
      "files": [
        {
          "path": "{tmp}/commands/program-0.loomcmd",
          "non_empty": true
        },
        {
          "path": "{tmp}/commands/program-1.loomcmd",
          "exists": false
        }
      ]
    },
    {
      "name": "requires command artifact directory",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/testdata/command_artifacts.loom",
          "--product=command",
          "--format=loom-command",
          "--output={tmp}/manifest.json"
        ]
      },
      "exit": {
        "nonzero": true
      },
      "stderr": {
        "contains": [
          "format 'loom-command' requires --emit-command-artifacts=<directory>"
        ]
      }
    },
    {
      "name": "rejects the removed backend flag",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/testdata/command_artifacts.loom",
          "--backend=command",
          "--output={tmp}/manifest.json"
        ]
      },
      "exit": {
        "nonzero": true
      },
      "stderr": {
        "contains": ["flag 'backend' not recognized"]
      }
    }
  ]
}
