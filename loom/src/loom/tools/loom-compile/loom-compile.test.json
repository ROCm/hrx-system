{
  "version": 1,
  "cases": [
    {
      "name": "prints agent documentation",
      "run": {
        "tool": "loom-compile",
        "args": ["--agents_md"]
      },
      "stdout": {
        "contains": {
          "unordered": [
            "## loom-compile",
            "--backend=",
            "--compile-report=summary",
            "--artifact-manifest=summary",
            "--emit-target-artifact=",
            "--dump-ir-after-all",
            "Prepared-low reproducers",
            "--pipeline=none",
            "whole-module snapshots",
            ".entries.rows[]",
            "post-run slicing",
            "target_capability_rows.rows[]",
            "matrix_fp8_native_kind",
            ".schedule_band_summary_rows.rows[]",
            "dynamic_instruction_mix",
            "max_band_node_count",
            ".wait_reason_summary_rows.rows[]",
            ".wait_action_rows.rows[]",
            "group_by",
            "full_drains",
            "semantic_tag",
            "Matrix-family schedule evidence",
            "rounding=finite_only",
            "fp8_packed_bf16_decode_repair_zero_subnormal",
            "jq -r"
          ]
        }
      }
    },
    {
      "name": "compiles source module",
      "steps": [
        {
          "name": "write-source",
          "write": {
            "path": "{tmp}/arithmetic.loom",
            "text": "llvmir.target<object> @target {\n  triple = \"loom-direct64-unknown-none\",\n  data_layout = \"e-p:64:64-i64:64-n8:16:32:64-S128\"\n}\n\nfunc.def public target(@target) @arithmetic(%lhs: i32, %rhs: i32) -> (i32) {\n  %sum = scalar.addi %lhs, %rhs : i32\n  func.return %sum : i32\n}\n"
          }
        },
        {
          "name": "compile",
          "run": {
            "tool": "loom-compile",
            "args": [
              "--backend=llvmir-text",
              "{tmp}/arithmetic.loom",
              "--output={tmp}/arithmetic.ll",
              "--compile-report=summary"
            ]
          },
          "stderr": {
            "save": "{tmp}/compile_report.json",
            "contains": [
              "\"artifact_kind\":\"target-artifact\"",
              "\"status\":{\"code\":0,\"name\":\"OK\"}"
            ]
          },
          "files": [
            {
              "path": "{tmp}/arithmetic.ll",
              "non_empty": true
            }
          ]
        }
      ]
    },
    {
      "name": "compiles bytecode module",
      "steps": [
        {
          "name": "write-source",
          "write": {
            "path": "{tmp}/arithmetic.loom",
            "text": "llvmir.target<object> @target {\n  triple = \"loom-direct64-unknown-none\",\n  data_layout = \"e-p:64:64-i64:64-n8:16:32:64-S128\"\n}\n\nfunc.def public target(@target) @arithmetic(%lhs: i32, %rhs: i32) -> (i32) {\n  %sum = scalar.addi %lhs, %rhs : i32\n  func.return %sum : i32\n}\n"
          }
        },
        {
          "name": "encode-source",
          "run": {
            "tool": "loom-format",
            "args": [
              "{tmp}/arithmetic.loom",
              "--from=text",
              "--to=bytecode",
              "--output={tmp}/arithmetic.loombc"
            ]
          },
          "files": [
            {
              "path": "{tmp}/arithmetic.loombc",
              "non_empty": true
            }
          ]
        },
        {
          "name": "compile",
          "run": {
            "tool": "loom-compile",
            "args": [
              "--backend=llvmir-text",
              "{tmp}/arithmetic.loombc",
              "--output={tmp}/arithmetic.ll",
              "--compile-report=summary"
            ]
          },
          "stderr": {
            "contains": [
              "\"artifact_kind\":\"target-artifact\"",
              "\"status\":{\"code\":0,\"name\":\"OK\"}"
            ]
          },
          "files": [
            {
              "path": "{tmp}/arithmetic.ll",
              "non_empty": true
            }
          ]
        }
      ]
    },
    {
      "name": "rooted compile retains template provider",
      "steps": [
        {
          "name": "compile-root",
          "run": {
            "tool": "loom-compile",
            "args": [
              "--backend=llvmir-text",
              "{srcdir}/rooted_template_provider.loom",
              "--root=@entry",
              "--output={tmp}/rooted_template.ll",
              "--compile-report=summary"
            ]
          },
          "stderr": {
            "contains": [
              "\"artifact_kind\":\"target-artifact\"",
              "\"status\":{\"code\":0,\"name\":\"OK\"}"
            ],
            "not_contains": [
              "no_provider"
            ]
          },
          "files": [
            {
              "path": "{tmp}/rooted_template.ll",
              "non_empty": true
            }
          ]
        }
      ]
    },
    {
      "name": "dumps compile pipeline IR as JSONL",
      "steps": [
        {
          "name": "write-source",
          "write": {
            "path": "{tmp}/trace.loom",
            "text": "llvmir.target<object> @target {\n  triple = \"loom-direct64-unknown-none\",\n  data_layout = \"e-p:64:64-i64:64-n8:16:32:64-S128\"\n}\n\nfunc.def public target(@target) @trace(%lhs: i32, %rhs: i32) -> (i32) {\n  %sum = scalar.addi %lhs, %rhs : i32\n  func.return %sum : i32\n}\n"
          }
        },
        {
          "name": "compile",
          "run": {
            "tool": "loom-compile",
            "args": [
              "--backend=llvmir-text",
              "{tmp}/trace.loom",
              "--output={tmp}/trace.ll",
              "--dump-ir-after-all",
              "--dump-ir-format=jsonl",
              "--dump-ir-output=stderr"
            ]
          },
          "stderr": {
            "contains": [
              "\"tool\":\"loom-compile\"",
              "\"stage\":\"prepared-low\"",
              "\"pipeline\":\"__loom_compile_default\"",
              "\"point\":\"after\"",
              "\"ir\":\""
            ]
          },
          "files": [
            {
              "path": "{tmp}/trace.ll",
              "non_empty": true
            }
          ]
        }
      ]
    },
    {
      "name": "enables sanitizer checks in default pipeline",
      "steps": [
        {
          "name": "write-source",
          "write": {
            "path": "{tmp}/sanitizer.loom",
            "text": "llvmir.target<object> @target {\n  triple = \"loom-direct64-unknown-none\",\n  data_layout = \"e-p:64:64-i64:64-n8:16:32:64-S128\"\n}\n\nfunc.def public target(@target) @sanitizer(%lhs: i32, %rhs: i32) -> (i32) {\n  %sum = scalar.addi %lhs, %rhs : i32\n  func.return %sum : i32\n}\n"
          }
        },
        {
          "name": "compile",
          "run": {
            "tool": "loom-compile",
            "args": [
              "--backend=llvmir-text",
              "{tmp}/sanitizer.loom",
              "--output={tmp}/sanitizer.ll",
              "--sanitizer=access",
              "--dump-ir-before=sanitizer-insert-assertions",
              "--dump-ir-format=jsonl",
              "--dump-ir-output=stderr"
            ]
          },
          "stderr": {
            "contains": [
              "\"tool\":\"loom-compile\"",
              "\"pass\":\"sanitizer-insert-assertions\"",
              "\"point\":\"before\""
            ]
          },
          "files": [
            {
              "path": "{tmp}/sanitizer.ll",
              "non_empty": true
            }
          ]
        }
      ]
    },
    {
      "name": "writes detailed compile report file",
      "steps": [
        {
          "name": "write-source",
          "write": {
            "path": "{tmp}/arithmetic.loom",
            "text": "llvmir.target<object> @target {\n  triple = \"loom-direct64-unknown-none\",\n  data_layout = \"e-p:64:64-i64:64-n8:16:32:64-S128\"\n}\n\nfunc.def public target(@target) @arithmetic(%lhs: i32, %rhs: i32) -> (i32) {\n  %sum = scalar.addi %lhs, %rhs : i32\n  func.return %sum : i32\n}\n"
          }
        },
        {
          "name": "compile",
          "run": {
            "tool": "loom-compile",
            "args": [
              "--backend=llvmir-text",
              "{tmp}/arithmetic.loom",
              "--output={tmp}/arithmetic.ll",
              "--compile-report=details",
              "--compile-report-output={tmp}/report.json"
            ]
          },
          "files": [
            {
              "path": "{tmp}/arithmetic.ll",
              "non_empty": true
            },
            {
              "path": "{tmp}/report.json",
              "non_empty": true
            }
          ]
        },
        {
          "name": "inspect-report",
          "run": {
            "tool": "loom-compile",
            "args": [
              "--backend=llvmir-text",
              "{tmp}/arithmetic.loom",
              "--output={tmp}/unused.ll",
              "--compile-report=summary",
              "--compile-report-output=-"
            ]
          },
          "stdout": {
            "contains": [
              "\"artifact_kind\":\"target-artifact\"",
              "\"status\":{\"code\":0,\"name\":\"OK\"}"
            ]
          }
        }
      ]
    },
    {
      "name": "applies config file and reports invalid config states",
      "steps": [
        {
          "name": "write-config",
          "write": {
            "path": "{tmp}/config.json",
            "text": "{\"model36\": {\"model\": {\"delta\": 32}}}\n"
          }
        },
        {
          "name": "write-source",
          "write": {
            "path": "{tmp}/configured.loom",
            "text": "llvmir.target<object> @target {\n  triple = \"loom-direct64-unknown-none\",\n  data_layout = \"e-p:64:64-i64:64-n8:16:32:64-S128\"\n}\n\nconfig.decl @model36.model.delta : i32\n\nfunc.def public target(@target) @configured(%lhs: i32) -> (i32) {\n  %delta = config.get @model36.model.delta : i32\n  %sum = scalar.addi %lhs, %delta : i32\n  func.return %sum : i32\n}\n"
          }
        },
        {
          "name": "compile-configured",
          "run": {
            "tool": "loom-compile",
            "args": [
              "--backend=llvmir-text",
              "{tmp}/configured.loom",
              "--config-file={tmp}/config.json",
              "--output={tmp}/configured.ll"
            ]
          },
          "files": [
            {
              "path": "{tmp}/configured.ll",
              "non_empty": true
            }
          ]
        },
        {
          "name": "reject-duplicate-config",
          "run": {
            "tool": "loom-compile",
            "args": [
              "--backend=llvmir-text",
              "{tmp}/configured.loom",
              "--config-file={tmp}/config.json",
              "--config=model36.model.delta=16",
              "--output={tmp}/unused.ll"
            ]
          },
          "exit": {
            "nonzero": true
          },
          "stderr": {
            "contains": ["duplicate config binding for 'model36.model.delta'"]
          }
        },
        {
          "name": "reject-unresolved-config",
          "run": {
            "tool": "loom-compile",
            "args": [
              "--backend=llvmir-text",
              "{tmp}/configured.loom",
              "--pipeline=none",
              "--output={tmp}/unused.ll"
            ]
          },
          "exit": {
            "nonzero": true
          },
          "stderr": {
            "contains": [
              "unresolved config '@model36.model.delta' remains for final compilation"
            ]
          }
        }
      ]
    }
  ]
}
