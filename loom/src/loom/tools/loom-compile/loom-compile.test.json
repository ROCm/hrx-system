{
  "version": 1,
  "cases": [
    {
      "name": "prints agent documentation",
      "run": {
        "tool": "loom-compile",
        "args": ["--agents_md"]
      },
      "stdout": {
        "non_empty": true
      }
    },
    {
      "name": "writes command artifact outputs",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/testdata/command_artifacts.loom",
          "--backend=command",
          "--output={tmp}/manifest.json",
          "--emit-command-artifacts={tmp}/commands"
        ]
      },
      "files": [
        {
          "path": "{tmp}/manifest.json",
          "non_empty": true
        },
        {
          "path": "{tmp}/commands/program-0.loomcmd",
          "non_empty": true
        },
        {
          "path": "{tmp}/commands/program-1.loomcmd",
          "non_empty": true
        }
      ]
    },
    {
      "name": "writes kernel request outputs",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/testdata/command_kernel_requests.loom",
          "--backend=command",
          "--output={tmp}/manifest.json",
          "--emit-command-artifacts={tmp}/commands",
          "--emit-kernel-requests={tmp}/requests"
        ]
      },
      "files": [
        {
          "path": "{tmp}/requests/kernel-0.loombc",
          "non_empty": true
        },
        {
          "path": "{tmp}/requests/kernel-1.loombc",
          "non_empty": true
        }
      ]
    },
    {
      "name": "selects a command root",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/testdata/command_artifacts.loom",
          "--backend=command",
          "--root=@increment_then_double",
          "--output={tmp}/manifest.json",
          "--emit-command-artifacts={tmp}/commands"
        ]
      },
      "files": [
        {
          "path": "{tmp}/commands/program-0.loomcmd",
          "non_empty": true
        },
        {
          "path": "{tmp}/commands/program-1.loomcmd",
          "exists": false
        }
      ]
    },
    {
      "name": "requires command artifact directory",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/testdata/command_artifacts.loom",
          "--backend=command",
          "--output={tmp}/manifest.json"
        ]
      },
      "exit": {
        "nonzero": true
      },
      "stderr": {
        "contains": [
          "--backend=command requires --emit-command-artifacts=<directory>"
        ]
      }
    },
    {
      "name": "rejects a root owned by another product",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/testdata/command_artifacts.loom",
          "--backend=command",
          "--root=@increment",
          "--output={tmp}/manifest.json",
          "--emit-command-artifacts={tmp}/commands"
        ]
      },
      "exit": {
        "nonzero": true
      },
      "stderr": {
        "contains": [
          "product root '@increment' selects product 'kernel'"
        ]
      }
    }
  ]
}
