{
  "version": 1,
  "cases": [
    {
      "name": "pipeline none still verifies stdin before writing output",
      "run": {
        "tool": "loom-compile",
        "args": [
          "--pipeline=none",
          "--output={tmp}/invalid.bin"
        ],
        "stdin": {
          "text": "func.def public @out_of_domain() -> (i32) {\n  %value = scalar.constant 2147483648 : i32\n  func.return %value : i32\n}\n"
        }
      },
      "exit": 1,
      "stderr": {"non_empty": true},
      "files": [{"path": "{tmp}/invalid.bin", "exists": false}]
    },
    {
      "name": "prints agent documentation",
      "run": {
        "tool": "loom-compile",
        "args": ["--agents_md"]
      },
      "stdout": {
        "contains": ["loom-compile --help"],
        "not_contains": [
          "amdgpu:gfx11-generic",
          "--format=spirv",
          "wasm-binary"
        ]
      }
    },
    {
      "name": "reports provider capabilities in help",
      "run": {
        "tool": "loom-compile",
        "args": ["--help"]
      },
      "stdout": {
        "contains": [
          "Available artifact formats:",
          "amdgpu-hsaco",
          "spirv",
          "vm",
          "xdna",
          "x86-elf",
          "x86-elf-shared",
          "x86-hal",
          "Available target families:",
          "amdgpu",
          "amd.xdna.aie2p",
          "x86"
        ],
        "not_contains": [
          "--list-formats",
          "--list-targets"
        ]
      },
      "stderr": {"empty": true}
    },
    {
      "name": "rejects artifact and report output sharing stdout",
      "run": {
        "tool": "loom-compile",
        "args": [
          "--output=stdout",
          "--compile-report=summary",
          "--compile-report-output=-"
        ]
      },
      "exit": 1,
      "stdout": {"empty": true},
      "stderr": {
        "contains": [
          "--output and --compile-report-output cannot both write to stdout"
        ]
      }
    },
    {
      "name": "rejects artifact and pass trace output sharing stdout",
      "run": {
        "tool": "loom-compile",
        "args": [
          "--output=stdout",
          "--dump-ir-after-all",
          "--dump-ir-output=-"
        ]
      },
      "exit": 1,
      "stdout": {"empty": true},
      "stderr": {
        "contains": [
          "--output and --dump-ir-output cannot both write to stdout"
        ]
      }
    },
    {
      "name": "rejects artifact and manifest output sharing stdout",
      "run": {
        "tool": "loom-compile",
        "args": [
          "--output=-",
          "--artifact-manifest=summary",
          "--emit-artifact-manifest=stdout"
        ]
      },
      "exit": 1,
      "stdout": {"empty": true},
      "stderr": {
        "contains": [
          "--output and --emit-artifact-manifest cannot both write to stdout"
        ]
      }
    },
    {
      "name": "rejects manifest and report output sharing stdout",
      "run": {
        "tool": "loom-compile",
        "args": [
          "--output={tmp}/artifact.bin",
          "--artifact-manifest=summary",
          "--emit-artifact-manifest=-",
          "--compile-report=summary",
          "--compile-report-output=stdout"
        ]
      },
      "exit": 1,
      "stdout": {"empty": true},
      "stderr": {
        "contains": [
          "--emit-artifact-manifest and --compile-report-output cannot both write to stdout"
        ]
      },
      "files": [
        {"path": "{tmp}/artifact.bin", "exists": false}
      ]
    },
    {
      "name": "rejects command-program roots",
      "run": {
        "tool": "loom-compile",
        "args": [
          "--root=@program",
          "--output={tmp}/command.bin"
        ],
        "stdin": {
          "text": "command.program.def public @program() launch() {\n  command.return\n}\n"
        }
      },
      "exit": 1,
      "stderr": {
        "contains": ["command-program roots require loomc_cmd_program_product_build"]
      },
      "files": [
        {
          "path": "{tmp}/command.bin",
          "exists": false
        }
      ]
    },
    {
      "name": "rejects mixed inputs containing command programs",
      "run": {
        "tool": "loom-compile",
        "args": ["--output={tmp}/mixed.bin"],
        "stdin": {
          "text": "kernel.def @kernel() {\n  %one = index.constant 1 : index\n  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index\n} launch() {\n  kernel.return\n}\ncommand.program.def public @program() launch() {\n  command.return\n}\n"
        }
      },
      "exit": 1,
      "stderr": {
        "contains": ["mixed default entry categories"]
      },
      "files": [
        {
          "path": "{tmp}/mixed.bin",
          "exists": false
        }
      ]
    },
    {
      "name": "rejects mixed kernel and module inputs",
      "run": {
        "tool": "loom-compile",
        "args": ["--output={tmp}/mixed-kernel-module.bin"],
        "stdin": {
          "text": "kernel.def @kernel() {\n  %one = index.constant 1 : index\n  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%one, %one, %one) : index\n} launch() {\n  kernel.return\n}\nfunc.def public @function() {\n  func.return\n}\n"
        }
      },
      "exit": 1,
      "stderr": {
        "contains": ["mixed default entry categories"]
      },
      "files": [
        {
          "path": "{tmp}/mixed-kernel-module.bin",
          "exists": false
        }
      ]
    }
  ]
}
