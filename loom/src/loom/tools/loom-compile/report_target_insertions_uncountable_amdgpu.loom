  %sum14 = vector.addf %sum13, %result14 : vector<8xf32>
  %sum15 = vector.addf %sum14, %result15 : vector<8xf32>
  %sum16 = vector.addf %sum15, %result16 : vector<8xf32>
  %sum17 = vector.addf %sum16, %result17 : vector<8xf32>
  %sum18 = vector.addf %sum17, %result18 : vector<8xf32>
  %sum19 = vector.addf %sum18, %result19 : vector<8xf32>
  %sum20 = vector.addf %sum19, %result20 : vector<8xf32>
  %sum21 = vector.addf %sum20, %result21 : vector<8xf32>
  %sum22 = vector.addf %sum21, %result22 : vector<8xf32>
  %sum23 = vector.addf %sum22, %result23 : vector<8xf32>
  %sum24 = vector.addf %sum23, %result24 : vector<8xf32>
  %sum25 = vector.addf %sum24, %result25 : vector<8xf32>
  %sum26 = vector.addf %sum25, %result26 : vector<8xf32>
  %sum27 = vector.addf %sum26, %result27 : vector<8xf32>
  %sum28 = vector.addf %sum27, %result28 : vector<8xf32>
  %sum29 = vector.addf %sum28, %result29 : vector<8xf32>
  %sum30 = vector.addf %sum29, %result30 : vector<8xf32>
  %sum31 = vector.addf %sum30, %result31 : vector<8xf32>
  %sum32 = vector.addf %sum31, %result32 : vector<8xf32>
  vector.store %sum32, %output_view[0] : vector<8xf32>, view<8xf32, #dense>
  kernel.return
}
