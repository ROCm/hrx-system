// Runtime-bounded high-VGPR control flow keeps dynamic packet counts unknown.
amdgpu.target<gfx1250> @target

kernel.def target(@target) export("target_insertion_uncountable") @target_insertion_uncountable() {
  %one = index.constant 1 : index
  %workgroup_size = index.constant 32 : index
  kernel.launch.config workgroups(%one, %one, %one) workgroup_size(%workgroup_size, %one, %one) : index
} launch(%trip_count: index, %output: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %one = index.constant 1 : index
  %bounded_trip_count = index.assume %trip_count [range(%trip_count, 1, 4)] : index
  %output_view = buffer.view %output[%base] : buffer -> view<8xf32, #dense>
  %seed = vector.constant 1.0 : vector<8xf32>
  %result0, %result1, %result2, %result3, %result4, %result5, %result6, %result7, %result8, %result9, %result10, %result11, %result12, %result13, %result14, %result15, %result16, %result17, %result18, %result19, %result20, %result21, %result22, %result23, %result24, %result25, %result26, %result27, %result28, %result29, %result30, %result31, %result32 = scf.for %iteration = [%zero to %bounded_trip_count step %one](%acc0 = %seed : vector<8xf32>, %acc1 = %seed : vector<8xf32>, %acc2 = %seed : vector<8xf32>, %acc3 = %seed : vector<8xf32>, %acc4 = %seed : vector<8xf32>, %acc5 = %seed : vector<8xf32>, %acc6 = %seed : vector<8xf32>, %acc7 = %seed : vector<8xf32>, %acc8 = %seed : vector<8xf32>, %acc9 = %seed : vector<8xf32>, %acc10 = %seed : vector<8xf32>, %acc11 = %seed : vector<8xf32>, %acc12 = %seed : vector<8xf32>, %acc13 = %seed : vector<8xf32>, %acc14 = %seed : vector<8xf32>, %acc15 = %seed : vector<8xf32>, %acc16 = %seed : vector<8xf32>, %acc17 = %seed : vector<8xf32>, %acc18 = %seed : vector<8xf32>, %acc19 = %seed : vector<8xf32>, %acc20 = %seed : vector<8xf32>, %acc21 = %seed : vector<8xf32>, %acc22 = %seed : vector<8xf32>, %acc23 = %seed : vector<8xf32>, %acc24 = %seed : vector<8xf32>, %acc25 = %seed : vector<8xf32>, %acc26 = %seed : vector<8xf32>, %acc27 = %seed : vector<8xf32>, %acc28 = %seed : vector<8xf32>, %acc29 = %seed : vector<8xf32>, %acc30 = %seed : vector<8xf32>, %acc31 = %seed : vector<8xf32>, %acc32 = %seed : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
    %next0 = vector.addf %acc0, %seed : vector<8xf32>
    %next1 = vector.addf %acc1, %seed : vector<8xf32>
    %next2 = vector.addf %acc2, %seed : vector<8xf32>
    %next3 = vector.addf %acc3, %seed : vector<8xf32>
    %next4 = vector.addf %acc4, %seed : vector<8xf32>
    %next5 = vector.addf %acc5, %seed : vector<8xf32>
    %next6 = vector.addf %acc6, %seed : vector<8xf32>
    %next7 = vector.addf %acc7, %seed : vector<8xf32>
    %next8 = vector.addf %acc8, %seed : vector<8xf32>
    %next9 = vector.addf %acc9, %seed : vector<8xf32>
    %next10 = vector.addf %acc10, %seed : vector<8xf32>
    %next11 = vector.addf %acc11, %seed : vector<8xf32>
    %next12 = vector.addf %acc12, %seed : vector<8xf32>
    %next13 = vector.addf %acc13, %seed : vector<8xf32>
    %next14 = vector.addf %acc14, %seed : vector<8xf32>
    %next15 = vector.addf %acc15, %seed : vector<8xf32>
    %next16 = vector.addf %acc16, %seed : vector<8xf32>
    %next17 = vector.addf %acc17, %seed : vector<8xf32>
    %next18 = vector.addf %acc18, %seed : vector<8xf32>
    %next19 = vector.addf %acc19, %seed : vector<8xf32>
    %next20 = vector.addf %acc20, %seed : vector<8xf32>
    %next21 = vector.addf %acc21, %seed : vector<8xf32>
    %next22 = vector.addf %acc22, %seed : vector<8xf32>
    %next23 = vector.addf %acc23, %seed : vector<8xf32>
    %next24 = vector.addf %acc24, %seed : vector<8xf32>
    %next25 = vector.addf %acc25, %seed : vector<8xf32>
    %next26 = vector.addf %acc26, %seed : vector<8xf32>
    %next27 = vector.addf %acc27, %seed : vector<8xf32>
    %next28 = vector.addf %acc28, %seed : vector<8xf32>
    %next29 = vector.addf %acc29, %seed : vector<8xf32>
    %next30 = vector.addf %acc30, %seed : vector<8xf32>
    %next31 = vector.addf %acc31, %seed : vector<8xf32>
    %next32 = vector.addf %acc32, %seed : vector<8xf32>
    scf.yield %next0, %next1, %next2, %next3, %next4, %next5, %next6, %next7, %next8, %next9, %next10, %next11, %next12, %next13, %next14, %next15, %next16, %next17, %next18, %next19, %next20, %next21, %next22, %next23, %next24, %next25, %next26, %next27, %next28, %next29, %next30, %next31, %next32 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }
  %sum1 = vector.addf %result0, %result1 : vector<8xf32>
  %sum2 = vector.addf %sum1, %result2 : vector<8xf32>
  %sum3 = vector.addf %sum2, %result3 : vector<8xf32>
  %sum4 = vector.addf %sum3, %result4 : vector<8xf32>
  %sum5 = vector.addf %sum4, %result5 : vector<8xf32>
  %sum6 = vector.addf %sum5, %result6 : vector<8xf32>
  %sum7 = vector.addf %sum6, %result7 : vector<8xf32>
  %sum8 = vector.addf %sum7, %result8 : vector<8xf32>
  %sum9 = vector.addf %sum8, %result9 : vector<8xf32>
  %sum10 = vector.addf %sum9, %result10 : vector<8xf32>
  %sum11 = vector.addf %sum10, %result11 : vector<8xf32>
