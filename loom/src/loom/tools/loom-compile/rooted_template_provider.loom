ireevm.target<core> @vm_target

template.decl @demo.double(%value: i32) -> (i32)

template.decl @demo.unused(%value: i32) -> (i32)

template.def<@demo.double> @double_template(%value: i32) -> (i32) {
  %doubled = scalar.addi %value, %value : i32
  template.return %doubled : i32
}

template.def<@demo.unused> @unused_template(%value: i32) -> (i32) {
  template.return %value : i32
}

func.def public target(@vm_target) @entry(%value: i32) -> (i32) {
  %result = template.apply<@demo.double>(%value) : (i32) -> (i32)
  func.return %result : i32
}
