load("//build_tools/bazel:query.bzl", "iree_assert_dependency_boundary")
load("//build_tools/testing:build_defs.bzl", "iree_execution_test_suite")
load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "iree_select",
    "loom_cc_binary",
    "loom_cc_library",
    "loom_cc_test",
    "loom_config_compatible_with",
)

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_AMDGPU_COMPILE_COPTS = iree_select({
    "//loom/config/target:amdgpu_artifacts": [
        "-DLOOM_COMPILE_HAVE_AMDGPU=1",
    ],
    "//conditions:default": [],
})

_AMDGPU_COMPILE_DEPS = iree_select({
    "//loom/config/target:amdgpu_artifacts": [
        "//loom/src/loom/target/arch/amdgpu:provider",
        "//loom/src/loom/tooling/target/amdgpu:artifact_provider",
    ],
    "//conditions:default": [],
})

_SPIRV_VULKAN_COMPILE_COPTS = iree_select({
    "//loom/config/target:spirv_vulkan_artifacts": [
        "-DLOOM_COMPILE_HAVE_SPIRV_VULKAN=1",
    ],
    "//conditions:default": [],
})

_SPIRV_VULKAN_COMPILE_DEPS = iree_select({
    "//loom/config/target:spirv_vulkan_artifacts": [
        "//loom/src/loom/target/arch/spirv:provider",
        "//loom/src/loom/tooling/target/spirv:artifact_provider",
    ],
    "//conditions:default": [],
})

_LLVMIR_COMPILE_COPTS = iree_select({
    "//loom/config/target:llvmir_artifacts": [
        "-DLOOM_COMPILE_HAVE_LLVMIR=1",
    ],
    "//conditions:default": [],
})

_LLVMIR_COMPILE_DEPS = iree_select({
    "//loom/config/target:llvmir_artifacts": [
        "//loom/src/loom/target/arch/llvmir:provider",
        "//loom/src/loom/target/emit/llvmir:artifact_emitter",
    ],
    "//conditions:default": [],
})

_LLVMIR_AMDGPU_TARGET_ENV_COPTS = iree_select({
    "//loom/config/target:llvmir_amdgpu_target_env": [
        "-DLOOM_COMPILE_HAVE_LLVMIR_AMDGPU_TARGET_ENV=1",
    ],
    "//conditions:default": [],
})

_LLVMIR_AMDGPU_TARGET_ENV_DEPS = iree_select({
    "//loom/config/target:llvmir_amdgpu_target_env": [
        "//loom/src/loom/target/emit/llvmir/amdgpu:target_env",
    ],
    "//conditions:default": [],
})

_LLVMIR_X86_TARGET_ENV_COPTS = iree_select({
    "//loom/config/target:llvmir_x86_target_env": [
        "-DLOOM_COMPILE_HAVE_LLVMIR_X86_TARGET_ENV=1",
    ],
    "//conditions:default": [],
})

_LLVMIR_X86_TARGET_ENV_DEPS = iree_select({
    "//loom/config/target:llvmir_x86_target_env": [
        "//loom/src/loom/target/emit/llvmir/x86:target_env",
    ],
    "//conditions:default": [],
})

_LLVMIR_ARTIFACTS_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/target:llvmir_artifacts",
])

loom_cc_library(
    name = "command_manifest",
    srcs = ["command_manifest.c"],
    hdrs = ["command_manifest.h"],
    visibility = ["//loom/src/loom/tools/loom-compile:__pkg__"],
    deps = [
        "//loom/src/loom/target/arch/cmd:artifact_set",
        "//loom/src/loom/util:json",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "command_backend",
    srcs = ["command_backend.c"],
    hdrs = ["command_backend.h"],
    deps = [
        ":command_manifest",
        "//loom/src/loom/codegen/low:repr",
        "//loom/src/loom/error:diagnostic",
        "//loom/src/loom/format:low_repr",
        "//loom/src/loom/format/bytecode:writer",
        "//loom/src/loom/link:materialization_environment",
        "//loom/src/loom/link:module_index",
        "//loom/src/loom/pass:builtin_registry",
        "//loom/src/loom/target:entry_selection",
        "//loom/src/loom/target/arch/cmd:artifact_builder",
        "//loom/src/loom/target/arch/cmd:artifact_set",
        "//loom/src/loom/tooling/execution:session",
        "//loom/src/loom/tooling/io:file",
        "//loom/src/loom/transforms/kernel:kernel_class_materializer",
        "//loom/src/loom/transforms/kernel:kernel_request_producer",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/io:stream",
    ],
)

loom_cc_binary(
    name = "loom-compile",
    srcs = ["loom-compile.c"],
    copts = _AMDGPU_COMPILE_COPTS + _SPIRV_VULKAN_COMPILE_COPTS + _LLVMIR_COMPILE_COPTS + _LLVMIR_AMDGPU_TARGET_ENV_COPTS + _LLVMIR_X86_TARGET_ENV_COPTS,
    deps = [
        ":command_backend",
        ":command_manifest",
        "//loom/src/loom/codegen/low:text_asm",
        "//loom/src/loom/error:diagnostic",
        "//loom/src/loom/format/text:printer",
        "//loom/src/loom/ir",
        "//loom/src/loom/link:linker",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/ops/kernel",
        "//loom/src/loom/sanitizer:options",
        "//loom/src/loom/target:entry_selection",
        "//loom/src/loom/target:low_descriptor_registry",
        "//loom/src/loom/target:module_specialization",
        "//loom/src/loom/target/arch/cmd:artifact_set",
        "//loom/src/loom/target/arch/cmd:provider",
        "//loom/src/loom/target/reporting:artifact_manifest",
        "//loom/src/loom/tooling/cli:help",
        "//loom/src/loom/tooling/compile:artifact",
        "//loom/src/loom/tooling/compile:options",
        "//loom/src/loom/tooling/compile:pipeline",
        "//loom/src/loom/tooling/compile:report_capture",
        "//loom/src/loom/tooling/config",
        "//loom/src/loom/tooling/context",
        "//loom/src/loom/tooling/execution:execution_provider",
        "//loom/src/loom/tooling/execution:session",
        "//loom/src/loom/tooling/io:file",
        "//loom/src/loom/tooling/io:source_path",
        "//loom/src/loom/tooling/pass:trace_cli",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/tooling:flags",
        "//runtime/src/iree/io:file_handle",
    ] + _AMDGPU_COMPILE_DEPS + _SPIRV_VULKAN_COMPILE_DEPS + _LLVMIR_COMPILE_DEPS + _LLVMIR_AMDGPU_TARGET_ENV_DEPS + _LLVMIR_X86_TARGET_ENV_DEPS,
)

iree_assert_dependency_boundary(
    name = "loom_compile_no_hal_dependencies",
    forbidden_subtrees = ["//runtime/src/iree/hal/..."],
    target = ":loom-compile",
)

loom_cc_test(
    name = "command_manifest_test",
    srcs = ["command_manifest_test.cc"],
    deps = [
        ":command_manifest",
        "//loom/src/loom/target/arch/cmd:artifact_set",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

iree_execution_test_suite(
    name = "execution_test",
    data = [
        "//loom/src/loom/tools/loom-compile/testdata:command_artifacts.loom",
        "//loom/src/loom/tools/loom-compile/testdata:command_kernel_requests.loom",
    ],
    manifests = ["loom-compile.test.json"],
    tags = ["hostonly"],
    tools = {
        "loom-compile": ":loom-compile",
    },
)

iree_execution_test_suite(
    name = "llvmir_execution_test",
    data = [
        "//loom/src/loom/tools/loom-compile/testdata:configured_llvmir.loom",
        "//loom/src/loom/tools/loom-compile/testdata:configured_values.json",
        "//loom/src/loom/tools/loom-compile/testdata:llvmir_program.loom",
    ],
    manifests = ["loom-compile-llvmir.test.json"],
    tags = ["hostonly"],
    target_compatible_with = _LLVMIR_ARTIFACTS_COMPATIBLE_WITH,
    tools = {
        "loom-compile": ":loom-compile",
    },
)
