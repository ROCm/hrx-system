load("//build_tools/bazel:query.bzl", "iree_assert_dependency_boundary")
load("//build_tools/testing:build_defs.bzl", "iree_execution_test_suite")
load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_binary",
)

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_cc_binary(
    name = "loom-compile",
    srcs = ["loom-compile.c"],
    deps = [
        "//loom/binding/c:loomc",
        "//loom/binding/c/target/configured",
        "//loom/src/loom/config:text_binding",
        "//loom/src/loom/sanitizer:options",
        "//loom/src/loom/tooling/cli:help",
        "//loom/src/loom/tooling/cli:loomc_options",
        "//loom/src/loom/tooling/cli:loomc_result",
        "//loom/src/loom/tooling/config:input",
        "//loom/src/loom/tooling/io:file",
        "//loom/src/loom/tooling/io:source_path",
        "//loom/src/loom/tooling/pass:trace_cli",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/tooling:flags",
    ],
)

iree_assert_dependency_boundary(
    name = "loom_compile_no_hal_runtime_dependencies",
    # The versioned, standalone library schema is a compiler interface. Runtime
    # implementations, including the task device and ELF loader, remain excluded.
    allowed_dependencies = ["//runtime/src/iree/hal/drivers/task/executable/library:abi"],
    forbidden_subtrees = ["//runtime/src/iree/hal/..."],
    message = "The compiler may consume the standalone executable ABI schema, but not HAL runtime implementations",
    target = ":loom-compile",
)

iree_execution_test_suite(
    name = "execution_test",
    manifests = ["loom-compile.test.json"],
    tags = ["hostonly"],
    tools = {
        "loom-compile": ":loom-compile",
    },
)
