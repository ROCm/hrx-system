      "name": "requires invocation target for AMDGPU HAL root without target attr",
      "steps": [
        {
          "name": "write-source",
          "write": {
            "path": "{tmp}/targetless_amdgpu.loom",
            "text": "kernel.def export(\"targetless_store_i32\") @targetless_store_i32() {\n  %unit = index.constant 1 : index\n  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index\n} launch(%output: buffer) {\n  %zero_offset = index.constant 0 : offset\n  %zero_index = index.constant 0 : index\n  %value = scalar.constant 42 : i32\n  %global = buffer.assume.memory_space<global> %output : buffer\n  %view = buffer.view %global[%zero_offset] : buffer -> view<1xi32, #dense>\n  view.store %value, %view[%zero_index] : i32, view<1xi32, #dense>\n  kernel.return\n}\n"
          }
        },
        {
          "name": "compile",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{tmp}/targetless_amdgpu.loom",
              "--backend=amdgpu-hal",
              "--output={tmp}/targetless_amdgpu.vmfb"
            ]
          },
          "exit": {
            "nonzero": true
          },
          "stderr": {
            "contains": [
              "HAL backend 'amdgpu-hal' requires --target= when 1 kernel.def root omit target(...) attrs"
            ]
          }
        }
      ]
