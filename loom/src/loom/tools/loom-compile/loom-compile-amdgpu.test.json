          "name": "write-source",
          "write": {
            "path": "{tmp}/bad_terminal_status_amdgpu.loom",
            "text": "kernel.def export(\"bad_terminal_status_kernel\") @bad_terminal_status_kernel() {\n  %unit = index.constant 1 : index\n  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index\n} launch(%output_handle: buffer, %lhs: i64, %rhs: i64) {\n  %c0_bytes = index.constant 0 : offset\n  %c0 = index.constant 0 : index\n  %layout = encoding.layout.dense : encoding<layout>\n  %remainder = scalar.remsi %lhs, %rhs : i64\n  %global = buffer.assume.memory_space<global> %output_handle : buffer\n  %output = buffer.view %global[%c0_bytes] : buffer -> view<1xi64, %layout>\n  view.store %remainder, %output[%c0] : i64, view<1xi64, %layout>\n  kernel.return\n}\n"
          }
        },
        {
          "name": "compile",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{tmp}/bad_terminal_status_amdgpu.loom",
              "--backend=amdgpu-hal",
              "--target=gfx11-generic",
              "--output={tmp}/unused.hsaco",
              "--compile-report=summary",
              "--compile-report-output=-"
