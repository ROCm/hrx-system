load("//build_tools/bazel:executable.bzl", "iree_wasi_executable_alias")
load("//loom/binding/c:shared.bzl", "loomc_cc_binary")
load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "iree_select",
    "loom_cc_library",
    "loom_cc_test",
    "loom_config_compatible_with",
    "loom_generated_file",
)

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_VM_EXECUTION_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/execute:vm_iree_vm",
])

_AMDGPU_TARGET_COPTS = iree_select({
    "//loom/config/execute:amdgpu_hal": [
        "-DLOOM_TEST_HAVE_AMDGPU=1",
    ],
    "//conditions:default": [],
})

_AMDGPU_TARGET_DEPS = iree_select({
    "//loom/config/execute:amdgpu_hal": [
        "//loom/binding/c/target/amdgpu:iree_hal",
        "//loom/src/loom/tooling/target/amdgpu:testbench_requirements",
    ],
    "//conditions:default": [],
})

_SPIRV_VULKAN_TARGET_COPTS = iree_select({
    "//loom/config/execute:spirv_vulkan_hal": [
        "-DLOOM_TEST_HAVE_SPIRV=1",
    ],
    "//conditions:default": [],
})

_SPIRV_VULKAN_TARGET_DEPS = iree_select({
    "//loom/config/execute:spirv_vulkan_hal": [
        "//loom/binding/c/target/spirv:iree_hal",
        "//loom/src/loom/tooling/target/spirv:testbench_requirements",
    ],
    "//conditions:default": [],
})

_XDNA_TARGET_COPTS = iree_select({
    "//loom/config/execute:aie2p_xdna_hal": ["-DLOOM_TEST_HAVE_XDNA=1"],
    "//conditions:default": [],
})

_XDNA_TARGET_DEPS = iree_select({
    "//loom/config/execute:aie2p_xdna_hal": [
        "//loom/binding/c/target/amd/xdna:iree_hal",
    ],
    "//conditions:default": [],
})

_VM_TARGET_COPTS = iree_select({
    "//loom/config/execute:vm_iree_vm": ["-DLOOM_TEST_HAVE_VM=1"],
    "//conditions:default": [],
})

_VM_TARGET_DEPS = iree_select({
    "//loom/config/execute:vm_iree_vm": [
        "//loom/src/loom/tooling/target/vm:testbench",
    ],
    "//conditions:default": [],
})

_WASM_TARGET_COPTS = iree_select({
    "//loom/config/execute:wasm_hosted": ["-DLOOM_TEST_HAVE_WASM=1"],
    "//conditions:default": [],
})

_WASM_TARGET_DEPS = iree_select({
    "//loom/config/execute:wasm_hosted": [
        "//loom/src/loom/tooling/target/wasm:testbench",
    ],
    "//conditions:default": [],
})

_LOOM_TEST_TARGET_COPTS = (
    _AMDGPU_TARGET_COPTS +
    _SPIRV_VULKAN_TARGET_COPTS +
    _XDNA_TARGET_COPTS +
    _VM_TARGET_COPTS +
    _WASM_TARGET_COPTS +
    iree_select({
        "//loom/config/execute:x86_task_hal": ["-DLOOM_TEST_HAVE_TASK=1"],
        "//conditions:default": [],
    })
)

_LOOM_TEST_TARGET_DEPS = (
    _AMDGPU_TARGET_DEPS +
    _SPIRV_VULKAN_TARGET_DEPS +
    _XDNA_TARGET_DEPS +
    _VM_TARGET_DEPS +
    _WASM_TARGET_DEPS +
    iree_select({
        "//loom/config/execute:x86_task_hal": ["//loom/binding/c/target/cpu:iree_hal"],
        "//conditions:default": [],
    })
)

loom_cc_library(
    name = "xfail",
    srcs = ["xfail.c"],
    hdrs = ["xfail.h"],
    visibility = ["//visibility:private"],
    deps = [
        "//loom/binding/c:loomc",
        "//loom/src/loom/error:diagnostic",
        "//loom/src/loom/error:error_defs",
        "//loom/src/loom/tooling/cli:loomc_result",
        "//loom/src/loom/tooling/testbench:api",
        "//loom/src/loom/tooling/testbench:expectation",
        "//loom/src/loom/util:json",
        "//runtime/src/iree/base",
    ],
)

loom_cc_test(
    name = "xfail_test",
    srcs = ["xfail_test.cc"],
    deps = [
        ":xfail",
        "//loom/src/loom/error:error_defs",
        "//loom/src/loom/tooling/testbench:api",
        "//loom/src/loom/tooling/testbench:expectation",
        "//loom/src/loom/util:json",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:json",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "main",
    srcs = [
        "main.c",
        "options.c",
        "run.c",
    ],
    hdrs = [
        "main.h",
        "options.h",
        "run.h",
    ],
    deps = [
        ":xfail",
        "//loom/binding/c:interop",
        "//loom/binding/c:loomc",
        "//loom/binding/c/target/iree_hal",
        "//loom/src/loom/config:text_binding",
        "//loom/src/loom/ops/check:op_defs",
        "//loom/src/loom/sanitizer:options",
        "//loom/src/loom/tooling/cli:help",
        "//loom/src/loom/tooling/cli:loomc_options",
        "//loom/src/loom/tooling/cli:loomc_result",
        "//loom/src/loom/tooling/config:input",
        "//loom/src/loom/tooling/execution/hal:scenario_profile",
        "//loom/src/loom/tooling/execution/hal:testbench_actual",
        "//loom/src/loom/tooling/input:flags",
        "//loom/src/loom/tooling/input:format",
        "//loom/src/loom/tooling/input:loomc",
        "//loom/src/loom/tooling/io:file",
        "//loom/src/loom/tooling/testbench:api",
        "//loom/src/loom/tooling/testbench:compiled_provider",
        "//loom/src/loom/tooling/testbench:device_event",
        "//loom/src/loom/tooling/testbench:executor",
        "//loom/src/loom/tooling/testbench:invocation",
        "//loom/src/loom/tooling/testbench:issue_report",
        "//loom/src/loom/tooling/testbench:reference",
        "//loom/src/loom/tooling/testbench:requirements",
        "//loom/src/loom/tooling/testbench/scenario:entropy",
        "//loom/src/loom/tooling/testbench/scenario:executor",
        "//loom/src/loom/tooling/testbench/scenario:values",
        "//loom/src/loom/util:json",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/base/internal:path",
        "//runtime/src/iree/base/tooling:flags",
        "//runtime/src/iree/hal/memory:heap_pool",
        "//runtime/src/iree/io:stream",
    ],
)

loom_generated_file(
    name = "library_cases_bytecode",
    testonly = True,
    args = [
        "$(rootpath //loom/src/loom/tools/loom-test/testdata:library_cases.loom)",
        "--mode=merge",
        "--to=bc",
    ],
    generator = "//loom/src/loom/tools/loom-link",
    inputs = ["//loom/src/loom/tools/loom-test/testdata:library_cases.loom"],
    output = "library_cases.loombc",
    output_flag = "--output=",
)

loom_generated_file(
    name = "file_cases_bytecode",
    testonly = True,
    args = [
        "$(rootpath //loom/src/loom/tools/loom-test/testdata:file_cases.loom)",
        "--mode=merge",
        "--to=bc",
    ],
    generator = "//loom/src/loom/tools/loom-link",
    inputs = ["//loom/src/loom/tools/loom-test/testdata:file_cases.loom"],
    output = "file_cases.loombc",
    output_flag = "--output=",
)

loom_generated_file(
    name = "linked_input_cases_bytecode",
    testonly = True,
    args = [
        "$(rootpath //loom/src/loom/tools/loom-test/testdata:linked_input_cases.loom)",
        "--mode=merge",
        "--to=bc",
    ],
    generator = "//loom/src/loom/tools/loom-link",
    inputs = ["//loom/src/loom/tools/loom-test/testdata:linked_input_cases.loom"],
    output = "linked_input_cases.loombc",
    output_flag = "--output=",
)

loom_cc_library(
    name = "scenario_test_provider",
    testonly = True,
    srcs = ["scenario_test_provider.c"],
    hdrs = ["scenario_test_provider.h"],
    visibility = ["//visibility:private"],
    deps = [
        ":main",
        "//loom/src/loom/ir",
        "//loom/src/loom/tooling/testbench:requirements",
        "//loom/src/loom/tooling/testbench/scenario:executor",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
    ],
)

loom_cc_test(
    name = "run_test",
    srcs = ["run_test.cc"],
    data = [
        ":file_cases_bytecode",
        ":library_cases_bytecode",
        ":linked_input_cases_bytecode",
        "//loom/src/loom/tooling/input/testdata:duplicate_symbols.loom-test",
        "//loom/src/loom/tooling/testbench/testdata:requirements.loom",
        "//loom/src/loom/tools/loom-test/testdata:file_cases.loom",
        "//loom/src/loom/tools/loom-test/testdata:library_cases.loom",
        "//loom/src/loom/tools/loom-test/testdata:linked_input_cases.loom",
        "//loom/src/loom/tools/loom-test/testdata:scalar_cases.loom",
        "//loom/src/loom/tools/loom-test/testdata:scenario_failures.loom",
        "//loom/src/loom/tools/loom-test/testdata:scenario_requirements.loom",
        "//loom/src/loom/tools/loom-test/testdata:xfail_cases.loom",
    ],
    env = {
        "LOOM_TEST_DUPLICATE_SOURCE": "$(rootpath //loom/src/loom/tooling/input/testdata:duplicate_symbols.loom-test)",
        "LOOM_TEST_FILE_BYTECODE": "$(rootpath :file_cases_bytecode)",
        "LOOM_TEST_FILE_SOURCE": "$(rootpath //loom/src/loom/tools/loom-test/testdata:file_cases.loom)",
        "LOOM_TEST_LIBRARY_BYTECODE": "$(rootpath :library_cases_bytecode)",
        "LOOM_TEST_LIBRARY_SOURCE": "$(rootpath //loom/src/loom/tools/loom-test/testdata:library_cases.loom)",
        "LOOM_TEST_LINKED_INPUT_BYTECODE": "$(rootpath :linked_input_cases_bytecode)",
        "LOOM_TEST_LINKED_INPUT_SOURCE": "$(rootpath //loom/src/loom/tools/loom-test/testdata:linked_input_cases.loom)",
        "LOOM_TEST_REQUIREMENTS_SOURCE": "$(rootpath //loom/src/loom/tooling/testbench/testdata:requirements.loom)",
        "LOOM_TEST_SCALAR_SOURCE": "$(rootpath //loom/src/loom/tools/loom-test/testdata:scalar_cases.loom)",
        "LOOM_TEST_SCENARIO_FAILURES_SOURCE": "$(rootpath //loom/src/loom/tools/loom-test/testdata:scenario_failures.loom)",
        "LOOM_TEST_SCENARIO_REQUIREMENTS_SOURCE": "$(rootpath //loom/src/loom/tools/loom-test/testdata:scenario_requirements.loom)",
        "LOOM_TEST_XFAIL_SOURCE": "$(rootpath //loom/src/loom/tools/loom-test/testdata:xfail_cases.loom)",
    },
    deps = [
        ":main",
        ":scenario_test_provider",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:json",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
        "//runtime/src/iree/testing:temp_file",
    ],
)

loom_cc_test(
    name = "vm_run_test",
    srcs = ["vm_run_test.cc"],
    data = [
        "//loom/src/loom/tooling/testbench/testdata:requirements.loom",
        "//loom/src/loom/tools/loom-test/testdata:scenario_cases.loom",
    ],
    env = {
        "LOOM_TEST_REQUIREMENTS_SOURCE": "$(rootpath //loom/src/loom/tooling/testbench/testdata:requirements.loom)",
        "LOOM_TEST_SCENARIO_SOURCE": "$(rootpath //loom/src/loom/tools/loom-test/testdata:scenario_cases.loom)",
    },
    target_compatible_with = _VM_EXECUTION_COMPATIBLE_WITH,
    deps = [
        ":main",
        "//loom/binding/c:loomc",
        "//loom/binding/c/target/configured",
        "//loom/src/loom/tooling/target/vm:testbench",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:json",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loomc_cc_binary(
    name = "loom-test",
    srcs = ["loom-test.c"],
    copts = _LOOM_TEST_TARGET_COPTS,
    deps = [
        ":main",
        "//loom/binding/c:loomc",
        "//loom/binding/c/target/configured",
        "//loom/src/loom/tooling/execution/hal:testbench_actual",
        "//loom/src/loom/tooling/input:loomc_configured",
        "//runtime/src/iree/base",
    ] + _LOOM_TEST_TARGET_DEPS,
)

# Hosts the ordinary CLI as a WASI module. The outer wrapper selects the
# JavaScript entry point; the C program never discovers or launches its host.
iree_wasi_executable_alias(
    name = "loom-test-wasi",
    src = ":loom-test",
    tags = [
        "manual",
        "skip-bazel_to_cmake",
    ],
    target_platform = "//loom/build_tools/bazel:loom_test_wasm32_wasi",
    wasm_main = "//build_tools/wasm:wasm_test_main.mjs",
)
