load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")
load("//loom/build_tools/bazel:python.bzl", "loom_py_test")

package(
    default_visibility = ["//visibility:private"],
    licenses = ["notice"],  # Apache 2.0
)

loom_py_test(
    name = "scenario_capture_test",
    size = "small",
    srcs = ["scenario_capture_test.py"],
    args = [
        "$(rootpath //loom/src/loom/tools/loom-test)",
        "$(rootpath :scenario_capture.loom)",
        "$(rootpath :scenario_replay.loom)",
    ],
    data = [
        "scenario_capture.loom",
        "scenario_replay.loom",
        "//loom/src/loom/tools/loom-test",
    ],
    main = "scenario_capture_test.py",
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/execute:vm_iree_vm",
    ]),
)
