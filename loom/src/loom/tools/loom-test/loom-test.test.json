{
  "version": 1,
  "cases": [
    {
      "name": "a rejected pipeline does not publish a test report",
      "run": {
        "tool": "loom-test",
        "args": [
          "{srcdir}/testdata/library_cases.loom",
          "--pipeline=not-a-pass"
        ]
      },
      "exit": 1,
      "stdout": {"empty": true},
      "stderr": {
        "non_empty": true,
        "not_contains": ["pass program preparation failed"]
      }
    },
    {
      "name": "rejects duplicate primary definitions before source library linking",
      "run": {
        "tool": "loom-test",
        "args": [
          "{srcdir}/../../tooling/input/testdata/duplicate_symbols.loom-test",
          "--library={srcdir}/testdata/library_cases.loom"
        ]
      },
      "exit": {
        "nonzero": true
      },
      "stdout": {
        "empty": true
      },
      "stderr": {
        "non_empty": true,
        "not_contains": [
          "source admission failed",
          "module linking failed"
        ]
      }
    },
    {
      "name": "rejects duplicate primary definitions before bytecode library linking",
      "steps": [
        {
          "name": "encode-library",
          "run": {
            "tool": "loom-link",
            "args": [
              "{srcdir}/testdata/library_cases.loom",
              "--mode=merge",
              "--to=bc",
              "--output={tmp}/library.loombc"
            ]
          }
        },
        {
          "name": "reject-input",
          "run": {
            "tool": "loom-test",
            "args": [
              "{srcdir}/../../tooling/input/testdata/duplicate_symbols.loom-test",
              "--library={tmp}/library.loombc"
            ]
          },
          "exit": {
            "nonzero": true
          },
          "stdout": {
            "empty": true
          },
          "stderr": {
            "non_empty": true,
            "not_contains": [
              "source admission failed",
              "module linking failed"
            ]
          }
        }
      ]
    },
    {
      "name": "rejects duplicate library definitions before discovering bytecode input cases",
      "steps": [
        {
          "name": "encode-input",
          "run": {
            "tool": "loom-link",
            "args": [
              "{srcdir}/testdata/linked_input_cases.loom",
              "--mode=merge",
              "--to=bc",
              "--output={tmp}/input.loombc"
            ]
          }
        },
        {
          "name": "reject-library",
          "run": {
            "tool": "loom-test",
            "args": [
              "{tmp}/input.loombc",
              "--library={srcdir}/../../tooling/input/testdata/duplicate_symbols.loom-test"
            ]
          },
          "exit": {
            "nonzero": true
          },
          "stdout": {
            "empty": true
          },
          "stderr": {
            "non_empty": true,
            "not_contains": [
              "source admission failed",
              "module linking failed"
            ]
          }
        }
      ]
    },
    {
      "name": "prints agent documentation",
      "run": {
        "tool": "loom-test",
        "args": ["--agents_md"]
      },
      "stdout": {
        "non_empty": true
      }
    },
    {
      "name": "runs selected sampled case",
      "run": {
        "tool": "loom-test",
        "args": [
          "{srcdir}/testdata/scalar_cases.loom",
          "--case=@sampled_choice",
          "--sanitizer=tsan",
          "--sanitizer-reporting=report-only",
          "--sample=1"
        ]
      },
      "stdout": {
        "contains": [
          "\"format\":\"loom.test.v0\"",
          "\"case_count\":1",
          "\"sample_count\":1",
          "\"failed_sample_count\":0",
          "\"skipped_case_count\":0",
          "\"case\":\"sampled_choice\",\"sample_ordinal\":1,\"passed\":true"
        ]
      }
    },
    {
      "name": "fails an expected rejection that unexpectedly passes",
      "run": {
        "tool": "loom-test",
        "args": [
          "{srcdir}/testdata/scalar_cases.loom",
          "--case=@sampled_choice",
          "--sample=1",
          "--xfail=@sampled_choice=TARGET/003"
        ]
      },
      "exit": {
        "nonzero": true
      },
      "stdout": {
        "contains": [
          "\"xfail_count\":0",
          "\"xpass_count\":1",
          "\"record\":\"@sampled_choice\",\"diagnostic\":\"TARGET/003\",\"outcome\":\"xpass\""
        ]
      }
    },
    {
      "name": "reports an unknown expected diagnostic as a mismatch",
      "run": {
        "tool": "loom-test",
        "args": [
          "{srcdir}/testdata/xfail_cases.loom",
          "--xfail=@equal_mismatch=EXPECT/999"
        ]
      },
      "exit": {
        "nonzero": true
      },
      "stdout": {
        "contains": [
          "\"xfail_count\":0",
          "\"xfail_mismatch_count\":1",
          "\"record\":\"@equal_mismatch\",\"diagnostic\":\"EXPECT/999\",\"outcome\":\"diagnostic_mismatch\",\"observed_diagnostic\":\"EXPECT/001\""
        ]
      }
    },
    {
      "name": "accepts an expected runtime check failure",
      "run": {
        "tool": "loom-test",
        "args": [
          "{srcdir}/testdata/xfail_cases.loom",
          "--xfail=@equal_mismatch=EXPECT/001"
        ]
      },
      "stdout": {
        "contains": [
          "\"failed_sample_count\":1",
          "\"xfail_count\":1",
          "\"xpass_count\":0",
          "\"xfail_mismatch_count\":0",
          "\"diagnostic\":\"EXPECT/001\"",
          "\"record\":\"@equal_mismatch\",\"diagnostic\":\"EXPECT/001\",\"outcome\":\"xfail\""
        ]
      }
    },
    {
      "name": "accepts any named expected diagnostic",
      "run": {
        "tool": "loom-test",
        "args": [
          "{srcdir}/testdata/xfail_cases.loom",
          "--xfail=@equal_mismatch=EXPECT/002,EXPECT/001"
        ]
      },
      "stdout": {
        "contains": [
          "\"xfail_count\":1",
          "\"xpass_count\":0",
          "\"record\":\"@equal_mismatch\",\"diagnostic\":\"EXPECT/002,EXPECT/001\",\"outcome\":\"xfail\",\"policy\":\"strict\""
        ]
      }
    },
    {
      "name": "allows a qualified record to pass",
      "run": {
        "tool": "loom-test",
        "args": [
          "{srcdir}/testdata/scalar_cases.loom",
          "--case=@sampled_choice",
          "--sample=1",
          "--allow-failure=@sampled_choice=TARGET/003"
        ]
      },
      "stdout": {
        "contains": [
          "\"xfail_count\":0",
          "\"xpass_count\":0",
          "\"xfail_mismatch_count\":0",
          "\"record\":\"@sampled_choice\",\"diagnostic\":\"TARGET/003\",\"outcome\":\"pass\",\"policy\":\"allow_failure\""
        ]
      }
    },
    {
      "name": "accepts an allowed failure with its named diagnostic",
      "run": {
        "tool": "loom-test",
        "args": [
          "{srcdir}/testdata/xfail_cases.loom",
          "--allow-failure=@equal_mismatch=EXPECT/001"
        ]
      },
      "stdout": {
        "contains": [
          "\"failed_sample_count\":1",
          "\"xfail_count\":1",
          "\"xpass_count\":0",
          "\"xfail_mismatch_count\":0",
          "\"record\":\"@equal_mismatch\",\"diagnostic\":\"EXPECT/001\",\"outcome\":\"xfail\",\"policy\":\"allow_failure\""
        ]
      }
    },
    {
      "name": "fails when an allowed failure diagnostic drifts",
      "run": {
        "tool": "loom-test",
        "args": [
          "{srcdir}/testdata/xfail_cases.loom",
          "--allow-failure=@equal_mismatch=EXPECT/002"
        ]
      },
      "exit": {
        "nonzero": true
      },
      "stdout": {
        "contains": [
          "\"xfail_count\":0",
          "\"xfail_mismatch_count\":1",
          "\"record\":\"@equal_mismatch\",\"diagnostic\":\"EXPECT/002\",\"outcome\":\"diagnostic_mismatch\",\"observed_diagnostic\":\"EXPECT/001\",\"policy\":\"allow_failure\""
        ]
      }
    },
    {
      "name": "fails when a runtime check diagnostic drifts",
      "run": {
        "tool": "loom-test",
        "args": [
          "{srcdir}/testdata/xfail_cases.loom",
          "--xfail=@equal_mismatch=EXPECT/002"
        ]
      },
      "exit": {
        "nonzero": true
      },
      "stdout": {
        "contains": [
          "\"xfail_count\":0",
          "\"xfail_mismatch_count\":1",
          "\"record\":\"@equal_mismatch\",\"diagnostic\":\"EXPECT/002\",\"outcome\":\"diagnostic_mismatch\",\"observed_diagnostic\":\"EXPECT/001\""
        ]
      }
    },
    {
      "name": "links explicit bytecode library into authored input",
      "steps": [
        {
          "name": "merge-library",
          "run": {
            "tool": "loom-link",
            "args": [
              "{srcdir}/testdata/library_cases.loom",
              "--mode=merge",
              "--to=bc",
              "--output={tmp}/library_cases.loombc"
            ]
          }
        },
        {
          "name": "run-linked-input",
          "run": {
            "tool": "loom-test",
            "args": [
              "{srcdir}/testdata/linked_input_cases.loom",
              "--library={tmp}/library_cases.loombc"
            ]
          },
          "stdout": {
            "contains": [
              "\"case_count\":2",
              "\"sample_count\":2",
              "\"failed_sample_count\":0",
              "\"case\":\"input_case\",\"sample_ordinal\":0,\"passed\":true",
              "\"case\":\"library_case\",\"sample_ordinal\":0,\"passed\":true"
            ]
          }
        }
      ]
    },
    {
      "name": "reports skipped requirements with stable codes",
      "run": {
        "tool": "loom-test",
        "args": [
          "{srcdir}/../../tooling/testbench/testdata/requirements.loom"
        ]
      },
      "stdout": {
        "contains": [
          "\"format\":\"loom.test.v0\"",
          "\"case_count\":3",
          "\"scenario_count\":3",
          "\"sample_count\":1",
          "\"failed_sample_count\":0",
          "\"trial_count\":2",
          "\"failed_trial_count\":0",
          "\"skipped_case_count\":2",
          "\"skipped_scenario_count\":2",
          "\"case\":\"missing_provider_requirement\",\"provider\":\"missing.provider\",\"op\":\"requires\",\"code\":\"provider_not_registered\"",
          "\"case\":\"missing_provider_skip_if\",\"provider\":\"missing.provider\",\"op\":\"skip_if\",\"code\":\"provider_not_registered\",\"display_message\":\"human skip display text\"",
          "\"scenario\":\"missing_scenario_requirement\",\"provider\":\"missing.provider\",\"op\":\"requires\",\"code\":\"provider_not_registered\"",
          "\"scenario\":\"missing_scenario_skip_if\",\"provider\":\"missing.provider\",\"op\":\"skip_if\",\"code\":\"provider_not_registered\",\"display_message\":\"scenario requires an available provider\""
        ],
        "not_contains": [
          "\"reason\""
        ]
      }
    },
    {
      "name": "publishes a checked tensor for a later invocation",
      "steps": [
        {
          "name": "reject-missing-output-root",
          "run": {
            "tool": "loom-test",
            "args": [
              "{srcdir}/testdata/file_cases.loom",
              "--case=@write_actual"
            ]
          },
          "exit": {
            "nonzero": true
          },
          "stderr": {
            "contains": ["check.file.write requires --file-output-root"]
          }
        },
        {
          "name": "encode-reader",
          "run": {
            "tool": "loom-link",
            "args": [
              "{srcdir}/testdata/file_cases.loom",
              "--mode=merge",
              "--to=bc",
              "--output={tmp}/reader.loombc"
            ]
          }
        },
        {
          "name": "write-actual",
          "run": {
            "tool": "loom-test",
            "args": [
              "{srcdir}/testdata/file_cases.loom",
              "--case=@write_actual",
              "--file-output-root={tmp}/outputs"
            ]
          },
          "stdout": {
            "contains": ["\"failed_sample_count\":0", "\"passed\":true"]
          },
          "files": [
            {
              "path": "{tmp}/outputs/nested/actual.npy",
              "non_empty": true
            }
          ]
        },
        {
          "name": "read-actual",
          "run": {
            "tool": "loom-test",
            "args": ["{tmp}/reader.loombc", "--case=@read_actual"]
          },
          "stdout": {
            "contains": ["\"failed_sample_count\":0", "\"passed\":true"]
          }
        },
        {
          "name": "reject-stdout-output-root",
          "run": {
            "tool": "loom-test",
            "args": [
              "{tmp}/reader.loombc",
              "--case=@read_actual",
              "--file-output-root=-"
            ]
          },
          "exit": {
            "nonzero": true
          },
          "stderr": {
            "contains": ["--file-output-root must name a directory, not '-'"]
          }
        }
      ]
    },
    {
      "name": "rejects an unavailable explicit device",
      "run": {
        "tool": "loom-test",
        "args": [
          "{srcdir}/testdata/scalar_cases.loom",
          "--device=loom-unavailable"
        ]
      },
      "exit": {
        "nonzero": true
      },
      "stderr": {
        "contains": [
          "--device=loom-unavailable",
          "not available in this Loom installation",
          "no linked LoomC target adapter"
        ]
      }
    },
    {
      "name": "a skipped scenario cannot satisfy xfail",
      "run": {
        "tool": "loom-test",
        "args": [
          "{srcdir}/../../tooling/testbench/testdata/requirements.loom",
          "--case=@missing_scenario_requirement",
          "--xfail=@missing_scenario_requirement=TARGET/001"
        ]
      },
      "exit": {
        "nonzero": true
      },
      "stdout": {
        "contains": [
          "\"trial_count\":0",
          "\"skipped_scenario_count\":1",
          "\"xfail_count\":0",
          "\"xpass_count\":0",
          "\"xfail_mismatch_count\":1",
          "\"outcome\":\"diagnostic_mismatch\""
        ]
      }
    },
    {
      "name": "a skipped scenario cannot satisfy allow-failure",
      "run": {
        "tool": "loom-test",
        "args": [
          "{srcdir}/../../tooling/testbench/testdata/requirements.loom",
          "--case=@missing_scenario_requirement",
          "--allow-failure=@missing_scenario_requirement=TARGET/001"
        ]
      },
      "exit": {
        "nonzero": true
      },
      "stdout": {
        "contains": [
          "\"trial_count\":0",
          "\"skipped_scenario_count\":1",
          "\"xfail_count\":0",
          "\"xpass_count\":0",
          "\"xfail_mismatch_count\":1",
          "\"outcome\":\"diagnostic_mismatch\""
        ]
      }
    }
  ]
}
