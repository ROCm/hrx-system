load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_cc_library(
    name = "native_emit",
    testonly = True,
    srcs = ["native_emit.c"],
    hdrs = ["native_emit.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//loom/src/loom/analysis:symbol_facts",
        "//loom/src/loom/codegen/low:frame",
        "//loom/src/loom/codegen/low:function",
        "//loom/src/loom/codegen/low:operand_ties",
        "//loom/src/loom/error:error_defs",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/ops/low:op_defs",
        "//loom/src/loom/rewrite:rewriter",
        "//loom/src/loom/tools/loom-check:execute",
        "//loom/src/loom/tools/loom-check/test:native_provider",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
    ],
)

loom_cc_library(
    name = "providers",
    testonly = True,
    srcs = [
        "allocation_query.c",
        "observations.c",
        "schedule_query.c",
    ],
    hdrs = ["providers.h"],
    visibility = ["//loom/src/loom/tools/loom-check:__pkg__"],
    deps = [
        ":native_emit",
        "//loom/src/loom/codegen/low:allocation",
        "//loom/src/loom/codegen/low:allocation_json",
        "//loom/src/loom/codegen/low:allocation_materialization",
        "//loom/src/loom/codegen/low:descriptors",
        "//loom/src/loom/codegen/low:diagnostics",
        "//loom/src/loom/codegen/low:frame",
        "//loom/src/loom/codegen/low:function",
        "//loom/src/loom/codegen/low:function_model",
        "//loom/src/loom/codegen/low:packet_json",
        "//loom/src/loom/codegen/low:storage_layout",
        "//loom/src/loom/codegen/low:storage_transport",
        "//loom/src/loom/codegen/low:text_asm",
        "//loom/src/loom/codegen/low/allocation:live_range",
        "//loom/src/loom/codegen/low/schedule",
        "//loom/src/loom/codegen/low/schedule:dependencies",
        "//loom/src/loom/codegen/low/schedule:json",
        "//loom/src/loom/format/text:printer",
        "//loom/src/loom/ir",
        "//loom/src/loom/target:low_packet_diagnostics",
        "//loom/src/loom/target:provider",
        "//loom/src/loom/target/reporting:format",
        "//loom/src/loom/target/reporting:low",
        "//loom/src/loom/tools/loom-check:execute",
        "//loom/src/loom/tools/loom-check/test:native_provider",
        "//runtime/src/iree/base",
    ],
)
