        "//loom/src/loom/analysis:storage_access",
        "//loom/src/loom/analysis:storage_interference",
        "//loom/src/loom/analysis/pipeline:arguments",
        "//loom/src/loom/analysis/pipeline:invocations",
        "//loom/src/loom/analysis/pipeline:resources",
        "//loom/src/loom/analysis/pipeline:schedule",
        "//loom/src/loom/analysis/pipeline:workers",
        "//loom/src/loom/codegen/low:diagnostics",
        "//loom/src/loom/error:error_defs",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/ops:type_registry",
        "//loom/src/loom/ops/buffer",
        "//loom/src/loom/ops/kernel",
        "//loom/src/loom/ops/pipeline",
        "//loom/src/loom/tools/loom-check:execute",
