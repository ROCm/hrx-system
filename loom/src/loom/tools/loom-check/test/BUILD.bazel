load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library")
load("//loom/build_tools/bazel:loom_check.bzl", "loom_check_test", "loom_check_test_suite")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],  # Apache 2.0
)

loom_cc_library(
    name = "native_provider",
    testonly = True,
    srcs = ["native_provider.c"],
    hdrs = ["native_provider.h"],
    deps = [
        "//loom/binding/c:interop",
        "//loom/binding/c:loomc",
        "//loom/src/loom/codegen/low:text_asm",
        "//loom/src/loom/error:emitter",
        "//loom/src/loom/error:source",
        "//loom/src/loom/ir",
        "//loom/src/loom/target:low_descriptor_registry",
        "//loom/src/loom/target:provider",
        "//loom/src/loom/tools/loom-check:execute",
        "//runtime/src/iree/base",
    ],
)

loom_check_test_suite(
    name = "core_test",
    srcs = [
        "checks.loom-test",
        "emit.loom-test",
        "low_asm.loom-test",
        "low_report.loom-test",
        "pass.loom-test",
        "requires.loom-test",
        "roundtrip.loom-test",
        "verify.loom-test",
    ],
)

# The shipping tool includes test dialect syntax without synthetic target
# passes. A non-idempotent path map also checks that diagnostics keep the case's
# logical identity instead of remapping it a second time during admission.
loom_check_test(
    name = "verify_tool",
    src = "verify.loom-test",
    args = ["--source-prefix-map==logical/"],
    runner = "//loom/src/loom/tools/loom-check:loom-check",
)

test_suite(
    name = "test",
    tests = [
        ":core_test",
        ":verify_tool",
    ],
)
