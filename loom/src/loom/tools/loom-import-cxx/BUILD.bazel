load("//build_tools/testing:build_defs.bzl", "iree_cli_test")
load("//loom/binding/c:shared.bzl", "loomc_cc_binary")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")

package(default_visibility = ["//visibility:public"])

loomc_cc_binary(
    name = "loom-import-cxx",
    srcs = ["loom-import-cxx.c"],
    deps = [
        "//loom/binding/c:loomc",
        "//loom/binding/c/import/cxx",
        "//loom/binding/c/target/configured:ir",
        "//loom/src/loom/import/cxx/tooling:options",
        "//loom/src/loom/tooling/cli:help",
        "//loom/src/loom/tooling/cli:loomc_result",
        "//loom/src/loom/tooling/io:file",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/base/tooling:flags",
    ],
)

iree_cli_test(
    name = "execution_test",
    manifests = ["loom-import-cxx.test.json"],
    tags = ["hostonly"],
    target_compatible_with = loom_config_compatible_with(["//loom/config/import:cxx"]),
    tools = {
        "loom-import-cxx": ":loom-import-cxx",
    },
)
