{
  "version": 1,
  "cases": [
    {
      "name": "logical identity and stripping survive source relocation",
      "steps": [
        {
          "name": "first-source",
          "write": {
            "path": "{tmp}/first.cxx",
            "text": "int sum(int left, int right) { return left + right; }\n"
          }
        },
        {
          "name": "relocated-source",
          "write": {
            "path": "{tmp}/relocated.cxx",
            "text": "// Sum two values.\n\nint sum(int a, int b) { return a + b; }\n"
          }
        },
        {
          "name": "first-import",
          "run": {
            "tool": "loom-import-cxx",
            "args": ["{tmp}/first.cxx", "--options=std=c++17", "--module-name=component.sum", "--strip-debug", "--to=bc", "--output={tmp}/first.loombc"]
          }
        },
        {
          "name": "relocated-import",
          "run": {
            "tool": "loom-import-cxx",
            "args": ["{tmp}/relocated.cxx", "--std=c++17", "--module-name=component.sum", "--strip-debug", "--to=bc", "--output={tmp}/relocated.loombc"]
          },
          "files": [{"path": "{tmp}/relocated.loombc", "equals": "{tmp}/first.loombc"}]
        }
      ]
    },
    {
      "name": "applies source flags and exports the selected root",
      "run": {
        "tool": "loom-import-cxx",
        "args": [
          "--std=c++17",
          "--fp-model=fast",
          "--D=BIAS=1.0f",
          "--root=second",
          "-"
        ]
      },
      "stdin": {
        "text": "#if __cplusplus != 201703L\n#error wrong standard\n#endif\nstatic float twice(float value) { return value * 2.0f; }\nfloat first(float value) { return value; }\nfloat second(float value) { return twice(value) + BIAS; }\n"
      },
      "stdout": {
        "contains": {
          "unordered": [
            "func.def public @second",
            "func.def @twice",
            "scalar.mulf<reassoc|nnan|ninf|nsz|arcp|contract|afn>",
            "scalar.constant 1.0"
          ]
        },
        "not_contains": ["@first"]
      }
    },
    {
      "name": "applies build-system provider options",
      "run": {
        "tool": "loom-import-cxx",
        "args": [
          "--options=std=c++17 fp-model=fast D='BIAS=1.0f' root=second",
          "-"
        ]
      },
      "stdin": {
        "text": "#if __cplusplus != 201703L\n#error wrong standard\n#endif\nstatic float twice(float value) { return value * 2.0f; }\nfloat first(float value) { return value; }\nfloat second(float value) { return twice(value) + BIAS; }\n"
      },
      "stdout": {
        "contains": {
          "unordered": [
            "func.def public @second",
            "func.def @twice",
            "scalar.mulf<reassoc|nnan|ninf|nsz|arcp|contract|afn>",
            "scalar.constant 1.0"
          ]
        },
        "not_contains": ["@first"]
      }
    },
    {
      "name": "reports syntax errors without an internal failure or output file",
      "run": {
        "tool": "loom-import-cxx",
        "args": ["--to=bc", "--output={tmp}/rejected.loombc", "-"]
      },
      "stdin": {"text": "int broken() { return 42 }\n"},
      "exit": {"code": 1},
      "stdout": {"empty": true},
      "stderr": {
        "contains": [
          "-:1:26: error [PARSE/036]: expected ';'",
          "int broken() { return 42 }",
          "^"
        ],
        "not_contains": ["INVALID_ARGUMENT", "C/C++ source rejected", "stack:"]
      },
      "files": [{"path": "{tmp}/rejected.loombc", "exists": false}]
    },
    {
      "name": "shows where to move helper-owned workgroup storage",
      "run": {"tool": "loom-import-cxx", "args": ["-"]},
      "stdin": {"text": "int* workspace() {\n  [[loom::workgroup]] int tile[64];\n  return tile;\n}\n"},
      "exit": {"code": 1},
      "stderr": {
        "contains": [
          "-:2:27: error [LOWERING/075]: a helper cannot declare workgroup storage 'tile'",
          "  [[loom::workgroup]] int tile[64];",
          "^^^^",
          "= help: Declare 'tile' in the kernel and pass it to the helper by pointer"
        ]
      }
    },
    {
      "name": "reports invalid command-line values",
      "run": {
        "tool": "loom-import-cxx",
        "args": ["--data-model=wide", "-"]
      },
      "exit": {"code": 1},
      "stdout": {"empty": true},
      "stderr": {
        "contains": ["INVALID_ARGUMENT", "unknown source data model 'wide'"]
      }
    }
  ]
}
