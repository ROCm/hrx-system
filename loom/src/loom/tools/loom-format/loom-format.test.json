{
  "version": 1,
  "cases": [
    {
      "name": "invalid input does not create a bytecode output file",
      "run": {
        "tool": "loom-format",
        "args": [
          "{srcdir}/../../tooling/input/testdata/duplicate_symbols.loom-test",
          "--to=bc",
          "--output={tmp}/duplicate.loombc"
        ]
      },
      "exit": {"nonzero": true},
      "stdout": {"empty": true},
      "stderr": {
        "non_empty": true,
        "not_contains": [
          "invalid input module"
        ]
      },
      "files": [{"path": "{tmp}/duplicate.loombc", "exists": false}]
    },
    {
      "name": "prints agent documentation",
      "run": {
        "tool": "loom-format",
        "args": ["--agents_md"]
      },
      "stdout": {"non_empty": true}
    },
    {
      "name": "checks every batch input and reports failures",
      "steps": [
        {
          "name": "write-canonical-source",
          "write": {
            "path": "{tmp}/canonical.loom",
            "text": "// Copyright Example Authors\n// SPDX-License-Identifier: MIT\n\n// File-level overview.\n\nfunc.def @identity(%value: index) -> (index) {\n  func.return %value : index\n}\n"
          }
        },
        {
          "name": "write-portable-command-source",
          "write": {
            "path": "{tmp}/portable.loom",
            "text": "low.func.def target<cmd.core> abi(command_program) @empty() asm {\n  return\n}\n"
          }
        },
        {
          "name": "write-target-test-container",
          "write": {
            "path": "{tmp}/target.loom-test",
            "text": "// RUN: verify\n\ntest.target<low_core> @test_target\n\nlow.func.def target<test.low.core>(@test_target) @add(%lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>) asm {\n  %sum = test.add.i32 %lhs, %rhs\n  return %sum\n}\n"
          }
        },
        {
          "name": "write-annotated-invalid-test-container",
          "write": {
            "path": "{tmp}/annotated-invalid.loom-test",
            "text": "// RUN: verify\n\n// ERROR@+1: TYPE/003 {operand_name=\"predicates[0].arg[0]\", actual_type=\"f32\", expected_constraint=\"integer, index, or offset scalar\"}\nfunc.def @invalid(%value: f32) where [eq(%value, 4)] {\n  func.return\n}\n"
          }
        },
        {
          "name": "write-noncanonical-source",
          "write": {
            "path": "{tmp}/noncanonical.loom",
            "text": "\nfunc.def @noncanonical(%value: index) -> (index) {\n  func.return %value : index\n}\n"
          }
        },
        {
          "name": "write-invalid-source",
          "write": {
            "path": "{tmp}/invalid.loom",
            "text": "func.def @invalid(%value: index) -> (index) {\n  %result = func.call @missing(%value) : (index) -> (index)\n  func.return %result : index\n}\n"
          }
        },
        {
          "name": "check",
          "run": {
            "tool": "loom-format",
            "args": [
              "--check",
              "{tmp}/canonical.loom",
              "{tmp}/portable.loom",
              "{tmp}/target.loom-test",
              "{tmp}/annotated-invalid.loom-test",
              "{tmp}/noncanonical.loom",
              "{tmp}/invalid.loom"
            ]
          },
          "exit": {"nonzero": true},
          "stdout": {"empty": true},
          "stderr": {
            "contains": [
              "noncanonical.loom' is not canonically formatted",
              "invalid.loom",
              "loom-format: FAIL (6 checked, 2 failed)"
            ]
          }
        }
      ]
    },
    {
      "name": "formats files and preserves rejected inputs",
      "steps": [
        {
          "name": "write-expected-target-source",
          "write": {
            "path": "{tmp}/expected-target.loom",
            "text": "test.target<low_core> @target\n\nlow.func.def target<test.low.core>(@target) @identity(%value: reg<test.i32>) -> (reg<test.i32>) asm {\n  return %value\n}\n"
          }
        },
        {
          "name": "encode-target-source",
          "run": {
            "tool": "loom-format",
            "args": [
              "--from=text",
              "--to=bc",
              "--output={tmp}/target.loombc"
            ]
          },
          "stdin": {"file": "{tmp}/expected-target.loom"},
          "stdout": {"empty": true},
          "stderr": {"empty": true}
        },
        {
          "name": "write-noncanonical-source",
          "write": {
            "path": "{tmp}/noncanonical.loom",
            "text": "\nfunc.def @noncanonical(%value: index) -> (index) {\n  func.return %value : index\n}\n"
          }
        },
        {
          "name": "write-expected-canonical-source",
          "write": {
            "path": "{tmp}/expected-canonical.loom",
            "text": "func.def @noncanonical(%value: index) -> (index) {\n  func.return %value : index\n}\n"
          }
        },
        {
          "name": "write-canonical-source",
          "write": {
            "path": "{tmp}/canonical.loom",
            "text": "func.def @canonical(%value: i32) -> (i32) {\n  func.return %value : i32\n}\n"
          }
        },
        {
          "name": "write-test-container",
          "write": {
            "path": "{tmp}/source.loom-test",
            "text": "// RUN: verify\n\nfunc.def @identity(%value:index)->(index){\nfunc.return %value:index\n}\n\n// Input commentary remains attached to the container.\n\n// ----\npurposefully  noncanonical expected output\n"
          }
        },
        {
          "name": "write-expected-test-container",
          "write": {
            "path": "{tmp}/expected-source.loom-test",
            "text": "// RUN: verify\n\nfunc.def @identity(%value: index) -> (index) {\n  func.return %value : index\n}\n\n// Input commentary remains attached to the container.\n\n// ----\npurposefully  noncanonical expected output\n"
          }
        },
        {
          "name": "write-invalid-source",
          "write": {
            "path": "{tmp}/invalid.loom",
            "text": "func.def @invalid(%value: index) -> (index) {\n  %result = func.call @missing(%value) : (index) -> (index)\n  func.return %result : index\n}\n"
          }
        },
        {
          "name": "write-expected-invalid-source",
          "write": {
            "path": "{tmp}/expected-invalid.loom",
            "text": "func.def @invalid(%value: index) -> (index) {\n  %result = func.call @missing(%value) : (index) -> (index)\n  func.return %result : index\n}\n"
          }
        },
        {
          "name": "format",
          "run": {
            "tool": "loom-format",
            "args": [
              "--in-place",
              "{tmp}/noncanonical.loom",
              "{tmp}/canonical.loom",
              "{tmp}/source.loom-test",
              "{tmp}/invalid.loom",
              "{tmp}/target.loombc"
            ]
          },
          "exit": {"nonzero": true},
          "stdout": {
            "contains": [
              "loom-format: formatted",
              "noncanonical.loom",
              "loom-format: formatted",
              "source.loom-test"
            ]
          },
          "stderr": {
            "contains": [
              "invalid.loom",
              "target.loombc' contains bc",
              "loom-format: 2 formatted, 1 unchanged, 2 failed"
            ]
          },
          "files": [
            {
              "path": "{tmp}/noncanonical.loom",
              "equals": "{tmp}/expected-canonical.loom"
            },
            {
              "path": "{tmp}/source.loom-test",
              "equals": "{tmp}/expected-source.loom-test"
            },
            {
              "path": "{tmp}/invalid.loom",
              "equals": "{tmp}/expected-invalid.loom"
            },
            {"path": "{tmp}/target.loombc", "non_empty": true}
          ]
        },
        {
          "name": "decode-target-source",
          "run": {
            "tool": "loom-format",
            "args": [
              "--from=bc",
              "--to=text",
              "{tmp}/target.loombc"
            ]
          },
          "stdout": {"save": "{tmp}/actual-target.loom"},
          "stderr": {"empty": true},
          "files": [
            {
              "path": "{tmp}/actual-target.loom",
              "equals": "{tmp}/expected-target.loom"
            }
          ]
        }
      ]
    },
    {
      "name": "requires an input file for in-place formatting",
      "run": {
        "tool": "loom-format",
        "args": ["--in-place"]
      },
      "exit": {"nonzero": true},
      "stderr": {
        "contains": ["--in-place requires at least one input file"]
      }
    },
    {
      "name": "rejects conflicting maintenance modes",
      "run": {
        "tool": "loom-format",
        "args": ["--check", "--in-place"]
      },
      "exit": {"nonzero": true},
      "stderr": {
        "contains": ["--check and --in-place are mutually exclusive"]
      }
    }
  ]
}
