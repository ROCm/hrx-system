{
  "version": 1,
  "cases": [
    {
      "name": "prints agent documentation",
      "run": {
        "tool": "loom-format",
        "args": ["--agents_md"]
      },
      "stdout": {
        "contains": {
          "unordered": [
            "## loom-format",
            "--from=text",
            "--to=bc",
            "--from=auto",
            "--check",
            "loom-link --library"
          ]
        }
      }
    },
    {
      "name": "accepts canonical text in check mode",
      "run": {
        "tool": "loom-format",
        "args": ["--check"]
      },
      "stdin": {
        "text": "func.def @identity(%value: index) -> (index) {\n  func.return %value : index\n}\n"
      },
      "stdout": {
        "empty": true
      }
    },
    {
      "name": "rejects noncanonical text in check mode",
      "run": {
        "tool": "loom-format",
        "args": ["--check"]
      },
      "stdin": {
        "text": "\nfunc.def @identity(%value: index) -> (index) {\n  func.return %value : index\n}\n"
      },
      "exit": {
        "nonzero": true
      },
      "stderr": {
        "contains": ["is not canonically formatted"]
      }
    },
    {
      "name": "accepts canonical generic target-low text in check mode",
      "run": {
        "tool": "loom-format",
        "args": ["--check"]
      },
      "stdin": {
        "text": "llvmir.target<object> @target {triple = \"amdgcn-amd-amdhsa\"}\n\nlow.kernel.def target<llvmir.generic.core>(@target) workgroup_size(64, 1, 1) @dispatch() {\n  %input = low.resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<llvmir.ptr>\n  %value = low.op<llvmir.load.i32>(%input) {byte_offset = 4} : (reg<llvmir.ptr>) -> reg<llvmir.i32>\n  low.return\n}\n"
      },
      "stdout": {
        "empty": true
      }
    },
    {
      "name": "diagnoses unresolved symbol before bytecode output",
      "run": {
        "tool": "loom-format",
        "args": [
          "--from=text",
          "--to=bc",
          "--output={tmp}/invalid.loombc"
        ]
      },
      "stdin": {
        "text": "func.def @caller(%value: index) -> (index) {\n  %result = func.call @external_identity(%value) : (index) -> (index)\n  func.return %result : index\n}\n"
      },
      "exit": {
        "nonzero": true
      },
      "stderr": {
        "contains": [
          "error [SYMBOL/002]: symbol '@external_identity' is referenced but not defined"
        ]
      }
    }
  ]
}
