{
  "version": 1,
  "cases": [
    {
      "name": "invalid input does not create a bytecode output file",
      "run": {
        "tool": "loom-format",
        "args": [
          "{srcdir}/../../tooling/input/testdata/duplicate_symbols.loom-test",
          "--to=bc",
          "--output={tmp}/duplicate.loombc"
        ]
      },
      "exit": {
        "nonzero": true
      },
      "stdout": {
        "empty": true
      },
      "stderr": {
        "non_empty": true
      },
      "files": [{"path": "{tmp}/duplicate.loombc", "exists": false}]
    },
    {
      "name": "prints agent documentation",
      "run": {
        "tool": "loom-format",
        "args": ["--agents_md"]
      },
      "stdout": {
        "non_empty": true
      }
    },
    {
      "name": "accepts canonical text in check mode",
      "run": {
        "tool": "loom-format",
        "args": ["--check"]
      },
      "stdin": {
        "text": "func.def @identity(%value: index) -> (index) {\n  func.return %value : index\n}\n"
      },
      "stdout": {
        "empty": true
      }
    },
    {
      "name": "checks multiple canonical text files",
      "steps": [
        {
          "name": "write-first-source",
          "write": {
            "path": "{tmp}/first.loom",
            "text": "func.def @first(%value: index) -> (index) {\n  func.return %value : index\n}\n"
          }
        },
        {
          "name": "write-second-source",
          "write": {
            "path": "{tmp}/second.loom",
            "text": "func.def @second(%value: i32) -> (i32) {\n  func.return %value : i32\n}\n"
          }
        },
        {
          "name": "check",
          "run": {
            "tool": "loom-format",
            "args": [
              "--check",
              "{tmp}/first.loom",
              "{tmp}/second.loom"
            ]
          },
          "stdout": {
            "contains": ["loom-format: PASS (2 checked, 0 failed)"]
          },
          "stderr": {
            "empty": true
          }
        }
      ]
    },
    {
      "name": "formats multiple verified text files in place",
      "steps": [
        {
          "name": "write-noncanonical-source",
          "write": {
            "path": "{tmp}/noncanonical.loom",
            "text": "\nfunc.def @noncanonical(%value: index) -> (index) {\n  func.return %value : index\n}\n"
          }
        },
        {
          "name": "write-canonical-source",
          "write": {
            "path": "{tmp}/canonical.loom",
            "text": "func.def @canonical(%value: i32) -> (i32) {\n  func.return %value : i32\n}\n"
          }
        },
        {
          "name": "format",
          "run": {
            "tool": "loom-format",
            "args": [
              "--in-place",
              "{tmp}/noncanonical.loom",
              "{tmp}/canonical.loom"
            ]
          },
          "stdout": {
            "contains": [
              "loom-format: formatted",
              "loom-format: 1 formatted, 1 unchanged, 0 failed"
            ]
          },
          "stderr": {
            "empty": true
          }
        },
        {
          "name": "check",
          "run": {
            "tool": "loom-format",
            "args": [
              "--check",
              "{tmp}/noncanonical.loom",
              "{tmp}/canonical.loom"
            ]
          },
          "stdout": {
            "contains": ["loom-format: PASS (2 checked, 0 failed)"]
          },
          "stderr": {
            "empty": true
          }
        }
      ]
    },
    {
      "name": "formats loom test inputs and preserves container sections",
      "steps": [
        {
          "name": "write-test-container",
          "write": {
            "path": "{tmp}/source.loom-test",
            "text": "// RUN: verify\n\nfunc.def @identity(%value:index)->(index){\nfunc.return %value:index\n}\n\n// Input commentary remains attached to the container.\n\n// ----\npurposefully  noncanonical expected output\n"
          }
        },
        {
          "name": "format",
          "run": {
            "tool": "loom-format",
            "args": ["--in-place", "{tmp}/source.loom-test"]
          },
          "stdout": {
            "contains": ["loom-format: 1 formatted, 0 unchanged, 0 failed"]
          },
          "stderr": {
            "empty": true
          }
        },
        {
          "name": "check",
          "run": {
            "tool": "loom-format",
            "args": ["--check", "{tmp}/source.loom-test"]
          },
          "stdout": {
            "empty": true
          },
          "stderr": {
            "empty": true
          }
        }
      ]
    },
    {
      "name": "checks synthetic target loom test inputs",
      "steps": [
        {
          "name": "write-test-container",
          "write": {
            "path": "{tmp}/target.loom-test",
            "text": "// RUN: verify\n\ntest.target<low_core> @test_target\n\nlow.func.def target<test.low.core>(@test_target) @add(%lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>) asm {\n  %sum = test.add.i32 %lhs, %rhs\n  return %sum\n}\n"
          }
        },
        {
          "name": "check",
          "run": {
            "tool": "loom-format",
            "args": ["--check", "{tmp}/target.loom-test"]
          },
          "stdout": {
            "empty": true
          },
          "stderr": {
            "empty": true
          }
        }
      ]
    },
    {
      "name": "preserves annotated invalid fixtures through compiler results",
      "steps": [
        {
          "name": "write-test-container",
          "write": {
            "path": "{tmp}/invalid.loom-test",
            "text": "// RUN: verify\n\n// ERROR@+1: TYPE/003 {operand_name=\"predicates[0].arg[0]\", actual_type=\"f32\", expected_constraint=\"integer, index, or offset scalar\"}\nfunc.def @invalid(%value: f32) where [eq(%value, 4)] {\n  func.return\n}\n"
          }
        },
        {
          "name": "check",
          "run": {
            "tool": "loom-format",
            "args": ["--check", "{tmp}/invalid.loom-test"]
          },
          "stdout": {"empty": true},
          "stderr": {"empty": true}
        }
      ]
    },
    {
      "name": "round trips synthetic target assembly through bytecode",
      "steps": [
        {
          "name": "write-expected",
          "write": {
            "path": "{tmp}/expected.loom",
            "text": "test.target<low_core> @target\n\nlow.func.def target<test.low.core>(@target) @identity(%value: reg<test.i32>) -> (reg<test.i32>) asm {\n  return %value\n}\n"
          }
        },
        {
          "name": "encode",
          "run": {
            "tool": "loom-format",
            "args": ["--to=bc", "--output={tmp}/target.loombc"]
          },
          "stdin": {
            "text": "test.target<low_core> @target\n\nlow.func.def target<test.low.core>(@target) @identity(%value: reg<test.i32>) -> (reg<test.i32>) asm {\n  return %value\n}\n"
          }
        },
        {
          "name": "decode",
          "run": {
            "tool": "loom-format",
            "args": ["--to=text", "{tmp}/target.loombc"]
          },
          "stdout": {"save": "{tmp}/actual.loom"},
          "stderr": {"empty": true},
          "files": [{"path": "{tmp}/actual.loom", "equals": "{tmp}/expected.loom"}]
        }
      ]
    },
    {
      "name": "checks portable command low IR",
      "run": {
        "tool": "loom-format",
        "args": ["--check"]
      },
      "stdin": {
        "text": "low.func.def target<cmd.core> abi(command_program) @empty() asm {\n  return\n}\n"
      },
      "stdout": {
        "empty": true
      },
      "stderr": {
        "empty": true
      }
    },
    {
      "name": "reports every batch check failure",
      "steps": [
        {
          "name": "write-noncanonical-source",
          "write": {
            "path": "{tmp}/noncanonical.loom",
            "text": "\nfunc.def @noncanonical(%value: index) -> (index) {\n  func.return %value : index\n}\n"
          }
        },
        {
          "name": "write-invalid-source",
          "write": {
            "path": "{tmp}/invalid.loom",
            "text": "func.def @invalid(%value: index) -> (index) {\n  %result = func.call @missing(%value) : (index) -> (index)\n  func.return %result : index\n}\n"
          }
        },
        {
          "name": "check",
          "run": {
            "tool": "loom-format",
            "args": [
              "--check",
              "{tmp}/noncanonical.loom",
              "{tmp}/invalid.loom"
            ]
          },
          "exit": {
            "nonzero": true
          },
          "stderr": {
            "contains": [
              "noncanonical.loom' is not canonically formatted",
              "loom-format: FAIL (2 checked, 2 failed)"
            ]
          }
        }
      ]
    },
    {
      "name": "does not rewrite an invalid in-place input",
      "steps": [
        {
          "name": "write-invalid-source",
          "write": {
            "path": "{tmp}/invalid.loom",
            "text": "func.def @invalid(%value: index) -> (index) {\n  %result = func.call @missing(%value) : (index) -> (index)\n  func.return %result : index\n}\n"
          }
        },
        {
          "name": "format",
          "run": {
            "tool": "loom-format",
            "args": ["--in-place", "{tmp}/invalid.loom"]
          },
          "exit": {
            "nonzero": true
          },
          "stderr": {
            "contains": [
              "loom-format: 0 formatted, 0 unchanged, 1 failed"
            ]
          }
        },
        {
          "name": "format-again",
          "run": {
            "tool": "loom-format",
            "args": ["--in-place", "{tmp}/invalid.loom"]
          },
          "exit": {
            "nonzero": true
          },
          "stderr": {
            "contains": [
              "loom-format: 0 formatted, 0 unchanged, 1 failed"
            ]
          }
        }
      ]
    },
    {
      "name": "requires an input file for in-place formatting",
      "run": {
        "tool": "loom-format",
        "args": ["--in-place"]
      },
      "exit": {
        "nonzero": true
      },
      "stderr": {
        "contains": ["--in-place requires at least one input file"]
      }
    },
    {
      "name": "rejects conflicting maintenance modes",
      "run": {
        "tool": "loom-format",
        "args": ["--check", "--in-place"]
      },
      "exit": {
        "nonzero": true
      },
      "stderr": {
        "contains": ["--check and --in-place are mutually exclusive"]
      }
    },
    {
      "name": "does not rewrite bytecode in place",
      "steps": [
        {
          "name": "write-source",
          "write": {
            "path": "{tmp}/source.loom",
            "text": "func.def @identity(%value: index) -> (index) {\n  func.return %value : index\n}\n"
          }
        },
        {
          "name": "encode",
          "run": {
            "tool": "loom-format",
            "args": [
              "--from=text",
              "--to=bc",
              "--output={tmp}/source.loombc",
              "{tmp}/source.loom"
            ]
          }
        },
        {
          "name": "format",
          "run": {
            "tool": "loom-format",
            "args": ["--in-place", "{tmp}/source.loombc"]
          },
          "exit": {
            "nonzero": true
          },
          "stderr": {
            "contains": [
              "--in-place requires text input",
              "contains bc",
              "loom-format: 0 formatted, 0 unchanged, 1 failed"
            ]
          }
        },
        {
          "name": "decode",
          "run": {
            "tool": "loom-format",
            "args": [
              "--from=bc",
              "--to=text",
              "{tmp}/source.loombc"
            ]
          },
          "stdout": {
            "non_empty": true
          }
        }
      ]
    },
    {
      "name": "rejects noncanonical text in check mode",
      "run": {
        "tool": "loom-format",
        "args": ["--check"]
      },
      "stdin": {
        "text": "\nfunc.def @identity(%value: index) -> (index) {\n  func.return %value : index\n}\n"
      },
      "exit": {
        "nonzero": true
      },
      "stderr": {
        "contains": ["is not canonically formatted"]
      }
    }
  ]
}
