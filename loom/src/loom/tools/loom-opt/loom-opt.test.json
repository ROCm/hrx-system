{
  "version": 1,
  "cases": [
    {
      "name": "prints agent documentation",
      "run": {
        "tool": "loom-opt",
        "args": ["--agents_md"]
      },
      "stdout": {
        "non_empty": true
      }
    },
    {
      "name": "lists registered passes",
      "run": {
        "tool": "loom-opt",
        "args": ["--list-passes"]
      },
      "stdout": {
        "contains": {
          "unordered": [
            "branch-fusion",
            "canonicalize",
            "cse",
            "dce",
            "source-to-low",
            "symbol-dce",
            "vector-to-scalar"
          ]
        }
      }
    },
    {
      "name": "prints pass help",
      "run": {
        "tool": "loom-opt",
        "args": ["--pass-help=canonicalize"]
      },
      "stdout": {
        "contains": [
          "canonicalize",
          "kind: func",
          "options:",
          "max-iterations: uint32 [1..4294967295]"
        ]
      }
    },
    {
      "name": "reads bytecode from stdin by magic",
      "steps": [
        {
          "name": "encode",
          "run": {
            "tool": "loom-format",
            "args": ["--from=text", "--to=bc"]
          },
          "stdin": {
            "text": "func.def @bytecode_identity(%value: i32) -> (i32) {\n  func.return %value : i32\n}\n"
          },
          "stdout": {"non_empty": true},
          "stderr": {"empty": true}
        },
        {
          "name": "optimize",
          "run": {
            "tool": "loom-opt"
          },
          "stdin": {"step_stdout": "encode"},
          "stdout": {
            "contains": [
              "func.def @bytecode_identity(%value: i32) -> (i32) {",
              "func.return %value : i32"
            ]
          },
          "stderr": {"empty": true}
        }
      ]
    },
    {
      "name": "writes parse failures as one JSONL diagnostic",
      "run": {
        "tool": "loom-opt",
        "args": ["--diagnostic-format=json"]
      },
      "stdin": {
        "text": "func.def @bad( {\n"
      },
      "exit": 1,
      "stdout": {"empty": true},
      "stderr": {
        "contains": [
          {
            "regex": "^\\{\"severity\":\"error\".*\"message\":\"unexpected token.*\".*\\}$"
          }
        ],
        "not_contains": ["INVALID_ARGUMENT", "stack:"]
      }
    },
    {
      "name": "writes verifier failures as one JSONL diagnostic",
      "run": {
        "tool": "loom-opt",
        "args": ["--diagnostic-format=json"]
      },
      "stdin": {
        "text": "func.def @bad() -> (i32) {\n  func.return\n}\n"
      },
      "exit": 1,
      "stdout": {"empty": true},
      "stderr": {
        "contains": [
          {
            "regex": "^\\{\"severity\":\"error\".*\"emitter\":\"verifier\".*\"message\":\"yield has 0 operands, expected 1\".*\\}$"
          }
        ],
        "not_contains": ["INVALID_ARGUMENT", "stack:"]
      }
    },
    {
      "name": "skips verification when requested",
      "run": {
        "tool": "loom-opt",
        "args": ["--verify=false"]
      },
      "stdin": {
        "text": "func.def @unverified() -> (i32) {\n  func.return\n}\n"
      },
      "stdout": {
        "contains": [
          "func.def @unverified() -> (i32) {",
          "func.return"
        ]
      },
      "stderr": {"empty": true}
    },
    {
      "name": "runs canonicalize and dce pipeline",
      "run": {
        "tool": "loom-opt",
        "args": [
          "--pass=canonicalize{max-iterations=2}",
          "--pass=dce"
        ],
        "stdin": {
          "text": "func.def @dce_single(%x: i32) -> (i32) {\n  %dead = scalar.constant 42 : i32\n  func.return %x : i32\n}\n"
        }
      },
      "stdout": {
        "contains": [
          "func.def @dce_single(%x: i32) -> (i32) {",
          "func.return %x : i32"
        ],
        "not_contains": ["%dead"]
      }
    },
    {
      "name": "roundtrips portable command low IR",
      "run": {
        "tool": "loom-opt"
      },
      "stdin": {
        "text": "low.func.def target<cmd.core> abi(command_program) @empty() asm {\n  return\n}\n"
      },
      "stdout": {
        "contains": [
          "low.func.def target<cmd.core> abi(command_program) @empty() {",
          "low.return"
        ]
      },
      "stderr": {
        "empty": true
      }
    },
    {
      "name": "dumps selected pass IR as JSONL",
      "run": {
        "tool": "loom-opt",
        "args": [
          "--pass=dce",
          "--dump-ir-after=pipeline-text",
          "--dump-ir-format=jsonl",
          "--dump-ir-output=stderr",
          "--output={tmp}/dumped.loom"
        ],
        "stdin": {
          "text": "func.def @trace_smoke(%x: i32) -> (i32) {\n  func.return %x : i32\n}\n"
        }
      },
      "stderr": {
        "contains": [
          "\"tool\":\"loom-opt\"",
          "\"stage\":\"pipeline-text\"",
          "\"pass\":\"dce\"",
          "\"point\":\"after\"",
          "\"ir\":\""
        ]
      },
      "files": [
        {
          "path": "{tmp}/dumped.loom",
          "non_empty": true
        }
      ]
    },
    {
      "name": "rejects result and pass trace output sharing stdout",
      "run": {
        "tool": "loom-opt",
        "args": [
          "--output=stdout",
          "--dump-ir-after-all",
          "--dump-ir-output=-"
        ]
      },
      "exit": 1,
      "stdout": {"empty": true},
      "stderr": {
        "contains": [
          "--output and --dump-ir-output cannot both write to stdout"
        ]
      }
    },
    {
      "name": "dumps function pass IR as whole-module JSONL",
      "run": {
        "tool": "loom-opt",
        "args": [
          "--pipeline=@trace_pipeline",
          "--dump-ir-after=pipeline-symbol",
          "--dump-ir-format=jsonl",
          "--dump-ir-output=stderr",
          "--output={tmp}/dumped-whole-module.loom"
        ],
        "stdin": {
          "text": "pass.pipeline<module> @trace_pipeline pipeline {\n  for func {\n    dce\n  }\n}\n\nfunc.def @first(%x: i32) -> (i32) {\n  func.return %x : i32\n}\n\nfunc.def @second(%x: i32) -> (i32) {\n  func.return %x : i32\n}\n"
        }
      },
      "stderr": {
        "contains": [
          "\"anchor\":\"func\"",
          "\"symbol\":\"first\"",
          "\"symbol\":\"second\"",
          "func.def @first",
          "func.def @second"
        ]
      },
      "files": [
        {
          "path": "{tmp}/dumped-whole-module.loom",
          "non_empty": true
        }
      ]
    },
    {
      "name": "dumps selected before and after IR to a bundle",
      "run": {
        "tool": "loom-opt",
        "args": [
          "--pass=dce",
          "--dump-ir-before=dce",
          "--dump-ir-after=dce",
          "--dump-ir-format=jsonl",
          "--dump-ir-output={tmp}/trace-bundle/",
          "--output={tmp}/bundle-out.loom"
        ],
        "stdin": {
          "text": "func.def @trace_bundle(%x: i32) -> (i32) {\n  %dead = scalar.constant 42 : i32\n  func.return %x : i32\n}\n"
        }
      },
      "files": [
        {
          "path": "{tmp}/trace-bundle/trace.jsonl",
          "non_empty": true
        },
        {
          "path": "{tmp}/trace-bundle/ir/000000-before-dce.loom",
          "non_empty": true
        },
        {
          "path": "{tmp}/trace-bundle/ir/000001-after-dce.loom",
          "non_empty": true
        },
        {
          "path": "{tmp}/bundle-out.loom",
          "non_empty": true
        }
      ]
    },
    {
      "name": "materializes config values",
      "run": {
        "tool": "loom-opt",
        "args": ["--config=model36.model.hidden_size=4096"],
        "stdin": {
          "text": "config.decl @model36.model.hidden_size : index\n\nfunc.def @read_config() -> (index) {\n  %hidden = config.get @model36.model.hidden_size : index\n  func.return %hidden : index\n}\n"
        }
      },
      "stdout": {
        "contains": [
          "config.def @model36.model.hidden_size = 4096 : index",
          "%hidden = config.get @model36.model.hidden_size : index"
        ],
        "not_contains": ["config.decl @model36.model.hidden_size"]
      }
    },
    {
      "name": "reports configuration failures through JSON diagnostics",
      "run": {
        "tool": "loom-opt",
        "args": ["--config=answer=17", "--diagnostic-format=json"]
      },
      "stdin": {
        "text": "config.decl @answer : %value: index where [multiple_of(%value, 16)]\n"
      },
      "exit": 1,
      "stdout": {"empty": true},
      "stderr": {
        "contains": [
          {"regex": "^\\{\"severity\":\"error\".*\"diagnostic_code\":\"CONFIG/INVALID\".*\\}$"}
        ],
        "not_contains": ["stack:"]
      }
    },
    {
      "name": "configuration admits input when explicit verification is disabled",
      "run": {
        "tool": "loom-opt",
        "args": ["--verify=false", "--config=answer=16"]
      },
      "stdin": {
        "text": "config.decl @answer : index\nfunc.def @invalid() -> (i32) { func.return }\n"
      },
      "exit": 1,
      "stdout": {"empty": true},
      "stderr": {"contains": ["yield has 0 operands, expected 1"]}
    },
    {
      "name": "rejects duplicate config binding",
      "run": {
        "tool": "loom-opt",
        "args": [
          "--config=answer=40",
          "--config=@answer=41",
          "--output={tmp}/unused.loom"
        ],
        "stdin": {
          "text": "config.decl @answer : index\n"
        }
      },
      "exit": {
        "nonzero": true
      },
      "stderr": {
        "contains": ["duplicate config binding for 'answer'"]
      }
    },
    {
      "name": "replays a bytecode input failure from text",
      "steps": [
        {
          "name": "encode",
          "run": {
            "tool": "loom-format",
            "args": ["--to=bc"]
          },
          "stdin": {
            "text": "pass.pipeline<module> @boom pipeline {\n  for func {\n    dce\n  }\n  fail \"bytecode failure\"\n}\n\nfunc.def @identity(%value: i32) -> (i32) {\n  %unused = scalar.constant 42 : i32\n  func.return %value : i32\n}\n"
          },
          "stderr": {"empty": true}
        },
        {
          "name": "capture",
          "run": {
            "tool": "loom-opt",
            "args": [
              "--pipeline=@boom",
              "--pass-reproducer={tmp}/bytecode.repro.loom"
            ]
          },
          "stdin": {"step_stdout": "encode"},
          "exit": 1,
          "stdout": {"empty": true},
          "stderr": {
            "contains": ["bytecode failure", "pass pipeline reproducer written to"]
          },
          "files": [
            {
              "path": "{tmp}/bytecode.repro.loom",
              "contains": [
                "// RUN: loom-opt --verify=true --pipeline='@boom' %s",
                "func.def @identity(%value: i32) -> (i32) {",
                "%unused = scalar.constant 42 : i32"
              ]
            }
          ]
        },
        {
          "name": "replay",
          "run": {
            "tool": "loom-opt",
            "args": ["--verify=true", "--pipeline=@boom", "{tmp}/bytecode.repro.loom"]
          },
          "exit": 1,
          "stdout": {"empty": true},
          "stderr": {
            "contains": ["error [PASS_PROGRAM/EXECUTION]: bytecode failure"],
            "not_contains": ["PARSE/"]
          }
        }
      ]
    },
    {
      "name": "replays file and flag configuration without external inputs",
      "steps": [
        {
          "write": {
            "path": "{tmp}/config.jsonc",
            "text": "{\n  // Nested configuration is flattened at admission.\n  \"model\": {\"answer\": 42}\n}\n"
          }
        },
        {
          "name": "capture",
          "run": {
            "tool": "loom-opt",
            "args": [
              "--pipeline=@boom",
              "--config-file={tmp}/config.jsonc",
              "--config=limit=7",
              "--pass-reproducer={tmp}/configured.repro.loom"
            ]
          },
          "stdin": {
            "text": "config.decl @model.answer : index\nconfig.decl @limit : index\n\npass.pipeline<module> @boom pipeline {\n  for func {\n    dce\n  }\n  fail \"configured failure\"\n}\n\nfunc.def @identity(%value: i32) -> (i32) {\n  %unused = scalar.constant 42 : i32\n  func.return %value : i32\n}\n"
          },
          "exit": 1,
          "stdout": {"empty": true},
          "stderr": {
            "contains": ["configured failure", "pass pipeline reproducer written to"]
          },
          "files": [
            {
              "path": "{tmp}/configured.repro.loom",
              "contains": [
                "// RUN: loom-opt --verify=true --pipeline='@boom' %s",
                "config.def @model.answer = 42 : index",
                "config.def @limit = 7 : index",
                "%unused = scalar.constant 42 : i32"
              ],
              "not_contains": ["--config", "config.decl"]
            }
          ]
        },
        {
          "write": {
            "path": "{tmp}/config.jsonc",
            "text": "{\"model\": {\"answer\": 99}}\n"
          }
        },
        {
          "name": "replay",
          "run": {
            "tool": "loom-opt",
            "args": [
              "--verify=true",
              "--pipeline=@boom",
              "{tmp}/configured.repro.loom",
              "--dump-ir-before=dce",
              "--dump-ir-format=jsonl",
              "--dump-ir-output={tmp}/replay.jsonl"
            ]
          },
          "exit": 1,
          "stdout": {"empty": true},
          "stderr": {
            "contains": ["error [PASS_PROGRAM/EXECUTION]: configured failure"]
          },
          "files": [
            {
              "path": "{tmp}/replay.jsonl",
              "contains": [
                "config.def @model.answer = 42 : index",
                "config.def @limit = 7 : index"
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "writes pass pipeline reproducer",
      "run": {
        "tool": "loom-opt",
        "args": [
          "--pipeline=@boom",
          "--pass-reproducer={tmp}/pass.repro",
          "--dump-ir-after=dce",
          "--dump-ir-format=jsonl",
          "--dump-ir-output={tmp}/failed-pass-trace.jsonl",
          "--output={tmp}/unused.loom"
        ],
        "stdin": {
          "text": "pass.pipeline<module> @boom pipeline {\n  for func {\n    dce\n  }\n  fail \"boom\"\n}\n\nfunc.def @reproducer_input(%x: i32) -> (i32) {\n  func.return %x : i32\n}\n"
        }
      },
      "exit": {
        "nonzero": true
      },
      "stderr": {
        "contains": [
          "boom",
          "pass pipeline reproducer written to"
        ]
      },
      "files": [
        {
          "path": "{tmp}/pass.repro",
          "contains": [
            {"regex": "\"status\"\\s*:\\s*\\{\\s*\"code\":"},
            "\"name\":"
          ]
        },
        {
          "path": "{tmp}/failed-pass-trace.jsonl",
          "contains": [
            "\"status\":{\"code\":",
            "\"name\":"
          ]
        }
      ]
    },
    {
      "name": "optimizes text input to text output",
      "steps": [
        {
          "write": {
            "path": "{tmp}/expected.loom",
            "text": "func.def @identity(%value: i32) -> (i32) {\n  func.return %value : i32\n}\n\n"
          }
        },
        {
          "name": "encode",
          "run": {
            "tool": "loom-format",
            "args": [
              "--to=text"
            ]
          },
          "stdin": {
            "text": "func.def @identity(%value: i32) -> (i32) {\n  %dead = scalar.constant 42 : i32\n  func.return %value : i32\n}\n"
          },
          "stderr": {
            "empty": true
          }
        },
        {
          "name": "optimize",
          "run": {
            "tool": "loom-opt",
            "args": [
              "--pass=dce",
              "--to=text"
            ]
          },
          "stdin": {
            "step_stdout": "encode"
          },
          "stderr": {
            "empty": true
          }
        },
        {
          "run": {
            "tool": "loom-opt"
          },
          "stdin": {
            "step_stdout": "optimize"
          },
          "stdout": {
            "save": "{tmp}/actual.loom"
          },
          "stderr": {
            "empty": true
          },
          "files": [
            {
              "path": "{tmp}/actual.loom",
              "equals": "{tmp}/expected.loom"
            }
          ]
        }
      ]
    },
    {
      "name": "optimizes text input to bytecode output",
      "steps": [
        {
          "write": {
            "path": "{tmp}/expected.loom",
            "text": "func.def @identity(%value: i32) -> (i32) {\n  func.return %value : i32\n}\n\n"
          }
        },
        {
          "name": "encode",
          "run": {
            "tool": "loom-format",
            "args": [
              "--to=text"
            ]
          },
          "stdin": {
            "text": "func.def @identity(%value: i32) -> (i32) {\n  %dead = scalar.constant 42 : i32\n  func.return %value : i32\n}\n"
          },
          "stderr": {
            "empty": true
          }
        },
        {
          "name": "optimize",
          "run": {
            "tool": "loom-opt",
            "args": [
              "--pass=dce",
              "--to=bytecode"
            ]
          },
          "stdin": {
            "step_stdout": "encode"
          },
          "stderr": {
            "empty": true
          }
        },
        {
          "run": {
            "tool": "loom-opt"
          },
          "stdin": {
            "step_stdout": "optimize"
          },
          "stdout": {
            "save": "{tmp}/actual.loom"
          },
          "stderr": {
            "empty": true
          },
          "files": [
            {
              "path": "{tmp}/actual.loom",
              "equals": "{tmp}/expected.loom"
            }
          ]
        }
      ]
    },
    {
      "name": "optimizes bytecode input to text output",
      "steps": [
        {
          "write": {
            "path": "{tmp}/expected.loom",
            "text": "func.def @identity(%value: i32) -> (i32) {\n  func.return %value : i32\n}\n\n"
          }
        },
        {
          "name": "encode",
          "run": {
            "tool": "loom-format",
            "args": [
              "--to=bytecode"
            ]
          },
          "stdin": {
            "text": "func.def @identity(%value: i32) -> (i32) {\n  %dead = scalar.constant 42 : i32\n  func.return %value : i32\n}\n"
          },
          "stderr": {
            "empty": true
          }
        },
        {
          "name": "optimize",
          "run": {
            "tool": "loom-opt",
            "args": [
              "--pass=dce",
              "--to=text"
            ]
          },
          "stdin": {
            "step_stdout": "encode"
          },
          "stderr": {
            "empty": true
          }
        },
        {
          "run": {
            "tool": "loom-opt"
          },
          "stdin": {
            "step_stdout": "optimize"
          },
          "stdout": {
            "save": "{tmp}/actual.loom"
          },
          "stderr": {
            "empty": true
          },
          "files": [
            {
              "path": "{tmp}/actual.loom",
              "equals": "{tmp}/expected.loom"
            }
          ]
        }
      ]
    },
    {
      "name": "optimizes bytecode input to bytecode output",
      "steps": [
        {
          "write": {
            "path": "{tmp}/expected.loom",
            "text": "func.def @identity(%value: i32) -> (i32) {\n  func.return %value : i32\n}\n\n"
          }
        },
        {
          "name": "encode",
          "run": {
            "tool": "loom-format",
            "args": [
              "--to=bytecode"
            ]
          },
          "stdin": {
            "text": "func.def @identity(%value: i32) -> (i32) {\n  %dead = scalar.constant 42 : i32\n  func.return %value : i32\n}\n"
          },
          "stderr": {
            "empty": true
          }
        },
        {
          "name": "optimize",
          "run": {
            "tool": "loom-opt",
            "args": [
              "--pass=dce",
              "--to=bytecode"
            ]
          },
          "stdin": {
            "step_stdout": "encode"
          },
          "stderr": {
            "empty": true
          }
        },
        {
          "run": {
            "tool": "loom-opt"
          },
          "stdin": {
            "step_stdout": "optimize"
          },
          "stdout": {
            "save": "{tmp}/actual.loom"
          },
          "stderr": {
            "empty": true
          },
          "files": [
            {
              "path": "{tmp}/actual.loom",
              "equals": "{tmp}/expected.loom"
            }
          ]
        }
      ]
    },
    {
      "name": "writes bytecode to a file and resumes execution",
      "steps": [
        {
          "write": {
            "path": "{tmp}/expected.loom",
            "text": "func.def @identity(%value: i32) -> (i32) {\n  func.return %value : i32\n}\n\n"
          }
        },
        {
          "run": {
            "tool": "loom-opt",
            "args": [
              "--to=bc",
              "--output={tmp}/module.loombc"
            ]
          },
          "stdin": {
            "text": "func.def @identity(%value: i32) -> (i32) {\n  %dead = scalar.constant 42 : i32\n  func.return %value : i32\n}\n"
          },
          "stdout": {
            "empty": true
          },
          "stderr": {
            "empty": true
          }
        },
        {
          "run": {
            "tool": "loom-opt",
            "args": [
              "{tmp}/module.loombc",
              "--pass=dce"
            ]
          },
          "stdout": {
            "save": "{tmp}/actual.loom"
          },
          "stderr": {
            "empty": true
          },
          "files": [
            {
              "path": "{tmp}/actual.loom",
              "equals": "{tmp}/expected.loom"
            }
          ]
        }
      ]
    },
    {
      "name": "requires verified input for execution when explicit checks are disabled",
      "run": {
        "tool": "loom-opt",
        "args": [
          "--verify=false",
          "--pass=dce",
          "--output={tmp}/invalid.loom"
        ]
      },
      "stdin": {
        "text": "func.def @bad() -> (i32) {\n  func.return\n}\n"
      },
      "exit": 1,
      "stdout": {
        "empty": true
      },
      "stderr": {
        "contains": [
          "yield has 0 operands, expected 1"
        ]
      },
      "files": [
        {
          "path": "{tmp}/invalid.loom",
          "exists": false
        }
      ]
    },
    {
      "name": "retains a partial pass report after pipeline failure",
      "run": {
        "tool": "loom-opt",
        "args": [
          "--pipeline=@boom",
          "--pass-report=json",
          "--pass-reproducer={tmp}/failure.loom"
        ]
      },
      "stdin": {
        "text": "pass.pipeline<module> @boom pipeline {\n  for func {\n    dce\n  }\n  fail \"stopped after cleanup\"\n}\n\nfunc.def @identity(%value: i32) -> (i32) {\n  %dead = scalar.constant 42 : i32\n  func.return %value : i32\n}\n"
      },
      "exit": 1,
      "stdout": {
        "empty": true
      },
      "stderr": {
        "contains": [
          "stopped after cleanup",
          "\"pass\":\"dce\"",
          "\"pipeline\":\"boom\"",
          "\"changed\":true"
        ]
      },
      "files": [
        {
          "path": "{tmp}/failure.loom",
          "contains": [
            {
              "regex": "\"status\"\\s*:\\s*\\{\\s*\"code\"\\s*:\\s*9\\s*,\\s*\"name\"\\s*:\\s*\"FAILED_PRECONDITION\""
            }
          ]
        }
      ]
    },
    {
      "name": "records missing pipeline preparation status",
      "run": {
        "tool": "loom-opt",
        "args": [
          "--pipeline=@missing",
          "--pass-reproducer={tmp}/missing.loom",
          "--output={tmp}/unused.loom"
        ]
      },
      "stdin": {
        "text": "func.def @identity(%value: i32) -> (i32) {\n  %dead = scalar.constant 42 : i32\n  func.return %value : i32\n}\n"
      },
      "exit": 1,
      "stdout": {
        "empty": true
      },
      "files": [
        {
          "path": "{tmp}/unused.loom",
          "exists": false
        },
        {
          "path": "{tmp}/missing.loom",
          "contains": [
            "\"NOT_FOUND\"",
            "// RUN: loom-opt --verify=true --pipeline='@missing' %s"
          ]
        }
      ]
    },
    {
      "name": "records unknown pass preparation failure",
      "run": {
        "tool": "loom-opt",
        "args": [
          "--pass=not-a-pass",
          "--pass-report=json",
          "--pass-reproducer={tmp}/unknown.loom",
          "--output={tmp}/unused.loom"
        ]
      },
      "stdin": {
        "text": "func.def @identity(%value: i32) -> (i32) {\n  %dead = scalar.constant 42 : i32\n  func.return %value : i32\n}\n"
      },
      "exit": 1,
      "stdout": {
        "empty": true
      },
      "stderr": {
        "contains": [
          "not-a-pass",
          "\"invocations\":[]"
        ]
      },
      "files": [
        {
          "path": "{tmp}/unused.loom",
          "exists": false
        },
        {
          "path": "{tmp}/unknown.loom",
          "non_empty": true
        }
      ]
    },
    {
      "name": "rejects bytecode output for configuration schema",
      "run": {
        "tool": "loom-opt",
        "args": [
          "--to=bytecode",
          "--print-config-schema"
        ]
      },
      "exit": 1,
      "stdout": {
        "empty": true
      },
      "stderr": {
        "contains": [
          "--print-config-schema requires --to=text"
        ]
      }
    },
    {
      "name": "rejects unresolved configuration after execution",
      "run": {
        "tool": "loom-opt",
        "args": [
          "--pass=dce",
          "--require-resolved-config",
          "--output={tmp}/unused.loom"
        ]
      },
      "stdin": {
        "text": "config.decl @answer : index\n"
      },
      "exit": 1,
      "stdout": {
        "empty": true
      },
      "stderr": {
        "contains": [
          "answer"
        ]
      },
      "files": [
        {
          "path": "{tmp}/unused.loom",
          "exists": false
        }
      ]
    },
    {
      "name": "prints configuration schema after materialization and execution",
      "run": {
        "tool": "loom-opt",
        "args": [
          "--pass=dce",
          "--config=answer=42",
          "--print-config-schema",
          "--require-resolved-config"
        ]
      },
      "stdin": {
        "text": "config.decl @answer : index\n"
      },
      "stdout": {
        "contains": [
          "\"answer\"",
          "42"
        ]
      },
      "stderr": {
        "empty": true
      }
    },
    {
      "name": "replays invalid flat pass options",
      "steps": [
        {
          "run": {
            "tool": "loom-opt",
            "args": [
              "--pass=canonicalize{max-iterations=no}",
              "--pass-reproducer={tmp}/failure.loom"
            ]
          },
          "stdin": {
            "text": "func.def @identity(%value: i32) -> (i32) {\n  func.return %value : i32\n}\n"
          },
          "exit": 1,
          "stdout": {
            "empty": true
          },
          "files": [
            {
              "path": "{tmp}/failure.loom",
              "contains": [
                "// RUN: loom-opt --verify=true --pass='canonicalize{max-iterations=no}' %s"
              ],
              "not_contains": [
                "pass.run<",
                "@__command_line"
              ]
            }
          ]
        },
        {
          "run": {
            "tool": "loom-opt",
            "args": [
              "--pass=canonicalize{max-iterations=no}",
              "{tmp}/failure.loom"
            ]
          },
          "exit": 1,
          "stdout": {
            "empty": true
          },
          "stderr": {
            "contains": [
              "option 'max-iterations' expected a uint32 value"
