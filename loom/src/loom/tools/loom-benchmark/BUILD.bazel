_AMDGPU_TARGET_COPTS = iree_select({
    "//loom/config/execute:amdgpu_hal": [
        "-DLOOM_BENCHMARK_HAVE_AMDGPU=1",
    ],
    "//conditions:default": [],
})

_AMDGPU_TARGET_DEPS = iree_select({
    "//loom/config/execute:amdgpu_hal": [
        "//loom/binding/c/target/amdgpu:iree_hal",
        "//loom/src/loom/tooling/target/amdgpu:testbench_requirements",
    ],
    "//conditions:default": [],
})

_SPIRV_VULKAN_TARGET_COPTS = iree_select({
    "//loom/config/execute:spirv_vulkan_hal": [
        "-DLOOM_BENCHMARK_HAVE_SPIRV=1",
    ],
    "//conditions:default": [],
})

_SPIRV_VULKAN_TARGET_DEPS = iree_select({
    "//loom/config/execute:spirv_vulkan_hal": [
        "//loom/binding/c/target/spirv:iree_hal",
        "//loom/src/loom/tooling/target/spirv:testbench_requirements",
    ],
    "//conditions:default": [],
})

_XDNA_TARGET_COPTS = iree_select({
    "//loom/config/execute:xdna_hal": ["-DLOOM_BENCHMARK_HAVE_XDNA=1"],
    "//conditions:default": [],
})

_XDNA_TARGET_DEPS = iree_select({
    "//loom/config/execute:xdna_hal": ["//loom/binding/c/target/amd/xdna:iree_hal"],
    "//conditions:default": [],
})

_TASK_TARGET_COPTS = iree_select({
    "//loom/config/execute:task_hal": ["-DLOOM_BENCHMARK_HAVE_TASK=1"],
    "//conditions:default": [],
})

_TASK_TARGET_DEPS = iree_select({
    "//loom/config/execute:task_hal": ["//loom/binding/c/target/cpu:iree_hal"],
    "//conditions:default": [],
})

_VM_TARGET_COPTS = iree_select({
    "//loom/config/target/arch:vm": ["-DLOOM_BENCHMARK_HAVE_VM=1"],
    "//conditions:default": [],
})

_VM_TARGET_DEPS = iree_select({
    "//loom/config/target/arch:vm": [
        "//loom/src/loom/tooling/target/vm:testbench",
    ],
    "//conditions:default": [],
})

_LOOM_BENCHMARK_TARGET_COPTS = (
    _AMDGPU_TARGET_COPTS +
    _SPIRV_VULKAN_TARGET_COPTS +
    _TASK_TARGET_COPTS +
    _VM_TARGET_COPTS +
    _XDNA_TARGET_COPTS
)

_LOOM_BENCHMARK_TARGET_DEPS = (
    _AMDGPU_TARGET_DEPS +
    _SPIRV_VULKAN_TARGET_DEPS +
    _TASK_TARGET_DEPS +
    _VM_TARGET_DEPS +
    _XDNA_TARGET_DEPS
)

