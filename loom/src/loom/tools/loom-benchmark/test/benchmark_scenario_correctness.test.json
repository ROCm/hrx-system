{
  "version": 1,
  "cases": [
    {
      "name": "default scenario timing is unchecked even when authored expectations fail",
      "run": {
        "tool": "benchmark",
        "args": ["{srcdir}/../../../tooling/testbench/testdata/benchmark_scenarios.loom", "--device=task", "--task_topology_max_group_count=2", "--case=@wrong_result", "--iterations=1", "--warmup-iterations=0", "--batch-size=1", "--min-time-ms=0", "--max-batches=1"]
      },
      "stdout": {
        "contains": {"unordered": ["\"state\":\"ok\"", "\"sample_count\":0,\"failed_sample_count\":0,\"state\":\"unchecked\"", "\"validity\":\"unchecked\"", "\"operation_timing_ns\""]},
        "not_contains": ["EXPECT/001", "\"failed_samples\"", "\"correctness_materialization\""]
      }
    },
    {
      "name": "unchecked comparisons keep timing windows without running either oracle",
      "run": {
        "tool": "benchmark",
        "args": ["{srcdir}/../../../tooling/testbench/testdata/benchmark_scenarios.loom", "--device=task", "--task_topology_max_group_count=2", "--scenario-correctness=false", "--compare=@right_latency,@wrong_latency", "--repetitions=1", "--output-format=jsonl", "--iterations=1", "--warmup-iterations=0", "--batch-size=1", "--min-time-ms=0", "--max-batches=1"]
      },
      "stdout": {
        "contains": {"unordered": ["\"state\":\"unchecked\"", "\"row\":\"benchmark.repetition\"", "\"row\":\"comparison\"", "\"correctness\":{\"sample_count\":0,\"failed_sample_count\":0}"]},
        "not_contains": ["EXPECT/001", "\"row\":\"sample\"", "\"correctness_materialization\""]
      }
    },
    {
      "name": "unchecked command programs do not prepare an unsupported VM oracle",
      "run": {
        "tool": "benchmark",
        "args": ["{srcdir}/../../../tooling/testbench/testdata/benchmark_scenarios.loom", "--device=task", "--task_topology_max_group_count=2", "--benchmark=@command_without_vm_oracle_latency", "--iterations=1", "--warmup-iterations=0", "--batch-size=2", "--input-ring-count=2", "--min-time-ms=0", "--max-batches=1"]
      },
      "stdout": {
        "contains": {"unordered": ["\"state\":\"unchecked\"", "\"physical_dispatches_per_batch\":4", "\"physical_dispatches_per_logical_operation\":2", "\"operation_timing_ns\""]},
        "not_contains": ["\"failed_samples\"", "\"correctness_materialization\""]
      }
    },
    {
      "name": "opting in exposes unsupported command oracle preparation",
      "run": {
        "tool": "benchmark",
        "args": ["{srcdir}/../../../tooling/testbench/testdata/benchmark_scenarios.loom", "--device=task", "--task_topology_max_group_count=2", "--benchmark=@command_without_vm_oracle_latency", "--scenario-correctness=true"]
      },
      "exit": {"nonzero": true},
      "stderr": {"contains": ["VM scenario profile requires a semantic function subject"]},
      "stdout": {"not_contains": ["\"operation_timing_ns\""]}
    },
    {
      "name": "checked command programs observe the final dispatch before timing",
      "run": {
        "tool": "benchmark",
        "args": ["{srcdir}/../../../tooling/testbench/testdata/benchmark_scenarios.loom", "--device=task", "--task_topology_max_group_count=2", "--benchmark=@wrong_command_latency", "--scenario-correctness=true"]
      },
      "exit": {"nonzero": true},
      "stdout": {
        "contains": {"unordered": ["EXPECT/001", "\"sample_count\":1,\"failed_sample_count\":1,\"state\":\"failed\""]},
        "not_contains": ["\"operation_timing_ns\""]
      }
    },
    {
      "name": "checked command programs retain configuration subviews and physical dispatch counts",
      "run": {
        "tool": "benchmark",
        "args": ["{srcdir}/../../../tooling/execution/hal/testdata/command_scenario_dependent_stages.loom", "--device=task", "--task_topology_max_group_count=2", "--benchmark=@dependent_stage_values_throughput", "--sample=5", "--scenario-correctness=true", "--iterations=1", "--warmup-iterations=0", "--batch-size=4", "--input-ring-count=2", "--min-time-ms=0", "--max-batches=1", "--profile-final-batch=true", "--profile-data=dispatch-events"]
      },
      "stdout": {
        "contains": {"unordered": ["\"sample_count\":1,\"failed_sample_count\":0,\"state\":\"passed\"", "\"configuration_ordinal\":2,\"trial_index\":0,\"trial_ordinal\":1", "\"logical_operations_per_batch\":4", "\"physical_dispatches_per_batch\":20", "\"command_buffer_ring_count\":2", "\"operation_timing_ns\""]}
      }
    },
    {
      "name": "one failed physical check suppresses both benchmark aliases",
      "run": {
        "tool": "benchmark",
        "args": ["{srcdir}/../../../tooling/testbench/testdata/benchmark_scenarios.loom", "--scenario-correctness=true", "--device=task", "--task_topology_max_group_count=2", "--case=@wrong_result", "--iterations=1", "--warmup-iterations=0", "--batch-size=1", "--min-time-ms=0", "--max-batches=1"]
      },
      "exit": {"nonzero": true},
      "stdout": {
        "contains": {"unordered": ["EXPECT/001", "\"failed_benchmark_count\":2", "\"sample_count\":1,\"failed_sample_count\":1", "\"trial_ordinal\":0,\"passed\":false"]},
        "not_contains": ["\"state\":\"ok\"", "\"operation_timing_ns\""]
      }
    },
    {
      "name": "checks the selected configuration and trial with an authored generator",
      "run": {
        "tool": "benchmark",
        "args": ["{srcdir}/../../../tooling/testbench/testdata/benchmark_scenarios.loom", "--scenario-correctness=true", "--device=task", "--task_topology_max_group_count=2", "--benchmark=@selected_latency", "--sample=5", "--output-format=jsonl", "--iterations=1", "--warmup-iterations=0", "--batch-size=2", "--input-ring-count=3", "--min-time-ms=0", "--max-batches=1"]
      },
      "stdout": {
        "contains": ["\"row\":\"sample\"", "\"configuration_ordinal\":1,\"trial_index\":0,\"trial_ordinal\":2,\"passed\":true", "\"row\":\"benchmark\"", "\"sample_count\":1,\"failed_sample_count\":0"]
      }
    },
    {
      "name": "ABABA checks each candidate once before repeated timing windows",
      "run": {
        "tool": "benchmark",
        "args": ["{srcdir}/../../../tooling/testbench/testdata/benchmark_scenarios.loom", "--scenario-correctness=true", "--device=task", "--task_topology_max_group_count=2", "--compare=@right_latency,@right_alias_latency", "--interleave=ababa", "--repetitions=2", "--iterations=1", "--warmup-iterations=0", "--batch-size=1", "--min-time-ms=0", "--max-batches=1"]
      },
      "stdout": {
        "contains": {"unordered": ["\"sample_count\":2,\"failed_sample_count\":0", "\"comparisons\":[{", "\"repetitions\":[{"]}
      }
    },
    {
      "name": "a failed candidate cannot produce a comparison or timing row",
      "run": {
        "tool": "benchmark",
        "args": ["{srcdir}/../../../tooling/testbench/testdata/benchmark_scenarios.loom", "--scenario-correctness=true", "--device=task", "--task_topology_max_group_count=2", "--compare=@right_latency,@wrong_latency", "--interleave=round_robin", "--repetitions=2", "--output-format=jsonl", "--iterations=1", "--warmup-iterations=0", "--batch-size=1", "--min-time-ms=0", "--max-batches=1"]
      },
      "exit": {"nonzero": true},
      "stdout": {
        "contains": {"unordered": ["EXPECT/001", "\"sample_count\":2,\"failed_sample_count\":1"]},
        "not_contains": ["\"row\":\"comparison\"", {"regex": "\"row\":\"benchmark\\.repetition\"[^\\n]*\"candidate_index\":1"}]
      }
    },
    {
      "name": "a failed baseline cannot produce a comparison",
      "run": {
        "tool": "benchmark",
        "args": ["{srcdir}/../../../tooling/testbench/testdata/benchmark_scenarios.loom", "--scenario-correctness=true", "--device=task", "--task_topology_max_group_count=2", "--compare=@wrong_latency,@right_latency", "--repetitions=1", "--iterations=1", "--warmup-iterations=0", "--batch-size=1", "--min-time-ms=0", "--max-batches=1"]
      },
      "exit": {"nonzero": true},
      "stdout": {
        "contains": {"unordered": ["EXPECT/001", "\"sample_count\":2,\"failed_sample_count\":1"]},
        "not_contains": ["\"comparisons\""]
      }
    },
    {
      "name": "correct values do not excuse a missing expected device event",
      "run": {
        "tool": "benchmark",
        "args": ["{srcdir}/../../../tooling/testbench/testdata/benchmark_scenarios.loom", "--scenario-correctness=true", "--device=task", "--task_topology_max_group_count=2", "--benchmark=@missing_event_latency", "--iterations=1", "--warmup-iterations=0", "--batch-size=1", "--min-time-ms=0", "--max-batches=1"]
      },
      "exit": {"nonzero": true},
      "stdout": {
        "contains": {"unordered": ["\"expectation_count\":2,\"passed_count\":1,\"failure_count\":1", "\"sample_count\":1,\"failed_sample_count\":1"]},
        "not_contains": ["\"state\":\"ok\""]
      }
    },
    {
      "name": "invoke-only trials execute without an oracle",
      "run": {
        "tool": "benchmark",
        "args": ["{srcdir}/../../../tooling/testbench/testdata/benchmark_scenarios.loom", "--scenario-correctness=true", "--device=task", "--task_topology_max_group_count=2", "--benchmark=@invoke_latency", "--output-format=jsonl", "--iterations=1", "--warmup-iterations=0", "--batch-size=1", "--min-time-ms=0", "--max-batches=1"]
      },
      "stdout": {
        "contains": ["\"row\":\"sample\"", "\"action\":\"invoke\"", "\"passed\":true", "\"row\":\"benchmark\"", "\"sample_count\":1,\"failed_sample_count\":0"]
      }
    }
  ]
}
