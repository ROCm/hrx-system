{
  "version": 1,
  "cases": [
    {
      "name": "rejects source-language input",
      "run": {
        "tool": "loom-link",
        "args": [
          "{srcdir}/testdata/source_main.loom",
          "--input-format=cxx"
        ]
      },
      "exit": {
        "nonzero": true
      },
      "stdout": {
        "empty": true
      },
      "stderr": {
        "contains": ["input format 'cxx' is not linked into this tool"]
      }
    },
    {
      "name": "rejects duplicate definitions before merge projection",
      "run": {
        "tool": "loom-link",
        "args": [
          "{srcdir}/../../tooling/input/testdata/duplicate_symbols.loom-test",
          "--mode=merge"
        ]
      },
      "exit": {
        "nonzero": true
      },
      "stdout": {
        "empty": true
      },
      "stderr": {
        "contains": {
          "unordered": [
            "duplicate_symbols.loom-test:5:19: error [SYMBOL/005]",
            "symbol '@collision' is already defined",
            "first definition here",
            "duplicate_symbols.loom-test:3:13",
            "kernel.decl @collision() launch()",
            "check.case public @collision {"
          ]
        }
      }
    },
    {
      "name": "rejects duplicate definitions in an unselected source library",
      "run": {
        "tool": "loom-link",
        "args": [
          "{srcdir}/testdata/kernel_exports.loom",
          "--library={srcdir}/../../tooling/input/testdata/duplicate_symbols.loom-test",
          "--root=@entry"
        ]
      },
      "exit": {
        "nonzero": true
      },
      "stdout": {
        "empty": true
      },
      "stderr": {
        "contains": {
          "unordered": [
            "duplicate_symbols.loom-test:5:19: error [SYMBOL/005]",
            "symbol '@collision' is already defined",
            "first definition here",
            "duplicate_symbols.loom-test:3:13",
            "kernel.decl @collision() launch()",
            "check.case public @collision {"
          ]
        }
      }
    },
    {
      "name": "kernel entries retain implicit and renamed exports across source and bytecode libraries",
      "steps": [
        {
          "name": "select-source-exports",
          "run": {
            "tool": "loom-link",
            "args": [
              "{srcdir}/testdata/kernel_exports.loom",
              "--mode=link",
              "--include-input-exports"
            ]
          },
          "stdout": {
            "contains": [
              "kernel.def retain @entry()",
              "kernel.def retain export(\"artifact_entry\") @renamed_entry()",
              "func.def public retain @public_entry()",
              "func.def public retain export(\"public_alias\") @renamed_public_entry()"
            ],
            "not_contains": [
              "@unused_helper",
              "export(\"entry\")"
            ]
          }
        },
        {
          "name": "encode-library",
          "run": {
            "tool": "loom-link",
            "args": [
              "{srcdir}/testdata/kernel_exports.loom",
              "--mode=merge",
              "--to=bc",
              "--output={tmp}/kernels.loombc"
            ]
          }
        },
        {
          "name": "select-bytecode-exports",
          "run": {
            "tool": "loom-link",
            "args": [
              "--root-library={tmp}/kernels.loombc",
              "--mode=link"
            ]
          },
          "stdout": {
            "contains": [
              "kernel.def retain @entry()",
              "kernel.def retain export(\"artifact_entry\") @renamed_entry()",
              "func.def public retain @public_entry()",
              "func.def public retain export(\"public_alias\") @renamed_public_entry()"
            ],
            "not_contains": [
              "@unused_helper",
              "export(\"entry\")"
            ]
          }
        },
        {
          "name": "resolve-bytecode-library",
          "run": {
            "tool": "loom-link",
            "args": [
              "{srcdir}/testdata/kernel_export_cases.loom",
              "--library={tmp}/kernels.loombc",
              "--mode=link",
              "--include-input-tests"
            ]
          },
          "stdout": {
            "contains": [
              "kernel.def @entry()",
              "kernel.def export(\"artifact_entry\") @renamed_entry()"
            ],
            "not_contains": [
              "@unused_helper",
              "export(\"entry\")"
            ]
          }
        }
      ]
    },
    {
      "name": "preserves linked source IDs for primary and related diagnostics",
      "run": {
        "tool": "loom-link",
        "args": [
          "{srcdir}/testdata/source_main.loom",
          "{srcdir}/testdata/source_library.loom-test"
        ]
      },
      "exit": {
        "nonzero": true
      },
      "stderr": {
        "contains": {
          "unordered": [
            "source_library.loom-test:7:3: error [TYPE/001]",
            "7 |   %result = func.call @callee(%input) : (i64) -> (i32)",
            "source_main.loom:1:1",
            "1 | func.def public @callee(%input: i32) -> (i32) {",
            "linked module verification failed"
          ]
        }
      }
    },
    {
      "name": "stripped input tests retain their private callable subjects",
      "steps": [
        {
          "name": "write-source",
          "write": {
            "path": "{tmp}/private-subject.loom",
            "text": "func.def @helper(%x: i32) -> (i32) {\n  func.return %x : i32\n}\n\nfunc.def @subject(%x: i32) -> (i32) {\n  %result = func.call @helper(%x) : (i32) -> (i32)\n  func.return %result : i32\n}\n\ncheck.scenario @subject_scenario {\n  check.trial[1](%trial: index, %entropy: check.entropy) {\n    %input = check.literal value(1) : i32\n    check.compare<@subject>(%input) : (i32) -> [actual(%actual: i32), expected(%expected: i32)] {\n      check.expect.equal actual(%actual) expected(%expected) : i32\n    }\n  }\n  check.return\n}\n"
          }
        },
        {
          "name": "link-subject",
          "run": {
            "tool": "loom-link",
            "args": [
              "{tmp}/private-subject.loom",
              "--mode=link",
              "--include-input-tests",
              "--strip-check"
            ]
          },
          "stdout": {
            "contains": [
              "func.def @helper(",
              "func.def retain @subject("
            ],
            "not_contains": [
              "check.scenario",
              "retain @helper"
            ]
          }
        }
      ]
    },
    {
      "name": "stripped input tests reject sources without tested subjects",
      "steps": [
        {
          "name": "write-source",
          "write": {
            "path": "{tmp}/untested-subject.loom",
            "text": "func.def public @untested() -> (i32) {\n  %value = scalar.constant 1 : i32\n  func.return %value : i32\n}\n"
          }
        },
        {
          "name": "link-subject",
          "run": {
            "tool": "loom-link",
            "args": [
              "{tmp}/untested-subject.loom",
              "--mode=link",
              "--include-input-tests",
              "--strip-check"
            ]
          },
          "exit": {"nonzero": true},
          "stderr": {"contains": ["link planning requires a nonempty root set"]}
        }
      ]
    },
    {
      "name": "separates library availability from final template applicability",
      "steps": [
        {
          "name": "link-family-contract",
          "run": {
            "tool": "loom-link",
            "args": [
              "{srcdir}/../../link/testdata/template_selection/missing_provider.loom",
              "--root=@entry",
              "--to=bc",
              "--output={tmp}/linked.loombc"
            ]
          }
        },
        {
          "name": "reject-live-unimplemented-application",
          "run": {
            "tool": "loom-opt",
            "args": ["{tmp}/linked.loombc", "--pass=select-templates{mode=final}"]
          },
          "exit": {"nonzero": true},
          "stderr": {"contains": {"unordered": ["no_provider", "unavailable"]}}
        }
      ]
    },
    {
      "name": "still rejects missing ordinary definitions",
      "run": {
        "tool": "loom-link",
        "args": [
          "{srcdir}/../../link/testdata/template_selection/root.loom",
          "--root=@entry"
        ]
      },
      "exit": {"nonzero": true},
      "stderr": {"contains": ["unresolved exact declaration '@choose'"]}
    },
    {
      "name": "prints agent documentation",
      "run": {
        "tool": "loom-link",
        "args": ["--agents_md"]
      },
      "stdout": {
        "non_empty": true
      }
    },
    {
      "name": "roots direct library exports without flattening libraries",
      "steps": [
        {
          "name": "encode-direct-library",
          "run": {
            "tool": "loom-format",
            "args": [
              "--to=bc",
              "--output={tmp}/direct.loombc",
              "{srcdir}/../../link/testdata/provider_roots/direct.loom"
            ]
          }
        },
        {
          "name": "encode-transitive-library",
          "run": {
            "tool": "loom-format",
            "args": [
              "--to=bc",
              "--output={tmp}/transitive.loombc",
              "{srcdir}/../../link/testdata/provider_roots/transitive.loom"
            ]
          }
        },
        {
          "name": "encode-unused-library",
          "run": {
            "tool": "loom-format",
            "args": [
              "--to=bc",
              "--output={tmp}/unused.loombc",
              "{srcdir}/../../link/testdata/provider_roots/unused.loom"
            ]
          }
        },
        {
          "name": "link-root-library",
          "run": {
            "tool": "loom-link",
            "args": [
              "--root-library={tmp}/direct.loombc",
              "--transitive-library={tmp}/transitive.loombc",
              "--transitive-library={tmp}/unused.loombc"
            ]
          },
          "stdout": {
            "contains": {
              "unordered": [
                "func.def public retain @entry",
                "func.def public retain pure @secondary",
                "func.def @direct_helper",
                "func.def pure @transitive"
              ]
            },
            "not_contains": [
              "transitive_unused",
              "unreachable_private",
              "unused_export"
            ]
          }
        }
      ]
    },
    {
      "name": "writes linked bytecode and dependency report",
      "run": {
        "tool": "loom-link",
        "args": [
          "{srcdir}/testdata/dependency_component.loom",
          "--library={srcdir}/testdata/dependency_direct.loom",
          "--library={srcdir}/testdata/dependency_transitive.loom",
          "--mode=merge",
          "--strict-deps",
          "--dependency-component=//model:component",
          "--dependency-report={tmp}/dependencies.json",
          "--to=bc",
          "--output={tmp}/linked.loombc"
        ]
      },
      "files": [
        {
          "path": "{tmp}/linked.loombc",
          "non_empty": true
        },
        {
          "path": "{tmp}/dependencies.json",
          "non_empty": true
        }
      ]
    },
    {
      "name": "links import-free bytecode declaration",
      "steps": [
        {
          "name": "write-harness",
          "write": {
            "path": "{tmp}/harness.loom",
            "text": "func.decl @identity(%x: i32) -> (i32)\n\nfunc.def @caller(%x: i32) -> (i32) {\n  %y = func.call @identity(%x) : (i32) -> (i32)\n  func.return %y : i32\n}\n"
          }
        },
        {
          "name": "write-library",
          "write": {
            "path": "{tmp}/library.loom",
            "text": "func.def @unused(%x: i32) -> (i32) {\n  func.return %x : i32\n}\n\nfunc.def public @identity(%x: i32) -> (i32) {\n  func.return %x : i32\n}\n"
          }
        },
        {
          "name": "encode-library",
          "run": {
            "tool": "loom-format",
            "args": [
              "--from=text",
              "--to=bc",
              "--output={tmp}/library.loombc",
              "{tmp}/library.loom"
            ]
          },
          "files": [
            {
              "path": "{tmp}/library.loombc",
              "non_empty": true
            }
          ]
        },
        {
          "name": "link",
          "run": {
            "tool": "loom-link",
            "args": [
              "{tmp}/harness.loom",
              "--library={tmp}/library.loombc",
              "--root=@caller"
            ]
          },
          "stdout": {
            "contains": [
              "func.def @identity(%x: i32) -> (i32) {",
              "func.def retain @caller(%x: i32) -> (i32) {"
            ],
            "not_contains": [
              "func.def @unused",
              "func.decl @identity"
            ]
          }
        }
      ]
    },
    {
      "name": "relinks partial library bytecode",
      "steps": [
        {
          "name": "write-root",
          "write": {
            "path": "{tmp}/root.loom",
            "text": "func.decl @a(%x: i32) -> (i32)\nfunc.decl @b(%x: i32) -> (i32)\n\nfunc.def public @entry(%x: i32) -> (i32) {\n  %a = func.call @a(%x) : (i32) -> (i32)\n  %b = func.call @b(%a) : (i32) -> (i32)\n  func.return %b : i32\n}\n"
          }
        },
        {
          "name": "write-provider-a",
          "write": {
            "path": "{tmp}/provider-a.loom",
            "text": "func.decl @c(%x: i32) -> (i32)\n\nfunc.def public @a(%x: i32) -> (i32) {\n  %helper = func.call @a_helper(%x) : (i32) -> (i32)\n  %c = func.call @c(%helper) : (i32) -> (i32)\n  func.return %c : i32\n}\n\nfunc.def @a_helper(%x: i32) -> (i32) {\n  func.return %x : i32\n}\n"
          }
        },
        {
          "name": "write-provider-b",
          "write": {
            "path": "{tmp}/provider-b.loom",
            "text": "func.def public @b(%x: i32) -> (i32) {\n  func.return %x : i32\n}\n"
          }
        },
        {
          "name": "write-provider-c",
          "write": {
            "path": "{tmp}/provider-c.loom",
            "text": "func.def public @c(%x: i32) -> (i32) {\n  func.return %x : i32\n}\n"
          }
        },
        {
          "name": "link-partial",
          "run": {
            "tool": "loom-link",
            "args": [
              "root.loom",
              "--library=provider-a.loom",
              "--root=@entry",
              "--allow-unresolved",
              "--to=bc",
              "--output=partial.loombc"
            ]
          },
          "files": [
            {
              "path": "{tmp}/partial.loombc",
              "non_empty": true
            }
          ]
        },
        {
          "name": "show-partial",
          "run": {
            "tool": "loom-format",
            "args": ["partial.loombc"]
          },
          "stdout": {
            "contains": {
              "unordered": [
                "func.def @a(",
                "func.def @a_helper(",
                "func.decl @b(",
                "func.decl @c("
              ]
            }
          }
        },
        {
          "name": "reject-incomplete-final-link",
          "run": {
            "tool": "loom-link",
            "args": ["partial.loombc", "--root=@entry"]
          },
          "exit": {
            "nonzero": true
          },
          "stderr": {
            "contains": ["unresolved exact declaration '@b'"]
          }
        },
        {
          "name": "finish-link",
          "run": {
            "tool": "loom-link",
            "args": [
              "partial.loombc",
              "--library=provider-b.loom",
              "--library=provider-c.loom",
              "--root=@entry"
            ]
          },
          "stdout": {
            "contains": {
              "unordered": [
                "func.def public retain @entry(",
                "func.def @a(",
                "func.def @a_helper(",
                "func.def @b(",
                "func.def @c("
              ]
            },
            "not_contains": ["func.decl"]
          }
        }
      ]
    },
    {
      "name": "preserves unresolved config until explicit final resolution",
      "steps": [
        {
          "name": "write-component",
          "write": {
            "path": "{tmp}/config.loom",
            "text": "config.decl @tuning.factor : index\nfunc.def public @configured() -> (index) {\n  %value = config.get @tuning.factor : index\n  func.return %value : index\n}\nfunc.def public @plain() {\n  func.return\n}\n"
          }
        },
        {
          "name": "merge-relocatable-component",
          "run": {
            "tool": "loom-link",
            "args": [
              "{tmp}/config.loom",
              "--to=bc",
              "--output={tmp}/config.loombc"
            ]
          }
        },
        {
          "name": "inspect-relocatable-config",
          "run": {
            "tool": "loom-link",
            "args": [
              "{tmp}/config.loombc"
            ]
          },
          "stdout": {
            "contains": [
              "config.decl @tuning.factor",
              "config.get @tuning.factor"
            ]
          }
        },
        {
          "name": "reject-unresolved-final-config",
          "run": {
            "tool": "loom-link",
            "args": [
              "{tmp}/config.loombc",
              "--require-resolved-config"
            ]
          },
          "exit": 1,
          "stderr": {
            "contains": [
              "unresolved config '@tuning.factor'"
            ]
          }
        },
        {
          "name": "resolve-final-config",
          "run": {
            "tool": "loom-link",
            "args": [
              "{tmp}/config.loombc",
              "--require-resolved-config",
              "--config=tuning.factor=16"
            ]
          },
          "stdout": {
            "contains": [
              "config.def @tuning.factor = 16 : index"
            ],
            "not_contains": [
              "config.decl"
            ]
          }
        },
        {
          "name": "resolve-after-root-selection",
          "run": {
            "tool": "loom-link",
            "args": [
              "{tmp}/config.loombc",
              "--root=@plain",
              "--require-resolved-config"
            ]
          },
          "stdout": {
            "contains": [
              "@plain"
            ],
            "not_contains": [
              "@configured",
              "config.decl",
              "config.get"
            ]
          }
        }
      ]
    },
    {
      "name": "physical entry declarations resolve to configured source and bytecode providers",
      "steps": [
        {
          "name": "resolve-source-entry",
          "run": {
            "tool": "loom-link",
            "args": [
              "{srcdir}/testdata/physical_entry.loom",
              "--library={srcdir}/testdata/kernel_exports.loom",
              "--mode=link",
              "--root=@dispatch_entry"
            ]
          },
          "stdout": {
            "contains": [
              "kernel.def @entry()",
              "kernel.dispatch @entry[%groups]()",
              "kernel.dispatch @entry[%counts]() indirect_lifetime(invocation)"
            ]
          }
        },
        {
          "name": "encode-entry-provider",
          "run": {
            "tool": "loom-link",
            "args": [
              "{srcdir}/testdata/kernel_exports.loom",
              "--mode=merge",
              "--to=bc",
              "--output={tmp}/physical-provider.loombc"
            ]
          }
        },
        {
          "name": "resolve-bytecode-entry",
          "run": {
            "tool": "loom-link",
            "args": [
              "{srcdir}/testdata/physical_entry.loom",
              "--library={tmp}/physical-provider.loombc",
              "--mode=link",
              "--root=@dispatch_entry"
            ]
          },
          "stdout": {
            "contains": [
              "kernel.def @entry()",
              "kernel.dispatch @entry[%groups]()",
              "kernel.dispatch @entry[%counts]() indirect_lifetime(invocation)"
            ]
          }
        }
      ]
    },
    {
      "name": "kernel declarations preserve configured interface physical first",
      "run": {
        "tool": "loom-link",
        "args": [
          "{srcdir}/testdata/physical_entry.loom",
          "{srcdir}/testdata/configured_entry.loom",
          "--mode=merge"
        ]
      },
      "stdout": {
        "contains": [
          "kernel.decl @entry(%rows: index) launch()"
        ],
        "not_contains": [
          "kernel.entry.decl @entry"
        ]
      }
    },
    {
      "name": "kernel declarations preserve configured interface configured first",
      "run": {
        "tool": "loom-link",
        "args": [
          "{srcdir}/testdata/configured_entry.loom",
          "{srcdir}/testdata/physical_entry.loom",
          "--mode=merge"
        ]
      },
      "stdout": {
        "contains": [
          "kernel.decl @entry(%rows: index) launch()"
        ],
        "not_contains": [
          "kernel.entry.decl @entry"
        ]
      }
    },
    {
      "name": "mixed kernel declarations reject ABI mismatch physical first",
      "run": {
        "tool": "loom-link",
        "args": [
          "{srcdir}/testdata/physical_entry.loom",
          "{srcdir}/testdata/incompatible_entry.loom",
          "--mode=merge"
        ]
      },
      "exit": {
        "nonzero": true
      },
      "stderr": {
        "contains": [
          "args"
        ]
      }
    },
    {
      "name": "mixed kernel declarations reject ABI mismatch configured first",
      "run": {
        "tool": "loom-link",
        "args": [
          "{srcdir}/testdata/incompatible_entry.loom",
          "{srcdir}/testdata/physical_entry.loom",
          "--mode=merge"
        ]
      },
      "exit": {
        "nonzero": true
      },
      "stderr": {
        "contains": [
          "args"
        ]
      }
    },
    {
      "name": "bytecode kernel declarations preserve configured interface",
      "steps": [
        {
          "name": "encode-configured",
          "run": {
            "tool": "loom-link",
            "args": [
              "{srcdir}/testdata/configured_entry.loom",
              "--mode=merge",
              "--to=bc",
              "--output={tmp}/configured.loombc"
            ]
          }
        },
        {
          "name": "merge-physical-first",
          "run": {
            "tool": "loom-link",
            "args": [
              "{srcdir}/testdata/physical_entry.loom",
              "{tmp}/configured.loombc",
              "--mode=merge"
            ]
          },
          "stdout": {
            "contains": [
              "kernel.decl @entry(%rows: index) launch()"
            ],
            "not_contains": [
              "kernel.entry.decl @entry"
            ]
          }
        },
        {
          "name": "merge-configured-first",
          "run": {
            "tool": "loom-link",
            "args": [
              "{tmp}/configured.loombc",
              "{srcdir}/testdata/physical_entry.loom",
              "--mode=merge"
            ]
          },
          "stdout": {
            "contains": [
              "kernel.decl @entry(%rows: index) launch()"
            ],
            "not_contains": [
              "kernel.entry.decl @entry"
            ]
          }
        }
      ]
    }
  ]
}
