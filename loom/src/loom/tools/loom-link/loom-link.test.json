{
  "version": 1,
  "cases": [
    {
      "name": "prints agent documentation",
      "run": {
        "tool": "loom-link",
        "args": ["--agents_md"]
      },
      "stdout": {
        "contains": {
          "unordered": [
            "## loom-link",
            "--library=providers.loombc",
            "--root-library=app.loombc",
            "--transitive-library=indirect.loombc",
            "--strict-deps",
            "--dependency-report=component.dependencies.json",
            "--root=@entry",
            "--print-plan",
            "--list-symbols",
            "--strip-check",
            "--target-profile=amdgpu:gfx11-generic",
            "--allow-unresolved"
          ]
        }
      }
    },
    {
      "name": "roots direct library exports without flattening libraries",
      "steps": [
        {
          "name": "encode-direct-library",
          "run": {
            "tool": "loom-format",
            "args": [
              "--to=bc",
              "--output={tmp}/direct.loombc",
              "{srcdir}/../../link/testdata/provider_roots/direct.loom"
            ]
          }
        },
        {
          "name": "encode-transitive-library",
          "run": {
            "tool": "loom-format",
            "args": [
              "--to=bc",
              "--output={tmp}/transitive.loombc",
              "{srcdir}/../../link/testdata/provider_roots/transitive.loom"
            ]
          }
        },
        {
          "name": "encode-unused-library",
          "run": {
            "tool": "loom-format",
            "args": [
              "--to=bc",
              "--output={tmp}/unused.loombc",
              "{srcdir}/../../link/testdata/provider_roots/unused.loom"
            ]
          }
        },
        {
          "name": "link-root-library",
          "run": {
            "tool": "loom-link",
            "args": [
              "--root-library={tmp}/direct.loombc",
              "--transitive-library={tmp}/transitive.loombc",
              "--transitive-library={tmp}/unused.loombc"
            ]
          },
          "stdout": {
            "contains": {
              "unordered": [
                "func.def public retain @entry",
                "func.def public retain pure @secondary",
                "func.def @direct_helper",
                "func.def pure @transitive"
              ]
            },
            "not_contains": [
              "transitive_unused",
              "unreachable_private",
              "unused_export"
            ]
          }
        }
      ]
    },
    {
      "name": "writes linked bytecode and dependency report",
      "run": {
        "tool": "loom-link",
        "args": [
          "{srcdir}/testdata/dependency_component.loom",
          "--library={srcdir}/testdata/dependency_direct.loom",
          "--library={srcdir}/testdata/dependency_transitive.loom",
          "--mode=merge",
          "--strict-deps",
          "--dependency-component=//model:component",
          "--dependency-report={tmp}/dependencies.json",
          "--to=bc",
          "--output={tmp}/linked.loombc"
        ]
      },
      "files": [
        {
          "path": "{tmp}/linked.loombc",
          "non_empty": true
        },
        {
          "path": "{tmp}/dependencies.json",
          "non_empty": true
        }
      ]
    },
    {
      "name": "links import-free bytecode declaration",
      "steps": [
        {
          "name": "write-harness",
          "write": {
            "path": "{tmp}/harness.loom",
            "text": "func.decl @identity(%x: i32) -> (i32)\n\nfunc.def @caller(%x: i32) -> (i32) {\n  %y = func.call @identity(%x) : (i32) -> (i32)\n  func.return %y : i32\n}\n"
          }
        },
        {
          "name": "write-library",
          "write": {
            "path": "{tmp}/library.loom",
            "text": "func.def @unused(%x: i32) -> (i32) {\n  func.return %x : i32\n}\n\nfunc.def export(\"identity\") @identity(%x: i32) -> (i32) {\n  func.return %x : i32\n}\n"
          }
        },
        {
          "name": "encode-library",
          "run": {
            "tool": "loom-format",
            "args": [
              "--from=text",
              "--to=bc",
              "--output={tmp}/library.loombc",
              "{tmp}/library.loom"
            ]
          },
          "files": [
            {
              "path": "{tmp}/library.loombc",
              "non_empty": true
            }
          ]
        },
        {
          "name": "link",
          "run": {
            "tool": "loom-link",
            "args": [
              "{tmp}/harness.loom",
              "--library={tmp}/library.loombc",
              "--root=@caller"
            ]
          },
          "stdout": {
            "contains": [
              "func.def @identity(%x: i32) -> (i32) {",
              "func.def retain @caller(%x: i32) -> (i32) {"
            ],
            "not_contains": [
              "func.def @unused",
              "func.decl @identity"
            ]
          }
        }
      ]
    },
    {
      "name": "relinks partial library bytecode",
      "steps": [
        {
          "name": "write-root",
          "write": {
            "path": "{tmp}/root.loom",
            "text": "func.decl @a(%x: i32) -> (i32)\nfunc.decl @b(%x: i32) -> (i32)\n\nfunc.def public @entry(%x: i32) -> (i32) {\n  %a = func.call @a(%x) : (i32) -> (i32)\n  %b = func.call @b(%a) : (i32) -> (i32)\n  func.return %b : i32\n}\n"
          }
        },
        {
          "name": "write-provider-a",
          "write": {
            "path": "{tmp}/provider-a.loom",
            "text": "func.decl @c(%x: i32) -> (i32)\n\nfunc.def public @a(%x: i32) -> (i32) {\n  %helper = func.call @a_helper(%x) : (i32) -> (i32)\n  %c = func.call @c(%helper) : (i32) -> (i32)\n  func.return %c : i32\n}\n\nfunc.def @a_helper(%x: i32) -> (i32) {\n  func.return %x : i32\n}\n"
          }
        },
        {
          "name": "write-provider-b",
          "write": {
            "path": "{tmp}/provider-b.loom",
            "text": "func.def public @b(%x: i32) -> (i32) {\n  func.return %x : i32\n}\n"
          }
        },
        {
          "name": "write-provider-c",
          "write": {
            "path": "{tmp}/provider-c.loom",
            "text": "func.def public @c(%x: i32) -> (i32) {\n  func.return %x : i32\n}\n"
          }
        },
        {
          "name": "link-partial",
          "run": {
            "tool": "loom-link",
            "args": [
              "root.loom",
              "--library=provider-a.loom",
              "--root=@entry",
              "--allow-unresolved",
              "--to=bc",
              "--output=partial.loombc"
            ]
          },
          "files": [
            {
              "path": "{tmp}/partial.loombc",
              "non_empty": true
            }
          ]
        },
        {
          "name": "show-partial",
          "run": {
            "tool": "loom-format",
            "args": ["partial.loombc"]
          },
          "stdout": {
            "contains": {
              "unordered": [
                "func.def @a(",
                "func.def @a_helper(",
                "func.decl @b(",
                "func.decl @c("
              ]
            }
          }
        },
        {
          "name": "reject-incomplete-final-link",
          "run": {
            "tool": "loom-link",
            "args": ["partial.loombc", "--root=@entry"]
          },
          "exit": {
            "nonzero": true
          },
          "stderr": {
            "contains": ["unresolved exact declaration '@b'"]
          }
        },
        {
          "name": "finish-link",
          "run": {
            "tool": "loom-link",
            "args": [
              "partial.loombc",
              "--library=provider-b.loom",
              "--library=provider-c.loom",
              "--root=@entry"
            ]
          },
          "stdout": {
            "contains": {
              "unordered": [
                "func.def public retain @entry(",
                "func.def @a(",
                "func.def @a_helper(",
                "func.def @b(",
                "func.def @c("
              ]
            },
            "not_contains": ["func.decl"]
          }
        }
      ]
    }
  ]
}
