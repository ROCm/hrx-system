template.decl @test.target_profile_transform(%value: i32) -> (i32)

template.def<@test.target_profile_transform> requires [#target.subgroup.size<32>] priority(20) @wave32_target_profile_transform(%value: i32) -> (i32) {
  %result = scalar.addi %value, %value : i32
  template.return %result : i32
}

template.def<@test.target_profile_transform> priority(1) @portable_target_profile_transform(%value: i32) -> (i32) {
  %c2 = scalar.constant 2 : i32
  %result = scalar.muli %value, %c2 : i32
  template.return %result : i32
}

kernel.def export("target_profile_entry") @target_profile_entry() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %input_view = buffer.view %input[%base] : buffer -> view<1xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<1xi32>
  %value = view.load %input_view[%c0] : view<1xi32> -> i32
  %result = template.apply<@test.target_profile_transform>(%value) : (i32) -> (i32)
  view.store %result, %output_view[%c0] : i32, view<1xi32>
  kernel.return
}
