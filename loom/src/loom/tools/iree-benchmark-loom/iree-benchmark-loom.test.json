{
  "version": 1,
  "cases": [
    {
      "name": "writes dry-run output file",
      "run": {
        "tool": "iree-benchmark-loom",
        "args": [
          "{srcdir}/testdata/scalar_benchmarks.loom",
          "--output-format=jsonl",
          "--benchmark=@scalar_equal_latency",
          "--dry-run",
          "--output={tmp}/dry_run.jsonl"
        ]
      },
      "files": [
        {
          "path": "{tmp}/dry_run.jsonl",
          "non_empty": true
        }
      ]
    },
    {
      "name": "writes dry-run artifact bundle",
      "run": {
        "tool": "iree-benchmark-loom",
        "args": [
          "{srcdir}/testdata/scalar_benchmarks.loom",
          "--output-format=jsonl",
          "--benchmark=@scalar_equal_latency",
          "--dry-run",
          "--artifact-bundle-dir={tmp}/bundle"
        ]
      },
      "files": [
        {
          "path": "{tmp}/bundle/results.jsonl",
          "non_empty": true
        },
        {
          "path": "{tmp}/bundle/manifest.json",
          "non_empty": true
        }
      ]
    },
    {
      "name": "prints agent documentation",
      "run": {
        "tool": "iree-benchmark-loom",
        "args": ["--agents_md"]
      },
      "stdout": {
        "contains": {
          "unordered": [
            "## iree-benchmark-loom",
            "default output is a compact JSON snapshot",
            "work_items",
            "ordered, typed `workload`",
            "`launch_config`",
            "failure.entry",
            "select(.failure)",
            "--output-format=jsonl",
            "compile_report",
            ".compile_report.entries.rows[]",
            ".compile_report.schedule_band_summary_rows.rows[]",
            "dynamic_instruction_mix",
            "max_band_node_count",
            ".compile_report.wait_reason_summary_rows.rows[]",
            ".compile_report.wait_action_rows.rows[]",
            "materialized_spill_storage",
            "group_by",
            "full_drains",
            "semantic_tag",
            "compile_report_path",
            "artifact_manifest_path",
            "target_artifact_path",
            "rounding=finite_only",
            "fp8_packed_bf16_decode_repair_zero_subnormal",
            ".compile_report.target_capability_rows.rows[]",
            "matrix_fp8_native_kind"
          ]
        },
        "not_contains": ["static_summary"]
      }
    },
    {
      "name": "prints help",
      "run": {
        "tool": "iree-benchmark-loom",
        "args": ["--help"]
      },
      "stdout": {
        "contains": [
          "Runs correctness-gated check.benchmark records from a Loom module.",
          "Usage:"
        ]
      }
    }
  ]
}
