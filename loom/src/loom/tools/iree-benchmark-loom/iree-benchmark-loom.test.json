{
  "version": 1,
  "cases": [
    {
      "name": "writes dry-run output file",
      "run": {
        "tool": "iree-benchmark-loom",
        "args": [
          "{srcdir}/testdata/scalar_benchmarks.loom",
          "--output-format=jsonl",
          "--benchmark=@scalar_equal_latency",
          "--dry-run",
          "--output={tmp}/dry_run.jsonl"
        ]
      },
      "files": [
        {
          "path": "{tmp}/dry_run.jsonl",
          "non_empty": true
        }
      ]
    },
    {
      "name": "writes dry-run artifact bundle",
      "run": {
        "tool": "iree-benchmark-loom",
        "args": [
          "{srcdir}/testdata/scalar_benchmarks.loom",
          "--output-format=jsonl",
          "--benchmark=@scalar_equal_latency",
          "--dry-run",
          "--artifact-bundle-dir={tmp}/bundle"
        ]
      },
      "files": [
        {
          "path": "{tmp}/bundle/results.jsonl",
          "non_empty": true
        },
        {
          "path": "{tmp}/bundle/manifest.json",
          "non_empty": true
        }
      ]
    },
    {
      "name": "prints agent documentation",
      "run": {
        "tool": "iree-benchmark-loom",
        "args": ["--agents_md"]
      },
      "stdout": {
        "contains": {
          "unordered": [
            "## iree-benchmark-loom",
            "gates every",
            "--dry-run",
            "--measure=dispatch_complete",
            "work_items",
            "select(.failure)",
            "--output-format=jsonl",
            "--artifact-bundle-dir=DIR",
            "loom/docs/src/workflows/benchmark.md",
            "loom/docs/src/workflows/benchmark-results.md",
            "loom/docs/src/workflows/compile-reports.md"
          ]
        },
        "not_contains": [
          "iree-bazel-run",
          "schedule_band_summary_rows",
          "static_summary"
        ]
      }
    },
    {
      "name": "prints help",
      "run": {
        "tool": "iree-benchmark-loom",
        "args": ["--help"]
      },
      "stdout": {
        "contains": [
          "Runs correctness-gated check.benchmark records from a Loom module.",
          "Usage:"
        ]
      }
    },
    {
      "name": "rejects an unavailable explicit device",
      "run": {
        "tool": "iree-benchmark-loom",
        "args": [
          "{srcdir}/testdata/scalar_benchmarks.loom",
          "--benchmark=@scalar_equal_latency",
          "--device=loom-unavailable",
          "--dry-run"
        ]
      },
      "exit": {
        "nonzero": true
      },
      "stderr": {
        "contains": [
          "--device=loom-unavailable",
          "not available in this Loom installation",
          "available --device drivers:"
        ]
      }
    }
  ]
}
