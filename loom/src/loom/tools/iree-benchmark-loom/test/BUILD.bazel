load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")
load("//loom/build_tools/bazel:python.bzl", "loom_py_test")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],  # Apache 2.0
)

loom_py_test(
    name = "scenario_comparison_test",
    size = "small",
    srcs = ["scenario_comparison_test.py"],
    args = [
        "$(rootpath //loom/src/loom/tools/iree-benchmark-loom)",
        "$(rootpath //loom/src/loom/tooling/execution/hal:testdata/scenario_compare_hal_vm.loom)",
    ],
    data = [
        "//loom/src/loom/tooling/execution/hal:testdata/scenario_compare_hal_vm.loom",
        "//loom/src/loom/tools/iree-benchmark-loom",
    ],
    main = "scenario_comparison_test.py",
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:x86",
        "//loom/config/execute:task_hal",
        "//runtime/config/hal:executable_loader_embedded_elf",
    ]) + ["@platforms//cpu:x86_64"],
)
