{
  "version": 1,
  "cases": [
    {
      "name": "prints agent documentation",
      "run": {
        "tool": "iree-run-loom",
        "args": ["--agents_md"]
      },
      "stdout": {
        "contains": {
          "unordered": [
            "## iree-run-loom",
            "--backend=",
            "--kernel-input-buffer=64xf32=0",
            "--emit-target-artifact=",
            "--compile-report=summary"
          ]
        }
      }
    }
  ]
}
