load("//build_tools/testing:build_defs.bzl", "iree_execution_test_suite")
load("//loom/binding/c:shared.bzl", "loomc_cc_binary")
load("//loom/build_tools/bazel:build_defs.bzl", "iree_select", "loom_cc_library", "loom_cc_test", "loom_config_compatible_with")

package(
    default_visibility = ["//loom/src/loom/serve:implementation"],
    features = ["layering_check"],
    licenses = ["notice"],
)

exports_files(
    ["server_test.py"],
    visibility = ["//loom/src/loom/tooling/target/cpu/serve:__pkg__"],
)

loom_cc_library(
    name = "options",
    srcs = ["options.c"],
    hdrs = ["options.h"],
    deps = [
        "//loom/src/loom/runtime/device",
        "//loom/src/loom/runtime/host",
        "//loom/src/loom/serve/server:device_configuration",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:json",
        "//runtime/src/iree/base/internal:path",
        "//runtime/src/iree/base/tooling:flags",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/io:file_handle",
        "//runtime/src/iree/tooling:device_flags",
        "//runtime/src/iree/tooling:device_profiling",
    ],
)

loom_cc_library(
    name = "signals",
    srcs = ["signals.c"],
    hdrs = ["signals.h"],
    deps = [
        "//runtime/src/iree/async",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
    ],
)

loom_cc_test(
    name = "signals_test",
    srcs = ["signals_test.cc"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":signals",
        "//runtime/src/iree/async",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "activity_tests",
    testonly = True,
    srcs = ["activity_test.cc"],
    hdrs = ["activity_test.h"],
    deps = [
        ":options",
        "//loom/src/loom/runtime/device",
        "//loom/src/loom/runtime/host",
        "//loom/src/loom/runtime/testing:worker_gate",
        "//loom/src/loom/serve/server:configuration",
        "//loom/src/loom/serve/server:device_configuration",
        "//loom/src/loom/serve/server:model_registration",
        "//loom/src/loom/serve/server:registry",
        "//loom/src/loom/serve/service/recognition:stream",
        "//loom/src/loom/serve/service/recognition:transcription",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/base/tooling:flags",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/task",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/tooling:device_profiling",
    ],
)

loom_cc_library(
    name = "main",
    srcs = ["main.c"],
    hdrs = ["main.h"],
    deps = [
        ":build_identity",
        ":options",
        ":signals",
        "//loom/src/loom/runtime/device",
        "//loom/src/loom/serve/server:configuration",
        "//loom/src/loom/serve/server:device_configuration",
        "//loom/src/loom/serve/server:model_registration",
        "//loom/src/loom/serve/server:registry",
        "//loom/src/loom/serve/server:router",
        "//loom/src/loom/serve/transport/http:listener",
        "//loom/src/loom/serve/transport/http:server",
        "//loom/src/loom/tooling/cli:help",
        "//loom/src/loom/util:json",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/async",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/tooling:flags",
        "//runtime/src/iree/tooling:device_profiling",
    ],
)

loom_cc_library(
    name = "build_identity",
    hdrs = ["build_identity.h"],
    linkstamp = "build_identity.cc",
)

loomc_cc_binary(
    name = "loom-serve",
    srcs = ["loom-serve.c"],
    copts = iree_select({
        "//loom/config/execute:x86_task_hal": ["-DLOOM_SERVE_CONFIG_HAVE_X86=1"],
        "//conditions:default": [],
    }) + iree_select({
        "//loom/config/execute:amdgpu_hal": ["-DLOOM_SERVE_CONFIG_HAVE_AMDGPU=1"],
        "//conditions:default": [],
    }) + iree_select({
        "//loom/config/execute:spirv_vulkan_hal": ["-DLOOM_SERVE_CONFIG_HAVE_SPIRV=1"],
        "//conditions:default": [],
    }) + iree_select({
        "//loom/config/execute:aie2p_xdna_hal": ["-DLOOM_SERVE_CONFIG_HAVE_XDNA=1"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":build_identity",
        ":main",
        "//loom/binding/c/target/configured",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base:core_headers",
        "//runtime/src/iree/tooling:device_util",
    ] + iree_select({
        "//loom/config/execute:x86_task_hal": ["//loom/binding/c/target/cpu:iree_hal"],
        "//conditions:default": [],
    }) + iree_select({
        "//loom/config/execute:amdgpu_hal": ["//loom/binding/c/target/amdgpu:iree_hal"],
        "//conditions:default": [],
    }) + iree_select({
        "//loom/config/execute:spirv_vulkan_hal": ["//loom/binding/c/target/spirv:iree_hal"],
        "//conditions:default": [],
    }) + iree_select({
        "//loom/config/execute:aie2p_xdna_hal": ["//loom/binding/c/target/amd/xdna:iree_hal"],
        "//conditions:default": [],
    }),
)

iree_execution_test_suite(
    name = "execution_test",
    manifests = ["loom-serve.test.json"],
    tags = ["hostonly"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/emit:vm_binary",
    ]),
    tools = {"loom-serve": ":loom-serve"},
)
