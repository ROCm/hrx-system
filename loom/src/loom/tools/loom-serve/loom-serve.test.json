{
  "version": 1,
  "cases": [
    {
      "name": "help is available without opening a device",
      "run": {"tool": "loom-serve", "args": ["--help"]},
      "stdout": {
        "contains": [
          "loom-serve --device=URI",
          ".loombc",
          "/v1/status",
          "--model",
          "--listen",
          "--workers",
          "--pool_backing",
          "--weight_slab_bytes=1073741824",
          "--state_slab_bytes=67108864",
          "--execution_scope",
          "--execution_limit"
        ]
      },
      "stderr": {"not_contains": ["\"event\":\"ready\""]}
    },
    {
      "name": "explicit physical slab size overrides the serving default",
      "run": {"tool": "loom-serve", "args": ["--weight_slab_bytes=2097152", "--help"]},
      "stdout": {"contains": ["--weight_slab_bytes=2097152"]},
      "stderr": {"not_contains": ["\"event\":\"ready\""]}
    },
    {
      "name": "allocator-recommended physical slabs remain selectable",
      "run": {"tool": "loom-serve", "args": ["--state_slab_bytes=0", "--help"]},
      "stdout": {"contains": ["--state_slab_bytes=0"]},
      "stderr": {"not_contains": ["\"event\":\"ready\""]}
    },
    {
      "name": "agent help explains deployment and source inputs",
      "run": {"tool": "loom-serve", "args": ["--agents_md"]},
      "stdout": {
        "contains": [
          "# loom-serve",
          "/v1/models/register",
          ".loombc",
          "base_directory",
          "trusted clients",
          "Text, image, embedding and decision services support live updates.",
          "/v1/models/variants",
          "https://rocm.github.io/hrx-system/loom/serving/workflows/live-model-development/",
          "https://rocm.github.io/hrx-system/loom/serving/model-programs/"
        ]
      },
      "stderr": {"not_contains": ["\"event\":\"ready\""]}
    },
    {
      "name": "no redundant server subcommand",
      "run": {"tool": "loom-serve", "args": ["server"]},
      "exit": {"nonzero": true},
      "stdout": {"empty": true},
      "stderr": {
        "contains": ["Unexpected positional argument 'server'", "--model=path"]
      }
    },
    {
      "name": "invalid connection capacity fails before startup",
      "run": {"tool": "loom-serve", "args": ["--connections=0"]},
      "exit": {"nonzero": true},
      "stdout": {"empty": true},
      "stderr": {"contains": ["positive model/connection/body capacities"]}
    },
    {
      "name": "device selection has no implicit default",
      "run": {"tool": "loom-serve", "args": []},
      "exit": {"nonzero": true},
      "stdout": {"empty": true},
      "stderr": {"contains": ["--device is required"]}
    },
    {
      "name": "empty explicit device is rejected",
      "run": {"tool": "loom-serve", "args": ["--device="]},
      "exit": {"nonzero": true},
      "stdout": {"empty": true},
      "stderr": {"contains": ["--device is required"]}
    },
    {
      "name": "unknown options fail instead of being ignored",
      "run": {"tool": "loom-serve", "args": ["--not_a_serve_flag=1"]},
      "exit": {"nonzero": true},
      "stdout": {"empty": true},
      "stderr": {"contains": ["flag 'not_a_serve_flag' not recognized"]}
    }
  ]
}
