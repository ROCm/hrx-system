worker 0: transport=channel-copy execution_counts=exact batches=1 streams=0
  batch 0: records=2 replays=0
    record 0: admission=%a source=%source admissions=1 transfers=1 final_release=no destinations=%left
    record 1: admission=%b source=%source admissions=1 transfers=1 final_release=no destinations=%left
    copy_order: %b->%left %a->%left

// ====
// RUN: emit pipeline-transport @test

// Retained ownership permits copy order to differ from admission order.
func.def @worker(%source: channel<tile<16xi32>>, %left: channel<tile<16xi32>>) {
  %a = channel.accept %source : channel<tile<16xi32>> -> read<tile<16xi32>>
  %b = channel.accept %source : channel<tile<16xi32>> -> read<tile<16xi32>>
  %keep_a, %copy_a = channel.fanout %a : read<tile<16xi32>> -> (read<tile<16xi32>>, read<tile<16xi32>>)
  %keep_b, %copy_b = channel.fanout %b : read<tile<16xi32>> -> (read<tile<16xi32>>, read<tile<16xi32>>)
  %first, %first_view = channel.reserve %left : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
  channel.copy %copy_b -> %first : read<tile<16xi32>>, write<tile<16xi32>>
  %second, %second_view = channel.reserve %left : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
  channel.copy %copy_a -> %second : read<tile<16xi32>>, write<tile<16xi32>>
  channel.release %keep_a : read<tile<16xi32>>
  channel.release %keep_b : read<tile<16xi32>>
  func.return
}

pipeline.def<kernel> public @test() run(%source_storage: buffer, %left_storage: buffer) {
  %origin = index.constant 0 : offset
  %source_capacity = index.constant 2 : index
  %destination_capacity = index.constant 1 : index
  %source_slots = buffer.view %source_storage[%origin] : buffer -> view<2x16xi32>
  %source = channel.bind<fifo> %source_slots, %source_capacity : view<2x16xi32>, index -> channel<tile<16xi32>>
  %left_slots = buffer.view %left_storage[%origin] : buffer -> view<1x16xi32>
  %left = channel.bind<fifo> %left_slots, %destination_capacity : view<1x16xi32>, index -> channel<tile<16xi32>>
  pipeline.strand workers([0], [1], [1]) {
    func.call @worker(%source, %left) : (channel<tile<16xi32>>, channel<tile<16xi32>>)
  }
}

// ----
worker 0: transport=channel-copy execution_counts=exact batches=1 streams=0
  batch 0: records=2 replays=0
    record 0: admission=%a source=%source admissions=1 transfers=1 final_release=yes destinations=%left
    record 1: admission=%b source=%source admissions=1 transfers=1 final_release=yes destinations=%left
    copy_order: %b->%left %a->%left

// ====
// RUN: emit pipeline-transport @test

// An unknown replay count cannot become a fixed transport repetition.
func.def @worker(%source: channel<tile<16xi32>>, %left: channel<tile<16xi32>>, %limit: index) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %initial = channel.accept %source : channel<tile<16xi32>> -> read<tile<16xi32>>
  cfg.br ^header(%c0: index, %initial: read<tile<16xi32>>)
^header(%i: index, %read: read<tile<16xi32>>):
  %more = index.cmp ult, %i, %limit : index
  cfg.cond_br %more, ^copy, ^done
^copy:
  %keep, %outgoing = channel.fanout %read : read<tile<16xi32>> -> (read<tile<16xi32>>, read<tile<16xi32>>)
  %write, %payload = channel.reserve %left : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
  channel.copy %outgoing -> %write : read<tile<16xi32>>, write<tile<16xi32>>
  %next = index.add %i, %c1 : index
  cfg.br ^header(%next: index, %keep: read<tile<16xi32>>)
^done:
  channel.release %read : read<tile<16xi32>>
  func.return
}

pipeline.def<kernel> public @test() run(%source_storage: buffer, %left_storage: buffer, %limit: index) {
  %origin = index.constant 0 : offset
  %source_capacity = index.constant 2 : index
  %destination_capacity = index.constant 1 : index
  %source_slots = buffer.view %source_storage[%origin] : buffer -> view<2x16xi32>
  %source = channel.bind<fifo> %source_slots, %source_capacity : view<2x16xi32>, index -> channel<tile<16xi32>>
  %left_slots = buffer.view %left_storage[%origin] : buffer -> view<1x16xi32>
  %left = channel.bind<fifo> %left_slots, %destination_capacity : view<1x16xi32>, index -> channel<tile<16xi32>>
  pipeline.strand workers([0], [1], [1]) {
    func.call @worker(%source, %left, %limit) : (channel<tile<16xi32>>, channel<tile<16xi32>>, index)
  }
}

