// RUN: emit pipeline-transport @test input

// A captured stride is not an invariant origin: its recurrence is nonlinear.
func.def @ingress(%input: buffer, %records: channel<tile<4xi32>>, %base: offset, %bias: index) {
  %begin = index.constant 0 : index
  %end = index.constant 40 : index
  %step = index.constant 1 : index
  %divisor = index.constant 1 : index
  %modulus = index.constant 8 : index
  %stride = index.constant 32 : index
  cfg.br ^header(%begin: index)
^header(%record: index):
  %more = index.cmp ult, %record, %end : index
  cfg.cond_br %more, ^copy, ^done
^copy:
  %quotient = index.div %record, %divisor : index
  %panel = index.rem %quotient, %modulus : index
  %byte_index = index.mul %panel, %stride : index
  %offset = index.cast %byte_index : index to offset
  %bias_stride = index.constant 64 : offset
  %bias_bytes = index.scale %bias, %bias_stride : index, offset -> offset
  %cohort = index.add %base, %bias_bytes : offset
  %variable_stride = index.scale %record, %bias_bytes : index, offset -> offset
  %address = index.add %cohort, %variable_stride : offset
  %source = buffer.view %input[%address] : buffer -> view<4xi32>
  %write, %payload = channel.reserve %records : channel<tile<4xi32>> -> (write<tile<4xi32>>, view<4xi32>)
  %copy = kernel.async.copy %source to %payload {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<4xi32> to view<4xi32> -> kernel.async.token
  %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
  kernel.async.wait %group {newer_groups = 0} : kernel.async.group
  channel.publish %write : write<tile<4xi32>>
  %next = index.add %record, %step : index
  cfg.br ^header(%next: index)
^done:
  func.return
}

pipeline.def public @test() run(%input_arg: buffer, %storage_arg: buffer, %base_arg: offset, %bias_arg: index) {
  %base = index.assume %base_arg [range(%base_arg, 1024, 4096)] : offset
  %bias = index.assume %bias_arg [range(%bias_arg, 0, 7)] : index
