// RUN: emit pipeline-transport @retained_batch

// A complete two-record batch stays resident across three ordered replays.
// Nested fanouts and loop-carried reads preserve each admitted record.

func.def @distribute(%incoming: channel<tile<16xi32>>, %left: channel<tile<16xi32>>, %right: channel<tile<16xi32>>) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  cfg.br ^batch_header(%c0: index)
^batch_header(%batch: index):
  %more_batches = index.cmp ult, %batch, %c2 : index
  cfg.cond_br %more_batches, ^admit, ^done
^admit:
  %first = channel.accept %incoming : channel<tile<16xi32>> -> read<tile<16xi32>>
  %second = channel.accept %incoming : channel<tile<16xi32>> -> read<tile<16xi32>>
  cfg.br ^replay_header(%c0: index, %first: read<tile<16xi32>>, %second: read<tile<16xi32>>)
^replay_header(%replay: index, %a: read<tile<16xi32>>, %b: read<tile<16xi32>>):
  %more_replays = index.cmp ult, %replay, %c3 : index
  cfg.cond_br %more_replays, ^copy, ^release
^copy:
  %a_left, %a_copy_left = channel.fanout %a : read<tile<16xi32>> -> (read<tile<16xi32>>, read<tile<16xi32>>)
  %a_right, %a_copy_right = channel.fanout %a_left : read<tile<16xi32>> -> (read<tile<16xi32>>, read<tile<16xi32>>)
  %b_left, %b_copy_left = channel.fanout %b : read<tile<16xi32>> -> (read<tile<16xi32>>, read<tile<16xi32>>)
  %b_right, %b_copy_right = channel.fanout %b_left : read<tile<16xi32>> -> (read<tile<16xi32>>, read<tile<16xi32>>)
  %a_left_write, %a_left_view = channel.reserve %left : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
  channel.copy %a_copy_left -> %a_left_write : read<tile<16xi32>>, write<tile<16xi32>>
  %a_right_write, %a_right_view = channel.reserve %right : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
  channel.copy %a_copy_right -> %a_right_write : read<tile<16xi32>>, write<tile<16xi32>>
  %b_left_write, %b_left_view = channel.reserve %left : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
  channel.copy %b_copy_left -> %b_left_write : read<tile<16xi32>>, write<tile<16xi32>>
  %b_right_write, %b_right_view = channel.reserve %right : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
  channel.copy %b_copy_right -> %b_right_write : read<tile<16xi32>>, write<tile<16xi32>>
  %next_replay = index.add %replay, %c1 : index
  cfg.br ^replay_header(%next_replay: index, %a_right: read<tile<16xi32>>, %b_right: read<tile<16xi32>>)
^release:
  channel.release %a : read<tile<16xi32>>
  channel.release %b : read<tile<16xi32>>
  %next_batch = index.add %batch, %c1 : index
  cfg.br ^batch_header(%next_batch: index)
^done:
  func.return
}

pipeline.def<kernel> public @retained_batch() run(%batch_storage: buffer, %left_storage: buffer, %right_storage: buffer) {
  %c0 = index.constant 0 : offset
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %batch_slots = buffer.view %batch_storage[%c0] : buffer -> view<2x16xi32>
  %batch = channel.bind<fifo> %batch_slots, %c2 : view<2x16xi32>, index -> channel<tile<16xi32>>
  %left_slots = buffer.view %left_storage[%c0] : buffer -> view<1x16xi32>
  %left = channel.bind<fifo> %left_slots, %c1 : view<1x16xi32>, index -> channel<tile<16xi32>>
  %right_slots = buffer.view %right_storage[%c0] : buffer -> view<1x16xi32>
  %right = channel.bind<fifo> %right_slots, %c1 : view<1x16xi32>, index -> channel<tile<16xi32>>
  pipeline.strand workers([0], [1], [1]) {
    func.call @distribute(%batch, %left, %right) : (channel<tile<16xi32>>, channel<tile<16xi32>>, channel<tile<16xi32>>)
  }
}

// ----
worker 0: transport=channel-copy execution_counts=exact batches=1 streams=0
  batch 0: records=2 replays=3
    record 0: admission=%first source=%batch admissions=2 transfers=6 final_release=yes destinations=%left,%right
    record 1: admission=%second source=%batch admissions=2 transfers=6 final_release=yes destinations=%left,%right

// ====
// RUN: emit pipeline-transport @test

// Copies consume one-shot records without requiring a separate final release.
func.def @worker(%source: channel<tile<16xi32>>, %left: channel<tile<16xi32>>) {
  %a = channel.accept %source : channel<tile<16xi32>> -> read<tile<16xi32>>
  %b = channel.accept %source : channel<tile<16xi32>> -> read<tile<16xi32>>
  %first, %first_view = channel.reserve %left : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
  channel.copy %a -> %first : read<tile<16xi32>>, write<tile<16xi32>>
  %second, %second_view = channel.reserve %left : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
  channel.copy %b -> %second : read<tile<16xi32>>, write<tile<16xi32>>
  func.return
}

pipeline.def<kernel> public @test() run(%source_storage: buffer, %left_storage: buffer) {
  %origin = index.constant 0 : offset
  %source_capacity = index.constant 2 : index
  %destination_capacity = index.constant 1 : index
  %source_slots = buffer.view %source_storage[%origin] : buffer -> view<2x16xi32>
  %source = channel.bind<fifo> %source_slots, %source_capacity : view<2x16xi32>, index -> channel<tile<16xi32>>
  %left_slots = buffer.view %left_storage[%origin] : buffer -> view<1x16xi32>
  %left = channel.bind<fifo> %left_slots, %destination_capacity : view<1x16xi32>, index -> channel<tile<16xi32>>
  pipeline.strand workers([0], [1], [1]) {
    func.call @worker(%source, %left) : (channel<tile<16xi32>>, channel<tile<16xi32>>)
  }
}

// ----
worker 0: transport=channel-copy execution_counts=exact batches=1 streams=0
  batch 0: records=2 replays=1
    record 0: admission=%a source=%source admissions=1 transfers=1 final_release=no destinations=%left
    record 1: admission=%b source=%source admissions=1 transfers=1 final_release=no destinations=%left

// ====
// RUN: emit pipeline-transport @test

// Equal payloads and destinations do not merge different source channels.
func.def @worker(%source: channel<tile<16xi32>>, %other: channel<tile<16xi32>>, %left: channel<tile<16xi32>>) {
  %a = channel.accept %source : channel<tile<16xi32>> -> read<tile<16xi32>>
  %b = channel.accept %other : channel<tile<16xi32>> -> read<tile<16xi32>>
  %first, %first_view = channel.reserve %left : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
  channel.copy %a -> %first : read<tile<16xi32>>, write<tile<16xi32>>
  %second, %second_view = channel.reserve %left : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
  channel.copy %b -> %second : read<tile<16xi32>>, write<tile<16xi32>>
  func.return
}

pipeline.def<kernel> public @test() run(%source_storage: buffer, %other_storage: buffer, %left_storage: buffer) {
  %origin = index.constant 0 : offset
  %source_capacity = index.constant 2 : index
  %destination_capacity = index.constant 1 : index
  %source_slots = buffer.view %source_storage[%origin] : buffer -> view<2x16xi32>
  %source = channel.bind<fifo> %source_slots, %source_capacity : view<2x16xi32>, index -> channel<tile<16xi32>>
  %other_slots = buffer.view %other_storage[%origin] : buffer -> view<2x16xi32>
  %other = channel.bind<fifo> %other_slots, %source_capacity : view<2x16xi32>, index -> channel<tile<16xi32>>
  %left_slots = buffer.view %left_storage[%origin] : buffer -> view<1x16xi32>
  %left = channel.bind<fifo> %left_slots, %destination_capacity : view<1x16xi32>, index -> channel<tile<16xi32>>
  pipeline.strand workers([0], [1], [1]) {
    func.call @worker(%source, %other, %left) : (channel<tile<16xi32>>, channel<tile<16xi32>>, channel<tile<16xi32>>)
  }
}

// ----
worker 0: transport=channel-copy execution_counts=exact batches=2 streams=0
  batch 0: records=1 replays=1
    record 0: admission=%a source=%source admissions=1 transfers=1 final_release=no destinations=%left
  batch 1: records=1 replays=1
    record 0: admission=%b source=%other admissions=1 transfers=1 final_release=no destinations=%left

// ====
// RUN: emit pipeline-transport @test

// The same destinations in a different order require separate batches.
func.def @worker(%source: channel<tile<16xi32>>, %left: channel<tile<16xi32>>, %right: channel<tile<16xi32>>) {
  %a = channel.accept %source : channel<tile<16xi32>> -> read<tile<16xi32>>
  %b = channel.accept %source : channel<tile<16xi32>> -> read<tile<16xi32>>
  %al, %ar = channel.fanout %a : read<tile<16xi32>> -> (read<tile<16xi32>>, read<tile<16xi32>>)
  %first_left, %first_left_view = channel.reserve %left : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
  channel.copy %al -> %first_left : read<tile<16xi32>>, write<tile<16xi32>>
  %first_right, %first_right_view = channel.reserve %right : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
  channel.copy %ar -> %first_right : read<tile<16xi32>>, write<tile<16xi32>>
  %bl, %br = channel.fanout %b : read<tile<16xi32>> -> (read<tile<16xi32>>, read<tile<16xi32>>)
  %second_right, %second_right_view = channel.reserve %right : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
  channel.copy %br -> %second_right : read<tile<16xi32>>, write<tile<16xi32>>
  %second_left, %second_left_view = channel.reserve %left : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
  channel.copy %bl -> %second_left : read<tile<16xi32>>, write<tile<16xi32>>
  func.return
}

pipeline.def<kernel> public @test() run(%source_storage: buffer, %left_storage: buffer, %right_storage: buffer) {
  %origin = index.constant 0 : offset
  %source_capacity = index.constant 2 : index
  %destination_capacity = index.constant 1 : index
  %source_slots = buffer.view %source_storage[%origin] : buffer -> view<2x16xi32>
  %source = channel.bind<fifo> %source_slots, %source_capacity : view<2x16xi32>, index -> channel<tile<16xi32>>
  %left_slots = buffer.view %left_storage[%origin] : buffer -> view<1x16xi32>
  %left = channel.bind<fifo> %left_slots, %destination_capacity : view<1x16xi32>, index -> channel<tile<16xi32>>
  %right_slots = buffer.view %right_storage[%origin] : buffer -> view<1x16xi32>
  %right = channel.bind<fifo> %right_slots, %destination_capacity : view<1x16xi32>, index -> channel<tile<16xi32>>
  pipeline.strand workers([0], [1], [1]) {
    func.call @worker(%source, %left, %right) : (channel<tile<16xi32>>, channel<tile<16xi32>>, channel<tile<16xi32>>)
  }
}

