inventory invocations=5 workers=0 channels=3
  protocol 0 = 0:%shared external
  protocol 1 = 1:%local external
  protocol 2 = 3:%local external
invocation 0 @test strands=0 channels=1
  joined block=0 step=0
invocation 1 @wrapper strands=0 channels=1
  channel %shared = 0:%shared capacity=1 inventory=0
  joined block=0 step=0
invocation 2 @leaf strands=0 channels=0
  channel %local = 1:%local capacity=1 inventory=1
  channel %shared = 0:%shared capacity=1 inventory=0
  joined block=0 step=1
invocation 3 @wrapper strands=0 channels=1
  channel %shared = 0:%shared capacity=1 inventory=0
  joined block=0 step=0
invocation 4 @leaf strands=0 channels=0
  channel %local = 3:%local capacity=1 inventory=2
  channel %shared = 0:%shared capacity=1 inventory=0

// ====
// RUN: emit pipeline-invocations @test

// Concurrent and joined occurrences preserve their different completion
// boundaries even when their callee and actual scalar value are identical.
pipeline.def @child() run(%count: index) {
}

pipeline.def public @test() run() {
  %count = index.constant 28 : index
  pipeline.compose @child(%count) : (index)
  pipeline.serial {
    pipeline.compose @child(%count) : (index)
  }
}

// ----
inventory invocations=3 workers=0 channels=0
invocation 0 @test strands=0 channels=0
  concurrent 0
invocation 1 @child strands=0 channels=0
  scalar %count = 28
  joined block=0 step=0
invocation 2 @child strands=0 channels=0
  scalar %count = 28

// ====
// RUN: emit pipeline-invocations @test

pipeline.decl @missing() run()

pipeline.def public @test() run() {
  pipeline.serial {
    // ERROR@+1: LOWERING/066 {requirement="a visible child pipeline construction"}
    pipeline.compose @missing() : ()
  }
}

// ====
// RUN: emit pipeline-invocations @test

pipeline.def @child() run() {
  pipeline.serial {
    // ERROR@+1: LOWERING/066 {requirement="finite nonrecursive pipeline construction"}
    pipeline.compose @test() : ()
  }
}

pipeline.def public @test() run() {
  pipeline.serial {
    pipeline.compose @child() : ()
  }
}
