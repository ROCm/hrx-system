pipeline.def public @test() run(%input_argument: buffer, %output_argument: buffer, %storage_argument: buffer) {
  %input_unique, %output_unique, %storage_unique = buffer.assume.noalias %input_argument, %output_argument, %storage_argument : buffer, buffer, buffer
  %input = buffer.assume.memory_space<global> %input_unique : buffer
  %output = buffer.assume.memory_space<global> %output_unique : buffer
  %storage = buffer.assume.memory_space<workgroup> %storage_unique : buffer
  %origin = index.constant 0 : offset
  %capacity = index.constant 2 : index
  %input_view = buffer.view %input[%origin] : buffer -> view<16xi32>
  %output_view = buffer.view %output[%origin] : buffer -> view<16xi32>
  %slots = buffer.view %storage[%origin] : buffer -> view<2x16xi32>
  %records = channel.bind<fifo> %slots, %capacity : view<2x16xi32>, index -> channel<tile<16xi32>>
  pipeline.compose @producer(%input_view, %records) : (view<16xi32>, channel<tile<16xi32>>)
  pipeline.compose @consumer(%output_view, %records) : (view<16xi32>, channel<tile<16xi32>>)
