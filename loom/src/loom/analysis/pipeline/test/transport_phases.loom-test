// ====

// RUN: emit pipeline-transport @stream phases

// Two reservations and copies complete together. The ordered transport remains
// represented, but there are no independently completed input phases.
func.def @worker(%source: channel<tile<8xi32>>, %panels: channel<tile<4xi32>>, %second_panels: channel<tile<4xi32>>, %storage: buffer) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %end = index.constant 4 : index
  %read, %payload = channel.acquire %source : channel<tile<8xi32>> -> (read<tile<8xi32>>, view<8xi32>)
  %head = view.subview %payload[0] : view<8xi32> -> view<4xi32>
  %tail = view.subview %payload[4] : view<8xi32> -> view<4xi32>
  cfg.br ^header(%begin: index)
^header(%iteration: index):
  %more = index.cmp ult, %iteration, %end : index
  cfg.cond_br %more, ^transfer, ^done
^transfer:
  %first, %first_view = channel.reserve %panels : channel<tile<4xi32>> -> (write<tile<4xi32>>, view<4xi32>)
  %head_copy = kernel.async.copy %head to %first_view {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<4xi32> to view<4xi32> -> kernel.async.token
  %second, %second_view = channel.reserve %second_panels : channel<tile<4xi32>> -> (write<tile<4xi32>>, view<4xi32>)
  %tail_copy = kernel.async.copy %tail to %second_view {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<4xi32> to view<4xi32> -> kernel.async.token
  %tail_group = kernel.async.group %head_copy, %tail_copy : kernel.async.token, kernel.async.token -> kernel.async.group
  kernel.async.wait %tail_group {newer_groups = 0} : kernel.async.group
  channel.publish %first : write<tile<4xi32>>
  channel.publish %second : write<tile<4xi32>>
  %next = index.add %iteration, %step : index
  cfg.br ^header(%next: index)
^done:
  channel.release %read : read<tile<8xi32>>
  func.return
}

pipeline.def<kernel> public @stream() run(%external_arg: buffer, %local_arg: buffer, %second_arg: buffer) {
  %external_unique, %local_unique, %second_unique = buffer.assume.noalias %external_arg, %local_arg, %second_arg : buffer, buffer, buffer
  %external = buffer.assume.memory_space<global> %external_unique : buffer
  %local = buffer.assume.memory_space<workgroup> %local_unique : buffer
  %second_storage = buffer.assume.memory_space<workgroup> %second_unique : buffer
  %origin = index.constant 0 : offset
  %capacity = index.constant 2 : index
  %source_slots = buffer.view %external[%origin] : buffer -> view<2x8xi32>
  %source = channel.bind<fifo> %source_slots, %capacity : view<2x8xi32>, index -> channel<tile<8xi32>>
  %panel_slots = buffer.view %local[%origin] : buffer -> view<2x4xi32>
  %panels = channel.bind<fifo> %panel_slots, %capacity : view<2x4xi32>, index -> channel<tile<4xi32>>
  %second_slots = buffer.view %second_storage[%origin] : buffer -> view<2x4xi32>
  %second_panels = channel.bind<fifo> %second_slots, %capacity : view<2x4xi32>, index -> channel<tile<4xi32>>
  pipeline.strand workers([0], [1], [1]) {
    func.call @worker(%source, %panels, %second_panels, %external) : (channel<tile<8xi32>>, channel<tile<4xi32>>, channel<tile<4xi32>>, buffer)
  }
}

