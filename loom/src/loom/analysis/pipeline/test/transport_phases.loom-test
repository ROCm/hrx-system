// RUN: emit pipeline-transport @stream phases

// One full-projection input stream, with scales published before the panels.
// One lease owns 96 F32 scales followed by a packed 96x16384 I8 tile.
// Scales enter once; the tile makes eight complete 256-panel passes.
func.def @ingress(%input: channel<tile<1573248xi8>>, %scales: channel<tile<96xf32>>, %panels: channel<tile<6144xi8>>) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %row_groups = index.constant 11 : index
  %column_groups = index.constant 8 : index
  %panel_count = index.constant 256 : index
  %panel_bytes = index.constant 6144 : index
  %prefix_bytes = index.constant 384 : index
  cfg.br ^record_header(%begin: index)
^record_header(%record: index):
  %more_records = index.cmp ult, %record, %row_groups : index
  cfg.cond_br %more_records, ^admit, ^done
^admit:
  %read, %payload = channel.acquire %input : channel<tile<1573248xi8>> -> (read<tile<1573248xi8>>, view<1573248xi8>)
  %prefix = view.subview %payload[0] : view<1573248xi8> -> view<384xi8>
  %source_scales = view.bitcast %prefix : view<384xi8> -> view<96xf32>
  %scale_write, %destination_scales = channel.reserve %scales : channel<tile<96xf32>> -> (write<tile<96xf32>>, view<96xf32>)
  %scale_copy = kernel.async.copy %source_scales to %destination_scales {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<96xf32> to view<96xf32> -> kernel.async.token
  %scale_group = kernel.async.group %scale_copy : kernel.async.token -> kernel.async.group
  kernel.async.wait %scale_group {newer_groups = 0} : kernel.async.group
  channel.publish %scale_write : write<tile<96xf32>>
  cfg.br ^column_header(%begin: index)
^column_header(%column: index):
  %more_columns = index.cmp ult, %column, %column_groups : index
  cfg.cond_br %more_columns, ^panel_entry, ^release
^panel_entry:
  cfg.br ^panel_header(%begin: index)
^panel_header(%panel: index):
  %more_panels = index.cmp ult, %panel, %panel_count : index
  cfg.cond_br %more_panels, ^transfer, ^next_column
^transfer:
  %panel_offset = index.madd %panel, %panel_bytes, %prefix_bytes : index
  %source_panel = view.subview %payload[%panel_offset] : view<1573248xi8> -> view<6144xi8>
  %write, %destination = channel.reserve %panels : channel<tile<6144xi8>> -> (write<tile<6144xi8>>, view<6144xi8>)
  %copy = kernel.async.copy %source_panel to %destination {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<6144xi8> to view<6144xi8> -> kernel.async.token
  %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
  kernel.async.wait %group {newer_groups = 0} : kernel.async.group
  channel.publish %write : write<tile<6144xi8>>
  %next_panel = index.add %panel, %step : index
  cfg.br ^panel_header(%next_panel: index)
^next_column:
  %next = index.add %column, %step : index
  cfg.br ^column_header(%next: index)
^release:
  channel.release %read : read<tile<1573248xi8>>
  %next_record = index.add %record, %step : index
  cfg.br ^record_header(%next_record: index)
^done:
  func.return
}

pipeline.def<kernel> public @stream() run(%external_arg: buffer, %local_scales_arg: buffer, %local_panels_arg: buffer) {
  %external_unique, %scales_unique, %panels_unique = buffer.assume.noalias %external_arg, %local_scales_arg, %local_panels_arg : buffer, buffer, buffer
  %external = buffer.assume.memory_space<global> %external_unique : buffer
  %scale_storage = buffer.assume.memory_space<workgroup> %scales_unique : buffer
  %panel_storage = buffer.assume.memory_space<workgroup> %panels_unique : buffer
  %origin = index.constant 0 : offset
  %capacity = index.constant 2 : index
  %scale_capacity = index.constant 1 : index
  %input_slots = buffer.view %external[%origin] : buffer -> view<2x1573248xi8>
  %input = channel.bind<fifo> %input_slots, %capacity : view<2x1573248xi8>, index -> channel<tile<1573248xi8>>
  %scale_slots = buffer.view %scale_storage[%origin] : buffer -> view<1x96xf32>
  %scales = channel.bind<fifo> %scale_slots, %scale_capacity : view<1x96xf32>, index -> channel<tile<96xf32>>
  %panel_slots = buffer.view %panel_storage[%origin] : buffer -> view<2x6144xi8>
  %panels = channel.bind<fifo> %panel_slots, %capacity : view<2x6144xi8>, index -> channel<tile<6144xi8>>
  pipeline.strand workers([0], [1], [1]) {
    func.call @ingress(%input, %scales, %panels) : (channel<tile<1573248xi8>>, channel<tile<96xf32>>, channel<tile<6144xi8>>)
  }
}

