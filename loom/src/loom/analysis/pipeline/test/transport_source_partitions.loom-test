// ====
// RUN: emit pipeline-transport @stream

// Different argument values alone do not prove disjoint storage.
func.def @produce(%input: buffer, %records: channel<tile<1xi32>>) {
  %begin = index.constant 0 : index
  %end = index.constant 8 : index
  %step = index.constant 1 : index
  %origin = index.constant 0 : offset
  %source = buffer.view %input[%origin] : buffer -> view<1xi32>
  cfg.br ^header(%begin: index)
^header(%iteration: index):
  %more = index.cmp ult, %iteration, %end : index
  cfg.cond_br %more, ^body, ^done
^body:
  %write, %payload = channel.reserve %records : channel<tile<1xi32>> -> (write<tile<1xi32>>, view<1xi32>)
  %transfer = kernel.async.copy %source to %payload {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<1xi32> to view<1xi32> -> kernel.async.token
  %group = kernel.async.group %transfer : kernel.async.token -> kernel.async.group
  kernel.async.wait %group {newer_groups = 0} : kernel.async.group
  channel.publish %write : write<tile<1xi32>>
  %next = index.add %iteration, %step : index
  cfg.br ^header(%next: index)
^done:
  func.return
}

func.def @consume(%output: buffer, %records: channel<tile<1xi32>>) {
  %begin = index.constant 0 : index
  %end = index.constant 8 : index
  %step = index.constant 1 : index
  %origin = index.constant 0 : offset
  %destination = buffer.view %output[%origin] : buffer -> view<1xi32>
  cfg.br ^header(%begin: index)
^header(%iteration: index):
  %more = index.cmp ult, %iteration, %end : index
  cfg.cond_br %more, ^body, ^done
^body:
  %read, %payload = channel.acquire %records : channel<tile<1xi32>> -> (read<tile<1xi32>>, view<1xi32>)
  %value = view.load %payload[0] : view<1xi32> -> i32
  view.store %value, %destination[0] : i32, view<1xi32>
  channel.release %read : read<tile<1xi32>>
  %next = index.add %iteration, %step : index
  cfg.br ^header(%next: index)
^done:
