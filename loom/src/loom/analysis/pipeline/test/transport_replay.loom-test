  batch 0: records=1 replays=0
    record 0: admission=%first source=%source admissions=1 transfers=0 final_release=yes destinations=%left,%left
    copy_order: %first->%left %first->%left %first->%left %first->%left %first->%left %first->%left

// ====
// RUN: emit pipeline-transport @test

// Successive ownership intervals remain separate after a one-iteration loop folds.

func.def @worker(%source: channel<tile<16xi32>>, %left: channel<tile<16xi32>>) {
  %a0 = channel.accept %source : channel<tile<16xi32>> -> read<tile<16xi32>>
  %b0 = channel.accept %source : channel<tile<16xi32>> -> read<tile<16xi32>>
  %keep_a0, %copy_a0 = channel.fanout %a0 : read<tile<16xi32>> -> (read<tile<16xi32>>, read<tile<16xi32>>)
  %write_a0, %payload_a0 = channel.reserve %left : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
  channel.copy %copy_a0 -> %write_a0 : read<tile<16xi32>>, write<tile<16xi32>>
  %keep_b0, %copy_b0 = channel.fanout %b0 : read<tile<16xi32>> -> (read<tile<16xi32>>, read<tile<16xi32>>)
  %write_b0, %payload_b0 = channel.reserve %left : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
  channel.copy %copy_b0 -> %write_b0 : read<tile<16xi32>>, write<tile<16xi32>>
  channel.release %keep_a0 : read<tile<16xi32>>
  channel.release %keep_b0 : read<tile<16xi32>>
  %a1 = channel.accept %source : channel<tile<16xi32>> -> read<tile<16xi32>>
  %b1 = channel.accept %source : channel<tile<16xi32>> -> read<tile<16xi32>>
  %keep_a1, %copy_a1 = channel.fanout %a1 : read<tile<16xi32>> -> (read<tile<16xi32>>, read<tile<16xi32>>)
  %write_a1, %payload_a1 = channel.reserve %left : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
  channel.copy %copy_a1 -> %write_a1 : read<tile<16xi32>>, write<tile<16xi32>>
  %keep_b1, %copy_b1 = channel.fanout %b1 : read<tile<16xi32>> -> (read<tile<16xi32>>, read<tile<16xi32>>)
  %write_b1, %payload_b1 = channel.reserve %left : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
  channel.copy %copy_b1 -> %write_b1 : read<tile<16xi32>>, write<tile<16xi32>>
  channel.release %keep_a1 : read<tile<16xi32>>
  channel.release %keep_b1 : read<tile<16xi32>>
  func.return
}

pipeline.def<kernel> public @test() run(%source_storage: buffer, %left_storage: buffer) {
  %origin = index.constant 0 : offset
  %source_capacity = index.constant 2 : index
  %destination_capacity = index.constant 1 : index
  %source_slots = buffer.view %source_storage[%origin] : buffer -> view<2x16xi32>
  %source = channel.bind<fifo> %source_slots, %source_capacity : view<2x16xi32>, index -> channel<tile<16xi32>>
  %left_slots = buffer.view %left_storage[%origin] : buffer -> view<1x16xi32>
  %left = channel.bind<fifo> %left_slots, %destination_capacity : view<1x16xi32>, index -> channel<tile<16xi32>>
  pipeline.strand workers([0], [1], [1]) {
    func.call @worker(%source, %left) : (channel<tile<16xi32>>, channel<tile<16xi32>>)
  }
}

