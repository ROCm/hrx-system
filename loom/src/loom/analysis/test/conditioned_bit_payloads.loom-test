    %lo = test.fact_range_lo %payload : i16 -> i64
    %hi = test.fact_range_hi %payload : i16 -> i64
    %expected_lo = scalar.constant 1 : i64
    %expected_hi = scalar.constant 3 : i64
    %low_matches = scalar.cmpi eq, %lo, %expected_lo : i64
    %high_matches = scalar.cmpi eq, %hi, %expected_hi : i64
    %matches = scalar.andi %low_matches, %high_matches : i1
