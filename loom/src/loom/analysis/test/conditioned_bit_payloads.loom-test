// RUN: pass unroll-scf-for,dce

// Each payload is defined before its source guard. The inner range observations
// must agree with the concrete low-bit interpretation, proving one iteration.
// Exact output checks both bounds and prevents an unrefined or empty proof from
// passing just because the source still prints.

func.def @guarded_byte_mask(%input: i8) {
  %mask = scalar.constant 7 : i8
  %payload = scalar.andi %input, %mask : i8
  %lower = scalar.constant 4 : i8
  %upper = scalar.constant 6 : i8
  %above = scalar.cmpi sge, %input, %lower : i8
  %below = scalar.cmpi sle, %input, %upper : i8
  %valid = scalar.andi %above, %below : i1
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  scf.if %valid {
    %lo = test.fact_range_lo %payload : i8 -> i64
    %hi = test.fact_range_hi %payload : i8 -> i64
    %expected_lo = scalar.constant 4 : i64
    %expected_hi = scalar.constant 6 : i64
    %low_matches = scalar.cmpi eq, %lo, %expected_lo : i64
    %high_matches = scalar.cmpi eq, %hi, %expected_hi : i64
    %matches = scalar.andi %low_matches, %high_matches : i1
    %count = index.cast %matches : i1 to index
    scf.for %iteration = [%begin to %count step %step] unroll {
      test.use %iteration : index
    }
  }
  func.return
}

// ----
func.def @guarded_byte_mask(%input: i8) {
  %lower = scalar.constant 4 : i8
  %upper = scalar.constant 6 : i8
  %above = scalar.cmpi sge, %input, %lower : i8
  %below = scalar.cmpi sle, %input, %upper : i8
  %valid = scalar.andi %above, %below : i1
  scf.if %valid {
    %iteration_0 = index.constant 0 : index
    test.use %iteration_0 : index
  }
  func.return
}

