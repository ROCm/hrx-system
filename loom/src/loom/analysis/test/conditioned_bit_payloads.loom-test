func.def @guarded_commuted_halfword_mask(%input: i16) {
  %mask = scalar.constant 2047 : i16
  %payload = scalar.andi %mask, %input : i16
  %lower = scalar.constant -32767 : i16
  %upper = scalar.constant -32765 : i16
  %above = scalar.cmpi sge, %input, %lower : i16
  %below = scalar.cmpi sle, %input, %upper : i16
  %valid = scalar.andi %above, %below : i1
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
