// ====

// The holes in this mask matter: input two produces zero, not a three-bit
// interpretation of two. A later source guard cannot claim the latter.
func.def @noncontiguous_mask(%input: i16) {
  %mask = scalar.constant 5 : i16
  %payload = scalar.andi %input, %mask : i16
  %selected = scalar.constant 2 : i16
  %matches = scalar.cmpi eq, %input, %selected : i16
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  scf.if %matches {
    %lo = test.fact_range_lo %payload : i16 -> i64
    %expected = scalar.constant 0 : i64
    %contains_zero = scalar.cmpi eq, %lo, %expected : i64
    %count = index.cast %contains_zero : i1 to index
    scf.for %iteration = [%begin to %count step %step] unroll {
      test.use %iteration : index
    }
  }
  func.return
}

// ----
func.def @noncontiguous_mask(%input: i16) {
  %selected = scalar.constant 2 : i16
  %matches = scalar.cmpi eq, %input, %selected : i16
  scf.if %matches {
    %iteration_0 = index.constant 0 : index
    test.use %iteration_0 : index
  }
  func.return
}

// ====

// An interval of masks is not one exact mask. Input two can produce zero or
// two, and the proof must retain zero as a possible result under the guard.
func.def @dynamic_mask(%input: i16, %mask: i16) where [range(%mask, 1, 7)] {
  %payload = scalar.andi %mask, %input : i16
  %selected = scalar.constant 2 : i16
  %matches = scalar.cmpi eq, %input, %selected : i16
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  scf.if %matches {
    %lo = test.fact_range_lo %payload : i16 -> i64
    %expected = scalar.constant 0 : i64
    %contains_zero = scalar.cmpi eq, %lo, %expected : i64
    %count = index.cast %contains_zero : i1 to index
    scf.for %iteration = [%begin to %count step %step] unroll {
      test.use %iteration : index
    }
  }
  func.return
}

// ----
func.def @dynamic_mask(%input: i16, %mask: i16) where [range(%mask, 1, 7)] {
  %selected = scalar.constant 2 : i16
  %matches = scalar.cmpi eq, %input, %selected : i16
  scf.if %matches {
    %iteration_0 = index.constant 0 : index
    test.use %iteration_0 : index
  }
  func.return
}

// ====

// A sign-preserving mask must still admit the negative concrete result.
func.def @negative_mask(%input: i16) {
  %mask = scalar.constant -8 : i16
  %payload = scalar.andi %input, %mask : i16
  %selected = scalar.constant -1 : i16
  %matches = scalar.cmpi eq, %input, %selected : i16
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  scf.if %matches {
    %lo = test.fact_range_lo %payload : i16 -> i64
    %hi = test.fact_range_hi %payload : i16 -> i64
    %expected = scalar.constant -8 : i64
    %low_contains = scalar.cmpi sle, %lo, %expected : i64
    %high_contains = scalar.cmpi sge, %hi, %expected : i64
    %contains = scalar.andi %low_contains, %high_contains : i1
    %count = index.cast %contains : i1 to index
    scf.for %iteration = [%begin to %count step %step] unroll {
      test.use %iteration : index
    }
  }
  func.return
}

// ----
func.def @negative_mask(%input: i16) {
  %selected = scalar.constant -1 : i16
  %matches = scalar.cmpi eq, %input, %selected : i16
  scf.if %matches {
    %iteration_0 = index.constant 0 : index
    test.use %iteration_0 : index
  }
  func.return
}

// ====

// A shifted field is not the low payload of its source. Input eight extracts
// one; interpreting its low three bits instead would incorrectly prove zero.
func.def @shifted_field(%input: i16) {
  %payload = scalar.bitfield.extractu %input {offset = 3, width = 3} : i16 -> i16
  %selected = scalar.constant 8 : i16
  %matches = scalar.cmpi eq, %input, %selected : i16
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  scf.if %matches {
    %hi = test.fact_range_hi %payload : i16 -> i64
    %expected = scalar.constant 1 : i64
    %contains_one = scalar.cmpi sge, %hi, %expected : i64
    %count = index.cast %contains_one : i1 to index
    scf.for %iteration = [%begin to %count step %step] unroll {
      test.use %iteration : index
    }
  }
  func.return
}

// ----
func.def @shifted_field(%input: i16) {
  %selected = scalar.constant 8 : i16
  %matches = scalar.cmpi eq, %input, %selected : i16
  scf.if %matches {
    %iteration_0 = index.constant 0 : index
    test.use %iteration_0 : index
  }
  func.return
}
