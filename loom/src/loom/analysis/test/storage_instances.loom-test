// ====

// Async completion outlives the last SSA handle use.
func.def @test(%input: buffer) -> (i32) {
  %global = buffer.assume.memory_space<global> %input : buffer
  %origin = index.constant 0 : offset
  %source = buffer.view %global[%origin] : buffer -> view<1xi32>
  %bytes = index.constant 4 : offset
  %limit = index.constant 8 : index
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %seed = scalar.constant 0 : i32
  %increment = scalar.constant 1 : i32
  %initial_storage = buffer.alloca<workgroup> align(4) %bytes : buffer
  %initial_view = buffer.view %initial_storage[%origin] : buffer -> view<1xi32>
  view.store %seed, %initial_view[0] : i32, view<1xi32>
  %sum, %value, %last = scf.for %i = [%begin to %limit step %step](%accumulator = %seed : i32, %previous_value = %seed : i32, %previous = %initial_storage : buffer) -> (i32, i32, buffer) {
    %previous_root = buffer.assume.memory_space<workgroup> %previous : buffer
    %previous_view = buffer.view %previous_root[%origin] : buffer -> view<1xi32>
    %copy = kernel.async.copy %source to %previous_view {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<1xi32> to view<1xi32> -> kernel.async.token
    %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %storage = buffer.alloca<workgroup> align(4) %bytes : buffer
    %slot = buffer.view %storage[%origin] : buffer -> view<1xi32>
    %next_value = scalar.addi %previous_value, %increment : i32
    view.store %next_value, %slot[0] : i32, view<1xi32>
    %next_sum = scalar.addi %accumulator, %next_value : i32
    kernel.async.wait %group {newer_groups = 0} : kernel.async.group
    scf.yield %next_sum, %next_value, %storage : i32, i32, buffer
  }
  func.return %sum : i32
}

