// ====

// While regions carry storage instances through both control edges.
func.def @test(%again: i1, %value: i32) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %initial = buffer.alloca<workgroup> align(4) %bytes : buffer
  %initial_view = buffer.view %initial[%origin] : buffer -> view<1xi32>
  view.store %value, %initial_view[0] : i32, view<1xi32>
  %last = scf.while(%previous = %initial_view : view<1xi32>) -> (view<1xi32>) {
    scf.condition %again, %previous : i1, view<1xi32>
  } do(%current: view<1xi32>) {
    %storage = buffer.alloca<workgroup> align(4) %bytes : buffer
    %slot = buffer.view %storage[%origin] : buffer -> view<1xi32>
    view.store %value, %slot[0] : i32, view<1xi32>
    %old = view.load %current[0] : view<1xi32> -> i32
    scf.yield %slot : view<1xi32>
  }
  func.return
}

