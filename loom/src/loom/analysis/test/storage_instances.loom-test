// ====

// A nested structured region inherits its enclosing CFG repetition.
func.def @test(%again: i1, %value: i32) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %initial = buffer.alloca<private> align(4) %bytes : buffer
  %initial_view = buffer.view %initial[%origin] : buffer -> view<1xi32>
  view.store %value, %initial_view[0] : i32, view<1xi32>
  cfg.br ^loop(%initial: buffer)
^loop(%previous: buffer):
  %storage = scf.if %again -> (buffer) {
    %nested = buffer.alloca<private> align(4) %bytes : buffer
    scf.yield %nested : buffer
  } else {
    scf.yield %previous : buffer
  }
  %slot = buffer.view %storage[%origin] : buffer -> view<1xi32>
  view.store %value, %slot[0] : i32, view<1xi32>
  %old_view = buffer.view %previous[%origin] : buffer -> view<1xi32>
  %old = view.load %old_view[0] : view<1xi32> -> i32
  cfg.cond_br %again, ^backedge, ^exit
^backedge:
  cfg.br ^loop(%storage: buffer)
^exit:
  func.return
}

// ----
initial: accessed=yes single_instance=yes
nested: accessed=yes single_instance=unproven
initial / nested: workgroup_nonoverlap=unproven

// ====

// Opaque effects prevent a repeated-instance lifetime proof.
func.def @test(%limit: index) -> (i32) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %seed = scalar.constant 0 : i32
  %increment = scalar.constant 1 : i32
  %initial_storage = buffer.alloca<private> align(4) %bytes : buffer
  %initial_view = buffer.view %initial_storage[%origin] : buffer -> view<1xi32>
  view.store %seed, %initial_view[0] : i32, view<1xi32>
  %sum, %value, %last = scf.for %i = [%begin to %limit step %step](%accumulator = %seed : i32, %previous_value = %seed : i32, %previous = %initial_view : view<1xi32>) -> (i32, i32, view<1xi32>) {
    %storage = buffer.alloca<private> align(4) %bytes : buffer
    %slot = buffer.view %storage[%origin] : buffer -> view<1xi32>
    %next_value = scalar.addi %previous_value, %increment : i32
    view.store %next_value, %slot[0] : i32, view<1xi32>
    %next_sum = scalar.addi %accumulator, %next_value : i32
    test.use %storage : buffer
    scf.yield %next_sum, %next_value, %slot : i32, i32, view<1xi32>
  }
  %result = view.load %last[0] : view<1xi32> -> i32
  func.return %result : i32
}

