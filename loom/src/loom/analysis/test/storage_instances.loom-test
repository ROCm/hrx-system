// ====

// The condition region also executes again on a while backedge.
func.def @test(%again: i1, %value: i32) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %initial = buffer.alloca<private> align(4) %bytes : buffer
  %initial_view = buffer.view %initial[%origin] : buffer -> view<1xi32>
  view.store %value, %initial_view[0] : i32, view<1xi32>
  %last = scf.while(%previous = %initial : buffer) -> (buffer) {
    %storage = buffer.alloca<private> align(4) %bytes : buffer
    %slot = buffer.view %storage[%origin] : buffer -> view<1xi32>
    view.store %value, %slot[0] : i32, view<1xi32>
    %old_view = buffer.view %previous[%origin] : buffer -> view<1xi32>
    %old = view.load %old_view[0] : view<1xi32> -> i32
    scf.condition %again, %storage : i1, buffer
  } do(%current: buffer) {
    scf.yield %current : buffer
  }
  func.return
}

