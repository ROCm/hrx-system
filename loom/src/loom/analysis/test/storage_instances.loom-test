// ====

// A completion outside the recognized same-block group chain remains unproven.
func.def @test(%input: buffer) {
  %global = buffer.assume.memory_space<global> %input : buffer
  %origin = index.constant 0 : offset
  %source = buffer.view %global[%origin] : buffer -> view<1xi32>
  %bytes = index.constant 4 : offset
  %begin = index.constant 0 : index
  %end = index.constant 8 : index
  %step = index.constant 1 : index
  %complete = scalar.constant 1 : i1
  scf.for %i = [%begin to %end step %step] {
    %storage = buffer.alloca<workgroup> align(4) %bytes : buffer
    %slot = buffer.view %storage[%origin] : buffer -> view<1xi32>
    %copy = kernel.async.copy %source to %slot {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<1xi32> to view<1xi32> -> kernel.async.token
    %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
    scf.if %complete {
      kernel.async.wait %group {newer_groups = 0} : kernel.async.group
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  }
  func.return
}

// ----
storage: accessed=yes single_instance=unproven

// ====

// Shared storage needs no collective retirement in a single-invocation launch.
kernel.def @test() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch() {
  %value = scalar.constant 7 : i32
  %origin = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %begin = index.constant 0 : index
  %end = index.constant 8 : index
  %step = index.constant 1 : index
  scf.for %i = [%begin to %end step %step] {
    %storage = buffer.alloca<workgroup> align(4) %bytes : buffer
    %slot = buffer.view %storage[%origin] : buffer -> view<1xi32>
    view.store %value, %slot[0] : i32, view<1xi32>
  }
  kernel.return
}

// ----
storage: accessed=yes single_instance=yes

// ====

// Any non-unit workgroup dimension introduces peers requiring a rendezvous.
kernel.def @test() {
  %unit = index.constant 1 : index
  %height = index.constant 2 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %height, %unit) : index
} launch() {
  %value = scalar.constant 7 : i32
  %origin = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %begin = index.constant 0 : index
  %end = index.constant 8 : index
  %step = index.constant 1 : index
  scf.for %i = [%begin to %end step %step] {
    %storage = buffer.alloca<workgroup> align(4) %bytes : buffer
    %slot = buffer.view %storage[%origin] : buffer -> view<1xi32>
    view.store %value, %slot[0] : i32, view<1xi32>
  }
  kernel.return
}

// ----
storage: accessed=yes single_instance=unproven

// ====

// Direct and nested impure calls cannot discover fresh private scratch that
// has never been passed to them.
func.decl @service(%external: buffer)

func.def @forward_service(%external: buffer) {
  func.call @service(%external) : (buffer)
  func.return
}

func.def @test(%external: buffer, %limit: index) -> (i32) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %seed = scalar.constant 7 : i32
  %sum = scf.for %i = [%begin to %limit step %step](%accumulator = %seed : i32) -> (i32) {
    %scratch = buffer.alloca<private> align(4) %bytes : buffer
    %slot = buffer.view %scratch[%origin] : buffer -> view<1xi32>
    view.store %accumulator, %slot[0] : i32, view<1xi32>
    func.call @service(%external) : (buffer)
    func.call @forward_service(%external) : (buffer)
    %next = view.load %slot[0] : view<1xi32> -> i32
    scf.yield %next : i32
  }
  func.return %sum : i32
}

// ----
scratch: accessed=yes single_instance=yes

// ====

// Exposing either the root or an alias prevents static instance reuse. The
// opaque callee may retain the reference after returning.
func.decl @remember_buffer(%storage: buffer)

func.decl @remember_view(%storage: view<1xi32>)

func.def @test(%limit: index) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  scf.for %i = [%begin to %limit step %step] {
    %root = buffer.alloca<private> align(4) %bytes : buffer
    %alias_root = buffer.alloca<private> align(4) %bytes : buffer
    %alias = buffer.view %alias_root[%origin] : buffer -> view<1xi32>
    func.call @remember_buffer(%root) : (buffer)
    func.call @remember_view(%alias) : (view<1xi32>)
  }
  func.return
}

// ----
root: accessed=yes single_instance=unproven
alias_root: accessed=yes single_instance=unproven
root / alias_root: workgroup_nonoverlap=unproven

// ====

// Target-Low interop obeys the same boundary. Buffer exposure through a pure
// pointer conversion remains opaque even though the conversion has no effects.
test.target<low_core> @test_target

low.func.decl target<test.low.core>(@test_target) @wait_credit()

low.func.decl pure target<test.low.core>(@test_target) @encode_address(%storage: reg<test.ptr>) -> (reg<test.i64>)

low.func.decl target<test.low.core>(@test_target) @publish_address(%address: reg<test.i64>)

func.def @test(%limit: index) -> (i32) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %seed = scalar.constant 7 : i32
  %sum = scf.for %i = [%begin to %limit step %step](%accumulator = %seed : i32) -> (i32) {
    %scratch = buffer.alloca<private> align(4) %bytes : buffer
    %exposed = buffer.alloca<private> align(4) %bytes : buffer
    %slot = buffer.view %scratch[%origin] : buffer -> view<1xi32>
    view.store %accumulator, %slot[0] : i32, view<1xi32>
    low.invoke @wait_credit() : ()
    %address = low.invoke pure @encode_address(%exposed) : (buffer) -> (i64)
    low.invoke @publish_address(%address) : (i64)
    %next = view.load %slot[0] : view<1xi32> -> i32
    scf.yield %next : i32
  }
  func.return %sum : i32
}

// ----
scratch: accessed=yes single_instance=yes
exposed: accessed=yes single_instance=unproven
scratch / exposed: workgroup_nonoverlap=unproven

// ====

// Binding a channel exposes the backing storage through the channel identity.
// The callee may retain records even though it never receives a buffer or view.
func.decl @submit(%records: channel<tile<1xi32>>)

func.def @test(%limit: index) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %capacity = index.constant 1 : index
  scf.for %i = [%begin to %limit step %step] {
    %storage = buffer.alloca<private> align(4) %bytes : buffer
    %records = buffer.view %storage[%origin] : buffer -> view<1x1xi32>
    %channel = channel.bind<fifo> %records, %capacity : view<1x1xi32>, index -> channel<tile<1xi32>>
    func.call @submit(%channel) : (channel<tile<1xi32>>)
  }
  func.return
}

// ----
storage: accessed=yes single_instance=unproven
