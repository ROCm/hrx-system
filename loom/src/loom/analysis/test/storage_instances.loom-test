// ====

// A rendezvous after all accesses retires shared instances across invocations.
func.def @test(%value: i32) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %begin = index.constant 0 : index
  %end = index.constant 8 : index
  %step = index.constant 1 : index
  scf.for %i = [%begin to %end step %step] {
    %storage = buffer.alloca<workgroup> align(4) %bytes : buffer
    %slot = buffer.view %storage[%origin] : buffer -> view<1xi32>
    view.store %value, %slot[0] : i32, view<1xi32>
    %loaded = view.load %slot[0] : view<1xi32> -> i32
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  }
  func.return
}

