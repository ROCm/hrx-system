// RUN: emit storage-interference @test

// Distinguishes unused and accessed roots.
func.def @test() {
  %base = index.constant 0 : offset
  %bytes = index.constant 256 : offset
  %value = scalar.constant 1 : i32
  %unused = buffer.alloca<workgroup> align(16) %bytes : buffer
  %unused_view = buffer.view %unused[%base] : buffer -> view<1xi32>
  %accessed = buffer.alloca<workgroup> align(16) %bytes : buffer
  %accessed_view = buffer.view %accessed[%base] : buffer -> view<1xi32>
  view.store %value, %accessed_view[0] : i32, view<1xi32>
  func.return
}

// ----
unused: accessed=no single_instance=yes
accessed: accessed=yes single_instance=yes
unused / accessed: workgroup_nonoverlap=yes

// ====

// Incomplete root may be accessed.
func.def @test() {
  %bytes = index.constant 256 : offset
  %root = buffer.alloca<workgroup> align(16) %bytes : buffer
  test.use %root : buffer
  func.return
}

// ----
root: accessed=yes single_instance=yes

// ====

// Workgroup barrier separates sequential phases.
func.def @test() {
  %base = index.constant 0 : offset
  %bytes = index.constant 256 : offset
  %first_value = scalar.constant 1 : i32
  %second_value = scalar.constant 2 : i32
  %first = buffer.alloca<workgroup> align(16) %bytes : buffer
  %first_view = buffer.view %first[%base] : buffer -> view<1xi32>
  view.store %first_value, %first_view[0] : i32, view<1xi32>
  %first_read = view.load %first_view[0] : view<1xi32> -> i32
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %second = buffer.alloca<workgroup> align(16) %bytes : buffer
  %second_view = buffer.view %second[%base] : buffer -> view<1xi32>
  view.store %second_value, %second_view[0] : i32, view<1xi32>
  %second_read = view.load %second_view[0] : view<1xi32> -> i32
  func.return
}

// ----
first: accessed=yes single_instance=yes
second: accessed=yes single_instance=yes
first / second: workgroup_nonoverlap=yes

// ====

// Diagnostic address records retain their allocation even without payload
// accesses. They do not expose unrelated scratch: checked aliases retain their
// root, and the actual barrier still separates the two scratch phases.
kernel.def @test() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%row: index, %value: i32, %fragment: vector<4xi32>, %condition: i1) {
  %base = index.constant 0 : offset
  %bytes = index.constant 64 : offset
  %extent = index.constant 4 : index
  %first = buffer.alloca<workgroup> align(16) %bytes : buffer
  %first_view = buffer.view %first[%base] : buffer -> view<4x4xi32>
  %checked_view = sanitizer.assert.layout %first_view : view<4x4xi32> -> view<4x4xi32>
  %checked_row = sanitizer.assert.value %row [range(%row, 0, 4)] : index
  sanitizer.assert.op %value [ge(%value, 0)] : i32
  kernel.assert %condition : i1
  %observed = buffer.alloca<workgroup> align(16) %bytes : buffer
  %observed_view = buffer.view %observed[%base] : buffer -> view<4x4xi32>
  sanitizer.assert.access<write> %observed_view[%checked_row, 0] : view<4x4xi32>
  sanitizer.assert.accesses<write> %observed_view[0, 0] {static_count = 4, static_extents = [1, 4], static_strides = [1, 0]} : view<4x4xi32>
  sanitizer.race.access<write> %observed_view[%checked_row, 0] : view<4x4xi32>
  sanitizer.race.access<read_write> %observed_view[%checked_row, 0] {atomic = true, ordering = acq_rel, scope = workgroup} : view<4x4xi32>
  sanitizer.race.fragment_access<read> %fragment, %observed_view[0, 0] shape [%extent, %extent] {role = lhs} : vector<4xi32>, view<4x4xi32>
  view.store %value, %checked_view[0, 0] : i32, view<4x4xi32>
  %first_read = view.load %checked_view[0, 0] : view<4x4xi32> -> i32
  sanitizer.race.sync<workgroup> scope(workgroup) ordering(acq_rel)
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %second = buffer.alloca<workgroup> align(16) %bytes : buffer
  %second_view = buffer.view %second[%base] : buffer -> view<4x4xi32>
  view.store %first_read, %second_view[0, 0] : i32, view<4x4xi32>
  kernel.return
}

// ----
first: accessed=yes single_instance=yes
observed: accessed=yes single_instance=yes
second: accessed=yes single_instance=yes
first / observed: workgroup_nonoverlap=unproven
first / second: workgroup_nonoverlap=yes
observed / second: workgroup_nonoverlap=unproven

// ====

// A checked alias used after the barrier keeps its original allocation live.
// The assertion is not an escape, but it does not sever reference provenance.
func.def @test() {
  %base = index.constant 0 : offset
  %bytes = index.constant 16 : offset
  %value = scalar.constant 1 : i32
  %first = buffer.alloca<workgroup> align(16) %bytes : buffer
  %first_view = buffer.view %first[%base] : buffer -> view<4xi32>
  %checked_view = sanitizer.assert.layout %first_view : view<4xi32> -> view<4xi32>
  view.store %value, %first_view[0] : i32, view<4xi32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %second = buffer.alloca<workgroup> align(16) %bytes : buffer
  %second_view = buffer.view %second[%base] : buffer -> view<4xi32>
  view.store %value, %second_view[0] : i32, view<4xi32>
  %first_read = view.load %checked_view[0] : view<4xi32> -> i32
  func.return
}

// ----
first: accessed=yes single_instance=yes
second: accessed=yes single_instance=yes
first / second: workgroup_nonoverlap=unproven

// ====

// Barrier before final read does not end lifetime.
func.def @test() {
  %base = index.constant 0 : offset
  %bytes = index.constant 256 : offset
  %first_value = scalar.constant 1 : i32
  %second_value = scalar.constant 2 : i32
  %first = buffer.alloca<workgroup> align(16) %bytes : buffer
  %first_view = buffer.view %first[%base] : buffer -> view<1xi32>
  view.store %first_value, %first_view[0] : i32, view<1xi32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %first_read = view.load %first_view[0] : view<1xi32> -> i32
  %second = buffer.alloca<workgroup> align(16) %bytes : buffer
  %second_view = buffer.view %second[%base] : buffer -> view<1xi32>
  view.store %second_value, %second_view[0] : i32, view<1xi32>
  %second_read = view.load %second_view[0] : view<1xi32> -> i32
  func.return
}

// ----
first: accessed=yes single_instance=yes
second: accessed=yes single_instance=yes
first / second: workgroup_nonoverlap=unproven

// ====

// Subgroup barrier does not end workgroup lifetime.
func.def @test() {
  %base = index.constant 0 : offset
  %bytes = index.constant 256 : offset
  %value = scalar.constant 1 : i32
  %first = buffer.alloca<workgroup> align(16) %bytes : buffer
  %first_view = buffer.view %first[%base] : buffer -> view<1xi32>
  view.store %value, %first_view[0] : i32, view<1xi32>
  %first_read = view.load %first_view[0] : view<1xi32> -> i32
  kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
  %second = buffer.alloca<workgroup> align(16) %bytes : buffer
  %second_view = buffer.view %second[%base] : buffer -> view<1xi32>
  view.store %value, %second_view[0] : i32, view<1xi32>
  %second_read = view.load %second_view[0] : view<1xi32> -> i32
  func.return
}

// ----
first: accessed=yes single_instance=yes
second: accessed=yes single_instance=yes
first / second: workgroup_nonoverlap=unproven

// ====

// Global memory barrier does not end LDS lifetime.
func.def @test() {
  %base = index.constant 0 : offset
  %bytes = index.constant 256 : offset
  %value = scalar.constant 1 : i32
  %first = buffer.alloca<workgroup> align(16) %bytes : buffer
  %first_view = buffer.view %first[%base] : buffer -> view<1xi32>
  view.store %value, %first_view[0] : i32, view<1xi32>
  %first_read = view.load %first_view[0] : view<1xi32> -> i32
  kernel.barrier<global> scope(workgroup) ordering(acq_rel)
  %second = buffer.alloca<workgroup> align(16) %bytes : buffer
  %second_view = buffer.view %second[%base] : buffer -> view<1xi32>
  view.store %value, %second_view[0] : i32, view<1xi32>
  %second_read = view.load %second_view[0] : view<1xi32> -> i32
  func.return
}

// ----
first: accessed=yes single_instance=yes
second: accessed=yes single_instance=yes
first / second: workgroup_nonoverlap=unproven

// ====

// Workgroup uniform branches do not interfere.
func.def @test() {
  %base = index.constant 0 : offset
  %bytes = index.constant 256 : offset
  %condition = scalar.constant 1 : i1
  %value = scalar.constant 7 : i32
  cfg.cond_br %condition, ^first_arm, ^second_arm
^first_arm:
  %first = buffer.alloca<workgroup> align(16) %bytes : buffer
  %first_view = buffer.view %first[%base] : buffer -> view<1xi32>
  view.store %value, %first_view[0] : i32, view<1xi32>
  %first_read = view.load %first_view[0] : view<1xi32> -> i32
  cfg.br ^done
^second_arm:
  %second = buffer.alloca<workgroup> align(16) %bytes : buffer
  %second_view = buffer.view %second[%base] : buffer -> view<1xi32>
  view.store %value, %second_view[0] : i32, view<1xi32>
  %second_read = view.load %second_view[0] : view<1xi32> -> i32
  cfg.br ^done
^done:
  func.return
}

// ----
first: accessed=yes single_instance=yes
second: accessed=yes single_instance=yes
first / second: workgroup_nonoverlap=yes

// ====

// Workgroup uniform structured branches do not interfere.
func.def @test() {
  %base = index.constant 0 : offset
  %bytes = index.constant 256 : offset
  %condition = scalar.constant 1 : i1
  %value = scalar.constant 7 : i32
  scf.if %condition {
    %first = buffer.alloca<workgroup> align(16) %bytes : buffer
    %first_view = buffer.view %first[%base] : buffer -> view<1xi32>
    view.store %value, %first_view[0] : i32, view<1xi32>
    %first_read = view.load %first_view[0] : view<1xi32> -> i32
  } else {
    %second = buffer.alloca<workgroup> align(16) %bytes : buffer
    %second_view = buffer.view %second[%base] : buffer -> view<1xi32>
    view.store %value, %second_view[0] : i32, view<1xi32>
    %second_read = view.load %second_view[0] : view<1xi32> -> i32
  }
  func.return
}

// ----
first: accessed=yes single_instance=yes
second: accessed=yes single_instance=yes
first / second: workgroup_nonoverlap=yes

// ====

// Divergent structured branches may interfere.
func.def @test(%condition: i1) {
  %base = index.constant 0 : offset
  %bytes = index.constant 256 : offset
  %value = scalar.constant 7 : i32
  scf.if %condition {
    %first = buffer.alloca<workgroup> align(16) %bytes : buffer
    %first_view = buffer.view %first[%base] : buffer -> view<1xi32>
    view.store %value, %first_view[0] : i32, view<1xi32>
    %first_read = view.load %first_view[0] : view<1xi32> -> i32
  } else {
    %second = buffer.alloca<workgroup> align(16) %bytes : buffer
    %second_view = buffer.view %second[%base] : buffer -> view<1xi32>
    view.store %value, %second_view[0] : i32, view<1xi32>
    %second_read = view.load %second_view[0] : view<1xi32> -> i32
  }
  func.return
}

// ----
first: accessed=yes single_instance=yes
second: accessed=yes single_instance=yes
first / second: workgroup_nonoverlap=unproven

// ====

// Barrier separates across CFG blocks.
func.def @test() {
  %base = index.constant 0 : offset
  %bytes = index.constant 256 : offset
  %value = scalar.constant 1 : i32
  %first = buffer.alloca<workgroup> align(16) %bytes : buffer
  %second = buffer.alloca<workgroup> align(16) %bytes : buffer
  %first_view = buffer.view %first[%base] : buffer -> view<1xi32>
  view.store %value, %first_view[0] : i32, view<1xi32>
  %first_read = view.load %first_view[0] : view<1xi32> -> i32
  cfg.br ^cut
^cut:
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  cfg.br ^second_phase
^second_phase:
  %second_view = buffer.view %second[%base] : buffer -> view<1xi32>
  view.store %value, %second_view[0] : i32, view<1xi32>
  %second_read = view.load %second_view[0] : view<1xi32> -> i32
  func.return
}

// ----
first: accessed=yes single_instance=yes
second: accessed=yes single_instance=yes
first / second: workgroup_nonoverlap=yes

// ====

// Cyclic phase reversal remains interfering.
func.def @test(%continue: i1) {
  %base = index.constant 0 : offset
  %bytes = index.constant 256 : offset
  %value = scalar.constant 1 : i32
  %first = buffer.alloca<workgroup> align(16) %bytes : buffer
  %second = buffer.alloca<workgroup> align(16) %bytes : buffer
  %first_view = buffer.view %first[%base] : buffer -> view<1xi32>
  %second_view = buffer.view %second[%base] : buffer -> view<1xi32>
  cfg.br ^loop
^loop:
  view.store %value, %first_view[0] : i32, view<1xi32>
  %first_read = view.load %first_view[0] : view<1xi32> -> i32
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  view.store %value, %second_view[0] : i32, view<1xi32>
  %second_read = view.load %second_view[0] : view<1xi32> -> i32
  cfg.cond_br %continue, ^loop, ^done
^done:
  func.return
}

// ----
first: accessed=yes single_instance=yes
second: accessed=yes single_instance=yes
first / second: workgroup_nonoverlap=unproven

// ====

// CFG loop final barrier separates following phase.
func.def @test() {
  %base = index.constant 0 : offset
  %bytes = index.constant 256 : offset
  %begin = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  %value = scalar.constant 1 : i32
  %first = buffer.alloca<workgroup> align(16) %bytes : buffer
  %second = buffer.alloca<workgroup> align(16) %bytes : buffer
  %first_view = buffer.view %first[%base] : buffer -> view<1xi32>
  %second_view = buffer.view %second[%base] : buffer -> view<1xi32>
  cfg.br ^loop(%begin: index)
^loop(%iteration: index):
  %continue = index.cmp slt, %iteration, %end : index
  cfg.cond_br %continue, ^body, ^done
^body:
  view.store %value, %first_view[0] : i32, view<1xi32>
  %first_read = view.load %first_view[0] : view<1xi32> -> i32
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %next = index.add %iteration, %step : index
  cfg.br ^loop(%next: index)
^done:
  view.store %value, %second_view[0] : i32, view<1xi32>
  %second_read = view.load %second_view[0] : view<1xi32> -> i32
  func.return
}

// ----
first: accessed=yes single_instance=yes
second: accessed=yes single_instance=yes
first / second: workgroup_nonoverlap=yes

// ====

// Nested loop final barrier separates following phase.
func.def @test() {
  %base = index.constant 0 : offset
  %bytes = index.constant 256 : offset
  %begin = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  %value = scalar.constant 1 : i32
  %first = buffer.alloca<workgroup> align(16) %bytes : buffer
  %second = buffer.alloca<workgroup> align(16) %bytes : buffer
  %first_view = buffer.view %first[%base] : buffer -> view<1xi32>
  %second_view = buffer.view %second[%base] : buffer -> view<1xi32>
  scf.for %outer = [%begin to %end step %step] {
    scf.for %inner = [%begin to %end step %step] {
      view.store %value, %first_view[0] : i32, view<1xi32>
      %first_read = view.load %first_view[0] : view<1xi32> -> i32
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  }
  view.store %value, %second_view[0] : i32, view<1xi32>
  %second_read = view.load %second_view[0] : view<1xi32> -> i32
  func.return
}

// ----
first: accessed=yes single_instance=yes
second: accessed=yes single_instance=yes
first / second: workgroup_nonoverlap=yes

// ====

// Structured loop phase reversal remains interfering.
func.def @test() {
  %base = index.constant 0 : offset
  %bytes = index.constant 256 : offset
  %begin = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  %value = scalar.constant 1 : i32
  %first = buffer.alloca<workgroup> align(16) %bytes : buffer
  %second = buffer.alloca<workgroup> align(16) %bytes : buffer
  %first_view = buffer.view %first[%base] : buffer -> view<1xi32>
  %second_view = buffer.view %second[%base] : buffer -> view<1xi32>
  scf.for %iteration = [%begin to %end step %step] {
    view.store %value, %first_view[0] : i32, view<1xi32>
    %first_read = view.load %first_view[0] : view<1xi32> -> i32
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    view.store %value, %second_view[0] : i32, view<1xi32>
    %second_read = view.load %second_view[0] : view<1xi32> -> i32
  }
  func.return
}

