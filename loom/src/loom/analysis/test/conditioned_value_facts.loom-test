// RUN: pass unroll-scf-for,dce

// An independent runtime branch activates conditioned inference. Refining its
// facts must preserve the input's nonzero predicate, proving one loop iteration
// after either carrier widening even though the input interval spans zero.
func.def @byte_magnitude_count(%input: i8, %selector: i32) {
  %bounded = scalar.assume %input [range(%input, -1, 1), ne(%input, 0)] : i8
  %wide = scalar.extsi %bounded : i8 to i32
  %magnitude = scalar.absi %wide : i32
  %count = index.cast %magnitude : i32 to index
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %empty = scalar.constant 0 : i32
  %selected = scalar.cmpi ne, %selector, %empty : i32
  scf.if %selected {
    scf.for %iteration = [%begin to %count step %step] unroll {
      test.use %iteration : index
    }
  }
  func.return
}

func.def @halfword_magnitude_count(%input: i16, %selector: i32) {
  %bounded = scalar.assume %input [range(%input, -1, 1), ne(%input, 0)] : i16
  %wide = scalar.extsi %bounded : i16 to i64
  %magnitude = scalar.absi %wide : i64
  %count = index.cast %magnitude : i64 to index
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %empty = scalar.constant 0 : i32
  %selected = scalar.cmpi ne, %selector, %empty : i32
  scf.if %selected {
    scf.for %iteration = [%begin to %count step %step] unroll {
      test.use %iteration : index
    }
  }
  func.return
}

// ----
func.def @byte_magnitude_count(%input: i8, %selector: i32) {
  %empty = scalar.constant 0 : i32
  %selected = scalar.cmpi ne, %selector, %empty : i32
  scf.if %selected {
    %iteration_0 = index.constant 0 : index
    test.use %iteration_0 : index
  }
  func.return
}

func.def @halfword_magnitude_count(%input: i16, %selector: i32) {
  %empty = scalar.constant 0 : i32
  %selected = scalar.cmpi ne, %selector, %empty : i32
  scf.if %selected {
    %iteration_0 = index.constant 0 : index
    test.use %iteration_0 : index
  }
