// A trailing CFG rendezvous retires completed asynchronous accesses.
kernel.def @test() {
  %c1 = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%input: buffer) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %limit = index.constant 4 : index
  %origin = index.constant 0 : offset
  %bytes = index.constant 128 : offset
  %global = buffer.assume.memory_space<global> %input : buffer
  %source = buffer.view %global[%origin] : buffer -> view<32xi32>
  cfg.br ^allocate(%c0: index)
^allocate(%iteration: index):
  %storage = buffer.alloca<workgroup> align(16) %bytes : buffer
  %slot = buffer.view %storage[%origin] : buffer -> view<32xi32>
  cfg.br ^copy
^copy:
  %token = kernel.async.copy %source to %slot {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<32xi32> to view<32xi32> -> kernel.async.token
  %group = kernel.async.group %token : kernel.async.token -> kernel.async.group
  kernel.async.wait %group {newer_groups = 0} : kernel.async.group
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %next = index.add %iteration, %c1 : index
  %more = index.cmp ult, %next, %limit : index
  cfg.cond_br %more, ^latch, ^exit
^latch:
  cfg.br ^allocate(%next: index)
^exit:
  kernel.return
}

