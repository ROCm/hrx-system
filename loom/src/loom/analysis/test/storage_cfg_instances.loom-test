// ====

// Different barriers reached by divergent lanes cannot rendezvous a workgroup.
kernel.def @test() {
  %c1 = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%threads, %c1, %c1) : index
} launch(%limit0: index, %output: buffer) {
  %limit = index.assume %limit0 [range(%limit0, 1, 32)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %origin = index.constant 0 : offset
  %bytes = index.constant 128 : offset
  %value = scalar.constant 7 : i32
  %lane = kernel.workitem.id<x> : index
  %leader = index.cmp eq, %lane, %c0 : index
  %output_view = buffer.view %output[%origin] : buffer -> view<32xi32>
  cfg.br ^header(%c0: index)
^header(%iteration: index):
  %more = index.cmp ult, %iteration, %limit : index
  cfg.cond_br %more, ^allocate, ^exit
^allocate:
  %storage = buffer.alloca<workgroup> align(16) %bytes : buffer
  %slot = buffer.view %storage[%origin] : buffer -> view<32xi32>
  view.store %value, %slot[%lane] : i32, view<32xi32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %loaded = view.load %slot[0] : view<32xi32> -> i32
  view.store %loaded, %output_view[%lane] : i32, view<32xi32>
  cfg.cond_br %leader, ^left, ^right
^left:
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  cfg.br ^latch
^right:
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  cfg.br ^latch
^latch:
  %next = index.add %iteration, %c1 : index
  cfg.br ^header(%next: index)
^exit:
  kernel.return
}

