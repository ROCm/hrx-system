// RUN: emit private-storage-interference @test

// A callee's bounded access ends before the next allocation, even when it
// writes through a derived view rather than the allocation's original handle.
func.decl @update(%values: view<1xi32> {access = read_write})

func.def @test() {
  %first = view.alloca<private> : view<4xi32>
  %slice = view.subview %first[2] : view<4xi32> -> view<1xi32>
  func.call @update(%slice) : (view<1xi32>)
  %second = view.alloca<private> : view<4xi32>
  %next_slice = view.subview %second[1] : view<4xi32> -> view<1xi32>
  func.call @update(%next_slice) : (view<1xi32>)
  func.return
}

// ----
first: accessed=yes single_instance=yes
second: accessed=yes single_instance=yes
first / second: private_nonoverlap=yes

// ====

// The first root stays live through the derived slice's later use. An unused
// reference allocation still has an initialization point that needs storage.
type.decl import("lifetime", "object") @Object

func.def @test(%input: i32) -> (i32) {
  %first = view.alloca<private> : view<4xi32>
  %slice = view.subview %first[2] : view<4xi32> -> view<1xi32>
  %unused = view.alloca<private> : view<4xref<@Object>>
  %second = view.alloca<private> : view<4xi32>
  view.store %input, %second[0] : i32, view<4xi32>
  %value = view.load %second[0] : view<4xi32> -> i32
  view.store %value, %slice[0] : i32, view<1xi32>
  %result = view.load %slice[0] : view<1xi32> -> i32
  func.return %result : i32
}

// ----
first: accessed=yes single_instance=yes
unused: accessed=no single_instance=yes
second: accessed=yes single_instance=yes
first / unused: private_nonoverlap=unproven
first / second: private_nonoverlap=unproven
unused / second: private_nonoverlap=yes

// ====

// Private storage follows invocation control. Different invocations need not
// take the same branch, unlike workgroup storage.
func.def @test(%condition: i1, %value: i32) -> (i32) {
  %result = scf.if %condition -> (i32) {
    %left = view.alloca<private> : view<4xi32>
    view.store %value, %left[0] : i32, view<4xi32>
    %loaded = view.load %left[0] : view<4xi32> -> i32
    scf.yield %loaded : i32
  } else {
    %right = view.alloca<private> : view<4xi32>
    view.store %value, %right[0] : i32, view<4xi32>
    %loaded = view.load %right[0] : view<4xi32> -> i32
    scf.yield %loaded : i32
  }
  func.return %result : i32
}

// ----
left: accessed=yes single_instance=yes
right: accessed=yes single_instance=yes
left / right: private_nonoverlap=yes

// ====

// A root captured by an opaque call has no bounded retirement point.
func.decl @capture(%values: view<4xi32>)

func.def @test(%input: i32) -> (i32) {
  %first = view.alloca<private> : view<4xi32>
  view.store %input, %first[0] : i32, view<4xi32>
  func.call @capture(%first) : (view<4xi32>)
  %second = view.alloca<private> : view<4xi32>
  view.store %input, %second[0] : i32, view<4xi32>
  %value = view.load %second[0] : view<4xi32> -> i32
  func.return %value : i32
}

// ----
first: accessed=yes single_instance=yes
second: accessed=yes single_instance=yes
first / second: private_nonoverlap=unproven

// ====

// Independent roots may reuse their range on every iteration. The live union
// must preserve loop-carried aliases rather than just bounding direct uses.
func.decl @read(%values: view<4xi32> {access = read})

func.def @test(%limit: index, %input: i32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  scf.for %index = [%begin to %limit step %step] {
    %first = view.alloca<private> : view<4xi32>
    view.store %input, %first[0] : i32, view<4xi32>
    func.call @read(%first) : (view<4xi32>)
    %second = view.alloca<private> : view<4xi32>
    view.store %input, %second[0] : i32, view<4xi32>
    func.call @read(%second) : (view<4xi32>)
  }
  func.return
}

// ----
first: accessed=yes single_instance=yes
second: accessed=yes single_instance=yes
first / second: private_nonoverlap=yes

// ====

// An older view remains live at the next allocation.
func.def @test(%limit: index) -> (i32) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %seed = scalar.constant 0 : i32
  %increment = scalar.constant 1 : i32
  %initial_storage = buffer.alloca<private> align(4) %bytes : buffer
  %initial_view = buffer.view %initial_storage[%origin] : buffer -> view<1xi32>
  view.store %seed, %initial_view[0] : i32, view<1xi32>
  %sum, %value, %last = scf.for %i = [%begin to %limit step %step](%accumulator = %seed : i32, %previous_value = %seed : i32, %previous = %initial_view : view<1xi32>) -> (i32, i32, view<1xi32>) {
    %storage = buffer.alloca<private> align(4) %bytes : buffer
    %slot = buffer.view %storage[%origin] : buffer -> view<1xi32>
    %next_value = scalar.addi %previous_value, %increment : i32
    view.store %next_value, %slot[0] : i32, view<1xi32>
    %old_value = view.load %previous[0] : view<1xi32> -> i32
    %next_sum = scalar.addi %accumulator, %old_value : i32
    scf.yield %next_sum, %next_value, %slot : i32, i32, view<1xi32>
  }
  func.return %sum : i32
}

// ----
initial_storage: accessed=yes single_instance=yes
storage: accessed=yes single_instance=unproven
initial_storage / storage: private_nonoverlap=unproven

// ====

// The older view dies before the next allocation.
func.def @test(%limit: index) -> (i32) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %seed = scalar.constant 0 : i32
  %increment = scalar.constant 1 : i32
  %initial_storage = buffer.alloca<private> align(4) %bytes : buffer
  %initial_view = buffer.view %initial_storage[%origin] : buffer -> view<1xi32>
  view.store %seed, %initial_view[0] : i32, view<1xi32>
  %sum, %value, %last = scf.for %i = [%begin to %limit step %step](%accumulator = %seed : i32, %previous_value = %seed : i32, %previous = %initial_view : view<1xi32>) -> (i32, i32, view<1xi32>) {
    %old_value = view.load %previous[0] : view<1xi32> -> i32
    %storage = buffer.alloca<private> align(4) %bytes : buffer
    %slot = buffer.view %storage[%origin] : buffer -> view<1xi32>
    %next_value = scalar.addi %previous_value, %increment : i32
    view.store %next_value, %slot[0] : i32, view<1xi32>
    %next_sum = scalar.addi %accumulator, %old_value : i32
    scf.yield %next_sum, %next_value, %slot : i32, i32, view<1xi32>
  }
  func.return %sum : i32
}

// ----
initial_storage: accessed=yes single_instance=yes
storage: accessed=yes single_instance=yes
initial_storage / storage: private_nonoverlap=unproven
