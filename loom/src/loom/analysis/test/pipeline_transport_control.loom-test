// ====
// RUN: with-checks pass-report pipeline=source-low

// Mutating a resident payload requires ordinary instruction execution.
// Keep the source proof distinct from the physical transport selection.
aie2p.target<array> @array_target {device_profile = "amd.xdna.strix_halo.17f0_11"}

func.def inline @ingress(%input: buffer, %incoming: channel<tile<16xi32>>) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %bytes = index.constant 64 : offset
  scf.for %record = [%c0 to %c4 step %c1] {
    %offset = index.scale %record, %bytes : index, offset -> offset
    %external = buffer.view %input[%offset] : buffer -> view<16xi32>
    %write, %payload = channel.reserve %incoming : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
    %copy = kernel.async.copy %external to %payload {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<16xi32> to view<16xi32> -> kernel.async.token
    %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
    kernel.async.wait %group {newer_groups = 0} : kernel.async.group
    channel.publish %write : write<tile<16xi32>>
  }
  func.return
}

func.def inline @copy_retained(%read: read<tile<16xi32>>, %destination: channel<tile<16xi32>>) -> (read<tile<16xi32>>) {
  %retained, %outgoing = channel.fanout %read : read<tile<16xi32>> -> (read<tile<16xi32>>, read<tile<16xi32>>)
  %write, %payload = channel.reserve %destination : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
  channel.copy %outgoing -> %write : read<tile<16xi32>>, write<tile<16xi32>>
  func.return %retained : read<tile<16xi32>>
}

func.def inline @distribute(%incoming: channel<tile<16xi32>>, %left: channel<tile<16xi32>>, %right: channel<tile<16xi32>>) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  scf.for %batch = [%c0 to %c2 step %c1] {
    %first, %first_payload = channel.acquire %incoming : channel<tile<16xi32>> -> (read<tile<16xi32>>, view<16xi32>)
    %second, %second_payload = channel.acquire %incoming : channel<tile<16xi32>> -> (read<tile<16xi32>>, view<16xi32>)
    %last_first, %last_second = scf.for %replay = [%c0 to %c3 step %c1](%a = %first : read<tile<16xi32>>, %b = %second : read<tile<16xi32>>) -> (read<tile<16xi32>>, read<tile<16xi32>>) {
      %a_left = func.call @copy_retained(%a, %left) : (read<tile<16xi32>>, channel<tile<16xi32>>) -> (read<tile<16xi32>>)
      %a_right = func.call @copy_retained(%a_left, %right) : (read<tile<16xi32>>, channel<tile<16xi32>>) -> (read<tile<16xi32>>)
      %b_left = func.call @copy_retained(%b, %left) : (read<tile<16xi32>>, channel<tile<16xi32>>) -> (read<tile<16xi32>>)
      %b_right = func.call @copy_retained(%b_left, %right) : (read<tile<16xi32>>, channel<tile<16xi32>>) -> (read<tile<16xi32>>)
      scf.yield %a_right, %b_right : read<tile<16xi32>>, read<tile<16xi32>>
    }
    channel.release %last_first : read<tile<16xi32>>
    channel.release %last_second : read<tile<16xi32>>
  }
  func.return
}

func.def inline @egress(%source: channel<tile<16xi32>>, %output: buffer, %base: offset) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %count = index.constant 12 : index
  %bytes = index.constant 64 : offset
  scf.for %record = [%c0 to %count step %c1] {
    %read, %payload = channel.acquire<mutable> %source : channel<tile<16xi32>> -> (read<tile<16xi32>, mutable>, view<16xi32>)
    %bias_scalar = scalar.constant 17 : i32
    %bias = vector.splat %bias_scalar : vector<16xi32>
    %value = vector.load %payload[0] : view<16xi32> -> vector<16xi32>
    %next = vector.addi %value, %bias : vector<16xi32>
    vector.store %next, %payload[0] : vector<16xi32>, view<16xi32>
    %relative = index.scale %record, %bytes : index, offset -> offset
    %offset = index.add %base, %relative : offset
    %external = buffer.view %output[%offset] : buffer -> view<16xi32>
    %copy = kernel.async.copy %payload to %external {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<16xi32> to view<16xi32> -> kernel.async.token
    %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
    kernel.async.wait %group {newer_groups = 0} : kernel.async.group
    channel.release %read : read<tile<16xi32>, mutable>
  }
  func.return
}

pipeline.def<kernel> public retain target(@array_target) @retained_batch() run(%input_arg: buffer, %output_arg: buffer) {
  %input_unique, %output_unique = buffer.assume.noalias %input_arg, %output_arg : buffer, buffer
  %input, %output = buffer.assume.alignment %input_unique, %output_unique {minimum_alignment = 64} : buffer, buffer
  %c0 = index.constant 0 : offset
  %bytes = index.constant 64 : offset
  %batch_bytes = index.constant 128 : offset
  %right_offset = index.constant 768 : offset
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %sram = pipeline.memory<workgroup>[0, 1] : pool
  %first_core = pipeline.memory<workgroup>[0, 2] : pool
  %second_core = pipeline.memory<workgroup>[0, 3] : pool
  %batch_storage = buffer.alloca<workgroup> pool(%sram) align(64) %batch_bytes : buffer
  %batch_slots = buffer.view %batch_storage[%c0] : buffer -> view<2x16xi32>
  %batch = channel.bind<fifo> %batch_slots, %c2 : view<2x16xi32>, index -> channel<tile<16xi32>>
  %left_storage = buffer.alloca<workgroup> pool(%first_core) align(64) %bytes : buffer
  %left_slots = buffer.view %left_storage[%c0] : buffer -> view<1x16xi32>
  %left = channel.bind<fifo> %left_slots, %c1 : view<1x16xi32>, index -> channel<tile<16xi32>>
  %right_storage = buffer.alloca<workgroup> pool(%second_core) align(64) %bytes : buffer
  %right_slots = buffer.view %right_storage[%c0] : buffer -> view<1x16xi32>
  %right = channel.bind<fifo> %right_slots, %c1 : view<1x16xi32>, index -> channel<tile<16xi32>>
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    func.call @ingress(%input, %batch) : (buffer, channel<tile<16xi32>>)
  }
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    func.call @distribute(%batch, %left, %right) : (channel<tile<16xi32>>, channel<tile<16xi32>>, channel<tile<16xi32>>)
  }
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    func.call @egress(%left, %output, %c0) : (channel<tile<16xi32>>, buffer, offset)
  }
  pipeline.strand workers([0, 3], [1, 1], [1, 1]) {
    func.call @egress(%right, %output, %right_offset) : (channel<tile<16xi32>>, buffer, offset)
  }
}

