  %bytes = index.constant 64 : offset
  scf.for %record = [%c0 to %count step %c1] {
    %offset = index.scale %record, %bytes : index, offset -> offset
    %external = buffer.view %input[%offset] : buffer -> view<16xi32>
    %write, %payload = channel.reserve %incoming : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
    %copy = kernel.async.copy %external to %payload {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<16xi32> to view<16xi32> -> kernel.async.token
    %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
    kernel.async.wait %group {newer_groups = 0} : kernel.async.group
    channel.publish %write : write<tile<16xi32>>
  }
  func.return
}

func.def inline @egress(%source: channel<tile<16xi32>>, %output: buffer, %base: offset, %count: index) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %bytes = index.constant 64 : offset
  scf.for %record = [%c0 to %count step %c1] {
    %read, %payload = channel.acquire %source : channel<tile<16xi32>> -> (read<tile<16xi32>>, view<16xi32>)
    %relative = index.scale %record, %bytes : index, offset -> offset
    %offset = index.add %base, %relative : offset
    %external = buffer.view %output[%offset] : buffer -> view<16xi32>
    %copy = kernel.async.copy %payload to %external {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<16xi32> to view<16xi32> -> kernel.async.token
    %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
    kernel.async.wait %group {newer_groups = 0} : kernel.async.group
    channel.release %read : read<tile<16xi32>>
  }
  func.return
}

// Equal exact trip counts do not establish one common replay scope.
// One retained record crosses both loops and has only one final release.
func.def @worker(%source: channel<tile<16xi32>>, %left: channel<tile<16xi32>>, %right: channel<tile<16xi32>>) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c3 = index.constant 3 : index
  // ERROR@+1: XDNA/051 {requirement="FIFO acquire/reserve/wait/publish/release channel actions"}
  %initial = channel.accept %source : channel<tile<16xi32>> -> read<tile<16xi32>>
  cfg.br ^left_header(%c0: index, %initial: read<tile<16xi32>>)
^left_header(%i: index, %left_read: read<tile<16xi32>>):
  %left_more = index.cmp ult, %i, %c3 : index
  cfg.cond_br %left_more, ^left_copy, ^left_done
^left_copy:
  %left_keep, %left_outgoing = channel.fanout %left_read : read<tile<16xi32>> -> (read<tile<16xi32>>, read<tile<16xi32>>)
  %left_write, %left_payload = channel.reserve %left : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
  channel.copy %left_outgoing -> %left_write : read<tile<16xi32>>, write<tile<16xi32>>
  %next_i = index.add %i, %c1 : index
  cfg.br ^left_header(%next_i: index, %left_keep: read<tile<16xi32>>)
^left_done:
  cfg.br ^right_header(%c0: index, %left_read: read<tile<16xi32>>)
^right_header(%j: index, %right_read: read<tile<16xi32>>):
  %right_more = index.cmp ult, %j, %c3 : index
  cfg.cond_br %right_more, ^right_copy, ^right_done
^right_copy:
  %right_keep, %right_outgoing = channel.fanout %right_read : read<tile<16xi32>> -> (read<tile<16xi32>>, read<tile<16xi32>>)
  %right_write, %right_payload = channel.reserve %right : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
  channel.copy %right_outgoing -> %right_write : read<tile<16xi32>>, write<tile<16xi32>>
  %next_j = index.add %j, %c1 : index
  cfg.br ^right_header(%next_j: index, %right_keep: read<tile<16xi32>>)
^right_done:
  channel.release %right_read : read<tile<16xi32>>
  func.return
}

pipeline.def<kernel> public retain target(@array_target) @test() run(%input_arg: buffer, %output_arg: buffer) {
  %input_unique, %output_unique = buffer.assume.noalias %input_arg, %output_arg : buffer, buffer
  %input, %output = buffer.assume.alignment %input_unique, %output_unique {minimum_alignment = 64} : buffer, buffer
  %origin = index.constant 0 : offset
  %slot_bytes = index.constant 64 : offset
  %source_bytes = index.constant 128 : offset
  %source_capacity = index.constant 2 : index
  %destination_capacity = index.constant 1 : index
  %right_offset = index.constant 768 : offset
  %sram = pipeline.memory<workgroup>[0, 1] : pool
  %left_memory = pipeline.memory<workgroup>[0, 2] : pool
  %right_memory = pipeline.memory<workgroup>[0, 3] : pool
  %source_storage = buffer.alloca<workgroup> pool(%sram) align(64) %source_bytes : buffer
  %source_slots = buffer.view %source_storage[%origin] : buffer -> view<2x16xi32>
  %source = channel.bind<fifo> %source_slots, %source_capacity : view<2x16xi32>, index -> channel<tile<16xi32>>
  %left_storage = buffer.alloca<workgroup> pool(%left_memory) align(64) %slot_bytes : buffer
  %left_slots = buffer.view %left_storage[%origin] : buffer -> view<1x16xi32>
  %left = channel.bind<fifo> %left_slots, %destination_capacity : view<1x16xi32>, index -> channel<tile<16xi32>>
  %right_storage = buffer.alloca<workgroup> pool(%right_memory) align(64) %slot_bytes : buffer
  %right_slots = buffer.view %right_storage[%origin] : buffer -> view<1x16xi32>
  %right = channel.bind<fifo> %right_slots, %destination_capacity : view<1x16xi32>, index -> channel<tile<16xi32>>
  %source_count = index.constant 1 : index
  %left_count = index.constant 3 : index
  %right_count = index.constant 3 : index
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    func.call @ingress(%input, %source, %source_count) : (buffer, channel<tile<16xi32>>, index)
  }
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    func.call @worker(%source, %left, %right) : (channel<tile<16xi32>>, channel<tile<16xi32>>, channel<tile<16xi32>>)
  }
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    func.call @egress(%left, %output, %origin, %left_count) : (channel<tile<16xi32>>, buffer, offset, index)
  }
  pipeline.strand workers([0, 3], [1, 1], [1, 1]) {
    func.call @egress(%right, %output, %right_offset, %right_count) : (channel<tile<16xi32>>, buffer, offset, index)
  }
}

