// Conditional routing remains ordinary worker execution.
func.def @worker(%source: channel<tile<16xi32>>, %left: channel<tile<16xi32>>, %right: channel<tile<16xi32>>, %condition: i1) {
  %read = channel.accept %source : channel<tile<16xi32>> -> read<tile<16xi32>>
  cfg.cond_br %condition, ^left, ^right
^left:
  %left_write, %left_payload = channel.reserve %left : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
  channel.copy %read -> %left_write : read<tile<16xi32>>, write<tile<16xi32>>
  cfg.br ^done
^right:
  %right_write, %right_payload = channel.reserve %right : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
  channel.copy %read -> %right_write : read<tile<16xi32>>, write<tile<16xi32>>
  cfg.br ^done
^done:
  func.return
}

