// ====

func.def @tile_different_element(%source: tile<4xf32>) {
  // ERROR@+1: TYPE/002
  %refined = tile.refine %source : tile<4xf32> -> tile<4xi32>
  func.return
}

// ====

func.def @group_conflicting_extent(%source: group<2x3x4>) {
  // ERROR@+1: SHAPE/001 "source static dimension" "4" "result static dimension" "5"
  %refined = group.refine %source : group<2x3x4> -> group<2x3x5>
  func.return
