// RUN: format bytecode

// Read-only artifact payloads are RECORD symbols with bytes attributes. Keep
// them in the bytecode path so compiler-owned tables can survive loombc without
// using the RESOURCES section.
global.rodata.def @loom_sanitizer_sites = align(8) bytes("4c534954010000000100020304050607")

// ====

// Empty payloads remain representable so stripping diagnostic data can leave a
// distinct symbol without inventing filler bytes.
global.rodata.def @empty_rodata = bytes("")

// ====

// External payload declarations preserve their declaration role in bytecode.
global.rodata.decl @external_rodata

// ====

// Loads preserve their rodata reference and target-neutral buffer result.
global.rodata.def @message = align(8) bytes("6c6f6f6d")

func.def @load_message() -> (buffer) {
  %message = global.load @message : buffer
  func.return %message : buffer
}
