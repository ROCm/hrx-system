func.def @doubleword_wrap() -> (i1, i1) {
  %lower = scalar.constant 9223372036854775807 : i64
  %upper = scalar.constant 0 : i64
  %step = scalar.constant 1 : i64
  %mask = vector.mask.range [%lower to %upper step %step] : i64 -> vector<2xi1>
  %first = vector.extract %mask[0] : vector<2xi1> -> i1
  %wrapped = vector.extract %mask[1] : vector<2xi1> -> i1
