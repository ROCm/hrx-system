// RUN: pass canonicalize

// Positive coordinate wrap re-enables lane one after the signed comparison.
func.def @positive_wrap() -> (i1, i1) {
  %lower = scalar.constant 120 : i8
  %upper = scalar.constant 100 : i8
  %step = scalar.constant 16 : i8
  %mask = vector.mask.range [%lower to %upper step %step] : i8 -> vector<2xi1>
  %first = vector.extract %mask[0] : vector<2xi1> -> i1
  %wrapped = vector.extract %mask[1] : vector<2xi1> -> i1
  func.return %first, %wrapped : i1, i1
}

// ----
func.def @positive_wrap() -> (i1, i1) {
  %first = scalar.constant false : i1
  %wrapped = scalar.constant true : i1
  func.return %first, %wrapped : i1, i1
}

// ====

// Negative coordinate wrap disables the second lane rather than staying below
// the exclusive bound indefinitely.
func.def @negative_wrap() -> (i1, i1) {
  %lower = scalar.constant -120 : i8
  %upper = scalar.constant -100 : i8
  %step = scalar.constant -16 : i8
  %mask = vector.mask.range [%lower to %upper step %step] : i8 -> vector<2xi1>
  %first = vector.extract %mask[0] : vector<2xi1> -> i1
  %wrapped = vector.extract %mask[1] : vector<2xi1> -> i1
  func.return %first, %wrapped : i1, i1
}

// ----
func.def @negative_wrap() -> (i1, i1) {
  %first = scalar.constant true : i1
  %wrapped = scalar.constant false : i1
  func.return %first, %wrapped : i1, i1
}

// ====

