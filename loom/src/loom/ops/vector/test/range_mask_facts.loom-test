  %lower = scalar.constant 32767 : i16
  %upper = scalar.constant 0 : i16
  %step = scalar.constant 1 : i16
  %mask = vector.mask.range [%lower to %upper step %step] : i16 -> vector<2xi1>
  %first = vector.extract %mask[0] : vector<2xi1> -> i1
  %wrapped = vector.extract %mask[1] : vector<2xi1> -> i1
  func.return %first, %wrapped : i1, i1
}

// ----
func.def @halfword_wrap() -> (i1, i1) {
  %first = scalar.constant false : i1
  %wrapped = scalar.constant true : i1
  func.return %first, %wrapped : i1, i1
}

