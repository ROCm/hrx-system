  %finite = vector.isfinitef %fragment : vector<16xbf16> -> vector<16xi1>
  %inf_lane = vector.extract %inf[0] : vector<16xi1> -> i1
  %finite_lane = vector.extract %finite[0] : vector<16xi1> -> i1
