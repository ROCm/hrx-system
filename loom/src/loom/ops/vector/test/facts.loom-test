// RUN: pass canonicalize

// Lanewise i1 signed extension maps the logical true bit to negative one.
func.def @extsi_uniform_i1(%x: i1) -> (i64, i64) {
  %bits = vector.splat %x : vector<4xi1>
  %wide = vector.extsi %bits : vector<4xi1> to vector<4xi32>
  %lane = vector.extract %wide[0] : vector<4xi32> -> i32
  %lo = test.fact_range_lo %lane : i32 -> i64
  %hi = test.fact_range_hi %lane : i32 -> i64
  func.return %lo, %hi : i64, i64
}
// ----
func.def @extsi_uniform_i1(%x: i1) -> (i64, i64) {
  %lo = scalar.constant -1 : i64
  %hi = scalar.constant 0 : i64
  func.return %lo, %hi : i64, i64
}

// ====

// Compile-time vectors have the same value in every workitem even though their
// logical elements are represented by an extension fact.
func.def @constant_is_workgroup_uniform() -> (i1, i1) {
  %value = vector.constant 2 : vector<4xi32>
  %subgroup = test.fact_subgroup_uniform %value : vector<4xi32> -> i1
  %workgroup = test.fact_workgroup_uniform %value : vector<4xi32> -> i1
  func.return %subgroup, %workgroup : i1, i1
}
// ----
func.def @constant_is_workgroup_uniform() -> (i1, i1) {
  %subgroup = scalar.constant true : i1
  %workgroup = scalar.constant true : i1
  func.return %subgroup, %workgroup : i1, i1
}

// ====

// Uniform vector.constant facts let reductions fold to scalar constants without
// materializing vector constants.
func.def @reduce_uniform_constant_addi() -> (i32) {
  %v = vector.constant 2 : vector<4xi32>
  %init = scalar.constant 7 : i32
  %r = vector.reduce<addi> %v, %init : vector<4xi32>, i32
  func.return %r : i32
}
// ----
func.def @reduce_uniform_constant_addi() -> (i32) {
  %r = scalar.constant 15 : i32
  func.return %r : i32
}

// ====

// Uniform facts fold axis-preserving reductions while keeping unreduced lanes.
func.def @reduce_axes_uniform_partial_addi() -> (vector<3xi32>) {
  %v = vector.constant 2 : vector<2x3xi32>
  %init = vector.constant 1 : vector<3xi32>
  %r = vector.reduce.axes<addi> %v, %init axes [0] : vector<2x3xi32>, vector<3xi32>
  func.return %r : vector<3xi32>
}

// ----
func.def @reduce_axes_uniform_partial_addi() -> (vector<3xi32>) {
  %r = vector.constant 5 : vector<3xi32>
  func.return %r : vector<3xi32>
}

// ====

// Reducing every axis uses the same all-lanes fact path as scalar vector.reduce.
func.def @reduce_axes_uniform_all_axes_addi() -> (i32) {
  %v = vector.constant 2 : vector<2x3xi32>
  %init = scalar.constant 1 : i32
  %r = vector.reduce.axes<addi> %v, %init axes [0, 1] : vector<2x3xi32>, i32
  func.return %r : i32
}

// ----
func.def @reduce_axes_uniform_all_axes_addi() -> (i32) {
  %r = scalar.constant 13 : i32
  func.return %r : i32
}

// ====

// Small static lane facts preserve non-uniform per-lane reduction results.
func.def @reduce_axes_from_elements_extract() -> (i32, i32) {
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %c3 = scalar.constant 3 : i32
  %c4 = scalar.constant 4 : i32
  %v = vector.from_elements %c1, %c2, %c3, %c4 : vector<2x2xi32>
  %init = vector.constant 10 : vector<2xi32>
  %r = vector.reduce.axes<addi> %v, %init axes [0] : vector<2x2xi32>, vector<2xi32>
  %x = vector.extract %r[0] : vector<2xi32> -> i32
  %y = vector.extract %r[1] : vector<2xi32> -> i32
  func.return %x, %y : i32, i32
}

// ----
func.def @reduce_axes_from_elements_extract() -> (i32, i32) {
  %x = scalar.constant 14 : i32
  %y = scalar.constant 16 : i32
  func.return %x, %y : i32, i32
}

// ====

// Uniform facts survive vector.splat and mechanical lanewise integer ops.
func.def @reduce_uniform_splat_addi() -> (i32) {
  %a = scalar.constant 3 : i32
  %b = scalar.constant 4 : i32
  %va = vector.splat %a : vector<4xi32>
  %vb = vector.splat %b : vector<4xi32>
  %sum = vector.addi %va, %vb : vector<4xi32>
  %init = scalar.constant 1 : i32
  %r = vector.reduce<addi> %sum, %init : vector<4xi32>, i32
  func.return %r : i32
}
// ----
func.def @reduce_uniform_splat_addi() -> (i32) {
  %r = scalar.constant 29 : i32
  func.return %r : i32
}

// ====

// Representative lanewise float facts preserve uniform summaries through the
// expanded math surface.
func.def @reduce_uniform_float_math() -> (f32) {
  %c9 = vector.constant 9.0 : vector<4xf32>
  %c4 = vector.constant 4.0 : vector<4xf32>
  %rem = vector.remf %c9, %c4 : vector<4xf32>
  %root = vector.sqrtf %c9 : vector<4xf32>
  %sum = vector.addf %rem, %root : vector<4xf32>
  %init = scalar.constant 1.0 : f32
  %r = vector.reduce<addf> %sum, %init : vector<4xf32>, f32
  func.return %r : f32
}
// ----
func.def @reduce_uniform_float_math() -> (f32) {
  %r = scalar.constant 17.0 : f32
  func.return %r : f32
}

// ====

// Reductions round after every addf rather than carrying host-double precision
// through the full reduction.
func.def @reduce_f32_rounds_each_step() -> (f32) {
  %large = scalar.constant 16777216.0 : f32
  %c1 = scalar.constant 1.0 : f32
  %negative_large = scalar.constant -16777216.0 : f32
  %v = vector.from_elements %large, %c1, %negative_large : vector<3xf32>
  %c0 = scalar.constant 0.0 : f32
  %result = vector.reduce<addf> %v, %c0 : vector<3xf32>, f32
  func.return %result : f32
}
// ----
func.def @reduce_f32_rounds_each_step() -> (f32) {
  %result = scalar.constant 0.0 : f32
  func.return %result : f32
}

// ====

// Small per-lane float facts compose through new lanewise unary and binary ops.
func.def @small_static_float_math_extract() -> (f32) {
  %c1 = scalar.constant 1.0 : f32
  %c4 = scalar.constant 4.0 : f32
  %v = vector.from_elements %c1, %c4 : vector<2xf32>
  %root = vector.sqrtf %v : vector<2xf32>
  %max = vector.maximumf %v, %root : vector<2xf32>
  %r = vector.extract %max[1] : vector<2xf32> -> f32
  func.return %r : f32
}
// ----
func.def @small_static_float_math_extract() -> (f32) {
  %r = scalar.constant 4.0 : f32
  func.return %r : f32
}

// ====

// Vector minimumf mirrors scalar IEEE NaN propagation instead of minnumf.
func.def @vector_minimumf_propagates_uniform_nan() -> (i1) {
  %neg = vector.constant -1.0 : vector<4xf32>
  %nan = vector.logf %neg : vector<4xf32>
  %c3 = vector.constant 3.0 : vector<4xf32>
  %min = vector.minimumf %nan, %c3 : vector<4xf32>
  %lane = vector.extract %min[0] : vector<4xf32> -> f32
  %r = scalar.isnanf %lane : f32
  func.return %r : i1
}
// ----
func.def @vector_minimumf_propagates_uniform_nan() -> (i1) {
  %r = scalar.constant true : i1
  func.return %r : i1
}

// ====

// Vector minnumf keeps the explicit NaN-skipping behavior.
func.def @vector_minnumf_skips_uniform_nan() -> (i1) {
  %neg = vector.constant -1.0 : vector<4xf32>
  %nan = vector.logf %neg : vector<4xf32>
  %c3 = vector.constant 3.0 : vector<4xf32>
  %min = vector.minnumf %nan, %c3 : vector<4xf32>
  %lane = vector.extract %min[0] : vector<4xf32> -> f32
  %r = scalar.isnanf %lane : f32
  func.return %r : i1
}
// ----
func.def @vector_minnumf_skips_uniform_nan() -> (i1) {
  %r = scalar.constant false : i1
  func.return %r : i1
}

// ====

// Uniform vector clamp facts preserve the same explicit NaN semantics as the
// scalar op and feed scalar consumers through extraction.
func.def @vector_clampf_modes_uniform_nan() -> (i1, i1, i1) {
  %neg = vector.constant -1.0 : vector<4xf32>
  %nan = vector.logf %neg : vector<4xf32>
  %c0 = vector.constant 0.0 : vector<4xf32>
  %c1 = vector.constant 1.0 : vector<4xf32>
  %ordered = vector.clampf<ordered> %nan, %c0, %c1 : vector<4xf32>
  %number = vector.clampf<number> %nan, %c0, %c1 : vector<4xf32>
  %ieee = vector.clampf<ieee> %nan, %c0, %c1 : vector<4xf32>
  %ordered_lane = vector.extract %ordered[0] : vector<4xf32> -> f32
  %number_lane = vector.extract %number[1] : vector<4xf32> -> f32
  %ieee_lane = vector.extract %ieee[2] : vector<4xf32> -> f32
  %ordered_is_nan = scalar.isnanf %ordered_lane : f32
  %number_is_nan = scalar.isnanf %number_lane : f32
  %ieee_is_nan = scalar.isnanf %ieee_lane : f32
  func.return %ordered_is_nan, %number_is_nan, %ieee_is_nan : i1, i1, i1
}
// ----
func.def @vector_clampf_modes_uniform_nan() -> (i1, i1, i1) {
  %ordered_is_nan = scalar.constant true : i1
  %number_is_nan = scalar.constant false : i1
  %ieee_is_nan = scalar.constant true : i1
  func.return %ordered_is_nan, %number_is_nan, %ieee_is_nan : i1, i1, i1
}

// ====

// Identity elements can fold reductions over dynamic extents when the explicit
// accumulator is itself exact.
func.def @reduce_dynamic_zero_splat_addi(%n: index) -> (i32) {
  %c0 = scalar.constant 0 : i32
  %init = scalar.constant 5 : i32
  %v = vector.splat %c0 : vector<[%n]xi32>
  %r = vector.reduce<addi> %v, %init : vector<[%n]xi32>, i32
  func.return %r : i32
}
// ----
func.def @reduce_dynamic_zero_splat_addi(%n: index) -> (i32) {
  %r = scalar.constant 5 : i32
  func.return %r : i32
}

