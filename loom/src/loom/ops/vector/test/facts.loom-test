  %view = buffer.view %buffer[%offset] : buffer -> view<16xf8E5M2, %storage>
  %value = vector.load %view[0] : view<16xf8E5M2, %storage> -> vector<4xf8E5M2>
  %finite = test.fact_finite %value : vector<4xf8E5M2> -> i1
  %not_subnormal = test.fact_not_subnormal %value : vector<4xf8E5M2> -> i1
  func.return %finite, %not_subnormal : i1, i1
}
// ----
func.def @finite_flush_storage_vector_load_content(%buffer: buffer) -> (i1, i1) {
  %finite = scalar.constant true : i1
  %not_subnormal = scalar.constant true : i1
  func.return %finite, %not_subnormal : i1, i1
}

