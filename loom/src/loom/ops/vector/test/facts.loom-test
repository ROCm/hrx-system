// ====

// Raw FP8 storage schemas with explicit finite-only content contracts publish
// uniform element facts through vector.load while preserving subnormal
// uncertainty.
func.def @finite_only_storage_vector_load_content(%buffer: buffer) -> (i1, i1) {
  %offset = index.constant 0 : offset
  %layout = encoding.layout.dense : encoding<layout>
  %schema = encoding.define #encoding.f8e5m2<rounding=finite_only> : encoding<schema>
  %storage = encoding.define #encoding.storage {layout = %layout : encoding<layout>, schema = %schema : encoding<schema>} : encoding<storage>
  %view = buffer.view %buffer[%offset] : buffer -> view<16xf8E5M2, %storage>
  %value = vector.load %view[0] : view<16xf8E5M2, %storage> -> vector<4xf8E5M2>
  %finite = vector.isfinitef %value : vector<4xf8E5M2> -> vector<4xi1>
  %lane = vector.extract %finite[0] : vector<4xi1> -> i1
  %not_subnormal = test.fact_not_subnormal %value : vector<4xf8E5M2> -> i1
  func.return %lane, %not_subnormal : i1, i1
}
// ----
func.def @finite_only_storage_vector_load_content(%buffer: buffer) -> (i1, i1) {
  %lane = scalar.constant true : i1
  %not_subnormal = scalar.constant false : i1
  func.return %lane, %not_subnormal : i1, i1
}

// ====

// Finite-flush storage schemas strengthen finite-only payload facts by proving
// that storage/import has already removed subnormal payloads.
