// ====

// Other flags do not exclude NaNs or strengthen a neighboring comparison.
func.def @independent_permissions(%lhs: vector<4xf32>, %rhs: vector<4xf32>) -> (vector<4xi1>, vector<4xi1>, vector<4xi1>, vector<4xi1>) {
  %plain = vector.cmpf ord, %lhs, %rhs : vector<4xf32> -> vector<4xi1>
  %nnan = vector.cmpf<nnan> ord, %lhs, %rhs : vector<4xf32> -> vector<4xi1>
  %other = vector.cmpf<reassoc|ninf|nsz|arcp|contract|afn> ord, %lhs, %rhs : vector<4xf32> -> vector<4xi1>
  %same_other = vector.cmpf<reassoc|ninf|nsz|arcp|contract|afn> oeq, %lhs, %lhs : vector<4xf32> -> vector<4xi1>
  func.return %plain, %nnan, %other, %same_other : vector<4xi1>, vector<4xi1>, vector<4xi1>, vector<4xi1>
}

// ----
func.def @independent_permissions(%lhs: vector<4xf32>, %rhs: vector<4xf32>) -> (vector<4xi1>, vector<4xi1>, vector<4xi1>, vector<4xi1>) {
  %plain = vector.cmpf ord, %lhs, %rhs : vector<4xf32> -> vector<4xi1>
  %nnan = vector.splati 1 : vector<4xi1>
  %other = vector.cmpf<reassoc|ninf|nsz|arcp|contract|afn> ord, %lhs, %rhs : vector<4xf32> -> vector<4xi1>
  %same_other = vector.cmpf<reassoc|ninf|nsz|arcp|contract|afn> oeq, %lhs, %lhs : vector<4xf32> -> vector<4xi1>
  func.return %plain, %nnan, %other, %same_other : vector<4xi1>, vector<4xi1>, vector<4xi1>, vector<4xi1>
}

// ====

// Classification results are uniform, including for unknown BF16 lanes.
func.def @classification_consumers(%lhs: vector<4xbf16>, %rhs: vector<4xbf16>) -> (i32, i64, i64) {
  %ordered = vector.cmpf<nnan> ord, %lhs, %rhs : vector<4xbf16> -> vector<4xi1>
  %unordered = vector.cmpf<nnan> uno, %lhs, %rhs : vector<4xbf16> -> vector<4xi1>
  %wide = vector.extui %ordered : vector<4xi1> to vector<4xi32>
  %lane = vector.extract %wide[0] : vector<4xi32> -> i32
  %bit = vector.extract %unordered[1] : vector<4xi1> -> i1
  %lo = test.fact_range_lo %bit : i1 -> i64
  %hi = test.fact_range_hi %bit : i1 -> i64
  func.return %lane, %lo, %hi : i32, i64, i64
}

// ----
func.def @classification_consumers(%lhs: vector<4xbf16>, %rhs: vector<4xbf16>) -> (i32, i64, i64) {
  %lane = scalar.constant 1 : i32
  %lo = scalar.constant 0 : i64
  %hi = scalar.constant 0 : i64
  func.return %lane, %lo, %hi : i32, i64, i64
}

// ====

// Exceptional lanes retain ordinary NaN and signed-zero semantics.
func.def @exceptional_values() -> (i1, i1, i1, i1) {
  %nan = scalar.constant nan : f32
  %cn0 = scalar.constant -0.0 : f32
  %infinity = scalar.constant inf : f32
  %values = vector.from_elements %nan, %cn0, %infinity : vector<3xf32>
  %ordered = vector.cmpf ord, %values, %values : vector<3xf32> -> vector<3xi1>
  %equal = vector.cmpf oeq, %values, %values : vector<3xf32> -> vector<3xi1>
  %unordered_equal = vector.cmpf ueq, %values, %values : vector<3xf32> -> vector<3xi1>
  %nan_ordered = vector.extract %ordered[0] : vector<3xi1> -> i1
  %nan_unordered_equal = vector.extract %unordered_equal[0] : vector<3xi1> -> i1
  %zero_equal = vector.extract %equal[1] : vector<3xi1> -> i1
  %infinity_equal = vector.extract %equal[2] : vector<3xi1> -> i1
  func.return %nan_ordered, %nan_unordered_equal, %zero_equal, %infinity_equal : i1, i1, i1, i1
}

// ----
func.def @exceptional_values() -> (i1, i1, i1, i1) {
  %nan_ordered = scalar.constant false : i1
  %nan_unordered_equal = scalar.constant true : i1
  %zero_equal = scalar.constant true : i1
  %infinity_equal = scalar.constant true : i1
  func.return %nan_ordered, %nan_unordered_equal, %zero_equal, %infinity_equal : i1, i1, i1, i1
}
