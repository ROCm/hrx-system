  %underflow_below = scalar.constant 2.9802322387695309e-08 : f64
  %underflow_above = scalar.constant 2.9802322387695319e-08 : f64
  %negative_underflow_below = scalar.constant -2.9802322387695309e-08 : f64
  %negative_underflow_above = scalar.constant -2.9802322387695319e-08 : f64
  %overflow_below = scalar.constant 65519.999999999993 : f64
  %overflow_above = scalar.constant 65520.000000000007 : f64
  %negative_overflow_below = scalar.constant -65519.999999999993 : f64
  %negative_overflow_above = scalar.constant -65520.000000000007 : f64
  %positive_infinity = scalar.constant inf : f64
  %negative_infinity = scalar.constant -inf : f64
  %positive_sign_input = scalar.constant 0.0 : f64
