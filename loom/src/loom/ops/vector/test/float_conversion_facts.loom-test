// ====

// An explicit F32 intermediate still rounds before the BF16 conversion.
func.def @f64_staged_narrowing() -> (bf16, bf16) {
  %input = vector.constant 1.0039062500000002 : vector<4xf64>
  %direct = vector.fptrunc %input : vector<4xf64> to vector<4xbf16>
  %intermediate = vector.fptrunc %input : vector<4xf64> to vector<4xf32>
  %staged = vector.fptrunc %intermediate : vector<4xf32> to vector<4xbf16>
  %direct_value = vector.extract %direct[0] : vector<4xbf16> -> bf16
  %staged_value = vector.extract %staged[0] : vector<4xbf16> -> bf16
  func.return %direct_value, %staged_value : bf16, bf16
}

// ----
func.def @f64_staged_narrowing() -> (bf16, bf16) {
  %direct_value = scalar.constant 1.0078125 : bf16
  %staged_value = scalar.constant 1.0 : bf16
  func.return %direct_value, %staged_value : bf16, bf16
}

// ====

// A NaN or dynamic lane prevents whole-vector materialization while an exact
// sibling lane still folds. Classification does not invent a NaN payload.
func.def @f64_partial_narrowing(%dynamic: f64) -> (vector<3xbf16>, i1, bf16) {
  %nan_bits = scalar.constant 9218868437227405313 : i64
  %nan = scalar.bitcast %nan_bits : i64 to f64
  %above_midpoint = scalar.constant 1.0039062500000002 : f64
  %input = vector.from_elements %nan, %above_midpoint, %dynamic : vector<3xf64>
  %narrow = vector.fptrunc %input : vector<3xf64> to vector<3xbf16>
  %classes = vector.isnanf %narrow : vector<3xbf16> -> vector<3xi1>
  %is_nan = vector.extract %classes[0] : vector<3xi1> -> i1
  %exact = vector.extract %narrow[1] : vector<3xbf16> -> bf16
  func.return %narrow, %is_nan, %exact : vector<3xbf16>, i1, bf16
}

// ----
func.def @f64_partial_narrowing(%dynamic: f64) -> (vector<3xbf16>, i1, bf16) {
  %nan_bits = scalar.constant 9218868437227405313 : i64
  %nan = scalar.bitcast %nan_bits : i64 to f64
  %above_midpoint = scalar.constant 1.0039062500000002 : f64
  %input = vector.from_elements %nan, %above_midpoint, %dynamic : vector<3xf64>
  %narrow = vector.fptrunc %input : vector<3xf64> to vector<3xbf16>
  %is_nan = scalar.constant true : i1
  %exact = scalar.constant 1.0078125 : bf16
  func.return %narrow, %is_nan, %exact : vector<3xbf16>, i1, bf16
}
