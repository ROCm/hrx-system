// RUN: pass canonicalize

func.def @uniform_scaling() -> (vector<2xbf16>, vector<2xi32>, vector<2xbf16>) {
  %input = vector.splatf -1.5 : vector<2xbf16>
  %power = vector.splati -2 : vector<2xi32>
  %fraction, %exponent = vector.frexpf %input : vector<2xbf16>, vector<2xi32>
  %scaled = vector.ldexpf %input, %power : vector<2xbf16>, vector<2xi32>
  func.return %fraction, %exponent, %scaled : vector<2xbf16>, vector<2xi32>, vector<2xbf16>
}

// ----
func.def @uniform_scaling() -> (vector<2xbf16>, vector<2xi32>, vector<2xbf16>) {
  %fraction = vector.splatf -0.75 : vector<2xbf16>
  %exponent = vector.splati 1 : vector<2xi32>
  %scaled = vector.splatf -0.375 : vector<2xbf16>
  func.return %fraction, %exponent, %scaled : vector<2xbf16>, vector<2xi32>, vector<2xbf16>
}

// ====

func.def @nonuniform_scaling() -> (f64, i32, f64, f64, i32, f64) {
  %tiny = scalar.constant 4.9406564584124654e-324 : f64
  %negative = scalar.constant -1.5 : f64
  %normalize = scalar.constant 1074 : i32
  %shrink = scalar.constant -2 : i32
  %input = vector.from_elements %tiny, %negative : vector<2xf64>
  %powers = vector.from_elements %normalize, %shrink : vector<2xi32>
  %fractions, %exponents = vector.frexpf %input : vector<2xf64>, vector<2xi32>
  %scaled = vector.ldexpf %input, %powers : vector<2xf64>, vector<2xi32>
  %tiny_fraction = vector.extract %fractions[0] : vector<2xf64> -> f64
  %tiny_exponent = vector.extract %exponents[0] : vector<2xi32> -> i32
  %tiny_scaled = vector.extract %scaled[0] : vector<2xf64> -> f64
  %negative_fraction = vector.extract %fractions[1] : vector<2xf64> -> f64
  %negative_exponent = vector.extract %exponents[1] : vector<2xi32> -> i32
  %negative_scaled = vector.extract %scaled[1] : vector<2xf64> -> f64
  func.return %tiny_fraction, %tiny_exponent, %tiny_scaled, %negative_fraction, %negative_exponent, %negative_scaled : f64, i32, f64, f64, i32, f64
}

// ----
func.def @nonuniform_scaling() -> (f64, i32, f64, f64, i32, f64) {
  %tiny_fraction = scalar.constant 0.5 : f64
  %tiny_exponent = scalar.constant -1073 : i32
  %tiny_scaled = scalar.constant 1.0 : f64
  %negative_fraction = scalar.constant -0.75 : f64
  %negative_exponent = scalar.constant 1 : i32
  %negative_scaled = scalar.constant -0.375 : f64
  func.return %tiny_fraction, %tiny_exponent, %tiny_scaled, %negative_fraction, %negative_exponent, %negative_scaled : f64, i32, f64, f64, i32, f64
}

// ====

// The NaN payload cannot be materialized as a compact float fact. Its exponent
// can still fold without replacing the fraction's observable computation.
func.def @partial_uniform_decomposition() -> (vector<2xbf16>, vector<2xi32>) {
  %payload = vector.splati 32641 : vector<2xi16>
  %input = vector.bitcast %payload : vector<2xi16> to vector<2xbf16>
  %fraction, %exponent = vector.frexpf %input : vector<2xbf16>, vector<2xi32>
  func.return %fraction, %exponent : vector<2xbf16>, vector<2xi32>
}

// ----
func.def @partial_uniform_decomposition() -> (vector<2xbf16>, vector<2xi32>) {
  %payload = vector.splati 32641 : vector<2xi16>
  %input = vector.bitcast %payload : vector<2xi16> to vector<2xbf16>
  %exponent$6 = vector.splati 0 : vector<2xi32>
  %fraction, %exponent$5 = vector.frexpf %input : vector<2xbf16>, vector<2xi32>
  func.return %fraction, %exponent$6 : vector<2xbf16>, vector<2xi32>
}
