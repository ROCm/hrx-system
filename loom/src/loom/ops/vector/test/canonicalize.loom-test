  func.return %r : vector<0xi32>
}
// ----
func.def @empty_atomic_rmw(%buffer: buffer, %offset: offset) -> (vector<0xi32>) {
  %r = vector.empty : vector<0xi32>
  func.return %r : vector<0xi32>
}

// ====

// Zero-lane atomic reductions erase completely.
