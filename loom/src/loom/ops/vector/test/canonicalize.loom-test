func.def @select_uniform_true(%a: vector<4xi32>, %b: vector<4xi32>) -> (vector<4xi32>) {
  func.return %a : vector<4xi32>
}

// ====

// A dynamically uniform mask is whole-value selection. Keeping the scalar
// condition avoids materializing and transporting a redundant mask vector.
func.def @select_splat_condition(%condition: i1, %a: vector<4xi16>, %b: vector<4xi16>) -> (vector<4xi16>) {
  %mask = vector.splat %condition : vector<4xi1>
