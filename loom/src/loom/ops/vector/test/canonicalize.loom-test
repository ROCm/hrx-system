// ====

// Zero-lane compare-exchange has no compare payload lanes and returns empty.
func.def @empty_atomic_cmpxchg(%buffer: buffer, %offset: offset) -> (vector<0xi32>) {
  %layout = encoding.layout.dense : encoding<layout>
  %view = buffer.view %buffer[%offset] : buffer -> view<16xi32, %layout>
