  func.return %r : vector<4xi16>
}
// ----
func.def @select_splat_condition(%condition: i1, %a: vector<4xi16>, %b: vector<4xi16>) -> (vector<4xi16>) {
  %r = scf.select %condition, %a, %b : vector<4xi16>
  func.return %r : vector<4xi16>
}

// ====

// Repeated scalar operands are more regular as a splat.
func.def @from_elements_same_operand_to_splat(%x: f32) -> (vector<4xf32>) {
