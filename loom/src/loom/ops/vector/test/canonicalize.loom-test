// RUN: pass canonicalize

// Extracting exactly the leading axes introduced by a broadcast returns the
// original trailing vector.
func.def @extract_broadcast_leading_axes(%value: vector<4xf32>) -> (vector<4xf32>) {
  %bank = vector.broadcast %value : vector<4xf32> -> vector<2x3x4xf32>
  %result = vector.extract %bank[1, 2] : vector<2x3x4xf32> -> vector<4xf32>
  func.return %result : vector<4xf32>
}
// ----
func.def @extract_broadcast_leading_axes(%value: vector<4xf32>) -> (vector<4xf32>) {
  func.return %value : vector<4xf32>
}

// ====

// Extracting the slot just inserted returns the inserted payload.
func.def @extract_insert_same_slot(%dest: vector<2x2x4xf32>, %value: vector<4xf32>) -> (vector<4xf32>) {
  %updated = vector.insert %value into %dest[1, 0] : vector<4xf32>, vector<2x2x4xf32>
  %result = vector.extract %updated[1, 0] : vector<2x2x4xf32> -> vector<4xf32>
  func.return %result : vector<4xf32>
}
// ----
func.def @extract_insert_same_slot(%dest: vector<2x2x4xf32>, %value: vector<4xf32>) -> (vector<4xf32>) {
  func.return %value : vector<4xf32>
}

// ====

// Equal-rank static prefixes select disjoint slots when any index differs.
func.def @extract_insert_disjoint_slot(%dest: vector<2x2x4xf32>, %value: vector<4xf32>) -> (vector<4xf32>) {
  %updated = vector.insert %value into %dest[1, 0] : vector<4xf32>, vector<2x2x4xf32>
  %result = vector.extract %updated[0, 1] : vector<2x2x4xf32> -> vector<4xf32>
  func.return %result : vector<4xf32>
}
// ----
func.def @extract_insert_disjoint_slot(%dest: vector<2x2x4xf32>, %value: vector<4xf32>) -> (vector<4xf32>) {
  %result = vector.extract %dest[0, 1] : vector<2x2x4xf32> -> vector<4xf32>
  func.return %result : vector<4xf32>
}

// ====

// Reinserting an unchanged slot returns the original aggregate.
func.def @insert_unchanged_slot(%dest: vector<2x2x4xf32>) -> (vector<2x2x4xf32>) {
  %value = vector.extract %dest[1, 0] : vector<2x2x4xf32> -> vector<4xf32>
  %result = vector.insert %value into %dest[1, 0] : vector<4xf32>, vector<2x2x4xf32>
  func.return %result : vector<2x2x4xf32>
}
// ----
func.def @insert_unchanged_slot(%dest: vector<2x2x4xf32>) -> (vector<2x2x4xf32>) {
  func.return %dest : vector<2x2x4xf32>
}

// ====

// A later write to the same slot makes the earlier write irrelevant.
func.def @insert_overwrites_same_slot(%dest: vector<2x2x4xf32>, %first: vector<4xf32>, %second: vector<4xf32>) -> (vector<2x2x4xf32>) {
  %updated = vector.insert %first into %dest[1, 0] : vector<4xf32>, vector<2x2x4xf32>
  %result = vector.insert %second into %updated[1, 0] : vector<4xf32>, vector<2x2x4xf32>
  func.return %result : vector<2x2x4xf32>
}
// ----
func.def @insert_overwrites_same_slot(%dest: vector<2x2x4xf32>, %first: vector<4xf32>, %second: vector<4xf32>) -> (vector<2x2x4xf32>) {
  %result = vector.insert %second into %dest[1, 0] : vector<4xf32>, vector<2x2x4xf32>
  func.return %result : vector<2x2x4xf32>
}

// ====

// Exact dynamic coordinates become static insert indices.
func.def @insert_dynamic_exact_indices(%dest: vector<2x2x4xf32>, %value: vector<4xf32>) -> (vector<2x2x4xf32>) {
  %row = index.constant 1 : index
  %column = index.constant 0 : index
  %result = vector.insert %value into %dest[%row, %column] : vector<4xf32>, vector<2x2x4xf32>
  func.return %result : vector<2x2x4xf32>
}
// ----
func.def @insert_dynamic_exact_indices(%dest: vector<2x2x4xf32>, %value: vector<4xf32>) -> (vector<2x2x4xf32>) {
  %result = vector.insert %value into %dest[1, 0] : vector<4xf32>, vector<2x2x4xf32>
  func.return %result : vector<2x2x4xf32>
}

// ====

// Extension chains collapse to the final width.
func.def @float_extension_chain(%x: vector<4xf8E4M3>) -> (vector<4xf32>) {
  %bf16 = vector.extf %x : vector<4xf8E4M3> to vector<4xbf16>
  %f32 = vector.extf %bf16 : vector<4xbf16> to vector<4xf32>
  func.return %f32 : vector<4xf32>
}
// ----
func.def @float_extension_chain(%x: vector<4xf8E4M3>) -> (vector<4xf32>) {
  %f32 = vector.extf %x : vector<4xf8E4M3> to vector<4xf32>
  func.return %f32 : vector<4xf32>
}

// ====

// Truncating an exact extension collapses to the direct resize.
func.def @float_trunc_after_extension(%x: vector<4xf8E4M3>) -> (vector<4xbf16>) {
  %f32 = vector.extf %x : vector<4xf8E4M3> to vector<4xf32>
  %bf16 = vector.fptrunc %f32 : vector<4xf32> to vector<4xbf16>
  func.return %bf16 : vector<4xbf16>
}
// ----
func.def @float_trunc_after_extension(%x: vector<4xf8E4M3>) -> (vector<4xbf16>) {
  %bf16 = vector.extf %x : vector<4xf8E4M3> to vector<4xbf16>
  func.return %bf16 : vector<4xbf16>
}

// ====

// Truncating an extension back to the original type returns the source.
func.def @float_resize_roundtrip(%x: vector<4xf16>) -> (vector<4xf16>) {
  %f32 = vector.extf %x : vector<4xf16> to vector<4xf32>
  %f16 = vector.fptrunc %f32 : vector<4xf32> to vector<4xf16>
  func.return %f16 : vector<4xf16>
}
// ----
func.def @float_resize_roundtrip(%x: vector<4xf16>) -> (vector<4xf16>) {
  func.return %x : vector<4xf16>
}

// ====

// Casting a splat casts the scalar once and then splats the result.
func.def @float_extf_splat(%x: bf16) -> (vector<4xf32>) {
  %splat = vector.splat %x : vector<4xbf16>
  %wide = vector.extf %splat : vector<4xbf16> to vector<4xf32>
  func.return %wide : vector<4xf32>
}
// ----
func.def @float_extf_splat(%x: bf16) -> (vector<4xf32>) {
  %4 = scalar.extf %x : bf16 to f32
  %wide = vector.splat %4 : vector<4xf32>
  func.return %wide : vector<4xf32>
}

// ====

func.def @float_fptrunc_splat(%x: f32) -> (vector<4xbf16>) {
  %splat = vector.splat %x : vector<4xf32>
  %narrow = vector.fptrunc %splat : vector<4xf32> to vector<4xbf16>
  func.return %narrow : vector<4xbf16>
}
// ----
func.def @float_fptrunc_splat(%x: f32) -> (vector<4xbf16>) {
  %4 = scalar.fptrunc %x : f32 to bf16
  %narrow = vector.splat %4 : vector<4xbf16>
  func.return %narrow : vector<4xbf16>
}

// ====

// Floating-point truncation chains must not collapse: double rounding can be
// observably different from one direct truncation.
func.def @float_truncation_chain_preserves_rounding(%x: vector<4xf64>) -> (vector<4xf16>) {
  %f32 = vector.fptrunc %x : vector<4xf64> to vector<4xf32>
  %f16 = vector.fptrunc %f32 : vector<4xf32> to vector<4xf16>
  func.return %f16 : vector<4xf16>
}
// ----
func.def @float_truncation_chain_preserves_rounding(%x: vector<4xf64>) -> (vector<4xf16>) {
  %f32 = vector.fptrunc %x : vector<4xf64> to vector<4xf32>
  %f16 = vector.fptrunc %f32 : vector<4xf32> to vector<4xf16>
  func.return %f16 : vector<4xf16>
}

// ====

// Zero-lane construction produces the empty aggregate even when the source
// scalar is poison: no vector lane observes the operand.
func.def @empty_splat_ignores_poison() -> (vector<0xf32>) {
  %p = scalar.poison : f32
  %r = vector.splat %p : vector<0xf32>
  func.return %r : vector<0xf32>
}
// ----
func.def @empty_splat_ignores_poison() -> (vector<0xf32>) {
  %r = vector.empty : vector<0xf32>
  func.return %r : vector<0xf32>
}

// ====

// Zero-lane lanewise computation has exactly one valid result: vector.empty.
func.def @empty_lanewise(%a: vector<0xf32>, %b: vector<0xf32>) -> (vector<0xf32>) {
  %r = vector.addf %a, %b : vector<0xf32>
  func.return %r : vector<0xf32>
}
// ----
func.def @empty_lanewise(%a: vector<0xf32>, %b: vector<0xf32>) -> (vector<0xf32>) {
  %r = vector.empty : vector<0xf32>
  func.return %r : vector<0xf32>
}

// ====

// A zero-lane iota has no observable coordinate lanes.
func.def @empty_iota(%base: index, %step: index) -> (vector<0xindex>) {
  %r = vector.iota %base step %step : vector<0xindex>
  func.return %r : vector<0xindex>
}
// ----
func.def @empty_iota(%base: index, %step: index) -> (vector<0xindex>) {
  %r = vector.empty : vector<0xindex>
  func.return %r : vector<0xindex>
}

// ====

// A small static iota with exact base and step materializes explicit lanes.
func.def @static_iota_to_from_elements() -> (vector<4xi32>) {
  %base = scalar.constant 3 : i32
  %step = scalar.constant 4 : i32
  %r = vector.iota %base step %step : vector<4xi32>
  func.return %r : vector<4xi32>
}
// ----
func.def @static_iota_to_from_elements() -> (vector<4xi32>) {
  %4 = scalar.constant 3 : i32
  %5 = scalar.constant 7 : i32
  %6 = scalar.constant 11 : i32
  %7 = scalar.constant 15 : i32
  %r = vector.from_elements %4, %5, %6, %7 : vector<4xi32>
  func.return %r : vector<4xi32>
}

// ====

// Static extraction from iota folds through the lane-coordinate formula.
func.def @extract_iota_static_lane_to_constant() -> (index, i32) {
  %base = index.constant 5 : index
  %step = index.constant 2 : index
  %lanes = vector.iota %base step %step : vector<4xindex>
  %lane2 = vector.extract %lanes[2] : vector<4xindex> -> index
  %i32_base = scalar.constant 3 : i32
  %i32_step = scalar.constant 4 : i32
  %offsets = vector.iota %i32_base step %i32_step : vector<4xi32>
  %lane3 = vector.extract %offsets[3] : vector<4xi32> -> i32
  func.return %lane2, %lane3 : index, i32
}
// ----
func.def @extract_iota_static_lane_to_constant() -> (index, i32) {
  %lane2 = index.constant 9 : index
  %lane3 = scalar.constant 15 : i32
  func.return %lane2, %lane3 : index, i32
}

// ====

// Dynamic extraction with an exact lane index becomes a static extraction, then
// folds through from_elements.
func.def @extract_from_elements_dynamic_exact_lane() -> (i32) {
  %lane_index = index.constant 1 : index
  %lane0 = scalar.constant 4 : i32
  %lane1 = scalar.constant 5 : i32
  %lanes = vector.from_elements %lane0, %lane1 : vector<2xi32>
  %r = vector.extract %lanes[%lane_index] : vector<2xi32> -> i32
  func.return %r : i32
}
// ----
func.def @extract_from_elements_dynamic_exact_lane() -> (i32) {
  %r = scalar.constant 5 : i32
  func.return %r : i32
}

// ====

// Dynamic extraction with an exact lane index also folds through iota's lane
// formula.
func.def @extract_iota_dynamic_exact_lane_to_constant() -> (index, i32) {
  %lane_index = index.constant 2 : index
  %base = index.constant 5 : index
  %step = index.constant 2 : index
  %index_lanes = vector.iota %base step %step : vector<4xindex>
  %index_lane = vector.extract %index_lanes[%lane_index] : vector<4xindex> -> index
  %i32_base = scalar.constant 3 : i32
  %i32_step = scalar.constant 4 : i32
  %i32_lanes = vector.iota %i32_base step %i32_step : vector<4xi32>
  %i32_lane = vector.extract %i32_lanes[%lane_index] : vector<4xi32> -> i32
  func.return %index_lane, %i32_lane : index, i32
}
// ----
func.def @extract_iota_dynamic_exact_lane_to_constant() -> (index, i32) {
  %index_lane = index.constant 9 : index
  %i32_lane = scalar.constant 11 : i32
  func.return %index_lane, %i32_lane : index, i32
}

// ====

// Static extraction from dynamic iota lanes lowers to the scalar lane formula.
func.def @extract_iota_dynamic_values_to_scalar_formula(%base: index, %step: index, %i32_base: i32, %i32_step: i32) -> (index, index, index, i32) {
  %index_lanes = vector.iota %base step %step : vector<4xindex>
  %index_lane0 = vector.extract %index_lanes[0] : vector<4xindex> -> index
  %index_lane1 = vector.extract %index_lanes[1] : vector<4xindex> -> index
  %index_lane2 = vector.extract %index_lanes[2] : vector<4xindex> -> index
  %i32_lanes = vector.iota %i32_base step %i32_step : vector<4xi32>
  %i32_lane2 = vector.extract %i32_lanes[2] : vector<4xi32> -> i32
  func.return %index_lane0, %index_lane1, %index_lane2, %i32_lane2 : index, index, index, i32
}
// ----
func.def @extract_iota_dynamic_values_to_scalar_formula(%base: index, %step: index, %i32_base: i32, %i32_step: i32) -> (index, index, index, i32) {
  %index_lane1 = index.add %base, %step : index
  %19 = index.constant 2 : index
  %index_lane2 = index.madd %step, %19, %base : index
  %17 = scalar.constant 1 : i32
  %18 = scalar.shli %i32_step, %17 : i32
  %i32_lane2 = scalar.addi %i32_base, %18 : i32
  func.return %base, %index_lane1, %index_lane2, %i32_lane2 : index, index, index, i32
}

// ====

// The from_elements workaround for explicit dynamic lane formulas folds back to
// the selected scalar operand.
func.def @extract_from_elements_dynamic_operands_to_operand(%base: i32, %next: i32) -> (i32) {
  %lanes = vector.from_elements %base, %next : vector<2xi32>
  %r = vector.extract %lanes[1] : vector<2xi32> -> i32
  func.return %r : i32
}
// ----
func.def @extract_from_elements_dynamic_operands_to_operand(%base: i32, %next: i32) -> (i32) {
  func.return %next : i32
}

// ====

// Reconstructing an ordered gather of static lane extracts restores the
// original vector value.
func.def @from_elements_of_ordered_extracts_to_source(%values: vector<4xi32>) -> (vector<4xi32>) {
  %lane0 = vector.extract %values[0] : vector<4xi32> -> i32
  %lane1 = vector.extract %values[1] : vector<4xi32> -> i32
  %lane2 = vector.extract %values[2] : vector<4xi32> -> i32
  %lane3 = vector.extract %values[3] : vector<4xi32> -> i32
  %gathered = vector.from_elements %lane0, %lane1, %lane2, %lane3 : vector<4xi32>
  func.return %gathered : vector<4xi32>
}
// ----
func.def @from_elements_of_ordered_extracts_to_source(%values: vector<4xi32>) -> (vector<4xi32>) {
  func.return %values : vector<4xi32>
}

// ====

// Scalar lane chains produced by importers fold back to the equivalent vector
// operations before target lowering has to rediscover the vector intent.
func.def @from_elements_of_scalarized_quantizer_chain(%values: vector<4xf32>) -> (vector<4xi8>) {
  %lane0 = vector.extract %values[0] : vector<4xf32> -> f32
  %rounded0 = scalar.roundevenf %lane0 : f32
  %i32_0 = scalar.fptosi %rounded0 : f32 to i32
  %i8_0 = scalar.trunci %i32_0 : i32 to i8
  %lane1 = vector.extract %values[1] : vector<4xf32> -> f32
  %rounded1 = scalar.roundevenf %lane1 : f32
  %i32_1 = scalar.fptosi %rounded1 : f32 to i32
  %i8_1 = scalar.trunci %i32_1 : i32 to i8
  %lane2 = vector.extract %values[2] : vector<4xf32> -> f32
  %rounded2 = scalar.roundevenf %lane2 : f32
  %i32_2 = scalar.fptosi %rounded2 : f32 to i32
  %i8_2 = scalar.trunci %i32_2 : i32 to i8
  %lane3 = vector.extract %values[3] : vector<4xf32> -> f32
  %rounded3 = scalar.roundevenf %lane3 : f32
  %i32_3 = scalar.fptosi %rounded3 : f32 to i32
  %i8_3 = scalar.trunci %i32_3 : i32 to i8
  %packed = vector.from_elements %i8_0, %i8_1, %i8_2, %i8_3 : vector<4xi8>
  func.return %packed : vector<4xi8>
}
// ----
func.def @from_elements_of_scalarized_quantizer_chain(%values: vector<4xf32>) -> (vector<4xi8>) {
  %19 = vector.roundevenf %values : vector<4xf32>
  %20 = vector.fptosi %19 : vector<4xf32> to vector<4xi32>
  %packed = vector.trunci %20 : vector<4xi32> to vector<4xi8>
  func.return %packed : vector<4xi8>
}

// ====

// The same scalar integer conversion can feed a floating-point q-sum path and
// a packed-byte path. Canonicalization reconstructs both vector chains; CSE in
// the normal cleanup pipeline merges the duplicated vector.fptosi.
func.def @from_elements_of_scalarized_quantizer_dual_use(%values: vector<4xf32>) -> (vector<4xf32>, vector<4xi8>) {
  %lane0 = vector.extract %values[0] : vector<4xf32> -> f32
  %i32_0 = scalar.fptosi %lane0 : f32 to i32
  %f32_0 = scalar.sitofp %i32_0 : i32 to f32
  %i8_0 = scalar.trunci %i32_0 : i32 to i8
  %lane1 = vector.extract %values[1] : vector<4xf32> -> f32
  %i32_1 = scalar.fptosi %lane1 : f32 to i32
  %f32_1 = scalar.sitofp %i32_1 : i32 to f32
  %i8_1 = scalar.trunci %i32_1 : i32 to i8
  %lane2 = vector.extract %values[2] : vector<4xf32> -> f32
  %i32_2 = scalar.fptosi %lane2 : f32 to i32
  %f32_2 = scalar.sitofp %i32_2 : i32 to f32
  %i8_2 = scalar.trunci %i32_2 : i32 to i8
  %lane3 = vector.extract %values[3] : vector<4xf32> -> f32
  %i32_3 = scalar.fptosi %lane3 : f32 to i32
  %f32_3 = scalar.sitofp %i32_3 : i32 to f32
  %i8_3 = scalar.trunci %i32_3 : i32 to i8
  %q_f32 = vector.from_elements %f32_0, %f32_1, %f32_2, %f32_3 : vector<4xf32>
  %q_i8 = vector.from_elements %i8_0, %i8_1, %i8_2, %i8_3 : vector<4xi8>
  func.return %q_f32, %q_i8 : vector<4xf32>, vector<4xi8>
}
// ----
func.def @from_elements_of_scalarized_quantizer_dual_use(%values: vector<4xf32>) -> (vector<4xf32>, vector<4xi8>) {
  %23 = vector.fptosi %values : vector<4xf32> to vector<4xi32>
  %q_f32 = vector.sitofp %23 : vector<4xi32> to vector<4xf32>
  %21 = vector.fptosi %values : vector<4xf32> to vector<4xi32>
  %q_i8 = vector.trunci %21 : vector<4xi32> to vector<4xi8>
  func.return %q_f32, %q_i8 : vector<4xf32>, vector<4xi8>
}

// ====

func.def @divf_arcp_constant_rhs_to_reciprocal_mulf(%values: vector<4xf32>) -> (vector<4xf32>, vector<4xf32>) {
  %scale = vector.constant 127.0 : vector<4xf32>
  %strict = vector.divf %values, %scale : vector<4xf32>
  %fast = vector.divf<nnan|ninf|nsz|arcp> %values, %scale : vector<4xf32>
  func.return %strict, %fast : vector<4xf32>, vector<4xf32>
}
// ----
func.def @divf_arcp_constant_rhs_to_reciprocal_mulf(%values: vector<4xf32>) -> (vector<4xf32>, vector<4xf32>) {
  %scale = vector.constant 127.0 : vector<4xf32>
  %strict = vector.divf %values, %scale : vector<4xf32>
  %6 = vector.constant 0.007874015718698502 : vector<4xf32>
  %fast = vector.mulf<nnan|ninf|nsz|arcp> %values, %6 : vector<4xf32>
  func.return %strict, %fast : vector<4xf32>, vector<4xf32>
}

// ====

// A single scalar lane extracted from a vector load can narrow to a scalar
// view.load. This avoids forcing wide payload lowering for table-style record
// loads where only one field is used.
func.def @extract_single_use_load_to_view_load(%input: buffer, %offset: offset) -> (i32) {
  %view = buffer.view %input[%offset] : buffer -> view<4xi32>
  %wide = vector.load %view[0] : view<4xi32> -> vector<4xi32>
  %lane2 = vector.extract %wide[2] : vector<4xi32> -> i32
  func.return %lane2 : i32
}
// ----
func.def @extract_single_use_load_to_view_load(%input: buffer, %offset: offset) -> (i32) {
  %view = buffer.view %input[%offset] : buffer -> view<4xi32>
  %lane2 = view.load %view[2] : view<4xi32> -> i32
  func.return %lane2 : i32
}

// ====

// Workgroup vector loads preserve their footprint even when only one scalar
// lane is consumed. Backends use the vector memory operation as a scheduling
// contract for LDS packet selection.
kernel.def @extract_single_use_workgroup_load_keeps_wide_load() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch() {
  %base = index.constant 0 : offset
  %bytes = index.constant 64 : offset
  %scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  %view = buffer.view %scratch[%base] : buffer -> view<4xi32>
  %seed = vector.constant 1 : vector<4xi32>
  vector.store %seed, %view[0] : vector<4xi32>, view<4xi32>
  %wide = vector.load %view[0] : view<4xi32> -> vector<4xi32>
  %lane2 = vector.extract %wide[2] : vector<4xi32> -> i32
  view.store %lane2, %view[0] : i32, view<4xi32>
  kernel.return
}

// ====

// When multiple scalar lanes are extracted, the wide vector load is still the
// better canonical form: target lowering can select one coalesced memory op and
// slice registers instead of scalarizing into several smaller loads.
func.def @extract_multi_use_load_keeps_wide_load(%input: buffer, %offset: offset) -> (i32, i32) {
  %view = buffer.view %input[%offset] : buffer -> view<4xi32>
  %wide = vector.load %view[0] : view<4xi32> -> vector<4xi32>
  %lane1 = vector.extract %wide[1] : vector<4xi32> -> i32
  %lane2 = vector.extract %wide[2] : vector<4xi32> -> i32
  func.return %lane1, %lane2 : i32, i32
}

// ====

// Narrowing a volatile vector load would discard observable accesses to the
// lanes outside of the extract footprint.
func.def @extract_volatile_load_keeps_wide_load(%input: buffer, %offset: offset) -> (i32) {
  %view = buffer.view %input[%offset] : buffer -> view<4xi32>
  %wide = vector.load<volatile> %view[0] : view<4xi32> -> vector<4xi32>
  %lane2 = vector.extract %wide[2] : vector<4xi32> -> i32
  func.return %lane2 : i32
}

// ====

// A zero-lane range mask performs no range tests.
func.def @empty_mask_range(%lo: index, %hi: index, %step: index) -> (vector<0xi1>) {
  %r = vector.mask.range [%lo to %hi step %step] : index -> vector<0xi1>
  func.return %r : vector<0xi1>
}
// ----
func.def @empty_mask_range(%lo: index, %hi: index, %step: index) -> (vector<0xi1>) {
  %r = vector.empty : vector<0xi1>
  func.return %r : vector<0xi1>
}

// ====

// A static range covering every lane becomes an all-true mask constant.
func.def @mask_range_static_all_true() -> (vector<4xi1>) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %r = vector.mask.range [%c0 to %c4 step %c1] : index -> vector<4xi1>
  func.return %r : vector<4xi1>
}
// ----
func.def @mask_range_static_all_true() -> (vector<4xi1>) {
  %r = vector.constant true : vector<4xi1>
  func.return %r : vector<4xi1>
}

// ====

// A non-negative static range that starts at the exclusive bound is all false.
func.def @mask_range_static_all_false() -> (vector<4xi1>) {
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %r = vector.mask.range [%c4 to %c4 step %c1] : index -> vector<4xi1>
  func.return %r : vector<4xi1>
}
// ----
func.def @mask_range_static_all_false() -> (vector<4xi1>) {
  %r = vector.constant false : vector<4xi1>
  func.return %r : vector<4xi1>
}

// ====

// Bounded dynamic operands prove every static lane is below the exclusive
// upper bound.
func.def @mask_range_bounded_all_true(%lo0: index, %hi0: index, %step0: index) -> (vector<16xi1>) {
  %lo = index.assume %lo0 [range(%lo0, 0, 752)] : index
  %hi = index.assume %hi0 [range(%hi0, 768, 1024)] : index
  %step = index.assume %step0 [range(%step0, 0, 1)] : index
  %r = vector.mask.range [%lo to %hi step %step] : index -> vector<16xi1>
  func.return %r : vector<16xi1>
}
// ----
func.def @mask_range_bounded_all_true(%lo0: index, %hi0: index, %step0: index) -> (vector<16xi1>) {
  %r = vector.constant true : vector<16xi1>
  func.return %r : vector<16xi1>
}

// ====

// A non-positive step makes lane zero the maximum lane value.
func.def @mask_range_bounded_all_true_negative_step(%lo0: index, %hi0: index, %step0: index) -> (vector<16xi1>) {
  %lo = index.assume %lo0 [range(%lo0, 0, 4)] : index
  %hi = index.assume %hi0 [range(%hi0, 5, 8)] : index
  %step = index.assume %step0 [range(%step0, -8, -1)] : index
  %r = vector.mask.range [%lo to %hi step %step] : index -> vector<16xi1>
  func.return %r : vector<16xi1>
}
// ----
func.def @mask_range_bounded_all_true_negative_step(%lo0: index, %hi0: index, %step0: index) -> (vector<16xi1>) {
  %r = vector.constant true : vector<16xi1>
  func.return %r : vector<16xi1>
}

// ====

// A non-negative step makes lane zero the minimum lane value. Equality with
// the exclusive upper bound is false.
func.def @mask_range_bounded_all_false_positive_step(%lo0: index, %hi0: index, %step0: index) -> (vector<16xi1>) {
  %lo = index.assume %lo0 [range(%lo0, 8, 16)] : index
  %hi = index.assume %hi0 [range(%hi0, 0, 8)] : index
  %step = index.assume %step0 [range(%step0, 1, 8)] : index
  %r = vector.mask.range [%lo to %hi step %step] : index -> vector<16xi1>
  func.return %r : vector<16xi1>
}
// ----
func.def @mask_range_bounded_all_false_positive_step(%lo0: index, %hi0: index, %step0: index) -> (vector<16xi1>) {
  %r = vector.constant false : vector<16xi1>
  func.return %r : vector<16xi1>
}

// ====

// The minimum lane accounts for a negative step when proving an all-false
// bounded mask.
func.def @mask_range_bounded_all_false_negative_step(%lo0: index, %hi0: index, %step0: index) -> (vector<16xi1>) {
  %lo = index.assume %lo0 [range(%lo0, 768, 1024)] : index
  %hi = index.assume %hi0 [range(%hi0, 0, 512)] : index
  %step = index.assume %step0 [range(%step0, -8, -1)] : index
  %r = vector.mask.range [%lo to %hi step %step] : index -> vector<16xi1>
  func.return %r : vector<16xi1>
}
// ----
func.def @mask_range_bounded_all_false_negative_step(%lo0: index, %hi0: index, %step0: index) -> (vector<16xi1>) {
  %r = vector.constant false : vector<16xi1>
  func.return %r : vector<16xi1>
}

// ====

// Ranges that can cross the exclusive upper bound remain structural masks.
func.def @mask_range_bounded_partial_negative_step(%lo0: index, %hi0: index, %step0: index) -> (vector<2xi1>) {
  %lo = index.assume %lo0 [range(%lo0, 4, 10)] : index
  %hi = index.assume %hi0 [range(%hi0, 5, 5)] : index
  %step = index.assume %step0 [range(%step0, -10, -1)] : index
  %r = vector.mask.range [%lo to %hi step %step] : index -> vector<2xi1>
  func.return %r : vector<2xi1>
}
// ----
func.def @mask_range_bounded_partial_negative_step(%lo0: index, %hi0: index, %step0: index) -> (vector<2xi1>) {
  %lo = index.assume %lo0 [range(%lo0, 4, 10)] : index
  %hi = index.constant 5 : index
  %step = index.assume %step0 [range(%step0, -10, -1)] : index
  %r = vector.mask.range [%lo to %hi step %step] : index -> vector<2xi1>
  func.return %r : vector<2xi1>
}

// ====

// A positive-step range that may reach the exclusive bound remains structural.
func.def @mask_range_bounded_partial_positive_step(%lo0: index, %hi0: index, %step0: index) -> (vector<16xi1>) {
  %lo = index.assume %lo0 [range(%lo0, 0, 1)] : index
  %hi = index.assume %hi0 [range(%hi0, 16, 16)] : index
  %step = index.assume %step0 [range(%step0, 1, 1)] : index
  %r = vector.mask.range [%lo to %hi step %step] : index -> vector<16xi1>
  func.return %r : vector<16xi1>
}
// ----
func.def @mask_range_bounded_partial_positive_step(%lo0: index, %hi0: index, %step0: index) -> (vector<16xi1>) {
  %lo = index.assume %lo0 [range(%lo0, 0, 1)] : index
  %hi = index.constant 16 : index
  %step = index.constant 1 : index
  %r = vector.mask.range [%lo to %hi step %step] : index -> vector<16xi1>
  func.return %r : vector<16xi1>
}

// ====

// A negative step can make later lanes true even when lane 0 is false.
func.def @mask_range_negative_step_not_all_false() -> (vector<2xi1>) {
  %c10 = index.constant 10 : index
  %c5 = index.constant 5 : index
  %cn10 = index.constant -10 : index
  %r = vector.mask.range [%c10 to %c5 step %cn10] : index -> vector<2xi1>
  func.return %r : vector<2xi1>
}

// ====

// Reducing zero lanes observes no input lanes and returns the explicit init.
func.def @empty_reduce(%v: vector<0xf32>, %init: f32) -> (f32) {
  %r = vector.reduce<addf> %v, %init : vector<0xf32>, f32
  func.return %r : f32
}
// ----
func.def @empty_reduce(%v: vector<0xf32>, %init: f32) -> (f32) {
  func.return %init : f32
}

// ====

// Reducing every source axis is the scalar horizontal reduction form.
func.def @reduce_axes_all_axes_to_reduce(%v: vector<2x3xf32>, %init: f32) -> (f32) {
  %r = vector.reduce.axes<addf> %v, %init axes [0, 1] : vector<2x3xf32>, f32
  func.return %r : f32
}

// ----
func.def @reduce_axes_all_axes_to_reduce(%v: vector<2x3xf32>, %init: f32) -> (f32) {
  %r = vector.reduce<addf> %v, %init : vector<2x3xf32>, f32
  func.return %r : f32
}

// ====

// Contracted product-add spellings become an explicit fused multiply-add.
func.def @contracted_product_add_to_fmaf(%lhs: vector<4xf32>, %rhs: vector<4xf32>, %addend: vector<4xf32>) -> (vector<4xf32>) {
  %product = vector.mulf<reassoc|nnan|ninf|nsz|contract> %lhs, %rhs : vector<4xf32>
  %r = vector.addf<reassoc|nnan|ninf|nsz|contract> %product, %addend : vector<4xf32>
  func.return %r : vector<4xf32>
}
// ----
func.def @contracted_product_add_to_fmaf(%lhs: vector<4xf32>, %rhs: vector<4xf32>, %addend: vector<4xf32>) -> (vector<4xf32>) {
  %r = vector.fmaf<reassoc|nnan|ninf|nsz|contract> %lhs, %rhs, %addend : vector<4xf32>
  func.return %r : vector<4xf32>
}

// ====

// Addition is commutative, so the product can appear on either side.
func.def @contracted_reversed_product_add_to_fmaf(%lhs: vector<4xf32>, %rhs: vector<4xf32>, %addend: vector<4xf32>) -> (vector<4xf32>) {
  %product = vector.mulf<reassoc|nnan|ninf|nsz|contract> %lhs, %rhs : vector<4xf32>
  %r = vector.addf<reassoc|nnan|ninf|nsz|contract> %addend, %product : vector<4xf32>
  func.return %r : vector<4xf32>
}
// ----
func.def @contracted_reversed_product_add_to_fmaf(%lhs: vector<4xf32>, %rhs: vector<4xf32>, %addend: vector<4xf32>) -> (vector<4xf32>) {
  %r = vector.fmaf<reassoc|nnan|ninf|nsz|contract> %lhs, %rhs, %addend : vector<4xf32>
  func.return %r : vector<4xf32>
}

// ====

// Exact add keeps the separately rounded product and addition.
func.def @exact_product_add_stays_separate(%lhs: vector<4xf32>, %rhs: vector<4xf32>, %addend: vector<4xf32>) -> (vector<4xf32>) {
  %product = vector.mulf<reassoc|nnan|ninf|nsz|contract> %lhs, %rhs : vector<4xf32>
  %r = vector.addf<reassoc|nnan|ninf|nsz> %product, %addend : vector<4xf32>
  func.return %r : vector<4xf32>
}

// ====

// A shared product remains explicit instead of duplicating the multiply.
func.def @shared_product_add_stays_separate(%lhs: vector<4xf32>, %rhs: vector<4xf32>, %addend: vector<4xf32>) -> (vector<4xf32>, vector<4xf32>) {
  %product = vector.mulf<reassoc|nnan|ninf|nsz|contract> %lhs, %rhs : vector<4xf32>
  %r = vector.addf<reassoc|nnan|ninf|nsz|contract> %product, %addend : vector<4xf32>
  func.return %product, %r : vector<4xf32>, vector<4xf32>
}

// ====

// Dotting zero lanes observes no vector lanes and returns the explicit init.
func.def @empty_dotf(%lhs: vector<0xf32>, %rhs: vector<0xf32>, %init: f32) -> (f32) {
  %r = vector.dotf %lhs, %rhs, %init : vector<0xf32>, vector<0xf32>, f32
  func.return %r : f32
}
// ----
func.def @empty_dotf(%lhs: vector<0xf32>, %rhs: vector<0xf32>, %init: f32) -> (f32) {
  func.return %init : f32
}

// ====

// Contracted product reductions are the source spelling of a dot contraction.
func.def @contracted_product_reduce_to_dotf(%lhs: vector<4xf32>, %rhs: vector<4xf32>, %init: f32) -> (f32) {
  %product = vector.mulf<reassoc|nnan|ninf|nsz|contract> %lhs, %rhs : vector<4xf32>
  %r = vector.reduce<addf, reassoc|nnan|ninf|nsz|contract> %product, %init : vector<4xf32>, f32
  func.return %r : f32
}
// ----
func.def @contracted_product_reduce_to_dotf(%lhs: vector<4xf32>, %rhs: vector<4xf32>, %init: f32) -> (f32) {
  %r = vector.dotf<reassoc|nnan|ninf|nsz|contract> %lhs, %rhs, %init : vector<4xf32>, vector<4xf32>, f32
  func.return %r : f32
}

// ====

// Exact product reductions keep their separately rounded product and add ops.
func.def @exact_product_reduce_stays_separate(%lhs: vector<4xf32>, %rhs: vector<4xf32>, %init: f32) -> (f32) {
  %product = vector.mulf %lhs, %rhs : vector<4xf32>
  %r = vector.reduce<addf> %product, %init : vector<4xf32>, f32
  func.return %r : f32
}

// ====

// Extracting a scalar from a statically empty axis observes an impossible lane,
// but a dead observation folds away before it reaches a poison boundary.
func.def @extract_from_empty_axis(%v: vector<0xf32>) {
  %r = vector.extract %v[0] : vector<0xf32> -> f32
  func.return
}
// ----
func.def @extract_from_empty_axis(%v: vector<0xf32>) {
  func.return
}

// ====

// A zero-lane load has no memory footprint and returns vector.empty.
func.def @empty_load(%buffer: buffer, %offset: offset) -> (vector<0xf32>) {
  %layout = encoding.layout.dense : encoding<layout>
  %view = buffer.view %buffer[%offset] : buffer -> view<16xf32, %layout>
  %r = vector.load %view[0] : view<16xf32, %layout> -> vector<0xf32>
  func.return %r : vector<0xf32>
}
// ----
func.def @empty_load(%buffer: buffer, %offset: offset) -> (vector<0xf32>) {
  %r = vector.empty : vector<0xf32>
  func.return %r : vector<0xf32>
}

// ====

// A zero-lane store has no memory footprint and erases completely.
func.def @empty_store(%buffer: buffer, %offset: offset) {
  %layout = encoding.layout.dense : encoding<layout>
  %view = buffer.view %buffer[%offset] : buffer -> view<16xf32, %layout>
  %v = vector.empty : vector<0xf32>
  vector.store %v, %view[0] : vector<0xf32>, view<16xf32, %layout>
  func.return
}
// ----
func.def @empty_store(%buffer: buffer, %offset: offset) {
  func.return
}

// ====

// Zero-lane masked loads also have no footprint; their result is empty
// regardless of inactive-lane passthrough.
func.def @empty_load_mask(%buffer: buffer, %offset: offset) -> (vector<0xf32>) {
  %layout = encoding.layout.dense : encoding<layout>
  %view = buffer.view %buffer[%offset] : buffer -> view<16xf32, %layout>
  %mask = vector.empty : vector<0xi1>
  %old = vector.empty : vector<0xf32>
  %r = vector.load.mask %view[0], %mask, %old : view<16xf32, %layout>, vector<0xi1>, vector<0xf32>
  func.return %r : vector<0xf32>
}
// ----
func.def @empty_load_mask(%buffer: buffer, %offset: offset) -> (vector<0xf32>) {
  %r = vector.empty : vector<0xf32>
  func.return %r : vector<0xf32>
}

// ====

// Zero-lane scatters erase completely even though the address form carries
// per-lane offsets.
func.def @empty_scatter(%buffer: buffer, %offset: offset) {
  %layout = encoding.layout.dense : encoding<layout>
  %view = buffer.view %buffer[%offset] : buffer -> view<16xf32, %layout>
  %offsets = vector.empty : vector<0xindex>
  %value = vector.empty : vector<0xf32>
  vector.scatter %value, %view[0][%offsets] : vector<0xf32>, view<16xf32, %layout>, vector<0xindex>
  func.return
}
// ----
func.def @empty_scatter(%buffer: buffer, %offset: offset) {
  func.return
}

// ====

// Zero-lane atomic RMWs produce the unique empty result and no memory update.
func.def @empty_atomic_rmw(%buffer: buffer, %offset: offset) -> (vector<0xi32>) {
  %layout = encoding.layout.dense : encoding<layout>
  %view = buffer.view %buffer[%offset] : buffer -> view<16xi32, %layout>
