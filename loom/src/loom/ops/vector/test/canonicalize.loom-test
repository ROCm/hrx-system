  %expected = vector.empty : vector<0xi32>
  %replacement = vector.empty : vector<0xi32>
  %r = vector.atomic.cmpxchg %expected, %replacement, %view[0][%offsets] {failure_ordering = relaxed, scope = workgroup, success_ordering = relaxed} : vector<0xi32>, view<16xi32, %layout>, vector<0xindex> -> vector<0xi32>
  func.return %r : vector<0xi32>
}
// ----
func.def @empty_atomic_cmpxchg(%buffer: buffer, %offset: offset) -> (vector<0xi32>) {
