// ====

// A bounded full range removes the masked-memory operation, not just the
// standalone mask producer.
func.def @store_mask_bounded_full_range_to_store(%buffer: buffer, %offset: offset, %value: vector<16xf32>, %lo0: index, %hi0: index, %step0: index) {
  %layout = encoding.layout.dense : encoding<layout>
  %view = buffer.view %buffer[%offset] : buffer -> view<1024xf32, %layout>
  %lo = index.assume %lo0 [range(%lo0, 0, 752)] : index
  %hi = index.assume %hi0 [range(%hi0, 768, 1024)] : index
  %step = index.assume %step0 [range(%step0, 0, 1)] : index
  %mask = vector.mask.range [%lo to %hi step %step] : index -> vector<16xi1>
  vector.store.mask %value, %view[%lo], %mask : vector<16xf32>, view<1024xf32, %layout>, vector<16xi1>
  func.return
}
// ----
func.def @store_mask_bounded_full_range_to_store(%buffer: buffer, %offset: offset, %value: vector<16xf32>, %lo0: index, %hi0: index, %step0: index) {
  %layout = encoding.layout.dense : encoding<layout>
  %view = buffer.view %buffer[%offset] : buffer -> view<1024xf32, %layout>
  %lo = index.assume %lo0 [range(%lo0, 0, 752)] : index
  vector.store %value, %view[%lo] : vector<16xf32>, view<1024xf32, %layout>
  func.return
}

