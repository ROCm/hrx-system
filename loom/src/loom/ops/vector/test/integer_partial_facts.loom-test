// RUN: pass canonicalize

// Vector integer facts use the element width when interpreting unsigned
// operands. Each unknown i8 lane modulo nine is in [0, 8].
func.def @remui_unknown_lanes_use_element_width(%values: vector<4xi8>) -> (i64, i64) {
  %divisors = vector.constant 9 : vector<4xi8>
  %remainders = vector.remui %values, %divisors : vector<4xi8>
  %lane = vector.extract %remainders[0] : vector<4xi8> -> i8
  %minimum = test.fact_range_lo %lane : i8 -> i64
  %maximum = test.fact_range_hi %lane : i8 -> i64
  func.return %minimum, %maximum : i64, i64
}

// ----
func.def @remui_unknown_lanes_use_element_width(%values: vector<4xi8>) -> (i64, i64) {
  %minimum = scalar.constant 0 : i64
  %maximum = scalar.constant 8 : i64
  func.return %minimum, %maximum : i64, i64
}

// ====

// One mask bounds every unknown lane without enumerating a large vector or
// claiming that the runtime lane values are equal.
func.def @uniform_mask(%input: vector<32xi8>) -> (i64, i64, i1) {
  %mask = vector.constant 15 : vector<32xi8>
  %masked = vector.andi %input, %mask : vector<32xi8>
  %lo = test.fact_all_equal_range_lo %masked : vector<32xi8> -> i64
  %hi = test.fact_all_equal_range_hi %masked : vector<32xi8> -> i64
  %uniform = test.fact_subgroup_uniform %masked : vector<32xi8> -> i1
  func.return %lo, %hi, %uniform : i64, i64, i1
}
// ----
func.def @uniform_mask(%input: vector<32xi8>) -> (i64, i64, i1) {
  %lo = scalar.constant 0 : i64
  %hi = scalar.constant 15 : i64
  %uniform = scalar.constant false : i1
  func.return %lo, %hi, %uniform : i64, i64, i1
}

// ====

func.def @commuted_uniform_mask(%input: vector<32xi8>) -> (i64, i64) {
  %mask = vector.constant 15 : vector<32xi8>
  %masked = vector.andi %mask, %input : vector<32xi8>
  %lo = test.fact_all_equal_range_lo %masked : vector<32xi8> -> i64
  %hi = test.fact_all_equal_range_hi %masked : vector<32xi8> -> i64
  func.return %lo, %hi : i64, i64
}
// ----
func.def @commuted_uniform_mask(%input: vector<32xi8>) -> (i64, i64) {
  %lo = scalar.constant 0 : i64
  %hi = scalar.constant 15 : i64
  func.return %lo, %hi : i64, i64
}

// ====

// A runtime mask with a retained bound works without an exact mask value.
func.def @bounded_mask(%input: vector<4xi8>, %mask: i8) -> (i64, i64) {
  %limit = scalar.constant 15 : i8
  %bounded = scalar.andi %mask, %limit : i8
  %masks = vector.splat %bounded : vector<4xi8>
  %masked = vector.andi %input, %masks : vector<4xi8>
  %lo = test.fact_all_equal_range_lo %masked : vector<4xi8> -> i64
  %hi = test.fact_all_equal_range_hi %masked : vector<4xi8> -> i64
  func.return %lo, %hi : i64, i64
}
// ----
func.def @bounded_mask(%input: vector<4xi8>, %mask: i8) -> (i64, i64) {
  %lo = scalar.constant 0 : i64
  %hi = scalar.constant 15 : i64
  func.return %lo, %hi : i64, i64
}

// ====

// Independent lane masks retain independent bounds in both operand orders.
func.def @lane_masks(%input: vector<4xi8>) -> (i64, i64, i64, i64) {
  %c1 = scalar.constant 1 : i8
  %c15 = scalar.constant 15 : i8
  %c63 = scalar.constant 63 : i8
  %c0 = scalar.constant 0 : i8
  %masks = vector.from_elements %c1, %c15, %c63, %c0 : vector<4xi8>
  %masked = vector.andi %input, %masks : vector<4xi8>
  %commuted = vector.andi %masks, %input : vector<4xi8>
  %lane0 = vector.extract %masked[0] : vector<4xi8> -> i8
  %lane1 = vector.extract %commuted[1] : vector<4xi8> -> i8
  %lane2 = vector.extract %masked[2] : vector<4xi8> -> i8
  %lane3 = vector.extract %commuted[3] : vector<4xi8> -> i8
  %hi0 = test.fact_range_hi %lane0 : i8 -> i64
  %hi1 = test.fact_range_hi %lane1 : i8 -> i64
  %hi2 = test.fact_range_hi %lane2 : i8 -> i64
  %hi3 = test.fact_range_hi %lane3 : i8 -> i64
  func.return %hi0, %hi1, %hi2, %hi3 : i64, i64, i64, i64
}
// ----
func.def @lane_masks(%input: vector<4xi8>) -> (i64, i64, i64, i64) {
  %hi0 = scalar.constant 1 : i64
  %hi1 = scalar.constant 15 : i64
  %hi2 = scalar.constant 63 : i64
  %hi3 = scalar.constant 0 : i64
  func.return %hi0, %hi1, %hi2, %hi3 : i64, i64, i64, i64
}

// ====

// Large vectors carry the shared OR bound without enumerating their lanes or
// claiming that the runtime values are equal across invocations.
func.def @uniform_bitwise_bounds(%low: vector<32xi32>, %high: vector<32xi32>) -> (i64, i64, i1) {
  %low_mask = vector.constant 255 : vector<32xi32>
  %high_mask = vector.constant 256 : vector<32xi32>
  %low_bits = vector.andi %low, %low_mask : vector<32xi32>
  %high_bits = vector.andi %high, %high_mask : vector<32xi32>
  %codes = vector.ori %low_bits, %high_bits : vector<32xi32>
  %lo = test.fact_all_equal_range_lo %codes : vector<32xi32> -> i64
  %hi = test.fact_all_equal_range_hi %codes : vector<32xi32> -> i64
  %uniform = test.fact_subgroup_uniform %codes : vector<32xi32> -> i1
  func.return %lo, %hi, %uniform : i64, i64, i1
}
// ----
func.def @uniform_bitwise_bounds(%low: vector<32xi32>, %high: vector<32xi32>) -> (i64, i64, i1) {
  %lo = scalar.constant 0 : i64
  %hi = scalar.constant 511 : i64
  %uniform = scalar.constant false : i1
  func.return %lo, %hi, %uniform : i64, i64, i1
}

// ====

// Per-lane OR facts survive extraction and reduction with different high bits.
func.def @independent_bitwise_bounds(%low: vector<4xi32>, %high: vector<4xi32>) -> (i64, i64, i64, i64, i64) {
  %low_mask = vector.constant 7 : vector<4xi32>
  %low_bits = vector.andi %low, %low_mask : vector<4xi32>
  %c8 = scalar.constant 8 : i32
  %c128 = scalar.constant 128 : i32
  %c256 = scalar.constant 256 : i32
  %c0 = scalar.constant 0 : i32
  %high_masks = vector.from_elements %c8, %c128, %c256, %c0 : vector<4xi32>
  %high_bits = vector.andi %high, %high_masks : vector<4xi32>
  %codes = vector.ori %high_bits, %low_bits : vector<4xi32>
  %lane0 = vector.extract %codes[0] : vector<4xi32> -> i32
  %lane1 = vector.extract %codes[1] : vector<4xi32> -> i32
  %lane2 = vector.extract %codes[2] : vector<4xi32> -> i32
  %lane3 = vector.extract %codes[3] : vector<4xi32> -> i32
  %reduced = vector.reduce<ori> %codes, %c0 : vector<4xi32>, i32
  %hi0 = test.fact_range_hi %lane0 : i32 -> i64
  %hi1 = test.fact_range_hi %lane1 : i32 -> i64
  %hi2 = test.fact_range_hi %lane2 : i32 -> i64
  %hi3 = test.fact_range_hi %lane3 : i32 -> i64
  %reduced_hi = test.fact_range_hi %reduced : i32 -> i64
  func.return %hi0, %hi1, %hi2, %hi3, %reduced_hi : i64, i64, i64, i64, i64
}
// ----
func.def @independent_bitwise_bounds(%low: vector<4xi32>, %high: vector<4xi32>) -> (i64, i64, i64, i64, i64) {
  %hi0 = scalar.constant 15 : i64
  %hi1 = scalar.constant 255 : i64
  %hi2 = scalar.constant 511 : i64
  %hi3 = scalar.constant 7 : i64
  %reduced_hi = scalar.constant 511 : i64
  func.return %hi0, %hi1, %hi2, %hi3, %reduced_hi : i64, i64, i64, i64, i64
}

// ====

// Unknown inputs and transfers that cannot derive a bound remain unknown.
func.def @unknown_results(%lhs: vector<4xi8>, %rhs: vector<4xi8>) -> (i64, i64, i64, i64) {
  %masked = vector.andi %lhs, %rhs : vector<4xi8>
  %increment = vector.constant 15 : vector<4xi8>
  %added = vector.addi %lhs, %increment : vector<4xi8>
  %masked_lo = test.fact_all_equal_range_lo %masked : vector<4xi8> -> i64
  %masked_hi = test.fact_all_equal_range_hi %masked : vector<4xi8> -> i64
  %added_lo = test.fact_all_equal_range_lo %added : vector<4xi8> -> i64
  %added_hi = test.fact_all_equal_range_hi %added : vector<4xi8> -> i64
  func.return %masked_lo, %masked_hi, %added_lo, %added_hi : i64, i64, i64, i64
}
// ----
func.def @unknown_results(%lhs: vector<4xi8>, %rhs: vector<4xi8>) -> (i64, i64, i64, i64) {
  %masked_lo = scalar.constant -9223372036854775808 : i64
  %masked_hi = scalar.constant -9223372036854775808 : i64
  %added_lo = scalar.constant -9223372036854775808 : i64
  %added_hi = scalar.constant -9223372036854775808 : i64
  func.return %masked_lo, %masked_hi, %added_lo, %added_hi : i64, i64, i64, i64
}

// ====

// Logical shifts clear the element sign bit even without source lane facts.
func.def @uniform_logical_shift(%input: vector<32xi8>) -> (i64, i64, i1) {
  %amount = vector.constant 4 : vector<32xi8>
  %shifted = vector.shrui %input, %amount : vector<32xi8>
  %lo = test.fact_all_equal_range_lo %shifted : vector<32xi8> -> i64
  %hi = test.fact_all_equal_range_hi %shifted : vector<32xi8> -> i64
  %uniform = test.fact_subgroup_uniform %shifted : vector<32xi8> -> i1
  func.return %lo, %hi, %uniform : i64, i64, i1
}
// ----
func.def @uniform_logical_shift(%input: vector<32xi8>) -> (i64, i64, i1) {
  %lo = scalar.constant 0 : i64
  %hi = scalar.constant 15 : i64
  %uniform = scalar.constant false : i1
  func.return %lo, %hi, %uniform : i64, i64, i1
}

// ====

// Each lane retains its own width-derived bound.
func.def @independent_logical_shifts(%input: vector<4xi8>) -> (i64, i64, i64, i64) {
  %c0 = scalar.constant 0 : i8
  %c1 = scalar.constant 1 : i8
  %c4 = scalar.constant 4 : i8
  %c7 = scalar.constant 7 : i8
  %amounts = vector.from_elements %c0, %c1, %c4, %c7 : vector<4xi8>
  %shifted = vector.shrui %input, %amounts : vector<4xi8>
  %lane0 = vector.extract %shifted[0] : vector<4xi8> -> i8
  %lane1 = vector.extract %shifted[1] : vector<4xi8> -> i8
  %lane2 = vector.extract %shifted[2] : vector<4xi8> -> i8
  %lane3 = vector.extract %shifted[3] : vector<4xi8> -> i8
  %lo0 = test.fact_range_lo %lane0 : i8 -> i64
  %hi1 = test.fact_range_hi %lane1 : i8 -> i64
  %hi2 = test.fact_range_hi %lane2 : i8 -> i64
  %hi3 = test.fact_range_hi %lane3 : i8 -> i64
  func.return %lo0, %hi1, %hi2, %hi3 : i64, i64, i64, i64
}
// ----
func.def @independent_logical_shifts(%input: vector<4xi8>) -> (i64, i64, i64, i64) {
  %lo0 = scalar.constant -128 : i64
  %hi1 = scalar.constant 127 : i64
  %hi2 = scalar.constant 15 : i64
  %hi3 = scalar.constant 1 : i64
  func.return %lo0, %hi1, %hi2, %hi3 : i64, i64, i64, i64
}

// ====

// Wrapping left shifts can set the sign bit in each narrow element.
func.def @left_shift_sign(%input: vector<4xi8>) -> (i1) {
  %mask = vector.constant 1 : vector<4xi8>
  %bits = vector.andi %input, %mask : vector<4xi8>
  %amount = vector.constant 7 : vector<4xi8>
  %shifted = vector.shli %bits, %amount : vector<4xi8>
  %element = vector.extract %shifted[0] : vector<4xi8> -> i8
  %nonnegative = test.fact_non_negative %element : i8 -> i1
  func.return %nonnegative : i1
}
// ----
func.def @left_shift_sign(%input: vector<4xi8>) -> (i1) {
  %nonnegative = scalar.constant false : i1
  func.return %nonnegative : i1
}

// ====

// Explicit signed-overflow semantics retain the mathematical result facts.
func.def @left_shift_nsw_sign(%input: vector<4xi8>) -> (i1) {
  %mask = vector.constant 1 : vector<4xi8>
  %bits = vector.andi %input, %mask : vector<4xi8>
  %amount = vector.constant 7 : vector<4xi8>
  %shifted = vector.shli<nsw> %bits, %amount : vector<4xi8>
  %element = vector.extract %shifted[0] : vector<4xi8> -> i8
  %nonnegative = test.fact_non_negative %element : i8 -> i1
  func.return %nonnegative : i1
}
// ----
func.def @left_shift_nsw_sign(%input: vector<4xi8>) -> (i1) {
  %nonnegative = scalar.constant true : i1
  func.return %nonnegative : i1
}
