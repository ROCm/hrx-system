func.def @interleave_partial_facts(%values: vector<2x2xi32>) -> (i32, i32) {
  %known = vector.constant 9 : vector<2x2xi32>
  %combined = vector.interleave<1> %values, %known : vector<2x2xi32>, vector<2x2xi32> -> vector<2x4xi32>
  %increment = vector.constant 1 : vector<2x4xi32>
  %shifted = vector.addi %combined, %increment : vector<2x4xi32>
  %static = vector.extract %shifted[1, 3] : vector<2x4xi32> -> i32
  %dynamic = vector.extract %shifted[0, 2] : vector<2x4xi32> -> i32
  func.return %static, %dynamic : i32, i32
}

