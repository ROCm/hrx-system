// RUN: pass canonicalize

func.def @insert_known_lane(%values: vector<4xi32>) -> (i32, i32) {
  %replacement = scalar.constant 9 : i32
  %combined = vector.insert %replacement into %values[2] : i32, vector<4xi32>
  %increment = vector.constant 1 : vector<4xi32>
  %shifted = vector.addi %combined, %increment : vector<4xi32>
  %static = vector.extract %shifted[2] : vector<4xi32> -> i32
  %dynamic = vector.extract %shifted[0] : vector<4xi32> -> i32
  func.return %static, %dynamic : i32, i32
}

