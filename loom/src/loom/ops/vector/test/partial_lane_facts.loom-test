  %values = vector.constant 9 : vector<2x2xi32>
  %combined = vector.insert %row into %values[1] : vector<2xi32>, vector<2x2xi32>
  %increment = vector.constant 1 : vector<2x2xi32>
  %shifted = vector.addi %combined, %increment : vector<2x2xi32>
