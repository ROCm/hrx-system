// RUN: pass canonicalize

func.def @byte_truth(%count: index, %input: vector<[%count]xi1>) -> (vector<[%count]xi1>) {
  %byte = vector.extui %input : vector<[%count]xi1> to vector<[%count]xi8>
  %c0_scalar = scalar.constant 0 : i8
  %c0 = vector.splat %c0_scalar : vector<[%count]xi8>
  %result = vector.cmpi ne, %byte, %c0 : vector<[%count]xi8> -> vector<[%count]xi1>
  func.return %result : vector<[%count]xi1>
}
// ----
func.def @byte_truth(%count: index, %input: vector<[%count]xi1>) -> (vector<[%count]xi1>) {
  func.return %input : vector<[%count]xi1>
}

// ====

func.def @halfword_false(%input: vector<4xi1>) -> (vector<4xi1>) {
  %halfword = vector.extui %input : vector<4xi1> to vector<4xi16>
  %c0_scalar = scalar.constant 0 : i16
  %c0 = vector.splat %c0_scalar : vector<4xi16>
  %result = vector.cmpi eq, %halfword, %c0 : vector<4xi16> -> vector<4xi1>
  func.return %result : vector<4xi1>
}
// ----
func.def @halfword_false(%input: vector<4xi1>) -> (vector<4xi1>) {
  %6 = scalar.constant true : i1
  %7 = vector.splat %6 : vector<4xi1>
  %result = vector.xori %input, %7 : vector<4xi1>
  func.return %result : vector<4xi1>
}

// ====

// Sign extension represents true as all bits set; its zero test is unchanged.
func.def @swapped_signed_truth(%input: vector<2x3xi1>) -> (vector<2x3xi1>) {
  %word = vector.extsi %input : vector<2x3xi1> to vector<2x3xi32>
  %c0_scalar = scalar.constant 0 : i32
  %c0 = vector.splat %c0_scalar : vector<2x3xi32>
  %result = vector.cmpi ne, %c0, %word : vector<2x3xi32> -> vector<2x3xi1>
  func.return %result : vector<2x3xi1>
}
// ----
func.def @swapped_signed_truth(%input: vector<2x3xi1>) -> (vector<2x3xi1>) {
  func.return %input : vector<2x3xi1>
}

// ====

func.def @swapped_signed_false(%input: vector<8xi1>) -> (vector<8xi1>) {
  %word = vector.extsi %input : vector<8xi1> to vector<8xi64>
  %c0_scalar = scalar.constant 0 : i64
  %c0 = vector.splat %c0_scalar : vector<8xi64>
  %result = vector.cmpi eq, %c0, %word : vector<8xi64> -> vector<8xi1>
  func.return %result : vector<8xi1>
}
// ----
func.def @swapped_signed_false(%input: vector<8xi1>) -> (vector<8xi1>) {
  %6 = scalar.constant true : i1
  %7 = vector.splat %6 : vector<8xi1>
  %result = vector.xori %input, %7 : vector<8xi1>
  func.return %result : vector<8xi1>
}

// ====

// Replacing the comparison preserves other users of the extended value.
func.def @retained_extension(%input: vector<4xi1>) -> (vector<4xi8>, vector<4xi1>) {
  %byte = vector.extsi %input : vector<4xi1> to vector<4xi8>
  %c0_scalar = scalar.constant 0 : i8
  %c0 = vector.splat %c0_scalar : vector<4xi8>
  %result = vector.cmpi ne, %byte, %c0 : vector<4xi8> -> vector<4xi1>
  func.return %byte, %result : vector<4xi8>, vector<4xi1>
}
// ----
func.def @retained_extension(%input: vector<4xi1>) -> (vector<4xi8>, vector<4xi1>) {
  %byte = vector.extsi %input : vector<4xi1> to vector<4xi8>
  func.return %byte, %input : vector<4xi8>, vector<4xi1>
}

// ====

// An extended byte still needs a comparison, including for even nonzero bytes.
func.def @integer_truth(%input: vector<4xi8>) -> (vector<4xi1>) {
  %word = vector.extui %input : vector<4xi8> to vector<4xi32>
  %c0_scalar = scalar.constant 0 : i32
  %c0 = vector.splat %c0_scalar : vector<4xi32>
  %result = vector.cmpi ne, %word, %c0 : vector<4xi32> -> vector<4xi1>
  func.return %result : vector<4xi1>
}
// ----
func.def @integer_truth(%input: vector<4xi8>) -> (vector<4xi1>) {
  %word = vector.extui %input : vector<4xi8> to vector<4xi32>
  %c0_scalar = scalar.constant 0 : i32
  %c0 = vector.splat %c0_scalar : vector<4xi32>
  %result = vector.cmpi ne, %word, %c0 : vector<4xi32> -> vector<4xi1>
  func.return %result : vector<4xi1>
}

// ====

// A runtime comparison operand cannot stand in for the proven zero.
func.def @dynamic_comparison(%input: vector<4xi1>, %other: vector<4xi8>) -> (vector<4xi1>) {
  %byte = vector.extui %input : vector<4xi1> to vector<4xi8>
  %result = vector.cmpi ne, %byte, %other : vector<4xi8> -> vector<4xi1>
  func.return %result : vector<4xi1>
}
// ----
func.def @dynamic_comparison(%input: vector<4xi1>, %other: vector<4xi8>) -> (vector<4xi1>) {
  %byte = vector.extui %input : vector<4xi1> to vector<4xi8>
  %result = vector.cmpi ne, %byte, %other : vector<4xi8> -> vector<4xi1>
  func.return %result : vector<4xi1>
}

// ====

// Uniform zero extension uses the input width, including when its sign bit
// is set. Dynamic extents retain the same per-element constant.
func.def @unsigned_constants(%count: index) -> (vector<[%count]xi8>, vector<4xi16>, vector<2x3xi32>, vector<8xi64>) {
  %flag_scalar = scalar.constant true : i1
  %flag = vector.splat %flag_scalar : vector<[%count]xi1>
  %byte_scalar = scalar.constant -1 : i8
  %byte = vector.splat %byte_scalar : vector<4xi8>
  %halfword_scalar = scalar.constant -1 : i16
  %halfword = vector.splat %halfword_scalar : vector<2x3xi16>
  %word_scalar = scalar.constant -1 : i32
  %word = vector.splat %word_scalar : vector<8xi32>
  %from_flag = vector.extui %flag : vector<[%count]xi1> to vector<[%count]xi8>
  %from_byte = vector.extui %byte : vector<4xi8> to vector<4xi16>
  %from_halfword = vector.extui %halfword : vector<2x3xi16> to vector<2x3xi32>
  %from_word = vector.extui %word : vector<8xi32> to vector<8xi64>
  func.return %from_flag, %from_byte, %from_halfword, %from_word : vector<[%count]xi8>, vector<4xi16>, vector<2x3xi32>, vector<8xi64>
}

// ----
func.def @unsigned_constants(%count: index) -> (vector<[%count]xi8>, vector<4xi16>, vector<2x3xi32>, vector<8xi64>) {
  %23 = scalar.constant 1 : i8
  %from_flag = vector.splat %23 : vector<[%count]xi8>
  %21 = scalar.constant 255 : i16
  %from_byte = vector.splat %21 : vector<4xi16>
  %19 = scalar.constant 65535 : i32
  %from_halfword = vector.splat %19 : vector<2x3xi32>
  %17 = scalar.constant 4294967295 : i64
  %from_word = vector.splat %17 : vector<8xi64>
  func.return %from_flag, %from_byte, %from_halfword, %from_word : vector<[%count]xi8>, vector<4xi16>, vector<2x3xi32>, vector<8xi64>
}
