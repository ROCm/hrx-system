// RUN: pass combine

// Importer-style scalar address casts are reconstructed as one shaped
// conversion before target legalization selects the physical carrier.
func.def @from_elements_of_index_casts(%values: vector<4xi32>) -> (vector<4xindex>) {
  %lane0 = vector.extract %values[0] : vector<4xi32> -> i32
  %index0 = index.cast %lane0 : i32 to index
  %lane1 = vector.extract %values[1] : vector<4xi32> -> i32
  %index1 = index.cast %lane1 : i32 to index
  %lane2 = vector.extract %values[2] : vector<4xi32> -> i32
  %index2 = index.cast %lane2 : i32 to index
  %lane3 = vector.extract %values[3] : vector<4xi32> -> i32
  %index3 = index.cast %lane3 : i32 to index
  %result = vector.from_elements %index0, %index1, %index2, %index3 : vector<4xindex>
  func.return %result : vector<4xindex>
}
// ----
func.def @from_elements_of_index_casts(%values: vector<4xi32>) -> (vector<4xindex>) {
  %result = vector.index_cast %values : vector<4xi32> to vector<4xindex>
  func.return %result : vector<4xindex>
}

// ====

// Scalar lane chains produced by importers fold back to the equivalent vector
// operations before target legalization chooses their physical representation.
func.def @from_elements_of_scalarized_quantizer_chain(%values: vector<4xf32>) -> (vector<4xi8>) {
  %lane0 = vector.extract %values[0] : vector<4xf32> -> f32
  %rounded0 = scalar.roundevenf %lane0 : f32
  %i32_0 = scalar.fptosi %rounded0 : f32 to i32
  %i8_0 = scalar.trunci %i32_0 : i32 to i8
  %lane1 = vector.extract %values[1] : vector<4xf32> -> f32
  %rounded1 = scalar.roundevenf %lane1 : f32
  %i32_1 = scalar.fptosi %rounded1 : f32 to i32
  %i8_1 = scalar.trunci %i32_1 : i32 to i8
  %lane2 = vector.extract %values[2] : vector<4xf32> -> f32
  %rounded2 = scalar.roundevenf %lane2 : f32
  %i32_2 = scalar.fptosi %rounded2 : f32 to i32
  %i8_2 = scalar.trunci %i32_2 : i32 to i8
  %lane3 = vector.extract %values[3] : vector<4xf32> -> f32
  %rounded3 = scalar.roundevenf %lane3 : f32
  %i32_3 = scalar.fptosi %rounded3 : f32 to i32
  %i8_3 = scalar.trunci %i32_3 : i32 to i8
  %packed = vector.from_elements %i8_0, %i8_1, %i8_2, %i8_3 : vector<4xi8>
  func.return %packed : vector<4xi8>
}
// ----
func.def @from_elements_of_scalarized_quantizer_chain(%values: vector<4xf32>) -> (vector<4xi8>) {
  %19 = vector.roundevenf %values : vector<4xf32>
  %20 = vector.fptosi %19 : vector<4xf32> to vector<4xi32>
  %packed = vector.trunci %20 : vector<4xi32> to vector<4xi8>
  func.return %packed : vector<4xi8>
}

// ====

// The same scalar integer conversion can feed a floating-point q-sum path and
// a packed-byte path. Source combination reconstructs both vector chains; CSE in
// the normal cleanup pipeline merges the duplicated vector.fptosi.
func.def @from_elements_of_scalarized_quantizer_dual_use(%values: vector<4xf32>) -> (vector<4xf32>, vector<4xi8>) {
  %lane0 = vector.extract %values[0] : vector<4xf32> -> f32
  %i32_0 = scalar.fptosi %lane0 : f32 to i32
  %f32_0 = scalar.sitofp %i32_0 : i32 to f32
  %i8_0 = scalar.trunci %i32_0 : i32 to i8
  %lane1 = vector.extract %values[1] : vector<4xf32> -> f32
  %i32_1 = scalar.fptosi %lane1 : f32 to i32
  %f32_1 = scalar.sitofp %i32_1 : i32 to f32
  %i8_1 = scalar.trunci %i32_1 : i32 to i8
  %lane2 = vector.extract %values[2] : vector<4xf32> -> f32
  %i32_2 = scalar.fptosi %lane2 : f32 to i32
  %f32_2 = scalar.sitofp %i32_2 : i32 to f32
  %i8_2 = scalar.trunci %i32_2 : i32 to i8
  %lane3 = vector.extract %values[3] : vector<4xf32> -> f32
  %i32_3 = scalar.fptosi %lane3 : f32 to i32
  %f32_3 = scalar.sitofp %i32_3 : i32 to f32
  %i8_3 = scalar.trunci %i32_3 : i32 to i8
  %q_f32 = vector.from_elements %f32_0, %f32_1, %f32_2, %f32_3 : vector<4xf32>
  %q_i8 = vector.from_elements %i8_0, %i8_1, %i8_2, %i8_3 : vector<4xi8>
  func.return %q_f32, %q_i8 : vector<4xf32>, vector<4xi8>
}
// ----
func.def @from_elements_of_scalarized_quantizer_dual_use(%values: vector<4xf32>) -> (vector<4xf32>, vector<4xi8>) {
  %23 = vector.fptosi %values : vector<4xf32> to vector<4xi32>
  %q_f32 = vector.sitofp %23 : vector<4xi32> to vector<4xf32>
  %21 = vector.fptosi %values : vector<4xf32> to vector<4xi32>
  %q_i8 = vector.trunci %21 : vector<4xi32> to vector<4xi8>
  func.return %q_f32, %q_i8 : vector<4xf32>, vector<4xi8>
}

// ====

// Reconstruction retains source lane order and per-lane numerical permissions.
func.def @different_rounding_permissions(%values: vector<2xf32>) -> (vector<2xf32>) {
  %left = vector.extract %values[0] : vector<2xf32> -> f32
  %right = vector.extract %values[1] : vector<2xf32> -> f32
  %rounded_left = scalar.roundevenf<nnan> %left : f32
  %rounded_right = scalar.roundevenf %right : f32
  %result = vector.from_elements %rounded_left, %rounded_right : vector<2xf32>
  func.return %result : vector<2xf32>
}

// ====

func.def @reordered_conversions(%values: vector<2xf32>) -> (vector<2xi32>) {
  %left = vector.extract %values[1] : vector<2xf32> -> f32
  %right = vector.extract %values[0] : vector<2xf32> -> f32
  %converted_left = scalar.fptosi %left : f32 to i32
  %converted_right = scalar.fptosi %right : f32 to i32
  %result = vector.from_elements %converted_left, %converted_right : vector<2xi32>
  func.return %result : vector<2xi32>
}

// ====

// A terminal chain that overwrites every lane no longer depends on its base.
// Writes may arrive out of lane order, and the outermost duplicate wins.
func.def @complete_insert_chain(%base: vector<4xi32>, %a: i32, %b: i32, %old_c: i32, %c: i32, %d: i32) -> (vector<4xi32>) {
  %with_old_c = vector.insert %old_c into %base[2] : i32, vector<4xi32>
  %with_a = vector.insert %a into %with_old_c[0] : i32, vector<4xi32>
  %with_d = vector.insert %d into %with_a[3] : i32, vector<4xi32>
  %with_c = vector.insert %c into %with_d[2] : i32, vector<4xi32>
  %result = vector.insert %b into %with_c[1] : i32, vector<4xi32>
  func.return %result : vector<4xi32>
}

// ----
func.def @complete_insert_chain(%base: vector<4xi32>, %a: i32, %b: i32, %old_c: i32, %c: i32, %d: i32) -> (vector<4xi32>) {
  %result = vector.from_elements %a, %b, %c, %d : vector<4xi32>
  func.return %result : vector<4xi32>
}

// ====

// Unwritten lanes retain the scalar value carried by a splat base.
func.def @insert_chain_over_splat(%fill: f32, %left: f32, %right: f32) -> (vector<4xf32>) {
  %base = vector.splat %fill : vector<4xf32>
  %with_right = vector.insert %right into %base[3] : f32, vector<4xf32>
  %result = vector.insert %left into %with_right[1] : f32, vector<4xf32>
  func.return %result : vector<4xf32>
}

// ----
func.def @insert_chain_over_splat(%fill: f32, %left: f32, %right: f32) -> (vector<4xf32>) {
  %result = vector.from_elements %fill, %left, %fill, %right : vector<4xf32>
  func.return %result : vector<4xf32>
}

// ====

// Unwritten lanes retain their distinct values from a from-elements base.
func.def @insert_chain_over_elements(%a: i16, %b: i16, %c: i16, %d: i16, %left: i16, %right: i16) -> (vector<4xi16>) {
  %base = vector.from_elements %a, %b, %c, %d : vector<4xi16>
  %with_right = vector.insert %right into %base[2] : i16, vector<4xi16>
  %result = vector.insert %left into %with_right[0] : i16, vector<4xi16>
  func.return %result : vector<4xi16>
}

// ----
func.def @insert_chain_over_elements(%a: i16, %b: i16, %c: i16, %d: i16, %left: i16, %right: i16) -> (vector<4xi16>) {
  %result = vector.from_elements %left, %b, %right, %d : vector<4xi16>
  func.return %result : vector<4xi16>
}

// ====

// A side use makes an intermediate construction material. Both it and the
// terminal construction are recovered without reopening scalar insert chains.
func.def @materialized_insert_prefix(%fill: i8, %a: i8, %b: i8, %c: i8) -> (vector<4xi8>, vector<4xi8>) {
  %base = vector.splat %fill : vector<4xi8>
  %with_a = vector.insert %a into %base[3] : i8, vector<4xi8>
  %prefix = vector.insert %b into %with_a[1] : i8, vector<4xi8>
  %result = vector.insert %c into %prefix[0] : i8, vector<4xi8>
  func.return %prefix, %result : vector<4xi8>, vector<4xi8>
}

// ----
func.def @materialized_insert_prefix(%fill: i8, %a: i8, %b: i8, %c: i8) -> (vector<4xi8>, vector<4xi8>) {
  %prefix = vector.from_elements %fill, %b, %fill, %a : vector<4xi8>
  %result = vector.from_elements %c, %b, %fill, %a : vector<4xi8>
  func.return %prefix, %result : vector<4xi8>, vector<4xi8>
}

// ====

// A partial update of an arbitrary base remains a mutation, not a constructor.
func.def @partial_arbitrary_base(%base: vector<4xi32>, %value: i32) -> (vector<4xi32>) {
  %result = vector.insert %value into %base[2] : i32, vector<4xi32>
  func.return %result : vector<4xi32>
}

// ====

// Dynamic lane selection remains a dynamic insertion.
func.def @dynamic_insert(%fill: i32, %value: i32, %lane: index) -> (vector<4xi32>) {
  %base = vector.splat %fill : vector<4xi32>
  %result = vector.insert %value into %base[%lane] : i32, vector<4xi32>
  func.return %result : vector<4xi32>
}

// ====

// Subvector insertion is a separate aggregate operation.
func.def @subvector_insert(%base: vector<2x2xi32>, %row: vector<2xi32>) -> (vector<2x2xi32>) {
  %result = vector.insert %row into %base[1] : vector<2xi32>, vector<2x2xi32>
  func.return %result : vector<2x2xi32>
}

// ====
// RUN: pass canonicalize

// Unequal extents expose the row-major stride when selecting scalar operands.
func.def @constructed_matrix_elements(%a: i16, %b: i16, %c: i16, %d: i16, %e: i16, %f: i16) -> (vector<2x3xi16>, i16, i16) {
  %matrix = vector.from_elements %a, %b, %c, %d, %e, %f : vector<2x3xi16>
  %identity = vector.extract %matrix[] : vector<2x3xi16> -> vector<2x3xi16>
  %upper = vector.extract %matrix[0, 2] : vector<2x3xi16> -> i16
  %lower = vector.extract %matrix[1, 0] : vector<2x3xi16> -> i16
  func.return %identity, %upper, %lower : vector<2x3xi16>, i16, i16
}

// ----
func.def @constructed_matrix_elements(%a: i16, %b: i16, %c: i16, %d: i16, %e: i16, %f: i16) -> (vector<2x3xi16>, i16, i16) {
  %matrix = vector.from_elements %a, %b, %c, %d, %e, %f : vector<2x3xi16>
  func.return %matrix, %c, %d : vector<2x3xi16>, i16, i16
}

// ====
// RUN: pass canonicalize

// Every static prefix selects original scalar operands without conversions.
func.def @constructed_prefixes(%a: bf16, %b: bf16, %c: bf16, %d: bf16, %e: bf16, %f: bf16, %g: bf16, %h: bf16) -> (vector<2x2xbf16>, vector<2xbf16>, bf16) {
  %cube = vector.from_elements %a, %b, %c, %d, %e, %f, %g, %h : vector<2x2x2xbf16>
  %plane = vector.extract %cube[1] : vector<2x2x2xbf16> -> vector<2x2xbf16>
  %row = vector.extract %cube[0, 1] : vector<2x2x2xbf16> -> vector<2xbf16>
  %scalar = vector.extract %cube[1, 0, 1] : vector<2x2x2xbf16> -> bf16
  func.return %plane, %row, %scalar : vector<2x2xbf16>, vector<2xbf16>, bf16
}

// ----
func.def @constructed_prefixes(%a: bf16, %b: bf16, %c: bf16, %d: bf16, %e: bf16, %f: bf16, %g: bf16, %h: bf16) -> (vector<2x2xbf16>, vector<2xbf16>, bf16) {
  %plane = vector.from_elements %e, %f, %g, %h : vector<2x2xbf16>
  %row = vector.from_elements %c, %d : vector<2xbf16>
  func.return %plane, %row, %f : vector<2x2xbf16>, vector<2xbf16>, bf16
}

// ====
// RUN: pass canonicalize

// A nonempty prefix may select an empty tail without reading any operand.
func.def @constructed_empty_tail() -> (vector<0xf32>) {
  %matrix = vector.from_elements : vector<2x0xf32>
  %row = vector.extract %matrix[1] : vector<2x0xf32> -> vector<0xf32>
  func.return %row : vector<0xf32>
}

// ----
func.def @constructed_empty_tail() -> (vector<0xf32>) {
  %row = vector.empty : vector<0xf32>
  func.return %row : vector<0xf32>
}

// ====
// RUN: pass canonicalize

// Unknown coordinates do not select a static subset of the scalar operands.
func.def @constructed_dynamic_prefix(%a: i32, %b: i32, %c: i32, %d: i32, %row: index) -> (i32) {
  %matrix = vector.from_elements %a, %b, %c, %d : vector<2x2xi32>
  %value = vector.extract %matrix[%row, 1] : vector<2x2xi32> -> i32
  func.return %value : i32
}

// ====
// RUN: pass canonicalize

// An empty prefix retains the original value, including dynamic extents.
func.def @identity_prefix(%extent: index, %value: vector<[%extent]x2xf32>) -> (vector<[%extent]x2xf32>) {
  %result = vector.extract %value[] : vector<[%extent]x2xf32> -> vector<[%extent]x2xf32>
  func.return %result : vector<[%extent]x2xf32>
}

// ----
func.def @identity_prefix(%extent: index, %value: vector<[%extent]x2xf32>) -> (vector<[%extent]x2xf32>) {
  func.return %value : vector<[%extent]x2xf32>
}
