func.def @rounding_vector_4xf16() -> (vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>) {
  %input = vector.splatf -0.5 : vector<4xf16>
  %ceil = vector.ceilf %input : vector<4xf16>
  %floor = vector.floorf %input : vector<4xf16>
  %trunc = vector.truncf %input : vector<4xf16>
  %roundeven = vector.roundevenf %input : vector<4xf16>
  %round = vector.roundf %input : vector<4xf16>
  func.return %ceil, %floor, %trunc, %roundeven, %round : vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>, vector<4xf16>
}

