  %cardinal_input = vector.splatf 4503599627370496.0 : vector<2xf64>
  %cardinal = vector.costurnsf %cardinal_input : vector<2xf64>
  func.return %large, %small, %pole, %narrow, %turns, %cardinal : vector<2xf64>, vector<2xf32>, vector<2xf64>, vector<2xf8E4M3>, vector<2xf64>, vector<2xf64>
}

