func.def @vector_exponential_difference() -> (vector<2xf16>, vector<2xf64>) {
  %small = vector.splatf 0.00390625 : vector<2xf16>
  %tiny = vector.splatf 4.9406564584124654e-324 : vector<2xf64>
  %narrow = vector.expm1f %small : vector<2xf16>
  %wide = vector.expm1f %tiny : vector<2xf64>
  func.return %narrow, %wide : vector<2xf16>, vector<2xf64>
}

