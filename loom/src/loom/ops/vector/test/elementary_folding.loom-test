// ====
func.def @vector_logarithms() -> (vector<2xf32>, vector<2xf64>, vector<2xf16>, vector<2xbf16>) {
  %a = vector.splatf 2.0 : vector<2xf32>
  %b = vector.splatf 4.9406564584124654e-324 : vector<2xf64>
  %c = vector.splatf 10.0 : vector<2xf16>
  %d = vector.splatf -0.00390625 : vector<2xbf16>
  %natural = vector.logf %a : vector<2xf32>
  %base_two = vector.log2f %b : vector<2xf64>
  %base_ten = vector.log10f %c : vector<2xf16>
  %increment = vector.log1pf %d : vector<2xbf16>
  func.return %natural, %base_two, %base_ten, %increment : vector<2xf32>, vector<2xf64>, vector<2xf16>, vector<2xbf16>
}

// ----
func.def @vector_logarithms() -> (vector<2xf32>, vector<2xf64>, vector<2xf16>, vector<2xbf16>) {
  %natural = vector.splatf 0.69314718246459961 : vector<2xf32>
  %base_two = vector.splatf -1074.0 : vector<2xf64>
  %base_ten = vector.splatf 1.0 : vector<2xf16>
  %increment = vector.splatf -0.00390625 : vector<2xbf16>
  func.return %natural, %base_two, %base_ten, %increment : vector<2xf32>, vector<2xf64>, vector<2xf16>, vector<2xbf16>
}

