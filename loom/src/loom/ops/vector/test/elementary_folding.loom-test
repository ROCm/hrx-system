func.def @vector_inverse_trigonometry() -> (vector<2xf32>, vector<2xf64>, vector<2xbf16>, vector<2xf8E5M2>) {
  %asin_input = vector.splatf 0.99999994039535522 : vector<2xf32>
  %asin_result = vector.asinf %asin_input : vector<2xf32>
  %acos_input = vector.splatf 0.99999999999999989 : vector<2xf64>
  %acos_result = vector.acosf %acos_input : vector<2xf64>
  %atan_input = vector.splatf -1.0 : vector<2xbf16>
  %atan_result = vector.atanf %atan_input : vector<2xbf16>
  %atan2_input = vector.splatf 0.5 : vector<2xf8E5M2>
  %negative_x = vector.splatf -0.5 : vector<2xf8E5M2>
  %atan2_result = vector.atan2f %atan2_input, %negative_x : vector<2xf8E5M2>
  func.return %asin_result, %acos_result, %atan_result, %atan2_result : vector<2xf32>, vector<2xf64>, vector<2xbf16>, vector<2xf8E5M2>
}

