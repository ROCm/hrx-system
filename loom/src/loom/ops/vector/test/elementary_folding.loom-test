func.def @vector_activation_tails_and_scale() -> (vector<2xf32>, vector<2xf32>, vector<2xf64>, vector<2xf64>, vector<2xf32>, vector<2xf16>) {
  %logistic_input = vector.splatf -100.0 : vector<2xf32>
  %logistic = vector.logisticf %logistic_input : vector<2xf32>
  %silu_input = vector.splatf -104.0 : vector<2xf32>
  %silu = vector.siluf %silu_input : vector<2xf32>
  %softplus_input = vector.splatf -744.0 : vector<2xf64>
  %softplus = vector.softplusf %softplus_input : vector<2xf64>
  %gelu_erf_input = vector.splatf -38.0 : vector<2xf64>
  %gelu_erf = vector.geluf<erf> %gelu_erf_input : vector<2xf64>
  %gelu_tanh_input = vector.splatf -8.0 : vector<2xf32>
  %gelu_tanh = vector.geluf<tanh> %gelu_tanh_input : vector<2xf32>
  %gelu_logistic_input = vector.splatf -5.0 : vector<2xf16>
  %gelu_logistic = vector.geluf<logistic> %gelu_logistic_input {scale = 1.702} : vector<2xf16>
  func.return %logistic, %silu, %softplus, %gelu_erf, %gelu_tanh, %gelu_logistic : vector<2xf32>, vector<2xf32>, vector<2xf64>, vector<2xf64>, vector<2xf32>, vector<2xf16>
}

// ----
func.def @vector_activation_tails_and_scale() -> (vector<2xf32>, vector<2xf32>, vector<2xf64>, vector<2xf64>, vector<2xf32>, vector<2xf16>) {
  %logistic = vector.splatf 3.7835058536770061e-44 : vector<2xf32>
  %silu = vector.splatf -7.1466221680565671e-44 : vector<2xf32>
  %softplus = vector.splatf 9.8813129168249309e-324 : vector<2xf64>
  %gelu_erf = vector.splatf -1.096462776839966e-314 : vector<2xf64>
  %gelu_tanh = vector.splatf -3.1077797614663798e-21 : vector<2xf32>
  %gelu_logistic = vector.splatf -0.001007080078125 : vector<2xf16>
  func.return %logistic, %silu, %softplus, %gelu_erf, %gelu_tanh, %gelu_logistic : vector<2xf32>, vector<2xf32>, vector<2xf64>, vector<2xf64>, vector<2xf32>, vector<2xf16>
}

