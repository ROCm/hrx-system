load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_test",
    "loom_generated_cc_library",
    "loom_generated_file_family",
)

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_generated_file_family(
    name = "scalarization_rows_gen",
    generator = "//loom/py/loom/gen/ops:c_vector_scalarization",
    output_flags = [
        "--cast-legalizer-rows",
        "--rows",
    ],
    outputs = [
        "cast_legalizer_rows.inl",
        "scalarization_rows.inl",
    ],
)

loom_generated_cc_library(
    name = "vector",
    srcs = [
        "canonicalize.c",
        "combining.c",
        "construction.c",
        "facts.c",
        "fragment.c",
        "interleave.c",
        "memory.c",
        "scalarization.c",
        "storage.c",
        "table.c",
        "transpose.c",
        "type_transfer.c",
        "verify.c",
    ],
    hdrs = [
        "combining.h",
        "construction.h",
        "fragment.h",
        "interleave.h",
        "memory.h",
        "ops.h",
        "scalarization.h",
        "storage.h",
        "table.h",
        "tables.h",
        "transpose.h",
    ],
    args = ["--dialect=vector"],
    extra_output_flags = ["--ops-include"],
    extra_outputs = ["ops.inc"],
    generated_src_flags = [
        "--builders",
        "--tables",
        "--table-shard=aggregate",
        "--table-shard=atomic",
        "--table-shard=bitpack",
        "--table-shard=cast",
        "--table-shard=compare",
        "--table-shard=construction",
        "--table-shard=contraction",
        "--table-shard=encoding",
        "--table-shard=float_arithmetic",
        "--table-shard=integer_arithmetic",
        "--table-shard=math",
        "--table-shard=memory",
        "--table-shard=reduction",
        "--table-shard=table",
    ],
    generated_srcs = [
        "builders.c",
        "tables.c",
        "tables/aggregate.c",
        "tables/atomic.c",
        "tables/bitpack.c",
        "tables/cast.c",
        "tables/compare.c",
        "tables/construction.c",
        "tables/contraction.c",
        "tables/encoding.c",
        "tables/float_arithmetic.c",
        "tables/integer_arithmetic.c",
        "tables/math.c",
        "tables/memory.c",
        "tables/reduction.c",
        "tables/table.c",
    ],
    generator = "//loom/py/loom/gen/ops:c_tables_vector_generator",
    textual_hdrs = [
        ":cast_legalizer_rows.inl",
        "ops.inc",
        ":scalarization_rows.inl",
    ],
    deps = [
        "//loom/src/loom/error:emitter",
        "//loom/src/loom/error:error_defs",
        "//loom/src/loom/ir",
        "//loom/src/loom/ir:facts",
        "//loom/src/loom/ops:atomic",
        "//loom/src/loom/ops:cache",
        "//loom/src/loom/ops:combining",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/ops/encoding",
        "//loom/src/loom/ops/index",
        "//loom/src/loom/ops/index:cast",
        "//loom/src/loom/ops/scalar",
        "//loom/src/loom/ops/scf",
        "//loom/src/loom/ops/view",
        "//loom/src/loom/rewrite:rewriter",
        "//loom/src/loom/rewrite:type_propagation",
        "//loom/src/loom/util:fact_table",
        "//loom/src/loom/util:numeric_format",
        "//loom/src/loom/util:stable_id",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal",
    ],
)

loom_cc_test(
    name = "fragment_test",
    srcs = ["fragment_test.cc"],
    deps = [
        ":vector",
        "//loom/src/loom/ir",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_test(
    name = "interleave_test",
    srcs = ["interleave_test.cc"],
    deps = [
        ":vector",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_test(
    name = "memory_test",
    srcs = ["memory_test.cc"],
    deps = [
        ":vector",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/ops/encoding",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_test(
    name = "storage_test",
    srcs = ["storage_test.cc"],
    deps = [
        ":vector",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
