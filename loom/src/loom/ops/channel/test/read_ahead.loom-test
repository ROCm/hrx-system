^_bb18:
  %130 = index.assume %128 [range(%128, 0, 9223372036854775806), ge(%128, %109), lt(%128, %length)] : index
  %value$124 = view.load %payload[%130] : view<64xf32> -> f32
  %next$125 = scalar.addf %129, %value$124 : f32
  %132 = index.add %130, %step : index
  cfg.br ^_bb17(%132: index, %next$125: f32)
^_bb19:
