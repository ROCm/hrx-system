func.def @sum_stream(%source: channel<tile<64xf32>>, %staging: channel<tile<64xf32>>, %count: index, %length: index) -> (f32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %identity = scalar.constant 0.0 : f32
  %has_records = index.cmp sgt, %count, %begin : index
  cfg.cond_br %has_records, ^_bb1, ^_bb6
^_bb1:
  %first_source = channel.accept %source : channel<tile<64xf32>> -> read<tile<64xf32>>
  %first_write, %first_storage = channel.reserve %staging : channel<tile<64xf32>> -> (write<tile<64xf32>>, view<64xf32>)
  channel.copy %first_source -> %first_write : read<tile<64xf32>>, write<tile<64xf32>>
  %first = channel.accept %staging : channel<tile<64xf32>> -> read<tile<64xf32>>
  cfg.br ^_bb2(%step: index, %first: read<tile<64xf32>>, %identity: f32)
^_bb2(%164: index, %current: read<tile<64xf32>>, %partial: f32):
  %168 = index.cmp slt, %164, %count : index
  cfg.cond_br %168, ^_bb3, ^_bb4
^_bb3:
  %record = index.assume %164 [range(%164, 1, 9223372036854775806), lt(%164, %count)] : index
  %next_source = channel.accept %source : channel<tile<64xf32>> -> read<tile<64xf32>>
  %next_write, %next_storage = channel.reserve %staging : channel<tile<64xf32>> -> (write<tile<64xf32>>, view<64xf32>)
  channel.copy %next_source -> %next_write : read<tile<64xf32>>, write<tile<64xf32>>
  %next = channel.accept %staging : channel<tile<64xf32>> -> read<tile<64xf32>>
  %next_sum = func.call @sum_record(%current, %length, %partial) : (read<tile<64xf32>>, index, f32) -> (f32)
  %169 = index.add %record, %step : index
  cfg.br ^_bb2(%169: index, %next: read<tile<64xf32>>, %next_sum: f32)
^_bb4:
  cfg.br ^_bb5(%current: read<tile<64xf32>>, %partial: f32)
^_bb5(%last: read<tile<64xf32>>, %sum: f32):
  %finished = func.call @sum_record(%last, %length, %sum) : (read<tile<64xf32>>, index, f32) -> (f32)
  cfg.br ^_bb7(%finished: f32)
^_bb6:
  cfg.br ^_bb7(%identity: f32)
^_bb7(%result: f32):
  func.return %result : f32
}

// ====

// RUN: pass pipeline-scf-for

// Advancing ordinary reads does not authorize advancing channel admission or
// retirement. An explicit outer transfer schedule keeps those obligations out
// of the scalar read-ahead loop, as in sum_stream above.
func.def @rejects_implicit_admission(%source: channel<tile<64xf32>>, %initial: f32) -> (f32) {
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %depth = index.constant 2 : index
  %sum = scf.for %record = [%begin to %end step %step](%partial = %initial : f32) -> (f32) pipeline(%depth) {
    // ERROR@+1: STRUCTURE/014 {expected_constraint="workgroup-only stores and barriers in the ordered consumer"}
    %read, %payload = channel.acquire %source : channel<tile<64xf32>> -> (read<tile<64xf32>>, view<64xf32>)
    %value = view.load %payload[0] : view<64xf32> -> f32
    %next = scalar.addf %partial, %value : f32
    channel.release %read : read<tile<64xf32>>
    scf.yield %next : f32
  }
  func.return %sum : f32
}
