func.def @sum_record(%read: read<tile<64xf32>>, %length: index, %initial: f32) -> (f32) {
  %payload = channel.wait %read : read<tile<64xf32>> -> view<64xf32>
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %depth = index.constant 3 : index
  %factor = index.constant 2 : index
  %39 = index.constant 2 : index
  %40 = index.cmp slt, %39, %length : index
  cfg.cond_br %40, ^_bb1, ^_bb12
^_bb1:
  %value$42 = view.load %payload[%begin] : view<64xf32> -> f32
  %43 = index.constant 1 : index
  %44 = index.add %begin, %43 : index
  %value$45 = view.load %payload[%44] : view<64xf32> -> f32
  %62 = index.constant 2 : index
  %63 = index.cmp slt, %39, %length : index
  %64 = scf.select %63, %39, %length : index
  %65 = index.cast %64 : index to i64
  %66 = index.cast %length : index to i64
  %67 = scalar.subi %66, %65 : i64
  %68 = scalar.constant 2 : i64
  %69 = scalar.remui %67, %68 : i64
  %70 = index.cast %69 : i64 to index
  %71 = index.constant 1 : index
  %72 = index.cmp ule, %70, %71 : index
  %73 = index.constant 0 : index
  %74 = scf.select %72, %70, %73 : index
  %75 = index.sub %length, %74 : index
  %76 = index.assume %75 [ge(%75, %64), le(%75, %length)] : index
  cfg.br ^_bb2(%39: index, %initial: f32, %value$42: f32, %value$45: f32)
^_bb2(%151: index, %152: f32, %153: f32, %154: f32):
  %156 = index.cmp slt, %151, %76 : index
  cfg.cond_br %156, ^_bb3, ^_bb6
^_bb3:
  %155 = index.assume %151 [range(%151, 2, 9223372036854775806), multiple_of(%151, 2), lt(%151, %76)] : index
  %84 = index.constant 1 : index
  %85 = index.add %155, %84 : index
  %86, %87 = index.assume %155, %85 [lt(%155, %length), lt(%85, %length)] : index, index
  %value$88 = view.load %payload[%86] : view<64xf32> -> f32
  %value_1$89 = view.load %payload[%87] : view<64xf32> -> f32
  scf.schedule.fence
  %next$90 = scalar.addf %152, %153 : f32
  scf.schedule.fence
  %next_1$91 = scalar.addf %next$90, %154 : f32
  %157 = index.sub %76, %155 : index
  %158 = index.cmp ult, %62, %157 : index
  cfg.cond_br %158, ^_bb4, ^_bb5
^_bb4:
  %159 = index.add %155, %62 : index
  cfg.br ^_bb2(%159: index, %next_1$91: f32, %value$88: f32, %value_1$89: f32)
^_bb5:
  cfg.br ^_bb7(%next_1$91: f32, %value$88: f32, %value_1$89: f32)
^_bb6:
  cfg.br ^_bb7(%152: f32, %153: f32, %154: f32)
^_bb7(%148: f32, %149: f32, %150: f32):
  cfg.br ^_bb8(%76: index, %148: f32, %149: f32, %150: f32)
^_bb8(%141: index, %142: f32, %143: f32, %144: f32):
  %146 = index.cmp slt, %141, %length : index
  cfg.cond_br %146, ^_bb9, ^_bb10
^_bb9:
  %145 = index.assume %141 [range(%141, -9223372036854775808, 9223372036854775806), ge(%141, %76), lt(%141, %length)] : index
  %value$99 = view.load %payload[%145] : view<64xf32> -> f32
  %next$100 = scalar.addf %142, %143 : f32
  %147 = index.add %145, %step : index
  cfg.br ^_bb8(%147: index, %next$100: f32, %144: f32, %value$99: f32)
^_bb10:
  cfg.br ^_bb11(%142: f32, %143: f32, %144: f32)
^_bb11(%138: f32, %139: f32, %140: f32):
  %next$55 = scalar.addf %138, %139 : f32
  %next$56 = scalar.addf %next$55, %140 : f32
  cfg.br ^_bb21(%next$56: f32)
^_bb12:
  %101 = index.constant 2 : index
  %102 = index.constant 0 : index
  %103 = index.sub %length, %begin : index
  %104 = index.max %103, %102 : index
  %105 = index.constant 2 : index
