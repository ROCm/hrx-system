// RUN: pass pipeline-scf-for,unroll-scf-for,scf-to-cfg,ownership-lifetime

// The owned read spans startup, steady state and drain of the scalar read-ahead
// loop. Loaded scalars enter its queue; the read remains with this helper until
// the final payload use. The helper also handles an empty or short prefix.
func.def @sum_record(%read: read<tile<64xf32>>, %length: index, %initial: f32) -> (f32) {
  %payload = channel.wait %read : read<tile<64xf32>> -> view<64xf32>
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %depth = index.constant 3 : index
  %factor = index.constant 2 : index
  %sum = scf.for %element = [%begin to %length step %step](%partial = %initial : f32) -> (f32) pipeline(%depth) unroll(%factor) schedule(recurrence) {
    %value = view.load %payload[%element] : view<64xf32> -> f32
    %next = scalar.addf %partial, %value : f32
    scf.yield %next : f32
  }
  channel.release %read : read<tile<64xf32>>
  func.return %sum : f32
}

// With at least two staging slots, the next transfer can own its destination
// while the current record is read. Copy owns source retirement and destination
// publication; accept claims a pending record without making it readable.
// No record or reservation is taken on the empty-stream path.
func.def @sum_stream(%source: channel<tile<64xf32>>, %staging: channel<tile<64xf32>>, %count: index, %length: index) -> (f32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %identity = scalar.constant 0.0 : f32
  %has_records = index.cmp sgt, %count, %begin : index
  %result = scf.if %has_records -> (f32) {
    %first_source = channel.accept %source : channel<tile<64xf32>> -> read<tile<64xf32>>
    %first_write, %first_storage = channel.reserve %staging : channel<tile<64xf32>> -> (write<tile<64xf32>>, view<64xf32>)
    channel.copy %first_source -> %first_write : read<tile<64xf32>>, write<tile<64xf32>>
    %first = channel.accept %staging : channel<tile<64xf32>> -> read<tile<64xf32>>
    %last, %sum = scf.for %record = [%step to %count step %step](%current = %first : read<tile<64xf32>>, %partial = %identity : f32) -> (read<tile<64xf32>>, f32) {
      %next_source = channel.accept %source : channel<tile<64xf32>> -> read<tile<64xf32>>
      %next_write, %next_storage = channel.reserve %staging : channel<tile<64xf32>> -> (write<tile<64xf32>>, view<64xf32>)
      channel.copy %next_source -> %next_write : read<tile<64xf32>>, write<tile<64xf32>>
      %next = channel.accept %staging : channel<tile<64xf32>> -> read<tile<64xf32>>
      %next_sum = func.call @sum_record(%current, %length, %partial) : (read<tile<64xf32>>, index, f32) -> (f32)
      scf.yield %next, %next_sum : read<tile<64xf32>>, f32
    }
    %finished = func.call @sum_record(%last, %length, %sum) : (read<tile<64xf32>>, index, f32) -> (f32)
    scf.yield %finished : f32
  } else {
    scf.yield %identity : f32
  }
  func.return %result : f32
}

