func.def @sum_record(%read: read<tile<64xf32>>, %length: index, %initial: f32) -> (f32) {
  %payload = channel.wait %read : read<tile<64xf32>> -> view<64xf32>
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %depth = index.constant 3 : index
  %factor = index.constant 2 : index
  %39 = index.constant 2 : index
  %40 = index.cmp slt, %39, %length : index
  cfg.cond_br %40, ^_bb1, ^_bb12
^_bb1:
  %value$42 = view.load %payload[%begin] : view<64xf32> -> f32
  %43 = index.constant 1 : index
  %44 = index.add %begin, %43 : index
  %value$45 = view.load %payload[%44] : view<64xf32> -> f32
  %62 = index.constant 2 : index
  %63 = index.cmp slt, %39, %length : index
  %64 = scf.select %63, %39, %length : index
  %65 = index.cast %64 : index to i64
  %66 = index.cast %length : index to i64
  %67 = scalar.subi %66, %65 : i64
  %68 = scalar.constant 2 : i64
  %69 = scalar.remui %67, %68 : i64
  %70 = index.cast %69 : i64 to index
  %71 = index.constant 1 : index
  %72 = index.cmp ule, %70, %71 : index
  %73 = index.constant 0 : index
  %74 = scf.select %72, %70, %73 : index
  %75 = index.sub %length, %74 : index
  %76 = index.assume %75 [ge(%75, %64), le(%75, %length)] : index
  cfg.br ^_bb2(%39: index, %initial: f32, %value$42: f32, %value$45: f32)
^_bb2(%152: index, %153: f32, %154: f32, %155: f32):
  %157 = index.cmp slt, %152, %76 : index
  cfg.cond_br %157, ^_bb3, ^_bb6
^_bb3:
  %156 = index.assume %152 [range(%152, 2, 9223372036854775806), multiple_of(%152, 2), lt(%152, %76)] : index
  %84 = index.constant 1 : index
  %85 = index.add %156, %84 : index
  %86, %87 = index.assume %156, %85 [range(%156, 2, 9223372036854775806), ge(%156, %39), lt(%156, %length), range(%85, 2, 9223372036854775806), ge(%85, %39), lt(%85, %length)] : index, index
  %value$88 = view.load %payload[%86] : view<64xf32> -> f32
  %value_1$89 = view.load %payload[%87] : view<64xf32> -> f32
  scf.schedule.fence
  %next$90 = scalar.addf %153, %154 : f32
  scf.schedule.fence
  %next_1$91 = scalar.addf %next$90, %155 : f32
  %158 = index.sub %76, %156 : index
  %159 = index.cmp ult, %62, %158 : index
  cfg.cond_br %159, ^_bb4, ^_bb5
^_bb4:
  %160 = index.add %156, %62 : index
  cfg.br ^_bb2(%160: index, %next_1$91: f32, %value$88: f32, %value_1$89: f32)
^_bb5:
