^_bb6:
  cfg.br ^_bb7(%153: f32, %154: f32, %155: f32)
^_bb7(%149: f32, %150: f32, %151: f32):
  cfg.br ^_bb8(%76: index, %149: f32, %150: f32, %151: f32)
^_bb8(%142: index, %143: f32, %144: f32, %145: f32):
  %147 = index.cmp slt, %142, %length : index
  cfg.cond_br %147, ^_bb9, ^_bb10
^_bb9:
  %146 = index.assume %142 [range(%142, -9223372036854775808, 9223372036854775806), ge(%142, %76), lt(%142, %length)] : index
  %99 = index.assume %146 [range(%146, 2, 9223372036854775806)] : index
  %value$100 = view.load %payload[%99] : view<64xf32> -> f32
  %next$101 = scalar.addf %143, %144 : f32
