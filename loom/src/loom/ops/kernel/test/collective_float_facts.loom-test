// RUN: pass canonicalize

// Variadic results retain independent format sets, not just the first input's.
kernel.def @source_formats() {
  %unit = index.constant 1 : index
  %width = index.constant 67 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%e4m3: f8E4M3, %e5m2: f8E5M2, %half: f16, %bfloat: bf16, %single: f32, %integer: i64) {
  %wide_e4m3 = scalar.extf %e4m3 : f8E4M3 to f64
  %wide_e5m2 = scalar.extf %e5m2 : f8E5M2 to f64
  %wide_half = scalar.extf %half : f16 to f64
  %wide_bfloat = scalar.extf %bfloat : bf16 to f64
  %wide_single = scalar.extf %single : f32 to f64
  %double = scalar.sitofp %integer : i64 to f64
  %minimum_e4m3, %minimum_e5m2, %minimum_half, %minimum_bfloat, %minimum_single, %minimum_double = kernel.workgroup.reduce<minimumf, preserve> %wide_e4m3, %wide_e5m2, %wide_half, %wide_bfloat, %wide_single, %double : f64, f64, f64, f64, f64, f64
  %e4m3_types = test.fact_exact_float_types %minimum_e4m3 : f64 -> i64
  %e5m2_types = test.fact_exact_float_types %minimum_e5m2 : f64 -> i64
  %half_types = test.fact_exact_float_types %minimum_half : f64 -> i64
  %bfloat_types = test.fact_exact_float_types %minimum_bfloat : f64 -> i64
  %single_types = test.fact_exact_float_types %minimum_single : f64 -> i64
  %double_types = test.fact_exact_float_types %minimum_double : f64 -> i64
  test.use %e4m3_types, %e5m2_types, %half_types, %bfloat_types, %single_types, %double_types : i64, i64, i64, i64, i64, i64
  kernel.return
}

// ----
kernel.def @source_formats() {
  %unit = index.constant 1 : index
  %width = index.constant 67 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%e4m3: f8E4M3, %e5m2: f8E5M2, %half: f16, %bfloat: bf16, %single: f32, %integer: i64) {
  %wide_e4m3 = scalar.extf %e4m3 : f8E4M3 to f64
  %wide_e5m2 = scalar.extf %e5m2 : f8E5M2 to f64
  %wide_half = scalar.extf %half : f16 to f64
  %wide_bfloat = scalar.extf %bfloat : bf16 to f64
  %wide_single = scalar.extf %single : f32 to f64
  %double = scalar.sitofp %integer : i64 to f64
  %minimum_e4m3, %minimum_e5m2, %minimum_half, %minimum_bfloat, %minimum_single, %minimum_double = kernel.workgroup.reduce<minimumf, preserve> %wide_e4m3, %wide_e5m2, %wide_half, %wide_bfloat, %wide_single, %double : f64, f64, f64, f64, f64, f64
  %e4m3_types = scalar.constant 15616 : i64
  %e5m2_types = scalar.constant 15872 : i64
  %half_types = scalar.constant 13312 : i64
  %bfloat_types = scalar.constant 14336 : i64
  %single_types = scalar.constant 12288 : i64
  %double_types = scalar.constant 8192 : i64
  test.use %e4m3_types, %e5m2_types, %half_types, %bfloat_types, %single_types, %double_types : i64, i64, i64, i64, i64, i64
  kernel.return
}

// ====

// NaN-capable BF16 values remain exactly representable after all extrema.
// Native/preserve, clusters, direction, and scope do not change that guarantee.
kernel.def @extrema_kinds_and_prefixes() {
  %unit = index.constant 1 : index
  %width = index.constant 67 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: bf16) {
  %value = scalar.extf %input : bf16 to f32
  %minimum = kernel.subgroup.reduce<minimumf> %value : f32
  %maximum = kernel.subgroup.reduce<maximumf, preserve> %value {cluster_size = 8, cluster_stride = 2} : f32
  %minnum = kernel.subgroup.reduce<minnumf, preserve> %value : f32
  %maxnum = kernel.subgroup.reduce<maxnumf> %value {cluster_size = 8} : f32
  %inclusive_minimum = kernel.subgroup.scan<minimumf> %value {direction = forward, mode = inclusive} : f32
  %inclusive_maximum = kernel.workgroup.scan<maximumf, preserve> %value {direction = reverse, mode = inclusive} : f32
  %inclusive_minnum = kernel.workgroup.scan<minnumf> %value {direction = forward, mode = inclusive} : f32
  %inclusive_maxnum = kernel.subgroup.scan<maxnumf, preserve> %value {cluster_size = 8, cluster_stride = 2, direction = reverse, mode = inclusive} : f32
  %exclusive_minimum = kernel.workgroup.scan<minimumf, preserve> %value {direction = reverse, mode = exclusive} : f32
  %exclusive_maximum = kernel.subgroup.scan<maximumf> %value {direction = forward, mode = exclusive} : f32
  %exclusive_minnum = kernel.subgroup.scan<minnumf> %value {cluster_size = 8, cluster_stride = 2, direction = reverse, mode = exclusive} : f32
  %exclusive_maxnum = kernel.workgroup.scan<maxnumf, preserve> %value {direction = forward, mode = exclusive} : f32
  %minimum_types = test.fact_exact_float_types %minimum : f32 -> i64
  %maximum_types = test.fact_exact_float_types %maximum : f32 -> i64
  %minnum_types = test.fact_exact_float_types %minnum : f32 -> i64
  %maxnum_types = test.fact_exact_float_types %maxnum : f32 -> i64
  %inclusive_minimum_types = test.fact_exact_float_types %inclusive_minimum : f32 -> i64
  %inclusive_maximum_types = test.fact_exact_float_types %inclusive_maximum : f32 -> i64
  %inclusive_minnum_types = test.fact_exact_float_types %inclusive_minnum : f32 -> i64
  %inclusive_maxnum_types = test.fact_exact_float_types %inclusive_maxnum : f32 -> i64
  %exclusive_minimum_types = test.fact_exact_float_types %exclusive_minimum : f32 -> i64
  %exclusive_maximum_types = test.fact_exact_float_types %exclusive_maximum : f32 -> i64
  %exclusive_minnum_types = test.fact_exact_float_types %exclusive_minnum : f32 -> i64
  %exclusive_maxnum_types = test.fact_exact_float_types %exclusive_maxnum : f32 -> i64
  test.use %minimum_types, %maximum_types, %minnum_types, %maxnum_types, %inclusive_minimum_types, %inclusive_maximum_types, %inclusive_minnum_types, %inclusive_maxnum_types, %exclusive_minimum_types, %exclusive_maximum_types, %exclusive_minnum_types, %exclusive_maxnum_types : i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64
  kernel.return
}

