// RUN: pass canonicalize

kernel.def @execution_uniform_scope_facts() {
  %c1 = index.constant 1 : index
  %c64 = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c64, %c1, %c1) : index
} launch(%arg: i32) {
  %workgroup = kernel.workgroup.id<x> : index
  %subgroup = kernel.subgroup.id : index
  %subgroup_i32 = index.cast %subgroup : index to i32
  %sum = scalar.addi %subgroup_i32, %arg : i32
  %arg_is_subgroup_uniform = test.fact_subgroup_uniform %arg : i32 -> i1
  %arg_is_workgroup_uniform = test.fact_workgroup_uniform %arg : i32 -> i1
  %workgroup_is_subgroup_uniform = test.fact_subgroup_uniform %workgroup : index -> i1
  %workgroup_is_workgroup_uniform = test.fact_workgroup_uniform %workgroup : index -> i1
  %subgroup_is_subgroup_uniform = test.fact_subgroup_uniform %subgroup : index -> i1
  %subgroup_is_workgroup_uniform = test.fact_workgroup_uniform %subgroup : index -> i1
  %sum_is_subgroup_uniform = test.fact_subgroup_uniform %sum : i32 -> i1
  %sum_is_workgroup_uniform = test.fact_workgroup_uniform %sum : i32 -> i1
  test.use %arg_is_subgroup_uniform, %arg_is_workgroup_uniform, %workgroup_is_subgroup_uniform, %workgroup_is_workgroup_uniform, %subgroup_is_subgroup_uniform, %subgroup_is_workgroup_uniform, %sum_is_subgroup_uniform, %sum_is_workgroup_uniform : i1, i1, i1, i1, i1, i1, i1, i1
  kernel.return
}

