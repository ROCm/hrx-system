  %linear_hi = test.fact_range_hi %linear : index -> i64
  %linear_is_varying = test.fact_lane_varying %linear : index -> i1
  test.use %bid_hi, %count_lo, %count_hi, %tid_hi, %dispatch_hi, %linear_non_negative, %linear_hi, %linear_is_varying : i64, i64, i64, i64, i64, i1, i64, i1
  kernel.return
