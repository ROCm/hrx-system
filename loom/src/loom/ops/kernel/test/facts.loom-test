kernel.def @collective_uniform_scope_facts() {
  %c1 = index.constant 1 : index
  %c64 = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c64, %c1, %c1) : index
} launch(%arg: i32) {
  %lane = kernel.workitem.id<x> : index
  %lane_i32 = index.cast %lane : index to i32
  %first_lane = index.constant 0 : index
  %first_lane_i32 = scalar.constant 0 : i32
  %predicate = index.cmp eq, %lane, %first_lane : index
  %broadcast = kernel.subgroup.broadcast %lane_i32 from %first_lane_i32 : i32, i32
  %broadcast_first = kernel.subgroup.broadcast.first %lane_i32 : i32
  %broadcast_uniform = kernel.subgroup.broadcast %arg from %lane_i32 : i32, i32
  %subgroup_sum = kernel.subgroup.reduce<addi> %lane_i32 : i32
  %subgroup_prefix = kernel.subgroup.scan<addi> %lane_i32 {direction = forward, mode = inclusive} : i32
  %workgroup_sum = kernel.workgroup.reduce<addi> %lane_i32 : i32
  %workgroup_prefix = kernel.workgroup.scan<addi> %lane_i32 {direction = forward, mode = inclusive} : i32
  %workgroup_any = kernel.workgroup.vote.any %predicate : i1
  %subgroup_sum_is_subgroup_uniform = test.fact_subgroup_uniform %subgroup_sum : i32 -> i1
  %subgroup_sum_is_workgroup_uniform = test.fact_workgroup_uniform %subgroup_sum : i32 -> i1
  %subgroup_prefix_is_varying = test.fact_lane_varying %subgroup_prefix : i32 -> i1
  %workgroup_sum_is_workgroup_uniform = test.fact_workgroup_uniform %workgroup_sum : i32 -> i1
  %workgroup_prefix_is_varying = test.fact_lane_varying %workgroup_prefix : i32 -> i1
  %workgroup_any_is_workgroup_uniform = test.fact_workgroup_uniform %workgroup_any : i1 -> i1
  %broadcast_is_subgroup_uniform = test.fact_subgroup_uniform %broadcast : i32 -> i1
  %broadcast_first_is_subgroup_uniform = test.fact_subgroup_uniform %broadcast_first : i32 -> i1
  %broadcast_uniform_is_workgroup_uniform = test.fact_workgroup_uniform %broadcast_uniform : i32 -> i1
  test.use %subgroup_sum_is_subgroup_uniform, %subgroup_sum_is_workgroup_uniform, %subgroup_prefix_is_varying, %workgroup_sum_is_workgroup_uniform, %workgroup_prefix_is_varying, %workgroup_any_is_workgroup_uniform, %broadcast_is_subgroup_uniform, %broadcast_first_is_subgroup_uniform, %broadcast_uniform_is_workgroup_uniform : i1, i1, i1, i1, i1, i1, i1, i1, i1
  kernel.return
}

