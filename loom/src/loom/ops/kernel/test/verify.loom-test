// RUN: verify

// Execution queries and collectives describe the strand's participating
// invocations. They remain valid before outlining into the physical kernel.
pipeline.def<kernel> @strand_execution_operations() run(%value: f32, %predicate: i1, %lane_index: i32, %lane_width: i32) {
  pipeline.strand workers([0, 0, 0], [1, 1, 1], [1, 1, 1]) {
    %item = kernel.workitem.id<x> : index
    %group = kernel.workgroup.id<y> : index
    %group_size = kernel.workgroup.size<z> : index
    %group_count = kernel.workgroup.count<x> : index
    %dispatch_item = kernel.workitem.dispatch.id<y> : index
    %cluster = kernel.cluster.id<z> : index
    %cluster_group = kernel.cluster.workgroup.id<x> : index
    %cluster_flat = kernel.cluster.workgroup.flat_id : index
    %cluster_size = kernel.cluster.size<y> : index
    %cluster_count = kernel.cluster.count<z> : index
    %subgroup = kernel.subgroup.id : index
    %subgroup_count = kernel.subgroup.count : index
    %subgroup_size = kernel.subgroup.size : index
    %lane = kernel.subgroup.lane.id : index
    %shuffled, %valid = kernel.subgroup.shuffle<xor> %value, %lane_index, %lane_width : f32, i32, i32
    %broadcast = kernel.subgroup.broadcast %value from %lane_index : f32, i32
    %first = kernel.subgroup.broadcast.first %value : f32
    %subgroup_sum = kernel.subgroup.reduce<addf> %value : f32
    %subgroup_scan = kernel.subgroup.scan<addf> %value {direction = forward, mode = inclusive} : f32
    %subgroup_any = kernel.subgroup.vote.any %predicate : i1
    %subgroup_all = kernel.subgroup.vote.all %predicate : i1
    %ballot = kernel.subgroup.vote.ballot %predicate : i1 -> i64
    %active = kernel.subgroup.active.mask : i64
    %matching = kernel.subgroup.match.any %lane_index : i32 -> i64
    %matching_all, %equal = kernel.subgroup.match.all %lane_index : i32 -> i64, i1
    %group_sum = kernel.workgroup.reduce<addf> %value : f32
    %group_scan = kernel.workgroup.scan<addf> %value {direction = forward, mode = inclusive} : f32
    %group_any = kernel.workgroup.vote.any %predicate : i1
    %group_all = kernel.workgroup.vote.all %predicate : i1
    %group_votes = kernel.workgroup.vote.count %predicate : i1 -> i32
    kernel.assert %predicate : i1
  }
}

// ====

// Construction is outside the executing worker, even inside a kernel-scoped
// pipeline. Neither a coordinate nor a collective has participants here.
pipeline.def<kernel> @construction_has_no_worker() run(%value: f32) {
  // ERROR@+1: STRUCTURE/029 "kernel.workitem.id" "one-of-required" "kernel.def or pipeline.strand" "pipeline.def"
  %item = kernel.workitem.id<x> : index
  // ERROR@+1: STRUCTURE/029 "kernel.workgroup.reduce" "one-of-required" "kernel.def or pipeline.strand" "pipeline.def"
  %sum = kernel.workgroup.reduce<addf> %value : f32
}

// ====

pipeline.def<kernel> @strand_is_not_a_kernel_exit_boundary() run(%done: i1) {
  pipeline.strand workers([0, 0, 0], [1, 1, 1], [1, 1, 1]) {
    // ERROR@+1: STRUCTURE/029 "kernel.exit" "parent" "kernel.def" "pipeline.strand"
    kernel.exit %done : i1
  }
}

