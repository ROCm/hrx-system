// ====

// Structured tuples preserve dependence per result instead of tainting the
// unrelated static workgroup size carried beside a loaded count.
kernel.def @structured_workgroup_count(%choose: i1, %counts: buffer) {
  %count_byte_offset = index.constant 0 : offset
  %loaded = buffer.load.i8.u %counts[%count_byte_offset]
  %loaded_count = index.cast %loaded : i32 to index
  %c1 = index.constant 1 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %count, %size = scf.if %choose -> (index, index) {
    scf.yield %loaded_count, %c64 : index, index
  } else {
    scf.yield %c1, %c32 : index, index
  }
  kernel.launch.config workgroups(%count, %c1, %c1) workgroup_size(%size, %c1, %c1) : index
} launch(%choose: i1, %counts: buffer) {
  kernel.return
}

