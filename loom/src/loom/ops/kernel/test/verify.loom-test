} launch(%enabled: i1) {
  cfg.cond_br %enabled, ^enabled_arm, ^disabled_arm
^enabled_arm:
  kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
  cfg.br ^join
^disabled_arm:
  cfg.br ^join
^join:
  kernel.return
}

