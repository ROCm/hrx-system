} launch() {
  %zero = index.constant 0 : index
  %workgroup = kernel.workgroup.id<x> : index
  %is_first_workgroup = index.cmp eq, %workgroup, %zero : index
  scf.if %is_first_workgroup {
    kernel.barrier<workgroup> {ordering = acq_rel, scope = workgroup}
    scf.yield
  }
  kernel.return
}

