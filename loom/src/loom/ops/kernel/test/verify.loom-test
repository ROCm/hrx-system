// ====

// Buffer-backed workload values may determine workgroup counts.
kernel.def @buffer_backed_workgroup_count(%counts: buffer) {
  %count_byte_offset = index.constant 0 : offset
  %loaded = buffer.load.i8.u %counts[%count_byte_offset]
  %count = index.cast %loaded : i32 to index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%count, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%counts: buffer) {
  kernel.return
}

// ====

// Derived views preserve the explicit workload-storage origin.
kernel.def @view_backed_workgroup_count(%counts: buffer) {
  %count_byte_offset = index.constant 0 : offset
  %view = buffer.view %counts[%count_byte_offset] : buffer -> view<1xi8>
  %loaded = view.load %view[0] : view<1xi8> -> i8
  %extended = scalar.extui %loaded : i8 to i32
  %count = index.cast %extended : i32 to index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%count, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%counts: buffer) {
  kernel.return
}

// ====

// Required-inline helpers retain explicit workload provenance and numeric
// facts across the authored call boundary.
func.def inline @load_workgroup_count(%counts: buffer) -> (i32) {
  %count_byte_offset = index.constant 0 : offset
  %loaded = buffer.load.i8.u %counts[%count_byte_offset]
  func.return %loaded : i32
}

kernel.def @helper_backed_workgroup_count(%counts: buffer) {
  %loaded = func.call readonly @load_workgroup_count(%counts) : (buffer) -> (i32)
  %count = index.cast %loaded : i32 to index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%count, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%counts: buffer) {
  kernel.return
}

// ====

// Nested helpers preserve the exact reference arguments selected by the
// returned buffer. The unused hidden argument must not taint the read origin.
func.decl pure @helper_hidden_storage() -> (buffer)

func.def inline @select_workload_storage(%choose_left: i1, %left: buffer, %right: buffer, %unused: buffer) -> (buffer) {
  %selected = scf.select %choose_left, %left, %right : buffer
  func.return %selected : buffer
}

func.def inline @load_selected_workgroup_count(%choose_left: i1, %left: buffer, %right: buffer, %unused: buffer) -> (i32) {
  %selected = func.call pure @select_workload_storage(%choose_left, %left, %right, %unused) : (i1, buffer, buffer, buffer) -> (buffer)
  %count_byte_offset = index.constant 0 : offset
  %loaded = buffer.load.i8.u %selected[%count_byte_offset]
  func.return %loaded : i32
}

kernel.def @nested_helper_backed_workgroup_count(%choose_left: i1, %left: buffer, %right: buffer) {
  %hidden = func.call pure @helper_hidden_storage() : () -> (buffer)
  %loaded = func.call readonly @load_selected_workgroup_count(%choose_left, %left, %right, %hidden) : (i1, buffer, buffer, buffer) -> (i32)
  %count = index.cast %loaded : i32 to index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%count, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%choose_left: i1, %left: buffer, %right: buffer) {
  kernel.return
}

