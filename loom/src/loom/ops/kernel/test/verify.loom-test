// A storage-dependent loop condition taints every value whose selection it
// controls, even when the condition is also forwarded as ordinary loop state.
kernel.def @storage_conditioned_workgroup_size(%counts: buffer) {
  %count_byte_offset = index.constant 0 : offset
  %loaded = buffer.load.i8.u %counts[%count_byte_offset]
  %disabled_word = scalar.constant 0 : i32
  %enabled = scalar.cmpi ne, %loaded, %disabled_word : i32
  %disabled = scalar.constant false : i1
  %c1 = index.constant 1 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %ignored, %size = scf.while(%before_enabled = %enabled : i1, %before_size = %c32 : index) -> (i1, index) {
    scf.condition %before_enabled, %before_enabled, %before_size : i1, i1, index
  } do(%body_enabled: i1, %body_size: index) {
    scf.yield %disabled, %c64 : i1, index
  }
  // ERROR@+1: STRUCTURE/061 {field_name="workgroup_size[x]"}
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%size, %c1, %c1) : index
} launch(%counts: buffer) {
  kernel.return
}

