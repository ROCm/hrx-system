// RUN: pass canonicalize

kernel.def @exit_moves_tail_to_false_path() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%done: i1, %value: i32) {
  kernel.exit %done : i1
  test.use %value : i32
  kernel.return
}

// ----
kernel.def @exit_moves_tail_to_false_path() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%done: i1, %value: i32) {
  %3 = scalar.constant true : i1
  %4 = scalar.xori %done, %3 : i1
  scf.if %4 {
    test.use %value : i32
  }
  kernel.return
}

