  }
  kernel.return
}

// ----
kernel.def @exit_body_moves_to_true_path() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%done: i1, %value: i32) {
  scf.if %done {
    test.use %value : i32
  } else {
  }
  kernel.return
}

