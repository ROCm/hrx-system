load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")
load("//loom/build_tools/bazel:loom_check.bzl", "loom_check_test", "loom_check_test_suite")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_check_test_suite(
    name = "test",
    srcs = [
        "canonicalize.loom-test",
        "collective_facts.loom-test",
        "collective_float_facts.loom-test",
        "dce.loom-test",
        "facts.loom-test",
        "launch_dependent_types.loom-test",
        "roundtrip.loom-test",
        "subgroup_facts.loom-test",
        "verify.loom-test",
        "workgroup_payloads.loom-test",
    ],
)

loom_check_test(
    name = "subgroup_facts_spirv",
    src = "subgroup_facts_spirv.loom-test",
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/arch:spirv",
    ]),
)
