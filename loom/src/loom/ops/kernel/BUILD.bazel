load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test", "loom_generated_cc_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_cc_library(
    name = "launch_config_dependence",
    srcs = ["launch_config_dependence.c"],
    hdrs = ["launch_config_dependence.h"],
    visibility = ["//visibility:private"],
    deps = [
        "//loom/src/loom/analysis:value_relation",
        "//loom/src/loom/ir",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
    ],
)

loom_generated_cc_library(
    name = "kernel",
    srcs = [
        "canonicalize.c",
        "facts.c",
        "launch_config.c",
        "launch_config_callable_summary.c",
        "launch_config_contract.c",
        "verify.c",
    ],
    hdrs = [
        "launch_config.h",
        "launch_config_callable_summary.h",
        "launch_config_contract.h",
        "ops.h",
    ],
    args = ["--dialect=kernel"],
    extra_output_flags = ["--ops-include"],
    extra_outputs = ["ops.inc"],
    generated_src_flags = [
        "--builders",
        "--tables",
    ],
    generated_srcs = [
        "builders.c",
        "tables.c",
    ],
    generator = "//loom/py/loom/gen/ops:c_tables_kernel_generator",
    textual_hdrs = ["ops.inc"],
    deps = [
        ":launch_config_dependence",
        "//loom/src/loom/analysis:value_relation",
        "//loom/src/loom/error:emitter",
        "//loom/src/loom/error:error_defs",
        "//loom/src/loom/error:parameter",
        "//loom/src/loom/ir",
        "//loom/src/loom/ir:facts",
        "//loom/src/loom/ops:atomic",
        "//loom/src/loom/ops:cache",
        "//loom/src/loom/ops:callable_effects",
        "//loom/src/loom/ops:combining",
        "//loom/src/loom/ops:func_symbol_facts",
        "//loom/src/loom/ops:function_contract_verify",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/ops/buffer",
        "//loom/src/loom/ops/func",
        "//loom/src/loom/ops/index",
        "//loom/src/loom/ops/pipeline",
        "//loom/src/loom/ops/scf",
        "//loom/src/loom/ops/target",
        "//loom/src/loom/ops/template",
        "//loom/src/loom/ops/view",
        "//loom/src/loom/rewrite:rewriter",
        "//loom/src/loom/target:facts",
        "//loom/src/loom/target:types",
        "//loom/src/loom/util:fact_table",
        "//loom/src/loom/util:reference_facts",
        "//loom/src/loom/util:walk",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal",
        "//runtime/src/iree/base/internal:arena",
    ],
)

loom_cc_test(
    name = "launch_config_test",
    srcs = ["launch_config_test.cc"],
    deps = [
        ":kernel",
        "//loom/src/loom/error:error_defs",
        "//loom/src/loom/testing:diagnostic_matchers",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
