// RUN: roundtrip

command.def @static_program() launch(%parameters: buffer) {
  %embedding = command.parameter %parameters, "token_embd.weight" : view<1024xi8>
  %base = command.parameter.base %embedding : view<1024xi8> -> buffer
  command.return
}

// ====

test.target<low_core> @gfx1100

command.def public target(@gfx1100) @decode(%token_count: index) launch(%parameters: buffer, %transient: buffer) {
  command.return
}

command.def @driver(%token_count: index) launch(%parameters: buffer, %transient: buffer) {
  command.launch @decode[%token_count](%parameters, %transient) : [index](buffer, buffer)
  command.return
}

// ====

command.decl retain @decode(%token_count: index) launch(%parameters: buffer, %transient: buffer)

// ====

command.def @bounded(%token_count: index) launch(%parameters: buffer) where [range(%token_count, 1, 1024)] {
  %weight = command.parameter %parameters, "blk.{}.weight"[%token_count] : view<256xi8>
  command.return
}

// ====

command.def @scheduled() launch(%weights: view<16xf16>) {
  command.serial {
    command.concurrent {
      command.launch @leaf(%weights) : (view<16xf16>)
    }
  }
  command.return
}

command.def @leaf() launch(%weights: buffer) {
  command.return
}

// ====

kernel.decl @leaf_kernel(%element_count: index) launch(%parameters: buffer)

command.def @kernel_schedule(%element_count: index) launch(%parameters: buffer) {
  command.concurrent {
    kernel.launch @leaf_kernel[%element_count](%parameters) : [index](buffer)
  }
  command.return
}
