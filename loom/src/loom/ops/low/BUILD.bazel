load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_library_group", "loom_generated_cc_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_LOW_OPS_VISIBILITY = [
    "//loom/binding/c:__pkg__",
    "//loom/src/loom/analysis:__pkg__",
    "//loom/src/loom/codegen/low:__pkg__",
    "//loom/src/loom/codegen/low/allocation:__pkg__",
    "//loom/src/loom/codegen/low/lower:__pkg__",
    "//loom/src/loom/codegen/low/schedule:__pkg__",
    "//loom/src/loom/codegen/low/testing:__pkg__",
    "//loom/src/loom/codegen/low/transforms:__subpackages__",
    "//loom/src/loom/format/text/parser:__pkg__",
    "//loom/src/loom/format/text/printer:__pkg__",
    "//loom/src/loom/import/cxx/binding:__pkg__",
    "//loom/src/loom/ops:__pkg__",
    "//loom/src/loom/target:__pkg__",
    "//loom/src/loom/target/arch:__subpackages__",
    "//loom/src/loom/target/emit:__subpackages__",
    "//loom/src/loom/target/reporting:__pkg__",
    "//loom/src/loom/tooling/target/vm:__pkg__",
    "//loom/src/loom/tooling/target/wasm:__pkg__",
    "//loom/src/loom/tools/loom-check:__pkg__",
    "//loom/src/loom/transforms/cleanup:__pkg__",
    "//loom/src/loom/transforms/cfg:__pkg__",
    "//loom/src/loom/transforms/symbol:__pkg__",
    "//loom/src/loom/verify:__pkg__",
]

# Native IR clients can inspect and construct Low operations without owning the
# dialect's verification, inference, or rewriting implementation.
loom_cc_library(
    name = "op_defs",
    hdrs = ["ops.h"],
    textual_hdrs = ["ops.inc"],
    deps = [
        "//loom/src/loom/ir:headers",
        "//loom/src/loom/ops:headers",
        "//loom/src/loom/target:types",
    ],
)

# Descriptor-backed operations retain their handwritten constructors alongside
# the generated structural builders. Both consume caller-owned module state.
loom_cc_library_group(
    name = "builders",
    deps = [
        ":op_builders",
        ":op_defs",
        "//loom/src/loom/codegen/low:builder",
    ],
)

loom_cc_library(
    name = "op_builders",
    srcs = ["builders.c"],
    visibility = ["//visibility:private"],
    deps = [
        ":op_defs",
        "//loom/src/loom/ir:builders",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/util:stable_id",
    ],
)

loom_generated_cc_library(
    name = "low",
    srcs = [
        "canonicalize.c",
        "capture.c",
        "facts.c",
        "kernel.c",
        "schedule_scope.c",
        "verify.c",
    ],
    hdrs = [
        "capture.h",
        "kernel.h",
        "ops.h",
        "schedule_scope.h",
    ],
    args = ["--dialect=low"],
    extra_output_flags = [
        "--ops-include",
        "--builders",
    ],
    extra_outputs = [
        "ops.inc",
        "builders.c",
    ],
    generated_src_flags = ["--tables"],
    generated_srcs = ["tables.c"],
    generator = "//loom/py/loom/gen/ops:c_tables_low_generator",
    textual_hdrs = ["ops.inc"],
    visibility = _LOW_OPS_VISIBILITY,
    deps = [
        ":op_builders",
        "//loom/src/loom/error:emitter",
        "//loom/src/loom/error:error_defs",
        "//loom/src/loom/error:parameter",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:callable_effects",
        "//loom/src/loom/ops:func_symbol_facts",
        "//loom/src/loom/ops:function_contract_verify",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/ops:storage_facts",
        "//loom/src/loom/ops:successor_verify",
        "//loom/src/loom/ops/target",
        "//loom/src/loom/rewrite:remap",
        "//loom/src/loom/rewrite:rewriter",
        "//loom/src/loom/target:registers",
        "//loom/src/loom/target:types",
        "//loom/src/loom/util:cfg_graph",
        "//loom/src/loom/util:fact_table",
        "//loom/src/loom/util:predicate_facts",
        "//loom/src/loom/util:stable_id",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
    ],
)
