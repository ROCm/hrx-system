// ====

// A single-use required alias can still change through its parent owner.
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @captured_alias_projection(%source: reg<test.i32>, %other: reg<test.i32>, %suffix: reg<test.i32>) -> (reg<test.i32 x2>, reg<test.i32>) asm {
  %alias = low.assume %source [range(%source, 0, 1024)] : reg<test.i32>
  %whole = concat(%alias, %other, %suffix) : (reg<test.i32>, reg<test.i32>, reg<test.i32>) -> reg<test.i32 x3>
  %changed = test.tied.any %source
  %first = slice %whole[0] : reg<test.i32 x3> -> reg<test.i32 x2>
  return %first, %changed
}

// ====

// Reassembling a whole parent must preserve the earlier slice observations.
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @common_source_captured_before_move(%prefix: reg<test.i32>, %source: reg<test.i32 x2>, %suffix: reg<test.i32>) -> (reg<test.i32 x2>, reg<test.i32 x2>) asm {
  %a = slice %source[0] : reg<test.i32 x2> -> reg<test.i32>
  %b = slice %source[1] : reg<test.i32 x2> -> reg<test.i32>
  %moved = move %source : reg<test.i32 x2> -> reg<test.i32 x2>
  %whole = concat(%prefix, %a, %b, %suffix) : (reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>) -> reg<test.i32 x4>
  %middle = slice %whole[1] : reg<test.i32 x4> -> reg<test.i32 x2>
  return %middle, %moved
}

// ====

// Every selected input must retain its observation, including later aliases.
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @captured_later_alias_projection(%source: reg<test.i32>, %other: reg<test.i32>, %suffix: reg<test.i32>) -> (reg<test.i32 x2>, reg<test.i32>) asm {
  %alias = low.assume %source [range(%source, 0, 1024)] : reg<test.i32>
  %whole = concat(%other, %alias, %suffix) : (reg<test.i32>, reg<test.i32>, reg<test.i32>) -> reg<test.i32 x3>
  %changed = test.tied.any %source
  %first = slice %whole[0] : reg<test.i32 x3> -> reg<test.i32 x2>
  return %first, %changed
}

// ====

// A projection contained in one operand need not materialize its siblings.
// RUN: pass canonicalize
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @partial_concat_operands(%a: reg<test.i32 x3>, %b: reg<test.i32 x3>, %c: reg<test.i32 x3>) -> (reg<test.i32>, reg<test.i32 x2>, reg<test.i32>) asm {
  %whole = concat(%a, %b, %c) : (reg<test.i32 x3>, reg<test.i32 x3>, reg<test.i32 x3>) -> reg<test.i32 x9>
  %first = slice %whole[1] : reg<test.i32 x9> -> reg<test.i32>
  %middle = slice %whole[4] : reg<test.i32 x9> -> reg<test.i32 x2>
  %last = slice %whole[8] : reg<test.i32 x9> -> reg<test.i32>
  return %first, %middle, %last
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @partial_concat_operands(%a: reg<test.i32 x3>, %b: reg<test.i32 x3>, %c: reg<test.i32 x3>) -> (reg<test.i32>, reg<test.i32 x2>, reg<test.i32>) asm {
  %first = slice %a[1] : reg<test.i32 x3> -> reg<test.i32>
  %middle = slice %b[1] : reg<test.i32 x3> -> reg<test.i32 x2>
  %last = slice %c[2] : reg<test.i32 x3> -> reg<test.i32>
  return %first, %middle, %last
}

// ====

// The same projection composes through multiple levels of grouped operands.
// RUN: pass canonicalize
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @nested_concat_projection(%a: reg<test.i32>, %b: reg<test.i32>, %c: reg<test.i32>, %d: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %left = concat(%a, %b) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32 x2>
  %right = concat(%c, %d) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32 x2>
  %whole = concat(%left, %right) : (reg<test.i32 x2>, reg<test.i32 x2>) -> reg<test.i32 x4>
  %first = slice %whole[1] : reg<test.i32 x4> -> reg<test.i32>
  %last = slice %whole[3] : reg<test.i32 x4> -> reg<test.i32>
  return %first, %last
}

