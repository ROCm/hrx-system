// ====

// Read-only projections may share a capture. Consumed projections retain their
// independent identities, even when the original operands are equal.
// RUN: pass canonicalize,low-cse,low-dce
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @duplicate_readonly_captures(%source: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32>) asm {
  %pair = concat(%source, %source) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32 x2>
  %changed = test.tied.any %source
  %low = slice %pair[0] : reg<test.i32 x2> -> reg<test.i32>
  %high = slice %pair[1] : reg<test.i32 x2> -> reg<test.i32>
  return %low, %high, %changed
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @duplicate_readonly_captures(%source: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32>) asm {
  %high = slice %source[0] : reg<test.i32> -> reg<test.i32>
  %changed = test.tied.any %source
  return %high, %high, %changed
}

// ====

// RUN: pass canonicalize,low-cse,low-dce
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @duplicate_consumed_captures(%source: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32>) asm {
  %pair = concat(%source, %source) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32 x2>
  %changed = test.tied.any %source
  %low = slice %pair[0] : reg<test.i32 x2> -> reg<test.i32>
  %high = slice %pair[1] : reg<test.i32 x2> -> reg<test.i32>
  %low_changed = test.tied.any %low
  %high_changed = test.tied.any %high
  return %low_changed, %high_changed, %changed
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @duplicate_consumed_captures(%source: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>, reg<test.i32>) asm {
  %high = slice %source[0] : reg<test.i32> -> reg<test.i32>
  %low = slice %source[0] : reg<test.i32> -> reg<test.i32>
  %changed = test.tied.any %source
  %low_changed = test.tied.any %low
  %high_changed = test.tied.any %high
  return %low_changed, %high_changed, %changed
}

// ====

// An alias's single direct use is not independent of its parent observations.
// RUN: pass canonicalize,low-cse,low-dce
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @capture_alias_before_parent_write(%source: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %alias = low.assume %source [range(%source, 0, 1024)] : reg<test.i32>
  %saved = slice %alias[0] : reg<test.i32> -> reg<test.i32>
  %changed = test.tied.any %source
  return %saved, %changed
}

