low.func.def target<test.low.core>(@test_target) @capture_alias_before_parent_write(%source: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %alias = low.assume %source [range(%source, 0, 1024)] : reg<test.i32>
  %saved = slice %alias[0] : reg<test.i32> -> reg<test.i32>
  %changed = test.tied.any %source
  return %saved, %changed
}

