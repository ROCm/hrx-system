test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @forward_readonly_capture(%lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %source = test.add.i32 %lhs, %rhs
  %first = test.add.i32 %source, %lhs
  %second = test.add.i32 %source, %rhs
  return %first, %second
}

