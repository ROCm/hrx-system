// ====

// Combining offsets must retain the inner projection's observation point.
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @nested_capture_across_move(%source: reg<test.i32 x4>) -> (reg<test.i32>, reg<test.i32 x4>) asm {
  %middle = slice %source[1] : reg<test.i32 x4> -> reg<test.i32 x2>
  %moved = move %source : reg<test.i32 x4> -> reg<test.i32 x4>
  %saved = slice %middle[1] : reg<test.i32 x2> -> reg<test.i32>
  return %saved, %moved
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @nested_capture_across_move(%source: reg<test.i32 x4>) -> (reg<test.i32>, reg<test.i32 x4>) asm {
  %saved = slice %source[2] : reg<test.i32 x4> -> reg<test.i32>
  %moved = move %source : reg<test.i32 x4> -> reg<test.i32 x4>
  return %saved, %moved
}

