// ====

// A partial observation must stay before the original operand's ownership move.
// RUN: pass canonicalize
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @partial_concat_capture_across_move(%prefix: reg<test.i32>, %source: reg<test.i32 x4>) -> (reg<test.i32 x2>, reg<test.i32 x4>) asm {
  %whole = concat(%prefix, %source) : (reg<test.i32>, reg<test.i32 x4>) -> reg<test.i32 x5>
  %moved = move %source : reg<test.i32 x4> -> reg<test.i32 x4>
  %saved = slice %whole[2] : reg<test.i32 x5> -> reg<test.i32 x2>
  return %saved, %moved
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @partial_concat_capture_across_move(%prefix: reg<test.i32>, %source: reg<test.i32 x4>) -> (reg<test.i32 x2>, reg<test.i32 x4>) asm {
  %saved = slice %source[1] : reg<test.i32 x4> -> reg<test.i32 x2>
  %moved = move %source : reg<test.i32 x4> -> reg<test.i32 x4>
  return %saved, %moved
}

// ====

// A cross-operand interval does not fit either source and retains its capture.
// RUN: pass canonicalize
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @cross_operand_partial_slice(%a: reg<test.i32 x2>, %b: reg<test.i32 x2>) -> (reg<test.i32 x2>) asm {
  %whole = concat(%a, %b) : (reg<test.i32 x2>, reg<test.i32 x2>) -> reg<test.i32 x4>
  %middle = slice %whole[1] : reg<test.i32 x4> -> reg<test.i32 x2>
  return %middle
}
