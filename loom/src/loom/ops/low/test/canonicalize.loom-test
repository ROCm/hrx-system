// RUN: pass canonicalize

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @identity_slice(%source: reg<test.i32 x2>) -> (reg<test.i32 x2>) asm {
  %slice = slice %source[0] : reg<test.i32 x2> -> reg<test.i32 x2>
  return %slice
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @identity_slice(%source: reg<test.i32 x2>) -> (reg<test.i32 x2>) {
  low.return %source : reg<test.i32 x2>
}

// ====

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @nested_slice(%source: reg<test.i32 x4>) -> (reg<test.i32>) asm {
  %middle = slice %source[1] : reg<test.i32 x4> -> reg<test.i32 x2>
  %lane = slice %middle[1] : reg<test.i32 x2> -> reg<test.i32>
  return %lane
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @nested_slice(%source: reg<test.i32 x4>) -> (reg<test.i32>) {
  %lane = low.slice %source[2] : reg<test.i32 x4> -> reg<test.i32>
  low.return %lane : reg<test.i32>
}

// ====

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @slice_only_concat(%lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %pair = concat(%lhs, %rhs) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32 x2>
  %lo = slice %pair[0] : reg<test.i32 x2> -> reg<test.i32>
  %hi = slice %pair[1] : reg<test.i32 x2> -> reg<test.i32>
  return %lo, %hi
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @slice_only_concat(%lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) {
  low.return %lhs, %rhs : reg<test.i32>, reg<test.i32>
}

// ====

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @whole_concat_use_preserves_identity(%lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32 x2>, reg<test.i32>) asm {
  %pair = concat(%lhs, %rhs) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32 x2>
  %lo = slice %pair[0] : reg<test.i32 x2> -> reg<test.i32>
  return %pair, %lo
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @whole_concat_use_preserves_identity(%lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32 x2>, reg<test.i32>) {
  %pair = low.concat(%lhs, %rhs) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32 x2>
  low.return %pair, %lhs : reg<test.i32 x2>, reg<test.i32>
}
