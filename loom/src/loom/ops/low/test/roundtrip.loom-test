// RUN: roundtrip

test.target<low_core> @test_target

low.kernel.def target<test.low.core>(@test_target) export("entry") linkage(dso_local) workgroup_size(16, 4, 1) workgroup_count(8, 2, 1) cluster_size(1, 2, 1) @entry(%buffer: reg<test.ptr>) asm {
  return
}

// ====

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @schedule_fence() asm {
  low.schedule.fence
  return
}

// ====

test.target<low_core> @test_target

low.func.decl inline target<test.low.core>(@test_target) @inline_decl(%value: reg<test.i32>) -> (reg<test.i32>)

low.func.def noinline target<test.low.core>(@test_target) @noinline_helper(%value: reg<test.i32>) -> (reg<test.i32>) asm {
  return %value
}

low.func.def target<test.low.core>(@test_target) @inline_call_policy(%value: reg<test.i32>) -> (reg<test.i32>) asm {
  %result = low.func.call inline @inline_decl(%value) : (reg<test.i32>) -> (reg<test.i32>)
  return %result
}

func.def @invoke_call_policy(%value: i32) -> (i32) {
  %result = low.invoke noinline @noinline_helper(%value) : (i32) -> (i32)
  func.return %result : i32
}

// ====

test.target<low_core> @test_target

low.func.decl retain target<test.low.core>(@test_target) @retained_decl(%value: reg<test.i32>) -> (reg<test.i32>)

low.func.def retain target<test.low.core>(@test_target) @retained_func(%value: reg<test.i32>) -> (reg<test.i32>) asm {
  return %value
}

low.kernel.def retain target<test.low.core>(@test_target) @retained_kernel(%value: reg<test.i32>) asm {
  return
}

// ====

test.target<low_core> @test_target

low.func.decl target<test.low.core>(@test_target) @add(%lhs: reg<test.i32>, %rhs: reg<test.i32>) -> (reg<test.i32>)

low.kernel.def allocation(fixed) schedule(locked) target<test.low.core>(@test_target) @helper_entry(%lhs: reg<test.i32>, %rhs: reg<test.i32>) asm {
  %sum = low.func.call @add(%lhs, %rhs) : (reg<test.i32>, reg<test.i32>) -> (reg<test.i32>)
  return
}

// ====

test.target<low_core> @test_target

low.func.decl target<test.low.core>(@test_target) @typed_identity(%value: reg<test.i32 : i32>) -> (reg<test.i32 : i32>)

low.func.def target<test.low.core>(@test_target) @typed_call_and_branch(%value: reg<test.i32 : i32>) -> (reg<test.i32 : i32>) asm {
  %called = low.func.call @typed_identity(%value) : (reg<test.i32 : i32>) -> (reg<test.i32 : i32>)
  low.br ^exit(%called: reg<test.i32 : i32>)
^exit(%result: reg<test.i32 : i32>):
  return %result
}

// ====

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @storage_view(%value: reg<test.i32>) -> (reg<test.i32>) asm {
  %storage = storage {byte_alignment = 16, byte_length = 64} : low.storage<scratch>
  %whole = storage_view %storage {byte_length = 64} : low.storage<scratch> -> low.storage<scratch>
  %tail = storage_view %whole {offset = 16, byte_length = 16} : low.storage<scratch> -> low.storage<scratch>
  low.spill %value, %tail : reg<test.i32>, low.storage<scratch>
  %reload = low.reload %tail : low.storage<scratch> -> reg<test.i32>
  return %reload
}

// ====

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @detached_copy(%value: reg<test.i32>) asm {
  %copy = copy %value {detached = true} : reg<test.i32> -> reg<test.i32>
  return
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @detached_copy(%value: reg<test.i32>) {
  %copy = low.copy %value {detached = true} : reg<test.i32> -> reg<test.i32>
  low.return
}

// ====

test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @detached_move(%value: reg<test.i32>) -> (reg<test.i32>) asm {
  %moved = move %value {detached = true} : reg<test.i32> -> reg<test.i32>
  return %moved
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @detached_move(%value: reg<test.i32>) -> (reg<test.i32>) {
  %moved = low.move %value {detached = true} : reg<test.i32> -> reg<test.i32>
  low.return %moved : reg<test.i32>
}
