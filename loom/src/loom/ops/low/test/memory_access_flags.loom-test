test.target<low_core> @target

low.func.def target<test.low.core>(@target) @native_atomic_access_flags(%address: reg<test.ptr>, %value: reg<test.i32 x4>) asm {
  %observed = test.load.v4i32<atomic> %address
  test.store.v4i32<atomic> %address, %value
  return
}


