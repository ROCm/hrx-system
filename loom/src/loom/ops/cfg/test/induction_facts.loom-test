// ====

// RUN: pass canonicalize,dce

// Header facts include the terminal state. A representable net step is not
// enough when an intermediate add/sub prefix exceeds the selected carrier.
test.target<low_core> @offset32 {index_bitwidth = 32, offset_bitwidth = 32}

test.target<low_core> @offset64 {index_bitwidth = 64, offset_bitwidth = 64}

func.def target(@offset32) @carried_offset32_wrap() -> (i64, i64, i64, i64) {
  %begin = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  %terminal_seed = index.constant 4294967294 : offset
  %terminal_step = index.constant 1 : offset
  %prefix_seed = index.constant 4294967280 : offset
  %prefix_rise = index.constant 32 : offset
  %prefix_fall = index.constant 31 : offset
  cfg.br ^header(%begin: index, %terminal_seed: offset, %prefix_seed: offset)
^header(%iteration: index, %terminal: offset, %prefix: offset):
  %terminal_lo = test.fact_range_lo %terminal : offset -> i64
  %terminal_hi = test.fact_range_hi %terminal : offset -> i64
  %prefix_lo = test.fact_range_lo %prefix : offset -> i64
  %prefix_hi = test.fact_range_hi %prefix : offset -> i64
  %more = index.cmp slt, %iteration, %end : index
  cfg.cond_br %more, ^body, ^exit
^body:
  test.use %terminal_lo, %terminal_hi, %prefix_lo, %prefix_hi : i64, i64, i64, i64
  %iteration_next = index.add %iteration, %step : index
  %terminal_next = index.add %terminal, %terminal_step : offset
  %prefix_high = index.add %prefix, %prefix_rise : offset
  %prefix_next = index.sub %prefix_high, %prefix_fall : offset
  cfg.br ^header(%iteration_next: index, %terminal_next: offset, %prefix_next: offset)
^exit:
  func.return %terminal_lo, %terminal_hi, %prefix_lo, %prefix_hi : i64, i64, i64, i64
}

func.def target(@offset64) @carried_offset64_fits() -> (i64, i64, i64, i64) {
  %begin = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  %terminal_seed = index.constant 4294967294 : offset
  %terminal_step = index.constant 1 : offset
  %prefix_seed = index.constant 4294967280 : offset
  %prefix_rise = index.constant 32 : offset
  %prefix_fall = index.constant 31 : offset
  cfg.br ^header(%begin: index, %terminal_seed: offset, %prefix_seed: offset)
^header(%iteration: index, %terminal: offset, %prefix: offset):
  %terminal_lo = test.fact_range_lo %terminal : offset -> i64
  %terminal_hi = test.fact_range_hi %terminal : offset -> i64
  %prefix_lo = test.fact_range_lo %prefix : offset -> i64
  %prefix_hi = test.fact_range_hi %prefix : offset -> i64
  %more = index.cmp slt, %iteration, %end : index
  cfg.cond_br %more, ^body, ^exit
^body:
  test.use %terminal_lo, %terminal_hi, %prefix_lo, %prefix_hi : i64, i64, i64, i64
  %iteration_next = index.add %iteration, %step : index
  %terminal_next = index.add %terminal, %terminal_step : offset
  %prefix_high = index.add %prefix, %prefix_rise : offset
  %prefix_next = index.sub %prefix_high, %prefix_fall : offset
  cfg.br ^header(%iteration_next: index, %terminal_next: offset, %prefix_next: offset)
^exit:
  func.return %terminal_lo, %terminal_hi, %prefix_lo, %prefix_hi : i64, i64, i64, i64
}

