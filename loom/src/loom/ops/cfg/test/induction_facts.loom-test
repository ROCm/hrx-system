^header(%counter: index):
  %lo = test.fact_range_lo %counter : index -> i64
  %hi = test.fact_range_hi %counter : index -> i64
  %more = index.cmp slt, %counter, %end : index
  cfg.cond_br %more, ^body, ^exit
^body:
  %next = index.add %counter, %step : index
  cfg.br ^header(%next: index)
^exit:
  func.return %lo, %hi : i64, i64
}

func.def target(@target32) @offset_terminal_fits() -> (i64, i64) {
  %begin = index.constant 2147483646 : offset
  %end = index.constant 2147483647 : offset
  %step = index.constant 2 : offset
  cfg.br ^header(%begin: offset)
^header(%counter: offset):
  %lo = test.fact_range_lo %counter : offset -> i64
  %hi = test.fact_range_hi %counter : offset -> i64
  %more = index.cmp slt, %counter, %end : offset
  cfg.cond_br %more, ^body, ^exit
^body:
  %next = index.add %counter, %step : offset
  cfg.br ^header(%next: offset)
^exit:
  func.return %lo, %hi : i64, i64
}

// ----
CHECK: func.def target(@target32) @index_terminal_wrap*
CHECK: %lo = scalar.constant -9223372036854775808 : i64
CHECK: %hi = scalar.constant 9223372036854775807 : i64
CHECK: func.def target(@target32) @offset_terminal_fits*
CHECK: %lo = scalar.constant 2147483646 : i64
CHECK: %hi = scalar.constant 2147483648 : i64
CHECK-NOT: *test.fact_range_*

// ====

// RUN: with-checks pass canonicalize,dce

// An alternate entry may exceed the guard's bound at the header. Selecting only
// the first entry would incorrectly discard that observation.
func.def @multiple_entries(%choice: i1) -> (i64, i64) {
  %begin = index.constant 0 : index
  %other_begin = index.constant 100 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  cfg.cond_br %choice, ^first_entry, ^second_entry
^first_entry:
  cfg.br ^header(%begin: index)
^second_entry:
  cfg.br ^header(%other_begin: index)
^header(%counter: index):
  %lo = test.fact_range_lo %counter : index -> i64
  %hi = test.fact_range_hi %counter : index -> i64
  %more = index.cmp slt, %counter, %end : index
  cfg.cond_br %more, ^body, ^exit
^body:
  %next = index.add %counter, %step : index
  cfg.br ^header(%next: index)
^exit:
  func.return %lo, %hi : i64, i64
}

// ----
CHECK: %lo = scalar.constant -9223372036854775808 : i64
CHECK: %hi = scalar.constant 9223372036854775807 : i64
CHECK-NOT: *test.fact_range_*

// ====

// RUN: pass canonicalize

// The shifting state outlasts the CFG solve budget. Header reseeding precedes
// the body, so both increments retain their literal values through the reset.
func.def @additive_companion_after_fallback() -> (i64, i64, i64) {
  %begin = index.constant 0 : index
  %limit = index.constant 64 : index
  %origin = index.constant 0 : offset
  %decay_seed = scalar.constant 1099511627776 : i64
  cfg.br ^header(%begin: index, %origin: offset, %decay_seed: i64)
^header(%counter: index, %cursor: offset, %decaying: i64):
  %counter_hi = test.fact_range_hi %counter : index -> i64
  %cursor_lo = test.fact_range_lo %cursor : offset -> i64
  %cursor_hi = test.fact_range_hi %cursor : offset -> i64
  %decay_lo = test.fact_range_lo %decaying : i64 -> i64
  %decay_divisor = test.fact_divisor %decaying : i64 -> i64
  test.use %counter_hi, %cursor_lo, %cursor_hi, %decay_lo, %decay_divisor : i64, i64, i64, i64, i64
  %more = index.cmp slt, %counter, %limit : index
  cfg.cond_br %more, ^body, ^exit
^body:
  %counter_step = index.constant 1 : index
  %cursor_stride = index.constant 128 : offset
  %shift_amount = scalar.constant 1 : i64
  %counter_next = index.add %counter, %counter_step : index
  %cursor_next = index.add %cursor, %cursor_stride : offset
  %decay_next = scalar.shrui %decaying, %shift_amount : i64
  cfg.br ^header(%counter_next: index, %cursor_next: offset, %decay_next: i64)
^exit:
  func.return %cursor_lo, %cursor_hi, %decaying : i64, i64, i64
}

// ----
func.def @additive_companion_after_fallback() -> (i64, i64, i64) {
  %begin = index.constant 0 : index
  %limit = index.constant 64 : index
  %origin = index.constant 0 : offset
  %decay_seed = scalar.constant 1099511627776 : i64
  cfg.br ^header(%begin: index, %origin: offset, %decay_seed: i64)
^header(%counter: index, %cursor: offset, %decaying: i64):
  %counter_hi = scalar.constant 64 : i64
  %cursor_lo = scalar.constant 0 : i64
  %cursor_hi = scalar.constant 8192 : i64
  %decay_lo = scalar.constant -9223372036854775808 : i64
  %decay_divisor = scalar.constant 1 : i64
  test.use %counter_hi, %cursor_lo, %cursor_hi, %decay_lo, %decay_divisor : i64, i64, i64, i64, i64
  %more = index.cmp slt, %counter, %limit : index
  cfg.cond_br %more, ^body, ^exit
^body:
  %counter_step = index.constant 1 : index
  %cursor_stride = index.constant 128 : offset
  %shift_amount = scalar.constant 1 : i64
  %counter_next = index.add %counter, %counter_step : index
  %cursor_next = index.add %cursor, %cursor_stride : offset
  %decay_next = scalar.shrui %decaying, %shift_amount : i64
  cfg.br ^header(%counter_next: index, %cursor_next: offset, %decay_next: i64)
^exit:
  func.return %cursor_lo, %cursor_hi, %decaying : i64, i64, i64
}
