load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test", "loom_generated_cc_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

# Declarations and accessors can be consumed by shared analyses without linking
# the dialect's inference and rewrite implementation back into those analyses.
loom_cc_library(
    name = "op_defs",
    hdrs = ["ops.h"],
    textual_hdrs = ["ops.inc"],
    deps = ["//loom/src/loom/ops:op_defs"],
)

loom_cc_library(
    name = "comparison",
    srcs = ["compare.c"],
    hdrs = ["compare.h"],
    deps = [
        ":op_defs",
        "//loom/src/loom/ir:facts",
    ],
)

loom_generated_cc_library(
    name = "scalar",
    srcs = [
        "canonicalize.c",
        "canonicalize_comparison.c",
        "combining.c",
        "facts.c",
        "traits.c",
        "verify.c",
    ],
    hdrs = [
        "combining.h",
        "compare.h",
        "ops.h",
        "tables.h",
    ],
    args = ["--dialect=scalar"],
    extra_output_flags = ["--ops-include"],
    extra_outputs = ["ops.inc"],
    generated_src_flags = [
        "--builders",
        "--tables",
        "--table-shard=analysis",
        "--table-shard=arithmetic",
        "--table-shard=bitwise",
        "--table-shard=comparison",
        "--table-shard=conversion",
        "--table-shard=math",
    ],
    generated_srcs = [
        "builders.c",
        "tables.c",
        "tables/analysis.c",
        "tables/arithmetic.c",
        "tables/bitwise.c",
        "tables/comparison.c",
        "tables/conversion.c",
        "tables/math.c",
    ],
    generator = "//loom/py/loom/gen/ops:c_tables_scalar_generator",
    textual_hdrs = ["ops.inc"],
    deps = [
        ":comparison",
        ":op_defs",
        "//loom/src/loom/error:emitter",
        "//loom/src/loom/error:error_defs",
        "//loom/src/loom/error:parameter",
        "//loom/src/loom/ir",
        "//loom/src/loom/ir:facts",
        "//loom/src/loom/ops:combining",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/rewrite:rewriter",
        "//loom/src/loom/util:fact_table",
        "//loom/src/loom/util:predicate_facts",
        "//runtime/src/iree/base/internal",
    ],
)

loom_cc_test(
    name = "compare_test",
    srcs = ["compare_test.cc"],
    deps = [
        ":scalar",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
