// RUN: pass canonicalize

// Both results retain the ordinary unsigned division facts while sharing one
// semantic operation.
func.def @unsigned_facts(%lhs0: i8, %rhs0: i8) -> (i64, i64, i64, i64) {
  %lhs = scalar.assume %lhs0 [range(%lhs0, 0, 63)] : i8
  %rhs = scalar.assume %rhs0 [range(%rhs0, 4, 8)] : i8
  %quotient, %remainder = scalar.divremui %lhs, %rhs : i8
  %quotient_minimum = test.fact_range_lo %quotient : i8 -> i64
  %quotient_maximum = test.fact_range_hi %quotient : i8 -> i64
  %remainder_minimum = test.fact_range_lo %remainder : i8 -> i64
  %remainder_maximum = test.fact_range_hi %remainder : i8 -> i64
  func.return %quotient_minimum, %quotient_maximum, %remainder_minimum, %remainder_maximum : i64, i64, i64, i64
}

// ----
func.def @unsigned_facts(%lhs0: i8, %rhs0: i8) -> (i64, i64, i64, i64) {
  %quotient_minimum = scalar.constant 0 : i64
  %quotient_maximum = scalar.constant 15 : i64
  %remainder_minimum = scalar.constant 0 : i64
  %remainder_maximum = scalar.constant 7 : i64
  func.return %quotient_minimum, %quotient_maximum, %remainder_minimum, %remainder_maximum : i64, i64, i64, i64
}

// ====

// Exact divisors expose the ordinary operations so their independent strength
// reductions retain priority over combined target selection.
func.def @exact_divisor(%value: i32) -> (i32, i32) {
  %divisor = scalar.constant 8 : i32
  %quotient, %remainder = scalar.divremui %value, %divisor : i32
  func.return %quotient, %remainder : i32, i32
}

// ----
func.def @exact_divisor(%value: i32) -> (i32, i32) {
  %10 = scalar.constant 3 : i32
  %quotient = scalar.shrui %value, %10 : i32
  %8 = scalar.constant 7 : i32
  %remainder = scalar.andi %value, %8 : i32
  func.return %quotient, %remainder : i32, i32
}

// ====

// A dead component does not force computation of the other architectural
// result on targets where standalone division is cheaper.
func.def @dead_remainder(%lhs: i64, %rhs: i64) -> (i64) {
  %quotient, %remainder = scalar.divremsi %lhs, %rhs : i64
  func.return %quotient : i64
}

// ----
func.def @dead_remainder(%lhs: i64, %rhs: i64) -> (i64) {
  %quotient = scalar.divsi %lhs, %rhs : i64
  func.return %quotient : i64
}

// ====

// Both paired quotient families retain dynamic size predicates independently
// of their remainder results.
func.def @paired_powers(%choose: i1) -> (i1, i1, i1, i1) {
  %c2 = scalar.constant 2 : i32
  %c4 = scalar.constant 4 : i32
  %c16 = scalar.constant 16 : i32
  %divisor = scf.select %choose, %c2, %c4 : i32
  %signed, %signed_remainder = scalar.divremsi %c16, %divisor : i32
  %unsigned, %unsigned_remainder = scalar.divremui %c16, %divisor : i32
  %sp = test.fact_power_of_two %signed : i32 -> i1
  %up = test.fact_power_of_two %unsigned : i32 -> i1
  %srp = test.fact_power_of_two %signed_remainder : i32 -> i1
  %urp = test.fact_power_of_two %unsigned_remainder : i32 -> i1
  func.return %sp, %up, %srp, %urp : i1, i1, i1, i1
}

// ----
func.def @paired_powers(%choose: i1) -> (i1, i1, i1, i1) {
  %sp = scalar.constant true : i1
  %up = scalar.constant true : i1
  %srp = scalar.constant false : i1
  %urp = scalar.constant false : i1
  func.return %sp, %up, %srp, %urp : i1, i1, i1, i1
}

// ====

// Exact quotients round toward zero for every sign pair and carrier. A paired
// quotient keeps the same facts as standalone division and remainder.
func.def @signed_constants() -> (i8, i16, i16, i32, i64, i64, i64) {
  %negative_byte = scalar.constant -17 : i8
  %divisor_byte = scalar.constant 5 : i8
  %negative_positive = scalar.divsi %negative_byte, %divisor_byte : i8
  %positive_half = scalar.constant 17 : i16
  %divisor_half = scalar.constant -5 : i16
  %positive_negative, %remainder = scalar.divremsi %positive_half, %divisor_half : i16
  %negative_word = scalar.constant -17 : i32
  %divisor_word = scalar.constant -5 : i32
  %negative_negative = scalar.divsi %negative_word, %divisor_word : i32
  %minimum = scalar.constant -9223372036854775808 : i64
  %maximum = scalar.constant 9223372036854775807 : i64
  %divisor_wide = scalar.constant 3 : i64
  %third = scalar.divsi %minimum, %divisor_wide : i64
  %zero = scalar.divsi %maximum, %minimum : i64
  %one = scalar.divsi %minimum, %minimum : i64
  func.return %negative_positive, %positive_negative, %remainder, %negative_negative, %third, %zero, %one : i8, i16, i16, i32, i64, i64, i64
}

// ----
func.def @signed_constants() -> (i8, i16, i16, i32, i64, i64, i64) {
  %negative_positive = scalar.constant -3 : i8
  %positive_negative = scalar.constant -3 : i16
  %remainder = scalar.constant 2 : i16
  %negative_negative = scalar.constant 3 : i32
  %third = scalar.constant -3074457345618258602 : i64
  %zero = scalar.constant 0 : i64
  %one = scalar.constant 1 : i64
  func.return %negative_positive, %positive_negative, %remainder, %negative_negative, %third, %zero, %one : i8, i16, i16, i32, i64, i64, i64
}
