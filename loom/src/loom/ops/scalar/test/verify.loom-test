// RUN: verify

// Dead poison computations are valid until their value reaches an observation
// boundary.
func.def @dead_poison_not_observed(%x: i32) {
  %p = scalar.poison : i32
  %dead = scalar.addi %p, %x : i32
  func.return
}

// ====

// Return-like boundaries observe poison escaping ordinary SSA propagation.
func.def @return_poison() -> (i32) {
  %p = scalar.poison : i32
  // ERROR@+1: TYPE/012 "poison" "observation boundary" "func.return"
  func.return %p : i32
}

// ====

// Integer constants require integer literal payloads.
func.def @integer_constant_value_kind() -> (i32) {
  // ERROR@+1: TYPE/005 "value"
  %c = scalar.constant 1.0 : i32
  func.return %c : i32
}

// ====

// Floating-point constants require floating-point literal payloads.
func.def @float_constant_value_kind() -> (f32) {
  // ERROR@+1: TYPE/005 "value"
  %c = scalar.constant 1 : f32
  func.return %c : f32
}

// ====

// Boolean integer literals must be 0 or 1.
func.def @boolean_constant_value_range() -> (i1) {
  // ERROR@+1: TYPE/005 "value"
  %c = scalar.constant 2 : i1
  func.return %c : i1
}

// ====

// Integer constant literals must fit the signed domain of their result type.
func.def @i8_constant_value_range() {
  // ERROR@+1: STRUCTURE/014 "value" "-129" "element type domain"
  %lo = scalar.constant -129 : i8
  // ERROR@+1: STRUCTURE/014 "value" "128" "element type domain"
  %hi = scalar.constant 128 : i8
  func.return
}

// ====

func.def @i16_constant_value_range() {
  // ERROR@+1: STRUCTURE/014 "value" "-32769" "element type domain"
  %lo = scalar.constant -32769 : i16
  // ERROR@+1: STRUCTURE/014 "value" "32768" "element type domain"
  %hi = scalar.constant 32768 : i16
  func.return
}

// ====

func.def @i32_constant_value_range() {
  // ERROR@+1: STRUCTURE/014 "value" "-2147483649" "element type domain"
  %lo = scalar.constant -2147483649 : i32
  // ERROR@+1: STRUCTURE/014 "value" "2147483648" "element type domain"
  %hi = scalar.constant 2147483648 : i32
  func.return
}

// ====

// Every signed boundary and both accepted i1 spellings compose in ordinary
// verified source IR.
func.def @valid_integer_constant_boundaries() {
  %false_bool = scalar.constant false : i1
  %true_bool = scalar.constant true : i1
  %false_i64 = scalar.constant 0 : i1
  %true_i64 = scalar.constant 1 : i1
  %i8_min = scalar.constant -128 : i8
  %i8_max = scalar.constant 127 : i8
  %i16_min = scalar.constant -32768 : i16
  %i16_max = scalar.constant 32767 : i16
  %i32_min = scalar.constant -2147483648 : i32
  %i32_max = scalar.constant 2147483647 : i32
  %i64_min = scalar.constant -9223372036854775808 : i64
  %i64_max = scalar.constant 9223372036854775807 : i64
  func.return
}

// ====

// Logical coordinate constants must be authored with index.constant so that
// address-domain values are structurally unambiguous.
func.def @index_constant_requires_index_dialect() -> (index) {
  // ERROR@+1: TYPE/004 "result" "index" "integer or floating-point scalar; use index.constant"
  %c = scalar.constant 0 : index
  func.return %c : index
}

// ====

// Physical byte offset constants use the index dialect too.
func.def @offset_constant_requires_index_dialect() -> (offset) {
  // ERROR@+1: TYPE/004 "result" "offset" "integer or floating-point scalar; use index.constant"
  %c = scalar.constant 0 : offset
  func.return %c : offset
}

// ====

// scalar.assume constrains scalar payload values; address-domain facts use
// index.assume.
func.def @assume_rejects_index_payload(%x: index) -> (i64) {
  // ERROR@+1: TYPE/004 "values[0]" "index" "integer or floating-point scalar; use index.assume"
  %r = scalar.assume %x [] : i64
  func.return %r : i64
}

// ====

func.def @assume_accepts_float_payload(%x: f32) -> (f32) {
  %r = scalar.assume %x [finite(%x)] : f32
  func.return %r : f32
}

// ====

func.def @assume_rejects_result_type_mismatch(%x: i32) -> (i64) {
  // ERROR@+1: TYPE/001 "values[0]" "i32" "results[0]" "i64"
  %r = scalar.assume %x [] : i64
  func.return %r : i64
}

// ====

func.def @assume_rejects_count_mismatch(%x: i64, %y: i64) -> (i64) {
  // ERROR@+1: STRUCTURE/013 "values" "2" "results" "1"
  %r = scalar.assume %x, %y [] : i64
  func.return %r : i64
}

// ====

// Scalar extensions and truncations encode a strict width direction in the
// operation name.
func.def @extf_wrong_width(%x: f32) {
  // ERROR@+1: TYPE/004 "result" "element bit width greater than input"
  %r = scalar.extf %x : f32 to f16
  func.return
}

// ====

// Equal-width float formats require a format-conversion operation rather than
// pretending that either format extends the other.
func.def @extf_equal_width(%x: f16) {
  // ERROR@+1: TYPE/004 "result" "element bit width greater than input"
  %r = scalar.extf %x : f16 to bf16
  func.return
}

// ====

func.def @fptrunc_wrong_width(%x: f16) {
  // ERROR@+1: TYPE/004 "result" "element bit width less than input"
  %r = scalar.fptrunc %x : f16 to f32
  func.return
}

// ====

func.def @fptrunc_equal_width(%x: bf16) {
  // ERROR@+1: TYPE/004 "result" "element bit width less than input"
  %r = scalar.fptrunc %x : bf16 to f16
  func.return
}

// ====

func.def @extsi_wrong_width(%x: i32) {
  // ERROR@+1: TYPE/004 "result" "element bit width greater than input"
  %r = scalar.extsi %x : i32 to i8
  func.return
}

// ====

func.def @extsi_equal_width(%x: i32) {
  // ERROR@+1: TYPE/004 "result" "element bit width greater than input"
  %r = scalar.extsi %x : i32 to i32
  func.return
}

// ====

func.def @extui_wrong_width(%x: i64) {
  // ERROR@+1: TYPE/004 "result" "element bit width greater than input"
  %r = scalar.extui %x : i64 to i16
  func.return
}

// ====

func.def @extui_equal_width(%x: i16) {
  // ERROR@+1: TYPE/004 "result" "element bit width greater than input"
  %r = scalar.extui %x : i16 to i16
  func.return
}

// ====

func.def @trunci_wrong_width(%x: i8) {
  // ERROR@+1: TYPE/004 "result" "element bit width less than input"
  %r = scalar.trunci %x : i8 to i32
  func.return
}

// ====

func.def @trunci_equal_width(%x: i64) {
  // ERROR@+1: TYPE/004 "result" "element bit width less than input"
  %r = scalar.trunci %x : i64 to i64
  func.return
}

// ====

// Scalar bitcasts preserve the complete payload bit count.
func.def @bitcast_width_mismatch(%x: f32) {
  // ERROR@+1: TYPE/004 "provably same total bit count as input"
  %r = scalar.bitcast %x : f32 to i64
  func.return
}

// ====

// Every legal direction and representation constraint composes in one normal
// verified program.
func.def @valid_scalar_cast_widths(%f16_value: f16, %i8_value: i8) -> (f16, i8, i32) {
  %f32_value = scalar.extf %f16_value : f16 to f32
  %f16_result = scalar.fptrunc %f32_value : f32 to f16
  %signed = scalar.extsi %i8_value : i8 to i32
  %unsigned = scalar.extui %i8_value : i8 to i32
  %i8_result = scalar.trunci %unsigned : i32 to i8
  %bits = scalar.bitcast %f32_value : f32 to i32
  func.return %f16_result, %i8_result, %bits : f16, i8, i32
}

// ====

// Bitfield extraction requires positive field widths.
func.def @bitfield_extract_zero_width(%x: i8) {
  // ERROR@+1: STRUCTURE/014 "width" "0" "positive bitfield width"
  %r = scalar.bitfield.extractu %x {offset = 0, width = 0} : i8 -> i32
  func.return
}

// ====

// Bitfield offsets are least-significant bit positions and cannot be negative.
func.def @bitfield_extract_negative_offset(%x: i8) {
  // ERROR@+1: STRUCTURE/014 "offset" "-1" "non-negative bit offset"
  %r = scalar.bitfield.extractu %x {offset = -1, width = 4} : i8 -> i32
  func.return
}

// ====

// Bitfield ranges must fit inside the source scalar.
func.def @bitfield_extract_range_overflow(%x: i8) {
  // ERROR@+1: STRUCTURE/014 "width" "4" "bitfield range within storage element width"
  %r = scalar.bitfield.extracts %x {offset = 6, width = 4} : i8 -> i32
  func.return
}

// ====

// Extract results must be wide enough to hold the selected field.
func.def @bitfield_extract_result_too_narrow(%x: i8) {
  // ERROR@+1: TYPE/004 "result" "element bit width at least width"
  %r = scalar.bitfield.extractu %x {offset = 0, width = 4} : i8 -> i1
  func.return
}

// ====

func.def @geluf_logistic_requires_scale(%x: f32) -> (f32) {
  // ERROR@+1: TYPE/005 {attr_name="scale", actual_kind="0", expected_kind="2"}
  %r = scalar.geluf<logistic> %x : f32
  func.return %r : f32
}

// ====

func.def @geluf_non_logistic_rejects_scale(%x: f32) -> (f32) {
  // ERROR@+1: TYPE/005 {attr_name="scale", actual_kind="2", expected_kind="0"}
  %r = scalar.geluf<erf> %x {scale = 1.702} : f32
  func.return %r : f32
}
