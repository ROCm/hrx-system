// RUN: pass canonicalize

// Wrapping can cross the sign boundary and destroys odd divisor factors.
func.def @wrapping_range(%x: i8) -> (i64, i64, i64) {
  %bounded = scalar.assume %x [range(%x, 30, 60), mul(%x, 6)] : i8
  %factor = scalar.constant 3 : i8
  %product = scalar.muli %bounded, %factor : i8
  %lo = test.fact_range_lo %product : i8 -> i64
  %hi = test.fact_range_hi %product : i8 -> i64
  %divisor = test.fact_divisor %product : i8 -> i64
  func.return %lo, %hi, %divisor : i64, i64, i64
}

// ----
func.def @wrapping_range(%x: i8) -> (i64, i64, i64) {
  %lo = scalar.constant -128 : i64
  %hi = scalar.constant 127 : i64
  %divisor = scalar.constant 2 : i64
  func.return %lo, %hi, %divisor : i64, i64, i64
}

// ====

// muli by constant 64 sets divisibility to 64.
func.def @muli_divisibility(%x: index) -> (i64) {
  %c64 = index.constant 64 : index
  %r = index.mul %x, %c64 : index
  %div = test.fact_divisor %r : index -> i64
  func.return %div : i64
}
// ----
func.def @muli_divisibility(%x: index) -> (i64) {
  %div = scalar.constant 64 : i64
  func.return %div : i64
}

// ====

// addi of two values with known divisors: gcd(64, 16) = 16.
func.def @addi_divisibility(%x: index, %y: index) -> (i64) {
  %c64 = index.constant 64 : index
  %c16 = index.constant 16 : index
  %a = index.mul %x, %c64 : index
  %b = index.mul %y, %c16 : index
  %r = index.add %a, %b : index
  %div = test.fact_divisor %r : index -> i64
  func.return %div : i64
}
// ----
func.def @addi_divisibility(%x: index, %y: index) -> (i64) {
  %div = scalar.constant 16 : i64
  func.return %div : i64
}

// ====

// Constant is exact: range_lo == range_hi == 42.
func.def @constant_exact(%x: i32) -> (i64, i64) {
  %c = scalar.constant 42 : i32
  %lo = test.fact_range_lo %c : i32 -> i64
  %hi = test.fact_range_hi %c : i32 -> i64
  func.return %lo, %hi : i64, i64
}
// ----
func.def @constant_exact(%x: i32) -> (i64, i64) {
  %lo = scalar.constant 42 : i64
  %hi = scalar.constant 42 : i64
  func.return %lo, %hi : i64, i64
}

// ====

// scalar.assume applies predicate facts to integer payload results.
func.def @assume_divisibility(%x: i64) -> (i64) {
  %x2 = scalar.assume %x [mul(%x, 32)] : i64
  %div = test.fact_divisor %x2 : i64 -> i64
  func.return %div : i64
}
// ----
func.def @assume_divisibility(%x: i64) -> (i64) {
  %div = scalar.constant 32 : i64
  func.return %div : i64
}

// ====

// scalar.assume consumes relational bounds from predicate values outside its
// checked alias list, including relations where the external value is first.
func.def @assume_relational_external_bounds(%value: i32, %upper0: i32, %lower0: i32) -> (i64, i64) {
  %upper = scalar.assume %upper0 [range(%upper0, 32, 2048)] : i32
  %lower = scalar.assume %lower0 [range(%lower0, -128, -32)] : i32
  %below = scalar.assume %value [lt(%value, %upper)] : i32
  %above = scalar.assume %value [lt(%lower, %value)] : i32
  %below_hi = test.fact_range_hi %below : i32 -> i64
  %above_lo = test.fact_range_lo %above : i32 -> i64
  func.return %below_hi, %above_lo : i64, i64
}
// ----
func.def @assume_relational_external_bounds(%value: i32, %upper0: i32, %lower0: i32) -> (i64, i64) {
  %below_hi = scalar.constant 2047 : i64
  %above_lo = scalar.constant -127 : i64
  func.return %below_hi, %above_lo : i64, i64
}

// ====

// A literal lower endpoint remains useful when the upper endpoint is a
// dynamically bounded scalar value.
func.def @assume_symbolic_range_bound(%value: i32, %upper0: i32) -> (i64, i64) {
  %upper = scalar.assume %upper0 [range(%upper0, 32, 2048)] : i32
  %bounded = scalar.assume %value [range(%value, 0, %upper)] : i32
  %bounded_lo = test.fact_range_lo %bounded : i32 -> i64
  %bounded_hi = test.fact_range_hi %bounded : i32 -> i64
  func.return %bounded_lo, %bounded_hi : i64, i64
}
// ----
func.def @assume_symbolic_range_bound(%value: i32, %upper0: i32) -> (i64, i64) {
  %bounded_lo = scalar.constant 0 : i64
  %bounded_hi = scalar.constant 2048 : i64
  func.return %bounded_lo, %bounded_hi : i64, i64
}

// ====

// remui is bounded by the non-negative dividend as well as by the dynamic
// divisor range.
func.def @remui_dynamic_divisor_uses_dividend_bound(%x0: i32, %d0: i32) -> (i64, i64) {
  %x = scalar.assume %x0 [range(%x0, 0, 63)] : i32
  %d = scalar.assume %d0 [range(%d0, 1, 1024)] : i32
  %r = scalar.remui %x, %d : i32
  %lo = test.fact_range_lo %r : i32 -> i64
  %hi = test.fact_range_hi %r : i32 -> i64
  func.return %lo, %hi : i64, i64
}
// ----
func.def @remui_dynamic_divisor_uses_dividend_bound(%x0: i32, %d0: i32) -> (i64, i64) {
  %lo = scalar.constant 0 : i64
  %hi = scalar.constant 63 : i64
  func.return %lo, %hi : i64, i64
}

// ====

// Unsigned remainder uses the declared width for an otherwise unknown
// dividend, proving the complete result range below a constant divisor.
func.def @remui_unknown_dividend_uses_declared_width(%value: i32) -> (i64, i64) {
  %count = scalar.constant 9 : i32
  %remainder = scalar.remui %value, %count : i32
  %minimum = test.fact_range_lo %remainder : i32 -> i64
  %maximum = test.fact_range_hi %remainder : i32 -> i64
  func.return %minimum, %maximum : i64, i64
}

// ----
func.def @remui_unknown_dividend_uses_declared_width(%value: i32) -> (i64, i64) {
  %minimum = scalar.constant 0 : i64
  %maximum = scalar.constant 8 : i64
  func.return %minimum, %maximum : i64, i64
}

// ====

// Negative signed representations retain their raw unsigned interpretation at
// each declared width.
func.def @divui_negative_representation_uses_declared_width() -> (i32, i32, i64, i64) {
  %narrow_value = scalar.constant -30 : i32
  %narrow_divisor = scalar.constant 5 : i32
  %narrow_quotient = scalar.divui %narrow_value, %narrow_divisor : i32
  %narrow_remainder = scalar.remui %narrow_value, %narrow_divisor : i32
  %wide_value = scalar.constant -30 : i64
  %wide_divisor = scalar.constant 5 : i64
  %wide_quotient = scalar.divui %wide_value, %wide_divisor : i64
  %wide_remainder = scalar.remui %wide_value, %wide_divisor : i64
  func.return %narrow_quotient, %narrow_remainder, %wide_quotient, %wide_remainder : i32, i32, i64, i64
}

// ----
func.def @divui_negative_representation_uses_declared_width() -> (i32, i32, i64, i64) {
  %narrow_quotient = scalar.constant 858993453 : i32
  %narrow_remainder = scalar.constant 1 : i32
  %wide_quotient = scalar.constant 3689348814741910317 : i64
  %wide_remainder = scalar.constant 1 : i64
  func.return %narrow_quotient, %narrow_remainder, %wide_quotient, %wide_remainder : i32, i32, i64, i64
}

// ====

// A negative i8 constant denotes an unsigned high-bit divisor. The quotient
// and remainder bounds remain representable in the signed fact domain.
func.def @unsigned_high_bit_divisor_uses_raw_bits(%value: i8) -> (i64, i64, i64, i64) {
  %divisor = scalar.constant -128 : i8
  %quotient = scalar.divui %value, %divisor : i8
  %remainder = scalar.remui %value, %divisor : i8
  %quotient_minimum = test.fact_range_lo %quotient : i8 -> i64
  %quotient_maximum = test.fact_range_hi %quotient : i8 -> i64
  %remainder_minimum = test.fact_range_lo %remainder : i8 -> i64
  %remainder_maximum = test.fact_range_hi %remainder : i8 -> i64
  func.return %quotient_minimum, %quotient_maximum, %remainder_minimum, %remainder_maximum : i64, i64, i64, i64
}

// ----
func.def @unsigned_high_bit_divisor_uses_raw_bits(%value: i8) -> (i64, i64, i64, i64) {
  %quotient_minimum = scalar.constant 0 : i64
  %quotient_maximum = scalar.constant 1 : i64
  %remainder_minimum = scalar.constant 0 : i64
  %remainder_maximum = scalar.constant 127 : i64
  func.return %quotient_minimum, %quotient_maximum, %remainder_minimum, %remainder_maximum : i64, i64, i64, i64
}

// ====

// addi of exact values produces exact result.
func.def @addi_exact() -> (i64) {
  %a = scalar.constant 10 : i32
  %b = scalar.constant 20 : i32
  %r = scalar.addi %a, %b : i32
  %lo = test.fact_range_lo %r : i32 -> i64
  func.return %lo : i64
}
// ----
func.def @addi_exact() -> (i64) {
  %lo = scalar.constant 30 : i64
  func.return %lo : i64
}

// ====

// Dynamic value has unknown facts.
func.def @dynamic_unknown(%x: i32) -> (i64, i64) {
  %lo = test.fact_range_lo %x : i32 -> i64
  %hi = test.fact_range_hi %x : i32 -> i64
  func.return %lo, %hi : i64, i64
}
// ----
func.def @dynamic_unknown(%x: i32) -> (i64, i64) {
  %lo = scalar.constant -2147483648 : i64
  %hi = scalar.constant 2147483647 : i64
  func.return %lo, %hi : i64, i64
}

// ====

// Constant is non-negative.
func.def @constant_non_negative() -> (i1) {
  %c = scalar.constant 42 : i32
  %nn = test.fact_non_negative %c : i32 -> i1
  func.return %nn : i1
}
// ----
func.def @constant_non_negative() -> (i1) {
  %nn = scalar.constant true : i1
  func.return %nn : i1
}

// ====

// Negative constant is not non-negative.
func.def @negative_not_non_negative() -> (i1) {
  %c = scalar.constant -5 : i32
  %nn = test.fact_non_negative %c : i32 -> i1
  func.return %nn : i1
}
// ----
func.def @negative_not_non_negative() -> (i1) {
  %nn = scalar.constant false : i1
  func.return %nn : i1
}

// ====

// Power of two constant.
func.def @power_of_two() -> (i1) {
  %c = scalar.constant 64 : i32
  %p2 = test.fact_power_of_two %c : i32 -> i1
  func.return %p2 : i1
}
// ----
func.def @power_of_two() -> (i1) {
  %p2 = scalar.constant true : i1
  func.return %p2 : i1
}

// ====

// Non-power-of-two constant.
func.def @not_power_of_two() -> (i1) {
  %c = scalar.constant 42 : i32
  %p2 = test.fact_power_of_two %c : i32 -> i1
  func.return %p2 : i1
}
// ----
func.def @not_power_of_two() -> (i1) {
  %p2 = scalar.constant false : i1
  func.return %p2 : i1
}

// ====

// fmai: divisibility propagation.
// a = x*8 (divisible by 8), b = 4 (const), c = y*16 (divisible by 16)
// a*b = divisible by 32, result = gcd(32, 16) = 16
func.def @fmai_divisibility(%x: index, %y: index) -> (i64) {
  %c8 = index.constant 8 : index
  %c4 = index.constant 4 : index
  %c16 = index.constant 16 : index
  %a = index.mul %x, %c8 : index
  %c = index.mul %y, %c16 : index
  %r = index.madd %a, %c4, %c : index
  %div = test.fact_divisor %r : index -> i64
  func.return %div : i64
}
// ----
func.def @fmai_divisibility(%x: index, %y: index) -> (i64) {
  %div = scalar.constant 16 : i64
  func.return %div : i64
}

// ====

// fmai: range propagation with exact values.
// 10*20 + 5 = 205, so range is exactly [205, 205]
func.def @fmai_range_exact() -> (i64, i64) {
  %a = scalar.constant 10 : i32
  %b = scalar.constant 20 : i32
  %c = scalar.constant 5 : i32
  %r = scalar.fmai %a, %b, %c : i32
  %lo = test.fact_range_lo %r : i32 -> i64
  %hi = test.fact_range_hi %r : i32 -> i64
  func.return %lo, %hi : i64, i64
}
// ----
func.def @fmai_range_exact() -> (i64, i64) {
  %lo = scalar.constant 205 : i64
  %hi = scalar.constant 205 : i64
  func.return %lo, %hi : i64, i64
}

// ====

// fmai: dynamic inputs - op remains (negative test).
func.def @fmai_dynamic(%a: i32, %b: i32, %c: i32) -> (i32) {
  %r = scalar.fmai %a, %b, %c : i32
  func.return %r : i32
}

// ====

// Signed wrap includes negative results; intersecting the mathematical range
// with the i32 domain would incorrectly discard them.
func.def @addi_wrapping_range(%value0: i32) -> (i64, i64) {
  %value = scalar.assume %value0 [range(%value0, 0, 2147483647)] : i32
  %c16 = scalar.constant 16 : i32
  %result = scalar.addi %value, %c16 : i32
  %minimum = test.fact_range_lo %result : i32 -> i64
  %maximum = test.fact_range_hi %result : i32 -> i64
  func.return %minimum, %maximum : i64, i64
}

// ----
func.def @addi_wrapping_range(%value0: i32) -> (i64, i64) {
  %minimum = scalar.constant -2147483648 : i64
  %maximum = scalar.constant 2147483647 : i64
  func.return %minimum, %maximum : i64, i64
}

// ====

func.def @subi_wrapping_range(%value0: i8) -> (i64, i64) {
  %value = scalar.assume %value0 [range(%value0, -128, 0)] : i8
  %c1 = scalar.constant 1 : i8
  %result = scalar.subi %value, %c1 : i8
  %minimum = test.fact_range_lo %result : i8 -> i64
  %maximum = test.fact_range_hi %result : i8 -> i64
  func.return %minimum, %maximum : i64, i64
}

// ----
func.def @subi_wrapping_range(%value0: i8) -> (i64, i64) {
  %minimum = scalar.constant -128 : i64
  %maximum = scalar.constant 127 : i64
  func.return %minimum, %maximum : i64, i64
}

// ====

// Reduction modulo 256 does not preserve divisibility by three.
func.def @muli_wrap_drops_odd_divisor(%value0: i8) -> (i64, i64, i64) {
  %value = scalar.assume %value0 [range(%value0, 40, 50)] : i8
  %c3 = scalar.constant 3 : i8
  %result = scalar.muli %value, %c3 : i8
  %minimum = test.fact_range_lo %result : i8 -> i64
  %maximum = test.fact_range_hi %result : i8 -> i64
  %divisor = test.fact_divisor %result : i8 -> i64
  func.return %minimum, %maximum, %divisor : i64, i64, i64
}

// ----
func.def @muli_wrap_drops_odd_divisor(%value0: i8) -> (i64, i64, i64) {
  %minimum = scalar.constant -128 : i64
  %maximum = scalar.constant 127 : i64
  %divisor = scalar.constant 1 : i64
  func.return %minimum, %maximum, %divisor : i64, i64, i64
}

// ====

func.def @fmai_wrap_drops_odd_divisor(%value0: i8) -> (i64, i64, i64) {
  %value = scalar.assume %value0 [range(%value0, 40, 50)] : i8
  %c3 = scalar.constant 3 : i8
  %c6 = scalar.constant 6 : i8
  %result = scalar.fmai %value, %c3, %c6 : i8
  %minimum = test.fact_range_lo %result : i8 -> i64
  %maximum = test.fact_range_hi %result : i8 -> i64
  %divisor = test.fact_divisor %result : i8 -> i64
  func.return %minimum, %maximum, %divisor : i64, i64, i64
}

// ----
func.def @fmai_wrap_drops_odd_divisor(%value0: i8) -> (i64, i64, i64) {
  %minimum = scalar.constant -128 : i64
  %maximum = scalar.constant 127 : i64
  %divisor = scalar.constant 1 : i64
  func.return %minimum, %maximum, %divisor : i64, i64, i64
}

// ====

func.def @negi_wrapping_range(%value0: i8) -> (i64, i64) {
  %value = scalar.assume %value0 [range(%value0, -128, -120)] : i8
  %result = scalar.negi %value : i8
  %minimum = test.fact_range_lo %result : i8 -> i64
  %maximum = test.fact_range_hi %result : i8 -> i64
  func.return %minimum, %maximum : i64, i64
