// ----
func.def @negi_wrapping_range(%value0: i8) -> (i64, i64) {
  %minimum = scalar.constant -128 : i64
  %maximum = scalar.constant 127 : i64
  func.return %minimum, %maximum : i64, i64
}

// ====

// The absolute value of INT64_MIN retains that bit pattern, which is negative.
func.def @absi_full_width_overflow(%value0: i64) -> (i64, i64) {
  %value = scalar.assume %value0 [range(%value0, -9223372036854775808, -1)] : i64
  %result = scalar.absi %value : i64
  %minimum = test.fact_range_lo %result : i64 -> i64
  %maximum = test.fact_range_hi %result : i64 -> i64
  func.return %minimum, %maximum : i64, i64
}

// ----
func.def @absi_full_width_overflow(%value0: i64) -> (i64, i64) {
  %minimum = scalar.constant -9223372036854775808 : i64
  %maximum = scalar.constant 9223372036854775807 : i64
  func.return %minimum, %maximum : i64, i64
}

// ====

func.def @addi_exact_wrap() -> (i64, i64) {
  %c120 = scalar.constant 120 : i8
  %c16 = scalar.constant 16 : i8
  %result = scalar.addi %c120, %c16 : i8
  %minimum = test.fact_range_lo %result : i8 -> i64
  %maximum = test.fact_range_hi %result : i8 -> i64
  func.return %minimum, %maximum : i64, i64
}

// ----
func.def @addi_exact_wrap() -> (i64, i64) {
  %minimum = scalar.constant -120 : i64
  %maximum = scalar.constant -120 : i64
  func.return %minimum, %maximum : i64, i64
}

// ====

func.def @addi_nonwrapping_range(%value0: i32) -> (i64, i64) {
  %value = scalar.assume %value0 [range(%value0, 0, 1024)] : i32
  %c16 = scalar.constant 16 : i32
  %result = scalar.addi %value, %c16 : i32
  %minimum = test.fact_range_lo %result : i32 -> i64
  %maximum = test.fact_range_hi %result : i32 -> i64
  func.return %minimum, %maximum : i64, i64
}

// ----
func.def @addi_nonwrapping_range(%value0: i32) -> (i64, i64) {
  %minimum = scalar.constant 16 : i64
  %maximum = scalar.constant 1040 : i64
  func.return %minimum, %maximum : i64, i64
}
