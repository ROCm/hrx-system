// RUN: pass canonicalize

// andi with mask 0xFFFC (all but bottom 2 bits): result divisible by 4.
func.def @andi_divisibility(%x: i32) -> (i64) {
  %mask = scalar.constant -4 : i32
  %r = scalar.andi %x, %mask : i32
  %div = test.fact_divisor %r : i32 -> i64
  func.return %div : i64
}
// ----
func.def @andi_divisibility(%x: i32) -> (i64) {
  %div = scalar.constant 4 : i64
  func.return %div : i64
}

// ====

// andi with non-negative mask: result is non-negative.
func.def @andi_non_negative(%x: i32) -> (i1) {
  %mask = scalar.constant 255 : i32
  %r = scalar.andi %x, %mask : i32
  %nn = test.fact_non_negative %r : i32 -> i1
  func.return %nn : i1
}
// ----
func.def @andi_non_negative(%x: i32) -> (i1) {
  %nn = scalar.constant true : i1
  func.return %nn : i1
}

// ====

// andi with small mask: result range bounded by mask.
func.def @andi_range_hi(%x: i32) -> (i64) {
  %mask = scalar.constant 15 : i32
  %r = scalar.andi %x, %mask : i32
  %hi = test.fact_range_hi %r : i32 -> i64
  func.return %hi : i64
}
// ----
func.def @andi_range_hi(%x: i32) -> (i64) {
  %hi = scalar.constant 15 : i64
  func.return %hi : i64
}

// ====

// ori with 1: result is definitely non-zero.
func.def @ori_non_zero(%x: i32) -> (i1) {
  %c1 = scalar.constant 1 : i32
  %r = scalar.ori %x, %c1 : i32
  %nz = test.fact_non_zero %r : i32 -> i1
  func.return %nz : i1
}
// ----
func.def @ori_non_zero(%x: i32) -> (i1) {
  %nz = scalar.constant true : i1
  func.return %nz : i1
}

// ====

// A zero-extended byte and one shifted high bit form a nine-bit table index.
func.def @ori_codebook_index(%low: i8, %high: i8) -> (i64, i64, i64, i64) {
  %low_word = scalar.extui %low : i8 to i32
  %high_word = scalar.extui %high : i8 to i32
  %high_mask = scalar.constant 1 : i32
  %high_shift = scalar.constant 8 : i32
  %high_bit = scalar.andi %high_word, %high_mask : i32
  %high_code = scalar.shli %high_bit, %high_shift : i32
  %code = scalar.ori %low_word, %high_code : i32
  %low_hi = test.fact_range_hi %low_word : i32 -> i64
  %high_hi = test.fact_range_hi %high_code : i32 -> i64
  %code_lo = test.fact_range_lo %code : i32 -> i64
  %code_hi = test.fact_range_hi %code : i32 -> i64
  func.return %low_hi, %high_hi, %code_lo, %code_hi : i64, i64, i64, i64
}
// ----
func.def @ori_codebook_index(%low: i8, %high: i8) -> (i64, i64, i64, i64) {
  %low_hi = scalar.constant 255 : i64
  %high_hi = scalar.constant 256 : i64
  %code_lo = scalar.constant 0 : i64
  %code_hi = scalar.constant 511 : i64
  func.return %low_hi, %high_hi, %code_lo, %code_hi : i64, i64, i64, i64
}

// ====

// Nonzero survives without an exact operand, even when its range includes zero.
func.def @ori_predicate_nonzero(%lhs: i32, %rhs: i32) -> (i1, i1) {
  %nonzero = scalar.assume %lhs [ne(%lhs, 0)] : i32
  %signed = scalar.ori %rhs, %nonzero : i32
  %bounded = scalar.assume %nonzero [range(%nonzero, 0, 255)] : i32
  %mask = scalar.constant 256 : i32
  %high = scalar.andi %rhs, %mask : i32
  %unsigned = scalar.ori %bounded, %high : i32
  %signed_nonzero = test.fact_non_zero %signed : i32 -> i1
  %unsigned_nonzero = test.fact_non_zero %unsigned : i32 -> i1
  func.return %signed_nonzero, %unsigned_nonzero : i1, i1
}
// ----
func.def @ori_predicate_nonzero(%lhs: i32, %rhs: i32) -> (i1, i1) {
  %signed_nonzero = scalar.constant true : i1
  %unsigned_nonzero = scalar.constant true : i1
  func.return %signed_nonzero, %unsigned_nonzero : i1, i1
}

// ====

// shli by 4: divisor multiplied by 16.
func.def @shli_divisibility(%x: i32) -> (i64) {
  %shift = scalar.constant 4 : i32
  %r = scalar.shli %x, %shift : i32
  %div = test.fact_divisor %r : i32 -> i64
  func.return %div : i64
}
// ----
func.def @shli_divisibility(%x: i32) -> (i64) {
  %div = scalar.constant 16 : i64
  func.return %div : i64
}

// ====

// shli by 4 of a value with divisor 8: divisor = 8 * 16 = 128.
func.def @shli_compound_divisibility(%x: i32) -> (i64) {
  %c8 = scalar.constant 8 : i32
  %aligned = scalar.muli %x, %c8 : i32
  %shift = scalar.constant 4 : i32
  %r = scalar.shli %aligned, %shift : i32
  %div = test.fact_divisor %r : i32 -> i64
  func.return %div : i64
}
// ----
func.def @shli_compound_divisibility(%x: i32) -> (i64) {
  %div = scalar.constant 128 : i64
  func.return %div : i64
}

// ====

// shli can move masked bits into the sign bit; facts must not prove the
// shifted value non-negative or rewrite the following arithmetic shift.
func.def @shli_sign_bit_preserves_arithmetic_shift(%x: i32) -> (i32, i1) {
  %mask = scalar.constant 255 : i32
  %low = scalar.andi %x, %mask : i32
  %shift = scalar.constant 24 : i32
  %shifted = scalar.shli %low, %shift : i32
  %signed = scalar.shrsi %shifted, %shift : i32
  %nn = test.fact_non_negative %shifted : i32 -> i1
  func.return %signed, %nn : i32, i1
}
// ----
func.def @shli_sign_bit_preserves_arithmetic_shift(%x: i32) -> (i32, i1) {
  %mask = scalar.constant 255 : i32
  %low = scalar.andi %x, %mask : i32
  %shift = scalar.constant 24 : i32
  %shifted = scalar.shli %low, %shift : i32
  %signed = scalar.shrsi %shifted, %shift : i32
  %nn = scalar.constant false : i1
  func.return %signed, %nn : i32, i1
}

// ====

// shrui by 3 of a value with divisor 16: divisor = 16/8 = 2.
func.def @shrui_divisibility(%x: i32) -> (i64) {
  %c16 = scalar.constant 16 : i32
  %aligned = scalar.muli %x, %c16 : i32
  %shift = scalar.constant 3 : i32
  %r = scalar.shrui %aligned, %shift : i32
  %div = test.fact_divisor %r : i32 -> i64
  func.return %div : i64
}
// ----
func.def @shrui_divisibility(%x: i32) -> (i64) {
  %div = scalar.constant 2 : i64
  func.return %div : i64
}

// ====

// shrui of non-negative value is non-negative.
func.def @shrui_non_negative(%x: i32) -> (i1) {
  %c = scalar.constant 100 : i32
  %shift = scalar.constant 2 : i32
  %r = scalar.shrui %c, %shift : i32
  %nn = test.fact_non_negative %r : i32 -> i1
  func.return %nn : i1
}
// ----
func.def @shrui_non_negative(%x: i32) -> (i1) {
  %nn = scalar.constant true : i1
  func.return %nn : i1
}

// ====

// Unsigned bitfield extraction bounds a dynamic byte to [0, 255].
func.def @bitfield_extractu_range(%x: i32) -> (i64, i64) {
  %r = scalar.bitfield.extractu %x {offset = 8, width = 8} : i32 -> i32
  %lo = test.fact_range_lo %r : i32 -> i64
  %hi = test.fact_range_hi %r : i32 -> i64
  func.return %lo, %hi : i64, i64
}
// ----
func.def @bitfield_extractu_range(%x: i32) -> (i64, i64) {
  %lo = scalar.constant 0 : i64
  %hi = scalar.constant 255 : i64
  func.return %lo, %hi : i64, i64
}

// ====

// Signed bitfield extraction bounds a dynamic byte to [-128, 127].
func.def @bitfield_extracts_range(%x: i32) -> (i64, i64) {
  %r = scalar.bitfield.extracts %x {offset = 16, width = 8} : i32 -> i32
  %lo = test.fact_range_lo %r : i32 -> i64
  %hi = test.fact_range_hi %r : i32 -> i64
  func.return %lo, %hi : i64, i64
}
// ----
func.def @bitfield_extracts_range(%x: i32) -> (i64, i64) {
  %lo = scalar.constant -128 : i64
  %hi = scalar.constant 127 : i64
  func.return %lo, %hi : i64, i64
}

// ====

// Nonzero predicates bound both zero counts below the declared width and
// population count above zero, including when the signed range spans zero.
func.def @nonzero_bit_counts_i8(%input: i8) -> (i64, i64, i64, i64) {
  %value = scalar.assume %input [ne(%input, 0)] : i8
  %leading = scalar.ctlzi %value : i8
  %trailing = scalar.cttzi %value : i8
  %population = scalar.ctpopi %value : i8
  %leading_hi = test.fact_range_hi %leading : i8 -> i64
  %trailing_hi = test.fact_range_hi %trailing : i8 -> i64
  %population_lo = test.fact_range_lo %population : i8 -> i64
  %population_hi = test.fact_range_hi %population : i8 -> i64
  func.return %leading_hi, %trailing_hi, %population_lo, %population_hi : i64, i64, i64, i64
}
// ----
func.def @nonzero_bit_counts_i8(%input: i8) -> (i64, i64, i64, i64) {
  %leading_hi = scalar.constant 7 : i64
  %trailing_hi = scalar.constant 7 : i64
  %population_lo = scalar.constant 1 : i64
  %population_hi = scalar.constant 8 : i64
  func.return %leading_hi, %trailing_hi, %population_lo, %population_hi : i64, i64, i64, i64
}

// ====

func.def @nonzero_bit_counts_i64(%input: i64) -> (i64, i64, i64, i64) {
  %value = scalar.assume %input [ne(%input, 0)] : i64
  %leading = scalar.ctlzi %value : i64
  %trailing = scalar.cttzi %value : i64
  %population = scalar.ctpopi %value : i64
  %leading_hi = test.fact_range_hi %leading : i64 -> i64
  %trailing_hi = test.fact_range_hi %trailing : i64 -> i64
  %population_lo = test.fact_range_lo %population : i64 -> i64
  %population_hi = test.fact_range_hi %population : i64 -> i64
  func.return %leading_hi, %trailing_hi, %population_lo, %population_hi : i64, i64, i64, i64
}
// ----
func.def @nonzero_bit_counts_i64(%input: i64) -> (i64, i64, i64, i64) {
  %leading_hi = scalar.constant 63 : i64
  %trailing_hi = scalar.constant 63 : i64
  %population_lo = scalar.constant 1 : i64
  %population_hi = scalar.constant 64 : i64
  func.return %leading_hi, %trailing_hi, %population_lo, %population_hi : i64, i64, i64, i64
}

// ====

// Unconstrained inputs can be zero, so zero counts must retain the full width.
func.def @unknown_bit_counts_i32(%value: i32) -> (i64, i64, i64) {
  %leading = scalar.ctlzi %value : i32
  %trailing = scalar.cttzi %value : i32
  %population = scalar.ctpopi %value : i32
  %leading_hi = test.fact_range_hi %leading : i32 -> i64
  %trailing_hi = test.fact_range_hi %trailing : i32 -> i64
  %population_lo = test.fact_range_lo %population : i32 -> i64
  func.return %leading_hi, %trailing_hi, %population_lo : i64, i64, i64
}
// ----
func.def @unknown_bit_counts_i32(%value: i32) -> (i64, i64, i64) {
  %leading_hi = scalar.constant 32 : i64
  %trailing_hi = scalar.constant 32 : i64
  %population_lo = scalar.constant 0 : i64
  func.return %leading_hi, %trailing_hi, %population_lo : i64, i64, i64
}

// ====

// RUN: pass canonicalize,canonicalize

// A guarded scan needs no extra assumption to produce a valid 32-lane index.
// The first canonicalization retains the branch fact on the operand; the next
// consumes the tightened bit-count range.
func.def @guarded_first_set_bit(%mask: i32) -> (i32, i1) {
  %c0 = scalar.constant 0 : i32
  %width = scalar.constant 32 : i32
  %has_bit = scalar.cmpi ne, %mask, %c0 : i32
  %lane = scf.if %has_bit -> (i32) {
    %first = scalar.cttzi %mask : i32
    scf.yield %first : i32
  } else {
    scf.yield %c0 : i32
  }
  %bounded = scalar.cmpi ult, %lane, %width : i32
  func.return %lane, %bounded : i32, i1
}
// ----
func.def @guarded_first_set_bit(%mask: i32) -> (i32, i1) {
  %c0 = scalar.constant 0 : i32
  %has_bit = scalar.cmpi ne, %mask, %c0 : i32
  %lane = scf.if %has_bit -> (i32) {
    %9 = scalar.assume %mask [ne(%mask, 0)] : i32
    %first = scalar.cttzi %9 : i32
    scf.yield %first : i32
  } else {
    scf.yield %c0 : i32
  }
  %bounded = scalar.constant true : i1
  func.return %lane, %bounded : i32, i1
}

