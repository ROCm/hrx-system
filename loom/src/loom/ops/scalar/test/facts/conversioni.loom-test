// RUN: pass canonicalize

// Integer conversions cannot produce NaNs. F32 covers the complete i32 domain,
// while narrower formats may still overflow.
func.def @integer_to_float_classes(%signed: i32, %unsigned: i64) -> (i1, i1, i1, i1) {
  %wide = scalar.sitofp %signed : i32 to f32
  %half = scalar.uitofp %unsigned : i64 to f16
  %wide_nan = scalar.isnanf %wide : f32
  %wide_finite = scalar.isfinitef %wide : f32
  %half_nan = scalar.isnanf %half : f16
  %half_inf = scalar.isinff %half : f16
  func.return %wide_nan, %wide_finite, %half_nan, %half_inf : i1, i1, i1, i1
}

// ----
func.def @integer_to_float_classes(%signed: i32, %unsigned: i64) -> (i1, i1, i1, i1) {
  %half = scalar.uitofp %unsigned : i64 to f16
  %wide_nan = scalar.constant false : i1
  %wide_finite = scalar.constant true : i1
  %half_nan = scalar.constant false : i1
  %half_inf = scalar.isinff %half : f16
  func.return %wide_nan, %wide_finite, %half_nan, %half_inf : i1, i1, i1, i1
}

// ====

// Complete byte domains convert exactly to F16, BF16, F32, and F64. The
// result facts retain that property even though each runtime value is dynamic.
func.def @integer_to_float_exact_formats(%signed: i8, %unsigned: i8) -> (i64, i64) {
  %signed_float = scalar.sitofp %signed : i8 to f32
  %unsigned_float = scalar.uitofp %unsigned : i8 to f32
  %signed_types = test.fact_exact_float_types %signed_float : f32 -> i64
  %unsigned_types = test.fact_exact_float_types %unsigned_float : f32 -> i64
  func.return %signed_types, %unsigned_types : i64, i64
}

// ----
func.def @integer_to_float_exact_formats(%signed: i8, %unsigned: i8) -> (i64, i64) {
  %signed_types = scalar.constant 15360 : i64
  %unsigned_types = scalar.constant 15360 : i64
  func.return %signed_types, %unsigned_types : i64, i64
}

// ====

// Range and divisibility facts jointly prove exact narrow representations.
// Without divisibility the same I16 interval requires F32 or F64.
func.def @integer_to_float_exact_formats_from_constraints(%input: i16) -> (i64, i64) {
  %bounded = scalar.assume %input [range(%input, -32768, 32767)] : i16
  %aligned = scalar.assume %bounded [multiple_of(%bounded, 256)] : i16
  %unconstrained_float = scalar.sitofp %bounded : i16 to f32
  %aligned_float = scalar.sitofp %aligned : i16 to f32
  %unconstrained_types = test.fact_exact_float_types %unconstrained_float : f32 -> i64
  %aligned_types = test.fact_exact_float_types %aligned_float : f32 -> i64
  func.return %unconstrained_types, %aligned_types : i64, i64
}

// ----
func.def @integer_to_float_exact_formats_from_constraints(%input: i16) -> (i64, i64) {
  %unconstrained_types = scalar.constant 12288 : i64
  %aligned_types = scalar.constant 15360 : i64
  func.return %unconstrained_types, %aligned_types : i64, i64
}

// ====

// Signed extension interprets the one i1 bit as a two's-complement sign bit.
func.def @extsi_i1_true() -> (i64, i64) {
  %c = scalar.constant 1 : i1
  %r = scalar.extsi %c : i1 to i32
  %lo = test.fact_range_lo %r : i32 -> i64
  %hi = test.fact_range_hi %r : i32 -> i64
  func.return %lo, %hi : i64, i64
}
// ----
func.def @extsi_i1_true() -> (i64, i64) {
  %lo = scalar.constant -1 : i64
  %hi = scalar.constant -1 : i64
  func.return %lo, %hi : i64, i64
}

// ====

// A dynamic i1 sign extension can produce only zero or negative one.
func.def @extsi_dynamic_i1_domain(%x: i1) -> (i64, i64) {
  %r = scalar.extsi %x : i1 to i32
  %lo = test.fact_range_lo %r : i32 -> i64
  %hi = test.fact_range_hi %r : i32 -> i64
  func.return %lo, %hi : i64, i64
}
// ----
func.def @extsi_dynamic_i1_domain(%x: i1) -> (i64, i64) {
  %lo = scalar.constant -1 : i64
  %hi = scalar.constant 0 : i64
  func.return %lo, %hi : i64, i64
}

// ====

// extui reinterprets the source bits as unsigned before widening.
func.def @extui_negative_exact() -> (i64, i64) {
  %c = scalar.constant -1 : i8
  %r = scalar.extui %c : i8 to i32
  %lo = test.fact_range_lo %r : i32 -> i64
  %hi = test.fact_range_hi %r : i32 -> i64
  func.return %lo, %hi : i64, i64
}
// ----
func.def @extui_negative_exact() -> (i64, i64) {
  %lo = scalar.constant 255 : i64
  %hi = scalar.constant 255 : i64
  func.return %lo, %hi : i64, i64
}

// ====

// trunci exact facts wrap to the destination width and signed domain.
func.def @trunci_exact_wraps_positive() -> (i64, i64) {
  %c = scalar.constant 300 : i32
  %r = scalar.trunci %c : i32 to i8
  %lo = test.fact_range_lo %r : i8 -> i64
  %hi = test.fact_range_hi %r : i8 -> i64
  func.return %lo, %hi : i64, i64
}
// ----
func.def @trunci_exact_wraps_positive() -> (i64, i64) {
  %lo = scalar.constant 44 : i64
  %hi = scalar.constant 44 : i64
  func.return %lo, %hi : i64, i64
}

// ====

// trunci exact facts sign-extend the destination bit pattern.
func.def @trunci_exact_wraps_negative() -> (i64, i64) {
  %c = scalar.constant 200 : i32
  %r = scalar.trunci %c : i32 to i8
  %lo = test.fact_range_lo %r : i8 -> i64
  %hi = test.fact_range_hi %r : i8 -> i64
  func.return %lo, %hi : i64, i64
}
// ----
func.def @trunci_exact_wraps_negative() -> (i64, i64) {
  %lo = scalar.constant -56 : i64
  %hi = scalar.constant -56 : i64
  func.return %lo, %hi : i64, i64
}

// ====

// Dynamic extui of a full i8 domain is bounded to the unsigned source domain.
func.def @extui_dynamic_i8_domain(%x: i8) -> (i64, i64) {
  %r = scalar.extui %x : i8 to i32
  %lo = test.fact_range_lo %r : i32 -> i64
  %hi = test.fact_range_hi %r : i32 -> i64
  func.return %lo, %hi : i64, i64
}
// ----
func.def @extui_dynamic_i8_domain(%x: i8) -> (i64, i64) {
  %lo = scalar.constant 0 : i64
  %hi = scalar.constant 255 : i64
  func.return %lo, %hi : i64, i64
}

// ====

// Dynamic trunci to i8 may wrap to any value in the signed result domain.
func.def @trunci_dynamic_i8_domain(%x: i32) -> (i64, i64) {
  %r = scalar.trunci %x : i32 to i8
  %lo = test.fact_range_lo %r : i8 -> i64
  %hi = test.fact_range_hi %r : i8 -> i64
  func.return %lo, %hi : i64, i64
}
// ----
func.def @trunci_dynamic_i8_domain(%x: i32) -> (i64, i64) {
  %lo = scalar.constant -128 : i64
  %hi = scalar.constant 127 : i64
  func.return %lo, %hi : i64, i64
}

// ====

// Truncation preserves range facts when assumptions prove the value fits.
func.def @trunci_value_preserving_range(%x: i32) -> (i64, i64) {
  %bounded = scalar.assume %x [range(%x, 0, 100)] : i32
  %r = scalar.trunci %bounded : i32 to i8
  %lo = test.fact_range_lo %r : i8 -> i64
  %hi = test.fact_range_hi %r : i8 -> i64
  func.return %lo, %hi : i64, i64
}
// ----
func.def @trunci_value_preserving_range(%x: i32) -> (i64, i64) {
  %lo = scalar.constant 0 : i64
  %hi = scalar.constant 100 : i64
  func.return %lo, %hi : i64, i64
}

// ====

// Float-to-integer validity is determined after truncation toward zero.
func.def @fptosi_truncates_before_checking_range() -> (i8) {
  %c = scalar.constant -128.75 : f32
  %r = scalar.fptosi %c : f32 to i8
  func.return %r : i8
}
// ----
func.def @fptosi_truncates_before_checking_range() -> (i8) {
  %r = scalar.constant -128 : i8
  func.return %r : i8
}

// ====

// Negative fractions truncate to zero before unsigned range checking.
func.def @fptoui_negative_fraction_is_zero() -> (i16) {
  %c = scalar.constant -0.75 : f64
  %r = scalar.fptoui %c : f64 to i16
  func.return %r : i16
}
// ----
func.def @fptoui_negative_fraction_is_zero() -> (i16) {
  %r = scalar.constant 0 : i16
  func.return %r : i16
}

// ====

// Unsigned conversion facts preserve destination bits in the signed literal
// representation used by scalar constants.
func.def @fptoui_preserves_high_destination_bit() -> (i8, i64) {
  %byte = scalar.constant 200.75 : f32
  %byte_result = scalar.fptoui %byte : f32 to i8
  %wide = scalar.constant 9.2233720368547758e+18 : f64
  %wide_result = scalar.fptoui %wide : f64 to i64
  func.return %byte_result, %wide_result : i8, i64
}
// ----
func.def @fptoui_preserves_high_destination_bit() -> (i8, i64) {
  %byte_result = scalar.constant -56 : i8
  %wide_result = scalar.constant -9223372036854775808 : i64
  func.return %byte_result, %wide_result : i8, i64
}

// ====

// Invalid exact conversions remain non-exact instead of manufacturing a
// host-dependent integer fact. Their results still inhabit the scalar type's
// domain.
func.def @fptosi_nan_is_unknown() -> (i64, i64) {
  %negative = scalar.constant -1.0 : f32
  %nan = scalar.sqrtf %negative : f32
  %r = scalar.fptosi %nan : f32 to i8
  %lo = test.fact_range_lo %r : i8 -> i64
  %hi = test.fact_range_hi %r : i8 -> i64
  func.return %lo, %hi : i64, i64
}
// ----
func.def @fptosi_nan_is_unknown() -> (i64, i64) {
  %lo = scalar.constant -128 : i64
  %hi = scalar.constant 127 : i64
  func.return %lo, %hi : i64, i64
}

// ====

// Unsigned extension and address widening are the same bit-preserving map.
// A later truncation can produce zero and must discard the guarantee.
func.def @nonzero_widening(%input: i8, %wide_input: i16) -> (i1, i1, i1, i1, i64, i64) {
  %nonzero = scalar.assume %input [range(%input, -8, 8), ne(%input, 0), multiple_of(%input, 2)] : i8
  %unsigned = scalar.extui %nonzero : i8 to i16
  %signed = scalar.extsi %nonzero : i8 to i32
  %offset = index.cast %nonzero : i8 to offset
  %index = index.cast %offset : offset to index
  %wide = scalar.assume %wide_input [range(%wide_input, 1, 256)] : i16
  %truncated = scalar.trunci %wide : i16 to i8
  %unsigned_nonzero = test.fact_non_zero %unsigned : i16 -> i1
  %signed_nonzero = test.fact_non_zero %signed : i32 -> i1
  %index_nonzero = test.fact_non_zero %index : index -> i1
  %truncated_nonzero = test.fact_non_zero %truncated : i8 -> i1
  %minimum = test.fact_range_lo %index : index -> i64
  %divisor = test.fact_divisor %index : index -> i64
  func.return %unsigned_nonzero, %signed_nonzero, %index_nonzero, %truncated_nonzero, %minimum, %divisor : i1, i1, i1, i1, i64, i64
}

// ----
func.def @nonzero_widening(%input: i8, %wide_input: i16) -> (i1, i1, i1, i1, i64, i64) {
  %unsigned_nonzero = scalar.constant true : i1
  %signed_nonzero = scalar.constant true : i1
  %index_nonzero = scalar.constant true : i1
  %truncated_nonzero = scalar.constant false : i1
  %minimum = scalar.constant 1 : i64
  %divisor = scalar.constant 2 : i64
  func.return %unsigned_nonzero, %signed_nonzero, %index_nonzero, %truncated_nonzero, %minimum, %divisor : i1, i1, i1, i1, i64, i64
}
