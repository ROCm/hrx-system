// RUN: pass canonicalize

// Truncating back to the original width after extension returns the source.
func.def @integer_trunc_extension_roundtrip(%x: i8) -> (i8) {
  %wide = scalar.extui %x : i8 to i32
  %back = scalar.trunci %wide : i32 to i8
  func.return %back : i8
}
// ----
func.def @integer_trunc_extension_roundtrip(%x: i8) -> (i8) {
  func.return %x : i8
}

// ====

// Bitcast round-trips cancel when the final type is the original type.
func.def @bitcast_roundtrip(%x: f32) -> (f32) {
  %bits = scalar.bitcast %x : f32 to i32
  %roundtrip = scalar.bitcast %bits : i32 to f32
  func.return %roundtrip : f32
}
// ----
func.def @bitcast_roundtrip(%x: f32) -> (f32) {
  func.return %x : f32
}

// ====

// Float extension and truncation round-trips collapse through the source.
func.def @float_resize_roundtrip(%x: f16) -> (f16) {
  %wide = scalar.extf %x : f16 to f32
  %back = scalar.fptrunc %wide : f32 to f16
  func.return %back : f16
}
// ----
func.def @float_resize_roundtrip(%x: f16) -> (f16) {
  func.return %x : f16
}

// ====

// Other users can observe a relaxed widening's flushed value. Exact widening
// can be canceled even when the narrowing permits flushing its result.
func.def @relaxed_float_resize_roundtrip(%x: f16) -> (f32, f16, f16) {
  %wide_input = scalar.extf<daz> %x : f16 to f32
  %back_input = scalar.fptrunc %wide_input : f32 to f16
  %wide_result = scalar.extf %x : f16 to f32
  %back_result = scalar.fptrunc<ftz> %wide_result : f32 to f16
  func.return %wide_input, %back_input, %back_result : f32, f16, f16
}
// ----
func.def @relaxed_float_resize_roundtrip(%x: f16) -> (f32, f16, f16) {
  %wide_input = scalar.extf<daz> %x : f16 to f32
  %back_input = scalar.fptrunc %wide_input : f32 to f16
  func.return %wide_input, %back_input, %x : f32, f16, f16
}

// ====

// Both input and result flushing permissions allow an exact round trip.
func.def @relaxed_narrowing_permissions(%bfloat: bf16, %single: f32) -> (bf16, f32) {
  %wide_bfloat = scalar.extf %bfloat : bf16 to f32
  %back_bfloat = scalar.fptrunc<daz> %wide_bfloat : f32 to bf16
  %wide_single = scalar.extf %single : f32 to f64
  %back_single = scalar.fptrunc<daz|ftz> %wide_single : f64 to f32
  func.return %back_bfloat, %back_single : bf16, f32
}
// ----
func.def @relaxed_narrowing_permissions(%bfloat: bf16, %single: f32) -> (bf16, f32) {
  func.return %bfloat, %single : bf16, f32
}

// ====

// Floating-point truncation chains must not collapse: double rounding can be
// observably different from one direct truncation.
func.def @float_truncation_chain_preserves_rounding(%x: f64) -> (f16) {
  %f32 = scalar.fptrunc %x : f64 to f32
  %f16 = scalar.fptrunc %f32 : f32 to f16
  func.return %f16 : f16
}
// ----
func.def @float_truncation_chain_preserves_rounding(%x: f64) -> (f16) {
  %f32 = scalar.fptrunc %x : f64 to f32
  %f16 = scalar.fptrunc %f32 : f32 to f16
  func.return %f16 : f16
}
