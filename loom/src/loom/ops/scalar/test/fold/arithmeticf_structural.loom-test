// RUN: pass canonicalize

func.def @add_sub_nsz_identities(%x: f32) -> (f32, f32, f32, f32) {
  %c0 = scalar.constant 0.0 : f32
  %add_lhs = scalar.addf<nsz> %c0, %x : f32
  %add_rhs = scalar.addf<nsz> %x, %c0 : f32
  %sub_rhs = scalar.subf<nsz> %x, %c0 : f32
  %sub_lhs = scalar.subf<nnan|nsz> %c0, %x : f32
  func.return %add_lhs, %add_rhs, %sub_rhs, %sub_lhs : f32, f32, f32, f32
}

// ----
func.def @add_sub_nsz_identities(%x: f32) -> (f32, f32, f32, f32) {
  %sub_lhs = scalar.negf<nnan|nsz> %x : f32
  func.return %x, %x, %x, %sub_lhs : f32, f32, f32, f32
}

// ====

func.def @strict_add_zero_preserves_signed_zero(%x: f32) -> (f32) {
  %c0 = scalar.constant 0.0 : f32
  %r = scalar.addf %x, %c0 : f32
  func.return %r : f32
}

// ====

func.def @mul_div_identities(%x: f32) -> (f32, f32, f32) {
  %c0 = scalar.constant 0.0 : f32
  %c1 = scalar.constant 1.0 : f32
  %mul = scalar.mulf %x, %c1 : f32
  %div = scalar.divf %x, %c1 : f32
  %zeroed = scalar.mulf<nnan|ninf|nsz> %x, %c0 : f32
  func.return %mul, %div, %zeroed : f32, f32, f32
}

// ----
func.def @mul_div_identities(%x: f32) -> (f32, f32, f32) {
  %zeroed = scalar.constant 0.0 : f32
  func.return %x, %x, %zeroed : f32, f32, f32
}

// ====

func.def @divf_arcp_constant_rhs_to_reciprocal_mulf(%x: f32) -> (f32, f32) {
  %scale = scalar.constant 127.0 : f32
  %strict = scalar.divf %x, %scale : f32
  %fast = scalar.divf<nnan|ninf|nsz|arcp> %x, %scale : f32
  func.return %strict, %fast : f32, f32
}

// ----
func.def @divf_arcp_constant_rhs_to_reciprocal_mulf(%x: f32) -> (f32, f32) {
  %scale = scalar.constant 127.0 : f32
  %strict = scalar.divf %x, %scale : f32
  %6 = scalar.constant 0.007874015718698502 : f32
  %fast = scalar.mulf<nnan|ninf|nsz|arcp> %x, %6 : f32
  func.return %strict, %fast : f32, f32
}

// ====

func.def @mulf_absorbs_negated_input_constant(%x: f32) -> (f32) {
  %c0 = scalar.constant 0.0 : f32
  %neg = scalar.subf<nnan|nsz> %c0, %x : f32
  %scale = scalar.constant 1.4426950408889634 : f32
  %scaled = scalar.mulf<nnan|ninf|nsz> %neg, %scale : f32
  func.return %scaled : f32
}

// ----
func.def @mulf_absorbs_negated_input_constant(%x: f32) -> (f32) {
  %7 = scalar.constant -1.4426950216293335 : f32
  %scaled = scalar.mulf<nnan|ninf|nsz> %x, %7 : f32
  func.return %scaled : f32
}

// ====

func.def @neg_abs_copysign_structural(%x: f32) -> (f32, f32, f32, f32) {
  %neg = scalar.negf %x : f32
  %double = scalar.negf %neg : f32
  %abs = scalar.absf %x : f32
  %abs_abs = scalar.absf %abs : f32
  %abs_neg = scalar.absf %neg : f32
  %copy_self = scalar.copysignf %x, %x : f32
  func.return %double, %abs_abs, %abs_neg, %copy_self : f32, f32, f32, f32
}

// ----
func.def @neg_abs_copysign_structural(%x: f32) -> (f32, f32, f32, f32) {
  %abs = scalar.absf %x : f32
  %abs_neg = scalar.absf %x : f32
  func.return %x, %abs, %abs_neg, %x : f32, f32, f32, f32
}

// ====

func.def @fmaf_preserves_fastmath_flags(%a: f32, %b: f32, %c: f32) -> (f32, f32, f32) {
  %c0 = scalar.constant 0.0 : f32
  %c1 = scalar.constant 1.0 : f32
  %to_c = scalar.fmaf<nnan|ninf|nsz> %c0, %b, %c : f32
  %to_mul = scalar.fmaf<nsz> %a, %b, %c0 : f32
  %to_add = scalar.fmaf<reassoc> %c1, %b, %c : f32
  func.return %to_c, %to_mul, %to_add : f32, f32, f32
}

// ----
func.def @fmaf_preserves_fastmath_flags(%a: f32, %b: f32, %c: f32) -> (f32, f32, f32) {
  %to_mul = scalar.mulf<nsz> %a, %b : f32
  %to_add = scalar.addf<reassoc> %b, %c : f32
  func.return %c, %to_mul, %to_add : f32, f32, f32
}

// ====

// Contracted product-add spellings become an explicit fused multiply-add.
func.def @contracted_product_add_to_fmaf(%lhs: f32, %rhs: f32, %addend: f32) -> (f32) {
  %product = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %lhs, %rhs : f32
  %r = scalar.addf<reassoc|nnan|ninf|nsz|contract> %product, %addend : f32
  func.return %r : f32
}

// ----
func.def @contracted_product_add_to_fmaf(%lhs: f32, %rhs: f32, %addend: f32) -> (f32) {
  %r = scalar.fmaf<reassoc|nnan|ninf|nsz|contract> %lhs, %rhs, %addend : f32
  func.return %r : f32
}

// ====

// Addition is commutative, so the product can appear on either side.
func.def @contracted_reversed_product_add_to_fmaf(%lhs: f32, %rhs: f32, %addend: f32) -> (f32) {
  %product = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %lhs, %rhs : f32
  %r = scalar.addf<reassoc|nnan|ninf|nsz|contract> %addend, %product : f32
  func.return %r : f32
}

// ----
func.def @contracted_reversed_product_add_to_fmaf(%lhs: f32, %rhs: f32, %addend: f32) -> (f32) {
  %r = scalar.fmaf<reassoc|nnan|ninf|nsz|contract> %lhs, %rhs, %addend : f32
  func.return %r : f32
}

// ====

// Exact add keeps the separately rounded product and addition.
func.def @exact_product_add_stays_separate(%lhs: f32, %rhs: f32, %addend: f32) -> (f32) {
  %product = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %lhs, %rhs : f32
  %r = scalar.addf<reassoc|nnan|ninf|nsz> %product, %addend : f32
  func.return %r : f32
}

// ====

// A shared product remains explicit instead of duplicating the multiply.
func.def @shared_product_add_stays_separate(%lhs: f32, %rhs: f32, %addend: f32) -> (f32, f32) {
  %product = scalar.mulf<reassoc|nnan|ninf|nsz|contract> %lhs, %rhs : f32
  %r = scalar.addf<reassoc|nnan|ninf|nsz|contract> %product, %addend : f32
  func.return %product, %r : f32, f32
}
