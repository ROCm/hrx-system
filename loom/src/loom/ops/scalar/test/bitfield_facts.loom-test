// RUN: pass canonicalize

// Runtime values in this interval all share the same high word.
func.def @bounded_high_word(%input: i64) -> (i32, i64) where [range(%input, 4294967296, 8589934591)] {
  %word = scalar.bitfield.extractu %input {offset = 32, width = 32} : i64 -> i32
  %extended = scalar.bitfield.extracts %input {offset = 32, width = 32} : i64 -> i64
  func.return %word, %extended : i32, i64
}

// ----
func.def @bounded_high_word(%input: i64) -> (i32, i64) where [range(%input, 4294967296, 8589934591)] {
  %word = scalar.constant 1 : i32
  %extended = scalar.constant 1 : i64
  func.return %word, %extended : i32, i64
}

// ====

// The same negative word has different zero- and sign-extended values.
func.def @negative_high_word(%input: i64) -> (i64, i64, i32) where [range(%input, -4294967296, -1)] {
  %unsigned = scalar.bitfield.extractu %input {offset = 32, width = 32} : i64 -> i64
  %signed = scalar.bitfield.extracts %input {offset = 32, width = 32} : i64 -> i64
  %sign = scalar.bitfield.extracts %input {offset = 63, width = 1} : i64 -> i32
  func.return %unsigned, %signed, %sign : i64, i64, i32
}

// ----
func.def @negative_high_word(%input: i64) -> (i64, i64, i32) where [range(%input, -4294967296, -1)] {
  %unsigned = scalar.constant 4294967295 : i64
  %signed = scalar.constant -1 : i64
  %sign = scalar.constant -1 : i32
  func.return %unsigned, %signed, %sign : i64, i64, i32
}

// ====

// An interval spanning a field's sign boundary cannot fold to either endpoint.
func.def @field_sign_boundary(%input: i64) -> (i32) where [range(%input, 112, 143)] {
  %field = scalar.bitfield.extracts %input {offset = 4, width = 4} : i64 -> i32
  func.return %field : i32
}
