// RUN: verify

pipeline.def<kernel> @select_memory(%column: index) run() {
  %memory = pipeline.memory<workgroup>[%column, 3] : pool
}

// ====

pipeline.def @ambiguous_memory(%column: index) run() {
  // ERROR@+1: STRUCTURE/029 "pipeline.def<kernel>"
  %memory = pipeline.memory<workgroup>[%column, 3] : pool
}

// ====

command.def @command_memory() launch() {
  // ERROR@+1: STRUCTURE/029 "pipeline.def" "command.def"
  %memory = pipeline.memory<workgroup>[0, 3] : pool
  command.return
}

// ====

pipeline.def<kernel> @negative_memory_coordinate() run() {
  // ERROR@+1: STRUCTURE/014 "coordinates" "-1"
  %memory = pipeline.memory<workgroup>[0, -1] : pool
}

// ====

pipeline.def<kernel> @missing_memory_coordinates() run() {
  // ERROR@+1: STRUCTURE/014 "worker rank" "0"
  %memory = pipeline.memory<workgroup>[] : pool
}

// ====

pipeline.def<kernel> @memory_inside_worker() run() {
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    // ERROR@+1: STRUCTURE/029 "pipeline.strand"
    %memory = pipeline.memory<workgroup>[0, 2] : pool
  }
}

// ====

pipeline.def @typed_arguments(%width: index) run(%input: channel<tile<[%width]xf32>>, %scratch: view<[%width]xf32>, %count: index) {
}

// ====

// A reusable command product is authored with command.def; pipeline
// scope names the directly loadable kernel artifact boundary.
// ERROR@+1: PARSE/017 "scope" "command"
pipeline.def<command> @unsupported_command_scope() run() {
}

// ====

// The construction loop captures its own column. The worker loop remains
// ordinary runtime control and each acquired input is released independently.
target.decl @npu

pipeline.def target(@npu) @columns(%width: index) run(%input: channel<tile<[%width]xi32>>, %count: index) {
  %record_begin = index.constant 0 : index
  %record_step = index.constant 1 : index
  %columns = index.constant 8 : index
  scf.for %column = [%record_begin to %columns step %record_step] {
    pipeline.strand workers([%column, 2], [1, 1], [1, 1]) {
      scf.for %record = [%record_begin to %count step %record_step] {
        %read, %view = channel.acquire %input : channel<tile<[%width]xi32>> -> (read<tile<[%width]xi32>>, view<[%width]xi32>)
        channel.release %read : read<tile<[%width]xi32>>
      }
    }
  }
}

// ====

pipeline.def @unequal_worker_rank() run() {
  // ERROR@+1: STRUCTURE/013 "counts" "1" "worker rank" "2"
  pipeline.strand workers([0, 2], [1], [1, 1]) {
  }
}

// ====

pipeline.def @empty_worker_rank() run() {
  // ERROR@+1: STRUCTURE/014 "worker rank" "0" "at least one worker dimension"
  pipeline.strand workers([], [], []) {
  }
}

// ====

pipeline.def @invalid_worker_stride() run() {
  // ERROR@+1: STRUCTURE/014 "strides" "0" "positive worker stride"
  pipeline.strand workers([0, 2], [1, 1], [1, 0]) {
  }
}

// ====

pipeline.def @negative_worker_count() run() {
  // ERROR@+1: STRUCTURE/014 "counts" "-1" "nonnegative worker coordinate or count"
  pipeline.strand workers([0], [-1], [1]) {
  }
}

// ====

// Matching flattened types do not permit changing which arguments specialize
// a child and which are supplied with each invocation.
pipeline.def @child(%width: index) run(%count: index) {
}

pipeline.def @wrong_staging(%width: index) run(%count: index) {
  // ERROR@+1: STRUCTURE/013 "specialization" "0" "pipeline specialization argument" "1"
  pipeline.compose @child(%width, %count) : (index, index)
}

// ====

pipeline.def @child(%width: index) run(%input: channel<tile<[%width]xi32>>) {
}

pipeline.def @wrong_record_width(%width: index, %other_width: index) run(%input: channel<tile<[%other_width]xi32>>) {
  // ERROR@+1: TYPE/001 {field_a="operand 1", field_b="contract argument 1"}
  pipeline.compose @child[%width](%input) : [index](channel<tile<[%other_width]xi32>>)
}
