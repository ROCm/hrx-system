load("//build_tools/embed_data:build_defs.bzl", "iree_c_embed_data")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test", "loom_generated_cc_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_FUNC_VISIBILITY = [
    "//loom/binding/c:__pkg__",
    "//loom/src/loom/analysis:__pkg__",
    "//loom/src/loom/codegen/low:__pkg__",
    "//loom/src/loom/codegen/low/testing:__pkg__",
    "//loom/src/loom/codegen/low/transforms:__subpackages__",
    "//loom/src/loom/codegen/low/lower:__pkg__",
    "//loom/src/loom/format/bytecode:__pkg__",
    "//loom/src/loom/format/bytecode/reader:__pkg__",
    "//loom/src/loom/format/text:__pkg__",
    "//loom/src/loom/format/text/test:__pkg__",
    "//loom/src/loom/import/cxx:__pkg__",
    "//loom/src/loom/import/cxx/tooling:__pkg__",
    "//loom/src/loom/import/cxx/symbol:__pkg__",
    "//loom/src/loom/link:__pkg__",
    "//loom/src/loom/ops:__pkg__",
    "//loom/src/loom/ops/encoding:__pkg__",
    "//loom/src/loom/ops/kernel:__pkg__",
    "//loom/src/loom/ops/low:__pkg__",
    "//loom/src/loom/rewrite:__pkg__",
    "//loom/src/loom/target:__pkg__",
    "//loom/src/loom/target/arch:__subpackages__",
    "//loom/src/loom/target/emit:__subpackages__",
    "//loom/src/loom/target/reporting:__pkg__",
    "//loom/src/loom/tooling/execution/hal:__pkg__",
    "//loom/src/loom/tooling/target/vm:__pkg__",
    "//loom/src/loom/tools/loom-check:__pkg__",
    "//loom/src/loom/tools/loom-format:__pkg__",
    "//loom/src/loom/transforms/func:__pkg__",
    "//loom/src/loom/transforms/kernel:__pkg__",
    "//loom/src/loom/transforms/pipeline:__pkg__",
    "//loom/src/loom/transforms/symbol:__pkg__",
]

loom_generated_cc_library(
    name = "func",
    srcs = [
        "canonicalize.c",
        "location.c",
        "verify.c",
    ],
    hdrs = [
        "location.h",
        "ops.h",
    ],
    args = ["--dialect=func"],
    extra_output_flags = ["--ops-include"],
    extra_outputs = ["ops.inc"],
    generated_src_flags = [
        "--builders",
        "--tables",
    ],
    generated_srcs = [
        "builders.c",
        "tables.c",
    ],
    generator = "//loom/py/loom/gen/ops:c_tables_func_generator",
    textual_hdrs = ["ops.inc"],
    visibility = _FUNC_VISIBILITY,
    deps = [
        "//loom/src/loom/error:error_defs",
        "//loom/src/loom/error:parameter",
        "//loom/src/loom/format:location",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:callable_effects",
        "//loom/src/loom/ops:func_symbol_facts",
        "//loom/src/loom/ops:function_contract_verify",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/rewrite:rewriter",
        "//loom/src/loom/target:types",
        "//runtime/src/iree/base:core_headers",
    ],
)

loom_cc_test(
    name = "print_test",
    srcs = ["print_test.cc"],
    deps = [
        ":func",
        "//loom/src/loom/format/text:printer",
        "//loom/src/loom/ir",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "location_capture",
    srcs = ["location_capture.c"],
    hdrs = ["location_capture.h"],
    deps = [
        ":func",
        "//loom/src/loom/error:source",
        "//loom/src/loom/ir",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
    ],
)

loom_cc_test(
    name = "location_capture_test",
    srcs = ["location_capture_test.cc"],
    deps = [
        ":func",
        ":location_capture",
        ":location_capture_test_data",
        "//loom/src/loom/error:source",
        "//loom/src/loom/format:location",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/ops:op_registry",
        "//loom/src/loom/tooling/input",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

iree_c_embed_data(
    name = "location_capture_test_data",
    testonly = True,
    srcs = ["//loom/src/loom/ops/func/test:location_capture.loom-test"],
    c_file_output = "location_capture_test_data.c",
    h_file_output = "location_capture_test_data.h",
    identifier = "loom_location_capture_test_data",
)

loom_cc_test(
    name = "location_test",
    srcs = ["location_test.cc"],
    deps = [
        ":func",
        ":location_test_data",
        "//loom/src/loom/format:location",
        "//loom/src/loom/format/bytecode:reader",
        "//loom/src/loom/format/bytecode:writer",
        "//loom/src/loom/format/text:parser",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:op_registry",
        "//loom/src/loom/testing:module_ptr",
        "//loom/src/loom/verify",
        "//runtime/src/iree/base:core_headers",
        "//runtime/src/iree/io:stream",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

iree_c_embed_data(
    name = "location_test_data",
    testonly = True,
    srcs = ["//loom/src/loom/ops/func/test:location.loom-test"],
    c_file_output = "location_test_data.c",
    h_file_output = "location_test_data.h",
    identifier = "loom_location_test_data",
)
