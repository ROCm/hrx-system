// RUN: verify

func.def @empty() -> (buffer) {
  // ERROR@+1: STRUCTURE/014 "nonempty postorder location graph"
  %site = func.location [] : buffer
  func.return %site : buffer
}

// ====

func.def @cycle() -> (buffer) {
  // ERROR@+1: STRUCTURE/014 "index of a preceding location node"
  %site = func.location [#func.location.fused<[0]>] : buffer
  func.return %site : buffer
}

// ====

func.def @coordinate_width() -> (buffer) {
  // ERROR@+1: STRUCTURE/014 "four unsigned 32-bit source coordinates"
  %site = func.location [#func.location.file<"file.cc", range = [4294967296, 1, 4294967296, 2]>] : buffer
  func.return %site : buffer
}

// ====

func.def @field_is_not_a_node() -> (buffer) {
  // ERROR@+1: STRUCTURE/042 "func.location.field"
  %site = func.location [#func.location.field<operand, index = 0, range = [1, 1, 1, 2]>] : buffer
  func.return %site : buffer
}

// ====

func.def @wrong_field_family() -> (buffer) {
  // ERROR@+1: PARSE/003 "func.location.field"
  %site = func.location [#func.location.file<"file.cc", range = [1, 1, 1, 2], fields = [#func.location.unknown<>]>] : buffer
  // ERROR@+1: PARSE/001 "site"
  func.return %site : buffer
}
