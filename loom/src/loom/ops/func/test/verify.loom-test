// RUN: verify

// Target-independent source functions are valid without any target record.
func.def @semantic() {
  func.return
}

// ====

// A dependent signature carries its reduced access requirement after binding
// the extent. Neither shape substitution nor exact call matching may erase it.
func.decl @natural(%width: index, %source: view<[%width]xi32>) -> (i32)

func.def @packed_cannot_call_natural(%width: index, %source: view<[%width]xi32, align(1)>) -> (i32) {
  // ERROR@+1: TYPE/001 {field_a="operand 1", field_b="contract argument 1"}
  %result = func.call @natural(%width, %source) : (index, view<[%width]xi32, align(1)>) -> (i32)
  func.return %result : i32
}

// ====

// Exact matching also requires an explicit relaxation at a packed boundary.
func.decl @packed(%source: view<4xi32, align(1)>) -> (i32)

func.def @natural_cannot_call_packed(%source: view<4xi32>) -> (i32) {
  // ERROR@+1: TYPE/001 {field_a="operand 0", field_b="contract argument 0"}
  %result = func.call @packed(%source) : (view<4xi32>) -> (i32)
  func.return %result : i32
}

// ====

// Named function results are part of the signature contract and may carry
// postconditions relating them to function arguments.
func.def @postcondition(%value: i32) -> (%result: i32) where [eq(%result, %value)] {
  func.return %value : i32
}

// ====

// A predicate constrains a signature value rather than being a standalone
// compile-time boolean expression.
// ERROR@+1: STRUCTURE/032 {op_name="func.def", field_name="predicates[0].arg[0]", required_origin="a function argument or result"}
func.def @constant_predicate(%value: i32) where [eq(4, %value)] {
  func.return
}

// ====

// Integer relation predicates require integer-domain signature values.
// ERROR@+1: TYPE/003 {operand_name="predicates[0].arg[0]", actual_type="f32", expected_constraint="integer, index, or offset scalar"}
func.def @integer_predicate_on_float(%value: f32) where [range(%value, 0, 4)] {
  func.return
}

// ====

// Floating-point classification predicates require floating-point signature
// values.
// ERROR@+1: TYPE/003 {operand_name="predicates[0].arg[0]", actual_type="i32", expected_constraint="floating-point scalar"}
func.def @float_predicate_on_integer(%value: i32) where [finite(%value)] {
  func.return
}

// ====

kernel.decl @launch_only() launch()

func.def @ordinary_calls_require_callable_symbols() {
  // ERROR@+1: SYMBOL/003 {symbol_name="launch_only", actual_kind="kernel", expected_kind="function"}
  func.call @launch_only() : ()
  func.return
}

// ====

template.decl @provider_only(%value: i32) -> (i32)

func.def @template_families_are_not_runtime_callable(%value: i32) -> (i32) {
  // ERROR@+1: SYMBOL/003 {symbol_name="provider_only", actual_kind="template family", expected_kind="function"}
  %result = func.call @provider_only(%value) : (i32) -> (i32)
  func.return %result : i32
}

// ====

// ABI contracts can remain target-independent until invocation selection.
func.def abi(object_function) @targetless_abi() {
  func.return
}

// ====

test.target<low_core> @test_target

// Targeted function contracts are valid when the target record is present.
func.def target(@test_target) abi(object_function) export("semantic") @targeted_semantic() {
  func.return
}

// ====

// Retained source signatures must project to the function's exact High value
// types rather than merely matching the flattened value count.
// ERROR@+1: TYPE/001 {field_a="argument", type_a="f32", field_b="source_signature projection", type_b="i32"}
func.decl source_signature(#func.abi.c.signature<arguments = [0], results = [], types = [#func.abi.c.type<signed_integer, byte_length = 4, byte_alignment = 4, component_count = 1, bitwidth = 32>]>) @wrong_source_projection(%value: f32)

// ====

// Stored projection widths are checked against their source object kind so
// later ABI planning consumes a trusted, direct query.
// ERROR@+1: STRUCTURE/014 {attr_name="source_signature", actual_value="0", expected_constraint="an 8-, 16-, 32-, or 64-bit integer matching its object footprint"}
func.decl source_signature(#func.abi.c.signature<arguments = [0], results = [], types = [#func.abi.c.type<unsigned_integer, byte_length = 4, byte_alignment = 4, component_count = 2, bitwidth = 32>]>) @wrong_component_count(%lhs: i32, %rhs: i32)

// ====

// Ordinary functions may author target-local execution choices.
target.generic<reference> @wave64_target {subgroup_size = 64}

func.def target(@wave64_target) @wave64_function() {
  func.return
}

// ====

target.generic<reference> @wave64_target {subgroup_size = 64}

template.decl @test.wave64()

// ERROR@+1: TARGET/067 {provider_name="wave64_template", target_name="wave64_target", field_name="subgroup_size"}
template.def<@test.wave64> target(@wave64_target) @wave64_template() {
  template.return
}

// ====

target.generic<reference> @large_target {max_workgroup_size_x = 1024}

template.decl @test.large()

// ERROR@+1: TARGET/067 {provider_name="large_ukernel", target_name="large_target", field_name="max_workgroup_size_x"}
template.ukernel<@test.large> target(@large_target) @large_ukernel()

// ====

// Only parameterized attribute families with target-condition semantics are
// valid as typed provider requirements.
template.decl @test.invalid_condition()

// ERROR@+1: TARGET/068 {function_name="not_a_condition", condition_index="0", reason="parameterized attribute family is not a target condition"}
template.def<@test.invalid_condition> requires [#test.tile<width = 8>] @not_a_condition() {
  template.return
}

// ====

// Target condition values are validated at the authored provider boundary.
template.decl @test.invalid_condition()

// ERROR@+1: TARGET/068 {function_name="invalid_size", condition_index="0", reason="target.subgroup.size requires a nonzero unsigned 32-bit size"}
template.ukernel<@test.invalid_condition> requires [#target.subgroup.size<0>] @invalid_size()

// ====

// Family requirements use the same typed target-condition boundary as
// provider requirements.
// ERROR@+1: TARGET/068 {function_name="invalid_family_condition", condition_index="0", reason="parameterized attribute family is not a target condition"}
template.decl requires [#test.tile<width = 8>] @invalid_family_condition()

// ====

// Provider signatures are verified once against their family contract. Later
// selection consumes this invariant without repeating type comparison at each
// application site.
template.decl @test.provider_signature(%value: i32)

// ERROR@+1: TYPE/001 {field_a="implementation argument 0", type_a="f32", field_b="contract argument 0", type_b="i32"}
template.def<@test.provider_signature> @wrong_provider_argument(%value: f32) {
  template.return
}

// ====

template.decl @test.provider_result(%value: f32) -> (i32)

// ERROR@+1: TYPE/001 {field_a="implementation result 0", type_a="f32", field_b="contract result 0", type_b="i32"}
template.def<@test.provider_result> @wrong_provider_result(%value: f32) -> (f32) {
  template.return %value : f32
}

// ====

// Applications are independently verified against the same family contract.
template.decl @test.application_signature(%value: i32) -> (i32)

func.def @wrong_application_argument(%value: f32) -> (i32) {
  // ERROR@+1: TYPE/001 {field_a="operand 0", type_a="f32", field_b="contract argument 0", type_b="i32"}
  %result = template.apply<@test.application_signature>(%value) : (f32) -> (i32)
  func.return %result : i32
}

// ====

// Substitution follows the dimension operand rather than accepting any vector
// of the same rank and element type.
func.decl @dependent(%width: index, %value: vector<[%width]xf32>) -> (vector<[%width]xf32>)

func.def @wrong_dependent_argument(%width: index, %other_width: index, %value: vector<[%other_width]xf32>) -> (vector<[%width]xf32>) {
  // ERROR@+1: TYPE/001 {field_a="operand 1", field_b="contract argument 1"}
  %result = func.call @dependent(%width, %value) : (index, vector<[%other_width]xf32>) -> (vector<[%width]xf32>)
  func.return %result : vector<[%width]xf32>
}

// ====

// Selected providers cannot change the instantiated result dimension.
template.decl @dependent(%width: index, %value: vector<[%width]xf32>) -> (vector<[%width]xf32>)

func.def @wrong_dependent_result(%width: index, %other_width: index, %value: vector<[%width]xf32>) -> (vector<[%other_width]xf32>) {
  // ERROR@+1: TYPE/001 {field_a="result 0", field_b="contract result 0"}
  %result = template.apply<@dependent>(%width, %value) : (index, vector<[%width]xf32>) -> (vector<[%other_width]xf32>)
  func.return %result : vector<[%other_width]xf32>
}

// ====

func.decl pure @pure_external()

func.def @pure_body() {
  func.return
}

func.def @pure_direct_calls() {
  func.call pure @pure_external() : ()
  func.call pure @pure_body() : ()
  func.return
}

// ====

func.decl readonly @readonly_external()
func.decl pure @pure_external()
func.decl @observable_effect()

func.def @readonly_calls_accept_pure_or_readonly_callees() {
  func.call readonly @readonly_external() : ()
  func.call readonly @pure_external() : ()
  func.return
}

func.def @pure_calls_reject_readonly_callees() {
  // ERROR@+1: STRUCTURE/034 {op_name="func.call", contract_name="pure", callee_name="readonly_external"}
  func.call pure @readonly_external() : ()
  func.return
}

func.def @readonly_calls_require_a_compatible_callee() {
  // ERROR@+1: STRUCTURE/034 {op_name="func.call", contract_name="readonly", callee_name="observable_effect"}
  func.call readonly @observable_effect() : ()
  func.return
}

// ====

func.decl readonly @template_read()

template.decl readonly @test.readonly_provider()

template.def<@test.readonly_provider> readonly @readonly_provider() {
  func.call readonly @template_read() : ()
  template.return
}

func.def @readonly_template_calls_accept_readonly_providers() {
  template.call readonly @readonly_provider() : ()
  func.return
}

func.def @pure_template_calls_reject_readonly_providers() {
  // ERROR@+1: STRUCTURE/034 {op_name="template.call", contract_name="pure", callee_name="readonly_provider"}
  template.call pure @readonly_provider() : ()
  func.return
}

// ====

func.decl @observable_effect()

func.def @impure_helper() {
  func.call @observable_effect() : ()
  func.return
}

func.def @pure_calls_require_pure_callees() {
  // ERROR@+1: STRUCTURE/034 {op_name="func.call", callee_name="impure_helper"}
  func.call pure @impure_helper() : ()
  func.return
}

// ====

// Fresh identity prevents pure callable semantics even though it does not
// contribute to the region's cached memory summaries.
func.def @allocating_helper(%bytes: offset) {
  %storage = buffer.alloca<private> align(4) %bytes : buffer
  func.return
}

func.def @pure_calls_reject_fresh_identity(%bytes: offset) {
  // ERROR@+1: STRUCTURE/034 {op_name="func.call", callee_name="allocating_helper"}
  func.call pure @allocating_helper(%bytes) : (offset)
  func.return
}

// ====

// An explicit contract remains the stable upper bound even when the current
// definition happens to satisfy a stronger contract.
func.def readonly @declared_readonly_with_pure_body() {
  func.return
}

func.def @pure_calls_reject_declared_readonly() {
  // ERROR@+1: STRUCTURE/034 {op_name="func.call", callee_name="declared_readonly_with_pure_body"}
  func.call pure @declared_readonly_with_pure_body() : ()
  func.return
}

// ====

template.decl @test.pure_provider()

template.def<@test.pure_provider> @pure_provider() {
  template.return
}

func.def @pure_exact_template_call() {
  template.call pure @pure_provider() : ()
  func.return
}

// ====

func.decl @template_observable_effect()

template.decl @test.impure_provider()

template.def<@test.impure_provider> @impure_provider() {
  func.call @template_observable_effect() : ()
  template.return
}

func.def @pure_template_calls_require_pure_providers() {
  // ERROR@+1: STRUCTURE/034 {op_name="template.call", callee_name="impure_provider"}
  template.call pure @impure_provider() : ()
  func.return
}

// ====

// A view bound to a different layout remains an invalid public call contract.
func.def inline @read(%layout: encoding<layout>, %input: view<4xf32, %layout>) -> (f32) {
  %value = view.load %input[0] : view<4xf32, %layout> -> f32
  func.return %value : f32
}

func.def public @wrong_layout(%layout: encoding<layout>, %other: encoding<layout>, %input: view<4xf32, %other>) -> (f32) {
  // ERROR@+1: TYPE/001 "operand 1" "contract argument 1"
  %value = func.call @read(%layout, %input) : (encoding<layout>, view<4xf32, %other>) -> (f32)
  func.return %value : f32
}
