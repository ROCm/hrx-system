load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_benchmark", "loom_cc_test", "loom_generated_cc_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_generated_cc_library(
    name = "encoding",
    srcs = [
        "auxiliary.c",
        "condition_refinement.c",
        "facts.c",
        "families.c",
        "hadamard.c",
        "operand.c",
        "params.c",
        "roles.c",
        "storage.c",
        "summary.c",
        "verify.c",
    ],
    hdrs = [
        "auxiliary.h",
        "facts.h",
        "families.h",
        "hadamard.h",
        "operand.h",
        "ops.h",
        "params.h",
        "roles.h",
        "storage.h",
        "summary.h",
    ],
    args = ["--dialect=encoding"],
    generated_src_flags = [
        "--builders",
        "--tables",
    ],
    generated_srcs = [
        "builders.c",
        "tables.c",
    ],
    generator = "//loom/py/loom/gen/ops:c_tables_encoding_generator",
    deps = [
        "//loom/src/loom/error:emitter",
        "//loom/src/loom/error:error_defs",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/rewrite:rewriter",
        "//loom/src/loom/util:fact_table",
        "//loom/src/loom/util:numeric_format",
        "//loom/src/loom/util:stable_id",
        "//runtime/src/iree/base",
    ],
)

loom_cc_test(
    name = "auxiliary_test",
    srcs = ["auxiliary_test.cc"],
    deps = [
        ":encoding",
        "//loom/src/loom/ir",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_benchmark(
    name = "encoding_benchmark",
    srcs = ["encoding_benchmark.cc"],
    args = [
        "--benchmark_filter=BM_.*Encoding.*/32",
    ],
    deps = [
        ":encoding",
        "//loom/src/loom/format/bytecode:reader",
        "//loom/src/loom/format/bytecode:writer",
        "//loom/src/loom/format/text:parser",
        "//loom/src/loom/format/text:printer",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops/func",
        "//loom/src/loom/ops/scalar",
        "//loom/src/loom/ops/scf",
        "//loom/src/loom/ops/test",
        "//loom/src/loom/ops/vector",
        "//loom/src/loom/pass:value_facts",
        "//loom/src/loom/transforms/cleanup:canonicalize",
        "//loom/src/loom/util:fact_table",
        "//loom/src/loom/util:stream",
        "//loom/src/loom/verify",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/io:stream",
        "//runtime/src/iree/testing:benchmark_main",
    ],
)

loom_cc_test(
    name = "format_test",
    srcs = ["format_test.cc"],
    deps = [
        ":encoding",
        "//loom/src/loom/error:error_defs",
        "//loom/src/loom/format/text:parser",
        "//loom/src/loom/format/text:printer",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops/test",
        "//loom/src/loom/testing:diagnostic_matchers",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_test(
    name = "storage_test",
    srcs = ["storage_test.cc"],
    deps = [
        ":encoding",
        "//loom/src/loom/format/text:parser",
        "//loom/src/loom/ir",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_test(
    name = "verify_test",
    srcs = ["verify_test.cc"],
    deps = [
        ":encoding",
        "//loom/src/loom/error:diagnostic",
        "//loom/src/loom/error:error_defs",
        "//loom/src/loom/format/text:parser",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops/func",
        "//loom/src/loom/testing:diagnostic_matchers",
        "//loom/src/loom/verify",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
