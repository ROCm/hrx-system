  %format = test.fact_encoding_operand_field %schema ["element_format"] : encoding<schema> -> i64
  %rounding = test.fact_encoding_operand_field %schema ["rounding"] : encoding<schema> -> i64
  func.return %format, %rounding : i64, i64
}
// ----
func.def @operand_finite_flush_subnormal_summary() -> (i64, i64) {
  %format = scalar.constant 8388608 : i64
  %rounding = scalar.constant 4608 : i64
  func.return %format, %rounding : i64, i64
}

// ====

// Dynamic physical-storage composition carries nested schema facts along with
// layout facts, giving consumers one encoding value to query.
func.def @storage_matrix_schema_summary() -> (i64, i64, i64, i64) {
  %layout = encoding.layout.dense : encoding<layout>
  %schema = encoding.define #encoding.operand<element_format=f4e2m1, payload_elements=128, payload_registers=16, scale_format=f8e4m3, scale_group_elements=16, scale_operands=1, scale_topology=block_1d, zero_scale_fallback=true> : encoding<schema>
  %storage = encoding.define #encoding.storage {layout = %layout : encoding<layout>, schema = %schema : encoding<schema>} : encoding<storage>
  %format = test.fact_encoding_operand_field %storage ["element_format"] : encoding<storage> -> i64
  %scale_format = test.fact_encoding_operand_field %storage ["scale_format"] : encoding<storage> -> i64
  %group = test.fact_encoding_operand_field %storage ["scale_group_elements"] : encoding<storage> -> i64
  %elements = test.fact_encoding_operand_field %storage ["payload_elements"] : encoding<storage> -> i64
  func.return %format, %scale_format, %group, %elements : i64, i64, i64, i64
}
// ----
func.def @storage_matrix_schema_summary() -> (i64, i64, i64, i64) {
  %format = scalar.constant 8589934592 : i64
  %scale_format = scalar.constant 8388608 : i64
  %group = scalar.constant 16 : i64
  %elements = scalar.constant 128 : i64
  func.return %format, %scale_format, %group, %elements : i64, i64, i64, i64
}

// ====

// Static physical-storage specs recurse through their nested schema too.
func.def @static_storage_matrix_schema_summary() -> (i64, i64) {
  %storage = encoding.define #encoding.storage<layout=#encoding.layout.dense, schema=#encoding.operand<element_format=bf6, payload_elements=32, payload_registers=6>> : encoding<storage>
  %format = test.fact_encoding_operand_field %storage ["element_format"] : encoding<storage> -> i64
  %registers = test.fact_encoding_operand_field %storage ["payload_registers"] : encoding<storage> -> i64
  func.return %format, %registers : i64, i64
}
// ----
func.def @static_storage_matrix_schema_summary() -> (i64, i64) {
  %format = scalar.constant 4294967296 : i64
  %registers = scalar.constant 6 : i64
  func.return %format, %registers : i64, i64
}

// ====

// Exact static-spec assumptions can seed matrix schema facts for encoding
// arguments that cross function or kernel boundaries.
func.def @assume_spec_matrix_schema_summary(%schema: encoding<schema>) -> (i64, i64) {
  %schema2 = encoding.assume.spec %schema, #encoding.operand<element_format=bf8, payload_elements=32, payload_registers=8, scale_format=f8e5m2, scale_group_elements=32, scale_operands=1, scale_topology=block_1d> : encoding<schema>
  %format = test.fact_encoding_operand_field %schema2 ["element_format"] : encoding<schema> -> i64
  %scale_format = test.fact_encoding_operand_field %schema2 ["scale_format"] : encoding<schema> -> i64
  func.return %format, %scale_format : i64, i64
}
// ----
func.def @assume_spec_matrix_schema_summary(%schema: encoding<schema>) -> (i64, i64) {
  %format = scalar.constant 536870912 : i64
  %scale_format = scalar.constant 16777216 : i64
  func.return %format, %scale_format : i64, i64
}
