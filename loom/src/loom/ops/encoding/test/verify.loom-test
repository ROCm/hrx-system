// RUN: verify

// Static encoding attrs and dynamic encoding operands are two views of one
// parameter namespace; a name can appear in only one place.
func.def @static_dynamic_duplicate(%payload_elements: index) {
  // ERROR@+1: ENCODING/006 "payload_elements"
  %enc = encoding.define #encoding.i8<payload_elements=32> {payload_elements = %payload_elements : index} : encoding<schema>
  func.return
}

// ====

// SSA values never appear inside static #family<...> parameter attributes.
func.def @static_param_ssa_value(%group_size: index) {
  // ERROR@+1: PARSE/028 "payload_elements"
  %enc = encoding.define #encoding.operand<element_format=i8, payload_elements=%group_size, payload_packing=dense_lanes> : encoding<schema>
  func.return
}

// ====

// A known encoding family must declare the precise role-qualified result type
// at the definition site; generic `encoding` would push role discovery to
// later consumers.
func.def @encoding_define_generic_result_role() {
  // ERROR@+1: ENCODING/012 {encoding_name="encoding.operand", actual_type="encoding", expected_type="encoding<schema>"}
  %enc = encoding.define #encoding.i8<payload_elements=32> : encoding
  func.return
}

// ====

func.def @encoding_define_wrong_result_role() {
  // ERROR@+1: ENCODING/012 {encoding_name="encoding.operand", actual_type="encoding<transform>", expected_type="encoding<schema>"}
  %enc = encoding.define #encoding.i8<payload_elements=32> : encoding<transform>
  func.return
}

// ====

func.def @encoding_isa_rejects_role_mismatch(%schema: encoding<schema>) {
  // ERROR@+1: ENCODING/021 "dense" "encoding<layout>" "encoding<schema>"
  %is = encoding.isa<#encoding.layout.dense> %schema : encoding<schema>
  func.return
}

// ====

func.def @encoding_matches_rejects_empty_requirements(%schema: encoding<schema>) {
  // ERROR@+1: ENCODING/022
  %is = encoding.matches<> %schema : encoding<schema>
  func.return
}

// ====

func.def @encoding_assume_match_rejects_empty_requirements(%schema: encoding<schema>) {
  // ERROR@+1: ENCODING/022
  %schema2 = encoding.assume.match<> %schema : encoding<schema>
  func.return
}

// ====

func.def @encoding_matches_requires_schema_role(%layout: encoding<layout>) {
  // ERROR@+1: TYPE/003 "encoding<schema>"
  %is = encoding.matches<element_format = u4> %layout : encoding<layout>
  func.return
}

// ====

func.def @layout_assume_strided_rejects_negative_rank(%layout: encoding<layout>) {
  // ERROR@+1: STRUCTURE/014 "rank" "-1" "rank in [0, 255]"
  %strided = encoding.layout.assume.strided %layout {rank = -1} : encoding<layout>
  func.return
}

// ====

func.def @layout_strided_rejects_negative_static_stride() {
  // ERROR@+1: STRUCTURE/014 "static_strides" "-1" "stride >= 0 or dynamic sentinel"
  %strided = encoding.layout.strided [-1, 1] : encoding<layout>
  func.return
}

// ====

func.def @assume_spec_rejects_role_mismatch(%schema: encoding<schema>) {
  // ERROR@+1: ENCODING/012 "dense" "encoding<schema>" "encoding<layout>"
  %bad = encoding.assume.spec %schema, #encoding.layout.dense : encoding<schema>
  func.return
}

// ====

// Static family semantics are verified independently of encoding.define.
func.def @assume_spec_rejects_negative_static_stride(%layout: encoding<layout>) {
  // ERROR@+1: STRUCTURE/014 "stride" "-1" "non-negative stride"
  %bad = encoding.assume.spec %layout, #encoding.layout.strided<strides=[-1]> : encoding<layout>
  func.return
}

// ====

func.def @assume_spec_rejects_bad_named_fp8_rounding(%schema: encoding<schema>) {
  // ERROR@+1: PARSE/017 "rounding" "wat"
  %bad = encoding.assume.spec %schema, #encoding.f8e4m3fn<rounding=wat> : encoding<schema>
  func.return
}

// ====

func.def @assume_spec_rejects_bad_operand_format(%schema: encoding<schema>) {
  // ERROR@+1: PARSE/017 "element_format" "wat"
  %bad = encoding.assume.spec %schema, #encoding.operand<element_format=wat, payload_elements=32, payload_registers=6> : encoding<schema>
  func.return
}

// ====

// Transform descriptors are verified when declared, before a vector.transform
// use site sees them.
func.def @hadamard_unknown_normalization() {
  // ERROR@+1: PARSE/017 "normalization" "mystery"
  %xf = encoding.define #transform.hadamard<normalization=mystery> : encoding<transform>
  func.return
}

// ====

func.def @storage_dynamic_params() {
  %layout = encoding.layout.dense : encoding<layout>
  %schema = encoding.define #ggml.q4_0 : encoding<schema>
  %storage = encoding.define #encoding.storage {layout = %layout : encoding<layout>, schema = %schema : encoding<schema>} : encoding<storage>
  func.return
}

// ====

func.def @storage_static_params() {
  %storage = encoding.define #encoding.storage<layout=#encoding.layout.dense, schema=#ggml.q4_0> : encoding<storage>
  func.return
}

// ====

func.def @storage_fp8_fnuz_params() {
  %layout = encoding.layout.dense : encoding<layout>
  %ieee_schema = encoding.define #encoding.f8e5m2 : encoding<schema>
  %storage0 = encoding.define #encoding.storage {layout = %layout : encoding<layout>, schema = %ieee_schema : encoding<schema>} : encoding<storage>
  %schema = encoding.define #encoding.f8e4m3fnuz : encoding<schema>
  %storage = encoding.define #encoding.storage {layout = %layout : encoding<layout>, schema = %schema : encoding<schema>} : encoding<storage>
  %storage2 = encoding.define #encoding.storage<layout=#encoding.layout.dense, schema=#encoding.f8e5m2fnuz> : encoding<storage>
  func.return
}

// ====

func.def @operand_fp8_schema_rounding_params() {
  %schema = encoding.define #encoding.f8e4m3fn<rounding=finite_only> : encoding<schema>
  func.return
}

// ====

func.def @operand_fp8_schema_unsupported_param() {
  // ERROR@+1: ENCODING/008 "encoding.operand" "bogus"
  %schema = encoding.define #encoding.f8e4m3fn<bogus=16> : encoding<schema>
  func.return
}

// ====

func.def @operand_fp8_schema_bad_rounding() {
  // ERROR@+1: PARSE/017 "rounding" "wat"
  %schema = encoding.define #encoding.f8e4m3fn<rounding=wat> : encoding<schema>
  func.return
}

// ====

func.def @operand_fp8_schema_rejects_storage_bits() {
  // ERROR@+1: ENCODING/008 "encoding.operand" "storage_bits"
  %schema = encoding.define #encoding.f8e4m3<storage_bits=16> : encoding<schema>
  func.return
}

// ====

func.def @operand_fp8_fnuz_formats() {
  %e4m3 = encoding.define #encoding.operand<element_format=f8e4m3fnuz, payload_elements=8, payload_registers=2> : encoding<schema>
  %e5m2 = encoding.define #encoding.operand<element_format=f8e5m2fnuz, payload_elements=8, payload_registers=2> : encoding<schema>
  func.return
}

// ====

func.def @storage_missing_schema() {
  %layout = encoding.layout.dense : encoding<layout>
  // ERROR@+1: ENCODING/007 {encoding_name="encoding.storage", param_name="schema"}
  %storage = encoding.define #encoding.storage {layout = %layout : encoding<layout>} : encoding<storage>
  func.return
}

// ====

func.def @storage_wrong_layout_type(%x: index) {
  %schema = encoding.define #ggml.q4_0 : encoding<schema>
  // ERROR@+1: ENCODING/009 {encoding_name="encoding.storage", param_name="layout", actual_type="index", expected_type="encoding<layout>"}
  %storage = encoding.define #encoding.storage {layout = %x : index, schema = %schema : encoding<schema>} : encoding<storage>
  func.return
}

// ====

func.def @storage_role_mismatch() {
  %layout = encoding.layout.dense : encoding<layout>
  %schema = encoding.define #ggml.q4_0 : encoding<schema>
  // ERROR@+1: ENCODING/009 {encoding_name="encoding.storage", param_name="layout", actual_type="encoding<schema>", expected_type="encoding<layout>"}
  %storage = encoding.define #encoding.storage {layout = %schema : encoding<schema>, schema = %layout : encoding<layout>} : encoding<storage>
  func.return
}

// ====

func.def @storage_static_role_mismatch() {
  // ERROR@+2: ENCODING/011 {encoding_name="encoding.storage", param_name="layout", expected_role="an address layout encoding"}
  // ERROR@+1: ENCODING/011 {encoding_name="encoding.storage", param_name="schema", expected_role="a storage schema encoding"}
  %storage = encoding.define #encoding.storage<layout=#ggml.q4_0, schema=#encoding.layout.dense> : encoding<storage>
  func.return
}

// ====

func.def @hadamard_default_normalization() {
  %xf = encoding.define #transform.hadamard : encoding<transform>
  func.return
}

