// RUN: verify

func.def @fence_requires_ordering() {
  // ERROR@+1: PARSE/017 "ordering"
  buffer.fence scope(system) ordering(relaxed)
  func.return
}

// ====

func.def @pack_requires_one_or_more_ranges() {
  // ERROR@+1: STRUCTURE/014 "byte_lengths" "0" "at least one physical byte range"
  %total = buffer.pack [] : offset
  func.return
}

// ====

func.def @pack_requires_power_of_two_alignments(%byte_length: offset) {
  // ERROR@+1: STRUCTURE/014 "minimum_alignments[0]" "24" "positive power-of-two byte alignment"
  %total, %byte_offset = buffer.pack [align(24) %byte_length] : offset
  func.return
}

// ====

func.def @fill_rejects_i1_pattern(%target: buffer, %target_offset: offset, %byte_length: offset, %pattern: i1) {
  // ERROR@+1: TYPE/003 "pattern" "i1" "byte-addressable fixed-width integer or floating-point scalar"
  buffer.fill %pattern, %target[%target_offset], %byte_length : i1
  func.return
}

// ====

func.def @fill_rejects_index_pattern(%target: buffer, %target_offset: offset, %byte_length: offset, %pattern: index) {
  // ERROR@+1: TYPE/003 "pattern" "index" "byte-addressable fixed-width integer or floating-point scalar"
  buffer.fill %pattern, %target[%target_offset], %byte_length : index
  func.return
}

// ====

func.def @fill_rejects_offset_pattern(%target: buffer, %target_offset: offset, %byte_length: offset, %pattern: offset) {
  // ERROR@+1: TYPE/003 "pattern" "offset" "byte-addressable fixed-width integer or floating-point scalar"
  buffer.fill %pattern, %target[%target_offset], %byte_length : offset
  func.return
}

// ====

func.def @load_i8_u_requires_offset(%source: buffer, %byte_offset: index) -> (i32) {
  // ERROR@+1: TYPE/003 "byte_offset" "index" "offset"
  %byte = buffer.load.i8.u %source[%byte_offset]
  func.return %byte : i32
}

// ====

func.def @store_i8_requires_i32(%value: i8, %target: buffer, %byte_offset: offset) {
  // ERROR@+1: TYPE/003 "value" "i8" "i32"
  buffer.store.i8 %value, %target[%byte_offset]
  func.return
}

// ====

func.def @positions_do_not_order_roots(%lhs: buffer, %rhs: buffer, %position: offset) {
  // ERROR@+1: PARSE/017 "predicate"
  %before = buffer.compare.address ult, %lhs[%position], %rhs[%position]
  func.return
}

// ====

func.def @positions_require_byte_offsets(%lhs: buffer, %rhs: buffer, %position: index, %origin: offset) -> (i1) {
  // ERROR@+1: TYPE/003 "lhs_offset" "index" "offset"
  %equal = buffer.compare.address eq, %lhs[%position], %rhs[%origin]
  func.return %equal : i1
}

// ====

func.def @restrict_requires_a_restricted_reference(%peer: buffer) -> (buffer) {
  // ERROR@+1: STRUCTURE/014 "restricted operand count" "0" "at least one restricted reference"
  %peer_scoped = buffer.restrict.begin peers %peer : buffer
  func.return %peer_scoped : buffer
}

// ====

func.def @restrict_preserves_value_arity(%source: buffer, %peer: buffer) -> (buffer) {
  // ERROR@+1: STRUCTURE/013 "restricted and peer operands" "2" "results" "1"
  %source_scoped = buffer.restrict.begin %source peers %peer : buffer
  func.return %source_scoped : buffer
}

// ====

func.def @restrict_requires_storage_references(%source: i32) -> (i32) {
  // ERROR@+1: TYPE/003 "reference operand 0" "i32" "buffer or view"
  %source_scoped = buffer.restrict.begin %source : i32
  func.return %source_scoped : i32
}

// ====

func.def @restrict_preserves_reference_type(%source: buffer) -> (view<1xi32>) {
  // ERROR@+1: TYPE/001 "reference operand 0" "buffer" "result 0" "view<1xi32>"
  %source_scoped = buffer.restrict.begin %source : view<1xi32>
  func.return %source_scoped : view<1xi32>
}

// ====

func.def @restrict_end_requires_storage_references(%source: i32) -> (i32) {
  // ERROR@+1: TYPE/003 "reference operand 0" "i32" "buffer or view"
  %source_result = buffer.restrict.end %source : i32
  func.return %source_result : i32
}
