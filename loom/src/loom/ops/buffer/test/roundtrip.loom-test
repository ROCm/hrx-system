// RUN: roundtrip

func.def @thread_memory_fences() {
  buffer.fence scope(system) ordering(acquire)
  buffer.fence scope(system) ordering(release)
  buffer.fence scope(device) ordering(acq_rel)
  buffer.fence scope(system) ordering(seq_cst)
  func.return
}

// ====

func.def @pack_dynamic_ranges(%header_bytes: offset, %payload_bytes: offset) -> (offset, offset, offset) {
  %total, %header_offset, %payload_offset = buffer.pack [align(16) %header_bytes, align(256) %payload_bytes] : offset
  func.return %total, %header_offset, %payload_offset : offset, offset, offset
}

func.def @query_buffer_length(%buffer: buffer) -> (offset) {
  %byte_length = buffer.length %buffer
  func.return %byte_length : offset
}

func.def @view_with_source_address_domain(%buffer: buffer, %offset: offset) -> (view<4x8xf32>) {
  %view = buffer.view %buffer[%offset] address_bits(32) : buffer -> view<4x8xf32>
  func.return %view : view<4x8xf32>
}

// ====

func.def @bulk_byte_operations(%source: buffer, %target: buffer, %source_offset: offset, %target_offset: offset, %byte_length: offset, %pattern: bf16) -> (i32) {
  %byte = buffer.load.i8.u %source[%source_offset]
  buffer.store.i8 %byte, %target[%target_offset]
  buffer.copy %source[%source_offset], %target[%target_offset], %byte_length
  buffer.fill %pattern, %target[%target_offset], %byte_length : bf16
  %order = buffer.compare %source[%source_offset], %target[%target_offset], %byte_length
  func.return %order : i32
}
