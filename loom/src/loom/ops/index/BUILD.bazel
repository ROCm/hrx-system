load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test", "loom_generated_cc_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

# Declarations and accessors can be consumed by shared analyses without linking
# the dialect's inference and rewrite implementation back into those analyses.
loom_cc_library(
    name = "op_defs",
    hdrs = ["ops.h"],
    textual_hdrs = ["ops.inc"],
    deps = ["//loom/src/loom/ops:op_defs"],
)

loom_cc_library(
    name = "cast",
    srcs = ["cast.c"],
    hdrs = ["cast.h"],
    deps = [
        "//loom/src/loom/ir",
        "//loom/src/loom/ir:facts",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal",
    ],
)

loom_cc_library(
    name = "comparison",
    srcs = [
        "carrier.c",
        "compare.c",
    ],
    hdrs = [
        "carrier.h",
        "compare.h",
    ],
    deps = [
        ":op_defs",
        "//loom/src/loom/ir",
        "//loom/src/loom/ir:facts",
        "//loom/src/loom/target:facts",
        "//loom/src/loom/util:fact_table_api",
    ],
)

loom_generated_cc_library(
    name = "index",
    srcs = [
        "canonicalize.c",
        "facts.c",
        "verify.c",
    ],
    hdrs = [
        "carrier.h",
        "compare.h",
        "ops.h",
    ],
    args = ["--dialect=index"],
    extra_output_flags = ["--ops-include"],
    extra_outputs = ["ops.inc"],
    generated_src_flags = [
        "--builders",
        "--tables",
    ],
    generated_srcs = [
        "builders.c",
        "tables.c",
    ],
    generator = "//loom/py/loom/gen/ops:c_tables_index_generator",
    textual_hdrs = ["ops.inc"],
    deps = [
        ":cast",
        ":comparison",
        ":op_defs",
        "//loom/src/loom/error:emitter",
        "//loom/src/loom/error:error_defs",
        "//loom/src/loom/error:parameter",
        "//loom/src/loom/ir",
        "//loom/src/loom/ir:facts",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/ops/scalar",
        "//loom/src/loom/rewrite:rewriter",
        "//loom/src/loom/target:facts",
        "//loom/src/loom/util:fact_table",
        "//loom/src/loom/util:predicate_facts",
        "//runtime/src/iree/base/internal",
    ],
)

loom_cc_test(
    name = "carrier_test",
    srcs = ["carrier_test.cc"],
    deps = [
        ":index",
        "//loom/src/loom/target:facts",
        "//loom/src/loom/util:fact_table",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
