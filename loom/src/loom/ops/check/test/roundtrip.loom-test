// RUN: roundtrip

// A correctness case is a program: it materializes inputs, calls the function
// under test, obtains expected values, and checks ordinary SSA results.
func.decl @scale(%input: tensor<4xf32>) -> (tensor<4xf32>)

check.case public @scale_case {
  %seed = check.param.seed base(1282371437) count(4) name("seed") : i64
  %input = check.generate.random.uniform seed(%seed) range(-1.0 to 1.0) : tensor<4xf32>
  %actual = func.call @scale(%input) : (tensor<4xf32>) -> (tensor<4xf32>)
  %expected = check.oracle.call<reference.scalar> callee(@scale) inputs(%input) : (tensor<4xf32>) -> (tensor<4xf32>)
  %expected_contract = check.oracle.call<reference.tiled_matmul> {accumulator = "i32", lhs = "u8", result = "i32", rhs = "u8"} callee(@scale) inputs(%input) : (tensor<4xf32>) -> (tensor<4xf32>)
  check.expect.close actual(%actual) expected(%expected) atol(0.0001) rtol(0.0001) nan(same) : tensor<4xf32>
  test.use %expected_contract : tensor<4xf32>
  check.return
}

check.benchmark<@scale_case> @scale_latency {seed = 1282371438}

// ====

// Standard generator/file/expectation ops use fixed clauses, not generic bags.
check.case @fixture_case {
  %m = check.param.range po2 bounds(1 to 64) name("m") : index
  %n = check.param.choice values([16, 24, 32, 64]) name("n") : index
  %seed = check.param.seed base(4660) count(8) name("seed") : i64
  %scalar = check.literal value(42) : i32
  %iota = check.generate.iota offset(0) step(1) : tensor<[%m]x4xi32>
  %fill = check.generate.fill value(17) : tensor<[%m]x4xi32>
  %uniform = check.generate.random.uniform seed(%seed) range(-1.0 to 1.0) : tensor<[%n]xf32>
  %expected = check.file.read.npy path("fixtures/vector.npy") : tensor<[%n]xf32>
  %uniform_tail = check.tensor.view %uniform offset(16) : tensor<[%n]xf32> -> tensor<4xf32>
  check.expect.equal actual(%scalar) expected(%scalar) : i32
  check.expect.bitwise actual(%uniform) expected(%expected) : tensor<[%n]xf32>
  check.expect.shape value(%iota) shape([%m, 4]) : tensor<[%m]x4xi32>
  check.expect.shape value(%uniform_tail) shape([4]) : tensor<4xf32>
  check.file.write.npy value(%uniform) path("outputs/vector.actual.npy") mode(on_failure) : tensor<[%n]xf32>
  test.use %fill : tensor<[%m]x4xi32>
  check.return
}

check.benchmark<@fixture_case> @fixture_sweep

check.benchmark<@fixture_case> @fixture_m16_n24 {m = 16, n = 24}

// ====

// Open provider spaces are still cold structural dispatch points.
check.case @provider_case {
  check.requires<target.feature> {feature = "test.feature"}
  check.skip_if<device.memory> {max_bytes = 1024} reason("tiny device")
  %actual = check.literal value(1) : i32
  %expected = check.literal value(1) : i32
  check.expect.event<device> {count = 1, severity = "error", tsan = {access_length = 4, check = "data_race", current_access = "write", memory = "workgroup", prior_access = "write"}, type = "tsan_report"}
  check.return
}

// ====

// A scenario owns several independent trial domains. Entropy forks are named
// and reads are explicitly indexed, so generators can replay any trial without
// depending on the traversal order of its siblings.
func.decl @logarithm(%bits: i32) -> (f32, vector<4xf32>)

func.decl @logarithm_oracle(%bits: i32) -> (f32, vector<4xf32>)

func.decl @dependent_result() -> (%width: index, vector<[%width]xf32>)

check.scenario public @math_scenario {
  check.trial[32](%trial: index, %entropy: check.entropy) {
    %pair_entropy = check.entropy.fork %entropy name("input_pair") : check.entropy
    %word = check.entropy.read %pair_entropy[%trial] : check.entropy -> i64
    %bits = check.literal value(1065353216) : i32
    check.compare<@logarithm, @logarithm_oracle>(%bits) : (i32) -> [actual(%actual_log2: f32, %actual_exp2: vector<4xf32>), expected(%expected_log2: f32, %expected_exp2: vector<4xf32>)] {
      check.expect.close actual(%actual_log2) expected(%expected_log2) atol(0.0) rtol(9.9999999999999995e-07) nan(same) : f32
      check.expect.close actual(%actual_exp2) expected(%expected_exp2) atol(0.0) rtol(9.9999999999999995e-07) nan(same) : vector<4xf32>
    }
  }
  check.trial[4](%trial: index, %entropy: check.entropy) {
    %bits = check.literal value(1065353216) : i32
    check.invoke<@logarithm>(%bits) : (i32) -> (f32, vector<4xf32>)
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    check.invoke<@dependent_result>() : () -> (%width: index, vector<[%width]xf32>)
  }
  check.return
}

check.benchmark<@math_scenario> @math_throughput

// ====

// Configuration values are captured by nested trials and form the kernel
// workload group. Runtime trial values remain ordinary call arguments.
kernel.decl @configured_kernel(%workload: index) launch()

check.scenario @configured_scenario configure[8](%configuration: index, %entropy: check.entropy) {
  check.trial[16](%trial: index, %trial_entropy: check.entropy) {
    check.invoke<@configured_kernel>[%configuration]() : [index]() -> ()
  }
  check.return
}

// ====

// Void comparisons use a canonical empty result pair while retaining an
// explicit comparison body for checks over captured mutable arguments.
func.decl @update(%value: i32)

check.scenario @void_comparison {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %value = check.literal value(0) : i32
    check.compare<@update>(%value) : (i32) -> () {
      check.expect.equal actual(%value) expected(%value) : i32
    }
  }
  check.return
}
