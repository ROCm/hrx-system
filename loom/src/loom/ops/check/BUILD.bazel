load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test", "loom_generated_cc_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_cc_library(
    name = "op_defs",
    hdrs = ["ops.h"],
    textual_hdrs = ["ops.inc"],
    deps = ["//loom/src/loom/ops:headers"],
)

loom_cc_library(
    name = "builders",
    srcs = ["builders.c"],
    hdrs = ["ops.h"],
    textual_hdrs = ["ops.inc"],
    deps = [
        "//loom/src/loom/ir:builders",
        "//loom/src/loom/ops:op_defs",
    ],
)

loom_generated_cc_library(
    name = "check",
    srcs = ["verify.c"],
    hdrs = ["ops.h"],
    args = ["--dialect=check"],
    extra_output_flags = [
        "--ops-include",
        "--builders",
    ],
    extra_outputs = [
        "ops.inc",
        "builders.c",
    ],
    generated_src_flags = ["--tables"],
    generated_srcs = ["tables.c"],
    generator = "//loom/py/loom/gen/ops:c_tables_check_generator",
    textual_hdrs = ["ops.inc"],
    deps = [
        ":builders",
        "//loom/src/loom/error:emitter",
        "//loom/src/loom/error:error_defs",
        "//loom/src/loom/error:parameter",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:function_contract_verify",
        "//loom/src/loom/ops:op_defs",
        "//runtime/src/iree/base",
    ],
)

loom_cc_test(
    name = "ops_test",
    srcs = ["ops_test.cc"],
    deps = [
        ":check",
        "//loom/src/loom/format/bytecode:reader",
        "//loom/src/loom/format/bytecode:writer",
        "//loom/src/loom/ir",
        "//loom/src/loom/verify",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/io:stream",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
