// RUN: pass canonicalize

// Counted queue facts include values arriving after every carried slot.
func.def @shift_for(%count: index, %input: i64) -> (i64) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %seed = scalar.constant 0 : i64
  %out0, %out1, %out2, %out3, %out4, %out5, %out6, %out7, %out8, %out9, %out10, %out11 = scf.for %iv = [%begin to %count step %step](%slot0 = %seed : i64, %slot1 = %seed : i64, %slot2 = %seed : i64, %slot3 = %seed : i64, %slot4 = %seed : i64, %slot5 = %seed : i64, %slot6 = %seed : i64, %slot7 = %seed : i64, %slot8 = %seed : i64, %slot9 = %seed : i64, %slot10 = %seed : i64, %slot11 = %seed : i64) -> (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) {
    %head_high = test.fact_range_hi %slot0 : i64 -> i64
    test.use %head_high : i64
    scf.yield %slot1, %slot2, %slot3, %slot4, %slot5, %slot6, %slot7, %slot8, %slot9, %slot10, %slot11, %input : i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64
  }
  %high = test.fact_range_hi %out0 : i64 -> i64
  func.return %high : i64
}

// ----
func.def @shift_for(%count: index, %input: i64) -> (i64) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %seed = scalar.constant 0 : i64
  %out0, %out1, %out2, %out3, %out4, %out5, %out6, %out7, %out8, %out9, %out10, %out11 = scf.for %iv = [%begin to %count step %step](%slot0 = %seed : i64, %slot1 = %seed : i64, %slot2 = %seed : i64, %slot3 = %seed : i64, %slot4 = %seed : i64, %slot5 = %seed : i64, %slot6 = %seed : i64, %slot7 = %seed : i64, %slot8 = %seed : i64, %slot9 = %seed : i64, %slot10 = %seed : i64, %slot11 = %seed : i64) -> (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) {
    %head_high = scalar.constant 9223372036854775807 : i64
    test.use %head_high : i64
    scf.yield %slot1, %slot2, %slot3, %slot4, %slot5, %slot6, %slot7, %slot8, %slot9, %slot10, %slot11, %input : i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64
  }
  %high = scalar.constant 9223372036854775807 : i64
  func.return %high : i64
}

// ====

// Condition-region queues propagate the same delayed state to the exit.
func.def @shift_while(%input: i64, %condition: i1) -> (i64) {
  %seed = scalar.constant 0 : i64
  %out0, %out1, %out2, %out3, %out4, %out5, %out6, %out7, %out8, %out9, %out10, %out11 = scf.while(%slot0 = %seed : i64, %slot1 = %seed : i64, %slot2 = %seed : i64, %slot3 = %seed : i64, %slot4 = %seed : i64, %slot5 = %seed : i64, %slot6 = %seed : i64, %slot7 = %seed : i64, %slot8 = %seed : i64, %slot9 = %seed : i64, %slot10 = %seed : i64, %slot11 = %seed : i64) -> (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) {
    %head_high = test.fact_range_hi %slot0 : i64 -> i64
    test.use %head_high : i64
    scf.condition %condition, %slot0, %slot1, %slot2, %slot3, %slot4, %slot5, %slot6, %slot7, %slot8, %slot9, %slot10, %slot11 : i1, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64
  } do(%next0: i64, %next1: i64, %next2: i64, %next3: i64, %next4: i64, %next5: i64, %next6: i64, %next7: i64, %next8: i64, %next9: i64, %next10: i64, %next11: i64) {
    scf.yield %next1, %next2, %next3, %next4, %next5, %next6, %next7, %next8, %next9, %next10, %next11, %input : i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64
  }
  %high = test.fact_range_hi %out0 : i64 -> i64
  func.return %high : i64
}

// ----
func.def @shift_while(%input: i64, %condition: i1) -> (i64) {
  %seed = scalar.constant 0 : i64
  %out0, %out1, %out2, %out3, %out4, %out5, %out6, %out7, %out8, %out9, %out10, %out11 = scf.while(%slot0 = %seed : i64, %slot1 = %seed : i64, %slot2 = %seed : i64, %slot3 = %seed : i64, %slot4 = %seed : i64, %slot5 = %seed : i64, %slot6 = %seed : i64, %slot7 = %seed : i64, %slot8 = %seed : i64, %slot9 = %seed : i64, %slot10 = %seed : i64, %slot11 = %seed : i64) -> (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) {
    %head_high = scalar.constant 9223372036854775807 : i64
    test.use %head_high : i64
    scf.condition %condition, %slot0, %slot1, %slot2, %slot3, %slot4, %slot5, %slot6, %slot7, %slot8, %slot9, %slot10, %slot11 : i1, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64
  } do(%next0: i64, %next1: i64, %next2: i64, %next3: i64, %next4: i64, %next5: i64, %next6: i64, %next7: i64, %next8: i64, %next9: i64, %next10: i64, %next11: i64) {
    scf.yield %next1, %next2, %next3, %next4, %next5, %next6, %next7, %next8, %next9, %next10, %next11, %input : i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64
  }
  %high = scalar.constant 9223372036854775807 : i64
  func.return %high : i64
}

// ====

// Computed selections propagate finite values past the precise widening rounds.
func.def @selected_finite_queue(%count: index, %hold: i1) -> (i1) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %seed = scalar.constant 1.0 : f32
  %replacement = scalar.constant 2.0 : f32
  %head, %middle, %tail = scf.for %iv = [%begin to %count step %step](%a = %seed : f32, %b = %seed : f32, %c = %seed : f32) -> (f32, f32, f32) {
    %next_a = scf.select %hold, %a, %b : f32
    %next_b = scf.select %hold, %b, %c : f32
    %next_c = scf.select %hold, %c, %replacement : f32
    scf.yield %next_a, %next_b, %next_c : f32, f32, f32
  }
  %finite = scalar.isfinitef %head : f32
  func.return %finite : i1
}

// ----
func.def @selected_finite_queue(%count: index, %hold: i1) -> (i1) {
  %finite = scalar.constant true : i1
  func.return %finite : i1
}

// ====

// A delayed NaN crosses more computed edges than the solver budget.
// Unconverged state cannot justify a finite classification.
func.def @selected_nan_queue(%count: index, %hold: i1) -> (i1) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %seed = scalar.constant 1.0 : f32
  %nan_bits = scalar.constant 2143289345 : i32
  %replacement = scalar.bitcast %nan_bits : i32 to f32
  %out0, %out1, %out2, %out3, %out4, %out5, %out6, %out7, %out8, %out9 = scf.for %iv = [%begin to %count step %step](%slot0 = %seed : f32, %slot1 = %seed : f32, %slot2 = %seed : f32, %slot3 = %seed : f32, %slot4 = %seed : f32, %slot5 = %seed : f32, %slot6 = %seed : f32, %slot7 = %seed : f32, %slot8 = %seed : f32, %slot9 = %seed : f32) -> (f32, f32, f32, f32, f32, f32, f32, f32, f32, f32) {
    %next0 = scf.select %hold, %slot0, %slot1 : f32
    %next1 = scf.select %hold, %slot1, %slot2 : f32
    %next2 = scf.select %hold, %slot2, %slot3 : f32
    %next3 = scf.select %hold, %slot3, %slot4 : f32
    %next4 = scf.select %hold, %slot4, %slot5 : f32
    %next5 = scf.select %hold, %slot5, %slot6 : f32
    %next6 = scf.select %hold, %slot6, %slot7 : f32
    %next7 = scf.select %hold, %slot7, %slot8 : f32
    %next8 = scf.select %hold, %slot8, %slot9 : f32
    %next9 = scf.select %hold, %slot9, %replacement : f32
    scf.yield %next0, %next1, %next2, %next3, %next4, %next5, %next6, %next7, %next8, %next9 : f32, f32, f32, f32, f32, f32, f32, f32, f32, f32
  }
  %finite = scalar.isfinitef %out0 : f32
  func.return %finite : i1
}

// ====

// RUN: pass canonicalize

// A bounded count includes zero iterations. Body rows exclude the terminal
// decrement, while result rows retain every possible stopping point.
func.def @bounded_for_remaining_rows(%requested_count: index) -> (i64, i64) {
  %count = index.assume %requested_count [range(%requested_count, 0, 3)] : index
  %first_iteration = index.constant 0 : index
  %iteration_step = index.constant 1 : index
  %initial_rows = index.constant 8 : index
  %row_step = index.constant 1 : index
  %remaining_rows = scf.for %iteration = [%first_iteration to %count step %iteration_step](%rows = %initial_rows : index) -> (index) {
    %body_low = test.fact_range_lo %rows : index -> i64
    %body_high = test.fact_range_hi %rows : index -> i64
    test.use %body_low, %body_high : i64, i64
    %next_rows = index.sub %rows, %row_step : index
    scf.yield %next_rows : index
  }
  %result_low = test.fact_range_lo %remaining_rows : index -> i64
  %result_high = test.fact_range_hi %remaining_rows : index -> i64
  func.return %result_low, %result_high : i64, i64
}

// ----
func.def @bounded_for_remaining_rows(%requested_count: index) -> (i64, i64) {
  %count = index.assume %requested_count [range(%requested_count, 0, 3)] : index
  %first_iteration = index.constant 0 : index
  %iteration_step = index.constant 1 : index
  %initial_rows = index.constant 8 : index
  %row_step = index.constant 1 : index
  %remaining_rows = scf.for %iteration = [%first_iteration to %count step %iteration_step](%rows = %initial_rows : index) -> (index) {
    %body_low = scalar.constant 6 : i64
    %body_high = scalar.constant 8 : i64
    test.use %body_low, %body_high : i64, i64
    %next_rows = index.sub %rows, %row_step : index
    scf.yield %next_rows : index
  }
  %result_low = scalar.constant 5 : i64
  %result_high = scalar.constant 8 : i64
  func.return %result_low, %result_high : i64, i64
}

// ====

// RUN: pass canonicalize

// The independent counter bounds a descending scalar companion through the
// condition/body forwarding tuple without making the exit count exact.
func.def @bounded_while_remaining_rows(%requested_count: index) -> (i64, i64) {
  %count = index.assume %requested_count [range(%requested_count, 0, 3)] : index
  %first_iteration = index.constant 0 : index
  %iteration_step = index.constant 1 : index
  %initial_rows = scalar.constant 8 : i32
  %row_step = scalar.constant 1 : i32
  %iteration_end, %remaining_rows = scf.while(%header_iteration = %first_iteration : index, %header_rows = %initial_rows : i32) -> (index, i32) {
    %header_low = test.fact_range_lo %header_rows : i32 -> i64
    %header_high = test.fact_range_hi %header_rows : i32 -> i64
    test.use %header_low, %header_high : i64, i64
    %has_iteration = index.cmp slt, %header_iteration, %count : index
    scf.condition %has_iteration, %header_iteration, %header_rows : i1, index, i32
  } do(%iteration: index, %rows: i32) {
    %body_low = test.fact_range_lo %rows : i32 -> i64
    %body_high = test.fact_range_hi %rows : i32 -> i64
    test.use %body_low, %body_high : i64, i64
    %next_iteration = index.add %iteration, %iteration_step : index
    %next_rows = scalar.subi %rows, %row_step : i32
    scf.yield %next_iteration, %next_rows : index, i32
  }
  %result_low = test.fact_range_lo %remaining_rows : i32 -> i64
  %result_high = test.fact_range_hi %remaining_rows : i32 -> i64
  func.return %result_low, %result_high : i64, i64
}

// ----
func.def @bounded_while_remaining_rows(%requested_count: index) -> (i64, i64) {
  %count = index.assume %requested_count [range(%requested_count, 0, 3)] : index
  %first_iteration = index.constant 0 : index
  %iteration_step = index.constant 1 : index
  %initial_rows = scalar.constant 8 : i32
  %iteration_end, %remaining_rows = scf.while(%header_iteration = %first_iteration : index, %header_rows = %initial_rows : i32) -> (index, i32) {
    %header_low = scalar.constant 5 : i64
    %header_high = scalar.constant 8 : i64
    test.use %header_low, %header_high : i64, i64
    %has_iteration = index.cmp slt, %header_iteration, %count : index
    scf.condition %has_iteration, %header_iteration, %header_rows : i1, index, i32
  } do(%iteration: index, %rows: i32) {
    %body_low = scalar.constant 6 : i64
    %body_high = scalar.constant 8 : i64
    test.use %body_low, %body_high : i64, i64
    %next_iteration = index.add %iteration, %iteration_step : index
    %25 = scalar.constant -1 : i32
    %next_rows = scalar.addi %rows, %25 : i32
    scf.yield %next_iteration, %next_rows : index, i32
  }
  %result_low = scalar.constant 5 : i64
  %result_high = scalar.constant 8 : i64
  func.return %result_low, %result_high : i64, i64
}

// ====

// RUN: pass canonicalize

// Cropping in the condition also executes on the final false evaluation.
// The bounded countdown limits body executions, not condition evaluations.
func.def @descending_condition_rows(%requested_count: index) -> (i64, i64) {
  %count = index.assume %requested_count [range(%requested_count, 0, 3)] : index
  %exhausted = index.constant 0 : index
  %iteration_step = index.constant 1 : index
  %initial_rows = index.constant 8 : index
  %row_step = index.constant 1 : index
  %remaining_end, %rows_end = scf.while(%header_remaining = %count : index, %header_rows = %initial_rows : index) -> (index, index) {
    %header_low = test.fact_range_lo %header_rows : index -> i64
    %header_high = test.fact_range_hi %header_rows : index -> i64
    test.use %header_low, %header_high : i64, i64
    %has_iteration = index.cmp sgt, %header_remaining, %exhausted : index
    %forward_rows = index.sub %header_rows, %row_step : index
    scf.condition %has_iteration, %header_remaining, %forward_rows : i1, index, index
  } do(%remaining: index, %rows: index) {
    %body_low = test.fact_range_lo %rows : index -> i64
    %body_high = test.fact_range_hi %rows : index -> i64
    test.use %body_low, %body_high : i64, i64
    %next_remaining = index.sub %remaining, %iteration_step : index
    scf.yield %next_remaining, %rows : index, index
  }
  %result_low = test.fact_range_lo %rows_end : index -> i64
  %result_high = test.fact_range_hi %rows_end : index -> i64
  func.return %result_low, %result_high : i64, i64
}

// ----
func.def @descending_condition_rows(%requested_count: index) -> (i64, i64) {
  %count = index.assume %requested_count [range(%requested_count, 0, 3)] : index
  %exhausted = index.constant 0 : index
  %iteration_step = index.constant 1 : index
  %initial_rows = index.constant 8 : index
  %row_step = index.constant 1 : index
  %remaining_end, %rows_end = scf.while(%header_remaining = %count : index, %header_rows = %initial_rows : index) -> (index, index) {
    %header_low = scalar.constant 5 : i64
    %header_high = scalar.constant 8 : i64
    test.use %header_low, %header_high : i64, i64
    %has_iteration = index.cmp sgt, %header_remaining, %exhausted : index
    %forward_rows = index.sub %header_rows, %row_step : index
    scf.condition %has_iteration, %header_remaining, %forward_rows : i1, index, index
  } do(%remaining: index, %rows: index) {
    %body_low = scalar.constant 4 : i64
    %body_high = scalar.constant 7 : i64
    test.use %body_low, %body_high : i64, i64
    %next_remaining = index.sub %remaining, %iteration_step : index
    scf.yield %next_remaining, %rows : index, index
  }
  %result_low = scalar.constant 4 : i64
  %result_high = scalar.constant 7 : i64
  func.return %result_low, %result_high : i64, i64
}

// ====

// RUN: pass canonicalize

// An inclusive unsigned guard with the counter on the right still bounds an
// additive negative step. Zero remains an empty-loop input.
func.def @reversed_unsigned_countdown_rows(%requested_count: index) -> (i64, i64) {
  %count = index.assume %requested_count [range(%requested_count, 0, 3)] : index
  %minimum_remaining = index.constant 1 : index
  %counter_delta = index.constant -1 : index
  %initial_rows = scalar.constant 8 : i32
  %row_step = scalar.constant 1 : i32
  %remaining_end, %rows_end = scf.while(%header_remaining = %count : index, %header_rows = %initial_rows : i32) -> (index, i32) {
    %header_low = test.fact_range_lo %header_rows : i32 -> i64
    %header_high = test.fact_range_hi %header_rows : i32 -> i64
    test.use %header_low, %header_high : i64, i64
    %has_iteration = index.cmp ule, %minimum_remaining, %header_remaining : index
    scf.condition %has_iteration, %header_remaining, %header_rows : i1, index, i32
  } do(%remaining: index, %rows: i32) {
    %body_low = test.fact_range_lo %rows : i32 -> i64
    %body_high = test.fact_range_hi %rows : i32 -> i64
    test.use %body_low, %body_high : i64, i64
    %next_remaining = index.add %remaining, %counter_delta : index
    %next_rows = scalar.subi %rows, %row_step : i32
    scf.yield %next_remaining, %next_rows : index, i32
  }
  %result_low = test.fact_range_lo %rows_end : i32 -> i64
  %result_high = test.fact_range_hi %rows_end : i32 -> i64
  func.return %result_low, %result_high : i64, i64
}

// ----
func.def @reversed_unsigned_countdown_rows(%requested_count: index) -> (i64, i64) {
  %count = index.assume %requested_count [range(%requested_count, 0, 3)] : index
  %minimum_remaining = index.constant 1 : index
  %counter_delta = index.constant -1 : index
  %initial_rows = scalar.constant 8 : i32
  %remaining_end, %rows_end = scf.while(%header_remaining = %count : index, %header_rows = %initial_rows : i32) -> (index, i32) {
    %header_low = scalar.constant 5 : i64
    %header_high = scalar.constant 8 : i64
    test.use %header_low, %header_high : i64, i64
    %has_iteration = index.cmp ule, %minimum_remaining, %header_remaining : index
    scf.condition %has_iteration, %header_remaining, %header_rows : i1, index, i32
  } do(%remaining: index, %rows: i32) {
    %body_low = scalar.constant 6 : i64
    %body_high = scalar.constant 8 : i64
    test.use %body_low, %body_high : i64, i64
    %next_remaining = index.add %remaining, %counter_delta : index
    %25 = scalar.constant -1 : i32
    %next_rows = scalar.addi %rows, %25 : i32
    scf.yield %next_remaining, %next_rows : index, i32
  }
  %result_low = scalar.constant 5 : i64
  %result_high = scalar.constant 8 : i64
  func.return %result_low, %result_high : i64, i64
}
