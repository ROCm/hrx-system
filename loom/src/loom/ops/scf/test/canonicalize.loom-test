// The true edge proves zero; the original signed input remains available on
// the other edge and after the conditional.
func.def @unsigned_bound_proves_guarded_offset(%position: i64, %storage: buffer) -> (i64) {
  %limit = scalar.constant 1 : i64
  %inside = scalar.cmpi ult, %position, %limit : i64
  scf.if %inside {
    %offset = index.cast %position : i64 to offset
    %value = scalar.constant 42 : i32
    buffer.store.i8 %value, %storage[%offset]
  }
  func.return %position : i64
}

