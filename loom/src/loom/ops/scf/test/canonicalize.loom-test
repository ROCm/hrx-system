// RUN: pass canonicalize

// An empty true arm becomes a single guard on the inverted condition. The
// effectful load and store remain conditional and retain their source order.
func.def @empty_then_guard(%stop: i1, %input: view<1xi32>, %output: view<1xi32>) {
  scf.if %stop {
  } else {
    %value = view.load %input[0] : view<1xi32> -> i32
    view.store %value, %output[0] : i32, view<1xi32>
  }
  func.return
}

// ----
func.def @empty_then_guard(%stop: i1, %input: view<1xi32>, %output: view<1xi32>) {
  %4 = scalar.constant true : i1
  %5 = scalar.xori %stop, %4 : i1
  scf.if %5 {
    %value = view.load %input[0] : view<1xi32> -> i32
    view.store %value, %output[0] : i32, view<1xi32>
  }
  func.return
}

// ====

// A true arm that only yields a value still defines a result. Its alternate
// load remains guarded and the result tuple retains both incoming values.
func.def @yield_only_then_keeps_result(%stop: i1, %input: view<1xi32>, %fallback: i32) -> (i32) {
  %result = scf.if %stop -> (i32) {
    scf.yield %fallback : i32
  } else {
    %value = view.load %input[0] : view<1xi32> -> i32
    scf.yield %value : i32
  }
  func.return %result : i32
}

// ====

// Moving the live arm preserves nested region ownership and loop effects.
func.def @empty_then_loop(%stop: i1, %output: view<1xi32>, %count: index, %value: i32) {
  scf.if %stop {
  } else {
    %start = index.constant 0 : index
    %step = index.constant 1 : index
    scf.for %iteration = [%start to %count step %step] {
      view.store %value, %output[0] : i32, view<1xi32>
    }
  }
  func.return
}

// ----
func.def @empty_then_loop(%stop: i1, %output: view<1xi32>, %count: index, %value: i32) {
  %7 = scalar.constant true : i1
  %8 = scalar.xori %stop, %7 : i1
  scf.if %8 {
    %start = index.constant 0 : index
    %step = index.constant 1 : index
    scf.for %iteration = [%start to %count step %step] {
      view.store %value, %output[0] : i32, view<1xi32>
    }
  }
  func.return
}

// ====

// Constant-condition scf.if inlines the selected branch and erases the
// unselected branch. Selected body ops keep their order and become ordinary
// enclosing-block ops.
func.def @if_true_inlines_selected_branch(%value: f32) -> (f32) {
  %cond = scalar.constant true : i1
  %result = scf.if %cond -> (f32) {
    %doubled = scalar.addf %value, %value : f32
    scf.yield %doubled : f32
  } else {
    %negated = scalar.negf %value : f32
    scf.yield %negated : f32
  }
  func.return %result : f32
}

// ----
func.def @if_true_inlines_selected_branch(%value: f32) -> (f32) {
  %doubled = scalar.addf %value, %value : f32
  func.return %doubled : f32
}

// ====

// Side effects in the selected branch stay live; side effects in the
// unselected branch disappear because the branch is unreachable.
func.def @if_false_keeps_selected_store(%buffer: buffer, %offset: offset, %value: f32) {
  %layout = encoding.layout.dense : encoding<layout>
  %view = buffer.view %buffer[%offset] : buffer -> view<1xf32, %layout>
  %cond = scalar.constant false : i1
  %c0 = scalar.constant 0.0 : f32
  scf.if %cond {
    view.store %c0, %view[0] : f32, view<1xf32, %layout>
  } else {
    view.store %value, %view[0] : f32, view<1xf32, %layout>
  }
  func.return
}

// ----
func.def @if_false_keeps_selected_store(%buffer: buffer, %offset: offset, %value: f32) {
  %view = buffer.view %buffer[%offset] : buffer -> view<1xf32>
  view.store %value, %view[0] : f32, view<1xf32>
  func.return
}

// ====

// A dynamic signed index comparison can still prune scf.if once range facts
// prove the condition exact.
func.def @if_prunes_from_signed_index_range(%x: index, %y: index) -> (index) {
  %lo = index.assume %x [range(%x, 0, 4)] : index
  %hi = index.assume %y [range(%y, 8, 16)] : index
  %cond = index.cmp slt, %lo, %hi : index
  %result = scf.if %cond -> (index) {
    %c1 = index.constant 1 : index
    scf.yield %c1 : index
  } else {
    %c2 = index.constant 2 : index
    scf.yield %c2 : index
  }
  func.return %result : index
}

// ----
func.def @if_prunes_from_signed_index_range(%x: index, %y: index) -> (index) {
  %c1 = index.constant 1 : index
  func.return %c1 : index
}

// ====

// Unsigned comparisons prune through scf.if when the address facts prove both
// operands are non-negative.
func.def @if_prunes_from_unsigned_index_range(%x: index, %y: index) -> (index) {
  %lo = index.assume %x [range(%x, 0, 4)] : index
  %hi = index.assume %y [range(%y, 8, 16)] : index
  %cond = index.cmp ugt, %lo, %hi : index
  %result = scf.if %cond -> (index) {
    %c1 = index.constant 1 : index
    scf.yield %c1 : index
  } else {
    %c2 = index.constant 2 : index
    scf.yield %c2 : index
  }
  func.return %result : index
}

// ----
func.def @if_prunes_from_unsigned_index_range(%x: index, %y: index) -> (index) {
  %c2 = index.constant 2 : index
  func.return %c2 : index
}

// ====

// A maybe-negative operand keeps unsigned comparison branches alive because
// signed interval separation does not imply unsigned order.
func.def @if_preserves_inconclusive_unsigned_cmp(%x: index, %y: index) -> (index) {
  %maybe_negative = index.assume %x [range(%x, -4, 4)] : index
  %positive = index.assume %y [range(%y, 8, 16)] : index
  %cond = index.cmp ult, %maybe_negative, %positive : index
  %result = scf.if %cond -> (index) {
    %c1 = index.constant 1 : index
    scf.yield %c1 : index
  } else {
    %c2 = index.constant 2 : index
    scf.yield %c2 : index
  }
  func.return %result : index
}

// ----
func.def @if_preserves_inconclusive_unsigned_cmp(%x: index, %y: index) -> (index) {
  %maybe_negative = index.assume %x [range(%x, -4, 4)] : index
  %positive = index.assume %y [range(%y, 8, 16)] : index
  %cond = index.cmp ult, %maybe_negative, %positive : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %result = scf.select %cond, %c1, %c2 : index
  func.return %result : index
}

// ====

// Dialect-owned condition refinements use generic branch analysis and only
// materialize when the selected source is consumed inside the region.
func.def @if_materializes_dialect_condition_refinement(%value: index) {
  %condition = test.condition_refines_positive %value : index
  scf.if %condition {
    test.use %value : index
  }
  func.return
}

// ----
func.def @if_materializes_dialect_condition_refinement(%value: index) {
  %condition = test.condition_refines_positive %value : index
  scf.if %condition {
    %2 = index.assume %value [gt(%value, 0)] : index
    test.use %2 : index
  }
  func.return
}

// ====

// Multiple semantic conditions on one source form one edge-local refinement
// chain. The final replacement dominates ordinary region uses.
func.def @if_chains_dialect_condition_refinements(%value: index) {
  %first = test.condition_refines_positive %value : index
  %second = test.condition_refines_positive %value : index
  %condition = scalar.andi %first, %second : i1
  scf.if %condition {
    test.use %value : index
  }
  func.return
}

// ----
func.def @if_chains_dialect_condition_refinements(%value: index) {
  %first = test.condition_refines_positive %value : index
  %second = test.condition_refines_positive %value : index
  %condition = scalar.andi %first, %second : i1
  scf.if %condition {
    %4 = index.assume %value [gt(%value, 0)] : index
    test.use %4 : index
  }
  func.return
}

// ====

// Branch-edge facts materialize as region-local assumes, allowing both sides of
// a dynamic condition to fold predicates that are only known on that edge.
func.def @if_condition_relation_folds_inside_regions(%i: index, %n: index) -> (i1) {
  %cond = index.cmp slt, %i, %n : index
  %result = scf.if %cond -> (i1) {
    %then_known = index.cmp slt, %i, %n : index
    scf.yield %then_known : i1
  } else {
    %else_known = index.cmp sge, %i, %n : index
    scf.yield %else_known : i1
  }
  func.return %result : i1
}

// ----
func.def @if_condition_relation_folds_inside_regions(%i: index, %n: index) -> (i1) {
  %result = scalar.constant true : i1
  func.return %result : i1
}

// ====

func.def @if_selectifies_region_assumes_before_speculating(%x: i32, %limit: i32, %upper: i32, %fallback: i32) -> (i1) {
  %cond = scalar.cmpi slt, %x, %limit : i32
  %selected = scf.if %cond -> (i1) {
    %then_x = scalar.assume %x [lt(%x, %limit)] : i32
    %inside_upper = scalar.cmpi slt, %then_x, %upper : i32
    scf.yield %inside_upper : i1
  } else {
    %else_limit = scalar.assume %limit [le(%limit, %x)] : i32
    %has_fallback = scalar.cmpi ne, %fallback, %else_limit : i32
    scf.yield %has_fallback : i1
  }
  func.return %selected : i1
}

// ----
func.def @if_selectifies_region_assumes_before_speculating(%x: i32, %limit: i32, %upper: i32, %fallback: i32) -> (i1) {
  %cond = scalar.cmpi slt, %x, %limit : i32
  %inside_upper = scalar.cmpi slt, %x, %upper : i32
  %has_fallback = scalar.cmpi ne, %fallback, %limit : i32
  %selected = scf.select %cond, %inside_upper, %has_fallback : i1
  func.return %selected : i1
}

// ====

func.def @if_selectifies_scalar_float_arithmetic(%cond: i1, %numerator: f32, %denominator: f32, %scale: f32, %fallback: f32) -> (f32) {
  %selected = scf.if %cond -> (f32) {
    %quotient = scalar.divf %numerator, %denominator : f32
    %scaled = scalar.mulf %quotient, %scale : f32
    scf.yield %scaled : f32
  } else {
    scf.yield %fallback : f32
  }
  func.return %selected : f32
}

// ----
func.def @if_selectifies_scalar_float_arithmetic(%cond: i1, %numerator: f32, %denominator: f32, %scale: f32, %fallback: f32) -> (f32) {
  %quotient = scalar.divf %numerator, %denominator : f32
  %scaled = scalar.mulf %quotient, %scale : f32
  %selected = scf.select %cond, %scaled, %fallback : f32
  func.return %selected : f32
}

// ====

func.def @if_selectifies_vector_float_arithmetic(%cond: i1, %numerator: vector<4xf32>, %denominator: vector<4xf32>, %scale: vector<4xf32>, %fallback: vector<4xf32>) -> (vector<4xf32>) {
  %selected = scf.if %cond -> (vector<4xf32>) {
    %quotient = vector.divf %numerator, %denominator : vector<4xf32>
    %scaled = vector.mulf %quotient, %scale : vector<4xf32>
    scf.yield %scaled : vector<4xf32>
  } else {
    scf.yield %fallback : vector<4xf32>
  }
  func.return %selected : vector<4xf32>
}

// ----
func.def @if_selectifies_vector_float_arithmetic(%cond: i1, %numerator: vector<4xf32>, %denominator: vector<4xf32>, %scale: vector<4xf32>, %fallback: vector<4xf32>) -> (vector<4xf32>) {
  %quotient = vector.divf %numerator, %denominator : vector<4xf32>
  %scaled = vector.mulf %quotient, %scale : vector<4xf32>
  %selected = scf.select %cond, %scaled, %fallback : vector<4xf32>
  func.return %selected : vector<4xf32>
}

// ====

// Cheap total float primitives use the same eager budget as ordinary
// arithmetic and can move into straight-line selection.
func.def @if_selectifies_cheap_float_primitives(%cond: i1, %a: f32, %b: f32, %c: f32, %values: vector<4xf32>, %scalar_fallback: f32, %vector_fallback: vector<4xf32>) -> (f32, vector<4xf32>) {
  %selected_scalar, %selected_vector = scf.if %cond -> (f32, vector<4xf32>) {
    %fused = scalar.fmaf %a, %b, %c : f32
    %rounded = vector.roundevenf %values : vector<4xf32>
    scf.yield %fused, %rounded : f32, vector<4xf32>
  } else {
    scf.yield %scalar_fallback, %vector_fallback : f32, vector<4xf32>
  }
  func.return %selected_scalar, %selected_vector : f32, vector<4xf32>
}

// ----
func.def @if_selectifies_cheap_float_primitives(%cond: i1, %a: f32, %b: f32, %c: f32, %values: vector<4xf32>, %scalar_fallback: f32, %vector_fallback: vector<4xf32>) -> (f32, vector<4xf32>) {
  %fused = scalar.fmaf %a, %b, %c : f32
  %rounded = vector.roundevenf %values : vector<4xf32>
  %selected_scalar = scf.select %cond, %fused, %scalar_fallback : f32
  %selected_vector = scf.select %cond, %rounded, %vector_fallback : vector<4xf32>
  func.return %selected_scalar, %selected_vector : f32, vector<4xf32>
}

// ====

// Nonlinear activation is total but deliberately has no generic eager policy.
// The production-shaped activation-plus-multiply path remains guarded.
func.def @if_preserves_guard_around_nonlinear_activation(%cond: i1, %input: f32, %scale: f32, %fallback: f32) -> (f32) {
  %selected = scf.if %cond -> (f32) {
    %activated = scalar.siluf %input : f32
    %scaled = scalar.mulf %activated, %scale : f32
    scf.yield %scaled : f32
  } else {
    scf.yield %fallback : f32
  }
  func.return %selected : f32
}

// ----
func.def @if_preserves_guard_around_nonlinear_activation(%cond: i1, %input: f32, %scale: f32, %fallback: f32) -> (f32) {
  %selected = scf.if %cond -> (f32) {
    %activated = scalar.siluf %input : f32
    %scaled = scalar.mulf %activated, %scale : f32
    scf.yield %scaled : f32
  } else {
    scf.yield %fallback : f32
  }
  func.return %selected : f32
}

// ====

// Total conversions, bit counts, and comparisons can execute on both sides of
// the condition. Partial neighbors such as fptosi and shifts remain guarded.
func.def @if_selectifies_total_numeric_families(%cond: i1, %value: i32, %float_fallback: f32, %floats: vector<4xf32>, %vector_fallback: vector<4xf16>, %index: index, %index_fallback: index, %integers: vector<4xi32>, %integer_limits: vector<4xi32>, %mask_fallback: vector<4xi1>) -> (f32, vector<4xf16>, index, vector<4xi1>) {
  %selected_float, %selected_vector, %selected_index, %selected_mask = scf.if %cond -> (f32, vector<4xf16>, index, vector<4xi1>) {
    %converted = scalar.uitofp %value : i32 to f32
    %narrowed = vector.fptrunc %floats : vector<4xf32> to vector<4xf16>
    %bit_count = index.ctpopi %index : index
    %less = vector.cmpi slt, %integers, %integer_limits : vector<4xi32> -> vector<4xi1>
    scf.yield %converted, %narrowed, %bit_count, %less : f32, vector<4xf16>, index, vector<4xi1>
  } else {
    scf.yield %float_fallback, %vector_fallback, %index_fallback, %mask_fallback : f32, vector<4xf16>, index, vector<4xi1>
  }
  func.return %selected_float, %selected_vector, %selected_index, %selected_mask : f32, vector<4xf16>, index, vector<4xi1>
}

// ----
func.def @if_selectifies_total_numeric_families(%cond: i1, %value: i32, %float_fallback: f32, %floats: vector<4xf32>, %vector_fallback: vector<4xf16>, %index: index, %index_fallback: index, %integers: vector<4xi32>, %integer_limits: vector<4xi32>, %mask_fallback: vector<4xi1>) -> (f32, vector<4xf16>, index, vector<4xi1>) {
  %converted = scalar.uitofp %value : i32 to f32
  %narrowed = vector.fptrunc %floats : vector<4xf32> to vector<4xf16>
  %bit_count = index.ctpopi %index : index
  %less = vector.cmpi slt, %integers, %integer_limits : vector<4xi32> -> vector<4xi1>
  %selected_float = scf.select %cond, %converted, %float_fallback : f32
  %selected_vector = scf.select %cond, %narrowed, %vector_fallback : vector<4xf16>
  %selected_index = scf.select %cond, %bit_count, %index_fallback : index
  %selected_mask = scf.select %cond, %less, %mask_fallback : vector<4xi1>
  func.return %selected_float, %selected_vector, %selected_index, %selected_mask : f32, vector<4xf16>, index, vector<4xi1>
}

// ====

// Branch-edge assumes also rewrite region-local type references on values whose
// defining op owns the result type. This keeps dynamic view extents connected to
// the refined SSA value instead of leaving only operand uses refined.
func.def @if_edge_rewrites_view_type_reference(%buffer: buffer, %offset: offset, %n: index, %limit: index) -> (f32) {
  %layout = encoding.layout.dense : encoding<layout>
  %cond = index.cmp slt, %n, %limit : index
  %result = scf.if %cond -> (f32) {
    %view = buffer.view %buffer[%offset] : buffer -> view<[%n]xf32, %layout>
    %loaded = view.load %view[0] : view<[%n]xf32, %layout> -> f32
    scf.yield %loaded : f32
  } else {
    %c0 = scalar.constant 0.0 : f32
    scf.yield %c0 : f32
  }
  func.return %result : f32
}

// ----
func.def @if_edge_rewrites_view_type_reference(%buffer: buffer, %offset: offset, %n: index, %limit: index) -> (f32) {
  %cond = index.cmp slt, %n, %limit : index
  %result = scf.if %cond -> (f32) {
    %11 = index.assume %n [lt(%n, %limit)] : index
    %view = buffer.view %buffer[%offset] : buffer -> view<[%11]xf32>
    %loaded = view.load %view[0] : view<[%11]xf32> -> f32
    scf.yield %loaded : f32
  } else {
    %c0 = scalar.constant 0.0 : f32
    scf.yield %c0 : f32
  }
  func.return %result : f32
}

// ====

// Vector constructors with explicit result types follow the same rule: the
// branch-local type should mention the branch-local assume result.
func.def @if_edge_rewrites_vector_type_reference(%x: i32, %n: index, %limit: index) {
  %cond = index.cmp slt, %n, %limit : index
  scf.if %cond {
    %v = vector.splat %x : vector<[%n]xi32>
    test.use %v : vector<[%n]xi32>
  } else {
  }
  func.return
}

// ----
func.def @if_edge_rewrites_vector_type_reference(%x: i32, %n: index, %limit: index) {
  %cond = index.cmp slt, %n, %limit : index
  scf.if %cond {
    %5 = index.assume %n [lt(%n, %limit)] : index
    %v = vector.splat %x : vector<[%5]xi32>
    test.use %v : vector<[%5]xi32>
  } else {
  }
  func.return
}

// ====

// Branch-edge facts also apply to value-preserving index.cast results that
// dominate the branch. Agent-authored kernels commonly cast loaded i32/i64 row
// IDs before the guard and then use the index value for memory addressing.
func.def @if_edge_rewrites_precast_index_reference(%buffer: buffer, %offset: offset, %row: i32, %n: i32) {
  %layout = encoding.layout.dense : encoding<layout>
  %row_idx = index.cast %row : i32 to index
  %n_idx = index.cast %n : i32 to index
  %c0 = scalar.constant 0 : i32
  %nonnegative = scalar.cmpi sge, %row, %c0 : i32
  %below = scalar.cmpi slt, %row, %n : i32
  %guard = scalar.andi %nonnegative, %below : i1
  scf.if %guard {
    %view = buffer.view %buffer[%offset] : buffer -> view<[%n_idx]x4xf32, %layout>
    %loaded = vector.load %view[%row_idx, 0] : view<[%n_idx]x4xf32, %layout> -> vector<4xf32>
    test.use %loaded : vector<4xf32>
  } else {
  }
  func.return
}

// ----
func.def @if_edge_rewrites_precast_index_reference(%buffer: buffer, %offset: offset, %row: i32, %n: i32) {
  %row_idx = index.cast %row : i32 to index
  %n_idx = index.cast %n : i32 to index
  %c0 = scalar.constant 0 : i32
  %nonnegative = scalar.cmpi sge, %row, %c0 : i32
  %below = scalar.cmpi slt, %row, %n : i32
  %guard = scalar.andi %nonnegative, %below : i1
  scf.if %guard {
    %13 = index.assume %row_idx [ge(%row_idx, 0), lt(%row_idx, %n)] : index
    %view = buffer.view %buffer[%offset] : buffer -> view<[%n_idx]x4xf32>
    %loaded = vector.load %view[%13, 0] : view<[%n_idx]x4xf32> -> vector<4xf32>
    test.use %loaded : vector<4xf32>
  } else {
  }
  func.return
}

// ====

// The refinable-result-type-refs trait keeps branch-edge type rewriting
// table-driven for ops that own SSA references embedded in result types.
func.def @if_edge_rewrites_refinable_result_type_refs(%buffer: buffer, %offset: offset, %x: i32, %n: index, %limit: index) {
  %layout = encoding.layout.dense : encoding<layout>
  %source = buffer.view %buffer[%offset] : buffer -> view<[%n]xi32, %layout>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %cond = index.cmp slt, %n, %limit : index
  scf.if %cond {
    %constant = vector.constant 7 : vector<[%n]xi32>
    %iota = vector.iota %c0 step %c1 : vector<[%n]xindex>
    %mask = vector.mask.range [%c0 to %n step %c1] : index -> vector<[%n]xi1>
    %sub = view.subview %source[0] : view<[%n]xi32, %layout> -> view<[%n]xi32, %layout>
    %refined = view.refine %sub : view<[%n]xi32, %layout> -> view<[%n]xi32, %layout>
    %loaded = vector.load %refined[0] : view<[%n]xi32, %layout> -> vector<[%n]xi32>
    test.use %constant, %iota, %mask, %loaded : vector<[%n]xi32>, vector<[%n]xindex>, vector<[%n]xi1>, vector<[%n]xi32>
  } else {
  }
  func.return
}

// ----
func.def @if_edge_rewrites_refinable_result_type_refs(%buffer: buffer, %offset: offset, %x: i32, %n: index, %limit: index) {
  %source = buffer.view %buffer[%offset] : buffer -> view<[%n]xi32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %cond = index.cmp slt, %n, %limit : index
  scf.if %cond {
    %16 = index.assume %n [lt(%n, %limit)] : index
    %constant = vector.constant 7 : vector<[%16]xi32>
    %iota = vector.iota %c0 step %c1 : vector<[%16]xindex>
    %mask = vector.mask.range [%c0 to %16 step %c1] : index -> vector<[%16]xi1>
    %sub = view.subview %source[0] : view<[%n]xi32> -> view<[%16]xi32>
    %refined = view.refine %sub : view<[%16]xi32> -> view<[%16]xi32>
    %loaded = vector.load %refined[0] : view<[%16]xi32> -> vector<[%16]xi32>
    test.use %constant, %iota, %mask, %loaded : vector<[%16]xi32>, vector<[%16]xindex>, vector<[%16]xi1>, vector<[%16]xi32>
  } else {
  }
  func.return
}

// ====

// If a candidate value flows into an op with a type-reference-sensitive
// constraint, the edge-local assume cannot safely retarget just that one value
// type. Leave the type reference alone instead of creating a transient verifier
// failure.
func.def @if_edge_leaves_type_constrained_vector_reference(%x: i32, %n: index, %limit: index) {
  %a = vector.splat %x : vector<[%n]xi32>
  %cond = index.cmp slt, %n, %limit : index
  scf.if %cond {
    %v = vector.splat %x : vector<[%n]xi32>
    %sum = vector.addi %a, %v : vector<[%n]xi32>
    test.use %sum : vector<[%n]xi32>
  } else {
  }
  func.return
}

// ----
func.def @if_edge_leaves_type_constrained_vector_reference(%x: i32, %n: index, %limit: index) {
  %a = vector.splat %x : vector<[%n]xi32>
  %cond = index.cmp slt, %n, %limit : index
  scf.if %cond {
    %v = vector.splat %x : vector<[%n]xi32>
    %sum = vector.addi %a, %v : vector<[%n]xi32>
    test.use %sum : vector<[%n]xi32>
  } else {
  }
  func.return
}

// ====

// Switch edges get the same type-reference treatment. The default edge carries
// a conjunction of not-equal facts, so the dynamic dimension remains symbolic
// but now points at the edge-local assumed selector.
func.def @switch_default_edge_rewrites_vector_type_reference(%x: i32, %variant: index) {
  scf.switch %variant {
    case 4 {
    }
    default {
      %v = vector.splat %x : vector<[%variant]xi32>
      test.use %v : vector<[%variant]xi32>
    }
  }
  func.return
}

// ----
func.def @switch_default_edge_rewrites_vector_type_reference(%x: i32, %variant: index) {
  scf.switch %variant {
    case 4 {
    }
    default {
      %3 = index.assume %variant [ne(%variant, 4)] : index
      %v = vector.splat %x : vector<[%3]xi32>
      test.use %v : vector<[%3]xi32>
    }
  }
  func.return
}

// ====

// The true edge of a boolean and is a conjunction: both source comparisons are
// true in the branch, so repeated checks fold away.
func.def @if_and_true_edge_conjoins_relations(%i: index, %n: index, %j: index, %z: index) -> (i1) {
  %i_in_range = index.cmp slt, %i, %n : index
  %j_nonzero = index.cmp ne, %j, %z : index
  %cond = scalar.andi %i_in_range, %j_nonzero : i1
  %result = scf.if %cond -> (i1) {
    %i_still_in_range = index.cmp slt, %i, %n : index
    %j_still_nonzero = index.cmp ne, %j, %z : index
    %both = scalar.andi %i_still_in_range, %j_still_nonzero : i1
    scf.yield %both : i1
  } else {
    %false = scalar.constant false : i1
    scf.yield %false : i1
  }
  func.return %result : i1
}

// ----
func.def @if_and_true_edge_conjoins_relations(%i: index, %n: index, %j: index, %z: index) -> (i1) {
  %i_in_range = index.cmp slt, %i, %n : index
  %j_nonzero = index.cmp ne, %j, %z : index
  %cond = scalar.andi %i_in_range, %j_nonzero : i1
  func.return %cond : i1
}

// ====

// Branch-local index.cmp facts refine range facts, not just repeated
// comparisons. This is the cache/chunk addressing pattern: the true edge proves
// %time is in the cache prefix, and the false edge proves %time - 2 is a
// non-negative chunk offset.
func.def @if_index_cmp_refines_address_ranges(%time: index) -> (i64, i64, i64, i64) {
  %bounded = index.assume %time [range(%time, 0, 63)] : index
  %split = index.constant 2 : index
  %cond = index.cmp slt, %bounded, %split : index
  %time_lo, %time_hi, %chunk_lo, %chunk_hi = scf.if %cond -> (i64, i64, i64, i64) {
    %then_time_lo = test.fact_range_lo %bounded : index -> i64
    %then_time_hi = test.fact_range_hi %bounded : index -> i64
    %unused_chunk_lo = scalar.constant -1 : i64
    %unused_chunk_hi = scalar.constant -1 : i64
    scf.yield %then_time_lo, %then_time_hi, %unused_chunk_lo, %unused_chunk_hi : i64, i64, i64, i64
  } else {
    %chunk = index.sub %bounded, %split : index
    %unused_time_lo = scalar.constant -1 : i64
    %unused_time_hi = scalar.constant -1 : i64
    %else_chunk_lo = test.fact_range_lo %chunk : index -> i64
    %else_chunk_hi = test.fact_range_hi %chunk : index -> i64
    scf.yield %unused_time_lo, %unused_time_hi, %else_chunk_lo, %else_chunk_hi : i64, i64, i64, i64
  }
  func.return %time_lo, %time_hi, %chunk_lo, %chunk_hi : i64, i64, i64, i64
}

// ----
func.def @if_index_cmp_refines_address_ranges(%time: index) -> (i64, i64, i64, i64) {
  %bounded = index.assume %time [range(%time, 0, 63)] : index
  %split = index.constant 2 : index
  %cond = index.cmp slt, %bounded, %split : index
  %then_time_lo = scalar.constant 0 : i64
  %then_time_hi = scalar.constant 1 : i64
  %unused_chunk_lo = scalar.constant -1 : i64
  %unused_chunk_hi = scalar.constant -1 : i64
  %unused_time_lo = scalar.constant -1 : i64
  %unused_time_hi = scalar.constant -1 : i64
  %else_chunk_lo = scalar.constant 0 : i64
  %else_chunk_hi = scalar.constant 61 : i64
  %time_lo = scf.select %cond, %then_time_lo, %unused_time_lo : i64
  %time_hi = scf.select %cond, %then_time_hi, %unused_time_hi : i64
  %chunk_lo = scf.select %cond, %unused_chunk_lo, %else_chunk_lo : i64
  %chunk_hi = scf.select %cond, %unused_chunk_hi, %else_chunk_hi : i64
  func.return %time_lo, %time_hi, %chunk_lo, %chunk_hi : i64, i64, i64, i64
}

// ====

// Exact boolean yields can fold to the branch condition even when the yielded
// constants are still materialized inside discardable regions.
func.def @if_exact_boolean_region_constants_fold_to_condition(%cond: i1) -> (i1) {
  %result = scf.if %cond -> (i1) {
    %true = scalar.constant true : i1
    scf.yield %true : i1
  } else {
    %false = scalar.constant false : i1
    scf.yield %false : i1
  }
  func.return %result : i1
}

// ----
func.def @if_exact_boolean_region_constants_fold_to_condition(%cond: i1) -> (i1) {
  func.return %cond : i1
}

// ====

// A resultless dynamic conditional with no branch effects is dead.
func.def @if_resultless_empty_erases(%cond: i1) {
  scf.if %cond {
  } else {
  }
  func.return
}

// ----
func.def @if_resultless_empty_erases(%cond: i1) {
  func.return
}

// ====

// When both dynamic branches yield the same value, the scf.if result forwards to
// that value and the effect-free conditional disappears.
func.def @if_forwards_equal_result_and_erases(%cond: i1, %value: f32) -> (f32) {
  %result = scf.if %cond -> (f32) {
    scf.yield %value : f32
  } else {
    scf.yield %value : f32
  }
  func.return %result : f32
}

// ----
func.def @if_forwards_equal_result_and_erases(%cond: i1, %value: f32) -> (f32) {
  func.return %value : f32
}

// ====

// A dynamic yield-only conditional over scalar values canonicalizes to a generic
// whole-value select. No region body work remains, so control flow is
// unnecessary.
func.def @if_yield_only_f32_value(%cond: i1, %a: f32, %b: f32) -> (f32) {
  %result = scf.if %cond -> (f32) {
    scf.yield %a : f32
  } else {
    scf.yield %b : f32
  }
  func.return %result : f32
}

// ----
func.def @if_yield_only_f32_value(%cond: i1, %a: f32, %b: f32) -> (f32) {
  %result = scf.select %cond, %a, %b : f32
  func.return %result : f32
}

// ====

// The same generic select handles address-domain values without making scf
// canonicalization depend on the index dialect.
func.def @if_yield_only_index_value(%cond: i1, %a: index, %b: index) -> (index) {
  %result = scf.if %cond -> (index) {
    scf.yield %a : index
  } else {
    scf.yield %b : index
  }
  func.return %result : index
}

// ----
func.def @if_yield_only_index_value(%cond: i1, %a: index, %b: index) -> (index) {
  %result = scf.select %cond, %a, %b : index
  func.return %result : index
}

// ====

// Matching pure tail ops factor out of both branches. The conditional first
// chooses the operands, then the common op is rebuilt once after it.
func.def @if_factors_common_pure_tail(%cond: i1, %a: i32, %b: i32) -> (i32) {
  %result = scf.if %cond -> (i32) {
    %then = test.addi %a, %b : i32
    scf.yield %then : i32
  } else {
    %else = test.addi %b, %a : i32
    scf.yield %else : i32
  }
  func.return %result : i32
}

// ----
func.def @if_factors_common_pure_tail(%cond: i1, %a: i32, %b: i32) -> (i32) {
  %10 = scf.select %cond, %a, %b : i32
  %11 = scf.select %cond, %b, %a : i32
  %result = test.addi %10, %11 : i32
  func.return %result : i32
}

// ====

// Matching dependent operand types refer to the same outer definition. Since
// each type is valid in both exhaustive branches, the shared extent already
// dominates the conditional and remains available to the factored tail.
func.def @if_factors_tail_with_shared_dependent_type(%cond: i1, %extent: index, %a: vector<[%extent]xf32>, %b: vector<[%extent]xf32>) -> (vector<[%extent]xf32>) {
  %result = scf.if %cond -> (vector<[%extent]xf32>) {
    %then = test.convergent %a : vector<[%extent]xf32>
    scf.yield %then : vector<[%extent]xf32>
  } else {
    %else = test.convergent %b : vector<[%extent]xf32>
    scf.yield %else : vector<[%extent]xf32>
  }
  func.return %result : vector<[%extent]xf32>
}

// ----
func.def @if_factors_tail_with_shared_dependent_type(%cond: i1, %extent: index, %a: vector<[%extent]xf32>, %b: vector<[%extent]xf32>) -> (vector<[%extent]xf32>) {
  %10 = scf.select %cond, %a, %b : vector<[%extent]xf32>
  %result = test.convergent %10 : vector<[%extent]xf32>
  func.return %result : vector<[%extent]xf32>
}

// ====

// Factoring a segmented tail preserves its independent operand field spans.
func.def @if_factors_common_segmented_tail(%cond: i1, %a: i32, %b: i32) -> (i32) {
  %result = scf.if %cond -> (i32) {
    %then = test.segmented %a base %b values %a, %b expected %a : i32 -> i32
    scf.yield %then : i32
  } else {
    %else = test.segmented %b base %a values %b, %a expected %b : i32 -> i32
    scf.yield %else : i32
  }
  func.return %result : i32
}

// ----
func.def @if_factors_common_segmented_tail(%cond: i1, %a: i32, %b: i32) -> (i32) {
  %13 = scf.select %cond, %a, %b : i32
  %14 = scf.select %cond, %b, %a : i32
  %15 = scf.select %cond, %a, %b : i32
  %16 = scf.select %cond, %b, %a : i32
  %17 = scf.select %cond, %a, %b : i32
  %result = test.segmented %13 base %14 values %15, %16 expected %17 : i32 -> i32
  func.return %result : i32
}

// ====

// Equal flat operand counts do not make different segmented field partitions
// equivalent.
func.def @if_preserves_mismatched_segmented_tail_partitions(%cond: i1, %a: i32, %b: i32) -> (i32) {
  %result = scf.if %cond -> (i32) {
    %then = test.segmented %a base %b values %a, %b expected %a : i32 -> i32
    scf.yield %then : i32
  } else {
    %else = test.segmented %b values %a, %b expected %a, %b : i32 -> i32
    scf.yield %else : i32
  }
  func.return %result : i32
}

// ====

// Branch effects remain branch-local. Only the shared pure tail is factored.
func.def @if_factors_tail_and_preserves_branch_effects(%cond: i1, %a: i32, %b: i32) -> (i32) {
  %result = scf.if %cond -> (i32) {
    test.use %a : i32
    %then = test.addi %a, %b : i32
    scf.yield %then : i32
  } else {
    test.use %b : i32
    %else = test.addi %b, %a : i32
    scf.yield %else : i32
  }
  func.return %result : i32
}

// ----
func.def @if_factors_tail_and_preserves_branch_effects(%cond: i1, %a: i32, %b: i32) -> (i32) {
  %7, %8 = scf.if %cond -> (i32, i32) {
    test.use %a : i32
    scf.yield %a, %b : i32, i32
  } else {
    test.use %b : i32
    scf.yield %b, %a : i32, i32
  }
  %result = test.addi %7, %8 : i32
  func.return %result : i32
}

// ====

// The common-tail rewrite is not speculation: the tail op executed on every
// branch before the rewrite, so an effectful result-producing tail can move
// after the branch once the branch yields its operands.
func.def @if_factors_common_side_effecting_tail(%cond: i1, %pool: pool, %a: i32, %b: i32) -> (i32) {
  %result = scf.if %cond -> (i32) {
    %then = test.mutate_resource %pool, %a : pool, i32 -> i32
    scf.yield %then : i32
  } else {
    %else = test.mutate_resource %pool, %b : pool, i32 -> i32
    scf.yield %else : i32
  }
  func.return %result : i32
}

// ----
func.def @if_factors_common_side_effecting_tail(%cond: i1, %pool: pool, %a: i32, %b: i32) -> (i32) {
  %12 = scf.select %cond, %a, %b : i32
  %result = test.mutate_resource %pool, %12 : pool, i32 -> i32
  func.return %result : i32
}

// ====

// Distinct storage roots stay branch-local. Factoring the load would require
// selecting between views, which loses the single-root memory fact downstream.
func.def @if_preserves_distinct_storage_tail_roots(%cond: i1, %lhs_buffer: buffer, %rhs_buffer: buffer, %offset: offset) -> (f32) {
  %layout = encoding.layout.dense : encoding<layout>
  %lhs_view = buffer.view %lhs_buffer[%offset] : buffer -> view<4xf32, %layout>
  %rhs_view = buffer.view %rhs_buffer[%offset] : buffer -> view<4xf32, %layout>
  %result = scf.if %cond -> (f32) {
    %lhs = view.load %lhs_view[0] : view<4xf32, %layout> -> f32
    scf.yield %lhs : f32
  } else {
    %rhs = view.load %rhs_view[0] : view<4xf32, %layout> -> f32
    scf.yield %rhs : f32
  }
  func.return %result : f32
}

// ----
func.def @if_preserves_distinct_storage_tail_roots(%cond: i1, %lhs_buffer: buffer, %rhs_buffer: buffer, %offset: offset) -> (f32) {
  %lhs_view = buffer.view %lhs_buffer[%offset] : buffer -> view<4xf32>
  %rhs_view = buffer.view %rhs_buffer[%offset] : buffer -> view<4xf32>
  %result = scf.if %cond -> (f32) {
    %lhs = view.load %lhs_view[0] : view<4xf32> -> f32
    scf.yield %lhs : f32
  } else {
    %rhs = view.load %rhs_view[0] : view<4xf32> -> f32
    scf.yield %rhs : f32
  }
  func.return %result : f32
}

// ====

// Different tail op kinds do not factor: the conditional still chooses between
// two distinct computations.
func.def @if_preserves_different_tail_kinds(%cond: i1, %a: i32, %b: i32) -> (i32) {
  %result = scf.if %cond -> (i32) {
    %then = test.addi %a, %b : i32
    scf.yield %then : i32
  } else {
    %else = test.constant 4 : i32
    scf.yield %else : i32
  }
  func.return %result : i32
}

// ====

// Equal yielded results forward even when branch side effects keep the dynamic
// conditional itself live.
func.def @if_forwards_equal_result_keeps_effects(%buffer: buffer, %offset: offset, %cond: i1, %value: f32, %other: f32) -> (f32) {
  %layout = encoding.layout.dense : encoding<layout>
  %view = buffer.view %buffer[%offset] : buffer -> view<1xf32, %layout>
  %result = scf.if %cond -> (f32) {
    view.store %value, %view[0] : f32, view<1xf32, %layout>
    scf.yield %value : f32
  } else {
    view.store %other, %view[0] : f32, view<1xf32, %layout>
    scf.yield %value : f32
  }
  func.return %result : f32
}

// ----
func.def @if_forwards_equal_result_keeps_effects(%buffer: buffer, %offset: offset, %cond: i1, %value: f32, %other: f32) -> (f32) {
  %view = buffer.view %buffer[%offset] : buffer -> view<1xf32>
  scf.if %cond {
    view.store %value, %view[0] : f32, view<1xf32>
  } else {
    view.store %other, %view[0] : f32, view<1xf32>
  }
  func.return %value : f32
}

// ====

// Hints are not semantic effects, but forwarding must still preserve them until
// an explicit hint-stripping pass removes them.
func.def @if_forwards_equal_result_keeps_hint(%buffer: buffer, %offset: offset, %cond: i1, %row: index, %value: f32) -> (f32) {
  %layout = encoding.layout.dense : encoding<layout>
  %view = buffer.view %buffer[%offset] : buffer -> view<4xf32, %layout>
  %result = scf.if %cond -> (f32) {
    view.prefetch %view[%row] {intent = read, locality = l1} : view<4xf32, %layout>
    scf.yield %value : f32
  } else {
    scf.yield %value : f32
  }
  func.return %result : f32
}

// ----
func.def @if_forwards_equal_result_keeps_hint(%buffer: buffer, %offset: offset, %cond: i1, %row: index, %value: f32) -> (f32) {
  %view = buffer.view %buffer[%offset] : buffer -> view<4xf32>
  scf.if %cond {
    view.prefetch %view[%row] {intent = read, locality = l1} : view<4xf32>
  } else {
  }
  func.return %value : f32
}

// ====

// Partially equal branch results compact the scf.if result list and keep only
// the value that really depends on the selected branch.
func.def @if_forwards_one_of_two_results(%cond: i1, %a: f32, %b: f32) -> (f32, f32) {
  %same, %selected = scf.if %cond -> (f32, f32) {
    %then = scalar.addf %a, %b : f32
    scf.yield %a, %then : f32, f32
  } else {
    %else = scalar.addf %b, %b : f32
    scf.yield %a, %else : f32, f32
  }
  func.return %same, %selected : f32, f32
}

// ----
func.def @if_forwards_one_of_two_results(%cond: i1, %a: f32, %b: f32) -> (f32, f32) {
  %14 = scf.select %cond, %a, %b : f32
  %selected = scalar.addf %14, %b : f32
  func.return %a, %selected : f32, f32
}

// ====

// Unused conditional results are dropped independently of forwarding. Effects
// remain in their original branches, and later DCE can clean now-dead pure
// producers inside the kept conditional.
func.def @if_drops_unused_result_keeps_effects(%buffer: buffer, %offset: offset, %cond: i1, %a: f32, %b: f32) -> (f32) {
  %layout = encoding.layout.dense : encoding<layout>
  %view = buffer.view %buffer[%offset] : buffer -> view<1xf32, %layout>
  %dead, %live = scf.if %cond -> (f32, f32) {
    %then_dead = scalar.addf %a, %a : f32
    %then_live = scalar.addf %a, %b : f32
    view.store %then_live, %view[0] : f32, view<1xf32, %layout>
    scf.yield %then_dead, %then_live : f32, f32
  } else {
    %else_dead = scalar.addf %b, %b : f32
    %else_live = scalar.addf %b, %a : f32
    view.store %else_live, %view[0] : f32, view<1xf32, %layout>
    scf.yield %else_dead, %else_live : f32, f32
  }
  func.return %live : f32
}

// ----
func.def @if_drops_unused_result_keeps_effects(%buffer: buffer, %offset: offset, %cond: i1, %a: f32, %b: f32) -> (f32) {
  %view = buffer.view %buffer[%offset] : buffer -> view<1xf32>
  %live = scf.if %cond -> (f32) {
    %then_live = scalar.addf %a, %b : f32
    view.store %then_live, %view[0] : f32, view<1xf32>
    scf.yield %then_live : f32
  } else {
    %else_live = scalar.addf %b, %a : f32
    view.store %else_live, %view[0] : f32, view<1xf32>
    scf.yield %else_live : f32
  }
  func.return %live : f32
}

// ====

// Result compaction must respect type-use references. %layout has no ordinary
// operand uses, but the view type references it and must keep the conditional
// result alive.
func.def @if_keeps_result_used_by_type(%buffer: buffer, %offset: offset, %cond: i1) -> (f32) {
  %layout = scf.if %cond -> (encoding<layout>) {
    %dense = encoding.layout.dense : encoding<layout>
    scf.yield %dense : encoding<layout>
  } else {
    %strided = encoding.layout.strided [1] : encoding<layout>
    scf.yield %strided : encoding<layout>
  }
  %view = buffer.view %buffer[%offset] : buffer -> view<1xf32, %layout>
  %loaded = view.load %view[0] : view<1xf32, %layout> -> f32
  func.return %loaded : f32
}

// ====

// Result compaction also preserves references nested in attributes. Effects
// keep the conditional in place so this exercises result pruning, not select
// formation or whole-operation DCE.
func.def @if_keeps_result_used_by_type_attribute(%cond: i1, %left_width: index, %right_width: index, %value: f32) -> (f32) {
  %width = scf.if %cond -> (index) {
    test.use %left_width : index
    scf.yield %left_width : index
  } else {
    test.use %right_width : index
    scf.yield %right_width : index
  }
  %annotated = test.attrs %value {shape = #test.options<mode = fast, element_type = vector<[%width]xf32>>} : f32
  func.return %annotated : f32
}

// ====

// A zero-trip loop returns its iter_args and drops the body, even when the body
// would have written memory if it executed.
func.def @for_zero_trip_returns_initial_value(%buffer: buffer, %offset: offset, %init: f32) -> (f32) {
  %layout = encoding.layout.dense : encoding<layout>
  %view = buffer.view %buffer[%offset] : buffer -> view<1xf32, %layout>
  %bound = index.constant 4 : index
  %step = index.constant 1 : index
  %result = scf.for %iv = [%bound to %bound step %step](%acc = %init : f32) -> (f32) {
    view.store %acc, %view[0] : f32, view<1xf32, %layout>
    scf.yield %acc : f32
  }
  func.return %result : f32
}

// ----
func.def @for_zero_trip_returns_initial_value(%buffer: buffer, %offset: offset, %init: f32) -> (f32) {
  func.return %init : f32
}

// ====

// Identical runtime index bounds prove an empty domain without range facts.
// Both carried values forward even when the body changes them and has effects.
func.def @for_identical_runtime_index_bounds(%output: view<1xf32>, %bound: index, %step: index, %init: f32, %count: i32) -> (f32, i32) {
  %value, %iterations = scf.for %iv = [%bound to %bound step %step](%acc = %init : f32, %n = %count : i32) -> (f32, i32) {
    %increment = scalar.constant 1.0 : f32
    %next = scalar.addf %acc, %increment : f32
    %count_increment = scalar.constant 1 : i32
    %next_count = scalar.addi %n, %count_increment : i32
    view.store %next, %output[0] : f32, view<1xf32>
    scf.yield %next, %next_count : f32, i32
  }
  func.return %value, %iterations : f32, i32
}

// ----
func.def @for_identical_runtime_index_bounds(%output: view<1xf32>, %bound: index, %step: index, %init: f32, %count: i32) -> (f32, i32) {
  func.return %init, %count : f32, i32
}

// ====

// Physical offset domains have the same exclusive-bound identity rule.
func.def @for_identical_runtime_offset_bounds(%output: view<1xf32>, %bound: offset, %value: f32) {
  %step = index.constant 4 : offset
  scf.for %iv = [%bound to %bound step %step] {
    view.store %value, %output[0] : f32, view<1xf32>
  }
  func.return
}

// ----
func.def @for_identical_runtime_offset_bounds(%output: view<1xf32>, %bound: offset, %value: f32) {
  func.return
}

// ====

// Distinct SSA bounds with the same unknown range do not establish emptiness.
func.def @for_distinct_runtime_bounds(%output: view<1xf32>, %lower: index, %upper: index, %value: f32) {
  %step = index.constant 1 : index
  scf.for %iv = [%lower to %upper step %step] {
    view.store %value, %output[0] : f32, view<1xf32>
  }
  func.return
}

// ----
func.def @for_distinct_runtime_bounds(%output: view<1xf32>, %lower: index, %upper: index, %value: f32) {
  %step = index.constant 1 : index
  scf.for %iv = [%lower to %upper step %step] {
    view.store %value, %output[0] : f32, view<1xf32>
  }
  func.return
}

// ====

// A fact-proven single-trip resultless loop inlines its body once. The IV
// substitution feeds ordinary index cleanup, so the add-by-zero address math
// disappears after promotion.
func.def @for_single_trip_resultless_inlines_effect(%buffer: buffer, %offset: offset, %value: f32) {
  %layout = encoding.layout.dense : encoding<layout>
  %view = buffer.view %buffer[%offset] : buffer -> view<16xf32, %layout>
  %lo = index.constant 3 : index
  %hi = index.constant 4 : index
  %step = index.constant 1 : index
  %c0 = index.constant 0 : index
  scf.for %iv = [%lo to %hi step %step] {
    %addr = index.add %iv, %c0 : index
    view.store %value, %view[%addr] : f32, view<16xf32, %layout>
  }
  func.return
}

// ----
func.def @for_single_trip_resultless_inlines_effect(%buffer: buffer, %offset: offset, %value: f32) {
  %view = buffer.view %buffer[%offset] : buffer -> view<16xf32>
  %addr = index.constant 3 : index
  view.store %value, %view[%addr] : f32, view<16xf32>
  func.return
}

// ====

// A single-trip loop with carried state turns into straight-line scalar work.
func.def @for_single_trip_carried_result(%init: f32) -> (f32) {
  %lo = index.constant 0 : index
  %hi = index.constant 1 : index
  %step = index.constant 1 : index
  %result = scf.for %iv = [%lo to %hi step %step](%acc = %init : f32) -> (f32) {
    %next = scalar.addf %acc, %acc : f32
    scf.yield %next : f32
  }
  func.return %result : f32
}

// ----
func.def @for_single_trip_carried_result(%init: f32) -> (f32) {
  %next = scalar.addf %init, %init : f32
  func.return %next : f32
}

// ====

// Dynamic values can still prove a single trip when their fact ranges guarantee
// lower < upper and lower + step >= upper.
func.def @for_single_trip_dynamic_range_inlines(%buffer: buffer, %offset: offset, %lo: index, %hi: index, %value: f32) {
  %layout = encoding.layout.dense : encoding<layout>
  %view = buffer.view %buffer[%offset] : buffer -> view<32xf32, %layout>
  %lo1 = index.assume %lo [range(%lo, 8, 15)] : index
  %hi1 = index.assume %hi [range(%hi, 16, 23)] : index
  %step = index.constant 16 : index
  scf.for %iv = [%lo1 to %hi1 step %step] {
    view.store %value, %view[%iv] : f32, view<32xf32, %layout>
  }
  func.return
}

// ----
func.def @for_single_trip_dynamic_range_inlines(%buffer: buffer, %offset: offset, %lo: index, %hi: index, %value: f32) {
  %view = buffer.view %buffer[%offset] : buffer -> view<32xf32>
  %lo1 = index.assume %lo [range(%lo, 8, 15)] : index
  view.store %value, %view[%lo1] : f32, view<32xf32>
  func.return
}

// ====

// Without a positive-step fact, even an apparently empty identity loop stays in
// place: erasing it would also erase malformed or nonterminating control flow.
func.def @for_identity_unknown_step_is_preserved(%lo: index, %hi: index, %step: index, %init: f32) -> (f32) {
  %result = scf.for %iv = [%lo to %hi step %step](%acc = %init : f32) -> (f32) {
    scf.yield %acc : f32
  }
  func.return %result : f32
}

// ----
func.def @for_identity_unknown_step_is_preserved(%lo: index, %hi: index, %step: index, %init: f32) -> (f32) {
  %result = scf.for %iv = [%lo to %hi step %step](%acc = %init : f32) -> (f32) {
    scf.yield %acc : f32
  }
  func.return %result : f32
}

// ====

// Static bounds that prove multiple trips must not promote the loop.
func.def @for_single_trip_multi_trip_is_preserved(%init: f32) -> (f32) {
  %lo = index.constant 0 : index
  %hi = index.constant 4 : index
  %step = index.constant 2 : index
  %result = scf.for %iv = [%lo to %hi step %step](%acc = %init : f32) -> (f32) {
    %next = scalar.addf %acc, %acc : f32
    scf.yield %next : f32
  }
  func.return %result : f32
}

// ====

// Non-positive steps are preserved even when the numeric bounds look like they
// might otherwise execute once.
func.def @for_single_trip_non_positive_step_is_preserved(%init: f32) -> (f32) {
  %lo = index.constant 0 : index
  %hi = index.constant 1 : index
  %step = index.constant 0 : index
  %result = scf.for %iv = [%lo to %hi step %step](%acc = %init : f32) -> (f32) {
    %next = scalar.addf %acc, %acc : f32
    scf.yield %next : f32
  }
  func.return %result : f32
}

// ====

// A loop that only yields its carried values is the identity when the step is
// known positive.
func.def @for_identity_body_returns_iter_arg(%lo: index, %hi: index, %init: f32) -> (f32) {
  %step = index.constant 1 : index
  %result = scf.for %iv = [%lo to %hi step %step](%acc = %init : f32) -> (f32) {
    scf.yield %acc : f32
  }
  func.return %result : f32
}

// ----
func.def @for_identity_body_returns_iter_arg(%lo: index, %hi: index, %init: f32) -> (f32) {
  func.return %init : f32
}

// ====

// A resultless loop with an empty body has no observable behavior once the step
// is known positive.
func.def @for_void_empty_body(%lo: index, %hi: index) {
  %step = index.constant 1 : index
  scf.for %iv = [%lo to %hi step %step] {
  }
  func.return
}

// ----
func.def @for_void_empty_body(%lo: index, %hi: index) {
  func.return
}

// ====

// A mixed loop forwards unchanged carried results independently and keeps only
// the state that is actually updated by the loop.
func.def @for_forwards_one_of_two_results(%lo: index, %hi: index, %init: f32, %acc: f32) -> (f32, f32) {
  %step = index.constant 1 : index
  %same, %sum = scf.for %iv = [%lo to %hi step %step](%same_arg = %init : f32, %acc_arg = %acc : f32) -> (f32, f32) {
    %next = scalar.addf %acc_arg, %acc_arg : f32
    scf.yield %same_arg, %next : f32, f32
  }
  func.return %same, %sum : f32, f32
}

// ----
func.def @for_forwards_one_of_two_results(%lo: index, %hi: index, %init: f32, %acc: f32) -> (f32, f32) {
  %step = index.constant 1 : index
  %sum = scf.for %iv = [%lo to %hi step %step](%acc_arg = %acc : f32) -> (f32) {
    %next = scalar.addf %acc_arg, %acc_arg : f32
    scf.yield %next : f32
  }
  func.return %init, %sum : f32, f32
}

// ====

// Forwarding does not discard side effects. The forwarded carried value becomes
// a direct capture of the original iter_arg inside the compacted loop body.
func.def @for_forwards_mixed_effectful_result(%buffer: buffer, %offset: offset, %lo: index, %hi: index, %init: f32, %acc: f32) -> (f32, f32) {
  %layout = encoding.layout.dense : encoding<layout>
  %view = buffer.view %buffer[%offset] : buffer -> view<1xf32, %layout>
  %step = index.constant 1 : index
  %same, %sum = scf.for %iv = [%lo to %hi step %step](%same_arg = %init : f32, %acc_arg = %acc : f32) -> (f32, f32) {
    view.store %same_arg, %view[0] : f32, view<1xf32, %layout>
    %next = scalar.addf %acc_arg, %acc_arg : f32
    scf.yield %same_arg, %next : f32, f32
  }
  func.return %same, %sum : f32, f32
}

// ----
func.def @for_forwards_mixed_effectful_result(%buffer: buffer, %offset: offset, %lo: index, %hi: index, %init: f32, %acc: f32) -> (f32, f32) {
  %view = buffer.view %buffer[%offset] : buffer -> view<1xf32>
  %step = index.constant 1 : index
  %sum = scf.for %iv = [%lo to %hi step %step](%acc_arg = %acc : f32) -> (f32) {
    view.store %init, %view[0] : f32, view<1xf32>
    %next = scalar.addf %acc_arg, %acc_arg : f32
    scf.yield %next : f32
  }
  func.return %init, %sum : f32, f32
}

// ====

// A single forwarded result with side effects becomes a resultless loop, so the
// effect remains ordered but the function result reads directly from the input.
func.def @for_single_forwarded_result_keeps_effect(%buffer: buffer, %offset: offset, %lo: index, %hi: index, %init: f32) -> (f32) {
  %layout = encoding.layout.dense : encoding<layout>
  %view = buffer.view %buffer[%offset] : buffer -> view<1xf32, %layout>
  %step = index.constant 1 : index
  %same = scf.for %iv = [%lo to %hi step %step](%same_arg = %init : f32) -> (f32) {
    view.store %same_arg, %view[0] : f32, view<1xf32, %layout>
    scf.yield %same_arg : f32
  }
  func.return %same : f32
}

// ----
func.def @for_single_forwarded_result_keeps_effect(%buffer: buffer, %offset: offset, %lo: index, %hi: index, %init: f32) -> (f32) {
  %view = buffer.view %buffer[%offset] : buffer -> view<1xf32>
  %step = index.constant 1 : index
  scf.for %iv = [%lo to %hi step %step] {
    view.store %init, %view[0] : f32, view<1xf32>
  }
  func.return %init : f32
}

// ====

// All-result identity still erases the whole loop when the body is otherwise
// empty.
func.def @for_identity_multiple_results(%lo: index, %hi: index, %a: f32, %b: i32) -> (f32, i32) {
  %step = index.constant 1 : index
  %ra, %rb = scf.for %iv = [%lo to %hi step %step](%aa = %a : f32, %bb = %b : i32) -> (f32, i32) {
    scf.yield %aa, %bb : f32, i32
  }
  func.return %ra, %rb : f32, i32
}

// ----
func.def @for_identity_multiple_results(%lo: index, %hi: index, %a: f32, %b: i32) -> (f32, i32) {
  func.return %a, %b : f32, i32
}

// ====

// Unknown steps are not rewritten: if a loop may be malformed or nonterminating,
// forwarding an externally visible result would be a semantic change.
func.def @for_forward_unknown_step_is_preserved(%lo: index, %hi: index, %step: index, %init: f32, %acc: f32) -> (f32, f32) {
  %same, %sum = scf.for %iv = [%lo to %hi step %step](%same_arg = %init : f32, %acc_arg = %acc : f32) -> (f32, f32) {
    %next = scalar.addf %acc_arg, %acc_arg : f32
    scf.yield %same_arg, %next : f32, f32
  }
  func.return %same, %sum : f32, f32
}

// ----
func.def @for_forward_unknown_step_is_preserved(%lo: index, %hi: index, %step: index, %init: f32, %acc: f32) -> (f32, f32) {
  %same, %sum = scf.for %iv = [%lo to %hi step %step](%same_arg = %init : f32, %acc_arg = %acc : f32) -> (f32, f32) {
    %next = scalar.addf %acc_arg, %acc_arg : f32
    scf.yield %same_arg, %next : f32, f32
  }
  func.return %same, %sum : f32, f32
}

// ====

// Exact selector facts replace scf.lookup with the matching explicit case row.
func.def @lookup_exact_case(%a: index, %b: index, %fallback: index) -> (index) {
  %variant = index.constant 1 : index
  %result = scf.lookup %variant {
    0 = (%a),
    1 = (%b)
  } default(%fallback) : index
  func.return %result : index
}

// ----
func.def @lookup_exact_case(%a: index, %b: index, %fallback: index) -> (index) {
  func.return %b : index
}

// ====

// Exact selector facts that miss every explicit key select the final default
// payload row.
func.def @lookup_exact_default(%a: index, %b: index, %fallback: index) -> (index) {
  %variant = index.constant 5 : index
  %result = scf.lookup %variant {
    0 = (%a),
    1 = (%b)
  } default(%fallback) : index
  func.return %result : index
}

// ----
func.def @lookup_exact_default(%a: index, %b: index, %fallback: index) -> (index) {
  func.return %fallback : index
}

// ====

// Exact selector facts inline the selected scf.switch case region.
func.def @switch_exact_case(%a: index, %b: index, %fallback: index) -> (index) {
  %variant = index.constant 1 : index
  %result = scf.switch %variant -> (index) {
    case 0 {
      scf.yield %a : index
    }
    case 1 {
      scf.yield %b : index
    }
    default {
      scf.yield %fallback : index
    }
  }
  func.return %result : index
}

// ----
func.def @switch_exact_case(%a: index, %b: index, %fallback: index) -> (index) {
  func.return %b : index
}

// ====

// A selected scf.switch region moves its body into the parent block before the
// switch result is replaced.
func.def @switch_exact_case_moves_body(%a: index, %b: index, %fallback: index) -> (index) {
  %variant = index.constant 1 : index
  %result = scf.switch %variant -> (index) {
    case 0 {
      scf.yield %a : index
    }
    case 1 {
      %sum = index.add %b, %b : index
      scf.yield %sum : index
    }
    default {
      scf.yield %fallback : index
    }
  }
  func.return %result : index
}

// ----
func.def @switch_exact_case_moves_body(%a: index, %b: index, %fallback: index) -> (index) {
  %sum = index.add %b, %b : index
  func.return %sum : index
}

// ====

// Exact selector facts that miss every explicit key inline the default region.
func.def @switch_exact_default(%a: index, %b: index, %fallback: index) -> (index) {
  %variant = index.constant 5 : index
  %result = scf.switch %variant -> (index) {
    case 0 {
      scf.yield %a : index
    }
    case 1 {
      scf.yield %b : index
    }
    default {
      scf.yield %fallback : index
    }
  }
  func.return %result : index
}

// ----
func.def @switch_exact_default(%a: index, %b: index, %fallback: index) -> (index) {
  func.return %fallback : index
}

// ====

// Yield-only scf.switch regions are a value table in disguise. Canonicalization
// keeps the dispatch mapping explicit and greppable by rewriting to scf.lookup.
func.def @switch_yield_only_to_lookup(%variant: index, %gemm0: index, %gemm1: index, %fallback: index, %x0: index, %x1: index, %x2: index, %xf: index, %y0: index, %y1: index, %y2: index, %yf: index, %z0: index, %z1: index, %z2: index, %zf: index) -> (index, index, index, index) {
  %ordinal, %wgx, %wgy, %wgz = scf.switch %variant -> (index, index, index, index) {
    case 0 {
      scf.yield %gemm0, %x0, %y0, %z0 : index, index, index, index
    }
    case 1 {
      scf.yield %gemm1, %x1, %y1, %z1 : index, index, index, index
    }
    case 2 {
      scf.yield %gemm1, %x2, %y2, %z2 : index, index, index, index
    }
    default {
      scf.yield %fallback, %xf, %yf, %zf : index, index, index, index
    }
  }
  func.return %ordinal, %wgx, %wgy, %wgz : index, index, index, index
}

// ----
func.def @switch_yield_only_to_lookup(%variant: index, %gemm0: index, %gemm1: index, %fallback: index, %x0: index, %x1: index, %x2: index, %xf: index, %y0: index, %y1: index, %y2: index, %yf: index, %z0: index, %z1: index, %z2: index, %zf: index) -> (index, index, index, index) {
  %ordinal, %wgx, %wgy, %wgz = scf.lookup %variant {
    0 = (%gemm0, %x0, %y0, %z0),
    1 = (%gemm1, %x1, %y1, %z1),
    2 = (%gemm1, %x2, %y2, %z2)
  } default(%fallback, %xf, %yf, %zf) : index, index, index, index
  func.return %ordinal, %wgx, %wgy, %wgz : index, index, index, index
}

// ====

// A switch case with real branch-local work is not a lookup table yet. Later
// branch factoring can expose rows, but this local rewrite only handles rows
// that are already explicit.
func.def @switch_with_body_preserved(%variant: index, %a: index, %b: index, %fallback: index) -> (index) {
  %result = scf.switch %variant -> (index) {
    case 0 {
      scf.yield %a : index
    }
    case 1 {
      %sum = index.add %b, %b : index
      scf.yield %sum : index
    }
    default {
      scf.yield %fallback : index
    }
  }
  func.return %result : index
}

// ----
func.def @switch_with_body_preserved(%variant: index, %a: index, %b: index, %fallback: index) -> (index) {
  %result = scf.switch %variant -> (index) {
    case 0 {
      scf.yield %a : index
    }
    case 1 {
      %sum = index.add %b, %b : index
      scf.yield %sum : index
    }
    default {
      scf.yield %fallback : index
    }
  }
  func.return %result : index
}

// ====

// Each explicit switch case refines the selector to the case key inside that
// region, exposing repeated selector checks to ordinary compare folding.
func.def @switch_case_edge_relation_folds_inside_region(%variant: index) -> (i1) {
  %result = scf.switch %variant -> (i1) {
    case 0 {
      %c0 = index.constant 0 : index
      %known = index.cmp eq, %variant, %c0 : index
      scf.yield %known : i1
    }
    default {
      %false = scalar.constant false : i1
      scf.yield %false : i1
    }
  }
  func.return %result : i1
}

// ----
func.def @switch_case_edge_relation_folds_inside_region(%variant: index) -> (i1) {
  %result = scf.switch %variant -> (i1) {
    case 0 {
      %known = scalar.constant true : i1
      scf.yield %known : i1
    }
    default {
      %false = scalar.constant false : i1
      scf.yield %false : i1
    }
  }
  func.return %result : i1
}

// ====

// The default switch edge refines the selector to not equal any explicit case
// key. That is a conjunction, so every repeated miss check can fold.
func.def @switch_default_edge_relations_fold_inside_region(%variant: index) -> (i1) {
  %result = scf.switch %variant -> (i1) {
    case 0 {
      %false = scalar.constant false : i1
      scf.yield %false : i1
    }
    default {
      %c0 = index.constant 0 : index
      %known = index.cmp ne, %variant, %c0 : index
      scf.yield %known : i1
    }
  }
  func.return %result : i1
}

// ----
func.def @switch_default_edge_relations_fold_inside_region(%variant: index) -> (i1) {
  %result = scf.switch %variant -> (i1) {
    case 0 {
      %false = scalar.constant false : i1
      scf.yield %false : i1
    }
    default {
      %known = scalar.constant true : i1
      scf.yield %known : i1
    }
  }
  func.return %result : i1
}

// ====

// Matching pure tails factor out of every switch branch. Once the switch is
// reduced to yielded operands, the existing yield-only rewrite turns it into a
// greppable lookup table feeding the common op.
func.def @switch_factors_common_pure_tail_to_lookup(%variant: index, %a0: i32, %b0: i32, %a1: i32, %b1: i32, %af: i32, %bf: i32) -> (i32) {
  %result = scf.switch %variant -> (i32) {
    case 0 {
      %case0 = test.addi %a0, %b0 : i32
      scf.yield %case0 : i32
    }
    case 1 {
      %case1 = test.addi %a1, %b1 : i32
      scf.yield %case1 : i32
    }
    default {
      %fallback = test.addi %af, %bf : i32
      scf.yield %fallback : i32
    }
  }
  func.return %result : i32
}

// ----
func.def @switch_factors_common_pure_tail_to_lookup(%variant: index, %a0: i32, %b0: i32, %a1: i32, %b1: i32, %af: i32, %bf: i32) -> (i32) {
  %15, %16 = scf.lookup %variant {
    0 = (%a0, %b0),
    1 = (%a1, %b1)
  } default(%af, %bf) : i32, i32
  %result = test.addi %15, %16 : i32
  func.return %result : i32
}

// ====

// Branch-local effects stay inside the switch while the common pure tail moves
// after it.
func.def @switch_factors_tail_and_preserves_branch_effects(%variant: index, %a0: i32, %b0: i32, %a1: i32, %b1: i32, %af: i32, %bf: i32) -> (i32) {
  %result = scf.switch %variant -> (i32) {
    case 0 {
      test.use %a0 : i32
      %case0 = test.addi %a0, %b0 : i32
      scf.yield %case0 : i32
    }
    case 1 {
      test.use %a1 : i32
      %case1 = test.addi %a1, %b1 : i32
      scf.yield %case1 : i32
    }
    default {
      test.use %af : i32
      %fallback = test.addi %af, %bf : i32
      scf.yield %fallback : i32
    }
  }
  func.return %result : i32
}

// ----
func.def @switch_factors_tail_and_preserves_branch_effects(%variant: index, %a0: i32, %b0: i32, %a1: i32, %b1: i32, %af: i32, %bf: i32) -> (i32) {
  %12, %13 = scf.switch %variant -> (i32, i32) {
    case 0 {
      test.use %a0 : i32
      scf.yield %a0, %b0 : i32, i32
    }
    case 1 {
      test.use %a1 : i32
      scf.yield %a1, %b1 : i32, i32
    }
    default {
      test.use %af : i32
      scf.yield %af, %bf : i32, i32
    }
  }
  %result = test.addi %12, %13 : i32
  func.return %result : i32
}

// ====

// A column whose payload value is identical for every explicit/default row does
// not need to stay in the lookup. The remaining columns keep table selection.
func.def @lookup_compacts_uniform_column(%variant: index, %common: index, %x0: index, %x1: index, %xf: index) -> (index, index) {
  %same, %selected = scf.lookup %variant {
    0 = (%common, %x0),
    1 = (%common, %x1)
  } default(%common, %xf) : index, index
  func.return %same, %selected : index, index
}

// ----
func.def @lookup_compacts_uniform_column(%variant: index, %common: index, %x0: index, %x1: index, %xf: index) -> (index, index) {
  %selected = scf.lookup %variant {
    0 = (%x0),
    1 = (%x1)
  } default(%xf) : index
  func.return %common, %selected : index, index
}

// ====

// Selector facts prune unreachable explicit rows. The lookup remains total by
// keeping a dead default row, but the dead row reuses a reachable payload so it
// does not keep otherwise-unneeded values live.
func.def @lookup_prunes_unreachable_cases(%variant: index, %a: index, %b: index, %dead: index, %fallback: index) -> (index) {
  %bounded = index.assume %variant [range(%variant, 0, 1)] : index
  %result = scf.lookup %bounded {
    0 = (%a),
    1 = (%b),
    2 = (%dead)
  } default(%fallback) : index
  func.return %result : index
}

// ----
func.def @lookup_prunes_unreachable_cases(%variant: index, %a: index, %b: index, %dead: index, %fallback: index) -> (index) {
  %bounded = index.assume %variant [range(%variant, 0, 1)] : index
  %result = scf.lookup %bounded {
    0 = (%a),
    1 = (%b)
  } default(%a) : index
  func.return %result : index
}

// ====

// Even when every explicit key remains reachable, an exhaustive key set makes
// the default row dead. Replacing it with a reachable payload lets ordinary DCE
// remove fallback producers without needing lookup-specific liveness rules.
func.def @lookup_replaces_unreachable_default(%variant: index, %a: index, %b: index, %fallback: index) -> (index) {
  %bounded = index.assume %variant [range(%variant, 0, 1)] : index
  %result = scf.lookup %bounded {
    0 = (%a),
    1 = (%b)
  } default(%fallback) : index
  func.return %result : index
}

// ----
func.def @lookup_replaces_unreachable_default(%variant: index, %a: index, %b: index, %fallback: index) -> (index) {
  %bounded = index.assume %variant [range(%variant, 0, 1)] : index
  %result = scf.lookup %bounded {
    0 = (%a),
    1 = (%b)
  } default(%a) : index
  func.return %result : index
}

// ====

// Reachability drives column forwarding. Values that are uniform across the
// possible rows can be forwarded even if unreachable rows disagree.
func.def @lookup_compacts_reachable_uniform_column(%variant: index, %common: index, %x0: index, %x1: index, %dead_common: index, %dead_x: index, %fallback_common: index, %fallback_x: index) -> (index, index) {
  %bounded = index.assume %variant [range(%variant, 0, 1)] : index
  %same, %selected = scf.lookup %bounded {
    0 = (%common, %x0),
    1 = (%common, %x1),
    2 = (%dead_common, %dead_x)
  } default(%fallback_common, %fallback_x) : index, index
  func.return %same, %selected : index, index
}

// ----
func.def @lookup_compacts_reachable_uniform_column(%variant: index, %common: index, %x0: index, %x1: index, %dead_common: index, %dead_x: index, %fallback_common: index, %fallback_x: index) -> (index, index) {
  %bounded = index.assume %variant [range(%variant, 0, 1)] : index
  %selected = scf.lookup %bounded {
    0 = (%x0),
    1 = (%x1)
  } default(%x0) : index
  func.return %common, %selected : index, index
}

// ====

func.def @forwarded_carried_value_preserves_pipeline_policy(%input: view<64xf32>, %end: index, %depth: index, %factor: index, %initial: f32) -> (f32, f32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %result, %same = scf.for %i = [%begin to %end step %step](%sum = %initial : f32, %unchanged = %initial : f32) -> (f32, f32) pipeline(%depth) unroll(%factor) schedule(recurrence) {
    %value = view.load %input[%i] : view<64xf32> -> f32
    %next = scalar.addf %sum, %value : f32
    scf.yield %next, %unchanged : f32, f32
  }
  func.return %result, %same : f32, f32
}

// ----
func.def @forwarded_carried_value_preserves_pipeline_policy(%input: view<64xf32>, %end: index, %depth: index, %factor: index, %initial: f32) -> (f32, f32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %result = scf.for %i = [%begin to %end step %step](%sum = %initial : f32) -> (f32) pipeline(%depth) unroll(%factor) schedule(recurrence) {
    %value = view.load %input[%i] : view<64xf32> -> f32
    %next = scalar.addf %sum, %value : f32
    scf.yield %next : f32
  }
  func.return %result, %initial : f32, f32
}

