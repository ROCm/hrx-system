CHECK: scf.if %inside {
CHECK: buffer.store.i8 %value, %storage[%offset]
CHECK: func.return %position : i64
CHECK-NOT: index.cast *

// ====
// RUN: with-checks pass canonicalize

// A false greater-than edge and a swapped true greater-equal edge establish
// the same nonnegative range without changing the unguarded source value.
func.def @unsigned_inclusive_edges(%position: i64, %storage: buffer) -> (i64) {
  %origin = scalar.constant 0 : i64
  %value = scalar.constant 42 : i32
  %above = scalar.cmpi ugt, %position, %origin : i64
  scf.if %above {
    %other_offset = index.constant 1 : offset
    buffer.store.i8 %value, %storage[%other_offset]
  } else {
    %offset = index.cast %position : i64 to offset
    buffer.store.i8 %value, %storage[%offset]
  }
  %inside = scalar.cmpi uge, %origin, %position : i64
  scf.if %inside {
    %offset = index.cast %position : i64 to offset
    buffer.store.i8 %value, %storage[%offset]
  }
  func.return %position : i64
}

