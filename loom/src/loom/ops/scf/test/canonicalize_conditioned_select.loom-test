// A structured conditional can constrain each arm more tightly than either
// expression is constrained when evaluated eagerly. Selectification retains
// those facts in an explicit assumption after proving the eager index
// arithmetic fits the target's carrier.
// RUN: pass canonicalize,canonicalize

test.target<low_core> @narrow {index_bitwidth = 32, offset_bitwidth = 32}

func.def target(@narrow) @conditioned_index(%input: index) -> (index) {
  %x = index.assume %input [range(%input, 0, 3)] : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %inside = index.cmp ult, %x, %c2 : index
  %selected = scf.if %inside -> (index) {
    %true_value = index.add %c4, %x : index
    scf.yield %true_value : index
  } else {
    %false_value = index.sub %x, %c2 : index
    scf.yield %false_value : index
  }
  func.return %selected : index
}

// ----
test.target<low_core> @narrow {index_bitwidth = 32, offset_bitwidth = 32}

func.def target(@narrow) @conditioned_index(%input: index) -> (index) {
  %x = index.assume %input [range(%input, 0, 3)] : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %inside = index.cmp ult, %x, %c2 : index
  %true_value = index.add %c4, %x : index
  %false_value = index.sub %x, %c2 : index
  %11 = scf.select %inside, %true_value, %false_value : index
  %selected = index.assume %11 [range(%11, 0, 5)] : index
  func.return %selected : index
}

// ====

// Fixed-width no-wrap arithmetic uses the same fact-dependent safety proof and
// materializes the retained range with scalar.assume.
// RUN: pass canonicalize,canonicalize

func.def @conditioned_signed_i32(%input: i32) -> (i32) {
  %x = scalar.assume %input [range(%input, 0, 3)] : i32
  %c2 = scalar.constant 2 : i32
  %c4 = scalar.constant 4 : i32
  %inside = scalar.cmpi ult, %x, %c2 : i32
  %selected = scf.if %inside -> (i32) {
    %true_value = scalar.addi<nsw> %c4, %x : i32
    scf.yield %true_value : i32
  } else {
    %false_value = scalar.subi<nsw> %x, %c2 : i32
    scf.yield %false_value : i32
  }
  func.return %selected : i32
}

// ----
func.def @conditioned_signed_i32(%input: i32) -> (i32) {
  %x = scalar.assume %input [range(%input, 0, 3)] : i32
  %c2 = scalar.constant 2 : i32
  %c4 = scalar.constant 4 : i32
  %inside = scalar.cmpi ult, %x, %c2 : i32
  %true_value = scalar.addi<nsw> %x, %c4 : i32
  %false_value = scalar.subi<nsw> %x, %c2 : i32
  %12 = scf.select %inside, %true_value, %false_value : i32
  %selected = scalar.assume %12 [range(%12, 0, 5)] : i32
  func.return %selected : i32
}

// ====

// Offset arithmetic wraps by definition and therefore needs no target carrier
// proof. Its selected path still retains the stronger conditioned range.
// RUN: pass canonicalize,canonicalize

func.def @conditioned_offset(%input: offset) -> (offset) {
  %x = index.assume %input [range(%input, 0, 3)] : offset
  %c2 = index.constant 2 : offset
  %c4 = index.constant 4 : offset
  %inside = index.cmp ult, %x, %c2 : offset
  %selected = scf.if %inside -> (offset) {
    %true_value = index.add %c4, %x : offset
    scf.yield %true_value : offset
  } else {
    %false_value = index.sub %x, %c2 : offset
    scf.yield %false_value : offset
  }
  func.return %selected : offset
}

// ----
func.def @conditioned_offset(%input: offset) -> (offset) {
  %x = index.assume %input [range(%input, 0, 3)] : offset
  %c2 = index.constant 2 : offset
  %c4 = index.constant 4 : offset
  %inside = index.cmp ult, %x, %c2 : offset
  %true_value = index.add %c4, %x : offset
  %false_value = index.sub %x, %c2 : offset
  %11 = scf.select %inside, %true_value, %false_value : offset
  %selected = index.assume %11 [range(%11, 0, 5)] : offset
  func.return %selected : offset
}

// ====

// Multiple conditioned results share one variadic assumption per owning
// dialect instead of growing an identity chain per result.
// RUN: pass canonicalize

test.target<low_core> @narrow {index_bitwidth = 32, offset_bitwidth = 32}

func.def target(@narrow) @conditioned_result_tuple(%index_input: index, %scalar_input: i32) -> (index, index, i32, i32) {
  %x = index.assume %index_input [range(%index_input, 0, 3)] : index
  %y = scalar.assume %scalar_input [range(%scalar_input, 0, 3)] : i32
  %ic1 = index.constant 1 : index
  %ic2 = index.constant 2 : index
  %ic4 = index.constant 4 : index
  %ic8 = index.constant 8 : index
  %sc1 = scalar.constant 1 : i32
  %sc2 = scalar.constant 2 : i32
  %sc4 = scalar.constant 4 : i32
  %sc8 = scalar.constant 8 : i32
  %inside = index.cmp ult, %x, %ic2 : index
  %index_a, %index_b, %scalar_a, %scalar_b = scf.if %inside -> (index, index, i32, i32) {
    %then_x = index.assume %x [lt(%x, 2)] : index
    %then_y = scalar.assume %y [lt(%y, 2)] : i32
    %true_index_a = index.add %ic4, %then_x : index
    %true_index_b = index.add %ic8, %then_x : index
    %true_scalar_a = scalar.addi<nsw> %sc4, %then_y : i32
    %true_scalar_b = scalar.addi<nsw> %sc8, %then_y : i32
    scf.yield %true_index_a, %true_index_b, %true_scalar_a, %true_scalar_b : index, index, i32, i32
  } else {
    %else_x = index.assume %x [ge(%x, 2)] : index
    %else_y = scalar.assume %y [ge(%y, 2)] : i32
    %false_index_a = index.sub %else_x, %ic2 : index
    %false_index_b = index.sub %else_x, %ic1 : index
    %false_scalar_a = scalar.subi<nsw> %else_y, %sc2 : i32
    %false_scalar_b = scalar.subi<nsw> %else_y, %sc1 : i32
    scf.yield %false_index_a, %false_index_b, %false_scalar_a, %false_scalar_b : index, index, i32, i32
  }
  func.return %index_a, %index_b, %scalar_a, %scalar_b : index, index, i32, i32
}

// ----
test.target<low_core> @narrow {index_bitwidth = 32, offset_bitwidth = 32}

func.def target(@narrow) @conditioned_result_tuple(%index_input: index, %scalar_input: i32) -> (index, index, i32, i32) {
  %x = index.assume %index_input [range(%index_input, 0, 3)] : index
  %y = scalar.assume %scalar_input [range(%scalar_input, 0, 3)] : i32
  %ic1 = index.constant 1 : index
  %ic2 = index.constant 2 : index
  %ic4 = index.constant 4 : index
  %ic8 = index.constant 8 : index
  %sc1 = scalar.constant 1 : i32
  %sc2 = scalar.constant 2 : i32
  %sc4 = scalar.constant 4 : i32
  %sc8 = scalar.constant 8 : i32
  %inside = index.cmp ult, %x, %ic2 : index
  %true_index_a = index.add %ic4, %x : index
  %true_index_b = index.add %ic8, %x : index
  %true_scalar_a = scalar.addi<nsw> %y, %sc4 : i32
  %true_scalar_b = scalar.addi<nsw> %y, %sc8 : i32
  %false_index_a = index.sub %x, %ic2 : index
  %false_index_b = index.sub %x, %ic1 : index
  %false_scalar_a = scalar.subi<nsw> %y, %sc2 : i32
  %false_scalar_b = scalar.subi<nsw> %y, %sc1 : i32
  %35 = scf.select %inside, %true_index_a, %false_index_a : index
  %36 = scf.select %inside, %true_index_b, %false_index_b : index
  %37 = scf.select %inside, %true_scalar_a, %false_scalar_a : i32
  %38 = scf.select %inside, %true_scalar_b, %false_scalar_b : i32
  %index_a, %index_b = index.assume %35, %36 [range(%35, 0, 5), range(%36, 1, 9)] : index, index
  %scalar_a, %scalar_b = scalar.assume %37, %38 [range(%37, 0, 5), range(%38, 1, 9)] : i32, i32
  func.return %index_a, %index_b, %scalar_a, %scalar_b : index, index, i32, i32
}

// ====

// Without a target, index arithmetic has no carrier width against which to
// prove eager execution safe. The guarded operations and their edge facts stay
// structured.
// RUN: pass canonicalize,canonicalize

func.def @targetless_index_stays_guarded(%input: index) -> (index) {
  %x = index.assume %input [range(%input, 0, 3)] : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %inside = index.cmp ult, %x, %c2 : index
  %selected = scf.if %inside -> (index) {
    %true_value = index.add %c4, %x : index
    scf.yield %true_value : index
  } else {
    %false_value = index.sub %x, %c2 : index
    scf.yield %false_value : index
  }
  func.return %selected : index
}

// ----
func.def @targetless_index_stays_guarded(%input: index) -> (index) {
  %x = index.assume %input [range(%input, 0, 3)] : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %inside = index.cmp ult, %x, %c2 : index
  %selected = scf.if %inside -> (index) {
    %9 = index.assume %x [lt(%x, 2)] : index
    %true_value = index.add %c4, %9 : index
    scf.yield %true_value : index
  } else {
    %10 = index.assume %x [ge(%x, 2)] : index
    %false_value = index.sub %10, %c2 : index
    scf.yield %false_value : index
  }
  func.return %selected : index
}

// ====

// Edge conditions make each operation safe while guarded, but the operations
// can overflow on the opposite edge. Speculation therefore remains rejected.
// RUN: pass canonicalize,canonicalize

func.def @conditioned_nsw_stays_guarded(%x: i32) -> (i32) {
  %c2 = scalar.constant 2 : i32
  %c4 = scalar.constant 4 : i32
  %inside = scalar.cmpi slt, %x, %c2 : i32
  %selected = scf.if %inside -> (i32) {
    %true_value = scalar.addi<nsw> %c4, %x : i32
    scf.yield %true_value : i32
  } else {
    %false_value = scalar.subi<nsw> %x, %c2 : i32
    scf.yield %false_value : i32
  }
  func.return %selected : i32
}

// ----
func.def @conditioned_nsw_stays_guarded(%x: i32) -> (i32) {
  %c2 = scalar.constant 2 : i32
  %c4 = scalar.constant 4 : i32
  %inside = scalar.cmpi slt, %x, %c2 : i32
  %selected = scf.if %inside -> (i32) {
    %8 = scalar.assume %x [lt(%x, 2)] : i32
    %true_value = scalar.addi<nsw> %8, %c4 : i32
    scf.yield %true_value : i32
  } else {
    %9 = scalar.assume %x [ge(%x, 2)] : i32
    %false_value = scalar.subi<nsw> %9, %c2 : i32
    scf.yield %false_value : i32
  }
  func.return %selected : i32
}

// ====

// Signed reversed predicates use the structured result fact directly; the
// selectification preview does not decode or normalize the condition syntax.
// RUN: pass canonicalize,canonicalize

func.def @reversed_signed_predicate(%input: i32) -> (i32) {
  %x = scalar.assume %input [range(%input, -3, 0)] : i32
  %cm1 = scalar.constant -1 : i32
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %upper_pair = scalar.cmpi sge, %x, %cm1 : i32
  %selected = scf.if %upper_pair -> (i32) {
    %true_value = scalar.addi<nsw> %x, %c1 : i32
    scf.yield %true_value : i32
  } else {
    %negated = scalar.subi<nsw> %c0, %x : i32
    %false_value = scalar.subi<nsw> %negated, %c2 : i32
    scf.yield %false_value : i32
  }
  func.return %selected : i32
}

// ----
func.def @reversed_signed_predicate(%input: i32) -> (i32) {
  %x = scalar.assume %input [range(%input, -3, 0)] : i32
  %cm1 = scalar.constant -1 : i32
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %upper_pair = scalar.cmpi sge, %x, %cm1 : i32
  %true_value = scalar.addi<nsw> %x, %c1 : i32
  %negated = scalar.subi<nsw> %c0, %x : i32
  %false_value = scalar.subi<nsw> %negated, %c2 : i32
  %14 = scf.select %upper_pair, %true_value, %false_value : i32
  %selected = scalar.assume %14 [range(%14, 0, 1)] : i32
  func.return %selected : i32
}

// ====

// Nested conditionals independently preserve their structured bounds before
// the containing arm is considered for selectification.
// RUN: pass canonicalize,canonicalize

test.target<low_core> @nested_narrow {index_bitwidth = 32, offset_bitwidth = 32}

func.def target(@nested_narrow) @nested_conditioned_index(%input: index) -> (index) {
  %x = index.assume %input [range(%input, 0, 5)] : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %outer_condition = index.cmp ult, %x, %c4 : index
  %selected = scf.if %outer_condition -> (index) {
    %inner_condition = index.cmp ult, %x, %c2 : index
    %inner = scf.if %inner_condition -> (index) {
      %inner_true = index.add %x, %c8 : index
      scf.yield %inner_true : index
    } else {
      %inner_false = index.sub %x, %c2 : index
      scf.yield %inner_false : index
    }
    scf.yield %inner : index
  } else {
    %outer_false = index.sub %x, %c4 : index
    scf.yield %outer_false : index
  }
  func.return %selected : index
}

// ----
test.target<low_core> @nested_narrow {index_bitwidth = 32, offset_bitwidth = 32}

func.def target(@nested_narrow) @nested_conditioned_index(%input: index) -> (index) {
  %x = index.assume %input [range(%input, 0, 5)] : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %outer_condition = index.cmp ult, %x, %c4 : index
  %inner_condition = index.cmp ult, %x, %c2 : index
  %inner_true = index.add %x, %c8 : index
  %inner_false = index.sub %x, %c2 : index
  %17 = scf.select %inner_condition, %inner_true, %inner_false : index
  %outer_false = index.sub %x, %c4 : index
  %19 = scf.select %outer_condition, %17, %outer_false : index
  %selected = index.assume %19 [range(%19, 0, 9)] : index
  func.return %selected : index
}
