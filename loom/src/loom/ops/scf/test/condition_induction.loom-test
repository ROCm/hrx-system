// RUN: pass canonicalize

// The load may stop the loop before the limit. Inputs above the limit take no
// iterations, so the header and result retain the full initial [0, 63] envelope.
func.def @short_circuit_loaded_guard(%input: view<37xi32>, %requested_start: index) -> (i64, i64) {
  %initial = index.assume %requested_start [range(%requested_start, 0, 63)] : index
  %position_limit = index.constant 37 : index
  %position_step = index.constant 1 : index
  %sample_zero = scalar.constant 0 : i32
  %result = scf.while(%before = %initial : index) -> (index) {
    %header_low = test.fact_range_lo %before : index -> i64
    %header_high = test.fact_range_hi %before : index -> i64
    test.use %header_low, %header_high : i64, i64
    %in_range = index.cmp ult, %before, %position_limit : index
    %continue = scf.if %in_range -> (i1) {
      %sample = view.load %input[%before] : view<37xi32> -> i32
      %positive = scalar.cmpi sgt, %sample, %sample_zero : i32
      scf.yield %positive : i1
    } else {
      scf.yield %in_range : i1
    }
    scf.condition %continue, %before : i1, index
  } do(%current: index) {
    %next = index.add %current, %position_step : index
    scf.yield %next : index
  }
  %result_low = test.fact_range_lo %result : index -> i64
  %result_high = test.fact_range_hi %result : index -> i64
  func.return %result_low, %result_high : i64, i64
}

// ----
func.def @short_circuit_loaded_guard(%input: view<37xi32>, %requested_start: index) -> (i64, i64) {
  %initial = index.assume %requested_start [range(%requested_start, 0, 63)] : index
  %position_limit = index.constant 37 : index
  %position_step = index.constant 1 : index
  %sample_zero = scalar.constant 0 : i32
  %result = scf.while(%before = %initial : index) -> (index) {
    %header_low = scalar.constant 0 : i64
    %header_high = scalar.constant 63 : i64
    test.use %header_low, %header_high : i64, i64
    %in_range = index.cmp ult, %before, %position_limit : index
    %continue = scf.if %in_range -> (i1) {
      %20 = index.assume %before [lt(%before, 37)] : index
      %sample = view.load %input[%20] : view<37xi32> -> i32
      %positive = scalar.cmpi sgt, %sample, %sample_zero : i32
      scf.yield %positive : i1
    } else {
      scf.yield %in_range : i1
    }
    scf.condition %continue, %before : i1, index
  } do(%current: index) {
    %next = index.add %current, %position_step : index
    scf.yield %next : index
  }
  %result_low = scalar.constant 0 : i64
  %result_high = scalar.constant 63 : i64
  func.return %result_low, %result_high : i64, i64
}

// ====
// RUN: pass canonicalize

// Continuing through the false arm requires the inverted guard to be false.
// Descending updates cannot remove zero-trip inputs below the floor.
func.def @inverted_descending_guard(%requested_start: index, %keep_going: i1) -> (i64, i64) {
  %initial = index.assume %requested_start [range(%requested_start, 0, 63)] : index
  %position_floor = index.constant 37 : index
  %position_step = index.constant 1 : index
  %stop = scalar.constant false : i1
  %result = scf.while(%before = %initial : index) -> (index) {
    %header_low = test.fact_range_lo %before : index -> i64
    %header_high = test.fact_range_hi %before : index -> i64
    test.use %header_low, %header_high : i64, i64
    %at_floor = index.cmp sle, %before, %position_floor : index
    %continue = scf.if %at_floor -> (i1) {
      scf.yield %stop : i1
    } else {
      scf.yield %keep_going : i1
    }
    scf.condition %continue, %before : i1, index
  } do(%current: index) {
    %next = index.sub %current, %position_step : index
    scf.yield %next : index
  }
  %result_low = test.fact_range_lo %result : index -> i64
  %result_high = test.fact_range_hi %result : index -> i64
  func.return %result_low, %result_high : i64, i64
}

// ----
func.def @inverted_descending_guard(%requested_start: index, %keep_going: i1) -> (i64, i64) {
  %initial = index.assume %requested_start [range(%requested_start, 0, 63)] : index
  %position_floor = index.constant 37 : index
  %position_step = index.constant 1 : index
  %stop = scalar.constant false : i1
  %result = scf.while(%before = %initial : index) -> (index) {
    %header_low = scalar.constant 0 : i64
    %header_high = scalar.constant 63 : i64
    test.use %header_low, %header_high : i64, i64
    %at_floor = index.cmp sle, %before, %position_floor : index
    %continue = scf.select %at_floor, %stop, %keep_going : i1
    scf.condition %continue, %before : i1, index
  } do(%current: index) {
    %next = index.sub %current, %position_step : index
    scf.yield %next : index
  }
  %result_low = scalar.constant 0 : i64
  %result_high = scalar.constant 63 : i64
  func.return %result_low, %result_high : i64, i64
}

