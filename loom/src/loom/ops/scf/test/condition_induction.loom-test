// ====
// RUN: pass canonicalize

// Only the first visit requires the guard. The carried bypass becomes true,
// so using its initial false value to bound later header visits is unsound.
func.def @disjoined_carried_bypass(%requested_start: index) -> (i64, i64) {
  %initial = index.assume %requested_start [range(%requested_start, 0, 63)] : index
  %position_limit = index.constant 37 : index
  %position_step = index.constant 1 : index
  %initial_bypass = scalar.constant false : i1
  %enable_bypass = scalar.constant true : i1
  %result, %final_bypass = scf.while(%before = %initial : index, %header_bypass = %initial_bypass : i1) -> (index, i1) {
    %header_low = test.fact_range_lo %before : index -> i64
    %header_high = test.fact_range_hi %before : index -> i64
    test.use %header_low, %header_high : i64, i64
    %in_range = index.cmp slt, %before, %position_limit : index
    %continue = scalar.ori %in_range, %header_bypass : i1
    scf.condition %continue, %before, %header_bypass : i1, index, i1
  } do(%current: index, %bypass: i1) {
    %next = index.add %current, %position_step : index
    scf.yield %next, %enable_bypass : index, i1
  }
  %result_low = test.fact_range_lo %result : index -> i64
  %result_high = test.fact_range_hi %result : index -> i64
  func.return %result_low, %result_high : i64, i64
}

// ----
