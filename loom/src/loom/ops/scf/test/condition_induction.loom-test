// ====
// RUN: pass canonicalize

// The condition is result ordinal one. The independently used first result can
// be true on the false edge and must not stand in for the selected result.
func.def @second_if_result_guard(%requested_start: index, %keep_going: i1, %inside_marker: i1) -> (i64, i64) {
  %initial = index.assume %requested_start [range(%requested_start, 0, 63)] : index
  %position_limit = index.constant 37 : index
  %position_step = index.constant 1 : index
  %outside_marker = scalar.constant true : i1
  %result = scf.while(%before = %initial : index) -> (index) {
    %header_low = test.fact_range_lo %before : index -> i64
    %header_high = test.fact_range_hi %before : index -> i64
    test.use %header_low, %header_high : i64, i64
    %in_range = index.cmp slt, %before, %position_limit : index
    %marker, %continue = scf.if %in_range -> (i1, i1) {
      scf.yield %inside_marker, %keep_going : i1, i1
    } else {
      scf.yield %outside_marker, %in_range : i1, i1
    }
    test.use %marker : i1
    scf.condition %continue, %before : i1, index
  } do(%current: index) {
    %next = index.add %current, %position_step : index
    scf.yield %next : index
  }
  %result_low = test.fact_range_lo %result : index -> i64
  %result_high = test.fact_range_hi %result : index -> i64
  func.return %result_low, %result_high : i64, i64
}

// ----
func.def @second_if_result_guard(%requested_start: index, %keep_going: i1, %inside_marker: i1) -> (i64, i64) {
  %initial = index.assume %requested_start [range(%requested_start, 0, 63)] : index
  %position_limit = index.constant 37 : index
  %position_step = index.constant 1 : index
  %outside_marker = scalar.constant true : i1
  %result = scf.while(%before = %initial : index) -> (index) {
    %header_low = scalar.constant 0 : i64
    %header_high = scalar.constant 63 : i64
    test.use %header_low, %header_high : i64, i64
    %in_range = index.cmp slt, %before, %position_limit : index
    %marker = scf.select %in_range, %inside_marker, %outside_marker : i1
    %continue = scf.select %in_range, %keep_going, %in_range : i1
    test.use %marker : i1
    scf.condition %continue, %before : i1, index
  } do(%current: index) {
    %next = index.add %current, %position_step : index
    scf.yield %next : index
  }
  %result_low = scalar.constant 0 : i64
  %result_high = scalar.constant 63 : i64
  func.return %result_low, %result_high : i64, i64
}

// ====
// RUN: pass canonicalize

// A selected result cannot expose its branch-local comparison as an invariant
// guard. That comparison's bound changes with the counter on every visit.
func.def @branch_local_bound_stays_local(%requested_start: index, %enabled: i1) -> (i64, i64) {
  %initial = index.assume %requested_start [range(%requested_start, 0, 63)] : index
  %position_step = index.constant 1 : index
  %stop = scalar.constant false : i1
  %result = scf.while(%before = %initial : index) -> (index) {
    %header_low = test.fact_range_lo %before : index -> i64
    %header_high = test.fact_range_hi %before : index -> i64
    test.use %header_low, %header_high : i64, i64
    %continue = scf.if %enabled -> (i1) {
      %changing_limit = index.add %before, %position_step : index
      %below_limit = index.cmp slt, %before, %changing_limit : index
      scf.yield %below_limit : i1
    } else {
      scf.yield %stop : i1
    }
    scf.condition %continue, %before : i1, index
  } do(%current: index) {
    %next = index.add %current, %position_step : index
    scf.yield %next : index
  }
  %result_low = test.fact_range_lo %result : index -> i64
  %result_high = test.fact_range_hi %result : index -> i64
  func.return %result_low, %result_high : i64, i64
}

// ----
func.def @branch_local_bound_stays_local(%requested_start: index, %enabled: i1) -> (i64, i64) {
  %initial = index.assume %requested_start [range(%requested_start, 0, 63)] : index
  %position_step = index.constant 1 : index
  %result = scf.while(%before = %initial : index) -> (index) {
    %header_low = scalar.constant -9223372036854775808 : i64
    %header_high = scalar.constant 9223372036854775807 : i64
    test.use %header_low, %header_high : i64, i64
    scf.condition %enabled, %before : i1, index
  } do(%current: index) {
    %next = index.add %current, %position_step : index
    scf.yield %next : index
  }
  %result_low = scalar.constant -9223372036854775808 : i64
  %result_high = scalar.constant 9223372036854775807 : i64
  func.return %result_low, %result_high : i64, i64
}
