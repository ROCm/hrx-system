// RUN: pass canonicalize

// Per-iteration uniform state may leave the loop at different iterations.
func.def @for_unknown_exit(%limit: index, %seed: index) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %constant = index.constant 7 : index
  %disabled = scalar.constant false : i1
  %result, %unchanged, %exact_result, %last_flag = scf.for %iv = [%begin to %limit step %step](%counter = %begin : index, %fixed = %seed : index, %exact = %constant : index, %flag = %disabled : i1) -> (index, index, index, i1) {
    %at_first = index.cmp eq, %counter, %begin : index
    %next = index.add %counter, %step : index
    %body_uniform = test.fact_cluster_uniform %counter : index -> i1
    test.use %body_uniform : i1
    scf.yield %next, %fixed, %constant, %at_first : index, index, index, i1
  }
  %result_subgroup = test.fact_subgroup_uniform %result : index -> i1
  %result_workgroup = test.fact_workgroup_uniform %result : index -> i1
  %result_cluster = test.fact_cluster_uniform %result : index -> i1
  %result_varying = test.fact_lane_varying %result : index -> i1
  %unchanged_uniform = test.fact_cluster_uniform %unchanged : index -> i1
  %exact_uniform = test.fact_cluster_uniform %exact_result : index -> i1
  %flag_predicate = test.fact_lane_predicate %last_flag : i1 -> i1
  test.use %result_subgroup, %result_workgroup, %result_cluster, %result_varying, %unchanged_uniform, %exact_uniform, %flag_predicate : i1, i1, i1, i1, i1, i1, i1
  func.return
}

