// RUN: pass canonicalize

// Compose the reversed condition projection with body forwarding; exit order stays reversed.
func.def @condition_permutation(%count: index, %repeat: i1, %choose: i1) {
  %seed0 = index.constant 0 : offset
  %seed1 = index.constant 8 : offset
  %seed2 = index.constant 16 : offset
  %seed3 = index.constant 24 : offset
  %seed4 = index.constant 32 : offset
  %seed5 = index.constant 40 : offset
  %seed6 = index.constant 48 : offset
  %seed7 = index.constant 56 : offset
  %seed8 = index.constant 64 : offset
  %seed9 = index.constant 72 : offset
  %seed10 = index.constant 80 : offset
  %seed11 = index.constant 88 : offset
  %injected = index.constant 96 : offset
  %out0, %out1, %out2, %out3, %out4, %out5, %out6, %out7, %out8, %out9, %out10, %out11 = scf.while(%slot0 = %seed0 : offset, %slot1 = %seed1 : offset, %slot2 = %seed2 : offset, %slot3 = %seed3 : offset, %slot4 = %seed4 : offset, %slot5 = %seed5 : offset, %slot6 = %seed6 : offset, %slot7 = %seed7 : offset, %slot8 = %seed8 : offset, %slot9 = %seed9 : offset, %slot10 = %seed10 : offset, %slot11 = %seed11 : offset) -> (offset, offset, offset, offset, offset, offset, offset, offset, offset, offset, offset, offset) {
    %before0_range_lo = test.fact_range_lo %slot0 : offset -> i64
    test.use %before0_range_lo : i64
    %before0_range_hi = test.fact_range_hi %slot0 : offset -> i64
    test.use %before0_range_hi : i64
    %before0_divisor = test.fact_divisor %slot0 : offset -> i64
    test.use %before0_divisor : i64
    %before11_range_lo = test.fact_range_lo %slot11 : offset -> i64
    test.use %before11_range_lo : i64
    %before11_range_hi = test.fact_range_hi %slot11 : offset -> i64
    test.use %before11_range_hi : i64
    %before11_divisor = test.fact_divisor %slot11 : offset -> i64
    test.use %before11_divisor : i64
    scf.condition %repeat, %slot11, %slot10, %slot9, %slot8, %slot7, %slot6, %slot5, %slot4, %slot3, %slot2, %slot1, %slot0 : i1, offset, offset, offset, offset, offset, offset, offset, offset, offset, offset, offset, offset
  } do(%body0: offset, %body1: offset, %body2: offset, %body3: offset, %body4: offset, %body5: offset, %body6: offset, %body7: offset, %body8: offset, %body9: offset, %body10: offset, %body11: offset) {
    %body0_range_lo = test.fact_range_lo %body0 : offset -> i64
    test.use %body0_range_lo : i64
    %body0_range_hi = test.fact_range_hi %body0 : offset -> i64
    test.use %body0_range_hi : i64
    %body0_divisor = test.fact_divisor %body0 : offset -> i64
    test.use %body0_divisor : i64
    %body11_range_lo = test.fact_range_lo %body11 : offset -> i64
    test.use %body11_range_lo : i64
    %body11_range_hi = test.fact_range_hi %body11 : offset -> i64
    test.use %body11_range_hi : i64
    %body11_divisor = test.fact_divisor %body11 : offset -> i64
    test.use %body11_divisor : i64
    scf.yield %body10, %body9, %body8, %body7, %body6, %body5, %body4, %body3, %body2, %body1, %body0, %injected : offset, offset, offset, offset, offset, offset, offset, offset, offset, offset, offset, offset
  }
  %result0_range_lo = test.fact_range_lo %out0 : offset -> i64
  test.use %result0_range_lo : i64
  %result0_range_hi = test.fact_range_hi %out0 : offset -> i64
  test.use %result0_range_hi : i64
  %result11_range_lo = test.fact_range_lo %out11 : offset -> i64
  test.use %result11_range_lo : i64
  %result11_range_hi = test.fact_range_hi %out11 : offset -> i64
  test.use %result11_range_hi : i64
  func.return
}

