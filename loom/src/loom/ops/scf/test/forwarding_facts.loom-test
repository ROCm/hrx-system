  %injected = index.constant 96 : offset
  %alternative = index.constant 104 : offset
  %out0, %out1, %out2, %out3, %out4, %out5, %out6, %out7, %out8, %out9, %out10, %out11 = scf.for %iv = [%begin to %count step %step](%slot0 = %seed0 : offset, %slot1 = %seed1 : offset, %slot2 = %seed2 : offset, %slot3 = %seed3 : offset, %slot4 = %seed4 : offset, %slot5 = %seed5 : offset, %slot6 = %seed6 : offset, %slot7 = %seed7 : offset, %slot8 = %seed8 : offset, %slot9 = %seed9 : offset, %slot10 = %seed10 : offset, %slot11 = %seed11 : offset) -> (offset, offset, offset, offset, offset, offset, offset, offset, offset, offset, offset, offset) {
    %before0_range_lo = test.fact_range_lo %slot0 : offset -> i64
    test.use %before0_range_lo : i64
