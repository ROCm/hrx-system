// RUN: roundtrip

// Generic target record.
target.generic<reference> @reference

target.generic<reference> @host {subgroup_size = 0}

// External target contract valid before its definition is linked.
target.decl @external_target

func.def @query_subgroup_size() -> (index) {
  %size = target.subgroup.size : index
  func.return %size : index
}
