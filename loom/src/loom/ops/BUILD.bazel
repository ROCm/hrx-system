    "buffer",
    "cfg",
    "channel",
    "check",
    "command",
    "config",
    "encoding",
    "func",
    "global",
    "group",
    "index",
    "kernel",
    "low",
    "pass",
    "pipeline",
    "pool",
    "sanitizer",
    "scalar",
    "scf",
    "target",
    "template",
    "test",
    "vector",
    "view",
]

loom_cc_library_group(
    name = "declaration_boundary_deps",
    testonly = True,
    visibility = ["//visibility:private"],
    deps = [
        "//loom/src/loom/ops/%s:op_defs" % dialect
        for dialect in _DIALECTS
    ] + select({
        "//loom/config/target/arch:amdgpu": ["//loom/src/loom/target/arch/amdgpu/ops:op_defs"],
        "//conditions:default": [],
    }) + select({
        "//loom/config/target/arch:spirv": ["//loom/src/loom/target/arch/spirv/ops:op_defs"],
        "//conditions:default": [],
    }) + select({
        "//loom/config/target/arch:vm": ["//loom/src/loom/target/arch/vm/ops:op_defs"],
        "//conditions:default": [],
    }) + select({
        "//loom/config/target/arch:wasm": ["//loom/src/loom/target/arch/wasm/ops:op_defs"],
        "//conditions:default": [],
    }) + select({
        "//loom/config/target/arch:x86": ["//loom/src/loom/target/arch/x86/ops:op_defs"],
        "//conditions:default": [],
    }) + select({
        "//loom/config/target/arch:xdna": ["//loom/src/loom/target/arch/amd/xdna/aie2p/ops:op_defs"],
        "//conditions:default": [],
    }),
)

