// ----
func.def @access_only_instruments_non_contiguous_fragment_memory(%buffer: buffer, %batch: index, %row: index, %column: index, %value: vector<8xf32>) {
  %fragment_extent = index.constant 2 : index
  %row_stride = index.constant 64 : index
  %layout = encoding.layout.strided [4096, 2, %row_stride] : encoding<layout>
  %base = index.constant 0 : offset
  %global = buffer.assume.memory_space<global> %buffer : buffer
  %output = buffer.view %global[%base] : buffer -> view<8x64x64xf32, %layout>
  sanitizer.assert.accesses<write> %output[%batch, %row, %column] {static_count = 2, static_extents = [1, 1, 1], static_strides = [0, 1, 0]} : view<8x64x64xf32, %layout>
  %11 = index.constant 1 : index
  %12 = index.add %column, %11 : index
  sanitizer.assert.accesses<write> %output[%batch, %row, %12] {static_count = 2, static_extents = [1, 1, 1], static_strides = [0, 1, 0]} : view<8x64x64xf32, %layout>
  vector.fragment.store<result> %value, %output[%batch, %row, %column] shape [%fragment_extent, %fragment_extent] : vector<8xf32>, view<8x64x64xf32, %layout>
  func.return
}

