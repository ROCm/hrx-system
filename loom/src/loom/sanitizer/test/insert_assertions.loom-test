  vector.atomic.reduce<addi> %value, %view[%origin][%offsets] {ordering = relaxed, scope = workgroup} : vector<2xi32>, view<16xi32>, vector<2xindex>
  %14 = vector.extract %offsets[0] : vector<2xindex> -> index
  %15 = index.add %origin, %14 : index
  sanitizer.assert.access<read_write> %view[%15] : view<16xi32>
  %16 = vector.extract %offsets[1] : vector<2xindex> -> index
  %17 = index.add %origin, %16 : index
  sanitizer.assert.access<read_write> %view[%17] : view<16xi32>
  %old = vector.atomic.rmw<addi> %value, %view[%origin][%offsets] {ordering = relaxed, scope = workgroup} : vector<2xi32>, view<16xi32>, vector<2xindex>
  %10 = vector.extract %offsets[0] : vector<2xindex> -> index
  %11 = index.add %origin, %10 : index
  sanitizer.assert.access<read_write> %view[%11] : view<16xi32>
  %12 = vector.extract %offsets[1] : vector<2xindex> -> index
  %13 = index.add %origin, %12 : index
  sanitizer.assert.access<read_write> %view[%13] : view<16xi32>
  %cmp = vector.atomic.cmpxchg %expected, %replacement, %view[%origin][%offsets] {failure_ordering = acquire, scope = workgroup, success_ordering = acq_rel} : vector<2xi32>, view<16xi32>, vector<2xindex> -> vector<2xi32>
  func.return %old, %cmp : vector<2xi32>, vector<2xi32>
