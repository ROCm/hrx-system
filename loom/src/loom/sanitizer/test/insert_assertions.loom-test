  func.return
}

// ====

// RUN: pass sanitizer-insert-assertions{checks=access}
func.def @access_only_uses_memory_space_facts(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %origin = index.constant 0 : index
  %global_input = buffer.assume.memory_space<global> %input : buffer
  %global_output = buffer.assume.memory_space<global> %output : buffer
  %generic_input = buffer.assume.memory_space<generic> %input : buffer
  %host_output = buffer.assume.memory_space<host> %output : buffer
  %input_view = buffer.view %global_input[%base] : buffer -> view<1xi32>
  %output_view = buffer.view %global_output[%base] : buffer -> view<1xi32>
  %generic_view = buffer.view %generic_input[%base] : buffer -> view<1xi32>
  %host_view = buffer.view %host_output[%base] : buffer -> view<1xi32>
  %global_value = view.load %input_view[%origin] : view<1xi32> -> i32
  view.store %global_value, %output_view[%origin] : i32, view<1xi32>
  %generic_value = view.load %generic_view[%origin] : view<1xi32> -> i32
  view.store %generic_value, %host_view[%origin] : i32, view<1xi32>
  %bytes = index.constant 4 : offset
  %scratch = buffer.alloca<workgroup> align(4) %bytes : buffer
  %scratch_view = buffer.view %scratch[%base] : buffer -> view<1xi32>
  %scratch_value = view.load %scratch_view[%origin] : view<1xi32> -> i32
  %private = buffer.alloca<private> align(4) %bytes : buffer
  %private_view = buffer.view %private[%base] : buffer -> view<1xi32>
  view.store %scratch_value, %private_view[%origin] : i32, view<1xi32>
  func.return
}

// ----
func.def @access_only_uses_memory_space_facts(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %origin = index.constant 0 : index
  %global_input = buffer.assume.memory_space<global> %input : buffer
  %global_output = buffer.assume.memory_space<global> %output : buffer
  %generic_input = buffer.assume.memory_space<generic> %input : buffer
  %host_output = buffer.assume.memory_space<host> %output : buffer
  %input_view = buffer.view %global_input[%base] : buffer -> view<1xi32>
  %output_view = buffer.view %global_output[%base] : buffer -> view<1xi32>
  %generic_view = buffer.view %generic_input[%base] : buffer -> view<1xi32>
  %host_view = buffer.view %host_output[%base] : buffer -> view<1xi32>
  sanitizer.assert.access<read> %input_view[%origin] : view<1xi32>
  %global_value = view.load %input_view[%origin] : view<1xi32> -> i32
  sanitizer.assert.access<write> %output_view[%origin] : view<1xi32>
  view.store %global_value, %output_view[%origin] : i32, view<1xi32>
  sanitizer.assert.access<read> %generic_view[%origin] : view<1xi32>
  %generic_value = view.load %generic_view[%origin] : view<1xi32> -> i32
  view.store %generic_value, %host_view[%origin] : i32, view<1xi32>
  %bytes = index.constant 4 : offset
  %scratch = buffer.alloca<workgroup> align(4) %bytes : buffer
  %scratch_view = buffer.view %scratch[%base] : buffer -> view<1xi32>
  %scratch_value = view.load %scratch_view[%origin] : view<1xi32> -> i32
  %private = buffer.alloca<private> align(4) %bytes : buffer
  %private_view = buffer.view %private[%base] : buffer -> view<1xi32>
  view.store %scratch_value, %private_view[%origin] : i32, view<1xi32>
  func.return
}

