// RUN: pass sanitizer-insert-assertions{checks=value}

// Explicit assumes become checked aliases instead of duplicated assume/assert
// pairs. Predicates already proven by the incoming alias are omitted from the
// new runtime assertion.
func.def @assume_predicates_filter_to_missing_proof(%n: index) -> (index) {
  %known = index.assume %n [range(%n, 0, 1024)] : index
  %checked = index.assume %known [range(%known, 0, 2048), multiple_of(%known, 16)] : index
  func.return %checked : index
}

// ----
func.def @assume_predicates_filter_to_missing_proof(%n: index) -> (index) {
  %known = sanitizer.assert.value %n [range(%n, 0, 1024)] : index
  %checked = sanitizer.assert.value %known [multiple_of(%known, 16)] : index
  func.return %checked : index
}

// ====

// A fully proven assume has no runtime work left; it becomes the source alias.
func.def @assume_with_only_proven_predicates_erases(%n: index) -> (index) {
  %known = index.assume %n [range(%n, 0, 1024)] : index
  %checked = index.assume %known [range(%known, 0, 2048)] : index
  func.return %checked : index
}

// ----
func.def @assume_with_only_proven_predicates_erases(%n: index) -> (index) {
  %known = sanitizer.assert.value %n [range(%n, 0, 1024)] : index
  func.return %known : index
}

// ====

// The second assumption repeats alias-local relations established by the
// first. Only the first relation needs an executable assertion.
func.def @retained_relations_filter_repeated_assume(%a: index, %b: index) -> (index, index) {
  %related_a, %related_b = index.assume %a, %b [lt(%a, %b), ne(%a, 42)] : index, index
  %repeated_a, %repeated_b = index.assume %related_a, %related_b [lt(%related_a, %related_b), ne(%related_a, 42)] : index, index
  func.return %repeated_a, %repeated_b : index, index
}

// ----
func.def @retained_relations_filter_repeated_assume(%a: index, %b: index) -> (index, index) {
  %related_a, %related_b = sanitizer.assert.value %a, %b [lt(%a, %b), ne(%a, 42)] : index, index
  func.return %related_a, %related_b : index, index
}

// ====

// Predicate SSA operands that are not themselves checked aliases are still
// listed on the assertion so the predicate remains verifiable and reportable.
func.def @assume_with_relational_rhs_value(%n: index) -> (index) {
  %limit = index.constant 128 : index
  %bounded = index.assume %n [lt(%n, %limit)] : index
  func.return %bounded : index
}

// ----
func.def @assume_with_relational_rhs_value(%n: index) -> (index) {
  %limit = index.constant 128 : index
  %bounded, %5 = sanitizer.assert.value %n, %limit [lt(%n, %limit)] : index, index
  func.return %bounded : index
}

// ====

// Signed mathematical relations keep the authored operand domains. The
// materialization pass owns conversion to an executable comparison domain.
func.def @assume_with_mixed_relational_rhs(%candidate: i32, %tile_end: index) -> (i32) {
  %bounded = scalar.assume %candidate [lt(%candidate, %tile_end)] : i32
  func.return %bounded : i32
}

// ----
func.def @assume_with_mixed_relational_rhs(%candidate: i32, %tile_end: index) -> (i32) {
  %bounded, %5 = sanitizer.assert.value %candidate, %tile_end [lt(%candidate, %tile_end)] : i32, index
  func.return %bounded : i32
}

// ====

// Scalar floating-point assumes use the same assertion vocabulary as fast-math
// checks.
func.def @float_assume_becomes_value_assertion(%x: f32) -> (f32) {
  %checked = scalar.assume %x [not_nan(%x), not_inf(%x)] : f32
  func.return %checked : f32
}

// ----
func.def @float_assume_becomes_value_assertion(%x: f32) -> (f32) {
  %checked = sanitizer.assert.value %x [not_nan(%x), not_inf(%x)] : f32
  func.return %checked : f32
}

// ====

// Fast-math nnan+ninf is a finite contract on both operands and the result.
func.def @fastmath_finite_instruments_inputs_and_result(%x: f32, %y: f32) -> (f32) {
  %sum = scalar.addf<nnan|ninf> %x, %y : f32
  func.return %sum : f32
}

// ----
func.def @fastmath_finite_instruments_inputs_and_result(%x: f32, %y: f32) -> (f32) {
  %4, %5 = sanitizer.assert.value %x, %y [finite(%x), finite(%y)] : f32, f32
  %sum$3 = scalar.addf %4, %5 : f32
  %sum$6 = sanitizer.assert.value %sum$3 [finite(%sum$3)] : f32
  func.return %sum$6 : f32
}

// ====

// ninf without nnan maps to not_inf, not finite. Negation preserves that
// checked input fact, so the result needs no additional runtime assertion.
func.def @fastmath_ninf_instruments_not_inf(%x: f32) -> (f32) {
  %neg = scalar.negf<ninf> %x : f32
  func.return %neg : f32
}

// ----
func.def @fastmath_ninf_instruments_not_inf(%x: f32) -> (f32) {
  %3 = sanitizer.assert.value %x [not_inf(%x)] : f32
  %neg = scalar.negf %3 : f32
  func.return %neg : f32
}

// ====

// Runtime checks must not prove themselves from the promise they validate.
// Other arithmetic permissions survive the checked-promise transformation.
// RUN: pass sanitizer-insert-assertions{checks=value},sanitizer-materialize-assertions,canonicalize
kernel.def @fastmath_checked_result_survives_cleanup() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%left: f32, %right: f32) {
  %product = scalar.mulf<nnan|ninf|contract> %left, %right : f32
  test.use %product : f32
  kernel.return
}

// ----
kernel.def @fastmath_checked_result_survives_cleanup() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%left: f32, %right: f32) {
  %9 = scalar.isfinitef %left : f32
  %10 = scalar.isfinitef %right : f32
  %11 = scalar.andi %9, %10 : i1
  kernel.assert %11 : i1
  %12, %13 = scalar.assume %left, %right [finite(%left), finite(%right)] : f32, f32
  %product$3 = scalar.mulf<contract> %12, %13 : f32
  %7 = scalar.isfinitef %product$3 : f32
  kernel.assert %7 : i1
  %product$8 = scalar.assume %product$3 [finite(%product$3)] : f32
  test.use %product$8 : f32
  kernel.return
}

// ====

// Non-value check selections are precise and do not enable value assertions.
// RUN: pass sanitizer-insert-assertions{checks=access}
func.def @access_only_selection_leaves_value_ir_unchanged(%n: index) -> (index) {
  %checked = index.assume %n [range(%n, 0, 1024)] : index
  func.return %checked : index
}

// ----
func.def @access_only_selection_leaves_value_ir_unchanged(%n: index) -> (index) {
  %checked = index.assume %n [range(%n, 0, 1024)] : index
  func.return %checked : index
}

