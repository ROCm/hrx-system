  %loaded = vector.fragment.load<init> %view[%c0, %c0, %c0] shape [blocks(%blocks), %rows, %columns] : view<4x16x16xf32> -> vector<16xf32>
  sanitizer.race.fragment_access<read> %loaded, %view[%c0, %c0, %c0] shape [blocks(%blocks), %rows, %columns] {role = init} : vector<16xf32>, view<4x16x16xf32>
  sanitizer.race.fragment_access<write> %loaded, %view[%c0, %c0, %c0] shape [blocks(%blocks), %rows, %columns] {role = result} : vector<16xf32>, view<4x16x16xf32>
  vector.fragment.store<result> %loaded, %view[%c0, %c0, %c0] shape [blocks(%blocks), %rows, %columns] : vector<16xf32>, view<4x16x16xf32>
  kernel.return
}

