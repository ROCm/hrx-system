kernel.def @workgroup_atomics_are_observed() {
  %unit_extent = index.constant 1 : index
  %threads = index.constant 64 : index
  kernel.launch.config workgroups(%unit_extent, %unit_extent, %unit_extent) workgroup_size(%threads, %unit_extent, %unit_extent) : index
} launch() {
  %base = index.constant 0 : offset
  %lane = kernel.workitem.id<x> : index
  %bytes = index.constant 256 : offset
  %scratch = buffer.alloca<workgroup> align(4) %bytes : buffer
  %view = buffer.view %scratch[%base] : buffer -> view<64xi32>
  %value = scalar.constant 1 : i32
  view.atomic.reduce<addi> %value, %view[%lane] {ordering = relaxed, scope = workgroup} : i32, view<64xi32>
  %old = view.atomic.rmw<addi> %value, %view[%lane] {ordering = release, scope = workgroup} : i32, view<64xi32> -> i32
  %cmp = view.atomic.cmpxchg %old, %value, %view[%lane] {failure_ordering = acquire, scope = workgroup, success_ordering = acq_rel} : i32, view<64xi32> -> i32
  kernel.return
}

// ----
kernel.def @workgroup_atomics_are_observed() {
  %unit_extent = index.constant 1 : index
  %threads = index.constant 64 : index
  kernel.launch.config workgroups(%unit_extent, %unit_extent, %unit_extent) workgroup_size(%threads, %unit_extent, %unit_extent) : index
} launch() {
  %base = index.constant 0 : offset
  %lane = kernel.workitem.id<x> : index
  %bytes = index.constant 256 : offset
  %scratch = buffer.alloca<workgroup> align(4) %bytes : buffer
  %view = buffer.view %scratch[%base] : buffer -> view<64xi32>
  %value = scalar.constant 1 : i32
  sanitizer.race.access<read_write> %view[%lane] {atomic = true, ordering = relaxed, scope = workgroup} : view<64xi32>
  view.atomic.reduce<addi> %value, %view[%lane] {ordering = relaxed, scope = workgroup} : i32, view<64xi32>
  sanitizer.race.access<read_write> %view[%lane] {atomic = true, ordering = release, scope = workgroup} : view<64xi32>
  %old = view.atomic.rmw<addi> %value, %view[%lane] {ordering = release, scope = workgroup} : i32, view<64xi32> -> i32
  sanitizer.race.access<read_write> %view[%lane] {atomic = true, ordering = acq_rel, scope = workgroup} : view<64xi32>
  %cmp = view.atomic.cmpxchg %old, %value, %view[%lane] {failure_ordering = acquire, scope = workgroup, success_ordering = acq_rel} : i32, view<64xi32> -> i32
  kernel.return
}

