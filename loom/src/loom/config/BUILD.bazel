load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_cc_library(
    name = "application",
    srcs = ["application.c"],
    hdrs = ["application.h"],
    deps = [
        "//loom/src/loom/analysis:symbol_value_constraints",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops/config",
        "//loom/src/loom/rewrite:remap",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
    ],
)

loom_cc_library(
    name = "text_binding",
    srcs = ["text_binding.c"],
    hdrs = ["text_binding.h"],
    # Bindings borrow caller-owned text; this library owns no process state.
    tags = ["LINKABLE_MORE_THAN_ONCE"],
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:json",
    ],
)

loom_cc_library(
    name = "text",
    srcs = ["text.c"],
    hdrs = ["text.h"],
    deps = [
        ":application",
        ":text_binding",
        "//loom/src/loom/format/text:parser",
        "//loom/src/loom/format/text:printer",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops/config",
        "//loom/src/loom/ops/encoding",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
    ],
)

loom_cc_test(
    name = "text_binding_test",
    srcs = ["text_binding_test.cc"],
    deps = [
        ":text_binding",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "schema",
    srcs = ["schema.c"],
    hdrs = ["schema.h"],
    deps = [
        ":application",
        "//loom/src/loom/format/text:printer",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops/config",
        "//loom/src/loom/util:json",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/base",
    ],
)
