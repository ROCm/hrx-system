load("//build_tools/bazel:query.bzl", "iree_assert_dependency_boundary")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_cc_library(
    name = "application",
    srcs = ["application.c"],
    hdrs = ["application.h"],
    deps = [
        "//loom/src/loom/analysis:symbol_value_constraints",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops/config",
        "//loom/src/loom/rewrite:remap",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
    ],
)

iree_assert_dependency_boundary(
    name = "application_has_no_text_or_tooling_dependencies",
    forbidden_subtrees = [
        "//loom/binding/...",
        "//loom/src/loom/format/...",
        "//loom/src/loom/tooling/...",
        "//loom/src/loom/tools/...",
    ],
    message = "Typed configuration application is representation-independent compiler state",
    target = ":application",
)

loom_cc_library(
    name = "text_binding",
    srcs = ["text_binding.c"],
    hdrs = ["text_binding.h"],
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:json",
    ],
)

iree_assert_dependency_boundary(
    name = "text_binding_has_no_ir_or_tooling_dependencies",
    forbidden_subtrees = [
        "//loom/binding/...",
        "//loom/src/loom/format/...",
        "//loom/src/loom/ir/...",
        "//loom/src/loom/ops/...",
        "//loom/src/loom/tooling/...",
        "//loom/src/loom/tools/...",
    ],
    message = "Textual config binding storage is independent of IR and tooling",
    target = ":text_binding",
)

loom_cc_library(
    name = "text",
    srcs = ["text.c"],
    hdrs = ["text.h"],
    deps = [
        ":application",
        ":text_binding",
        "//loom/src/loom/format/text:parser",
        "//loom/src/loom/format/text:printer",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops/config",
        "//loom/src/loom/ops/encoding",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
    ],
)

iree_assert_dependency_boundary(
    name = "text_has_no_tooling_or_binding_dependencies",
    forbidden_subtrees = [
        "//loom/binding/...",
        "//loom/src/loom/tooling/...",
        "//loom/src/loom/tools/...",
    ],
    message = "Textual configuration materialization is compiler-owned and must not depend on public bindings or tooling adapters",
    target = ":text",
)

loom_cc_test(
    name = "text_binding_test",
    srcs = ["text_binding_test.cc"],
    deps = [
        ":text_binding",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "schema",
    srcs = ["schema.c"],
    hdrs = ["schema.h"],
    deps = [
        ":application",
        "//loom/src/loom/format/text:printer",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops/config",
        "//loom/src/loom/util:json",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/base",
    ],
)

iree_assert_dependency_boundary(
    name = "schema_has_no_tooling_or_binding_dependencies",
    forbidden_subtrees = [
        "//loom/binding/...",
        "//loom/src/loom/tooling/...",
        "//loom/src/loom/tools/...",
    ],
    message = "Configuration schema reporting is compiler-owned and independent of command-line input handling",
    target = ":schema",
)
