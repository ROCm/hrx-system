func.def public pure @transitive(%value: i32) -> (i32) {
  %factor = scalar.constant 2 : i32
  %result = scalar.muli %value, %factor : i32
  func.return %result : i32
}

func.def public pure @transitive_unused(%value: i32) -> (i32) {
  func.return %value : i32
}

func.def @direct_helper(%value: i32) -> (i32) {
  func.return %value : i32
}
