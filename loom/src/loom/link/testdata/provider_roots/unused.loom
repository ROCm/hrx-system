func.decl pure @transitive(%value: i32) -> (i32)

func.def public pure @unused_export(%value: i32) -> (i32) {
  func.return %value : i32
}

func.def @direct_helper(%value: i32) -> (i32) {
  %doubled = func.call @transitive(%value) : (i32) -> (i32)
  %bias = scalar.constant 1 : i32
  %result = scalar.addi %doubled, %bias : i32
  func.return %result : i32
}

check.case @alternate_case {
  %input = check.literal value(21) : i32
  %expected = check.literal value(43) : i32
  %actual = func.call @direct_helper(%input) : (i32) -> (i32)
  check.expect.equal actual(%actual) expected(%expected) : i32
  check.return
}

check.case @alternate_export_case {
  %input = check.literal value(5) : i32
  %actual = func.call @unused_export(%input) : (i32) -> (i32)
  check.expect.equal actual(%actual) expected(%input) : i32
  check.return
}
