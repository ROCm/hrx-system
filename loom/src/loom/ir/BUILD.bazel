load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_benchmark", "loom_cc_library", "loom_cc_library_group", "loom_cc_test")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

# Complete IR API, including construction, structural queries, and value facts.
loom_cc_library_group(
    name = "ir",
    deps = [
        ":builders",
        ":facts",
    ],
)

# Construction uses caller-owned module/context state, without fact propagation
# or compiler pipelines. The group re-exports the component headers.
loom_cc_library_group(
    name = "builders",
    deps = [
        ":storage",
        ":symbol_map",
        ":types",
    ],
)

# Value/type vocabulary and graph representation are also available without
# storage, interning, replacement, or other out-of-line IR operations.
_TYPE_HEADERS = [
    "attribute.h",
    "memory_space.h",
    "scalar_type.h",
    "structural_hash.h",
    "type_constraint.h",
    "types.h",
]

loom_cc_library(
    name = "type_headers",
    hdrs = _TYPE_HEADERS,
    deps = ["//runtime/src/iree/base"],
)

_REPRESENTATION_HEADERS = [
    "attribute_schema.h",
    "encoding.h",
    "intern_table.h",
    "ir.h",
    "location.h",
    "parameterized_attr.h",
    "parameterized_type.h",
    "semantics.h",
    "string_table.h",
    "type_descriptor.h",
    "type_table.h",
]

loom_cc_library(
    name = "headers",
    hdrs = _REPRESENTATION_HEADERS,
    deps = [
        ":type_headers",
        "//loom/src/loom/error:emitter",
        "//loom/src/loom/util:bstring",
        "//loom/src/loom/util:segmented_storage_headers",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
    ],
)

loom_cc_library(
    name = "facts",
    srcs = [
        "facts.c",
        "facts_bitwise.c",
        "facts_division.c",
        "float_facts.c",
