load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_library",
    "loom_cc_test",
)

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_cc_library(
    name = "artifact",
    hdrs = ["artifact.h"],
    deps = ["//runtime/src/iree/base"],
)

loom_cc_library(
    name = "product",
    srcs = ["product.c"],
    hdrs = ["product.h"],
    deps = [
        ":artifact",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal",
    ],
)

loom_cc_library(
    name = "registry",
    srcs = ["registry.c"],
    hdrs = ["registry.h"],
    deps = [
        ":product",
        "//loom/src/loom/target:pipeline_options",
        "//loom/src/loom/target:product_contract",
        "//loom/src/loom/target:profile",
        "//runtime/src/iree/base",
    ],
)

loom_cc_test(
    name = "product_test",
    srcs = ["product_test.cc"],
    deps = [
        ":product",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_test(
    name = "registry_test",
    srcs = ["registry_test.cc"],
    deps = [
        ":registry",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
