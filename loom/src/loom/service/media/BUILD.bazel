load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "iree_select",
    "loom_cc_fuzz",
    "loom_cc_library",
    "loom_cc_test",
    "loom_config_compatible_with",
)
load("//loom/build_tools/bazel:python.bzl", "loom_py_test")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

IMAGE_FUZZ_SEEDS = [
    "//loom/src/loom/service/media/testdata/image_fuzz:gif.txt",
    "//loom/src/loom/service/media/testdata/image_fuzz:jpeg.txt",
    "//loom/src/loom/service/media/testdata/image_fuzz:pam_rgb.txt",
    "//loom/src/loom/service/media/testdata/image_fuzz:pam_rgba.txt",
    "//loom/src/loom/service/media/testdata/image_fuzz:pam_truncated.txt",
    "//loom/src/loom/service/media/testdata/image_fuzz:png.txt",
    "//loom/src/loom/service/media/testdata/image_fuzz:webp.txt",
]

loom_cc_library(
    name = "digest",
    hdrs = ["digest.h"],
    visibility = ["//visibility:public"],
    deps = ["//loom/src/loom/util:digest"],
)

loom_cc_library(
    name = "image_types",
    hdrs = ["image_types.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":digest",
        "//runtime/src/iree/base",
        "//runtime/src/iree/codec/image",
    ],
)

loom_cc_library(
    name = "image_codecs",
    srcs = ["image_codecs.c"],
    hdrs = ["image_codecs.h"],
    defines = iree_select({
        "//loom/config/media:image_input_enabled": ["LOOM_MEDIA_IMAGE_INPUT=1"],
        "//conditions:default": ["LOOM_MEDIA_IMAGE_INPUT=0"],
    }) + iree_select({
        "//loom/config/media:png": ["LOOM_MEDIA_IMAGE_CODEC_PNG=1"],
        "//conditions:default": ["LOOM_MEDIA_IMAGE_CODEC_PNG=0"],
    }) + iree_select({
        "//loom/config/media:jpeg": ["LOOM_MEDIA_IMAGE_CODEC_JPEG=1"],
        "//conditions:default": ["LOOM_MEDIA_IMAGE_CODEC_JPEG=0"],
    }) + iree_select({
        "//loom/config/media:gif": ["LOOM_MEDIA_IMAGE_CODEC_GIF=1"],
        "//conditions:default": ["LOOM_MEDIA_IMAGE_CODEC_GIF=0"],
    }) + iree_select({
        "//loom/config/media:webp": ["LOOM_MEDIA_IMAGE_CODEC_WEBP=1"],
        "//conditions:default": ["LOOM_MEDIA_IMAGE_CODEC_WEBP=0"],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/codec/image:codec",
    ] + iree_select({
        "//loom/config/media:image_input_enabled": ["//runtime/src/iree/codec/image:pam"],
        "//conditions:default": [],
    }) + iree_select({
        "//loom/config/media:png": ["//runtime/src/iree/codec/image:png"],
        "//conditions:default": [],
    }) + iree_select({
        "//loom/config/media:jpeg": ["//runtime/src/iree/codec/image:jpeg"],
        "//conditions:default": [],
    }) + iree_select({
        "//loom/config/media:gif": ["//runtime/src/iree/codec/image:gif"],
        "//conditions:default": [],
    }) + iree_select({
        "//loom/config/media:webp": ["//runtime/src/iree/codec/image:webp"],
        "//conditions:default": [],
    }),
)

loom_cc_library(
    name = "image",
    srcs = ["image.c"],
    hdrs = ["image.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":digest",
        ":image_codecs",
        ":image_types",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:base64",
        "//runtime/src/iree/base/internal:json",
        "//runtime/src/iree/codec/image:codec",
    ],
)

loom_cc_test(
    name = "image_test",
    srcs = ["image_test.cc"],
    deps = [
        ":image",
        ":image_codecs",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:base64",
        "//runtime/src/iree/codec/image:codec",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "image_request",
    srcs = ["image_request.c"],
    hdrs = ["image_request.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":image",
        "//runtime/src/iree/base",
        "//runtime/src/iree/vm",
    ],
)

loom_cc_test(
    name = "image_pam_test",
    srcs = ["image_pam_test.cc"],
    target_compatible_with = loom_config_compatible_with(["//loom/config/media:image_input_enabled"]),
    deps = [
        ":image",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:base64",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_test(
    name = "image_request_test",
    srcs = ["image_request_test.cc"],
    deps = [
        ":image",
        ":image_request",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
        "//runtime/src/iree/vm",
        "//runtime/src/iree/vm:test_support",
    ],
)

loom_cc_fuzz(
    name = "image_fuzz",
    srcs = ["image_fuzz.cc"],
    args = [
        "-seed_inputs=" + ",".join([
            "$(rootpath %s)" % seed
            for seed in IMAGE_FUZZ_SEEDS
        ]),
    ],
    data = IMAGE_FUZZ_SEEDS,
    deps = [
        ":image",
        ":image_codecs",
        ":image_request",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:base64",
        "//runtime/src/iree/codec/image:codec",
        "//runtime/src/iree/vm",
    ],
)

loom_py_test(
    name = "image_fuzz_test",
    srcs = ["image_fuzz_test.py"],
    args = ["$(rootpath :image_fuzz)"] + [
        "$(rootpath %s)" % seed
        for seed in IMAGE_FUZZ_SEEDS
    ],
    data = [":image_fuzz"] + IMAGE_FUZZ_SEEDS,
    tags = [
        "manual",
        "skip-bazel_to_cmake",
    ],
)
