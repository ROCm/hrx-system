load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

loom_cc_library(
    name = "schedule",
    hdrs = ["schedule.h"],
    visibility = ["//visibility:public"],
)

loom_cc_library(
    name = "statistics",
    srcs = ["statistics.c"],
    hdrs = ["statistics.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//loom/src/loom/runtime/parameter:activity",
        "//loom/src/loom/runtime/storage:statistics",
        "//loom/src/loom/runtime/telemetry:sample",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "telemetry",
    srcs = ["telemetry.c"],
    hdrs = ["telemetry.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":schedule",
        "//loom/src/loom/runtime/storage:statistics",
        "//loom/src/loom/runtime/telemetry:field",
        "//loom/src/loom/runtime/telemetry:stream",
        "//loom/src/loom/service/telemetry:record",
        "//runtime/src/iree/base",
    ],
)

loom_cc_test(
    name = "telemetry_test",
    srcs = ["telemetry_test.cc"],
    deps = [
        ":schedule",
        ":telemetry",
        "//loom/src/loom/runtime/telemetry:stream",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
