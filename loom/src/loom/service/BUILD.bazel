    srcs = ["executables.c"],
    hdrs = ["executables.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//loom/binding/c:loomc",
        "//loom/binding/c:task_pool",
        "//loom/src/loom/runtime/device",
        "//loom/src/loom/runtime/host",
        "//loom/src/loom/runtime/parameter:bank",
        "//loom/src/loom/runtime/parameter:module",
        "//loom/src/loom/runtime/parameter:residency",
        "//loom/src/loom/runtime/parameter:sources",
        "//loom/src/loom/runtime/parameter:weights",
        "//loom/src/loom/runtime/program:compilation",
        "//loom/src/loom/runtime/program:jit",
        "//loom/src/loom/runtime/program:module",
        "//loom/src/loom/runtime/program:parameter_layout",
        "//loom/src/loom/runtime/program:preparation",
        "//loom/src/loom/runtime/program:sources",
        "//loom/src/loom/runtime/program:stage_set",
        "//loom/src/loom/runtime/program:stage_table",
