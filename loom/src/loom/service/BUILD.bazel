        "//loom/src/loom/service:prepared_request",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
        "//runtime/src/iree/vm",
    ],
)

loom_cc_library(
    name = "execution_reconfiguration",
    srcs = ["execution_reconfiguration.c"],
    hdrs = ["execution_reconfiguration.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//loom/src/loom/runtime:wake",
        "//loom/src/loom/runtime/program:compilation",
        "//loom/src/loom/runtime/program:sources",
        "//loom/src/loom/runtime/program:variant_pool",
        "//loom/src/loom/service:reconfiguration",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
