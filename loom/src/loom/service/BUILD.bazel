load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

loom_cc_library(
    name = "inspection",
    hdrs = ["inspection.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//loom/src/loom/service/telemetry:record",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "kind",
    srcs = ["kind.c"],
    hdrs = ["kind.h"],
    visibility = ["//visibility:public"],
    deps = ["//runtime/src/iree/base"],
)

loom_cc_test(
    name = "kind_test",
    srcs = ["kind_test.cc"],
    deps = [
        "//loom/src/loom/service:kind",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "prepared_request",
    srcs = ["prepared_request.c"],
    hdrs = ["prepared_request.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/vm",
    ],
)

loom_cc_library(
    name = "reconfiguration",
    hdrs = ["reconfiguration.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//loom/src/loom/runtime/program:sources",
        "//loom/src/loom/runtime/program:variant_pool",
        "//runtime/src/iree/base",
    ],
)

loom_cc_test(
    name = "prepared_request_test",
