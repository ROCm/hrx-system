load("//build_tools/bazel:query.bzl", "iree_assert_dependency_boundary")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

loom_cc_library(
    name = "protocol",
    srcs = ["protocol.c"],
    hdrs = ["protocol.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//loom/src/loom/service/finite:protocol",
        "//loom/src/loom/util:json",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:json",
        "//runtime/src/iree/base/internal:unicode",
        "//runtime/src/iree/vm",
    ],
)

loom_cc_library(
    name = "native_service_tests",
    testonly = True,
    srcs = ["native_service_test.cc"],
    visibility = ["//visibility:public"],
    deps = [
        "//loom/src/loom/runtime:driver",
        "//loom/src/loom/runtime:service",
        "//loom/src/loom/runtime:wake",
        "//loom/src/loom/runtime/device",
        "//loom/src/loom/runtime/execution",
        "//loom/src/loom/runtime/host",
        "//loom/src/loom/runtime/program:sources",
        "//loom/src/loom/runtime/testing:application",
        "//loom/src/loom/service/finite:call",
        "//loom/src/loom/service/finite:model",
        "//loom/src/loom/service/finite:registration",
        "//loom/src/loom/service/finite:result",
        "//loom/src/loom/service/finite:service",
        "//loom/src/loom/service/finite/decision:protocol",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:json",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/task:owner",
        "//runtime/src/iree/testing:gtest",
    ],
    alwayslink = True,
)

iree_assert_dependency_boundary(
    name = "native_execution_is_independent_of_serving",
    forbidden_subtrees = ["//loom/src/loom/serve/..."],
    message = "Native decision execution, including its model loading and test fixtures, must not depend on serving",
    target = "//loom/src/loom/service/finite/decision:native_service_tests",
)

loom_cc_test(
    name = "protocol_test",
    srcs = ["protocol_test.cc"],
    deps = [
        "//loom/src/loom/service/finite:protocol",
        "//loom/src/loom/service/finite/decision:protocol",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
        "//runtime/src/iree/vm",
    ],
)
