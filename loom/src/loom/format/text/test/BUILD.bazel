load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_test")
load("//loom/build_tools/bazel:loom_check.bzl", "loom_check_test_suite")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

exports_files(
    ["predicate_attributes.loom-test"],
    visibility = ["//loom/py/loom/format/bytecode:__pkg__"],
)

loom_check_test_suite(
    name = "test",
    srcs = [
        "error_recovery.loom-test",
        "instance_flags.loom-test",
        "operand_dictionaries.loom-test",
        "predicate_attributes.loom-test",
        "signature_binders.loom-test",
        "ssa_names.loom-test",
        "symbol_references.loom-test",
        "type_attributes.loom-test",
        "type_scratch.loom-test",
        "view_alignment.loom-test",
    ],
)

