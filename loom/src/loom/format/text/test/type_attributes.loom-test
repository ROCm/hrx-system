// RUN: roundtrip

// Generic dictionaries distinguish type expressions from quoted strings and
// preserve the ordinary literal forms.
test.decl @static_types(%values: test.array<i32, metadata = {element = f32, handle = buffer, nested = {callback = (i32) -> (f32), reference = test.ref<i32>}, spelling = "f32", enabled = true, mode = fast, bytes = bytes("0123")}>)

// ----
test.decl @static_types(%values: test.array<i32, metadata = {bytes = bytes("0123"), element = f32, enabled = true, handle = buffer, mode = "fast", nested = {callback = (i32) -> (f32), reference = test.ref<i32>}, spelling = "f32"}>)

// ====
// RUN: roundtrip

// Nested TYPE leaves inherit argument-mode forward binders independently of
// the enclosing type's element binding.
test.decl @dependent_types(%values: test.array<vector<[%width]xf32>, metadata = {callback = (vector<[%height]xf32>) -> (view<[%width]xf32, %layout>), nested = {shape = vector<[%height]xf32>}}>, %width: index, %height: index, %layout: encoding<layout>)

// ====
// RUN: roundtrip

// Body dictionaries resolve the same complete types in the existing SSA scope.
func.def @body_types(%width: index, %input: f32) -> (f32) {
  %configured = test.attrs %input {metadata = {element = test.array<vector<[%width]xf32>>, shape = vector<[%width]xf32>}} : f32
  func.return %configured : f32
}

// ====
// RUN: roundtrip

// Wide ABI and library metadata dictionaries retain all fields through inline
// storage growth, including nested dictionaries with independent storage.
test.decl @wide_metadata(%values: test.array<i32, metadata = {field32 = 32, field31 = 31, field30 = 30, field29 = 29, field28 = 28, field27 = 27, field26 = 26, field25 = 25, field24 = 24, field23 = 23, field22 = 22, field21 = 21, field20 = 20, field19 = 19, field18 = 18, field17 = 17, field16 = 16, field15 = 15, field14 = 14, field13 = 13, field12 = 12, field11 = 11, field10 = 10, field09 = 9, field08 = 8, field07 = 7, field06 = 6, field05 = 5, field04 = 4, field03 = 3, field02 = 2, field01 = 1, field00 = 0, nested = {field32 = 32, field31 = 31, field30 = 30, field29 = 29, field28 = 28, field27 = 27, field26 = 26, field25 = 25, field24 = 24, field23 = 23, field22 = 22, field21 = 21, field20 = 20, field19 = 19, field18 = 18, field17 = 17, field16 = 16, field15 = 15, field14 = 14, field13 = 13, field12 = 12, field11 = 11, field10 = 10, field09 = 9, field08 = 8, field07 = 7, field06 = 6, field05 = 5, field04 = 4, field03 = 3, field02 = 2, field01 = 1, field00 = 0}}>)

// ----
test.decl @wide_metadata(%values: test.array<i32, metadata = {field00 = 0, field01 = 1, field02 = 2, field03 = 3, field04 = 4, field05 = 5, field06 = 6, field07 = 7, field08 = 8, field09 = 9, field10 = 10, field11 = 11, field12 = 12, field13 = 13, field14 = 14, field15 = 15, field16 = 16, field17 = 17, field18 = 18, field19 = 19, field20 = 20, field21 = 21, field22 = 22, field23 = 23, field24 = 24, field25 = 25, field26 = 26, field27 = 27, field28 = 28, field29 = 29, field30 = 30, field31 = 31, field32 = 32, nested = {field00 = 0, field01 = 1, field02 = 2, field03 = 3, field04 = 4, field05 = 5, field06 = 6, field07 = 7, field08 = 8, field09 = 9, field10 = 10, field11 = 11, field12 = 12, field13 = 13, field14 = 14, field15 = 15, field16 = 16, field17 = 17, field18 = 18, field19 = 19, field20 = 20, field21 = 21, field22 = 22, field23 = 23, field24 = 24, field25 = 25, field26 = 26, field27 = 27, field28 = 28, field29 = 29, field30 = 30, field31 = 31, field32 = 32}}>)
