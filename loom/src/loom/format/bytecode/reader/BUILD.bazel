load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_cc_library(
    name = "module_view",
    hdrs = ["module_view.h"],
    visibility = ["//loom/src/loom/format/bytecode:__pkg__"],
    deps = [
        ":source_trivia",
        "//loom/src/loom/format/bytecode:format",
        "//loom/src/loom/format/bytecode:module_summary",
        "//loom/src/loom/ir",
        "//loom/src/loom/ir:symbol_map",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/ops:type_registry",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "source_trivia",
    srcs = ["source_trivia.c"],
    hdrs = ["source_trivia.h"],
    visibility = ["//loom/src/loom/format/bytecode:__pkg__"],
    deps = [
        ":decoder",
        "//loom/src/loom/format/bytecode:format",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/base/internal:unicode",
    ],
)

loom_cc_test(
    name = "source_trivia_test",
    srcs = ["source_trivia_test.cc"],
    deps = [
        ":source_trivia",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "decoder",
    srcs = ["decoder.c"],
    hdrs = ["decoder.h"],
    visibility = ["//loom/src/loom/format/bytecode:__pkg__"],
    deps = [
        "//loom/src/loom/error:error_defs",
        "//loom/src/loom/format/bytecode:diagnostic",
        "//loom/src/loom/format/bytecode:varint",
        "//runtime/src/iree/base",
    ],
)

loom_cc_test(
    name = "decoder_test",
    srcs = ["decoder_test.cc"],
    deps = [
        ":decoder",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
