load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_benchmark", "loom_cc_library", "loom_cc_test")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_cc_library(
    name = "predicate",
    srcs = ["predicate.c"],
    hdrs = ["predicate.h"],
    deps = [
        "//loom/src/loom/ir:facts",
        "//runtime/src/iree/base",
    ],
)

loom_cc_test(
    name = "predicate_test",
    srcs = ["predicate_test.cc"],
    deps = [
        ":predicate",
        "//loom/src/loom/ir:facts",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_benchmark(
    name = "predicate_benchmark",
    srcs = ["predicate_benchmark.cc"],
    deps = [
        ":predicate",
        "//loom/src/loom/ir:facts",
        "//runtime/src/iree/testing:benchmark_main",
    ],
)
