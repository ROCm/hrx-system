load("//build_tools/bazel:query.bzl", "iree_assert_dependency_boundary")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test", "loom_generated_cc_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_cc_library(
    name = "emitter",
    hdrs = ["emitter.h"],
    deps = [
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "diagnostic",
    srcs = ["diagnostic.c"],
    hdrs = ["diagnostic.h"],
    deps = [
        ":emitter",
        ":parameter",
        ":renderer",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/base",
    ],
)

loom_cc_test(
    name = "diagnostic_test",
    srcs = ["diagnostic_test.cc"],
    deps = [
        ":diagnostic",
        ":parameter",
        ":renderer",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "source",
    srcs = ["source.c"],
    hdrs = ["source.h"],
    deps = [
        ":diagnostic",
        "//loom/src/loom/ir",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/base/internal:unicode",
    ],
)

loom_cc_test(
    name = "source_test",
    srcs = ["source_test.cc"],
    deps = [
        ":parameter",
        ":source",
        "//loom/src/loom/ir",
        "//loom/src/loom/link:linker",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_generated_cc_library(
    name = "error_defs",
    srcs = ["error_defs.c"],
    hdrs = [
        "error_defs.h",
    ],
    args = [
        "--catalog-symbol=loom_error_catalog_core",
        "--public-header=loom/error/error_catalog.h",
        "--shard=core",
    ],
    extra_output_flags = [
        "--catalog",
    ],
    extra_outputs = [
        "error_catalog.json",
    ],
    generated_hdr_flags = [
        "--header",
        "--runtime-tables",
    ],
    generated_hdrs = [
        "error_catalog.h",
        "error_defs_tables.inl",
    ],
    generator = "//loom/py/loom/gen/error:c_errors",
    source = "error_catalog.c",
    deps = [
        "//runtime/src/iree/base",
    ],
)

# Optional x86 diagnostics remain separate from the shared core catalog.
loom_generated_cc_library(
    name = "x86_error_defs",
    args = [
        "--catalog-symbol=loom_x86_error_catalog",
        "--fallback-catalog-symbol=loom_error_catalog_core",
        "--fallback-public-header=loom/error/error_catalog.h",
        "--public-header=loom/error/x86_error_catalog.h",
        "--shard=x86",
    ],
    generated_hdr_flags = ["--header"],
    generated_hdrs = ["x86_error_catalog.h"],
    generator = "//loom/py/loom/gen/error:c_errors",
    source = "x86_error_catalog.c",
    deps = [":error_defs"],
)

loom_cc_test(
    name = "error_defs_test",
    srcs = ["error_defs_test.cc"],
    deps = [
        ":error_defs",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "json_sink",
    srcs = ["json_sink.c"],
    hdrs = ["json_sink.h"],
    deps = [
        ":diagnostic",
        ":error_defs",
        ":renderer",
        "//loom/src/loom/util:json",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/base",
    ],
)

loom_cc_test(
    name = "json_sink_test",
    srcs = ["json_sink_test.cc"],
    deps = [
        ":json_sink",
        ":parameter",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "renderer",
    srcs = ["renderer.c"],
    hdrs = ["renderer.h"],
    deps = [
        ":parameter",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/base",
    ],
)

loom_cc_test(
    name = "renderer_test",
    srcs = ["renderer_test.cc"],
    deps = [
        ":error_defs",
        ":renderer",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "parameter",
    hdrs = ["parameter.h"],
    deps = [
        ":emitter",
        ":error_defs",
        "//loom/src/loom/ir",
        "//runtime/src/iree/base",
    ],
)

iree_assert_dependency_boundary(
    name = "error_defs_has_no_compiler_dependencies",
    forbidden_subtrees = [
        "//loom/src/loom/codegen/...",
        "//loom/src/loom/format/...",
        "//loom/src/loom/ir/...",
        "//loom/src/loom/ops/...",
        "//loom/src/loom/target/...",
    ],
    message = "Error catalogs describe immutable diagnostic metadata independently of compiler IR and runtime parameter values",
    target = ":error_defs",
)
