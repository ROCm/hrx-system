// RUN: pass specialize-target-callgraph,decompose-view-boundaries,dce,decompose-view-root-selections,dce,scf-to-cfg,cfg-simplify,canonicalize,cse,branch-sink

test.target<low_core> @carrier_target

func.def noinline target(@carrier_target) @identity(%input: view<1xi32>) -> (view<1xi32>) {
  func.return %input : view<1xi32>
}

func.def public target(@carrier_target) @caller(%storage: buffer, %offset: offset) -> (view<1xi32>) {
  %input = buffer.view %storage[%offset] : buffer -> view<1xi32>
  %result = test.invoke @identity(%input) : (view<1xi32>) -> (view<1xi32>)
  func.return %result : view<1xi32>
}

