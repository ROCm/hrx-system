// ====

// RUN: pass specialize-target-callgraph,decompose-view-boundaries,dce

// Related crops share the selected coordinate; the projection comes from the
// retained view region even when several subviews separate it from the return.
test.target<low_core> @carrier_target

func.def public target(@carrier_target) @choose_crops(%left: view<8xi32>, %right: view<8xi32>, %condition: i1, %position: index) -> (view<1xi32>, view<1xi32>, view<1xi32>) {
  %selected = scf.select %condition, %left, %right : view<8xi32>
  %first = view.subview %selected[0] : view<8xi32> -> view<1xi32>
  %suffix = view.subview %selected[1] : view<8xi32> -> view<7xi32>
  %middle = view.subview %suffix[%position] : view<7xi32> -> view<1xi32>
  %last = view.subview %selected[6] : view<8xi32> -> view<1xi32>
  func.return %first, %middle, %last : view<1xi32>, view<1xi32>, view<1xi32>
}

// ----
test.target<low_core> @carrier_target

func.def public target(@carrier_target) @choose_crops(%left_root: buffer, %left_offset: offset, %right_root: buffer, %right_offset: offset, %condition: i1, %position: index) -> (buffer, offset, buffer, offset, buffer, offset) {
  %selected_root, %selected_offset = scf.if %condition -> (buffer, offset) {
    scf.yield %left_root, %left_offset : buffer, offset
  } else {
    scf.yield %right_root, %right_offset : buffer, offset
  }
  %20 = index.constant 4 : offset
  %21 = index.add %selected_offset, %20 : offset
  %22 = index.constant 4 : offset
  %23 = index.scale %position, %22 : index, offset -> offset
  %24 = index.add %21, %23 : offset
  %25 = index.constant 24 : offset
  %26 = index.add %selected_offset, %25 : offset
  func.return %selected_root, %selected_offset, %selected_root, %24, %selected_root, %26 : buffer, offset, buffer, offset, buffer, offset
}

