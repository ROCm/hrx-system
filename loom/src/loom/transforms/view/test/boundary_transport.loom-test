// RUN: pass specialize-target-callgraph,decompose-view-boundaries

test.target<low_core> @carrier_target

func.def public target(@carrier_target) @rotate(%first: buffer, %second: buffer, %first_offset: offset, %second_offset: offset, %count: index) -> (view<1xi32>) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %first_view = buffer.view %first[%first_offset] : buffer -> view<1xi32>
  %second_view = buffer.view %second[%second_offset] : buffer -> view<1xi32>
  cfg.br ^header(%begin: index, %first_view: view<1xi32>, %second_view: view<1xi32>)
^header(%iteration: index, %left: view<1xi32>, %right: view<1xi32>):
  %continue = index.cmp slt, %iteration, %count : index
  cfg.cond_br %continue, ^body, ^exit
^body:
  %next = index.add %iteration, %step : index
  cfg.br ^header(%next: index, %right: view<1xi32>, %left: view<1xi32>)
^exit:
  func.return %left : view<1xi32>
}

// ----
test.target<low_core> @carrier_target

func.def public target(@carrier_target) @rotate(%first: buffer, %second: buffer, %first_offset: offset, %second_offset: offset, %count: index) -> (buffer, offset) {
  cfg.br ^_bb1(%first: buffer, %second: buffer, %first_offset: offset, %second_offset: offset, %count: index)
^_bb1(%0: buffer, %1: buffer, %2: offset, %3: offset, %4: index):
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %first_view = buffer.view %0[%2] : buffer -> view<1xi32>
  %second_view = buffer.view %1[%3] : buffer -> view<1xi32>
  cfg.br ^_bb2(%begin: index, %0: buffer, %2: offset, %1: buffer, %3: offset)
^_bb2(%iteration: index, %left_root: buffer, %left_offset: offset, %right_root: buffer, %right_offset: offset):
  %left = buffer.view %left_root[%left_offset] : buffer -> view<1xi32>
  %right = buffer.view %right_root[%right_offset] : buffer -> view<1xi32>
  %continue = index.cmp slt, %iteration, %4 : index
  cfg.cond_br %continue, ^_bb3, ^_bb4
^_bb3:
  %next = index.add %iteration, %step : index
  cfg.br ^_bb2(%next: index, %right_root: buffer, %right_offset: offset, %left_root: buffer, %left_offset: offset)
^_bb4:
  func.return %left_root, %left_offset : buffer, offset
}

