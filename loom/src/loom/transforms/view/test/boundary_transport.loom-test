// RUN: pass specialize-target-callgraph,decompose-view-boundaries

test.target<low_core> @carrier_target

func.def public target(@carrier_target) @choose_nested(%left: view<1xi32>, %middle: view<1xi32>, %right: view<1xi32>, %choose_middle: i1, %choose_right: i1) -> (view<1xi32>) {
  %left_or_middle = scf.select %choose_middle, %middle, %left : view<1xi32>
  %selected = scf.select %choose_right, %right, %left_or_middle : view<1xi32>
  func.return %selected : view<1xi32>
}

// ----
test.target<low_core> @carrier_target

func.def public target(@carrier_target) @choose_nested(%left_root: buffer, %left_offset: offset, %middle_root: buffer, %middle_offset: offset, %right_root: buffer, %right_offset: offset, %choose_middle: i1, %choose_right: i1) -> (buffer, offset) {
  cfg.br ^_bb1(%left_root: buffer, %left_offset: offset, %middle_root: buffer, %middle_offset: offset, %right_root: buffer, %right_offset: offset, %choose_middle: i1, %choose_right: i1)
^_bb1(%8: buffer, %0: offset, %10: buffer, %1: offset, %12: buffer, %2: offset, %3: i1, %4: i1):
  %left = buffer.view %8[%0] : buffer -> view<1xi32>
  %middle = buffer.view %10[%1] : buffer -> view<1xi32>
  %right = buffer.view %12[%2] : buffer -> view<1xi32>
  %left_or_middle_root, %left_or_middle_offset = scf.if %3 -> (buffer, offset) {
    scf.yield %10, %1 : buffer, offset
  } else {
    scf.yield %8, %0 : buffer, offset
  }
  %left_or_middle = scf.select %3, %middle, %left : view<1xi32>
  %selected_root, %selected_offset = scf.if %4 -> (buffer, offset) {
    scf.yield %12, %2 : buffer, offset
  } else {
    scf.yield %left_or_middle_root, %left_or_middle_offset : buffer, offset
  }
  %selected = scf.select %4, %right, %left_or_middle : view<1xi32>
  func.return %selected_root, %selected_offset : buffer, offset
}

