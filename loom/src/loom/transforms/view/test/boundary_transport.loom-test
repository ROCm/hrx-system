// RUN: pass specialize-target-callgraph,decompose-view-boundaries

test.target<low_core> @carrier_target

func.def noinline target(@carrier_target) @forward_window(%input: view<1xi32>) -> (view<1xi32>) {
  func.return %input : view<1xi32>
}

func.def public target(@carrier_target) @call_window(%storage: buffer, %base: offset, %position: index) -> (view<1xi32>) {
  %whole = buffer.view %storage[%base] : buffer -> view<8xi32>
  %window = view.subview %whole[%position] : view<8xi32> -> view<1xi32>
  %result = func.call @forward_window(%window) : (view<1xi32>) -> (view<1xi32>)
  func.return %result : view<1xi32>
}

// ----
test.target<low_core> @carrier_target

func.def noinline target(@carrier_target) @forward_window(%input_root: buffer, %input_offset: offset) -> (buffer, offset) {
  %input = buffer.view %input_root[%input_offset] : buffer -> view<1xi32>
  func.return %input_root, %input_offset : buffer, offset
}

func.def public target(@carrier_target) @call_window(%storage: buffer, %base: offset, %position: index) -> (buffer, offset) {
  %whole = buffer.view %storage[%base] : buffer -> view<8xi32>
  %window = view.subview %whole[%position] : view<8xi32> -> view<1xi32>
  %14 = index.constant 4 : offset
  %15 = index.scale %position, %14 : index, offset -> offset
  %16 = index.add %base, %15 : offset
  %result_root, %result_offset = func.call @forward_window(%storage, %16) : (buffer, offset) -> (buffer, offset)
  %result = buffer.view %result_root[%result_offset] : buffer -> view<1xi32>
  func.return %result_root, %result_offset : buffer, offset
}

