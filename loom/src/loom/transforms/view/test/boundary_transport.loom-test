test.target<low_core> @carrier_target

func.def noinline target(@carrier_target) @shuffle(%tag: i32, %left: view<1xi32>, %middle: i64, %right: view<1xi32>) -> (view<1xi32>, i32, view<1xi32>, i64) {
  func.return %right, %tag, %left, %middle : view<1xi32>, i32, view<1xi32>, i64
}

func.def public target(@carrier_target) @call_shuffle(%left_storage: buffer, %left_offset: offset, %right_storage: buffer, %right_offset: offset, %tag: i32, %middle: i64) -> (view<1xi32>, i32, view<1xi32>, i64) {
  %left = buffer.view %left_storage[%left_offset] : buffer -> view<1xi32>
  %right = buffer.view %right_storage[%right_offset] : buffer -> view<1xi32>
  %first, %tag_result, %second, %middle_result = func.call @shuffle(%tag, %left, %middle, %right) : (i32, view<1xi32>, i64, view<1xi32>) -> (view<1xi32>, i32, view<1xi32>, i64)
  func.return %first, %tag_result, %second, %middle_result : view<1xi32>, i32, view<1xi32>, i64
}

// ----
test.target<low_core> @carrier_target

func.def noinline target(@carrier_target) @shuffle(%tag: i32, %left_root: buffer, %left_offset: offset, %middle: i64, %right_root: buffer, %right_offset: offset) -> (buffer, offset, i32, buffer, offset, i64) {
  %left = buffer.view %left_root[%left_offset] : buffer -> view<1xi32>
  %right = buffer.view %right_root[%right_offset] : buffer -> view<1xi32>
  func.return %right_root, %right_offset, %tag, %left_root, %left_offset, %middle : buffer, offset, i32, buffer, offset, i64
}

func.def public target(@carrier_target) @call_shuffle(%left_storage: buffer, %left_offset: offset, %right_storage: buffer, %right_offset: offset, %tag: i32, %middle: i64) -> (buffer, offset, i32, buffer, offset, i64) {
  %left = buffer.view %left_storage[%left_offset] : buffer -> view<1xi32>
  %right = buffer.view %right_storage[%right_offset] : buffer -> view<1xi32>
  %first_root, %first_offset, %tag_result, %second_root, %second_offset, %middle_result = func.call @shuffle(%tag, %left_storage, %left_offset, %middle, %right_storage, %right_offset) : (i32, buffer, offset, i64, buffer, offset) -> (buffer, offset, i32, buffer, offset, i64)
  %second = buffer.view %second_root[%second_offset] : buffer -> view<1xi32>
  %first = buffer.view %first_root[%first_offset] : buffer -> view<1xi32>
  func.return %first_root, %first_offset, %tag_result, %second_root, %second_offset, %middle_result : buffer, offset, i32, buffer, offset, i64
}

