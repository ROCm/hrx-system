// ====

func.def @bitwise_compare_i8(%initial: i8, %expected: i8, %replacement: i8) -> (i8, i8) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 1 : offset
  %storage = buffer.alloca<private> align(1) %bytes : buffer
  %cell = buffer.view %storage[%origin] : buffer -> view<1xi8>
  view.store %initial, %cell[0] : i8, view<1xi8>
  %old = view.atomic.cmpxchg %expected, %replacement, %cell[0] {failure_ordering = acquire, scope = system, success_ordering = seq_cst} : i8, view<1xi8> -> i8
  %final = view.load %cell[0] : view<1xi8> -> i8
  func.return %old, %final : i8, i8
}

// ----
func.def @bitwise_compare_i8(%initial: i8, %expected: i8, %replacement: i8) -> (i8, i8) {
  %12 = scalar.cmpi eq, %initial, %expected : i8
  %13 = scf.select %12, %replacement, %initial : i8
  func.return %initial, %13 : i8, i8
}

