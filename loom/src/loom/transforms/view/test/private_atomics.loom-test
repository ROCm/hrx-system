func.def @shared_storage_stays_atomic(%input: buffer, %expected: i32, %replacement: i32) -> (i32, i32, i32) {
  %origin = index.constant 0 : offset
  %storage = buffer.assume.memory_space<global> %input : buffer
  %cell = buffer.view %storage[%origin] : buffer -> view<1xi32>
  view.atomic.store %replacement, %cell[0] {ordering = release, scope = thread} : i32, view<1xi32>
  %loaded = view.atomic.load %cell[0] {ordering = acquire, scope = thread} : view<1xi32> -> i32
  %old = view.atomic.rmw<addi> %replacement, %cell[0] {ordering = acq_rel, scope = thread} : i32, view<1xi32> -> i32
  %compared = view.atomic.cmpxchg %expected, %replacement, %cell[0] {failure_ordering = seq_cst, scope = thread, success_ordering = seq_cst} : i32, view<1xi32> -> i32
  view.atomic.reduce<subi> %replacement, %cell[0] {ordering = relaxed, scope = thread} : i32, view<1xi32>
  func.return %loaded, %old, %compared : i32, i32, i32
}

// ----
func.def @shared_storage_stays_atomic(%input: buffer, %expected: i32, %replacement: i32) -> (i32, i32, i32) {
  %origin = index.constant 0 : offset
  %storage = buffer.assume.memory_space<global> %input : buffer
  %cell = buffer.view %storage[%origin] : buffer -> view<1xi32>
  view.atomic.store %replacement, %cell[0] {ordering = release, scope = thread} : i32, view<1xi32>
  %loaded = view.atomic.load %cell[0] {ordering = acquire, scope = thread} : view<1xi32> -> i32
  %old = view.atomic.rmw<addi> %replacement, %cell[0] {ordering = acq_rel, scope = thread} : i32, view<1xi32> -> i32
  %compared = view.atomic.cmpxchg %expected, %replacement, %cell[0] {failure_ordering = seq_cst, scope = thread, success_ordering = seq_cst} : i32, view<1xi32> -> i32
  view.atomic.reduce<subi> %replacement, %cell[0] {ordering = relaxed, scope = thread} : i32, view<1xi32>
  func.return %loaded, %old, %compared : i32, i32, i32
}

// ====

func.def @private_indices_and_cache(%input: buffer, %row: index, %column: index, %update: i16) -> (i16) {
  %origin = index.constant 0 : offset
  %storage = buffer.assume.memory_space<private> %input : buffer
  %cells = buffer.view %storage[%origin] : buffer -> view<2x4xi16>
  %old = view.atomic.rmw<subi, root_in_bounds> %update, %cells[%row, %column] {cache_scope = system, cache_temporal = non_temporal, ordering = acq_rel, scope = system} : i16, view<2x4xi16> -> i16
  buffer.fence scope(system) ordering(seq_cst)
  func.return %old : i16
}

// ----
func.def @private_indices_and_cache(%input: buffer, %row: index, %column: index, %update: i16) -> (i16) {
  %origin = index.constant 0 : offset
  %storage = buffer.assume.memory_space<private> %input : buffer
  %cells = buffer.view %storage[%origin] : buffer -> view<2x4xi16>
  %old = view.load<root_in_bounds> %cells[%row, %column] {cache_scope = system, cache_temporal = non_temporal} : view<2x4xi16> -> i16
  %10 = scalar.subi %old, %update : i16
  view.store<root_in_bounds> %10, %cells[%row, %column] {cache_scope = system, cache_temporal = non_temporal} : i16, view<2x4xi16>
  buffer.fence scope(system) ordering(seq_cst)
  func.return %old : i16
}

// ====

func.def @private_alias_and_branch(%initial: i32, %increment: i32, %enabled: i1) -> (i32) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %storage = buffer.alloca<private> align(4) %bytes : buffer
  %cell = buffer.view %storage[%origin] : buffer -> view<1xi32>
  %alias = buffer.view %storage[%origin] : buffer -> view<1xi32>
  view.atomic.store %initial, %cell[0] {ordering = relaxed, scope = system} : i32, view<1xi32>
  scf.if %enabled {
    view.atomic.reduce<addi> %increment, %alias[0] {ordering = release, scope = system} : i32, view<1xi32>
  }
  %final = view.atomic.load %cell[0] {ordering = acquire, scope = system} : view<1xi32> -> i32
  func.return %final : i32
}

// ----
func.def @private_alias_and_branch(%initial: i32, %increment: i32, %enabled: i1) -> (i32) {
  %11 = scalar.addi %initial, %increment : i32
  %14 = scf.select %enabled, %11, %initial : i32
  func.return %14 : i32
}
