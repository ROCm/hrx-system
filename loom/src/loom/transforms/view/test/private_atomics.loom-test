// RUN: pass combine,promote-private-fragments,canonicalize,dce

func.def @integer_updates(%initial: i64, %update: i64) -> (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 8 : offset
  %storage = buffer.alloca<private> align(8) %bytes : buffer
  %cell = buffer.view %storage[%origin] : buffer -> view<1xi64>
  view.atomic.store %initial, %cell[0] {ordering = release, scope = system} : i64, view<1xi64>
  %old_xchgi = view.atomic.rmw<xchgi> %update, %cell[0] {ordering = acq_rel, scope = system} : i64, view<1xi64> -> i64
  %final_xchgi = view.atomic.load %cell[0] {ordering = acquire, scope = system} : view<1xi64> -> i64
  view.atomic.store %initial, %cell[0] {ordering = release, scope = system} : i64, view<1xi64>
  %old_addi = view.atomic.rmw<addi> %update, %cell[0] {ordering = acq_rel, scope = system} : i64, view<1xi64> -> i64
  %final_addi = view.atomic.load %cell[0] {ordering = acquire, scope = system} : view<1xi64> -> i64
  view.atomic.store %initial, %cell[0] {ordering = release, scope = system} : i64, view<1xi64>
  %old_subi = view.atomic.rmw<subi> %update, %cell[0] {ordering = acq_rel, scope = system} : i64, view<1xi64> -> i64
  %final_subi = view.atomic.load %cell[0] {ordering = acquire, scope = system} : view<1xi64> -> i64
  view.atomic.store %initial, %cell[0] {ordering = release, scope = system} : i64, view<1xi64>
  %old_andi = view.atomic.rmw<andi> %update, %cell[0] {ordering = acq_rel, scope = system} : i64, view<1xi64> -> i64
  %final_andi = view.atomic.load %cell[0] {ordering = acquire, scope = system} : view<1xi64> -> i64
  view.atomic.store %initial, %cell[0] {ordering = release, scope = system} : i64, view<1xi64>
  %old_ori = view.atomic.rmw<ori> %update, %cell[0] {ordering = acq_rel, scope = system} : i64, view<1xi64> -> i64
  %final_ori = view.atomic.load %cell[0] {ordering = acquire, scope = system} : view<1xi64> -> i64
  view.atomic.store %initial, %cell[0] {ordering = release, scope = system} : i64, view<1xi64>
  %old_xori = view.atomic.rmw<xori> %update, %cell[0] {ordering = acq_rel, scope = system} : i64, view<1xi64> -> i64
  %final_xori = view.atomic.load %cell[0] {ordering = acquire, scope = system} : view<1xi64> -> i64
  view.atomic.store %initial, %cell[0] {ordering = release, scope = system} : i64, view<1xi64>
  %old_minsi = view.atomic.rmw<minsi> %update, %cell[0] {ordering = acq_rel, scope = system} : i64, view<1xi64> -> i64
  %final_minsi = view.atomic.load %cell[0] {ordering = acquire, scope = system} : view<1xi64> -> i64
  view.atomic.store %initial, %cell[0] {ordering = release, scope = system} : i64, view<1xi64>
  %old_maxsi = view.atomic.rmw<maxsi> %update, %cell[0] {ordering = acq_rel, scope = system} : i64, view<1xi64> -> i64
  %final_maxsi = view.atomic.load %cell[0] {ordering = acquire, scope = system} : view<1xi64> -> i64
  view.atomic.store %initial, %cell[0] {ordering = release, scope = system} : i64, view<1xi64>
  %old_minui = view.atomic.rmw<minui> %update, %cell[0] {ordering = acq_rel, scope = system} : i64, view<1xi64> -> i64
  %final_minui = view.atomic.load %cell[0] {ordering = acquire, scope = system} : view<1xi64> -> i64
  view.atomic.store %initial, %cell[0] {ordering = release, scope = system} : i64, view<1xi64>
  %old_maxui = view.atomic.rmw<maxui> %update, %cell[0] {ordering = acq_rel, scope = system} : i64, view<1xi64> -> i64
  %final_maxui = view.atomic.load %cell[0] {ordering = acquire, scope = system} : view<1xi64> -> i64
  view.atomic.reduce<addi> %update, %cell[0] {ordering = seq_cst, scope = device} : i64, view<1xi64>
  %reduced = view.atomic.load %cell[0] {ordering = acquire, scope = system} : view<1xi64> -> i64
  func.return %final_xchgi, %final_addi, %final_subi, %final_andi, %final_ori, %final_xori, %final_minsi, %final_maxsi, %final_minui, %final_maxui, %reduced : i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64
}

// ----
func.def @integer_updates(%initial: i64, %update: i64) -> (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) {
  %67 = scalar.addi %initial, %update : i64
  %64 = scalar.subi %initial, %update : i64
  %61 = scalar.andi %initial, %update : i64
  %58 = scalar.ori %initial, %update : i64
  %55 = scalar.xori %initial, %update : i64
  %52 = scalar.minsi %initial, %update : i64
  %49 = scalar.maxsi %initial, %update : i64
  %46 = scalar.minui %initial, %update : i64
  %43 = scalar.maxui %initial, %update : i64
  %40 = scalar.addi %43, %update : i64
  func.return %update, %67, %64, %61, %58, %55, %52, %49, %46, %43, %40 : i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64
}

