func.def @bitwise_compare_f16(%initial: f16, %expected: f16, %replacement: f16) -> (f16, f16) {
  %12 = scalar.bitcast %initial : f16 to i16
  %13 = scalar.bitcast %expected : f16 to i16
  %14 = scalar.cmpi eq, %12, %13 : i16
  %15 = scf.select %14, %replacement, %initial : f16
  func.return %initial, %15 : f16, f16
}

