// ----
func.def @different_roots(%first: buffer, %second: buffer, %condition: i1) -> (view<16xf32>) {
  %base = index.constant 0 : offset
  %left = buffer.view %first[%base] : buffer -> view<16xf32>
  %right = buffer.view %second[%base] : buffer -> view<16xf32>
  %selected = scf.select %condition, %left, %right : view<16xf32>
  func.return %selected : view<16xf32>
}

// ====

// RUN: pass decompose-view-transports,canonicalize,cse,dce

func.def @refined_rotation(%input: buffer, %count: index) -> (i32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %base0 = index.constant 0 : offset
  %base1 = index.constant 4 : offset
  %left = buffer.view %input[%base0] : buffer -> view<1xi32>
  %right = buffer.view %input[%base1] : buffer -> view<1xi32>
  %last0, %last1 = scf.for %i = [%begin to %count step %step](%a = %left : view<1xi32>, %b = %right : view<1xi32>) -> (view<1xi32>, view<1xi32>) {
    %refined = view.refine %a : view<1xi32> -> view<1xi32>
    scf.yield %b, %refined : view<1xi32>, view<1xi32>
  }
  %result = view.load %last0[0] : view<1xi32> -> i32
  func.return %result : i32
}

// ----
func.def @refined_rotation(%input: buffer, %count: index) -> (i32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %base0 = index.constant 0 : offset
  %base1 = index.constant 4 : offset
  %last0_offset, %last1_offset = scf.for %i = [%begin to %count step %step](%a_offset = %base0 : offset, %b_offset = %base1 : offset) -> (offset, offset) {
    scf.yield %b_offset, %a_offset : offset, offset
  }
  %last0 = buffer.view %input[%last0_offset] : buffer -> view<1xi32>
  %result = view.load %last0[0] : view<1xi32> -> i32
  func.return %result : i32
}

// ====

// RUN: pass decompose-view-transports

// An unknown layout makes the projection recipe unavailable. Its whole
// dependent rotation remains intact while an independent selection decomposes.
func.def @unavailable_projection(%input: buffer, %count: index, %row: index, %condition: i1, %layout: encoding<layout>) -> (view<16xf32, %layout>, view<1xi32>) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %base0 = index.constant 0 : offset
  %base1 = index.constant 64 : offset
  %left = buffer.view %input[%base0] : buffer -> view<16xf32, %layout>
  %right = buffer.view %input[%base1] : buffer -> view<16xf32, %layout>
  %last0, %last1 = scf.for %i = [%begin to %count step %step](%a = %left : view<16xf32, %layout>, %b = %right : view<16xf32, %layout>) -> (view<16xf32, %layout>, view<16xf32, %layout>) {
    %projected = view.subview %a[%row] : view<16xf32, %layout> -> view<16xf32, %layout>
    scf.yield %b, %projected : view<16xf32, %layout>, view<16xf32, %layout>
  }
  %first = buffer.view %input[%base0] : buffer -> view<1xi32>
  %second = buffer.view %input[%base1] : buffer -> view<1xi32>
  %selected = scf.select %condition, %first, %second : view<1xi32>
  func.return %last0, %selected : view<16xf32, %layout>, view<1xi32>
}

// ----
func.def @unavailable_projection(%input: buffer, %count: index, %row: index, %condition: i1, %layout: encoding<layout>) -> (view<16xf32, %layout>, view<1xi32>) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %base0 = index.constant 0 : offset
  %base1 = index.constant 64 : offset
  %left = buffer.view %input[%base0] : buffer -> view<16xf32, %layout>
  %right = buffer.view %input[%base1] : buffer -> view<16xf32, %layout>
  %last0, %last1 = scf.for %i = [%begin to %count step %step](%a = %left : view<16xf32, %layout>, %b = %right : view<16xf32, %layout>) -> (view<16xf32, %layout>, view<16xf32, %layout>) {
    %projected = view.subview %a[%row] : view<16xf32, %layout> -> view<16xf32, %layout>
    scf.yield %b, %projected : view<16xf32, %layout>, view<16xf32, %layout>
  }
  %first = buffer.view %input[%base0] : buffer -> view<1xi32>
  %second = buffer.view %input[%base1] : buffer -> view<1xi32>
  %selected_offset = scf.select %condition, %base0, %base1 : offset
  %selected = buffer.view %input[%selected_offset] : buffer -> view<1xi32>
  func.return %last0, %selected : view<16xf32, %layout>, view<1xi32>
}

// ====

// RUN: pass decompose-view-transports

// A memory recurrence needs no carried tuple, even in a function that selects
// views after the loop.
func.def @memory_recurrence(%input: buffer, %condition: i1) -> (i32) {
  %base0 = index.constant 0 : offset
  %base1 = index.constant 4 : offset
  %left = buffer.view %input[%base0] : buffer -> view<1xi32>
  %right = buffer.view %input[%base1] : buffer -> view<1xi32>
  %cleared = scalar.constant 0 : i32
  scf.while {
    %value = view.load %left[0] : view<1xi32> -> i32
    %pending = scalar.cmpi ne, %value, %cleared : i32
    scf.condition %pending : i1
  } do {
    view.store %cleared, %left[0] : i32, view<1xi32>
    scf.yield
  }
  %selected = scf.select %condition, %left, %right : view<1xi32>
  %result = view.load %selected[0] : view<1xi32> -> i32
  func.return %result : i32
}

// ----
func.def @memory_recurrence(%input: buffer, %condition: i1) -> (i32) {
  %base0 = index.constant 0 : offset
  %base1 = index.constant 4 : offset
  %left = buffer.view %input[%base0] : buffer -> view<1xi32>
  %right = buffer.view %input[%base1] : buffer -> view<1xi32>
  %cleared = scalar.constant 0 : i32
  scf.while {
    %value = view.load %left[0] : view<1xi32> -> i32
    %pending = scalar.cmpi ne, %value, %cleared : i32
    scf.condition %pending : i1
  } do {
    view.store %cleared, %left[0] : i32, view<1xi32>
    scf.yield
  }
  %selected_offset = scf.select %condition, %base0, %base1 : offset
  %selected = buffer.view %input[%selected_offset] : buffer -> view<1xi32>
  %result = view.load %selected[0] : view<1xi32> -> i32
  func.return %result : i32
}
