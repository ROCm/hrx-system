load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")
load("//loom/build_tools/bazel:loom_check.bzl", "loom_check_test", "loom_check_test_suite")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_check_test_suite(
    name = "test",
    srcs = [
        "boundary_transport.loom-test",
        "contiguous_vector_tiles.loom-test",
        "linearize_view_accesses.loom-test",
        "load_coalescing.loom-test",
        "private_atomics.loom-test",
        "root_selection.loom-test",
        "transport.loom-test",
        "transport_offsets.loom-test",
    ],
)

loom_check_test(
    name = "boundary_transport_spirv",
    src = "boundary_transport_spirv.loom-test",
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/arch:spirv",
    ]),
)
