// RUN: pass linearize-view-accesses,canonicalize,cse

func.def @linearize_strided_load_store_shares_index(%input: buffer, %output: buffer, %origin: offset, %row0: index, %column0: index) {
  %row = index.assume %row0 [range(%row0, 0, 7)] : index
  %column = index.assume %column0 [range(%column0, 0, 12)] : index
  %layout = encoding.layout.strided [20, 1] : encoding<layout>
  %source = buffer.view %input[%origin] : buffer -> view<8x16xf32, %layout>
  %destination = buffer.view %output[%origin] : buffer -> view<8x16xf32, %layout>
  %value = vector.load %source[%row, %column] : view<8x16xf32, %layout> -> vector<4xf32>
  vector.store %value, %destination[%row, %column] : vector<4xf32>, view<8x16xf32, %layout>
  func.return
}

// ----
func.def @linearize_strided_load_store_shares_index(%input: buffer, %output: buffer, %origin: offset, %row0: index, %column0: index) {
  %row = index.assume %row0 [range(%row0, 0, 7)] : index
  %column = index.assume %column0 [range(%column0, 0, 12)] : index
  %source = buffer.view %input[%origin] : buffer -> view<156xf32>
  %destination = buffer.view %output[%origin] : buffer -> view<156xf32>
  %11 = index.constant 20 : index
  %12 = index.madd %row, %11, %column : index
  %value = vector.load %source[%12] : view<156xf32> -> vector<4xf32>
  vector.store %value, %destination[%12] : vector<4xf32>, view<156xf32>
  func.return
}

