}

// ----
func.def @linearize_strided_vector_tile(%input: buffer, %output: buffer, %origin: offset, %row0: index, %column0: index) {
  %row = index.assume %row0 [range(%row0, 0, 6)] : index
  %column = index.assume %column0 [range(%column0, 0, 12)] : index
  %source = buffer.view %input[%origin] : buffer -> view<156xf32>
  %destination = buffer.view %output[%origin] : buffer -> view<156xf32>
  %12 = index.constant 20 : index
  %13 = index.madd %row, %12, %column : index
  %14 = vector.load %source[%13] : view<156xf32> -> vector<4xf32>
  %18 = index.add %13, %12 : index
  %19 = vector.load %source[%18] : view<156xf32> -> vector<4xf32>
  vector.store %14, %destination[%13] : vector<4xf32>, view<156xf32>
  vector.store %19, %destination[%18] : vector<4xf32>, view<156xf32>
  func.return
}

