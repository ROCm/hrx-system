// ====

func.def @linearize_dense_tile_and_strided_vector_loads(%input: buffer, %zero_bytes: offset, %row0: index, %column0: index) {
  %row = index.assume %row0 [range(%row0, 0, 6)] : index
  %column = index.assume %column0 [range(%column0, 0, 12)] : index
  %dense_view = buffer.view %input[%zero_bytes] : buffer -> view<8x16xf32>
  %strided_layout = encoding.layout.strided [64, 1] : encoding<layout>
  %strided_view = buffer.view %input[%zero_bytes] : buffer -> view<8x16xf32, %strided_layout>
  %rank2 = vector.load %dense_view[%row, %column] : view<8x16xf32> -> vector<2x4xf32>
  %strided = vector.load %strided_view[%row, %column] : view<8x16xf32, %strided_layout> -> vector<4xf32>
  test.use %rank2, %strided : vector<2x4xf32>, vector<4xf32>
  func.return
}

// ----
func.def @linearize_dense_tile_and_strided_vector_loads(%input: buffer, %zero_bytes: offset, %row0: index, %column0: index) {
  %row = index.assume %row0 [range(%row0, 0, 6)] : index
  %column = index.assume %column0 [range(%column0, 0, 12)] : index
  %dense_view = buffer.view %input[%zero_bytes] : buffer -> view<128xf32>
  %strided_view = buffer.view %input[%zero_bytes] : buffer -> view<464xf32>
  %12 = index.constant 16 : index
  %13 = index.madd %row, %12, %column : index
  %14 = vector.load %dense_view[%13] : view<128xf32> -> vector<4xf32>
  %18 = index.add %13, %12 : index
  %19 = vector.load %dense_view[%18] : view<128xf32> -> vector<4xf32>
  %20 = vector.concat<0> %14, %19 : vector<4xf32>, vector<4xf32> -> vector<8xf32>
  %rank2 = vector.bitcast %20 : vector<8xf32> to vector<2x4xf32>
  %22 = index.constant 64 : index
  %23 = index.madd %row, %22, %column : index
  %strided = vector.load %strided_view[%23] : view<464xf32> -> vector<4xf32>
  test.use %rank2, %strided : vector<2x4xf32>, vector<4xf32>
  func.return
}

// ====

func.def @linearize_dense_rank2_vector_store(%output: buffer, %zero_bytes: offset, %row0: index, %column0: index, %value: vector<2x4xf32>) {
  %row = index.assume %row0 [range(%row0, 0, 6)] : index
  %column = index.assume %column0 [range(%column0, 0, 12)] : index
  %output_view = buffer.view %output[%zero_bytes] : buffer -> view<8x16xf32>
  vector.store %value, %output_view[%row, %column] : vector<2x4xf32>, view<8x16xf32>
  func.return
}

// ----
func.def @linearize_dense_rank2_vector_store(%output: buffer, %zero_bytes: offset, %row0: index, %column0: index, %value: vector<2x4xf32>) {
  %row = index.assume %row0 [range(%row0, 0, 6)] : index
  %column = index.assume %column0 [range(%column0, 0, 12)] : index
  %output_view = buffer.view %output[%zero_bytes] : buffer -> view<128xf32>
  %9 = vector.bitcast %value : vector<2x4xf32> to vector<8xf32>
  %10 = vector.slice %9[0] : vector<8xf32> -> vector<4xf32>
  %11 = index.constant 16 : index
  %12 = index.madd %row, %11, %column : index
  vector.store %10, %output_view[%12] : vector<4xf32>, view<128xf32>
  %13 = vector.slice %9[4] : vector<8xf32> -> vector<4xf32>
  %17 = index.add %12, %11 : index
  vector.store %13, %output_view[%17] : vector<4xf32>, view<128xf32>
  func.return
}

