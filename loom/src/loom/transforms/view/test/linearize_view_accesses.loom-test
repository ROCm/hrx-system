// RUN: with-locations pass linearize-view-accesses,canonicalize,cse

func.def @linearize_dense_load_preserves_sanitizer_site_location(%input: buffer, %zero_bytes: offset, %head0: index, %head_dim0: index) {
  %head = index.assume %head0 [range(%head0, 0, 3)] : index loc("loom/src/loom/transforms/view/test/linearize_view_accesses.loom-test":2:3 to 2:60)
  %head_dim = index.assume %head_dim0 [range(%head_dim0, 0, 127)] : index loc("loom/src/loom/transforms/view/test/linearize_view_accesses.loom-test":3:3 to 3:74)
  %input_view = buffer.view %input[%zero_bytes] : buffer -> view<4x128xf16> loc("linearize.loom":2:1)
  %value = view.load %input_view[%head, %head_dim] : view<4x128xf16> -> f16 loc(tagged<sanitizer_site, "0304", "linearize.loom":3:1>)
  test.use %value : f16 loc("linearize.loom":4:1)
  func.return loc("linearize.loom":5:1)
} loc("linearize.loom":1:1 to 6:1)

// ----
func.def @linearize_dense_load_preserves_sanitizer_site_location(%input: buffer, %zero_bytes: offset, %head0: index, %head_dim0: index) {
  %head = index.assume %head0 [range(%head0, 0, 3)] : index loc("loom/src/loom/transforms/view/test/linearize_view_accesses.loom-test":2:3 to 2:60)
  %head_dim = index.assume %head_dim0 [range(%head_dim0, 0, 127)] : index loc("loom/src/loom/transforms/view/test/linearize_view_accesses.loom-test":3:3 to 3:74)
  %input_view = buffer.view %input[%zero_bytes] : buffer -> view<512xf16> loc("linearize.loom":2:1)
  %8 = index.constant 128 : index loc(tagged<sanitizer_site, "0304", "linearize.loom":3:1>)
  %9 = index.madd %head, %8, %head_dim : index loc(tagged<sanitizer_site, "0304", "linearize.loom":3:1>)
  %value = view.load %input_view[%9] : view<512xf16> -> f16 loc(tagged<sanitizer_site, "0304", "linearize.loom":3:1>)
  test.use %value : f16 loc("linearize.loom":4:1)
  func.return loc("linearize.loom":5:1)
} loc("linearize.loom":1:1 to 6:1)

// ====

func.def @linearize_dense_store_shares_inner_index(%key_input: buffer, %value_input: buffer, %key_output: buffer, %value_output: buffer, %zero_bytes: offset, %position0: index, %head0: index, %head_dim0: index) {
  %position = index.assume %position0 [range(%position0, 0, 32767)] : index
  %head = index.assume %head0 [range(%head0, 0, 3)] : index
  %head_dim = index.assume %head_dim0 [range(%head_dim0, 0, 127)] : index
  %key_input_view = buffer.view %key_input[%zero_bytes] : buffer -> view<4x128xf16>
  %value_input_view = buffer.view %value_input[%zero_bytes] : buffer -> view<4x128xf16>
  %key_cache = buffer.view %key_output[%zero_bytes] : buffer -> view<32768x4x128xf16>
  %value_cache = buffer.view %value_output[%zero_bytes] : buffer -> view<32768x4x128xf16>
  %key = view.load %key_input_view[%head, %head_dim] : view<4x128xf16> -> f16
  %value = view.load %value_input_view[%head, %head_dim] : view<4x128xf16> -> f16
  view.store %key, %key_cache[%position, %head, %head_dim] : f16, view<32768x4x128xf16>
  view.store %value, %value_cache[%position, %head, %head_dim] : f16, view<32768x4x128xf16>
  func.return
}

// ----
func.def @linearize_dense_store_shares_inner_index(%key_input: buffer, %value_input: buffer, %key_output: buffer, %value_output: buffer, %zero_bytes: offset, %position0: index, %head0: index, %head_dim0: index) {
  %position = index.assume %position0 [range(%position0, 0, 32767)] : index
  %head = index.assume %head0 [range(%head0, 0, 3)] : index
  %head_dim = index.assume %head_dim0 [range(%head_dim0, 0, 127)] : index
  %key_input_view = buffer.view %key_input[%zero_bytes] : buffer -> view<512xf16>
  %value_input_view = buffer.view %value_input[%zero_bytes] : buffer -> view<512xf16>
  %key_cache = buffer.view %key_output[%zero_bytes] : buffer -> view<16777216xf16>
  %value_cache = buffer.view %value_output[%zero_bytes] : buffer -> view<16777216xf16>
  %17 = index.constant 128 : index
  %18 = index.madd %head, %17, %head_dim : index
  %key = view.load %key_input_view[%18] : view<512xf16> -> f16
  %value = view.load %value_input_view[%18] : view<512xf16> -> f16
  %27 = index.constant 512 : index
  %28 = index.madd %position, %27, %18 : index
  view.store %key, %key_cache[%28] : f16, view<16777216xf16>
  view.store %value, %value_cache[%28] : f16, view<16777216xf16>
  func.return
}

