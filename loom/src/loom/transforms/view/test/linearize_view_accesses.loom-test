  %column = index.assume %column0 [range(%column0, 0, 15)] : index
  %input_view = buffer.view %input[%zero_bytes] : buffer -> view<128xf32>
  %6 = index.constant 48 : index
  %7 = index.add %column, %6 : index
  %value = view.load %input_view[%7] {cache_scope = device, cache_temporal = non_temporal} : view<128xf32> -> f32
