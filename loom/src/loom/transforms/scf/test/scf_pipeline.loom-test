// RUN: pass pipeline-scf-for

func.def @depth_one_preserves_unroll(%input: view<64xf32>, %end: index, %initial: f32) -> (f32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %depth = index.constant 1 : index
  %factor = index.constant 2 : index
  %result = scf.for %i = [%begin to %end step %step](%sum = %initial : f32) -> (f32) pipeline(%depth) unroll(%factor) schedule(recurrence) {
    %value = view.load %input[%i] : view<64xf32> -> f32
    %next = scalar.addf %sum, %value : f32
    scf.yield %next : f32
  }
  func.return %result : f32
}

// ----
func.def @depth_one_preserves_unroll(%input: view<64xf32>, %end: index, %initial: f32) -> (f32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %depth = index.constant 1 : index
  %factor = index.constant 2 : index
  %result = scf.for %13 = [%begin to %end step %step](%14 = %initial : f32) -> (f32) unroll(%factor) schedule(recurrence) {
    %value = view.load %input[%13] : view<64xf32> -> f32
    %next = scalar.addf %14, %value : f32
    scf.yield %next : f32
