// ====
// RUN: pass pipeline-scf-for

func.def @no_request_leaves_effects_and_control_unchanged(%output: view<64xi32>, %end: index, %value: i32, %condition: i1) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  scf.for %i = [%begin to %end step %step] {
    scf.if %condition {
      view.store %value, %output[%i] : i32, view<64xi32>
    }
  }
  func.return
}
