// RUN: pass pipeline-scf-for

func.def @read_ahead_sum(%input: view<64xf32>, %begin: index, %end: index, %initial: f32) -> (f32) {
  %step = index.constant 1 : index
  %depth = index.constant 2 : index
  %result = scf.for %i = [%begin to %end step %step](%sum = %initial : f32) -> (f32) pipeline(%depth) {
    %value = view.load %input[%i] : view<64xf32> -> f32
    %next = scalar.addf %sum, %value : f32
    scf.yield %next : f32
  }
  func.return %result : f32
}

// ----
func.def @read_ahead_sum(%input: view<64xf32>, %begin: index, %end: index, %initial: f32) -> (f32) {
  %step = index.constant 1 : index
  %depth = index.constant 2 : index
  %12 = index.constant 9223372036854775806 : index
  %13 = index.cmp sle, %begin, %12 : index
  %14 = index.min %begin, %12 : index
  %15 = index.constant 1 : index
  %16 = index.add %14, %15 : index
  %17 = index.cmp slt, %16, %end : index
  %18 = scalar.andi %13, %17 : i1
  %result = scf.if %18 -> (f32) {
    %20 = index.assume %begin [lt(%begin, %end)] : index
    %value = view.load %input[%20] : view<64xf32> -> f32
    %25, %26 = scf.for %22 = [%16 to %end step %step](%23 = %initial : f32, %24 = %value : f32) -> (f32, f32) {
      %value = view.load %input[%22] : view<64xf32> -> f32
      %next = scalar.addf %23, %24 : f32
      scf.yield %next, %value : f32, f32
    }
    %next = scalar.addf %25, %26 : f32
    scf.yield %next : f32
  } else {
    %32 = scf.for %30 = [%begin to %end step %step](%31 = %initial : f32) -> (f32) {
      %value = view.load %input[%30] : view<64xf32> -> f32
      %next = scalar.addf %31, %value : f32
      scf.yield %next : f32
    }
    scf.yield %32 : f32
  }
  func.return %result : f32
}

// ====
// RUN: pass pipeline-scf-for,canonicalize,cse,dce

func.def @three_records_and_two_recurrences(%input: view<64xi32>, %initial: i32, %other: i32) -> (i32, i32) {
  %begin = index.constant 0 : index
  %end = index.constant 8 : index
  %step = index.constant 1 : index
  %depth = index.constant 4 : index
  %result, %rotated = scf.for %i = [%begin to %end step %step](%sum = %initial : i32, %previous = %other : i32) -> (i32, i32) pipeline(%depth) {
    %value = view.load %input[%i] : view<64xi32> -> i32
    %next = scalar.addi %sum, %value : i32
    scf.yield %previous, %next : i32, i32
  }
  func.return %result, %rotated : i32, i32
}

// ----
func.def @three_records_and_two_recurrences(%input: view<64xi32>, %initial: i32, %other: i32) -> (i32, i32) {
  %begin = index.constant 0 : index
  %end = index.constant 8 : index
  %step = index.constant 1 : index
  %16 = index.constant 3 : index
  %value$20 = view.load %input[%begin] : view<64xi32> -> i32
  %value$23 = view.load %input[%step] : view<64xi32> -> i32
  %50 = index.constant 2 : index
  %value$26 = view.load %input[%50] : view<64xi32> -> i32
  %33, %34, %35, %36, %37 = scf.for %27 = [%16 to %end step %step](%28 = %initial : i32, %29 = %other : i32, %30 = %value$20 : i32, %31 = %value$23 : i32, %32 = %value$26 : i32) -> (i32, i32, i32, i32, i32) {
    %value = view.load %input[%27] : view<64xi32> -> i32
    %next = scalar.addi %28, %30 : i32
    scf.yield %29, %next, %31, %32, %value : i32, i32, i32, i32, i32
  }
  %next$40 = scalar.addi %33, %35 : i32
  %next$41 = scalar.addi %34, %36 : i32
  %next$42 = scalar.addi %next$40, %37 : i32
  func.return %next$41, %next$42 : i32, i32
}

