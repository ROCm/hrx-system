// ====
// RUN: pass specialize-target-callgraph,vector-memory-footprint,unroll-scf-for,canonicalize,scf-to-cfg,vector-memory-footprint

// The speculative copied IV would exceed MAX32. Its distance guard must
// establish the original domain before forming the copy or remapping uses.
test.target<quirky> @target

func.def public target(@target) @distance_guard_source_interval(%payload: buffer, %base: offset, %start0: index, %value: i32) {
  %start = index.assume %start0 [range(%start0, 2147483628, 2147483629)] : index
  %end = index.constant 2147483644 : index
  %origin = index.constant 2147483628 : index
  %step = index.constant 4 : index
  %shift = index.constant 2 : index
  %factor = index.constant 3 : index
  %view = buffer.view %payload[%base] : buffer -> view<16xi32>
  scf.for %i = [%start to %end step %step] unroll(%factor) {
    %relative = index.sub %i, %origin : index
    %position = index.add %relative, %shift : index
    view.store %value, %view[%position] : i32, view<16xi32>
  }
  func.return
}

// ----
test.target<quirky> @target

func.def public target(@target) @distance_guard_source_interval(%payload: buffer, %base: offset, %start0: index, %value: i32) {
  %start = index.assume %start0 [range(%start0, 2147483628, 2147483629)] : index
  %end = index.constant 2147483644 : index
  %origin = index.constant 2147483628 : index
  %shift = index.constant 2 : index
  %view = buffer.view %payload[%base] : buffer -> view<16xi32>
  %14 = index.constant 12 : index
  cfg.br ^_bb1(%start: index)
^_bb1(%33: index):
  %35 = index.cmp slt, %33, %end : index
  cfg.cond_br %35, ^_bb2, ^_bb8
^_bb2:
  %i = index.assume %33 [range(%33, 2147483628, 2147483641), ge(%33, %start)] : index
  %relative = index.sub %i, %origin : index
  %position = index.add %relative, %shift : index
  view.store %value, %view[%position] : i32, view<16xi32>
  %18 = index.constant 4 : index
  %19 = index.add %i, %18 : index
  %20 = index.cmp slt, %19, %end : index
  cfg.cond_br %20, ^_bb3, ^_bb4
^_bb3:
  %i_4 = index.assume %19 [range(%19, 2147483628, 2147483641)] : index
  %relative_1 = index.sub %i_4, %origin : index
  %position_1 = index.add %relative_1, %shift : index
  view.store %value, %view[%position_1] : i32, view<16xi32>
  cfg.br ^_bb4
^_bb4:
  %24 = index.sub %end, %i : index
  %25 = index.constant 8 : index
  %26 = index.cmp ult, %25, %24 : index
  cfg.cond_br %26, ^_bb5, ^_bb6
^_bb5:
  %32 = index.assume %i [le(%i, 2147483635)] : index
  %27 = index.constant 8 : index
  %28 = index.add %32, %27 : index
  %i_8 = index.assume %28 [range(%28, 2147483628, 2147483641), ge(%28, %i), lt(%28, %end)] : index
  %relative_2 = index.sub %i_8, %origin : index
  %position_2 = index.add %relative_2, %shift : index
  view.store %value, %view[%position_2] : i32, view<16xi32>
  cfg.br ^_bb6
^_bb6:
  %36 = index.sub %end, %i : index
  %37 = index.cmp ult, %14, %36 : index
  cfg.cond_br %37, ^_bb7, ^_bb8
^_bb7:
  %38 = index.add %i, %14 : index
  cfg.br ^_bb1(%38: index)
^_bb8:
  func.return
}

// ====
// RUN: pass unroll-scf-for,canonicalize

// The IV is referenced only by types. Every cloned type must use the
// source-domain alias just as an ordinary operand would.
func.def @type_only_source_interval(%payload: buffer, %base: offset, %start0: index) {
  %start = index.assume %start0 [range(%start0, 1, 2)] : index
  %end = index.constant 13 : index
  %step = index.constant 4 : index
  %factor = index.constant 2 : index
  scf.for %i = [%start to %end step %step] unroll(%factor) schedule(interleaved) {
    %view = buffer.view %payload[%base] : buffer -> view<[%i]xi32>
    test.use %view : view<[%i]xi32>
  }
  func.return
}

// ----
func.def @type_only_source_interval(%payload: buffer, %base: offset, %start0: index) {
  %start = index.assume %start0 [range(%start0, 1, 2)] : index
  %end = index.constant 13 : index
  %9 = index.constant 8 : index
  %10 = index.constant 8 : index
  %11 = index.add %start, %10 : index
  scf.for %12 = [%start to %11 step %9] {
    %13 = index.constant 4 : index
    %14 = index.add %12, %13 : index
    %i, %i_4 = index.assume %12, %14 [range(%12, 1, 10), ge(%12, %start), lt(%12, %end), range(%14, 1, 10), ge(%14, %start), lt(%14, %end)] : index, index
    %view = buffer.view %payload[%base] : buffer -> view<[%i]xi32>
    %view_1 = buffer.view %payload[%base] : buffer -> view<[%i_4]xi32>
    test.use %view : view<[%i]xi32>
    test.use %view_1 : view<[%i_4]xi32>
  }
  %i = index.assume %11 [range(%11, 1, 10)] : index
  %view = buffer.view %payload[%base] : buffer -> view<[%i]xi32>
  test.use %view : view<[%i]xi32>
  func.return
}

// ====
// RUN: pass unroll-scf-for,canonicalize,scf-to-cfg,vector-memory-footprint

// Retaining the source domain cannot make a genuinely invalid origin legal.
func.def @invalid_shifted_scalar(%payload: buffer, %base: offset, %start0: index, %value: i32) {
  %start = index.assume %start0 [range(%start0, 0, 1)] : index
  %end = index.constant 12 : index
  %step = index.constant 4 : index
  %shift = index.constant 3 : index
  %factor = index.constant 2 : index
  %view = buffer.view %payload[%base] : buffer -> view<12xi32>
  scf.for %i = [%start to %end step %step] unroll(%factor) {
    %position = index.add %i, %shift : index
    // ERROR@+2: SUBRANGE/024 {op_name="view.store", view_axis="0"}
    // ERROR@+1: SUBRANGE/024 {op_name="view.store", view_axis="0"}
    view.store %value, %view[%position] : i32, view<12xi32>
  }
  func.return
}

// ====
// RUN: pass unroll-scf-for,canonicalize,scf-to-cfg,vector-memory-footprint

func.def @invalid_shifted_vector(%payload: buffer, %base: offset, %start0: index) {
  %start = index.assume %start0 [range(%start0, 0, 1)] : index
  %end = index.constant 12 : index
  %step = index.constant 4 : index
  %shift = index.constant 2 : index
  %factor = index.constant 2 : index
  %view = buffer.view %payload[%base] : buffer -> view<12xi32>
  scf.for %i = [%start to %end step %step] unroll(%factor) schedule(interleaved) {
    %position = index.add %i, %shift : index
    // ERROR@+2: SUBRANGE/010 {op_name="vector.load", vector_extent="2"}
    // ERROR@+1: SUBRANGE/010 {op_name="vector.load", vector_extent="2"}
    %packet = vector.load %view[%position] : view<12xi32> -> vector<2xi32>
    test.use %packet : vector<2xi32>
  }
  func.return
}

// ====
// RUN: pass specialize-target-callgraph,vector-memory-footprint,unroll-scf-for,canonicalize,scf-to-cfg,vector-memory-footprint

// Materialized tile lanes overflow the independent signed-64 interval.
// Their source-domain assumptions must restore both ends, even though the
// original last reachable IV is already upper - 1.
test.target<low_core> @target

func.def public target(@target) @wide_scheduled_grid(%payload: buffer, %base: offset, %start0: index, %value: i32) {
  %start = index.assume %start0 [range(%start0, 9223372036854775760, 9223372036854775764), multiple_of(%start0, 4)] : index
  %end = index.constant 9223372036854775805 : index
  %step = index.constant 8 : index
  %offset = index.constant 3 : index
  %origin = index.constant 9223372036854775760 : index
  %factor = index.constant 4 : index
  %view = buffer.view %payload[%base] : buffer -> view<48xi32>
  scf.for %i = [%start to %end step %step] unroll(%factor) schedule(interleaved) {
    %relative = index.sub %i, %origin : index
    %position = index.add %relative, %offset : index
    view.store %value, %view[%position] : i32, view<48xi32>
  }
  func.return
}

// ----
