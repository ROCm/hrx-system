  %shift = index.constant 1 : index
  %view = buffer.view %payload[%base] : buffer -> view<12xi32>
  %12 = index.constant 8 : index
  %13 = index.constant 8 : index
  %14 = index.add %start, %13 : index
  cfg.br ^_bb1(%start: index)
^_bb1(%29: index):
  %31 = index.cmp slt, %29, %14 : index
  cfg.cond_br %31, ^_bb2, ^_bb4
^_bb2:
  %30 = index.assume %29 [range(%29, 0, 8), ge(%29, %start), lt(%29, %14)] : index
  %16 = index.constant 4 : index
  %17 = index.add %30, %16 : index
  %i$18, %i_4 = index.assume %30, %17 [range(%30, 0, 9), ge(%30, %start), lt(%30, %end), range(%17, 0, 9), ge(%17, %start), lt(%17, %end)] : index, index
  %position$20 = index.add %i$18, %shift : index
  %position_1 = index.add %i_4, %shift : index
  %packet$22 = vector.load %view[%position$20] : view<12xi32> -> vector<2xi32>
  test.use %packet$22 : vector<2xi32>
  %packet_1 = vector.load %view[%position_1] : view<12xi32> -> vector<2xi32>
  test.use %packet_1 : vector<2xi32>
  %32 = index.sub %14, %30 : index
  %33 = index.cmp ult, %12, %32 : index
  cfg.cond_br %33, ^_bb3, ^_bb4
^_bb3:
  %34 = index.add %30, %12 : index
  cfg.br ^_bb1(%34: index)
^_bb4:
  %i$26 = index.assume %14 [range(%14, 0, 9)] : index
  %position$27 = index.add %i$26, %shift : index
  %packet$28 = vector.load %view[%position$27] : view<12xi32> -> vector<2xi32>
  test.use %packet$28 : vector<2xi32>
  func.return
}

// ====

func.def @recurrence_source_interval(%payload: buffer, %base: offset, %start0: index, %initial: i32) -> (i32) {
  %start = index.assume %start0 [range(%start0, 0, 1)] : index
  %end = index.constant 12 : index
  %step = index.constant 4 : index
  %shift = index.constant 2 : index
  %factor = index.constant 2 : index
  %view = buffer.view %payload[%base] : buffer -> view<12xi32>
  %result = scf.for %i = [%start to %end step %step](%sum = %initial : i32) -> (i32) unroll(%factor) schedule(recurrence) {
    %position = index.add %i, %shift : index
    %value = view.load %view[%position] : view<12xi32> -> i32
    %next = scalar.addi %sum, %value : i32
    scf.yield %next : i32
  }
  func.return %result : i32
}

// ----
func.def @recurrence_source_interval(%payload: buffer, %base: offset, %start0: index, %initial: i32) -> (i32) {
  %start = index.assume %start0 [range(%start0, 0, 1)] : index
  %end = index.constant 12 : index
  %shift = index.constant 2 : index
  %view = buffer.view %payload[%base] : buffer -> view<12xi32>
  %17 = index.constant 8 : index
  %18 = index.constant 8 : index
  %19 = index.add %start, %18 : index
  cfg.br ^_bb1(%start: index, %initial: i32)
^_bb1(%42: index, %sum: i32):
  %45 = index.cmp slt, %42, %19 : index
  cfg.cond_br %45, ^_bb2, ^_bb5
^_bb2:
  %44 = index.assume %42 [range(%42, 0, 8), ge(%42, %start), lt(%42, %19)] : index
  %23 = index.constant 4 : index
  %24 = index.add %44, %23 : index
  %i$25, %i_4 = index.assume %44, %24 [range(%44, 0, 9), ge(%44, %start), lt(%44, %end), range(%24, 0, 9), ge(%24, %start), lt(%24, %end)] : index, index
  %position$27 = index.add %i$25, %shift : index
  %value$28 = view.load %view[%position$27] : view<12xi32> -> i32
  %position_1 = index.add %i_4, %shift : index
  %value_1 = view.load %view[%position_1] : view<12xi32> -> i32
  scf.schedule.fence
  %next$31 = scalar.addi %sum, %value$28 : i32
  scf.schedule.fence
  %next_1 = scalar.addi %next$31, %value_1 : i32
  %46 = index.sub %19, %44 : index
  %47 = index.cmp ult, %17, %46 : index
  cfg.cond_br %47, ^_bb3, ^_bb4
^_bb3:
  %48 = index.add %44, %17 : index
  cfg.br ^_bb1(%48: index, %next_1: i32)
^_bb4:
  cfg.br ^_bb6(%next_1: i32)
^_bb5:
  cfg.br ^_bb6(%sum: i32)
^_bb6(%41: i32):
  %i$37 = index.assume %19 [range(%19, 0, 9)] : index
  %position$38 = index.add %i$37, %shift : index
  %value$39 = view.load %view[%position$38] : view<12xi32> -> i32
  %next$40 = scalar.addi %41, %value$39 : i32
  func.return %next$40 : i32
}

// ====

// The unsigned split's remainder/select arithmetic loses divisibility. Only
// entered main and tail bodies may recover the source grid and last IV.
func.def @unsigned_tail_grid(%payload: buffer, %base: offset, %end0: offset, %value: i32) {
  %start = index.constant 0 : offset
  %end = index.assume %end0 [range(%end0, 13, 16)] : offset
  %step = index.constant 4 : offset
  %shift = index.constant 3 : offset
  %factor = index.constant 3 : index
  %view = buffer.view %payload[%base] : buffer -> view<16xi32>
  scf.for %i = [%start to %end step %step] unroll(%factor) schedule(interleaved) {
    %position0 = index.add %i, %shift : offset
    %position = index.cast %position0 : offset to index
    view.store %value, %view[%position] : i32, view<16xi32>
  }
  func.return
}

