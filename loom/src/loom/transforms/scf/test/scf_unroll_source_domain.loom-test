  view.store %value, %view[%position_2] : i32, view<16xi32>
  %58 = index.sub %27, %56 : offset
  %59 = index.cmp ult, %13, %58 : offset
  cfg.cond_br %59, ^_bb3, ^_bb4
^_bb3:
  %60 = index.add %56, %13 : offset
  cfg.br ^_bb1(%60: offset)
^_bb4:
  %42 = index.constant 4 : offset
  cfg.br ^_bb5(%27: offset)
