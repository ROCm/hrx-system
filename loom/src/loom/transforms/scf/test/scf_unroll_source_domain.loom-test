// RUN: pass vector-memory-footprint,unroll-scf-for,canonicalize,scf-to-cfg,vector-memory-footprint

// The source IV reaches at most 9. Guarding a copied IV with < 12 alone
// loses the two positions needed by the shifted scalar access.
func.def @guarded_source_interval(%payload: buffer, %base: offset, %start0: index, %value: i32) {
  %start = index.assume %start0 [range(%start0, 0, 1)] : index
  %end = index.constant 12 : index
  %step = index.constant 4 : index
  %shift = index.constant 2 : index
  %factor = index.constant 2 : index
  %view = buffer.view %payload[%base] : buffer -> view<12xi32>
  scf.for %i = [%start to %end step %step] unroll(%factor) {
    %position = index.add %i, %shift : index
    view.store %value, %view[%position] : i32, view<12xi32>
  }
  func.return
}

// ----
func.def @guarded_source_interval(%payload: buffer, %base: offset, %start0: index, %value: i32) {
  %start = index.assume %start0 [range(%start0, 0, 1)] : index
  %end = index.constant 12 : index
  %shift = index.constant 2 : index
  %view = buffer.view %payload[%base] : buffer -> view<12xi32>
  %12 = index.constant 8 : index
  cfg.br ^_bb1(%start: index)
^_bb1(%20: index):
  %22 = index.cmp slt, %20, %end : index
  cfg.cond_br %22, ^_bb2, ^_bb6
^_bb2:
  %i = index.assume %20 [range(%20, 0, 9), ge(%20, %start)] : index
  %position = index.add %i, %shift : index
  view.store %value, %view[%position] : i32, view<12xi32>
  %15 = index.constant 4 : index
  %16 = index.add %i, %15 : index
  %17 = index.cmp slt, %16, %end : index
  cfg.cond_br %17, ^_bb3, ^_bb4
^_bb3:
  %i_4 = index.assume %16 [range(%16, 0, 9)] : index
  %position_1 = index.add %i_4, %shift : index
  view.store %value, %view[%position_1] : i32, view<12xi32>
  cfg.br ^_bb4
^_bb4:
  %23 = index.sub %end, %i : index
  %24 = index.cmp ult, %12, %23 : index
  cfg.cond_br %24, ^_bb5, ^_bb6
^_bb5:
  %25 = index.add %i, %12 : index
  cfg.br ^_bb1(%25: index)
^_bb6:
  func.return
}

// ====

// An exact trip count still needs source facts when the main bound is
// start + 8: independent endpoint intervals lose that correlation.
func.def @interleaved_source_interval(%payload: buffer, %base: offset, %start0: index) {
  %start = index.assume %start0 [range(%start0, 0, 1)] : index
  %end = index.constant 12 : index
  %step = index.constant 4 : index
  %shift = index.constant 1 : index
  %factor = index.constant 2 : index
  %view = buffer.view %payload[%base] : buffer -> view<12xi32>
  scf.for %i = [%start to %end step %step] unroll(%factor) schedule(interleaved) {
    %position = index.add %i, %shift : index
    %packet = vector.load %view[%position] : view<12xi32> -> vector<2xi32>
    test.use %packet : vector<2xi32>
  }
  func.return
}

// ----
func.def @interleaved_source_interval(%payload: buffer, %base: offset, %start0: index) {
  %start = index.assume %start0 [range(%start0, 0, 1)] : index
