  %29 = index.constant 4 : offset
  %30 = index.add %56, %29 : offset
  %31 = index.constant 8 : offset
  %32 = index.add %56, %31 : offset
  %i$33, %i_4, %i_8 = index.assume %56, %30, %32 [range(%56, 0, 12), multiple_of(%56, 4), ge(%56, %start), lt(%56, %end), range(%30, 0, 12), multiple_of(%30, 4), ge(%30, %start), lt(%30, %end), range(%32, 0, 12), multiple_of(%32, 4), ge(%32, %start), lt(%32, %end)] : offset, offset, offset
  %position0$36 = index.add %i$33, %shift : offset
  %position0_1 = index.add %i_4, %shift : offset
  %position0_2 = index.add %i_8, %shift : offset
  %position$39 = index.cast %position0$36 : offset to index
  %position_1 = index.cast %position0_1 : offset to index
  %position_2 = index.cast %position0_2 : offset to index
  view.store %value, %view[%position$39] : i32, view<16xi32>
