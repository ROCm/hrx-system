// RUN: pass pipeline-scf-for,canonicalize,cse,dce

func.def @nonunit_step_with_live_induction(%input: view<64xf32>, %initial: f32) -> (f32, index) {
  %begin = index.constant 3 : index
  %end = index.constant 14 : index
  %step = index.constant 3 : index
  %depth = index.constant 3 : index
  %result, %last = scf.for %i = [%begin to %end step %step](%sum = %initial : f32, %previous = %begin : index) -> (f32, index) pipeline(%depth) {
    %value = view.load %input[%i] : view<64xf32> -> f32
    %next = scalar.addf %sum, %value : f32
    scf.yield %next, %i : f32, index
  }
  func.return %result, %last : f32, index
}

// ----
func.def @nonunit_step_with_live_induction(%input: view<64xf32>, %initial: f32) -> (f32, index) {
  %begin = index.constant 3 : index
  %end = index.constant 14 : index
  %15 = index.constant 9 : index
  %value$19 = view.load %input[%begin] : view<64xf32> -> f32
  %47 = index.constant 6 : index
  %value$22 = view.load %input[%47] : view<64xf32> -> f32
  %30, %31, %32, %33, %34, %35 = scf.for %23 = [%15 to %end step %begin](%24 = %initial : f32, %25 = %begin : index, %26 = %begin : index, %27 = %value$19 : f32, %28 = %47 : index, %29 = %value$22 : f32) -> (f32, index, index, f32, index, f32) {
    %value = view.load %input[%23] : view<64xf32> -> f32
    %next = scalar.addf %24, %27 : f32
    scf.yield %next, %26, %28, %29, %23, %value : f32, index, index, f32, index, f32
  }
  %next$38 = scalar.addf %30, %33 : f32
  %next$39 = scalar.addf %next$38, %35 : f32
  func.return %next$39, %34 : f32, index
}

