func.def @empty_loop_does_not_load(%input: view<1xf32>, %initial: f32) -> (f32) {
  %begin = index.constant 0 : index
  %end = index.constant 0 : index
  %step = index.constant 1 : index
  %depth = index.constant 4 : index
  %result = scf.for %i = [%begin to %end step %step](%sum = %initial : f32) -> (f32) pipeline(%depth) {
    %value = view.load %input[%i] : view<1xf32> -> f32
    %next = scalar.addf %sum, %value : f32
    scf.yield %next : f32
  }
  func.return %result : f32
}

// ----
func.def @empty_loop_does_not_load(%input: view<1xf32>, %initial: f32) -> (f32) {
  func.return %initial : f32
}

