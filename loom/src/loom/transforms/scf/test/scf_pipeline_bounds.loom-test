func.def @offset_domain(%input: buffer, %initial: f32) -> (f32) {
  %begin = index.constant 4 : offset
  %end = index.constant 28 : offset
  %step = index.constant 4 : offset
  %depth = index.constant 3 : index
  %result = scf.for %position = [%begin to %end step %step](%sum = %initial : f32) -> (f32) pipeline(%depth) {
    %view = buffer.view %input[%position] : buffer -> view<1xf32>
    %value = view.load %view[0] : view<1xf32> -> f32
    %next = scalar.addf %sum, %value : f32
    scf.yield %next : f32
  }
  func.return %result : f32
}

// ----
func.def @offset_domain(%input: buffer, %initial: f32) -> (f32) {
  %begin = index.constant 4 : offset
  %end = index.constant 28 : offset
  %13 = index.constant 12 : offset
  %view$16 = buffer.view %input[%begin] : buffer -> view<1xf32>
  %value$17 = view.load %view$16[0] : view<1xf32> -> f32
  %40 = index.constant 8 : offset
  %view$20 = buffer.view %input[%40] : buffer -> view<1xf32>
  %value$21 = view.load %view$20[0] : view<1xf32> -> f32
  %26, %27, %28 = scf.for %22 = [%13 to %end step %begin](%23 = %initial : f32, %24 = %value$17 : f32, %25 = %value$21 : f32) -> (f32, f32, f32) {
    %view = buffer.view %input[%22] : buffer -> view<1xf32>
    %value = view.load %view[0] : view<1xf32> -> f32
    %next = scalar.addf %23, %24 : f32
    scf.yield %next, %25, %value : f32, f32, f32
  }
  %next$32 = scalar.addf %26, %27 : f32
  %next$33 = scalar.addf %next$32, %28 : f32
  func.return %next$33 : f32
}

