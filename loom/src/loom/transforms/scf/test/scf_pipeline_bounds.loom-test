}

// ----
func.def @pipeline_then_full_unroll(%input: view<5xf32>, %initial: f32) -> (f32) {
  %begin = index.constant 0 : index
  %value$15 = view.load %input[%begin] : view<5xf32> -> f32
  %59 = index.constant 1 : index
  %value$18 = view.load %input[%59] : view<5xf32> -> f32
  %35 = index.constant 2 : index
  %36 = index.constant 3 : index
  %37 = index.constant 4 : index
  %value$38 = view.load %input[%35] : view<5xf32> -> f32
  %value_1 = view.load %input[%36] : view<5xf32> -> f32
  scf.schedule.fence
  %next$40 = scalar.addf %initial, %value$15 : f32
  %value_2 = view.load %input[%37] : view<5xf32> -> f32
  scf.schedule.fence
  %next_1 = scalar.addf %next$40, %value$18 : f32
  scf.schedule.fence
  %next_2 = scalar.addf %next_1, %value$38 : f32
  %next$28 = scalar.addf %next_2, %value_1 : f32
  %next$29 = scalar.addf %next$28, %value_2 : f32
