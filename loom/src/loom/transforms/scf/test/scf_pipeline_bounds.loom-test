  %result = scf.for %i = [%begin to %end step %step](%sum = %initial : f32) -> (f32) pipeline(%depth) unroll schedule(recurrence) {
    %value = view.load %input[%i] : view<5xf32> -> f32
    %next = scalar.addf %sum, %value : f32
    scf.yield %next : f32
  }
