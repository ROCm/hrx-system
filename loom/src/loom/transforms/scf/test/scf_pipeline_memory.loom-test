// RUN: pass-report pipeline-scf-for

// Every concrete global-like source reads ahead while two views of the same
// workgroup allocation remain ordered.
kernel.def @ordered_workgroup_consumer() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%global_input: buffer, %constant_input: buffer, %descriptor_input: buffer, %output: buffer) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %width = index.constant 64 : index
  %last = index.constant 63 : index
  %origin = index.constant 0 : offset
  %stage_bytes = index.constant 256 : offset
  %lane = kernel.workitem.id<x> : index
  %peer = index.sub %last, %lane : index
  %global_buffer = buffer.assume.memory_space<global> %global_input : buffer
  %constant_buffer = buffer.assume.memory_space<constant> %constant_input : buffer
  %descriptor_buffer = buffer.assume.memory_space<descriptor> %descriptor_input : buffer
  %global_source = buffer.view %global_buffer[%origin] : buffer -> view<256xi32>
  %constant_source = buffer.view %constant_buffer[%origin] : buffer -> view<256xi32>
  %descriptor_source = buffer.view %descriptor_buffer[%origin] : buffer -> view<256xi32>
  %destination = buffer.view %output[%origin] : buffer -> view<64xi32>
  %scratch = buffer.alloca<workgroup> align(4) %stage_bytes : buffer
  %published = buffer.view %scratch[%origin] : buffer -> view<64xi32>
  %consumed = buffer.view %scratch[%origin] : buffer -> view<64xi32>
  %identity = scalar.constant 0 : i32
  %result = scf.for %row = [%c0 to %c4 step %c1](%sum = %identity : i32) -> (i32) pipeline(%c2) {
    %address = index.madd %row, %width, %lane : index
    %global_value = view.load %global_source[%address] : view<256xi32> -> i32
    %constant_value = view.load %constant_source[%address] : view<256xi32> -> i32
    %descriptor_value = view.load %descriptor_source[%address] : view<256xi32> -> i32
    %external_sum = scalar.addi %global_value, %constant_value : i32
    %value = scalar.addi %external_sum, %descriptor_value : i32
    view.store %value, %published[%lane] : i32, view<64xi32>
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %observed = view.load %consumed[%peer] : view<64xi32> -> i32
    %next = scalar.addi %sum, %observed : i32
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.yield %next : i32
  }
  view.store %result, %destination[%lane] : i32, view<64xi32>
  kernel.return
}

