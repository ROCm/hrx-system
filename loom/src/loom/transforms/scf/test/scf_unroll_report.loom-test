// RUN: with-checks pass-report unroll-scf-for

func.def @static_loop_without_unroll_policy() {
  %start = index.constant 0 : index
  %end = index.constant 32 : index
  %step = index.constant 16 : index
  scf.for %i = [%start to %end step %step] {
    test.use %i : index
  }
  func.return
}

// ----
CHECK: *"changed":false,*
CHECK: *"statistics":{"loops-unrolled":0,"iterations-materialized":0,"policies-cleared":0}*
CHECK: *{"category":"scf-unroll","outcome":"structured","op":"scf.for","policy":"absent","trip_count_state":"exact","trip_count":2,"step":16,"lower_bound_kind":"static","lower":0}*

