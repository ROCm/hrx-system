CHECK: *"statistics":{"loops-unrolled":0,"iterations-materialized":0,"policies-cleared":0}*
CHECK: *{"category":"scf-unroll","outcome":"structured","op":"scf.for","policy":"absent","trip_count_state":"exact","trip_count":2,"step":64,"lower_bound_kind":"dynamic",*"lower_range_min":0,"lower_range_max":63}*

