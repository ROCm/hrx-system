// RUN: pass combine

// Borrowed view dimensions retain their callable binding.
func.decl @consume(%width: index, %value: view<[%width]xf32>) -> (f32)

func.def public @caller(%width: index, %value: view<[%width]xf32>) -> (f32) {
  %empty_extent = index.constant 0 : index
  %positive = index.cmp sgt, %width, %empty_extent : index
  %result = scf.if %positive -> (f32) {
    %read = func.call @consume(%width, %value) : (index, view<[%width]xf32>) -> (f32)
    scf.yield %read : f32
  } else {
    %nothing = scalar.constant 0.0 : f32
    scf.yield %nothing : f32
  }
  func.return %result : f32
}

// ----
func.decl @consume(%width: index, %value: view<[%width]xf32>) -> (f32)

func.def public @caller(%width: index, %value: view<[%width]xf32>) -> (f32) {
  %empty_extent = index.constant 0 : index
  %positive = index.cmp sgt, %width, %empty_extent : index
  %result = scf.if %positive -> (f32) {
    %read = func.call @consume(%width, %value) : (index, view<[%width]xf32>) -> (f32)
    scf.yield %read : f32
  } else {
    %nothing = scalar.constant 0.0 : f32
    scf.yield %nothing : f32
  }
  func.return %result : f32
}

