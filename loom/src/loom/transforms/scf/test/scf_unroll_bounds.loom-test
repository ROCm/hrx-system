// RUN: pass unroll-scf-for,canonicalize,scf-to-cfg,vector-memory-footprint

func.def @dynamic_interleaved_tile_indices_remain_in_bounds(%payload: buffer, %base: offset, %end0: index, %value: i32) {
  %loop_begin = index.constant 0 : index
  %loop_step = index.constant 1 : index
  %unroll_factor = index.constant 4 : index
  %end = index.assume %end0 [range(%end0, 1, 32)] : index
  %view = buffer.view %payload[%base] : buffer -> view<[%end]xi32>
  scf.for %i = [%loop_begin to %end step %loop_step] unroll(%unroll_factor) schedule(interleaved) {
    view.store %value, %view[%i] : i32, view<[%end]xi32>
  }
  func.return
}

// ----
func.def @dynamic_interleaved_tile_indices_remain_in_bounds(%payload: buffer, %base: offset, %end0: index, %value: i32) {
  %loop_begin = index.constant 0 : index
  %loop_step = index.constant 1 : index
  %end = index.assume %end0 [range(%end0, 1, 32)] : index
  %view = buffer.view %payload[%base] : buffer -> view<[%end]xi32>
  %10 = index.constant 4 : index
  %30 = index.constant 2 : index
  %31 = index.shrui %end, %30 : index
  %16 = index.mul %31, %10 : index
  cfg.br ^_bb1(%loop_begin: index)
^_bb1(%36: index):
  %38 = index.cmp slt, %36, %16 : index
  cfg.cond_br %38, ^_bb2, ^_bb3
^_bb2:
  %37 = index.assume %36 [range(%36, 0, 28), multiple_of(%36, 4), lt(%36, %16)] : index
  %19 = index.constant 1 : index
  %20 = index.add %37, %19 : index
  %21 = index.constant 2 : index
  %22 = index.add %37, %21 : index
  %23 = index.constant 3 : index
  %24 = index.add %37, %23 : index
  %i$25, %i_1, %i_2, %i_3 = index.assume %37, %20, %22, %24 [range(%37, 0, 31), ge(%37, %loop_begin), lt(%37, %end), range(%20, 0, 31), ge(%20, %loop_begin), lt(%20, %end), range(%22, 0, 31), ge(%22, %loop_begin), lt(%22, %end), range(%24, 0, 31), ge(%24, %loop_begin), lt(%24, %end)] : index, index, index, index
  view.store %value, %view[%i$25] : i32, view<[%end]xi32>
  view.store %value, %view[%i_1] : i32, view<[%end]xi32>
  view.store %value, %view[%i_2] : i32, view<[%end]xi32>
  view.store %value, %view[%i_3] : i32, view<[%end]xi32>
  %39 = index.add %37, %10 : index
  cfg.br ^_bb1(%39: index)
^_bb3:
  cfg.br ^_bb4(%16: index)
^_bb4(%32: index):
  %34 = index.cmp slt, %32, %end : index
  cfg.cond_br %34, ^_bb5, ^_bb6
^_bb5:
  %i$33 = index.assume %32 [range(%32, 0, 31), ge(%32, %16), lt(%32, %end)] : index
  view.store %value, %view[%i$33] : i32, view<[%end]xi32>
  %35 = index.add %i$33, %loop_step : index
  cfg.br ^_bb4(%35: index)
^_bb6:
  func.return
}

// ====

// A ranged lane-derived lower bound has the same exact trip count at both
// endpoints. Strip-mining must preserve enough information to prove all four
// cloned vector origins, including the final packet at channel 2044.
func.def @ranged_lower_full_span_vector_origins(%payload: buffer, %base: offset, %lane0: index) {
  %lane = index.assume %lane0 [range(%lane0, 0, 31)] : index
  %vector_width = index.constant 4 : index
  %channel_start = index.mul %lane, %vector_width : index
  %channel_end = index.constant 2048 : index
  %channel_step = index.constant 128 : index
  %view = buffer.view %payload[%base] : buffer -> view<2048xf32>
  scf.for %channel = [%channel_start to %channel_end step %channel_step] unroll(%vector_width) schedule(interleaved) {
    %values = vector.load %view[%channel] : view<2048xf32> -> vector<4xf32>
    test.use %values : vector<4xf32>
  }
  func.return
}

// ----
func.def @ranged_lower_full_span_vector_origins(%payload: buffer, %base: offset, %lane0: index) {
  %lane = index.assume %lane0 [range(%lane0, 0, 31)] : index
  %vector_width = index.constant 4 : index
  %channel_start = index.mul %lane, %vector_width : index
  %channel_end = index.constant 2048 : index
  %view = buffer.view %payload[%base] : buffer -> view<2048xf32>
  %11 = index.constant 512 : index
  cfg.br ^_bb1(%channel_start: index)
^_bb1(%23: index):
  %25 = index.cmp slt, %23, %channel_end : index
  cfg.cond_br %25, ^_bb2, ^_bb4
^_bb2:
  %channel = index.assume %23 [range(%23, 0, 1660), multiple_of(%23, 4), ge(%23, %channel_start)] : index
  %13 = index.constant 128 : index
  %channel_128 = index.add %channel, %13 : index
  %15 = index.constant 256 : index
  %channel_256 = index.add %channel, %15 : index
  %17 = index.constant 384 : index
  %channel_384 = index.add %channel, %17 : index
  %values = vector.load %view[%channel] : view<2048xf32> -> vector<4xf32>
  test.use %values : vector<4xf32>
  %values_1 = vector.load %view[%channel_128] : view<2048xf32> -> vector<4xf32>
  test.use %values_1 : vector<4xf32>
  %values_2 = vector.load %view[%channel_256] : view<2048xf32> -> vector<4xf32>
  test.use %values_2 : vector<4xf32>
  %values_3 = vector.load %view[%channel_384] : view<2048xf32> -> vector<4xf32>
  test.use %values_3 : vector<4xf32>
  %26 = index.sub %channel_end, %channel : index
  %27 = index.cmp ult, %11, %26 : index
  cfg.cond_br %27, ^_bb3, ^_bb4
^_bb3:
  %28 = index.add %channel, %11 : index
  cfg.br ^_bb1(%28: index)
^_bb4:
  func.return
}

// ====

// Runtime empty and remainder domains use the same bounded count after
// strip-mining and canonicalization. Both scalar and vector origins retain
// their nonnegative range through the scheduled main loop and its tail.
func.def @dynamic_recurrence_nonunit_step(%payload: buffer, %base: offset, %end0: index) {
  %begin = index.constant 0 : index
  %step = index.constant 3 : index
  %factor = index.constant 2 : index
  %c0 = index.constant 0 : index
  %initial = scalar.constant 0 : i32
  %end = index.assume %end0 [range(%end0, 0, 17)] : index
  %view = buffer.view %payload[%base] : buffer -> view<17x4xi32>
  %total = scf.for %i = [%begin to %end step %step](%sum = %initial : i32) -> (i32) unroll(%factor) schedule(recurrence) {
    %packet = vector.load %view[%i, %c0] : view<17x4xi32> -> vector<4xi32>
    %value = view.load %view[%i, %c0] : view<17x4xi32> -> i32
    test.use %packet : vector<4xi32>
    %next = scalar.addi %sum, %value : i32
    scf.yield %next : i32
  }
  test.use %total : i32
  func.return
}

// ----
func.def @dynamic_recurrence_nonunit_step(%payload: buffer, %base: offset, %end0: index) {
  %begin = index.constant 0 : index
  %c0 = index.constant 0 : index
  %initial = scalar.constant 0 : i32
  %end = index.assume %end0 [range(%end0, 0, 17)] : index
  %view = buffer.view %payload[%base] : buffer -> view<17x4xi32>
  %16 = index.constant 6 : index
  %17 = index.constant 0 : index
  %19 = index.max %end, %17 : index
  %20 = index.constant 2 : index
  %21 = index.add %19, %20 : index
  %22 = index.constant 3 : index
  %23 = index.div %21, %22 : index
  %48 = index.constant 1 : index
  %49 = index.shrui %23, %48 : index
  %26 = index.mul %49, %16 : index
  cfg.br ^_bb1(%begin: index, %initial: i32)
^_bb1(%59: index, %sum$60: i32):
  %62 = index.cmp slt, %59, %26 : index
  cfg.cond_br %62, ^_bb2, ^_bb3
^_bb2:
  %61 = index.assume %59 [range(%59, 0, 12), multiple_of(%59, 6), lt(%59, %26)] : index
  %31 = index.constant 3 : index
  %32 = index.add %61, %31 : index
  %i$33, %i_3 = index.assume %61, %32 [range(%61, 0, 15), multiple_of(%61, 3), ge(%61, %begin), lt(%61, %end), range(%32, 0, 15), multiple_of(%32, 3), ge(%32, %begin), lt(%32, %end)] : index, index
  %packet$35 = vector.load %view[%i$33, %c0] : view<17x4xi32> -> vector<4xi32>
  %value$36 = view.load %view[%i$33, %c0] : view<17x4xi32> -> i32
  test.use %packet$35 : vector<4xi32>
  %packet_1 = vector.load %view[%i_3, %c0] : view<17x4xi32> -> vector<4xi32>
  %value_1 = view.load %view[%i_3, %c0] : view<17x4xi32> -> i32
  test.use %packet_1 : vector<4xi32>
  scf.schedule.fence
  %next$39 = scalar.addi %sum$60, %value$36 : i32
  scf.schedule.fence
  %next_1 = scalar.addi %next$39, %value_1 : i32
  %63 = index.add %61, %16 : index
  cfg.br ^_bb1(%63: index, %next_1: i32)
^_bb3:
  cfg.br ^_bb4(%sum$60: i32)
^_bb4(%58: i32):
  %41 = index.constant 3 : index
  cfg.br ^_bb5(%26: index, %58: i32)
^_bb5(%51: index, %sum$52: i32):
  %54 = index.cmp slt, %51, %end : index
  cfg.cond_br %54, ^_bb6, ^_bb9
^_bb6:
  %i$53 = index.assume %51 [range(%51, 0, 15), multiple_of(%51, 3), ge(%51, %26), lt(%51, %end)] : index
  %packet$45 = vector.load %view[%i$53, %c0] : view<17x4xi32> -> vector<4xi32>
  %value$46 = view.load %view[%i$53, %c0] : view<17x4xi32> -> i32
  test.use %packet$45 : vector<4xi32>
  %next$47 = scalar.addi %sum$52, %value$46 : i32
  %55 = index.sub %end, %i$53 : index
  %56 = index.cmp ult, %41, %55 : index
  cfg.cond_br %56, ^_bb7, ^_bb8
^_bb7:
  %57 = index.add %i$53, %41 : index
  cfg.br ^_bb5(%57: index, %next$47: i32)
^_bb8:
  cfg.br ^_bb10(%next$47: i32)
^_bb9:
  cfg.br ^_bb10(%sum$52: i32)
^_bb10(%total: i32):
  test.use %total : i32
  func.return
}

// ====
// RUN: pass unroll-scf-for,canonicalize

// A structured true edge proves the complete tile without duplicating its
// guard as an index.assume inside the branch.
func.def @guarded_full_tile_unroll(%remaining: index) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %tile_size = index.constant 8 : index
  %has_full_tile = index.cmp sge, %remaining, %tile_size : index
  scf.if %has_full_tile {
    %tile_end = index.min %remaining, %tile_size : index
    scf.for %i = [%begin to %tile_end step %step] unroll {
      test.use %i : index
    }
  }
  func.return
}

// ----
func.def @guarded_full_tile_unroll(%remaining: index) {
  %tile_size = index.constant 8 : index
  %has_full_tile = index.cmp sge, %remaining, %tile_size : index
  scf.if %has_full_tile {
    %i_0 = index.constant 0 : index
    test.use %i_0 : index
    %i_1 = index.constant 1 : index
    test.use %i_1 : index
    %i_2 = index.constant 2 : index
    test.use %i_2 : index
    %i_3 = index.constant 3 : index
    test.use %i_3 : index
    %i_4 = index.constant 4 : index
    test.use %i_4 : index
    %i_5 = index.constant 5 : index
    test.use %i_5 : index
    %i_6 = index.constant 6 : index
    test.use %i_6 : index
    %i_7 = index.constant 7 : index
    test.use %i_7 : index
  }
  func.return
}

// ====
// RUN: pass unroll-scf-for

// The complementary edge only bounds the tail; its trip count remains
// dynamic and cannot satisfy bare unroll.
func.def @partial_tile_unroll_remains_dynamic(%remaining: index) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %tile_size = index.constant 8 : index
  %has_full_tile = index.cmp sge, %remaining, %tile_size : index
  scf.if %has_full_tile {
    test.use %remaining : index
  } else {
    %tile_end = index.min %remaining, %tile_size : index
    // ERROR@+1: STRUCTURE/014 {attr_name="unroll", expected_constraint="exact static trip count"}
    scf.for %i = [%begin to %tile_end step %step] unroll {
      test.use %i : index
    }
  }
  func.return
}
