// ====

func.def @refines_cyclic_cfg_layout(%cond: i1, %buffer: buffer, %offset: offset) {
  %initial_layout = encoding.layout.dense : encoding<layout>
  %initial_view = buffer.view %buffer[%offset] : buffer -> view<4xf32, %initial_layout>
  cfg.br ^loop(%initial_layout: encoding<layout>, %initial_view: view<4xf32, %initial_layout>)
^loop(%layout: encoding<layout>, %view: view<4xf32, %layout>):
  cfg.cond_br %cond, ^body, ^done
^body:
  cfg.br ^loop(%layout: encoding<layout>, %view: view<4xf32, %layout>)
^done:
  test.use %view : view<4xf32, %layout>
  func.return
}

// ----
func.def @refines_cyclic_cfg_layout(%cond: i1, %buffer: buffer, %offset: offset) {
  %initial_layout = encoding.layout.dense : encoding<layout>
  %initial_view = buffer.view %buffer[%offset] : buffer -> view<4xf32>
  cfg.br ^loop(%initial_layout: encoding<layout>, %initial_view: view<4xf32>)
^loop(%layout: encoding<layout>, %view: view<4xf32>):
  cfg.cond_br %cond, ^body, ^done
^body:
  cfg.br ^loop(%layout: encoding<layout>, %view: view<4xf32>)
^done:
  test.use %view : view<4xf32>
  func.return
}

// ====

func.def @refines_common_switch_layout(%selector: index, %buffer: buffer, %case0_offset: offset, %case1_offset: offset, %default_offset: offset) {
  %layout, %view = scf.switch %selector -> (encoding<layout>, view<4xf32, %layout>) {
    case 0 {
      %case0_layout = encoding.layout.dense : encoding<layout>
      %case0_view = buffer.view %buffer[%case0_offset] : buffer -> view<4xf32, %case0_layout>
      test.use %case0_view : view<4xf32, %case0_layout>
      scf.yield %case0_layout, %case0_view : encoding<layout>, view<4xf32, %case0_layout>
    }
    case 2 {
      %case1_layout = encoding.layout.dense : encoding<layout>
      %case1_view = buffer.view %buffer[%case1_offset] : buffer -> view<4xf32, %case1_layout>
      test.use %case1_view : view<4xf32, %case1_layout>
      scf.yield %case1_layout, %case1_view : encoding<layout>, view<4xf32, %case1_layout>
    }
    default {
      %default_layout = encoding.layout.dense : encoding<layout>
      %default_view = buffer.view %buffer[%default_offset] : buffer -> view<4xf32, %default_layout>
      test.use %default_view : view<4xf32, %default_layout>
      scf.yield %default_layout, %default_view : encoding<layout>, view<4xf32, %default_layout>
    }
  }
  test.use %view : view<4xf32, %layout>
  func.return
}

// ----
func.def @refines_common_switch_layout(%selector: index, %buffer: buffer, %case0_offset: offset, %case1_offset: offset, %default_offset: offset) {
  %15 = index.constant 0 : index
  %16 = index.cmp eq, %selector, %15 : index
  cfg.cond_br %16, ^_bb2, ^_bb1
^_bb1:
  %17 = index.constant 2 : index
  %18 = index.cmp eq, %selector, %17 : index
  cfg.cond_br %18, ^_bb3, ^_bb4
^_bb2:
  %case0_layout = encoding.layout.dense : encoding<layout>
  %case0_view = buffer.view %buffer[%case0_offset] : buffer -> view<4xf32>
  test.use %case0_view : view<4xf32>
  cfg.br ^_bb5(%case0_layout: encoding<layout>, %case0_view: view<4xf32>)
^_bb3:
  %case1_layout = encoding.layout.dense : encoding<layout>
  %case1_view = buffer.view %buffer[%case1_offset] : buffer -> view<4xf32>
  test.use %case1_view : view<4xf32>
  cfg.br ^_bb5(%case1_layout: encoding<layout>, %case1_view: view<4xf32>)
^_bb4:
  %default_layout = encoding.layout.dense : encoding<layout>
  %default_view = buffer.view %buffer[%default_offset] : buffer -> view<4xf32>
  test.use %default_view : view<4xf32>
  cfg.br ^_bb5(%default_layout: encoding<layout>, %default_view: view<4xf32>)
^_bb5(%layout: encoding<layout>, %view: view<4xf32>):
  test.use %view : view<4xf32>
  func.return
}
