func.def @refines_common_region_layout(%cond: i1, %buffer: buffer, %then_offset: offset, %else_offset: offset) {
  %layout, %view = scf.if %cond -> (encoding<layout>, view<4xf32, %layout>) {
    %then_layout = encoding.layout.dense : encoding<layout>
    %then_view = buffer.view %buffer[%then_offset] : buffer -> view<4xf32, %then_layout>
    test.use %then_view : view<4xf32, %then_layout>
    scf.yield %then_layout, %then_view : encoding<layout>, view<4xf32, %then_layout>
  } else {
    %else_layout = encoding.layout.dense : encoding<layout>
    %else_view = buffer.view %buffer[%else_offset] : buffer -> view<4xf32, %else_layout>
    test.use %else_view : view<4xf32, %else_layout>
    scf.yield %else_layout, %else_view : encoding<layout>, view<4xf32, %else_layout>
  }
  test.use %view : view<4xf32, %layout>
  func.return
}

// ----
func.def @refines_common_region_layout(%cond: i1, %buffer: buffer, %then_offset: offset, %else_offset: offset) {
  cfg.cond_br %cond, ^_bb1, ^_bb2
^_bb1:
  %then_view = buffer.view %buffer[%then_offset] : buffer -> view<4xf32>
  test.use %then_view : view<4xf32>
  cfg.br ^_bb3(%then_view: view<4xf32>)
^_bb2:
  %else_view = buffer.view %buffer[%else_offset] : buffer -> view<4xf32>
  test.use %else_view : view<4xf32>
  cfg.br ^_bb3(%else_view: view<4xf32>)
^_bb3(%view: view<4xf32>):
  test.use %view : view<4xf32>
  func.return
}

