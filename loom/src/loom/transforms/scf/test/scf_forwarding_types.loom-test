// RUN: pass canonicalize,scf-to-cfg,canonicalize

func.def @preserves_branch_dependent_layouts(%cond: i1, %buffer: buffer, %offset: offset) {
  %dense, %view = scf.if %cond -> (encoding<layout>, view<4xf32, %dense>) {
    %then_layout = encoding.layout.dense : encoding<layout>
    %then_view = buffer.view %buffer[%offset] : buffer -> view<4xf32, %then_layout>
    scf.yield %then_layout, %then_view : encoding<layout>, view<4xf32, %then_layout>
  } else {
    %else_layout = encoding.layout.strided [1] : encoding<layout>
    %else_view = buffer.view %buffer[%offset] : buffer -> view<4xf32, %else_layout>
    scf.yield %else_layout, %else_view : encoding<layout>, view<4xf32, %else_layout>
  }
  test.use %view : view<4xf32, %dense>
  func.return
}

// ----
func.def @preserves_branch_dependent_layouts(%cond: i1, %buffer: buffer, %offset: offset) {
  cfg.cond_br %cond, ^_bb1, ^_bb2
^_bb1:
  %then_layout = encoding.layout.dense : encoding<layout>
  %then_view = buffer.view %buffer[%offset] : buffer -> view<4xf32, %then_layout>
  cfg.br ^_bb3(%then_layout: encoding<layout>, %then_view: view<4xf32, %then_layout>)
^_bb2:
  %else_layout = encoding.layout.strided [1] : encoding<layout>
  %else_view = buffer.view %buffer[%offset] : buffer -> view<4xf32, %else_layout>
  cfg.br ^_bb3(%else_layout: encoding<layout>, %else_view: view<4xf32, %else_layout>)
^_bb3(%dense: encoding<layout>, %view: view<4xf32, %dense>):
  test.use %view : view<4xf32, %dense>
  func.return
}

// ====

func.def @refines_common_cfg_layout(%cond: i1, %buffer: buffer, %offset: offset) {
  cfg.cond_br %cond, ^then, ^else
^then:
  %then_layout = encoding.layout.dense : encoding<layout>
  %then_view = buffer.view %buffer[%offset] : buffer -> view<4xf32, %then_layout>
  cfg.br ^join(%then_layout: encoding<layout>, %then_view: view<4xf32, %then_layout>)
^else:
  %else_layout = encoding.layout.dense : encoding<layout>
  %else_view = buffer.view %buffer[%offset] : buffer -> view<4xf32, %else_layout>
  cfg.br ^join(%else_layout: encoding<layout>, %else_view: view<4xf32, %else_layout>)
^join(%layout: encoding<layout>, %view: view<4xf32, %layout>):
  test.use %view : view<4xf32, %layout>
  func.return
}

