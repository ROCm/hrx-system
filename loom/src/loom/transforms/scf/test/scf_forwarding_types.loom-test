func.def @refines_common_region_layout_with_external_dimension(%cond: i1, %size: index, %buffer: buffer, %then_offset: offset, %else_offset: offset) {
  %layout, %view = scf.if %cond -> (encoding<layout>, view<[%size]xf32, %layout>) {
    %then_layout = encoding.layout.dense : encoding<layout>
    %then_view = buffer.view %buffer[%then_offset] : buffer -> view<[%size]xf32, %then_layout>
    scf.yield %then_layout, %then_view : encoding<layout>, view<[%size]xf32, %then_layout>
  } else {
    %else_layout = encoding.layout.dense : encoding<layout>
    %else_view = buffer.view %buffer[%else_offset] : buffer -> view<[%size]xf32, %else_layout>
    scf.yield %else_layout, %else_view : encoding<layout>, view<[%size]xf32, %else_layout>
  }
  test.use %view : view<[%size]xf32, %layout>
  func.return
}

// ----
func.def @refines_common_region_layout_with_external_dimension(%cond: i1, %size: index, %buffer: buffer, %then_offset: offset, %else_offset: offset) {
  %16 = scf.select %cond, %then_offset, %else_offset : offset
  %view = buffer.view %buffer[%16] : buffer -> view<[%size]xf32>
  test.use %view : view<[%size]xf32>
  func.return
}

// ====

func.def @preserves_branch_dependent_dimensions(%cond: i1, %buffer: buffer, %offset: offset) {
  %size, %view = scf.if %cond -> (index, view<[%size]xf32>) {
    %then_size = index.constant 4 : index
    %then_view = buffer.view %buffer[%offset] : buffer -> view<[%then_size]xf32>
    scf.yield %then_size, %then_view : index, view<[%then_size]xf32>
  } else {
    %else_size = index.constant 8 : index
    %else_view = buffer.view %buffer[%offset] : buffer -> view<[%else_size]xf32>
    scf.yield %else_size, %else_view : index, view<[%else_size]xf32>
  }
  test.use %view : view<[%size]xf32>
  func.return
}

// ----
func.def @preserves_branch_dependent_dimensions(%cond: i1, %buffer: buffer, %offset: offset) {
  cfg.cond_br %cond, ^_bb1, ^_bb2
^_bb1:
  %then_size = index.constant 4 : index
  %then_view = buffer.view %buffer[%offset] : buffer -> view<[%then_size]xf32>
  cfg.br ^_bb3(%then_size: index, %then_view: view<[%then_size]xf32>)
^_bb2:
  %else_size = index.constant 8 : index
  %else_view = buffer.view %buffer[%offset] : buffer -> view<[%else_size]xf32>
  cfg.br ^_bb3(%else_size: index, %else_view: view<[%else_size]xf32>)
^_bb3(%size: index, %view: view<[%size]xf32>):
  test.use %view : view<[%size]xf32>
  func.return
}

