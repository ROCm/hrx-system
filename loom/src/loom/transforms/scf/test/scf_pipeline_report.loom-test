// ====
// RUN: with-checks pass-report pipeline-scf-for

// A ragged outer loop enters its body only while a complete tile remains.
// Conditioned facts make the derived tile bound exact, preserving collective
// participation without an authored assumption in the body.
func.def @conditioned_full_tile_collective(%input: view<8xi32>, %initial: i32, %remaining: index) -> (index) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %depth = index.constant 2 : index
  %tile_size = index.constant 8 : index
  %terminal = scf.while(%before_remaining = %remaining : index) -> (index) {
    %has_full_tile = index.cmp sge, %before_remaining, %tile_size : index
    scf.condition %has_full_tile, %before_remaining : i1, index
  } do(%active_remaining: index) {
    %tile_end = index.min %active_remaining, %tile_size : index
    %sum = scf.for %i = [%begin to %tile_end step %step](%acc = %initial : i32) -> (i32) pipeline(%depth) {
      %value = view.load %input[%i] : view<8xi32> -> i32
      %collective = test.convergent %value : i32
      %next = scalar.addi %acc, %collective : i32
      scf.yield %next : i32
    }
    test.use %sum : i32
    %next_remaining = index.sub %active_remaining, %tile_size : index
    scf.yield %next_remaining : index
  }
  func.return %terminal : index
}

