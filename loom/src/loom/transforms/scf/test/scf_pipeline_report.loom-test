CHECK: *"values_per_record":2,"read_count":1*
CHECK: *"position":0,"op":"index.add","stage":"producer","iteration_lookahead":2*
CHECK: *"position":0,"op":"index.add","stage":"consumer","iteration_lookahead":0*

// ====

// A fused guarded update exposes both copies of the authored conditional and
// accounts for its queued predicate and payload.
func.def @inspect_guarded_partition(%input: view<64xf32>, %end: index, %valid_count: index, %initial: f32) -> (f32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %depth = index.constant 3 : index
  %result = scf.for %i = [%begin to %end step %step](%sum = %initial : f32) -> (f32) pipeline(%depth) {
    %valid = index.cmp slt, %i, %valid_count : index
    %next = scf.if %valid -> (f32) {
      %loaded = view.load %input[%i] : view<64xf32> -> f32
      %updated = scalar.addf %sum, %loaded : f32
      scf.yield %updated : f32
    } else {
      scf.yield %sum : f32
    }
    scf.yield %next : f32
  }
  func.return %result : f32
}

