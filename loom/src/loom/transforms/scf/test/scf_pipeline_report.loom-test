CHECK: *{"category":"scf-pipeline-stage","loop":0,"position":0,"op":"view.load","stage":"producer","iteration_lookahead":1}*
CHECK: *{"category":"scf-pipeline-stage","loop":0,"position":1,"op":"test.convergent","stage":"consumer","iteration_lookahead":0}*
CHECK: *{"category":"scf-pipeline-stage","loop":0,"position":2,"op":"scalar.addi","stage":"consumer","iteration_lookahead":0}*

// ====

// Independent guarded updates retain separate branch partitions in one linear
// source schedule.
func.def @inspect_multiple_guarded_partitions(%left: view<8xf32>, %right: view<8xf32>, %initial: f32, %left_valid: i1, %right_valid: i1) -> (f32) {
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %depth = index.constant 2 : index
  %result = scf.for %i = [%begin to %end step %step](%sum = %initial : f32) -> (f32) pipeline(%depth) {
    %after_left = scf.if %left_valid -> (f32) {
      %loaded = view.load %left[%i] : view<8xf32> -> f32
      %updated = scalar.addf %sum, %loaded : f32
      scf.yield %updated : f32
    } else {
      scf.yield %sum : f32
    }
    %after_right = scf.if %right_valid -> (f32) {
      %loaded = view.load %right[%i] : view<8xf32> -> f32
      %updated = scalar.addf %after_left, %loaded : f32
      scf.yield %updated : f32
    } else {
      scf.yield %after_left : f32
    }
    scf.yield %after_right : f32
  }
  func.return %result : f32
}

