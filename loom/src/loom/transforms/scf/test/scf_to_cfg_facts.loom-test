// RUN: with-checks pass scf-to-cfg,canonicalize,dce

// scf.for materializes its structured IV facts on the lowered body value. A
// fresh CFG fact solve must recover the exact body range and divisor from that
// boundary instead of depending on the removed structured op.
func.def @for_body_facts_survive_lowering() {
  %begin = index.constant 4 : index
  %end = index.constant 12 : index
  %step = index.constant 2 : index
  scf.for %position = [%begin to %end step %step] {
    %lo = test.fact_range_lo %position : index -> i64
    %hi = test.fact_range_hi %position : index -> i64
    %divisor = test.fact_divisor %position : index -> i64
    test.use %lo, %hi, %divisor : i64, i64, i64
  }
  func.return
}

// ----
CHECK: func.def @for_body_facts_survive_lowering*
CHECK: %position = index.assume *[range(*, 4, 10), multiple_of(*, 2)] : index
CHECK: %lo = scalar.constant 4 : i64
CHECK: %hi = scalar.constant 10 : i64
CHECK: %divisor = scalar.constant 2 : i64
CHECK-NOT: *test.fact_*
CHECK-NOT: *scf.*

// ====

// The controlling value is the second loop-carried argument. Loading an
// unrelated payload on every backedge must not poison the counter recurrence.
func.def @while_control_facts_ignore_loaded_payload(%links: view<1xi32>, %seed: i32) {
  %begin = index.constant 2 : index
  %end = index.constant 9 : index
  %step = index.constant 3 : index
  %link_index = index.constant 0 : index
  %last_payload, %terminal = scf.while(%payload = %seed : i32, %counter = %begin : index) -> (i32, index) {
    %header_lo = test.fact_range_lo %counter : index -> i64
    %header_hi = test.fact_range_hi %counter : index -> i64
    test.use %header_lo, %header_hi : i64, i64
    %more = index.cmp slt, %counter, %end : index
    scf.condition %more, %payload, %counter : i1, i32, index
  } do(%body_payload: i32, %position: index) {
    %next_payload = view.load %links[%link_index] : view<1xi32> -> i32
    %next = index.add %position, %step : index
    scf.yield %next_payload, %next : i32, index
  }
  test.use %last_payload : i32
  test.use %terminal : index
  func.return
}

// ----
CHECK: func.def @while_control_facts_ignore_loaded_payload*
CHECK: %header_lo = scalar.constant 2 : i64
CHECK: %header_hi = scalar.constant 11 : i64
CHECK: %next_payload = view.load *
CHECK-NOT: *test.fact_*
CHECK-NOT: *scf.*

// ====

// A load that supplies the next controlling value is a true data recurrence.
// Lowering must not turn its initializer and guard into a fixed-step range.
func.def @while_loaded_control_remains_unknown(%links: view<1xi64>) {
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %link_index = index.constant 0 : index
  %terminal = scf.while(%counter = %begin : index) -> (index) {
    %header_lo = test.fact_range_lo %counter : index -> i64
    %header_hi = test.fact_range_hi %counter : index -> i64
    test.use %header_lo, %header_hi : i64, i64
    %more = index.cmp slt, %counter, %end : index
    scf.condition %more, %counter : i1, index
  } do(%position: index) {
    %loaded = view.load %links[%link_index] : view<1xi64> -> i64
    %next = index.cast %loaded : i64 to index
    scf.yield %next : index
  }
  test.use %terminal : index
  func.return
}

// ----
CHECK: func.def @while_loaded_control_remains_unknown*
CHECK: %header_lo = scalar.constant -9223372036854775808 : i64
CHECK: %header_hi = scalar.constant 9223372036854775807 : i64
CHECK: %loaded = view.load *
CHECK-NOT: *test.fact_*
CHECK-NOT: *scf.*

// ====

// An alternate loaded update remains visible after the nested scf.if is
// lowered. The merged backedge is not a fixed recurrence even though its other
// arm increments by a constant step.
func.def @conditional_loaded_control_remains_unknown(%links: view<1xi64>, %take_loaded: i1) {
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %link_index = index.constant 0 : index
  %terminal = scf.while(%counter = %begin : index) -> (index) {
    %header_lo = test.fact_range_lo %counter : index -> i64
    %header_hi = test.fact_range_hi %counter : index -> i64
    test.use %header_lo, %header_hi : i64, i64
    %more = index.cmp slt, %counter, %end : index
    scf.condition %more, %counter : i1, index
  } do(%position: index) {
    %next = scf.if %take_loaded -> (index) {
      %loaded = view.load %links[%link_index] : view<1xi64> -> i64
      %loaded_index = index.cast %loaded : i64 to index
      scf.yield %loaded_index : index
    } else {
      %incremented = index.add %position, %step : index
      scf.yield %incremented : index
    }
    scf.yield %next : index
  }
  test.use %terminal : index
  func.return
}

// ----
CHECK: func.def @conditional_loaded_control_remains_unknown*
CHECK: %header_lo = scalar.constant -9223372036854775808 : i64
CHECK: %header_hi = scalar.constant 9223372036854775807 : i64
CHECK: cfg.cond_br %take_loaded, *
CHECK-NOT: *test.fact_*
CHECK-NOT: *scf.*

// ====

// Both natural loops must be rediscovered from the generated CFG. The inner
// loop cannot hide or widen the outer recurrence.
func.def @nested_while_facts_survive_lowering() {
  %begin = index.constant 0 : index
  %outer_end = index.constant 2 : index
  %inner_end = index.constant 3 : index
  %step = index.constant 1 : index
  %outer_terminal = scf.while(%outer_before = %begin : index) -> (index) {
    %outer_lo = test.fact_range_lo %outer_before : index -> i64
    %outer_hi = test.fact_range_hi %outer_before : index -> i64
    test.use %outer_lo, %outer_hi : i64, i64
    %outer_more = index.cmp slt, %outer_before, %outer_end : index
    scf.condition %outer_more, %outer_before : i1, index
  } do(%outer: index) {
    %inner_terminal = scf.while(%inner_before = %begin : index) -> (index) {
      %inner_lo = test.fact_range_lo %inner_before : index -> i64
      %inner_hi = test.fact_range_hi %inner_before : index -> i64
      test.use %inner_lo, %inner_hi : i64, i64
      %inner_more = index.cmp slt, %inner_before, %inner_end : index
      scf.condition %inner_more, %inner_before : i1, index
    } do(%inner: index) {
      %inner_next = index.add %inner, %step : index
      scf.yield %inner_next : index
    }
    test.use %inner_terminal : index
    %outer_next = index.add %outer, %step : index
    scf.yield %outer_next : index
  }
  test.use %outer_terminal : index
  func.return
}

// ----
CHECK: func.def @nested_while_facts_survive_lowering*
CHECK: %outer_lo = scalar.constant 0 : i64
CHECK: %outer_hi = scalar.constant 2 : i64
CHECK: %inner_lo = scalar.constant 0 : i64
CHECK: %inner_hi = scalar.constant 3 : i64
CHECK-NOT: *test.fact_*
CHECK-NOT: *scf.*

// ====

// A false initial guard has no live backedge. The generated CFG retains the
// exact entry value at both the loop header and the forwarded loop result.
func.def @zero_trip_facts_survive_lowering() -> (i64, i64) {
  %begin = index.constant 5 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %terminal = scf.while(%counter = %begin : index) -> (index) {
    %header_lo = test.fact_range_lo %counter : index -> i64
    %header_hi = test.fact_range_hi %counter : index -> i64
    test.use %header_lo, %header_hi : i64, i64
    %more = index.cmp slt, %counter, %end : index
    scf.condition %more, %counter : i1, index
  } do(%position: index) {
    %next = index.add %position, %step : index
    scf.yield %next : index
  }
  %terminal_lo = test.fact_range_lo %terminal : index -> i64
  %terminal_hi = test.fact_range_hi %terminal : index -> i64
  func.return %terminal_lo, %terminal_hi : i64, i64
}

// ----
CHECK: func.def @zero_trip_facts_survive_lowering*
CHECK: %header_lo = scalar.constant 5 : i64
CHECK: %header_hi = scalar.constant 5 : i64
CHECK: %terminal_lo = scalar.constant 5 : i64
CHECK: %terminal_hi = scalar.constant 5 : i64
CHECK-NOT: *test.fact_*
CHECK-NOT: *scf.*

// ====

// RUN: with-checks pass unroll-scf-for,scf-to-cfg,canonicalize,dce

// Pair unrolling makes each backedge a two-add chain. Lowering preserves the
// distinct body and exit observations proven by the structured loop: body
// ranges exclude the terminal update, and exact-count exits remain exact.
test.target<low_core> @narrow {index_bitwidth = 32, offset_bitwidth = 32}

func.def target(@narrow) @paired_byte_stream_facts_survive_lowering() {
  %begin = index.constant 0 : index
  %end = index.constant 8 : index
  %step = index.constant 1 : index
  %pair_factor = index.constant 2 : index
  %origin = index.constant 0 : offset
  %a_tile_bytes = index.constant 128 : offset
  %b_tile_bytes = index.constant 256 : offset
  %a_end, %b_end = scf.for %tile = [%begin to %end step %step](%a = %origin : offset, %b = %origin : offset) -> (offset, offset) unroll(%pair_factor) {
    %a_lo = test.fact_range_lo %a : offset -> i64
    %a_hi = test.fact_range_hi %a : offset -> i64
    %a_divisor = test.fact_divisor %a : offset -> i64
    %b_lo = test.fact_range_lo %b : offset -> i64
    %b_hi = test.fact_range_hi %b : offset -> i64
    %b_divisor = test.fact_divisor %b : offset -> i64
    test.use %a_lo, %a_hi, %a_divisor, %b_lo, %b_hi, %b_divisor : i64, i64, i64, i64, i64, i64
    %a_next = index.add %a, %a_tile_bytes : offset
    %b_next = index.add %b, %b_tile_bytes : offset
    scf.yield %a_next, %b_next : offset, offset
  }
  %a_end_lo = test.fact_range_lo %a_end : offset -> i64
  %a_end_hi = test.fact_range_hi %a_end : offset -> i64
  %b_end_lo = test.fact_range_lo %b_end : offset -> i64
  %b_end_hi = test.fact_range_hi %b_end : offset -> i64
  test.use %a_end_lo, %a_end_hi, %b_end_lo, %b_end_hi : i64, i64, i64, i64
  func.return
}

// ----
CHECK: func.def target(@narrow) @paired_byte_stream_facts_survive_lowering*
CHECK: * = index.assume *[range(*, 0, 6), multiple_of(*, 2), range(*, 0, 768), multiple_of(*, 256), range(*, 0, 1536), multiple_of(*, 512)] : index, offset, offset
CHECK: %a_hi = scalar.constant 768 : i64
CHECK: %a_divisor = scalar.constant 256 : i64
CHECK: %b_hi = scalar.constant 1536 : i64
CHECK: %b_divisor = scalar.constant 512 : i64
CHECK: %a_hi_1 = scalar.constant 896 : i64
CHECK: %a_divisor_1 = scalar.constant 128 : i64
CHECK: %b_hi_1 = scalar.constant 1792 : i64
CHECK: %b_divisor_1 = scalar.constant 256 : i64
CHECK: %a_end_lo = scalar.constant 1024 : i64
CHECK: %a_end_hi = scalar.constant 1024 : i64
CHECK: %b_end_lo = scalar.constant 2048 : i64
CHECK: %b_end_hi = scalar.constant 2048 : i64
CHECK-NOT: *test.fact_*
CHECK-NOT: *scf.*

// ====

// RUN: with-checks pass scf-to-cfg

// Every fixed-width integer carrier uses one shared scalar fact identity.
// Floating-point and reference state remain outside the integer fact family.
func.def @for_integer_carrier_family(%floating_seed: f32, %view_seed: view<1xi32>) {
  %begin = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  %flag_seed = scalar.constant true : i1
  %byte_seed = scalar.constant 2 : i8
  %half_seed = scalar.constant 4 : i16
  %word_seed = scalar.constant 8 : i32
  %wide_seed = scalar.constant 16 : i64
  %flag_end, %byte_end, %half_end, %word_end, %wide_end, %floating_end, %view_end = scf.for %position = [%begin to %end step %step](%flag = %flag_seed : i1, %byte = %byte_seed : i8, %half = %half_seed : i16, %word = %word_seed : i32, %wide = %wide_seed : i64, %floating = %floating_seed : f32, %view = %view_seed : view<1xi32>) -> (i1, i8, i16, i32, i64, f32, view<1xi32>) {
    test.use %position, %flag, %byte, %half, %word, %wide, %floating, %view : index, i1, i8, i16, i32, i64, f32, view<1xi32>
    scf.yield %flag, %byte, %half, %word, %wide, %floating, %view : i1, i8, i16, i32, i64, f32, view<1xi32>
  }
  test.use %flag_end, %byte_end, %half_end, %word_end, %wide_end, %floating_end, %view_end : i1, i8, i16, i32, i64, f32, view<1xi32>
  func.return
}

// ----
CHECK: func.def @for_integer_carrier_family*
CHECK: * = scalar.assume * : i1, i8, i16, i32, i64
CHECK-NOT: *scalar.assume* : f32*
CHECK-NOT: *scf.*

// ====

// RUN: with-checks pass scf-to-cfg,canonicalize,dce

// Floating-point format/class and view-reference facts are reconstructed from
// CFG value semantics without integer assumption predicates.
func.def @noninteger_facts_survive_lowering(%count: index, %input: i8) {
  %begin = index.constant 0 : index
  %bounded_count = index.assume %count [range(%count, 1, 4)] : index
  %step = index.constant 1 : index
  %base = index.constant 0 : offset
  %second = index.constant 128 : offset
  %bytes = index.constant 256 : offset
  %scratch = buffer.alloca<workgroup> align(64) %bytes : buffer
  %first = buffer.view %scratch[%base] : buffer -> view<32xi32>
  %next = buffer.view %scratch[%second] : buffer -> view<32xi32>
  %initial = scalar.sitofp %input : i8 to f32
  %final_float, %last, %spare = scf.for %record = [%begin to %bounded_count step %step](%carried = %initial : f32, %current = %first : view<32xi32>, %following = %next : view<32xi32>) -> (f32, view<32xi32>, view<32xi32>) {
    %body_types = test.fact_exact_float_types %carried : f32 -> i64
    %body_not_subnormal = test.fact_not_subnormal %carried : f32 -> i1
    %body_space = test.fact_view_memory_space %current : view<32xi32> -> i64
    %body_length = test.fact_view_byte_length_hi %current : view<32xi32> -> i64
    test.use %body_types, %body_not_subnormal, %body_space, %body_length : i64, i1, i64, i64
    %next_float = scalar.negf %carried : f32
    scf.yield %next_float, %following, %current : f32, view<32xi32>, view<32xi32>
  }
  %final_types = test.fact_exact_float_types %final_float : f32 -> i64
  %final_not_subnormal = test.fact_not_subnormal %final_float : f32 -> i1
  %final_space = test.fact_view_memory_space %last : view<32xi32> -> i64
  %final_length = test.fact_view_byte_length_hi %last : view<32xi32> -> i64
  test.use %final_types, %final_not_subnormal, %final_space, %final_length, %spare : i64, i1, i64, i64, view<32xi32>
  func.return
}

// ----
CHECK: func.def @noninteger_facts_survive_lowering*
CHECK: %body_types = scalar.constant 15360 : i64
CHECK: %body_not_subnormal = scalar.constant true : i1
CHECK: %body_space = scalar.constant 2 : i64
CHECK: %body_length = scalar.constant 128 : i64
CHECK: %final_types = scalar.constant 15360 : i64
CHECK: %final_not_subnormal = scalar.constant true : i1
CHECK: %final_space = scalar.constant 2 : i64
CHECK: %final_length = scalar.constant 128 : i64
CHECK-NOT: *test.fact_*
CHECK-NOT: *scf.*

// ====

// RUN: with-checks pass scf-to-cfg,canonicalize,dce

// CFG joins recover execution-scope facts on lowered loop arguments.
target.generic<reference> @device {abi = hal_kernel, subgroup_size = 64}

kernel.def target(@device) @distribution_facts_survive_lowering() {
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %size = index.constant 128 : index
  kernel.launch.config workgroups(%c4, %c1, %c1) workgroup_size(%size, %c1, %c1) : index
} launch(%variant: index) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %selector = kernel.subgroup.lane.id : index
  %injected = index.add %selector, %step : index
  %result = scf.for %iteration = [%begin to %selector step %step](%carried = %begin : index) -> (index) {
    %body_uniform = test.fact_subgroup_uniform %carried : index -> i1
    %body_varying = test.fact_lane_varying %carried : index -> i1
    test.use %body_uniform, %body_varying : i1, i1
    scf.yield %injected : index
  }
  %result_uniform = test.fact_subgroup_uniform %result : index -> i1
  %result_varying = test.fact_lane_varying %result : index -> i1
  test.use %result_uniform, %result_varying : i1, i1
  kernel.return
}

// ----
CHECK: kernel.def target(@device) @distribution_facts_survive_lowering*
CHECK: %body_uniform = scalar.constant false : i1
CHECK: %body_varying = scalar.constant true : i1
CHECK: %result_uniform = scalar.constant false : i1
CHECK: %result_varying = scalar.constant true : i1
CHECK-NOT: *test.fact_*
CHECK-NOT: *scf.*

// ====

// RUN: with-checks pass scf-to-cfg,canonicalize,dce

// scf.while transports independently proven body and exit observations across
// reordered address and scalar state.
func.def @while_body_and_exit_facts_survive_lowering() {
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %origin = index.constant 0 : offset
  %half_tile_bytes = index.constant 64 : offset
  %descending_seed = scalar.constant 48 : i32
  %descending_step = scalar.constant 8 : i32
  %descending_end, %cursor_end, %iteration_end = scf.while(%header_cursor = %origin : offset, %header_iteration = %begin : index, %header_descending = %descending_seed : i32) -> (i32, offset, index) {
    %more = index.cmp slt, %header_iteration, %end : index
    scf.condition %more, %header_descending, %header_cursor, %header_iteration : i1, i32, offset, index
  } do(%descending: i32, %cursor: offset, %iteration: index) {
    %cursor_hi = test.fact_range_hi %cursor : offset -> i64
    %cursor_divisor = test.fact_divisor %cursor : offset -> i64
    %descending_lo = test.fact_range_lo %descending : i32 -> i64
    test.use %cursor_hi, %cursor_divisor, %descending_lo : i64, i64, i64
    %cursor_middle = index.add %cursor, %half_tile_bytes : offset
    %cursor_next = index.add %cursor_middle, %half_tile_bytes : offset
    %iteration_next = index.add %iteration, %step : index
    %descending_next = scalar.subi %descending, %descending_step : i32
    scf.yield %cursor_next, %iteration_next, %descending_next : offset, index, i32
  }
  %cursor_end_lo = test.fact_range_lo %cursor_end : offset -> i64
  %cursor_end_hi = test.fact_range_hi %cursor_end : offset -> i64
  %descending_end_lo = test.fact_range_lo %descending_end : i32 -> i64
  %descending_end_hi = test.fact_range_hi %descending_end : i32 -> i64
  test.use %cursor_end_lo, %cursor_end_hi, %descending_end_lo, %descending_end_hi, %iteration_end : i64, i64, i64, i64, index
  func.return
}

// ----
CHECK: func.def @while_body_and_exit_facts_survive_lowering*
CHECK: %cursor_hi = scalar.constant 384 : i64
CHECK: %cursor_divisor = scalar.constant 128 : i64
CHECK: %descending_lo = scalar.constant 24 : i64
CHECK: %cursor_end_lo = scalar.constant 512 : i64
CHECK: %cursor_end_hi = scalar.constant 512 : i64
CHECK: %descending_end_lo = scalar.constant 16 : i64
CHECK: %descending_end_hi = scalar.constant 16 : i64
CHECK-NOT: *test.fact_*
CHECK-NOT: *scf.*

// ====

// RUN: pass scf-to-cfg,canonicalize,dce

// A dynamic upper bound must not erase the independently proven lower bound.
func.def @dynamic_index_bound_preserves_nonnegative_body(%end: index) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  scf.for %position = [%begin to %end step %step] {
    %lo = test.fact_range_lo %position : index -> i64
    %hi = test.fact_range_hi %position : index -> i64
    test.use %lo, %hi : i64, i64
  }
  func.return
}

// ----
func.def @dynamic_index_bound_preserves_nonnegative_body(%end: index) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  cfg.br ^_bb1(%begin: index)
^_bb1(%6: index):
  %8 = index.cmp slt, %6, %end : index
  cfg.cond_br %8, ^_bb2, ^_bb3
^_bb2:
  %position = index.assume %6 [range(%6, 0, 9223372036854775806), lt(%6, %end)] : index
  %lo = scalar.constant 0 : i64
  %hi = scalar.constant 9223372036854775806 : i64
  test.use %lo, %hi : i64, i64
  %9 = index.add %position, %step : index
  cfg.br ^_bb1(%9: index)
^_bb3:
  func.return
}

// ====

// RUN: pass scf-to-cfg,canonicalize,dce

// Byte offsets retain the same producer-owned body facts and divisibility.
func.def @dynamic_offset_bound_preserves_body_range(%end_input: offset) {
  %end = index.assume %end_input [range(%end_input, 8, 9223372036854775807)] : offset
  %begin = index.constant 8 : offset
  %step = index.constant 2 : offset
  scf.for %position = [%begin to %end step %step] {
    %lo = test.fact_range_lo %position : offset -> i64
    %hi = test.fact_range_hi %position : offset -> i64
    %divisor = test.fact_divisor %position : offset -> i64
    test.use %lo, %hi, %divisor : i64, i64, i64
  }
  func.return
}

// ----
func.def @dynamic_offset_bound_preserves_body_range(%end_input: offset) {
  %end = index.assume %end_input [range(%end_input, 8, 9223372036854775807)] : offset
  %begin = index.constant 8 : offset
  %step = index.constant 2 : offset
  cfg.br ^_bb1(%begin: offset)
^_bb1(%8: offset):
  %10 = index.cmp ult, %8, %end : offset
  cfg.cond_br %10, ^_bb2, ^_bb4
^_bb2:
  %position = index.assume %8 [range(%8, 8, 9223372036854775806), multiple_of(%8, 2), lt(%8, %end)] : offset
  %lo = scalar.constant 8 : i64
  %hi = scalar.constant 9223372036854775806 : i64
  %divisor = scalar.constant 2 : i64
  test.use %lo, %hi, %divisor : i64, i64, i64
  %11 = index.sub %end, %position : offset
  %12 = index.cmp ult, %step, %11 : offset
  cfg.cond_br %12, ^_bb3, ^_bb4
^_bb3:
  %13 = index.add %position, %step : offset
  cfg.br ^_bb1(%13: offset)
^_bb4:
  func.return
}

// ====

// RUN: pass scf-to-cfg,canonicalize,dce

// Retention preserves the actual signed bound; it cannot invent nonnegativity.
func.def @dynamic_index_bound_preserves_negative_body(%end: index) {
  %begin = index.constant -17 : index
  %step = index.constant 1 : index
  scf.for %position = [%begin to %end step %step] {
    %lo = test.fact_range_lo %position : index -> i64
    %hi = test.fact_range_hi %position : index -> i64
    test.use %lo, %hi : i64, i64
  }
  func.return
}

// ----
func.def @dynamic_index_bound_preserves_negative_body(%end: index) {
  %begin = index.constant -17 : index
  %step = index.constant 1 : index
  cfg.br ^_bb1(%begin: index)
^_bb1(%6: index):
  %8 = index.cmp slt, %6, %end : index
  cfg.cond_br %8, ^_bb2, ^_bb3
^_bb2:
  %position = index.assume %6 [range(%6, -17, 9223372036854775806), lt(%6, %end)] : index
  %lo = scalar.constant -17 : i64
  %hi = scalar.constant 9223372036854775806 : i64
  test.use %lo, %hi : i64, i64
  %9 = index.add %position, %step : index
  cfg.br ^_bb1(%9: index)
^_bb3:
  func.return
}

// ====

// RUN: pass scf-to-cfg,canonicalize,dce

// Crossing the 32-bit boundary does not change the range transport contract.
func.def @wide_static_index_bound_preserves_body_range() {
  %begin = index.constant 4294967296 : index
  %end = index.constant 4294967300 : index
  %step = index.constant 2 : index
  scf.for %position = [%begin to %end step %step] {
    %lo = test.fact_range_lo %position : index -> i64
    %hi = test.fact_range_hi %position : index -> i64
    %divisor = test.fact_divisor %position : index -> i64
    test.use %lo, %hi, %divisor : i64, i64, i64
  }
  func.return
}

// ----
func.def @wide_static_index_bound_preserves_body_range() {
  %begin = index.constant 4294967296 : index
  %end = index.constant 4294967300 : index
  %step = index.constant 2 : index
  cfg.br ^_bb1(%begin: index)
^_bb1(%7: index):
  %9 = index.cmp slt, %7, %end : index
  cfg.cond_br %9, ^_bb2, ^_bb3
^_bb2:
  %position = index.assume %7 [range(%7, 4294967296, 4294967298), multiple_of(%7, 2)] : index
  %lo = scalar.constant 4294967296 : i64
  %hi = scalar.constant 4294967298 : i64
  %divisor = scalar.constant 2 : i64
  test.use %lo, %hi, %divisor : i64, i64, i64
  %10 = index.add %position, %step : index
  cfg.br ^_bb1(%10: index)
^_bb3:
  func.return
}

// ====

// RUN: pass scf-to-cfg,canonicalize,dce

// Lowering a structured loop must preserve the two precise feedback rounds
// used to establish the carried XOR envelope.
func.def @xor_feedback_survives_cfg_lowering(%count: index) -> (i64, i64, i64) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %mask = index.constant 5760 : index
  %last = scf.for %iv = [%begin to %count step %step](%origin = %begin : index) -> (index) {
    %lower = test.fact_range_lo %origin : index -> i64
    %upper = test.fact_range_hi %origin : index -> i64
    %divisor = test.fact_divisor %origin : index -> i64
    test.use %lower, %upper, %divisor : i64, i64, i64
    %next = index.xori %origin, %mask : index
    scf.yield %next : index
  }
  %result_lower = test.fact_range_lo %last : index -> i64
  %result_upper = test.fact_range_hi %last : index -> i64
  %result_divisor = test.fact_divisor %last : index -> i64
  func.return %result_lower, %result_upper, %result_divisor : i64, i64, i64
}

// ----
func.def @xor_feedback_survives_cfg_lowering(%count: index) -> (i64, i64, i64) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %mask = index.constant 5760 : index
  cfg.br ^_bb1(%begin: index, %begin: index)
^_bb1(%19: index, %20: index):
  %23 = index.cmp slt, %19, %count : index
  cfg.cond_br %23, ^_bb2, ^_bb3
^_bb2:
  %iv, %origin = index.assume %19, %20 [range(%19, 0, 9223372036854775806), lt(%19, %count), range(%20, 0, 8064), multiple_of(%20, 128)] : index, index
  %lower = scalar.constant 0 : i64
  %upper = scalar.constant 8064 : i64
  %divisor = scalar.constant 128 : i64
  test.use %lower, %upper, %divisor : i64, i64, i64
  %next = index.xori %origin, %mask : index
  %24 = index.add %iv, %step : index
  cfg.br ^_bb1(%24: index, %next: index)
^_bb3:
  cfg.br ^_bb4(%20: index)
^_bb4(%last: index):
  %result_lower = scalar.constant 0 : i64
  %result_upper = scalar.constant 8064 : i64
  %result_divisor = scalar.constant 128 : i64
  func.return %result_lower, %result_upper, %result_divisor : i64, i64, i64
}
