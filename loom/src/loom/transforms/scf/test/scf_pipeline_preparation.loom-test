// RUN: with-checks pass-report pipeline-scf-for

// Only the requested full mixed loop is exposed before the read-ahead cut.
kernel.def @prepare_mixed_stripes() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %width = index.constant 64 : index
  %tile = index.constant 128 : index
  %last = index.constant 63 : index
  %origin = index.constant 0 : offset
  %stage_bytes = index.constant 512 : offset
  %lane = kernel.workitem.id<x> : index
  %peer = index.sub %last, %lane : index
  %source = buffer.view %input[%origin] : buffer -> view<512xi32>
  %destination = buffer.view %output[%origin] : buffer -> view<64xi32>
  %scratch = buffer.alloca<workgroup> align(4) %stage_bytes : buffer
  %published = buffer.view %scratch[%origin] : buffer -> view<128xi32>
  %consumed = buffer.view %scratch[%origin] : buffer -> view<128xi32>
  %identity = scalar.constant 0 : i32
  %result = scf.for %row = [%c0 to %c4 step %c1](%sum = %identity : i32) -> (i32) pipeline(%c2) {
    scf.for %stripe = [%c0 to %c2 step %c1] unroll {
      %slot = index.madd %stripe, %width, %lane : index
      %address = index.madd %row, %tile, %slot : index
      %value = view.load %source[%address] : view<512xi32> -> i32
      view.store %value, %published[%slot] : i32, view<128xi32>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %observed = view.load %consumed[%peer] : view<128xi32> -> i32
    %second_peer = index.add %peer, %width : index
    %second = view.load %consumed[%second_peer] : view<128xi32> -> i32
    %pair = scalar.addi %observed, %second : i32
    %next = scalar.addi %sum, %pair : i32
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.yield %next : i32
  }
  view.store %result, %destination[%lane] : i32, view<64xi32>
  kernel.return
}

// ----
CHECK: *"acquisition_count":1*
CHECK: *"loops-pipelined":1,"policies-cleared":0*
CHECK: *"values_per_record":4,"read_count":2*
CHECK: *"op":"view.load","stage":"producer"*
CHECK: *"op":"view.load","stage":"consumer"*
CHECK: *"op":"view.store","stage":"consumer"*
CHECK: *"op":"kernel.barrier","stage":"consumer"*
CHECK-NOT: *"op":"view.store","stage":"producer"*
CHECK-NOT: *"op":"kernel.barrier","stage":"producer"*

