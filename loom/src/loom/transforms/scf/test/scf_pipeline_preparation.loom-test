// ====

// RUN: with-checks pass-report pipeline-scf-for

// The read-only reduction remains one queued result instead of two queued loads.
kernel.def retain @readonly_nested_global() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%input: buffer, %output: buffer) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<8xf32>
  %output_view = buffer.view %output[%base] : buffer -> view<4xf32>
  %identity = vector.splatf 0.0 : vector<4xf32>
  %result = scf.for %i = [%c0 to %c4 step %c1](%sum = %identity : vector<4xf32>) -> (vector<4xf32>) pipeline(%c2) {
    %partial = scf.for %j = [%c0 to %c2 step %c1](%inner_sum = %identity : vector<4xf32>) -> (vector<4xf32>) unroll {
      %address = index.mul %j, %c4 : index
      %loaded = vector.load %input_view[%address] : view<8xf32> -> vector<4xf32>
      %added = vector.addf %inner_sum, %loaded : vector<4xf32>
      scf.yield %added : vector<4xf32>
    }
    %next = vector.addf %sum, %partial : vector<4xf32>
    scf.yield %next : vector<4xf32>
  }
  vector.store %result, %output_view[%c0] : vector<4xf32>, view<4xf32>
  kernel.return
}

// ----
CHECK: *"values_per_record":1,"read_count":1*
CHECK: *"op":"scf.for","stage":"producer"*
