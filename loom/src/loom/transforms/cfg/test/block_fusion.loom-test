// RUN: pass cfg-simplify

// Dependent types follow substitutions across every incoming branch in a chain.
func.def @dependent_chain(%layout: encoding<layout>, %view: view<4xf32, %layout>) {
  cfg.br ^start(%layout: encoding<layout>, %view: view<4xf32, %layout>)
^start(%start_layout: encoding<layout>, %start_view: view<4xf32, %start_layout>):
  test.use %start_view : view<4xf32, %start_layout>
  cfg.br ^middle(%start_layout: encoding<layout>, %start_view: view<4xf32, %start_layout>)
^middle(%middle_layout: encoding<layout>, %middle_view: view<4xf32, %middle_layout>):
  test.use %middle_view : view<4xf32, %middle_layout>
  cfg.br ^tail(%middle_layout: encoding<layout>, %middle_view: view<4xf32, %middle_layout>)
^tail(%tail_layout: encoding<layout>, %tail_view: view<4xf32, %tail_layout>):
  test.use %tail_view : view<4xf32, %tail_layout>
  func.return
}

// ----
func.def @dependent_chain(%layout: encoding<layout>, %view: view<4xf32, %layout>) {
  test.use %view : view<4xf32, %layout>
  test.use %view : view<4xf32, %layout>
  test.use %view : view<4xf32, %layout>
  func.return
}

// ====
// RUN: pass cfg-simplify

// Parallel contractions preserve a shared join and rewrite references inside
// predicates and nested regions before the old block arguments are detached.
func.def @sibling_chains_with_nested_references(%choose: i1, %pick: i1, %offset: index, %left_limit: index, %right_limit: index) -> (index) {
  cfg.cond_br %choose, ^left, ^right
^left:
  test.use %left_limit : index
  cfg.br ^left_tail(%left_limit: index)
^left_tail(%left_width: index):
  %left_result = scf.if %pick -> (index) {
    %bounded = index.assume %offset [lt(%offset, %left_width)] : index
    scf.yield %bounded : index
  } else {
    scf.yield %left_width : index
  }
  cfg.br ^join(%left_result: index)
^right:
  test.use %right_limit : index
  cfg.br ^right_tail(%right_limit: index)
^right_tail(%right_width: index):
  %right_result = index.assume %offset [lt(%offset, %right_width)] : index
  cfg.br ^join(%right_result: index)
^join(%result: index):
  func.return %result : index
}

// ----
func.def @sibling_chains_with_nested_references(%choose: i1, %pick: i1, %offset: index, %left_limit: index, %right_limit: index) -> (index) {
  cfg.cond_br %choose, ^left, ^right
^left:
  test.use %left_limit : index
  %left_result = scf.if %pick -> (index) {
    %bounded = index.assume %offset [lt(%offset, %left_limit)] : index
    scf.yield %bounded : index
  } else {
    scf.yield %left_limit : index
  }
  cfg.br ^join(%left_result: index)
^right:
  test.use %right_limit : index
  %right_result = index.assume %offset [lt(%offset, %right_limit)] : index
  cfg.br ^join(%right_result: index)
^join(%result: index):
  func.return %result : index
}

// ====
// RUN: pass cfg-simplify

// The loop header survives while its body chain contracts in dominance order.
func.def @cyclic_region_body_chain(%again: i1, %seed: index) -> (index) {
  %c1 = index.constant 1 : index
  cfg.br ^header(%seed: index)
^header(%carried: index):
  cfg.cond_br %again, ^body, ^exit
^body:
  %first = index.add %carried, %c1 : index
  cfg.br ^middle(%first: index)
^middle(%middle_value: index):
  %second = index.add %middle_value, %c1 : index
  cfg.br ^tail(%second: index)
^tail(%tail_value: index):
  %next = index.add %tail_value, %c1 : index
  cfg.br ^header(%next: index)
^exit:
  func.return %carried : index
}

// ----
func.def @cyclic_region_body_chain(%again: i1, %seed: index) -> (index) {
  %c1 = index.constant 1 : index
  cfg.br ^header(%seed: index)
^header(%carried: index):
  cfg.cond_br %again, ^body, ^exit
^body:
  %first = index.add %carried, %c1 : index
  %second = index.add %first, %c1 : index
  %next = index.add %second, %c1 : index
  cfg.br ^header(%next: index)
^exit:
  func.return %carried : index
}

// ====
// RUN: pass cfg-simplify

// Moving a region owner preserves references to an ancestor CFG definition
// in nested declaration types and predicate attributes.
func.def @ancestor_types_and_attributes(%choose: i1, %element: f32) {
  %width = index.constant 16 : index
  cfg.br ^outer
^outer:
  test.use %width : index
  cfg.br ^tail
^tail:
  scf.if %choose {
    test.decl @nested_signature(%storage: pool<[%width]>) -> (i32)
    %annotated = test.attrs %element {shape = #test.options<mode = fast, element_type = vector<[%width]xf32>>} : f32
  } else {
    %c0 = index.constant 0 : index
    %bounded = index.assume %c0 [lt(%c0, %width)] : index
    test.use %bounded : index
  }
  func.return
}

// ----
func.def @ancestor_types_and_attributes(%choose: i1, %element: f32) {
  %width = index.constant 16 : index
  test.use %width : index
  scf.if %choose {
    test.decl @nested_signature(%storage: pool<[%width]>) -> (i32)
    %annotated = test.attrs %element {shape = #test.options<mode = fast, element_type = vector<[%width]xf32>>} : f32
  } else {
    %c0 = index.constant 0 : index
    %bounded = index.assume %c0 [lt(%c0, %width)] : index
    test.use %bounded : index
  }
  func.return
}

// ====
// RUN: with-checks pass-report cfg-simplify

// A whole chain needs one structural edit and one confirming iteration.
func.def @chain_iteration_count(%input: i32) -> (i32) {
  cfg.br ^start(%input: i32)
^start(%first: i32):
  test.use %first : i32
  cfg.br ^middle(%first: i32)
^middle(%middle: i32):
  test.use %middle : i32
  cfg.br ^tail(%middle: i32)
^tail(%last: i32):
  test.use %last : i32
  func.return %last : i32
}

// ----
CHECK: *"changed":true,*
CHECK: *"iterations":2,*
CHECK: *"blocks-fused":3,*

// ====
// RUN: with-checks pass-report cfg-simplify

// Independent terminal paths contract together, without cloning returns and
// restarting analysis for each resulting unreachable block.
func.def @terminal_paths(%choose_side: i1, %choose_value: i1, %value: i32) {
  cfg.cond_br %choose_side, ^left, ^right
^left:
  cfg.cond_br %choose_value, ^first, ^second
^right:
  cfg.cond_br %choose_value, ^third, ^fourth
^first:
  test.use %value : i32
  cfg.br ^first_exit
^first_exit:
  func.return
^second:
  test.use %value : i32
  cfg.br ^second_exit
^second_exit:
  func.return
^third:
  test.use %value : i32
  cfg.br ^third_exit
^third_exit:
  func.return
^fourth:
  test.use %value : i32
  cfg.br ^fourth_exit
^fourth_exit:
  func.return
}

// ----
CHECK: *"changed":true,*
CHECK: *"iterations":2,*
CHECK: *"blocks-fused":4,*

// ====
// RUN: with-checks pass-report cfg-simplify

test.target<low_core> @target

// A Low chain ending in an operandless return contracts in one edit.
low.kernel.def target<test.low.core>(@target) @terminal_chain() asm {
  low.br ^start
^start:
  low.br ^middle
^middle:
  low.br ^exit
^exit:
  return
}

// ----
CHECK: *"changed":true,*
CHECK: *"iterations":2,*
CHECK: *"blocks-fused":3,*

// ====
// RUN: pass cfg-simplify

test.target<low_core> @target

// Low register arguments follow the same chain contraction.
low.func.def target<test.low.core>(@target) @low_chain(%input: reg<test.i32>) -> (reg<test.i32>) asm {
  low.br ^start(%input: reg<test.i32>)
^start(%first: reg<test.i32>):
  %sum = test.add.i32 %first, %input
  low.br ^middle(%sum: reg<test.i32>)
^middle(%middle: reg<test.i32>):
  %second = test.add.i32 %middle, %input
  low.br ^tail(%second: reg<test.i32>)
^tail(%last: reg<test.i32>):
  return %last
}

// ----
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @low_chain(%input: reg<test.i32>) -> (reg<test.i32>) asm {
  %sum = test.add.i32 %input, %input
  %second = test.add.i32 %sum, %input
  return %second
}

// ====
// RUN: pass cfg-simplify

test.target<low_core> @target

// The shared loop header and conditional exit survive Low body fusion.
low.func.def target<test.low.core>(@target) @low_loop_chain(%again: reg<test.i32>, %seed: reg<test.i32>) -> (reg<test.i32>) asm {
  low.br ^header(%seed: reg<test.i32>)
^header(%carried: reg<test.i32>):
  low.cond_br %again, ^body, ^exit : reg<test.i32>
^body:
  %first = test.add.i32 %carried, %seed
  low.br ^middle(%first: reg<test.i32>)
^middle(%middle: reg<test.i32>):
  %second = test.add.i32 %middle, %seed
  low.br ^tail(%second: reg<test.i32>)
^tail(%last: reg<test.i32>):
  %next = test.add.i32 %last, %seed
  low.br ^header(%next: reg<test.i32>)
^exit:
  return %carried
}

// ----
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @low_loop_chain(%again: reg<test.i32>, %seed: reg<test.i32>) -> (reg<test.i32>) asm {
  low.br ^header(%seed: reg<test.i32>)
^header(%carried: reg<test.i32>):
  low.cond_br %again, ^body, ^exit : reg<test.i32>
^body:
  %first = test.add.i32 %carried, %seed
  %second = test.add.i32 %first, %seed
  %next = test.add.i32 %second, %seed
  low.br ^header(%next: reg<test.i32>)
^exit:
  return %carried
}

// ====
// RUN: pass inline-callables,cfg-simplify

test.target<low_core> @target

low.func.def inline target<test.low.core>(@target) @prepared_choice(%choose: reg<test.i32>, %input: reg<test.i32>) -> (reg<test.i32>) asm {
  low.cond_br %choose, ^left, ^right : reg<test.i32>
^left:
  %doubled = test.add.i32 %input, %input
  return %doubled
^right:
  return %input
}

// Inlining removes the call while fusion removes its artificial entry edge.
// Both return paths still join before the caller's continuation.
low.func.def public target<test.low.core>(@target) @prepared_caller(%choose: reg<test.i32>, %input: reg<test.i32>) -> (reg<test.i32>) asm {
  %prefix = test.add.i32 %input, %input
  %selected = low.func.call @prepared_choice(%choose, %prefix) : (reg<test.i32>, reg<test.i32>) -> (reg<test.i32>)
  %result = test.add.i32 %selected, %input
  return %result
}

// ----
test.target<low_core> @target

low.func.def public target<test.low.core>(@target) @prepared_caller(%choose: reg<test.i32>, %input: reg<test.i32>) -> (reg<test.i32>) asm {
  %prefix = test.add.i32 %input, %input
  low.cond_br %choose, ^_bb1, ^_bb2 : reg<test.i32>
^_bb1:
  %doubled = test.add.i32 %prefix, %prefix
  low.br ^_bb3(%doubled: reg<test.i32>)
^_bb2:
  low.br ^_bb3(%prefix: reg<test.i32>)
^_bb3(%selected: reg<test.i32>):
  %result = test.add.i32 %selected, %input
  return %result
}

// ====

// RUN: pass cfg-simplify

// Fusion preserves the dominating producer and inferred Low operand types.
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @fused_concat_dominates_consumer(%choose: reg<test.i32>, %seed: reg<test.i32 x2>) -> (reg<test.i32 x2>) asm {
  low.cond_br %choose, ^producer, ^exit : reg<test.i32>
^producer:
  low.br ^definition
^definition:
  %low = test.const.i32 7
  %high = test.const.i32 11
  %pair = concat(%low, %high) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32 x2>
  low.cond_br %choose, ^consumer, ^exit : reg<test.i32>
^consumer:
  return %pair
^exit:
  return %seed
}

// ----
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @fused_concat_dominates_consumer(%choose: reg<test.i32>, %seed: reg<test.i32 x2>) -> (reg<test.i32 x2>) asm {
  low.cond_br %choose, ^producer, ^exit : reg<test.i32>
^producer:
  %low = test.const.i32 7
  %high = test.const.i32 11
  %pair = concat(%low, %high) : (reg<test.i32>, reg<test.i32>) -> reg<test.i32 x2>
  low.cond_br %choose, ^consumer, ^exit : reg<test.i32>
^consumer:
  return %pair
^exit:
  return %seed
}
