// RUN: with-low-asm pass cfg-simplify

// An unknown external predicate participates in the loop merge. The constant
// backedge does not prove that the first iteration is skipped.
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @external_loop_input(%again: reg<test.i32>, %initial: reg<test.i32>, %replacement: reg<test.i32>) -> (reg<test.i32>) asm {
  %false = test.const.i32 0
  low.br ^loop(%again: reg<test.i32>, %initial: reg<test.i32>)
^loop(%condition: reg<test.i32>, %value: reg<test.i32>):
  low.cond_br %condition, ^body, ^exit : reg<test.i32>
^body:
  low.br ^loop(%false: reg<test.i32>, %replacement: reg<test.i32>)
^exit:
  return %value
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @external_loop_input(%again: reg<test.i32>, %initial: reg<test.i32>, %replacement: reg<test.i32>) -> (reg<test.i32>) asm {
  %false = test.const.i32 0
  low.br ^loop(%again: reg<test.i32>, %initial: reg<test.i32>)
^loop(%condition: reg<test.i32>, %value: reg<test.i32>):
  low.cond_br %condition, ^body, ^exit : reg<test.i32>
^body:
  low.br ^loop(%false: reg<test.i32>, %replacement: reg<test.i32>)
^exit:
  return %value
}

// ====
// RUN: with-low-asm pass cfg-simplify

// An unused cursor update can leave a diamond after inlining. Both edges
// reach the same return and the predicate must disappear with the diamond.
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @unused_cursor(%wrap: reg<test.i32>, %value: reg<test.i32>) -> (reg<test.i32>) asm {
  low.cond_br %wrap, ^wrapped, ^advanced : reg<test.i32>
^wrapped:
  %reset = test.const.i32 0
  low.br ^join(%reset: reg<test.i32>)
^advanced:
  %step = test.const.i32 1
  %next = test.add.i32 %value, %step
  low.br ^join(%next: reg<test.i32>)
^join(%unused_cursor: reg<test.i32>):
  return %value
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @unused_cursor(%wrap: reg<test.i32>, %value: reg<test.i32>) -> (reg<test.i32>) asm {
  return %value
}

// ====
// RUN: with-low-asm pass cfg-simplify

// A repeated predicate is known on each incoming path. The second test must
// disappear without making either external return unconditional.
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @path_predicates(%choose: reg<test.i32>, %left: reg<test.i32>, %right: reg<test.i32>, %other: reg<test.i32>) -> (reg<test.i32>) asm {
  low.cond_br %choose, ^left_path, ^right_path : reg<test.i32>
^left_path:
  low.cond_br %choose, ^left_result, ^wrong : reg<test.i32>
^right_path:
  low.cond_br %choose, ^wrong, ^right_result : reg<test.i32>
^left_result:
  return %left
^right_result:
  return %right
^wrong:
  return %other
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @path_predicates(%choose: reg<test.i32>, %left: reg<test.i32>, %right: reg<test.i32>, %other: reg<test.i32>) -> (reg<test.i32>) asm {
  low.cond_br %choose, ^left_path, ^right_path : reg<test.i32>
^left_path:
  return %left
^right_path:
  return %right
}

// ====
// RUN: with-low-asm pass cfg-simplify

// A forwarded payload must remain on its conditional edge. Otherwise a
// forwarding transform would change which carried value enters the loop.
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @carried_value(%choose: reg<test.i32>, %again: reg<test.i32>, %left: reg<test.i32>, %right: reg<test.i32>) -> (reg<test.i32>) asm {
  low.cond_br %choose, ^left_path, ^right_path : reg<test.i32>
^left_path:
  low.br ^left_payload
^left_payload:
  low.br ^loop(%left: reg<test.i32>)
^right_path:
  low.br ^loop(%right: reg<test.i32>)
^loop(%value: reg<test.i32>):
  low.cond_br %again, ^forward, ^exit : reg<test.i32>
^forward:
  low.br ^payload
^payload:
  low.br ^loop(%value: reg<test.i32>)
^exit:
  return %value
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @carried_value(%choose: reg<test.i32>, %again: reg<test.i32>, %left: reg<test.i32>, %right: reg<test.i32>) -> (reg<test.i32>) asm {
  low.cond_br %choose, ^left_path, ^right_path : reg<test.i32>
^left_path:
  low.br ^loop(%left: reg<test.i32>)
^right_path:
  low.br ^loop(%right: reg<test.i32>)
^loop(%value: reg<test.i32>):
  low.cond_br %again, ^forward, ^exit : reg<test.i32>
^forward:
  low.br ^loop(%value: reg<test.i32>)
^exit:
  return %value
}

// ====
// RUN: with-low-asm pass cfg-simplify

// Fold a batch of exact register predicates without changing the returned
// value or removing the externally controlled loop.
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @constant_predicates(%again: reg<test.i32>, %value: reg<test.i32>, %other: reg<test.i32>) -> (reg<test.i32>) asm {
  %true = test.const.i32 1
  %false = test.const.i32 0
  low.cond_br %true, ^loop, ^wrong : reg<test.i32>
^loop:
  low.cond_br %false, ^wrong, ^body : reg<test.i32>
^body:
  low.cond_br %again, ^loop, ^exit : reg<test.i32>
^exit:
  return %value
^wrong:
  return %other
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @constant_predicates(%again: reg<test.i32>, %value: reg<test.i32>, %other: reg<test.i32>) -> (reg<test.i32>) asm {
  low.br ^loop
^loop:
  low.cond_br %again, ^loop, ^exit : reg<test.i32>
^exit:
  return %value
}

// ====
// RUN: with-low-asm pass cfg-simplify

// A forwarding cycle with several incoming edges retains one self-loop.
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @forwarding_cycle(%first: reg<test.i32>, %second: reg<test.i32>) asm {
  low.cond_br %first, ^one, ^dispatch : reg<test.i32>
^dispatch:
  low.cond_br %second, ^two, ^three : reg<test.i32>
^one:
  low.br ^two
^two:
  low.br ^three
^three:
  low.br ^one
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @forwarding_cycle(%first: reg<test.i32>, %second: reg<test.i32>) asm {
  low.br ^three
^three:
  low.br ^three
}
