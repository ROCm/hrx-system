// RUN: pass cfg-simplify

func.def @changed_predecessor(%choose: i1, %left_value: i32, %right_value: i32) -> (i32) {
  %true = scalar.constant true : i1
  cfg.cond_br %true, ^select, ^dead
^select:
  cfg.cond_br %choose, ^left, ^right
^left:
  test.use %left_value : i32
  %left = index.constant 2 : index
  cfg.br ^join(%left: index)
^right:
  test.use %right_value : i32
  %right = index.constant 2 : index
  cfg.br ^join(%right: index)
^dead:
  %wrong = index.constant 9 : index
  cfg.br ^join(%wrong: index)
^join(%joined: index):
  %expected = index.constant 2 : index
  %matches = index.cmp eq, %joined, %expected : index
  cfg.cond_br %matches, ^matched, ^mismatch
^matched:
  func.return %left_value : i32
^mismatch:
  func.return %right_value : i32
}

// ----
func.def @changed_predecessor(%choose: i1, %left_value: i32, %right_value: i32) -> (i32) {
  cfg.cond_br %choose, ^left, ^right
^left:
  test.use %left_value : i32
  cfg.br ^join
^right:
  test.use %right_value : i32
  cfg.br ^join
^join:
  func.return %left_value : i32
}

// ====

func.def @arithmetic_feedback(%again: i1, %good: i32, %bad: i32) -> (i32) {
  %true = scalar.constant true : i1
  %c0 = index.constant 0 : index
  %c2 = index.constant 2 : index
  %c9 = index.constant 9 : index
  cfg.cond_br %true, ^selected, ^dead
^selected:
  cfg.br ^header(%c2: index)
^dead:
  cfg.br ^header(%c9: index)
^header(%carried: index):
  cfg.cond_br %again, ^body, ^exit
^body:
  %next = index.add %carried, %c0 : index
  cfg.br ^header(%next: index)
^exit:
  %matches = index.cmp eq, %carried, %c2 : index
  cfg.cond_br %matches, ^matched, ^mismatch
^matched:
  func.return %good : i32
^mismatch:
  func.return %bad : i32
}

// ----
func.def @arithmetic_feedback(%again: i1, %good: i32, %bad: i32) -> (i32) {
  %c9 = index.constant 9 : index
  cfg.br ^header
^header:
  cfg.cond_br %again, ^header, ^exit
^exit:
  func.return %good : i32
}

// ====

func.def @merged_join_weakens_facts(%choose: i1, %left_pick: i1, %right_pick: i1, %a: i32, %b: i32) -> (i32) {
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c8 = index.constant 8 : index
  %c9 = index.constant 9 : index
  %c0 = index.constant 0 : index
  %c5 = index.constant 5 : index
  cfg.cond_br %choose, ^left_dispatch, ^right_dispatch
^left_dispatch:
  cfg.cond_br %left_pick, ^left_a, ^left_b
^left_a:
  cfg.br ^left(%c2: index)
^left_b:
  cfg.br ^left(%c3: index)
^right_dispatch:
  cfg.cond_br %right_pick, ^right_a, ^right_b
^right_a:
  cfg.br ^right(%c8: index)
^right_b:
  cfg.br ^right(%c9: index)
^left(%x: index):
  %left_result = index.add %x, %c0 : index
  cfg.br ^join(%left_result: index)
^right(%y: index):
  %right_result = index.add %y, %c0 : index
  cfg.br ^join(%right_result: index)
^join(%result: index):
  %small = index.cmp slt, %result, %c5 : index
  cfg.cond_br %small, ^taken, ^other
^taken:
  func.return %a : i32
^other:
  func.return %b : i32
}

// ----
func.def @merged_join_weakens_facts(%choose: i1, %left_pick: i1, %right_pick: i1, %a: i32, %b: i32) -> (i32) {
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c8 = index.constant 8 : index
  %c9 = index.constant 9 : index
  %c0 = index.constant 0 : index
  %c5 = index.constant 5 : index
  cfg.cond_br %choose, ^left_dispatch, ^right_dispatch
^left_dispatch:
  cfg.cond_br %left_pick, ^left_a, ^left_b
^left_a:
  cfg.br ^left(%c2: index)
^left_b:
  cfg.br ^left(%c3: index)
^right_dispatch:
  cfg.cond_br %right_pick, ^right_a, ^right_b
^right_a:
  cfg.br ^left(%c8: index)
^right_b:
  cfg.br ^left(%c9: index)
^left(%x: index):
  %left_result = index.add %x, %c0 : index
  %small = index.cmp slt, %left_result, %c5 : index
  cfg.cond_br %small, ^taken, ^other
^taken:
  func.return %a : i32
^other:
  func.return %b : i32
}

// ====

func.def @forwarding_cycle_after_edge_removal(%again: i1, %good: i32, %bad: i32) -> (i32) {
  %true = scalar.constant true : i1
  %c2 = index.constant 2 : index
  %c9 = index.constant 9 : index
  cfg.cond_br %true, ^selected, ^dead
^selected:
  cfg.br ^header(%c2: index, %c2: index)
^dead:
  cfg.br ^header(%c9: index, %c9: index)
^header(%first: index, %second: index):
  cfg.cond_br %again, ^body, ^exit
^body:
  test.use %first : index
  cfg.br ^header(%second: index, %first: index)
^exit:
  %matches = index.cmp eq, %first, %c2 : index
  cfg.cond_br %matches, ^matched, ^mismatch
^matched:
  func.return %good : i32
^mismatch:
  func.return %bad : i32
}

// ----
func.def @forwarding_cycle_after_edge_removal(%again: i1, %good: i32, %bad: i32) -> (i32) {
  %c2 = index.constant 2 : index
  %c9 = index.constant 9 : index
  cfg.br ^header
^header:
  cfg.cond_br %again, ^body, ^exit
^body:
  test.use %c2 : index
  cfg.br ^header
^exit:
  func.return %good : i32
}

// ====

// RUN: pass cfg-simplify

func.def @attribute_only_join(%offset: index, %choose: i1, %left_value: i32, %right_value: i32) -> (i32) {
  %true = scalar.constant true : i1
  cfg.cond_br %true, ^select, ^dead
^select:
  cfg.cond_br %choose, ^left, ^right
^left:
  test.use %left_value : i32
  %left = index.constant 2 : index
  cfg.br ^join(%left: index)
^right:
  test.use %right_value : i32
  %right = index.constant 2 : index
  cfg.br ^join(%right: index)
^dead:
  %wrong = index.constant 9 : index
  cfg.br ^join(%wrong: index)
^join(%joined: index):
  %expected = index.constant 2 : index
  %bounded = index.assume %offset [lt(%offset, %joined)] : index
  test.use %bounded : index
  %matches = index.cmp slt, %bounded, %expected : index
  cfg.cond_br %matches, ^matched, ^mismatch
^matched:
  func.return %left_value : i32
^mismatch:
  func.return %right_value : i32
}

// ----
func.def @attribute_only_join(%offset: index, %choose: i1, %left_value: i32, %right_value: i32) -> (i32) {
  %13 = index.constant 2 : index
  cfg.cond_br %choose, ^left, ^right
^left:
  test.use %left_value : i32
  cfg.br ^join
^right:
  test.use %right_value : i32
  cfg.br ^join
^join:
  %bounded = index.assume %offset [lt(%offset, %13)] : index
  test.use %bounded : index
  func.return %left_value : i32
}

// ====

// RUN: pass cfg-simplify

func.def @nested_branch_feedback(%choose: i1, %again: i1, %good: i32, %bad: i32) -> (i32) {
  %true = scalar.constant true : i1
  %c0 = index.constant 0 : index
  %c2 = index.constant 2 : index
  %c9 = index.constant 9 : index
  cfg.cond_br %true, ^selected, ^dead
^selected:
  cfg.br ^header(%c2: index)
^dead:
  cfg.br ^header(%c9: index)
^header(%carried: index):
  cfg.cond_br %again, ^body, ^exit
^body:
  %next = scf.if %choose -> (index) {
    %left = index.add %carried, %c0 : index
    scf.yield %left : index
  } else {
    scf.yield %carried : index
  }
  cfg.br ^header(%next: index)
^exit:
  %matches = index.cmp eq, %carried, %c2 : index
  cfg.cond_br %matches, ^matched, ^mismatch
^matched:
  func.return %good : i32
^mismatch:
  func.return %bad : i32
}

// ----
func.def @nested_branch_feedback(%choose: i1, %again: i1, %good: i32, %bad: i32) -> (i32) {
  %c9 = index.constant 9 : index
  cfg.br ^header
^header:
  cfg.cond_br %again, ^header, ^exit
^exit:
  func.return %good : i32
}

// ====

func.def @nested_loop_feedback(%limit: index, %again: i1, %good: i32, %bad: i32) -> (i32) {
  %true = scalar.constant true : i1
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c9 = index.constant 9 : index
  cfg.cond_br %true, ^selected, ^dead
^selected:
  cfg.br ^header(%c2: index)
^dead:
  cfg.br ^header(%c9: index)
^header(%carried: index):
  cfg.cond_br %again, ^body, ^exit
^body:
  %next = scf.for %iv = [%c0 to %limit step %c1](%inner = %carried : index) -> (index) {
    %forwarded = index.add %inner, %c0 : index
    scf.yield %forwarded : index
  }
  cfg.br ^header(%next: index)
^exit:
  %matches = index.cmp eq, %carried, %c2 : index
  cfg.cond_br %matches, ^matched, ^mismatch
^matched:
  func.return %good : i32
^mismatch:
  func.return %bad : i32
}

// ----
func.def @nested_loop_feedback(%limit: index, %again: i1, %good: i32, %bad: i32) -> (i32) {
  %c9 = index.constant 9 : index
  cfg.br ^header
^header:
  cfg.cond_br %again, ^header, ^exit
^exit:
  func.return %good : i32
}
