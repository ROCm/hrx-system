// RUN: pass cfg-simplify

// A returned identity must remain downstream of its ownership transfer.
// A payload-equality proof alone cannot bypass that boundary.
type.decl import("provider", "object") @Object

func.decl @observe(%value: ptr<@Object>)

func.def @forward_ref(%input: ref<@Object>) -> (ref<@Object>) {
  cfg.br ^current(%input: ref<@Object>)
^current(%value: ref<@Object>):
  %pointer = ref.borrow %value : ref<@Object> -> ptr<@Object>
  func.call @observe(%pointer) : (ptr<@Object>)
  cfg.br ^exit(%value: ref<@Object>)
^exit(%result: ref<@Object>):
  func.return %result : ref<@Object>
}

