// RUN: pass cfg-simplify

// Alpha-equivalent self references do not make equal carried columns distinct.
func.def @compacts_self_dependent_arguments(%again: i1, %seed: test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%seed]xf32>>}>) {
  cfg.br ^loop(%seed: test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%seed]xf32>>}>, %seed: test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%seed]xf32>>}>)
^loop(%first: test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%first]xf32>>}>, %second: test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%second]xf32>>}>):
  test.use %first, %second : test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%first]xf32>>}>, test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%second]xf32>>}>
  cfg.cond_br %again, ^body, ^exit
^body:
  cfg.br ^loop(%second: test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%second]xf32>>}>, %first: test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%first]xf32>>}>)
^exit:
  func.return
}

// ----
func.def @compacts_self_dependent_arguments(%again: i1, %seed: test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%seed]xf32>>}>) {
  cfg.br ^loop
^loop:
  test.use %seed, %seed : test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%seed]xf32>>}>, test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%seed]xf32>>}>
  cfg.cond_br %again, ^loop, ^exit
^exit:
  func.return
}

