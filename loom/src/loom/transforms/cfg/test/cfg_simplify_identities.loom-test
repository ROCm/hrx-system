// RUN: pass cfg-simplify

// A dead carrier may precede its dead provider in the block signature. The
// complete dependent set is removed while an unrelated live argument keeps
// its original incoming slot.
func.def @removes_closed_forward_dependent_set(%choose: i1, %left_layout: encoding<layout>, %left_view: view<4xf32, %left_layout>, %left_value: i32, %left_tail: i32, %right_layout: encoding<layout>, %right_view: view<4xf32, %right_layout>, %right_value: i32, %right_tail: i32) -> (i32) {
  cfg.cond_br %choose, ^left, ^right
^left:
  cfg.br ^join(%left_view: view<4xf32, %left_layout>, %left_value: i32, %left_layout: encoding<layout>, %left_tail: i32)
^right:
  cfg.br ^join(%right_view: view<4xf32, %right_layout>, %right_value: i32, %right_layout: encoding<layout>, %right_tail: i32)
^join(%carrier: view<4xf32, %provider>, %retained: i32, %provider: encoding<layout>, %tail: i32):
  func.return %retained : i32
}

// ----
func.def @removes_closed_forward_dependent_set(%choose: i1, %left_layout: encoding<layout>, %left_view: view<4xf32, %left_layout>, %left_value: i32, %left_tail: i32, %right_layout: encoding<layout>, %right_view: view<4xf32, %right_layout>, %right_value: i32, %right_tail: i32) -> (i32) {
  cfg.cond_br %choose, ^left, ^right
^left:
  cfg.br ^join(%left_value: i32)
^right:
  cfg.br ^join(%right_value: i32)
^join(%retained: i32):
  func.return %retained : i32
}

