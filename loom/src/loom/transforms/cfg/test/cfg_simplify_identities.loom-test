// RUN: pass cfg-simplify

// Dependent view types follow their correlated layout argument replacement.
// Different external paths keep one physical layout/view pair at the join.
func.def @compacts_cyclic_dependent_arguments(%select: i1, %again: i1, %left_layout: encoding<layout>, %left_view: view<4xf32, %left_layout>, %right_layout: encoding<layout>, %right_view: view<4xf32, %right_layout>) {
  cfg.cond_br %select, ^left, ^right
^left:
  cfg.br ^loop(%left_layout: encoding<layout>, %left_layout: encoding<layout>, %left_view: view<4xf32, %left_layout>, %left_view: view<4xf32, %left_layout>)
^right:
  cfg.br ^loop(%right_layout: encoding<layout>, %right_layout: encoding<layout>, %right_view: view<4xf32, %right_layout>, %right_view: view<4xf32, %right_layout>)
^loop(%first_layout: encoding<layout>, %second_layout: encoding<layout>, %first_view: view<4xf32, %first_layout>, %second_view: view<4xf32, %second_layout>):
  test.use %first_view, %second_view : view<4xf32, %first_layout>, view<4xf32, %second_layout>
  cfg.cond_br %again, ^body, ^exit
^body:
  cfg.br ^loop(%second_layout: encoding<layout>, %first_layout: encoding<layout>, %second_view: view<4xf32, %second_layout>, %first_view: view<4xf32, %first_layout>)
^exit:
  test.use %first_view, %second_view : view<4xf32, %first_layout>, view<4xf32, %second_layout>
  func.return
}

// ----
func.def @compacts_cyclic_dependent_arguments(%select: i1, %again: i1, %left_layout: encoding<layout>, %left_view: view<4xf32, %left_layout>, %right_layout: encoding<layout>, %right_view: view<4xf32, %right_layout>) {
  cfg.cond_br %select, ^left, ^right
^left:
  cfg.br ^loop(%left_layout: encoding<layout>, %left_view: view<4xf32, %left_layout>)
^right:
  cfg.br ^loop(%right_layout: encoding<layout>, %right_view: view<4xf32, %right_layout>)
^loop(%first_layout: encoding<layout>, %first_view: view<4xf32, %first_layout>):
  test.use %first_view, %first_view : view<4xf32, %first_layout>, view<4xf32, %first_layout>
  cfg.cond_br %again, ^body, ^exit
^body:
  cfg.br ^loop(%first_layout: encoding<layout>, %first_view: view<4xf32, %first_layout>)
^exit:
  test.use %first_view, %first_view : view<4xf32, %first_layout>, view<4xf32, %first_layout>
  func.return
}

