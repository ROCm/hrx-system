// RUN: pass cfg-simplify

// A mutually dependent argument cycle is also one closed component. Forward
// references make the removal order irrelevant.
func.def @removes_unused_mutually_dependent_arguments(%choose: i1, %left_first: test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%left_second]xf32>>}>, %left_second: test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%left_first]xf32>>}>, %right_first: test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%right_second]xf32>>}>, %right_second: test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%right_first]xf32>>}>) {
  cfg.cond_br %choose, ^left_path, ^right_path
^left_path:
  cfg.br ^join(%left_first: test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%left_second]xf32>>}>, %left_second: test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%left_first]xf32>>}>)
^right_path:
  cfg.br ^join(%right_first: test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%right_second]xf32>>}>, %right_second: test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%right_first]xf32>>}>)
^join(%first: test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%second]xf32>>}>, %second: test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%first]xf32>>}>):
  func.return
}

// ----
func.def @removes_unused_mutually_dependent_arguments(%choose: i1, %left_first: test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%left_second]xf32>>}>, %left_second: test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%left_first]xf32>>}>, %right_first: test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%right_second]xf32>>}>, %right_second: test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%right_first]xf32>>}>) {
  func.return
}

