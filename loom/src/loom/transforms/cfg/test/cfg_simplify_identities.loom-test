// RUN: pass cfg-simplify

// These columns have the same canonical payload but different self-reference
// roles. Normalizing the first column changes its type; normalizing the second
// does not. Storage identity alone cannot establish their normalized equality.
func.def @preserves_distinct_self_reference_roles(%select: i1, %again: i1, %left: test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%left]xf32>>}>, %right: test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%right]xf32>>}>) {
  cfg.cond_br %select, ^left_path, ^right_path
^left_path:
  cfg.br ^loop(%left: test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%left]xf32>>}>, %left: test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%left]xf32>>}>)
^right_path:
  cfg.br ^loop(%right: test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%right]xf32>>}>, %right: test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%right]xf32>>}>)
^loop(%first: test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%first]xf32>>}>, %second: test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%first]xf32>>}>):
  cfg.cond_br %again, ^feedback, ^exit
^feedback:
  cfg.br ^loop(%first: test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%first]xf32>>}>, %second: test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%first]xf32>>}>)
^exit:
  test.use %first, %second : test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%first]xf32>>}>, test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%first]xf32>>}>
  func.return
}

// ====

// RUN: pass cfg-simplify

// Upstream values share a type but have different self-reference roles. A
// downstream join must retain its own label when their provisional equality
// is disproven. Tail copies enlarge one side without changing its identity.
func.def @preserves_labels_after_identity_splits(%select: i1, %choose: i1, %again: i1, %left: test.ref<vector<[%left]xf32>>, %right: test.ref<vector<[%right]xf32>>) {
  cfg.cond_br %select, ^left_path, ^right_path
^left_path:
  cfg.br ^providers(%left: test.ref<vector<[%left]xf32>>, %left: test.ref<vector<[%left]xf32>>)
^right_path:
  cfg.br ^providers(%right: test.ref<vector<[%right]xf32>>, %right: test.ref<vector<[%right]xf32>>)
^providers(%provider: test.ref<vector<[%provider]xf32>>, %peer: test.ref<vector<[%provider]xf32>>):
  cfg.cond_br %choose, ^first_path, ^second_path
^first_path:
  cfg.br ^loop(%provider: test.ref<vector<[%provider]xf32>>, %provider: test.ref<vector<[%provider]xf32>>)
^second_path:
  cfg.br ^loop(%peer: test.ref<vector<[%provider]xf32>>, %peer: test.ref<vector<[%provider]xf32>>)
^loop(%first: test.ref<vector<[%provider]xf32>>, %second: test.ref<vector<[%provider]xf32>>):
  cfg.cond_br %again, ^feedback, ^exit
^feedback:
  cfg.br ^loop(%second: test.ref<vector<[%provider]xf32>>, %first: test.ref<vector<[%provider]xf32>>)
^exit:
  cfg.br ^tail(%first: test.ref<vector<[%provider]xf32>>, %first: test.ref<vector<[%provider]xf32>>, %second: test.ref<vector<[%provider]xf32>>)
^tail(%first_copy: test.ref<vector<[%provider]xf32>>, %second_copy: test.ref<vector<[%provider]xf32>>, %peer_copy: test.ref<vector<[%provider]xf32>>):
  test.use %first_copy, %second_copy, %peer_copy : test.ref<vector<[%provider]xf32>>, test.ref<vector<[%provider]xf32>>, test.ref<vector<[%provider]xf32>>
  func.return
}

// ----
func.def @preserves_labels_after_identity_splits(%select: i1, %choose: i1, %again: i1, %left: test.ref<vector<[%left]xf32>>, %right: test.ref<vector<[%right]xf32>>) {
  cfg.cond_br %select, ^left_path, ^right_path
^left_path:
  cfg.br ^providers(%left: test.ref<vector<[%left]xf32>>)
^right_path:
  cfg.br ^providers(%right: test.ref<vector<[%right]xf32>>)
^providers(%provider: test.ref<vector<[%provider]xf32>>):
  cfg.br ^loop
^loop:
  cfg.cond_br %again, ^loop, ^exit
^exit:
  test.use %provider, %provider, %provider : test.ref<vector<[%provider]xf32>>, test.ref<vector<[%provider]xf32>>, test.ref<vector<[%provider]xf32>>
  func.return
}

// ====

// RUN: pass cfg-simplify

// Replacing an earlier loop argument also changes the representative used by
// the later loop. No consumer may resurrect the removed argument.
func.def @forwards_replaced_identity_across_nested_loops(%n: i32, %inner_again: i1, %skip: i1, %stage_again: i1) {
  cfg.br ^outer(%n: i32)
^outer(%a: i32):
  cfg.br ^inner(%a: i32)
^inner(%b: i32):
  cfg.cond_br %inner_again, ^inner_latch, ^inner_exit
^inner_latch:
  cfg.br ^inner(%b: i32)
^inner_exit:
  cfg.cond_br %skip, ^skip, ^stage_entry
^skip:
  cfg.br ^latch(%b: i32)
^stage_entry:
  cfg.br ^stage(%b: i32)
^stage(%c: i32):
  cfg.cond_br %stage_again, ^stage_latch, ^stage_exit
^stage_latch:
  cfg.br ^stage(%c: i32)
^stage_exit:
  %next = scalar.addi %c, %n : i32
  cfg.br ^latch(%next: i32)
^latch(%d: i32):
  cfg.br ^outer(%d: i32)
}

// ----
func.def @forwards_replaced_identity_across_nested_loops(%n: i32, %inner_again: i1, %skip: i1, %stage_again: i1) {
  cfg.br ^outer(%n: i32)
^outer(%a: i32):
  cfg.br ^inner
^inner:
  cfg.cond_br %inner_again, ^inner, ^inner_exit
^inner_exit:
  cfg.cond_br %skip, ^skip, ^stage
^skip:
  cfg.br ^latch(%a: i32)
^stage:
  cfg.cond_br %stage_again, ^stage, ^stage_exit
^stage_exit:
  %next = scalar.addi %a, %n : i32
  cfg.br ^latch(%next: i32)
^latch(%d: i32):
  cfg.br ^outer(%d: i32)
}

