low.func.def target<test.low.core>(@test_target) @preserves_distinct_external_transition(%again: reg<test.i32>, %seed: reg<test.i32>, %external: reg<test.i32>) -> (reg<test.i32>) asm {
  low.br ^loop(%seed: reg<test.i32>, %seed: reg<test.i32>)
^loop(%first: reg<test.i32>, %second: reg<test.i32>):
  low.cond_br %again, ^body, ^exit : reg<test.i32>
^body:
  low.br ^loop(%second: reg<test.i32>, %external: reg<test.i32>)
^exit:
  %sum = test.add.i32 %first, %second
  return %sum
}

