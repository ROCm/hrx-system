// RUN: pass cfg-simplify

// A live carrier keeps its otherwise-unused provider while an independent
// dead argument is still removed from the same signature.
func.def @retains_provider_of_live_carrier(%choose: i1, %left_layout: encoding<layout>, %left_view: view<4xf32, %left_layout>, %left_tail: i32, %right_layout: encoding<layout>, %right_view: view<4xf32, %right_layout>, %right_tail: i32) {
  cfg.cond_br %choose, ^left, ^right
^left:
  cfg.br ^join(%left_view: view<4xf32, %left_layout>, %left_layout: encoding<layout>, %left_tail: i32)
^right:
  cfg.br ^join(%right_view: view<4xf32, %right_layout>, %right_layout: encoding<layout>, %right_tail: i32)
^join(%carrier: view<4xf32, %provider>, %provider: encoding<layout>, %tail: i32):
  test.use %carrier : view<4xf32, %provider>
  func.return
}

// ----
func.def @retains_provider_of_live_carrier(%choose: i1, %left_layout: encoding<layout>, %left_view: view<4xf32, %left_layout>, %left_tail: i32, %right_layout: encoding<layout>, %right_view: view<4xf32, %right_layout>, %right_tail: i32) {
  cfg.cond_br %choose, ^left, ^right
^left:
  cfg.br ^join(%left_view: view<4xf32, %left_layout>, %left_layout: encoding<layout>)
^right:
  cfg.br ^join(%right_view: view<4xf32, %right_layout>, %right_layout: encoding<layout>)
^join(%carrier: view<4xf32, %provider>, %provider: encoding<layout>):
  test.use %carrier : view<4xf32, %provider>
  func.return
}

