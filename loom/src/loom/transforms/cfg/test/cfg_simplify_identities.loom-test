// RUN: with-low-asm pass cfg-simplify

// A rotated cycle whose columns share one initial value has no carried state.
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @compacts_cyclic_equal_arguments_to_external(%again: reg<test.i32>, %seed: reg<test.i32>) -> (reg<test.i32>) asm {
  low.br ^loop(%seed: reg<test.i32>, %seed: reg<test.i32>)
^loop(%first: reg<test.i32>, %second: reg<test.i32>):
  low.cond_br %again, ^body, ^exit : reg<test.i32>
^body:
  low.br ^loop(%second: reg<test.i32>, %first: reg<test.i32>)
^exit:
  %sum = test.add.i32 %first, %second
  return %sum
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @compacts_cyclic_equal_arguments_to_external(%again: reg<test.i32>, %seed: reg<test.i32>) -> (reg<test.i32>) asm {
  low.br ^loop
^loop:
  low.cond_br %again, ^loop, ^exit : reg<test.i32>
^exit:
  %sum = test.add.i32 %seed, %seed
  return %sum
}

// ====

// RUN: with-low-asm pass cfg-simplify

// Several external paths may select different values while preserving equality
// between all three columns on every path and around the feedback edge.
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @compacts_cyclic_equal_arguments_across_fanin(%select: reg<test.i32>, %again: reg<test.i32>, %left_value: reg<test.i32>, %right_value: reg<test.i32>) -> (reg<test.i32>) asm {
  low.cond_br %select, ^left, ^right : reg<test.i32>
^left:
  low.br ^loop(%left_value: reg<test.i32>, %left_value: reg<test.i32>, %left_value: reg<test.i32>)
^right:
  low.br ^loop(%right_value: reg<test.i32>, %right_value: reg<test.i32>, %right_value: reg<test.i32>)
^loop(%first: reg<test.i32>, %second: reg<test.i32>, %third: reg<test.i32>):
  low.cond_br %again, ^body, ^exit : reg<test.i32>
^body:
  low.br ^loop(%second: reg<test.i32>, %third: reg<test.i32>, %first: reg<test.i32>)
^exit:
  %partial = test.add.i32 %first, %second
  %sum = test.add.i32 %partial, %third
  return %sum
}

// ----
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @compacts_cyclic_equal_arguments_across_fanin(%select: reg<test.i32>, %again: reg<test.i32>, %left_value: reg<test.i32>, %right_value: reg<test.i32>) -> (reg<test.i32>) asm {
  low.cond_br %select, ^left, ^right : reg<test.i32>
^left:
  low.br ^loop(%left_value: reg<test.i32>)
^right:
  low.br ^loop(%right_value: reg<test.i32>)
^loop(%first: reg<test.i32>):
  low.cond_br %again, ^body, ^exit : reg<test.i32>
^body:
  low.br ^loop(%first: reg<test.i32>)
^exit:
  %partial = test.add.i32 %first, %first
  %sum = test.add.i32 %partial, %first
  return %sum
}

// ====

// RUN: with-low-asm pass cfg-simplify

// Distinct initial values keep rotated columns separate.
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @preserves_rotated_distinct_initials(%again: reg<test.i32>, %first_initial: reg<test.i32>, %second_initial: reg<test.i32>) -> (reg<test.i32>) asm {
  low.br ^loop(%first_initial: reg<test.i32>, %second_initial: reg<test.i32>)
^loop(%first: reg<test.i32>, %second: reg<test.i32>):
  low.cond_br %again, ^body, ^exit : reg<test.i32>
^body:
  low.br ^loop(%second: reg<test.i32>, %first: reg<test.i32>)
^exit:
  %sum = test.add.i32 %first, %second
  return %sum
}

// ====

// RUN: with-low-asm pass cfg-simplify

// Equal initial values do not hide a distinct external transition.
test.target<low_core> @test_target

low.func.def target<test.low.core>(@test_target) @preserves_distinct_external_transition(%again: reg<test.i32>, %seed: reg<test.i32>, %external: reg<test.i32>) -> (reg<test.i32>) asm {
  low.br ^loop(%seed: reg<test.i32>, %seed: reg<test.i32>)
^loop(%first: reg<test.i32>, %second: reg<test.i32>):
  low.cond_br %again, ^body, ^exit : reg<test.i32>
^body:
  low.br ^loop(%second: reg<test.i32>, %external: reg<test.i32>)
^exit:
  %sum = test.add.i32 %first, %second
  return %sum
}

