// RUN: pass cfg-simplify

// A self-dependent argument is a closed one-node type-use component and can
// be removed when it has no direct uses.
func.def @removes_unused_self_dependent_argument(%choose: i1, %left: test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%left]xf32>>}>, %right: test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%right]xf32>>}>) {
  cfg.cond_br %choose, ^left_path, ^right_path
^left_path:
  cfg.br ^join(%left: test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%left]xf32>>}>)
^right_path:
  cfg.br ^join(%right: test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%right]xf32>>}>)
^join(%unused: test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%unused]xf32>>}>):
  func.return
}

// ----
func.def @removes_unused_self_dependent_argument(%choose: i1, %left: test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%left]xf32>>}>, %right: test.array<i32, metadata = {options = #test.options<mode = fast, element_type = vector<[%right]xf32>>}>) {
  func.return
}

