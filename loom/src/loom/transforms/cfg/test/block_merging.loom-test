// Successor merges expose all preceding pairs in the same structural edit.
func.def @merge_reordered_decision_tails(%choice: i32, %selector: i32, %value: i32) -> (i32) {
  %c0 = scalar.constant 0 : i32
  %choose = scalar.cmpi eq, %choice, %c0 : i32
  cfg.cond_br %choose, ^left_0, ^right_0
^right_0:
  %right_key_0 = scalar.constant 0 : i32
  %right_test_0 = scalar.cmpi ne, %selector, %right_key_0 : i32
  cfg.cond_br %right_test_0, ^right_1, ^matched
^right_1:
  %right_key_1 = scalar.constant 1 : i32
  %right_test_1 = scalar.cmpi ne, %selector, %right_key_1 : i32
  cfg.cond_br %right_test_1, ^right_2, ^matched
^right_2:
  %right_key_2 = scalar.constant 2 : i32
  %right_test_2 = scalar.cmpi ne, %selector, %right_key_2 : i32
  cfg.cond_br %right_test_2, ^fallback, ^matched
^left_0:
  %left_key_0 = scalar.constant 0 : i32
  %left_test_0 = scalar.cmpi ne, %selector, %left_key_0 : i32
  cfg.cond_br %left_test_0, ^left_1, ^matched
^left_1:
  %left_key_1 = scalar.constant 1 : i32
  %left_test_1 = scalar.cmpi ne, %selector, %left_key_1 : i32
  cfg.cond_br %left_test_1, ^left_2, ^matched
^left_2:
  %left_key_2 = scalar.constant 2 : i32
  %left_test_2 = scalar.cmpi ne, %selector, %left_key_2 : i32
  cfg.cond_br %left_test_2, ^fallback, ^matched
^matched:
  func.return %selector : i32
^fallback:
  func.return %value : i32
}

