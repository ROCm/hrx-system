// ====

func.def @threads_only_sufficient_incoming_facts(%left: i1, %right: i1, %gate: i1, %pick: i1, %yes: i32, %no: i32) -> (i32) {
  %inner = scalar.ori %left, %right : i1
  %selected = scalar.andi %inner, %gate : i1
  cfg.cond_br %pick, ^left_path, ^right_path
^left_path:
  test.use %yes : i32
  cfg.cond_br %gate, ^check, ^no
^right_path:
  test.use %no : i32
  cfg.cond_br %gate, ^yes, ^check
^check:
  cfg.cond_br %selected, ^yes, ^no
^yes:
  func.return %yes : i32
^no:
  func.return %no : i32
}

// ----
func.def @threads_only_sufficient_incoming_facts(%left: i1, %right: i1, %gate: i1, %pick: i1, %yes: i32, %no: i32) -> (i32) {
  %inner = scalar.ori %left, %right : i1
  %selected = scalar.andi %inner, %gate : i1
  cfg.cond_br %pick, ^left_path, ^right_path
^left_path:
  test.use %yes : i32
  cfg.cond_br %gate, ^check, ^no
^right_path:
  test.use %no : i32
  cfg.cond_br %gate, ^yes, ^no
^check:
  cfg.cond_br %selected, ^yes, ^no
^yes:
  func.return %yes : i32
^no:
  func.return %no : i32
}

// ====

func.def @preserves_constant_materialization(%gate: i1, %other: i1) -> (i1) {
  cfg.cond_br %gate, ^known, ^unknown
^known:
  %constant = scalar.constant true : i1
  func.return %constant : i1
^unknown:
  func.return %other : i1
}

// ====

// Threading the condition join replaces its Boolean argument with the load's
// comparison and moves the branch. The load remains guarded by the bounds
// check, and either exit returns the position tested by the loop header.
func.def @forwards_guarded_loop_condition(%input: view<37xi32>, %start: index) -> (index) {
  %length = index.constant 37 : index
  cfg.br ^header(%start: index)
^header(%position: index):
  %inside = index.cmp ult, %position, %length : index
  cfg.cond_br %inside, ^read, ^outside
^read:
  %value = view.load %input[%position] : view<37xi32> -> i32
  %threshold = scalar.constant 0 : i32
  %positive = scalar.cmpi sgt, %value, %threshold : i32
  cfg.br ^condition(%positive: i1)
^outside:
  cfg.br ^condition(%inside: i1)
^condition(%continue: i1):
  cfg.cond_br %continue, ^body, ^exit
^body:
  %step = index.constant 1 : index
  %next = index.add %position, %step : index
  cfg.br ^header(%next: index)
^exit:
  func.return %position : index
}

// ----
func.def @forwards_guarded_loop_condition(%input: view<37xi32>, %start: index) -> (index) {
  %length = index.constant 37 : index
  cfg.br ^header(%start: index)
^header(%position: index):
  %inside = index.cmp ult, %position, %length : index
  cfg.cond_br %inside, ^read, ^exit
^read:
  %value = view.load %input[%position] : view<37xi32> -> i32
  %threshold = scalar.constant 0 : i32
  %positive = scalar.cmpi sgt, %value, %threshold : i32
  cfg.cond_br %positive, ^body, ^exit
^body:
  %step = index.constant 1 : index
  %next = index.add %position, %step : index
  cfg.br ^header(%next: index)
^exit:
  func.return %position : index
}
