// RUN: pass cfg-converge,cfg-converge

// Branch-local type identities cannot be replaced by scalar placeholders.
func.def @type_capture(%outer: i1, %inner: i1, %size: index, %seed: i32) {
  cfg.cond_br %outer, ^evaluate, ^fallback
^evaluate:
  %extent = index.add %size, %size : index
  cfg.cond_br %inner, ^selected, ^fallback
^selected:
  %tile = test.convert %seed : i32 -> tile<[%extent]xf32>
  test.use %tile : tile<[%extent]xf32>
  cfg.br ^exit
^fallback:
  test.use %seed : i32
  cfg.br ^exit
^exit:
  func.return
}

// ----
func.def @type_capture(%outer: i1, %inner: i1, %size: index, %seed: i32) {
  cfg.cond_br %outer, ^evaluate, ^fallback
^evaluate:
  %extent = index.add %size, %size : index
  cfg.cond_br %inner, ^selected, ^fallback
^selected:
  %tile = test.convert %seed : i32 -> tile<[%extent]xf32>
  test.use %tile : tile<[%extent]xf32>
  cfg.br ^exit
^fallback:
  test.use %seed : i32
  cfg.br ^exit
^exit:
  func.return
}

