func.def @fully_uniform_decisions(%last: i1) -> (i1) {
  %selected = scalar.constant true : i1
  %inner = scalar.constant true : i1
  %outer = scalar.constant true : i1
  test.use %outer : i1
  cfg.cond_br %outer, ^evaluate, ^fallback
^evaluate:
  test.use %inner : i1
  cfg.cond_br %inner, ^selected, ^fallback
^selected:
  cfg.br ^merge(%selected: i1)
^fallback:
  test.use %last : i1
  cfg.br ^merge(%last: i1)
^merge(%result: i1):
  func.return %result : i1
}

// ----
func.def @fully_uniform_decisions(%last: i1) -> (i1) {
  %selected = scalar.constant true : i1
  %inner = scalar.constant true : i1
  %outer = scalar.constant true : i1
  test.use %outer : i1
  cfg.cond_br %outer, ^evaluate, ^fallback
^evaluate:
  test.use %inner : i1
  cfg.cond_br %inner, ^selected, ^fallback
^selected:
  cfg.br ^merge(%selected: i1)
^fallback:
