// RUN: pass cfg-converge,cfg-converge

// A shared true arm has inverted predicate sense and must be factored before
// the forwarding block is a single-entry successor of the rebuilt decision.
func.def @transparent_true_arm(%outer: i1, %inner: i1, %input: i32, %fallback: i32) -> (i32) {
  cfg.cond_br %outer, ^fallback, ^evaluate
^evaluate:
  %value = scalar.addi %input, %input : i32
  cfg.cond_br %inner, ^fallback, ^selected
^selected:
  cfg.br ^merge(%value: i32)
^fallback:
  cfg.br ^merge(%fallback: i32)
^merge(%result: i32):
  func.return %result : i32
}

// ----
func.def @transparent_true_arm(%outer: i1, %inner: i1, %input: i32, %fallback: i32) -> (i32) {
  cfg.cond_br %outer, ^_bb2, ^evaluate
^evaluate:
  %value = scalar.addi %input, %input : i32
  cfg.br ^_bb3(%inner: i1, %value: i32)
^_bb2:
  %9 = scalar.constant 1 : i1
  %10 = scalar.constant 0 : i32
  cfg.br ^_bb3(%9: i1, %10: i32)
^_bb3(%7: i1, %8: i32):
  cfg.cond_br %7, ^fallback, ^selected
^selected:
  cfg.br ^merge(%8: i32)
^fallback:
  cfg.br ^merge(%fallback: i32)
^merge(%result: i32):
  func.return %result : i32
}

