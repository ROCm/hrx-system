^exit:
  func.return
}

// ====

// RUN: pass cfg-converge,cfg-converge

// Scalar captures travel through the inner join while both loop headers keep
// their original carried state and entry/backedge ownership.
func.def @nested_loop_capture(%outer: i1, %inner: i1, %repeat_inner: i1, %repeat_outer: i1, %input: i32) {
  cfg.br ^outer_header
^outer_header:
  cfg.br ^inner_header(%input: i32)
^inner_header(%state: i32):
  cfg.cond_br %outer, ^evaluate, ^fallback
^evaluate:
  %value = scalar.addi %state, %input : i32
  cfg.cond_br %inner, ^selected, ^fallback
^selected:
  test.use %value : i32
  cfg.br ^inner_latch
^fallback:
  test.use %state : i32
  cfg.br ^inner_latch
^inner_latch:
  cfg.cond_br %repeat_inner, ^inner_backedge, ^outer_latch
^inner_backedge:
  %next_state = scalar.addi %state, %input : i32
  cfg.br ^inner_header(%next_state: i32)
^outer_latch:
  cfg.cond_br %repeat_outer, ^outer_header, ^exit
^exit:
  func.return
}

// ----
func.def @nested_loop_capture(%outer: i1, %inner: i1, %repeat_inner: i1, %repeat_outer: i1, %input: i32) {
  cfg.br ^outer_header
^outer_header:
  cfg.br ^inner_header(%input: i32)
^inner_header(%state: i32):
  cfg.cond_br %outer, ^evaluate, ^_bb4
^evaluate:
  %value = scalar.addi %state, %input : i32
  cfg.br ^_bb5(%inner: i1, %value: i32)
^_bb4:
  %10 = scalar.constant 0 : i1
  %11 = scalar.constant 0 : i32
  cfg.br ^_bb5(%10: i1, %11: i32)
^_bb5(%8: i1, %9: i32):
  cfg.cond_br %8, ^selected, ^fallback
^selected:
  test.use %9 : i32
  cfg.br ^inner_latch
^fallback:
  test.use %state : i32
  cfg.br ^inner_latch
^inner_latch:
  cfg.cond_br %repeat_inner, ^inner_backedge, ^outer_latch
^inner_backedge:
  %next_state = scalar.addi %state, %input : i32
  cfg.br ^inner_header(%next_state: i32)
^outer_latch:
  cfg.cond_br %repeat_outer, ^outer_header, ^exit
^exit:
  func.return
}

// ====

// RUN: pass cfg-converge,cfg-converge

// A shared header and the loop's exit remain boundaries of the loop owner.
func.def @loop_boundaries(%enter: i1, %active: i1, %repeat: i1) {
  cfg.cond_br %enter, ^header, ^exit
^header:
  cfg.cond_br %active, ^body, ^exit
^body:
  test.use %active : i1
  cfg.cond_br %repeat, ^header, ^exit
^exit:
  func.return
}

// ====

// RUN: pass cfg-converge,cfg-converge

// Multiple entries into a cycle provide no dominating iteration boundary.
func.def @irreducible_overlap(%entry: i1, %first: i1, %second: i1, %last: i1, %repeat: i1) {
  cfg.cond_br %entry, ^left, ^right
^left:
  test.use %first : i1
  cfg.cond_br %first, ^shared, ^tail
^right:
  test.use %second : i1
  cfg.cond_br %second, ^left, ^shared
^shared:
  test.use %last : i1
  cfg.cond_br %last, ^tail, ^exit
^tail:
  cfg.cond_br %repeat, ^right, ^exit
^exit:
  func.return
}

// ====

// RUN: pass cfg-converge,cfg-converge

// The enclosing decision converges both the shared body and its upstream bypass.
func.def @upstream_bypass(%leader: i1, %report: i1, %capture: i1, %value: i32) {
  cfg.cond_br %leader, ^report, ^capture
^report:
  test.use %value : i32
  cfg.cond_br %report, ^publish, ^exit
^publish:
  test.use %value : i32
  cfg.br ^shared
^capture:
  cfg.cond_br %capture, ^shared, ^exit
^shared:
  test.use %value : i32
  cfg.br ^exit
^exit:
  func.return
}

// ----
func.def @upstream_bypass(%leader: i1, %report: i1, %capture: i1, %value: i32) {
  cfg.cond_br %leader, ^report, ^capture
^report:
  test.use %value : i32
  cfg.cond_br %report, ^publish, ^_bb5
^publish:
  test.use %value : i32
  cfg.br ^_bb4
^capture:
  cfg.br ^_bb6(%capture: i1)
^_bb4:
  %5 = scalar.constant 1 : i1
  cfg.br ^_bb6(%5: i1)
^_bb5:
  %6 = scalar.constant 0 : i1
  cfg.br ^_bb6(%6: i1)
^_bb6(%4: i1):
  cfg.cond_br %4, ^shared, ^exit
^shared:
  test.use %value : i32
  cfg.br ^exit
^exit:
  func.return
}

// ====

// RUN: pass cfg-converge,cfg-converge

// Exchanging the decision arms carries a true predicate on the upstream bypass.
func.def @upstream_bypass_true(%leader: i1, %report: i1, %capture: i1, %value: i32) {
  cfg.cond_br %leader, ^report, ^capture
^report:
  test.use %value : i32
  cfg.cond_br %report, ^exit, ^publish
^publish:
  test.use %value : i32
  cfg.br ^shared
^capture:
  cfg.cond_br %capture, ^exit, ^shared
^shared:
  test.use %value : i32
  cfg.br ^exit
^exit:
  func.return
}

// ----
func.def @upstream_bypass_true(%leader: i1, %report: i1, %capture: i1, %value: i32) {
  cfg.cond_br %leader, ^report, ^capture
^report:
  test.use %value : i32
  cfg.cond_br %report, ^_bb5, ^publish
^publish:
  test.use %value : i32
  cfg.br ^_bb4
^capture:
  cfg.br ^_bb6(%capture: i1)
^_bb4:
  %5 = scalar.constant 0 : i1
  cfg.br ^_bb6(%5: i1)
^_bb5:
  %6 = scalar.constant 1 : i1
  cfg.br ^_bb6(%6: i1)
^_bb6(%4: i1):
  cfg.cond_br %4, ^_bb8, ^shared
^shared:
  test.use %value : i32
  cfg.br ^exit
^_bb8:
  cfg.br ^exit
^exit:
  func.return
}

// ====

// RUN: pass cfg-converge,cfg-converge

// Upstream loop-local bypasses converge without redirecting the shared body's
// exit or the latch backedge into the predicate join.
func.def @loop_upstream_bypass(%running: i1, %leader: i1, %report: i1, %capture: i1, %value: i32) {
  cfg.br ^header
^header:
  cfg.cond_br %running, ^body, ^exit
^body:
  cfg.cond_br %leader, ^report, ^capture
^report:
  test.use %value : i32
  cfg.cond_br %report, ^publish, ^latch
^publish:
  test.use %value : i32
  cfg.br ^shared
^capture:
  cfg.cond_br %capture, ^shared, ^latch
^shared:
  test.use %value : i32
  cfg.br ^latch
^latch:
  cfg.br ^header
^exit:
  func.return
}

// ----
func.def @loop_upstream_bypass(%running: i1, %leader: i1, %report: i1, %capture: i1, %value: i32) {
  cfg.br ^header
^header:
  cfg.cond_br %running, ^body, ^exit
^body:
  cfg.cond_br %leader, ^report, ^capture
^report:
  test.use %value : i32
  cfg.cond_br %report, ^publish, ^_bb7
^publish:
  test.use %value : i32
  cfg.br ^_bb6
^capture:
  cfg.br ^_bb8(%capture: i1)
^_bb6:
  %6 = scalar.constant 1 : i1
  cfg.br ^_bb8(%6: i1)
^_bb7:
  %7 = scalar.constant 0 : i1
  cfg.br ^_bb8(%7: i1)
^_bb8(%5: i1):
  cfg.cond_br %5, ^shared, ^latch
^shared:
  test.use %value : i32
  cfg.br ^latch
^latch:
  cfg.br ^header
^exit:
  func.return
}

// ====

// RUN: pass cfg-converge,cfg-converge

// An outer bypass widens the join's parent. Values loaded only on active paths
// travel through the join; the bypass never performs the load and carries zero.
func.def @outer_bypass_capture(%enabled: i1, %leader: i1, %capture: i1, %input: view<1xi32>) {
  cfg.cond_br %enabled, ^setup, ^exit
^setup:
  %value = view.load %input[0] : view<1xi32> -> i32
  cfg.cond_br %leader, ^publish, ^capture
^publish:
  test.use %value : i32
  cfg.br ^shared
^capture:
  cfg.cond_br %capture, ^shared, ^exit
^shared:
  test.use %value : i32
  cfg.br ^exit
^exit:
  func.return
}

// ----
func.def @outer_bypass_capture(%enabled: i1, %leader: i1, %capture: i1, %input: view<1xi32>) {
  cfg.cond_br %enabled, ^setup, ^_bb5
^setup:
  %value = view.load %input[0] : view<1xi32> -> i32
  cfg.cond_br %leader, ^publish, ^capture
^publish:
  test.use %value : i32
  cfg.br ^_bb4
^capture:
  cfg.br ^_bb6(%capture: i1, %value: i32)
^_bb4:
  %7 = scalar.constant 1 : i1
  cfg.br ^_bb6(%7: i1, %value: i32)
^_bb5:
  %8 = scalar.constant 0 : i1
  %9 = scalar.constant 0 : i32
  cfg.br ^_bb6(%8: i1, %9: i32)
^_bb6(%5: i1, %6: i32):
  cfg.cond_br %5, ^shared, ^exit
^shared:
  test.use %6 : i32
  cfg.br ^exit
^exit:
  func.return
}

// ====

// RUN: pass cfg-converge,cfg-converge

// Shared extent providers remain available to block argument types.
func.def @argument_type_capture(%outer: i1, %inner: i1, %size: index, %seed: i32) {
  cfg.cond_br %outer, ^evaluate, ^fallback
^evaluate:
  cfg.cond_br %inner, ^selected, ^fallback
^selected:
  %tile = test.convert %seed : i32 -> tile<[%size]xf32>
  cfg.br ^carried(%tile: tile<[%size]xf32>)
^carried(%argument: tile<[%size]xf32>):
  test.use %argument : tile<[%size]xf32>
  cfg.br ^exit
^fallback:
  test.use %seed : i32
  cfg.br ^exit
^exit:
  func.return
}

// ----
func.def @argument_type_capture(%outer: i1, %inner: i1, %size: index, %seed: i32) {
  cfg.cond_br %outer, ^evaluate, ^_bb2
^evaluate:
  cfg.br ^_bb3(%inner: i1)
^_bb2:
  %7 = scalar.constant 0 : i1
  cfg.br ^_bb3(%7: i1)
^_bb3(%6: i1):
  cfg.cond_br %6, ^selected, ^fallback
^selected:
  %tile = test.convert %seed : i32 -> tile<[%size]xf32>
  cfg.br ^carried(%tile: tile<[%size]xf32>)
^carried(%argument: tile<[%size]xf32>):
  test.use %argument : tile<[%size]xf32>
  cfg.br ^exit
^fallback:
  test.use %seed : i32
  cfg.br ^exit
^exit:
  func.return
}
