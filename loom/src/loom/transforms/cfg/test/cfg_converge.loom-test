// RUN: pass cfg-converge,cfg-converge

// Only the decision moves; each short-circuit observation remains conditional.
func.def @and_or(%outer: i1, %inner: i1, %last: i1) -> (i1) {
  %selected = scalar.constant true : i1
  test.use %outer : i1
  cfg.cond_br %outer, ^evaluate, ^fallback
^evaluate:
  test.use %inner : i1
  cfg.cond_br %inner, ^selected, ^fallback
^selected:
  cfg.br ^merge(%selected: i1)
^fallback:
  test.use %last : i1
  cfg.br ^merge(%last: i1)
^merge(%result: i1):
  func.return %result : i1
}

// ----
func.def @and_or(%outer: i1, %inner: i1, %last: i1) -> (i1) {
  %selected = scalar.constant true : i1
  test.use %outer : i1
  cfg.cond_br %outer, ^evaluate, ^_bb2
^evaluate:
  test.use %inner : i1
  cfg.br ^_bb3(%inner: i1)
^_bb2:
  %7 = scalar.constant 0 : i1
  cfg.br ^_bb3(%7: i1)
^_bb3(%6: i1):
  cfg.cond_br %6, ^selected, ^fallback
^selected:
  cfg.br ^merge(%selected: i1)
^fallback:
  test.use %last : i1
  cfg.br ^merge(%last: i1)
^merge(%result: i1):
  func.return %result : i1
}

// ====

// The opposite nesting order carries a true incoming predicate.
func.def @or_and(%outer: i1, %inner: i1, %last: i1) -> (i1) {
  %rejected = scalar.constant false : i1
  test.use %outer : i1
  cfg.cond_br %outer, ^fallback, ^evaluate
^evaluate:
  test.use %inner : i1
  cfg.cond_br %inner, ^fallback, ^rejected
^rejected:
  cfg.br ^merge(%rejected: i1)
^fallback:
  test.use %last : i1
  cfg.br ^merge(%last: i1)
^merge(%result: i1):
  func.return %result : i1
}

// ----
func.def @or_and(%outer: i1, %inner: i1, %last: i1) -> (i1) {
  %rejected = scalar.constant false : i1
  test.use %outer : i1
  cfg.cond_br %outer, ^_bb2, ^evaluate
^evaluate:
  test.use %inner : i1
  cfg.br ^_bb3(%inner: i1)
^_bb2:
  %7 = scalar.constant 1 : i1
  cfg.br ^_bb3(%7: i1)
^_bb3(%6: i1):
  cfg.cond_br %6, ^fallback, ^rejected
^rejected:
  cfg.br ^merge(%rejected: i1)
^fallback:
  test.use %last : i1
  cfg.br ^merge(%last: i1)
^merge(%result: i1):
  func.return %result : i1
}

// ====

// Shared publication executes once after mutually exclusive predecessors.
func.def @shared_tail(%publish: i1, %active: i1, %value: i32) {
  cfg.cond_br %publish, ^publish, ^guard
^publish:
  test.use %value : i32
  cfg.br ^shared
^guard:
  cfg.cond_br %active, ^shared, ^exit
^shared:
  test.use %value : i32
  cfg.br ^exit
^exit:
  test.use %active : i1
  func.return
}

// ----
func.def @shared_tail(%publish: i1, %active: i1, %value: i32) {
  cfg.cond_br %publish, ^publish, ^guard
^publish:
  test.use %value : i32
  cfg.br ^_bb3
^guard:
  cfg.br ^_bb4(%active: i1)
^_bb3:
  %4 = scalar.constant 1 : i1
  cfg.br ^_bb4(%4: i1)
^_bb4(%3: i1):
  cfg.cond_br %3, ^shared, ^exit
^shared:
  test.use %value : i32
  cfg.br ^exit
^exit:
  test.use %active : i1
  func.return
}

// ====

// A loaded live-in gains a scalar carrier; the bypass supplies defined zero.
func.def @scalar_live_in(%outer: i1, %inner: i1, %input: view<1xi32>, %output: view<1xi32>, %fallback: i32) -> (i32) {
  cfg.cond_br %outer, ^evaluate, ^fallback
^evaluate:
  %loaded = view.load %input[0] : view<1xi32> -> i32
  view.store %loaded, %output[0] : i32, view<1xi32>
  cfg.cond_br %inner, ^selected, ^fallback
^selected:
  %sum = scalar.addi %loaded, %loaded : i32
  cfg.br ^merge(%sum: i32)
^fallback:
  test.use %fallback : i32
  cfg.br ^merge(%fallback: i32)
^merge(%result: i32):
  func.return %result : i32
}

// ----
func.def @scalar_live_in(%outer: i1, %inner: i1, %input: view<1xi32>, %output: view<1xi32>, %fallback: i32) -> (i32) {
  cfg.cond_br %outer, ^evaluate, ^_bb2
^evaluate:
  %loaded = view.load %input[0] : view<1xi32> -> i32
  view.store %loaded, %output[0] : i32, view<1xi32>
  cfg.br ^_bb3(%inner: i1, %loaded: i32)
^_bb2:
  %11 = scalar.constant 0 : i1
  %12 = scalar.constant 0 : i32
  cfg.br ^_bb3(%11: i1, %12: i32)
^_bb3(%9: i1, %10: i32):
  cfg.cond_br %9, ^selected, ^fallback
^selected:
  %sum = scalar.addi %10, %10 : i32
  cfg.br ^merge(%sum: i32)
^fallback:
  test.use %fallback : i32
  cfg.br ^merge(%fallback: i32)
^merge(%result: i32):
  func.return %result : i32
}

// ====

// Nested-region uses inherit the containing CFG block availability.
func.def @nested_capture(%outer: i1, %inner: i1, %input: f32) {
  cfg.cond_br %outer, ^evaluate, ^fallback
^evaluate:
  %value = scalar.addf %input, %input : f32
  cfg.cond_br %inner, ^selected, ^fallback
^selected:
  scf.if %inner {
    test.use %value : f32
  } else {
  }
  cfg.br ^exit
^fallback:
  test.use %input : f32
  cfg.br ^exit
^exit:
  func.return
}

// ----
func.def @nested_capture(%outer: i1, %inner: i1, %input: f32) {
  cfg.cond_br %outer, ^evaluate, ^_bb2
^evaluate:
  %value = scalar.addf %input, %input : f32
  cfg.br ^_bb3(%inner: i1, %value: f32)
^_bb2:
  %6 = scalar.constant 0 : i1
  %7 = scalar.constant 0.0 : f32
  cfg.br ^_bb3(%6: i1, %7: f32)
^_bb3(%4: i1, %5: f32):
  cfg.cond_br %4, ^selected, ^fallback
^selected:
  scf.if %inner {
    test.use %5 : f32
  } else {
  }
  cfg.br ^exit
^fallback:
  test.use %input : f32
  cfg.br ^exit
^exit:
  func.return
}

// ====

// Opaque live-ins retain their valid original CFG and ownership.
func.def @opaque_capture(%outer: i1, %inner: i1, %input: buffer, %output: view<1xi32>) {
  cfg.cond_br %outer, ^evaluate, ^fallback
^evaluate:
  %base = index.constant 0 : offset
  %view = buffer.view %input[%base] : buffer -> view<1xi32>
  cfg.cond_br %inner, ^selected, ^fallback
^selected:
  %value = view.load %view[0] : view<1xi32> -> i32
  view.store %value, %output[0] : i32, view<1xi32>
  cfg.br ^exit
^fallback:
  test.use %input : buffer
  cfg.br ^exit
^exit:
  func.return
}

// ----
func.def @opaque_capture(%outer: i1, %inner: i1, %input: buffer, %output: view<1xi32>) {
  cfg.cond_br %outer, ^evaluate, ^fallback
^evaluate:
  %base = index.constant 0 : offset
  %view = buffer.view %input[%base] : buffer -> view<1xi32>
  cfg.cond_br %inner, ^selected, ^fallback
^selected:
  %value = view.load %view[0] : view<1xi32> -> i32
  view.store %value, %output[0] : i32, view<1xi32>
  cfg.br ^exit
^fallback:
  test.use %input : buffer
  cfg.br ^exit
^exit:
  func.return
}

// ====

// Branch-local type identities cannot be replaced by scalar placeholders.
func.def @type_capture(%outer: i1, %inner: i1, %size: index, %seed: i32) {
  cfg.cond_br %outer, ^evaluate, ^fallback
^evaluate:
  %extent = index.add %size, %size : index
  cfg.cond_br %inner, ^selected, ^fallback
^selected:
  %tile = test.convert %seed : i32 -> tile<[%extent]xf32>
  test.use %tile : tile<[%extent]xf32>
  cfg.br ^exit
^fallback:
  test.use %seed : i32
  cfg.br ^exit
^exit:
  func.return
}

// ----
func.def @type_capture(%outer: i1, %inner: i1, %size: index, %seed: i32) {
  cfg.cond_br %outer, ^evaluate, ^fallback
^evaluate:
  %extent = index.add %size, %size : index
  cfg.cond_br %inner, ^selected, ^fallback
^selected:
  %tile = test.convert %seed : i32 -> tile<[%extent]xf32>
  test.use %tile : tile<[%extent]xf32>
  cfg.br ^exit
^fallback:
  test.use %seed : i32
  cfg.br ^exit
^exit:
  func.return
}

// ====

// References hidden in metadata participate in the same preflight.
func.def @attribute_capture(%outer: i1, %inner: i1, %size: index, %input: f32) {
  cfg.cond_br %outer, ^evaluate, ^fallback
^evaluate:
  %extent = index.add %size, %size : index
  cfg.cond_br %inner, ^selected, ^fallback
^selected:
  %annotated = test.attrs %input {shape = #test.options<mode = fast, element_type = vector<[%extent]xf32>>} : f32
  test.use %annotated : f32
  cfg.br ^exit
^fallback:
  test.use %input : f32
  cfg.br ^exit
^exit:
  func.return
}

// ----
func.def @attribute_capture(%outer: i1, %inner: i1, %size: index, %input: f32) {
  cfg.cond_br %outer, ^evaluate, ^fallback
^evaluate:
  %extent = index.add %size, %size : index
  cfg.cond_br %inner, ^selected, ^fallback
^selected:
  %annotated = test.attrs %input {shape = #test.options<mode = fast, element_type = vector<[%extent]xf32>>} : f32
  test.use %annotated : f32
  cfg.br ^exit
^fallback:
  test.use %input : f32
  cfg.br ^exit
^exit:
  func.return
}

// ====

// A shared branch-only fallback gets a private edge carrying the same value.
func.def @transparent_fallback(%outer: i1, %inner: i1, %input: i32, %fallback: i32) -> (i32) {
  cfg.cond_br %outer, ^evaluate, ^fallback
^evaluate:
  %value = scalar.addi %input, %input : i32
  cfg.cond_br %inner, ^selected, ^fallback
^selected:
  cfg.br ^merge(%value: i32)
^fallback:
  cfg.br ^merge(%fallback: i32)
^merge(%result: i32):
  func.return %result : i32
}

// ----
func.def @transparent_fallback(%outer: i1, %inner: i1, %input: i32, %fallback: i32) -> (i32) {
  cfg.cond_br %outer, ^evaluate, ^fallback
^evaluate:
  %value = scalar.addi %input, %input : i32
  cfg.cond_br %inner, ^selected, ^_bb5
^selected:
  cfg.br ^merge(%value: i32)
^fallback:
  cfg.br ^merge(%fallback: i32)
^merge(%result: i32):
  func.return %result : i32
^_bb5:
  cfg.br ^merge(%fallback: i32)
}

// ====

// Either predicate sense can isolate a branch-only arm without carrying
// local values through a new decision.
func.def @transparent_true_arm(%outer: i1, %inner: i1, %input: i32, %fallback: i32) -> (i32) {
  cfg.cond_br %outer, ^fallback, ^evaluate
^evaluate:
  %value = scalar.addi %input, %input : i32
  cfg.cond_br %inner, ^fallback, ^selected
^selected:
  cfg.br ^merge(%value: i32)
^fallback:
  cfg.br ^merge(%fallback: i32)
^merge(%result: i32):
  func.return %result : i32
}

// ----
func.def @transparent_true_arm(%outer: i1, %inner: i1, %input: i32, %fallback: i32) -> (i32) {
  cfg.cond_br %outer, ^fallback, ^evaluate
^evaluate:
  %value = scalar.addi %input, %input : i32
  cfg.cond_br %inner, ^_bb5, ^selected
^selected:
  cfg.br ^merge(%value: i32)
^fallback:
  cfg.br ^merge(%fallback: i32)
^merge(%result: i32):
  func.return %result : i32
^_bb5:
  cfg.br ^merge(%fallback: i32)
}

// ====

// A shared true continuation receives a dedicated forwarding arm after its
// upstream bypasses join, leaving both decision successors single-entry.
func.def @direct_true_continuation(%outer: i1, %inner: i1, %value: i32) {
  cfg.cond_br %outer, ^exit, ^evaluate
^evaluate:
  cfg.cond_br %inner, ^exit, ^selected
^selected:
  test.use %value : i32
  cfg.br ^exit
^exit:
  func.return
}

// ----
func.def @direct_true_continuation(%outer: i1, %inner: i1, %value: i32) {
  cfg.cond_br %outer, ^_bb2, ^evaluate
^evaluate:
  cfg.br ^_bb3(%inner: i1)
^_bb2:
  %4 = scalar.constant 1 : i1
  cfg.br ^_bb3(%4: i1)
^_bb3(%3: i1):
  cfg.cond_br %3, ^_bb5, ^selected
^selected:
  test.use %value : i32
  cfg.br ^exit
^_bb5:
  cfg.br ^exit
^exit:
  func.return
}

// ====

// Decisions within one loop iteration converge before reaching its latch.
func.def @loop_decision(%outer: i1, %inner: i1, %repeat: i1) {
  cfg.br ^header
^header:
  cfg.cond_br %outer, ^evaluate, ^fallback
^evaluate:
  test.use %inner : i1
  cfg.cond_br %inner, ^selected, ^fallback
^selected:
  test.use %outer : i1
  cfg.br ^latch
^fallback:
  test.use %repeat : i1
  cfg.br ^latch
^latch:
  cfg.cond_br %repeat, ^header, ^exit
^exit:
  func.return
}

// ----
func.def @loop_decision(%outer: i1, %inner: i1, %repeat: i1) {
  cfg.br ^header
^header:
  cfg.cond_br %outer, ^evaluate, ^_bb3
^evaluate:
  test.use %inner : i1
  cfg.br ^_bb4(%inner: i1)
^_bb3:
  %4 = scalar.constant 0 : i1
  cfg.br ^_bb4(%4: i1)
^_bb4(%3: i1):
  cfg.cond_br %3, ^selected, ^fallback
^selected:
  test.use %outer : i1
  cfg.br ^latch
^fallback:
  test.use %repeat : i1
  cfg.br ^latch
^latch:
  cfg.cond_br %repeat, ^header, ^exit
^exit:
  func.return
}

// ====

// A uniform selector still joins bypassed lanes from varying participation.
func.def @uniform_selector_with_partial_participation(%outer: i1, %last: i1) -> (i1) {
  %selected = scalar.constant true : i1
  %inner = scalar.constant true : i1
  test.use %outer : i1
  cfg.cond_br %outer, ^evaluate, ^fallback
^evaluate:
  test.use %inner : i1
  cfg.cond_br %inner, ^selected, ^fallback
^selected:
  cfg.br ^merge(%selected: i1)
^fallback:
  test.use %last : i1
  cfg.br ^merge(%last: i1)
^merge(%result: i1):
  func.return %result : i1
}

// ----
func.def @uniform_selector_with_partial_participation(%outer: i1, %last: i1) -> (i1) {
  %selected = scalar.constant true : i1
  %inner = scalar.constant true : i1
  test.use %outer : i1
  cfg.cond_br %outer, ^evaluate, ^_bb2
^evaluate:
  test.use %inner : i1
  cfg.br ^_bb3(%inner: i1)
^_bb2:
  %7 = scalar.constant 0 : i1
  cfg.br ^_bb3(%7: i1)
^_bb3(%6: i1):
  cfg.cond_br %6, ^selected, ^fallback
^selected:
  cfg.br ^merge(%selected: i1)
^fallback:
  test.use %last : i1
  cfg.br ^merge(%last: i1)
^merge(%result: i1):
  func.return %result : i1
}

// ====

// Uniform participation and selection retain direct scalar control.
func.def @fully_uniform_decisions(%last: i1) -> (i1) {
  %selected = scalar.constant true : i1
  %inner = scalar.constant true : i1
  %outer = scalar.constant true : i1
  test.use %outer : i1
  cfg.cond_br %outer, ^evaluate, ^fallback
^evaluate:
  test.use %inner : i1
  cfg.cond_br %inner, ^selected, ^fallback
^selected:
  cfg.br ^merge(%selected: i1)
^fallback:
  test.use %last : i1
  cfg.br ^merge(%last: i1)
^merge(%result: i1):
  func.return %result : i1
}

// ----
func.def @fully_uniform_decisions(%last: i1) -> (i1) {
  %selected = scalar.constant true : i1
  %inner = scalar.constant true : i1
  %outer = scalar.constant true : i1
  test.use %outer : i1
  cfg.cond_br %outer, ^evaluate, ^fallback
^evaluate:
  test.use %inner : i1
  cfg.cond_br %inner, ^selected, ^fallback
^selected:
  cfg.br ^merge(%selected: i1)
^fallback:
  test.use %last : i1
  cfg.br ^merge(%last: i1)
^merge(%result: i1):
  func.return %result : i1
}

// ====

// Factoring the final overlap inserts a constant-predicate alternative. That
// sibling's component order must not prevent factoring the preceding decision.
func.def @overlapping_siblings(%a: i1, %b: i1, %c: i1, %value: i32) {
  cfg.cond_br %a, ^first, ^guard
^first:
  test.use %value : i32
  cfg.br ^shared
^guard:
  cfg.cond_br %b, ^shared, ^last
^shared:
  test.use %value : i32
  cfg.cond_br %c, ^last, ^exit
^last:
  test.use %value : i32
  cfg.br ^exit
^exit:
  func.return
}

// ----
func.def @overlapping_siblings(%a: i1, %b: i1, %c: i1, %value: i32) {
  cfg.cond_br %a, ^first, ^guard
^first:
  test.use %value : i32
  cfg.br ^_bb3
^guard:
  cfg.br ^_bb4(%b: i1)
^_bb3:
  %7 = scalar.constant 1 : i1
  cfg.br ^_bb4(%7: i1)
^_bb4(%6: i1):
  cfg.cond_br %6, ^shared, ^_bb6
^shared:
  test.use %value : i32
  cfg.br ^_bb7(%c: i1)
^_bb6:
  %5 = scalar.constant 1 : i1
  cfg.br ^_bb7(%5: i1)
^_bb7(%4: i1):
  cfg.cond_br %4, ^last, ^exit
^last:
  test.use %value : i32
  cfg.br ^exit
^exit:
  func.return
}

// ====

// Reversing the arms and sibling layout preserves the same effect ownership.
func.def @overlapping_false_siblings(%a: i1, %b: i1, %c: i1, %value: i32) {
  cfg.cond_br %a, ^guard, ^first
^guard:
  cfg.cond_br %b, ^last, ^shared
^first:
  test.use %value : i32
  cfg.br ^shared
^shared:
  test.use %value : i32
  cfg.cond_br %c, ^exit, ^last
^last:
  test.use %value : i32
  cfg.br ^exit
^exit:
  func.return
}

// ----
func.def @overlapping_false_siblings(%a: i1, %b: i1, %c: i1, %value: i32) {
  cfg.cond_br %a, ^guard, ^first
^guard:
  cfg.br ^_bb4(%b: i1)
^first:
  test.use %value : i32
  cfg.br ^_bb3
^_bb3:
  %7 = scalar.constant 0 : i1
  cfg.br ^_bb4(%7: i1)
^_bb4(%6: i1):
  cfg.cond_br %6, ^_bb6, ^shared
^shared:
  test.use %value : i32
  cfg.br ^_bb7(%c: i1)
^_bb6:
  %5 = scalar.constant 0 : i1
  cfg.br ^_bb7(%5: i1)
^_bb7(%4: i1):
  cfg.cond_br %4, ^_bb9, ^last
^last:
  test.use %value : i32
  cfg.br ^exit
^_bb9:
  cfg.br ^exit
^exit:
  func.return
}

// ====

// Scalar captures travel through the inner join while both loop headers keep
// their original carried state and entry/backedge ownership.
func.def @nested_loop_capture(%outer: i1, %inner: i1, %repeat_inner: i1, %repeat_outer: i1, %input: i32) {
  cfg.br ^outer_header
^outer_header:
  cfg.br ^inner_header(%input: i32)
^inner_header(%state: i32):
  cfg.cond_br %outer, ^evaluate, ^fallback
^evaluate:
  %value = scalar.addi %state, %input : i32
  cfg.cond_br %inner, ^selected, ^fallback
^selected:
  test.use %value : i32
  cfg.br ^inner_latch
^fallback:
  test.use %state : i32
  cfg.br ^inner_latch
^inner_latch:
  cfg.cond_br %repeat_inner, ^inner_backedge, ^outer_latch
^inner_backedge:
  %next_state = scalar.addi %state, %input : i32
  cfg.br ^inner_header(%next_state: i32)
^outer_latch:
  cfg.cond_br %repeat_outer, ^outer_header, ^exit
^exit:
  func.return
}

// ----
func.def @nested_loop_capture(%outer: i1, %inner: i1, %repeat_inner: i1, %repeat_outer: i1, %input: i32) {
  cfg.br ^outer_header
^outer_header:
  cfg.br ^inner_header(%input: i32)
^inner_header(%state: i32):
  cfg.cond_br %outer, ^evaluate, ^_bb4
^evaluate:
  %value = scalar.addi %state, %input : i32
  cfg.br ^_bb5(%inner: i1, %value: i32)
^_bb4:
  %10 = scalar.constant 0 : i1
  %11 = scalar.constant 0 : i32
  cfg.br ^_bb5(%10: i1, %11: i32)
^_bb5(%8: i1, %9: i32):
  cfg.cond_br %8, ^selected, ^fallback
^selected:
  test.use %9 : i32
  cfg.br ^inner_latch
^fallback:
  test.use %state : i32
  cfg.br ^inner_latch
^inner_latch:
  cfg.cond_br %repeat_inner, ^inner_backedge, ^outer_latch
^inner_backedge:
  %next_state = scalar.addi %state, %input : i32
  cfg.br ^inner_header(%next_state: i32)
^outer_latch:
  cfg.cond_br %repeat_outer, ^outer_header, ^exit
^exit:
  func.return
}

// ====

// A shared header and the loop's exit remain boundaries of the loop owner.
func.def @loop_boundaries(%enter: i1, %active: i1, %repeat: i1) {
  cfg.cond_br %enter, ^header, ^exit
^header:
  cfg.cond_br %active, ^body, ^exit
^body:
  test.use %active : i1
  cfg.cond_br %repeat, ^header, ^exit
^exit:
  func.return
}

// ----
func.def @loop_boundaries(%enter: i1, %active: i1, %repeat: i1) {
  cfg.cond_br %enter, ^header, ^exit
^header:
  cfg.cond_br %active, ^body, ^_bb3
^body:
  test.use %active : i1
  cfg.cond_br %repeat, ^header, ^_bb3
^_bb3:
  cfg.br ^exit
^exit:
  func.return
}

// ====

// Multiple entries into a cycle provide no dominating iteration boundary.
func.def @irreducible_overlap(%entry: i1, %first: i1, %second: i1, %last: i1, %repeat: i1) {
  cfg.cond_br %entry, ^left, ^right
^left:
  test.use %first : i1
  cfg.cond_br %first, ^shared, ^tail
^right:
  test.use %second : i1
  cfg.cond_br %second, ^left, ^shared
^shared:
  test.use %last : i1
  cfg.cond_br %last, ^tail, ^exit
^tail:
  cfg.cond_br %repeat, ^right, ^exit
^exit:
  func.return
}

// ====

// The enclosing decision converges both the shared body and its upstream bypass.
func.def @upstream_bypass(%leader: i1, %report: i1, %capture: i1, %value: i32) {
  cfg.cond_br %leader, ^report, ^capture
^report:
  test.use %value : i32
  cfg.cond_br %report, ^publish, ^exit
^publish:
  test.use %value : i32
  cfg.br ^shared
^capture:
  cfg.cond_br %capture, ^shared, ^exit
^shared:
  test.use %value : i32
  cfg.br ^exit
^exit:
  func.return
}

// ----
func.def @upstream_bypass(%leader: i1, %report: i1, %capture: i1, %value: i32) {
  cfg.cond_br %leader, ^report, ^capture
^report:
  test.use %value : i32
  cfg.cond_br %report, ^publish, ^_bb5
^publish:
  test.use %value : i32
  cfg.br ^_bb4
^capture:
  cfg.br ^_bb6(%capture: i1)
^_bb4:
  %5 = scalar.constant 1 : i1
  cfg.br ^_bb6(%5: i1)
^_bb5:
  %6 = scalar.constant 0 : i1
  cfg.br ^_bb6(%6: i1)
^_bb6(%4: i1):
  cfg.cond_br %4, ^shared, ^exit
^shared:
  test.use %value : i32
  cfg.br ^exit
^exit:
  func.return
}

// ====

// Exchanging the decision arms carries a true predicate on the upstream bypass.
func.def @upstream_bypass_true(%leader: i1, %report: i1, %capture: i1, %value: i32) {
  cfg.cond_br %leader, ^report, ^capture
^report:
  test.use %value : i32
  cfg.cond_br %report, ^exit, ^publish
^publish:
  test.use %value : i32
  cfg.br ^shared
^capture:
  cfg.cond_br %capture, ^exit, ^shared
^shared:
  test.use %value : i32
  cfg.br ^exit
^exit:
  func.return
}

// ----
func.def @upstream_bypass_true(%leader: i1, %report: i1, %capture: i1, %value: i32) {
  cfg.cond_br %leader, ^report, ^capture
^report:
  test.use %value : i32
  cfg.cond_br %report, ^_bb5, ^publish
^publish:
  test.use %value : i32
  cfg.br ^_bb4
^capture:
  cfg.br ^_bb6(%capture: i1)
^_bb4:
  %5 = scalar.constant 0 : i1
  cfg.br ^_bb6(%5: i1)
^_bb5:
  %6 = scalar.constant 1 : i1
  cfg.br ^_bb6(%6: i1)
^_bb6(%4: i1):
  cfg.cond_br %4, ^_bb8, ^shared
^shared:
  test.use %value : i32
  cfg.br ^exit
^_bb8:
  cfg.br ^exit
^exit:
  func.return
}

// ====

// Upstream loop-local bypasses converge without redirecting the shared body's
// exit or the latch backedge into the predicate join.
func.def @loop_upstream_bypass(%running: i1, %leader: i1, %report: i1, %capture: i1, %value: i32) {
  cfg.br ^header
^header:
  cfg.cond_br %running, ^body, ^exit
^body:
  cfg.cond_br %leader, ^report, ^capture
^report:
  test.use %value : i32
  cfg.cond_br %report, ^publish, ^latch
^publish:
  test.use %value : i32
  cfg.br ^shared
^capture:
  cfg.cond_br %capture, ^shared, ^latch
^shared:
  test.use %value : i32
  cfg.br ^latch
^latch:
  cfg.br ^header
^exit:
  func.return
}

// ----
func.def @loop_upstream_bypass(%running: i1, %leader: i1, %report: i1, %capture: i1, %value: i32) {
  cfg.br ^header
^header:
  cfg.cond_br %running, ^body, ^exit
^body:
  cfg.cond_br %leader, ^report, ^capture
^report:
  test.use %value : i32
  cfg.cond_br %report, ^publish, ^_bb7
^publish:
  test.use %value : i32
  cfg.br ^_bb6
^capture:
  cfg.br ^_bb8(%capture: i1)
^_bb6:
  %6 = scalar.constant 1 : i1
  cfg.br ^_bb8(%6: i1)
^_bb7:
  %7 = scalar.constant 0 : i1
  cfg.br ^_bb8(%7: i1)
^_bb8(%5: i1):
  cfg.cond_br %5, ^shared, ^latch
^shared:
  test.use %value : i32
  cfg.br ^latch
^latch:
  cfg.br ^header
^exit:
  func.return
}

// ====

// An outer bypass widens the join's parent. Values loaded only on active paths
// travel through the join; the bypass never performs the load and carries zero.
func.def @outer_bypass_capture(%enabled: i1, %leader: i1, %capture: i1, %input: view<1xi32>) {
  cfg.cond_br %enabled, ^setup, ^exit
^setup:
  %value = view.load %input[0] : view<1xi32> -> i32
  cfg.cond_br %leader, ^publish, ^capture
^publish:
  test.use %value : i32
  cfg.br ^shared
^capture:
  cfg.cond_br %capture, ^shared, ^exit
^shared:
  test.use %value : i32
  cfg.br ^exit
^exit:
  func.return
}

// ----
func.def @outer_bypass_capture(%enabled: i1, %leader: i1, %capture: i1, %input: view<1xi32>) {
  cfg.cond_br %enabled, ^setup, ^_bb5
^setup:
  %value = view.load %input[0] : view<1xi32> -> i32
  cfg.cond_br %leader, ^publish, ^capture
^publish:
  test.use %value : i32
  cfg.br ^_bb4
^capture:
  cfg.br ^_bb6(%capture: i1, %value: i32)
^_bb4:
  %7 = scalar.constant 1 : i1
  cfg.br ^_bb6(%7: i1, %value: i32)
^_bb5:
  %8 = scalar.constant 0 : i1
  %9 = scalar.constant 0 : i32
  cfg.br ^_bb6(%8: i1, %9: i32)
^_bb6(%5: i1, %6: i32):
  cfg.cond_br %5, ^shared, ^exit
^shared:
  test.use %6 : i32
  cfg.br ^exit
^exit:
  func.return
}

// ====

// Shared extent providers remain available to block argument types.
func.def @argument_type_capture(%outer: i1, %inner: i1, %size: index, %seed: i32) {
  cfg.cond_br %outer, ^evaluate, ^fallback
^evaluate:
  cfg.cond_br %inner, ^selected, ^fallback
^selected:
  %tile = test.convert %seed : i32 -> tile<[%size]xf32>
  cfg.br ^carried(%tile: tile<[%size]xf32>)
^carried(%argument: tile<[%size]xf32>):
  test.use %argument : tile<[%size]xf32>
  cfg.br ^exit
^fallback:
  test.use %seed : i32
  cfg.br ^exit
^exit:
  func.return
}

// ----
func.def @argument_type_capture(%outer: i1, %inner: i1, %size: index, %seed: i32) {
  cfg.cond_br %outer, ^evaluate, ^_bb2
^evaluate:
  cfg.br ^_bb3(%inner: i1)
^_bb2:
  %7 = scalar.constant 0 : i1
  cfg.br ^_bb3(%7: i1)
^_bb3(%6: i1):
  cfg.cond_br %6, ^selected, ^fallback
^selected:
  %tile = test.convert %seed : i32 -> tile<[%size]xf32>
  cfg.br ^carried(%tile: tile<[%size]xf32>)
^carried(%argument: tile<[%size]xf32>):
  test.use %argument : tile<[%size]xf32>
  cfg.br ^exit
^fallback:
  test.use %seed : i32
  cfg.br ^exit
^exit:
  func.return
}

// ====

// A loop and its enclosing early-exit decision need distinct result frontiers.
// Isolate the loop exits behind one payload-preserving gateway before both
// paths reach the function result.
func.def @loop_exit_under_outer_bypass(%early: i1, %running: i1, %matched: i1, %early_value: i32, %matched_value: i32, %fallback: i32) -> (i32) {
  cfg.cond_br %early, ^early_exit, ^preheader
^early_exit:
  cfg.br ^result(%early_value: i32)
^preheader:
  cfg.br ^header
^header:
  cfg.cond_br %running, ^body, ^normal_exit
^body:
  cfg.cond_br %matched, ^matched_exit, ^latch
^matched_exit:
  cfg.br ^result(%matched_value: i32)
^latch:
  cfg.br ^header
^normal_exit:
  cfg.br ^result(%fallback: i32)
^result(%value: i32):
  func.return %value : i32
}

// ----
func.def @loop_exit_under_outer_bypass(%early: i1, %running: i1, %matched: i1, %early_value: i32, %matched_value: i32, %fallback: i32) -> (i32) {
  cfg.cond_br %early, ^early_exit, ^preheader
^early_exit:
  cfg.br ^result(%early_value: i32)
^preheader:
  cfg.br ^header
^header:
  cfg.cond_br %running, ^body, ^normal_exit
^body:
  cfg.cond_br %matched, ^matched_exit, ^latch
^matched_exit:
  cfg.br ^_bb8(%matched_value: i32)
^latch:
  cfg.br ^header
^normal_exit:
  cfg.br ^_bb8(%fallback: i32)
^_bb8(%8: i32):
  cfg.br ^result(%8: i32)
^result(%value: i32):
  func.return %value : i32
}

// ====

// Independent loops retain separate, payload-preserving exit gateways even
// when their exit regions reach the same result block.
func.def @disjoint_loop_frontiers(%left: i1, %running: i1, %matched: i1, %early_value: i32, %fallback: i32) -> (i32) {
  cfg.cond_br %left, ^left_header, ^right_header
^left_header:
  cfg.cond_br %running, ^left_body, ^left_normal
^left_body:
  cfg.cond_br %matched, ^left_matched, ^left_latch
^left_matched:
  cfg.br ^result(%early_value: i32)
^left_latch:
  cfg.br ^left_header
^left_normal:
  cfg.br ^result(%fallback: i32)
^right_header:
  cfg.cond_br %running, ^right_body, ^right_normal
^right_body:
  cfg.cond_br %matched, ^right_matched, ^right_latch
^right_matched:
  cfg.br ^result(%fallback: i32)
^right_latch:
  cfg.br ^right_header
^right_normal:
  cfg.br ^result(%early_value: i32)
^result(%value: i32):
  func.return %value : i32
}

// ----
func.def @disjoint_loop_frontiers(%left: i1, %running: i1, %matched: i1, %early_value: i32, %fallback: i32) -> (i32) {
  cfg.cond_br %left, ^left_header, ^right_header
^left_header:
  cfg.cond_br %running, ^left_body, ^left_normal
^left_body:
  cfg.cond_br %matched, ^left_matched, ^left_latch
^left_matched:
  cfg.br ^_bb12(%early_value: i32)
^left_latch:
  cfg.br ^left_header
^left_normal:
  cfg.br ^_bb12(%fallback: i32)
^right_header:
  cfg.cond_br %running, ^right_body, ^right_normal
^right_body:
  cfg.cond_br %matched, ^right_matched, ^right_latch
^right_matched:
  cfg.br ^_bb11(%fallback: i32)
^right_latch:
  cfg.br ^right_header
^right_normal:
  cfg.br ^_bb11(%early_value: i32)
^_bb11(%7: i32):
  cfg.br ^result(%7: i32)
^_bb12(%8: i32):
  cfg.br ^result(%8: i32)
^result(%value: i32):
  func.return %value : i32
}

// ====

// Shared exit regions are not owned by either loop. A gateway after them would
// still be shared, so it cannot isolate either loop's exit frontier.
func.def @shared_loop_exit_regions(%left: i1, %running: i1, %matched: i1, %early_value: i32, %fallback: i32) -> (i32) {
  cfg.cond_br %left, ^left_header, ^right_header
^left_header:
  cfg.cond_br %running, ^left_body, ^normal
^left_body:
  cfg.cond_br %matched, ^found, ^left_latch
^left_latch:
  cfg.br ^left_header
^right_header:
  cfg.cond_br %running, ^right_body, ^normal
^right_body:
  cfg.cond_br %matched, ^found, ^right_latch
^right_latch:
  cfg.br ^right_header
^found:
  cfg.br ^result(%early_value: i32)
^normal:
  cfg.br ^result(%fallback: i32)
^result(%value: i32):
  func.return %value : i32
}

// ----
func.def @shared_loop_exit_regions(%left: i1, %running: i1, %matched: i1, %early_value: i32, %fallback: i32) -> (i32) {
  cfg.cond_br %left, ^left_header, ^right_header
^left_header:
  cfg.cond_br %running, ^left_body, ^normal
^left_body:
  cfg.cond_br %matched, ^found, ^left_latch
^left_latch:
  cfg.br ^left_header
^right_header:
  cfg.cond_br %running, ^right_body, ^_bb12
^right_body:
  cfg.cond_br %matched, ^_bb13, ^right_latch
^right_latch:
  cfg.br ^right_header
^found:
  cfg.br ^_bb10(%early_value: i32)
^normal:
  cfg.br ^_bb10(%fallback: i32)
^_bb9(%7: i32):
  cfg.br ^result(%7: i32)
^_bb10(%8: i32):
  cfg.br ^result(%8: i32)
^result(%value: i32):
  func.return %value : i32
^_bb12:
  cfg.br ^_bb9(%fallback: i32)
^_bb13:
  cfg.br ^_bb9(%early_value: i32)
}

// ====

// A gateway instantiates the continuation's complete type scheme: its tile
// refers to its own extent argument, which dominates the forwarded use.
func.def @dependent_loop_frontier(%early: i1, %running: i1, %matched: i1, %size: index, %tile: tile<[%size]xf32>) {
  cfg.cond_br %early, ^early_exit, ^header
^early_exit:
  cfg.br ^result(%size: index, %tile: tile<[%size]xf32>)
^header:
  cfg.cond_br %running, ^body, ^normal_exit
^body:
  cfg.cond_br %matched, ^matched_exit, ^latch
^matched_exit:
  cfg.br ^result(%size: index, %tile: tile<[%size]xf32>)
^latch:
  cfg.br ^header
^normal_exit:
  cfg.br ^result(%size: index, %tile: tile<[%size]xf32>)
^result(%extent: index, %payload: tile<[%extent]xf32>):
  test.use %payload : tile<[%extent]xf32>
  func.return
}

// ----
func.def @dependent_loop_frontier(%early: i1, %running: i1, %matched: i1, %size: index, %tile: tile<[%size]xf32>) {
  cfg.cond_br %early, ^early_exit, ^header
^early_exit:
  cfg.br ^result(%size: index, %tile: tile<[%size]xf32>)
^header:
  cfg.cond_br %running, ^body, ^normal_exit
^body:
  cfg.cond_br %matched, ^matched_exit, ^latch
^matched_exit:
  cfg.br ^_bb7(%size: index, %tile: tile<[%size]xf32>)
^latch:
  cfg.br ^header
^normal_exit:
  cfg.br ^_bb7(%size: index, %tile: tile<[%size]xf32>)
^_bb7(%7: index, %8: tile<[%7]xf32>):
  cfg.br ^result(%7: index, %8: tile<[%7]xf32>)
^result(%extent: index, %payload: tile<[%extent]xf32>):
  test.use %payload : tile<[%extent]xf32>
  func.return
}

// ====

// The first loop's exit region contains the second loop's frontier. Publish
// one gateway before replanning the overlapping frontier against the new CFG.
func.def @overlapping_loop_frontiers(%early: i1, %running: i1, %matched: i1, %enable_tail: i1, %found: i32, %fallback: i32) -> (i32) {
  cfg.cond_br %early, ^early_exit, ^first_header
^early_exit:
  cfg.br ^result(%fallback: i32)
^first_header:
  cfg.cond_br %running, ^first_body, ^after_first
^first_body:
  cfg.cond_br %matched, ^first_exit, ^first_latch
^first_latch:
  cfg.br ^first_header
^first_exit:
  cfg.br ^result(%found: i32)
^after_first:
  cfg.cond_br %enable_tail, ^tail_header, ^tail_bypass
^tail_bypass:
  cfg.br ^result(%fallback: i32)
^tail_header:
  cfg.cond_br %running, ^tail_body, ^tail_normal
^tail_body:
  cfg.cond_br %matched, ^tail_found, ^tail_latch
^tail_latch:
  cfg.br ^tail_header
^tail_found:
  cfg.br ^result(%found: i32)
^tail_normal:
  cfg.br ^result(%fallback: i32)
^result(%value: i32):
  func.return %value : i32
}

// ----
func.def @overlapping_loop_frontiers(%early: i1, %running: i1, %matched: i1, %enable_tail: i1, %found: i32, %fallback: i32) -> (i32) {
  cfg.cond_br %early, ^early_exit, ^first_header
^early_exit:
  cfg.br ^result(%fallback: i32)
^first_header:
  cfg.cond_br %running, ^first_body, ^after_first
^first_body:
  cfg.cond_br %matched, ^first_exit, ^first_latch
^first_latch:
  cfg.br ^first_header
^first_exit:
  cfg.br ^_bb14(%found: i32)
^after_first:
  cfg.cond_br %enable_tail, ^tail_header, ^tail_bypass
^tail_bypass:
  cfg.br ^_bb14(%fallback: i32)
^tail_header:
  cfg.cond_br %running, ^tail_body, ^tail_normal
^tail_body:
  cfg.cond_br %matched, ^tail_found, ^tail_latch
^tail_latch:
  cfg.br ^tail_header
^tail_found:
  cfg.br ^_bb13(%found: i32)
^tail_normal:
  cfg.br ^_bb13(%fallback: i32)
^_bb13(%8: i32):
  cfg.br ^_bb14(%8: i32)
^_bb14(%9: i32):
  cfg.br ^result(%9: i32)
^result(%value: i32):
  func.return %value : i32
}

// ====

// An earlier true edge and a later false edge share the same result. Splitting
// only the forwarding edge keeps intermediate arms and their effects intact.
func.def @shared_switch_result(%first: i1, %second: i1, %third: i1, %original: i32, %other: i32) -> (i32) {
  cfg.cond_br %first, ^unchanged, ^second
^second:
  test.use %second : i1
  cfg.cond_br %second, ^middle, ^third
^third:
  cfg.cond_br %third, ^last, ^unchanged
^unchanged:
  cfg.br ^result(%original: i32)
^middle:
  test.use %other : i32
  cfg.br ^result(%other: i32)
^last:
  %sum = scalar.addi %original, %other : i32
  cfg.br ^result(%sum: i32)
^result(%value: i32):
  func.return %value : i32
}

// The outgoing tuple may include references and dependent shaped types. No
// value or type moves across its defining control path.
func.def @forwarding_tuple(%outer: i1, %inner: i1, %size: index, %input: view<[%size]xf32>, %output: buffer, %lanes: vector<4xi32>) -> (%result_extent: index, view<[%result_extent]xf32>, buffer, vector<4xi32>) {
  cfg.cond_br %outer, ^fallback, ^evaluate
^evaluate:
  cfg.cond_br %inner, ^work, ^fallback
^work:
  test.use %lanes : vector<4xi32>
  cfg.br ^result(%size: index, %input: view<[%size]xf32>, %output: buffer, %lanes: vector<4xi32>)
^fallback:
  cfg.br ^result(%size: index, %input: view<[%size]xf32>, %output: buffer, %lanes: vector<4xi32>)
^result(%extent: index, %view: view<[%extent]xf32>, %buffer: buffer, %values: vector<4xi32>):
  func.return %extent, %view, %buffer, %values : index, view<[%extent]xf32>, buffer, vector<4xi32>
}

// ----
func.def @shared_switch_result(%first: i1, %second: i1, %third: i1, %original: i32, %other: i32) -> (i32) {
  cfg.cond_br %first, ^unchanged, ^second
^second:
  test.use %second : i1
  cfg.cond_br %second, ^middle, ^third
^third:
  cfg.cond_br %third, ^last, ^_bb7
^unchanged:
  cfg.br ^result(%original: i32)
^middle:
  test.use %other : i32
  cfg.br ^result(%other: i32)
^last:
  %sum = scalar.addi %original, %other : i32
  cfg.br ^result(%sum: i32)
^result(%value: i32):
  func.return %value : i32
^_bb7:
  cfg.br ^result(%original: i32)
}

func.def @forwarding_tuple(%outer: i1, %inner: i1, %size: index, %input: view<[%size]xf32>, %output: buffer, %lanes: vector<4xi32>) -> (%result_extent: index, view<[%result_extent]xf32>, buffer, vector<4xi32>) {
  cfg.cond_br %outer, ^fallback, ^evaluate
^evaluate:
  cfg.cond_br %inner, ^work, ^_bb5
^work:
  test.use %lanes : vector<4xi32>
  cfg.br ^result(%size: index, %input: view<[%size]xf32>, %output: buffer, %lanes: vector<4xi32>)
^fallback:
  cfg.br ^result(%size: index, %input: view<[%size]xf32>, %output: buffer, %lanes: vector<4xi32>)
^result(%extent: index, %view: view<[%extent]xf32>, %buffer: buffer, %values: vector<4xi32>):
  func.return %extent, %view, %buffer, %values : index, view<[%extent]xf32>, buffer, vector<4xi32>
^_bb5:
  cfg.br ^result(%size: index, %input: view<[%size]xf32>, %output: buffer, %lanes: vector<4xi32>)
}
