^_bb6:
  %5 = scalar.constant 0 : i1
  cfg.br ^_bb7(%5: i1)
^_bb7(%4: i1):
  cfg.cond_br %4, ^_bb9, ^last
^last:
  test.use %value : i32
  cfg.br ^exit
^_bb9:
