// RUN: pass cfg-converge,cfg-converge

// Factoring the final overlap inserts a constant-predicate alternative. That
// sibling's component order must not prevent factoring the preceding decision.
func.def @overlapping_siblings(%a: i1, %b: i1, %c: i1, %value: i32) {
  cfg.cond_br %a, ^first, ^guard
^first:
  test.use %value : i32
  cfg.br ^shared
^guard:
  cfg.cond_br %b, ^shared, ^last
^shared:
  test.use %value : i32
  cfg.cond_br %c, ^last, ^exit
^last:
  test.use %value : i32
  cfg.br ^exit
^exit:
  func.return
}

// ----
func.def @overlapping_siblings(%a: i1, %b: i1, %c: i1, %value: i32) {
  cfg.cond_br %a, ^first, ^guard
^first:
  test.use %value : i32
  cfg.br ^_bb3
^guard:
  cfg.br ^_bb4(%b: i1)
^_bb3:
  %7 = scalar.constant 1 : i1
  cfg.br ^_bb4(%7: i1)
^_bb4(%6: i1):
  cfg.cond_br %6, ^shared, ^_bb6
^shared:
  test.use %value : i32
  cfg.br ^_bb7(%c: i1)
^_bb6:
  %5 = scalar.constant 1 : i1
  cfg.br ^_bb7(%5: i1)
^_bb7(%4: i1):
  cfg.cond_br %4, ^last, ^exit
^last:
  test.use %value : i32
  cfg.br ^exit
^exit:
  func.return
}

