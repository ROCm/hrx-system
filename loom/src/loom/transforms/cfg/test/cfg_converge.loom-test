// RUN: pass cfg-converge,cfg-converge

// Decisions within one loop iteration converge before reaching its latch.
func.def @loop_decision(%outer: i1, %inner: i1, %repeat: i1) {
  cfg.br ^header
^header:
  cfg.cond_br %outer, ^evaluate, ^fallback
^evaluate:
  test.use %inner : i1
  cfg.cond_br %inner, ^selected, ^fallback
^selected:
  test.use %outer : i1
  cfg.br ^latch
^fallback:
  test.use %repeat : i1
  cfg.br ^latch
^latch:
  cfg.cond_br %repeat, ^header, ^exit
^exit:
  func.return
}

// ----
func.def @loop_decision(%outer: i1, %inner: i1, %repeat: i1) {
  cfg.br ^header
^header:
  cfg.cond_br %outer, ^evaluate, ^_bb3
^evaluate:
  test.use %inner : i1
  cfg.br ^_bb4(%inner: i1)
^_bb3:
  %4 = scalar.constant 0 : i1
  cfg.br ^_bb4(%4: i1)
^_bb4(%3: i1):
  cfg.cond_br %3, ^selected, ^fallback
^selected:
  test.use %outer : i1
  cfg.br ^latch
^fallback:
  test.use %repeat : i1
  cfg.br ^latch
^latch:
  cfg.cond_br %repeat, ^header, ^exit
^exit:
  func.return
}

