// RUN: pass cfg-converge,cfg-converge

// Transparent shared fallback already has an explicit value continuation.
func.def @transparent_fallback(%outer: i1, %inner: i1, %input: i32, %fallback: i32) -> (i32) {
  cfg.cond_br %outer, ^evaluate, ^fallback
^evaluate:
  %value = scalar.addi %input, %input : i32
  cfg.cond_br %inner, ^selected, ^fallback
^selected:
  cfg.br ^merge(%value: i32)
^fallback:
  cfg.br ^merge(%fallback: i32)
^merge(%result: i32):
  func.return %result : i32
}

// ----
func.def @transparent_fallback(%outer: i1, %inner: i1, %input: i32, %fallback: i32) -> (i32) {
  cfg.cond_br %outer, ^evaluate, ^fallback
^evaluate:
  %value = scalar.addi %input, %input : i32
  cfg.cond_br %inner, ^selected, ^fallback
^selected:
  cfg.br ^merge(%value: i32)
^fallback:
  cfg.br ^merge(%fallback: i32)
^merge(%result: i32):
  func.return %result : i32
}

// ====

// RUN: pass cfg-converge,cfg-converge

// Cyclic decisions remain owned by loop lowering.
func.def @loop_decision(%outer: i1, %inner: i1, %repeat: i1) {
  cfg.br ^header
^header:
  cfg.cond_br %outer, ^evaluate, ^fallback
^evaluate:
  test.use %inner : i1
  cfg.cond_br %inner, ^selected, ^fallback
^selected:
  test.use %outer : i1
  cfg.br ^latch
^fallback:
  test.use %repeat : i1
  cfg.br ^latch
^latch:
  cfg.cond_br %repeat, ^header, ^exit
^exit:
  func.return
}

// ----
func.def @loop_decision(%outer: i1, %inner: i1, %repeat: i1) {
  cfg.br ^header
^header:
  cfg.cond_br %outer, ^evaluate, ^fallback
^evaluate:
  test.use %inner : i1
  cfg.cond_br %inner, ^selected, ^fallback
^selected:
  test.use %outer : i1
  cfg.br ^latch
^fallback:
  test.use %repeat : i1
  cfg.br ^latch
^latch:
  cfg.cond_br %repeat, ^header, ^exit
^exit:
  func.return
}

