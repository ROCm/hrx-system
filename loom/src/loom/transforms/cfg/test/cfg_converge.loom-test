// RUN: pass cfg-converge,cfg-converge

// A shared true continuation receives a dedicated forwarding arm after its
// upstream bypasses join, leaving both decision successors single-entry.
func.def @direct_true_continuation(%outer: i1, %inner: i1, %value: i32) {
  cfg.cond_br %outer, ^exit, ^evaluate
^evaluate:
  cfg.cond_br %inner, ^exit, ^selected
^selected:
  test.use %value : i32
  cfg.br ^exit
^exit:
  func.return
}

// ----
func.def @direct_true_continuation(%outer: i1, %inner: i1, %value: i32) {
  cfg.cond_br %outer, ^_bb2, ^evaluate
^evaluate:
  cfg.br ^_bb3(%inner: i1)
^_bb2:
  %4 = scalar.constant 1 : i1
  cfg.br ^_bb3(%4: i1)
^_bb3(%3: i1):
  cfg.cond_br %3, ^_bb5, ^selected
^selected:
  test.use %value : i32
  cfg.br ^exit
^_bb5:
  cfg.br ^exit
^exit:
  func.return
}

