// RUN: pass cfg-converge,cfg-converge

// A uniform selector still joins bypassed lanes from varying participation.
func.def @uniform_selector_with_partial_participation(%outer: i1, %last: i1) -> (i1) {
  %selected = scalar.constant true : i1
  %inner = scalar.constant true : i1
  test.use %outer : i1
  cfg.cond_br %outer, ^evaluate, ^fallback
^evaluate:
  test.use %inner : i1
  cfg.cond_br %inner, ^selected, ^fallback
^selected:
  cfg.br ^merge(%selected: i1)
^fallback:
  test.use %last : i1
  cfg.br ^merge(%last: i1)
^merge(%result: i1):
  func.return %result : i1
}

// ----
func.def @uniform_selector_with_partial_participation(%outer: i1, %last: i1) -> (i1) {
  %selected = scalar.constant true : i1
  %inner = scalar.constant true : i1
  test.use %outer : i1
  cfg.cond_br %outer, ^evaluate, ^_bb2
^evaluate:
  test.use %inner : i1
  cfg.br ^_bb3(%inner: i1)
^_bb2:
  %7 = scalar.constant 0 : i1
  cfg.br ^_bb3(%7: i1)
^_bb3(%6: i1):
  cfg.cond_br %6, ^selected, ^fallback
^selected:
  cfg.br ^merge(%selected: i1)
^fallback:
  test.use %last : i1
  cfg.br ^merge(%last: i1)
^merge(%result: i1):
  func.return %result : i1
}

