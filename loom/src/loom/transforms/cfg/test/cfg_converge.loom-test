// RUN: pass cfg-converge,cfg-converge

// Opaque live-ins retain their valid original CFG and ownership.
func.def @opaque_capture(%outer: i1, %inner: i1, %input: buffer, %output: view<1xi32>) {
  cfg.cond_br %outer, ^evaluate, ^fallback
^evaluate:
  %base = index.constant 0 : offset
  %view = buffer.view %input[%base] : buffer -> view<1xi32>
  cfg.cond_br %inner, ^selected, ^fallback
^selected:
  %value = view.load %view[0] : view<1xi32> -> i32
  view.store %value, %output[0] : i32, view<1xi32>
  cfg.br ^exit
^fallback:
  test.use %input : buffer
  cfg.br ^exit
^exit:
  func.return
}

// ----
func.def @opaque_capture(%outer: i1, %inner: i1, %input: buffer, %output: view<1xi32>) {
  cfg.cond_br %outer, ^evaluate, ^fallback
^evaluate:
  %base = index.constant 0 : offset
  %view = buffer.view %input[%base] : buffer -> view<1xi32>
  cfg.cond_br %inner, ^selected, ^fallback
^selected:
  %value = view.load %view[0] : view<1xi32> -> i32
  view.store %value, %output[0] : i32, view<1xi32>
  cfg.br ^exit
^fallback:
  test.use %input : buffer
  cfg.br ^exit
^exit:
  func.return
}

