// RUN: pass cfg-converge,cfg-converge

// Nested-region uses inherit the containing CFG block availability.
func.def @nested_capture(%outer: i1, %inner: i1, %input: f32) {
  cfg.cond_br %outer, ^evaluate, ^fallback
^evaluate:
  %value = scalar.addf %input, %input : f32
  cfg.cond_br %inner, ^selected, ^fallback
^selected:
  scf.if %inner {
    test.use %value : f32
  } else {
  }
  cfg.br ^exit
^fallback:
  test.use %input : f32
  cfg.br ^exit
^exit:
  func.return
}

// ----
func.def @nested_capture(%outer: i1, %inner: i1, %input: f32) {
  cfg.cond_br %outer, ^evaluate, ^_bb2
^evaluate:
  %value = scalar.addf %input, %input : f32
  cfg.br ^_bb3(%inner: i1, %value: f32)
^_bb2:
  %6 = scalar.constant 0 : i1
  %7 = scalar.constant 0.0 : f32
  cfg.br ^_bb3(%6: i1, %7: f32)
^_bb3(%4: i1, %5: f32):
  cfg.cond_br %4, ^selected, ^fallback
^selected:
  scf.if %inner {
    test.use %5 : f32
  } else {
  }
  cfg.br ^exit
^fallback:
  test.use %input : f32
  cfg.br ^exit
^exit:
  func.return
}

