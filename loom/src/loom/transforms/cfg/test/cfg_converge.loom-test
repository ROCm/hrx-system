// RUN: pass cfg-converge,cfg-converge

// References hidden in metadata participate in the same preflight.
func.def @attribute_capture(%outer: i1, %inner: i1, %size: index, %input: f32) {
  cfg.cond_br %outer, ^evaluate, ^fallback
^evaluate:
  %extent = index.add %size, %size : index
  cfg.cond_br %inner, ^selected, ^fallback
^selected:
  %annotated = test.attrs %input {shape = #test.options<mode = fast, element_type = vector<[%extent]xf32>>} : f32
  test.use %annotated : f32
  cfg.br ^exit
^fallback:
  test.use %input : f32
  cfg.br ^exit
^exit:
  func.return
}

// ----
func.def @attribute_capture(%outer: i1, %inner: i1, %size: index, %input: f32) {
  cfg.cond_br %outer, ^evaluate, ^fallback
^evaluate:
  %extent = index.add %size, %size : index
  cfg.cond_br %inner, ^selected, ^fallback
^selected:
  %annotated = test.attrs %input {shape = #test.options<mode = fast, element_type = vector<[%extent]xf32>>} : f32
  test.use %annotated : f32
  cfg.br ^exit
^fallback:
  test.use %input : f32
  cfg.br ^exit
^exit:
  func.return
}

