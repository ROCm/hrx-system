func.def public @bulk_copy(%source: buffer, %source_offset: offset, %target: buffer, %target_offset: offset, %length: offset) {
  buffer.copy %source[%source_offset], %target[%target_offset], %length
  func.return
}

func.def public @bulk_fill_i8(%target: buffer, %target_offset: offset, %length: offset, %bits: i64) {
  %raw = scalar.trunci %bits : i64 to i8
  buffer.fill %raw, %target[%target_offset], %length : i8
  func.return
}

func.def public @bulk_fill_i16(%target: buffer, %target_offset: offset, %length: offset, %bits: i64) {
  %raw = scalar.trunci %bits : i64 to i16
  buffer.fill %raw, %target[%target_offset], %length : i16
  func.return
}

func.def public @bulk_fill_i32(%target: buffer, %target_offset: offset, %length: offset, %bits: i64) {
  %raw = scalar.trunci %bits : i64 to i32
  buffer.fill %raw, %target[%target_offset], %length : i32
  func.return
}

func.def public @bulk_fill_i64(%target: buffer, %target_offset: offset, %length: offset, %bits: i64) {
  buffer.fill %bits, %target[%target_offset], %length : i64
  func.return
}

func.def public @bulk_fill_f8E4M3(%target: buffer, %target_offset: offset, %length: offset, %bits: i64) {
  %raw = scalar.trunci %bits : i64 to i8
  %pattern = scalar.bitcast %raw : i8 to f8E4M3
  buffer.fill %pattern, %target[%target_offset], %length : f8E4M3
  func.return
}

func.def public @bulk_fill_f8E5M2(%target: buffer, %target_offset: offset, %length: offset, %bits: i64) {
  %raw = scalar.trunci %bits : i64 to i8
  %pattern = scalar.bitcast %raw : i8 to f8E5M2
  buffer.fill %pattern, %target[%target_offset], %length : f8E5M2
  func.return
}

func.def public @bulk_fill_f16(%target: buffer, %target_offset: offset, %length: offset, %bits: i64) {
  %raw = scalar.trunci %bits : i64 to i16
  %pattern = scalar.bitcast %raw : i16 to f16
  buffer.fill %pattern, %target[%target_offset], %length : f16
  func.return
}

func.def public @bulk_fill_bf16(%target: buffer, %target_offset: offset, %length: offset, %bits: i64) {
  %raw = scalar.trunci %bits : i64 to i16
  %pattern = scalar.bitcast %raw : i16 to bf16
  buffer.fill %pattern, %target[%target_offset], %length : bf16
  func.return
}

func.def public @bulk_fill_f32(%target: buffer, %target_offset: offset, %length: offset, %bits: i64) {
  %raw = scalar.trunci %bits : i64 to i32
  %pattern = scalar.bitcast %raw : i32 to f32
  buffer.fill %pattern, %target[%target_offset], %length : f32
  func.return
}

func.def public @bulk_fill_f64(%target: buffer, %target_offset: offset, %length: offset, %bits: i64) {
  %pattern = scalar.bitcast %bits : i64 to f64
  buffer.fill %pattern, %target[%target_offset], %length : f64
  func.return
}

func.def public @bulk_compare(%left: buffer, %left_offset: offset, %right: buffer, %right_offset: offset, %length: offset) -> (i32) {
  %order = buffer.compare %left[%left_offset], %right[%right_offset], %length
  func.return %order : i32
}

func.def public @bulk_compare3(%left: buffer, %left_offset: offset, %right: buffer, %right_offset: offset) -> (i32) {
  %length = index.constant 3 : offset
  %order = buffer.compare %left[%left_offset], %right[%right_offset], %length
  func.return %order : i32
}

func.def public @bulk_compare5(%left: buffer, %left_offset: offset, %right: buffer, %right_offset: offset) -> (i32) {
  %length = index.constant 5 : offset
  %order = buffer.compare %left[%left_offset], %right[%right_offset], %length
  func.return %order : i32
}

// The supplied origins may be interior native pointers. Byte positions retain
// their sign through bulk legalization; lengths remain unsigned.
func.def public @signed_copy(%source: buffer, %source_position: index, %target: buffer, %target_position: index, %length: offset) {
  buffer.copy %source[%source_position], %target[%target_position], %length
  func.return
}

func.def public @signed_fill(%target: buffer, %position: index, %length: offset, %pattern: i32) {
  buffer.fill %pattern, %target[%position], %length : i32
  func.return
}

func.def public @signed_compare(%left: buffer, %left_position: index, %right: buffer, %right_position: index, %length: offset) -> (i32) {
  %order = buffer.compare %left[%left_position], %right[%right_position], %length
  func.return %order : i32
}

func.def public @signed_byte(%source: buffer, %position: index, %target: buffer, %target_position: offset) -> (i32) {
  %byte = buffer.load.i8.u %source[%position]
  buffer.store.i8 %byte, %target[%target_position]
  func.return %byte : i32
}

func.def public @signed_address_equal(%left: buffer, %left_position: index, %right: buffer, %right_position: offset) -> (i1) {
  %same = buffer.compare.address eq, %left[%left_position], %right[%right_position]
  func.return %same : i1
}
