load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_test", "loom_generated_file")
load("//loom/build_tools/bazel:loom_check.bzl", "loom_check_test_suite")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_check_test_suite(
    name = "test",
    srcs = [
        "compare.loom-test",
        "copy.loom-test",
        "distance.loom-test",
        "fill.loom-test",
        "materialize.loom-test",
        "vm_literals.loom-test",
    ],
)

[
    loom_generated_file(
        name = "bulk_" + profile + "_object",
        testonly = True,
        args = [
            "$(location bulk.loom)",
            "--target=x86:" + profile,
        ],
        generator = "//loom/src/loom/tools/loom-compile",
        inputs = ["bulk.loom"],
        output = "bulk_" + profile + ".o",
        output_flag = "--output=",
        target_compatible_with = [
            "@platforms//cpu:x86_64",
            "@platforms//os:linux",
        ],
    )
    for profile in [
        "scalar",
        "avx2",
        "avx512",
    ]
]

[
    loom_cc_test(
        name = "bulk_" + profile + "_test",
        srcs = [
            "bulk_" + profile + ".o",
            "bulk_test.cc",
        ],
        defines = ["LOOM_TEST_VECTOR_BITS=" + str(vector_bits)],
        target_compatible_with = [
            "@platforms//cpu:x86_64",
            "@platforms//os:linux",
        ],
        deps = [
            "//runtime/src/iree/testing:gtest",
            "//runtime/src/iree/testing:gtest_main",
        ],
    )
    for profile, vector_bits in [
        ("scalar", 0),
        ("avx2", 256),
        ("avx512", 512),
    ]
]
