// ====

test.target<low_core> @native {index_bitwidth = 32, offset_bitwidth = 32}

test.target<low_core> @wide

// Preserve a multi-result assumption and its stronger divisibility predicate.
// Every arithmetic result may require more than the native word before the
// assumption establishes the only demanded value domain.
func.def target(@native) @assumed_word_family(%left: i64, %right: i64, %extra: i64, %count: index) -> (index, index, index, index, index, index, index, index) where [range(%count, 0, 31)] {
  %a = index.cast %left : i64 to index
  %b = index.cast %right : i64 to index
  %c = index.cast %extra : i64 to index
  %add = index.add %a, %b : index
  %sub = index.sub %a, %b : index
  %mul = index.mul %a, %b : index
  %madd = index.madd %a, %b, %c : index
  %and = index.andi %a, %b : index
  %or = index.ori %a, %b : index
  %xor = index.xori %a, %b : index
  %shift = index.shli %a, %count : index
  %r0, %r1, %r2, %r3, %r4, %r5, %r6, %r7 = index.assume %add, %sub, %mul, %madd, %and, %or, %xor, %shift [range(%add, -32, 32), multiple_of(%add, 4), range(%sub, -32, 32), range(%mul, -32, 32), range(%madd, -32, 32), range(%and, -32, 32), range(%or, -32, 32), range(%xor, -32, 32), range(%shift, -32, 32)] : index, index, index, index, index, index, index, index
  func.return %r0, %r1, %r2, %r3, %r4, %r5, %r6, %r7 : index, index, index, index, index, index, index, index
}

func.def target(@native) @assumed_sum(%left: index, %right: index) -> (index) {
  %sum = index.add %left, %right : index
  %bounded = index.assume %sum [range(%sum, -32, 32)] : index
  func.return %bounded : index
}

func.def target(@wide) @wide_assumed_sum(%left: index, %right: index) -> (index) {
  %sum = index.add %left, %right : index
  %bounded = index.assume %sum [range(%sum, -32, 32)] : index
  func.return %bounded : index
}

func.def target(@native) @shared_assumed_sum(%left: index, %right: index) -> (index, index) {
  %sum = index.add %left, %right : index
  %bounded = index.assume %sum [range(%sum, -32, 32)] : index
  func.return %sum, %bounded : index, index
}

func.def target(@native) @observed_assumed_sum(%left: index, %right: index, %other: index) -> (index, index) {
  %sum = index.add %left, %right : index
  %bounded = index.assume %sum [range(%sum, -32, 32)] : index
  %observed = index.assume %other [le(%other, %sum)] : index
  func.return %bounded, %observed : index, index
}

func.def target(@native) @assumed_full_value(%left: index, %right: index) -> (index) {
  %sum = index.add %left, %right : index
  %bounded = index.assume %sum [range(%sum, -4294967296, 4294967294)] : index
  func.return %bounded : index
}

func.def target(@native) @assumed_nonlocal_bits(%input: index, %amount: index) -> (index, index, index) where [range(%amount, 0, 63)] {
  %shifted = index.shli %input, %amount : index
  %right = index.shrui %input, %amount : index
  %divisor = index.constant 3 : index
  %quotient = index.div %input, %divisor : index
  %a, %b, %c = index.assume %shifted, %right, %quotient [range(%shifted, -32, 32), range(%right, 0, 32), range(%quotient, 0, 32)] : index, index, index
  func.return %a, %b, %c : index, index, index
}

