func.def target(@native) @assumed_nonlocal_bits(%input: index, %amount: index) -> (index, index, index) where [range(%amount, 0, 63)] {
  %shifted = index.shli %input, %amount : index
  %right = index.shrui %input, %amount : index
  %divisor = index.constant 3 : index
  %quotient = index.div %input, %divisor : index
  %a, %b, %c = index.assume %shifted, %right, %quotient [range(%shifted, -32, 32), range(%right, 0, 32), range(%quotient, 0, 32)] : index, index, index
  func.return %a, %b, %c : index, index, index
}

// ====
// RUN: pass combine,canonicalize

test.target<low_core> @native {index_bitwidth = 32, offset_bitwidth = 32}

// The explicit bounds prove signed32 observations. Nonnegativity and
// nonpositivity come from the arithmetic operands and must survive narrowing.
// Returning the values and their inferred endpoints observes both contracts.
func.def target(@native) @inferred_arithmetic_bounds(%positive: index, %negative: index, %small: index) -> (index, index, index, index, index, i64, i64, i64, i64, i64) where [range(%positive, 0, 2147483647), range(%negative, -2147483648, 0), range(%small, 0, 31)] {
  %c8 = index.constant 8 : index
  %c3 = index.constant 3 : index
  %sum = index.add %positive, %small : index
  %difference = index.sub %negative, %small : index
  %product = index.mul %positive, %c8 : index
  %combined = index.madd %positive, %c8, %small : index
  %shifted = index.shli %positive, %c3 : index
  %a, %b, %c, %d, %e = index.assume %sum, %difference, %product, %combined, %shifted [lt(%sum, 32), ge(%difference, -31), lt(%product, 128), lt(%combined, 128), lt(%shifted, 128)] : index, index, index, index, index
  %lo_a = test.fact_range_lo %a : index -> i64
  %hi_b = test.fact_range_hi %b : index -> i64
  %lo_c = test.fact_range_lo %c : index -> i64
  %lo_d = test.fact_range_lo %d : index -> i64
  %lo_e = test.fact_range_lo %e : index -> i64
  func.return %a, %b, %c, %d, %e, %lo_a, %hi_b, %lo_c, %lo_d, %lo_e : index, index, index, index, index, i64, i64, i64, i64, i64
}

// A non-power-of-two divisor need not survive low-word modular arithmetic.
// The original bounded observation still has that divisor, independent of
// the explicit interval and the relationship to another assumption result.
func.def target(@native) @inferred_divisibility(%value: index, %limit: index) -> (index, index) where [range(%value, 0, 2147483646), multiple_of(%value, 3), range(%limit, 1, 100)] {
  %c3 = index.constant 3 : index
  %product = index.mul %value, %c3 : index
  %bounded, %other = index.assume %product, %limit [lt(%product, %limit)] : index, index
  func.return %bounded, %other : index, index
}

