// RUN: pass test.realize-pipeline,symbol-dce,cfg-simplify

// Projection preserves the runtime backedge and original capture ordinals after
// worker materialization removes the unused parameter before the live one.
func.decl @record(%value: index)

func.def @worker(%unused: index, %value: index) {
  func.call @record(%value) : (index)
  func.return
}

pipeline.def @phase() run(%value: index, %unused: index) {
  pipeline.strand workers([0], [1], [1]) {
    func.call @worker(%unused, %value) : (index, index)
  }
}

pipeline.def public @root() run(%limit: index) {
  %initial = index.constant 0 : index
  %step = index.constant 1 : index
  pipeline.serial {
    cfg.br ^condition(%initial: index)
  ^condition(%iteration: index):
    %more = index.cmp ult, %iteration, %limit : index
    cfg.cond_br %more, ^body, ^exit
  ^body:
    pipeline.compose @phase(%iteration, %limit) : (index, index)
    %next = index.add %iteration, %step : index
    cfg.br ^condition(%next: index)
  ^exit:
  }
}

// ----
func.decl @record(%value: index)

func.def @__pipeline_worker_0(%value: index) {
  func.call @record(%value) : (index)
  func.return
}

func.decl @__test_phase_join(%13: index)

func.decl @__test_phase_enter(%14: index)

func.def inline @__pipeline_engine_0(%15: index) {
  func.call @__pipeline_worker_0(%15) : (index)
  func.return
}

func.def public inline @__pipeline_engine_1(%19: index) {
  %initial = index.constant 0 : index
  %step = index.constant 1 : index
  cfg.br ^_bb1(%initial: index)
^_bb1(%iteration: index):
  %more = index.cmp ult, %iteration, %19 : index
  cfg.cond_br %more, ^_bb2, ^_bb3
^_bb2:
  %26 = index.constant 0 : index
  func.call @__test_phase_enter(%26) : (index)
  func.call @__pipeline_engine_0(%iteration) : (index)
  %27 = index.constant 0 : index
  func.call @__test_phase_join(%27) : (index)
  %next = index.add %iteration, %step : index
  cfg.br ^_bb1(%next: index)
^_bb3:
  func.return
}

// ====

// Both engines join every outer phase. Engine 0 also joins the nested serial
// scope, even though only engine 1 has work inside that scope.
func.decl @record(%value: index)

func.def @worker(%value: index) {
  func.call @record(%value) : (index)
  func.return
}

pipeline.def @first() run(%value: index) {
  pipeline.strand workers([0], [1], [1]) {
    func.call @worker(%value) : (index)
  }
}

pipeline.def @second() run(%value: index) {
  pipeline.strand workers([1], [1], [1]) {
    func.call @worker(%value) : (index)
  }
}

pipeline.def public @root() run(%value: index) {
  pipeline.serial {
    pipeline.compose @first(%value) : (index)
    pipeline.serial {
      pipeline.compose @second(%value) : (index)
    }
    pipeline.compose @second(%value) : (index)
  }
}

