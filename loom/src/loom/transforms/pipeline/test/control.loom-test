// ====
// RUN: pass test.realize-pipeline,inline-callables,symbol-dce,cfg-simplify

// Each branch executes one complete phase. Empty strands require no engine,
// and required helper inlining preserves the branch and its enclosing joins.
func.def inline @observe(%value: index) {
  test.use %value : index
  func.return
}

pipeline.def @left() run(%value: index) {
  pipeline.strand workers([0], [1], [1]) {
    func.call @observe(%value) : (index)
  }
  pipeline.strand workers([1], [1], [1]) {
  }
}

pipeline.def @right() run(%value: index) {
  pipeline.strand workers([1], [1], [1]) {
    func.call @observe(%value) : (index)
  }
}

pipeline.def public @choose() run(%condition: i1, %value: index) {
  pipeline.strand workers([0], [1], [1]) {
  }
  pipeline.serial {
    cfg.cond_br %condition, ^left, ^right
  ^left:
    pipeline.compose @left(%value) : (index)
    cfg.br ^exit
  ^right:
    pipeline.compose @right(%value) : (index)
    cfg.br ^exit
  ^exit:
  }
}

