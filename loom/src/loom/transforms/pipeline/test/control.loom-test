func.decl @__test_phase_enter(%8: index)

func.def public inline @__pipeline_engine_2(%13: i1, %14: index) {
  cfg.cond_br %13, ^_bb1, ^_bb2
^_bb1:
  %19 = index.constant 0 : index
  func.call @__test_phase_enter(%19) : (index)
  test.use %14 : index
  %20 = index.constant 0 : index
  func.call @__test_phase_join(%20) : (index)
  cfg.br ^_bb3
^_bb2:
  %17 = index.constant 0 : index
  func.call @__test_phase_enter(%17) : (index)
  %18 = index.constant 0 : index
  func.call @__test_phase_join(%18) : (index)
  cfg.br ^_bb3
^_bb3:
  func.return
}

func.def public inline @__pipeline_engine_3(%21: i1, %22: index) {
  cfg.cond_br %21, ^_bb1, ^_bb2
^_bb1:
  %27 = index.constant 1 : index
  func.call @__test_phase_enter(%27) : (index)
  %28 = index.constant 1 : index
  func.call @__test_phase_join(%28) : (index)
  cfg.br ^_bb3
^_bb2:
  %25 = index.constant 1 : index
  func.call @__test_phase_enter(%25) : (index)
  test.use %22 : index
  %26 = index.constant 1 : index
  func.call @__test_phase_join(%26) : (index)
  cfg.br ^_bb3
^_bb3:
  func.return
}
