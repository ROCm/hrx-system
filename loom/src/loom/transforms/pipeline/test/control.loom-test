func.def public inline @__pipeline_engine_3(%16: index) {
  %22 = index.constant 0 : index
  func.call @__test_phase_enter(%22) : (index)
  func.call @__pipeline_engine_2(%16) : (index)
  %23 = index.constant 0 : index
  func.call @__test_phase_join(%23) : (index)
  %20 = index.constant 0 : index
  func.call @__test_phase_enter(%20) : (index)
  %21 = index.constant 0 : index
  func.call @__test_phase_join(%21) : (index)
  %18 = index.constant 0 : index
  func.call @__test_phase_enter(%18) : (index)
  %19 = index.constant 0 : index
  func.call @__test_phase_join(%19) : (index)
  func.return
}

func.def public inline @__pipeline_engine_4(%24: index) {
  %32 = index.constant 1 : index
  func.call @__test_phase_enter(%32) : (index)
  %33 = index.constant 1 : index
  func.call @__test_phase_join(%33) : (index)
  %30 = index.constant 1 : index
  func.call @__test_phase_enter(%30) : (index)
  %28 = index.constant 1 : index
  func.call @__test_phase_enter(%28) : (index)
  func.call @__pipeline_engine_0(%24) : (index)
  %29 = index.constant 1 : index
  func.call @__test_phase_join(%29) : (index)
  %31 = index.constant 1 : index
  func.call @__test_phase_join(%31) : (index)
  %26 = index.constant 1 : index
  func.call @__test_phase_enter(%26) : (index)
  func.call @__pipeline_engine_1(%24) : (index)
  %27 = index.constant 1 : index
  func.call @__test_phase_join(%27) : (index)
  func.return
