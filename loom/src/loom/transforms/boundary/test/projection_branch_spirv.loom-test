
// Equal authored vector types can have different physical carriers. The matrix
// fragment stays opaque while the ordinary vector splits across the same join.
// RUN: pass specialize-target-callgraph,project-boundary-representations

spirv.target<vulkan1_3> @target

func.def public target(@target) @mixed_carriers(%input: buffer, %output: buffer, %condition: i1) {
  %base = index.constant 0 : offset
  %tile = index.constant 16 : index
  %input_matrix = buffer.view %input[%base] : buffer -> view<16x16xf32>
  %input_dense = buffer.view %input[%base] : buffer -> view<8xf32>
  %output_matrix = buffer.view %output[%base] : buffer -> view<16x16xf32>
  %dense_offset = index.constant 1024 : offset
  %output_dense = buffer.view %output[%dense_offset] : buffer -> view<8xf32>
  %matrix, %dense = scf.if %condition -> (vector<8xf32>, vector<8xf32>) {
    %fragment = vector.fragment.load<init> %input_matrix[0, 0] shape [%tile, %tile] : view<16x16xf32> -> vector<8xf32>
    %lanes = vector.load %input_dense[0] : view<8xf32> -> vector<8xf32>
    scf.yield %fragment, %lanes : vector<8xf32>, vector<8xf32>
  } else {
    %fragment = vector.fragment.load<init> %input_matrix[0, 0] shape [%tile, %tile] : view<16x16xf32> -> vector<8xf32>
    %fallback = vector.splatf 3.0 : vector<8xf32>
    scf.yield %fragment, %fallback : vector<8xf32>, vector<8xf32>
  }
  vector.fragment.store<result> %matrix, %output_matrix[0, 0] shape [%tile, %tile] : vector<8xf32>, view<16x16xf32>
  vector.store %dense, %output_dense[0] : vector<8xf32>, view<8xf32>
  func.return
}

// ----
spirv.target<vulkan1_3> @target

func.def public target(@target) @mixed_carriers(%input: buffer, %output: buffer, %condition: i1) {
  %base = index.constant 0 : offset
  %tile = index.constant 16 : index
  %input_matrix = buffer.view %input[%base] : buffer -> view<16x16xf32>
  %input_dense = buffer.view %input[%base] : buffer -> view<8xf32>
  %output_matrix = buffer.view %output[%base] : buffer -> view<16x16xf32>
  %dense_offset = index.constant 1024 : offset
  %output_dense = buffer.view %output[%dense_offset] : buffer -> view<8xf32>
  %matrix, %17, %18 = scf.if %condition -> (vector<8xf32>, vector<4xf32>, vector<4xf32>) {
    %fragment = vector.fragment.load<init> %input_matrix[0, 0] shape [%tile, %tile] : view<16x16xf32> -> vector<8xf32>
    %lanes = vector.load %input_dense[0] : view<8xf32> -> vector<8xf32>
    %19 = vector.slice %lanes[0] : vector<8xf32> -> vector<4xf32>
    %20 = vector.slice %lanes[4] : vector<8xf32> -> vector<4xf32>
    scf.yield %fragment, %19, %20 : vector<8xf32>, vector<4xf32>, vector<4xf32>
  } else {
    %fragment = vector.fragment.load<init> %input_matrix[0, 0] shape [%tile, %tile] : view<16x16xf32> -> vector<8xf32>
    %fallback = vector.splatf 3.0 : vector<8xf32>
    %21 = vector.slice %fallback[0] : vector<8xf32> -> vector<4xf32>
    %22 = vector.slice %fallback[4] : vector<8xf32> -> vector<4xf32>
    scf.yield %fragment, %21, %22 : vector<8xf32>, vector<4xf32>, vector<4xf32>
  }
  %dense = vector.concat<0> %17, %18 : vector<4xf32>, vector<4xf32> -> vector<8xf32>
  vector.fragment.store<result> %matrix, %output_matrix[0, 0] shape [%tile, %tile] : vector<8xf32>, view<16x16xf32>
  vector.store %dense, %output_dense[0] : vector<8xf32>, view<8xf32>
  func.return
}

// ====

// FP8 storage carriers are scalar-backed singleton vectors. Both encodings
// use the same boundary projection without inventing native FP8 arithmetic.
spirv.target<vulkan1_3> @target

func.def public target(@target) @float8_branch(%input: buffer, %output: buffer, %condition: i1, %e4: f8E4M3, %e5: f8E5M2) {
  %base = index.constant 0 : offset
  %second = index.constant 2 : offset
  %e4_input = buffer.view %input[%base] : buffer -> view<2xf8E4M3>
  %e5_input = buffer.view %input[%second] : buffer -> view<2xf8E5M2>
  %e4_output = buffer.view %output[%base] : buffer -> view<2xf8E4M3>
  %e5_output = buffer.view %output[%second] : buffer -> view<2xf8E5M2>
  %e4_result, %e5_result = scf.if %condition -> (vector<2xf8E4M3>, vector<2xf8E5M2>) {
    %e4_loaded = vector.load %e4_input[0] : view<2xf8E4M3> -> vector<2xf8E4M3>
    %e5_loaded = vector.load %e5_input[0] : view<2xf8E5M2> -> vector<2xf8E5M2>
    scf.yield %e4_loaded, %e5_loaded : vector<2xf8E4M3>, vector<2xf8E5M2>
  } else {
    %e4_fill = vector.splat %e4 : vector<2xf8E4M3>
    %e5_fill = vector.splat %e5 : vector<2xf8E5M2>
    scf.yield %e4_fill, %e5_fill : vector<2xf8E4M3>, vector<2xf8E5M2>
  }
  vector.store %e4_result, %e4_output[0] : vector<2xf8E4M3>, view<2xf8E4M3>
  vector.store %e5_result, %e5_output[0] : vector<2xf8E5M2>, view<2xf8E5M2>
  func.return
}

// ----
spirv.target<vulkan1_3> @target

func.def public target(@target) @float8_branch(%input: buffer, %output: buffer, %condition: i1, %e4: f8E4M3, %e5: f8E5M2) {
  %base = index.constant 0 : offset
  %second = index.constant 2 : offset
  %e4_input = buffer.view %input[%base] : buffer -> view<2xf8E4M3>
  %e5_input = buffer.view %input[%second] : buffer -> view<2xf8E5M2>
  %e4_output = buffer.view %output[%base] : buffer -> view<2xf8E4M3>
  %e5_output = buffer.view %output[%second] : buffer -> view<2xf8E5M2>
  %17, %18, %19, %20 = scf.if %condition -> (vector<1xf8E4M3>, vector<1xf8E4M3>, vector<1xf8E5M2>, vector<1xf8E5M2>) {
    %e4_loaded = vector.load %e4_input[0] : view<2xf8E4M3> -> vector<2xf8E4M3>
    %e5_loaded = vector.load %e5_input[0] : view<2xf8E5M2> -> vector<2xf8E5M2>
    %21 = vector.slice %e4_loaded[0] : vector<2xf8E4M3> -> vector<1xf8E4M3>
    %22 = vector.slice %e4_loaded[1] : vector<2xf8E4M3> -> vector<1xf8E4M3>
    %23 = vector.slice %e5_loaded[0] : vector<2xf8E5M2> -> vector<1xf8E5M2>
    %24 = vector.slice %e5_loaded[1] : vector<2xf8E5M2> -> vector<1xf8E5M2>
    scf.yield %21, %22, %23, %24 : vector<1xf8E4M3>, vector<1xf8E4M3>, vector<1xf8E5M2>, vector<1xf8E5M2>
  } else {
    %e4_fill = vector.splat %e4 : vector<2xf8E4M3>
    %e5_fill = vector.splat %e5 : vector<2xf8E5M2>
    %25 = vector.slice %e4_fill[0] : vector<2xf8E4M3> -> vector<1xf8E4M3>
    %26 = vector.slice %e4_fill[1] : vector<2xf8E4M3> -> vector<1xf8E4M3>
    %27 = vector.slice %e5_fill[0] : vector<2xf8E5M2> -> vector<1xf8E5M2>
    %28 = vector.slice %e5_fill[1] : vector<2xf8E5M2> -> vector<1xf8E5M2>
    scf.yield %25, %26, %27, %28 : vector<1xf8E4M3>, vector<1xf8E4M3>, vector<1xf8E5M2>, vector<1xf8E5M2>
  }
  %e5_result = vector.concat<0> %19, %20 : vector<1xf8E5M2>, vector<1xf8E5M2> -> vector<2xf8E5M2>
  %e4_result = vector.concat<0> %17, %18 : vector<1xf8E4M3>, vector<1xf8E4M3> -> vector<2xf8E4M3>
  vector.store %e4_result, %e4_output[0] : vector<2xf8E4M3>, view<2xf8E4M3>
  vector.store %e5_result, %e5_output[0] : vector<2xf8E5M2>, view<2xf8E5M2>
  func.return
}

// ====

// Ordinary shapes share the packet schema across branches: a six-lane bank
// needs a tail packet, while rank-three and singleton shapes need only flattening.
spirv.target<vulkan1_3> @target

func.def public target(@target) @shaped_branch(%condition: i1, %matrix: vector<2x3xi32>, %cube: vector<1x2x2xf32>, %singleton: vector<1x1xi32>) -> (vector<2x3xi32>, vector<1x2x2xf32>, vector<1x1xi32>) {
  %a, %b, %c = scf.if %condition -> (vector<2x3xi32>, vector<1x2x2xf32>, vector<1x1xi32>) {
    scf.yield %matrix, %cube, %singleton : vector<2x3xi32>, vector<1x2x2xf32>, vector<1x1xi32>
  } else {
    %alternate = vector.splati 7 : vector<2x3xi32>
    scf.yield %alternate, %cube, %singleton : vector<2x3xi32>, vector<1x2x2xf32>, vector<1x1xi32>
  }
  func.return %a, %b, %c : vector<2x3xi32>, vector<1x2x2xf32>, vector<1x1xi32>
}

// ----
spirv.target<vulkan1_3> @target

func.def public target(@target) @shaped_branch(%condition: i1, %31: vector<4xi32>, %32: vector<2xi32>, %33: vector<4xf32>, %34: vector<1xi32>) -> (vector<4xi32>, vector<2xi32>, vector<4xf32>, vector<1xi32>) {
  %17 = vector.concat<0> %31, %32 : vector<4xi32>, vector<2xi32> -> vector<6xi32>
  %matrix = vector.bitcast %17 : vector<6xi32> to vector<2x3xi32>
  %cube = vector.bitcast %33 : vector<4xf32> to vector<1x2x2xf32>
  %singleton = vector.bitcast %34 : vector<1xi32> to vector<1x1xi32>
  %11, %12, %13, %14 = scf.if %condition -> (vector<4xi32>, vector<2xi32>, vector<4xf32>, vector<1xi32>) {
    scf.yield %31, %32, %33, %34 : vector<4xi32>, vector<2xi32>, vector<4xf32>, vector<1xi32>
  } else {
    %alternate = vector.splati 7 : vector<2x3xi32>
    %23 = vector.bitcast %alternate : vector<2x3xi32> to vector<6xi32>
    %24 = vector.slice %23[0] : vector<6xi32> -> vector<4xi32>
    %25 = vector.slice %23[4] : vector<6xi32> -> vector<2xi32>
    scf.yield %24, %25, %33, %34 : vector<4xi32>, vector<2xi32>, vector<4xf32>, vector<1xi32>
  }
  %c = vector.bitcast %14 : vector<1xi32> to vector<1x1xi32>
  %b = vector.bitcast %13 : vector<4xf32> to vector<1x2x2xf32>
  %26 = vector.concat<0> %11, %12 : vector<4xi32>, vector<2xi32> -> vector<6xi32>
  %a = vector.bitcast %26 : vector<6xi32> to vector<2x3xi32>
  func.return %11, %12, %13, %14 : vector<4xi32>, vector<2xi32>, vector<4xf32>, vector<1xi32>
}

// ====

// The callable result, loop argument, yield, and loop result agree on packet
// order. The authored row access still sees its rank-two type after projection.
spirv.target<vulkan1_3> @target

func.def @update_row(%bank: vector<2x3xi32>, %row: index) -> (vector<2x3xi32>) {
  %values = vector.extract %bank[%row] : vector<2x3xi32> -> vector<3xi32>
  %doubled = vector.addi %values, %values : vector<3xi32>
  %next = vector.insert %doubled into %bank[%row] : vector<3xi32>, vector<2x3xi32>
  func.return %next : vector<2x3xi32>
}

func.def public target(@target) @shaped_loop(%initial: vector<2x3xi32>) -> (vector<2x3xi32>) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %result = scf.for %row = [%c0 to %c2 step %c1](%bank = %initial : vector<2x3xi32>) -> (vector<2x3xi32>) {
    %next = func.call @update_row(%bank, %row) : (vector<2x3xi32>, index) -> (vector<2x3xi32>)
    scf.yield %next : vector<2x3xi32>
  }
  func.return %result : vector<2x3xi32>
}

// ----
spirv.target<vulkan1_3> @target

func.def @update_row(%39: vector<4xi32>, %40: vector<2xi32>, %row: index) -> (vector<4xi32>, vector<2xi32>) {
  %19 = vector.concat<0> %39, %40 : vector<4xi32>, vector<2xi32> -> vector<6xi32>
  %bank = vector.bitcast %19 : vector<6xi32> to vector<2x3xi32>
  %values = vector.extract %bank[%row] : vector<2x3xi32> -> vector<3xi32>
  %doubled = vector.addi %values, %values : vector<3xi32>
  %next = vector.insert %doubled into %bank[%row] : vector<3xi32>, vector<2x3xi32>
  %36 = vector.bitcast %next : vector<2x3xi32> to vector<6xi32>
  %37 = vector.slice %36[0] : vector<6xi32> -> vector<4xi32>
  %38 = vector.slice %36[4] : vector<6xi32> -> vector<2xi32>
  func.return %37, %38 : vector<4xi32>, vector<2xi32>
}

func.def public target(@target) @shaped_loop(%44: vector<4xi32>, %45: vector<2xi32>) -> (vector<4xi32>, vector<2xi32>) {
  %23 = vector.concat<0> %44, %45 : vector<4xi32>, vector<2xi32> -> vector<6xi32>
  %initial = vector.bitcast %23 : vector<6xi32> to vector<2x3xi32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %25, %26 = scf.for %row = [%c0 to %c2 step %c1](%28 = %44 : vector<4xi32>, %29 = %45 : vector<2xi32>) -> (vector<4xi32>, vector<2xi32>) {
    %30 = vector.concat<0> %28, %29 : vector<4xi32>, vector<2xi32> -> vector<6xi32>
    %bank = vector.bitcast %30 : vector<6xi32> to vector<2x3xi32>
    %15, %16 = func.call @update_row(%28, %29, %row) : (vector<4xi32>, vector<2xi32>, index) -> (vector<4xi32>, vector<2xi32>)
    %34 = vector.concat<0> %15, %16 : vector<4xi32>, vector<2xi32> -> vector<6xi32>
    %next = vector.bitcast %34 : vector<6xi32> to vector<2x3xi32>
    scf.yield %15, %16 : vector<4xi32>, vector<2xi32>
  }
  %32 = vector.concat<0> %25, %26 : vector<4xi32>, vector<2xi32> -> vector<6xi32>
  %result = vector.bitcast %32 : vector<6xi32> to vector<2x3xi32>
  func.return %25, %26 : vector<4xi32>, vector<2xi32>
}
