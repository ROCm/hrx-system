  test.use %terminal, %last : index, vector<1x2xi1>
  kernel.return
}

// ====
// The target carrier bound is inclusive: the largest supported vector is
// projected while the first larger vector remains in its logical form.
// RUN: pass specialize-target-callgraph,project-boundary-representations

test.target<low_core> @carrier_target

func.def public target(@carrier_target) @predicate_vector_carrier_bound() {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %within_bound = vector.constant false : vector<4x8xi1>
  %above_bound = vector.constant false : vector<3x11xi1>
  %within_result, %above_result = scf.for %i = [%c0 to %c1 step %c1](%within = %within_bound : vector<4x8xi1>, %above = %above_bound : vector<3x11xi1>) -> (vector<4x8xi1>, vector<3x11xi1>) {
    scf.yield %within, %above : vector<4x8xi1>, vector<3x11xi1>
  }
  test.use %within_result, %above_result : vector<4x8xi1>, vector<3x11xi1>
  func.return
}

// ----
test.target<low_core> @carrier_target

func.def public target(@carrier_target) @predicate_vector_carrier_bound() {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %within_bound = vector.constant false : vector<4x8xi1>
  %above_bound = vector.constant false : vector<3x11xi1>
  %9 = vector.constant 1 : vector<4x8xi32>
  %10 = vector.constant 0 : vector<4x8xi32>
  %11 = vector.select %within_bound, %9, %10 : vector<4x8xi32>
  %within_result_word, %above_result = scf.for %i = [%c0 to %c1 step %c1](%within_word = %11 : vector<4x8xi32>, %above = %above_bound : vector<3x11xi1>) -> (vector<4x8xi32>, vector<3x11xi1>) {
    %17 = vector.constant 0 : vector<4x8xi32>
    %within = vector.cmpi ne, %within_word, %17 : vector<4x8xi32> -> vector<4x8xi1>
    scf.yield %within_word, %above : vector<4x8xi32>, vector<3x11xi1>
  }
  %19 = vector.constant 0 : vector<4x8xi32>
  %within_result = vector.cmpi ne, %within_result_word, %19 : vector<4x8xi32> -> vector<4x8xi1>
  test.use %within_result, %above_result : vector<4x8xi1>, vector<3x11xi1>
  func.return
}

// ====
