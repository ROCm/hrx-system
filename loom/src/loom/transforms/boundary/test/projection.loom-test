  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %last = scf.for %i = [%c0 to %limit step %c1](%flag = %seed : i1) -> (i1) {
    scf.yield %flag : i1
  }
  func.return %last : i1
}

