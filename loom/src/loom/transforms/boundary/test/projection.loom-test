// ====
// Callable-signature projection does not own multi-region kernel signatures,
// but independent projections inside the launch body must still run.
// RUN: pass specialize-target-callgraph,project-boundary-representations

test.target<low_core> @carrier_target {abi = hal_kernel, subgroup_size = 64}

kernel.def target(@carrier_target) @kernel_local_loop_layout() {
  %c1 = index.constant 1 : index
  %size = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%size, %c1, %c1) : index
} launch() {
  %lane = kernel.subgroup.lane.id : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %stride = index.add %lane, %c1 : index
  %initial_layout = encoding.layout.strided [%stride, 1] : encoding<layout>
  %result_layout = scf.for %i = [%c0 to %c1 step %c1](%layout = %initial_layout : encoding<layout>) -> (encoding<layout>) {
    scf.yield %layout : encoding<layout>
  }
  test.use %result_layout : encoding<layout>
  kernel.return
}

