  %terminal, %last_word = scf.while(%i = %c0 : index, %flags_word = %19 : vector<1x2xi32>) -> (index, vector<1x2xi32>) {
    %26 = vector.constant 0 : vector<1x2xi32>
    %flags = vector.cmpi ne, %flags_word, %26 : vector<1x2xi32> -> vector<1x2xi1>
    %continue = index.cmp ult, %i, %limit : index
    scf.condition %continue, %i, %flags_word : i1, index, vector<1x2xi32>
  } do(%body_i: index, %body_flags_word: vector<1x2xi32>) {
    %28 = vector.constant 0 : vector<1x2xi32>
    %body_flags = vector.cmpi ne, %body_flags_word, %28 : vector<1x2xi32> -> vector<1x2xi1>
    %next = index.add %body_i, %c1 : index
    %at_limit = index.cmp eq, %next, %limit : index
    %before_limit = index.cmp ult, %next, %limit : index
    %next_flags = vector.from_elements %at_limit, %before_limit : vector<1x2xi1>
    %32 = vector.constant 1 : vector<1x2xi32>
    %33 = vector.constant 0 : vector<1x2xi32>
    %34 = vector.select %next_flags, %32, %33 : vector<1x2xi32>
