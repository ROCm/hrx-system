// ====

// Nested LoopLike shapes exchange projected predicate state through the outer
// body argument and the inner result.
// RUN: pass specialize-target-callgraph,project-boundary-representations

test.target<low_core> @carrier_target

func.def public target(@carrier_target) @nested_predicate_transport(%limit: index, %seed: i1) -> (i1) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %last = scf.for %i = [%c0 to %limit step %c1](%outer_flag = %seed : i1) -> (i1) {
    %inner_result = scf.while(%inner_flag = %outer_flag : i1) -> (i1) {
      scf.condition %inner_flag, %inner_flag : i1, i1
    } do(%inner_body_flag: i1) {
      scf.yield %inner_body_flag : i1
    }
    scf.yield %inner_result : i1
  }
  func.return %last : i1
}

// ----
test.target<low_core> @carrier_target

func.def public target(@carrier_target) @nested_predicate_transport(%limit: index, %seed: i1) -> (i1) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %11 = scalar.constant 1 : i32
  %12 = scalar.constant 0 : i32
  %13 = scf.select %seed, %11, %12 : i32
  %last_word = scf.for %i = [%c0 to %limit step %c1](%outer_flag_word = %13 : i32) -> (i32) {
    %17 = scalar.constant 0 : i32
    %outer_flag = scalar.cmpi ne, %outer_flag_word, %17 : i32
    %inner_result_word = scf.while(%inner_flag_word = %outer_flag_word : i32) -> (i32) {
      %24 = scalar.constant 0 : i32
      %inner_flag = scalar.cmpi ne, %inner_flag_word, %24 : i32
      scf.condition %inner_flag, %inner_flag_word : i1, i32
    } do(%inner_body_flag_word: i32) {
      %26 = scalar.constant 0 : i32
      %inner_body_flag = scalar.cmpi ne, %inner_body_flag_word, %26 : i32
      scf.yield %inner_body_flag_word : i32
    }
    %28 = scalar.constant 0 : i32
    %inner_result = scalar.cmpi ne, %inner_result_word, %28 : i32
    scf.yield %inner_result_word : i32
  }
  %19 = scalar.constant 0 : i32
  %last = scalar.cmpi ne, %last_word, %19 : i32
  func.return %last : i1
}

// ====

// A later projected loop resolves an unprojected result of an earlier rebuilt
// loop before using it as a retained source recipe.
// RUN: pass specialize-target-callgraph,project-boundary-representations

test.target<low_core> @carrier_target

func.def public target(@carrier_target) @sibling_replacement_source(%seed: i1) -> (i1) {
  %enter = scalar.constant true : i1
  %stop = scalar.constant false : i1
  %lane_flag, %uniform_flag = scf.while(%first_lane = %seed : i1, %first_uniform = %enter : i1) -> (i1, i1) {
    scf.condition %first_uniform, %first_lane, %first_uniform : i1, i1, i1
  } do(%body_lane: i1, %body_uniform: i1) {
    scf.yield %body_lane, %stop : i1, i1
  }
  %second_result = scf.while(%second_flag = %uniform_flag : i1) -> (i1) {
    scf.condition %second_flag, %second_flag : i1, i1
  } do(%second_body_flag: i1) {
    scf.yield %seed : i1
  }
  func.return %second_result : i1
}

// ----
test.target<low_core> @carrier_target

func.def public target(@carrier_target) @sibling_replacement_source(%seed: i1) -> (i1) {
  %enter = scalar.constant true : i1
  %stop = scalar.constant false : i1
  %13 = scalar.constant 1 : i32
  %14 = scalar.constant 0 : i32
  %15 = scf.select %seed, %13, %14 : i32
  %lane_flag_word, %uniform_flag = scf.while(%first_lane_word = %15 : i32, %first_uniform = %enter : i1) -> (i32, i1) {
    %22 = scalar.constant 0 : i32
    %first_lane = scalar.cmpi ne, %first_lane_word, %22 : i32
    scf.condition %first_uniform, %first_lane_word, %first_uniform : i1, i32, i1
  } do(%body_lane_word: i32, %body_uniform: i1) {
    %24 = scalar.constant 0 : i32
    %body_lane = scalar.cmpi ne, %body_lane_word, %24 : i32
    scf.yield %body_lane_word, %stop : i32, i1
  }
  %26 = scalar.constant 0 : i32
  %lane_flag = scalar.cmpi ne, %lane_flag_word, %26 : i32
  %28 = scalar.constant 1 : i32
  %29 = scalar.constant 0 : i32
  %30 = scf.select %uniform_flag, %28, %29 : i32
  %second_result_word = scf.while(%second_flag_word = %30 : i32) -> (i32) {
    %34 = scalar.constant 0 : i32
    %second_flag = scalar.cmpi ne, %second_flag_word, %34 : i32
    scf.condition %second_flag, %second_flag_word : i1, i32
  } do(%second_body_flag_word: i32) {
    %36 = scalar.constant 0 : i32
    %second_body_flag = scalar.cmpi ne, %second_body_flag_word, %36 : i32
    %40 = scalar.constant 1 : i32
    %41 = scalar.constant 0 : i32
    %42 = scf.select %seed, %40, %41 : i32
    scf.yield %42 : i32
  }
  %38 = scalar.constant 0 : i32
  %second_result = scalar.cmpi ne, %second_result_word, %38 : i32
  func.return %second_result : i1
}

// ====

// Dynamic layouts cross both sides of a nested counted-loop recurrence.
// RUN: pass specialize-target-callgraph,project-boundary-representations

test.target<low_core> @carrier_target

func.def public target(@carrier_target) @nested_layout_transport(%limit: index, %stride_input: index) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %stride = index.assume %stride_input [range(%stride_input, 4, 1024)] : index
  %initial = encoding.layout.strided [%stride, 1] : encoding<layout>
  %outer_result = scf.for %outer = [%c0 to %limit step %c1](%outer_layout = %initial : encoding<layout>) -> (encoding<layout>) {
    %inner_result = scf.for %inner = [%c0 to %limit step %c1](%inner_layout = %outer_layout : encoding<layout>) -> (encoding<layout>) {
      scf.yield %inner_layout : encoding<layout>
    }
    scf.yield %inner_result : encoding<layout>
  }
  test.use %outer_result : encoding<layout>
  func.return
}

// ----
test.target<low_core> @carrier_target

func.def public target(@carrier_target) @nested_layout_transport(%limit: index, %stride_input: index) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %stride = index.assume %stride_input [range(%stride_input, 4, 1024)] : index
  %initial = encoding.layout.strided [%stride, 1] : encoding<layout>
  %outer_result_stride_0 = scf.for %outer = [%c0 to %limit step %c1](%outer_layout_stride_0 = %stride : index) -> (index) {
    %outer_layout = encoding.layout.strided [%outer_layout_stride_0, 1] : encoding<layout>
    %inner_result_stride_0 = scf.for %inner = [%c0 to %limit step %c1](%inner_layout_stride_0 = %outer_layout_stride_0 : index) -> (index) {
      %inner_layout = encoding.layout.strided [%inner_layout_stride_0, 1] : encoding<layout>
      scf.yield %inner_layout_stride_0 : index
    }
    %inner_result = encoding.layout.strided [%inner_result_stride_0, 1] : encoding<layout>
    scf.yield %inner_result_stride_0 : index
  }
  %outer_result = encoding.layout.strided [%outer_result_stride_0, 1] : encoding<layout>
  test.use %outer_result : encoding<layout>
  func.return
}

// ====

// Projecting a structured function's view argument and result preserves its
// single-entry body, including guarded effects and retained scalar arguments.
// RUN: pass specialize-target-callgraph,project-boundary-representations

test.target<low_core> @carrier_target

func.def public target(@carrier_target) @structured_view_identity(%input: view<4xi32>, %condition: i1, %value: i32) -> (view<4xi32>) {
  scf.if %condition {
    view.store %value, %input[0] : i32, view<4xi32>
  }
  func.return %input : view<4xi32>
}

// ----
test.target<low_core> @carrier_target

func.def public target(@carrier_target) @structured_view_identity(%input_root: buffer, %input_offset: offset, %condition: i1, %value: i32) -> (buffer, offset) {
  %input = buffer.view %input_root[%input_offset] : buffer -> view<4xi32>
  scf.if %condition {
    view.store %value, %input[0] : i32, view<4xi32>
  }
  func.return %input_root, %input_offset : buffer, offset
}

// ====
// RUN: pass specialize-target-callgraph,project-loop-boundary-representations

// A uniform offset into private storage still observes each lane's own value.
// The predicate derived from that observation needs a per-lane loop carrier.
test.target<low_core> @carrier_target {abi = hal_kernel, subgroup_size = 64}

kernel.def target(@carrier_target) @private_observation_predicate() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch() {
  %bytes = index.constant 16 : offset
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %disabled = scalar.constant false : i1
  %threshold = scalar.constant 0 : i32
  %lane = kernel.workitem.id<x> : index
  %lane_word = index.cast %lane : index to i32
  %storage = buffer.alloca<private> align(4) %bytes : buffer
  buffer.fill %lane_word, %storage[%base], %bytes : i32
  %view = buffer.view %storage[%base] : buffer -> view<4xi32>
  %terminal, %last = scf.while(%i = %c0 : index, %flag = %disabled : i1) -> (index, i1) {
    %continue = index.cmp ult, %i, %c4 : index
    scf.condition %continue, %i, %flag : i1, index, i1
  } do(%body_i: index, %body_flag: i1) {
    %loaded = view.load %view[%body_i] : view<4xi32> -> i32
    %predicate = scalar.cmpi ne, %loaded, %threshold : i32
    %next = index.add %body_i, %c1 : index
    scf.yield %next, %predicate : index, i1
  }
  test.use %terminal, %last : index, i1
  kernel.return
}

// ----
test.target<low_core> @carrier_target {abi = hal_kernel, subgroup_size = 64}

kernel.def target(@carrier_target) @private_observation_predicate() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch() {
  %bytes = index.constant 16 : offset
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %disabled = scalar.constant false : i1
  %threshold = scalar.constant 0 : i32
  %lane = kernel.workitem.id<x> : index
  %lane_word = index.cast %lane : index to i32
  %storage = buffer.alloca<private> align(4) %bytes : buffer
  buffer.fill %lane_word, %storage[%base], %bytes : i32
  %view = buffer.view %storage[%base] : buffer -> view<4xi32>
  %23 = scalar.constant 1 : i32
  %24 = scalar.constant 0 : i32
  %25 = scf.select %disabled, %23, %24 : i32
  %terminal, %last_word = scf.while(%i = %c0 : index, %flag_word = %25 : i32) -> (index, i32) {
    %32 = scalar.constant 0 : i32
    %flag = scalar.cmpi ne, %flag_word, %32 : i32
    %continue = index.cmp ult, %i, %c4 : index
    scf.condition %continue, %i, %flag_word : i1, index, i32
  } do(%body_i: index, %body_flag_word: i32) {
    %34 = scalar.constant 0 : i32
    %body_flag = scalar.cmpi ne, %body_flag_word, %34 : i32
    %loaded = view.load %view[%body_i] : view<4xi32> -> i32
    %predicate = scalar.cmpi ne, %loaded, %threshold : i32
    %next = index.add %body_i, %c1 : index
    %38 = scalar.constant 1 : i32
    %39 = scalar.constant 0 : i32
    %40 = scf.select %predicate, %38, %39 : i32
    scf.yield %next, %40 : index, i32
  }
  %36 = scalar.constant 0 : i32
  %last = scalar.cmpi ne, %last_word, %36 : i32
  test.use %terminal, %last : index, i1
  kernel.return
}
