// RUN: pass specialize-target-callgraph,project-loop-predicate-lifetimes

test.target<low_core> @target

// Carrier construction preserves arbitrary static predicate ranks. The target
// owns whether the surrounding operations have an executable realization.
func.def public target(@target) @ranked_predicates(%limit: i32, %seed: vector<2x3xi1>) -> (vector<2x3xi1>) {
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %true_words_scalar = scalar.constant 1 : i1
  %true_words = vector.splat %true_words_scalar : vector<2x3xi1>
  cfg.br ^loop(%c0: i32, %seed: vector<2x3xi1>)
^loop(%iteration: i32, %predicates: vector<2x3xi1>):
  %again = scalar.cmpi slt, %iteration, %limit : i32
  cfg.cond_br %again, ^body, ^exit
^body:
  %next = scalar.addi %iteration, %c1 : i32
  %inverted = vector.xori %predicates, %true_words : vector<2x3xi1>
  cfg.br ^loop(%next: i32, %inverted: vector<2x3xi1>)
^exit:
  func.return %predicates : vector<2x3xi1>
}

// ----
test.target<low_core> @target

func.def public target(@target) @ranked_predicates(%limit: i32, %seed: vector<2x3xi1>) -> (vector<2x3xi1>) {
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %true_words_scalar = scalar.constant 1 : i1
  %true_words = vector.splat %true_words_scalar : vector<2x3xi1>
  cfg.br ^loop(%c0: i32, %seed: vector<2x3xi1>)
^loop(%iteration: i32, %predicates: vector<2x3xi1>):
  %12 = scalar.constant 1 : i32
  %13 = vector.splat %12 : vector<2x3xi32>
  %14 = scalar.constant 0 : i32
  %15 = vector.splat %14 : vector<2x3xi32>
  %16 = vector.select %predicates, %13, %15 : vector<2x3xi32>
  %again = scalar.cmpi slt, %iteration, %limit : i32
  cfg.cond_br %again, ^body, ^exit
^body:
  %next = scalar.addi %iteration, %c1 : i32
  %inverted = vector.xori %predicates, %true_words : vector<2x3xi1>
  cfg.br ^loop(%next: i32, %inverted: vector<2x3xi1>)
^exit:
  %17 = scalar.constant 0 : i32
  %18 = vector.splat %17 : vector<2x3xi32>
  %19 = vector.cmpi ne, %16, %18 : vector<2x3xi32> -> vector<2x3xi1>
  func.return %19 : vector<2x3xi1>
}

// ====

// RUN: pass specialize-target-callgraph,project-loop-predicate-lifetimes

x86.target<avx2> @target

// A provider with durable native predicates retains the exact source program.
func.def public target(@target) @direct_predicates(%limit: i32, %seed: vector<2x3xi1>) -> (vector<2x3xi1>) {
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %true_words_scalar = scalar.constant 1 : i1
  %true_words = vector.splat %true_words_scalar : vector<2x3xi1>
  cfg.br ^loop(%c0: i32, %seed: vector<2x3xi1>)
^loop(%iteration: i32, %predicates: vector<2x3xi1>):
  %again = scalar.cmpi slt, %iteration, %limit : i32
  cfg.cond_br %again, ^body, ^exit
^body:
  %next = scalar.addi %iteration, %c1 : i32
  %inverted = vector.xori %predicates, %true_words : vector<2x3xi1>
  cfg.br ^loop(%next: i32, %inverted: vector<2x3xi1>)
^exit:
  func.return %predicates : vector<2x3xi1>
}

