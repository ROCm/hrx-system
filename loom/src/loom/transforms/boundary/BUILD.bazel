load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_cc_library(
    name = "projection_core",
    srcs = [
        "projection_apply.c",
        "projection_branch.c",
        "projection_driver.c",
        "projection_loop.c",
        "projection_plan.c",
    ],
    hdrs = [
        "projection_apply.h",
        "projection_branch.h",
        "projection_driver.h",
        "projection_loop.h",
        "projection_plan.h",
        "projection_rule.h",
    ],
    deps = [
        "//loom/src/loom/ir",
        "//loom/src/loom/ir:facts",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/ops/cfg",
        "//loom/src/loom/pass:types",
        "//loom/src/loom/pass:value_facts",
        "//loom/src/loom/rewrite:loop_like",
        "//loom/src/loom/rewrite:remap",
        "//loom/src/loom/rewrite:rewriter",
        "//loom/src/loom/target:function_version",
        "//loom/src/loom/target:pass_environment",
        "//loom/src/loom/util:fact_table",
        "//loom/src/loom/util:walk",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal",
        "//runtime/src/iree/base/internal:arena",
    ],
)

loom_cc_test(
    name = "projection_test",
    srcs = ["projection_test.cc"],
    deps = [
        ":projection_core",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops/cfg",
        "//loom/src/loom/ops/index",
        "//loom/src/loom/ops/test",
        "//loom/src/loom/pass:value_facts",
        "//loom/src/loom/verify",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_test(
    name = "projection_loop_test",
    srcs = ["projection_loop_test.cc"],
    deps = [
        ":projection_core",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/ops/index",
        "//loom/src/loom/ops/scf",
        "//loom/src/loom/ops/test",
        "//loom/src/loom/pass:value_facts",
        "//loom/src/loom/util:walk",
        "//loom/src/loom/verify",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "projection",
    srcs = [
        "loop_predicate_projection.c",
        "projection.c",
    ],
    hdrs = [
        "loop_predicate_projection.h",
        "projection.h",
    ],
    deps = [
        ":predicate_word",
        ":projection_core",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops/scalar",
        "//loom/src/loom/ops/scf",
        "//loom/src/loom/ops/vector",
        "//loom/src/loom/pass:types",
        "//loom/src/loom/target:function_version",
        "//loom/src/loom/target:pass_environment",
        "//loom/src/loom/target:provider",
        "//loom/src/loom/transforms/encoding:layout_projection",
        "//loom/src/loom/transforms/vector:packet_boundary_projection",
        "//loom/src/loom/transforms/view:boundary_projection",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "predicate_word",
    srcs = ["predicate_word.c"],
    hdrs = ["predicate_word.h"],
    deps = [
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/ops/scalar",
        "//loom/src/loom/ops/scf",
        "//loom/src/loom/ops/vector",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "predicate_lifetimes",
    srcs = ["predicate_lifetimes.c"],
    hdrs = ["predicate_lifetimes.h"],
    deps = [
        ":predicate_word",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/pass:types",
        "//loom/src/loom/pass:value_facts",
        "//loom/src/loom/rewrite:rewriter",
        "//loom/src/loom/target:function_version",
        "//loom/src/loom/target:provider",
        "//loom/src/loom/util:fact_table",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
    ],
)
