load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_library",
    "loom_generated_file",
)

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

exports_files(["approximate_f32_recipes.loom"])

loom_generated_file(
    name = "approximate_f32_recipe_tables_gen",
    args = ["--input=$(location approximate_f32_recipes.loom)"],
    generator = "//loom/py/loom/gen/math:recipe_program_generator",
    inputs = ["approximate_f32_recipes.loom"],
    output = "approximate_f32_recipe_tables.inl",
    output_flag = "--output=",
)

loom_cc_library(
    name = "legalize",
    srcs = [
        "evaluation.c",
        "evaluation.h",
        "legalize.c",
        "patterns.c",
        "patterns.h",
        "patterns_elementwise.c",
        "recipe_program.c",
        "recipe_program.h",
    ],
    hdrs = ["legalize.h"],
    textual_hdrs = [":approximate_f32_recipe_tables.inl"],
    deps = [
        "//loom/src/loom/error:error_defs",
        "//loom/src/loom/ir",
        "//loom/src/loom/ir:facts",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/ops/scalar",
        "//loom/src/loom/ops/scf",
        "//loom/src/loom/ops/vector",
        "//loom/src/loom/pass:options",
        "//loom/src/loom/pass:pipeline",
        "//loom/src/loom/pass:registry",
        "//loom/src/loom/pass:types",
        "//loom/src/loom/pass:value_facts",
        "//loom/src/loom/rewrite:greedy",
        "//loom/src/loom/rewrite:rewriter",
        "//loom/src/loom/target:legalization",
        "//loom/src/loom/target:math_policy",
        "//loom/src/loom/target:pass_environment",
        "//loom/src/loom/target/reporting:report",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
    ],
)
