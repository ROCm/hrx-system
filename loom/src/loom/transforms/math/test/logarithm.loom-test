// RUN: pass legalize-math

x86.target<avx2> @target

func.def target(@target) @natural_logarithm(%input: f32) -> (f32) {
  %result = scalar.logf<afn> %input : f32
  func.return %result : f32
}

// ----
x86.target<avx2> @target

func.def target(@target) @natural_logarithm(%input: f32) -> (f32) {
  %3, %4 = scalar.frexpf %input : f32, i32
  %5 = scalar.sitofp %4 : i32 to f32
  %6 = scalar.constant 1.0 : f32
  %7 = scalar.constant 0.70710678118654757 : f32
  %8 = scalar.addf<contract> %3, %3 : f32
  %9 = scalar.subf<contract> %5, %6 : f32
  %10 = scalar.cmpf<contract> oge, %3, %7 : f32
  %11 = scf.select %10, %3, %8 : f32
  %12 = scf.select %10, %5, %9 : f32
  %13 = scalar.subf<contract> %11, %6 : f32
  %14 = scalar.addf<contract> %11, %6 : f32
  %15 = scalar.divf<contract> %13, %14 : f32
  %16 = scalar.mulf<contract> %15, %15 : f32
  %17 = scalar.constant 0.1111111111111111 : f32
  %18 = scalar.constant 0.14285714285714285 : f32
  %19 = scalar.fmaf<contract> %17, %16, %18 : f32
  %20 = scalar.constant 0.20000000000000001 : f32
  %21 = scalar.fmaf<contract> %19, %16, %20 : f32
  %22 = scalar.constant 0.33333333333333331 : f32
  %23 = scalar.fmaf<contract> %21, %16, %22 : f32
  %24 = scalar.constant 1.0 : f32
  %25 = scalar.fmaf<contract> %23, %16, %24 : f32
  %26 = scalar.addf<contract> %15, %15 : f32
  %27 = scalar.mulf<contract> %26, %25 : f32
  %28 = scalar.constant 0.69314718055994529 : f32
  %29 = scalar.fmaf<contract> %12, %28, %27 : f32
  %30 = scalar.constant 0.0 : f32
  %31 = scalar.constant inf : f32
  %32 = scalar.constant -inf : f32
  %33 = scalar.constant nan : f32
  %34 = scalar.cmpf<contract> oge, %3, %30 : f32
  %35 = scalar.cmpf<contract> oeq, %3, %30 : f32
  %36 = scalar.cmpf<contract> oeq, %3, %31 : f32
  %37 = scf.select %34, %29, %33 : f32
  %38 = scf.select %35, %32, %37 : f32
  %result = scf.select %36, %31, %38 : f32
  func.return %result : f32
}

// ====

x86.target<avx512> @target

func.def target(@target) @strict_increment_requires_permission(%input: f64) -> (f64) {
  // ERROR@+1: LOWERING/036 {op_name="scalar.log1pf", math_op="log1pf", element_type="f64", constraint_key="math.logarithm.afn"}
  %result = scalar.log1pf %input : f64
  func.return %result : f64
}

// ====

x86.target<avx2> @target

func.def target(@target) @strict_narrow_requires_permission(%input: vector<3xbf16>) -> (vector<3xbf16>) {
  // ERROR@+1: LOWERING/036 {op_name="vector.log10f", math_op="log10f", element_type="bf16", constraint_key="math.logarithm.afn"}
  %result = vector.log10f %input : vector<3xbf16>
  func.return %result : vector<3xbf16>
}
