// RUN: pass legalize-math

test.target<low_core> @math_target {contract_set_key = "test.math.gelu_bf16_packet"}

func.def target(@math_target) @f32_packet(%input: vector<16xf32>) -> (vector<16xf32>) {
  %result = vector.geluf<tanh, afn> %input : vector<16xf32>
  func.return %result : vector<16xf32>
}

// ----
test.target<low_core> @math_target {contract_set_key = "test.math.gelu_bf16_packet"}

func.def target(@math_target) @f32_packet(%input: vector<16xf32>) -> (vector<16xf32>) {
  %3 = vector.fptrunc %input : vector<16xf32> to vector<16xbf16>
  %4 = vector.constant 0.0 : vector<16xbf16>
  %5 = vector.constant 0.0 : vector<16xf32>
  %6 = vector.interleave<0> %3, %4 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %7 = vector.dot2f %6, %6, %5 : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  %8 = vector.fptrunc %7 : vector<16xf32> to vector<16xbf16>
  %9 = vector.interleave<0> %8, %4 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %10 = vector.constant 0.03564453125 : vector<16xbf16>
  %11 = vector.interleave<0> %10, %4 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %12 = vector.dot2f %6, %11, %5 : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  %13 = vector.fptrunc %12 : vector<16xf32> to vector<16xbf16>
  %14 = vector.interleave<0> %13, %4 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %15 = vector.constant 0.796875 : vector<16xbf16>
  %16 = vector.interleave<0> %15, %4 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %17 = vector.dot2f %6, %16, %5 : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  %18 = vector.dot2f %14, %9, %17 : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  %19 = vector.tanhf<afn> %18 : vector<16xf32>
  %20 = vector.constant 0.5 : vector<16xbf16>
  %21 = vector.interleave<0> %20, %4 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %22 = vector.dot2f %6, %21, %5 : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  %23 = vector.fptrunc %22 : vector<16xf32> to vector<16xbf16>
  %24 = vector.interleave<0> %23, %4 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %25 = vector.fptrunc %19 : vector<16xf32> to vector<16xbf16>
  %26 = vector.interleave<0> %25, %4 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %result = vector.dot2f %26, %24, %22 : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  func.return %result : vector<16xf32>
}

