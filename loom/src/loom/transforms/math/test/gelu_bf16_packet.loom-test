// ----
test.target<low_core> @math_target {contract_set_key = "test.math.gelu_bf16_packet"}

func.def target(@math_target) @f8_scalar_logistic(%input: f8E5M2) -> (f8E5M2) {
  %3 = scalar.extf %input : f8E5M2 to bf16
  %4 = vector.splat %3 : vector<16xbf16>
  %5 = vector.constant 0.0 : vector<16xbf16>
  %6 = vector.constant 0.0 : vector<16xf32>
  %7 = vector.interleave<0> %4, %5 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %8 = vector.constant 0.85099999999999998 : vector<16xbf16>
  %9 = vector.interleave<0> %8, %5 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %10 = vector.dot2f %7, %9, %6 : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  %11 = vector.tanhf<afn> %10 : vector<16xf32>
  %12 = vector.constant 0.5 : vector<16xbf16>
  %13 = vector.interleave<0> %12, %5 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %14 = vector.dot2f %7, %13, %6 : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  %15 = vector.fptrunc %14 : vector<16xf32> to vector<16xbf16>
  %16 = vector.interleave<0> %15, %5 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %17 = vector.fptrunc %11 : vector<16xf32> to vector<16xbf16>
  %18 = vector.interleave<0> %17, %5 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %19 = vector.dot2f %18, %16, %14 : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  %20 = vector.extract %19[0] : vector<16xf32> -> f32
  %result = scalar.fptrunc %20 : f32 to f8E5M2
  func.return %result : f8E5M2
}
