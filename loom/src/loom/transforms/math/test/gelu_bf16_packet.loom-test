test.target<low_core> @math_target {contract_set_key = "test.math.gelu_bf16_packet"}

func.def target(@math_target) @f16_scalar_erf(%input: f16) -> (f16) {
  %3 = scalar.extf %input : f16 to f32
  %4 = scalar.fptrunc %3 : f32 to bf16
  %5 = vector.splat %4 : vector<16xbf16>
  %6 = vector.constant 0.0 : vector<16xbf16>
  %7 = vector.constant 0.0 : vector<16xf32>
  %8 = vector.interleave<0> %5, %6 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %9 = vector.dot2f %8, %8, %7 : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  %10 = vector.fptrunc %9 : vector<16xf32> to vector<16xbf16>
  %11 = vector.interleave<0> %10, %6 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %12 = vector.constant 0.03564453125 : vector<16xbf16>
  %13 = vector.interleave<0> %12, %6 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %14 = vector.dot2f %8, %13, %7 : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  %15 = vector.fptrunc %14 : vector<16xf32> to vector<16xbf16>
  %16 = vector.interleave<0> %15, %6 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %17 = vector.constant 0.796875 : vector<16xbf16>
  %18 = vector.interleave<0> %17, %6 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %19 = vector.dot2f %8, %18, %7 : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  %20 = vector.dot2f %16, %11, %19 : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  %21 = vector.tanhf<afn> %20 : vector<16xf32>
  %22 = vector.constant 0.5 : vector<16xbf16>
  %23 = vector.interleave<0> %22, %6 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %24 = vector.dot2f %8, %23, %7 : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  %25 = vector.fptrunc %24 : vector<16xf32> to vector<16xbf16>
  %26 = vector.interleave<0> %25, %6 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %27 = vector.fptrunc %21 : vector<16xf32> to vector<16xbf16>
  %28 = vector.interleave<0> %27, %6 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %29 = vector.dot2f %28, %26, %24 : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  %30 = vector.extract %29[0] : vector<16xf32> -> f32
  %result = scalar.fptrunc %30 : f32 to f16
  func.return %result : f16
}

