  %69 = scf.select %68, %19, %11 : i64
  %21 = scalar.subi %69, %71 : i64
  %22 = scalar.constant 9218868437227405312 : i64
  %23 = scalar.cmpi eq, %8, %10 : i64
  %24 = scalar.cmpi uge, %8, %22 : i64
  %25 = scalar.ori %23, %24 : i1
  %26 = scalar.extsi %exponent : i32 to i64
  %27 = scalar.constant -4096 : i64
  %28 = scalar.constant 4096 : i64
  %66 = scalar.cmpi sgt, %26, %27 : i64
  %67 = scf.select %66, %26, %27 : i64
  %64 = scalar.cmpi slt, %67, %28 : i64
  %65 = scf.select %64, %67, %28 : i64
  %31 = scalar.addi %21, %65 : i64
  %32 = scalar.constant 0 : i64
  %33 = scalar.constant 1 : i64
  %34 = scalar.constant 52 : i64
  %35 = scalar.constant 4503599627370496 : i64
  %36 = scalar.ori %18, %35 : i64
  %37 = scalar.shli %31, %34 : i64
  %38 = scalar.ori %37, %18 : i64
  %39 = scalar.constant 54 : i64
  %40 = scalar.subi %33, %31 : i64
  %62 = scalar.cmpi sgt, %40, %33 : i64
  %63 = scf.select %62, %40, %33 : i64
  %60 = scalar.cmpi slt, %63, %39 : i64
  %61 = scf.select %60, %63, %39 : i64
  %78 = scalar.constant -1 : i64
  %79 = scalar.addi %61, %78 : i64
  %44 = scalar.shli %33, %79 : i64
  %72 = scalar.constant -1 : i64
  %46 = scalar.shrui %36, %61 : i64
  %47 = scalar.andi %46, %33 : i64
  %74 = scalar.addi %44, %36 : i64
  %76 = scalar.addi %74, %47 : i64
  %77 = scalar.addi %76, %72 : i64
  %50 = scalar.shrui %77, %61 : i64
  %51 = scalar.cmpi sgt, %31, %32 : i64
  %52 = scf.select %51, %38, %50 : i64
  %53 = scalar.constant 2047 : i64
  %54 = scalar.constant 9218868437227405312 : i64
  %55 = scalar.cmpi sge, %31, %53 : i64
  %56 = scf.select %55, %54, %52 : i64
  %57 = scalar.ori %56, %7 : i64
  %58 = scf.select %25, %4, %57 : i64
  %result = scalar.bitcast %58 : i64 to f64
  func.return %result : f64
}

// ====

test.target<low_core> @reference

func.def target(@reference) @decompose_f32(%input: f32) -> (f32, i32) {
  %fraction, %exponent = scalar.frexpf %input : f32, i32
  func.return %fraction, %exponent : f32, i32
}

// ----
test.target<low_core> @reference

func.def target(@reference) @decompose_f32(%input: f32) -> (f32, i32) {
  %5 = scalar.bitcast %input : f32 to i32
  %6 = scalar.constant -2147483648 : i32
  %7 = scalar.constant 2147483647 : i32
  %8 = scalar.andi %5, %6 : i32
  %9 = scalar.andi %5, %7 : i32
  %10 = scalar.constant 8388607 : i32
  %11 = scalar.constant 0 : i32
  %12 = scalar.constant 1 : i32
  %13 = scalar.constant 23 : i32
  %15 = scalar.ctlzi %9 : i32
  %42 = scalar.constant -8 : i32
  %43 = scalar.addi %15, %42 : i32
  %38 = scalar.cmpi sgt, %43, %11 : i32
  %39 = scf.select %38, %43, %11 : i32
  %18 = scalar.shli %9, %39 : i32
  %19 = scalar.andi %18, %10 : i32
  %20 = scalar.shrui %9, %13 : i32
  %36 = scalar.cmpi sgt, %20, %12 : i32
  %37 = scf.select %36, %20, %12 : i32
  %22 = scalar.subi %37, %39 : i32
  %23 = scalar.constant 2139095040 : i32
  %24 = scalar.cmpi eq, %9, %11 : i32
  %25 = scalar.cmpi uge, %9, %23 : i32
  %26 = scalar.ori %24, %25 : i1
  %27 = scalar.constant 1056964608 : i32
  %28 = scalar.ori %19, %27 : i32
  %29 = scalar.ori %28, %8 : i32
  %30 = scf.select %26, %5, %29 : i32
  %fraction = scalar.bitcast %30 : i32 to f32
  %40 = scalar.constant -126 : i32
  %41 = scalar.addi %22, %40 : i32
  %34 = scalar.constant 0 : i32
  %exponent = scf.select %26, %34, %41 : i32
  func.return %fraction, %exponent : f32, i32
}

// ====

// Keep the exponent decomposition visible before final integer lane lowering.
// RUN: pass target-legalize{mode=eager,policy=prefer-native},canonicalize,dce
test.target<low_core> @reference

func.def target(@reference) @decompose_vector_f64(%input: vector<2xf64>) -> (vector<2xf64>, vector<2xi32>) {
  %fraction, %exponent = vector.frexpf %input : vector<2xf64>, vector<2xi32>
  func.return %fraction, %exponent : vector<2xf64>, vector<2xi32>
}

// ----
test.target<low_core> @reference

func.def target(@reference) @decompose_vector_f64(%input: vector<2xf64>) -> (vector<2xf64>, vector<2xi32>) {
  %5 = vector.bitcast %input : vector<2xf64> to vector<2xi64>
  %6 = vector.splati -9223372036854775808 : vector<2xi64>
  %7 = vector.splati 9223372036854775807 : vector<2xi64>
  %8 = vector.andi %5, %6 : vector<2xi64>
  %9 = vector.andi %5, %7 : vector<2xi64>
  %10 = vector.splati 4503599627370495 : vector<2xi64>
  %11 = vector.splati 0 : vector<2xi64>
  %12 = vector.splati 1 : vector<2xi64>
  %13 = vector.splati 52 : vector<2xi64>
  %14 = vector.splati 11 : vector<2xi64>
  %15 = vector.ctlzi %9 : vector<2xi64>
  %16 = vector.subi %15, %14 : vector<2xi64>
  %17 = vector.maxsi %16, %11 : vector<2xi64>
  %18 = vector.shli %9, %17 : vector<2xi64>
  %19 = vector.andi %18, %10 : vector<2xi64>
  %20 = vector.shrui %9, %13 : vector<2xi64>
  %21 = vector.maxsi %20, %12 : vector<2xi64>
  %22 = vector.subi %21, %17 : vector<2xi64>
  %23 = vector.splati 9218868437227405312 : vector<2xi64>
  %24 = vector.cmpi eq, %9, %11 : vector<2xi64> -> vector<2xi1>
  %25 = vector.cmpi uge, %9, %23 : vector<2xi64> -> vector<2xi1>
  %26 = vector.ori %24, %25 : vector<2xi1>
  %27 = vector.splati 4602678819172646912 : vector<2xi64>
  %28 = vector.ori %19, %27 : vector<2xi64>
  %29 = vector.ori %28, %8 : vector<2xi64>
  %30 = vector.select %26, %5, %29 : vector<2xi64>
  %fraction = vector.bitcast %30 : vector<2xi64> to vector<2xf64>
  %32 = vector.splati 1022 : vector<2xi64>
  %33 = vector.subi %22, %32 : vector<2xi64>
  %34 = vector.splati 0 : vector<2xi64>
  %35 = vector.select %26, %34, %33 : vector<2xi64>
  %exponent = vector.trunci %35 : vector<2xi64> to vector<2xi32>
  func.return %fraction, %exponent : vector<2xf64>, vector<2xi32>
}

