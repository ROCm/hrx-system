// RUN: pass target-legalize{mode=eager,policy=reference-only},canonicalize,dce

test.target<low_core> @reference

func.def target(@reference) @scale_f64(%input: f64, %exponent: i32) -> (f64) {
  %result = scalar.ldexpf %input, %exponent : f64, i32
  func.return %result : f64
}

// ----
test.target<low_core> @reference

func.def target(@reference) @scale_f64(%input: f64, %exponent: i32) -> (f64) {
  %4 = scalar.bitcast %input : f64 to i64
  %5 = scalar.constant -9223372036854775808 : i64
  %6 = scalar.constant 9223372036854775807 : i64
  %7 = scalar.andi %4, %5 : i64
  %8 = scalar.andi %4, %6 : i64
  %9 = scalar.constant 4503599627370495 : i64
  %10 = scalar.constant 0 : i64
  %11 = scalar.constant 1 : i64
  %12 = scalar.constant 52 : i64
  %14 = scalar.ctlzi %8 : i64
  %80 = scalar.constant -11 : i64
  %81 = scalar.addi %14, %80 : i64
  %70 = scalar.cmpi sgt, %81, %10 : i64
  %71 = scf.select %70, %81, %10 : i64
  %17 = scalar.shli %8, %71 : i64
  %18 = scalar.andi %17, %9 : i64
  %19 = scalar.shrui %8, %12 : i64
