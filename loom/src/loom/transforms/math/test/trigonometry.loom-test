// RUN: pass target=amd.xdna.aie2p:core legalize-math

// The shared requirement is consumed before the target-native polynomial.
// It does not grant NSZ to the repair, including inside a fast source scope.
func.def @scalar_zero_signs(%input: f32) -> (f32, f32, f32, f32, f32) {
  %native = scalar.sinturnsf<afn> %input : f32
  %sine = scalar.sinf<reassoc|nnan|ninf|nsz|arcp|contract|afn|preserve> %input : f32
  %cosine = scalar.cosf<afn|preserve> %input : f32
  %turn_sine = scalar.sinturnsf<afn|preserve> %input : f32
  %turn_cosine = scalar.costurnsf<afn|preserve> %input : f32
  func.return %native, %sine, %cosine, %turn_sine, %turn_cosine : f32, f32, f32, f32, f32
}

// ----
func.def @scalar_zero_signs(%input: f32) -> (f32, f32, f32, f32, f32) {
  %native = scalar.sinturnsf<afn> %input : f32
  %42 = scalar.sinf<reassoc|nnan|ninf|arcp|contract|afn> %input : f32
  %43 = scalar.constant 0.0 : f32
  %44 = scalar.copysignf<reassoc|nnan|ninf|arcp|contract|afn> %43, %input : f32
  %45 = scalar.constant 2147483647 : i32
  %46 = scalar.constant 0 : i32
  %47 = scalar.bitcast %42 : f32 to i32
  %48 = scalar.andi %47, %45 : i32
  %49 = scalar.cmpi eq, %48, %46 : i32
  %50 = scalar.bitcast %44 : f32 to i32
  %51 = scf.select %49, %50, %47 : i32
  %sine = scalar.bitcast %51 : i32 to f32
  %32 = scalar.cosf<afn> %input : f32
  %33 = scalar.constant 0.0 : f32
  %34 = scalar.constant 2147483647 : i32
  %35 = scalar.constant 0 : i32
  %36 = scalar.bitcast %32 : f32 to i32
  %37 = scalar.andi %36, %34 : i32
  %38 = scalar.cmpi eq, %37, %35 : i32
  %39 = scalar.bitcast %33 : f32 to i32
  %40 = scf.select %38, %39, %36 : i32
  %cosine = scalar.bitcast %40 : i32 to f32
  %21 = scalar.sinturnsf<afn> %input : f32
  %22 = scalar.constant 0.0 : f32
  %23 = scalar.copysignf<afn> %22, %input : f32
  %24 = scalar.constant 2147483647 : i32
  %25 = scalar.constant 0 : i32
  %26 = scalar.bitcast %21 : f32 to i32
  %27 = scalar.andi %26, %24 : i32
  %28 = scalar.cmpi eq, %27, %25 : i32
  %29 = scalar.bitcast %23 : f32 to i32
  %30 = scf.select %28, %29, %26 : i32
  %turn_sine = scalar.bitcast %30 : i32 to f32
  %11 = scalar.costurnsf<afn> %input : f32
  %12 = scalar.constant 0.0 : f32
  %13 = scalar.constant 2147483647 : i32
  %14 = scalar.constant 0 : i32
  %15 = scalar.bitcast %11 : f32 to i32
  %16 = scalar.andi %15, %13 : i32
  %17 = scalar.cmpi eq, %16, %14 : i32
  %18 = scalar.bitcast %12 : f32 to i32
  %19 = scf.select %17, %18, %15 : i32
  %turn_cosine = scalar.bitcast %19 : i32 to f32
  func.return %native, %sine, %cosine, %turn_sine, %turn_cosine : f32, f32, f32, f32, f32
}

// ====
// RUN: pass target=amdgpu:gfx1151 legalize-math

// A radian rewrite retains the required sign of the original source input.
func.def @vector_zero_signs(%input: vector<3xf32>) -> (vector<3xf32>, vector<3xf32>, vector<3xf32>, vector<3xf32>) {
  %sine = vector.sinf<nsz|afn|preserve> %input : vector<3xf32>
  %cosine = vector.cosf<afn|preserve> %input : vector<3xf32>
  %turn_sine = vector.sinturnsf<afn|preserve> %input : vector<3xf32>
  %turn_cosine = vector.costurnsf<afn|preserve> %input : vector<3xf32>
  func.return %sine, %cosine, %turn_sine, %turn_cosine : vector<3xf32>, vector<3xf32>, vector<3xf32>, vector<3xf32>
}

// ----
func.def @vector_zero_signs(%input: vector<3xf32>) -> (vector<3xf32>, vector<3xf32>, vector<3xf32>, vector<3xf32>) {
  %54 = vector.splatf 0.15915494309189535 : vector<3xf32>
  %55 = vector.mulf<afn> %input, %54 : vector<3xf32>
  %56 = vector.sinturnsf<afn> %55 : vector<3xf32>
  %44 = vector.splatf 0.0 : vector<3xf32>
  %45 = vector.copysignf<afn> %44, %input : vector<3xf32>
  %46 = vector.splati 2147483647 : vector<3xi32>
  %47 = vector.splati 0 : vector<3xi32>
  %48 = vector.bitcast %56 : vector<3xf32> to vector<3xi32>
  %49 = vector.andi %48, %46 : vector<3xi32>
  %50 = vector.cmpi eq, %49, %47 : vector<3xi32> -> vector<3xi1>
  %51 = vector.bitcast %45 : vector<3xf32> to vector<3xi32>
  %52 = vector.select %50, %51, %48 : vector<3xi32>
  %sine = vector.bitcast %52 : vector<3xi32> to vector<3xf32>
  %40 = vector.splatf 0.15915494309189535 : vector<3xf32>
  %41 = vector.mulf<afn> %input, %40 : vector<3xf32>
  %42 = vector.costurnsf<afn> %41 : vector<3xf32>
  %31 = vector.splatf 0.0 : vector<3xf32>
  %32 = vector.splati 2147483647 : vector<3xi32>
  %33 = vector.splati 0 : vector<3xi32>
  %34 = vector.bitcast %42 : vector<3xf32> to vector<3xi32>
  %35 = vector.andi %34, %32 : vector<3xi32>
  %36 = vector.cmpi eq, %35, %33 : vector<3xi32> -> vector<3xi1>
  %37 = vector.bitcast %31 : vector<3xf32> to vector<3xi32>
  %38 = vector.select %36, %37, %34 : vector<3xi32>
  %cosine = vector.bitcast %38 : vector<3xi32> to vector<3xf32>
  %19 = vector.sinturnsf<afn> %input : vector<3xf32>
  %20 = vector.splatf 0.0 : vector<3xf32>
  %21 = vector.copysignf<afn> %20, %input : vector<3xf32>
  %22 = vector.splati 2147483647 : vector<3xi32>
  %23 = vector.splati 0 : vector<3xi32>
  %24 = vector.bitcast %19 : vector<3xf32> to vector<3xi32>
  %25 = vector.andi %24, %22 : vector<3xi32>
  %26 = vector.cmpi eq, %25, %23 : vector<3xi32> -> vector<3xi1>
  %27 = vector.bitcast %21 : vector<3xf32> to vector<3xi32>
  %28 = vector.select %26, %27, %24 : vector<3xi32>
  %turn_sine = vector.bitcast %28 : vector<3xi32> to vector<3xf32>
  %9 = vector.costurnsf<afn> %input : vector<3xf32>
  %10 = vector.splatf 0.0 : vector<3xf32>
  %11 = vector.splati 2147483647 : vector<3xi32>
  %12 = vector.splati 0 : vector<3xi32>
  %13 = vector.bitcast %9 : vector<3xf32> to vector<3xi32>
  %14 = vector.andi %13, %11 : vector<3xi32>
  %15 = vector.cmpi eq, %14, %12 : vector<3xi32> -> vector<3xi1>
  %16 = vector.bitcast %10 : vector<3xf32> to vector<3xi32>
  %17 = vector.select %15, %16, %13 : vector<3xi32>
  %turn_cosine = vector.bitcast %17 : vector<3xi32> to vector<3xf32>
  func.return %sine, %cosine, %turn_sine, %turn_cosine : vector<3xf32>, vector<3xf32>, vector<3xf32>, vector<3xf32>
}
