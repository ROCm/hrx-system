// RUN: pass legalize-math

test.target<low_core> @math_target {contract_set_key = "test.math.grouped_product"}

// A non-packet source shape is flattened, widened, and padded before the
// formula is evaluated. The result returns to the authored type and shape.
func.def target(@math_target) @ranked_gelu_tanh(%input: vector<2x4xbf16>) -> (vector<2x4xbf16>) {
  %result = vector.geluf<tanh, afn> %input : vector<2x4xbf16>
  func.return %result : vector<2x4xbf16>
}

// ----
test.target<low_core> @math_target {contract_set_key = "test.math.grouped_product"}

func.def target(@math_target) @ranked_gelu_tanh(%input: vector<2x4xbf16>) -> (vector<2x4xbf16>) {
  %3 = vector.bitcast %input : vector<2x4xbf16> to vector<8xbf16>
  %4 = vector.extf<daz> %3 : vector<8xbf16> to vector<8xf32>
  %5 = scalar.constant 0.0 : f32
  %6 = vector.splat %5 : vector<8xf32>
  %7 = vector.concat<0> %4, %6 : vector<8xf32>, vector<8xf32> -> vector<16xf32>
  %8 = scalar.constant 0.5 : f32
  %9 = vector.splat %8 : vector<16xf32>
  %10 = scalar.constant 1.0 : f32
  %11 = vector.splat %10 : vector<16xf32>
  %12 = scalar.constant 0.044714999999999998 : f32
  %13 = vector.splat %12 : vector<16xf32>
  %14 = scalar.constant 0.79788456080286541 : f32
  %15 = vector.splat %14 : vector<16xf32>
  %16 = scalar.constant 0.0 : f32
  %17 = vector.splat %16 : vector<16xf32>
  %18 = vector.fptrunc<daz|ftz> %7 : vector<16xf32> to vector<16xbf16>
  %19 = scalar.constant 0.0 : bf16
  %20 = vector.splat %19 : vector<16xbf16>
  %21 = vector.interleave<0> %18, %20 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %22 = vector.dot2f %21, %21, %17 : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  %23 = vector.fptrunc<daz|ftz> %22 : vector<16xf32> to vector<16xbf16>
  %24 = vector.interleave<0> %23, %20 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %25 = vector.dot2f %24, %21, %17 : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  %26 = vector.fptrunc<daz|ftz> %13 : vector<16xf32> to vector<16xbf16>
  %27 = vector.interleave<0> %26, %20 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %28 = vector.fptrunc<daz|ftz> %25 : vector<16xf32> to vector<16xbf16>
  %29 = vector.interleave<0> %28, %20 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %30 = vector.dot2f %27, %29, %17 : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  %31 = vector.addf<afn> %7, %30 : vector<16xf32>
  %32 = vector.fptrunc<daz|ftz> %15 : vector<16xf32> to vector<16xbf16>
  %33 = vector.interleave<0> %32, %20 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %34 = vector.fptrunc<daz|ftz> %31 : vector<16xf32> to vector<16xbf16>
  %35 = vector.interleave<0> %34, %20 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %36 = vector.dot2f %33, %35, %17 : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  %37 = vector.tanhf<afn> %36 : vector<16xf32>
  %38 = vector.addf<afn> %11, %37 : vector<16xf32>
  %39 = vector.fptrunc<daz|ftz> %9 : vector<16xf32> to vector<16xbf16>
  %40 = vector.interleave<0> %39, %20 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %41 = vector.dot2f %40, %21, %17 : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  %42 = vector.fptrunc<daz|ftz> %41 : vector<16xf32> to vector<16xbf16>
  %43 = vector.interleave<0> %42, %20 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %44 = vector.fptrunc<daz|ftz> %38 : vector<16xf32> to vector<16xbf16>
  %45 = vector.interleave<0> %44, %20 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %46 = vector.dot2f %43, %45, %17 : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  %47 = vector.slice %46[0] : vector<16xf32> -> vector<8xf32>
  %48 = vector.fptrunc<daz|ftz> %47 : vector<8xf32> to vector<8xbf16>
  %result = vector.bitcast %48 : vector<8xbf16> to vector<2x4xbf16>
  func.return %result : vector<2x4xbf16>
}

// ====

// RUN: pass legalize-math

test.target<low_core> @math_target {contract_set_key = "test.math.grouped_product_f16x4"}

// A second policy configuration proves that SiLU and its nested logistic recipe
// share the same algebra with f16 products and a different packet width.
func.def target(@math_target) @scalar_silu(%input: f8E5M2) -> (f8E5M2) {
  %result = scalar.siluf<afn> %input : f8E5M2
  func.return %result : f8E5M2
}

// ----
test.target<low_core> @math_target {contract_set_key = "test.math.grouped_product_f16x4"}

func.def target(@math_target) @scalar_silu(%input: f8E5M2) -> (f8E5M2) {
  %3 = vector.splat %input : vector<4xf8E5M2>
  %4 = vector.extf %3 : vector<4xf8E5M2> to vector<4xf32>
  %17 = scalar.constant 0.5 : f32
  %18 = vector.splat %17 : vector<4xf32>
  %19 = scalar.constant 1.0 : f32
  %20 = vector.splat %19 : vector<4xf32>
  %21 = scalar.constant 0.0 : f32
  %22 = vector.splat %21 : vector<4xf32>
  %23 = vector.fptrunc %4 : vector<4xf32> to vector<4xf16>
  %24 = scalar.constant 0.0 : f16
  %25 = vector.splat %24 : vector<4xf16>
  %26 = vector.interleave<0> %23, %25 : vector<4xf16>, vector<4xf16> -> vector<8xf16>
  %27 = vector.fptrunc %18 : vector<4xf32> to vector<4xf16>
  %28 = vector.interleave<0> %27, %25 : vector<4xf16>, vector<4xf16> -> vector<8xf16>
  %29 = vector.dot2f %26, %28, %22 : vector<8xf16>, vector<8xf16>, vector<4xf32>
  %30 = vector.tanhf<afn> %29 : vector<4xf32>
  %31 = vector.addf<afn> %20, %30 : vector<4xf32>
  %32 = vector.fptrunc %31 : vector<4xf32> to vector<4xf16>
  %33 = vector.interleave<0> %32, %25 : vector<4xf16>, vector<4xf16> -> vector<8xf16>
  %34 = vector.dot2f %28, %33, %22 : vector<8xf16>, vector<8xf16>, vector<4xf32>
  %6 = scalar.constant 0.0 : f32
  %7 = vector.splat %6 : vector<4xf32>
  %8 = vector.fptrunc %4 : vector<4xf32> to vector<4xf16>
  %9 = scalar.constant 0.0 : f16
  %10 = vector.splat %9 : vector<4xf16>
  %11 = vector.interleave<0> %8, %10 : vector<4xf16>, vector<4xf16> -> vector<8xf16>
  %12 = vector.fptrunc %34 : vector<4xf32> to vector<4xf16>
  %13 = vector.interleave<0> %12, %10 : vector<4xf16>, vector<4xf16> -> vector<8xf16>
  %14 = vector.dot2f %11, %13, %7 : vector<8xf16>, vector<8xf16>, vector<4xf32>
  %15 = vector.fptrunc %14 : vector<4xf32> to vector<4xf8E5M2>
  %result = vector.extract %15[0] : vector<4xf8E5M2> -> f8E5M2
  func.return %result : f8E5M2
}
