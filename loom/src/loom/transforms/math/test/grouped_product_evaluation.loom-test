// RUN: pass legalize-math

test.target<low_core> @math_target {contract_set_key = "test.math.grouped_product"}

// A non-packet source shape is flattened, widened, and padded before the
// formula is evaluated. The result returns to the authored type and shape.
func.def target(@math_target) @ranked_gelu_tanh(%input: vector<2x4xbf16>) -> (vector<2x4xbf16>) {
  %result = vector.geluf<tanh, afn> %input : vector<2x4xbf16>
  func.return %result : vector<2x4xbf16>
}

// ----
test.target<low_core> @math_target {contract_set_key = "test.math.grouped_product"}

func.def target(@math_target) @ranked_gelu_tanh(%input: vector<2x4xbf16>) -> (vector<2x4xbf16>) {
  %3 = vector.bitcast %input : vector<2x4xbf16> to vector<8xbf16>
  %4 = vector.extf<daz> %3 : vector<8xbf16> to vector<8xf32>
  %5 = vector.splatf 0.0 : vector<8xf32>
  %6 = vector.concat<0> %4, %5 : vector<8xf32>, vector<8xf32> -> vector<16xf32>
  %7 = vector.splatf 0.5 : vector<16xf32>
  %8 = vector.splatf 1.0 : vector<16xf32>
  %9 = vector.splatf 0.044714999999999998 : vector<16xf32>
  %10 = vector.splatf 0.79788456080286541 : vector<16xf32>
  %11 = vector.splatf 0.0 : vector<16xf32>
  %12 = vector.fptrunc<daz|ftz> %6 : vector<16xf32> to vector<16xbf16>
  %13 = vector.splatf 0.0 : vector<16xbf16>
  %14 = vector.interleave<0> %12, %13 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %15 = vector.dot2f %14, %14, %11 : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  %16 = vector.fptrunc<daz|ftz> %15 : vector<16xf32> to vector<16xbf16>
  %17 = vector.interleave<0> %16, %13 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %18 = vector.dot2f %17, %14, %11 : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  %19 = vector.fptrunc<daz|ftz> %9 : vector<16xf32> to vector<16xbf16>
  %20 = vector.interleave<0> %19, %13 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %21 = vector.fptrunc<daz|ftz> %18 : vector<16xf32> to vector<16xbf16>
  %22 = vector.interleave<0> %21, %13 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %23 = vector.dot2f %20, %22, %11 : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  %24 = vector.addf<afn> %6, %23 : vector<16xf32>
  %25 = vector.fptrunc<daz|ftz> %10 : vector<16xf32> to vector<16xbf16>
  %26 = vector.interleave<0> %25, %13 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %27 = vector.fptrunc<daz|ftz> %24 : vector<16xf32> to vector<16xbf16>
  %28 = vector.interleave<0> %27, %13 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %29 = vector.dot2f %26, %28, %11 : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  %30 = vector.tanhf<afn> %29 : vector<16xf32>
  %31 = vector.addf<afn> %8, %30 : vector<16xf32>
  %32 = vector.fptrunc<daz|ftz> %7 : vector<16xf32> to vector<16xbf16>
  %33 = vector.interleave<0> %32, %13 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %34 = vector.dot2f %33, %14, %11 : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  %35 = vector.fptrunc<daz|ftz> %34 : vector<16xf32> to vector<16xbf16>
  %36 = vector.interleave<0> %35, %13 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %37 = vector.fptrunc<daz|ftz> %31 : vector<16xf32> to vector<16xbf16>
  %38 = vector.interleave<0> %37, %13 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %39 = vector.dot2f %36, %38, %11 : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  %40 = vector.slice %39[0] : vector<16xf32> -> vector<8xf32>
  %41 = vector.fptrunc<daz|ftz> %40 : vector<8xf32> to vector<8xbf16>
  %result = vector.bitcast %41 : vector<8xbf16> to vector<2x4xbf16>
  func.return %result : vector<2x4xbf16>
}

// ====

// RUN: pass legalize-math

test.target<low_core> @math_target {contract_set_key = "test.math.grouped_product_f16x4"}

// A second policy configuration proves that SiLU and its nested logistic recipe
// share the same algebra with f16 products and a different packet width.
func.def target(@math_target) @scalar_silu(%input: f8E5M2) -> (f8E5M2) {
  %result = scalar.siluf<afn> %input : f8E5M2
  func.return %result : f8E5M2
}

// ----
test.target<low_core> @math_target {contract_set_key = "test.math.grouped_product_f16x4"}

func.def target(@math_target) @scalar_silu(%input: f8E5M2) -> (f8E5M2) {
  %3 = vector.splat %input : vector<4xf8E5M2>
  %4 = vector.extf %3 : vector<4xf8E5M2> to vector<4xf32>
  %15 = vector.splatf 0.5 : vector<4xf32>
  %16 = vector.splatf 1.0 : vector<4xf32>
  %17 = vector.splatf 0.0 : vector<4xf32>
  %18 = vector.fptrunc %4 : vector<4xf32> to vector<4xf16>
  %19 = vector.splatf 0.0 : vector<4xf16>
  %20 = vector.interleave<0> %18, %19 : vector<4xf16>, vector<4xf16> -> vector<8xf16>
  %21 = vector.fptrunc %15 : vector<4xf32> to vector<4xf16>
  %22 = vector.interleave<0> %21, %19 : vector<4xf16>, vector<4xf16> -> vector<8xf16>
  %23 = vector.dot2f %20, %22, %17 : vector<8xf16>, vector<8xf16>, vector<4xf32>
  %24 = vector.tanhf<afn> %23 : vector<4xf32>
  %25 = vector.addf<afn> %16, %24 : vector<4xf32>
  %26 = vector.fptrunc %25 : vector<4xf32> to vector<4xf16>
  %27 = vector.interleave<0> %26, %19 : vector<4xf16>, vector<4xf16> -> vector<8xf16>
  %28 = vector.dot2f %22, %27, %17 : vector<8xf16>, vector<8xf16>, vector<4xf32>
  %6 = vector.splatf 0.0 : vector<4xf32>
  %7 = vector.fptrunc %4 : vector<4xf32> to vector<4xf16>
  %8 = vector.splatf 0.0 : vector<4xf16>
  %9 = vector.interleave<0> %7, %8 : vector<4xf16>, vector<4xf16> -> vector<8xf16>
  %10 = vector.fptrunc %28 : vector<4xf32> to vector<4xf16>
  %11 = vector.interleave<0> %10, %8 : vector<4xf16>, vector<4xf16> -> vector<8xf16>
  %12 = vector.dot2f %9, %11, %6 : vector<8xf16>, vector<8xf16>, vector<4xf32>
  %13 = vector.fptrunc %12 : vector<4xf32> to vector<4xf8E5M2>
  %result = vector.extract %13[0] : vector<4xf8E5M2> -> f8E5M2
  func.return %result : f8E5M2
}
