load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")
load("//loom/build_tools/bazel:loom_check.bzl", "loom_check_test", "loom_check_test_suite")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_check_test_suite(
    name = "generic_test",
    srcs = [
        "exponent.loom-test",
        "grouped_product_evaluation.loom-test",
        "legalize.loom-test",
        "widen_f32_round.loom-test",
    ],
)

loom_check_test(
    name = "trigonometry",
    src = "trigonometry.loom-test",
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/arch:aie2p",
        "//loom/config/arch:amdgpu",
    ]),
)

loom_check_test(
    name = "trigonometry_narrow",
    src = "trigonometry_narrow.loom-test",
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/arch:spirv",
    ]),
)

test_suite(
    name = "test",
    tests = [
        ":generic_test",
        ":trigonometry",
        ":trigonometry_narrow",
    ],
)
