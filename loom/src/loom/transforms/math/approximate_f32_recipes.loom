func.def @approximate_f32_exp2(%value: f32) -> (f32) {
  %value_bits = scalar.bitcast %value : f32 to i32
  %magnitude_mask = scalar.constant 2147483647 : i32
  %magnitude_bits = scalar.andi %value_bits, %magnitude_mask : i32
  %magnitude = scalar.bitcast %magnitude_bits : i32 to f32
  %shift = scalar.constant 12582912.0 : f32
  %biased = scalar.addf %value, %shift : f32
  %integral = scalar.subf %biased, %shift : f32
  %biased_bits = scalar.bitcast %biased : f32 to i32
  %shift_bits = scalar.bitcast %shift : f32 to i32
  %integral_integer = scalar.subi %biased_bits, %shift_bits : i32
  %residual = scalar.subf %value, %integral : f32
  %squared = scalar.mulf %residual, %residual : f32
  %c0 = scalar.constant 0.0013183277333155274 : f32
  %c1 = scalar.constant 0.0096714366227388382 : f32
  %pair01 = scalar.fmaf %c0, %residual, %c1 : f32
  %c2 = scalar.constant 0.055510137230157852 : f32
  %c3 = scalar.constant 0.24022242426872253 : f32
  %pair23_initial = scalar.fmaf %c2, %residual, %c3 : f32
  %pair23 = scalar.fmaf %pair01, %squared, %pair23_initial : f32
  %c4 = scalar.constant 0.69314676523208618 : f32
  %linear = scalar.mulf %residual, %c4 : f32
  %polynomial = scalar.fmaf %pair23, %squared, %linear : f32
  %exponent_shift = scalar.constant 23 : i32
  %exponent_bits = scalar.shli %integral_integer, %exponent_shift : i32
  %exponent_bias_bits = scalar.constant 1065353216 : i32
  %scale_bits = scalar.addi %exponent_bits, %exponent_bias_bits : i32
  %scale = scalar.bitcast %scale_bits : i32 to f32
  %ordinary = scalar.fmaf %scale, %polynomial, %scale : f32
  %sign_mask = scalar.constant -2147483648 : i32
  %sign_bits = scalar.andi %value_bits, %sign_mask : i32
  %sign_tail_shift = scalar.constant 6 : i32
  %sign_tail = scalar.shrui %sign_bits, %sign_tail_shift : i32
  %special_offset = scalar.ori %sign_bits, %sign_tail : i32
  %scale1_bias_bits = scalar.constant 2130706432 : i32
  %scale1_bits = scalar.addi %special_offset, %scale1_bias_bits : i32
  %scale2_bits = scalar.subi %exponent_bits, %special_offset : i32
  %scale1 = scalar.bitcast %scale1_bits : i32 to f32
  %scale2 = scalar.bitcast %scale2_bits : i32 to f32
  %scale2_polynomial = scalar.fmaf %scale2, %polynomial, %scale2 : f32
  %split = scalar.mulf %scale2_polynomial, %scale1 : f32
  %far_result = scalar.mulf %scale1, %scale1 : f32
  %special_bound = scalar.constant 126.5 : f32
  %ordinary_range = scalar.cmpf olt, %magnitude, %special_bound : f32
  %bounded_result = scf.select %ordinary_range, %ordinary, %split : f32
  %far_bound = scalar.constant 192.0 : f32
  %far_range = scalar.cmpf ogt, %magnitude, %far_bound : f32
  %result = scf.select %far_range, %far_result, %bounded_result : f32
  func.return %result : f32
}

func.def @approximate_f32_sin_turns(%turns: f32) -> (f32) {
  %value_bits = scalar.bitcast %turns : f32 to i32
  %magnitude_mask = scalar.constant 2147483647 : i32
  %magnitude_bits = scalar.andi %value_bits, %magnitude_mask : i32
  %nonfinite_bits = scalar.constant 2139095040 : i32
  %nonfinite = scalar.cmpi uge, %magnitude_bits, %nonfinite_bits : i32
  %large_bits = scalar.constant 1241513984 : i32
  %large = scalar.cmpi uge, %magnitude_bits, %large_bits : i32
  %significand_mask = scalar.constant 8388607 : i32
  %significand_fraction = scalar.andi %magnitude_bits, %significand_mask : i32
  %hidden_bit = scalar.constant 8388608 : i32
  %significand = scalar.ori %significand_fraction, %hidden_bit : i32
  %c3_i32 = scalar.constant 3 : i32
  %quarter_low = scalar.andi %significand, %c3_i32 : i32
  %c1_i32 = scalar.constant 1 : i32
  %quarter_bit = scalar.andi %significand, %c1_i32 : i32
  %quarter_middle = scalar.shli %quarter_bit, %c1_i32 : i32
  %c0_i32 = scalar.constant 0 : i32
  %middle_bits = scalar.constant 1249902592 : i32
  %below_middle = scalar.cmpi ult, %magnitude_bits, %middle_bits : i32
  %upper_bits = scalar.constant 1258291200 : i32
  %below_upper = scalar.cmpi ult, %magnitude_bits, %upper_bits : i32
  %upper_quarter = scf.select %below_upper, %quarter_middle, %c0_i32 : i32
  %quarter = scf.select %below_middle, %quarter_low, %upper_quarter : i32
  %sign_mask = scalar.constant -2147483648 : i32
  %input_sign = scalar.andi %value_bits, %sign_mask : i32
  %c2_i32 = scalar.constant 2 : i32
  %quarter_phase = scalar.andi %quarter, %c2_i32 : i32
  %phase_shift = scalar.constant 30 : i32
  %cardinal_phase_sign = scalar.shli %quarter_phase, %phase_shift : i32
  %unit_bits = scalar.constant 1065353216 : i32
  %cardinal_unit_signed = scalar.xori %unit_bits, %cardinal_phase_sign : i32
  %quarter_parity = scalar.andi %quarter, %c1_i32 : i32
  %cardinal_unit_bits = scalar.xori %cardinal_unit_signed, %input_sign : i32
  %cardinal_zero = scalar.cmpi eq, %quarter_parity, %c0_i32 : i32
  %cardinal_bits = scf.select %cardinal_zero, %input_sign, %cardinal_unit_bits : i32
  %cardinal = scalar.bitcast %cardinal_bits : i32 to f32
  %c2_f32 = scalar.constant 2.0 : f32
  %doubled = scalar.mulf %turns, %c2_f32 : f32
  %shift = scalar.constant 12582912.0 : f32
  %biased = scalar.addf %doubled, %shift : f32
  %integral = scalar.subf %biased, %shift : f32
  %biased_bits = scalar.bitcast %biased : f32 to i32
  %shift_bits = scalar.bitcast %shift : f32 to i32
  %integral_integer = scalar.subi %biased_bits, %shift_bits : i32
  %residual = scalar.subf %doubled, %integral : f32
  %squared = scalar.mulf %residual, %residual : f32
  %fourth = scalar.mulf %squared, %squared : f32
  %c0 = scalar.constant 3.1415927410125732 : f32
  %c1 = scalar.constant -5.1677126884460449 : f32
  %c2 = scalar.constant 2.5501639842987061 : f32
  %c3 = scalar.constant -0.59926450252532959 : f32
  %c4 = scalar.constant 0.082145869731903076 : f32
  %c5 = scalar.constant -0.00737043097615242 : f32
  %pair01 = scalar.fmaf %c1, %squared, %c0 : f32
  %pair23 = scalar.fmaf %c3, %squared, %c2 : f32
  %pair45 = scalar.fmaf %c5, %squared, %c4 : f32
  %upper = scalar.fmaf %pair45, %fourth, %pair23 : f32
  %polynomial = scalar.fmaf %upper, %fourth, %pair01 : f32
  %magnitude = scalar.mulf %residual, %polynomial : f32
  %magnitude_result_bits = scalar.bitcast %magnitude : f32 to i32
  %integral_parity = scalar.andi %integral_integer, %c1_i32 : i32
  %sign_shift = scalar.constant 31 : i32
  %polynomial_phase_sign = scalar.shli %integral_parity, %sign_shift : i32
  %polynomial_bits = scalar.xori %magnitude_result_bits, %polynomial_phase_sign : i32
  %polynomial_result = scalar.bitcast %polynomial_bits : i32 to f32
  %c0_f32 = scalar.constant 0.0 : f32
  %residual_zero = scalar.cmpf oeq, %residual, %c0_f32 : f32
  %absolute_residual = scalar.absf %residual : f32
  %half = scalar.constant 0.5 : f32
  %residual_half = scalar.cmpf oeq, %absolute_residual, %half : f32
  %residual_bits = scalar.bitcast %residual : f32 to i32
  %residual_sign = scalar.andi %residual_bits, %sign_mask : i32
  %ordinary_unit_phase = scalar.xori %unit_bits, %polynomial_phase_sign : i32
  %ordinary_unit_bits = scalar.xori %ordinary_unit_phase, %residual_sign : i32
  %ordinary_unit = scalar.bitcast %ordinary_unit_bits : i32 to f32
  %signed_zero = scalar.bitcast %input_sign : i32 to f32
  %nonzero_ordinary = scf.select %residual_half, %ordinary_unit, %polynomial_result : f32
  %ordinary = scf.select %residual_zero, %signed_zero, %nonzero_ordinary : f32
  %finite = scf.select %large, %cardinal, %ordinary : f32
  %quiet_nan_bits = scalar.constant 2143289344 : i32
  %quiet_nan = scalar.bitcast %quiet_nan_bits : i32 to f32
  %result = scf.select %nonfinite, %quiet_nan, %finite : f32
  func.return %result : f32
}

func.def @approximate_f32_cos_turns(%turns: f32) -> (f32) {
  %value_bits = scalar.bitcast %turns : f32 to i32
  %magnitude_mask = scalar.constant 2147483647 : i32
  %magnitude_bits = scalar.andi %value_bits, %magnitude_mask : i32
  %nonfinite_bits = scalar.constant 2139095040 : i32
  %nonfinite = scalar.cmpi uge, %magnitude_bits, %nonfinite_bits : i32
  %large_bits = scalar.constant 1241513984 : i32
  %large = scalar.cmpi uge, %magnitude_bits, %large_bits : i32
  %significand_mask = scalar.constant 8388607 : i32
  %significand_fraction = scalar.andi %magnitude_bits, %significand_mask : i32
  %hidden_bit = scalar.constant 8388608 : i32
  %significand = scalar.ori %significand_fraction, %hidden_bit : i32
  %c3_i32 = scalar.constant 3 : i32
  %quarter_low = scalar.andi %significand, %c3_i32 : i32
  %c1_i32 = scalar.constant 1 : i32
  %quarter_bit = scalar.andi %significand, %c1_i32 : i32
  %quarter_middle = scalar.shli %quarter_bit, %c1_i32 : i32
  %c0_i32 = scalar.constant 0 : i32
  %middle_bits = scalar.constant 1249902592 : i32
  %below_middle = scalar.cmpi ult, %magnitude_bits, %middle_bits : i32
  %upper_bits = scalar.constant 1258291200 : i32
  %below_upper = scalar.cmpi ult, %magnitude_bits, %upper_bits : i32
  %upper_quarter = scf.select %below_upper, %quarter_middle, %c0_i32 : i32
  %quarter = scf.select %below_middle, %quarter_low, %upper_quarter : i32
  %sign_mask = scalar.constant -2147483648 : i32
  %input_sign = scalar.andi %value_bits, %sign_mask : i32
  %c2_i32 = scalar.constant 2 : i32
  %quarter_phase = scalar.andi %quarter, %c2_i32 : i32
  %phase_shift = scalar.constant 30 : i32
  %cardinal_phase_sign = scalar.shli %quarter_phase, %phase_shift : i32
  %unit_bits = scalar.constant 1065353216 : i32
  %cardinal_unit_signed = scalar.xori %unit_bits, %cardinal_phase_sign : i32
  %quarter_parity = scalar.andi %quarter, %c1_i32 : i32
  %cardinal_zero = scalar.cmpi ne, %quarter_parity, %c0_i32 : i32
  %cardinal_bits = scf.select %cardinal_zero, %c0_i32, %cardinal_unit_signed : i32
  %cardinal = scalar.bitcast %cardinal_bits : i32 to f32
  %c2_f32 = scalar.constant 2.0 : f32
  %doubled = scalar.mulf %turns, %c2_f32 : f32
  %shift = scalar.constant 12582912.0 : f32
  %biased = scalar.addf %doubled, %shift : f32
  %integral = scalar.subf %biased, %shift : f32
  %biased_bits = scalar.bitcast %biased : f32 to i32
  %shift_bits = scalar.bitcast %shift : f32 to i32
  %integral_integer = scalar.subi %biased_bits, %shift_bits : i32
  %doubled_residual = scalar.subf %doubled, %integral : f32
  %absolute_residual = scalar.absf %doubled_residual : f32
  %half = scalar.constant 0.5 : f32
  %residual = scalar.subf %half, %absolute_residual : f32
  %squared = scalar.mulf %residual, %residual : f32
  %fourth = scalar.mulf %squared, %squared : f32
  %c0 = scalar.constant 3.1415927410125732 : f32
  %c1 = scalar.constant -5.1677126884460449 : f32
  %c2 = scalar.constant 2.5501639842987061 : f32
  %c3 = scalar.constant -0.59926450252532959 : f32
  %c4 = scalar.constant 0.082145869731903076 : f32
  %c5 = scalar.constant -0.00737043097615242 : f32
  %pair01 = scalar.fmaf %c1, %squared, %c0 : f32
  %pair23 = scalar.fmaf %c3, %squared, %c2 : f32
  %pair45 = scalar.fmaf %c5, %squared, %c4 : f32
  %upper = scalar.fmaf %pair45, %fourth, %pair23 : f32
  %polynomial = scalar.fmaf %upper, %fourth, %pair01 : f32
  %magnitude = scalar.mulf %residual, %polynomial : f32
  %magnitude_result_bits = scalar.bitcast %magnitude : f32 to i32
  %integral_parity = scalar.andi %integral_integer, %c1_i32 : i32
  %sign_shift = scalar.constant 31 : i32
  %polynomial_phase_sign = scalar.shli %integral_parity, %sign_shift : i32
  %polynomial_bits = scalar.xori %magnitude_result_bits, %polynomial_phase_sign : i32
  %polynomial_result = scalar.bitcast %polynomial_bits : i32 to f32
  %c0_f32 = scalar.constant 0.0 : f32
  %residual_zero = scalar.cmpf oeq, %residual, %c0_f32 : f32
  %doubled_residual_zero = scalar.cmpf oeq, %doubled_residual, %c0_f32 : f32
  %ordinary_unit_bits = scalar.xori %unit_bits, %polynomial_phase_sign : i32
  %ordinary_unit = scalar.bitcast %ordinary_unit_bits : i32 to f32
  %noncardinal_ordinary = scf.select %residual_zero, %c0_f32, %polynomial_result : f32
  %ordinary = scf.select %doubled_residual_zero, %ordinary_unit, %noncardinal_ordinary : f32
  %finite = scf.select %large, %cardinal, %ordinary : f32
  %quiet_nan_bits = scalar.constant 2143289344 : i32
  %quiet_nan = scalar.bitcast %quiet_nan_bits : i32 to f32
  %result = scf.select %nonfinite, %quiet_nan, %finite : f32
  func.return %result : f32
}
