  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %lhs_scalar = scalar.assume %lhs_input [range(%lhs_input, -100, 100)] : i32
  %rhs_scalar = scalar.assume %rhs_input [ne(%rhs_input, 0)] : i32
  %lhs = vector.splat %lhs_scalar : vector<4xi32>
  %rhs = vector.splat %rhs_scalar : vector<4xi32>
  %signed = vector.divsi %lhs, %rhs : vector<4xi32>
  %unsigned = vector.divui %lhs, %rhs : vector<4xi32>
  %signed_q, %signed_r = vector.divremsi %lhs, %rhs : vector<4xi32>
  %unsigned_q, %unsigned_r = vector.divremui %lhs, %rhs : vector<4xi32>
  %signed_remainder = vector.remsi %lhs, %rhs : vector<4xi32>
  %unsigned_remainder = vector.remui %lhs, %rhs : vector<4xi32>
  %signed_ceil = vector.ceildivsi %lhs, %rhs : vector<4xi32>
  %unsigned_ceil = vector.ceildivui %lhs, %rhs : vector<4xi32>
  %signed_floor = vector.floordivsi %lhs, %rhs : vector<4xi32>
  scf.for %i = [%begin to %count step %step] {
    test.use %signed, %unsigned, %signed_q, %signed_r, %unsigned_q, %unsigned_r, %signed_remainder, %unsigned_remainder, %signed_ceil, %unsigned_ceil, %signed_floor : vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>
  }
  func.return
}

// ====

// A single unsafe lane blocks speculation. Empty vectors have no arithmetic;
// dynamic uniform vectors use the same element facts without enumerating lanes.
func.def @vector_division_domains(%count: index, %length: index, %lhs: vector<2xi8>, %dynamic_lhs: vector<[%length]xi16>, %divisor_input: i16, %empty: vector<0xi64>) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %positive = vector.constanti [2, 3] : vector<2xi8>
  %with_zero = vector.constanti [2, 0] : vector<2xi8>
  %with_minus_one = vector.constanti [2, -1] : vector<2xi8>
  %divisor_scalar = scalar.assume %divisor_input [range(%divisor_input, 1, 100)] : i16
  %dynamic_divisor = vector.splat %divisor_scalar : vector<[%length]xi16>
  scf.for %i = [%begin to %count step %step] {
    %safe = vector.divsi %lhs, %positive : vector<2xi8>
    %unsafe_zero = vector.divui %lhs, %with_zero : vector<2xi8>
    %unsafe_overflow = vector.divsi %lhs, %with_minus_one : vector<2xi8>
    %dynamic_q, %dynamic_r = vector.divremsi %dynamic_lhs, %dynamic_divisor : vector<[%length]xi16>
    %empty_q, %empty_r = vector.divremsi %empty, %empty : vector<0xi64>
    test.use %safe, %unsafe_zero, %unsafe_overflow, %dynamic_q, %dynamic_r, %empty_q, %empty_r : vector<2xi8>, vector<2xi8>, vector<2xi8>, vector<[%length]xi16>, vector<[%length]xi16>, vector<0xi64>, vector<0xi64>
  }
  func.return
}

// ----
func.def @vector_division_domains(%count: index, %length: index, %lhs: vector<2xi8>, %dynamic_lhs: vector<[%length]xi16>, %divisor_input: i16, %empty: vector<0xi64>) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %positive = vector.constanti [2, 3] : vector<2xi8>
  %with_zero = vector.constanti [2, 0] : vector<2xi8>
  %with_minus_one = vector.constanti [2, -1] : vector<2xi8>
  %divisor_scalar = scalar.assume %divisor_input [range(%divisor_input, 1, 100)] : i16
  %dynamic_divisor = vector.splat %divisor_scalar : vector<[%length]xi16>
  %safe = vector.divsi %lhs, %positive : vector<2xi8>
  %dynamic_q, %dynamic_r = vector.divremsi %dynamic_lhs, %dynamic_divisor : vector<[%length]xi16>
  %empty_q, %empty_r = vector.divremsi %empty, %empty : vector<0xi64>
  scf.for %i = [%begin to %count step %step] {
    %unsafe_zero = vector.divui %lhs, %with_zero : vector<2xi8>
    %unsafe_overflow = vector.divsi %lhs, %with_minus_one : vector<2xi8>
    test.use %safe, %unsafe_zero, %unsafe_overflow, %dynamic_q, %dynamic_r, %empty_q, %empty_r : vector<2xi8>, vector<2xi8>, vector<2xi8>, vector<[%length]xi16>, vector<[%length]xi16>, vector<0xi64>, vector<0xi64>
  }
  func.return
}

// ====

// Nonnegative coordinate division cannot overflow on any target width.
// A nonzero but possibly negative index divisor does not meet that contract.
func.def @index_division_domain(%count: index, %lhs_input: index, %rhs_input: index) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %lhs = index.assume %lhs_input [ge(%lhs_input, 0)] : index
  %rhs = index.assume %rhs_input [gt(%rhs_input, 0)] : index
  %nonzero = index.assume %rhs_input [ne(%rhs_input, 0)] : index
  scf.for %i = [%begin to %count step %step] {
    %quotient = index.div %lhs, %rhs : index
    %remainder = index.rem %lhs, %rhs : index
    %q, %r = index.divrem %lhs, %rhs : index
    %unknown_lhs = index.div %lhs_input, %rhs : index
    %unknown_rhs = index.rem %lhs, %rhs_input : index
    %signed_rhs = index.div %lhs, %nonzero : index
    test.use %quotient, %remainder, %q, %r, %unknown_lhs, %unknown_rhs, %signed_rhs : index, index, index, index, index, index, index
  }
  func.return
}

// ----
func.def @index_division_domain(%count: index, %lhs_input: index, %rhs_input: index) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %lhs = index.assume %lhs_input [ge(%lhs_input, 0)] : index
  %rhs = index.assume %rhs_input [gt(%rhs_input, 0)] : index
  %nonzero = index.assume %rhs_input [ne(%rhs_input, 0)] : index
  %quotient = index.div %lhs, %rhs : index
  %remainder = index.rem %lhs, %rhs : index
  %q, %r = index.divrem %lhs, %rhs : index
  scf.for %i = [%begin to %count step %step] {
    %unknown_lhs = index.div %lhs_input, %rhs : index
    %unknown_rhs = index.rem %lhs, %rhs_input : index
    %signed_rhs = index.div %lhs, %nonzero : index
    test.use %quotient, %remainder, %q, %r, %unknown_lhs, %unknown_rhs, %signed_rhs : index, index, index, index, index, index, index
  }
  func.return
}

// ====

// A proof established only under control must not justify extra executions.
func.def @guarded_divisor(%count: index, %lhs: i32, %rhs: i32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %c0 = scalar.constant 0 : i32
  %valid = scalar.cmpi ne, %rhs, %c0 : i32
  scf.for %i = [%begin to %count step %step] {
    scf.if %valid {
      %q, %r = scalar.divremui %lhs, %rhs : i32
      test.use %q, %r : i32, i32
    } else {
    }
  }
  func.return
}

// ====

// A safe carried division does not end the guaranteed entry prefix. The
// dividend is variant, but the following invariant normalization can move.
func.def @normalization_after_carried_division(%dividend: i32, %divisor_input: i32) -> (i32) {
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %divisor = scalar.assume %divisor_input [ne(%divisor_input, 0)] : i32
  %result = scf.for %i = [%begin to %end step %step](%value = %dividend : i32) -> (i32) {
    %q, %r = scalar.divremui %value, %divisor : i32
    %bounded = scalar.assume %divisor [range(%divisor, 32768, 65535)] : i32
    %shift = scalar.ctlzi %bounded : i32
    %normalized = scalar.shli %bounded, %shift : i32
    %sum = scalar.addi %q, %normalized : i32
    scf.yield %sum : i32
  }
  func.return %result : i32
}

// ----
func.def @normalization_after_carried_division(%dividend: i32, %divisor_input: i32) -> (i32) {
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %divisor = scalar.assume %divisor_input [ne(%divisor_input, 0)] : i32
  %bounded = scalar.assume %divisor [range(%divisor, 32768, 65535)] : i32
  %shift = scalar.ctlzi %bounded : i32
  %normalized = scalar.shli %bounded, %shift : i32
  %result = scf.for %i = [%begin to %end step %step](%value = %dividend : i32) -> (i32) {
    %q, %r = scalar.divremui %value, %divisor : i32
    %sum = scalar.addi %q, %normalized : i32
    scf.yield %sum : i32
  }
  func.return %result : i32
}
