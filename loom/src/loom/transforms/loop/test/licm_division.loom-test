  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %lhs = scalar.assume %lhs_input [range(%lhs_input, -100, 100)] : i32
  %rhs = scalar.assume %rhs_input [ne(%rhs_input, 0)] : i32
  %signed = scalar.divsi %lhs, %rhs : i32
  %unsigned = scalar.divui %lhs, %rhs : i32
  %signed_q, %signed_r = scalar.divremsi %lhs, %rhs : i32
  %unsigned_q, %unsigned_r = scalar.divremui %lhs, %rhs : i32
  %signed_remainder = scalar.remsi %lhs, %rhs : i32
  %unsigned_remainder = scalar.remui %lhs, %rhs : i32
  %signed_ceil = scalar.ceildivsi %lhs, %rhs : i32
  %unsigned_ceil = scalar.ceildivui %lhs, %rhs : i32
  %signed_floor = scalar.floordivsi %lhs, %rhs : i32
  scf.for %i = [%begin to %count step %step] {
    test.use %signed, %unsigned, %signed_q, %signed_r, %unsigned_q, %unsigned_r, %signed_remainder, %unsigned_remainder, %signed_ceil, %unsigned_ceil, %signed_floor : i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32
  }
  func.return
}

// ====

// Signed quotient overflow remains guarded, while signed remainder is
// defined for MIN modulo -1. Literal exclusions can prove either operand safe.
func.def @signed_quotient_boundaries(%count: index, %lhs: i8, %rhs_input: i8, %wide_lhs: i64, %wide_rhs_input: i64) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %rhs = scalar.assume %rhs_input [ne(%rhs_input, 0)] : i8
  %safe_lhs = scalar.assume %lhs [ne(%lhs, -128)] : i8
  %safe_rhs = scalar.assume %rhs [ne(%rhs, -1)] : i8
  %wide_rhs = scalar.assume %wide_rhs_input [ne(%wide_rhs_input, 0), ne(%wide_rhs_input, -1)] : i64
  scf.for %i = [%begin to %count step %step] {
    %unsafe_quotient = scalar.divsi %lhs, %rhs : i8
    %unsafe_q, %unsafe_r = scalar.divremsi %lhs, %rhs : i8
    %unsafe_ceil = scalar.ceildivsi %lhs, %rhs : i8
    %unsafe_floor = scalar.floordivsi %lhs, %rhs : i8
    %safe_remainder = scalar.remsi %lhs, %rhs : i8
    %safe_dividend = scalar.divsi %safe_lhs, %rhs : i8
    %safe_divisor = scalar.divsi %lhs, %safe_rhs : i8
    %safe_wide = scalar.divsi %wide_lhs, %wide_rhs : i64
    test.use %unsafe_quotient, %unsafe_q, %unsafe_r, %unsafe_ceil, %unsafe_floor, %safe_remainder, %safe_dividend, %safe_divisor, %safe_wide : i8, i8, i8, i8, i8, i8, i8, i8, i64
  }
  func.return
}

// ----
func.def @signed_quotient_boundaries(%count: index, %lhs: i8, %rhs_input: i8, %wide_lhs: i64, %wide_rhs_input: i64) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %rhs = scalar.assume %rhs_input [ne(%rhs_input, 0)] : i8
  %safe_lhs = scalar.assume %lhs [ne(%lhs, -128)] : i8
  %safe_rhs = scalar.assume %rhs [ne(%rhs, -1)] : i8
  %wide_rhs = scalar.assume %wide_rhs_input [ne(%wide_rhs_input, 0), ne(%wide_rhs_input, -1)] : i64
  %safe_remainder = scalar.remsi %lhs, %rhs : i8
  %safe_dividend = scalar.divsi %safe_lhs, %rhs : i8
  %safe_divisor = scalar.divsi %lhs, %safe_rhs : i8
  %safe_wide = scalar.divsi %wide_lhs, %wide_rhs : i64
  scf.for %i = [%begin to %count step %step] {
    %unsafe_quotient = scalar.divsi %lhs, %rhs : i8
    %unsafe_q, %unsafe_r = scalar.divremsi %lhs, %rhs : i8
    %unsafe_ceil = scalar.ceildivsi %lhs, %rhs : i8
    %unsafe_floor = scalar.floordivsi %lhs, %rhs : i8
    test.use %unsafe_quotient, %unsafe_q, %unsafe_r, %unsafe_ceil, %unsafe_floor, %safe_remainder, %safe_dividend, %safe_divisor, %safe_wide : i8, i8, i8, i8, i8, i8, i8, i8, i64
  }
  func.return
}

// ====

// Boolean facts use raw 0/1; signed arithmetic interprets true as -1.
// The other fixed widths use the same nonzero-divisor proof.
func.def @integer_widths(%count: index, %bit: i1, %half: i16, %wide: i64) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %c0 = scalar.constant 0 : i1
  %nonzero = scalar.assume %bit [ne(%bit, 0)] : i1
  %half_divisor = scalar.assume %half [ne(%half, 0)] : i16
  %wide_divisor = scalar.assume %wide [ne(%wide, 0)] : i64
  scf.for %i = [%begin to %count step %step] {
    %bit_unsigned = scalar.divui %bit, %nonzero : i1
    %bit_remainder = scalar.remsi %bit, %nonzero : i1
    %bit_signed_zero = scalar.divsi %c0, %nonzero : i1
    %bit_signed_overflow = scalar.divsi %bit, %nonzero : i1
    %half_remainder = scalar.remui %half, %half_divisor : i16
    %wide_ceil = scalar.ceildivui %wide, %wide_divisor : i64
    test.use %bit_unsigned, %bit_remainder, %bit_signed_zero, %bit_signed_overflow, %half_remainder, %wide_ceil : i1, i1, i1, i1, i16, i64
  }
  func.return
}

// ----
func.def @integer_widths(%count: index, %bit: i1, %half: i16, %wide: i64) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %c0 = scalar.constant 0 : i1
  %nonzero = scalar.assume %bit [ne(%bit, 0)] : i1
  %half_divisor = scalar.assume %half [ne(%half, 0)] : i16
  %wide_divisor = scalar.assume %wide [ne(%wide, 0)] : i64
  %bit_unsigned = scalar.divui %bit, %nonzero : i1
  %bit_remainder = scalar.remsi %bit, %nonzero : i1
  %bit_signed_zero = scalar.divsi %c0, %nonzero : i1
  %half_remainder = scalar.remui %half, %half_divisor : i16
  %wide_ceil = scalar.ceildivui %wide, %wide_divisor : i64
  scf.for %i = [%begin to %count step %step] {
    %bit_signed_overflow = scalar.divsi %bit, %nonzero : i1
    test.use %bit_unsigned, %bit_remainder, %bit_signed_zero, %bit_signed_overflow, %half_remainder, %wide_ceil : i1, i1, i1, i1, i16, i64
  }
  func.return
}

// ====

// A uniform nonzero predicate survives even when the element interval spans
// both signs. Every vector quotient/remainder form consumes that same fact.
func.def @vector_division_family(%count: index, %lhs_input: i32, %rhs_input: i32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %lhs_scalar = scalar.assume %lhs_input [range(%lhs_input, -100, 100)] : i32
  %rhs_scalar = scalar.assume %rhs_input [ne(%rhs_input, 0)] : i32
  %lhs = vector.splat %lhs_scalar : vector<4xi32>
  %rhs = vector.splat %rhs_scalar : vector<4xi32>
  scf.for %i = [%begin to %count step %step] {
    %signed = vector.divsi %lhs, %rhs : vector<4xi32>
    %unsigned = vector.divui %lhs, %rhs : vector<4xi32>
    %signed_q, %signed_r = vector.divremsi %lhs, %rhs : vector<4xi32>
    %unsigned_q, %unsigned_r = vector.divremui %lhs, %rhs : vector<4xi32>
    %signed_remainder = vector.remsi %lhs, %rhs : vector<4xi32>
    %unsigned_remainder = vector.remui %lhs, %rhs : vector<4xi32>
    %signed_ceil = vector.ceildivsi %lhs, %rhs : vector<4xi32>
    %unsigned_ceil = vector.ceildivui %lhs, %rhs : vector<4xi32>
    %signed_floor = vector.floordivsi %lhs, %rhs : vector<4xi32>
    test.use %signed, %unsigned, %signed_q, %signed_r, %unsigned_q, %unsigned_r, %signed_remainder, %unsigned_remainder, %signed_ceil, %unsigned_ceil, %signed_floor : vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>
  }
  func.return
}

// ----
