// RUN: pass licm

// Division's retained operand preconditions allow motion even out of a
// potentially empty loop. Quotient rounding does not change those domains.
func.def @scalar_division_family(%count: index, %lhs_input: i32, %rhs_input: i32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %lhs = scalar.assume %lhs_input [range(%lhs_input, -100, 100)] : i32
  %rhs = scalar.assume %rhs_input [ne(%rhs_input, 0)] : i32
  scf.for %i = [%begin to %count step %step] {
    %signed = scalar.divsi %lhs, %rhs : i32
    %unsigned = scalar.divui %lhs, %rhs : i32
    %signed_q, %signed_r = scalar.divremsi %lhs, %rhs : i32
    %unsigned_q, %unsigned_r = scalar.divremui %lhs, %rhs : i32
    %signed_remainder = scalar.remsi %lhs, %rhs : i32
    %unsigned_remainder = scalar.remui %lhs, %rhs : i32
    %signed_ceil = scalar.ceildivsi %lhs, %rhs : i32
    %unsigned_ceil = scalar.ceildivui %lhs, %rhs : i32
    %signed_floor = scalar.floordivsi %lhs, %rhs : i32
    test.use %signed, %unsigned, %signed_q, %signed_r, %unsigned_q, %unsigned_r, %signed_remainder, %unsigned_remainder, %signed_ceil, %unsigned_ceil, %signed_floor : i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32
  }
  func.return
}

// ----
