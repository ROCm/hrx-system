// RUN: pass combine,target-legalize{mode=eager,policy=reference-only},dce,canonicalize

test.target<low_core> @target

func.def target(@target) @extract_unsigned_same_width(%source: i32) -> (i32) {
  %intermediate = scalar.trunci %source : i32 to i1
  %result = scalar.extui %intermediate : i1 to i32
  func.return %result : i32
}
// ----
test.target<low_core> @target

func.def target(@target) @extract_unsigned_same_width(%source: i32) -> (i32) {
  %5 = scalar.constant 1 : i32
  %result = scalar.andi %source, %5 : i32
  func.return %result : i32
}

// ====

test.target<low_core> @target

func.def target(@target) @extract_signed_same_width(%source: i64) -> (i64) {
  %intermediate = scalar.trunci %source : i64 to i8
  %result = scalar.extsi %intermediate : i8 to i64
  func.return %result : i64
}
// ----
test.target<low_core> @target

func.def target(@target) @extract_signed_same_width(%source: i64) -> (i64) {
  %5 = scalar.constant 56 : i64
  %6 = scalar.shli %source, %5 : i64
  %7 = scalar.constant 56 : i64
  %result = scalar.shrsi %6, %7 : i64
  func.return %result : i64
}

// ====

test.target<low_core> @target

func.def target(@target) @extract_unsigned_narrower_result(%source: i64) -> (i16) {
  %intermediate = scalar.trunci %source : i64 to i8
  %result = scalar.extui %intermediate : i8 to i16
  func.return %result : i16
}
// ----
test.target<low_core> @target

func.def target(@target) @extract_unsigned_narrower_result(%source: i64) -> (i16) {
  %5 = scalar.constant 255 : i64
  %6 = scalar.andi %source, %5 : i64
  %result = scalar.trunci %6 : i64 to i16
  func.return %result : i16
}

// ====

test.target<low_core> @target

func.def target(@target) @extract_signed_narrower_result(%source: i32) -> (i16) {
  %intermediate = scalar.trunci %source : i32 to i8
  %result = scalar.extsi %intermediate : i8 to i16
  func.return %result : i16
}
// ----
test.target<low_core> @target

func.def target(@target) @extract_signed_narrower_result(%source: i32) -> (i16) {
  %5 = scalar.constant 24 : i32
  %6 = scalar.shli %source, %5 : i32
  %7 = scalar.constant 24 : i32
  %8 = scalar.shrsi %6, %7 : i32
  %result = scalar.trunci %8 : i32 to i16
  func.return %result : i16
}

// ====

test.target<low_core> @target

func.def target(@target) @extract_unsigned_wider_result(%source: i16) -> (i64) {
  %intermediate = scalar.trunci %source : i16 to i1
  %result = scalar.extui %intermediate : i1 to i64
  func.return %result : i64
}
// ----
test.target<low_core> @target

func.def target(@target) @extract_unsigned_wider_result(%source: i16) -> (i64) {
  %5 = scalar.extui %source : i16 to i32
  %6 = scalar.constant 1 : i32
  %7 = scalar.andi %5, %6 : i32
  %result = scalar.extui %7 : i32 to i64
  func.return %result : i64
}

// ====

test.target<low_core> @target

func.def target(@target) @extract_signed_wider_result(%source: i16) -> (i32) {
  %intermediate = scalar.trunci %source : i16 to i8
  %result = scalar.extsi %intermediate : i8 to i32
  func.return %result : i32
}
// ----
test.target<low_core> @target

func.def target(@target) @extract_signed_wider_result(%source: i16) -> (i32) {
  %5 = scalar.extui %source : i16 to i32
  %6 = scalar.constant 24 : i32
  %7 = scalar.shli %5, %6 : i32
  %8 = scalar.constant 24 : i32
  %result = scalar.shrsi %7, %8 : i32
  func.return %result : i32
}

// ====

// The inner cast remains alive for its independent consumer.
test.target<low_core> @target

func.def target(@target) @retained_truncation(%source: i32) -> (i8, i64) {
  %intermediate = scalar.trunci %source : i32 to i8
  %result = scalar.extsi %intermediate : i8 to i64
  func.return %intermediate, %result : i8, i64
}
// ----
test.target<low_core> @target

func.def target(@target) @retained_truncation(%source: i32) -> (i8, i64) {
  %intermediate = scalar.trunci %source : i32 to i8
  %6 = scalar.constant 24 : i32
  %7 = scalar.shli %source, %6 : i32
  %8 = scalar.constant 24 : i32
  %9 = scalar.shrsi %7, %8 : i32
  %result = scalar.extsi %9 : i32 to i64
  func.return %intermediate, %result : i8, i64
}

// ====

// Constant propagation keeps sign fill and zero fill distinct.
test.target<low_core> @target

func.def target(@target) @constant_sign_boundaries() -> (i32, i32) {
  %source = scalar.constant true : i1
  %intermediate = scalar.extsi %source : i1 to i8
  %unsigned = scalar.extui %intermediate : i8 to i32
  %signed = scalar.extsi %intermediate : i8 to i32
  func.return %unsigned, %signed : i32, i32
}
// ----
test.target<low_core> @target

func.def target(@target) @constant_sign_boundaries() -> (i32, i32) {
  %unsigned = scalar.constant 255 : i32
  %signed = scalar.constant -1 : i32
  func.return %unsigned, %signed : i32, i32
}
