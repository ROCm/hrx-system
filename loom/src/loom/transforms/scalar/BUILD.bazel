load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_cc_library(
    name = "combine_patterns",
    srcs = ["combine_patterns.c"],
    hdrs = ["combine_patterns.h"],
    deps = [
        ":narrowing",
        "//loom/src/loom/ir",
        "//loom/src/loom/ir:facts",
        "//loom/src/loom/ops/scalar",
        "//loom/src/loom/rewrite:pattern_registry",
        "//loom/src/loom/rewrite:rewriter",
        "//loom/src/loom/transforms/conversion:chain",
        "//loom/src/loom/util:fact_table_api",
        "//loom/src/loom/util:predicate_facts",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "narrowing",
    srcs = ["narrowing.c"],
    hdrs = ["narrowing.h"],
    deps = [
        "//loom/src/loom/ir",
        "//loom/src/loom/ops/index",
        "//loom/src/loom/ops/scalar",
        "//loom/src/loom/rewrite:rewriter",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "cleanup_patterns",
    srcs = ["cleanup_patterns.c"],
    hdrs = ["cleanup_patterns.h"],
    deps = [
        "//loom/src/loom/analysis:condition_facts",
        "//loom/src/loom/analysis:symbolic_expr",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops/scalar",
        "//loom/src/loom/pass:value_facts",
        "//loom/src/loom/rewrite:pattern_registry",
        "//loom/src/loom/rewrite:rewriter",
        "//loom/src/loom/transforms/cleanup:patterns",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "division_refinement",
    srcs = ["division_refinement.c"],
    hdrs = ["division_refinement.h"],
    deps = [
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:headers",
        "//loom/src/loom/ops/scalar",
        "//loom/src/loom/util:predicate_facts",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "target_legalization",
    srcs = ["target_legalization.c"],
    hdrs = ["target_legalization.h"],
    deps = [
        ":combine_patterns",
        ":division_refinement",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops/scalar",
        "//loom/src/loom/ops/scf",
        "//loom/src/loom/rewrite:rewriter",
        "//loom/src/loom/target:legalization",
        "//loom/src/loom/util:numeric_format",
        "//runtime/src/iree/base",
        "//runtime/src/iree/math",
    ],
)

loom_cc_library(
    name = "wide_division_legalization",
    srcs = ["wide_division_legalization.c"],
    hdrs = ["wide_division_legalization.h"],
    deps = [
        ":division_refinement",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops/index",
        "//loom/src/loom/ops/scalar",
        "//loom/src/loom/ops/scf",
        "//loom/src/loom/rewrite:rewriter",
        "//loom/src/loom/target:legalization",
        "//loom/src/loom/util:fact_table",
        "//loom/src/loom/util:predicate_facts",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal",
    ],
)
