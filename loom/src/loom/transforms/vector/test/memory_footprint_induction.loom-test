// RUN: pass scf-to-cfg,vector-memory-footprint

func.def @nested_block_tail_cfg(%input: buffer) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %width = index.constant 6144 : index
  %block_size = index.constant 256 : index
  %tile = index.constant 16 : index
  %view = buffer.view %input[%origin] : buffer -> view<6144xf32>
  scf.for %block = [%begin to %width step %block_size] {
    %limit = index.add %block, %block_size : index
    %end = index.min %limit, %width : index
    scf.for %column = [%block to %end step %tile] {
