// ====
// RUN: pass sroa-vector-banks,canonicalize

// A freshly constructed next state is not an insert chain from the old state.
func.def @rank1_reconstructed_state(%a: i32, %b: i32, %end: index) -> (i32, i32) {
  %initial = vector.from_elements %a, %b : vector<2xi32>
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %result = scf.for %i = [%begin to %end step %step](%state = %initial : vector<2xi32>) -> (vector<2xi32>) {
    %x = vector.extract %state[0] : vector<2xi32> -> i32
    %y = vector.extract %state[1] : vector<2xi32> -> i32
    %sum = scalar.addi %x, %y : i32
    %next = vector.from_elements %y, %sum : vector<2xi32>
    scf.yield %next : vector<2xi32>
  }
  %x = vector.extract %result[0] : vector<2xi32> -> i32
  %y = vector.extract %result[1] : vector<2xi32> -> i32
  func.return %x, %y : i32, i32
}

// ----
func.def @rank1_reconstructed_state(%a: i32, %b: i32, %end: index) -> (i32, i32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %result_slot_0, %result_slot_1 = scf.for %i = [%begin to %end step %step](%state_slot_0 = %a : i32, %state_slot_1 = %b : i32) -> (i32, i32) {
    %sum = scalar.addi %state_slot_0, %state_slot_1 : i32
    scf.yield %state_slot_1, %sum : i32, i32
  }
  func.return %result_slot_0, %result_slot_1 : i32, i32
}

// ====
// RUN: pass sroa-vector-banks,canonicalize,cse

// A scalar-projected state may be reconstructed a row at a time. This is the
// natural source shape used by recurrent model kernels.
func.def @rank2_row_reconstructed_state(%initial: vector<2x2xf32>, %increment: f32, %end: index) -> (f32, f32, f32, f32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %empty = vector.constant 0.0 : vector<2x2xf32>
  %result = scf.for %i = [%begin to %end step %step](%state = %initial : vector<2x2xf32>) -> (vector<2x2xf32>) {
    %x00 = vector.extract %state[0, 0] : vector<2x2xf32> -> f32
    %x01 = vector.extract %state[0, 1] : vector<2x2xf32> -> f32
    %x10 = vector.extract %state[1, 0] : vector<2x2xf32> -> f32
    %x11 = vector.extract %state[1, 1] : vector<2x2xf32> -> f32
    %next00 = scalar.addf %x00, %increment : f32
    %next01 = scalar.addf %x01, %increment : f32
    %next10 = scalar.addf %x10, %increment : f32
    %next11 = scalar.addf %x11, %increment : f32
    %row0 = vector.from_elements %next00, %next01 : vector<2xf32>
    %row1 = vector.from_elements %next10, %next11 : vector<2xf32>
    %with_row0 = vector.insert %row0 into %empty[0] : vector<2xf32>, vector<2x2xf32>
    %next = vector.insert %row1 into %with_row0[1] : vector<2xf32>, vector<2x2xf32>
    scf.yield %next : vector<2x2xf32>
  }
  %x00 = vector.extract %result[0, 0] : vector<2x2xf32> -> f32
  %x01 = vector.extract %result[0, 1] : vector<2x2xf32> -> f32
  %x10 = vector.extract %result[1, 0] : vector<2x2xf32> -> f32
  %x11 = vector.extract %result[1, 1] : vector<2x2xf32> -> f32
  func.return %x00, %x01, %x10, %x11 : f32, f32, f32, f32
}

// ----
func.def @rank2_row_reconstructed_state(%initial: vector<2x2xf32>, %increment: f32, %end: index) -> (f32, f32, f32, f32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %initial_slot_0 = vector.extract %initial[0, 0] : vector<2x2xf32> -> f32
  %initial_slot_1 = vector.extract %initial[0, 1] : vector<2x2xf32> -> f32
  %initial_slot_2 = vector.extract %initial[1, 0] : vector<2x2xf32> -> f32
  %initial_slot_3 = vector.extract %initial[1, 1] : vector<2x2xf32> -> f32
  %result_slot_0, %result_slot_1, %result_slot_2, %result_slot_3 = scf.for %i = [%begin to %end step %step](%state_slot_0 = %initial_slot_0 : f32, %state_slot_1 = %initial_slot_1 : f32, %state_slot_2 = %initial_slot_2 : f32, %state_slot_3 = %initial_slot_3 : f32) -> (f32, f32, f32, f32) {
    %next00 = scalar.addf %state_slot_0, %increment : f32
    %next01 = scalar.addf %state_slot_1, %increment : f32
    %next10 = scalar.addf %state_slot_2, %increment : f32
    %next11 = scalar.addf %state_slot_3, %increment : f32
    scf.yield %next00, %next01, %next10, %next11 : f32, f32, f32, f32
  }
  func.return %result_slot_0, %result_slot_1, %result_slot_2, %result_slot_3 : f32, f32, f32, f32
}

// ====
// RUN: pass sroa-vector-banks

// Scalar observations do not force an aggregate used by vector arithmetic to
// split. Targets may retain the native vector representation.
func.def @rank1_native_vector_use(%initial: vector<4xf32>, %bias: vector<4xf32>, %end: index) -> (f32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %result = scf.for %i = [%begin to %end step %step](%state = %initial : vector<4xf32>) -> (vector<4xf32>) {
    %observed = vector.extract %state[0] : vector<4xf32> -> f32
    test.use %observed : f32
    %next = vector.addf %state, %bias : vector<4xf32>
    scf.yield %next : vector<4xf32>
  }
  %value = vector.extract %result[0] : vector<4xf32> -> f32
  func.return %value : f32
}

// ====
// RUN: pass sroa-vector-banks,canonicalize

// Replacing a higher-rank bank preserves each trailing vector payload.
func.def @rank2_replaced_state(%initial: vector<2x2xi32>, %replacement: vector<2x2xi32>, %end: index) -> (vector<2xi32>, vector<2xi32>) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %result = scf.for %i = [%begin to %end step %step](%state = %initial : vector<2x2xi32>) -> (vector<2x2xi32>) {
    %observed = vector.extract %state[0] : vector<2x2xi32> -> vector<2xi32>
    test.use %observed : vector<2xi32>
    scf.yield %replacement : vector<2x2xi32>
  }
  %x = vector.extract %result[0] : vector<2x2xi32> -> vector<2xi32>
  %y = vector.extract %result[1] : vector<2x2xi32> -> vector<2xi32>
  func.return %x, %y : vector<2xi32>, vector<2xi32>
}

// ----
func.def @rank2_replaced_state(%initial: vector<2x2xi32>, %replacement: vector<2x2xi32>, %end: index) -> (vector<2xi32>, vector<2xi32>) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %initial_slot_0 = vector.extract %initial[0] : vector<2x2xi32> -> vector<2xi32>
  %initial_slot_1 = vector.extract %initial[1] : vector<2x2xi32> -> vector<2xi32>
  %result_slot_0, %result_slot_1 = scf.for %i = [%begin to %end step %step](%state_slot_0 = %initial_slot_0 : vector<2xi32>, %state_slot_1 = %initial_slot_1 : vector<2xi32>) -> (vector<2xi32>, vector<2xi32>) {
    test.use %state_slot_0 : vector<2xi32>
    %20 = vector.extract %replacement[0] : vector<2x2xi32> -> vector<2xi32>
    %21 = vector.extract %replacement[1] : vector<2x2xi32> -> vector<2xi32>
    scf.yield %20, %21 : vector<2xi32>, vector<2xi32>
  }
  func.return %result_slot_0, %result_slot_1 : vector<2xi32>, vector<2xi32>
}

// ====
// RUN: with-checks pass sroa-vector-banks

// Expanding one aggregate column preserves result-local relationships between
// retained columns.
func.def @bank_sroa_with_dependent_view(%storage: buffer, %base: offset, %initial_rows: index, %layout: encoding<layout>, %initial: vector<1x2x4xf32>, %increment: vector<4xf32>) {
  %loop_begin = index.constant 0 : index
  %loop_end = index.constant 4 : index
  %loop_step = index.constant 1 : index
  %initial_view = buffer.view %storage[%base] : buffer -> view<[%initial_rows]x4xi32, %layout>
  %rows, %view, %result = scf.for %i = [%loop_begin to %loop_end step %loop_step](%body_rows = %initial_rows : index, %body_view = %initial_view : view<[%initial_rows]x4xi32, %layout>, %bank = %initial : vector<1x2x4xf32>) -> (index, view<[%rows]x4xi32, %layout>, vector<1x2x4xf32>) {
    test.use %body_view : view<[%body_rows]x4xi32, %layout>
    %old = vector.extract %bank[0, 1] : vector<1x2x4xf32> -> vector<4xf32>
    %next = vector.addf %old, %increment : vector<4xf32>
    %updated = vector.insert %next into %bank[0, 1] : vector<4xf32>, vector<1x2x4xf32>
    %next_rows = index.sub %body_rows, %loop_step : index
    %next_view = view.subview %body_view[1, 0] : view<[%body_rows]x4xi32, %layout> -> view<[%next_rows]x4xi32, %layout>
    scf.yield %next_rows, %next_view, %updated : index, view<[%next_rows]x4xi32, %layout>, vector<1x2x4xf32>
  }
  %selected = vector.extract %result[0, 1] : vector<1x2x4xf32> -> vector<4xf32>
  test.use %view, %selected : view<[%rows]x4xi32, %layout>, vector<4xf32>
  func.return
}

// ----
CHECK: * = vector.extract %initial[0, 0] : vector<1x2x4xf32> -> vector<4xf32>
CHECK: * = vector.extract %initial[0, 1] : vector<1x2x4xf32> -> vector<4xf32>
CHECK: %rows, %view, *, * = scf.for *(%* = %initial_rows : index, %* = %initial_view : view<[%initial_rows]x4xi32, %layout>, *: vector<4xf32>, *: vector<4xf32>) -> (index, view<[%rows]x4xi32, %layout>, vector<4xf32>, vector<4xf32>) {
CHECK: test.use * : view<[*]x4xi32, %layout>
CHECK: scf.yield %next_rows, %next_view, *, %next : index, view<[%next_rows]x4xi32, %layout>, vector<4xf32>, vector<4xf32>
CHECK: test.use %view, * : view<[%rows]x4xi32, %layout>, vector<4xf32>

// ====
// RUN: pass sroa-vector-banks

// Condition-controlled loops project the before, after, and result endpoints
// through one shared bank schema. Inserts in either region forward unchanged
// slots directly and replace only the addressed payload.
func.def @condition_bank(%initial: vector<2xi32>, %keep_going: i1) -> (i32, i32) {
  %result = scf.while(%before_bank = %initial : vector<2xi32>) -> (vector<2xi32>) {
    %head = vector.extract %before_bank[0] : vector<2xi32> -> i32
    test.use %head : i32
    %condition_bank = vector.insert %head into %before_bank[1] : i32, vector<2xi32>
    scf.condition %keep_going, %condition_bank : i1, vector<2xi32>
  } do(%body_bank: vector<2xi32>) {
    %left = vector.extract %body_bank[0] : vector<2xi32> -> i32
    %right = vector.extract %body_bank[1] : vector<2xi32> -> i32
    %sum = scalar.addi %left, %right : i32
    %next_bank = vector.insert %sum into %body_bank[0] : i32, vector<2xi32>
    scf.yield %next_bank : vector<2xi32>
  }
  %first = vector.extract %result[0] : vector<2xi32> -> i32
  %second = vector.extract %result[1] : vector<2xi32> -> i32
  func.return %first, %second : i32, i32
}

// ----
func.def @condition_bank(%initial: vector<2xi32>, %keep_going: i1) -> (i32, i32) {
  %initial_slot_0 = vector.extract %initial[0] : vector<2xi32> -> i32
  %initial_slot_1 = vector.extract %initial[1] : vector<2xi32> -> i32
  %result_slot_0, %result_slot_1 = scf.while(%before_bank_slot_0 = %initial_slot_0 : i32, %before_bank_slot_1 = %initial_slot_1 : i32) -> (i32, i32) {
    test.use %before_bank_slot_0 : i32
    scf.condition %keep_going, %before_bank_slot_0, %before_bank_slot_0 : i1, i32, i32
  } do(%body_bank_slot_0: i32, %body_bank_slot_1: i32) {
    %sum = scalar.addi %body_bank_slot_0, %body_bank_slot_1 : i32
    scf.yield %sum, %body_bank_slot_1 : i32, i32
  }
  func.return %result_slot_0, %result_slot_1 : i32, i32
}

// ====
// RUN: with-checks pass-report sroa-vector-banks

// The report retains the established SROA accounting while the shared boundary
// engine owns loop discovery and reconstruction.
func.def @reports_condition_bank(%initial: vector<2xi32>, %keep_going: i1) -> (i32) {
  %result = scf.while(%before_bank = %initial : vector<2xi32>) -> (vector<2xi32>) {
    %head = vector.extract %before_bank[0] : vector<2xi32> -> i32
    %condition_bank = vector.insert %head into %before_bank[1] : i32, vector<2xi32>
    scf.condition %keep_going, %condition_bank : i1, vector<2xi32>
  } do(%body_bank: vector<2xi32>) {
    %tail = vector.extract %body_bank[1] : vector<2xi32> -> i32
    %next_bank = vector.insert %tail into %body_bank[0] : i32, vector<2xi32>
    scf.yield %next_bank : vector<2xi32>
  }
  %first = vector.extract %result[0] : vector<2xi32> -> i32
  func.return %first : i32
}

// ----
CHECK: *"changed":true,*
CHECK: *"statistics":{"loops-checked":1,"loops-scalarized":1,"banks-scalarized":1,"slots-materialized":2,"extracts-eliminated":3,"inserts-eliminated":2}*

// ====
// RUN: pass sroa-vector-banks

// A dynamic condition-region access rejects the complete recurrence column;
// no endpoint is projected in isolation.
func.def @dynamic_condition_access_is_unchanged(%initial: vector<2xi32>, %index: index, %keep_going: i1) -> (i32) {
  %result = scf.while(%before_bank = %initial : vector<2xi32>) -> (vector<2xi32>) {
    %selected = vector.extract %before_bank[%index] : vector<2xi32> -> i32
    test.use %selected : i32
    scf.condition %keep_going, %before_bank : i1, vector<2xi32>
  } do(%body_bank: vector<2xi32>) {
    %tail = vector.extract %body_bank[1] : vector<2xi32> -> i32
    %next_bank = vector.insert %tail into %body_bank[0] : i32, vector<2xi32>
    scf.yield %next_bank : vector<2xi32>
  }
  %first = vector.extract %result[0] : vector<2xi32> -> i32
  func.return %first : i32
}

// ====
// RUN: pass sroa-vector-banks

// A storage tie on the logical bank expands to one tie for each physical
// component instead of disabling scalar replacement.
func.def @tied_bank(%initial: vector<2xi32>, %increment: i32, %end: index) -> (i32, i32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %result = scf.for %i = [%begin to %end step %step](%bank = %initial : vector<2xi32>) -> (%initial as vector<2xi32>) {
    %old = vector.extract %bank[1] : vector<2xi32> -> i32
    %next = scalar.addi %old, %increment : i32
    %updated = vector.insert %next into %bank[1] : i32, vector<2xi32>
    scf.yield %updated : vector<2xi32>
  }
  %first = vector.extract %result[0] : vector<2xi32> -> i32
  %second = vector.extract %result[1] : vector<2xi32> -> i32
  func.return %first, %second : i32, i32
}

// ----
func.def @tied_bank(%initial: vector<2xi32>, %increment: i32, %end: index) -> (i32, i32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %initial_slot_0 = vector.extract %initial[0] : vector<2xi32> -> i32
  %initial_slot_1 = vector.extract %initial[1] : vector<2xi32> -> i32
  %result_slot_0, %result_slot_1 = scf.for %i = [%begin to %end step %step](%bank_slot_0 = %initial_slot_0 : i32, %bank_slot_1 = %initial_slot_1 : i32) -> (%initial_slot_0 as i32, %initial_slot_1 as i32) {
    %next = scalar.addi %bank_slot_1, %increment : i32
    scf.yield %bank_slot_0, %next : i32, i32
  }
  func.return %result_slot_0, %result_slot_1 : i32, i32
}
