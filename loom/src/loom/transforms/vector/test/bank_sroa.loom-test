func.def @nested_region_bank_escape_is_unchanged(%initial: vector<2x2x4xf32>, %condition: i1) {
  %loop_begin = index.constant 0 : index
  %loop_end = index.constant 1 : index
  %loop_step = index.constant 1 : index
  %result = scf.for %i = [%loop_begin to %loop_end step %loop_step](%bank = %initial : vector<2x2x4xf32>) -> (vector<2x2x4xf32>) {
    %top_level = vector.extract %bank[0, 0] : vector<2x2x4xf32> -> vector<4xf32>
    scf.if %condition {
      %nested = vector.extract %bank[0, 1] : vector<2x2x4xf32> -> vector<4xf32>
      test.use %nested : vector<4xf32>
    }
    %updated = vector.insert %top_level into %bank[0, 0] : vector<4xf32>, vector<2x2x4xf32>
    scf.yield %updated : vector<2x2x4xf32>
  }
  %use = vector.extract %result[0, 0] : vector<2x2x4xf32> -> vector<4xf32>
  test.use %use : vector<4xf32>
  func.return
}

