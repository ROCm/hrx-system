// RUN: pass sroa-vector-banks

func.def @rank3_vector_payload_bank(%initial: vector<2x2x4xf32>, %increment: vector<4xf32>) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) {
  %loop_begin = index.constant 0 : index
  %loop_step = index.constant 1 : index
  %loop_end = index.constant 4 : index
  %result = scf.for %i = [%loop_begin to %loop_end step %loop_step](%bank = %initial : vector<2x2x4xf32>) -> (vector<2x2x4xf32>) {
    %old00 = vector.extract %bank[0, 0] : vector<2x2x4xf32> -> vector<4xf32>
    %next00 = vector.addf %old00, %increment : vector<4xf32>
    %bank0 = vector.insert %next00 into %bank[0, 0] : vector<4xf32>, vector<2x2x4xf32>
    %old11 = vector.extract %bank0[1, 1] : vector<2x2x4xf32> -> vector<4xf32>
    %next11 = vector.addf %old11, %increment : vector<4xf32>
    %bank1 = vector.insert %next11 into %bank0[1, 1] : vector<4xf32>, vector<2x2x4xf32>
    scf.yield %bank1 : vector<2x2x4xf32>
  }
  %result00 = vector.extract %result[0, 0] : vector<2x2x4xf32> -> vector<4xf32>
  %result01 = vector.extract %result[0, 1] : vector<2x2x4xf32> -> vector<4xf32>
  %result10 = vector.extract %result[1, 0] : vector<2x2x4xf32> -> vector<4xf32>
  %result11 = vector.extract %result[1, 1] : vector<2x2x4xf32> -> vector<4xf32>
  func.return %result00, %result01, %result10, %result11 : vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>
}

