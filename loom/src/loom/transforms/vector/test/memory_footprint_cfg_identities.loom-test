// RUN: pass vector-memory-footprint

// A dominating guarded value may feed several block arguments without losing the guard relation.
func.def @duplicated_dominating_sources_preserve_guard(%storage: buffer, %raw: index, %bound_raw: index) {
  %base = index.constant 0 : offset
  %c4 = index.constant 4 : index
  %origin = index.assume %raw [range(%raw, 0, 63)] : index
  %bound = index.assume %bound_raw [range(%bound_raw, 1, 64)] : index
  %fits = index.cmp slt, %origin, %bound : index
  cfg.cond_br %fits, ^forward, ^exit
^forward:
  cfg.br ^access(%origin: index, %origin: index, %bound: index, %bound: index)
^access(%origin0: index, %origin1: index, %bound0: index, %bound1: index):
  %byte_origin = index.mul %origin1, %c4 : index
  %byte_bound = index.mul %bound1, %c4 : index
  %view = buffer.view %storage[%base] : buffer -> view<[%byte_bound]xi8>
  %loaded = vector.load %view[%byte_origin] : view<[%byte_bound]xi8> -> vector<4xi8>
  test.use %loaded : vector<4xi8>
  cfg.br ^exit
^exit:
  func.return
}

