// RUN: pass vector-to-scalar,dce

func.def @ranked_transport(%values: vector<2x2xi8>) -> (vector<2x2xi8>) {
  %wide = vector.extsi %values : vector<2x2xi8> to vector<2x2xi64>
  %result = vector.trunci %wide : vector<2x2xi64> to vector<2x2xi8>
  func.return %result : vector<2x2xi8>
}

// ----
func.def @ranked_transport(%values: vector<2x2xi8>) -> (vector<2x2xi8>) {
  %4 = vector.extract %values[0, 0] : vector<2x2xi8> -> i8
  %6 = vector.extract %values[0, 1] : vector<2x2xi8> -> i8
  %8 = vector.extract %values[1, 0] : vector<2x2xi8> -> i8
  %10 = vector.extract %values[1, 1] : vector<2x2xi8> -> i8
  %result = vector.from_elements %4, %6, %8, %10 : vector<2x2xi8>
  func.return %result : vector<2x2xi8>
}

// ====
// RUN: pass vector-to-scalar,dce

func.def @dynamic_transport(%count: index, %values: vector<[%count]xi1>) -> (vector<[%count]xi1>) {
  %wide = vector.extsi %values : vector<[%count]xi1> to vector<[%count]xi8>
  %result = vector.trunci %wide : vector<[%count]xi8> to vector<[%count]xi1>
  func.return %result : vector<[%count]xi1>
}

// ----
func.def @dynamic_transport(%count: index, %values: vector<[%count]xi1>) -> (vector<[%count]xi1>) {
  %5 = vector.splati 0 : vector<[%count]xi1>
  %6 = index.constant 0 : index
  %7 = index.constant 1 : index
  %result = scf.for %8 = [%6 to %count step %7](%9 = %5 : vector<[%count]xi1>) -> (vector<[%count]xi1>) {
    %11 = vector.extract %values[%8] : vector<[%count]xi1> -> i1
    %13 = vector.insert %11 into %9[%8] : i1, vector<[%count]xi1>
    scf.yield %13 : vector<[%count]xi1>
  }
  func.return %result : vector<[%count]xi1>
}

// ====
// RUN: pass vector-memory-to-scalar,dce

// Masked reads consume the original predicate lanes without routing their
// conditions through a redundant sign-extension/truncation pair.
func.def @masked_transport(%input: view<4xi32>, %first: vector<2xi1>, %second: vector<2xi1>) -> (vector<4xi32>) {
  %first_bytes = vector.extsi %first : vector<2xi1> to vector<2xi8>
  %second_bytes = vector.extsi %second : vector<2xi1> to vector<2xi8>
  %joined = vector.concat<0> %first_bytes, %second_bytes : vector<2xi8>, vector<2xi8> -> vector<4xi8>
  %mask = vector.trunci %joined : vector<4xi8> to vector<4xi1>
  %passthrough = vector.splati 0 : vector<4xi32>
  %result = vector.load.mask %input[0], %mask, %passthrough : view<4xi32>, vector<4xi1>, vector<4xi32>
  func.return %result : vector<4xi32>
}

// ----
func.def @masked_transport(%input: view<4xi32>, %first: vector<2xi1>, %second: vector<2xi1>) -> (vector<4xi32>) {
  %10 = vector.extract %first[0] : vector<2xi1> -> i1
  %12 = scf.if %10 -> (i32) {
    %13 = view.load %input[0] : view<4xi32> -> i32
    scf.yield %13 : i32
  } else {
    %14 = scalar.constant 0 : i32
    scf.yield %14 : i32
  }
  %15 = vector.extract %first[1] : vector<2xi1> -> i1
  %17 = scf.if %15 -> (i32) {
    %18 = view.load %input[1] : view<4xi32> -> i32
    scf.yield %18 : i32
  } else {
    %19 = scalar.constant 0 : i32
    scf.yield %19 : i32
  }
  %20 = vector.extract %second[0] : vector<2xi1> -> i1
  %22 = scf.if %20 -> (i32) {
    %23 = view.load %input[2] : view<4xi32> -> i32
    scf.yield %23 : i32
  } else {
    %24 = scalar.constant 0 : i32
    scf.yield %24 : i32
  }
  %25 = vector.extract %second[1] : vector<2xi1> -> i1
  %27 = scf.if %25 -> (i32) {
    %28 = view.load %input[3] : view<4xi32> -> i32
    scf.yield %28 : i32
  } else {
    %29 = scalar.constant 0 : i32
    scf.yield %29 : i32
  }
  %result = vector.from_elements %12, %17, %22, %27 : vector<4xi32>
  func.return %result : vector<4xi32>
}
