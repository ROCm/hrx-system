  %11 = scalar.extui %10 : i16 to i64
  %12 = scalar.constant 63 : i64
  %13 = scalar.shli %11, %12 : i64
  %14 = scalar.constant 63 : i64
  %15 = scalar.shrui %13, %14 : i64
  %16 = vector.extract %source[1] : vector<4xi16> -> i16
  %17 = scalar.extui %16 : i16 to i64
  %18 = scalar.constant 63 : i64
  %19 = scalar.shli %17, %18 : i64
  %20 = scalar.constant 63 : i64
  %21 = scalar.shrui %19, %20 : i64
  %22 = vector.extract %source[2] : vector<4xi16> -> i16
