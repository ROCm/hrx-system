test.target<low_core> @target

func.def target(@target) @extract_unsigned_wider_result(%source: vector<4xi16>) -> (vector<4xi64>) {
  %8 = vector.extract %source[0] : vector<4xi16> -> i16
  %37 = scalar.extui %8 : i16 to i32
  %44 = scalar.constant 1 : i32
  %39 = scalar.andi %37, %44 : i32
  %40 = scalar.trunci %39 : i32 to i16
  %11 = vector.extract %source[1] : vector<4xi16> -> i16
  %33 = scalar.extui %11 : i16 to i32
  %43 = scalar.constant 1 : i32
  %35 = scalar.andi %33, %43 : i32
  %36 = scalar.trunci %35 : i32 to i16
  %14 = vector.extract %source[2] : vector<4xi16> -> i16
  %29 = scalar.extui %14 : i16 to i32
  %42 = scalar.constant 1 : i32
  %31 = scalar.andi %29, %42 : i32
  %32 = scalar.trunci %31 : i32 to i16
  %17 = vector.extract %source[3] : vector<4xi16> -> i16
  %25 = scalar.extui %17 : i16 to i32
  %41 = scalar.constant 1 : i32
  %27 = scalar.andi %25, %41 : i32
  %28 = scalar.trunci %27 : i32 to i16
  %21 = vector.splat %40 : vector<4xi16>
  %22 = vector.insert %36 into %21[1] : i16, vector<4xi16>
  %23 = vector.insert %32 into %22[2] : i16, vector<4xi16>
  %24 = vector.insert %28 into %23[3] : i16, vector<4xi16>
  %result = vector.extui %24 : vector<4xi16> to vector<4xi64>
  func.return %result : vector<4xi64>
}

