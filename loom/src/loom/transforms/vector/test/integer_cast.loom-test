  %result = vector.empty : vector<0xi64>
  func.return %result : vector<0xi64>
}

// ====
// RUN: pass vector-to-scalar,dce

// Scalar lane construction consumes the cast proof before canonicalization.
func.def @boolean_transport(%first: vector<2xi1>, %second: vector<2xi1>) -> (vector<4xi1>) {
  %first_bytes = vector.extsi %first : vector<2xi1> to vector<2xi8>
  %second_bytes = vector.extsi %second : vector<2xi1> to vector<2xi8>
  %joined = vector.concat<0> %first_bytes, %second_bytes : vector<2xi8>, vector<2xi8> -> vector<4xi8>
  %result = vector.trunci %joined : vector<4xi8> to vector<4xi1>
  func.return %result : vector<4xi1>
}

// ----
func.def @boolean_transport(%first: vector<2xi1>, %second: vector<2xi1>) -> (vector<4xi1>) {
  %7 = vector.extract %first[0] : vector<2xi1> -> i1
  %9 = vector.extract %first[1] : vector<2xi1> -> i1
  %11 = vector.extract %second[0] : vector<2xi1> -> i1
  %13 = vector.extract %second[1] : vector<2xi1> -> i1
  %result = vector.from_elements %7, %9, %11, %13 : vector<4xi1>
  func.return %result : vector<4xi1>
}

// ====
// RUN: pass vector-to-scalar,dce

// The wide value remains available to its independent consumer.
func.def @signed_byte_transport(%values: vector<2xi8>) -> (vector<2xi64>, vector<2xi8>) {
  %words = vector.extsi %values : vector<2xi8> to vector<2xi32>
  %wide = vector.extsi %words : vector<2xi32> to vector<2xi64>
  %result = vector.trunci %wide : vector<2xi64> to vector<2xi8>
  func.return %wide, %result : vector<2xi64>, vector<2xi8>
}

// ----
func.def @signed_byte_transport(%values: vector<2xi8>) -> (vector<2xi64>, vector<2xi8>) {
  %13 = vector.extract %values[0] : vector<2xi8> -> i8
  %14 = scalar.extsi %13 : i8 to i32
  %15 = scalar.extsi %14 : i32 to i64
  %16 = vector.extract %values[1] : vector<2xi8> -> i8
  %17 = scalar.extsi %16 : i8 to i32
  %18 = scalar.extsi %17 : i32 to i64
  %wide = vector.from_elements %15, %18 : vector<2xi64>
  %6 = vector.extract %values[0] : vector<2xi8> -> i8
  %9 = vector.extract %values[1] : vector<2xi8> -> i8
  %result = vector.from_elements %6, %9 : vector<2xi8>
  func.return %wide, %result : vector<2xi64>, vector<2xi8>
}

