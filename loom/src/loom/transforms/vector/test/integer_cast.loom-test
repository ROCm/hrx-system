// RUN: pass combine,target-legalize{mode=eager,policy=reference-only},dce,canonicalize

test.target<low_core> @target

func.def target(@target) @extract_unsigned_same_width(%count: index, %source: vector<[%count]xi32>) -> (vector<[%count]xi32>) {
  %intermediate = vector.trunci %source : vector<[%count]xi32> to vector<[%count]xi1>
  %result = vector.extui %intermediate : vector<[%count]xi1> to vector<[%count]xi32>
  func.return %result : vector<[%count]xi32>
}
// ----
test.target<low_core> @target

func.def target(@target) @extract_unsigned_same_width(%count: index, %source: vector<[%count]xi32>) -> (vector<[%count]xi32>) {
  %21 = index.constant 0 : index
  %22 = index.constant 1 : index
  %25 = scf.for %23 = [%21 to %count step %22](%24 = %source : vector<[%count]xi32>) -> (vector<[%count]xi32>) {
    %26 = vector.extract %source[%23] : vector<[%count]xi32> -> i32
    %27 = scalar.constant 31 : i32
    %28 = scalar.shli %26, %27 : i32
    %29 = vector.insert %28 into %24[%23] : i32, vector<[%count]xi32>
    scf.yield %29 : vector<[%count]xi32>
  }
  %10 = index.constant 0 : index
  %11 = index.constant 1 : index
  %result = scf.for %12 = [%10 to %count step %11](%13 = %25 : vector<[%count]xi32>) -> (vector<[%count]xi32>) {
    %15 = vector.extract %source[%12] : vector<[%count]xi32> -> i32
    %16 = scalar.constant 31 : i32
    %17 = scalar.shli %15, %16 : i32
    %18 = scalar.constant 31 : i32
    %19 = scalar.shrui %17, %18 : i32
    %20 = vector.insert %19 into %13[%12] : i32, vector<[%count]xi32>
    scf.yield %20 : vector<[%count]xi32>
  }
  func.return %result : vector<[%count]xi32>
}

