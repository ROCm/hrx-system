// RUN: pass combine,target-legalize{mode=eager,policy=reference-only},dce,canonicalize

test.target<low_core> @target

func.def target(@target) @extract_unsigned_same_width(%count: index, %source: vector<[%count]xi32>) -> (vector<[%count]xi32>) {
  %intermediate = vector.trunci %source : vector<[%count]xi32> to vector<[%count]xi1>
  %result = vector.extui %intermediate : vector<[%count]xi1> to vector<[%count]xi32>
  func.return %result : vector<[%count]xi32>
}
// ----
test.target<low_core> @target

func.def target(@target) @extract_unsigned_same_width(%count: index, %source: vector<[%count]xi32>) -> (vector<[%count]xi32>) {
  %8 = index.constant 0 : index
  %9 = index.constant 1 : index
  %result = scf.for %10 = [%8 to %count step %9](%11 = %source : vector<[%count]xi32>) -> (vector<[%count]xi32>) {
    %13 = vector.extract %source[%10] : vector<[%count]xi32> -> i32
    %14 = scalar.constant 1 : i32
    %15 = scalar.andi %13, %14 : i32
    %16 = vector.insert %15 into %11[%10] : i32, vector<[%count]xi32>
    scf.yield %16 : vector<[%count]xi32>
  }
  func.return %result : vector<[%count]xi32>
}

