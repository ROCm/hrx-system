  %24 = scalar.constant 63 : i64
  %25 = scalar.shli %23, %24 : i64
  %26 = scalar.constant 63 : i64
  %27 = scalar.shrui %25, %26 : i64
  %28 = vector.extract %source[3] : vector<4xi16> -> i16
  %29 = scalar.extui %28 : i16 to i64
  %30 = scalar.constant 63 : i64
  %31 = scalar.shli %29, %30 : i64
  %32 = scalar.constant 63 : i64
  %33 = scalar.shrui %31, %32 : i64
  %35 = vector.splat %15 : vector<4xi64>
  %36 = vector.insert %21 into %35[1] : i64, vector<4xi64>
  %37 = vector.insert %27 into %36[2] : i64, vector<4xi64>
  %result = vector.insert %33 into %37[3] : i64, vector<4xi64>
  func.return %result : vector<4xi64>
}

