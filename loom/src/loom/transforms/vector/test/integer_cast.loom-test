  %wide = vector.extui %words : vector<2xi32> to vector<2xi64>
  %result = vector.trunci %wide : vector<2xi64> to vector<2xi16>
  func.return %result : vector<2xi16>
}

// ----
func.def @unsigned_word_transport(%values: vector<2xi16>) -> (vector<2xi16>) {
  %5 = vector.extract %values[0] : vector<2xi16> -> i16
  %8 = vector.extract %values[1] : vector<2xi16> -> i16
  %result = vector.from_elements %5, %8 : vector<2xi16>
  func.return %result : vector<2xi16>
}

// ====
// RUN: pass vector-to-scalar,dce

func.def @long_transport(%values: vector<2xi32>) -> (vector<2xi32>, vector<2xi32>) {
  %signed = vector.extsi %values : vector<2xi32> to vector<2xi64>
  %unsigned = vector.extui %values : vector<2xi32> to vector<2xi64>
  %first = vector.trunci %signed : vector<2xi64> to vector<2xi32>
  %second = vector.trunci %unsigned : vector<2xi64> to vector<2xi32>
  func.return %first, %second : vector<2xi32>, vector<2xi32>
}

// ----
func.def @long_transport(%values: vector<2xi32>) -> (vector<2xi32>, vector<2xi32>) {
  %12 = vector.extract %values[0] : vector<2xi32> -> i32
  %14 = vector.extract %values[1] : vector<2xi32> -> i32
  %first = vector.from_elements %12, %14 : vector<2xi32>
  %7 = vector.extract %values[0] : vector<2xi32> -> i32
  %9 = vector.extract %values[1] : vector<2xi32> -> i32
  %second = vector.from_elements %7, %9 : vector<2xi32>
  func.return %first, %second : vector<2xi32>, vector<2xi32>
}

// ====
// RUN: pass vector-to-scalar,dce

// Bits discarded before extension cannot be recovered from the payload root.
func.def @lossy_transport(%values: vector<2xi16>) -> (vector<2xi16>) {
  %bytes = vector.trunci %values : vector<2xi16> to vector<2xi8>
  %wide = vector.extui %bytes : vector<2xi8> to vector<2xi32>
  %result = vector.trunci %wide : vector<2xi32> to vector<2xi16>
  func.return %result : vector<2xi16>
}

// ----
func.def @lossy_transport(%values: vector<2xi16>) -> (vector<2xi16>) {
  %5 = vector.extract %values[0] : vector<2xi16> -> i16
  %6 = scalar.trunci %5 : i16 to i8
  %7 = scalar.extui %6 : i8 to i32
  %8 = scalar.trunci %7 : i32 to i16
  %9 = vector.extract %values[1] : vector<2xi16> -> i16
  %10 = scalar.trunci %9 : i16 to i8
  %11 = scalar.extui %10 : i8 to i32
  %12 = scalar.trunci %11 : i32 to i16
  %result = vector.from_elements %8, %12 : vector<2xi16>
  func.return %result : vector<2xi16>
}

