// RUN: pass combine,target-legalize{mode=eager},dce,canonicalize

test.target<low_core> @target

func.def target(@target) @extract_unsigned_same_width(%count: index, %source: vector<[%count]xi32>) -> (vector<[%count]xi32>) {
  %intermediate = vector.trunci %source : vector<[%count]xi32> to vector<[%count]xi1>
  %result = vector.extui %intermediate : vector<[%count]xi1> to vector<[%count]xi32>
  func.return %result : vector<[%count]xi32>
}
// ----
test.target<low_core> @target

func.def target(@target) @extract_unsigned_same_width(%count: index, %source: vector<[%count]xi32>) -> (vector<[%count]xi32>) {
  %6 = vector.splati 31 : vector<[%count]xi32>
  %7 = vector.shli %source, %6 : vector<[%count]xi32>
  %8 = vector.splati 31 : vector<[%count]xi32>
  %result = vector.shrui %7, %8 : vector<[%count]xi32>
  func.return %result : vector<[%count]xi32>
}

