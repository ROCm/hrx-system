test.target<low_core> @target

func.def target(@target) @extract_signed_narrower_result(%count: index, %source: vector<[%count]xi32>) -> (vector<[%count]xi16>) {
  %22 = index.constant 0 : index
  %23 = index.constant 1 : index
  %26 = scf.for %24 = [%22 to %count step %23](%25 = %source : vector<[%count]xi32>) -> (vector<[%count]xi32>) {
    %27 = vector.extract %source[%24] : vector<[%count]xi32> -> i32
    %28 = scalar.constant 24 : i32
    %29 = scalar.shli %27, %28 : i32
    %30 = vector.insert %29 into %25[%24] : i32, vector<[%count]xi32>
    scf.yield %30 : vector<[%count]xi32>
  }
  %11 = index.constant 0 : index
  %12 = index.constant 1 : index
  %15 = scf.for %13 = [%11 to %count step %12](%14 = %26 : vector<[%count]xi32>) -> (vector<[%count]xi32>) {
    %16 = vector.extract %source[%13] : vector<[%count]xi32> -> i32
    %17 = scalar.constant 24 : i32
    %18 = scalar.shli %16, %17 : i32
    %19 = scalar.constant 24 : i32
    %20 = scalar.shrsi %18, %19 : i32
    %21 = vector.insert %20 into %14[%13] : i32, vector<[%count]xi32>
    scf.yield %21 : vector<[%count]xi32>
  }
  %result = vector.trunci %15 : vector<[%count]xi32> to vector<[%count]xi16>
  func.return %result : vector<[%count]xi16>
}

