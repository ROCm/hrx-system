func.def target(@target) @extract_signed_wider_result(%source: vector<2x3xi16>) -> (vector<2x3xi32>) {
  %10 = vector.extract %source[0, 0] : vector<2x3xi16> -> i16
  %110 = scalar.extsi %10 : i16 to i32
  %141 = scalar.constant 24 : i32
  %142 = scalar.shli %110, %141 : i32
  %139 = scalar.constant 24 : i32
  %140 = scalar.shrsi %142, %139 : i32
  %109 = scalar.trunci %140 : i32 to i16
  %15 = vector.extract %source[0, 1] : vector<2x3xi16> -> i16
  %97 = scalar.extsi %15 : i16 to i32
  %137 = scalar.constant 24 : i32
  %138 = scalar.shli %97, %137 : i32
  %135 = scalar.constant 24 : i32
  %136 = scalar.shrsi %138, %135 : i32
  %96 = scalar.trunci %136 : i32 to i16
  %20 = vector.extract %source[0, 2] : vector<2x3xi16> -> i16
  %84 = scalar.extsi %20 : i16 to i32
  %133 = scalar.constant 24 : i32
  %134 = scalar.shli %84, %133 : i32
  %131 = scalar.constant 24 : i32
  %132 = scalar.shrsi %134, %131 : i32
  %83 = scalar.trunci %132 : i32 to i16
  %25 = vector.extract %source[1, 0] : vector<2x3xi16> -> i16
  %71 = scalar.extsi %25 : i16 to i32
  %129 = scalar.constant 24 : i32
  %130 = scalar.shli %71, %129 : i32
  %127 = scalar.constant 24 : i32
  %128 = scalar.shrsi %130, %127 : i32
  %70 = scalar.trunci %128 : i32 to i16
  %30 = vector.extract %source[1, 1] : vector<2x3xi16> -> i16
  %58 = scalar.extsi %30 : i16 to i32
  %125 = scalar.constant 24 : i32
  %126 = scalar.shli %58, %125 : i32
  %123 = scalar.constant 24 : i32
  %124 = scalar.shrsi %126, %123 : i32
  %57 = scalar.trunci %124 : i32 to i16
  %35 = vector.extract %source[1, 2] : vector<2x3xi16> -> i16
  %45 = scalar.extsi %35 : i16 to i32
  %121 = scalar.constant 24 : i32
  %122 = scalar.shli %45, %121 : i32
  %119 = scalar.constant 24 : i32
  %120 = scalar.shrsi %122, %119 : i32
  %44 = scalar.trunci %120 : i32 to i16
  %40 = vector.from_elements %109, %96, %83, %70, %57, %44 : vector<2x3xi16>
  %result = vector.extsi %40 : vector<2x3xi16> to vector<2x3xi32>
  func.return %result : vector<2x3xi32>
}

// ====

// The inner cast remains alive for its independent consumer.
test.target<low_core> @target

func.def target(@target) @retained_truncation(%count: index, %source: vector<2x[%count]xi32>) -> (vector<2x[%count]xi8>, vector<2x[%count]xi64>) {
  %intermediate = vector.trunci %source : vector<2x[%count]xi32> to vector<2x[%count]xi8>
  %result = vector.extsi %intermediate : vector<2x[%count]xi8> to vector<2x[%count]xi64>
  func.return %intermediate, %result : vector<2x[%count]xi8>, vector<2x[%count]xi64>
}
// ----
test.target<low_core> @target

func.def target(@target) @retained_truncation(%count: index, %source: vector<2x[%count]xi32>) -> (vector<2x[%count]xi8>, vector<2x[%count]xi64>) {
  %intermediate = vector.trunci %source : vector<2x[%count]xi32> to vector<2x[%count]xi8>
  %29 = index.constant 0 : index
  %30 = index.constant 1 : index
  %31 = index.constant 2 : index
  %34 = scf.for %32 = [%29 to %31 step %30](%33 = %source : vector<2x[%count]xi32>) -> (vector<2x[%count]xi32>) {
    %35 = index.constant 0 : index
    %36 = index.constant 1 : index
    %39 = scf.for %37 = [%35 to %count step %36](%38 = %33 : vector<2x[%count]xi32>) -> (vector<2x[%count]xi32>) {
      %40 = vector.extract %source[%32, %37] : vector<2x[%count]xi32> -> i32
      %41 = scalar.constant 24 : i32
      %42 = scalar.shli %40, %41 : i32
      %43 = vector.insert %42 into %38[%32, %37] : i32, vector<2x[%count]xi32>
      scf.yield %43 : vector<2x[%count]xi32>
    }
    scf.yield %39 : vector<2x[%count]xi32>
  }
  %12 = index.constant 0 : index
  %13 = index.constant 1 : index
  %14 = index.constant 2 : index
  %17 = scf.for %15 = [%12 to %14 step %13](%16 = %34 : vector<2x[%count]xi32>) -> (vector<2x[%count]xi32>) {
    %18 = index.constant 0 : index
    %19 = index.constant 1 : index
    %22 = scf.for %20 = [%18 to %count step %19](%21 = %16 : vector<2x[%count]xi32>) -> (vector<2x[%count]xi32>) {
      %23 = vector.extract %source[%15, %20] : vector<2x[%count]xi32> -> i32
      %24 = scalar.constant 24 : i32
      %25 = scalar.shli %23, %24 : i32
      %26 = scalar.constant 24 : i32
      %27 = scalar.shrsi %25, %26 : i32
      %28 = vector.insert %27 into %21[%15, %20] : i32, vector<2x[%count]xi32>
      scf.yield %28 : vector<2x[%count]xi32>
    }
    scf.yield %22 : vector<2x[%count]xi32>
  }
  %result = vector.extsi %17 : vector<2x[%count]xi32> to vector<2x[%count]xi64>
  func.return %intermediate, %result : vector<2x[%count]xi8>, vector<2x[%count]xi64>
}

// ====

// Constant propagation keeps sign fill and zero fill distinct.
test.target<low_core> @target

func.def target(@target) @constant_sign_boundaries() -> (vector<4xi32>, vector<4xi32>) {
  %source = vector.constant true : vector<4xi1>
  %intermediate = vector.extsi %source : vector<4xi1> to vector<4xi8>
  %unsigned = vector.extui %intermediate : vector<4xi8> to vector<4xi32>
  %signed = vector.extsi %intermediate : vector<4xi8> to vector<4xi32>
  func.return %unsigned, %signed : vector<4xi32>, vector<4xi32>
}
// ----
test.target<low_core> @target

func.def target(@target) @constant_sign_boundaries() -> (vector<4xi32>, vector<4xi32>) {
  %unsigned = vector.constant 255 : vector<4xi32>
  %signed = vector.constant -1 : vector<4xi32>
  func.return %unsigned, %signed : vector<4xi32>, vector<4xi32>
}

// ====

// Empty vectors fold without introducing scalar lane work.
test.target<low_core> @target

func.def target(@target) @empty_casts(%source: vector<0xi32>) -> (vector<0xi64>) {
  %intermediate = vector.trunci %source : vector<0xi32> to vector<0xi8>
  %result = vector.extsi %intermediate : vector<0xi8> to vector<0xi64>
  func.return %result : vector<0xi64>
}
// ----
test.target<low_core> @target

func.def target(@target) @empty_casts(%source: vector<0xi32>) -> (vector<0xi64>) {
  %result = vector.empty : vector<0xi64>
  func.return %result : vector<0xi64>
}
