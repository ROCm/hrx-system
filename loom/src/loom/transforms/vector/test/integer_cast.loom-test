func.def target(@target) @extract_signed_same_width(%source: vector<4xi64>) -> (vector<4xi64>) {
  %12 = vector.extract %source[0] : vector<4xi64> -> i64
  %13 = scalar.constant 56 : i64
  %14 = scalar.shli %12, %13 : i64
  %48 = scalar.constant 56 : i64
  %18 = scalar.shrsi %14, %48 : i64
  %19 = vector.extract %source[1] : vector<4xi64> -> i64
  %20 = scalar.constant 56 : i64
  %21 = scalar.shli %19, %20 : i64
  %47 = scalar.constant 56 : i64
  %25 = scalar.shrsi %21, %47 : i64
  %26 = vector.extract %source[2] : vector<4xi64> -> i64
  %27 = scalar.constant 56 : i64
  %28 = scalar.shli %26, %27 : i64
  %46 = scalar.constant 56 : i64
  %32 = scalar.shrsi %28, %46 : i64
  %33 = vector.extract %source[3] : vector<4xi64> -> i64
  %34 = scalar.constant 56 : i64
  %35 = scalar.shli %33, %34 : i64
  %45 = scalar.constant 56 : i64
  %39 = scalar.shrsi %35, %45 : i64
  %41 = vector.splat %18 : vector<4xi64>
  %42 = vector.insert %25 into %41[1] : i64, vector<4xi64>
  %43 = vector.insert %32 into %42[2] : i64, vector<4xi64>
  %result = vector.insert %39 into %43[3] : i64, vector<4xi64>
  func.return %result : vector<4xi64>
}

