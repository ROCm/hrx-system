  %8 = vector.extract %source[0, 0] : vector<2x3xi64> -> i64
  %9 = scalar.constant 255 : i64
  %10 = scalar.andi %8, %9 : i64
  %11 = vector.extract %source[0, 1] : vector<2x3xi64> -> i64
  %12 = scalar.constant 255 : i64
  %13 = scalar.andi %11, %12 : i64
  %14 = vector.extract %source[0, 2] : vector<2x3xi64> -> i64
  %15 = scalar.constant 255 : i64
  %16 = scalar.andi %14, %15 : i64
  %17 = vector.extract %source[1, 0] : vector<2x3xi64> -> i64
  %18 = scalar.constant 255 : i64
  %19 = scalar.andi %17, %18 : i64
  %20 = vector.extract %source[1, 1] : vector<2x3xi64> -> i64
  %21 = scalar.constant 255 : i64
  %22 = scalar.andi %20, %21 : i64
  %23 = vector.extract %source[1, 2] : vector<2x3xi64> -> i64
  %24 = scalar.constant 255 : i64
  %25 = scalar.andi %23, %24 : i64
  %26 = vector.from_elements %10, %13, %16, %19, %22, %25 : vector<2x3xi64>
  %result = vector.trunci %26 : vector<2x3xi64> to vector<2x3xi16>
  func.return %result : vector<2x3xi16>
}

