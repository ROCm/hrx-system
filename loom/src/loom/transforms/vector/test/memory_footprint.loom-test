  %layout = encoding.layout.dense : encoding<layout>
  %stride = index.constant 1024 : index
  %late_limit = index.constant 262138 : index
  %row_offset = index.mul %row, %stride : index
  %origin0 = index.add %row_offset, %column : index
  %origin = index.assume %origin0 [range(%origin0, 0, 262137), lt(%origin0, %late_limit), mul(%origin0, 8)] : index
  %view = buffer.view %buffer[%base] : buffer -> view<262144xf16, %layout>
  // ERROR@+1: SUBRANGE/010 {op_name="vector.load", vector_extent="8", view_bound="262144", required_origin_upper_bound="262136", constraint_key="vector_footprint.full_vector_upper_bound"}
  %loaded = vector.load %view[%origin] : view<262144xf16, %layout> -> vector<8xf16>
  test.use %loaded : vector<8xf16>
  func.return
}

