// RUN: pass vector-memory-footprint

func.def @static_dense_load_in_bounds(%buffer: buffer, %base: offset) {
  %layout = encoding.layout.dense : encoding<layout>
  %view = buffer.view %buffer[%base] : buffer -> view<8xf32, %layout>
  %loaded = vector.load %view[4] : view<8xf32, %layout> -> vector<4xf32>
  func.return
}

// ====

func.def @static_dense_store_in_bounds(%buffer: buffer, %base: offset, %value: vector<4xf32>) {
  %layout = encoding.layout.dense : encoding<layout>
  %view = buffer.view %buffer[%base] : buffer -> view<8xf32, %layout>
  vector.store %value, %view[4] : vector<4xf32>, view<8xf32, %layout>
  func.return
}

// ====

func.def @allocated_dense_view_ends_at_root_boundary() {
  %byte_length = index.constant 64 : offset
  %base = index.constant 0 : offset
  %scratch = buffer.alloca<workgroup> align(16) %byte_length : buffer
  %view = buffer.view %scratch[%base] : buffer -> view<16xf32>
  %loaded = vector.load %view[12] : view<16xf32> -> vector<4xf32>
  test.use %loaded : vector<4xf32>
  func.return
}

// ====

func.def @allocated_dense_view_allows_access_inside_root() {
  %byte_length = index.constant 64 : offset
  %base = index.constant 4 : offset
  %scratch = buffer.alloca<workgroup> align(16) %byte_length : buffer
  %view = buffer.view %scratch[%base] : buffer -> view<16xf32>
  %loaded = view.load %view[0] : view<16xf32> -> f32
  test.use %loaded : f32
  func.return
}

// ====

func.def @allocated_dense_view_rejects_access_past_root() {
  %byte_length = index.constant 64 : offset
  %base = index.constant 4 : offset
  %scratch = buffer.alloca<workgroup> align(16) %byte_length : buffer
  %view = buffer.view %scratch[%base] : buffer -> view<16xf32>
  // ERROR@+1: SUBRANGE/026 {op_name="view.load", maximum_access_byte_end="68", root_byte_extent="64"}
  %loaded = view.load %view[15] : view<16xf32> -> f32
  test.use %loaded : f32
  func.return
}

// ====

func.def @allocated_strided_view_rejects_root_overflow() {
  %byte_length = index.constant 27 : offset
  %base = index.constant 0 : offset
  %stride = index.constant 8 : index
  %layout = encoding.layout.strided [1, %stride] : encoding<layout>
  %scratch = buffer.alloca<workgroup> align(16) %byte_length : buffer
  %view = buffer.view %scratch[%base] : buffer -> view<4x4xi8, %layout>
  // ERROR@+1: SUBRANGE/026 {op_name="vector.load", maximum_access_byte_end="28", root_byte_extent="27"}
  %loaded = vector.load %view[3, 3] : view<4x4xi8, %layout> -> vector<1xi8>
  test.use %loaded : vector<1xi8>
  func.return
}

