func.def @sparse_lhs_fragment_load_uses_compact_physical_extent(%buffer: buffer, %base: offset, %metadata: vector<1xi32>) {
  %m = index.constant 16 : index
  %k = index.constant 64 : index
  %schema = encoding.define #encoding.operand<element_format=f8e5m2, payload_elements=8, payload_registers=2, sparsity=n_m_structured, sparsity_group_elements=4, sparsity_group_nonzero_elements=2> : encoding<schema>
  %layout = encoding.layout.dense : encoding<layout>
  %storage = encoding.define #encoding.storage {layout = %layout : encoding<layout>, schema = %schema : encoding<schema>} : encoding<storage>
  %view = buffer.view %buffer[%base] : buffer -> view<16x32xf8E5M2, %storage>
  %loaded = vector.fragment.load<lhs> %view[0, 0] shape [%m, %k] using {sparsity = %metadata : vector<1xi32>} : view<16x32xf8E5M2, %storage> -> vector<2xi32>
  test.use %loaded : vector<2xi32>
  func.return
}

// ====

func.def @dynamic_sparse_lhs_fragment_load_proves_compact_physical_extent(%buffer: buffer, %base: offset, %group_count0: index, %metadata: vector<1xi32>) {
  %group_count = index.assume %group_count0 [range(%group_count0, 1, 4096)] : index
  %physical_group_elements = index.constant 2 : index
  %logical_group_elements = index.constant 4 : index
  %m = index.constant 16 : index
  %physical_k = index.mul %group_count, %physical_group_elements : index
  %logical_k = index.mul %group_count, %logical_group_elements : index
  %schema = encoding.define #encoding.operand<element_format=f8e5m2, payload_elements=8, payload_registers=2, sparsity=n_m_structured, sparsity_group_elements=4, sparsity_group_nonzero_elements=2> : encoding<schema>
  %layout = encoding.layout.dense : encoding<layout>
  %storage = encoding.define #encoding.storage {layout = %layout : encoding<layout>, schema = %schema : encoding<schema>} : encoding<storage>
  %view = buffer.view %buffer[%base] : buffer -> view<16x[%physical_k]xf8E5M2, %storage>
  %loaded = vector.fragment.load<lhs> %view[0, 0] shape [%m, %logical_k] using {sparsity = %metadata : vector<1xi32>} : view<16x[%physical_k]xf8E5M2, %storage> -> vector<2xi32>
  test.use %loaded : vector<2xi32>
  func.return
}

