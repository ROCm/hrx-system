// RUN: pass scf-to-cfg,vector-memory-footprint
kernel.def @scalar_store_tail_origin_proven_after_scf_to_cfg() {
  %c1 = index.constant 1 : index
  %workgroup_size = index.constant 256 : index
  %head_count = index.constant 24 : index
  %token_count = index.constant 512 : index
  %row_count = index.mul %head_count, %token_count : index
  kernel.launch.config workgroups(%row_count, %c1, %c1) workgroup_size(%workgroup_size, %c1, %c1) : index
} launch(%buffer: buffer, %base: offset, %value: f32) {
  %layout = encoding.layout.dense : encoding<layout>
  %tail_increment = index.constant 1 : index
  %tail_scale = index.constant 2 : index
  %head_count = index.constant 24 : index
  %token_count = index.constant 512 : index
  %half_cols = index.constant 64 : index
  %half_dims = index.constant 48 : index
  %n_dims = index.constant 96 : index
  %head_stride = index.constant 128 : index
  %token_stride = index.constant 3072 : index
  %row = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %view_count = index.mul %token_stride, %token_count : index
  %in_bounds = index.cmp ult, %lane, %half_cols : index
  %view = buffer.view %buffer[%base] : buffer -> view<[%view_count]xf32, %layout>
  scf.if %in_bounds {
    %head = index.rem %row, %head_count : index
    %token = index.div %row, %head_count : index
    %head_base = index.mul %head, %head_stride : index
    %token_base = index.mul %token, %token_stride : index
    %dst_base = index.add %head_base, %token_base : index
    %pair_in_rot = index.cmp ult, %lane, %half_dims : index
    scf.if %pair_in_rot {
    } else {
      %tail_pair = index.sub %lane, %half_dims : index
      %tail_pair2 = index.mul %tail_pair, %tail_scale : index
      %tail0 = index.add %n_dims, %tail_pair2 : index
      %tail1 = index.add %tail0, %tail_increment : index
      %origin = index.add %dst_base, %tail1 : index
      view.store %value, %view[%origin] : f32, view<[%view_count]xf32, %layout>
    }
  }
  kernel.return
}

