func.def @fragment_load_in_bounds(%buffer: buffer, %base: offset) {
  %layout = encoding.layout.dense : encoding<layout>
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %view = buffer.view %buffer[%base] : buffer -> view<16x16xf32, %layout>
  %loaded = vector.fragment.load<init> %view[0, 0] shape [%m, %n] : view<16x16xf32, %layout> -> vector<8xf32>
  test.use %loaded : vector<8xf32>
  func.return
}

