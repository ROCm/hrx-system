// RUN: pass combine,scf-to-cfg,vector-memory-footprint

test.target<low_core> @carrier {index_bitwidth = 32, offset_bitwidth = 64}

func.def target(@carrier) @complete_packets(%input: buffer, %extent_input: index) {
  %extent = index.assume %extent_input [range(%extent_input, 16, 1023)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %width = index.constant 16 : index
  %last_packet = index.constant 12 : index
  %base = index.constant 0 : offset
  %count = index.div %extent, %width : index
  %view = buffer.view %input[%base] : buffer -> view<[%extent]xi32>
  %fallback = vector.splati 0 : vector<4xi32>
  scf.for %block = [%c0 to %count step %c1] {
    %origin = index.madd %block, %width, %last_packet : index
    %mask = vector.mask.range [%origin to %extent step %c1] : index -> vector<4xi1>
    %value = vector.load.mask %view[%origin], %mask, %fallback : view<[%extent]xi32>, vector<4xi1>, vector<4xi32>
    test.use %value : vector<4xi32>
  }
  func.return
}

// ----
test.target<low_core> @carrier {index_bitwidth = 32, offset_bitwidth = 64}

func.def target(@carrier) @complete_packets(%input: buffer, %extent_input: index) {
  %extent = index.assume %extent_input [range(%extent_input, 16, 1023)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %width = index.constant 16 : index
  %last_packet = index.constant 12 : index
  %base = index.constant 0 : offset
  %17 = index.constant 4 : index
  %count = index.shrui %extent, %17 : index
  %view = buffer.view %input[%base] : buffer -> view<[%extent]xi32>
  cfg.br ^_bb1(%c0: index)
^_bb1(%19: index):
  %21 = index.cmp slt, %19, %count : index
  cfg.cond_br %21, ^_bb2, ^_bb3
^_bb2:
  %block = index.assume %19 [range(%19, 0, 62), lt(%19, %count)] : index
  %origin = index.madd %block, %width, %last_packet : index
  %value = vector.load %view[%origin] : view<[%extent]xi32> -> vector<4xi32>
  test.use %value : vector<4xi32>
  %22 = index.add %block, %c1 : index
  cfg.br ^_bb1(%22: index)
^_bb3:
  func.return
}

