func.def @positive_wrap(%upper_input: index) {
  %upper = index.assume %upper_input [range(%upper_input, 121, 127)] : index
  %lower = index.constant 120 : index
  %c1 = index.constant 1 : index
  %step = scalar.constant 4 : i8
  %bound = index.cast %upper : index to i8
  scf.for %coordinate = [%lower to %upper step %c1] {
    %origin = index.cast %coordinate : index to i8
    %mask = vector.mask.range [%origin to %bound step %step] : i8 -> vector<4xi1>
    test.use %mask : vector<4xi1>
  }
  func.return
}

