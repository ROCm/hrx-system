// ====
// RUN: pass combine

func.def @fixed_width_coordinates(%extent_input: index) {
  %extent = index.assume %extent_input [range(%extent_input, 16, 127)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %width = index.constant 16 : index
  %last_packet = index.constant 12 : index
  %count = index.div %extent, %width : index
  %bound_i8 = index.cast %extent : index to i8
  %bound_i16 = index.cast %extent : index to i16
  %bound_i32 = index.cast %extent : index to i32
  %bound_i64 = index.cast %extent : index to i64
  %step_i8 = scalar.constant 1 : i8
  %step_i16 = scalar.constant 1 : i16
  %step_i32 = scalar.constant 1 : i32
  %step_i64 = scalar.constant 1 : i64
  scf.for %block = [%c0 to %count step %c1] {
    %origin = index.madd %block, %width, %last_packet : index
    %origin_i8 = index.cast %origin : index to i8
    %origin_i16 = index.cast %origin : index to i16
    %origin_i32 = index.cast %origin : index to i32
    %origin_i64 = index.cast %origin : index to i64
    %mask_i8 = vector.mask.range [%origin_i8 to %bound_i8 step %step_i8] : i8 -> vector<4xi1>
    %mask_i16 = vector.mask.range [%origin_i16 to %bound_i16 step %step_i16] : i16 -> vector<4xi1>
    %mask_i32 = vector.mask.range [%origin_i32 to %bound_i32 step %step_i32] : i32 -> vector<4xi1>
    %mask_i64 = vector.mask.range [%origin_i64 to %bound_i64 step %step_i64] : i64 -> vector<4xi1>
    test.use %mask_i8, %mask_i16, %mask_i32, %mask_i64 : vector<4xi1>, vector<4xi1>, vector<4xi1>, vector<4xi1>
  }
  func.return
}

// ----
func.def @fixed_width_coordinates(%extent_input: index) {
  %extent = index.assume %extent_input [range(%extent_input, 16, 127)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %29 = index.constant 4 : index
  %count = index.shrui %extent, %29 : index
  scf.for %block = [%c0 to %count step %c1] {
    %mask_i8 = vector.splati 1 : vector<4xi1>
    %mask_i16 = vector.splati 1 : vector<4xi1>
    %mask_i32 = vector.splati 1 : vector<4xi1>
    %mask_i64 = vector.splati 1 : vector<4xi1>
    test.use %mask_i8, %mask_i16, %mask_i32, %mask_i64 : vector<4xi1>, vector<4xi1>, vector<4xi1>, vector<4xi1>
  }
  func.return
}

