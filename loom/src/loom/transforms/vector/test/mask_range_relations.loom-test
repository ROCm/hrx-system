func.def target(@carrier) @bounded_lanes_and_stride(%extent_input: index, %lanes_input: index, %stride_input: index) {
  %extent = index.assume %extent_input [range(%extent_input, 16, 1023)] : index
  %lanes = index.assume %lanes_input [range(%lanes_input, 1, 4)] : index
  %stride = index.assume %stride_input [range(%stride_input, -2, 2)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %width = index.constant 16 : index
  %last_packet = index.constant 9 : index
  %count = index.div %extent, %width : index
  scf.for %block = [%c0 to %count step %c1] {
    %origin = index.madd %block, %width, %last_packet : index
    %mask = vector.mask.range [%origin to %extent step %stride] : index -> vector<[%lanes]xi1>
    test.use %mask : vector<[%lanes]xi1>
  }
  func.return
}

