  %byte_unsigned = vector.bitfield.extractu %byte {offset = 2, width = 3} : vector<1xi8> -> vector<1xi64>
  %wide_signed = vector.bitfield.extracts %wide {offset = 43, width = 7} : vector<1x1xi64> -> vector<1x1xi8>
  %wide_unsigned = vector.bitfield.extractu %wide {offset = 43, width = 7} : vector<1x1xi64> -> vector<1x1xi8>
  func.return %byte_signed, %byte_unsigned, %wide_signed, %wide_unsigned : vector<1xi64>, vector<1xi64>, vector<1x1xi8>, vector<1x1xi8>
}
