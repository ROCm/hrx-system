// RUN: pass target-legalize{mode=eager},dce,canonicalize

test.target<low_core> @target

func.def target(@target) @singleton_fields(%byte: vector<1xi8>, %wide: vector<1x1xi64>) -> (vector<1xi64>, vector<1xi64>, vector<1x1xi8>, vector<1x1xi8>) {
  %byte_signed = vector.bitfield.extracts %byte {offset = 2, width = 3} : vector<1xi8> -> vector<1xi64>
  %byte_unsigned = vector.bitfield.extractu %byte {offset = 2, width = 3} : vector<1xi8> -> vector<1xi64>
  %wide_signed = vector.bitfield.extracts %wide {offset = 43, width = 7} : vector<1x1xi64> -> vector<1x1xi8>
  %wide_unsigned = vector.bitfield.extractu %wide {offset = 43, width = 7} : vector<1x1xi64> -> vector<1x1xi8>
  func.return %byte_signed, %byte_unsigned, %wide_signed, %wide_unsigned : vector<1xi64>, vector<1xi64>, vector<1x1xi8>, vector<1x1xi8>
}
// ----
test.target<low_core> @target

func.def target(@target) @singleton_fields(%byte: vector<1xi8>, %wide: vector<1x1xi64>) -> (vector<1xi64>, vector<1xi64>, vector<1x1xi8>, vector<1x1xi8>) {
  %35 = vector.extract %byte[0] : vector<1xi8> -> i8
  %38 = scalar.extui %35 : i8 to i32
  %39 = scalar.constant 27 : i32
  %40 = scalar.shli %38, %39 : i32
  %41 = scalar.constant 29 : i32
  %42 = scalar.shrsi %40, %41 : i32
  %43 = scalar.extsi %42 : i32 to i64
  %byte_signed = vector.splat %43 : vector<1xi64>
  %26 = vector.extract %byte[0] : vector<1xi8> -> i8
  %29 = scalar.extui %26 : i8 to i32
  %30 = scalar.constant 2 : i32
  %31 = scalar.shrui %29, %30 : i32
  %32 = scalar.constant 7 : i32
  %33 = scalar.andi %31, %32 : i32
  %34 = scalar.extui %33 : i32 to i64
  %byte_unsigned = vector.splat %34 : vector<1xi64>
  %18 = vector.extract %wide[0, 0] : vector<1x1xi64> -> i64
  %21 = scalar.constant 14 : i64
  %22 = scalar.shli %18, %21 : i64
  %23 = scalar.constant 57 : i64
  %24 = scalar.shrsi %22, %23 : i64
  %25 = scalar.trunci %24 : i64 to i8
  %wide_signed = vector.splat %25 : vector<1x1xi8>
  %10 = vector.extract %wide[0, 0] : vector<1x1xi64> -> i64
  %13 = scalar.constant 43 : i64
  %14 = scalar.shrui %10, %13 : i64
  %15 = scalar.constant 127 : i64
  %16 = scalar.andi %14, %15 : i64
  %17 = scalar.trunci %16 : i64 to i8
  %wide_unsigned = vector.splat %17 : vector<1x1xi8>
  func.return %byte_signed, %byte_unsigned, %wide_signed, %wide_unsigned : vector<1xi64>, vector<1xi64>, vector<1x1xi8>, vector<1x1xi8>
}

