  %25 = scalar.constant 8 : i32
  %26 = vector.splat %25 : vector<2xi32>
  %27 = vector.shli %source, %26 : vector<2xi32>
  %28 = scalar.constant 24 : i32
  %29 = vector.splat %28 : vector<2xi32>
  %30 = vector.shrui %27, %29 : vector<2xi32>
  %byte = vector.trunci %30 : vector<2xi32> to vector<2xi8>
  %21 = scalar.constant 31 : i32
  %22 = vector.splat %21 : vector<2xi32>
  %23 = vector.shrsi %source, %22 : vector<2xi32>
  %predicate = vector.trunci %23 : vector<2xi32> to vector<2xi1>
  %15 = scalar.constant 12 : i32
  %16 = vector.splat %15 : vector<2xi32>
  %17 = vector.shli %source, %16 : vector<2xi32>
  %18 = scalar.constant 19 : i32
  %19 = vector.splat %18 : vector<2xi32>
  %signed = vector.shrsi %17, %19 : vector<2xi32>
  %9 = scalar.constant 12 : i32
  %10 = vector.splat %9 : vector<2xi32>
  %11 = vector.shli %source, %10 : vector<2xi32>
  %12 = scalar.constant 19 : i32
  %13 = vector.splat %12 : vector<2xi32>
  %unsigned = vector.shrui %11, %13 : vector<2xi32>
  func.return %byte, %predicate, %signed, %unsigned : vector<2xi8>, vector<2xi1>, vector<2xi32>, vector<2xi32>
}

