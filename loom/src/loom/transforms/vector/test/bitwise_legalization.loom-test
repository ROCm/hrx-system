  %28 = scalar.constant 4 : i16
  %29 = vector.splat %28 : vector<2xi16>
  %26 = vector.shrsi %24, %29 : vector<2xi16>
  %top = vector.trunci %26 : vector<2xi16> to vector<2xi8>
  %14 = vector.extui %source : vector<2xi8> to vector<2xi16>
  %15 = scalar.constant 11 : i16
  %16 = vector.splat %15 : vector<2xi16>
  %17 = vector.shli %14, %16 : vector<2xi16>
  %18 = scalar.constant 13 : i16
  %19 = vector.splat %18 : vector<2xi16>
  %signed = vector.shrsi %17, %19 : vector<2xi16>
  %7 = vector.extui %source : vector<2xi8> to vector<2xi16>
  %8 = scalar.constant 11 : i16
  %9 = vector.splat %8 : vector<2xi16>
  %10 = vector.shli %7, %9 : vector<2xi16>
  %11 = scalar.constant 13 : i16
  %12 = vector.splat %11 : vector<2xi16>
  %unsigned = vector.shrui %10, %12 : vector<2xi16>
  func.return %top, %signed, %unsigned : vector<2xi8>, vector<2xi16>, vector<2xi16>
}

