func.def target(@target) @word_fields(%source: vector<2xi32>) -> (vector<2xi8>, vector<2xi1>, vector<2xi32>, vector<2xi32>) {
  %byte = vector.bitfield.extractu %source {offset = 16, width = 8} : vector<2xi32> -> vector<2xi8>
  %predicate = vector.bitfield.extracts %source {offset = 31, width = 1} : vector<2xi32> -> vector<2xi1>
  %signed = vector.bitfield.extracts %source {offset = 7, width = 13} : vector<2xi32> -> vector<2xi32>
  %unsigned = vector.bitfield.extractu %source {offset = 7, width = 13} : vector<2xi32> -> vector<2xi32>
  func.return %byte, %predicate, %signed, %unsigned : vector<2xi8>, vector<2xi1>, vector<2xi32>, vector<2xi32>
}
