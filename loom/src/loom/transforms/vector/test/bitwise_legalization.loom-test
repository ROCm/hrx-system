func.def target(@target) @boolean_fields(%source: vector<2xi1>) -> (vector<2xi1>, vector<2xi8>, vector<2xi8>) {
  %identity = vector.bitfield.extractu %source {offset = 0, width = 1} : vector<2xi1> -> vector<2xi1>
  %signed = vector.bitfield.extracts %source {offset = 0, width = 1} : vector<2xi1> -> vector<2xi8>
  %unsigned = vector.bitfield.extractu %source {offset = 0, width = 1} : vector<2xi1> -> vector<2xi8>
  func.return %identity, %signed, %unsigned : vector<2xi1>, vector<2xi8>, vector<2xi8>
}
// ----
test.target<low_core> @target

func.def target(@target) @boolean_fields(%source: vector<2xi1>) -> (vector<2xi1>, vector<2xi8>, vector<2xi8>) {
  %signed = vector.extsi %source : vector<2xi1> to vector<2xi8>
  %unsigned = vector.extui %source : vector<2xi1> to vector<2xi8>
  func.return %source, %signed, %unsigned : vector<2xi1>, vector<2xi8>, vector<2xi8>
}

