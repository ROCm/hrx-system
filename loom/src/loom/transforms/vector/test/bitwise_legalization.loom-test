  %unsigned = vector.bitfield.extractu %source {offset = 7, width = 9} : vector<2xi16> -> vector<2xi16>
  %signed_full = vector.bitfield.extracts %source {offset = 0, width = 16} : vector<2xi16> -> vector<2xi32>
