  func.return %values : vector<8xi32>
}

// ----
x86.target<avx2> @target

func.def target(@target) @native_control(%base: i32, %step: i32) -> (vector<8xi32>) {
  %values = vector.iota %base step %step : vector<8xi32>
  func.return %values : vector<8xi32>
}

// ====
// RUN: pass target-legalize{mode=eager,policy=require-native},canonicalize,dce

x86.target<avx2> @target

func.def target(@target) @wrapping_mask(%base: i8, %limit: i8, %step: i8) -> (vector<16xi1>) {
  %mask = vector.mask.range [%base to %limit step %step] : i8 -> vector<16xi1>
  func.return %mask : vector<16xi1>
}

// ----
x86.target<avx2> @target

func.def target(@target) @wrapping_mask(%base: i8, %limit: i8, %step: i8) -> (vector<16xi1>) {
  %5 = vector.iota %base step %step : vector<16xi8>
  %6 = vector.splat %limit : vector<16xi8>
  %mask = vector.cmpi slt, %5, %6 : vector<16xi8> -> vector<16xi1>
  func.return %mask : vector<16xi1>
}

// ====
// RUN: pass target-legalize{mode=eager,policy=require-native},canonicalize,dce

x86.target<avx2> @target

func.def target(@target) @index_mask(%base: index, %limit: index, %step: index) -> (vector<8xi1>) {
  %mask = vector.mask.range [%base to %limit step %step] : index -> vector<8xi1>
  func.return %mask : vector<8xi1>
}

// ----
x86.target<avx2> @target

func.def target(@target) @index_mask(%base: index, %limit: index, %step: index) -> (vector<8xi1>) {
  %5 = vector.iota %base step %step : vector<8xindex>
  %6 = vector.index_cast %5 : vector<8xindex> to vector<8xi64>
  %7 = index.cast %limit : index to i64
  %8 = vector.splat %7 : vector<8xi64>
  %mask = vector.cmpi slt, %6, %8 : vector<8xi64> -> vector<8xi1>
  func.return %mask : vector<8xi1>
}
