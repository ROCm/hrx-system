func.def target(@target) @ranked_native(%base: i32, %step: i32, %output: view<2x4xi32>) {
  %4 = vector.iota %base step %step : vector<8xi32>
  %values = vector.bitcast %4 : vector<8xi32> to vector<2x4xi32>
  vector.store %values, %output[0, 0] : vector<2x4xi32>, view<2x4xi32>
  func.return
}

// ====
// RUN: pass target-legalize{mode=eager,policy=require-native},canonicalize,dce

x86.target<avx2> @target

func.def target(@target) @wrapped_offsets(%base: i8, %step: i8, %output: view<160xi8>) {
  %values = vector.iota %base step %step : vector<160xi8>
  vector.store %values, %output[0] : vector<160xi8>, view<160xi8>
  func.return
}

// ----
x86.target<avx2> @target

func.def target(@target) @wrapped_offsets(%base: i8, %step: i8, %output: view<160xi8>) {
  %4 = vector.iota %base step %step : vector<32xi8>
  %26 = scalar.constant 5 : i8
  %27 = scalar.shli %step, %26 : i8
  %7 = scalar.addi %base, %27 : i8
  %8 = vector.iota %7 step %step : vector<32xi8>
  %24 = scalar.constant 6 : i8
  %25 = scalar.shli %step, %24 : i8
  %11 = scalar.addi %base, %25 : i8
  %12 = vector.iota %11 step %step : vector<32xi8>
  %13 = scalar.constant 96 : i8
  %14 = scalar.muli %13, %step : i8
  %15 = scalar.addi %base, %14 : i8
  %16 = vector.iota %15 step %step : vector<32xi8>
  %22 = scalar.constant 7 : i8
  %23 = scalar.shli %step, %22 : i8
  %19 = scalar.addi %base, %23 : i8
  %20 = vector.iota %19 step %step : vector<32xi8>
  vector.store %4, %output[0] : vector<32xi8>, view<160xi8>
  vector.store %8, %output[32] : vector<32xi8>, view<160xi8>
  vector.store %12, %output[64] : vector<32xi8>, view<160xi8>
  vector.store %16, %output[96] : vector<32xi8>, view<160xi8>
  vector.store %20, %output[128] : vector<32xi8>, view<160xi8>
  func.return
}

