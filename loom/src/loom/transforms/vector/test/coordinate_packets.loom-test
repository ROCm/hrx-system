// RUN: pass target-legalize{mode=eager,policy=require-native},canonicalize,dce

x86.target<avx2> @target

func.def target(@target) @wide_words(%base: i32, %step: i32, %output: view<16xi32>) {
  %values = vector.iota %base step %step : vector<16xi32>
  vector.store %values, %output[0] : vector<16xi32>, view<16xi32>
  func.return
}

// ----
x86.target<avx2> @target

func.def target(@target) @wide_words(%base: i32, %step: i32, %output: view<16xi32>) {
  %4 = vector.iota %base step %step : vector<8xi32>
  %10 = scalar.constant 3 : i32
  %11 = scalar.shli %step, %10 : i32
  %7 = scalar.addi %base, %11 : i32
  %8 = vector.iota %7 step %step : vector<8xi32>
  vector.store %4, %output[0] : vector<8xi32>, view<16xi32>
  vector.store %8, %output[8] : vector<8xi32>, view<16xi32>
  func.return
}

// ====
// RUN: pass target-legalize{mode=eager,policy=require-native},canonicalize,dce

x86.target<avx2> @target

func.def target(@target) @word_tail(%base: i32, %output: view<10xi32>) {
  %step = scalar.constant 1 : i32
  %values = vector.iota %base step %step : vector<10xi32>
  vector.store %values, %output[0] : vector<10xi32>, view<10xi32>
  func.return
}

// ----
x86.target<avx2> @target

func.def target(@target) @word_tail(%base: i32, %output: view<10xi32>) {
  %step = scalar.constant 1 : i32
  %4 = vector.iota %base step %step : vector<8xi32>
  %10 = scalar.constant 8 : i32
  %7 = scalar.addi %base, %10 : i32
  %8 = vector.iota %7 step %step : vector<2xi32>
  vector.store %4, %output[0] : vector<8xi32>, view<10xi32>
  vector.store %8, %output[8] : vector<2xi32>, view<10xi32>
  func.return
}

// ====
// RUN: pass target-legalize{mode=eager,policy=require-native},canonicalize,dce

x86.target<avx2> @target

func.def target(@target) @ranked_longs(%base: i64, %step: i64, %output: view<2x3xi64>) {
  %values = vector.iota %base step %step : vector<2x3xi64>
  vector.store %values, %output[0, 0] : vector<2x3xi64>, view<2x3xi64>
  func.return
}

// ----
x86.target<avx2> @target

func.def target(@target) @ranked_longs(%base: i64, %step: i64, %output: view<2x3xi64>) {
  %4 = vector.iota %base step %step : vector<4xi64>
  %11 = scalar.constant 2 : i64
  %12 = scalar.shli %step, %11 : i64
  %7 = scalar.addi %base, %12 : i64
  %8 = vector.iota %7 step %step : vector<2xi64>
  %9 = vector.concat<0> %4, %8 : vector<4xi64>, vector<2xi64> -> vector<6xi64>
  %values = vector.bitcast %9 : vector<6xi64> to vector<2x3xi64>
  vector.store %values, %output[0, 0] : vector<2x3xi64>, view<2x3xi64>
  func.return
}

