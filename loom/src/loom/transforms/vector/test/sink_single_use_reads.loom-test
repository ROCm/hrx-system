// ====

func.def @keeps_outer_read_and_sinks_nested_read(%source: view<8xi32>, %value: i32, %condition: i1) -> (i32) {
  %outer = vector.load %source[0] : view<8xi32> -> vector<4xi32>
  scf.if %condition {
    %inner = vector.load %source[0] : view<8xi32> -> vector<4xi32>
    %marker = test.addi %value, %value : i32
    %inner_lane = vector.extract %inner[0] : vector<4xi32> -> i32
    view.store %inner_lane, %source[0] : i32, view<8xi32>
  }
  %lane = vector.extract %outer[0] : vector<4xi32> -> i32
  func.return %lane : i32
}

// ----
func.def @keeps_outer_read_and_sinks_nested_read(%source: view<8xi32>, %value: i32, %condition: i1) -> (i32) {
  %outer = vector.load %source[0] : view<8xi32> -> vector<4xi32>
  scf.if %condition {
    %marker = test.addi %value, %value : i32
    %inner = vector.load %source[0] : view<8xi32> -> vector<4xi32>
    %inner_lane = vector.extract %inner[0] : vector<4xi32> -> i32
    view.store %inner_lane, %source[0] : i32, view<8xi32>
  }
  %lane = vector.extract %outer[0] : vector<4xi32> -> i32
  func.return %lane : i32
}

