func.def @keeps_read_outside_conditional_consumer(%source: view<8xi32>, %condition: i1) {
  %loaded = vector.load %source[0] : view<8xi32> -> vector<4xi32>
  scf.if %condition {
    vector.store %loaded, %source[0] : vector<4xi32>, view<8xi32>
  }
  func.return
}

