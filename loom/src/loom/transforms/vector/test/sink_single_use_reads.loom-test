// ====

func.def @keeps_vector_load_before_intervening_write(%input: buffer, %output: buffer, %base: offset, %value: vector<4xf32>) -> (f32) {
  %layout = encoding.layout.dense : encoding<layout>
  %input_view = buffer.view %input[%base] : buffer -> view<16xf32, %layout>
  %output_view = buffer.view %output[%base] : buffer -> view<16xf32, %layout>
  %loaded = vector.load %input_view[0] : view<16xf32, %layout> -> vector<4xf32>
  vector.store %value, %output_view[0] : vector<4xf32>, view<16xf32, %layout>
  %lane = vector.extract %loaded[0] : vector<4xf32> -> f32
  func.return %lane : f32
}

// ----
func.def @keeps_vector_load_before_intervening_write(%input: buffer, %output: buffer, %base: offset, %value: vector<4xf32>) -> (f32) {
  %layout = encoding.layout.dense : encoding<layout>
  %input_view = buffer.view %input[%base] : buffer -> view<16xf32, %layout>
  %output_view = buffer.view %output[%base] : buffer -> view<16xf32, %layout>
  %loaded = vector.load %input_view[0] : view<16xf32, %layout> -> vector<4xf32>
  vector.store %value, %output_view[0] : vector<4xf32>, view<16xf32, %layout>
  %lane = vector.extract %loaded[0] : vector<4xf32> -> f32
  func.return %lane : f32
}

// ====

func.def @keeps_vector_load_with_multiple_operand_uses(%input: buffer, %base: offset, %a: i32, %b: i32) -> (f32, f32) {
  %layout = encoding.layout.dense : encoding<layout>
  %view = buffer.view %input[%base] : buffer -> view<16xf32, %layout>
  %loaded = vector.load %view[0] : view<16xf32, %layout> -> vector<4xf32>
  %sum = test.addi %a, %b : i32
  %lane0 = vector.extract %loaded[0] : vector<4xf32> -> f32
  %lane1 = vector.extract %loaded[1] : vector<4xf32> -> f32
  test.use %sum : i32
  func.return %lane0, %lane1 : f32, f32
}

// ----
func.def @keeps_vector_load_with_multiple_operand_uses(%input: buffer, %base: offset, %a: i32, %b: i32) -> (f32, f32) {
  %layout = encoding.layout.dense : encoding<layout>
  %view = buffer.view %input[%base] : buffer -> view<16xf32, %layout>
  %loaded = vector.load %view[0] : view<16xf32, %layout> -> vector<4xf32>
  %sum = test.addi %a, %b : i32
  %lane0 = vector.extract %loaded[0] : vector<4xf32> -> f32
  %lane1 = vector.extract %loaded[1] : vector<4xf32> -> f32
  test.use %sum : i32
  func.return %lane0, %lane1 : f32, f32
}

