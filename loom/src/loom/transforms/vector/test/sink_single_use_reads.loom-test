func.def @keeps_read_for_effectful_consumer(%source: view<8xi32>, %value: i32) {
  %loaded = vector.load %source[0] : view<8xi32> -> vector<4xi32>
  %marker = test.addi %value, %value : i32
  vector.store %loaded, %source[0] : vector<4xi32>, view<8xi32>
  func.return
}

