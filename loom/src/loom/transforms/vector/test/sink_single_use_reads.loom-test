func.def @keeps_read_at_fence(%source: view<8xi32>, %value: i32) -> (i32) {
  %loaded = vector.load %source[0] : view<8xi32> -> vector<4xi32>
  %marker = test.addi %value, %value : i32
  %barrier = test.memory_fence %value : i32
  %lane = vector.extract %loaded[0] : vector<4xi32> -> i32
  func.return %lane : i32
}

