// RUN: pass target=amdgpu:gfx11-generic target-legalize{mode=eager,policy=require-native},canonicalize,dce,target-legalize{mode=complete,policy=require-native},canonicalize,dce

// An exclusive load keeps only the selected two row runs.
func.def @rectangle(%input: buffer, %row: index, %column: index) -> (vector<2x3xi8>) {
  %base = index.constant 0 : offset
  %view = buffer.view %input[%base] : buffer -> view<4x8xi8>
  %values = vector.load %view[0, 0] : view<4x8xi8> -> vector<4x8xi8>
  %result = vector.slice %values[%row, %column] : vector<4x8xi8> -> vector<2x3xi8>
  func.return %result : vector<2x3xi8>
}

// ----
func.def @rectangle(%input: buffer, %row: index, %column: index) -> (vector<2x3xi8>) {
  %base = index.constant 0 : offset
  %view = buffer.view %input[%base] : buffer -> view<4x8xi8>
  %9 = vector.load %view[%row, %column] : view<4x8xi8> -> vector<3xi8>
  %10 = index.constant 1 : index
  %11 = index.add %row, %10 : index
  %12 = vector.load %view[%11, %column] : view<4x8xi8> -> vector<3xi8>
  %15 = vector.extract %9[0] : vector<3xi8> -> i8
  %16 = vector.extract %9[1] : vector<3xi8> -> i8
  %17 = vector.extract %9[2] : vector<3xi8> -> i8
  %18 = vector.extract %12[0] : vector<3xi8> -> i8
  %19 = vector.extract %12[1] : vector<3xi8> -> i8
  %20 = vector.extract %12[2] : vector<3xi8> -> i8
  %21 = vector.from_elements %15, %16, %17, %18, %19, %20 : vector<6xi8>
  %result = vector.bitcast %21 : vector<6xi8> to vector<2x3xi8>
  func.return %result : vector<2x3xi8>
}

// ====

// A complete trailing plane forms a single contiguous window.
func.def @plane(%input: buffer, %plane: index) -> (vector<1x2x4xf32>) {
  %base = index.constant 0 : offset
  %view = buffer.view %input[%base] : buffer -> view<3x2x4xf32>
  %values = vector.load %view[0, 0, 0] : view<3x2x4xf32> -> vector<3x2x4xf32>
  %result = vector.slice %values[%plane, 0, 0] : vector<3x2x4xf32> -> vector<1x2x4xf32>
  func.return %result : vector<1x2x4xf32>
}

// ----
func.def @plane(%input: buffer, %plane: index) -> (vector<1x2x4xf32>) {
  %base = index.constant 0 : offset
  %view = buffer.view %input[%base] : buffer -> view<3x2x4xf32>
  %13 = index.constant 3 : index
  %14 = index.shli %plane, %13 : index
  %10 = view.bitcast %view : view<3x2x4xf32> -> view<24xf32>
  %11 = vector.load %10[%14] : view<24xf32> -> vector<8xf32>
  %result = vector.bitcast %11 : vector<8xf32> to vector<1x2x4xf32>
  func.return %result : vector<1x2x4xf32>
}

// ====

// The full innermost axis joins rows but the cropped middle axis separates
// planes. A static leading offset participates in the common runtime base.
func.def @cropped_planes(%input: buffer, %row: index) -> (vector<2x2x4xi16>) {
  %base = index.constant 0 : offset
  %view = buffer.view %input[%base] : buffer -> view<3x4x4xi16>
  %values = vector.load %view[0, 0, 0] : view<3x4x4xi16> -> vector<3x4x4xi16>
  %result = vector.slice %values[1, %row, 0] : vector<3x4x4xi16> -> vector<2x2x4xi16>
  func.return %result : vector<2x2x4xi16>
}

// ----
func.def @cropped_planes(%input: buffer, %row: index) -> (vector<2x2x4xi16>) {
  %base = index.constant 0 : offset
  %view = buffer.view %input[%base] : buffer -> view<3x4x4xi16>
  %8 = vector.load %view[1, %row, 0] : view<3x4x4xi16> -> vector<4xi16>
  %9 = index.constant 1 : index
  %10 = index.add %row, %9 : index
  %11 = vector.load %view[1, %10, 0] : view<3x4x4xi16> -> vector<4xi16>
  %12 = vector.load %view[2, %row, 0] : view<3x4x4xi16> -> vector<4xi16>
  %13 = index.constant 1 : index
  %14 = index.add %row, %13 : index
  %15 = vector.load %view[2, %14, 0] : view<3x4x4xi16> -> vector<4xi16>
  %18 = vector.concat<0> %8, %11 : vector<4xi16>, vector<4xi16> -> vector<8xi16>
  %19 = vector.concat<0> %12, %15 : vector<4xi16>, vector<4xi16> -> vector<8xi16>
  %20 = vector.concat<0> %18, %19 : vector<8xi16>, vector<8xi16> -> vector<16xi16>
  %result = vector.bitcast %20 : vector<16xi16> to vector<2x2x4xi16>
  func.return %result : vector<2x2x4xi16>
}

// ====

// A partial trailing axis keeps gaps inside every plane.
func.def @strided_volume(%values: vector<2x3x4xi32>) -> (vector<2x2x2xi32>) {
  %result = vector.slice %values[0, 1, 1] : vector<2x3x4xi32> -> vector<2x2x2xi32>
  func.return %result : vector<2x2x2xi32>
}

// ----
func.def @strided_volume(%values: vector<2x3x4xi32>) -> (vector<2x2x2xi32>) {
  %3 = vector.bitcast %values : vector<2x3x4xi32> to vector<24xi32>
  %4 = vector.slice %3[5] : vector<24xi32> -> vector<2xi32>
  %5 = vector.slice %3[9] : vector<24xi32> -> vector<2xi32>
  %6 = vector.slice %3[17] : vector<24xi32> -> vector<2xi32>
  %7 = vector.slice %3[21] : vector<24xi32> -> vector<2xi32>
  %10 = vector.concat<0> %4, %5 : vector<2xi32>, vector<2xi32> -> vector<4xi32>
  %11 = vector.concat<0> %6, %7 : vector<2xi32>, vector<2xi32> -> vector<4xi32>
  %12 = vector.concat<0> %10, %11 : vector<4xi32>, vector<4xi32> -> vector<8xi32>
  %result = vector.bitcast %12 : vector<8xi32> to vector<2x2x2xi32>
  func.return %result : vector<2x2x2xi32>
}

// ====

// Captured rows share a runtime column while retaining their constant stride.
func.def @register_rectangle(%values: vector<2x4xi16>, %column: index) -> (vector<2x2xi16>) {
  %result = vector.slice %values[0, %column] : vector<2x4xi16> -> vector<2x2xi16>
  func.return %result : vector<2x2xi16>
}

// ----
func.def @register_rectangle(%values: vector<2x4xi16>, %column: index) -> (vector<2x2xi16>) {
  %4 = index.assume %column [range(%column, 0, 2)] : index
  %5 = vector.bitcast %values : vector<2x4xi16> to vector<8xi16>
  %21 = index.constant 1 : index
  %22 = index.cmp eq, %4, %21 : index
  %23 = index.constant 2 : index
  %24 = index.cmp eq, %4, %23 : index
  %25 = vector.slice %5[0] : vector<8xi16> -> vector<2xi16>
  %26 = vector.slice %5[1] : vector<8xi16> -> vector<2xi16>
  %27 = scf.select %22, %26, %25 : vector<2xi16>
  %28 = vector.slice %5[2] : vector<8xi16> -> vector<2xi16>
  %29 = scf.select %24, %28, %27 : vector<2xi16>
  %7 = index.constant 4 : index
  %8 = index.add %4, %7 : index
  %12 = index.constant 5 : index
  %13 = index.cmp eq, %8, %12 : index
  %14 = index.constant 6 : index
  %15 = index.cmp eq, %8, %14 : index
  %16 = vector.slice %5[4] : vector<8xi16> -> vector<2xi16>
  %17 = vector.slice %5[5] : vector<8xi16> -> vector<2xi16>
  %18 = scf.select %13, %17, %16 : vector<2xi16>
  %19 = vector.slice %5[6] : vector<8xi16> -> vector<2xi16>
  %20 = scf.select %15, %19, %18 : vector<2xi16>
  %10 = vector.concat<0> %29, %20 : vector<2xi16>, vector<2xi16> -> vector<4xi16>
  %result = vector.bitcast %10 : vector<4xi16> to vector<2x2xi16>
  func.return %result : vector<2x2xi16>
}

// ====

// Full-rank load origins compose with trailing slice axes. The leading batch,
// static column contribution, and cache policy survive the narrowed load.
func.def @composed_load_origins(%input: buffer, %batch: index, %row: index, %column: index) -> (vector<1x2xi16>) {
  %base = index.constant 0 : offset
  %view = buffer.view %input[%base] : buffer -> view<3x8x12xi16>
  %values = vector.load<type_disjoint> %view[%batch, %row, 2] {cache_scope = device, cache_temporal = non_temporal} : view<3x8x12xi16> -> vector<2x4xi16>
  %result = vector.slice %values[1, %column] : vector<2x4xi16> -> vector<1x2xi16>
  func.return %result : vector<1x2xi16>
}

// ----
func.def @composed_load_origins(%input: buffer, %batch: index, %row: index, %column: index) -> (vector<1x2xi16>) {
  %base = index.constant 0 : offset
  %view = buffer.view %input[%base] : buffer -> view<3x8x12xi16>
  %9 = index.constant 1 : index
  %10 = index.add %row, %9 : index
  %11 = index.constant 2 : index
  %12 = index.add %column, %11 : index
  %14 = vector.load<type_disjoint> %view[%batch, %10, %12] {cache_scope = device, cache_temporal = non_temporal} : view<3x8x12xi16> -> vector<2xi16>
  %result = vector.bitcast %14 : vector<2xi16> to vector<1x2xi16>
  func.return %result : vector<1x2xi16>
}

// ====

// Both the load and the crop can carry runtime origins on the same axes.
func.def @runtime_load_origins(%input: buffer, %load_row: index, %load_column: index, %row: index, %column: index) -> (vector<2x2xi32>) {
  %base = index.constant 0 : offset
  %view = buffer.view %input[%base] : buffer -> view<8x8xi32>
  %values = vector.load %view[%load_row, %load_column] : view<8x8xi32> -> vector<4x4xi32>
  %result = vector.slice %values[%row, %column] : vector<4x4xi32> -> vector<2x2xi32>
  func.return %result : vector<2x2xi32>
}

// ----
func.def @runtime_load_origins(%input: buffer, %load_row: index, %load_column: index, %row: index, %column: index) -> (vector<2x2xi32>) {
  %base = index.constant 0 : offset
  %view = buffer.view %input[%base] : buffer -> view<8x8xi32>
  %10 = index.add %load_row, %row : index
  %11 = index.add %load_column, %column : index
  %13 = vector.load %view[%10, %11] : view<8x8xi32> -> vector<2xi32>
  %14 = index.constant 1 : index
  %15 = index.add %10, %14 : index
  %16 = vector.load %view[%15, %11] : view<8x8xi32> -> vector<2xi32>
  %17 = vector.concat<0> %13, %16 : vector<2xi32>, vector<2xi32> -> vector<4xi32>
  %result = vector.bitcast %17 : vector<4xi32> to vector<2x2xi32>
  func.return %result : vector<2x2xi32>
}

// ====

// Another consumer retains the original loaded value and footprint.
func.def @shared_load(%input: buffer, %row: index, %column: index) -> (vector<2x4xi32>, vector<1x2xi32>) {
  %base = index.constant 0 : offset
  %view = buffer.view %input[%base] : buffer -> view<2x4xi32>
  %values = vector.load %view[0, 0] : view<2x4xi32> -> vector<2x4xi32>
  %result = vector.slice %values[%row, %column] : vector<2x4xi32> -> vector<1x2xi32>
  func.return %values, %result : vector<2x4xi32>, vector<1x2xi32>
}

// ----
func.def @shared_load(%input: buffer, %row: index, %column: index) -> (vector<2x4xi32>, vector<1x2xi32>) {
  %base = index.constant 0 : offset
  %view = buffer.view %input[%base] : buffer -> view<2x4xi32>
  %41 = view.bitcast %view : view<2x4xi32> -> view<8xi32>
  %42 = vector.load %41[0] : view<8xi32> -> vector<8xi32>
  %values = vector.bitcast %42 : vector<8xi32> to vector<2x4xi32>
  %9 = index.assume %row [range(%row, 0, 1)] : index
  %10 = index.assume %column [range(%column, 0, 2)] : index
  %11 = index.constant 4 : index
  %12 = index.madd %9, %11, %10 : index
  %16 = index.constant 1 : index
  %17 = index.cmp eq, %12, %16 : index
  %18 = index.constant 2 : index
  %19 = index.cmp eq, %12, %18 : index
  %20 = index.constant 3 : index
  %21 = index.cmp eq, %12, %20 : index
  %22 = index.constant 4 : index
  %23 = index.cmp eq, %12, %22 : index
  %24 = index.constant 5 : index
  %25 = index.cmp eq, %12, %24 : index
  %26 = index.constant 6 : index
  %27 = index.cmp eq, %12, %26 : index
  %28 = vector.slice %42[0] : vector<8xi32> -> vector<2xi32>
  %29 = vector.slice %42[1] : vector<8xi32> -> vector<2xi32>
  %30 = scf.select %17, %29, %28 : vector<2xi32>
  %31 = vector.slice %42[2] : vector<8xi32> -> vector<2xi32>
  %32 = scf.select %19, %31, %30 : vector<2xi32>
  %33 = vector.slice %42[3] : vector<8xi32> -> vector<2xi32>
  %34 = scf.select %21, %33, %32 : vector<2xi32>
  %35 = vector.slice %42[4] : vector<8xi32> -> vector<2xi32>
  %36 = scf.select %23, %35, %34 : vector<2xi32>
  %37 = vector.slice %42[5] : vector<8xi32> -> vector<2xi32>
  %38 = scf.select %25, %37, %36 : vector<2xi32>
  %39 = vector.slice %42[6] : vector<8xi32> -> vector<2xi32>
  %40 = scf.select %27, %39, %38 : vector<2xi32>
  %result = vector.bitcast %40 : vector<2xi32> to vector<1x2xi32>
  func.return %values, %result : vector<2x4xi32>, vector<1x2xi32>
}

// ====

// A write between the load and the crop must not change the selected snapshot.
func.def @write_barrier(%input: buffer, %row: index, %column: index, %replacement: i32) -> (vector<1x2xi32>) {
  %base = index.constant 0 : offset
  %view = buffer.view %input[%base] : buffer -> view<2x4xi32>
  %values = vector.load %view[0, 0] : view<2x4xi32> -> vector<2x4xi32>
  view.store %replacement, %view[0, 0] : i32, view<2x4xi32>
  %result = vector.slice %values[%row, %column] : vector<2x4xi32> -> vector<1x2xi32>
  func.return %result : vector<1x2xi32>
}

// ----
func.def @write_barrier(%input: buffer, %row: index, %column: index, %replacement: i32) -> (vector<1x2xi32>) {
  %base = index.constant 0 : offset
  %view = buffer.view %input[%base] : buffer -> view<2x4xi32>
  %41 = view.bitcast %view : view<2x4xi32> -> view<8xi32>
  %42 = vector.load %41[0] : view<8xi32> -> vector<8xi32>
  view.store %replacement, %view[0, 0] : i32, view<2x4xi32>
  %9 = index.assume %row [range(%row, 0, 1)] : index
  %10 = index.assume %column [range(%column, 0, 2)] : index
  %11 = index.constant 4 : index
  %12 = index.madd %9, %11, %10 : index
  %16 = index.constant 1 : index
  %17 = index.cmp eq, %12, %16 : index
  %18 = index.constant 2 : index
  %19 = index.cmp eq, %12, %18 : index
  %20 = index.constant 3 : index
  %21 = index.cmp eq, %12, %20 : index
  %22 = index.constant 4 : index
  %23 = index.cmp eq, %12, %22 : index
  %24 = index.constant 5 : index
  %25 = index.cmp eq, %12, %24 : index
  %26 = index.constant 6 : index
  %27 = index.cmp eq, %12, %26 : index
  %28 = vector.slice %42[0] : vector<8xi32> -> vector<2xi32>
  %29 = vector.slice %42[1] : vector<8xi32> -> vector<2xi32>
  %30 = scf.select %17, %29, %28 : vector<2xi32>
  %31 = vector.slice %42[2] : vector<8xi32> -> vector<2xi32>
  %32 = scf.select %19, %31, %30 : vector<2xi32>
  %33 = vector.slice %42[3] : vector<8xi32> -> vector<2xi32>
  %34 = scf.select %21, %33, %32 : vector<2xi32>
  %35 = vector.slice %42[4] : vector<8xi32> -> vector<2xi32>
  %36 = scf.select %23, %35, %34 : vector<2xi32>
  %37 = vector.slice %42[5] : vector<8xi32> -> vector<2xi32>
  %38 = scf.select %25, %37, %36 : vector<2xi32>
  %39 = vector.slice %42[6] : vector<8xi32> -> vector<2xi32>
  %40 = scf.select %27, %39, %38 : vector<2xi32>
  %result = vector.bitcast %40 : vector<2xi32> to vector<1x2xi32>
  func.return %result : vector<1x2xi32>
}

// ====

// Every lane of a volatile load remains observable, even when the crop uses
// only two lanes of its result.
func.def @volatile_footprint(%input: buffer, %row: index, %column: index) -> (vector<1x2xi32>) {
  %base = index.constant 0 : offset
  %view = buffer.view %input[%base] : buffer -> view<2x4xi32>
  %values = vector.load<volatile> %view[0, 0] : view<2x4xi32> -> vector<2x4xi32>
  %result = vector.slice %values[%row, %column] : vector<2x4xi32> -> vector<1x2xi32>
  func.return %result : vector<1x2xi32>
}

// ----
func.def @volatile_footprint(%input: buffer, %row: index, %column: index) -> (vector<1x2xi32>) {
  %base = index.constant 0 : offset
  %view = buffer.view %input[%base] : buffer -> view<2x4xi32>
  %40 = view.bitcast %view : view<2x4xi32> -> view<8xi32>
  %41 = vector.load<volatile> %40[0] : view<8xi32> -> vector<8xi32>
  %8 = index.assume %row [range(%row, 0, 1)] : index
  %9 = index.assume %column [range(%column, 0, 2)] : index
  %10 = index.constant 4 : index
  %11 = index.madd %8, %10, %9 : index
  %15 = index.constant 1 : index
  %16 = index.cmp eq, %11, %15 : index
  %17 = index.constant 2 : index
  %18 = index.cmp eq, %11, %17 : index
  %19 = index.constant 3 : index
  %20 = index.cmp eq, %11, %19 : index
  %21 = index.constant 4 : index
  %22 = index.cmp eq, %11, %21 : index
  %23 = index.constant 5 : index
  %24 = index.cmp eq, %11, %23 : index
  %25 = index.constant 6 : index
  %26 = index.cmp eq, %11, %25 : index
  %27 = vector.slice %41[0] : vector<8xi32> -> vector<2xi32>
  %28 = vector.slice %41[1] : vector<8xi32> -> vector<2xi32>
  %29 = scf.select %16, %28, %27 : vector<2xi32>
  %30 = vector.slice %41[2] : vector<8xi32> -> vector<2xi32>
  %31 = scf.select %18, %30, %29 : vector<2xi32>
  %32 = vector.slice %41[3] : vector<8xi32> -> vector<2xi32>
  %33 = scf.select %20, %32, %31 : vector<2xi32>
  %34 = vector.slice %41[4] : vector<8xi32> -> vector<2xi32>
  %35 = scf.select %22, %34, %33 : vector<2xi32>
  %36 = vector.slice %41[5] : vector<8xi32> -> vector<2xi32>
  %37 = scf.select %24, %36, %35 : vector<2xi32>
  %38 = vector.slice %41[6] : vector<8xi32> -> vector<2xi32>
  %39 = scf.select %26, %38, %37 : vector<2xi32>
  %result = vector.bitcast %39 : vector<2xi32> to vector<1x2xi32>
  func.return %result : vector<1x2xi32>
}

// ====

// The selected read cannot cross an acquire fence.
func.def @fence_barrier(%input: buffer, %row: index, %column: index) -> (vector<1x2xi32>) {
  %base = index.constant 0 : offset
  %view = buffer.view %input[%base] : buffer -> view<2x4xi32>
  %values = vector.load %view[0, 0] : view<2x4xi32> -> vector<2x4xi32>
  buffer.fence scope(system) ordering(acquire)
  %result = vector.slice %values[%row, %column] : vector<2x4xi32> -> vector<1x2xi32>
  func.return %result : vector<1x2xi32>
}

// ----
func.def @fence_barrier(%input: buffer, %row: index, %column: index) -> (vector<1x2xi32>) {
  %base = index.constant 0 : offset
  %view = buffer.view %input[%base] : buffer -> view<2x4xi32>
  %40 = view.bitcast %view : view<2x4xi32> -> view<8xi32>
  %41 = vector.load %40[0] : view<8xi32> -> vector<8xi32>
  buffer.fence scope(system) ordering(acquire)
  %8 = index.assume %row [range(%row, 0, 1)] : index
  %9 = index.assume %column [range(%column, 0, 2)] : index
  %10 = index.constant 4 : index
  %11 = index.madd %8, %10, %9 : index
  %15 = index.constant 1 : index
  %16 = index.cmp eq, %11, %15 : index
  %17 = index.constant 2 : index
  %18 = index.cmp eq, %11, %17 : index
  %19 = index.constant 3 : index
  %20 = index.cmp eq, %11, %19 : index
  %21 = index.constant 4 : index
  %22 = index.cmp eq, %11, %21 : index
  %23 = index.constant 5 : index
  %24 = index.cmp eq, %11, %23 : index
  %25 = index.constant 6 : index
  %26 = index.cmp eq, %11, %25 : index
  %27 = vector.slice %41[0] : vector<8xi32> -> vector<2xi32>
  %28 = vector.slice %41[1] : vector<8xi32> -> vector<2xi32>
  %29 = scf.select %16, %28, %27 : vector<2xi32>
  %30 = vector.slice %41[2] : vector<8xi32> -> vector<2xi32>
  %31 = scf.select %18, %30, %29 : vector<2xi32>
  %32 = vector.slice %41[3] : vector<8xi32> -> vector<2xi32>
  %33 = scf.select %20, %32, %31 : vector<2xi32>
  %34 = vector.slice %41[4] : vector<8xi32> -> vector<2xi32>
  %35 = scf.select %22, %34, %33 : vector<2xi32>
  %36 = vector.slice %41[5] : vector<8xi32> -> vector<2xi32>
  %37 = scf.select %24, %36, %35 : vector<2xi32>
  %38 = vector.slice %41[6] : vector<8xi32> -> vector<2xi32>
  %39 = scf.select %26, %38, %37 : vector<2xi32>
  %result = vector.bitcast %39 : vector<2xi32> to vector<1x2xi32>
  func.return %result : vector<1x2xi32>
}

// ====

// An intervening region may write the input. Slicing the earlier SSA value
// still observes the load before either branch executes.
func.def @region_barrier(%input: buffer, %row: index, %column: index, %replace: i1, %replacement: i32) -> (vector<1x2xi32>) {
  %base = index.constant 0 : offset
  %view = buffer.view %input[%base] : buffer -> view<2x4xi32>
  %values = vector.load %view[0, 0] : view<2x4xi32> -> vector<2x4xi32>
  scf.if %replace {
    view.store %replacement, %view[0, 0] : i32, view<2x4xi32>
  }
  %result = vector.slice %values[%row, %column] : vector<2x4xi32> -> vector<1x2xi32>
  func.return %result : vector<1x2xi32>
}

// ----
func.def @region_barrier(%input: buffer, %row: index, %column: index, %replace: i1, %replacement: i32) -> (vector<1x2xi32>) {
  %base = index.constant 0 : offset
  %view = buffer.view %input[%base] : buffer -> view<2x4xi32>
  %42 = view.bitcast %view : view<2x4xi32> -> view<8xi32>
  %43 = vector.load %42[0] : view<8xi32> -> vector<8xi32>
  scf.if %replace {
    view.store %replacement, %view[0, 0] : i32, view<2x4xi32>
  }
  %10 = index.assume %row [range(%row, 0, 1)] : index
  %11 = index.assume %column [range(%column, 0, 2)] : index
  %12 = index.constant 4 : index
  %13 = index.madd %10, %12, %11 : index
  %17 = index.constant 1 : index
  %18 = index.cmp eq, %13, %17 : index
  %19 = index.constant 2 : index
  %20 = index.cmp eq, %13, %19 : index
  %21 = index.constant 3 : index
  %22 = index.cmp eq, %13, %21 : index
  %23 = index.constant 4 : index
  %24 = index.cmp eq, %13, %23 : index
  %25 = index.constant 5 : index
  %26 = index.cmp eq, %13, %25 : index
  %27 = index.constant 6 : index
  %28 = index.cmp eq, %13, %27 : index
  %29 = vector.slice %43[0] : vector<8xi32> -> vector<2xi32>
  %30 = vector.slice %43[1] : vector<8xi32> -> vector<2xi32>
  %31 = scf.select %18, %30, %29 : vector<2xi32>
  %32 = vector.slice %43[2] : vector<8xi32> -> vector<2xi32>
  %33 = scf.select %20, %32, %31 : vector<2xi32>
  %34 = vector.slice %43[3] : vector<8xi32> -> vector<2xi32>
  %35 = scf.select %22, %34, %33 : vector<2xi32>
  %36 = vector.slice %43[4] : vector<8xi32> -> vector<2xi32>
  %37 = scf.select %24, %36, %35 : vector<2xi32>
  %38 = vector.slice %43[5] : vector<8xi32> -> vector<2xi32>
  %39 = scf.select %26, %38, %37 : vector<2xi32>
  %40 = vector.slice %43[6] : vector<8xi32> -> vector<2xi32>
  %41 = scf.select %28, %40, %39 : vector<2xi32>
  %result = vector.bitcast %41 : vector<2xi32> to vector<1x2xi32>
  func.return %result : vector<1x2xi32>
}

// ====

// An explicit packet tuple keeps its private snapshot strategy. Both windows
// share the staged values while the complete tuple retains its original uses.
func.def @argument_snapshot(%left: vector<4xi32>, %right: vector<4xi32>, %position: index) -> (vector<8xi32>, vector<2xi32>, vector<2xi32>) {
  %source = vector.concat<0> %left, %right : vector<4xi32>, vector<4xi32> -> vector<8xi32>
  %c2 = index.constant 2 : index
  %tail_position = index.add %position, %c2 : index
  %head = vector.slice %source[%position] : vector<8xi32> -> vector<2xi32>
  %tail = vector.slice %source[%tail_position] : vector<8xi32> -> vector<2xi32>
  func.return %source, %head, %tail : vector<8xi32>, vector<2xi32>, vector<2xi32>
}

// ----
func.def @argument_snapshot(%left: vector<4xi32>, %right: vector<4xi32>, %position: index) -> (vector<8xi32>, vector<2xi32>, vector<2xi32>) {
  %11 = index.constant 32 : offset
  %12 = buffer.alloca<private> align(16) %11 : buffer
  %13 = index.constant 0 : offset
  %14 = buffer.view %12[%13] : buffer -> view<8xi32>
  vector.store %left, %14[0] : vector<4xi32>, view<8xi32>
  vector.store %right, %14[4] : vector<4xi32>, view<8xi32>
  %source = vector.concat<0> %left, %right : vector<4xi32>, vector<4xi32> -> vector<8xi32>
  %c2 = index.constant 2 : index
  %tail_position = index.add %position, %c2 : index
  %head = vector.load %14[%position] : view<8xi32> -> vector<2xi32>
  %tail = vector.load %14[%tail_position] : view<8xi32> -> vector<2xi32>
  func.return %source, %head, %tail : vector<8xi32>, vector<2xi32>, vector<2xi32>
}

// ====

// A native loop argument is a captured bank, not a replayable producer. Range
// facts bound the window choices without unrolling the user loop or staging it.
func.def @loop_window(%initial: vector<4xi32>, %count: index) -> (vector<4xi32>) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c3 = index.constant 3 : index
  %seed = scalar.constant 0 : i32
  %result = scf.for %iteration = [%c0 to %count step %c1](%bank = %initial : vector<4xi32>) -> (vector<4xi32>) {
    %position = index.rem %iteration, %c3 : index
    %window = vector.slice %bank[%position] : vector<4xi32> -> vector<2xi32>
    %sum = vector.reduce<addi> %window, %seed : vector<2xi32>, i32
    %next = vector.insert %sum into %bank[0] : i32, vector<4xi32>
    scf.yield %next : vector<4xi32>
  }
  func.return %result : vector<4xi32>
}

// ----
func.def @loop_window(%initial: vector<4xi32>, %count: index) -> (vector<4xi32>) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c3 = index.constant 3 : index
  %seed = scalar.constant 0 : i32
  %result = scf.for %iteration = [%c0 to %count step %c1](%bank = %initial : vector<4xi32>) -> (vector<4xi32>) {
    %position = index.rem %iteration, %c3 : index
    %14 = index.constant 1 : index
    %15 = index.cmp eq, %position, %14 : index
    %16 = index.constant 2 : index
    %17 = index.cmp eq, %position, %16 : index
    %18 = vector.slice %bank[0] : vector<4xi32> -> vector<2xi32>
    %19 = vector.slice %bank[1] : vector<4xi32> -> vector<2xi32>
    %20 = scf.select %15, %19, %18 : vector<2xi32>
    %21 = vector.slice %bank[2] : vector<4xi32> -> vector<2xi32>
    %window = scf.select %17, %21, %20 : vector<2xi32>
    %sum = vector.reduce<addi> %window, %seed : vector<2xi32>, i32
    %next = vector.insert %sum into %bank[0] : i32, vector<4xi32>
    scf.yield %next : vector<4xi32>
  }
  func.return %result : vector<4xi32>
}

// ====

// Row updates keep a larger aggregate partitioned, so later plane extracts
// do not retain oversized prefix/suffix carriers.
func.def @updated_planes(%first: vector<8xf32>, %last: vector<8xf32>) -> (vector<4x8xf32>, vector<4x8xf32>) {
  %seed = vector.splatf 1.0 : vector<2x4x8xf32>
  %head = vector.insert %first into %seed[0, 0] : vector<8xf32>, vector<2x4x8xf32>
  %updated = vector.insert %last into %head[1, 3] : vector<8xf32>, vector<2x4x8xf32>
  %first_plane = vector.extract %updated[0] : vector<2x4x8xf32> -> vector<4x8xf32>
  %last_plane = vector.extract %updated[1] : vector<2x4x8xf32> -> vector<4x8xf32>
  func.return %first_plane, %last_plane : vector<4x8xf32>, vector<4x8xf32>
}

// ----
func.def @updated_planes(%first: vector<8xf32>, %last: vector<8xf32>) -> (vector<4x8xf32>, vector<4x8xf32>) {
  %53 = vector.splatf 1.0 : vector<8xf32>
  %52 = vector.splatf 1.0 : vector<8xf32>
  %44 = vector.concat<0> %first, %53 : vector<8xf32>, vector<8xf32> -> vector<16xf32>
  %51 = vector.splatf 1.0 : vector<16xf32>
  %48 = vector.concat<0> %44, %51 : vector<16xf32>, vector<16xf32> -> vector<32xf32>
  %43 = vector.splatf 1.0 : vector<16xf32>
  %39 = vector.concat<0> %52, %last : vector<8xf32>, vector<8xf32> -> vector<16xf32>
  %41 = vector.concat<0> %43, %39 : vector<16xf32>, vector<16xf32> -> vector<32xf32>
  %first_plane = vector.bitcast %48 : vector<32xf32> to vector<4x8xf32>
  %last_plane = vector.bitcast %41 : vector<32xf32> to vector<4x8xf32>
  func.return %first_plane, %last_plane : vector<4x8xf32>, vector<4x8xf32>
}
