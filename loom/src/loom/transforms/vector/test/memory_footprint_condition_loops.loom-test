// ====

// RUN: pass vector-memory-footprint

func.def @nested_condition_loops(%output: buffer, %enabled: i1) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %rows = index.constant 3 : index
  %columns = index.constant 4 : index
  %base = index.constant 0 : offset
  %aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %view = buffer.view %aligned[%base] : buffer -> view<12xi32>
  %row_end = scf.while(%row_before = %begin : index) -> (index) {
    %more_rows = index.cmp slt, %row_before, %rows : index
    scf.condition %more_rows, %row_before : i1, index
  } do(%row: index) {
    %row_base = index.mul %row, %columns : index
    %column_end = scf.while(%column_before = %begin : index) -> (index) {
      %more_columns = index.cmp ult, %column_before, %columns : index
      scf.condition %more_columns, %column_before : i1, index
    } do(%column: index) {
      scf.if %enabled {
        %position = index.add %row_base, %column : index
        %value = index.cast %position : index to i32
        view.store %value, %view[%position] : i32, view<12xi32>
      } else {
      }
      %next_column = index.add %column, %step : index
      scf.yield %next_column : index
    }
    %next_row = index.add %row, %step : index
    scf.yield %next_row : index
  }
  func.return
}

// ====
// RUN: pass vector-memory-footprint

// The true edge turns a dynamic unsigned comparison into both a nonnegative
// lower bound and a symbolic upper bound for the forwarded body argument.
func.def @dynamic_unsigned_body(%output: buffer, %initial: i64, %raw_length: i64) {
  %c4 = scalar.constant 4 : i64
  %c1 = scalar.constant 1 : i64
  %count = scalar.shrui %raw_length, %c4 : i64
  %extent = index.cast %count : i64 to index
  %origin = index.constant 0 : offset
  %view = buffer.view %output[%origin] : buffer -> view<[%extent]xi8>
  %value = scalar.constant 7 : i8
  %terminal = scf.while(%before = %initial : i64) -> (i64) {
    %active = scalar.cmpi ult, %before, %count : i64
    scf.condition %active, %before : i1, i64
  } do(%position: i64) {
    %index = index.cast %position : i64 to index
    view.store %value, %view[%index] : i8, view<[%extent]xi8>
    %advanced = scalar.addi %position, %c1 : i64
    %wrapped = scalar.cmpi ult, %advanced, %position : i64
    %next = scf.select %wrapped, %count, %advanced : i64
    scf.yield %next : i64
  }
  func.return
}

