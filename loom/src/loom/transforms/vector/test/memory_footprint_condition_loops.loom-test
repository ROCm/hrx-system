// ====

// RUN: pass vector-memory-footprint

// The outer body relation remains active through an inner condition region and
// its nested structured control flow.
func.def @nested_dynamic_condition_scope(%output: buffer, %initial: i64, %raw_length: i64, %enabled: i1) {
  %c4 = scalar.constant 4 : i64
  %c1 = scalar.constant 1 : i64
  %count = scalar.shrui %raw_length, %c4 : i64
  %extent = index.cast %count : i64 to index
  %origin = index.constant 0 : offset
  %view = buffer.view %output[%origin] : buffer -> view<[%extent]xi8>
  %value = scalar.constant 7 : i8
  %terminal = scf.while(%before = %initial : i64) -> (i64) {
    %active = scalar.cmpi ult, %before, %count : i64
    scf.condition %active, %before : i1, i64
  } do(%position: i64) {
    %inner_terminal = scf.while(%inner_before = %position : i64) -> (i64) {
      scf.if %enabled {
        %index = index.cast %position : i64 to index
        view.store %value, %view[%index] : i8, view<[%extent]xi8>
      } else {
      }
      %inner_active = scalar.cmpi ult, %inner_before, %position : i64
      scf.condition %inner_active, %inner_before : i1, i64
    } do(%inner_position: i64) {
      scf.yield %inner_position : i64
    }
    %advanced = scalar.addi %position, %c1 : i64
    scf.yield %advanced : i64
  }
  func.return
}

// ====

// RUN: pass vector-memory-footprint

// The compound true edge retains the exact loop-derived coordinate bound.
amdgpu.target<gfx942> @cdna {subgroup_size = 64}

kernel.def target(@cdna) @cfg_loop_compound_store_guard() {
  %unit = index.constant 1 : index
  %threads = index.constant 256 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%output: buffer, %initial: index) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c7 = index.constant 7 : index
  %c15 = index.constant 15 : index
  %c32 = index.constant 32 : index
  %bound = index.constant 1048576 : index
  %loop_bound = index.constant 67117056 : index
  %base = index.constant 0 : offset
  %value = scalar.constant 0 : i32
  %aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %view = buffer.view %aligned[%base] : buffer -> view<1x1048576xi32>
  %lane = kernel.subgroup.lane.id : index
  %head = index.andi %lane, %c15 : index
  %quarter = index.shrui %lane, %c4 : index
  %leader = index.cmp eq, %quarter, %c0 : index
  cfg.br ^loop(%initial: index)
^loop(%position: index):
  %more = index.cmp ult, %position, %loop_bound : index
  cfg.cond_br %more, ^body, ^exit
^body:
  %panel = index.assume %position [range(%position, 0, 67117055)] : index
  %first = index.shli %panel, %c7 : index
  %wave = kernel.subgroup.id : index
  %lane_column = index.madd %wave, %c32, %head : index
  %column = index.add %first, %lane_column : index
  %within = index.cmp ult, %column, %bound : index
  %writer = scalar.andi %leader, %within : i1
  cfg.cond_br %writer, ^store, ^advance
^store:
  view.store %value, %view[%c0, %column] : i32, view<1x1048576xi32>
  cfg.br ^advance
^advance:
  %next = index.add %position, %c1 : index
  cfg.br ^loop(%next: index)
^exit:
  kernel.return
}
