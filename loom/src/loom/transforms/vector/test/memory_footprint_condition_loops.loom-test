// RUN: pass vector-memory-footprint

// One condition value may project onto multiple body arguments.
func.def @dynamic_unsigned_duplicate_payload(%output: buffer, %initial: i64, %raw_length: i64) {
  %c4 = scalar.constant 4 : i64
  %c1 = scalar.constant 1 : i64
  %count = scalar.shrui %raw_length, %c4 : i64
  %extent = index.cast %count : i64 to index
  %origin = index.constant 0 : offset
  %view = buffer.view %output[%origin] : buffer -> view<[%extent]xi8>
  %value = scalar.constant 7 : i8
  %terminal0, %terminal1 = scf.while(%before = %initial : i64) -> (i64, i64) {
    %active = scalar.cmpi ult, %before, %count : i64
    scf.condition %active, %before, %before : i1, i64, i64
  } do(%left: i64, %right: i64) {
    %left_index = index.cast %left : i64 to index
    %right_index = index.cast %right : i64 to index
    view.store %value, %view[%left_index] : i8, view<[%extent]xi8>
    view.store %value, %view[%right_index] : i8, view<[%extent]xi8>
    %advanced = scalar.addi %left, %c1 : i64
    scf.yield %advanced : i64
  }
  func.return
}

// ====

// RUN: pass vector-memory-footprint

// Relations between two duplicated condition values stay factorized while any
// pair of their body arguments can consume the proof.
func.def @dynamic_unsigned_duplicate_pair(%output: buffer, %raw_position: i64, %raw_length: i64) {
  %c4 = scalar.constant 4 : i64
  %c1 = scalar.constant 1 : i64
  %initial_position = scalar.shrui %raw_position, %c4 : i64
  %initial_count = scalar.shrui %raw_length, %c4 : i64
  %terminal_position0, %terminal_position1, %terminal_count0, %terminal_count1 = scf.while(%before_position = %initial_position : i64, %before_count = %initial_count : i64) -> (i64, i64, i64, i64) {
    %active = scalar.cmpi ult, %before_position, %before_count : i64
    scf.condition %active, %before_position, %before_position, %before_count, %before_count : i1, i64, i64, i64, i64
  } do(%position0: i64, %position1: i64, %count0: i64, %count1: i64) {
    %extent = index.cast %count1 : i64 to index
    %origin = index.constant 0 : offset
    %view = buffer.view %output[%origin] : buffer -> view<[%extent]xi8>
    %index = index.cast %position1 : i64 to index
    %value = scalar.constant 7 : i8
    view.store %value, %view[%index] : i8, view<[%extent]xi8>
    %advanced = scalar.addi %position0, %c1 : i64
    %wrapped = scalar.cmpi ult, %advanced, %position0 : i64
    %next = scf.select %wrapped, %count0, %advanced : i64
    scf.yield %next, %count0 : i64, i64
  }
  func.return
}

