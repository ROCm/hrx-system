  %acc = vector.bitcast %accumulator : vector<2xf32> to vector<2x1xf32>
  %dot = vector.dot4f8<bf8fp8> %left, %right, %acc : vector<2x1xi32>, vector<2x1xf32>
  %result = vector.bitcast %dot : vector<2x1xf32> to vector<2xf32>
  func.return %result : vector<2xf32>
}

