// RUN: pass target-legalize{mode=eager,policy=require-native},canonicalize,dce

amdgpu.target<gfx950> @target

func.def target(@target) @half_pairs(%lhs: vector<4xbf16>, %rhs: vector<4xbf16>, %accumulator: vector<2xf32>) -> (vector<2xf32>) {
  %left = vector.bitcast %lhs : vector<4xbf16> to vector<2x2xbf16>
  %right = vector.bitcast %rhs : vector<4xbf16> to vector<2x2xbf16>
  %acc = vector.bitcast %accumulator : vector<2xf32> to vector<2x1xf32>
  %dot = vector.dot2f %left, %right, %acc : vector<2x2xbf16>, vector<2x2xbf16>, vector<2x1xf32>
  %result = vector.bitcast %dot : vector<2x1xf32> to vector<2xf32>
  func.return %result : vector<2xf32>
}

// ----
amdgpu.target<gfx950> @target

func.def target(@target) @half_pairs(%lhs: vector<4xbf16>, %rhs: vector<4xbf16>, %accumulator: vector<2xf32>) -> (vector<2xf32>) {
  %12 = vector.dot2f %lhs, %rhs, %accumulator : vector<4xbf16>, vector<4xbf16>, vector<2xf32>
  func.return %12 : vector<2xf32>
}

