// ====
// RUN: pass target-legalize{mode=eager},canonicalize,dce

x86.target<avx512> @target {features = [avx512vnni]}

func.def target(@target) @byte_dot_with_tail(%left_head: vector<64xi8>, %left_tail: vector<32xi8>, %right_head: vector<64xi8>, %right_tail: vector<32xi8>, %head_acc: vector<16xi32>, %tail_acc: vector<8xi32>) -> (i32) {
  %left = vector.concat<0> %left_head, %left_tail : vector<64xi8>, vector<32xi8> -> vector<96xi8>
  %right = vector.concat<0> %right_head, %right_tail : vector<64xi8>, vector<32xi8> -> vector<96xi8>
  %acc = vector.concat<0> %head_acc, %tail_acc : vector<16xi32>, vector<8xi32> -> vector<24xi32>
  %dot = vector.dot4i<u8s8> %left, %right, %acc : vector<96xi8>, vector<96xi8>, vector<24xi32>
  %first = vector.extract %dot[0] : vector<24xi32> -> i32
  %last = vector.extract %dot[23] : vector<24xi32> -> i32
  %result = scalar.subi %first, %last : i32
  func.return %result : i32
}

// ----
x86.target<avx512> @target {features = [avx512vnni]}

func.def target(@target) @byte_dot_with_tail(%left_head: vector<64xi8>, %left_tail: vector<32xi8>, %right_head: vector<64xi8>, %right_tail: vector<32xi8>, %head_acc: vector<16xi32>, %tail_acc: vector<8xi32>) -> (i32) {
  %17 = vector.dot4i<u8s8> %left_head, %right_head, %head_acc : vector<64xi8>, vector<64xi8>, vector<16xi32>
  %21 = vector.dot4i<u8s8> %left_tail, %right_tail, %tail_acc : vector<32xi8>, vector<32xi8>, vector<8xi32>
  %first = vector.extract %17[0] : vector<16xi32> -> i32
  %last = vector.extract %21[7] : vector<8xi32> -> i32
  %result = scalar.subi %first, %last : i32
  func.return %result : i32
}
