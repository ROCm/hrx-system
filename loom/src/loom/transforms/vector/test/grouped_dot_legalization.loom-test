amdgpu.target<gfx1201> @target

func.def target(@target) @float_byte_groups(%lhs: vector<2xi32>, %rhs: vector<2xi32>, %accumulator: vector<2xf32>) -> (vector<2xf32>) {
  %left = vector.bitcast %lhs : vector<2xi32> to vector<2x1xi32>
