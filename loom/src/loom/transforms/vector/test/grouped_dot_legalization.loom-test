func.def target(@target) @byte_groups(%lhs: vector<8xi8>, %rhs: vector<8xi8>, %accumulator: vector<2xi32>) -> (vector<2xi32>) {
  %left = vector.bitcast %lhs : vector<8xi8> to vector<2x4xi8>
  %right = vector.bitcast %rhs : vector<8xi8> to vector<2x4xi8>
  %acc = vector.bitcast %accumulator : vector<2xi32> to vector<2x1xi32>
  %dot = vector.dot4i<u8s8> %left, %right, %acc : vector<2x4xi8>, vector<2x4xi8>, vector<2x1xi32>
  %result = vector.bitcast %dot : vector<2x1xi32> to vector<2xi32>
  func.return %result : vector<2xi32>
}

