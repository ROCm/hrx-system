// ----
func.def @offset_to_offset(%values: vector<2x2xoffset>, %position: index) -> (offset) {
  %5 = index.constant 2 : index
  %6 = index.rem %position, %5 : index
  %7 = index.constant 2 : index
  %8 = index.div %position, %7 : index
  %result = vector.extract %values[%8, %6] : vector<2x2xoffset> -> offset
