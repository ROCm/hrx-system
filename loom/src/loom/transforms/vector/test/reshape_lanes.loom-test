// RUN: with-checks pass vector-to-scalar,canonicalize,dce

// Across the complete equal-width type matrix, each projection selects one
// whole source element without a per-bit loop. Coordinate and operand wiring
// are checked exactly below; numerical window scenarios check the result bits.
func.def @i1_to_i1(%values: vector<2x2xi1>, %position: index) -> (i1) {
  %flat = vector.bitcast %values : vector<2x2xi1> to vector<4xi1>
  %result = vector.extract %flat[%position] : vector<4xi1> -> i1
  func.return %result : i1
}

