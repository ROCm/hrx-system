// ====

// RUN: pass vector-to-scalar,canonicalize,dce

// Runtime source and result extents preserve element boundaries too.
func.def @dependent_shape(%extent: index, %values: vector<2x[%extent]xi16>, %row: index, %column: index) -> (f16) {
  %shaped = vector.bitcast %values : vector<2x[%extent]xi16> to vector<[%extent]x2xf16>
  %result = vector.extract %shaped[%row, %column] : vector<[%extent]x2xf16> -> f16
  func.return %result : f16
}

// ----
func.def @dependent_shape(%extent: index, %values: vector<2x[%extent]xi16>, %row: index, %column: index) -> (f16) {
  %7 = index.constant 2 : index
  %14 = index.madd %row, %7, %column : index
  %10 = index.rem %14, %extent : index
  %11 = index.div %14, %extent : index
  %12 = vector.extract %values[%11, %10] : vector<2x[%extent]xi16> -> i16
  %result = scalar.bitcast %12 : i16 to f16
  func.return %result : f16
}

// ====

// RUN: pass vector-to-scalar,canonicalize,dce

// A static coordinate through a reshape still selects a single whole lane.
func.def @static_shape(%values: vector<2x2xi64>) -> (f64) {
  %flat = vector.bitcast %values : vector<2x2xi64> to vector<4xf64>
  %result = vector.extract %flat[2] : vector<4xf64> -> f64
  func.return %result : f64
}

// ----
func.def @static_shape(%values: vector<2x2xi64>) -> (f64) {
  %4 = vector.extract %values[1, 0] : vector<2x2xi64> -> i64
  %result = scalar.bitcast %4 : i64 to f64
  func.return %result : f64
}
