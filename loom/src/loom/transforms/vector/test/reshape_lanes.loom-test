// ----
CHECK-COUNT-29: * = vector.extract *
CHECK-NOT: *scf.for *

// ====

// RUN: pass vector-to-scalar,canonicalize,dce

func.def @i1_to_i1(%values: vector<2x2xi1>, %position: index) -> (i1) {
  %flat = vector.bitcast %values : vector<2x2xi1> to vector<4xi1>
  %result = vector.extract %flat[%position] : vector<4xi1> -> i1
  func.return %result : i1
}

// ----
func.def @i1_to_i1(%values: vector<2x2xi1>, %position: index) -> (i1) {
  %5 = index.constant 2 : index
  %6 = index.rem %position, %5 : index
  %7 = index.constant 2 : index
  %8 = index.div %position, %7 : index
  %result = vector.extract %values[%8, %6] : vector<2x2xi1> -> i1
  func.return %result : i1
}

// ====

// RUN: pass vector-to-scalar,canonicalize,dce

func.def @i8_to_f8e4m3(%values: vector<2x2xi8>, %position: index) -> (f8E4M3) {
  %flat = vector.bitcast %values : vector<2x2xi8> to vector<4xf8E4M3>
  %result = vector.extract %flat[%position] : vector<4xf8E4M3> -> f8E4M3
  func.return %result : f8E4M3
}

// ----
func.def @i8_to_f8e4m3(%values: vector<2x2xi8>, %position: index) -> (f8E4M3) {
  %5 = index.constant 2 : index
  %6 = index.rem %position, %5 : index
  %7 = index.constant 2 : index
  %8 = index.div %position, %7 : index
  %9 = vector.extract %values[%8, %6] : vector<2x2xi8> -> i8
  %result = scalar.bitcast %9 : i8 to f8E4M3
  func.return %result : f8E4M3
}

