// RUN: pass vector-memory-footprint

// Quotient and remainder roles must survive a paired operation. The product
// guard bounds the row, and the divisor bounds the column.
func.def @decode_paired_dynamic_coordinates(%input: buffer, %rows_input: index, %columns_input: index, %linear_input: index) {
  %rows = index.assume %rows_input [range(%rows_input, 1, 64)] : index
  %columns = index.assume %columns_input [range(%columns_input, 1, 64)] : index
  %linear = index.assume %linear_input [range(%linear_input, 0, 4095)] : index
  %base = index.constant 0 : offset
  %count = index.mul %rows, %columns : index
  %view = buffer.view %input[%base] : buffer -> view<[%rows]x[%columns]xi32>
  %live = index.cmp ult, %linear, %count : index
  scf.if %live {
    %row, %column = index.divrem %linear, %columns : index
    %value = view.load %view[%row, %column] : view<[%rows]x[%columns]xi32> -> i32
    test.use %value : i32
  }
  func.return
}

// ====

func.def @decode_si_8(%input: buffer, %rows_input: i8, %columns_input: i8, %linear_input: i8) {
  %rows = scalar.assume %rows_input [range(%rows_input, 1, 8)] : i8
  %columns = scalar.assume %columns_input [range(%columns_input, 1, 8)] : i8
  %linear = scalar.assume %linear_input [range(%linear_input, 0, 63)] : i8
  %base = index.constant 0 : offset
  %count = scalar.muli %rows, %columns : i8
  %rows_index = index.cast %rows : i8 to index
  %columns_index = index.cast %columns : i8 to index
  %view = buffer.view %input[%base] : buffer -> view<[%rows_index]x[%columns_index]xi32>
  %live = scalar.cmpi slt, %linear, %count : i8
  scf.if %live {
    %row_bits, %column_bits = scalar.divremsi %linear, %columns : i8
    %row = index.cast %row_bits : i8 to index
    %column = index.cast %column_bits : i8 to index
    %value = view.load %view[%row, %column] : view<[%rows_index]x[%columns_index]xi32> -> i32
    test.use %value : i32
  }
  func.return
}

