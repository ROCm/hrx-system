func.def @paired_integer_extension_i8_to_i32(%input: vector<4xi8>) -> (vector<4xi32>, vector<4xi32>) {
  %signed_values = vector.extsi %input : vector<4xi8> to vector<4xi32>
  %unsigned_values = vector.extui %input : vector<4xi8> to vector<4xi32>
  func.return %signed_values, %unsigned_values : vector<4xi32>, vector<4xi32>
}

// ----
func.def @paired_integer_extension_i8_to_i32(%input: vector<4xi8>) -> (vector<4xi32>, vector<4xi32>) {
  %14 = vector.extract %input[0] : vector<4xi8> -> i8
  %15 = scalar.extsi %14 : i8 to i32
  %16 = vector.extract %input[1] : vector<4xi8> -> i8
  %17 = scalar.extsi %16 : i8 to i32
  %18 = vector.extract %input[2] : vector<4xi8> -> i8
  %19 = scalar.extsi %18 : i8 to i32
  %20 = vector.extract %input[3] : vector<4xi8> -> i8
  %21 = scalar.extsi %20 : i8 to i32
  %signed_values = vector.from_elements %15, %17, %19, %21 : vector<4xi32>
  %5 = vector.extract %input[0] : vector<4xi8> -> i8
  %6 = scalar.extui %5 : i8 to i32
  %7 = vector.extract %input[1] : vector<4xi8> -> i8
  %8 = scalar.extui %7 : i8 to i32
  %9 = vector.extract %input[2] : vector<4xi8> -> i8
  %10 = scalar.extui %9 : i8 to i32
  %11 = vector.extract %input[3] : vector<4xi8> -> i8
  %12 = scalar.extui %11 : i8 to i32
  %unsigned_values = vector.from_elements %6, %8, %10, %12 : vector<4xi32>
  func.return %signed_values, %unsigned_values : vector<4xi32>, vector<4xi32>
}

