  %11 = scalar.extsi %10 : i16 to i64
  %12 = vector.extract %input[1] : vector<2xi16> -> i16
  %13 = scalar.extsi %12 : i16 to i64
  %signed_values = vector.from_elements %11, %13 : vector<2xi64>
  %5 = vector.extract %input[0] : vector<2xi16> -> i16
  %6 = scalar.extui %5 : i16 to i64
  %7 = vector.extract %input[1] : vector<2xi16> -> i16
  %8 = scalar.extui %7 : i16 to i64
