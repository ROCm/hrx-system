          %33 = vector.extract %lhs_data[%14, %19, %30] : vector<[%blocks]x[%m]x[%k]xf32> -> f32
          %34 = vector.extract %rhs_data[%14, %30, %24] : vector<[%blocks]x[%k]x[%n]xf32> -> f32
