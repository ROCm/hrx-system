func.def @preserves_dynamic_rank2_mma_store_snapshots(%m: index, %n: index, %k: index, %lhs_buffer: buffer, %rhs_buffer: buffer, %init_buffer: buffer, %out_buffer: buffer) {
  %base = index.constant 0 : offset
  %origin = index.constant 0 : index
  %layout = encoding.layout.dense : encoding<layout>
  %lhs_view = buffer.view %lhs_buffer[%base] : buffer -> view<[%m]x[%k]xf32, %layout>
  %rhs_view = buffer.view %rhs_buffer[%base] : buffer -> view<[%k]x[%n]xf32, %layout>
  %init_view = buffer.view %init_buffer[%base] : buffer -> view<[%m]x[%n]xf32, %layout>
  %out_view = buffer.view %out_buffer[%base] : buffer -> view<[%m]x[%n]xf32, %layout>
  %lhs_data = vector.load %lhs_view[%origin, %origin] : view<[%m]x[%k]xf32, %layout> -> vector<[%m]x[%k]xf32>
  %rhs_data = vector.load %rhs_view[%origin, %origin] : view<[%k]x[%n]xf32, %layout> -> vector<[%k]x[%n]xf32>
  %init_data = vector.load %init_view[%origin, %origin] : view<[%m]x[%n]xf32, %layout> -> vector<[%m]x[%n]xf32>
  %lhs = vector.fragment<lhs> %lhs_data shape [%m, %k] : vector<[%m]x[%k]xf32>
  %rhs = vector.fragment<rhs> %rhs_data shape [%k, %n] : vector<[%k]x[%n]xf32>
  %init = vector.fragment<init> %init_data shape [%m, %n] : vector<[%m]x[%n]xf32>
  %result = vector.mma %lhs, %rhs, %init : vector<[%m]x[%k]xf32>, vector<[%k]x[%n]xf32>, vector<[%m]x[%n]xf32>
  vector.store %result, %out_view[%origin, %origin] : vector<[%m]x[%n]xf32>, view<[%m]x[%n]xf32, %layout>
  func.return
}

// ----
func.def @preserves_dynamic_rank2_mma_store_snapshots(%m: index, %n: index, %k: index, %lhs_buffer: buffer, %rhs_buffer: buffer, %init_buffer: buffer, %out_buffer: buffer) {
  %base = index.constant 0 : offset
  %lhs_view = buffer.view %lhs_buffer[%base] : buffer -> view<[%m]x[%k]xf32>
  %rhs_view = buffer.view %rhs_buffer[%base] : buffer -> view<[%k]x[%n]xf32>
  %init_view = buffer.view %init_buffer[%base] : buffer -> view<[%m]x[%n]xf32>
  %out_view = buffer.view %out_buffer[%base] : buffer -> view<[%m]x[%n]xf32>
  %62 = vector.constant 0.0 : vector<[%m]x[%k]xf32>
  %63 = index.constant 0 : index
  %64 = index.constant 1 : index
  %lhs_data = scf.for %65 = [%63 to %m step %64](%66 = %62 : vector<[%m]x[%k]xf32>) -> (vector<[%m]x[%k]xf32>) {
    %68 = index.constant 0 : index
    %69 = index.constant 1 : index
    %72 = scf.for %70 = [%68 to %k step %69](%71 = %66 : vector<[%m]x[%k]xf32>) -> (vector<[%m]x[%k]xf32>) {
      %73 = view.load %lhs_view[%65, %70] : view<[%m]x[%k]xf32> -> f32
      %74 = vector.insert %73 into %71[%65, %70] : f32, vector<[%m]x[%k]xf32>
      scf.yield %74 : vector<[%m]x[%k]xf32>
    }
    scf.yield %72 : vector<[%m]x[%k]xf32>
  }
  %49 = vector.constant 0.0 : vector<[%k]x[%n]xf32>
  %50 = index.constant 0 : index
  %51 = index.constant 1 : index
  %rhs_data = scf.for %52 = [%50 to %k step %51](%53 = %49 : vector<[%k]x[%n]xf32>) -> (vector<[%k]x[%n]xf32>) {
    %55 = index.constant 0 : index
    %56 = index.constant 1 : index
    %59 = scf.for %57 = [%55 to %n step %56](%58 = %53 : vector<[%k]x[%n]xf32>) -> (vector<[%k]x[%n]xf32>) {
      %60 = view.load %rhs_view[%52, %57] : view<[%k]x[%n]xf32> -> f32
      %61 = vector.insert %60 into %58[%52, %57] : f32, vector<[%k]x[%n]xf32>
      scf.yield %61 : vector<[%k]x[%n]xf32>
    }
    scf.yield %59 : vector<[%k]x[%n]xf32>
  }
  %36 = vector.constant 0.0 : vector<[%m]x[%n]xf32>
  %37 = index.constant 0 : index
  %38 = index.constant 1 : index
  %init_data = scf.for %39 = [%37 to %m step %38](%40 = %36 : vector<[%m]x[%n]xf32>) -> (vector<[%m]x[%n]xf32>) {
    %42 = index.constant 0 : index
    %43 = index.constant 1 : index
    %46 = scf.for %44 = [%42 to %n step %43](%45 = %40 : vector<[%m]x[%n]xf32>) -> (vector<[%m]x[%n]xf32>) {
      %47 = view.load %init_view[%39, %44] : view<[%m]x[%n]xf32> -> f32
      %48 = vector.insert %47 into %45[%39, %44] : f32, vector<[%m]x[%n]xf32>
      scf.yield %48 : vector<[%m]x[%n]xf32>
    }
    scf.yield %46 : vector<[%m]x[%n]xf32>
  }
  %21 = index.constant 0 : index
  %22 = index.constant 1 : index
  scf.for %23 = [%21 to %m step %22] {
    %24 = index.constant 0 : index
    %25 = index.constant 1 : index
    scf.for %26 = [%24 to %n step %25] {
      %27 = vector.extract %init_data[%23, %26] : vector<[%m]x[%n]xf32> -> f32
      %28 = index.constant 0 : index
      %29 = index.constant 1 : index
      %32 = scf.for %30 = [%28 to %k step %29](%31 = %27 : f32) -> (f32) {
        %33 = vector.extract %lhs_data[%23, %30] : vector<[%m]x[%k]xf32> -> f32
        %34 = vector.extract %rhs_data[%30, %26] : vector<[%k]x[%n]xf32> -> f32
        %35 = scalar.fmaf %33, %34, %31 : f32
        scf.yield %35 : f32
      }
      view.store %32, %out_view[%23, %26] : f32, view<[%m]x[%n]xf32>
    }
  }
  func.return
}

