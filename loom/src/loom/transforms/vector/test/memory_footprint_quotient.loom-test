// RUN: pass vector-memory-footprint

// A flattened coordinate guarded by its complete product extent proves the
// quotient is inside the dynamic row extent without an authored alias.
func.def @guarded_product_quotient_proves_dynamic_axis_bound(%payload: buffer, %base: offset, %linear0: index, %row_count0: index, %column_count0: index, %value: i32) {
  %linear = index.assume %linear0 [range(%linear0, 0, 65535)] : index
  %row_count = index.assume %row_count0 [range(%row_count0, 1, 256)] : index
  %column_count = index.assume %column_count0 [range(%column_count0, 1, 256)] : index
  %element_count = index.mul %row_count, %column_count : index
  %in_bounds = index.cmp ult, %linear, %element_count : index
  scf.if %in_bounds {
    %row = index.div %linear, %column_count : index
    %view = buffer.view %payload[%base] : buffer -> view<[%row_count]xi32>
    view.store %value, %view[%row] : i32, view<[%row_count]xi32>
  }
  func.return
}

// ====

// A strict bound between two non-negative coordinates remains strict after
// dividing both by the same scale when the upper coordinate is divisible by
// that scale.
func.def @guarded_matching_quotients_prove_dynamic_axis_bound(%payload: buffer, %base: offset, %channel0: index, %width0: index, %value: i32) {
  %channel = index.assume %channel0 [range(%channel0, 0, 255)] : index
  %width = index.assume %width0 [range(%width0, 16, 256), multiple_of(%width0, 16)] : index
  %tile = index.constant 16 : index
  %group_count = index.div %width, %tile : index
  %in_bounds = index.cmp ult, %channel, %width : index
  scf.if %in_bounds {
    %group = index.div %channel, %tile : index
    %view = buffer.view %payload[%base] : buffer -> view<[%group_count]xi32>
    view.store %value, %view[%group] : i32, view<[%group_count]xi32>
  }
  func.return
}

// ====

// Without divisibility, values in the upper coordinate's final partial tile
// can map to the first group beyond its floor-divided view extent.
func.def @guarded_matching_quotients_require_divisible_upper(%payload: buffer, %base: offset, %channel0: index, %width0: index, %value: i32) {
  %channel = index.assume %channel0 [range(%channel0, 0, 255)] : index
  %width = index.assume %width0 [range(%width0, 16, 255)] : index
  %tile = index.constant 16 : index
  %group_count = index.div %width, %tile : index
  %in_bounds = index.cmp ult, %channel, %width : index
  scf.if %in_bounds {
    %group = index.div %channel, %tile : index
    %view = buffer.view %payload[%base] : buffer -> view<[%group_count]xi32>
    // ERROR@+1: SUBRANGE/024 {op_name="view.store", view_axis="0"}
    view.store %value, %view[%group] : i32, view<[%group_count]xi32>
  }
  func.return
}

// ====

// RUN: pass scf-to-cfg,vector-memory-footprint

// CFG lowering retains the product guard in the operand-indexed path facts.
func.def @guarded_product_quotient_proves_dynamic_axis_bound_cfg(%payload: buffer, %base: offset, %linear0: index, %row_count0: index, %column_count0: index, %value: i32) {
  %linear = index.assume %linear0 [range(%linear0, 0, 65535)] : index
  %row_count = index.assume %row_count0 [range(%row_count0, 1, 256)] : index
  %column_count = index.assume %column_count0 [range(%column_count0, 1, 256)] : index
  %element_count = index.mul %row_count, %column_count : index
  %in_bounds = index.cmp ult, %linear, %element_count : index
  scf.if %in_bounds {
    %row = index.div %linear, %column_count : index
    %view = buffer.view %payload[%base] : buffer -> view<[%row_count]xi32>
    view.store %value, %view[%row] : i32, view<[%row_count]xi32>
  }
  func.return
}

// ----
func.def @guarded_product_quotient_proves_dynamic_axis_bound_cfg(%payload: buffer, %base: offset, %linear0: index, %row_count0: index, %column_count0: index, %value: i32) {
  %linear = index.assume %linear0 [range(%linear0, 0, 65535)] : index
  %row_count = index.assume %row_count0 [range(%row_count0, 1, 256)] : index
  %column_count = index.assume %column_count0 [range(%column_count0, 1, 256)] : index
  %element_count = index.mul %row_count, %column_count : index
  %in_bounds = index.cmp ult, %linear, %element_count : index
  cfg.cond_br %in_bounds, ^_bb1, ^_bb2
^_bb1:
  %row = index.div %linear, %column_count : index
  %view = buffer.view %payload[%base] : buffer -> view<[%row_count]xi32>
  view.store %value, %view[%row] : i32, view<[%row_count]xi32>
  cfg.br ^_bb2
^_bb2:
  func.return
}

// ====

// RUN: pass canonicalize,scf-to-cfg,vector-memory-footprint

// Canonicalization rewrites division by a power of two to a shift while the
// product guard remains a multiplication. Both spellings carry the same scale.
func.def @canonicalized_power_of_two_quotient_proves_dynamic_axis_bound(%payload: buffer, %base: offset, %linear0: index, %row_count0: index, %value: i32) {
  %linear = index.assume %linear0 [range(%linear0, 0, 65535)] : index
  %row_count = index.assume %row_count0 [range(%row_count0, 1, 256)] : index
  %column_count = index.constant 4 : index
  %element_count = index.mul %row_count, %column_count : index
  %in_bounds = index.cmp ult, %linear, %element_count : index
  scf.if %in_bounds {
    %row = index.div %linear, %column_count : index
    %view = buffer.view %payload[%base] : buffer -> view<[%row_count]xi32>
    view.store %value, %view[%row] : i32, view<[%row_count]xi32>
  }
  func.return
}

// ----
func.def @canonicalized_power_of_two_quotient_proves_dynamic_axis_bound(%payload: buffer, %base: offset, %linear0: index, %row_count0: index, %value: i32) {
  %linear = index.assume %linear0 [range(%linear0, 0, 65535)] : index
  %row_count = index.assume %row_count0 [range(%row_count0, 1, 256)] : index
  %column_count = index.constant 4 : index
  %element_count = index.mul %row_count, %column_count : index
  %in_bounds = index.cmp ult, %linear, %element_count : index
  cfg.cond_br %in_bounds, ^_bb1, ^_bb2
^_bb1:
  %14 = index.assume %linear [lt(%linear, %element_count)] : index
  %12 = index.constant 2 : index
  %row = index.shrui %14, %12 : index
  %view = buffer.view %payload[%base] : buffer -> view<[%row_count]xi32>
  view.store %value, %view[%row] : i32, view<[%row_count]xi32>
  cfg.br ^_bb2
^_bb2:
  func.return
}

// ====

// An explicitly shifted extent has the same product/quotient proof.
func.def @guarded_shifted_quotient_proves_dynamic_axis_bound(%payload: buffer, %base: offset, %linear0: index, %row_count0: index, %value: i32) {
  %linear = index.assume %linear0 [range(%linear0, 0, 65535)] : index
  %row_count = index.assume %row_count0 [range(%row_count0, 1, 256)] : index
  %shift = index.constant 2 : index
  %element_count = index.shli %row_count, %shift : index
  %in_bounds = index.cmp ult, %linear, %element_count : index
  scf.if %in_bounds {
    %row = index.shrui %linear, %shift : index
    %view = buffer.view %payload[%base] : buffer -> view<[%row_count]xi32>
    view.store %value, %view[%row] : i32, view<[%row_count]xi32>
  }
  func.return
}

// ====

// A different right-shift scale is not licensed by the guarded extent.
func.def @guarded_shifted_quotient_rejects_distinct_scale(%payload: buffer, %base: offset, %linear0: index, %row_count0: index, %value: i32) {
  %linear = index.assume %linear0 [range(%linear0, 0, 65535)] : index
  %row_count = index.assume %row_count0 [range(%row_count0, 1, 256)] : index
  %extent_shift = index.constant 3 : index
  %quotient_shift = index.constant 2 : index
  %element_count = index.shli %row_count, %extent_shift : index
  %in_bounds = index.cmp ult, %linear, %element_count : index
  scf.if %in_bounds {
    %row = index.shrui %linear, %quotient_shift : index
    %view = buffer.view %payload[%base] : buffer -> view<[%row_count]xi32>
    // ERROR@+1: SUBRANGE/024 {op_name="view.store", view_axis="0"}
    view.store %value, %view[%row] : i32, view<[%row_count]xi32>
  }
  func.return
}

// ====

// The strict quotient bound does not prove that the following row exists.
func.def @guarded_product_quotient_rejects_extra_row(%payload: buffer, %base: offset, %linear0: index, %row_count0: index, %column_count0: index, %value: i32) {
  %linear = index.assume %linear0 [range(%linear0, 0, 65535)] : index
  %row_count = index.assume %row_count0 [range(%row_count0, 1, 256)] : index
  %column_count = index.assume %column_count0 [range(%column_count0, 1, 256)] : index
  %c1 = index.constant 1 : index
  %element_count = index.mul %row_count, %column_count : index
  %in_bounds = index.cmp ult, %linear, %element_count : index
  scf.if %in_bounds {
    %row = index.div %linear, %column_count : index
    %next_row = index.add %row, %c1 : index
    %view = buffer.view %payload[%base] : buffer -> view<[%row_count]xi32>
    // ERROR@+1: SUBRANGE/024 {op_name="view.store", view_axis="0"}
    view.store %value, %view[%next_row] : i32, view<[%row_count]xi32>
  }
  func.return
}

// ====

// A non-strict flattened guard admits linear == rows * columns, whose
// quotient is exactly the first invalid row.
func.def @guarded_nonstrict_product_rejects_quotient_bound(%payload: buffer, %base: offset, %linear0: index, %row_count0: index, %column_count0: index, %value: i32) {
  %linear = index.assume %linear0 [range(%linear0, 0, 65535)] : index
  %row_count = index.assume %row_count0 [range(%row_count0, 1, 256)] : index
  %column_count = index.assume %column_count0 [range(%column_count0, 1, 256)] : index
  %element_count = index.mul %row_count, %column_count : index
  %maybe_in_bounds = index.cmp ule, %linear, %element_count : index
  scf.if %maybe_in_bounds {
    %row = index.div %linear, %column_count : index
    %view = buffer.view %payload[%base] : buffer -> view<[%row_count]xi32>
    // ERROR@+1: SUBRANGE/024 {op_name="view.store", view_axis="0"}
    view.store %value, %view[%row] : i32, view<[%row_count]xi32>
  }
  func.return
}

// ====

// RUN: pass vector-memory-footprint

// Runtime widths computed from a shift retain the same strict quotient proof
// in standalone and paired division, with the guard written in reverse order.
func.def @runtime_power_groups(%input: buffer, %channel_input: index, %width_input: index, %kind_input: index) {
  %channel = index.assume %channel_input [range(%channel_input, 0, 65)] : index
  %width = index.assume %width_input [range(%width_input, 16, 64), multiple_of(%width_input, 16)] : index
  %kind = index.assume %kind_input [range(%kind_input, 0, 4)] : index
  %unit = index.constant 1 : index
  %tile = index.shli %unit, %kind : index
  %groups = index.div %width, %tile : index
  %paired_groups, %width_tail = index.divrem %width, %tile : index
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<[%groups]xi32>
  %paired_source = buffer.view %input[%base] : buffer -> view<[%paired_groups]xi32>
  %active = index.cmp ugt, %width, %channel : index
  scf.if %active {
    %group = index.div %channel, %tile : index
    %paired_group, %channel_tail = index.divrem %channel, %tile : index
    %first = view.load %source[%paired_group] : view<[%groups]xi32> -> i32
    %second = view.load %paired_source[%group] : view<[%paired_groups]xi32> -> i32
    test.use %first, %second : i32, i32
  }
  func.return
}

// ====

// An interval endpoint need not be a power of two: every admitted divisor
// in [1, 31] divides 16. Signed/unsigned and standalone/paired forms agree.
func.def @dynamic_power_groups_i8(%input: buffer, %channel_input: i8, %width_input: i8, %tile_input: i8) {
  %channel = scalar.assume %channel_input [range(%channel_input, 0, 65)] : i8
  %width = scalar.assume %width_input [range(%width_input, 16, 64), multiple_of(%width_input, 16)] : i8
  %tile = scalar.assume %tile_input [range(%tile_input, 1, 31), power_of_two(%tile_input)] : i8
  %groups_bits = scalar.divsi %width, %tile : i8
  %paired_groups_bits, %width_tail = scalar.divremui %width, %tile : i8
  %groups = index.cast %groups_bits : i8 to index
  %paired_groups = index.cast %paired_groups_bits : i8 to index
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<[%groups]xi32>
  %paired_source = buffer.view %input[%base] : buffer -> view<[%paired_groups]xi32>
  %active = scalar.cmpi slt, %channel, %width : i8
  scf.if %active {
    %signed_bits = scalar.divsi %channel, %tile : i8
    %unsigned_bits = scalar.divui %channel, %tile : i8
    %signed_pair_bits, %signed_tail = scalar.divremsi %channel, %tile : i8
    %unsigned_pair_bits, %unsigned_tail = scalar.divremui %channel, %tile : i8
    %signed = index.cast %signed_bits : i8 to index
    %unsigned = index.cast %unsigned_bits : i8 to index
    %signed_pair = index.cast %signed_pair_bits : i8 to index
    %unsigned_pair = index.cast %unsigned_pair_bits : i8 to index
    %signed_value = view.load %source[%signed] : view<[%groups]xi32> -> i32
    %unsigned_value = view.load %paired_source[%unsigned] : view<[%paired_groups]xi32> -> i32
    %signed_pair_value = view.load %source[%signed_pair] : view<[%groups]xi32> -> i32
    %unsigned_pair_value = view.load %paired_source[%unsigned_pair] : view<[%paired_groups]xi32> -> i32
    test.use %signed_value, %unsigned_value, %signed_pair_value, %unsigned_pair_value : i32, i32, i32, i32
  }
  func.return
}

