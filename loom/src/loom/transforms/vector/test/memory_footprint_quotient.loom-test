// ====

// A general positive divisor need not divide the aligned width: channel 31,
// width 32, and divisor 3 produce equal quotients.
func.def @missing_power(%input: buffer, %channel_input: index, %width_input: index, %tile_input: index) {
  %channel = index.assume %channel_input [range(%channel_input, 0, 65)] : index
  %width = index.assume %width_input [range(%width_input, 16, 64), multiple_of(%width_input, 16)] : index
  %tile = index.assume %tile_input [range(%tile_input, 1, 16)] : index
  %groups = index.div %width, %tile : index
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<[%groups]xi32>
  %active = index.cmp ult, %channel, %width : index
  scf.if %active {
    %group = index.div %channel, %tile : index
    // ERROR@+1: SUBRANGE/024 {op_name="view.load", view_axis="0"}
    %value = view.load %source[%group] : view<[%groups]xi32> -> i32
    test.use %value : i32
  }
  func.return
}

// ====

// Alignment to eight does not suffice for a possible divisor of sixteen:
// channel 23 and width 24 both produce group one.
func.def @incomplete_groups(%input: buffer, %channel_input: index, %width_input: index, %tile_input: index) {
  %channel = index.assume %channel_input [range(%channel_input, 0, 65)] : index
  %width = index.assume %width_input [range(%width_input, 16, 64), multiple_of(%width_input, 8)] : index
  %tile = index.assume %tile_input [range(%tile_input, 1, 16), power_of_two(%tile_input)] : index
  %groups = index.div %width, %tile : index
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<[%groups]xi32>
  %active = index.cmp ult, %channel, %width : index
  scf.if %active {
    %group = index.div %channel, %tile : index
    // ERROR@+1: SUBRANGE/024 {op_name="view.load", view_axis="0"}
    %value = view.load %source[%group] : view<[%groups]xi32> -> i32
    test.use %value : i32
  }
  func.return
}

// ====

// Two independent power-of-two divisors need not be equal, even when they
// have identical numeric facts.
func.def @distinct_divisors(%input: buffer, %channel_input: index, %width_input: index, %tile_input: index, %other_input: index) {
  %channel = index.assume %channel_input [range(%channel_input, 0, 65)] : index
  %width = index.assume %width_input [range(%width_input, 16, 64), multiple_of(%width_input, 16)] : index
  %tile = index.assume %tile_input [range(%tile_input, 1, 16), power_of_two(%tile_input)] : index
  %other = index.assume %other_input [range(%other_input, 1, 16), power_of_two(%other_input)] : index
  %groups = index.div %width, %tile : index
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<[%groups]xi32>
  %active = index.cmp ult, %channel, %width : index
  scf.if %active {
    %group = index.div %channel, %other : index
    // ERROR@+1: SUBRANGE/024 {op_name="view.load", view_axis="0"}
    %value = view.load %source[%group] : view<[%groups]xi32> -> i32
    test.use %value : i32
  }
  func.return
}

// ====

// The nonstrict guard admits the extent itself, whose quotient is exactly
// the first invalid group.
func.def @nonstrict_guard(%input: buffer, %channel_input: index, %width_input: index, %tile_input: index) {
  %channel = index.assume %channel_input [range(%channel_input, 0, 65)] : index
  %width = index.assume %width_input [range(%width_input, 16, 64), multiple_of(%width_input, 16)] : index
  %tile = index.assume %tile_input [range(%tile_input, 1, 16), power_of_two(%tile_input)] : index
  %groups = index.div %width, %tile : index
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<[%groups]xi32>
  %active = index.cmp ule, %channel, %width : index
  scf.if %active {
    %group = index.div %channel, %tile : index
    // ERROR@+1: SUBRANGE/024 {op_name="view.load", view_axis="0"}
    %value = view.load %source[%group] : view<[%groups]xi32> -> i32
    test.use %value : i32
  }
  func.return
}

// ====

// A large divisor stays in the signed fact carrier. The interval endpoint
// deliberately includes seven values above its greatest possible power of two.
func.def @full_width_power_group(%input: buffer, %channel_input: index, %width_input: index, %tile_input: index) {
  %channel = index.assume %channel_input [range(%channel_input, 0, 4611686018427387904)] : index
  %width = index.assume %width_input [range(%width_input, 2305843009213693952, 4611686018427387904), multiple_of(%width_input, 2305843009213693952)] : index
  %tile = index.assume %tile_input [range(%tile_input, 1, 2305843009213693959), power_of_two(%tile_input)] : index
  %groups = index.div %width, %tile : index
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<[%groups]xi8>
  %active = index.cmp ult, %channel, %width : index
  scf.if %active {
    %group = index.div %channel, %tile : index
    %value = view.load %source[%group] : view<[%groups]xi8> -> i8
    test.use %value : i8
  }
  func.return
}
