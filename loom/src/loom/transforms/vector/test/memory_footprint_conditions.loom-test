// RUN: pass vector-memory-footprint

// The bounds relation is retained even when independent predicates exceed
// the derivation result capacity.
func.def @partial_guard_relations_keep_dynamic_bounds(%storage: buffer, %base: offset, %raw: index, %bound_raw: index, %predicate0: i1, %predicate1: i1, %predicate2: i1, %predicate3: i1, %predicate4: i1, %predicate5: i1, %predicate6: i1, %predicate7: i1, %predicate8: i1, %predicate9: i1, %predicate10: i1, %predicate11: i1, %predicate12: i1, %predicate13: i1, %predicate14: i1, %predicate15: i1, %predicate16: i1, %predicate17: i1, %predicate18: i1, %predicate19: i1, %predicate20: i1, %predicate21: i1, %predicate22: i1, %predicate23: i1, %predicate24: i1, %predicate25: i1, %predicate26: i1, %predicate27: i1, %predicate28: i1, %predicate29: i1, %predicate30: i1, %predicate31: i1) {
  %origin = index.assume %raw [range(%raw, 0, 63)] : index
  %bound = index.assume %bound_raw [range(%bound_raw, 1, 64)] : index
  %view = buffer.view %storage[%base] : buffer -> view<[%bound]xi32>
  %fits = index.cmp slt, %origin, %bound : index
  %guard0 = scalar.andi %fits, %predicate0 : i1
  %guard1 = scalar.andi %guard0, %predicate1 : i1
  %guard2 = scalar.andi %guard1, %predicate2 : i1
  %guard3 = scalar.andi %guard2, %predicate3 : i1
  %guard4 = scalar.andi %guard3, %predicate4 : i1
  %guard5 = scalar.andi %guard4, %predicate5 : i1
  %guard6 = scalar.andi %guard5, %predicate6 : i1
  %guard7 = scalar.andi %guard6, %predicate7 : i1
  %guard8 = scalar.andi %guard7, %predicate8 : i1
  %guard9 = scalar.andi %guard8, %predicate9 : i1
  %guard10 = scalar.andi %guard9, %predicate10 : i1
  %guard11 = scalar.andi %guard10, %predicate11 : i1
  %guard12 = scalar.andi %guard11, %predicate12 : i1
  %guard13 = scalar.andi %guard12, %predicate13 : i1
  %guard14 = scalar.andi %guard13, %predicate14 : i1
  %guard15 = scalar.andi %guard14, %predicate15 : i1
  %guard16 = scalar.andi %guard15, %predicate16 : i1
  %guard17 = scalar.andi %guard16, %predicate17 : i1
  %guard18 = scalar.andi %guard17, %predicate18 : i1
  %guard19 = scalar.andi %guard18, %predicate19 : i1
  %guard20 = scalar.andi %guard19, %predicate20 : i1
  %guard21 = scalar.andi %guard20, %predicate21 : i1
  %guard22 = scalar.andi %guard21, %predicate22 : i1
  %guard23 = scalar.andi %guard22, %predicate23 : i1
  %guard24 = scalar.andi %guard23, %predicate24 : i1
  %guard25 = scalar.andi %guard24, %predicate25 : i1
  %guard26 = scalar.andi %guard25, %predicate26 : i1
  %guard27 = scalar.andi %guard26, %predicate27 : i1
  %guard28 = scalar.andi %guard27, %predicate28 : i1
  %guard29 = scalar.andi %guard28, %predicate29 : i1
  %guard30 = scalar.andi %guard29, %predicate30 : i1
  %guard31 = scalar.andi %guard30, %predicate31 : i1
  scf.if %guard31 {
    %loaded = vector.load %view[%origin] : view<[%bound]xi32> -> vector<1xi32>
    test.use %loaded : vector<1xi32>
  }
  func.return
}

// ====

// Retaining a sound subset does not make those relations available to the
// other arm or after the join.
func.def @partial_guard_relations_stay_in_selected_scope(%storage: buffer, %base: offset, %raw: index, %bound_raw: index, %predicate0: i1, %predicate1: i1, %predicate2: i1, %predicate3: i1, %predicate4: i1, %predicate5: i1, %predicate6: i1, %predicate7: i1, %predicate8: i1, %predicate9: i1, %predicate10: i1, %predicate11: i1, %predicate12: i1, %predicate13: i1, %predicate14: i1, %predicate15: i1, %predicate16: i1, %predicate17: i1, %predicate18: i1, %predicate19: i1, %predicate20: i1, %predicate21: i1, %predicate22: i1, %predicate23: i1, %predicate24: i1, %predicate25: i1, %predicate26: i1, %predicate27: i1, %predicate28: i1, %predicate29: i1, %predicate30: i1, %predicate31: i1) {
  %origin = index.assume %raw [range(%raw, 0, 63)] : index
  %bound = index.assume %bound_raw [range(%bound_raw, 1, 64)] : index
  %view = buffer.view %storage[%base] : buffer -> view<[%bound]xi32>
  %fits = index.cmp slt, %origin, %bound : index
  %guard0 = scalar.andi %fits, %predicate0 : i1
  %guard1 = scalar.andi %guard0, %predicate1 : i1
  %guard2 = scalar.andi %guard1, %predicate2 : i1
  %guard3 = scalar.andi %guard2, %predicate3 : i1
  %guard4 = scalar.andi %guard3, %predicate4 : i1
  %guard5 = scalar.andi %guard4, %predicate5 : i1
  %guard6 = scalar.andi %guard5, %predicate6 : i1
  %guard7 = scalar.andi %guard6, %predicate7 : i1
  %guard8 = scalar.andi %guard7, %predicate8 : i1
  %guard9 = scalar.andi %guard8, %predicate9 : i1
  %guard10 = scalar.andi %guard9, %predicate10 : i1
  %guard11 = scalar.andi %guard10, %predicate11 : i1
  %guard12 = scalar.andi %guard11, %predicate12 : i1
  %guard13 = scalar.andi %guard12, %predicate13 : i1
  %guard14 = scalar.andi %guard13, %predicate14 : i1
  %guard15 = scalar.andi %guard14, %predicate15 : i1
  %guard16 = scalar.andi %guard15, %predicate16 : i1
  %guard17 = scalar.andi %guard16, %predicate17 : i1
  %guard18 = scalar.andi %guard17, %predicate18 : i1
  %guard19 = scalar.andi %guard18, %predicate19 : i1
  %guard20 = scalar.andi %guard19, %predicate20 : i1
  %guard21 = scalar.andi %guard20, %predicate21 : i1
  %guard22 = scalar.andi %guard21, %predicate22 : i1
  %guard23 = scalar.andi %guard22, %predicate23 : i1
  %guard24 = scalar.andi %guard23, %predicate24 : i1
  %guard25 = scalar.andi %guard24, %predicate25 : i1
  %guard26 = scalar.andi %guard25, %predicate26 : i1
  %guard27 = scalar.andi %guard26, %predicate27 : i1
  %guard28 = scalar.andi %guard27, %predicate28 : i1
  %guard29 = scalar.andi %guard28, %predicate29 : i1
  %guard30 = scalar.andi %guard29, %predicate30 : i1
  %guard31 = scalar.andi %guard30, %predicate31 : i1
  scf.if %guard31 {
    %loaded = vector.load %view[%origin] : view<[%bound]xi32> -> vector<1xi32>
    test.use %loaded : vector<1xi32>
  } else {
    // ERROR@+1: SUBRANGE/011 {op_name="vector.load", vector_extent="1"}
    %other = vector.load %view[%origin] : view<[%bound]xi32> -> vector<1xi32>
    test.use %other : vector<1xi32>
  }
  // ERROR@+1: SUBRANGE/011 {op_name="vector.load", vector_extent="1"}
  %joined = vector.load %view[%origin] : view<[%bound]xi32> -> vector<1xi32>
  test.use %joined : vector<1xi32>
  func.return
}

// ====

// A weaker fact before an equality cannot weaken the incoming edge.
func.def @join_weak_then_equal(%storage: buffer, %base: offset, %raw: index, %path: i1) {
  %c0 = index.constant 0 : index
  %origin = index.assume %raw [range(%raw, -1, 1)] : index
  %view = buffer.view %storage[%base] : buffer -> view<1xi32>
  %equal = index.cmp eq, %origin, %c0 : index
  %nonnegative = index.cmp sge, %origin, %c0 : index
  %combined = scalar.andi %nonnegative, %equal : i1
  cfg.cond_br %path, ^left, ^right
^left:
  cfg.cond_br %equal, ^join, ^exit
^right:
  cfg.cond_br %combined, ^join, ^exit
^join:
  %loaded = vector.load %view[%origin] : view<1xi32> -> vector<1xi32>
  test.use %loaded : vector<1xi32>
  cfg.br ^exit
^exit:
  func.return
}

// ====

// Two inequalities on an incoming edge jointly preserve an equality.
func.def @join_complementary(%storage: buffer, %base: offset, %raw: index, %path: i1) {
  %c0 = index.constant 0 : index
  %origin = index.assume %raw [range(%raw, -1, 1)] : index
  %view = buffer.view %storage[%base] : buffer -> view<1xi32>
  %equal = index.cmp eq, %origin, %c0 : index
  %nonnegative = index.cmp sge, %origin, %c0 : index
  %nonpositive = index.cmp sle, %origin, %c0 : index
  %combined = scalar.andi %nonnegative, %nonpositive : i1
  cfg.cond_br %path, ^left, ^right
^left:
  cfg.cond_br %equal, ^join, ^exit
^right:
  cfg.cond_br %combined, ^join, ^exit
^join:
  %loaded = vector.load %view[%origin] : view<1xi32> -> vector<1xi32>
  test.use %loaded : vector<1xi32>
  cfg.br ^exit
^exit:
  func.return
}

// ====

// Reordering an equality and its weaker consequence preserves the same join.
func.def @join_equal_then_weak(%storage: buffer, %base: offset, %raw: index, %path: i1) {
  %c0 = index.constant 0 : index
  %origin = index.assume %raw [range(%raw, -1, 1)] : index
  %view = buffer.view %storage[%base] : buffer -> view<1xi32>
  %equal = index.cmp eq, %origin, %c0 : index
  %nonnegative = index.cmp sge, %origin, %c0 : index
  %combined = scalar.andi %equal, %nonnegative : i1
  cfg.cond_br %path, ^left, ^right
^left:
  cfg.cond_br %equal, ^join, ^exit
^right:
  cfg.cond_br %combined, ^join, ^exit
^join:
  %loaded = vector.load %view[%origin] : view<1xi32> -> vector<1xi32>
  test.use %loaded : vector<1xi32>
  cfg.br ^exit
^exit:
  func.return
}

// ====

// A genuinely weaker incoming edge cannot establish the other edge's equality.
func.def @join_weaker_edge_does_not_establish_equality(%storage: buffer, %base: offset, %raw: index, %path: i1) {
  %c0 = index.constant 0 : index
  %origin = index.assume %raw [range(%raw, -1, 1)] : index
  %view = buffer.view %storage[%base] : buffer -> view<1xi32>
  %equal = index.cmp eq, %origin, %c0 : index
  %nonnegative = index.cmp sge, %origin, %c0 : index
  cfg.cond_br %path, ^left, ^right
^left:
  cfg.cond_br %equal, ^join, ^exit
^right:
  cfg.cond_br %nonnegative, ^join, ^exit
^join:
  // ERROR@+1: SUBRANGE/011 {op_name="vector.load", vector_extent="1", view_bound="1", required_origin_upper_bound="0"}
  %loaded = vector.load %view[%origin] : view<1xi32> -> vector<1xi32>
  test.use %loaded : vector<1xi32>
  cfg.br ^exit
^exit:
  func.return
}

// ====

// RUN: pass vector-memory-footprint
func.def @reversed_equality_proves_scaled_access(%storage: buffer, %raw: index, %bound_raw: index) {
  %base = index.constant 0 : offset
  %element_count = index.constant 1 : index
  %element_bytes = index.constant 4 : index
  %origin = index.assume %raw [range(%raw, 0, 63)] : index
  %bound = index.assume %bound_raw [range(%bound_raw, 1, 64)] : index
  %limit = index.add %origin, %element_count : index
  %fits = index.cmp eq, %bound, %limit : index
  %byte_origin = index.mul %origin, %element_bytes : index
  %byte_bound = index.mul %bound, %element_bytes : index
  %view = buffer.view %storage[%base] : buffer -> view<[%byte_bound]xi8>
  scf.if %fits {
    %loaded = vector.load %view[%byte_origin] : view<[%byte_bound]xi8> -> vector<4xi8>
    test.use %loaded : vector<4xi8>
  }
  func.return
}

// ====

// RUN: pass vector-memory-footprint
func.def @reversed_equality_rejects_excess_extent(%storage: buffer, %raw: index, %bound_raw: index) {
  %base = index.constant 0 : offset
  %element_count = index.constant 1 : index
  %element_bytes = index.constant 4 : index
  %origin = index.assume %raw [range(%raw, 0, 63)] : index
  %bound = index.assume %bound_raw [range(%bound_raw, 1, 64)] : index
  %limit = index.add %origin, %element_count : index
  %fits = index.cmp eq, %bound, %limit : index
  %byte_origin = index.mul %origin, %element_bytes : index
  %byte_bound = index.mul %bound, %element_bytes : index
  %view = buffer.view %storage[%base] : buffer -> view<[%byte_bound]xi8>
  scf.if %fits {
    // ERROR@+1: SUBRANGE/010 {op_name="vector.load", vector_extent="5"}
    %loaded = vector.load %view[%byte_origin] : view<[%byte_bound]xi8> -> vector<5xi8>
    test.use %loaded : vector<5xi8>
  }
  func.return
}

