  %limit = index.add %origin, %element_count : index
  %fits = index.cmp eq, %bound, %limit : index
  %byte_origin = index.mul %origin, %element_bytes : index
  %byte_bound = index.mul %bound, %element_bytes : index
  %view = buffer.view %storage[%base] : buffer -> view<[%byte_bound]xi8>
  scf.if %fits {
    // ERROR@+1: SUBRANGE/010 {op_name="vector.load", vector_extent="5"}
    %loaded = vector.load %view[%byte_origin] : view<[%byte_bound]xi8> -> vector<5xi8>
    test.use %loaded : vector<5xi8>
  }
  func.return
}
