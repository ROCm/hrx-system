// Preserve a query whose explicit target has not been supplied.
// RUN: pass inline-callables,canonicalize

test.target<low_core> @construction {subgroup_size = 64}

target.decl @device

func.def inline target(@device) @device_width() -> (index) {
  %width = target.subgroup.size : index
  func.return %width : index
}

func.def public target(@construction) @caller() -> (index) {
  %width = func.call @device_width() : () -> (index)
  func.return %width : index
}

// ----
test.target<low_core> @construction {subgroup_size = 64}

target.decl @device

func.def inline target(@device) @device_width() -> (index) {
  %width = target.subgroup.size : index
  func.return %width : index
}

func.def public target(@construction) @caller() -> (index) {
  %width = func.call pure @device_width() : () -> (index)
  func.return %width : index
}

