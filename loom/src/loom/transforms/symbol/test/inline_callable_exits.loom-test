// Preparation retains an exit-bearing callable until its native return
// destination can be preserved.
// RUN: pass inline-callables{stage=prepare}

func.def inline @select(%condition: i1, %value: i32, %fallback: i32) -> (i32) {
  func.exit %condition : i1 {
    func.return %value : i32
  }
  func.return %fallback : i32
}

func.def public @prepared_caller(%condition: i1, %value: i32, %fallback: i32) -> (i32) {
  %selected = func.call @select(%condition, %value, %fallback) : (i1, i32, i32) -> (i32)
  func.return %selected : i32
}

// ----
func.def inline @select(%condition: i1, %value: i32, %fallback: i32) -> (i32) {
  func.exit %condition : i1 {
    func.return %value : i32
  }
  func.return %fallback : i32
}

func.def public @prepared_caller(%condition: i1, %value: i32, %fallback: i32) -> (i32) {
  %selected = func.call @select(%condition, %value, %fallback) : (i1, i32, i32) -> (i32)
  func.return %selected : i32
}

// ====

// Once structured control projects to CFG, completion inlining consumes both
// an exit-bearing helper and a call nested in the caller's original loop.
// RUN: pass inline-callables{stage=prepare},scf-to-cfg,inline-callables{stage=complete},symbol-dce,cfg-simplify

func.def inline @find(%condition: i1, %value: i32, %fallback: i32) -> (i32) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  scf.for %index = [%c0 to %c1 step %c1] {
    func.exit %condition : i1 {
      func.return %value : i32
    }
  }
  func.return %fallback : i32
}

func.def public @completed_caller(%condition: i1, %limit: index, %value: i32, %fallback: i32) -> (i32) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %initial = scalar.constant 0 : i32
  %sum = scf.for %index = [%c0 to %limit step %c1](%acc = %initial : i32) -> (i32) {
    %selected = func.call @find(%condition, %value, %fallback) : (i1, i32, i32) -> (i32)
    %next = scalar.addi %acc, %selected : i32
    scf.yield %next : i32
  }
  func.return %sum : i32
}

// ----
func.def public @completed_caller(%condition: i1, %limit: index, %value: i32, %fallback: i32) -> (i32) {
  %c0$12 = index.constant 0 : index
  %c1$13 = index.constant 1 : index
  %initial = scalar.constant 0 : i32
  cfg.br ^_bb1(%c0$12: index, %initial: i32)
^_bb1(%25: index, %acc: i32):
  %28 = index.cmp slt, %25, %limit : index
  cfg.cond_br %28, ^_bb2, ^_bb3
^_bb2:
  %index$27 = index.assume %25 [range(%25, 0, 9223372036854775806), lt(%25, %limit)] : index
  %c0$4 = index.constant 0 : index
  %c1$5 = index.constant 1 : index
  cfg.br ^_bb4(%c0$4: index)
^_bb3:
  func.return %acc : i32
^_bb4(%20: index):
  %22 = index.cmp slt, %20, %c1$5 : index
  cfg.cond_br %22, ^_bb5, ^_bb8
^_bb5:
  %index$21 = index.assume %20 [eq(%20, 0)] : index
  cfg.cond_br %condition, ^_bb6, ^_bb7
^_bb6:
  cfg.br ^_bb9(%value: i32)
^_bb7:
  %23 = index.add %index$21, %c1$5 : index
  cfg.br ^_bb4(%23: index)
^_bb8:
  cfg.br ^_bb9(%fallback: i32)
^_bb9(%selected: i32):
  %next = scalar.addi %acc, %selected : i32
  %29 = index.add %index$27, %c1$13 : index
  cfg.br ^_bb1(%29: index, %next: i32)
}

// ====

// A structured Low exit remains attached to its original callable. The final
// target-policy pass cannot splice it into a caller without changing which
// function low.return terminates.
// RUN: pass inline-callables{stage=complete}

test.target<low_core> @target

low.func.def inline target<test.low.core>(@target) @structured_exit(%condition: reg<test.i32>, %value: reg<test.i32>, %fallback: reg<test.i32>) -> (reg<test.i32>) asm {
  low.func.exit %condition : reg<test.i32> {
    return %value
  }
  return %fallback
}

low.func.def public target<test.low.core>(@target) @structured_exit_caller(%condition: reg<test.i32>, %value: reg<test.i32>, %fallback: reg<test.i32>) -> (reg<test.i32>) asm {
  %selected = low.func.call @structured_exit(%condition, %value, %fallback) : (reg<test.i32>, reg<test.i32>, reg<test.i32>) -> (reg<test.i32>)
  return %selected
}

// ----
test.target<low_core> @target

low.func.def inline target<test.low.core>(@target) @structured_exit(%condition: reg<test.i32>, %value: reg<test.i32>, %fallback: reg<test.i32>) -> (reg<test.i32>) asm {
  low.func.exit %condition : reg<test.i32> {
    return %value
  }
  return %fallback
}

low.func.def public target<test.low.core>(@target) @structured_exit_caller(%condition: reg<test.i32>, %value: reg<test.i32>, %fallback: reg<test.i32>) -> (reg<test.i32>) asm {
  %selected = low.func.call @structured_exit(%condition, %value, %fallback) : (reg<test.i32>, reg<test.i32>, reg<test.i32>) -> (reg<test.i32>)
  return %selected
}

// ====

// A leaf-only outer boundary requires the exit-bearing inner helper to expand,
// but preparation must preserve its return destination until CFG conversion.
// RUN: pass specialize-target-callgraph,inline-callables{policy=target,stage=prepare,budget=0},scf-to-cfg,inline-callables{policy=target,budget=0},symbol-dce,cfg-simplify

test.target<low_leaf> @target

func.def target(@target) @select(%condition: i1, %value: i32, %fallback: i32) -> (i32) {
  func.exit %condition : i1 {
    func.return %value : i32
  }
  func.return %fallback : i32
}

func.def noinline target(@target) @outer(%condition: i1, %value: i32, %fallback: i32) -> (i32) {
  %selected = func.call @select(%condition, %value, %fallback) : (i1, i32, i32) -> (i32)
  func.return %selected : i32
}

func.def public target(@target) @entry(%condition: i1, %value: i32, %fallback: i32) -> (i32) {
  %selected = func.call @outer(%condition, %value, %fallback) : (i1, i32, i32) -> (i32)
  func.return %selected : i32
}

// ----
test.target<low_leaf> @target

func.def noinline target(@target) @outer(%condition: i1, %value: i32, %fallback: i32) -> (i32) {
  cfg.cond_br %condition, ^_bb1, ^_bb2
^_bb1:
  cfg.br ^_bb3(%value: i32)
^_bb2:
  cfg.br ^_bb3(%fallback: i32)
^_bb3(%selected: i32):
  func.return %selected : i32
}

func.def public target(@target) @entry(%condition: i1, %value: i32, %fallback: i32) -> (i32) {
  %selected = func.call @outer(%condition, %value, %fallback) : (i1, i32, i32) -> (i32)
  func.return %selected : i32
}
