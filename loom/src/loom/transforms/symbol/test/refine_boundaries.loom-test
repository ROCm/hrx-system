// ====

// An unconstrained first caller contributes unknown facts rather than leaving
// the argument unobserved. A later aligned caller cannot narrow the shared body.
func.def noinline @remainder(%value: index) -> (index) {
  %alignment = index.constant 16 : index
  %result = index.rem %value, %alignment : index
  func.return %result : index
}

func.def public @unknown_first(%input: index) -> (index, index) {
  %unknown_result = func.call @remainder(%input) : (index) -> (index)
  %aligned = index.constant 32 : index
  %known_result = func.call @remainder(%aligned) : (index) -> (index)
  func.return %unknown_result, %known_result : index, index
}

// ----
func.def noinline @remainder(%value: index) -> (index) {
  %alignment = index.constant 16 : index
  %result = index.rem %value, %alignment : index
  func.return %result : index
}

func.def public @unknown_first(%input: index) -> (index, index) {
  %unknown_result = func.call pure @remainder(%input) : (index) -> (index)
  %aligned = index.constant 32 : index
  %known_result = func.call pure @remainder(%aligned) : (index) -> (index)
  func.return %unknown_result, %known_result : index, index
}

// ====

// Joining an unknown caller after a known caller has the same conservative
// result. Refinement is independent of the order in which calls are visited.
func.def noinline @remainder(%value: index) -> (index) {
  %alignment = index.constant 16 : index
  %result = index.rem %value, %alignment : index
  func.return %result : index
}

func.def public @known_first(%input: index) -> (index, index) {
  %aligned = index.constant 32 : index
  %known_result = func.call @remainder(%aligned) : (index) -> (index)
  %unknown_result = func.call @remainder(%input) : (index) -> (index)
  func.return %unknown_result, %known_result : index, index
}

// ----
func.def noinline @remainder(%value: index) -> (index) {
  %alignment = index.constant 16 : index
  %result = index.rem %value, %alignment : index
  func.return %result : index
}

func.def public @known_first(%input: index) -> (index, index) {
  %aligned = index.constant 32 : index
  %known_result = func.call pure @remainder(%aligned) : (index) -> (index)
  %unknown_result = func.call pure @remainder(%input) : (index) -> (index)
  func.return %unknown_result, %known_result : index, index
}

// ====

// Kernel callers precede their device helpers in the symbol graph. Nested
// successor walks preserve the caller's live region traversal after a call.
kernel.def @caller_before_callees() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%output: buffer, %value: f32, %choose_chain: i1) {
  %result = scf.if %choose_chain -> (f32) {
    %scaled = func.call @scale_chain(%value) : (f32) -> (f32)
    %bias = scalar.constant 1.0 : f32
    %sum = scalar.addf %scaled, %bias : f32
    scf.yield %sum : f32
  } else {
    %scaled = func.call @scale_leaf(%value) : (f32) -> (f32)
    scf.yield %scaled : f32
  }
  %base = index.constant 0 : offset
  %output_view = buffer.view %output[%base] : buffer -> view<1xf32>
  view.store %result, %output_view[0] : f32, view<1xf32>
  kernel.return
}

func.def device @scale_chain(%value: f32) -> (f32) {
  %scaled = func.call @scale_leaf(%value) : (f32) -> (f32)
  %chain_scale = scalar.constant 2.0 : f32
  %result = scalar.mulf %scaled, %chain_scale : f32
  func.return %result : f32
}

func.def device @scale_leaf(%value: f32) -> (f32) {
  %leaf_scale = scalar.constant 3.0 : f32
  %result = scalar.mulf %value, %leaf_scale : f32
  func.return %result : f32
}

// ----
kernel.def @caller_before_callees() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%output: buffer, %value: f32, %choose_chain: i1) {
  %result = scf.if %choose_chain -> (f32) {
    %scaled = func.call pure @scale_chain(%value) : (f32) -> (f32)
    %bias = scalar.constant 1.0 : f32
    %sum = scalar.addf %scaled, %bias : f32
    scf.yield %sum : f32
  } else {
    %scaled = func.call pure @scale_leaf(%value) : (f32) -> (f32)
    scf.yield %scaled : f32
  }
  %base = index.constant 0 : offset
  %output_view = buffer.view %output[%base] : buffer -> view<1xf32>
  view.store %result, %output_view[0] : f32, view<1xf32>
  kernel.return
}

func.def device @scale_chain(%value: f32) -> (f32) {
  %scaled = func.call pure @scale_leaf(%value) : (f32) -> (f32)
  %chain_scale = scalar.constant 2.0 : f32
  %result = scalar.mulf %scaled, %chain_scale : f32
  func.return %result : f32
}

func.def device @scale_leaf(%value: f32) -> (f32) {
  %leaf_scale = scalar.constant 3.0 : f32
  %result = scalar.mulf %value, %leaf_scale : f32
  func.return %result : f32
}

// ====

// External signatures remain fixed even when local facts prove a layout exact.
func.decl @external_read(%layout: encoding<layout>, %input: view<2x3xf32, %layout>) -> (f32)

func.def public @read_external_dense(%storage: buffer) -> (f32) {
  %layout = encoding.layout.dense : encoding<layout>
  %base = index.constant 0 : offset
  %input = buffer.view %storage[%base] : buffer -> view<2x3xf32, %layout>
  %result = func.call @external_read(%layout, %input) : (encoding<layout>, view<2x3xf32, %layout>) -> (f32)
  func.return %result : f32
}

// ====

// A public callable's dimension contract belongs to its external callers.
func.def public @public_dimension_contract(%width: index, %input: view<[%width]xf32>) -> (view<[%width]xf32>) where [eq(%width, 8)] {
  func.return %input : view<[%width]xf32>
}

// ====

// A family application retains its declared signature before provider selection.
template.decl @family_read(%layout: encoding<layout>, %input: view<2x3xf32, %layout>) -> (f32)

func.def public @read_family_dense(%storage: buffer) -> (f32) {
  %layout = encoding.layout.dense : encoding<layout>
  %base = index.constant 0 : offset
  %input = buffer.view %storage[%base] : buffer -> view<2x3xf32, %layout>
  %result = template.apply<@family_read>(%layout, %input) : (encoding<layout>, view<2x3xf32, %layout>) -> (f32)
  func.return %result : f32
}

// ====

// Different finite callers establish a common class inside a retained helper.
func.def noinline @classify_finite(%value: f32) -> (i1) {
  %finite = scalar.isfinitef %value : f32
  func.return %finite : i1
}

func.def public @classify_one() -> (i1) {
  %value = scalar.constant 1.0 : f32
  %finite = func.call @classify_finite(%value) : (f32) -> (i1)
  func.return %finite : i1
}

func.def public @classify_two() -> (i1) {
  %value = scalar.constant 2.0 : f32
  %finite = func.call @classify_finite(%value) : (f32) -> (i1)
  func.return %finite : i1
}

// ----
func.def noinline @classify_finite() {
  func.return
}

func.def public @classify_one() -> (i1) {
  %10 = scalar.constant true : i1
  func.return %10 : i1
}

func.def public @classify_two() -> (i1) {
  %11 = scalar.constant true : i1
  func.return %11 : i1
}

// ====

// A finite caller cannot impose its classification on an unknown caller.
func.def noinline @classify_unknown(%value: f32) -> (i1) {
  %finite = scalar.isfinitef %value : f32
  func.return %finite : i1
}

func.def public @known_float() -> (i1) {
  %value = scalar.constant 1.0 : f32
  %finite = func.call @classify_unknown(%value) : (f32) -> (i1)
  func.return %finite : i1
}

func.def public @unknown_float(%value: f32) -> (i1) {
  %finite = func.call @classify_unknown(%value) : (f32) -> (i1)
  func.return %finite : i1
}

// ----
func.def noinline @classify_unknown(%value: f32) -> (i1) {
  %finite = scalar.isfinitef %value : f32
  func.return %finite : i1
}

func.def public @known_float() -> (i1) {
  %value = scalar.constant 1.0 : f32
  %finite = func.call pure @classify_unknown(%value) : (f32) -> (i1)
  func.return %finite : i1
}

func.def public @unknown_float(%value: f32) -> (i1) {
  %finite = func.call pure @classify_unknown(%value) : (f32) -> (i1)
  func.return %finite : i1
}
