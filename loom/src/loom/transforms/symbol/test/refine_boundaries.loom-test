  %6 = index.constant 7 : index
  %result = test.invoke @test_direct_body_exit(%condition) : (i1) -> (index)
  test.use %6 : index
  func.return
}

// ====

// Result pruning rebuilds the callable's declared body exit kind rather than
// assuming a func.return terminator.
test.func @test_prune_result(%kept: index, %dead: index) -> (index, index) {
  test.yield %kept, %dead : index, index
}

