// RUN: pass refine-boundaries{mode=encodings},symbol-dce

// Every known memory space gets a receiving body. Repeated spaces share one
// body, and unknown and null callers share the unconstrained group.
func.def @observe(%storage: buffer, %value: i32) {
  test.use %storage, %value : buffer, i32
  func.return
}

func.def public @spaces(%storage: buffer, %device: buffer, %shared: buffer, %local: buffer, %readonly: buffer, %hosted: buffer, %descriptors: buffer, %unified: buffer, %value: i32) {
  %global = buffer.assume.memory_space<global> %device : buffer
  %workgroup = buffer.assume.memory_space<workgroup> %shared : buffer
  %private = buffer.assume.memory_space<private> %local : buffer
  %constant = buffer.assume.memory_space<constant> %readonly : buffer
  %host = buffer.assume.memory_space<host> %hosted : buffer
  %descriptor = buffer.assume.memory_space<descriptor> %descriptors : buffer
  %generic = buffer.assume.memory_space<generic> %unified : buffer
  %null = buffer.null : buffer
  func.call @observe(%storage, %value) : (buffer, i32)
  func.call @observe(%global, %value) : (buffer, i32)
  func.call @observe(%workgroup, %value) : (buffer, i32)
  func.call @observe(%private, %value) : (buffer, i32)
  func.call @observe(%constant, %value) : (buffer, i32)
  func.call @observe(%host, %value) : (buffer, i32)
  func.call @observe(%descriptor, %value) : (buffer, i32)
  func.call @observe(%generic, %value) : (buffer, i32)
  func.call @observe(%global, %value) : (buffer, i32)
  func.call @observe(%null, %value) : (buffer, i32)
  func.return
}

