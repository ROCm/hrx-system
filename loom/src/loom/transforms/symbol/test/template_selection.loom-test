// ====

// A targetless caller does not disprove a targeted provider. Early selection
// preserves that unresolved choice when it can outrank the proven fallback.
// RUN: pass select-templates

test.target<low_core> @low_core

template.decl @demo.identity_unbound_early(%value: i32) -> (i32)

template.def<@demo.identity_unbound_early> target(@low_core) priority(10) @targeted(%value: i32) -> (i32) {
  %doubled = test.addi %value, %value : i32
  template.return %doubled : i32
}

template.def<@demo.identity_unbound_early> priority(1) @fallback(%value: i32) -> (i32) {
  template.return %value : i32
}

func.def public @entry(%arg: i32) -> (i32) {
  %result = template.apply<@demo.identity_unbound_early>(%arg) : (i32) -> (i32)
  func.return %result : i32
}

// ----
test.target<low_core> @low_core

template.decl @demo.identity_unbound_early(%value: i32) -> (i32)

template.def<@demo.identity_unbound_early> target(@low_core) priority(10) @targeted(%value: i32) -> (i32) {
  %doubled = test.addi %value, %value : i32
  template.return %doubled : i32
}

template.def<@demo.identity_unbound_early> priority(1) @fallback(%value: i32) -> (i32) {
  template.return %value : i32
}

func.def public @entry(%arg: i32) -> (i32) {
  %result = template.apply<@demo.identity_unbound_early>(%arg) : (i32) -> (i32)
  func.return %result : i32
}

