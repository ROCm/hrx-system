  %result = func.apply<demo.archived_duplicate>(%n, %arg) : (index, tensor<[%n]xf32>) -> (tensor<[%n]xf32>)
  func.return %result : tensor<[%n]xf32>
}

func.def public @entry_b(%n: index, %arg: tensor<[%n]xf32>) -> (tensor<[%n]xf32>) where [mul(%n, 16)] {
  %result = func.apply<demo.archived_duplicate>(%n, %arg) : (index, tensor<[%n]xf32>) -> (tensor<[%n]xf32>)
  func.return %result : tensor<[%n]xf32>
}

