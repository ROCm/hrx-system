// ====

// Provider predicates consume facts at each application point. The true edge
// proves the higher-priority equality while the false edge disproves it and
// selects the fallback.
// RUN: pass select-templates,inline-callables

template.decl @demo.application_path(%m: index) -> (index)

template.def<@demo.application_path> priority(10) @exact(%m: index) -> (index) where [eq(%m, 32)] {
  %c1 = index.constant 1 : index
  %adjusted = index.add %m, %c1 : index
  template.return %adjusted : index
}

template.def<@demo.application_path> priority(1) @fallback(%m: index) -> (index) {
  template.return %m : index
}

func.def public @entry(%n: index) -> (index) {
  %c32 = index.constant 32 : index
  %is32 = index.cmp eq, %n, %c32 : index
  %result = scf.if %is32 -> (index) {
    %matched = template.apply<@demo.application_path>(%n) : (index) -> (index)
    scf.yield %matched : index
  } else {
    %fallback = template.apply<@demo.application_path>(%n) : (index) -> (index)
    scf.yield %fallback : index
  }
  func.return %result : index
}

// ----
template.decl @demo.application_path(%m: index) -> (index)

func.def public @entry(%n: index) -> (index) {
  %c32 = index.constant 32 : index
  %is32 = index.cmp eq, %n, %c32 : index
  %result = scf.if %is32 -> (index) {
    %c1 = index.constant 1 : index
    %adjusted = index.add %n, %c1 : index
    scf.yield %adjusted : index
  } else {
    scf.yield %n : index
  }
  func.return %result : index
}

