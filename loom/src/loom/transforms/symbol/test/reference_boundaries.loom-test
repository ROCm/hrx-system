// RUN: pass refine-boundaries

// Distinct caller allocations have the same extent. A shared noinline helper
// can fold the length without treating their storage roots as identical.
func.def noinline @record_length(%record: buffer) -> (offset) {
  %length = buffer.length %record
  func.return %length : offset
}

func.def public @two_records() -> (offset, offset) {
  %bytes = index.constant 256 : offset
  %first = buffer.alloca<workgroup> align(64) %bytes : buffer
  %second = buffer.alloca<workgroup> align(32) %bytes : buffer
  %first_length = func.call @record_length(%first) : (buffer) -> (offset)
  %second_length = func.call @record_length(%second) : (buffer) -> (offset)
  func.return %first_length, %second_length : offset, offset
}

// ----
func.def noinline @record_length() {
  func.return
}

func.def public @two_records() -> (offset, offset) {
  %11 = index.constant 256 : offset
  %12 = index.constant 256 : offset
  func.return %11, %12 : offset, offset
}

// ====

// RUN: pass refine-boundaries

// Return alternatives preserve their extent bound and divisibility without
// making the selected extent exact. The length remains dependent on the branch.
func.def noinline @select_record(%first: buffer, %second: buffer, %pick_first: i1) -> (buffer) {
  cfg.cond_br %pick_first, ^first, ^second
^first:
  func.return %first : buffer
^second:
  func.return %second : buffer
}

func.def public @record_properties(%pick_first: i1) -> (offset, i1, index) {
  %first_bytes = index.constant 256 : offset
  %second_bytes = index.constant 512 : offset
  %alignment = index.constant 128 : index
  %first = buffer.alloca<workgroup> align(64) %first_bytes : buffer
  %second = buffer.alloca<workgroup> align(32) %second_bytes : buffer
  %record = func.call @select_record(%first, %second, %pick_first) : (buffer, buffer, i1) -> (buffer)
  %length = buffer.length %record
  %fits = index.cmp sle, %length, %second_bytes : offset
  %byte_count = index.cast %length : offset to index
  %remainder = index.rem %byte_count, %alignment : index
  func.return %length, %fits, %remainder : offset, i1, index
}

// ----
func.def noinline @select_record(%first: buffer, %second: buffer, %pick_first: i1) -> (buffer) {
  cfg.cond_br %pick_first, ^first, ^second
^first:
  func.return %first : buffer
^second:
  func.return %second : buffer
}

func.def public @record_properties(%pick_first: i1) -> (offset, i1, index) {
  %first_bytes = index.constant 256 : offset
  %second_bytes = index.constant 512 : offset
  %first = buffer.alloca<workgroup> align(64) %first_bytes : buffer
  %second = buffer.alloca<workgroup> align(32) %second_bytes : buffer
  %record = func.call pure @select_record(%first, %second, %pick_first) : (buffer, buffer, i1) -> (buffer)
  %length = buffer.length %record
  %fits = scalar.constant true : i1
  %remainder = index.constant 0 : index
  func.return %length, %fits, %remainder : offset, i1, index
}

// ====

// RUN: pass refine-boundaries

// The workgroup allocation specializes independently of the unconstrained
// caller. Its known length cannot replace the external caller's dynamic length.
func.def noinline @record_length(%record: buffer) -> (offset) {
  %length = buffer.length %record
  func.return %length : offset
}

func.def public @mixed_records(%external: buffer) -> (offset, offset) {
  %bytes = index.constant 256 : offset
  %local = buffer.alloca<workgroup> align(64) %bytes : buffer
  %local_length = func.call @record_length(%local) : (buffer) -> (offset)
  %external_length = func.call @record_length(%external) : (buffer) -> (offset)
  func.return %local_length, %external_length : offset, offset
}

// ----
func.def noinline @record_length() {
  func.return
}

func.def noinline @record_length_spec0() {
  func.return
}

func.def noinline @record_length_spec1(%record: buffer) -> (offset) {
  %length = buffer.length %record
  func.return %length : offset
}

func.def public @mixed_records(%external: buffer) -> (offset, offset) {
  %17 = index.constant 256 : offset
  %external_length = func.call pure @record_length_spec1(%external) : (buffer) -> (offset)
  func.return %17, %external_length : offset, offset
}

// ====

// A nullable result keeps its dynamic identity across a retained call. The
// caller's nonnull argument must not replace the helper's optional result.
func.def noinline @optional_record(%input: buffer, %use: i1) -> (buffer) {
  %empty = buffer.null : buffer
  %selected = scf.select %use, %input, %empty : buffer
  func.return %selected : buffer
}

func.def public @optional_result(%use: i1) -> (buffer, i1) {
  %storage = buffer.constant bytes("01020304") : buffer
  %selected = func.call @optional_record(%storage, %use) : (buffer, i1) -> (buffer)
  %missing = buffer.compare.null %selected : buffer
  func.return %selected, %missing : buffer, i1
}

// ----
func.def noinline @optional_record(%input: buffer, %use: i1) -> (buffer) {
  %empty = buffer.null : buffer
  %selected = scf.select %use, %input, %empty : buffer
  func.return %selected : buffer
}

func.def public @optional_result(%use: i1) -> (buffer, i1) {
  %storage = buffer.constant bytes("01020304") : buffer
  %selected = func.call pure @optional_record(%storage, %use) : (buffer, i1) -> (buffer)
  %missing = buffer.compare.null %selected : buffer
  func.return %selected, %missing : buffer, i1
}

// ====

// Distinct real callers prove nonnull without proving a shared root identity.
func.def noinline @is_missing(%input: buffer) -> (i1) {
  %missing = buffer.compare.null %input : buffer
  func.return %missing : i1
}

func.def public @nonnull_callers() -> (i1, i1) {
  %first = buffer.constant bytes("") : buffer
  %second = buffer.constant bytes("01020304") : buffer
  %a = func.call @is_missing(%first) : (buffer) -> (i1)
  %b = func.call @is_missing(%second) : (buffer) -> (i1)
  func.return %a, %b : i1, i1
}

// ----
func.def noinline @is_missing() {
  func.return
}

func.def public @nonnull_callers() -> (i1, i1) {
  %10 = scalar.constant false : i1
  %11 = scalar.constant false : i1
  func.return %10, %11 : i1, i1
}

// ====

// RUN: pass refine-boundaries{mode=encodings},refine-boundaries

// Encoding refinement must converge before body folding. Two calls share one
// resize summary: their different roots must retain the common lane-varying
// identity, even when the extent itself has no distribution proof.
func.def noinline @resize(%state: buffer) -> (buffer) {
  %bytes = buffer.length %state
  %grown = buffer.alloca<private> align(8) %bytes : buffer
  %output_varying = test.fact_lane_varying %grown : buffer -> i1
  test.use %output_varying : i1
  func.return %grown : buffer
}

func.def public @grow_twice(%bytes: offset) -> (buffer) {
  %state = buffer.alloca<private> align(8) %bytes : buffer
  %next = func.call @resize(%state) : (buffer) -> (buffer)
  %grown = func.call @resize(%next) : (buffer) -> (buffer)
  %varying = test.fact_lane_varying %grown : buffer -> i1
  test.use %varying : i1
  func.return %grown : buffer
}

// ----
func.def noinline @resize(%state: buffer) -> (buffer) {
  %bytes = buffer.length %state
  %grown = buffer.alloca<private> align(8) %bytes : buffer
  %output_varying = scalar.constant true : i1
  test.use %output_varying : i1
  func.return %grown : buffer
}

func.def public @grow_twice(%bytes: offset) -> (buffer) {
  %state = buffer.alloca<private> align(8) %bytes : buffer
  %next = func.call @resize(%state) : (buffer) -> (buffer)
  %grown = func.call @resize(%next) : (buffer) -> (buffer)
  %varying = scalar.constant true : i1
  test.use %varying : i1
  func.return %grown : buffer
}

