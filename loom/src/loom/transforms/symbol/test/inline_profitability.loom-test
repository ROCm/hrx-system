// RUN: pass inline-callables{budget=3,hot-budget=0}

func.def inline @required_leaf(%value: i32) -> (i32) {
  %result = test.addi %value, %value : i32
  func.return %result : i32
}

func.def public @expanded_helper(%value: i32) -> (i32) {
  %inner = func.call @required_leaf(%value) : (i32) -> (i32)
  %result = test.addi %inner, %value : i32
  func.return %result : i32
}

func.def public @expanded_cost_entry(%value: i32) -> (i32) {
  %result = func.call @expanded_helper(%value) : (i32) -> (i32)
  func.return %result : i32
}

