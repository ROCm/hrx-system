// ====

// RUN: pass inline-callables{budget=3,hot-budget=0}

func.def @single_use_selected(%value: i32) -> (i32) {
  %first = test.addi %value, %value : i32
  %second = test.addi %first, %value : i32
  func.return %second : i32
}

func.def @single_use_retained(%value: i32) -> (i32) {
  %first = test.addi %value, %value : i32
  %second = test.addi %first, %value : i32
  %third = test.addi %second, %value : i32
  func.return %third : i32
}

func.def public @single_use_entry(%value: i32) -> (i32, i32) {
  %selected = func.call @single_use_selected(%value) : (i32) -> (i32)
  %retained = func.call @single_use_retained(%value) : (i32) -> (i32)
  func.return %selected, %retained : i32, i32
}

// ----

func.def @single_use_retained(%value: i32) -> (i32) {
  %first = test.addi %value, %value : i32
  %second = test.addi %first, %value : i32
  %third = test.addi %second, %value : i32
  func.return %third : i32
}

func.def public @single_use_entry(%value: i32) -> (i32, i32) {
  %first = test.addi %value, %value : i32
  %second = test.addi %first, %value : i32
  %retained = func.call @single_use_retained(%value) : (i32) -> (i32)
  func.return %second, %retained : i32, i32
}

// ====

// A wide vector operation is one IR operation but occupies multiple payload
// words and can expand into multiple target operations.
// RUN: pass inline-callables{budget=16,hot-budget=0}

func.def @wide_helper(%lhs: vector<8xi64>, %rhs: vector<8xi64>) -> (vector<8xi64>) {
  %result = vector.addi %lhs, %rhs : vector<8xi64>
  func.return %result : vector<8xi64>
}

func.def public @wide_entry(%lhs: vector<8xi64>, %rhs: vector<8xi64>) -> (vector<8xi64>) {
  %result = func.call @wide_helper(%lhs, %rhs) : (vector<8xi64>, vector<8xi64>) -> (vector<8xi64>)
  func.return %result : vector<8xi64>
}

// ----

func.def @wide_helper(%lhs: vector<8xi64>, %rhs: vector<8xi64>) -> (vector<8xi64>) {
  %result = vector.addi %lhs, %rhs : vector<8xi64>
  func.return %result : vector<8xi64>
}

func.def public @wide_entry(%lhs: vector<8xi64>, %rhs: vector<8xi64>) -> (vector<8xi64>) {
  %result = func.call @wide_helper(%lhs, %rhs) : (vector<8xi64>, vector<8xi64>) -> (vector<8xi64>)
  func.return %result : vector<8xi64>
}

