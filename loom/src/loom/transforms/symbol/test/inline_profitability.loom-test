func.def public @recursive_a(%value: i32) -> (i32) {
  %result = func.call @recursive_b(%value) : (i32) -> (i32)
  func.return %result : i32
}

func.def public @recursive_b(%value: i32) -> (i32) {
  %result = func.call @recursive_a(%value) : (i32) -> (i32)
  func.return %result : i32
}

// ----
func.def public @recursive_a(%value: i32) -> (i32) {
  %result = func.call @recursive_b(%value) : (i32) -> (i32)
  func.return %result : i32
}

func.def public @recursive_b(%value: i32) -> (i32) {
  %result = func.call @recursive_a(%value) : (i32) -> (i32)
  func.return %result : i32
}

// ====

// Calls in independent execution scopes remain available for outlining. The
// outlined worker receives its own profitability decision.
// RUN: pass inline-callables

func.def @strand_helper(%value: i32) -> (i32) {
  %result = test.addi %value, %value : i32
  func.return %result : i32
}

pipeline.def public @strand_owner() run() {
  pipeline.strand workers([0], [1], [1]) {
    %value = scalar.constant 1 : i32
    %result = func.call @strand_helper(%value) : (i32) -> (i32)
  }
}

// ----
func.def @strand_helper(%value: i32) -> (i32) {
  %result = test.addi %value, %value : i32
  func.return %result : i32
}

pipeline.def public @strand_owner() run() {
  pipeline.strand workers([0], [1], [1]) {
    %value = scalar.constant 1 : i32
    %result = func.call @strand_helper(%value) : (i32) -> (i32)
  }
}
