// RUN: pass inline-callables

// Two callers exercise cloning and consuming the helper. The assertion has
// explicit semantics before and after either form of materialization.
func.def inline @require_tensor(%extent: index, %source: tensor<[%extent]xi8, #encoding.storage<layout=#encoding.layout.dense, schema=#ggml.q4_0>>) -> (tensor<18xi8, #encoding.storage<layout=#encoding.layout.dense, schema=#ggml.q4_0>>) {
  %refined = tensor.refine %source : tensor<[%extent]xi8, #encoding.storage<layout=#encoding.layout.dense, schema=#ggml.q4_0>> -> tensor<18xi8, #encoding.storage<layout=#encoding.layout.dense, schema=#ggml.q4_0>>
  func.return %refined : tensor<18xi8, #encoding.storage<layout=#encoding.layout.dense, schema=#ggml.q4_0>>
}

func.def public @first(%extent: index, %source: tensor<[%extent]xi8, #encoding.storage<layout=#encoding.layout.dense, schema=#ggml.q4_0>>) -> (tensor<18xi8, #encoding.storage<layout=#encoding.layout.dense, schema=#ggml.q4_0>>) {
  %result = func.call @require_tensor(%extent, %source) : (index, tensor<[%extent]xi8, #encoding.storage<layout=#encoding.layout.dense, schema=#ggml.q4_0>>) -> (tensor<18xi8, #encoding.storage<layout=#encoding.layout.dense, schema=#ggml.q4_0>>)
  func.return %result : tensor<18xi8, #encoding.storage<layout=#encoding.layout.dense, schema=#ggml.q4_0>>
}

func.def public @second(%extent: index, %source: tensor<[%extent]xi8, #encoding.storage<layout=#encoding.layout.dense, schema=#ggml.q4_0>>) -> (tensor<18xi8, #encoding.storage<layout=#encoding.layout.dense, schema=#ggml.q4_0>>) {
  %result = func.call @require_tensor(%extent, %source) : (index, tensor<[%extent]xi8, #encoding.storage<layout=#encoding.layout.dense, schema=#ggml.q4_0>>) -> (tensor<18xi8, #encoding.storage<layout=#encoding.layout.dense, schema=#ggml.q4_0>>)
  func.return %result : tensor<18xi8, #encoding.storage<layout=#encoding.layout.dense, schema=#ggml.q4_0>>
}

