// RUN: pass-report select-templates

template.decl @demo.report(%m: index) -> (index)

template.def<@demo.report> priority(10) @aligned(%m: index) -> (index) where [mul(%m, 16)] {
  template.return %m : index
}

template.def<@demo.report> priority(1) @fallback(%m: index) -> (index) {
  template.return %m : index
}

func.def public @entry() -> (index) {
  %n = index.constant 15 : index
  %result = template.apply<@demo.report>(%n) : (index) -> (index)
  func.return %result : index
}

