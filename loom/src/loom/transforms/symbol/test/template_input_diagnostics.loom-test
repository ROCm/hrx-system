// RUN: pass select-templates{mode=final}

template.decl @unknown(%n: index, %value: vector<[%n]xf32>) -> (index)

template.def<@unknown> @specialized(%n: index, %value: vector<16xf32>) -> (index) {
  template.return %n : index
}

func.def public @entry(%n: index, %value: vector<[%n]xf32>) -> (index) {
  // ERROR@+1: LOWERING/045 {op_name="template.apply", phase_name="select-templates", contract_key="unknown", failure_code="missing_facts"}
  %result = template.apply<@unknown>(%n, %value) : (index, vector<[%n]xf32>) -> (index)
  func.return %result : index
}

