// RUN: pass select-templates{mode=final}

test.target<low_core> @low_core

template.decl @demo.identity_fallback(%value: i32) -> (i32)

template.def<@demo.identity_fallback> target(@low_core) priority(10) @targeted(%value: i32) -> (i32) {
  template.return %value : i32
}

template.def<@demo.identity_fallback> priority(1) @fallback(%value: i32) -> (i32) {
  template.return %value : i32
}

func.def public @entry(%arg: i32) -> (i32) {
  %result = template.apply<@demo.identity_fallback>(%arg) : (i32) -> (i32)
  func.return %result : i32
}

