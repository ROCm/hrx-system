// ====

// The family relates the input extent to a distinct scalar argument. Only the
// equal CFG edge supplies that proof; exact output also checks inline wiring.
// RUN: pass select-templates{mode=final,rewrite=inline},canonicalize,symbol-dce

template.decl @equal(%n: index, %value: vector<[%n]xf32>) -> (index)

template.def<@equal> @selected(%n: index, %value: vector<[%n]xf32>) -> (index) {
  template.return %n : index
}

func.def public @entry(%n: index, %m: index, %value: vector<[%m]xf32>) -> (index) {
  %condition = index.cmp eq, %n, %m : index
  cfg.cond_br %condition, ^equal, ^different
^equal:
  %result = template.apply<@equal>(%n, %value) : (index, vector<[%m]xf32>) -> (index)
  func.return %result : index
^different:
  func.return %m : index
}

// ----
func.def public @entry(%n: index, %m: index, %value: vector<[%m]xf32>) -> (index) {
  %condition = index.cmp eq, %n, %m : index
  cfg.cond_br %condition, ^equal, ^different
^equal:
  func.return %n : index
^different:
  func.return %m : index
}
