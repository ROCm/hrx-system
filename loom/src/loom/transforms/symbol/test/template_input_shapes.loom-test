// RUN: pass select-templates{mode=final}

template.decl @shape(%n: index, %value: vector<[%n]xf32>) -> (index)

template.def<@shape> priority(1) @generic(%n: index, %value: vector<[%n]xf32>) -> (index) {
  template.return %n : index
}

template.def<@shape> priority(2) @sixteen(%n: index, %value: vector<16xf32>) -> (index) {
  %result = index.constant 16 : index
  template.return %result : index
}

func.def public @entry(%n: index, %value: vector<[%n]xf32>) -> (index) where [range(%n, 16, 16)] {
  %result = template.apply<@shape>(%n, %value) : (index, vector<[%n]xf32>) -> (index)
  func.return %result : index
}

// ----
template.decl @shape(%n: index, %value: vector<[%n]xf32>) -> (index)

template.def<@shape> priority(2) @sixteen(%n: index, %value: vector<16xf32>) -> (index) {
  %result = index.constant 16 : index
  template.return %result : index
}

func.def public @entry(%n: index, %value: vector<[%n]xf32>) -> (index) where [range(%n, 16, 16)] {
  %14 = vector.refine %value : vector<[%n]xf32> -> vector<16xf32>
  %result = template.call @sixteen(%n, %14) : (index, vector<16xf32>) -> (index)
  func.return %result : index
}

