// RUN: pass inline-callables

// Low call boundaries are retained by default, and an explicit noinline
// policy remains authoritative when no target emission policy overrides it.
test.target<low_core> @target

low.func.def noinline target<test.low.core>(@target) @kept_low_helper(%value: reg<test.i32>) -> (reg<test.i32>) {
  low.return %value : reg<test.i32>
}

low.func.def public target<test.low.core>(@target) @kept_low_caller(%value: reg<test.i32>) -> (reg<test.i32>) {
  %result = low.func.call @kept_low_helper(%value) : (reg<test.i32>) -> (reg<test.i32>)
  low.return %result : reg<test.i32>
}

// ----
test.target<low_core> @target

low.func.def noinline target<test.low.core>(@target) @kept_low_helper(%value: reg<test.i32>) -> (reg<test.i32>) {
  low.return %value : reg<test.i32>
}

low.func.def public target<test.low.core>(@target) @kept_low_caller(%value: reg<test.i32>) -> (reg<test.i32>) {
  %result = low.func.call @kept_low_helper(%value) : (reg<test.i32>) -> (reg<test.i32>)
  low.return %result : reg<test.i32>
}

// ====

// RUN: pass inline-callables

// Multi-block callable inlining preserves block arguments, remaps successor
// edges, and joins every return through one continuation block.
func.def inline @choose_path(%value: i32) -> (i32) {
  %condition = scalar.constant 1 : i1
  cfg.cond_br %condition, ^double, ^identity
^double:
  %doubled = test.addi %value, %value : i32
  cfg.br ^join(%doubled: i32)
^identity:
  func.return %value : i32
^join(%forwarded: i32):
  func.return %forwarded : i32
}

func.def public @cfg_entry(%arg: i32) -> (i32) {
  %prefix = test.addi %arg, %arg : i32
  %selected = func.call @choose_path(%prefix) : (i32) -> (i32)
  %suffix = test.addi %selected, %arg : i32
  func.return %suffix : i32
}

// ----
func.def public @cfg_entry(%arg: i32) -> (i32) {
  %prefix = test.addi %arg, %arg : i32
  cfg.br ^_bb1(%prefix: i32)
^_bb1(%value: i32):
  %condition = scalar.constant 1 : i1
  cfg.cond_br %condition, ^_bb2, ^_bb3
^_bb2:
  %doubled = test.addi %value, %value : i32
  cfg.br ^_bb4(%doubled: i32)
^_bb3:
  cfg.br ^_bb5(%value: i32)
^_bb4(%forwarded: i32):
  cfg.br ^_bb5(%forwarded: i32)
^_bb5(%selected: i32):
  %suffix = test.addi %selected, %arg : i32
  func.return %suffix : i32
}

// ====

// RUN: pass inline-callables

// Low functions use the same authored inline policy and shared CFG splice as
// semantic functions. Low-specific branch construction stays at this policy
// boundary so the reusable inliner does not learn target or dialect details.
test.target<low_core> @target

low.func.def inline target<test.low.core>(@target) @low_choose_path(%condition: reg<test.i32>, %value: reg<test.i32>) -> (reg<test.i32>) {
  low.cond_br %condition, ^identity, ^forward : reg<test.i32>
^identity:
  low.return %value : reg<test.i32>
^forward:
  low.br ^join(%value: reg<test.i32>)
^join(%forwarded: reg<test.i32>):
  low.return %forwarded : reg<test.i32>
}

low.func.def public target<test.low.core>(@target) @low_cfg_entry(%condition: reg<test.i32>, %arg: reg<test.i32>) -> (reg<test.i32>) {
  %prefix = low.copy %arg : reg<test.i32> -> reg<test.i32>
  %selected = low.func.call @low_choose_path(%condition, %prefix) : (reg<test.i32>, reg<test.i32>) -> (reg<test.i32>)
  %suffix = low.copy %selected : reg<test.i32> -> reg<test.i32>
  low.return %suffix : reg<test.i32>
}

// ----
test.target<low_core> @target

low.func.def public target<test.low.core>(@target) @low_cfg_entry(%condition$4: reg<test.i32>, %arg: reg<test.i32>) -> (reg<test.i32>) {
  %prefix = low.copy %arg : reg<test.i32> -> reg<test.i32>
  low.br ^_bb1(%condition$4: reg<test.i32>, %prefix: reg<test.i32>)
^_bb1(%condition$10: reg<test.i32>, %value: reg<test.i32>):
  low.cond_br %condition$10, ^_bb2, ^_bb3 : reg<test.i32>
^_bb2:
  low.br ^_bb5(%value: reg<test.i32>)
^_bb3:
  low.br ^_bb4(%value: reg<test.i32>)
^_bb4(%forwarded: reg<test.i32>):
  low.br ^_bb5(%forwarded: reg<test.i32>)
^_bb5(%selected: reg<test.i32>):
  %suffix = low.copy %selected : reg<test.i32> -> reg<test.i32>
  low.return %suffix : reg<test.i32>
}

// ====

// RUN: pass inline-callables

// A multi-block callee requires a CFG-capable containing region. The pass
// diagnoses this during global preflight instead of converting test.map's
// structurally single-block body into invalid CFG IR.
func.def inline @nested_cfg_identity(%value: f32) -> (f32) {
  cfg.br ^exit(%value: f32)
^exit(%forwarded: f32):
  func.return %forwarded : f32
}

func.def public @nested_cfg_caller(%input: tile<4xf32>) -> (tile<4xf32>) {
  %mapped = test.map(%element = %input : tile<4xf32>) {
    // ERROR@+1: LOWERING/044 {op_name="func.call", phase_name="inline-callables", callee_name="nested_cfg_identity", failure_code="caller_region_not_cfg_capable"}
    %result = func.call @nested_cfg_identity(%element) : (f32) -> (f32)
    test.yield %result : f32
  } -> (tile<4xf32>)
  func.return %mapped : tile<4xf32>
}

// ====

// RUN: pass inline-callables

// Materializing a locked helper is a complete normalization even when another
// call keeps the helper alive: both the clone and retained body carry explicit
// fences, and the retained helper no longer carries a redundant lock marker.
test.target<low_core> @target

low.func.def schedule(locked) target<test.low.core>(@target) @shared_locked(%value: reg<test.i32>) -> (reg<test.i32>) {
  %first = low.copy %value : reg<test.i32> -> reg<test.i32>
  %second = low.copy %first : reg<test.i32> -> reg<test.i32>
  low.return %second : reg<test.i32>
}

low.func.def public target<test.low.core>(@target) @inline_locked(%value: reg<test.i32>) -> (reg<test.i32>) {
  %result = low.func.call inline @shared_locked(%value) : (reg<test.i32>) -> (reg<test.i32>)
  low.return %result : reg<test.i32>
}

low.func.def public target<test.low.core>(@target) @retain_locked(%value: reg<test.i32>) -> (reg<test.i32>) {
  %result = low.func.call noinline @shared_locked(%value) : (reg<test.i32>) -> (reg<test.i32>)
  low.return %result : reg<test.i32>
}

// ----
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @shared_locked(%value: reg<test.i32>) -> (reg<test.i32>) {
  low.schedule.fence
  %first = low.copy %value : reg<test.i32> -> reg<test.i32>
  low.schedule.fence
  %second = low.copy %first : reg<test.i32> -> reg<test.i32>
  low.schedule.fence
  low.return %second : reg<test.i32>
}

low.func.def public target<test.low.core>(@target) @inline_locked(%value: reg<test.i32>) -> (reg<test.i32>) {
  low.schedule.fence
  %first = low.copy %value : reg<test.i32> -> reg<test.i32>
  low.schedule.fence
  %second = low.copy %first : reg<test.i32> -> reg<test.i32>
  low.schedule.fence
  low.return %second : reg<test.i32>
}

low.func.def public target<test.low.core>(@target) @retain_locked(%value: reg<test.i32>) -> (reg<test.i32>) {
  %result = low.func.call noinline @shared_locked(%value) : (reg<test.i32>) -> (reg<test.i32>)
  low.return %result : reg<test.i32>
}

// ====

// RUN: pass inline-callables

// Required-inline CFG shape propagates through the complete closure. Although
// the middle helper begins with one block, flattening its CFG leaf makes it a
// CFG callee before the outer edge executes.
func.def inline @closure_cfg_leaf(%value: i32) -> (i32) {
  cfg.br ^exit(%value: i32)
^exit(%forwarded: i32):
  func.return %forwarded : i32
}

func.def inline @closure_linear_middle(%value: i32) -> (i32) {
  %result = func.call @closure_cfg_leaf(%value) : (i32) -> (i32)
  func.return %result : i32
}

func.def public @closure_cfg_entry(%value: i32) -> (i32) {
  %result = func.call @closure_linear_middle(%value) : (i32) -> (i32)
  func.return %result : i32
}

// ----
func.def public @closure_cfg_entry(%value$6: i32) -> (i32) {
  cfg.br ^_bb1(%value$6: i32)
^_bb1(%value$12: i32):
  cfg.br ^_bb2(%value$12: i32)
^_bb2(%value$13: i32):
  cfg.br ^_bb3(%value$13: i32)
^_bb3(%forwarded: i32):
  cfg.br ^_bb4(%forwarded: i32)
^_bb4(%result$15: i32):
  cfg.br ^_bb5(%result$15: i32)
^_bb5(%result$16: i32):
  func.return %result$16 : i32
}

// ====

// RUN: pass inline-callables

// The same transitive shape prediction protects structurally single-block
// caller regions. The diagnostic is emitted during global preflight, before
// the CFG leaf is spliced into the middle helper.
func.def inline @nested_closure_cfg_leaf(%value: f32) -> (f32) {
  cfg.br ^exit(%value: f32)
^exit(%forwarded: f32):
  func.return %forwarded : f32
}

func.def inline @nested_closure_linear_middle(%value: f32) -> (f32) {
  %result = func.call @nested_closure_cfg_leaf(%value) : (f32) -> (f32)
  func.return %result : f32
}

func.def public @nested_closure_caller(%input: tile<4xf32>) -> (tile<4xf32>) {
  %mapped = test.map(%element = %input : tile<4xf32>) {
    // ERROR@+1: LOWERING/044 {op_name="func.call", phase_name="inline-callables", callee_name="nested_closure_linear_middle", failure_code="caller_region_not_cfg_capable"}
    %result = func.call @nested_closure_linear_middle(%element) : (f32) -> (f32)
    test.yield %result : f32
  } -> (tile<4xf32>)
  func.return %mapped : tile<4xf32>
}
