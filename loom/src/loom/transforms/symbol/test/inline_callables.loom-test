low.func.def noinline target<test.low.core>(@target) @kept_low_helper(%value: reg<test.i32>) -> (reg<test.i32>) asm {
  return %value
}

low.func.def public target<test.low.core>(@target) @kept_low_caller(%value: reg<test.i32>) -> (reg<test.i32>) asm {
  %result = low.func.call @kept_low_helper(%value) : (reg<test.i32>) -> (reg<test.i32>)
  return %result
}

