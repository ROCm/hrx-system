// ====

// RUN: pass inline-callables

// Multi-block callable inlining preserves block arguments, remaps successor
// edges, and joins every return through one continuation block.
func.def inline @choose_path(%value: i32) -> (i32) {
  %condition = scalar.constant 1 : i1
  cfg.cond_br %condition, ^double, ^identity
^double:
  %doubled = test.addi %value, %value : i32
  cfg.br ^join(%doubled: i32)
^identity:
  func.return %value : i32
^join(%forwarded: i32):
  func.return %forwarded : i32
}

func.def public @cfg_entry(%arg: i32) -> (i32) {
  %prefix = test.addi %arg, %arg : i32
  %selected = func.call @choose_path(%prefix) : (i32) -> (i32)
  %suffix = test.addi %selected, %arg : i32
  func.return %suffix : i32
}

// ----
func.def public @cfg_entry(%arg: i32) -> (i32) {
  %prefix = test.addi %arg, %arg : i32
  cfg.br ^_bb1(%prefix: i32)
^_bb1(%value: i32):
  %condition = scalar.constant 1 : i1
  cfg.cond_br %condition, ^_bb2, ^_bb3
^_bb2:
  %doubled = test.addi %value, %value : i32
  cfg.br ^_bb4(%doubled: i32)
^_bb3:
  cfg.br ^_bb5(%value: i32)
^_bb4(%forwarded: i32):
  cfg.br ^_bb5(%forwarded: i32)
^_bb5(%selected: i32):
  %suffix = test.addi %selected, %arg : i32
  func.return %suffix : i32
}

// ====

// RUN: pass inline-callables

// Low functions use the same authored inline policy and shared CFG splice as
// semantic functions. Low-specific branch construction stays at this policy
// boundary so the reusable inliner does not learn target or dialect details.
test.target<low_core> @target

low.func.def inline target<test.low.core>(@target) @low_choose_path(%condition: reg<test.i32>, %value: reg<test.i32>) -> (reg<test.i32>) asm {
  low.cond_br %condition, ^identity, ^forward : reg<test.i32>
^identity:
  return %value
^forward:
  low.br ^join(%value: reg<test.i32>)
^join(%forwarded: reg<test.i32>):
  return %forwarded
}

low.func.def public target<test.low.core>(@target) @low_cfg_entry(%condition: reg<test.i32>, %arg: reg<test.i32>) -> (reg<test.i32>) asm {
  %prefix = copy %arg : reg<test.i32> -> reg<test.i32>
  %selected = low.func.call @low_choose_path(%condition, %prefix) : (reg<test.i32>, reg<test.i32>) -> (reg<test.i32>)
  %suffix = copy %selected : reg<test.i32> -> reg<test.i32>
  return %suffix
}

// ----
test.target<low_core> @target

low.func.def public target<test.low.core>(@target) @low_cfg_entry(%condition$4: reg<test.i32>, %arg: reg<test.i32>) -> (reg<test.i32>) {
  %prefix = low.copy %arg : reg<test.i32> -> reg<test.i32>
  low.br ^_bb1(%condition$4: reg<test.i32>, %prefix: reg<test.i32>)
^_bb1(%condition$0: reg<test.i32>, %value: reg<test.i32>):
  low.cond_br %condition$0, ^_bb2, ^_bb3 : reg<test.i32>
^_bb2:
  low.br ^_bb5(%value: reg<test.i32>)
^_bb3:
  low.br ^_bb4(%value: reg<test.i32>)
^_bb4(%forwarded: reg<test.i32>):
  low.br ^_bb5(%forwarded: reg<test.i32>)
^_bb5(%selected: reg<test.i32>):
  %suffix = low.copy %selected : reg<test.i32> -> reg<test.i32>
  low.return %suffix : reg<test.i32>
}

// ====

// RUN: pass inline-callables

// A multi-block callee requires a CFG-capable containing region. The pass
// diagnoses this during global preflight instead of converting test.map's
// structurally single-block body into invalid CFG IR.
func.def inline @nested_cfg_identity(%value: f32) -> (f32) {
  cfg.br ^exit(%value: f32)
^exit(%forwarded: f32):
  func.return %forwarded : f32
}

func.def public @nested_cfg_caller(%input: tile<4xf32>) -> (tile<4xf32>) {
  %mapped = test.map(%element = %input : tile<4xf32>) {
    // ERROR@+1: LOWERING/044 {op_name="func.call", phase_name="inline-callables", callee_name="nested_cfg_identity", failure_code="caller_region_not_cfg_capable"}
    %result = func.call @nested_cfg_identity(%element) : (f32) -> (f32)
    test.yield %result : f32
  } -> (tile<4xf32>)
  func.return %mapped : tile<4xf32>
}

// ====

// RUN: pass inline-callables

// Materializing a locked helper is a complete normalization even when another
// call keeps the helper alive: both the clone and retained body carry explicit
// fences, and the retained helper no longer carries a redundant lock marker.
test.target<low_core> @target

low.func.def schedule(locked) target<test.low.core>(@target) @shared_locked(%value: reg<test.i32>) -> (reg<test.i32>) asm {
  %first = copy %value : reg<test.i32> -> reg<test.i32>
  %second = copy %first : reg<test.i32> -> reg<test.i32>
  return %second
}

low.func.def public target<test.low.core>(@target) @inline_locked(%value: reg<test.i32>) -> (reg<test.i32>) asm {
  %result = low.func.call inline @shared_locked(%value) : (reg<test.i32>) -> (reg<test.i32>)
  return %result
}

low.func.def public target<test.low.core>(@target) @retain_locked(%value: reg<test.i32>) -> (reg<test.i32>) asm {
  %result = low.func.call noinline @shared_locked(%value) : (reg<test.i32>) -> (reg<test.i32>)
  return %result
}

// ----
test.target<low_core> @target

low.func.def target<test.low.core>(@target) @shared_locked(%value: reg<test.i32>) -> (reg<test.i32>) {
  low.schedule.fence
  %first = low.copy %value : reg<test.i32> -> reg<test.i32>
  low.schedule.fence
  %second = low.copy %first : reg<test.i32> -> reg<test.i32>
  low.schedule.fence
  low.return %second : reg<test.i32>
}

low.func.def public target<test.low.core>(@target) @inline_locked(%value: reg<test.i32>) -> (reg<test.i32>) {
  low.schedule.fence
  %first = low.copy %value : reg<test.i32> -> reg<test.i32>
  low.schedule.fence
  %second = low.copy %first : reg<test.i32> -> reg<test.i32>
  low.schedule.fence
  low.return %second : reg<test.i32>
}

low.func.def public target<test.low.core>(@target) @retain_locked(%value: reg<test.i32>) -> (reg<test.i32>) {
  %result = low.func.call noinline @shared_locked(%value) : (reg<test.i32>) -> (reg<test.i32>)
  low.return %result : reg<test.i32>
}

// ====

// RUN: pass inline-callables

// Required-inline CFG shape propagates through the complete closure for
// preflight. Execution moves the single-use wrapper outward before consuming
// its CFG leaf, so the wrapper disappears without cloning an expanded body.
func.def inline @closure_cfg_leaf(%value: i32) -> (i32) {
  cfg.br ^exit(%value: i32)
^exit(%forwarded: i32):
  func.return %forwarded : i32
}

func.def inline @closure_linear_middle(%value: i32) -> (i32) {
  %result = func.call @closure_cfg_leaf(%value) : (i32) -> (i32)
  func.return %result : i32
}

func.def public @closure_cfg_entry(%value: i32) -> (i32) {
  %result = func.call @closure_linear_middle(%value) : (i32) -> (i32)
  func.return %result : i32
}

// ----
func.def public @closure_cfg_entry(%value$6: i32) -> (i32) {
  cfg.br ^_bb1(%value$6: i32)
^_bb1(%value$0: i32):
  cfg.br ^_bb2(%value$0: i32)
^_bb2(%forwarded: i32):
  cfg.br ^_bb3(%forwarded: i32)
^_bb3(%result: i32):
  func.return %result : i32
}

// ====

// RUN: pass inline-callables

// A linear nested call is transferred before its CFG parent moves. This keeps
// the topology-preserving path available and carries the producer with the
// parent CFG instead of manufacturing another pair of blocks.
func.def inline @nested_linear_double(%nested_value: i32) -> (i32) {
  %nested_doubled = test.addi %nested_value, %nested_value : i32
  func.return %nested_doubled : i32
}

func.def inline @outer_cfg_compose(%outer_value: i32) -> (i32) {
  %outer_doubled = func.call @nested_linear_double(%outer_value) : (i32) -> (i32)
  cfg.br ^exit(%outer_doubled: i32)
^exit(%outer_forwarded: i32):
  func.return %outer_forwarded : i32
}

func.def public @nested_linear_cfg_entry(%entry_value: i32) -> (i32) {
  %entry_result = func.call @outer_cfg_compose(%entry_value) : (i32) -> (i32)
  func.return %entry_result : i32
}

// ----
func.def public @nested_linear_cfg_entry(%entry_value: i32) -> (i32) {
  cfg.br ^_bb1(%entry_value: i32)
^_bb1(%outer_value: i32):
  %nested_doubled = test.addi %outer_value, %outer_value : i32
  cfg.br ^_bb2(%nested_doubled: i32)
^_bb2(%outer_forwarded: i32):
  cfg.br ^_bb3(%outer_forwarded: i32)
^_bb3(%entry_result: i32):
  func.return %entry_result : i32
}

// ====

// RUN: pass inline-callables

// Nested CFG blocks are inserted immediately after their call block. This
// preserves definition-before-use ordering when a result is used directly in
// a dominated outer block instead of being forwarded as its block argument.
test.target<low_core> @nested_cfg_target

low.func.def inline target<test.low.core>(@nested_cfg_target) @nested_cfg_child(%child_value: reg<test.i32>) -> (reg<test.i32>) asm {
  low.br ^child_exit(%child_value: reg<test.i32>)
^child_exit(%child_forwarded: reg<test.i32>):
  return %child_forwarded
}

low.func.def inline target<test.low.core>(@nested_cfg_target) @nested_cfg_parent(%parent_value: reg<test.i32>) -> (reg<test.i32>) asm {
  %parent_result = low.func.call @nested_cfg_child(%parent_value) : (reg<test.i32>) -> (reg<test.i32>)
  low.br ^parent_exit
^parent_exit:
  return %parent_result
}

low.func.def public target<test.low.core>(@nested_cfg_target) @nested_cfg_entry(%entry_value: reg<test.i32>) -> (reg<test.i32>) asm {
  %entry_result = low.func.call @nested_cfg_parent(%entry_value) : (reg<test.i32>) -> (reg<test.i32>)
  return %entry_result
}

// ----
test.target<low_core> @nested_cfg_target

low.func.def public target<test.low.core>(@nested_cfg_target) @nested_cfg_entry(%entry_value: reg<test.i32>) -> (reg<test.i32>) {
  low.br ^_bb1(%entry_value: reg<test.i32>)
^_bb1(%parent_value: reg<test.i32>):
  low.br ^_bb2(%parent_value: reg<test.i32>)
^_bb2(%child_value: reg<test.i32>):
  low.br ^_bb3(%child_value: reg<test.i32>)
^_bb3(%child_forwarded: reg<test.i32>):
  low.br ^_bb4(%child_forwarded: reg<test.i32>)
^_bb4(%parent_result: reg<test.i32>):
  low.br ^_bb5
^_bb5:
  low.br ^_bb6(%parent_result: reg<test.i32>)
^_bb6(%entry_result: reg<test.i32>):
  low.return %entry_result : reg<test.i32>
}

// ====

// RUN: pass inline-callables

// A value produced after the nested call is used directly from an existing
// later block. The nested splice must precede that block so moving the whole
// operation tail into its continuation preserves lexical SSA scope.
func.def inline @tail_scope_leaf(%leaf_value: i32) -> (i32) {
  cfg.br ^leaf_exit(%leaf_value: i32)
^leaf_exit(%leaf_forwarded: i32):
  func.return %leaf_forwarded : i32
}

func.def inline @tail_scope_parent(%parent_value: i32) -> (i32) {
  %child_result = func.call @tail_scope_leaf(%parent_value) : (i32) -> (i32)
  %tail_result = test.addi %child_result, %child_result : i32
  cfg.br ^parent_exit
^parent_exit:
  func.return %tail_result : i32
}

func.def public @tail_scope_entry(%entry_value: i32) -> (i32) {
  %entry_result = func.call @tail_scope_parent(%entry_value) : (i32) -> (i32)
  func.return %entry_result : i32
}

// ----
func.def public @tail_scope_entry(%entry_value: i32) -> (i32) {
  cfg.br ^_bb1(%entry_value: i32)
^_bb1(%parent_value: i32):
  cfg.br ^_bb2(%parent_value: i32)
^_bb2(%leaf_value: i32):
  cfg.br ^_bb3(%leaf_value: i32)
^_bb3(%leaf_forwarded: i32):
  cfg.br ^_bb4(%leaf_forwarded: i32)
^_bb4(%child_result: i32):
  %tail_result = test.addi %child_result, %child_result : i32
  cfg.br ^_bb5
^_bb5:
  cfg.br ^_bb6(%tail_result: i32)
^_bb6(%entry_result: i32):
  func.return %entry_result : i32
}

// ====

// RUN: pass inline-callables

// A shared CFG wrapper exercises both execution dependencies. Its nested leaf
// must be flattened before the wrapper is cloned, and the clone must complete
// before the final use consumes and erases the wrapper definition.
func.def inline @shared_cfg_leaf(%leaf_value: i32) -> (i32) {
  cfg.br ^exit(%leaf_value: i32)
^exit(%leaf_forwarded: i32):
  func.return %leaf_forwarded : i32
}

func.def inline @shared_cfg_wrapper(%wrapper_value: i32) -> (i32) {
  %wrapper_result = func.call @shared_cfg_leaf(%wrapper_value) : (i32) -> (i32)
  func.return %wrapper_result : i32
}

func.def public @clone_cfg_wrapper(%clone_value: i32) -> (i32) {
  %clone_result = func.call @shared_cfg_wrapper(%clone_value) : (i32) -> (i32)
  func.return %clone_result : i32
}

func.def public @consume_cfg_wrapper(%consume_value: i32) -> (i32) {
  %consume_result = func.call @shared_cfg_wrapper(%consume_value) : (i32) -> (i32)
  func.return %consume_result : i32
}

// ----
func.def public @clone_cfg_wrapper(%clone_value: i32) -> (i32) {
  cfg.br ^_bb1(%clone_value: i32)
^_bb1(%wrapper_value: i32):
  cfg.br ^_bb2(%wrapper_value: i32)
^_bb2(%leaf_value: i32):
  cfg.br ^_bb3(%leaf_value: i32)
^_bb3(%leaf_forwarded: i32):
  cfg.br ^_bb4(%leaf_forwarded: i32)
^_bb4(%wrapper_result: i32):
  cfg.br ^_bb5(%wrapper_result: i32)
^_bb5(%clone_result: i32):
  func.return %clone_result : i32
}

func.def public @consume_cfg_wrapper(%consume_value: i32) -> (i32) {
  cfg.br ^_bb1(%consume_value: i32)
^_bb1(%wrapper_value: i32):
  cfg.br ^_bb2(%wrapper_value: i32)
^_bb2(%leaf_value: i32):
  cfg.br ^_bb3(%leaf_value: i32)
^_bb3(%leaf_forwarded: i32):
  cfg.br ^_bb4(%leaf_forwarded: i32)
^_bb4(%wrapper_result: i32):
  cfg.br ^_bb5(%wrapper_result: i32)
^_bb5(%consume_result: i32):
  func.return %consume_result : i32
}

// ====

// RUN: pass inline-callables

// The same transitive shape prediction protects structurally single-block
// caller regions. The diagnostic is emitted during global preflight, before
// the CFG leaf is spliced into the middle helper.
func.def inline @nested_closure_cfg_leaf(%value: f32) -> (f32) {
  cfg.br ^exit(%value: f32)
^exit(%forwarded: f32):
  func.return %forwarded : f32
}

func.def inline @nested_closure_linear_middle(%value: f32) -> (f32) {
  %result = func.call @nested_closure_cfg_leaf(%value) : (f32) -> (f32)
  func.return %result : f32
}

func.def public @nested_closure_caller(%input: tile<4xf32>) -> (tile<4xf32>) {
  %mapped = test.map(%element = %input : tile<4xf32>) {
    // ERROR@+1: LOWERING/044 {op_name="func.call", phase_name="inline-callables", callee_name="nested_closure_linear_middle", failure_code="caller_region_not_cfg_capable"}
    %result = func.call @nested_closure_linear_middle(%element) : (f32) -> (f32)
    test.yield %result : f32
  } -> (tile<4xf32>)
  func.return %mapped : tile<4xf32>
}
