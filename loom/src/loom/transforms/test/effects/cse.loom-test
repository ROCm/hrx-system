// CSE must use effective traits, not only static vtable traits. func.call is
// statically unknown-effect, but canonicalize can stamp pure call sites when
// the callee body has no observable effects.
// RUN: pass canonicalize,cse
func.def @pure_identity(%value: i32) -> (i32) {
  func.return %value : i32
}

func.def @pure_calls_cse_after_canonicalize(%value: i32) -> (i32, i32) {
  %lhs = func.call @pure_identity(%value) : (i32) -> (i32)
  %rhs = func.call @pure_identity(%value) : (i32) -> (i32)
  func.return %lhs, %rhs : i32, i32
}

// ----
func.def @pure_identity(%value: i32) -> (i32) {
  func.return %value : i32
}

func.def @pure_calls_cse_after_canonicalize(%value: i32) -> (i32, i32) {
  %lhs = func.call pure @pure_identity(%value) : (i32) -> (i32)
  func.return %lhs, %lhs : i32, i32
}

// ====

// A pure effect contract permits dead applications to disappear, but it does
// not make pending source-expansion sites interchangeable before selection.
// RUN: pass canonicalize,cse
template.decl @test.effect(%value: i32) -> (i32)

func.def @pure_applies_retain_source_context(%value: i32) -> (i32, i32) {
  %lhs = template.apply<@test.effect>(%value) pure : (i32) -> (i32)
  %rhs = template.apply<@test.effect>(%value) pure : (i32) -> (i32)
  func.return %lhs, %rhs : i32, i32
}

// ----
template.decl @test.effect(%value: i32) -> (i32)

func.def @pure_applies_retain_source_context(%value: i32) -> (i32, i32) {
  %lhs = template.apply<@test.effect>(%value) pure : (i32) -> (i32)
  %rhs = template.apply<@test.effect>(%value) pure : (i32) -> (i32)
  func.return %lhs, %rhs : i32, i32
}

// ====

// Unresolved or effectful callees remain unknown-effect. Even identical calls
// are not CSE candidates until a pass has explicit proof that the callee is
// pure.
// RUN: pass canonicalize,cse
func.decl @unknown_effects(%value: i32) -> (i32)

func.def @unknown_effect_calls_do_not_cse(%value: i32) -> (i32, i32) {
  %lhs = func.call @unknown_effects(%value) : (i32) -> (i32)
  %rhs = func.call @unknown_effects(%value) : (i32) -> (i32)
  func.return %lhs, %rhs : i32, i32
}

// ====

// Convergent ops are not CSE candidates even when they are memory-pure and
// operand-identical.
// RUN: pass cse
func.def @convergent_ops_do_not_cse(%value: i32) -> (i32, i32) {
  %lhs = test.convergent %value : i32
  %rhs = test.convergent %value : i32
  func.return %lhs, %rhs : i32, i32
}

// ====

// Memory fences are observable ordering points and cannot be CSE'd even when
// they produce operand-identical results.
// RUN: pass cse
func.def @memory_fences_do_not_cse(%value: i32) -> (i32, i32) {
  %lhs = test.memory_fence %value : i32
  %rhs = test.memory_fence %value : i32
  func.return %lhs, %rhs : i32, i32
}

// ====

// Independently observable ops remain distinct even when their attributes
// match.
// RUN: pass cse
func.def @observable_ops_do_not_cse() -> (i32, i32) {
  %lhs = test.effectful_constant 42 : i32
  %rhs = test.effectful_constant 42 : i32
  func.return %lhs, %rhs : i32, i32
}

// ====

// Volatile reads of the same address are separate observations.
// RUN: pass cse
func.def @volatile_loads_do_not_cse(%buffer: buffer, %offset: offset) -> (i32, i32) {
  %view = buffer.view %buffer[%offset] : buffer -> view<1xi32>
  %lhs = view.load<volatile> %view[0] : view<1xi32> -> i32
  %rhs = view.load<volatile> %view[0] : view<1xi32> -> i32
  func.return %lhs, %rhs : i32, i32
}

// ====

// Function passes still run over the function-like body projection. CSE can be
// driven over every root region. Equivalent expressions are only shared inside
// one region tree; config and body keep separate SSA scopes.
// RUN: pass cse
test.split_func @split_func_all_regions_cse(%arg: i32) {
  %cfg_lhs = test.addi %arg, %arg : i32
  %cfg_rhs = test.addi %arg, %arg : i32
  test.use %cfg_lhs, %cfg_rhs : i32, i32
  test.yield
} launch {
  %body_lhs = test.addi %arg, %arg : i32
  %body_rhs = test.addi %arg, %arg : i32
  test.use %body_lhs, %body_rhs : i32, i32
  test.yield
}

// ----
test.split_func @split_func_all_regions_cse(%arg: i32) {
  %cfg_lhs = test.addi %arg, %arg : i32
  test.use %cfg_lhs, %cfg_lhs : i32, i32
  test.yield
} launch {
  %body_lhs = test.addi %arg, %arg : i32
  test.use %body_lhs, %body_lhs : i32, i32
  test.yield
}

// ====

// A write nested inside a region op is a barrier for memory reads in the
// enclosing scope. The second load must not be replaced with the first load.
// RUN: pass cse
func.def @nested_write_blocks_outer_load_cse(%cond: i1, %buffer: buffer, %offset: offset, %value: f32) -> (f32) {
  %layout = encoding.layout.dense : encoding<layout>
  %view = buffer.view %buffer[%offset] : buffer -> view<1xf32, %layout>
  %before = view.load %view[0] : view<1xf32, %layout> -> f32
  scf.if %cond {
    view.store %value, %view[0] : f32, view<1xf32, %layout>
  } else {
  }
  %after = view.load %view[0] : view<1xf32, %layout> -> f32
  func.return %after : f32
}

// ----
func.def @nested_write_blocks_outer_load_cse(%cond: i1, %buffer: buffer, %offset: offset, %value: f32) -> (f32) {
  %layout = encoding.layout.dense : encoding<layout>
  %view = buffer.view %buffer[%offset] : buffer -> view<1xf32, %layout>
  %before = view.load %view[0] : view<1xf32, %layout> -> f32
  scf.if %cond {
    view.store %value, %view[0] : f32, view<1xf32, %layout>
  } else {
  }
  %after = view.load %view[0] : view<1xf32, %layout> -> f32
  func.return %after : f32
}

// ====

// scf.while contributes both before/after region effects to the parent op's
// summary, so a nested write still blocks CSE of surrounding loads.
// RUN: pass cse
func.def @nested_while_write_blocks_outer_load_cse(%cond: i1, %buffer: buffer, %offset: offset, %value: f32) -> (f32) {
  %layout = encoding.layout.dense : encoding<layout>
  %view = buffer.view %buffer[%offset] : buffer -> view<1xf32, %layout>
  %before = view.load %view[0] : view<1xf32, %layout> -> f32
  %result = scf.while(%loop_value = %value : f32) -> (f32) {
    scf.condition %cond, %loop_value : i1, f32
  } do(%body: f32) {
    view.store %body, %view[0] : f32, view<1xf32, %layout>
    scf.yield %body : f32
  }
  %after = view.load %view[0] : view<1xf32, %layout> -> f32
  func.return %after : f32
}

// ====

// Source convergence constrains the collective, not the lifetime of dominating
// immutable SSA values. The collective remains while pure computation shares.
// RUN: pass cse

func.def @convergent_barriers_pure_cse() -> (i32, i32, i32) {
  %before = test.constant 7 : i32
  %barrier = test.convergent %before : i32
  %after = test.constant 7 : i32
  %sum = test.addi %before, %after : i32
  func.return %sum, %after, %barrier : i32, i32, i32
}

// ----
func.def @convergent_barriers_pure_cse() -> (i32, i32, i32) {
  %before = test.constant 7 : i32
  %barrier = test.convergent %before : i32
  %sum = test.addi %before, %before : i32
  func.return %sum, %before, %barrier : i32, i32, i32
}

// ====

// Repeated collectives do not invalidate source SSA expressions. Convergent
// operations themselves remain distinct, including adjacent identical ones.
// RUN: pass cse
func.def @successive_convergent_epochs(%value: i32) -> (i32, i32, i32, i32) {
  %before = test.addi %value, %value : i32
  %first_barrier = test.convergent %value : i32
  %empty_barrier = test.convergent %value : i32
  %middle = test.addi %value, %value : i32
  %middle_duplicate = test.addi %value, %value : i32
  %last_barrier = test.convergent %middle : i32
  %after = test.addi %value, %value : i32
  %after_duplicate = test.addi %value, %value : i32
  func.return %before, %middle_duplicate, %after, %after_duplicate : i32, i32, i32, i32
}

// ----
func.def @successive_convergent_epochs(%value: i32) -> (i32, i32, i32, i32) {
  %before = test.addi %value, %value : i32
  %first_barrier = test.convergent %value : i32
  %empty_barrier = test.convergent %value : i32
  %last_barrier = test.convergent %before : i32
  func.return %before, %before, %before, %before : i32, i32, i32, i32
}

// ====

// Memory reads still respect stores and convergence boundaries. Sharing pure
// source expressions does not authorize sharing a reload across a collective.
// RUN: pass cse
func.def @convergent_after_read_reinsertion(%buffer: buffer, %offset: offset, %value: i32) -> (i32, i32, i32, i32) {
  %layout = encoding.layout.dense : encoding<layout>
  %view = buffer.view %buffer[%offset] : buffer -> view<1xi32, %layout>
  %before = view.load %view[0] : view<1xi32, %layout> -> i32
  view.store %value, %view[0] : i32, view<1xi32, %layout>
  %middle = view.load %view[0] : view<1xi32, %layout> -> i32
  %barrier = test.convergent %value : i32
  %after = view.load %view[0] : view<1xi32, %layout> -> i32
  %duplicate = view.load %view[0] : view<1xi32, %layout> -> i32
  func.return %before, %middle, %after, %duplicate : i32, i32, i32, i32
}

// ----
func.def @convergent_after_read_reinsertion(%buffer: buffer, %offset: offset, %value: i32) -> (i32, i32, i32, i32) {
  %layout = encoding.layout.dense : encoding<layout>
  %view = buffer.view %buffer[%offset] : buffer -> view<1xi32, %layout>
  %before = view.load %view[0] : view<1xi32, %layout> -> i32
  view.store %value, %view[0] : i32, view<1xi32, %layout>
  %middle = view.load %view[0] : view<1xi32, %layout> -> i32
  %barrier = test.convergent %value : i32
  %after = view.load %view[0] : view<1xi32, %layout> -> i32
  func.return %before, %middle, %after, %after : i32, i32, i32, i32
}

// ====

// A dominating source value remains available in nested and later scopes even
// when the nested region contains a collective. The collective remains intact.
// RUN: pass cse
func.def @pure_values_across_nested_collectives(%condition: i1, %value: i32) -> (i32, i32) {
  %before = test.addi %value, %value : i32
  scf.if %condition {
    %barrier = test.convergent %value : i32
    %inner = test.addi %value, %value : i32
    %duplicate = test.addi %value, %value : i32
    test.use %inner, %duplicate : i32, i32
  } else {
  }
  %after = test.addi %value, %value : i32
  %after_duplicate = test.addi %value, %value : i32
  func.return %before, %after_duplicate : i32, i32
}

// ----
func.def @pure_values_across_nested_collectives(%condition: i1, %value: i32) -> (i32, i32) {
  %before = test.addi %value, %value : i32
  scf.if %condition {
    %barrier = test.convergent %value : i32
    test.use %before, %before : i32, i32
  } else {
  }
  func.return %before, %before : i32, i32
}

// ====

// Results consumed by a moved-result operation retain distinct SSA ownership
// identities. Folding the second borrowed result into the first would make the
// later borrow of %lhs a use after move.
// RUN: pass cse
func.def @moved_result_consumption_blocks_cse(%resource: pool) {
  %lhs = test.resource.borrowed %resource : pool -> pool
  %rhs = test.resource.borrowed %resource : pool -> pool
  %moved = test.resource.move %rhs : pool -> pool
  test.resource.borrow %lhs : pool
  test.resource.borrow %moved : pool
  func.return
}

// ----
func.def @moved_result_consumption_blocks_cse(%resource: pool) {
  %lhs = test.resource.borrowed %resource : pool -> pool
  %rhs = test.resource.borrowed %resource : pool -> pool
  %moved = test.resource.move %rhs : pool -> pool
  test.resource.borrow %lhs : pool
  test.resource.borrow %moved : pool
  func.return
}

// ====


// Each nested function owns a separate CFG. Dominance-based reuse keeps
// candidates within their function, including non-entry definitions.
// RUN: pass cse
func.def @independent_nested_cfgs() {
  func.def @entry_definition(%row: i32) -> (i32) {
    %row_bytes = test.addi %row, %row : i32
    cfg.br ^finish
  ^finish:
    %result = test.addi %row, %row : i32
    func.return %result : i32
  }
  func.def @later_definition(%column: i32) -> (i32) {
    cfg.br ^define
  ^define:
    %column_bytes = test.addi %column, %column : i32
    cfg.br ^finish
  ^finish:
    %result = test.addi %column, %column : i32
    func.return %result : i32
  }
  func.return
}

// ----
func.def @independent_nested_cfgs() {
  func.def @entry_definition(%row: i32) -> (i32) {
    %row_bytes = test.addi %row, %row : i32
    cfg.br ^finish
  ^finish:
    func.return %row_bytes : i32
  }
  func.def @later_definition(%column: i32) -> (i32) {
    cfg.br ^define
  ^define:
    %column_bytes = test.addi %column, %column : i32
    cfg.br ^finish
  ^finish:
    func.return %column_bytes : i32
  }
  func.return
}

// ====


// Source SSA availability survives nested collectives through empty scopes.
// RUN: pass cse
func.def @dominating_values_through_nested_collectives(%condition: i1, %row: i32) -> (i32, i32, i32, i32) {
  %before = test.addi %row, %row : i32
  scf.if %condition {
    %first_barrier = test.convergent %row : i32
  } else {
  }
  %middle = test.addi %row, %row : i32
  scf.if %condition {
    scf.if %condition {
      %second_barrier = test.convergent %row : i32
    } else {
    }
  } else {
  }
  %after = test.addi %row, %row : i32
  %duplicate = test.addi %row, %row : i32
  func.return %before, %middle, %after, %duplicate : i32, i32, i32, i32
}

// ----
func.def @dominating_values_through_nested_collectives(%condition: i1, %row: i32) -> (i32, i32, i32, i32) {
  %before = test.addi %row, %row : i32
  scf.if %condition {
    %first_barrier = test.convergent %row : i32
  } else {
  }
  scf.if %condition {
    scf.if %condition {
      %second_barrier = test.convergent %row : i32
    } else {
    }
  } else {
  }
  func.return %before, %before, %before, %before : i32, i32, i32, i32
}

// ====


// Read-only membership is rearmed independently of full invalidation. Nested
// stores discard each load epoch while the pure address and value survive.
// RUN: pass cse
func.def @rearm_outer_reads(%condition: i1, %buffer: buffer, %offset: offset, %value: i32) -> (i32, i32, i32, i32) {
  %layout = encoding.layout.dense : encoding<layout>
  %view = buffer.view %buffer[%offset] : buffer -> view<1xi32, %layout>
  %value_twice = test.addi %value, %value : i32
  %before = view.load %view[0] : view<1xi32, %layout> -> i32
  scf.if %condition {
    view.store %value_twice, %view[0] : i32, view<1xi32, %layout>
  } else {
  }
  %middle = view.load %view[0] : view<1xi32, %layout> -> i32
  scf.if %condition {
    scf.if %condition {
      view.store %value_twice, %view[0] : i32, view<1xi32, %layout>
    } else {
    }
  } else {
  }
  %after = view.load %view[0] : view<1xi32, %layout> -> i32
  %duplicate = view.load %view[0] : view<1xi32, %layout> -> i32
  %same_value = test.addi %value, %value : i32
  func.return %before, %middle, %duplicate, %same_value : i32, i32, i32, i32
}

// ----
func.def @rearm_outer_reads(%condition: i1, %buffer: buffer, %offset: offset, %value: i32) -> (i32, i32, i32, i32) {
  %layout = encoding.layout.dense : encoding<layout>
  %view = buffer.view %buffer[%offset] : buffer -> view<1xi32, %layout>
  %value_twice = test.addi %value, %value : i32
  %before = view.load %view[0] : view<1xi32, %layout> -> i32
  scf.if %condition {
    view.store %value_twice, %view[0] : i32, view<1xi32, %layout>
  } else {
  }
  %middle = view.load %view[0] : view<1xi32, %layout> -> i32
  scf.if %condition {
    scf.if %condition {
      view.store %value_twice, %view[0] : i32, view<1xi32, %layout>
    } else {
    }
  } else {
  }
  %after = view.load %view[0] : view<1xi32, %layout> -> i32
  func.return %before, %middle, %after, %value_twice : i32, i32, i32, i32
}
