// ====

func.decl pure @observe_address(%values: view<16xi8>) -> (i8)

func.decl @external()

func.def noinline @read(%values: view<16xi8>) -> (i8) {
  %value = view.load %values[0] : view<16xi8> -> i8
  func.return %value : i8
}

func.def noinline @write(%values: view<16xi8>, %value: i8) {
  view.store %value, %values[0] : i8, view<16xi8>
  func.return
}

func.def noinline @write_root(%root: buffer, %value: i8) {
  %base = index.constant 0 : offset
  %values = buffer.view %root[%base] : buffer -> view<16xi8>
  view.store %value, %values[0] : i8, view<16xi8>
  func.return
}

// Read/read overlap, disjoint intervals of one root, and distinct allocations
// remain legal. Waiting retires the restriction on opaque and overlapping calls.
func.def @allows_independent_calls(%input: buffer) -> (i8) {
  %base = index.constant 0 : offset
  %adjacent = index.constant 16 : offset
  %bytes = index.constant 64 : offset
  %global = buffer.assume.memory_space<global> %input : buffer
  %source = buffer.view %global[%base] : buffer -> view<16xi8>
  %scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  %independent = buffer.alloca<workgroup> align(16) %bytes : buffer
  %dest = buffer.view %scratch[%base] : buffer -> view<16xi8>
  %other = buffer.view %scratch[%adjacent] : buffer -> view<16xi8>
  %copy = kernel.async.copy %source to %dest {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<16xi8> to view<16xi8> -> kernel.async.token
  %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
  %address = func.call pure @observe_address(%dest) : (view<16xi8>) -> (i8)
  %source_value = func.call @read(%source) : (view<16xi8>) -> (i8)
  func.call @write(%other, %source_value) : (view<16xi8>, i8)
  func.call @write_root(%independent, %address) : (buffer, i8)
  kernel.async.wait %group {newer_groups = 0} : kernel.async.group
  func.call @external() : ()
  %result = func.call @read(%dest) : (view<16xi8>) -> (i8)
  func.return %result : i8
}

// ====

test.target<low_core> @target

low.func.decl target<test.low.core>(@target) @native_access()

func.def @rejects_opaque_native_access(%input: buffer) {
  %base = index.constant 0 : offset
  %bytes = index.constant 64 : offset
  %global = buffer.assume.memory_space<global> %input : buffer
  %source = buffer.view %global[%base] : buffer -> view<16xi8>
  %scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  %dest = buffer.view %scratch[%base] : buffer -> view<16xi8>
  %copy = kernel.async.copy %source to %dest {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<16xi8> to view<16xi8> -> kernel.async.token
  %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
  // ERROR@+1: LOWERING/070 {op_name="low.invoke", phase_name="kernel-synchronization-legality"}
  low.invoke @native_access() : ()
  kernel.async.wait %group {newer_groups = 0} : kernel.async.group
  func.return
}

