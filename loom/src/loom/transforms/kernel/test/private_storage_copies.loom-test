// RUN: pass promote-private-fragments,dce

// Only the last word of this copy is subsequently read. A write to its source
// after the copy must not change the value observed through the destination.
func.def @sparse_copy(%first: i32, %later: i32) -> (i32, i32) {
  %bytes = index.constant 1073741824 : offset
  %origin = index.constant 0 : index
  %last = index.constant 1073741820 : index
  %source = buffer.alloca<private> align(4) %bytes : buffer
  %target = buffer.alloca<private> align(4) %bytes : buffer
  %original = buffer.view %source[%last] : buffer -> view<1xi32>
  %copy = buffer.view %target[%last] : buffer -> view<1xi32>
  view.store %first, %original[0] : i32, view<1xi32>
  buffer.copy %source[%origin], %target[%origin], %bytes
  view.store %later, %original[0] : i32, view<1xi32>
  %before = view.load %copy[0] : view<1xi32> -> i32
  %after = view.load %original[0] : view<1xi32> -> i32
  func.return %before, %after : i32, i32
}

// ----
func.def @sparse_copy(%first: i32, %later: i32) -> (i32, i32) {
  func.return %first, %later : i32, i32
}

// ====

// The two halves of one allocation are disjoint. A conditional copy updates
// only the target cell on the taken path.
func.def @conditional_copy(%a: f32, %b: f32, %enabled: i1) -> (f32) {
  %bytes = index.constant 8 : offset
  %word = index.constant 4 : offset
  %origin = index.constant 0 : index
  %storage = buffer.alloca<private> align(4) %bytes : buffer
  %values = buffer.view %storage[%origin] : buffer -> view<2xf32>
  view.store %a, %values[0] : f32, view<2xf32>
  view.store %b, %values[1] : f32, view<2xf32>
  scf.if %enabled {
    buffer.copy %storage[%origin], %storage[%word], %word
  }
  %chosen = view.load %values[1] : view<2xf32> -> f32
  func.return %chosen : f32
}

// ----
func.def @conditional_copy(%a: f32, %b: f32, %enabled: i1) -> (f32) {
  %10 = scf.if %enabled -> (f32) {
    scf.yield %a : f32
  } else {
    scf.yield %b : f32
  }
  func.return %10 : f32
}

// ====

// A partial overwrite cannot supply the complete i32 read. All three
// allocations must keep their stores and both physical copies.
func.def @partial_word(%a: i32, %b: i32) -> (i32) {
  %bytes = index.constant 4 : offset
  %single_byte = index.constant 1 : offset
  %origin = index.constant 0 : offset
  %source = buffer.alloca<private> align(4) %bytes : buffer
  %middle = buffer.alloca<private> align(4) %bytes : buffer
  %target = buffer.alloca<private> align(4) %bytes : buffer
  %original = buffer.view %source[%origin] : buffer -> view<1xi32>
  %result = buffer.view %target[%origin] : buffer -> view<1xi32>
  view.store %a, %original[0] : i32, view<1xi32>
  view.store %b, %result[0] : i32, view<1xi32>
  buffer.copy %source[%origin], %middle[%origin], %bytes
  buffer.copy %middle[%origin], %target[%single_byte], %single_byte
  %mixed = view.load %result[0] : view<1xi32> -> i32
  func.return %mixed : i32
}

// ====

// Pointer indexing rebases a fresh scalar view each iteration. Only the
// second element is observed, and the source changes after the copy.
func.def @rebased_copy(%original: i32, %later: i32) -> (i32, i32) {
  %bytes = index.constant 12 : offset
  %origin = index.constant 0 : index
  %word = index.constant 4 : index
  %limit = index.constant 12 : index
  %source = buffer.alloca<private> align(4) %bytes : buffer
  %target = buffer.alloca<private> align(4) %bytes : buffer
  %input = buffer.view %source[%origin] : buffer -> view<3xi32>
  %output = buffer.view %target[%word] : buffer -> view<1xi32>
  view.store %original, %input[1] : i32, view<3xi32>
  scf.for %byte = [%origin to %limit step %word] {
    %from = buffer.view %source[%byte] : buffer -> view<1xi32>
    %value = view.load %from[0] : view<1xi32> -> i32
    %to = buffer.view %target[%byte] : buffer -> view<1xi32>
    view.store %value, %to[0] : i32, view<1xi32>
  }
  view.store %later, %input[1] : i32, view<3xi32>
  %before = view.load %output[0] : view<1xi32> -> i32
  %after = view.load %input[1] : view<3xi32> -> i32
  func.return %before, %after : i32, i32
}

// ----
func.def @rebased_copy(%original: i32, %later: i32) -> (i32, i32) {
  func.return %original, %later : i32, i32
}

// ====

// A shaped index at the source and a shifted byte offset at the destination
// identify corresponding i16 lanes. Each lane has a distinct reaching value.
func.def @mixed_indexing(%a: i16, %b: i16, %c: i16) -> (i16, i16, i16) {
  %bytes = index.constant 6 : offset
  %origin = index.constant 0 : index
  %step = index.constant 1 : index
  %limit = index.constant 3 : index
  %source = buffer.alloca<private> align(2) %bytes : buffer
  %target = buffer.alloca<private> align(2) %bytes : buffer
  %input = buffer.view %source[%origin] : buffer -> view<3xi16>
  %output = buffer.view %target[%origin] : buffer -> view<3xi16>
  view.store %a, %input[0] : i16, view<3xi16>
  view.store %b, %input[1] : i16, view<3xi16>
  view.store %c, %input[2] : i16, view<3xi16>
  scf.for %i = [%origin to %limit step %step] {
    %value = view.load %input[%i] : view<3xi16> -> i16
    %byte = index.shli %i, %step : index
    %address = buffer.view %target[%byte] : buffer -> view<1xi16>
    view.store %value, %address[0] : i16, view<1xi16>
  }
  %last = view.load %output[2] : view<3xi16> -> i16
  %first = view.load %output[0] : view<3xi16> -> i16
  %middle = view.load %output[1] : view<3xi16> -> i16
  func.return %last, %first, %middle : i16, i16, i16
}

// ----
func.def @mixed_indexing(%a: i16, %b: i16, %c: i16) -> (i16, i16, i16) {
  func.return %c, %a, %b : i16, i16, i16
}

// ====

// A dimension index describes the same byte transfer. Reverse iteration
// visits a strict subrange and leaves the first destination lane intact.
func.def @reverse_subrange(%kept: f32, %moved: f32) -> (f32, f32) {
  %bytes = index.constant 16 : offset
  %origin = index.constant 0 : index
  %first = index.constant 1 : index
  %limit = index.constant 4 : index
  %source = buffer.alloca<private> align(4) %bytes : buffer
  %target = buffer.alloca<private> align(4) %bytes : buffer
  %input = buffer.view %source[%origin] : buffer -> view<4xf32>
  %output = buffer.view %target[%origin] : buffer -> view<4xf32>
  view.store %kept, %output[0] : f32, view<4xf32>
  view.store %moved, %input[2] : f32, view<4xf32>
  scf.for %i = [%first to %limit step %first] {
    %lane = index.sub %limit, %i : index
    %value = view.load %input[%lane] : view<4xf32> -> f32
    view.store %value, %output[%lane] : f32, view<4xf32>
  }
  %left = view.load %output[0] : view<4xf32> -> f32
  %right = view.load %output[2] : view<4xf32> -> f32
  func.return %left, %right : f32, f32
}

// ----
func.def @reverse_subrange(%kept: f32, %moved: f32) -> (f32, f32) {
  func.return %kept, %moved : f32, f32
}

// ====

// The next iteration reads the preceding write. A bulk snapshot would
// return the old middle lane instead of propagating the first lane.
func.def @overlapping_loop(%first: i32, %middle: i32) -> (i32) {
  %bytes = index.constant 12 : offset
  %origin = index.constant 0 : index
  %step = index.constant 1 : index
  %limit = index.constant 2 : index
  %storage = buffer.alloca<private> align(4) %bytes : buffer
  %values = buffer.view %storage[%origin] : buffer -> view<3xi32>
  view.store %first, %values[0] : i32, view<3xi32>
  view.store %middle, %values[1] : i32, view<3xi32>
  scf.for %i = [%origin to %limit step %step] {
    %next = index.add %i, %step : index
    %value = view.load %values[%i] : view<3xi32> -> i32
    view.store %value, %values[%next] : i32, view<3xi32>
  }
  %result = view.load %values[2] : view<3xi32> -> i32
  func.return %result : i32
}

// ====

// Opposite walks reverse element order, even between distinct roots.
func.def @reversed_output(%first: i16, %last: i16) -> (i16) {
  %bytes = index.constant 4 : offset
  %origin = index.constant 0 : index
  %step = index.constant 1 : index
  %limit = index.constant 2 : index
  %source = buffer.alloca<private> align(2) %bytes : buffer
  %target = buffer.alloca<private> align(2) %bytes : buffer
  %input = buffer.view %source[%origin] : buffer -> view<2xi16>
  %output = buffer.view %target[%origin] : buffer -> view<2xi16>
  view.store %first, %input[0] : i16, view<2xi16>
  view.store %last, %input[1] : i16, view<2xi16>
  scf.for %i = [%origin to %limit step %step] {
    %opposite = index.sub %step, %i : index
    %value = view.load %input[%opposite] : view<2xi16> -> i16
    view.store %value, %output[%i] : i16, view<2xi16>
  }
  %result = view.load %output[0] : view<2xi16> -> i16
  func.return %result : i16
}

// ====

// A separate volatile write is observable on every trip, even though both
// ends of the copy are private and the destination value is known.
func.def @observed_iterations(%initial: i8, %observer: view<2xi8>) -> (i8) {
  %bytes = index.constant 2 : offset
  %origin = index.constant 0 : index
  %step = index.constant 1 : index
  %limit = index.constant 2 : index
  %source = buffer.alloca<private> align(1) %bytes : buffer
  %target = buffer.alloca<private> align(1) %bytes : buffer
  %input = buffer.view %source[%origin] : buffer -> view<2xi8>
  %output = buffer.view %target[%origin] : buffer -> view<2xi8>
  view.store %initial, %input[0] : i8, view<2xi8>
  view.store %initial, %input[1] : i8, view<2xi8>
  scf.for %i = [%origin to %limit step %step] {
    %value = view.load %input[%i] : view<2xi8> -> i8
    view.store<volatile> %value, %observer[%i] : i8, view<2xi8>
    view.store %value, %output[%i] : i8, view<2xi8>
  }
  %result = view.load %output[0] : view<2xi8> -> i8
  func.return %result : i8
}

// ====

// The induction variable is a block argument. This is a fill loop, and its
// per-lane values remain available to the subsequent read.
func.def @fill_from_induction() -> (index) {
  %bytes = index.constant 16 : offset
  %origin = index.constant 0 : index
  %step = index.constant 1 : index
  %limit = index.constant 2 : index
  %storage = buffer.alloca<private> align(8) %bytes : buffer
  %values = buffer.view %storage[%origin] : buffer -> view<2xindex>
  scf.for %i = [%origin to %limit step %step] {
    view.store %i, %values[%i] : index, view<2xindex>
  }
  %last = view.load %values[1] : view<2xindex> -> index
  func.return %last : index
}

// ====

// The two branches have the same condition, so the scalar read is always
// initialized. A vector loaded inside the first branch is out of scope in
// the second branch.
func.def @conditional_snapshot(%enabled: i1, %input: view<2xi32>, %fallback: i32) -> (i32) {
  %bytes = index.constant 8 : offset
  %origin = index.constant 0 : index
  %step = index.constant 1 : index
  %limit = index.constant 2 : index
  %storage = buffer.alloca<private> align(4) %bytes : buffer
  %output = buffer.view %storage[%origin] : buffer -> view<2xi32>
  scf.if %enabled {
    scf.for %i = [%origin to %limit step %step] {
      %value = view.load %input[%i] : view<2xi32> -> i32
      view.store %value, %output[%i] : i32, view<2xi32>
    }
  }
  %chosen = scf.if %enabled -> (i32) {
    %result = view.load %output[1] : view<2xi32> -> i32
    scf.yield %result : i32
  } else {
    scf.yield %fallback : i32
  }
  func.return %chosen : i32
}

// ====

// Each destination gets a snapshot. Only the first and last arrays have
// directly addressed words, and the subrange shifts twice through the chain.
func.def @copy_prefix(%first: i32, %second: i32, %later: i32) -> (i32, i32, i32) {
  %bytes = index.constant 16 : offset
  %prefix_bytes = index.constant 12 : offset
  %copied_bytes = index.constant 8 : offset
  %origin = index.constant 0 : index
  %c4 = index.constant 4 : index
  %step = index.constant 1 : index
  %source = buffer.alloca<private> align(4) %bytes : buffer
  %middle = buffer.alloca<private> align(4) %bytes : buffer
  %prefix = buffer.alloca<private> align(4) %prefix_bytes : buffer
  %result = buffer.alloca<private> align(4) %bytes : buffer
  %input = buffer.view %source[%origin] : buffer -> view<4xi32>
  %forwarded = buffer.view %middle[%origin] : buffer -> view<4xi32>
  view.store %later, %input[0] : i32, view<4xi32>
  view.store %later, %input[3] : i32, view<4xi32>
  view.store %first, %input[1] : i32, view<4xi32>
  view.store %second, %input[2] : i32, view<4xi32>
  scf.for %i = [%origin to %c4 step %step] {
    %value = view.load %input[%i] : view<4xi32> -> i32
    view.store %value, %forwarded[%i] : i32, view<4xi32>
  }
  view.store %later, %input[1] : i32, view<4xi32>
  buffer.copy %middle[%c4], %prefix[%origin], %prefix_bytes
  buffer.copy %prefix[%origin], %result[%c4], %copied_bytes
  %output = buffer.view %result[%origin] : buffer -> view<4xi32>
  %left = view.load %output[1] : view<4xi32> -> i32
  %right = view.load %output[2] : view<4xi32> -> i32
  %current = view.load %input[1] : view<4xi32> -> i32
  func.return %left, %right, %current : i32, i32, i32
}

// ----
func.def @copy_prefix(%first: i32, %second: i32, %later: i32) -> (i32, i32, i32) {
  func.return %first, %second, %later : i32, i32, i32
}

// ====

// A conditional write to the source lies between snapshots. The result
// needs a join for one word, independent of the copied allocation size.
func.def @selected_snapshot(%original: f32, %updated: f32, %select: i1) -> (f32) {
  %bytes = index.constant 1073741824 : offset
  %origin = index.constant 0 : index
  %last = index.constant 1073741820 : index
  %source = buffer.alloca<private> align(4) %bytes : buffer
  %middle = buffer.alloca<private> align(4) %bytes : buffer
  %result = buffer.alloca<private> align(4) %bytes : buffer
  %input = buffer.view %source[%last] : buffer -> view<1xf32>
  %output = buffer.view %result[%last] : buffer -> view<1xf32>
  view.store %original, %input[0] : f32, view<1xf32>
  buffer.copy %source[%origin], %middle[%origin], %bytes
  scf.if %select {
    view.store %updated, %input[0] : f32, view<1xf32>
    buffer.copy %source[%origin], %middle[%origin], %bytes
  }
  buffer.copy %middle[%origin], %result[%origin], %bytes
  %value = view.load %output[0] : view<1xf32> -> f32
  func.return %value : f32
}

// ----
func.def @selected_snapshot(%original: f32, %updated: f32, %select: i1) -> (f32) {
  %13 = scf.if %select -> (f32) {
    scf.yield %updated : f32
  } else {
    scf.yield %original : f32
  }
  func.return %13 : f32
}

// ====

// A loop shifts the source by a word each trip. The final word can depend on
// an unbounded number of offsets and must keep its memory representation.
func.def @shifted_cycle(%value: i32, %limit: index) -> (i32) {
  %bytes = index.constant 4096 : offset
  %span = index.constant 4092 : offset
  %origin = index.constant 0 : index
  %step = index.constant 1 : index
  %word = index.constant 4 : index
  %last = index.constant 4092 : index
  %source = buffer.alloca<private> align(4) %bytes : buffer
  %middle = buffer.alloca<private> align(4) %bytes : buffer
  %head = buffer.view %source[%origin] : buffer -> view<1xi32>
  %tail = buffer.view %source[%last] : buffer -> view<1xi32>
  view.store %value, %head[0] : i32, view<1xi32>
  view.store %value, %tail[0] : i32, view<1xi32>
  scf.for %i = [%origin to %limit step %step] {
    buffer.copy %source[%origin], %middle[%origin], %span
    buffer.copy %middle[%origin], %source[%word], %span
  }
  %output = view.load %tail[0] : view<1xi32> -> i32
  func.return %output : i32
}

// ====

// The final store overwrites a copy of mixed bytes. An optional i32 cell in
// the middle must give way to its real byte access, even though the word starts first.
func.def @overwritten_copy(%word: i32, %byte: i8, %replacement: i32) -> (i32, i8) {
  %bytes = index.constant 4 : offset
  %origin = index.constant 0 : index
  %source = buffer.alloca<private> align(4) %bytes : buffer
  %middle = buffer.alloca<private> align(4) %bytes : buffer
  %result = buffer.alloca<private> align(4) %bytes : buffer
  %words = buffer.view %source[%origin] : buffer -> view<1xi32>
  %octets = buffer.view %middle[%origin] : buffer -> view<4xi8>
  %output = buffer.view %result[%origin] : buffer -> view<1xi32>
  view.store %word, %words[0] : i32, view<1xi32>
  buffer.copy %source[%origin], %middle[%origin], %bytes
  view.store %byte, %octets[1] : i8, view<4xi8>
  buffer.copy %middle[%origin], %result[%origin], %bytes
  view.store %replacement, %output[0] : i32, view<1xi32>
  %updated = view.load %output[0] : view<1xi32> -> i32
  %modified = view.load %octets[1] : view<4xi8> -> i8
  func.return %updated, %modified : i32, i8
}

// ----
func.def @overwritten_copy(%word: i32, %byte: i8, %replacement: i32) -> (i32, i8) {
  func.return %replacement, %byte : i32, i8
}

// ====

// The call can modify the word that will be copied out of the middle.
func.decl @modify(%storage: buffer)

func.def @observed_middle(%initial: i32) -> (i32) {
  %bytes = index.constant 4 : offset
  %origin = index.constant 0 : index
  %source = buffer.alloca<private> align(4) %bytes : buffer
  %middle = buffer.alloca<private> align(4) %bytes : buffer
  %result = buffer.alloca<private> align(4) %bytes : buffer
  %input = buffer.view %source[%origin] : buffer -> view<1xi32>
  %output = buffer.view %result[%origin] : buffer -> view<1xi32>
  view.store %initial, %input[0] : i32, view<1xi32>
  buffer.copy %source[%origin], %middle[%origin], %bytes
  func.call @modify(%middle) : (buffer)
  buffer.copy %middle[%origin], %result[%origin], %bytes
  %value = view.load %output[0] : view<1xi32> -> i32
  func.return %value : i32
}
