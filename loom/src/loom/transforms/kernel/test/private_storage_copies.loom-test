// RUN: pass promote-private-fragments,dce

// Only the last word of this copy is subsequently read. A write to its source
// after the copy must not change the value observed through the destination.
func.def @sparse_copy(%first: i32, %later: i32) -> (i32, i32) {
  %bytes = index.constant 1073741824 : offset
  %origin = index.constant 0 : index
  %last = index.constant 1073741820 : index
  %source = buffer.alloca<private> align(4) %bytes : buffer
  %target = buffer.alloca<private> align(4) %bytes : buffer
  %original = buffer.view %source[%last] : buffer -> view<1xi32>
  %copy = buffer.view %target[%last] : buffer -> view<1xi32>
  view.store %first, %original[0] : i32, view<1xi32>
  buffer.copy %source[%origin], %target[%origin], %bytes
  view.store %later, %original[0] : i32, view<1xi32>
  %before = view.load %copy[0] : view<1xi32> -> i32
  %after = view.load %original[0] : view<1xi32> -> i32
  func.return %before, %after : i32, i32
}

// ----
func.def @sparse_copy(%first: i32, %later: i32) -> (i32, i32) {
  func.return %first, %later : i32, i32
}

// ====

// The two halves of one allocation are disjoint. A conditional copy updates
// only the target cell on the taken path.
func.def @conditional_copy(%a: f32, %b: f32, %enabled: i1) -> (f32) {
  %bytes = index.constant 8 : offset
  %word = index.constant 4 : offset
  %origin = index.constant 0 : index
  %storage = buffer.alloca<private> align(4) %bytes : buffer
  %values = buffer.view %storage[%origin] : buffer -> view<2xf32>
  view.store %a, %values[0] : f32, view<2xf32>
  view.store %b, %values[1] : f32, view<2xf32>
  scf.if %enabled {
    buffer.copy %storage[%origin], %storage[%word], %word
  }
  %chosen = view.load %values[1] : view<2xf32> -> f32
  func.return %chosen : f32
}

// ----
func.def @conditional_copy(%a: f32, %b: f32, %enabled: i1) -> (f32) {
  %10 = scf.if %enabled -> (f32) {
    scf.yield %a : f32
  } else {
    scf.yield %b : f32
  }
  func.return %10 : f32
}

// ====

// A partial overwrite cannot supply the complete i32 read. All three
// allocations must keep their stores and both physical copies.
func.def @partial_word(%a: i32, %b: i32) -> (i32) {
  %bytes = index.constant 4 : offset
  %single_byte = index.constant 1 : offset
  %origin = index.constant 0 : offset
  %source = buffer.alloca<private> align(4) %bytes : buffer
  %middle = buffer.alloca<private> align(4) %bytes : buffer
  %target = buffer.alloca<private> align(4) %bytes : buffer
  %original = buffer.view %source[%origin] : buffer -> view<1xi32>
  %result = buffer.view %target[%origin] : buffer -> view<1xi32>
  view.store %a, %original[0] : i32, view<1xi32>
  view.store %b, %result[0] : i32, view<1xi32>
  buffer.copy %source[%origin], %middle[%origin], %bytes
  buffer.copy %middle[%origin], %target[%single_byte], %single_byte
  %mixed = view.load %result[0] : view<1xi32> -> i32
  func.return %mixed : i32
}
