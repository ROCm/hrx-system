    %26 = view.refine %input : view<[%extent]xi32, %22> -> view<[%extent_specialized]xi32, %22>
    %27 = view.refine %26 : view<[%extent_specialized]xi32, %22> -> view<32xi32>
    %value = view.load %27[31] : view<32xi32> -> i32
    view.store %value, %output[0] : i32, view<1xi32>
