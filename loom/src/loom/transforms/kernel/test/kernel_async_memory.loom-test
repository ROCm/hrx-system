  %scratch = buffer.view %storage[%origin] : buffer -> view<64xi8>
  %load = kernel.async.copy %source to %scratch {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<32xbf16> to view<64xi8> -> kernel.async.token
  %loaded = kernel.async.group %load : kernel.async.token -> kernel.async.group
  kernel.async.wait %loaded {newer_groups = 0} : kernel.async.group
  %store = kernel.async.copy.mask %scratch to %destination, %enabled {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<64xi8> to view<32xbf16>, i1 -> kernel.async.token
  %stored = kernel.async.group %store : kernel.async.token -> kernel.async.group
  kernel.async.wait %stored {newer_groups = 0} : kernel.async.group
