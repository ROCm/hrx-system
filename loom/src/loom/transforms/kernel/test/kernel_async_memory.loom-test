func.def inline @copy_page(%catalog: view<1024xi32>, %page: index, %packet: view<128xi32>) {
  %source = view.subview %catalog[%page] : view<1024xi32> -> view<64xi32>
  %destination = view.subview %packet[64] : view<128xi32> -> view<64xi32>
  %copy = kernel.async.copy %source to %destination {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<64xi32> to view<64xi32> -> kernel.async.token
  %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
  kernel.async.wait %group {newer_groups = 0} : kernel.async.group
  func.return
}

func.def public @copy_retained_page(%input: buffer) {
  %base = index.constant 0 : offset
  %capacity = index.constant 1 : index
  %global = buffer.assume.memory_space<global> %input : buffer
  %catalog_slot = buffer.view %global[%base] : buffer -> view<1x1024xi32>
  %catalog = channel.bind<fifo> %catalog_slot, %capacity : view<1x1024xi32>, index -> channel<tile<1024xi32>>
  %bytes = index.constant 512 : offset
  %scratch = buffer.alloca<workgroup> align(64) %bytes : buffer
  %packet_slot = buffer.view %scratch[%base] : buffer -> view<1x128xi32>
  %packets = channel.bind<fifo> %packet_slot, %capacity : view<1x128xi32>, index -> channel<tile<128xi32>>
  %read, %catalog_view = channel.acquire %catalog : channel<tile<1024xi32>> -> (read<tile<1024xi32>>, view<1024xi32>)
  %write, %packet = channel.reserve %packets : channel<tile<128xi32>> -> (write<tile<128xi32>>, view<128xi32>)
  %first_page = index.constant 0 : index
  %second_page = index.constant 64 : index
  func.call @copy_page(%catalog_view, %first_page, %packet) : (view<1024xi32>, index, view<128xi32>)
  func.call @copy_page(%catalog_view, %second_page, %packet) : (view<1024xi32>, index, view<128xi32>)
  channel.publish %write : write<tile<128xi32>>
  channel.release %read : read<tile<1024xi32>>
  func.return
}

