// RUN: pass kernel-synchronization-legality

// Deferring source shape verification does not authorize an unresolved copy
// length at the target boundary.
func.def @copy_requires_concrete_extent_at_lowering(%input: buffer, %extent: index) {
  %origin = index.constant 0 : offset
  %allocation_size = index.constant 64 : offset
  %global = buffer.assume.memory_space<global> %input : buffer
  %source = buffer.view %global[%origin] : buffer -> view<[%extent]xi8>
  %storage = buffer.alloca<workgroup> align(64) %allocation_size : buffer
  %destination = buffer.view %storage[%origin] : buffer -> view<[%extent]xi8>
  // ERROR@+1: LOWERING/024 {op_name="kernel.async.copy", phase_name="kernel-synchronization-legality", rejection_bits="64"}
  %copy = kernel.async.copy %source to %destination {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<[%extent]xi8> to view<[%extent]xi8> -> kernel.async.token
  %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
  kernel.async.wait %group {newer_groups = 0} : kernel.async.group
  func.return
}

