kernel.def @allows_cluster_uniform_control_and_corresponding_lane_addresses() {
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c64 = index.constant 64 : index
  kernel.launch.config workgroups(%c4, %c2, %c1) workgroup_size(%c64, %c1, %c1) cluster_size(%c1, %c2, %c1) : index
} launch(%input: buffer, %enabled: i1) {
  %bytes = index.constant 1024 : offset
  %participants = scalar.constant 3 : i32
  %global = buffer.assume.memory_space<global> %input : buffer
  %scratch = buffer.alloca<workgroup> align(64) %bytes : buffer
  %workgroup = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %workgroup_offset = index.cast %workgroup : index to offset
  %lane_offset = index.cast %lane : index to offset
  %corresponding_offset = index.add %workgroup_offset, %lane_offset : offset
  %source = buffer.view %global[%corresponding_offset] : buffer -> view<4xi8>
  %dest = buffer.view %scratch[%corresponding_offset] : buffer -> view<4xi8>
  scf.if %enabled {
    %copy = kernel.async.cluster.gather %source to %dest using %participants {cache_scope = cu, cache_temporal = regular} : view<4xi8> to view<4xi8>, i32 -> kernel.async.token
    %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
    kernel.async.wait %group {newer_groups = 0} : kernel.async.group
  }
  kernel.return
}

