kernel.def @allows_four_participant_cluster_and_cluster_uniform_addresses() {
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c64 = index.constant 64 : index
  kernel.launch.config workgroups(%c4, %c4, %c1) workgroup_size(%c64, %c1, %c1) cluster_size(%c2, %c2, %c1) : index
} launch(%input: buffer, %base: offset) {
  %bytes = index.constant 1024 : offset
  %participants = scalar.constant 15 : i32
  %global = buffer.assume.memory_space<global> %input : buffer
  %scratch = buffer.alloca<workgroup> align(64) %bytes : buffer
  %cluster_x = kernel.cluster.id<x> : index
  %cluster_y = kernel.cluster.id<y> : index
  %cluster_x_offset = index.cast %cluster_x : index to offset
  %cluster_y_offset = index.cast %cluster_y : index to offset
  %cluster_offset = index.add %cluster_x_offset, %cluster_y_offset : offset
  %address_offset = index.add %base, %cluster_offset : offset
  %source = buffer.view %global[%address_offset] : buffer -> view<4xi8>
  %dest = buffer.view %scratch[%address_offset] : buffer -> view<4xi8>
  %copy = kernel.async.cluster.gather %source to %dest using %participants {cache_scope = cu, cache_temporal = regular} : view<4xi8> to view<4xi8>, i32 -> kernel.async.token
  %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
  kernel.async.wait %group {newer_groups = 0} : kernel.async.group
  kernel.return
