    %38 = view.load %24[%6] : view<1xi8> -> i8
    %39 = scalar.trunci %38 : i8 to i1
    %40 = scalar.xori %39, %predicate : i1
    %41 = scalar.extui %40 : i1 to i8
    view.store %41, %24[%6] : i8, view<1xi8>
  } else {
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %42 = view.load %24[%6] : view<1xi8> -> i8
  %parity = scalar.trunci %42 : i8 to i1
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %44 = index.constant 4 : offset
  %45 = buffer.alloca<workgroup> align(4) %44 : buffer
  %47 = buffer.view %45[%23] : buffer -> view<1xi32>
  scf.if %15 {
    view.store %word, %47[%6] : i32, view<1xi32>
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  scf.if %27 {
    %52 = view.load %47[%6] : view<1xi32> -> i32
    %53 = scalar.addi %52, %word : i32
    view.store %53, %47[%6] : i32, view<1xi32>
  } else {
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  scf.if %35 {
    %58 = view.load %47[%6] : view<1xi32> -> i32
    %59 = scalar.addi %58, %word : i32
    view.store %59, %47[%6] : i32, view<1xi32>
  } else {
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %sum = view.load %47[%6] : view<1xi32> -> i32
