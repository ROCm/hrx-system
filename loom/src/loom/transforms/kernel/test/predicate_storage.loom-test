  test.use %parity, %sum : i1, i32
  kernel.return
}

// ====

// REQUIRES: spirv-dis, spirv-val
// RUN: with-checks emit spirv-dis input=source-low control-flow=structured-low target=spirv:vulkan1.3+bda features=INT16 validate

// With Int16 alone, scratch introduces Int16 but never Int8. The complete
// conversion/publication sequence is checked above; this selects capability
// declarations from the emitted module.
kernel.def @short_predicates() {
  %unit = index.constant 1 : index
  %items = index.constant 3 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %item = kernel.workitem.id<x> : index
  %source = buffer.view %input[%base] : buffer -> view<3xi32>
  %destination = buffer.view %output[%base] : buffer -> view<3xi32>
  %word = view.load %source[%item] : view<3xi32> -> i32
  %value = scalar.trunci %word : i32 to i1
  %result = kernel.workgroup.scan<maxsi> %value {direction = reverse, mode = exclusive} : i1
  %extended = scalar.extui %result : i1 to i32
  view.store %extended, %destination[%item] : i32, view<3xi32>
  kernel.return
}

// ----
// CHECK: OpCapability Int16
// CHECK-NOT: OpCapability Int8
