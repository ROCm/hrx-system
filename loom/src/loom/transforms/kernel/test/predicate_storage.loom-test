// RUN: pass target=spirv:vulkan1.3+bda target-legalize{mode=eager,policy=reference-only},canonicalize,cse,dce

// Source arithmetic remains Boolean while scratch follows the target's
// integer capabilities. A mixed reduction retains one common combining kind.
kernel.def @mixed_predicates() {
  %unit = index.constant 1 : index
  %items = index.constant 3 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%predicate: i1, %word: i32) {
  %parity, %sum = kernel.workgroup.reduce<addi> %predicate, %word : i1, i32
  test.use %parity, %sum : i1, i32
  kernel.return
}

// ----
kernel.def @mixed_predicates() {
  %unit = index.constant 1 : index
  %items = index.constant 3 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%predicate: i1, %word: i32) {
  %6 = index.constant 0 : index
  %9 = kernel.workitem.id<x> : index
  %15 = index.cmp eq, %9, %6 : index
  %21 = index.constant 4 : offset
  %22 = buffer.alloca<workgroup> align(4) %21 : buffer
  %23 = index.constant 0 : offset
  %24 = buffer.view %22[%23] : buffer -> view<1xi32>
  scf.if %15 {
    %25 = scalar.extui %predicate : i1 to i32
    view.store %25, %24[%6] : i32, view<1xi32>
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %26 = index.constant 1 : index
  %27 = index.cmp eq, %9, %26 : index
  scf.if %27 {
    %30 = view.load %24[%6] : view<1xi32> -> i32
    %31 = scalar.trunci %30 : i32 to i1
    %32 = scalar.xori %31, %predicate : i1
    %33 = scalar.extui %32 : i1 to i32
    view.store %33, %24[%6] : i32, view<1xi32>
  } else {
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %34 = index.constant 2 : index
  %35 = index.cmp eq, %9, %34 : index
  scf.if %35 {
    %38 = view.load %24[%6] : view<1xi32> -> i32
    %39 = scalar.trunci %38 : i32 to i1
    %40 = scalar.xori %39, %predicate : i1
    %41 = scalar.extui %40 : i1 to i32
    view.store %41, %24[%6] : i32, view<1xi32>
  } else {
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %42 = view.load %24[%6] : view<1xi32> -> i32
  %parity = scalar.trunci %42 : i32 to i1
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %45 = buffer.alloca<workgroup> align(4) %21 : buffer
  %47 = buffer.view %45[%23] : buffer -> view<1xi32>
  scf.if %15 {
    view.store %word, %47[%6] : i32, view<1xi32>
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  scf.if %27 {
    %52 = view.load %47[%6] : view<1xi32> -> i32
    %53 = scalar.addi %52, %word : i32
    view.store %53, %47[%6] : i32, view<1xi32>
  } else {
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  scf.if %35 {
    %58 = view.load %47[%6] : view<1xi32> -> i32
    %59 = scalar.addi %58, %word : i32
    view.store %59, %47[%6] : i32, view<1xi32>
  } else {
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %sum = view.load %47[%6] : view<1xi32> -> i32
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  test.use %parity, %sum : i1, i32
  kernel.return
}

