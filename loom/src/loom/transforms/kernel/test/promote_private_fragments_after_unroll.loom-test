// RUN: pass unroll-scf-for,canonicalize,cse,promote-private-fragments,dce

func.def @forward_after_unrolled_private_init(%output: buffer, %lhs: i64, %rhs: i64) {
  %base = index.constant 0 : offset
  %output_view = buffer.view %output[%base] : buffer -> view<1xi64>
  %slot_bytes = index.constant 16 : offset
  %slot_buffer = buffer.alloca<private> align(8) %slot_bytes : buffer
  %slots = buffer.view %slot_buffer[%base] : buffer -> view<2xi64>
  %start = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  scf.for %j = [%start to %end step %step] unroll {
    %initial_value = scalar.constant 0 : i64
    view.store %initial_value, %slots[%j] : i64, view<2xi64>
  }
  %slot0 = index.constant 0 : index
  %slot1 = index.constant 1 : index
  %loaded0 = view.load %slots[%slot0] : view<2xi64> -> i64
  %sum = scalar.addi %loaded0, %lhs : i64
  view.store %sum, %slots[%slot0] : i64, view<2xi64>
  %loaded1 = view.load %slots[%slot1] : view<2xi64> -> i64
  %xor = scalar.xori %loaded1, %rhs : i64
  view.store %xor, %slots[%slot1] : i64, view<2xi64>
  %final0 = view.load %slots[%slot0] : view<2xi64> -> i64
  %final1 = view.load %slots[%slot1] : view<2xi64> -> i64
  %result = scalar.ori %final0, %final1 : i64
  view.store %result, %output_view[%slot0] : i64, view<1xi64>
  func.return
}

// ----
func.def @forward_after_unrolled_private_init(%output: buffer, %lhs: i64, %rhs: i64) {
  %base = index.constant 0 : offset
  %output_view = buffer.view %output[%base] : buffer -> view<1xi64>
  %j_0 = index.constant 0 : index
  %initial_value = scalar.constant 0 : i64
  %sum = scalar.addi %initial_value, %lhs : i64
  %xor = scalar.xori %initial_value, %rhs : i64
  %result = scalar.ori %sum, %xor : i64
  view.store %result, %output_view[%j_0] : i64, view<1xi64>
  func.return
}
