test.target<low_core> @target {abi = hal_kernel, subgroup_size = 64}

kernel.def target(@target) @stage_dense_accumulator_fragments() {
  %unit_extent = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit_extent, %unit_extent, %unit_extent) workgroup_size(%workgroup_size, %unit_extent, %unit_extent) : index
} launch(%lhs_values: vector<16xbf16>, %rhs_values: vector<16xbf16>, %accumulator: vector<8xf32>) {
  %loop_begin = index.constant 0 : index
  %loop_step = index.constant 1 : index
  %tile_count = index.constant 4 : index
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %lhs = vector.fragment<lhs> %lhs_values shape [%m, %k] : vector<16xbf16>
  %rhs = vector.fragment<rhs> %rhs_values shape [%k, %n] : vector<16xbf16>
  %init = vector.fragment<init> %accumulator shape [%m, %n] : vector<8xf32>
  %27 = index.constant 4096 : offset
  %28 = index.constant 0 : offset
  %29 = index.constant 0 : index
  %30 = encoding.layout.dense : encoding<layout>
  %31 = buffer.alloca<workgroup> align(16) %27 : buffer
  %32 = buffer.view %31[%28] : buffer -> view<16x64xf32, %30>
  %33 = index.constant 0 : index
  vector.fragment.store<result> %init, %32[%29, %33] shape [%m, %n] : vector<8xf32>, view<16x64xf32, %30>
  %34 = index.constant 16 : index
  vector.fragment.store<result> %init, %32[%29, %34] shape [%m, %n] : vector<8xf32>, view<16x64xf32, %30>
  %35 = index.constant 32 : index
  vector.fragment.store<result> %init, %32[%29, %35] shape [%m, %n] : vector<8xf32>, view<16x64xf32, %30>
  %36 = index.constant 48 : index
  vector.fragment.store<result> %init, %32[%29, %36] shape [%m, %n] : vector<8xf32>, view<16x64xf32, %30>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  scf.for %37 = [%loop_begin to %tile_count step %loop_step] {
    %38 = vector.fragment.load<init> %32[%29, %33] shape [%m, %n] : view<16x64xf32, %30> -> vector<8xf32>
    %39 = vector.fragment.load<init> %32[%29, %34] shape [%m, %n] : view<16x64xf32, %30> -> vector<8xf32>
    %40 = vector.fragment.load<init> %32[%29, %35] shape [%m, %n] : view<16x64xf32, %30> -> vector<8xf32>
    %41 = vector.fragment.load<init> %32[%29, %36] shape [%m, %n] : view<16x64xf32, %30> -> vector<8xf32>
    %next0 = vector.mma %lhs, %rhs, %38 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %next1 = vector.mma %lhs, %rhs, %39 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %next2 = vector.mma %lhs, %rhs, %40 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    %next3 = vector.mma %lhs, %rhs, %41 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
    vector.fragment.store<result> %next0, %32[%29, %33] shape [%m, %n] : vector<8xf32>, view<16x64xf32, %30>
    vector.fragment.store<result> %next1, %32[%29, %34] shape [%m, %n] : vector<8xf32>, view<16x64xf32, %30>
    vector.fragment.store<result> %next2, %32[%29, %35] shape [%m, %n] : vector<8xf32>, view<16x64xf32, %30>
    vector.fragment.store<result> %next3, %32[%29, %36] shape [%m, %n] : vector<8xf32>, view<16x64xf32, %30>
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  }
  %result3 = vector.fragment.load<init> %32[%29, %36] shape [%m, %n] : view<16x64xf32, %30> -> vector<8xf32>
  %result2 = vector.fragment.load<init> %32[%29, %35] shape [%m, %n] : view<16x64xf32, %30> -> vector<8xf32>
  %result1 = vector.fragment.load<init> %32[%29, %34] shape [%m, %n] : view<16x64xf32, %30> -> vector<8xf32>
  %result0 = vector.fragment.load<init> %32[%29, %33] shape [%m, %n] : view<16x64xf32, %30> -> vector<8xf32>
  test.use %result0, %result1, %result2, %result3 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  kernel.return
}

