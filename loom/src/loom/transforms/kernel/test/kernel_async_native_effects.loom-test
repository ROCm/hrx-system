// RUN: pass kernel-synchronization-legality

// Native access bounds survive the call boundary without becoming argument
// footprints. A pending destination excludes reads; a source permits reads.
test.target<low_core> @target

low.func.def readonly target<test.low.core>(@target) @native_read(%address: reg<test.ptr>) -> (reg<test.i32 x4>) asm {
  %value = test.load.workgroup.v4i32 %address
  return %value
}

func.def @allows_workgroup_read_workgroup_to_global(%output: buffer, %address: buffer) -> (vector<4xi32>) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 64 : offset
  %global = buffer.assume.memory_space<global> %output : buffer
  %local = buffer.alloca<workgroup> align(16) %bytes : buffer
  %global_view = buffer.view %global[%origin] : buffer -> view<16xi8>
  %local_view = buffer.view %local[%origin] : buffer -> view<16xi8>
  %copy = kernel.async.copy %local_view to %global_view {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<16xi8> to view<16xi8> -> kernel.async.token
  %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
  %value = low.invoke readonly @native_read(%address) : (buffer) -> (vector<4xi32>)
  kernel.async.wait %group {newer_groups = 0} : kernel.async.group
  func.return %value : vector<4xi32>
}

