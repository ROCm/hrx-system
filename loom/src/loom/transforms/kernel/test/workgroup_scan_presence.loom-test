// ====
// RUN: pass target-legalize{mode=eager,policy=reference-only},canonicalize,cse,dce

// Three subgroups exceed the two-lane fold width. Empty local prefixes must
// accept their first nonempty partial directly, then combine later partials.
test.target<low_core> @target {subgroup_size = 2}

kernel.def target(@target) @full_forward() {
  %unit = index.constant 1 : index
  %items = index.constant 6 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%value: f32) {
  %result = kernel.workgroup.scan<maxnumf> %value {direction = forward, mode = exclusive} : f32
  test.use %result : f32
  kernel.return
}

