// ====
// RUN: pass target-legalize{mode=eager,policy=reference-only},canonicalize,cse,dce

// One proven linear subgroup needs no workgroup scratch or barriers.
test.target<linear_subgroups> @target {subgroup_size = 4}

kernel.def target(@target) @single_subgroup() {
  %unit = index.constant 1 : index
  %items = index.constant 3 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%value: i64) {
  %total = kernel.workgroup.reduce<addi> %value : i64
  %prefix = kernel.workgroup.scan<addi> %value {direction = forward, mode = exclusive} : i64
  test.use %total, %prefix : i64, i64
  kernel.return
}

