  %26 = index.cmp eq, %119, %20 : index
  %117 = scf.if %26 -> (i64) {
    %29 = view.load %24[%121] : view<2xi64> -> i64
    %30 = scalar.addi %29, %value : i64
    view.store %30, %24[%121] : i64, view<2xi64>
    scf.yield %30 : i64
  } else {
    scf.yield %value : i64
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %32 = index.cmp eq, %119, %120 : index
  %116 = scf.if %32 -> (i64) {
    %35 = view.load %24[%121] : view<2xi64> -> i64
    %36 = scalar.addi %35, %value : i64
    view.store %36, %24[%121] : i64, view<2xi64>
    scf.yield %36 : i64
  } else {
    scf.yield %117 : i64
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %115 = scf.if %17 -> (i64) {
    %41 = view.load %24[%121] : view<2xi64> -> i64
    %42 = scalar.addi %41, %value : i64
    view.store %42, %24[%121] : i64, view<2xi64>
    scf.yield %42 : i64
  } else {
    scf.yield %116 : i64
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %45 = index.cmp ne, %121, %6 : index
  %46 = scalar.andi %45, %19 : i1
  scf.if %46 {
    %53 = view.load %24[%6] : view<2xi64> -> i64
    %54 = scalar.addi %53, %115 : i64
    view.store %54, %24[%20] : i64, view<2xi64>
  } else {
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %total = view.load %24[%20] : view<2xi64> -> i64
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %56 = index.constant 2 : offset
  %57 = buffer.alloca<workgroup> align(1) %56 : buffer
  %59 = buffer.view %57[%23] : buffer -> view<2xi8>
  scf.if %15 {
    %60 = scalar.extui %predicate : i1 to i8
    view.store %60, %59[%121] : i8, view<2xi8>
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %112 = scf.if %26 -> (i1) {
    %65 = view.load %59[%121] : view<2xi8> -> i8
