  %6 = kernel.subgroup.lane.id : index
  %7 = index.cmp eq, %6, %4 : index
  %47 = scalar.constant 2 : i32
  %48 = kernel.subgroup.active.mask : i32
  %49 = scalar.ctpopi %48 : i32
  %87 = index.cast %6 : index to i32
  %106 = scalar.constant 0 : i32
  %118 = scalar.constant -1 : i32
  %119 = scalar.addi %87, %118 : i32
  %116 = scalar.constant 1 : i32
  %117 = scalar.shrui %119, %116 : i32
  %92 = scalar.cmpi eq, %117, %106 : i32
  %93 = scalar.cmpi ult, %119, %47 : i32
  %95 = scalar.andi %92, %93 : i1
  %96 = scf.select %95, %119, %87 : i32
  %115 = scalar.andi %96, %116 : i32
  %98, %99 = kernel.subgroup.shuffle<index> %value, %115, %47 : vector<2xi32>, i32, i32
  %100 = scalar.andi %95, %99 : i1
  %67 = vector.extract %98[0] : vector<2xi32> -> i32
  %68 = vector.extract %value[0] : vector<2xi32> -> i32
  %69 = scalar.addi %67, %68 : i32
  %70 = vector.extract %98[1] : vector<2xi32> -> i32
  %71 = vector.extract %value[1] : vector<2xi32> -> i32
  %72 = scalar.addi %70, %71 : i32
  %60 = scf.select %100, %69, %68 : i32
  %63 = scf.select %100, %72, %71 : i32
  %65 = vector.splat %60 : vector<2xi32>
  %66 = vector.insert %63 into %65[1] : i32, vector<2xi32>
  %113 = scalar.addi %49, %118 : i32
  %56, %57 = kernel.subgroup.shuffle<index> %66, %113, %47 : vector<2xi32>, i32, i32
  %9 = index.constant 24 : offset
  %10 = buffer.alloca<workgroup> align(4) %9 : buffer
  %11 = index.constant 0 : offset
  %12 = buffer.view %10[%11] : buffer -> view<6xi32>
  scf.if %7 {
    %110 = index.constant 1 : index
    %111 = index.shli %5, %110 : index
    vector.store %56, %12[%111] : vector<2xi32>, view<6xi32>
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %17 = vector.load %12[%4] : view<6xi32> -> vector<2xi32>
  %104 = index.constant 2 : index
  %21 = vector.load %12[%104] : view<6xi32> -> vector<2xi32>
  %37 = vector.extract %17[0] : vector<2xi32> -> i32
  %38 = vector.extract %21[0] : vector<2xi32> -> i32
  %39 = scalar.addi %37, %38 : i32
  %40 = vector.extract %17[1] : vector<2xi32> -> i32
  %41 = vector.extract %21[1] : vector<2xi32> -> i32
  %42 = scalar.addi %40, %41 : i32
  %103 = index.constant 4 : index
  %26 = vector.load %12[%103] : view<6xi32> -> vector<2xi32>
  %29 = vector.extract %26[0] : vector<2xi32> -> i32
  %30 = scalar.addi %39, %29 : i32
  %32 = vector.extract %26[1] : vector<2xi32> -> i32
  %33 = scalar.addi %42, %32 : i32
  %35 = vector.splat %30 : vector<2xi32>
  %total = vector.insert %33 into %35[1] : i32, vector<2xi32>
  test.use %total : vector<2xi32>
  kernel.return
}

// ====
// RUN: pass target-legalize{mode=eager,policy=reference-only},canonicalize,cse,dce

// Eight components reuse one four-component slot through a uniform loop.
// The final read barrier precedes the next batch's initial publication.
test.target<low_core> @target

kernel.def target(@target) @stream_components() {
  %unit = index.constant 1 : index
  %items = index.constant 2 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%value: vector<8xi32>) {
  %prefix = kernel.workgroup.scan<addi> %value {direction = reverse, mode = exclusive} : vector<8xi32>
  test.use %prefix : vector<8xi32>
  kernel.return
}

// ----
test.target<low_core> @target

kernel.def target(@target) @stream_components() {
  %unit = index.constant 1 : index
  %items = index.constant 2 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%value: vector<8xi32>) {
  %4 = index.constant 0 : index
  %7 = kernel.workitem.id<x> : index
  %9 = index.constant 1 : index
  %10 = index.sub %9, %7 : index
  %14 = index.cmp eq, %10, %4 : index
  %20 = index.constant 16 : offset
  %21 = buffer.alloca<workgroup> align(4) %20 : buffer
  %22 = index.constant 0 : offset
  %23 = buffer.view %21[%22] : buffer -> view<4xi32>
  %24 = index.constant 8 : index
  %25 = index.constant 4 : index
  %prefix = scf.for %26 = [%4 to %24 step %25](%27 = %value : vector<8xi32>) -> (vector<8xi32>) {
    %29 = vector.slice %value[%26] : vector<8xi32> -> vector<4xi32>
    %82 = vector.splati 0 : vector<4xi32>
    scf.if %14 {
      vector.store %29, %23[%4] : vector<4xi32>, view<4xi32>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %35 = index.cmp eq, %10, %9 : index
    %81 = scf.if %35 -> (vector<4xi32>) {
      %40 = vector.load %23[%4] : view<4xi32> -> vector<4xi32>
      %60 = vector.extract %40[0] : vector<4xi32> -> i32
      %61 = vector.extract %29[0] : vector<4xi32> -> i32
      %62 = scalar.addi %60, %61 : i32
      %63 = vector.extract %40[1] : vector<4xi32> -> i32
      %64 = vector.extract %29[1] : vector<4xi32> -> i32
      %65 = scalar.addi %63, %64 : i32
      %66 = vector.extract %40[2] : vector<4xi32> -> i32
      %67 = vector.extract %29[2] : vector<4xi32> -> i32
      %68 = scalar.addi %66, %67 : i32
      %69 = vector.extract %40[3] : vector<4xi32> -> i32
      %70 = vector.extract %29[3] : vector<4xi32> -> i32
      %71 = scalar.addi %69, %70 : i32
      %73 = vector.splat %62 : vector<4xi32>
      %74 = vector.insert %65 into %73[1] : i32, vector<4xi32>
      %75 = vector.insert %68 into %74[2] : i32, vector<4xi32>
      %76 = vector.insert %71 into %75[3] : i32, vector<4xi32>
      vector.store %76, %23[%4] : vector<4xi32>, view<4xi32>
      scf.yield %40 : vector<4xi32>
    } else {
      scf.yield %82 : vector<4xi32>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %44 = vector.extract %81[0] : vector<4xi32> -> i32
    %47 = vector.insert %44 into %27[%26] : i32, vector<8xi32>
    %48 = vector.extract %81[1] : vector<4xi32> -> i32
    %50 = index.add %26, %9 : index
    %51 = vector.insert %48 into %47[%50] : i32, vector<8xi32>
    %52 = vector.extract %81[2] : vector<4xi32> -> i32
    %53 = index.constant 2 : index
    %54 = index.add %26, %53 : index
    %55 = vector.insert %52 into %51[%54] : i32, vector<8xi32>
    %56 = vector.extract %81[3] : vector<4xi32> -> i32
    %57 = index.constant 3 : index
    %58 = index.add %26, %57 : index
    %59 = vector.insert %56 into %55[%58] : i32, vector<8xi32>
    scf.yield %59 : vector<8xi32>
  }
  test.use %prefix : vector<8xi32>
  kernel.return
}

// ====
// RUN: pass target-legalize{mode=eager,policy=reference-only},canonicalize,cse,dce

// Reference arithmetic cannot replace source-format-preserving sums/products.
// The policy applies to both the single-subgroup and logical relay paths.
test.target<linear_subgroups> @linear {subgroup_size = 4}

test.target<low_core> @logical

kernel.def target(@linear) @preserved_subgroup() {
  %unit = index.constant 1 : index
  %items = index.constant 3 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%value: f32) {
  %total = kernel.workgroup.reduce<addf, preserve> %value : f32
  %prefix = kernel.workgroup.scan<mulf, preserve> %value {direction = forward, mode = inclusive} : f32
  test.use %total, %prefix : f32, f32
  kernel.return
}

kernel.def target(@logical) @preserved_logical() {
  %unit = index.constant 1 : index
  %items = index.constant 9 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%value: f32) {
  %total = kernel.workgroup.reduce<mulf, preserve> %value : f32
  %prefix = kernel.workgroup.scan<addf, preserve> %value {direction = reverse, mode = exclusive} : f32
  test.use %total, %prefix : f32, f32
  kernel.return
}

