// ====
// RUN: pass target-legalize{mode=eager,policy=reference-only},canonicalize,cse,dce

// Width alone proves neither subgroup population nor logical scan order.
// The same three-workitem shape must use logical publication on this profile.
test.target<low_core> @target {subgroup_size = 4}

kernel.def target(@target) @unordered_subgroup() {
  %unit = index.constant 1 : index
  %items = index.constant 3 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%value: i64) {
  %prefix = kernel.workgroup.scan<addi> %value {direction = reverse, mode = exclusive} : i64
  test.use %prefix : i64
  kernel.return
}

// ----
test.target<low_core> @target {subgroup_size = 4}

kernel.def target(@target) @unordered_subgroup() {
  %unit = index.constant 1 : index
  %items = index.constant 3 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%value: i64) {
  %4 = index.constant 0 : index
  %7 = kernel.workitem.id<x> : index
  %9 = index.constant 2 : index
  %10 = index.sub %9, %7 : index
  %14 = index.cmp eq, %10, %4 : index
  %20 = index.constant 8 : offset
  %21 = buffer.alloca<workgroup> align(8) %20 : buffer
  %22 = index.constant 0 : offset
  %23 = buffer.view %21[%22] : buffer -> view<1xi64>
  %24 = scalar.constant 0 : i64
  scf.if %14 {
    view.store %value, %23[%4] : i64, view<1xi64>
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %25 = index.constant 1 : index
  %26 = index.cmp eq, %10, %25 : index
  %40 = scf.if %26 -> (i64) {
    %29 = view.load %23[%4] : view<1xi64> -> i64
    %30 = scalar.addi %29, %value : i64
    view.store %30, %23[%4] : i64, view<1xi64>
    scf.yield %29 : i64
  } else {
    scf.yield %24 : i64
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %32 = index.cmp eq, %10, %9 : index
  %prefix = scf.if %32 -> (i64) {
    %35 = view.load %23[%4] : view<1xi64> -> i64
    %36 = scalar.addi %35, %value : i64
    view.store %36, %23[%4] : i64, view<1xi64>
    scf.yield %35 : i64
  } else {
    scf.yield %40 : i64
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  test.use %prefix : i64
  kernel.return
}

// ====
// RUN: pass target-legalize{mode=eager,policy=reference-only},canonicalize,cse,dce

// No fixed subgroup width is needed. Odd vector widths stream scalar
// components, and logical ordering flattens the multidimensional launch.
test.target<low_core> @target

kernel.def target(@target) @logical_components() {
  %unit = index.constant 1 : index
  %columns = index.constant 2 : index
  %rows = index.constant 3 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%columns, %rows, %unit) : index
} launch(%value: vector<3xi32>) {
  %prefix = kernel.workgroup.scan<addi> %value {direction = forward, mode = exclusive} : vector<3xi32>
  test.use %prefix : vector<3xi32>
  kernel.return
}

// ----
test.target<low_core> @target

kernel.def target(@target) @logical_components() {
  %unit = index.constant 1 : index
  %columns = index.constant 2 : index
  %rows = index.constant 3 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%columns, %rows, %unit) : index
} launch(%value: vector<3xi32>) {
  %5 = index.constant 0 : index
  %8 = kernel.workitem.id<y> : index
  %10 = index.constant 2 : index
  %12 = kernel.workitem.id<x> : index
  %87 = index.madd %8, %10, %12 : index
  %14 = index.constant 5 : index
  %86 = index.shrui %87, %10 : index
  %83 = index.constant 3 : index
  %84 = index.andi %87, %83 : index
  %18 = index.cmp eq, %84, %5 : index
  %20 = index.cmp eq, %84, %83 : index
  %21 = index.cmp eq, %87, %14 : index
  %22 = scalar.ori %20, %21 : i1
  %24 = index.constant 8 : offset
  %25 = buffer.alloca<workgroup> align(4) %24 : buffer
  %26 = index.constant 0 : offset
  %27 = buffer.view %25[%26] : buffer -> view<2xi32>
  %29 = index.constant 1 : index
  %prefix = scf.for %30 = [%5 to %83 step %29](%31 = %value : vector<3xi32>) -> (vector<3xi32>) {
    %33 = vector.extract %value[%30] : vector<3xi32> -> i32
    %34 = scalar.constant 0 : i32
    scf.if %18 {
      view.store %33, %27[%86] : i32, view<2xi32>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %36 = index.cmp eq, %84, %29 : index
    %37, %38 = scf.if %36 -> (i32, i32) {
      %39 = view.load %27[%86] : view<2xi32> -> i32
      %40 = scalar.addi %39, %33 : i32
      view.store %40, %27[%86] : i32, view<2xi32>
      scf.yield %40, %39 : i32, i32
    } else {
      scf.yield %33, %34 : i32, i32
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %42 = index.cmp eq, %84, %10 : index
    %43, %44 = scf.if %42 -> (i32, i32) {
      %45 = view.load %27[%86] : view<2xi32> -> i32
      %46 = scalar.addi %45, %33 : i32
      view.store %46, %27[%86] : i32, view<2xi32>
      scf.yield %46, %45 : i32, i32
    } else {
      scf.yield %37, %38 : i32, i32
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %49, %50 = scf.if %20 -> (i32, i32) {
      %51 = view.load %27[%86] : view<2xi32> -> i32
      %52 = scalar.addi %51, %33 : i32
      view.store %52, %27[%86] : i32, view<2xi32>
      scf.yield %52, %51 : i32, i32
    } else {
      scf.yield %43, %44 : i32, i32
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %55 = index.cmp ne, %86, %5 : index
    %56 = scalar.andi %55, %22 : i1
    scf.if %56 {
      %63 = view.load %27[%5] : view<2xi32> -> i32
      %64 = scalar.addi %63, %49 : i32
      view.store %64, %27[%29] : i32, view<2xi32>
    } else {
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %66 = scf.if %55 -> (i32) {
      %69 = view.load %27[%5] : view<2xi32> -> i32
      %70 = scalar.addi %69, %50 : i32
      %71 = scf.select %18, %69, %70 : i32
      scf.yield %71 : i32
    } else {
      scf.yield %50 : i32
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %74 = vector.insert %66 into %31[%30] : i32, vector<3xi32>
    scf.yield %74 : vector<3xi32>
  }
  test.use %prefix : vector<3xi32>
  kernel.return
}

// ====
// RUN: pass target-legalize{mode=eager,policy=reference-only},canonicalize,cse,dce

// Independent payloads reuse bounded publication storage only after final
// reads complete. The narrow payload takes the predicate storage adapter.
test.target<low_core> @target

kernel.def target(@target) @logical_reductions() {
  %unit = index.constant 1 : index
  %items = index.constant 5 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%value: i64, %predicate: i1) {
  %total, %parity = kernel.workgroup.reduce<addi> %value, %predicate : i64, i1
  test.use %total, %parity : i64, i1
  kernel.return
}

