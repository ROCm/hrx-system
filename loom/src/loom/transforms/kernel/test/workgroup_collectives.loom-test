  %unit = index.constant 1 : index
  %items = index.constant 3 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%value: i64) {
  %4 = index.constant 0 : index
  %7 = kernel.workitem.id<x> : index
  %13 = index.cmp eq, %7, %4 : index
  %19 = index.constant 8 : offset
  %20 = buffer.alloca<workgroup> align(8) %19 : buffer
  %21 = index.constant 0 : offset
  %22 = buffer.view %20[%21] : buffer -> view<1xi64>
  scf.if %13 {
    view.store %value, %22[%4] : i64, view<1xi64>
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %23 = index.constant 1 : index
  %24 = index.cmp eq, %7, %23 : index
  %38 = scf.if %24 -> (i64) {
    %27 = view.load %22[%4] : view<1xi64> -> i64
    %28 = scalar.addi %27, %value : i64
    view.store %28, %22[%4] : i64, view<1xi64>
    scf.yield %28 : i64
  } else {
    scf.yield %value : i64
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %29 = index.constant 2 : index
  %30 = index.cmp eq, %7, %29 : index
  %prefix = scf.if %30 -> (i64) {
    %33 = view.load %22[%4] : view<1xi64> -> i64
    %34 = scalar.addi %33, %value : i64
    view.store %34, %22[%4] : i64, view<1xi64>
    scf.yield %34 : i64
  } else {
    scf.yield %38 : i64
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  test.use %prefix : i64
  kernel.return
}

// ====
// RUN: pass target-legalize{mode=eager,policy=reference-only},canonicalize,cse,dce

// More subgroups than physical lanes: fold immutable partials without a
// second publication. Every lane reads all three partials after the barrier.
test.target<dense_subgroups> @target {subgroup_size = 2}

kernel.def target(@target) @many_subgroups() {
  %unit = index.constant 1 : index
  %items = index.constant 5 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%value: vector<2xi32>) {
  %total = kernel.workgroup.reduce<addi> %value : vector<2xi32>
  test.use %total : vector<2xi32>
  kernel.return
}

// ----
test.target<dense_subgroups> @target {subgroup_size = 2}

kernel.def target(@target) @many_subgroups() {
  %unit = index.constant 1 : index
  %items = index.constant 5 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%value: vector<2xi32>) {
  %4 = index.constant 0 : index
  %5 = kernel.subgroup.id : index
  %6 = kernel.subgroup.lane.id : index
  %7 = index.cmp eq, %6, %4 : index
  %42 = scalar.constant 2 : i32
  %43 = kernel.subgroup.active.mask : i32
  %44 = scalar.ctpopi %43 : i32
  %77 = index.cast %6 : index to i32
  %94 = scalar.constant 0 : i32
  %106 = scalar.constant -1 : i32
  %107 = scalar.addi %77, %106 : i32
  %104 = scalar.constant 1 : i32
  %105 = scalar.shrui %107, %104 : i32
  %82 = scalar.cmpi eq, %105, %94 : i32
  %83 = scalar.cmpi ult, %107, %42 : i32
  %85 = scalar.andi %82, %83 : i1
  %86 = scf.select %85, %107, %77 : i32
  %103 = scalar.andi %86, %104 : i32
  %88, %89 = kernel.subgroup.shuffle<index> %value, %103, %42 : vector<2xi32>, i32, i32
  %90 = scalar.andi %85, %89 : i1
  %53 = vector.extract %88[0] : vector<2xi32> -> i32
  %54 = vector.extract %value[0] : vector<2xi32> -> i32
  %55 = scalar.addi %53, %54 : i32
  %57 = scf.select %90, %55, %54 : i32
  %58 = vector.extract %88[1] : vector<2xi32> -> i32
  %59 = vector.extract %value[1] : vector<2xi32> -> i32
  %60 = scalar.addi %58, %59 : i32
  %62 = scf.select %90, %60, %59 : i32
  %64 = vector.splat %57 : vector<2xi32>
  %65 = vector.insert %62 into %64[1] : i32, vector<2xi32>
  %101 = scalar.addi %44, %106 : i32
  %51, %52 = kernel.subgroup.shuffle<index> %65, %101, %42 : vector<2xi32>, i32, i32
  %9 = index.constant 24 : offset
  %10 = buffer.alloca<workgroup> align(4) %9 : buffer
  %11 = index.constant 0 : offset
  %12 = buffer.view %10[%11] : buffer -> view<6xi32>
  scf.if %7 {
    %98 = index.constant 1 : index
    %99 = index.shli %5, %98 : index
    vector.store %51, %12[%99] : vector<2xi32>, view<6xi32>
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %17 = vector.load %12[%4] : view<6xi32> -> vector<2xi32>
  %92 = index.constant 2 : index
  %21 = vector.load %12[%92] : view<6xi32> -> vector<2xi32>
  %91 = index.constant 4 : index
  %26 = vector.load %12[%91] : view<6xi32> -> vector<2xi32>
  %28 = vector.extract %17[0] : vector<2xi32> -> i32
  %29 = vector.extract %21[0] : vector<2xi32> -> i32
  %30 = scalar.addi %28, %29 : i32
  %31 = vector.extract %26[0] : vector<2xi32> -> i32
  %32 = scalar.addi %30, %31 : i32
  %33 = vector.extract %17[1] : vector<2xi32> -> i32
  %34 = vector.extract %21[1] : vector<2xi32> -> i32
  %35 = scalar.addi %33, %34 : i32
  %36 = vector.extract %26[1] : vector<2xi32> -> i32
  %37 = scalar.addi %35, %36 : i32
  %39 = vector.splat %32 : vector<2xi32>
  %total = vector.insert %37 into %39[1] : i32, vector<2xi32>
  test.use %total : vector<2xi32>
  kernel.return
}

// ====
// RUN: pass target-legalize{mode=eager,policy=reference-only},canonicalize,cse,dce

// Eight components reuse one four-component slot through a uniform loop.
// The final read barrier precedes the next batch's initial publication.
test.target<low_core> @target

kernel.def target(@target) @stream_components() {
  %unit = index.constant 1 : index
  %items = index.constant 2 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%value: vector<8xi32>) {
  %prefix = kernel.workgroup.scan<addi> %value {direction = reverse, mode = exclusive} : vector<8xi32>
  test.use %prefix : vector<8xi32>
  kernel.return
}

// ----
test.target<low_core> @target

kernel.def target(@target) @stream_components() {
  %unit = index.constant 1 : index
  %items = index.constant 2 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%value: vector<8xi32>) {
  %4 = index.constant 0 : index
  %7 = kernel.workitem.id<x> : index
  %9 = index.constant 1 : index
  %10 = index.sub %9, %7 : index
  %14 = index.cmp eq, %10, %4 : index
  %20 = index.constant 16 : offset
  %21 = buffer.alloca<workgroup> align(4) %20 : buffer
  %22 = index.constant 0 : offset
  %23 = buffer.view %21[%22] : buffer -> view<4xi32>
  %24 = index.constant 8 : index
  %25 = index.constant 4 : index
  %prefix = scf.for %26 = [%4 to %24 step %25](%27 = %value : vector<8xi32>) -> (vector<8xi32>) {
    %29 = vector.slice %value[%26] : vector<8xi32> -> vector<4xi32>
    %88 = vector.splati 0 : vector<4xi32>
    scf.if %14 {
      vector.store %29, %23[%4] : vector<4xi32>, view<4xi32>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %35 = index.cmp eq, %10, %9 : index
    %87 = scf.if %35 -> (vector<4xi32>) {
      %40 = vector.load %23[%4] : view<4xi32> -> vector<4xi32>
      %60 = vector.extract %40[0] : vector<4xi32> -> i32
      %61 = vector.extract %value[%26] : vector<8xi32> -> i32
      %62 = scalar.addi %60, %61 : i32
      %63 = vector.extract %40[1] : vector<4xi32> -> i32
      %65 = index.add %26, %9 : index
      %66 = vector.extract %value[%65] : vector<8xi32> -> i32
      %67 = scalar.addi %63, %66 : i32
      %68 = vector.extract %40[2] : vector<4xi32> -> i32
      %69 = index.constant 2 : index
      %70 = index.add %26, %69 : index
      %71 = vector.extract %value[%70] : vector<8xi32> -> i32
      %72 = scalar.addi %68, %71 : i32
      %73 = vector.extract %40[3] : vector<4xi32> -> i32
      %74 = index.constant 3 : index
      %75 = index.add %26, %74 : index
      %76 = vector.extract %value[%75] : vector<8xi32> -> i32
      %77 = scalar.addi %73, %76 : i32
      %79 = vector.splat %62 : vector<4xi32>
      %80 = vector.insert %67 into %79[1] : i32, vector<4xi32>
      %81 = vector.insert %72 into %80[2] : i32, vector<4xi32>
      %82 = vector.insert %77 into %81[3] : i32, vector<4xi32>
      vector.store %82, %23[%4] : vector<4xi32>, view<4xi32>
      scf.yield %40 : vector<4xi32>
    } else {
      scf.yield %88 : vector<4xi32>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %44 = vector.extract %87[0] : vector<4xi32> -> i32
    %47 = vector.insert %44 into %27[%26] : i32, vector<8xi32>
    %48 = vector.extract %87[1] : vector<4xi32> -> i32
    %50 = index.add %26, %9 : index
    %51 = vector.insert %48 into %47[%50] : i32, vector<8xi32>
    %52 = vector.extract %87[2] : vector<4xi32> -> i32
    %53 = index.constant 2 : index
    %54 = index.add %26, %53 : index
    %55 = vector.insert %52 into %51[%54] : i32, vector<8xi32>
    %56 = vector.extract %87[3] : vector<4xi32> -> i32
    %57 = index.constant 3 : index
    %58 = index.add %26, %57 : index
    %59 = vector.insert %56 into %55[%58] : i32, vector<8xi32>
    scf.yield %59 : vector<8xi32>
  }
  test.use %prefix : vector<8xi32>
  kernel.return
}

// ====
// RUN: pass target-legalize{mode=eager,policy=reference-only},canonicalize,cse,dce

// Reference arithmetic cannot replace source-format-preserving sums/products.
// The policy applies to both the single-subgroup and logical relay paths.
test.target<linear_subgroups> @linear {subgroup_size = 4}

test.target<low_core> @logical

kernel.def target(@linear) @preserved_subgroup() {
  %unit = index.constant 1 : index
  %items = index.constant 3 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%value: f32) {
  %total = kernel.workgroup.reduce<addf, preserve> %value : f32
  %prefix = kernel.workgroup.scan<mulf, preserve> %value {direction = forward, mode = inclusive} : f32
  test.use %total, %prefix : f32, f32
  kernel.return
}

kernel.def target(@logical) @preserved_logical() {
  %unit = index.constant 1 : index
  %items = index.constant 9 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%value: f32) {
  %total = kernel.workgroup.reduce<mulf, preserve> %value : f32
  %prefix = kernel.workgroup.scan<addf, preserve> %value {direction = reverse, mode = exclusive} : f32
  test.use %total, %prefix : f32, f32
  kernel.return
}

