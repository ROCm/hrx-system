// ====
// RUN: pass target-legalize{mode=eager,policy=reference-only},canonicalize,cse,dce

// Reverse exclusive adjustment crosses the short final subgroup.
test.target<linear_subgroups> @target {subgroup_size = 2}

kernel.def target(@target) @reverse_prefix() {
  %unit = index.constant 1 : index
  %items = index.constant 3 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%value: vector<2xi32>) {
  %prefix = kernel.workgroup.scan<addi> %value {direction = reverse, mode = exclusive} : vector<2xi32>
  test.use %prefix : vector<2xi32>
  kernel.return
}

