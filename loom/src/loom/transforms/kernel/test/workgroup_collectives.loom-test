}

// ====
// RUN: pass target-legalize{mode=eager,policy=reference-only},canonicalize,cse,dce

// A one-workitem launch needs neither partition information nor scratch.
test.target<low_core> @target

kernel.def target(@target) @single_workitem() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%value: vector<4xf64>) {
  %total = kernel.workgroup.reduce<minnumf> %value : vector<4xf64>
  %prefix = kernel.workgroup.scan<minnumf> %value {direction = forward, mode = exclusive} : vector<4xf64>
  test.use %total, %prefix : vector<4xf64>, vector<4xf64>
  kernel.return
}

// ----
test.target<low_core> @target

kernel.def target(@target) @single_workitem() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%value: vector<4xf64>) {
  %prefix = vector.splatf inf : vector<4xf64>
  test.use %value, %prefix : vector<4xf64>, vector<4xf64>
  kernel.return
}

// ====
// RUN: pass target-legalize{mode=eager,policy=reference-only},canonicalize,cse,dce

// Dense membership permits reductions but does not establish scan order.
test.target<dense_subgroups> @target {subgroup_size = 4}

kernel.def target(@target) @dense_unordered() {
  %unit = index.constant 1 : index
  %items = index.constant 3 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%value: i64) {
  %prefix = kernel.workgroup.scan<addi> %value {direction = forward, mode = inclusive} : i64
  test.use %prefix : i64
  kernel.return
}

// ----
