    %42 = scalar.addi %41, %value : i64
    view.store %42, %24[%121] : i64, view<2xi64>
    scf.yield %42 : i64
  } else {
    scf.yield %116 : i64
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %45 = index.cmp ne, %121, %6 : index
  %46 = scalar.andi %45, %19 : i1
  scf.if %46 {
    %53 = view.load %24[%6] : view<2xi64> -> i64
    %54 = scalar.addi %53, %115 : i64
    view.store %54, %24[%20] : i64, view<2xi64>
  } else {
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %total = view.load %24[%20] : view<2xi64> -> i64
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %56 = index.constant 2 : offset
