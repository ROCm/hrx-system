// RUN: pass target-legalize{mode=eager,policy=reference-only},canonicalize,cse,dce

// Dense partials and the published result occupy different slots. Payloads
// share the two publication barriers; predicate storage uses bytes.
test.target<dense_subgroups> @target {subgroup_size = 2}

kernel.def target(@target) @partial_payloads() {
  %unit = index.constant 1 : index
  %items = index.constant 3 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%wide: i64, %pair: vector<2xi32>, %predicate: i1) {
  %wide_sum, %pair_sum, %parity = kernel.workgroup.reduce<addi> %wide, %pair, %predicate : i64, vector<2xi32>, i1
  test.use %wide_sum, %pair_sum, %parity : i64, vector<2xi32>, i1
  kernel.return
}

