  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %32 = index.cmp eq, %119, %120 : index
  %116 = scf.if %32 -> (i64) {
    %35 = view.load %24[%121] : view<2xi64> -> i64
    %36 = scalar.addi %35, %value : i64
    view.store %36, %24[%121] : i64, view<2xi64>
    scf.yield %36 : i64
  } else {
    scf.yield %117 : i64
