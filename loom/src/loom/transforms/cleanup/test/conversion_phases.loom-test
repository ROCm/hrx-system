  %result = vector.extsi %x : vector<4xi8> to vector<4xi32>
  func.return %result : vector<4xi32>
}

func.def @vector_integer_extension_matrix(%x: vector<4xi8>) -> (vector<4xi32>, vector<4xi32>, vector<4xi32>) {
  %signed_after_unsigned = vector.extui %x : vector<4xi8> to vector<4xi32>
  %unsigned_result = vector.extui %x : vector<4xi8> to vector<4xi32>
  %signed_middle = vector.extsi %x : vector<4xi8> to vector<4xi16>
  %unsigned_after_signed = vector.extui %signed_middle : vector<4xi16> to vector<4xi32>
  func.return %signed_after_unsigned, %unsigned_result, %unsigned_after_signed : vector<4xi32>, vector<4xi32>, vector<4xi32>
