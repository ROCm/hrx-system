func.def @vector_conversion_splats(%float_narrow: bf16, %float_wide: f32, %integer_narrow: i8, %integer_wide: i32) -> (vector<4xf32>, vector<4xbf16>, vector<4xi32>, vector<4xi32>, vector<4xi8>) {
  %203 = scalar.extf %float_narrow : bf16 to f32
  %float_extended = vector.splat %203 : vector<4xf32>
  %201 = scalar.fptrunc %float_wide : f32 to bf16
  %float_truncated = vector.splat %201 : vector<4xbf16>
  %199 = scalar.extsi %integer_narrow : i8 to i32
  %signed_extended = vector.splat %199 : vector<4xi32>
  %197 = scalar.extui %integer_narrow : i8 to i32
  %unsigned_extended = vector.splat %197 : vector<4xi32>
  %195 = scalar.trunci %integer_wide : i32 to i8
  %integer_truncated = vector.splat %195 : vector<4xi8>
  func.return %float_extended, %float_truncated, %signed_extended, %unsigned_extended, %integer_truncated : vector<4xf32>, vector<4xbf16>, vector<4xi32>, vector<4xi32>, vector<4xi8>
}

// ====

func.def @vector_unsigned_after_mixed_sign_extension(%positive: i8, %negative: i8) -> (vector<2xi32>) {
  %bounded_positive = scalar.assume %positive [range(%positive, 0, 127)] : i8
  %bounded_negative = scalar.assume %negative [range(%negative, -128, -1)] : i8
  %source = vector.from_elements %bounded_positive, %bounded_negative : vector<2xi8>
  %middle = vector.extsi %source : vector<2xi8> to vector<2xi16>
  %result = vector.extui %middle : vector<2xi16> to vector<2xi32>
  func.return %result : vector<2xi32>
}

// ----
func.def @vector_unsigned_after_mixed_sign_extension(%positive: i8, %negative: i8) -> (vector<2xi32>) {
  %bounded_positive = scalar.assume %positive [range(%positive, 0, 127)] : i8
  %bounded_negative = scalar.assume %negative [range(%negative, -128, -1)] : i8
  %source = vector.from_elements %bounded_positive, %bounded_negative : vector<2xi8>
  %middle = vector.extsi %source : vector<2xi8> to vector<2xi16>
  %result = vector.extui %middle : vector<2xi16> to vector<2xi32>
  func.return %result : vector<2xi32>
}

// ====
// RUN: pass canonicalize

// Universal cleanup preserves source and target-selected conversion forms. It
// only removes extension/truncation pairs whose endpoint type is exactly the
// original type.
func.def @scalar_float_source_chain(%x: f8E4M3) -> (f16) {
  %middle = scalar.extf %x : f8E4M3 to f32
  %result = scalar.fptrunc %middle : f32 to f16
  func.return %result : f16
}

func.def @scalar_integer_source_chain(%x: i8) -> (i32) {
  %middle = scalar.extui %x : i8 to i16
  %result = scalar.extui %middle : i16 to i32
  func.return %result : i32
}

func.def @scalar_nested_truncation(%x: i64) -> (i8) {
  %middle = scalar.trunci %x : i64 to i32
  %result = scalar.trunci %middle : i32 to i8
  func.return %result : i8
}

func.def @vector_float_source_chain(%x: vector<4xf8E4M3>) -> (vector<4xf16>) {
  %middle = vector.extf %x : vector<4xf8E4M3> to vector<4xf32>
  %result = vector.fptrunc %middle : vector<4xf32> to vector<4xf16>
  func.return %result : vector<4xf16>
}

func.def @vector_integer_source_chain(%x: vector<4xi8>) -> (vector<4xi32>) {
  %middle = vector.extui %x : vector<4xi8> to vector<4xi16>
  %result = vector.extui %middle : vector<4xi16> to vector<4xi32>
  func.return %result : vector<4xi32>
}

func.def @vector_conversion_splat(%x: bf16) -> (vector<4xf32>) {
  %splat = vector.splat %x : vector<4xbf16>
  %result = vector.extf %splat : vector<4xbf16> to vector<4xf32>
  func.return %result : vector<4xf32>
}

func.def @scalar_float_roundtrip(%x: f16) -> (f16) {
  %wide = scalar.extf %x : f16 to f32
  %result = scalar.fptrunc %wide : f32 to f16
  func.return %result : f16
}

func.def @scalar_signed_roundtrip(%x: i8) -> (i8) {
