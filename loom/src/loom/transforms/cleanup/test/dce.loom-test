// RUN: pass dce

// Dead code elimination on a single function.
func.def @dce_single(%x: i32) -> (i32) {
  %dead = test.constant 42 : i32
  func.return %x : i32
}
// ----
func.def @dce_single(%x: i32) -> (i32) {
  func.return %x : i32
}

// ====

// RUN: pass dce

// DCE runs on all functions in a module.
func.def @first(%x: i32) -> (i32) {
  %dead = test.constant 1 : i32
  func.return %x : i32
}

func.def @second(%y: i32) -> (i32) {
  %dead = test.constant 2 : i32
  func.return %y : i32
}
// ----
func.def @first(%x: i32) -> (i32) {
  func.return %x : i32
}

func.def @second(%y: i32) -> (i32) {
  func.return %y : i32
}

// ====

// RUN: pass dce

// Bodyless declarations are preserved unchanged.
func.decl @external(%z: i32) -> (i32)

func.def @has_body(%x: i32) -> (i32) {
  %dead = test.constant 99 : i32
  func.return %x : i32
}
// ----
func.decl @external(%z: i32) -> (i32)

func.def @has_body(%x: i32) -> (i32) {
  func.return %x : i32
}

// ====

// RUN: pass dce

// Unused plain loads have read effects but no semantic writeback, so they are
// dead when their results have no uses.
func.def @dead_view_load(%input: buffer) {
  %offset = index.constant 0 : offset
  %index = index.constant 0 : index
  %view = buffer.view %input[%offset] : buffer -> view<4xf32>
  %dead = view.load %view[%index] : view<4xf32> -> f32
  func.return
}
// ----
func.def @dead_view_load(%input: buffer) {
  func.return
}

// ====

// RUN: pass dce

// No-op: all code is live.
func.def @all_live(%a: i32, %b: i32) -> (i32) {
  %c = test.addi %a, %b : i32
  func.return %c : i32
}
// ----
func.def @all_live(%a: i32, %b: i32) -> (i32) {
  %c = test.addi %a, %b : i32
  func.return %c : i32
}

// ====

// RUN: verify

// A dimension carried only by a nested type-valued attribute is valid SSA.
func.def @attribute_dimension(%value: f32) -> (f32) {
  %width = index.constant 16 : index
  %annotated = test.attrs %value {shape = #test.options<mode = fast, element_type = vector<[%width]xf32>>} : f32
  func.return %annotated : f32
}

// ====

// RUN: pass dce

// A live attribute owner keeps its dimension provider live without operands
// or value-carried types referencing that provider.
func.def @live_attribute_dimension(%value: f32) -> (f32) {
  %width = index.constant 16 : index
  %annotated = test.attrs %value {shape = #test.options<mode = fast, element_type = vector<[%width]xf32>>} : f32
  func.return %annotated : f32
}

// ====

// RUN: pass dce

// Deleting an attribute owner releases its provider in the same DCE run.
func.def @dead_attribute_dimension(%value: f32) -> (f32) {
  %width = index.constant 16 : index
  %annotated = test.attrs %value {shape = #test.options<mode = fast, element_type = vector<[%width]xf32>>} : f32
  func.return %value : f32
}

// ----
func.def @dead_attribute_dimension(%value: f32) -> (f32) {
  func.return %value : f32
}

// ====

// RUN: pass dce

// Predicate-only providers also need notification after their owner dies.
func.def @dead_predicate_bound(%value: index) -> (index) {
  %upper_bound = index.constant 16 : index
  %bounded = index.assume %value [lt(%value, %upper_bound)] : index
  func.return %value : index
}

// ----
func.def @dead_predicate_bound(%value: index) -> (index) {
  func.return %value : index
}

// ====

// RUN: pass canonicalize

// The rewriter uses the same outgoing-reference notification contract.
func.def @rewrite_dead_attribute_dimension(%extent: index, %stride: index, %value: f32) -> (f32) {
  %width = index.add %extent, %stride : index
  %annotated = test.attrs %value {shape = #test.options<mode = fast, element_type = vector<[%width]xf32>>} : f32
  func.return %value : f32
}

// ----
func.def @rewrite_dead_attribute_dimension(%extent: index, %stride: index, %value: f32) -> (f32) {
  func.return %value : f32
}
