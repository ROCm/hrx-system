// RUN: pass canonicalize

// A branch-local view and its forwarded type cannot constrain the size
// argument on the path that bypasses both definitions.
func.def @cfg_extent_capture(%input: buffer, %extent: i32, %condition: i1) -> (i1) {
  %base = index.constant 0 : offset
  %c0 = scalar.constant 0 : i32
  %less = scalar.cmpi slt, %extent, %c0 : i32
  cfg.cond_br %condition, ^shaped, ^plain
^shaped:
  %view = buffer.view %input[%base] : buffer -> view<[%extent]xi32>
  cfg.br ^typed(%view: view<[%extent]xi32>)
^typed(%forwarded: view<[%extent]xi32>):
  test.use %forwarded : view<[%extent]xi32>
  func.return %less : i1
^plain:
  func.return %less : i1
}

// ----
func.def @cfg_extent_capture(%input: buffer, %extent: i32, %condition: i1) -> (i1) {
  %base = index.constant 0 : offset
  %c0 = scalar.constant 0 : i32
  %less = scalar.cmpi slt, %extent, %c0 : i32
  cfg.cond_br %condition, ^shaped, ^plain
^shaped:
  %view = buffer.view %input[%base] : buffer -> view<[%extent]xi32>
  cfg.br ^typed(%view: view<[%extent]xi32>)
^typed(%forwarded: view<[%extent]xi32>):
  test.use %forwarded : view<[%extent]xi32>
  func.return %less : i1
^plain:
  func.return %less : i1
}

