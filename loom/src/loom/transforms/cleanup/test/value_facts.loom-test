// RUN: pass canonicalize

func.def @cfg_join_unknown_and_zero_is_not_exact_zero(%cond: i1, %input: buffer) -> (f32) {
  %base = index.constant 0 : offset
  %index = index.constant 0 : index
  %padding = scalar.constant 0.0 : f32
  %scale = scalar.constant 2.0 : f32
  %view = buffer.view %input[%base] : buffer -> view<1xf32>
  cfg.cond_br %cond, ^load, ^pad
^load:
  %loaded = view.load %view[%index] : view<1xf32> -> f32
  cfg.br ^join(%loaded: f32)
^pad:
  cfg.br ^join(%padding: f32)
^join(%value: f32):
  %scaled = scalar.mulf<nnan|ninf|nsz> %value, %scale : f32
  func.return %scaled : f32
}

// ----
func.def @cfg_join_unknown_and_zero_is_not_exact_zero(%cond: i1, %input: buffer) -> (f32) {
  %base = index.constant 0 : offset
  %index = index.constant 0 : index
  %padding = scalar.constant 0.0 : f32
  %scale = scalar.constant 2.0 : f32
  %view = buffer.view %input[%base] : buffer -> view<1xf32>
  cfg.cond_br %cond, ^load, ^pad
^load:
  %loaded = view.load %view[%index] : view<1xf32> -> f32
  cfg.br ^join(%loaded: f32)
^pad:
  cfg.br ^join(%padding: f32)
^join(%value: f32):
  %scaled = scalar.mulf<nnan|ninf|nsz> %value, %scale : f32
  func.return %scaled : f32
}

// ====

// A normalized target query is an ordinary value-fact producer. Exact
// function facts fold it through canonicalization while a targetless function
// retains the query instead of acquiring a fabricated default.
target.generic<reference> @wave64 {subgroup_size = 64}

func.def target(@wave64) @exact_subgroup_size() -> (index) {
  %size = target.subgroup.size : index
  func.return %size : index
}

func.def @unknown_subgroup_size() -> (index) {
  %size = target.subgroup.size : index
  func.return %size : index
}

// ----
target.generic<reference> @wave64 {subgroup_size = 64}

func.def target(@wave64) @exact_subgroup_size() -> (index) {
  %size = index.constant 64 : index
  func.return %size : index
}

func.def @unknown_subgroup_size() -> (index) {
  %size = target.subgroup.size : index
  func.return %size : index
}
