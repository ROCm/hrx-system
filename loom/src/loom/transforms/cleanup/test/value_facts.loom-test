// RUN: pass canonicalize

func.def @cfg_join_unknown_and_zero_is_not_exact_zero(%cond: i1, %input: buffer) -> (f32) {
  %base = index.constant 0 : offset
  %index = index.constant 0 : index
  %padding = scalar.constant 0.0 : f32
  %scale = scalar.constant 2.0 : f32
  %view = buffer.view %input[%base] : buffer -> view<1xf32>
  cfg.cond_br %cond, ^load, ^pad
^load:
  %loaded = view.load %view[%index] : view<1xf32> -> f32
  cfg.br ^join(%loaded: f32)
^pad:
  cfg.br ^join(%padding: f32)
^join(%value: f32):
  %scaled = scalar.mulf<nnan|ninf|nsz> %value, %scale : f32
  func.return %scaled : f32
}

// ----
func.def @cfg_join_unknown_and_zero_is_not_exact_zero(%cond: i1, %input: buffer) -> (f32) {
  %base = index.constant 0 : offset
  %index = index.constant 0 : index
  %padding = scalar.constant 0.0 : f32
  %scale = scalar.constant 2.0 : f32
  %view = buffer.view %input[%base] : buffer -> view<1xf32>
  cfg.cond_br %cond, ^load, ^pad
^load:
  %loaded = view.load %view[%index] : view<1xf32> -> f32
  cfg.br ^join(%loaded: f32)
^pad:
  cfg.br ^join(%padding: f32)
^join(%value: f32):
  %scaled = scalar.mulf<nnan|ninf|nsz> %value, %scale : f32
  func.return %scaled : f32
}

// ====

// A normalized target query is an ordinary value-fact producer. Exact
// function facts fold it through canonicalization while a targetless function
// retains the query instead of acquiring a fabricated default.
target.generic<reference> @wave64 {subgroup_size = 64}

func.def target(@wave64) abi(object_function) @exact_subgroup_size() -> (index) {
  %size = target.subgroup.size : index
  func.return %size : index
}

func.def @unknown_subgroup_size() -> (index) {
  %size = target.subgroup.size : index
  func.return %size : index
}

// ----
target.generic<reference> @wave64 {subgroup_size = 64}

func.def target(@wave64) abi(object_function) @exact_subgroup_size() -> (index) {
  %size = index.constant 64 : index
  func.return %size : index
}

func.def @unknown_subgroup_size() -> (index) {
  %size = target.subgroup.size : index
  func.return %size : index
}

// ====

// The surviving symbolic term retains the SSA identity that carries range and
// relational facts, including after cancellation through an addition.
func.def @symbolic_difference_preserves_assumptions(%raw: index, %other: index, %upper: index) -> (index, index, index) {
  %bounded = index.assume %raw [range(%raw, 0, 128)] : index
  %related = index.assume %bounded [lt(%bounded, %upper)] : index
  %c0 = index.constant 0 : index
  %difference = index.sub %related, %c0 : index
  %sum = index.add %related, %other : index
  %cancelled = index.sub %sum, %other : index
  %identity = index.sub %related, %raw : index
  func.return %difference, %cancelled, %identity : index, index, index
}

// ----
func.def @symbolic_difference_preserves_assumptions(%raw: index, %other: index, %upper: index) -> (index, index, index) {
  %bounded = index.assume %raw [range(%raw, 0, 128)] : index
  %related = index.assume %bounded [lt(%bounded, %upper)] : index
  %identity = index.constant 0 : index
  func.return %related, %related, %identity : index, index, index
}

// ====

// AND preserves trailing zero bits, not arbitrary divisibility. For input
// three the masked value and remainder are both two, so the remainder is live.
func.def @masked_multiple_remainder(%input: index) -> (index) {
  %value = index.assume %input [range(%input, 3, 9), mul(%input, 3)] : index
  %mask = index.constant 6 : index
  %masked = index.andi %value, %mask : index
  %remainder = index.rem %masked, %mask : index
  func.return %remainder : index
}

// A negative mask preserves the input's nonnegative range and clears low bits.
func.def @negative_mask_alignment(%input: index) -> (index) {
  %value = index.assume %input [range(%input, 0, 31)] : index
  %mask = index.constant -8 : index
  %alignment = index.constant 8 : index
  %masked = index.andi %value, %mask : index
  %remainder = index.rem %masked, %alignment : index
  func.return %remainder : index
}

// ----
func.def @masked_multiple_remainder(%input: index) -> (index) {
  %value = index.assume %input [range(%input, 3, 9), mul(%input, 3)] : index
  %mask = index.constant 6 : index
  %masked = index.andi %value, %mask : index
  %remainder = index.rem %masked, %mask : index
  func.return %remainder : index
}

func.def @negative_mask_alignment(%input: index) -> (index) {
  %remainder = index.constant 0 : index
  func.return %remainder : index
}

