// RUN: pass canonicalize

// Reconstructing a transported view leaves its extent as a scalar argument.
// The later view type still constrains that argument before its facts publish.
func.def @reconstructed_extent(%input: buffer, %extent: i32) -> (i1) {
  %base = index.constant 0 : offset
  %c0 = scalar.constant 0 : i32
  %in_domain = scalar.cmpi sge, %extent, %c0 : i32
  cfg.cond_br %in_domain, ^forward, ^other
^forward:
  cfg.br ^typed(%extent: i32)
^typed(%size: i32):
  %view = buffer.view %input[%base] : buffer -> view<[%size]xi32>
  test.use %view : view<[%size]xi32>
  %nonnegative = scalar.cmpi sge, %size, %c0 : i32
  func.return %nonnegative : i1
^other:
  func.return %in_domain : i1
}
// ----
func.def @reconstructed_extent(%input: buffer, %extent: i32) -> (i1) {
  %base = index.constant 0 : offset
  %c0 = scalar.constant 0 : i32
  %in_domain = scalar.cmpi sge, %extent, %c0 : i32
  cfg.cond_br %in_domain, ^forward, ^other
^forward:
  cfg.br ^typed(%extent: i32)
^typed(%size: i32):
  %view = buffer.view %input[%base] : buffer -> view<[%size]xi32>
  test.use %view : view<[%size]xi32>
  %nonnegative = scalar.constant true : i1
  func.return %nonnegative : i1
^other:
  func.return %in_domain : i1
}

// ====

// A declaration describes a possible call, not an executing view definition.
// Nested parameterized types likewise do not impose a shaped-value domain.
func.def @nonexecuting_type_uses(%size: i32, %reference: test.ref<view<[%size]xi32>>) -> (i1) {
  func.decl @declared_shape(%view: view<[%size]xi32>)
  %c0 = scalar.constant 0 : i32
  %nonnegative = scalar.cmpi sge, %size, %c0 : i32
  func.return %nonnegative : i1
}
// ----
func.def @nonexecuting_type_uses(%size: i32, %reference: test.ref<view<[%size]xi32>>) -> (i1) {
  func.decl @declared_shape(%view: view<[%size]xi32>)
  %c0 = scalar.constant 0 : i32
  %nonnegative = scalar.cmpi sge, %size, %c0 : i32
  func.return %nonnegative : i1
}

// ====

// Unknown operation inference retains the verified scalar result type domain.
func.def @scalar_load_retains_byte_domain(%input: view<1xi8>) -> (i64, i64) {
  %value = view.load %input[0] : view<1xi8> -> i8
  %wide = scalar.extsi %value : i8 to i64
  %lower = test.fact_range_lo %wide : i64 -> i64
  %upper = test.fact_range_hi %wide : i64 -> i64
  func.return %lower, %upper : i64, i64
}

// ----
func.def @scalar_load_retains_byte_domain(%input: view<1xi8>) -> (i64, i64) {
  %lower = scalar.constant -128 : i64
  %upper = scalar.constant 127 : i64
  func.return %lower, %upper : i64, i64
}

