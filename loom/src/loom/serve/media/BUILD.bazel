load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "iree_select",
    "loom_cc_fuzz",
    "loom_cc_library",
    "loom_cc_test",
    "loom_config_compatible_with",
)
load("//loom/build_tools/bazel:python.bzl", "loom_py_test")

package(
    default_visibility = ["//loom/src/loom/serve:implementation"],
    features = ["layering_check"],
    licenses = ["notice"],
)

loom_cc_library(
    name = "digest",
    srcs = ["digest.c"],
    hdrs = ["digest.h"],
    deps = ["//runtime/src/iree/base"],
)

loom_cc_test(
    name = "digest_test",
    srcs = ["digest_test.cc"],
    deps = [
        ":digest",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "image_codec",
    hdrs = [
        "image_codec.h",
        "image_types.h",
    ],
    deps = [
        ":digest",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "image_metadata",
    srcs = ["image_metadata.c"],
    hdrs = ["image_metadata.h"],
    deps = ["//runtime/src/iree/base"],
)

loom_cc_library(
    name = "image_pam",
    srcs = ["image_pam.c"],
    target_compatible_with = loom_config_compatible_with(["//loom/config/serve:image_input_enabled"]),
    deps = [
        ":image_codec",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "image_png",
    srcs = ["image_png.c"],
    target_compatible_with = loom_config_compatible_with(["//loom/config/serve:png"]),
    deps = [
        ":image_codec",
        ":image_metadata",
        "//runtime/src/iree/base",
        "//third_party:libpng",
    ],
)

loom_cc_library(
    name = "image_jpeg",
    srcs = ["image_jpeg.c"],
    target_compatible_with = loom_config_compatible_with(["//loom/config/serve:jpeg"]),
    deps = [
        ":image_codec",
        ":image_metadata",
        "//runtime/src/iree/base",
        "//third_party:libjpeg_turbo",
    ],
)

loom_cc_library(
    name = "image_gif",
    srcs = ["image_gif.c"],
    target_compatible_with = loom_config_compatible_with(["//loom/config/serve:gif"]),
    deps = [
        ":image_codec",
        ":image_metadata",
        "//runtime/src/iree/base",
        "//third_party:giflib",
    ],
)

loom_cc_library(
    name = "image_webp",
    srcs = ["image_webp.c"],
    target_compatible_with = loom_config_compatible_with(["//loom/config/serve:webp"]),
    deps = [
        ":image_codec",
        ":image_metadata",
        "//runtime/src/iree/base",
        "//third_party:libwebp",
    ],
)

loom_cc_library(
    name = "image_codecs",
    srcs = ["image_codecs.c"],
    defines = iree_select({
        "//loom/config/serve:image_input_enabled": ["LOOM_SERVE_IMAGE_INPUT=1"],
        "//conditions:default": ["LOOM_SERVE_IMAGE_INPUT=0"],
    }) + iree_select({
        "//loom/config/serve:png": ["LOOM_SERVE_IMAGE_CODEC_PNG=1"],
        "//conditions:default": ["LOOM_SERVE_IMAGE_CODEC_PNG=0"],
    }) + iree_select({
        "//loom/config/serve:jpeg": ["LOOM_SERVE_IMAGE_CODEC_JPEG=1"],
        "//conditions:default": ["LOOM_SERVE_IMAGE_CODEC_JPEG=0"],
    }) + iree_select({
        "//loom/config/serve:gif": ["LOOM_SERVE_IMAGE_CODEC_GIF=1"],
        "//conditions:default": ["LOOM_SERVE_IMAGE_CODEC_GIF=0"],
    }) + iree_select({
        "//loom/config/serve:webp": ["LOOM_SERVE_IMAGE_CODEC_WEBP=1"],
        "//conditions:default": ["LOOM_SERVE_IMAGE_CODEC_WEBP=0"],
    }),
    deps = [
        ":image_codec",
        "//runtime/src/iree/base",
    ] + iree_select({
        "//loom/config/serve:image_input_enabled": [":image_pam"],
        "//conditions:default": [],
    }) + iree_select({
        "//loom/config/serve:png": [":image_png"],
        "//conditions:default": [],
    }) + iree_select({
        "//loom/config/serve:jpeg": [":image_jpeg"],
        "//conditions:default": [],
    }) + iree_select({
        "//loom/config/serve:gif": [":image_gif"],
        "//conditions:default": [],
    }) + iree_select({
        "//loom/config/serve:webp": [":image_webp"],
        "//conditions:default": [],
    }),
)

loom_cc_library(
    name = "image",
    srcs = ["image.c"],
    hdrs = ["image.h"],
    deps = [
        ":digest",
        ":image_codec",
        ":image_codecs",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:base64",
        "//runtime/src/iree/base/internal:json",
    ],
)

loom_cc_test(
    name = "image_test",
    srcs = ["image_test.cc"],
    deps = [
        ":image",
        ":image_codec",
        ":image_codecs",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:base64",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "image_request",
    srcs = ["image_request.c"],
    hdrs = ["image_request.h"],
    deps = [
        ":image",
        "//runtime/src/iree/base",
        "//runtime/src/iree/vm",
    ],
)

loom_cc_test(
    name = "image_pam_test",
    srcs = ["image_pam_test.cc"],
    target_compatible_with = loom_config_compatible_with(["//loom/config/serve:image_input_enabled"]),
    deps = [
        ":image",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:base64",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_test(
    name = "image_request_test",
    srcs = ["image_request_test.cc"],
    deps = [
        ":image",
        ":image_request",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
        "//runtime/src/iree/vm",
        "//runtime/src/iree/vm:test_support",
    ],
)

loom_cc_fuzz(
    name = "image_fuzz",
    srcs = ["image_fuzz.cc"],
    deps = [
        ":image",
        ":image_codec",
        ":image_codecs",
        ":image_request",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:base64",
        "//runtime/src/iree/vm",
    ],
)

loom_py_test(
    name = "image_fuzz_test",
    srcs = ["image_fuzz_test.py"],
    args = [
        "$(rootpath :image_fuzz)",
        "$(rootpath testdata/image_fuzz/png.txt)",
    ],
    data = [":image_fuzz"] + glob(["testdata/image_fuzz/*.txt"]),
    tags = [
        "manual",
        "skip-bazel_to_cmake",
    ],
)

loom_cc_library(
    name = "audio_resampler",
    srcs = ["audio_resampler.c"],
    hdrs = ["audio_resampler.h"],
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal",
    ],
)

loom_cc_test(
    name = "audio_resampler_test",
    srcs = ["audio_resampler_test.cc"],
    deps = [
        ":audio_resampler",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "audio_decoder",
    srcs = iree_select({
        "//loom/config/serve:audio_decoding": ["audio_decoder.c"],
        "//conditions:default": ["audio_decoder_disabled.c"],
    }),
    hdrs = ["audio_decoder.h"],
    deps = [
        "//runtime/src/iree/base",
    ] + iree_select({
        "//loom/config/serve:audio_decoding": ["//third_party:miniaudio"],
        "//conditions:default": [],
    }),
)

loom_cc_test(
    name = "audio_decoder_test",
    srcs = ["audio_decoder_test.cc"],
    args = ["--audio_fixture=$(rootpath testdata/audio/sample.flac)"],
    data = glob(["testdata/audio/*"]),
    defines = iree_select({
        "//loom/config/serve:wav": ["LOOM_TEST_AUDIO_WAV=1"],
        "//conditions:default": ["LOOM_TEST_AUDIO_WAV=0"],
    }) + iree_select({
        "//loom/config/serve:mp3": ["LOOM_TEST_AUDIO_MP3=1"],
        "//conditions:default": ["LOOM_TEST_AUDIO_MP3=0"],
    }) + iree_select({
        "//loom/config/serve:flac": ["LOOM_TEST_AUDIO_FLAC=1"],
        "//conditions:default": ["LOOM_TEST_AUDIO_FLAC=0"],
    }),
    deps = [
        ":audio_decoder",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/tooling:flags",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
        "//runtime/src/iree/vm:test_support",
    ],
)

exports_files(
    [
        "testdata/audio/sample.flac",
        "testdata/audio/sample.mp3",
    ],
    visibility = ["//loom/src/loom/serve:implementation"],
)
