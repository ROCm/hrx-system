        "//loom/src/loom/serve/server:router",
        "//loom/src/loom/serve/service",
        "//loom/src/loom/serve/telemetry:latency",
        "//loom/src/loom/serve/testing:http_harness",
        "//loom/src/loom/serve/testing:model",
        "//loom/src/loom/serve/testing:native_allocator",
        "//loom/src/loom/serve/testing:package",
        "//loom/src/loom/serve/testing:service_application",
