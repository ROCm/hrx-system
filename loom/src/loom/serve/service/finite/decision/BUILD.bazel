load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library")

package(
    default_visibility = ["//loom/src/loom/serve:implementation"],
    features = ["layering_check"],
    licenses = ["notice"],
)

# Compiled suite shared by physical target registrations; helpers stay private.

loom_cc_library(
    name = "source_service_tests",
    testonly = True,
    srcs = ["source_service_test.cc"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//loom/src/loom/serve:implementation"],
    deps = [
        "//loom/src/loom/runtime/device",
        "//loom/src/loom/runtime/execution",
        "//loom/src/loom/runtime/host",
        "//loom/src/loom/runtime/testing:application",
        "//loom/src/loom/serve/server:registry",
        "//loom/src/loom/serve/server:resources",
        "//loom/src/loom/serve/server:router",
        "//loom/src/loom/serve/service/finite:http",
        "//loom/src/loom/serve/testing:http_harness",
        "//loom/src/loom/serve/testing:model",
        "//loom/src/loom/serve/testing:package",
        "//loom/src/loom/serve/transport/http:listener",
        "//loom/src/loom/serve/transport/http:server",
        "//loom/src/loom/service/finite:call",
        "//loom/src/loom/service/finite:model",
        "//loom/src/loom/service/finite:registration",
        "//loom/src/loom/service/finite:result",
        "//loom/src/loom/service/finite:service",
        "//loom/src/loom/service/finite/decision:native_service_tests",
        "//loom/src/loom/service/finite/decision:protocol",
        "//loom/src/loom/service/finite/embedding:protocol",
        "//runtime/src/iree/async",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:json",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/task:owner",
        "//runtime/src/iree/testing:gtest",
    ],
    alwayslink = True,
)
