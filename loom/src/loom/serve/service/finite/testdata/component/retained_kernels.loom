target.decl @device

// Device state advances independently of the host's next-epoch offer.
kernel.def target(@device) @advance() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%input: buffer, %output: buffer, %state: buffer) {
  %origin = index.constant 0 : offset
  %range_offset = index.constant 24 : offset
  %range = buffer.view %input[%range_offset] : buffer -> view<1xi32>
  %first = view.load %range[0] : view<1xi32> -> i32
  %bounded_first = scalar.assume %first [range(%first, 0, 1)] : i32
  %first_index = index.cast %bounded_first : i32 to index
  %stride = index.constant 20 : offset
  %base = index.scale %first_index, %stride : index, offset -> offset
  %values = buffer.view %state[%base] : buffer -> view<4xf32>
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %c2 = scalar.constant 2.0 : f32
  scf.for %i = [%begin to %end step %step] {
    %value = view.load %values[%i] : view<4xf32> -> f32
    %next = scalar.mulf %value, %c2 : f32
    view.store %next, %values[%i] : f32, view<4xf32>
  }
  %cursor_field = index.constant 16 : offset
  %cursor_offset = index.add %base, %cursor_field : offset
  %cursor = buffer.view %state[%cursor_offset] : buffer -> view<1xi32>
  %previous = view.load %cursor[0] : view<1xi32> -> i32
  %c1 = scalar.constant 1 : i32
  %next = scalar.addi %previous, %c1 : i32
  view.store %next, %cursor[0] : i32, view<1xi32>
  kernel.return
}
