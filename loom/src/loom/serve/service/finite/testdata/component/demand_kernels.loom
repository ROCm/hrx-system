target.decl @device

kernel.def target(@device) @descriptors() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%output: buffer) {
  %offset = index.constant 24 : offset
  %records = buffer.view %output[%offset] : buffer -> view<6xi64>
  %entry_offset = scalar.constant 0 : i64
  %length = scalar.constant 4 : i64
  %first = scalar.constant 16 : i64
  %second = scalar.constant 20 : i64
  view.store %entry_offset, %records[0] : i64, view<6xi64>
  view.store %first, %records[1] : i64, view<6xi64>
  view.store %length, %records[2] : i64, view<6xi64>
  view.store %entry_offset, %records[3] : i64, view<6xi64>
  view.store %second, %records[4] : i64, view<6xi64>
  view.store %length, %records[5] : i64, view<6xi64>
  kernel.return
}

kernel.def target(@device) @scale() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %table_offset = index.constant 16 : offset
  // The single-request cohort has one 16-byte directory record.
  %request_offset = index.constant 16 : offset
  %input_view = buffer.view %input[%request_offset] : buffer -> view<4xf32>
  %output_view = buffer.view %output[%origin] : buffer -> view<4xf32>
  %tables = buffer.view %output[%table_offset] : buffer -> view<2xf32>
  %first = view.load %tables[0] : view<2xf32> -> f32
  %second = view.load %tables[1] : view<2xf32> -> f32
  %scale = scalar.addf %first, %second : f32
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  scf.for %i = [%c0 to %c4 step %c1] {
    %value = view.load %input_view[%i] : view<4xf32> -> f32
    %result = scalar.mulf %value, %scale : f32
    view.store %result, %output_view[%i] : f32, view<4xf32>
  }
  kernel.return
}

command.def public @produce() launch(%input: buffer, %output: buffer) {
  kernel.launch @descriptors(%output) : (buffer)
  command.return
}

command.def public @consume() launch(%input: buffer, %output: buffer) {
  kernel.launch @scale(%input, %output) : (buffer, buffer)
  command.return
}
