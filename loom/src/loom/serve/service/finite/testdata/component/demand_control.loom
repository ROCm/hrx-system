type.decl import("finite", "batch") @FiniteBatch

type.decl import("hal", "buffer") @HalBuffer

type.decl import("hal", "fence") @HalFence

type.decl import("hal", "file") @HalFile

func.decl import("finite", "batch_pack") @finite_batch_pack(%batch: ptr<@FiniteBatch>) -> (buffer, buffer)

func.decl import("finite", "batch_finish") @finite_batch_finish(%batch: ptr<@FiniteBatch>)

func.decl import("prepare") @source(%directory: buffer, %path: buffer) -> (i32)

func.decl import("input") @require(%condition: i32, %message: buffer)

func.decl import("runner") @execute_2(%stage: i32, %input: ptr<@HalBuffer>, %output: ptr<@HalBuffer>) -> (i64)

func.decl import("runner") @fence(%work: i64) -> (ref<@HalFence>)

func.decl import("runner") @join(%ready: ptr<@HalFence>)

func.decl import("parameters") @file(%source: i32, %key: buffer) -> (ref<@HalFile>, i64, i64)

func.decl import("hal.file") @read_indirect(%files: view<2xptr<@HalFile>> {access = read}, %file_windows: view<4xi64> {access = read}, %buffers: view<1xptr<@HalBuffer>> {access = read}, %buffer_windows: view<2xi64> {access = read}, %wait: ptr<@HalFence>, %records: ptr<@HalBuffer>, %records_offset: i64, %records_length: i64, %count: ptr<@HalBuffer>, %count_offset: i64) -> (ref<@HalFence>)

func.def public @prepare_request(%state: buffer, %input: buffer) -> (buffer, i64, i64) {
  %c1 = scalar.constant 1 : i64
  %c0 = scalar.constant 0 : i64
  func.return %input, %c1, %c0 : buffer, i64, i64
}

func.def public @prepare_batch(%directory: buffer, %tags: buffer, %batch: ptr<@FiniteBatch>) -> (i32, buffer, buffer) {
  %ranges, %input = func.call @finite_batch_pack(%batch) : (ptr<@FiniteBatch>) -> (buffer, buffer)
  %origin = index.constant 0 : offset
  %range = buffer.view %ranges[%origin] : buffer -> view<1x2xi64>
  %first = view.load %range[0, 0] : view<1x2xi64> -> i64
  %first_bounded = scalar.assume %first [range(%first, 0, 9223372036854775807)] : i64
  %request_offset = index.cast %first_bounded : i64 to offset
  %request = buffer.view %input[%request_offset] : buffer -> view<4xf32>
  %value = view.load %request[0] : view<4xf32> -> f32
  %threshold = scalar.constant 4.0 : f32
  %alternate = scalar.cmpf ogt, %value, %threshold : f32
  %path = scf.if %alternate -> (buffer) {
    %second = buffer.constant utf8("second.safetensors") : buffer
    scf.yield %second : buffer
  } else {
    %first = buffer.constant utf8("weights.safetensors") : buffer
    scf.yield %first : buffer
  }
  %source = func.call @source(%directory, %path) : (buffer, buffer) -> (i32)
  %c72 = index.constant 72 : offset
  %plan = buffer.alloca<private> align(8) %c72 : buffer
  %values = buffer.view %plan[%origin] : buffer -> view<9xi64>
  %c0 = scalar.constant 0 : i64
  %c1 = scalar.constant 1 : i64
  %c4 = scalar.constant 4 : i64
  %c16 = scalar.constant 16 : i64
  %c192 = scalar.constant 192 : i64
  view.store %c192, %values[0] : i64, view<9xi64>
  view.store %c16, %values[1] : i64, view<9xi64>
  view.store %c1, %values[2] : i64, view<9xi64>
  view.store %c1, %values[3] : i64, view<9xi64>
  view.store %c0, %values[4] : i64, view<9xi64>
  view.store %c1, %values[5] : i64, view<9xi64>
  view.store %c4, %values[6] : i64, view<9xi64>
  view.store %c0, %values[7] : i64, view<9xi64>
  view.store %c4, %values[8] : i64, view<9xi64>
  %c0_f32 = scalar.constant 0.0 : f32
  %reject = scalar.cmpf olt, %value, %c0_f32 : f32
  %stage = scalar.extui %reject : i1 to i32
  func.return %stage, %input, %plan : i32, buffer, buffer
}

func.def public @run(%state: buffer, %stage: i32, %input: ptr<@HalBuffer>, %output: ptr<@HalBuffer>, %batch: ptr<@FiniteBatch>) {
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %records_offset = scalar.constant 64 : i64
  %records_length = scalar.constant 128 : i64
  %count_offset = scalar.constant 24 : i64
  %payload_offset = scalar.constant 16 : i64
  %payload_length = scalar.constant 8 : i64
  %key = buffer.constant utf8("factor") : buffer
  %first_file, %first_origin, %first_length = func.call @file(%c0, %key) : (i32, buffer) -> (ref<@HalFile>, i64, i64)
  %second_file, %second_origin, %second_length = func.call @file(%c1, %key) : (i32, buffer) -> (ref<@HalFile>, i64, i64)
  %files = view.alloca<private> : view<2xptr<@HalFile>>
  %file_windows = view.alloca<private> : view<4xi64>
  %first_pointer = ref.borrow %first_file : ref<@HalFile> -> ptr<@HalFile>
  %second_pointer = ref.borrow %second_file : ref<@HalFile> -> ptr<@HalFile>
  view.store %first_pointer, %files[0] : ptr<@HalFile>, view<2xptr<@HalFile>>
  view.store %second_pointer, %files[1] : ptr<@HalFile>, view<2xptr<@HalFile>>
  view.store %first_origin, %file_windows[0] : i64, view<4xi64>
  view.store %first_length, %file_windows[1] : i64, view<4xi64>
  view.store %second_origin, %file_windows[2] : i64, view<4xi64>
  view.store %second_length, %file_windows[3] : i64, view<4xi64>
  %buffers = view.alloca<private> : view<1xptr<@HalBuffer>>
  %buffer_windows = view.alloca<private> : view<2xi64>
  view.store %output, %buffers[0] : ptr<@HalBuffer>, view<1xptr<@HalBuffer>>
  view.store %payload_offset, %buffer_windows[0] : i64, view<2xi64>
  view.store %payload_length, %buffer_windows[1] : i64, view<2xi64>
  %producer = func.call @execute_2(%c0, %input, %output) : (i32, ptr<@HalBuffer>, ptr<@HalBuffer>) -> (i64)
  %produced = func.call @fence(%producer) : (i64) -> (ref<@HalFence>)
  %wait = ref.borrow %produced : ref<@HalFence> -> ptr<@HalFence>
  %ready = func.call @read_indirect(%files, %file_windows, %buffers, %buffer_windows, %wait, %output, %records_offset, %records_length, %output, %count_offset) : (view<2xptr<@HalFile>>, view<4xi64>, view<1xptr<@HalBuffer>>, view<2xi64>, ptr<@HalFence>, ptr<@HalBuffer>, i64, i64, ptr<@HalBuffer>, i64) -> (ref<@HalFence>)
  ref.release %produced : ref<@HalFence>
  ref.release %first_file : ref<@HalFile>
  ref.release %second_file : ref<@HalFile>
  %reject = scalar.cmpi ne, %stage, %c0 : i32
  scf.if %reject {
    func.call @require(%c0, %key) : (i32, buffer)
  }
  %completion = ref.borrow %ready : ref<@HalFence> -> ptr<@HalFence>
  func.call @join(%completion) : (ptr<@HalFence>)
  ref.release %ready : ref<@HalFence>
  %consumer = func.call @execute_2(%c1, %input, %output) : (i32, ptr<@HalBuffer>, ptr<@HalBuffer>) -> (i64)
  func.return
}

func.def public @collect_batch(%state: buffer, %batch: ptr<@FiniteBatch>) {
  func.call @finite_batch_finish(%batch) : (ptr<@FiniteBatch>)
  func.return
}
