target.decl @device

kernel.def target(@device) @prepare_factor() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%storage: buffer) {
  %origin = index.constant 0 : offset
  %factor = buffer.view %storage[%origin] : buffer -> view<1xf32>
  %value = view.load %factor[0] : view<1xf32> -> f32
  %c2 = scalar.constant 2.0 : f32
  %prepared = scalar.mulf %value, %c2 : f32
  view.store %prepared, %factor[0] : f32, view<1xf32>
  kernel.return
}

command.program.def public @prepare_weights() launch(%storage: buffer) {
  kernel.launch @prepare_factor(%storage) : (buffer)
  command.return
}

kernel.def target(@device) @scale() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%factor: view<1xf32>, %input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %input_view = buffer.view %input[%origin] : buffer -> view<4xf32>
  %output_view = buffer.view %output[%origin] : buffer -> view<4xf32>
  %scale = view.load %factor[0] : view<1xf32> -> f32
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  scf.for %i = [%c0 to %c4 step %c1] {
    %value = view.load %input_view[%i] : view<4xf32> -> f32
    %result = scalar.mulf %value, %scale : f32
    view.store %result, %output_view[%i] : f32, view<4xf32>
  }
  kernel.return
}

kernel.def target(@device) @copy() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %input_view = buffer.view %input[%origin] : buffer -> view<4xf32>
  %output_view = buffer.view %output[%origin] : buffer -> view<4xf32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  scf.for %i = [%c0 to %c4 step %c1] {
    %value = view.load %input_view[%i] : view<4xf32> -> f32
    view.store %value, %output_view[%i] : f32, view<4xf32>
  }
  kernel.return
}

command.program.def public @project() launch(%weights: buffer, %input: buffer, %output: buffer) {
  %factor = command.parameter %weights, "factor" : view<1xf32>
  %c16 = index.constant 16 : offset
  %hidden = buffer.alloca<global> align(16) %c16 : buffer
  kernel.launch @scale(%factor, %input, %hidden) : (view<1xf32>, buffer, buffer)
  kernel.launch @copy(%hidden, %output) : (buffer, buffer)
  command.return
}
