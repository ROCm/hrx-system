func.decl import("prepare") @stage(%root: buffer, %execution: i32, %tag: i64) -> (i32)

func.decl import("prepare") @source(%directory: buffer, %path: buffer) -> (i32)

func.decl import("prepare") @parameter(%stage: i32, %binding: i32, %owner: i32, %input: i32, %source: i32, %policy: buffer)

func.def public @prepare(%directory: buffer, %options: buffer) -> (i64, i64, i64, i64, buffer, buffer, buffer) {
  %primary_execution = scalar.constant 0 : i32
  %c0_source = scalar.constant 0 : i32
  %c0_i32 = scalar.constant 0 : i32
  %c0_i64 = scalar.constant 0 : i64
  %c1_i64 = scalar.constant 1 : i64
  %c16_i64 = scalar.constant 16 : i64
  %input_capacity = scalar.constant 48 : i64
  %output_capacity = scalar.constant 131072 : i64
  %root = buffer.constant utf8("project") : buffer
  %stage = func.call @stage(%root, %primary_execution, %c0_i64) : (buffer, i32, i64) -> (i32)
  %checkpoint = buffer.constant utf8("weights.safetensors") : buffer
  %policy = buffer.constant utf8("policy.loom") : buffer
  %source = func.call @source(%directory, %checkpoint) : (buffer, buffer) -> (i32)
  func.call @parameter(%stage, %c0_i32, %primary_execution, %c0_source, %source, %policy) : (i32, i32, i32, i32, i32, buffer)
  %empty = buffer.constant utf8("") : buffer
  %name = buffer.constant utf8("fixture-component") : buffer
  func.return %c1_i64, %input_capacity, %output_capacity, %c16_i64, %empty, %name, %empty : i64, i64, i64, i64, buffer, buffer, buffer
}
