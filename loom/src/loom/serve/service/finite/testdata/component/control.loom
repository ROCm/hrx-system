func.decl import("runner") @execute_2(%stage: i32, %input: hal.buffer, %output: hal.buffer) -> (i64)

func.def public @prepare_request(%state: buffer, %input: buffer) -> (buffer, i64, i64) {
  %origin = index.constant 0 : offset
  %values_bytes = index.constant 16 : offset
  %packet_bytes = index.constant 32 : offset
  %packet = buffer.alloca<private> align(16) %packet_bytes : buffer
  buffer.copy %input[%origin], %packet[%origin], %values_bytes
  %counts = buffer.view %packet[%values_bytes] : buffer -> view<4xi32>
  %workgroup_count = scalar.constant 1 : i32
  %requested_length = buffer.view %input[%values_bytes] : buffer -> view<1xi32>
  %output_length = view.load %requested_length[0] : view<1xi32> -> i32
  view.store %workgroup_count, %counts[0] : i32, view<4xi32>
  view.store %workgroup_count, %counts[1] : i32, view<4xi32>
  view.store %workgroup_count, %counts[2] : i32, view<4xi32>
  view.store %output_length, %counts[3] : i32, view<4xi32>
  %c1 = scalar.constant 1 : i64
  %c0 = scalar.constant 0 : i64
  func.return %packet, %c1, %c0 : buffer, i64, i64
}

func.def public @prepare_batch(%state: buffer, %tags: buffer, %ranges: buffer, %input: buffer) -> (i32, buffer, buffer) {
  %origin = index.constant 0 : offset
  %c72 = index.constant 72 : offset
  %plan = buffer.alloca<private> align(8) %c72 : buffer
  %values = buffer.view %plan[%origin] : buffer -> view<9xi64>
  %c0 = scalar.constant 0 : i64
  %c1 = scalar.constant 1 : i64
  %c4 = scalar.constant 4 : i64
  %c16 = scalar.constant 16 : i64
  %packet = buffer.view %input[%origin] : buffer -> view<8xi32>
  %output_length32 = view.load %packet[7] : view<8xi32> -> i32
  %output_length = scalar.extui %output_length32 : i32 to i64
  view.store %output_length, %values[0] : i64, view<9xi64>
  view.store %c16, %values[1] : i64, view<9xi64>
  view.store %c1, %values[2] : i64, view<9xi64>
  view.store %c1, %values[3] : i64, view<9xi64>
  view.store %c0, %values[4] : i64, view<9xi64>
  view.store %c1, %values[5] : i64, view<9xi64>
  view.store %c4, %values[6] : i64, view<9xi64>
  view.store %c0, %values[7] : i64, view<9xi64>
  view.store %c4, %values[8] : i64, view<9xi64>
  %stage = scalar.constant 0 : i32
  func.return %stage, %input, %plan : i32, buffer, buffer
}

func.def public @run(%stage: i32, %input: hal.buffer, %output: hal.buffer) {
  %work = func.call @execute_2(%stage, %input, %output) : (i32, hal.buffer, hal.buffer) -> (i64)
  func.return
}
