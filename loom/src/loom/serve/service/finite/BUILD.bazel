load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library")

package(
    default_visibility = ["//loom/src/loom/serve:implementation"],
    features = ["layering_check"],
    licenses = ["notice"],
)

loom_cc_library(
    name = "http",
    srcs = ["http.c"],
    hdrs = ["http.h"],
    deps = [
        "//loom/src/loom/serve/service",
        "//loom/src/loom/serve/service:endpoint",
        "//loom/src/loom/serve/transport/http:request",
        "//loom/src/loom/serve/transport/http:server",
        "//loom/src/loom/service:kind",
        "//loom/src/loom/service/finite:consumer",
        "//loom/src/loom/service/finite:protocol",
        "//loom/src/loom/service/finite:service",
        "//loom/src/loom/util:json",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/base",
    ],
)
