load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_config_compatible_with")

package(
    default_visibility = ["//loom/src/loom/serve:implementation"],
    features = ["layering_check"],
    licenses = ["notice"],
)

filegroup(
    name = "component_testdata",
    testonly = True,
    srcs = [
        "testdata/component/control.loom",
        "testdata/component/kernels.loom",
        "testdata/component/policy.loom",
        "testdata/component/prepare.loom",
    ],
    visibility = ["//visibility:public"],
)

exports_files(
    ["testdata/component/prepare.loom"],
    visibility = ["//visibility:public"],
)

loom_cc_library(
    name = "component_test_fixture",
    testonly = True,
    srcs = ["component_test_fixture.cc"],
    hdrs = ["component_test_fixture.h"],
    visibility = ["//visibility:private"],
    deps = [
        ":component",
        ":model",
        "//loom/src/loom/serve/runtime/device",
        "//loom/src/loom/serve/runtime/execution",
        "//loom/src/loom/serve/runtime/host",
        "//loom/src/loom/serve/runtime/parameter:residency",
        "//loom/src/loom/serve/testing:service_application",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/task",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:temp_file",
        "//runtime/src/iree/vm",
    ],
)

loom_cc_library(
    name = "component_tests",
    testonly = True,
    srcs = ["component_test.cc"],
    visibility = ["//loom/src/loom/serve:implementation"],
    deps = [
        ":component_test_fixture",
    ],
    alwayslink = True,
)

loom_cc_library(
    name = "component_storage_tests",
    testonly = True,
    srcs = ["component_storage_test.cc"],
    visibility = ["//loom/src/loom/serve:implementation"],
    deps = [
        ":component_test_fixture",
    ],
    alwayslink = True,
)

loom_cc_library(
    name = "component_elastic_storage_tests",
    testonly = True,
    srcs = ["component_elastic_storage_test.cc"],
    deps = [":component_test_fixture"],
    alwayslink = True,
)

loom_cc_library(
    name = "component",
    srcs = ["component.c"],
    hdrs = ["component.h"],
    deps = [
        ":model",
        "//loom/src/loom/serve/runtime/device",
        "//loom/src/loom/serve/runtime/host:wake",
        "//loom/src/loom/serve/runtime/parameter:residency",
        "//loom/src/loom/serve/runtime/program:compilation",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "protocol",
    hdrs = ["protocol.h"],
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/vm",
    ],
)

loom_cc_library(
    name = "service",
    srcs = ["service.c"],
    hdrs = ["service.h"],
    deps = [
        ":model",
        ":protocol",
        "//loom/src/loom/serve/runtime/execution",
        "//loom/src/loom/serve/runtime/host",
        "//loom/src/loom/serve/runtime/host:timer",
        "//loom/src/loom/serve/runtime/host:wake",
        "//loom/src/loom/serve/runtime/parameter:residency",
        "//loom/src/loom/serve/service",
        "//loom/src/loom/serve/service:execution_reconfiguration",
        "//loom/src/loom/serve/telemetry:stream",
        "//loom/src/loom/serve/transport/http:request",
        "//loom/src/loom/serve/transport/http:server",
        "//loom/src/loom/util:json",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/async",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/task",
        "//runtime/src/iree/vm",
    ],
)

loom_cc_library(
    name = "model",
    srcs = ["model.c"],
    hdrs = ["model.h"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/target/arch:vm",
    ]),
    deps = [
        "//loom/binding/c:loomc",
        "//loom/src/loom/serve/runtime/device",
        "//loom/src/loom/serve/runtime/execution",
        "//loom/src/loom/serve/runtime/execution:dispatch",
        "//loom/src/loom/serve/runtime/host",
        "//loom/src/loom/serve/runtime/parameter:residency",
        "//loom/src/loom/serve/runtime/parameter:weights",
        "//loom/src/loom/serve/runtime/program",
        "//loom/src/loom/serve/runtime/program:compilation",
        "//loom/src/loom/serve/runtime/program:input",
        "//loom/src/loom/serve/runtime/program:jit",
        "//loom/src/loom/serve/runtime/program:json",
        "//loom/src/loom/serve/runtime/program:module",
        "//loom/src/loom/serve/runtime/program:parameter_layout",
        "//loom/src/loom/serve/runtime/program:preparation",
        "//loom/src/loom/serve/runtime/program:sources",
        "//loom/src/loom/serve/runtime/program:stage_set",
        "//loom/src/loom/serve/runtime/program:variant_pool",
        "//loom/src/loom/serve/service:execution_reconfiguration",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/module/hal:types",
        "//runtime/src/iree/tokenizer",
        "//runtime/src/iree/tokenizer/format/huggingface:tokenizer_json",
        "//runtime/src/iree/tooling:device_profiling",
        "//runtime/src/iree/vm",
    ],
)
