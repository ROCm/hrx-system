load("//build_tools/bazel:query.bzl", "iree_assert_dependency_boundary")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test", "loom_config_compatible_with")

package(
    default_visibility = ["//loom/src/loom/serve:implementation"],
    features = ["layering_check"],
    licenses = ["notice"],
)

loom_cc_library(
    name = "component_tests",
    testonly = True,
    srcs = ["component_test.cc"],
    deps = [
        ":component",
        ":model",
        ":result",
        "//loom/src/loom/serve/runtime/device",
        "//loom/src/loom/serve/runtime/execution",
        "//loom/src/loom/serve/runtime/host",
        "//loom/src/loom/serve/runtime/parameter:residency",
        "//loom/src/loom/serve/runtime/storage:memory",
        "//loom/src/loom/serve/testing:device",
        "//loom/src/loom/serve/testing:service_application",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/task",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:temp_file",
        "//runtime/src/iree/vm",
    ],
    alwayslink = True,
)

loom_cc_library(
    name = "component",
    srcs = ["component.c"],
    hdrs = ["component.h"],
    deps = [
        ":model",
        "//loom/src/loom/serve/runtime/device",
        "//loom/src/loom/serve/runtime/host:wake",
        "//loom/src/loom/serve/runtime/parameter:residency",
        "//loom/src/loom/serve/runtime/program:compilation",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "protocol",
    hdrs = ["protocol.h"],
    deps = [
        "//loom/src/loom/serve/service:kind",
        "//runtime/src/iree/base",
        "//runtime/src/iree/vm",
    ],
)

loom_cc_library(
    name = "consumer",
    hdrs = ["consumer.h"],
    deps = [
        ":protocol",
        ":result",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "call",
    srcs = ["call.c"],
    hdrs = ["call.h"],
    deps = [
        ":consumer",
        ":protocol",
        ":result",
        "//loom/src/loom/serve/runtime/host:wake",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "http",
    srcs = ["http.c"],
    hdrs = ["http.h"],
    deps = [
        ":consumer",
        ":protocol",
        "//loom/src/loom/serve/transport/http:server",
        "//loom/src/loom/util:json",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/base",
    ],
)

loom_cc_test(
    name = "call_test",
    srcs = ["call_test.cc"],
    deps = [
        ":call",
        ":consumer",
        "//loom/src/loom/serve/runtime/host:wake",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "service",
    srcs = ["service.c"],
    hdrs = ["service.h"],
    deps = [
        ":call",
        ":consumer",
        ":http",
        ":model",
        ":protocol",
        ":result",
        "//loom/src/loom/runtime/telemetry:stream",
        "//loom/src/loom/serve/runtime/execution",
        "//loom/src/loom/serve/runtime/host",
        "//loom/src/loom/serve/runtime/host:timer",
        "//loom/src/loom/serve/runtime/host:wake",
        "//loom/src/loom/serve/runtime/parameter:residency",
        "//loom/src/loom/serve/service",
        "//loom/src/loom/serve/service:execution_reconfiguration",
        "//loom/src/loom/serve/service:kind",
        "//loom/src/loom/serve/transport/http:request",
        "//loom/src/loom/serve/transport/http:server",
        "//loom/src/loom/service/telemetry:latency",
        "//loom/src/loom/service/telemetry:record",
        "//loom/src/loom/service/telemetry:tracing",
        "//runtime/src/iree/async",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/task",
        "//runtime/src/iree/vm",
    ],
)

loom_cc_library(
    name = "registration",
    srcs = ["registration.c"],
    hdrs = ["registration.h"],
    deps = [
        ":model",
        ":protocol",
        ":service",
        "//loom/src/loom/runtime/telemetry:stream",
        "//loom/src/loom/serve/runtime/device",
        "//loom/src/loom/serve/runtime/host",
        "//loom/src/loom/serve/runtime/host:wake",
        "//loom/src/loom/serve/runtime/parameter:activation",
        "//loom/src/loom/serve/runtime/parameter:residency",
        "//loom/src/loom/serve/runtime/program:compilation",
        "//runtime/src/iree/base",
    ],
)

iree_assert_dependency_boundary(
    name = "registration_has_no_catalogue_dependency",
    forbidden_subtrees = [
        "//loom/src/loom/serve/server/...",
        "//loom/src/loom/serve/service/image/...",
        "//loom/src/loom/serve/service/recognition/...",
        "//loom/src/loom/serve/service/speech/...",
        "//loom/src/loom/serve/service/text/...",
    ],
    message = "Finite preparation and retirement must not depend on a server catalogue or sibling service implementation",
    target = ":registration",
)

loom_cc_library(
    name = "result",
    srcs = ["result.c"],
    hdrs = ["result.h"],
    deps = [
        "//loom/src/loom/serve/runtime/execution",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/vm",
    ],
)

loom_cc_library(
    name = "model",
    srcs = ["model.c"],
    hdrs = ["model.h"],
    deps = [
        ":result",
        "//loom/binding/c:loomc",
        "//loom/src/loom/serve/runtime/device",
        "//loom/src/loom/serve/runtime/execution",
        "//loom/src/loom/serve/runtime/execution:dispatch",
        "//loom/src/loom/serve/runtime/host",
        "//loom/src/loom/serve/runtime/parameter:bank",
        "//loom/src/loom/serve/runtime/parameter:module",
        "//loom/src/loom/serve/runtime/parameter:residency",
        "//loom/src/loom/serve/runtime/parameter:sources",
        "//loom/src/loom/serve/runtime/parameter:weights",
        "//loom/src/loom/serve/runtime/program",
        "//loom/src/loom/serve/runtime/program:compilation",
        "//loom/src/loom/serve/runtime/program:input",
        "//loom/src/loom/serve/runtime/program:jit",
        "//loom/src/loom/serve/runtime/program:json",
        "//loom/src/loom/serve/runtime/program:module",
        "//loom/src/loom/serve/runtime/program:preparation",
        "//loom/src/loom/serve/runtime/program:sources",
        "//loom/src/loom/serve/runtime/program:stage_set",
        "//loom/src/loom/serve/runtime/program:stage_table",
        "//loom/src/loom/serve/runtime/program:tokenizer_cache",
        "//loom/src/loom/serve/runtime/program:tokenizer_load",
        "//loom/src/loom/serve/runtime/program:variant_pool",
        "//loom/src/loom/serve/service:executables",
        "//loom/src/loom/serve/service:execution_reconfiguration",
        "//loom/src/loom/serve/service:prepared_request",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/module/hal:types",
        "//runtime/src/iree/tokenizer",
        "//runtime/src/iree/tooling:device_profiling",
        "//runtime/src/iree/vm",
    ],
)

loom_cc_test(
    name = "result_test",
    srcs = ["result_test.cc"],
    target_compatible_with = loom_config_compatible_with([
        "//runtime/config/hal:driver_task",
    ]),
    deps = [
        ":result",
        "//loom/src/loom/serve/runtime/device",
        "//loom/src/loom/serve/runtime/execution",
        "//loom/src/loom/serve/runtime/execution:retirement",
        "//loom/src/loom/serve/runtime/execution:workspace",
        "//loom/src/loom/serve/runtime/host",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
        "//runtime/src/iree/vm",
    ],
)
