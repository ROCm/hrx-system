load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_fuzz",
    "loom_cc_library",
    "loom_cc_test",
)
load("//loom/build_tools/bazel:python.bzl", "loom_py_test")

package(
    default_visibility = ["//loom/src/loom/serve:implementation"],
    features = ["layering_check"],
    licenses = ["notice"],
)

REQUEST_SCHEMA_FUZZ_SEEDS = [
    "//loom/src/loom/serve/service/testdata/request_fuzz:decision.txt",
    "//loom/src/loom/serve/service/testdata/request_fuzz:embedding.txt",
    "//loom/src/loom/serve/service/testdata/request_fuzz:image.txt",
    "//loom/src/loom/serve/service/testdata/request_fuzz:speech.txt",
    "//loom/src/loom/serve/service/testdata/request_fuzz:transcription.txt",
    "//loom/src/loom/serve/service/testdata/request_fuzz:voice_remove.txt",
    "//loom/src/loom/serve/service/testdata/request_fuzz:voice_upload.txt",
]

loom_cc_library(
    name = "endpoint",
    srcs = ["endpoint.c"],
    hdrs = ["endpoint.h"],
    deps = ["//loom/src/loom/service:kind"],
)

loom_cc_test(
    name = "endpoint_test",
    srcs = ["endpoint_test.cc"],
    deps = [
        ":endpoint",
        "//loom/src/loom/service:kind",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_fuzz(
    name = "request_schema_fuzz",
    srcs = ["request_schema_fuzz.cc"],
    args = [
        "-seed_inputs=" + ",".join([
            "$(rootpath %s)" % seed
            for seed in REQUEST_SCHEMA_FUZZ_SEEDS
        ]),
    ],
    data = REQUEST_SCHEMA_FUZZ_SEEDS,
    deps = [
        "//loom/src/loom/serve/service/image:request",
        "//loom/src/loom/serve/service/recognition:transcription",
        "//loom/src/loom/serve/service/speech:request",
        "//loom/src/loom/serve/service/speech:voice",
        "//loom/src/loom/serve/service/speech:voice_http",
        "//loom/src/loom/serve/transport/http:request",
        "//loom/src/loom/service/finite/decision:protocol",
        "//loom/src/loom/service/finite/embedding:protocol",
        "//runtime/src/iree/base",
    ],
)

loom_py_test(
    name = "request_schema_fuzz_test",
    size = "small",
    srcs = ["request_schema_fuzz_test.py"],
    args = ["$(rootpath :request_schema_fuzz)"] + [
        "$(rootpath %s)" % seed
        for seed in REQUEST_SCHEMA_FUZZ_SEEDS
    ],
    data = [":request_schema_fuzz"] + REQUEST_SCHEMA_FUZZ_SEEDS,
    tags = [
        "manual",
        "skip-bazel_to_cmake",
    ],
)

loom_cc_library(
    name = "service",
    hdrs = ["service.h"],
    deps = [
        ":reasoning",
        "//loom/src/loom/runtime:service",
        "//loom/src/loom/runtime:wake",
        "//loom/src/loom/runtime/telemetry:sample",
        "//loom/src/loom/runtime/telemetry:stream",
        "//loom/src/loom/serve/transport/http:server",
        "//loom/src/loom/service:inspection",
        "//loom/src/loom/service:kind",
        "//loom/src/loom/service:reconfiguration",
        "//loom/src/loom/service/telemetry:latency",
        "//loom/src/loom/service/telemetry:record",
        "//runtime/src/iree/base",
        "//runtime/src/iree/tokenizer",
    ],
)

loom_cc_library(
    name = "reasoning",
    srcs = ["reasoning.c"],
    hdrs = ["reasoning.h"],
    deps = ["//runtime/src/iree/base"],
)

loom_cc_test(
    name = "reasoning_test",
    srcs = ["reasoning_test.cc"],
    deps = [
        ":reasoning",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "inspection",
    srcs = ["inspection.c"],
    hdrs = ["inspection.h"],
    deps = [
        "//loom/src/loom/serve/telemetry:record",
        "//loom/src/loom/service:inspection",
        "//loom/src/loom/service/telemetry:record",
        "//loom/src/loom/util:json",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/base",
    ],
)

loom_cc_test(
    name = "inspection_test",
    srcs = ["inspection_test.cc"],
    deps = [
        ":inspection",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
