load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test")

package(
    default_visibility = ["//loom/src/loom/serve:implementation"],
    features = ["layering_check"],
    licenses = ["notice"],
)

exports_files(
    ["service_linux_test.cc"],
    visibility = ["//loom/src/loom/serve:implementation"],
)

loom_cc_library(
    name = "request",
    srcs = ["request.c"],
    hdrs = ["request.h"],
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:json",
        "//runtime/src/iree/base/internal:unicode",
    ],
)

loom_cc_test(
    name = "request_test",
    srcs = ["request_test.cc"],
    deps = [
        ":request",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "output",
    srcs = ["output.c"],
    hdrs = ["output.h"],
    deps = ["//runtime/src/iree/base"],
)

loom_cc_test(
    name = "output_test",
    srcs = ["output_test.cc"],
    deps = [
        ":output",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

