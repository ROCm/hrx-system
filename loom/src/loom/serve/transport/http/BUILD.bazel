load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test")

package(
    default_visibility = ["//loom/src/loom/serve:implementation"],
    features = ["layering_check"],
    licenses = ["notice"],
)

loom_cc_library(
    name = "multipart",
    srcs = ["multipart.c"],
    hdrs = ["multipart.h"],
    deps = ["//runtime/src/iree/base"],
)

loom_cc_test(
    name = "multipart_test",
    srcs = ["multipart_test.cc"],
    deps = [
        ":multipart",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "request",
    srcs = ["request.c"],
    hdrs = ["request.h"],
    deps = [
        ":multipart",
        "//runtime/src/iree/base",
    ],
)

loom_cc_test(
    name = "request_test",
    srcs = ["request_test.cc"],
    deps = [
        ":multipart",
        ":request",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "origin",
    srcs = ["origin.c"],
    hdrs = ["origin.h"],
    deps = [
        ":request",
        "//runtime/src/iree/async",
        "//runtime/src/iree/base",
    ],
)

loom_cc_test(
    name = "origin_test",
    srcs = ["origin_test.cc"],
    deps = [
        ":origin",
        ":request",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "server",
    srcs = ["server.c"],
    hdrs = ["server.h"],
    deps = [
        ":origin",
        ":request",
        "//loom/src/loom/runtime/telemetry:stream",
        "//loom/src/loom/serve/runtime/host:wake",
        "//loom/src/loom/service/telemetry:record",
        "//runtime/src/iree/async",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/net:carrier",
    ],
)

loom_cc_library(
    name = "receive_cache",
    srcs = ["receive_cache.c"],
    hdrs = ["receive_cache.h"],
    deps = [
        "//runtime/src/iree/async",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
    ],
)

loom_cc_test(
    name = "receive_cache_test",
    srcs = ["receive_cache_test.cc"],
    deps = [
        ":receive_cache",
        "//runtime/src/iree/async",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "listener",
    srcs = ["listener.c"],
    hdrs = ["listener.h"],
    deps = [
        ":receive_cache",
        ":server",
        "//runtime/src/iree/async",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/net:carrier",
        "//runtime/src/iree/net/carrier/stream",
    ],
)

loom_cc_test(
    name = "server_test",
    srcs = ["server_test.cc"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":listener",
        ":origin",
        ":request",
        ":server",
        "//loom/src/loom/runtime/telemetry:stream",
        "//loom/src/loom/service/telemetry:record",
        "//runtime/src/iree/async",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
