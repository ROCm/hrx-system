load("//build_tools/embed_data:build_defs.bzl", "iree_c_embed_data")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_config_compatible_with", "loom_generated_source_family")
load("//loom/build_tools/bazel:python.bzl", "loom_py_test")

package(
    default_visibility = ["//loom/src/loom/serve:implementation"],
    features = ["layering_check"],
    licenses = ["notice"],
)

# Entry points have stable URLs for pages, workers, and the audio worklet.
_ENTRIES = [
    "app.js",
    "capture.js",
    "chat.js",
    "mcp-worker.js",
    "topbar.js",
]

_PAGES = [
    "chat.html",
    "code.html",
    "index.html",
    "preview.html",
]

_SCOPED = [
    "chat.css",
    "telemetry.css",
]

_ASSETS = _ENTRIES + _PAGES + [
    "events.js",
    "style.css",
]

_WIRE = [
    "content.js",
    "events.js",
    "wire.js",
]

filegroup(
    name = "wire_sources",
    srcs = _WIRE,
)

loom_generated_source_family(
    name = "bundle",
    args = ["--entry=$(location " + file + ")" for file in _ENTRIES] +
           ["--page=$(location " + file + ")" for file in _PAGES] +
           ["--scoped=$(location " + file + ")" for file in _SCOPED] + [
        "--style=$(location topbar.css)",
    ],
    generator = "//build_tools/serve_web:pack",
    inputs = _ENTRIES + _PAGES + _SCOPED + _WIRE + [
        "audio.js",
        "code.js",
        "dialog.js",
        "export.js",
        "mcp.js",
        "reply-stats.js",
        "settings.js",
        "storage.js",
        "topbar.css",
        "view.js",
    ],
    output_flags = ["--output=" for asset in _ASSETS] + ["--etags="],
    outputs = ["gzip/" + asset for asset in _ASSETS] + ["etags.h"],
)

loom_py_test(
    name = "bundle_test",
    srcs = ["bundle_test.py"],
    args = ["$(location :gzip/" + asset + ")" for asset in _ASSETS],
    data = [":gzip/" + asset for asset in _ASSETS],
    main = "bundle_test.py",
)

iree_c_embed_data(
    name = "files",
    srcs = [":gzip/" + asset for asset in _ASSETS],
    c_file_output = "files.c",
    flatten = True,
    h_file_output = "files.h",
    identifier = "loom_serve_dashboard_files",
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/arch:vm",
        "//loom/config/emit:vm_binary",
    ]),
)

loom_cc_library(
    name = "assets",
    srcs = [
        "assets.c",
        ":etags.h",
    ],
    hdrs = ["assets.h"],
    deps = [
        ":files",
        "//loom/src/loom/serve/server/http:response",
        "//loom/src/loom/serve/transport/http:request",
        "//loom/src/loom/serve/transport/http:server",
        "//runtime/src/iree/base",
        "//runtime/src/iree/net:carrier",
    ],
)
