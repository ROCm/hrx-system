load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_benchmark", "loom_cc_library", "loom_cc_test")

package(
    default_visibility = ["//loom/src/loom/serve:implementation"],
    features = ["layering_check"],
    licenses = ["notice"],
)

loom_cc_library(
    name = "sample",
    srcs = ["sample.c"],
    hdrs = ["sample.h"],
    deps = [
        "//loom/src/loom/runtime/telemetry:sample",
        "//runtime/src/iree/base",
    ],
)

loom_cc_test(
    name = "sample_test",
    srcs = ["sample_test.cc"],
    deps = [
        ":sample",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "record",
    srcs = ["record.c"],
    hdrs = ["record.h"],
    deps = [
        "//loom/src/loom/runtime/telemetry:field",
        "//loom/src/loom/runtime/telemetry:record",
        "//loom/src/loom/service/telemetry:record",
        "//loom/src/loom/util:json",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/base",
    ],
)

loom_cc_test(
    name = "parameter_test",
    srcs = ["parameter_test.cc"],
    deps = [
        ":record",
        "//loom/src/loom/runtime/parameter:telemetry",
        "//loom/src/loom/runtime/telemetry:stream",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_test(
    name = "record_test",
    srcs = ["record_test.cc"],
    deps = [
        ":record",
        "//loom/src/loom/runtime/telemetry:field",
        "//loom/src/loom/runtime/telemetry:stream",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_benchmark(
    name = "stream_benchmark",
    srcs = ["stream_benchmark.cc"],
    deps = [
        ":record",
        "//loom/src/loom/runtime/telemetry:stream",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:benchmark_main",
    ],
)
