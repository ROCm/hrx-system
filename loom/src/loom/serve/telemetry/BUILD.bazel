load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_benchmark", "loom_cc_library", "loom_cc_test")

package(
    default_visibility = ["//loom/src/loom/serve:implementation"],
    features = ["layering_check"],
    licenses = ["notice"],
)

loom_cc_library(
    name = "tracing",
    srcs = ["tracing.c"],
    hdrs = ["tracing.h"],
    deps = ["//runtime/src/iree/base"],
)

loom_cc_library(
    name = "sample",
    srcs = ["sample.c"],
    hdrs = ["sample.h"],
    deps = [
        "//loom/src/loom/runtime/telemetry:sample",
        "//runtime/src/iree/base",
    ],
)

loom_cc_test(
    name = "sample_test",
    srcs = ["sample_test.cc"],
    deps = [
        ":sample",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_test(
    name = "tracing_test",
    srcs = ["tracing_test.cc"],
    target_compatible_with = select({
        "//runtime/config/base/tracing:provider_console": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":tracing",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "record",
    srcs = ["record.c"],
    hdrs = ["record.h"],
    deps = [
        "//loom/src/loom/util:json",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "weights",
    srcs = ["weights.c"],
    hdrs = ["weights.h"],
    deps = [
        ":record",
        ":stream",
        "//loom/src/loom/serve/runtime/parameter:weights",
        "//runtime/src/iree/base",
    ],
)

loom_cc_test(
    name = "weights_test",
    srcs = ["weights_test.cc"],
    deps = [
        ":record",
        ":stream",
        ":weights",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "latency",
    srcs = ["latency.c"],
    hdrs = ["latency.h"],
    deps = [
        ":record",
        ":stream",
        "//runtime/src/iree/base",
    ],
)

loom_cc_test(
    name = "latency_test",
    srcs = ["latency_test.cc"],
    deps = [
        ":latency",
        ":record",
        ":stream",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "stream",
    srcs = ["stream.c"],
    hdrs = ["stream.h"],
    deps = [
        ":record",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal",
    ],
)

loom_cc_test(
    name = "record_test",
    srcs = ["record_test.cc"],
    deps = [
        ":record",
        ":stream",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_test(
    name = "stream_test",
    srcs = ["stream_test.cc"],
    deps = [
        ":stream",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_benchmark(
    name = "stream_benchmark",
    srcs = ["stream_benchmark.cc"],
    deps = [
        ":record",
        ":stream",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:benchmark_main",
    ],
)
