load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_binary", "loom_cc_library", "loom_cc_test")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

loom_cc_library(
    name = "server_test_tool",
    testonly = True,
    srcs = ["server_test_tool.c"],
    visibility = ["//loom/src/loom/serve:implementation"],
    deps = [
        "//loom/src/loom/runtime/testing:compiler",
        "//loom/src/loom/runtime/testing:device",
        "//loom/src/loom/tools/loom-serve:main",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base:core_headers",
    ],
)

loom_cc_library(
    name = "http_harness",
    testonly = True,
    srcs = ["http_harness_linux.cc"],
    hdrs = ["http_harness.h"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//loom/src/loom/serve:implementation"],
    deps = [
        "//loom/src/loom/runtime/telemetry:stream",
        "//loom/src/loom/serve/transport/http:listener",
        "//loom/src/loom/serve/transport/http:server",
        "//loom/src/loom/service/telemetry:record",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "model_wait",
    testonly = True,
    hdrs = ["model_wait.h"],
    visibility = ["//loom/src/loom/serve:implementation"],
    deps = [
        ":http_harness",
        "//runtime/src/iree/testing:gtest",
    ],
)

loom_cc_library(
    name = "stalled_http_client",
    testonly = True,
    hdrs = ["stalled_http_client.h"],
    visibility = ["//loom/src/loom/serve:implementation"],
    deps = [
        "//loom/src/loom/serve/transport/http:server",
        "//runtime/src/iree/async",
        "//runtime/src/iree/async:platform",
        "//runtime/src/iree/base",
        "//runtime/src/iree/net:carrier",
        "//runtime/src/iree/net/carrier/loopback",
        "//runtime/src/iree/testing:gtest",
    ],
)

loom_cc_test(
    name = "http_harness_test",
    srcs = ["http_harness_test.cc"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":http_harness",
        "//loom/src/loom/serve/transport/http:listener",
        "//loom/src/loom/serve/transport/http:server",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "model",
    testonly = True,
    hdrs = ["model.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//loom/src/loom/serve/server:configuration",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:json",
        "//runtime/src/iree/io:file_handle",
    ],
)

loom_cc_library(
    name = "package",
    testonly = True,
    srcs = ["package.cc"],
    hdrs = ["package.h"],
    visibility = ["//loom/src/loom/serve:implementation"],
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/io:file_handle",
    ],
)

loom_cc_library(
    name = "text_policy",
    testonly = True,
    srcs = ["text_policy.c"],
    hdrs = ["text_policy.h"],
    visibility = ["//loom/src/loom/serve:implementation"],
    deps = [
        "//loom/binding/c:loomc",
        "//loom/binding/c/target/vm",
        "//loom/src/loom/model:card",
        "//loom/src/loom/runtime/program",
        "//loom/src/loom/runtime/program:compilation",
        "//loom/src/loom/runtime/program:input",
        "//loom/src/loom/runtime/program:json",
        "//loom/src/loom/runtime/program:sources",
        "//loom/src/loom/serve/service/text:chat",
        "//loom/src/loom/serve/service/text:tool_xml",
        "//runtime/src/iree/base",
        "//runtime/src/iree/io:file_handle",
        "//runtime/src/iree/tokenizer",
        "//runtime/src/iree/tokenizer/format/huggingface:tokenizer_json",
        "//runtime/src/iree/vm",
    ],
)

loom_cc_binary(
    name = "text_request_check",
    testonly = True,
    srcs = ["text_request.c"],
    visibility = ["//visibility:public"],
    deps = [
        ":text_policy",
        "//loom/src/loom/runtime/program:compilation",
        "//loom/src/loom/serve/service/text:chat",
        "//loom/src/loom/util:json",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/base/tooling:flags",
        "//runtime/src/iree/io:file_handle",
        "//runtime/src/iree/vm",
    ],
)
