package(default_visibility = ["//visibility:private"])

exports_files(
    [
        "control.loom",
        "model.json",
        "prepare.loom",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "sources",
    testonly = True,
    srcs = [
        "config.loom",
        "control.loom",
        "embed.loom",
        "model.json",
        "prepare.loom",
        "tokenizer.json",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "variant_sources",
    testonly = True,
    srcs = [
        "variants/direct.loom",
        "variants/policy.loom",
        "variants/weights.loom",
    ],
    visibility = ["//visibility:public"],
)
