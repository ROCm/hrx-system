global.rodata.def @prepare_factor = bytes("707265706172655f666163746f72")

func.def public @prepare_weight(%key: buffer) -> (buffer, i64) {
  %root = global.load @prepare_factor : buffer
  // The fixture owns a 2 MiB bank so one-bank pressure is independent of
  // sparse-state reclamation units. Only its first factor affects the output.
  %bytes = scalar.constant 2097152 : i64
  func.return %root, %bytes : buffer, i64
}
