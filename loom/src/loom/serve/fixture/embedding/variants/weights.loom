config.decl @fixture.units : %value: index where [range(%value, 1, 256)]

target.decl @weighted_target

kernel.decl @pool() launch(%input: buffer, %hidden: buffer)

kernel.decl @project() launch(%input: buffer, %hidden: buffer, %output: buffer)

// Converts the checkpoint scalar directly in final storage on activation.
kernel.def target(@weighted_target) @double_factor() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%storage: buffer) {
  %origin = index.constant 0 : offset
  %factor = buffer.view %storage[%origin] : buffer -> view<1xf32>
  %value = view.load %factor[0] : view<1xf32> -> f32
  %c2 = scalar.constant 2.0 : f32
  %prepared = scalar.mulf %value, %c2 : f32
  view.store %prepared, %factor[0] : f32, view<1xf32>
  kernel.return
}

command.program.def public @prepare_factor() launch(%storage: buffer) {
  kernel.launch @double_factor(%storage) : (buffer)
  command.return
}

// A replacement package can add immutable parameters without changing the
// native finite-vector ABI. This head scales all live vectors on device.
kernel.def target(@weighted_target) @scale() {
  %units = config.get @fixture.units : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%units, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%input: buffer, %output: buffer, %scale: view<1xf32>) {
  %origin = index.constant 0 : offset
  %row = kernel.workgroup.id<x> : index
  %units = config.get @fixture.units : index
  %header = buffer.view %input[%origin] : buffer -> view<4xi32>
  %count32 = view.load %header[0] : view<4xi32> -> i32
  %count = index.cast %count32 : i32 to index
  %live = index.cmp ult, %row, %count : index
  scf.if %live {
    %c16 = index.constant 16 : offset
    %metadata = buffer.view %input[%c16] : buffer -> view<[%units]x4xi32>
    %width32 = view.load %metadata[%row, 2] : view<[%units]x4xi32> -> i32
    %offset32 = view.load %metadata[%row, 3] : view<[%units]x4xi32> -> i32
    %bounded_width = scalar.assume %width32 [range(%width32, 2, 4)] : i32
    %width = index.cast %bounded_width : i32 to index
    %bounded_offset = scalar.assume %offset32 [range(%offset32, 0, 1023)] : i32
    %offset = index.cast %bounded_offset : i32 to index
    %c4 = index.constant 4 : index
    %capacity = index.mul %units, %c4 : index
    %result = buffer.view %output[%origin] : buffer -> view<[%capacity]xf32>
    %factor = view.load %scale[0] : view<1xf32> -> f32
    %c0 = index.constant 0 : index
    %c1 = index.constant 1 : index
    scf.for %i = [%c0 to %width step %c1] {
      %maximum = index.sub %capacity, %c1 : index
      %position_value = index.add %offset, %i : index
      %position = index.assume %position_value [range(%position_value, 0, %maximum)] : index
      %value = view.load %result[%position] : view<[%capacity]xf32> -> f32
      %scaled = scalar.mulf %value, %factor : f32
      view.store %scaled, %result[%position] : f32, view<[%capacity]xf32>
    }
  }
  kernel.return
}

command.program.def public @weighted_embed() launch(%weights: buffer, %input: buffer, %output: buffer) {
  %factor = command.parameter %weights, "factor" : view<1xf32>
  %units = config.get @fixture.units : index
  %c16 = index.constant 16 : offset
  %length = index.scale %units, %c16 : index, offset -> offset
  %hidden = buffer.alloca<global> align(16) %length : buffer
  kernel.launch @pool(%input, %hidden) : (buffer, buffer)
  kernel.launch @project(%input, %hidden, %output) : (buffer, buffer, buffer)
  kernel.launch @scale(%input, %output, %factor) : (buffer, buffer, view<1xf32>)
  command.return
}
