type.decl import("finite", "batch") @FiniteBatch

// Text-owned projector ABI. Providers and scoped parameters share the parent card.
func.decl import("prepare") @stage(%root: buffer, %tag: i64) -> (i32)

func.decl import("prepare") @source_scope(%scope: buffer) -> (i32)

func.decl import("prepare") @parameter(%stage: i32, %binding: i32, %input: i32, %source: i32, %policy: buffer)

func.decl import("prepare") @memory_forecast(%root: buffer)

// The pixel protocol is unchanged; a real checkpoint conditions every row.
func.def public @text_image_prepare_v1(%directory: buffer, %options: buffer) -> (i64, i64, i64, i64, buffer, buffer, buffer) {
  %forecast = buffer.constant utf8("forecast_memory") : buffer
  func.call @memory_forecast(%forecast) : (buffer)
  %c0_source = scalar.constant 0 : i32
  %binding = scalar.constant 0 : i32
  %tag = scalar.constant 1 : i64
  %root = buffer.constant utf8("weighted_project") : buffer
  %stage = func.call @stage(%root, %tag) : (buffer, i64) -> (i32)
  %scope = buffer.constant utf8("vision") : buffer
  %policy = buffer.constant utf8("weights.loom") : buffer
  %checkpoint = func.call @source_scope(%scope) : (buffer) -> (i32)
  func.call @parameter(%stage, %binding, %c0_source, %checkpoint, %policy) : (i32, i32, i32, i32, buffer)
  %units = scalar.constant 64 : i64
  %input_capacity = scalar.constant 65536 : i64
  %output_capacity = scalar.constant 1024 : i64
  %empty = buffer.constant utf8("") : buffer
  %name = buffer.constant utf8("weighted-projector") : buffer
  func.return %units, %input_capacity, %output_capacity, %output_capacity, %empty, %name, %root : i64, i64, i64, i64, buffer, buffer, buffer
}

func.decl @prepare_request(%state: buffer, %request: buffer) -> (buffer, i64, i64)

func.def public @text_image_prepare_request_v1(%state: buffer, %request: buffer) -> (buffer, i64, i64) {
  %prepared, %units, %tag = func.call @prepare_request(%state, %request) : (buffer, buffer) -> (buffer, i64, i64)
  func.return %prepared, %units, %tag : buffer, i64, i64
}

func.decl @prepare_batch(%state: buffer, %tags: buffer, %batch: ptr<@FiniteBatch>) -> (i32, buffer, buffer)

func.def public @text_image_prepare_batch_v1(%state: buffer, %tags: buffer, %batch: ptr<@FiniteBatch>) -> (i32, buffer, buffer) {
  %stage, %input, %plan = func.call @prepare_batch(%state, %tags, %batch) : (buffer, buffer, ptr<@FiniteBatch>) -> (i32, buffer, buffer)
  func.return %stage, %input, %plan : i32, buffer, buffer
}

func.decl @run(%state: buffer, %stage: i32, %input: hal.buffer, %output: hal.buffer, %batch: ptr<@FiniteBatch>)

func.def public @text_image_run_v1(%state: buffer, %stage: i32, %input: hal.buffer, %output: hal.buffer, %batch: ptr<@FiniteBatch>) {
  func.call @run(%state, %stage, %input, %output, %batch) : (buffer, i32, hal.buffer, hal.buffer, ptr<@FiniteBatch>)
  func.return
}

func.decl @collect_batch(%state: buffer, %batch: ptr<@FiniteBatch>)

func.def public @text_image_collect_batch_v1(%state: buffer, %batch: ptr<@FiniteBatch>) {
  func.call @collect_batch(%state, %batch) : (buffer, ptr<@FiniteBatch>)
  func.return
}
