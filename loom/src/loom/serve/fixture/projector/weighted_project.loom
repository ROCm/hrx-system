target.decl @fixture_target

config.decl @fixture.projector_rows : %value: index where [range(%value, 1, 64)]

kernel.decl @project() launch(%input: buffer, %output: buffer)

kernel.def target(@fixture_target) @project_bias() {
  %rows = config.get @fixture.projector_rows : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%rows, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%bias: view<1xi32>, %input: buffer, %output: buffer) {
  %row = kernel.workgroup.id<x> : index
  %origin = index.constant 0 : offset
  %header = buffer.view %input[%origin] : buffer -> view<4xi32>
  %rows32 = view.load %header[0] : view<4xi32> -> i32
  %bounded_rows = scalar.assume %rows32 [range(%rows32, 1, 64)] : i32
  %rows = index.cast %bounded_rows : i32 to index
  %live = index.cmp ult, %row, %rows : index
  scf.if %live {
    %bias32 = view.load %bias[0] : view<1xi32> -> i32
    %bias_float = scalar.uitofp %bias32 : i32 to f32
    %result = buffer.view %output[%origin] : buffer -> view<[%rows]x4xf32>
    %pixel = view.load %result[%row, 0] : view<[%rows]x4xf32> -> f32
    %weighted = scalar.addf %pixel, %bias_float : f32
    view.store %weighted, %result[%row, 0] : f32, view<[%rows]x4xf32>
  }
  kernel.return
}

command.def public @weighted_project() launch(%weights: buffer, %input: buffer, %output: buffer) {
  %bias = command.parameter %weights, "bias" : view<1xi32>
  kernel.launch @project(%input, %output) : (buffer, buffer)
  kernel.launch @project_bias(%bias, %input, %output) : (view<1xi32>, buffer, buffer)
  command.return
}
