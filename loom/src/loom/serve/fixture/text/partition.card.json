{
  "$schema": "../../../../../py/loom/model/model-card.v1.schema.json",
  "schema_version": 1,
  "model": {
    "id": "loom-fixture/partitioned-text",
    "name": "Partitioned weighted text fixture"
  },
  "programs": {
    "source": {
      "inputs": [
        {
          "path": "prepare.loom",
          "data": [
            "weights.loom"
          ]
        },
        "control.loom",
        "service.loom"
      ],
      "libraries": [
        "advance.loom"
      ],
      "config": {
        "fixture.bias_delta": 7
      }
    }
  },
  "services": {
    "chat": {
      "kind": "text",
      "version": 1
    }
  },
  "variants": {
    "fixture": {
      "partitions": {
        "node-0": {
          "description": "Independent text service closure for node-0",
          "services": {
            "chat": {
              "programs": [
                "source"
              ],
              "config": {
                "fixture.card": true,
                "fixture.bias_delta": 1
              },
              "parameters": {
                "model": {
                  "files": [
                    "metadata.safetensors",
                    {
                      "path": "bias.data",
                      "format": "safetensors",
                      "origin": "bias.data"
                    }
                  ]
                }
              },
              "tokenizers": {
                "text": "tokenizer.json"
              }
            }
          }
        },
        "other side": {
          "description": "Independent text service closure for other side",
          "services": {
            "chat": {
              "programs": [
                "source"
              ],
              "config": {
                "fixture.card": true,
                "fixture.bias_delta": 1
              },
              "parameters": {
                "model": {
                  "files": [
                    "metadata.safetensors",
                    {
                      "path": "bias.data",
                      "format": "safetensors",
                      "origin": "alternate.data"
                    }
                  ]
                }
              },
              "tokenizers": {
                "text": "tokenizer.json"
              }
            }
          }
        }
      }
    }
  },
  "presets": {
    "check": {
      "service": "chat",
      "variant": "fixture",
      "programs": "source",
      "execution": {
        "rows": 4,
        "context_capacity": 96,
        "pool_capacity": 256,
        "prefill_capacity": 32,
        "max_tokens": 16
      },
      "partition": "node-0"
    }
  }
}
