config.decl @fixture.context : %value: index where [range(%value, 1, 2147483647)]

config.decl @fixture.spans : %value: index where [range(%value, 1, 2147483647)]

config.decl @fixture.media : %value: index where [range(%value, 0, 1)]

config.def @fixture.bias_delta = 0 : i32

target.decl @target

// Logical positions resolve through the native row-major page map. The opaque
// row record supplies the byte origin of this model's pooled history plane.
// Admission bounds positions by context and pages by blocks; these facts also
// hold when the helper remains a callable function instead of being inlined.
func.def @history_offset(%origins: buffer, %row: index, %position: index, %blocks: index) -> (offset) {
  %c0 = index.constant 0 : offset
  %c4 = index.constant 4 : index
  %word = index.constant 4 : offset
  %record_stride = index.constant 40 : offset
  %bounded_row = index.assume %row [range(%row, 0, 2147483646)] : index
  %record_offset = index.scale %bounded_row, %record_stride : index, offset -> offset
  %bounded_position = index.assume %position [range(%position, 0, 2147483646)] : index
  %records = buffer.view %origins[%record_offset] : buffer -> view<5xi64>
  %base64 = view.load %records[2] : view<5xi64> -> i64
  %map64 = view.load %records[4] : view<5xi64> -> i64
  %map_bound = scalar.assume %map64 [range(%map64, 0, 9223372036854775807)] : i64
  %map_origin = index.cast %map_bound : i64 to offset
  %base_positive = scalar.assume %base64 [range(%base64, 0, 9223372036854775807)] : i64
  %base = index.cast %base_positive : i64 to offset
  %page_value = index.div %bounded_position, %c4 : index
  %c1 = index.constant 1 : index
  %last = index.sub %blocks, %c1 : index
  %page = index.assume %page_value [range(%page_value, 0, %last), lt(%page_value, %blocks)] : index
  %map = buffer.view %origins[%map_origin] : buffer -> view<[%blocks]xi32>
  %physical32 = view.load %map[%page] : view<[%blocks]xi32> -> i32
  %physical64 = scalar.extui %physical32 : i32 to i64
  %bounded_physical = scalar.assume %physical64 [range(%physical64, 0, 4294967294)] : i64
  %block_bytes = scalar.constant 16 : i64
  %block_offset64 = scalar.muli %bounded_physical, %block_bytes : i64
  %block_offset = index.cast %block_offset64 : i64 to offset
  %within_page = index.rem %bounded_position, %c4 : index
  %within_bytes = index.scale %within_page, %word : index, offset -> offset
  %bytes = index.add %block_offset, %within_bytes : offset
  %address = index.add %base, %bytes : offset
  func.return %address : offset
}

// One scalar worker per live span is intentional: this is an ownership/ABI
// witness, not a transformer performance proxy. Chunking cannot affect math.
kernel.def target(@target) @consume() {
  %spans = config.get @fixture.spans : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%spans, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%bias: view<1xi32>, %residual: buffer, %metadata: buffer, %origins: buffer, %arena: buffer, %tokens: buffer) {
  %spans = config.get @fixture.spans : index
  %span = kernel.workgroup.id<x> : index
  %origin = index.constant 0 : offset
  %c16 = index.constant 16 : offset
  %header = buffer.view %metadata[%origin] : buffer -> view<4xi32>
  %count32 = view.load %header[0] : view<4xi32> -> i32
  %count = index.cast %count32 : i32 to index
  %live = index.cmp ult, %span, %count : index
  scf.if %live {
    %packets = buffer.view %metadata[%c16] : buffer -> view<[%spans]x9xi32>
    %length32 = view.load %packets[%span, 0] : view<[%spans]x9xi32> -> i32
    %position32 = view.load %packets[%span, 1] : view<[%spans]x9xi32> -> i32
    %source32 = view.load %packets[%span, 2] : view<[%spans]x9xi32> -> i32
    %row32 = view.load %packets[%span, 3] : view<[%spans]x9xi32> -> i32
    %input32 = view.load %packets[%span, 4] : view<[%spans]x9xi32> -> i32
    %length_bound = scalar.assume %length32 [range(%length32, 1, 2147483647)] : i32
    %position_bound = scalar.assume %position32 [range(%position32, 0, 2147483646)] : i32
    %row_bound = scalar.assume %row32 [range(%row32, 0, 2147483646)] : i32
    %row_value = index.cast %row_bound : i32 to index
    %input64 = scalar.extui %input32 : i32 to i64
    %input_bound = scalar.assume %input64 [range(%input64, 0, 4294967293)] : i64
    %length = index.cast %length_bound : i32 to index
    %position = index.cast %position_bound : i32 to index
    %row = index.assume %row_value [range(%row_value, 0, 2147483646)] : index
    %record_stride = index.constant 40 : offset
    %record_offset = index.scale %row, %record_stride : index, offset -> offset
    %records = buffer.view %origins[%record_offset] : buffer -> view<5xi64>
    %read64 = view.load %records[0] : view<5xi64> -> i64
    %write64 = view.load %records[1] : view<5xi64> -> i64
    %fork64 = view.load %records[3] : view<5xi64> -> i64
    %position64 = scalar.extui %position32 : i32 to i64
    %fork = scalar.cmpi eq, %position64, %fork64 : i64
    %reader64 = scf.select %fork, %read64, %write64 : i64
    %reader_bound = scalar.assume %reader64 [range(%reader64, 0, 9223372036854775807)] : i64
    %writer_bound = scalar.assume %write64 [range(%write64, 0, 9223372036854775807)] : i64
    %reader = index.cast %reader_bound : i64 to offset
    %writer = index.cast %writer_bound : i64 to offset
    %read_state = buffer.view %arena[%reader] : buffer -> view<1xi32>
    %write_state = buffer.view %arena[%writer] : buffer -> view<1xi32>
    %context = config.get @fixture.context : index
    %c0 = index.constant 0 : index
    %c1 = index.constant 1 : index
    %c4 = index.constant 4 : index
    %last_position = index.sub %context, %c1 : index
    %last_block = index.div %last_position, %c4 : index
    %blocks = index.add %last_block, %c1 : index
    %c0_i32 = scalar.constant 0 : i32
    %fresh = index.cmp eq, %position, %c0 : index
    %initial_h, %initial_k = scf.if %fresh -> (i32, i32) {
      scf.yield %c0_i32, %c0_i32 : i32, i32
    } else {
      %h = view.load %read_state[0] : view<1xi32> -> i32
      %previous = index.sub %position, %c1 : index
      %offset = func.call @history_offset(%origins, %row, %previous, %blocks) : (buffer, index, index, index) -> (offset)
      %last = buffer.view %arena[%offset] : buffer -> view<1xi32>
      %k = view.load %last[0] : view<1xi32> -> i32
      scf.yield %h, %k : i32, i32
    }
    %checkpoint_bias = view.load %bias[0] : view<1xi32> -> i32
    %bias_delta = config.get @fixture.bias_delta : i32
    %bias_value = scalar.addi %checkpoint_bias, %bias_delta : i32
    %media_mode = config.get @fixture.media : index
    %is_media = index.cmp ne, %media_mode, %c0 : index
    %token_bytes64 = scalar.constant 4 : i64
    %record_bytes64 = scalar.constant 32 : i64
    %stride64 = scf.select %is_media, %record_bytes64, %token_bytes64 : i64
    %input_bytes64 = scalar.muli %input_bound, %stride64 : i64
    %input_origin = index.cast %input_bytes64 : i64 to offset
    %stride = index.cast %stride64 : i64 to offset
    %c5_i32 = scalar.constant 5 : i32
    %c7_i32 = scalar.constant 7 : i32
    %c1_i32 = scalar.constant 1 : i32
    %c2_i32 = scalar.constant 2 : i32
    %c97 = scalar.constant 97 : i32
    %c101 = scalar.constant 101 : i32
    %final_h, %final_k = scf.for %i = [%c0 to %length step %c1](%h = %initial_h : i32, %k = %initial_k : i32) -> (i32, i32) {
      %input_relative = index.scale %i, %stride : index, offset -> offset
      %input_offset = index.add %input_origin, %input_relative : offset
      %token = scf.if %is_media -> (i32) {
        %records = buffer.view %tokens[%input_offset] : buffer -> view<8xi32>
        %stored = view.load %records[0] : view<8xi32> -> i32
        %feature_length = view.load %records[2] : view<8xi32> -> i32
        %has_feature = scalar.cmpi ne, %feature_length, %c0_i32 : i32
        %value = scf.if %has_feature -> (i32) {
          %feature_offset32 = view.load %records[1] : view<8xi32> -> i32
          %feature_offset64 = scalar.extui %feature_offset32 : i32 to i64
          %bounded_feature_offset = scalar.assume %feature_offset64 [range(%feature_offset64, 0, 4294967295)] : i64
          %feature_offset = index.cast %bounded_feature_offset : i64 to offset
          // The integer recurrence fingerprints the F32 payload bits. It is
          // an ownership/transport oracle, not a floating-point model.
          %feature = buffer.view %tokens[%feature_offset] : buffer -> view<1xi32>
          %projected = view.load %feature[0] : view<1xi32> -> i32
          %feature_index = view.load %records[3] : view<8xi32> -> i32
          %positioned = scalar.addi %projected, %feature_index : i32
          scf.yield %positioned : i32
        } else {
          scf.yield %stored : i32
        }
        scf.yield %value : i32
      } else {
        %ids = buffer.view %tokens[%input_offset] : buffer -> view<1xi32>
        %stored = view.load %ids[0] : view<1xi32> -> i32
        scf.yield %stored : i32
      }
      %scaled_h = scalar.muli %h, %c5_i32 : i32
      %with_token = scalar.addi %scaled_h, %token : i32
      %with_bias = scalar.addi %with_token, %bias_value : i32
      %next_h = scalar.remui %with_bias, %c97 : i32
      %absolute = index.add %position, %i : index
      %ordinal32 = index.cast %i : index to i32
      %source_delta32 = scalar.muli %ordinal32, %c2_i32 : i32
      %absolute_source32 = scalar.addi %source32, %source_delta32 : i32
      %absolute_position32 = scalar.shrui %absolute_source32, %c1_i32 : i32
      %scaled_k = scalar.muli %k, %c7_i32 : i32
      %with_h = scalar.addi %scaled_k, %next_h : i32
      %with_position = scalar.addi %with_h, %absolute_position32 : i32
      %next_k = scalar.remui %with_position, %c101 : i32
      %offset = func.call @history_offset(%origins, %row, %absolute, %blocks) : (buffer, index, index, index) -> (offset)
      %cache = buffer.view %arena[%offset] : buffer -> view<1xi32>
      view.store %next_k, %cache[0] : i32, view<1xi32>
      scf.yield %next_h, %next_k : i32, i32
    }
    view.store %final_h, %write_state[0] : i32, view<1xi32>
    %hidden = buffer.view %residual[%origin] : buffer -> view<[%spans]xi32>
    view.store %final_h, %hidden[%span] : i32, view<[%spans]xi32>
  }
  kernel.return
}

kernel.def target(@target) @select() {
  %spans = config.get @fixture.spans : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%spans, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%residual: buffer, %metadata: buffer, %origins: buffer, %arena: buffer, %outputs: buffer) {
  %spans = config.get @fixture.spans : index
  %span = kernel.workgroup.id<x> : index
  %origin = index.constant 0 : offset
  %c16 = index.constant 16 : offset
  %header = buffer.view %metadata[%origin] : buffer -> view<4xi32>
  %count32 = view.load %header[0] : view<4xi32> -> i32
  %count = index.cast %count32 : i32 to index
  %live = index.cmp ult, %span, %count : index
  scf.if %live {
    %packets = buffer.view %metadata[%c16] : buffer -> view<[%spans]x9xi32>
    %flags = view.load %packets[%span, 6] : view<[%spans]x9xi32> -> i32
    %c0_i32 = scalar.constant 0 : i32
    %c1_i32 = scalar.constant 1 : i32
    %bits = scalar.andi %flags, %c1_i32 : i32
    %selected = scalar.cmpi ne, %bits, %c0_i32 : i32
    scf.if %selected {
      %length32 = view.load %packets[%span, 0] : view<[%spans]x9xi32> -> i32
      %position32 = view.load %packets[%span, 1] : view<[%spans]x9xi32> -> i32
      %source32 = view.load %packets[%span, 2] : view<[%spans]x9xi32> -> i32
      %row32 = view.load %packets[%span, 3] : view<[%spans]x9xi32> -> i32
      %end32 = scalar.addi %position32, %length32 : i32
      %c2_i32 = scalar.constant 2 : i32
      %source_length32 = scalar.muli %length32, %c2_i32 : i32
      %source_end32 = scalar.addi %source32, %source_length32 : i32
      %end_bound = scalar.assume %end32 [range(%end32, 1, 2147483647)] : i32
      %row_bound = scalar.assume %row32 [range(%row32, 0, 2147483646)] : i32
      %row_value = index.cast %row_bound : i32 to index
      %end = index.cast %end_bound : i32 to index
      %row = index.assume %row_value [range(%row_value, 0, 2147483646)] : index
      %c0 = index.constant 0 : index
      %c1 = index.constant 1 : index
      %c4 = index.constant 4 : index
      %context = config.get @fixture.context : index
      %last_position = index.sub %context, %c1 : index
      %last_block = index.div %last_position, %c4 : index
      %blocks = index.add %last_block, %c1 : index
      %sum = scf.for %position = [%c0 to %end step %c1](%previous = %c0_i32 : i32) -> (i32) {
        %offset = func.call @history_offset(%origins, %row, %position, %blocks) : (buffer, index, index, index) -> (offset)
        %cache = buffer.view %arena[%offset] : buffer -> view<1xi32>
        %value = view.load %cache[0] : view<1xi32> -> i32
        %next = scalar.addi %previous, %value : i32
        scf.yield %next : i32
      }
      %hidden = buffer.view %residual[%origin] : buffer -> view<[%spans]xi32>
      %h = view.load %hidden[%span] : view<[%spans]xi32> -> i32
      %total = scalar.addi %h, %sum : i32
      %c3_i32 = scalar.constant 3 : i32
      %c11_i32 = scalar.constant 11 : i32
      %token = scalar.remui %total, %c3_i32 : i32
      %source_phase = scalar.shrui %source_end32, %c1_i32 : i32
      %phase = scalar.remui %source_phase, %c11_i32 : i32
      %terminal = scalar.cmpi eq, %phase, %c0_i32 : i32
      %eos = view.load %header[1] : view<4xi32> -> i32
      %prediction = scf.select %terminal, %eos, %token : i32
      %result = buffer.view %outputs[%origin] : buffer -> view<[%spans]xi32>
      view.store %prediction, %result[%span] : i32, view<[%spans]xi32>
    }
  }
  kernel.return
}

command.def public @advance() launch(%weights: buffer, %residual: buffer, %metadata: buffer, %origins: buffer, %arena: buffer, %tokens: buffer, %outputs: buffer) {
  %bias = command.parameter %weights, "bias" : view<1xi32>
  kernel.launch @consume(%bias, %residual, %metadata, %origins, %arena, %tokens) : (view<1xi32>, buffer, buffer, buffer, buffer, buffer)
  kernel.launch @select(%residual, %metadata, %origins, %arena, %outputs) : (buffer, buffer, buffer, buffer, buffer)
  command.return
}

command.def public @advance_media() launch(%weights: buffer, %residual: buffer, %metadata: buffer, %origins: buffer, %arena: buffer, %tokens: buffer, %outputs: buffer) {
  %bias = command.parameter %weights, "bias" : view<1xi32>
  kernel.launch @consume(%bias, %residual, %metadata, %origins, %arena, %tokens) : (view<1xi32>, buffer, buffer, buffer, buffer, buffer)
  kernel.launch @select(%residual, %metadata, %origins, %arena, %outputs) : (buffer, buffer, buffer, buffer, buffer)
  command.return
}

command.def public @group_prefix() launch(%weights: buffer, %residual: buffer, %metadata: buffer, %origins: buffer, %arena: buffer, %tokens: buffer, %outputs: buffer) {
  %bias = command.parameter %weights, "bias" : view<1xi32>
  kernel.launch @consume(%bias, %residual, %metadata, %origins, %arena, %tokens) : (view<1xi32>, buffer, buffer, buffer, buffer, buffer)
  command.return
}

kernel.def target(@target) @copy_group_hidden() {
  %spans = config.get @fixture.spans : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%spans, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%source: buffer, %target: buffer, %metadata: buffer) {
  %spans = config.get @fixture.spans : index
  %span = kernel.workgroup.id<x> : index
  %origin = index.constant 0 : offset
  %header = buffer.view %metadata[%origin] : buffer -> view<4xi32>
  %count32 = view.load %header[0] : view<4xi32> -> i32
  %count = index.cast %count32 : i32 to index
  %live = index.cmp ult, %span, %count : index
  scf.if %live {
    %input = buffer.view %source[%origin] : buffer -> view<[%spans]xi32>
    %output = buffer.view %target[%origin] : buffer -> view<[%spans]xi32>
    %value = view.load %input[%span] : view<[%spans]xi32> -> i32
    view.store %value, %output[%span] : i32, view<[%spans]xi32>
  }
  kernel.return
}

command.def public @group_residual() launch(%residual: buffer, %metadata: buffer, %origins: buffer, %arena: buffer, %tokens: buffer, %outputs: buffer) {
  %spans = config.get @fixture.spans : index
  %word = index.constant 4 : offset
  %bytes = index.scale %spans, %word : index, offset -> offset
  %temporary = buffer.alloca<global> align(16) %bytes : buffer
  kernel.launch @copy_group_hidden(%residual, %temporary, %metadata) : (buffer, buffer, buffer)
  kernel.launch @select(%temporary, %metadata, %origins, %arena, %outputs) : (buffer, buffer, buffer, buffer, buffer)
  command.return
}

// Draft-cache witness: each known input writes one word per position from the
// bank's own hidden word and token packet. Rows own dense context-long planes.
kernel.def target(@target) @warm_draft() {
  %spans = config.get @fixture.spans : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%spans, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%residual: buffer, %metadata: buffer, %tokens: buffer, %cache: buffer) {
  %spans = config.get @fixture.spans : index
  %span = kernel.workgroup.id<x> : index
  %origin = index.constant 0 : offset
  %c16 = index.constant 16 : offset
  %word = index.constant 4 : offset
  %header = buffer.view %metadata[%origin] : buffer -> view<4xi32>
  %count32 = view.load %header[0] : view<4xi32> -> i32
  %count = index.cast %count32 : i32 to index
  %live = index.cmp ult, %span, %count : index
  scf.if %live {
    %packets = buffer.view %metadata[%c16] : buffer -> view<[%spans]x9xi32>
    %length32 = view.load %packets[%span, 0] : view<[%spans]x9xi32> -> i32
    %position32 = view.load %packets[%span, 1] : view<[%spans]x9xi32> -> i32
    %row32 = view.load %packets[%span, 3] : view<[%spans]x9xi32> -> i32
    %input32 = view.load %packets[%span, 4] : view<[%spans]x9xi32> -> i32
    %length_bound = scalar.assume %length32 [range(%length32, 1, 2147483647)] : i32
    %position_bound = scalar.assume %position32 [range(%position32, 0, 2147483646)] : i32
    %row_bound = scalar.assume %row32 [range(%row32, 0, 2147483646)] : i32
    %input64 = scalar.extui %input32 : i32 to i64
    %input_bound = scalar.assume %input64 [range(%input64, 0, 4294967293)] : i64
    %length = index.cast %length_bound : i32 to index
    %position = index.cast %position_bound : i32 to index
    %row = index.cast %row_bound : i32 to index
    %input = index.cast %input_bound : i64 to index
    %context = config.get @fixture.context : index
    %plane = index.mul %row, %context : index
    %hidden = buffer.view %residual[%origin] : buffer -> view<[%spans]xi32>
    %h = view.load %hidden[%span] : view<[%spans]xi32> -> i32
    %c0 = index.constant 0 : index
    %c1 = index.constant 1 : index
    %c7_i32 = scalar.constant 7 : i32
    %c131_i32 = scalar.constant 131 : i32
    %anchor = scalar.muli %h, %c131_i32 : i32
    scf.for %i = [%c0 to %length step %c1] {
      %input_index = index.add %input, %i : index
      %input_offset = index.scale %input_index, %word : index, offset -> offset
      %ids = buffer.view %tokens[%input_offset] : buffer -> view<1xi32>
      %token = view.load %ids[0] : view<1xi32> -> i32
      %absolute = index.add %position, %i : index
      %absolute32 = index.cast %absolute : index to i32
      %scaled = scalar.muli %token, %c7_i32 : i32
      %with_token = scalar.addi %anchor, %scaled : i32
      %value = scalar.addi %with_token, %absolute32 : i32
      %slot = index.add %plane, %absolute : index
      %slot_offset = index.scale %slot, %word : index, offset -> offset
      %entry = buffer.view %cache[%slot_offset] : buffer -> view<1xi32>
      view.store %value, %entry[0] : i32, view<1xi32>
    }
  }
  kernel.return
}

command.def public @draft_warm() launch(%residual: buffer, %metadata: buffer, %tokens: buffer, %cache: buffer) {
  kernel.launch @warm_draft(%residual, %metadata, %tokens, %cache) : (buffer, buffer, buffer, buffer)
  command.return
}

// Resource ABI 2 residual leaf: the bank's selection followed by its draft
// warm, in the group's twelve-root order plus the reflected workspace.
command.def public @group_warm() launch(%residual: buffer, %metadata: buffer, %origins: buffer, %arena: buffer, %tokens: buffer, %outputs: buffer, %carry: buffer, %committed: buffer, %results: buffer, %cache: buffer, %row_table: buffer, %next_results: buffer) {
  %spans = config.get @fixture.spans : index
  %word = index.constant 4 : offset
  %bytes = index.scale %spans, %word : index, offset -> offset
  %temporary = buffer.alloca<global> align(16) %bytes : buffer
  kernel.launch @copy_group_hidden(%residual, %temporary, %metadata) : (buffer, buffer, buffer)
  kernel.launch @select(%temporary, %metadata, %origins, %arena, %outputs) : (buffer, buffer, buffer, buffer, buffer)
  kernel.launch @warm_draft(%residual, %metadata, %tokens, %cache) : (buffer, buffer, buffer, buffer)
  command.return
}
