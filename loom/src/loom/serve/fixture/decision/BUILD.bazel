load("//loom/build_tools/bazel:loom_model.bzl", "loom_model")
load(":sources.bzl", "SOURCE_FILES")

package(default_visibility = ["//visibility:private"])

exports_files(
    SOURCE_FILES,
    visibility = ["//visibility:public"],
)

[
    loom_model(
        name = "card_model_" + encoding,
        card = "card.json",
        encoding = encoding,
        files = {
            "config.loom": "config.loom",
            "control.loom": "control.loom",
            "decide.loom": "decide.loom",
            "prepare.loom": "prepare.loom",
            "service.loom": "service.loom",
        },
        model_name = "judge",
        preset = "check",
        tags = ["skip-bazel_to_cmake"],
        visibility = ["//visibility:public"],
    )
    for encoding in [
        "text",
        "bc",
    ]
]
