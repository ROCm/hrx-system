func.decl import("input") @encode(%text: buffer, %flags: i32, %capacity: i64) -> (buffer, i64)

func.decl import("input") @require(%condition: i32, %diagnostic: buffer)

func.decl import("prepare") @stage(%root: buffer, %execution: i32, %tag: i64) -> (i32)

func.decl import("prepare") @config_i64(%stage: i32, %key: buffer, %value: i64)

func.decl import("prepare") @workspace_limit(%stage: i32, %byte_length: i64)

func.decl import("runner") @execute_3(%stage: i32, %request: hal.buffer, %rgb: hal.buffer, %workspace: hal.buffer) -> (i64)

func.decl import("runner") @feedback(%slot: i32, %source: hal.buffer, %offset: i64, %length: i64) -> (i64)

func.def @lora_id_equal(%records: buffer, %offset: offset, %length: offset, %name: buffer) -> (i1) {
  %name_length = buffer.length %name
  %same_length = index.cmp eq, %length, %name_length : offset
  %equal = scf.if %same_length -> (i1) {
    %origin = index.constant 0 : offset
    %order = buffer.compare %records[%offset], %name[%origin], %length
    %c0 = scalar.constant 0 : i32
    %matches = scalar.cmpi eq, %order, %c0 : i32
    scf.yield %matches : i1
  } else {
    %false = scalar.constant false : i1
    scf.yield %false : i1
  }
  func.return %equal : i1
}

// Native ingress owns record bounds, UTF-8 decoding, and finite F32 conversion.
// The source resolves model identities once, before a cohort is captured.
func.def @select_loras(%loras: buffer) -> (f32, f32) {
  %origin = index.constant 0 : offset
  %length = buffer.length %loras
  %unselected = scalar.constant 0.0 : f32
  %false = scalar.constant false : i1
  // The fixture registers two scalar adapters with unit factors: one updates
  // the red projection and one the green projection. Their IDs are model data.
  %red_name = buffer.constant utf8("red") : buffer
  %green_name = buffer.constant utf8("green") : buffer
  %error = buffer.constant utf8("unknown or duplicate fixture LoRA ID") : buffer
  %end, %red, %green, %red_seen, %green_seen = scf.while(%position = %origin : offset, %red = %unselected : f32, %green = %unselected : f32, %red_seen = %false : i1, %green_seen = %false : i1) -> (offset, f32, f32, i1, i1) {
    %more = index.cmp ult, %position, %length : offset
    scf.condition %more, %position, %red, %green, %red_seen, %green_seen : i1, offset, f32, f32, i1, i1
  } do(%position: offset, %red: f32, %green: f32, %red_seen: i1, %green_seen: i1) {
    %header = buffer.view %loras[%position] : buffer -> view<1xi64>
    %loaded_length = view.load %header[0] : view<1xi64> -> i64
    %name_length64 = scalar.assume %loaded_length [range(%loaded_length, 1, 9223372036854775784)] : i64
    %name_length = index.cast %name_length64 : i64 to offset
    %scale_field = index.constant 8 : offset
    %header_bytes = index.constant 16 : offset
    %scale_offset = index.add %position, %scale_field : offset
    %scale_view = buffer.view %loras[%scale_offset] : buffer -> view<1xf32>
    %scale = view.load %scale_view[0] : view<1xf32> -> f32
    %name_offset = index.add %position, %header_bytes : offset
    %is_red = func.call @lora_id_equal(%loras, %name_offset, %name_length, %red_name) : (buffer, offset, offset, buffer) -> (i1)
    %is_green = func.call @lora_id_equal(%loras, %name_offset, %name_length, %green_name) : (buffer, offset, offset, buffer) -> (i1)
    %known = scalar.ori %is_red, %is_green : i1
    %duplicate_red = scalar.andi %is_red, %red_seen : i1
    %duplicate_green = scalar.andi %is_green, %green_seen : i1
    %duplicate = scalar.ori %duplicate_red, %duplicate_green : i1
    %unique = scalar.cmpi eq, %duplicate, %false : i1
    %valid = scalar.andi %known, %unique : i1
    %valid32 = scalar.extui %valid : i1 to i32
    func.call @require(%valid32, %error) : (i32, buffer)
    %next_red = scf.select %is_red, %scale, %red : f32
    %next_green = scf.select %is_green, %scale, %green : f32
    %next_red_seen = scalar.ori %red_seen, %is_red : i1
    %next_green_seen = scalar.ori %green_seen, %is_green : i1
    %padding = scalar.constant 7 : i64
    %mask = scalar.constant -8 : i64
    %rounded = scalar.addi %name_length64, %padding : i64
    %padded64 = scalar.andi %rounded, %mask : i64
    %padded = index.cast %padded64 : i64 to offset
    %next = index.add %name_offset, %padded : offset
    scf.yield %next, %next_red, %next_green, %next_red_seen, %next_green_seen : offset, f32, f32, i1, i1
  }
  func.return %red, %green : f32, f32
}

// The payload carries request-derived facts, not host-rendered pixels.
func.def public @prepare_request(%state: buffer, %height: i64, %width: i64, %prompt: buffer, %seed: i64, %loras: buffer) -> (buffer, i64, i64) {
  %origin = index.constant 0 : offset
  %state_view = buffer.view %state[%origin] : buffer -> view<2xi64>
  %capacity = view.load %state_view[0] : view<2xi64> -> i64
  %minimum = scalar.constant 0 : i64
  %maximum = scalar.constant 64 : i64
  %h0 = scalar.cmpi ugt, %height, %minimum : i64
  %h1 = scalar.cmpi ule, %height, %maximum : i64
  %w0 = scalar.cmpi ugt, %width, %minimum : i64
  %w1 = scalar.cmpi ule, %width, %maximum : i64
  %h = scalar.andi %h0, %h1 : i1
  %w = scalar.andi %w0, %w1 : i1
  %shape = scalar.andi %h, %w : i1
  %shape32 = scalar.extui %shape : i1 to i32
  %shape_error = buffer.constant utf8("fixture requires 1-64 pixel extents") : buffer
  func.call @require(%shape32, %shape_error) : (i32, buffer)
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i64
  %bound = scalar.addi %capacity, %c1 : i64
  %ids, %count = func.call @encode(%prompt, %c0, %bound) : (buffer, i32, i64) -> (buffer, i64)
  %fits = scalar.cmpi ule, %count, %capacity : i64
  %fits32 = scalar.extui %fits : i1 to i32
  %error = buffer.constant utf8("prompt exceeds fixture text capacity") : buffer
  func.call @require(%fits32, %error) : (i32, buffer)
  %length = index.constant 32 : offset
  %payload = buffer.alloca<private> align(8) %length : buffer
  %header = buffer.view %payload[%origin] : buffer -> view<3xi64>
  view.store %seed, %header[0] : i64, view<3xi64>
  view.store %count, %header[1] : i64, view<3xi64>
  %pixels = scalar.muli %height, %width : i64
  view.store %pixels, %header[2] : i64, view<3xi64>
  %red, %green = func.call @select_loras(%loras) : (buffer) -> (f32, f32)
  %scales_offset = index.constant 24 : offset
  %values = buffer.view %payload[%scales_offset] : buffer -> view<2xf32>
  view.store %red, %values[0] : f32, view<2xf32>
  view.store %green, %values[1] : f32, view<2xf32>
  func.return %payload, %c1, %pixels : buffer, i64, i64
}

// Source requests have a fixed packet layout. A cohort shares the pixel count
// but keeps independent request values and private palette slots.
func.def public @prepare_batch(%state: buffer, %tags: buffer, %ranges: buffer, %payload: buffer) -> (i32, buffer) {
  %primary_execution = scalar.constant 0 : i32
  %origin = index.constant 0 : offset
  %range = buffer.view %ranges[%origin] : buffer -> view<1x2xi64>
  %first = view.load %range[0, 0] : view<1x2xi64> -> i64
  %first_bounded = scalar.assume %first [range(%first, 0, 9223372036854775807)] : i64
  %request_offset = index.cast %first_bounded : i64 to offset
  %state_view = buffer.view %state[%origin] : buffer -> view<2xi64>
  %capacity = view.load %state_view[0] : view<2xi64> -> i64
  %cold_pixels = view.load %state_view[1] : view<2xi64> -> i64
  %header = buffer.view %payload[%request_offset] : buffer -> view<3xi64>
  %pixels = view.load %header[2] : view<3xi64> -> i64
  %range_bytes = buffer.length %ranges
  %range_length = index.cast %range_bytes : offset to i64
  %c16 = scalar.constant 16 : i64
  %count = scalar.divui %range_length, %c16 : i64
  %c1 = scalar.constant 1 : i64
  %single = scalar.cmpi eq, %count, %c1 : i64
  %same_pixels = scalar.cmpi eq, %pixels, %cold_pixels : i64
  %cold = scalar.andi %single, %same_pixels : i1
  %c0 = scalar.constant 0 : i32
  %selected = scf.if %cold -> (i32) {
    scf.yield %c0 : i32
  } else {
    %root = buffer.constant utf8("generate_image") : buffer
    %stage = func.call @stage(%root, %primary_execution, %capacity) : (buffer, i32, i64) -> (i32)
    %workspace_limit = scalar.constant 8192 : i64
    func.call @workspace_limit(%stage, %workspace_limit) : (i32, i64)
    %key = buffer.constant utf8("fixture.pixels") : buffer
    func.call @config_i64(%stage, %key, %pixels) : (i32, buffer, i64)
    %batch_key = buffer.constant utf8("fixture.batch") : buffer
    func.call @config_i64(%stage, %batch_key, %count) : (i32, buffer, i64)
    scf.yield %stage : i32
  }
  func.return %selected, %payload : i32, buffer
}

func.def public @generate(%first_part: i32, %part_count: i32, %cursor: i32, %output_bytes: i64, %request: hal.buffer, %rgb: hal.buffer, %workspace: hal.buffer) -> (i32) {
  %part = scalar.addi %first_part, %cursor : i32
  %work = func.call @execute_3(%part, %request, %rgb, %workspace) : (i32, hal.buffer, hal.buffer, hal.buffer) -> (i64)
  %c1 = scalar.constant 1 : i32
  %next = scalar.addi %cursor, %c1 : i32
  %more = scalar.cmpi slt, %next, %part_count : i32
  %result = scf.if %more -> (i32) {
    scf.yield %next : i32
  } else {
    %c0 = scalar.constant 0 : i32
    %offset = scalar.constant 0 : i64
    %done = func.call @feedback(%c0, %rgb, %offset, %output_bytes) : (i32, hal.buffer, i64, i64) -> (i64)
    %terminal = scalar.constant -1 : i32
    scf.yield %terminal : i32
  }
  func.return %result : i32
}
