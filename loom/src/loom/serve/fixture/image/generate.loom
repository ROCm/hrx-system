config.decl @fixture.pixels : %value: index where [range(%value, 1, 4096)]

config.decl @fixture.batch : %value: index where [range(%value, 1, 4)]

target.decl @fixture_target

kernel.def target(@fixture_target) @colors() {
  %batch = config.get @fixture.batch : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%batch, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%request: buffer, %colors: buffer) {
  %batch = config.get @fixture.batch : index
  %item = kernel.workgroup.id<x> : index
  %origin = index.constant 0 : offset
  %range_stride = index.constant 16 : offset
  %records_offset = index.scale %batch, %range_stride : index, offset -> offset
  %header = buffer.view %request[%records_offset] : buffer -> view<[%batch]x8xi32>
  %values = buffer.view %request[%records_offset] : buffer -> view<[%batch]x8xf32>
  %output = buffer.view %colors[%origin] : buffer -> view<[%batch]x2xf32>
  %seed = view.load %header[%item, 0] : view<[%batch]x8xi32> -> i32
  %count = view.load %header[%item, 2] : view<[%batch]x8xi32> -> i32
  %red_scale = view.load %values[%item, 6] : view<[%batch]x8xf32> -> f32
  %green_scale = view.load %values[%item, 7] : view<[%batch]x8xf32> -> f32
  %c1 = scalar.constant 1 : i32
  %c0 = scalar.constant 0 : i32
  %seed_bit = scalar.andi %seed, %c1 : i32
  %count_bit = scalar.andi %count, %c1 : i32
  %odd_seed = scalar.cmpi ne, %seed_bit, %c0 : i32
  %odd_count = scalar.cmpi ne, %count_bit, %c0 : i32
  %low = scalar.constant -1.0 : f32
  %high = scalar.constant 1.0 : f32
  %red = scf.select %odd_seed, %high, %low : f32
  %green = scf.select %odd_count, %high, %low : f32
  %red_delta = scalar.mulf %red, %red_scale : f32
  %green_delta = scalar.mulf %green, %green_scale : f32
  %scaled_red = scalar.addf %red, %red_delta : f32
  %scaled_green = scalar.addf %green, %green_delta : f32
  view.store %scaled_red, %output[%item, 0] : f32, view<[%batch]x2xf32>
  view.store %scaled_green, %output[%item, 1] : f32, view<[%batch]x2xf32>
  kernel.return
}

kernel.def target(@fixture_target) @pixels() {
  %count = config.get @fixture.pixels : index
  %batch = config.get @fixture.batch : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%count, %batch, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%colors: buffer, %rgb: buffer) {
  %count = config.get @fixture.pixels : index
  %batch = config.get @fixture.batch : index
  %pixel = kernel.workgroup.id<x> : index
  %item = kernel.workgroup.id<y> : index
  %valid = index.cmp ult, %pixel, %count : index
  scf.if %valid {
    %origin = index.constant 0 : offset
    %palette = buffer.view %colors[%origin] : buffer -> view<[%batch]x2xf32>
    %output = buffer.view %rgb[%origin] : buffer -> view<[%batch]x3x[%count]xf32>
    %red = view.load %palette[%item, 0] : view<[%batch]x2xf32> -> f32
    %green = view.load %palette[%item, 1] : view<[%batch]x2xf32> -> f32
    %pixel32 = index.cast %pixel : index to i32
    %c1 = scalar.constant 1 : i32
    %c0 = scalar.constant 0 : i32
    %bit = scalar.andi %pixel32, %c1 : i32
    %odd = scalar.cmpi ne, %bit, %c0 : i32
    %low = scalar.constant -1.0 : f32
    %high = scalar.constant 1.0 : f32
    %blue = scf.select %odd, %high, %low : f32
    view.store %red, %output[%item, 0, %pixel] : f32, view<[%batch]x3x[%count]xf32>
    view.store %green, %output[%item, 1, %pixel] : f32, view<[%batch]x3x[%count]xf32>
    view.store %blue, %output[%item, 2, %pixel] : f32, view<[%batch]x3x[%count]xf32>
  }
  kernel.return
}

command.def public @generate_image() launch(%request: buffer, %rgb: buffer) {
  %batch = config.get @fixture.batch : index
  %stride = index.constant 8 : offset
  %length = index.scale %batch, %stride : index, offset -> offset
  %colors = buffer.alloca<global> align(16) %length : buffer
  kernel.launch @colors(%request, %colors) : (buffer, buffer)
  kernel.launch @pixels(%colors, %rgb) : (buffer, buffer)
  command.return
}
