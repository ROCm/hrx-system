func.decl import("runner") @execute_5(%stage: i32, %work: hal.buffer, %request: hal.buffer, %conditioning: hal.buffer, %stream: hal.buffer, %output: hal.buffer) -> (i64)

func.decl import("runner") @feedback(%slot: i32, %source: hal.buffer, %offset: i64, %length: i64) -> (i64)

func.def public @prepare_request(%model: buffer, %language: buffer, %prompt: buffer, %temperature: f32, %outputs: i32) -> (buffer, buffer) {
  %origin = index.constant 0 : offset
  %length = index.constant 32 : offset
  %state = buffer.alloca<private> align(8) %length : buffer
  %fields = buffer.view %state[%origin] : buffer -> view<3xi64>
  %c0 = scalar.constant 0 : i64
  view.store %c0, %fields[0] : i64, view<3xi64>
  view.store %c0, %fields[1] : i64, view<3xi64>
  %outputs64 = scalar.extui %outputs : i32 to i64
  view.store %outputs64, %fields[2] : i64, view<3xi64>
  // Activity depends on this quantum's PCM contribution, not the retained
  // transcript accumulator. Silence after speech must become inactive again.
  %sum_offset = index.constant 24 : offset
  %previous = buffer.view %state[%sum_offset] : buffer -> view<1xf32>
  %initial_sum = scalar.constant 0.0 : f32
  view.store %initial_sum, %previous[0] : f32, view<1xf32>
  // The prompt is immutable request data; it may be empty. Numerical work
  // consumes PCM from later work offers and does not need this request root.
  func.return %state, %prompt : buffer, buffer
}

// Three-frame model work is independent of the transport's packet sizes.
func.def public @prepare_work(%model: buffer, %state: buffer, %pcm: buffer, %position: i64, %eof: i32) -> (buffer, i64, i64) {
  %origin = index.constant 0 : offset
  %length = buffer.length %pcm
  %bytes = index.cast %length : offset to i64
  %c4 = scalar.constant 4 : i64
  %c3 = scalar.constant 3 : i64
  %c0 = scalar.constant 0 : i64
  %c1 = scalar.constant 1 : i64
  %frames = scalar.divui %bytes, %c4 : i64
  %short = scalar.cmpi ult, %frames, %c3 : i64
  %count = scf.select %short, %frames, %c3 : i64
  %zero32 = scalar.constant 0 : i32
  %final = scalar.cmpi ne, %eof, %zero32 : i32
  %full = scalar.cmpi uge, %frames, %c3 : i64
  %ready = scalar.ori %full, %final : i1
  %units = scf.select %ready, %c1, %c0 : i64
  %all = scalar.cmpi eq, %count, %frames : i64
  %done = scalar.andi %all, %final : i1
  %done32 = scalar.extui %done : i1 to i32
  %size = index.constant 48 : offset
  %work = buffer.alloca<private> align(8) %size : buffer
  %header = buffer.view %work[%origin] : buffer -> view<8xi32>
  %state_fields = buffer.view %state[%origin] : buffer -> view<2xi64>
  %initialized = view.load %state_fields[0] : view<2xi64> -> i64
  %initialized32 = scalar.trunci %initialized : i64 to i32
  %position32 = scalar.trunci %position : i64 to i32
  %count32 = scalar.trunci %count : i64 to i32
  view.store %zero32, %header[0] : i32, view<8xi32>
  view.store %initialized32, %header[1] : i32, view<8xi32>
  view.store %position32, %header[2] : i32, view<8xi32>
  view.store %count32, %header[3] : i32, view<8xi32>
  view.store %done32, %header[4] : i32, view<8xi32>
  view.store %zero32, %header[5] : i32, view<8xi32>
  view.store %zero32, %header[6] : i32, view<8xi32>
  view.store %zero32, %header[7] : i32, view<8xi32>
  %samples_start = index.constant 32 : offset
  %target = buffer.view %work[%samples_start] : buffer -> view<4xf32>
  %zero_sample = scalar.constant 0.0 : f32
  view.store %zero_sample, %target[0] : f32, view<4xf32>
  view.store %zero_sample, %target[1] : f32, view<4xf32>
  view.store %zero_sample, %target[2] : f32, view<4xf32>
  view.store %zero_sample, %target[3] : f32, view<4xf32>
  %bounded = scalar.assume %count [range(%count, 0, 3)] : i64
  %end = index.cast %bounded : i64 to index
  %source = buffer.view %pcm[%origin] : buffer -> view<[%end]xf32>
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  scf.for %i = [%begin to %end step %step] {
    %value = view.load %source[%i] : view<[%end]xf32> -> f32
    view.store %value, %target[%i] : f32, view<4xf32>
  }
  func.return %work, %units, %c0 : buffer, i64, i64
}

func.def public @prepare_batch(%model: buffer, %tags: buffer, %ranges: buffer, %packed: buffer) -> (buffer, buffer) {
  %origin = index.constant 0 : offset
  %length = buffer.length %ranges
  %bytes = index.cast %length : offset to i64
  %record = scalar.constant 24 : i64
  %count64 = scalar.divui %bytes, %record : i64
  %bounded = scalar.assume %count64 [range(%count64, 1, 4)] : i64
  %count = index.cast %bounded : i64 to index
  %records = buffer.view %ranges[%origin] : buffer -> view<[%count]x3xi64>
  %capacity = index.constant 208 : offset
  %payload = buffer.alloca<private> align(8) %capacity : buffer
  %header = buffer.view %payload[%origin] : buffer -> view<1xi32>
  %count32 = scalar.trunci %count64 : i64 to i32
  view.store %count32, %header[0] : i32, view<1xi32>
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %word_count = index.constant 12 : index
  %stride = index.constant 48 : offset
  %header_length = index.constant 16 : offset
  scf.for %i = [%begin to %count step %step] {
    %source64 = view.load %records[%i, 1] : view<[%count]x3xi64> -> i64
    %bounded_offset = scalar.assume %source64 [range(%source64, 0, 144)] : i64
    %source_offset = index.cast %bounded_offset : i64 to offset
    %scaled = index.scale %i, %stride : index, offset -> offset
    %target_offset = index.add %scaled, %header_length : offset
    %source = buffer.view %packed[%source_offset] : buffer -> view<12xi32>
    %target = buffer.view %payload[%target_offset] : buffer -> view<12xi32>
    scf.for %j = [%begin to %word_count step %step] {
      %word = view.load %source[%j] : view<12xi32> -> i32
      view.store %word, %target[%j] : i32, view<12xi32>
    }
    %row = view.load %records[%i, 0] : view<[%count]x3xi64> -> i64
    %row32 = scalar.trunci %row : i64 to i32
    view.store %row32, %target[0] : i32, view<12xi32>
  }
  func.return %payload, %payload : buffer, buffer
}

func.def public @generate(%plan: buffer, %work: hal.buffer, %requests: hal.buffer, %conditioning: hal.buffer, %streams: hal.buffer, %output: hal.buffer) {
  %c0 = scalar.constant 0 : i32
  %execution = func.call @execute_5(%c0, %work, %requests, %conditioning, %streams, %output) : (i32, hal.buffer, hal.buffer, hal.buffer, hal.buffer, hal.buffer) -> (i64)
  %origin = index.constant 0 : offset
  %header = buffer.view %plan[%origin] : buffer -> view<1xi32>
  %count = view.load %header[0] : view<1xi32> -> i32
  %count64 = scalar.extui %count : i32 to i64
  %stride = scalar.constant 16 : i64
  %length = scalar.muli %count64, %stride : i64
  %zero64 = scalar.constant 0 : i64
  %feedback = func.call @feedback(%c0, %output, %zero64, %length) : (i32, hal.buffer, i64, i64) -> (i64)
  func.return
}

// A transcript record contains its typed envelope, fixed header, and one byte.
func.def @write_transcript(%packet: buffer, %offset: offset, %revision: i64, %end: i64, %flags: i32, %character: i8) {
  %record = buffer.view %packet[%offset] : buffer -> view<2xi32>
  %zero32 = scalar.constant 0 : i32
  %one32 = scalar.constant 1 : i32
  %length = scalar.constant 49 : i32
  view.store %zero32, %record[0] : i32, view<2xi32>
  view.store %length, %record[1] : i32, view<2xi32>
  %header_delta = index.constant 8 : offset
  %header_offset = index.add %offset, %header_delta : offset
  %header = buffer.view %packet[%header_offset] : buffer -> view<4xi64>
  %zero64 = scalar.constant 0 : i64
  view.store %zero64, %header[0] : i64, view<4xi64>
  view.store %revision, %header[1] : i64, view<4xi64>
  view.store %zero64, %header[2] : i64, view<4xi64>
  view.store %end, %header[3] : i64, view<4xi64>
  %flags_delta = index.constant 40 : offset
  %flags_offset = index.add %offset, %flags_delta : offset
  %fields = buffer.view %packet[%flags_offset] : buffer -> view<4xi32>
  view.store %flags, %fields[0] : i32, view<4xi32>
  view.store %one32, %fields[1] : i32, view<4xi32>
  view.store %zero32, %fields[2] : i32, view<4xi32>
  view.store %zero32, %fields[3] : i32, view<4xi32>
  %text_delta = index.constant 56 : offset
  %text_offset = index.add %offset, %text_delta : offset
  %text = buffer.view %packet[%text_offset] : buffer -> view<1xi8>
  view.store %character, %text[0] : i8, view<1xi8>
  func.return
}

func.def public @complete(%model: buffer, %state: buffer, %plan: buffer, %ordinal: i64, %feedback: buffer) -> (i64, buffer, i64, i32) {
  %stride = scalar.constant 16 : i64
  %offset64 = scalar.muli %ordinal, %stride : i64
  %bounded = scalar.assume %offset64 [range(%offset64, 0, 48)] : i64
  %offset = index.cast %bounded : i64 to offset
  %output = buffer.view %feedback[%offset] : buffer -> view<4xi32>
  %end32 = view.load %output[0] : view<4xi32> -> i32
  %count32 = view.load %output[1] : view<4xi32> -> i32
  %done = view.load %output[2] : view<4xi32> -> i32
  %values = buffer.view %feedback[%offset] : buffer -> view<4xf32>
  %sum = view.load %values[3] : view<4xf32> -> f32
  %sum_offset = index.constant 24 : offset
  %previous = buffer.view %state[%sum_offset] : buffer -> view<1xf32>
  %previous_sum = view.load %previous[0] : view<1xf32> -> f32
  %changed = scalar.cmpf one, %sum, %previous_sum : f32
  view.store %sum, %previous[0] : f32, view<1xf32>
  %integer = scalar.fptoui %sum : f32 to i32
  %letters = scalar.constant 26 : i32
  %base = scalar.constant 65 : i32
  %wrapped = scalar.remui %integer, %letters : i32
  %character32 = scalar.addi %wrapped, %base : i32
  %count = scalar.extui %count32 : i32 to i64
  %end = scalar.extui %end32 : i32 to i64
  %origin = index.constant 0 : offset
  %cursor = buffer.view %state[%origin] : buffer -> view<3xi64>
  %revision = view.load %cursor[1] : view<3xi64> -> i64
  %outputs = view.load %cursor[2] : view<3xi64> -> i64
  %c0 = scalar.constant 0 : i64
  %c1 = scalar.constant 1 : i64
  %c2 = scalar.constant 2 : i64
  %c3 = scalar.constant 3 : i64
  %transcript_bit = scalar.andi %outputs, %c1 : i64
  %activity_bit = scalar.andi %outputs, %c2 : i64
  %has_activity = scalar.cmpi ne, %activity_bit, %c0 : i64
  %has_input = scalar.cmpi ne, %count, %c0 : i64
  %activity = scalar.andi %has_activity, %has_input : i1
  %activity_count = scalar.extui %activity : i1 to i64
  // Compound output includes a provisional and replacement revision together.
  // They must remain individually observable after the document is updated.
  %compound = scalar.cmpi eq, %outputs, %c3 : i64
  %extra = scalar.extui %compound : i1 to i64
  %transcripts = scalar.addi %transcript_bit, %extra : i64
  %event_count = scalar.addi %activity_count, %transcripts : i64
  %count_header = buffer.view %model[%origin] : buffer -> view<1xi32>
  %event_count32 = scalar.trunci %event_count : i64 to i32
  view.store %event_count32, %count_header[0] : i32, view<1xi32>
  scf.if %activity {
    %activity_offset = index.constant 4 : offset
    %record = buffer.view %model[%activity_offset] : buffer -> view<2xi32>
    %kind = scalar.constant 1 : i32
    %activity_bytes = scalar.constant 20 : i32
    view.store %kind, %record[0] : i32, view<2xi32>
    view.store %activity_bytes, %record[1] : i32, view<2xi32>
    %interval_offset = index.constant 12 : offset
    %interval = buffer.view %model[%interval_offset] : buffer -> view<2xi64>
    %begin = scalar.subi %end, %count : i64
    view.store %begin, %interval[0] : i64, view<2xi64>
    view.store %end, %interval[1] : i64, view<2xi64>
    %probability_offset = index.constant 28 : offset
    %probability = buffer.view %model[%probability_offset] : buffer -> view<1xf32>
    %active = scalar.constant 0.75 : f32
    %inactive = scalar.constant 0.0 : f32
    %score = scf.select %changed, %active, %inactive : f32
    view.store %score, %probability[0] : f32, view<1xf32>
  }
  %header_bytes = scalar.constant 4 : i64
  %activity_bytes = scalar.constant 28 : i64
  %transcript_bytes = scalar.constant 57 : i64
  %activity_size = scalar.muli %activity_count, %activity_bytes : i64
  %transcript_start = scalar.addi %header_bytes, %activity_size : i64
  %bounded_transcripts = scalar.assume %transcripts [range(%transcripts, 0, 2)] : i64
  %limit = index.cast %bounded_transcripts : i64 to index
  %first = index.constant 0 : index
  %step = index.constant 1 : index
  %lowercase_delta = scalar.constant 32 : i32
  %lowercase = scalar.addi %character32, %lowercase_delta : i32
  %zero32 = scalar.constant 0 : i32
  scf.for %i = [%first to %limit step %step] {
    %index64 = index.cast %i : index to i64
    %offset_delta = scalar.muli %index64, %transcript_bytes : i64
    %offset64 = scalar.addi %transcript_start, %offset_delta : i64
    %bounded_offset = scalar.assume %offset64 [range(%offset64, 4, 89)] : i64
    %event_offset = index.cast %bounded_offset : i64 to offset
    %next_index = scalar.addi %index64, %c1 : i64
    %next_revision = scalar.addi %revision, %next_index : i64
    %last = scalar.cmpi eq, %next_index, %transcripts : i64
    %flags = scf.select %last, %done, %zero32 : i32
    %letter32 = scf.select %last, %character32, %lowercase : i32
    %letter = scalar.trunci %letter32 : i32 to i8
    func.call @write_transcript(%model, %event_offset, %next_revision, %end, %flags, %letter) : (buffer, offset, i64, i64, i32, i8)
  }
  %next = scalar.addi %revision, %transcripts : i64
  view.store %c1, %cursor[0] : i64, view<3xi64>
  view.store %next, %cursor[1] : i64, view<3xi64>
  %transcript_size = scalar.muli %transcripts, %transcript_bytes : i64
  %packet_size = scalar.addi %transcript_start, %transcript_size : i64
  %empty = scalar.cmpi eq, %event_count, %c0 : i64
  %produced_bytes = scf.select %empty, %c0, %packet_size : i64
  func.return %count, %model, %produced_bytes, %done : i64, buffer, i64, i32
}
