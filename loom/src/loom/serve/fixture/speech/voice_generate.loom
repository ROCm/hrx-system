target.decl @speech_target

// Voice preparation writes a slot only after CPU preprocessing. Later requests
// consume this device-resident value through the ordinary waveform kernel.
kernel.def target(@speech_target) @encode_voice() {
  %c1 = index.constant 1 : index
  %rows = index.constant 4 : index
  kernel.launch.config workgroups(%rows, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%work: buffer, %request: buffer, %conditioning: buffer) {
  %origin = index.constant 0 : offset
  %ordinal = kernel.workgroup.id<x> : index
  %header = buffer.view %work[%origin] : buffer -> view<2xi32>
  %count32 = view.load %header[0] : view<2xi32> -> i32
  %count = index.cast %count32 : i32 to index
  %selected = index.cmp ult, %ordinal, %count : index
  scf.if %selected {
    %map_offset = index.constant 8 : offset
    %map = buffer.view %work[%map_offset] : buffer -> view<4xi32>
    %row32 = view.load %map[%ordinal] : view<4xi32> -> i32
    %bounded_row = scalar.assume %row32 [range(%row32, 0, 3)] : i32
    %row = index.cast %bounded_row : i32 to index
    %stride = index.constant 16 : offset
    %row_offset = index.scale %row, %stride : index, offset -> offset
    %input = buffer.view %request[%row_offset] : buffer -> view<4xi32>
    %slot32 = view.load %input[0] : view<4xi32> -> i32
    %mean32 = view.load %input[1] : view<4xi32> -> i32
    %bounded_slot = scalar.assume %slot32 [range(%slot32, 0, 1)] : i32
    %slot = index.cast %bounded_slot : i32 to index
    %mean = scalar.bitcast %mean32 : i32 to f32
    %voices = buffer.view %conditioning[%origin] : buffer -> view<2xf32>
    view.store %mean, %voices[%slot] : f32, view<2xf32>
  }
  kernel.return
}

command.def public @prepare_voice_audio() launch(%work: buffer, %request: buffer, %conditioning: buffer, %state: buffer, %output: buffer) {
  kernel.launch @encode_voice(%work, %request, %conditioning) : (buffer, buffer, buffer)
  command.return
}
