// A stateless source may complete with no waveform frames. It exercises the
// empty state prefix without retaining a placeholder CPU buffer.
global.rodata.def @work = bytes("00000000")

func.def public @prepare_request(%model: buffer, %text: buffer, %voice: buffer, %instructions: buffer, %seed: i64, %speed: f32) -> (buffer) {
  %work = global.load @work : buffer
  func.return %work : buffer
}

func.def public @prepare_work(%model: buffer) -> (buffer, i64, i64) {
  %work = global.load @work : buffer
  %unit = scalar.constant 1 : i64
  %tag = scalar.constant 0 : i64
  func.return %work, %unit, %tag : buffer, i64, i64
}

func.def public @prepare_batch(%model: buffer, %tags: buffer, %ranges: buffer, %packed: buffer) -> (buffer, buffer) {
  func.return %packed, %packed : buffer, buffer
}

func.def public @generate(%plan: buffer, %work: hal.buffer, %request: hal.buffer, %conditioning: hal.buffer, %stream: hal.buffer, %output: hal.buffer) {
  func.return
}

func.def public @complete(%model: buffer, %plan: buffer, %ordinal: i64, %feedback: buffer) -> (i64, i64, i64, i32) {
  %c0 = scalar.constant 0 : i64
  %done = scalar.constant 1 : i32
  func.return %c0, %c0, %c0, %done : i64, i64, i64, i32
}
