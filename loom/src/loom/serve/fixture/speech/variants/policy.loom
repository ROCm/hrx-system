func.decl import("prepare") @stage(%root: buffer, %execution: i32, %tag: i64) -> (i32)

func.def public @prepare_weight(%key: buffer) -> (i64) {
  %primary_execution = scalar.constant 0 : i32
  %length = buffer.length %key
  %key_length = index.constant 6 : offset
  %same_length = index.cmp eq, %length, %key_length : offset
  %matches = scf.if %same_length -> (i1) {
    %origin = index.constant 0 : offset
    %actual = buffer.view %key[%origin] : buffer -> view<6xi8>
    %expected = buffer.constant utf8("factor") : buffer
    %expected_view = buffer.view %expected[%origin] : buffer -> view<6xi8>
    %start = index.constant 0 : index
    %end = index.constant 6 : index
    %step = index.constant 1 : index
    %true = scalar.constant true : i1
    %matches = scf.for %i = [%start to %end step %step](%previous = %true : i1) -> (i1) {
      %a = view.load %actual[%i] : view<6xi8> -> i8
      %b = view.load %expected_view[%i] : view<6xi8> -> i8
      %equal = scalar.cmpi eq, %a, %b : i8
      %next = scalar.andi %previous, %equal : i1
      scf.yield %next : i1
    }
    scf.yield %matches : i1
  } else {
    %false = scalar.constant false : i1
    scf.yield %false : i1
  }
  %bytes = scf.if %matches -> (i64) {
    %root = buffer.constant utf8("prepare_factor") : buffer
    %tag = scalar.constant 0 : i64
    %command = func.call @stage(%root, %primary_execution, %tag) : (buffer, i32, i64) -> (i32)
    %bytes = scalar.constant 4 : i64
    scf.yield %bytes : i64
  } else {
    %bytes = scalar.constant 0 : i64
    scf.yield %bytes : i64
  }
  func.return %bytes : i64
}
