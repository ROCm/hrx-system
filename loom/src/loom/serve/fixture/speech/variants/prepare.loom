func.decl import("prepare") @stage(%root: buffer, %execution: i32, %tag: i64) -> (i32)

func.decl import("prepare") @source(%directory: buffer, %path: buffer) -> (i32)

func.decl import("prepare") @source_append(%source: i32, %directory: buffer, %path: buffer)

func.decl import("prepare") @parameter(%stage: i32, %binding: i32, %owner: i32, %input: i32, %source: i32, %policy: buffer)

func.decl import("json") @members(%json: buffer) -> (buffer, i32, i64)

func.decl import("input") @require(%condition: i32, %diagnostic: buffer)

func.def public @prepare(%directory: buffer, %options: buffer) -> (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, buffer, buffer, buffer, buffer) {
  %primary_execution = scalar.constant 0 : i32
  %c0_source = scalar.constant 0 : i32
  %c0 = scalar.constant 0 : i64
  %c1 = scalar.constant 1 : i64
  %object_kind = scalar.constant 2 : i32
  %fields, %kind, %count = func.call @members(%options) : (buffer) -> (buffer, i32, i64)
  %object = scalar.cmpi eq, %kind, %object_kind : i32
  %empty = scalar.cmpi eq, %count, %c0 : i64
  %valid = scalar.andi %object, %empty : i1
  %valid32 = scalar.extui %valid : i1 to i32
  %diagnostic = buffer.constant utf8("speech fixture expects empty options") : buffer
  func.call @require(%valid32, %diagnostic) : (i32, buffer)
  %initialize = buffer.constant utf8("initialize_weighted_audio") : buffer
  %first = func.call @stage(%initialize, %primary_execution, %c0) : (buffer, i32, i64) -> (i32)
  %step = buffer.constant utf8("step_weighted_audio") : buffer
  %second = func.call @stage(%step, %primary_execution, %c1) : (buffer, i32, i64) -> (i32)
  %binding0 = scalar.constant 0 : i32
  %binding1 = scalar.constant 1 : i32
  %binding2 = scalar.constant 2 : i32
  %binding3 = scalar.constant 3 : i32
  %weights = buffer.constant utf8("weights.safetensors") : buffer
  %phases = buffer.constant utf8("phases.safetensors") : buffer
  %voices = buffer.constant utf8("voices.safetensors") : buffer
  %policy = buffer.constant utf8("variants/policy.loom") : buffer
  %identity = buffer.constant utf8("variants/identity.loom") : buffer
  %empty_buffer = buffer.constant utf8("") : buffer
  // Declaration order is independent of each command's fixed binding order.
  // The raw base factor has a different preparation policy and storage owner.
  %voice_source = func.call @source(%directory, %voices) : (buffer, buffer) -> (i32)
  %raw_source = func.call @source(%directory, %weights) : (buffer, buffer) -> (i32)
  %packed_source = func.call @source(%directory, %weights) : (buffer, buffer) -> (i32)
  func.call @source_append(%packed_source, %directory, %phases) : (i32, buffer, buffer)
  func.call @parameter(%first, %binding2, %primary_execution, %c0_source, %voice_source, %policy) : (i32, i32, i32, i32, i32, buffer)
  func.call @parameter(%first, %binding3, %primary_execution, %c0_source, %raw_source, %identity) : (i32, i32, i32, i32, i32, buffer)
  func.call @parameter(%first, %binding1, %primary_execution, %c0_source, %packed_source, %policy) : (i32, i32, i32, i32, i32, buffer)
  func.call @parameter(%first, %binding0, %primary_execution, %c0_source, %packed_source, %policy) : (i32, i32, i32, i32, i32, buffer)
  func.call @parameter(%second, %binding1, %primary_execution, %c0_source, %packed_source, %policy) : (i32, i32, i32, i32, i32, buffer)
  func.call @parameter(%second, %binding0, %primary_execution, %c0_source, %packed_source, %policy) : (i32, i32, i32, i32, i32, buffer)
  %rows = scalar.constant 4 : i64
  %work_bytes = scalar.constant 64 : i64
  %input = scalar.constant 16 : i64
  %conditioning_bytes = scalar.constant 8 : i64
  %stream = scalar.constant 16 : i64
  %output = scalar.constant 144 : i64
  %frames = scalar.constant 5 : i64
  %rate = scalar.constant 24000 : i64
  %name = buffer.constant utf8("fixture-weighted-speech") : buffer
  %tokenizer = buffer.constant utf8("tokenizer.json") : buffer
  func.return %rows, %rows, %input, %conditioning_bytes, %stream, %work_bytes, %output, %output, %frames, %rate, %c1, %tokenizer, %name, %empty_buffer, %empty_buffer : i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, buffer, buffer, buffer, buffer
}
