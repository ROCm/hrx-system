func.decl import("prepare") @stage(%root: buffer, %execution: i32, %tag: i64) -> (i32)

func.decl import("json") @members(%json: buffer) -> (buffer, i32, i64)

func.decl import("input") @require(%condition: i32, %diagnostic: buffer)

// Two immutable conditioning entries are shared across independent streams.
global.rodata.def @conditioning = bytes("0000003e000000be")

func.def public @prepare(%directory: buffer, %options: buffer) -> (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, buffer, buffer, buffer, buffer) {
  %primary_execution = scalar.constant 0 : i32
  %c0 = scalar.constant 0 : i64
  %c1 = scalar.constant 1 : i64
  %object_kind = scalar.constant 2 : i32
  %fields, %kind, %count = func.call @members(%options) : (buffer) -> (buffer, i32, i64)
  %object = scalar.cmpi eq, %kind, %object_kind : i32
  %empty = scalar.cmpi eq, %count, %c0 : i64
  %valid = scalar.andi %object, %empty : i1
  %valid32 = scalar.extui %valid : i1 to i32
  %diagnostic = buffer.constant utf8("speech fixture expects empty options") : buffer
  func.call @require(%valid32, %diagnostic) : (i32, buffer)
  %initialize = buffer.constant utf8("initialize_audio") : buffer
  %first = func.call @stage(%initialize, %primary_execution, %c0) : (buffer, i32, i64) -> (i32)
  %step = buffer.constant utf8("step_audio") : buffer
  %second = func.call @stage(%step, %primary_execution, %c1) : (buffer, i32, i64) -> (i32)
  %rows = scalar.constant 4 : i64
  %work_bytes = scalar.constant 64 : i64
  %input = scalar.constant 16 : i64
  %conditioning_bytes = scalar.constant 8 : i64
  %stream = scalar.constant 16 : i64
  %output = scalar.constant 144 : i64
  %frames = scalar.constant 5 : i64
  %rate = scalar.constant 24000 : i64
  %empty_buffer = buffer.constant utf8("") : buffer
  %name = buffer.constant utf8("fixture-speech") : buffer
  %conditioning = global.load @conditioning : buffer
  func.return %rows, %rows, %input, %conditioning_bytes, %stream, %work_bytes, %output, %output, %frames, %rate, %c1, %empty_buffer, %name, %empty_buffer, %conditioning : i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, buffer, buffer, buffer, buffer
}
