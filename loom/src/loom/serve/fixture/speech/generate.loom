target.decl @speech_target

// Conditioning and mutable stream position are distinct buffers. Blocks
// alternate three and five frames; the second block emits no frames without
// ending the stream. Every output sample and live header field is overwritten.
kernel.def target(@speech_target) @audio_block() {
  %c1 = index.constant 1 : index
  %rows = index.constant 4 : index
  kernel.launch.config workgroups(%rows, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%work: buffer, %request: buffer, %conditioning: buffer, %state: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %ordinal = kernel.workgroup.id<x> : index
  %work_header = buffer.view %work[%origin] : buffer -> view<2xi32>
  %count32 = view.load %work_header[0] : view<2xi32> -> i32
  %count = index.cast %count32 : i32 to index
  %selected = index.cmp ult, %ordinal, %count : index
  scf.if %selected {
    %map_offset = index.constant 8 : offset
    %map = buffer.view %work[%map_offset] : buffer -> view<4xi32>
    %row32 = view.load %map[%ordinal] : view<4xi32> -> i32
    %bounded_row = scalar.assume %row32 [range(%row32, 0, 3)] : i32
    %row = index.cast %bounded_row : i32 to index
    %row_stride = index.constant 16 : offset
    %row_offset = index.scale %row, %row_stride : index, offset -> offset
    %output_stride = index.constant 36 : offset
    %output_offset = index.scale %ordinal, %output_stride : index, offset -> offset
    %input = buffer.view %request[%row_offset] : buffer -> view<4xi32>
    %voice = buffer.view %conditioning[%origin] : buffer -> view<2xf32>
    %stream = buffer.view %state[%row_offset] : buffer -> view<2xi32>
    %header = buffer.view %output[%output_offset] : buffer -> view<4xi32>
    %header_bytes = index.constant 16 : offset
    %samples_offset = index.add %output_offset, %header_bytes : offset
    %samples = buffer.view %output[%samples_offset] : buffer -> view<5xf32>
    %total = view.load %input[0] : view<4xi32> -> i32
    %seed = view.load %input[1] : view<4xi32> -> i32
    %position = view.load %stream[0] : view<2xi32> -> i32
    %block = view.load %stream[1] : view<2xi32> -> i32
    %voice_id = view.load %input[2] : view<4xi32> -> i32
    %positive = view.load %voice[0] : view<2xf32> -> f32
    %negative = view.load %voice[1] : view<2xf32> -> f32
    %voice_zero = scalar.constant 0 : i32
    %is_positive = scalar.cmpi eq, %voice_id, %voice_zero : i32
    %gain = scf.select %is_positive, %positive, %negative : f32
    %c0 = scalar.constant 0 : i32
    %c1 = scalar.constant 1 : i32
    %short_block = scalar.constant 3 : i32
    %long_block = scalar.constant 5 : i32
    %phase_mask = scalar.constant 7 : i32
    %bit = scalar.andi %block, %c1 : i32
    %odd = scalar.cmpi ne, %bit, %c0 : i32
    %normal_capacity = scf.select %odd, %long_block, %short_block : i32
    %empty = scalar.cmpi eq, %block, %c1 : i32
    %capacity = scf.select %empty, %c0, %normal_capacity : i32
    %remaining = scalar.subi %total, %position : i32
    %less = scalar.cmpi ult, %remaining, %capacity : i32
    %count = scf.select %less, %remaining, %capacity : i32
    %next = scalar.addi %position, %count : i32
    %last = scalar.cmpi eq, %next, %total : i32
    %done = scalar.extui %last : i1 to i32
    view.store %position, %header[0] : i32, view<4xi32>
    view.store %count, %header[1] : i32, view<4xi32>
    view.store %done, %header[2] : i32, view<4xi32>
    view.store %c0, %header[3] : i32, view<4xi32>
    %start = index.constant 0 : index
    %end = index.constant 5 : index
    %step = index.constant 1 : index
    scf.for %i = [%start to %end step %step] {
      %i32 = index.cast %i : index to i32
      %live = scalar.cmpi ult, %i32, %count : i32
      %absolute = scalar.addi %position, %i32 : i32
      %shifted = scalar.addi %absolute, %seed : i32
      %phase = scalar.andi %shifted, %phase_mask : i32
      %value = scalar.uitofp %phase : i32 to f32
      %normalized = scalar.mulf %value, %gain : f32
      %silence = scalar.constant 0.0 : f32
      %sample = scf.select %live, %normalized, %silence : f32
      view.store %sample, %samples[%i] : f32, view<5xf32>
    }
    %next_block = scalar.addi %block, %c1 : i32
    view.store %next, %stream[0] : i32, view<2xi32>
    view.store %next_block, %stream[1] : i32, view<2xi32>
  }
  kernel.return
}

kernel.def target(@speech_target) @publish_block() {
  %c1 = index.constant 1 : index
  %rows = index.constant 4 : index
  kernel.launch.config workgroups(%rows, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%work: buffer, %intermediate: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %ordinal = kernel.workgroup.id<x> : index
  %work_header = buffer.view %work[%origin] : buffer -> view<2xi32>
  %count32 = view.load %work_header[0] : view<2xi32> -> i32
  %count = index.cast %count32 : i32 to index
  %selected = index.cmp ult, %ordinal, %count : index
  scf.if %selected {
    %output_stride = index.constant 36 : offset
    %output_offset = index.scale %ordinal, %output_stride : index, offset -> offset
    %source = buffer.view %intermediate[%output_offset] : buffer -> view<9xi32>
    %target = buffer.view %output[%output_offset] : buffer -> view<9xi32>
    %begin = index.constant 0 : index
    %end = index.constant 9 : index
    %step = index.constant 1 : index
    scf.for %i = [%begin to %end step %step] {
      %value = view.load %source[%i] : view<9xi32> -> i32
      view.store %value, %target[%i] : i32, view<9xi32>
    }
  }
  kernel.return
}

// Compiler-private workspace lasts for both kernels in this command. The
// separate stream bank carries only state needed by the next command.
command.def public @step_audio() launch(%work: buffer, %request: buffer, %conditioning: buffer, %state: buffer, %output: buffer) {
  %length = index.constant 144 : offset
  %intermediate = buffer.alloca<global> align(16) %length : buffer
  kernel.launch @audio_block(%work, %request, %conditioning, %state, %intermediate) : (buffer, buffer, buffer, buffer, buffer)
  kernel.launch @publish_block(%work, %intermediate, %output) : (buffer, buffer, buffer)
  command.return
}

// Fresh mutable state is initialized by model source, never allocator contents.
kernel.def target(@speech_target) @initialize() {
  %c1 = index.constant 1 : index
  %rows = index.constant 4 : index
  kernel.launch.config workgroups(%rows, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%work: buffer, %request: buffer, %conditioning: buffer, %state: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %ordinal = kernel.workgroup.id<x> : index
  %work_header = buffer.view %work[%origin] : buffer -> view<2xi32>
  %count32 = view.load %work_header[0] : view<2xi32> -> i32
  %count = index.cast %count32 : i32 to index
  %selected = index.cmp ult, %ordinal, %count : index
  scf.if %selected {
    %map_offset = index.constant 8 : offset
    %map = buffer.view %work[%map_offset] : buffer -> view<4xi32>
    %row32 = view.load %map[%ordinal] : view<4xi32> -> i32
    %bounded_row = scalar.assume %row32 [range(%row32, 0, 3)] : i32
    %row = index.cast %bounded_row : i32 to index
    %row_stride = index.constant 16 : offset
    %row_offset = index.scale %row, %row_stride : index, offset -> offset
    %stream = buffer.view %state[%row_offset] : buffer -> view<2xi32>
    %c0 = scalar.constant 0 : i32
    view.store %c0, %stream[0] : i32, view<2xi32>
    view.store %c0, %stream[1] : i32, view<2xi32>
  }
  kernel.return
}

command.def public @initialize_audio() launch(%work: buffer, %request: buffer, %conditioning: buffer, %state: buffer, %output: buffer) {
  kernel.launch @initialize(%work, %request, %conditioning, %state, %output) : (buffer, buffer, buffer, buffer, buffer)
  command.return
}
