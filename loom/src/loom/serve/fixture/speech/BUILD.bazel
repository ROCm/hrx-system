load("//loom/build_tools/bazel:loom_library.bzl", "loom_library")
load("//loom/build_tools/bazel:loom_model.bzl", "loom_model")
load(":sources.bzl", "SOURCE_FILES", "VARIANT_FILES")

package(default_visibility = ["//visibility:private"])

exports_files(
    SOURCE_FILES + VARIANT_FILES,
    visibility = ["//visibility:public"],
)

[
    loom_model(
        name = "card_model_" + encoding,
        assets = {"variants/tokenizer.json": "vocabulary.data"},
        card = "card.json",
        encoding = encoding,
        files = {
            "control.loom": "control.loom",
            "generate.loom": "generate.loom",
            "prepare.loom": "prepare.loom",
            "service.loom": "service.loom",
        },
        model_name = "speech",
        preset = "check",
        tags = ["skip-bazel_to_cmake"],
        visibility = ["//visibility:public"],
    )
    for encoding in [
        "text",
        "bc",
    ]
]

loom_library(
    name = "voice_numerics",
    srcs = [
        "generate.loom",
        "voice_generate.loom",
    ],
)

[
    loom_model(
        name = "voice_card_model_" + name,
        card = "voice_card.json",
        encoding = encoding,
        files = {
            "control.loom": "control.loom",
            "prepare.loom": "prepare.loom",
            "voice_service.loom": "voice_service.loom",
        } | ({":voice_numerics": "voice_numerics.loombc"} if programs == "mixed" else {
            "generate.loom": "generate.loom",
            "voice_generate.loom": "voice_generate.loom",
        }),
        model_name = "speech",
        preset = "check",
        programs = programs,
        tags = ["skip-bazel_to_cmake"],
        visibility = ["//visibility:public"],
    )
    for name, encoding, programs in [
        ("text", "text", "fixture"),
        ("bc", "bc", "fixture"),
        ("mixed", "preserve", "mixed"),
    ]
]

[
    loom_model(
        name = "stock_voice_card_model_" + name,
        assets = {
            "negative.data": "negative.data",
            "positive.data": "positive.data",
        },
        card = "stock_voice_card.json",
        encoding = encoding,
        files = {
            "control.loom": "control.loom",
            "prepare.loom": "prepare.loom",
            "voice_service.loom": "voice_service.loom",
        } | ({":voice_numerics": "voice_numerics.loombc"} if programs == "mixed" else {
            "generate.loom": "generate.loom",
            "voice_generate.loom": "voice_generate.loom",
        }),
        model_name = "speech",
        preset = "check",
        programs = programs,
        tags = ["skip-bazel_to_cmake"],
        visibility = ["//visibility:public"],
    )
    for name, encoding, programs in [
        ("text", "text", "fixture"),
        ("bc", "bc", "fixture"),
        ("mixed", "preserve", "mixed"),
    ]
]
