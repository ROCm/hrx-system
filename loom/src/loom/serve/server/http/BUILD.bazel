load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test")

package(
    default_visibility = ["//loom/src/loom/serve:implementation"],
    features = ["layering_check"],
    licenses = ["notice"],
)

loom_cc_library(
    name = "tokenization",
    srcs = ["tokenization.c"],
    hdrs = ["tokenization.h"],
    deps = [
        "//loom/src/loom/util:json",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:json",
        "//runtime/src/iree/base/internal:unicode",
        "//runtime/src/iree/tokenizer",
        "//runtime/src/iree/tokenizer/vocab",
    ],
)

loom_cc_library(
    name = "logs",
    srcs = ["logs.c"],
    hdrs = ["logs.h"],
    deps = [
        "//loom/src/loom/serve/telemetry:stream",
        "//loom/src/loom/util:json",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/base",
    ],
)

loom_cc_test(
    name = "logs_test",
    srcs = ["logs_test.cc"],
    deps = [
        ":logs",
        "//loom/src/loom/serve/telemetry:stream",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_test(
    name = "tokenization_test",
    srcs = ["tokenization_test.cc"],
    deps = [
        ":tokenization",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
        "//runtime/src/iree/tokenizer",
        "//runtime/src/iree/tokenizer/format/huggingface:tokenizer_json",
    ],
)
