command.program.def public @advance() launch(%storage: buffer) {
  kernel.launch @increment_0(%storage) : (buffer)
  kernel.launch @increment_1(%storage) : (buffer)
  kernel.launch @increment_2(%storage) : (buffer)
  kernel.launch @increment_3(%storage) : (buffer)
  kernel.launch @increment_4(%storage) : (buffer)
  kernel.launch @increment_5(%storage) : (buffer)
  kernel.launch @increment_6(%storage) : (buffer)
  kernel.launch @increment_7(%storage) : (buffer)
  command.return
}

// A second command changes parent slots and repeats one cached native root.
command.program.def public @selected_pair() launch(%storage: buffer) {
  kernel.launch @increment_7(%storage) : (buffer)
  kernel.launch @increment_2(%storage) : (buffer)
  kernel.launch @increment_7(%storage) : (buffer)
  command.return
}

kernel.def target(@wave32) @temporary_write() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%storage: buffer, %temporary: buffer) {
  %c0 = index.constant 0 : offset
  %bytes = config.get @increment.temporary_bytes : offset
  %byte_count = index.cast %bytes : offset to index
  %c4 = index.constant 4 : index
  %elements = index.div %byte_count, %c4 : index
  %c8 = index.constant 8 : index
  %tail = index.sub %elements, %c8 : index
  %input = buffer.view %storage[%c0] : buffer -> view<8xi32>
  %output = buffer.view %temporary[%c0] : buffer -> view<[%elements]xi32>
  %begin = index.constant 0 : index
  %c1 = index.constant 1 : index
  scf.for %i = [%begin to %c8 step %c1] {
    %value = view.load %input[%i] : view<8xi32> -> i32
    %destination = index.add %tail, %i : index
    view.store %value, %output[%destination] : i32, view<[%elements]xi32>
  }
  kernel.return
}

kernel.def target(@wave32) @temporary_read() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%temporary: buffer, %storage: buffer) {
  %c0 = index.constant 0 : offset
  %bytes = config.get @increment.temporary_bytes : offset
  %byte_count = index.cast %bytes : offset to index
  %c4 = index.constant 4 : index
  %elements = index.div %byte_count, %c4 : index
  %c8 = index.constant 8 : index
  %tail = index.sub %elements, %c8 : index
  %input = buffer.view %temporary[%c0] : buffer -> view<[%elements]xi32>
  %output = buffer.view %storage[%c0] : buffer -> view<8xi32>
  %delta = config.get @increment.delta : index
  %delta_i32 = index.cast %delta : index to i32
  %begin = index.constant 0 : index
  %c1 = index.constant 1 : index
  scf.for %i = [%begin to %c8 step %c1] {
    %source = index.add %tail, %i : index
    %value = view.load %input[%source] : view<[%elements]xi32> -> i32
    %sum = scalar.addi %value, %delta_i32 : i32
    view.store %sum, %output[%i] : i32, view<8xi32>
  }
  kernel.return
}

command.program.def public @temporary_advance() launch(%storage: buffer) {
  %bytes = config.get @increment.temporary_bytes : offset
  %temporary = buffer.alloca<global> align(16) %bytes : buffer
  kernel.launch @temporary_write(%storage, %temporary) : (buffer, buffer)
  kernel.launch @temporary_read(%temporary, %storage) : (buffer, buffer)
  command.return
}

// A CPU import cannot be resolved by native GPU compilation. Keeping this in a
// separate root exercises failure after the command product publishes its work.
func.decl import("host") @host_only(%value: i32) -> (i32)

kernel.def target(@wave32) @requires_host() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%storage: buffer) {
  %c0 = index.constant 0 : offset
  %data = buffer.view %storage[%c0] : buffer -> view<8xi32>
  %value = view.load %data[0] : view<8xi32> -> i32
  %result = func.call @host_only(%value) : (i32) -> (i32)
  view.store %result, %data[0] : i32, view<8xi32>
  kernel.return
}

command.program.def public @invalid_native() launch(%storage: buffer) {
  kernel.launch @increment_0(%storage) : (buffer)
  kernel.launch @increment_1(%storage) : (buffer)
  kernel.launch @increment_2(%storage) : (buffer)
  kernel.launch @increment_3(%storage) : (buffer)
  kernel.launch @increment_4(%storage) : (buffer)
  kernel.launch @increment_5(%storage) : (buffer)
  kernel.launch @increment_6(%storage) : (buffer)
  kernel.launch @increment_7(%storage) : (buffer)
  kernel.launch @requires_host(%storage) : (buffer)
  command.return
}

command.program.def public @idle() launch() {
  command.return
}

command.program.def public @ambiguous() launch() {
  command.return
}
