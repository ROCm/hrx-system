func.decl import("prepare") @stage(%root: buffer, %tag: i64) -> (i32)

func.decl import("prepare") @dispatch(%root: buffer, %tag: i64) -> (i32)

func.decl import("prepare") @config(%stage: i32, %key: buffer, %value: buffer)

func.decl import("prepare") @config_i64(%stage: i32, %key: buffer, %value: i64)

func.decl import("prepare") @source(%directory: buffer, %path: buffer) -> (i32)

func.decl import("prepare") @source_append(%source: i32, %directory: buffer, %path: buffer)

func.decl import("prepare") @source_scope(%scope: buffer) -> (i32)

func.decl import("prepare") @parameter(%stage: i32, %binding: i32, %input: i32, %source: i32, %policy: buffer)

func.decl import("prepare") @workspace_limit(%stage: i32, %bytes: i64)

func.decl import("prepare") @memory_forecast(%root: buffer)

global.rodata.def @empty_forecast = bytes("")

// One entry exercises the cold declaration boundary without compiling a new
// VM program for each capability, ownership, or malformed-string case.
func.def public @declare_forecast(%mode: i32) {
  %empty_mode = scalar.constant 1 : i32
  %nul_mode = scalar.constant 2 : i32
  %duplicate_mode = scalar.constant 3 : i32
  %alternate_mode = scalar.constant 4 : i32
  %normal = global.load @root : buffer
  %empty = global.load @empty_forecast : buffer
  %nul = global.load @nul : buffer
  %alternate = global.load @key : buffer
  %is_empty = scalar.cmpi eq, %mode, %empty_mode : i32
  %is_nul = scalar.cmpi eq, %mode, %nul_mode : i32
  %is_duplicate = scalar.cmpi eq, %mode, %duplicate_mode : i32
  %is_alternate = scalar.cmpi eq, %mode, %alternate_mode : i32
  %selected = scf.select %is_empty, %empty, %normal : buffer
  %checked = scf.select %is_nul, %nul, %selected : buffer
  %root = scf.select %is_alternate, %alternate, %checked : buffer
  func.call @memory_forecast(%root) : (buffer)
  scf.if %is_duplicate {
    func.call @memory_forecast(%root) : (buffer)
  }
  %tag = scalar.constant 0 : i64
  %stage = func.call @stage(%normal, %tag) : (buffer, i64) -> (i32)
  func.return
}

// stage_root
global.rodata.def @root = bytes("73746167655f726f6f74")

// feature.enabled
global.rodata.def @key = bytes("666561747572652e656e61626c6564")

// true
global.rodata.def @value = bytes("74727565")

// /checkpoints
global.rodata.def @directory = bytes("2f636865636b706f696e7473")

// model.safetensors
global.rodata.def @path = bytes("6d6f64656c2e7361666574656e736f7273")

// weights.loom
global.rodata.def @policy = bytes("776569676874732e6c6f6f6d")

func.def public @text_config() {
  %root = global.load @root : buffer
  %tag = scalar.constant 0 : i64
  %stage = func.call @stage(%root, %tag) : (buffer, i64) -> (i32)
  %key = global.load @key : buffer
  %value = global.load @value : buffer
  func.call @config(%stage, %key, %value) : (i32, buffer, buffer)
  func.return
}

func.def public @missing_stage() {
  %stage = scalar.constant 0 : i32
  %key = global.load @key : buffer
  %value = global.load @value : buffer
  func.call @config(%stage, %key, %value) : (i32, buffer, buffer)
  func.return
}

func.def public @direct_config() {
  %root = global.load @root : buffer
  %tag = scalar.constant 17 : i64
  %stage = func.call @dispatch(%root, %tag) : (buffer, i64) -> (i32)
  %key = global.load @key : buffer
  %value = global.load @value : buffer
  func.call @config(%stage, %key, %value) : (i32, buffer, buffer)
  func.return
}

func.def public @workspace_constrained() {
  %root = global.load @root : buffer
  %tag = scalar.constant 0 : i64
  %stage = func.call @stage(%root, %tag) : (buffer, i64) -> (i32)
  %bytes = scalar.constant 1073741824 : i64
  func.call @workspace_limit(%stage, %bytes) : (i32, i64)
  func.return
}

func.def public @missing_workspace_stage() {
  %stage = scalar.constant 0 : i32
  %bytes = scalar.constant 1 : i64
  func.call @workspace_limit(%stage, %bytes) : (i32, i64)
  func.return
}

func.def public @duplicate_workspace_limit() {
  %root = global.load @root : buffer
  %tag = scalar.constant 0 : i64
  %stage = func.call @stage(%root, %tag) : (buffer, i64) -> (i32)
  %bytes = scalar.constant 1 : i64
  func.call @workspace_limit(%stage, %bytes) : (i32, i64)
  func.call @workspace_limit(%stage, %bytes) : (i32, i64)
  func.return
}

func.def public @direct_workspace_limit() {
  %root = global.load @root : buffer
  %tag = scalar.constant 0 : i64
  %stage = func.call @dispatch(%root, %tag) : (buffer, i64) -> (i32)
  %bytes = scalar.constant 1 : i64
  func.call @workspace_limit(%stage, %bytes) : (i32, i64)
  func.return
}

func.def public @zero_workspace_limit() {
  %root = global.load @root : buffer
  %tag = scalar.constant 0 : i64
  %stage = func.call @stage(%root, %tag) : (buffer, i64) -> (i32)
  %bytes = scalar.constant 0 : i64
  func.call @workspace_limit(%stage, %bytes) : (i32, i64)
  func.return
}

func.def public @negative_workspace_limit() {
  %root = global.load @root : buffer
  %tag = scalar.constant 0 : i64
  %stage = func.call @stage(%root, %tag) : (buffer, i64) -> (i32)
  %bytes = scalar.constant -1 : i64
  func.call @workspace_limit(%stage, %bytes) : (i32, i64)
  func.return
}

func.def public @direct_parameter() {
  %c0_source = scalar.constant 0 : i32
  %root = global.load @root : buffer
  %tag = scalar.constant 0 : i64
  %stage = func.call @dispatch(%root, %tag) : (buffer, i64) -> (i32)
  %c0 = scalar.constant 0 : i32
  %directory = global.load @directory : buffer
  %path = global.load @path : buffer
  %policy = global.load @policy : buffer
  %source = func.call @source(%directory, %path) : (buffer, buffer) -> (i32)
  func.call @parameter(%stage, %c0, %c0_source, %source, %policy) : (i32, i32, i32, i32, buffer)
  func.return
}

func.def public @conflicting_parameter_policy() {
  %c0_source = scalar.constant 0 : i32
  %root = global.load @root : buffer
  %tag = scalar.constant 0 : i64
  %stage = func.call @stage(%root, %tag) : (buffer, i64) -> (i32)
  %c0 = scalar.constant 0 : i32
  %directory = global.load @directory : buffer
  %path = global.load @path : buffer
  %policy = global.load @policy : buffer
  %source = func.call @source(%directory, %path) : (buffer, buffer) -> (i32)
  func.call @parameter(%stage, %c0, %c0_source, %source, %policy) : (i32, i32, i32, i32, buffer)
  func.call @parameter(%stage, %c0, %c0_source, %source, %path) : (i32, i32, i32, i32, buffer)
  func.return
}

func.def public @no_stages() {
  func.return
}

func.def public @many_sources() {
  %root = global.load @root : buffer
  %tag = scalar.constant 0 : i64
  %stage = func.call @stage(%root, %tag) : (buffer, i64) -> (i32)
  %binding = scalar.constant 0 : i32
  %directory = global.load @directory : buffer
  %path = global.load @path : buffer
  %policy = global.load @policy : buffer
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %count = index.constant 33 : index
  scf.for %i = [%c0 to %count step %c1] {
    %input = index.cast %i : index to i32
    %source = func.call @source(%directory, %path) : (buffer, buffer) -> (i32)
    func.call @parameter(%stage, %binding, %input, %source, %policy) : (i32, i32, i32, i32, buffer)
    func.call @source_append(%source, %directory, %policy) : (i32, buffer, buffer)
  }
  func.return
}

func.def @invalid_input(%input: i32) {
  %root = global.load @root : buffer
  %tag = scalar.constant 0 : i64
  %stage = func.call @stage(%root, %tag) : (buffer, i64) -> (i32)
  %binding = scalar.constant 0 : i32
  %directory = global.load @directory : buffer
  %path = global.load @path : buffer
  %policy = global.load @policy : buffer
  %source = func.call @source(%directory, %path) : (buffer, buffer) -> (i32)
  func.call @parameter(%stage, %binding, %input, %source, %policy) : (i32, i32, i32, i32, buffer)
  func.return
}

func.def public @sparse_input() {
  %input = scalar.constant 1 : i32
  func.call @invalid_input(%input) : (i32)
  func.return
}

func.def public @negative_input() {
  %input = scalar.constant -1 : i32
  func.call @invalid_input(%input) : (i32)
  func.return
}

func.def public @request_stages(%tag: i64) -> (i32, i32) {
  %root = global.load @root : buffer
  %key = global.load @key : buffer
  %command = func.call @stage(%root, %tag) : (buffer, i64) -> (i32)
  %direct = func.call @dispatch(%root, %tag) : (buffer, i64) -> (i32)
  func.call @config_i64(%command, %key, %tag) : (i32, buffer, i64)
  func.call @config_i64(%direct, %key, %tag) : (i32, buffer, i64)
  %workspace = scalar.constant 4096 : i64
  func.call @workspace_limit(%command, %workspace) : (i32, i64)
  func.return %command, %direct : i32, i32
}

func.def public @configure_cold_stage() {
  %root = global.load @root : buffer
  %tag = scalar.constant 0 : i64
  %stage = func.call @stage(%root, %tag) : (buffer, i64) -> (i32)
  func.call @missing_stage() : ()
  func.return
}

// Crosses multiple growth boundaries on each independently owned array.
// The key buffer is reused; every declaration must own its copied spelling.
func.def public @large_catalog() {
  %c0_source = scalar.constant 0 : i32
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %count = index.constant 33 : index
  %c10 = index.constant 10 : index
  %digit_zero = scalar.constant 48 : i8
  %letter_k = scalar.constant 107 : i8
  %origin = index.constant 0 : offset
  %key_bytes = index.constant 3 : offset
  %key = buffer.alloca<private> align(1) %key_bytes : buffer
  %key_view = buffer.view %key[%origin] : buffer -> view<3xi8>
  view.store %letter_k, %key_view[0] : i8, view<3xi8>
  %root = global.load @root : buffer
  %directory = global.load @directory : buffer
  %path = global.load @path : buffer
  %policy = global.load @policy : buffer
  scf.for %i = [%c0 to %count step %c1] {
    %tag = index.cast %i : index to i64
    %stage = func.call @stage(%root, %tag) : (buffer, i64) -> (i32)
    scf.for %j = [%c0 to %count step %c1] {
      %tens = index.div %j, %c10 : index
      %ones = index.rem %j, %c10 : index
      %tens_byte = index.cast %tens : index to i8
      %ones_byte = index.cast %ones : index to i8
      %first = scalar.addi %tens_byte, %digit_zero : i8
      %second = scalar.addi %ones_byte, %digit_zero : i8
      view.store %first, %key_view[1] : i8, view<3xi8>
      view.store %second, %key_view[2] : i8, view<3xi8>
      %value = index.cast %j : index to i64
      %binding = index.cast %j : index to i32
      func.call @config_i64(%stage, %key, %value) : (i32, buffer, i64)
      %source = func.call @source(%directory, %path) : (buffer, buffer) -> (i32)
      func.call @source_append(%source, %directory, %key) : (i32, buffer, buffer)
      func.call @parameter(%stage, %binding, %c0_source, %source, %policy) : (i32, i32, i32, i32, buffer)
      func.call @source_append(%source, %directory, %policy) : (i32, buffer, buffer)
    }
  }
  func.return
}

// Each string position crosses the same native declaration boundary.
global.rodata.def @nul = bytes("610062")

func.def public @nul_string(%field: i32) {
  %c0_source = scalar.constant 0 : i32
  %nul = global.load @nul : buffer
  %root = global.load @root : buffer
  %key = global.load @key : buffer
  %value = global.load @value : buffer
  %directory = global.load @directory : buffer
  %path = global.load @path : buffer
  %policy = global.load @policy : buffer
  %tag = scalar.constant 0 : i64
  %c0 = scalar.constant 0 : i32
  %field_root = scalar.constant 0 : i32
  %is_root = scalar.cmpi eq, %field, %field_root : i32
  %selected_root = scf.select %is_root, %nul, %root : buffer
  %field_key = scalar.constant 1 : i32
  %is_key = scalar.cmpi eq, %field, %field_key : i32
  %selected_key = scf.select %is_key, %nul, %key : buffer
  %field_value = scalar.constant 2 : i32
  %is_value = scalar.cmpi eq, %field, %field_value : i32
  %selected_value = scf.select %is_value, %nul, %value : buffer
  %field_directory = scalar.constant 3 : i32
  %is_directory = scalar.cmpi eq, %field, %field_directory : i32
  %selected_directory = scf.select %is_directory, %nul, %directory : buffer
  %field_path = scalar.constant 4 : i32
  %is_path = scalar.cmpi eq, %field, %field_path : i32
  %selected_path = scf.select %is_path, %nul, %path : buffer
  %field_policy = scalar.constant 5 : i32
  %is_policy = scalar.cmpi eq, %field, %field_policy : i32
  %selected_policy = scf.select %is_policy, %nul, %policy : buffer
  %stage = func.call @stage(%selected_root, %tag) : (buffer, i64) -> (i32)
  func.call @config(%stage, %selected_key, %selected_value) : (i32, buffer, buffer)
  %source = func.call @source(%selected_directory, %selected_path) : (buffer, buffer) -> (i32)
  func.call @parameter(%stage, %c0, %c0_source, %source, %selected_policy) : (i32, i32, i32, i32, buffer)
  func.return
}

// One checkpoint supplies several resident bindings and remains independently
// addressable. Appending after binding must update every finalized shard view.
func.def public @shared_source(%path: buffer) -> (i32) {
  %directory = global.load @directory : buffer
  %source = func.call @source(%directory, %path) : (buffer, buffer) -> (i32)
  %root = global.load @root : buffer
  %policy = global.load @policy : buffer
  %tag = scalar.constant 0 : i64
  %first = func.call @stage(%root, %tag) : (buffer, i64) -> (i32)
  %second = func.call @stage(%root, %tag) : (buffer, i64) -> (i32)
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  func.call @parameter(%first, %c0, %c0, %source, %policy) : (i32, i32, i32, i32, buffer)
  func.call @parameter(%first, %c1, %c0, %source, %policy) : (i32, i32, i32, i32, buffer)
  func.call @parameter(%second, %c0, %c0, %source, %policy) : (i32, i32, i32, i32, buffer)
  func.call @source_append(%source, %directory, %policy) : (i32, buffer, buffer)
  func.return %source : i32
}

func.def public @scoped_source(%scope: buffer) -> (i32) {
  %source = func.call @source_scope(%scope) : (buffer) -> (i32)
  func.return %source : i32
}

// Runtime-only sources have no resident parameter root or preparation policy.
func.def public @cold_source(%path: buffer) -> (i32) {
  %directory = global.load @directory : buffer
  %source = func.call @source(%directory, %path) : (buffer, buffer) -> (i32)
  %root = global.load @root : buffer
  %tag = scalar.constant 0 : i64
  %stage = func.call @dispatch(%root, %tag) : (buffer, i64) -> (i32)
  func.return %source : i32
}

func.def public @bind_source(%source: i32) {
  %root = global.load @root : buffer
  %policy = global.load @policy : buffer
  %tag = scalar.constant 0 : i64
  %stage = func.call @stage(%root, %tag) : (buffer, i64) -> (i32)
  %c0 = scalar.constant 0 : i32
  func.call @parameter(%stage, %c0, %c0, %source, %policy) : (i32, i32, i32, i32, buffer)
  func.return
}

func.def public @append_source(%source: i32) {
  %directory = global.load @directory : buffer
  %path = global.load @path : buffer
  func.call @source_append(%source, %directory, %path) : (i32, buffer, buffer)
  func.return
}

func.def public @duplicate_input() {
  %path = global.load @path : buffer
  %source = func.call @shared_source(%path) : (buffer) -> (i32)
  %c0 = scalar.constant 0 : i32
  %policy = global.load @policy : buffer
  func.call @parameter(%c0, %c0, %c0, %source, %policy) : (i32, i32, i32, i32, buffer)
  func.return
}
