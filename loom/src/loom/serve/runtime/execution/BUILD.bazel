load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test", "loom_config_compatible_with")

package(
    default_visibility = ["//loom/src/loom/serve:implementation"],
    features = ["layering_check"],
    licenses = ["notice"],
)

exports_files(
    [
        "retirement_test.cc",
    ],
    visibility = ["//loom/src/loom/serve:implementation"],
)

loom_cc_library(
    name = "workspace",
    srcs = ["workspace.c"],
    hdrs = ["workspace.h"],
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/base/threading:thread",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/memory:slab_cache",
        "//runtime/src/iree/hal/memory:tlsf_pool",
    ],
)

loom_cc_library(
    name = "execution",
    srcs = ["execution.c"],
    hdrs = ["execution.h"],
    deps = [
        ":retirement",
        ":workspace",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/hal",
    ],
)

loom_cc_library(
    name = "dispatch",
    srcs = ["dispatch.c"],
    hdrs = ["dispatch.h"],
    deps = [
        ":execution",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
    ],
)

loom_cc_test(
    name = "execution_test",
    srcs = ["execution_test.cc"],
    deps = [
        ":execution",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_test(
    name = "workspace_test",
    srcs = ["workspace_test.cc"],
    target_compatible_with = loom_config_compatible_with([
        "//runtime/config/hal:driver_task",
    ]),
    deps = [
        ":execution",
        ":workspace",
        "//loom/src/loom/serve/runtime/device",
        "//loom/src/loom/serve/runtime/host",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "retirement",
    srcs = ["retirement.c"],
    hdrs = ["retirement.h"],
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/hal",
    ],
)
