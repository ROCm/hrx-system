load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test")

package(
    default_visibility = ["//loom/src/loom/serve:implementation"],
    features = ["layering_check"],
    licenses = ["notice"],
)

exports_files(
    [
        "memory_test.cc",
        "relocation_test.cc",
        "snapshot_test.cc",
    ],
    visibility = ["//loom/src/loom/serve:implementation"],
)

loom_cc_library(
    name = "memory",
    srcs = ["memory.c"],
    hdrs = ["memory.h"],
    deps = [
        "//runtime/src/iree/async",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/hal",
    ],
)

loom_cc_library(
    name = "rows",
    srcs = ["rows.c"],
    hdrs = ["rows.h"],
    deps = [
        ":memory",
        "//loom/src/loom/serve/runtime/device",
        "//loom/src/loom/serve/runtime/execution",
        "//loom/src/loom/serve/runtime/execution:retirement",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
    ],
)

loom_cc_library(
    name = "block_pool",
    srcs = ["block_pool.c"],
    hdrs = ["block_pool.h"],
    deps = ["//runtime/src/iree/base"],
)

loom_cc_library(
    name = "relocation",
    srcs = ["relocation.c"],
    hdrs = ["relocation.h"],
    deps = [
        "//loom/src/loom/serve/runtime/execution",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
    ],
)

loom_cc_library(
    name = "snapshot",
    srcs = ["snapshot.c"],
    hdrs = ["snapshot.h"],
    deps = [
        "//loom/src/loom/serve/runtime/execution",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal",
        "//runtime/src/iree/hal",
    ],
)

loom_cc_test(
    name = "block_pool_test",
    srcs = ["block_pool_test.cc"],
    deps = [
        ":block_pool",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
