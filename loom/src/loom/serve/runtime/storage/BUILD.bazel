load("//build_tools/bazel:query.bzl", "iree_assert_dependency_boundary")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_benchmark", "loom_cc_library", "loom_cc_test", "loom_config_compatible_with")

package(
    default_visibility = ["//loom/src/loom/serve:implementation"],
    features = ["layering_check"],
    licenses = ["notice"],
)

exports_files(
    [
        "relocation_test.cc",
        "snapshot_test.cc",
    ],
    visibility = ["//loom/src/loom/serve:implementation"],
)

loom_cc_library(
    name = "virtual_pool",
    srcs = ["virtual_pool.c"],
    hdrs = ["virtual_pool.h"],
    deps = [
        ":memory",
        "//loom/src/loom/serve/runtime/host:wake",
        "//runtime/src/iree/async",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/memory:buffer_range",
    ],
)

loom_cc_library(
    name = "backing_directory",
    srcs = ["backing_directory.c"],
    hdrs = ["backing_directory.h"],
    visibility = ["//visibility:private"],
    deps = ["//runtime/src/iree/base"],
)

loom_cc_library(
    name = "memory",
    srcs = ["memory.c"],
    hdrs = ["memory.h"],
    deps = [
        ":backing_directory",
        "//loom/src/loom/runtime/storage:statistics",
        "//loom/src/loom/serve/runtime/host:wake",
        "//runtime/src/iree/async",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:atomic_slist",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/memory:slab_cache",
        "//runtime/src/iree/hal/memory:tlsf",
        "//runtime/src/iree/hal/memory:tlsf_pool",
    ],
)

loom_cc_library(
    name = "rows",
    srcs = ["rows.c"],
    hdrs = ["rows.h"],
    deps = [
        ":memory",
        "//loom/src/loom/serve/runtime/device",
        "//loom/src/loom/serve/runtime/execution",
        "//loom/src/loom/serve/runtime/execution:retirement",
        "//loom/src/loom/serve/runtime/parameter:residency",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
    ],
)

iree_assert_dependency_boundary(
    name = "memory_is_observation_free",
    forbidden_dependencies = [
        "//loom/src/loom/runtime/parameter:telemetry",
        "//loom/src/loom/runtime/storage:telemetry",
    ],
    forbidden_subtrees = [
        "//loom/src/loom/runtime/telemetry/...",
        "//loom/src/loom/serve/telemetry/...",
    ],
    message = "Storage ownership must not depend on telemetry observation or export",
    target = ":memory",
)

loom_cc_library(
    name = "block_pool",
    srcs = ["block_pool.c"],
    hdrs = ["block_pool.h"],
    deps = ["//runtime/src/iree/base"],
)

loom_cc_library(
    name = "relocation",
    srcs = ["relocation.c"],
    hdrs = ["relocation.h"],
    deps = [
        "//loom/src/loom/serve/runtime/execution",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
    ],
)

loom_cc_library(
    name = "snapshot",
    srcs = ["snapshot.c"],
    hdrs = ["snapshot.h"],
    deps = [
        "//loom/src/loom/serve/runtime/execution",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal",
        "//runtime/src/iree/hal",
    ],
)

loom_cc_test(
    name = "backing_directory_test",
    srcs = ["backing_directory_test.cc"],
    deps = [
        ":backing_directory",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_benchmark(
    name = "backing_directory_benchmark",
    srcs = ["backing_directory_benchmark.cc"],
    deps = [
        ":backing_directory",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:benchmark_main",
    ],
)

loom_cc_test(
    name = "block_pool_test",
    srcs = ["block_pool_test.cc"],
    deps = [
        ":block_pool",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "memory_tests",
    testonly = True,
    srcs = [
        "memory_failure_test.cc",
        "memory_query_test.cc",
        "memory_test.cc",
        "memory_test_fixture.cc",
        "virtual_pool_test.cc",
    ],
    hdrs = ["memory_test_fixture.h"],
    deps = [
        ":memory",
        ":virtual_pool",
        "//loom/src/loom/serve/runtime/device",
        "//loom/src/loom/serve/runtime/execution",
        "//loom/src/loom/serve/runtime/execution:queues",
        "//loom/src/loom/serve/runtime/execution:workspace",
        "//loom/src/loom/serve/runtime/parameter:residency",
        "//loom/src/loom/serve/testing:device",
        "//loom/src/loom/serve/testing:native_allocator",
        "//runtime/src/iree/async",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/memory:fixed_block_pool",
        "//runtime/src/iree/hal/memory:tlsf_pool",
        "//runtime/src/iree/hal/testing:deferred_pool",
        "//runtime/src/iree/testing:gtest",
    ],
    alwayslink = True,
)

loom_cc_test(
    name = "memory_loss_test",
    srcs = ["memory_loss_test.cc"],
    target_compatible_with = loom_config_compatible_with([
        "//runtime/config/hal:driver_task",
    ]),
    deps = [
        ":memory",
        "//loom/src/loom/serve/runtime/device",
        "//loom/src/loom/serve/runtime/execution",
        "//loom/src/loom/serve/runtime/host",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/memory:cpu_slab_provider",
        "//runtime/src/iree/hal/memory:passthrough_pool",
        "//runtime/src/iree/hal/memory:slab_provider",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
