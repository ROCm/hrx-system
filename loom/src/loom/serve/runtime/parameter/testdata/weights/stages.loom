// The tensor crosses a physical slab boundary after an aligned small prefix.
kernel.def @add_wide_kernel() {
  %groups = index.constant 8193 : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%storage: buffer) {
  %c0 = index.constant 0 : offset
  %c64 = index.constant 64 : index
  %count = index.constant 524296 : index
  %group = kernel.workgroup.id<x> : index
  %first = index.constant 0 : index
  %step = index.constant 1 : index
  %base = index.mul %group, %c64 : index
  %view = buffer.view %storage[%c0] : buffer -> view<524296xi32>
  scf.for %local = [%first to %c64 step %step] {
    %element = index.add %base, %local : index
    %valid = index.cmp ult, %element, %count : index
    scf.if %valid {
      %value = view.load %view[%element] : view<524296xi32> -> i32
      %delta = config.get @delta : i32
      %next = scalar.addi %value, %delta : i32
      view.store %next, %view[%element] : i32, view<524296xi32>
    }
  }
  kernel.return
}

command.def public @add_wide() launch(%storage: buffer) {
  kernel.launch @add_wide_kernel(%storage) : (buffer)
  command.return
}

kernel.def @consume_wide() {
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  kernel.launch.config workgroups(%c8, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%a: view<8xi32>, %wide: view<524296xi32>, %b: view<8xi32>, %output: buffer) {
  %c0 = index.constant 0 : offset
  %tail = index.constant 524288 : index
  %element = kernel.workgroup.id<x> : index
  %wide_element = index.add %tail, %element : index
  %av = view.load %a[%element] : view<8xi32> -> i32
  %wv = view.load %wide[%wide_element] : view<524296xi32> -> i32
  %bv = view.load %b[%element] : view<8xi32> -> i32
  %aw = scalar.addi %av, %wv : i32
  %sum = scalar.addi %aw, %bv : i32
  %output_view = buffer.view %output[%c0] : buffer -> view<8xi32>
  view.store %sum, %output_view[%element] : i32, view<8xi32>
  kernel.return
}

command.def public @windowed() launch(%weights: buffer, %output: buffer) {
  %a = command.parameter %weights, "a" : view<8xi32>
  %wide = command.parameter %weights, "wide" : view<524296xi32>
  %b = command.parameter %weights, "b" : view<8xi32>
  kernel.launch @consume_wide(%a, %wide, %b, %output) : (view<8xi32>, view<524296xi32>, view<8xi32>, buffer)
  command.return
}

config.decl @wide_first_offset : i64

config.decl @wide_second_offset : i64

kernel.def @combine_wide_kernel() {
  %groups = index.constant 8193 : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%output: buffer, %input: buffer) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c64 = index.constant 64 : index
  %half = index.constant 262148 : index
  %count = index.constant 524296 : index
  %first_bytes = config.get @wide_first_offset : i64
  %second_bytes = config.get @wide_second_offset : i64
  %first_offset = index.cast %first_bytes : i64 to offset
  %second_offset = index.cast %second_bytes : i64 to offset
  %first = buffer.view %input[%first_offset] : buffer -> view<262148xi32>
  %second = buffer.view %input[%second_offset] : buffer -> view<262148xi32>
  %target = buffer.view %output[%origin] : buffer -> view<524296xi32>
  %group = kernel.workgroup.id<x> : index
  %base = index.mul %group, %c64 : index
  scf.for %local = [%c0 to %c64 step %c1] {
    %element = index.add %base, %local : index
    %valid = index.cmp ult, %element, %count : index
    scf.if %valid {
      %in_first = index.cmp ult, %element, %half : index
      %value = scf.if %in_first -> (i32) {
        %value = view.load %first[%element] : view<262148xi32> -> i32
        scf.yield %value : i32
      } else {
        %offset = index.sub %element, %half : index
        %value = view.load %second[%offset] : view<262148xi32> -> i32
        scf.yield %value : i32
      }
      view.store %value, %target[%element] : i32, view<524296xi32>
    }
  }
  kernel.return
}

command.def public @combine_wide() launch(%output: buffer, %input: buffer) {
  kernel.launch @combine_wide_kernel(%output, %input) : (buffer, buffer)
  command.return
}

// First and last elements come from different 64 MiB reads of one physical slab.
kernel.def @consume_coarse() {
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  kernel.launch.config workgroups(%c8, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%raw: view<16777224xi32>, %output: buffer) {
  %c0 = index.constant 0 : offset
  %tail = index.constant 16777216 : index
  %element = kernel.workgroup.id<x> : index
  %last = index.add %tail, %element : index
  %first_value = view.load %raw[%element] : view<16777224xi32> -> i32
  %last_value = view.load %raw[%last] : view<16777224xi32> -> i32
  %twice_first = scalar.addi %first_value, %first_value : i32
  %sum = scalar.addi %twice_first, %last_value : i32
  %target = buffer.view %output[%c0] : buffer -> view<8xi32>
  view.store %sum, %target[%element] : i32, view<8xi32>
  kernel.return
}

command.def public @coarse_raw() launch(%weights: buffer, %output: buffer) {
  %raw = command.parameter %weights, "raw" : view<16777224xi32>
  kernel.launch @consume_coarse(%raw, %output) : (view<16777224xi32>, buffer)
  command.return
}

kernel.def @consume_selected() {
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  kernel.launch.config workgroups(%c8, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%a_base: buffer, %b_base: buffer, %raw_base: buffer, %request: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %element = kernel.workgroup.id<x> : index
  %offsets = buffer.view %request[%origin] : buffer -> view<8xi64>
  %bank_bits = view.load %offsets[%element] : view<8xi64> -> i64
  %nonnegative = scalar.assume %bank_bits [range(%bank_bits, 0, 9223372036854775807)] : i64
  %bank = index.cast %nonnegative : i64 to offset
  %a = buffer.view %a_base[%bank] : buffer -> view<8xi32>
  %b = buffer.view %b_base[%bank] : buffer -> view<8xi32>
  %raw = buffer.view %raw_base[%bank] : buffer -> view<8xi32>
  %av = view.load %a[%element] : view<8xi32> -> i32
  %bv = view.load %b[%element] : view<8xi32> -> i32
  %rv = view.load %raw[%element] : view<8xi32> -> i32
  %ab = scalar.addi %av, %bv : i32
  %sum = scalar.addi %ab, %rv : i32
  %target = buffer.view %output[%origin] : buffer -> view<8xi32>
  view.store %sum, %target[%element] : i32, view<8xi32>
  kernel.return
}

command.def public @selected_target() launch(%weights: buffer, %request: buffer, %output: buffer) {
  %a = command.parameter %weights, "a" : view<8xi32>
  %b = command.parameter %weights, "b" : view<8xi32>
  %raw = command.parameter %weights, "raw" : view<8xi32>
  %a_base = command.parameter.base %a : view<8xi32> -> buffer
  %b_base = command.parameter.base %b : view<8xi32> -> buffer
  %raw_base = command.parameter.base %raw : view<8xi32> -> buffer
  kernel.launch @consume_selected(%a_base, %b_base, %raw_base, %request, %output) : (buffer, buffer, buffer, buffer, buffer)
  command.return
}

// Two items share immutable prepared banks but retain independent selection
// counts and strengths. Four elements per item make the exact result visible.
kernel.def @consume_bank_cohort() {
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  kernel.launch.config workgroups(%c8, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%weights: buffer, %request: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %lane = kernel.workgroup.id<x> : index
  %elements_per_item = index.constant 4 : index
  %item = index.div %lane, %elements_per_item : index
  %element = index.rem %lane, %elements_per_item : index
  %word_bytes = index.constant 8 : offset
  %header_offset = index.scale %item, %word_bytes : index, offset -> offset
  %header = buffer.view %request[%header_offset] : buffer -> view<2xi32>
  %first32 = view.load %header[0] : view<2xi32> -> i32
  %count32 = view.load %header[1] : view<2xi32> -> i32
  %first = index.cast %first32 : i32 to index
  %count = index.cast %count32 : i32 to index
  %end = index.add %first, %count : index
  %step = index.constant 1 : index
  %initial_sum = scalar.constant 0 : i32
  %record_stride = index.constant 16 : offset
  %sum = scf.for %i = [%first to %end step %step](%sum = %initial_sum : i32) -> (i32) {
    %relative = index.scale %i, %record_stride : index, offset -> offset
    %record_offset = index.add %record_stride, %relative : offset
    %record = buffer.view %request[%record_offset] : buffer -> view<1xi64>
    %bank_bits = view.load %record[0] : view<1xi64> -> i64
    %nonnegative = scalar.assume %bank_bits [range(%bank_bits, 0, 9223372036854775807)] : i64
    %bank = index.cast %nonnegative : i64 to offset
    %strength_offset = index.add %record_offset, %word_bytes : offset
    %strength_view = buffer.view %request[%strength_offset] : buffer -> view<1xi32>
    %strength = view.load %strength_view[0] : view<1xi32> -> i32
    %factor = buffer.view %weights[%bank] : buffer -> view<8xi32>
    %value = view.load %factor[%element] : view<8xi32> -> i32
    %scaled = scalar.muli %value, %strength : i32
    %next = scalar.addi %sum, %scaled : i32
    scf.yield %next : i32
  }
  %target = buffer.view %output[%origin] : buffer -> view<8xi32>
  view.store %sum, %target[%lane] : i32, view<8xi32>
  kernel.return
}

command.def public @bank_cohort() launch(%arena: buffer, %request: buffer, %output: buffer) {
  %a = command.parameter %arena, "a" : view<8xi32>
  %base = command.parameter.base %a : view<8xi32> -> buffer
  kernel.launch @consume_bank_cohort(%base, %request, %output) : (buffer, buffer, buffer)
  command.return
}

command.def public @bank_missing() launch(%arena: buffer, %request: buffer, %output: buffer) {
  %missing = command.parameter %arena, "missing" : view<8xi32>
  %base = command.parameter.base %missing : view<8xi32> -> buffer
  kernel.launch @consume_bank_cohort(%base, %request, %output) : (buffer, buffer, buffer)
  command.return
}

command.def public @bank_cold() launch(%weights: buffer, %request: buffer, %output: buffer) {
  %raw = command.parameter %weights, "raw" : view<8xi32>
  %base = command.parameter.base %raw : view<8xi32> -> buffer
  kernel.launch @consume_bank_cohort(%base, %request, %output) : (buffer, buffer, buffer)
  command.return
