amdgpu.target<gfx11-generic> @wave32 {subgroup_size = 32}

kernel.def target(@wave32) @add() {
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c8, %c1, %c1) : index
} launch(%storage: buffer, %delta: i32) {
  %c0 = index.constant 0 : offset
  %element = kernel.workitem.id<x> : index
  %view = buffer.view %storage[%c0] : buffer -> view<8xi32>
  %value = view.load %view[%element] : view<8xi32> -> i32
  %next = scalar.addi %value, %delta : i32
  view.store %next, %view[%element] : i32, view<8xi32>
  kernel.return
}

command.program.def public @add3() launch(%storage: buffer) {
  %delta = scalar.constant 3 : i32
  kernel.launch @add(%storage, %delta) : (buffer, i32)
  command.return
}

command.program.def public @add7() launch(%storage: buffer) {
  %delta = scalar.constant 7 : i32
  kernel.launch @add(%storage, %delta) : (buffer, i32)
  command.return
}

kernel.def target(@wave32) @consume() {
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c8, %c1, %c1) : index
} launch(%a: view<8xi32>, %b: view<8xi32>, %raw: view<8xi32>, %output: buffer) {
  %c0 = index.constant 0 : offset
  %element = kernel.workitem.id<x> : index
  %output_view = buffer.view %output[%c0] : buffer -> view<8xi32>
  %av = view.load %a[%element] : view<8xi32> -> i32
  %bv = view.load %b[%element] : view<8xi32> -> i32
  %rv = view.load %raw[%element] : view<8xi32> -> i32
  %ab = scalar.addi %av, %bv : i32
  %sum = scalar.addi %ab, %rv : i32
  view.store %sum, %output_view[%element] : i32, view<8xi32>
  kernel.return
}

command.program.def public @target() launch(%weights: buffer, %output: buffer) {
  %a = command.parameter %weights, "a" : view<8xi32>
  %b = command.parameter %weights, "b" : view<8xi32>
  %raw = command.parameter %weights, "raw" : view<8xi32>
  kernel.launch @consume(%a, %b, %raw, %output) : (view<8xi32>, view<8xi32>, view<8xi32>, buffer)
  command.return
}

command.program.def public @auxiliary() launch(%shared: buffer, %private: buffer, %output: buffer) {
  %a = command.parameter %shared, "a" : view<8xi32>
  %d = command.parameter %private, "d" : view<8xi32>
  kernel.launch @consume(%a, %d, %d, %output) : (view<8xi32>, view<8xi32>, view<8xi32>, buffer)
  command.return
}

command.program.def public @raw() launch(%weights: buffer, %output: buffer) {
  %data = command.parameter %weights, "raw" : view<8xi32>
  kernel.launch @consume(%data, %data, %data, %output) : (view<8xi32>, view<8xi32>, view<8xi32>, buffer)
  command.return
}

command.program.def public @domains() launch(%base: buffer, %adapter: buffer, %output: buffer) {
  %left = command.parameter %base, "raw" : view<8xi32>
  %right = command.parameter %adapter, "raw" : view<8xi32>
  kernel.launch @consume(%left, %right, %right, %output) : (view<8xi32>, view<8xi32>, view<8xi32>, buffer)
  command.return
}

command.program.def public @size() launch(%weights: buffer, %output: buffer) {
  %data = command.parameter %weights, "size" : view<8xi32>
  kernel.launch @consume(%data, %data, %data, %output) : (view<8xi32>, view<8xi32>, view<8xi32>, buffer)
  command.return
}

command.program.def public @missing() launch(%weights: buffer, %output: buffer) {
  %data = command.parameter %weights, "missing" : view<8xi32>
  kernel.launch @consume(%data, %data, %data, %output) : (view<8xi32>, view<8xi32>, view<8xi32>, buffer)
  command.return
}

command.program.def public @unavailable() launch(%weights: buffer, %output: buffer) {
  %data = command.parameter %weights, "unavailable" : view<8xi32>
  kernel.launch @consume(%data, %data, %data, %output) : (view<8xi32>, view<8xi32>, view<8xi32>, buffer)
  command.return
}

command.program.def public @partial() launch(%weights: buffer, %output: buffer) {
  %a = command.parameter %weights, "a" : view<8xi32>
  %b = command.parameter %weights, "b" : view<8xi32>
  %missing = command.parameter %weights, "unavailable" : view<8xi32>
  kernel.launch @consume(%a, %b, %missing, %output) : (view<8xi32>, view<8xi32>, view<8xi32>, buffer)
  command.return
}
