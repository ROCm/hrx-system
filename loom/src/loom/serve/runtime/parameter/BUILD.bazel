load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test", "loom_config_compatible_with")

package(
    default_visibility = ["//loom/src/loom/serve:implementation"],
    features = ["layering_check"],
    licenses = ["notice"],
)

exports_files(
    [
        "testdata/weights/policy.loom",
        "testdata/weights/stages.loom",
        "weights_test.cc",
    ],
    visibility = ["//loom/src/loom/serve:implementation"],
)

loom_cc_library(
    name = "activation",
    srcs = ["activation.c"],
    hdrs = ["activation.h"],
    deps = [
        ":residency",
        "//loom/src/loom/serve/runtime/execution",
        "//runtime/src/iree/async",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
    ],
)

loom_cc_library(
    name = "residency",
    srcs = ["residency.c"],
    hdrs = ["residency.h"],
    deps = [
        ":weights",
        "//loom/src/loom/serve/runtime/execution",
        "//loom/src/loom/serve/runtime/storage:memory",
        "//runtime/src/iree/base",
    ],
)

loom_cc_test(
    name = "activation_test",
    srcs = ["activation_test.cc"],
    target_compatible_with = loom_config_compatible_with([
        "//runtime/config/hal:driver_task",
    ]),
    deps = [
        ":activation",
        ":residency",
        "//loom/src/loom/serve/runtime/device",
        "//loom/src/loom/serve/runtime/execution",
        "//loom/src/loom/serve/runtime/host",
        "//runtime/src/iree/base",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "weights",
    srcs = ["weights.c"],
    hdrs = ["weights.h"],
    deps = [
        "//loom/binding/c:loomc",
        "//loom/src/loom/serve/runtime/execution",
        "//loom/src/loom/serve/runtime/execution:retirement",
        "//loom/src/loom/serve/runtime/host",
        "//loom/src/loom/serve/runtime/program",
        "//loom/src/loom/serve/runtime/program:jit",
        "//loom/src/loom/serve/runtime/program:sources",
        "//loom/src/loom/serve/runtime/storage:memory",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/io:parameter_index",
        "//runtime/src/iree/io:parameter_index_provider",
        "//runtime/src/iree/io:parameter_provider",
        "//runtime/src/iree/tooling:parameter_util",
        "//runtime/src/iree/vm",
    ],
)

loom_cc_library(
    name = "telemetry",
    srcs = ["telemetry.c"],
    hdrs = ["telemetry.h"],
    deps = [
        ":weights",
        "//loom/src/loom/serve/telemetry:record",
        "//loom/src/loom/serve/telemetry:stream",
        "//runtime/src/iree/base",
    ],
)

loom_cc_test(
    name = "telemetry_test",
    srcs = ["telemetry_test.cc"],
    deps = [
        ":telemetry",
        "//loom/src/loom/serve/telemetry:record",
        "//loom/src/loom/serve/telemetry:stream",
        "//runtime/src/iree/base",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
