load("//build_tools/bazel:query.bzl", "iree_assert_dependency_boundary")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test")

package(
    default_visibility = ["//loom/src/loom/serve:implementation"],
    features = ["layering_check"],
    licenses = ["notice"],
)

loom_cc_library(
    name = "host",
    srcs = ["host.c"],
    hdrs = ["host.h"],
    deps = [
        "//loom/binding/c:loomc",
        "//loom/binding/c:task_pool",
        "//loom/binding/c:task_queue",
        "//loom/binding/c/target/vm",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/async/util:proactor_thread",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/drivers/task:driver",
        "//runtime/src/iree/hal/drivers/task/executable:loader",
        "//runtime/src/iree/hal/drivers/task/executable/loaders/registration",
        "//runtime/src/iree/task",
    ],
)

iree_assert_dependency_boundary(
    name = "host_has_no_x86_compiler_dependency",
    forbidden_subtrees = [
        "//loom/binding/c/target/cpu/...",
        "//loom/binding/c/target/x86/...",
        "//loom/src/loom/target/arch/x86/...",
    ],
    message = "The serving host task driver must remain independent of Loom x86 compiler support",
    target = ":host",
)

loom_cc_test(
    name = "host_test",
    srcs = ["host_test.cc"],
    deps = [
        ":host",
        "//loom/binding/c:task_pool",
        "//runtime/src/iree/base",
        "//runtime/src/iree/task",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "wake",
    hdrs = ["wake.h"],
)

loom_cc_library(
    name = "timer",
    srcs = ["timer.c"],
    hdrs = ["timer.h"],
    deps = [
        ":wake",
        "//runtime/src/iree/async",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
    ],
)

loom_cc_test(
    name = "timer_test",
    srcs = ["timer_test.cc"],
    deps = [
        ":timer",
        "//runtime/src/iree/async",
        "//runtime/src/iree/async/util:proactor_pool",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/threading",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
