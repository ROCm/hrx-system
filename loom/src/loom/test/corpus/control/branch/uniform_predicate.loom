// A uniform route decision also selects a lane-dependent payload. Each loop
// iteration narrows participation with a lane guard, then branches on the
// uniform decision without changing the active lanes. False decisions suppress
// the load. Bounds are in [0, 64], rounds in [0, 16], and buffers are aligned.
// Input lane j is 3*j - 2. With t true decisions in n rounds, an active lane
// contributes t*(4*lane - 3*start - 2) - 3*(n-t).
kernel.def @uniform_predicate_control() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%start: index, %end: index, %rounds: index, %mode: i32, %input: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  func.call @compute_uniform_predicate_control(%start, %end, %rounds, %mode, %input, %output, %lane) : (index, index, index, i32, buffer, buffer, index)
  kernel.return
}

func.def device inline @compute_uniform_predicate_control(%start: index, %end: index, %rounds: index, %mode: i32, %input: buffer, %output: buffer, %lane: index) {
  %first = index.assume %start [range(%start, 0, 64)] : index
  %limit = index.assume %end [range(%end, 0, 64)] : index
  %count = index.assume %rounds [range(%rounds, 0, 16)] : index
  %number = index.cast %lane : index to i32
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %base = index.constant 0 : offset
  %initial = scalar.constant 0 : i32
  %negative = scalar.constant -1 : i32
  %missing = scalar.constant -2 : i32
  %untouched = scalar.constant -700 : i32
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %in = buffer.view %input_aligned[%base] : buffer -> view<64xi32>
  %out = buffer.view %output_aligned[%base] : buffer -> view<64xi32>
  %after_start = index.cmp sge, %lane, %first : index
  %before_end = index.cmp slt, %lane, %limit : index
  %active = scalar.andi %after_start, %before_end : i1
  %sum = scf.for %iteration = [%begin to %count step %step](%accumulator = %initial : i32) -> (i32) {
    %ordinal = index.cast %iteration : index to i32
    %condition = scalar.cmpi slt, %ordinal, %mode : i32
    %next = scf.if %active -> (i32) {
      %position = index.sub %lane, %first : index
      %payload = scf.if %condition -> (i32) {
        %loaded = view.load %in[%position] : view<64xi32> -> i32
        scf.yield %loaded : i32
      } else {
        scf.yield %missing : i32
      }
      %selected = scf.select %condition, %number, %negative : i32
      %contribution = scalar.addi %payload, %selected : i32
      %updated = scalar.addi %accumulator, %contribution : i32
      scf.yield %updated : i32
    } else {
      scf.yield %accumulator : i32
    }
    scf.yield %next : i32
  }
  %result = scf.select %active, %sum, %untouched : i32
  view.store %result, %out[%lane] : i32, view<64xi32>
  func.return
}

func.def @uniform_predicate_control_oracle(%start: index, %end: index, %rounds: index, %mode: i32, %input: buffer, %output: buffer) {
  %begin = index.constant 0 : index
  %width = index.constant 64 : index
  %step = index.constant 1 : index
  scf.for %lane = [%begin to %width step %step] {
    func.call @compute_uniform_predicate_control(%start, %end, %rounds, %mode, %input, %output, %lane) : (index, index, index, i32, buffer, buffer, index)
  }
  func.return
}

check.scenario @uniform_predicate_control_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %start = check.literal value(0) : index
    %end = check.literal value(0) : index
    %rounds = check.literal value(5) : index
    %mode = check.literal value(3) : i32
    %input = check.generate.iota offset(-2) step(3) : tensor<1xi32>
    %storage = check.generate.fill value(-12345) : tensor<72xi32>
    %output = check.tensor.view %storage offset(16) : tensor<72xi32> -> tensor<64xi32>
    check.compare<@uniform_predicate_control, @uniform_predicate_control_oracle>(%start, %end, %rounds, %mode, %input, %output) : (index, index, index, i32, tensor<1xi32>, tensor<64xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<1xi32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<72xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %start = check.literal value(17) : index
    %end = check.literal value(53) : index
    %rounds = check.literal value(0) : index
    %mode = check.literal value(3) : i32
    %input = check.generate.iota offset(-2) step(3) : tensor<1xi32>
    %storage = check.generate.fill value(-12345) : tensor<72xi32>
    %output = check.tensor.view %storage offset(16) : tensor<72xi32> -> tensor<64xi32>
    check.compare<@uniform_predicate_control, @uniform_predicate_control_oracle>(%start, %end, %rounds, %mode, %input, %output) : (index, index, index, i32, tensor<1xi32>, tensor<64xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<1xi32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<72xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %start = check.literal value(17) : index
    %end = check.literal value(53) : index
    %rounds = check.literal value(5) : index
    %mode = check.literal value(0) : i32
    %input = check.generate.iota offset(-2) step(3) : tensor<1xi32>
    %storage = check.generate.fill value(-12345) : tensor<72xi32>
    %output = check.tensor.view %storage offset(16) : tensor<72xi32> -> tensor<64xi32>
    check.compare<@uniform_predicate_control, @uniform_predicate_control_oracle>(%start, %end, %rounds, %mode, %input, %output) : (index, index, index, i32, tensor<1xi32>, tensor<64xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<1xi32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<72xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %start = check.literal value(17) : index
    %end = check.literal value(53) : index
    %rounds = check.literal value(5) : index
    %mode = check.literal value(3) : i32
    %input = check.generate.iota offset(-2) step(3) : tensor<36xi32>
    %storage = check.generate.fill value(-12345) : tensor<72xi32>
    %output = check.tensor.view %storage offset(16) : tensor<72xi32> -> tensor<64xi32>
    check.compare<@uniform_predicate_control, @uniform_predicate_control_oracle>(%start, %end, %rounds, %mode, %input, %output) : (index, index, index, i32, tensor<36xi32>, tensor<64xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<36xi32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<72xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %start = check.literal value(32) : index
    %end = check.literal value(64) : index
    %rounds = check.literal value(2) : index
    %mode = check.literal value(5) : i32
    %input = check.generate.iota offset(-2) step(3) : tensor<32xi32>
    %storage = check.generate.fill value(-12345) : tensor<72xi32>
    %output = check.tensor.view %storage offset(16) : tensor<72xi32> -> tensor<64xi32>
    check.compare<@uniform_predicate_control, @uniform_predicate_control_oracle>(%start, %end, %rounds, %mode, %input, %output) : (index, index, index, i32, tensor<32xi32>, tensor<64xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<32xi32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<72xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %start = check.literal value(0) : index
    %end = check.literal value(64) : index
    %rounds = check.literal value(3) : index
    %mode = check.literal value(2) : i32
    %input = check.generate.iota offset(-2) step(3) : tensor<64xi32>
    %storage = check.generate.fill value(-12345) : tensor<72xi32>
    %output = check.tensor.view %storage offset(16) : tensor<72xi32> -> tensor<64xi32>
    check.compare<@uniform_predicate_control, @uniform_predicate_control_oracle>(%start, %end, %rounds, %mode, %input, %output) : (index, index, index, i32, tensor<64xi32>, tensor<64xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<64xi32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<72xi32>
    }
  }
  check.return
}

// Uniform floating comparisons can have lane-mask carriers even though their
// truth values agree. Reusing them after a lane guard must observe the active
// lanes at the selection, including a wave with only its upper half active.
kernel.def @uniform_boolean_selection() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%selector: f32, %first: f32, %second: f32, %begin: index, %end: index, %output: buffer) {
  %threshold = scalar.constant 0.0 : f32
  %condition = scalar.cmpf ogt, %selector, %threshold : f32
  %true_value = scalar.cmpf ogt, %first, %threshold : f32
  %false_value = scalar.cmpf ogt, %second, %threshold : f32
  %lane = kernel.workitem.id<x> : index
  %after_begin = index.cmp uge, %lane, %begin : index
  %before_end = index.cmp ult, %lane, %end : index
  %active = scalar.andi %after_begin, %before_end : i1
  scf.if %active {
    %selected = scf.select %condition, %true_value, %false_value : i1
    %word = scalar.extui %selected : i1 to i32
    %base = index.constant 0 : offset
    %view = buffer.view %output[%base] : buffer -> view<64xi32>
    view.store %word, %view[%lane] : i32, view<64xi32>
  }
  kernel.return
}

func.def @uniform_boolean_selection_oracle(%selector: f32, %first: f32, %second: f32, %begin: index, %end: index, %output: buffer) {
  %start = index.assume %begin [range(%begin, 0, 64)] : index
  %limit = index.assume %end [range(%end, 0, 64)] : index
  %threshold = scalar.constant 0.0 : f32
  %true = scalar.constant true : i1
  %condition = scalar.cmpf ogt, %selector, %threshold : f32
  %true_value = scalar.cmpf ogt, %first, %threshold : f32
  %false_value = scalar.cmpf ogt, %second, %threshold : f32
  %inverse = scalar.xori %condition, %true : i1
  %selected_true = scalar.andi %condition, %true_value : i1
  %selected_false = scalar.andi %inverse, %false_value : i1
  %selected = scalar.ori %selected_true, %selected_false : i1
  %word = scalar.extui %selected : i1 to i32
  %step = index.constant 1 : index
  %base = index.constant 0 : offset
  %view = buffer.view %output[%base] : buffer -> view<64xi32>
  scf.for %lane = [%start to %limit step %step] {
    view.store %word, %view[%lane] : i32, view<64xi32>
  }
  func.return
}

func.def @uniform_boolean_selection_inputs(%trial: index) -> (f32, f32, f32, index, index) {
  %ordinal = index.cast %trial : index to i32
  %selector_mask = scalar.constant 1 : i32
  %first_mask = scalar.constant 2 : i32
  %second_mask = scalar.constant 4 : i32
  %selector_bit = scalar.andi %ordinal, %selector_mask : i32
  %first_bit = scalar.andi %ordinal, %first_mask : i32
  %second_bit = scalar.andi %ordinal, %second_mask : i32
  %selector = scalar.uitofp %selector_bit : i32 to f32
  %first = scalar.uitofp %first_bit : i32 to f32
  %second = scalar.uitofp %second_bit : i32 to f32
  %combinations_per_range = index.constant 8 : index
  %range = index.div %trial, %combinations_per_range : index
  %begin, %end = scf.switch %range -> (index, index) {
    case 0 {
      %begin = index.constant 0 : index
      %end = index.constant 64 : index
      scf.yield %begin, %end : index, index
    }
    case 1 {
      %begin = index.constant 17 : index
      %end = index.constant 53 : index
      scf.yield %begin, %end : index, index
    }
    case 2 {
      %begin = index.constant 32 : index
      %end = index.constant 64 : index
      scf.yield %begin, %end : index, index
    }
    default {
      %begin = index.constant 33 : index
      scf.yield %begin, %begin : index, index
    }
  }
  func.return %selector, %first, %second, %begin, %end : f32, f32, f32, index, index
}

check.scenario @uniform_boolean_selection_values {
  check.trial[32](%trial: index, %entropy: check.entropy) {
    %selector, %first, %second, %begin, %end = check.generate<@uniform_boolean_selection_inputs>(%trial) : (index) -> (f32, f32, f32, index, index)
    %storage = check.generate.fill value(-12345) : tensor<72xi32>
    %output = check.tensor.view %storage offset(16) : tensor<72xi32> -> tensor<64xi32>
    check.compare<@uniform_boolean_selection, @uniform_boolean_selection_oracle>(%selector, %first, %second, %begin, %end, %output) : (f32, f32, f32, index, index, tensor<64xi32>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<72xi32>
    }
  }
  check.return
}

// Retained calls share one signature across uniform and lane-dependent callers.
// A second helper has only uniform inputs but computes a vector in its arms.
func.def noinline @choose_call_payload(%condition: i1, %first: vector<3xf32>, %second: vector<3xf32>) -> (vector<3xf32>) {
  %result = scf.if %condition -> (vector<3xf32>) {
    scf.yield %first : vector<3xf32>
  } else {
    scf.yield %second : vector<3xf32>
  }
  func.return %result : vector<3xf32>
}

func.def noinline @scale_call_payload(%condition: i1, %values: vector<3xf32>) -> (vector<3xf32>) {
  %result = scf.if %condition -> (vector<3xf32>) {
    %doubled = vector.addf %values, %values : vector<3xf32>
    scf.yield %doubled : vector<3xf32>
  } else {
    scf.yield %values : vector<3xf32>
  }
  func.return %result : vector<3xf32>
}

kernel.def @call_argument_distribution() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%selector: i32, %first: f32, %second: f32, %begin: index, %end: index, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %after_begin = index.cmp uge, %lane, %begin : index
  %before_end = index.cmp ult, %lane, %end : index
  %active = scalar.andi %after_begin, %before_end : i1
  scf.if %active {
    %selector_threshold = scalar.constant 0 : i32
    %uniform = scalar.cmpi sgt, %selector, %selector_threshold : i32
    %half = index.constant 32 : index
    %varying = index.cmp ult, %lane, %half : index
    %number = index.cast %lane : index to i32
    %position = scalar.uitofp %number : i32 to f32
    %first_values = vector.from_elements %first, %second, %first : vector<3xf32>
    %second_values = vector.from_elements %second, %first, %second : vector<3xf32>
    %lane_values = vector.from_elements %position, %first, %second : vector<3xf32>
    %scaled = func.call @scale_call_payload(%uniform, %first_values) : (i1, vector<3xf32>) -> (vector<3xf32>)
    %selected = func.call @choose_call_payload(%uniform, %first_values, %second_values) : (i1, vector<3xf32>, vector<3xf32>) -> (vector<3xf32>)
    %mixed = func.call @choose_call_payload(%varying, %lane_values, %second_values) : (i1, vector<3xf32>, vector<3xf32>) -> (vector<3xf32>)
    %base = index.constant 0 : offset
    %results = buffer.view %output[%base] : buffer -> view<64x9xf32>
    vector.store %scaled, %results[%lane, 0] : vector<3xf32>, view<64x9xf32>
    vector.store %selected, %results[%lane, 3] : vector<3xf32>, view<64x9xf32>
    vector.store %mixed, %results[%lane, 6] : vector<3xf32>, view<64x9xf32>
  }
  kernel.return
}

func.def @call_argument_distribution_oracle(%selector: i32, %first: f32, %second: f32, %begin: index, %end: index, %output: buffer) {
  %selector_threshold = scalar.constant 0 : i32
  %uniform = scalar.cmpi sgt, %selector, %selector_threshold : i32
  %base = index.constant 0 : offset
  %results = buffer.view %output[%base] : buffer -> view<64x9xf32>
  %start = index.constant 0 : index
  %width = index.constant 64 : index
  %step = index.constant 1 : index
  %half = index.constant 32 : index
  %payload_width = index.constant 3 : index
  scf.for %lane = [%start to %width step %step] {
    %after_begin = index.cmp uge, %lane, %begin : index
    %before_end = index.cmp ult, %lane, %end : index
    %active = scalar.andi %after_begin, %before_end : i1
    scf.if %active {
      %varying = index.cmp ult, %lane, %half : index
      %number = index.cast %lane : index to i32
      %position = scalar.uitofp %number : i32 to f32
      scf.for %element = [%start to %payload_width step %step] {
        %middle = index.cmp eq, %element, %step : index
        %left = scf.select %middle, %second, %first : f32
        %right = scf.select %middle, %first, %second : f32
        %doubled = scalar.addf %left, %left : f32
        %scaled = scf.select %uniform, %doubled, %left : f32
        %selected = scf.select %uniform, %left, %right : f32
        %first_element = index.cmp eq, %element, %start : index
        %tail = scf.select %middle, %first, %second : f32
        %lane_value = scf.select %first_element, %position, %tail : f32
        %mixed = scf.select %varying, %lane_value, %right : f32
        %selected_column = index.add %element, %payload_width : index
        %mixed_column = index.add %selected_column, %payload_width : index
        view.store %scaled, %results[%lane, %element] : f32, view<64x9xf32>
        view.store %selected, %results[%lane, %selected_column] : f32, view<64x9xf32>
        view.store %mixed, %results[%lane, %mixed_column] : f32, view<64x9xf32>
      }
    }
  }
  func.return
}

func.def @call_argument_distribution_inputs(%trial: index) -> (i32, index, index) {
  %condition_count = index.constant 2 : index
  %bit = index.rem %trial, %condition_count : index
  %selector = index.cast %bit : index to i32
  %range = index.div %trial, %condition_count : index
  %begin, %end = scf.switch %range -> (index, index) {
    case 0 {
      %begin = index.constant 0 : index
      %end = index.constant 64 : index
      scf.yield %begin, %end : index, index
    }
    case 1 {
      %begin = index.constant 17 : index
      %end = index.constant 53 : index
      scf.yield %begin, %end : index, index
    }
    case 2 {
      %begin = index.constant 32 : index
      %end = index.constant 64 : index
      scf.yield %begin, %end : index, index
    }
    default {
      %begin = index.constant 33 : index
      scf.yield %begin, %begin : index, index
    }
  }
  func.return %selector, %begin, %end : i32, index, index
}

check.scenario @call_argument_distribution_values {
  check.trial[8](%trial: index, %entropy: check.entropy) {
    %selector, %begin, %end = check.generate<@call_argument_distribution_inputs>(%trial) : (index) -> (i32, index, index)
    %first = check.literal value(2.0) : f32
    %second = check.literal value(-3.5) : f32
    %output = check.generate.fill value(-777.0) : tensor<64x9xf32>
    check.compare<@call_argument_distribution, @call_argument_distribution_oracle>(%selector, %first, %second, %begin, %end, %output) : (i32, f32, f32, index, index, tensor<64x9xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<64x9xf32>
    }
  }
  check.return
}

// Uniform loop control must not overwrite the three independent Boolean values
// rotating through its backedge. Constants and a runtime comparison share the
// same carried representation, and every final component is observable.
kernel.def @uniform_predicate_rotation() {
  %c1 = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%width, %c1, %c1) : index
} launch(%count: index, %output: buffer) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %true = scalar.constant true : i1
  %false = scalar.constant false : i1
  %parity = index.andi %count, %c1 : index
  %compared = index.cmp ne, %parity, %c0 : index
  %first, %second, %third = scf.for %iteration = [%c0 to %count step %c1](%head = %true : i1, %middle = %false : i1, %tail = %compared : i1) -> (i1, i1, i1) {
    scf.yield %middle, %tail, %head : i1, i1, i1
  }
  %base = index.constant 0 : offset
  %lane = kernel.workitem.id<x> : index
  %view = buffer.view %output[%base] : buffer -> view<3x64xi32>
  %first_word = scalar.extui %first : i1 to i32
  %second_word = scalar.extui %second : i1 to i32
  %third_word = scalar.extui %third : i1 to i32
  view.store %first_word, %view[0, %lane] : i32, view<3x64xi32>
  view.store %second_word, %view[1, %lane] : i32, view<3x64xi32>
  view.store %third_word, %view[2, %lane] : i32, view<3x64xi32>
  kernel.return
}

func.def @uniform_predicate_rotation_oracle(%count: index, %output: buffer) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %width = index.constant 64 : index
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %base = index.constant 0 : offset
  %view = buffer.view %output[%base] : buffer -> view<3x64xi32>
  %parity = index.rem %count, %c2 : index
  %compared = index.cast %parity : index to i32
  %rotation = index.rem %count, %c3 : index
  %unchanged = index.cmp eq, %rotation, %c0 : index
  %once = index.cmp eq, %rotation, %c1 : index
  %first_rotated = scf.select %once, %c0_i32, %compared : i32
  %second_rotated = scf.select %once, %compared, %c1_i32 : i32
  %third_rotated = scf.select %once, %c1_i32, %c0_i32 : i32
  %first = scf.select %unchanged, %c1_i32, %first_rotated : i32
  %second = scf.select %unchanged, %c0_i32, %second_rotated : i32
  %third = scf.select %unchanged, %compared, %third_rotated : i32
  scf.for %lane = [%c0 to %width step %c1] {
    view.store %first, %view[0, %lane] : i32, view<3x64xi32>
    view.store %second, %view[1, %lane] : i32, view<3x64xi32>
    view.store %third, %view[2, %lane] : i32, view<3x64xi32>
  }
  func.return
}

check.scenario @uniform_predicate_rotation_values {
  check.trial[7](%count: index, %entropy: check.entropy) {
    %storage = check.generate.fill value(-123) : tensor<200xi32>
    %output = check.tensor.view %storage offset(16) : tensor<200xi32> -> tensor<3x64xi32>
    check.compare<@uniform_predicate_rotation, @uniform_predicate_rotation_oracle>(%count, %output) : (index, tensor<3x64xi32>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<200xi32>
    }
  }
  check.return
}
