// Observe scalar loop state through a buffer ABI shared by CPU and GPU
// targets. Trial ordinals vary signed bounds, trip counts, steps, and the
// parity-controlled while loop, and summation range while entropy supplies
// independent carried values.
func.def @scalar_loop_state_observations(%ordinal: index, %seed_bits: i64, %output: buffer) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c128 = index.constant 128 : index
  %bounded_ordinal = index.assume %ordinal [range(%ordinal, 0, 8)] : index
  %lower = index.sub %bounded_ordinal, %c4 : index
  %span = index.rem %bounded_ordinal, %c5 : index
  %upper = index.add %lower, %span : index
  %step_remainder = index.rem %bounded_ordinal, %c3 : index
  %step = index.add %step_remainder, %c1 : index
  %seed = scalar.trunci %seed_bits : i64 to i32
  %right_bias = scalar.constant 100 : i32
  %right_seed = scalar.addi %seed, %right_bias : i32

  // The ordered hash, last induction value, and swapped pair make entry,
  // backedge, final-yield, and zero-trip state independently observable.
  %hash, %last, %left, %right = scf.for %iv = [%lower to %upper step %step](%previous_hash = %seed : i32, %previous_iv = %seed : i32, %previous_left = %seed : i32, %previous_right = %right_seed : i32) -> (i32, i32, i32, i32) {
    %iv_i32 = index.cast %iv : index to i32
    %multiplier = scalar.constant 33 : i32
    %scaled = scalar.muli %previous_hash, %multiplier : i32
    %next_hash = scalar.addi %scaled, %iv_i32 : i32
    scf.yield %next_hash, %iv_i32, %previous_right, %previous_left : i32, i32, i32, i32
  }

  // Fixed signed-boundary loops retain the runtime witnesses that force a
  // narrow carrier to stop immediately before INT32_MAX and begin exactly at
  // INT32_MIN.
  %positive_lower = index.constant 2147483642 : index
  %positive_upper = index.constant 2147483647 : index
  %positive_step = index.constant 2 : index
  %positive_hash, %positive_last = scf.for %iv = [%positive_lower to %positive_upper step %positive_step](%previous_hash = %seed : i32, %previous_iv = %seed : i32) -> (i32, i32) {
    %iv_i32 = index.cast %iv : index to i32
    %multiplier = scalar.constant 33 : i32
    %scaled = scalar.muli %previous_hash, %multiplier : i32
    %next_hash = scalar.addi %scaled, %iv_i32 : i32
    scf.yield %next_hash, %iv_i32 : i32, i32
  }
  %negative_lower = index.constant -2147483648 : index
  %negative_upper = index.constant -2147483641 : index
  %negative_step = index.constant 3 : index
  %negative_hash, %negative_last = scf.for %iv = [%negative_lower to %negative_upper step %negative_step](%previous_hash = %seed : i32, %previous_iv = %seed : i32) -> (i32, i32) {
    %iv_i32 = index.cast %iv : index to i32
    %multiplier = scalar.constant 33 : i32
    %scaled = scalar.muli %previous_hash, %multiplier : i32
    %next_hash = scalar.addi %scaled, %iv_i32 : i32
    scf.yield %next_hash, %iv_i32 : i32, i32
  }

  // Each nested loop owns a distinct bound and carried value. The unsigned
  // selection also distinguishes a negative outer index from the small inner
  // indices without changing the signed outer loop's termination rule.
  %nested = scf.for %outer = [%lower to %upper step %step](%outer_hash = %seed : i32) -> (i32) {
    %inner_hash = scf.for %inner = [%c0 to %c3 step %c1](%current_hash = %outer_hash : i32) -> (i32) {
      %outer_is_lower = index.cmp ult, %outer, %inner : index
      %chosen = scf.select %outer_is_lower, %outer, %inner : index
      %chosen_i32 = index.cast %chosen : index to i32
      %multiplier = scalar.constant 33 : i32
      %scaled = scalar.muli %current_hash, %multiplier : i32
      %next_hash = scalar.addi %scaled, %chosen_i32 : i32
      scf.yield %next_hash : i32
    }
    scf.yield %inner_hash : i32
  }

  // A structured unsigned loop crosses the i32 sign boundary and terminates
  // before fixed-width addition reaches the unsigned upper bound.
  %unsigned_lower = scalar.constant 2147483646 : i32
  %unsigned_upper = scalar.constant -2147483645 : i32
  %unsigned_step = scalar.constant 2 : i32
  %unsigned_hash, %unsigned_terminal = scf.while(%before_hash = %seed : i32, %before_counter = %unsigned_lower : i32) -> (i32, i32) {
    %more = scalar.cmpi ult, %before_counter, %unsigned_upper : i32
    scf.condition %more, %before_hash, %before_counter : i1, i32, i32
  } do(%current_hash: i32, %counter: i32) {
    %multiplier = scalar.constant 33 : i32
    %scaled = scalar.muli %current_hash, %multiplier : i32
    %next_hash = scalar.addi %scaled, %counter : i32
    %next_counter = scalar.addi %counter, %unsigned_step : i32
    scf.yield %next_hash, %next_counter : i32, i32
  }

  // Odd ordinals perform one parallel swap; even ordinals preserve both
  // initial values through the zero-trip path.
  %parity = index.rem %bounded_ordinal, %c2 : index
  %swap_once = index.cmp ne, %parity, %c0 : index
  %false = scalar.constant false : i1
  %ignored_condition, %while_left, %while_right = scf.while(%before_condition = %swap_once : i1, %before_left = %seed : i32, %before_right = %right_seed : i32) -> (i1, i32, i32) {
    scf.condition %before_condition, %before_condition, %before_left, %before_right : i1, i1, i32, i32
  } do(%body_condition: i1, %body_left: i32, %body_right: i32) {
    scf.yield %false, %body_right, %body_left : i1, i32, i32
  }

  // Scale the trial ordinal across the original 0..1024 range. The carried
  // sum makes every induction value and the zero-trip result observable.
  %sum_end = index.mul %bounded_ordinal, %c128 : index
  %sum_terminal, %sum = scf.while(%before_position = %c0 : index, %before_sum = %c0 : index) -> (index, index) {
    %more = index.cmp ult, %before_position, %sum_end : index
    scf.condition %more, %before_position, %before_sum : i1, index, index
  } do(%position: index, %partial_sum: index) {
    %next_sum = index.add %partial_sum, %position : index
    %next_position = index.add %position, %c1 : index
    scf.yield %next_position, %next_sum : index, index
  }
  %sum_i32 = index.cast %sum : index to i32

  %base = index.constant 0 : offset
  %results = buffer.view %output[%base] : buffer -> view<14xi32>
  view.store %hash, %results[0] : i32, view<14xi32>
  view.store %last, %results[1] : i32, view<14xi32>
  view.store %left, %results[2] : i32, view<14xi32>
  view.store %right, %results[3] : i32, view<14xi32>
  view.store %nested, %results[4] : i32, view<14xi32>
  view.store %unsigned_hash, %results[5] : i32, view<14xi32>
  view.store %unsigned_terminal, %results[6] : i32, view<14xi32>
  view.store %while_left, %results[7] : i32, view<14xi32>
  view.store %while_right, %results[8] : i32, view<14xi32>
  view.store %positive_hash, %results[9] : i32, view<14xi32>
  view.store %positive_last, %results[10] : i32, view<14xi32>
  view.store %negative_hash, %results[11] : i32, view<14xi32>
  view.store %negative_last, %results[12] : i32, view<14xi32>
  view.store %sum_i32, %results[13] : i32, view<14xi32>
  func.return
}

check.scenario @scalar_loop_state_values {
  check.trial[9](%trial: index, %entropy: check.entropy) {
    %seed_bits = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %output_storage = check.generate.fill value(-889275714) : tensor<22xi32>
    %output = check.tensor.view %output_storage offset(16) : tensor<22xi32> -> tensor<14xi32>
    %prefix = check.tensor.view %output_storage offset(0) : tensor<22xi32> -> tensor<4xi32>
    %suffix = check.tensor.view %output_storage offset(72) : tensor<22xi32> -> tensor<4xi32>
    %guard = check.generate.fill value(-889275714) : tensor<4xi32>
    check.compare<@scalar_loop_state_observations>(%trial, %seed_bits, %output) : (index, i64, tensor<14xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<14xi32>
      check.expect.bitwise actual(%prefix) expected(%guard) : tensor<4xi32>
      check.expect.bitwise actual(%suffix) expected(%guard) : tensor<4xi32>
    }
  }
  check.return
}

// Stored state covers fixed-width overflow and the signed i32 boundary.
// Offset values stay within u32 so both 32-bit and 64-bit carriers agree.
func.def @wide_stored_loop_state(%rounds: index, %seed: i64, %output: buffer) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %count = index.assume %rounds [range(%rounds, 0, 8)] : index
  %narrow_seed = scalar.trunci %seed : i64 to i32
  %narrow_factor = scalar.constant 33 : i32
  %wide_factor = scalar.constant 37 : i64
  %offset_seed = index.constant 2147483646 : offset
  %offset_step = index.constant 3 : offset
  %index_seed = index.constant -4 : index
  %narrow, %wide, %offset, %position = scf.for %iv = [%begin to %count step %step](%narrow_state = %narrow_seed : i32, %wide_state = %seed : i64, %offset_state = %offset_seed : offset, %index_state = %index_seed : index) -> (i32, i64, offset, index) {
    %next_narrow = scalar.muli %narrow_state, %narrow_factor : i32
    %next_wide = scalar.muli %wide_state, %wide_factor : i64
    %next_offset = index.add %offset_state, %offset_step : offset
    %next_index = index.add %index_state, %step : index
    scf.yield %next_narrow, %next_wide, %next_offset, %next_index : i32, i64, offset, index
  }
  %base = index.constant 0 : offset
  %results = buffer.view %output[%base] : buffer -> view<4xi64>
  %widened = scalar.extui %narrow : i32 to i64
  %offset_bits = index.cast %offset : offset to i64
  %index_bits = index.cast %position : index to i64
  view.store %widened, %results[0] : i64, view<4xi64>
  view.store %wide, %results[1] : i64, view<4xi64>
  view.store %offset_bits, %results[2] : i64, view<4xi64>
  view.store %index_bits, %results[3] : i64, view<4xi64>
  func.return
}

check.scenario @wide_stored_loop_state_values {
  check.trial[9](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %storage = check.generate.fill value(-889275714) : tensor<8xi64>
    %output = check.tensor.view %storage offset(16) : tensor<8xi64> -> tensor<4xi64>
    check.compare<@wide_stored_loop_state>(%trial, %seed, %output) : (index, i64, tensor<4xi64>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<8xi64>
    }
  }
  check.return
}
