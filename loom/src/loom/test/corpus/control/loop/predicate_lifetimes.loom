// The oracle observes each final comparison directly, with scalar indexing.
// Groups 1..32 enumerate every scalarized predicate carrier width.
func.def @predicate_shape_family_oracle(%limits: buffer, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %bounds = buffer.view %limits[%base] : buffer -> view<64xi32>
  %inputs = buffer.view %input[%base] : buffer -> view<33792xi32>
  %outputs = buffer.view %output[%base] : buffer -> view<33792xi32>
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %c2 = index.constant 2 : index
  %maximum_width = index.constant 32 : index
  %groups = index.constant 32 : index
  %lanes = index.constant 64 : index
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  scf.for %group = [%begin to %groups step %step] {
    %ordinal = index.add %group, %step : index
    %width = index.min %ordinal, %maximum_width : index
    %product = index.mul %group, %ordinal : index
    %triangle = index.div %product, %c2 : index
    %group_base = index.mul %triangle, %lanes : index
    scf.for %lane = [%begin to %lanes step %step] {
      %limit = view.load %bounds[%lane] : view<64xi32> -> i32
      %count = scalar.maxsi %limit, %c0 : i32
      %start = index.madd %lane, %width, %group_base : index
      scf.for %element = [%begin to %width step %step] {
        %position = index.add %start, %element : index
        %seed = view.load %inputs[%position] : view<33792xi32> -> i32
        %predicate = scalar.cmpi slt, %count, %seed : i32
        %word = scf.select %predicate, %c1, %c0 : i32
        view.store %word, %outputs[%position] : i32, view<33792xi32>
      }
    }
  }
  func.return
}

check.scenario @predicate_shape_family_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %limits = check.generate.iota offset(-2) step(1) period(7) : tensor<64xi32>
    %input = check.generate.iota offset(-1) step(1) period(11) : tensor<33792xi32>
    %storage = check.generate.fill value(-123) : tensor<33808xi32>
    %output = check.tensor.view %storage offset(32) : tensor<33808xi32> -> tensor<33792xi32>
    check.compare<@predicate_shape_family, @predicate_shape_family_oracle>(%limits, %input, %output) : (tensor<64xi32>, tensor<33792xi32>, tensor<33792xi32>) -> () {
      check.expect.bitwise actual(%limits) expected(%limits) : tensor<64xi32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<33792xi32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<33808xi32>
    }
  }
  check.return
}
