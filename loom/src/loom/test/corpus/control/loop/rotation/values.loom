    }
  }
  // rotate_values_d4_u2.
  check.trial[9](%count: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(1) step(1) : tensor<8224xi32>
    %output = check.generate.fill value(-99) : tensor<32xi32>
    check.compare<@rotate_values_d4_u2, @rotate_values_oracle>(%count, %input, %output) : (index, tensor<8224xi32>, tensor<32xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<8224xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<32xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %count = check.literal value(257) : index
    %input = check.generate.iota offset(1) step(1) : tensor<8224xi32>
    %output = check.generate.fill value(-99) : tensor<32xi32>
    check.compare<@rotate_values_d4_u2, @rotate_values_oracle>(%count, %input, %output) : (index, tensor<8224xi32>, tensor<32xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<8224xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<32xi32>
    }
  }
  check.return
}
