func.def @rotate_values_oracle(%count0: index, %input: buffer, %output: buffer) {
  %count = index.assume %count0 [range(%count0, 0, 257)] : index
  %begin = index.constant 0 : index
  %lane_end = index.constant 32 : index
  %step = index.constant 1 : index
  %base = index.constant 0 : offset
  %row_stride = index.constant 128 : offset
  %c0 = scalar.constant 0 : i32
  %source = buffer.assume.noalias %input : buffer
  %output_view = buffer.view %output[%base] : buffer -> view<32xi32>
  scf.for %lane = [%begin to %lane_end step %step] {
    %total = scf.for %record = [%begin to %count step %step](%sum = %c0 : i32) -> (i32) {
      %row_offset = index.scale %record, %row_stride : index, offset -> offset
      %row = buffer.view %source[%row_offset] : buffer -> view<32xi32>
      %value = view.load %row[%lane] : view<32xi32> -> i32
      %weight_index = index.add %record, %step : index
      %weight = index.cast %weight_index : index to i32
      %weighted = scalar.muli %value, %weight : i32
      %updated = scalar.addi %sum, %weighted : i32
      scf.yield %updated : i32
    }
    view.store %total, %output_view[%lane] : i32, view<32xi32>
  }
  func.return
}

check.scenario @rotate_value_variants {
  // rotate_values_d1_u1.
  check.trial[9](%count: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(1) step(1) : tensor<8224xi32>
    %output = check.generate.fill value(-99) : tensor<32xi32>
    check.compare<@rotate_values_d1_u1, @rotate_values_oracle>(%count, %input, %output) : (index, tensor<8224xi32>, tensor<32xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<8224xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<32xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %count = check.literal value(257) : index
    %input = check.generate.iota offset(1) step(1) : tensor<8224xi32>
    %output = check.generate.fill value(-99) : tensor<32xi32>
