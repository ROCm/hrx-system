// Replacing the oldest record and rotating leaves records N through N+D-1
// in the returned views. Reading every result also observes the zero-trip
// path and the original initial slot identities.
kernel.def @rotate_view_results_d1_u1() {
  %unit = index.constant 1 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%count0: index, %input: buffer, %output: buffer) {
  %count = index.assume %count0 [range(%count0, 0, 257)] : index
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %depth = index.constant 1 : index
  %unroll = index.constant 1 : index
  %stride = index.constant 128 : offset
  %bytes = index.constant 128 : offset
  %lane = kernel.workitem.id<x> : index
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %source, %destination = buffer.assume.noalias %input_aligned, %output_aligned : buffer, buffer
  %scratch = buffer.alloca<workgroup> align(64) %bytes : buffer
  %offset0 = index.constant 0 : offset
  %slot0 = buffer.view %scratch[%offset0] : buffer -> view<32xi32>
  %initial_source0 = buffer.view %source[%offset0] : buffer -> view<32xi32>
  %initial0 = view.load %initial_source0[%lane] : view<32xi32> -> i32
  view.store %initial0, %slot0[%lane] : i32, view<32xi32>
  %last0 = scf.for %i = [%begin to %count step %step](%current0 = %slot0 : view<32xi32>) -> (view<32xi32>) unroll(%unroll) {
    %next = index.add %i, %depth : index
    %next_offset = index.scale %next, %stride : index, offset -> offset
    %next_source = buffer.view %source[%next_offset] : buffer -> view<32xi32>
    %next_value = view.load %next_source[%lane] : view<32xi32> -> i32
    view.store %next_value, %current0[%lane] : i32, view<32xi32>
    scf.yield %current0 : view<32xi32>
  }
  %result0 = view.load %last0[%lane] : view<32xi32> -> i32
  %output0 = buffer.view %destination[%offset0] : buffer -> view<32xi32>
  view.store %result0, %output0[%lane] : i32, view<32xi32>
  kernel.return
}

