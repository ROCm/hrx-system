// Rotating views reuse one allocation across short, unrolled, and tail loops.
kernel.def @rotate_views_d1_u1() {
  %unit = index.constant 1 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%count0: index, %input: buffer, %output: buffer) {
  %count = index.assume %count0 [range(%count0, 0, 257)] : index
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %base = index.constant 0 : offset
  %row_stride = index.constant 128 : offset
  %storage_bytes = index.constant 128 : offset
  %lead = index.constant 0 : index
  %unroll = index.constant 1 : index
  %initial = scalar.constant 0 : i32
  %lane = kernel.workitem.id<x> : index
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %source, %destination = buffer.assume.noalias %input_aligned, %output_aligned : buffer, buffer
  %scratch = buffer.alloca<workgroup> align(64) %storage_bytes : buffer
  %offset0 = index.constant 0 : offset
  %slot0 = buffer.view %scratch[%offset0] : buffer -> view<32xi32>
  %last0, %total = scf.for %record = [%begin to %count step %step](%current0 = %slot0 : view<32xi32>, %sum = %initial : i32) -> (view<32xi32>, i32) unroll(%unroll) {
    %future_record = index.add %record, %lead : index
    %has_future = index.cmp slt, %future_record, %count : index
    scf.if %has_future {
      %future_row = index.scale %future_record, %row_stride : index, offset -> offset
      %future_source = buffer.view %source[%future_row] : buffer -> view<32xi32>
      %future_value = view.load %future_source[%lane] : view<32xi32> -> i32
      view.store %future_value, %current0[%lane] : i32, view<32xi32>
    }
    %value = view.load %current0[%lane] : view<32xi32> -> i32
    %weight_index = index.add %record, %step : index
    %weight = index.cast %weight_index : index to i32
    %weighted = scalar.muli %value, %weight : i32
    %updated = scalar.addi %sum, %weighted : i32
    scf.yield %current0, %updated : view<32xi32>, i32
  }
  %output_view = buffer.view %destination[%base] : buffer -> view<32xi32>
  view.store %total, %output_view[%lane] : i32, view<32xi32>
  kernel.return
}

