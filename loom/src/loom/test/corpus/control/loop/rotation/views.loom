func.def @rotate_views_oracle(%count0: index, %input: buffer, %output: buffer) {
  %count = index.assume %count0 [range(%count0, 0, 257)] : index
  %begin = index.constant 0 : index
  %lane_end = index.constant 32 : index
  %step = index.constant 1 : index
  %base = index.constant 0 : offset
  %row_stride = index.constant 128 : offset
  %c0 = scalar.constant 0 : i32
  %source = buffer.assume.noalias %input : buffer
  %output_view = buffer.view %output[%base] : buffer -> view<32xi32>
  scf.for %lane = [%begin to %lane_end step %step] {
    %total = scf.for %record = [%begin to %count step %step](%sum = %c0 : i32) -> (i32) {
      %row_offset = index.scale %record, %row_stride : index, offset -> offset
      %row = buffer.view %source[%row_offset] : buffer -> view<32xi32>
      %value = view.load %row[%lane] : view<32xi32> -> i32
      %weight_index = index.add %record, %step : index
      %weight = index.cast %weight_index : index to i32
      %weighted = scalar.muli %value, %weight : i32
      %updated = scalar.addi %sum, %weighted : i32
      scf.yield %updated : i32
    }
    view.store %total, %output_view[%lane] : i32, view<32xi32>
  }
  func.return
}

