// The recurrence replaces the entire vector with freshly computed lanes. A
// runtime trip count preserves the backedge while scalar values avoid a host
// vector ABI.
func.def @vector_recurrence(%a: i32, %b: i32, %count: i64) -> (i32, i32) {
  %initial = vector.from_elements %a, %b : vector<2xi32>
  %begin = index.constant 0 : index
  %count_input = scalar.assume %count [range(%count, 0, 2147483647)] : i64
  %end = index.cast %count_input : i64 to index
  %step = index.constant 1 : index
  %result = scf.for %i = [%begin to %end step %step](%state = %initial : vector<2xi32>) -> (vector<2xi32>) {
    %x = vector.extract %state[0] : vector<2xi32> -> i32
    %y = vector.extract %state[1] : vector<2xi32> -> i32
    %sum = scalar.addi %x, %y : i32
    %next = vector.from_elements %y, %sum : vector<2xi32>
    scf.yield %next : vector<2xi32>
  }
  %x = vector.extract %result[0] : vector<2xi32> -> i32
  %y = vector.extract %result[1] : vector<2xi32> -> i32
  func.return %x, %y : i32, i32
}

func.def @vector_recurrence_observations(%a_entropy: i64, %b_entropy: i64, %count: index, %output: buffer) {
  %a = scalar.trunci %a_entropy : i64 to i32
  %b = scalar.trunci %b_entropy : i64 to i32
  %count_value = index.cast %count : index to i64
  %x, %y = func.call @vector_recurrence(%a, %b, %count_value) : (i32, i32, i64) -> (i32, i32)
  %values = vector.from_elements %x, %y : vector<2xi32>
  %origin = index.constant 0 : offset
  %results = buffer.view %output[%origin] : buffer -> view<2xi32>
  vector.store %values, %results[0] : vector<2xi32>, view<2xi32>
  func.return
}

check.scenario @vector_recurrence_values {
  check.trial[16](%trial: index, %entropy: check.entropy) {
    %a_source = check.entropy.fork %entropy name("a") : check.entropy
    %b_source = check.entropy.fork %entropy name("b") : check.entropy
    %a = check.entropy.read %a_source[%trial] : check.entropy -> i64
    %b = check.entropy.read %b_source[%trial] : check.entropy -> i64
    %output = check.generate.fill value(0) : tensor<2xi32>
    check.compare<@vector_recurrence_observations>(%a, %b, %trial, %output) : (i64, i64, index, tensor<2xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<2xi32>
    }
  }
  check.return
}

// A packed row-major history crosses both the loop boundary and a native packet
// boundary. Each step drops one row and appends the current row. Compare raw
// bits so every BF16 payload, including NaNs, is preserved without arithmetic.
func.def @packed_history(%input: buffer, %output: buffer, %count: index) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<10x4xbf16>
  %destination = buffer.view %output[%base] : buffer -> view<9x4xbf16>
  %initial = vector.load %source[0, 0] : view<10x4xbf16> -> vector<9x4xbf16>
  %current = vector.load %source[9, 0] : view<10x4xbf16> -> vector<4xbf16>
  %final = scf.for %iteration = [%c0 to %count step %c1](%old = %initial : vector<9x4xbf16>) -> (vector<9x4xbf16>) {
    %tail = vector.slice %old[1, 0] : vector<9x4xbf16> -> vector<8x4xbf16>
    %row = vector.broadcast %current : vector<4xbf16> -> vector<1x4xbf16>
    %next = vector.concat<0> %tail, %row : vector<8x4xbf16>, vector<1x4xbf16> -> vector<9x4xbf16>
    scf.yield %next : vector<9x4xbf16>
  }
  vector.store %final, %destination[0, 0] : vector<9x4xbf16>, view<9x4xbf16>
  func.return
}

// Select the surviving source row directly, without vector operations or a
// recurrence. Counts past the history depth replace every row.
func.def @packed_history_oracle(%input: buffer, %output: buffer, %count: index) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %width = index.constant 4 : index
  %depth = index.constant 9 : index
  %elements = index.constant 36 : index
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<40xi16>
  %destination = buffer.view %output[%base] : buffer -> view<36xi16>
  %nonnegative = index.max %count, %c0 : index
  %distance = index.min %nonnegative, %depth : index
  scf.for %position = [%c0 to %elements step %c1] {
    %row = index.div %position, %width : index
    %column = index.rem %position, %width : index
    %shifted_row = index.add %row, %distance : index
    %source_row = index.min %shifted_row, %depth : index
    %source_position = index.madd %source_row, %width, %column : index
    %value = view.load %source[%source_position] : view<40xi16> -> i16
    view.store %value, %destination[%position] : i16, view<36xi16>
  }
  func.return
}

check.scenario @packed_history_values {
  check.trial[11](%count: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-32768) step(1680) : tensor<40xi16>
    %storage = check.generate.fill value(23130) : tensor<44xi16>
    %output = check.tensor.view %storage offset(8) : tensor<44xi16> -> tensor<36xi16>
    check.compare<@packed_history, @packed_history_oracle>(%input, %output, %count) : (tensor<40xi16>, tensor<36xi16>, index) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<40xi16>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<44xi16>
    }
  }
  check.return
}

// A wide accumulator crosses a nested conditional and a loop backedge.
// Its trailing lanes must retain the same recurrence as its complete packets.
func.def @wide_conditional_accumulation(%input: buffer, %output: buffer, %iteration_count: index, %scale: f32, %enabled: i1) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %input_noalias, %output_noalias = buffer.assume.noalias %input, %output : buffer, buffer
  %input_view = buffer.view %input_noalias[%base] : buffer -> view<36xf32>
  %output_view = buffer.view %output_noalias[%base] : buffer -> view<36xf32>
  %c0 = scalar.constant 0.0 : f32
  %initial = vector.splat %c0 : vector<36xf32>
  %result = scf.for %iteration = [%begin to %iteration_count step %step](%accumulator = %initial : vector<36xf32>) -> (vector<36xf32>) {
    %next = scf.if %enabled -> (vector<36xf32>) {
      %values = vector.load %input_view[0] : view<36xf32> -> vector<36xf32>
      %scales = vector.splat %scale : vector<36xf32>
      %updated = vector.fmaf %values, %scales, %accumulator : vector<36xf32>
      scf.yield %updated : vector<36xf32>
    } else {
      scf.yield %accumulator : vector<36xf32>
    }
    scf.yield %next : vector<36xf32>
  }
  vector.store %result, %output_view[0] : vector<36xf32>, view<36xf32>
  func.return
}

// The inputs and scale are exact binary fractions, so multiplication by the
// iteration count is an independent exact oracle for repeated accumulation.
func.def @wide_conditional_accumulation_oracle(%input: buffer, %output: buffer, %iteration_count: index, %scale: f32, %enabled: i1) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 36 : index
  %step = index.constant 1 : index
  %source = buffer.view %input[%base] : buffer -> view<36xf32>
  %destination = buffer.view %output[%base] : buffer -> view<36xf32>
  %count_word = index.cast %iteration_count : index to i32
  %count = scalar.sitofp %count_word : i32 to f32
  %factor = scalar.mulf %count, %scale : f32
  %nonempty = index.cmp sgt, %iteration_count, %begin : index
  %active = scalar.andi %nonempty, %enabled : i1
  %initial = scalar.constant 0.0 : f32
  scf.for %position = [%begin to %end step %step] {
    %value = view.load %source[%position] : view<36xf32> -> f32
    %scaled = scalar.mulf %value, %factor : f32
    %result = scf.select %active, %scaled, %initial : f32
    view.store %result, %destination[%position] : f32, view<36xf32>
  }
  func.return
}

func.def @wide_accumulation_inputs(%trial: index) -> (index, i1) {
  %c0 = index.constant 0 : index
  %c2 = index.constant 2 : index
  %count = index.div %trial, %c2 : index
  %parity = index.rem %trial, %c2 : index
  %enabled = index.cmp ne, %parity, %c0 : index
  func.return %count, %enabled : index, i1
}

check.scenario @wide_conditional_accumulation_values {
  check.trial[16](%trial: index, %entropy: check.entropy) {
    %count, %enabled = check.generate<@wide_accumulation_inputs>(%trial) : (index) -> (index, i1)
    %input = check.generate.iota offset(-4.5) step(0.25) : tensor<36xf32>
    %storage = check.generate.fill value(-777.0) : tensor<44xf32>
    %output = check.tensor.view %storage offset(16) : tensor<44xf32> -> tensor<36xf32>
    %scale = check.literal value(0.5) : f32
    check.compare<@wide_conditional_accumulation, @wide_conditional_accumulation_oracle>(%input, %output, %count, %scale, %enabled) : (tensor<36xf32>, tensor<36xf32>, index, f32, i1) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<36xf32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<44xf32>
    }
  }
  check.return
}

// A shaped bank retains its original load across an intervening overwrite,
// nested loops, and a branch. Runtime rows select whole native packets, then
// insert the updated row into the next iteration's bank.
func.def @dynamic_row_bank(%input: buffer, %output: buffer, %row_count: index, %rounds: index, %enabled: i1) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<16xi32>
  %destination = buffer.view %output[%base] : buffer -> view<16xi32>
  %loaded = vector.load %source[0] : view<16xi32> -> vector<16xi32>
  %initial = vector.bitcast %loaded : vector<16xi32> to vector<4x4xi32>
  %replacement = scalar.constant 12345 : i32
  view.store %replacement, %source[0] : i32, view<16xi32>
  %nonnegative_rows = index.max %row_count, %c0 : index
  %rows = index.min %nonnegative_rows, %c4 : index
  %nonnegative_rounds = index.max %rounds, %c0 : index
  %end = index.min %nonnegative_rounds, %c4 : index
  %result = scf.for %iteration = [%c0 to %end step %c1](%state = %initial : vector<4x4xi32>) -> (vector<4x4xi32>) {
    %next = scf.if %enabled -> (vector<4x4xi32>) {
      %updated = scf.for %row = [%c0 to %rows step %c1](%bank = %state : vector<4x4xi32>) -> (vector<4x4xi32>) {
        %values = vector.extract %bank[%row] : vector<4x4xi32> -> vector<4xi32>
        %doubled = vector.addi %values, %values : vector<4xi32>
        %changed = vector.insert %doubled into %bank[%row] : vector<4xi32>, vector<4x4xi32>
        scf.yield %changed : vector<4x4xi32>
      }
      scf.yield %updated : vector<4x4xi32>
    } else {
      scf.yield %state : vector<4x4xi32>
    }
    scf.yield %next : vector<4x4xi32>
  }
  %flat = vector.bitcast %result : vector<4x4xi32> to vector<16xi32>
  vector.store %flat, %destination[0] : vector<16xi32>, view<16xi32>
  func.return
}

// Compute each final lane directly, without a vector or row recurrence. The
// input overwrite happens last so the oracle reads the original scalar values.
func.def @dynamic_row_bank_oracle(%input: buffer, %output: buffer, %row_count: index, %rounds: index, %enabled: i1) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c16 = index.constant 16 : index
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<16xi32>
  %destination = buffer.view %output[%base] : buffer -> view<16xi32>
  %nonnegative = index.max %rounds, %c0 : index
  %bounded = index.min %nonnegative, %c4 : index
  %shift = index.cast %bounded : index to i32
  %c1_word = scalar.constant 1 : i32
  %factor = scalar.shli %c1_word, %shift : i32
  scf.for %position = [%c0 to %c16 step %c1] {
    %row = index.div %position, %c4 : index
    %selected = index.cmp slt, %row, %row_count : index
    %active = scalar.andi %selected, %enabled : i1
    %value = view.load %source[%position] : view<16xi32> -> i32
    %scaled = scalar.muli %value, %factor : i32
    %result = scf.select %active, %scaled, %value : i32
    view.store %result, %destination[%position] : i32, view<16xi32>
  }
  %replacement = scalar.constant 12345 : i32
  view.store %replacement, %source[0] : i32, view<16xi32>
  func.return
}

func.def @dynamic_row_bank_inputs(%trial: index) -> (index, index, i1) {
  %c0 = index.constant 0 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c7 = index.constant 7 : index
  %parity = index.rem %trial, %c2 : index
  %enabled = index.cmp ne, %parity, %c0 : index
  %pair = index.div %trial, %c2 : index
  %rows = index.rem %pair, %c7 : index
  %rounds = index.div %pair, %c7 : index
  %iterations = index.mul %rounds, %c3 : index
  func.return %rows, %iterations, %enabled : index, index, i1
}

check.scenario @dynamic_row_bank_values {
  check.trial[42](%trial: index, %entropy: check.entropy) {
    %rows, %rounds, %enabled = check.generate<@dynamic_row_bank_inputs>(%trial) : (index) -> (index, index, i1)
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-100 to 100) : tensor<16xi32>
    %storage = check.generate.fill value(-777) : tensor<24xi32>
    %output = check.tensor.view %storage offset(16) : tensor<24xi32> -> tensor<16xi32>
    check.compare<@dynamic_row_bank, @dynamic_row_bank_oracle>(%input, %output, %rows, %rounds, %enabled) : (tensor<16xi32>, tensor<16xi32>, index, index, i1) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<16xi32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<24xi32>
    }
  }
  check.return
}

// Three packets rotate through a counted loop and through both regions of a
// condition loop. The condition region rotates even on the terminal check.
func.def @packet_rotation(%input: buffer, %output: buffer, %count: index) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c6 = index.constant 6 : index
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<12xi32>
  %destination = buffer.view %output[%base] : buffer -> view<12xi32>
  %initial = vector.load %source[0] : view<12xi32> -> vector<12xi32>
  %nonnegative = index.max %count, %c0 : index
  %end = index.min %nonnegative, %c6 : index
  %counted = scf.for %iteration = [%c0 to %end step %c1](%state = %initial : vector<12xi32>) -> (vector<12xi32>) {
    %first = vector.slice %state[0] : vector<12xi32> -> vector<4xi32>
    %tail = vector.slice %state[4] : vector<12xi32> -> vector<8xi32>
    %rotated = vector.concat<0> %tail, %first : vector<8xi32>, vector<4xi32> -> vector<12xi32>
    scf.yield %rotated : vector<12xi32>
  }
  %remaining, %result = scf.while(%before_count = %end : index, %state = %counted : vector<12xi32>) -> (index, vector<12xi32>) {
    %first = vector.slice %state[0] : vector<12xi32> -> vector<4xi32>
    %tail = vector.slice %state[4] : vector<12xi32> -> vector<8xi32>
    %forwarded = vector.concat<0> %tail, %first : vector<8xi32>, vector<4xi32> -> vector<12xi32>
    %more = index.cmp sgt, %before_count, %c0 : index
    scf.condition %more, %before_count, %forwarded : i1, index, vector<12xi32>
  } do(%body_count: index, %body: vector<12xi32>) {
    %next_count = index.sub %body_count, %c1 : index
    scf.yield %next_count, %body : index, vector<12xi32>
  }
  vector.store %result, %destination[0] : vector<12xi32>, view<12xi32>
  func.return
}

// Compute the source position directly instead of carrying a vector around
// either recurrence. Full-buffer comparisons also observe output sentinels.
func.def @packet_rotation_oracle(%input: buffer, %output: buffer, %count: index) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c6 = index.constant 6 : index
  %c12 = index.constant 12 : index
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<12xi32>
  %destination = buffer.view %output[%base] : buffer -> view<12xi32>
  %nonnegative = index.max %count, %c0 : index
  %bounded = index.min %nonnegative, %c6 : index
  %rotations = index.madd %bounded, %c2, %c1 : index
  %distance = index.mul %rotations, %c4 : index
  scf.for %position = [%c0 to %c12 step %c1] {
    %shifted = index.add %position, %distance : index
    %source_position = index.rem %shifted, %c12 : index
    %value = view.load %source[%source_position] : view<12xi32> -> i32
    view.store %value, %destination[%position] : i32, view<12xi32>
  }
  func.return
}

check.scenario @packet_rotation_values {
  check.trial[8](%count: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%count] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-1000 to 1000) : tensor<12xi32>
    %storage = check.generate.fill value(-777) : tensor<20xi32>
    %output = check.tensor.view %storage offset(16) : tensor<20xi32> -> tensor<12xi32>
    check.compare<@packet_rotation, @packet_rotation_oracle>(%input, %output, %count) : (tensor<12xi32>, tensor<12xi32>, index) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<12xi32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<20xi32>
    }
  }
  check.return
}
