// The recurrence replaces the entire vector with freshly computed lanes. A
// runtime trip count preserves the backedge while scalar values avoid a host
// vector ABI.
func.def @vector_recurrence(%a: i32, %b: i32, %count: i64) -> (i32, i32) {
  %initial = vector.from_elements %a, %b : vector<2xi32>
  %begin = index.constant 0 : index
  %count_input = scalar.assume %count [range(%count, 0, 2147483647)] : i64
  %end = index.cast %count_input : i64 to index
  %step = index.constant 1 : index
  %result = scf.for %i = [%begin to %end step %step](%state = %initial : vector<2xi32>) -> (vector<2xi32>) {
    %x = vector.extract %state[0] : vector<2xi32> -> i32
    %y = vector.extract %state[1] : vector<2xi32> -> i32
    %sum = scalar.addi %x, %y : i32
    %next = vector.from_elements %y, %sum : vector<2xi32>
    scf.yield %next : vector<2xi32>
  }
  %x = vector.extract %result[0] : vector<2xi32> -> i32
  %y = vector.extract %result[1] : vector<2xi32> -> i32
  func.return %x, %y : i32, i32
}

func.def @vector_recurrence_observations(%a_entropy: i64, %b_entropy: i64, %count: index, %output: buffer) {
  %a = scalar.trunci %a_entropy : i64 to i32
  %b = scalar.trunci %b_entropy : i64 to i32
  %count_value = index.cast %count : index to i64
  %x, %y = func.call @vector_recurrence(%a, %b, %count_value) : (i32, i32, i64) -> (i32, i32)
  %values = vector.from_elements %x, %y : vector<2xi32>
  %origin = index.constant 0 : offset
  %results = buffer.view %output[%origin] : buffer -> view<2xi32>
  vector.store %values, %results[0] : vector<2xi32>, view<2xi32>
  func.return
}

check.scenario @vector_recurrence_values {
  check.trial[16](%trial: index, %entropy: check.entropy) {
    %a_source = check.entropy.fork %entropy name("a") : check.entropy
    %b_source = check.entropy.fork %entropy name("b") : check.entropy
    %a = check.entropy.read %a_source[%trial] : check.entropy -> i64
    %b = check.entropy.read %b_source[%trial] : check.entropy -> i64
    %output = check.generate.fill value(0) : tensor<2xi32>
    check.compare<@vector_recurrence_observations>(%a, %b, %trial, %output) : (i64, i64, index, tensor<2xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<2xi32>
    }
  }
  check.return
}

// A packed row-major history crosses both the loop boundary and a native packet
// boundary. Each step drops one row and appends the current row. Compare raw
// bits so every BF16 payload, including NaNs, is preserved without arithmetic.
func.def @packed_history(%input: buffer, %output: buffer, %count: index) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<10x4xbf16>
  %destination = buffer.view %output[%base] : buffer -> view<9x4xbf16>
  %initial = vector.load %source[0, 0] : view<10x4xbf16> -> vector<9x4xbf16>
  %current = vector.load %source[9, 0] : view<10x4xbf16> -> vector<4xbf16>
  %final = scf.for %iteration = [%c0 to %count step %c1](%old = %initial : vector<9x4xbf16>) -> (vector<9x4xbf16>) {
    %tail = vector.slice %old[1, 0] : vector<9x4xbf16> -> vector<8x4xbf16>
    %row = vector.broadcast %current : vector<4xbf16> -> vector<1x4xbf16>
    %next = vector.concat<0> %tail, %row : vector<8x4xbf16>, vector<1x4xbf16> -> vector<9x4xbf16>
    scf.yield %next : vector<9x4xbf16>
  }
  vector.store %final, %destination[0, 0] : vector<9x4xbf16>, view<9x4xbf16>
  func.return
}

// Select the surviving source row directly, without vector operations or a
// recurrence. Counts past the history depth replace every row.
func.def @packed_history_oracle(%input: buffer, %output: buffer, %count: index) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %width = index.constant 4 : index
  %depth = index.constant 9 : index
  %elements = index.constant 36 : index
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<40xi16>
  %destination = buffer.view %output[%base] : buffer -> view<36xi16>
  %nonnegative = index.max %count, %c0 : index
  %distance = index.min %nonnegative, %depth : index
  scf.for %position = [%c0 to %elements step %c1] {
    %row = index.div %position, %width : index
    %column = index.rem %position, %width : index
    %shifted_row = index.add %row, %distance : index
    %source_row = index.min %shifted_row, %depth : index
    %source_position = index.madd %source_row, %width, %column : index
    %value = view.load %source[%source_position] : view<40xi16> -> i16
    view.store %value, %destination[%position] : i16, view<36xi16>
  }
  func.return
}

check.scenario @packed_history_values {
  check.trial[11](%count: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-32768) step(1680) : tensor<40xi16>
    %storage = check.generate.fill value(23130) : tensor<44xi16>
    %output = check.tensor.view %storage offset(8) : tensor<44xi16> -> tensor<36xi16>
    check.compare<@packed_history, @packed_history_oracle>(%input, %output, %count) : (tensor<40xi16>, tensor<36xi16>, index) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<40xi16>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<44xi16>
    }
  }
  check.return
}
