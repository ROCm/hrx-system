// RUN: roundtrip

func.def @workgroup_static_rank2_i32(%value: i32) -> (i32) {
  %byte_length = index.constant 256 : offset
  %base = index.constant 8 : offset
  %scratch = buffer.alloca<workgroup> align(4) %byte_length : buffer
  %scratch_view = buffer.view %scratch[%base] : buffer -> view<4x8xi32>
  view.store %value, %scratch_view[2, 3] : i32, view<4x8xi32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %loaded = view.load %scratch_view[2, 3] : view<4x8xi32> -> i32
  func.return %loaded : i32
}

// ====

func.def @workgroup_dynamic_base_and_index_i32(%value: i32, %base_element: index, %element: index) -> (i32) {
  %byte_length = index.constant 128 : offset
  %element_byte_count = index.constant 4 : index
  %base_element_bounded = index.assume %base_element [range(%base_element, 0, 15)] : index
  %element_bounded = index.assume %element [range(%element, 0, 7)] : index
  %base_byte_index = index.mul %base_element_bounded, %element_byte_count : index
  %base_byte_offset = index.cast %base_byte_index : index to offset
  %scratch = buffer.alloca<workgroup> align(4) %byte_length : buffer
  %scratch_view = buffer.view %scratch[%base_byte_offset] : buffer -> view<8xi32>
  view.store %value, %scratch_view[%element_bounded] : i32, view<8xi32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %loaded = view.load %scratch_view[%element_bounded] : view<8xi32> -> i32
  func.return %loaded : i32
}

// ====

func.def @workgroup_dynamic_stride_rank2_i32(%value: i32, %column_count: index, %row: index, %column: index) -> (i32) {
  %byte_length = index.constant 128 : offset
  %scratch_base = index.constant 0 : offset
  %column_count_bounded = index.assume %column_count [range(%column_count, 1, 8)] : index
  %row_bounded = index.assume %row [range(%row, 0, 3)] : index
  %column_bounded = index.assume %column [range(%column, 0, 7), lt(%column, %column_count_bounded)] : index
  %scratch = buffer.alloca<workgroup> align(4) %byte_length : buffer
  %scratch_view = buffer.view %scratch[%scratch_base] : buffer -> view<4x[%column_count_bounded]xi32>
  view.store %value, %scratch_view[%row_bounded, %column_bounded] : i32, view<4x[%column_count_bounded]xi32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %loaded = view.load %scratch_view[%row_bounded, %column_bounded] : view<4x[%column_count_bounded]xi32> -> i32
  func.return %loaded : i32
}

// ====

func.def @workgroup_subview_refine_i32(%value: i32, %element: index) -> (i32) {
  %byte_length = index.constant 64 : offset
  %base = index.constant 4 : offset
  %element_bounded = index.assume %element [range(%element, 0, 3)] : index
  %scratch = buffer.alloca<workgroup> align(4) %byte_length : buffer
  %scratch_view = buffer.view %scratch[%base] : buffer -> view<8xi32>
  %scratch_subview = view.subview %scratch_view[2] : view<8xi32> -> view<4xi32>
  %scratch_refined = view.refine %scratch_subview : view<4xi32> -> view<4xi32>
  view.store %value, %scratch_refined[%element_bounded] : i32, view<4xi32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %loaded = view.load %scratch_refined[%element_bounded] : view<4xi32> -> i32
  func.return %loaded : i32
}

// ====

func.def @workgroup_integer_scalar_widths(%value_i8: i8, %value_i16: i16, %value_i32: i32, %value_i64: i64) -> (i8, i16, i32, i64) {
  %byte_length = index.constant 16 : offset
  %scratch_base = index.constant 0 : offset
  %scratch_i8 = buffer.alloca<workgroup> align(1) %byte_length : buffer
  %scratch_i16 = buffer.alloca<workgroup> align(2) %byte_length : buffer
  %scratch_i32 = buffer.alloca<workgroup> align(4) %byte_length : buffer
  %scratch_i64 = buffer.alloca<workgroup> align(8) %byte_length : buffer
  %view_i8 = buffer.view %scratch_i8[%scratch_base] : buffer -> view<2xi8>
  %view_i16 = buffer.view %scratch_i16[%scratch_base] : buffer -> view<2xi16>
  %view_i32 = buffer.view %scratch_i32[%scratch_base] : buffer -> view<2xi32>
  %view_i64 = buffer.view %scratch_i64[%scratch_base] : buffer -> view<2xi64>
  view.store %value_i8, %view_i8[1] : i8, view<2xi8>
  view.store %value_i16, %view_i16[1] : i16, view<2xi16>
  view.store %value_i32, %view_i32[1] : i32, view<2xi32>
  view.store %value_i64, %view_i64[1] : i64, view<2xi64>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %loaded_i8 = view.load %view_i8[1] : view<2xi8> -> i8
  %loaded_i16 = view.load %view_i16[1] : view<2xi16> -> i16
  %loaded_i32 = view.load %view_i32[1] : view<2xi32> -> i32
  %loaded_i64 = view.load %view_i64[1] : view<2xi64> -> i64
  func.return %loaded_i8, %loaded_i16, %loaded_i32, %loaded_i64 : i8, i16, i32, i64
}

// ====

func.def @workgroup_float_scalar_widths(%value_f16: f16, %value_bf16: bf16, %value_f32: f32, %value_f64: f64) -> (f16, bf16, f32, f64) {
  %byte_length = index.constant 16 : offset
  %scratch_base = index.constant 0 : offset
  %scratch_f16 = buffer.alloca<workgroup> align(2) %byte_length : buffer
  %scratch_bf16 = buffer.alloca<workgroup> align(2) %byte_length : buffer
  %scratch_f32 = buffer.alloca<workgroup> align(4) %byte_length : buffer
  %scratch_f64 = buffer.alloca<workgroup> align(8) %byte_length : buffer
  %view_f16 = buffer.view %scratch_f16[%scratch_base] : buffer -> view<2xf16>
  %view_bf16 = buffer.view %scratch_bf16[%scratch_base] : buffer -> view<2xbf16>
  %view_f32 = buffer.view %scratch_f32[%scratch_base] : buffer -> view<2xf32>
  %view_f64 = buffer.view %scratch_f64[%scratch_base] : buffer -> view<2xf64>
  view.store %value_f16, %view_f16[1] : f16, view<2xf16>
  view.store %value_bf16, %view_bf16[1] : bf16, view<2xbf16>
  view.store %value_f32, %view_f32[1] : f32, view<2xf32>
  view.store %value_f64, %view_f64[1] : f64, view<2xf64>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %loaded_f16 = view.load %view_f16[1] : view<2xf16> -> f16
  %loaded_bf16 = view.load %view_bf16[1] : view<2xbf16> -> bf16
  %loaded_f32 = view.load %view_f32[1] : view<2xf32> -> f32
  %loaded_f64 = view.load %view_f64[1] : view<2xf64> -> f64
  func.return %loaded_f16, %loaded_bf16, %loaded_f32, %loaded_f64 : f16, bf16, f32, f64
}
