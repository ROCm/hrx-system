// RUN: roundtrip

func.def @wide_shift_constant(%values: vector<2xi64>) -> (i64) {
  %value = vector.extract %values[0] : vector<2xi64> -> i64
  %count = scalar.constant 31 : i64
  %shifted = scalar.shli %value, %count : i64
  func.return %shifted : i64
}

// ====

func.def @wide_shift_uniform(%values: vector<2xi64>, %count: i64) -> (i64) {
  %value = vector.extract %values[0] : vector<2xi64> -> i64
  %shifted = scalar.shli %value, %count : i64
  func.return %shifted : i64
}

// ====

func.def @wide_shift_varying(%values: vector<2xi64>, %counts: vector<2xi64>) -> (i64) {
  %value = vector.extract %values[0] : vector<2xi64> -> i64
  %count = vector.extract %counts[0] : vector<2xi64> -> i64
  %shifted = scalar.shli %value, %count : i64
  func.return %shifted : i64
}

// ====

func.def @wide_right_shift_uniform(%value: i64, %count: i64) -> (i64, i64) {
  %logical = scalar.shrui %value, %count : i64
  %signed = scalar.shrsi %value, %count : i64
  func.return %logical, %signed : i64, i64
}

// ====

func.def @wide_right_shift_uniform_count(%values: vector<2xi64>, %count: i64) -> (i64, i64) {
  %value = vector.extract %values[1] : vector<2xi64> -> i64
  %logical = scalar.shrui %value, %count : i64
  %signed = scalar.shrsi %value, %count : i64
  func.return %logical, %signed : i64, i64
}

// ====

func.def @wide_right_shift_varying_count(%values: vector<2xi64>, %counts: vector<2xi64>) -> (i64, i64) {
  %value = vector.extract %values[1] : vector<2xi64> -> i64
  %count = vector.extract %counts[1] : vector<2xi64> -> i64
  %logical = scalar.shrui %value, %count : i64
  %signed = scalar.shrsi %value, %count : i64
  func.return %logical, %signed : i64, i64
}

// ====

func.def @wide_right_shift_constant(%values: vector<2xi64>) -> (i64, i64) {
  %value = vector.extract %values[1] : vector<2xi64> -> i64
  %count = scalar.constant 31 : i64
  %logical = scalar.shrui %value, %count : i64
  %signed = scalar.shrsi %value, %count : i64
  func.return %logical, %signed : i64, i64
}

// ====

func.def @wide_shift_word_boundaries(%value: i64) -> (i64, i64, i64, i64) {
  %identity_count = scalar.constant 0 : i64
  %last_low = scalar.constant 31 : i64
  %first_high = scalar.constant 32 : i64
  %last_high = scalar.constant 63 : i64
  %unchanged = scalar.shli %value, %identity_count : i64
  %low_edge = scalar.shli %value, %last_low : i64
  %high_edge = scalar.shli %value, %first_high : i64
  %top_bit = scalar.shli %value, %last_high : i64
  func.return %unchanged, %low_edge, %high_edge, %top_bit : i64, i64, i64, i64
}

// ====

func.def @wide_shift_low_word(%value: i64) -> (i32) {
  %count = scalar.constant 6 : i64
  %shifted = scalar.shli %value, %count : i64
  %result = scalar.trunci %shifted : i64 to i32
  func.return %result : i32
}

// ====

func.def @wide_shift_bounded_low(%value: i64, %count_input: i64) -> (i64) {
  %count = scalar.assume %count_input [range(%count_input, 0, 31)] : i64
  %shifted = scalar.shli %value, %count : i64
  func.return %shifted : i64
}

// ====

func.def @wide_shift_bounded_high(%value: i64, %count_input: i64) -> (i64) {
  %count = scalar.assume %count_input [range(%count_input, 32, 63)] : i64
  %shifted = scalar.shli %value, %count : i64
  func.return %shifted : i64
}

// ====

func.def @wide_shift_crossing_words(%value: i64, %count_input: i64) -> (i64) {
  %count = scalar.assume %count_input [range(%count_input, 31, 32)] : i64
  %shifted = scalar.shli %value, %count : i64
  func.return %shifted : i64
}

// ====

func.def @wide_shift_bounded_nonzero_low(%value: i64, %count_input: i64) -> (i64) {
  %count = scalar.assume %count_input [range(%count_input, 1, 31)] : i64
  %shifted = scalar.shli %value, %count : i64
  func.return %shifted : i64
}

// ====

// Word controls qualify the native pieces used by split-word lowering.
func.def @word_right_shift_constants(%value: i32) -> (i32, i32, i32, i32, i32, i32, i32) {
  %identity_count = scalar.constant 0 : i32
  %single_bit = scalar.constant 1 : i32
  %middle = scalar.constant 16 : i32
  %last = scalar.constant 31 : i32
  %unchanged = scalar.shrui %value, %identity_count : i32
  %logical_one = scalar.shrui %value, %single_bit : i32
  %signed_one = scalar.shrsi %value, %single_bit : i32
  %logical_middle = scalar.shrui %value, %middle : i32
  %signed_middle = scalar.shrsi %value, %middle : i32
  %logical_last = scalar.shrui %value, %last : i32
  %signed_last = scalar.shrsi %value, %last : i32
  func.return %unchanged, %logical_one, %signed_one, %logical_middle, %signed_middle, %logical_last, %signed_last : i32, i32, i32, i32, i32, i32, i32
}

// ====

func.def @word_right_shift_dynamic(%value: i32, %count: i32) -> (i32, i32) {
  %logical = scalar.shrui %value, %count : i32
  %signed = scalar.shrsi %value, %count : i32
  func.return %logical, %signed : i32, i32
}

// ====

func.def @wide_right_shift_word_boundaries(%value: i64) -> (i64, i64, i64, i64, i64, i64, i64, i64) {
  %identity_count = scalar.constant 0 : i64
  %last_low = scalar.constant 31 : i64
  %first_high = scalar.constant 32 : i64
  %last_high = scalar.constant 63 : i64
  %logical_identity = scalar.shrui %value, %identity_count : i64
  %signed_identity = scalar.shrsi %value, %identity_count : i64
  %logical_low_edge = scalar.shrui %value, %last_low : i64
  %signed_low_edge = scalar.shrsi %value, %last_low : i64
  %logical_high_edge = scalar.shrui %value, %first_high : i64
  %signed_high_edge = scalar.shrsi %value, %first_high : i64
  %logical_top = scalar.shrui %value, %last_high : i64
  %signed_top = scalar.shrsi %value, %last_high : i64
  func.return %logical_identity, %signed_identity, %logical_low_edge, %signed_low_edge, %logical_high_edge, %signed_high_edge, %logical_top, %signed_top : i64, i64, i64, i64, i64, i64, i64, i64
}

// ====

func.def @wide_right_shift_bounded_low(%value: i64, %count_input: i64) -> (i64, i64) {
  %count = scalar.assume %count_input [range(%count_input, 0, 31)] : i64
  %logical = scalar.shrui %value, %count : i64
  %signed = scalar.shrsi %value, %count : i64
  func.return %logical, %signed : i64, i64
}

// ====

func.def @wide_right_shift_bounded_nonzero_low(%value: i64, %count_input: i64) -> (i64, i64) {
  %count = scalar.assume %count_input [range(%count_input, 1, 31)] : i64
  %logical = scalar.shrui %value, %count : i64
  %signed = scalar.shrsi %value, %count : i64
  func.return %logical, %signed : i64, i64
}

// ====

func.def @wide_right_shift_bounded_high(%value: i64, %count_input: i64) -> (i64, i64) {
  %count = scalar.assume %count_input [range(%count_input, 32, 63)] : i64
  %logical = scalar.shrui %value, %count : i64
  %signed = scalar.shrsi %value, %count : i64
  func.return %logical, %signed : i64, i64
}

// ====

func.def @wide_right_shift_crossing_words(%value: i64, %count_input: i64) -> (i64, i64) {
  %count = scalar.assume %count_input [range(%count_input, 31, 32)] : i64
  %logical = scalar.shrui %value, %count : i64
  %signed = scalar.shrsi %value, %count : i64
  func.return %logical, %signed : i64, i64
}

// ====

// All three shifts preserve their input and the count for later arithmetic.
func.def @word_shifts_reuse_input(%value: i32, %count: i32) -> (i32) {
  %left = scalar.shli %value, %count : i32
  %logical = scalar.shrui %value, %count : i32
  %signed = scalar.shrsi %value, %count : i32
  %directions = scalar.xori %left, %logical : i32
  %combined = scalar.xori %directions, %signed : i32
  %with_count = scalar.addi %combined, %count : i32
  %result = scalar.xori %with_count, %value : i32
  func.return %result : i32
}

// ====

func.def @wide_shifts_reuse_counts(%value: i64, %left_count: i64, %right_count: i64) -> (i64) {
  %left = scalar.shli %value, %left_count : i64
  %logical = scalar.shrui %value, %right_count : i64
  %signed = scalar.shrsi %left, %left_count : i64
  %directions = scalar.xori %logical, %signed : i64
  %with_left_count = scalar.addi %directions, %left_count : i64
  %with_counts = scalar.addi %with_left_count, %right_count : i64
  %result = scalar.xori %with_counts, %value : i64
  func.return %result : i64
}

// ====

func.def @wide_shift_value_is_count(%input: i64) -> (i64) {
  %mask = scalar.constant 63 : i64
  %value = scalar.andi %input, %mask : i64
  %result = scalar.shli %value, %value : i64
  func.return %result : i64
}

// ====

func.def @index_shift_dynamic(%value: index, %count: index) -> (index, index) {
  %left = index.shli %value, %count : index
  %right = index.shrui %value, %count : index
  func.return %left, %right : index, index
}

// ====

func.def @index_shift_constant_four(%value: index) -> (index) {
  %count = index.constant 4 : index
  %result = index.shli %value, %count : index
  func.return %result : index
}
