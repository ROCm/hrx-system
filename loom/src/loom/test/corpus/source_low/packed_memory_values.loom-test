// ====

func.def @uniform_bf16(%input: buffer) -> (vector<4xf32>) {
  %source = buffer.assume.alignment %input {minimum_alignment = 64} : buffer
  %c0 = index.constant 0 : offset
  %source_view = buffer.view %source[%c0] : buffer -> view<4xbf16>
  %value = vector.load %source_view[0] : view<4xbf16> -> vector<4xbf16>
  %result = vector.extf %value : vector<4xbf16> to vector<4xf32>
  func.return %result : vector<4xf32>
}

