// ====

func.def @uniform_f16_extf(%input: buffer) -> (vector<4xf32>) {
  %source = buffer.assume.alignment %input {minimum_alignment = 64} : buffer
  %c0 = index.constant 0 : offset
  %source_view = buffer.view %source[%c0] : buffer -> view<4xf16>
  %value = vector.load %source_view[0] : view<4xf16> -> vector<4xf16>
  %result = vector.extf %value : vector<4xf16> to vector<4xf32>
