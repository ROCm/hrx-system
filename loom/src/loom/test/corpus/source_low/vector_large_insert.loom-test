// RUN: roundtrip

func.def @i64x16_insert_static(%values: vector<16xi64>, %value: i64) -> (vector<16xi64>) {
  %result = vector.insert %value into %values[1] : i64, vector<16xi64>
  func.return %result : vector<16xi64>
}

// ====

func.def @i32x32_insert_static(%values: vector<32xi32>, %value: i32) -> (vector<32xi32>) {
  %result = vector.insert %value into %values[17] : i32, vector<32xi32>
  func.return %result : vector<32xi32>
}

// ====

func.def @i64x16_insert_dynamic(%values: vector<16xi64>, %value: i64, %position: index) -> (vector<16xi64>) {
  %result = vector.insert %value into %values[%position] : i64, vector<16xi64>
  func.return %result : vector<16xi64>
}

// ====

func.def @i32x2x2_insert_static(%values: vector<2x2xi32>, %value: i32) -> (vector<2x2xi32>) {
  %result = vector.insert %value into %values[1, 1] : i32, vector<2x2xi32>
  func.return %result : vector<2x2xi32>
}

// ====

func.def @i32x16_insert_static(%values: vector<16xi32>, %value: i32) -> (vector<16xi32>) {
  %result = vector.insert %value into %values[15] : i32, vector<16xi32>
  func.return %result : vector<16xi32>
}
