func.def @convert_boolean(%input: i1) -> (f32, f64, f32, f64) {
  %signed32 = scalar.sitofp %input : i1 to f32
  %signed64 = scalar.sitofp %input : i1 to f64
  %unsigned32 = scalar.uitofp %input : i1 to f32
  %unsigned64 = scalar.uitofp %input : i1 to f64
  func.return %signed32, %signed64, %unsigned32, %unsigned64 : f32, f64, f32, f64
}

