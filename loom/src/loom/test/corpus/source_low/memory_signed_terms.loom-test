kernel.def @workgroup_negative_vector_coefficient() {
  %c1 = index.constant 1 : index
  %workgroup_size = index.constant 32 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%workgroup_size, %c1, %c1) : index
} launch() {
  %lane = kernel.workitem.id<x> : index
  %c2 = index.constant 2 : index
  %bank = index.rem %lane, %c2 : index
  %c1 = index.constant 1 : index
  %next_bank = index.sub %c1, %bank : index
  %c0 = index.constant 0 : index
  %bank_bytes = index.constant 16 : offset
  %next_offset = index.scale %next_bank, %bank_bytes : index, offset -> offset
  %byte_length = index.constant 32 : offset
  %scratch = buffer.alloca<workgroup> align(16) %byte_length : buffer
  %view = buffer.view %scratch[%next_offset] : buffer -> view<4xi32>
  %stored = vector.constant 1 : vector<4xi32>
  vector.store %stored, %view[%c0] : vector<4xi32>, view<4xi32>
  %loaded = vector.load %view[%c0] : view<4xi32> -> vector<4xi32>
  vector.store %loaded, %view[%c0] : vector<4xi32>, view<4xi32>
  kernel.return
}
