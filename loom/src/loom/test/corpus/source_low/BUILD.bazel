load("//loom/build_tools/amdgpu:target_config.bzl", "LOOM_AMDGPU_SUPPORTED_TARGETS")
load("//loom/build_tools/bazel:loom_check.bzl", "loom_check_test_suite")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_CASES = glob(["*.loom-test"])

exports_files(_CASES + glob(["*.loom"]))

loom_check_test_suite(
    name = "test",
    srcs = _CASES,
    compile_targets = {
        source: ["//loom/target/amdgpu:" + target for target in LOOM_AMDGPU_SUPPORTED_TARGETS]
        for source in [
            "memory_address_realizations.loom-test",
            "memory_wide_offsets.loom-test",
        ]
    },
)
