load("//loom/build_tools/amdgpu:target_config.bzl", "LOOM_AMDGPU_SUPPORTED_TARGETS")
load("//loom/build_tools/bazel:loom_check.bzl", "loom_check_compile_tests")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

exports_files(glob([
    "*.loom",
    "*.loom-test",
]))

loom_check_compile_tests(
    name = "memory_address_realizations",
    src = "memory_address_realizations.loom-test",
    targets = ["//loom/target/amdgpu:" + target for target in LOOM_AMDGPU_SUPPORTED_TARGETS],
)

# Ordered global atomics require RDNA memory-ordering support.
loom_check_compile_tests(
    name = "memory_atomic_preservation",
    src = "memory_atomic_preservation.loom-test",
    targets = [
        "//loom/target/amdgpu:gfx11-generic",
        "//loom/target/amdgpu:gfx1151",
        "//loom/target/amdgpu:gfx12-generic",
        "//loom/target/amdgpu:gfx1250",
        "//loom/target/amdgpu:gfx12-5-generic",
    ],
)

loom_check_compile_tests(
    name = "memory_wide_offsets",
    src = "memory_wide_offsets.loom-test",
    targets = ["//loom/target/amdgpu:" + target for target in LOOM_AMDGPU_SUPPORTED_TARGETS],
)

loom_check_compile_tests(
    name = "narrow_float_arguments",
    src = "narrow_float_arguments.loom-test",
    targets = [
        "//loom/target/amdgpu:gfx942",
        "//loom/target/amdgpu:gfx950",
        "//loom/target/amdgpu:gfx1100",
        "//loom/target/amdgpu:gfx1151",
        "//loom/target/amdgpu:gfx1170",
        "//loom/target/amdgpu:gfx1200",
        "//loom/target/amdgpu:gfx1250",
        "//loom/target/spirv:vulkan1.3+bda+extended-types",
    ],
)
