func.def @i1x1_any_all(%values: vector<1xi1>, %init: i1) -> (i1, i1, i1, i1) {
  %false = scalar.constant false : i1
  %true = scalar.constant true : i1
  %any = vector.reduce<ori> %values, %false : vector<1xi1>, i1
  %all = vector.reduce<andi> %values, %true : vector<1xi1>, i1
  %any_with_init = vector.reduce<ori> %values, %init : vector<1xi1>, i1
  %all_with_init = vector.reduce<andi> %values, %init : vector<1xi1>, i1
  func.return %any, %all, %any_with_init, %all_with_init : i1, i1, i1, i1
}

