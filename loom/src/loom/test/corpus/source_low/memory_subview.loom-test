// RUN: roundtrip

func.def @subview_scalar_strided(%input: buffer, %output: buffer) -> (f32) {
  %input_base = index.constant 8 : offset
  %output_base = index.constant 12 : offset
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %layout = encoding.layout.strided [8, 1] : encoding<layout>
  %source = buffer.view %input_aligned[%input_base] : buffer -> view<4x8xf32, %layout>
  %destination = buffer.view %output_aligned[%output_base] : buffer -> view<4x8xf32, %layout>
  %source_crop = view.subview %source[1, 2] : view<4x8xf32, %layout> -> view<2x3xf32, %layout>
  %destination_crop = view.subview %destination[1, 1] : view<4x8xf32, %layout> -> view<2x4xf32, %layout>
  %value = view.load %source_crop[1, 1] : view<2x3xf32, %layout> -> f32
  view.store %value, %destination_crop[1, 2] : f32, view<2x4xf32, %layout>
  func.return %value : f32
}

// ====

func.def @subview_nested_dynamic(%input: buffer, %output: buffer, %base: offset, %row: index, %column: index) -> (i32) {
  %origin = index.assume %base [range(%base, 4, 16), mul(%base, 4)] : offset
  %row_bounded = index.assume %row [range(%row, 0, 1)] : index
  %column_bounded = index.assume %column [range(%column, 0, 2)] : index
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %layout = encoding.layout.strided [8, 1] : encoding<layout>
  %source = buffer.view %input_aligned[%origin] : buffer -> view<6x8xi32, %layout>
  %destination = buffer.view %output_aligned[%origin] : buffer -> view<6x8xi32, %layout>
  %source_outer = view.subview %source[1, 1] : view<6x8xi32, %layout> -> view<4x6xi32, %layout>
  %source_inner = view.subview %source_outer[1, 2] : view<4x6xi32, %layout> -> view<2x3xi32, %layout>
  %source_refined = view.refine %source_inner : view<2x3xi32, %layout> -> view<2x3xi32, %layout>
  %destination_outer = view.subview %destination[1, 0] : view<6x8xi32, %layout> -> view<4x6xi32, %layout>
  %destination_inner = view.subview %destination_outer[1, 1] : view<4x6xi32, %layout> -> view<2x3xi32, %layout>
  %value = view.load %source_refined[%row_bounded, %column_bounded] : view<2x3xi32, %layout> -> i32
  view.store %value, %destination_inner[%row_bounded, %column_bounded] : i32, view<2x3xi32, %layout>
  func.return %value : i32
}

// ====

func.def @subview_vector_strided(%input: buffer, %output: buffer) {
  %input_base = index.constant 16 : offset
  %output_base = index.constant 32 : offset
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %layout = encoding.layout.strided [12, 1] : encoding<layout>
  %source = buffer.view %input_aligned[%input_base] : buffer -> view<4x12xi32, %layout>
  %destination = buffer.view %output_aligned[%output_base] : buffer -> view<4x12xi32, %layout>
  %source_crop = view.subview %source[1, 2] : view<4x12xi32, %layout> -> view<2x8xi32, %layout>
  %destination_crop = view.subview %destination[1, 1] : view<4x12xi32, %layout> -> view<2x8xi32, %layout>
  %value = vector.load %source_crop[1, 1] : view<2x8xi32, %layout> -> vector<4xi32>
  vector.store %value, %destination_crop[0, 1] : vector<4xi32>, view<2x8xi32, %layout>
  func.return
}

// ====

func.def @subview_vector_aligned(%input: buffer, %output: buffer) {
  %input_base = index.constant 32 : offset
  %output_base = index.constant 64 : offset
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 32} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 32} : buffer
  %layout = encoding.layout.strided [24, 1] : encoding<layout>
  %source = buffer.view %input_aligned[%input_base] : buffer -> view<4x24xi32, %layout>
  %destination = buffer.view %output_aligned[%output_base] : buffer -> view<4x24xi32, %layout>
  %source_crop = view.subview %source[1, 8] : view<4x24xi32, %layout> -> view<2x8xi32, %layout>
  %destination_crop = view.subview %destination[1, 0] : view<4x24xi32, %layout> -> view<2x16xi32, %layout>
  %value = vector.load %source_crop[1, 0] : view<2x8xi32, %layout> -> vector<8xi32>
  vector.store %value, %destination_crop[0, 8] : vector<8xi32>, view<2x16xi32, %layout>
  func.return
}

// ====

func.def @subview_atomic_strided(%buffer: buffer) -> (i32) {
  %base = index.constant 8 : offset
  %global = buffer.assume.memory_space<global> %buffer : buffer
  %aligned = buffer.assume.alignment %global {minimum_alignment = 4} : buffer
  %layout = encoding.layout.strided [8, 1] : encoding<layout>
  %view = buffer.view %aligned[%base] : buffer -> view<4x8xi32, %layout>
  %crop = view.subview %view[1, 2] : view<4x8xi32, %layout> -> view<2x3xi32, %layout>
  %increment = scalar.constant 1 : i32
  view.atomic.reduce<addi> %increment, %crop[1, 1] {ordering = relaxed, scope = device} : i32, view<2x3xi32, %layout>
  %old = view.atomic.rmw<addi> %increment, %crop[1, 1] {ordering = relaxed, scope = device} : i32, view<2x3xi32, %layout> -> i32
  %replacement = scalar.constant 99 : i32
  %observed = view.atomic.cmpxchg %old, %replacement, %crop[1, 1] {failure_ordering = relaxed, scope = device, success_ordering = relaxed} : i32, view<2x3xi32, %layout> -> i32
  func.return %observed : i32
}

// ====

func.def @subview_prefetch_strided(%input: buffer) {
  %base = index.constant 8 : offset
  %layout = encoding.layout.strided [8, 1] : encoding<layout>
  %view = buffer.view %input[%base] : buffer -> view<4x8xi32, %layout>
  %outer = view.subview %view[1, 1] : view<4x8xi32, %layout> -> view<3x6xi32, %layout>
  %inner = view.subview %outer[1, 1] : view<3x6xi32, %layout> -> view<2x3xi32, %layout>
  view.prefetch %inner[0, 1] {intent = read, locality = l1} : view<2x3xi32, %layout>
  func.return
}

// ====

func.def @subview_dense_rows(%input: buffer, %output: buffer) -> (i32) {
  %base = index.constant 4 : offset
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %source = buffer.view %input_aligned[%base] : buffer -> view<4x8xi32>
  %destination = buffer.view %output_aligned[%base] : buffer -> view<4x8xi32>
  %source_crop = view.subview %source[1, 0] : view<4x8xi32> -> view<2x8xi32>
  %destination_crop = view.subview %destination[2, 0] : view<4x8xi32> -> view<2x8xi32>
  %value = view.load %source_crop[1, 3] : view<2x8xi32> -> i32
  view.store %value, %destination_crop[0, 4] : i32, view<2x8xi32>
  func.return %value : i32
}
