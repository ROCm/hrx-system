func.def @source_address_domain_static_coordinate(%input: buffer, %origin: offset) -> (i32) {
  %source = buffer.view %input[%origin] address_bits(32) : buffer -> view<4x8xi32>
  %loaded = view.load %source[3, 7] : view<4x8xi32> -> i32
  func.return %loaded : i32
}

// ====

func.def @source_address_domain_derived_view(%input: buffer, %origin: offset, %columns: index) -> (i32) {
  %bounded_columns = index.assume %columns [range(%columns, 4, 8)] : index
  %source = buffer.view %input[%origin] address_bits(32) : buffer -> view<4x[%bounded_columns]xi32>
  %row = view.subview %source[1, 0] : view<4x[%bounded_columns]xi32> -> view<1x[%bounded_columns]xi32>
  %prefix = view.refine %row : view<1x[%bounded_columns]xi32> -> view<1x4xi32>
  %loaded = view.load %prefix[0, 3] : view<1x4xi32> -> i32
  func.return %loaded : i32
}
