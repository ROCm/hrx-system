func.def @scalar_f32_select_reuse(%condition: i1, %true_value: f32, %false_value: f32) -> (f32, f32, f32, i1) {
  %result = scf.select %condition, %true_value, %false_value : f32
  func.return %result, %true_value, %false_value, %condition : f32, f32, f32, i1
}

