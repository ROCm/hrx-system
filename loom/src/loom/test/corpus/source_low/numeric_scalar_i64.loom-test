// RUN: roundtrip

func.def @scalar_i64_bitwise_sgpr(%lhs: i64, %rhs: i64) -> (i64, i64, i64) {
  %and = scalar.andi %lhs, %rhs : i64
  %or = scalar.ori %and, %lhs : i64
  %xor = scalar.xori %or, %rhs : i64
  func.return %and, %or, %xor : i64, i64, i64
}

// ====

func.def @scalar_i64_addi_vgpr(%lhs_values: vector<2xi64>, %rhs_values: vector<2xi64>) -> (i64) {
  %lhs = vector.extract %lhs_values[0] : vector<2xi64> -> i64
  %rhs = vector.extract %rhs_values[0] : vector<2xi64> -> i64
  %sum = scalar.addi %lhs, %rhs : i64
  func.return %sum : i64
}

// ====

func.def @scalar_i64_subi_vgpr(%lhs_values: vector<2xi64>, %rhs_values: vector<2xi64>) -> (i64) {
  %lhs = vector.extract %lhs_values[0] : vector<2xi64> -> i64
  %rhs = vector.extract %rhs_values[0] : vector<2xi64> -> i64
  %difference = scalar.subi %lhs, %rhs : i64
  func.return %difference : i64
}

// ====

func.def @scalar_i64_shli_vgpr(%value_values: vector<2xi64>, %shift_values: vector<2xi64>) -> (i64) {
  %value = vector.extract %value_values[0] : vector<2xi64> -> i64
  %shift = vector.extract %shift_values[0] : vector<2xi64> -> i64
  %shifted = scalar.shli %value, %shift : i64
  func.return %shifted : i64
}

// ====

func.def @scalar_i64_muli_bitwise_vgpr(%lhs_values: vector<2xi64>, %rhs_values: vector<2xi64>, %mask_values: vector<2xi64>) -> (i64) {
  %lhs = vector.extract %lhs_values[0] : vector<2xi64> -> i64
  %rhs = vector.extract %rhs_values[0] : vector<2xi64> -> i64
  %mask = vector.extract %mask_values[0] : vector<2xi64> -> i64
  %product = scalar.muli %lhs, %rhs : i64
  %mixed = scalar.xori %product, %mask : i64
  func.return %mixed : i64
}

// ====

func.def @scalar_i64_compare_eq_scc(%lhs: i64, %rhs: i64) -> (i1) {
  %cmp = scalar.cmpi eq, %lhs, %rhs : i64
  func.return %cmp : i1
}

// ====

func.def @scalar_i64_compare_ne_scc(%lhs: i64, %rhs: i64) -> (i1) {
  %cmp = scalar.cmpi ne, %lhs, %rhs : i64
  func.return %cmp : i1
}

// ====

func.def @scalar_i64_compare_slt_return(%lhs: i64, %rhs: i64) -> (i1) {
  %cmp = scalar.cmpi slt, %lhs, %rhs : i64
  func.return %cmp : i1
}

// ====

func.def @scalar_i64_compare_slt_if(%lhs: i64, %rhs: i64, %then_value: i32, %else_value: i32) -> (i32) {
  %cmp = scalar.cmpi slt, %lhs, %rhs : i64
  %result = scf.if %cmp -> (i32) {
    scf.yield %then_value : i32
  } else {
    scf.yield %else_value : i32
  }
  func.return %result : i32
}

// ====

func.def @scalar_i64_compare_constant_select(%lhs: i64, %true_value: f32, %false_value: f32) -> (f32) {
  %limit = scalar.constant 4294967296 : i64
  %cmp = scalar.cmpi ult, %lhs, %limit : i64
  %result = scf.select %cmp, %true_value, %false_value : f32
  func.return %result : f32
}

// ====

func.def @scalar_i64_compare_all_predicates_vgpr_select(%lhs_values: vector<2xi64>, %rhs_values: vector<2xi64>, %true_value: f32, %false_value: f32) -> (f32, f32, f32, f32, f32, f32, f32, f32, f32, f32) {
  %lhs = vector.extract %lhs_values[0] : vector<2xi64> -> i64
  %rhs = vector.extract %rhs_values[0] : vector<2xi64> -> i64
  %eq = scalar.cmpi eq, %lhs, %rhs : i64
  %ne = scalar.cmpi ne, %lhs, %rhs : i64
  %slt = scalar.cmpi slt, %lhs, %rhs : i64
  %sle = scalar.cmpi sle, %lhs, %rhs : i64
  %sgt = scalar.cmpi sgt, %lhs, %rhs : i64
  %sge = scalar.cmpi sge, %lhs, %rhs : i64
  %ult = scalar.cmpi ult, %lhs, %rhs : i64
  %ule = scalar.cmpi ule, %lhs, %rhs : i64
  %ugt = scalar.cmpi ugt, %lhs, %rhs : i64
  %uge = scalar.cmpi uge, %lhs, %rhs : i64
  %eq_result = scf.select %eq, %true_value, %false_value : f32
  %ne_result = scf.select %ne, %true_value, %false_value : f32
  %slt_result = scf.select %slt, %true_value, %false_value : f32
  %sle_result = scf.select %sle, %true_value, %false_value : f32
  %sgt_result = scf.select %sgt, %true_value, %false_value : f32
  %sge_result = scf.select %sge, %true_value, %false_value : f32
  %ult_result = scf.select %ult, %true_value, %false_value : f32
  %ule_result = scf.select %ule, %true_value, %false_value : f32
  %ugt_result = scf.select %ugt, %true_value, %false_value : f32
  %uge_result = scf.select %uge, %true_value, %false_value : f32
  func.return %eq_result, %ne_result, %slt_result, %sle_result, %sgt_result, %sge_result, %ult_result, %ule_result, %ugt_result, %uge_result : f32, f32, f32, f32, f32, f32, f32, f32, f32, f32
}

// ====

func.def @scalar_i64_addi_uniform(%lhs: i64, %rhs: i64) -> (i64) {
  %result = scalar.addi %lhs, %rhs : i64
  func.return %result : i64
}

// ====

func.def @scalar_i64_muli_uniform(%lhs: i64, %rhs: i64) -> (i64) {
  %result = scalar.muli %lhs, %rhs : i64
  func.return %result : i64
}

// ====

func.def @scalar_i64_shli_uniform(%lhs: i64, %rhs: i64) -> (i64) {
  %result = scalar.shli %lhs, %rhs : i64
  func.return %result : i64
}

// ====

func.def @scalar_f64_constant_select_bitcast(%condition: i1, %fallback: f64) -> (i64) {
  %constant = scalar.constant -1.1000000000000001 : f64
  %selected = scf.select %condition, %constant, %fallback : f64
  %bits = scalar.bitcast %selected : f64 to i64
  func.return %bits : i64
}

// ====

func.def @scalar_i64_lanes(%values: vector<2xi64>, %replacement: i64) -> (i64, i64, vector<2xi64>, vector<2xi64>) {
  %first = vector.extract %values[0] : vector<2xi64> -> i64
  %second = vector.extract %values[1] : vector<2xi64> -> i64
  %replace_first = vector.insert %replacement into %values[0] : i64, vector<2xi64>
  %replace_second = vector.insert %replacement into %values[1] : i64, vector<2xi64>
  func.return %first, %second, %replace_first, %replace_second : i64, i64, vector<2xi64>, vector<2xi64>
}

// ====

func.def @scalar_f64_lanes(%values: vector<2xf64>, %replacement: f64) -> (f64, f64, vector<2xf64>, vector<2xf64>) {
  %first = vector.extract %values[0] : vector<2xf64> -> f64
  %second = vector.extract %values[1] : vector<2xf64> -> f64
  %replace_first = vector.insert %replacement into %values[0] : f64, vector<2xf64>
  %replace_second = vector.insert %replacement into %values[1] : f64, vector<2xf64>
  func.return %first, %second, %replace_first, %replace_second : f64, f64, vector<2xf64>, vector<2xf64>
}

// ====

func.def @scalar_i64_right_shift_select(%value: i64, %condition: i1) -> (i64, i64, i64, i64, i64) {
  %word_count = scalar.constant 32 : i64
  %sign_count = scalar.constant 63 : i64
  %logical_word = scalar.shrui %value, %word_count : i64
  %signed_word = scalar.shrsi %value, %word_count : i64
  %logical_sign = scalar.shrui %value, %sign_count : i64
  %signed_sign = scalar.shrsi %value, %sign_count : i64
  %selected = scf.select %condition, %logical_word, %signed_word : i64
  func.return %logical_word, %signed_word, %logical_sign, %signed_sign, %selected : i64, i64, i64, i64, i64
}

// ====

func.def @scalar_i32_control(%lhs: i32, %rhs: i32) -> (i32) {
  %product = scalar.muli %lhs, %rhs : i32
  %mixed = scalar.xori %product, %rhs : i32
  %less = scalar.cmpi slt, %lhs, %rhs : i32
  %selected = scf.select %less, %mixed, %product : i32
  func.return %selected : i32
}

// ====

func.def @scalar_i64_insert_dynamic(%values: vector<2xi64>, %replacement: i64, %lane: index) -> (vector<2xi64>) {
  %updated = vector.insert %replacement into %values[%lane] : i64, vector<2xi64>
  func.return %updated : vector<2xi64>
}

// ====

func.def @scalar_f64_insert_dynamic(%values: vector<2xf64>, %replacement: f64, %lane: index) -> (vector<2xf64>) {
  %updated = vector.insert %replacement into %values[%lane] : f64, vector<2xf64>
  func.return %updated : vector<2xf64>
}

