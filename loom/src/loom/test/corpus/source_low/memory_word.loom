// Equal-width formats preserve their bits through ordinary memory transfers.
func.def @copy_word_scalar(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source_half = buffer.view %input[%base] : buffer -> view<3xf16>
  %source_bfloat = buffer.view %input[%base] : buffer -> view<3xbf16>
  %source_integer = buffer.view %input[%base] : buffer -> view<3xi16>
  %target_half = buffer.view %output[%base] : buffer -> view<3xf16>
  %target_bfloat = buffer.view %output[%base] : buffer -> view<3xbf16>
  %target_integer = buffer.view %output[%base] : buffer -> view<3xi16>
  %half = view.load %source_half[0] : view<3xf16> -> f16
  %bfloat = view.load %source_bfloat[1] : view<3xbf16> -> bf16
  %integer = view.load %source_integer[2] : view<3xi16> -> i16
  view.store %half, %target_half[0] : f16, view<3xf16>
  view.store %bfloat, %target_bfloat[1] : bf16, view<3xbf16>
  view.store %integer, %target_integer[2] : i16, view<3xi16>
  func.return
}

// ====
// Eight words occupy sixteen consecutive bytes in each numeric format.
func.def @copy_word_vector(%input: buffer, %output: buffer) {
  %first = index.constant 0 : offset
  %second = index.constant 16 : offset
  %third = index.constant 32 : offset
  %source_half = buffer.view %input[%first] : buffer -> view<8xf16>
  %source_bfloat = buffer.view %input[%second] : buffer -> view<8xbf16>
  %source_integer = buffer.view %input[%third] : buffer -> view<8xi16>
  %target_half = buffer.view %output[%first] : buffer -> view<8xf16>
  %target_bfloat = buffer.view %output[%second] : buffer -> view<8xbf16>
  %target_integer = buffer.view %output[%third] : buffer -> view<8xi16>
  %half = vector.load %source_half[0] : view<8xf16> -> vector<8xf16>
  %bfloat = vector.load %source_bfloat[0] : view<8xbf16> -> vector<8xbf16>
  %integer = vector.load %source_integer[0] : view<8xi16> -> vector<8xi16>
  vector.store %half, %target_half[0] : vector<8xf16>, view<8xf16>
  vector.store %bfloat, %target_bfloat[0] : vector<8xbf16>, view<8xbf16>
  vector.store %integer, %target_integer[0] : vector<8xi16>, view<8xi16>
  func.return
}

// ====
func.def @copy_word_vector_wide(%input: buffer, %output: buffer) {
  %first = index.constant 0 : offset
  %second = index.constant 32 : offset
  %third = index.constant 64 : offset
  %source_half = buffer.view %input[%first] : buffer -> view<16xf16>
  %source_bfloat = buffer.view %input[%second] : buffer -> view<16xbf16>
  %source_integer = buffer.view %input[%third] : buffer -> view<16xi16>
  %target_half = buffer.view %output[%first] : buffer -> view<16xf16>
  %target_bfloat = buffer.view %output[%second] : buffer -> view<16xbf16>
  %target_integer = buffer.view %output[%third] : buffer -> view<16xi16>
  %half = vector.load %source_half[0] : view<16xf16> -> vector<16xf16>
  %bfloat = vector.load %source_bfloat[0] : view<16xbf16> -> vector<16xbf16>
  %integer = vector.load %source_integer[0] : view<16xi16> -> vector<16xi16>
  vector.store %half, %target_half[0] : vector<16xf16>, view<16xf16>
  vector.store %bfloat, %target_bfloat[0] : vector<16xbf16>, view<16xbf16>
  vector.store %integer, %target_integer[0] : vector<16xi16>, view<16xi16>
  func.return
}

// ====
func.def @copy_word_vector_large(%input: buffer, %output: buffer) {
  %first = index.constant 0 : offset
  %second = index.constant 64 : offset
  %third = index.constant 128 : offset
  %source_half = buffer.view %input[%first] : buffer -> view<32xf16>
  %source_bfloat = buffer.view %input[%second] : buffer -> view<32xbf16>
  %source_integer = buffer.view %input[%third] : buffer -> view<32xi16>
  %target_half = buffer.view %output[%first] : buffer -> view<32xf16>
  %target_bfloat = buffer.view %output[%second] : buffer -> view<32xbf16>
  %target_integer = buffer.view %output[%third] : buffer -> view<32xi16>
  %half = vector.load %source_half[0] : view<32xf16> -> vector<32xf16>
  %bfloat = vector.load %source_bfloat[0] : view<32xbf16> -> vector<32xbf16>
  %integer = vector.load %source_integer[0] : view<32xi16> -> vector<32xi16>
  vector.store %half, %target_half[0] : vector<32xf16>, view<32xf16>
  vector.store %bfloat, %target_bfloat[0] : vector<32xbf16>, view<32xbf16>
  vector.store %integer, %target_integer[0] : vector<32xi16>, view<32xi16>
  func.return
}

// ====
// Packed records can place complete word vectors at odd byte origins.
func.def @copy_word_unaligned(%input: buffer, %output: buffer) {
  %first = index.constant 1 : offset
  %second = index.constant 17 : offset
  %third = index.constant 33 : offset
  %source_half = buffer.view %input[%first] : buffer -> view<8xf16, align(1)>
  %source_bfloat = buffer.view %input[%second] : buffer -> view<8xbf16, align(1)>
  %source_integer = buffer.view %input[%third] : buffer -> view<8xi16, align(1)>
  %target_half = buffer.view %output[%first] : buffer -> view<8xf16, align(1)>
  %target_bfloat = buffer.view %output[%second] : buffer -> view<8xbf16, align(1)>
  %target_integer = buffer.view %output[%third] : buffer -> view<8xi16, align(1)>
  %half = vector.load %source_half[0] : view<8xf16, align(1)> -> vector<8xf16>
  %bfloat = vector.load %source_bfloat[0] : view<8xbf16, align(1)> -> vector<8xbf16>
  %integer = vector.load %source_integer[0] : view<8xi16, align(1)> -> vector<8xi16>
  vector.store %half, %target_half[0] : vector<8xf16>, view<8xf16, align(1)>
  vector.store %bfloat, %target_bfloat[0] : vector<8xbf16>, view<8xbf16, align(1)>
  vector.store %integer, %target_integer[0] : vector<8xi16>, view<8xi16, align(1)>
  func.return
}

// ====
// Three-word tails must not read or write a fourth word.
func.def @copy_word_tail(%input: buffer, %output: buffer) {
  %first = index.constant 1 : offset
  %second = index.constant 7 : offset
  %third = index.constant 13 : offset
  %source_half = buffer.view %input[%first] : buffer -> view<3xf16, align(1)>
  %source_bfloat = buffer.view %input[%second] : buffer -> view<3xbf16, align(1)>
  %source_integer = buffer.view %input[%third] : buffer -> view<3xi16, align(1)>
  %target_half = buffer.view %output[%first] : buffer -> view<3xf16, align(1)>
  %target_bfloat = buffer.view %output[%second] : buffer -> view<3xbf16, align(1)>
  %target_integer = buffer.view %output[%third] : buffer -> view<3xi16, align(1)>
  %half = vector.load %source_half[0] : view<3xf16, align(1)> -> vector<3xf16>
  %bfloat = vector.load %source_bfloat[0] : view<3xbf16, align(1)> -> vector<3xbf16>
  %integer = vector.load %source_integer[0] : view<3xi16, align(1)> -> vector<3xi16>
  vector.store %half, %target_half[0] : vector<3xf16>, view<3xf16, align(1)>
  vector.store %bfloat, %target_bfloat[0] : vector<3xbf16>, view<3xbf16, align(1)>
  vector.store %integer, %target_integer[0] : vector<3xi16>, view<3xi16, align(1)>
  func.return
}

// ====
// Runtime byte origins remain distinct from the two-byte element coordinate.
func.def @copy_word_index(%input: buffer, %output: buffer, %byte_offset: offset, %element: index) {
  %base = index.assume %byte_offset [range(%byte_offset, 0, 128)] : offset
  %position = index.assume %element [range(%element, 0, 7)] : index
  %source_half = buffer.view %input[%base] : buffer -> view<8xf16, align(1)>
  %source_bfloat_base = buffer.view %input[%base] : buffer -> view<24xbf16, align(1)>
  %source_integer_base = buffer.view %input[%base] : buffer -> view<24xi16, align(1)>
  %target_half = buffer.view %output[%base] : buffer -> view<8xf16, align(1)>
  %target_bfloat_base = buffer.view %output[%base] : buffer -> view<24xbf16, align(1)>
  %target_integer_base = buffer.view %output[%base] : buffer -> view<24xi16, align(1)>
  %source_bfloat = view.subview %source_bfloat_base[8] : view<24xbf16, align(1)> -> view<8xbf16, align(1)>
  %source_integer = view.subview %source_integer_base[16] : view<24xi16, align(1)> -> view<8xi16, align(1)>
  %target_bfloat = view.subview %target_bfloat_base[8] : view<24xbf16, align(1)> -> view<8xbf16, align(1)>
  %target_integer = view.subview %target_integer_base[16] : view<24xi16, align(1)> -> view<8xi16, align(1)>
  %half = view.load %source_half[%position] : view<8xf16, align(1)> -> f16
  %bfloat = view.load %source_bfloat[%position] : view<8xbf16, align(1)> -> bf16
  %integer = view.load %source_integer[%position] : view<8xi16, align(1)> -> i16
  view.store %half, %target_half[%position] : f16, view<8xf16, align(1)>
  view.store %bfloat, %target_bfloat[%position] : bf16, view<8xbf16, align(1)>
  view.store %integer, %target_integer[%position] : i16, view<8xi16, align(1)>
  func.return
}

// ====
func.def @copy_word_stride(%input: buffer, %output: buffer, %column_count: index, %row_index: index, %column_index: index) {
  %columns = index.assume %column_count [range(%column_count, 1, 16)] : index
  %row = index.assume %row_index [range(%row_index, 0, 3)] : index
  %column = index.assume %column_index [range(%column_index, 0, 15), lt(%column_index, %columns)] : index
  %base = index.constant 3 : offset
  %source = buffer.view %input[%base] : buffer -> view<4x[%columns]xbf16, align(1)>
  %target = buffer.view %output[%base] : buffer -> view<4x[%columns]xbf16, align(1)>
  %value = view.load %source[%row, %column] : view<4x[%columns]xbf16, align(1)> -> bf16
  view.store %value, %target[%row, %column] : bf16, view<4x[%columns]xbf16, align(1)>
  func.return
}

// ====
func.def @copy_word_volatile(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<1xbf16>
  %target = buffer.view %output[%base] : buffer -> view<2xbf16>
  %first = view.load<volatile> %source[0] : view<1xbf16> -> bf16
  %second = view.load<volatile> %source[0] : view<1xbf16> -> bf16
  view.store<volatile> %first, %target[0] : bf16, view<2xbf16>
  view.store<volatile> %second, %target[1] : bf16, view<2xbf16>
  func.return
}
