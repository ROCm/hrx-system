// ====

kernel.def @workgroup_memory_scalar_loop_index_b32() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 8 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch() {
  %scratch_base = index.constant 0 : offset
  %bytes = index.constant 32 : offset
  %loop_begin = index.constant 0 : index
  %loop_end = index.constant 8 : index
  %loop_step = index.constant 1 : index
  %scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  %scratch_view = buffer.view %scratch[%scratch_base] : buffer -> view<8xi32>
  %stored_value = vector.constant 1 : vector<1xi32>
  scf.for %i = [%loop_begin to %loop_end step %loop_step] {
    vector.store %stored_value, %scratch_view[%i] : vector<1xi32>, view<8xi32>
    %loaded = vector.load %scratch_view[%i] : view<8xi32> -> vector<1xi32>
    vector.store %loaded, %scratch_view[%i] : vector<1xi32>, view<8xi32>
  }
  kernel.return
}

// ====

kernel.def @wave_sized_workgroup_memory_workitem_x_b32_static_offset() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch() {
  %lane = kernel.workitem.id<x> : index
  %element_offset = index.constant 4 : index
  %element_index = index.add %lane, %element_offset : index
  %scratch_base = index.constant 0 : offset
  %bytes = index.constant 160 : offset
  %scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  %scratch_view = buffer.view %scratch[%scratch_base] : buffer -> view<40xi32>
  %stored_value = vector.constant 1 : vector<1xi32>
  vector.store %stored_value, %scratch_view[%element_index] : vector<1xi32>, view<40xi32>
  %loaded = vector.load %scratch_view[%element_index] : view<40xi32> -> vector<1xi32>
  vector.store %loaded, %scratch_view[%element_index] : vector<1xi32>, view<40xi32>
  kernel.return
}

// ====

kernel.def @wave_sized_workgroup_memory_second_allocation_b32() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch() {
  %lane = kernel.workitem.id<x> : index
  %scratch_base = index.constant 0 : offset
  %bytes = index.constant 128 : offset
  %first_scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  %second_scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  %first_view = buffer.view %first_scratch[%scratch_base] : buffer -> view<32xi32>
  %second_view = buffer.view %second_scratch[%scratch_base] : buffer -> view<32xi32>
  %first_value = vector.constant 1 : vector<1xi32>
  %second_value = vector.constant 2 : vector<1xi32>
  vector.store %first_value, %first_view[%lane] : vector<1xi32>, view<32xi32>
  vector.store %second_value, %second_view[%lane] : vector<1xi32>, view<32xi32>
  %loaded = vector.load %second_view[%lane] : view<32xi32> -> vector<1xi32>
  vector.store %loaded, %first_view[%lane] : vector<1xi32>, view<32xi32>
  kernel.return
}

// ====

kernel.def @wave_sized_workgroup_memory_view_base_and_element_offset_b32() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch() {
  %lane = kernel.workitem.id<x> : index
  %element_offset = index.constant 4 : index
  %element_index = index.add %lane, %element_offset : index
  %base = index.constant 32 : offset
  %bytes = index.constant 224 : offset
  %scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  %scratch_view = buffer.view %scratch[%base] : buffer -> view<40xi32>
  %stored_value = vector.constant 1 : vector<1xi32>
  vector.store %stored_value, %scratch_view[%element_index] : vector<1xi32>, view<40xi32>
  %loaded = vector.load %scratch_view[%element_index] : view<40xi32> -> vector<1xi32>
  vector.store %loaded, %scratch_view[%element_index] : vector<1xi32>, view<40xi32>
  kernel.return
}

// ====

kernel.def @wave_sized_workgroup_memory_interleaved_addtid_and_vaddr_b32() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch() {
  %lane = kernel.workitem.id<x> : index
  %lane_scale = index.constant 2 : index
  %scaled_lane = index.mul %lane, %lane_scale : index
  %scratch_base = index.constant 0 : offset
  %bytes = index.constant 256 : offset
  %scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  %scratch_view = buffer.view %scratch[%scratch_base] : buffer -> view<64xi32>
  %lane_value = vector.constant 1 : vector<1xi32>
  %other = vector.constant 2 : vector<1xi32>
  vector.store %lane_value, %scratch_view[%lane] : vector<1xi32>, view<64xi32>
  vector.store %other, %scratch_view[%scaled_lane] : vector<1xi32>, view<64xi32>
  %loaded = vector.load %scratch_view[%lane] : view<64xi32> -> vector<1xi32>
  vector.store %loaded, %scratch_view[%scaled_lane] : vector<1xi32>, view<64xi32>
  kernel.return
}

// ====

kernel.def @wave_sized_workgroup_memory_roundtrip_lane_cast_b32() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch() {
  %lane = kernel.workitem.id<x> : index
  %lane_i32 = index.cast %lane : index to i32
  %lane_index = index.cast %lane_i32 : i32 to index
  %scratch_base = index.constant 0 : offset
  %bytes = index.constant 128 : offset
  %scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  %scratch_view = buffer.view %scratch[%scratch_base] : buffer -> view<32xi32>
  %stored_value = vector.constant 1 : vector<1xi32>
  vector.store %stored_value, %scratch_view[%lane_index] : vector<1xi32>, view<32xi32>
  %loaded = vector.load %scratch_view[%lane_index] : view<32xi32> -> vector<1xi32>
  vector.store %loaded, %scratch_view[%lane_index] : vector<1xi32>, view<32xi32>
  kernel.return
}

// ====

kernel.def @wave_sized_workgroup_memory_select_same_lane_b32() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch() {
  %lane = kernel.workitem.id<x> : index
  %limit = index.constant 32 : index
  %inside = index.cmp ult, %lane, %limit : index
  %selected_lane = scf.select %inside, %lane, %lane : index
  %scratch_base = index.constant 0 : offset
  %bytes = index.constant 128 : offset
  %scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  %scratch_view = buffer.view %scratch[%scratch_base] : buffer -> view<32xi32>
  %stored_value = vector.constant 1 : vector<1xi32>
  vector.store %stored_value, %scratch_view[%selected_lane] : vector<1xi32>, view<32xi32>
  %loaded = vector.load %scratch_view[%selected_lane] : view<32xi32> -> vector<1xi32>
  vector.store %loaded, %scratch_view[%selected_lane] : vector<1xi32>, view<32xi32>
  kernel.return
}

// ====

kernel.def @wave_sized_workgroup_memory_select_scaled_lane_b32() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch() {
  %lane = kernel.workitem.id<x> : index
  %lane_scale = index.constant 2 : index
  %scaled_lane = index.mul %lane, %lane_scale : index
  %limit = index.constant 16 : index
  %inside = index.cmp ult, %lane, %limit : index
  %element_index = scf.select %inside, %lane, %scaled_lane : index
  %scratch_base = index.constant 0 : offset
  %bytes = index.constant 256 : offset
  %scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  %scratch_view = buffer.view %scratch[%scratch_base] : buffer -> view<64xi32>
  %stored_value = vector.constant 1 : vector<1xi32>
  vector.store %stored_value, %scratch_view[%element_index] : vector<1xi32>, view<64xi32>
  %loaded = vector.load %scratch_view[%element_index] : view<64xi32> -> vector<1xi32>
  vector.store %loaded, %scratch_view[%element_index] : vector<1xi32>, view<64xi32>
  kernel.return
}

// ====

kernel.def @wave_sized_workgroup_memory_guarded_lane_store_b32() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch() {
  %lane = kernel.workitem.id<x> : index
  %limit = index.constant 16 : index
  %inside = index.cmp ult, %lane, %limit : index
  %scratch_base = index.constant 0 : offset
  %bytes = index.constant 128 : offset
  %scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  %scratch_view = buffer.view %scratch[%scratch_base] : buffer -> view<32xi32>
  %initial = vector.constant 0 : vector<1xi32>
  %replacement = vector.constant 1 : vector<1xi32>
  vector.store %initial, %scratch_view[%lane] : vector<1xi32>, view<32xi32>
  scf.if %inside {
    vector.store %replacement, %scratch_view[%lane] : vector<1xi32>, view<32xi32>
  }
  %loaded = vector.load %scratch_view[%lane] : view<32xi32> -> vector<1xi32>
  vector.store %loaded, %scratch_view[%lane] : vector<1xi32>, view<32xi32>
  kernel.return
}

// ====

kernel.def @wave_sized_workgroup_memory_guarded_lane_load_b32() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch() {
  %lane = kernel.workitem.id<x> : index
  %limit = index.constant 16 : index
  %inside = index.cmp ult, %lane, %limit : index
  %scratch_base = index.constant 0 : offset
  %bytes = index.constant 128 : offset
  %scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  %scratch_view = buffer.view %scratch[%scratch_base] : buffer -> view<32xi32>
  %stored_value = vector.constant 1 : vector<1xi32>
  vector.store %stored_value, %scratch_view[%lane] : vector<1xi32>, view<32xi32>
  scf.if %inside {
    %loaded = vector.load %scratch_view[%lane] : view<32xi32> -> vector<1xi32>
    vector.store %loaded, %scratch_view[%lane] : vector<1xi32>, view<32xi32>
  }
  kernel.return
}
