// RUN: roundtrip

func.def @scalar_static_rank2_i32(%input: buffer, %output: buffer) -> (i32) {
  %input_base = index.constant 8 : offset
  %output_base = index.constant 12 : offset
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %input_view = buffer.view %input_aligned[%input_base] : buffer -> view<2x4xi32>
  %output_view = buffer.view %output_aligned[%output_base] : buffer -> view<2x4xi32>
  %loaded = view.load %input_view[1, 2] : view<2x4xi32> -> i32
  view.store %loaded, %output_view[0, 3] : i32, view<2x4xi32>
  func.return %loaded : i32
}

// ====

func.def @scalar_dynamic_view_base_i32(%input: buffer, %output: buffer, %base: offset) -> (i32) {
  %base_aligned = index.assume %base [range(%base, 0, 4092), mul(%base, 4)] : offset
  %output_base = index.constant 0 : offset
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %input_view = buffer.view %input_aligned[%base_aligned] : buffer -> view<4xi32>
  %output_view = buffer.view %output_aligned[%output_base] : buffer -> view<1xi32>
  %loaded = view.load %input_view[2] : view<4xi32> -> i32
  view.store %loaded, %output_view[0] : i32, view<1xi32>
  func.return %loaded : i32
}

// ====

func.def @scalar_materialized_view_base_suffix_i32(%input: buffer, %output: buffer, %base: offset) -> (i32) {
  %base_aligned = index.assume %base [range(%base, 0, 4056), mul(%base, 4)] : offset
  %bias = index.constant 4 : offset
  %biased_base = index.add %base_aligned, %bias : offset
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %input_view = buffer.view %input_aligned[%biased_base] : buffer -> view<8xi32>
  %output_view = buffer.view %output_aligned[%biased_base] : buffer -> view<8xi32>
  %loaded = view.load %input_view[2] : view<8xi32> -> i32
  view.store %loaded, %output_view[3] : i32, view<8xi32>
  func.return %loaded : i32
}

// ====

func.def @scalar_dynamic_index_i32(%input: buffer, %output: buffer, %element: index) -> (i32) {
  %buffer_base = index.constant 0 : offset
  %element_bounded = index.assume %element [range(%element, 0, 7)] : index
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %input_view = buffer.view %input_aligned[%buffer_base] : buffer -> view<8xi32>
  %output_view = buffer.view %output_aligned[%buffer_base] : buffer -> view<8xi32>
  %loaded = view.load %input_view[%element_bounded] : view<8xi32> -> i32
  view.store %loaded, %output_view[%element_bounded] : i32, view<8xi32>
  func.return %loaded : i32
}

// ====

func.def @scalar_mixed_rank2_i32(%input: buffer, %output: buffer, %base: offset, %row: index, %column: index) -> (i32) {
  %base_aligned = index.assume %base [range(%base, 0, 4092), mul(%base, 4)] : offset
  %row_bounded = index.assume %row [range(%row, 0, 3)] : index
  %column_bounded = index.assume %column [range(%column, 0, 7)] : index
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %input_view = buffer.view %input_aligned[%base_aligned] : buffer -> view<4x8xi32>
  %output_view = buffer.view %output_aligned[%base_aligned] : buffer -> view<4x8xi32>
  %loaded = view.load %input_view[%row_bounded, %column_bounded] : view<4x8xi32> -> i32
  view.store %loaded, %output_view[%row_bounded, %column_bounded] : i32, view<4x8xi32>
  func.return %loaded : i32
}

// ====

func.def @scalar_dynamic_stride_i32(%input: buffer, %output: buffer, %columns: index, %row: index, %column: index) -> (i32) {
  %buffer_base = index.constant 0 : offset
  %columns_bounded = index.assume %columns [range(%columns, 1, 8)] : index
  %row_bounded = index.assume %row [range(%row, 0, 3)] : index
  %column_bounded = index.assume %column [range(%column, 0, 7), lt(%column, %columns_bounded)] : index
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %input_view = buffer.view %input_aligned[%buffer_base] : buffer -> view<4x[%columns_bounded]xi32>
  %output_view = buffer.view %output_aligned[%buffer_base] : buffer -> view<4x[%columns_bounded]xi32>
  %loaded = view.load %input_view[%row_bounded, %column_bounded] : view<4x[%columns_bounded]xi32> -> i32
  view.store %loaded, %output_view[%row_bounded, %column_bounded] : i32, view<4x[%columns_bounded]xi32>
  func.return %loaded : i32
}

// ====

func.def @scalar_subview_dynamic_index_i32(%input: buffer, %output: buffer, %base: offset, %element: index) -> (i32) {
  %base_aligned = index.assume %base [range(%base, 0, 4064), mul(%base, 4)] : offset
  %element_bounded = index.assume %element [range(%element, 0, 3)] : index
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %input_view = buffer.view %input_aligned[%base_aligned] : buffer -> view<8xi32>
  %output_view = buffer.view %output_aligned[%base_aligned] : buffer -> view<8xi32>
  %input_subview = view.subview %input_view[1] : view<8xi32> -> view<4xi32>
  %output_subview = view.subview %output_view[1] : view<8xi32> -> view<4xi32>
  %input_refined = view.refine %input_subview : view<4xi32> -> view<4xi32>
  %output_refined = view.refine %output_subview : view<4xi32> -> view<4xi32>
  %loaded = view.load %input_refined[%element_bounded] : view<4xi32> -> i32
  view.store %loaded, %output_refined[%element_bounded] : i32, view<4xi32>
  func.return %loaded : i32
}
