// RUN: roundtrip

func.def @wide_subview_selection(%input: buffer, %byte_base0: offset, %condition: i1) -> (i32) {
  %byte_base = index.assume %byte_base0 [range(%byte_base0, 2147483648, 4294967296), mul(%byte_base0, 4)] : offset
  %aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %root = buffer.view %aligned[%byte_base] : buffer -> view<4xi32>
  %first = view.subview %root[1] : view<4xi32> -> view<1xi32>
  %second = view.subview %root[2] : view<4xi32> -> view<1xi32>
  %selected = scf.select %condition, %first, %second : view<1xi32>
  %value = view.load %selected[0] : view<1xi32> -> i32
  func.return %value : i32
}

// ====

func.def @distinct_root_selection(%first: buffer, %second: buffer, %condition: i1) -> (i32) {
  %first_offset = index.constant 4 : offset
  %second_offset = index.constant 8 : offset
  %first_aligned = buffer.assume.alignment %first {minimum_alignment = 4} : buffer
  %second_aligned = buffer.assume.alignment %second {minimum_alignment = 4} : buffer
  %first_view = buffer.view %first_aligned[%first_offset] : buffer -> view<1xi32>
  %second_view = buffer.view %second_aligned[%second_offset] : buffer -> view<1xi32>
  %selected = scf.select %condition, %first_view, %second_view : view<1xi32>
  %value = view.load %selected[0] : view<1xi32> -> i32
  func.return %value : i32
}

// ====

func.def public @rotate_buffer_views(%input: buffer, %count_input: index, %seed: i32) -> (i32) {
  %count = index.assume %count_input [range(%count_input, 0, 257)] : index
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %depth = scalar.constant 4 : i32
  %storage = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %offset0 = index.constant 0 : offset
  %slot0 = buffer.view %storage[%offset0] : buffer -> view<1xi32>
  %ordinal0 = scalar.constant 0 : i32
  %initial0 = scalar.addi %seed, %ordinal0 : i32
  view.store %initial0, %slot0[0] : i32, view<1xi32>
  %offset1 = index.constant 4 : offset
  %slot1 = buffer.view %storage[%offset1] : buffer -> view<1xi32>
  %ordinal1 = scalar.constant 1 : i32
  %initial1 = scalar.addi %seed, %ordinal1 : i32
  view.store %initial1, %slot1[0] : i32, view<1xi32>
  %offset2 = index.constant 8 : offset
  %slot2 = buffer.view %storage[%offset2] : buffer -> view<1xi32>
  %ordinal2 = scalar.constant 2 : i32
  %initial2 = scalar.addi %seed, %ordinal2 : i32
  view.store %initial2, %slot2[0] : i32, view<1xi32>
  %offset3 = index.constant 12 : offset
  %slot3 = buffer.view %storage[%offset3] : buffer -> view<1xi32>
  %ordinal3 = scalar.constant 3 : i32
  %initial3 = scalar.addi %seed, %ordinal3 : i32
  view.store %initial3, %slot3[0] : i32, view<1xi32>
  %unroll = index.constant 2 : index
  %last0, %last1, %last2, %last3 = scf.for %record = [%begin to %count step %step](%current0 = %slot0 : view<1xi32>, %current1 = %slot1 : view<1xi32>, %current2 = %slot2 : view<1xi32>, %current3 = %slot3 : view<1xi32>) -> (view<1xi32>, view<1xi32>, view<1xi32>, view<1xi32>) unroll(%unroll) {
    %number = index.cast %record : index to i32
    %future = scalar.addi %number, %depth : i32
    %value = scalar.addi %seed, %future : i32
    %refined = view.refine %current0 : view<1xi32> -> view<1xi32>
    view.store %value, %refined[0] : i32, view<1xi32>
    scf.yield %current1, %current2, %current3, %refined : view<1xi32>, view<1xi32>, view<1xi32>, view<1xi32>
  }
  %value0 = view.load %last0[0] : view<1xi32> -> i32
  func.return %value0 : i32
}


// ====

func.def @correlated_duplicate_rotation(%input: buffer, %count_input: index, %first_offset_input: offset, %second_offset_input: offset) -> (i32) {
  %count = index.assume %count_input [range(%count_input, 0, 257)] : index
  %first_offset = index.assume %first_offset_input [range(%first_offset_input, 0, 4092), mul(%first_offset_input, 4)] : offset
  %second_offset = index.assume %second_offset_input [range(%second_offset_input, 0, 4092), mul(%second_offset_input, 4)] : offset
  %storage = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %first_view = buffer.view %storage[%first_offset] : buffer -> view<1xi32>
  %second_view = buffer.view %storage[%second_offset] : buffer -> view<1xi32>
  %last_a_offset, %last_a_view, %last_a_duplicate, %last_b_offset, %last_b_view = scf.for %i = [%begin to %count step %step](%a_offset = %first_offset : offset, %a_view = %first_view : view<1xi32>, %a_duplicate = %first_view : view<1xi32>, %b_offset = %second_offset : offset, %b_view = %second_view : view<1xi32>) -> (offset, view<1xi32>, view<1xi32>, offset, view<1xi32>) {
    scf.yield %b_offset, %b_view, %b_view, %a_offset, %a_view : offset, view<1xi32>, view<1xi32>, offset, view<1xi32>
  }
  %last_a_offset_view = buffer.view %storage[%last_a_offset] : buffer -> view<1xi32>
  %a_offset_value = view.load %last_a_offset_view[0] : view<1xi32> -> i32
  %a_view_value = view.load %last_a_view[0] : view<1xi32> -> i32
  %a_duplicate_value = view.load %last_a_duplicate[0] : view<1xi32> -> i32
  %last_b_offset_view = buffer.view %storage[%last_b_offset] : buffer -> view<1xi32>
  %b_offset_value = view.load %last_b_offset_view[0] : view<1xi32> -> i32
  %b_view_value = view.load %last_b_view[0] : view<1xi32> -> i32
  %sum0 = scalar.addi %a_offset_value, %a_view_value : i32
  %sum1 = scalar.addi %sum0, %a_duplicate_value : i32
  %sum2 = scalar.addi %sum1, %b_offset_value : i32
  %sum3 = scalar.addi %sum2, %b_view_value : i32
  func.return %sum3 : i32
}


// ====

func.def @correlated_cfg_rotation(%input: buffer, %select: i1, %again: i1, %left_offset_input: offset, %right_offset_input: offset) -> (i32) {
  %left_offset = index.assume %left_offset_input [range(%left_offset_input, 0, 4092), mul(%left_offset_input, 4)] : offset
  %right_offset = index.assume %right_offset_input [range(%right_offset_input, 0, 4092), mul(%right_offset_input, 4)] : offset
  %storage = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  cfg.cond_br %select, ^left, ^right
^left:
  cfg.br ^loop(%left_offset: offset, %left_offset: offset)
^right:
  cfg.br ^loop(%right_offset: offset, %right_offset: offset)
^loop(%offset: offset, %duplicate_offset: offset):
  cfg.cond_br %again, ^body, ^exit
^body:
  cfg.br ^loop(%duplicate_offset: offset, %offset: offset)
^exit:
  %view = buffer.view %storage[%offset] : buffer -> view<1xi32>
  %duplicate_view = buffer.view %storage[%duplicate_offset] : buffer -> view<1xi32>
  %value = view.load %view[0] : view<1xi32> -> i32
  %duplicate_value = view.load %duplicate_view[0] : view<1xi32> -> i32
  %sum = scalar.addi %value, %duplicate_value : i32
  func.return %sum : i32
}
