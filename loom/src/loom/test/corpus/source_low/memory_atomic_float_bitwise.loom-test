  %exchanged = vector.atomic.rmw.mask<xchgf> %replacement, %cells[0][%offsets], %mask, %replacement {ordering = acq_rel, scope = device} : vector<2xf32>, view<2xf32>, vector<2xindex>, vector<2xi1>, vector<2xf32>
