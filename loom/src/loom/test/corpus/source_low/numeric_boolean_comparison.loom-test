// RUN: roundtrip

func.def public @boolean_comparisons(%left: i32, %right: i32) -> (i32) {
  %c0 = scalar.constant 0 : i32
  %lhs = scalar.cmpi ne, %left, %c0 : i32
  %rhs = scalar.cmpi ne, %right, %c0 : i32
  %eq = scalar.cmpi eq, %lhs, %rhs : i1
  %eq_bit = scalar.extui %eq : i1 to i32
  %ne = scalar.cmpi ne, %lhs, %rhs : i1
  %ne_bit = scalar.extui %ne : i1 to i32
  %shift_1 = scalar.constant 1 : i32
  %ne_shifted = scalar.shli %ne_bit, %shift_1 : i32
  %mask_1 = scalar.ori %eq_bit, %ne_shifted : i32
  %slt = scalar.cmpi slt, %lhs, %rhs : i1
  %slt_bit = scalar.extui %slt : i1 to i32
  %shift_2 = scalar.constant 2 : i32
  %slt_shifted = scalar.shli %slt_bit, %shift_2 : i32
  %mask_2 = scalar.ori %mask_1, %slt_shifted : i32
  %sle = scalar.cmpi sle, %lhs, %rhs : i1
  %sle_bit = scalar.extui %sle : i1 to i32
  %shift_3 = scalar.constant 3 : i32
  %sle_shifted = scalar.shli %sle_bit, %shift_3 : i32
  %mask_3 = scalar.ori %mask_2, %sle_shifted : i32
  %sgt = scalar.cmpi sgt, %lhs, %rhs : i1
  %sgt_bit = scalar.extui %sgt : i1 to i32
  %shift_4 = scalar.constant 4 : i32
  %sgt_shifted = scalar.shli %sgt_bit, %shift_4 : i32
  %mask_4 = scalar.ori %mask_3, %sgt_shifted : i32
  %sge = scalar.cmpi sge, %lhs, %rhs : i1
  %sge_bit = scalar.extui %sge : i1 to i32
  %shift_5 = scalar.constant 5 : i32
  %sge_shifted = scalar.shli %sge_bit, %shift_5 : i32
  %mask_5 = scalar.ori %mask_4, %sge_shifted : i32
  %ult = scalar.cmpi ult, %lhs, %rhs : i1
  %ult_bit = scalar.extui %ult : i1 to i32
  %shift_6 = scalar.constant 6 : i32
  %ult_shifted = scalar.shli %ult_bit, %shift_6 : i32
  %mask_6 = scalar.ori %mask_5, %ult_shifted : i32
  %ule = scalar.cmpi ule, %lhs, %rhs : i1
  %ule_bit = scalar.extui %ule : i1 to i32
  %shift_7 = scalar.constant 7 : i32
  %ule_shifted = scalar.shli %ule_bit, %shift_7 : i32
  %mask_7 = scalar.ori %mask_6, %ule_shifted : i32
  %ugt = scalar.cmpi ugt, %lhs, %rhs : i1
  %ugt_bit = scalar.extui %ugt : i1 to i32
  %shift_8 = scalar.constant 8 : i32
  %ugt_shifted = scalar.shli %ugt_bit, %shift_8 : i32
  %mask_8 = scalar.ori %mask_7, %ugt_shifted : i32
  %uge = scalar.cmpi uge, %lhs, %rhs : i1
  %uge_bit = scalar.extui %uge : i1 to i32
  %shift_9 = scalar.constant 9 : i32
  %uge_shifted = scalar.shli %uge_bit, %shift_9 : i32
  %mask_9 = scalar.ori %mask_8, %uge_shifted : i32
  func.return %mask_9 : i32
}

// ====

func.def public @boolean_constants() -> (i1, i1) {
  %false = scalar.constant false : i1
  %true = scalar.constant true : i1
  func.return %false, %true : i1, i1
}

// ====

func.def public @boolean_algebra(%lhs: i1, %rhs: i1) -> (i1, i1, i1) {
  %and = scalar.andi %lhs, %rhs : i1
  %or = scalar.ori %lhs, %rhs : i1
  %xor = scalar.xori %lhs, %rhs : i1
  func.return %and, %or, %xor : i1, i1, i1
}

// ====

func.def public @boolean_unsigned_extensions(%input: i1) -> (i32, i64) {
  %word = scalar.extui %input : i1 to i32
  %wide = scalar.extui %input : i1 to i64
  func.return %word, %wide : i32, i64
}
