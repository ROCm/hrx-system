// RUN: roundtrip

kernel.def @lds_f16x4_b64_roundtrip() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %bytes = index.constant 512 : offset
  %scratch = buffer.alloca<workgroup> align(8) %bytes : buffer
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<64x4xf16>
  %scratch_view = buffer.view %scratch[%buffer_base] : buffer -> view<64x4xf16>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<64x4xf16>
  %loaded = vector.load %input_view[%lane, 0] : view<64x4xf16> -> vector<4xf16>
  vector.store %loaded, %scratch_view[%lane, 0] : vector<4xf16>, view<64x4xf16>
  %roundtrip = vector.load %scratch_view[%lane, 0] : view<64x4xf16> -> vector<4xf16>
  vector.store %roundtrip, %output_view[%lane, 0] : vector<4xf16>, view<64x4xf16>
  kernel.return
}

