  %scratch = buffer.alloca<workgroup> align(2) %bytes : buffer
  %input_view = buffer.view %input[%base] : buffer -> view<64xbf16>
  %scratch_view = buffer.view %scratch[%base] : buffer -> view<64xbf16>
  %output_view = buffer.view %output[%base] : buffer -> view<64xbf16>
