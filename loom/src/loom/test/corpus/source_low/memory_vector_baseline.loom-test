// ====

func.def @vector_load_store_f32x12(%input: buffer, %output: buffer, %value: vector<12xf32>) -> (vector<12xf32>) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<12xf32>
  %output_view = buffer.view %output[%base] : buffer -> view<12xf32>
  %loaded = vector.load %input_view[0] : view<12xf32> -> vector<12xf32>
  vector.store %value, %output_view[0] : vector<12xf32>, view<12xf32>
  func.return %loaded : vector<12xf32>
}
