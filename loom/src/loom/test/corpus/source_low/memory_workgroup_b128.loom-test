// RUN: roundtrip

kernel.def @lds_b128_roundtrip() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %bytes = index.constant 1024 : offset
  %scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<64x4xi32>
  %scratch_view = buffer.view %scratch[%buffer_base] : buffer -> view<64x4xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<64x4xi32>
  %loaded = vector.load %input_view[%lane, 0] : view<64x4xi32> -> vector<4xi32>
  vector.store %loaded, %scratch_view[%lane, 0] : vector<4xi32>, view<64x4xi32>
  %roundtrip = vector.load %scratch_view[%lane, 0] : view<64x4xi32> -> vector<4xi32>
  vector.store %roundtrip, %output_view[%lane, 0] : vector<4xi32>, view<64x4xi32>
  kernel.return
}

// ====

kernel.def @lds_b128_single_lane_extract() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %bytes = index.constant 1024 : offset
  %scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<64x4xi32>
  %scratch_view = buffer.view %scratch[%buffer_base] : buffer -> view<64x4xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<64xi32>
  %loaded = vector.load %input_view[%lane, 0] : view<64x4xi32> -> vector<4xi32>
  vector.store %loaded, %scratch_view[%lane, 0] : vector<4xi32>, view<64x4xi32>
  %roundtrip = vector.load %scratch_view[%lane, 0] : view<64x4xi32> -> vector<4xi32>
  %lane2 = vector.extract %roundtrip[2] : vector<4xi32> -> i32
  view.store %lane2, %output_view[%lane] : i32, view<64xi32>
  kernel.return
}

// ====

kernel.def @lds_b128_xor_swizzle_roundtrip() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %bytes = index.constant 1024 : offset
  %scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<64x4xi32>
  %scratch_view = buffer.view %scratch[%buffer_base] : buffer -> view<64x4xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<64x4xi32>
  %shift = index.constant 4 : index
  %shifted = index.shrui %lane, %shift : index
  %mask = index.constant 3 : index
  %swizzle_bits = index.andi %shifted, %mask : index
  %swizzled = index.xori %lane, %swizzle_bits : index
  %loaded = vector.load %input_view[%lane, 0] : view<64x4xi32> -> vector<4xi32>
  vector.store %loaded, %scratch_view[%swizzled, 0] : vector<4xi32>, view<64x4xi32>
  %roundtrip = vector.load %scratch_view[%swizzled, 0] : view<64x4xi32> -> vector<4xi32>
  vector.store %roundtrip, %output_view[%lane, 0] : vector<4xi32>, view<64x4xi32>
  kernel.return
}

// ====

kernel.def @lds_b128_large_static_offset_roundtrip() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %large = index.constant 1024 : offset
  %bytes = index.constant 4096 : offset
  %scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<64x4xi32>
  %scratch_view = buffer.view %scratch[%large] : buffer -> view<64x4xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<64x4xi32>
  %loaded = vector.load %input_view[%lane, 0] : view<64x4xi32> -> vector<4xi32>
  vector.store %loaded, %scratch_view[%lane, 0] : vector<4xi32>, view<64x4xi32>
  %roundtrip = vector.load %scratch_view[%lane, 0] : view<64x4xi32> -> vector<4xi32>
  vector.store %roundtrip, %output_view[%lane, 0] : vector<4xi32>, view<64x4xi32>
  kernel.return
}

// ====

kernel.def @lds_b128_split_second_alloca_roundtrip() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %first_bytes = index.constant 64 : offset
  %second_bytes = index.constant 2048 : offset
  %first = buffer.alloca<workgroup> align(16) %first_bytes : buffer
  %second = buffer.alloca<workgroup> align(16) %second_bytes : buffer
  %first_view = buffer.view %first[%buffer_base] : buffer -> view<16xi32>
  %second_view = buffer.view %second[%buffer_base] : buffer -> view<64x8xi32>
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<64x8xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<64x8xi32>
  %loaded = vector.load %input_view[%lane, 0] : view<64x8xi32> -> vector<8xi32>
  vector.store %loaded, %second_view[%lane, 0] : vector<8xi32>, view<64x8xi32>
  %roundtrip = vector.load %second_view[%lane, 0] : view<64x8xi32> -> vector<8xi32>
  vector.store %roundtrip, %output_view[%lane, 0] : vector<8xi32>, view<64x8xi32>
  %sentinel = view.load %first_view[0] : view<16xi32> -> i32
  view.store %sentinel, %first_view[1] : i32, view<16xi32>
  kernel.return
}
