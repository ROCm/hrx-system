// RUN: roundtrip

func.def @scalar_f32_exp(%input: f32) -> (f32) {
  %result = scalar.expf<afn> %input : f32
  func.return %result : f32
}

// ====

func.def @vector_f32_exp(%input: vector<4xf32>) -> (vector<4xf32>) {
  %result = vector.expf<afn> %input : vector<4xf32>
  func.return %result : vector<4xf32>
}

// ====

func.def @scalar_f32_exp2(%input: f32) -> (f32) {
  %result = scalar.exp2f<afn> %input : f32
  func.return %result : f32
}

// ====

func.def @vector_f32_exp2(%input: vector<4xf32>) -> (vector<4xf32>) {
