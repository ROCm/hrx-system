  %base = index.constant 0 : offset
  %output_view = buffer.view %output[%base] : buffer -> view<1xf16>
  %converted = scalar.fptrunc %input : f32 to f16
  view.store %converted, %output_view[0] : f16, view<1xf16>
  func.return
}

