// ====

func.def @scalar_f16_dequant_pair(%q0: i32, %q1: i32, %scale: f16) -> (vector<2xf16>) {
  %q0_half = scalar.sitofp %q0 : i32 to f16
  %dequant0 = scalar.mulf %q0_half, %scale : f16
  %q1_half = scalar.sitofp %q1 : i32 to f16
  %dequant1 = scalar.mulf %q1_half, %scale : f16
  %packed = vector.from_elements %dequant0, %dequant1 : vector<2xf16>
  func.return %packed : vector<2xf16>
}

// ====

kernel.def @scalar_sitofp_i8_load_store() {
  %count = index.constant 1 : index
  kernel.launch.config workgroups(%count, %count, %count) workgroup_size(%count, %count, %count) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %index = index.constant 0 : index
  %input_global = buffer.assume.memory_space<global> %input : buffer
  %output_global = buffer.assume.memory_space<global> %output : buffer
  %input_noalias, %output_noalias = buffer.assume.noalias %input_global, %output_global : buffer, buffer
  %input_view = buffer.view %input_noalias[%base] : buffer -> view<1xi8>
  %output_view = buffer.view %output_noalias[%base] : buffer -> view<1xf32>
  %loaded = view.load %input_view[%index] : view<1xi8> -> i8
  %converted = scalar.sitofp %loaded : i8 to f32
  view.store %converted, %output_view[%index] : f32, view<1xf32>
  kernel.return
}

