// RUN: roundtrip

func.def @vector_extf_bf16x32(%input: vector<32xbf16>) -> (vector<32xf32>) {
  %converted = vector.extf %input : vector<32xbf16> to vector<32xf32>
  func.return %converted : vector<32xf32>
}

// ====

func.def @vector_fptrunc_bf16x32(%input: vector<32xf32>) -> (vector<32xbf16>) {
  %converted = vector.fptrunc %input : vector<32xf32> to vector<32xbf16>
  func.return %converted : vector<32xbf16>
}
