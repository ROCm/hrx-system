// Ordered MoE gather/combine over a runtime list of selected experts.
//
// Each route supplies an expert row and weight; -1 denotes a dropped route.
// Duplicate experts contribute once per route, in route order. The route table
// contains only -1 or expert IDs in [0, 3]. Buffers are aligned to four bytes;
// payloads and weights are finite.
// Dyadic weights and bounded integer payloads make the route-control sums exact
// f32. A separate cancellation case observes the accumulation order.
// Keeping the guarded load and carried update together also represents the
// natural source shape that a pipelined implementation must preserve.
kernel.def @moe_routed_combine_loop_f32() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%route_count: index, %route_ids: buffer, %route_weights: buffer, %expert_payloads: buffer, %combined_payload: buffer) {
  %count = index.assume %route_count [range(%route_count, 0, 32)] : index
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %depth = index.constant 3 : index
  %base = index.constant 0 : offset
  %first_expert_id = scalar.constant 0 : i32
  %initial_lane = scalar.constant 0.0 : f32
  %initial = vector.splat %initial_lane : vector<4xf32>
  %ids_aligned = buffer.assume.alignment %route_ids {minimum_alignment = 4} : buffer
  %weights_aligned = buffer.assume.alignment %route_weights {minimum_alignment = 4} : buffer
  %payloads_aligned = buffer.assume.alignment %expert_payloads {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %combined_payload {minimum_alignment = 4} : buffer
  %ids_storage, %weights_storage, %payload_storage, %output_storage = buffer.assume.noalias %ids_aligned, %weights_aligned, %payloads_aligned, %output_aligned : buffer, buffer, buffer, buffer
  %ids = buffer.view %ids_storage[%base] : buffer -> view<32xi32>
  %weights = buffer.view %weights_storage[%base] : buffer -> view<32xf32>
  %payloads = buffer.view %payload_storage[%base] : buffer -> view<4x4xf32>
  %output = buffer.view %output_storage[%base] : buffer -> view<4xf32>
  %combined = scf.for %route = [%begin to %count step %step](%accumulator = %initial : vector<4xf32>) -> (vector<4xf32>) pipeline(%depth) {
    %expert_id = view.load %ids[%route] : view<32xi32> -> i32
    %valid = scalar.cmpi sge, %expert_id, %first_expert_id : i32
    %next = scf.if %valid -> (vector<4xf32>) {
      %expert_index = index.cast %expert_id : i32 to index
      %expert = index.assume %expert_index [range(%expert_index, 0, 3)] : index
      %weight = view.load %weights[%route] : view<32xf32> -> f32
      %payload = vector.load %payloads[%expert, %begin] : view<4x4xf32> -> vector<4xf32>
      %weight_vector = vector.splat %weight : vector<4xf32>
      %weighted = vector.mulf<contract> %payload, %weight_vector : vector<4xf32>
      %updated = vector.addf<contract> %accumulator, %weighted : vector<4xf32>
      scf.yield %updated : vector<4xf32>
    } else {
      scf.yield %accumulator : vector<4xf32>
    }
    scf.yield %next : vector<4xf32>
  }
  vector.store %combined, %output[%begin] : vector<4xf32>, view<4xf32>
  kernel.return
}

// Produces boundary-count inputs plus duplicate, masked, and ordered rounding
// witnesses without exposing the selected values to target compilation.
func.def @moe_routed_combine_inputs(%trial: index, %route_ids: buffer, %route_weights: buffer, %expert_payloads: buffer) -> (index) {
  %base = index.constant 0 : offset
  %ids = buffer.view %route_ids[%base] : buffer -> view<32xi32>
  %weights = buffer.view %route_weights[%base] : buffer -> view<32xf32>
  %payloads = buffer.view %expert_payloads[%base] : buffer -> view<16xf32>
  %begin = index.constant 0 : index
  %route_end = index.constant 32 : index
  %payload_end = index.constant 16 : index
  %step = index.constant 1 : index
  %c6 = index.constant 6 : index
  %c9 = index.constant 9 : index
  %c12 = index.constant 12 : index
  %c14 = index.constant 14 : index
  %c1 = index.constant 1 : index
  %c19 = index.constant 19 : index
  %below_six = index.cmp ult, %trial, %c6 : index
  %count = scf.if %below_six -> (index) {
    scf.yield %trial : index
  } else {
    %below_nine = index.cmp ult, %trial, %c9 : index
    %upper_count = scf.if %below_nine -> (index) {
      %value = index.add %trial, %c1 : index
      scf.yield %value : index
    } else {
      %below_twelve = index.cmp ult, %trial, %c12 : index
      %high_count = scf.if %below_twelve -> (index) {
        %value = index.add %trial, %c6 : index
        scf.yield %value : index
      } else {
        %below_fourteen = index.cmp ult, %trial, %c14 : index
        %boundary_count = scf.if %below_fourteen -> (index) {
          %value = index.add %trial, %c19 : index
          scf.yield %value : index
        } else {
          %value = scf.switch %trial -> (index) {
            case 14 {
              %special = index.constant 17 : index
              scf.yield %special : index
            }
            case 15 {
              %special = index.constant 32 : index
              scf.yield %special : index
            }
            default {
              %special = index.constant 3 : index
              scf.yield %special : index
            }
          }
          scf.yield %value : index
        }
        scf.yield %boundary_count : index
      }
      scf.yield %high_count : index
    }
    scf.yield %upper_count : index
  }

  scf.switch %trial {
    case 14 {
      %expert = scalar.constant 2 : i32
      scf.for %route = [%begin to %route_end step %step] {
        view.store %expert, %ids[%route] : i32, view<32xi32>
      }
    }
    case 15 {
      %masked = scalar.constant -1 : i32
      scf.for %route = [%begin to %route_end step %step] {
        view.store %masked, %ids[%route] : i32, view<32xi32>
      }
    }
    case 16 {
      %expert = scalar.constant 0 : i32
      %period = index.constant 3 : index
      scf.for %route = [%begin to %route_end step %step] {
        view.store %expert, %ids[%route] : i32, view<32xi32>
        %phase = index.rem %route, %period : index
        %weight = scf.switch %phase -> (f32) {
          case 0 {
            %value = scalar.constant 16777216.0 : f32
            scf.yield %value : f32
          }
          case 1 {
            %value = scalar.constant 1.0 : f32
            scf.yield %value : f32
          }
          default {
            %value = scalar.constant -16777214.0 : f32
            scf.yield %value : f32
          }
        }
        view.store %weight, %weights[%route] : f32, view<32xf32>
      }
      %payload_value = scalar.constant 1.0 : f32
      scf.for %element = [%begin to %payload_end step %step] {
        view.store %payload_value, %payloads[%element] : f32, view<16xf32>
      }
    }
    default {
    }
  }
  func.return %count : index
}

// Scalar ordered reference for the vectorized pipelined kernel.
func.def @moe_routed_combine_loop_f32_oracle(%route_count: index, %route_ids: buffer, %route_weights: buffer, %expert_payloads: buffer, %combined_payload: buffer) {
  %count = index.assume %route_count [range(%route_count, 0, 32)] : index
  %base = index.constant 0 : offset
  %ids = buffer.view %route_ids[%base] : buffer -> view<32xi32>
  %weights = buffer.view %route_weights[%base] : buffer -> view<32xf32>
  %payloads = buffer.view %expert_payloads[%base] : buffer -> view<4x4xf32>
  %output = buffer.view %combined_payload[%base] : buffer -> view<4xf32>
  %begin = index.constant 0 : index
  %channel_end = index.constant 4 : index
  %step = index.constant 1 : index
  %first_expert_id = scalar.constant 0 : i32
  %initial_sum = scalar.constant 0.0 : f32
  scf.for %channel = [%begin to %channel_end step %step] {
    %combined = scf.for %route = [%begin to %count step %step](%sum = %initial_sum : f32) -> (f32) {
      %expert_id = view.load %ids[%route] : view<32xi32> -> i32
      %valid = scalar.cmpi sge, %expert_id, %first_expert_id : i32
      %next = scf.if %valid -> (f32) {
        %expert_index = index.cast %expert_id : i32 to index
        %expert = index.assume %expert_index [range(%expert_index, 0, 3)] : index
        %weight = view.load %weights[%route] : view<32xf32> -> f32
        %payload = view.load %payloads[%expert, %channel] : view<4x4xf32> -> f32
        %weighted = scalar.mulf %payload, %weight : f32
        %updated = scalar.addf %sum, %weighted : f32
        scf.yield %updated : f32
      } else {
        scf.yield %sum : f32
      }
      scf.yield %next : f32
    }
    view.store %combined, %output[%channel] : f32, view<4xf32>
  }
  func.return
}

check.scenario @moe_routed_combine_loop_values {
  check.trial[17](%trial: index, %entropy: check.entropy) {
    %ids = check.generate.iota offset(3) step(-1) period(5) : tensor<32xi32>
    %weights = check.generate.iota offset(0.125) step(0.125) : tensor<32xf32>
    %payloads = check.generate.iota offset(-8.0) step(1.0) : tensor<4x4xf32>
    %count = check.generate<@moe_routed_combine_inputs>(%trial, %ids, %weights, %payloads) : (index, tensor<32xi32>, tensor<32xf32>, tensor<4x4xf32>) -> (index)
    %output = check.generate.fill value(-1000.0) : tensor<4xf32>
    check.compare<@moe_routed_combine_loop_f32, @moe_routed_combine_loop_f32_oracle>(%count, %ids, %weights, %payloads, %output) : (index, tensor<32xi32>, tensor<32xf32>, tensor<4x4xf32>, tensor<4xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xf32>
    }
  }
  check.return
}
