kernel.decl @grouped_paged_attention_independent(%workload_pair_count: index) launch(%launch_pair_count: index, %lengths: buffer, %query: buffer, %page_table: buffer, %keys: buffer, %values: buffer, %final_state: buffer, %output: buffer)

kernel.decl @grouped_paged_attention_shared_serial(%workload_pair_count: index) launch(%launch_pair_count: index, %lengths: buffer, %query: buffer, %page_table: buffer, %keys: buffer, %values: buffer, %final_state: buffer, %output: buffer)

kernel.decl @grouped_paged_attention_shared(%workload_pair_count: index) launch(%launch_pair_count: index, %lengths: buffer, %query: buffer, %page_table: buffer, %keys: buffer, %values: buffer, %final_state: buffer, %output: buffer)

// Eighteen benchmark samples cover three policies, 128- and 1024-token
// prefixes, and 1, 128, and 1024 pairs. Each policy shares one target product.
func.def @grouped_paged_attention_benchmark_config(%trial: index) -> (index, i32) {
  %samples_per_length = index.constant 3 : index
  %pair_ordinal = index.rem %trial, %samples_per_length : index
  %length_ordinal = index.div %trial, %samples_per_length : index
  %pairs = scf.switch %pair_ordinal -> (index) {
    case 0 {
      %value = index.constant 1 : index
      scf.yield %value : index
    }
    case 1 {
      %value = index.constant 128 : index
      scf.yield %value : index
    }
    default {
      %value = index.constant 1024 : index
      scf.yield %value : index
    }
  }
  %length = scf.switch %length_ordinal -> (i32) {
    case 0 {
      %value = scalar.constant 128 : i32
      scf.yield %value : i32
    }
    default {
      %value = scalar.constant 1024 : i32
      scf.yield %value : i32
    }
  }
  func.return %pairs, %length : index, i32
}

func.def @grouped_paged_attention_benchmark_lengths(%pair_count: index, %length: i32, %lengths_buffer: buffer) {
  %pairs = index.assume %pair_count [range(%pair_count, 1, 1024)] : index
  %base = index.constant 0 : offset
  %lengths = buffer.view %lengths_buffer[%base] : buffer -> view<[%pairs]x2xi32>
  %begin = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  scf.for %pair = [%begin to %pairs step %c1] {
    scf.for %head = [%begin to %c2 step %c1] {
      view.store %length, %lengths[%pair, %head] : i32, view<[%pairs]x2xi32>
    }
  }
  func.return
}

check.scenario @grouped_paged_attention_independent_benchmark {
  check.trial[6](%trial: index, %entropy: check.entropy) {
    %pairs, %length = check.generate<@grouped_paged_attention_benchmark_config>(%trial) : (index) -> (index, i32)
    %seed = check.literal value(7451) : i64
    %lengths = check.generate.fill value(0) : tensor<[%pairs]x2xi32>
    check.generate<@grouped_paged_attention_benchmark_lengths>(%pairs, %length, %lengths) : (index, i32, tensor<[%pairs]x2xi32>) -> ()
    %query = check.generate.fill value(0.0) : tensor<[%pairs]x2x128xf32>
    %pages = check.generate.random.uniform seed(%seed) range(0 to 4095) : tensor<[%pairs]x64xi32>
    %keys = check.generate.iota offset(-0.5) step(0.00390625) period(257) : tensor<65536x128xf32>
    %values = check.generate.iota offset(-4.0) step(0.0625) period(128) : tensor<65536x128xf32>
    %state = check.generate.fill value(-10000.0) : tensor<[%pairs]x2x2xf32>
    %output = check.generate.fill value(-20000.0) : tensor<[%pairs]x2x128xf32>
    check.invoke<@grouped_paged_attention_independent>[%pairs](%pairs, %lengths, %query, %pages, %keys, %values, %state, %output) : [index](index, tensor<[%pairs]x2xi32>, tensor<[%pairs]x2x128xf32>, tensor<[%pairs]x64xi32>, tensor<65536x128xf32>, tensor<65536x128xf32>, tensor<[%pairs]x2x2xf32>, tensor<[%pairs]x2x128xf32>) -> ()
  }
  check.return
}

check.benchmark<@grouped_paged_attention_independent_benchmark> @grouped_paged_attention_independent_workloads

