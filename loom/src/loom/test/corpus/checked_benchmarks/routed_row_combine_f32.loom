// Ordered combine of routed expert-output rows into 1024-channel token rows.
//
// Each token selects up to 32 rows from a 4096-row pool. Route IDs are -1
// (dropped) or in [0, 4095]; duplicates contribute once per route, in order.
// Weights are read only for present routes. Buffers are disjoint, four-byte
// aligned, and contain all selected rows. Inputs are finite; contraction is
// allowed, while reassociation of the accumulation is not.
//
// The matched unroll-two kernels separate a serial dependent-load chain from
// an explicit pipeline: route IDs lead consumption by two iterations, while
// weights and payloads lead it by one. The shorter payload queue reduces live
// state. This is an author-selected schedule, not a recommended universal depth.

kernel.def @routed_row_combine_serial(%token_count: index) {
  %unit = index.constant 1 : index
  %width = index.constant 128 : index
  %tiles = index.constant 8 : index
  kernel.launch.config workgroups(%tiles, %token_count, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%route_count: index, %token_count: index, %route_ids: buffer, %route_weights: buffer, %row_buffer: buffer, %combined_rows: buffer) {
  %count = index.assume %route_count [range(%route_count, 0, 32)] : index
  %factor = index.constant 2 : index
  %local_channel = kernel.workitem.id<x> : index
  %channel_tile = kernel.workgroup.id<x> : index
  %token_id = kernel.workgroup.id<y> : index
  %token, %tokens = index.assume %token_id, %token_count [range(%token_count, 1, 256), lt(%token_id, %token_count)] : index, index
  %width = index.constant 128 : index
  %tile_base = index.mul %channel_tile, %width : index
  %channel_id = index.add %tile_base, %local_channel : index
  %channel = index.assume %channel_id [range(%channel_id, 0, 1023)] : index
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %base = index.constant 0 : offset
  %first_row_id = scalar.constant 0 : i32
  %identity = scalar.constant 0.0 : f32
  %ids_aligned = buffer.assume.alignment %route_ids {minimum_alignment = 4} : buffer
  %weights_aligned = buffer.assume.alignment %route_weights {minimum_alignment = 4} : buffer
  %rows_aligned = buffer.assume.alignment %row_buffer {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %combined_rows {minimum_alignment = 4} : buffer
  %ids_storage, %weights_storage, %row_storage, %output_storage = buffer.assume.noalias %ids_aligned, %weights_aligned, %rows_aligned, %output_aligned : buffer, buffer, buffer, buffer
  %ids = buffer.view %ids_storage[%base] : buffer -> view<[%tokens]x32xi32>
  %weights = buffer.view %weights_storage[%base] : buffer -> view<[%tokens]x32xf32>
  %rows = buffer.view %row_storage[%base] : buffer -> view<4096x1024xf32>
  %output = buffer.view %output_storage[%base] : buffer -> view<[%tokens]x1024xf32>
  %combined = scf.for %route = [%begin to %count step %step](%accumulator = %identity : f32) -> (f32) unroll(%factor) {
    %row_id = view.load %ids[%token, %route] : view<[%tokens]x32xi32> -> i32
    %valid = scalar.cmpi sge, %row_id, %first_row_id : i32
    %weight, %payload = scf.if %valid -> (f32, f32) {
      %row_index0 = index.cast %row_id : i32 to index
      %row_index = index.assume %row_index0 [range(%row_index0, 0, 4095)] : index
      %loaded_weight = view.load %weights[%token, %route] : view<[%tokens]x32xf32> -> f32
      %loaded_payload = view.load %rows[%row_index, %channel] : view<4096x1024xf32> -> f32
      scf.yield %loaded_weight, %loaded_payload : f32, f32
    } else {
      scf.yield %identity, %identity : f32, f32
    }
    %next = scf.if %valid -> (f32) {
      %weighted = scalar.mulf<contract> %payload, %weight : f32
      %updated = scalar.addf<contract> %accumulator, %weighted : f32
      scf.yield %updated : f32
    } else {
      scf.yield %accumulator : f32
    }
    scf.yield %next : f32
  }
  view.store %combined, %output[%token, %channel] : f32, view<[%tokens]x1024xf32>
  kernel.return
}

kernel.def @routed_row_combine_pipelined(%token_count: index) {
  %unit = index.constant 1 : index
  %width = index.constant 128 : index
  %tiles = index.constant 8 : index
  kernel.launch.config workgroups(%tiles, %token_count, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%route_count: index, %token_count: index, %route_ids: buffer, %route_weights: buffer, %row_buffer: buffer, %combined_rows: buffer) {
  %count = index.assume %route_count [range(%route_count, 0, 32)] : index
  %local_channel = kernel.workitem.id<x> : index
  %channel_tile = kernel.workgroup.id<x> : index
  %token_id = kernel.workgroup.id<y> : index
  %token, %tokens = index.assume %token_id, %token_count [range(%token_count, 1, 256), lt(%token_id, %token_count)] : index, index
  %width = index.constant 128 : index
  %tile_base = index.mul %channel_tile, %width : index
  %channel_id = index.add %tile_base, %local_channel : index
  %channel = index.assume %channel_id [range(%channel_id, 0, 1023)] : index
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %base = index.constant 0 : offset
  %first_row_id = scalar.constant 0 : i32
  %identity = scalar.constant 0.0 : f32
  %ids_aligned = buffer.assume.alignment %route_ids {minimum_alignment = 4} : buffer
  %weights_aligned = buffer.assume.alignment %route_weights {minimum_alignment = 4} : buffer
  %rows_aligned = buffer.assume.alignment %row_buffer {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %combined_rows {minimum_alignment = 4} : buffer
  %ids_storage, %weights_storage, %row_storage, %output_storage = buffer.assume.noalias %ids_aligned, %weights_aligned, %rows_aligned, %output_aligned : buffer, buffer, buffer, buffer
  %ids = buffer.view %ids_storage[%base] : buffer -> view<[%tokens]x32xi32>
  %weights = buffer.view %weights_storage[%base] : buffer -> view<[%tokens]x32xf32>
  %rows = buffer.view %row_storage[%base] : buffer -> view<4096x1024xf32>
  %output = buffer.view %output_storage[%base] : buffer -> view<[%tokens]x1024xf32>
  // A missing ID and invalid payload make startup and drain ordinary guarded
  // iterations. The extra two ticks retire the final route and payload.
  %missing = scalar.constant -1 : i32
  %inactive = scalar.constant false : i1
  %distance = index.constant 2 : index
  %metadata_gap = index.constant 1 : index
  %factor = index.constant 2 : index
  %ticks = index.add %count, %distance : index
  // Two unrolled ticks expose the ID/payload/consumer sequence within each
  // outer loop body. The guards handle startup, drain and dynamic tails.
  %final_id, %final_valid, %final_weight, %final_value, %combined = scf.for %batch = [%begin to %ticks step %factor](%queued_id = %missing : i32, %queued_valid = %inactive : i1, %queued_weight = %identity : f32, %queued_value = %identity : f32, %accumulator = %identity : f32) -> (i32, i1, f32, f32, f32) {
    %next_id, %next_valid, %next_weight, %next_value, %next_sum = scf.for %slot = [%begin to %factor step %step](%ahead_id = %queued_id : i32, %ready = %queued_valid : i1, %ready_weight = %queued_weight : f32, %ready_value = %queued_value : f32, %sum = %accumulator : f32) -> (i32, i1, f32, f32, f32) unroll(%factor) {
      %route = index.add %batch, %slot : index
      %in_range = index.cmp slt, %route, %count : index
      // This ID has no immediate dependent use: it will address the next
      // payload after the current payload issue and older accumulation.
      %issued_id = scf.if %in_range -> (i32) {
        %loaded_id = view.load %ids[%token, %route] : view<[%tokens]x32xi32> -> i32
        scf.yield %loaded_id : i32
      } else {
        scf.yield %missing : i32
      }
      %loaded_valid = scalar.cmpi sge, %ahead_id, %first_row_id : i32
      %loaded_value, %loaded_weight, %next = scf.if %loaded_valid -> (f32, f32, f32) {
        %row_index0 = index.cast %ahead_id : i32 to index
        %row_index = index.assume %row_index0 [range(%row_index0, 0, 4095)] : index
        %payload_route0 = index.sub %route, %metadata_gap : index
        // A present queued ID came from route-1 in the previous iteration;
        // the issue guard therefore established this route's bounds.
        %payload_route = index.assume %payload_route0 [range(%payload_route0, 0, 31)] : index
        %payload = view.load %rows[%row_index, %channel] : view<4096x1024xf32> -> f32
        %weight = view.load %weights[%token, %payload_route] : view<[%tokens]x32xf32> -> f32
        // Keep these future reads ahead of the older arithmetic. The fence
        // constrains scheduling and emits no hardware wait.
        scf.schedule.fence
        %weighted = scalar.mulf<contract> %ready_value, %ready_weight : f32
        %updated = scalar.addf<contract> %sum, %weighted : f32
        %consumed = scf.select %ready, %updated, %sum : f32
        scf.yield %payload, %weight, %consumed : f32, f32, f32
      } else {
        %weighted = scalar.mulf<contract> %ready_value, %ready_weight : f32
        %updated = scalar.addf<contract> %sum, %weighted : f32
        %consumed = scf.select %ready, %updated, %sum : f32
        scf.yield %identity, %identity, %consumed : f32, f32, f32
      }
      scf.yield %issued_id, %loaded_valid, %loaded_weight, %loaded_value, %next : i32, i1, f32, f32, f32
    }
    scf.yield %next_id, %next_valid, %next_weight, %next_value, %next_sum : i32, i1, f32, f32, f32
  }
  view.store %combined, %output[%token, %channel] : f32, view<[%tokens]x1024xf32>
  kernel.return
}

// Random IDs around the 16-route queue boundary complement the structured
// small and end boundaries in @routed_row_combine_holes. Dyadic inputs make
// every intermediate exact, so bitwise agreement observes payload/weight
// pairing without tolerating reordered or missing contributions.
check.case public @routed_row_combine_varied {
  %count = check.param.choice values([15, 16, 17]) : index
  %tokens = check.literal value(1) : index
  %seed = check.literal value(727) : i64
  %ids = check.generate.random.uniform seed(%seed) range(-1 to 3) : tensor<1x32xi32>
  %weights = check.generate.iota offset(-0.25) step(0.125) period(7) : tensor<[%tokens]x32xf32>
  %rows = check.generate.iota offset(-8.0) step(0.0625) period(257) : tensor<4x1024xf32>
  %serial = check.generate.fill value(-10000.0) : tensor<[%tokens]x1024xf32>
  %pipelined = check.generate.fill value(-20000.0) : tensor<[%tokens]x1024xf32>
  kernel.launch @routed_row_combine_serial[%tokens](%count, %tokens, %ids, %weights, %rows, %serial) : [index](index, index, tensor<1x32xi32>, tensor<[%tokens]x32xf32>, tensor<4x1024xf32>, tensor<[%tokens]x1024xf32>)
  kernel.launch @routed_row_combine_pipelined[%tokens](%count, %tokens, %ids, %weights, %rows, %pipelined) : [index](index, index, tensor<1x32xi32>, tensor<[%tokens]x32xf32>, tensor<4x1024xf32>, tensor<[%tokens]x1024xf32>)
  check.expect.bitwise actual(%pipelined) expected(%serial) : tensor<[%tokens]x1024xf32>
  check.return
}

// One multi-token sample proves that workgroup-y ownership remains independent
// without multiplying every route boundary by the token count and random seed.
check.case public @routed_row_combine_multi_token {
  %count = check.literal value(17) : index
  %tokens = check.literal value(16) : index
  %seed = check.literal value(728) : i64
  %ids = check.generate.random.uniform seed(%seed) range(-1 to 3) : tensor<16x32xi32>
  %weights = check.generate.iota offset(-0.25) step(0.125) period(7) : tensor<16x32xf32>
  %rows = check.generate.iota offset(-8.0) step(0.0625) period(257) : tensor<4x1024xf32>
  %serial = check.generate.fill value(-10000.0) : tensor<16x1024xf32>
  %pipelined = check.generate.fill value(-20000.0) : tensor<16x1024xf32>
  kernel.launch @routed_row_combine_serial[%tokens](%count, %tokens, %ids, %weights, %rows, %serial) : [index](index, index, tensor<16x32xi32>, tensor<16x32xf32>, tensor<4x1024xf32>, tensor<16x1024xf32>)
  kernel.launch @routed_row_combine_pipelined[%tokens](%count, %tokens, %ids, %weights, %rows, %pipelined) : [index](index, index, tensor<16x32xi32>, tensor<16x32xf32>, tensor<4x1024xf32>, tensor<16x1024xf32>)
  check.expect.bitwise actual(%pipelined) expected(%serial) : tensor<16x1024xf32>
  check.return
}

// The final legal row proves the 4095 address boundary once. Values encode the
// absolute element index, so reading any other row cannot satisfy the oracle.
check.case public @routed_row_combine_high_row {
  %count = check.literal value(1) : index
  %tokens = check.literal value(1) : index
  %ids = check.generate.fill value(4095) : tensor<1x32xi32>
  %weights = check.generate.fill value(1.0) : tensor<1x32xf32>
  %rows = check.generate.iota offset(0.0) step(1.0) : tensor<4096x1024xf32>
  %expected = check.generate.iota offset(4193280.0) step(1.0) : tensor<1x1024xf32>
  %serial = check.generate.fill value(-10000.0) : tensor<1x1024xf32>
  %pipelined = check.generate.fill value(-20000.0) : tensor<1x1024xf32>
  kernel.launch @routed_row_combine_serial[%tokens](%count, %tokens, %ids, %weights, %rows, %serial) : [index](index, index, tensor<1x32xi32>, tensor<1x32xf32>, tensor<4096x1024xf32>, tensor<1x1024xf32>)
  kernel.launch @routed_row_combine_pipelined[%tokens](%count, %tokens, %ids, %weights, %rows, %pipelined) : [index](index, index, tensor<1x32xi32>, tensor<1x32xf32>, tensor<4096x1024xf32>, tensor<1x1024xf32>)
  check.expect.bitwise actual(%serial) expected(%expected) : tensor<1x1024xf32>
  check.expect.bitwise actual(%pipelined) expected(%expected) : tensor<1x1024xf32>
  check.return
}

// Route-order accumulation is independent of the target's pipelined load
// queues. Initializing the output once and visiting routes outermost avoids
// repeating route metadata work for every scalar output element.
func.def @routed_row_combine_oracle(%route_count: index, %token_count: index, %route_ids_buffer: buffer, %route_weights_buffer: buffer, %row_buffer: buffer, %combined_rows_buffer: buffer) {
  %count = index.assume %route_count [range(%route_count, 0, 32)] : index
  %tokens = index.assume %token_count [range(%token_count, 1, 256)] : index
  %base = index.constant 0 : offset
  %route_ids = buffer.view %route_ids_buffer[%base] : buffer -> view<[%tokens]x32xi32>
  %route_weights = buffer.view %route_weights_buffer[%base] : buffer -> view<[%tokens]x32xf32>
  %rows = buffer.view %row_buffer[%base] : buffer -> view<4096x1024xf32>
  %combined_rows = buffer.view %combined_rows_buffer[%base] : buffer -> view<[%tokens]x1024xf32>
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %channel_count = index.constant 1024 : index
  %first_row_id = scalar.constant 0 : i32
  %identity = scalar.constant 0.0 : f32
  %output_length = buffer.length %combined_rows_buffer
  buffer.fill %identity, %combined_rows_buffer[%base], %output_length : f32
  scf.for %token = [%begin to %tokens step %step] {
    scf.for %route = [%begin to %count step %step] {
      %row_id = view.load %route_ids[%token, %route] : view<[%tokens]x32xi32> -> i32
      %valid = scalar.cmpi sge, %row_id, %first_row_id : i32
      scf.if %valid {
        %row_index0 = index.cast %row_id : i32 to index
        %row_index = index.assume %row_index0 [range(%row_index0, 0, 4095)] : index
        %weight = view.load %route_weights[%token, %route] : view<[%tokens]x32xf32> -> f32
        scf.for %channel = [%begin to %channel_count step %step] {
          %payload = view.load %rows[%row_index, %channel] : view<4096x1024xf32> -> f32
          %accumulator = view.load %combined_rows[%token, %channel] : view<[%tokens]x1024xf32> -> f32
          %weighted = scalar.mulf<contract> %payload, %weight : f32
          %updated = scalar.addf<contract> %accumulator, %weighted : f32
          view.store %updated, %combined_rows[%token, %channel] : f32, view<[%tokens]x1024xf32>
        }
      }
    }
  }
  func.return
}

func.def @routed_row_combine_holes_count(%trial: index) -> (index) {
  %c6 = index.constant 6 : index
  %c9 = index.constant 9 : index
  %c1 = index.constant 1 : index
  %c22 = index.constant 22 : index
  %after_gap = index.add %trial, %c1 : index
  %high = index.add %trial, %c22 : index
  %has_gap = index.cmp uge, %trial, %c6 : index
  %is_high = index.cmp uge, %trial, %c9 : index
  %low_or_middle = scf.select %has_gap, %after_gap, %trial : index
  %count = scf.select %is_high, %high, %low_or_middle : index
  func.return %count : index
}

func.def @routed_row_combine_absent_count(%trial: index) -> (index) {
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c8 = index.constant 8 : index
  %c32 = index.constant 32 : index
  %small = index.cmp ult, %trial, %c4 : index
  %last = index.cmp eq, %trial, %c5 : index
  %large = scf.select %last, %c32, %c8 : index
  %count = scf.select %small, %trial, %large : index
  func.return %count : index
}

// Runtime trials share the one-token target and VM products while keeping the
// exact four-row and one-row backing allocations that make guarded reads
// observable. The model-sized row-4095 case above remains independently owned.
check.scenario @routed_row_combine_structured {
  // Nonmonotonic and repeated rows keep separate weights; every fifth route is
  // absent. The semantic oracle checks every queue boundary, including count 5.
  check.trial[11](%trial: index, %entropy: check.entropy) {
    %count = check.generate<@routed_row_combine_holes_count>(%trial) : (index) -> (index)
    %tokens = check.literal value(1) : index
    %ids = check.generate.iota offset(3) step(-1) period(5) : tensor<1x32xi32>
    %weights = check.generate.iota offset(0.125) step(0.125) : tensor<1x32xf32>
    %rows = check.generate.iota offset(-8.0) step(0.0625) period(257) : tensor<4x1024xf32>
    %output = check.generate.fill value(-20000.0) : tensor<1x1024xf32>
    check.compare<@routed_row_combine_pipelined, @routed_row_combine_oracle>[%tokens](%count, %tokens, %ids, %weights, %rows, %output) : [index](index, index, tensor<1x32xi32>, tensor<1x32xf32>, tensor<4x1024xf32>, tensor<1x1024xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<1x1024xf32>
    }
  }

  // Four present routes have total weight 1.25 and weighted row index 1.25.
  // With payload(row,channel)=1024*row+channel-8, the result is
  // 1270+1.25*channel.
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %count = check.literal value(5) : index
    %tokens = check.literal value(1) : index
    %ids = check.generate.iota offset(3) step(-1) period(5) : tensor<1x32xi32>
    %weights = check.generate.iota offset(0.125) step(0.125) : tensor<1x32xf32>
    %rows = check.generate.iota offset(-8.0) step(1.0) : tensor<4x1024xf32>
    %output = check.generate.fill value(-20000.0) : tensor<1x1024xf32>
    %expected = check.generate.iota offset(1270.0) step(1.25) : tensor<1x1024xf32>
    check.compare<@routed_row_combine_pipelined, @routed_row_combine_oracle>[%tokens](%count, %tokens, %ids, %weights, %rows, %output) : [index](index, index, tensor<1x32xi32>, tensor<1x32xf32>, tensor<4x1024xf32>, tensor<1x1024xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<1x1024xf32>
      check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<1x1024xf32>
    }
  }

  // Missing routes must not read the intentionally one-element weight or row
  // allocations, even when the logical route count reaches 32.
  check.trial[6](%trial: index, %entropy: check.entropy) {
    %count = check.generate<@routed_row_combine_absent_count>(%trial) : (index) -> (index)
    %tokens = check.literal value(1) : index
    %ids = check.generate.fill value(-1) : tensor<1x32xi32>
    %weights = check.generate.fill value(1.0) : tensor<1xf32>
    %rows = check.generate.fill value(1.0) : tensor<1x1024xf32>
    %output = check.generate.fill value(-20000.0) : tensor<1x1024xf32>
    %expected = check.generate.fill value(0.0) : tensor<1x1024xf32>
    check.compare<@routed_row_combine_pipelined, @routed_row_combine_oracle>[%tokens](%count, %tokens, %ids, %weights, %rows, %output) : [index](index, index, tensor<1x32xi32>, tensor<1xf32>, tensor<1x1024xf32>, tensor<1x1024xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<1x1024xf32>
      check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<1x1024xf32>
    }
  }

  // [2^24, 1, -(2^24-2)] sums to 2 in route order and 3 in reverse order.
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %count = check.literal value(3) : index
    %tokens = check.literal value(1) : index
    %ids = check.generate.fill value(0) : tensor<1x32xi32>
    %weights = check.generate.iota offset(16777216.0) step(-16777215.0) period(3) : tensor<1x32xf32>
    %rows = check.generate.fill value(1.0) : tensor<1x1024xf32>
    %output = check.generate.fill value(-20000.0) : tensor<1x1024xf32>
    %expected = check.generate.fill value(2.0) : tensor<1x1024xf32>
    check.compare<@routed_row_combine_pipelined, @routed_row_combine_oracle>[%tokens](%count, %tokens, %ids, %weights, %rows, %output) : [index](index, index, tensor<1x32xi32>, tensor<1x32xf32>, tensor<1x1024xf32>, tensor<1x1024xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<1x1024xf32>
      check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<1x1024xf32>
    }
  }
  check.return
}
