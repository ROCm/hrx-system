check.benchmark<@streaming_packed_s8_dot_serial_unroll2_n128> @streaming_packed_s8_dot_serial_unroll2_n128_time

// Three retained records let two future records load while two older records
// compute. Startup and drain preserve the original recurrence; fewer than
// three records use the serial loop. Unroll remains independent of lookahead.
kernel.def @streaming_packed_s8_dot_pipelined_depth4_unroll2() {
  %unit = index.constant 1 : index
  %width = index.constant 32 : index
  %groups = index.constant 64 : index
  kernel.launch.config workgroups(%groups, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%record_count: index, %field_buffer: buffer, %scale_buffer: buffer, %rhs_buffer: buffer, %output_buffer: buffer) {
  %unroll_factor = index.constant 2 : index
  %count = index.assume %record_count [range(%record_count, 0, 128)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %width = index.constant 32 : index
  %base = index.constant 0 : offset
  %rhs_width = index.constant 64 : index
  %initial = scalar.constant 0.0 : f32
  %group = kernel.workgroup.id<x> : index
  %local_lane = kernel.workitem.id<x> : index
  %group_base = index.mul %group, %width : index
  %lane0 = index.add %group_base, %local_lane : index
  %lane = index.assume %lane0 [range(%lane0, 0, 2047)] : index
  %rhs_lane = index.rem %lane, %rhs_width : index
  %aligned_fields = buffer.assume.alignment %field_buffer {minimum_alignment = 4} : buffer
  %aligned_scales = buffer.assume.alignment %scale_buffer {minimum_alignment = 2} : buffer
  %aligned_rhs = buffer.assume.alignment %rhs_buffer {minimum_alignment = 4} : buffer
  %aligned_output = buffer.assume.alignment %output_buffer {minimum_alignment = 4} : buffer
  %field_storage, %scale_storage, %rhs_storage, %output_storage = buffer.assume.noalias %aligned_fields, %aligned_scales, %aligned_rhs, %aligned_output : buffer, buffer, buffer, buffer
  %fields = buffer.view %field_storage[%base] : buffer -> view<128x2048xi32>
  %scales = buffer.view %scale_storage[%base] : buffer -> view<128x2048xf16>
  %rhs = buffer.view %rhs_storage[%base] : buffer -> view<128x64x4xf32>
  %output = buffer.view %output_storage[%base] : buffer -> view<2048xf32>
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %can_start = index.cmp sge, %count, %c3 : index
  %total = scf.if %can_start -> (f32) {
    %startup0_packed = vector.load %fields[%c0, %lane] : view<128x2048xi32> -> vector<1xi32>
    %startup0_scale = view.load %scales[%c0, %lane] : view<128x2048xf16> -> f16
    %startup0_rhs = vector.load %rhs[%c0, %rhs_lane, %c0] : view<128x64x4xf32> -> vector<4xf32>
    %startup1_packed = vector.load %fields[%c1, %lane] : view<128x2048xi32> -> vector<1xi32>
    %startup1_scale = view.load %scales[%c1, %lane] : view<128x2048xf16> -> f16
    %startup1_rhs = vector.load %rhs[%c1, %rhs_lane, %c0] : view<128x64x4xf32> -> vector<4xf32>
    %startup2_packed = vector.load %fields[%c2, %lane] : view<128x2048xi32> -> vector<1xi32>
    %startup2_scale = view.load %scales[%c2, %lane] : view<128x2048xf16> -> f16
    %startup2_rhs = vector.load %rhs[%c2, %rhs_lane, %c0] : view<128x64x4xf32> -> vector<4xf32>
    %last0_packed, %last0_scale, %last0_rhs, %last1_packed, %last1_scale, %last1_rhs, %last2_packed, %last2_scale, %last2_rhs, %subtotal = scf.for %record = [%c3 to %count step %c1](%slot0_packed = %startup0_packed : vector<1xi32>, %slot0_scale = %startup0_scale : f16, %slot0_rhs = %startup0_rhs : vector<4xf32>, %slot1_packed = %startup1_packed : vector<1xi32>, %slot1_scale = %startup1_scale : f16, %slot1_rhs = %startup1_rhs : vector<4xf32>, %slot2_packed = %startup2_packed : vector<1xi32>, %slot2_scale = %startup2_scale : f16, %slot2_rhs = %startup2_rhs : vector<4xf32>, %sum = %initial : f32) -> (vector<1xi32>, f16, vector<4xf32>, vector<1xi32>, f16, vector<4xf32>, vector<1xi32>, f16, vector<4xf32>, f32) unroll(%unroll_factor) schedule(recurrence) {
      %future_packed = vector.load %fields[%record, %lane] : view<128x2048xi32> -> vector<1xi32>
      %future_scale = view.load %scales[%record, %lane] : view<128x2048xf16> -> f16
      %future_rhs = vector.load %rhs[%record, %rhs_lane, %c0] : view<128x64x4xf32> -> vector<4xf32>
      %current_integers = vector.bitunpacks<8> %slot0_packed : vector<1xi32> -> vector<4xi32>
      %current_floats = vector.sitofp %current_integers : vector<4xi32> to vector<4xf32>
      %current_scale_f32 = scalar.extf %slot0_scale : f16 to f32
      %current_scale_vector = vector.splat %current_scale_f32 : vector<4xf32>
      %current_scaled = vector.mulf<reassoc|nnan|ninf|nsz|contract> %current_floats, %current_scale_vector : vector<4xf32>
      %current_updated = vector.dotf %current_scaled, %slot0_rhs, %sum : vector<4xf32>, vector<4xf32>, f32
      scf.yield %slot1_packed, %slot1_scale, %slot1_rhs, %slot2_packed, %slot2_scale, %slot2_rhs, %future_packed, %future_scale, %future_rhs, %current_updated : vector<1xi32>, f16, vector<4xf32>, vector<1xi32>, f16, vector<4xf32>, vector<1xi32>, f16, vector<4xf32>, f32
    }
    %drain0_integers = vector.bitunpacks<8> %last0_packed : vector<1xi32> -> vector<4xi32>
    %drain0_floats = vector.sitofp %drain0_integers : vector<4xi32> to vector<4xf32>
    %drain0_scale_f32 = scalar.extf %last0_scale : f16 to f32
    %drain0_scale_vector = vector.splat %drain0_scale_f32 : vector<4xf32>
    %drain0_scaled = vector.mulf<reassoc|nnan|ninf|nsz|contract> %drain0_floats, %drain0_scale_vector : vector<4xf32>
    %drain0_updated = vector.dotf %drain0_scaled, %last0_rhs, %subtotal : vector<4xf32>, vector<4xf32>, f32
    %drain1_integers = vector.bitunpacks<8> %last1_packed : vector<1xi32> -> vector<4xi32>
    %drain1_floats = vector.sitofp %drain1_integers : vector<4xi32> to vector<4xf32>
    %drain1_scale_f32 = scalar.extf %last1_scale : f16 to f32
    %drain1_scale_vector = vector.splat %drain1_scale_f32 : vector<4xf32>
    %drain1_scaled = vector.mulf<reassoc|nnan|ninf|nsz|contract> %drain1_floats, %drain1_scale_vector : vector<4xf32>
    %drain1_updated = vector.dotf %drain1_scaled, %last1_rhs, %drain0_updated : vector<4xf32>, vector<4xf32>, f32
    %drain2_integers = vector.bitunpacks<8> %last2_packed : vector<1xi32> -> vector<4xi32>
    %drain2_floats = vector.sitofp %drain2_integers : vector<4xi32> to vector<4xf32>
    %drain2_scale_f32 = scalar.extf %last2_scale : f16 to f32
    %drain2_scale_vector = vector.splat %drain2_scale_f32 : vector<4xf32>
    %drain2_scaled = vector.mulf<reassoc|nnan|ninf|nsz|contract> %drain2_floats, %drain2_scale_vector : vector<4xf32>
    %drain2_updated = vector.dotf %drain2_scaled, %last2_rhs, %drain1_updated : vector<4xf32>, vector<4xf32>, f32
    scf.yield %drain2_updated : f32
  } else {
    %short_total = scf.for %short_record = [%c0 to %count step %c1](%short_sum = %initial : f32) -> (f32) unroll(%unroll_factor) schedule(recurrence) {
      %short_current_packed = vector.load %fields[%short_record, %lane] : view<128x2048xi32> -> vector<1xi32>
      %short_current_scale = view.load %scales[%short_record, %lane] : view<128x2048xf16> -> f16
      %short_current_rhs = vector.load %rhs[%short_record, %rhs_lane, %c0] : view<128x64x4xf32> -> vector<4xf32>
      %short_current_integers = vector.bitunpacks<8> %short_current_packed : vector<1xi32> -> vector<4xi32>
      %short_current_floats = vector.sitofp %short_current_integers : vector<4xi32> to vector<4xf32>
      %short_current_scale_f32 = scalar.extf %short_current_scale : f16 to f32
      %short_current_scale_vector = vector.splat %short_current_scale_f32 : vector<4xf32>
      %short_current_scaled = vector.mulf<reassoc|nnan|ninf|nsz|contract> %short_current_floats, %short_current_scale_vector : vector<4xf32>
      %short_updated = vector.dotf %short_current_scaled, %short_current_rhs, %short_sum : vector<4xf32>, vector<4xf32>, f32
      scf.yield %short_updated : f32
    }
    scf.yield %short_total : f32
  }
  view.store %total, %output[%lane] : f32, view<2048xf32>
  kernel.return
}

