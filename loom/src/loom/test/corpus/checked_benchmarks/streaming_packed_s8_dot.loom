// Streaming packed signed-byte dequantization and dot accumulation.
//
// Independent weight rows reuse 64 activation streams across 128 records.
// The analytic samples decode [-3, -1, 2, 7], scale by 0.5, and accumulate
// against distinct activation data. Serial, depth-two and depth-four forms
// preserve the same ordered dot recurrence, including guarded startup and
// final drain. Matched unroll-two rows distinguish lookahead from unrolling.
// The closed-form result for N records and activation lane L is
// 14.5*N + 10*N*L + 320*N*(N-1). All products and partial sums are exactly
// representable in f32 for these samples. Empty, short and long loops use
// exact comparisons, so omitted, duplicated or stale input records fail.

kernel.def @streaming_packed_s8_dot_serial() {
  %unit = index.constant 1 : index
  %width = index.constant 32 : index
  %groups = index.constant 64 : index
  kernel.launch.config workgroups(%groups, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%record_count: index, %field_buffer: buffer, %scale_buffer: buffer, %rhs_buffer: buffer, %output_buffer: buffer) {
  %count = index.assume %record_count [range(%record_count, 0, 128)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %width = index.constant 32 : index
  %base = index.constant 0 : offset
  %rhs_width = index.constant 64 : index
  %initial = scalar.constant 0.0 : f32
  %group = kernel.workgroup.id<x> : index
  %local_lane = kernel.workitem.id<x> : index
  %group_base = index.mul %group, %width : index
  %lane0 = index.add %group_base, %local_lane : index
  %lane = index.assume %lane0 [range(%lane0, 0, 2047)] : index
  %rhs_lane = index.rem %lane, %rhs_width : index
  %aligned_fields = buffer.assume.alignment %field_buffer {minimum_alignment = 4} : buffer
  %aligned_scales = buffer.assume.alignment %scale_buffer {minimum_alignment = 2} : buffer
  %aligned_rhs = buffer.assume.alignment %rhs_buffer {minimum_alignment = 4} : buffer
  %aligned_output = buffer.assume.alignment %output_buffer {minimum_alignment = 4} : buffer
  %field_storage, %scale_storage, %rhs_storage, %output_storage = buffer.assume.noalias %aligned_fields, %aligned_scales, %aligned_rhs, %aligned_output : buffer, buffer, buffer, buffer
  %fields = buffer.view %field_storage[%base] : buffer -> view<128x2048xi32>
  %scales = buffer.view %scale_storage[%base] : buffer -> view<128x2048xf16>
  %rhs = buffer.view %rhs_storage[%base] : buffer -> view<128x64x4xf32>
  %output = buffer.view %output_storage[%base] : buffer -> view<2048xf32>
  %total = scf.for %record = [%c0 to %count step %c1](%sum = %initial : f32) -> (f32) {
    %current_packed = vector.load %fields[%record, %lane] : view<128x2048xi32> -> vector<1xi32>
    %current_scale = view.load %scales[%record, %lane] : view<128x2048xf16> -> f16
    %current_rhs = vector.load %rhs[%record, %rhs_lane, %c0] : view<128x64x4xf32> -> vector<4xf32>
    %current_integers = vector.bitunpacks<8> %current_packed : vector<1xi32> -> vector<4xi32>
    %current_floats = vector.sitofp %current_integers : vector<4xi32> to vector<4xf32>
    %current_scale_f32 = scalar.extf %current_scale : f16 to f32
    %current_scale_vector = vector.splat %current_scale_f32 : vector<4xf32>
    %current_scaled = vector.mulf<reassoc|nnan|ninf|nsz|contract> %current_floats, %current_scale_vector : vector<4xf32>
    %updated = vector.dotf %current_scaled, %current_rhs, %sum : vector<4xf32>, vector<4xf32>, f32
    scf.yield %updated : f32
  }
  view.store %total, %output[%lane] : f32, view<2048xf32>
  kernel.return
}

check.case public @streaming_packed_s8_dot_serial_n0 {
  %count = check.literal value(0) : index
  %fields = check.generate.fill value(117637117) : tensor<128x2048xi32>
  %scales = check.generate.fill value(0.5) : tensor<128x2048xf16>
  %rhs = check.generate.iota offset(1.0) step(1.0) : tensor<128x64x4xf32>
  %output = check.generate.fill value(-1.0) : tensor<2048xf32>
  %expected = check.generate.iota offset(0.0) step(0.0) period(64) : tensor<2048xf32>
  kernel.launch @streaming_packed_s8_dot_serial(%count, %fields, %scales, %rhs, %output) : (index, tensor<128x2048xi32>, tensor<128x2048xf16>, tensor<128x64x4xf32>, tensor<2048xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<2048xf32>
  check.return
}

