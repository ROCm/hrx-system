  kernel.launch @sparse_token_attention_pipelined[%instances](%instances, %cache_rows, %lengths, %query, %indices, %keys, %values, %pipeline_state, %pipeline_output) : [index](index, index, tensor<1xi32>, tensor<1x128xf32>, tensor<1xi32>, tensor<5x128xf32>, tensor<5x128xf32>, tensor<1x2xf32>, tensor<1x128xf32>)
