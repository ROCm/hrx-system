// Both ends of the signed ID domain must fail the unsigned validity test.
// There is no valid payload; even the sole backed K/V row is poisoned.
check.case public @sparse_token_attention_absent {
  %instances = check.literal value(1) : index
  %cache_rows = check.literal value(5) : index
  %lengths = check.generate.fill value(1024) : tensor<1xi32>
  %query = check.generate.fill value(0.0) : tensor<1x128xf32>
  %indices = check.generate.iota offset(-2147483648) step(2147483647) period(3) : tensor<1024xi32>
  %keys = check.generate.fill value(nan) : tensor<1x128xf32>
  %values = check.generate.fill value(nan) : tensor<1x128xf32>
  %serial_state = check.generate.fill value(-10000.0) : tensor<1x2xf32>
  %serial_output = check.generate.fill value(-20000.0) : tensor<1x128xf32>
  %pipeline_state = check.generate.fill value(-30000.0) : tensor<1x2xf32>
  %pipeline_output = check.generate.fill value(-40000.0) : tensor<1x128xf32>
  %expected_state = check.generate.iota offset(-1000000000.0) step(1000000000.0) : tensor<1x2xf32>
  %expected_output = check.generate.fill value(0.0) : tensor<1x128xf32>
  kernel.launch @sparse_token_attention_serial[%instances](%instances, %cache_rows, %lengths, %query, %indices, %keys, %values, %serial_state, %serial_output) : [index](index, index, tensor<1xi32>, tensor<1x128xf32>, tensor<1024xi32>, tensor<1x128xf32>, tensor<1x128xf32>, tensor<1x2xf32>, tensor<1x128xf32>)
  kernel.launch @sparse_token_attention_pipelined[%instances](%instances, %cache_rows, %lengths, %query, %indices, %keys, %values, %pipeline_state, %pipeline_output) : [index](index, index, tensor<1xi32>, tensor<1x128xf32>, tensor<1024xi32>, tensor<1x128xf32>, tensor<1x128xf32>, tensor<1x2xf32>, tensor<1x128xf32>)
  check.expect.close actual(%serial_state) expected(%expected_state) atol(2.0000000000000002e-05) rtol(2.0000000000000002e-05) nan(same) : tensor<1x2xf32>
  check.expect.close actual(%serial_output) expected(%expected_output) atol(2.0000000000000002e-05) rtol(2.0000000000000002e-05) nan(same) : tensor<1x128xf32>
  check.expect.close actual(%pipeline_state) expected(%expected_state) atol(2.0000000000000002e-05) rtol(2.0000000000000002e-05) nan(same) : tensor<1x2xf32>
  check.expect.close actual(%pipeline_output) expected(%expected_output) atol(2.0000000000000002e-05) rtol(2.0000000000000002e-05) nan(same) : tensor<1x128xf32>
  check.return
}

// Initialize the active row in an otherwise NaN-filled cache for the suffix
// case. This dispatch is fixture setup, outside all timing cases.
kernel.def @sparse_token_attention_initialize_row() {
  %unit = index.constant 1 : index
  %channels = index.constant 128 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%channels, %unit, %unit) : index
} launch(%keys: buffer, %values: buffer) {
  %local_id = kernel.workitem.id<x> : index
  %channel = index.assume %local_id [range(%local_id, 0, 127)] : index
  %base = index.constant 0 : offset
  %key_element = scalar.constant 0.0 : f32
  %value_element = scalar.constant 3.0 : f32
  %key_row = buffer.view %keys[%base] : buffer -> view<128xf32>
  %value_row = buffer.view %values[%base] : buffer -> view<128xf32>
  view.store %key_element, %key_row[%channel] : f32, view<128xf32>
  view.store %value_element, %value_row[%channel] : f32, view<128xf32>
  kernel.return
}

// The ignored suffix alternates valid IDs for a finite row and a poisoned row.
// Both ID bounds pass; only the independent prefix guard prevents NaN leakage.
check.case public @sparse_token_attention_poisoned_suffix {
  %instances = check.literal value(1) : index
  %cache_rows = check.literal value(2) : index
  %lengths = check.generate.fill value(1) : tensor<1xi32>
  %query = check.generate.fill value(0.0) : tensor<1x128xf32>
  %indices = check.generate.iota offset(0) step(1) period(2) : tensor<1024xi32>
  %keys = check.generate.fill value(nan) : tensor<2x128xf32>
  %values = check.generate.fill value(nan) : tensor<2x128xf32>
  kernel.launch @sparse_token_attention_initialize_row(%keys, %values) : (tensor<2x128xf32>, tensor<2x128xf32>)
  %serial_state = check.generate.fill value(-10000.0) : tensor<1x2xf32>
  %serial_output = check.generate.fill value(-20000.0) : tensor<1x128xf32>
  %pipeline_state = check.generate.fill value(-30000.0) : tensor<1x2xf32>
  %pipeline_output = check.generate.fill value(-40000.0) : tensor<1x128xf32>
  %expected_state = check.generate.iota offset(0.0) step(1.0) : tensor<1x2xf32>
  %expected_output = check.generate.fill value(3.0) : tensor<1x128xf32>
  kernel.launch @sparse_token_attention_serial[%instances](%instances, %cache_rows, %lengths, %query, %indices, %keys, %values, %serial_state, %serial_output) : [index](index, index, tensor<1xi32>, tensor<1x128xf32>, tensor<1024xi32>, tensor<2x128xf32>, tensor<2x128xf32>, tensor<1x2xf32>, tensor<1x128xf32>)
  kernel.launch @sparse_token_attention_pipelined[%instances](%instances, %cache_rows, %lengths, %query, %indices, %keys, %values, %pipeline_state, %pipeline_output) : [index](index, index, tensor<1xi32>, tensor<1x128xf32>, tensor<1024xi32>, tensor<2x128xf32>, tensor<2x128xf32>, tensor<1x2xf32>, tensor<1x128xf32>)
  check.expect.close actual(%serial_state) expected(%expected_state) atol(2.0000000000000002e-05) rtol(2.0000000000000002e-05) nan(same) : tensor<1x2xf32>
  check.expect.close actual(%serial_output) expected(%expected_output) atol(2.0000000000000002e-05) rtol(2.0000000000000002e-05) nan(same) : tensor<1x128xf32>
  check.expect.close actual(%pipeline_state) expected(%expected_state) atol(2.0000000000000002e-05) rtol(2.0000000000000002e-05) nan(same) : tensor<1x2xf32>
  check.expect.close actual(%pipeline_output) expected(%expected_output) atol(2.0000000000000002e-05) rtol(2.0000000000000002e-05) nan(same) : tensor<1x128xf32>
  check.return
}

// Each timing case launches one kernel. Zero query makes the denominator equal
// the prefix length; channel-periodic values give an exact independent output.
// Random physical IDs retain the full cache footprint. Separate cases above
// qualify nonzero scores and row identity, including duplicate occurrences.
check.case public @sparse_token_attention_serial_n128 {
  %instances = check.param.choice values([1, 16, 256]) name("instances") : index
  %cache_rows = check.literal value(4096) : index
  %seed = check.literal value(7411) : i64
  %lengths = check.generate.fill value(128) : tensor<[%instances]xi32>
  %query = check.generate.fill value(0.0) : tensor<[%instances]x128xf32>
  %indices = check.generate.random.uniform seed(%seed) range(0 to 4095) : tensor<[%instances]x1024xi32>
  %keys = check.generate.iota offset(-0.5) step(0.00390625) period(257) : tensor<4096x128xf32>
  %values = check.generate.iota offset(-4.0) step(0.0625) period(128) : tensor<4096x128xf32>
  %serial_state = check.generate.fill value(-10000.0) : tensor<[%instances]x2xf32>
  %serial_output = check.generate.fill value(-20000.0) : tensor<[%instances]x128xf32>
  %expected_state = check.generate.iota offset(0.0) step(128.0) period(2) : tensor<[%instances]x2xf32>
  %expected_output = check.generate.iota offset(-4.0) step(0.0625) period(128) : tensor<[%instances]x128xf32>
  kernel.launch @sparse_token_attention_serial[%instances](%instances, %cache_rows, %lengths, %query, %indices, %keys, %values, %serial_state, %serial_output) : [index](index, index, tensor<[%instances]xi32>, tensor<[%instances]x128xf32>, tensor<[%instances]x1024xi32>, tensor<4096x128xf32>, tensor<4096x128xf32>, tensor<[%instances]x2xf32>, tensor<[%instances]x128xf32>)
  check.expect.close actual(%serial_state) expected(%expected_state) atol(2.0000000000000002e-05) rtol(2.0000000000000002e-05) nan(same) : tensor<[%instances]x2xf32>
  check.expect.close actual(%serial_output) expected(%expected_output) atol(2.0000000000000002e-05) rtol(2.0000000000000002e-05) nan(same) : tensor<[%instances]x128xf32>
  check.return
}

check.benchmark<@sparse_token_attention_serial_n128> @sparse_token_attention_serial_n128_i1 {instances = 1}

check.benchmark<@sparse_token_attention_serial_n128> @sparse_token_attention_serial_n128_i16 {instances = 16}

check.benchmark<@sparse_token_attention_serial_n128> @sparse_token_attention_serial_n128_i256 {instances = 256}

