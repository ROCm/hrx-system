// Cooperative sparse attention over an ordered prefix of physical token IDs.
//
// One subgroup owns each 128-channel query. Its selected prefix is in [0, 1024];
// cache_row_count is in [1, 4096]. Negative IDs and IDs at or beyond that bound
// are absent. Duplicate IDs contribute once per occurrence, in list order.
// The caller owns causal selection; physical IDs are not logical positions.
// Buffers are disjoint and four-byte aligned. Only active index entries and
// selected valid K/V rows need backing; ignored suffixes may contain valid IDs
// pointing at NaNs. Active scores are finite and greater than -1e9. Empty or
// all-absent prefixes produce zero denominator/output and maximum -1e9.
//
// The prefix guard owns the ID load; the range guard owns dependent K/V loads.
// A fixed sixteen-entry tile pipelines that read closure into a separate
// subgroup QK reduction and ordered online softmax/PV consumer. Approximate exp
// and contraction model ML-fast arithmetic without reassociation. Target width
// sets the lane fragment; depth/factor are per-caller template arguments.

template.decl @sparse_token_attention(%instance_count: index, %cache_row_count: index, %lengths: buffer, %query: buffer, %indices: buffer, %keys: buffer, %values: buffer, %final_state: buffer, %output: buffer, %depth: index, %factor: index)

template.def<@sparse_token_attention> @sparse_token_attention_impl(%instance_count: index, %cache_row_count: index, %lengths: buffer, %query: buffer, %indices: buffer, %keys: buffer, %values: buffer, %final_state: buffer, %output: buffer, %depth: index, %factor: index) {
  %instance_id = kernel.workgroup.id<x> : index
  %instance, %instances = index.assume %instance_id, %instance_count [range(%instance_count, 1, 256), lt(%instance_id, %instance_count)] : index, index
  %cache_rows = index.assume %cache_row_count [range(%cache_row_count, 1, 4096)] : index
  %cache_limit = index.cast %cache_rows : index to i32
  %lane = kernel.subgroup.lane.id : index
  %width = kernel.subgroup.size : index
  %head_width = index.constant 128 : index
  %fragment_width = index.div %head_width, %width : index
  %channel = index.mul %lane, %fragment_width : index
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %tile_size = index.constant 16 : index
  %base = index.constant 0 : offset
  %absent_id = scalar.constant -1 : i32
  %initial_max = scalar.constant -1000000000.0 : f32
  %identity = scalar.constant 0.0 : f32
  %score_scale = scalar.constant 0.088388347648318447 : f32
  %initial_accumulator = vector.splat %identity : vector<[%fragment_width]xf32>
  %lengths_aligned = buffer.assume.alignment %lengths {minimum_alignment = 4} : buffer
  %query_aligned = buffer.assume.alignment %query {minimum_alignment = 4} : buffer
  %indices_aligned = buffer.assume.alignment %indices {minimum_alignment = 4} : buffer
  %keys_aligned = buffer.assume.alignment %keys {minimum_alignment = 4} : buffer
  %values_aligned = buffer.assume.alignment %values {minimum_alignment = 4} : buffer
  %state_aligned = buffer.assume.alignment %final_state {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %length_storage, %query_storage, %index_storage, %key_storage, %value_storage, %state_storage, %output_storage = buffer.assume.noalias %lengths_aligned, %query_aligned, %indices_aligned, %keys_aligned, %values_aligned, %state_aligned, %output_aligned : buffer, buffer, buffer, buffer, buffer, buffer, buffer
  %length_view = buffer.view %length_storage[%base] : buffer -> view<[%instances]xi32>
  %query_view = buffer.view %query_storage[%base] : buffer -> view<[%instances]x128xf32>
  %index_view = buffer.view %index_storage[%base] : buffer -> view<[%instances]x1024xi32>
  %key_rows = buffer.view %key_storage[%base] : buffer -> view<[%cache_rows]x128xf32>
  %value_rows = buffer.view %value_storage[%base] : buffer -> view<[%cache_rows]x128xf32>
  %state = buffer.view %state_storage[%base] : buffer -> view<[%instances]x2xf32>
  %output_view = buffer.view %output_storage[%base] : buffer -> view<[%instances]x128xf32>
  %length = view.load %length_view[%instance] : view<[%instances]xi32> -> i32
  %length_index = index.cast %length : i32 to index
  %count = index.assume %length_index [range(%length_index, 0, 1024)] : index
  %query_fragment = vector.load %query_view[%instance, %channel] : view<[%instances]x128xf32> -> vector<[%fragment_width]xf32>
  %maximum, %denominator, %numerator = scf.for %tile_begin = [%begin to %count step %tile_size](%tile_max = %initial_max : f32, %tile_sum = %identity : f32, %tile_accumulator = %initial_accumulator : vector<[%fragment_width]xf32>) -> (f32, f32, vector<[%fragment_width]xf32>) {
    %rows_max, %rows_sum, %rows_accumulator = scf.for %slot = [%begin to %tile_size step %step](%row_max = %tile_max : f32, %row_sum = %tile_sum : f32, %row_accumulator = %tile_accumulator : vector<[%fragment_width]xf32>) -> (f32, f32, vector<[%fragment_width]xf32>) pipeline(%depth) unroll(%factor) {
      %selected = index.add %tile_begin, %slot : index
      %active = index.cmp slt, %selected, %count : index
      %row_id = scf.if %active -> (i32) {
        %loaded_id = view.load %index_view[%instance, %selected] : view<[%instances]x1024xi32> -> i32
        scf.yield %loaded_id : i32
      } else {
        scf.yield %absent_id : i32
      }
      %valid = scalar.cmpi ult, %row_id, %cache_limit : i32
      %key, %value = scf.if %valid -> (vector<[%fragment_width]xf32>, vector<[%fragment_width]xf32>) {
        %physical_row = index.cast %row_id : i32 to index
        %loaded_key = vector.load %key_rows[%physical_row, %channel] : view<[%cache_rows]x128xf32> -> vector<[%fragment_width]xf32>
        %loaded_value = vector.load %value_rows[%physical_row, %channel] : view<[%cache_rows]x128xf32> -> vector<[%fragment_width]xf32>
        scf.yield %loaded_key, %loaded_value : vector<[%fragment_width]xf32>, vector<[%fragment_width]xf32>
      } else {
        scf.yield %initial_accumulator, %initial_accumulator : vector<[%fragment_width]xf32>, vector<[%fragment_width]xf32>
      }
      %next_row_max, %next_row_sum, %next_row_accumulator = scf.if %valid -> (f32, f32, vector<[%fragment_width]xf32>) {
        %partial_score = vector.dotf %query_fragment, %key, %identity : vector<[%fragment_width]xf32>, vector<[%fragment_width]xf32>, f32
        %dot = kernel.subgroup.reduce<addf> %partial_score : f32
        %score = scalar.mulf %dot, %score_scale : f32
        %updated_max = scalar.maxnumf %row_max, %score : f32
        %old_delta = scalar.subf %row_max, %updated_max : f32
        %score_delta = scalar.subf %score, %updated_max : f32
        %old_scale = scalar.expf<afn> %old_delta : f32
        %weight = scalar.expf<afn> %score_delta : f32
        %rescaled_sum = scalar.mulf<contract> %row_sum, %old_scale : f32
        %updated_sum = scalar.addf<contract> %rescaled_sum, %weight : f32
        %old_scale_vector = vector.splat %old_scale : vector<[%fragment_width]xf32>
        %weight_vector = vector.splat %weight : vector<[%fragment_width]xf32>
        %rescaled_accumulator = vector.mulf<contract> %row_accumulator, %old_scale_vector : vector<[%fragment_width]xf32>
        %weighted_value = vector.mulf<contract> %value, %weight_vector : vector<[%fragment_width]xf32>
        %updated_accumulator = vector.addf<contract> %rescaled_accumulator, %weighted_value : vector<[%fragment_width]xf32>
        scf.yield %updated_max, %updated_sum, %updated_accumulator : f32, f32, vector<[%fragment_width]xf32>
      } else {
        scf.yield %row_max, %row_sum, %row_accumulator : f32, f32, vector<[%fragment_width]xf32>
      }
      scf.yield %next_row_max, %next_row_sum, %next_row_accumulator : f32, f32, vector<[%fragment_width]xf32>
    }
    scf.yield %rows_max, %rows_sum, %rows_accumulator : f32, f32, vector<[%fragment_width]xf32>
  }
  %nonempty = scalar.cmpf ogt, %denominator, %identity : f32
  %normalized = scf.if %nonempty -> (vector<[%fragment_width]xf32>) {
    %denominators = vector.splat %denominator : vector<[%fragment_width]xf32>
    %result = vector.divf %numerator, %denominators : vector<[%fragment_width]xf32>
    scf.yield %result : vector<[%fragment_width]xf32>
  } else {
    scf.yield %initial_accumulator : vector<[%fragment_width]xf32>
  }
  %leader = index.cmp eq, %lane, %begin : index
  scf.if %leader {
    view.store %maximum, %state[%instance, %begin] : f32, view<[%instances]x2xf32>
    view.store %denominator, %state[%instance, %step] : f32, view<[%instances]x2xf32>
  }
  vector.store %normalized, %output_view[%instance, %channel] : vector<[%fragment_width]xf32>, view<[%instances]x128xf32>
  template.return
}

kernel.def @sparse_token_attention_serial(%instance_count: index) {
  %unit = index.constant 1 : index
  %width = kernel.subgroup.size : index
  kernel.launch.config workgroups(%instance_count, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%instance_count: index, %cache_row_count: index, %lengths: buffer, %query: buffer, %indices: buffer, %keys: buffer, %values: buffer, %final_state: buffer, %output: buffer) {
  %depth = index.constant 1 : index
  %factor = index.constant 2 : index
  template.apply<@sparse_token_attention>(%instance_count, %cache_row_count, %lengths, %query, %indices, %keys, %values, %final_state, %output, %depth, %factor) : (index, index, buffer, buffer, buffer, buffer, buffer, buffer, buffer, index, index)
  kernel.return
}

kernel.def @sparse_token_attention_pipelined(%instance_count: index) {
  %unit = index.constant 1 : index
  %width = kernel.subgroup.size : index
  kernel.launch.config workgroups(%instance_count, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%instance_count: index, %cache_row_count: index, %lengths: buffer, %query: buffer, %indices: buffer, %keys: buffer, %values: buffer, %final_state: buffer, %output: buffer) {
  %depth = index.constant 3 : index
  %factor = index.constant 2 : index
  template.apply<@sparse_token_attention>(%instance_count, %cache_row_count, %lengths, %query, %indices, %keys, %values, %final_state, %output, %depth, %factor) : (index, index, buffer, buffer, buffer, buffer, buffer, buffer, buffer, index, index)
  kernel.return
}

// Distinct queries share periodic index lists with different prefix lengths.
// The 256-query sample crosses every tile/drain boundary from two through 257.
// Repeated, descending, negative and upper-bound IDs distinguish K/V identity.
check.case public @sparse_token_attention_varied {
  %instances = check.param.choice values([1, 16, 256]) name("instances") : index
  %cache_rows = check.literal value(5) : index
  %seed = check.param.seed base(7410) count(4) : i64
  %lengths = check.generate.iota offset(2) step(1) : tensor<[%instances]xi32>
  %query = check.generate.random.uniform seed(%seed) range(-0.5 to 0.5) : tensor<[%instances]x128xf32>
  %indices = check.generate.iota offset(5) step(-1) period(7) : tensor<[%instances]x1024xi32>
  %keys = check.generate.iota offset(-0.5) step(0.00390625) period(257) : tensor<5x128xf32>
  %values = check.generate.iota offset(-3.0) step(0.03125) period(251) : tensor<5x128xf32>
  %serial_state = check.generate.fill value(-10000.0) : tensor<[%instances]x2xf32>
  %serial_output = check.generate.fill value(-20000.0) : tensor<[%instances]x128xf32>
  %pipeline_state = check.generate.fill value(-30000.0) : tensor<[%instances]x2xf32>
  %pipeline_output = check.generate.fill value(-40000.0) : tensor<[%instances]x128xf32>
  kernel.launch @sparse_token_attention_serial[%instances](%instances, %cache_rows, %lengths, %query, %indices, %keys, %values, %serial_state, %serial_output) : [index](index, index, tensor<[%instances]xi32>, tensor<[%instances]x128xf32>, tensor<[%instances]x1024xi32>, tensor<5x128xf32>, tensor<5x128xf32>, tensor<[%instances]x2xf32>, tensor<[%instances]x128xf32>)
  kernel.launch @sparse_token_attention_pipelined[%instances](%instances, %cache_rows, %lengths, %query, %indices, %keys, %values, %pipeline_state, %pipeline_output) : [index](index, index, tensor<[%instances]xi32>, tensor<[%instances]x128xf32>, tensor<[%instances]x1024xi32>, tensor<5x128xf32>, tensor<5x128xf32>, tensor<[%instances]x2xf32>, tensor<[%instances]x128xf32>)
  check.expect.close actual(%pipeline_state) expected(%serial_state) atol(2.0000000000000002e-05) rtol(2.0000000000000002e-05) nan(same) : tensor<[%instances]x2xf32>
  check.expect.close actual(%pipeline_output) expected(%serial_output) atol(2.0000000000000002e-05) rtol(2.0000000000000002e-05) nan(same) : tensor<[%instances]x128xf32>
  check.return
}

// Returns the logical cache bound and exact backing extents for each analytic
// witness. Short allocations keep the prefix and range guards observable.
// Trials are empty, single, ragged, repeated, long prefix, minimal backing,
// absent IDs, and poisoned suffix, in that order.
func.def @sparse_token_attention_analytic_config(%trial: index) -> (index, index, index, index) {
  %cache_rows, %length, %index_count, %backing_rows = scf.switch %trial -> (index, index, index, index) {
    case 0 {
      %cache = index.constant 5 : index
      %count = index.constant 0 : index
      %indices = index.constant 1 : index
      %rows = index.constant 1 : index
      scf.yield %cache, %count, %indices, %rows : index, index, index, index
    }
    case 1 {
      %cache = index.constant 5 : index
      %count = index.constant 1 : index
      %indices = index.constant 1 : index
      %rows = index.constant 5 : index
      scf.yield %cache, %count, %indices, %rows : index, index, index, index
    }
    case 2 {
      %cache = index.constant 5 : index
      %count = index.constant 17 : index
      %indices = index.constant 17 : index
      %rows = index.constant 5 : index
      scf.yield %cache, %count, %indices, %rows : index, index, index, index
    }
    case 3 {
      %cache = index.constant 5 : index
      %count = index.constant 65 : index
      %indices = index.constant 65 : index
      %rows = index.constant 5 : index
      scf.yield %cache, %count, %indices, %rows : index, index, index, index
    }
    case 4 {
      %cache = index.constant 5 : index
      %count = index.constant 1023 : index
      %indices = index.constant 1023 : index
      %rows = index.constant 5 : index
      scf.yield %cache, %count, %indices, %rows : index, index, index, index
    }
    case 5 {
      %cache = index.constant 4096 : index
      %count = index.constant 17 : index
      %indices = index.constant 17 : index
      %rows = index.constant 17 : index
      scf.yield %cache, %count, %indices, %rows : index, index, index, index
    }
    case 6 {
      %cache = index.constant 5 : index
      %count = index.constant 1024 : index
      %indices = index.constant 1024 : index
      %rows = index.constant 1 : index
      scf.yield %cache, %count, %indices, %rows : index, index, index, index
    }
    default {
      %cache = index.constant 2 : index
      %count = index.constant 1 : index
      %indices = index.constant 1024 : index
      %rows = index.constant 2 : index
      scf.yield %cache, %count, %indices, %rows : index, index, index, index
    }
  }
  func.return %cache_rows, %length, %index_count, %backing_rows : index, index, index, index
}

// Populates the eight analytic witnesses at runtime so none of their values
// specialize the target products. Trial six exercises signed-ID rejection;
// trial seven leaves the inactive cache row poisoned with NaNs.
func.def @sparse_token_attention_analytic_inputs(%trial: index, %length: index, %index_count: index, %backing_rows: index, %lengths_buffer: buffer, %query_buffer: buffer, %indices_buffer: buffer, %keys_buffer: buffer, %values_buffer: buffer) {
  %bounded_index_count = index.assume %index_count [range(%index_count, 1, 1024)] : index
  %bounded_backing_rows = index.assume %backing_rows [range(%backing_rows, 1, 17)] : index
  %base = index.constant 0 : offset
  %lengths = buffer.view %lengths_buffer[%base] : buffer -> view<1xi32>
  %query = buffer.view %query_buffer[%base] : buffer -> view<128xf32>
  %indices = buffer.view %indices_buffer[%base] : buffer -> view<[%bounded_index_count]xi32>
  %keys = buffer.view %keys_buffer[%base] : buffer -> view<[%bounded_backing_rows]x128xf32>
  %values = buffer.view %values_buffer[%base] : buffer -> view<[%bounded_backing_rows]x128xf32>
  %begin = index.constant 0 : index
  %channel_end = index.constant 128 : index
  %step = index.constant 1 : index
  %length_i32 = index.cast %length : index to i32
  view.store %length_i32, %lengths[%begin] : i32, view<1xi32>

  %query_value = scf.switch %trial -> (f32) {
    case 1 {
      %value = scalar.constant 1.0 : f32
      scf.yield %value : f32
    }
    case 2 {
      %value = scalar.constant -1.0 : f32
      scf.yield %value : f32
    }
    case 3 {
      %value = scalar.constant 16.0 : f32
      scf.yield %value : f32
    }
    case 4 {
      %value = scalar.constant 1.0 : f32
      scf.yield %value : f32
    }
    case 5 {
      %value = scalar.constant 1.0 : f32
      scf.yield %value : f32
    }
    default {
      %value = scalar.constant 0.0 : f32
      scf.yield %value : f32
    }
  }
  scf.for %channel = [%begin to %channel_end step %step] {
    view.store %query_value, %query[%channel] : f32, view<128xf32>
  }

  %offset, %delta, %period = scf.switch %trial -> (i32, i32, index) {
    case 5 {
      %offset_value = scalar.constant 16 : i32
      %delta_value = scalar.constant -1 : i32
      %period_value = index.constant 17 : index
      scf.yield %offset_value, %delta_value, %period_value : i32, i32, index
    }
    case 6 {
      %offset_value = scalar.constant 0 : i32
      %delta_value = scalar.constant 0 : i32
      %period_value = index.constant 3 : index
      scf.yield %offset_value, %delta_value, %period_value : i32, i32, index
    }
    case 7 {
      %offset_value = scalar.constant 0 : i32
      %delta_value = scalar.constant 1 : i32
      %period_value = index.constant 2 : index
      scf.yield %offset_value, %delta_value, %period_value : i32, i32, index
    }
    default {
      %offset_value = scalar.constant 4 : i32
      %delta_value = scalar.constant -1 : i32
      %period_value = index.constant 7 : index
      scf.yield %offset_value, %delta_value, %period_value : i32, i32, index
    }
  }
  %absent_trial = index.constant 6 : index
  %is_absent = index.cmp eq, %trial, %absent_trial : index
  scf.for %position = [%begin to %bounded_index_count step %step] {
    %phase = index.rem %position, %period : index
    %phase_i32 = index.cast %phase : index to i32
    %scaled = scalar.muli %phase_i32, %delta : i32
    %regular_id = scalar.addi %offset, %scaled : i32
    %row_id = scf.if %is_absent -> (i32) {
      %absent_id = scf.switch %phase -> (i32) {
        case 0 {
          %value = scalar.constant -2147483648 : i32
          scf.yield %value : i32
        }
        case 1 {
          %value = scalar.constant -1 : i32
          scf.yield %value : i32
        }
        default {
          %value = scalar.constant 2147483646 : i32
          scf.yield %value : i32
        }
      }
      scf.yield %absent_id : i32
    } else {
      scf.yield %regular_id : i32
    }
    view.store %row_id, %indices[%position] : i32, view<[%bounded_index_count]xi32>
  }

  %regular_end = index.constant 6 : index
  %has_regular_payload = index.cmp ult, %trial, %regular_end : index
  scf.if %has_regular_payload {
    %key_step = scalar.constant 3.0517578125e-05 : f32
    %value_base = scalar.constant -1.15625 : f32
    %value_step = scalar.constant 0.03125 : f32
    scf.for %row = [%begin to %bounded_backing_rows step %step] {
      %row_base = index.mul %row, %channel_end : index
      scf.for %channel = [%begin to %channel_end step %step] {
        %linear = index.add %row_base, %channel : index
        %linear_i32 = index.cast %linear : index to i32
        %linear_f32 = scalar.sitofp %linear_i32 : i32 to f32
        %key = scalar.mulf %linear_f32, %key_step : f32
        %value_offset = scalar.mulf %linear_f32, %value_step : f32
        %value = scalar.addf %value_base, %value_offset : f32
        view.store %key, %keys[%row, %channel] : f32, view<[%bounded_backing_rows]x128xf32>
        view.store %value, %values[%row, %channel] : f32, view<[%bounded_backing_rows]x128xf32>
      }
    }
  }
  %poison_trial = index.constant 7 : index
  %has_poisoned_suffix = index.cmp eq, %trial, %poison_trial : index
  scf.if %has_poisoned_suffix {
    %key = scalar.constant 0.0 : f32
    %value = scalar.constant 3.0 : f32
    scf.for %channel = [%begin to %channel_end step %step] {
      view.store %key, %keys[%begin, %channel] : f32, view<[%bounded_backing_rows]x128xf32>
      view.store %value, %values[%begin, %channel] : f32, view<[%bounded_backing_rows]x128xf32>
    }
  }
  func.return
}

// Precomputed normalized exponential sums independently anchor the online
// recurrence. Q(c)=q, K(row,c)=(128*row+c)/32768, and
// V(row,c)=4*row-37/32+c/32 for the finite-payload trials.
func.def @sparse_token_attention_analytic_oracle(%instance_count: index, %cache_row_count: index, %lengths_buffer: buffer, %query_buffer: buffer, %indices_buffer: buffer, %keys_buffer: buffer, %values_buffer: buffer, %final_state: buffer, %output_buffer: buffer) {
  %base = index.constant 0 : offset
  %lengths = buffer.view %lengths_buffer[%base] : buffer -> view<1xi32>
  %state = buffer.view %final_state[%base] : buffer -> view<1x2xf32>
  %output = buffer.view %output_buffer[%base] : buffer -> view<1x128xf32>
  %begin = index.constant 0 : index
  %count_i32 = view.load %lengths[%begin] : view<1xi32> -> i32
  %count = index.cast %count_i32 : i32 to index
  %maximum, %denominator, %output_base, %channel_step = scf.switch %count -> (f32, f32, f32, f32) {
    case 0 {
      %max_value = scalar.constant -1000000000.0 : f32
      %sum_value = scalar.constant 0.0 : f32
      %base_value = scalar.constant 0.0 : f32
      %step_value = scalar.constant 0.0 : f32
      scf.yield %max_value, %sum_value, %base_value, %step_value : f32, f32, f32, f32
    }
    case 1 {
      %poison_cache_rows = index.constant 2 : index
      %poisoned = index.cmp eq, %cache_row_count, %poison_cache_rows : index
      %max_value, %sum_value, %base_value, %step_value = scf.if %poisoned -> (f32, f32, f32, f32) {
        %poison_max = scalar.constant 0.0 : f32
        %poison_sum = scalar.constant 1.0 : f32
        %poison_base = scalar.constant 3.0 : f32
        %poison_step = scalar.constant 0.0 : f32
        scf.yield %poison_max, %poison_sum, %poison_base, %poison_step : f32, f32, f32, f32
      } else {
        %single_max = scalar.constant 0.19870114531659056 : f32
        %single_sum = scalar.constant 1.0 : f32
        %single_base = scalar.constant 14.84375 : f32
        %single_step = scalar.constant 0.03125 : f32
        scf.yield %single_max, %single_sum, %single_base, %single_step : f32, f32, f32, f32
      }
      scf.yield %max_value, %sum_value, %base_value, %step_value : f32, f32, f32, f32
    }
    case 17 {
      %minimal_cache_rows = index.constant 4096 : index
      %minimal = index.cmp eq, %cache_row_count, %minimal_cache_rows : index
      %max_value, %sum_value, %base_value = scf.if %minimal -> (f32, f32, f32) {
        %minimal_max = scalar.constant 0.72903122213028837 : f32
        %minimal_sum = scalar.constant 12.218947409141103 : f32
        %minimal_base = scalar.constant 35.046870423420522 : f32
        scf.yield %minimal_max, %minimal_sum, %minimal_base : f32, f32, f32
      } else {
        %ragged_max = scalar.constant -0.02192445304535795 : f32
        %ragged_sum = scalar.constant 11.801144901535077 : f32
        %ragged_base = scalar.constant 7.434118814684151 : f32
        scf.yield %ragged_max, %ragged_sum, %ragged_base : f32, f32, f32
      }
      %step_value = scalar.constant 0.03125 : f32
      scf.yield %max_value, %sum_value, %base_value, %step_value : f32, f32, f32, f32
    }
    case 65 {
      %max_value = scalar.constant 3.1792183250654489 : f32
      %sum_value = scalar.constant 18.729548671396707 : f32
      %base_value = scalar.constant 11.710482155421582 : f32
      %step_value = scalar.constant 0.03125 : f32
      scf.yield %max_value, %sum_value, %base_value, %step_value : f32, f32, f32, f32
    }
    case 1023 {
      %max_value = scalar.constant 0.19870114531659056 : f32
      %sum_value = scalar.constant 670.55176903492077 : f32
      %base_value = scalar.constant 7.2084081628205467 : f32
      %step_value = scalar.constant 0.03125 : f32
      scf.yield %max_value, %sum_value, %base_value, %step_value : f32, f32, f32, f32
    }
    default {
      %max_value = scalar.constant -1000000000.0 : f32
      %sum_value = scalar.constant 0.0 : f32
      %base_value = scalar.constant 0.0 : f32
      %step_value = scalar.constant 0.0 : f32
      scf.yield %max_value, %sum_value, %base_value, %step_value : f32, f32, f32, f32
    }
  }
  %step = index.constant 1 : index
  %channel_end = index.constant 128 : index
  view.store %maximum, %state[%begin, %begin] : f32, view<1x2xf32>
  view.store %denominator, %state[%begin, %step] : f32, view<1x2xf32>
  scf.for %channel = [%begin to %channel_end step %step] {
    %channel_i32 = index.cast %channel : index to i32
    %channel_f32 = scalar.sitofp %channel_i32 : i32 to f32
    %offset = scalar.mulf %channel_f32, %channel_step : f32
    %value = scalar.addf %output_base, %offset : f32
    view.store %value, %output[%begin, %channel] : f32, view<1x128xf32>
  }
  func.return
}

// Both target policies share one prepared product across all boundary, exact
// backing, repeated-ID, absent-ID, and poisoned-suffix trials.
check.scenario @sparse_token_attention_analytic {
  check.trial[8](%trial: index, %entropy: check.entropy) {
    %instances = check.literal value(1) : index
    %cache_rows, %length, %index_count, %backing_rows = check.generate<@sparse_token_attention_analytic_config>(%trial) : (index) -> (index, index, index, index)
    %lengths = check.generate.fill value(0) : tensor<1xi32>
    %query = check.generate.fill value(0.0) : tensor<1x128xf32>
    %indices = check.generate.fill value(0) : tensor<[%index_count]xi32>
    %keys = check.generate.fill value(nan) : tensor<[%backing_rows]x128xf32>
    %values = check.generate.fill value(nan) : tensor<[%backing_rows]x128xf32>
    check.generate<@sparse_token_attention_analytic_inputs>(%trial, %length, %index_count, %backing_rows, %lengths, %query, %indices, %keys, %values) : (index, index, index, index, tensor<1xi32>, tensor<1x128xf32>, tensor<[%index_count]xi32>, tensor<[%backing_rows]x128xf32>, tensor<[%backing_rows]x128xf32>) -> ()
    %state = check.generate.fill value(-10000.0) : tensor<1x2xf32>
    %output = check.generate.fill value(-20000.0) : tensor<1x128xf32>
    check.compare<@sparse_token_attention_serial, @sparse_token_attention_analytic_oracle>[%instances](%instances, %cache_rows, %lengths, %query, %indices, %keys, %values, %state, %output) : [index](index, index, tensor<1xi32>, tensor<1x128xf32>, tensor<[%index_count]xi32>, tensor<[%backing_rows]x128xf32>, tensor<[%backing_rows]x128xf32>, tensor<1x2xf32>, tensor<1x128xf32>) -> () {
      check.expect.close actual(%state) expected(%state) atol(2.0000000000000002e-05) rtol(2.0000000000000002e-05) nan(same) : tensor<1x2xf32>
      check.expect.close actual(%output) expected(%output) atol(2.0000000000000002e-05) rtol(2.0000000000000002e-05) nan(same) : tensor<1x128xf32>
    }
  }
  check.trial[8](%trial: index, %entropy: check.entropy) {
    %instances = check.literal value(1) : index
    %cache_rows, %length, %index_count, %backing_rows = check.generate<@sparse_token_attention_analytic_config>(%trial) : (index) -> (index, index, index, index)
    %lengths = check.generate.fill value(0) : tensor<1xi32>
    %query = check.generate.fill value(0.0) : tensor<1x128xf32>
    %indices = check.generate.fill value(0) : tensor<[%index_count]xi32>
    %keys = check.generate.fill value(nan) : tensor<[%backing_rows]x128xf32>
    %values = check.generate.fill value(nan) : tensor<[%backing_rows]x128xf32>
    check.generate<@sparse_token_attention_analytic_inputs>(%trial, %length, %index_count, %backing_rows, %lengths, %query, %indices, %keys, %values) : (index, index, index, index, tensor<1xi32>, tensor<1x128xf32>, tensor<[%index_count]xi32>, tensor<[%backing_rows]x128xf32>, tensor<[%backing_rows]x128xf32>) -> ()
    %state = check.generate.fill value(-30000.0) : tensor<1x2xf32>
    %output = check.generate.fill value(-40000.0) : tensor<1x128xf32>
    check.compare<@sparse_token_attention_pipelined, @sparse_token_attention_analytic_oracle>[%instances](%instances, %cache_rows, %lengths, %query, %indices, %keys, %values, %state, %output) : [index](index, index, tensor<1xi32>, tensor<1x128xf32>, tensor<[%index_count]xi32>, tensor<[%backing_rows]x128xf32>, tensor<[%backing_rows]x128xf32>, tensor<1x2xf32>, tensor<1x128xf32>) -> () {
      check.expect.close actual(%state) expected(%state) atol(2.0000000000000002e-05) rtol(2.0000000000000002e-05) nan(same) : tensor<1x2xf32>
      check.expect.close actual(%output) expected(%output) atol(2.0000000000000002e-05) rtol(2.0000000000000002e-05) nan(same) : tensor<1x128xf32>
    }
  }
  check.return
}
