// Two distinct 128-channel query heads share a paged K/V sequence.
//
// A pair owns one 64-entry page table. Each query has its own length, Q fragment,
// online maximum/denominator/PV state and normalized output. The shared form
// loads each K/V row once for both heads, traversing the union of their prefixes.
// Per-head consumer guards preserve unequal tails and either head being empty.
// All subgroup reductions participate in the fixed 16-row loop.
//
// Pair counts are in [1, 1024], lengths in [0, 1024], and page IDs are -1
// (absent) or [0, 4095]. Buffers are disjoint and four-byte aligned; only active
// table entries and K/V rows need backing. Active scores are finite and greater
// than -1e9. Empty heads produce max=-1e9, denominator=0 and output=0.
// Approximate exp and contraction preserve ordered ML-fast recurrence semantics.
//
// The independent and shared callers use depth two and unroll two. A shared
// serial control isolates pipelining. Reuse trades fewer loads for more state
// per subgroup and fewer runnable subgroups; the caller chooses the policy.

// One ordered online-softmax/PV update. Each query owns a separate state tuple.
template.decl @grouped_attention_advance(%fragment_width: index, %score: f32, %value: vector<[%fragment_width]xf32>, %row_max: f32, %row_sum: f32, %row_accumulator: vector<[%fragment_width]xf32>) -> (f32, f32, vector<[%fragment_width]xf32>)

template.def<@grouped_attention_advance> @grouped_attention_advance_impl(%fragment_width: index, %score: f32, %value: vector<[%fragment_width]xf32>, %row_max: f32, %row_sum: f32, %row_accumulator: vector<[%fragment_width]xf32>) -> (f32, f32, vector<[%fragment_width]xf32>) {
  %updated_max = scalar.maxnumf %row_max, %score : f32
  %old_delta = scalar.subf %row_max, %updated_max : f32
  %score_delta = scalar.subf %score, %updated_max : f32
  %old_scale = scalar.expf<afn> %old_delta : f32
  %weight = scalar.expf<afn> %score_delta : f32
  %rescaled_sum = scalar.mulf<contract> %row_sum, %old_scale : f32
  %updated_sum = scalar.addf<contract> %rescaled_sum, %weight : f32
  %old_scale_vector = vector.splat %old_scale : vector<[%fragment_width]xf32>
  %weight_vector = vector.splat %weight : vector<[%fragment_width]xf32>
  %rescaled_accumulator = vector.mulf<contract> %row_accumulator, %old_scale_vector : vector<[%fragment_width]xf32>
  %weighted_value = vector.mulf<contract> %value, %weight_vector : vector<[%fragment_width]xf32>
  %updated_accumulator = vector.addf<contract> %rescaled_accumulator, %weighted_value : vector<[%fragment_width]xf32>
  template.return %updated_max, %updated_sum, %updated_accumulator : f32, f32, vector<[%fragment_width]xf32>
}

template.decl @independent_paged_attention(%pair_count: index, %lengths: buffer, %query: buffer, %page_table: buffer, %keys: buffer, %values: buffer, %final_state: buffer, %output: buffer, %depth: index, %factor: index)

template.def<@independent_paged_attention> @independent_paged_attention_impl(%pair_count: index, %lengths: buffer, %query: buffer, %page_table: buffer, %keys: buffer, %values: buffer, %final_state: buffer, %output: buffer, %depth: index, %factor: index) {
  %heads_per_pair = index.constant 2 : index
  %pairs = index.assume %pair_count [range(%pair_count, 1, 1024)] : index
  %instance_count = index.mul %pairs, %heads_per_pair : index
  %pair_id = kernel.workgroup.id<y> : index
  %pair = index.assume %pair_id [lt(%pair_id, %pairs)] : index
  %head = kernel.workgroup.id<x> : index
  %first_head = index.mul %pair, %heads_per_pair : index
  %instance_id = index.add %first_head, %head : index
  %instance, %instances = index.assume %instance_id, %instance_count [range(%instance_count, 1, 2048), lt(%instance_id, %instance_count)] : index, index
  %lane = kernel.subgroup.lane.id : index
  %width = kernel.subgroup.size : index
  %head_width = index.constant 128 : index
  %fragment_width = index.div %head_width, %width : index
  %channel = index.mul %lane, %fragment_width : index
  %begin = index.constant 0 : index
  %row_step = index.constant 1 : index
  %page_rows = index.constant 16 : index
  %base = index.constant 0 : offset
  %first_page_id = scalar.constant 0 : i32
  %initial_max = scalar.constant -1000000000.0 : f32
  %identity = scalar.constant 0.0 : f32
  %score_scale = scalar.constant 0.088388347648318447 : f32
  %initial_accumulator = vector.splat %identity : vector<[%fragment_width]xf32>
  %lengths_aligned = buffer.assume.alignment %lengths {minimum_alignment = 4} : buffer
  %query_aligned = buffer.assume.alignment %query {minimum_alignment = 4} : buffer
  %table_aligned = buffer.assume.alignment %page_table {minimum_alignment = 4} : buffer
  %keys_aligned = buffer.assume.alignment %keys {minimum_alignment = 4} : buffer
  %values_aligned = buffer.assume.alignment %values {minimum_alignment = 4} : buffer
  %state_aligned = buffer.assume.alignment %final_state {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %length_storage, %query_storage, %table_storage, %key_storage, %value_storage, %state_storage, %output_storage = buffer.assume.noalias %lengths_aligned, %query_aligned, %table_aligned, %keys_aligned, %values_aligned, %state_aligned, %output_aligned : buffer, buffer, buffer, buffer, buffer, buffer, buffer
  %length_view = buffer.view %length_storage[%base] : buffer -> view<[%instances]xi32>
  %query_view = buffer.view %query_storage[%base] : buffer -> view<[%instances]x128xf32>
  %table = buffer.view %table_storage[%base] : buffer -> view<[%pairs]x64xi32>
  %key_rows = buffer.view %key_storage[%base] : buffer -> view<65536x128xf32>
  %value_rows = buffer.view %value_storage[%base] : buffer -> view<65536x128xf32>
  %state = buffer.view %state_storage[%base] : buffer -> view<[%instances]x2xf32>
  %output_view = buffer.view %output_storage[%base] : buffer -> view<[%instances]x128xf32>
  %length = view.load %length_view[%instance] : view<[%instances]xi32> -> i32
  %length_index = index.cast %length : i32 to index
  %count = index.assume %length_index [range(%length_index, 0, 1024)] : index
  %query_fragment = vector.load %query_view[%instance, %channel] : view<[%instances]x128xf32> -> vector<[%fragment_width]xf32>
  %maximum, %denominator, %numerator = scf.for %page_begin = [%begin to %count step %page_rows](%page_max = %initial_max : f32, %page_sum = %identity : f32, %page_accumulator = %initial_accumulator : vector<[%fragment_width]xf32>) -> (f32, f32, vector<[%fragment_width]xf32>) {
    %logical_page = index.div %page_begin, %page_rows : index
    %page_id = view.load %table[%pair, %logical_page] : view<[%pairs]x64xi32> -> i32
    %present = scalar.cmpi sge, %page_id, %first_page_id : i32
    %next_page_max, %next_page_sum, %next_page_accumulator = scf.if %present -> (f32, f32, vector<[%fragment_width]xf32>) {
      %page_index = index.cast %page_id : i32 to index
      %page = index.assume %page_index [range(%page_index, 0, 4095)] : index
      %page_row = index.mul %page, %page_rows : index
      %rows_max, %rows_sum, %rows_accumulator = scf.for %row = [%begin to %page_rows step %row_step](%row_max = %page_max : f32, %row_sum = %page_sum : f32, %row_accumulator = %page_accumulator : vector<[%fragment_width]xf32>) -> (f32, f32, vector<[%fragment_width]xf32>) pipeline(%depth) unroll(%factor) {
        %token = index.add %page_begin, %row : index
        %valid = index.cmp slt, %token, %count : index
        %key, %value = scf.if %valid -> (vector<[%fragment_width]xf32>, vector<[%fragment_width]xf32>) {
          %physical_row = index.add %page_row, %row : index
          %loaded_key = vector.load %key_rows[%physical_row, %channel] : view<65536x128xf32> -> vector<[%fragment_width]xf32>
          %loaded_value = vector.load %value_rows[%physical_row, %channel] : view<65536x128xf32> -> vector<[%fragment_width]xf32>
          scf.yield %loaded_key, %loaded_value : vector<[%fragment_width]xf32>, vector<[%fragment_width]xf32>
        } else {
          scf.yield %initial_accumulator, %initial_accumulator : vector<[%fragment_width]xf32>, vector<[%fragment_width]xf32>
        }
        %next_row_max, %next_row_sum, %next_row_accumulator = scf.if %valid -> (f32, f32, vector<[%fragment_width]xf32>) {
          %partial_score = vector.dotf %query_fragment, %key, %identity : vector<[%fragment_width]xf32>, vector<[%fragment_width]xf32>, f32
          %dot = kernel.subgroup.reduce<addf> %partial_score : f32
          %score = scalar.mulf %dot, %score_scale : f32
          %updated_max, %updated_sum, %updated_accumulator = template.apply<@grouped_attention_advance>(%fragment_width, %score, %value, %row_max, %row_sum, %row_accumulator) : (index, f32, vector<[%fragment_width]xf32>, f32, f32, vector<[%fragment_width]xf32>) -> (f32, f32, vector<[%fragment_width]xf32>)
          scf.yield %updated_max, %updated_sum, %updated_accumulator : f32, f32, vector<[%fragment_width]xf32>
        } else {
          scf.yield %row_max, %row_sum, %row_accumulator : f32, f32, vector<[%fragment_width]xf32>
        }
        scf.yield %next_row_max, %next_row_sum, %next_row_accumulator : f32, f32, vector<[%fragment_width]xf32>
      }
      scf.yield %rows_max, %rows_sum, %rows_accumulator : f32, f32, vector<[%fragment_width]xf32>
    } else {
      scf.yield %page_max, %page_sum, %page_accumulator : f32, f32, vector<[%fragment_width]xf32>
    }
    scf.yield %next_page_max, %next_page_sum, %next_page_accumulator : f32, f32, vector<[%fragment_width]xf32>
  }
  %nonempty = scalar.cmpf ogt, %denominator, %identity : f32
  %normalized = scf.if %nonempty -> (vector<[%fragment_width]xf32>) {
    %denominators = vector.splat %denominator : vector<[%fragment_width]xf32>
    %result = vector.divf %numerator, %denominators : vector<[%fragment_width]xf32>
    scf.yield %result : vector<[%fragment_width]xf32>
  } else {
    scf.yield %initial_accumulator : vector<[%fragment_width]xf32>
  }
  %leader = index.cmp eq, %lane, %begin : index
  scf.if %leader {
    view.store %maximum, %state[%instance, %begin] : f32, view<[%instances]x2xf32>
    view.store %denominator, %state[%instance, %row_step] : f32, view<[%instances]x2xf32>
  }
  vector.store %normalized, %output_view[%instance, %channel] : vector<[%fragment_width]xf32>, view<[%instances]x128xf32>
  template.return
}

template.decl @grouped_paged_attention(%pair_count: index, %lengths: buffer, %query: buffer, %page_table: buffer, %keys: buffer, %values: buffer, %final_state: buffer, %output: buffer, %depth: index, %factor: index)

template.def<@grouped_paged_attention> @grouped_paged_attention_impl(%pair_count: index, %lengths: buffer, %query: buffer, %page_table: buffer, %keys: buffer, %values: buffer, %final_state: buffer, %output: buffer, %depth: index, %factor: index) {
  %heads_per_pair = index.constant 2 : index
  %pairs = index.assume %pair_count [range(%pair_count, 1, 1024)] : index
  %pair_id = kernel.workgroup.id<y> : index
  %pair = index.assume %pair_id [lt(%pair_id, %pairs)] : index
  %instances = index.mul %pairs, %heads_per_pair : index
  %first_head = index.mul %pair, %heads_per_pair : index
  %head_step = index.constant 1 : index
  %second_head = index.add %first_head, %head_step : index
  %lane = kernel.subgroup.lane.id : index
  %width = kernel.subgroup.size : index
  %head_width = index.constant 128 : index
  %fragment_width = index.div %head_width, %width : index
  %channel = index.mul %lane, %fragment_width : index
  %begin = index.constant 0 : index
  %row_step = index.constant 1 : index
  %page_rows = index.constant 16 : index
  %base = index.constant 0 : offset
  %first_page_id = scalar.constant 0 : i32
  %initial_max = scalar.constant -1000000000.0 : f32
  %identity = scalar.constant 0.0 : f32
  %score_scale = scalar.constant 0.088388347648318447 : f32
  %initial_accumulator = vector.splat %identity : vector<[%fragment_width]xf32>
  %lengths_aligned = buffer.assume.alignment %lengths {minimum_alignment = 4} : buffer
  %query_aligned = buffer.assume.alignment %query {minimum_alignment = 4} : buffer
  %table_aligned = buffer.assume.alignment %page_table {minimum_alignment = 4} : buffer
  %keys_aligned = buffer.assume.alignment %keys {minimum_alignment = 4} : buffer
  %values_aligned = buffer.assume.alignment %values {minimum_alignment = 4} : buffer
  %state_aligned = buffer.assume.alignment %final_state {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %length_storage, %query_storage, %table_storage, %key_storage, %value_storage, %state_storage, %output_storage = buffer.assume.noalias %lengths_aligned, %query_aligned, %table_aligned, %keys_aligned, %values_aligned, %state_aligned, %output_aligned : buffer, buffer, buffer, buffer, buffer, buffer, buffer
  %length_view = buffer.view %length_storage[%base] : buffer -> view<[%instances]xi32>
  %query_view = buffer.view %query_storage[%base] : buffer -> view<[%instances]x128xf32>
  %table = buffer.view %table_storage[%base] : buffer -> view<[%pairs]x64xi32>
  %key_rows = buffer.view %key_storage[%base] : buffer -> view<65536x128xf32>
  %value_rows = buffer.view %value_storage[%base] : buffer -> view<65536x128xf32>
  %state = buffer.view %state_storage[%base] : buffer -> view<[%instances]x2xf32>
  %output_view = buffer.view %output_storage[%base] : buffer -> view<[%instances]x128xf32>
  %first_length = view.load %length_view[%first_head] : view<[%instances]xi32> -> i32
  %first_length_index = index.cast %first_length : i32 to index
  %first_count = index.assume %first_length_index [range(%first_length_index, 0, 1024)] : index
  %first_query_fragment = vector.load %query_view[%first_head, %channel] : view<[%instances]x128xf32> -> vector<[%fragment_width]xf32>
  %second_length = view.load %length_view[%second_head] : view<[%instances]xi32> -> i32
  %second_length_index = index.cast %second_length : i32 to index
  %second_count = index.assume %second_length_index [range(%second_length_index, 0, 1024)] : index
  %second_query_fragment = vector.load %query_view[%second_head, %channel] : view<[%instances]x128xf32> -> vector<[%fragment_width]xf32>
  %count = index.max %first_count, %second_count : index
  %first_final_max, %first_final_sum, %first_final_accumulator, %second_final_max, %second_final_sum, %second_final_accumulator = scf.for %page_begin = [%begin to %count step %page_rows](%first_page_max = %initial_max : f32, %first_page_sum = %identity : f32, %first_page_accumulator = %initial_accumulator : vector<[%fragment_width]xf32>, %second_page_max = %initial_max : f32, %second_page_sum = %identity : f32, %second_page_accumulator = %initial_accumulator : vector<[%fragment_width]xf32>) -> (f32, f32, vector<[%fragment_width]xf32>, f32, f32, vector<[%fragment_width]xf32>) {
    %logical_page = index.div %page_begin, %page_rows : index
    %page_id = view.load %table[%pair, %logical_page] : view<[%pairs]x64xi32> -> i32
    %present = scalar.cmpi sge, %page_id, %first_page_id : i32
    %first_next_page_max, %first_next_page_sum, %first_next_page_accumulator, %second_next_page_max, %second_next_page_sum, %second_next_page_accumulator = scf.if %present -> (f32, f32, vector<[%fragment_width]xf32>, f32, f32, vector<[%fragment_width]xf32>) {
      %page_index = index.cast %page_id : i32 to index
      %page = index.assume %page_index [range(%page_index, 0, 4095)] : index
      %page_row = index.mul %page, %page_rows : index
      %first_rows_max, %first_rows_sum, %first_rows_accumulator, %second_rows_max, %second_rows_sum, %second_rows_accumulator = scf.for %row = [%begin to %page_rows step %row_step](%first_row_max = %first_page_max : f32, %first_row_sum = %first_page_sum : f32, %first_row_accumulator = %first_page_accumulator : vector<[%fragment_width]xf32>, %second_row_max = %second_page_max : f32, %second_row_sum = %second_page_sum : f32, %second_row_accumulator = %second_page_accumulator : vector<[%fragment_width]xf32>) -> (f32, f32, vector<[%fragment_width]xf32>, f32, f32, vector<[%fragment_width]xf32>) pipeline(%depth) unroll(%factor) {
        %token = index.add %page_begin, %row : index
        %valid = index.cmp slt, %token, %count : index
        %key, %value = scf.if %valid -> (vector<[%fragment_width]xf32>, vector<[%fragment_width]xf32>) {
          %physical_row = index.add %page_row, %row : index
          %loaded_key = vector.load %key_rows[%physical_row, %channel] : view<65536x128xf32> -> vector<[%fragment_width]xf32>
          %loaded_value = vector.load %value_rows[%physical_row, %channel] : view<65536x128xf32> -> vector<[%fragment_width]xf32>
          scf.yield %loaded_key, %loaded_value : vector<[%fragment_width]xf32>, vector<[%fragment_width]xf32>
        } else {
          scf.yield %initial_accumulator, %initial_accumulator : vector<[%fragment_width]xf32>, vector<[%fragment_width]xf32>
        }
        %first_partial_score = vector.dotf %first_query_fragment, %key, %identity : vector<[%fragment_width]xf32>, vector<[%fragment_width]xf32>, f32
        %first_dot = kernel.subgroup.reduce<addf> %first_partial_score : f32
        %first_score = scalar.mulf %first_dot, %score_scale : f32
        %second_partial_score = vector.dotf %second_query_fragment, %key, %identity : vector<[%fragment_width]xf32>, vector<[%fragment_width]xf32>, f32
        %second_dot = kernel.subgroup.reduce<addf> %second_partial_score : f32
        %second_score = scalar.mulf %second_dot, %score_scale : f32
        %first_valid = index.cmp slt, %token, %first_count : index
        %first_next_row_max, %first_next_row_sum, %first_next_row_accumulator = scf.if %first_valid -> (f32, f32, vector<[%fragment_width]xf32>) {
          %first_updated_max, %first_updated_sum, %first_updated_accumulator = template.apply<@grouped_attention_advance>(%fragment_width, %first_score, %value, %first_row_max, %first_row_sum, %first_row_accumulator) : (index, f32, vector<[%fragment_width]xf32>, f32, f32, vector<[%fragment_width]xf32>) -> (f32, f32, vector<[%fragment_width]xf32>)
          scf.yield %first_updated_max, %first_updated_sum, %first_updated_accumulator : f32, f32, vector<[%fragment_width]xf32>
        } else {
          scf.yield %first_row_max, %first_row_sum, %first_row_accumulator : f32, f32, vector<[%fragment_width]xf32>
        }
        %second_valid = index.cmp slt, %token, %second_count : index
        %second_next_row_max, %second_next_row_sum, %second_next_row_accumulator = scf.if %second_valid -> (f32, f32, vector<[%fragment_width]xf32>) {
          %second_updated_max, %second_updated_sum, %second_updated_accumulator = template.apply<@grouped_attention_advance>(%fragment_width, %second_score, %value, %second_row_max, %second_row_sum, %second_row_accumulator) : (index, f32, vector<[%fragment_width]xf32>, f32, f32, vector<[%fragment_width]xf32>) -> (f32, f32, vector<[%fragment_width]xf32>)
          scf.yield %second_updated_max, %second_updated_sum, %second_updated_accumulator : f32, f32, vector<[%fragment_width]xf32>
        } else {
          scf.yield %second_row_max, %second_row_sum, %second_row_accumulator : f32, f32, vector<[%fragment_width]xf32>
        }
        scf.yield %first_next_row_max, %first_next_row_sum, %first_next_row_accumulator, %second_next_row_max, %second_next_row_sum, %second_next_row_accumulator : f32, f32, vector<[%fragment_width]xf32>, f32, f32, vector<[%fragment_width]xf32>
      }
      scf.yield %first_rows_max, %first_rows_sum, %first_rows_accumulator, %second_rows_max, %second_rows_sum, %second_rows_accumulator : f32, f32, vector<[%fragment_width]xf32>, f32, f32, vector<[%fragment_width]xf32>
    } else {
      scf.yield %first_page_max, %first_page_sum, %first_page_accumulator, %second_page_max, %second_page_sum, %second_page_accumulator : f32, f32, vector<[%fragment_width]xf32>, f32, f32, vector<[%fragment_width]xf32>
    }
    scf.yield %first_next_page_max, %first_next_page_sum, %first_next_page_accumulator, %second_next_page_max, %second_next_page_sum, %second_next_page_accumulator : f32, f32, vector<[%fragment_width]xf32>, f32, f32, vector<[%fragment_width]xf32>
  }
  %first_nonempty = scalar.cmpf ogt, %first_final_sum, %identity : f32
  %first_normalized = scf.if %first_nonempty -> (vector<[%fragment_width]xf32>) {
    %first_denominators = vector.splat %first_final_sum : vector<[%fragment_width]xf32>
    %first_result = vector.divf %first_final_accumulator, %first_denominators : vector<[%fragment_width]xf32>
    scf.yield %first_result : vector<[%fragment_width]xf32>
  } else {
    scf.yield %initial_accumulator : vector<[%fragment_width]xf32>
  }
  %first_leader = index.cmp eq, %lane, %begin : index
  scf.if %first_leader {
    view.store %first_final_max, %state[%first_head, %begin] : f32, view<[%instances]x2xf32>
    view.store %first_final_sum, %state[%first_head, %row_step] : f32, view<[%instances]x2xf32>
  }
  vector.store %first_normalized, %output_view[%first_head, %channel] : vector<[%fragment_width]xf32>, view<[%instances]x128xf32>
  %second_nonempty = scalar.cmpf ogt, %second_final_sum, %identity : f32
  %second_normalized = scf.if %second_nonempty -> (vector<[%fragment_width]xf32>) {
    %second_denominators = vector.splat %second_final_sum : vector<[%fragment_width]xf32>
    %second_result = vector.divf %second_final_accumulator, %second_denominators : vector<[%fragment_width]xf32>
    scf.yield %second_result : vector<[%fragment_width]xf32>
  } else {
    scf.yield %initial_accumulator : vector<[%fragment_width]xf32>
  }
  %second_leader = index.cmp eq, %lane, %begin : index
  scf.if %second_leader {
    view.store %second_final_max, %state[%second_head, %begin] : f32, view<[%instances]x2xf32>
    view.store %second_final_sum, %state[%second_head, %row_step] : f32, view<[%instances]x2xf32>
  }
  vector.store %second_normalized, %output_view[%second_head, %channel] : vector<[%fragment_width]xf32>, view<[%instances]x128xf32>
  template.return
}

kernel.def @grouped_paged_attention_independent(%pair_count: index) {
  %unit = index.constant 1 : index
  %width = kernel.subgroup.size : index
  %head_groups = index.constant 2 : index
  kernel.launch.config workgroups(%head_groups, %pair_count, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%pair_count: index, %lengths: buffer, %query: buffer, %page_table: buffer, %keys: buffer, %values: buffer, %final_state: buffer, %output: buffer) {
  %depth = index.constant 2 : index
  %factor = index.constant 2 : index
  template.apply<@independent_paged_attention>(%pair_count, %lengths, %query, %page_table, %keys, %values, %final_state, %output, %depth, %factor) : (index, buffer, buffer, buffer, buffer, buffer, buffer, buffer, index, index)
  kernel.return
}

kernel.def @grouped_paged_attention_shared_serial(%pair_count: index) {
  %unit = index.constant 1 : index
  %width = kernel.subgroup.size : index
  %head_groups = index.constant 1 : index
  kernel.launch.config workgroups(%head_groups, %pair_count, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%pair_count: index, %lengths: buffer, %query: buffer, %page_table: buffer, %keys: buffer, %values: buffer, %final_state: buffer, %output: buffer) {
  %depth = index.constant 1 : index
  %factor = index.constant 2 : index
  template.apply<@grouped_paged_attention>(%pair_count, %lengths, %query, %page_table, %keys, %values, %final_state, %output, %depth, %factor) : (index, buffer, buffer, buffer, buffer, buffer, buffer, buffer, index, index)
  kernel.return
}

kernel.def @grouped_paged_attention_shared(%pair_count: index) {
  %unit = index.constant 1 : index
  %width = kernel.subgroup.size : index
  %head_groups = index.constant 1 : index
  kernel.launch.config workgroups(%head_groups, %pair_count, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%pair_count: index, %lengths: buffer, %query: buffer, %page_table: buffer, %keys: buffer, %values: buffer, %final_state: buffer, %output: buffer) {
  %depth = index.constant 2 : index
  %factor = index.constant 2 : index
  template.apply<@grouped_paged_attention>(%pair_count, %lengths, %query, %page_table, %keys, %values, %final_state, %output, %depth, %factor) : (index, buffer, buffer, buffer, buffer, buffer, buffer, buffer, index, index)
  kernel.return
}

// Distinct queries, pair-owned random tables and unequal lengths distinguish
// both query/state ownership and pair/table identity. Analytic trials below
// separately anchor the scalar states and every output channel.
check.case public @grouped_paged_attention_varied {
  %pairs = check.param.choice values([1, 4]) name("pairs") : index
  %seed = check.param.seed base(7450) count(2) : i64
  %lengths = check.generate.iota offset(0) step(17) period(61) : tensor<[%pairs]x2xi32>
  %query = check.generate.random.uniform seed(%seed) range(-0.5 to 0.5) : tensor<[%pairs]x2x128xf32>
  %pages = check.generate.random.uniform seed(%seed) range(-1 to 3) : tensor<[%pairs]x64xi32>
  %keys = check.generate.iota offset(-0.5) step(0.00390625) period(257) : tensor<64x128xf32>
  %values = check.generate.iota offset(-3.0) step(0.03125) period(251) : tensor<64x128xf32>
  %independent_state = check.generate.fill value(-10000.0) : tensor<[%pairs]x2x2xf32>
  %independent_output = check.generate.fill value(-40000.0) : tensor<[%pairs]x2x128xf32>
  kernel.launch @grouped_paged_attention_independent[%pairs](%pairs, %lengths, %query, %pages, %keys, %values, %independent_state, %independent_output) : [index](index, tensor<[%pairs]x2xi32>, tensor<[%pairs]x2x128xf32>, tensor<[%pairs]x64xi32>, tensor<64x128xf32>, tensor<64x128xf32>, tensor<[%pairs]x2x2xf32>, tensor<[%pairs]x2x128xf32>)
  %shared_serial_state = check.generate.fill value(-20000.0) : tensor<[%pairs]x2x2xf32>
  %shared_serial_output = check.generate.fill value(-80000.0) : tensor<[%pairs]x2x128xf32>
  kernel.launch @grouped_paged_attention_shared_serial[%pairs](%pairs, %lengths, %query, %pages, %keys, %values, %shared_serial_state, %shared_serial_output) : [index](index, tensor<[%pairs]x2xi32>, tensor<[%pairs]x2x128xf32>, tensor<[%pairs]x64xi32>, tensor<64x128xf32>, tensor<64x128xf32>, tensor<[%pairs]x2x2xf32>, tensor<[%pairs]x2x128xf32>)
  %shared_state = check.generate.fill value(-30000.0) : tensor<[%pairs]x2x2xf32>
  %shared_output = check.generate.fill value(-120000.0) : tensor<[%pairs]x2x128xf32>
  kernel.launch @grouped_paged_attention_shared[%pairs](%pairs, %lengths, %query, %pages, %keys, %values, %shared_state, %shared_output) : [index](index, tensor<[%pairs]x2xi32>, tensor<[%pairs]x2x128xf32>, tensor<[%pairs]x64xi32>, tensor<64x128xf32>, tensor<64x128xf32>, tensor<[%pairs]x2x2xf32>, tensor<[%pairs]x2x128xf32>)
  check.expect.close actual(%shared_serial_state) expected(%independent_state) atol(2.0000000000000002e-05) rtol(2.0000000000000002e-05) nan(same) : tensor<[%pairs]x2x2xf32>
  check.expect.close actual(%shared_serial_output) expected(%independent_output) atol(2.0000000000000002e-05) rtol(2.0000000000000002e-05) nan(same) : tensor<[%pairs]x2x128xf32>
  check.expect.close actual(%shared_state) expected(%independent_state) atol(2.0000000000000002e-05) rtol(2.0000000000000002e-05) nan(same) : tensor<[%pairs]x2x2xf32>
  check.expect.close actual(%shared_output) expected(%independent_output) atol(2.0000000000000002e-05) rtol(2.0000000000000002e-05) nan(same) : tensor<[%pairs]x2x128xf32>
  check.return
}

// Independent direct softmax: Q(h,c)=-1+(128*h+c)/128,
// K(row,c)=(128*row+c)/32768, V(row,c)=4*row-37/32+c/32.
// Normalize exp(dot(Q,K)*f32(1/sqrt(128))-max) over the selected rows;
// output is 4*weighted_mean(row)-37/32+c/32. Each head is checked separately.
// Minimal backing ends at the union prefix, including the final partial page.
// Trials are empty, empty first, empty second, ragged, holes and repeats, and
// absent pages, in that order.
func.def @grouped_paged_attention_analytic_config(%trial: index) -> (i32, i32, index, index) {
  %first_length, %second_length, %page_count, %backing_rows = scf.switch %trial -> (i32, i32, index, index) {
    case 0 {
      %first = scalar.constant 0 : i32
      %second = scalar.constant 0 : i32
      %pages = index.constant 1 : index
      %rows = index.constant 1 : index
      scf.yield %first, %second, %pages, %rows : i32, i32, index, index
    }
    case 1 {
      %first = scalar.constant 0 : i32
      %second = scalar.constant 17 : i32
      %pages = index.constant 2 : index
      %rows = index.constant 17 : index
      scf.yield %first, %second, %pages, %rows : i32, i32, index, index
    }
    case 2 {
      %first = scalar.constant 17 : i32
      %second = scalar.constant 0 : i32
      %pages = index.constant 2 : index
      %rows = index.constant 17 : index
      scf.yield %first, %second, %pages, %rows : i32, i32, index, index
    }
    case 3 {
      %first = scalar.constant 15 : i32
      %second = scalar.constant 33 : i32
      %pages = index.constant 3 : index
      %rows = index.constant 33 : index
      scf.yield %first, %second, %pages, %rows : i32, i32, index, index
    }
    case 4 {
      %first = scalar.constant 65 : i32
      %second = scalar.constant 33 : i32
      %pages = index.constant 5 : index
      %rows = index.constant 32 : index
      scf.yield %first, %second, %pages, %rows : i32, i32, index, index
    }
    default {
      %first = scalar.constant 1024 : i32
      %second = scalar.constant 17 : i32
      %pages = index.constant 64 : index
      %rows = index.constant 1 : index
      scf.yield %first, %second, %pages, %rows : i32, i32, index, index
    }
  }
  func.return %first_length, %second_length, %page_count, %backing_rows : i32, i32, index, index
}

func.def @grouped_paged_attention_analytic_inputs(%trial: index, %first_length: i32, %second_length: i32, %page_count: index, %backing_rows: index, %lengths_buffer: buffer, %query_buffer: buffer, %pages_buffer: buffer, %keys_buffer: buffer, %values_buffer: buffer) {
  %bounded_page_count = index.assume %page_count [range(%page_count, 1, 64)] : index
  %bounded_backing_rows = index.assume %backing_rows [range(%backing_rows, 1, 33)] : index
  %base = index.constant 0 : offset
  %lengths = buffer.view %lengths_buffer[%base] : buffer -> view<2xi32>
  %query = buffer.view %query_buffer[%base] : buffer -> view<2x128xf32>
  %pages = buffer.view %pages_buffer[%base] : buffer -> view<[%bounded_page_count]xi32>
  %keys = buffer.view %keys_buffer[%base] : buffer -> view<[%bounded_backing_rows]x128xf32>
  %values = buffer.view %values_buffer[%base] : buffer -> view<[%bounded_backing_rows]x128xf32>
  %begin = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %head_width = index.constant 128 : index
  view.store %first_length, %lengths[%begin] : i32, view<2xi32>
  view.store %second_length, %lengths[%c1] : i32, view<2xi32>

  %query_base = scalar.constant -1.0 : f32
  %query_step = scalar.constant 0.0078125 : f32
  scf.for %head = [%begin to %c2 step %c1] {
    %head_base = index.mul %head, %head_width : index
    scf.for %channel = [%begin to %head_width step %c1] {
      %linear = index.add %head_base, %channel : index
      %linear_i32 = index.cast %linear : index to i32
      %linear_f32 = scalar.sitofp %linear_i32 : i32 to f32
      %offset = scalar.mulf %linear_f32, %query_step : f32
      %value = scalar.addf %query_base, %offset : f32
      view.store %value, %query[%head, %channel] : f32, view<2x128xf32>
    }
  }

  scf.for %position = [%begin to %bounded_page_count step %c1] {
    %page_id = scf.switch %trial -> (i32) {
      case 4 {
        %period = index.constant 3 : index
        %phase = index.rem %position, %period : index
        %phase_i32 = index.cast %phase : index to i32
        %first_page = scalar.constant 1 : i32
        %value = scalar.subi %first_page, %phase_i32 : i32
        scf.yield %value : i32
      }
      case 5 {
        %value = scalar.constant -1 : i32
        scf.yield %value : i32
      }
      default {
        %value = index.cast %position : index to i32
        scf.yield %value : i32
      }
    }
    view.store %page_id, %pages[%position] : i32, view<[%bounded_page_count]xi32>
  }

  %first_finite_trial = index.constant 1 : index
  %finite_trial_end = index.constant 5 : index
  %after_empty = index.cmp uge, %trial, %first_finite_trial : index
  %before_absent = index.cmp ult, %trial, %finite_trial_end : index
  %has_finite_payload = scalar.andi %after_empty, %before_absent : i1
  scf.if %has_finite_payload {
    %key_step = scalar.constant 3.0517578125e-05 : f32
    %value_base = scalar.constant -1.15625 : f32
    %value_step = scalar.constant 0.03125 : f32
    scf.for %row = [%begin to %bounded_backing_rows step %c1] {
      %row_base = index.mul %row, %head_width : index
      scf.for %channel = [%begin to %head_width step %c1] {
        %linear = index.add %row_base, %channel : index
        %linear_i32 = index.cast %linear : index to i32
        %linear_f32 = scalar.sitofp %linear_i32 : i32 to f32
        %key = scalar.mulf %linear_f32, %key_step : f32
        %value_offset = scalar.mulf %linear_f32, %value_step : f32
        %value = scalar.addf %value_base, %value_offset : f32
        view.store %key, %keys[%row, %channel] : f32, view<[%bounded_backing_rows]x128xf32>
        view.store %value, %values[%row, %channel] : f32, view<[%bounded_backing_rows]x128xf32>
      }
    }
  }
  func.return
}

// Precomputed direct-softmax results independently anchor the shared online
// recurrence while retaining exact empty-head, sparse-page, and backing bounds.
func.def @grouped_paged_attention_analytic_oracle(%pair_count: index, %lengths_buffer: buffer, %query_buffer: buffer, %pages_buffer: buffer, %keys_buffer: buffer, %values_buffer: buffer, %final_state: buffer, %output_buffer: buffer) {
  %base = index.constant 0 : offset
  %lengths = buffer.view %lengths_buffer[%base] : buffer -> view<2xi32>
  %state = buffer.view %final_state[%base] : buffer -> view<2x2xf32>
  %output = buffer.view %output_buffer[%base] : buffer -> view<2x128xf32>
  %begin = index.constant 0 : index
  %c1 = index.constant 1 : index
  %head_width = index.constant 128 : index
  %first_length = view.load %lengths[%begin] : view<2xi32> -> i32
  %second_length = view.load %lengths[%c1] : view<2xi32> -> i32
  %first_count = index.cast %first_length : i32 to index
  %second_count = index.cast %second_length : i32 to index
  %empty_max = scalar.constant -1000000000.0 : f32
  %identity = scalar.constant 0.0 : f32
  %channel_step = scalar.constant 0.03125 : f32
  %first_max, %first_sum, %first_base, %first_step, %second_max, %second_sum, %second_base, %second_step = scf.switch %first_count -> (f32, f32, f32, f32, f32, f32, f32, f32) {
    case 0 {
      %second_max_value, %second_sum_value, %second_base_value, %second_step_value = scf.switch %second_count -> (f32, f32, f32, f32) {
        case 0 {
          scf.yield %empty_max, %identity, %identity, %identity : f32, f32, f32, f32
        }
        default {
          %maximum = scalar.constant 0.36535045582616021 : f32
          %denominator = scalar.constant 14.347550252715703 : f32
          %output_base_value = scalar.constant 32.943623661826734 : f32
          scf.yield %maximum, %denominator, %output_base_value, %channel_step : f32, f32, f32, f32
        }
      }
      scf.yield %empty_max, %identity, %identity, %identity, %second_max_value, %second_sum_value, %second_base_value, %second_step_value : f32, f32, f32, f32, f32, f32, f32, f32
    }
    case 15 {
      %first_max_value = scalar.constant -0.0073652459449249363 : f32
      %first_sum_value = scalar.constant 12.894316366784969 : f32
      %first_base_value = scalar.constant 25.184042199991968 : f32
      %second_max_value = scalar.constant 0.71614170455188741 : f32
      %second_sum_value = scalar.constant 23.745970511840614 : f32
      %second_base_value = scalar.constant 70.726438983671713 : f32
      scf.yield %first_max_value, %first_sum_value, %first_base_value, %channel_step, %second_max_value, %second_sum_value, %second_base_value, %channel_step : f32, f32, f32, f32, f32, f32, f32, f32
    }
    case 17 {
      %maximum = scalar.constant -0.0073652459449249363 : f32
      %denominator = scalar.constant 14.310588995984775 : f32
      %output_base_value = scalar.constant 28.710964078964228 : f32
      scf.yield %maximum, %denominator, %output_base_value, %channel_step, %empty_max, %identity, %identity, %identity : f32, f32, f32, f32, f32, f32, f32, f32
    }
    case 65 {
      %first_max_value = scalar.constant -0.0073652459449249363 : f32
      %first_sum_value = scalar.constant 33.671659507786266 : f32
      %first_base_value = scalar.constant 62.349985634426922 : f32
      %second_max_value = scalar.constant 0.69421725150652946 : f32
      %second_sum_value = scalar.constant 23.250170431555915 : f32
      %second_base_value = scalar.constant 68.259307014643795 : f32
      scf.yield %first_max_value, %first_sum_value, %first_base_value, %channel_step, %second_max_value, %second_sum_value, %second_base_value, %channel_step : f32, f32, f32, f32, f32, f32, f32, f32
    }
    default {
      scf.yield %empty_max, %identity, %identity, %identity, %empty_max, %identity, %identity, %identity : f32, f32, f32, f32, f32, f32, f32, f32
    }
  }
  view.store %first_max, %state[%begin, %begin] : f32, view<2x2xf32>
  view.store %first_sum, %state[%begin, %c1] : f32, view<2x2xf32>
  view.store %second_max, %state[%c1, %begin] : f32, view<2x2xf32>
  view.store %second_sum, %state[%c1, %c1] : f32, view<2x2xf32>
  scf.for %channel = [%begin to %head_width step %c1] {
    %channel_i32 = index.cast %channel : index to i32
    %channel_f32 = scalar.sitofp %channel_i32 : i32 to f32
    %first_offset = scalar.mulf %channel_f32, %first_step : f32
    %first_value = scalar.addf %first_base, %first_offset : f32
    view.store %first_value, %output[%begin, %channel] : f32, view<2x128xf32>
    %second_offset = scalar.mulf %channel_f32, %second_step : f32
    %second_value = scalar.addf %second_base, %second_offset : f32
    view.store %second_value, %output[%c1, %channel] : f32, view<2x128xf32>
  }
  func.return
}

check.scenario @grouped_paged_attention_analytic {
  check.trial[6](%trial: index, %entropy: check.entropy) {
    %pairs = check.literal value(1) : index
    %first_length, %second_length, %page_count, %backing_rows = check.generate<@grouped_paged_attention_analytic_config>(%trial) : (index) -> (i32, i32, index, index)
    %lengths = check.generate.fill value(0) : tensor<2xi32>
    %query = check.generate.fill value(0.0) : tensor<2x128xf32>
    %pages = check.generate.fill value(0) : tensor<[%page_count]xi32>
    %keys = check.generate.fill value(nan) : tensor<[%backing_rows]x128xf32>
    %values = check.generate.fill value(nan) : tensor<[%backing_rows]x128xf32>
    check.generate<@grouped_paged_attention_analytic_inputs>(%trial, %first_length, %second_length, %page_count, %backing_rows, %lengths, %query, %pages, %keys, %values) : (index, i32, i32, index, index, tensor<2xi32>, tensor<2x128xf32>, tensor<[%page_count]xi32>, tensor<[%backing_rows]x128xf32>, tensor<[%backing_rows]x128xf32>) -> ()
    %state = check.generate.fill value(-10000.0) : tensor<2x2xf32>
    %output = check.generate.fill value(-20000.0) : tensor<2x128xf32>
    %first_state = check.tensor.view %state offset(0) : tensor<2x2xf32> -> tensor<2xf32>
    %first_output = check.tensor.view %output offset(0) : tensor<2x128xf32> -> tensor<128xf32>
    %second_state = check.tensor.view %state offset(8) : tensor<2x2xf32> -> tensor<2xf32>
    %second_output = check.tensor.view %output offset(512) : tensor<2x128xf32> -> tensor<128xf32>
    check.compare<@grouped_paged_attention_shared, @grouped_paged_attention_analytic_oracle>[%pairs](%pairs, %lengths, %query, %pages, %keys, %values, %state, %output) : [index](index, tensor<2xi32>, tensor<2x128xf32>, tensor<[%page_count]xi32>, tensor<[%backing_rows]x128xf32>, tensor<[%backing_rows]x128xf32>, tensor<2x2xf32>, tensor<2x128xf32>) -> () {
      check.expect.close actual(%first_state) expected(%first_state) atol(2.0000000000000002e-05) rtol(2.0000000000000002e-05) nan(same) : tensor<2xf32>
      check.expect.close actual(%first_output) expected(%first_output) atol(2.0000000000000002e-05) rtol(2.0000000000000002e-05) nan(same) : tensor<128xf32>
      check.expect.close actual(%second_state) expected(%second_state) atol(2.0000000000000002e-05) rtol(2.0000000000000002e-05) nan(same) : tensor<2xf32>
      check.expect.close actual(%second_output) expected(%second_output) atol(2.0000000000000002e-05) rtol(2.0000000000000002e-05) nan(same) : tensor<128xf32>
    }
  }
  check.return
}
