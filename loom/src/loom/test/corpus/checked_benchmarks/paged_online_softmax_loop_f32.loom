// Online decode attention over runtime page IDs and a ragged logical token range.
//
// Each page holds four key/value rows with four channels. Page IDs are -1
// (absent) or in [0, 2]; repeated physical pages contribute at every logical
// occurrence. A page hole and the final row tail guard the memory accesses,
// not just their contribution to the result. The final physical page may have
// storage for only its valid rows. Inputs and outputs are disjoint and aligned
// to four bytes. Scores are finite and greater than the initial maximum -1e9.
//
// Both loops carry the running maximum, softmax denominator, and unnormalized
// value vector. Approximate exp, fused QK dots, and contractable PV model the
// attention math policy. Empty/all-absent inputs return zero output and retain
// the initial maximum and zero denominator.
kernel.def @paged_online_softmax_loop_f32() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%token_count: index, %query: buffer, %page_table: buffer, %keys: buffer, %values: buffer, %final_state: buffer, %output: buffer) {
  %count = index.assume %token_count [range(%token_count, 0, 32)] : index
  %begin = index.constant 0 : index
  %row_step = index.constant 1 : index
  %page_rows = index.constant 4 : index
  %base = index.constant 0 : offset
  %row_bytes = index.constant 16 : offset
  %page_bytes = index.constant 64 : offset
  %first_page_id = scalar.constant 0 : i32
  %initial_max = scalar.constant -1000000000.0 : f32
  %identity = scalar.constant 0.0 : f32
  %initial_accumulator = vector.splat %identity : vector<4xf32>
  %query_aligned = buffer.assume.alignment %query {minimum_alignment = 4} : buffer
  %table_aligned = buffer.assume.alignment %page_table {minimum_alignment = 4} : buffer
  %keys_aligned = buffer.assume.alignment %keys {minimum_alignment = 4} : buffer
  %values_aligned = buffer.assume.alignment %values {minimum_alignment = 4} : buffer
  %state_aligned = buffer.assume.alignment %final_state {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %query_storage, %table_storage, %key_storage, %value_storage, %state_storage, %output_storage = buffer.assume.noalias %query_aligned, %table_aligned, %keys_aligned, %values_aligned, %state_aligned, %output_aligned : buffer, buffer, buffer, buffer, buffer, buffer
  %query_view = buffer.view %query_storage[%base] : buffer -> view<4xf32>
  %table = buffer.view %table_storage[%base] : buffer -> view<8xi32>
  %state = buffer.view %state_storage[%base] : buffer -> view<2xf32>
  %output_view = buffer.view %output_storage[%base] : buffer -> view<4xf32>
  %query_vector = vector.load %query_view[%begin] : view<4xf32> -> vector<4xf32>
  %maximum, %denominator, %numerator = scf.for %page_begin = [%begin to %count step %page_rows](%page_max = %initial_max : f32, %page_sum = %identity : f32, %page_accumulator = %initial_accumulator : vector<4xf32>) -> (f32, f32, vector<4xf32>) {
    %logical_page = index.div %page_begin, %page_rows : index
    %page_id = view.load %table[%logical_page] : view<8xi32> -> i32
    %present = scalar.cmpi sge, %page_id, %first_page_id : i32
    %next_page_max, %next_page_sum, %next_page_accumulator = scf.if %present -> (f32, f32, vector<4xf32>) {
      %page_index = index.cast %page_id : i32 to index
      %page = index.assume %page_index [range(%page_index, 0, 2)] : index
      %page_offset = index.scale %page, %page_bytes : index, offset -> offset
      %rows_max, %rows_sum, %rows_accumulator = scf.for %row = [%begin to %page_rows step %row_step](%row_max = %page_max : f32, %row_sum = %page_sum : f32, %row_accumulator = %page_accumulator : vector<4xf32>) -> (f32, f32, vector<4xf32>) {
        %token = index.add %page_begin, %row : index
        %valid = index.cmp slt, %token, %count : index
        %next_row_max, %next_row_sum, %next_row_accumulator = scf.if %valid -> (f32, f32, vector<4xf32>) {
          %row_offset = index.scale %row, %row_bytes : index, offset -> offset
          %physical_offset = index.add %page_offset, %row_offset : offset
          %key_row = buffer.view %key_storage[%physical_offset] : buffer -> view<4xf32>
          %value_row = buffer.view %value_storage[%physical_offset] : buffer -> view<4xf32>
          %key = vector.load %key_row[%begin] : view<4xf32> -> vector<4xf32>
          %value = vector.load %value_row[%begin] : view<4xf32> -> vector<4xf32>
          %score = vector.dotf %query_vector, %key, %identity : vector<4xf32>, vector<4xf32>, f32
          %updated_max = scalar.maxnumf %row_max, %score : f32
          %old_delta = scalar.subf %row_max, %updated_max : f32
          %score_delta = scalar.subf %score, %updated_max : f32
          %old_scale = scalar.expf<afn> %old_delta : f32
          %weight = scalar.expf<afn> %score_delta : f32
          %rescaled_sum = scalar.mulf<contract> %row_sum, %old_scale : f32
          %updated_sum = scalar.addf<contract> %rescaled_sum, %weight : f32
          %old_scale_vector = vector.splat %old_scale : vector<4xf32>
          %weight_vector = vector.splat %weight : vector<4xf32>
          %rescaled_accumulator = vector.mulf<contract> %row_accumulator, %old_scale_vector : vector<4xf32>
          %weighted_value = vector.mulf<contract> %value, %weight_vector : vector<4xf32>
          %updated_accumulator = vector.addf<contract> %rescaled_accumulator, %weighted_value : vector<4xf32>
          scf.yield %updated_max, %updated_sum, %updated_accumulator : f32, f32, vector<4xf32>
        } else {
          scf.yield %row_max, %row_sum, %row_accumulator : f32, f32, vector<4xf32>
        }
        scf.yield %next_row_max, %next_row_sum, %next_row_accumulator : f32, f32, vector<4xf32>
      }
      scf.yield %rows_max, %rows_sum, %rows_accumulator : f32, f32, vector<4xf32>
    } else {
      scf.yield %page_max, %page_sum, %page_accumulator : f32, f32, vector<4xf32>
    }
    scf.yield %next_page_max, %next_page_sum, %next_page_accumulator : f32, f32, vector<4xf32>
  }
  %nonempty = scalar.cmpf ogt, %denominator, %identity : f32
  %normalized = scf.if %nonempty -> (vector<4xf32>) {
    %denominators = vector.splat %denominator : vector<4xf32>
    %result = vector.divf %numerator, %denominators : vector<4xf32>
    scf.yield %result : vector<4xf32>
  } else {
    scf.yield %initial_accumulator : vector<4xf32>
  }
  view.store %maximum, %state[%begin] : f32, view<2xf32>
  view.store %denominator, %state[%row_step] : f32, view<2xf32>
  vector.store %normalized, %output_view[%begin] : vector<4xf32>, view<4xf32>
  kernel.return
}

// Generates the shared-shape boundary and page-table controls at runtime so
// their values do not specialize the kernel under test.
func.def @paged_online_softmax_inputs(%trial: index, %query: buffer, %page_table: buffer) -> (index) {
  %base = index.constant 0 : offset
  %query_view = buffer.view %query[%base] : buffer -> view<4xf32>
  %table = buffer.view %page_table[%base] : buffer -> view<8xi32>
  %begin = index.constant 0 : index
  %query_end = index.constant 4 : index
  %page_end = index.constant 8 : index
  %step = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c6 = index.constant 6 : index
  %c9 = index.constant 9 : index
  %c12 = index.constant 12 : index
  %c14 = index.constant 14 : index
  %c17 = index.constant 17 : index
  %c18 = index.constant 18 : index
  %c1 = index.constant 1 : index
  %c19 = index.constant 19 : index

  %below_six = index.cmp ult, %trial, %c6 : index
  %count = scf.if %below_six -> (index) {
    scf.yield %trial : index
  } else {
    %below_nine = index.cmp ult, %trial, %c9 : index
    %upper_count = scf.if %below_nine -> (index) {
      %value = index.add %trial, %c1 : index
      scf.yield %value : index
    } else {
      %below_twelve = index.cmp ult, %trial, %c12 : index
      %high_count = scf.if %below_twelve -> (index) {
        %value = index.add %trial, %c6 : index
        scf.yield %value : index
      } else {
        %below_fourteen = index.cmp ult, %trial, %c14 : index
        %boundary_count = scf.if %below_fourteen -> (index) {
          %value = index.add %trial, %c19 : index
          scf.yield %value : index
        } else {
          %value = scf.switch %trial -> (index) {
            case 14 {
              %special = index.constant 9 : index
              scf.yield %special : index
            }
            case 15 {
              %special = index.constant 32 : index
              scf.yield %special : index
            }
            case 16 {
              %special = index.constant 32 : index
              scf.yield %special : index
            }
            case 17 {
              %special = index.constant 17 : index
              scf.yield %special : index
            }
            default {
              %special = index.constant 9 : index
              scf.yield %special : index
            }
          }
          scf.yield %value : index
        }
        scf.yield %boundary_count : index
      }
      scf.yield %high_count : index
    }
    scf.yield %upper_count : index
  }

  %custom_query = index.cmp uge, %trial, %c14 : index
  scf.if %custom_query {
    %negative_query = index.cmp eq, %trial, %c17 : index
    %positive = scalar.constant 1.0 : f32
    %negative = scalar.constant -1.0 : f32
    %value = scf.select %negative_query, %negative, %positive : f32
    scf.for %channel = [%begin to %query_end step %step] {
      view.store %value, %query_view[%channel] : f32, view<4xf32>
    }
  }

  scf.switch %trial {
    case 14 {
      %page_id = scalar.constant 1 : i32
      scf.for %page = [%begin to %page_end step %step] {
        view.store %page_id, %table[%page] : i32, view<8xi32>
      }
    }
    case 15 {
      %page_id = scalar.constant -1 : i32
      scf.for %page = [%begin to %page_end step %step] {
        view.store %page_id, %table[%page] : i32, view<8xi32>
      }
    }
    case 18 {
      %page_bias = scalar.constant 1 : i32
      scf.for %page = [%begin to %page_end step %step] {
        %phase = index.rem %page, %c4 : index
        %phase_i32 = index.cast %phase : index to i32
        %page_id = scalar.subi %phase_i32, %page_bias : i32
        view.store %page_id, %table[%page] : i32, view<8xi32>
      }
    }
    default {
    }
  }
  func.return %count : index
}

func.def @paged_online_softmax_compact_count() -> (index) {
  %count = index.constant 10 : index
  func.return %count : index
}

// Returns whether a logical token is present, its scalar score, and its
// physical row. This keeps the direct oracle independent of the online
// recurrence and works with both full and exact-tail backing allocations.
func.def inline @paged_online_softmax_sample(%token: index, %query: buffer, %page_table: buffer, %keys: buffer) -> (i1, f32, index) {
  %base = index.constant 0 : offset
  %query_view = buffer.view %query[%base] : buffer -> view<4xf32>
  %table = buffer.view %page_table[%base] : buffer -> view<8xi32>
  %begin = index.constant 0 : index
  %channel_end = index.constant 4 : index
  %page_rows = index.constant 4 : index
  %step = index.constant 1 : index
  %row_bytes = index.constant 16 : offset
  %first_page_id = scalar.constant 0 : i32
  %absent_score = scalar.constant 0.0 : f32
  %logical_page = index.div %token, %page_rows : index
  %row = index.rem %token, %page_rows : index
  %page_id = view.load %table[%logical_page] : view<8xi32> -> i32
  %present = scalar.cmpi sge, %page_id, %first_page_id : i32
  %score, %physical_row = scf.if %present -> (f32, index) {
    %page_index = index.cast %page_id : i32 to index
    %page = index.assume %page_index [range(%page_index, 0, 2)] : index
    %page_begin = index.mul %page, %page_rows : index
    %physical = index.add %page_begin, %row : index
    %row_offset = index.scale %physical, %row_bytes : index, offset -> offset
    %key_row = buffer.view %keys[%row_offset] : buffer -> view<4xf32>
    %dot = scf.for %channel = [%begin to %channel_end step %step](%sum = %absent_score : f32) -> (f32) {
      %query_value = view.load %query_view[%channel] : view<4xf32> -> f32
      %key_value = view.load %key_row[%channel] : view<4xf32> -> f32
      %product = scalar.mulf %query_value, %key_value : f32
      %next = scalar.addf %sum, %product : f32
      scf.yield %next : f32
    }
    scf.yield %dot, %physical : f32, index
  } else {
    scf.yield %absent_score, %begin : f32, index
  }
  func.return %present, %score, %physical_row : i1, f32, index
}

// Direct normalized-softmax oracle. It first finds the maximum, then computes
// the denominator and each output numerator in separate scalar passes.
func.def @paged_online_softmax_loop_f32_oracle(%token_count: index, %query: buffer, %page_table: buffer, %keys: buffer, %values: buffer, %final_state: buffer, %output: buffer) {
  %count = index.assume %token_count [range(%token_count, 0, 32)] : index
  %base = index.constant 0 : offset
  %state = buffer.view %final_state[%base] : buffer -> view<2xf32>
  %output_view = buffer.view %output[%base] : buffer -> view<4xf32>
  %begin = index.constant 0 : index
  %channel_end = index.constant 4 : index
  %step = index.constant 1 : index
  %row_bytes = index.constant 16 : offset
  %initial_max = scalar.constant -1000000000.0 : f32
  %empty_sum = scalar.constant 0.0 : f32

  %maximum = scf.for %token = [%begin to %count step %step](%current = %initial_max : f32) -> (f32) {
    %present, %score, %physical_row = func.call @paged_online_softmax_sample(%token, %query, %page_table, %keys) : (index, buffer, buffer, buffer) -> (i1, f32, index)
    %next = scf.if %present -> (f32) {
      %updated = scalar.maxnumf %current, %score : f32
      scf.yield %updated : f32
    } else {
      scf.yield %current : f32
    }
    scf.yield %next : f32
  }

  %denominator = scf.for %token = [%begin to %count step %step](%sum = %empty_sum : f32) -> (f32) {
    %present, %score, %physical_row = func.call @paged_online_softmax_sample(%token, %query, %page_table, %keys) : (index, buffer, buffer, buffer) -> (i1, f32, index)
    %next = scf.if %present -> (f32) {
      %delta = scalar.subf %score, %maximum : f32
      %weight = scalar.expf<afn> %delta : f32
      %updated = scalar.addf %sum, %weight : f32
      scf.yield %updated : f32
    } else {
      scf.yield %sum : f32
    }
    scf.yield %next : f32
  }

  scf.for %channel = [%begin to %channel_end step %step] {
    %numerator = scf.for %token = [%begin to %count step %step](%sum = %empty_sum : f32) -> (f32) {
      %present, %score, %physical_row = func.call @paged_online_softmax_sample(%token, %query, %page_table, %keys) : (index, buffer, buffer, buffer) -> (i1, f32, index)
      %next = scf.if %present -> (f32) {
        %delta = scalar.subf %score, %maximum : f32
        %weight = scalar.expf<afn> %delta : f32
        %row_offset = index.scale %physical_row, %row_bytes : index, offset -> offset
        %value_row = buffer.view %values[%row_offset] : buffer -> view<4xf32>
        %value = view.load %value_row[%channel] : view<4xf32> -> f32
        %weighted = scalar.mulf %weight, %value : f32
        %updated = scalar.addf %sum, %weighted : f32
        scf.yield %updated : f32
      } else {
        scf.yield %sum : f32
      }
      scf.yield %next : f32
    }
    %nonempty = scalar.cmpf ogt, %denominator, %empty_sum : f32
    %normalized = scf.if %nonempty -> (f32) {
      %value = scalar.divf %numerator, %denominator : f32
      scf.yield %value : f32
    } else {
      scf.yield %empty_sum : f32
    }
    view.store %normalized, %output_view[%channel] : f32, view<4xf32>
  }
  view.store %maximum, %state[%begin] : f32, view<2xf32>
  view.store %denominator, %state[%step] : f32, view<2xf32>
  func.return
}

check.scenario @paged_online_softmax_loop_values {
  check.trial[19](%trial: index, %entropy: check.entropy) {
    %query = check.generate.fill value(0.0) : tensor<4xf32>
    %pages = check.generate.iota offset(2) step(-1) period(4) : tensor<8xi32>
    %count = check.generate<@paged_online_softmax_inputs>(%trial, %query, %pages) : (index, tensor<4xf32>, tensor<8xi32>) -> (index)
    %keys = check.generate.iota offset(0.0) step(0.0625) : tensor<12x4xf32>
    %values = check.generate.iota offset(-4.0) step(1.0) : tensor<12x4xf32>
    %state = check.generate.fill value(-1000.0) : tensor<2xf32>
    %output = check.generate.fill value(-1000.0) : tensor<4xf32>
    check.compare<@paged_online_softmax_loop_f32, @paged_online_softmax_loop_f32_oracle>(%count, %query, %pages, %keys, %values, %state, %output) : (index, tensor<4xf32>, tensor<8xi32>, tensor<12x4xf32>, tensor<12x4xf32>, tensor<2xf32>, tensor<4xf32>) -> () {
      check.expect.close actual(%state) expected(%state) atol(9.9999999999999995e-07) rtol(9.9999999999999995e-07) nan(same) : tensor<2xf32>
      check.expect.close actual(%output) expected(%output) atol(9.9999999999999995e-07) rtol(9.9999999999999995e-07) nan(same) : tensor<4xf32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %count = check.generate<@paged_online_softmax_compact_count>() : () -> (index)
    %query = check.generate.fill value(1.0) : tensor<4xf32>
    %pages = check.generate.iota offset(0) step(1) period(3) : tensor<8xi32>
    %keys = check.generate.iota offset(0.0) step(0.0625) : tensor<10x4xf32>
    %values = check.generate.iota offset(-4.0) step(1.0) : tensor<10x4xf32>
    %state = check.generate.fill value(-1000.0) : tensor<2xf32>
    %output = check.generate.fill value(-1000.0) : tensor<4xf32>
    check.compare<@paged_online_softmax_loop_f32, @paged_online_softmax_loop_f32_oracle>(%count, %query, %pages, %keys, %values, %state, %output) : (index, tensor<4xf32>, tensor<8xi32>, tensor<10x4xf32>, tensor<10x4xf32>, tensor<2xf32>, tensor<4xf32>) -> () {
      check.expect.close actual(%state) expected(%state) atol(9.9999999999999995e-07) rtol(9.9999999999999995e-07) nan(same) : tensor<2xf32>
      check.expect.close actual(%output) expected(%output) atol(9.9999999999999995e-07) rtol(9.9999999999999995e-07) nan(same) : tensor<4xf32>
    }
  }
  check.return
}
