load("//loom/build_tools/bazel:defs.bzl", "loom_library", "loom_test_module")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

exports_files(glob(["*.loom"]))

loom_library(
    name = "checked_benchmark_library",
    srcs = ["//loom/src/loom/test/corpus/checked_benchmarks:corpus"],
)

loom_test_module(
    name = "checked_benchmark_workload_module",
    srcs = glob(["*.loom"]),
    deps = [":checked_benchmark_library"],
)
