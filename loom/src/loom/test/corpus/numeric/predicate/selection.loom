// Materializes a trial ordinal without making it a runtime argument to the
// subject under test.
func.def @predicate_selection_input(%trial: index, %input: buffer) {
  %base = index.constant 0 : offset
  %view = buffer.view %input[%base] : buffer -> view<1xi32>
  %ordinal = index.cast %trial : index to i32
  view.store %ordinal, %view[0] : i32, view<1xi32>
  func.return
}

// Each runtime trial chooses one Boolean payload and one independent selector.
// Both arm orders and a separately observed complement must preserve their bits.
func.def @conditional_predicates(%input_buffer: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input_buffer[%base] : buffer -> view<1xi32>
  %ordinal = view.load %input_view[0] : view<1xi32> -> i32
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %input_bits = scalar.andi %ordinal, %c1 : i32
  %enabled_bits = scalar.andi %ordinal, %c2 : i32
  %input = scalar.cmpi ne, %input_bits, %c0 : i32
  %enabled = scalar.cmpi ne, %enabled_bits, %c0 : i32
  %true = scalar.constant true : i1
  %inverse = scalar.xori %input, %true : i1
  %selected = scf.select %enabled, %inverse, %input : i1
  %reversed = scf.select %enabled, %input, %inverse : i1
  %selected_word = scalar.extui %selected : i1 to i32
  %reversed_word = scalar.extui %reversed : i1 to i32
  %inverse_word = scalar.extui %inverse : i1 to i32
  %out = buffer.view %output[%base] : buffer -> view<3xi32>
  view.store %selected_word, %out[0] : i32, view<3xi32>
  view.store %reversed_word, %out[1] : i32, view<3xi32>
  view.store %inverse_word, %out[2] : i32, view<3xi32>
  func.return
}

check.scenario @conditional_predicate_values {
  check.trial[4](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(0) : tensor<1xi32>
    check.generate<@predicate_selection_input>(%trial, %input) : (index, tensor<1xi32>) -> ()
    %output = check.generate.fill value(-123) : tensor<3xi32>
    check.compare<@conditional_predicates>(%input, %output) : (tensor<1xi32>, tensor<3xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<3xi32>
    }
  }
  check.return
}

// Conditional inversion survives signed and unsigned widening. Signed true
// is all ones; a byte truth test returns to the predicate domain.
func.def @extended_predicates(%input_buffer: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input_buffer[%base] : buffer -> view<1xi32>
  %ordinal = view.load %input_view[0] : view<1xi32> -> i32
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %input_bits = scalar.andi %ordinal, %c1 : i32
  %condition_bits = scalar.andi %ordinal, %c2 : i32
  %right = scalar.cmpi ne, %input_bits, %c0 : i32
  %condition = scalar.cmpi ne, %condition_bits, %c0 : i32
  %true = scalar.constant true : i1
  %left = scalar.xori %right, %true : i1
  %left_unsigned = scalar.extui %left : i1 to i32
  %right_unsigned = scalar.extui %right : i1 to i32
  %unsigned = scf.select %condition, %left_unsigned, %right_unsigned : i32
  %left_signed = scalar.extsi %left : i1 to i32
  %right_signed = scalar.extsi %right : i1 to i32
  %signed = scf.select %condition, %left_signed, %right_signed : i32
  %left_byte = scalar.extui %left : i1 to i8
  %right_byte = scalar.extui %right : i1 to i8
  %byte = scf.select %condition, %left_byte, %right_byte : i8
  %c0_i8 = scalar.constant 0 : i8
  %truth = scalar.cmpi ne, %byte, %c0_i8 : i8
  %truth_word = scalar.extui %truth : i1 to i32
  %out = buffer.view %output[%base] : buffer -> view<3xi32>
  view.store %unsigned, %out[0] : i32, view<3xi32>
  view.store %signed, %out[1] : i32, view<3xi32>
  view.store %truth_word, %out[2] : i32, view<3xi32>
  func.return
}

check.scenario @extended_predicate_values {
  check.trial[4](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(0) : tensor<1xi32>
    check.generate<@predicate_selection_input>(%trial, %input) : (index, tensor<1xi32>) -> ()
    %output = check.generate.fill value(-123) : tensor<3xi32>
    check.compare<@extended_predicates>(%input, %output) : (tensor<1xi32>, tensor<3xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<3xi32>
    }
  }
  check.return
}

// Exercises scalar, wide, narrow, floating-point, and vector-extracted select
// payloads from runtime storage. The output widens each result to one common
// bitwise comparison surface without changing the selected value.
func.def @selected_payloads(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %wide = buffer.view %input[%base] : buffer -> view<16xi64>
  %words = buffer.view %input[%base] : buffer -> view<32xi32>
  %results = buffer.view %output[%base] : buffer -> view<10xi64>

  %wide_values = vector.load %wide[0] : view<16xi64> -> vector<2xi64>
  %wide_true = view.load %wide[2] : view<16xi64> -> i64
  %wide_false = view.load %wide[3] : view<16xi64> -> i64
  %guard_values = vector.load %words[8] : view<32xi32> -> vector<2xi32>
  %guard_lhs = vector.extract %guard_values[0] : vector<2xi32> -> i32
  %guard_rhs = vector.extract %guard_values[1] : vector<2xi32> -> i32
  %word_true = view.load %words[10] : view<32xi32> -> i32
  %word_false = view.load %words[11] : view<32xi32> -> i32
  %limit = view.load %words[12] : view<32xi32> -> i32
  %fallback = view.load %words[13] : view<32xi32> -> i32
  %code = view.load %words[14] : view<32xi32> -> i32
  %selector = view.load %words[15] : view<32xi32> -> i32
  %float_lhs_bits = view.load %words[16] : view<32xi32> -> i32
  %float_rhs_bits = view.load %words[17] : view<32xi32> -> i32
  %float_true_bits = view.load %words[18] : view<32xi32> -> i32
  %float_false_bits = view.load %words[19] : view<32xi32> -> i32

  %word_condition = scalar.cmpi slt, %guard_lhs, %guard_rhs : i32
  %guard_limit_condition = scalar.cmpi slt, %guard_lhs, %limit : i32
  %selected_word = scf.select %word_condition, %word_true, %word_false : i32
  %selected_word_wide = scalar.extsi %selected_word : i32 to i64
  view.store %selected_word_wide, %results[0] : i64, view<10xi64>

  %selected_wide = scf.select %word_condition, %wide_true, %wide_false : i64
  view.store %selected_wide, %results[1] : i64, view<10xi64>

  %c0 = scalar.constant 0 : i32
  %c4 = scalar.constant 4 : i32
  %c16 = scalar.constant 16 : i32
  %c15 = scalar.constant 15 : i32
  %use_high = scalar.cmpi ne, %selector, %c0 : i32
  %high_nibble_word = scalar.shrui %code, %c4 : i32
  %low_nibble_word = scalar.andi %code, %c15 : i32
  %high_nibble_masked = scalar.andi %high_nibble_word, %c15 : i32
  %low_nibble = scalar.trunci %low_nibble_word : i32 to i8
  %high_nibble = scalar.trunci %high_nibble_masked : i32 to i8
  %selected_nibble = scf.select %use_high, %high_nibble, %low_nibble : i8
  %selected_nibble_wide = scalar.extui %selected_nibble : i8 to i64
  view.store %selected_nibble_wide, %results[2] : i64, view<10xi64>

  %low_half = scalar.trunci %code : i32 to i16
  %high_half_word = scalar.shrui %code, %c16 : i32
  %high_half = scalar.trunci %high_half_word : i32 to i16
  %selected_half = scf.select %use_high, %high_half, %low_half : i16
  %selected_half_wide = scalar.extui %selected_half : i16 to i64
  view.store %selected_half_wide, %results[3] : i64, view<10xi64>

  %float_lhs = scalar.bitcast %float_lhs_bits : i32 to f32
  %float_rhs = scalar.bitcast %float_rhs_bits : i32 to f32
  %float_true = scalar.bitcast %float_true_bits : i32 to f32
  %float_false = scalar.bitcast %float_false_bits : i32 to f32
  %float_condition = scalar.cmpf olt, %float_lhs, %float_rhs : f32
  %selected_float = scf.select %float_condition, %float_true, %float_false : f32
  %selected_float_bits = scalar.bitcast %selected_float : f32 to i32
  %selected_float_wide = scalar.extui %selected_float_bits : i32 to i64
  view.store %selected_float_wide, %results[4] : i64, view<10xi64>

  %extracted_wide = vector.extract %wide_values[0] : vector<2xi64> -> i64
  %selected_extracted_wide = scf.select %guard_limit_condition, %extracted_wide, %wide_false : i64
  view.store %selected_extracted_wide, %results[5] : i64, view<10xi64>

  %signed_lane = scalar.extsi %guard_lhs : i32 to i64
  %signed_fallback = scalar.extsi %fallback : i32 to i64
  %selected_signed = scf.select %guard_limit_condition, %signed_lane, %signed_fallback : i64
  view.store %selected_signed, %results[6] : i64, view<10xi64>

  %unsigned_lane = scalar.extui %guard_lhs : i32 to i64
  %unsigned_fallback = scalar.extui %fallback : i32 to i64
  %selected_unsigned = scf.select %guard_limit_condition, %unsigned_lane, %unsigned_fallback : i64
  view.store %selected_unsigned, %results[7] : i64, view<10xi64>

  %selected_lane = scf.select %guard_limit_condition, %guard_lhs, %fallback : i32
  %selected_changed = scalar.cmpi ne, %selected_lane, %fallback : i32
  %chained = scf.select %selected_changed, %selected_lane, %fallback : i32
  %chained_wide = scalar.extsi %chained : i32 to i64
  view.store %chained_wide, %results[8] : i64, view<10xi64>

  %tail_fill = scalar.constant 0 : i32
  %tail = scf.select %guard_limit_condition, %guard_lhs, %tail_fill : i32
  %tail_wide = scalar.extsi %tail : i32 to i64
  view.store %tail_wide, %results[9] : i64, view<10xi64>
  func.return
}

check.scenario @selected_payload_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-19088743) step(178956970) : tensor<16xi64>
    %output = check.generate.fill value(-1) : tensor<10xi64>
    check.compare<@selected_payloads>(%input, %output) : (tensor<16xi64>, tensor<10xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<10xi64>
    }
  }
  check.trial[64](%trial: index, %entropy: check.entropy) {
    %input_seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%input_seed) range(-9223372036854775808 to 9223372036854775807) : tensor<16xi64>
    %output = check.generate.fill value(-1) : tensor<10xi64>
    check.compare<@selected_payloads>(%input, %output) : (tensor<16xi64>, tensor<10xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<10xi64>
    }
  }
  check.return
}

// Selects predicates in every constant and runtime arm position before using
// each result to choose a floating-point payload. This exposes incorrect
// complement folding as an observable bit mismatch.
func.def @selected_predicates(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %values = buffer.view %input[%base] : buffer -> view<9xi32>
  %results = buffer.view %output[%base] : buffer -> view<12xi32>
  %lane = view.load %values[0] : view<9xi32> -> i32
  %limit = view.load %values[1] : view<9xi32> -> i32
  %upper = view.load %values[2] : view<9xi32> -> i32
  %fallback_bits = view.load %values[3] : view<9xi32> -> i32
  %lhs = view.load %values[4] : view<9xi32> -> i32
  %rhs = view.load %values[5] : view<9xi32> -> i32
  %alt = view.load %values[6] : view<9xi32> -> i32
  %true_bits = view.load %values[7] : view<9xi32> -> i32
  %false_bits = view.load %values[8] : view<9xi32> -> i32
  %c0 = scalar.constant 0 : i32
  %true = scalar.constant true : i1
  %false = scalar.constant false : i1
  %lane_condition = scalar.cmpi slt, %lane, %limit : i32
  %inside_upper = scalar.cmpi slt, %lane, %upper : i32
  %scalar_condition = scalar.cmpi slt, %limit, %upper : i32
  %fallback_condition = scalar.cmpi ne, %fallback_bits, %c0 : i32
  %lhs_nonzero = scalar.cmpi ne, %lhs, %c0 : i32
  %alt_nonzero = scalar.cmpi ne, %alt, %c0 : i32
  %scc_condition = scalar.cmpi slt, %lhs, %rhs : i32
  %checked_lane_condition, %checked_scalar_condition = scalar.assume %lane_condition, %scalar_condition [] : i1, i1

  %mask_condition = scf.select %lane_condition, %lane_condition, %fallback_condition : i1
  %false_condition = scf.select %lane_condition, %inside_upper, %lane_condition : i1
  %true_false = scf.select %lane_condition, %true, %false : i1
  %false_true = scf.select %lane_condition, %false, %true : i1
  %true_payload = scf.select %lane_condition, %true, %fallback_condition : i1
  %false_payload = scf.select %lane_condition, %false, %fallback_condition : i1
  %true_fallback = scf.select %lane_condition, %fallback_condition, %true : i1
  %false_fallback = scf.select %lane_condition, %fallback_condition, %false : i1
  %selected_scc = scf.select %scc_condition, %lhs_nonzero, %alt_nonzero : i1

  %true_value = scalar.bitcast %true_bits : i32 to f32
  %false_value = scalar.bitcast %false_bits : i32 to f32
  %mask_result = scf.select %mask_condition, %true_value, %false_value : f32
  %false_condition_result = scf.select %false_condition, %true_value, %false_value : f32
  %assumed_result = scf.select %checked_scalar_condition, %true_value, %false_value : f32
  %true_false_result = scf.select %true_false, %true_value, %false_value : f32
  %false_true_result = scf.select %false_true, %true_value, %false_value : f32
  %true_payload_result = scf.select %true_payload, %true_value, %false_value : f32
  %false_payload_result = scf.select %false_payload, %true_value, %false_value : f32
  %true_fallback_result = scf.select %true_fallback, %true_value, %false_value : f32
  %false_fallback_result = scf.select %false_fallback, %true_value, %false_value : f32
  %true_result = scf.select %true, %true_value, %false_value : f32
  %false_result = scf.select %false, %true_value, %false_value : f32
  %scc_result = scf.select %selected_scc, %true_value, %false_value : f32
  %mask_result_bits = scalar.bitcast %mask_result : f32 to i32
  %false_condition_result_bits = scalar.bitcast %false_condition_result : f32 to i32
  %assumed_result_bits = scalar.bitcast %assumed_result : f32 to i32
  %true_false_result_bits = scalar.bitcast %true_false_result : f32 to i32
  %false_true_result_bits = scalar.bitcast %false_true_result : f32 to i32
  %true_payload_result_bits = scalar.bitcast %true_payload_result : f32 to i32
  %false_payload_result_bits = scalar.bitcast %false_payload_result : f32 to i32
  %true_fallback_result_bits = scalar.bitcast %true_fallback_result : f32 to i32
  %false_fallback_result_bits = scalar.bitcast %false_fallback_result : f32 to i32
  %true_result_bits = scalar.bitcast %true_result : f32 to i32
  %false_result_bits = scalar.bitcast %false_result : f32 to i32
  %scc_result_bits = scalar.bitcast %scc_result : f32 to i32
  %result_values = vector.from_elements %mask_result_bits, %false_condition_result_bits, %assumed_result_bits, %true_false_result_bits, %false_true_result_bits, %true_payload_result_bits, %false_payload_result_bits, %true_fallback_result_bits, %false_fallback_result_bits, %true_result_bits, %false_result_bits, %scc_result_bits : vector<12xi32>
  vector.store %result_values, %results[0] : vector<12xi32>, view<12xi32>
  func.return
}

check.scenario @selected_predicate_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-4) step(1) : tensor<9xi32>
    %output = check.generate.fill value(-1) : tensor<12xi32>
    check.compare<@selected_predicates>(%input, %output) : (tensor<9xi32>, tensor<12xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<12xi32>
    }
  }
  check.trial[64](%trial: index, %entropy: check.entropy) {
    %input_seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%input_seed) range(-2147483648 to 2147483647) : tensor<9xi32>
    %output = check.generate.fill value(-1) : tensor<12xi32>
    check.compare<@selected_predicates>(%input, %output) : (tensor<9xi32>, tensor<12xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<12xi32>
    }
  }
  check.return
}
