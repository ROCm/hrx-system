  %initial = view.load %initial_view[0] : view<1xbf16> -> bf16

  %minnum = vector.reduce<minnumf, reassoc|nnan|nsz> %input, %initial : vector<33xbf16>, bf16
  %minimum = vector.reduce<minimumf, reassoc|nnan|nsz> %input, %initial : vector<33xbf16>, bf16
  view.store %minnum, %output_view[0] : bf16, view<2xbf16>
  view.store %minimum, %output_view[1] : bf16, view<2xbf16>
