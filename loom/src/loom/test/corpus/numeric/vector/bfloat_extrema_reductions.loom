  view.store %maximum, %output_view[1] : bf16, view<2xbf16>
  func.return
}

check.scenario @bfloat_extrema_reduction_boundaries {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %storage = check.generate.iota offset(-2.0) step(3.0) : tensor<6xbf16>
    %output = check.tensor.view %storage offset(8) : tensor<6xbf16> -> tensor<2xbf16>
    %expected_minimum = check.generate.fill value(-2.0) : tensor<2xbf16>
    check.compare<@bfloat_minimum_reductions_3>(%storage) : (tensor<6xbf16>) -> () {
      check.expect.close actual(%output) expected(%expected_minimum) atol(0.0) rtol(0.0) nan(same) : tensor<2xbf16>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %storage = check.generate.iota offset(-2.0) step(3.0) : tensor<6xbf16>
    %output = check.tensor.view %storage offset(8) : tensor<6xbf16> -> tensor<2xbf16>
    %expected_maximum = check.generate.fill value(7.0) : tensor<2xbf16>
    check.compare<@bfloat_maximum_reductions_3>(%storage) : (tensor<6xbf16>) -> () {
      check.expect.close actual(%output) expected(%expected_maximum) atol(0.0) rtol(0.0) nan(same) : tensor<2xbf16>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %storage = check.generate.iota offset(16.0) step(-1.0) : tensor<36xbf16>
    %output = check.tensor.view %storage offset(68) : tensor<36xbf16> -> tensor<2xbf16>
    %expected_minimum = check.generate.fill value(-17.0) : tensor<2xbf16>
    check.compare<@bfloat_minimum_reductions_33>(%storage) : (tensor<36xbf16>) -> () {
      check.expect.close actual(%output) expected(%expected_minimum) atol(0.0) rtol(0.0) nan(same) : tensor<2xbf16>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %storage = check.generate.iota offset(16.0) step(-1.0) : tensor<36xbf16>
    %output = check.tensor.view %storage offset(68) : tensor<36xbf16> -> tensor<2xbf16>
    %expected_maximum = check.generate.fill value(16.0) : tensor<2xbf16>
    check.compare<@bfloat_maximum_reductions_33>(%storage) : (tensor<36xbf16>) -> () {
      check.expect.close actual(%output) expected(%expected_maximum) atol(0.0) rtol(0.0) nan(same) : tensor<2xbf16>
    }
  }
  check.return
}
