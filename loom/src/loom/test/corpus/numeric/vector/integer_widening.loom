// The seventeenth widened lane and ninth quantized lane cross full carriers.
// Volatile initialization makes exact tail stores observable in every slot.
kernel.def @partial_widening() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %source, %destination = buffer.assume.alignment %input, %output {minimum_alignment = 64} : buffer, buffer
  %origin = index.constant 0 : offset
  %source_i32 = buffer.view %source[%origin] : buffer -> view<64xi32>
  %source_f32 = buffer.view %source[%origin] : buffer -> view<64xf32>
  %destination_i32 = buffer.view %destination[%origin] : buffer -> view<144xi32>
  %destination_i64 = buffer.view %destination[%origin] : buffer -> view<72xi64>
  %sentinel = vector.splati -1515870811 : vector<16xi32>
  vector.store<volatile> %sentinel, %destination_i32[0] : vector<16xi32>, view<144xi32>
  vector.store<volatile> %sentinel, %destination_i32[16] : vector<16xi32>, view<144xi32>
  vector.store<volatile> %sentinel, %destination_i32[32] : vector<16xi32>, view<144xi32>
  vector.store<volatile> %sentinel, %destination_i32[48] : vector<16xi32>, view<144xi32>
  vector.store<volatile> %sentinel, %destination_i32[64] : vector<16xi32>, view<144xi32>
  vector.store<volatile> %sentinel, %destination_i32[80] : vector<16xi32>, view<144xi32>
  vector.store<volatile> %sentinel, %destination_i32[96] : vector<16xi32>, view<144xi32>
  vector.store<volatile> %sentinel, %destination_i32[112] : vector<16xi32>, view<144xi32>
  vector.store<volatile> %sentinel, %destination_i32[128] : vector<16xi32>, view<144xi32>
  %integers = vector.load %source_i32[0] : view<64xi32> -> vector<17xi32>
  %unsigned = vector.extui %integers : vector<17xi32> to vector<17xi64>
  %signed = vector.extsi %integers : vector<17xi32> to vector<17xi64>
  vector.store %unsigned, %destination_i64[0] : vector<17xi64>, view<72xi64>
  vector.store %signed, %destination_i64[24] : vector<17xi64>, view<72xi64>
  %values = vector.load %source_f32[24] : view<64xf32> -> vector<9xf32>
  %thresholds = vector.load %source_f32[48] : view<64xf32> -> vector<3xf32>
  %quantized = vector.table.quantize %values, %thresholds {nan = zero, tie = lower} : vector<9xf32>, vector<3xf32> -> vector<9xi64>
  vector.store %quantized, %destination_i64[48] : vector<9xi64>, view<72xi64>
  kernel.return
}

global.rodata.def @widening_integer_patterns = align(4) bytes("0000000001000000ffffff7f00000080ffffffff785634122143658700000040000000c0")

global.rodata.def @widening_float_patterns = align(4) bytes("000080ff000080bf000000bf0000003f0000803f0000a0400000c0400000c07f0000807f")

func.def @generate_partial_widening(%trial: index, %input: buffer) {
  %record = index.assume %trial [range(%trial, 0, 15)] : index
  %origin = index.constant 0 : offset
  %integer_table = global.load @widening_integer_patterns : buffer
  %float_table = global.load @widening_float_patterns : buffer
  %integers = buffer.view %integer_table[%origin] : buffer -> view<9xi32>
  %floats = buffer.view %float_table[%origin] : buffer -> view<9xi32>
  %destination = buffer.view %input[%origin] : buffer -> view<64xi32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c9 = index.constant 9 : index
  %c17 = index.constant 17 : index
  %c24 = index.constant 24 : index
  scf.for %i = [%c0 to %c17 step %c1] {
    %sum = index.add %record, %i : index
    %position = index.rem %sum, %c9 : index
    %value = view.load %integers[%position] : view<9xi32> -> i32
    view.store %value, %destination[%i] : i32, view<64xi32>
  }
  scf.for %i = [%c0 to %c9 step %c1] {
    %sum = index.add %record, %i : index
    %position = index.rem %sum, %c9 : index
    %value = view.load %floats[%position] : view<9xi32> -> i32
    %output_position = index.add %i, %c24 : index
    view.store %value, %destination[%output_position] : i32, view<64xi32>
  }
  %thresholds = buffer.view %input[%origin] : buffer -> view<64xf32>
  %low = scalar.constant -1.0 : f32
  %middle = scalar.constant 0.5 : f32
  %high = scalar.constant 5.0 : f32
  view.store %low, %thresholds[48] : f32, view<64xf32>
  view.store %middle, %thresholds[49] : f32, view<64xf32>
  view.store %high, %thresholds[50] : f32, view<64xf32>
  func.return
}

// Scalar extension and ordered comparisons independently specify the vector
// results. NaNs compare false against every threshold, and ties stay below it.
func.def @partial_widening_oracle(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %integers = buffer.view %input[%origin] : buffer -> view<64xi32>
  %floats = buffer.view %input[%origin] : buffer -> view<64xf32>
  %words = buffer.view %output[%origin] : buffer -> view<144xi32>
  %results = buffer.view %output[%origin] : buffer -> view<72xi64>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c3 = index.constant 3 : index
  %c9 = index.constant 9 : index
  %c17 = index.constant 17 : index
  %c24 = index.constant 24 : index
  %c48 = index.constant 48 : index
  %c144 = index.constant 144 : index
  %guard = scalar.constant -1515870811 : i32
  %c0_i64 = scalar.constant 0 : i64
  scf.for %i = [%c0 to %c144 step %c1] {
    view.store %guard, %words[%i] : i32, view<144xi32>
  }
  scf.for %i = [%c0 to %c17 step %c1] {
    %value = view.load %integers[%i] : view<64xi32> -> i32
    %unsigned = scalar.extui %value : i32 to i64
    %signed = scalar.extsi %value : i32 to i64
    %signed_position = index.add %i, %c24 : index
    view.store %unsigned, %results[%i] : i64, view<72xi64>
    view.store %signed, %results[%signed_position] : i64, view<72xi64>
  }
  scf.for %i = [%c0 to %c9 step %c1] {
    %value_position = index.add %i, %c24 : index
    %value = view.load %floats[%value_position] : view<64xf32> -> f32
    %quantized = scf.for %j = [%c0 to %c3 step %c1](%count = %c0_i64 : i64) -> (i64) {
      %threshold_position = index.add %j, %c48 : index
      %threshold = view.load %floats[%threshold_position] : view<64xf32> -> f32
      %above = scalar.cmpf ogt, %value, %threshold : f32
      %increment = scalar.extui %above : i1 to i64
      %next = scalar.addi %count, %increment : i64
      scf.yield %next : i64
    }
    %position = index.add %i, %c48 : index
    view.store %quantized, %results[%position] : i64, view<72xi64>
  }
  func.return
}

check.scenario @partial_widening_values {
  check.trial[16](%trial: index, %entropy: check.entropy) {
    %input_storage = check.generate.fill value(-91) : tensor<384xi8>
    %input = check.tensor.view %input_storage offset(64) : tensor<384xi8> -> tensor<256xi8>
    check.generate<@generate_partial_widening>(%trial, %input) : (index, tensor<256xi8>) -> ()
    %output_storage = check.generate.fill value(-52) : tensor<704xi8>
    %output = check.tensor.view %output_storage offset(64) : tensor<704xi8> -> tensor<576xi8>
    check.compare<@partial_widening, @partial_widening_oracle>(%input, %output) : (tensor<256xi8>, tensor<576xi8>) -> () {
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<384xi8>
      check.expect.bitwise actual(%output_storage) expected(%output_storage) : tensor<704xi8>
    }
  }
  check.return
}
