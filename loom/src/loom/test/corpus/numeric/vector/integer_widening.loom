}

check.scenario @vector_widen_i8_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-128) step(17) : tensor<16xi8>
    %storage = check.generate.fill value(-123) : tensor<40xi64>
    %output = check.tensor.view %storage offset(32) : tensor<40xi64> -> tensor<32xi64>
    check.compare<@vector_widen_i8, @vector_widen_i8_oracle>(%input, %output) : (tensor<16xi8>, tensor<32xi64>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<16xi8>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<40xi64>
    }
  }
  check.trial[64](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-128 to 127) : tensor<16xi8>
    %storage = check.generate.fill value(-123) : tensor<40xi64>
    %output = check.tensor.view %storage offset(32) : tensor<40xi64> -> tensor<32xi64>
    check.compare<@vector_widen_i8, @vector_widen_i8_oracle>(%input, %output) : (tensor<16xi8>, tensor<32xi64>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<16xi8>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<40xi64>
    }
  }
  check.return
}

