func.def @vector_widen_i8_oracle(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<16xi8>
  %output_view = buffer.view %output[%base] : buffer -> view<32xi64>
  %begin = index.constant 0 : index
  %end = index.constant 16 : index
  %step = index.constant 1 : index
  scf.for %lane = [%begin to %end step %step] {
    %value = view.load %input_view[%lane] : view<16xi8> -> i8
    %unsigned = scalar.extui %value : i8 to i64
    %signed = scalar.extsi %value : i8 to i64
    %signed_lane = index.add %lane, %end : index
    view.store %unsigned, %output_view[%lane] : i64, view<32xi64>
    view.store %signed, %output_view[%signed_lane] : i64, view<32xi64>
  }
  func.return
}

