func.def @vector_widen_i8_oracle(%storage: buffer) {
  %base = index.constant 0 : offset
  %output_base = index.constant 64 : offset
  %input_view = buffer.view %storage[%base] : buffer -> view<1xi8>
  %output_view = buffer.view %storage[%output_base] : buffer -> view<4xi64>
  %value = view.load %input_view[0] : view<1xi8> -> i8
  %c1 = scalar.constant 1 : i8
  %next = scalar.addi %value, %c1 : i8
  %unsigned_0 = scalar.extui %value : i8 to i64
  %unsigned_8 = scalar.extui %next : i8 to i64
  %signed_0 = scalar.extsi %value : i8 to i64
  %signed_8 = scalar.extsi %next : i8 to i64
  view.store %unsigned_0, %output_view[0] : i64, view<4xi64>
  view.store %unsigned_8, %output_view[1] : i64, view<4xi64>
  view.store %signed_0, %output_view[2] : i64, view<4xi64>
  view.store %signed_8, %output_view[3] : i64, view<4xi64>
  func.return
}

