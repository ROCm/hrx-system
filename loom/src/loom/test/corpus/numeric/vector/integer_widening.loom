// Narrow lanes widen with independent signed and unsigned interpretations.
// Scalar observations straddle each physical result-packet boundary.
kernel.def @vector_widen_i8() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%storage: buffer) {
  %base = index.constant 0 : offset
  %output_base = index.constant 64 : offset
  %input_view = buffer.view %storage[%base] : buffer -> view<1xi8>
  %output_view = buffer.view %storage[%output_base] : buffer -> view<8xi32>
  %value = view.load %input_view[0] : view<1xi8> -> i8
  %c0 = scalar.constant 0 : i8
  %c1 = scalar.constant 1 : i8
  %base_values = vector.splat %value : vector<16xi8>
  %low_offsets = vector.splat %c0 : vector<8xi8>
  %high_offsets = vector.splat %c1 : vector<8xi8>
  %offsets = vector.concat<0> %low_offsets, %high_offsets : vector<8xi8>, vector<8xi8> -> vector<16xi8>
  %source = vector.addi %base_values, %offsets : vector<16xi8>
  %unsigned = vector.extui %source : vector<16xi8> to vector<16xi64>
  %unsigned_bits = vector.bitcast %unsigned : vector<16xi64> to vector<32xi32>
  %unsigned_0_low = vector.extract %unsigned_bits[0] : vector<32xi32> -> i32
  %unsigned_0_high = vector.extract %unsigned_bits[1] : vector<32xi32> -> i32
  %unsigned_8_low = vector.extract %unsigned_bits[16] : vector<32xi32> -> i32
  %unsigned_8_high = vector.extract %unsigned_bits[17] : vector<32xi32> -> i32
  view.store %unsigned_0_low, %output_view[0] : i32, view<8xi32>
  view.store %unsigned_0_high, %output_view[1] : i32, view<8xi32>
  view.store %unsigned_8_low, %output_view[2] : i32, view<8xi32>
  view.store %unsigned_8_high, %output_view[3] : i32, view<8xi32>
  %signed = vector.extsi %source : vector<16xi8> to vector<16xi64>
  %signed_bits = vector.bitcast %signed : vector<16xi64> to vector<32xi32>
  %signed_0_low = vector.extract %signed_bits[0] : vector<32xi32> -> i32
  %signed_0_high = vector.extract %signed_bits[1] : vector<32xi32> -> i32
  %signed_8_low = vector.extract %signed_bits[16] : vector<32xi32> -> i32
  %signed_8_high = vector.extract %signed_bits[17] : vector<32xi32> -> i32
  view.store %signed_0_low, %output_view[4] : i32, view<8xi32>
  view.store %signed_0_high, %output_view[5] : i32, view<8xi32>
  view.store %signed_8_low, %output_view[6] : i32, view<8xi32>
  view.store %signed_8_high, %output_view[7] : i32, view<8xi32>
  kernel.return
}

kernel.def @vector_widen_i8_to_i16() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%storage: buffer) {
  %base = index.constant 0 : offset
  %output_base = index.constant 64 : offset
  %input_view = buffer.view %storage[%base] : buffer -> view<1xi8>
  %output_view = buffer.view %storage[%output_base] : buffer -> view<4xi16>
  %value = view.load %input_view[0] : view<1xi8> -> i8
  %c0 = scalar.constant 0 : i8
  %c1 = scalar.constant 1 : i8
  %base_values = vector.splat %value : vector<64xi8>
  %low_offsets = vector.splat %c0 : vector<32xi8>
  %high_offsets = vector.splat %c1 : vector<32xi8>
  %offsets = vector.concat<0> %low_offsets, %high_offsets : vector<32xi8>, vector<32xi8> -> vector<64xi8>
  %source = vector.addi %base_values, %offsets : vector<64xi8>
  %unsigned = vector.extui %source : vector<64xi8> to vector<64xi16>
  %unsigned_0 = vector.extract %unsigned[0] : vector<64xi16> -> i16
  %unsigned_32 = vector.extract %unsigned[32] : vector<64xi16> -> i16
  view.store %unsigned_0, %output_view[0] : i16, view<4xi16>
  view.store %unsigned_32, %output_view[1] : i16, view<4xi16>
  %signed = vector.extsi %source : vector<64xi8> to vector<64xi16>
  %signed_0 = vector.extract %signed[0] : vector<64xi16> -> i16
  %signed_32 = vector.extract %signed[32] : vector<64xi16> -> i16
  view.store %signed_0, %output_view[2] : i16, view<4xi16>
  view.store %signed_32, %output_view[3] : i16, view<4xi16>
  kernel.return
}

