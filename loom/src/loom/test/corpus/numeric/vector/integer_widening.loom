check.scenario @vector_widen_i8_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %storage = check.generate.fill value(-128) : tensor<96xi8>
    check.compare<@vector_widen_i8, @vector_widen_i8_oracle>(%storage) : (tensor<96xi8>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<96xi8>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %storage = check.generate.fill value(-1) : tensor<96xi8>
    check.compare<@vector_widen_i8, @vector_widen_i8_oracle>(%storage) : (tensor<96xi8>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<96xi8>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %storage = check.generate.fill value(0) : tensor<96xi8>
    check.compare<@vector_widen_i8, @vector_widen_i8_oracle>(%storage) : (tensor<96xi8>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<96xi8>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %storage = check.generate.fill value(127) : tensor<96xi8>
    check.compare<@vector_widen_i8, @vector_widen_i8_oracle>(%storage) : (tensor<96xi8>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<96xi8>
    }
  }
  check.return
}

