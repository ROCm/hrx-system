// Narrow lanes widen with independent signed and unsigned interpretations.
// Directed inputs span both endpoints; entropy supplies arbitrary lane payloads.
kernel.def @vector_widen_i8() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %signed_base = index.constant 128 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<16xi8>
  %unsigned_view = buffer.view %output[%base] : buffer -> view<16xi64>
  %signed_view = buffer.view %output[%signed_base] : buffer -> view<16xi64>
  %packed = vector.load %input_view[0] : view<16xi8> -> vector<16xi8>
  %unsigned = vector.extui %packed : vector<16xi8> to vector<16xi64>
  %signed = vector.extsi %packed : vector<16xi8> to vector<16xi64>
  vector.store %unsigned, %unsigned_view[0] : vector<16xi64>, view<16xi64>
  vector.store %signed, %signed_view[0] : vector<16xi64>, view<16xi64>
  kernel.return
}

