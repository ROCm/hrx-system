    %value = view.load %input_view[%lane] : view<16xi16> -> i16
    %unsigned = scalar.extui %value : i16 to i64
    %signed = scalar.extsi %value : i16 to i64
    %signed_lane = index.add %lane, %end : index
    view.store %unsigned, %output_view[%lane] : i64, view<32xi64>
