  %signed = vector.extsi %source : vector<16xi16> to vector<16xi64>
  %signed_bits = vector.bitcast %signed : vector<16xi64> to vector<32xi32>
  %signed_0_low = vector.extract %signed_bits[0] : vector<32xi32> -> i32
  %signed_0_high = vector.extract %signed_bits[1] : vector<32xi32> -> i32
  %signed_8_low = vector.extract %signed_bits[16] : vector<32xi32> -> i32
  %signed_8_high = vector.extract %signed_bits[17] : vector<32xi32> -> i32
  view.store %signed_0_low, %output_view[4] : i32, view<8xi32>
  view.store %signed_0_high, %output_view[5] : i32, view<8xi32>
  view.store %signed_8_low, %output_view[6] : i32, view<8xi32>
  view.store %signed_8_high, %output_view[7] : i32, view<8xi32>
