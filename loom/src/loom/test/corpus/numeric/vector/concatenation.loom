// Disjoint destination intervals preserve padding between every packet size.
func.def @join_packets(%low: buffer, %high: buffer, %output: buffer) {
  %stable_low, %destination = buffer.assume.noalias %low, %output : buffer, buffer
  %base = index.constant 0 : offset
  %offset0 = index.constant 0 : offset
  %low_view0 = buffer.view %stable_low[%base] : buffer -> view<1xi8>
  %high_view0 = buffer.view %high[%base] : buffer -> view<1xi8>
  %output_view0 = buffer.view %destination[%offset0] : buffer -> view<2xi8>
  %low0 = vector.load %low_view0[0] : view<1xi8> -> vector<1xi8>
  %high0 = vector.load %high_view0[0] : view<1xi8> -> vector<1xi8>
  %joined0 = vector.concat<0> %low0, %high0 : vector<1xi8>, vector<1xi8> -> vector<2xi8>
  vector.store %joined0, %output_view0[0] : vector<2xi8>, view<2xi8>
  %offset1 = index.constant 64 : offset
  %low_view1 = buffer.view %stable_low[%base] : buffer -> view<1xi16>
  %high_view1 = buffer.view %high[%base] : buffer -> view<1xi16>
  %output_view1 = buffer.view %destination[%offset1] : buffer -> view<2xi16>
  %low1 = vector.load %low_view1[0] : view<1xi16> -> vector<1xi16>
  %high1 = vector.load %high_view1[0] : view<1xi16> -> vector<1xi16>
  %joined1 = vector.concat<0> %low1, %high1 : vector<1xi16>, vector<1xi16> -> vector<2xi16>
  vector.store %joined1, %output_view1[0] : vector<2xi16>, view<2xi16>
  %offset2 = index.constant 128 : offset
  %low_view2 = buffer.view %stable_low[%base] : buffer -> view<1xi32>
  %high_view2 = buffer.view %high[%base] : buffer -> view<1xi32>
  %output_view2 = buffer.view %destination[%offset2] : buffer -> view<2xi32>
  %low2 = vector.load %low_view2[0] : view<1xi32> -> vector<1xi32>
  %high2 = vector.load %high_view2[0] : view<1xi32> -> vector<1xi32>
  %joined2 = vector.concat<0> %low2, %high2 : vector<1xi32>, vector<1xi32> -> vector<2xi32>
  vector.store %joined2, %output_view2[0] : vector<2xi32>, view<2xi32>
  %offset3 = index.constant 192 : offset
  %low_view3 = buffer.view %stable_low[%base] : buffer -> view<1xi64>
  %high_view3 = buffer.view %high[%base] : buffer -> view<1xi64>
  %output_view3 = buffer.view %destination[%offset3] : buffer -> view<2xi64>
  %low3 = vector.load %low_view3[0] : view<1xi64> -> vector<1xi64>
  %high3 = vector.load %high_view3[0] : view<1xi64> -> vector<1xi64>
  %joined3 = vector.concat<0> %low3, %high3 : vector<1xi64>, vector<1xi64> -> vector<2xi64>
  vector.store %joined3, %output_view3[0] : vector<2xi64>, view<2xi64>
  %offset4 = index.constant 256 : offset
  %low_view4 = buffer.view %stable_low[%base] : buffer -> view<8xf16>
  %high_view4 = buffer.view %high[%base] : buffer -> view<8xf16>
  %output_view4 = buffer.view %destination[%offset4] : buffer -> view<16xf16>
  %low4 = vector.load %low_view4[0] : view<8xf16> -> vector<8xf16>
  %high4 = vector.load %high_view4[0] : view<8xf16> -> vector<8xf16>
  %joined4 = vector.concat<0> %low4, %high4 : vector<8xf16>, vector<8xf16> -> vector<16xf16>
  vector.store %joined4, %output_view4[0] : vector<16xf16>, view<16xf16>
  %offset5 = index.constant 320 : offset
  %low_view5 = buffer.view %stable_low[%base] : buffer -> view<16xbf16>
  %high_view5 = buffer.view %high[%base] : buffer -> view<16xbf16>
  %output_view5 = buffer.view %destination[%offset5] : buffer -> view<32xbf16>
  %low5 = vector.load %low_view5[0] : view<16xbf16> -> vector<16xbf16>
  %high5 = vector.load %high_view5[0] : view<16xbf16> -> vector<16xbf16>
  %joined5 = vector.concat<0> %low5, %high5 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  vector.store %joined5, %output_view5[0] : vector<32xbf16>, view<32xbf16>
  func.return
}

check.scenario @packet_concatenation_values {
  check.trial[8](%trial: index, %entropy: check.entropy) {
    %seed0 = check.entropy.read %entropy[0] : check.entropy -> i64
    %seed1 = check.entropy.read %entropy[1] : check.entropy -> i64
    %low = check.generate.random.uniform seed(%seed0) range(-128 to 127) : tensor<32xi8>
    %high = check.generate.random.uniform seed(%seed1) range(-128 to 127) : tensor<32xi8>
    %expected_low = check.generate.random.uniform seed(%seed0) range(-128 to 127) : tensor<32xi8>
    %expected_high = check.generate.random.uniform seed(%seed1) range(-128 to 127) : tensor<32xi8>
    %storage = check.generate.fill value(85) : tensor<416xi8>
    %output = check.tensor.view %storage offset(16) : tensor<416xi8> -> tensor<384xi8>
    check.compare<@join_packets>(%low, %high, %output) : (tensor<32xi8>, tensor<32xi8>, tensor<384xi8>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<416xi8>
      check.expect.bitwise actual(%low) expected(%expected_low) : tensor<32xi8>
      check.expect.bitwise actual(%high) expected(%expected_high) : tensor<32xi8>
    }
  }
  check.return
}

// Both inputs survive nested joins, including a repeated input in either width.
func.def @join_live_packets(%low: buffer, %high: buffer, %mask_bits: i64, %output: buffer) {
  %mask = scalar.trunci %mask_bits : i64 to i8
  %origin = index.constant 0 : offset
  %low_view = buffer.view %low[%origin] : buffer -> view<16xi8>
  %high_view = buffer.view %high[%origin] : buffer -> view<16xi8>
  %destination = buffer.view %output[%origin] : buffer -> view<256xi8>
  %left = vector.load %low_view[0] : view<16xi8> -> vector<16xi8>
  %right = vector.load %high_view[0] : view<16xi8> -> vector<16xi8>
  %mask32 = vector.splat %mask : vector<32xi8>
  %mask64 = vector.splat %mask : vector<64xi8>
  %joined = vector.concat<0> %left, %right : vector<16xi8>, vector<16xi8> -> vector<32xi8>
  %reversed = vector.concat<0> %right, %left : vector<16xi8>, vector<16xi8> -> vector<32xi8>
  %wide = vector.concat<0> %joined, %reversed : vector<32xi8>, vector<32xi8> -> vector<64xi8>
  %mixed_wide = vector.xori %wide, %mask64 : vector<64xi8>
  vector.store %mixed_wide, %destination[0] : vector<64xi8>, view<256xi8>
  %repeated = vector.concat<0> %joined, %joined : vector<32xi8>, vector<32xi8> -> vector<64xi8>
  %mixed_repeated = vector.xori %repeated, %mask64 : vector<64xi8>
  vector.store %mixed_repeated, %destination[64] : vector<64xi8>, view<256xi8>
  %reused = vector.concat<0> %reversed, %joined : vector<32xi8>, vector<32xi8> -> vector<64xi8>
  %mixed_reused = vector.xori %reused, %mask64 : vector<64xi8>
  vector.store %mixed_reused, %destination[128] : vector<64xi8>, view<256xi8>
  %duplicate = vector.concat<0> %left, %left : vector<16xi8>, vector<16xi8> -> vector<32xi8>
  %mixed_duplicate = vector.xori %duplicate, %mask32 : vector<32xi8>
  vector.store %mixed_duplicate, %destination[192] : vector<32xi8>, view<256xi8>
  vector.store %left, %destination[224] : vector<16xi8>, view<256xi8>
  vector.store %right, %destination[240] : vector<16xi8>, view<256xi8>
  func.return
}

// Scalar byte copies independently describe every destination interval.
func.def @join_live_packets_oracle(%low: buffer, %high: buffer, %mask_bits: i64, %output: buffer) {
  %mask = scalar.trunci %mask_bits : i64 to i8
  %origin = index.constant 0 : offset
  %low_view = buffer.view %low[%origin] : buffer -> view<16xi8>
  %high_view = buffer.view %high[%origin] : buffer -> view<16xi8>
  %destination = buffer.view %output[%origin] : buffer -> view<16x16xi8>
  %begin = index.constant 0 : index
  %end = index.constant 16 : index
  %step = index.constant 1 : index
  scf.for %lane = [%begin to %end step %step] {
    %raw_left = view.load %low_view[%lane] : view<16xi8> -> i8
    %raw_right = view.load %high_view[%lane] : view<16xi8> -> i8
    %left = scalar.xori %raw_left, %mask : i8
    %right = scalar.xori %raw_right, %mask : i8
    view.store %left, %destination[0, %lane] : i8, view<16x16xi8>
    view.store %right, %destination[1, %lane] : i8, view<16x16xi8>
    view.store %right, %destination[2, %lane] : i8, view<16x16xi8>
    view.store %left, %destination[3, %lane] : i8, view<16x16xi8>
    view.store %left, %destination[4, %lane] : i8, view<16x16xi8>
    view.store %right, %destination[5, %lane] : i8, view<16x16xi8>
    view.store %left, %destination[6, %lane] : i8, view<16x16xi8>
    view.store %right, %destination[7, %lane] : i8, view<16x16xi8>
    view.store %right, %destination[8, %lane] : i8, view<16x16xi8>
    view.store %left, %destination[9, %lane] : i8, view<16x16xi8>
    view.store %left, %destination[10, %lane] : i8, view<16x16xi8>
    view.store %right, %destination[11, %lane] : i8, view<16x16xi8>
    view.store %left, %destination[12, %lane] : i8, view<16x16xi8>
    view.store %left, %destination[13, %lane] : i8, view<16x16xi8>
    view.store %raw_left, %destination[14, %lane] : i8, view<16x16xi8>
    view.store %raw_right, %destination[15, %lane] : i8, view<16x16xi8>
  }
  func.return
}

check.scenario @live_packet_concatenation_values {
  check.trial[8](%trial: index, %entropy: check.entropy) {
    %seed0 = check.entropy.read %entropy[0] : check.entropy -> i64
    %seed1 = check.entropy.read %entropy[1] : check.entropy -> i64
    %low = check.generate.random.uniform seed(%seed0) range(-128 to 127) : tensor<16xi8>
    %high = check.generate.random.uniform seed(%seed1) range(-128 to 127) : tensor<16xi8>
    %expected_low = check.generate.random.uniform seed(%seed0) range(-128 to 127) : tensor<16xi8>
    %expected_high = check.generate.random.uniform seed(%seed1) range(-128 to 127) : tensor<16xi8>
    %storage = check.generate.fill value(85) : tensor<288xi8>
    %output = check.tensor.view %storage offset(16) : tensor<288xi8> -> tensor<256xi8>
    check.compare<@join_live_packets, @join_live_packets_oracle>(%low, %high, %seed0, %output) : (tensor<16xi8>, tensor<16xi8>, i64, tensor<256xi8>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<288xi8>
      check.expect.bitwise actual(%low) expected(%expected_low) : tensor<16xi8>
      check.expect.bitwise actual(%high) expected(%expected_high) : tensor<16xi8>
    }
  }
  check.return
}
