func.def @integer_extrema_reductions_i64x9(%storage_buffer: buffer) {
  %output_origin = index.constant 0 : offset
  %output_view = buffer.view %storage_buffer[%output_origin] : buffer -> view<4xi64>
  %negative = scalar.constant -1 : i64
  %c0 = scalar.constant 0 : i64
  %negative_values = vector.splat %negative : vector<9xi64>
  %input = vector.insert %c0 into %negative_values[0] : i64, vector<9xi64>
  %initial = scalar.constant 1 : i64
  %signed_minimum = vector.reduce<minsi> %input, %initial : vector<9xi64>, i64
  view.store %signed_minimum, %output_view[0] : i64, view<4xi64>
  %signed_maximum = vector.reduce<maxsi> %input, %initial : vector<9xi64>, i64
  view.store %signed_maximum, %output_view[1] : i64, view<4xi64>
  %unsigned_maximum = vector.reduce<maxui> %input, %initial : vector<9xi64>, i64
