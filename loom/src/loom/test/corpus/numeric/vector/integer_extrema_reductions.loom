check.scenario @integer_extrema_reduction_boundaries {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %storage = check.generate.fill value(42) : tensor<64xi8>
    %signed = check.tensor.view %storage offset(0) : tensor<64xi8> -> tensor<2xi8>
    %unsigned_maximum = check.tensor.view %storage offset(2) : tensor<64xi8> -> tensor<1xi8>
    %unsigned_minimum = check.tensor.view %storage offset(3) : tensor<64xi8> -> tensor<1xi8>
    %expected_signed = check.generate.iota offset(-1) step(2) : tensor<2xi8>
    %expected_unsigned_maximum = check.generate.fill value(-1) : tensor<1xi8>
    %expected_unsigned_minimum = check.generate.fill value(0) : tensor<1xi8>
    check.compare<@integer_extrema_reductions_i8x33>(%storage) : (tensor<64xi8>) -> () {
      check.expect.bitwise actual(%signed) expected(%expected_signed) : tensor<2xi8>
      check.expect.bitwise actual(%unsigned_maximum) expected(%expected_unsigned_maximum) : tensor<1xi8>
      check.expect.bitwise actual(%unsigned_minimum) expected(%expected_unsigned_minimum) : tensor<1xi8>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %storage = check.generate.fill value(42) : tensor<32xi16>
    %signed = check.tensor.view %storage offset(0) : tensor<32xi16> -> tensor<2xi16>
    %unsigned_maximum = check.tensor.view %storage offset(4) : tensor<32xi16> -> tensor<1xi16>
    %unsigned_minimum = check.tensor.view %storage offset(6) : tensor<32xi16> -> tensor<1xi16>
    %expected_signed = check.generate.iota offset(-1) step(2) : tensor<2xi16>
    %expected_unsigned_maximum = check.generate.fill value(-1) : tensor<1xi16>
    %expected_unsigned_minimum = check.generate.fill value(0) : tensor<1xi16>
    check.compare<@integer_extrema_reductions_i16x33>(%storage) : (tensor<32xi16>) -> () {
      check.expect.bitwise actual(%signed) expected(%expected_signed) : tensor<2xi16>
      check.expect.bitwise actual(%unsigned_maximum) expected(%expected_unsigned_maximum) : tensor<1xi16>
      check.expect.bitwise actual(%unsigned_minimum) expected(%expected_unsigned_minimum) : tensor<1xi16>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %storage = check.generate.fill value(42) : tensor<16xi32>
    %signed = check.tensor.view %storage offset(0) : tensor<16xi32> -> tensor<2xi32>
    %unsigned_maximum = check.tensor.view %storage offset(8) : tensor<16xi32> -> tensor<1xi32>
    %unsigned_minimum = check.tensor.view %storage offset(12) : tensor<16xi32> -> tensor<1xi32>
    %expected_signed = check.generate.iota offset(-1) step(2) : tensor<2xi32>
    %expected_unsigned_maximum = check.generate.fill value(-1) : tensor<1xi32>
    %expected_unsigned_minimum = check.generate.fill value(0) : tensor<1xi32>
    check.compare<@integer_extrema_reductions_i32x3>(%storage) : (tensor<16xi32>) -> () {
      check.expect.bitwise actual(%signed) expected(%expected_signed) : tensor<2xi32>
      check.expect.bitwise actual(%unsigned_maximum) expected(%expected_unsigned_maximum) : tensor<1xi32>
      check.expect.bitwise actual(%unsigned_minimum) expected(%expected_unsigned_minimum) : tensor<1xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %storage = check.generate.fill value(42) : tensor<8xi64>
    %signed = check.tensor.view %storage offset(0) : tensor<8xi64> -> tensor<2xi64>
    %unsigned_maximum = check.tensor.view %storage offset(16) : tensor<8xi64> -> tensor<1xi64>
    %unsigned_minimum = check.tensor.view %storage offset(24) : tensor<8xi64> -> tensor<1xi64>
    %expected_signed = check.generate.iota offset(-1) step(2) : tensor<2xi64>
    %expected_unsigned_maximum = check.generate.fill value(-1) : tensor<1xi64>
    %expected_unsigned_minimum = check.generate.fill value(0) : tensor<1xi64>
    check.compare<@integer_extrema_reductions_i64x9>(%storage) : (tensor<8xi64>) -> () {
      check.expect.bitwise actual(%signed) expected(%expected_signed) : tensor<2xi64>
      check.expect.bitwise actual(%unsigned_maximum) expected(%expected_unsigned_maximum) : tensor<1xi64>
      check.expect.bitwise actual(%unsigned_minimum) expected(%expected_unsigned_minimum) : tensor<1xi64>
    }
  }
  check.return
}
