  %oeq_words = vector.extui %oeq : vector<4xi1> to vector<4xi32>
  vector.store %oeq_words, %results[0] : vector<4xi32>, view<56xi32>
  %ogt = vector.cmpf ogt, %lhs, %rhs : vector<4xf64> -> vector<4xi1>
  %ogt_words = vector.extui %ogt : vector<4xi1> to vector<4xi32>
  vector.store %ogt_words, %results[4] : vector<4xi32>, view<56xi32>
  %oge = vector.cmpf oge, %lhs, %rhs : vector<4xf64> -> vector<4xi1>
  %oge_words = vector.extui %oge : vector<4xi1> to vector<4xi32>
  vector.store %oge_words, %results[8] : vector<4xi32>, view<56xi32>
  %olt = vector.cmpf olt, %lhs, %rhs : vector<4xf64> -> vector<4xi1>
  %olt_words = vector.extui %olt : vector<4xi1> to vector<4xi32>
  vector.store %olt_words, %results[12] : vector<4xi32>, view<56xi32>
  %ole = vector.cmpf ole, %lhs, %rhs : vector<4xf64> -> vector<4xi1>
  %ole_words = vector.extui %ole : vector<4xi1> to vector<4xi32>
  vector.store %ole_words, %results[16] : vector<4xi32>, view<56xi32>
  %one = vector.cmpf one, %lhs, %rhs : vector<4xf64> -> vector<4xi1>
  %one_words = vector.extui %one : vector<4xi1> to vector<4xi32>
  vector.store %one_words, %results[20] : vector<4xi32>, view<56xi32>
  %ord = vector.cmpf ord, %lhs, %rhs : vector<4xf64> -> vector<4xi1>
  %ord_words = vector.extui %ord : vector<4xi1> to vector<4xi32>
  vector.store %ord_words, %results[24] : vector<4xi32>, view<56xi32>
  %ueq = vector.cmpf ueq, %lhs, %rhs : vector<4xf64> -> vector<4xi1>
  %ueq_words = vector.extui %ueq : vector<4xi1> to vector<4xi32>
  vector.store %ueq_words, %results[28] : vector<4xi32>, view<56xi32>
  %ugt = vector.cmpf ugt, %lhs, %rhs : vector<4xf64> -> vector<4xi1>
  %ugt_words = vector.extui %ugt : vector<4xi1> to vector<4xi32>
  vector.store %ugt_words, %results[32] : vector<4xi32>, view<56xi32>
  %uge = vector.cmpf uge, %lhs, %rhs : vector<4xf64> -> vector<4xi1>
  %uge_words = vector.extui %uge : vector<4xi1> to vector<4xi32>
  vector.store %uge_words, %results[36] : vector<4xi32>, view<56xi32>
  %ult = vector.cmpf ult, %lhs, %rhs : vector<4xf64> -> vector<4xi1>
  %ult_words = vector.extui %ult : vector<4xi1> to vector<4xi32>
  vector.store %ult_words, %results[40] : vector<4xi32>, view<56xi32>
  %ule = vector.cmpf ule, %lhs, %rhs : vector<4xf64> -> vector<4xi1>
  %ule_words = vector.extui %ule : vector<4xi1> to vector<4xi32>
  vector.store %ule_words, %results[44] : vector<4xi32>, view<56xi32>
  %une = vector.cmpf une, %lhs, %rhs : vector<4xf64> -> vector<4xi1>
  %une_words = vector.extui %une : vector<4xi1> to vector<4xi32>
  vector.store %une_words, %results[48] : vector<4xi32>, view<56xi32>
  %uno = vector.cmpf uno, %lhs, %rhs : vector<4xf64> -> vector<4xi1>
  %uno_words = vector.extui %uno : vector<4xi1> to vector<4xi32>
  vector.store %uno_words, %results[52] : vector<4xi32>, view<56xi32>
  func.return
}

// Only the element widths change the packet boundary. The last lane of the
// 512-bit packet and the first tail lane deliberately have opposite results.
func.def @vector_float_comparison_packet_boundaries(%output: buffer) {
  %base = index.constant 0 : offset
  %results = buffer.view %output[%base] : buffer -> view<8xi32>

  %f8_low = scalar.constant 0.0 : f8E4M3
  %f8_high = scalar.constant 2.0 : f8E4M3
  %f8_limit = scalar.constant 1.0 : f8E4M3
  %f8_lhs_base = vector.splat %f8_low : vector<65xf8E4M3>
  %f8_lhs = vector.insert %f8_high into %f8_lhs_base[64] : f8E4M3, vector<65xf8E4M3>
  %f8_rhs = vector.splat %f8_limit : vector<65xf8E4M3>
  %f8_mask = vector.cmpf olt, %f8_lhs, %f8_rhs : vector<65xf8E4M3> -> vector<65xi1>
  %f8_before = vector.extract %f8_mask[63] : vector<65xi1> -> i1
  %f8_after = vector.extract %f8_mask[64] : vector<65xi1> -> i1
  %f8_before_word = scalar.extui %f8_before : i1 to i32
  %f8_after_word = scalar.extui %f8_after : i1 to i32
  view.store %f8_before_word, %results[0] : i32, view<8xi32>
  view.store %f8_after_word, %results[1] : i32, view<8xi32>

  %f16_low = scalar.constant 0.0 : f16
  %f16_high = scalar.constant 2.0 : f16
  %f16_limit = scalar.constant 1.0 : f16
  %f16_lhs_base = vector.splat %f16_low : vector<33xf16>
  %f16_lhs = vector.insert %f16_high into %f16_lhs_base[32] : f16, vector<33xf16>
  %f16_rhs = vector.splat %f16_limit : vector<33xf16>
  %f16_mask = vector.cmpf ogt, %f16_lhs, %f16_rhs : vector<33xf16> -> vector<33xi1>
  %f16_before = vector.extract %f16_mask[31] : vector<33xi1> -> i1
  %f16_after = vector.extract %f16_mask[32] : vector<33xi1> -> i1
  %f16_before_word = scalar.extui %f16_before : i1 to i32
  %f16_after_word = scalar.extui %f16_after : i1 to i32
  view.store %f16_before_word, %results[2] : i32, view<8xi32>
  view.store %f16_after_word, %results[3] : i32, view<8xi32>

  %f32_low = scalar.constant 0.0 : f32
  %f32_high = scalar.constant 2.0 : f32
  %f32_limit = scalar.constant 1.0 : f32
  %f32_lhs_base = vector.splat %f32_low : vector<17xf32>
  %f32_lhs = vector.insert %f32_high into %f32_lhs_base[16] : f32, vector<17xf32>
  %f32_rhs = vector.splat %f32_limit : vector<17xf32>
  %f32_mask = vector.cmpf ule, %f32_lhs, %f32_rhs : vector<17xf32> -> vector<17xi1>
  %f32_before = vector.extract %f32_mask[15] : vector<17xi1> -> i1
  %f32_after = vector.extract %f32_mask[16] : vector<17xi1> -> i1
  %f32_before_word = scalar.extui %f32_before : i1 to i32
  %f32_after_word = scalar.extui %f32_after : i1 to i32
  view.store %f32_before_word, %results[4] : i32, view<8xi32>
  view.store %f32_after_word, %results[5] : i32, view<8xi32>

  %f64_low = scalar.constant 0.0 : f64
  %f64_high = scalar.constant 2.0 : f64
  %f64_limit = scalar.constant 1.0 : f64
  %f64_lhs_base = vector.splat %f64_low : vector<9xf64>
  %f64_lhs = vector.insert %f64_high into %f64_lhs_base[8] : f64, vector<9xf64>
  %f64_rhs = vector.splat %f64_limit : vector<9xf64>
  %f64_mask = vector.cmpf uge, %f64_lhs, %f64_rhs : vector<9xf64> -> vector<9xi1>
  %f64_before = vector.extract %f64_mask[7] : vector<9xi1> -> i1
  %f64_after = vector.extract %f64_mask[8] : vector<9xi1> -> i1
  %f64_before_word = scalar.extui %f64_before : i1 to i32
  %f64_after_word = scalar.extui %f64_after : i1 to i32
  view.store %f64_before_word, %results[6] : i32, view<8xi32>
  view.store %f64_after_word, %results[7] : i32, view<8xi32>

  func.return
}

// Compares constant and ordinary buffer inputs in both orders, and compares two
// constant inputs.
func.def @mixed_source_compare_f32(%lhs: buffer, %rhs: buffer, %forward: buffer, %reverse: buffer, %uniform: buffer) {
  %constant_lhs = buffer.assume.memory_space<constant> %lhs : buffer
  %constant_rhs = buffer.assume.memory_space<constant> %rhs : buffer
  func.call @vector_compare_f32(%constant_lhs, %rhs, %forward) : (buffer, buffer, buffer)
  func.call @vector_compare_f32(%rhs, %constant_lhs, %reverse) : (buffer, buffer, buffer)
  func.call @vector_compare_f32(%constant_lhs, %constant_rhs, %uniform) : (buffer, buffer, buffer)
  func.return
}

// Each scenario supplies three four-lane groups: signed zero and
// opposite-sign subnormals, adjacent negatives, and the positive
// maximum-finite/infinity/NaN boundary for its encoding.
check.scenario @vector_float_comparison_f8e4m3_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %lhs = check.generate.iota offset(-128) step(1) : tensor<4xi8>
    %rhs = check.generate.iota offset(0) step(1) : tensor<4xi8>
    %output = check.generate.fill value(1515870810) : tensor<56xi32>
    check.compare<@vector_compare_f8e4m3>(%lhs, %rhs, %output) : (tensor<4xi8>, tensor<4xi8>, tensor<56xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<56xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %lhs = check.generate.iota offset(-72) step(1) : tensor<4xi8>
    %rhs = check.generate.iota offset(-71) step(1) : tensor<4xi8>
    %output = check.generate.fill value(1515870810) : tensor<56xi32>
    check.compare<@vector_compare_f8e4m3>(%lhs, %rhs, %output) : (tensor<4xi8>, tensor<4xi8>, tensor<56xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<56xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %lhs = check.generate.iota offset(124) step(1) : tensor<4xi8>
    %rhs = check.generate.iota offset(127) step(-1) : tensor<4xi8>
    %output = check.generate.fill value(1515870810) : tensor<56xi32>
    check.compare<@vector_compare_f8e4m3>(%lhs, %rhs, %output) : (tensor<4xi8>, tensor<4xi8>, tensor<56xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<56xi32>
    }
  }
  check.return
}

