}

// Every runtime position receives an independent replacement; untouched lanes
// retain distinct payloads. Floating lanes are observed as integer bits.
func.def @dynamic_dword_lane_values(%input: buffer, %positions: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %lane_mask = index.constant 3 : index
  %float_region = index.constant 16 : index
  %source = buffer.view %input[%base] : buffer -> view<8xi32>
  %lane_positions = buffer.view %positions[%base] : buffer -> view<4xi32>
  %destination = buffer.view %output[%base] : buffer -> view<32xi32>
  %integers = vector.load %source[0] : view<8xi32> -> vector<4xi32>
  %floats = vector.bitcast %integers : vector<4xi32> to vector<4xf32>
  scf.for %packet = [%begin to %end step %step] {
    %position = view.load %lane_positions[%packet] : view<4xi32> -> i32
    %lane_index = index.cast %position : i32 to index
    %lane = index.andi %lane_index, %lane_mask : index
    %replacement_index = index.add %packet, %end : index
    %replacement = view.load %source[%replacement_index] : view<8xi32> -> i32
    %replacement_float = scalar.bitcast %replacement : i32 to f32
    %integer_result = vector.insert %replacement into %integers[%lane] : i32, vector<4xi32>
    %float_result = vector.insert %replacement_float into %floats[%lane] : f32, vector<4xf32>
    %float_bits = vector.bitcast %float_result : vector<4xf32> to vector<4xi32>
    %integer_index = index.mul %packet, %end : index
    %float_index = index.add %integer_index, %float_region : index
    vector.store %integer_result, %destination[%integer_index] : vector<4xi32>, view<32xi32>
    vector.store %float_bits, %destination[%float_index] : vector<4xi32>, view<32xi32>
  }
  func.return
}

func.def @dynamic_dword_lane_oracle(%input: buffer, %positions: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 16 : index
  %step = index.constant 1 : index
  %packet_lanes = index.constant 4 : index
  %lane_mask = index.constant 3 : index
  %source = buffer.view %input[%base] : buffer -> view<8xi32>
  %lane_positions = buffer.view %positions[%base] : buffer -> view<4xi32>
  %destination = buffer.view %output[%base] : buffer -> view<32xi32>
  scf.for %i = [%begin to %end step %step] {
    %packet = index.div %i, %packet_lanes : index
    %lane = index.andi %i, %lane_mask : index
    %position = view.load %lane_positions[%packet] : view<4xi32> -> i32
    %lane_index = index.cast %position : i32 to index
    %insertion_lane = index.andi %lane_index, %lane_mask : index
    %is_inserted = index.cmp eq, %lane, %insertion_lane : index
    %replacement_index = index.add %packet, %packet_lanes : index
    %source_index = scf.select %is_inserted, %replacement_index, %lane : index
    %value = view.load %source[%source_index] : view<8xi32> -> i32
    %float_index = index.add %i, %end : index
    view.store %value, %destination[%i] : i32, view<32xi32>
    view.store %value, %destination[%float_index] : i32, view<32xi32>
  }
  func.return
}

check.scenario @dynamic_dword_lane_positions {
  check.trial[32](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-2147483648 to 2147483647) : tensor<8xi32>
    %positions = check.generate.iota offset(0) step(1) : tensor<4xi32>
    %output_owner = check.generate.fill value(123) : tensor<40xi32>
    %output = check.tensor.view %output_owner offset(16) : tensor<40xi32> -> tensor<32xi32>
    check.compare<@dynamic_dword_lane_values, @dynamic_dword_lane_oracle>(%input, %positions, %output) : (tensor<8xi32>, tensor<4xi32>, tensor<32xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<8xi32>
      check.expect.bitwise actual(%positions) expected(%positions) : tensor<4xi32>
      check.expect.bitwise actual(%output_owner) expected(%output_owner) : tensor<40xi32>
    }
  }
  check.return
}

// Five lanes force a native packet plus a singleton tail. Every runtime
// position is replaced while integer, floating, address, and rank-two forms
// retain the same payload bits outside that position.
func.def @dynamic_tail_values(%input: buffer, %positions: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %float_base = index.constant 200 : offset
  %offset_base = index.constant 400 : offset
  %index_base = index.constant 600 : offset
  %matrix_base = index.constant 800 : offset
  %begin = index.constant 0 : index
  %end = index.constant 5 : index
  %step = index.constant 1 : index
  %source = buffer.view %input[%base] : buffer -> view<10xi64>
  %lane_positions = buffer.view %positions[%base] : buffer -> view<5xi32>
  %integer_output = buffer.view %output[%base] : buffer -> view<5x5xi64>
  %float_output = buffer.view %output[%float_base] : buffer -> view<5x5xf64>
  %offset_output = buffer.view %output[%offset_base] : buffer -> view<5x5xi64>
  %index_output = buffer.view %output[%index_base] : buffer -> view<5x5xi64>
  %matrix_output = buffer.view %output[%matrix_base] : buffer -> view<5x5xi64>
  %integers = vector.load %source[0] : view<10xi64> -> vector<5xi64>
  %floats = vector.bitcast %integers : vector<5xi64> to vector<5xf64>
  %address_mask = vector.splati 4294967295 : vector<5xi64>
  %address_bits = vector.andi %integers, %address_mask : vector<5xi64>
  %offsets = vector.index_cast %address_bits : vector<5xi64> to vector<5xoffset>
  %words = vector.trunci %integers : vector<5xi64> to vector<5xi32>
  %indices = vector.index_cast %words : vector<5xi32> to vector<5xindex>
  %matrix = vector.bitcast %integers : vector<5xi64> to vector<1x5xi64>
  scf.for %packet = [%begin to %end step %step] {
    %position = view.load %lane_positions[%packet] : view<5xi32> -> i32
    %coordinate = index.cast %position : i32 to index
    %lane = index.assume %coordinate [range(%coordinate, 0, 4)] : index
    %replacement_index = index.add %packet, %end : index
    %replacement = view.load %source[%replacement_index] : view<10xi64> -> i64
    %replacement_float = scalar.bitcast %replacement : i64 to f64
    %scalar_address_mask = scalar.constant 4294967295 : i64
    %replacement_address = scalar.andi %replacement, %scalar_address_mask : i64
    %replacement_offset = index.cast %replacement_address : i64 to offset
    %replacement_word = scalar.trunci %replacement : i64 to i32
    %replacement_coordinate = index.cast %replacement_word : i32 to index
    %integer_result = vector.insert %replacement into %integers[%lane] : i64, vector<5xi64>
    %float_result = vector.insert %replacement_float into %floats[%lane] : f64, vector<5xf64>
    %offset_result = vector.insert %replacement_offset into %offsets[%lane] : offset, vector<5xoffset>
    %index_result = vector.insert %replacement_coordinate into %indices[%lane] : index, vector<5xindex>
    %matrix_result = vector.insert %replacement into %matrix[0, %lane] : i64, vector<1x5xi64>
    %offset_bits = vector.index_cast %offset_result : vector<5xoffset> to vector<5xi64>
    %index_bits = vector.index_cast %index_result : vector<5xindex> to vector<5xi64>
    %matrix_bits = vector.bitcast %matrix_result : vector<1x5xi64> to vector<5xi64>
    vector.store %integer_result, %integer_output[%packet, 0] : vector<5xi64>, view<5x5xi64>
    vector.store %float_result, %float_output[%packet, 0] : vector<5xf64>, view<5x5xf64>
    vector.store %offset_bits, %offset_output[%packet, 0] : vector<5xi64>, view<5x5xi64>
    vector.store %index_bits, %index_output[%packet, 0] : vector<5xi64>, view<5x5xi64>
    vector.store %matrix_bits, %matrix_output[%packet, 0] : vector<5xi64>, view<5x5xi64>
  }
  func.return
}

func.def @dynamic_tail_oracle(%input: buffer, %positions: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 25 : index
  %step = index.constant 1 : index
  %width = index.constant 5 : index
  %float_base = index.constant 25 : index
  %offset_base = index.constant 50 : index
  %index_base = index.constant 75 : index
  %matrix_base = index.constant 100 : index
  %source = buffer.view %input[%base] : buffer -> view<10xi64>
  %lane_positions = buffer.view %positions[%base] : buffer -> view<5xi32>
  %destination = buffer.view %output[%base] : buffer -> view<125xi64>
  scf.for %i = [%begin to %end step %step] {
    %packet = index.div %i, %width : index
    %lane = index.rem %i, %width : index
    %position = view.load %lane_positions[%packet] : view<5xi32> -> i32
    %coordinate = index.cast %position : i32 to index
    %is_inserted = index.cmp eq, %lane, %coordinate : index
    %replacement_index = index.add %packet, %width : index
    %source_index = scf.select %is_inserted, %replacement_index, %lane : index
    %value = view.load %source[%source_index] : view<10xi64> -> i64
    %address_mask = scalar.constant 4294967295 : i64
    %offset_value = scalar.andi %value, %address_mask : i64
    %word = scalar.trunci %value : i64 to i32
    %index_value = scalar.extsi %word : i32 to i64
    %float_index = index.add %i, %float_base : index
    %offset_index = index.add %i, %offset_base : index
    %index_position = index.add %i, %index_base : index
    %matrix_index = index.add %i, %matrix_base : index
    view.store %value, %destination[%i] : i64, view<125xi64>
    view.store %value, %destination[%float_index] : i64, view<125xi64>
    view.store %offset_value, %destination[%offset_index] : i64, view<125xi64>
    view.store %index_value, %destination[%index_position] : i64, view<125xi64>
    view.store %value, %destination[%matrix_index] : i64, view<125xi64>
  }
  func.return
}

check.scenario @dynamic_tail_positions {
  check.trial[8](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-4611686018427387904 to 4611686018427387903) : tensor<10xi64>
    %positions = check.generate.iota offset(0) step(1) : tensor<5xi32>
    %storage = check.generate.fill value(123) : tensor<129xi64>
    %output = check.tensor.view %storage offset(16) : tensor<129xi64> -> tensor<125xi64>
    check.compare<@dynamic_tail_values, @dynamic_tail_oracle>(%input, %positions, %output) : (tensor<10xi64>, tensor<5xi32>, tensor<125xi64>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<10xi64>
      check.expect.bitwise actual(%positions) expected(%positions) : tensor<5xi32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<129xi64>
    }
  }
  check.return
}

// Runtime positions span full packets and irregular tails. Narrow payloads
// retain their exact bits outside the replaced position.
func.def @wide_tail_insert(%bytes: buffer, %words: buffer, %byte_output: buffer, %word_output: buffer, %position_input: index, %replacement: i64) {
  %origin = index.constant 0 : offset
  %payload_count = index.constant 39 : index
  %position_mask = index.constant 127 : index
  %bounded_position = index.andi %position_input, %position_mask : index
  %payload_position = index.rem %bounded_position, %payload_count : index
  %float_source = buffer.view %bytes[%origin] : buffer -> view<39xf8E4M3>
  %word_source = buffer.view %words[%origin] : buffer -> view<39xi16>
  %float_destination = buffer.view %byte_output[%origin] : buffer -> view<39xf8E4M3>
  %word_destination = buffer.view %word_output[%origin] : buffer -> view<39xi16>
  %byte_replacement = scalar.trunci %replacement : i64 to i8
  %float_replacement = scalar.bitcast %byte_replacement : i8 to f8E4M3
  %word_replacement = scalar.trunci %replacement : i64 to i16
  %floats = vector.load %float_source[0] : view<39xf8E4M3> -> vector<39xf8E4M3>
  %float_result = vector.insert %float_replacement into %floats[%payload_position] : f8E4M3, vector<39xf8E4M3>
  vector.store %float_result, %float_destination[0] : vector<39xf8E4M3>, view<39xf8E4M3>
  %word_values = vector.load %word_source[0] : view<39xi16> -> vector<39xi16>
  %word_result = vector.insert %word_replacement into %word_values[%payload_position] : i16, vector<39xi16>
  vector.store %word_result, %word_destination[0] : vector<39xi16>, view<39xi16>
  func.return
}

func.def @wide_tail_insert_oracle(%bytes: buffer, %words: buffer, %byte_output: buffer, %word_output: buffer, %position_input: index, %replacement: i64) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %payload_count = index.constant 39 : index
  %step = index.constant 1 : index
  %position_mask = index.constant 127 : index
  %bounded_position = index.andi %position_input, %position_mask : index
  %payload_position = index.rem %bounded_position, %payload_count : index
  %byte_source = buffer.view %bytes[%origin] : buffer -> view<39xi8>
  %word_source = buffer.view %words[%origin] : buffer -> view<39xi16>
  %byte_destination = buffer.view %byte_output[%origin] : buffer -> view<39xi8>
  %word_destination = buffer.view %word_output[%origin] : buffer -> view<39xi16>
  %byte_replacement = scalar.trunci %replacement : i64 to i8
  %word_replacement = scalar.trunci %replacement : i64 to i16
  scf.for %lane = [%begin to %payload_count step %step] {
    %is_replaced = index.cmp eq, %lane, %payload_position : index
    %byte_value = view.load %byte_source[%lane] : view<39xi8> -> i8
    %word_value = view.load %word_source[%lane] : view<39xi16> -> i16
    %byte_result = scf.select %is_replaced, %byte_replacement, %byte_value : i8
    %word_result = scf.select %is_replaced, %word_replacement, %word_value : i16
    view.store %byte_result, %byte_destination[%lane] : i8, view<39xi8>
    view.store %word_result, %word_destination[%lane] : i16, view<39xi16>
  }
  func.return
}

// Inserting a predicate changes one mask position while preserving all others.
func.def @wide_predicate_insert(%bytes: buffer, %output: buffer, %position_input: index, %replacement: i64) {
  %origin = index.constant 0 : offset
  %predicate_count = index.constant 40 : index
  %position_mask = index.constant 127 : index
  %bounded_position = index.andi %position_input, %position_mask : index
  %position = index.rem %bounded_position, %predicate_count : index
  %source = buffer.view %bytes[%origin] : buffer -> view<40xi8>
  %destination = buffer.view %output[%origin] : buffer -> view<40xi8>
  %predicate_replacement = scalar.trunci %replacement : i64 to i1
  %byte_values = vector.load %source[0] : view<40xi8> -> vector<40xi8>
  %clear_values = vector.splati 0 : vector<40xi8>
  %predicates = vector.cmpi ne, %byte_values, %clear_values : vector<40xi8> -> vector<40xi1>
  %updated = vector.insert %predicate_replacement into %predicates[%position] : i1, vector<40xi1>
  %result = vector.select %updated, %byte_values, %clear_values : vector<40xi8>
  vector.store %result, %destination[0] : vector<40xi8>, view<40xi8>
  func.return
}

func.def @wide_predicate_insert_oracle(%bytes: buffer, %output: buffer, %position_input: index, %replacement: i64) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %predicate_count = index.constant 40 : index
  %step = index.constant 1 : index
  %position_mask = index.constant 127 : index
  %bounded_position = index.andi %position_input, %position_mask : index
  %position = index.rem %bounded_position, %predicate_count : index
  %source = buffer.view %bytes[%origin] : buffer -> view<40xi8>
  %destination = buffer.view %output[%origin] : buffer -> view<40xi8>
  %predicate_replacement = scalar.trunci %replacement : i64 to i1
  %clear = scalar.constant 0 : i8
  scf.for %lane = [%begin to %predicate_count step %step] {
    %is_replaced = index.cmp eq, %lane, %position : index
    %value = view.load %source[%lane] : view<40xi8> -> i8
    %predicate = scalar.cmpi ne, %value, %clear : i8
    %selected = scf.select %is_replaced, %predicate_replacement, %predicate : i1
    %result = scf.select %selected, %value, %clear : i8
    view.store %result, %destination[%lane] : i8, view<40xi8>
  }
  func.return
}

// Each position observes both replacement predicate values across two sweeps.
func.def @wide_predicate_replacement(%trial: index, %entropy: i64) -> (i64) {
  %width = index.constant 40 : index
  %sweep = index.div %trial, %width : index
  %predicate = index.cast %sweep : index to i64
  %mask = scalar.constant -2 : i64
  %payload = scalar.andi %entropy, %mask : i64
  %replacement = scalar.ori %payload, %predicate : i64
  func.return %replacement : i64
}

check.scenario @wide_tail_insertion_values {
  check.trial[39](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %bytes = check.generate.random.uniform seed(%seed) range(-128 to 127) : tensor<39xi8>
    %words = check.generate.random.uniform seed(%seed) range(-32768 to 32767) : tensor<39xi16>
    %byte_storage = check.generate.fill value(37) : tensor<41xi8>
    %word_storage = check.generate.fill value(37) : tensor<41xi16>
    %byte_output = check.tensor.view %byte_storage offset(1) : tensor<41xi8> -> tensor<39xi8>
    %word_output = check.tensor.view %word_storage offset(2) : tensor<41xi16> -> tensor<39xi16>
    check.compare<@wide_tail_insert, @wide_tail_insert_oracle>(%bytes, %words, %byte_output, %word_output, %trial, %seed) : (tensor<39xi8>, tensor<39xi16>, tensor<39xi8>, tensor<39xi16>, index, i64) -> () {
      check.expect.bitwise actual(%bytes) expected(%bytes) : tensor<39xi8>
      check.expect.bitwise actual(%words) expected(%words) : tensor<39xi16>
      check.expect.bitwise actual(%byte_storage) expected(%byte_storage) : tensor<41xi8>
      check.expect.bitwise actual(%word_storage) expected(%word_storage) : tensor<41xi16>
    }
  }
  check.return
}

check.scenario @wide_predicate_insertion_values {
  check.trial[80](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %replacement = check.generate<@wide_predicate_replacement>(%trial, %seed) : (index, i64) -> (i64)
    %bytes = check.generate.random.uniform seed(%seed) range(0 to 3) : tensor<40xi8>
    %storage = check.generate.fill value(37) : tensor<42xi8>
    %output = check.tensor.view %storage offset(1) : tensor<42xi8> -> tensor<40xi8>
    check.compare<@wide_predicate_insert, @wide_predicate_insert_oracle>(%bytes, %output, %trial, %replacement) : (tensor<40xi8>, tensor<40xi8>, index, i64) -> () {
      check.expect.bitwise actual(%bytes) expected(%bytes) : tensor<40xi8>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<42xi8>
    }
  }
  check.return
}

// Fixed updates straddle a packet boundary and the final singleton. The
// original mask remains live after both updates and has its own output.
func.def @predicate_tail_updates(%input: buffer, %output: buffer, %replacement_index: index) {
  %origin = index.constant 0 : offset
  %source = buffer.view %input[%origin] : buffer -> view<33xi8>
  %destination = buffer.view %output[%origin] : buffer -> view<66xi8>
  %values = vector.load %source[0] : view<33xi8> -> vector<33xi8>
  %inactive_values = vector.splati 0 : vector<33xi8>
  %true_values = vector.splati 1 : vector<33xi8>
  %original = vector.cmpi ne, %values, %inactive_values : vector<33xi8> -> vector<33xi1>
  %replacement = index.cast %replacement_index : index to i64
  %value = scalar.trunci %replacement : i64 to i1
  %invert_bit = scalar.constant 1 : i1
  %inverse = scalar.xori %value, %invert_bit : i1
  %middle = vector.insert %value into %original[16] : i1, vector<33xi1>
  %updated = vector.insert %inverse into %middle[32] : i1, vector<33xi1>
  %selected = vector.select %updated, %values, %inactive_values : vector<33xi8>
  %saved = vector.select %original, %true_values, %inactive_values : vector<33xi8>
  vector.store %selected, %destination[0] : vector<33xi8>, view<66xi8>
  vector.store %saved, %destination[33] : vector<33xi8>, view<66xi8>
  func.return
}

func.def @predicate_tail_updates_oracle(%input: buffer, %output: buffer, %replacement_index: index) {
  %origin = index.constant 0 : offset
  %source = buffer.view %input[%origin] : buffer -> view<33xi8>
  %destination = buffer.view %output[%origin] : buffer -> view<66xi8>
  %begin = index.constant 0 : index
  %end = index.constant 33 : index
  %step = index.constant 1 : index
  %middle = index.constant 16 : index
  %tail = index.constant 32 : index
  %inactive_value = scalar.constant 0 : i8
  %invert_bit = scalar.constant 1 : i1
  %replacement = index.cast %replacement_index : index to i64
  %replacement_bit = scalar.trunci %replacement : i64 to i1
  %inverse = scalar.xori %replacement_bit, %invert_bit : i1
  scf.for %lane = [%begin to %end step %step] {
    %value = view.load %source[%lane] : view<33xi8> -> i8
    %original = scalar.cmpi ne, %value, %inactive_value : i8
    %at_middle = index.cmp eq, %lane, %middle : index
    %at_tail = index.cmp eq, %lane, %tail : index
    %first = scf.select %at_middle, %replacement_bit, %original : i1
    %updated = scf.select %at_tail, %inverse, %first : i1
    %selected = scf.select %updated, %value, %inactive_value : i8
    %saved = scalar.extui %original : i1 to i8
    %saved_position = index.add %lane, %end : index
    view.store %selected, %destination[%lane] : i8, view<66xi8>
    view.store %saved, %destination[%saved_position] : i8, view<66xi8>
  }
  func.return
}

check.scenario @predicate_tail_update_values {
  check.trial[8](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(0 to 3) : tensor<33xi8>
    %storage = check.generate.fill value(37) : tensor<68xi8>
    %output = check.tensor.view %storage offset(1) : tensor<68xi8> -> tensor<66xi8>
    check.compare<@predicate_tail_updates, @predicate_tail_updates_oracle>(%input, %output, %trial) : (tensor<33xi8>, tensor<66xi8>, index) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<33xi8>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<68xi8>
    }
  }
  check.return
}

// Address vectors retain their values through insertion and dynamic extraction.
// Scalar casts make the observed output independent of target address width.
func.def @address_lane_insertion(%position_input: index, %value: i64, %output: buffer) {
  %count = index.constant 17 : index
  %position_mask = index.constant 31 : index
  %bounded = index.andi %position_input, %position_mask : index
  %position = index.rem %bounded, %count : index
  %value_mask = scalar.constant 65535 : i64
  %bits = scalar.andi %value, %value_mask : i64
  %index_value = index.cast %bits : i64 to index
  %offset_value = index.cast %bits : i64 to offset
  %index_seed = index.constant 11 : index
  %offset_seed = index.constant 29 : offset
  %indices = vector.splat %index_seed : vector<17xindex>
  %offsets = vector.splat %offset_seed : vector<17xoffset>
  %updated_indices = vector.insert %index_value into %indices[%position] : index, vector<17xindex>
  %updated_offsets = vector.insert %offset_value into %offsets[%position] : offset, vector<17xoffset>
  %origin = index.constant 0 : offset
  %destination = buffer.view %output[%origin] : buffer -> view<34xi64>
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  scf.for %lane = [%begin to %count step %step] {
    %selected_index = vector.extract %updated_indices[%lane] : vector<17xindex> -> index
    %selected_offset = vector.extract %updated_offsets[%lane] : vector<17xoffset> -> offset
    %index_bits = index.cast %selected_index : index to i64
    %offset_bits = index.cast %selected_offset : offset to i64
    %offset_position = index.add %lane, %count : index
    view.store %index_bits, %destination[%lane] : i64, view<34xi64>
    view.store %offset_bits, %destination[%offset_position] : i64, view<34xi64>
  }
  func.return
}

func.def @address_lane_insertion_oracle(%position_input: index, %value: i64, %output: buffer) {
  %count = index.constant 17 : index
  %position_mask = index.constant 31 : index
  %bounded = index.andi %position_input, %position_mask : index
  %position = index.rem %bounded, %count : index
  %value_mask = scalar.constant 65535 : i64
  %bits = scalar.andi %value, %value_mask : i64
  %index_value = index.cast %bits : i64 to index
  %offset_value = index.cast %bits : i64 to offset
  %index_seed = index.constant 11 : index
  %offset_seed = index.constant 29 : offset
  %origin = index.constant 0 : offset
  %destination = buffer.view %output[%origin] : buffer -> view<34xi64>
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  scf.for %lane = [%begin to %count step %step] {
    %matches = index.cmp eq, %lane, %position : index
    %selected_index = scf.select %matches, %index_value, %index_seed : index
    %selected_offset = scf.select %matches, %offset_value, %offset_seed : offset
    %index_bits = index.cast %selected_index : index to i64
    %offset_bits = index.cast %selected_offset : offset to i64
    %offset_position = index.add %lane, %count : index
    view.store %index_bits, %destination[%lane] : i64, view<34xi64>
    view.store %offset_bits, %destination[%offset_position] : i64, view<34xi64>
  }
  func.return
}

check.scenario @address_lane_insertion_values {
  check.trial[17](%trial: index, %entropy: check.entropy) {
    %value = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %storage = check.generate.fill value(37) : tensor<288xi8>
    %output = check.tensor.view %storage offset(8) : tensor<288xi8> -> tensor<272xi8>
    check.compare<@address_lane_insertion, @address_lane_insertion_oracle>(%trial, %value, %output) : (index, i64, tensor<272xi8>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<288xi8>
    }
  }
  check.return
}

// Whole predicate rows cross native packets. Fixed and runtime row insertion
// use literal and runtime inversions while preserving the original matrix.
func.def @predicate_row_insertion(%input: buffer, %output: buffer, %row_input: index) {
  %origin = index.constant 0 : offset
  %rows = index.constant 3 : index
  %row_mask = index.constant 7 : index
  %bounded_row = index.andi %row_input, %row_mask : index
  %row = index.rem %bounded_row, %rows : index
  %source = buffer.view %input[%origin] : buffer -> view<51xi8>
  %destination = buffer.view %output[%origin] : buffer -> view<153xi8>
  %values = vector.load %source[0] : view<51xi8> -> vector<51xi8>
  %inactive_values = vector.splati 0 : vector<51xi8>
  %true_values = vector.splati 1 : vector<51xi8>
  %original = vector.cmpi ne, %values, %inactive_values : vector<51xi8> -> vector<51xi1>
  %first = vector.slice %original[0] : vector<51xi1> -> vector<17xi1>
  %true_row = vector.splati 1 : vector<17xi1>
  %replacement = vector.xori %first, %true_row : vector<17xi1>
  %selector_bits = index.cast %row_input : index to i64
  %invert = scalar.trunci %selector_bits : i64 to i1
  %invert_row = vector.splat %invert : vector<17xi1>
  %dynamic_replacement = vector.xori %first, %invert_row : vector<17xi1>
  %matrix = vector.bitcast %original : vector<51xi1> to vector<3x17xi1>
  %fixed = vector.insert %replacement into %matrix[1] : vector<17xi1>, vector<3x17xi1>
  %dynamic = vector.insert %dynamic_replacement into %matrix[%row] : vector<17xi1>, vector<3x17xi1>
  %fixed_flat = vector.bitcast %fixed : vector<3x17xi1> to vector<51xi1>
  %dynamic_flat = vector.bitcast %dynamic : vector<3x17xi1> to vector<51xi1>
  %fixed_values = vector.select %fixed_flat, %true_values, %inactive_values : vector<51xi8>
  %dynamic_values = vector.select %dynamic_flat, %true_values, %inactive_values : vector<51xi8>
  %saved = vector.select %original, %true_values, %inactive_values : vector<51xi8>
  vector.store %fixed_values, %destination[0] : vector<51xi8>, view<153xi8>
  vector.store %dynamic_values, %destination[51] : vector<51xi8>, view<153xi8>
  vector.store %saved, %destination[102] : vector<51xi8>, view<153xi8>
  func.return
}

func.def @predicate_row_insertion_oracle(%input: buffer, %output: buffer, %row_input: index) {
  %origin = index.constant 0 : offset
  %rows = index.constant 3 : index
  %row_mask = index.constant 7 : index
  %bounded_row = index.andi %row_input, %row_mask : index
  %row = index.rem %bounded_row, %rows : index
  %source = buffer.view %input[%origin] : buffer -> view<51xi8>
  %destination = buffer.view %output[%origin] : buffer -> view<153xi8>
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %columns = index.constant 17 : index
  %end = index.constant 51 : index
  %saved_origin = index.constant 102 : index
  %inactive_value = scalar.constant 0 : i8
  %selector_bits = index.cast %row_input : index to i64
  %invert = scalar.trunci %selector_bits : i64 to i1
  scf.for %lane = [%begin to %end step %step] {
    %column = index.rem %lane, %columns : index
    %current_row = index.div %lane, %columns : index
    %value = view.load %source[%lane] : view<51xi8> -> i8
    %first = view.load %source[%column] : view<51xi8> -> i8
    %original = scalar.cmpi ne, %value, %inactive_value : i8
    %replacement = scalar.cmpi eq, %first, %inactive_value : i8
    %first_bit = scalar.cmpi ne, %first, %inactive_value : i8
    %dynamic_replacement = scalar.xori %first_bit, %invert : i1
    %at_fixed = index.cmp eq, %current_row, %step : index
    %at_dynamic = index.cmp eq, %current_row, %row : index
    %fixed = scf.select %at_fixed, %replacement, %original : i1
    %dynamic = scf.select %at_dynamic, %dynamic_replacement, %original : i1
    %fixed_value = scalar.extui %fixed : i1 to i8
    %dynamic_value = scalar.extui %dynamic : i1 to i8
    %saved = scalar.extui %original : i1 to i8
    %dynamic_position = index.add %lane, %end : index
    %saved_position = index.add %lane, %saved_origin : index
    view.store %fixed_value, %destination[%lane] : i8, view<153xi8>
    view.store %dynamic_value, %destination[%dynamic_position] : i8, view<153xi8>
    view.store %saved, %destination[%saved_position] : i8, view<153xi8>
  }
  func.return
}

check.scenario @predicate_row_insertion_values {
  check.trial[6](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(0 to 3) : tensor<51xi8>
    %storage = check.generate.fill value(37) : tensor<155xi8>
    %output = check.tensor.view %storage offset(1) : tensor<155xi8> -> tensor<153xi8>
    check.compare<@predicate_row_insertion, @predicate_row_insertion_oracle>(%input, %output, %trial) : (tensor<51xi8>, tensor<153xi8>, index) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<51xi8>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<155xi8>
    }
  }
  check.return
}

// All three carriers describe the same bytes. Their complete matrices exceed
// one native operation's register limit, while each replacement is one row.
func.def @payload_row_insertion(%input: buffer, %replacement: buffer, %output: buffer, %row_input: index) {
  %origin = index.constant 0 : offset
  %rows = index.constant 3 : index
  %row_mask = index.constant 7 : index
  %bounded_row = index.andi %row_input, %row_mask : index
  %row = index.rem %bounded_row, %rows : index
  %byte_source = buffer.view %input[%origin] : buffer -> view<3x72xi8>
  %half_source = buffer.view %input[%origin] : buffer -> view<3x36xf16>
  %wide_source = buffer.view %input[%origin] : buffer -> view<3x9xf64>
  %byte_row = buffer.view %replacement[%origin] : buffer -> view<72xi8>
  %half_row = buffer.view %replacement[%origin] : buffer -> view<36xf16>
  %wide_row = buffer.view %replacement[%origin] : buffer -> view<9xf64>
  %destination = buffer.view %output[%origin] : buffer -> view<648xi8>
  %byte_matrix = vector.load %byte_source[0, 0] : view<3x72xi8> -> vector<3x72xi8>
  %half_matrix = vector.load %half_source[0, 0] : view<3x36xf16> -> vector<3x36xf16>
  %wide_matrix = vector.load %wide_source[0, 0] : view<3x9xf64> -> vector<3x9xf64>
  %byte_values = vector.load %byte_row[0] : view<72xi8> -> vector<72xi8>
  %half_values = vector.load %half_row[0] : view<36xf16> -> vector<36xf16>
  %wide_values = vector.load %wide_row[0] : view<9xf64> -> vector<9xf64>
  %byte_updated = vector.insert %byte_values into %byte_matrix[%row] : vector<72xi8>, vector<3x72xi8>
  %half_updated = vector.insert %half_values into %half_matrix[%row] : vector<36xf16>, vector<3x36xf16>
  %wide_updated = vector.insert %wide_values into %wide_matrix[%row] : vector<9xf64>, vector<3x9xf64>
  %byte_bits = vector.bitcast %byte_updated : vector<3x72xi8> to vector<216xi8>
  %half_bits = vector.bitcast %half_updated : vector<3x36xf16> to vector<216xi8>
  %wide_bits = vector.bitcast %wide_updated : vector<3x9xf64> to vector<216xi8>
  vector.store %byte_bits, %destination[0] : vector<216xi8>, view<648xi8>
  vector.store %half_bits, %destination[216] : vector<216xi8>, view<648xi8>
  vector.store %wide_bits, %destination[432] : vector<216xi8>, view<648xi8>
  func.return
}

func.def @payload_row_insertion_oracle(%input: buffer, %replacement: buffer, %output: buffer, %row_input: index) {
  %origin = index.constant 0 : offset
  %rows = index.constant 3 : index
  %row_mask = index.constant 7 : index
  %bounded_row = index.andi %row_input, %row_mask : index
  %row = index.rem %bounded_row, %rows : index
  %source = buffer.view %input[%origin] : buffer -> view<216xi8>
  %row_source = buffer.view %replacement[%origin] : buffer -> view<72xi8>
  %destination = buffer.view %output[%origin] : buffer -> view<648xi8>
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %row_bytes = index.constant 72 : index
  %matrix_bytes = index.constant 216 : index
  %end = index.constant 648 : index
  scf.for %position = [%begin to %end step %step] {
    %source_position = index.rem %position, %matrix_bytes : index
    %current_row = index.div %source_position, %row_bytes : index
    %column = index.rem %source_position, %row_bytes : index
    %original = view.load %source[%source_position] : view<216xi8> -> i8
    %inserted = view.load %row_source[%column] : view<72xi8> -> i8
    %at_row = index.cmp eq, %current_row, %row : index
    %value = scf.select %at_row, %inserted, %original : i8
    view.store %value, %destination[%position] : i8, view<648xi8>
  }
  func.return
}

check.scenario @payload_row_insertion_values {
  check.trial[6](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %replacement_entropy = check.entropy.fork %entropy name("replacement") : check.entropy
    %replacement_seed = check.entropy.read %replacement_entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-128 to 127) : tensor<216xi8>
    %replacement = check.generate.random.uniform seed(%replacement_seed) range(-128 to 127) : tensor<72xi8>
    %storage = check.generate.fill value(37) : tensor<664xi8>
    %output = check.tensor.view %storage offset(8) : tensor<664xi8> -> tensor<648xi8>
    check.compare<@payload_row_insertion, @payload_row_insertion_oracle>(%input, %replacement, %output, %trial) : (tensor<216xi8>, tensor<72xi8>, tensor<648xi8>, index) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<216xi8>
      check.expect.bitwise actual(%replacement) expected(%replacement) : tensor<72xi8>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<664xi8>
    }
  }
  check.return
}
