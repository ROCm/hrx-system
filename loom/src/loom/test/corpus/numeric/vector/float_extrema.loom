check.scenario @vector_float_extrema_finite_f16_values {
  check.trial[64](%trial: index, %entropy: check.entropy) {
    %value_seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %lower_seed = check.entropy.read %entropy[1] : check.entropy -> i64
    %upper_seed = check.entropy.read %entropy[2] : check.entropy -> i64
    %value = check.generate.random.uniform seed(%value_seed) range(-1024.0 to 1024.0) : tensor<4xf16>
    %lower = check.generate.random.uniform seed(%lower_seed) range(-1024.0 to 1024.0) : tensor<4xf16>
    %upper = check.generate.random.uniform seed(%upper_seed) range(-1024.0 to 1024.0) : tensor<4xf16>
    %output = check.generate.fill value(0.0) : tensor<28xf16>
    check.compare<@vector_float_extrema_finite_f16>(%value, %lower, %upper, %output) : (tensor<4xf16>, tensor<4xf16>, tensor<4xf16>, tensor<28xf16>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(0.0) rtol(0.0) nan(different) : tensor<28xf16>, tensor<28xf16>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %value = check.generate.iota offset(1) step(1) : tensor<4xi16>
    %lower = check.generate.iota offset(4) step(-1) : tensor<4xi16>
    %upper = check.generate.iota offset(2) step(1) : tensor<4xi16>
    %output = check.generate.fill value(0.0) : tensor<28xf16>
    check.compare<@vector_float_extrema_finite_f16>(%value, %lower, %upper, %output) : (tensor<4xi16>, tensor<4xi16>, tensor<4xi16>, tensor<28xf16>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<28xf16>
    }
  }
  check.return
}

