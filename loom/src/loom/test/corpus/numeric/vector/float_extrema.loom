  // extrema, while ordered clamp retains the NaN value.
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %value = check.generate.fill value(-1) : tensor<4xi8>
    %lhs = check.generate.fill value(127) : tensor<4xi8>
    %rhs = check.generate.iota offset(1) step(1) : tensor<4xi8>
    %output = check.generate.fill value(0.0) : tensor<28xf32>
    check.compare<@vector_float_extrema_f8e4m3>(%value, %lhs, %rhs, %output) : (tensor<4xi8>, tensor<4xi8>, tensor<4xi8>, tensor<28xf32>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(0.0) rtol(0.0) nan(same) : tensor<28xf32>, tensor<28xf32>
    }
  }
  // Every sign pairing, including reversed bounds, preserves subnormal bits.
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %negative = check.generate.iota offset(-127) step(1) : tensor<4xi8>
    %positive = check.generate.iota offset(4) step(-1) : tensor<4xi8>
    %output = check.generate.fill value(0.0) : tensor<28xf32>
    check.compare<@vector_float_extrema_f8e4m3>(%negative, %negative, %positive, %output) : (tensor<4xi8>, tensor<4xi8>, tensor<4xi8>, tensor<28xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<28xf32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %negative = check.generate.iota offset(-127) step(1) : tensor<4xi8>
    %positive = check.generate.iota offset(4) step(-1) : tensor<4xi8>
    %output = check.generate.fill value(0.0) : tensor<28xf32>
    check.compare<@vector_float_extrema_f8e4m3>(%positive, %positive, %negative, %output) : (tensor<4xi8>, tensor<4xi8>, tensor<4xi8>, tensor<28xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<28xf32>
    }
  }
  // Independent raw encodings exercise finite magnitudes and NaNs without
  // making the compiler specialize its operands or its bound ordering.
  check.trial[64](%trial: index, %entropy: check.entropy) {
    %value_seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %lhs_seed = check.entropy.read %entropy[1] : check.entropy -> i64
    %rhs_seed = check.entropy.read %entropy[2] : check.entropy -> i64
    %value = check.generate.random.uniform seed(%value_seed) range(-128 to 127) : tensor<4xi8>
    %lhs = check.generate.random.uniform seed(%lhs_seed) range(-128 to 127) : tensor<4xi8>
    %rhs = check.generate.random.uniform seed(%rhs_seed) range(-128 to 127) : tensor<4xi8>
    %output = check.generate.fill value(0.0) : tensor<28xf32>
    check.compare<@vector_float_extrema_f8e4m3>(%value, %lhs, %rhs, %output) : (tensor<4xi8>, tensor<4xi8>, tensor<4xi8>, tensor<28xf32>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(0.0) rtol(0.0) nan(same) : tensor<28xf32>, tensor<28xf32>
    }
  }
  // Opposing signed-zero operands exercise IEEE extrema ordering while the
  // alternating value tests ordered clamp's compare/select tie behavior.
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %value = check.generate.iota offset(0) step(-128) period(2) : tensor<4xi8>
    %lhs = check.generate.iota offset(0) step(-128) period(2) : tensor<4xi8>
    %rhs = check.generate.fill value(-128) : tensor<4xi8>
    %output = check.generate.fill value(0.0) : tensor<28xf32>
    check.compare<@vector_float_extrema_f8e4m3>(%value, %lhs, %rhs, %output) : (tensor<4xi8>, tensor<4xi8>, tensor<4xi8>, tensor<28xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<28xf32>
    }
  }
  // The representational special boundary covers maximum finite values,
  // infinities where present, signaling NaNs, and quiet NaNs.
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %value = check.generate.iota offset(124) step(1) : tensor<4xi8>
    %lhs = check.generate.iota offset(124) step(1) : tensor<4xi8>
    %rhs = check.generate.iota offset(127) step(-1) : tensor<4xi8>
    %output = check.generate.fill value(0.0) : tensor<28xf32>
    check.compare<@vector_float_extrema_f8e4m3>(%value, %lhs, %rhs, %output) : (tensor<4xi8>, tensor<4xi8>, tensor<4xi8>, tensor<28xf32>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(0.0) rtol(0.0) nan(same) : tensor<28xf32>, tensor<28xf32>
    }
  }
  check.return
}

