    %value = check.generate.iota offset(1) step(1) : tensor<4xi16>
    %lhs = check.generate.iota offset(4) step(-1) : tensor<4xi16>
    %rhs = check.generate.iota offset(2) step(1) : tensor<4xi16>
    %output = check.generate.fill value(0.0) : tensor<28xbf16>
    check.compare<@vector_float_extrema_bf16>(%value, %lhs, %rhs, %output) : (tensor<4xi16>, tensor<4xi16>, tensor<4xi16>, tensor<28xbf16>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<28xbf16>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %value = check.generate.iota offset(-32767) step(1) : tensor<4xi16>
    %lhs = check.generate.iota offset(-32764) step(-1) : tensor<4xi16>
    %rhs = check.generate.iota offset(-32766) step(1) : tensor<4xi16>
    %output = check.generate.fill value(0.0) : tensor<28xbf16>
    check.compare<@vector_float_extrema_bf16>(%value, %lhs, %rhs, %output) : (tensor<4xi16>, tensor<4xi16>, tensor<4xi16>, tensor<28xbf16>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<28xbf16>
    }
  }
  // A NaN in the value or lower bound must not poison number-preferring
  // extrema, while ordered clamp retains the NaN value.
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %value = check.generate.fill value(-127) : tensor<4xi16>
    %lhs = check.generate.fill value(32641) : tensor<4xi16>
    %rhs = check.generate.iota offset(1) step(1) : tensor<4xi16>
    %output = check.generate.fill value(0.0) : tensor<28xbf16>
    check.compare<@vector_float_extrema_bf16>(%value, %lhs, %rhs, %output) : (tensor<4xi16>, tensor<4xi16>, tensor<4xi16>, tensor<28xbf16>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(0.0) rtol(0.0) nan(same) : tensor<28xbf16>, tensor<28xbf16>
    }
  }
  // Every sign pairing, including reversed bounds, preserves subnormal bits.
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %negative = check.generate.iota offset(-32767) step(1) : tensor<4xi16>
    %positive = check.generate.iota offset(4) step(-1) : tensor<4xi16>
    %output = check.generate.fill value(0.0) : tensor<28xbf16>
    check.compare<@vector_float_extrema_bf16>(%negative, %negative, %positive, %output) : (tensor<4xi16>, tensor<4xi16>, tensor<4xi16>, tensor<28xbf16>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<28xbf16>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %negative = check.generate.iota offset(-32767) step(1) : tensor<4xi16>
    %positive = check.generate.iota offset(4) step(-1) : tensor<4xi16>
    %output = check.generate.fill value(0.0) : tensor<28xbf16>
    check.compare<@vector_float_extrema_bf16>(%positive, %positive, %negative, %output) : (tensor<4xi16>, tensor<4xi16>, tensor<4xi16>, tensor<28xbf16>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<28xbf16>
    }
  }
  // Independent raw encodings exercise finite magnitudes and NaNs without
  // making the compiler specialize its operands or its bound ordering.
  check.trial[64](%trial: index, %entropy: check.entropy) {
    %value_seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %lhs_seed = check.entropy.read %entropy[1] : check.entropy -> i64
    %rhs_seed = check.entropy.read %entropy[2] : check.entropy -> i64
    %value = check.generate.random.uniform seed(%value_seed) range(-32768 to 32767) : tensor<4xi16>
    %lhs = check.generate.random.uniform seed(%lhs_seed) range(-32768 to 32767) : tensor<4xi16>
    %rhs = check.generate.random.uniform seed(%rhs_seed) range(-32768 to 32767) : tensor<4xi16>
    %output = check.generate.fill value(0.0) : tensor<28xbf16>
    check.compare<@vector_float_extrema_bf16>(%value, %lhs, %rhs, %output) : (tensor<4xi16>, tensor<4xi16>, tensor<4xi16>, tensor<28xbf16>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(0.0) rtol(0.0) nan(same) : tensor<28xbf16>, tensor<28xbf16>
    }
  }
  // Opposing signed-zero operands exercise IEEE extrema ordering while the
  // alternating value tests ordered clamp's compare/select tie behavior.
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %value = check.generate.iota offset(0) step(-32768) period(2) : tensor<4xi16>
    %lhs = check.generate.iota offset(0) step(-32768) period(2) : tensor<4xi16>
    %rhs = check.generate.fill value(-32768) : tensor<4xi16>
    %output = check.generate.fill value(0.0) : tensor<28xbf16>
    check.compare<@vector_float_extrema_bf16>(%value, %lhs, %rhs, %output) : (tensor<4xi16>, tensor<4xi16>, tensor<4xi16>, tensor<28xbf16>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<28xbf16>
    }
  }
  // The representational special boundary covers maximum finite values,
  // infinities where present, signaling NaNs, and quiet NaNs.
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %value = check.generate.iota offset(32640) step(1) : tensor<4xi16>
    %lhs = check.generate.iota offset(32639) step(1) : tensor<4xi16>
    %rhs = check.generate.iota offset(32704) step(1) : tensor<4xi16>
    %output = check.generate.fill value(0.0) : tensor<28xbf16>
    check.compare<@vector_float_extrema_bf16>(%value, %lhs, %rhs, %output) : (tensor<4xi16>, tensor<4xi16>, tensor<4xi16>, tensor<28xbf16>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(0.0) rtol(0.0) nan(same) : tensor<28xbf16>, tensor<28xbf16>
    }
  }
  check.return
}

