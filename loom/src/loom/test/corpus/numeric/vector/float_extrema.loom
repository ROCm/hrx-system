// Finite-only permissions admit native min/max on qualified profiles, without
// permitting subnormal flushing or changing sequential reversed-bound clamps.
func.def @vector_float_extrema_finite_f16(%value_buffer: buffer, %lower_buffer: buffer, %upper_buffer: buffer, %output_buffer: buffer) {
  %base = index.constant 0 : offset
  %value_view = buffer.view %value_buffer[%base] : buffer -> view<4xf16>
  %lower_view = buffer.view %lower_buffer[%base] : buffer -> view<4xf16>
  %upper_view = buffer.view %upper_buffer[%base] : buffer -> view<4xf16>
  %output_view = buffer.view %output_buffer[%base] : buffer -> view<28xf16>
  %value = vector.load %value_view[0] : view<4xf16> -> vector<4xf16>
  %lower = vector.load %lower_view[0] : view<4xf16> -> vector<4xf16>
  %upper = vector.load %upper_view[0] : view<4xf16> -> vector<4xf16>
  %minimum = vector.minimumf<nnan|ninf|nsz> %lower, %upper : vector<4xf16>
  %maximum = vector.maximumf<nnan|ninf|nsz> %lower, %upper : vector<4xf16>
  %minnum = vector.minnumf<nnan|ninf|nsz> %lower, %upper : vector<4xf16>
  %maxnum = vector.maxnumf<nnan|ninf|nsz> %lower, %upper : vector<4xf16>
  %ordered = vector.clampf<ordered, nnan|ninf|nsz> %value, %lower, %upper : vector<4xf16>
  %number = vector.clampf<number, nnan|ninf|nsz> %value, %lower, %upper : vector<4xf16>
  %ieee = vector.clampf<ieee, nnan|ninf|nsz> %value, %lower, %upper : vector<4xf16>
  vector.store %minimum, %output_view[0] : vector<4xf16>, view<28xf16>
  vector.store %maximum, %output_view[4] : vector<4xf16>, view<28xf16>
  vector.store %minnum, %output_view[8] : vector<4xf16>, view<28xf16>
  vector.store %maxnum, %output_view[12] : vector<4xf16>, view<28xf16>
  vector.store %ordered, %output_view[16] : vector<4xf16>, view<28xf16>
  vector.store %number, %output_view[20] : vector<4xf16>, view<28xf16>
  vector.store %ieee, %output_view[24] : vector<4xf16>, view<28xf16>
  func.return
}

