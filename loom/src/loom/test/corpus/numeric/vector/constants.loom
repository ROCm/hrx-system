check.scenario @vector_predicate_constant_values {
  check.trial[2](%trial: index, %entropy: check.entropy) {
    %true_payload = check.literal value(-19088743) : i32
    %false_payload = check.literal value(2147483647) : i32
    %predicate_output = check.generate.fill value(23) : tensor<6xi32>
    check.compare<@vector_predicate_constant_observations>(%trial, %true_payload, %false_payload, %predicate_output) : (index, i32, i32, tensor<6xi32>) -> () {
      check.expect.bitwise actual(%predicate_output) expected(%predicate_output) : tensor<6xi32>
    }
  }
  check.return
}

check.scenario @vector_f64_constant_selection_values {
  check.trial[2](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-3.5) step(5.0) : tensor<2xf64>
    %output = check.generate.fill value(23.0) : tensor<2xf64>
    check.compare<@vector_f64_constant_selection>(%trial, %input, %output) : (index, tensor<2xf64>, tensor<2xf64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<2xf64>
    }
  }
  check.return
}

// Constant coordinate arithmetic wraps in its declared carrier before the
// range comparison. Both iotas and the masks reach observable memory.
func.def @vector_coordinate_constants(%payload_bits: i64, %coordinates: buffer, %selected: buffer) {
  %true_payload = scalar.trunci %payload_bits : i64 to i32
  %all_bits = scalar.constant -1 : i32
  %false_payload = scalar.xori %true_payload, %all_bits : i32
  %positive_lower = scalar.constant 120 : i8
  %positive_upper = scalar.constant 100 : i8
  %positive_step = scalar.constant 16 : i8
  %negative_lower = scalar.constant -120 : i8
  %negative_upper = scalar.constant -100 : i8
  %negative_step = scalar.constant -16 : i8
  %positive = vector.iota %positive_lower step %positive_step : vector<4xi8>
  %negative = vector.iota %negative_lower step %negative_step : vector<4xi8>
  %positive_mask = vector.mask.range [%positive_lower to %positive_upper step %positive_step] : i8 -> vector<4xi1>
  %negative_mask = vector.mask.range [%negative_lower to %negative_upper step %negative_step] : i8 -> vector<4xi1>
  %true_values = vector.splat %true_payload : vector<4xi32>
  %false_values = vector.splat %false_payload : vector<4xi32>
  %positive_values = vector.select %positive_mask, %true_values, %false_values : vector<4xi32>
  %negative_values = vector.select %negative_mask, %true_values, %false_values : vector<4xi32>
  %base = index.constant 0 : offset
  %coordinate_view = buffer.view %coordinates[%base] : buffer -> view<8xi8>
  %selected_view = buffer.view %selected[%base] : buffer -> view<8xi32>
  vector.store %positive, %coordinate_view[0] : vector<4xi8>, view<8xi8>
  vector.store %negative, %coordinate_view[4] : vector<4xi8>, view<8xi8>
  vector.store %positive_values, %selected_view[0] : vector<4xi32>, view<8xi32>
  vector.store %negative_values, %selected_view[4] : vector<4xi32>, view<8xi32>
  func.return
}

// The oracle computes in a wider scalar type, then explicitly truncates and
// sign-extends each coordinate before comparing it.
func.def @vector_coordinate_constants_oracle(%payload_bits: i64, %coordinates: buffer, %selected: buffer) {
  %true_payload = scalar.trunci %payload_bits : i64 to i32
  %all_bits = scalar.constant -1 : i32
  %false_payload = scalar.xori %true_payload, %all_bits : i32
  %lower = scalar.constant 120 : i32
  %positive_upper = scalar.constant 100 : i32
  %negative_upper = scalar.constant -100 : i32
  %stride = scalar.constant 16 : i32
  %c0 = scalar.constant 0 : i32
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %base = index.constant 0 : offset
  %coordinate_view = buffer.view %coordinates[%base] : buffer -> view<8xi8>
  %selected_view = buffer.view %selected[%base] : buffer -> view<8xi32>
  scf.for %lane = [%begin to %end step %step] {
    %ordinal = index.cast %lane : index to i32
    %delta = scalar.muli %ordinal, %stride : i32
    %positive_wide = scalar.addi %lower, %delta : i32
    %negative_wide = scalar.subi %c0, %positive_wide : i32
    %positive = scalar.trunci %positive_wide : i32 to i8
    %negative = scalar.trunci %negative_wide : i32 to i8
    %positive_signed = scalar.extsi %positive : i8 to i32
    %negative_signed = scalar.extsi %negative : i8 to i32
    %positive_mask = scalar.cmpi slt, %positive_signed, %positive_upper : i32
    %negative_mask = scalar.cmpi slt, %negative_signed, %negative_upper : i32
    %positive_value = scf.select %positive_mask, %true_payload, %false_payload : i32
    %negative_value = scf.select %negative_mask, %true_payload, %false_payload : i32
    %negative_lane = index.add %lane, %end : index
    view.store %positive, %coordinate_view[%lane] : i8, view<8xi8>
    view.store %negative, %coordinate_view[%negative_lane] : i8, view<8xi8>
    view.store %positive_value, %selected_view[%lane] : i32, view<8xi32>
    view.store %negative_value, %selected_view[%negative_lane] : i32, view<8xi32>
  }
  func.return
}

check.scenario @vector_coordinate_constant_values {
  check.trial[8](%trial: index, %entropy: check.entropy) {
    %payload_bits = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %coordinates = check.generate.fill value(23) : tensor<8xi8>
    %selected = check.generate.fill value(23) : tensor<8xi32>
    check.compare<@vector_coordinate_constants, @vector_coordinate_constants_oracle>(%payload_bits, %coordinates, %selected) : (i64, tensor<8xi8>, tensor<8xi32>) -> () {
      check.expect.bitwise actual(%coordinates) expected(%coordinates) : tensor<8xi8>
      check.expect.bitwise actual(%selected) expected(%selected) : tensor<8xi32>
    }
  }
  check.return
}
