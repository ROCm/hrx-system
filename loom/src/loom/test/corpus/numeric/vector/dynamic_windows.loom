  check.trial[9](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-32768) step(4369) : tensor<16xi16>
    %output = check.generate.fill value(23130) : tensor<10xi16>
    check.compare<@reshaped_half_windows, @reshaped_half_windows_oracle>(%trial, %input, %output) : (index, tensor<16xi16>, tensor<10xi16>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<16xi16>
      check.expect.bitwise actual(%output) expected(%output) : tensor<10xi16>
