  }
  check.return
}

// Every byte rectangle origin is exercised. The volume shares its row origin
// but preserves gaps between planes; both destinations retain guard borders.
func.def @rectangular_windows(%trial: index, %bytes: buffer, %halves: buffer, %byte_output: buffer, %half_output: buffer) {
  %ordinal = index.assume %trial [range(%trial, 0, 17)] : index
  %c6 = index.constant 6 : index
  %row = index.div %ordinal, %c6 : index
  %column = index.rem %ordinal, %c6 : index
  %base = index.constant 0 : offset
  %byte_view = buffer.view %bytes[%base] : buffer -> view<4x8xi8>
  %half_view = buffer.view %halves[%base] : buffer -> view<3x4x4xi16>
  %byte_result = buffer.view %byte_output[%base] : buffer -> view<4x6xi8>
  %half_result = buffer.view %half_output[%base] : buffer -> view<4x4x8xi16>
  %tile = vector.load %byte_view[0, 0] : view<4x8xi8> -> vector<4x8xi8>
  %rectangle = vector.slice %tile[%row, %column] : vector<4x8xi8> -> vector<2x3xi8>
  vector.store %rectangle, %byte_result[1, 2] : vector<2x3xi8>, view<4x6xi8>
  %volume = vector.load %half_view[0, 0, 0] : view<3x4x4xi16> -> vector<3x4x4xi16>
  %planes = vector.slice %volume[1, %row, 0] : vector<3x4x4xi16> -> vector<2x2x4xi16>
  vector.store %planes, %half_result[1, 1, 2] : vector<2x2x4xi16>, view<4x4x8xi16>
  func.return
}

func.def @rectangular_windows_oracle(%trial: index, %bytes: buffer, %halves: buffer, %byte_output: buffer, %half_output: buffer) {
  %ordinal = index.assume %trial [range(%trial, 0, 17)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c6 = index.constant 6 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %row = index.div %ordinal, %c6 : index
  %column = index.rem %ordinal, %c6 : index
  %base = index.constant 0 : offset
  %byte_view = buffer.view %bytes[%base] : buffer -> view<32xi8>
  %half_view = buffer.view %halves[%base] : buffer -> view<48xi16>
  %byte_result = buffer.view %byte_output[%base] : buffer -> view<24xi8>
  %half_result = buffer.view %half_output[%base] : buffer -> view<128xi16>
  scf.for %i = [%c0 to %c6 step %c1] {
    %dy = index.div %i, %c3 : index
    %dx = index.rem %i, %c3 : index
    %source_row = index.add %row, %dy : index
    %source_column = index.add %column, %dx : index
    %source_index = index.madd %source_row, %c8, %source_column : index
    %destination_row = index.add %dy, %c1 : index
    %destination_column = index.add %dx, %c2 : index
    %destination_index = index.madd %destination_row, %c6, %destination_column : index
    %value = view.load %byte_view[%source_index] : view<32xi8> -> i8
    view.store %value, %byte_result[%destination_index] : i8, view<24xi8>
  }
  scf.for %i = [%c0 to %c16 step %c1] {
    %plane = index.div %i, %c8 : index
    %plane_index = index.rem %i, %c8 : index
    %dy = index.div %plane_index, %c4 : index
    %dx = index.rem %plane_index, %c4 : index
    %source_plane = index.add %plane, %c1 : index
    %source_row = index.add %row, %dy : index
    %source_in_plane = index.madd %source_row, %c4, %dx : index
    %source_index = index.madd %source_plane, %c16, %source_in_plane : index
    %destination_row = index.add %dy, %c1 : index
    %destination_column = index.add %dx, %c2 : index
    %destination_in_plane = index.madd %destination_row, %c8, %destination_column : index
    %destination_index = index.madd %source_plane, %c32, %destination_in_plane : index
    %value = view.load %half_view[%source_index] : view<48xi16> -> i16
    view.store %value, %half_result[%destination_index] : i16, view<128xi16>
  }
  func.return
}

check.scenario @rectangular_window_values {
  check.trial[18](%trial: index, %entropy: check.entropy) {
    %bytes = check.generate.iota offset(-128) step(7) : tensor<32xi8>
