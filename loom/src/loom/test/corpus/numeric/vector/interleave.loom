// Byte addressing makes the oracle independent of typed vector interpretation,
// packet grouping, and the zip/unzip lowering.
func.def inline @route_packets_oracle(%count: index, %element_bytes: index, %position: offset, %input: buffer, %other: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c6 = index.constant 6 : index
  %c7 = index.constant 7 : index
  %c8 = index.constant 8 : index
  %half_bytes = index.mul %count, %element_bytes : index
  %full_bytes = index.mul %half_bytes, %c2 : index
  %extent = index.mul %half_bytes, %c8 : index
  %even_base = index.mul %half_bytes, %c4 : index
  %odd_base = index.mul %half_bytes, %c5 : index
  %left_base = index.mul %half_bytes, %c6 : index
  %right_base = index.mul %half_bytes, %c7 : index
  %zero_mask = scalar.constant 0 : i8
  %zip_mask = scalar.constant 17 : i8
  %even_mask = scalar.constant 1 : i8
  %odd_low_mask = scalar.constant -3 : i8
  %odd_high_mask = scalar.constant -1 : i8
  %left_view = buffer.view %input[%base] : buffer -> view<64xi8>
  %right_view = buffer.view %other[%base] : buffer -> view<64xi8>
  %destination = buffer.view %output[%position] : buffer -> view<[%extent]xi8>
  scf.for %i = [%begin to %half_bytes step %step] {
    %lane = index.div %i, %element_bytes : index
    %byte = index.rem %i, %element_bytes : index
    %is_low_byte = index.cmp eq, %byte, %begin : index
    %pair_lane = index.mul %lane, %c2 : index
    %pair_base = index.mul %pair_lane, %element_bytes : index
    %even_position = index.add %pair_base, %byte : index
    %odd_position = index.add %even_position, %element_bytes : index
    %repeat_even_position = index.add %even_position, %full_bytes : index
    %repeat_odd_position = index.add %odd_position, %full_bytes : index
    %split_even_position = index.add %even_base, %i : index
    %split_odd_position = index.add %odd_base, %i : index
    %saved_left_position = index.add %left_base, %i : index
    %saved_right_position = index.add %right_base, %i : index
    %left = view.load %left_view[%i] : view<64xi8> -> i8
    %right = view.load %right_view[%i] : view<64xi8> -> i8
    %mask = scf.select %is_low_byte, %zip_mask, %zero_mask : i8
    %masked_left = scalar.xori %left, %mask : i8
    %masked_right = scalar.xori %right, %mask : i8
    view.store %masked_left, %destination[%even_position] : i8, view<[%extent]xi8>
    view.store %masked_right, %destination[%odd_position] : i8, view<[%extent]xi8>
    view.store %masked_left, %destination[%repeat_even_position] : i8, view<[%extent]xi8>
    view.store %masked_left, %destination[%repeat_odd_position] : i8, view<[%extent]xi8>
    %even = view.load %left_view[%even_position] : view<64xi8> -> i8
    %odd = view.load %left_view[%odd_position] : view<64xi8> -> i8
    %even_byte_mask = scf.select %is_low_byte, %even_mask, %zero_mask : i8
    %odd_byte_mask = scf.select %is_low_byte, %odd_low_mask, %odd_high_mask : i8
    %masked_even = scalar.xori %even, %even_byte_mask : i8
    %masked_odd = scalar.xori %odd, %odd_byte_mask : i8
    view.store %masked_even, %destination[%split_even_position] : i8, view<[%extent]xi8>
    view.store %masked_odd, %destination[%split_odd_position] : i8, view<[%extent]xi8>
    view.store %left, %destination[%saved_left_position] : i8, view<[%extent]xi8>
    view.store %right, %destination[%saved_right_position] : i8, view<[%extent]xi8>
  }
  func.return
}

