check.scenario @native_packet_routes_values {
  check.trial[4](%trial: index, %entropy: check.entropy) {
    %left_seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %right_seed = check.entropy.read %entropy[1] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%left_seed) range(-128 to 127) : tensor<64xi8>
    %other = check.generate.random.uniform seed(%right_seed) range(-128 to 127) : tensor<64xi8>
    %storage = check.generate.fill value(91) : tensor<1880xi8>
    %output = check.tensor.view %storage offset(16) : tensor<1880xi8> -> tensor<1848xi8>
    check.compare<@native_packet_routes, @native_packet_routes_oracle>(%input, %other, %output) : (tensor<64xi8>, tensor<64xi8>, tensor<1848xi8>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<64xi8>
      check.expect.bitwise actual(%other) expected(%other) : tensor<64xi8>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<1880xi8>
    }
  }
  check.return
}
