// Applies distinct masks to the even and odd byte streams before weaving them
// back together. The unequal bit transforms keep both structural operations
// observable while preserving packed byte carriers.
func.def @packed_byte_even_odd_mask(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %input_bytes = buffer.view %input[%base] : buffer -> view<264xi8>
  %output_bytes = buffer.view %output[%base] : buffer -> view<264xi8>
  %packet = vector.load %input_bytes[0] : view<264xi8> -> vector<264xi8>
  %even, %odd = vector.deinterleave<0> %packet : vector<264xi8> -> vector<132xi8>, vector<132xi8>
  %even_mask = vector.splati 1 : vector<132xi8>
  %odd_mask = vector.splati -3 : vector<132xi8>
  %masked_even = vector.xori %even, %even_mask : vector<132xi8>
  %masked_odd = vector.xori %odd, %odd_mask : vector<132xi8>
  %result = vector.interleave<0> %masked_even, %masked_odd : vector<132xi8>, vector<132xi8> -> vector<264xi8>
  vector.store %result, %output_bytes[0] : vector<264xi8>, view<264xi8>
  func.return
}

// Scalar loads and stores keep the oracle independent of vector structural
// lowering and make the alternating lane contract explicit.
func.def @packed_byte_even_odd_mask_oracle(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 264 : index
  %step = index.constant 1 : index
  %pair_width = index.constant 2 : index
  %even_mask = scalar.constant 1 : i8
  %odd_mask = scalar.constant -3 : i8
  %input_bytes = buffer.view %input[%base] : buffer -> view<264xi8>
  %output_bytes = buffer.view %output[%base] : buffer -> view<264xi8>
  scf.for %i = [%begin to %end step %step] {
    %parity = index.rem %i, %pair_width : index
    %is_odd = index.cmp ne, %parity, %begin : index
    %mask = scf.select %is_odd, %odd_mask, %even_mask : i8
    %value = view.load %input_bytes[%i] : view<264xi8> -> i8
    %result = scalar.xori %value, %mask : i8
    view.store %result, %output_bytes[%i] : i8, view<264xi8>
  }
  func.return
}

// Uses a non-power-of-two row width and crosses the 512-bit packet boundary.
// This keeps whole 21-byte rows observable through both structural operations.
func.def @irregular_byte_row_mask(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %input_bytes = buffer.view %input[%base] : buffer -> view<336xi8>
  %output_bytes = buffer.view %output[%base] : buffer -> view<336xi8>
  %flat_packet = vector.load %input_bytes[%begin] : view<336xi8> -> vector<336xi8>
  %packet = vector.bitcast %flat_packet : vector<336xi8> to vector<16x21xi8>
  %even, %odd = vector.deinterleave<0> %packet : vector<16x21xi8> -> vector<8x21xi8>, vector<8x21xi8>
  %even_flat = vector.bitcast %even : vector<8x21xi8> to vector<168xi8>
  %odd_flat = vector.bitcast %odd : vector<8x21xi8> to vector<168xi8>
  %even_mask = vector.splati 17 : vector<168xi8>
  %odd_mask = vector.splati -29 : vector<168xi8>
  %masked_even_flat = vector.xori %even_flat, %even_mask : vector<168xi8>
  %masked_odd_flat = vector.xori %odd_flat, %odd_mask : vector<168xi8>
  %masked_even = vector.bitcast %masked_even_flat : vector<168xi8> to vector<8x21xi8>
  %masked_odd = vector.bitcast %masked_odd_flat : vector<168xi8> to vector<8x21xi8>
  %result = vector.interleave<0> %masked_even, %masked_odd : vector<8x21xi8>, vector<8x21xi8> -> vector<16x21xi8>
  %flat_result = vector.bitcast %result : vector<16x21xi8> to vector<336xi8>
  vector.store %flat_result, %output_bytes[%begin] : vector<336xi8>, view<336xi8>
  func.return
}

func.def @irregular_byte_row_mask_oracle(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 336 : index
  %step = index.constant 1 : index
  %row_width = index.constant 21 : index
  %pair_width = index.constant 2 : index
  %even_mask = scalar.constant 17 : i8
  %odd_mask = scalar.constant -29 : i8
  %input_bytes = buffer.view %input[%base] : buffer -> view<336xi8>
  %output_bytes = buffer.view %output[%base] : buffer -> view<336xi8>
  scf.for %i = [%begin to %end step %step] {
    %row = index.div %i, %row_width : index
    %parity = index.rem %row, %pair_width : index
    %is_odd = index.cmp ne, %parity, %begin : index
    %mask = scf.select %is_odd, %odd_mask, %even_mask : i8
    %value = view.load %input_bytes[%i] : view<336xi8> -> i8
    %result = scalar.xori %value, %mask : i8
    view.store %result, %output_bytes[%i] : i8, view<336xi8>
  }
  func.return
}

check.scenario @packed_byte_even_odd_mask_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-128) step(1) period(256) : tensor<264xi8>
    %output_storage = check.generate.fill value(91) : tensor<272xi8>
    %output = check.tensor.view %output_storage offset(4) : tensor<272xi8> -> tensor<264xi8>
    check.compare<@packed_byte_even_odd_mask, @packed_byte_even_odd_mask_oracle>(%input, %output) : (tensor<264xi8>, tensor<264xi8>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<264xi8>
      check.expect.bitwise actual(%output_storage) expected(%output_storage) : tensor<272xi8>
    }
  }
  check.trial[4](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-128 to 127) : tensor<264xi8>
    %output_storage = check.generate.fill value(-37) : tensor<272xi8>
    %output = check.tensor.view %output_storage offset(4) : tensor<272xi8> -> tensor<264xi8>
    check.compare<@packed_byte_even_odd_mask, @packed_byte_even_odd_mask_oracle>(%input, %output) : (tensor<264xi8>, tensor<264xi8>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<264xi8>
      check.expect.bitwise actual(%output_storage) expected(%output_storage) : tensor<272xi8>
    }
  }
  check.return
}

check.scenario @irregular_byte_row_mask_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-128) step(2) period(128) : tensor<336xi8>
    %output_storage = check.generate.fill value(83) : tensor<344xi8>
    %output = check.tensor.view %output_storage offset(4) : tensor<344xi8> -> tensor<336xi8>
    check.compare<@irregular_byte_row_mask, @irregular_byte_row_mask_oracle>(%input, %output) : (tensor<336xi8>, tensor<336xi8>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<336xi8>
      check.expect.bitwise actual(%output_storage) expected(%output_storage) : tensor<344xi8>
    }
  }
  check.trial[4](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-128 to 127) : tensor<336xi8>
    %output_storage = check.generate.fill value(-37) : tensor<344xi8>
    %output = check.tensor.view %output_storage offset(4) : tensor<344xi8> -> tensor<336xi8>
    check.compare<@irregular_byte_row_mask, @irregular_byte_row_mask_oracle>(%input, %output) : (tensor<336xi8>, tensor<336xi8>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<336xi8>
      check.expect.bitwise actual(%output_storage) expected(%output_storage) : tensor<344xi8>
    }
  }
  check.return
}

// The caller specializes packet lengths; input values remain runtime data.
// Zip, repeated-input zip, and both unzip results have distinct observable uses.
func.def inline @route_byte_packets(%count: index, %position: offset, %input: buffer, %other: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c6 = index.constant 6 : index
  %c7 = index.constant 7 : index
  %c8 = index.constant 8 : index
  %full = index.mul %count, %c2 : index
  %extent = index.mul %count, %c8 : index
  %split_even = index.mul %count, %c4 : index
  %split_odd = index.mul %count, %c5 : index
  %saved_left = index.mul %count, %c6 : index
  %saved_right = index.mul %count, %c7 : index
  %left_view = buffer.view %input[%base] : buffer -> view<[%full]xi8>
  %right_view = buffer.view %other[%base] : buffer -> view<[%full]xi8>
  %destination = buffer.view %output[%position] : buffer -> view<[%extent]xi8>
  %left = vector.load %left_view[0] : view<[%full]xi8> -> vector<[%count]xi8>
  %right = vector.load %right_view[0] : view<[%full]xi8> -> vector<[%count]xi8>
  %joined = vector.interleave<0> %left, %right : vector<[%count]xi8>, vector<[%count]xi8> -> vector<[%full]xi8>
  %repeated = vector.interleave<0> %left, %left : vector<[%count]xi8>, vector<[%count]xi8> -> vector<[%full]xi8>
  %mask = vector.splati 17 : vector<[%full]xi8>
  %joined_masked = vector.xori %joined, %mask : vector<[%full]xi8>
  %repeated_masked = vector.xori %repeated, %mask : vector<[%full]xi8>
  vector.store %joined_masked, %destination[0] : vector<[%full]xi8>, view<[%extent]xi8>
  vector.store %repeated_masked, %destination[%full] : vector<[%full]xi8>, view<[%extent]xi8>
  %source = vector.load %left_view[0] : view<[%full]xi8> -> vector<[%full]xi8>
  %even, %odd = vector.deinterleave<0> %source : vector<[%full]xi8> -> vector<[%count]xi8>, vector<[%count]xi8>
  %even_mask = vector.splati 1 : vector<[%count]xi8>
  %odd_mask = vector.splati -3 : vector<[%count]xi8>
  %even_masked = vector.xori %even, %even_mask : vector<[%count]xi8>
  %odd_masked = vector.xori %odd, %odd_mask : vector<[%count]xi8>
  vector.store %even_masked, %destination[%split_even] : vector<[%count]xi8>, view<[%extent]xi8>
  vector.store %odd_masked, %destination[%split_odd] : vector<[%count]xi8>, view<[%extent]xi8>
  vector.store %left, %destination[%saved_left] : vector<[%count]xi8>, view<[%extent]xi8>
  vector.store %right, %destination[%saved_right] : vector<[%count]xi8>, view<[%extent]xi8>
  func.return
}

