  %a0 = vector.extract %a[0] : vector<3xf64> -> f64
  %b0 = vector.extract %b[0] : vector<3xf64> -> f64
  %scalar = scf.select %condition, %a0, %b0 : f64
  %whole = scf.select %condition, %a, %b : vector<3xf64>
  %true = scalar.constant true : i1
  %inverse = scalar.xori %condition, %true : i1
  %mask = vector.from_elements %condition, %inverse, %condition : vector<3xi1>
  %lanes = vector.select %mask, %a, %b : vector<3xf64>
  %scalar_bits = scalar.bitcast %scalar : f64 to i64
  %whole_bits = vector.bitcast %whole : vector<3xf64> to vector<3xi64>
  %lane_bits = vector.bitcast %lanes : vector<3xf64> to vector<3xi64>
