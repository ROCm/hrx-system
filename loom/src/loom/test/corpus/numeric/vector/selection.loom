  %b = vector.load %b_view[0] : view<3xf32> -> vector<3xf32>
  %a0 = vector.extract %a[0] : vector<3xf32> -> f32
  %b0 = vector.extract %b[0] : vector<3xf32> -> f32
  %scalar = scf.select %condition, %a0, %b0 : f32
  %whole = scf.select %condition, %a, %b : vector<3xf32>
  %true = scalar.constant true : i1
  %inverse = scalar.xori %condition, %true : i1
  %mask = vector.from_elements %condition, %inverse, %condition : vector<3xi1>
  %lanes = vector.select %mask, %a, %b : vector<3xf32>
  %scalar_bits = scalar.bitcast %scalar : f32 to i32
  %whole_bits = vector.bitcast %whole : vector<3xf32> to vector<3xi32>
  %lane_bits = vector.bitcast %lanes : vector<3xf32> to vector<3xi32>
  %results = buffer.view %output[%origin] : buffer -> view<7xi32>
  view.store %scalar_bits, %results[0] : i32, view<7xi32>
  vector.store %whole_bits, %results[1] : vector<3xi32>, view<7xi32>
  vector.store %lane_bits, %results[4] : vector<3xi32>, view<7xi32>
  func.return
}

