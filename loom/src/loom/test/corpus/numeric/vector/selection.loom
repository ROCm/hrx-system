  view.store %scalar_bits, %results[0] : i64, view<7xi64>
  vector.store %whole_bits, %results[1] : vector<3xi64>, view<7xi64>
  vector.store %lane_bits, %results[4] : vector<3xi64>, view<7xi64>
  func.return
}

