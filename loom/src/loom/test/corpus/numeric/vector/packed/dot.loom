// Evaluates every byte signedness combination in one native packet. The final
// row keeps the Q6 offset-binary form used by quantized model kernels packed
// through the dot operation. One aligned storage argument keeps all input and
// output regions in the same executable binding without aliasing them.
func.def @packed_byte_dots(%storage_buffer: buffer) {
  %lhs_origin = index.constant 0 : offset
  %rhs_origin = index.constant 64 : offset
  %q6_origin = index.constant 128 : offset
  %accumulator_origin = index.constant 192 : offset
  %output_origin = index.constant 256 : offset
  %storage = buffer.assume.alignment %storage_buffer {minimum_alignment = 64} : buffer
  %lhs_view = buffer.view %storage[%lhs_origin] : buffer -> view<64xi8>
  %rhs_view = buffer.view %storage[%rhs_origin] : buffer -> view<64xi8>
  %q6_view = buffer.view %storage[%q6_origin] : buffer -> view<64xi8>
  %accumulator_view = buffer.view %storage[%accumulator_origin] : buffer -> view<16xi32>
  %outputs = buffer.view %storage[%output_origin] : buffer -> view<80xi32>
  %lhs = vector.load %lhs_view[0] : view<64xi8> -> vector<64xi8>
  %rhs = vector.load %rhs_view[0] : view<64xi8> -> vector<64xi8>
  %q6_raw = vector.load %q6_view[0] : view<64xi8> -> vector<64xi8>
  %accumulators = vector.load %accumulator_view[0] : view<16xi32> -> vector<16xi32>
  %s8s8 = vector.dot4i<s8s8> %lhs, %rhs, %accumulators : vector<64xi8>, vector<64xi8>, vector<16xi32>
  vector.store %s8s8, %outputs[0] : vector<16xi32>, view<80xi32>
  %u8u8 = vector.dot4i<u8u8> %lhs, %rhs, %accumulators : vector<64xi8>, vector<64xi8>, vector<16xi32>
  vector.store %u8u8, %outputs[16] : vector<16xi32>, view<80xi32>
  %u8s8 = vector.dot4i<u8s8> %lhs, %rhs, %accumulators : vector<64xi8>, vector<64xi8>, vector<16xi32>
  vector.store %u8s8, %outputs[32] : vector<16xi32>, view<80xi32>
  %s8u8 = vector.dot4i<s8u8> %lhs, %rhs, %accumulators : vector<64xi8>, vector<64xi8>, vector<16xi32>
  vector.store %s8u8, %outputs[48] : vector<16xi32>, view<80xi32>
  %q6_mask = vector.splati 63 : vector<64xi8>
  %q6_codes = vector.andi %q6_raw, %q6_mask : vector<64xi8>
  %q6_bias = vector.splati -32 : vector<64xi8>
  %q6_signed = vector.addi %q6_codes, %q6_bias : vector<64xi8>
  %q6 = vector.dot4i<s8s8> %q6_signed, %rhs, %accumulators : vector<64xi8>, vector<64xi8>, vector<16xi32>
  vector.store %q6, %outputs[64] : vector<16xi32>, view<80xi32>
  func.return
}

// A single packed word is the semantic unit of dot8i4. Repeated trials cover
// the lane values while avoiding target-specific packet-width assumptions.
func.def @packed_nibble_dots(%storage_buffer: buffer) {
  %lhs_origin = index.constant 0 : offset
  %rhs_origin = index.constant 64 : offset
  %accumulator_origin = index.constant 128 : offset
  %output_origin = index.constant 192 : offset
  %storage = buffer.assume.alignment %storage_buffer {minimum_alignment = 64} : buffer
  %lhs_view = buffer.view %storage[%lhs_origin] : buffer -> view<1xi32>
  %rhs_view = buffer.view %storage[%rhs_origin] : buffer -> view<1xi32>
  %accumulator_view = buffer.view %storage[%accumulator_origin] : buffer -> view<1xi32>
  %outputs = buffer.view %storage[%output_origin] : buffer -> view<2xi32>
  %lhs = vector.load %lhs_view[0] : view<1xi32> -> vector<1xi32>
  %rhs = vector.load %rhs_view[0] : view<1xi32> -> vector<1xi32>
  %accumulator = vector.load %accumulator_view[0] : view<1xi32> -> vector<1xi32>
  %s4s4 = vector.dot8i4<s4s4> %lhs, %rhs, %accumulator : vector<1xi32>
  vector.store %s4s4, %outputs[0] : vector<1xi32>, view<2xi32>
  %u4u4 = vector.dot8i4<u4u4> %lhs, %rhs, %accumulator : vector<1xi32>
  vector.store %u4u4, %outputs[1] : vector<1xi32>, view<2xi32>
  func.return
}

// Mixed signedness is a distinct target capability. Q4 offset-binary rows
// become signed nibbles by toggling each packed sign bit.
func.def @packed_mixed_nibble_dots(%storage_buffer: buffer) {
  %lhs_origin = index.constant 0 : offset
  %rhs_origin = index.constant 64 : offset
  %accumulator_origin = index.constant 128 : offset
  %output_origin = index.constant 192 : offset
  %storage = buffer.assume.alignment %storage_buffer {minimum_alignment = 64} : buffer
  %lhs_view = buffer.view %storage[%lhs_origin] : buffer -> view<1xi32>
  %rhs_view = buffer.view %storage[%rhs_origin] : buffer -> view<1xi32>
  %accumulator_view = buffer.view %storage[%accumulator_origin] : buffer -> view<1xi32>
  %outputs = buffer.view %storage[%output_origin] : buffer -> view<3xi32>
  %lhs = vector.load %lhs_view[0] : view<1xi32> -> vector<1xi32>
  %rhs = vector.load %rhs_view[0] : view<1xi32> -> vector<1xi32>
  %accumulator = vector.load %accumulator_view[0] : view<1xi32> -> vector<1xi32>
  %u4s4 = vector.dot8i4<u4s4> %lhs, %rhs, %accumulator : vector<1xi32>
  vector.store %u4s4, %outputs[0] : vector<1xi32>, view<3xi32>
  %s4u4 = vector.dot8i4<s4u4> %lhs, %rhs, %accumulator : vector<1xi32>
  vector.store %s4u4, %outputs[1] : vector<1xi32>, view<3xi32>
  %offset_to_signed_mask = vector.splati -2004318072 : vector<1xi32>
  %signed_lhs = vector.xori %lhs, %offset_to_signed_mask : vector<1xi32>
  %q4 = vector.dot8i4<s4u4> %signed_lhs, %rhs, %accumulator : vector<1xi32>
  vector.store %q4, %outputs[2] : vector<1xi32>, view<3xi32>
  func.return
}

// Scalar loops keep the oracles independent of packed vector dot lowering.
func.def inline @dot4_reference(%lhs: view<64xi8>, %rhs: view<64xi8>, %q6_codes: view<64xi8>, %base: index, %initial: i32) -> (i32, i32, i32, i32, i32) {
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %q6_mask = scalar.constant 63 : i8
  %q6_bias = scalar.constant -32 : i8
  %s8s8, %u8u8, %u8s8, %s8u8, %q6 = scf.for %lane = [%begin to %end step %step](%s8s8_acc = %initial : i32, %u8u8_acc = %initial : i32, %u8s8_acc = %initial : i32, %s8u8_acc = %initial : i32, %q6_acc = %initial : i32) -> (i32, i32, i32, i32, i32) {
    %position = index.add %base, %lane : index
    %lhs_value = view.load %lhs[%position] : view<64xi8> -> i8
    %rhs_value = view.load %rhs[%position] : view<64xi8> -> i8
    %q6_raw = view.load %q6_codes[%position] : view<64xi8> -> i8
    %lhs_signed = scalar.extsi %lhs_value : i8 to i32
    %lhs_unsigned = scalar.extui %lhs_value : i8 to i32
    %rhs_signed = scalar.extsi %rhs_value : i8 to i32
    %rhs_unsigned = scalar.extui %rhs_value : i8 to i32
    %q6_code = scalar.andi %q6_raw, %q6_mask : i8
    %q6_value = scalar.addi %q6_code, %q6_bias : i8
    %q6_signed = scalar.extsi %q6_value : i8 to i32
    %s8s8_product = scalar.muli %lhs_signed, %rhs_signed : i32
    %u8u8_product = scalar.muli %lhs_unsigned, %rhs_unsigned : i32
    %u8s8_product = scalar.muli %lhs_unsigned, %rhs_signed : i32
    %s8u8_product = scalar.muli %lhs_signed, %rhs_unsigned : i32
    %q6_product = scalar.muli %q6_signed, %rhs_signed : i32
    %next_s8s8 = scalar.addi %s8s8_acc, %s8s8_product : i32
    %next_u8u8 = scalar.addi %u8u8_acc, %u8u8_product : i32
    %next_u8s8 = scalar.addi %u8s8_acc, %u8s8_product : i32
    %next_s8u8 = scalar.addi %s8u8_acc, %s8u8_product : i32
    %next_q6 = scalar.addi %q6_acc, %q6_product : i32
    scf.yield %next_s8s8, %next_u8u8, %next_u8s8, %next_s8u8, %next_q6 : i32, i32, i32, i32, i32
  }
  func.return %s8s8, %u8u8, %u8s8, %s8u8, %q6 : i32, i32, i32, i32, i32
}

func.def inline @dot8_reference(%lhs: i32, %rhs: i32, %initial: i32) -> (i32, i32, i32, i32, i32) {
  %begin = index.constant 0 : index
  %end = index.constant 8 : index
  %step = index.constant 1 : index
  %nibble_width = index.constant 4 : index
  %mask = scalar.constant 15 : i32
  %sign_shift = scalar.constant 28 : i32
  %offset = scalar.constant 8 : i32
  %s4s4, %u4u4, %u4s4, %s4u4, %q4 = scf.for %lane = [%begin to %end step %step](%s4s4_acc = %initial : i32, %u4u4_acc = %initial : i32, %u4s4_acc = %initial : i32, %s4u4_acc = %initial : i32, %q4_acc = %initial : i32) -> (i32, i32, i32, i32, i32) {
    %bit_position_index = index.mul %lane, %nibble_width : index
    %bit_position = index.cast %bit_position_index : index to i32
    %lhs_shifted = scalar.shrui %lhs, %bit_position : i32
    %rhs_shifted = scalar.shrui %rhs, %bit_position : i32
    %lhs_unsigned = scalar.andi %lhs_shifted, %mask : i32
    %rhs_unsigned = scalar.andi %rhs_shifted, %mask : i32
    %lhs_sign_positioned = scalar.shli %lhs_unsigned, %sign_shift : i32
    %rhs_sign_positioned = scalar.shli %rhs_unsigned, %sign_shift : i32
    %lhs_signed = scalar.shrsi %lhs_sign_positioned, %sign_shift : i32
    %rhs_signed = scalar.shrsi %rhs_sign_positioned, %sign_shift : i32
    %q4_signed = scalar.subi %lhs_unsigned, %offset : i32
    %s4s4_product = scalar.muli %lhs_signed, %rhs_signed : i32
    %u4u4_product = scalar.muli %lhs_unsigned, %rhs_unsigned : i32
    %u4s4_product = scalar.muli %lhs_unsigned, %rhs_signed : i32
    %s4u4_product = scalar.muli %lhs_signed, %rhs_unsigned : i32
    %q4_product = scalar.muli %q4_signed, %rhs_unsigned : i32
    %next_s4s4 = scalar.addi %s4s4_acc, %s4s4_product : i32
    %next_u4u4 = scalar.addi %u4u4_acc, %u4u4_product : i32
    %next_u4s4 = scalar.addi %u4s4_acc, %u4s4_product : i32
    %next_s4u4 = scalar.addi %s4u4_acc, %s4u4_product : i32
    %next_q4 = scalar.addi %q4_acc, %q4_product : i32
    scf.yield %next_s4s4, %next_u4u4, %next_u4s4, %next_s4u4, %next_q4 : i32, i32, i32, i32, i32
  }
  func.return %s4s4, %u4u4, %u4s4, %s4u4, %q4 : i32, i32, i32, i32, i32
}

func.def @packed_byte_dots_oracle(%storage_buffer: buffer) {
  %lhs_origin = index.constant 0 : offset
  %rhs_origin = index.constant 64 : offset
  %q6_origin = index.constant 128 : offset
  %accumulator_origin = index.constant 192 : offset
  %output_origin = index.constant 256 : offset
  %begin = index.constant 0 : index
  %end = index.constant 16 : index
  %step = index.constant 1 : index
  %byte_group_width = index.constant 4 : index
  %row_width = index.constant 16 : index
  %lhs = buffer.view %storage_buffer[%lhs_origin] : buffer -> view<64xi8>
  %rhs = buffer.view %storage_buffer[%rhs_origin] : buffer -> view<64xi8>
  %q6_codes = buffer.view %storage_buffer[%q6_origin] : buffer -> view<64xi8>
  %accumulators = buffer.view %storage_buffer[%accumulator_origin] : buffer -> view<16xi32>
  %outputs = buffer.view %storage_buffer[%output_origin] : buffer -> view<80xi32>
  scf.for %group = [%begin to %end step %step] {
    %byte_base = index.mul %group, %byte_group_width : index
    %initial = view.load %accumulators[%group] : view<16xi32> -> i32
    %s8s8, %u8u8, %u8s8, %s8u8, %q6 = func.call @dot4_reference(%lhs, %rhs, %q6_codes, %byte_base, %initial) : (view<64xi8>, view<64xi8>, view<64xi8>, index, i32) -> (i32, i32, i32, i32, i32)
    view.store %s8s8, %outputs[%group] : i32, view<80xi32>
    %row1 = index.add %group, %row_width : index
    view.store %u8u8, %outputs[%row1] : i32, view<80xi32>
    %row2 = index.add %row1, %row_width : index
    view.store %u8s8, %outputs[%row2] : i32, view<80xi32>
    %row3 = index.add %row2, %row_width : index
    view.store %s8u8, %outputs[%row3] : i32, view<80xi32>
    %row4 = index.add %row3, %row_width : index
    view.store %q6, %outputs[%row4] : i32, view<80xi32>
  }
  func.return
}

func.def @packed_nibble_dots_oracle(%storage_buffer: buffer) {
  %lhs_origin = index.constant 0 : offset
  %rhs_origin = index.constant 64 : offset
  %accumulator_origin = index.constant 128 : offset
  %output_origin = index.constant 192 : offset
  %lhs = buffer.view %storage_buffer[%lhs_origin] : buffer -> view<1xi32>
  %rhs = buffer.view %storage_buffer[%rhs_origin] : buffer -> view<1xi32>
  %accumulator = buffer.view %storage_buffer[%accumulator_origin] : buffer -> view<1xi32>
  %outputs = buffer.view %storage_buffer[%output_origin] : buffer -> view<2xi32>
  %lhs_word = view.load %lhs[0] : view<1xi32> -> i32
  %rhs_word = view.load %rhs[0] : view<1xi32> -> i32
  %initial = view.load %accumulator[0] : view<1xi32> -> i32
  %s4s4, %u4u4, %u4s4, %s4u4, %q4 = func.call @dot8_reference(%lhs_word, %rhs_word, %initial) : (i32, i32, i32) -> (i32, i32, i32, i32, i32)
  view.store %s4s4, %outputs[0] : i32, view<2xi32>
  view.store %u4u4, %outputs[1] : i32, view<2xi32>
  func.return
}

func.def @packed_mixed_nibble_dots_oracle(%storage_buffer: buffer) {
  %lhs_origin = index.constant 0 : offset
  %rhs_origin = index.constant 64 : offset
  %accumulator_origin = index.constant 128 : offset
  %output_origin = index.constant 192 : offset
  %lhs = buffer.view %storage_buffer[%lhs_origin] : buffer -> view<1xi32>
  %rhs = buffer.view %storage_buffer[%rhs_origin] : buffer -> view<1xi32>
  %accumulator = buffer.view %storage_buffer[%accumulator_origin] : buffer -> view<1xi32>
  %outputs = buffer.view %storage_buffer[%output_origin] : buffer -> view<3xi32>
  %lhs_word = view.load %lhs[0] : view<1xi32> -> i32
  %rhs_word = view.load %rhs[0] : view<1xi32> -> i32
  %initial = view.load %accumulator[0] : view<1xi32> -> i32
  %s4s4, %u4u4, %u4s4, %s4u4, %q4 = func.call @dot8_reference(%lhs_word, %rhs_word, %initial) : (i32, i32, i32) -> (i32, i32, i32, i32, i32)
  view.store %u4s4, %outputs[0] : i32, view<3xi32>
  view.store %s4u4, %outputs[1] : i32, view<3xi32>
  view.store %q4, %outputs[2] : i32, view<3xi32>
  func.return
}

check.scenario @packed_byte_dot_values {
  check.trial[8](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %storage = check.generate.random.uniform seed(%seed) range(-2147483648 to 2147483647) : tensor<160xi32>
    check.compare<@packed_byte_dots, @packed_byte_dots_oracle>(%storage) : (tensor<160xi32>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<160xi32>
    }
  }
  check.return
}

check.scenario @packed_nibble_dot_values {
  check.trial[16](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %storage = check.generate.random.uniform seed(%seed) range(-2147483648 to 2147483647) : tensor<64xi32>
    check.compare<@packed_nibble_dots, @packed_nibble_dots_oracle>(%storage) : (tensor<64xi32>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<64xi32>
    }
  }
  check.return
}

check.scenario @packed_mixed_nibble_dot_values {
  check.trial[16](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %storage = check.generate.random.uniform seed(%seed) range(-2147483648 to 2147483647) : tensor<64xi32>
    check.compare<@packed_mixed_nibble_dots, @packed_mixed_nibble_dots_oracle>(%storage) : (tensor<64xi32>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<64xi32>
    }
  }
  check.return
}
