func.def @truncate_halfwords(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %aligned = buffer.assume.alignment %input {minimum_alignment = 16} : buffer
  %inputs = buffer.view %aligned[%base] : buffer -> view<64xi16>
  %outputs = buffer.view %output[%base] : buffer -> view<64xi8>
  %halves = vector.load %inputs[0] : view<64xi16> -> vector<64xi16>
  %bytes = vector.trunci %halves : vector<64xi16> to vector<64xi8>
  vector.store %bytes, %outputs[0] : vector<64xi8>, view<64xi8>
  func.return
}

func.def @truncate_halfwords_oracle(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 64 : index
  %step = index.constant 1 : index
  %inputs = buffer.view %input[%base] : buffer -> view<64xi16>
  %outputs = buffer.view %output[%base] : buffer -> view<64xi8>
  scf.for %i = [%begin to %end step %step] {
    %half = view.load %inputs[%i] : view<64xi16> -> i16
    %byte = scalar.trunci %half : i16 to i8
    view.store %byte, %outputs[%i] : i8, view<64xi8>
  }
  func.return
}

check.scenario @halfword_truncation_values {
  check.trial[64](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-32768 to 32767) : tensor<64xi16>
    %storage = check.generate.fill value(-91) : tensor<96xi8>
    %output = check.tensor.view %storage offset(16) : tensor<96xi8> -> tensor<64xi8>
    check.compare<@truncate_halfwords, @truncate_halfwords_oracle>(%input, %output) : (tensor<64xi16>, tensor<64xi8>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<96xi8>
    }
  }
  check.return
}

func.def @pack_nibbles(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %aligned = buffer.assume.alignment %input {minimum_alignment = 16} : buffer
  %inputs = buffer.view %aligned[%base] : buffer -> view<128xi8>
  %outputs = buffer.view %output[%base] : buffer -> view<96xi8>
  %bytes64 = vector.load %inputs[0] : view<128xi8> -> vector<64xi8>
  %packed32 = vector.bitpack<4> %bytes64 : vector<64xi8> -> vector<32xi8>
  vector.store %packed32, %outputs[0] : vector<32xi8>, view<96xi8>
  %bytes128 = vector.load %inputs[0] : view<128xi8> -> vector<128xi8>
  %packed64 = vector.bitpack<4> %bytes128 : vector<128xi8> -> vector<64xi8>
  vector.store %packed64, %outputs[32] : vector<64xi8>, view<96xi8>
  func.return
}

func.def @pack_nibbles_oracle(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 64 : index
  %step = index.constant 1 : index
  %c2 = index.constant 2 : index
  %inputs = buffer.view %input[%base] : buffer -> view<128xi8>
  %outputs = buffer.view %output[%base] : buffer -> view<96xi8>
  scf.for %i = [%begin to %end step %step] {
    %even = index.mul %i, %c2 : index
    %odd = index.add %even, %step : index
    %low = view.load %inputs[%even] : view<128xi8> -> i8
    %high = view.load %inputs[%odd] : view<128xi8> -> i8
    %mask = scalar.constant 15 : i8
    %shift = scalar.constant 4 : i8
    %low_nibble = scalar.andi %low, %mask : i8
    %high_nibble = scalar.shli %high, %shift : i8
    %packed = scalar.ori %low_nibble, %high_nibble : i8
    %c32 = index.constant 32 : index
    %position = index.add %i, %c32 : index
    view.store %packed, %outputs[%position] : i8, view<96xi8>
    %below32 = index.cmp ult, %i, %c32 : index
    scf.if %below32 {
      view.store %packed, %outputs[%i] : i8, view<96xi8>
    }
  }
  func.return
}

check.scenario @packed_nibble_values {
  check.trial[64](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-128 to 127) : tensor<128xi8>
    %expected_input = check.generate.random.uniform seed(%seed) range(-128 to 127) : tensor<128xi8>
    %storage = check.generate.fill value(-91) : tensor<128xi8>
    %output = check.tensor.view %storage offset(16) : tensor<128xi8> -> tensor<96xi8>
    check.compare<@pack_nibbles, @pack_nibbles_oracle>(%input, %output) : (tensor<128xi8>, tensor<96xi8>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<128xi8>
      check.expect.bitwise actual(%input) expected(%expected_input) : tensor<128xi8>
    }
  }
  check.return
}

// Packs sixteen three-bit fields across a 32-bit word boundary, then observes
// the same 48-bit stream through unsigned and signed unpacking. A one-bit
// signed unpack also covers the predicate result boundary.
func.def @odd_width_bitstream(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %inputs = buffer.view %input[%base] : buffer -> view<16xi8>
  %outputs = buffer.view %output[%base] : buffer -> view<56xi8>
  %values = vector.load %inputs[0] : view<16xi8> -> vector<16xi8>
  %packed = vector.bitpack<3> %values : vector<16xi8> -> vector<6xi8>
  %unsigned = vector.bitunpacku<3> %packed : vector<6xi8> -> vector<16xi8>
  %signed = vector.bitunpacks<3> %packed : vector<6xi8> -> vector<16xi8>
  %predicate_storage = vector.slice %values[0] : vector<16xi8> -> vector<2xi8>
  %predicates = vector.bitunpacks<1> %predicate_storage : vector<2xi8> -> vector<16xi1>
  %predicate_bytes = vector.extui %predicates : vector<16xi1> to vector<16xi8>
  // Scalar consumers observe the same bits through the vector lane facts.
  %low_predicate = vector.extract %predicate_bytes[0] : vector<16xi8> -> i8
  %high_predicate = vector.extract %predicate_bytes[7] : vector<16xi8> -> i8
  vector.store %packed, %outputs[0] : vector<6xi8>, view<56xi8>
  vector.store %unsigned, %outputs[6] : vector<16xi8>, view<56xi8>
  vector.store %signed, %outputs[22] : vector<16xi8>, view<56xi8>
  view.store %low_predicate, %outputs[38] : i8, view<56xi8>
  view.store %high_predicate, %outputs[39] : i8, view<56xi8>
  vector.store %predicate_bytes, %outputs[40] : vector<16xi8>, view<56xi8>
  func.return
}

func.def @odd_width_bitstream_oracle(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %group_count = index.constant 2 : index
  %group_lane_count = index.constant 8 : index
  %group_byte_count = index.constant 3 : index
  %unsigned_offset = index.constant 6 : index
  %signed_offset = index.constant 22 : index
  %c0 = scalar.constant 0 : i32
  %field_mask = scalar.constant 7 : i32
  %field_bit_count = scalar.constant 3 : i32
  %byte_bit_count = scalar.constant 8 : i32
  %sign_shift = scalar.constant 29 : i32
  %c1 = scalar.constant 1 : i32
  %predicate_offset = index.constant 40 : index
  %inputs = buffer.view %input[%base] : buffer -> view<16xi8>
  %outputs = buffer.view %output[%base] : buffer -> view<56xi8>
  scf.for %group = [%begin to %group_count step %step] {
    %group_origin = index.mul %group, %group_lane_count : index
    %word = scf.for %lane = [%begin to %group_lane_count step %step](%partial = %c0 : i32) -> (i32) {
      %position = index.add %group_origin, %lane : index
      %value = view.load %inputs[%position] : view<16xi8> -> i8
      %wide_value = scalar.extui %value : i8 to i32
      %field = scalar.andi %wide_value, %field_mask : i32
      %lane_i32 = index.cast %lane : index to i32
      %field_shift = scalar.muli %lane_i32, %field_bit_count : i32
      %shifted_field = scalar.shli %field, %field_shift : i32
      %next = scalar.ori %partial, %shifted_field : i32
      %unsigned_value = scalar.trunci %field : i32 to i8
      %sign_aligned = scalar.shli %field, %sign_shift : i32
      %signed_value_i32 = scalar.shrsi %sign_aligned, %sign_shift : i32
      %signed_value = scalar.trunci %signed_value_i32 : i32 to i8
      %unsigned_position = index.add %position, %unsigned_offset : index
      %signed_position = index.add %position, %signed_offset : index
      view.store %unsigned_value, %outputs[%unsigned_position] : i8, view<56xi8>
      view.store %signed_value, %outputs[%signed_position] : i8, view<56xi8>
      scf.yield %next : i32
    }
    %byte_origin = index.mul %group, %group_byte_count : index
    scf.for %byte = [%begin to %group_byte_count step %step] {
      %byte_i32 = index.cast %byte : index to i32
      %byte_shift = scalar.muli %byte_i32, %byte_bit_count : i32
      %shifted_word = scalar.shrui %word, %byte_shift : i32
      %value = scalar.trunci %shifted_word : i32 to i8
      %position = index.add %byte_origin, %byte : index
      view.store %value, %outputs[%position] : i8, view<56xi8>
    }
  }
  scf.for %byte = [%begin to %group_count step %step] {
    %value = view.load %inputs[%byte] : view<16xi8> -> i8
    %wide_value = scalar.extui %value : i8 to i32
    %byte_origin = index.mul %byte, %group_lane_count : index
    scf.for %bit = [%begin to %group_lane_count step %step] {
      %bit_i32 = index.cast %bit : index to i32
      %shifted_value = scalar.shrui %wide_value, %bit_i32 : i32
      %predicate = scalar.andi %shifted_value, %c1 : i32
      %predicate_byte = scalar.trunci %predicate : i32 to i8
      %position_in_predicates = index.add %byte_origin, %bit : index
      %position = index.add %predicate_offset, %position_in_predicates : index
      view.store %predicate_byte, %outputs[%position] : i8, view<56xi8>
    }
  }
  %first_input = view.load %inputs[0] : view<16xi8> -> i8
  %first_word = scalar.extui %first_input : i8 to i32
  %low_bit = scalar.andi %first_word, %c1 : i32
  %high_shift = scalar.constant 7 : i32
  %high_bit = scalar.shrui %first_word, %high_shift : i32
  %low_predicate = scalar.trunci %low_bit : i32 to i8
  %high_predicate = scalar.trunci %high_bit : i32 to i8
  view.store %low_predicate, %outputs[38] : i8, view<56xi8>
  view.store %high_predicate, %outputs[39] : i8, view<56xi8>
  func.return
}

check.scenario @odd_width_bitstream_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-8) step(1) : tensor<16xi8>
    %expected_input = check.generate.iota offset(-8) step(1) : tensor<16xi8>
    %storage = check.generate.fill value(-91) : tensor<64xi8>
    %output = check.tensor.view %storage offset(4) : tensor<64xi8> -> tensor<56xi8>
    check.compare<@odd_width_bitstream, @odd_width_bitstream_oracle>(%input, %output) : (tensor<16xi8>, tensor<56xi8>) -> () {
      check.expect.bitwise actual(%input) expected(%expected_input) : tensor<16xi8>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<64xi8>
    }
  }
  check.return
}

func.def @saturating_nibble_pack64(%input: buffer, %output: buffer) {
  %source, %destination = buffer.assume.alignment %input, %output {minimum_alignment = 64} : buffer, buffer
  %origin = index.constant 0 : offset
  %input_view = buffer.view %source[%origin] : buffer -> view<256xi8>
  %output_view = buffer.view %destination[%origin] : buffer -> view<384xi8>
  %guard = vector.splati -91 : vector<64xi8>
  vector.store %guard, %output_view[0] : vector<64xi8>, view<384xi8>
  vector.store %guard, %output_view[320] : vector<64xi8>, view<384xi8>
  %lower = vector.splati -8 : vector<64xi8>
  %upper = vector.splati 7 : vector<64xi8>
  %values_0 = vector.load %input_view[0] : view<256xi8> -> vector<64xi8>
  %lower_clamped_0 = vector.maxsi %values_0, %lower : vector<64xi8>
  %clamped_0 = vector.minsi %lower_clamped_0, %upper : vector<64xi8>
  %saturated_0 = vector.bitpack<4> %clamped_0 : vector<64xi8> -> vector<32xi8>
  vector.store %saturated_0, %output_view[64] : vector<32xi8>, view<384xi8>
  %truncated_0 = vector.bitpack<4> %values_0 : vector<64xi8> -> vector<32xi8>
  vector.store %truncated_0, %output_view[192] : vector<32xi8>, view<384xi8>
  %values_1 = vector.load %input_view[64] : view<256xi8> -> vector<64xi8>
  %lower_clamped_1 = vector.maxsi %lower, %values_1 : vector<64xi8>
  %clamped_1 = vector.minsi %lower_clamped_1, %upper : vector<64xi8>
  %saturated_1 = vector.bitpack<4> %clamped_1 : vector<64xi8> -> vector<32xi8>
  vector.store %saturated_1, %output_view[96] : vector<32xi8>, view<384xi8>
  %truncated_1 = vector.bitpack<4> %values_1 : vector<64xi8> -> vector<32xi8>
  vector.store %truncated_1, %output_view[224] : vector<32xi8>, view<384xi8>
  %values_2 = vector.load %input_view[128] : view<256xi8> -> vector<64xi8>
  %lower_clamped_2 = vector.maxsi %values_2, %lower : vector<64xi8>
  %clamped_2 = vector.minsi %upper, %lower_clamped_2 : vector<64xi8>
  %saturated_2 = vector.bitpack<4> %clamped_2 : vector<64xi8> -> vector<32xi8>
  vector.store %saturated_2, %output_view[128] : vector<32xi8>, view<384xi8>
  %truncated_2 = vector.bitpack<4> %values_2 : vector<64xi8> -> vector<32xi8>
  vector.store %truncated_2, %output_view[256] : vector<32xi8>, view<384xi8>
  %values_3 = vector.load %input_view[192] : view<256xi8> -> vector<64xi8>
  %lower_clamped_3 = vector.maxsi %lower, %values_3 : vector<64xi8>
  %clamped_3 = vector.minsi %upper, %lower_clamped_3 : vector<64xi8>
  %saturated_3 = vector.bitpack<4> %clamped_3 : vector<64xi8> -> vector<32xi8>
  vector.store %saturated_3, %output_view[160] : vector<32xi8>, view<384xi8>
  %truncated_3 = vector.bitpack<4> %values_3 : vector<64xi8> -> vector<32xi8>
  vector.store %truncated_3, %output_view[288] : vector<32xi8>, view<384xi8>
  func.return
}

func.def @saturating_nibble_pack128(%input: buffer, %output: buffer) {
  %source, %destination = buffer.assume.alignment %input, %output {minimum_alignment = 64} : buffer, buffer
  %origin = index.constant 0 : offset
  %input_view = buffer.view %source[%origin] : buffer -> view<256xi8>
  %output_view = buffer.view %destination[%origin] : buffer -> view<384xi8>
  %guard = vector.splati -91 : vector<64xi8>
  vector.store %guard, %output_view[0] : vector<64xi8>, view<384xi8>
  vector.store %guard, %output_view[320] : vector<64xi8>, view<384xi8>
  %lower = vector.splati -8 : vector<128xi8>
  %upper = vector.splati 7 : vector<128xi8>
  %values_0 = vector.load %input_view[0] : view<256xi8> -> vector<128xi8>
  %upper_clamped_0 = vector.minsi %values_0, %upper : vector<128xi8>
  %clamped_0 = vector.maxsi %upper_clamped_0, %lower : vector<128xi8>
  %saturated_0 = vector.bitpack<4> %clamped_0 : vector<128xi8> -> vector<64xi8>
  vector.store %saturated_0, %output_view[64] : vector<64xi8>, view<384xi8>
  %truncated_0 = vector.bitpack<4> %values_0 : vector<128xi8> -> vector<64xi8>
  vector.store %truncated_0, %output_view[192] : vector<64xi8>, view<384xi8>
  %values_1 = vector.load %input_view[128] : view<256xi8> -> vector<128xi8>
  %upper_clamped_1 = vector.minsi %upper, %values_1 : vector<128xi8>
  %clamped_1 = vector.maxsi %lower, %upper_clamped_1 : vector<128xi8>
  %saturated_1 = vector.bitpack<4> %clamped_1 : vector<128xi8> -> vector<64xi8>
  vector.store %saturated_1, %output_view[128] : vector<64xi8>, view<384xi8>
  %truncated_1 = vector.bitpack<4> %values_1 : vector<128xi8> -> vector<64xi8>
  vector.store %truncated_1, %output_view[256] : vector<64xi8>, view<384xi8>
  func.return
}

// Odd multipliers visit every signed byte pattern with different neighbors.
func.def @generate_pack_input(%trial: index, %input: buffer) {
  %origin = index.constant 0 : offset
  %destination = buffer.view %input[%origin] : buffer -> view<256xi8>
  %begin = index.constant 0 : index
  %end = index.constant 256 : index
  %step = index.constant 1 : index
  %record = index.cast %trial : index to i32
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %c37 = scalar.constant 37 : i32
  %c128 = scalar.constant 128 : i32
  %scaled = scalar.muli %record, %c2 : i32
  %multiplier = scalar.addi %scaled, %c1 : i32
  %record_bias = scalar.muli %record, %c37 : i32
  %bias = scalar.subi %record_bias, %c128 : i32
  scf.for %i = [%begin to %end step %step] {
    %position = index.cast %i : index to i32
    %product = scalar.muli %position, %multiplier : i32
    %value = scalar.addi %product, %bias : i32
    %byte = scalar.trunci %value : i32 to i8
    view.store %byte, %destination[%i] : i8, view<256xi8>
  }
  func.return
}

func.def @pack_reference(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %source = buffer.view %input[%origin] : buffer -> view<256xi8>
  %destination = buffer.view %output[%origin] : buffer -> view<384xi8>
  %begin = index.constant 0 : index
  %output_length = index.constant 384 : index
  %pairs = index.constant 128 : index
  %step = index.constant 1 : index
  %pair_width = index.constant 2 : index
  %saturated_origin = index.constant 64 : index
  %truncated_origin = index.constant 192 : index
  %sentinel = scalar.constant -91 : i8
  %lower = scalar.constant -8 : i8
  %upper = scalar.constant 7 : i8
  %mask = scalar.constant 15 : i8
  %shift = scalar.constant 4 : i8
  scf.for %i = [%begin to %output_length step %step] {
    view.store %sentinel, %destination[%i] : i8, view<384xi8>
  }
  scf.for %i = [%begin to %pairs step %step] {
    %first_position = index.mul %i, %pair_width : index
    %second_position = index.add %first_position, %step : index
    %first = view.load %source[%first_position] : view<256xi8> -> i8
    %second = view.load %source[%second_position] : view<256xi8> -> i8
    %first_above = scalar.maxsi %first, %lower : i8
    %first_clamped = scalar.minsi %first_above, %upper : i8
    %second_above = scalar.maxsi %second, %lower : i8
    %second_clamped = scalar.minsi %second_above, %upper : i8
    %first_nibble = scalar.andi %first_clamped, %mask : i8
    %second_nibble = scalar.shli %second_clamped, %shift : i8
    %saturated = scalar.ori %first_nibble, %second_nibble : i8
    %first_bits = scalar.andi %first, %mask : i8
    %second_bits = scalar.shli %second, %shift : i8
    %truncated = scalar.ori %first_bits, %second_bits : i8
    %saturated_position = index.add %saturated_origin, %i : index
    %truncated_position = index.add %truncated_origin, %i : index
    view.store %saturated, %destination[%saturated_position] : i8, view<384xi8>
    view.store %truncated, %destination[%truncated_position] : i8, view<384xi8>
  }
  func.return
}

// Both widths alternate saturation and truncation within each invocation.
check.scenario @saturating_nibble_values {
  check.trial[6](%trial: index, %entropy: check.entropy) {
    %input_storage = check.generate.fill value(90) : tensor<384xi8>
    %input = check.tensor.view %input_storage offset(64) : tensor<384xi8> -> tensor<256xi8>
    check.generate<@generate_pack_input>(%trial, %input) : (index, tensor<256xi8>) -> ()
    %output_storage = check.generate.fill value(-52) : tensor<512xi8>
    %output = check.tensor.view %output_storage offset(64) : tensor<512xi8> -> tensor<384xi8>
    check.compare<@saturating_nibble_pack64, @pack_reference>(%input, %output) : (tensor<256xi8>, tensor<384xi8>) -> () {
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<384xi8>
      check.expect.bitwise actual(%output_storage) expected(%output_storage) : tensor<512xi8>
    }
  }
  check.trial[6](%trial: index, %entropy: check.entropy) {
    %input_storage = check.generate.fill value(90) : tensor<384xi8>
    %input = check.tensor.view %input_storage offset(64) : tensor<384xi8> -> tensor<256xi8>
    check.generate<@generate_pack_input>(%trial, %input) : (index, tensor<256xi8>) -> ()
    %output_storage = check.generate.fill value(-52) : tensor<512xi8>
    %output = check.tensor.view %output_storage offset(64) : tensor<512xi8> -> tensor<384xi8>
    check.compare<@saturating_nibble_pack128, @pack_reference>(%input, %output) : (tensor<256xi8>, tensor<384xi8>) -> () {
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<384xi8>
      check.expect.bitwise actual(%output_storage) expected(%output_storage) : tensor<512xi8>
    }
  }
  check.return
}
