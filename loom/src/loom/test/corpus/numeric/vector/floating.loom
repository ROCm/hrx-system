func.def inline @vector_floating_rounded_bits(%value: f32) -> (i32) {
  %bits = scalar.bitcast %value : f32 to i32
  %is_nan = scalar.isnanf %value : f32
  %nan_bits = scalar.constant 2143289344 : i32
  %observed = scf.select %is_nan, %nan_bits, %bits : i32
  func.return %observed : i32
}

// Dynamic lanes cover vector rounding and sign manipulation. Rounding
// canonicalizes NaNs; abs and copysign retain exact payload and sign bits.
func.def @vector_floating_observations(%a_bits: i64, %b_bits: i64, %output: buffer) {
  %a_word = scalar.trunci %a_bits : i64 to i32
  %b_word = scalar.trunci %b_bits : i64 to i32
  %a = scalar.bitcast %a_word : i32 to f32
  %b = scalar.bitcast %b_word : i32 to f32
  %values = vector.from_elements %a, %b : vector<2xf32>
  %signs = vector.from_elements %b, %a : vector<2xf32>
  %rounded = vector.roundevenf %values : vector<2xf32>
  %truncated = vector.truncf %values : vector<2xf32>
  %absolute = vector.absf %values : vector<2xf32>
  %copied = vector.copysignf %values, %signs : vector<2xf32>
  %r0 = vector.extract %rounded[0] : vector<2xf32> -> f32
  %r1 = vector.extract %rounded[1] : vector<2xf32> -> f32
  %t0 = vector.extract %truncated[0] : vector<2xf32> -> f32
  %t1 = vector.extract %truncated[1] : vector<2xf32> -> f32
  %a0 = vector.extract %absolute[0] : vector<2xf32> -> f32
  %a1 = vector.extract %absolute[1] : vector<2xf32> -> f32
  %c0 = vector.extract %copied[0] : vector<2xf32> -> f32
  %c1 = vector.extract %copied[1] : vector<2xf32> -> f32
  %rb0 = func.call @vector_floating_rounded_bits(%r0) : (f32) -> (i32)
  %rb1 = func.call @vector_floating_rounded_bits(%r1) : (f32) -> (i32)
  %tb0 = func.call @vector_floating_rounded_bits(%t0) : (f32) -> (i32)
  %tb1 = func.call @vector_floating_rounded_bits(%t1) : (f32) -> (i32)
  %ab0 = scalar.bitcast %a0 : f32 to i32
  %ab1 = scalar.bitcast %a1 : f32 to i32
  %cb0 = scalar.bitcast %c0 : f32 to i32
  %cb1 = scalar.bitcast %c1 : f32 to i32
  %base = index.constant 0 : offset
  %results = buffer.view %output[%base] : buffer -> view<8xi32>
  view.store %rb0, %results[0] : i32, view<8xi32>
  view.store %rb1, %results[1] : i32, view<8xi32>
  view.store %tb0, %results[2] : i32, view<8xi32>
  view.store %tb1, %results[3] : i32, view<8xi32>
  view.store %ab0, %results[4] : i32, view<8xi32>
  view.store %ab1, %results[5] : i32, view<8xi32>
  view.store %cb0, %results[6] : i32, view<8xi32>
  view.store %cb1, %results[7] : i32, view<8xi32>
  func.return
}

check.scenario @vector_floating_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %a_bits = check.literal value(1069547520) : i64
    %b_bits = check.literal value(-1071644672) : i64
    %output = check.generate.fill value(0) : tensor<8xi32>
    check.compare<@vector_floating_observations>(%a_bits, %b_bits, %output) : (i64, i64, tensor<8xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<8xi32>
    }
  }
  check.trial[256](%trial: index, %entropy: check.entropy) {
    %a_entropy = check.entropy.fork %entropy name("a") : check.entropy
    %b_entropy = check.entropy.fork %entropy name("b") : check.entropy
    %a_bits = check.entropy.read %a_entropy[%trial] : check.entropy -> i64
    %b_bits = check.entropy.read %b_entropy[%trial] : check.entropy -> i64
    %output = check.generate.fill value(0) : tensor<8xi32>
    check.compare<@vector_floating_observations>(%a_bits, %b_bits, %output) : (i64, i64, tensor<8xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<8xi32>
    }
  }
  check.return
}
