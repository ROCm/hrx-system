// Normal finite inputs isolate arithmetic and read preservation from target
// subnormal modes. Each product is rounded at its authored precision.
check.scenario @vector_scale_f16_values {
  check.trial[16](%trial: index, %entropy: check.entropy) {
    %input_entropy = check.entropy.fork %entropy name("input") : check.entropy
    %factor_entropy = check.entropy.fork %entropy name("factor") : check.entropy
    %input_seed = check.entropy.read %input_entropy[%trial] : check.entropy -> i64
    %factor_seed = check.entropy.read %factor_entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%input_seed) range(-4.0 to -0.5) : tensor<9xf16>
    %expected_input = check.generate.random.uniform seed(%input_seed) range(-4.0 to -0.5) : tensor<9xf16>
    %factor = check.generate.random.uniform seed(%factor_seed) range(-1.125 to -0.875) : tensor<1xf16>
    %expected_factor = check.generate.fill value(2.0) : tensor<1xf16>
    %storage = check.generate.fill value(-123.5) : tensor<13xf16>
    %output = check.tensor.view %storage offset(4) : tensor<13xf16> -> tensor<9xf16>
    %prefix = check.tensor.view %storage offset(0) : tensor<13xf16> -> tensor<2xf16>
    %suffix = check.tensor.view %storage offset(22) : tensor<13xf16> -> tensor<2xf16>
    %guard = check.generate.fill value(-123.5) : tensor<2xf16>
    check.compare<@vector_scale_f16, @scalar_scale_f16>(%input, %factor, %output, %trial) : (tensor<9xf16>, tensor<1xf16>, tensor<9xf16>, index) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<9xf16>
      check.expect.bitwise actual(%input) expected(%expected_input) : tensor<9xf16>
      check.expect.bitwise actual(%factor) expected(%expected_factor) : tensor<1xf16>
      check.expect.bitwise actual(%prefix) expected(%guard) : tensor<2xf16>
      check.expect.bitwise actual(%suffix) expected(%guard) : tensor<2xf16>
    }
  }
  check.return
}

