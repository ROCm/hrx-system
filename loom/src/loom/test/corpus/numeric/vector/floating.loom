  %initial_pair = vector.load %values[0] : view<9xf32> -> vector<2xf32>
  %initial_triple = vector.load %values[2] : view<9xf32> -> vector<3xf32>
  %initial_quad = vector.load %values[5] : view<9xf32> -> vector<4xf32>
