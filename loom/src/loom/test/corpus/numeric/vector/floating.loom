    %next_pair = vector.mulf %pair_factor, %pair : vector<2xf32>
    %next_triple = vector.mulf %triple, %triple_factor : vector<3xf32>
    %next_quad = vector.mulf %quad_factor, %quad : vector<4xf32>
    scf.yield %next_pair, %next_triple, %next_quad : vector<2xf32>, vector<3xf32>, vector<4xf32>
  }
  vector.store %pair_result, %results[0] : vector<2xf32>, view<9xf32>
  vector.store %triple_result, %results[2] : vector<3xf32>, view<9xf32>
  vector.store %quad_result, %results[5] : vector<4xf32>, view<9xf32>
  func.return
}

