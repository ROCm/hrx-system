      check.expect.approximate actual(%output) expected(%output) atol(0.0) rtol(9.9999999999999995e-07) nan(same) : tensor<4xf32>, tensor<4xf32>
      check.expect.bitwise actual(%lhs) expected(%expected_lhs) : tensor<4xf32>
      check.expect.bitwise actual(%rhs) expected(%expected_rhs) : tensor<4xf32>
      check.expect.bitwise actual(%prefix) expected(%guard) : tensor<4xf32>
      check.expect.bitwise actual(%suffix) expected(%guard) : tensor<4xf32>
    }
  }
  check.return
}

check.scenario @vector_f32_comparisons_no_nan_values {
  check.trial[64](%trial: index, %entropy: check.entropy) {
    %lhs_entropy = check.entropy.fork %entropy name("no_nan_lhs") : check.entropy
    %rhs_entropy = check.entropy.fork %entropy name("no_nan_rhs") : check.entropy
    %lhs_seed = check.entropy.read %lhs_entropy[%trial] : check.entropy -> i64
    %rhs_seed = check.entropy.read %rhs_entropy[%trial] : check.entropy -> i64
    %lhs = check.generate.random.uniform seed(%lhs_seed) range(-1024.0 to 1024.0) : tensor<4xf32>
    %rhs = check.generate.random.uniform seed(%rhs_seed) range(-1024.0 to 1024.0) : tensor<4xf32>
    %output = check.generate.fill value(1515870810) : tensor<24xi32>
    check.compare<@vector_f32_comparisons_no_nan>(%lhs, %rhs, %output) : (tensor<4xf32>, tensor<4xf32>, tensor<24xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<24xi32>
    }
  }
  check.return
}

// Positive and negative BF16 subnormals, the native-repair cutoff, normal
// values, finite overflow, and infinities distinguish the full product from a
// multiply that flushes F32 subnormal results.
check.scenario @vector_bf16_origin_scale_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(0) step(1) : tensor<16xi16>
    %output = check.generate.fill value(0.0) : tensor<16xf32>
    check.compare<@vector_bf16_origin_scale>(%input, %output) : (tensor<16xi16>, tensor<16xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<16xf32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-32768) step(1) : tensor<16xi16>
    %output = check.generate.fill value(0.0) : tensor<16xf32>
    check.compare<@vector_bf16_origin_scale>(%input, %output) : (tensor<16xi16>, tensor<16xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<16xf32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(80) step(1) : tensor<16xi16>
    %output = check.generate.fill value(0.0) : tensor<16xf32>
    check.compare<@vector_bf16_origin_scale>(%input, %output) : (tensor<16xi16>, tensor<16xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<16xf32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(16248) step(1) : tensor<16xi16>
    %output = check.generate.fill value(0.0) : tensor<16xf32>
    check.compare<@vector_bf16_origin_scale>(%input, %output) : (tensor<16xi16>, tensor<16xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<16xf32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(32624) step(1) : tensor<16xi16>
    %output = check.generate.fill value(0.0) : tensor<16xf32>
    check.compare<@vector_bf16_origin_scale>(%input, %output) : (tensor<16xi16>, tensor<16xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<16xf32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(32640) : tensor<16xi16>
    %output = check.generate.fill value(0.0) : tensor<16xf32>
    check.compare<@vector_bf16_origin_scale>(%input, %output) : (tensor<16xi16>, tensor<16xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<16xf32>
    }
  }
  check.return
}
