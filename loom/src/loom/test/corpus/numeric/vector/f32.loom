check.scenario @vector_f32_arithmetic_values {
  check.trial[64](%trial: index, %entropy: check.entropy) {
    %lhs_entropy = check.entropy.fork %entropy name("arithmetic_lhs") : check.entropy
    %rhs_entropy = check.entropy.fork %entropy name("arithmetic_rhs") : check.entropy
    %lhs_seed = check.entropy.read %lhs_entropy[%trial] : check.entropy -> i64
    %rhs_seed = check.entropy.read %rhs_entropy[%trial] : check.entropy -> i64
    %lhs = check.generate.random.uniform seed(%lhs_seed) range(-1024.0 to 1024.0) : tensor<4xf32>
    %rhs = check.generate.random.uniform seed(%rhs_seed) range(-1024.0 to 1024.0) : tensor<4xf32>
    %expected_lhs = check.generate.random.uniform seed(%lhs_seed) range(-1024.0 to 1024.0) : tensor<4xf32>
    %expected_rhs = check.generate.random.uniform seed(%rhs_seed) range(-1024.0 to 1024.0) : tensor<4xf32>
    %storage = check.generate.fill value(-123.5) : tensor<20xf32>
    %output = check.tensor.view %storage offset(16) : tensor<20xf32> -> tensor<12xf32>
    %prefix = check.tensor.view %storage offset(0) : tensor<20xf32> -> tensor<4xf32>
    %suffix = check.tensor.view %storage offset(64) : tensor<20xf32> -> tensor<4xf32>
    %guard = check.generate.fill value(-123.5) : tensor<4xf32>
    check.compare<@vector_f32_arithmetic>(%lhs, %rhs, %output) : (tensor<4xf32>, tensor<4xf32>, tensor<12xf32>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(0.0) rtol(9.9999999999999995e-07) nan(same) : tensor<12xf32>, tensor<12xf32>
      check.expect.bitwise actual(%lhs) expected(%expected_lhs) : tensor<4xf32>
      check.expect.bitwise actual(%rhs) expected(%expected_rhs) : tensor<4xf32>
      check.expect.bitwise actual(%prefix) expected(%guard) : tensor<4xf32>
      check.expect.bitwise actual(%suffix) expected(%guard) : tensor<4xf32>
    }
  }
  check.return
}

check.scenario @f32_power_of_two_scale_values {
  check.trial[64](%trial: index, %entropy: check.entropy) {
    %input_seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%input_seed) range(-65536.0 to 65536.0) : tensor<20xf32>
    %expected_input = check.generate.random.uniform seed(%input_seed) range(-65536.0 to 65536.0) : tensor<20xf32>
    %output = check.generate.fill value(-123.5) : tensor<20xf32>
    check.compare<@f32_power_of_two_scale>(%input, %output) : (tensor<20xf32>, tensor<20xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<20xf32>
      check.expect.bitwise actual(%input) expected(%expected_input) : tensor<20xf32>
    }
  }
  check.return
}

check.scenario @vector_f32_division_values {
