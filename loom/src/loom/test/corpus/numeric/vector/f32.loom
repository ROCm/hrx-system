func.def @vector_f32_sign(%input_buffer: buffer, %output_buffer: buffer) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input_buffer[%base] : buffer -> view<4xf32>
  %output_view = buffer.view %output_buffer[%base] : buffer -> view<8xf32>
  %input = vector.load %input_view[0] : view<4xf32> -> vector<4xf32>
  %absolute = vector.absf %input : vector<4xf32>
  vector.store %absolute, %output_view[0] : vector<4xf32>, view<8xf32>
  %negated = vector.negf %input : vector<4xf32>
  vector.store %negated, %output_view[4] : vector<4xf32>, view<8xf32>
  func.return
}

func.def @vector_f32_rounding(%input_buffer: buffer, %output_buffer: buffer) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input_buffer[%base] : buffer -> view<4xf32>
  %output_view = buffer.view %output_buffer[%base] : buffer -> view<16xf32>
  %input = vector.load %input_view[0] : view<4xf32> -> vector<4xf32>
  %ceil = vector.ceilf %input : vector<4xf32>
  vector.store %ceil, %output_view[0] : vector<4xf32>, view<16xf32>
  %floor = vector.floorf %input : vector<4xf32>
  vector.store %floor, %output_view[4] : vector<4xf32>, view<16xf32>
  %roundeven = vector.roundevenf %input : vector<4xf32>
  vector.store %roundeven, %output_view[8] : vector<4xf32>, view<16xf32>
  %trunc = vector.truncf %input : vector<4xf32>
  vector.store %trunc, %output_view[12] : vector<4xf32>, view<16xf32>
  func.return
}

func.def @vector_f32_square_root(%input_buffer: buffer, %output_buffer: buffer) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input_buffer[%base] : buffer -> view<4xf32>
  %output_view = buffer.view %output_buffer[%base] : buffer -> view<4xf32>
  %input = vector.load %input_view[0] : view<4xf32> -> vector<4xf32>
  %square_root = vector.sqrtf %input : vector<4xf32>
  vector.store %square_root, %output_view[0] : vector<4xf32>, view<4xf32>
  func.return
}

// Distinct nonlinear values expose lane ordering across wide operations and
// their immediately narrowed results. Compare with the mathematical reference
// at BF16 precision rather than another width of the same target lowering.
func.def @vector_f32_nonlinear_shapes(%exponent_buffer: buffer, %tanh_buffer: buffer, %wide_buffer: buffer, %narrow_buffer: buffer) {
  %origin = index.constant 0 : offset
  %input = buffer.view %exponent_buffer[%origin] : buffer -> view<64xf32>
  %tanh_input = buffer.view %tanh_buffer[%origin] : buffer -> view<64xf32>
  %wide = buffer.view %wide_buffer[%origin] : buffer -> view<2x64xf32>
  %narrow = buffer.view %narrow_buffer[%origin] : buffer -> view<2x96xbf16>
  %values = vector.load %input[0] : view<64xf32> -> vector<64xf32>
  %exponential = vector.exp2f<afn> %values : vector<64xf32>
  %tanh_values = vector.load %tanh_input[0] : view<64xf32> -> vector<64xf32>
  %tanh = vector.tanhf<afn> %tanh_values : vector<64xf32>
  vector.store %exponential, %wide[0, 0] : vector<64xf32>, view<2x64xf32>
  vector.store %tanh, %wide[1, 0] : vector<64xf32>, view<2x64xf32>
  %exponential_bf16 = vector.fptrunc<daz> %exponential : vector<64xf32> to vector<64xbf16>
  %tanh_bf16 = vector.fptrunc<daz> %tanh : vector<64xf32> to vector<64xbf16>
  vector.store %exponential_bf16, %narrow[0, 0] : vector<64xbf16>, view<2x96xbf16>
  vector.store %tanh_bf16, %narrow[1, 0] : vector<64xbf16>, view<2x96xbf16>
  %first = vector.load %input[0] : view<64xf32> -> vector<32xf32>
  %first_exponential = vector.exp2f<afn> %first : vector<32xf32>
  %first_bf16 = vector.fptrunc<daz> %first_exponential : vector<32xf32> to vector<32xbf16>
  vector.store %first_bf16, %narrow[0, 64] : vector<32xbf16>, view<2x96xbf16>
  %second = vector.load %tanh_input[32] : view<64xf32> -> vector<32xf32>
  %second_tanh = vector.tanhf<afn> %second : vector<32xf32>
  %second_bf16 = vector.fptrunc<daz> %second_tanh : vector<32xf32> to vector<32xbf16>
  vector.store %second_bf16, %narrow[1, 64] : vector<32xbf16>, view<2x96xbf16>
  func.return
}

check.scenario @vector_f32_nonlinear_shape_values {
  check.trial[4](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-4.0 to 4.0) : tensor<64xf32>
    %tanh_input = check.generate.iota offset(-4.0) step(0.125) : tensor<64xf32>
    %wide = check.generate.fill value(-99.0) : tensor<2x64xf32>
    %narrow = check.generate.fill value(-99.0) : tensor<2x96xbf16>
    check.compare<@vector_f32_nonlinear_shapes>(%input, %tanh_input, %wide, %narrow) : (tensor<64xf32>, tensor<64xf32>, tensor<2x64xf32>, tensor<2x96xbf16>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<64xf32>
      check.expect.bitwise actual(%tanh_input) expected(%tanh_input) : tensor<64xf32>
      check.expect.approximate actual(%wide) expected(%wide) atol(0.0) rtol(0.0078125) nan(same) : tensor<2x64xf32>, tensor<2x64xf32>
      check.expect.approximate actual(%narrow) expected(%narrow) atol(0.0) rtol(0.0078125) nan(same) : tensor<2x96xbf16>, tensor<2x96xbf16>
    }
  }
  check.return
}

// Widened BF16 operands retain their precision through fused arithmetic,
// narrowing, and a second accumulation at full and partial vector widths.
func.def @vector_bf16_origin_fma(%input_buffer: buffer, %output_buffer: buffer) {
  %origin = index.constant 0 : offset
  %input = buffer.view %input_buffer[%origin] : buffer -> view<4x64xbf16>
  %output = buffer.view %output_buffer[%origin] : buffer -> view<5x64xf32>
  %left = vector.load %input[0, 0] : view<4x64xbf16> -> vector<64xbf16>
  %right = vector.load %input[1, 0] : view<4x64xbf16> -> vector<64xbf16>
  %seed = vector.load %input[2, 0] : view<4x64xbf16> -> vector<64xbf16>
  %other = vector.load %input[3, 0] : view<4x64xbf16> -> vector<64xbf16>
  %a = vector.extf %left : vector<64xbf16> to vector<64xf32>
  %b = vector.extf %right : vector<64xbf16> to vector<64xf32>
  %c = vector.extf %seed : vector<64xbf16> to vector<64xf32>
  %d = vector.extf %other : vector<64xbf16> to vector<64xf32>
  %identity = vector.splatf 0.0 : vector<64xf32>
  %product = vector.fmaf<nnan|ninf|nsz|afn> %a, %b, %identity : vector<64xf32>
  %seeded = vector.fmaf<nnan|ninf|nsz|afn> %a, %d, %c : vector<64xf32>
  %rounded = vector.fptrunc<daz> %product : vector<64xf32> to vector<64xbf16>
  %wide = vector.extf %rounded : vector<64xbf16> to vector<64xf32>
  %chained = vector.fmaf<nnan|ninf|nsz|afn> %wide, %d, %seeded : vector<64xf32>
  vector.store %product, %output[0, 0] : vector<64xf32>, view<5x64xf32>
  vector.store %seeded, %output[1, 0] : vector<64xf32>, view<5x64xf32>
  vector.store %chained, %output[2, 0] : vector<64xf32>, view<5x64xf32>
  vector.store %identity, %output[3, 0] : vector<64xf32>, view<5x64xf32>
  vector.store %identity, %output[4, 0] : vector<64xf32>, view<5x64xf32>
  %left1 = vector.slice %left[0] : vector<64xbf16> -> vector<1xbf16>
  %right1 = vector.slice %right[0] : vector<64xbf16> -> vector<1xbf16>
  %a1 = vector.extf %left1 : vector<1xbf16> to vector<1xf32>
  %b1 = vector.extf %right1 : vector<1xbf16> to vector<1xf32>
  %identity1 = vector.splatf 0.0 : vector<1xf32>
  %product1 = vector.fmaf<nnan|ninf|nsz|afn> %a1, %b1, %identity1 : vector<1xf32>
  %chain1 = vector.fmaf<nnan|ninf|nsz|afn> %a1, %a1, %product1 : vector<1xf32>
  vector.store %chain1, %output[3, 16] : vector<1xf32>, view<5x64xf32>
  %left16 = vector.slice %left[0] : vector<64xbf16> -> vector<16xbf16>
  %right16 = vector.slice %right[0] : vector<64xbf16> -> vector<16xbf16>
  %a16 = vector.extf %left16 : vector<16xbf16> to vector<16xf32>
  %b16 = vector.extf %right16 : vector<16xbf16> to vector<16xf32>
  %identity16 = vector.splatf 0.0 : vector<16xf32>
  %product16 = vector.fmaf<nnan|ninf|nsz|afn> %a16, %b16, %identity16 : vector<16xf32>
  %chain16 = vector.fmaf<nnan|ninf|nsz|afn> %a16, %a16, %product16 : vector<16xf32>
  vector.store %chain16, %output[3, 0] : vector<16xf32>, view<5x64xf32>
  %initial_sum = scalar.constant 0.0 : f32
  %input_sum = vector.reduce<addf, reassoc|nnan|ninf|nsz> %a16, %initial_sum : vector<16xf32>, f32
  %product_sum = vector.reduce<addf, reassoc|nnan|ninf|nsz> %chain16, %initial_sum : vector<16xf32>, f32
  view.store %input_sum, %output[3, 17] : f32, view<5x64xf32>
  view.store %product_sum, %output[3, 18] : f32, view<5x64xf32>
  %left17 = vector.slice %left[0] : vector<64xbf16> -> vector<17xbf16>
  %right17 = vector.slice %right[0] : vector<64xbf16> -> vector<17xbf16>
  %a17 = vector.extf %left17 : vector<17xbf16> to vector<17xf32>
  %b17 = vector.extf %right17 : vector<17xbf16> to vector<17xf32>
  %identity17 = vector.splatf 0.0 : vector<17xf32>
  %product17 = vector.fmaf<nnan|ninf|nsz|afn> %a17, %b17, %identity17 : vector<17xf32>
  %chain17 = vector.fmaf<nnan|ninf|nsz|afn> %a17, %a17, %product17 : vector<17xf32>
  vector.store %chain17, %output[3, 32] : vector<17xf32>, view<5x64xf32>
  %left32 = vector.slice %left[0] : vector<64xbf16> -> vector<32xbf16>
  %right32 = vector.slice %right[0] : vector<64xbf16> -> vector<32xbf16>
  %a32 = vector.extf %left32 : vector<32xbf16> to vector<32xf32>
  %b32 = vector.extf %right32 : vector<32xbf16> to vector<32xf32>
  %identity32 = vector.splatf 0.0 : vector<32xf32>
  %product32 = vector.fmaf<nnan|ninf|nsz|afn> %a32, %b32, %identity32 : vector<32xf32>
  %chain32 = vector.fmaf<nnan|ninf|nsz|afn> %a32, %a32, %product32 : vector<32xf32>
  vector.store %chain32, %output[4, 0] : vector<32xf32>, view<5x64xf32>
  func.return
}

check.scenario @vector_bf16_origin_fma_values {
  check.trial[3](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(0.5 to 4.0) : tensor<4x64xbf16>
    %output = check.generate.fill value(-1.0) : tensor<5x64xf32>
    check.compare<@vector_bf16_origin_fma>(%input, %output) : (tensor<4x64xbf16>, tensor<5x64xf32>) -> () {
      check.expect.equal actual(%output) expected(%output) : tensor<5x64xf32>
    }
  }
  check.return
}

func.def @vector_f32_arithmetic(%lhs_buffer: buffer, %rhs_buffer: buffer, %output_buffer: buffer) {
  %base = index.constant 0 : offset
  %lhs_view = buffer.view %lhs_buffer[%base] : buffer -> view<4xf32>
  %rhs_view = buffer.view %rhs_buffer[%base] : buffer -> view<4xf32>
  %output_view = buffer.view %output_buffer[%base] : buffer -> view<12xf32>
  %lhs = vector.load %lhs_view[0] : view<4xf32> -> vector<4xf32>
  %rhs = vector.load %rhs_view[0] : view<4xf32> -> vector<4xf32>
  %sum = vector.addf %lhs, %rhs : vector<4xf32>
  vector.store %sum, %output_view[0] : vector<4xf32>, view<12xf32>
  %difference = vector.subf %lhs, %rhs : vector<4xf32>
  vector.store %difference, %output_view[4] : vector<4xf32>, view<12xf32>
  %product = vector.mulf %lhs, %rhs : vector<4xf32>
  vector.store %product, %output_view[8] : vector<4xf32>, view<12xf32>
  func.return
}

func.def @vector_f32_division(%lhs_buffer: buffer, %rhs_buffer: buffer, %output_buffer: buffer) {
  %base = index.constant 0 : offset
  %lhs_view = buffer.view %lhs_buffer[%base] : buffer -> view<4xf32>
  %rhs_view = buffer.view %rhs_buffer[%base] : buffer -> view<4xf32>
  %output_view = buffer.view %output_buffer[%base] : buffer -> view<4xf32>
  %lhs = vector.load %lhs_view[0] : view<4xf32> -> vector<4xf32>
  %rhs = vector.load %rhs_view[0] : view<4xf32> -> vector<4xf32>
  %quotient = vector.divf %lhs, %rhs : vector<4xf32>
  vector.store %quotient, %output_view[0] : vector<4xf32>, view<4xf32>
  func.return
}

// The nnan contract makes the ordered and unordered spellings equivalent.
func.def @vector_f32_comparisons_no_nan(%lhs_buffer: buffer, %rhs_buffer: buffer, %output_buffer: buffer) {
  %base = index.constant 0 : offset
  %lhs_view = buffer.view %lhs_buffer[%base] : buffer -> view<4xf32>
  %rhs_view = buffer.view %rhs_buffer[%base] : buffer -> view<4xf32>
  %output_view = buffer.view %output_buffer[%base] : buffer -> view<24xi32>
  %lhs = vector.load %lhs_view[0] : view<4xf32> -> vector<4xf32>
  %rhs = vector.load %rhs_view[0] : view<4xf32> -> vector<4xf32>
  %true = vector.splati -1 : vector<4xi32>
  %false = vector.splati 0 : vector<4xi32>
  %not_equal = vector.cmpf<nnan> one, %lhs, %rhs : vector<4xf32> -> vector<4xi1>
  %not_equal_words = vector.select %not_equal, %true, %false : vector<4xi32>
  vector.store %not_equal_words, %output_view[0] : vector<4xi32>, view<24xi32>
  %unordered_equal = vector.cmpf<nnan> ueq, %lhs, %rhs : vector<4xf32> -> vector<4xi1>
  %unordered_equal_words = vector.select %unordered_equal, %true, %false : vector<4xi32>
  vector.store %unordered_equal_words, %output_view[4] : vector<4xi32>, view<24xi32>
  %unordered_greater = vector.cmpf<nnan> ugt, %lhs, %rhs : vector<4xf32> -> vector<4xi1>
  %unordered_greater_words = vector.select %unordered_greater, %true, %false : vector<4xi32>
  vector.store %unordered_greater_words, %output_view[8] : vector<4xi32>, view<24xi32>
  %unordered_greater_equal = vector.cmpf<nnan> uge, %lhs, %rhs : vector<4xf32> -> vector<4xi1>
  %unordered_greater_equal_words = vector.select %unordered_greater_equal, %true, %false : vector<4xi32>
  vector.store %unordered_greater_equal_words, %output_view[12] : vector<4xi32>, view<24xi32>
  %unordered_less = vector.cmpf<nnan> ult, %lhs, %rhs : vector<4xf32> -> vector<4xi1>
  %unordered_less_words = vector.select %unordered_less, %true, %false : vector<4xi32>
  vector.store %unordered_less_words, %output_view[16] : vector<4xi32>, view<24xi32>
  %unordered_less_equal = vector.cmpf<nnan> ule, %lhs, %rhs : vector<4xf32> -> vector<4xi1>
  %unordered_less_equal_words = vector.select %unordered_less_equal, %true, %false : vector<4xi32>
  vector.store %unordered_less_equal_words, %output_view[20] : vector<4xi32>, view<24xi32>
  func.return
}

// Raw BF16 bits make the widening origin observable across the callable
// boundary. The fixed scale is itself exact in BF16; the F32 result retains
// products below the F32 normal range instead of flushing them.
func.def @vector_bf16_origin_scale(%input_buffer: buffer, %output_buffer: buffer) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input_buffer[%base] : buffer -> view<16xbf16>
  %output_view = buffer.view %output_buffer[%base] : buffer -> view<16xf32>
  %input = vector.load %input_view[0] : view<16xbf16> -> vector<16xbf16>
  %wide = vector.extf %input : vector<16xbf16> to vector<16xf32>
  %scale = vector.splatf 1.4453125 : vector<16xf32>
  %product = vector.mulf<nnan> %wide, %scale : vector<16xf32>
  vector.store %product, %output_view[0] : vector<16xf32>, view<16xf32>
  func.return
}

func.def @f32_power_of_two_scale(%input_buffer: buffer, %output_buffer: buffer) {
  %base = index.constant 0 : offset
  %input = buffer.view %input_buffer[%base] : buffer -> view<20xf32>
  %output = buffer.view %output_buffer[%base] : buffer -> view<20xf32>
  %down_value = view.load %input[0] : view<20xf32> -> f32
  %down_factor = scalar.constant 0.00390625 : f32
  %down_result = scalar.mulf %down_value, %down_factor : f32
  view.store %down_result, %output[0] : f32, view<20xf32>
  %up_value = view.load %input[1] : view<20xf32> -> f32
  %up_factor = scalar.constant -8.0 : f32
  %up_result = scalar.mulf %up_factor, %up_value : f32
  view.store %up_result, %output[1] : f32, view<20xf32>
  %vector_value = vector.load %input[4] : view<20xf32> -> vector<16xf32>
  %vector_factor = vector.splatf 0.001953125 : vector<16xf32>
  %vector_result = vector.mulf %vector_value, %vector_factor : vector<16xf32>
  vector.store %vector_result, %output[4] : vector<16xf32>, view<20xf32>
  func.return
}

// Each trial covers four independent lanes. The random finite domain exercises
// ordinary ML values; target-specific suites own representation details such
// as NaN payloads, subnormals, and signed zeros.
check.scenario @vector_f32_sign_values {
  check.trial[64](%trial: index, %entropy: check.entropy) {
    %input_entropy = check.entropy.fork %entropy name("sign_input") : check.entropy
    %input_seed = check.entropy.read %input_entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%input_seed) range(-1024.0 to 1024.0) : tensor<4xf32>
    %expected_input = check.generate.random.uniform seed(%input_seed) range(-1024.0 to 1024.0) : tensor<4xf32>
    %storage = check.generate.fill value(-123.5) : tensor<16xf32>
    %output = check.tensor.view %storage offset(16) : tensor<16xf32> -> tensor<8xf32>
    %prefix = check.tensor.view %storage offset(0) : tensor<16xf32> -> tensor<4xf32>
    %suffix = check.tensor.view %storage offset(48) : tensor<16xf32> -> tensor<4xf32>
    %guard = check.generate.fill value(-123.5) : tensor<4xf32>
    check.compare<@vector_f32_sign>(%input, %output) : (tensor<4xf32>, tensor<8xf32>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(0.0) rtol(9.9999999999999995e-07) nan(same) : tensor<8xf32>, tensor<8xf32>
      check.expect.bitwise actual(%input) expected(%expected_input) : tensor<4xf32>
      check.expect.bitwise actual(%prefix) expected(%guard) : tensor<4xf32>
      check.expect.bitwise actual(%suffix) expected(%guard) : tensor<4xf32>
    }
  }
  check.return
}

