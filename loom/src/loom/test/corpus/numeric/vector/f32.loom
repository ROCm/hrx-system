func.def @vector_f32_sign(%input_buffer: buffer, %output_buffer: buffer) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input_buffer[%base] : buffer -> view<4xf32>
  %output_view = buffer.view %output_buffer[%base] : buffer -> view<8xf32>
  %input = vector.load %input_view[0] : view<4xf32> -> vector<4xf32>
  %absolute = vector.absf %input : vector<4xf32>
  vector.store %absolute, %output_view[0] : vector<4xf32>, view<8xf32>
  %negated = vector.negf %input : vector<4xf32>
  vector.store %negated, %output_view[4] : vector<4xf32>, view<8xf32>
  func.return
}

func.def @vector_f32_rounding(%input_buffer: buffer, %output_buffer: buffer) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input_buffer[%base] : buffer -> view<4xf32>
  %output_view = buffer.view %output_buffer[%base] : buffer -> view<16xf32>
  %input = vector.load %input_view[0] : view<4xf32> -> vector<4xf32>
  %ceil = vector.ceilf %input : vector<4xf32>
  vector.store %ceil, %output_view[0] : vector<4xf32>, view<16xf32>
  %floor = vector.floorf %input : vector<4xf32>
  vector.store %floor, %output_view[4] : vector<4xf32>, view<16xf32>
  %roundeven = vector.roundevenf %input : vector<4xf32>
  vector.store %roundeven, %output_view[8] : vector<4xf32>, view<16xf32>
  %trunc = vector.truncf %input : vector<4xf32>
  vector.store %trunc, %output_view[12] : vector<4xf32>, view<16xf32>
  func.return
}

func.def @vector_f32_square_root(%input_buffer: buffer, %output_buffer: buffer) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input_buffer[%base] : buffer -> view<4xf32>
  %output_view = buffer.view %output_buffer[%base] : buffer -> view<4xf32>
  %input = vector.load %input_view[0] : view<4xf32> -> vector<4xf32>
  %square_root = vector.sqrtf %input : vector<4xf32>
  vector.store %square_root, %output_view[0] : vector<4xf32>, view<4xf32>
  func.return
}

func.def @vector_f32_arithmetic(%lhs_buffer: buffer, %rhs_buffer: buffer, %output_buffer: buffer) {
  %base = index.constant 0 : offset
  %lhs_view = buffer.view %lhs_buffer[%base] : buffer -> view<4xf32>
  %rhs_view = buffer.view %rhs_buffer[%base] : buffer -> view<4xf32>
  %output_view = buffer.view %output_buffer[%base] : buffer -> view<12xf32>
  %lhs = vector.load %lhs_view[0] : view<4xf32> -> vector<4xf32>
  %rhs = vector.load %rhs_view[0] : view<4xf32> -> vector<4xf32>
  %sum = vector.addf %lhs, %rhs : vector<4xf32>
  vector.store %sum, %output_view[0] : vector<4xf32>, view<12xf32>
  %difference = vector.subf %lhs, %rhs : vector<4xf32>
  vector.store %difference, %output_view[4] : vector<4xf32>, view<12xf32>
  %product = vector.mulf %lhs, %rhs : vector<4xf32>
  vector.store %product, %output_view[8] : vector<4xf32>, view<12xf32>
  func.return
}

func.def @vector_f32_division(%lhs_buffer: buffer, %rhs_buffer: buffer, %output_buffer: buffer) {
  %base = index.constant 0 : offset
  %lhs_view = buffer.view %lhs_buffer[%base] : buffer -> view<4xf32>
  %rhs_view = buffer.view %rhs_buffer[%base] : buffer -> view<4xf32>
  %output_view = buffer.view %output_buffer[%base] : buffer -> view<4xf32>
  %lhs = vector.load %lhs_view[0] : view<4xf32> -> vector<4xf32>
  %rhs = vector.load %rhs_view[0] : view<4xf32> -> vector<4xf32>
  %quotient = vector.divf %lhs, %rhs : vector<4xf32>
  vector.store %quotient, %output_view[0] : vector<4xf32>, view<4xf32>
  func.return
}

// The nnan contract makes the ordered and unordered spellings equivalent.
func.def @vector_f32_comparisons_no_nan(%lhs_buffer: buffer, %rhs_buffer: buffer, %output_buffer: buffer) {
  %base = index.constant 0 : offset
  %lhs_view = buffer.view %lhs_buffer[%base] : buffer -> view<4xf32>
  %rhs_view = buffer.view %rhs_buffer[%base] : buffer -> view<4xf32>
  %output_view = buffer.view %output_buffer[%base] : buffer -> view<24xi32>
  %lhs = vector.load %lhs_view[0] : view<4xf32> -> vector<4xf32>
  %rhs = vector.load %rhs_view[0] : view<4xf32> -> vector<4xf32>
  %true = vector.constant -1 : vector<4xi32>
  %false = vector.constant 0 : vector<4xi32>
  %not_equal = vector.cmpf<nnan> one, %lhs, %rhs : vector<4xf32> -> vector<4xi1>
  %not_equal_words = vector.select %not_equal, %true, %false : vector<4xi32>
  vector.store %not_equal_words, %output_view[0] : vector<4xi32>, view<24xi32>
  %unordered_equal = vector.cmpf<nnan> ueq, %lhs, %rhs : vector<4xf32> -> vector<4xi1>
  %unordered_equal_words = vector.select %unordered_equal, %true, %false : vector<4xi32>
  vector.store %unordered_equal_words, %output_view[4] : vector<4xi32>, view<24xi32>
  %unordered_greater = vector.cmpf<nnan> ugt, %lhs, %rhs : vector<4xf32> -> vector<4xi1>
  %unordered_greater_words = vector.select %unordered_greater, %true, %false : vector<4xi32>
  vector.store %unordered_greater_words, %output_view[8] : vector<4xi32>, view<24xi32>
  %unordered_greater_equal = vector.cmpf<nnan> uge, %lhs, %rhs : vector<4xf32> -> vector<4xi1>
  %unordered_greater_equal_words = vector.select %unordered_greater_equal, %true, %false : vector<4xi32>
  vector.store %unordered_greater_equal_words, %output_view[12] : vector<4xi32>, view<24xi32>
  %unordered_less = vector.cmpf<nnan> ult, %lhs, %rhs : vector<4xf32> -> vector<4xi1>
  %unordered_less_words = vector.select %unordered_less, %true, %false : vector<4xi32>
  vector.store %unordered_less_words, %output_view[16] : vector<4xi32>, view<24xi32>
  %unordered_less_equal = vector.cmpf<nnan> ule, %lhs, %rhs : vector<4xf32> -> vector<4xi1>
  %unordered_less_equal_words = vector.select %unordered_less_equal, %true, %false : vector<4xi32>
  vector.store %unordered_less_equal_words, %output_view[20] : vector<4xi32>, view<24xi32>
  func.return
}

// Raw BF16 bits make the widening origin observable across the callable
// boundary. The fixed scale is itself exact in BF16; the F32 result retains
// products below the F32 normal range instead of flushing them.
func.def @vector_bf16_origin_scale(%input_buffer: buffer, %output_buffer: buffer) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input_buffer[%base] : buffer -> view<16xbf16>
  %output_view = buffer.view %output_buffer[%base] : buffer -> view<16xf32>
  %input = vector.load %input_view[0] : view<16xbf16> -> vector<16xbf16>
  %wide = vector.extf %input : vector<16xbf16> to vector<16xf32>
  %scale = vector.constant 1.4453125 : vector<16xf32>
  %product = vector.mulf<nnan> %wide, %scale : vector<16xf32>
  vector.store %product, %output_view[0] : vector<16xf32>, view<16xf32>
  func.return
}

// Each trial covers four independent lanes. The random finite domain exercises
// ordinary ML values; target-specific suites own representation details such
// as NaN payloads, subnormals, and signed zeros.
check.scenario @vector_f32_sign_values {
  check.trial[64](%trial: index, %entropy: check.entropy) {
    %input_entropy = check.entropy.fork %entropy name("sign_input") : check.entropy
    %input_seed = check.entropy.read %input_entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%input_seed) range(-1024.0 to 1024.0) : tensor<4xf32>
    %expected_input = check.generate.random.uniform seed(%input_seed) range(-1024.0 to 1024.0) : tensor<4xf32>
    %storage = check.generate.fill value(-123.5) : tensor<16xf32>
    %output = check.tensor.view %storage offset(16) : tensor<16xf32> -> tensor<8xf32>
    %prefix = check.tensor.view %storage offset(0) : tensor<16xf32> -> tensor<4xf32>
    %suffix = check.tensor.view %storage offset(48) : tensor<16xf32> -> tensor<4xf32>
    %guard = check.generate.fill value(-123.5) : tensor<4xf32>
    check.compare<@vector_f32_sign>(%input, %output) : (tensor<4xf32>, tensor<8xf32>) -> () {
      check.expect.close actual(%output) expected(%output) atol(0.0) rtol(9.9999999999999995e-07) nan(same) : tensor<8xf32>
      check.expect.bitwise actual(%input) expected(%expected_input) : tensor<4xf32>
      check.expect.bitwise actual(%prefix) expected(%guard) : tensor<4xf32>
      check.expect.bitwise actual(%suffix) expected(%guard) : tensor<4xf32>
    }
  }
  check.return
}

