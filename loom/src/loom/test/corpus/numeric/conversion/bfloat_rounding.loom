// Runtime bit patterns cover every BF16 bin with discarded significands on
// either side of a tie. NaN payload/sign choices are ignored; losing the NaN
// or quiet bit is still a mismatch, and every finite result is compared exactly.
func.def @bfloat_rounding(%upper_bits: buffer, %discarded: i32, %output: buffer, %packed_output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 65536 : index
  %step = index.constant 1 : index
  %magnitude_mask = scalar.constant 32767 : i16
  %exponent = scalar.constant 32640 : i16
  %quiet_bit = scalar.constant 64 : i16
  %input = buffer.view %upper_bits[%base] : buffer -> view<65536xi32>
  %result = buffer.view %output[%base] : buffer -> view<65536xi16>
  scf.for %i = [%begin to %end step %step] {
    %upper = view.load %input[%i] : view<65536xi32> -> i32
    %bits = scalar.ori %upper, %discarded : i32
    %value = scalar.bitcast %bits : i32 to f32
    %narrow = scalar.fptrunc %value : f32 to bf16
    %narrow_bits = scalar.bitcast %narrow : bf16 to i16
    %magnitude = scalar.andi %narrow_bits, %magnitude_mask : i16
    %nan = scalar.cmpi ugt, %magnitude, %exponent : i16
    %quiet = scalar.andi %narrow_bits, %quiet_bit : i16
    %nan_tag = scalar.ori %quiet, %exponent : i16
    %normalized = scf.select %nan, %nan_tag, %narrow_bits : i16
    view.store %normalized, %result[%i] : i16, view<65536xi16>
  }
  %packed_step = index.constant 4 : index
  %discarded_lanes = vector.splat %discarded : vector<4xi32>
  %magnitude_masks = vector.splati 32767 : vector<4xi16>
  %exponents = vector.splati 32640 : vector<4xi16>
  %quiet_bits = vector.splati 64 : vector<4xi16>
  %packed_result = buffer.view %packed_output[%base] : buffer -> view<65536xi16>
  scf.for %i = [%begin to %end step %packed_step] {
    %upper = vector.load %input[%i] : view<65536xi32> -> vector<4xi32>
    %bits = vector.ori %upper, %discarded_lanes : vector<4xi32>
    %value = vector.bitcast %bits : vector<4xi32> to vector<4xf32>
    %narrow = vector.fptrunc %value : vector<4xf32> to vector<4xbf16>
    %narrow_bits = vector.bitcast %narrow : vector<4xbf16> to vector<4xi16>
    %magnitude = vector.andi %narrow_bits, %magnitude_masks : vector<4xi16>
    %nan = vector.cmpi ugt, %magnitude, %exponents : vector<4xi16> -> vector<4xi1>
    %quiet = vector.andi %narrow_bits, %quiet_bits : vector<4xi16>
    %nan_tag = vector.ori %quiet, %exponents : vector<4xi16>
    %normalized = vector.select %nan, %nan_tag, %narrow_bits : vector<4xi16>
    vector.store %normalized, %packed_result[%i] : vector<4xi16>, view<65536xi16>
  }
  func.return
}

check.scenario @bfloat_rounding_all_bins {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %upper_bits = check.generate.iota offset(-2147483648) step(65536) : tensor<65536xi32>
    %discarded = check.literal value(0) : i32
    %output = check.generate.fill value(-1) : tensor<65536xi16>
    %packed_output = check.generate.fill value(-1) : tensor<65536xi16>
    check.compare<@bfloat_rounding>(%upper_bits, %discarded, %output, %packed_output) : (tensor<65536xi32>, i32, tensor<65536xi16>, tensor<65536xi16>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<65536xi16>
      check.expect.bitwise actual(%packed_output) expected(%packed_output) : tensor<65536xi16>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %upper_bits = check.generate.iota offset(-2147483648) step(65536) : tensor<65536xi32>
    %discarded = check.literal value(1) : i32
    %output = check.generate.fill value(-1) : tensor<65536xi16>
    %packed_output = check.generate.fill value(-1) : tensor<65536xi16>
    check.compare<@bfloat_rounding>(%upper_bits, %discarded, %output, %packed_output) : (tensor<65536xi32>, i32, tensor<65536xi16>, tensor<65536xi16>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<65536xi16>
      check.expect.bitwise actual(%packed_output) expected(%packed_output) : tensor<65536xi16>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %upper_bits = check.generate.iota offset(-2147483648) step(65536) : tensor<65536xi32>
    %discarded = check.literal value(32767) : i32
    %output = check.generate.fill value(-1) : tensor<65536xi16>
    %packed_output = check.generate.fill value(-1) : tensor<65536xi16>
    check.compare<@bfloat_rounding>(%upper_bits, %discarded, %output, %packed_output) : (tensor<65536xi32>, i32, tensor<65536xi16>, tensor<65536xi16>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<65536xi16>
      check.expect.bitwise actual(%packed_output) expected(%packed_output) : tensor<65536xi16>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %upper_bits = check.generate.iota offset(-2147483648) step(65536) : tensor<65536xi32>
    %discarded = check.literal value(32768) : i32
    %output = check.generate.fill value(-1) : tensor<65536xi16>
    %packed_output = check.generate.fill value(-1) : tensor<65536xi16>
    check.compare<@bfloat_rounding>(%upper_bits, %discarded, %output, %packed_output) : (tensor<65536xi32>, i32, tensor<65536xi16>, tensor<65536xi16>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<65536xi16>
      check.expect.bitwise actual(%packed_output) expected(%packed_output) : tensor<65536xi16>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %upper_bits = check.generate.iota offset(-2147483648) step(65536) : tensor<65536xi32>
    %discarded = check.literal value(32769) : i32
    %output = check.generate.fill value(-1) : tensor<65536xi16>
    %packed_output = check.generate.fill value(-1) : tensor<65536xi16>
    check.compare<@bfloat_rounding>(%upper_bits, %discarded, %output, %packed_output) : (tensor<65536xi32>, i32, tensor<65536xi16>, tensor<65536xi16>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<65536xi16>
      check.expect.bitwise actual(%packed_output) expected(%packed_output) : tensor<65536xi16>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %upper_bits = check.generate.iota offset(-2147483648) step(65536) : tensor<65536xi32>
    %discarded = check.literal value(65535) : i32
    %output = check.generate.fill value(-1) : tensor<65536xi16>
    %packed_output = check.generate.fill value(-1) : tensor<65536xi16>
    check.compare<@bfloat_rounding>(%upper_bits, %discarded, %output, %packed_output) : (tensor<65536xi32>, i32, tensor<65536xi16>, tensor<65536xi16>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<65536xi16>
      check.expect.bitwise actual(%packed_output) expected(%packed_output) : tensor<65536xi16>
    }
  }
  check.return
}

// The products are finite but not necessarily representable in BF16. Ties
// still round to even, and nnan/ninf do not permit changing a zero's sign.
func.def @finite_bfloat_products(%even_tie: f32, %odd_tie: f32, %signed_zero: f32) -> (i16, i16, i16, i16) {
  %half = scalar.constant 0.5 : f32
  %scalar_product = scalar.mulf<nnan|ninf> %even_tie, %half : f32
  %scalar_narrow = scalar.fptrunc %scalar_product : f32 to bf16
  %scalar_bits = scalar.bitcast %scalar_narrow : bf16 to i16
  %inputs = vector.from_elements %even_tie, %odd_tie, %signed_zero : vector<3xf32>
  %halves = vector.splatf 0.5 : vector<3xf32>
  %products = vector.mulf<nnan|ninf> %inputs, %halves : vector<3xf32>
  %narrow = vector.fptrunc %products : vector<3xf32> to vector<3xbf16>
  %bits = vector.bitcast %narrow : vector<3xbf16> to vector<3xi16>
  %even = vector.extract %bits[0] : vector<3xi16> -> i16
  %odd = vector.extract %bits[1] : vector<3xi16> -> i16
  %zero = vector.extract %bits[2] : vector<3xi16> -> i16
  func.return %scalar_bits, %even, %odd, %zero : i16, i16, i16, i16
}

// These trials use ties whose rounded magnitudes are 1.0 and 1.015625. The
// oracle supplies those encodings directly and carries only the input sign;
// it does not share floating arithmetic or narrowing with the subject.
func.def @finite_bfloat_products_oracle(%even_tie: f32, %odd_tie: f32, %signed_zero: f32) -> (i16, i16, i16, i16) {
  %inputs = vector.from_elements %even_tie, %odd_tie, %signed_zero : vector<3xf32>
  %bits = vector.bitcast %inputs : vector<3xf32> to vector<3xi32>
  %shift = vector.splati 16 : vector<3xi32>
  %high = vector.shrui %bits, %shift : vector<3xi32>
  %words = vector.trunci %high : vector<3xi32> to vector<3xi16>
  %sign_mask = vector.splati -32768 : vector<3xi16>
  %signs = vector.andi %words, %sign_mask : vector<3xi16>
  %magnitudes = vector.constanti [16256, 16258, 0] : vector<3xi16>
  %expected = vector.ori %signs, %magnitudes : vector<3xi16>
  %even = vector.extract %expected[0] : vector<3xi16> -> i16
  %odd = vector.extract %expected[1] : vector<3xi16> -> i16
  %zero = vector.extract %expected[2] : vector<3xi16> -> i16
  func.return %even, %even, %odd, %zero : i16, i16, i16, i16
}

check.scenario @finite_bfloat_product_rounding {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %even_tie = check.literal value(2.0078125) : f32
    %odd_tie = check.literal value(2.0234375) : f32
    %zero = check.literal value(0.0) : f32
    check.compare<@finite_bfloat_products, @finite_bfloat_products_oracle>(%even_tie, %odd_tie, %zero) : (f32, f32, f32) -> [actual(%scalar: i16, %even: i16, %odd: i16, %signed_zero: i16), expected(%oracle_scalar: i16, %oracle_even: i16, %oracle_odd: i16, %oracle_zero: i16)] {
      check.expect.bitwise actual(%scalar) expected(%oracle_scalar) : i16
      check.expect.bitwise actual(%even) expected(%oracle_even) : i16
      check.expect.bitwise actual(%odd) expected(%oracle_odd) : i16
      check.expect.bitwise actual(%signed_zero) expected(%oracle_zero) : i16
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %even_tie = check.literal value(-2.0078125) : f32
    %odd_tie = check.literal value(-2.0234375) : f32
    %zero = check.literal value(-0.0) : f32
    check.compare<@finite_bfloat_products, @finite_bfloat_products_oracle>(%even_tie, %odd_tie, %zero) : (f32, f32, f32) -> [actual(%scalar: i16, %even: i16, %odd: i16, %signed_zero: i16), expected(%oracle_scalar: i16, %oracle_even: i16, %oracle_odd: i16, %oracle_zero: i16)] {
      check.expect.bitwise actual(%scalar) expected(%oracle_scalar) : i16
      check.expect.bitwise actual(%even) expected(%oracle_even) : i16
      check.expect.bitwise actual(%odd) expected(%oracle_odd) : i16
      check.expect.bitwise actual(%signed_zero) expected(%oracle_zero) : i16
    }
  }
  check.return
}

// DAZ permits either preserving a subnormal input or replacing it with its
// signed zero. Normalize only that permitted zero to the strict rounded value;
// a wrong sign or any other wrong result remains observable. NaNs retain their
// class and quiet bit while payload and sign choices remain unconstrained.
func.def inline @observe_daz_bfloat(%input_bits: i32, %narrow: bf16) -> (i16) {
  %input = scalar.bitcast %input_bits : i32 to f32
  %bits = scalar.bitcast %narrow : bf16 to i16
  %exponent_mask = scalar.constant 2139095040 : i32
  %sign_mask = scalar.constant -2147483648 : i32
  %shift = scalar.constant 16 : i32
  %c0 = scalar.constant 0 : i32
  %exponent = scalar.andi %input_bits, %exponent_mask : i32
  %small = scalar.cmpi eq, %exponent, %c0 : i32
  %sign = scalar.andi %input_bits, %sign_mask : i32
  %high_sign = scalar.shrui %sign, %shift : i32
  %signed_zero = scalar.trunci %high_sign : i32 to i16
  %flushed = scalar.cmpi eq, %bits, %signed_zero : i16
  %permitted_zero = scalar.andi %small, %flushed : i1
  %observed = scf.if %permitted_zero -> (i16) {
    %strict = scalar.fptrunc %input : f32 to bf16
    %strict_bits = scalar.bitcast %strict : bf16 to i16
    scf.yield %strict_bits : i16
  } else {
    scf.yield %bits : i16
  }
  %magnitude_mask = scalar.constant 32767 : i16
  %infinity = scalar.constant 32640 : i16
  %quiet_mask = scalar.constant 64 : i16
  %magnitude = scalar.andi %observed, %magnitude_mask : i16
  %nan = scalar.cmpi ugt, %magnitude, %infinity : i16
  %quiet = scalar.andi %observed, %quiet_mask : i16
  %nan_class = scalar.ori %infinity, %quiet : i16
  %result = scf.select %nan, %nan_class, %observed : i16
  func.return %result : i16
}

func.def @bfloat_rounding_daz(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 16 : index
  %step = index.constant 1 : index
  %sign_mask = scalar.constant -2147483648 : i32
  %source = buffer.view %input[%base] : buffer -> view<16xi32>
  %destination = buffer.view %output[%base] : buffer -> view<64xi16>
  %scalar_base = index.constant 32 : index
  %packet_bits = vector.load %source[0] : view<16xi32> -> vector<16xi32>
  %signs = vector.splati -2147483648 : vector<16xi32>
  %opposite_packet_bits = vector.xori %packet_bits, %signs : vector<16xi32>
  %packet = vector.bitcast %packet_bits : vector<16xi32> to vector<16xf32>
  %opposite_packet = vector.bitcast %opposite_packet_bits : vector<16xi32> to vector<16xf32>
  %packed = vector.fptrunc<daz> %packet : vector<16xf32> to vector<16xbf16>
  %opposite_packed = vector.fptrunc<daz> %opposite_packet : vector<16xf32> to vector<16xbf16>
  scf.for %position = [%begin to %end step %step] {
    %bits = view.load %source[%position] : view<16xi32> -> i32
    %opposite_bits = scalar.xori %bits, %sign_mask : i32
    %value = scalar.bitcast %bits : i32 to f32
    %opposite_value = scalar.bitcast %opposite_bits : i32 to f32
    %narrow = scalar.fptrunc<daz> %value : f32 to bf16
    %opposite_narrow = scalar.fptrunc<daz> %opposite_value : f32 to bf16
    %result = func.call @observe_daz_bfloat(%bits, %narrow) : (i32, bf16) -> (i16)
    %opposite_result = func.call @observe_daz_bfloat(%opposite_bits, %opposite_narrow) : (i32, bf16) -> (i16)
    %packed_lane = vector.extract %packed[%position] : vector<16xbf16> -> bf16
    %opposite_packed_lane = vector.extract %opposite_packed[%position] : vector<16xbf16> -> bf16
    %packed_result = func.call @observe_daz_bfloat(%bits, %packed_lane) : (i32, bf16) -> (i16)
    %opposite_packed_result = func.call @observe_daz_bfloat(%opposite_bits, %opposite_packed_lane) : (i32, bf16) -> (i16)
    %opposite_position = index.add %position, %end : index
    %scalar_position = index.add %position, %scalar_base : index
    %opposite_scalar_position = index.add %opposite_position, %scalar_base : index
    view.store %packed_result, %destination[%position] : i16, view<64xi16>
    view.store %opposite_packed_result, %destination[%opposite_position] : i16, view<64xi16>
    view.store %result, %destination[%scalar_position] : i16, view<64xi16>
    view.store %opposite_result, %destination[%opposite_scalar_position] : i16, view<64xi16>
  }
  func.return
}

// Each window crosses a rounding or representation boundary in both signs.
// The callable boundary keeps its raw input bits unknown to target lowering.
check.scenario @bfloat_daz_rounding_boundaries {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(0) step(1) : tensor<16xi32>
    %output = check.generate.fill value(-1) : tensor<64xi16>
    check.compare<@bfloat_rounding_daz>(%input, %output) : (tensor<16xi32>, tensor<64xi16>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<64xi16>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(8388600) step(1) : tensor<16xi32>
    %output = check.generate.fill value(-1) : tensor<64xi16>
    check.compare<@bfloat_rounding_daz>(%input, %output) : (tensor<16xi32>, tensor<64xi16>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<64xi16>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(1065385976) step(1) : tensor<16xi32>
    %output = check.generate.fill value(-1) : tensor<64xi16>
    check.compare<@bfloat_rounding_daz>(%input, %output) : (tensor<16xi32>, tensor<64xi16>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<64xi16>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(1065451512) step(1) : tensor<16xi32>
    %output = check.generate.fill value(-1) : tensor<64xi16>
    check.compare<@bfloat_rounding_daz>(%input, %output) : (tensor<16xi32>, tensor<64xi16>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<64xi16>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(2139095032) step(1) : tensor<16xi32>
    %output = check.generate.fill value(-1) : tensor<64xi16>
    check.compare<@bfloat_rounding_daz>(%input, %output) : (tensor<16xi32>, tensor<64xi16>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<64xi16>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(2143289336) step(1) : tensor<16xi32>
    %output = check.generate.fill value(-1) : tensor<64xi16>
    check.compare<@bfloat_rounding_daz>(%input, %output) : (tensor<16xi32>, tensor<64xi16>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<64xi16>
    }
  }
  check.trial[8](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-2147483648 to 2147483647) : tensor<16xi32>
    %output = check.generate.fill value(-1) : tensor<64xi16>
    check.compare<@bfloat_rounding_daz>(%input, %output) : (tensor<16xi32>, tensor<64xi16>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<64xi16>
    }
  }
  check.return
}

// Partial packets and both native carrier widths preserve lane order across
// narrowing. Unwritten gaps retain their initial values in both executions.
func.def @bfloat_packet_narrowing(%input: buffer, %output: buffer) {
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 64} : buffer
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<32xf32>
  %destination = buffer.view %output_aligned[%base] : buffer -> view<96xbf16>
  %source4 = vector.load %source[0] : view<32xf32> -> vector<4xf32>
  %result4 = vector.fptrunc<daz> %source4 : vector<4xf32> to vector<4xbf16>
  vector.store %result4, %destination[0] : vector<4xbf16>, view<96xbf16>
  %source16 = vector.load %source[0] : view<32xf32> -> vector<16xf32>
  %result16 = vector.fptrunc<daz> %source16 : vector<16xf32> to vector<16xbf16>
  vector.store %result16, %destination[16] : vector<16xbf16>, view<96xbf16>
  %source24 = vector.load %source[0] : view<32xf32> -> vector<24xf32>
  %result24 = vector.fptrunc<daz> %source24 : vector<24xf32> to vector<24xbf16>
  vector.store %result24, %destination[32] : vector<24xbf16>, view<96xbf16>
  %source32 = vector.load %source[0] : view<32xf32> -> vector<32xf32>
  %result32 = vector.fptrunc<daz> %source32 : vector<32xf32> to vector<32xbf16>
  vector.store %result32, %destination[64] : vector<32xbf16>, view<96xbf16>
  func.return
}

check.scenario @bfloat_packet_narrowing_boundaries {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(1065385968) step(1) : tensor<32xi32>
    %output = check.generate.fill value(-1.0) : tensor<96xbf16>
    check.compare<@bfloat_packet_narrowing>(%input, %output) : (tensor<32xi32>, tensor<96xbf16>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(0.0) rtol(0.0) nan(same) : tensor<96xbf16>, tensor<96xbf16>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-1082032144) step(1) : tensor<32xi32>
    %output = check.generate.fill value(-1.0) : tensor<96xbf16>
    check.compare<@bfloat_packet_narrowing>(%input, %output) : (tensor<32xi32>, tensor<96xbf16>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(0.0) rtol(0.0) nan(same) : tensor<96xbf16>, tensor<96xbf16>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(2139095024) step(1) : tensor<32xi32>
    %output = check.generate.fill value(-1.0) : tensor<96xbf16>
    check.compare<@bfloat_packet_narrowing>(%input, %output) : (tensor<32xi32>, tensor<96xbf16>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(0.0) rtol(0.0) nan(same) : tensor<96xbf16>, tensor<96xbf16>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-4194320) step(1) : tensor<32xi32>
    %output = check.generate.fill value(-1.0) : tensor<96xbf16>
    check.compare<@bfloat_packet_narrowing>(%input, %output) : (tensor<32xi32>, tensor<96xbf16>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(0.0) rtol(0.0) nan(same) : tensor<96xbf16>, tensor<96xbf16>
    }
  }
  check.trial[8](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(8388608 to 2147483647) : tensor<32xi32>
    %output = check.generate.fill value(-1.0) : tensor<96xbf16>
    check.compare<@bfloat_packet_narrowing>(%input, %output) : (tensor<32xi32>, tensor<96xbf16>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(0.0) rtol(0.0) nan(same) : tensor<96xbf16>, tensor<96xbf16>
    }
  }
  check.return
}

func.def @bfloat_packet_widening(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<32xbf16>
  %destination = buffer.view %output[%base] : buffer -> view<96xf32>
  %source4 = vector.load %source[0] : view<32xbf16> -> vector<4xbf16>
  %result4 = vector.extf<daz> %source4 : vector<4xbf16> to vector<4xf32>
  vector.store %result4, %destination[0] : vector<4xf32>, view<96xf32>
  %source16 = vector.load %source[0] : view<32xbf16> -> vector<16xbf16>
  %result16 = vector.extf<daz> %source16 : vector<16xbf16> to vector<16xf32>
  vector.store %result16, %destination[16] : vector<16xf32>, view<96xf32>
  %source24 = vector.load %source[0] : view<32xbf16> -> vector<24xbf16>
  %result24 = vector.extf<daz> %source24 : vector<24xbf16> to vector<24xf32>
  vector.store %result24, %destination[32] : vector<24xf32>, view<96xf32>
  %source32 = vector.load %source[0] : view<32xbf16> -> vector<32xbf16>
  %result32 = vector.extf<daz> %source32 : vector<32xbf16> to vector<32xf32>
  vector.store %result32, %destination[64] : vector<32xf32>, view<96xf32>
  func.return
}

check.scenario @bfloat_packet_widening_boundaries {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(32624) step(1) : tensor<32xi16>
    %output = check.generate.fill value(-1.0) : tensor<96xf32>
    check.compare<@bfloat_packet_widening>(%input, %output) : (tensor<32xi16>, tensor<96xf32>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(0.0) rtol(0.0) nan(same) : tensor<96xf32>, tensor<96xf32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-80) step(1) : tensor<32xi16>
    %output = check.generate.fill value(-1.0) : tensor<96xf32>
    check.compare<@bfloat_packet_widening>(%input, %output) : (tensor<32xi16>, tensor<96xf32>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(0.0) rtol(0.0) nan(same) : tensor<96xf32>, tensor<96xf32>
    }
  }
  check.return
}
