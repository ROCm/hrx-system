    %negative_input = check.generate.iota offset(-0.5) step(-1.0) : tensor<128xf16>
    %s_i8 = check.generate.fill value(42) : tensor<128xi8>
    %u_i8 = check.generate.fill value(42) : tensor<128xi8>
    %s_i16 = check.generate.fill value(42) : tensor<128xi16>
    %u_i16 = check.generate.fill value(42) : tensor<128xi16>
    %s_i32 = check.generate.fill value(42) : tensor<128xi32>
    %u_i32 = check.generate.fill value(42) : tensor<128xi32>
    check.compare<@f16_to_integer_1>(%input, %negative_input, %s_i8, %u_i8, %s_i16, %u_i16, %s_i32, %u_i32) : (tensor<128xf16>, tensor<128xf16>, tensor<128xi8>, tensor<128xi8>, tensor<128xi16>, tensor<128xi16>, tensor<128xi32>, tensor<128xi32>) -> () {
      check.expect.bitwise actual(%s_i8) expected(%s_i8) : tensor<128xi8>
      check.expect.bitwise actual(%u_i8) expected(%u_i8) : tensor<128xi8>
      check.expect.bitwise actual(%s_i16) expected(%s_i16) : tensor<128xi16>
      check.expect.bitwise actual(%u_i16) expected(%u_i16) : tensor<128xi16>
      check.expect.bitwise actual(%s_i32) expected(%s_i32) : tensor<128xi32>
      check.expect.bitwise actual(%u_i32) expected(%u_i32) : tensor<128xi32>
    }
  }
  check.return
}

func.def @f16_to_integer_4(%input: buffer, %negative_input: buffer, %s_i8: buffer, %u_i8: buffer, %s_i16: buffer, %u_i16: buffer, %s_i32: buffer, %u_i32: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 128 : index
  %step = index.constant 4 : index
  %source = buffer.view %input[%base] : buffer -> view<128xf16>
  %negative_source = buffer.view %negative_input[%base] : buffer -> view<128xf16>
  %s_i8_view = buffer.view %s_i8[%base] : buffer -> view<128xi8>
  %u_i8_view = buffer.view %u_i8[%base] : buffer -> view<128xi8>
  %s_i16_view = buffer.view %s_i16[%base] : buffer -> view<128xi16>
  %u_i16_view = buffer.view %u_i16[%base] : buffer -> view<128xi16>
  %s_i32_view = buffer.view %s_i32[%base] : buffer -> view<128xi32>
  %u_i32_view = buffer.view %u_i32[%base] : buffer -> view<128xi32>
  scf.for %i = [%begin to %end step %step] {
    %value = vector.load %source[%i] : view<128xf16> -> vector<4xf16>
    %negative = vector.load %negative_source[%i] : view<128xf16> -> vector<4xf16>
    %s_i8_value = vector.fptosi %negative : vector<4xf16> to vector<4xi8>
    vector.store %s_i8_value, %s_i8_view[%i] : vector<4xi8>, view<128xi8>
    %u_i8_value = vector.fptoui %value : vector<4xf16> to vector<4xi8>
    vector.store %u_i8_value, %u_i8_view[%i] : vector<4xi8>, view<128xi8>
    %s_i16_value = vector.fptosi %negative : vector<4xf16> to vector<4xi16>
    vector.store %s_i16_value, %s_i16_view[%i] : vector<4xi16>, view<128xi16>
    %u_i16_value = vector.fptoui %value : vector<4xf16> to vector<4xi16>
    vector.store %u_i16_value, %u_i16_view[%i] : vector<4xi16>, view<128xi16>
    %s_i32_value = vector.fptosi %negative : vector<4xf16> to vector<4xi32>
    vector.store %s_i32_value, %s_i32_view[%i] : vector<4xi32>, view<128xi32>
    %u_i32_value = vector.fptoui %value : vector<4xf16> to vector<4xi32>
    vector.store %u_i32_value, %u_i32_view[%i] : vector<4xi32>, view<128xi32>
  }
  func.return
}

