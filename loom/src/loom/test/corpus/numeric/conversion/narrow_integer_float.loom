    vector.store %s_f16_value, %s_f16_view[%i] : vector<4xf16>, view<256xf16>
    %u_f16_value = vector.uitofp %value : vector<4xi8> to vector<4xf16>
    vector.store %u_f16_value, %u_f16_view[%i] : vector<4xf16>, view<256xf16>
    %s_bf16_value = vector.sitofp %value : vector<4xi8> to vector<4xbf16>
