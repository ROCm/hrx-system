  check.return
}

func.def @i8_to_float_4(%input: buffer, %s_f16: buffer, %u_f16: buffer, %s_bf16: buffer, %u_bf16: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 256 : index
