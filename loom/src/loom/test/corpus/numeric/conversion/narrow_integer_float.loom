func.def @f16_to_integer_1(%input: buffer, %negative_input: buffer, %s_i8: buffer, %u_i8: buffer, %s_i16: buffer, %u_i16: buffer, %s_i32: buffer, %u_i32: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 128 : index
  %step = index.constant 1 : index
  %source = buffer.view %input[%base] : buffer -> view<128xf16>
  %negative_source = buffer.view %negative_input[%base] : buffer -> view<128xf16>
  %s_i8_view = buffer.view %s_i8[%base] : buffer -> view<128xi8>
  %u_i8_view = buffer.view %u_i8[%base] : buffer -> view<128xi8>
  %s_i16_view = buffer.view %s_i16[%base] : buffer -> view<128xi16>
  %u_i16_view = buffer.view %u_i16[%base] : buffer -> view<128xi16>
  %s_i32_view = buffer.view %s_i32[%base] : buffer -> view<128xi32>
  %u_i32_view = buffer.view %u_i32[%base] : buffer -> view<128xi32>
  scf.for %i = [%begin to %end step %step] {
    %value = view.load %source[%i] : view<128xf16> -> f16
    %negative = view.load %negative_source[%i] : view<128xf16> -> f16
    %s_i8_value = scalar.fptosi %negative : f16 to i8
    view.store %s_i8_value, %s_i8_view[%i] : i8, view<128xi8>
    %u_i8_value = scalar.fptoui %value : f16 to i8
    view.store %u_i8_value, %u_i8_view[%i] : i8, view<128xi8>
    %s_i16_value = scalar.fptosi %negative : f16 to i16
    view.store %s_i16_value, %s_i16_view[%i] : i16, view<128xi16>
    %u_i16_value = scalar.fptoui %value : f16 to i16
    view.store %u_i16_value, %u_i16_view[%i] : i16, view<128xi16>
    %s_i32_value = scalar.fptosi %negative : f16 to i32
    view.store %s_i32_value, %s_i32_view[%i] : i32, view<128xi32>
    %u_i32_value = scalar.fptoui %value : f16 to i32
    view.store %u_i32_value, %u_i32_view[%i] : i32, view<128xi32>
  }
  func.return
}

