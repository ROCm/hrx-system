  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-128) step(1) : tensor<256xi8>
    %signed = check.generate.fill value(-1.0) : tensor<304xf16>
    %unsigned = check.generate.fill value(-1.0) : tensor<304xf16>
    check.compare<@i8_to_f16_vector_widths>(%input, %signed, %unsigned) : (tensor<256xi8>, tensor<304xf16>, tensor<304xf16>) -> () {
      check.expect.bitwise actual(%signed) expected(%signed) : tensor<304xf16>
      check.expect.bitwise actual(%unsigned) expected(%unsigned) : tensor<304xf16>
    }
  }
  check.return
}

