// Integer signedness and f32 rounding stay observable after scalar and packed
// conversion. The oracle walks scalar elements instead of converting vectors.

kernel.def @integer_floating_shapes() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%uniform_bits: i64, %input: buffer, %output: buffer) {
  %uniform = scalar.trunci %uniform_bits : i64 to i32
  %scale = scalar.constant 1.5 : f32
  %base = index.constant 0 : offset
  %aligned = buffer.assume.alignment %input {minimum_alignment = 16} : buffer
  %bytes = buffer.view %aligned[%base] : buffer -> view<16xi8>
  %halves = buffer.view %aligned[%base] : buffer -> view<8xi16>
  %words = buffer.view %aligned[%base] : buffer -> view<4xi32>
  %result = buffer.view %output[%base] : buffer -> view<32xf32>
  %byte = scalar.trunci %uniform : i32 to i8
  %half = scalar.trunci %uniform : i32 to i16
  %signed_word = scalar.sitofp %uniform : i32 to f32
  %unsigned_word = scalar.uitofp %uniform : i32 to f32
  %signed_byte = scalar.sitofp %byte : i8 to f32
  %unsigned_byte = scalar.uitofp %byte : i8 to f32
  %signed_half = scalar.sitofp %half : i16 to f32
  %unsigned_half = scalar.uitofp %half : i16 to f32
  view.store %signed_word, %result[0] : f32, view<32xf32>
  view.store %unsigned_word, %result[1] : f32, view<32xf32>
  view.store %signed_byte, %result[2] : f32, view<32xf32>
  view.store %unsigned_byte, %result[3] : f32, view<32xf32>
  view.store %signed_half, %result[4] : f32, view<32xf32>
  view.store %unsigned_half, %result[5] : f32, view<32xf32>
  %loaded = view.load %bytes[0] : view<16xi8> -> i8
  %loaded_float = scalar.sitofp %loaded : i8 to f32
  view.store %loaded_float, %result[6] : f32, view<32xf32>
  %bytes4 = vector.load %bytes[0] : view<16xi8> -> vector<4xi8>
  %bytes8 = vector.load %bytes[0] : view<16xi8> -> vector<8xi8>
  %halves2 = vector.load %halves[0] : view<8xi16> -> vector<2xi16>
  %words2 = vector.load %words[0] : view<4xi32> -> vector<2xi32>
  %signed_bytes4 = vector.sitofp %bytes4 : vector<4xi8> to vector<4xf32>
  %unsigned_bytes4 = vector.uitofp %bytes4 : vector<4xi8> to vector<4xf32>
  %unsigned_bytes8 = vector.uitofp %bytes8 : vector<8xi8> to vector<8xf32>
  %signed_halves2 = vector.sitofp %halves2 : vector<2xi16> to vector<2xf32>
  %unsigned_halves2 = vector.uitofp %halves2 : vector<2xi16> to vector<2xf32>
  %signed_words2 = vector.sitofp %words2 : vector<2xi32> to vector<2xf32>
  %unsigned_words2 = vector.uitofp %words2 : vector<2xi32> to vector<2xf32>
  %scales = vector.splat %scale : vector<2xf32>
  %scaled = vector.mulf %signed_words2, %scales : vector<2xf32>
  vector.store %signed_bytes4, %result[8] : vector<4xf32>, view<32xf32>
  vector.store %unsigned_bytes4, %result[12] : vector<4xf32>, view<32xf32>
  vector.store %unsigned_bytes8, %result[16] : vector<8xf32>, view<32xf32>
  vector.store %signed_halves2, %result[24] : vector<2xf32>, view<32xf32>
  vector.store %unsigned_halves2, %result[26] : vector<2xf32>, view<32xf32>
  vector.store %scaled, %result[28] : vector<2xf32>, view<32xf32>
  vector.store %unsigned_words2, %result[30] : vector<2xf32>, view<32xf32>
  kernel.return
}

func.def @integer_floating_shapes_oracle(%uniform_bits: i64, %input: buffer, %output: buffer) {
  %uniform = scalar.trunci %uniform_bits : i64 to i32
  %scale = scalar.constant 1.5 : f32
  %base = index.constant 0 : offset
  %bytes = buffer.view %input[%base] : buffer -> view<16xi8>
  %halves = buffer.view %input[%base] : buffer -> view<8xi16>
  %words = buffer.view %input[%base] : buffer -> view<4xi32>
  %result = buffer.view %output[%base] : buffer -> view<32xf32>
  %byte = scalar.trunci %uniform : i32 to i8
  %half = scalar.trunci %uniform : i32 to i16
  %signed_word = scalar.sitofp %uniform : i32 to f32
  %unsigned_word = scalar.uitofp %uniform : i32 to f32
  %signed_byte = scalar.sitofp %byte : i8 to f32
  %unsigned_byte = scalar.uitofp %byte : i8 to f32
  %signed_half = scalar.sitofp %half : i16 to f32
  %unsigned_half = scalar.uitofp %half : i16 to f32
  view.store %signed_word, %result[0] : f32, view<32xf32>
  view.store %unsigned_word, %result[1] : f32, view<32xf32>
  view.store %signed_byte, %result[2] : f32, view<32xf32>
  view.store %unsigned_byte, %result[3] : f32, view<32xf32>
  view.store %signed_half, %result[4] : f32, view<32xf32>
  view.store %unsigned_half, %result[5] : f32, view<32xf32>
  %loaded = view.load %bytes[0] : view<16xi8> -> i8
  %loaded_float = scalar.sitofp %loaded : i8 to f32
  view.store %loaded_float, %result[6] : f32, view<32xf32>
  %begin = index.constant 0 : index
  %end = index.constant 8 : index
  %step = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c12 = index.constant 12 : index
  %c16 = index.constant 16 : index
  %c24 = index.constant 24 : index
  %c26 = index.constant 26 : index
  %c28 = index.constant 28 : index
  %c30 = index.constant 30 : index
  scf.for %i = [%begin to %end step %step] {
    %byte = view.load %bytes[%i] : view<16xi8> -> i8
    %unsigned = scalar.uitofp %byte : i8 to f32
    %wide_position = index.add %i, %c16 : index
    view.store %unsigned, %result[%wide_position] : f32, view<32xf32>
    %below4 = index.cmp ult, %i, %c4 : index
    scf.if %below4 {
      %signed = scalar.sitofp %byte : i8 to f32
      %signed_position = index.add %i, %c8 : index
      %unsigned_position = index.add %i, %c12 : index
      view.store %signed, %result[%signed_position] : f32, view<32xf32>
      view.store %unsigned, %result[%unsigned_position] : f32, view<32xf32>
    }
    %below2 = index.cmp ult, %i, %c2 : index
    scf.if %below2 {
      %half = view.load %halves[%i] : view<8xi16> -> i16
      %word = view.load %words[%i] : view<4xi32> -> i32
      %signed_half = scalar.sitofp %half : i16 to f32
      %unsigned_half = scalar.uitofp %half : i16 to f32
      %signed_word = scalar.sitofp %word : i32 to f32
      %unsigned_word = scalar.uitofp %word : i32 to f32
      %scaled = scalar.mulf %signed_word, %scale : f32
      %half_signed_position = index.add %i, %c24 : index
      %half_unsigned_position = index.add %i, %c26 : index
      %word_signed_position = index.add %i, %c28 : index
      %word_unsigned_position = index.add %i, %c30 : index
      view.store %signed_half, %result[%half_signed_position] : f32, view<32xf32>
      view.store %unsigned_half, %result[%half_unsigned_position] : f32, view<32xf32>
      view.store %scaled, %result[%word_signed_position] : f32, view<32xf32>
      view.store %unsigned_word, %result[%word_unsigned_position] : f32, view<32xf32>
    }
  }
  func.return
}

check.scenario @integer_floating_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %uniform = check.literal value(-2147483648) : i64
    %input = check.generate.iota offset(16777215) step(1) : tensor<4xi32>
    %storage = check.generate.fill value(-123.0) : tensor<40xf32>
    %output = check.tensor.view %storage offset(16) : tensor<40xf32> -> tensor<32xf32>
    check.compare<@integer_floating_shapes, @integer_floating_shapes_oracle>(%uniform, %input, %output) : (i64, tensor<4xi32>, tensor<32xf32>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<40xf32>
    }
  }
  check.trial[64](%trial: index, %entropy: check.entropy) {
    %uniform_entropy = check.entropy.fork %entropy name("uniform") : check.entropy
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %uniform = check.entropy.read %uniform_entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-2147483648 to 2147483647) : tensor<4xi32>
    %storage = check.generate.fill value(-123.0) : tensor<40xf32>
    %output = check.tensor.view %storage offset(16) : tensor<40xf32> -> tensor<32xf32>
    check.compare<@integer_floating_shapes, @integer_floating_shapes_oracle>(%uniform, %input, %output) : (i64, tensor<4xi32>, tensor<32xf32>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<40xf32>
    }
  }
  check.return
}

// Wide integers require one rounding directly to f32. The kernel exercises
// scalar and vector forms while the oracle converts each element independently.
kernel.def @wide_integer_floating_shapes() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%signed_input: buffer, %unsigned_input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %signed = buffer.view %signed_input[%base] : buffer -> view<4xi64>
  %unsigned = buffer.view %unsigned_input[%base] : buffer -> view<4xi64>
  %result = buffer.view %output[%base] : buffer -> view<14xf32>
  %signed_scalar = view.load %signed[0] : view<4xi64> -> i64
  %unsigned_scalar = view.load %unsigned[0] : view<4xi64> -> i64
  %signed_scalar_f32 = scalar.sitofp %signed_scalar : i64 to f32
  %unsigned_scalar_f32 = scalar.uitofp %unsigned_scalar : i64 to f32
  view.store %signed_scalar_f32, %result[0] : f32, view<14xf32>
  view.store %unsigned_scalar_f32, %result[1] : f32, view<14xf32>
  %signed2 = vector.load %signed[0] : view<4xi64> -> vector<2xi64>
  %unsigned2 = vector.load %unsigned[0] : view<4xi64> -> vector<2xi64>
  %signed2_f32 = vector.sitofp %signed2 : vector<2xi64> to vector<2xf32>
  %unsigned2_f32 = vector.uitofp %unsigned2 : vector<2xi64> to vector<2xf32>
  vector.store %signed2_f32, %result[2] : vector<2xf32>, view<14xf32>
  vector.store %unsigned2_f32, %result[4] : vector<2xf32>, view<14xf32>
  %signed4 = vector.load %signed[0] : view<4xi64> -> vector<4xi64>
  %unsigned4 = vector.load %unsigned[0] : view<4xi64> -> vector<4xi64>
  %signed4_f32 = vector.sitofp %signed4 : vector<4xi64> to vector<4xf32>
  %unsigned4_f32 = vector.uitofp %unsigned4 : vector<4xi64> to vector<4xf32>
  vector.store %signed4_f32, %result[6] : vector<4xf32>, view<14xf32>
  vector.store %unsigned4_f32, %result[10] : vector<4xf32>, view<14xf32>
  kernel.return
}

func.def @wide_integer_floating_shapes_oracle(%signed_input: buffer, %unsigned_input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %signed = buffer.view %signed_input[%base] : buffer -> view<4xi64>
  %unsigned = buffer.view %unsigned_input[%base] : buffer -> view<4xi64>
  %result = buffer.view %output[%base] : buffer -> view<14xf32>
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %c2 = index.constant 2 : index
  %step = index.constant 1 : index
  %signed4_base = index.constant 6 : index
  %unsigned2_base = index.constant 4 : index
  %unsigned4_base = index.constant 10 : index
  scf.for %i = [%begin to %end step %step] {
    %signed_value = view.load %signed[%i] : view<4xi64> -> i64
    %unsigned_value = view.load %unsigned[%i] : view<4xi64> -> i64
    %signed_f32 = scalar.sitofp %signed_value : i64 to f32
    %unsigned_f32 = scalar.uitofp %unsigned_value : i64 to f32
    %signed4_position = index.add %signed4_base, %i : index
    %unsigned4_position = index.add %unsigned4_base, %i : index
    view.store %signed_f32, %result[%signed4_position] : f32, view<14xf32>
    view.store %unsigned_f32, %result[%unsigned4_position] : f32, view<14xf32>
    %first_two = index.cmp ult, %i, %c2 : index
    scf.if %first_two {
      %signed2_position = index.add %c2, %i : index
      %unsigned2_position = index.add %unsigned2_base, %i : index
      view.store %signed_f32, %result[%signed2_position] : f32, view<14xf32>
      view.store %unsigned_f32, %result[%unsigned2_position] : f32, view<14xf32>
    }
  }
  %signed_scalar = view.load %signed[0] : view<4xi64> -> i64
  %unsigned_scalar = view.load %unsigned[0] : view<4xi64> -> i64
  %signed_scalar_f32 = scalar.sitofp %signed_scalar : i64 to f32
  %unsigned_scalar_f32 = scalar.uitofp %unsigned_scalar : i64 to f32
  view.store %signed_scalar_f32, %result[0] : f32, view<14xf32>
  view.store %unsigned_scalar_f32, %result[1] : f32, view<14xf32>
  func.return
}

check.scenario @wide_integer_floating_values {
  // These values lie immediately around f32 midpoints that an intervening f64
  // conversion rounds onto the midpoint. They distinguish direct rounding.
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %signed = check.generate.iota offset(9007199791611903) step(1) : tensor<4xi64>
    %unsigned = check.generate.iota offset(-9223371487098961921) step(1) : tensor<4xi64>
    %storage = check.generate.fill value(-123.0) : tensor<18xf32>
    %output = check.tensor.view %storage offset(2) : tensor<18xf32> -> tensor<14xf32>
    check.compare<@wide_integer_floating_shapes, @wide_integer_floating_shapes_oracle>(%signed, %unsigned, %output) : (tensor<4xi64>, tensor<4xi64>, tensor<14xf32>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<18xf32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %signed = check.generate.iota offset(-9007199791611906) step(1) : tensor<4xi64>
    %unsigned = check.generate.iota offset(9007200865353726) step(1) : tensor<4xi64>
    %storage = check.generate.fill value(-123.0) : tensor<18xf32>
    %output = check.tensor.view %storage offset(2) : tensor<18xf32> -> tensor<14xf32>
    check.compare<@wide_integer_floating_shapes, @wide_integer_floating_shapes_oracle>(%signed, %unsigned, %output) : (tensor<4xi64>, tensor<4xi64>, tensor<14xf32>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<18xf32>
    }
  }
  check.trial[64](%trial: index, %entropy: check.entropy) {
    %unsigned_entropy = check.entropy.fork %entropy name("unsigned") : check.entropy
    %signed_seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %unsigned_seed = check.entropy.read %unsigned_entropy[%trial] : check.entropy -> i64
    %signed = check.generate.random.uniform seed(%signed_seed) range(-9223372036854775808 to 9223372036854775807) : tensor<4xi64>
    %unsigned = check.generate.random.uniform seed(%unsigned_seed) range(-9223372036854775808 to 9223372036854775807) : tensor<4xi64>
    %storage = check.generate.fill value(-123.0) : tensor<18xf32>
    %output = check.tensor.view %storage offset(2) : tensor<18xf32> -> tensor<14xf32>
    check.compare<@wide_integer_floating_shapes, @wide_integer_floating_shapes_oracle>(%signed, %unsigned, %output) : (tensor<4xi64>, tensor<4xi64>, tensor<14xf32>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<18xf32>
    }
  }
  check.return
}

// All float-to-integer inputs are finite and within the destination range.
// Narrow results use fractional values around zero and both signed boundaries;
// wide results separately exercise the full signed and unsigned i32 domains.
kernel.def @floating_integer_shapes() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %wide_input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %aligned = buffer.assume.alignment %input {minimum_alignment = 16} : buffer
  %source = buffer.view %aligned[%base] : buffer -> view<8xf32>
  %wide_source = buffer.view %wide_input[%base] : buffer -> view<4xf32>
  %bytes = buffer.view %output[%base] : buffer -> view<30xi8>
  %half_base = index.constant 32 : offset
  %word_base = index.constant 40 : offset
  %scalar_half_base = index.constant 72 : offset
  %scalar_word_base = index.constant 76 : offset
  %halves = buffer.view %output[%half_base] : buffer -> view<4xi16>
  %words = buffer.view %output[%word_base] : buffer -> view<8xi32>
  %scalar_halves = buffer.view %output[%scalar_half_base] : buffer -> view<2xi16>
  %scalar_words = buffer.view %output[%scalar_word_base] : buffer -> view<2xi32>
  %values8 = vector.load %source[0] : view<8xf32> -> vector<8xf32>
  %values4 = vector.load %source[0] : view<8xf32> -> vector<4xf32>
  %values3 = vector.load %source[0] : view<8xf32> -> vector<3xf32>
  %values2 = vector.load %source[0] : view<8xf32> -> vector<2xf32>
  %bias8 = vector.splatf 128.0 : vector<8xf32>
  %bias4 = vector.splatf 128.0 : vector<4xf32>
  %bias2 = vector.splatf 128.0 : vector<2xf32>
  %signed8 = vector.subf %values8, %bias8 : vector<8xf32>
  %signed4 = vector.subf %values4, %bias4 : vector<4xf32>
  %signed2 = vector.subf %values2, %bias2 : vector<2xf32>
  %s8 = vector.fptosi %signed8 : vector<8xf32> to vector<8xi8>
  %u8 = vector.fptoui %values8 : vector<8xf32> to vector<8xi8>
  %s4 = vector.fptosi %signed4 : vector<4xf32> to vector<4xi8>
  %u4 = vector.fptoui %values4 : vector<4xf32> to vector<4xi8>
  %u3 = vector.fptoui %values3 : vector<3xf32> to vector<3xi8>
  %s2 = vector.fptosi %signed2 : vector<2xf32> to vector<2xi16>
  %u2 = vector.fptoui %values2 : vector<2xf32> to vector<2xi16>
  vector.store %s8, %bytes[0] : vector<8xi8>, view<30xi8>
  vector.store %u8, %bytes[8] : vector<8xi8>, view<30xi8>
  vector.store %s4, %bytes[16] : vector<4xi8>, view<30xi8>
  vector.store %u4, %bytes[20] : vector<4xi8>, view<30xi8>
  vector.store %u3, %bytes[24] : vector<3xi8>, view<30xi8>
  vector.store %s2, %halves[0] : vector<2xi16>, view<4xi16>
  vector.store %u2, %halves[2] : vector<2xi16>, view<4xi16>
  %wide_values = vector.load %wide_source[0] : view<4xf32> -> vector<4xf32>
  %wide_bias = vector.splatf 2147483648.0 : vector<4xf32>
  %wide_signed = vector.subf %wide_values, %wide_bias : vector<4xf32>
  %signed_words = vector.fptosi %wide_signed : vector<4xf32> to vector<4xi32>
  %unsigned_words = vector.fptoui %wide_values : vector<4xf32> to vector<4xi32>
  vector.store %signed_words, %words[0] : vector<4xi32>, view<8xi32>
  vector.store %unsigned_words, %words[4] : vector<4xi32>, view<8xi32>
  %scalar = view.load %source[0] : view<8xf32> -> f32
  %bias = scalar.constant 128.0 : f32
  %negative = scalar.subf %scalar, %bias : f32
  %signed_byte = scalar.fptosi %negative : f32 to i8
  %unsigned_byte = scalar.fptoui %scalar : f32 to i8
  %signed_half = scalar.fptosi %negative : f32 to i16
  %unsigned_half = scalar.fptoui %scalar : f32 to i16
  %wide_scalar = view.load %wide_source[0] : view<4xf32> -> f32
  %scalar_bias = scalar.constant 2147483648.0 : f32
  %signed_scalar = scalar.subf %wide_scalar, %scalar_bias : f32
  %signed_word = scalar.fptosi %signed_scalar : f32 to i32
  %unsigned_word = scalar.fptoui %wide_scalar : f32 to i32
  view.store %signed_byte, %bytes[28] : i8, view<30xi8>
  view.store %unsigned_byte, %bytes[29] : i8, view<30xi8>
  view.store %signed_half, %scalar_halves[0] : i16, view<2xi16>
  view.store %unsigned_half, %scalar_halves[1] : i16, view<2xi16>
  view.store %signed_word, %scalar_words[0] : i32, view<2xi32>
  view.store %unsigned_word, %scalar_words[1] : i32, view<2xi32>
  kernel.return
}

func.def @floating_integer_shapes_oracle(%input: buffer, %wide_input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<8xf32>
  %wide_source = buffer.view %wide_input[%base] : buffer -> view<4xf32>
  %bytes = buffer.view %output[%base] : buffer -> view<30xi8>
  %half_base = index.constant 32 : offset
  %word_base = index.constant 40 : offset
  %scalar_half_base = index.constant 72 : offset
  %scalar_word_base = index.constant 76 : offset
  %halves = buffer.view %output[%half_base] : buffer -> view<4xi16>
  %words = buffer.view %output[%word_base] : buffer -> view<8xi32>
  %scalar_halves = buffer.view %output[%scalar_half_base] : buffer -> view<2xi16>
  %scalar_words = buffer.view %output[%scalar_word_base] : buffer -> view<2xi32>
  %begin = index.constant 0 : index
  %end = index.constant 8 : index
  %step = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c20 = index.constant 20 : index
  %c24 = index.constant 24 : index
  %bias = scalar.constant 128.0 : f32
  %wide_bias = scalar.constant 2147483648.0 : f32
  scf.for %i = [%begin to %end step %step] {
    %value = view.load %source[%i] : view<8xf32> -> f32
    %negative = scalar.subf %value, %bias : f32
    %signed_byte = scalar.fptosi %negative : f32 to i8
    %unsigned_byte = scalar.fptoui %value : f32 to i8
    %unsigned_position = index.add %i, %c8 : index
    view.store %signed_byte, %bytes[%i] : i8, view<30xi8>
    view.store %unsigned_byte, %bytes[%unsigned_position] : i8, view<30xi8>
    %below4 = index.cmp ult, %i, %c4 : index
    scf.if %below4 {
      %signed_position = index.add %i, %c16 : index
      %unsigned_position = index.add %i, %c20 : index
      view.store %signed_byte, %bytes[%signed_position] : i8, view<30xi8>
      view.store %unsigned_byte, %bytes[%unsigned_position] : i8, view<30xi8>
      %wide_value = view.load %wide_source[%i] : view<4xf32> -> f32
      %wide_signed = scalar.subf %wide_value, %wide_bias : f32
      %signed_word = scalar.fptosi %wide_signed : f32 to i32
      %unsigned_word = scalar.fptoui %wide_value : f32 to i32
      %unsigned_word_position = index.add %i, %c4 : index
      view.store %signed_word, %words[%i] : i32, view<8xi32>
      view.store %unsigned_word, %words[%unsigned_word_position] : i32, view<8xi32>
    }
    %below3 = index.cmp ult, %i, %c3 : index
    scf.if %below3 {
      %position = index.add %i, %c24 : index
      view.store %unsigned_byte, %bytes[%position] : i8, view<30xi8>
    }
    %below2 = index.cmp ult, %i, %c2 : index
    scf.if %below2 {
      %signed_half = scalar.fptosi %negative : f32 to i16
      %unsigned_half = scalar.fptoui %value : f32 to i16
      %unsigned_half_position = index.add %i, %c2 : index
      view.store %signed_half, %halves[%i] : i16, view<4xi16>
      view.store %unsigned_half, %halves[%unsigned_half_position] : i16, view<4xi16>
    }
  }
  %scalar = view.load %source[0] : view<8xf32> -> f32
  %negative = scalar.subf %scalar, %bias : f32
  %signed_byte = scalar.fptosi %negative : f32 to i8
  %unsigned_byte = scalar.fptoui %scalar : f32 to i8
  %signed_half = scalar.fptosi %negative : f32 to i16
  %unsigned_half = scalar.fptoui %scalar : f32 to i16
  %wide_scalar = view.load %wide_source[0] : view<4xf32> -> f32
  %signed_scalar = scalar.subf %wide_scalar, %wide_bias : f32
  %signed_word = scalar.fptosi %signed_scalar : f32 to i32
  %unsigned_word = scalar.fptoui %wide_scalar : f32 to i32
  view.store %signed_byte, %bytes[28] : i8, view<30xi8>
  view.store %unsigned_byte, %bytes[29] : i8, view<30xi8>
  view.store %signed_half, %scalar_halves[0] : i16, view<2xi16>
  view.store %unsigned_half, %scalar_halves[1] : i16, view<2xi16>
  view.store %signed_word, %scalar_words[0] : i32, view<2xi32>
  view.store %unsigned_word, %scalar_words[1] : i32, view<2xi32>
  func.return
}

check.scenario @floating_integer_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(0.75) step(36.375) : tensor<8xf32>
    %wide_input = check.generate.iota offset(0.0) step(1431655680.0) : tensor<4xf32>
    %storage = check.generate.fill value(-123) : tensor<116xi8>
    %output = check.tensor.view %storage offset(16) : tensor<116xi8> -> tensor<84xi8>
    check.compare<@floating_integer_shapes, @floating_integer_shapes_oracle>(%input, %wide_input, %output) : (tensor<8xf32>, tensor<4xf32>, tensor<84xi8>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<116xi8>
    }
  }
  check.trial[64](%trial: index, %entropy: check.entropy) {
    %wide_entropy = check.entropy.fork %entropy name("wide") : check.entropy
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %wide_seed = check.entropy.read %wide_entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(0.0 to 255.75) : tensor<8xf32>
    %wide_input = check.generate.random.uniform seed(%wide_seed) range(0.0 to 4294967040.0) : tensor<4xf32>
    %storage = check.generate.fill value(-123) : tensor<116xi8>
    %output = check.tensor.view %storage offset(16) : tensor<116xi8> -> tensor<84xi8>
    check.compare<@floating_integer_shapes, @floating_integer_shapes_oracle>(%input, %wide_input, %output) : (tensor<8xf32>, tensor<4xf32>, tensor<84xi8>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<116xi8>
    }
  }
  check.return
}

// BF16, F32, and F64 can all represent I64-domain values beyond I32. Exercise
// scalar and vector conversions through buffer results so function-result
// transport cannot hide the conversion contract.
kernel.def @wide_floating_integer_shapes() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%signed_bf16_input: buffer, %unsigned_bf16_input: buffer, %signed_f32_input: buffer, %unsigned_f32_input: buffer, %signed_f64_input: buffer, %unsigned_f64_input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %signed_bf16 = buffer.view %signed_bf16_input[%base] : buffer -> view<4xbf16>
  %unsigned_bf16 = buffer.view %unsigned_bf16_input[%base] : buffer -> view<4xbf16>
  %signed_f32 = buffer.view %signed_f32_input[%base] : buffer -> view<4xf32>
  %unsigned_f32 = buffer.view %unsigned_f32_input[%base] : buffer -> view<4xf32>
  %signed_f64 = buffer.view %signed_f64_input[%base] : buffer -> view<4xf64>
  %unsigned_f64 = buffer.view %unsigned_f64_input[%base] : buffer -> view<4xf64>
  %result = buffer.view %output[%base] : buffer -> view<42xi64>

  %signed_bf16_scalar = view.load %signed_bf16[0] : view<4xbf16> -> bf16
  %unsigned_bf16_scalar = view.load %unsigned_bf16[0] : view<4xbf16> -> bf16
  %signed_bf16_scalar_i64 = scalar.fptosi %signed_bf16_scalar : bf16 to i64
  %unsigned_bf16_scalar_i64 = scalar.fptoui %unsigned_bf16_scalar : bf16 to i64
  view.store %signed_bf16_scalar_i64, %result[0] : i64, view<42xi64>
  view.store %unsigned_bf16_scalar_i64, %result[7] : i64, view<42xi64>
  %signed_bf16_2 = vector.load %signed_bf16[0] : view<4xbf16> -> vector<2xbf16>
  %unsigned_bf16_2 = vector.load %unsigned_bf16[0] : view<4xbf16> -> vector<2xbf16>
  %signed_bf16_2_i64 = vector.fptosi %signed_bf16_2 : vector<2xbf16> to vector<2xi64>
  %unsigned_bf16_2_i64 = vector.fptoui %unsigned_bf16_2 : vector<2xbf16> to vector<2xi64>
  vector.store %signed_bf16_2_i64, %result[1] : vector<2xi64>, view<42xi64>
  vector.store %unsigned_bf16_2_i64, %result[8] : vector<2xi64>, view<42xi64>
  %signed_bf16_4 = vector.load %signed_bf16[0] : view<4xbf16> -> vector<4xbf16>
  %unsigned_bf16_4 = vector.load %unsigned_bf16[0] : view<4xbf16> -> vector<4xbf16>
  %signed_bf16_4_i64 = vector.fptosi %signed_bf16_4 : vector<4xbf16> to vector<4xi64>
  %unsigned_bf16_4_i64 = vector.fptoui %unsigned_bf16_4 : vector<4xbf16> to vector<4xi64>
  vector.store %signed_bf16_4_i64, %result[3] : vector<4xi64>, view<42xi64>
  vector.store %unsigned_bf16_4_i64, %result[10] : vector<4xi64>, view<42xi64>

  %signed_f32_scalar = view.load %signed_f32[0] : view<4xf32> -> f32
  %unsigned_f32_scalar = view.load %unsigned_f32[0] : view<4xf32> -> f32
  %signed_f32_scalar_i64 = scalar.fptosi %signed_f32_scalar : f32 to i64
  %unsigned_f32_scalar_i64 = scalar.fptoui %unsigned_f32_scalar : f32 to i64
  view.store %signed_f32_scalar_i64, %result[14] : i64, view<42xi64>
  view.store %unsigned_f32_scalar_i64, %result[21] : i64, view<42xi64>
  %signed_f32_2 = vector.load %signed_f32[0] : view<4xf32> -> vector<2xf32>
  %unsigned_f32_2 = vector.load %unsigned_f32[0] : view<4xf32> -> vector<2xf32>
  %signed_f32_2_i64 = vector.fptosi %signed_f32_2 : vector<2xf32> to vector<2xi64>
  %unsigned_f32_2_i64 = vector.fptoui %unsigned_f32_2 : vector<2xf32> to vector<2xi64>
  vector.store %signed_f32_2_i64, %result[15] : vector<2xi64>, view<42xi64>
  vector.store %unsigned_f32_2_i64, %result[22] : vector<2xi64>, view<42xi64>
  %signed_f32_4 = vector.load %signed_f32[0] : view<4xf32> -> vector<4xf32>
  %unsigned_f32_4 = vector.load %unsigned_f32[0] : view<4xf32> -> vector<4xf32>
  %signed_f32_4_i64 = vector.fptosi %signed_f32_4 : vector<4xf32> to vector<4xi64>
  %unsigned_f32_4_i64 = vector.fptoui %unsigned_f32_4 : vector<4xf32> to vector<4xi64>
  vector.store %signed_f32_4_i64, %result[17] : vector<4xi64>, view<42xi64>
  vector.store %unsigned_f32_4_i64, %result[24] : vector<4xi64>, view<42xi64>

  %signed_f64_scalar = view.load %signed_f64[0] : view<4xf64> -> f64
  %unsigned_f64_scalar = view.load %unsigned_f64[0] : view<4xf64> -> f64
  %signed_f64_scalar_i64 = scalar.fptosi %signed_f64_scalar : f64 to i64
  %unsigned_f64_scalar_i64 = scalar.fptoui %unsigned_f64_scalar : f64 to i64
  view.store %signed_f64_scalar_i64, %result[28] : i64, view<42xi64>
  view.store %unsigned_f64_scalar_i64, %result[35] : i64, view<42xi64>
  %signed_f64_2 = vector.load %signed_f64[0] : view<4xf64> -> vector<2xf64>
  %unsigned_f64_2 = vector.load %unsigned_f64[0] : view<4xf64> -> vector<2xf64>
  %signed_f64_2_i64 = vector.fptosi %signed_f64_2 : vector<2xf64> to vector<2xi64>
  %unsigned_f64_2_i64 = vector.fptoui %unsigned_f64_2 : vector<2xf64> to vector<2xi64>
  vector.store %signed_f64_2_i64, %result[29] : vector<2xi64>, view<42xi64>
  vector.store %unsigned_f64_2_i64, %result[36] : vector<2xi64>, view<42xi64>
  %signed_f64_4 = vector.load %signed_f64[0] : view<4xf64> -> vector<4xf64>
  %unsigned_f64_4 = vector.load %unsigned_f64[0] : view<4xf64> -> vector<4xf64>
  %signed_f64_4_i64 = vector.fptosi %signed_f64_4 : vector<4xf64> to vector<4xi64>
  %unsigned_f64_4_i64 = vector.fptoui %unsigned_f64_4 : vector<4xf64> to vector<4xi64>
  vector.store %signed_f64_4_i64, %result[31] : vector<4xi64>, view<42xi64>
  vector.store %unsigned_f64_4_i64, %result[38] : vector<4xi64>, view<42xi64>
  kernel.return
}

func.def @wide_floating_integer_shapes_oracle(%signed_bf16_input: buffer, %unsigned_bf16_input: buffer, %signed_f32_input: buffer, %unsigned_f32_input: buffer, %signed_f64_input: buffer, %unsigned_f64_input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %signed_bf16 = buffer.view %signed_bf16_input[%base] : buffer -> view<4xbf16>
  %unsigned_bf16 = buffer.view %unsigned_bf16_input[%base] : buffer -> view<4xbf16>
  %signed_f32 = buffer.view %signed_f32_input[%base] : buffer -> view<4xf32>
  %unsigned_f32 = buffer.view %unsigned_f32_input[%base] : buffer -> view<4xf32>
  %signed_f64 = buffer.view %signed_f64_input[%base] : buffer -> view<4xf64>
  %unsigned_f64 = buffer.view %unsigned_f64_input[%base] : buffer -> view<4xf64>
  %result = buffer.view %output[%base] : buffer -> view<42xi64>
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %c2 = index.constant 2 : index
  %step = index.constant 1 : index
  %signed_bf16_2_base = index.constant 1 : index
  %signed_bf16_4_base = index.constant 3 : index
  %unsigned_bf16_2_base = index.constant 8 : index
  %unsigned_bf16_4_base = index.constant 10 : index
  %signed_f32_2_base = index.constant 15 : index
  %signed_f32_4_base = index.constant 17 : index
  %unsigned_f32_2_base = index.constant 22 : index
  %unsigned_f32_4_base = index.constant 24 : index
  %signed_f64_2_base = index.constant 29 : index
  %signed_f64_4_base = index.constant 31 : index
  %unsigned_f64_2_base = index.constant 36 : index
  %unsigned_f64_4_base = index.constant 38 : index

  scf.for %i = [%begin to %end step %step] {
    %signed_value = view.load %signed_bf16[%i] : view<4xbf16> -> bf16
    %unsigned_value = view.load %unsigned_bf16[%i] : view<4xbf16> -> bf16
    %signed_integer = scalar.fptosi %signed_value : bf16 to i64
    %unsigned_integer = scalar.fptoui %unsigned_value : bf16 to i64
    %signed4_position = index.add %signed_bf16_4_base, %i : index
    %unsigned4_position = index.add %unsigned_bf16_4_base, %i : index
    view.store %signed_integer, %result[%signed4_position] : i64, view<42xi64>
    view.store %unsigned_integer, %result[%unsigned4_position] : i64, view<42xi64>
    %first_two = index.cmp ult, %i, %c2 : index
    scf.if %first_two {
      %signed2_position = index.add %signed_bf16_2_base, %i : index
      %unsigned2_position = index.add %unsigned_bf16_2_base, %i : index
      view.store %signed_integer, %result[%signed2_position] : i64, view<42xi64>
      view.store %unsigned_integer, %result[%unsigned2_position] : i64, view<42xi64>
    }
  }
  scf.for %i = [%begin to %end step %step] {
    %signed_value = view.load %signed_f32[%i] : view<4xf32> -> f32
    %unsigned_value = view.load %unsigned_f32[%i] : view<4xf32> -> f32
    %signed_integer = scalar.fptosi %signed_value : f32 to i64
    %unsigned_integer = scalar.fptoui %unsigned_value : f32 to i64
    %signed4_position = index.add %signed_f32_4_base, %i : index
    %unsigned4_position = index.add %unsigned_f32_4_base, %i : index
    view.store %signed_integer, %result[%signed4_position] : i64, view<42xi64>
    view.store %unsigned_integer, %result[%unsigned4_position] : i64, view<42xi64>
    %first_two = index.cmp ult, %i, %c2 : index
    scf.if %first_two {
      %signed2_position = index.add %signed_f32_2_base, %i : index
      %unsigned2_position = index.add %unsigned_f32_2_base, %i : index
      view.store %signed_integer, %result[%signed2_position] : i64, view<42xi64>
      view.store %unsigned_integer, %result[%unsigned2_position] : i64, view<42xi64>
    }
  }
  scf.for %i = [%begin to %end step %step] {
    %signed_value = view.load %signed_f64[%i] : view<4xf64> -> f64
    %unsigned_value = view.load %unsigned_f64[%i] : view<4xf64> -> f64
    %signed_integer = scalar.fptosi %signed_value : f64 to i64
    %unsigned_integer = scalar.fptoui %unsigned_value : f64 to i64
    %signed4_position = index.add %signed_f64_4_base, %i : index
    %unsigned4_position = index.add %unsigned_f64_4_base, %i : index
    view.store %signed_integer, %result[%signed4_position] : i64, view<42xi64>
    view.store %unsigned_integer, %result[%unsigned4_position] : i64, view<42xi64>
    %first_two = index.cmp ult, %i, %c2 : index
    scf.if %first_two {
      %signed2_position = index.add %signed_f64_2_base, %i : index
      %unsigned2_position = index.add %unsigned_f64_2_base, %i : index
      view.store %signed_integer, %result[%signed2_position] : i64, view<42xi64>
      view.store %unsigned_integer, %result[%unsigned2_position] : i64, view<42xi64>
    }
  }

  %signed_bf16_scalar = view.load %signed_bf16[0] : view<4xbf16> -> bf16
  %unsigned_bf16_scalar = view.load %unsigned_bf16[0] : view<4xbf16> -> bf16
  %signed_bf16_scalar_i64 = scalar.fptosi %signed_bf16_scalar : bf16 to i64
  %unsigned_bf16_scalar_i64 = scalar.fptoui %unsigned_bf16_scalar : bf16 to i64
  view.store %signed_bf16_scalar_i64, %result[0] : i64, view<42xi64>
  view.store %unsigned_bf16_scalar_i64, %result[7] : i64, view<42xi64>
  %signed_f32_scalar = view.load %signed_f32[0] : view<4xf32> -> f32
  %unsigned_f32_scalar = view.load %unsigned_f32[0] : view<4xf32> -> f32
  %signed_f32_scalar_i64 = scalar.fptosi %signed_f32_scalar : f32 to i64
  %unsigned_f32_scalar_i64 = scalar.fptoui %unsigned_f32_scalar : f32 to i64
  view.store %signed_f32_scalar_i64, %result[14] : i64, view<42xi64>
  view.store %unsigned_f32_scalar_i64, %result[21] : i64, view<42xi64>
  %signed_f64_scalar = view.load %signed_f64[0] : view<4xf64> -> f64
  %unsigned_f64_scalar = view.load %unsigned_f64[0] : view<4xf64> -> f64
  %signed_f64_scalar_i64 = scalar.fptosi %signed_f64_scalar : f64 to i64
  %unsigned_f64_scalar_i64 = scalar.fptoui %unsigned_f64_scalar : f64 to i64
  view.store %signed_f64_scalar_i64, %result[28] : i64, view<42xi64>
  view.store %unsigned_f64_scalar_i64, %result[35] : i64, view<42xi64>
  func.return
}

check.scenario @wide_floating_integer_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %signed_bf16 = check.generate.iota offset(-9.2233720368547758e+18) step(36028797018963968.0) : tensor<4xbf16>
    %unsigned_bf16 = check.generate.iota offset(1.815851369755784e+19) step(72057594037927936.0) : tensor<4xbf16>
    %signed_f32 = check.generate.iota offset(-9.2233720368547758e+18) step(549755813888.0) : tensor<4xf32>
    %unsigned_f32 = check.generate.iota offset(1.8446739675663041e+19) step(1099511627776.0) : tensor<4xf32>
    %signed_f64 = check.generate.iota offset(-9.2233720368547758e+18) step(1024.0) : tensor<4xf64>
    %unsigned_f64 = check.generate.iota offset(1.8446744073709421e+19) step(2048.0) : tensor<4xf64>
    %storage = check.generate.fill value(-123) : tensor<46xi64>
    %output = check.tensor.view %storage offset(2) : tensor<46xi64> -> tensor<42xi64>
    check.compare<@wide_floating_integer_shapes, @wide_floating_integer_shapes_oracle>(%signed_bf16, %unsigned_bf16, %signed_f32, %unsigned_f32, %signed_f64, %unsigned_f64, %output) : (tensor<4xbf16>, tensor<4xbf16>, tensor<4xf32>, tensor<4xf32>, tensor<4xf64>, tensor<4xf64>, tensor<42xi64>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<46xi64>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %signed_bf16 = check.generate.iota offset(9.0792568487789199e+18) step(36028797018963968.0) : tensor<4xbf16>
    %unsigned_bf16 = check.generate.iota offset(0.25) step(0.5) : tensor<4xbf16>
    %signed_f32 = check.generate.iota offset(9.2233698378315203e+18) step(549755813888.0) : tensor<4xf32>
    %unsigned_f32 = check.generate.iota offset(0.25) step(0.5) : tensor<4xf32>
    %signed_f64 = check.generate.iota offset(9.2233720368547103e+18) step(1024.0) : tensor<4xf64>
    %unsigned_f64 = check.generate.iota offset(0.25) step(0.5) : tensor<4xf64>
    %storage = check.generate.fill value(-123) : tensor<46xi64>
    %output = check.tensor.view %storage offset(2) : tensor<46xi64> -> tensor<42xi64>
    check.compare<@wide_floating_integer_shapes, @wide_floating_integer_shapes_oracle>(%signed_bf16, %unsigned_bf16, %signed_f32, %unsigned_f32, %signed_f64, %unsigned_f64, %output) : (tensor<4xbf16>, tensor<4xbf16>, tensor<4xf32>, tensor<4xf32>, tensor<4xf64>, tensor<4xf64>, tensor<42xi64>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<46xi64>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %signed_bf16 = check.generate.iota offset(-4294967296.0) step(33554432.0) : tensor<4xbf16>
    %unsigned_bf16 = check.generate.iota offset(4261412864.0) step(33554432.0) : tensor<4xbf16>
    %signed_f32 = check.generate.iota offset(-4294967296.0) step(512.0) : tensor<4xf32>
    %unsigned_f32 = check.generate.iota offset(4294966272.0) step(512.0) : tensor<4xf32>
    %signed_f64 = check.generate.iota offset(-4294967296.75) step(0.5) : tensor<4xf64>
    %unsigned_f64 = check.generate.iota offset(4294967295.25) step(0.5) : tensor<4xf64>
    %storage = check.generate.fill value(-123) : tensor<46xi64>
    %output = check.tensor.view %storage offset(2) : tensor<46xi64> -> tensor<42xi64>
    check.compare<@wide_floating_integer_shapes, @wide_floating_integer_shapes_oracle>(%signed_bf16, %unsigned_bf16, %signed_f32, %unsigned_f32, %signed_f64, %unsigned_f64, %output) : (tensor<4xbf16>, tensor<4xbf16>, tensor<4xf32>, tensor<4xf32>, tensor<4xf64>, tensor<4xf64>, tensor<42xi64>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<46xi64>
    }
  }
  check.trial[64](%trial: index, %entropy: check.entropy) {
    %unsigned_bf16_entropy = check.entropy.fork %entropy name("unsigned_bf16") : check.entropy
    %signed_f32_entropy = check.entropy.fork %entropy name("signed_f32") : check.entropy
    %unsigned_f32_entropy = check.entropy.fork %entropy name("unsigned_f32") : check.entropy
    %signed_f64_entropy = check.entropy.fork %entropy name("signed_f64") : check.entropy
    %unsigned_f64_entropy = check.entropy.fork %entropy name("unsigned_f64") : check.entropy
    %signed_bf16_seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %unsigned_bf16_seed = check.entropy.read %unsigned_bf16_entropy[%trial] : check.entropy -> i64
    %signed_f32_seed = check.entropy.read %signed_f32_entropy[%trial] : check.entropy -> i64
    %unsigned_f32_seed = check.entropy.read %unsigned_f32_entropy[%trial] : check.entropy -> i64
    %signed_f64_seed = check.entropy.read %signed_f64_entropy[%trial] : check.entropy -> i64
    %unsigned_f64_seed = check.entropy.read %unsigned_f64_entropy[%trial] : check.entropy -> i64
    %signed_bf16 = check.generate.random.uniform seed(%signed_bf16_seed) range(-9.1513144428168479e+18 to 9.1513144428168479e+18) : tensor<4xbf16>
    %unsigned_bf16 = check.generate.random.uniform seed(%unsigned_bf16_seed) range(0.0 to 1.8302628885633696e+19) : tensor<4xbf16>
    %signed_f32 = check.generate.random.uniform seed(%signed_f32_seed) range(-9.223370937343148e+18 to 9.223370937343148e+18) : tensor<4xf32>
    %unsigned_f32 = check.generate.random.uniform seed(%unsigned_f32_seed) range(0.0 to 1.8446741874686296e+19) : tensor<4xf32>
    %signed_f64 = check.generate.random.uniform seed(%signed_f64_seed) range(-9.2233720368547738e+18 to 9.2233720368547738e+18) : tensor<4xf64>
    %unsigned_f64 = check.generate.random.uniform seed(%unsigned_f64_seed) range(0.0 to 1.8446744073709548e+19) : tensor<4xf64>
    %storage = check.generate.fill value(-123) : tensor<46xi64>
    %output = check.tensor.view %storage offset(2) : tensor<46xi64> -> tensor<42xi64>
    check.compare<@wide_floating_integer_shapes, @wide_floating_integer_shapes_oracle>(%signed_bf16, %unsigned_bf16, %signed_f32, %unsigned_f32, %signed_f64, %unsigned_f64, %output) : (tensor<4xbf16>, tensor<4xbf16>, tensor<4xf32>, tensor<4xf32>, tensor<4xf64>, tensor<4xf64>, tensor<42xi64>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<46xi64>
    }
  }
  check.return
}

// Conversion results cross loop boundaries instead of being consumed directly
// by stores. Scalar loads keep vector-memory support independent of this path.
kernel.def @loop_carried_floating_conversions() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%signed_input: buffer, %unsigned_input: buffer, %count: index, %signed_output: buffer, %unsigned_output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %signed_source = buffer.view %signed_input[%base] : buffer -> view<2xf64>
  %unsigned_source = buffer.view %unsigned_input[%base] : buffer -> view<4xf32>
  %signed_target = buffer.view %signed_output[%base] : buffer -> view<2xf64>
  %unsigned_target = buffer.view %unsigned_output[%base] : buffer -> view<4xf32>
  %first = view.load %signed_source[0] : view<2xf64> -> f64
  %second = view.load %signed_source[1] : view<2xf64> -> f64
  %signed_initial = vector.from_elements %first, %second : vector<2xf64>
  %signed_result = scf.for %iteration = [%begin to %count step %step](%state = %signed_initial : vector<2xf64>) -> (vector<2xf64>) {
    %halves = vector.fptrunc %state : vector<2xf64> to vector<2xf16>
    %integers = vector.fptosi %halves : vector<2xf16> to vector<2xi64>
    %singles = vector.sitofp %integers : vector<2xi64> to vector<2xf32>
    %doubles = vector.extf %singles : vector<2xf32> to vector<2xf64>
    scf.yield %doubles : vector<2xf64>
  }
  %signed_first = vector.extract %signed_result[0] : vector<2xf64> -> f64
  %signed_second = vector.extract %signed_result[1] : vector<2xf64> -> f64
  view.store %signed_first, %signed_target[0] : f64, view<2xf64>
  view.store %signed_second, %signed_target[1] : f64, view<2xf64>

  %first_unsigned = view.load %unsigned_source[0] : view<4xf32> -> f32
  %second_unsigned = view.load %unsigned_source[1] : view<4xf32> -> f32
  %third_unsigned = view.load %unsigned_source[2] : view<4xf32> -> f32
  %fourth_unsigned = view.load %unsigned_source[3] : view<4xf32> -> f32
  %unsigned_initial = vector.from_elements %first_unsigned, %second_unsigned, %third_unsigned, %fourth_unsigned : vector<4xf32>
  %unsigned_result = scf.for %iteration = [%begin to %count step %step](%state = %unsigned_initial : vector<4xf32>) -> (vector<4xf32>) {
    %integers = vector.fptoui %state : vector<4xf32> to vector<4xi16>
    %doubles = vector.uitofp %integers : vector<4xi16> to vector<4xf64>
    %singles = vector.fptrunc %doubles : vector<4xf64> to vector<4xf32>
    scf.yield %singles : vector<4xf32>
  }
  %unsigned_first = vector.extract %unsigned_result[0] : vector<4xf32> -> f32
  %unsigned_second = vector.extract %unsigned_result[1] : vector<4xf32> -> f32
  %unsigned_third = vector.extract %unsigned_result[2] : vector<4xf32> -> f32
  %unsigned_fourth = vector.extract %unsigned_result[3] : vector<4xf32> -> f32
  view.store %unsigned_first, %unsigned_target[0] : f32, view<4xf32>
  view.store %unsigned_second, %unsigned_target[1] : f32, view<4xf32>
  view.store %unsigned_third, %unsigned_target[2] : f32, view<4xf32>
  view.store %unsigned_fourth, %unsigned_target[3] : f32, view<4xf32>
  kernel.return
}

func.def @loop_carried_floating_oracle(%signed_input: buffer, %unsigned_input: buffer, %count: index, %signed_output: buffer, %unsigned_output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %signed_length = index.constant 2 : index
  %unsigned_length = index.constant 4 : index
  %signed_source = buffer.view %signed_input[%base] : buffer -> view<2xf64>
  %unsigned_source = buffer.view %unsigned_input[%base] : buffer -> view<4xf32>
  %signed_target = buffer.view %signed_output[%base] : buffer -> view<2xf64>
  %unsigned_target = buffer.view %unsigned_output[%base] : buffer -> view<4xf32>
  scf.for %lane = [%begin to %signed_length step %step] {
    %initial = view.load %signed_source[%lane] : view<2xf64> -> f64
    %result = scf.for %iteration = [%begin to %count step %step](%state = %initial : f64) -> (f64) {
      %half = scalar.fptrunc %state : f64 to f16
      %integer = scalar.fptosi %half : f16 to i64
      %single = scalar.sitofp %integer : i64 to f32
      %double = scalar.extf %single : f32 to f64
      scf.yield %double : f64
    }
    view.store %result, %signed_target[%lane] : f64, view<2xf64>
  }
  scf.for %lane = [%begin to %unsigned_length step %step] {
    %initial = view.load %unsigned_source[%lane] : view<4xf32> -> f32
    %result = scf.for %iteration = [%begin to %count step %step](%state = %initial : f32) -> (f32) {
      %integer = scalar.fptoui %state : f32 to i16
      %double = scalar.uitofp %integer : i16 to f64
      %single = scalar.fptrunc %double : f64 to f32
      scf.yield %single : f32
    }
    view.store %result, %unsigned_target[%lane] : f32, view<4xf32>
  }
  func.return
}

check.scenario @loop_carried_floating_values {
  check.trial[64](%trial: index, %entropy: check.entropy) {
    %unsigned_entropy = check.entropy.fork %entropy name("unsigned") : check.entropy
    %signed_seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %unsigned_seed = check.entropy.read %unsigned_entropy[%trial] : check.entropy -> i64
    %signed_input = check.generate.random.uniform seed(%signed_seed) range(-32768.0 to 32768.0) : tensor<2xf64>
    %unsigned_input = check.generate.random.uniform seed(%unsigned_seed) range(0.0 to 65535.75) : tensor<4xf32>
    %count = check.literal value(3) : index
    %signed_output = check.generate.fill value(-123.0) : tensor<2xf64>
    %unsigned_output = check.generate.fill value(-123.0) : tensor<4xf32>
    check.compare<@loop_carried_floating_conversions, @loop_carried_floating_oracle>(%signed_input, %unsigned_input, %count, %signed_output, %unsigned_output) : (tensor<2xf64>, tensor<4xf32>, index, tensor<2xf64>, tensor<4xf32>) -> () {
      check.expect.bitwise actual(%signed_output) expected(%signed_output) : tensor<2xf64>
      check.expect.bitwise actual(%unsigned_output) expected(%unsigned_output) : tensor<4xf32>
    }
  }
  check.return
}
