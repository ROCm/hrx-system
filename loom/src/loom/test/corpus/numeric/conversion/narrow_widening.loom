check.scenario @packed_f32_to_f64_values {
  check.trial[4](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-2147483648 to 2147483647) : tensor<64xi32>
    %storage = check.generate.fill value(-123.5) : tensor<258xf64>
    %output = check.tensor.view %storage offset(8) : tensor<258xf64> -> tensor<256xf64>
    %guard = check.generate.fill value(-123.5) : tensor<1xf64>
    %prefix = check.tensor.view %storage offset(0) : tensor<258xf64> -> tensor<1xf64>
    %suffix = check.tensor.view %storage offset(2056) : tensor<258xf64> -> tensor<1xf64>
    check.compare<@widen_f32_packets>(%input, %output) : (tensor<64xi32>, tensor<256xf64>) -> () {
      check.expect.close actual(%output) expected(%output) atol(0.0) rtol(0.0) nan(same) : tensor<256xf64>
      check.expect.bitwise actual(%prefix) expected(%guard) : tensor<1xf64>
      check.expect.bitwise actual(%suffix) expected(%guard) : tensor<1xf64>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(1) step(131071) : tensor<64xi32>
    %storage = check.generate.fill value(-123.5) : tensor<258xf64>
    %output = check.tensor.view %storage offset(8) : tensor<258xf64> -> tensor<256xf64>
    %guard = check.generate.fill value(-123.5) : tensor<1xf64>
    %prefix = check.tensor.view %storage offset(0) : tensor<258xf64> -> tensor<1xf64>
