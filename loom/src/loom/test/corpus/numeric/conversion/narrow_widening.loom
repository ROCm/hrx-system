// Every narrow payload is supplied through memory after compilation. This
// keeps widening dynamic while exercising the exact F32 destination used by
// ordinary ML kernels.
func.def @widen_float8_to_f32(%byte_bits: buffer, %e4_output: buffer, %e5_output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %byte_end = index.constant 256 : index
  %step = index.constant 8 : index
  %aligned_input = buffer.assume.alignment %byte_bits {minimum_alignment = 8} : buffer
  %source, %e4_destination, %e5_destination = buffer.assume.noalias %aligned_input, %e4_output, %e5_output : buffer, buffer, buffer
  %e4_input = buffer.view %source[%base] : buffer -> view<256xf8E4M3>
  %e5_input = buffer.view %source[%base] : buffer -> view<256xf8E5M2>
  %e4_results = buffer.view %e4_destination[%base] : buffer -> view<256xf32>
  %e5_results = buffer.view %e5_destination[%base] : buffer -> view<256xf32>
  scf.for %i = [%begin to %byte_end step %step] {
    %e4 = vector.load %e4_input[%i] : view<256xf8E4M3> -> vector<8xf8E4M3>
    %e5 = vector.load %e5_input[%i] : view<256xf8E5M2> -> vector<8xf8E5M2>
    %wide_e4 = vector.extf %e4 : vector<8xf8E4M3> to vector<8xf32>
    %wide_e5 = vector.extf %e5 : vector<8xf8E5M2> to vector<8xf32>
    vector.store %wide_e4, %e4_results[%i] : vector<8xf32>, view<256xf32>
    vector.store %wide_e5, %e5_results[%i] : vector<8xf32>, view<256xf32>
  }
  func.return
}

// Scalar loads and extensions keep the oracle independent of the packed vector
// paths under test.
func.def @widen_float8_to_f32_oracle(%byte_bits: buffer, %e4_output: buffer, %e5_output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %byte_end = index.constant 256 : index
  %step = index.constant 1 : index
  %e4_input = buffer.view %byte_bits[%base] : buffer -> view<256xf8E4M3>
  %e5_input = buffer.view %byte_bits[%base] : buffer -> view<256xf8E5M2>
  %e4_results = buffer.view %e4_output[%base] : buffer -> view<256xf32>
  %e5_results = buffer.view %e5_output[%base] : buffer -> view<256xf32>
  scf.for %i = [%begin to %byte_end step %step] {
    %e4 = view.load %e4_input[%i] : view<256xf8E4M3> -> f8E4M3
    %e5 = view.load %e5_input[%i] : view<256xf8E5M2> -> f8E5M2
    %wide_e4 = scalar.extf %e4 : f8E4M3 to f32
    %wide_e5 = scalar.extf %e5 : f8E5M2 to f32
    view.store %wide_e4, %e4_results[%i] : f32, view<256xf32>
    view.store %wide_e5, %e5_results[%i] : f32, view<256xf32>
  }
  func.return
}

func.def @widen_bfloat_to_f32(%word_bits: buffer, %bf16_output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %word_end = index.constant 65536 : index
  %step = index.constant 4 : index
  %aligned_input = buffer.assume.alignment %word_bits {minimum_alignment = 8} : buffer
  %source, %destination = buffer.assume.noalias %aligned_input, %bf16_output : buffer, buffer
  %bf16_input = buffer.view %source[%base] : buffer -> view<65536xbf16>
  %bf16_results = buffer.view %destination[%base] : buffer -> view<65536xf32>
  scf.for %i = [%begin to %word_end step %step] {
    %value = vector.load %bf16_input[%i] : view<65536xbf16> -> vector<4xbf16>
    %wide = vector.extf %value : vector<4xbf16> to vector<4xf32>
    vector.store %wide, %bf16_results[%i] : vector<4xf32>, view<65536xf32>
  }
  func.return
}

