// Each output interval exercises a distinct conversion packet width. The VM
// evaluates the same runtime inputs independently of native packet selection.
func.def @widen_f32_packets(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %base2 = index.constant 512 : offset
  %base4 = index.constant 1024 : offset
  %base8 = index.constant 1536 : offset
  %begin = index.constant 0 : index
  %end = index.constant 64 : index
  %step1 = index.constant 1 : index
  %step2 = index.constant 2 : index
  %step4 = index.constant 4 : index
  %step8 = index.constant 8 : index
  %source = buffer.view %input[%base] : buffer -> view<64xf32>
  %destination1 = buffer.view %output[%base] : buffer -> view<64xf64>
  %destination2 = buffer.view %output[%base2] : buffer -> view<64xf64>
  %destination4 = buffer.view %output[%base4] : buffer -> view<64xf64>
  %destination8 = buffer.view %output[%base8] : buffer -> view<64xf64>
  scf.for %i = [%begin to %end step %step1] {
    %value = view.load %source[%i] : view<64xf32> -> f32
    %wide = scalar.extf %value : f32 to f64
    view.store %wide, %destination1[%i] : f64, view<64xf64>
  }
  scf.for %i = [%begin to %end step %step2] {
    %value = vector.load %source[%i] : view<64xf32> -> vector<2xf32>
    %wide = vector.extf %value : vector<2xf32> to vector<2xf64>
    vector.store %wide, %destination2[%i] : vector<2xf64>, view<64xf64>
  }
  scf.for %i = [%begin to %end step %step4] {
    %value = vector.load %source[%i] : view<64xf32> -> vector<4xf32>
    %wide = vector.extf %value : vector<4xf32> to vector<4xf64>
    vector.store %wide, %destination4[%i] : vector<4xf64>, view<64xf64>
  }
  scf.for %i = [%begin to %end step %step8] {
    %value = vector.load %source[%i] : view<64xf32> -> vector<8xf32>
    %wide = vector.extf %value : vector<8xf32> to vector<8xf64>
    vector.store %wide, %destination8[%i] : vector<8xf64>, view<64xf64>
  }
  func.return
}

// Scalar, native-register, and oversized packet widths consume the same
// runtime values. The scalar path is an independent component of the target
// family, while the vector paths exercise native conversion and packetization.
func.def @narrow_f64_packets(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %base2 = index.constant 256 : offset
  %base4 = index.constant 512 : offset
  %base8 = index.constant 768 : offset
  %begin = index.constant 0 : index
  %end = index.constant 64 : index
  %step1 = index.constant 1 : index
  %step2 = index.constant 2 : index
  %step4 = index.constant 4 : index
  %step8 = index.constant 8 : index
  %source = buffer.view %input[%base] : buffer -> view<64xf64>
  %destination1 = buffer.view %output[%base] : buffer -> view<64xf32>
  %destination2 = buffer.view %output[%base2] : buffer -> view<64xf32>
  %destination4 = buffer.view %output[%base4] : buffer -> view<64xf32>
  %destination8 = buffer.view %output[%base8] : buffer -> view<64xf32>
  scf.for %i = [%begin to %end step %step1] {
    %value = view.load %source[%i] : view<64xf64> -> f64
    %narrow = scalar.fptrunc %value : f64 to f32
    view.store %narrow, %destination1[%i] : f32, view<64xf32>
  }
  scf.for %i = [%begin to %end step %step2] {
    %value = vector.load %source[%i] : view<64xf64> -> vector<2xf64>
    %narrow = vector.fptrunc %value : vector<2xf64> to vector<2xf32>
    vector.store %narrow, %destination2[%i] : vector<2xf32>, view<64xf32>
  }
  scf.for %i = [%begin to %end step %step4] {
    %value = vector.load %source[%i] : view<64xf64> -> vector<4xf64>
    %narrow = vector.fptrunc %value : vector<4xf64> to vector<4xf32>
    vector.store %narrow, %destination4[%i] : vector<4xf32>, view<64xf32>
  }
  scf.for %i = [%begin to %end step %step8] {
    %value = vector.load %source[%i] : view<64xf64> -> vector<8xf64>
    %narrow = vector.fptrunc %value : vector<8xf64> to vector<8xf32>
    vector.store %narrow, %destination8[%i] : vector<8xf32>, view<64xf32>
  }
  func.return
}

func.def @widen_float16_to_f32(%word_bits: buffer, %f16_output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %word_end = index.constant 65536 : index
  %step = index.constant 4 : index
  %aligned_input = buffer.assume.alignment %word_bits {minimum_alignment = 8} : buffer
  %source, %destination = buffer.assume.noalias %aligned_input, %f16_output : buffer, buffer
  %f16_input = buffer.view %source[%base] : buffer -> view<65536xf16>
  %f16_results = buffer.view %destination[%base] : buffer -> view<65536xf32>
  scf.for %i = [%begin to %word_end step %step] {
    %value = vector.load %f16_input[%i] : view<65536xf16> -> vector<4xf16>
    %wide = vector.extf %value : vector<4xf16> to vector<4xf32>
    vector.store %wide, %f16_results[%i] : vector<4xf32>, view<65536xf32>
  }
  func.return
}

func.def @widen_float16_to_f32_oracle(%word_bits: buffer, %f16_output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %word_end = index.constant 65536 : index
  %step = index.constant 1 : index
  %f16_input = buffer.view %word_bits[%base] : buffer -> view<65536xf16>
  %f16_results = buffer.view %f16_output[%base] : buffer -> view<65536xf32>
  scf.for %i = [%begin to %word_end step %step] {
    %value = view.load %f16_input[%i] : view<65536xf16> -> f16
    %wide = scalar.extf %value : f16 to f32
    view.store %wide, %f16_results[%i] : f32, view<65536xf32>
  }
  func.return
}

check.scenario @float8_to_f32_all_bits {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %byte_bits = check.generate.iota offset(-128) step(1) : tensor<256xi8>
    %expected_byte_bits = check.generate.iota offset(-128) step(1) : tensor<256xi8>

    %e4_storage = check.generate.fill value(-123.5) : tensor<258xf32>
    %e5_storage = check.generate.fill value(-123.5) : tensor<258xf32>
    %e4_output = check.tensor.view %e4_storage offset(4) : tensor<258xf32> -> tensor<256xf32>
    %e5_output = check.tensor.view %e5_storage offset(4) : tensor<258xf32> -> tensor<256xf32>

    %e4_negative_zero = check.tensor.view %e4_output offset(0) : tensor<256xf32> -> tensor<1xf32>
    %e4_positive_zero = check.tensor.view %e4_output offset(512) : tensor<256xf32> -> tensor<1xf32>
    %e5_negative_zero = check.tensor.view %e5_output offset(0) : tensor<256xf32> -> tensor<1xf32>
    %e5_positive_zero = check.tensor.view %e5_output offset(512) : tensor<256xf32> -> tensor<1xf32>

    %guard = check.generate.fill value(-123.5) : tensor<1xf32>
    %e4_prefix = check.tensor.view %e4_storage offset(0) : tensor<258xf32> -> tensor<1xf32>
    %e4_suffix = check.tensor.view %e4_storage offset(1028) : tensor<258xf32> -> tensor<1xf32>
    %e5_prefix = check.tensor.view %e5_storage offset(0) : tensor<258xf32> -> tensor<1xf32>
    %e5_suffix = check.tensor.view %e5_storage offset(1028) : tensor<258xf32> -> tensor<1xf32>

    check.compare<@widen_float8_to_f32, @widen_float8_to_f32_oracle>(%byte_bits, %e4_output, %e5_output) : (tensor<256xi8>, tensor<256xf32>, tensor<256xf32>) -> () {
      check.expect.close actual(%e4_output) expected(%e4_output) atol(0.0) rtol(0.0) nan(same) : tensor<256xf32>
      check.expect.close actual(%e5_output) expected(%e5_output) atol(0.0) rtol(0.0) nan(same) : tensor<256xf32>
      check.expect.bitwise actual(%e4_negative_zero) expected(%e4_negative_zero) : tensor<1xf32>
      check.expect.bitwise actual(%e4_positive_zero) expected(%e4_positive_zero) : tensor<1xf32>
      check.expect.bitwise actual(%e5_negative_zero) expected(%e5_negative_zero) : tensor<1xf32>
      check.expect.bitwise actual(%e5_positive_zero) expected(%e5_positive_zero) : tensor<1xf32>
      check.expect.bitwise actual(%byte_bits) expected(%expected_byte_bits) : tensor<256xi8>
      check.expect.bitwise actual(%e4_prefix) expected(%guard) : tensor<1xf32>
      check.expect.bitwise actual(%e4_suffix) expected(%guard) : tensor<1xf32>
      check.expect.bitwise actual(%e5_prefix) expected(%guard) : tensor<1xf32>
      check.expect.bitwise actual(%e5_suffix) expected(%guard) : tensor<1xf32>
    }
  }
  check.return
}

