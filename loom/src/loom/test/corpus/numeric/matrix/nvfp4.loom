amdgpu.target<gfx11-generic> @nvfp4_wave32_target

amdgpu.target<gfx9-4-generic> @nvfp4_wave64_target

template.decl @numeric.nvfp4.workgroup_size() -> (index)

template.def<@numeric.nvfp4.workgroup_size> target(@nvfp4_wave32_target) priority(20) @nvfp4_wave32_workgroup_size() -> (index) {
  %size = index.constant 32 : index
  template.return %size : index
}

template.def<@numeric.nvfp4.workgroup_size> target(@nvfp4_wave64_target) priority(20) @nvfp4_wave64_workgroup_size() -> (index) {
  %size = index.constant 64 : index
  template.return %size : index
}

template.def<@numeric.nvfp4.workgroup_size> priority(1) @nvfp4_portable_workgroup_size() -> (index) {
  %size = index.constant 32 : index
  template.return %size : index
}

template.decl device @numeric.nvfp4.matrix_tile(%lhs_payload: vector<2xi32>, %lhs_scale: vector<1xi32>, %rhs_payload: vector<2xi32>, %rhs_scale: vector<1xi32>, %init: buffer, %init_byte_offset: offset, %output: buffer, %output_byte_offset: offset)

template.def<@numeric.nvfp4.matrix_tile> device target(@nvfp4_wave32_target) requires [#target.subgroup.size<32>] priority(20) @nvfp4_matrix_tile_wave32(%lhs_payload: vector<2xi32>, %lhs_scale: vector<1xi32>, %rhs_payload: vector<2xi32>, %rhs_scale: vector<1xi32>, %init_buffer: buffer, %init_byte_offset: offset, %output_buffer: buffer, %output_byte_offset: offset) {
  %schema = encoding.define #encoding.f4e2m1<affine=scale_only, payload_elements=16, payload_packing=little_endian_nibbles, payload_registers=2, scale_format=f8e4m3fn, scale_group_elements=16, scale_operands=1, scale_topology=block_1d, zero_scale_fallback=true> : encoding<schema>
  %lhs_data = vector.decode %lhs_payload using %schema {scale = %lhs_scale : vector<1xi32>} : vector<2xi32>, encoding<schema> -> vector<16xf16>
  %rhs_data = vector.decode %rhs_payload using %schema {scale = %rhs_scale : vector<1xi32>} : vector<2xi32>, encoding<schema> -> vector<16xf16>
  %extent = index.constant 16 : index
  %origin = index.constant 0 : index
  %lhs = vector.fragment<lhs> %lhs_data shape [%extent, %extent] : vector<16xf16>
  %rhs = vector.fragment<rhs> %rhs_data shape [%extent, %extent] : vector<16xf16>
  %init_view = buffer.view %init_buffer[%init_byte_offset] : buffer -> view<16x16xf32>
  %init = vector.fragment.load<init> %init_view[%origin, %origin] shape [%extent, %extent] : view<16x16xf32> -> vector<8xf32>
  %result = vector.mma %lhs, %rhs, %init : vector<16xf16>, vector<16xf16>, vector<8xf32>
  %output_view = buffer.view %output_buffer[%output_byte_offset] : buffer -> view<16x16xf32>
  vector.fragment.store<result> %result, %output_view[%origin, %origin] shape [%extent, %extent] : vector<8xf32>, view<16x16xf32>
  template.return
}

template.def<@numeric.nvfp4.matrix_tile> device target(@nvfp4_wave64_target) requires [#target.subgroup.size<64>] priority(20) @nvfp4_matrix_tile_wave64(%lhs_payload: vector<2xi32>, %lhs_scale: vector<1xi32>, %rhs_payload: vector<2xi32>, %rhs_scale: vector<1xi32>, %init_buffer: buffer, %init_byte_offset: offset, %output_buffer: buffer, %output_byte_offset: offset) {
  %schema = encoding.define #encoding.f4e2m1<affine=scale_only, payload_elements=8, payload_packing=little_endian_nibbles, payload_registers=1, scale_format=f8e4m3fn, scale_group_elements=8, scale_operands=1, scale_topology=block_1d, zero_scale_fallback=true> : encoding<schema>
  %extent = index.constant 16 : index
  %origin = index.constant 0 : index
  %lane_index = kernel.subgroup.lane.id : index
  %lane = index.cast %lane_index : index to i32
  %word_shift = scalar.constant 5 : i32
  %quarter_shift_mask = scalar.constant 16 : i32
  %payload_word_i32 = scalar.shrui %lane, %word_shift : i32
  %payload_word = index.cast %payload_word_i32 : i32 to index
  %payload_shift = scalar.andi %lane, %quarter_shift_mask : i32
  %lhs_word = vector.extract %lhs_payload[%payload_word] : vector<2xi32> -> i32
  %lhs_shifted = scalar.shrui %lhs_word, %payload_shift : i32
  %lhs_selected = vector.splat %lhs_shifted : vector<1xi32>
  %rhs_word = vector.extract %rhs_payload[%payload_word] : vector<2xi32> -> i32
  %rhs_shifted = scalar.shrui %rhs_word, %payload_shift : i32
  %rhs_selected = vector.splat %rhs_shifted : vector<1xi32>
  %lhs_decoded = vector.decode %lhs_selected using %schema {scale = %lhs_scale : vector<1xi32>} : vector<1xi32>, encoding<schema> -> vector<8xf16>
  %rhs_decoded = vector.decode %rhs_selected using %schema {scale = %rhs_scale : vector<1xi32>} : vector<1xi32>, encoding<schema> -> vector<8xf16>
  %lhs_data = vector.slice %lhs_decoded[%origin] : vector<8xf16> -> vector<4xf16>
  %rhs_data = vector.slice %rhs_decoded[%origin] : vector<8xf16> -> vector<4xf16>
  %lhs = vector.fragment<lhs> %lhs_data shape [%extent, %extent] : vector<4xf16>
  %rhs = vector.fragment<rhs> %rhs_data shape [%extent, %extent] : vector<4xf16>
  %init_view = buffer.view %init_buffer[%init_byte_offset] : buffer -> view<16x16xf32>
  %init = vector.fragment.load<init> %init_view[%origin, %origin] shape [%extent, %extent] : view<16x16xf32> -> vector<4xf32>
  %result = vector.mma %lhs, %rhs, %init : vector<4xf16>, vector<4xf16>, vector<4xf32>
  %output_view = buffer.view %output_buffer[%output_byte_offset] : buffer -> view<16x16xf32>
  vector.fragment.store<result> %result, %output_view[%origin, %origin] shape [%extent, %extent] : vector<4xf32>, view<16x16xf32>
  template.return
}

template.def<@numeric.nvfp4.matrix_tile> device priority(1) @nvfp4_matrix_tile_portable(%lhs_payload: vector<2xi32>, %lhs_scale: vector<1xi32>, %rhs_payload: vector<2xi32>, %rhs_scale: vector<1xi32>, %init_buffer: buffer, %init_byte_offset: offset, %output_buffer: buffer, %output_byte_offset: offset) {
  %workitem = kernel.workitem.id<x> : index
  %origin = index.constant 0 : index
  %is_leader = index.cmp eq, %workitem, %origin : index
  scf.if %is_leader {
    %lhs_word0 = vector.extract %lhs_payload[0] : vector<2xi32> -> i32
    %lhs_word1 = vector.extract %lhs_payload[1] : vector<2xi32> -> i32
    %lhs_scale_word = vector.extract %lhs_scale[0] : vector<1xi32> -> i32
    %rhs_word0 = vector.extract %rhs_payload[0] : vector<2xi32> -> i32
    %rhs_word1 = vector.extract %rhs_payload[1] : vector<2xi32> -> i32
    %rhs_scale_word = vector.extract %rhs_scale[0] : vector<1xi32> -> i32
    %lhs_scale_value = func.call @decode_positive_e4m3fn_scale_arithmetic(%lhs_scale_word) : (i32) -> (f32)
    %rhs_scale_value = func.call @decode_positive_e4m3fn_scale_arithmetic(%rhs_scale_word) : (i32) -> (f32)
    %element_count = index.constant 16 : index
    %step = index.constant 1 : index
    %sum_initial = scalar.constant 0.0 : f32
    %dot = scf.for %position = [%origin to %element_count step %step](%sum = %sum_initial : f32) -> (f32) {
      %lhs = func.call @decode_nvfp4_payload_element_arithmetic(%lhs_word0, %lhs_word1, %position, %lhs_scale_value) : (i32, i32, index, f32) -> (f32)
      %rhs = func.call @decode_nvfp4_payload_element_arithmetic(%rhs_word0, %rhs_word1, %position, %rhs_scale_value) : (i32, i32, index, f32) -> (f32)
      %product = scalar.mulf %lhs, %rhs : f32
      %next = scalar.addf %sum, %product : f32
      scf.yield %next : f32
    }
    %init_view = buffer.view %init_buffer[%init_byte_offset] : buffer -> view<256xf32>
    %output_view = buffer.view %output_buffer[%output_byte_offset] : buffer -> view<256xf32>
    %cell_count = index.constant 256 : index
    scf.for %cell = [%origin to %cell_count step %step] {
      %initial = view.load %init_view[%cell] : view<256xf32> -> f32
      %result = scalar.addf %initial, %dot : f32
      view.store %result, %output_view[%cell] : f32, view<256xf32>
    }
  }
  template.return
}

kernel.def @nvfp4_matrix() {
  %unit = index.constant 1 : index
  %workgroup_size = template.apply<@numeric.nvfp4.workgroup_size>() pure : () -> (index)
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%lhs_payload_buffer: buffer, %lhs_scale_buffer: buffer, %rhs_payload_buffer: buffer, %rhs_scale_buffer: buffer, %init_buffer: buffer, %output_buffer: buffer) {
  %base = index.constant 0 : offset
  %output_byte_offset = index.constant 16 : offset
  %origin = index.constant 0 : index
  %lhs_payload_view = buffer.view %lhs_payload_buffer[%base] : buffer -> view<2xi32>
  %lhs_scale_view = buffer.view %lhs_scale_buffer[%base] : buffer -> view<1xi32>
  %rhs_payload_view = buffer.view %rhs_payload_buffer[%base] : buffer -> view<2xi32>
  %rhs_scale_view = buffer.view %rhs_scale_buffer[%base] : buffer -> view<1xi32>
  %lhs_payload = vector.load %lhs_payload_view[%origin] : view<2xi32> -> vector<2xi32>
  %lhs_scale = vector.load %lhs_scale_view[%origin] : view<1xi32> -> vector<1xi32>
  %rhs_payload = vector.load %rhs_payload_view[%origin] : view<2xi32> -> vector<2xi32>
  %rhs_scale = vector.load %rhs_scale_view[%origin] : view<1xi32> -> vector<1xi32>
  template.apply<@numeric.nvfp4.matrix_tile>(%lhs_payload, %lhs_scale, %rhs_payload, %rhs_scale, %init_buffer, %base, %output_buffer, %output_byte_offset) : (vector<2xi32>, vector<1xi32>, vector<2xi32>, vector<1xi32>, buffer, offset, buffer, offset)
  kernel.return
}

// The portable target implementation uses arithmetic reconstruction while the
// oracle below constructs the exact IEEE payload bits.
func.def inline @decode_positive_e4m3fn_scale_arithmetic(%scale_word: i32) -> (f32) {
  %c3 = scalar.constant 3 : i32
  %c5 = scalar.constant 5 : i32
  %c6 = scalar.constant 6 : i32
  %c7 = scalar.constant 7 : i32
  %mantissa = scalar.andi %scale_word, %c7 : i32
  %shifted_exponent = scalar.shrui %scale_word, %c3 : i32
  %exponent = scalar.andi %shifted_exponent, %c7 : i32
  %mantissa_float = scalar.uitofp %mantissa : i32 to f32
  %one_eighth = scalar.constant 0.125 : f32
  %unit_scale = scalar.constant 1.0 : f32
  %fraction = scalar.mulf %mantissa_float, %one_eighth : f32
  %significand = scalar.addf %unit_scale, %fraction : f32
  %is_quarter = scalar.cmpi eq, %exponent, %c5 : i32
  %is_half = scalar.cmpi eq, %exponent, %c6 : i32
  %quarter = scalar.constant 0.25 : f32
  %half = scalar.constant 0.5 : f32
  %exponent_scale = scf.if %is_quarter -> (f32) {
    scf.yield %quarter : f32
  } else {
    %remaining_scale = scf.if %is_half -> (f32) {
      scf.yield %half : f32
    } else {
      scf.yield %unit_scale : f32
    }
    scf.yield %remaining_scale : f32
  }
  %scale = scalar.mulf %significand, %exponent_scale : f32
  func.return %scale : f32
}

func.def inline @decode_scaled_e2m1_arithmetic(%nibble: i32, %scale: f32) -> (f32) {
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %c7 = scalar.constant 7 : i32
  %c8 = scalar.constant 8 : i32
  %magnitude = scalar.andi %nibble, %c7 : i32
  %sign = scalar.andi %nibble, %c8 : i32
  %is_zero = scalar.cmpi eq, %magnitude, %c0 : i32
  %is_subnormal = scalar.cmpi eq, %magnitude, %c1 : i32
  %additive_identity = scalar.constant 0.0 : f32
  %half = scalar.constant 0.5 : f32
  %unit_value = scalar.constant 1.0 : f32
  %doubled_value = scalar.constant 2.0 : f32
  %quadrupled_value = scalar.constant 4.0 : f32
  %positive = scf.if %is_zero -> (f32) {
    scf.yield %additive_identity : f32
  } else {
    %nonzero = scf.if %is_subnormal -> (f32) {
      scf.yield %half : f32
    } else {
      %group = scalar.shrui %magnitude, %c1 : i32
      %mantissa = scalar.andi %magnitude, %c1 : i32
      %mantissa_float = scalar.uitofp %mantissa : i32 to f32
      %fraction = scalar.mulf %mantissa_float, %half : f32
      %significand = scalar.addf %unit_value, %fraction : f32
      %is_unscaled = scalar.cmpi eq, %group, %c1 : i32
      %is_doubled = scalar.cmpi eq, %group, %c2 : i32
      %exponent_scale = scf.if %is_unscaled -> (f32) {
        scf.yield %unit_value : f32
      } else {
        %remaining_scale = scf.if %is_doubled -> (f32) {
          scf.yield %doubled_value : f32
        } else {
          scf.yield %quadrupled_value : f32
        }
        scf.yield %remaining_scale : f32
      }
      %normal = scalar.mulf %significand, %exponent_scale : f32
      scf.yield %normal : f32
    }
    scf.yield %nonzero : f32
  }
  %is_negative = scalar.cmpi ne, %sign, %c0 : i32
  %signed = scf.if %is_negative -> (f32) {
    %negative = scalar.negf %positive : f32
    scf.yield %negative : f32
  } else {
    scf.yield %positive : f32
  }
  %result = scalar.mulf %signed, %scale : f32
  func.return %result : f32
}

func.def inline @decode_nvfp4_payload_element_arithmetic(%word0: i32, %word1: i32, %position: index, %scale: f32) -> (f32) {
  %elements_per_word = index.constant 8 : index
  %nibble_bit_count = index.constant 4 : index
  %nibble_mask = scalar.constant 15 : i32
  %in_first_word = index.cmp ult, %position, %elements_per_word : index
  %word = scf.if %in_first_word -> (i32) {
    scf.yield %word0 : i32
  } else {
    scf.yield %word1 : i32
  }
  %nibble_position = index.rem %position, %elements_per_word : index
  %bit_position_index = index.mul %nibble_position, %nibble_bit_count : index
  %bit_position = index.cast %bit_position_index : index to i32
  %shifted = scalar.shrui %word, %bit_position : i32
  %nibble = scalar.andi %shifted, %nibble_mask : i32
  %value = func.call @decode_scaled_e2m1_arithmetic(%nibble, %scale) : (i32, f32) -> (f32)
  func.return %value : f32
}

// Decodes one positive, normal E4M3FN scale byte. The scenario constrains
// scale generation to 0x28 through 0x3f so this path is exact and branchless.
func.def inline @decode_positive_e4m3fn_scale(%scale_word: i32) -> (f32) {
  %mantissa_mask = scalar.constant 7 : i32
  %exponent_shift = scalar.constant 3 : i32
  %exponent_mask = scalar.constant 15 : i32
  %f32_exponent_bias = scalar.constant 120 : i32
  %f32_exponent_shift = scalar.constant 23 : i32
  %f32_mantissa_shift = scalar.constant 20 : i32
  %mantissa = scalar.andi %scale_word, %mantissa_mask : i32
  %shifted_exponent = scalar.shrui %scale_word, %exponent_shift : i32
  %exponent = scalar.andi %shifted_exponent, %exponent_mask : i32
  %f32_exponent = scalar.addi %exponent, %f32_exponent_bias : i32
  %exponent_bits = scalar.shli %f32_exponent, %f32_exponent_shift : i32
  %mantissa_bits = scalar.shli %mantissa, %f32_mantissa_shift : i32
  %bits = scalar.ori %exponent_bits, %mantissa_bits : i32
  %scale = scalar.bitcast %bits : i32 to f32
  func.return %scale : f32
}

// Decodes one signed E2M1 nibble, applies the block scale, and rounds through
// f16 exactly where vector.decode produces the matrix instruction operand.
func.def inline @decode_scaled_e2m1(%nibble: i32, %scale: f32) -> (f32) {
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %c3 = scalar.constant 3 : i32
  %c7 = scalar.constant 7 : i32
  %c8 = scalar.constant 8 : i32
  %c22 = scalar.constant 22 : i32
  %c23 = scalar.constant 23 : i32
  %c28 = scalar.constant 28 : i32
  %f32_exponent_bias = scalar.constant 126 : i32
  %half_bits = scalar.constant 1056964608 : i32
  %magnitude = scalar.andi %nibble, %c7 : i32
  %sign = scalar.andi %nibble, %c8 : i32
  %is_zero = scalar.cmpi eq, %magnitude, %c0 : i32
  %is_half = scalar.cmpi eq, %magnitude, %c1 : i32
  %magnitude_bits = scf.if %is_zero -> (i32) {
    scf.yield %c0 : i32
  } else {
    %nonzero_bits = scf.if %is_half -> (i32) {
      scf.yield %half_bits : i32
    } else {
      %exponent = scalar.shrui %magnitude, %c1 : i32
      %f32_exponent = scalar.addi %exponent, %f32_exponent_bias : i32
      %exponent_bits = scalar.shli %f32_exponent, %c23 : i32
      %mantissa = scalar.andi %magnitude, %c1 : i32
      %mantissa_bits = scalar.shli %mantissa, %c22 : i32
      %normal_bits = scalar.ori %exponent_bits, %mantissa_bits : i32
      scf.yield %normal_bits : i32
    }
    scf.yield %nonzero_bits : i32
  }
  %sign_bits = scalar.shli %sign, %c28 : i32
  %signed_bits = scalar.ori %magnitude_bits, %sign_bits : i32
  %unscaled = scalar.bitcast %signed_bits : i32 to f32
  %scaled = scalar.mulf %unscaled, %scale : f32
  %rounded = scalar.fptrunc %scaled : f32 to f16
  %result = scalar.extf %rounded : f16 to f32
  func.return %result : f32
}

func.def inline @decode_nvfp4_payload_element(%payload: view<2xi32>, %position: index, %scale: f32) -> (f32) {
  %elements_per_word = index.constant 8 : index
  %nibble_bit_count = index.constant 4 : index
  %nibble_mask = scalar.constant 15 : i32
  %word_position = index.div %position, %elements_per_word : index
  %nibble_position = index.rem %position, %elements_per_word : index
  %bit_position_index = index.mul %nibble_position, %nibble_bit_count : index
  %bit_position = index.cast %bit_position_index : index to i32
  %word = view.load %payload[%word_position] : view<2xi32> -> i32
  %shifted = scalar.shrui %word, %bit_position : i32
  %nibble = scalar.andi %shifted, %nibble_mask : i32
  %value = func.call @decode_scaled_e2m1(%nibble, %scale) : (i32, f32) -> (f32)
  func.return %value : f32
}

func.def @nvfp4_matrix_oracle(%lhs_payload_buffer: buffer, %lhs_scale_buffer: buffer, %rhs_payload_buffer: buffer, %rhs_scale_buffer: buffer, %init_buffer: buffer, %output_buffer: buffer) {
  %base = index.constant 0 : offset
  %output_byte_offset = index.constant 16 : offset
  %origin = index.constant 0 : index
  %step = index.constant 1 : index
  %element_count = index.constant 16 : index
  %cell_count = index.constant 256 : index
  %lhs_payload = buffer.view %lhs_payload_buffer[%base] : buffer -> view<2xi32>
  %lhs_scale_view = buffer.view %lhs_scale_buffer[%base] : buffer -> view<1xi32>
  %rhs_payload = buffer.view %rhs_payload_buffer[%base] : buffer -> view<2xi32>
  %rhs_scale_view = buffer.view %rhs_scale_buffer[%base] : buffer -> view<1xi32>
  %init = buffer.view %init_buffer[%base] : buffer -> view<256xf32>
  %output = buffer.view %output_buffer[%output_byte_offset] : buffer -> view<256xf32>
  %lhs_scale_word = view.load %lhs_scale_view[%origin] : view<1xi32> -> i32
  %rhs_scale_word = view.load %rhs_scale_view[%origin] : view<1xi32> -> i32
  %lhs_scale = func.call @decode_positive_e4m3fn_scale(%lhs_scale_word) : (i32) -> (f32)
  %rhs_scale = func.call @decode_positive_e4m3fn_scale(%rhs_scale_word) : (i32) -> (f32)
  %dot_initial = scalar.constant 0.0 : f32
  %dot = scf.for %position = [%origin to %element_count step %step](%sum = %dot_initial : f32) -> (f32) {
    %lhs = func.call @decode_nvfp4_payload_element(%lhs_payload, %position, %lhs_scale) : (view<2xi32>, index, f32) -> (f32)
    %rhs = func.call @decode_nvfp4_payload_element(%rhs_payload, %position, %rhs_scale) : (view<2xi32>, index, f32) -> (f32)
    %next = scalar.fmaf %lhs, %rhs, %sum : f32
    scf.yield %next : f32
  }
  scf.for %cell = [%origin to %cell_count step %step] {
    %initial = view.load %init[%cell] : view<256xf32> -> f32
    %result = scalar.addf %initial, %dot : f32
    view.store %result, %output[%cell] : f32, view<256xf32>
  }
  func.return
}

check.scenario @nvfp4_matrix_values {
  check.trial[8](%trial: index, %entropy: check.entropy) {
    %lhs_payload_entropy = check.entropy.fork %entropy name("lhs_payload") : check.entropy
    %lhs_scale_entropy = check.entropy.fork %entropy name("lhs_scale") : check.entropy
    %rhs_payload_entropy = check.entropy.fork %entropy name("rhs_payload") : check.entropy
    %rhs_scale_entropy = check.entropy.fork %entropy name("rhs_scale") : check.entropy
    %init_entropy = check.entropy.fork %entropy name("init") : check.entropy
    %lhs_payload_seed = check.entropy.read %lhs_payload_entropy[%trial] : check.entropy -> i64
    %lhs_scale_seed = check.entropy.read %lhs_scale_entropy[%trial] : check.entropy -> i64
    %rhs_payload_seed = check.entropy.read %rhs_payload_entropy[%trial] : check.entropy -> i64
    %rhs_scale_seed = check.entropy.read %rhs_scale_entropy[%trial] : check.entropy -> i64
    %init_seed = check.entropy.read %init_entropy[%trial] : check.entropy -> i64
    %lhs_payload = check.generate.random.uniform seed(%lhs_payload_seed) range(-2147483648 to 2147483647) : tensor<2xi32>
    %lhs_scale = check.generate.random.uniform seed(%lhs_scale_seed) range(40 to 63) : tensor<1xi32>
    %rhs_payload = check.generate.random.uniform seed(%rhs_payload_seed) range(-2147483648 to 2147483647) : tensor<2xi32>
    %rhs_scale = check.generate.random.uniform seed(%rhs_scale_seed) range(40 to 63) : tensor<1xi32>
    %init = check.generate.random.uniform seed(%init_seed) range(-2.0 to 2.0) : tensor<256xf32>
    %output = check.generate.fill value(-8192.0) : tensor<264xf32>
    check.compare<@nvfp4_matrix, @nvfp4_matrix_oracle>(%lhs_payload, %lhs_scale, %rhs_payload, %rhs_scale, %init, %output) : (tensor<2xi32>, tensor<1xi32>, tensor<2xi32>, tensor<1xi32>, tensor<256xf32>, tensor<264xf32>) -> () {
      check.expect.bitwise actual(%lhs_payload) expected(%lhs_payload) : tensor<2xi32>
      check.expect.bitwise actual(%lhs_scale) expected(%lhs_scale) : tensor<1xi32>
      check.expect.bitwise actual(%rhs_payload) expected(%rhs_payload) : tensor<2xi32>
      check.expect.bitwise actual(%rhs_scale) expected(%rhs_scale) : tensor<1xi32>
      check.expect.bitwise actual(%init) expected(%init) : tensor<256xf32>
      check.expect.close actual(%output) expected(%output) atol(1.9999999999999999e-06) rtol(2.0000000000000002e-05) nan(same) : tensor<264xf32>
    }
  }
  check.return
}
