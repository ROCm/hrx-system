// Turn-domain trigonometry has a frozen f32 mapping shared with source
// folding. Radian operations are approximate and use an explicit tolerance.

func.def @turn_observations(%bits: i32, %output: buffer) {
  %value = scalar.bitcast %bits : i32 to f32
  %sin = scalar.sinturnsf %value : f32
  %cos = scalar.costurnsf %value : f32
  %sin_bits = scalar.bitcast %sin : f32 to i32
  %cos_bits = scalar.bitcast %cos : f32 to i32
  %results = vector.from_elements %sin_bits, %cos_bits : vector<2xi32>
  %origin = index.constant 0 : offset
  %result_view = buffer.view %output[%origin] : buffer -> view<2xi32>
  vector.store %results, %result_view[0] : vector<2xi32>, view<2xi32>
  func.return
}

func.def @turn_entropy_observations(%entropy_bits: i64, %output: buffer) {
  %bits = scalar.trunci %entropy_bits : i64 to i32
  func.call @turn_observations(%bits, %output) : (i32, buffer)
  func.return
}

func.def inline @turn_approximate_observations(%bits: i32, %output: buffer) {
  %value = scalar.bitcast %bits : i32 to f32
  %sin = scalar.sinturnsf<afn> %value : f32
  %cos = scalar.costurnsf<afn> %value : f32
  %results = vector.from_elements %sin, %cos : vector<2xf32>
  %origin = index.constant 0 : offset
  %result_view = buffer.view %output[%origin] : buffer -> view<2xf32>
  vector.store %results, %result_view[0] : vector<2xf32>, view<2xf32>
  func.return
}

func.def inline @turn_approximate_entropy_observations(%entropy_bits: i64, %output: buffer) {
  %bits = scalar.trunci %entropy_bits : i64 to i32
  func.call @turn_approximate_observations(%bits, %output) : (i32, buffer)
  func.return
}

func.def inline @turn_boundary_bits(%ordinal: index) -> (i32) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c6 = index.constant 6 : index
  %c7 = index.constant 7 : index
  %c8 = index.constant 8 : index
  %c9 = index.constant 9 : index
  %is0 = index.cmp eq, %ordinal, %c0 : index
  %is1 = index.cmp eq, %ordinal, %c1 : index
  %is2 = index.cmp eq, %ordinal, %c2 : index
  %is3 = index.cmp eq, %ordinal, %c3 : index
  %is4 = index.cmp eq, %ordinal, %c4 : index
  %is5 = index.cmp eq, %ordinal, %c5 : index
  %is6 = index.cmp eq, %ordinal, %c6 : index
  %is7 = index.cmp eq, %ordinal, %c7 : index
  %is8 = index.cmp eq, %ordinal, %c8 : index
  %is9 = index.cmp eq, %ordinal, %c9 : index
  %value0 = scalar.constant 0 : i32
  %value1 = scalar.constant 1065353216 : i32
  %value2 = scalar.constant 1258291200 : i32
  %value3 = scalar.constant 1048576000 : i32
  %value4 = scalar.constant -2147483648 : i32
  %value5 = scalar.constant 1 : i32
  %value6 = scalar.constant 2139095040 : i32
  %value7 = scalar.constant -8388608 : i32
  %value8 = scalar.constant 2143289344 : i32
  %value9 = scalar.constant 1180433910 : i32
  %value10 = scalar.constant -976397844 : i32
  %bits0 = scf.select %is0, %value0, %value10 : i32
  %bits1 = scf.select %is1, %value1, %bits0 : i32
  %bits2 = scf.select %is2, %value2, %bits1 : i32
  %bits3 = scf.select %is3, %value3, %bits2 : i32
  %bits4 = scf.select %is4, %value4, %bits3 : i32
  %bits5 = scf.select %is5, %value5, %bits4 : i32
  %bits6 = scf.select %is6, %value6, %bits5 : i32
  %bits7 = scf.select %is7, %value7, %bits6 : i32
  %bits8 = scf.select %is8, %value8, %bits7 : i32
  %bits9 = scf.select %is9, %value9, %bits8 : i32
  func.return %bits9 : i32
}

func.def @turn_boundary_observations(%ordinal: index, %output: buffer) {
  %bits = func.call @turn_boundary_bits(%ordinal) : (index) -> (i32)
  func.call @turn_observations(%bits, %output) : (i32, buffer)
  func.return
}

func.def inline @turn_approximate_boundary_observations(%ordinal: index, %output: buffer) {
  %bits = func.call @turn_boundary_bits(%ordinal) : (index) -> (i32)
  func.call @turn_approximate_observations(%bits, %output) : (i32, buffer)
  func.return
}

func.def @radian_observations(%even_entropy: i64, %odd_entropy: i64, %angle_entropy: i64, %output: buffer) {
  %even_bits = scalar.trunci %even_entropy : i64 to i32
  %odd_bits = scalar.trunci %odd_entropy : i64 to i32
  %angle_bits = scalar.trunci %angle_entropy : i64 to i32
  %even = scalar.bitcast %even_bits : i32 to f32
  %odd = scalar.bitcast %odd_bits : i32 to f32
  %angle = scalar.bitcast %angle_bits : i32 to f32
  %sin = scalar.sinf<afn> %angle : f32
  %cos = scalar.cosf<afn> %angle : f32
  %even_cos = scalar.mulf %even, %cos : f32
  %odd_sin = scalar.mulf %odd, %sin : f32
  %rotated_even = scalar.subf %even_cos, %odd_sin : f32
  %even_sin = scalar.mulf %even, %sin : f32
  %odd_cos = scalar.mulf %odd, %cos : f32
  %rotated_odd = scalar.addf %even_sin, %odd_cos : f32
  %results = vector.from_elements %sin, %cos, %rotated_even, %rotated_odd : vector<4xf32>
  %origin = index.constant 0 : offset
  %result_view = buffer.view %output[%origin] : buffer -> view<4xf32>
  vector.store %results, %result_view[0] : vector<4xf32>, view<4xf32>
  func.return
}

func.def @radian_zero_observations(%bits: i32, %output: buffer) {
  %value = scalar.bitcast %bits : i32 to f32
  %sin = scalar.sinf<afn> %value : f32
  %cos = scalar.cosf<afn> %value : f32
  %sin_bits = scalar.bitcast %sin : f32 to i32
  %cos_bits = scalar.bitcast %cos : f32 to i32
  %results = vector.from_elements %sin_bits, %cos_bits : vector<2xi32>
  %origin = index.constant 0 : offset
  %result_view = buffer.view %output[%origin] : buffer -> view<2xi32>
  vector.store %results, %result_view[0] : vector<2xi32>, view<2xi32>
  func.return
}

check.scenario @turn_approximate_values {
  check.trial[11](%trial: index, %entropy: check.entropy) {
    %output = check.generate.fill value(-1.0) : tensor<2xf32>
    check.compare<@turn_approximate_boundary_observations>(%trial, %output) : (index, tensor<2xf32>) -> () {
      check.expect.close actual(%output) expected(%output) atol(1.9999999999999999e-07) rtol(3.9999999999999998e-07) nan(same) : tensor<2xf32>
    }
  }
  check.trial[256](%trial: index, %entropy: check.entropy) {
    %bits = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %output = check.generate.fill value(-1.0) : tensor<2xf32>
    check.compare<@turn_approximate_entropy_observations>(%bits, %output) : (i64, tensor<2xf32>) -> () {
      check.expect.close actual(%output) expected(%output) atol(1.9999999999999999e-07) rtol(3.9999999999999998e-07) nan(same) : tensor<2xf32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %positive_zero = check.literal value(0) : i32
    %output = check.generate.fill value(-1.0) : tensor<2xf32>
    check.compare<@turn_approximate_observations>(%positive_zero, %output) : (i32, tensor<2xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<2xf32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %negative_zero = check.literal value(-2147483648) : i32
    %output = check.generate.fill value(-1.0) : tensor<2xf32>
    check.compare<@turn_approximate_observations>(%negative_zero, %output) : (i32, tensor<2xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<2xf32>
    }
  }
  check.return
}

check.scenario @turn_values {
  check.trial[11](%trial: index, %entropy: check.entropy) {
    %output = check.generate.fill value(-1) : tensor<2xi32>
    check.compare<@turn_boundary_observations>(%trial, %output) : (index, tensor<2xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<2xi32>
    }
  }
  check.trial[256](%trial: index, %entropy: check.entropy) {
    %bits = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %output = check.generate.fill value(-1) : tensor<2xi32>
    check.compare<@turn_entropy_observations>(%bits, %output) : (i64, tensor<2xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<2xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %positive_zero = check.literal value(0) : i32
    %positive_output = check.generate.fill value(-1) : tensor<2xi32>
    check.compare<@radian_zero_observations>(%positive_zero, %positive_output) : (i32, tensor<2xi32>) -> () {
      check.expect.bitwise actual(%positive_output) expected(%positive_output) : tensor<2xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %negative_zero = check.literal value(-2147483648) : i32
    %output = check.generate.fill value(-1) : tensor<2xi32>
    check.compare<@radian_zero_observations>(%negative_zero, %output) : (i32, tensor<2xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<2xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %even = check.literal value(1073741824) : i64
    %odd = check.literal value(1077936128) : i64
    %angle = check.literal value(1065353216) : i64
    %output = check.generate.fill value(0.0) : tensor<4xf32>
    check.compare<@radian_observations>(%even, %odd, %angle, %output) : (i64, i64, i64, tensor<4xf32>) -> () {
      check.expect.close actual(%output) expected(%output) atol(9.9999999999999995e-07) rtol(1.0000000000000001e-05) nan(same) : tensor<4xf32>
    }
  }
  check.trial[256](%trial: index, %entropy: check.entropy) {
    %even_source = check.entropy.fork %entropy name("even") : check.entropy
    %odd_source = check.entropy.fork %entropy name("odd") : check.entropy
    %angle_source = check.entropy.fork %entropy name("angle") : check.entropy
    %even = check.entropy.read %even_source[%trial] : check.entropy -> i64
    %odd = check.entropy.read %odd_source[%trial] : check.entropy -> i64
    %angle = check.entropy.read %angle_source[%trial] : check.entropy -> i64
    %output = check.generate.fill value(0.0) : tensor<4xf32>
    check.compare<@radian_observations>(%even, %odd, %angle, %output) : (i64, i64, i64, tensor<4xf32>) -> () {
      check.expect.close actual(%output) expected(%output) atol(9.9999999999999995e-07) rtol(1.0000000000000001e-05) nan(same) : tensor<4xf32>
    }
  }
  check.return
}
