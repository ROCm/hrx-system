func.def @clamp_number_f32(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<4xf32>
  %output_view = buffer.view %output[%base] : buffer -> view<5xf32>
  %values = vector.load %input_view[0] : view<4xf32> -> vector<4xf32>
  %lower = vector.splatf -1.0 : vector<4xf32>
  %upper = vector.splatf 1.0 : vector<4xf32>
  %vector_result = vector.clampf<number, nnan|nsz> %values, %lower, %upper : vector<4xf32>
  vector.store %vector_result, %output_view[1] : vector<4xf32>, view<5xf32>
  %scalar_value = vector.extract %values[0] : vector<4xf32> -> f32
  %scalar_lower = scalar.constant -1.0 : f32
  %scalar_upper = scalar.constant 1.0 : f32
  %scalar_result = scalar.clampf<number, nnan|nsz> %scalar_value, %scalar_lower, %scalar_upper : f32
  view.store %scalar_result, %output_view[0] : f32, view<5xf32>
  func.return
}

func.def @clamp_ordered_f32(%input_bits: buffer, %lower: buffer, %upper: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input_bits[%base] : buffer -> view<4xi32>
  %lower_view = buffer.view %lower[%base] : buffer -> view<4xf32>
  %upper_view = buffer.view %upper[%base] : buffer -> view<4xf32>
  %output_view = buffer.view %output[%base] : buffer -> view<5xf32>
  %loaded_bits = vector.load %input_view[0] : view<4xi32> -> vector<4xi32>
  %values = vector.bitcast %loaded_bits : vector<4xi32> to vector<4xf32>
  %lower_values = vector.load %lower_view[0] : view<4xf32> -> vector<4xf32>
  %upper_values = vector.load %upper_view[0] : view<4xf32> -> vector<4xf32>
  %vector_result = vector.clampf<ordered> %values, %lower_values, %upper_values : vector<4xf32>
  vector.store %vector_result, %output_view[1] : vector<4xf32>, view<5xf32>
  %scalar_value = vector.extract %values[0] : vector<4xf32> -> f32
  %scalar_lower = vector.extract %lower_values[0] : vector<4xf32> -> f32
  %scalar_upper = vector.extract %upper_values[0] : vector<4xf32> -> f32
  %scalar_result = scalar.clampf<ordered> %scalar_value, %scalar_lower, %scalar_upper : f32
  view.store %scalar_result, %output_view[0] : f32, view<5xf32>
  func.return
}

func.def @clamp_ieee_f32(%input_bits: buffer, %lower: buffer, %upper: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input_bits[%base] : buffer -> view<4xi32>
  %lower_view = buffer.view %lower[%base] : buffer -> view<4xf32>
  %upper_view = buffer.view %upper[%base] : buffer -> view<4xf32>
  %output_view = buffer.view %output[%base] : buffer -> view<5xf32>
  %loaded_bits = vector.load %input_view[0] : view<4xi32> -> vector<4xi32>
  %values = vector.bitcast %loaded_bits : vector<4xi32> to vector<4xf32>
  %lower_values = vector.load %lower_view[0] : view<4xf32> -> vector<4xf32>
  %upper_values = vector.load %upper_view[0] : view<4xf32> -> vector<4xf32>
  %vector_result = vector.clampf<ieee> %values, %lower_values, %upper_values : vector<4xf32>
  vector.store %vector_result, %output_view[1] : vector<4xf32>, view<5xf32>
  %scalar_value = vector.extract %values[0] : vector<4xf32> -> f32
  %scalar_lower = vector.extract %lower_values[0] : vector<4xf32> -> f32
  %scalar_upper = vector.extract %upper_values[0] : vector<4xf32> -> f32
  %scalar_result = scalar.clampf<ieee> %scalar_value, %scalar_lower, %scalar_upper : f32
  view.store %scalar_result, %output_view[0] : f32, view<5xf32>
  func.return
}

check.scenario @clamp_number_f32_values {
  check.trial[64](%trial: index, %entropy: check.entropy) {
    %input_seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%input_seed) range(-1024.0 to 1024.0) : tensor<4xf32>
    %output = check.generate.fill value(0.0) : tensor<5xf32>
    check.compare<@clamp_number_f32>(%input, %output) : (tensor<4xf32>, tensor<5xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<5xf32>
    }
  }
  check.return
}

check.scenario @clamp_ordered_f32_values {
  check.trial[64](%trial: index, %entropy: check.entropy) {
    %input_entropy = check.entropy.fork %entropy name("input") : check.entropy
    %lower_entropy = check.entropy.fork %entropy name("lower") : check.entropy
    %upper_entropy = check.entropy.fork %entropy name("upper") : check.entropy
    %input_seed = check.entropy.read %input_entropy[%trial] : check.entropy -> i64
    %lower_seed = check.entropy.read %lower_entropy[%trial] : check.entropy -> i64
    %upper_seed = check.entropy.read %upper_entropy[%trial] : check.entropy -> i64
    %input_bits = check.generate.random.uniform seed(%input_seed) range(-2147483648 to 2147483647) : tensor<4xi32>
    %lower = check.generate.random.uniform seed(%lower_seed) range(-1024.0 to -1.0) : tensor<4xf32>
    %upper = check.generate.random.uniform seed(%upper_seed) range(1.0 to 1024.0) : tensor<4xf32>
    %output = check.generate.fill value(0.0) : tensor<5xf32>
    check.compare<@clamp_ordered_f32>(%input_bits, %lower, %upper, %output) : (tensor<4xi32>, tensor<4xf32>, tensor<4xf32>, tensor<5xf32>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(0.0) rtol(0.0) nan(same) : tensor<5xf32>, tensor<5xf32>
    }
  }
  check.return
}

