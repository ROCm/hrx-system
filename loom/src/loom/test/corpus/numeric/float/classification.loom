  check.return
}

func.def @classify_bf16(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<4xi16>
  %output_view = buffer.view %output[%base] : buffer -> view<5xi32>
  %bits = vector.load %input_view[0] : view<4xi16> -> vector<4xi16>
  %values = vector.bitcast %bits : vector<4xi16> to vector<4xbf16>
  %value = vector.extract %values[0] : vector<4xbf16> -> bf16
  %scalar_nan = scalar.isnanf %value : bf16
  %scalar_infinity = scalar.isinff %value : bf16
  %scalar_finite = scalar.isfinitef %value : bf16
  %scalar_no_class_bits = scalar.constant 0 : i32
  %nan_bit = scalar.constant 1 : i32
  %infinity_bit = scalar.constant 2 : i32
  %finite_bit = scalar.constant 4 : i32
  %scalar_nan_word = scf.select %scalar_nan, %nan_bit, %scalar_no_class_bits : i32
  %scalar_infinity_word = scf.select %scalar_infinity, %infinity_bit, %scalar_no_class_bits : i32
  %scalar_finite_word = scf.select %scalar_finite, %finite_bit, %scalar_no_class_bits : i32
  %scalar_nonfinite = scalar.ori %scalar_nan_word, %scalar_infinity_word : i32
  %scalar_class = scalar.ori %scalar_nonfinite, %scalar_finite_word : i32
  view.store %scalar_class, %output_view[0] : i32, view<5xi32>
  %vector_nan = vector.isnanf %values : vector<4xbf16> -> vector<4xi1>
  %vector_infinity = vector.isinff %values : vector<4xbf16> -> vector<4xi1>
  %vector_finite = vector.isfinitef %values : vector<4xbf16> -> vector<4xi1>
  %vector_no_class_bits = vector.splati 0 : vector<4xi32>
  %nan_bits = vector.splati 1 : vector<4xi32>
  %infinity_bits = vector.splati 2 : vector<4xi32>
  %finite_bits = vector.splati 4 : vector<4xi32>
  %vector_nan_words = vector.select %vector_nan, %nan_bits, %vector_no_class_bits : vector<4xi32>
  %vector_infinity_words = vector.select %vector_infinity, %infinity_bits, %vector_no_class_bits : vector<4xi32>
  %vector_finite_words = vector.select %vector_finite, %finite_bits, %vector_no_class_bits : vector<4xi32>
  %vector_nonfinite = vector.ori %vector_nan_words, %vector_infinity_words : vector<4xi32>
  %vector_classes = vector.ori %vector_nonfinite, %vector_finite_words : vector<4xi32>
  vector.store %vector_classes, %output_view[1] : vector<4xi32>, view<5xi32>
  func.return
}

func.def @classify_bf16_bits_oracle(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<4xi16>
  %output_view = buffer.view %output[%base] : buffer -> view<5xi32>
  %bits = vector.load %input_view[0] : view<4xi16> -> vector<4xi16>
  %magnitude_mask = vector.splati 32767 : vector<4xi16>
  %magnitude = vector.andi %bits, %magnitude_mask : vector<4xi16>
  %infinity_encoding = vector.splati 32640 : vector<4xi16>
  %nan = vector.cmpi ugt, %magnitude, %infinity_encoding : vector<4xi16> -> vector<4xi1>
  %infinity = vector.cmpi eq, %magnitude, %infinity_encoding : vector<4xi16> -> vector<4xi1>
  %finite = vector.cmpi ult, %magnitude, %infinity_encoding : vector<4xi16> -> vector<4xi1>
  %vector_no_class_bits = vector.splati 0 : vector<4xi32>
  %nan_bits = vector.splati 1 : vector<4xi32>
  %infinity_bits = vector.splati 2 : vector<4xi32>
  %finite_bits = vector.splati 4 : vector<4xi32>
  %nan_words = vector.select %nan, %nan_bits, %vector_no_class_bits : vector<4xi32>
  %infinity_words = vector.select %infinity, %infinity_bits, %vector_no_class_bits : vector<4xi32>
  %finite_words = vector.select %finite, %finite_bits, %vector_no_class_bits : vector<4xi32>
  %nonfinite = vector.ori %nan_words, %infinity_words : vector<4xi32>
  %classes = vector.ori %nonfinite, %finite_words : vector<4xi32>
  %scalar_class = vector.extract %classes[0] : vector<4xi32> -> i32
  view.store %scalar_class, %output_view[0] : i32, view<5xi32>
  vector.store %classes, %output_view[1] : vector<4xi32>, view<5xi32>
  func.return
}

check.scenario @float_classification_bf16_values {
  // Positive zero and the first three subnormals.
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(0) step(1) : tensor<4xi16>
    %output = check.generate.fill value(-559038737) : tensor<5xi32>
    check.compare<@classify_bf16, @classify_bf16_bits_oracle>(%input, %output) : (tensor<4xi16>, tensor<5xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<5xi32>
    }
  }
  // Negative zero and the first three negative subnormals.
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-32768) step(1) : tensor<4xi16>
    %output = check.generate.fill value(-559038737) : tensor<5xi32>
    check.compare<@classify_bf16, @classify_bf16_bits_oracle>(%input, %output) : (tensor<4xi16>, tensor<5xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<5xi32>
    }
  }
  // The largest subnormal and the first three normal values.
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(127) step(1) : tensor<4xi16>
    %output = check.generate.fill value(-559038737) : tensor<5xi32>
    check.compare<@classify_bf16, @classify_bf16_bits_oracle>(%input, %output) : (tensor<4xi16>, tensor<5xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<5xi32>
    }
  }
  // Maximum finite, infinity, and signaling NaN payloads.
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(32639) step(1) : tensor<4xi16>
    %output = check.generate.fill value(-559038737) : tensor<5xi32>
    check.compare<@classify_bf16, @classify_bf16_bits_oracle>(%input, %output) : (tensor<4xi16>, tensor<5xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<5xi32>
    }
  }
  // Quiet NaNs with distinct payloads.
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(32704) step(1) : tensor<4xi16>
    %output = check.generate.fill value(-559038737) : tensor<5xi32>
    check.compare<@classify_bf16, @classify_bf16_bits_oracle>(%input, %output) : (tensor<4xi16>, tensor<5xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<5xi32>
    }
  }
  // The negative maximum finite, infinity, and signaling NaNs.
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-129) step(1) : tensor<4xi16>
    %output = check.generate.fill value(-559038737) : tensor<5xi32>
    check.compare<@classify_bf16, @classify_bf16_bits_oracle>(%input, %output) : (tensor<4xi16>, tensor<5xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<5xi32>
    }
  }
  // Full-range entropy covers ordinary payloads independently of the directed boundaries.
  check.trial[32](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-32768 to 32767) : tensor<4xi16>
    %output = check.generate.fill value(-559038737) : tensor<5xi32>
    check.compare<@classify_bf16, @classify_bf16_bits_oracle>(%input, %output) : (tensor<4xi16>, tensor<5xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<5xi32>
    }
  }
  check.return
}

