// An irregular width exercises full packets and tails. Source reassociation
// permission must not destroy the reduction's split correction. The generated
// inputs and all three results remain finite, satisfying nnan/ninf promises.
func.def @exponential_f64_packets(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %source = buffer.view %input[%origin] : buffer -> view<19xf64>
  %result = buffer.view %output[%origin] : buffer -> view<3x19xf64>
  %values = vector.load %source[0] : view<19xf64> -> vector<19xf64>
  %natural = vector.expf<reassoc|nnan|ninf|nsz|arcp|contract|afn> %values : vector<19xf64>
  %binary = vector.exp2f<reassoc|nnan|ninf|nsz|arcp|contract|afn> %values : vector<19xf64>
  %difference = vector.expm1f<reassoc|nnan|ninf|nsz|arcp|contract|afn> %values : vector<19xf64>
  vector.store %natural, %result[0, 0] : vector<19xf64>, view<3x19xf64>
  vector.store %binary, %result[1, 0] : vector<19xf64>, view<3x19xf64>
  vector.store %difference, %result[2, 0] : vector<19xf64>, view<3x19xf64>
  func.return
}

check.scenario @exponential_f64_packet_values {
  check.trial[64](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-700.0 to 700.0) : tensor<19xf64>
    %output = check.generate.fill value(0.0) : tensor<3x19xf64>
    check.compare<@exponential_f64_packets>(%input, %output) : (tensor<19xf64>, tensor<3x19xf64>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(4.9406564584124654e-324) rtol(1.1102230246251565e-15) nan(same) : tensor<3x19xf64>, tensor<3x19xf64>
    }
  }
  check.trial[64](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-0.40000000000000002 to 0.40000000000000002) : tensor<19xf64>
    %output = check.generate.fill value(0.0) : tensor<3x19xf64>
    check.compare<@exponential_f64_packets>(%input, %output) : (tensor<19xf64>, tensor<3x19xf64>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(4.9406564584124654e-324) rtol(1.1102230246251565e-15) nan(same) : tensor<3x19xf64>, tensor<3x19xf64>
    }
  }
  check.return
}

// Small-lambda Poisson sampling stops when the product of uniform values
// reaches exp(-lambda). Only the threshold evaluation permits approximation;
// the observable sample count is compared exactly with the stable VM mapping.
func.def @poisson_count(%ordinal: index, %uniforms: buffer, %output: buffer) {
  %ordinal_i64 = index.cast %ordinal : index to i64
  %lambda = scalar.uitofp %ordinal_i64 : i64 to f64
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %unit = scalar.constant 1.0 : f64
  %negative_lambda = scalar.negf %lambda : f64
  %limit = scalar.expf<afn> %negative_lambda : f64
  %stream = buffer.view %uniforms[%origin] : buffer -> view<256xf64>
  %result = buffer.view %output[%origin] : buffer -> view<1xi32>
  %final_product, %final_count = scf.while(%product = %unit : f64, %count = %begin : index) -> (f64, index) {
    // The caller's lambda < 64 and uniform <= 0.75 domain bounds the product
    // recurrence, which integer range analysis cannot infer from floating math.
    %position = index.assume %count [range(%count, 0, 223)] : index
    %uniform = view.load %stream[%position] : view<256xf64> -> f64
    %next_product = scalar.mulf %product, %uniform : f64
    %next_count = index.add %count, %step : index
    %more = scalar.cmpf ogt, %next_product, %limit : f64
    scf.condition %more, %next_product, %next_count : i1, f64, index
  } do(%product: f64, %count: index) {
    scf.yield %product, %count : f64, index
  }
  %sample = index.sub %final_count, %step : index
  %sample_i32 = index.cast %sample : index to i32
  view.store %sample_i32, %result[0] : i32, view<1xi32>
  func.return
}

check.scenario @poisson_count_values {
  check.trial[64](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    // With lambda < 64 and uniforms <= 0.75 the loop consumes < 224 values.
    %uniforms = check.generate.random.uniform seed(%seed) range(0.25 to 0.75) : tensor<256xf64>
    %output = check.generate.fill value(0) : tensor<1xi32>
    check.compare<@poisson_count>(%trial, %uniforms, %output) : (index, tensor<256xf64>, tensor<1xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<1xi32>
    }
  }
  check.return
}
