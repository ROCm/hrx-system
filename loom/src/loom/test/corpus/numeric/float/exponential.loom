// Exercises approximate exponential operations across directed IEEE-754
// boundaries and deterministic full-width entropy. Exact power-of-two cases
// separately preserve normal, subnormal, overflow, and underflow result bits.

func.def @exponential_observations(%bits: i32, %output: buffer) {
  %input = scalar.bitcast %bits : i32 to f32
  %base_two = scalar.exp2f<afn> %input : f32
  %natural = scalar.expf<afn> %input : f32
  %results = vector.from_elements %base_two, %natural : vector<2xf32>
  %origin = index.constant 0 : offset
  %result_view = buffer.view %output[%origin] : buffer -> view<2xf32>
  vector.store %results, %result_view[0] : vector<2xf32>, view<2xf32>
  func.return
}

func.def @exponential_entropy_observations(%entropy_bits: i64, %output: buffer) {
  %bits = scalar.trunci %entropy_bits : i64 to i32
  func.call @exponential_observations(%bits, %output) : (i32, buffer)
  func.return
}

func.def @exponential_boundary_observations(%ordinal: index, %output: buffer) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c6 = index.constant 6 : index
  %c7 = index.constant 7 : index
  %c8 = index.constant 8 : index
  %c9 = index.constant 9 : index
  %c10 = index.constant 10 : index
  %is0 = index.cmp eq, %ordinal, %c0 : index
  %is1 = index.cmp eq, %ordinal, %c1 : index
  %is2 = index.cmp eq, %ordinal, %c2 : index
  %is3 = index.cmp eq, %ordinal, %c3 : index
  %is4 = index.cmp eq, %ordinal, %c4 : index
  %is5 = index.cmp eq, %ordinal, %c5 : index
  %is6 = index.cmp eq, %ordinal, %c6 : index
  %is7 = index.cmp eq, %ordinal, %c7 : index
  %is8 = index.cmp eq, %ordinal, %c8 : index
  %is9 = index.cmp eq, %ordinal, %c9 : index
  %is10 = index.cmp eq, %ordinal, %c10 : index
  %value0 = scalar.constant 1065353216 : i32
  %value1 = scalar.constant -1082130432 : i32
  %value2 = scalar.constant 0 : i32
  %value3 = scalar.constant -2147483648 : i32
  %value4 = scalar.constant -1028390912 : i32
  %value5 = scalar.constant -1090519040 : i32
  %value6 = scalar.constant 1117782016 : i32
  %value7 = scalar.constant 2139095040 : i32
  %value8 = scalar.constant -8388608 : i32
  %value9 = scalar.constant 2143289344 : i32
  %value10 = scalar.constant -4194304 : i32
  %value11 = scalar.constant 2139095041 : i32
  %bits0 = scf.select %is0, %value0, %value11 : i32
  %bits1 = scf.select %is1, %value1, %bits0 : i32
  %bits2 = scf.select %is2, %value2, %bits1 : i32
  %bits3 = scf.select %is3, %value3, %bits2 : i32
  %bits4 = scf.select %is4, %value4, %bits3 : i32
  %bits5 = scf.select %is5, %value5, %bits4 : i32
  %bits6 = scf.select %is6, %value6, %bits5 : i32
  %bits7 = scf.select %is7, %value7, %bits6 : i32
  %bits8 = scf.select %is8, %value8, %bits7 : i32
  %bits9 = scf.select %is9, %value9, %bits8 : i32
  %bits10 = scf.select %is10, %value10, %bits9 : i32
  func.call @exponential_observations(%bits10, %output) : (i32, buffer)
  func.return
}

func.def @power_of_two_observations(%ordinal: index, %output: buffer) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c6 = index.constant 6 : index
  %c7 = index.constant 7 : index
  %c8 = index.constant 8 : index
  %is0 = index.cmp eq, %ordinal, %c0 : index
  %is1 = index.cmp eq, %ordinal, %c1 : index
  %is2 = index.cmp eq, %ordinal, %c2 : index
  %is3 = index.cmp eq, %ordinal, %c3 : index
  %is4 = index.cmp eq, %ordinal, %c4 : index
  %is5 = index.cmp eq, %ordinal, %c5 : index
  %is6 = index.cmp eq, %ordinal, %c6 : index
  %is7 = index.cmp eq, %ordinal, %c7 : index
  %is8 = index.cmp eq, %ordinal, %c8 : index
  %value0 = scalar.constant -851 : i32
  %value1 = scalar.constant -2 : i32
  %value2 = scalar.constant -1 : i32
  %value3 = scalar.constant 0 : i32
  %value4 = scalar.constant 22 : i32
  %value5 = scalar.constant 23 : i32
  %value6 = scalar.constant 24 : i32
  %value7 = scalar.constant 277 : i32
  %value8 = scalar.constant 278 : i32
  %value9 = scalar.constant 1149 : i32
  %shift0 = scf.select %is0, %value0, %value9 : i32
  %shift1 = scf.select %is1, %value1, %shift0 : i32
  %shift2 = scf.select %is2, %value2, %shift1 : i32
  %shift3 = scf.select %is3, %value3, %shift2 : i32
  %shift4 = scf.select %is4, %value4, %shift3 : i32
  %shift5 = scf.select %is5, %value5, %shift4 : i32
  %shift6 = scf.select %is6, %value6, %shift5 : i32
  %shift7 = scf.select %is7, %value7, %shift6 : i32
  %shift8 = scf.select %is8, %value8, %shift7 : i32
  %minimum_exponent = scalar.constant -149 : i32
  %exponent = scalar.addi %minimum_exponent, %shift8 : i32
  %input = scalar.sitofp %exponent : i32 to f32
  %result = scalar.exp2f<afn> %input : f32
  %bits = scalar.bitcast %result : f32 to i32
  %origin = index.constant 0 : offset
  %result_view = buffer.view %output[%origin] : buffer -> view<1xi32>
  view.store %bits, %result_view[0] : i32, view<1xi32>
  func.return
}

check.scenario @exponential_values {
  check.trial[10](%trial: index, %entropy: check.entropy) {
    %output = check.generate.fill value(-1) : tensor<1xi32>
    check.compare<@power_of_two_observations>(%trial, %output) : (index, tensor<1xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<1xi32>
    }
  }
  check.trial[12](%trial: index, %entropy: check.entropy) {
    %output = check.generate.fill value(0.0) : tensor<2xf32>
    check.compare<@exponential_boundary_observations>(%trial, %output) : (index, tensor<2xf32>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(1.4012984643248171e-45) rtol(1.0000000000000001e-05) nan(same) : tensor<2xf32>, tensor<2xf32>
    }
  }
  check.trial[256](%trial: index, %entropy: check.entropy) {
    %bits = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %output = check.generate.fill value(0.0) : tensor<2xf32>
    check.compare<@exponential_entropy_observations>(%bits, %output) : (i64, tensor<2xf32>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(1.4012984643248171e-45) rtol(1.0000000000000001e-05) nan(same) : tensor<2xf32>, tensor<2xf32>
    }
  }
  check.return
}

// Differences near one must survive evaluation and final format rounding.
func.def @exponential_difference_observations(%ordinal: index, %output: buffer) {
  %first_trial = index.constant 0 : index
  %positive = index.cmp eq, %ordinal, %first_trial : index
  %positive_input = scalar.constant 0.00390625 : f32
  %negative_input = scalar.constant -0.00390625 : f32
  %input = scf.select %positive, %positive_input, %negative_input : f32
  %e4_input = scalar.fptrunc %input : f32 to f8E4M3
  %e5_input = scalar.fptrunc %input : f32 to f8E5M2
  %half_input = scalar.fptrunc %input : f32 to f16
  %brain_input = scalar.fptrunc %input : f32 to bf16
  %wide_input = scalar.extf %input : f32 to f64
  %e4_result = scalar.expm1f %e4_input : f8E4M3
  %e5_result = scalar.expm1f %e5_input : f8E5M2
  %half_result = scalar.expm1f %half_input : f16
  %brain_result = scalar.expm1f %brain_input : bf16
  %single_result = scalar.expm1f %input : f32
  %wide_result = scalar.expm1f %wide_input : f64
  %e4 = scalar.extf %e4_result : f8E4M3 to f64
  %e5 = scalar.extf %e5_result : f8E5M2 to f64
  %half = scalar.extf %half_result : f16 to f64
  %brain = scalar.extf %brain_result : bf16 to f64
  %single = scalar.extf %single_result : f32 to f64
  %values = vector.from_elements %e4, %e5, %half, %brain, %single, %wide_result : vector<6xf64>
  %origin = index.constant 0 : offset
  %results = buffer.view %output[%origin] : buffer -> view<6xf64>
  vector.store %values, %results[0] : vector<6xf64>, view<6xf64>
  func.return
}

func.def @exponential_difference_oracle(%ordinal: index, %output: buffer) {
  %first_trial = index.constant 0 : index
  %positive = index.cmp eq, %ordinal, %first_trial : index
  // Independently rounded expm1(+/-1/256), from directed MPFR intervals.
  %positive_result = scalar.constant 0.0039138893383475733 : f64
  %negative_result = scalar.constant -0.00389863052988251 : f64
  %wide_result = scf.select %positive, %positive_result, %negative_result : f64
  %single_result = scalar.fptrunc %wide_result : f64 to f32
  %e4_result = scalar.fptrunc %single_result : f32 to f8E4M3
  %e5_result = scalar.fptrunc %single_result : f32 to f8E5M2
  %half_result = scalar.fptrunc %single_result : f32 to f16
  %brain_result = scalar.fptrunc %single_result : f32 to bf16
  %e4 = scalar.extf %e4_result : f8E4M3 to f64
  %e5 = scalar.extf %e5_result : f8E5M2 to f64
  %half = scalar.extf %half_result : f16 to f64
  %brain = scalar.extf %brain_result : bf16 to f64
  %single = scalar.extf %single_result : f32 to f64
  %values = vector.from_elements %e4, %e5, %half, %brain, %single, %wide_result : vector<6xf64>
  %origin = index.constant 0 : offset
  %results = buffer.view %output[%origin] : buffer -> view<6xf64>
  vector.store %values, %results[0] : vector<6xf64>, view<6xf64>
  func.return
}

check.scenario @exponential_difference_values {
  check.trial[2](%trial: index, %entropy: check.entropy) {
    %output = check.generate.fill value(-1.0) : tensor<6xf64>
    check.compare<@exponential_difference_observations, @exponential_difference_oracle>(%trial, %output) : (index, tensor<6xf64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<6xf64>
    }
  }
  check.return
}

// Positive and negative integer powers exercise both operands across every
// source format. The cube and reciprocal oracle uses exact dyadic arithmetic.
func.def @power_observations(%base: f32, %exponent: f32, %output: buffer) {
  %negative_exponent = scalar.negf %exponent : f32
  %bases = vector.splat %base : vector<2xf32>
  %exponents = vector.from_elements %exponent, %negative_exponent : vector<2xf32>
  %e4_bases = vector.fptrunc %bases : vector<2xf32> to vector<2xf8E4M3>
  %e4_exponents = vector.fptrunc %exponents : vector<2xf32> to vector<2xf8E4M3>
  %e5_bases = vector.fptrunc %bases : vector<2xf32> to vector<2xf8E5M2>
  %e5_exponents = vector.fptrunc %exponents : vector<2xf32> to vector<2xf8E5M2>
  %half_bases = vector.fptrunc %bases : vector<2xf32> to vector<2xf16>
  %half_exponents = vector.fptrunc %exponents : vector<2xf32> to vector<2xf16>
  %brain_bases = vector.fptrunc %bases : vector<2xf32> to vector<2xbf16>
  %brain_exponents = vector.fptrunc %exponents : vector<2xf32> to vector<2xbf16>
  %wide_bases = vector.extf %bases : vector<2xf32> to vector<2xf64>
  %wide_exponents = vector.extf %exponents : vector<2xf32> to vector<2xf64>
  %e4_result = vector.powf %e4_bases, %e4_exponents : vector<2xf8E4M3>
  %e5_result = vector.powf %e5_bases, %e5_exponents : vector<2xf8E5M2>
  %half_result = vector.powf %half_bases, %half_exponents : vector<2xf16>
  %brain_result = vector.powf %brain_bases, %brain_exponents : vector<2xbf16>
  %single_result = vector.powf %bases, %exponents : vector<2xf32>
  %wide_result = vector.powf %wide_bases, %wide_exponents : vector<2xf64>
  %e4 = vector.extf %e4_result : vector<2xf8E4M3> to vector<2xf64>
  %e5 = vector.extf %e5_result : vector<2xf8E5M2> to vector<2xf64>
  %half = vector.extf %half_result : vector<2xf16> to vector<2xf64>
  %brain = vector.extf %brain_result : vector<2xbf16> to vector<2xf64>
  %single = vector.extf %single_result : vector<2xf32> to vector<2xf64>
  %values = vector.concat<0> %e4, %e5, %half, %brain, %single, %wide_result : vector<2xf64>, vector<2xf64>, vector<2xf64>, vector<2xf64>, vector<2xf64>, vector<2xf64> -> vector<12xf64>
  %origin = index.constant 0 : offset
  %results = buffer.view %output[%origin] : buffer -> view<12xf64>
  vector.store %values, %results[0] : vector<12xf64>, view<12xf64>
  func.return
}

func.def @power_cube_oracle(%base: f32, %exponent: f32, %output: buffer) {
  %wide = scalar.extf %base : f32 to f64
  %square = scalar.mulf %wide, %wide : f64
  %cube = scalar.mulf %square, %wide : f64
  %unit_numerator = scalar.constant 1.0 : f64
  %inverse = scalar.divf %unit_numerator, %cube : f64
  %pair = vector.from_elements %cube, %inverse : vector<2xf64>
  %values = vector.concat<0> %pair, %pair, %pair, %pair, %pair, %pair : vector<2xf64>, vector<2xf64>, vector<2xf64>, vector<2xf64>, vector<2xf64>, vector<2xf64> -> vector<12xf64>
  %origin = index.constant 0 : offset
  %results = buffer.view %output[%origin] : buffer -> view<12xf64>
  vector.store %values, %results[0] : vector<12xf64>, view<12xf64>
  func.return
}

func.def @power_inputs(%ordinal: index) -> (f32, f32) {
  %first = index.constant 0 : index
  %positive = index.cmp eq, %ordinal, %first : index
  %positive_base = scalar.constant 4.0 : f32
  %negative_base = scalar.constant -2.0 : f32
  %base = scf.select %positive, %positive_base, %negative_base : f32
  %exponent = scalar.constant 3.0 : f32
  func.return %base, %exponent : f32, f32
}

check.scenario @power_values {
  check.trial[2](%trial: index, %entropy: check.entropy) {
    %base, %exponent = check.generate<@power_inputs>(%trial) : (index) -> (f32, f32)
    %output = check.generate.fill value(-1.0) : tensor<12xf64>
    check.compare<@power_observations, @power_cube_oracle>(%base, %exponent, %output) : (f32, f32, tensor<12xf64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<12xf64>
    }
  }
  check.return
}

// Scalar and packet evaluations consume the same runtime values. The VM
// reference uses the independent stable exponential mappings.
func.def @exponential_f32_family(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 32 : index
  %packet = index.constant 4 : index
  %step = index.constant 1 : index
  %source = buffer.view %input[%origin] : buffer -> view<32xf32>
  %result = buffer.view %output[%origin] : buffer -> view<6x32xf32>
  scf.for %i = [%begin to %end step %packet] {
    %values = vector.load %source[%i] : view<32xf32> -> vector<4xf32>
    %natural = vector.expf<afn> %values : vector<4xf32>
    %binary = vector.exp2f<afn> %values : vector<4xf32>
    %difference = vector.expm1f<afn> %values : vector<4xf32>
    vector.store %natural, %result[0, %i] : vector<4xf32>, view<6x32xf32>
    vector.store %binary, %result[1, %i] : vector<4xf32>, view<6x32xf32>
    vector.store %difference, %result[2, %i] : vector<4xf32>, view<6x32xf32>
  }
  scf.for %i = [%begin to %end step %step] {
    %value = view.load %source[%i] : view<32xf32> -> f32
    %natural = scalar.expf<afn> %value : f32
    %binary = scalar.exp2f<afn> %value : f32
    %difference = scalar.expm1f<afn> %value : f32
    view.store %natural, %result[3, %i] : f32, view<6x32xf32>
    view.store %binary, %result[4, %i] : f32, view<6x32xf32>
    view.store %difference, %result[5, %i] : f32, view<6x32xf32>
  }
  func.return
}

// Zeros, subnormals, NaNs, and neighboring reduction/overflow/underflow cuts.
func.def @exponential_f32_inputs(%input: buffer) {
  %origin = index.constant 0 : offset
  %destination = buffer.view %input[%origin] : buffer -> view<32xi32>
  %bits = vector.constanti [0, -2147483648, 1, -2147483647, 8388607, 8388608, 2139095040, -8388608, 2143289344, 2139095041, 1051816471, 1051816472, 1051816473, -1095667177, -1095667176, -1095667175, 1118925335, 1118925336, 1118925337, -1026559565, -1026559564, -1026559563, 1124073471, 1124073472, 1124073473, -1021968385, -1021968384, -1021968383, 864026624, -1283457024, 1065353216, -1082130432] : vector<32xi32>
  vector.store %bits, %destination[0] : vector<32xi32>, view<32xi32>
  func.return
}

check.scenario @exponential_f32_family_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(0) : tensor<32xi32>
    check.generate<@exponential_f32_inputs>(%input) : (tensor<32xi32>) -> ()
    %output = check.generate.fill value(0.0) : tensor<6x32xf32>
    %vector_difference = check.tensor.view %output offset(256) : tensor<6x32xf32> -> tensor<32xf32>
    %scalar_difference = check.tensor.view %output offset(640) : tensor<6x32xf32> -> tensor<32xf32>
    %vector_tiny = check.tensor.view %output offset(256) : tensor<6x32xf32> -> tensor<4xf32>
    %scalar_tiny = check.tensor.view %output offset(640) : tensor<6x32xf32> -> tensor<4xf32>
    check.compare<@exponential_f32_family>(%input, %output) : (tensor<32xi32>, tensor<6x32xf32>) -> () {
      check.expect.bitwise actual(%vector_tiny) expected(%vector_tiny) : tensor<4xf32>
      check.expect.bitwise actual(%scalar_tiny) expected(%scalar_tiny) : tensor<4xf32>
      check.expect.approximate actual(%output) expected(%output) atol(1.4012984643248171e-45) rtol(1.0000000000000001e-05) nan(same) : tensor<6x32xf32>, tensor<6x32xf32>
      check.expect.approximate actual(%vector_difference) expected(%vector_difference) atol(1.4012984643248171e-45) rtol(5.9604644775390625e-07) nan(same) : tensor<32xf32>, tensor<32xf32>
      check.expect.approximate actual(%scalar_difference) expected(%scalar_difference) atol(1.4012984643248171e-45) rtol(5.9604644775390625e-07) nan(same) : tensor<32xf32>, tensor<32xf32>
    }
  }
  check.trial[64](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-2147483648 to 2147483647) : tensor<32xi32>
    %output = check.generate.fill value(0.0) : tensor<6x32xf32>
    %vector_difference = check.tensor.view %output offset(256) : tensor<6x32xf32> -> tensor<32xf32>
    %scalar_difference = check.tensor.view %output offset(640) : tensor<6x32xf32> -> tensor<32xf32>
    check.compare<@exponential_f32_family>(%input, %output) : (tensor<32xi32>, tensor<6x32xf32>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(1.4012984643248171e-45) rtol(1.0000000000000001e-05) nan(same) : tensor<6x32xf32>, tensor<6x32xf32>
      check.expect.approximate actual(%vector_difference) expected(%vector_difference) atol(1.4012984643248171e-45) rtol(5.9604644775390625e-07) nan(same) : tensor<32xf32>, tensor<32xf32>
      check.expect.approximate actual(%scalar_difference) expected(%scalar_difference) atol(1.4012984643248171e-45) rtol(5.9604644775390625e-07) nan(same) : tensor<32xf32>, tensor<32xf32>
    }
  }
  check.trial[64](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-160.0 to 140.0) : tensor<32xf32>
    %output = check.generate.fill value(0.0) : tensor<6x32xf32>
    %vector_difference = check.tensor.view %output offset(256) : tensor<6x32xf32> -> tensor<32xf32>
    %scalar_difference = check.tensor.view %output offset(640) : tensor<6x32xf32> -> tensor<32xf32>
    check.compare<@exponential_f32_family>(%input, %output) : (tensor<32xf32>, tensor<6x32xf32>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(1.4012984643248171e-45) rtol(1.0000000000000001e-05) nan(same) : tensor<6x32xf32>, tensor<6x32xf32>
      check.expect.approximate actual(%vector_difference) expected(%vector_difference) atol(1.4012984643248171e-45) rtol(5.9604644775390625e-07) nan(same) : tensor<32xf32>, tensor<32xf32>
      check.expect.approximate actual(%scalar_difference) expected(%scalar_difference) atol(1.4012984643248171e-45) rtol(5.9604644775390625e-07) nan(same) : tensor<32xf32>, tensor<32xf32>
    }
  }
  check.trial[64](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-0.40000000000000002 to 0.40000000000000002) : tensor<32xf32>
    %output = check.generate.fill value(0.0) : tensor<6x32xf32>
    %vector_difference = check.tensor.view %output offset(256) : tensor<6x32xf32> -> tensor<32xf32>
    %scalar_difference = check.tensor.view %output offset(640) : tensor<6x32xf32> -> tensor<32xf32>
    check.compare<@exponential_f32_family>(%input, %output) : (tensor<32xf32>, tensor<6x32xf32>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(1.4012984643248171e-45) rtol(1.0000000000000001e-05) nan(same) : tensor<6x32xf32>, tensor<6x32xf32>
      check.expect.approximate actual(%vector_difference) expected(%vector_difference) atol(1.4012984643248171e-45) rtol(5.9604644775390625e-07) nan(same) : tensor<32xf32>, tensor<32xf32>
      check.expect.approximate actual(%scalar_difference) expected(%scalar_difference) atol(1.4012984643248171e-45) rtol(5.9604644775390625e-07) nan(same) : tensor<32xf32>, tensor<32xf32>
    }
  }
  check.return
}

// Scalar and packet evaluations consume the same runtime values. The VM
// reference uses the independent stable exponential mappings.
func.def @exponential_f64_family(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 32 : index
  %packet = index.constant 4 : index
  %step = index.constant 1 : index
  %source = buffer.view %input[%origin] : buffer -> view<32xf64>
  %result = buffer.view %output[%origin] : buffer -> view<6x32xf64>
  scf.for %i = [%begin to %end step %packet] {
    %values = vector.load %source[%i] : view<32xf64> -> vector<4xf64>
    %natural = vector.expf<afn> %values : vector<4xf64>
    %binary = vector.exp2f<afn> %values : vector<4xf64>
    %difference = vector.expm1f<afn> %values : vector<4xf64>
    vector.store %natural, %result[0, %i] : vector<4xf64>, view<6x32xf64>
    vector.store %binary, %result[1, %i] : vector<4xf64>, view<6x32xf64>
    vector.store %difference, %result[2, %i] : vector<4xf64>, view<6x32xf64>
  }
  scf.for %i = [%begin to %end step %step] {
    %value = view.load %source[%i] : view<32xf64> -> f64
    %natural = scalar.expf<afn> %value : f64
    %binary = scalar.exp2f<afn> %value : f64
    %difference = scalar.expm1f<afn> %value : f64
    view.store %natural, %result[3, %i] : f64, view<6x32xf64>
    view.store %binary, %result[4, %i] : f64, view<6x32xf64>
    view.store %difference, %result[5, %i] : f64, view<6x32xf64>
  }
  func.return
}

// Zeros, subnormals, NaNs, and neighboring reduction/overflow/underflow cuts.
func.def @exponential_f64_inputs(%input: buffer) {
  %origin = index.constant 0 : offset
  %destination = buffer.view %input[%origin] : buffer -> view<32xi64>
  %bits = vector.constanti [0, -9223372036854775808, 1, -9223372036854775807, 4503599627370495, 4503599627370496, 9218868437227405312, -4503599627370496, 9221120237041090560, 9218868437227405313, 4599914934686071278, 4599914934686071279, 4599914934686071280, -4623457102168704530, -4623457102168704529, -4623457102168704528, 4649454530587146734, 4649454530587146735, 4649454530587146736, -4573606559926636464, -4573606559926636463, -4573606559926636462, 4652218415073722367, 4652218415073722368, 4652218415073722369, -4570929321408987137, -4570929321408987136, -4570929321408987135, 4368491638549381120, -4854880398305394688, 4607182418800017408, -4616189618054758400] : vector<32xi64>
  vector.store %bits, %destination[0] : vector<32xi64>, view<32xi64>
  func.return
}

check.scenario @exponential_f64_family_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(0) : tensor<32xi64>
    check.generate<@exponential_f64_inputs>(%input) : (tensor<32xi64>) -> ()
    %output = check.generate.fill value(0.0) : tensor<6x32xf64>
    %vector_tiny = check.tensor.view %output offset(512) : tensor<6x32xf64> -> tensor<4xf64>
    %scalar_tiny = check.tensor.view %output offset(1280) : tensor<6x32xf64> -> tensor<4xf64>
    check.compare<@exponential_f64_family>(%input, %output) : (tensor<32xi64>, tensor<6x32xf64>) -> () {
      check.expect.bitwise actual(%vector_tiny) expected(%vector_tiny) : tensor<4xf64>
      check.expect.bitwise actual(%scalar_tiny) expected(%scalar_tiny) : tensor<4xf64>
      check.expect.approximate actual(%output) expected(%output) atol(4.9406564584124654e-324) rtol(1.1102230246251565e-15) nan(same) : tensor<6x32xf64>, tensor<6x32xf64>
    }
  }
  check.trial[64](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-9223372036854775808 to 9223372036854775807) : tensor<32xi64>
    %output = check.generate.fill value(0.0) : tensor<6x32xf64>
    check.compare<@exponential_f64_family>(%input, %output) : (tensor<32xi64>, tensor<6x32xf64>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(4.9406564584124654e-324) rtol(1.1102230246251565e-15) nan(same) : tensor<6x32xf64>, tensor<6x32xf64>
    }
  }
  check.trial[64](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-1100.0 to 1050.0) : tensor<32xf64>
    %output = check.generate.fill value(0.0) : tensor<6x32xf64>
    check.compare<@exponential_f64_family>(%input, %output) : (tensor<32xf64>, tensor<6x32xf64>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(4.9406564584124654e-324) rtol(1.1102230246251565e-15) nan(same) : tensor<6x32xf64>, tensor<6x32xf64>
    }
  }
  check.return
}

