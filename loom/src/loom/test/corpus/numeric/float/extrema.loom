// Raw operands preserve signed zeros, subnormals, and signaling NaNs.
// Arithmetic NaN payloads are unspecified, so normalize only NaN results for
// comparison.
func.def @float_extrema_f32(%lhs_buffer: buffer, %rhs_buffer: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %lhs_view = buffer.view %lhs_buffer[%base] : buffer -> view<1xi32>
  %rhs_view = buffer.view %rhs_buffer[%base] : buffer -> view<1xi32>
  %view = buffer.view %output[%base] : buffer -> view<4xi32>
  %lhs_bits = view.load %lhs_view[0] : view<1xi32> -> i32
  %rhs_bits = view.load %rhs_view[0] : view<1xi32> -> i32
  %lhs = scalar.bitcast %lhs_bits : i32 to f32
  %rhs = scalar.bitcast %rhs_bits : i32 to f32
  %nan_bits = scalar.constant 2143289344 : i32
  %minimumf = scalar.minimumf %lhs, %rhs : f32
  %minimumf_bits = scalar.bitcast %minimumf : f32 to i32
  %minimumf_nan = scalar.cmpf uno, %minimumf, %minimumf : f32
  %minimumf_observed = scf.select %minimumf_nan, %nan_bits, %minimumf_bits : i32
  view.store %minimumf_observed, %view[0] : i32, view<4xi32>
  %maximumf = scalar.maximumf %lhs, %rhs : f32
  %maximumf_bits = scalar.bitcast %maximumf : f32 to i32
  %maximumf_nan = scalar.cmpf uno, %maximumf, %maximumf : f32
  %maximumf_observed = scf.select %maximumf_nan, %nan_bits, %maximumf_bits : i32
  view.store %maximumf_observed, %view[1] : i32, view<4xi32>
  %minnumf = scalar.minnumf %lhs, %rhs : f32
  %minnumf_bits = scalar.bitcast %minnumf : f32 to i32
  %minnumf_nan = scalar.cmpf uno, %minnumf, %minnumf : f32
  %minnumf_observed = scf.select %minnumf_nan, %nan_bits, %minnumf_bits : i32
  view.store %minnumf_observed, %view[2] : i32, view<4xi32>
  %maxnumf = scalar.maxnumf %lhs, %rhs : f32
  %maxnumf_bits = scalar.bitcast %maxnumf : f32 to i32
  %maxnumf_nan = scalar.cmpf uno, %maxnumf, %maxnumf : f32
  %maxnumf_observed = scf.select %maxnumf_nan, %nan_bits, %maxnumf_bits : i32
  view.store %maxnumf_observed, %view[3] : i32, view<4xi32>
  func.return
}

check.scenario @float_extrema_values {
  // Finite values.
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %lhs = check.generate.fill value(-1082130432) : tensor<1xi32>
    %rhs = check.generate.fill value(1073741824) : tensor<1xi32>
    %output = check.generate.fill value(0) : tensor<4xi32>
    check.compare<@float_extrema_f32>(%lhs, %rhs, %output) : (tensor<1xi32>, tensor<1xi32>, tensor<4xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi32>
    }
  }
  // Opposing signed zeros in both orders.
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %lhs = check.generate.fill value(0) : tensor<1xi32>
    %rhs = check.generate.fill value(-2147483648) : tensor<1xi32>
    %output = check.generate.fill value(0) : tensor<4xi32>
    check.compare<@float_extrema_f32>(%lhs, %rhs, %output) : (tensor<1xi32>, tensor<1xi32>, tensor<4xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %lhs = check.generate.fill value(-2147483648) : tensor<1xi32>
    %rhs = check.generate.fill value(0) : tensor<1xi32>
    %output = check.generate.fill value(0) : tensor<4xi32>
    check.compare<@float_extrema_f32>(%lhs, %rhs, %output) : (tensor<1xi32>, tensor<1xi32>, tensor<4xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi32>
    }
  }
  // Opposing infinities and subnormals.
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %lhs = check.generate.fill value(-8388608) : tensor<1xi32>
    %rhs = check.generate.fill value(2139095040) : tensor<1xi32>
    %output = check.generate.fill value(0) : tensor<4xi32>
    check.compare<@float_extrema_f32>(%lhs, %rhs, %output) : (tensor<1xi32>, tensor<1xi32>, tensor<4xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %lhs = check.generate.fill value(-2147483647) : tensor<1xi32>
    %rhs = check.generate.fill value(1) : tensor<1xi32>
    %output = check.generate.fill value(0) : tensor<4xi32>
    check.compare<@float_extrema_f32>(%lhs, %rhs, %output) : (tensor<1xi32>, tensor<1xi32>, tensor<4xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi32>
    }
  }
  // Positive and negative quiet NaNs in either operand.
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %lhs = check.generate.fill value(2143363909) : tensor<1xi32>
    %rhs = check.generate.fill value(1065353216) : tensor<1xi32>
    %output = check.generate.fill value(0) : tensor<4xi32>
    check.compare<@float_extrema_f32>(%lhs, %rhs, %output) : (tensor<1xi32>, tensor<1xi32>, tensor<4xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %lhs = check.generate.fill value(1065353216) : tensor<1xi32>
    %rhs = check.generate.fill value(2143363909) : tensor<1xi32>
    %output = check.generate.fill value(0) : tensor<4xi32>
    check.compare<@float_extrema_f32>(%lhs, %rhs, %output) : (tensor<1xi32>, tensor<1xi32>, tensor<4xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %lhs = check.generate.fill value(-4119739) : tensor<1xi32>
    %rhs = check.generate.fill value(1065353216) : tensor<1xi32>
    %output = check.generate.fill value(0) : tensor<4xi32>
    check.compare<@float_extrema_f32>(%lhs, %rhs, %output) : (tensor<1xi32>, tensor<1xi32>, tensor<4xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %lhs = check.generate.fill value(1065353216) : tensor<1xi32>
    %rhs = check.generate.fill value(-4119739) : tensor<1xi32>
    %output = check.generate.fill value(0) : tensor<4xi32>
    check.compare<@float_extrema_f32>(%lhs, %rhs, %output) : (tensor<1xi32>, tensor<1xi32>, tensor<4xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi32>
    }
  }
  // Positive and negative signaling NaNs in either operand.
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %lhs = check.generate.fill value(2139169605) : tensor<1xi32>
    %rhs = check.generate.fill value(1065353216) : tensor<1xi32>
    %output = check.generate.fill value(0) : tensor<4xi32>
    check.compare<@float_extrema_f32>(%lhs, %rhs, %output) : (tensor<1xi32>, tensor<1xi32>, tensor<4xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %lhs = check.generate.fill value(1065353216) : tensor<1xi32>
    %rhs = check.generate.fill value(2139169605) : tensor<1xi32>
    %output = check.generate.fill value(0) : tensor<4xi32>
    check.compare<@float_extrema_f32>(%lhs, %rhs, %output) : (tensor<1xi32>, tensor<1xi32>, tensor<4xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %lhs = check.generate.fill value(-8314043) : tensor<1xi32>
    %rhs = check.generate.fill value(1065353216) : tensor<1xi32>
    %output = check.generate.fill value(0) : tensor<4xi32>
    check.compare<@float_extrema_f32>(%lhs, %rhs, %output) : (tensor<1xi32>, tensor<1xi32>, tensor<4xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %lhs = check.generate.fill value(1065353216) : tensor<1xi32>
    %rhs = check.generate.fill value(-8314043) : tensor<1xi32>
    %output = check.generate.fill value(0) : tensor<4xi32>
    check.compare<@float_extrema_f32>(%lhs, %rhs, %output) : (tensor<1xi32>, tensor<1xi32>, tensor<4xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi32>
    }
  }
  // Two signaling NaNs with opposite signs.
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %lhs = check.generate.fill value(2139169605) : tensor<1xi32>
    %rhs = check.generate.fill value(-3849439) : tensor<1xi32>
    %output = check.generate.fill value(0) : tensor<4xi32>
    check.compare<@float_extrema_f32>(%lhs, %rhs, %output) : (tensor<1xi32>, tensor<1xi32>, tensor<4xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi32>
    }
  }
  check.return
}
