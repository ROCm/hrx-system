func.def inline @pack_f32_predicates(%bit0: i1, %bit1: i1, %bit2: i1, %bit3: i1, %bit4: i1, %bit5: i1) -> (i32) {
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %c3 = scalar.constant 3 : i32
  %c4 = scalar.constant 4 : i32
  %c5 = scalar.constant 5 : i32
  %word0 = scalar.extui %bit0 : i1 to i32
  %word1 = scalar.extui %bit1 : i1 to i32
  %word2 = scalar.extui %bit2 : i1 to i32
  %word3 = scalar.extui %bit3 : i1 to i32
  %word4 = scalar.extui %bit4 : i1 to i32
  %word5 = scalar.extui %bit5 : i1 to i32
  %shifted1 = scalar.shli %word1, %c1 : i32
  %shifted2 = scalar.shli %word2, %c2 : i32
  %shifted3 = scalar.shli %word3, %c3 : i32
  %shifted4 = scalar.shli %word4, %c4 : i32
  %shifted5 = scalar.shli %word5, %c5 : i32
  %mask1 = scalar.ori %word0, %shifted1 : i32
  %mask2 = scalar.ori %mask1, %shifted2 : i32
  %mask3 = scalar.ori %mask2, %shifted3 : i32
  %mask4 = scalar.ori %mask3, %shifted4 : i32
  %mask5 = scalar.ori %mask4, %shifted5 : i32
  func.return %mask5 : i32
}

func.def @scalar_f32_observations(%ordinal: index, %input: buffer, %round_inputs: buffer, %float_output: buffer, %predicate_output: buffer) {
  %origin = index.constant 0 : offset
  %bounded_ordinal = index.assume %ordinal [range(%ordinal, 0, 63)] : index
  %input_view = buffer.view %input[%origin] : buffer -> view<4xf32>
  %round_input_view = buffer.view %round_inputs[%origin] : buffer -> view<64xf32>
  %lhs = view.load %input_view[0] : view<4xf32> -> f32
  %rhs = view.load %input_view[1] : view<4xf32> -> f32
  %sqrt_seed = view.load %input_view[3] : view<4xf32> -> f32
  %round_input = view.load %round_input_view[%bounded_ordinal] : view<64xf32> -> f32
  %sum = scalar.addf %lhs, %rhs : f32
  %difference = scalar.subf %lhs, %rhs : f32
  %product = scalar.mulf %lhs, %rhs : f32
  %quotient = scalar.divf %lhs, %rhs : f32
  %remainder = scalar.remf %lhs, %rhs : f32
  %absolute = scalar.absf %lhs : f32
  %negated = scalar.negf %lhs : f32
  %copied = scalar.copysignf %lhs, %rhs : f32
  %minimum = scalar.minimumf %lhs, %rhs : f32
  %maximum = scalar.maximumf %lhs, %rhs : f32
  %ceil = scalar.ceilf %round_input : f32
  %floor = scalar.floorf %round_input : f32
  %roundeven = scalar.roundevenf %round_input : f32
  %trunc = scalar.truncf %round_input : f32
  %sqrt_input = scalar.absf %sqrt_seed : f32
  %sqrt = scalar.sqrtf %sqrt_input : f32
  %equal = scalar.cmpf oeq, %lhs, %rhs : f32
  %greater = scalar.cmpf ogt, %lhs, %rhs : f32
  %greater_equal = scalar.cmpf oge, %lhs, %rhs : f32
  %less = scalar.cmpf olt, %lhs, %rhs : f32
  %less_equal = scalar.cmpf ole, %lhs, %rhs : f32
  %not_equal_or_unordered = scalar.cmpf une, %lhs, %rhs : f32
  %ordered_mask = func.call @pack_f32_predicates(%equal, %greater, %greater_equal, %less, %less_equal, %not_equal_or_unordered) : (i1, i1, i1, i1, i1, i1) -> (i32)
  %not_equal = scalar.cmpf<nnan> one, %lhs, %rhs : f32
  %unordered_equal = scalar.cmpf<nnan> ueq, %lhs, %rhs : f32
  %unordered_greater = scalar.cmpf<nnan> ugt, %lhs, %rhs : f32
  %unordered_greater_equal = scalar.cmpf<nnan> uge, %lhs, %rhs : f32
  %unordered_less = scalar.cmpf<nnan> ult, %lhs, %rhs : f32
  %unordered_less_equal = scalar.cmpf<nnan> ule, %lhs, %rhs : f32
  %no_nan_mask = func.call @pack_f32_predicates(%not_equal, %unordered_equal, %unordered_greater, %unordered_greater_equal, %unordered_less, %unordered_less_equal) : (i1, i1, i1, i1, i1, i1) -> (i32)

  %float_results = buffer.view %float_output[%origin] : buffer -> view<15xf32>
  view.store %sum, %float_results[0] : f32, view<15xf32>
  view.store %difference, %float_results[1] : f32, view<15xf32>
  view.store %product, %float_results[2] : f32, view<15xf32>
  view.store %quotient, %float_results[3] : f32, view<15xf32>
  view.store %remainder, %float_results[4] : f32, view<15xf32>
  view.store %absolute, %float_results[5] : f32, view<15xf32>
  view.store %negated, %float_results[6] : f32, view<15xf32>
  view.store %copied, %float_results[7] : f32, view<15xf32>
  view.store %minimum, %float_results[8] : f32, view<15xf32>
  view.store %maximum, %float_results[9] : f32, view<15xf32>
  view.store %ceil, %float_results[10] : f32, view<15xf32>
  view.store %floor, %float_results[11] : f32, view<15xf32>
  view.store %roundeven, %float_results[12] : f32, view<15xf32>
  view.store %trunc, %float_results[13] : f32, view<15xf32>
  view.store %sqrt, %float_results[14] : f32, view<15xf32>
  %predicate_results = buffer.view %predicate_output[%origin] : buffer -> view<2xi32>
  view.store %ordered_mask, %predicate_results[0] : i32, view<2xi32>
  view.store %no_nan_mask, %predicate_results[1] : i32, view<2xi32>
  func.return
}

// Random ordinary finite values exercise the broad shared numeric contract.
// Directed representation boundaries have independent scenarios below.
check.scenario @scalar_f32_values {
  check.trial[64](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-1024.0 to 1024.0) : tensor<4xf32>
    %expected_input = check.generate.random.uniform seed(%seed) range(-1024.0 to 1024.0) : tensor<4xf32>
    %round_inputs = check.generate.iota offset(-16.0) step(0.5) : tensor<64xf32>
    %expected_round_inputs = check.generate.iota offset(-16.0) step(0.5) : tensor<64xf32>
    %float_output = check.generate.fill value(-123.5) : tensor<15xf32>
    %predicate_output = check.generate.fill value(-1) : tensor<2xi32>
    check.compare<@scalar_f32_observations>(%trial, %input, %round_inputs, %float_output, %predicate_output) : (index, tensor<4xf32>, tensor<64xf32>, tensor<15xf32>, tensor<2xi32>) -> () {
      check.expect.close actual(%float_output) expected(%float_output) atol(0.0) rtol(9.9999999999999995e-07) nan(same) : tensor<15xf32>
      check.expect.bitwise actual(%predicate_output) expected(%predicate_output) : tensor<2xi32>
      check.expect.bitwise actual(%input) expected(%expected_input) : tensor<4xf32>
      check.expect.bitwise actual(%round_inputs) expected(%expected_round_inputs) : tensor<64xf32>
    }
  }
  check.return
}

// Observes the f32 denormal environment through dynamic scalar arguments.
// Addition and subtraction consume signed subnormal inputs; multiplication and
// exact division produce signed subnormal results. The rounding pair lands on
// the minimum normal encoding from opposite signs.
func.def @scalar_f32_denormal_observations(%positive_min_subnormal_bits: i32, %negative_min_subnormal_bits: i32, %positive_min_normal_bits: i32, %negative_min_normal_bits: i32, %positive_round_bits: i32, %negative_round_bits: i32, %positive_one_bits: i32, %negative_one_bits: i32, %output: buffer) {
  %positive_min_subnormal = scalar.bitcast %positive_min_subnormal_bits : i32 to f32
  %negative_min_subnormal = scalar.bitcast %negative_min_subnormal_bits : i32 to f32
  %positive_min_normal = scalar.bitcast %positive_min_normal_bits : i32 to f32
  %negative_min_normal = scalar.bitcast %negative_min_normal_bits : i32 to f32
  %positive_round = scalar.bitcast %positive_round_bits : i32 to f32
  %negative_round = scalar.bitcast %negative_round_bits : i32 to f32
  %positive_one = scalar.bitcast %positive_one_bits : i32 to f32
  %negative_one = scalar.bitcast %negative_one_bits : i32 to f32
  %quarter_bits = scalar.constant 1048576000 : i32
  %quarter = scalar.bitcast %quarter_bits : i32 to f32
  %divisor_bits = scalar.constant 1082130432 : i32
  %divisor = scalar.bitcast %divisor_bits : i32 to f32

  %positive_add = scalar.addf %positive_min_subnormal, %positive_min_subnormal : f32
  %negative_add = scalar.addf %negative_min_subnormal, %negative_min_subnormal : f32
  %positive_subtract = scalar.subf %positive_min_subnormal, %negative_min_subnormal : f32
  %negative_subtract = scalar.subf %negative_min_subnormal, %positive_min_subnormal : f32
  %positive_product = scalar.mulf %positive_min_normal, %quarter : f32
  %negative_product = scalar.mulf %negative_min_normal, %quarter : f32
  %positive_rounded = scalar.mulf %positive_round, %quarter : f32
  %negative_rounded = scalar.mulf %negative_round, %quarter : f32
  %positive_control = scalar.mulf %positive_one, %quarter : f32
  %negative_control = scalar.mulf %negative_one, %quarter : f32
  %positive_quotient = scalar.divf %positive_min_normal, %divisor : f32
  %negative_quotient = scalar.divf %negative_min_normal, %divisor : f32
  %positive_add_bits = scalar.bitcast %positive_add : f32 to i32
  %negative_add_bits = scalar.bitcast %negative_add : f32 to i32
  %positive_subtract_bits = scalar.bitcast %positive_subtract : f32 to i32
  %negative_subtract_bits = scalar.bitcast %negative_subtract : f32 to i32
  %positive_product_bits = scalar.bitcast %positive_product : f32 to i32
  %negative_product_bits = scalar.bitcast %negative_product : f32 to i32
  %positive_rounded_bits = scalar.bitcast %positive_rounded : f32 to i32
  %negative_rounded_bits = scalar.bitcast %negative_rounded : f32 to i32
  %positive_control_bits = scalar.bitcast %positive_control : f32 to i32
  %negative_control_bits = scalar.bitcast %negative_control : f32 to i32
  %positive_quotient_bits = scalar.bitcast %positive_quotient : f32 to i32
  %negative_quotient_bits = scalar.bitcast %negative_quotient : f32 to i32
  %origin = index.constant 0 : offset
  %results = buffer.view %output[%origin] : buffer -> view<12xi32>
  view.store %positive_add_bits, %results[0] : i32, view<12xi32>
  view.store %negative_add_bits, %results[1] : i32, view<12xi32>
  view.store %positive_subtract_bits, %results[2] : i32, view<12xi32>
  view.store %negative_subtract_bits, %results[3] : i32, view<12xi32>
  view.store %positive_product_bits, %results[4] : i32, view<12xi32>
  view.store %negative_product_bits, %results[5] : i32, view<12xi32>
  view.store %positive_rounded_bits, %results[6] : i32, view<12xi32>
  view.store %negative_rounded_bits, %results[7] : i32, view<12xi32>
  view.store %positive_control_bits, %results[8] : i32, view<12xi32>
  view.store %negative_control_bits, %results[9] : i32, view<12xi32>
  view.store %positive_quotient_bits, %results[10] : i32, view<12xi32>
  view.store %negative_quotient_bits, %results[11] : i32, view<12xi32>
  func.return
}

// Provides bit-exact results independently of target floating-point behavior.
func.def @scalar_f32_denormal_bits_oracle(%positive_min_subnormal_bits: i32, %negative_min_subnormal_bits: i32, %positive_min_normal_bits: i32, %negative_min_normal_bits: i32, %positive_round_bits: i32, %negative_round_bits: i32, %positive_one_bits: i32, %negative_one_bits: i32, %output: buffer) {
  %positive_two_subnormals = scalar.constant 2 : i32
  %negative_two_subnormals = scalar.constant -2147483646 : i32
  %positive_quarter_min_normal = scalar.constant 2097152 : i32
  %negative_quarter_min_normal = scalar.constant -2145386496 : i32
  %positive_min_normal = scalar.constant 8388608 : i32
  %negative_min_normal = scalar.constant -2139095040 : i32
  %positive_quarter = scalar.constant 1048576000 : i32
  %negative_quarter = scalar.constant -1098907648 : i32
  %origin = index.constant 0 : offset
  %results = buffer.view %output[%origin] : buffer -> view<12xi32>
  view.store %positive_two_subnormals, %results[0] : i32, view<12xi32>
  view.store %negative_two_subnormals, %results[1] : i32, view<12xi32>
  view.store %positive_two_subnormals, %results[2] : i32, view<12xi32>
  view.store %negative_two_subnormals, %results[3] : i32, view<12xi32>
  view.store %positive_quarter_min_normal, %results[4] : i32, view<12xi32>
  view.store %negative_quarter_min_normal, %results[5] : i32, view<12xi32>
  view.store %positive_min_normal, %results[6] : i32, view<12xi32>
  view.store %negative_min_normal, %results[7] : i32, view<12xi32>
  view.store %positive_quarter, %results[8] : i32, view<12xi32>
  view.store %negative_quarter, %results[9] : i32, view<12xi32>
  view.store %positive_quarter_min_normal, %results[10] : i32, view<12xi32>
  view.store %negative_quarter_min_normal, %results[11] : i32, view<12xi32>
  func.return
}

check.scenario @scalar_f32_denormal_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %positive_min_subnormal = check.literal value(1) : i32
    %negative_min_subnormal = check.literal value(-2147483647) : i32
    %positive_min_normal = check.literal value(8388608) : i32
    %negative_min_normal = check.literal value(-2139095040) : i32
    %positive_round = check.literal value(25165823) : i32
    %negative_round = check.literal value(-2122317825) : i32
    %positive_one = check.literal value(1065353216) : i32
    %negative_one = check.literal value(-1082130432) : i32
    %storage = check.generate.fill value(-559038737) : tensor<20xi32>
    %prefix = check.tensor.view %storage offset(0) : tensor<20xi32> -> tensor<4xi32>
    %output = check.tensor.view %storage offset(16) : tensor<20xi32> -> tensor<12xi32>
    %suffix = check.tensor.view %storage offset(64) : tensor<20xi32> -> tensor<4xi32>
    %guard = check.generate.fill value(-559038737) : tensor<4xi32>
    check.compare<@scalar_f32_denormal_observations, @scalar_f32_denormal_bits_oracle>(%positive_min_subnormal, %negative_min_subnormal, %positive_min_normal, %negative_min_normal, %positive_round, %negative_round, %positive_one, %negative_one, %output) : (i32, i32, i32, i32, i32, i32, i32, i32, tensor<12xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<12xi32>
      check.expect.bitwise actual(%prefix) expected(%guard) : tensor<4xi32>
      check.expect.bitwise actual(%suffix) expected(%guard) : tensor<4xi32>
    }
  }
  check.return
}

// Fused multiply-add has its own target contract and is kept separate so a
// target without exact FMA support still executes the ordinary arithmetic
// denormal scenario above.
func.def @scalar_f32_denormal_fma_observations(%positive_min_subnormal_bits: i32, %negative_min_subnormal_bits: i32, %positive_min_normal_bits: i32, %negative_min_normal_bits: i32, %quarter_bits: i32, %output: buffer) {
  %positive_min_subnormal = scalar.bitcast %positive_min_subnormal_bits : i32 to f32
  %negative_min_subnormal = scalar.bitcast %negative_min_subnormal_bits : i32 to f32
  %positive_min_normal = scalar.bitcast %positive_min_normal_bits : i32 to f32
  %negative_min_normal = scalar.bitcast %negative_min_normal_bits : i32 to f32
  %quarter = scalar.bitcast %quarter_bits : i32 to f32
  %quarter_literal_bits = scalar.constant 1048576000 : i32
  %quarter_literal = scalar.bitcast %quarter_literal_bits : i32 to f32
  %positive_min_subnormal_literal_bits = scalar.constant 1 : i32
  %positive_min_subnormal_literal = scalar.bitcast %positive_min_subnormal_literal_bits : i32 to f32
  %negative_min_subnormal_literal_bits = scalar.constant -2147483647 : i32
  %negative_min_subnormal_literal = scalar.bitcast %negative_min_subnormal_literal_bits : i32 to f32

  %positive_multiply_literal = scalar.fmaf %positive_min_normal, %quarter_literal, %positive_min_subnormal : f32
  %negative_multiply_literal = scalar.fmaf %negative_min_normal, %quarter_literal, %negative_min_subnormal : f32
  %positive_add_literal = scalar.fmaf %positive_min_normal, %quarter, %positive_min_subnormal_literal : f32
  %negative_add_literal = scalar.fmaf %negative_min_normal, %quarter, %negative_min_subnormal_literal : f32
  %positive_general = scalar.fmaf %positive_min_normal, %quarter, %positive_min_subnormal : f32
  %negative_general = scalar.fmaf %negative_min_normal, %quarter, %negative_min_subnormal : f32
  %positive_multiply_literal_bits = scalar.bitcast %positive_multiply_literal : f32 to i32
  %negative_multiply_literal_bits = scalar.bitcast %negative_multiply_literal : f32 to i32
  %positive_add_literal_bits = scalar.bitcast %positive_add_literal : f32 to i32
  %negative_add_literal_bits = scalar.bitcast %negative_add_literal : f32 to i32
  %positive_general_bits = scalar.bitcast %positive_general : f32 to i32
  %negative_general_bits = scalar.bitcast %negative_general : f32 to i32

  %origin = index.constant 0 : offset
  %results = buffer.view %output[%origin] : buffer -> view<6xi32>
  view.store %positive_multiply_literal_bits, %results[0] : i32, view<6xi32>
  view.store %negative_multiply_literal_bits, %results[1] : i32, view<6xi32>
  view.store %positive_add_literal_bits, %results[2] : i32, view<6xi32>
  view.store %negative_add_literal_bits, %results[3] : i32, view<6xi32>
  view.store %positive_general_bits, %results[4] : i32, view<6xi32>
  view.store %negative_general_bits, %results[5] : i32, view<6xi32>
  func.return
}

func.def @scalar_f32_denormal_fma_bits_oracle(%positive_min_subnormal_bits: i32, %negative_min_subnormal_bits: i32, %positive_min_normal_bits: i32, %negative_min_normal_bits: i32, %quarter_bits: i32, %output: buffer) {
  %positive_fused = scalar.constant 2097153 : i32
  %negative_fused = scalar.constant -2145386495 : i32
  %origin = index.constant 0 : offset
  %results = buffer.view %output[%origin] : buffer -> view<6xi32>
  view.store %positive_fused, %results[0] : i32, view<6xi32>
  view.store %negative_fused, %results[1] : i32, view<6xi32>
  view.store %positive_fused, %results[2] : i32, view<6xi32>
  view.store %negative_fused, %results[3] : i32, view<6xi32>
  view.store %positive_fused, %results[4] : i32, view<6xi32>
  view.store %negative_fused, %results[5] : i32, view<6xi32>
  func.return
}

check.scenario @scalar_f32_denormal_fma_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %positive_min_subnormal = check.literal value(1) : i32
    %negative_min_subnormal = check.literal value(-2147483647) : i32
    %positive_min_normal = check.literal value(8388608) : i32
    %negative_min_normal = check.literal value(-2139095040) : i32
    %quarter = check.literal value(1048576000) : i32
    %storage = check.generate.fill value(-559038737) : tensor<14xi32>
    %prefix = check.tensor.view %storage offset(0) : tensor<14xi32> -> tensor<4xi32>
    %output = check.tensor.view %storage offset(16) : tensor<14xi32> -> tensor<6xi32>
    %suffix = check.tensor.view %storage offset(40) : tensor<14xi32> -> tensor<4xi32>
    %guard = check.generate.fill value(-559038737) : tensor<4xi32>
    check.compare<@scalar_f32_denormal_fma_observations, @scalar_f32_denormal_fma_bits_oracle>(%positive_min_subnormal, %negative_min_subnormal, %positive_min_normal, %negative_min_normal, %quarter, %output) : (i32, i32, i32, i32, i32, tensor<6xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<6xi32>
      check.expect.bitwise actual(%prefix) expected(%guard) : tensor<4xi32>
      check.expect.bitwise actual(%suffix) expected(%guard) : tensor<4xi32>
    }
  }
  check.return
}
