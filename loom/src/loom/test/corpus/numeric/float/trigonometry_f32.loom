// Packed radian and turn operations retain distinct runtime lanes.
func.def @trigonometry_f32(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %source = buffer.view %input[%origin] : buffer -> view<8xf32>
  %destination = buffer.view %output[%origin] : buffer -> view<128xf32>
  %values = vector.load %source[0] : view<8xf32> -> vector<8xf32>
  %sinturnsf = vector.sinturnsf<afn> %values : vector<8xf32>
  vector.store %sinturnsf, %destination[0] : vector<8xf32>, view<128xf32>
  %costurnsf = vector.costurnsf<afn> %values : vector<8xf32>
  vector.store %costurnsf, %destination[8] : vector<8xf32>, view<128xf32>
  %sinf = vector.sinf<afn> %values : vector<8xf32>
  vector.store %sinf, %destination[16] : vector<8xf32>, view<128xf32>
  %cosf = vector.cosf<afn> %values : vector<8xf32>
  vector.store %cosf, %destination[24] : vector<8xf32>, view<128xf32>
  %preserved_sinturnsf = vector.sinturnsf<afn|preserve> %values : vector<8xf32>
  vector.store %preserved_sinturnsf, %destination[64] : vector<8xf32>, view<128xf32>
  %preserved_costurnsf = vector.costurnsf<afn|preserve> %values : vector<8xf32>
  vector.store %preserved_costurnsf, %destination[72] : vector<8xf32>, view<128xf32>
  %preserved_sinf = vector.sinf<afn|preserve> %values : vector<8xf32>
  vector.store %preserved_sinf, %destination[80] : vector<8xf32>, view<128xf32>
  %preserved_cosf = vector.cosf<afn|preserve> %values : vector<8xf32>
  vector.store %preserved_cosf, %destination[88] : vector<8xf32>, view<128xf32>
  %begin = index.constant 0 : index
  %end = index.constant 8 : index
  %step = index.constant 1 : index
  scf.for %position = [%begin to %end step %step] {
    %value = view.load %source[%position] : view<8xf32> -> f32
    %scalar_sinturnsf = scalar.sinturnsf<afn> %value : f32
    %base0 = index.constant 32 : index
    %offset0 = index.add %base0, %position : index
    view.store %scalar_sinturnsf, %destination[%offset0] : f32, view<128xf32>
    %scalar_costurnsf = scalar.costurnsf<afn> %value : f32
    %base1 = index.constant 40 : index
    %offset1 = index.add %base1, %position : index
    view.store %scalar_costurnsf, %destination[%offset1] : f32, view<128xf32>
    %scalar_sinf = scalar.sinf<afn> %value : f32
    %base2 = index.constant 48 : index
    %offset2 = index.add %base2, %position : index
    view.store %scalar_sinf, %destination[%offset2] : f32, view<128xf32>
    %scalar_cosf = scalar.cosf<afn> %value : f32
    %base3 = index.constant 56 : index
    %offset3 = index.add %base3, %position : index
    view.store %scalar_cosf, %destination[%offset3] : f32, view<128xf32>
    %preserved_scalar_sinturnsf = scalar.sinturnsf<afn|preserve> %value : f32
    %preserved_base0 = index.constant 96 : index
    %preserved_offset0 = index.add %preserved_base0, %position : index
    view.store %preserved_scalar_sinturnsf, %destination[%preserved_offset0] : f32, view<128xf32>
    %preserved_scalar_costurnsf = scalar.costurnsf<afn|preserve> %value : f32
    %preserved_base1 = index.constant 104 : index
    %preserved_offset1 = index.add %preserved_base1, %position : index
    view.store %preserved_scalar_costurnsf, %destination[%preserved_offset1] : f32, view<128xf32>
    %preserved_scalar_sinf = scalar.sinf<afn|preserve> %value : f32
    %preserved_base2 = index.constant 112 : index
    %preserved_offset2 = index.add %preserved_base2, %position : index
    view.store %preserved_scalar_sinf, %destination[%preserved_offset2] : f32, view<128xf32>
    %preserved_scalar_cosf = scalar.cosf<afn|preserve> %value : f32
    %preserved_base3 = index.constant 120 : index
    %preserved_offset3 = index.add %preserved_base3, %position : index
    view.store %preserved_scalar_cosf, %destination[%preserved_offset3] : f32, view<128xf32>
  }
  func.return
}

check.scenario @trigonometry_f32_values {
  check.trial[4](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-0.5 to 0.5) : tensor<8xf32>
    %output = check.generate.fill value(-99.0) : tensor<128xf32>
    check.compare<@trigonometry_f32>(%input, %output) : (tensor<8xf32>, tensor<128xf32>) -> () {
      check.expect.close actual(%output) expected(%output) atol(9.9999999999999995e-07) rtol(0.0) nan(same) : tensor<128xf32>
    }
  }
  check.return
}

check.scenario @trigonometry_f32_cardinals {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-1.0) step(0.25) : tensor<8xf32>
    %output = check.generate.fill value(-99.0) : tensor<128xf32>
    %vector_turns = check.tensor.view %output offset(256) : tensor<128xf32> -> tensor<16xf32>
    %scalar_turns = check.tensor.view %output offset(384) : tensor<128xf32> -> tensor<16xf32>
    %native_vector_turns = check.tensor.view %output offset(0) : tensor<128xf32> -> tensor<16xf32>
    %native_scalar_turns = check.tensor.view %output offset(128) : tensor<128xf32> -> tensor<16xf32>
    check.compare<@trigonometry_f32>(%input, %output) : (tensor<8xf32>, tensor<128xf32>) -> () {
      check.expect.close actual(%output) expected(%output) atol(9.9999999999999995e-07) rtol(0.0) nan(same) : tensor<128xf32>
      check.expect.bitwise actual(%vector_turns) expected(%vector_turns) : tensor<16xf32>
      check.expect.bitwise actual(%scalar_turns) expected(%scalar_turns) : tensor<16xf32>
      check.expect.close actual(%native_vector_turns) expected(%native_vector_turns) atol(0.0) rtol(0.0) nan(same) : tensor<16xf32>
      check.expect.close actual(%native_scalar_turns) expected(%native_scalar_turns) atol(0.0) rtol(0.0) nan(same) : tensor<16xf32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-8388612.0) step(1.0) : tensor<8xf32>
    %output = check.generate.fill value(-99.0) : tensor<128xf32>
    %vector_turns = check.tensor.view %output offset(256) : tensor<128xf32> -> tensor<16xf32>
    %scalar_turns = check.tensor.view %output offset(384) : tensor<128xf32> -> tensor<16xf32>
    %native_vector_turns = check.tensor.view %output offset(0) : tensor<128xf32> -> tensor<16xf32>
    %native_scalar_turns = check.tensor.view %output offset(128) : tensor<128xf32> -> tensor<16xf32>
    check.compare<@trigonometry_f32>(%input, %output) : (tensor<8xf32>, tensor<128xf32>) -> () {
      check.expect.bitwise actual(%vector_turns) expected(%vector_turns) : tensor<16xf32>
      check.expect.bitwise actual(%scalar_turns) expected(%scalar_turns) : tensor<16xf32>
      check.expect.close actual(%native_vector_turns) expected(%native_vector_turns) atol(0.0) rtol(0.0) nan(same) : tensor<16xf32>
      check.expect.close actual(%native_scalar_turns) expected(%native_scalar_turns) atol(0.0) rtol(0.0) nan(same) : tensor<16xf32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(-3.4028234663852886e+38) : tensor<8xf32>
    %output = check.generate.fill value(-99.0) : tensor<128xf32>
    %vector_turns = check.tensor.view %output offset(256) : tensor<128xf32> -> tensor<16xf32>
    %scalar_turns = check.tensor.view %output offset(384) : tensor<128xf32> -> tensor<16xf32>
    %native_vector_turns = check.tensor.view %output offset(0) : tensor<128xf32> -> tensor<16xf32>
    %native_scalar_turns = check.tensor.view %output offset(128) : tensor<128xf32> -> tensor<16xf32>
    check.compare<@trigonometry_f32>(%input, %output) : (tensor<8xf32>, tensor<128xf32>) -> () {
      check.expect.bitwise actual(%vector_turns) expected(%vector_turns) : tensor<16xf32>
      check.expect.bitwise actual(%scalar_turns) expected(%scalar_turns) : tensor<16xf32>
      check.expect.close actual(%native_vector_turns) expected(%native_vector_turns) atol(0.0) rtol(0.0) nan(same) : tensor<16xf32>
      check.expect.close actual(%native_scalar_turns) expected(%native_scalar_turns) atol(0.0) rtol(0.0) nan(same) : tensor<16xf32>
    }
  }
  check.return
}

check.scenario @trigonometry_f32_special {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(-0.0) : tensor<8xf32>
    %output = check.generate.fill value(-99.0) : tensor<128xf32>
    %preserved = check.tensor.view %output offset(256) : tensor<128xf32> -> tensor<64xf32>
    check.compare<@trigonometry_f32>(%input, %output) : (tensor<8xf32>, tensor<128xf32>) -> () {
      check.expect.close actual(%output) expected(%output) atol(0.0) rtol(0.0) nan(same) : tensor<128xf32>
      check.expect.bitwise actual(%preserved) expected(%preserved) : tensor<64xf32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(nan) : tensor<8xf32>
    %output = check.generate.fill value(-99.0) : tensor<128xf32>
    check.compare<@trigonometry_f32>(%input, %output) : (tensor<8xf32>, tensor<128xf32>) -> () {
      check.expect.close actual(%output) expected(%output) atol(9.9999999999999995e-07) rtol(0.0) nan(same) : tensor<128xf32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(inf) : tensor<8xf32>
    %output = check.generate.fill value(-99.0) : tensor<128xf32>
    check.compare<@trigonometry_f32>(%input, %output) : (tensor<8xf32>, tensor<128xf32>) -> () {
      check.expect.close actual(%output) expected(%output) atol(9.9999999999999995e-07) rtol(0.0) nan(same) : tensor<128xf32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(-inf) : tensor<8xf32>
    %output = check.generate.fill value(-99.0) : tensor<128xf32>
    check.compare<@trigonometry_f32>(%input, %output) : (tensor<8xf32>, tensor<128xf32>) -> () {
      check.expect.close actual(%output) expected(%output) atol(9.9999999999999995e-07) rtol(0.0) nan(same) : tensor<128xf32>
    }
  }
  check.return
}
