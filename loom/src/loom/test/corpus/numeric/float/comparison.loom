    %forward = check.generate.fill value(-1) : tensor<14xi32>
    %reverse = check.generate.fill value(-1) : tensor<14xi32>
    %uniform = check.generate.fill value(-1) : tensor<14xi32>
    check.compare<@compare_double_sources>(%trial, %lhs, %rhs, %forward, %reverse, %uniform) : (index, tensor<4xi64>, tensor<4xi64>, tensor<14xi32>, tensor<14xi32>, tensor<14xi32>) -> () {
      check.expect.bitwise actual(%forward) expected(%forward) : tensor<14xi32>
      check.expect.bitwise actual(%reverse) expected(%reverse) : tensor<14xi32>
      check.expect.bitwise actual(%uniform) expected(%uniform) : tensor<14xi32>
    }
  }
  check.return
}
