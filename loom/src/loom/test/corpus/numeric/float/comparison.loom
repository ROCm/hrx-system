  view.store %ole_word, %results[4] : i32, view<14xi32>
  %one = scalar.cmpf one, %lhs, %rhs : f64
  %one_word = scalar.extui %one : i1 to i32
  view.store %one_word, %results[5] : i32, view<14xi32>
  %ord = scalar.cmpf ord, %lhs, %rhs : f64
  %ord_word = scalar.extui %ord : i1 to i32
  view.store %ord_word, %results[6] : i32, view<14xi32>
  %ueq = scalar.cmpf ueq, %lhs, %rhs : f64
  %ueq_word = scalar.extui %ueq : i1 to i32
  view.store %ueq_word, %results[7] : i32, view<14xi32>
  %ugt = scalar.cmpf ugt, %lhs, %rhs : f64
  %ugt_word = scalar.extui %ugt : i1 to i32
  view.store %ugt_word, %results[8] : i32, view<14xi32>
  %uge = scalar.cmpf uge, %lhs, %rhs : f64
  %uge_word = scalar.extui %uge : i1 to i32
  view.store %uge_word, %results[9] : i32, view<14xi32>
  %ult = scalar.cmpf ult, %lhs, %rhs : f64
  %ult_word = scalar.extui %ult : i1 to i32
  view.store %ult_word, %results[10] : i32, view<14xi32>
  %ule = scalar.cmpf ule, %lhs, %rhs : f64
  %ule_word = scalar.extui %ule : i1 to i32
  view.store %ule_word, %results[11] : i32, view<14xi32>
  %une = scalar.cmpf une, %lhs, %rhs : f64
  %une_word = scalar.extui %une : i1 to i32
  view.store %une_word, %results[12] : i32, view<14xi32>
  %uno = scalar.cmpf uno, %lhs, %rhs : f64
  %uno_word = scalar.extui %uno : i1 to i32
  view.store %uno_word, %results[13] : i32, view<14xi32>
  func.return
}

func.def @compare_half_sources(%ordinal: index, %lhs: buffer, %rhs: buffer, %forward: buffer, %reverse: buffer, %uniform: buffer) {
  %base = index.constant 0 : offset
  %position = index.assume %ordinal [range(%ordinal, 0, 3)] : index
  %constant_lhs = buffer.assume.memory_space<constant> %lhs : buffer
  %constant_rhs = buffer.assume.memory_space<constant> %rhs : buffer
  %left_view = buffer.view %constant_lhs[%base] : buffer -> view<4xi32>
  %right_view = buffer.view %rhs[%base] : buffer -> view<4xi32>
  %uniform_right_view = buffer.view %constant_rhs[%base] : buffer -> view<4xi32>
  %left_word = view.load %left_view[%position] : view<4xi32> -> i32
  %right_word = view.load %right_view[%position] : view<4xi32> -> i32
  %uniform_right_word = view.load %uniform_right_view[%position] : view<4xi32> -> i32
  %left_bits = scalar.trunci %left_word : i32 to i16
  %right_bits = scalar.trunci %right_word : i32 to i16
  %uniform_right_bits = scalar.trunci %uniform_right_word : i32 to i16
  %left = scalar.bitcast %left_bits : i16 to f16
  %right = scalar.bitcast %right_bits : i16 to f16
  %uniform_right = scalar.bitcast %uniform_right_bits : i16 to f16
  func.call @compare_half_predicates(%left, %right, %forward) : (f16, f16, buffer)
  func.call @compare_half_predicates(%right, %left, %reverse) : (f16, f16, buffer)
  func.call @compare_half_predicates(%left, %uniform_right, %uniform) : (f16, f16, buffer)
  func.return
}

func.def @compare_float_sources(%ordinal: index, %lhs: buffer, %rhs: buffer, %forward: buffer, %reverse: buffer, %uniform: buffer) {
  %base = index.constant 0 : offset
  %position = index.assume %ordinal [range(%ordinal, 0, 3)] : index
  %constant_lhs = buffer.assume.memory_space<constant> %lhs : buffer
  %constant_rhs = buffer.assume.memory_space<constant> %rhs : buffer
  %left_view = buffer.view %constant_lhs[%base] : buffer -> view<4xf32>
  %right_view = buffer.view %rhs[%base] : buffer -> view<4xf32>
  %uniform_right_view = buffer.view %constant_rhs[%base] : buffer -> view<4xf32>
  %left = view.load %left_view[%position] : view<4xf32> -> f32
  %right = view.load %right_view[%position] : view<4xf32> -> f32
  %uniform_right = view.load %uniform_right_view[%position] : view<4xf32> -> f32
  func.call @compare_float_predicates(%left, %right, %forward) : (f32, f32, buffer)
  func.call @compare_float_predicates(%right, %left, %reverse) : (f32, f32, buffer)
  func.call @compare_float_predicates(%left, %uniform_right, %uniform) : (f32, f32, buffer)
  func.return
}

func.def @compare_double_sources(%ordinal: index, %lhs: buffer, %rhs: buffer, %forward: buffer, %reverse: buffer, %uniform: buffer) {
  %base = index.constant 0 : offset
  %position = index.assume %ordinal [range(%ordinal, 0, 3)] : index
  %constant_lhs = buffer.assume.memory_space<constant> %lhs : buffer
  %constant_rhs = buffer.assume.memory_space<constant> %rhs : buffer
  %left_view = buffer.view %constant_lhs[%base] : buffer -> view<4xi64>
  %right_view = buffer.view %rhs[%base] : buffer -> view<4xi64>
  %uniform_right_view = buffer.view %constant_rhs[%base] : buffer -> view<4xi64>
  %left_bits = view.load %left_view[%position] : view<4xi64> -> i64
  %right_bits = view.load %right_view[%position] : view<4xi64> -> i64
  %uniform_right_bits = view.load %uniform_right_view[%position] : view<4xi64> -> i64
  %left = scalar.bitcast %left_bits : i64 to f64
  %right = scalar.bitcast %right_bits : i64 to f64
  %uniform_right = scalar.bitcast %uniform_right_bits : i64 to f64
  func.call @compare_double_predicates(%left, %right, %forward) : (f64, f64, buffer)
  func.call @compare_double_predicates(%right, %left, %reverse) : (f64, f64, buffer)
  func.call @compare_double_predicates(%left, %uniform_right, %uniform) : (f64, f64, buffer)
  func.return
}

// Directed groups cover signed zero, subnormal signs, adjacent negatives,
// finite/infinite boundaries, and signaling/quiet NaNs of both signs.
check.scenario @scalar_half_comparison_sources {
  check.trial[4](%trial: index, %entropy: check.entropy) {
    %lhs = check.generate.iota offset(-32768) step(1) : tensor<4xi32>
    %rhs = check.generate.iota offset(65536) step(1) : tensor<4xi32>
    %forward = check.generate.fill value(-1) : tensor<14xi32>
    %reverse = check.generate.fill value(-1) : tensor<14xi32>
    %uniform = check.generate.fill value(-1) : tensor<14xi32>
    check.compare<@compare_half_sources>(%trial, %lhs, %rhs, %forward, %reverse, %uniform) : (index, tensor<4xi32>, tensor<4xi32>, tensor<14xi32>, tensor<14xi32>, tensor<14xi32>) -> () {
      check.expect.bitwise actual(%forward) expected(%forward) : tensor<14xi32>
      check.expect.bitwise actual(%reverse) expected(%reverse) : tensor<14xi32>
      check.expect.bitwise actual(%uniform) expected(%uniform) : tensor<14xi32>
    }
  }
  check.trial[4](%trial: index, %entropy: check.entropy) {
    %lhs = check.generate.iota offset(48128) step(1) : tensor<4xi32>
    %rhs = check.generate.iota offset(48129) step(1) : tensor<4xi32>
    %forward = check.generate.fill value(-1) : tensor<14xi32>
    %reverse = check.generate.fill value(-1) : tensor<14xi32>
    %uniform = check.generate.fill value(-1) : tensor<14xi32>
    check.compare<@compare_half_sources>(%trial, %lhs, %rhs, %forward, %reverse, %uniform) : (index, tensor<4xi32>, tensor<4xi32>, tensor<14xi32>, tensor<14xi32>, tensor<14xi32>) -> () {
      check.expect.bitwise actual(%forward) expected(%forward) : tensor<14xi32>
      check.expect.bitwise actual(%reverse) expected(%reverse) : tensor<14xi32>
      check.expect.bitwise actual(%uniform) expected(%uniform) : tensor<14xi32>
    }
  }
  check.trial[4](%trial: index, %entropy: check.entropy) {
    %lhs = check.generate.iota offset(31743) step(1) : tensor<4xi32>
    %rhs = check.generate.iota offset(31746) step(-1) : tensor<4xi32>
    %forward = check.generate.fill value(-1) : tensor<14xi32>
    %reverse = check.generate.fill value(-1) : tensor<14xi32>
    %uniform = check.generate.fill value(-1) : tensor<14xi32>
    check.compare<@compare_half_sources>(%trial, %lhs, %rhs, %forward, %reverse, %uniform) : (index, tensor<4xi32>, tensor<4xi32>, tensor<14xi32>, tensor<14xi32>, tensor<14xi32>) -> () {
      check.expect.bitwise actual(%forward) expected(%forward) : tensor<14xi32>
      check.expect.bitwise actual(%reverse) expected(%reverse) : tensor<14xi32>
      check.expect.bitwise actual(%uniform) expected(%uniform) : tensor<14xi32>
    }
  }
  check.trial[4](%trial: index, %entropy: check.entropy) {
    %lhs = check.generate.iota offset(65023) step(1) : tensor<4xi32>
    %rhs = check.generate.iota offset(32258) step(-1) : tensor<4xi32>
    %forward = check.generate.fill value(-1) : tensor<14xi32>
    %reverse = check.generate.fill value(-1) : tensor<14xi32>
    %uniform = check.generate.fill value(-1) : tensor<14xi32>
    check.compare<@compare_half_sources>(%trial, %lhs, %rhs, %forward, %reverse, %uniform) : (index, tensor<4xi32>, tensor<4xi32>, tensor<14xi32>, tensor<14xi32>, tensor<14xi32>) -> () {
      check.expect.bitwise actual(%forward) expected(%forward) : tensor<14xi32>
      check.expect.bitwise actual(%reverse) expected(%reverse) : tensor<14xi32>
      check.expect.bitwise actual(%uniform) expected(%uniform) : tensor<14xi32>
    }
  }
  check.return
}

