// Every predicate observes raw IEEE inputs. Constant and ordinary loads keep
// uniform and varying sources distinct through the native comparison boundary.
func.def inline @compare_half_predicates(%lhs: f16, %rhs: f16, %output: buffer) {
  %base = index.constant 0 : offset
  %results = buffer.view %output[%base] : buffer -> view<14xi32>
  %oeq = scalar.cmpf oeq, %lhs, %rhs : f16
  %oeq_word = scalar.extui %oeq : i1 to i32
  view.store %oeq_word, %results[0] : i32, view<14xi32>
  %ogt = scalar.cmpf ogt, %lhs, %rhs : f16
  %ogt_word = scalar.extui %ogt : i1 to i32
  view.store %ogt_word, %results[1] : i32, view<14xi32>
  %oge = scalar.cmpf oge, %lhs, %rhs : f16
  %oge_word = scalar.extui %oge : i1 to i32
  view.store %oge_word, %results[2] : i32, view<14xi32>
  %olt = scalar.cmpf olt, %lhs, %rhs : f16
  %olt_word = scalar.extui %olt : i1 to i32
  view.store %olt_word, %results[3] : i32, view<14xi32>
  %ole = scalar.cmpf ole, %lhs, %rhs : f16
  %ole_word = scalar.extui %ole : i1 to i32
  view.store %ole_word, %results[4] : i32, view<14xi32>
  %one = scalar.cmpf one, %lhs, %rhs : f16
  %one_word = scalar.extui %one : i1 to i32
  view.store %one_word, %results[5] : i32, view<14xi32>
  %ord = scalar.cmpf ord, %lhs, %rhs : f16
  %ord_word = scalar.extui %ord : i1 to i32
  view.store %ord_word, %results[6] : i32, view<14xi32>
  %ueq = scalar.cmpf ueq, %lhs, %rhs : f16
  %ueq_word = scalar.extui %ueq : i1 to i32
  view.store %ueq_word, %results[7] : i32, view<14xi32>
  %ugt = scalar.cmpf ugt, %lhs, %rhs : f16
  %ugt_word = scalar.extui %ugt : i1 to i32
  view.store %ugt_word, %results[8] : i32, view<14xi32>
  %uge = scalar.cmpf uge, %lhs, %rhs : f16
  %uge_word = scalar.extui %uge : i1 to i32
  view.store %uge_word, %results[9] : i32, view<14xi32>
  %ult = scalar.cmpf ult, %lhs, %rhs : f16
  %ult_word = scalar.extui %ult : i1 to i32
  view.store %ult_word, %results[10] : i32, view<14xi32>
  %ule = scalar.cmpf ule, %lhs, %rhs : f16
  %ule_word = scalar.extui %ule : i1 to i32
  view.store %ule_word, %results[11] : i32, view<14xi32>
  %une = scalar.cmpf une, %lhs, %rhs : f16
  %une_word = scalar.extui %une : i1 to i32
  view.store %une_word, %results[12] : i32, view<14xi32>
  %uno = scalar.cmpf uno, %lhs, %rhs : f16
  %uno_word = scalar.extui %uno : i1 to i32
  view.store %uno_word, %results[13] : i32, view<14xi32>
  func.return
}

