// FP8 math is checked through native f32 evaluation and result rounding.

func.def @trigonometry_f8e5m2(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %source = buffer.view %input[%origin] : buffer -> view<8xf8E5M2>
  %destination = buffer.view %output[%origin] : buffer -> view<64xf32>
  %values = vector.load %source[0] : view<8xf8E5M2> -> vector<8xf8E5M2>
  %sinturnsf = vector.sinturnsf<afn|preserve> %values : vector<8xf8E5M2>
  %sinturnsf_wide = vector.extf %sinturnsf : vector<8xf8E5M2> to vector<8xf32>
  vector.store %sinturnsf_wide, %destination[0] : vector<8xf32>, view<64xf32>
  %costurnsf = vector.costurnsf<afn|preserve> %values : vector<8xf8E5M2>
  %costurnsf_wide = vector.extf %costurnsf : vector<8xf8E5M2> to vector<8xf32>
  vector.store %costurnsf_wide, %destination[8] : vector<8xf32>, view<64xf32>
  %sinf = vector.sinf<afn|preserve> %values : vector<8xf8E5M2>
  %sinf_wide = vector.extf %sinf : vector<8xf8E5M2> to vector<8xf32>
  vector.store %sinf_wide, %destination[16] : vector<8xf32>, view<64xf32>
  %cosf = vector.cosf<afn|preserve> %values : vector<8xf8E5M2>
  %cosf_wide = vector.extf %cosf : vector<8xf8E5M2> to vector<8xf32>
  vector.store %cosf_wide, %destination[24] : vector<8xf32>, view<64xf32>
  %begin = index.constant 0 : index
  %end = index.constant 8 : index
  %step = index.constant 1 : index
  scf.for %position = [%begin to %end step %step] {
    %value = view.load %source[%position] : view<8xf8E5M2> -> f8E5M2
    %scalar_sinturnsf = scalar.sinturnsf<afn|preserve> %value : f8E5M2
    %scalar_sinturnsf_wide = scalar.extf %scalar_sinturnsf : f8E5M2 to f32
    %base0 = index.constant 32 : index
    %offset0 = index.add %base0, %position : index
    view.store %scalar_sinturnsf_wide, %destination[%offset0] : f32, view<64xf32>
    %scalar_costurnsf = scalar.costurnsf<afn|preserve> %value : f8E5M2
    %scalar_costurnsf_wide = scalar.extf %scalar_costurnsf : f8E5M2 to f32
    %base1 = index.constant 40 : index
    %offset1 = index.add %base1, %position : index
    view.store %scalar_costurnsf_wide, %destination[%offset1] : f32, view<64xf32>
    %scalar_sinf = scalar.sinf<afn|preserve> %value : f8E5M2
    %scalar_sinf_wide = scalar.extf %scalar_sinf : f8E5M2 to f32
    %base2 = index.constant 48 : index
    %offset2 = index.add %base2, %position : index
    view.store %scalar_sinf_wide, %destination[%offset2] : f32, view<64xf32>
    %scalar_cosf = scalar.cosf<afn|preserve> %value : f8E5M2
    %scalar_cosf_wide = scalar.extf %scalar_cosf : f8E5M2 to f32
    %base3 = index.constant 56 : index
    %offset3 = index.add %base3, %position : index
    view.store %scalar_cosf_wide, %destination[%offset3] : f32, view<64xf32>
  }
  func.return
}

func.def @trigonometry_f8e5m2_oracle(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %source = buffer.view %input[%origin] : buffer -> view<8xf8E5M2>
  %destination = buffer.view %output[%origin] : buffer -> view<64xf32>
  %begin = index.constant 0 : index
  %end = index.constant 8 : index
  %step = index.constant 1 : index
  scf.for %position = [%begin to %end step %step] {
    %value = view.load %source[%position] : view<8xf8E5M2> -> f8E5M2
    %wide = scalar.extf %value : f8E5M2 to f32
    %sinturnsf = scalar.sinturnsf<afn|preserve> %wide : f32
    %sinturnsf_rounded = scalar.fptrunc %sinturnsf : f32 to f8E5M2
    %sinturnsf_observed = scalar.extf %sinturnsf_rounded : f8E5M2 to f32
    %vector_base0 = index.constant 0 : index
    %vector_offset0 = index.add %vector_base0, %position : index
    %scalar_base0 = index.constant 32 : index
    %scalar_offset0 = index.add %scalar_base0, %position : index
    view.store %sinturnsf_observed, %destination[%vector_offset0] : f32, view<64xf32>
    view.store %sinturnsf_observed, %destination[%scalar_offset0] : f32, view<64xf32>
    %costurnsf = scalar.costurnsf<afn|preserve> %wide : f32
    %costurnsf_rounded = scalar.fptrunc %costurnsf : f32 to f8E5M2
    %costurnsf_observed = scalar.extf %costurnsf_rounded : f8E5M2 to f32
    %vector_base1 = index.constant 8 : index
    %vector_offset1 = index.add %vector_base1, %position : index
    %scalar_base1 = index.constant 40 : index
    %scalar_offset1 = index.add %scalar_base1, %position : index
    view.store %costurnsf_observed, %destination[%vector_offset1] : f32, view<64xf32>
    view.store %costurnsf_observed, %destination[%scalar_offset1] : f32, view<64xf32>
    %sinf = scalar.sinf<afn|preserve> %wide : f32
    %sinf_rounded = scalar.fptrunc %sinf : f32 to f8E5M2
    %sinf_observed = scalar.extf %sinf_rounded : f8E5M2 to f32
    %vector_base2 = index.constant 16 : index
    %vector_offset2 = index.add %vector_base2, %position : index
    %scalar_base2 = index.constant 48 : index
    %scalar_offset2 = index.add %scalar_base2, %position : index
    view.store %sinf_observed, %destination[%vector_offset2] : f32, view<64xf32>
    view.store %sinf_observed, %destination[%scalar_offset2] : f32, view<64xf32>
    %cosf = scalar.cosf<afn|preserve> %wide : f32
    %cosf_rounded = scalar.fptrunc %cosf : f32 to f8E5M2
    %cosf_observed = scalar.extf %cosf_rounded : f8E5M2 to f32
    %vector_base3 = index.constant 24 : index
    %vector_offset3 = index.add %vector_base3, %position : index
    %scalar_base3 = index.constant 56 : index
    %scalar_offset3 = index.add %scalar_base3, %position : index
    view.store %cosf_observed, %destination[%vector_offset3] : f32, view<64xf32>
    view.store %cosf_observed, %destination[%scalar_offset3] : f32, view<64xf32>
  }
  func.return
}

check.scenario @trigonometry_f8e5m2_values {
  check.trial[4](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-0.5 to 0.5) : tensor<8xf8E5M2>
    %output = check.generate.fill value(-99.0) : tensor<64xf32>
    check.compare<@trigonometry_f8e5m2, @trigonometry_f8e5m2_oracle>(%input, %output) : (tensor<8xf8E5M2>, tensor<64xf32>) -> () {
      check.expect.close actual(%output) expected(%output) atol(0.25) rtol(0.0) nan(same) : tensor<64xf32>
    }
  }
  check.return
}

check.scenario @trigonometry_f8e5m2_cardinals {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-1.0) step(0.25) : tensor<8xf8E5M2>
    %output = check.generate.fill value(-99.0) : tensor<64xf32>
    %vector_turns = check.tensor.view %output offset(0) : tensor<64xf32> -> tensor<16xf32>
    %scalar_turns = check.tensor.view %output offset(128) : tensor<64xf32> -> tensor<16xf32>
    check.compare<@trigonometry_f8e5m2, @trigonometry_f8e5m2_oracle>(%input, %output) : (tensor<8xf8E5M2>, tensor<64xf32>) -> () {
      check.expect.close actual(%output) expected(%output) atol(0.25) rtol(0.0) nan(same) : tensor<64xf32>
      check.expect.bitwise actual(%vector_turns) expected(%vector_turns) : tensor<16xf32>
      check.expect.bitwise actual(%scalar_turns) expected(%scalar_turns) : tensor<16xf32>
    }
  }
  check.return
}

check.scenario @trigonometry_f8e5m2_special {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(-0.0) : tensor<8xf8E5M2>
    %output = check.generate.fill value(-99.0) : tensor<64xf32>
    check.compare<@trigonometry_f8e5m2, @trigonometry_f8e5m2_oracle>(%input, %output) : (tensor<8xf8E5M2>, tensor<64xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<64xf32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(nan) : tensor<8xf8E5M2>
    %output = check.generate.fill value(-99.0) : tensor<64xf32>
    check.compare<@trigonometry_f8e5m2, @trigonometry_f8e5m2_oracle>(%input, %output) : (tensor<8xf8E5M2>, tensor<64xf32>) -> () {
      check.expect.close actual(%output) expected(%output) atol(0.25) rtol(0.0) nan(same) : tensor<64xf32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(inf) : tensor<8xf8E5M2>
    %output = check.generate.fill value(-99.0) : tensor<64xf32>
    check.compare<@trigonometry_f8e5m2, @trigonometry_f8e5m2_oracle>(%input, %output) : (tensor<8xf8E5M2>, tensor<64xf32>) -> () {
      check.expect.close actual(%output) expected(%output) atol(0.25) rtol(0.0) nan(same) : tensor<64xf32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(-inf) : tensor<8xf8E5M2>
    %output = check.generate.fill value(-99.0) : tensor<64xf32>
    check.compare<@trigonometry_f8e5m2, @trigonometry_f8e5m2_oracle>(%input, %output) : (tensor<8xf8E5M2>, tensor<64xf32>) -> () {
      check.expect.close actual(%output) expected(%output) atol(0.25) rtol(0.0) nan(same) : tensor<64xf32>
    }
  }
  check.return
}
