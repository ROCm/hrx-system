    vector.store %floor_bits, %results[1, %i] : vector<4xi32>, view<5x32xi32>
    %roundeven = vector.roundevenf %value : vector<4xf32>
    %roundeven_bits = func.call @rounding_f32_vector_bits(%roundeven) : (vector<4xf32>) -> (vector<4xi32>)
    vector.store %roundeven_bits, %results[2, %i] : vector<4xi32>, view<5x32xi32>
    %round = vector.roundf %value : vector<4xf32>
    %round_bits = func.call @rounding_f32_vector_bits(%round) : (vector<4xf32>) -> (vector<4xi32>)
    vector.store %round_bits, %results[3, %i] : vector<4xi32>, view<5x32xi32>
    %trunc = vector.truncf %value : vector<4xf32>
    %trunc_bits = func.call @rounding_f32_vector_bits(%trunc) : (vector<4xf32>) -> (vector<4xi32>)
    vector.store %trunc_bits, %results[4, %i] : vector<4xi32>, view<5x32xi32>
  }
  func.return
}

