    view.store %ceil, %results[5, %i] : i64, view<10x32xi64>
    view.store %floor, %results[6, %i] : i64, view<10x32xi64>
    view.store %roundeven, %results[7, %i] : i64, view<10x32xi64>
    view.store %round, %results[8, %i] : i64, view<10x32xi64>
    view.store %trunc, %results[9, %i] : i64, view<10x32xi64>
  }
  func.return
}

