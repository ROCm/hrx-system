    %value = vector.load %source[%i] : view<32xf32> -> vector<4xf32>
    %ceil = vector.ceilf %value : vector<4xf32>
    %ceil_bits = func.call @rounding_f32_vector_bits(%ceil) : (vector<4xf32>) -> (vector<4xi32>)
    vector.store %ceil_bits, %results[0, %i] : vector<4xi32>, view<5x32xi32>
    %floor = vector.floorf %value : vector<4xf32>
