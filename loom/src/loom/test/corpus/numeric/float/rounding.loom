func.def @rounding_f32_inputs(%input: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<32xi32>
  %signed_zero = scalar.constant 0 : i32
  %min_subnormal = scalar.constant 1 : i32
  %max_subnormal = scalar.constant 8388607 : i32
  %min_normal = scalar.constant 8388608 : i32
  %before_half = scalar.constant 1056964607 : i32
  %half = scalar.constant 1056964608 : i32
  %after_half = scalar.constant 1056964609 : i32
  %before_one = scalar.constant 1065353215 : i32
  %unity_bits = scalar.constant 1065353216 : i32
  %after_one = scalar.constant 1065353217 : i32
  %odd_half = scalar.constant 1069547520 : i32
  %even_half = scalar.constant 1075838976 : i32
  %last_fractional = scalar.constant 1258291199 : i32
  %first_integral = scalar.constant 1258291200 : i32
  %infinity_or_max = scalar.constant 2139095040 : i32
  %nan = scalar.constant 2143289344 : i32
  %positive = vector.from_elements %signed_zero, %min_subnormal, %max_subnormal, %min_normal, %before_half, %half, %after_half, %before_one, %unity_bits, %after_one, %odd_half, %even_half, %last_fractional, %first_integral, %infinity_or_max, %nan : vector<16xi32>
  %sign = vector.splati -2147483648 : vector<16xi32>
  %negative = vector.xori %positive, %sign : vector<16xi32>
  vector.store %positive, %source[0] : vector<16xi32>, view<32xi32>
  vector.store %negative, %source[16] : vector<16xi32>, view<32xi32>
  func.return
}

check.scenario @rounding_f32_vector_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(0) : tensor<32xi32>
    check.generate<@rounding_f32_inputs>(%input) : (tensor<32xi32>) -> ()
    %output = check.generate.fill value(-1) : tensor<5x32xi32>
    check.compare<@rounding_f32_vector_observations, @rounding_f32_vector_oracle>(%input, %output) : (tensor<32xi32>, tensor<5x32xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<5x32xi32>
    }
  }
  check.return
}

