    view.store %ceil, %results[0, %i] : i32, view<10x32xi32>
    view.store %floor, %results[1, %i] : i32, view<10x32xi32>
    view.store %roundeven, %results[2, %i] : i32, view<10x32xi32>
    view.store %round, %results[3, %i] : i32, view<10x32xi32>
    view.store %trunc, %results[4, %i] : i32, view<10x32xi32>
    view.store %ceil, %results[5, %i] : i32, view<10x32xi32>
    view.store %floor, %results[6, %i] : i32, view<10x32xi32>
    view.store %roundeven, %results[7, %i] : i32, view<10x32xi32>
    view.store %round, %results[8, %i] : i32, view<10x32xi32>
    view.store %trunc, %results[9, %i] : i32, view<10x32xi32>
  }
  func.return
}

func.def @rounding_f32_inputs(%input: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<32xi32>
  %positive = vector.constanti [0, 1, 8388607, 8388608, 1056964607, 1056964608, 1056964609, 1065353215, 1065353216, 1065353217, 1069547520, 1075838976, 1258291199, 1258291200, 2139095040, 2143289344] : vector<16xi32>
  %sign = vector.splati -2147483648 : vector<16xi32>
  %negative = vector.xori %positive, %sign : vector<16xi32>
  vector.store %positive, %source[0] : vector<16xi32>, view<32xi32>
  vector.store %negative, %source[16] : vector<16xi32>, view<32xi32>
  func.return
}

check.scenario @rounding_f32_vector_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(0) : tensor<32xi32>
    check.generate<@rounding_f32_inputs>(%input) : (tensor<32xi32>) -> ()
    %output = check.generate.fill value(-1) : tensor<10x32xi32>
    check.compare<@rounding_f32_vector_observations, @rounding_f32_vector_oracle>(%input, %output) : (tensor<32xi32>, tensor<10x32xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<10x32xi32>
    }
  }
  check.trial[64](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-2147483648 to 2147483647) : tensor<32xi32>
    %output = check.generate.fill value(-1) : tensor<10x32xi32>
    check.compare<@rounding_f32_vector_observations, @rounding_f32_vector_oracle>(%input, %output) : (tensor<32xi32>, tensor<10x32xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<10x32xi32>
    }
  }
  check.return
}

func.def @rounding_f64_vector_observations(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<32xf64>
  %results = buffer.view %output[%base] : buffer -> view<10x32xi64>
  %begin = index.constant 0 : index
