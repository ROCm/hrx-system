    vector.store %trunc_bits, %results[4, %i] : vector<4xi32>, view<10x32xi32>
  }
  %scalar_step = index.constant 1 : index
  scf.for %i = [%begin to %end step %scalar_step] {
    %value = view.load %source[%i] : view<32xbf16> -> bf16
    %ceil = scalar.ceilf %value : bf16
    %wide_ceil = scalar.extf %ceil : bf16 to f32
    %ceil_bits = func.call @rounding_f32_result_bits(%wide_ceil) : (f32) -> (i32)
    view.store %ceil_bits, %results[5, %i] : i32, view<10x32xi32>
    %floor = scalar.floorf %value : bf16
    %wide_floor = scalar.extf %floor : bf16 to f32
