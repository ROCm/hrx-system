// An irregular packet exercises native chunks and a final single-lane carrier.
func.def @rounding_f32_tail(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %source = buffer.view %input[%origin] : buffer -> view<19xf32>
  %results = buffer.view %output[%origin] : buffer -> view<5x19xf32>
  %value = vector.load %source[0] : view<19xf32> -> vector<19xf32>
  %ceil = vector.ceilf %value : vector<19xf32>
  %floor = vector.floorf %value : vector<19xf32>
  %trunc = vector.truncf %value : vector<19xf32>
  %even = vector.roundevenf %value : vector<19xf32>
  %away = vector.roundf %value : vector<19xf32>
  vector.store %ceil, %results[0, 0] : vector<19xf32>, view<5x19xf32>
  vector.store %floor, %results[1, 0] : vector<19xf32>, view<5x19xf32>
  vector.store %trunc, %results[2, 0] : vector<19xf32>, view<5x19xf32>
  vector.store %even, %results[3, 0] : vector<19xf32>, view<5x19xf32>
  vector.store %away, %results[4, 0] : vector<19xf32>, view<5x19xf32>
  func.return
}

check.scenario @rounding_f32_tail_values {
  check.trial[16](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-16.0 to 16.0) : tensor<19xf32>
    %output = check.generate.fill value(0.0) : tensor<5x19xf32>
    check.compare<@rounding_f32_tail>(%input, %output) : (tensor<19xf32>, tensor<5x19xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<5x19xf32>
    }
  }
  check.return
}
