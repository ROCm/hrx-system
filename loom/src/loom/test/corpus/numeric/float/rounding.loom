// Exact integral rounding at signed zero, subnormal, halfway, and last-
// fractional-exponent boundaries. Each format runs 16 magnitudes with both
// signs. Scalar reference evaluation checks vector target realization; NaNs
// retain their classification while allowing target-selected payloads.

func.def inline @rounding_f32_result_bits(%value: f32) -> (i32) {
  %bits = scalar.bitcast %value : f32 to i32
  %is_nan = scalar.isnanf %value : f32
  %nan_bits = scalar.constant 2143289344 : i32
  %observed = scf.select %is_nan, %nan_bits, %bits : i32
  func.return %observed : i32
}

func.def inline @rounding_f32_vector_bits(%value: vector<4xf32>) -> (vector<4xi32>) {
  %bits = vector.bitcast %value : vector<4xf32> to vector<4xi32>
  %is_nan = vector.isnanf %value : vector<4xf32> -> vector<4xi1>
  %nan_word = scalar.constant 2143289344 : i32
  %nan_bits = vector.splat %nan_word : vector<4xi32>
  %observed = vector.select %is_nan, %nan_bits, %bits : vector<4xi32>
  func.return %observed : vector<4xi32>
}

func.def @rounding_f32_observations(%bits: i32) -> (i32, i32, i32, i32, i32) {
  %value = scalar.bitcast %bits : i32 to f32
  %ceil = scalar.ceilf %value : f32
  %ceil_bits = func.call @rounding_f32_result_bits(%ceil) : (f32) -> (i32)
  %floor = scalar.floorf %value : f32
  %floor_bits = func.call @rounding_f32_result_bits(%floor) : (f32) -> (i32)
  %roundeven = scalar.roundevenf %value : f32
  %roundeven_bits = func.call @rounding_f32_result_bits(%roundeven) : (f32) -> (i32)
  %round = scalar.roundf %value : f32
  %round_bits = func.call @rounding_f32_result_bits(%round) : (f32) -> (i32)
  %trunc = scalar.truncf %value : f32
  %trunc_bits = func.call @rounding_f32_result_bits(%trunc) : (f32) -> (i32)
  func.return %ceil_bits, %floor_bits, %roundeven_bits, %round_bits, %trunc_bits : i32, i32, i32, i32, i32
}

func.def inline @rounding_f64_result_bits(%value: f64) -> (i64) {
  %bits = scalar.bitcast %value : f64 to i64
  %is_nan = scalar.isnanf %value : f64
  %nan_bits = scalar.constant 9221120237041090560 : i64
  %observed = scf.select %is_nan, %nan_bits, %bits : i64
  func.return %observed : i64
}

func.def @rounding_f64_observations(%bits: i64) -> (i64, i64, i64, i64, i64) {
  %value = scalar.bitcast %bits : i64 to f64
  %ceil = scalar.ceilf %value : f64
  %ceil_bits = func.call @rounding_f64_result_bits(%ceil) : (f64) -> (i64)
  %floor = scalar.floorf %value : f64
  %floor_bits = func.call @rounding_f64_result_bits(%floor) : (f64) -> (i64)
  %roundeven = scalar.roundevenf %value : f64
  %roundeven_bits = func.call @rounding_f64_result_bits(%roundeven) : (f64) -> (i64)
  %round = scalar.roundf %value : f64
  %round_bits = func.call @rounding_f64_result_bits(%round) : (f64) -> (i64)
  %trunc = scalar.truncf %value : f64
  %trunc_bits = func.call @rounding_f64_result_bits(%trunc) : (f64) -> (i64)
  func.return %ceil_bits, %floor_bits, %roundeven_bits, %round_bits, %trunc_bits : i64, i64, i64, i64, i64
}

// Narrow boundary encodings travel through runtime buffers, not constants.
// Widening rounded outputs is exact and reuses the F32 observation boundary:
// finite values and zero signs compare bitwise, while NaNs retain their class.
func.def @rounding_f16_observations(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<32xf16>
  %results = buffer.view %output[%base] : buffer -> view<5x32xi32>
  %begin = index.constant 0 : index
  %end = index.constant 32 : index
  %step = index.constant 4 : index
  scf.for %i = [%begin to %end step %step] {
    %value = vector.load %source[%i] : view<32xf16> -> vector<4xf16>
    %ceil = vector.ceilf %value : vector<4xf16>
    %floor = vector.floorf %value : vector<4xf16>
    %roundeven = vector.roundevenf %value : vector<4xf16>
    %round = vector.roundf %value : vector<4xf16>
    %trunc = vector.truncf %value : vector<4xf16>
    %wide_ceil = vector.extf %ceil : vector<4xf16> to vector<4xf32>
    %wide_floor = vector.extf %floor : vector<4xf16> to vector<4xf32>
    %wide_roundeven = vector.extf %roundeven : vector<4xf16> to vector<4xf32>
    %wide_round = vector.extf %round : vector<4xf16> to vector<4xf32>
    %wide_trunc = vector.extf %trunc : vector<4xf16> to vector<4xf32>
    %ceil_bits = func.call @rounding_f32_vector_bits(%wide_ceil) : (vector<4xf32>) -> (vector<4xi32>)
    %floor_bits = func.call @rounding_f32_vector_bits(%wide_floor) : (vector<4xf32>) -> (vector<4xi32>)
    %roundeven_bits = func.call @rounding_f32_vector_bits(%wide_roundeven) : (vector<4xf32>) -> (vector<4xi32>)
    %round_bits = func.call @rounding_f32_vector_bits(%wide_round) : (vector<4xf32>) -> (vector<4xi32>)
    %trunc_bits = func.call @rounding_f32_vector_bits(%wide_trunc) : (vector<4xf32>) -> (vector<4xi32>)
    vector.store %ceil_bits, %results[0, %i] : vector<4xi32>, view<5x32xi32>
    vector.store %floor_bits, %results[1, %i] : vector<4xi32>, view<5x32xi32>
    vector.store %roundeven_bits, %results[2, %i] : vector<4xi32>, view<5x32xi32>
    vector.store %round_bits, %results[3, %i] : vector<4xi32>, view<5x32xi32>
    vector.store %trunc_bits, %results[4, %i] : vector<4xi32>, view<5x32xi32>
  }
  func.return
}

func.def @rounding_f16_inputs(%input: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<32xi16>
  %signed_zero = scalar.constant 0 : i16
  %min_subnormal = scalar.constant 1 : i16
  %max_subnormal = scalar.constant 1023 : i16
  %min_normal = scalar.constant 1024 : i16
  %before_half = scalar.constant 14335 : i16
  %half = scalar.constant 14336 : i16
  %after_half = scalar.constant 14337 : i16
  %before_one = scalar.constant 15359 : i16
  %unity_bits = scalar.constant 15360 : i16
  %after_one = scalar.constant 15361 : i16
  %odd_half = scalar.constant 15872 : i16
  %even_half = scalar.constant 16640 : i16
  %last_fractional = scalar.constant 25599 : i16
  %first_integral = scalar.constant 25600 : i16
  %infinity_or_max = scalar.constant 31744 : i16
  %nan = scalar.constant 32256 : i16
  %positive = vector.from_elements %signed_zero, %min_subnormal, %max_subnormal, %min_normal, %before_half, %half, %after_half, %before_one, %unity_bits, %after_one, %odd_half, %even_half, %last_fractional, %first_integral, %infinity_or_max, %nan : vector<16xi16>
  %sign = vector.splati -32768 : vector<16xi16>
  %negative = vector.xori %positive, %sign : vector<16xi16>
  vector.store %positive, %source[0] : vector<16xi16>, view<32xi16>
  vector.store %negative, %source[16] : vector<16xi16>, view<32xi16>
  func.return
}

check.scenario @rounding_f16_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(0) : tensor<32xi16>
    check.generate<@rounding_f16_inputs>(%input) : (tensor<32xi16>) -> ()
    %output = check.generate.fill value(-1) : tensor<5x32xi32>
    check.compare<@rounding_f16_observations, @rounding_f16_oracle>(%input, %output) : (tensor<32xi16>, tensor<5x32xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<5x32xi32>
    }
  }
  check.return
}

