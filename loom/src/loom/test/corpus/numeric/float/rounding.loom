    view.store %floor_bits, %results[6, %i] : i32, view<10x256xi32>
    %roundeven = scalar.roundevenf %value : f8E5M2
    %wide_roundeven = scalar.extf %roundeven : f8E5M2 to f32
    %roundeven_bits = func.call @rounding_f32_result_bits(%wide_roundeven) : (f32) -> (i32)
    view.store %roundeven_bits, %results[7, %i] : i32, view<10x256xi32>
    %round = scalar.roundf %value : f8E5M2
    %wide_round = scalar.extf %round : f8E5M2 to f32
    %round_bits = func.call @rounding_f32_result_bits(%wide_round) : (f32) -> (i32)
    view.store %round_bits, %results[8, %i] : i32, view<10x256xi32>
    %trunc = scalar.truncf %value : f8E5M2
    %wide_trunc = scalar.extf %trunc : f8E5M2 to f32
    %trunc_bits = func.call @rounding_f32_result_bits(%wide_trunc) : (f32) -> (i32)
    view.store %trunc_bits, %results[9, %i] : i32, view<10x256xi32>
  }
  func.return
}

check.scenario @rounding_f8e5m2_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-128) step(1) : tensor<256xi8>
    %output = check.generate.fill value(-1) : tensor<10x256xi32>
    check.compare<@rounding_f8e5m2_observations, @rounding_f8e5m2_oracle>(%input, %output) : (tensor<256xi8>, tensor<10x256xi32>) -> () {
