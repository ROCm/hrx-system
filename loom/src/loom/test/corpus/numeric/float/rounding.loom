func.def inline @rounding_f64_vector_bits(%value: vector<4xf64>) -> (vector<4xi64>) {
  %bits = vector.bitcast %value : vector<4xf64> to vector<4xi64>
  %is_nan = vector.isnanf %value : vector<4xf64> -> vector<4xi1>
  %nan_word = scalar.constant 9221120237041090560 : i64
  %nan_bits = vector.splat %nan_word : vector<4xi64>
  %observed = vector.select %is_nan, %nan_bits, %bits : vector<4xi64>
  func.return %observed : vector<4xi64>
}

func.def @rounding_f32_vector_observations(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<32xf32>
  %results = buffer.view %output[%base] : buffer -> view<10x32xi32>
  %begin = index.constant 0 : index
  %end = index.constant 32 : index
  %step = index.constant 4 : index
  scf.for %i = [%begin to %end step %step] {
    %value = vector.load %source[%i] : view<32xf32> -> vector<4xf32>
    %ceil = vector.ceilf %value : vector<4xf32>
    %ceil_bits = func.call @rounding_f32_vector_bits(%ceil) : (vector<4xf32>) -> (vector<4xi32>)
    vector.store %ceil_bits, %results[0, %i] : vector<4xi32>, view<10x32xi32>
    %floor = vector.floorf %value : vector<4xf32>
    %floor_bits = func.call @rounding_f32_vector_bits(%floor) : (vector<4xf32>) -> (vector<4xi32>)
    vector.store %floor_bits, %results[1, %i] : vector<4xi32>, view<10x32xi32>
    %roundeven = vector.roundevenf %value : vector<4xf32>
    %roundeven_bits = func.call @rounding_f32_vector_bits(%roundeven) : (vector<4xf32>) -> (vector<4xi32>)
    vector.store %roundeven_bits, %results[2, %i] : vector<4xi32>, view<10x32xi32>
    %round = vector.roundf %value : vector<4xf32>
    %round_bits = func.call @rounding_f32_vector_bits(%round) : (vector<4xf32>) -> (vector<4xi32>)
    vector.store %round_bits, %results[3, %i] : vector<4xi32>, view<10x32xi32>
    %trunc = vector.truncf %value : vector<4xf32>
    %trunc_bits = func.call @rounding_f32_vector_bits(%trunc) : (vector<4xf32>) -> (vector<4xi32>)
    vector.store %trunc_bits, %results[4, %i] : vector<4xi32>, view<10x32xi32>
  }
  %scalar_step = index.constant 1 : index
  scf.for %i = [%begin to %end step %scalar_step] {
    %value = view.load %source[%i] : view<32xf32> -> f32
    %bits = scalar.bitcast %value : f32 to i32
    %ceil, %floor, %roundeven, %round, %trunc = func.call @rounding_f32_observations(%bits) : (i32) -> (i32, i32, i32, i32, i32)
    view.store %ceil, %results[5, %i] : i32, view<10x32xi32>
    view.store %floor, %results[6, %i] : i32, view<10x32xi32>
    view.store %roundeven, %results[7, %i] : i32, view<10x32xi32>
    view.store %round, %results[8, %i] : i32, view<10x32xi32>
    view.store %trunc, %results[9, %i] : i32, view<10x32xi32>
  }
  func.return
}

func.def @rounding_f32_vector_oracle(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<32xi32>
  %results = buffer.view %output[%base] : buffer -> view<10x32xi32>
