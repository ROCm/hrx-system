    vector.store %floor_bits, %results[1, %i] : vector<4xi64>, view<10x32xi64>
    %roundeven = vector.roundevenf %value : vector<4xf64>
    %roundeven_bits = func.call @rounding_f64_vector_bits(%roundeven) : (vector<4xf64>) -> (vector<4xi64>)
    vector.store %roundeven_bits, %results[2, %i] : vector<4xi64>, view<10x32xi64>
    %round = vector.roundf %value : vector<4xf64>
    %round_bits = func.call @rounding_f64_vector_bits(%round) : (vector<4xf64>) -> (vector<4xi64>)
    vector.store %round_bits, %results[3, %i] : vector<4xi64>, view<10x32xi64>
    %trunc = vector.truncf %value : vector<4xf64>
    %trunc_bits = func.call @rounding_f64_vector_bits(%trunc) : (vector<4xf64>) -> (vector<4xi64>)
    vector.store %trunc_bits, %results[4, %i] : vector<4xi64>, view<10x32xi64>
  }
  %scalar_step = index.constant 1 : index
  scf.for %i = [%begin to %end step %scalar_step] {
    %value = view.load %source[%i] : view<32xf64> -> f64
    %bits = scalar.bitcast %value : f64 to i64
