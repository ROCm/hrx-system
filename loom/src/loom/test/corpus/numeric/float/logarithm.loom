func.def @logarithm_bf16_inputs(%input: buffer) {
  %origin = index.constant 0 : offset
  %destination = buffer.view %input[%origin] : buffer -> view<32xi16>
  %bits = vector.constanti [0, -32768, 1, -32767, 127, 128, 129, 16255, 16256, 16257, -16513, -16512, -16511, 16180, 16181, 16182, 16308, 16309, 16310, 32639, 32640, -128, 32704, -64, 32641, -127, 15232, 15231, 15233, -17536, -17537, -17535] : vector<32xi16>
  vector.store %bits, %destination[0] : vector<32xi16>, view<32xi16>
  func.return
}

