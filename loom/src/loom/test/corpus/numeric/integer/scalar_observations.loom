// Packs every signed and unsigned ordering of two predicates into a word.
func.def inline @predicate_comparison_mask(%lhs: i1, %rhs: i1) -> (i32) {
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %c3 = scalar.constant 3 : i32
  %c4 = scalar.constant 4 : i32
  %c5 = scalar.constant 5 : i32
  %c6 = scalar.constant 6 : i32
  %c7 = scalar.constant 7 : i32
  %c8 = scalar.constant 8 : i32
  %c9 = scalar.constant 9 : i32
  %eq = scalar.cmpi eq, %lhs, %rhs : i1
  %ne = scalar.cmpi ne, %lhs, %rhs : i1
  %slt = scalar.cmpi slt, %lhs, %rhs : i1
  %sle = scalar.cmpi sle, %lhs, %rhs : i1
  %sgt = scalar.cmpi sgt, %lhs, %rhs : i1
  %sge = scalar.cmpi sge, %lhs, %rhs : i1
  %ult = scalar.cmpi ult, %lhs, %rhs : i1
  %ule = scalar.cmpi ule, %lhs, %rhs : i1
  %ugt = scalar.cmpi ugt, %lhs, %rhs : i1
  %uge = scalar.cmpi uge, %lhs, %rhs : i1
  %eq_bit = scalar.extui %eq : i1 to i32
  %ne_bit = scalar.extui %ne : i1 to i32
  %slt_bit = scalar.extui %slt : i1 to i32
  %sle_bit = scalar.extui %sle : i1 to i32
  %sgt_bit = scalar.extui %sgt : i1 to i32
  %sge_bit = scalar.extui %sge : i1 to i32
  %ult_bit = scalar.extui %ult : i1 to i32
  %ule_bit = scalar.extui %ule : i1 to i32
  %ugt_bit = scalar.extui %ugt : i1 to i32
  %uge_bit = scalar.extui %uge : i1 to i32
  %ne_shifted = scalar.shli %ne_bit, %c1 : i32
  %slt_shifted = scalar.shli %slt_bit, %c2 : i32
  %sle_shifted = scalar.shli %sle_bit, %c3 : i32
  %sgt_shifted = scalar.shli %sgt_bit, %c4 : i32
  %sge_shifted = scalar.shli %sge_bit, %c5 : i32
  %ult_shifted = scalar.shli %ult_bit, %c6 : i32
  %ule_shifted = scalar.shli %ule_bit, %c7 : i32
  %ugt_shifted = scalar.shli %ugt_bit, %c8 : i32
  %uge_shifted = scalar.shli %uge_bit, %c9 : i32
  %mask1 = scalar.ori %eq_bit, %ne_shifted : i32
  %mask2 = scalar.ori %mask1, %slt_shifted : i32
  %mask3 = scalar.ori %mask2, %sle_shifted : i32
  %mask4 = scalar.ori %mask3, %sgt_shifted : i32
  %mask5 = scalar.ori %mask4, %sge_shifted : i32
  %mask6 = scalar.ori %mask5, %ult_shifted : i32
  %mask7 = scalar.ori %mask6, %ule_shifted : i32
  %mask8 = scalar.ori %mask7, %ugt_shifted : i32
  %mask9 = scalar.ori %mask8, %uge_shifted : i32
  func.return %mask9 : i32
}

// Packs every signed and unsigned ordering of two coordinates into a word.
func.def inline @index_comparison_mask(%lhs: index, %rhs: index) -> (i32) {
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %c3 = scalar.constant 3 : i32
  %c4 = scalar.constant 4 : i32
  %c5 = scalar.constant 5 : i32
  %c6 = scalar.constant 6 : i32
  %c7 = scalar.constant 7 : i32
  %c8 = scalar.constant 8 : i32
  %c9 = scalar.constant 9 : i32
  %eq = index.cmp eq, %lhs, %rhs : index
  %ne = index.cmp ne, %lhs, %rhs : index
  %slt = index.cmp slt, %lhs, %rhs : index
  %sle = index.cmp sle, %lhs, %rhs : index
  %sgt = index.cmp sgt, %lhs, %rhs : index
  %sge = index.cmp sge, %lhs, %rhs : index
  %ult = index.cmp ult, %lhs, %rhs : index
  %ule = index.cmp ule, %lhs, %rhs : index
  %ugt = index.cmp ugt, %lhs, %rhs : index
  %uge = index.cmp uge, %lhs, %rhs : index
  %eq_bit = scalar.extui %eq : i1 to i32
  %ne_bit = scalar.extui %ne : i1 to i32
  %slt_bit = scalar.extui %slt : i1 to i32
  %sle_bit = scalar.extui %sle : i1 to i32
  %sgt_bit = scalar.extui %sgt : i1 to i32
  %sge_bit = scalar.extui %sge : i1 to i32
  %ult_bit = scalar.extui %ult : i1 to i32
  %ule_bit = scalar.extui %ule : i1 to i32
  %ugt_bit = scalar.extui %ugt : i1 to i32
  %uge_bit = scalar.extui %uge : i1 to i32
  %ne_shifted = scalar.shli %ne_bit, %c1 : i32
  %slt_shifted = scalar.shli %slt_bit, %c2 : i32
  %sle_shifted = scalar.shli %sle_bit, %c3 : i32
  %sgt_shifted = scalar.shli %sgt_bit, %c4 : i32
  %sge_shifted = scalar.shli %sge_bit, %c5 : i32
  %ult_shifted = scalar.shli %ult_bit, %c6 : i32
  %ule_shifted = scalar.shli %ule_bit, %c7 : i32
  %ugt_shifted = scalar.shli %ugt_bit, %c8 : i32
  %uge_shifted = scalar.shli %uge_bit, %c9 : i32
  %mask1 = scalar.ori %eq_bit, %ne_shifted : i32
  %mask2 = scalar.ori %mask1, %slt_shifted : i32
  %mask3 = scalar.ori %mask2, %sle_shifted : i32
  %mask4 = scalar.ori %mask3, %sgt_shifted : i32
  %mask5 = scalar.ori %mask4, %sge_shifted : i32
  %mask6 = scalar.ori %mask5, %ult_shifted : i32
  %mask7 = scalar.ori %mask6, %ule_shifted : i32
  %mask8 = scalar.ori %mask7, %ugt_shifted : i32
  %mask9 = scalar.ori %mask8, %uge_shifted : i32
  func.return %mask9 : i32
}

// Packs every signed and unsigned ordering of two byte offsets into a word.
func.def inline @offset_comparison_mask(%lhs: offset, %rhs: offset) -> (i32) {
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %c3 = scalar.constant 3 : i32
  %c4 = scalar.constant 4 : i32
  %c5 = scalar.constant 5 : i32
  %c6 = scalar.constant 6 : i32
  %c7 = scalar.constant 7 : i32
  %c8 = scalar.constant 8 : i32
  %c9 = scalar.constant 9 : i32
  %eq = index.cmp eq, %lhs, %rhs : offset
  %ne = index.cmp ne, %lhs, %rhs : offset
  %slt = index.cmp slt, %lhs, %rhs : offset
  %sle = index.cmp sle, %lhs, %rhs : offset
  %sgt = index.cmp sgt, %lhs, %rhs : offset
  %sge = index.cmp sge, %lhs, %rhs : offset
  %ult = index.cmp ult, %lhs, %rhs : offset
  %ule = index.cmp ule, %lhs, %rhs : offset
  %ugt = index.cmp ugt, %lhs, %rhs : offset
  %uge = index.cmp uge, %lhs, %rhs : offset
  %eq_bit = scalar.extui %eq : i1 to i32
  %ne_bit = scalar.extui %ne : i1 to i32
  %slt_bit = scalar.extui %slt : i1 to i32
  %sle_bit = scalar.extui %sle : i1 to i32
  %sgt_bit = scalar.extui %sgt : i1 to i32
  %sge_bit = scalar.extui %sge : i1 to i32
  %ult_bit = scalar.extui %ult : i1 to i32
  %ule_bit = scalar.extui %ule : i1 to i32
  %ugt_bit = scalar.extui %ugt : i1 to i32
  %uge_bit = scalar.extui %uge : i1 to i32
  %ne_shifted = scalar.shli %ne_bit, %c1 : i32
  %slt_shifted = scalar.shli %slt_bit, %c2 : i32
  %sle_shifted = scalar.shli %sle_bit, %c3 : i32
  %sgt_shifted = scalar.shli %sgt_bit, %c4 : i32
  %sge_shifted = scalar.shli %sge_bit, %c5 : i32
  %ult_shifted = scalar.shli %ult_bit, %c6 : i32
  %ule_shifted = scalar.shli %ule_bit, %c7 : i32
  %ugt_shifted = scalar.shli %ugt_bit, %c8 : i32
  %uge_shifted = scalar.shli %uge_bit, %c9 : i32
  %mask1 = scalar.ori %eq_bit, %ne_shifted : i32
  %mask2 = scalar.ori %mask1, %slt_shifted : i32
  %mask3 = scalar.ori %mask2, %sle_shifted : i32
  %mask4 = scalar.ori %mask3, %sgt_shifted : i32
  %mask5 = scalar.ori %mask4, %sge_shifted : i32
  %mask6 = scalar.ori %mask5, %ult_shifted : i32
  %mask7 = scalar.ori %mask6, %ule_shifted : i32
  %mask8 = scalar.ori %mask7, %ugt_shifted : i32
  %mask9 = scalar.ori %mask8, %uge_shifted : i32
  func.return %mask9 : i32
}

// Keeps arithmetic inside the common 32-bit address domain. Comparisons retain
// the full i32 payload so signed and unsigned orderings diverge.
func.def @portable_index_arithmetic_observations(%lhs_bits: i64, %rhs_bits: i64, %output: buffer) {
  %c1_i32 = scalar.constant 1 : i32
  %c1023_i32 = scalar.constant 1023 : i32
  %c65535_i32 = scalar.constant 65535 : i32
  %positive_mask = scalar.constant 2147483647 : i32
  %base = index.constant 0 : offset
  %results = buffer.view %output[%base] : buffer -> view<13xi32>

  %lhs_word = scalar.trunci %lhs_bits : i64 to i32
  %rhs_word = scalar.trunci %rhs_bits : i64 to i32
  %small_bits = scalar.andi %lhs_word, %c65535_i32 : i32
  %divisor_bits0 = scalar.andi %rhs_word, %c1023_i32 : i32
  %divisor_bits = scalar.ori %divisor_bits0, %c1_i32 : i32
  %lhs = index.cast %small_bits : i32 to index
  %rhs0 = index.cast %divisor_bits : i32 to index
  %rhs = index.assume %rhs0 [range(%rhs0, 1, 1023)] : index
  %lhs_offset = index.cast %small_bits : i32 to offset
  %rhs_offset = index.cast %divisor_bits : i32 to offset
  %comparison_lhs = index.cast %lhs_word : i32 to index
  %comparison_rhs = index.cast %rhs_word : i32 to index
  %comparison_lhs_offset_bits = scalar.andi %lhs_word, %positive_mask : i32
  %comparison_rhs_offset_bits = scalar.andi %rhs_word, %positive_mask : i32
  %comparison_lhs_offset = index.cast %comparison_lhs_offset_bits : i32 to offset
  %comparison_rhs_offset = index.cast %comparison_rhs_offset_bits : i32 to offset

  %add = index.add %lhs, %rhs : index
  %sub = index.sub %lhs, %rhs : index
  %mul = index.mul %lhs, %rhs : index
  %div = index.div %lhs, %rhs : index
  %rem = index.rem %lhs, %rhs : index
  %minimum = index.min %lhs, %rhs : index
  %maximum = index.max %lhs, %rhs : index
  %madd = index.madd %lhs, %rhs, %sub : index
  %scaled = index.scale %lhs, %rhs_offset : index, offset -> offset
  %offset_add = index.add %lhs_offset, %rhs_offset : offset
  %offset_sub = index.sub %lhs_offset, %rhs_offset : offset
  %index_comparisons = func.call @index_comparison_mask(%comparison_lhs, %comparison_rhs) : (index, index) -> (i32)
  %offset_comparisons = func.call @offset_comparison_mask(%comparison_lhs_offset, %comparison_rhs_offset) : (offset, offset) -> (i32)

  %add_word = index.cast %add : index to i32
  %sub_word = index.cast %sub : index to i32
  %mul_word = index.cast %mul : index to i32
  %div_word = index.cast %div : index to i32
  %rem_word = index.cast %rem : index to i32
  %minimum_word = index.cast %minimum : index to i32
  %maximum_word = index.cast %maximum : index to i32
  %madd_word = index.cast %madd : index to i32
  %scaled_word = index.cast %scaled : offset to i32
  %offset_add_word = index.cast %offset_add : offset to i32
  %offset_sub_word = index.cast %offset_sub : offset to i32
  %observations = vector.from_elements %add_word, %sub_word, %mul_word, %div_word, %rem_word, %minimum_word, %maximum_word, %madd_word, %scaled_word, %offset_add_word, %offset_sub_word, %index_comparisons, %offset_comparisons : vector<13xi32>
  vector.store %observations, %results[0] : vector<13xi32>, view<13xi32>
  func.return
}

check.scenario @portable_index_arithmetic_values {
  check.trial[256](%trial: index, %entropy: check.entropy) {
    %lhs_entropy = check.entropy.fork %entropy name("lhs") : check.entropy
    %rhs_entropy = check.entropy.fork %entropy name("rhs") : check.entropy
    %lhs_bits = check.entropy.read %lhs_entropy[%trial] : check.entropy -> i64
    %rhs_bits = check.entropy.read %rhs_entropy[%trial] : check.entropy -> i64
    %storage = check.generate.fill value(-123) : tensor<21xi32>
    %prefix = check.tensor.view %storage offset(0) : tensor<21xi32> -> tensor<4xi32>
    %output = check.tensor.view %storage offset(16) : tensor<21xi32> -> tensor<13xi32>
    %suffix = check.tensor.view %storage offset(68) : tensor<21xi32> -> tensor<4xi32>
    %guard = check.generate.fill value(-123) : tensor<4xi32>
    check.compare<@portable_index_arithmetic_observations>(%lhs_bits, %rhs_bits, %output) : (i64, i64, tensor<13xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<13xi32>
      check.expect.bitwise actual(%prefix) expected(%guard) : tensor<4xi32>
      check.expect.bitwise actual(%suffix) expected(%guard) : tensor<4xi32>
    }
  }
  check.return
}

// Rotates use a single-bit payload so their result is independent of the target
// carrier width. Leading counts are observed as the occupied width, and
// trailing counts are capped at 32 so a zero input is portable too.
func.def @portable_index_bitwise_observations(%ordinal: index, %lhs_bits: i64, %rhs_bits: i64, %output: buffer) {
  %c65535_i32 = scalar.constant 65535 : i32
  %c1_index = index.constant 1 : index
  %c31_index = index.constant 31 : index
  %c32_index = index.constant 32 : index
  %base = index.constant 0 : offset
  %results = buffer.view %output[%base] : buffer -> view<17xi32>

  %bounded_ordinal = index.assume %ordinal [range(%ordinal, 0, 255)] : index
  %lhs_word = scalar.trunci %lhs_bits : i64 to i32
  %rhs_word = scalar.trunci %rhs_bits : i64 to i32
  %lhs_bits32 = scalar.andi %lhs_word, %c65535_i32 : i32
  %rhs_bits32 = scalar.andi %rhs_word, %c65535_i32 : i32
  %lhs = index.cast %lhs_bits32 : i32 to index
  %rhs = index.cast %rhs_bits32 : i32 to index
  %amount0 = index.rem %bounded_ordinal, %c32_index : index
  %amount = index.assume %amount0 [range(%amount0, 0, 31)] : index

  %and = index.andi %lhs, %rhs : index
  %or = index.ori %lhs, %rhs : index
  %xor = index.xori %lhs, %rhs : index
  %left = index.shli %lhs, %amount : index
  %signed_right = index.shrsi %lhs, %amount : index
  %unsigned_right = index.shrui %lhs, %amount : index
  %rotated_left = index.rotli %c1_index, %amount : index
  %rotated_right_source = index.shli %c1_index, %amount : index
  %rotated_right = index.rotri %rotated_right_source, %amount : index
  %top_count = index.ctlzi %c1_index : index
  %top_bit = index.shli %c1_index, %top_count : index
  %normalized_leading = index.ctlzi %top_bit : index
  %carrier_width = index.add %top_count, %c1_index : index
  %ordinal_leading = index.ctlzi %bounded_ordinal : index
  %ordinal_width = index.sub %carrier_width, %ordinal_leading : index
  %ordinal_trailing = index.cttzi %bounded_ordinal : index
  %bounded_trailing = index.min %ordinal_trailing, %c32_index : index
  %trailing = index.cttzi %rotated_left : index
  %population = index.ctpopi %or : index
  // The scalar payload arguments use vector registers on GPU targets. The
  // first trial supplies zero to both count operations without constant folding.
  %varying_bits = index.mul %lhs, %bounded_ordinal : index
  %varying_leading = index.ctlzi %varying_bits : index
  %varying_width = index.sub %carrier_width, %varying_leading : index
  %varying_trailing = index.cttzi %varying_bits : index
  %varying_bounded_trailing = index.min %varying_trailing, %c32_index : index
  %varying_amount = index.andi %rhs, %c31_index : index
  %varying_rotated_left = index.rotli %c1_index, %varying_amount : index
  %varying_right_source = index.shli %c1_index, %varying_amount : index
  %varying_rotated_right = index.rotri %varying_right_source, %varying_amount : index

  %and_word = index.cast %and : index to i32
  %or_word = index.cast %or : index to i32
  %xor_word = index.cast %xor : index to i32
  %left_word = index.cast %left : index to i32
  %signed_right_word = index.cast %signed_right : index to i32
  %unsigned_right_word = index.cast %unsigned_right : index to i32
  %rotated_left_word = index.cast %rotated_left : index to i32
  %rotated_right_word = index.cast %rotated_right : index to i32
  %normalized_leading_word = index.cast %normalized_leading : index to i32
  %trailing_word = index.cast %trailing : index to i32
  %population_word = index.cast %population : index to i32
  %ordinal_width_word = index.cast %ordinal_width : index to i32
  %bounded_trailing_word = index.cast %bounded_trailing : index to i32
  %varying_width_word = index.cast %varying_width : index to i32
  %varying_trailing_word = index.cast %varying_bounded_trailing : index to i32
  %varying_left_word = index.cast %varying_rotated_left : index to i32
  %varying_right_word = index.cast %varying_rotated_right : index to i32
  %observations = vector.from_elements %and_word, %or_word, %xor_word, %left_word, %signed_right_word, %unsigned_right_word, %rotated_left_word, %rotated_right_word, %normalized_leading_word, %trailing_word, %population_word, %ordinal_width_word, %bounded_trailing_word, %varying_width_word, %varying_trailing_word, %varying_left_word, %varying_right_word : vector<17xi32>
  vector.store %observations, %results[0] : vector<17xi32>, view<17xi32>
  func.return
}

check.scenario @portable_index_bitwise_values {
  check.trial[256](%trial: index, %entropy: check.entropy) {
    %lhs_entropy = check.entropy.fork %entropy name("lhs") : check.entropy
    %rhs_entropy = check.entropy.fork %entropy name("rhs") : check.entropy
    %lhs_bits = check.entropy.read %lhs_entropy[%trial] : check.entropy -> i64
    %rhs_bits = check.entropy.read %rhs_entropy[%trial] : check.entropy -> i64
    %storage = check.generate.fill value(-123) : tensor<25xi32>
    %prefix = check.tensor.view %storage offset(0) : tensor<25xi32> -> tensor<4xi32>
    %output = check.tensor.view %storage offset(16) : tensor<25xi32> -> tensor<17xi32>
    %suffix = check.tensor.view %storage offset(84) : tensor<25xi32> -> tensor<4xi32>
    %guard = check.generate.fill value(-123) : tensor<4xi32>
    check.compare<@portable_index_bitwise_observations>(%trial, %lhs_bits, %rhs_bits, %output) : (index, i64, i64, tensor<17xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<17xi32>
      check.expect.bitwise actual(%prefix) expected(%guard) : tensor<4xi32>
      check.expect.bitwise actual(%suffix) expected(%guard) : tensor<4xi32>
    }
  }
  check.return
}

// Exercises every scalar payload width at the signed coordinate and unsigned
// byte-offset boundaries. The i64 inputs are first reduced to the 32-bit
// address domain so both 32-bit and 64-bit target carriers observe the same
// values. Narrow round trips retain the original payload width.
func.def @address_cast_observations(%payload_bits: i64, %output: buffer) {
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %positive_mask = scalar.constant 2147483647 : i32
  %base = index.constant 0 : offset
  %results = buffer.view %output[%base] : buffer -> view<20xi64>

  %word = scalar.trunci %payload_bits : i64 to i32
  %half = scalar.trunci %payload_bits : i64 to i16
  %byte = scalar.trunci %payload_bits : i64 to i8
  %flag_bit = scalar.andi %word, %c1_i32 : i32
  %flag = scalar.cmpi ne, %flag_bit, %c0_i32 : i32
  %signed_wide = scalar.extsi %word : i32 to i64
  %unsigned_wide = scalar.extui %word : i32 to i64
  %positive_word = scalar.andi %word, %positive_mask : i32

  %flag_index = index.cast %flag : i1 to index
  %flag_offset = index.cast %flag : i1 to offset
  %index_flag = index.cast %flag_index : index to i1
  %offset_flag = index.cast %flag_offset : offset to i1
  %flag_index_wide = index.cast %flag_index : index to i64
  %flag_offset_wide = index.cast %flag_offset : offset to i64
  %index_flag_wide = scalar.extui %index_flag : i1 to i64
  %offset_flag_wide = scalar.extui %offset_flag : i1 to i64

  %byte_index = index.cast %byte : i8 to index
  %byte_index_wide = index.cast %byte_index : index to i64
  %byte_roundtrip = index.cast %byte_index : index to i8
  %byte_roundtrip_wide = scalar.extsi %byte_roundtrip : i8 to i64
  %half_index = index.cast %half : i16 to index
  %half_index_wide = index.cast %half_index : index to i64
  %half_roundtrip = index.cast %half_index : index to i16
  %half_roundtrip_wide = scalar.extsi %half_roundtrip : i16 to i64
  %word_index = index.cast %word : i32 to index
  %word_index_wide = index.cast %word_index : index to i64
  %word_roundtrip = index.cast %word_index : index to i32
  %word_roundtrip_wide = scalar.extsi %word_roundtrip : i32 to i64
  %wide_index = index.cast %signed_wide : i64 to index
  %wide_index_roundtrip = index.cast %wide_index : index to i64

  %byte_offset = index.cast %byte : i8 to offset
  %byte_offset_wide = index.cast %byte_offset : offset to i64
  %byte_offset_roundtrip = index.cast %byte_offset : offset to i8
  %byte_offset_roundtrip_wide = scalar.extui %byte_offset_roundtrip : i8 to i64
  %half_offset = index.cast %half : i16 to offset
  %half_offset_wide = index.cast %half_offset : offset to i64
  %half_offset_roundtrip = index.cast %half_offset : offset to i16
  %half_offset_roundtrip_wide = scalar.extui %half_offset_roundtrip : i16 to i64
  %word_offset = index.cast %word : i32 to offset
  %word_offset_wide = index.cast %word_offset : offset to i64
  %word_offset_roundtrip = index.cast %word_offset : offset to i32
  %word_offset_roundtrip_wide = scalar.extui %word_offset_roundtrip : i32 to i64
  %wide_offset = index.cast %unsigned_wide : i64 to offset
  %wide_offset_roundtrip = index.cast %wide_offset : offset to i64

  %positive_index = index.cast %positive_word : i32 to index
  %positive_offset = index.cast %positive_word : i32 to offset
  %index_as_offset = index.cast %positive_index : index to offset
  %offset_as_index = index.cast %positive_offset : offset to index
  %index_as_offset_wide = index.cast %index_as_offset : offset to i64
  %offset_as_index_wide = index.cast %offset_as_index : index to i64

  view.store %flag_index_wide, %results[0] : i64, view<20xi64>
  view.store %flag_offset_wide, %results[1] : i64, view<20xi64>
  view.store %index_flag_wide, %results[2] : i64, view<20xi64>
  view.store %offset_flag_wide, %results[3] : i64, view<20xi64>
  view.store %byte_index_wide, %results[4] : i64, view<20xi64>
  view.store %byte_roundtrip_wide, %results[5] : i64, view<20xi64>
  view.store %half_index_wide, %results[6] : i64, view<20xi64>
  view.store %half_roundtrip_wide, %results[7] : i64, view<20xi64>
  view.store %word_index_wide, %results[8] : i64, view<20xi64>
  view.store %word_roundtrip_wide, %results[9] : i64, view<20xi64>
  view.store %wide_index_roundtrip, %results[10] : i64, view<20xi64>
  view.store %byte_offset_wide, %results[11] : i64, view<20xi64>
  view.store %byte_offset_roundtrip_wide, %results[12] : i64, view<20xi64>
  view.store %half_offset_wide, %results[13] : i64, view<20xi64>
  view.store %half_offset_roundtrip_wide, %results[14] : i64, view<20xi64>
  view.store %word_offset_wide, %results[15] : i64, view<20xi64>
  view.store %word_offset_roundtrip_wide, %results[16] : i64, view<20xi64>
  view.store %wide_offset_roundtrip, %results[17] : i64, view<20xi64>
  view.store %index_as_offset_wide, %results[18] : i64, view<20xi64>
  view.store %offset_as_index_wide, %results[19] : i64, view<20xi64>
  func.return
}

check.scenario @address_cast_values {
  check.trial[256](%trial: index, %entropy: check.entropy) {
    %payload_entropy = check.entropy.fork %entropy name("payload") : check.entropy
    %payload_bits = check.entropy.read %payload_entropy[%trial] : check.entropy -> i64
    %storage = check.generate.fill value(-123) : tensor<28xi64>
    %prefix = check.tensor.view %storage offset(0) : tensor<28xi64> -> tensor<4xi64>
    %output = check.tensor.view %storage offset(32) : tensor<28xi64> -> tensor<20xi64>
    %suffix = check.tensor.view %storage offset(192) : tensor<28xi64> -> tensor<4xi64>
    %guard = check.generate.fill value(-123) : tensor<4xi64>
    check.compare<@address_cast_observations>(%payload_bits, %output) : (i64, tensor<20xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<20xi64>
      check.expect.bitwise actual(%prefix) expected(%guard) : tensor<4xi64>
      check.expect.bitwise actual(%suffix) expected(%guard) : tensor<4xi64>
    }
  }
  check.return
}

func.def @scalar_i32_arithmetic_observations(%ordinal: index, %lhs_bits: i64, %rhs_bits: i64, %addend_bits: i64, %output: buffer) {
  %c0_index = index.constant 0 : index
  %c4_index = index.constant 4 : index
  %c32_index = index.constant 32 : index
  %base = index.constant 0 : offset
  %results = buffer.view %output[%base] : buffer -> view<12xi32>
  %bounded_ordinal = index.assume %ordinal [range(%ordinal, 0, 255)] : index
  %count_index = index.rem %bounded_ordinal, %c32_index : index
  %count = index.cast %count_index : index to i32
  %lhs = scalar.trunci %lhs_bits : i64 to i32
  %rhs = scalar.trunci %rhs_bits : i64 to i32
  %addend = scalar.trunci %addend_bits : i64 to i32
  %sum = scalar.addi %lhs, %rhs : i32
  %difference = scalar.subi %sum, %rhs : i32
  %product = scalar.muli %difference, %rhs : i32
  %and = scalar.andi %product, %lhs : i32
  %or = scalar.ori %and, %rhs : i32
  %xor = scalar.xori %or, %lhs : i32
  %left = scalar.shli %xor, %count : i32
  %signed_right = scalar.shrsi %left, %count : i32
  %unsigned_right = scalar.shrui %signed_right, %count : i32
  %multiply_add = scalar.addi %product, %addend : i32
  %comparison_case = index.rem %bounded_ordinal, %c4_index : index
  %compare_equal = index.cmp eq, %comparison_case, %c0_index : index
  %compare_rhs = scf.select %compare_equal, %lhs, %rhs : i32
  %eq = scalar.cmpi eq, %lhs, %compare_rhs : i32
  %ne = scalar.cmpi ne, %lhs, %compare_rhs : i32
  %slt = scalar.cmpi slt, %lhs, %compare_rhs : i32
  %sle = scalar.cmpi sle, %lhs, %compare_rhs : i32
  %sgt = scalar.cmpi sgt, %lhs, %compare_rhs : i32
  %sge = scalar.cmpi sge, %lhs, %compare_rhs : i32
  %ult = scalar.cmpi ult, %lhs, %compare_rhs : i32
  %ule = scalar.cmpi ule, %lhs, %compare_rhs : i32
  %ugt = scalar.cmpi ugt, %lhs, %compare_rhs : i32
  %uge = scalar.cmpi uge, %lhs, %compare_rhs : i32
  %eq_word = scalar.extui %eq : i1 to i32
  %ne_word = scalar.extui %ne : i1 to i32
  %slt_word = scalar.extui %slt : i1 to i32
  %sle_word = scalar.extui %sle : i1 to i32
  %sgt_word = scalar.extui %sgt : i1 to i32
  %sge_word = scalar.extui %sge : i1 to i32
  %ult_word = scalar.extui %ult : i1 to i32
  %ule_word = scalar.extui %ule : i1 to i32
  %ugt_word = scalar.extui %ugt : i1 to i32
  %uge_word = scalar.extui %uge : i1 to i32
  view.store %unsigned_right, %results[0] : i32, view<12xi32>
  view.store %multiply_add, %results[1] : i32, view<12xi32>
  view.store %eq_word, %results[2] : i32, view<12xi32>
  view.store %ne_word, %results[3] : i32, view<12xi32>
  view.store %slt_word, %results[4] : i32, view<12xi32>
  view.store %sle_word, %results[5] : i32, view<12xi32>
  view.store %sgt_word, %results[6] : i32, view<12xi32>
  view.store %sge_word, %results[7] : i32, view<12xi32>
  view.store %ult_word, %results[8] : i32, view<12xi32>
  view.store %ule_word, %results[9] : i32, view<12xi32>
  view.store %ugt_word, %results[10] : i32, view<12xi32>
  view.store %uge_word, %results[11] : i32, view<12xi32>
  func.return
}

check.scenario @scalar_i32_arithmetic_values {
  check.trial[256](%trial: index, %entropy: check.entropy) {
    %lhs_entropy = check.entropy.fork %entropy name("lhs") : check.entropy
    %rhs_entropy = check.entropy.fork %entropy name("rhs") : check.entropy
    %addend_entropy = check.entropy.fork %entropy name("addend") : check.entropy
    %lhs_bits = check.entropy.read %lhs_entropy[%trial] : check.entropy -> i64
    %rhs_bits = check.entropy.read %rhs_entropy[%trial] : check.entropy -> i64
    %addend_bits = check.entropy.read %addend_entropy[%trial] : check.entropy -> i64
    %output = check.generate.fill value(0) : tensor<12xi32>
    check.compare<@scalar_i32_arithmetic_observations>(%trial, %lhs_bits, %rhs_bits, %addend_bits, %output) : (index, i64, i64, i64, tensor<12xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<12xi32>
    }
  }
  check.return
}

func.def @scalar_i32_bitfield_observations(%word_bits: i64, %output: buffer) {
  %base = index.constant 0 : offset
  %results = buffer.view %output[%base] : buffer -> view<8xi32>
  %word = scalar.trunci %word_bits : i64 to i32
  %unsigned_byte = scalar.bitfield.extractu %word {offset = 8, width = 8} : i32 -> i32
  %signed_byte = scalar.bitfield.extracts %word {offset = 16, width = 8} : i32 -> i32
  %unsigned_nibble = scalar.bitfield.extractu %word {offset = 4, width = 4} : i32 -> i32
  %signed_nibble = scalar.bitfield.extracts %word {offset = 4, width = 4} : i32 -> i32
  %low_bit = scalar.bitfield.extractu %word {offset = 0, width = 1} : i32 -> i32
  %signed_high_bit = scalar.bitfield.extracts %word {offset = 31, width = 1} : i32 -> i32
  %unsigned_wide_field = scalar.bitfield.extractu %word {offset = 0, width = 31} : i32 -> i32
  %signed_wide_field = scalar.bitfield.extracts %word {offset = 0, width = 31} : i32 -> i32
  view.store %unsigned_byte, %results[0] : i32, view<8xi32>
  view.store %signed_byte, %results[1] : i32, view<8xi32>
  view.store %unsigned_nibble, %results[2] : i32, view<8xi32>
  view.store %signed_nibble, %results[3] : i32, view<8xi32>
  view.store %low_bit, %results[4] : i32, view<8xi32>
  view.store %signed_high_bit, %results[5] : i32, view<8xi32>
  view.store %unsigned_wide_field, %results[6] : i32, view<8xi32>
  view.store %signed_wide_field, %results[7] : i32, view<8xi32>
  func.return
}

check.scenario @scalar_i32_bitfield_values {
  check.trial[256](%trial: index, %entropy: check.entropy) {
    %word_bits = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %output = check.generate.fill value(0) : tensor<8xi32>
    check.compare<@scalar_i32_bitfield_observations>(%word_bits, %output) : (i64, tensor<8xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<8xi32>
    }
  }
  check.return
}

// Entropy supplies full-width arithmetic and address payloads. The ordinal
// independently enumerates every predicate pair and every valid shift count.
func.def @scalar_integer_address_observations(%ordinal: index, %lhs_bits: i64, %rhs_bits: i64, %addend_bits: i64, %word_output: buffer, %wide_output: buffer) {
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %c2_i32 = scalar.constant 2 : i32
  %c16_i32 = scalar.constant 16 : i32
  %positive_mask = scalar.constant 2147483647 : i32
  %c32_index = index.constant 32 : index
  %c4_index = index.constant 4 : index
  %c8_index = index.constant 8 : index
  %base = index.constant 0 : offset
  %word_results = buffer.view %word_output[%base] : buffer -> view<14xi32>
  %wide_results = buffer.view %wide_output[%base] : buffer -> view<8xi64>

  %bounded_ordinal = index.assume %ordinal [range(%ordinal, 0, 255)] : index
  %lhs_word = scalar.trunci %lhs_bits : i64 to i32
  %rhs_word = scalar.trunci %rhs_bits : i64 to i32
  %addend_word = scalar.trunci %addend_bits : i64 to i32
  %positive_word = scalar.andi %lhs_word, %positive_mask : i32
  %truth_case_index = index.rem %bounded_ordinal, %c4_index : index
  %truth_case = index.cast %truth_case_index : index to i32
  %lhs_truth = scalar.andi %truth_case, %c1_i32 : i32
  %rhs_shifted = scalar.shrui %truth_case, %c1_i32 : i32
  %rhs_truth = scalar.andi %rhs_shifted, %c1_i32 : i32
  %lhs_nonzero = scalar.ori %lhs_word, %c1_i32 : i32
  %rhs_nonzero = scalar.ori %rhs_word, %c1_i32 : i32
  %lhs_enabled = scalar.cmpi ne, %lhs_truth, %c0_i32 : i32
  %rhs_enabled = scalar.cmpi ne, %rhs_truth, %c0_i32 : i32
  %lhs_input = scf.select %lhs_enabled, %lhs_nonzero, %c0_i32 : i32
  %rhs_input = scf.select %rhs_enabled, %rhs_nonzero, %c0_i32 : i32
  %lhs = scalar.cmpi ne, %lhs_input, %c0_i32 : i32
  %rhs = scalar.cmpi ne, %rhs_input, %c0_i32 : i32
  %both = scalar.andi %lhs, %rhs : i1
  %either = scalar.ori %lhs, %rhs : i1
  %exclusive = scalar.xori %lhs, %rhs : i1
  %both_bit = scalar.extui %both : i1 to i32
  %either_bit = scalar.extui %either : i1 to i32
  %exclusive_bit = scalar.extui %exclusive : i1 to i32
  %either_position = scalar.shli %either_bit, %c1_i32 : i32
  %exclusive_position = scalar.shli %exclusive_bit, %c2_i32 : i32
  %algebra_low = scalar.ori %both_bit, %either_position : i32
  %algebra = scalar.ori %algebra_low, %exclusive_position : i32
  %comparison_mask = func.call @predicate_comparison_mask(%lhs, %rhs) : (i1, i1) -> (i32)
  %lhs_i32 = scalar.extui %lhs : i1 to i32
  %lhs_i64 = scalar.extui %lhs : i1 to i64
  %false = scalar.constant false : i1
  %true = scalar.constant true : i1
  %false_bit = scalar.extui %false : i1 to i32
  %true_bit = scalar.extui %true : i1 to i32
  %true_position = scalar.shli %true_bit, %c1_i32 : i32
  %constants = scalar.ori %false_bit, %true_position : i32
  view.store %algebra, %word_results[0] : i32, view<14xi32>
  view.store %comparison_mask, %word_results[1] : i32, view<14xi32>
  view.store %lhs_i32, %word_results[2] : i32, view<14xi32>
  view.store %constants, %word_results[3] : i32, view<14xi32>
  view.store %lhs_i64, %wide_results[0] : i64, view<8xi64>

  %lhs_index = index.cast %lhs_word : i32 to index
  %rhs_index = index.cast %rhs_word : i32 to index
  %addend_index = index.cast %addend_word : i32 to index
  %logical_index = index.cast %positive_word : i32 to index
  %count_unbounded = index.rem %bounded_ordinal, %c32_index : index
  %count = index.assume %count_unbounded [range(%count_unbounded, 0, 31)] : index
  %count_word = index.cast %count : index to i32
  %madd = index.madd %lhs_index, %rhs_index, %addend_index : index
  %scaled = index.mul %lhs_index, %c8_index : index
  %mul_add = index.add %scaled, %rhs_index : index
  %left = index.shli %lhs_index, %count : index
  // Logical index shift semantics depend on the target-selected carrier for
  // negative values. The nonnegative coordinate is stable across VM64 and
  // 32-bit targets; the fixed-width shift retains full i32 payload coverage.
  %logical = index.shrui %logical_index, %count : index
  %payload_logical = scalar.shrui %lhs_word, %count_word : i32
  %signed = index.shrsi %lhs_index, %count : index
  %signed_with_count = index.add %signed, %count : index
  %reused = index.xori %signed_with_count, %lhs_index : index
  %madd_word = index.cast %madd : index to i32
  %mul_add_word = index.cast %mul_add : index to i32
  %left_word = index.cast %left : index to i32
  %logical_word = index.cast %logical : index to i32
  %signed_word = index.cast %signed : index to i32
  %reused_word = index.cast %reused : index to i32
  view.store %madd_word, %word_results[4] : i32, view<14xi32>
  view.store %mul_add_word, %word_results[5] : i32, view<14xi32>
  view.store %left_word, %word_results[6] : i32, view<14xi32>
  view.store %logical_word, %word_results[7] : i32, view<14xi32>
  view.store %signed_word, %word_results[8] : i32, view<14xi32>
  view.store %payload_logical, %word_results[9] : i32, view<14xi32>
  view.store %reused_word, %word_results[10] : i32, view<14xi32>
  view.store %lhs_word, %word_results[11] : i32, view<14xi32>
  view.store %rhs_word, %word_results[12] : i32, view<14xi32>
  view.store %addend_word, %word_results[13] : i32, view<14xi32>

  %lhs_offset = index.cast %lhs_word : i32 to offset
  %signed_wide = index.cast %lhs_index : index to i64
  %unsigned_wide = index.cast %lhs_offset : offset to i64
  %rhs_unsigned = scalar.extui %rhs_word : i32 to i64
  %rhs_bounded = scalar.assume %rhs_unsigned [range(%rhs_unsigned, 0, 4294967295)] : i64
  %rhs_offset = index.cast %rhs_bounded : i64 to offset
  %rhs_roundtrip = index.cast %rhs_offset : offset to i64
  %positive_wide = scalar.extui %positive_word : i32 to i64
  %middle_bias = scalar.constant 1073741824 : i64
  %target = scalar.addi %positive_wide, %middle_bias : i64
  %centered_count = scalar.subi %count_word, %c16_i32 : i32
  %centered_wide = scalar.extsi %centered_count : i32 to i64
  %c4_i64 = scalar.constant 4 : i64
  %displacement = scalar.muli %centered_wide, %c4_i64 : i64
  %origin = scalar.subi %target, %displacement : i64
  %bounded_origin = scalar.assume %origin [range(%origin, 0, 4294967295)] : i64
  %origin_offset = index.cast %bounded_origin : i64 to offset
  %origin_wide = index.cast %origin_offset : offset to i64
  %sum = scalar.addi %origin_wide, %displacement : i64
  %bounded_sum = scalar.assume %sum [range(%sum, 0, 4294967295)] : i64
  %result_offset = index.cast %bounded_sum : i64 to offset
  %result_wide = index.cast %result_offset : offset to i64
  %minimum_payload = scalar.constant -2147483648 : i32
  %maximum_payload = scalar.constant -1 : i32
  %minimum_index = index.cast %minimum_payload : i32 to index
  %maximum_offset = index.cast %maximum_payload : i32 to offset
  %minimum_wide = index.cast %minimum_index : index to i64
  %maximum_wide = index.cast %maximum_offset : offset to i64
  view.store %signed_wide, %wide_results[1] : i64, view<8xi64>
  view.store %unsigned_wide, %wide_results[2] : i64, view<8xi64>
  view.store %rhs_roundtrip, %wide_results[3] : i64, view<8xi64>
  view.store %target, %wide_results[4] : i64, view<8xi64>
  view.store %result_wide, %wide_results[5] : i64, view<8xi64>
  view.store %minimum_wide, %wide_results[6] : i64, view<8xi64>
  view.store %maximum_wide, %wide_results[7] : i64, view<8xi64>
  func.return
}

check.scenario @scalar_integer_address_values {
  check.trial[256](%trial: index, %entropy: check.entropy) {
    %lhs_entropy = check.entropy.fork %entropy name("lhs") : check.entropy
    %rhs_entropy = check.entropy.fork %entropy name("rhs") : check.entropy
    %addend_entropy = check.entropy.fork %entropy name("addend") : check.entropy
    %lhs_bits = check.entropy.read %lhs_entropy[%trial] : check.entropy -> i64
    %rhs_bits = check.entropy.read %rhs_entropy[%trial] : check.entropy -> i64
    %addend_bits = check.entropy.read %addend_entropy[%trial] : check.entropy -> i64
    %word_storage = check.generate.fill value(-123) : tensor<22xi32>
    %word_output = check.tensor.view %word_storage offset(16) : tensor<22xi32> -> tensor<14xi32>
    %word_prefix = check.tensor.view %word_storage offset(0) : tensor<22xi32> -> tensor<4xi32>
    %word_suffix = check.tensor.view %word_storage offset(72) : tensor<22xi32> -> tensor<4xi32>
    %word_guard = check.generate.fill value(-123) : tensor<4xi32>
    %wide_storage = check.generate.fill value(-123) : tensor<16xi64>
    %wide_output = check.tensor.view %wide_storage offset(32) : tensor<16xi64> -> tensor<8xi64>
    %wide_prefix = check.tensor.view %wide_storage offset(0) : tensor<16xi64> -> tensor<4xi64>
    %wide_suffix = check.tensor.view %wide_storage offset(96) : tensor<16xi64> -> tensor<4xi64>
    %wide_guard = check.generate.fill value(-123) : tensor<4xi64>
    check.compare<@scalar_integer_address_observations>(%trial, %lhs_bits, %rhs_bits, %addend_bits, %word_output, %wide_output) : (index, i64, i64, i64, tensor<14xi32>, tensor<8xi64>) -> () {
      check.expect.bitwise actual(%word_output) expected(%word_output) : tensor<14xi32>
      check.expect.bitwise actual(%wide_output) expected(%wide_output) : tensor<8xi64>
      check.expect.bitwise actual(%word_prefix) expected(%word_guard) : tensor<4xi32>
      check.expect.bitwise actual(%word_suffix) expected(%word_guard) : tensor<4xi32>
      check.expect.bitwise actual(%wide_prefix) expected(%wide_guard) : tensor<4xi64>
      check.expect.bitwise actual(%wide_suffix) expected(%wide_guard) : tensor<4xi64>
    }
  }
  check.return
}
