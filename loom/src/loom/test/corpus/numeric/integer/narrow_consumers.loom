// Narrow values retain their storage bank when uniform and lane-varying inputs
// cross sign and wrap boundaries before arithmetic and comparison consumers.
kernel.def @narrow_integer_consumers() {
  %unit = index.constant 1 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: i32, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %lane_value = index.cast %lane : index to i32
  %varying = scalar.addi %input, %lane_value : i32
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %byte_sign_boundary = scalar.constant 0 : i8
  %halfword_sign_boundary = scalar.constant 0 : i16
  %base = index.constant 64 : offset
  %view = buffer.view %output[%base] : buffer -> view<12x32xi32>
  %input_i8 = scalar.trunci %input : i32 to i8
  %input_i8_unsigned = scalar.extui %input_i8 : i8 to i32
  %input_i8_signed = scalar.extsi %input_i8 : i8 to i32
  %input_i8_unsigned_sum = scalar.addi %input_i8_unsigned, %c1 : i32
  %input_i8_signed_sum = scalar.addi %input_i8_signed, %c1 : i32
  %input_i8_negative = scalar.cmpi slt, %input_i8, %byte_sign_boundary : i8
  %input_i8_comparison = scf.select %input_i8_negative, %c1, %c0 : i32
  view.store %input_i8_unsigned_sum, %view[0, %lane] : i32, view<12x32xi32>
  view.store %input_i8_signed_sum, %view[1, %lane] : i32, view<12x32xi32>
  view.store %input_i8_comparison, %view[8, %lane] : i32, view<12x32xi32>
  %input_i16 = scalar.trunci %input : i32 to i16
  %input_i16_unsigned = scalar.extui %input_i16 : i16 to i32
  %input_i16_signed = scalar.extsi %input_i16 : i16 to i32
  %input_i16_unsigned_sum = scalar.addi %input_i16_unsigned, %c1 : i32
  %input_i16_signed_sum = scalar.addi %input_i16_signed, %c1 : i32
  %input_i16_negative = scalar.cmpi slt, %input_i16, %halfword_sign_boundary : i16
  %input_i16_comparison = scf.select %input_i16_negative, %c1, %c0 : i32
  view.store %input_i16_unsigned_sum, %view[2, %lane] : i32, view<12x32xi32>
  view.store %input_i16_signed_sum, %view[3, %lane] : i32, view<12x32xi32>
  view.store %input_i16_comparison, %view[9, %lane] : i32, view<12x32xi32>
  %varying_i8 = scalar.trunci %varying : i32 to i8
  %varying_i8_unsigned = scalar.extui %varying_i8 : i8 to i32
  %varying_i8_signed = scalar.extsi %varying_i8 : i8 to i32
  %varying_i8_unsigned_sum = scalar.addi %varying_i8_unsigned, %c1 : i32
  %varying_i8_signed_sum = scalar.addi %varying_i8_signed, %c1 : i32
  %varying_i8_negative = scalar.cmpi slt, %varying_i8, %byte_sign_boundary : i8
  %varying_i8_comparison = scf.select %varying_i8_negative, %c1, %c0 : i32
  view.store %varying_i8_unsigned_sum, %view[4, %lane] : i32, view<12x32xi32>
  view.store %varying_i8_signed_sum, %view[5, %lane] : i32, view<12x32xi32>
  view.store %varying_i8_comparison, %view[10, %lane] : i32, view<12x32xi32>
  %varying_i16 = scalar.trunci %varying : i32 to i16
  %varying_i16_unsigned = scalar.extui %varying_i16 : i16 to i32
  %varying_i16_signed = scalar.extsi %varying_i16 : i16 to i32
  %varying_i16_unsigned_sum = scalar.addi %varying_i16_unsigned, %c1 : i32
  %varying_i16_signed_sum = scalar.addi %varying_i16_signed, %c1 : i32
  %varying_i16_negative = scalar.cmpi slt, %varying_i16, %halfword_sign_boundary : i16
  %varying_i16_comparison = scf.select %varying_i16_negative, %c1, %c0 : i32
  view.store %varying_i16_unsigned_sum, %view[6, %lane] : i32, view<12x32xi32>
  view.store %varying_i16_signed_sum, %view[7, %lane] : i32, view<12x32xi32>
  view.store %varying_i16_comparison, %view[11, %lane] : i32, view<12x32xi32>
  kernel.return
}

func.def @narrow_integer_consumers_oracle(%input: i32, %output: buffer) {
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %byte_sign_boundary = scalar.constant 0 : i8
  %halfword_sign_boundary = scalar.constant 0 : i16
  %base = index.constant 64 : offset
  %view = buffer.view %output[%base] : buffer -> view<12x32xi32>
  %input_i8 = scalar.trunci %input : i32 to i8
  %input_i8_unsigned = scalar.extui %input_i8 : i8 to i32
  %input_i8_signed = scalar.extsi %input_i8 : i8 to i32
  %input_i8_unsigned_sum = scalar.addi %input_i8_unsigned, %c1 : i32
  %input_i8_signed_sum = scalar.addi %input_i8_signed, %c1 : i32
  %input_i8_negative = scalar.cmpi slt, %input_i8, %byte_sign_boundary : i8
  %input_i8_comparison = scf.select %input_i8_negative, %c1, %c0 : i32
  %input_i16 = scalar.trunci %input : i32 to i16
  %input_i16_unsigned = scalar.extui %input_i16 : i16 to i32
  %input_i16_signed = scalar.extsi %input_i16 : i16 to i32
  %input_i16_unsigned_sum = scalar.addi %input_i16_unsigned, %c1 : i32
  %input_i16_signed_sum = scalar.addi %input_i16_signed, %c1 : i32
  %input_i16_negative = scalar.cmpi slt, %input_i16, %halfword_sign_boundary : i16
  %input_i16_comparison = scf.select %input_i16_negative, %c1, %c0 : i32
  %begin = index.constant 0 : index
  %end = index.constant 32 : index
  %step = index.constant 1 : index
  scf.for %lane = [%begin to %end step %step] {
    %lane_value = index.cast %lane : index to i32
    %varying = scalar.addi %input, %lane_value : i32
    %varying_i8 = scalar.trunci %varying : i32 to i8
    %varying_i8_unsigned = scalar.extui %varying_i8 : i8 to i32
    %varying_i8_signed = scalar.extsi %varying_i8 : i8 to i32
    %varying_i8_unsigned_sum = scalar.addi %varying_i8_unsigned, %c1 : i32
    %varying_i8_signed_sum = scalar.addi %varying_i8_signed, %c1 : i32
    %varying_i8_negative = scalar.cmpi slt, %varying_i8, %byte_sign_boundary : i8
    %varying_i8_comparison = scf.select %varying_i8_negative, %c1, %c0 : i32
    %varying_i16 = scalar.trunci %varying : i32 to i16
    %varying_i16_unsigned = scalar.extui %varying_i16 : i16 to i32
    %varying_i16_signed = scalar.extsi %varying_i16 : i16 to i32
    %varying_i16_unsigned_sum = scalar.addi %varying_i16_unsigned, %c1 : i32
    %varying_i16_signed_sum = scalar.addi %varying_i16_signed, %c1 : i32
    %varying_i16_negative = scalar.cmpi slt, %varying_i16, %halfword_sign_boundary : i16
    %varying_i16_comparison = scf.select %varying_i16_negative, %c1, %c0 : i32
    view.store %input_i8_unsigned_sum, %view[0, %lane] : i32, view<12x32xi32>
    view.store %input_i8_signed_sum, %view[1, %lane] : i32, view<12x32xi32>
    view.store %input_i16_unsigned_sum, %view[2, %lane] : i32, view<12x32xi32>
    view.store %input_i16_signed_sum, %view[3, %lane] : i32, view<12x32xi32>
    view.store %varying_i8_unsigned_sum, %view[4, %lane] : i32, view<12x32xi32>
    view.store %varying_i8_signed_sum, %view[5, %lane] : i32, view<12x32xi32>
    view.store %varying_i16_unsigned_sum, %view[6, %lane] : i32, view<12x32xi32>
    view.store %varying_i16_signed_sum, %view[7, %lane] : i32, view<12x32xi32>
    view.store %input_i8_comparison, %view[8, %lane] : i32, view<12x32xi32>
    view.store %input_i16_comparison, %view[9, %lane] : i32, view<12x32xi32>
    view.store %varying_i8_comparison, %view[10, %lane] : i32, view<12x32xi32>
    view.store %varying_i16_comparison, %view[11, %lane] : i32, view<12x32xi32>
  }
  func.return
}

check.scenario @narrow_integer_consumer_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.literal value(112) : i32
    %output = check.generate.fill value(-7777) : tensor<416xi32>
    check.compare<@narrow_integer_consumers, @narrow_integer_consumers_oracle>(%input, %output) : (i32, tensor<416xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<416xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.literal value(32752) : i32
    %output = check.generate.fill value(-7777) : tensor<416xi32>
    check.compare<@narrow_integer_consumers, @narrow_integer_consumers_oracle>(%input, %output) : (i32, tensor<416xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<416xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.literal value(65520) : i32
    %output = check.generate.fill value(-7777) : tensor<416xi32>
    check.compare<@narrow_integer_consumers, @narrow_integer_consumers_oracle>(%input, %output) : (i32, tensor<416xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<416xi32>
    }
  }
  check.return
}
