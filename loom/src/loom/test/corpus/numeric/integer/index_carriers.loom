func.def noinline @advance_signed_index(%position: index) -> (index) {
  %step = index.constant 1 : index
  %next = index.add %position, %step : index
  func.return %next : index
}

// Computed coordinates may extend beyond either end of the native signed
// domain. The runtime input visits both signs and zero; the independent oracle
// uses fixed-width arithmetic instead of the target-selected index carrier.
func.def @signed_index_observations(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 7 : index
  %step = index.constant 1 : index
  %inputs = buffer.view %input[%origin] : buffer -> view<7xi32>
  %results = buffer.view %output[%origin] : buffer -> view<7x17xi64>
  scf.for %row = [%begin to %end step %step] {
    %input_value = view.load %inputs[%row] : view<7xi32> -> i32
    %bounded = scalar.assume %input_value [range(%input_value, -3, 3)] : i32
    %coordinate = index.cast %bounded : i32 to index
    %factor = index.constant 1073741824 : index
    %bias = index.constant -8589934592 : index
    %c1 = index.constant 1 : index
    %crossing = index.mul %coordinate, %factor : index
    %negative = index.add %crossing, %bias : index
    %minimum = index.min %negative, %bias : index
    %maximum = index.max %negative, %bias : index
    %logical = index.shrui %negative, %c1 : index
    %arithmetic = index.shrsi %negative, %c1 : index
    %less = index.cmp slt, %negative, %bias : index
    %unsigned_less = index.cmp ult, %negative, %crossing : index
    %selected = scf.select %less, %negative, %crossing : index
    %crossing_bits = index.cast %crossing : index to i64
    %negative_bits = index.cast %negative : index to i64
    %minimum_bits = index.cast %minimum : index to i64
    %maximum_bits = index.cast %maximum : index to i64
    %logical_bits = index.cast %logical : index to i64
    %arithmetic_bits = index.cast %arithmetic : index to i64
    %selected_bits = index.cast %selected : index to i64
    %unsigned_bit = scalar.extui %unsigned_less : i1 to i64
    view.store %crossing_bits, %results[%row, 0] : i64, view<7x17xi64>
    view.store %negative_bits, %results[%row, 1] : i64, view<7x17xi64>
    view.store %minimum_bits, %results[%row, 2] : i64, view<7x17xi64>
    view.store %maximum_bits, %results[%row, 3] : i64, view<7x17xi64>
    view.store %logical_bits, %results[%row, 4] : i64, view<7x17xi64>
    view.store %arithmetic_bits, %results[%row, 5] : i64, view<7x17xi64>
    view.store %selected_bits, %results[%row, 6] : i64, view<7x17xi64>
    view.store %unsigned_bit, %results[%row, 7] : i64, view<7x17xi64>
    %word_shift = index.constant 33 : index
    %logical_word = index.shrui %negative, %word_shift : index
    %arithmetic_word = index.shrsi %negative, %word_shift : index
    %logical_word_bits = index.cast %logical_word : index to i64
    %arithmetic_word_bits = index.cast %arithmetic_word : index to i64
    view.store %logical_word_bits, %results[%row, 8] : i64, view<7x17xi64>
    view.store %arithmetic_word_bits, %results[%row, 9] : i64, view<7x17xi64>
    %positive_bias = scalar.constant 2147483648 : i64
    %input_wide = scalar.extsi %input_value : i32 to i64
    %positive_wide = scalar.addi %input_wide, %positive_bias : i64
    %positive_bound = scalar.assume %positive_wide [range(%positive_wide, 2147483645, 2147483651)] : i64
    %positive = index.cast %positive_bound : i64 to index
    %positive_shift = index.shrsi %positive, %c1 : index
    %positive_bits = index.cast %positive : index to i64
    %positive_shift_bits = index.cast %positive_shift : index to i64
    view.store %positive_bits, %results[%row, 10] : i64, view<7x17xi64>
    view.store %positive_shift_bits, %results[%row, 11] : i64, view<7x17xi64>
    %span = index.constant 3 : index
    %stop = index.add %negative, %span : index
    %c0 = scalar.constant 0 : i64
    %sum = scf.for %position = [%negative to %stop step %c1](%partial = %c0 : i64) -> (i64) {
      %position_bits = index.cast %position : index to i64
      %next = scalar.addi %partial, %position_bits : i64
      scf.yield %next : i64
    }
    view.store %sum, %results[%row, 12] : i64, view<7x17xi64>
    %advanced = func.call @advance_signed_index(%negative) : (index) -> (index)
    %advanced_bits = index.cast %advanced : index to i64
    view.store %advanced_bits, %results[%row, 13] : i64, view<7x17xi64>
    %dividend = index.add %positive, %positive : index
    %maximum_divisor = index.constant 4294967295 : index
    %parity = index.andi %coordinate, %c1 : index
    %divisor = index.sub %maximum_divisor, %parity : index
    %remainder = index.rem %dividend, %divisor : index
    %remainder_bits = index.cast %remainder : index to i64
    view.store %remainder_bits, %results[%row, 14] : i64, view<7x17xi64>
    %triple = index.mul %negative, %span : index
    %madd = index.madd %negative, %span, %coordinate : index
    %triple_bits = index.cast %triple : index to i64
    %madd_bits = index.cast %madd : index to i64
    view.store %triple_bits, %results[%row, 15] : i64, view<7x17xi64>
    view.store %madd_bits, %results[%row, 16] : i64, view<7x17xi64>
  }
  func.return
}

func.def @signed_index_oracle(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 7 : index
  %step = index.constant 1 : index
  %inputs = buffer.view %input[%origin] : buffer -> view<7xi32>
  %results = buffer.view %output[%origin] : buffer -> view<7x17xi64>
  scf.for %row = [%begin to %end step %step] {
    %input_value = view.load %inputs[%row] : view<7xi32> -> i32
    %coordinate = scalar.extsi %input_value : i32 to i64
    %factor = scalar.constant 1073741824 : i64
    %bias = scalar.constant -8589934592 : i64
    %c1 = scalar.constant 1 : i64
    %crossing = scalar.muli %coordinate, %factor : i64
    %negative = scalar.addi %crossing, %bias : i64
    %minimum = scalar.minsi %negative, %bias : i64
    %maximum = scalar.maxsi %negative, %bias : i64
    %logical = scalar.shrui %negative, %c1 : i64
    %arithmetic = scalar.shrsi %negative, %c1 : i64
    %less = scalar.cmpi slt, %negative, %bias : i64
    %unsigned_less = scalar.cmpi ult, %negative, %crossing : i64
    %selected = scf.select %less, %negative, %crossing : i64
    %unsigned_bit = scalar.extui %unsigned_less : i1 to i64
    view.store %crossing, %results[%row, 0] : i64, view<7x17xi64>
    view.store %negative, %results[%row, 1] : i64, view<7x17xi64>
    view.store %minimum, %results[%row, 2] : i64, view<7x17xi64>
    view.store %maximum, %results[%row, 3] : i64, view<7x17xi64>
    view.store %logical, %results[%row, 4] : i64, view<7x17xi64>
    view.store %arithmetic, %results[%row, 5] : i64, view<7x17xi64>
    view.store %selected, %results[%row, 6] : i64, view<7x17xi64>
    view.store %unsigned_bit, %results[%row, 7] : i64, view<7x17xi64>
    %word_shift = scalar.constant 33 : i64
    %logical_word = scalar.shrui %negative, %word_shift : i64
    %arithmetic_word = scalar.shrsi %negative, %word_shift : i64
    view.store %logical_word, %results[%row, 8] : i64, view<7x17xi64>
    view.store %arithmetic_word, %results[%row, 9] : i64, view<7x17xi64>
    %positive_bias = scalar.constant 2147483648 : i64
    %positive = scalar.addi %coordinate, %positive_bias : i64
    %positive_shift = scalar.shrsi %positive, %c1 : i64
    view.store %positive, %results[%row, 10] : i64, view<7x17xi64>
    view.store %positive_shift, %results[%row, 11] : i64, view<7x17xi64>
    %c3 = scalar.constant 3 : i64
    %triple = scalar.muli %negative, %c3 : i64
    %sum = scalar.addi %triple, %c3 : i64
    view.store %sum, %results[%row, 12] : i64, view<7x17xi64>
    %advanced = scalar.addi %negative, %c1 : i64
    view.store %advanced, %results[%row, 13] : i64, view<7x17xi64>
    %dividend = scalar.addi %positive, %positive : i64
    %maximum_divisor = scalar.constant 4294967295 : i64
    %parity = scalar.andi %coordinate, %c1 : i64
    %divisor = scalar.subi %maximum_divisor, %parity : i64
    %remainder = scalar.remui %dividend, %divisor : i64
    view.store %remainder, %results[%row, 14] : i64, view<7x17xi64>
    %madd = scalar.addi %triple, %coordinate : i64
    view.store %triple, %results[%row, 15] : i64, view<7x17xi64>
    view.store %madd, %results[%row, 16] : i64, view<7x17xi64>
  }
  func.return
}

check.scenario @signed_index_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-3) step(1) : tensor<7xi32>
    %storage = check.generate.fill value(-123) : tensor<123xi64>
    %output = check.tensor.view %storage offset(16) : tensor<123xi64> -> tensor<7x17xi64>
    check.compare<@signed_index_observations, @signed_index_oracle>(%input, %output) : (tensor<7xi32>, tensor<7x17xi64>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<123xi64>
    }
  }
  check.return
}

// Runtime words have no static bounds; valid inputs still use ordinary native
// arithmetic on 32-bit targets. The oracle uses only fixed-width arithmetic.
func.def @native_index_observations(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 7 : index
  %step = index.constant 1 : index
  %factor = index.constant 4 : index
  %bias = index.constant 16 : index
  %inputs = buffer.view %input[%origin] : buffer -> view<7xi32>
  %results = buffer.view %output[%origin] : buffer -> view<7x5xi32>
  scf.for %row = [%begin to %end step %step] {
    %input_value = view.load %inputs[%row] : view<7xi32> -> i32
    %coordinate = index.cast %input_value : i32 to index
    %scaled = index.mul %coordinate, %factor : index
    %negative = index.sub %scaled, %bias : index
    %shifted = index.shrsi %negative, %step : index
    %madd = index.madd %coordinate, %negative, %factor : index
    %mul_add = index.add %scaled, %coordinate : index
    %left = index.shli %negative, %step : index
    %negative_bits = index.cast %negative : index to i32
    %shifted_bits = index.cast %shifted : index to i32
    view.store %negative_bits, %results[%row, 0] : i32, view<7x5xi32>
    view.store %shifted_bits, %results[%row, 1] : i32, view<7x5xi32>
    %madd_bits = index.cast %madd : index to i32
    %mul_add_bits = index.cast %mul_add : index to i32
    %left_bits = index.cast %left : index to i32
    view.store %madd_bits, %results[%row, 2] : i32, view<7x5xi32>
    view.store %mul_add_bits, %results[%row, 3] : i32, view<7x5xi32>
    view.store %left_bits, %results[%row, 4] : i32, view<7x5xi32>
  }
  func.return
}

func.def @native_index_oracle(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 7 : index
  %step = index.constant 1 : index
  %factor = scalar.constant 4 : i32
  %bias = scalar.constant 16 : i32
  %c1 = scalar.constant 1 : i32
  %inputs = buffer.view %input[%origin] : buffer -> view<7xi32>
  %results = buffer.view %output[%origin] : buffer -> view<7x5xi32>
  scf.for %row = [%begin to %end step %step] {
    %coordinate = view.load %inputs[%row] : view<7xi32> -> i32
    %scaled = scalar.muli %coordinate, %factor : i32
    %negative = scalar.subi %scaled, %bias : i32
    %shifted = scalar.shrsi %negative, %c1 : i32
    %product = scalar.muli %coordinate, %negative : i32
    %madd = scalar.addi %product, %factor : i32
    %mul_add = scalar.addi %scaled, %coordinate : i32
    %left = scalar.shli %negative, %c1 : i32
    view.store %negative, %results[%row, 0] : i32, view<7x5xi32>
    view.store %shifted, %results[%row, 1] : i32, view<7x5xi32>
    view.store %madd, %results[%row, 2] : i32, view<7x5xi32>
    view.store %mul_add, %results[%row, 3] : i32, view<7x5xi32>
    view.store %left, %results[%row, 4] : i32, view<7x5xi32>
  }
  func.return
}

check.scenario @native_index_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-3) step(1) : tensor<7xi32>
    %storage = check.generate.fill value(-123) : tensor<39xi32>
    %output = check.tensor.view %storage offset(8) : tensor<39xi32> -> tensor<7x5xi32>
    check.compare<@native_index_observations, @native_index_oracle>(%input, %output) : (tensor<7xi32>, tensor<7x5xi32>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<39xi32>
    }
  }
  check.return
}

// The only observation of each computed index is its explicit signed bound.
// Inputs are runtime words; the oracle keeps full-width integer arithmetic.
func.def @assumed_index_observations(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %inputs = buffer.view %input[%origin] : buffer -> view<4x3xi32>
  %results = buffer.view %output[%origin] : buffer -> view<4x8xi64>
  scf.for %row = [%begin to %end step %step] {
    %left = view.load %inputs[%row, 0] : view<4x3xi32> -> i32
    %right = view.load %inputs[%row, 1] : view<4x3xi32> -> i32
    %extra = view.load %inputs[%row, 2] : view<4x3xi32> -> i32
    %a = index.cast %left : i32 to index
    %b = index.cast %right : i32 to index
    %c = index.cast %extra : i32 to index
    %add = index.add %a, %b : index
    %sub = index.sub %a, %b : index
    %mul = index.mul %a, %b : index
    %madd = index.madd %a, %b, %c : index
    %and = index.andi %a, %b : index
    %or = index.ori %a, %b : index
    %xor = index.xori %a, %b : index
    %shift = index.shli %a, %row : index
    %r0, %r1, %r2, %r3, %r4, %r5, %r6, %r7 = index.assume %add, %sub, %mul, %madd, %and, %or, %xor, %shift [range(%add, -1024, 1024), range(%sub, -1024, 1024), range(%mul, -1024, 1024), range(%madd, -1024, 1024), range(%and, -1024, 1024), range(%or, -1024, 1024), range(%xor, -1024, 1024), range(%shift, -1024, 1024)] : index, index, index, index, index, index, index, index
    %value0 = index.cast %r0 : index to i64
    view.store %value0, %results[%row, 0] : i64, view<4x8xi64>
    %value1 = index.cast %r1 : index to i64
    view.store %value1, %results[%row, 1] : i64, view<4x8xi64>
    %value2 = index.cast %r2 : index to i64
    view.store %value2, %results[%row, 2] : i64, view<4x8xi64>
    %value3 = index.cast %r3 : index to i64
    view.store %value3, %results[%row, 3] : i64, view<4x8xi64>
    %value4 = index.cast %r4 : index to i64
    view.store %value4, %results[%row, 4] : i64, view<4x8xi64>
    %value5 = index.cast %r5 : index to i64
    view.store %value5, %results[%row, 5] : i64, view<4x8xi64>
    %value6 = index.cast %r6 : index to i64
    view.store %value6, %results[%row, 6] : i64, view<4x8xi64>
    %value7 = index.cast %r7 : index to i64
    view.store %value7, %results[%row, 7] : i64, view<4x8xi64>
  }
  func.return
}

func.def @assumed_index_oracle(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %inputs = buffer.view %input[%origin] : buffer -> view<4x3xi32>
  %results = buffer.view %output[%origin] : buffer -> view<4x8xi64>
  scf.for %row = [%begin to %end step %step] {
    %left = view.load %inputs[%row, 0] : view<4x3xi32> -> i32
    %right = view.load %inputs[%row, 1] : view<4x3xi32> -> i32
    %extra = view.load %inputs[%row, 2] : view<4x3xi32> -> i32
    %a = scalar.extsi %left : i32 to i64
    %b = scalar.extsi %right : i32 to i64
    %c = scalar.extsi %extra : i32 to i64
    %count = index.cast %row : index to i64
    %add = scalar.addi %a, %b : i64
    %sub = scalar.subi %a, %b : i64
    %mul = scalar.muli %a, %b : i64
    %madd = scalar.addi %mul, %c : i64
    %and = scalar.andi %a, %b : i64
    %or = scalar.ori %a, %b : i64
    %xor = scalar.xori %a, %b : i64
    %shift = scalar.shli %a, %count : i64
    view.store %add, %results[%row, 0] : i64, view<4x8xi64>
    view.store %sub, %results[%row, 1] : i64, view<4x8xi64>
    view.store %mul, %results[%row, 2] : i64, view<4x8xi64>
    view.store %madd, %results[%row, 3] : i64, view<4x8xi64>
    view.store %and, %results[%row, 4] : i64, view<4x8xi64>
    view.store %or, %results[%row, 5] : i64, view<4x8xi64>
    view.store %xor, %results[%row, 6] : i64, view<4x8xi64>
    view.store %shift, %results[%row, 7] : i64, view<4x8xi64>
  }
  func.return
}

check.scenario @assumed_index_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-5) step(1) : tensor<4x3xi32>
    %storage = check.generate.fill value(-123) : tensor<36xi64>
    %output = check.tensor.view %storage offset(16) : tensor<36xi64> -> tensor<4x8xi64>
    check.compare<@assumed_index_observations, @assumed_index_oracle>(%input, %output) : (tensor<4x3xi32>, tensor<4x8xi64>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<36xi64>
    }
  }
  check.return
}

// Source integers enter the target's index carrier before native arithmetic.
// Runtime inputs fit every target; the subject has no static range promise.
func.def @native_index_entry(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 7 : index
  %step = index.constant 1 : index
  %inputs = buffer.view %input[%origin] : buffer -> view<7xi64>
  %scalar_results = buffer.view %output[%origin] : buffer -> view<7xi64>
  scf.for %row = [%begin to %end step %step] {
    %word = view.load %inputs[%row] : view<7xi64> -> i64
    %position = index.cast %word : i64 to index
    %advanced = index.add %position, %step : index
    %result = index.cast %advanced : index to i64
    view.store %result, %scalar_results[%row] : i64, view<7xi64>
  }
  func.return
}

func.def @native_index_entry_oracle(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 7 : index
  %step = index.constant 1 : index
  %c1 = scalar.constant 1 : i64
  %inputs = buffer.view %input[%origin] : buffer -> view<7xi64>
  %results = buffer.view %output[%origin] : buffer -> view<7xi64>
  scf.for %row = [%begin to %end step %step] {
    %word = view.load %inputs[%row] : view<7xi64> -> i64
    %advanced = scalar.addi %word, %c1 : i64
    view.store %advanced, %results[%row] : i64, view<7xi64>
  }
  func.return
}

check.scenario @native_index_entry_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-3) step(1) : tensor<7xi64>
    %storage = check.generate.fill value(-123) : tensor<9xi64>
    %output = check.tensor.view %storage offset(8) : tensor<9xi64> -> tensor<7xi64>
    check.compare<@native_index_entry, @native_index_entry_oracle>(%input, %output) : (tensor<7xi64>, tensor<7xi64>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<9xi64>
    }
  }
  check.return
}

// Wide bitwise results preserve both words. Mixed-width inputs must extend
// according to their sign, while a small mask can narrow the result again.
func.def @wide_index_bitwise(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %inputs = buffer.view %input[%origin] : buffer -> view<2xi64>
  %results = buffer.view %output[%origin] : buffer -> view<12xi64>
  %left_bits = view.load %inputs[0] : view<2xi64> -> i64
  %right_bits = view.load %inputs[1] : view<2xi64> -> i64
  %word = scalar.trunci %right_bits : i64 to i32
  %unsigned_word = scalar.extui %word : i32 to i64
  %left = index.cast %left_bits : i64 to index
  %right = index.cast %right_bits : i64 to index
  %signed = index.cast %word : i32 to index
  %unsigned = index.cast %unsigned_word : i64 to index
  %positive_mask = index.constant 6148914691236517205 : index
  %negative_mask = index.constant -6148914691236517206 : index
  %byte_mask = index.constant 255 : index
  %wide_and = index.andi %left, %right : index
  %wide_or = index.ori %left, %right : index
  %wide_xor = index.xori %left, %right : index
  %signed_and = index.andi %left, %signed : index
  %signed_or = index.ori %left, %signed : index
  %signed_xor = index.xori %left, %signed : index
  %unsigned_and = index.andi %left, %unsigned : index
  %unsigned_or = index.ori %left, %unsigned : index
  %unsigned_xor = index.xori %left, %unsigned : index
  %masked = index.andi %left, %positive_mask : index
  %toggled = index.xori %left, %negative_mask : index
  %byte = index.andi %left, %byte_mask : index
  %wide_and_bits = index.cast %wide_and : index to i64
  %wide_or_bits = index.cast %wide_or : index to i64
  %wide_xor_bits = index.cast %wide_xor : index to i64
  %signed_and_bits = index.cast %signed_and : index to i64
  %signed_or_bits = index.cast %signed_or : index to i64
  %signed_xor_bits = index.cast %signed_xor : index to i64
  %unsigned_and_bits = index.cast %unsigned_and : index to i64
  %unsigned_or_bits = index.cast %unsigned_or : index to i64
  %unsigned_xor_bits = index.cast %unsigned_xor : index to i64
  %masked_bits = index.cast %masked : index to i64
  %toggled_bits = index.cast %toggled : index to i64
  %byte_bits = index.cast %byte : index to i64
  view.store %wide_and_bits, %results[0] : i64, view<12xi64>
  view.store %wide_or_bits, %results[1] : i64, view<12xi64>
  view.store %wide_xor_bits, %results[2] : i64, view<12xi64>
  view.store %signed_and_bits, %results[3] : i64, view<12xi64>
  view.store %signed_or_bits, %results[4] : i64, view<12xi64>
  view.store %signed_xor_bits, %results[5] : i64, view<12xi64>
  view.store %unsigned_and_bits, %results[6] : i64, view<12xi64>
  view.store %unsigned_or_bits, %results[7] : i64, view<12xi64>
  view.store %unsigned_xor_bits, %results[8] : i64, view<12xi64>
  view.store %masked_bits, %results[9] : i64, view<12xi64>
  view.store %toggled_bits, %results[10] : i64, view<12xi64>
  view.store %byte_bits, %results[11] : i64, view<12xi64>
  func.return
}

func.def @wide_index_bitwise_oracle(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %inputs = buffer.view %input[%origin] : buffer -> view<2xi64>
  %results = buffer.view %output[%origin] : buffer -> view<12xi64>
  %left = view.load %inputs[0] : view<2xi64> -> i64
  %right = view.load %inputs[1] : view<2xi64> -> i64
  %word = scalar.trunci %right : i64 to i32
  %signed = scalar.extsi %word : i32 to i64
  %unsigned = scalar.extui %word : i32 to i64
  %positive_mask = scalar.constant 6148914691236517205 : i64
  %negative_mask = scalar.constant -6148914691236517206 : i64
  %byte_mask = scalar.constant 255 : i64
  %wide_and = scalar.andi %left, %right : i64
  %wide_or = scalar.ori %left, %right : i64
  %wide_xor = scalar.xori %left, %right : i64
  %signed_and = scalar.andi %left, %signed : i64
  %signed_or = scalar.ori %left, %signed : i64
  %signed_xor = scalar.xori %left, %signed : i64
  %unsigned_and = scalar.andi %left, %unsigned : i64
  %unsigned_or = scalar.ori %left, %unsigned : i64
  %unsigned_xor = scalar.xori %left, %unsigned : i64
  %masked = scalar.andi %left, %positive_mask : i64
  %toggled = scalar.xori %left, %negative_mask : i64
  %byte = scalar.andi %left, %byte_mask : i64
  view.store %wide_and, %results[0] : i64, view<12xi64>
  view.store %wide_or, %results[1] : i64, view<12xi64>
  view.store %wide_xor, %results[2] : i64, view<12xi64>
  view.store %signed_and, %results[3] : i64, view<12xi64>
  view.store %signed_or, %results[4] : i64, view<12xi64>
  view.store %signed_xor, %results[5] : i64, view<12xi64>
  view.store %unsigned_and, %results[6] : i64, view<12xi64>
  view.store %unsigned_or, %results[7] : i64, view<12xi64>
  view.store %unsigned_xor, %results[8] : i64, view<12xi64>
  view.store %masked, %results[9] : i64, view<12xi64>
  view.store %toggled, %results[10] : i64, view<12xi64>
  view.store %byte, %results[11] : i64, view<12xi64>
  func.return
}

check.scenario @wide_index_bitwise_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-1) step(4294967296) : tensor<2xi64>
    %output = check.generate.fill value(-123) : tensor<12xi64>
    check.compare<@wide_index_bitwise, @wide_index_bitwise_oracle>(%input, %output) : (tensor<2xi64>, tensor<12xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<12xi64>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(0) step(-9223372036854775808) : tensor<2xi64>
    %output = check.generate.fill value(-123) : tensor<12xi64>
    check.compare<@wide_index_bitwise, @wide_index_bitwise_oracle>(%input, %output) : (tensor<2xi64>, tensor<12xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<12xi64>
    }
  }
  check.trial[16](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-9223372036854775808 to 9223372036854775807) : tensor<2xi64>
    %output = check.generate.fill value(-123) : tensor<12xi64>
    check.compare<@wide_index_bitwise, @wide_index_bitwise_oracle>(%input, %output) : (tensor<2xi64>, tensor<12xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<12xi64>
    }
  }
  check.return
}
