}

// Keeps the production-shaped varying-divisor checks executable on targets
// whose resident workers use buffer-only invocation ABIs.
check.scenario @dynamic_wide_remainder_buffer_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-9223372036854775808) step(2305843009213693951) : tensor<8xi64>
    %output = check.generate.fill value(-123) : tensor<4xi64>
    check.compare<@varying_dynamic_wide_remainders, @varying_dynamic_wide_remainders_oracle>(%input, %output) : (tensor<8xi64>, tensor<4xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi64>
    }
  }
  check.trial[8](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-9223372036854775808 to 9223372036854775807) : tensor<8xi64>
    %output = check.generate.fill value(-123) : tensor<4xi64>
    check.compare<@varying_dynamic_wide_remainders, @varying_dynamic_wide_remainders_oracle>(%input, %output) : (tensor<8xi64>, tensor<4xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi64>
    }
  }
  check.return
}

check.scenario @wide_division_correction_values {
  // Requires the final normalized full-divisor correction.
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %dividend = check.literal value(6134235218366572340) : i64
    %divisor = check.literal value(4879874013) : i64
    check.compare<@division_i64>(%dividend, %divisor) : (i64, i64) -> [actual(%actual_signed_quotient: i64, %actual_signed_remainder: i64, %actual_unsigned_quotient: i64, %actual_unsigned_remainder: i64), expected(%expected_signed_quotient: i64, %expected_signed_remainder: i64, %expected_unsigned_quotient: i64, %expected_unsigned_remainder: i64)] {
      check.expect.equal actual(%actual_signed_quotient) expected(%expected_signed_quotient) : i64
      check.expect.equal actual(%actual_signed_remainder) expected(%expected_signed_remainder) : i64
      check.expect.equal actual(%actual_unsigned_quotient) expected(%expected_unsigned_quotient) : i64
      check.expect.equal actual(%actual_unsigned_remainder) expected(%expected_unsigned_remainder) : i64
    }
  }
  // Requires both corrections of a normalized halfword quotient estimate.
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %dividend = check.literal value(3496223509351386454) : i64
    %divisor = check.literal value(3138737127077) : i64
    check.compare<@division_i64>(%dividend, %divisor) : (i64, i64) -> [actual(%actual_signed_quotient: i64, %actual_signed_remainder: i64, %actual_unsigned_quotient: i64, %actual_unsigned_remainder: i64), expected(%expected_signed_quotient: i64, %expected_signed_remainder: i64, %expected_unsigned_quotient: i64, %expected_unsigned_remainder: i64)] {
      check.expect.equal actual(%actual_signed_quotient) expected(%expected_signed_quotient) : i64
      check.expect.equal actual(%actual_signed_remainder) expected(%expected_signed_remainder) : i64
      check.expect.equal actual(%actual_unsigned_quotient) expected(%expected_unsigned_quotient) : i64
      check.expect.equal actual(%actual_unsigned_remainder) expected(%expected_unsigned_remainder) : i64
    }
  }
  check.return
}

check.scenario @loop_carried_division_values {
  check.trial[8](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-9223372036854775808 to 9223372036854775807) : tensor<2xi64>
    %output = check.generate.fill value(-123) : tensor<4xi64>
    check.compare<@loop_carried_division_buffers>(%input, %output) : (tensor<2xi64>, tensor<4xi64>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<2xi64>
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi64>
