// Signed division rounds toward zero; unsigned division reads all cell bits.
func.def public @division_i32(%dividend: i32, %divisor: i32) -> (i32, i32, i32, i32) {
  %signed_quotient = scalar.divsi %dividend, %divisor : i32
  %signed_remainder = scalar.remsi %dividend, %divisor : i32
  %unsigned_quotient = scalar.divui %dividend, %divisor : i32
  %unsigned_remainder = scalar.remui %dividend, %divisor : i32
  func.return %signed_quotient, %signed_remainder, %unsigned_quotient, %unsigned_remainder : i32, i32, i32, i32
}

// Unlike signed quotient, signed minimum remainder by -1 is exactly zero.
func.def public @minimum_remainder_i32(%dividend: i32, %divisor: i32) -> (i32) {
  %remainder = scalar.remsi %dividend, %divisor : i32
  func.return %remainder : i32
}

// Signed division rounds toward zero; unsigned division reads all cell bits.
func.def public @division_i64(%dividend: i64, %divisor: i64) -> (i64, i64, i64, i64) {
  %signed_quotient = scalar.divsi %dividend, %divisor : i64
  %signed_remainder = scalar.remsi %dividend, %divisor : i64
  %unsigned_quotient = scalar.divui %dividend, %divisor : i64
  %unsigned_remainder = scalar.remui %dividend, %divisor : i64
  func.return %signed_quotient, %signed_remainder, %unsigned_quotient, %unsigned_remainder : i64, i64, i64, i64
}

// Unlike signed quotient, signed minimum remainder by -1 is exactly zero.
func.def public @minimum_remainder_i64(%dividend: i64, %divisor: i64) -> (i64) {
  %remainder = scalar.remsi %dividend, %divisor : i64
  func.return %remainder : i64
}

// Excludes zero divisors and signed minimum divided by negative one from
// generated inputs while retaining arbitrary full-width values elsewhere.
func.def @random_division_i32_observations(%dividend_bits: i64, %divisor_bits: i64) -> (i32, i32, i32, i32) {
  %dividend = scalar.trunci %dividend_bits : i64 to i32
  %divisor = scalar.trunci %divisor_bits : i64 to i32
  %invalid_divisor = scalar.constant 0 : i32
  %safe_divisor_fallback = scalar.constant 1 : i32
  %overflow_divisor = scalar.constant -1 : i32
  %minimum = scalar.constant -2147483648 : i32
  %is_zero = scalar.cmpi eq, %divisor, %invalid_divisor : i32
  %nonzero_divisor = scf.select %is_zero, %safe_divisor_fallback, %divisor : i32
  %is_minimum = scalar.cmpi eq, %dividend, %minimum : i32
  %is_negative_one = scalar.cmpi eq, %nonzero_divisor, %overflow_divisor : i32
  %would_overflow = scalar.andi %is_minimum, %is_negative_one : i1
  %safe_divisor = scf.select %would_overflow, %safe_divisor_fallback, %nonzero_divisor : i32
  %signed_quotient, %signed_remainder, %unsigned_quotient, %unsigned_remainder = func.call @division_i32(%dividend, %safe_divisor) : (i32, i32) -> (i32, i32, i32, i32)
  func.return %signed_quotient, %signed_remainder, %unsigned_quotient, %unsigned_remainder : i32, i32, i32, i32
}

// Exercises constant index divisors whose lowering differs from runtime scalar
// division. Masking to the portable non-negative index range keeps the same
// logical input on 32-bit and 64-bit targets.
func.def @random_constant_index_division_observations(%input_bits: i64) -> (index, index, index, index, index, index, index, index) {
  %index_mask = scalar.constant 2147483647 : i64
  %nonnegative_input = scalar.andi %input_bits, %index_mask : i64
  %index_input = index.cast %nonnegative_input : i64 to index
  %prime_divisor = index.constant 7 : index
  %composite_divisor = index.constant 20 : index
  %high_power = index.constant 2147483648 : index
  %largest = index.constant 4294967295 : index
  %quotient_seven = index.div %index_input, %prime_divisor : index
  %remainder_seven = index.rem %index_input, %prime_divisor : index
  %quotient_twenty = index.div %index_input, %composite_divisor : index
  %remainder_twenty = index.rem %index_input, %composite_divisor : index
  %quotient_high_power = index.div %index_input, %high_power : index
  %remainder_high_power = index.rem %index_input, %high_power : index
  %quotient_largest = index.div %index_input, %largest : index
  %remainder_largest = index.rem %index_input, %largest : index
  func.return %quotient_seven, %remainder_seven, %quotient_twenty, %remainder_twenty, %quotient_high_power, %remainder_high_power, %quotient_largest, %remainder_largest : index, index, index, index, index, index, index, index
}

func.def @random_division_i64_observations(%dividend: i64, %divisor: i64) -> (i64, i64, i64, i64) {
  %invalid_divisor = scalar.constant 0 : i64
  %safe_divisor_fallback = scalar.constant 1 : i64
  %overflow_divisor = scalar.constant -1 : i64
  %minimum = scalar.constant -9223372036854775808 : i64
  %is_zero = scalar.cmpi eq, %divisor, %invalid_divisor : i64
  %nonzero_divisor = scf.select %is_zero, %safe_divisor_fallback, %divisor : i64
  %is_minimum = scalar.cmpi eq, %dividend, %minimum : i64
  %is_negative_one = scalar.cmpi eq, %nonzero_divisor, %overflow_divisor : i64
  %would_overflow = scalar.andi %is_minimum, %is_negative_one : i1
  %safe_divisor = scf.select %would_overflow, %safe_divisor_fallback, %nonzero_divisor : i64
  %signed_quotient, %signed_remainder, %unsigned_quotient, %unsigned_remainder = func.call @division_i64(%dividend, %safe_divisor) : (i64, i64) -> (i64, i64, i64, i64)
  func.return %signed_quotient, %signed_remainder, %unsigned_quotient, %unsigned_remainder : i64, i64, i64, i64
}

// Selects the exact boundary pairs independently from target integer width.
func.def @division_i32_boundary(%ordinal: index) -> (i32, i32, i32, i32) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c6 = index.constant 6 : index
  %c7 = index.constant 7 : index
  %c8 = index.constant 8 : index
  %is0 = index.cmp eq, %ordinal, %c0 : index
  %is1 = index.cmp eq, %ordinal, %c1 : index
  %is2 = index.cmp eq, %ordinal, %c2 : index
  %is3 = index.cmp eq, %ordinal, %c3 : index
  %is4 = index.cmp eq, %ordinal, %c4 : index
  %is5 = index.cmp eq, %ordinal, %c5 : index
  %is6 = index.cmp eq, %ordinal, %c6 : index
  %is7 = index.cmp eq, %ordinal, %c7 : index
  %is8 = index.cmp eq, %ordinal, %c8 : index

  %positive_dividend = scalar.constant 17 : i32
  %negative_dividend = scalar.constant -17 : i32
  %positive_divisor = scalar.constant 5 : i32
  %negative_divisor = scalar.constant -5 : i32
  %halving_divisor = scalar.constant 2 : i32
  %minimum = scalar.constant -2147483648 : i32
  %maximum = scalar.constant 2147483647 : i32
  %opposite_unit = scalar.constant -1 : i32
  %empty_dividend = scalar.constant 0 : i32
  %dividend0 = scf.select %is0, %positive_dividend, %opposite_unit : i32
  %dividend1 = scf.select %is1, %negative_dividend, %dividend0 : i32
  %dividend2 = scf.select %is2, %positive_dividend, %dividend1 : i32
  %dividend3 = scf.select %is3, %negative_dividend, %dividend2 : i32
  %dividend4 = scf.select %is4, %minimum, %dividend3 : i32
  %dividend5 = scf.select %is5, %maximum, %dividend4 : i32
  %dividend6 = scf.select %is6, %opposite_unit, %dividend5 : i32
  %dividend7 = scf.select %is7, %empty_dividend, %dividend6 : i32
  %dividend = scf.select %is8, %minimum, %dividend7 : i32
  %divisor0 = scf.select %is0, %positive_divisor, %minimum : i32
  %divisor1 = scf.select %is1, %positive_divisor, %divisor0 : i32
  %divisor2 = scf.select %is2, %negative_divisor, %divisor1 : i32
  %divisor3 = scf.select %is3, %negative_divisor, %divisor2 : i32
  %divisor4 = scf.select %is4, %halving_divisor, %divisor3 : i32
  %divisor5 = scf.select %is5, %opposite_unit, %divisor4 : i32
  %divisor6 = scf.select %is6, %maximum, %divisor5 : i32
  %divisor7 = scf.select %is7, %opposite_unit, %divisor6 : i32
  %divisor = scf.select %is8, %minimum, %divisor7 : i32
  %signed_quotient, %signed_remainder, %unsigned_quotient, %unsigned_remainder = func.call @division_i32(%dividend, %divisor) : (i32, i32) -> (i32, i32, i32, i32)
  func.return %signed_quotient, %signed_remainder, %unsigned_quotient, %unsigned_remainder : i32, i32, i32, i32
}

func.def @division_i64_boundary(%ordinal: index) -> (i64, i64, i64, i64) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c6 = index.constant 6 : index
  %c7 = index.constant 7 : index
  %c8 = index.constant 8 : index
  %is0 = index.cmp eq, %ordinal, %c0 : index
  %is1 = index.cmp eq, %ordinal, %c1 : index
  %is2 = index.cmp eq, %ordinal, %c2 : index
  %is3 = index.cmp eq, %ordinal, %c3 : index
  %is4 = index.cmp eq, %ordinal, %c4 : index
  %is5 = index.cmp eq, %ordinal, %c5 : index
  %is6 = index.cmp eq, %ordinal, %c6 : index
  %is7 = index.cmp eq, %ordinal, %c7 : index
  %is8 = index.cmp eq, %ordinal, %c8 : index

  %positive_dividend = scalar.constant 17 : i64
  %negative_dividend = scalar.constant -17 : i64
  %positive_divisor = scalar.constant 5 : i64
  %negative_divisor = scalar.constant -5 : i64
  %halving_divisor = scalar.constant 2 : i64
  %minimum = scalar.constant -9223372036854775808 : i64
  %maximum = scalar.constant 9223372036854775807 : i64
  %opposite_unit = scalar.constant -1 : i64
  %empty_dividend = scalar.constant 0 : i64
  %dividend0 = scf.select %is0, %positive_dividend, %opposite_unit : i64
  %dividend1 = scf.select %is1, %negative_dividend, %dividend0 : i64
  %dividend2 = scf.select %is2, %positive_dividend, %dividend1 : i64
  %dividend3 = scf.select %is3, %negative_dividend, %dividend2 : i64
  %dividend4 = scf.select %is4, %minimum, %dividend3 : i64
  %dividend5 = scf.select %is5, %maximum, %dividend4 : i64
  %dividend6 = scf.select %is6, %opposite_unit, %dividend5 : i64
  %dividend7 = scf.select %is7, %empty_dividend, %dividend6 : i64
  %dividend = scf.select %is8, %minimum, %dividend7 : i64
  %divisor0 = scf.select %is0, %positive_divisor, %minimum : i64
  %divisor1 = scf.select %is1, %positive_divisor, %divisor0 : i64
  %divisor2 = scf.select %is2, %negative_divisor, %divisor1 : i64
  %divisor3 = scf.select %is3, %negative_divisor, %divisor2 : i64
  %divisor4 = scf.select %is4, %halving_divisor, %divisor3 : i64
  %divisor5 = scf.select %is5, %opposite_unit, %divisor4 : i64
  %divisor6 = scf.select %is6, %maximum, %divisor5 : i64
  %divisor7 = scf.select %is7, %opposite_unit, %divisor6 : i64
  %divisor = scf.select %is8, %minimum, %divisor7 : i64
  %signed_quotient, %signed_remainder, %unsigned_quotient, %unsigned_remainder = func.call @division_i64(%dividend, %divisor) : (i64, i64) -> (i64, i64, i64, i64)
  func.return %signed_quotient, %signed_remainder, %unsigned_quotient, %unsigned_remainder : i64, i64, i64, i64
}

check.scenario @integer_division_values {
  check.trial[10](%trial: index, %entropy: check.entropy) {
    check.compare<@division_i32_boundary>(%trial) : (index) -> [actual(%actual_signed_quotient: i32, %actual_signed_remainder: i32, %actual_unsigned_quotient: i32, %actual_unsigned_remainder: i32), expected(%expected_signed_quotient: i32, %expected_signed_remainder: i32, %expected_unsigned_quotient: i32, %expected_unsigned_remainder: i32)] {
      check.expect.equal actual(%actual_signed_quotient) expected(%expected_signed_quotient) : i32
      check.expect.equal actual(%actual_signed_remainder) expected(%expected_signed_remainder) : i32
      check.expect.equal actual(%actual_unsigned_quotient) expected(%expected_unsigned_quotient) : i32
      check.expect.equal actual(%actual_unsigned_remainder) expected(%expected_unsigned_remainder) : i32
    }
  }
  check.trial[256](%trial: index, %entropy: check.entropy) {
    %dividend_entropy = check.entropy.fork %entropy name("i32_dividend") : check.entropy
    %divisor_entropy = check.entropy.fork %entropy name("i32_divisor") : check.entropy
    %dividend = check.entropy.read %dividend_entropy[%trial] : check.entropy -> i64
    %divisor = check.entropy.read %divisor_entropy[%trial] : check.entropy -> i64
    check.compare<@random_division_i32_observations>(%dividend, %divisor) : (i64, i64) -> [actual(%actual_signed_quotient: i32, %actual_signed_remainder: i32, %actual_unsigned_quotient: i32, %actual_unsigned_remainder: i32), expected(%expected_signed_quotient: i32, %expected_signed_remainder: i32, %expected_unsigned_quotient: i32, %expected_unsigned_remainder: i32)] {
      check.expect.equal actual(%actual_signed_quotient) expected(%expected_signed_quotient) : i32
      check.expect.equal actual(%actual_signed_remainder) expected(%expected_signed_remainder) : i32
      check.expect.equal actual(%actual_unsigned_quotient) expected(%expected_unsigned_quotient) : i32
      check.expect.equal actual(%actual_unsigned_remainder) expected(%expected_unsigned_remainder) : i32
    }
  }
  check.trial[256](%trial: index, %entropy: check.entropy) {
    %input_entropy = check.entropy.fork %entropy name("constant_index_input") : check.entropy
    %input = check.entropy.read %input_entropy[%trial] : check.entropy -> i64
    check.compare<@random_constant_index_division_observations>(%input) : (i64) -> [actual(%actual_quotient_seven: index, %actual_remainder_seven: index, %actual_quotient_twenty: index, %actual_remainder_twenty: index, %actual_quotient_high_power: index, %actual_remainder_high_power: index, %actual_quotient_largest: index, %actual_remainder_largest: index), expected(%expected_quotient_seven: index, %expected_remainder_seven: index, %expected_quotient_twenty: index, %expected_remainder_twenty: index, %expected_quotient_high_power: index, %expected_remainder_high_power: index, %expected_quotient_largest: index, %expected_remainder_largest: index)] {
      check.expect.equal actual(%actual_quotient_seven) expected(%expected_quotient_seven) : index
      check.expect.equal actual(%actual_remainder_seven) expected(%expected_remainder_seven) : index
      check.expect.equal actual(%actual_quotient_twenty) expected(%expected_quotient_twenty) : index
      check.expect.equal actual(%actual_remainder_twenty) expected(%expected_remainder_twenty) : index
      check.expect.equal actual(%actual_quotient_high_power) expected(%expected_quotient_high_power) : index
      check.expect.equal actual(%actual_remainder_high_power) expected(%expected_remainder_high_power) : index
      check.expect.equal actual(%actual_quotient_largest) expected(%expected_quotient_largest) : index
      check.expect.equal actual(%actual_remainder_largest) expected(%expected_remainder_largest) : index
    }
  }
  check.trial[10](%trial: index, %entropy: check.entropy) {
    check.compare<@division_i64_boundary>(%trial) : (index) -> [actual(%actual_signed_quotient: i64, %actual_signed_remainder: i64, %actual_unsigned_quotient: i64, %actual_unsigned_remainder: i64), expected(%expected_signed_quotient: i64, %expected_signed_remainder: i64, %expected_unsigned_quotient: i64, %expected_unsigned_remainder: i64)] {
      check.expect.equal actual(%actual_signed_quotient) expected(%expected_signed_quotient) : i64
      check.expect.equal actual(%actual_signed_remainder) expected(%expected_signed_remainder) : i64
      check.expect.equal actual(%actual_unsigned_quotient) expected(%expected_unsigned_quotient) : i64
      check.expect.equal actual(%actual_unsigned_remainder) expected(%expected_unsigned_remainder) : i64
    }
  }
  check.trial[256](%trial: index, %entropy: check.entropy) {
    %dividend_entropy = check.entropy.fork %entropy name("i64_dividend") : check.entropy
    %divisor_entropy = check.entropy.fork %entropy name("i64_divisor") : check.entropy
    %dividend = check.entropy.read %dividend_entropy[%trial] : check.entropy -> i64
    %divisor = check.entropy.read %divisor_entropy[%trial] : check.entropy -> i64
    check.compare<@random_division_i64_observations>(%dividend, %divisor) : (i64, i64) -> [actual(%actual_signed_quotient: i64, %actual_signed_remainder: i64, %actual_unsigned_quotient: i64, %actual_unsigned_remainder: i64), expected(%expected_signed_quotient: i64, %expected_signed_remainder: i64, %expected_unsigned_quotient: i64, %expected_unsigned_remainder: i64)] {
      check.expect.equal actual(%actual_signed_quotient) expected(%expected_signed_quotient) : i64
      check.expect.equal actual(%actual_signed_remainder) expected(%expected_signed_remainder) : i64
      check.expect.equal actual(%actual_unsigned_quotient) expected(%expected_unsigned_quotient) : i64
      check.expect.equal actual(%actual_unsigned_remainder) expected(%expected_unsigned_remainder) : i64
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %minimum = check.literal value(-2147483648) : i32
    %negative_one = check.literal value(-1) : i32
    check.compare<@minimum_remainder_i32>(%minimum, %negative_one) : (i32, i32) -> [actual(%actual: i32), expected(%expected: i32)] {
      check.expect.equal actual(%actual) expected(%expected) : i32
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %minimum = check.literal value(-9223372036854775808) : i64
    %negative_one = check.literal value(-1) : i64
    check.compare<@minimum_remainder_i64>(%minimum, %negative_one) : (i64, i64) -> [actual(%actual: i64), expected(%expected: i64)] {
      check.expect.equal actual(%actual) expected(%expected) : i64
    }
  }

  check.return
}
