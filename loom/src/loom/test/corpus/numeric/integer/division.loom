// Signed division rounds toward zero; unsigned division reads all cell bits.
func.def public @division_i32(%dividend: i32, %divisor: i32) -> (i32, i32, i32, i32) {
  %signed_quotient, %signed_remainder = scalar.divremsi %dividend, %divisor : i32
  %unsigned_quotient, %unsigned_remainder = scalar.divremui %dividend, %divisor : i32
  func.return %signed_quotient, %signed_remainder, %unsigned_quotient, %unsigned_remainder : i32, i32, i32, i32
}

// Unlike signed quotient, signed minimum remainder by -1 is exactly zero.
func.def public @minimum_remainder_i32(%dividend: i32, %divisor: i32) -> (i32) {
  %remainder = scalar.remsi %dividend, %divisor : i32
  func.return %remainder : i32
}

// Signed division rounds toward zero; unsigned division reads all cell bits.
func.def @division_i64(%dividend: i64, %divisor: i64) -> (i64, i64, i64, i64) {
  %signed_quotient = scalar.divsi %dividend, %divisor : i64
  %signed_remainder = scalar.remsi %dividend, %divisor : i64
  %unsigned_quotient = scalar.divui %dividend, %divisor : i64
  %unsigned_remainder = scalar.remui %dividend, %divisor : i64
  func.return %signed_quotient, %signed_remainder, %unsigned_quotient, %unsigned_remainder : i64, i64, i64, i64
}

// Unlike signed quotient, signed minimum remainder by -1 is exactly zero.
func.def @minimum_remainder_i64(%dividend: i64, %divisor: i64) -> (i64) {
  %remainder = scalar.remsi %dividend, %divisor : i64
  func.return %remainder : i64
}

// Keeps the complete unsigned dividend while the runtime divisor fits one
// word. The assumption records the public callable contract exercised by the
// inputs below; it does not specialize either operand.
func.def @dynamic_wide_remainder(%dividend: i64, %divisor0: i64) -> (i64) {
  %divisor = scalar.assume %divisor0 [range(%divisor0, 1, 4294967295)] : i64
  %remainder = scalar.remui %dividend, %divisor : i64
  func.return %remainder : i64
}

// Computes production-sized lane-varying remainders with the natural wide
// operation. Divisors are derived from runtime input before the known bound is
// attached, preventing test inputs from specializing the operation.
func.def @varying_dynamic_wide_remainders(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %inputs = buffer.view %input[%base] : buffer -> view<8xi64>
  %results = buffer.view %output[%base] : buffer -> view<4xi64>
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %divisor_limit = scalar.constant 16000889 : i32
  %c1 = scalar.constant 1 : i32
  scf.for %lane = [%begin to %end step %step] {
    %dividend = view.load %inputs[%lane] : view<8xi64> -> i64
    %divisor_position = index.add %lane, %end : index
    %divisor_bits = view.load %inputs[%divisor_position] : view<8xi64> -> i64
    %divisor_word_bits = scalar.trunci %divisor_bits : i64 to i32
    %divisor_reduced = scalar.remui %divisor_word_bits, %divisor_limit : i32
    %divisor_word = scalar.addi %divisor_reduced, %c1 : i32
    %divisor_wide = scalar.extui %divisor_word : i32 to i64
    %divisor = scalar.assume %divisor_wide [range(%divisor_wide, 1, 16000889)] : i64
    %remainder = scalar.remui %dividend, %divisor : i64
    view.store %remainder, %results[%lane] : i64, view<4xi64>
  }
  func.return
}

// Independent source expression for the prior model workaround. It reduces
// the high word and then consumes the low word byte by byte, using only u32
// remainder operations whose inputs cannot overflow for the divisor bound.
func.def @varying_dynamic_wide_remainders_oracle(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %inputs = buffer.view %input[%base] : buffer -> view<8xi64>
  %results = buffer.view %output[%base] : buffer -> view<4xi64>
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %divisor_limit = scalar.constant 16000889 : i32
  %c1 = scalar.constant 1 : i32
  %word_shift = scalar.constant 32 : i64
  %byte_shift = scalar.constant 8 : i32
  %byte_mask = scalar.constant 255 : i32
  %shift_24 = scalar.constant 24 : i32
  %shift_16 = scalar.constant 16 : i32
  scf.for %lane = [%begin to %end step %step] {
    %dividend = view.load %inputs[%lane] : view<8xi64> -> i64
    %divisor_position = index.add %lane, %end : index
    %divisor_bits = view.load %inputs[%divisor_position] : view<8xi64> -> i64
    %divisor_word_bits = scalar.trunci %divisor_bits : i64 to i32
    %divisor_reduced = scalar.remui %divisor_word_bits, %divisor_limit : i32
    %divisor = scalar.addi %divisor_reduced, %c1 : i32

    %low_word = scalar.trunci %dividend : i64 to i32
    %high_wide = scalar.shrui %dividend, %word_shift : i64
    %high_word = scalar.trunci %high_wide : i64 to i32
    %high_remainder = scalar.remui %high_word, %divisor : i32

    %byte3_shifted = scalar.shrui %low_word, %shift_24 : i32
    %byte3 = scalar.andi %byte3_shifted, %byte_mask : i32
    %remainder3_shifted = scalar.shli %high_remainder, %byte_shift : i32
    %combined3 = scalar.ori %remainder3_shifted, %byte3 : i32
    %remainder3 = scalar.remui %combined3, %divisor : i32

    %byte2_shifted = scalar.shrui %low_word, %shift_16 : i32
    %byte2 = scalar.andi %byte2_shifted, %byte_mask : i32
    %remainder2_shifted = scalar.shli %remainder3, %byte_shift : i32
    %combined2 = scalar.ori %remainder2_shifted, %byte2 : i32
    %remainder2 = scalar.remui %combined2, %divisor : i32

    %byte1_shifted = scalar.shrui %low_word, %byte_shift : i32
    %byte1 = scalar.andi %byte1_shifted, %byte_mask : i32
    %remainder1_shifted = scalar.shli %remainder2, %byte_shift : i32
    %combined1 = scalar.ori %remainder1_shifted, %byte1 : i32
    %remainder1 = scalar.remui %combined1, %divisor : i32

    %byte0 = scalar.andi %low_word, %byte_mask : i32
    %remainder0_shifted = scalar.shli %remainder1, %byte_shift : i32
    %combined0 = scalar.ori %remainder0_shifted, %byte0 : i32
    %remainder0 = scalar.remui %combined0, %divisor : i32
    %remainder = scalar.extui %remainder0 : i32 to i64
    view.store %remainder, %results[%lane] : i64, view<4xi64>
  }
  func.return
}

// Excludes zero divisors and signed minimum divided by negative one from
// generated inputs while retaining arbitrary full-width values elsewhere.
func.def @random_division_i32_observations(%dividend_bits: i64, %divisor_bits: i64) -> (i32, i32, i32, i32) {
  %dividend = scalar.trunci %dividend_bits : i64 to i32
  %divisor = scalar.trunci %divisor_bits : i64 to i32
  %invalid_divisor = scalar.constant 0 : i32
  %safe_divisor_fallback = scalar.constant 1 : i32
  %overflow_divisor = scalar.constant -1 : i32
  %minimum = scalar.constant -2147483648 : i32
  %is_zero = scalar.cmpi eq, %divisor, %invalid_divisor : i32
  %nonzero_divisor = scf.select %is_zero, %safe_divisor_fallback, %divisor : i32
  %is_minimum = scalar.cmpi eq, %dividend, %minimum : i32
  %is_negative_one = scalar.cmpi eq, %nonzero_divisor, %overflow_divisor : i32
  %would_overflow = scalar.andi %is_minimum, %is_negative_one : i1
  %safe_divisor = scf.select %would_overflow, %safe_divisor_fallback, %nonzero_divisor : i32
  %signed_quotient, %signed_remainder, %unsigned_quotient, %unsigned_remainder = func.call @division_i32(%dividend, %safe_divisor) : (i32, i32) -> (i32, i32, i32, i32)
  func.return %signed_quotient, %signed_remainder, %unsigned_quotient, %unsigned_remainder : i32, i32, i32, i32
}

// Buffer loads force varying division while narrow values exercise the shared
// widening legalization. Divisors remain runtime values after invalid signed
// and zero cases are mapped into the operation domains.
func.def @varying_dynamic_division_observations(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %inputs = buffer.view %input[%base] : buffer -> view<2xi32>
  %outputs = buffer.view %output[%base] : buffer -> view<12xi32>
  %dividend_i32 = view.load %inputs[0] : view<2xi32> -> i32
  %divisor_i32 = view.load %inputs[1] : view<2xi32> -> i32

  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %cn1_i32 = scalar.constant -1 : i32
  %minimum_i32 = scalar.constant -2147483648 : i32
  %divisor_i32_is_zero = scalar.cmpi eq, %divisor_i32, %c0_i32 : i32
  %unsigned_divisor_i32 = scf.select %divisor_i32_is_zero, %c1_i32, %divisor_i32 : i32
  %dividend_i32_is_minimum = scalar.cmpi eq, %dividend_i32, %minimum_i32 : i32
  %divisor_i32_is_negative_one = scalar.cmpi eq, %unsigned_divisor_i32, %cn1_i32 : i32
  %division_i32_would_overflow = scalar.andi %dividend_i32_is_minimum, %divisor_i32_is_negative_one : i1
  %signed_divisor_i32 = scf.select %division_i32_would_overflow, %c1_i32, %unsigned_divisor_i32 : i32
  %signed_quotient_i32 = scalar.divsi %dividend_i32, %signed_divisor_i32 : i32
  %signed_remainder_i32 = scalar.remsi %dividend_i32, %signed_divisor_i32 : i32
  %unsigned_quotient_i32 = scalar.divui %dividend_i32, %unsigned_divisor_i32 : i32
  %unsigned_remainder_i32 = scalar.remui %dividend_i32, %unsigned_divisor_i32 : i32

  %dividend_i16 = scalar.trunci %dividend_i32 : i32 to i16
  %divisor_i16 = scalar.trunci %divisor_i32 : i32 to i16
  %c0_i16 = scalar.constant 0 : i16
  %c1_i16 = scalar.constant 1 : i16
  %cn1_i16 = scalar.constant -1 : i16
  %minimum_i16 = scalar.constant -32768 : i16
  %divisor_i16_is_zero = scalar.cmpi eq, %divisor_i16, %c0_i16 : i16
  %unsigned_divisor_i16 = scf.select %divisor_i16_is_zero, %c1_i16, %divisor_i16 : i16
  %dividend_i16_is_minimum = scalar.cmpi eq, %dividend_i16, %minimum_i16 : i16
  %divisor_i16_is_negative_one = scalar.cmpi eq, %unsigned_divisor_i16, %cn1_i16 : i16
  %division_i16_would_overflow = scalar.andi %dividend_i16_is_minimum, %divisor_i16_is_negative_one : i1
  %signed_divisor_i16 = scf.select %division_i16_would_overflow, %c1_i16, %unsigned_divisor_i16 : i16
  %signed_quotient_i16, %signed_remainder_i16 = scalar.divremsi %dividend_i16, %signed_divisor_i16 : i16
  %unsigned_quotient_i16, %unsigned_remainder_i16 = scalar.divremui %dividend_i16, %unsigned_divisor_i16 : i16
  %signed_quotient_i16_word = scalar.extsi %signed_quotient_i16 : i16 to i32
  %signed_remainder_i16_word = scalar.extsi %signed_remainder_i16 : i16 to i32
  %unsigned_quotient_i16_word = scalar.extui %unsigned_quotient_i16 : i16 to i32
  %unsigned_remainder_i16_word = scalar.extui %unsigned_remainder_i16 : i16 to i32

  %dividend_i8 = scalar.trunci %dividend_i32 : i32 to i8
  %divisor_i8 = scalar.trunci %divisor_i32 : i32 to i8
  %c0_i8 = scalar.constant 0 : i8
  %c1_i8 = scalar.constant 1 : i8
  %cn1_i8 = scalar.constant -1 : i8
  %minimum_i8 = scalar.constant -128 : i8
  %divisor_i8_is_zero = scalar.cmpi eq, %divisor_i8, %c0_i8 : i8
  %unsigned_divisor_i8 = scf.select %divisor_i8_is_zero, %c1_i8, %divisor_i8 : i8
  %dividend_i8_is_minimum = scalar.cmpi eq, %dividend_i8, %minimum_i8 : i8
  %divisor_i8_is_negative_one = scalar.cmpi eq, %unsigned_divisor_i8, %cn1_i8 : i8
  %division_i8_would_overflow = scalar.andi %dividend_i8_is_minimum, %divisor_i8_is_negative_one : i1
  %signed_divisor_i8 = scf.select %division_i8_would_overflow, %c1_i8, %unsigned_divisor_i8 : i8
  %signed_quotient_i8, %signed_remainder_i8 = scalar.divremsi %dividend_i8, %signed_divisor_i8 : i8
  %unsigned_quotient_i8, %unsigned_remainder_i8 = scalar.divremui %dividend_i8, %unsigned_divisor_i8 : i8
  %signed_quotient_i8_word = scalar.extsi %signed_quotient_i8 : i8 to i32
  %signed_remainder_i8_word = scalar.extsi %signed_remainder_i8 : i8 to i32
  %unsigned_quotient_i8_word = scalar.extui %unsigned_quotient_i8 : i8 to i32
  %unsigned_remainder_i8_word = scalar.extui %unsigned_remainder_i8 : i8 to i32

  %observations = vector.from_elements %signed_quotient_i32, %signed_remainder_i32, %unsigned_quotient_i32, %unsigned_remainder_i32, %signed_quotient_i16_word, %signed_remainder_i16_word, %unsigned_quotient_i16_word, %unsigned_remainder_i16_word, %signed_quotient_i8_word, %signed_remainder_i8_word, %unsigned_quotient_i8_word, %unsigned_remainder_i8_word : vector<12xi32>
  vector.store %observations, %outputs[0] : vector<12xi32>, view<12xi32>
  func.return
}

// Exercises constant index divisors whose lowering differs from runtime scalar
// division. Masking to the portable non-negative index range keeps the same
// logical input on 32-bit and 64-bit targets.
func.def @random_constant_index_division_observations(%input_bits: i64) -> (index, index, index, index, index, index, index, index) {
  %index_mask = scalar.constant 2147483647 : i64
  %nonnegative_input = scalar.andi %input_bits, %index_mask : i64
  %index_input = index.cast %nonnegative_input : i64 to index
  %prime_divisor = index.constant 7 : index
  %composite_divisor = index.constant 20 : index
  %high_power = index.constant 2147483648 : index
  %largest = index.constant 4294967295 : index
  %quotient_seven = index.div %index_input, %prime_divisor : index
  %remainder_seven = index.rem %index_input, %prime_divisor : index
  %quotient_twenty = index.div %index_input, %composite_divisor : index
  %remainder_twenty = index.rem %index_input, %composite_divisor : index
  %quotient_high_power = index.div %index_input, %high_power : index
  %remainder_high_power = index.rem %index_input, %high_power : index
  %quotient_largest = index.div %index_input, %largest : index
  %remainder_largest = index.rem %index_input, %largest : index
  func.return %quotient_seven, %remainder_seven, %quotient_twenty, %remainder_twenty, %quotient_high_power, %remainder_high_power, %quotient_largest, %remainder_largest : index, index, index, index, index, index, index, index
}

func.def @random_division_i64_observations(%dividend: i64, %divisor: i64) -> (i64, i64, i64, i64) {
  %invalid_divisor = scalar.constant 0 : i64
  %safe_divisor_fallback = scalar.constant 1 : i64
  %overflow_divisor = scalar.constant -1 : i64
  %minimum = scalar.constant -9223372036854775808 : i64
  %is_zero = scalar.cmpi eq, %divisor, %invalid_divisor : i64
  %nonzero_divisor = scf.select %is_zero, %safe_divisor_fallback, %divisor : i64
  %is_minimum = scalar.cmpi eq, %dividend, %minimum : i64
  %is_negative_one = scalar.cmpi eq, %nonzero_divisor, %overflow_divisor : i64
  %would_overflow = scalar.andi %is_minimum, %is_negative_one : i1
  %safe_divisor = scf.select %would_overflow, %safe_divisor_fallback, %nonzero_divisor : i64
  %signed_quotient, %signed_remainder, %unsigned_quotient, %unsigned_remainder = func.call @division_i64(%dividend, %safe_divisor) : (i64, i64) -> (i64, i64, i64, i64)
  func.return %signed_quotient, %signed_remainder, %unsigned_quotient, %unsigned_remainder : i64, i64, i64, i64
}

// Both quotient and remainder cross a recurrence backedge. Input values stay
// runtime operands, and rotating the dividend retains its full-width domain.
func.def @loop_carried_division(%initial: i64, %divisor: i64) -> (i64, i64) {
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %shift = scalar.constant 32 : i64
  %increment = scalar.constant -7046029254386353131 : i64
  %initial_checksum = scalar.constant 0 : i64
  %final, %checksum = scf.for %iteration = [%begin to %end step %step](%value = %initial : i64, %accumulator = %initial_checksum : i64) -> (i64, i64) {
    %signed_quotient, %signed_remainder, %unsigned_quotient, %unsigned_remainder = func.call @random_division_i64_observations(%value, %divisor) : (i64, i64) -> (i64, i64, i64, i64)
    %high = scalar.shli %value, %shift : i64
    %low = scalar.shrui %value, %shift : i64
    %rotated = scalar.ori %high, %low : i64
    %mixed = scalar.xori %rotated, %unsigned_quotient : i64
    %next = scalar.addi %mixed, %increment : i64
    %remainders = scalar.xori %signed_remainder, %unsigned_remainder : i64
    %observations = scalar.addi %remainders, %signed_quotient : i64
    %next_accumulator = scalar.addi %accumulator, %observations : i64
    scf.yield %next, %next_accumulator : i64, i64
  }
  func.return %final, %checksum : i64, i64
}

func.def @loop_carried_division_buffers(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %inputs = buffer.view %input[%base] : buffer -> view<2xi64>
  %outputs = buffer.view %output[%base] : buffer -> view<4xi64>
  %dividend = view.load %inputs[0] : view<2xi64> -> i64
  %divisor = view.load %inputs[1] : view<2xi64> -> i64
  %final, %checksum = func.call @loop_carried_division(%dividend, %divisor) : (i64, i64) -> (i64, i64)
  view.store %final, %outputs[1] : i64, view<4xi64>
  view.store %checksum, %outputs[2] : i64, view<4xi64>
  func.return
}

// Selects the exact boundary pairs independently from target integer width.
func.def @division_i32_boundary(%ordinal: index) -> (i32, i32, i32, i32) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c6 = index.constant 6 : index
  %c7 = index.constant 7 : index
  %c8 = index.constant 8 : index
  %is0 = index.cmp eq, %ordinal, %c0 : index
  %is1 = index.cmp eq, %ordinal, %c1 : index
  %is2 = index.cmp eq, %ordinal, %c2 : index
  %is3 = index.cmp eq, %ordinal, %c3 : index
  %is4 = index.cmp eq, %ordinal, %c4 : index
  %is5 = index.cmp eq, %ordinal, %c5 : index
  %is6 = index.cmp eq, %ordinal, %c6 : index
  %is7 = index.cmp eq, %ordinal, %c7 : index
  %is8 = index.cmp eq, %ordinal, %c8 : index

  %positive_dividend = scalar.constant 17 : i32
  %negative_dividend = scalar.constant -17 : i32
  %positive_divisor = scalar.constant 5 : i32
  %negative_divisor = scalar.constant -5 : i32
  %halving_divisor = scalar.constant 2 : i32
  %minimum = scalar.constant -2147483648 : i32
  %maximum = scalar.constant 2147483647 : i32
  %opposite_unit = scalar.constant -1 : i32
  %empty_dividend = scalar.constant 0 : i32
  %dividend0 = scf.select %is0, %positive_dividend, %opposite_unit : i32
  %dividend1 = scf.select %is1, %negative_dividend, %dividend0 : i32
  %dividend2 = scf.select %is2, %positive_dividend, %dividend1 : i32
  %dividend3 = scf.select %is3, %negative_dividend, %dividend2 : i32
  %dividend4 = scf.select %is4, %minimum, %dividend3 : i32
  %dividend5 = scf.select %is5, %maximum, %dividend4 : i32
  %dividend6 = scf.select %is6, %opposite_unit, %dividend5 : i32
  %dividend7 = scf.select %is7, %empty_dividend, %dividend6 : i32
  %dividend = scf.select %is8, %minimum, %dividend7 : i32
  %divisor0 = scf.select %is0, %positive_divisor, %minimum : i32
  %divisor1 = scf.select %is1, %positive_divisor, %divisor0 : i32
  %divisor2 = scf.select %is2, %negative_divisor, %divisor1 : i32
  %divisor3 = scf.select %is3, %negative_divisor, %divisor2 : i32
  %divisor4 = scf.select %is4, %halving_divisor, %divisor3 : i32
  %divisor5 = scf.select %is5, %opposite_unit, %divisor4 : i32
  %divisor6 = scf.select %is6, %maximum, %divisor5 : i32
  %divisor7 = scf.select %is7, %opposite_unit, %divisor6 : i32
  %divisor = scf.select %is8, %minimum, %divisor7 : i32
  %signed_quotient, %signed_remainder, %unsigned_quotient, %unsigned_remainder = func.call @division_i32(%dividend, %divisor) : (i32, i32) -> (i32, i32, i32, i32)
  func.return %signed_quotient, %signed_remainder, %unsigned_quotient, %unsigned_remainder : i32, i32, i32, i32
}

// Loaded operands mix byte, word, just-over-word, and unrestricted divisors.
// Fused signed and unsigned results exercise the same operation family through
// varying registers; the full output buffer also checks untouched guard words.
func.def @varying_wide_division(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %output_base = index.constant 64 : offset
  %inputs = buffer.view %input[%base] : buffer -> view<16xi64>
  %outputs = buffer.view %output[%output_base] : buffer -> view<4x8xi64>
  %begin = index.constant 0 : index
  %end = index.constant 8 : index
  %step = index.constant 1 : index
  %divisor_kind_count = index.constant 4 : index
  %word_kind = index.constant 1 : index
  %wide_kind = index.constant 2 : index
  %byte_mask = scalar.constant 255 : i64
  %word_mask = scalar.constant 4294967295 : i64
  %wide_bit = scalar.constant 4294967296 : i64
  %c0 = scalar.constant 0 : i64
  %unit = scalar.constant 1 : i64
  %minimum = scalar.constant -9223372036854775808 : i64
  %overflow_divisor = scalar.constant -1 : i64
  scf.for %lane = [%begin to %end step %step] {
    %dividend = view.load %inputs[%lane] : view<16xi64> -> i64
    %divisor_position = index.add %lane, %end : index
    %bits = view.load %inputs[%divisor_position] : view<16xi64> -> i64
    %byte = scalar.andi %bits, %byte_mask : i64
    %word = scalar.andi %bits, %word_mask : i64
    %wide = scalar.ori %word, %wide_bit : i64
    %kind = index.rem %lane, %divisor_kind_count : index
    %is_byte = index.cmp eq, %kind, %begin : index
    %is_word = index.cmp eq, %kind, %word_kind : index
    %is_wide = index.cmp eq, %kind, %wide_kind : index
    %divisor0 = scf.select %is_byte, %byte, %bits : i64
    %divisor1 = scf.select %is_word, %word, %divisor0 : i64
    %divisor2 = scf.select %is_wide, %wide, %divisor1 : i64
    %is_zero = scalar.cmpi eq, %divisor2, %c0 : i64
    %nonzero = scf.select %is_zero, %unit, %divisor2 : i64
    %is_minimum = scalar.cmpi eq, %dividend, %minimum : i64
    %is_negative_one = scalar.cmpi eq, %nonzero, %overflow_divisor : i64
    %would_overflow = scalar.andi %is_minimum, %is_negative_one : i1
    %divisor = scf.select %would_overflow, %unit, %nonzero : i64
    %signed_quotient, %signed_remainder = scalar.divremsi %dividend, %divisor : i64
    view.store %signed_quotient, %outputs[0, %lane] : i64, view<4x8xi64>
    view.store %signed_remainder, %outputs[1, %lane] : i64, view<4x8xi64>
    %unsigned_quotient, %unsigned_remainder = scalar.divremui %dividend, %divisor : i64
    view.store %unsigned_quotient, %outputs[2, %lane] : i64, view<4x8xi64>
    view.store %unsigned_remainder, %outputs[3, %lane] : i64, view<4x8xi64>
  }
  func.return
}

// Vector operands are loaded at runtime; positive divisors avoid the signed
// minimum/-1 overflow case while retaining the entire positive i64 domain.
func.def @varying_wide_vector_division(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %inputs = buffer.view %input[%base] : buffer -> view<16xi64>
  %outputs = buffer.view %output[%base] : buffer -> view<48xi64>
  %dividends = vector.load %inputs[0] : view<16xi64> -> vector<2xi64>
  %bits = vector.load %inputs[8] : view<16xi64> -> vector<2xi64>
  %mask = scalar.constant 9223372036854775807 : i64
  %unit = scalar.constant 1 : i64
  %masks = vector.splat %mask : vector<2xi64>
  %units = vector.splat %unit : vector<2xi64>
  %positive_bits = vector.andi %bits, %masks : vector<2xi64>
  %divisors = vector.ori %positive_bits, %units : vector<2xi64>
  %signed_quotients = vector.divsi %dividends, %divisors : vector<2xi64>
  vector.store %signed_quotients, %outputs[8] : vector<2xi64>, view<48xi64>
  %signed_remainders = vector.remsi %dividends, %divisors : vector<2xi64>
  vector.store %signed_remainders, %outputs[10] : vector<2xi64>, view<48xi64>
  %unsigned_quotients = vector.divui %dividends, %divisors : vector<2xi64>
  vector.store %unsigned_quotients, %outputs[12] : vector<2xi64>, view<48xi64>
  %unsigned_remainders = vector.remui %dividends, %divisors : vector<2xi64>
  vector.store %unsigned_remainders, %outputs[14] : vector<2xi64>, view<48xi64>
  func.return
}

func.def @dynamic_index_division(%dividend_bits: i64, %divisor_bits: i64) -> (index, index) {
  %mask = scalar.constant 9223372036854775807 : i64
  %unit = scalar.constant 1 : i64
  %positive_dividend = scalar.andi %dividend_bits, %mask : i64
  %positive_divisor = scalar.andi %divisor_bits, %mask : i64
  %nonzero_divisor = scalar.ori %positive_divisor, %unit : i64
  %dividend = index.cast %positive_dividend : i64 to index
  %divisor = index.cast %nonzero_divisor : i64 to index
  %quotient, %remainder = index.divrem %dividend, %divisor : index
  func.return %quotient, %remainder : index, index
}

func.def @division_i64_boundary(%ordinal: index) -> (i64, i64, i64, i64) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c6 = index.constant 6 : index
  %c7 = index.constant 7 : index
  %c8 = index.constant 8 : index
  %is0 = index.cmp eq, %ordinal, %c0 : index
  %is1 = index.cmp eq, %ordinal, %c1 : index
  %is2 = index.cmp eq, %ordinal, %c2 : index
  %is3 = index.cmp eq, %ordinal, %c3 : index
  %is4 = index.cmp eq, %ordinal, %c4 : index
  %is5 = index.cmp eq, %ordinal, %c5 : index
  %is6 = index.cmp eq, %ordinal, %c6 : index
  %is7 = index.cmp eq, %ordinal, %c7 : index
  %is8 = index.cmp eq, %ordinal, %c8 : index

  %positive_dividend = scalar.constant 17 : i64
  %negative_dividend = scalar.constant -17 : i64
  %positive_divisor = scalar.constant 5 : i64
  %negative_divisor = scalar.constant -5 : i64
  %halving_divisor = scalar.constant 2 : i64
  %minimum = scalar.constant -9223372036854775808 : i64
  %maximum = scalar.constant 9223372036854775807 : i64
  %opposite_unit = scalar.constant -1 : i64
  %empty_dividend = scalar.constant 0 : i64
  %dividend0 = scf.select %is0, %positive_dividend, %opposite_unit : i64
  %dividend1 = scf.select %is1, %negative_dividend, %dividend0 : i64
  %dividend2 = scf.select %is2, %positive_dividend, %dividend1 : i64
  %dividend3 = scf.select %is3, %negative_dividend, %dividend2 : i64
  %dividend4 = scf.select %is4, %minimum, %dividend3 : i64
  %dividend5 = scf.select %is5, %maximum, %dividend4 : i64
  %dividend6 = scf.select %is6, %opposite_unit, %dividend5 : i64
  %dividend7 = scf.select %is7, %empty_dividend, %dividend6 : i64
  %dividend = scf.select %is8, %minimum, %dividend7 : i64
  %divisor0 = scf.select %is0, %positive_divisor, %minimum : i64
  %divisor1 = scf.select %is1, %positive_divisor, %divisor0 : i64
  %divisor2 = scf.select %is2, %negative_divisor, %divisor1 : i64
  %divisor3 = scf.select %is3, %negative_divisor, %divisor2 : i64
  %divisor4 = scf.select %is4, %halving_divisor, %divisor3 : i64
  %divisor5 = scf.select %is5, %opposite_unit, %divisor4 : i64
  %divisor6 = scf.select %is6, %maximum, %divisor5 : i64
  %divisor7 = scf.select %is7, %opposite_unit, %divisor6 : i64
  %divisor = scf.select %is8, %minimum, %divisor7 : i64
  %signed_quotient, %signed_remainder, %unsigned_quotient, %unsigned_remainder = func.call @division_i64(%dividend, %divisor) : (i64, i64) -> (i64, i64, i64, i64)
  func.return %signed_quotient, %signed_remainder, %unsigned_quotient, %unsigned_remainder : i64, i64, i64, i64
}

// Decode a flat coordinate into runtime rows and columns. Separate authored
// div/rem operations exercise combining, native pairs, and reference lowering.
// The dimensions are computed once per invocation and every active element is
// read once; the two extra positions exercise the exact end and inactive tail.
func.def @runtime_coordinate_lookup(%input: buffer, %output: buffer, %rows_input: index, %columns_input: index) {
  %rows_zero_based = index.assume %rows_input [range(%rows_input, 0, 7)] : index
  %columns_zero_based = index.assume %columns_input [range(%columns_input, 0, 7)] : index
  %begin = index.constant 0 : index
  %unit = index.constant 1 : index
  %end = index.constant 66 : index
  %base = index.constant 0 : offset
  %rows = index.add %rows_zero_based, %unit : index
  %columns = index.add %columns_zero_based, %unit : index
  %count = index.mul %rows, %columns : index
  %source = buffer.view %input[%base] : buffer -> view<[%rows]x[%columns]xi32>
  %destination = buffer.view %output[%base] : buffer -> view<66xi32>
  scf.for %linear = [%begin to %end step %unit] {
    %active = index.cmp ult, %linear, %count : index
    %result = scf.if %active -> (i32) {
      %row = index.div %linear, %columns : index
      %column = index.rem %linear, %columns : index
      %value = view.load %source[%row, %column] : view<[%rows]x[%columns]xi32> -> i32
      scf.yield %value : i32
    } else {
      %inactive = scalar.constant -12345 : i32
      scf.yield %inactive : i32
    }
    view.store %result, %destination[%linear] : i32, view<66xi32>
  }
  func.return
}

// A flat lookup supplies the same values without division, remainder, or
// runtime-shaped addressing. The output retains guards on both sides.
func.def @runtime_coordinate_lookup_oracle(%input: buffer, %output: buffer, %rows_input: index, %columns_input: index) {
  %rows_zero_based = index.assume %rows_input [range(%rows_input, 0, 7)] : index
  %columns_zero_based = index.assume %columns_input [range(%columns_input, 0, 7)] : index
  %begin = index.constant 0 : index
  %unit = index.constant 1 : index
  %end = index.constant 66 : index
  %base = index.constant 0 : offset
  %rows = index.add %rows_zero_based, %unit : index
  %columns = index.add %columns_zero_based, %unit : index
  %count = index.mul %rows, %columns : index
  %source = buffer.view %input[%base] : buffer -> view<64xi32>
  %destination = buffer.view %output[%base] : buffer -> view<66xi32>
  scf.for %linear = [%begin to %end step %unit] {
    %active = index.cmp ult, %linear, %count : index
    %result = scf.if %active -> (i32) {
      %value = view.load %source[%linear] : view<64xi32> -> i32
      scf.yield %value : i32
    } else {
      %inactive = scalar.constant -12345 : i32
      scf.yield %inactive : i32
    }
    view.store %result, %destination[%linear] : i32, view<66xi32>
  }
  func.return
}

check.scenario @integer_division_i32_values {
  check.trial[10](%trial: index, %entropy: check.entropy) {
    check.compare<@division_i32_boundary>(%trial) : (index) -> [actual(%actual_signed_quotient: i32, %actual_signed_remainder: i32, %actual_unsigned_quotient: i32, %actual_unsigned_remainder: i32), expected(%expected_signed_quotient: i32, %expected_signed_remainder: i32, %expected_unsigned_quotient: i32, %expected_unsigned_remainder: i32)] {
      check.expect.equal actual(%actual_signed_quotient) expected(%expected_signed_quotient) : i32
      check.expect.equal actual(%actual_signed_remainder) expected(%expected_signed_remainder) : i32
      check.expect.equal actual(%actual_unsigned_quotient) expected(%expected_unsigned_quotient) : i32
      check.expect.equal actual(%actual_unsigned_remainder) expected(%expected_unsigned_remainder) : i32
    }
  }
  check.trial[256](%trial: index, %entropy: check.entropy) {
    %dividend_entropy = check.entropy.fork %entropy name("i32_dividend") : check.entropy
    %divisor_entropy = check.entropy.fork %entropy name("i32_divisor") : check.entropy
    %dividend = check.entropy.read %dividend_entropy[%trial] : check.entropy -> i64
    %divisor = check.entropy.read %divisor_entropy[%trial] : check.entropy -> i64
    check.compare<@random_division_i32_observations>(%dividend, %divisor) : (i64, i64) -> [actual(%actual_signed_quotient: i32, %actual_signed_remainder: i32, %actual_unsigned_quotient: i32, %actual_unsigned_remainder: i32), expected(%expected_signed_quotient: i32, %expected_signed_remainder: i32, %expected_unsigned_quotient: i32, %expected_unsigned_remainder: i32)] {
      check.expect.equal actual(%actual_signed_quotient) expected(%expected_signed_quotient) : i32
      check.expect.equal actual(%actual_signed_remainder) expected(%expected_signed_remainder) : i32
      check.expect.equal actual(%actual_unsigned_quotient) expected(%expected_unsigned_quotient) : i32
      check.expect.equal actual(%actual_unsigned_remainder) expected(%expected_unsigned_remainder) : i32
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-2147483648) step(2147483647) : tensor<2xi32>
    %output = check.generate.fill value(-123) : tensor<12xi32>
    check.compare<@varying_dynamic_division_observations>(%input, %output) : (tensor<2xi32>, tensor<12xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<12xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-32768) step(32771) : tensor<2xi32>
    %output = check.generate.fill value(-123) : tensor<12xi32>
    check.compare<@varying_dynamic_division_observations>(%input, %output) : (tensor<2xi32>, tensor<12xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<12xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-128) step(131) : tensor<2xi32>
    %output = check.generate.fill value(-123) : tensor<12xi32>
    check.compare<@varying_dynamic_division_observations>(%input, %output) : (tensor<2xi32>, tensor<12xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<12xi32>
    }
  }
  check.trial[256](%trial: index, %entropy: check.entropy) {
    %input_entropy = check.entropy.fork %entropy name("varying_division_input") : check.entropy
    %seed = check.entropy.read %input_entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-2147483648 to 2147483647) : tensor<2xi32>
    %output = check.generate.fill value(-123) : tensor<12xi32>
    check.compare<@varying_dynamic_division_observations>(%input, %output) : (tensor<2xi32>, tensor<12xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<12xi32>
    }
  }
  check.trial[256](%trial: index, %entropy: check.entropy) {
    %input_entropy = check.entropy.fork %entropy name("constant_index_input") : check.entropy
    %input = check.entropy.read %input_entropy[%trial] : check.entropy -> i64
    check.compare<@random_constant_index_division_observations>(%input) : (i64) -> [actual(%actual_quotient_seven: index, %actual_remainder_seven: index, %actual_quotient_twenty: index, %actual_remainder_twenty: index, %actual_quotient_high_power: index, %actual_remainder_high_power: index, %actual_quotient_largest: index, %actual_remainder_largest: index), expected(%expected_quotient_seven: index, %expected_remainder_seven: index, %expected_quotient_twenty: index, %expected_remainder_twenty: index, %expected_quotient_high_power: index, %expected_remainder_high_power: index, %expected_quotient_largest: index, %expected_remainder_largest: index)] {
      check.expect.equal actual(%actual_quotient_seven) expected(%expected_quotient_seven) : index
      check.expect.equal actual(%actual_remainder_seven) expected(%expected_remainder_seven) : index
      check.expect.equal actual(%actual_quotient_twenty) expected(%expected_quotient_twenty) : index
      check.expect.equal actual(%actual_remainder_twenty) expected(%expected_remainder_twenty) : index
      check.expect.equal actual(%actual_quotient_high_power) expected(%expected_quotient_high_power) : index
      check.expect.equal actual(%actual_remainder_high_power) expected(%expected_remainder_high_power) : index
      check.expect.equal actual(%actual_quotient_largest) expected(%expected_quotient_largest) : index
      check.expect.equal actual(%actual_remainder_largest) expected(%expected_remainder_largest) : index
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %minimum = check.literal value(-2147483648) : i32
    %negative_one = check.literal value(-1) : i32
    check.compare<@minimum_remainder_i32>(%minimum, %negative_one) : (i32, i32) -> [actual(%actual: i32), expected(%expected: i32)] {
      check.expect.equal actual(%actual) expected(%expected) : i32
    }
  }

  check.return
}

