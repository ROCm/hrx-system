  }
  check.return
}

check.scenario @wide_division_buffer_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-9223372036854775808) step(1229782938247303441) : tensor<16xi64>
    %output = check.generate.fill value(-123) : tensor<48xi64>
    check.compare<@varying_wide_division>(%input, %output) : (tensor<16xi64>, tensor<48xi64>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<16xi64>
      check.expect.bitwise actual(%output) expected(%output) : tensor<48xi64>
    }
  }
  check.trial[16](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-9223372036854775808 to 9223372036854775807) : tensor<16xi64>
    %output = check.generate.fill value(-123) : tensor<48xi64>
    check.compare<@varying_wide_division>(%input, %output) : (tensor<16xi64>, tensor<48xi64>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<16xi64>
      check.expect.bitwise actual(%output) expected(%output) : tensor<48xi64>
    }
  }
  check.return
}

check.scenario @wide_vector_division_buffer_values {
