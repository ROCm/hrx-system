// This scenario requires the full signed 64-bit index carrier.
check.scenario @wide_index_division_values {
  check.trial[32](%trial: index, %entropy: check.entropy) {
    %dividend_entropy = check.entropy.fork %entropy name("index-dividend") : check.entropy
    %divisor_entropy = check.entropy.fork %entropy name("index-divisor") : check.entropy
    %dividend = check.entropy.read %dividend_entropy[%trial] : check.entropy -> i64
    %divisor = check.entropy.read %divisor_entropy[%trial] : check.entropy -> i64
    check.compare<@dynamic_index_division>(%dividend, %divisor) : (i64, i64) -> [actual(%actual_quotient: index, %actual_remainder: index), expected(%expected_quotient: index, %expected_remainder: index)] {
      check.expect.equal actual(%actual_quotient) expected(%expected_quotient) : index
      check.expect.equal actual(%actual_remainder) expected(%expected_remainder) : index
    }
  }

  check.return
}

check.scenario @runtime_coordinate_lookup_values configure[8](%rows: index, %configuration_entropy: check.entropy) {
  check.trial[8](%columns: index, %entropy: check.entropy) {
    %input_storage = check.generate.iota offset(-311) step(7) : tensor<72xi32>
    %output_storage = check.generate.fill value(-889275714) : tensor<74xi32>
    %input = check.tensor.view %input_storage offset(16) : tensor<72xi32> -> tensor<64xi32>
    %output = check.tensor.view %output_storage offset(16) : tensor<74xi32> -> tensor<66xi32>
    check.compare<@runtime_coordinate_lookup, @runtime_coordinate_lookup_oracle>(%input, %output, %rows, %columns) : (tensor<64xi32>, tensor<66xi32>, index, index) -> () {
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<72xi32>
      check.expect.bitwise actual(%output_storage) expected(%output_storage) : tensor<74xi32>
    }
  }
  check.return
}
