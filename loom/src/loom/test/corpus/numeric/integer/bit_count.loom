// Narrow semantic boundaries plus directed and random wide values cross a
// callable boundary. Scalar and vector counts share observations; the
// independent oracle scans individual bits without count instructions.

func.def inline @scan_bits(%value: i64, %width: index) -> (i64, i64, i64) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %c0 = scalar.constant 0 : i64
  %c1 = scalar.constant 1 : i64
  %width_value = index.cast %width : index to i64
  %last = scalar.subi %width_value, %c1 : i64
  %leading, %trailing, %population = scf.for %position = [%begin to %width step %step](%leading_count = %width_value : i64, %trailing_count = %width_value : i64, %population_count = %c0 : i64) -> (i64, i64, i64) {
    %shift = index.cast %position : index to i64
    %shifted = scalar.shrui %value, %shift : i64
    %bit = scalar.andi %shifted, %c1 : i64
    %set = scalar.cmpi ne, %bit, %c0 : i64
    %leading_position = scalar.subi %last, %shift : i64
    %next_leading = scf.select %set, %leading_position, %leading_count : i64
    %first = scalar.cmpi eq, %population_count, %c0 : i64
    %first_set = scalar.andi %first, %set : i1
    %next_trailing = scf.select %first_set, %shift, %trailing_count : i64
    %next_population = scalar.addi %population_count, %bit : i64
    scf.yield %next_leading, %next_trailing, %next_population : i64, i64, i64
  }
  func.return %leading, %trailing, %population : i64, i64, i64
}

func.def @bit_counts_i8(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<32xi8>
  %results = buffer.view %output[%base] : buffer -> view<192xi8>
  %begin = index.constant 0 : index
  %end = index.constant 32 : index
  %step = index.constant 4 : index
  %trailing_base = index.constant 32 : index
  %population_base = index.constant 64 : index
  %scalar_leading_base = index.constant 96 : index
  %scalar_trailing_base = index.constant 128 : index
  %scalar_population_base = index.constant 160 : index
  scf.for %position = [%begin to %end step %step] {
    %values = vector.load %source[%position] : view<32xi8> -> vector<4xi8>
    %leading = vector.ctlzi %values : vector<4xi8>
    %trailing = vector.cttzi %values : vector<4xi8>
    %population = vector.ctpopi %values : vector<4xi8>
    %trailing_position = index.add %position, %trailing_base : index
    %population_position = index.add %position, %population_base : index
    vector.store %leading, %results[%position] : vector<4xi8>, view<192xi8>
    vector.store %trailing, %results[%trailing_position] : vector<4xi8>, view<192xi8>
    vector.store %population, %results[%population_position] : vector<4xi8>, view<192xi8>
  }
  %scalar_step = index.constant 1 : index
  scf.for %position = [%begin to %end step %scalar_step] {
    %value = view.load %source[%position] : view<32xi8> -> i8
    %leading = scalar.ctlzi %value : i8
    %trailing = scalar.cttzi %value : i8
    %population = scalar.ctpopi %value : i8
    %leading_position = index.add %position, %scalar_leading_base : index
    %trailing_position = index.add %position, %scalar_trailing_base : index
    %population_position = index.add %position, %scalar_population_base : index
    view.store %leading, %results[%leading_position] : i8, view<192xi8>
    view.store %trailing, %results[%trailing_position] : i8, view<192xi8>
    view.store %population, %results[%population_position] : i8, view<192xi8>
  }
  func.return
}

func.def @bit_counts_i8_oracle(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<32xi8>
  %results = buffer.view %output[%base] : buffer -> view<192xi8>
  %begin = index.constant 0 : index
  %end = index.constant 32 : index
  %step = index.constant 1 : index
  %width = index.constant 8 : index
  %trailing_base = index.constant 32 : index
  %population_base = index.constant 64 : index
  %scalar_leading_base = index.constant 96 : index
  %scalar_trailing_base = index.constant 128 : index
  %scalar_population_base = index.constant 160 : index
  scf.for %position = [%begin to %end step %step] {
    %value = view.load %source[%position] : view<32xi8> -> i8
    %word = scalar.extui %value : i8 to i64
    %leading_word, %trailing_word, %population_word = func.call @scan_bits(%word, %width) : (i64, index) -> (i64, i64, i64)
    %leading = scalar.trunci %leading_word : i64 to i8
    %trailing = scalar.trunci %trailing_word : i64 to i8
    %population = scalar.trunci %population_word : i64 to i8
    %trailing_position = index.add %position, %trailing_base : index
    %population_position = index.add %position, %population_base : index
    %scalar_leading_position = index.add %position, %scalar_leading_base : index
    %scalar_trailing_position = index.add %position, %scalar_trailing_base : index
    %scalar_population_position = index.add %position, %scalar_population_base : index
    view.store %leading, %results[%position] : i8, view<192xi8>
    view.store %trailing, %results[%trailing_position] : i8, view<192xi8>
    view.store %population, %results[%population_position] : i8, view<192xi8>
    view.store %leading, %results[%scalar_leading_position] : i8, view<192xi8>
    view.store %trailing, %results[%scalar_trailing_position] : i8, view<192xi8>
    view.store %population, %results[%scalar_population_position] : i8, view<192xi8>
  }
  func.return
}

check.scenario @bit_counts_i8_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-16) step(1) : tensor<32xi8>
    %output = check.generate.fill value(-1) : tensor<192xi8>
    check.compare<@bit_counts_i8, @bit_counts_i8_oracle>(%input, %output) : (tensor<32xi8>, tensor<192xi8>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<192xi8>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-128) step(17) period(16) : tensor<32xi8>
    %output = check.generate.fill value(-1) : tensor<192xi8>
    check.compare<@bit_counts_i8, @bit_counts_i8_oracle>(%input, %output) : (tensor<32xi8>, tensor<192xi8>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<192xi8>
    }
  }
  check.trial[4](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-128 to 127) : tensor<32xi8>
    %output = check.generate.fill value(-1) : tensor<192xi8>
    check.compare<@bit_counts_i8, @bit_counts_i8_oracle>(%input, %output) : (tensor<32xi8>, tensor<192xi8>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<192xi8>
    }
  }
  check.return
}

