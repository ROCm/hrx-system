// Wide signed division uses the retained two-word plan for both uniform and
// varying carriers. The divisor matrix covers every reciprocal recipe shape.
func.def @constant_wide_signed_division(%dynamic_zero: i64, %uniform: i64, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %values = buffer.view %input[%base] : buffer -> view<3x4xi64>
  %results = buffer.view %output[%base] : buffer -> view<28xi64>
  %c1 = scalar.constant 1 : i64
  %cn1 = scalar.constant -1 : i64
  %c2 = scalar.constant 2 : i64
  %cn2 = scalar.constant -2 : i64
  %c3 = scalar.constant 3 : i64
  %cn3 = scalar.constant -3 : i64
  %c4 = scalar.constant 4 : i64
  %cn4 = scalar.constant -4 : i64
  %c5 = scalar.constant 5 : i64
  %cn5 = scalar.constant -5 : i64
  %minimum = scalar.constant -9223372036854775808 : i64
  %maximum = scalar.constant 9223372036854775807 : i64
  %c20 = scalar.constant 20 : i64
  %cn20 = scalar.constant -20 : i64
  %uniform_quotient = scalar.divsi %uniform, %c20 : i64
  %uniform_remainder = scalar.remsi %uniform, %c20 : i64
  %negative_quotient = scalar.divsi %uniform, %cn20 : i64
  %negative_remainder = scalar.remsi %uniform, %cn20 : i64
  view.store %uniform_quotient, %results[0] : i64, view<28xi64>
  view.store %uniform_remainder, %results[1] : i64, view<28xi64>
  view.store %negative_quotient, %results[2] : i64, view<28xi64>
  view.store %negative_remainder, %results[3] : i64, view<28xi64>
  %loaded = vector.load %values[0, 0] : view<3x4xi64> -> vector<3x4xi64>
  %divisors = vector.from_elements %c1, %cn1, %c2, %cn2, %c3, %cn3, %c4, %cn4, %c5, %cn5, %minimum, %maximum : vector<3x4xi64>
  %quotients = vector.divsi %loaded, %divisors : vector<3x4xi64>
  %remainders = vector.remsi %loaded, %divisors : vector<3x4xi64>
  %flat_quotients = vector.bitcast %quotients : vector<3x4xi64> to vector<12xi64>
  %flat_remainders = vector.bitcast %remainders : vector<3x4xi64> to vector<12xi64>
  vector.store %flat_quotients, %results[4] : vector<12xi64>, view<28xi64>
  vector.store %flat_remainders, %results[16] : vector<12xi64>, view<28xi64>
  func.return
}

