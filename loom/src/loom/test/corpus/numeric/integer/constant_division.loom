// A 35-bit numerator divided by nine has a u32 quotient, whose product with
// the divisor still needs both words when reconstructing the remainder.
func.def @narrow_remainder_product(%divisor_input: i64, %uniform: i64, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %values = buffer.view %input[%base] : buffer -> view<4xi64>
  %results = buffer.view %output[%base] : buffer -> view<5xi64>
  %mask = scalar.constant 34359738367 : i64
  %divisor = scalar.constant 9 : i64
  %bounded = scalar.andi %uniform, %mask : i64
  %remainder = scalar.remui %bounded, %divisor : i64
  view.store %remainder, %results[0] : i64, view<5xi64>
  %loaded = vector.load %values[0] : view<4xi64> -> vector<4xi64>
  %masks = vector.splat %mask : vector<4xi64>
  %lanes = vector.andi %loaded, %masks : vector<4xi64>
  %divisors = vector.splat %divisor : vector<4xi64>
  %remainders = vector.remui %lanes, %divisors : vector<4xi64>
  vector.store %remainders, %results[1] : vector<4xi64>, view<5xi64>
  func.return
}

func.def @dynamic_narrow_remainder_product(%divisor: i64, %uniform: i64, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %values = buffer.view %input[%base] : buffer -> view<4xi64>
  %results = buffer.view %output[%base] : buffer -> view<5xi64>
  %mask = scalar.constant 34359738367 : i64
  %bounded = scalar.andi %uniform, %mask : i64
  %remainder = scalar.remui %bounded, %divisor : i64
  view.store %remainder, %results[0] : i64, view<5xi64>
  %loaded = vector.load %values[0] : view<4xi64> -> vector<4xi64>
  %masks = vector.splat %mask : vector<4xi64>
  %lanes = vector.andi %loaded, %masks : vector<4xi64>
  %divisors = vector.splat %divisor : vector<4xi64>
  %remainders = vector.remui %lanes, %divisors : vector<4xi64>
  vector.store %remainders, %results[1] : vector<4xi64>, view<5xi64>
  func.return
}

