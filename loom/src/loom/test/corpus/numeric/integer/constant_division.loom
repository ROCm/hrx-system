// Widened products keep their complete value while proving a clear sign bit.
// Shaped lanes and uniform scalars exercise the same retained numerator bounds.
// The word remainder uses a mask-derived bound; narrow integer promotion is
// exercised separately by constant_narrow_quotient_values.
func.def @bounded_wide_division(%zero: i64, %uniform_bits: i64, %input: buffer, %output: buffer) {
  %uniform = scalar.trunci %uniform_bits : i64 to i32
  %base = index.constant 0 : offset
  %values = buffer.view %input[%base] : buffer -> view<4xi32>
  %results = buffer.view %output[%base] : buffer -> view<12xi64>
  %c7 = scalar.constant 7 : i64
  %c31 = scalar.constant 31 : i64
  %prime = scalar.constant 20000171 : i64
  %sign = scalar.constant -9223372036854775808 : i64
  %factor = scalar.constant 2147483647 : i64
  %wide = scalar.extui %uniform : i32 to i64
  %product = scalar.muli %wide, %factor : i64
  %hash = scalar.xori %product, %wide : i64
  %quotient = scalar.divui %hash, %c7 : i64
  %remainder = scalar.remui %hash, %c7 : i64
  view.store %quotient, %results[0] : i64, view<12xi64>
  view.store %remainder, %results[1] : i64, view<12xi64>
  %byte_mask = scalar.constant 255 : i32
  %byte_wide = scalar.andi %uniform, %byte_mask : i32
  %byte_divisor = scalar.constant 7 : i32
  %byte_quotient = scalar.divui %byte_wide, %byte_divisor : i32
  %byte_remainder = scalar.remui %byte_wide, %byte_divisor : i32
  %stored_quotient = scalar.extui %byte_quotient : i32 to i64
  %stored_remainder = scalar.extui %byte_remainder : i32 to i64
  view.store %stored_quotient, %results[2] : i64, view<12xi64>
  view.store %stored_remainder, %results[3] : i64, view<12xi64>
  %loaded = vector.load %values[0] : view<4xi32> -> vector<4xi32>
  %lanes = vector.extui %loaded : vector<4xi32> to vector<4xi64>
  %factors = vector.splat %factor : vector<4xi64>
  %products = vector.muli %lanes, %factors : vector<4xi64>
  %hashes = vector.xori %products, %lanes : vector<4xi64>
  %divisors = vector.from_elements %c7, %c31, %prime, %sign : vector<4xi64>
  %quotients = vector.divui %hashes, %divisors : vector<4xi64>
  %remainders = vector.remui %hashes, %divisors : vector<4xi64>
  vector.store %quotients, %results[4] : vector<4xi64>, view<12xi64>
  vector.store %remainders, %results[8] : vector<4xi64>, view<12xi64>
  func.return
}

// Dynamic divisors leave the oracle independent of reciprocal specialization.
func.def @dynamic_bounded_wide_division(%zero: i64, %uniform_bits: i64, %input: buffer, %output: buffer) {
  %uniform = scalar.trunci %uniform_bits : i64 to i32
  %base = index.constant 0 : offset
  %values = buffer.view %input[%base] : buffer -> view<4xi32>
  %results = buffer.view %output[%base] : buffer -> view<12xi64>
  %c7 = scalar.constant 7 : i64
  %c31 = scalar.constant 31 : i64
  %prime = scalar.constant 20000171 : i64
  %sign = scalar.constant -9223372036854775808 : i64
  %factor = scalar.constant 2147483647 : i64
  %wide = scalar.extui %uniform : i32 to i64
  %product = scalar.muli %wide, %factor : i64
  %hash = scalar.xori %product, %wide : i64
  %divisor = scalar.addi %zero, %c7 : i64
  %quotient = scalar.divui %hash, %divisor : i64
  %remainder = scalar.remui %hash, %divisor : i64
  view.store %quotient, %results[0] : i64, view<12xi64>
  view.store %remainder, %results[1] : i64, view<12xi64>
  %byte_mask = scalar.constant 255 : i32
  %byte_wide = scalar.andi %uniform, %byte_mask : i32
  %byte_divisor = scalar.trunci %divisor : i64 to i32
  %byte_quotient = scalar.divui %byte_wide, %byte_divisor : i32
  %byte_remainder = scalar.remui %byte_wide, %byte_divisor : i32
  %stored_quotient = scalar.extui %byte_quotient : i32 to i64
  %stored_remainder = scalar.extui %byte_remainder : i32 to i64
  view.store %stored_quotient, %results[2] : i64, view<12xi64>
  view.store %stored_remainder, %results[3] : i64, view<12xi64>
  %loaded = vector.load %values[0] : view<4xi32> -> vector<4xi32>
  %lanes = vector.extui %loaded : vector<4xi32> to vector<4xi64>
  %factors = vector.splat %factor : vector<4xi64>
  %products = vector.muli %lanes, %factors : vector<4xi64>
  %hashes = vector.xori %products, %lanes : vector<4xi64>
  %constants = vector.from_elements %c7, %c31, %prime, %sign : vector<4xi64>
  %zeros = vector.splat %zero : vector<4xi64>
  %divisors = vector.addi %constants, %zeros : vector<4xi64>
  %quotients = vector.divui %hashes, %divisors : vector<4xi64>
  %remainders = vector.remui %hashes, %divisors : vector<4xi64>
  vector.store %quotients, %results[4] : vector<4xi64>, view<12xi64>
  vector.store %remainders, %results[8] : vector<4xi64>, view<12xi64>
  func.return
}

