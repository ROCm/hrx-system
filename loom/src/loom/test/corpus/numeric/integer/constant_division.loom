    %suffix = check.tensor.view %storage offset(32) : tensor<12xi32> -> tensor<4xi32>
    %guard = check.generate.fill value(-123) : tensor<4xi32>
    check.compare<@constant_index_boundary_division, @dynamic_index_boundary_division>(%zero, %value, %output) : (index, index, tensor<4xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi32>
      check.expect.bitwise actual(%prefix) expected(%guard) : tensor<4xi32>
      check.expect.bitwise actual(%suffix) expected(%guard) : tensor<4xi32>
    }
  }
  check.return
}

// Signed word divisors cover every reciprocal arithmetic shape, identities,
// and signed boundaries on both uniform scalars and loaded vector lanes.
func.def @constant_signed_word_division(%dynamic_zero: i32, %uniform_bits: i64, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %values = buffer.view %input[%base] : buffer -> view<4x4xi32>
  %results = buffer.view %output[%base] : buffer -> view<36xi32>
  %uniform = scalar.trunci %uniform_bits : i64 to i32
  %c1 = scalar.constant 1 : i32
  %cn1 = scalar.constant -1 : i32
  %c2 = scalar.constant 2 : i32
  %cn2 = scalar.constant -2 : i32
  %c3 = scalar.constant 3 : i32
  %cn3 = scalar.constant -3 : i32
  %c4 = scalar.constant 4 : i32
  %cn4 = scalar.constant -4 : i32
  %c5 = scalar.constant 5 : i32
  %cn5 = scalar.constant -5 : i32
  %c7 = scalar.constant 7 : i32
  %cn7 = scalar.constant -7 : i32
  %c20 = scalar.constant 20 : i32
  %cn20 = scalar.constant -20 : i32
  %minimum = scalar.constant -2147483648 : i32
  %maximum = scalar.constant 2147483647 : i32
  %uniform_quotient = scalar.divsi %uniform, %c20 : i32
  %uniform_remainder = scalar.remsi %uniform, %c20 : i32
  %negative_quotient = scalar.divsi %uniform, %cn20 : i32
  %negative_remainder = scalar.remsi %uniform, %cn20 : i32
  view.store %uniform_quotient, %results[0] : i32, view<36xi32>
  view.store %uniform_remainder, %results[1] : i32, view<36xi32>
  view.store %negative_quotient, %results[2] : i32, view<36xi32>
  view.store %negative_remainder, %results[3] : i32, view<36xi32>
  %loaded = vector.load %values[0, 0] : view<4x4xi32> -> vector<4x4xi32>
  %divisors = vector.from_elements %c1, %cn1, %c2, %cn2, %c3, %cn3, %c4, %cn4, %c5, %cn5, %c7, %cn7, %minimum, %maximum, %c20, %cn20 : vector<4x4xi32>
  %quotients = vector.divsi %loaded, %divisors : vector<4x4xi32>
  %remainders = vector.remsi %loaded, %divisors : vector<4x4xi32>
  %flat_quotients = vector.bitcast %quotients : vector<4x4xi32> to vector<16xi32>
  %flat_remainders = vector.bitcast %remainders : vector<4x4xi32> to vector<16xi32>
  vector.store %flat_quotients, %results[4] : vector<16xi32>, view<36xi32>
  vector.store %flat_remainders, %results[20] : vector<16xi32>, view<36xi32>
  func.return
}

// Runtime addition prevents the oracle from selecting constant recipes.
func.def @dynamic_signed_word_division(%dynamic_zero: i32, %uniform_bits: i64, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %values = buffer.view %input[%base] : buffer -> view<4x4xi32>
  %results = buffer.view %output[%base] : buffer -> view<36xi32>
  %uniform = scalar.trunci %uniform_bits : i64 to i32
  %c1 = scalar.constant 1 : i32
  %cn1 = scalar.constant -1 : i32
  %c2 = scalar.constant 2 : i32
  %cn2 = scalar.constant -2 : i32
  %c3 = scalar.constant 3 : i32
  %cn3 = scalar.constant -3 : i32
  %c4 = scalar.constant 4 : i32
  %cn4 = scalar.constant -4 : i32
  %c5 = scalar.constant 5 : i32
  %cn5 = scalar.constant -5 : i32
  %c7 = scalar.constant 7 : i32
  %cn7 = scalar.constant -7 : i32
  %c20 = scalar.constant 20 : i32
  %cn20 = scalar.constant -20 : i32
  %minimum = scalar.constant -2147483648 : i32
  %maximum = scalar.constant 2147483647 : i32
  %positive_interval = scalar.addi %dynamic_zero, %c20 : i32
  %negative_interval = scalar.addi %dynamic_zero, %cn20 : i32
  %uniform_quotient = scalar.divsi %uniform, %positive_interval : i32
  %uniform_remainder = scalar.remsi %uniform, %positive_interval : i32
  %negative_quotient = scalar.divsi %uniform, %negative_interval : i32
  %negative_remainder = scalar.remsi %uniform, %negative_interval : i32
  view.store %uniform_quotient, %results[0] : i32, view<36xi32>
  view.store %uniform_remainder, %results[1] : i32, view<36xi32>
  view.store %negative_quotient, %results[2] : i32, view<36xi32>
  view.store %negative_remainder, %results[3] : i32, view<36xi32>
  %loaded = vector.load %values[0, 0] : view<4x4xi32> -> vector<4x4xi32>
  %constants = vector.from_elements %c1, %cn1, %c2, %cn2, %c3, %cn3, %c4, %cn4, %c5, %cn5, %c7, %cn7, %minimum, %maximum, %c20, %cn20 : vector<4x4xi32>
  %zeros = vector.splat %dynamic_zero : vector<4x4xi32>
  %divisors = vector.addi %constants, %zeros : vector<4x4xi32>
  %quotients = vector.divsi %loaded, %divisors : vector<4x4xi32>
  %remainders = vector.remsi %loaded, %divisors : vector<4x4xi32>
  %flat_quotients = vector.bitcast %quotients : vector<4x4xi32> to vector<16xi32>
  %flat_remainders = vector.bitcast %remainders : vector<4x4xi32> to vector<16xi32>
  vector.store %flat_quotients, %results[4] : vector<16xi32>, view<36xi32>
  vector.store %flat_remainders, %results[20] : vector<16xi32>, view<36xi32>
  func.return
}

check.scenario @constant_signed_word_division_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %zero = check.literal value(0) : i32
    %uniform = check.literal value(-2147483647) : i64
    %input = check.generate.iota offset(-17) step(1) : tensor<16xi32>
    %output = check.generate.fill value(-123) : tensor<36xi32>
    check.compare<@constant_signed_word_division, @dynamic_signed_word_division>(%zero, %uniform, %input, %output) : (i32, i64, tensor<16xi32>, tensor<36xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<36xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %zero = check.literal value(0) : i32
    %uniform = check.literal value(2147483647) : i64
    %input = check.generate.iota offset(2147483632) step(1) : tensor<16xi32>
    %output = check.generate.fill value(-123) : tensor<36xi32>
    check.compare<@constant_signed_word_division, @dynamic_signed_word_division>(%zero, %uniform, %input, %output) : (i32, i64, tensor<16xi32>, tensor<36xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<36xi32>
    }
  }
  check.trial[32](%trial: index, %entropy: check.entropy) {
    %uniform_entropy = check.entropy.fork %entropy name("signed_word_uniform") : check.entropy
    %input_entropy = check.entropy.fork %entropy name("signed_word_input") : check.entropy
    %uniform = check.entropy.read %uniform_entropy[%trial] : check.entropy -> i64
    %seed = check.entropy.read %input_entropy[%trial] : check.entropy -> i64
    %zero = check.literal value(0) : i32
    %input = check.generate.random.uniform seed(%seed) range(-2147483647 to 2147483647) : tensor<16xi32>
    %output = check.generate.fill value(-123) : tensor<36xi32>
    check.compare<@constant_signed_word_division, @dynamic_signed_word_division>(%zero, %uniform, %input, %output) : (i32, i64, tensor<16xi32>, tensor<36xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<36xi32>
    }
  }
  check.return
}

// Byte and halfword operations prove that signed widening preserves the
// dividend before selecting the shared i32 reciprocal recipe.
func.def @constant_narrow_signed_division(%dynamic_zero: i32, %uniform_bits: i64, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 16 : index
  %step = index.constant 1 : index
  %values = buffer.view %input[%base] : buffer -> view<16xi32>
  %results = buffer.view %output[%base] : buffer -> view<8x16xi32>
  %byte = scalar.trunci %uniform_bits : i64 to i8
  %byte_divisor = scalar.constant -3 : i8
  %byte_quotient = scalar.divsi %byte, %byte_divisor : i8
  %byte_remainder = scalar.remsi %byte, %byte_divisor : i8
  %byte_uniform_quotient = scalar.extsi %byte_quotient : i8 to i32
  %byte_uniform_remainder = scalar.extsi %byte_remainder : i8 to i32
  %halfword = scalar.trunci %uniform_bits : i64 to i16
  %halfword_divisor = scalar.constant 5 : i16
  %halfword_quotient = scalar.divsi %halfword, %halfword_divisor : i16
  %halfword_remainder = scalar.remsi %halfword, %halfword_divisor : i16
  %halfword_uniform_quotient = scalar.extsi %halfword_quotient : i16 to i32
  %halfword_uniform_remainder = scalar.extsi %halfword_remainder : i16 to i32
  scf.for %lane = [%begin to %end step %step] {
    %value = view.load %values[%lane] : view<16xi32> -> i32
    %byte_value = scalar.trunci %value : i32 to i8
    %byte_lane_quotient = scalar.divsi %byte_value, %byte_divisor : i8
    %byte_lane_remainder = scalar.remsi %byte_value, %byte_divisor : i8
    %byte_lane_quotient_wide = scalar.extsi %byte_lane_quotient : i8 to i32
    %byte_lane_remainder_wide = scalar.extsi %byte_lane_remainder : i8 to i32
    %halfword_value = scalar.trunci %value : i32 to i16
    %halfword_lane_quotient = scalar.divsi %halfword_value, %halfword_divisor : i16
    %halfword_lane_remainder = scalar.remsi %halfword_value, %halfword_divisor : i16
    %halfword_lane_quotient_wide = scalar.extsi %halfword_lane_quotient : i16 to i32
    %halfword_lane_remainder_wide = scalar.extsi %halfword_lane_remainder : i16 to i32
    view.store %byte_uniform_quotient, %results[0, %lane] : i32, view<8x16xi32>
    view.store %byte_uniform_remainder, %results[1, %lane] : i32, view<8x16xi32>
    view.store %byte_lane_quotient_wide, %results[2, %lane] : i32, view<8x16xi32>
    view.store %byte_lane_remainder_wide, %results[3, %lane] : i32, view<8x16xi32>
    view.store %halfword_uniform_quotient, %results[4, %lane] : i32, view<8x16xi32>
    view.store %halfword_uniform_remainder, %results[5, %lane] : i32, view<8x16xi32>
    view.store %halfword_lane_quotient_wide, %results[6, %lane] : i32, view<8x16xi32>
    view.store %halfword_lane_remainder_wide, %results[7, %lane] : i32, view<8x16xi32>
  }
  func.return
}

func.def @dynamic_narrow_signed_division(%dynamic_zero: i32, %uniform_bits: i64, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 16 : index
