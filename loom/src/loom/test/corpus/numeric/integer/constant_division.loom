func.def @bounded_remainder_identities(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %values = buffer.view %input[%base] : buffer -> view<4xi32>
  %results = buffer.view %output[%base] : buffer -> view<8xi32>
  %loaded = vector.load %values[0] : view<4xi32> -> vector<4xi32>
  %mask = vector.splati 255 : vector<4xi32>
  %bounded = vector.andi %loaded, %mask : vector<4xi32>
  %divisors = vector.splati 257 : vector<4xi32>
  %identities = vector.remui %bounded, %divisors : vector<4xi32>
  vector.store %identities, %results[0] : vector<4xi32>, view<8xi32>
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %byte_mask = scalar.constant 255 : i32
  %divisor = scalar.constant 257 : i32
  scf.for %lane = [%begin to %end step %step] {
    %value = view.load %values[%lane] : view<4xi32> -> i32
    %byte = scalar.andi %value, %byte_mask : i32
    %result = scalar.remui %byte, %divisor : i32
    %position = index.add %lane, %end : index
    view.store %result, %results[%position] : i32, view<8xi32>
  }
  func.return
}

// Independent identity oracle: no quotient or remainder in the reference.
func.def @bounded_remainder_identity_oracle(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %values = buffer.view %input[%base] : buffer -> view<4xi32>
  %results = buffer.view %output[%base] : buffer -> view<8xi32>
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %mask = scalar.constant 255 : i32
  scf.for %lane = [%begin to %end step %step] {
    %value = view.load %values[%lane] : view<4xi32> -> i32
    %byte = scalar.andi %value, %mask : i32
    %position = index.add %lane, %end : index
    view.store %byte, %results[%lane] : i32, view<8xi32>
    view.store %byte, %results[%position] : i32, view<8xi32>
  }
  func.return
}

check.scenario @bounded_remainder_identity_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(254) step(1) : tensor<4xi32>
    %output = check.generate.fill value(-1) : tensor<8xi32>
    check.compare<@bounded_remainder_identities, @bounded_remainder_identity_oracle>(%input, %output) : (tensor<4xi32>, tensor<8xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<8xi32>
    }
  }
  check.trial[16](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-2147483648 to 2147483647) : tensor<4xi32>
    %output = check.generate.fill value(-1) : tensor<8xi32>
    check.compare<@bounded_remainder_identities, @bounded_remainder_identity_oracle>(%input, %output) : (tensor<4xi32>, tensor<8xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<8xi32>
    }
  }
  check.return
}

// Byte and halfword division use unsigned promotion to the same u32 recipes.
func.def @constant_narrow_quotients(%dynamic_zero: i32, %uniform_bits: i64, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 32 : index
  %step = index.constant 1 : index
  %values = buffer.view %input[%base] : buffer -> view<32xi32>
  %results = buffer.view %output[%base] : buffer -> view<6x32xi32>
  %byte_uniform = scalar.trunci %uniform_bits : i64 to i8
  %byte_third_constant = scalar.constant 3 : i8
  %byte_seventh_constant = scalar.constant 7 : i8
  %byte_high_constant = scalar.constant -127 : i8
  %byte_uniform_quotient = scalar.divui %byte_uniform, %byte_third_constant : i8
  %byte_uniform_result = scalar.extui %byte_uniform_quotient : i8 to i32
  %halfword_uniform = scalar.trunci %uniform_bits : i64 to i16
  %halfword_third_constant = scalar.constant 3 : i16
  %halfword_seventh_constant = scalar.constant 7 : i16
  %halfword_high_constant = scalar.constant -32767 : i16
  %halfword_uniform_quotient = scalar.divui %halfword_uniform, %halfword_third_constant : i16
  %halfword_uniform_result = scalar.extui %halfword_uniform_quotient : i16 to i32
  scf.for %lane = [%begin to %end step %step] {
    %value = view.load %values[%lane] : view<32xi32> -> i32
    %byte = scalar.trunci %value : i32 to i8
    %byte_seventh_quotient = scalar.divui %byte, %byte_seventh_constant : i8
    %byte_seventh_result = scalar.extui %byte_seventh_quotient : i8 to i32
    %byte_high_quotient = scalar.divui %byte, %byte_high_constant : i8
    %byte_high_result = scalar.extui %byte_high_quotient : i8 to i32
    view.store %byte_uniform_result, %results[0, %lane] : i32, view<6x32xi32>
    view.store %byte_seventh_result, %results[1, %lane] : i32, view<6x32xi32>
    view.store %byte_high_result, %results[2, %lane] : i32, view<6x32xi32>
    %halfword = scalar.trunci %value : i32 to i16
    %halfword_seventh_quotient = scalar.divui %halfword, %halfword_seventh_constant : i16
    %halfword_seventh_result = scalar.extui %halfword_seventh_quotient : i16 to i32
    %halfword_high_quotient = scalar.divui %halfword, %halfword_high_constant : i16
    %halfword_high_result = scalar.extui %halfword_high_quotient : i16 to i32
    view.store %halfword_uniform_result, %results[3, %lane] : i32, view<6x32xi32>
    view.store %halfword_seventh_result, %results[4, %lane] : i32, view<6x32xi32>
    view.store %halfword_high_result, %results[5, %lane] : i32, view<6x32xi32>
  }
  func.return
}

func.def @dynamic_narrow_quotients(%dynamic_zero: i32, %uniform_bits: i64, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 32 : index
  %step = index.constant 1 : index
  %values = buffer.view %input[%base] : buffer -> view<32xi32>
  %results = buffer.view %output[%base] : buffer -> view<6x32xi32>
  %byte_uniform = scalar.trunci %uniform_bits : i64 to i8
  %byte_zero = scalar.trunci %dynamic_zero : i32 to i8
  %byte_third_constant = scalar.constant 3 : i8
  %byte_third_divisor = scalar.addi %byte_zero, %byte_third_constant : i8
  %byte_seventh_constant = scalar.constant 7 : i8
  %byte_seventh_divisor = scalar.addi %byte_zero, %byte_seventh_constant : i8
  %byte_high_constant = scalar.constant -127 : i8
  %byte_high_divisor = scalar.addi %byte_zero, %byte_high_constant : i8
  %byte_uniform_quotient = scalar.divui %byte_uniform, %byte_third_divisor : i8
  %byte_uniform_result = scalar.extui %byte_uniform_quotient : i8 to i32
  %halfword_uniform = scalar.trunci %uniform_bits : i64 to i16
  %halfword_zero = scalar.trunci %dynamic_zero : i32 to i16
  %halfword_third_constant = scalar.constant 3 : i16
  %halfword_third_divisor = scalar.addi %halfword_zero, %halfword_third_constant : i16
  %halfword_seventh_constant = scalar.constant 7 : i16
  %halfword_seventh_divisor = scalar.addi %halfword_zero, %halfword_seventh_constant : i16
  %halfword_high_constant = scalar.constant -32767 : i16
  %halfword_high_divisor = scalar.addi %halfword_zero, %halfword_high_constant : i16
  %halfword_uniform_quotient = scalar.divui %halfword_uniform, %halfword_third_divisor : i16
  %halfword_uniform_result = scalar.extui %halfword_uniform_quotient : i16 to i32
  scf.for %lane = [%begin to %end step %step] {
    %value = view.load %values[%lane] : view<32xi32> -> i32
    %byte = scalar.trunci %value : i32 to i8
    %byte_seventh_quotient = scalar.divui %byte, %byte_seventh_divisor : i8
    %byte_seventh_result = scalar.extui %byte_seventh_quotient : i8 to i32
    %byte_high_quotient = scalar.divui %byte, %byte_high_divisor : i8
    %byte_high_result = scalar.extui %byte_high_quotient : i8 to i32
    view.store %byte_uniform_result, %results[0, %lane] : i32, view<6x32xi32>
    view.store %byte_seventh_result, %results[1, %lane] : i32, view<6x32xi32>
    view.store %byte_high_result, %results[2, %lane] : i32, view<6x32xi32>
    %halfword = scalar.trunci %value : i32 to i16
    %halfword_seventh_quotient = scalar.divui %halfword, %halfword_seventh_divisor : i16
    %halfword_seventh_result = scalar.extui %halfword_seventh_quotient : i16 to i32
    %halfword_high_quotient = scalar.divui %halfword, %halfword_high_divisor : i16
    %halfword_high_result = scalar.extui %halfword_high_quotient : i16 to i32
    view.store %halfword_uniform_result, %results[3, %lane] : i32, view<6x32xi32>
    view.store %halfword_seventh_result, %results[4, %lane] : i32, view<6x32xi32>
    view.store %halfword_high_result, %results[5, %lane] : i32, view<6x32xi32>
  }
  func.return
}

check.scenario @constant_narrow_quotient_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %dynamic_zero = check.literal value(0) : i32
    %uniform_bits = check.literal value(-1) : i64
    %input = check.generate.iota offset(120) step(1) : tensor<32xi32>
    %output = check.generate.fill value(-123) : tensor<192xi32>
    check.compare<@constant_narrow_quotients, @dynamic_narrow_quotients>(%dynamic_zero, %uniform_bits, %input, %output) : (i32, i64, tensor<32xi32>, tensor<192xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<192xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %dynamic_zero = check.literal value(0) : i32
    %uniform_bits = check.literal value(-1) : i64
    %input = check.generate.iota offset(32760) step(1) : tensor<32xi32>
    %output = check.generate.fill value(-123) : tensor<192xi32>
    check.compare<@constant_narrow_quotients, @dynamic_narrow_quotients>(%dynamic_zero, %uniform_bits, %input, %output) : (i32, i64, tensor<32xi32>, tensor<192xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<192xi32>
    }
  }
  check.trial[64](%trial: index, %entropy: check.entropy) {
    %uniform_entropy = check.entropy.fork %entropy name("uniform") : check.entropy
    %input_entropy = check.entropy.fork %entropy name("input") : check.entropy
    %uniform_bits = check.entropy.read %uniform_entropy[%trial] : check.entropy -> i64
    %seed = check.entropy.read %input_entropy[%trial] : check.entropy -> i64
    %dynamic_zero = check.literal value(0) : i32
    %input = check.generate.random.uniform seed(%seed) range(-2147483648 to 2147483647) : tensor<32xi32>
    %output = check.generate.fill value(-123) : tensor<192xi32>
    check.compare<@constant_narrow_quotients, @dynamic_narrow_quotients>(%dynamic_zero, %uniform_bits, %input, %output) : (i32, i64, tensor<32xi32>, tensor<192xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<192xi32>
    }
  }
  check.return
}

// Literal divisors stay beside the operations they specialize because constant
// division lowering runs before calls can propagate operand facts.
func.def inline @constant_scalar_quotient_rows(%value: i32, %output: buffer, %column: index) {
  %base = index.constant 0 : offset
  %results = buffer.view %output[%base] : buffer -> view<9x64xi32>
  %c1 = scalar.constant 1 : i32
  %c3 = scalar.constant 3 : i32
  %c7 = scalar.constant 7 : i32
  %c16 = scalar.constant 16 : i32
  %c20 = scalar.constant 20 : i32
  %high_power = scalar.constant -2147483648 : i32
  %high_bit = scalar.constant -2147483647 : i32
  %largest = scalar.constant -1 : i32
  %below_high_bit = scalar.constant 2147483647 : i32
  %quotient_1 = scalar.divui %value, %c1 : i32
  %quotient_3 = scalar.divui %value, %c3 : i32
  %quotient_7 = scalar.divui %value, %c7 : i32
  %quotient_16 = scalar.divui %value, %c16 : i32
  %quotient_20 = scalar.divui %value, %c20 : i32
  %quotient_high_power = scalar.divui %value, %high_power : i32
  %quotient_high_bit = scalar.divui %value, %high_bit : i32
  %quotient_largest = scalar.divui %value, %largest : i32
  %quotient_below_high_bit = scalar.divui %value, %below_high_bit : i32
  view.store %quotient_1, %results[0, %column] : i32, view<9x64xi32>
  view.store %quotient_3, %results[1, %column] : i32, view<9x64xi32>
  view.store %quotient_7, %results[2, %column] : i32, view<9x64xi32>
  view.store %quotient_16, %results[3, %column] : i32, view<9x64xi32>
  view.store %quotient_20, %results[4, %column] : i32, view<9x64xi32>
  view.store %quotient_high_power, %results[5, %column] : i32, view<9x64xi32>
  view.store %quotient_high_bit, %results[6, %column] : i32, view<9x64xi32>
  view.store %quotient_largest, %results[7, %column] : i32, view<9x64xi32>
  view.store %quotient_below_high_bit, %results[8, %column] : i32, view<9x64xi32>
  func.return
}

func.def inline @dynamic_scalar_quotient_rows(%value: i32, %divisor_1: i32, %divisor_3: i32, %divisor_7: i32, %divisor_16: i32, %divisor_20: i32, %divisor_high_power: i32, %divisor_high_bit: i32, %divisor_largest: i32, %divisor_below_high_bit: i32, %output: buffer, %column: index) {
  %base = index.constant 0 : offset
  %results = buffer.view %output[%base] : buffer -> view<9x64xi32>
  %quotient_1 = scalar.divui %value, %divisor_1 : i32
  %quotient_3 = scalar.divui %value, %divisor_3 : i32
  %quotient_7 = scalar.divui %value, %divisor_7 : i32
  %quotient_16 = scalar.divui %value, %divisor_16 : i32
  %quotient_20 = scalar.divui %value, %divisor_20 : i32
  %quotient_high_power = scalar.divui %value, %divisor_high_power : i32
  %quotient_high_bit = scalar.divui %value, %divisor_high_bit : i32
  %quotient_largest = scalar.divui %value, %divisor_largest : i32
  %quotient_below_high_bit = scalar.divui %value, %divisor_below_high_bit : i32
  view.store %quotient_1, %results[0, %column] : i32, view<9x64xi32>
  view.store %quotient_3, %results[1, %column] : i32, view<9x64xi32>
  view.store %quotient_7, %results[2, %column] : i32, view<9x64xi32>
  view.store %quotient_16, %results[3, %column] : i32, view<9x64xi32>
  view.store %quotient_20, %results[4, %column] : i32, view<9x64xi32>
  view.store %quotient_high_power, %results[5, %column] : i32, view<9x64xi32>
  view.store %quotient_high_bit, %results[6, %column] : i32, view<9x64xi32>
  view.store %quotient_largest, %results[7, %column] : i32, view<9x64xi32>
  view.store %quotient_below_high_bit, %results[8, %column] : i32, view<9x64xi32>
  func.return
}

func.def inline @constant_scalar_remainder_rows(%value: i32, %output: buffer, %column: index) {
  %base = index.constant 0 : offset
  %results = buffer.view %output[%base] : buffer -> view<10x64xi32>
  %c3 = scalar.constant 3 : i32
  %c5 = scalar.constant 5 : i32
  %c7 = scalar.constant 7 : i32
  %c9 = scalar.constant 9 : i32
