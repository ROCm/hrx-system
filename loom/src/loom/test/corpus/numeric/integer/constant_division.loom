}

func.def inline @constant_index_division_rows(%value: i32, %output: buffer, %column: index) {
  %base = index.constant 0 : offset
  %results = buffer.view %output[%base] : buffer -> view<10x64xi32>
  %value_bits = scalar.extui %value : i32 to i64
  %index_mask = scalar.constant 2147483647 : i64
  %nonnegative_bits = scalar.andi %value_bits, %index_mask : i64
  %position = index.cast %nonnegative_bits : i64 to index
  %c3 = index.constant 3 : index
  %c5 = index.constant 5 : index
  %c7 = index.constant 7 : index
  %c9 = index.constant 9 : index
  %c20 = index.constant 20 : index
  %quotient_3 = index.div %position, %c3 : index
  %remainder_3 = index.rem %position, %c3 : index
  %quotient_5 = index.div %position, %c5 : index
  %remainder_5 = index.rem %position, %c5 : index
  %quotient_7 = index.div %position, %c7 : index
  %remainder_7 = index.rem %position, %c7 : index
  %quotient_9 = index.div %position, %c9 : index
  %remainder_9 = index.rem %position, %c9 : index
  %quotient_20 = index.div %position, %c20 : index
  %remainder_20 = index.rem %position, %c20 : index
  %word_quotient_3 = index.cast %quotient_3 : index to i32
  %word_remainder_3 = index.cast %remainder_3 : index to i32
  %word_quotient_5 = index.cast %quotient_5 : index to i32
  %word_remainder_5 = index.cast %remainder_5 : index to i32
  %word_quotient_7 = index.cast %quotient_7 : index to i32
  %word_remainder_7 = index.cast %remainder_7 : index to i32
  %word_quotient_9 = index.cast %quotient_9 : index to i32
  %word_remainder_9 = index.cast %remainder_9 : index to i32
  %word_quotient_20 = index.cast %quotient_20 : index to i32
  %word_remainder_20 = index.cast %remainder_20 : index to i32
  view.store %word_quotient_3, %results[0, %column] : i32, view<10x64xi32>
  view.store %word_remainder_3, %results[1, %column] : i32, view<10x64xi32>
  view.store %word_quotient_5, %results[2, %column] : i32, view<10x64xi32>
  view.store %word_remainder_5, %results[3, %column] : i32, view<10x64xi32>
  view.store %word_quotient_7, %results[4, %column] : i32, view<10x64xi32>
  view.store %word_remainder_7, %results[5, %column] : i32, view<10x64xi32>
  view.store %word_quotient_9, %results[6, %column] : i32, view<10x64xi32>
  view.store %word_remainder_9, %results[7, %column] : i32, view<10x64xi32>
  view.store %word_quotient_20, %results[8, %column] : i32, view<10x64xi32>
  view.store %word_remainder_20, %results[9, %column] : i32, view<10x64xi32>
  func.return
}

func.def inline @dynamic_index_division_rows(%value: i32, %divisor_3: i32, %divisor_5: i32, %divisor_7: i32, %divisor_9: i32, %divisor_20: i32, %output: buffer, %column: index) {
  %base = index.constant 0 : offset
  %results = buffer.view %output[%base] : buffer -> view<10x64xi32>
  %value_bits = scalar.extui %value : i32 to i64
  %index_mask = scalar.constant 2147483647 : i64
  %nonnegative_bits = scalar.andi %value_bits, %index_mask : i64
  %position = index.cast %nonnegative_bits : i64 to index
  %positive_3 = scalar.assume %divisor_3 [range(%divisor_3, 1, 2147483647)] : i32
  %positive_5 = scalar.assume %divisor_5 [range(%divisor_5, 1, 2147483647)] : i32
  %positive_7 = scalar.assume %divisor_7 [range(%divisor_7, 1, 2147483647)] : i32
  %positive_9 = scalar.assume %divisor_9 [range(%divisor_9, 1, 2147483647)] : i32
  %positive_20 = scalar.assume %divisor_20 [range(%divisor_20, 1, 2147483647)] : i32
  %divisor_3_offset = index.cast %positive_3 : i32 to offset
  %divisor_5_offset = index.cast %positive_5 : i32 to offset
  %divisor_7_offset = index.cast %positive_7 : i32 to offset
  %divisor_9_offset = index.cast %positive_9 : i32 to offset
  %divisor_20_offset = index.cast %positive_20 : i32 to offset
  %index_3 = index.cast %divisor_3_offset : offset to index
  %index_5 = index.cast %divisor_5_offset : offset to index
  %index_7 = index.cast %divisor_7_offset : offset to index
  %index_9 = index.cast %divisor_9_offset : offset to index
  %index_20 = index.cast %divisor_20_offset : offset to index
  %quotient_3 = index.div %position, %index_3 : index
  %remainder_3 = index.rem %position, %index_3 : index
  %quotient_5 = index.div %position, %index_5 : index
  %remainder_5 = index.rem %position, %index_5 : index
  %quotient_7 = index.div %position, %index_7 : index
  %remainder_7 = index.rem %position, %index_7 : index
  %quotient_9 = index.div %position, %index_9 : index
  %remainder_9 = index.rem %position, %index_9 : index
  %quotient_20 = index.div %position, %index_20 : index
  %remainder_20 = index.rem %position, %index_20 : index
  %word_quotient_3 = index.cast %quotient_3 : index to i32
  %word_remainder_3 = index.cast %remainder_3 : index to i32
  %word_quotient_5 = index.cast %quotient_5 : index to i32
  %word_remainder_5 = index.cast %remainder_5 : index to i32
  %word_quotient_7 = index.cast %quotient_7 : index to i32
  %word_remainder_7 = index.cast %remainder_7 : index to i32
  %word_quotient_9 = index.cast %quotient_9 : index to i32
  %word_remainder_9 = index.cast %remainder_9 : index to i32
  %word_quotient_20 = index.cast %quotient_20 : index to i32
  %word_remainder_20 = index.cast %remainder_20 : index to i32
  view.store %word_quotient_3, %results[0, %column] : i32, view<10x64xi32>
  view.store %word_remainder_3, %results[1, %column] : i32, view<10x64xi32>
  view.store %word_quotient_5, %results[2, %column] : i32, view<10x64xi32>
  view.store %word_remainder_5, %results[3, %column] : i32, view<10x64xi32>
  view.store %word_quotient_7, %results[4, %column] : i32, view<10x64xi32>
  view.store %word_remainder_7, %results[5, %column] : i32, view<10x64xi32>
  view.store %word_quotient_9, %results[6, %column] : i32, view<10x64xi32>
  view.store %word_remainder_9, %results[7, %column] : i32, view<10x64xi32>
  view.store %word_quotient_20, %results[8, %column] : i32, view<10x64xi32>
  view.store %word_remainder_20, %results[9, %column] : i32, view<10x64xi32>
  func.return
}

func.def @constant_scalar_quotient_observations(%dynamic_zero: i32, %uniform_bits: i64, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 32 : index
  %step = index.constant 1 : index
  %uniform = scalar.trunci %uniform_bits : i64 to i32
  %values = buffer.view %input[%base] : buffer -> view<32xi32>
  scf.for %lane = [%begin to %end step %step] {
    %value = view.load %values[%lane] : view<32xi32> -> i32
    %varying_column = index.add %lane, %end : index
    func.call @constant_scalar_quotient_rows(%uniform, %output, %lane) : (i32, buffer, index)
    func.call @constant_scalar_quotient_rows(%value, %output, %varying_column) : (i32, buffer, index)
  }
  func.return
}

