  %remainder_3 = scalar.remui %value, %divisor_3 : i32
  %remainder_5 = scalar.remui %value, %divisor_5 : i32
  %remainder_7 = scalar.remui %value, %divisor_7 : i32
  %remainder_9 = scalar.remui %value, %divisor_9 : i32
  %remainder_10 = scalar.remui %value, %divisor_10 : i32
  %remainder_20 = scalar.remui %value, %divisor_20 : i32
  %remainder_high_power = scalar.remui %value, %divisor_high_power : i32
  %remainder_high_bit = scalar.remui %value, %divisor_high_bit : i32
  %remainder_largest = scalar.remui %value, %divisor_largest : i32
  %remainder_below_high_bit = scalar.remui %value, %divisor_below_high_bit : i32
  view.store %remainder_3, %results[0, %column] : i32, view<10x64xi32>
  view.store %remainder_5, %results[1, %column] : i32, view<10x64xi32>
  view.store %remainder_7, %results[2, %column] : i32, view<10x64xi32>
  view.store %remainder_9, %results[3, %column] : i32, view<10x64xi32>
  view.store %remainder_10, %results[4, %column] : i32, view<10x64xi32>
  view.store %remainder_20, %results[5, %column] : i32, view<10x64xi32>
  view.store %remainder_high_power, %results[6, %column] : i32, view<10x64xi32>
  view.store %remainder_high_bit, %results[7, %column] : i32, view<10x64xi32>
  view.store %remainder_largest, %results[8, %column] : i32, view<10x64xi32>
  view.store %remainder_below_high_bit, %results[9, %column] : i32, view<10x64xi32>
