  %halfword_remainder = scalar.remsi %halfword, %halfword_divisor : i16
  %halfword_uniform_quotient = scalar.extsi %halfword_quotient : i16 to i32
  %halfword_uniform_remainder = scalar.extsi %halfword_remainder : i16 to i32
  scf.for %lane = [%begin to %end step %step] {
    %value = view.load %values[%lane] : view<16xi32> -> i32
    %byte_value = scalar.trunci %value : i32 to i8
    %byte_lane_quotient = scalar.divsi %byte_value, %byte_divisor : i8
    %byte_lane_remainder = scalar.remsi %byte_value, %byte_divisor : i8
    %byte_lane_quotient_wide = scalar.extsi %byte_lane_quotient : i8 to i32
    %byte_lane_remainder_wide = scalar.extsi %byte_lane_remainder : i8 to i32
    %halfword_value = scalar.trunci %value : i32 to i16
    %halfword_lane_quotient = scalar.divsi %halfword_value, %halfword_divisor : i16
    %halfword_lane_remainder = scalar.remsi %halfword_value, %halfword_divisor : i16
    %halfword_lane_quotient_wide = scalar.extsi %halfword_lane_quotient : i16 to i32
    %halfword_lane_remainder_wide = scalar.extsi %halfword_lane_remainder : i16 to i32
    view.store %byte_uniform_quotient, %results[0, %lane] : i32, view<8x16xi32>
    view.store %byte_uniform_remainder, %results[1, %lane] : i32, view<8x16xi32>
    view.store %byte_lane_quotient_wide, %results[2, %lane] : i32, view<8x16xi32>
    view.store %byte_lane_remainder_wide, %results[3, %lane] : i32, view<8x16xi32>
    view.store %halfword_uniform_quotient, %results[4, %lane] : i32, view<8x16xi32>
    view.store %halfword_uniform_remainder, %results[5, %lane] : i32, view<8x16xi32>
    view.store %halfword_lane_quotient_wide, %results[6, %lane] : i32, view<8x16xi32>
    view.store %halfword_lane_remainder_wide, %results[7, %lane] : i32, view<8x16xi32>
  }
  func.return
}

