func.def inline @dynamic_scalar_remainder_rows(%value: i32, %divisor_3: i32, %divisor_5: i32, %divisor_7: i32, %divisor_9: i32, %divisor_10: i32, %divisor_20: i32, %divisor_high_power: i32, %divisor_high_bit: i32, %divisor_largest: i32, %divisor_below_high_bit: i32, %output: buffer, %column: index) {
  %base = index.constant 0 : offset
