    %seed = check.entropy.read %input_entropy[%trial] : check.entropy -> i64
    %zero = check.literal value(0) : i64
    %input = check.generate.random.uniform seed(%seed) range(-9223372036854775808 to 9223372036854775807) : tensor<16xi64>
    %storage = check.generate.fill value(-123) : tensor<44xi64>
