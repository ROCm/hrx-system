    %seed = check.entropy.read %input_entropy[%trial] : check.entropy -> i64
    %zero = check.literal value(0) : i64
    %input = check.generate.random.uniform seed(%seed) range(-9223372036854775807 to 9223372036854775807) : tensor<12xi64>
    %output = check.generate.fill value(-123) : tensor<28xi64>
    check.compare<@constant_wide_signed_division, @dynamic_wide_signed_division>(%zero, %uniform, %input, %output) : (i64, i64, tensor<12xi64>, tensor<28xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<28xi64>
    }
  }
  check.return
}

// Signed minimum remainder by negative one is defined even though the matching
// quotient overflows. Dynamic divisors keep the oracle independent.
func.def @constant_signed_minimum_remainders(%dynamic_zero: i64, %output: buffer) {
  %base = index.constant 0 : offset
  %results = buffer.view %output[%base] : buffer -> view<4xi64>
  %byte_minimum = scalar.constant -128 : i8
  %byte_opposite_unit = scalar.constant -1 : i8
  %byte_remainder = scalar.remsi %byte_minimum, %byte_opposite_unit : i8
  %byte_result = scalar.extsi %byte_remainder : i8 to i32
  %byte_storage = scalar.extsi %byte_result : i32 to i64
  %halfword_minimum = scalar.constant -32768 : i16
  %halfword_opposite_unit = scalar.constant -1 : i16
  %halfword_remainder = scalar.remsi %halfword_minimum, %halfword_opposite_unit : i16
  %halfword_result = scalar.extsi %halfword_remainder : i16 to i32
  %halfword_storage = scalar.extsi %halfword_result : i32 to i64
  %word_minimum = scalar.constant -2147483648 : i32
  %word_opposite_unit = scalar.constant -1 : i32
  %word_remainder = scalar.remsi %word_minimum, %word_opposite_unit : i32
  %word_storage = scalar.extsi %word_remainder : i32 to i64
  %wide_minimum = scalar.constant -9223372036854775808 : i64
  %wide_opposite_unit = scalar.constant -1 : i64
  %wide_remainder = scalar.remsi %wide_minimum, %wide_opposite_unit : i64
  view.store %byte_storage, %results[0] : i64, view<4xi64>
  view.store %halfword_storage, %results[1] : i64, view<4xi64>
  view.store %word_storage, %results[2] : i64, view<4xi64>
  view.store %wide_remainder, %results[3] : i64, view<4xi64>
  func.return
}

func.def @dynamic_signed_minimum_remainders(%dynamic_zero: i64, %output: buffer) {
  %base = index.constant 0 : offset
  %results = buffer.view %output[%base] : buffer -> view<4xi64>
  %byte_zero = scalar.trunci %dynamic_zero : i64 to i8
  %byte_minimum = scalar.constant -128 : i8
  %byte_opposite_unit = scalar.constant -1 : i8
  %byte_divisor = scalar.addi %byte_zero, %byte_opposite_unit : i8
  %byte_remainder = scalar.remsi %byte_minimum, %byte_divisor : i8
  %byte_result = scalar.extsi %byte_remainder : i8 to i32
  %byte_storage = scalar.extsi %byte_result : i32 to i64
  %halfword_zero = scalar.trunci %dynamic_zero : i64 to i16
  %halfword_minimum = scalar.constant -32768 : i16
  %halfword_opposite_unit = scalar.constant -1 : i16
  %halfword_divisor = scalar.addi %halfword_zero, %halfword_opposite_unit : i16
  %halfword_remainder = scalar.remsi %halfword_minimum, %halfword_divisor : i16
  %halfword_result = scalar.extsi %halfword_remainder : i16 to i32
  %halfword_storage = scalar.extsi %halfword_result : i32 to i64
  %word_zero = scalar.trunci %dynamic_zero : i64 to i32
  %word_minimum = scalar.constant -2147483648 : i32
  %word_opposite_unit = scalar.constant -1 : i32
  %word_divisor = scalar.addi %word_zero, %word_opposite_unit : i32
  %word_remainder = scalar.remsi %word_minimum, %word_divisor : i32
  %word_storage = scalar.extsi %word_remainder : i32 to i64
  %wide_minimum = scalar.constant -9223372036854775808 : i64
  %wide_opposite_unit = scalar.constant -1 : i64
  %wide_divisor = scalar.addi %dynamic_zero, %wide_opposite_unit : i64
  %wide_remainder = scalar.remsi %wide_minimum, %wide_divisor : i64
  view.store %byte_storage, %results[0] : i64, view<4xi64>
  view.store %halfword_storage, %results[1] : i64, view<4xi64>
  view.store %word_storage, %results[2] : i64, view<4xi64>
  view.store %wide_remainder, %results[3] : i64, view<4xi64>
  func.return
}

check.scenario @constant_signed_minimum_remainder_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %zero = check.literal value(0) : i64
    %output = check.generate.fill value(-123) : tensor<4xi64>
    check.compare<@constant_signed_minimum_remainders, @dynamic_signed_minimum_remainders>(%zero, %output) : (i64, tensor<4xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi64>
    }
  }
  check.return
}
