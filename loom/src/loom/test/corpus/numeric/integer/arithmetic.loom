// Directed zero and signed-minimum trials cover unary boundaries while
// deterministic entropy exercises every rotate count and signed/unsigned
// ordering with runtime values.

func.def @integer_arithmetic_i32_observations(%ordinal: index, %value_bits: i64, %lower_bits: i64, %upper_bits: i64, %output: buffer) {
  %c0_index = index.constant 0 : index
  %c1_index = index.constant 1 : index
  %c16_index = index.constant 16 : index
  %cwidth_index = index.constant 32 : index
  %base = index.constant 0 : offset
  %results = buffer.view %output[%base] : buffer -> view<12xi32>
  %bounded_ordinal = index.assume %ordinal [range(%ordinal, 0, 255)] : index
  %case = index.rem %bounded_ordinal, %c16_index : index
  %use_zero = index.cmp eq, %case, %c0_index : index
  %use_minimum = index.cmp eq, %case, %c1_index : index
  %random_value = scalar.trunci %value_bits : i64 to i32
  %lower = scalar.trunci %lower_bits : i64 to i32
  %upper = scalar.trunci %upper_bits : i64 to i32
  %minimum = scalar.constant -2147483648 : i32
  %c0 = scalar.constant 0 : i32
  %value0 = scf.select %use_zero, %c0, %random_value : i32
  %value = scf.select %use_minimum, %minimum, %value0 : i32
  %shift_index = index.rem %bounded_ordinal, %cwidth_index : index
  %shift = index.cast %shift_index : index to i32
  %signed_lower = scalar.maxsi %value, %lower : i32
  %signed_clamp = scalar.minsi %signed_lower, %upper : i32
  %unsigned_lower = scalar.maxui %value, %lower : i32
  %unsigned_clamp = scalar.minui %unsigned_lower, %upper : i32
  %left = scalar.rotli %value, %shift : i32
  %right = scalar.rotri %value, %shift : i32
  %logical = scalar.shrui %value, %shift : i32
  %negated = scalar.negi %value : i32
  %absolute = scalar.absi %value : i32
  %leading = scalar.ctlzi %value : i32
  %trailing = scalar.cttzi %value : i32
  %population = scalar.ctpopi %value : i32
  %fused = scalar.fmai %value, %lower, %upper : i32
  view.store %signed_clamp, %results[0] : i32, view<12xi32>
  view.store %unsigned_clamp, %results[1] : i32, view<12xi32>
  view.store %left, %results[2] : i32, view<12xi32>
  view.store %right, %results[3] : i32, view<12xi32>
  view.store %negated, %results[4] : i32, view<12xi32>
  view.store %absolute, %results[5] : i32, view<12xi32>
  view.store %leading, %results[6] : i32, view<12xi32>
  view.store %trailing, %results[7] : i32, view<12xi32>
  view.store %population, %results[8] : i32, view<12xi32>
  view.store %shift, %results[9] : i32, view<12xi32>
  view.store %fused, %results[10] : i32, view<12xi32>
  view.store %logical, %results[11] : i32, view<12xi32>
  func.return
}

check.scenario @integer_arithmetic_i32_values {
  check.trial[256](%trial: index, %entropy: check.entropy) {
    %value_entropy = check.entropy.fork %entropy name("value") : check.entropy
    %lower_entropy = check.entropy.fork %entropy name("lower") : check.entropy
    %upper_entropy = check.entropy.fork %entropy name("upper") : check.entropy
    %value_bits = check.entropy.read %value_entropy[%trial] : check.entropy -> i64
    %lower_bits = check.entropy.read %lower_entropy[%trial] : check.entropy -> i64
    %upper_bits = check.entropy.read %upper_entropy[%trial] : check.entropy -> i64
    %output = check.generate.fill value(0) : tensor<12xi32>
    check.compare<@integer_arithmetic_i32_observations>(%trial, %value_bits, %lower_bits, %upper_bits, %output) : (index, i64, i64, i64, tensor<12xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<12xi32>
    }
  }
  check.return
}

func.def @integer_arithmetic_i64_observations(%ordinal: index, %value_bits: i64, %lower_bits: i64, %upper_bits: i64, %output: buffer) {
  %c0_index = index.constant 0 : index
  %c1_index = index.constant 1 : index
  %c16_index = index.constant 16 : index
  %cwidth_index = index.constant 64 : index
  %base = index.constant 0 : offset
  %results = buffer.view %output[%base] : buffer -> view<11xi64>
  %bounded_ordinal = index.assume %ordinal [range(%ordinal, 0, 255)] : index
  %case = index.rem %bounded_ordinal, %c16_index : index
  %use_zero = index.cmp eq, %case, %c0_index : index
  %use_minimum = index.cmp eq, %case, %c1_index : index
  %minimum = scalar.constant -9223372036854775808 : i64
  %c0 = scalar.constant 0 : i64
  %value0 = scf.select %use_zero, %c0, %value_bits : i64
  %value = scf.select %use_minimum, %minimum, %value0 : i64
  %shift_index = index.rem %bounded_ordinal, %cwidth_index : index
  %shift = index.cast %shift_index : index to i64
  %signed_lower = scalar.maxsi %value, %lower_bits : i64
  %signed_clamp = scalar.minsi %signed_lower, %upper_bits : i64
  %unsigned_lower = scalar.maxui %value, %lower_bits : i64
  %unsigned_clamp = scalar.minui %unsigned_lower, %upper_bits : i64
  %left = scalar.rotli %value, %shift : i64
  %right = scalar.rotri %value, %shift : i64
  %logical = scalar.shrui %value, %shift : i64
  %negated = scalar.negi %value : i64
  %absolute = scalar.absi %value : i64
  %leading = scalar.ctlzi %value : i64
  %trailing = scalar.cttzi %value : i64
  %population = scalar.ctpopi %value : i64
  view.store %signed_clamp, %results[0] : i64, view<11xi64>
  view.store %unsigned_clamp, %results[1] : i64, view<11xi64>
  view.store %left, %results[2] : i64, view<11xi64>
  view.store %right, %results[3] : i64, view<11xi64>
  view.store %negated, %results[4] : i64, view<11xi64>
  view.store %absolute, %results[5] : i64, view<11xi64>
  view.store %leading, %results[6] : i64, view<11xi64>
  view.store %trailing, %results[7] : i64, view<11xi64>
  view.store %population, %results[8] : i64, view<11xi64>
  view.store %shift, %results[9] : i64, view<11xi64>
  view.store %logical, %results[10] : i64, view<11xi64>
  func.return
}

check.scenario @integer_arithmetic_i64_values {
  check.trial[256](%trial: index, %entropy: check.entropy) {
    %value_entropy = check.entropy.fork %entropy name("value") : check.entropy
    %lower_entropy = check.entropy.fork %entropy name("lower") : check.entropy
    %upper_entropy = check.entropy.fork %entropy name("upper") : check.entropy
    %value_bits = check.entropy.read %value_entropy[%trial] : check.entropy -> i64
    %lower_bits = check.entropy.read %lower_entropy[%trial] : check.entropy -> i64
    %upper_bits = check.entropy.read %upper_entropy[%trial] : check.entropy -> i64
    %output = check.generate.fill value(0) : tensor<11xi64>
    check.compare<@integer_arithmetic_i64_observations>(%trial, %value_bits, %lower_bits, %upper_bits, %output) : (index, i64, i64, i64, tensor<11xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<11xi64>
    }
  }
  check.return
}

// Exercises every fixed integer width through one runtime input pair. Results
// are widened only after the operation so carry and borrow retain the source
// width's unsigned boundary.
func.def @extended_unsigned_arithmetic_observations(%lhs_bits: i64, %rhs_bits: i64, %output: buffer) {
  %base = index.constant 0 : offset
  %i1_base = index.constant 128 : offset
  %results = buffer.view %output[%base] : buffer -> view<16xi64>
  %i1_results = buffer.view %output[%i1_base] : buffer -> view<4xi64>

  %lhs8 = scalar.trunci %lhs_bits : i64 to i8
  %rhs8 = scalar.trunci %rhs_bits : i64 to i8
  %sum8, %carry8 = scalar.addui_extended %lhs8, %rhs8 : i8
  %difference8, %borrow8 = scalar.subui_extended %lhs8, %rhs8 : i8
  %sum8_wide = scalar.extui %sum8 : i8 to i64
  %carry8_wide = scalar.extui %carry8 : i1 to i64
  %difference8_wide = scalar.extui %difference8 : i8 to i64
  %borrow8_wide = scalar.extui %borrow8 : i1 to i64
  view.store %sum8_wide, %results[0] : i64, view<16xi64>
  view.store %carry8_wide, %results[1] : i64, view<16xi64>
  view.store %difference8_wide, %results[2] : i64, view<16xi64>
  view.store %borrow8_wide, %results[3] : i64, view<16xi64>

  %lhs16 = scalar.trunci %lhs_bits : i64 to i16
  %rhs16 = scalar.trunci %rhs_bits : i64 to i16
  %sum16, %carry16 = scalar.addui_extended %lhs16, %rhs16 : i16
  %difference16, %borrow16 = scalar.subui_extended %lhs16, %rhs16 : i16
  %sum16_wide = scalar.extui %sum16 : i16 to i64
  %carry16_wide = scalar.extui %carry16 : i1 to i64
  %difference16_wide = scalar.extui %difference16 : i16 to i64
  %borrow16_wide = scalar.extui %borrow16 : i1 to i64
  view.store %sum16_wide, %results[4] : i64, view<16xi64>
  view.store %carry16_wide, %results[5] : i64, view<16xi64>
  view.store %difference16_wide, %results[6] : i64, view<16xi64>
  view.store %borrow16_wide, %results[7] : i64, view<16xi64>

  %lhs32 = scalar.trunci %lhs_bits : i64 to i32
  %rhs32 = scalar.trunci %rhs_bits : i64 to i32
  %sum32, %carry32 = scalar.addui_extended %lhs32, %rhs32 : i32
  %difference32, %borrow32 = scalar.subui_extended %lhs32, %rhs32 : i32
  %sum32_wide = scalar.extui %sum32 : i32 to i64
  %carry32_wide = scalar.extui %carry32 : i1 to i64
  %difference32_wide = scalar.extui %difference32 : i32 to i64
  %borrow32_wide = scalar.extui %borrow32 : i1 to i64
  view.store %sum32_wide, %results[8] : i64, view<16xi64>
  view.store %carry32_wide, %results[9] : i64, view<16xi64>
  view.store %difference32_wide, %results[10] : i64, view<16xi64>
  view.store %borrow32_wide, %results[11] : i64, view<16xi64>

  %sum64, %carry64 = scalar.addui_extended %lhs_bits, %rhs_bits : i64
  %difference64, %borrow64 = scalar.subui_extended %lhs_bits, %rhs_bits : i64
  %carry64_wide = scalar.extui %carry64 : i1 to i64
  %borrow64_wide = scalar.extui %borrow64 : i1 to i64
  view.store %sum64, %results[12] : i64, view<16xi64>
  view.store %carry64_wide, %results[13] : i64, view<16xi64>
  view.store %difference64, %results[14] : i64, view<16xi64>
  view.store %borrow64_wide, %results[15] : i64, view<16xi64>

  %lhs1 = scalar.trunci %lhs_bits : i64 to i1
  %rhs1 = scalar.trunci %rhs_bits : i64 to i1
  %sum1, %carry1 = scalar.addui_extended %lhs1, %rhs1 : i1
  %difference1, %borrow1 = scalar.subui_extended %lhs1, %rhs1 : i1
  %sum1_wide = scalar.extui %sum1 : i1 to i64
  %carry1_wide = scalar.extui %carry1 : i1 to i64
  %difference1_wide = scalar.extui %difference1 : i1 to i64
  %borrow1_wide = scalar.extui %borrow1 : i1 to i64
  view.store %sum1_wide, %i1_results[0] : i64, view<4xi64>
  view.store %carry1_wide, %i1_results[1] : i64, view<4xi64>
  view.store %difference1_wide, %i1_results[2] : i64, view<4xi64>
  view.store %borrow1_wide, %i1_results[3] : i64, view<4xi64>
  func.return
}

// Uses ordinary modular arithmetic and unsigned comparisons as an independent
// expression of the extended-operation contract.
func.def @extended_unsigned_arithmetic_oracle(%lhs_bits: i64, %rhs_bits: i64, %output: buffer) {
  %base = index.constant 0 : offset
  %i1_base = index.constant 128 : offset
  %results = buffer.view %output[%base] : buffer -> view<16xi64>
  %i1_results = buffer.view %output[%i1_base] : buffer -> view<4xi64>

  %lhs8 = scalar.trunci %lhs_bits : i64 to i8
  %rhs8 = scalar.trunci %rhs_bits : i64 to i8
  %sum8 = scalar.addi %lhs8, %rhs8 : i8
  %carry8 = scalar.cmpi ult, %sum8, %lhs8 : i8
  %difference8 = scalar.subi %lhs8, %rhs8 : i8
  %borrow8 = scalar.cmpi ult, %lhs8, %rhs8 : i8
  %sum8_wide = scalar.extui %sum8 : i8 to i64
  %carry8_wide = scalar.extui %carry8 : i1 to i64
  %difference8_wide = scalar.extui %difference8 : i8 to i64
  %borrow8_wide = scalar.extui %borrow8 : i1 to i64
  view.store %sum8_wide, %results[0] : i64, view<16xi64>
  view.store %carry8_wide, %results[1] : i64, view<16xi64>
  view.store %difference8_wide, %results[2] : i64, view<16xi64>
  view.store %borrow8_wide, %results[3] : i64, view<16xi64>

  %lhs16 = scalar.trunci %lhs_bits : i64 to i16
  %rhs16 = scalar.trunci %rhs_bits : i64 to i16
  %sum16 = scalar.addi %lhs16, %rhs16 : i16
  %carry16 = scalar.cmpi ult, %sum16, %lhs16 : i16
  %difference16 = scalar.subi %lhs16, %rhs16 : i16
  %borrow16 = scalar.cmpi ult, %lhs16, %rhs16 : i16
  %sum16_wide = scalar.extui %sum16 : i16 to i64
  %carry16_wide = scalar.extui %carry16 : i1 to i64
  %difference16_wide = scalar.extui %difference16 : i16 to i64
  %borrow16_wide = scalar.extui %borrow16 : i1 to i64
  view.store %sum16_wide, %results[4] : i64, view<16xi64>
  view.store %carry16_wide, %results[5] : i64, view<16xi64>
  view.store %difference16_wide, %results[6] : i64, view<16xi64>
  view.store %borrow16_wide, %results[7] : i64, view<16xi64>

  %lhs32 = scalar.trunci %lhs_bits : i64 to i32
  %rhs32 = scalar.trunci %rhs_bits : i64 to i32
  %sum32 = scalar.addi %lhs32, %rhs32 : i32
  %carry32 = scalar.cmpi ult, %sum32, %lhs32 : i32
  %difference32 = scalar.subi %lhs32, %rhs32 : i32
  %borrow32 = scalar.cmpi ult, %lhs32, %rhs32 : i32
  %sum32_wide = scalar.extui %sum32 : i32 to i64
  %carry32_wide = scalar.extui %carry32 : i1 to i64
  %difference32_wide = scalar.extui %difference32 : i32 to i64
  %borrow32_wide = scalar.extui %borrow32 : i1 to i64
  view.store %sum32_wide, %results[8] : i64, view<16xi64>
  view.store %carry32_wide, %results[9] : i64, view<16xi64>
  view.store %difference32_wide, %results[10] : i64, view<16xi64>
  view.store %borrow32_wide, %results[11] : i64, view<16xi64>

  %sum64 = scalar.addi %lhs_bits, %rhs_bits : i64
  %carry64 = scalar.cmpi ult, %sum64, %lhs_bits : i64
  %difference64 = scalar.subi %lhs_bits, %rhs_bits : i64
  %borrow64 = scalar.cmpi ult, %lhs_bits, %rhs_bits : i64
  %carry64_wide = scalar.extui %carry64 : i1 to i64
  %borrow64_wide = scalar.extui %borrow64 : i1 to i64
  view.store %sum64, %results[12] : i64, view<16xi64>
  view.store %carry64_wide, %results[13] : i64, view<16xi64>
  view.store %difference64, %results[14] : i64, view<16xi64>
  view.store %borrow64_wide, %results[15] : i64, view<16xi64>

  %lhs1 = scalar.trunci %lhs_bits : i64 to i1
  %rhs1 = scalar.trunci %rhs_bits : i64 to i1
  %sum1 = scalar.xori %lhs1, %rhs1 : i1
  %carry1 = scalar.andi %lhs1, %rhs1 : i1
  %borrow1 = scalar.andi %rhs1, %sum1 : i1
  %sum1_wide = scalar.extui %sum1 : i1 to i64
  %carry1_wide = scalar.extui %carry1 : i1 to i64
  %borrow1_wide = scalar.extui %borrow1 : i1 to i64
  view.store %sum1_wide, %i1_results[0] : i64, view<4xi64>
  view.store %carry1_wide, %i1_results[1] : i64, view<4xi64>
  view.store %sum1_wide, %i1_results[2] : i64, view<4xi64>
  view.store %borrow1_wide, %i1_results[3] : i64, view<4xi64>
  func.return
}

func.def @extended_unsigned_arithmetic_boundary_input(%trial: index) -> (i64, i64) {
  %first = index.constant 0 : index
  %is_first = index.cmp eq, %trial, %first : index
  %c0 = scalar.constant 0 : i64
  %c1 = scalar.constant 1 : i64
  %maximum = scalar.constant -1 : i64
  %lhs = scf.select %is_first, %maximum, %c0 : i64
  %rhs = scf.select %is_first, %c1, %maximum : i64
  func.return %lhs, %rhs : i64, i64
}

check.scenario @extended_unsigned_arithmetic_values {
  check.trial[2](%trial: index, %entropy: check.entropy) {
    %lhs, %rhs = check.generate<@extended_unsigned_arithmetic_boundary_input>(%trial) : (index) -> (i64, i64)
    %output = check.generate.fill value(0) : tensor<20xi64>
    check.compare<@extended_unsigned_arithmetic_observations, @extended_unsigned_arithmetic_oracle>(%lhs, %rhs, %output) : (i64, i64, tensor<20xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<20xi64>
    }
  }
  check.trial[256](%trial: index, %entropy: check.entropy) {
    %lhs_entropy = check.entropy.fork %entropy name("lhs") : check.entropy
    %rhs_entropy = check.entropy.fork %entropy name("rhs") : check.entropy
    %lhs = check.entropy.read %lhs_entropy[%trial] : check.entropy -> i64
    %rhs = check.entropy.read %rhs_entropy[%trial] : check.entropy -> i64
    %output = check.generate.fill value(0) : tensor<20xi64>
    check.compare<@extended_unsigned_arithmetic_observations, @extended_unsigned_arithmetic_oracle>(%lhs, %rhs, %output) : (i64, i64, tensor<20xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<20xi64>
    }
  }
  check.return
}
