// Directed zero and signed-minimum trials cover unary boundaries while
// deterministic entropy exercises every rotate count and signed/unsigned
// ordering with runtime values.

func.def @integer_arithmetic_i32_observations(%ordinal: index, %value_bits: i64, %lower_bits: i64, %upper_bits: i64, %output: buffer) {
  %c0_index = index.constant 0 : index
  %c1_index = index.constant 1 : index
  %c16_index = index.constant 16 : index
  %cwidth_index = index.constant 32 : index
  %base = index.constant 0 : offset
  %results = buffer.view %output[%base] : buffer -> view<12xi32>
  %bounded_ordinal = index.assume %ordinal [range(%ordinal, 0, 255)] : index
  %case = index.rem %bounded_ordinal, %c16_index : index
  %use_zero = index.cmp eq, %case, %c0_index : index
  %use_minimum = index.cmp eq, %case, %c1_index : index
  %random_value = scalar.trunci %value_bits : i64 to i32
  %lower = scalar.trunci %lower_bits : i64 to i32
  %upper = scalar.trunci %upper_bits : i64 to i32
  %minimum = scalar.constant -2147483648 : i32
  %c0 = scalar.constant 0 : i32
  %value0 = scf.select %use_zero, %c0, %random_value : i32
  %value = scf.select %use_minimum, %minimum, %value0 : i32
  %shift_index = index.rem %bounded_ordinal, %cwidth_index : index
  %shift = index.cast %shift_index : index to i32
  %signed_lower = scalar.maxsi %value, %lower : i32
  %signed_clamp = scalar.minsi %signed_lower, %upper : i32
  %unsigned_lower = scalar.maxui %value, %lower : i32
  %unsigned_clamp = scalar.minui %unsigned_lower, %upper : i32
  %left = scalar.rotli %value, %shift : i32
  %right = scalar.rotri %value, %shift : i32
  %logical = scalar.shrui %value, %shift : i32
  %negated = scalar.negi %value : i32
  %absolute = scalar.absi %value : i32
  %leading = scalar.ctlzi %value : i32
  %trailing = scalar.cttzi %value : i32
  %population = scalar.ctpopi %value : i32
  %fused = scalar.fmai %value, %lower, %upper : i32
  view.store %signed_clamp, %results[0] : i32, view<12xi32>
  view.store %unsigned_clamp, %results[1] : i32, view<12xi32>
  view.store %left, %results[2] : i32, view<12xi32>
  view.store %right, %results[3] : i32, view<12xi32>
  view.store %negated, %results[4] : i32, view<12xi32>
  view.store %absolute, %results[5] : i32, view<12xi32>
  view.store %leading, %results[6] : i32, view<12xi32>
  view.store %trailing, %results[7] : i32, view<12xi32>
  view.store %population, %results[8] : i32, view<12xi32>
  view.store %shift, %results[9] : i32, view<12xi32>
  view.store %fused, %results[10] : i32, view<12xi32>
  view.store %logical, %results[11] : i32, view<12xi32>
  func.return
}

check.scenario @integer_arithmetic_i32_values {
  check.trial[256](%trial: index, %entropy: check.entropy) {
    %value_entropy = check.entropy.fork %entropy name("value") : check.entropy
    %lower_entropy = check.entropy.fork %entropy name("lower") : check.entropy
    %upper_entropy = check.entropy.fork %entropy name("upper") : check.entropy
    %value_bits = check.entropy.read %value_entropy[%trial] : check.entropy -> i64
    %lower_bits = check.entropy.read %lower_entropy[%trial] : check.entropy -> i64
    %upper_bits = check.entropy.read %upper_entropy[%trial] : check.entropy -> i64
    %output = check.generate.fill value(0) : tensor<12xi32>
    check.compare<@integer_arithmetic_i32_observations>(%trial, %value_bits, %lower_bits, %upper_bits, %output) : (index, i64, i64, i64, tensor<12xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<12xi32>
    }
  }
  check.return
}

func.def @integer_arithmetic_i64_observations(%ordinal: index, %value_bits: i64, %lower_bits: i64, %upper_bits: i64, %output: buffer) {
  %c0_index = index.constant 0 : index
  %c1_index = index.constant 1 : index
  %c16_index = index.constant 16 : index
  %cwidth_index = index.constant 64 : index
  %base = index.constant 0 : offset
  %results = buffer.view %output[%base] : buffer -> view<11xi64>
  %bounded_ordinal = index.assume %ordinal [range(%ordinal, 0, 255)] : index
  %case = index.rem %bounded_ordinal, %c16_index : index
  %use_zero = index.cmp eq, %case, %c0_index : index
  %use_minimum = index.cmp eq, %case, %c1_index : index
  %minimum = scalar.constant -9223372036854775808 : i64
  %c0 = scalar.constant 0 : i64
  %value0 = scf.select %use_zero, %c0, %value_bits : i64
  %value = scf.select %use_minimum, %minimum, %value0 : i64
  %shift_index = index.rem %bounded_ordinal, %cwidth_index : index
  %shift = index.cast %shift_index : index to i64
  %signed_lower = scalar.maxsi %value, %lower_bits : i64
  %signed_clamp = scalar.minsi %signed_lower, %upper_bits : i64
  %unsigned_lower = scalar.maxui %value, %lower_bits : i64
  %unsigned_clamp = scalar.minui %unsigned_lower, %upper_bits : i64
  %left = scalar.rotli %value, %shift : i64
  %right = scalar.rotri %value, %shift : i64
  %logical = scalar.shrui %value, %shift : i64
  %negated = scalar.negi %value : i64
  %absolute = scalar.absi %value : i64
  %leading = scalar.ctlzi %value : i64
  %trailing = scalar.cttzi %value : i64
  %population = scalar.ctpopi %value : i64
  view.store %signed_clamp, %results[0] : i64, view<11xi64>
  view.store %unsigned_clamp, %results[1] : i64, view<11xi64>
  view.store %left, %results[2] : i64, view<11xi64>
  view.store %right, %results[3] : i64, view<11xi64>
  view.store %negated, %results[4] : i64, view<11xi64>
  view.store %absolute, %results[5] : i64, view<11xi64>
  view.store %leading, %results[6] : i64, view<11xi64>
  view.store %trailing, %results[7] : i64, view<11xi64>
  view.store %population, %results[8] : i64, view<11xi64>
  view.store %shift, %results[9] : i64, view<11xi64>
  view.store %logical, %results[10] : i64, view<11xi64>
  func.return
}

check.scenario @integer_arithmetic_i64_values {
  check.trial[256](%trial: index, %entropy: check.entropy) {
    %value_entropy = check.entropy.fork %entropy name("value") : check.entropy
    %lower_entropy = check.entropy.fork %entropy name("lower") : check.entropy
    %upper_entropy = check.entropy.fork %entropy name("upper") : check.entropy
    %value_bits = check.entropy.read %value_entropy[%trial] : check.entropy -> i64
    %lower_bits = check.entropy.read %lower_entropy[%trial] : check.entropy -> i64
    %upper_bits = check.entropy.read %upper_entropy[%trial] : check.entropy -> i64
    %output = check.generate.fill value(0) : tensor<11xi64>
    check.compare<@integer_arithmetic_i64_observations>(%trial, %value_bits, %lower_bits, %upper_bits, %output) : (index, i64, i64, i64, tensor<11xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<11xi64>
    }
  }
  check.return
}
