// Uniform immediate addition preserves carry across both halves of an i64.
kernel.def @uniform_i64_add_immediate() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: i64, %output: buffer) {
  %step = scalar.constant 256 : i64
  %sum = scalar.addi %input, %step : i64
  %base = index.constant 0 : offset
  %dest = buffer.view %output[%base] : buffer -> view<1xi64>
  view.store %sum, %dest[0] : i64, view<1xi64>
  kernel.return
}

kernel.def @uniform_i64_add_negative_immediate() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: i64, %output: buffer) {
  %step = scalar.constant -256 : i64
  %sum = scalar.addi %input, %step : i64
  %base = index.constant 0 : offset
  %dest = buffer.view %output[%base] : buffer -> view<1xi64>
  view.store %sum, %dest[0] : i64, view<1xi64>
  kernel.return
}

func.def @uniform_i64_add_immediate_oracle(%input: i64, %output: buffer) {
  %step = scalar.constant 256 : i64
  %sum = scalar.addi %input, %step : i64
  %base = index.constant 0 : offset
  %dest = buffer.view %output[%base] : buffer -> view<1xi64>
  view.store %sum, %dest[0] : i64, view<1xi64>
  func.return
}

func.def @uniform_i64_add_negative_immediate_oracle(%input: i64, %output: buffer) {
  %step = scalar.constant -256 : i64
  %sum = scalar.addi %input, %step : i64
  %base = index.constant 0 : offset
  %dest = buffer.view %output[%base] : buffer -> view<1xi64>
  view.store %sum, %dest[0] : i64, view<1xi64>
  func.return
}

check.scenario @uniform_i64_add_immediate_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.literal value(-128) : i64
    %output = check.generate.fill value(99) : tensor<1xi64>
    check.compare<@uniform_i64_add_immediate, @uniform_i64_add_immediate_oracle>(%input, %output) : (i64, tensor<1xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<1xi64>
    }
  }
  check.trial[256](%trial: index, %entropy: check.entropy) {
    %input = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %output = check.generate.fill value(99) : tensor<1xi64>
    check.compare<@uniform_i64_add_immediate, @uniform_i64_add_immediate_oracle>(%input, %output) : (i64, tensor<1xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<1xi64>
    }
  }
  check.return
}

check.scenario @uniform_i64_add_negative_immediate_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.literal value(-9223372036854775680) : i64
    %output = check.generate.fill value(99) : tensor<1xi64>
    check.compare<@uniform_i64_add_negative_immediate, @uniform_i64_add_negative_immediate_oracle>(%input, %output) : (i64, tensor<1xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<1xi64>
    }
  }
  check.trial[256](%trial: index, %entropy: check.entropy) {
    %input = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %output = check.generate.fill value(99) : tensor<1xi64>
    check.compare<@uniform_i64_add_negative_immediate, @uniform_i64_add_negative_immediate_oracle>(%input, %output) : (i64, tensor<1xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<1xi64>
    }
  }
  check.return
}
