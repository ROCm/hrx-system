// Left shifts preserve full 64-bit payloads with immediate, scalar-register,
// and loaded vector-register counts. Every output row has an exact oracle.
kernel.def @integer_wide_shifts() {
  %unit = index.constant 1 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%uniform_count: i64, %input: buffer, %counts: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %input_base = index.constant 0 : offset
  %output_base = index.constant 128 : offset
  %aligned_input = buffer.assume.alignment %input {minimum_alignment = 8} : buffer
  %aligned_counts = buffer.assume.alignment %counts {minimum_alignment = 8} : buffer
  %aligned_output = buffer.assume.alignment %output {minimum_alignment = 8} : buffer
  %inputs = buffer.view %aligned_input[%input_base] : buffer -> view<32xi64>
  %shifts = buffer.view %aligned_counts[%input_base] : buffer -> view<32xi64>
  %outputs = buffer.view %aligned_output[%output_base] : buffer -> view<8x32xi64>
  %value = view.load %inputs[%lane] : view<32xi64> -> i64
  %varying_count = view.load %shifts[%lane] : view<32xi64> -> i64
  %count_0 = scalar.constant 0 : i64
  %shifted_0 = scalar.shli %value, %count_0 : i64
  view.store %shifted_0, %outputs[0, %lane] : i64, view<8x32xi64>
  %count_1 = scalar.constant 1 : i64
  %shifted_1 = scalar.shli %value, %count_1 : i64
  view.store %shifted_1, %outputs[1, %lane] : i64, view<8x32xi64>
  %count_2 = scalar.constant 2 : i64
  %shifted_2 = scalar.shli %value, %count_2 : i64
  view.store %shifted_2, %outputs[2, %lane] : i64, view<8x32xi64>
  %count_31 = scalar.constant 31 : i64
  %shifted_31 = scalar.shli %value, %count_31 : i64
  view.store %shifted_31, %outputs[3, %lane] : i64, view<8x32xi64>
  %count_32 = scalar.constant 32 : i64
  %shifted_32 = scalar.shli %value, %count_32 : i64
  view.store %shifted_32, %outputs[4, %lane] : i64, view<8x32xi64>
  %count_63 = scalar.constant 63 : i64
  %shifted_63 = scalar.shli %value, %count_63 : i64
  view.store %shifted_63, %outputs[5, %lane] : i64, view<8x32xi64>
  %uniform_result = scalar.shli %value, %uniform_count : i64
  view.store %uniform_result, %outputs[6, %lane] : i64, view<8x32xi64>
  %varying_result = scalar.shli %value, %varying_count : i64
  view.store %varying_result, %outputs[7, %lane] : i64, view<8x32xi64>
  kernel.return
}

// Alternating per-lane counts expose accidental scalarization of a loaded count.
// Each column observes dynamic, immediate and bounded shifts, then reuses the
// original operands. The kernel combines uniform operands, loaded values with
// a uniform count, and loaded values with per-lane counts.
func.def inline @wide_shift_observations(%value: i64, %count_input: i64, %other_count_input: i64, %output: buffer, %column: index) {
  %base = index.constant 128 : offset
  %results = buffer.view %output[%base] : buffer -> view<32x96xi64>
  %c1 = scalar.constant 1 : i64
  %c6 = scalar.constant 6 : i64
  %c16 = scalar.constant 16 : i64
  %last_low = scalar.constant 31 : i64
  %first_high = scalar.constant 32 : i64
  %last_high = scalar.constant 63 : i64
  %count = scalar.assume %count_input [range(%count_input, 0, 63)] : i64
  %other_count = scalar.assume %other_count_input [range(%other_count_input, 0, 63)] : i64
  %low = scalar.andi %count, %last_low : i64
  %high = scalar.ori %low, %first_high : i64
  %nonzero = scalar.ori %low, %c1 : i64
  %parity = scalar.andi %count, %c1 : i64
  %crossing = scalar.addi %parity, %last_low : i64
  %low_count = scalar.assume %low [range(%low, 0, 31)] : i64
  %high_count = scalar.assume %high [range(%high, 32, 63)] : i64
  %nonzero_count = scalar.assume %nonzero [range(%nonzero, 1, 31)] : i64
  %crossing_count = scalar.assume %crossing [range(%crossing, 31, 32)] : i64
  %left = scalar.shli %value, %count : i64
  %logical = scalar.shrui %value, %count : i64
  %signed = scalar.shrsi %value, %count : i64
  view.store %left, %results[0, %column] : i64, view<32x96xi64>
  view.store %logical, %results[1, %column] : i64, view<32x96xi64>
  view.store %signed, %results[2, %column] : i64, view<32x96xi64>
  %logical_31 = scalar.shrui %value, %last_low : i64
  %signed_31 = scalar.shrsi %value, %last_low : i64
  %logical_32 = scalar.shrui %value, %first_high : i64
  %signed_32 = scalar.shrsi %value, %first_high : i64
  %logical_63 = scalar.shrui %value, %last_high : i64
  %signed_63 = scalar.shrsi %value, %last_high : i64
  view.store %logical_31, %results[3, %column] : i64, view<32x96xi64>
  view.store %signed_31, %results[4, %column] : i64, view<32x96xi64>
  view.store %logical_32, %results[5, %column] : i64, view<32x96xi64>
  view.store %signed_32, %results[6, %column] : i64, view<32x96xi64>
  view.store %logical_63, %results[7, %column] : i64, view<32x96xi64>
  view.store %signed_63, %results[8, %column] : i64, view<32x96xi64>
  %low_left = scalar.shli %value, %low_count : i64
  %low_logical = scalar.shrui %value, %low_count : i64
  %low_signed = scalar.shrsi %value, %low_count : i64
  view.store %low_left, %results[9, %column] : i64, view<32x96xi64>
  view.store %low_logical, %results[10, %column] : i64, view<32x96xi64>
  view.store %low_signed, %results[11, %column] : i64, view<32x96xi64>
  %high_left = scalar.shli %value, %high_count : i64
  %high_logical = scalar.shrui %value, %high_count : i64
  %high_signed = scalar.shrsi %value, %high_count : i64
  view.store %high_left, %results[12, %column] : i64, view<32x96xi64>
  view.store %high_logical, %results[13, %column] : i64, view<32x96xi64>
  view.store %high_signed, %results[14, %column] : i64, view<32x96xi64>
  %nonzero_left = scalar.shli %value, %nonzero_count : i64
  %nonzero_logical = scalar.shrui %value, %nonzero_count : i64
  %nonzero_signed = scalar.shrsi %value, %nonzero_count : i64
  view.store %nonzero_left, %results[15, %column] : i64, view<32x96xi64>
  view.store %nonzero_logical, %results[16, %column] : i64, view<32x96xi64>
  view.store %nonzero_signed, %results[17, %column] : i64, view<32x96xi64>
  %crossing_left = scalar.shli %value, %crossing_count : i64
  %crossing_logical = scalar.shrui %value, %crossing_count : i64
  %crossing_signed = scalar.shrsi %value, %crossing_count : i64
  view.store %crossing_left, %results[18, %column] : i64, view<32x96xi64>
  view.store %crossing_logical, %results[19, %column] : i64, view<32x96xi64>
  view.store %crossing_signed, %results[20, %column] : i64, view<32x96xi64>
  %other_logical = scalar.shrui %value, %other_count : i64
  %restored_sign = scalar.shrsi %left, %count : i64
  %directions = scalar.xori %other_logical, %restored_sign : i64
  %with_count = scalar.addi %directions, %count : i64
  %with_other_count = scalar.addi %with_count, %other_count : i64
  %reused = scalar.xori %with_other_count, %value : i64
  view.store %reused, %results[21, %column] : i64, view<32x96xi64>
  %self_count = scalar.andi %value, %last_high : i64
  %self_shift = scalar.shli %self_count, %self_count : i64
  view.store %self_shift, %results[22, %column] : i64, view<32x96xi64>
  %shifted_low = scalar.shli %value, %c6 : i64
  %low_word = scalar.trunci %shifted_low : i64 to i32
  %low_bits = scalar.extui %low_word : i32 to i64
  view.store %low_bits, %results[23, %column] : i64, view<32x96xi64>
  %word = scalar.trunci %value : i64 to i32
  %word_count = scalar.trunci %low_count : i64 to i32
  %word_one = scalar.trunci %c1 : i64 to i32
  %word_middle = scalar.trunci %c16 : i64 to i32
  %word_last = scalar.trunci %last_low : i64 to i32
  %word_logical_one = scalar.shrui %word, %word_one : i32
  %word_signed_one = scalar.shrsi %word, %word_one : i32
  %word_logical_middle = scalar.shrui %word, %word_middle : i32
  %word_signed_middle = scalar.shrsi %word, %word_middle : i32
  %word_logical_last = scalar.shrui %word, %word_last : i32
  %word_signed_last = scalar.shrsi %word, %word_last : i32
  %word_logical = scalar.shrui %word, %word_count : i32
  %word_left = scalar.shli %word, %word_count : i32
  %word_signed = scalar.shrsi %word, %word_count : i32
  %word_directions = scalar.xori %word_left, %word_logical : i32
  %word_combined = scalar.xori %word_directions, %word_signed : i32
  %word_with_count = scalar.addi %word_combined, %word_count : i32
  %word_reused = scalar.xori %word_with_count, %word : i32
  %logical_one_bits = scalar.extui %word_logical_one : i32 to i64
  %signed_one_bits = scalar.extui %word_signed_one : i32 to i64
  %logical_middle_bits = scalar.extui %word_logical_middle : i32 to i64
  %signed_middle_bits = scalar.extui %word_signed_middle : i32 to i64
  %logical_last_bits = scalar.extui %word_logical_last : i32 to i64
  %signed_last_bits = scalar.extui %word_signed_last : i32 to i64
  %logical_bits = scalar.extui %word_logical : i32 to i64
  %reused_bits = scalar.extui %word_reused : i32 to i64
  view.store %logical_one_bits, %results[24, %column] : i64, view<32x96xi64>
  view.store %signed_one_bits, %results[25, %column] : i64, view<32x96xi64>
  view.store %logical_middle_bits, %results[26, %column] : i64, view<32x96xi64>
  view.store %signed_middle_bits, %results[27, %column] : i64, view<32x96xi64>
  view.store %logical_last_bits, %results[28, %column] : i64, view<32x96xi64>
  view.store %signed_last_bits, %results[29, %column] : i64, view<32x96xi64>
  view.store %logical_bits, %results[30, %column] : i64, view<32x96xi64>
  view.store %reused_bits, %results[31, %column] : i64, view<32x96xi64>
  func.return
}

kernel.def @integer_shift_directions() {
  %unit = index.constant 1 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%uniform_value: i64, %uniform_count_input: index, %input: buffer, %counts: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %width = index.constant 32 : index
  %varying_offset = index.constant 64 : index
  %uniform_count = index.cast %uniform_count_input : index to i64
  %inputs = buffer.view %input[%base] : buffer -> view<32xi64>
  %shifts = buffer.view %counts[%base] : buffer -> view<32xi64>
  %value = view.load %inputs[%lane] : view<32xi64> -> i64
  %count = view.load %shifts[%lane] : view<32xi64> -> i64
  %mixed_column = index.add %lane, %width : index
  %varying_column = index.add %lane, %varying_offset : index
  func.call @wide_shift_observations(%uniform_value, %uniform_count, %count, %output, %lane) : (i64, i64, i64, buffer, index)
  func.call @wide_shift_observations(%value, %uniform_count, %count, %output, %mixed_column) : (i64, i64, i64, buffer, index)
  func.call @wide_shift_observations(%value, %count, %uniform_count, %output, %varying_column) : (i64, i64, i64, buffer, index)
  kernel.return
}

// The selected oracle executes the same math as ordinary scalar code, with no
// workitem context. The target and oracle independently generate their inputs.
func.def @integer_shift_directions_oracle(%uniform_value: i64, %uniform_count_input: index, %input: buffer, %counts: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 32 : index
  %varying_offset = index.constant 64 : index
  %step = index.constant 1 : index
  %uniform_count = index.cast %uniform_count_input : index to i64
  %inputs = buffer.view %input[%base] : buffer -> view<32xi64>
  %shifts = buffer.view %counts[%base] : buffer -> view<32xi64>
  scf.for %lane = [%begin to %end step %step] {
    %value = view.load %inputs[%lane] : view<32xi64> -> i64
    %count = view.load %shifts[%lane] : view<32xi64> -> i64
    %mixed_column = index.add %lane, %end : index
    %varying_column = index.add %lane, %varying_offset : index
    func.call @wide_shift_observations(%uniform_value, %uniform_count, %count, %output, %lane) : (i64, i64, i64, buffer, index)
    func.call @wide_shift_observations(%value, %uniform_count, %count, %output, %mixed_column) : (i64, i64, i64, buffer, index)
    func.call @wide_shift_observations(%value, %count, %uniform_count, %output, %varying_column) : (i64, i64, i64, buffer, index)
  }
  func.return
}

check.scenario @integer_shift_directions_values {
  check.trial[64](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-9223372036854775808 to 9223372036854775807) : tensor<32xi64>
    %unchanged_input = check.generate.random.uniform seed(%seed) range(-9223372036854775808 to 9223372036854775807) : tensor<32xi64>
    %counts = check.generate.iota offset(0) step(2) : tensor<32xi64>
    %unchanged_counts = check.generate.iota offset(0) step(2) : tensor<32xi64>
    %output = check.generate.fill value(-7777) : tensor<3104xi64>
    %prefix = check.tensor.view %output offset(0) : tensor<3104xi64> -> tensor<16xi64>
    %suffix = check.tensor.view %output offset(24704) : tensor<3104xi64> -> tensor<16xi64>
    %guard = check.generate.fill value(-7777) : tensor<16xi64>
    check.compare<@integer_shift_directions, @integer_shift_directions_oracle>(%seed, %trial, %input, %counts, %output) : (i64, index, tensor<32xi64>, tensor<32xi64>, tensor<3104xi64>) -> () {
      check.expect.bitwise actual(%input) expected(%unchanged_input) : tensor<32xi64>
      check.expect.bitwise actual(%counts) expected(%unchanged_counts) : tensor<32xi64>
      check.expect.bitwise actual(%output) expected(%output) : tensor<3104xi64>
      check.expect.bitwise actual(%prefix) expected(%guard) : tensor<16xi64>
      check.expect.bitwise actual(%suffix) expected(%guard) : tensor<16xi64>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %value = check.literal value(-9223372036854775808) : i64
    %count = check.literal value(63) : index
    %input = check.generate.fill value(-9223372036854775808) : tensor<32xi64>
    %unchanged_input = check.generate.fill value(-9223372036854775808) : tensor<32xi64>
    %counts = check.generate.iota offset(1) step(2) : tensor<32xi64>
    %unchanged_counts = check.generate.iota offset(1) step(2) : tensor<32xi64>
    %output = check.generate.fill value(-7777) : tensor<3104xi64>
    %prefix = check.tensor.view %output offset(0) : tensor<3104xi64> -> tensor<16xi64>
    %suffix = check.tensor.view %output offset(24704) : tensor<3104xi64> -> tensor<16xi64>
    %guard = check.generate.fill value(-7777) : tensor<16xi64>
    check.compare<@integer_shift_directions, @integer_shift_directions_oracle>(%value, %count, %input, %counts, %output) : (i64, index, tensor<32xi64>, tensor<32xi64>, tensor<3104xi64>) -> () {
      check.expect.bitwise actual(%input) expected(%unchanged_input) : tensor<32xi64>
      check.expect.bitwise actual(%counts) expected(%unchanged_counts) : tensor<32xi64>
      check.expect.bitwise actual(%output) expected(%output) : tensor<3104xi64>
      check.expect.bitwise actual(%prefix) expected(%guard) : tensor<16xi64>
      check.expect.bitwise actual(%suffix) expected(%guard) : tensor<16xi64>
    }
  }
  check.return
}
