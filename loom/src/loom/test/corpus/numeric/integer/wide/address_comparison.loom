// Runtime index operands can have different physical carrier widths. Every
// predicate observes the numeric value, including the sign of a narrow input.
func.def inline @record_index_comparisons(%lhs: index, %rhs: index, %output: buffer, %row_input: index) {
  %base = index.constant 0 : offset
  %row = index.assume %row_input [range(%row_input, 0, 7)] : index
  %results = buffer.view %output[%base] : buffer -> view<8x10xi32>
  %eq = index.cmp eq, %lhs, %rhs : index
  %ne = index.cmp ne, %lhs, %rhs : index
  %slt = index.cmp slt, %lhs, %rhs : index
  %sle = index.cmp sle, %lhs, %rhs : index
  %sgt = index.cmp sgt, %lhs, %rhs : index
  %sge = index.cmp sge, %lhs, %rhs : index
  %ult = index.cmp ult, %lhs, %rhs : index
  %ule = index.cmp ule, %lhs, %rhs : index
  %ugt = index.cmp ugt, %lhs, %rhs : index
  %uge = index.cmp uge, %lhs, %rhs : index
  %eq_word = scalar.extui %eq : i1 to i32
  %ne_word = scalar.extui %ne : i1 to i32
  %slt_word = scalar.extui %slt : i1 to i32
  %sle_word = scalar.extui %sle : i1 to i32
  %sgt_word = scalar.extui %sgt : i1 to i32
  %sge_word = scalar.extui %sge : i1 to i32
  %ult_word = scalar.extui %ult : i1 to i32
  %ule_word = scalar.extui %ule : i1 to i32
  %ugt_word = scalar.extui %ugt : i1 to i32
  %uge_word = scalar.extui %uge : i1 to i32
  view.store %eq_word, %results[%row, 0] : i32, view<8x10xi32>
  view.store %ne_word, %results[%row, 1] : i32, view<8x10xi32>
  view.store %slt_word, %results[%row, 2] : i32, view<8x10xi32>
  view.store %sle_word, %results[%row, 3] : i32, view<8x10xi32>
  view.store %sgt_word, %results[%row, 4] : i32, view<8x10xi32>
  view.store %sge_word, %results[%row, 5] : i32, view<8x10xi32>
  view.store %ult_word, %results[%row, 6] : i32, view<8x10xi32>
  view.store %ule_word, %results[%row, 7] : i32, view<8x10xi32>
  view.store %ugt_word, %results[%row, 8] : i32, view<8x10xi32>
  view.store %uge_word, %results[%row, 9] : i32, view<8x10xi32>
  func.return
}

// The oracle uses fixed i64 values and comparisons, independently of index
// carrier selection and mixed-width address comparison lowering.
func.def inline @record_scalar_comparisons(%lhs: i64, %rhs: i64, %output: buffer, %row_input: index) {
  %base = index.constant 0 : offset
  %row = index.assume %row_input [range(%row_input, 0, 7)] : index
  %results = buffer.view %output[%base] : buffer -> view<8x10xi32>
  %eq = scalar.cmpi eq, %lhs, %rhs : i64
  %ne = scalar.cmpi ne, %lhs, %rhs : i64
  %slt = scalar.cmpi slt, %lhs, %rhs : i64
  %sle = scalar.cmpi sle, %lhs, %rhs : i64
  %sgt = scalar.cmpi sgt, %lhs, %rhs : i64
  %sge = scalar.cmpi sge, %lhs, %rhs : i64
  %ult = scalar.cmpi ult, %lhs, %rhs : i64
  %ule = scalar.cmpi ule, %lhs, %rhs : i64
  %ugt = scalar.cmpi ugt, %lhs, %rhs : i64
  %uge = scalar.cmpi uge, %lhs, %rhs : i64
  %eq_word = scalar.extui %eq : i1 to i32
  %ne_word = scalar.extui %ne : i1 to i32
  %slt_word = scalar.extui %slt : i1 to i32
  %sle_word = scalar.extui %sle : i1 to i32
  %sgt_word = scalar.extui %sgt : i1 to i32
  %sge_word = scalar.extui %sge : i1 to i32
  %ult_word = scalar.extui %ult : i1 to i32
  %ule_word = scalar.extui %ule : i1 to i32
  %ugt_word = scalar.extui %ugt : i1 to i32
  %uge_word = scalar.extui %uge : i1 to i32
  view.store %eq_word, %results[%row, 0] : i32, view<8x10xi32>
  view.store %ne_word, %results[%row, 1] : i32, view<8x10xi32>
  view.store %slt_word, %results[%row, 2] : i32, view<8x10xi32>
  view.store %sle_word, %results[%row, 3] : i32, view<8x10xi32>
  view.store %sgt_word, %results[%row, 4] : i32, view<8x10xi32>
  view.store %sge_word, %results[%row, 5] : i32, view<8x10xi32>
  view.store %ult_word, %results[%row, 6] : i32, view<8x10xi32>
  view.store %ule_word, %results[%row, 7] : i32, view<8x10xi32>
  view.store %ugt_word, %results[%row, 8] : i32, view<8x10xi32>
  view.store %uge_word, %results[%row, 9] : i32, view<8x10xi32>
  func.return
}

func.def inline @record_offset_comparisons(%lhs: offset, %rhs: offset, %output: buffer, %row_input: index) {
  %base = index.constant 0 : offset
  %row = index.assume %row_input [range(%row_input, 0, 7)] : index
  %results = buffer.view %output[%base] : buffer -> view<8x10xi32>
  %eq = index.cmp eq, %lhs, %rhs : offset
  %ne = index.cmp ne, %lhs, %rhs : offset
  %slt = index.cmp slt, %lhs, %rhs : offset
  %sle = index.cmp sle, %lhs, %rhs : offset
  %sgt = index.cmp sgt, %lhs, %rhs : offset
  %sge = index.cmp sge, %lhs, %rhs : offset
  %ult = index.cmp ult, %lhs, %rhs : offset
  %ule = index.cmp ule, %lhs, %rhs : offset
  %ugt = index.cmp ugt, %lhs, %rhs : offset
  %uge = index.cmp uge, %lhs, %rhs : offset
  %eq_word = scalar.extui %eq : i1 to i32
  %ne_word = scalar.extui %ne : i1 to i32
  %slt_word = scalar.extui %slt : i1 to i32
  %sle_word = scalar.extui %sle : i1 to i32
  %sgt_word = scalar.extui %sgt : i1 to i32
  %sge_word = scalar.extui %sge : i1 to i32
  %ult_word = scalar.extui %ult : i1 to i32
  %ule_word = scalar.extui %ule : i1 to i32
  %ugt_word = scalar.extui %ugt : i1 to i32
  %uge_word = scalar.extui %uge : i1 to i32
  view.store %eq_word, %results[%row, 0] : i32, view<8x10xi32>
  view.store %ne_word, %results[%row, 1] : i32, view<8x10xi32>
  view.store %slt_word, %results[%row, 2] : i32, view<8x10xi32>
  view.store %sle_word, %results[%row, 3] : i32, view<8x10xi32>
  view.store %sgt_word, %results[%row, 4] : i32, view<8x10xi32>
  view.store %sge_word, %results[%row, 5] : i32, view<8x10xi32>
  view.store %ult_word, %results[%row, 6] : i32, view<8x10xi32>
  view.store %ule_word, %results[%row, 7] : i32, view<8x10xi32>
  view.store %ugt_word, %results[%row, 8] : i32, view<8x10xi32>
  view.store %uge_word, %results[%row, 9] : i32, view<8x10xi32>
  func.return
}

kernel.def @mixed_width_index_comparisons() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%uniform: i32, %wide_input: i64, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %inputs = buffer.view %input[%base] : buffer -> view<1xi32>
  %varying = view.load %inputs[0] : view<1xi32> -> i32
  %bounded = scalar.assume %wide_input [range(%wide_input, 0, 8589934591)] : i64
  %wide = index.cast %bounded : i64 to index
  %uniform_signed = index.cast %uniform : i32 to index
  %varying_signed = index.cast %varying : i32 to index
  %wide_offset = index.cast %bounded : i64 to offset
  %uniform_unsigned = index.cast %uniform : i32 to offset
  %varying_unsigned = index.cast %varying : i32 to offset
  %r0 = index.constant 0 : index
  %r1 = index.constant 1 : index
  %r2 = index.constant 2 : index
  %r3 = index.constant 3 : index
  %r4 = index.constant 4 : index
  %r5 = index.constant 5 : index
  %r6 = index.constant 6 : index
  %r7 = index.constant 7 : index
  func.call @record_index_comparisons(%uniform_signed, %wide, %output, %r0) : (index, index, buffer, index)
  func.call @record_index_comparisons(%wide, %uniform_signed, %output, %r1) : (index, index, buffer, index)
  func.call @record_index_comparisons(%varying_signed, %wide, %output, %r2) : (index, index, buffer, index)
  func.call @record_index_comparisons(%wide, %varying_signed, %output, %r3) : (index, index, buffer, index)
  func.call @record_offset_comparisons(%uniform_unsigned, %wide_offset, %output, %r4) : (offset, offset, buffer, index)
  func.call @record_offset_comparisons(%wide_offset, %uniform_unsigned, %output, %r5) : (offset, offset, buffer, index)
  func.call @record_offset_comparisons(%varying_unsigned, %wide_offset, %output, %r6) : (offset, offset, buffer, index)
  func.call @record_offset_comparisons(%wide_offset, %varying_unsigned, %output, %r7) : (offset, offset, buffer, index)
  kernel.return
}

func.def @mixed_width_index_comparisons_oracle(%uniform: i32, %wide: i64, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %inputs = buffer.view %input[%base] : buffer -> view<1xi32>
  %varying = view.load %inputs[0] : view<1xi32> -> i32
  %uniform_signed = scalar.extsi %uniform : i32 to i64
  %varying_signed = scalar.extsi %varying : i32 to i64
  %uniform_unsigned = scalar.extui %uniform : i32 to i64
  %varying_unsigned = scalar.extui %varying : i32 to i64
  %r0 = index.constant 0 : index
  %r1 = index.constant 1 : index
  %r2 = index.constant 2 : index
  %r3 = index.constant 3 : index
  %r4 = index.constant 4 : index
  %r5 = index.constant 5 : index
  %r6 = index.constant 6 : index
  %r7 = index.constant 7 : index
  func.call @record_scalar_comparisons(%uniform_signed, %wide, %output, %r0) : (i64, i64, buffer, index)
  func.call @record_scalar_comparisons(%wide, %uniform_signed, %output, %r1) : (i64, i64, buffer, index)
  func.call @record_scalar_comparisons(%varying_signed, %wide, %output, %r2) : (i64, i64, buffer, index)
  func.call @record_scalar_comparisons(%wide, %varying_signed, %output, %r3) : (i64, i64, buffer, index)
  func.call @record_scalar_comparisons(%uniform_unsigned, %wide, %output, %r4) : (i64, i64, buffer, index)
  func.call @record_scalar_comparisons(%wide, %uniform_unsigned, %output, %r5) : (i64, i64, buffer, index)
  func.call @record_scalar_comparisons(%varying_unsigned, %wide, %output, %r6) : (i64, i64, buffer, index)
  func.call @record_scalar_comparisons(%wide, %varying_unsigned, %output, %r7) : (i64, i64, buffer, index)
  func.return
}

check.scenario @mixed_width_index_comparison_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %uniform = check.literal value(-2147483648) : i32
    %wide = check.literal value(0) : i64
    %input = check.generate.fill value(-1) : tensor<1xi32>
    %storage = check.generate.fill value(-7777) : tensor<88xi32>
    %output = check.tensor.view %storage offset(16) : tensor<88xi32> -> tensor<8x10xi32>
    check.compare<@mixed_width_index_comparisons, @mixed_width_index_comparisons_oracle>(%uniform, %wide, %input, %output) : (i32, i64, tensor<1xi32>, tensor<8x10xi32>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<88xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %uniform = check.literal value(-1) : i32
    %wide = check.literal value(4294967295) : i64
    %input = check.generate.fill value(-2147483648) : tensor<1xi32>
    %storage = check.generate.fill value(-7777) : tensor<88xi32>
    %output = check.tensor.view %storage offset(16) : tensor<88xi32> -> tensor<8x10xi32>
    check.compare<@mixed_width_index_comparisons, @mixed_width_index_comparisons_oracle>(%uniform, %wide, %input, %output) : (i32, i64, tensor<1xi32>, tensor<8x10xi32>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<88xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %uniform = check.literal value(0) : i32
    %wide = check.literal value(0) : i64
    %input = check.generate.fill value(1) : tensor<1xi32>
    %storage = check.generate.fill value(-7777) : tensor<88xi32>
    %output = check.tensor.view %storage offset(16) : tensor<88xi32> -> tensor<8x10xi32>
    check.compare<@mixed_width_index_comparisons, @mixed_width_index_comparisons_oracle>(%uniform, %wide, %input, %output) : (i32, i64, tensor<1xi32>, tensor<8x10xi32>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<88xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %uniform = check.literal value(2147483647) : i32
    %wide = check.literal value(2147483647) : i64
    %input = check.generate.fill value(2147483647) : tensor<1xi32>
    %storage = check.generate.fill value(-7777) : tensor<88xi32>
    %output = check.tensor.view %storage offset(16) : tensor<88xi32> -> tensor<8x10xi32>
    check.compare<@mixed_width_index_comparisons, @mixed_width_index_comparisons_oracle>(%uniform, %wide, %input, %output) : (i32, i64, tensor<1xi32>, tensor<8x10xi32>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<88xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %uniform = check.literal value(-1) : i32
    %wide = check.literal value(4294967296) : i64
    %input = check.generate.fill value(-1) : tensor<1xi32>
    %storage = check.generate.fill value(-7777) : tensor<88xi32>
    %output = check.tensor.view %storage offset(16) : tensor<88xi32> -> tensor<8x10xi32>
    check.compare<@mixed_width_index_comparisons, @mixed_width_index_comparisons_oracle>(%uniform, %wide, %input, %output) : (i32, i64, tensor<1xi32>, tensor<8x10xi32>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<88xi32>
    }
  }
  check.trial[64](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %uniform = check.literal value(-1) : i32
    %wide = check.literal value(4294967296) : i64
    %input = check.generate.random.uniform seed(%seed) range(-2147483648 to 2147483647) : tensor<1xi32>
    %storage = check.generate.fill value(-7777) : tensor<88xi32>
    %output = check.tensor.view %storage offset(16) : tensor<88xi32> -> tensor<8x10xi32>
    check.compare<@mixed_width_index_comparisons, @mixed_width_index_comparisons_oracle>(%uniform, %wide, %input, %output) : (i32, i64, tensor<1xi32>, tensor<8x10xi32>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<88xi32>
    }
  }
  check.return
}

// Narrow physical offsets retain their positive magnitude across bit 31.
kernel.def @compact_offset_comparisons() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%lhs_input: i32, %rhs_input: i32, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %inputs = buffer.view %input[%base] : buffer -> view<1xi32>
  %varying_input = view.load %inputs[0] : view<1xi32> -> i32
  %lhs = index.cast %lhs_input : i32 to offset
  %rhs = index.cast %rhs_input : i32 to offset
  %varying = index.cast %varying_input : i32 to offset
  %r0 = index.constant 0 : index
  %r1 = index.constant 1 : index
  %r2 = index.constant 2 : index
  %r3 = index.constant 3 : index
  func.call @record_offset_comparisons(%lhs, %rhs, %output, %r0) : (offset, offset, buffer, index)
  func.call @record_offset_comparisons(%rhs, %lhs, %output, %r1) : (offset, offset, buffer, index)
  func.call @record_offset_comparisons(%lhs, %varying, %output, %r2) : (offset, offset, buffer, index)
  func.call @record_offset_comparisons(%varying, %rhs, %output, %r3) : (offset, offset, buffer, index)
  kernel.return
}

func.def @compact_offset_comparisons_oracle(%lhs_input: i32, %rhs_input: i32, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %inputs = buffer.view %input[%base] : buffer -> view<1xi32>
  %varying_input = view.load %inputs[0] : view<1xi32> -> i32
  %lhs = scalar.extui %lhs_input : i32 to i64
  %rhs = scalar.extui %rhs_input : i32 to i64
  %varying = scalar.extui %varying_input : i32 to i64
  %r0 = index.constant 0 : index
  %r1 = index.constant 1 : index
  %r2 = index.constant 2 : index
  %r3 = index.constant 3 : index
  func.call @record_scalar_comparisons(%lhs, %rhs, %output, %r0) : (i64, i64, buffer, index)
  func.call @record_scalar_comparisons(%rhs, %lhs, %output, %r1) : (i64, i64, buffer, index)
  func.call @record_scalar_comparisons(%lhs, %varying, %output, %r2) : (i64, i64, buffer, index)
  func.call @record_scalar_comparisons(%varying, %rhs, %output, %r3) : (i64, i64, buffer, index)
  func.return
}

// Positive index magnitudes above INT32_MAX cannot alias negative coordinates.
kernel.def @positive_word_index_comparisons() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%lhs_input: i64, %rhs_input: i32, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %inputs = buffer.view %input[%base] : buffer -> view<1xi32>
  %varying_input = view.load %inputs[0] : view<1xi32> -> i32
  %positive = scalar.assume %lhs_input [range(%lhs_input, 0, 8589934591)] : i64
  %wide = index.cast %positive : i64 to index
  %lhs = index.assume %wide [range(%wide, 0, 4294967295)] : index
  %rhs = index.cast %rhs_input : i32 to index
  %varying = index.cast %varying_input : i32 to index
  %r0 = index.constant 0 : index
  %r1 = index.constant 1 : index
  %r2 = index.constant 2 : index
  %r3 = index.constant 3 : index
  func.call @record_index_comparisons(%lhs, %rhs, %output, %r0) : (index, index, buffer, index)
  func.call @record_index_comparisons(%rhs, %lhs, %output, %r1) : (index, index, buffer, index)
  func.call @record_index_comparisons(%lhs, %varying, %output, %r2) : (index, index, buffer, index)
  func.call @record_index_comparisons(%varying, %rhs, %output, %r3) : (index, index, buffer, index)
  %clear = scalar.constant 0 : i32
  %choose = scalar.cmpi sge, %rhs_input, %clear : i32
  %merged = scf.select %choose, %lhs, %rhs : index
  %varying_choose = scalar.cmpi slt, %varying_input, %clear : i32
  %varying_merged = scf.select %varying_choose, %varying, %lhs : index
  %r4 = index.constant 4 : index
  %r5 = index.constant 5 : index
  %r6 = index.constant 6 : index
  %r7 = index.constant 7 : index
  func.call @record_index_comparisons(%merged, %rhs, %output, %r4) : (index, index, buffer, index)
  func.call @record_index_comparisons(%rhs, %merged, %output, %r5) : (index, index, buffer, index)
  func.call @record_index_comparisons(%varying_merged, %rhs, %output, %r6) : (index, index, buffer, index)
  func.call @record_index_comparisons(%rhs, %varying_merged, %output, %r7) : (index, index, buffer, index)
  kernel.return
}

func.def @positive_word_index_comparisons_oracle(%lhs_input: i64, %rhs_input: i32, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %inputs = buffer.view %input[%base] : buffer -> view<1xi32>
  %varying_input = view.load %inputs[0] : view<1xi32> -> i32
  %lhs = scalar.assume %lhs_input [range(%lhs_input, 0, 4294967295)] : i64
  %rhs = scalar.extsi %rhs_input : i32 to i64
  %varying = scalar.extsi %varying_input : i32 to i64
  %r0 = index.constant 0 : index
  %r1 = index.constant 1 : index
  %r2 = index.constant 2 : index
  %r3 = index.constant 3 : index
  func.call @record_scalar_comparisons(%lhs, %rhs, %output, %r0) : (i64, i64, buffer, index)
  func.call @record_scalar_comparisons(%rhs, %lhs, %output, %r1) : (i64, i64, buffer, index)
  func.call @record_scalar_comparisons(%lhs, %varying, %output, %r2) : (i64, i64, buffer, index)
  func.call @record_scalar_comparisons(%varying, %rhs, %output, %r3) : (i64, i64, buffer, index)
  %clear = scalar.constant 0 : i32
  %choose = scalar.cmpi sge, %rhs_input, %clear : i32
  %merged = scf.select %choose, %lhs, %rhs : i64
  %varying_choose = scalar.cmpi slt, %varying_input, %clear : i32
  %varying_merged = scf.select %varying_choose, %varying, %lhs : i64
  %r4 = index.constant 4 : index
  %r5 = index.constant 5 : index
  %r6 = index.constant 6 : index
  %r7 = index.constant 7 : index
  func.call @record_scalar_comparisons(%merged, %rhs, %output, %r4) : (i64, i64, buffer, index)
  func.call @record_scalar_comparisons(%rhs, %merged, %output, %r5) : (i64, i64, buffer, index)
  func.call @record_scalar_comparisons(%varying_merged, %rhs, %output, %r6) : (i64, i64, buffer, index)
  func.call @record_scalar_comparisons(%rhs, %varying_merged, %output, %r7) : (i64, i64, buffer, index)
  func.return
}

check.scenario @compact_offset_comparison_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %lhs = check.literal value(-2147483648) : i32
    %rhs = check.literal value(0) : i32
    %input = check.generate.fill value(-1) : tensor<1xi32>
    %storage = check.generate.fill value(-7777) : tensor<88xi32>
    %output = check.tensor.view %storage offset(16) : tensor<88xi32> -> tensor<8x10xi32>
    check.compare<@compact_offset_comparisons, @compact_offset_comparisons_oracle>(%lhs, %rhs, %input, %output) : (i32, i32, tensor<1xi32>, tensor<8x10xi32>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<88xi32>
    }
  }
  check.trial[32](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %lhs = check.literal value(-1) : i32
    %rhs = check.literal value(2147483647) : i32
    %input = check.generate.random.uniform seed(%seed) range(-2147483648 to 2147483647) : tensor<1xi32>
    %storage = check.generate.fill value(-7777) : tensor<88xi32>
    %output = check.tensor.view %storage offset(16) : tensor<88xi32> -> tensor<8x10xi32>
    check.compare<@compact_offset_comparisons, @compact_offset_comparisons_oracle>(%lhs, %rhs, %input, %output) : (i32, i32, tensor<1xi32>, tensor<8x10xi32>) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<88xi32>
    }
  }
  check.return
}

