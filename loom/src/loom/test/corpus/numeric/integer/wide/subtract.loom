// Uniform subtraction retains scalar pairs, while loaded values exercise both
// mixed operand orders and varying subtraction. Results use modulo-2^64 integer
// arithmetic, including negation of the minimum signed value.
kernel.def @integer_wide_subtract() {
  %unit = index.constant 1 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%lhs: i64, %rhs: i64, %rounds: i32, %input: buffer, %other: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %output_base = index.constant 128 : offset
  %aligned_input = buffer.assume.alignment %input {minimum_alignment = 8} : buffer
  %aligned_other = buffer.assume.alignment %other {minimum_alignment = 8} : buffer
  %aligned_output = buffer.assume.alignment %output {minimum_alignment = 8} : buffer
  %inputs = buffer.view %aligned_input[%base] : buffer -> view<32xi64>
  %others = buffer.view %aligned_other[%base] : buffer -> view<32xi64>
  %outputs = buffer.view %aligned_output[%output_base] : buffer -> view<10x32xi64>
  %value = view.load %inputs[%lane] : view<32xi64> -> i64
  %other_value = view.load %others[%lane] : view<32xi64> -> i64
  %c0 = scalar.constant 0 : i64
  %wide = scalar.constant 4294967297 : i64
  %difference = scalar.subi %lhs, %rhs : i64
  %negated = scalar.subi %c0, %lhs : i64
  %constant_right = scalar.subi %lhs, %wide : i64
  %constant_left = scalar.subi %wide, %lhs : i64
  %reverse = scalar.subi %rhs, %lhs : i64
  %chain = scalar.subi %difference, %reverse : i64
  %uniform_right = scalar.subi %value, %lhs : i64
  %uniform_left = scalar.subi %lhs, %value : i64
  %varying = scalar.subi %value, %other_value : i64
  %step = index.constant 1 : offset
  %end = index.cast %rounds : i32 to offset
  %repeated = scf.for %iteration = [%base to %end step %step](%previous = %lhs : i64) -> (i64) {
    %next = scalar.subi %previous, %rhs : i64
    scf.yield %next : i64
  }
  %equal = scalar.cmpi eq, %lhs, %rhs : i64
  %selected = scf.select %equal, %negated, %chain : i64
  view.store %difference, %outputs[0, %lane] : i64, view<10x32xi64>
  view.store %negated, %outputs[1, %lane] : i64, view<10x32xi64>
  view.store %constant_right, %outputs[2, %lane] : i64, view<10x32xi64>
  view.store %constant_left, %outputs[3, %lane] : i64, view<10x32xi64>
  view.store %chain, %outputs[4, %lane] : i64, view<10x32xi64>
  view.store %uniform_right, %outputs[5, %lane] : i64, view<10x32xi64>
  view.store %uniform_left, %outputs[6, %lane] : i64, view<10x32xi64>
  view.store %varying, %outputs[7, %lane] : i64, view<10x32xi64>
  view.store %repeated, %outputs[8, %lane] : i64, view<10x32xi64>
  view.store %selected, %outputs[9, %lane] : i64, view<10x32xi64>
  kernel.return
}

// The scalar VM oracle evaluates the same operations without workitem state or
// vectorized stores. This keeps the expected path independent of kernel launch
// and lane lowering.
func.def @integer_wide_subtract_oracle(%lhs: i64, %rhs: i64, %rounds: i32, %input: buffer, %other: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %output_base = index.constant 128 : offset
  %inputs = buffer.view %input[%base] : buffer -> view<32xi64>
  %others = buffer.view %other[%base] : buffer -> view<32xi64>
  %outputs = buffer.view %output[%output_base] : buffer -> view<10x32xi64>
  %c0 = scalar.constant 0 : i64
  %wide = scalar.constant 4294967297 : i64
  %difference = scalar.subi %lhs, %rhs : i64
  %negated = scalar.subi %c0, %lhs : i64
  %constant_right = scalar.subi %lhs, %wide : i64
  %constant_left = scalar.subi %wide, %lhs : i64
  %reverse = scalar.subi %rhs, %lhs : i64
  %chain = scalar.subi %difference, %reverse : i64
  %step_offset = index.constant 1 : offset
  %end_offset = index.cast %rounds : i32 to offset
  %repeated = scf.for %iteration = [%base to %end_offset step %step_offset](%previous = %lhs : i64) -> (i64) {
    %next = scalar.subi %previous, %rhs : i64
    scf.yield %next : i64
  }
  %equal = scalar.cmpi eq, %lhs, %rhs : i64
  %selected = scf.select %equal, %negated, %chain : i64
  %begin = index.constant 0 : index
  %end = index.constant 32 : index
  %step = index.constant 1 : index
  scf.for %lane = [%begin to %end step %step] {
    %value = view.load %inputs[%lane] : view<32xi64> -> i64
    %other_value = view.load %others[%lane] : view<32xi64> -> i64
    %uniform_right = scalar.subi %value, %lhs : i64
    %uniform_left = scalar.subi %lhs, %value : i64
    %varying = scalar.subi %value, %other_value : i64
    view.store %difference, %outputs[0, %lane] : i64, view<10x32xi64>
    view.store %negated, %outputs[1, %lane] : i64, view<10x32xi64>
    view.store %constant_right, %outputs[2, %lane] : i64, view<10x32xi64>
    view.store %constant_left, %outputs[3, %lane] : i64, view<10x32xi64>
    view.store %chain, %outputs[4, %lane] : i64, view<10x32xi64>
    view.store %uniform_right, %outputs[5, %lane] : i64, view<10x32xi64>
    view.store %uniform_left, %outputs[6, %lane] : i64, view<10x32xi64>
    view.store %varying, %outputs[7, %lane] : i64, view<10x32xi64>
    view.store %repeated, %outputs[8, %lane] : i64, view<10x32xi64>
    view.store %selected, %outputs[9, %lane] : i64, view<10x32xi64>
  }
  func.return
}

check.scenario @integer_wide_subtract_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %lhs = check.literal value(0) : i64
    %rhs = check.literal value(0) : i64
    %rounds = check.literal value(0) : i32
    %input = check.generate.iota offset(0) step(1) : tensor<32xi64>
    %other = check.generate.iota offset(0) step(2) : tensor<32xi64>
    %storage = check.generate.fill value(-7777) : tensor<352xi64>
    check.compare<@integer_wide_subtract, @integer_wide_subtract_oracle>(%lhs, %rhs, %rounds, %input, %other, %storage) : (i64, i64, i32, tensor<32xi64>, tensor<32xi64>, tensor<352xi64>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<32xi64>
      check.expect.bitwise actual(%other) expected(%other) : tensor<32xi64>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<352xi64>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %lhs = check.literal value(4294967296) : i64
    %rhs = check.literal value(1) : i64
    %rounds = check.literal value(3) : i32
    %input = check.generate.iota offset(4294967280) step(1) : tensor<32xi64>
    %other = check.generate.iota offset(-16) step(2) : tensor<32xi64>
    %storage = check.generate.fill value(-7777) : tensor<352xi64>
    check.compare<@integer_wide_subtract, @integer_wide_subtract_oracle>(%lhs, %rhs, %rounds, %input, %other, %storage) : (i64, i64, i32, tensor<32xi64>, tensor<32xi64>, tensor<352xi64>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<32xi64>
      check.expect.bitwise actual(%other) expected(%other) : tensor<32xi64>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<352xi64>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %lhs = check.literal value(-9223372036854775808) : i64
    %rhs = check.literal value(1) : i64
    %rounds = check.literal value(3) : i32
    %input = check.generate.iota offset(-9223372036854775808) step(1) : tensor<32xi64>
    %other = check.generate.iota offset(4294967296) step(2) : tensor<32xi64>
    %storage = check.generate.fill value(-7777) : tensor<352xi64>
    check.compare<@integer_wide_subtract, @integer_wide_subtract_oracle>(%lhs, %rhs, %rounds, %input, %other, %storage) : (i64, i64, i32, tensor<32xi64>, tensor<32xi64>, tensor<352xi64>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<32xi64>
      check.expect.bitwise actual(%other) expected(%other) : tensor<32xi64>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<352xi64>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %lhs = check.literal value(9223372036854775807) : i64
    %rhs = check.literal value(-1) : i64
    %rounds = check.literal value(4) : i32
    %input = check.generate.iota offset(9223372036854775776) step(1) : tensor<32xi64>
    %other = check.generate.iota offset(-4294967296) step(-2) : tensor<32xi64>
    %storage = check.generate.fill value(-7777) : tensor<352xi64>
    check.compare<@integer_wide_subtract, @integer_wide_subtract_oracle>(%lhs, %rhs, %rounds, %input, %other, %storage) : (i64, i64, i32, tensor<32xi64>, tensor<32xi64>, tensor<352xi64>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<32xi64>
      check.expect.bitwise actual(%other) expected(%other) : tensor<32xi64>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<352xi64>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %lhs = check.literal value(-9223372036854775808) : i64
    %rhs = check.literal value(-9223372036854775808) : i64
    %rounds = check.literal value(2) : i32
    %input = check.generate.iota offset(4294967296) step(4294967297) : tensor<32xi64>
    %other = check.generate.iota offset(-4294967296) step(-4294967297) : tensor<32xi64>
    %storage = check.generate.fill value(-7777) : tensor<352xi64>
    check.compare<@integer_wide_subtract, @integer_wide_subtract_oracle>(%lhs, %rhs, %rounds, %input, %other, %storage) : (i64, i64, i32, tensor<32xi64>, tensor<32xi64>, tensor<352xi64>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<32xi64>
      check.expect.bitwise actual(%other) expected(%other) : tensor<32xi64>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<352xi64>
    }
  }
  check.trial[64](%trial: index, %entropy: check.entropy) {
    %lhs_entropy = check.entropy.fork %entropy name("lhs") : check.entropy
    %rhs_entropy = check.entropy.fork %entropy name("rhs") : check.entropy
    %input_entropy = check.entropy.fork %entropy name("input") : check.entropy
    %other_entropy = check.entropy.fork %entropy name("other") : check.entropy
    %lhs = check.entropy.read %lhs_entropy[%trial] : check.entropy -> i64
    %rhs = check.entropy.read %rhs_entropy[%trial] : check.entropy -> i64
    %input_seed = check.entropy.read %input_entropy[%trial] : check.entropy -> i64
    %other_seed = check.entropy.read %other_entropy[%trial] : check.entropy -> i64
    %rounds = check.literal value(7) : i32
    %input = check.generate.random.uniform seed(%input_seed) range(-9223372036854775808 to 9223372036854775807) : tensor<32xi64>
    %other = check.generate.random.uniform seed(%other_seed) range(-9223372036854775808 to 9223372036854775807) : tensor<32xi64>
    %storage = check.generate.fill value(-7777) : tensor<352xi64>
    check.compare<@integer_wide_subtract, @integer_wide_subtract_oracle>(%lhs, %rhs, %rounds, %input, %other, %storage) : (i64, i64, i32, tensor<32xi64>, tensor<32xi64>, tensor<352xi64>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<32xi64>
      check.expect.bitwise actual(%other) expected(%other) : tensor<32xi64>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<352xi64>
    }
  }
  check.return
}
