func.def @signed_unary_predicates(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %inputs = buffer.view %input[%base] : buffer -> view<19xi8>
  %outputs = buffer.view %output[%base] : buffer -> view<6x20xi8>
  %values = vector.load %inputs[0] : view<19xi8> -> vector<19xi8>
  %inactive = vector.splati 0 : vector<19xi8>
  %predicates = vector.cmpi ne, %values, %inactive : vector<19xi8> -> vector<19xi1>
  %negative = vector.negi %predicates : vector<19xi1>
  %absolute = vector.absi %predicates : vector<19xi1>
  %sign = vector.signi %predicates : vector<19xi1>
  %negative_bytes = vector.extui %negative : vector<19xi1> to vector<19xi8>
  %absolute_bytes = vector.extui %absolute : vector<19xi1> to vector<19xi8>
  %sign_bytes = vector.extui %sign : vector<19xi1> to vector<19xi8>
  vector.store %negative_bytes, %outputs[0, 0] : vector<19xi8>, view<6x20xi8>
  vector.store %absolute_bytes, %outputs[1, 0] : vector<19xi8>, view<6x20xi8>
  vector.store %sign_bytes, %outputs[2, 0] : vector<19xi8>, view<6x20xi8>
  %begin = index.constant 0 : index
  %end = index.constant 19 : index
  %step = index.constant 1 : index
  %scalar_inactive = scalar.constant 0 : i8
  scf.for %i = [%begin to %end step %step] {
    %value = view.load %inputs[%i] : view<19xi8> -> i8
    %predicate = scalar.cmpi ne, %value, %scalar_inactive : i8
    %scalar_negative = scalar.negi %predicate : i1
    %scalar_absolute = scalar.absi %predicate : i1
    %scalar_sign = scalar.signi %predicate : i1
    %negative_byte = scalar.extui %scalar_negative : i1 to i8
    %absolute_byte = scalar.extui %scalar_absolute : i1 to i8
    %sign_byte = scalar.extui %scalar_sign : i1 to i8
    view.store %negative_byte, %outputs[3, %i] : i8, view<6x20xi8>
    view.store %absolute_byte, %outputs[4, %i] : i8, view<6x20xi8>
    view.store %sign_byte, %outputs[5, %i] : i8, view<6x20xi8>
  }
  func.return
}

check.scenario @signed_unary_predicate_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-1) step(1) period(3) : tensor<19xi8>
    %output = check.generate.fill value(93) : tensor<6x20xi8>
    check.compare<@signed_unary_predicates>(%input, %output) : (tensor<19xi8>, tensor<6x20xi8>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<6x20xi8>
    }
  }
  check.return
}
