// Wrapping unary arithmetic at both signed boundaries and around zero. Vectors
// span full packets and an irregular tail; each output row retains a guard lane.
// The independent VM oracle evaluates the authored scalar and vector operations.

func.def @signed_unary_i8(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %inputs = buffer.view %input[%base] : buffer -> view<67xi8>
  %outputs = buffer.view %output[%base] : buffer -> view<6x68xi8>
  %values = vector.load %inputs[0] : view<67xi8> -> vector<67xi8>
  %negative = vector.negi %values : vector<67xi8>
  %absolute = vector.absi %values : vector<67xi8>
  %sign = vector.signi %values : vector<67xi8>
  vector.store %negative, %outputs[0, 0] : vector<67xi8>, view<6x68xi8>
  vector.store %absolute, %outputs[1, 0] : vector<67xi8>, view<6x68xi8>
  vector.store %sign, %outputs[2, 0] : vector<67xi8>, view<6x68xi8>
  %begin = index.constant 0 : index
  %end = index.constant 67 : index
  %step = index.constant 1 : index
  scf.for %i = [%begin to %end step %step] {
    %value = view.load %inputs[%i] : view<67xi8> -> i8
    %scalar_negative = scalar.negi %value : i8
    %scalar_absolute = scalar.absi %value : i8
    %scalar_sign = scalar.signi %value : i8
    view.store %scalar_negative, %outputs[3, %i] : i8, view<6x68xi8>
    view.store %scalar_absolute, %outputs[4, %i] : i8, view<6x68xi8>
    view.store %scalar_sign, %outputs[5, %i] : i8, view<6x68xi8>
  }
  func.return
}

check.scenario @signed_unary_i8_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-128) step(1) period(2) : tensor<67xi8>
    %output = check.generate.fill value(93) : tensor<6x68xi8>
    check.compare<@signed_unary_i8>(%input, %output) : (tensor<67xi8>, tensor<6x68xi8>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<6x68xi8>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(126) step(1) period(2) : tensor<67xi8>
    %output = check.generate.fill value(93) : tensor<6x68xi8>
    check.compare<@signed_unary_i8>(%input, %output) : (tensor<67xi8>, tensor<6x68xi8>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<6x68xi8>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-1) step(1) period(3) : tensor<67xi8>
    %output = check.generate.fill value(93) : tensor<6x68xi8>
    check.compare<@signed_unary_i8>(%input, %output) : (tensor<67xi8>, tensor<6x68xi8>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<6x68xi8>
    }
  }
  check.return
}

