// Three lanes per four participate; the last physical wave and last logical
// cluster are partial. Each distance exercises indexed, relative, and fixed
// shuffle paths while preserving invalid and nonparticipating output slots.
func.def device inline @store_subgroup_participation_result(%item: index, %plane: index, %value: i32, %valid: i1, %output: buffer) {
  %base = index.constant 0 : offset
  %fields = index.constant 2 : index
  %plane_width = index.constant 108 : index
  %valid_field = index.constant 1 : index
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %output_view = buffer.view %output[%base] : buffer -> view<540xi32>
  %plane_offset = index.mul %plane, %plane_width : index
  %item_offset = index.mul %item, %fields : index
  %position = index.add %plane_offset, %item_offset : index
  %valid_position = index.add %position, %valid_field : index
  view.store %c0, %output_view[%valid_position] : i32, view<540xi32>
  scf.if %valid {
    view.store %value, %output_view[%position] : i32, view<540xi32>
    view.store %c1, %output_view[%valid_position] : i32, view<540xi32>
  }
  func.return
}

kernel.def @subgroup_shuffle_participation() {
  %unit = index.constant 1 : index
  %items = index.constant 54 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%distance: index, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %item = kernel.workitem.id<x> : index
  %input_view = buffer.view %input[%base] : buffer -> view<54xi32>
  %value = view.load %input_view[%item] : view<54xi32> -> i32
  %participation_period = index.constant 4 : index
  %excluded_lane = index.constant 3 : index
  %relative_participation_lane = index.rem %item, %participation_period : index
  %active = index.cmp ne, %relative_participation_lane, %excluded_lane : index
  %bounded_distance = index.assume %distance [range(%distance, 0, 15)] : index
  %source = index.cast %bounded_distance : index to i32
  %width = scalar.constant 16 : i32
  scf.if %active {
    %index_value, %index_valid = kernel.subgroup.shuffle<index> %value, %source, %width : i32, i32, i32
    %index_plane = index.constant 0 : index
    func.call @store_subgroup_participation_result(%item, %index_plane, %index_value, %index_valid, %output) : (index, index, i32, i1, buffer)
    %xor_value, %xor_valid = kernel.subgroup.shuffle<xor> %value, %source, %width : i32, i32, i32
    %xor_plane = index.constant 1 : index
    func.call @store_subgroup_participation_result(%item, %xor_plane, %xor_value, %xor_valid, %output) : (index, index, i32, i1, buffer)
    %up_value, %up_valid = kernel.subgroup.shuffle<up> %value, %source, %width : i32, i32, i32
    %up_plane = index.constant 2 : index
    func.call @store_subgroup_participation_result(%item, %up_plane, %up_value, %up_valid, %output) : (index, index, i32, i1, buffer)
    %down_value, %down_valid = kernel.subgroup.shuffle<down> %value, %source, %width : i32, i32, i32
    %down_plane = index.constant 3 : index
    func.call @store_subgroup_participation_result(%item, %down_plane, %down_value, %down_valid, %output) : (index, index, i32, i1, buffer)
    %unit_distance = scalar.constant 1 : i32
    %fixed_xor_value, %fixed_xor_valid = kernel.subgroup.shuffle<xor> %value, %unit_distance, %width : i32, i32, i32
    %fixed_xor_plane = index.constant 4 : index
    func.call @store_subgroup_participation_result(%item, %fixed_xor_plane, %fixed_xor_value, %fixed_xor_valid, %output) : (index, index, i32, i1, buffer)
  }
  kernel.return
}

kernel.def @subgroup_shuffle_predicate_participation() {
  %unit = index.constant 1 : index
  %items = index.constant 54 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%distance: index, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %item = kernel.workitem.id<x> : index
  %input_view = buffer.view %input[%base] : buffer -> view<54xi32>
  %word = view.load %input_view[%item] : view<54xi32> -> i32
  %value = scalar.trunci %word : i32 to i1
  %participation_period = index.constant 4 : index
  %excluded_lane = index.constant 3 : index
  %relative_participation_lane = index.rem %item, %participation_period : index
  %active = index.cmp ne, %relative_participation_lane, %excluded_lane : index
  %bounded_distance = index.assume %distance [range(%distance, 0, 15)] : index
  %source = index.cast %bounded_distance : index to i32
  %width = scalar.constant 16 : i32
  scf.if %active {
    %index_value, %index_valid = kernel.subgroup.shuffle<index> %value, %source, %width : i1, i32, i32
    %index_bits = scalar.extui %index_value : i1 to i32
    %index_plane = index.constant 0 : index
    func.call @store_subgroup_participation_result(%item, %index_plane, %index_bits, %index_valid, %output) : (index, index, i32, i1, buffer)
    %xor_value, %xor_valid = kernel.subgroup.shuffle<xor> %value, %source, %width : i1, i32, i32
    %xor_bits = scalar.extui %xor_value : i1 to i32
    %xor_plane = index.constant 1 : index
    func.call @store_subgroup_participation_result(%item, %xor_plane, %xor_bits, %xor_valid, %output) : (index, index, i32, i1, buffer)
    %up_value, %up_valid = kernel.subgroup.shuffle<up> %value, %source, %width : i1, i32, i32
    %up_bits = scalar.extui %up_value : i1 to i32
    %up_plane = index.constant 2 : index
    func.call @store_subgroup_participation_result(%item, %up_plane, %up_bits, %up_valid, %output) : (index, index, i32, i1, buffer)
    %down_value, %down_valid = kernel.subgroup.shuffle<down> %value, %source, %width : i1, i32, i32
    %down_bits = scalar.extui %down_value : i1 to i32
    %down_plane = index.constant 3 : index
    func.call @store_subgroup_participation_result(%item, %down_plane, %down_bits, %down_valid, %output) : (index, index, i32, i1, buffer)
    %unit_distance = scalar.constant 1 : i32
    %fixed_xor_value, %fixed_xor_valid = kernel.subgroup.shuffle<xor> %value, %unit_distance, %width : i1, i32, i32
    %fixed_xor_bits = scalar.extui %fixed_xor_value : i1 to i32
    %fixed_xor_plane = index.constant 4 : index
    func.call @store_subgroup_participation_result(%item, %fixed_xor_plane, %fixed_xor_bits, %fixed_xor_valid, %output) : (index, index, i32, i1, buffer)
  }
  kernel.return
}

// Encoded floats are observed as object bits, including NaN payloads. Each
// encoding uses the same sparse, partial-subgroup participation geometry.
kernel.def @subgroup_shuffle_encoded_participation() {
  %unit = index.constant 1 : index
  %items = index.constant 54 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%distance: index, %input: buffer, %bfloat_output: buffer, %e4m3_output: buffer, %e5m2_output: buffer) {
  %base = index.constant 0 : offset
  %item = kernel.workitem.id<x> : index
  %input_view = buffer.view %input[%base] : buffer -> view<54xi32>
  %word = view.load %input_view[%item] : view<54xi32> -> i32
  %half_bits = scalar.trunci %word : i32 to i16
  %byte_bits = scalar.trunci %word : i32 to i8
  %bfloat = scalar.bitcast %half_bits : i16 to bf16
  %e4m3 = scalar.bitcast %byte_bits : i8 to f8E4M3
  %e5m2 = scalar.bitcast %byte_bits : i8 to f8E5M2
  %period = index.constant 4 : index
  %excluded = index.constant 3 : index
  %relative = index.rem %item, %period : index
  %active = index.cmp ne, %relative, %excluded : index
  %bounded_distance = index.assume %distance [range(%distance, 0, 15)] : index
  %source = index.cast %bounded_distance : index to i32
  %width = scalar.constant 16 : i32
  scf.if %active {
    %index_plane = index.constant 0 : index
    %bfloat_index, %bfloat_index_valid = kernel.subgroup.shuffle<index> %bfloat, %source, %width : bf16, i32, i32
    %bfloat_index_bits = scalar.bitcast %bfloat_index : bf16 to i16
    %bfloat_index_word = scalar.extui %bfloat_index_bits : i16 to i32
    func.call @store_subgroup_participation_result(%item, %index_plane, %bfloat_index_word, %bfloat_index_valid, %bfloat_output) : (index, index, i32, i1, buffer)
    %e4m3_index, %e4m3_index_valid = kernel.subgroup.shuffle<index> %e4m3, %source, %width : f8E4M3, i32, i32
    %e4m3_index_bits = scalar.bitcast %e4m3_index : f8E4M3 to i8
    %e4m3_index_word = scalar.extui %e4m3_index_bits : i8 to i32
    func.call @store_subgroup_participation_result(%item, %index_plane, %e4m3_index_word, %e4m3_index_valid, %e4m3_output) : (index, index, i32, i1, buffer)
    %e5m2_index, %e5m2_index_valid = kernel.subgroup.shuffle<index> %e5m2, %source, %width : f8E5M2, i32, i32
    %e5m2_index_bits = scalar.bitcast %e5m2_index : f8E5M2 to i8
    %e5m2_index_word = scalar.extui %e5m2_index_bits : i8 to i32
    func.call @store_subgroup_participation_result(%item, %index_plane, %e5m2_index_word, %e5m2_index_valid, %e5m2_output) : (index, index, i32, i1, buffer)
    %xor_plane = index.constant 1 : index
    %bfloat_xor, %bfloat_xor_valid = kernel.subgroup.shuffle<xor> %bfloat, %source, %width : bf16, i32, i32
    %bfloat_xor_bits = scalar.bitcast %bfloat_xor : bf16 to i16
    %bfloat_xor_word = scalar.extui %bfloat_xor_bits : i16 to i32
    func.call @store_subgroup_participation_result(%item, %xor_plane, %bfloat_xor_word, %bfloat_xor_valid, %bfloat_output) : (index, index, i32, i1, buffer)
    %e4m3_xor, %e4m3_xor_valid = kernel.subgroup.shuffle<xor> %e4m3, %source, %width : f8E4M3, i32, i32
    %e4m3_xor_bits = scalar.bitcast %e4m3_xor : f8E4M3 to i8
    %e4m3_xor_word = scalar.extui %e4m3_xor_bits : i8 to i32
    func.call @store_subgroup_participation_result(%item, %xor_plane, %e4m3_xor_word, %e4m3_xor_valid, %e4m3_output) : (index, index, i32, i1, buffer)
    %e5m2_xor, %e5m2_xor_valid = kernel.subgroup.shuffle<xor> %e5m2, %source, %width : f8E5M2, i32, i32
    %e5m2_xor_bits = scalar.bitcast %e5m2_xor : f8E5M2 to i8
    %e5m2_xor_word = scalar.extui %e5m2_xor_bits : i8 to i32
    func.call @store_subgroup_participation_result(%item, %xor_plane, %e5m2_xor_word, %e5m2_xor_valid, %e5m2_output) : (index, index, i32, i1, buffer)
    %up_plane = index.constant 2 : index
    %bfloat_up, %bfloat_up_valid = kernel.subgroup.shuffle<up> %bfloat, %source, %width : bf16, i32, i32
    %bfloat_up_bits = scalar.bitcast %bfloat_up : bf16 to i16
    %bfloat_up_word = scalar.extui %bfloat_up_bits : i16 to i32
    func.call @store_subgroup_participation_result(%item, %up_plane, %bfloat_up_word, %bfloat_up_valid, %bfloat_output) : (index, index, i32, i1, buffer)
    %e4m3_up, %e4m3_up_valid = kernel.subgroup.shuffle<up> %e4m3, %source, %width : f8E4M3, i32, i32
    %e4m3_up_bits = scalar.bitcast %e4m3_up : f8E4M3 to i8
    %e4m3_up_word = scalar.extui %e4m3_up_bits : i8 to i32
    func.call @store_subgroup_participation_result(%item, %up_plane, %e4m3_up_word, %e4m3_up_valid, %e4m3_output) : (index, index, i32, i1, buffer)
    %e5m2_up, %e5m2_up_valid = kernel.subgroup.shuffle<up> %e5m2, %source, %width : f8E5M2, i32, i32
    %e5m2_up_bits = scalar.bitcast %e5m2_up : f8E5M2 to i8
    %e5m2_up_word = scalar.extui %e5m2_up_bits : i8 to i32
    func.call @store_subgroup_participation_result(%item, %up_plane, %e5m2_up_word, %e5m2_up_valid, %e5m2_output) : (index, index, i32, i1, buffer)
    %down_plane = index.constant 3 : index
    %bfloat_down, %bfloat_down_valid = kernel.subgroup.shuffle<down> %bfloat, %source, %width : bf16, i32, i32
    %bfloat_down_bits = scalar.bitcast %bfloat_down : bf16 to i16
    %bfloat_down_word = scalar.extui %bfloat_down_bits : i16 to i32
    func.call @store_subgroup_participation_result(%item, %down_plane, %bfloat_down_word, %bfloat_down_valid, %bfloat_output) : (index, index, i32, i1, buffer)
    %e4m3_down, %e4m3_down_valid = kernel.subgroup.shuffle<down> %e4m3, %source, %width : f8E4M3, i32, i32
    %e4m3_down_bits = scalar.bitcast %e4m3_down : f8E4M3 to i8
    %e4m3_down_word = scalar.extui %e4m3_down_bits : i8 to i32
    func.call @store_subgroup_participation_result(%item, %down_plane, %e4m3_down_word, %e4m3_down_valid, %e4m3_output) : (index, index, i32, i1, buffer)
    %e5m2_down, %e5m2_down_valid = kernel.subgroup.shuffle<down> %e5m2, %source, %width : f8E5M2, i32, i32
    %e5m2_down_bits = scalar.bitcast %e5m2_down : f8E5M2 to i8
    %e5m2_down_word = scalar.extui %e5m2_down_bits : i8 to i32
    func.call @store_subgroup_participation_result(%item, %down_plane, %e5m2_down_word, %e5m2_down_valid, %e5m2_output) : (index, index, i32, i1, buffer)
    %unit_distance = scalar.constant 1 : i32
    %fixed_plane = index.constant 4 : index
    %bfloat_fixed, %bfloat_fixed_valid = kernel.subgroup.shuffle<xor> %bfloat, %unit_distance, %width : bf16, i32, i32
    %bfloat_fixed_bits = scalar.bitcast %bfloat_fixed : bf16 to i16
    %bfloat_fixed_word = scalar.extui %bfloat_fixed_bits : i16 to i32
    func.call @store_subgroup_participation_result(%item, %fixed_plane, %bfloat_fixed_word, %bfloat_fixed_valid, %bfloat_output) : (index, index, i32, i1, buffer)
    %e4m3_fixed, %e4m3_fixed_valid = kernel.subgroup.shuffle<xor> %e4m3, %unit_distance, %width : f8E4M3, i32, i32
    %e4m3_fixed_bits = scalar.bitcast %e4m3_fixed : f8E4M3 to i8
    %e4m3_fixed_word = scalar.extui %e4m3_fixed_bits : i8 to i32
    func.call @store_subgroup_participation_result(%item, %fixed_plane, %e4m3_fixed_word, %e4m3_fixed_valid, %e4m3_output) : (index, index, i32, i1, buffer)
    %e5m2_fixed, %e5m2_fixed_valid = kernel.subgroup.shuffle<xor> %e5m2, %unit_distance, %width : f8E5M2, i32, i32
    %e5m2_fixed_bits = scalar.bitcast %e5m2_fixed : f8E5M2 to i8
    %e5m2_fixed_word = scalar.extui %e5m2_fixed_bits : i8 to i32
    func.call @store_subgroup_participation_result(%item, %fixed_plane, %e5m2_fixed_word, %e5m2_fixed_valid, %e5m2_output) : (index, index, i32, i1, buffer)
  }
  kernel.return
}

func.def inline @store_subgroup_participation_oracle_result(%item: index, %source: i32, %plane: index, %input: buffer, %output: buffer, %value_mask: i32) {
  %base = index.constant 0 : offset
  %fields = index.constant 2 : index
  %plane_width = index.constant 108 : index
  %valid_field = index.constant 1 : index
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %end_i32 = scalar.constant 54 : i32
  %logical_width_i32 = scalar.constant 16 : i32
  %participation_period_i32 = scalar.constant 4 : i32
  %excluded_lane_i32 = scalar.constant 3 : i32
  %input_view = buffer.view %input[%base] : buffer -> view<54xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<540xi32>
  %plane_offset = index.mul %plane, %plane_width : index
  %item_offset = index.mul %item, %fields : index
  %position = index.add %plane_offset, %item_offset : index
  %valid_position = index.add %position, %valid_field : index
  view.store %c0_i32, %output_view[%valid_position] : i32, view<540xi32>
  %nonnegative = scalar.cmpi sge, %source, %c0_i32 : i32
  %below_end = scalar.cmpi slt, %source, %end_i32 : i32
  %source_in_range = scalar.andi %nonnegative, %below_end : i1
  scf.if %source_in_range {
    %item_i32 = index.cast %item : index to i32
    %item_cluster = scalar.divsi %item_i32, %logical_width_i32 : i32
    %source_cluster = scalar.divsi %source, %logical_width_i32 : i32
    %same_cluster = scalar.cmpi eq, %item_cluster, %source_cluster : i32
    %source_participation_lane = scalar.remsi %source, %participation_period_i32 : i32
    %source_active = scalar.cmpi ne, %source_participation_lane, %excluded_lane_i32 : i32
    %valid = scalar.andi %same_cluster, %source_active : i1
    scf.if %valid {
      %source_index = index.cast %source : i32 to index
      %word = view.load %input_view[%source_index] : view<54xi32> -> i32
      %value = scalar.andi %word, %value_mask : i32
      view.store %value, %output_view[%position] : i32, view<540xi32>
      view.store %c1_i32, %output_view[%valid_position] : i32, view<540xi32>
    }
  }
  func.return
}

func.def inline @subgroup_shuffle_participation_masked_oracle(%distance: index, %input: buffer, %output: buffer, %value_mask: i32) {
  %begin = index.constant 0 : index
  %end = index.constant 54 : index
  %step = index.constant 1 : index
  %logical_width = scalar.constant 16 : i32
  %participation_period = index.constant 4 : index
  %excluded_lane = index.constant 3 : index
  %distance_i32 = index.cast %distance : index to i32
  %unit_i32 = scalar.constant 1 : i32
  scf.for %item = [%begin to %end step %step] {
    %relative_participation_lane = index.rem %item, %participation_period : index
    %active = index.cmp ne, %relative_participation_lane, %excluded_lane : index
    scf.if %active {
      %item_i32 = index.cast %item : index to i32
      %item_cluster = scalar.divsi %item_i32, %logical_width : i32
      %cluster_base = scalar.muli %item_cluster, %logical_width : i32
      %index_source = scalar.addi %cluster_base, %distance_i32 : i32
      %index_plane = index.constant 0 : index
      func.call @store_subgroup_participation_oracle_result(%item, %index_source, %index_plane, %input, %output, %value_mask) : (index, i32, index, buffer, buffer, i32)
      %xor_source = scalar.xori %item_i32, %distance_i32 : i32
      %xor_plane = index.constant 1 : index
      func.call @store_subgroup_participation_oracle_result(%item, %xor_source, %xor_plane, %input, %output, %value_mask) : (index, i32, index, buffer, buffer, i32)
      %up_source = scalar.subi %item_i32, %distance_i32 : i32
      %up_plane = index.constant 2 : index
      func.call @store_subgroup_participation_oracle_result(%item, %up_source, %up_plane, %input, %output, %value_mask) : (index, i32, index, buffer, buffer, i32)
      %down_source = scalar.addi %item_i32, %distance_i32 : i32
      %down_plane = index.constant 3 : index
      func.call @store_subgroup_participation_oracle_result(%item, %down_source, %down_plane, %input, %output, %value_mask) : (index, i32, index, buffer, buffer, i32)
      %fixed_xor_source = scalar.xori %item_i32, %unit_i32 : i32
      %fixed_xor_plane = index.constant 4 : index
      func.call @store_subgroup_participation_oracle_result(%item, %fixed_xor_source, %fixed_xor_plane, %input, %output, %value_mask) : (index, i32, index, buffer, buffer, i32)
    }
  }
  func.return
}

func.def @subgroup_shuffle_participation_oracle(%distance: index, %input: buffer, %output: buffer) {
  %mask = scalar.constant -1 : i32
  func.call @subgroup_shuffle_participation_masked_oracle(%distance, %input, %output, %mask) : (index, buffer, buffer, i32)
  func.return
}

func.def @subgroup_shuffle_predicate_participation_oracle(%distance: index, %input: buffer, %output: buffer) {
  %mask = scalar.constant 1 : i32
  func.call @subgroup_shuffle_participation_masked_oracle(%distance, %input, %output, %mask) : (index, buffer, buffer, i32)
  func.return
}

func.def @subgroup_shuffle_encoded_participation_oracle(%distance: index, %input: buffer, %bfloat_output: buffer, %e4m3_output: buffer, %e5m2_output: buffer) {
  %half_mask = scalar.constant 65535 : i32
  %byte_mask = scalar.constant 255 : i32
  func.call @subgroup_shuffle_participation_masked_oracle(%distance, %input, %bfloat_output, %half_mask) : (index, buffer, buffer, i32)
  func.call @subgroup_shuffle_participation_masked_oracle(%distance, %input, %e4m3_output, %byte_mask) : (index, buffer, buffer, i32)
  func.call @subgroup_shuffle_participation_masked_oracle(%distance, %input, %e5m2_output, %byte_mask) : (index, buffer, buffer, i32)
  func.return
}

check.scenario @subgroup_shuffle_participation_values {
  check.trial[16](%distance: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-2147483648 to 2147483647) : tensor<54xi32>
    %storage = check.generate.fill value(-123) : tensor<572xi32>
    %prefix = check.tensor.view %storage offset(0) : tensor<572xi32> -> tensor<16xi32>
    %output = check.tensor.view %storage offset(64) : tensor<572xi32> -> tensor<540xi32>
    %suffix = check.tensor.view %storage offset(2224) : tensor<572xi32> -> tensor<16xi32>
    check.compare<@subgroup_shuffle_participation, @subgroup_shuffle_participation_oracle>(%distance, %input, %output) : (index, tensor<54xi32>, tensor<540xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<540xi32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<16xi32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<16xi32>
    }
  }
  check.return
}

check.scenario @subgroup_shuffle_predicate_participation_values {
  check.trial[16](%distance: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-2147483648 to 2147483647) : tensor<54xi32>
    %storage = check.generate.fill value(-123) : tensor<572xi32>
    %prefix = check.tensor.view %storage offset(0) : tensor<572xi32> -> tensor<16xi32>
    %output = check.tensor.view %storage offset(64) : tensor<572xi32> -> tensor<540xi32>
    %suffix = check.tensor.view %storage offset(2224) : tensor<572xi32> -> tensor<16xi32>
    check.compare<@subgroup_shuffle_predicate_participation, @subgroup_shuffle_predicate_participation_oracle>(%distance, %input, %output) : (index, tensor<54xi32>, tensor<540xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<54xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<540xi32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<16xi32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<16xi32>
    }
  }
  check.return
}

check.scenario @subgroup_shuffle_encoded_participation_values {
  check.trial[16](%distance: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-2147483648 to 2147483647) : tensor<54xi32>
    %bfloat_storage = check.generate.fill value(-123) : tensor<572xi32>
    %e4m3_storage = check.generate.fill value(-123) : tensor<572xi32>
    %e5m2_storage = check.generate.fill value(-123) : tensor<572xi32>
    %bfloat_output = check.tensor.view %bfloat_storage offset(64) : tensor<572xi32> -> tensor<540xi32>
    %e4m3_output = check.tensor.view %e4m3_storage offset(64) : tensor<572xi32> -> tensor<540xi32>
    %e5m2_output = check.tensor.view %e5m2_storage offset(64) : tensor<572xi32> -> tensor<540xi32>
    check.compare<@subgroup_shuffle_encoded_participation, @subgroup_shuffle_encoded_participation_oracle>(%distance, %input, %bfloat_output, %e4m3_output, %e5m2_output) : (index, tensor<54xi32>, tensor<540xi32>, tensor<540xi32>, tensor<540xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<54xi32>
      check.expect.bitwise actual(%bfloat_storage) expected(%bfloat_storage) : tensor<572xi32>
      check.expect.bitwise actual(%e4m3_storage) expected(%e4m3_storage) : tensor<572xi32>
      check.expect.bitwise actual(%e5m2_storage) expected(%e5m2_storage) : tensor<572xi32>
    }
  }
  check.return
}

// All four shuffle modes share runtime width/offset controls across a
// seven-component payload. Recorded topology keeps the independent oracle
// valid for sparse participation and partial subgroups.
kernel.def @subgroup_shuffle_wide_payload() {
  %unit = index.constant 1 : index
  %items = index.constant 67 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%width_i32: i32, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %item = kernel.workitem.id<x> : index
  %lane = kernel.subgroup.lane.id : index
  %subgroup = kernel.subgroup.id : index
  %lane_i32 = index.cast %lane : index to i32
  %subgroup_i32 = index.cast %subgroup : index to i32
  %topology_bytes = index.constant 536 : offset
  %scratch = buffer.alloca<workgroup> align(4) %topology_bytes : buffer
  %topology = buffer.view %scratch[%base] : buffer -> view<67x2xi32>
  %result_bytes = index.constant 1876 : offset
  %results = buffer.alloca<workgroup> align(4) %result_bytes : buffer
  %actual = buffer.view %results[%base] : buffer -> view<67x7xi32>
  view.store %lane_i32, %topology[%item, 0] : i32, view<67x2xi32>
  view.store %subgroup_i32, %topology[%item, 1] : i32, view<67x2xi32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %source = buffer.view %input[%base] : buffer -> view<67x7xi32>
  %destination = buffer.view %output[%base] : buffer -> view<67xi32>
  %value = vector.load %source[%item, 0] : view<67x7xi32> -> vector<7xi32>
  %c3 = scalar.constant 3 : i32
  %c1 = scalar.constant 1 : i32
  %lane_class = scalar.remui %lane_i32, %c3 : i32
  %active = scalar.cmpi ne, %lane_class, %c1 : i32
  %none = scalar.constant 0 : i32
  %difference = scf.if %active -> (i32) {
    %width = target.subgroup.size : index
    %subgroup_width = index.cast %width : index to i32
    %width_fits = scalar.cmpi ule, %width_i32, %subgroup_width : i32
    %cluster = scalar.divui %lane_i32, %width_i32 : i32
    %cluster_base = scalar.muli %cluster, %width_i32 : i32
    %offset = scalar.remui %lane_i32, %c3 : i32
    %offset_fits = scalar.cmpi ult, %offset, %width_i32 : i32
    %address_valid = scalar.andi %width_fits, %offset_fits : i1
    %begin = index.constant 0 : index
    %end = index.constant 67 : index
    %components = index.constant 7 : index
    %step = index.constant 1 : index
    %modes = index.constant 4 : index
    %index_mode = index.constant 0 : index
    %xor_mode = index.constant 1 : index
    %up_mode = index.constant 2 : index
    %all_modes = scf.for %mode = [%begin to %modes step %step](%mode_previous = %none : i32) -> (i32) {
      %is_index = index.cmp eq, %mode, %index_mode : index
      %is_xor = index.cmp eq, %mode, %xor_mode : index
      %is_up = index.cmp eq, %mode, %up_mode : index
      %shuffled, %valid, %selected_lane = scf.if %is_index -> (vector<7xi32>, i1, i32) {
        %result, %valid = kernel.subgroup.shuffle<index> %value, %offset, %width_i32 : vector<7xi32>, i32, i32
        %source_lane = scalar.addi %cluster_base, %offset : i32
        scf.yield %result, %valid, %source_lane : vector<7xi32>, i1, i32
      } else {
        %result, %valid, %source_lane = scf.if %is_xor -> (vector<7xi32>, i1, i32) {
          %result, %valid = kernel.subgroup.shuffle<xor> %value, %offset, %width_i32 : vector<7xi32>, i32, i32
          %source_lane = scalar.xori %lane_i32, %offset : i32
          scf.yield %result, %valid, %source_lane : vector<7xi32>, i1, i32
        } else {
          %result, %valid, %source_lane = scf.if %is_up -> (vector<7xi32>, i1, i32) {
            %result, %valid = kernel.subgroup.shuffle<up> %value, %offset, %width_i32 : vector<7xi32>, i32, i32
            %source_lane = scalar.subi %lane_i32, %offset : i32
            scf.yield %result, %valid, %source_lane : vector<7xi32>, i1, i32
          } else {
            %result, %valid = kernel.subgroup.shuffle<down> %value, %offset, %width_i32 : vector<7xi32>, i32, i32
            %source_lane = scalar.addi %lane_i32, %offset : i32
            scf.yield %result, %valid, %source_lane : vector<7xi32>, i1, i32
          }
          scf.yield %result, %valid, %source_lane : vector<7xi32>, i1, i32
        }
        scf.yield %result, %valid, %source_lane : vector<7xi32>, i1, i32
      }
      %source_cluster = scalar.divui %selected_lane, %width_i32 : i32
      %same_cluster = scalar.cmpi eq, %source_cluster, %cluster : i32
      %within_cluster = scalar.andi %address_valid, %same_cluster : i1
      scf.if %valid {
        vector.store %shuffled, %actual[%item, 0] : vector<7xi32>, view<67x7xi32>
      }
      %absent = scalar.constant false : i1
      %mismatches = scf.for %component = [%begin to %components step %step](%previous = %mode_previous : i32) -> (i32) {
        %selected, %found = scf.for %other = [%begin to %end step %step](%selected_acc = %none : i32, %found_acc = %absent : i1) -> (i32, i1) {
          %other_lane = view.load %topology[%other, 0] : view<67x2xi32> -> i32
          %other_subgroup = view.load %topology[%other, 1] : view<67x2xi32> -> i32
          %other_value = view.load %source[%other, %component] : view<67x7xi32> -> i32
          %same_subgroup = scalar.cmpi eq, %subgroup_i32, %other_subgroup : i32
          %other_class = scalar.remui %other_lane, %c3 : i32
          %other_active = scalar.cmpi ne, %other_class, %c1 : i32
          %include = scalar.andi %same_subgroup, %other_active : i1
          %matches_lane = scalar.cmpi eq, %other_lane, %selected_lane : i32
          %matches_source = scalar.andi %include, %matches_lane : i1
          %matches = scalar.andi %matches_source, %within_cluster : i1
          %next_selected = scf.select %matches, %other_value, %selected_acc : i32
          %next_found = scalar.ori %found_acc, %matches : i1
          scf.yield %next_selected, %next_found : i32, i1
        }
        %validity_matches = scalar.cmpi eq, %valid, %found : i1
        %payload_matches = scf.if %valid -> (i1) {
          %actual_selected = view.load %actual[%item, %component] : view<67x7xi32> -> i32
          %matches = scalar.cmpi eq, %actual_selected, %selected : i32
          scf.yield %matches : i1
        } else {
          scf.yield %validity_matches : i1
        }
        %shuffle_matches = scalar.andi %validity_matches, %payload_matches : i1
        %failed = scf.select %shuffle_matches, %none, %c1 : i32
        %next = scalar.ori %previous, %failed : i32
        scf.yield %next : i32
      }
      scf.yield %mismatches : i32
    }
    scf.yield %all_modes : i32
  } else {
    scf.yield %none : i32
  }
  view.store %difference, %destination[%item] : i32, view<67xi32>
  kernel.return
}

func.def @subgroup_shuffle_wide_payload_oracle(%width_i32: i32, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 67 : index
  %step = index.constant 1 : index
  %no_mismatch = scalar.constant 0 : i32
  %destination = buffer.view %output[%base] : buffer -> view<67xi32>
  scf.for %item = [%begin to %end step %step] {
    view.store %no_mismatch, %destination[%item] : i32, view<67xi32>
  }
  func.return
}

func.def @subgroup_shuffle_packet_width(%trial: index) -> (i32) {
  %ordinal = index.cast %trial : index to i32
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %c3 = scalar.constant 3 : i32
  %c16 = scalar.constant 16 : i32
  %c32 = scalar.constant 32 : i32
  %first = scalar.cmpi eq, %ordinal, %c0 : i32
  %second = scalar.cmpi eq, %ordinal, %c1 : i32
  %power = scf.select %second, %c16, %c32 : i32
  %width = scf.select %first, %c3, %power : i32
  func.return %width : i32
}

check.scenario @subgroup_shuffle_wide_payload_values {
  check.trial[3](%trial: index, %entropy: check.entropy) {
    // The width crosses the scenario boundary as a runtime value: 3, 16, 32.
    %width = check.generate<@subgroup_shuffle_packet_width>(%trial) : (index) -> (i32)
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-8388608 to 8388607) : tensor<67x7xi32>
    %output = check.generate.fill value(-1) : tensor<67xi32>
    check.compare<@subgroup_shuffle_wide_payload, @subgroup_shuffle_wide_payload_oracle>(%width, %input, %output) : (i32, tensor<67x7xi32>, tensor<67xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<67x7xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<67xi32>
    }
  }
  check.return
}
