// Compare each scan with a serial fold over the actual subgroup/lane metadata.
// Workitem coordinates index storage; they need not match subgroup lane order.
// The four folds cover both directions and inclusive/exclusive membership.
kernel.def @subgroup_scan_i32() {
  %unit = index.constant 1 : index
  %items = index.constant 128 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %item = kernel.workitem.id<x> : index
  %lane = kernel.subgroup.lane.id : index
  %subgroup = kernel.subgroup.id : index
  %lane_i32 = index.cast %lane : index to i32
  %subgroup_i32 = index.cast %subgroup : index to i32
  %bytes = index.constant 1024 : offset
  %scratch = buffer.alloca<workgroup> align(4) %bytes : buffer
  %topology = buffer.view %scratch[%base] : buffer -> view<128x2xi32>
  view.store %lane_i32, %topology[%item, 0] : i32, view<128x2xi32>
  view.store %subgroup_i32, %topology[%item, 1] : i32, view<128x2xi32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %input_view = buffer.view %input[%base] : buffer -> view<128xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<128x4xi32>
  %value = view.load %input_view[%item] : view<128xi32> -> i32
  %forward_inclusive = kernel.subgroup.scan<addi> %value {direction = forward, mode = inclusive} : i32
  %forward_exclusive = kernel.subgroup.scan<addi> %value {direction = forward, mode = exclusive} : i32
  %reverse_inclusive = kernel.subgroup.scan<addi> %value {direction = reverse, mode = inclusive} : i32
  %reverse_exclusive = kernel.subgroup.scan<addi> %value {direction = reverse, mode = exclusive} : i32
  %begin = index.constant 0 : index
  %end = index.constant 128 : index
  %step = index.constant 1 : index
  %sum_identity = scalar.constant 0 : i32
  %expected_forward_inclusive, %expected_forward_exclusive, %expected_reverse_inclusive, %expected_reverse_exclusive = scf.for %other = [%begin to %end step %step](%forward_inclusive_sum = %sum_identity : i32, %forward_exclusive_sum = %sum_identity : i32, %reverse_inclusive_sum = %sum_identity : i32, %reverse_exclusive_sum = %sum_identity : i32) -> (i32, i32, i32, i32) {
    %other_lane = view.load %topology[%other, 0] : view<128x2xi32> -> i32
    %other_subgroup = view.load %topology[%other, 1] : view<128x2xi32> -> i32
    %other_value = view.load %input_view[%other] : view<128xi32> -> i32
    %same_subgroup = scalar.cmpi eq, %subgroup_i32, %other_subgroup : i32
    %participating_value = scf.select %same_subgroup, %other_value, %sum_identity : i32
    %at_or_before = scalar.cmpi ule, %other_lane, %lane_i32 : i32
    %before = scalar.cmpi ult, %other_lane, %lane_i32 : i32
    %at_or_after = scalar.cmpi uge, %other_lane, %lane_i32 : i32
    %after = scalar.cmpi ugt, %other_lane, %lane_i32 : i32
    %forward_inclusive_value = scf.select %at_or_before, %participating_value, %sum_identity : i32
    %forward_exclusive_value = scf.select %before, %participating_value, %sum_identity : i32
    %reverse_inclusive_value = scf.select %at_or_after, %participating_value, %sum_identity : i32
    %reverse_exclusive_value = scf.select %after, %participating_value, %sum_identity : i32
    %next_forward_inclusive = scalar.addi %forward_inclusive_sum, %forward_inclusive_value : i32
    %next_forward_exclusive = scalar.addi %forward_exclusive_sum, %forward_exclusive_value : i32
    %next_reverse_inclusive = scalar.addi %reverse_inclusive_sum, %reverse_inclusive_value : i32
    %next_reverse_exclusive = scalar.addi %reverse_exclusive_sum, %reverse_exclusive_value : i32
    scf.yield %next_forward_inclusive, %next_forward_exclusive, %next_reverse_inclusive, %next_reverse_exclusive : i32, i32, i32, i32
  }
  %forward_inclusive_difference = scalar.xori %forward_inclusive, %expected_forward_inclusive : i32
  %forward_exclusive_difference = scalar.xori %forward_exclusive, %expected_forward_exclusive : i32
  %reverse_inclusive_difference = scalar.xori %reverse_inclusive, %expected_reverse_inclusive : i32
  %reverse_exclusive_difference = scalar.xori %reverse_exclusive, %expected_reverse_exclusive : i32
  view.store %forward_inclusive_difference, %output_view[%item, 0] : i32, view<128x4xi32>
  view.store %forward_exclusive_difference, %output_view[%item, 1] : i32, view<128x4xi32>
  view.store %reverse_inclusive_difference, %output_view[%item, 2] : i32, view<128x4xi32>
  view.store %reverse_exclusive_difference, %output_view[%item, 3] : i32, view<128x4xi32>
  kernel.return
}

func.def @subgroup_scan_i32_oracle(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 128 : index
  %step = index.constant 1 : index
  %no_difference = vector.constant 0 : vector<4xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<128x4xi32>
  scf.for %item = [%begin to %end step %step] {
    vector.store %no_difference, %output_view[%item, 0] : vector<4xi32>, view<128x4xi32>
  }
  func.return
}

check.scenario @subgroup_scan_i32_values {
  check.trial[4](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-16 to 16) : tensor<128xi32>
    %output = check.generate.fill value(-559038737) : tensor<128x4xi32>
    check.compare<@subgroup_scan_i32, @subgroup_scan_i32_oracle>(%input, %output) : (tensor<128xi32>, tensor<128x4xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<128xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<128x4xi32>
    }
  }
  check.return
}

// Compare bits except for NaN payloads, which extrema do not prescribe.
// A singleton prefix need not quiet a signaling NaN because it does not combine.
func.def device inline @scan_extrema_matches(%actual: vector<4xf32>, %expected: vector<4xf32>, %combined: i1) -> (i32) {
  %actual_bits = vector.bitcast %actual : vector<4xf32> to vector<4xi32>
  %expected_bits = vector.bitcast %expected : vector<4xf32> to vector<4xi32>
  %magnitude_mask = vector.constant 2147483647 : vector<4xi32>
  %infinity_bits = vector.constant 2139095040 : vector<4xi32>
  %actual_magnitude = vector.andi %actual_bits, %magnitude_mask : vector<4xi32>
  %expected_magnitude = vector.andi %expected_bits, %magnitude_mask : vector<4xi32>
  %actual_nan = vector.cmpi sgt, %actual_magnitude, %infinity_bits : vector<4xi32> -> vector<4xi1>
  %expected_nan = vector.cmpi sgt, %expected_magnitude, %infinity_bits : vector<4xi32> -> vector<4xi1>
  %both_nan = vector.andi %actual_nan, %expected_nan : vector<4xi1>
  %quiet_mask = vector.constant 4194304 : vector<4xi32>
  %actual_quiet_bits = vector.andi %actual_bits, %quiet_mask : vector<4xi32>
  %actual_quiet = vector.cmpi eq, %actual_quiet_bits, %quiet_mask : vector<4xi32> -> vector<4xi1>
  %requires_quiet = vector.splat %combined : vector<4xi1>
  %allowed_nan = vector.select %requires_quiet, %actual_quiet, %both_nan : vector<4xi1>
  %quiet_nan = vector.andi %both_nan, %allowed_nan : vector<4xi1>
  %same_bits = vector.cmpi eq, %actual_bits, %expected_bits : vector<4xi32> -> vector<4xi1>
  %true_mask = vector.constant true : vector<4xi1>
  %expected_number = vector.xori %expected_nan, %true_mask : vector<4xi1>
  %same_number = vector.andi %same_bits, %expected_number : vector<4xi1>
  %matches = vector.ori %same_number, %quiet_nan : vector<4xi1>
  %true = scalar.constant true : i1
  %all_match = vector.reduce<andi> %matches, %true : vector<4xi1>, i1
  %result = scalar.extui %all_match : i1 to i32
  func.return %result : i32
}

// Every active invocation reads the same runtime vector, so each nonempty
// prefix must reproduce it componentwise. Integer cardinality distinguishes
// empty and singleton prefixes without assuming subgroup size or dense packing.
// Odd workitems participate, leaving holes and a partial final subgroup.
kernel.def @subgroup_scan_float_extrema() {
  %unit = index.constant 1 : index
  %items = index.constant 67 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %item = kernel.workitem.id<x> : index
  %unit = index.constant 1 : index
  %parity = index.andi %item, %unit : index
  %active = index.cmp eq, %parity, %unit : index
  %input_view = buffer.view %input[%base] : buffer -> view<4xf32>
  %output_view = buffer.view %output[%base] : buffer -> view<67x8xi32>
  %value = vector.load %input_view[0] : view<4xf32> -> vector<4xf32>
  scf.if %active {
    %present = scalar.constant 1 : i32
    %absent = scalar.constant 0 : i32
    %prefix = kernel.subgroup.scan<addi> %present {direction = forward, mode = exclusive} : i32
    %has_prefix = scalar.cmpi ne, %prefix, %absent : i32
    %prefix_combines = scalar.cmpi ugt, %prefix, %present : i32
    %prefix_mask = vector.splat %has_prefix : vector<4xi1>
    %minimum_bound = vector.constant inf : vector<4xf32>
    %maximum_bound = vector.constant -inf : vector<4xf32>
    %expected_minimum = vector.select %prefix_mask, %value, %minimum_bound : vector<4xf32>
    %expected_maximum = vector.select %prefix_mask, %value, %maximum_bound : vector<4xf32>
    %exclusive_minimum = kernel.subgroup.scan<minnumf> %value {direction = forward, mode = exclusive} : vector<4xf32>
    %exclusive_maximum = kernel.subgroup.scan<maxnumf> %value {direction = forward, mode = exclusive} : vector<4xf32>
    %inclusive_minimum = kernel.subgroup.scan<minnumf> %value {direction = forward, mode = inclusive} : vector<4xf32>
    %inclusive_maximum = kernel.subgroup.scan<maxnumf> %value {direction = forward, mode = inclusive} : vector<4xf32>
    %exclusive_nan_minimum = kernel.subgroup.scan<minimumf> %value {direction = forward, mode = exclusive} : vector<4xf32>
    %exclusive_nan_maximum = kernel.subgroup.scan<maximumf> %value {direction = forward, mode = exclusive} : vector<4xf32>
    %inclusive_nan_minimum = kernel.subgroup.scan<minimumf> %value {direction = forward, mode = inclusive} : vector<4xf32>
    %inclusive_nan_maximum = kernel.subgroup.scan<maximumf> %value {direction = forward, mode = inclusive} : vector<4xf32>
    %exclusive_minimum_matches = func.call @scan_extrema_matches(%exclusive_minimum, %expected_minimum, %prefix_combines) : (vector<4xf32>, vector<4xf32>, i1) -> (i32)
    %exclusive_maximum_matches = func.call @scan_extrema_matches(%exclusive_maximum, %expected_maximum, %prefix_combines) : (vector<4xf32>, vector<4xf32>, i1) -> (i32)
    %inclusive_minimum_matches = func.call @scan_extrema_matches(%inclusive_minimum, %value, %has_prefix) : (vector<4xf32>, vector<4xf32>, i1) -> (i32)
    %inclusive_maximum_matches = func.call @scan_extrema_matches(%inclusive_maximum, %value, %has_prefix) : (vector<4xf32>, vector<4xf32>, i1) -> (i32)
    %exclusive_nan_minimum_matches = func.call @scan_extrema_matches(%exclusive_nan_minimum, %expected_minimum, %prefix_combines) : (vector<4xf32>, vector<4xf32>, i1) -> (i32)
    %exclusive_nan_maximum_matches = func.call @scan_extrema_matches(%exclusive_nan_maximum, %expected_maximum, %prefix_combines) : (vector<4xf32>, vector<4xf32>, i1) -> (i32)
    %inclusive_nan_minimum_matches = func.call @scan_extrema_matches(%inclusive_nan_minimum, %value, %has_prefix) : (vector<4xf32>, vector<4xf32>, i1) -> (i32)
    %inclusive_nan_maximum_matches = func.call @scan_extrema_matches(%inclusive_nan_maximum, %value, %has_prefix) : (vector<4xf32>, vector<4xf32>, i1) -> (i32)
    view.store %exclusive_minimum_matches, %output_view[%item, 0] : i32, view<67x8xi32>
    view.store %exclusive_maximum_matches, %output_view[%item, 1] : i32, view<67x8xi32>
    view.store %inclusive_minimum_matches, %output_view[%item, 2] : i32, view<67x8xi32>
    view.store %inclusive_maximum_matches, %output_view[%item, 3] : i32, view<67x8xi32>
    view.store %exclusive_nan_minimum_matches, %output_view[%item, 4] : i32, view<67x8xi32>
    view.store %exclusive_nan_maximum_matches, %output_view[%item, 5] : i32, view<67x8xi32>
    view.store %inclusive_nan_minimum_matches, %output_view[%item, 6] : i32, view<67x8xi32>
    view.store %inclusive_nan_maximum_matches, %output_view[%item, 7] : i32, view<67x8xi32>
  }
  kernel.return
}

func.def @subgroup_scan_extrema_oracle(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 1 : index
  %end = index.constant 67 : index
  %step = index.constant 2 : index
  %passed = vector.constant 1 : vector<8xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<67x8xi32>
  scf.for %item = [%begin to %end step %step] {
    vector.store %passed, %output_view[%item, 0] : vector<8xi32>, view<67x8xi32>
  }
  func.return
}

check.scenario @subgroup_scan_float_extrema_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(nan) : tensor<4xf32>
    %output = check.generate.fill value(-1) : tensor<67x8xi32>
    check.compare<@subgroup_scan_float_extrema, @subgroup_scan_extrema_oracle>(%input, %output) : (tensor<4xf32>, tensor<67x8xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<67x8xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-2.0) step(1.0) : tensor<4xf32>
    %output = check.generate.fill value(-1) : tensor<67x8xi32>
    check.compare<@subgroup_scan_float_extrema, @subgroup_scan_extrema_oracle>(%input, %output) : (tensor<4xf32>, tensor<67x8xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<67x8xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(-0.0) : tensor<4xf32>
    %output = check.generate.fill value(-1) : tensor<67x8xi32>
    check.compare<@subgroup_scan_float_extrema, @subgroup_scan_extrema_oracle>(%input, %output) : (tensor<4xf32>, tensor<67x8xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<67x8xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(inf) : tensor<4xf32>
    %output = check.generate.fill value(-1) : tensor<67x8xi32>
    check.compare<@subgroup_scan_float_extrema, @subgroup_scan_extrema_oracle>(%input, %output) : (tensor<4xf32>, tensor<67x8xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<67x8xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(-inf) : tensor<4xf32>
    %output = check.generate.fill value(-1) : tensor<67x8xi32>
    check.compare<@subgroup_scan_float_extrema, @subgroup_scan_extrema_oracle>(%input, %output) : (tensor<4xf32>, tensor<67x8xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<67x8xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(1.4012984643248171e-45) : tensor<4xf32>
    %output = check.generate.fill value(-1) : tensor<67x8xi32>
    check.compare<@subgroup_scan_float_extrema, @subgroup_scan_extrema_oracle>(%input, %output) : (tensor<4xf32>, tensor<67x8xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<67x8xi32>
    }
  }
  check.return
}

// Integer prefix cardinality provides an independent exact oracle for a
// uniform runtime sign. Counts fit BF16 exactly; products are always +/-1.
func.def device inline @bfloat_scan_arithmetic_matches(%sum: bf16, %product: bf16, %count: i32, %value: bf16) -> (i32, i32) {
  %wide_value = scalar.extf %value : bf16 to f32
  %wide_count = scalar.sitofp %count : i32 to f32
  %expected_sum = scalar.mulf %wide_count, %wide_value : f32
  %unit = scalar.constant 1 : i32
  %parity = scalar.andi %count, %unit : i32
  %odd = scalar.cmpi eq, %parity, %unit : i32
  %identity = scalar.constant 1.0 : f32
  %expected_product = scf.select %odd, %wide_value, %identity : f32
  %wide_sum = scalar.extf %sum : bf16 to f32
  %wide_product = scalar.extf %product : bf16 to f32
  %sum_matches = scalar.cmpf oeq, %wide_sum, %expected_sum : f32
  %product_matches = scalar.cmpf oeq, %wide_product, %expected_product : f32
  %sum_result = scalar.extui %sum_matches : i1 to i32
  %product_result = scalar.extui %product_matches : i1 to i32
  func.return %sum_result, %product_result : i32, i32
}

kernel.def @subgroup_scan_bfloat_arithmetic() {
  %unit = index.constant 1 : index
  %items = index.constant 67 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %item = kernel.workitem.id<x> : index
  %unit = index.constant 1 : index
  %parity = index.andi %item, %unit : index
  %active = index.cmp eq, %parity, %unit : index
  %input_view = buffer.view %input[%base] : buffer -> view<1xbf16>
  %output_view = buffer.view %output[%base] : buffer -> view<67x8xi32>
  %value = view.load %input_view[0] : view<1xbf16> -> bf16
  scf.if %active {
    %present = scalar.constant 1 : i32
    %forward_inclusive_count = kernel.subgroup.scan<addi> %present {direction = forward, mode = inclusive} : i32
    %forward_inclusive_sum = kernel.subgroup.scan<addf> %value {direction = forward, mode = inclusive} : bf16
    %forward_inclusive_product = kernel.subgroup.scan<mulf> %value {direction = forward, mode = inclusive} : bf16
    %forward_inclusive_sum_matches, %forward_inclusive_product_matches = func.call @bfloat_scan_arithmetic_matches(%forward_inclusive_sum, %forward_inclusive_product, %forward_inclusive_count, %value) : (bf16, bf16, i32, bf16) -> (i32, i32)
    view.store %forward_inclusive_sum_matches, %output_view[%item, 0] : i32, view<67x8xi32>
    view.store %forward_inclusive_product_matches, %output_view[%item, 1] : i32, view<67x8xi32>
    %forward_exclusive_count = kernel.subgroup.scan<addi> %present {direction = forward, mode = exclusive} : i32
    %forward_exclusive_sum = kernel.subgroup.scan<addf> %value {direction = forward, mode = exclusive} : bf16
    %forward_exclusive_product = kernel.subgroup.scan<mulf> %value {direction = forward, mode = exclusive} : bf16
    %forward_exclusive_sum_matches, %forward_exclusive_product_matches = func.call @bfloat_scan_arithmetic_matches(%forward_exclusive_sum, %forward_exclusive_product, %forward_exclusive_count, %value) : (bf16, bf16, i32, bf16) -> (i32, i32)
    view.store %forward_exclusive_sum_matches, %output_view[%item, 2] : i32, view<67x8xi32>
    view.store %forward_exclusive_product_matches, %output_view[%item, 3] : i32, view<67x8xi32>
    %reverse_inclusive_count = kernel.subgroup.scan<addi> %present {direction = reverse, mode = inclusive} : i32
    %reverse_inclusive_sum = kernel.subgroup.scan<addf> %value {direction = reverse, mode = inclusive} : bf16
    %reverse_inclusive_product = kernel.subgroup.scan<mulf> %value {direction = reverse, mode = inclusive} : bf16
    %reverse_inclusive_sum_matches, %reverse_inclusive_product_matches = func.call @bfloat_scan_arithmetic_matches(%reverse_inclusive_sum, %reverse_inclusive_product, %reverse_inclusive_count, %value) : (bf16, bf16, i32, bf16) -> (i32, i32)
    view.store %reverse_inclusive_sum_matches, %output_view[%item, 4] : i32, view<67x8xi32>
    view.store %reverse_inclusive_product_matches, %output_view[%item, 5] : i32, view<67x8xi32>
    %reverse_exclusive_count = kernel.subgroup.scan<addi> %present {direction = reverse, mode = exclusive} : i32
    %reverse_exclusive_sum = kernel.subgroup.scan<addf> %value {direction = reverse, mode = exclusive} : bf16
    %reverse_exclusive_product = kernel.subgroup.scan<mulf> %value {direction = reverse, mode = exclusive} : bf16
    %reverse_exclusive_sum_matches, %reverse_exclusive_product_matches = func.call @bfloat_scan_arithmetic_matches(%reverse_exclusive_sum, %reverse_exclusive_product, %reverse_exclusive_count, %value) : (bf16, bf16, i32, bf16) -> (i32, i32)
    view.store %reverse_exclusive_sum_matches, %output_view[%item, 6] : i32, view<67x8xi32>
    view.store %reverse_exclusive_product_matches, %output_view[%item, 7] : i32, view<67x8xi32>
  }
  kernel.return
}

check.scenario @subgroup_scan_bfloat_arithmetic_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(1.0) : tensor<1xbf16>
    %output = check.generate.fill value(-1) : tensor<67x8xi32>
    check.compare<@subgroup_scan_bfloat_arithmetic, @subgroup_scan_extrema_oracle>(%input, %output) : (tensor<1xbf16>, tensor<67x8xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<67x8xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(-1.0) : tensor<1xbf16>
    %output = check.generate.fill value(-1) : tensor<67x8xi32>
    check.compare<@subgroup_scan_bfloat_arithmetic, @subgroup_scan_extrema_oracle>(%input, %output) : (tensor<1xbf16>, tensor<67x8xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<67x8xi32>
    }
  }
  check.return
}

// BF16 values widen exactly, including zeros and subnormals. This comparison
// uses the F32 bit oracle without depending on the collective's integer keys.
func.def device inline @bfloat_scan_extrema_matches(%actual: vector<4xbf16>, %expected: vector<4xf32>, %combined: i1) -> (i32) {
  %wide = vector.extf %actual : vector<4xbf16> to vector<4xf32>
  %matches = func.call @scan_extrema_matches(%wide, %expected, %combined) : (vector<4xf32>, vector<4xf32>, i1) -> (i32)
  func.return %matches : i32
}

kernel.def @subgroup_scan_bfloat_extrema() {
  %unit = index.constant 1 : index
  %items = index.constant 67 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %item = kernel.workitem.id<x> : index
  %unit = index.constant 1 : index
  %parity = index.andi %item, %unit : index
  %active = index.cmp eq, %parity, %unit : index
  %input_view = buffer.view %input[%base] : buffer -> view<4xbf16>
  %output_view = buffer.view %output[%base] : buffer -> view<67x8xi32>
  %narrow = vector.load %input_view[0] : view<4xbf16> -> vector<4xbf16>
  %value = vector.extf %narrow : vector<4xbf16> to vector<4xf32>
  scf.if %active {
    %present = scalar.constant 1 : i32
    %absent = scalar.constant 0 : i32
    %prefix = kernel.subgroup.scan<addi> %present {direction = forward, mode = exclusive} : i32
    %has_prefix = scalar.cmpi ne, %prefix, %absent : i32
    %prefix_combines = scalar.cmpi ugt, %prefix, %present : i32
    %prefix_mask = vector.splat %has_prefix : vector<4xi1>
    %minimum_bound = vector.constant inf : vector<4xf32>
    %maximum_bound = vector.constant -inf : vector<4xf32>
    %expected_minimum = vector.select %prefix_mask, %value, %minimum_bound : vector<4xf32>
    %expected_maximum = vector.select %prefix_mask, %value, %maximum_bound : vector<4xf32>
    %exclusive_minimum = kernel.subgroup.scan<minnumf> %narrow {direction = forward, mode = exclusive} : vector<4xbf16>
    %exclusive_maximum = kernel.subgroup.scan<maxnumf> %narrow {direction = forward, mode = exclusive} : vector<4xbf16>
    %inclusive_minimum = kernel.subgroup.scan<minnumf> %narrow {direction = forward, mode = inclusive} : vector<4xbf16>
    %inclusive_maximum = kernel.subgroup.scan<maxnumf> %narrow {direction = forward, mode = inclusive} : vector<4xbf16>
    %exclusive_nan_minimum = kernel.subgroup.scan<minimumf> %narrow {direction = forward, mode = exclusive} : vector<4xbf16>
    %exclusive_nan_maximum = kernel.subgroup.scan<maximumf> %narrow {direction = forward, mode = exclusive} : vector<4xbf16>
    %inclusive_nan_minimum = kernel.subgroup.scan<minimumf> %narrow {direction = forward, mode = inclusive} : vector<4xbf16>
    %inclusive_nan_maximum = kernel.subgroup.scan<maximumf> %narrow {direction = forward, mode = inclusive} : vector<4xbf16>
    %exclusive_minimum_matches = func.call @bfloat_scan_extrema_matches(%exclusive_minimum, %expected_minimum, %prefix_combines) : (vector<4xbf16>, vector<4xf32>, i1) -> (i32)
    %exclusive_maximum_matches = func.call @bfloat_scan_extrema_matches(%exclusive_maximum, %expected_maximum, %prefix_combines) : (vector<4xbf16>, vector<4xf32>, i1) -> (i32)
    %inclusive_minimum_matches = func.call @bfloat_scan_extrema_matches(%inclusive_minimum, %value, %has_prefix) : (vector<4xbf16>, vector<4xf32>, i1) -> (i32)
    %inclusive_maximum_matches = func.call @bfloat_scan_extrema_matches(%inclusive_maximum, %value, %has_prefix) : (vector<4xbf16>, vector<4xf32>, i1) -> (i32)
    %exclusive_nan_minimum_matches = func.call @bfloat_scan_extrema_matches(%exclusive_nan_minimum, %expected_minimum, %prefix_combines) : (vector<4xbf16>, vector<4xf32>, i1) -> (i32)
    %exclusive_nan_maximum_matches = func.call @bfloat_scan_extrema_matches(%exclusive_nan_maximum, %expected_maximum, %prefix_combines) : (vector<4xbf16>, vector<4xf32>, i1) -> (i32)
    %inclusive_nan_minimum_matches = func.call @bfloat_scan_extrema_matches(%inclusive_nan_minimum, %value, %has_prefix) : (vector<4xbf16>, vector<4xf32>, i1) -> (i32)
    %inclusive_nan_maximum_matches = func.call @bfloat_scan_extrema_matches(%inclusive_nan_maximum, %value, %has_prefix) : (vector<4xbf16>, vector<4xf32>, i1) -> (i32)
    view.store %exclusive_minimum_matches, %output_view[%item, 0] : i32, view<67x8xi32>
    view.store %exclusive_maximum_matches, %output_view[%item, 1] : i32, view<67x8xi32>
    view.store %inclusive_minimum_matches, %output_view[%item, 2] : i32, view<67x8xi32>
    view.store %inclusive_maximum_matches, %output_view[%item, 3] : i32, view<67x8xi32>
    view.store %exclusive_nan_minimum_matches, %output_view[%item, 4] : i32, view<67x8xi32>
    view.store %exclusive_nan_maximum_matches, %output_view[%item, 5] : i32, view<67x8xi32>
    view.store %inclusive_nan_minimum_matches, %output_view[%item, 6] : i32, view<67x8xi32>
    view.store %inclusive_nan_maximum_matches, %output_view[%item, 7] : i32, view<67x8xi32>
  }
  kernel.return
}

// Raw BF16 patterns cover both zeros, signed subnormals, infinities, and NaNs.
check.scenario @subgroup_scan_bfloat_extrema_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(0) step(1) : tensor<4xi16>
    %output = check.generate.fill value(-1) : tensor<67x8xi32>
    check.compare<@subgroup_scan_bfloat_extrema, @subgroup_scan_extrema_oracle>(%input, %output) : (tensor<4xi16>, tensor<67x8xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<67x8xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-32768) step(1) : tensor<4xi16>
    %output = check.generate.fill value(-1) : tensor<67x8xi32>
    check.compare<@subgroup_scan_bfloat_extrema, @subgroup_scan_extrema_oracle>(%input, %output) : (tensor<4xi16>, tensor<67x8xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<67x8xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(32640) step(1) : tensor<4xi16>
    %output = check.generate.fill value(-1) : tensor<67x8xi32>
    check.compare<@subgroup_scan_bfloat_extrema, @subgroup_scan_extrema_oracle>(%input, %output) : (tensor<4xi16>, tensor<67x8xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<67x8xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-128) step(1) : tensor<4xi16>
    %output = check.generate.fill value(-1) : tensor<67x8xi32>
    check.compare<@subgroup_scan_bfloat_extrema, @subgroup_scan_extrema_oracle>(%input, %output) : (tensor<4xi16>, tensor<67x8xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<67x8xi32>
    }
  }
  check.return
}

// The three-component F64 carrier exercises vector constants and 64-bit keys.
// Non-NaN results match exactly. A singleton prefix performs no combine and
// may forward a signaling NaN; prefixes with arithmetic must quiet it.
func.def device inline @wide_scan_matches(%actual: vector<3xf64>, %expected: vector<3xf64>, %combined: i1) -> (i32) {
  %actual_bits = vector.bitcast %actual : vector<3xf64> to vector<3xi64>
  %expected_bits = vector.bitcast %expected : vector<3xf64> to vector<3xi64>
  %mask = vector.constant 9223372036854775807 : vector<3xi64>
  %infinity = vector.constant 9218868437227405312 : vector<3xi64>
  %quiet_mask = vector.constant 2251799813685248 : vector<3xi64>
  %actual_magnitude = vector.andi %actual_bits, %mask : vector<3xi64>
  %expected_magnitude = vector.andi %expected_bits, %mask : vector<3xi64>
  %actual_nan = vector.cmpi sgt, %actual_magnitude, %infinity : vector<3xi64> -> vector<3xi1>
  %expected_nan = vector.cmpi sgt, %expected_magnitude, %infinity : vector<3xi64> -> vector<3xi1>
  %actual_quiet_bits = vector.andi %actual_bits, %quiet_mask : vector<3xi64>
  %actual_quiet = vector.cmpi eq, %actual_quiet_bits, %quiet_mask : vector<3xi64> -> vector<3xi1>
  %both_nan = vector.andi %actual_nan, %expected_nan : vector<3xi1>
  %requires_quiet = vector.splat %combined : vector<3xi1>
  %allowed_nan = vector.select %requires_quiet, %actual_quiet, %both_nan : vector<3xi1>
  %quiet_nan = vector.andi %both_nan, %allowed_nan : vector<3xi1>
  %same_bits = vector.cmpi eq, %actual_bits, %expected_bits : vector<3xi64> -> vector<3xi1>
  %true_mask = vector.constant true : vector<3xi1>
  %expected_number = vector.xori %expected_nan, %true_mask : vector<3xi1>
  %same_number = vector.andi %same_bits, %expected_number : vector<3xi1>
  %matches = vector.ori %same_number, %quiet_nan : vector<3xi1>
  %true = scalar.constant true : i1
  %all_match = vector.reduce<andi> %matches, %true : vector<3xi1>, i1
  %result = scalar.extui %all_match : i1 to i32
  func.return %result : i32
}

kernel.def @subgroup_scan_wide_extrema() {
  %unit = index.constant 1 : index
  %items = index.constant 67 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %item = kernel.workitem.id<x> : index
  %unit = index.constant 1 : index
  %parity = index.andi %item, %unit : index
  %active = index.cmp eq, %parity, %unit : index
  %source = buffer.view %input[%base] : buffer -> view<3xf64>
  %destination = buffer.view %output[%base] : buffer -> view<67x4xi32>
  %value = vector.load %source[0] : view<3xf64> -> vector<3xf64>
  scf.if %active {
    %present = scalar.constant 1 : i32
    %absent = scalar.constant 0 : i32
    %prefix = kernel.subgroup.scan<addi> %present {direction = forward, mode = exclusive} : i32
    %has_prefix = scalar.cmpi ne, %prefix, %absent : i32
    %combined = scalar.cmpi ugt, %prefix, %present : i32
    %prefix_mask = vector.splat %has_prefix : vector<3xi1>
    %minimum_bound = vector.constant inf : vector<3xf64>
    %maximum_bound = vector.constant -inf : vector<3xf64>
    %expected_minimum = vector.select %prefix_mask, %value, %minimum_bound : vector<3xf64>
    %expected_maximum = vector.select %prefix_mask, %value, %maximum_bound : vector<3xf64>
    %minimum = kernel.subgroup.scan<minnumf> %value {direction = forward, mode = exclusive} : vector<3xf64>
    %maximum = kernel.subgroup.scan<maxnumf> %value {direction = forward, mode = exclusive} : vector<3xf64>
    %nan_minimum = kernel.subgroup.scan<minimumf> %value {direction = forward, mode = exclusive} : vector<3xf64>
    %nan_maximum = kernel.subgroup.scan<maximumf> %value {direction = forward, mode = exclusive} : vector<3xf64>
    %minimum_matches = func.call @wide_scan_matches(%minimum, %expected_minimum, %combined) : (vector<3xf64>, vector<3xf64>, i1) -> (i32)
    %maximum_matches = func.call @wide_scan_matches(%maximum, %expected_maximum, %combined) : (vector<3xf64>, vector<3xf64>, i1) -> (i32)
    %nan_minimum_matches = func.call @wide_scan_matches(%nan_minimum, %expected_minimum, %combined) : (vector<3xf64>, vector<3xf64>, i1) -> (i32)
    %nan_maximum_matches = func.call @wide_scan_matches(%nan_maximum, %expected_maximum, %combined) : (vector<3xf64>, vector<3xf64>, i1) -> (i32)
    view.store %minimum_matches, %destination[%item, 0] : i32, view<67x4xi32>
    view.store %maximum_matches, %destination[%item, 1] : i32, view<67x4xi32>
    view.store %nan_minimum_matches, %destination[%item, 2] : i32, view<67x4xi32>
    view.store %nan_maximum_matches, %destination[%item, 3] : i32, view<67x4xi32>
  }
  kernel.return
}

func.def @subgroup_scan_wide_extrema_oracle(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 1 : index
  %end = index.constant 67 : index
  %step = index.constant 2 : index
  %passed = vector.constant 1 : vector<4xi32>
  %destination = buffer.view %output[%base] : buffer -> view<67x4xi32>
  scf.for %item = [%begin to %end step %step] {
    vector.store %passed, %destination[%item, 0] : vector<4xi32>, view<67x4xi32>
  }
  func.return
}

check.scenario @subgroup_scan_wide_extrema_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(9218868437227405312) step(1) : tensor<3xi64>
    %output = check.generate.fill value(-1) : tensor<67x4xi32>
    check.compare<@subgroup_scan_wide_extrema, @subgroup_scan_wide_extrema_oracle>(%input, %output) : (tensor<3xi64>, tensor<67x4xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<67x4xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-9223372036854775808) step(1) : tensor<3xi64>
    %output = check.generate.fill value(-1) : tensor<67x4xi32>
    check.compare<@subgroup_scan_wide_extrema, @subgroup_scan_wide_extrema_oracle>(%input, %output) : (tensor<3xi64>, tensor<67x4xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<67x4xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(0) step(1) : tensor<3xi64>
    %output = check.generate.fill value(-1) : tensor<67x4xi32>
    check.compare<@subgroup_scan_wide_extrema, @subgroup_scan_wide_extrema_oracle>(%input, %output) : (tensor<3xi64>, tensor<67x4xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<67x4xi32>
    }
  }
  check.return
}
