  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%value_0: i8, %value_1: i16, %value_2: i32, %value_3: i64, %value_4: f8E4M3, %value_5: f8E5M2, %value_6: f16, %value_7: bf16, %value_8: f32, %value_9: f64, %output: buffer) {
