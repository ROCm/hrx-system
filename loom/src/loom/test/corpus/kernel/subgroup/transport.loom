  check.trial[32](%selected: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-2147483648 to 2147483647) : tensor<160xi32>
    %storage = check.generate.fill value(-123) : tensor<1472xi32>
    %output = check.tensor.view %storage offset(64) : tensor<1472xi32> -> tensor<1440xi32>
    check.compare<@subgroup_transport_address_5, @subgroup_transport_address_5_oracle>(%selected, %input, %output) : (index, tensor<160xi32>, tensor<1440xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<160xi32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<1472xi32>
    }
  }
  check.return
}

