// Fixed-width numeric payloads retain every bit across named, indexed and
// first-active exchange. Packed tails cross scalar memory so padding is not
// part of the observable payload. Each 32-lane cluster reuses one input block,
// allowing the same exact native oracle for wave32 and wave64.
kernel.def @subgroup_transport_i64_1() {
  %unit = index.constant 1 : index
  %items = index.constant 96 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%selected: index, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %item = kernel.workitem.id<x> : index
  %cluster = index.constant 32 : index
  %relative_lane = index.rem %item, %cluster : index
  %elements = index.constant 1 : index
  %position = index.mul %item, %elements : index
  %input_position = index.mul %relative_lane, %elements : index
  %group = index.constant 96 : index
  %second = index.add %position, %group : index
  %third = index.add %second, %group : index
