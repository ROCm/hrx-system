// A seventeen-byte payload crosses a four-word exchange boundary. Both the
// source read and the result write have an exact, unpadded memory footprint.
kernel.def @subgroup_transport_f8e4m3_17() {
  %unit = index.constant 1 : index
  %items = index.constant 96 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%selected: index, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %item = kernel.workitem.id<x> : index
  %cluster = index.constant 32 : index
  %relative_lane = index.rem %item, %cluster : index
  %bounded = index.assume %selected [range(%selected, 0, 31)] : index
  %source_lane = index.cast %bounded : index to i32
  %input_view = buffer.view %input[%base] : buffer -> view<32x17xf8E4M3>
  %output_view = buffer.view %output[%base] : buffer -> view<3x96x17xf8E4M3>
  %value = vector.load<volatile> %input_view[%relative_lane, 0] : view<32x17xf8E4M3> -> vector<17xf8E4M3>
  %named = kernel.subgroup.broadcast %value from %source_lane : vector<17xf8E4M3>, i32
  vector.store %named, %output_view[0, %item, 0] : vector<17xf8E4M3>, view<3x96x17xf8E4M3>
  %width = scalar.constant 32 : i32
  %shuffled, %valid = kernel.subgroup.shuffle<index> %value, %source_lane, %width : vector<17xf8E4M3>, i32, i32
  scf.if %valid {
    vector.store %shuffled, %output_view[1, %item, 0] : vector<17xf8E4M3>, view<3x96x17xf8E4M3>
  }
  %first_lane = index.constant 5 : index
  %end_lane = index.constant 10 : index
  %above = index.cmp uge, %relative_lane, %first_lane : index
  %below = index.cmp ult, %relative_lane, %end_lane : index
  %active = scalar.andi %above, %below : i1
  scf.if %active {
    %first = kernel.subgroup.broadcast.first %value : vector<17xf8E4M3>
    vector.store %first, %output_view[2, %item, 0] : vector<17xf8E4M3>, view<3x96x17xf8E4M3>
  }
  kernel.return
}

// Address elements preserve their target-selected carriers across native
// packet boundaries. Both address domains round-trip the source word bits.
kernel.def @subgroup_transport_address_5() {
  %unit = index.constant 1 : index
  %items = index.constant 96 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%selected: index, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %item = kernel.workitem.id<x> : index
  %cluster = index.constant 32 : index
  %relative_lane = index.rem %item, %cluster : index
  %bounded = index.assume %selected [range(%selected, 0, 31)] : index
  %source_lane = index.cast %bounded : index to i32
  %input_view = buffer.view %input[%base] : buffer -> view<32x5xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<3x96x5xi32>
  %words = vector.load<volatile> %input_view[%relative_lane, 0] : view<32x5xi32> -> vector<5xi32>
  %indices = vector.index_cast %words : vector<5xi32> to vector<5xindex>
  %offsets = vector.index_cast %words : vector<5xi32> to vector<5xoffset>
  %named = kernel.subgroup.broadcast %indices from %source_lane : vector<5xindex>, i32
  %named_words = vector.index_cast %named : vector<5xindex> to vector<5xi32>
  vector.store %named_words, %output_view[0, %item, 0] : vector<5xi32>, view<3x96x5xi32>
  %width = scalar.constant 32 : i32
  %shuffled, %valid = kernel.subgroup.shuffle<index> %offsets, %source_lane, %width : vector<5xoffset>, i32, i32
  scf.if %valid {
    %shuffled_words = vector.index_cast %shuffled : vector<5xoffset> to vector<5xi32>
    vector.store %shuffled_words, %output_view[1, %item, 0] : vector<5xi32>, view<3x96x5xi32>
  }
  %first_lane = index.constant 5 : index
  %end_lane = index.constant 10 : index
  %above = index.cmp uge, %relative_lane, %first_lane : index
  %below = index.cmp ult, %relative_lane, %end_lane : index
  %active = scalar.andi %above, %below : i1
  scf.if %active {
    %first = kernel.subgroup.broadcast.first %offsets : vector<5xoffset>
    %first_words = vector.index_cast %first : vector<5xoffset> to vector<5xi32>
    vector.store %first_words, %output_view[2, %item, 0] : vector<5xi32>, view<3x96x5xi32>
  }
  kernel.return
}

// Reproduce named, indexed, and first-active exchange as byte copies from the
// same 32-lane input block consumed by each target cluster.
func.def inline @subgroup_transport_bytes_oracle(%selected: index, %record_byte_count: index, %input: buffer, %output: buffer) {
  %begin = index.constant 0 : index
  %item_count = index.constant 96 : index
  %step = index.constant 1 : index
  %cluster_width = index.constant 32 : index
  %first_active_lane = index.constant 5 : index
  %active_lane_end = index.constant 10 : index
  %second_plane = index.mul %item_count, %record_byte_count : index
  %c2 = index.constant 2 : index
  %third_plane = index.mul %second_plane, %c2 : index
  %bounded_selected = index.assume %selected [range(%selected, 0, 31)] : index
  %selected_record = index.mul %bounded_selected, %record_byte_count : index
  %first_active_record = index.mul %first_active_lane, %record_byte_count : index
  scf.for %item = [%begin to %item_count step %step] {
    %record = index.mul %item, %record_byte_count : index
    %indexed_record = index.add %second_plane, %record : index
    scf.for %component = [%begin to %record_byte_count step %step] {
      %source_index = index.add %selected_record, %component : index
      %source_offset = index.cast %source_index : index to offset
      %byte = buffer.load.i8.u %input[%source_offset]
      %named_index = index.add %record, %component : index
      %named_offset = index.cast %named_index : index to offset
      buffer.store.i8 %byte, %output[%named_offset]
      %indexed_index = index.add %indexed_record, %component : index
      %indexed_offset = index.cast %indexed_index : index to offset
      buffer.store.i8 %byte, %output[%indexed_offset]
    }
    %relative_lane = index.rem %item, %cluster_width : index
    %above_first = index.cmp uge, %relative_lane, %first_active_lane : index
    %below_end = index.cmp ult, %relative_lane, %active_lane_end : index
    %active = scalar.andi %above_first, %below_end : i1
    scf.if %active {
      %first_record = index.add %third_plane, %record : index
      scf.for %component = [%begin to %record_byte_count step %step] {
        %source_index = index.add %first_active_record, %component : index
        %source_offset = index.cast %source_index : index to offset
        %byte = buffer.load.i8.u %input[%source_offset]
        %result_index = index.add %first_record, %component : index
        %result_offset = index.cast %result_index : index to offset
        buffer.store.i8 %byte, %output[%result_offset]
      }
    }
  }
  func.return
}

func.def @subgroup_transport_i64_1_oracle(%selected: index, %input: buffer, %output: buffer) {
  %record_byte_count = index.constant 8 : index
  func.call @subgroup_transport_bytes_oracle(%selected, %record_byte_count, %input, %output) : (index, index, buffer, buffer)
  func.return
}

