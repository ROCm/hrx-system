func.def @subgroup_transport_uniform_oracle(%value_0: i8, %value_1: i16, %value_2: i32, %value_3: i64, %value_4: f8E4M3, %value_5: f8E5M2, %value_6: f16, %value_7: bf16, %value_8: f32, %value_9: f64, %output: buffer) {
  %begin = index.constant 0 : index
  %end = index.constant 32 : index
  %step = index.constant 1 : index
  %stride = index.constant 80 : index
  scf.for %item = [%begin to %end step %step] {
    %position = index.mul %item, %stride : index
    %address = index.cast %position : index to offset
    %field_0 = index.constant 0 : offset
    %address_0 = index.add %address, %field_0 : offset
    %output_0 = buffer.view %output[%address_0] : buffer -> view<1xi8>
    view.store %value_0, %output_0[0] : i8, view<1xi8>
    %field_1 = index.constant 8 : offset
    %address_1 = index.add %address, %field_1 : offset
    %output_1 = buffer.view %output[%address_1] : buffer -> view<1xi16>
    view.store %value_1, %output_1[0] : i16, view<1xi16>
    %field_2 = index.constant 16 : offset
    %address_2 = index.add %address, %field_2 : offset
    %output_2 = buffer.view %output[%address_2] : buffer -> view<1xi32>
    view.store %value_2, %output_2[0] : i32, view<1xi32>
    %field_3 = index.constant 24 : offset
    %address_3 = index.add %address, %field_3 : offset
    %output_3 = buffer.view %output[%address_3] : buffer -> view<1xi64>
    view.store %value_3, %output_3[0] : i64, view<1xi64>
    %field_4 = index.constant 32 : offset
    %address_4 = index.add %address, %field_4 : offset
    %output_4 = buffer.view %output[%address_4] : buffer -> view<1xf8E4M3>
    view.store %value_4, %output_4[0] : f8E4M3, view<1xf8E4M3>
    %field_5 = index.constant 40 : offset
    %address_5 = index.add %address, %field_5 : offset
    %output_5 = buffer.view %output[%address_5] : buffer -> view<1xf8E5M2>
    view.store %value_5, %output_5[0] : f8E5M2, view<1xf8E5M2>
    %field_6 = index.constant 48 : offset
    %address_6 = index.add %address, %field_6 : offset
    %output_6 = buffer.view %output[%address_6] : buffer -> view<1xf16>
    view.store %value_6, %output_6[0] : f16, view<1xf16>
    %field_7 = index.constant 56 : offset
    %address_7 = index.add %address, %field_7 : offset
    %output_7 = buffer.view %output[%address_7] : buffer -> view<1xbf16>
    view.store %value_7, %output_7[0] : bf16, view<1xbf16>
    %field_8 = index.constant 64 : offset
    %address_8 = index.add %address, %field_8 : offset
    %output_8 = buffer.view %output[%address_8] : buffer -> view<1xf32>
    view.store %value_8, %output_8[0] : f32, view<1xf32>
    %field_9 = index.constant 72 : offset
    %address_9 = index.add %address, %field_9 : offset
    %output_9 = buffer.view %output[%address_9] : buffer -> view<1xf64>
    view.store %value_9, %output_9[0] : f64, view<1xf64>
  }
  func.return
}

