  %output_view = buffer.view %output[%base] : buffer -> view<288xi64>
  %value = view.load %input_view[%input_position] : view<32xi64> -> i64
  %named = kernel.subgroup.broadcast %value from %source_lane : i64, i32
  view.store %named, %output_view[%position] : i64, view<288xi64>
  %width = scalar.constant 32 : i32
  %shuffled, %valid = kernel.subgroup.shuffle<index> %value, %source_lane, %width : i64, i32, i32
  scf.if %valid {
    view.store %shuffled, %output_view[%second] : i64, view<288xi64>
  }
  %first_lane = index.constant 5 : index
  %end_lane = index.constant 10 : index
  %above = index.cmp uge, %relative_lane, %first_lane : index
  %below = index.cmp ult, %relative_lane, %end_lane : index
  %active = scalar.andi %above, %below : i1
  scf.if %active {
