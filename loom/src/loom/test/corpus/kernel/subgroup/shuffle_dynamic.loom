// This oracle computes a candidate source coordinate independently of the
// target's normalized shuffle, then finds that source in actual topology.
func.def device inline @check_logical_shuffle(%actual: i32, %actual_valid: i1, %mode: i32, %offset: i32, %width: i32, %input: buffer, %output: buffer, %output_base: offset) {
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %size_index = kernel.subgroup.size : index
  %size = index.cast %size_index : index to i32
  %lane_index = kernel.subgroup.lane.id : index
  %lane = index.cast %lane_index : index to i32
  %positive = scalar.cmpi sgt, %width, %c0 : i32
  %fits = scalar.cmpi ule, %width, %size : i32
  %width_valid = scalar.andi %positive, %fits : i1
  %safe_width = scf.select %width_valid, %width, %c1 : i32
  %cluster = scalar.divui %lane, %safe_width : i32
  %base = scalar.muli %cluster, %safe_width : i32
  %indexed = scalar.addi %base, %offset : i32
  %xor = scalar.xori %lane, %offset : i32
  %up = scalar.subi %lane, %offset : i32
  %down = scalar.addi %lane, %offset : i32
  %is_index = scalar.cmpi eq, %mode, %c0 : i32
  %is_xor = scalar.cmpi eq, %mode, %c1 : i32
  %is_up = scalar.cmpi eq, %mode, %c2 : i32
  %relative = scf.select %is_up, %up, %down : i32
  %permuted = scf.select %is_xor, %xor, %relative : i32
  %source = scf.select %is_index, %indexed, %permuted : i32
  %source_cluster = scalar.divui %source, %safe_width : i32
  %same_cluster = scalar.cmpi eq, %source_cluster, %cluster : i32
  %offset_fits = scalar.cmpi ult, %offset, %safe_width : i32
  %valid = scalar.andi %width_valid, %offset_fits : i1
  %within_cluster = scalar.andi %valid, %same_cluster : i1
  func.call @check_dynamic_shuffle(%actual, %actual_valid, %source, %within_cluster, %input, %output, %output_base) : (i32, i1, i32, i1, buffer, buffer, offset)
  func.return
}

kernel.def @subgroup_shuffle_unbounded() {
  %unit = index.constant 1 : index
  %items = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%width: i32, %offsets: buffer, %input: buffer, %output: buffer) {
  %item = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %offset_view = buffer.view %offsets[%base] : buffer -> view<64xi32>
  %input_view = buffer.view %input[%base] : buffer -> view<64xi32>
  %offset = view.load %offset_view[%item] : view<64xi32> -> i32
  %value = view.load %input_view[%item] : view<64xi32> -> i32
  %index_mode = scalar.constant 0 : i32
  %xor_mode = scalar.constant 1 : i32
  %up_mode = scalar.constant 2 : i32
  %down_mode = scalar.constant 3 : i32
  %xor_base = index.constant 256 : offset
  %up_base = index.constant 512 : offset
  %down_base = index.constant 768 : offset
  %indexed, %index_valid = kernel.subgroup.shuffle<index> %value, %offset, %width : i32, i32, i32
  func.call @check_logical_shuffle(%indexed, %index_valid, %index_mode, %offset, %width, %input, %output, %base) : (i32, i1, i32, i32, i32, buffer, buffer, offset)
  %xor, %xor_valid = kernel.subgroup.shuffle<xor> %value, %offset, %width : i32, i32, i32
  func.call @check_logical_shuffle(%xor, %xor_valid, %xor_mode, %offset, %width, %input, %output, %xor_base) : (i32, i1, i32, i32, i32, buffer, buffer, offset)
  %up, %up_valid = kernel.subgroup.shuffle<up> %value, %offset, %width : i32, i32, i32
  func.call @check_logical_shuffle(%up, %up_valid, %up_mode, %offset, %width, %input, %output, %up_base) : (i32, i1, i32, i32, i32, buffer, buffer, offset)
  %down, %down_valid = kernel.subgroup.shuffle<down> %value, %offset, %width : i32, i32, i32
  func.call @check_logical_shuffle(%down, %down_valid, %down_mode, %offset, %width, %input, %output, %down_base) : (i32, i1, i32, i32, i32, buffer, buffer, offset)
  kernel.return
}

func.def @subgroup_shuffle_unbounded_oracle(%width: i32, %offsets: buffer, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 256 : index
  %step = index.constant 1 : index
  %view = buffer.view %output[%base] : buffer -> view<256xi32>
  %c0 = scalar.constant 0 : i32
  scf.for %item = [%begin to %end step %step] {
    view.store %c0, %view[%item] : i32, view<256xi32>
  }
  func.return
}

func.def @subgroup_shuffle_width(%trial: index) -> (i32) {
  %ordinal = index.cast %trial : index to i32
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %c3 = scalar.constant 3 : i32
  %c7 = scalar.constant 7 : i32
  %c8 = scalar.constant 8 : i32
  %negative = scalar.constant -1 : i32
  %power = scalar.shli %c1, %ordinal : i32
  %ordinary = scalar.cmpi ult, %ordinal, %c7 : i32
  %odd = scalar.cmpi eq, %ordinal, %c7 : i32
  %empty = scalar.cmpi eq, %ordinal, %c8 : i32
  %invalid = scf.select %empty, %c0, %negative : i32
  %special = scf.select %odd, %c3, %invalid : i32
  %width = scf.select %ordinary, %power, %special : i32
  func.return %width : i32
}

check.scenario @subgroup_shuffle_unbounded_case {
  // Widths 1, 2, 4, 8, 16, 32, 64, 3, 0, and -1; runtime offsets include
  // negative, in-cluster, cross-cluster, and out-of-subgroup coordinates.
  check.trial[10](%trial: index, %entropy: check.entropy) {
    %width = check.generate<@subgroup_shuffle_width>(%trial) : (index) -> (i32)
    %seed = check.entropy.read %entropy[0] : check.entropy -> i64
    %offsets = check.generate.random.uniform seed(%seed) range(-2 to 66) : tensor<64xi32>
    %input = check.generate.iota offset(19) step(731) : tensor<64xi32>
    %storage = check.generate.fill value(-123456789) : tensor<264xi32>
    %prefix = check.tensor.view %storage offset(0) : tensor<264xi32> -> tensor<4xi32>
    %output = check.tensor.view %storage offset(16) : tensor<264xi32> -> tensor<256xi32>
    %suffix = check.tensor.view %storage offset(1040) : tensor<264xi32> -> tensor<4xi32>
    check.compare<@subgroup_shuffle_unbounded, @subgroup_shuffle_unbounded_oracle>(%width, %offsets, %input, %output) : (i32, tensor<64xi32>, tensor<64xi32>, tensor<256xi32>) -> () {
      check.expect.bitwise actual(%offsets) expected(%offsets) : tensor<64xi32>
      check.expect.bitwise actual(%input) expected(%input) : tensor<64xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<256xi32>
      check.expect.bitwise actual(%prefix) expected(%prefix) : tensor<4xi32>
      check.expect.bitwise actual(%suffix) expected(%suffix) : tensor<4xi32>
    }
  }
  check.return
}
