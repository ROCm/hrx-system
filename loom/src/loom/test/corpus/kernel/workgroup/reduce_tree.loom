// Six components cross the native packet boundary while retaining one
// workgroup collective. The scalar oracle accumulates each component in F32.
kernel.def @workgroup_tree_bfloat_vector() {
  %unit = index.constant 1 : index
  %width = index.constant 67 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %item = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<67x6xbf16>
  %destination = buffer.view %output[%base] : buffer -> view<67x6xbf16>
  %value = vector.load %source[%item, 0] : view<67x6xbf16> -> vector<6xbf16>
  %result = kernel.workgroup.reduce<addf> %value : vector<6xbf16>
  vector.store %result, %destination[%item, 0] : vector<6xbf16>, view<67x6xbf16>
  kernel.return
}

func.def @workgroup_tree_bfloat_vector_oracle(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 67 : index
  %step = index.constant 1 : index
  %source = buffer.view %input[%base] : buffer -> view<67x6xbf16>
  %destination = buffer.view %output[%base] : buffer -> view<67x6xbf16>
  %sum_identity = scalar.constant 0.0 : f32
  %components = index.constant 6 : index
  scf.for %component = [%begin to %components step %step] {
    %sum = scf.for %item = [%begin to %end step %step](%accumulator = %sum_identity : f32) -> (f32) {
      %value = view.load %source[%item, %component] : view<67x6xbf16> -> bf16
      %wide = scalar.extf %value : bf16 to f32
      %next = scalar.addf %accumulator, %wide : f32
      scf.yield %next : f32
    }
    %result = scalar.fptrunc %sum : f32 to bf16
    scf.for %item = [%begin to %end step %step] {
      view.store %result, %destination[%item, %component] : bf16, view<67x6xbf16>
    }
  }
  func.return
}

