// Serially sums every scalar input element and broadcasts the result across
// the output span. Leader-only and all-lane target kernels share this oracle.
func.def @workgroup_tree_float_sum_oracle(%input: buffer, %output: buffer) {
  %input_length = buffer.length %input
  %bounded_input_length = index.assume %input_length [range(%input_length, 0, 9223372036854775807)] : offset
  %input_bytes = index.cast %bounded_input_length : offset to index
  %element_bytes = index.constant 4 : index
  %unbounded_element_count = index.div %input_bytes, %element_bytes : index
  %element_count = index.assume %unbounded_element_count [range(%unbounded_element_count, 1, 9223372036854775807)] : index
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<[%element_count]xf32>
  %begin = index.constant 1 : index
  %step = index.constant 1 : index
  %initial_sum = view.load %input_view[0] : view<[%element_count]xf32> -> f32
  %sum = scf.for %position = [%begin to %element_count step %step](%accumulator = %initial_sum : f32) -> (f32) {
    %bounded_position = index.assume %position [range(%position, 0, 9223372036854775807)] : index
    %value = view.load %input_view[%bounded_position] : view<[%element_count]xf32> -> f32
    %next = scalar.addf %accumulator, %value : f32
    scf.yield %next : f32
  }
  %output_length = buffer.length %output
  buffer.fill %sum, %output[%base], %output_length : f32
  func.return
}

// Computes unsigned minimum directly from the integer source values.
func.def @workgroup_tree_unsigned_min_oracle(%input: buffer, %output: buffer) {
  %input_length = buffer.length %input
  %bounded_input_length = index.assume %input_length [range(%input_length, 0, 9223372036854775807)] : offset
  %input_bytes = index.cast %bounded_input_length : offset to index
  %element_bytes = index.constant 4 : index
  %unbounded_element_count = index.div %input_bytes, %element_bytes : index
  %element_count = index.assume %unbounded_element_count [range(%unbounded_element_count, 1, 9223372036854775807)] : index
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<[%element_count]xi32>
  %begin = index.constant 1 : index
  %step = index.constant 1 : index
  %first = view.load %input_view[0] : view<[%element_count]xi32> -> i32
  %minimum = scf.for %position = [%begin to %element_count step %step](%current = %first : i32) -> (i32) {
    %bounded_position = index.assume %position [range(%position, 0, 9223372036854775807)] : index
    %value = view.load %input_view[%bounded_position] : view<[%element_count]xi32> -> i32
    %next = scalar.minui %current, %value : i32
    scf.yield %next : i32
  }
  %output_length = buffer.length %output
  buffer.fill %minimum, %output[%base], %output_length : i32
  func.return
}

// Sums the two vector positions independently with scalar arithmetic and
// broadcasts the pair to every output row.
func.def @workgroup_tree_vector_sum_oracle(%input: buffer, %output: buffer) {
  %input_length = buffer.length %input
  %bounded_input_length = index.assume %input_length [range(%input_length, 0, 9223372036854775807)] : offset
  %input_bytes = index.cast %bounded_input_length : offset to index
  %row_bytes = index.constant 8 : index
  %row_count = index.div %input_bytes, %row_bytes : index
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<[%row_count]x2xf32>
  %output_view = buffer.view %output[%base] : buffer -> view<[%row_count]x2xf32>
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %initial_sum = scalar.constant 0.0 : f32
  %left_sum, %right_sum = scf.for %row = [%begin to %row_count step %step](%left = %initial_sum : f32, %right = %initial_sum : f32) -> (f32, f32) {
    %bounded_row = index.assume %row [range(%row, 0, 9223372036854775807)] : index
    %left_value = view.load %input_view[%bounded_row, 0] : view<[%row_count]x2xf32> -> f32
    %right_value = view.load %input_view[%bounded_row, 1] : view<[%row_count]x2xf32> -> f32
    %next_left = scalar.addf %left, %left_value : f32
    %next_right = scalar.addf %right, %right_value : f32
    scf.yield %next_left, %next_right : f32, f32
  }
  %pair = vector.from_elements %left_sum, %right_sum : vector<2xf32>
  scf.for %row = [%begin to %row_count step %step] {
    %bounded_row = index.assume %row [range(%row, 0, 9223372036854775807)] : index
    vector.store %pair, %output_view[%bounded_row, 0] : vector<2xf32>, view<[%row_count]x2xf32>
  }
  func.return
}

// Computes numeric maximum serially from the scalar source values.
func.def @workgroup_tree_maxnum_oracle(%input: buffer, %output: buffer) {
  %input_length = buffer.length %input
  %bounded_input_length = index.assume %input_length [range(%input_length, 0, 9223372036854775807)] : offset
  %input_bytes = index.cast %bounded_input_length : offset to index
  %element_bytes = index.constant 4 : index
  %unbounded_element_count = index.div %input_bytes, %element_bytes : index
  %element_count = index.assume %unbounded_element_count [range(%unbounded_element_count, 1, 9223372036854775807)] : index
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<[%element_count]xf32>
  %begin = index.constant 1 : index
  %step = index.constant 1 : index
  %first = view.load %input_view[0] : view<[%element_count]xf32> -> f32
  %maximum = scf.for %position = [%begin to %element_count step %step](%current = %first : f32) -> (f32) {
    %bounded_position = index.assume %position [range(%position, 0, 9223372036854775807)] : index
    %value = view.load %input_view[%bounded_position] : view<[%element_count]xf32> -> f32
    %next = scalar.maxnumf %current, %value : f32
    scf.yield %next : f32
  }
  %output_length = buffer.length %output
  buffer.fill %maximum, %output[%base], %output_length : f32
  func.return
}

kernel.def @workgroup_tree_float_leader() {
  %unit = index.constant 1 : index
  %size = index.constant 256 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %tid = kernel.workitem.id<x> : index
  %start = index.constant 0 : offset
  %input_view = buffer.view %input[%start] : buffer -> view<256xf32>
  %output_view = buffer.view %output[%start] : buffer -> view<1xf32>
  %value = view.load %input_view[%tid] : view<256xf32> -> f32
  %reduced = kernel.workgroup.reduce<addf> %value : f32
  %leader_index = index.constant 0 : index
  %is_leader = index.cmp eq, %tid, %leader_index : index
  scf.if %is_leader {
    view.store %reduced, %output_view[%leader_index] : f32, view<1xf32>
  }
  kernel.return
}

check.scenario @workgroup_tree_float_leader_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(1.0) step(1.0) : tensor<256xf32>
    %output = check.generate.fill value(-1.0) : tensor<1xf32>
    check.compare<@workgroup_tree_float_leader, @workgroup_tree_float_sum_oracle>(%input, %output) : (tensor<256xf32>, tensor<1xf32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<256xf32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<1xf32>
    }
  }
  check.return
}

