// The irregular 5x4x4 launch crosses subgroup and row boundaries. The oracle
// scans flattened logical workitem order, independently of physical lane IDs.
kernel.def @workgroup_scan_i32() {
  %unit = index.constant 1 : index
  %x = index.constant 5 : index
  %other = index.constant 4 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%x, %other, %other) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %x = kernel.workitem.id<x> : index
  %y = kernel.workitem.id<y> : index
  %z = kernel.workitem.id<z> : index
  %size_x = index.constant 5 : index
  %size_y = index.constant 4 : index
  %plane = index.mul %z, %size_y : index
  %row = index.add %plane, %y : index
  %row_start = index.mul %row, %size_x : index
  %item = index.add %row_start, %x : index
  %input_view = buffer.view %input[%base] : buffer -> view<80xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<80x4xi32>
  %value = view.load %input_view[%item] : view<80xi32> -> i32
  %forward_inclusive = kernel.workgroup.scan<addi> %value {direction = forward, mode = inclusive} : i32
  %forward_exclusive = kernel.workgroup.scan<addi> %value {direction = forward, mode = exclusive} : i32
  %reverse_inclusive = kernel.workgroup.scan<addi> %value {direction = reverse, mode = inclusive} : i32
  %reverse_exclusive = kernel.workgroup.scan<addi> %value {direction = reverse, mode = exclusive} : i32
  view.store %forward_inclusive, %output_view[%item, 0] : i32, view<80x4xi32>
  view.store %forward_exclusive, %output_view[%item, 1] : i32, view<80x4xi32>
  view.store %reverse_inclusive, %output_view[%item, 2] : i32, view<80x4xi32>
  view.store %reverse_exclusive, %output_view[%item, 3] : i32, view<80x4xi32>
  kernel.return
}

func.def @workgroup_scan_i32_oracle(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 80 : index
  %step = index.constant 1 : index
  %c0 = scalar.constant 0 : i32
  %input_view = buffer.view %input[%base] : buffer -> view<80xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<80x4xi32>
  scf.for %item = [%begin to %end step %step] {
    %next_item = index.add %item, %step : index
    %forward_inclusive = scf.for %position = [%begin to %next_item step %step](%sum = %c0 : i32) -> (i32) {
      %value = view.load %input_view[%position] : view<80xi32> -> i32
      %next = scalar.addi %sum, %value : i32
      scf.yield %next : i32
    }
    %forward_exclusive = scf.for %position = [%begin to %item step %step](%sum = %c0 : i32) -> (i32) {
      %value = view.load %input_view[%position] : view<80xi32> -> i32
      %next = scalar.addi %sum, %value : i32
      scf.yield %next : i32
    }
    %reverse_inclusive = scf.for %position = [%item to %end step %step](%sum = %c0 : i32) -> (i32) {
      %value = view.load %input_view[%position] : view<80xi32> -> i32
      %next = scalar.addi %sum, %value : i32
      scf.yield %next : i32
    }
    %reverse_exclusive = scf.for %position = [%next_item to %end step %step](%sum = %c0 : i32) -> (i32) {
      %value = view.load %input_view[%position] : view<80xi32> -> i32
      %next = scalar.addi %sum, %value : i32
      scf.yield %next : i32
    }
    view.store %forward_inclusive, %output_view[%item, 0] : i32, view<80x4xi32>
    view.store %forward_exclusive, %output_view[%item, 1] : i32, view<80x4xi32>
    view.store %reverse_inclusive, %output_view[%item, 2] : i32, view<80x4xi32>
    view.store %reverse_exclusive, %output_view[%item, 3] : i32, view<80x4xi32>
  }
  func.return
}

check.scenario @workgroup_scan_i32_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-40) step(3) : tensor<80xi32>
    %output = check.generate.fill value(-559038737) : tensor<80x4xi32>
    check.compare<@workgroup_scan_i32, @workgroup_scan_i32_oracle>(%input, %output) : (tensor<80xi32>, tensor<80x4xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<80xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<80x4xi32>
    }
  }
  check.return
}

// These launches exercise different partition counts and partial tails.
// An empty exclusive prefix is observable, but must not become a contribution
// when composing a nonempty scan across a partition boundary.
kernel.def @workgroup_scan_float() {
  %unit = index.constant 1 : index
  %items = index.constant 33 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %item = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<33xf32>
  %destination = buffer.view %output[%base] : buffer -> view<33x16xf32>
  %value = view.load %source[%item] : view<33xf32> -> f32
  %forward_inclusive_sum = kernel.workgroup.scan<addf, preserve> %value {direction = forward, mode = inclusive} : f32
  %forward_inclusive_product = kernel.workgroup.scan<mulf, preserve> %value {direction = forward, mode = inclusive} : f32
  %forward_inclusive_minimum = kernel.workgroup.scan<minnumf> %value {direction = forward, mode = inclusive} : f32
  %forward_inclusive_maximum = kernel.workgroup.scan<maxnumf> %value {direction = forward, mode = inclusive} : f32
  view.store %forward_inclusive_sum, %destination[%item, 0] : f32, view<33x16xf32>
  view.store %forward_inclusive_product, %destination[%item, 1] : f32, view<33x16xf32>
  view.store %forward_inclusive_minimum, %destination[%item, 2] : f32, view<33x16xf32>
  view.store %forward_inclusive_maximum, %destination[%item, 3] : f32, view<33x16xf32>
  %forward_exclusive_sum = kernel.workgroup.scan<addf, preserve> %value {direction = forward, mode = exclusive} : f32
  %forward_exclusive_product = kernel.workgroup.scan<mulf, preserve> %value {direction = forward, mode = exclusive} : f32
  %forward_exclusive_minimum = kernel.workgroup.scan<minnumf> %value {direction = forward, mode = exclusive} : f32
  %forward_exclusive_maximum = kernel.workgroup.scan<maxnumf> %value {direction = forward, mode = exclusive} : f32
  view.store %forward_exclusive_sum, %destination[%item, 4] : f32, view<33x16xf32>
  view.store %forward_exclusive_product, %destination[%item, 5] : f32, view<33x16xf32>
  view.store %forward_exclusive_minimum, %destination[%item, 6] : f32, view<33x16xf32>
  view.store %forward_exclusive_maximum, %destination[%item, 7] : f32, view<33x16xf32>
  %reverse_inclusive_sum = kernel.workgroup.scan<addf, preserve> %value {direction = reverse, mode = inclusive} : f32
  %reverse_inclusive_product = kernel.workgroup.scan<mulf, preserve> %value {direction = reverse, mode = inclusive} : f32
  %reverse_inclusive_minimum = kernel.workgroup.scan<minnumf> %value {direction = reverse, mode = inclusive} : f32
  %reverse_inclusive_maximum = kernel.workgroup.scan<maxnumf> %value {direction = reverse, mode = inclusive} : f32
  view.store %reverse_inclusive_sum, %destination[%item, 8] : f32, view<33x16xf32>
  view.store %reverse_inclusive_product, %destination[%item, 9] : f32, view<33x16xf32>
  view.store %reverse_inclusive_minimum, %destination[%item, 10] : f32, view<33x16xf32>
  view.store %reverse_inclusive_maximum, %destination[%item, 11] : f32, view<33x16xf32>
  %reverse_exclusive_sum = kernel.workgroup.scan<addf, preserve> %value {direction = reverse, mode = exclusive} : f32
  %reverse_exclusive_product = kernel.workgroup.scan<mulf, preserve> %value {direction = reverse, mode = exclusive} : f32
  %reverse_exclusive_minimum = kernel.workgroup.scan<minnumf> %value {direction = reverse, mode = exclusive} : f32
  %reverse_exclusive_maximum = kernel.workgroup.scan<maxnumf> %value {direction = reverse, mode = exclusive} : f32
  view.store %reverse_exclusive_sum, %destination[%item, 12] : f32, view<33x16xf32>
  view.store %reverse_exclusive_product, %destination[%item, 13] : f32, view<33x16xf32>
  view.store %reverse_exclusive_minimum, %destination[%item, 14] : f32, view<33x16xf32>
  view.store %reverse_exclusive_maximum, %destination[%item, 15] : f32, view<33x16xf32>
  kernel.return
}

kernel.def @workgroup_scan_vector() {
  %unit = index.constant 1 : index
  %items = index.constant 83 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %item = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<83x2xf32>
  %destination = buffer.view %output[%base] : buffer -> view<83x16x2xf32>
  %value = vector.load %source[%item, 0] : view<83x2xf32> -> vector<2xf32>
  %forward_inclusive_sum = kernel.workgroup.scan<addf, preserve> %value {direction = forward, mode = inclusive} : vector<2xf32>
  %forward_inclusive_product = kernel.workgroup.scan<mulf, preserve> %value {direction = forward, mode = inclusive} : vector<2xf32>
  %forward_inclusive_minimum = kernel.workgroup.scan<minnumf> %value {direction = forward, mode = inclusive} : vector<2xf32>
  %forward_inclusive_maximum = kernel.workgroup.scan<maxnumf> %value {direction = forward, mode = inclusive} : vector<2xf32>
  vector.store %forward_inclusive_sum, %destination[%item, 0, 0] : vector<2xf32>, view<83x16x2xf32>
  vector.store %forward_inclusive_product, %destination[%item, 1, 0] : vector<2xf32>, view<83x16x2xf32>
  vector.store %forward_inclusive_minimum, %destination[%item, 2, 0] : vector<2xf32>, view<83x16x2xf32>
  vector.store %forward_inclusive_maximum, %destination[%item, 3, 0] : vector<2xf32>, view<83x16x2xf32>
  %forward_exclusive_sum = kernel.workgroup.scan<addf, preserve> %value {direction = forward, mode = exclusive} : vector<2xf32>
  %forward_exclusive_product = kernel.workgroup.scan<mulf, preserve> %value {direction = forward, mode = exclusive} : vector<2xf32>
  %forward_exclusive_minimum = kernel.workgroup.scan<minnumf> %value {direction = forward, mode = exclusive} : vector<2xf32>
  %forward_exclusive_maximum = kernel.workgroup.scan<maxnumf> %value {direction = forward, mode = exclusive} : vector<2xf32>
  vector.store %forward_exclusive_sum, %destination[%item, 4, 0] : vector<2xf32>, view<83x16x2xf32>
  vector.store %forward_exclusive_product, %destination[%item, 5, 0] : vector<2xf32>, view<83x16x2xf32>
  vector.store %forward_exclusive_minimum, %destination[%item, 6, 0] : vector<2xf32>, view<83x16x2xf32>
  vector.store %forward_exclusive_maximum, %destination[%item, 7, 0] : vector<2xf32>, view<83x16x2xf32>
  %reverse_inclusive_sum = kernel.workgroup.scan<addf, preserve> %value {direction = reverse, mode = inclusive} : vector<2xf32>
  %reverse_inclusive_product = kernel.workgroup.scan<mulf, preserve> %value {direction = reverse, mode = inclusive} : vector<2xf32>
  %reverse_inclusive_minimum = kernel.workgroup.scan<minnumf> %value {direction = reverse, mode = inclusive} : vector<2xf32>
  %reverse_inclusive_maximum = kernel.workgroup.scan<maxnumf> %value {direction = reverse, mode = inclusive} : vector<2xf32>
  vector.store %reverse_inclusive_sum, %destination[%item, 8, 0] : vector<2xf32>, view<83x16x2xf32>
  vector.store %reverse_inclusive_product, %destination[%item, 9, 0] : vector<2xf32>, view<83x16x2xf32>
  vector.store %reverse_inclusive_minimum, %destination[%item, 10, 0] : vector<2xf32>, view<83x16x2xf32>
  vector.store %reverse_inclusive_maximum, %destination[%item, 11, 0] : vector<2xf32>, view<83x16x2xf32>
  %reverse_exclusive_sum = kernel.workgroup.scan<addf, preserve> %value {direction = reverse, mode = exclusive} : vector<2xf32>
  %reverse_exclusive_product = kernel.workgroup.scan<mulf, preserve> %value {direction = reverse, mode = exclusive} : vector<2xf32>
  %reverse_exclusive_minimum = kernel.workgroup.scan<minnumf> %value {direction = reverse, mode = exclusive} : vector<2xf32>
  %reverse_exclusive_maximum = kernel.workgroup.scan<maxnumf> %value {direction = reverse, mode = exclusive} : vector<2xf32>
  vector.store %reverse_exclusive_sum, %destination[%item, 12, 0] : vector<2xf32>, view<83x16x2xf32>
  vector.store %reverse_exclusive_product, %destination[%item, 13, 0] : vector<2xf32>, view<83x16x2xf32>
  vector.store %reverse_exclusive_minimum, %destination[%item, 14, 0] : vector<2xf32>, view<83x16x2xf32>
  vector.store %reverse_exclusive_maximum, %destination[%item, 15, 0] : vector<2xf32>, view<83x16x2xf32>
  kernel.return
}

// Scan serially in each direction and scalar component. The first input starts
// every nonempty fold; the empty values are stored only at exclusive endpoints.
// Accumulate sums and products in double precision, independently of the
// subject's single-precision tree and reassociation choices.
func.def inline @workgroup_scan_float_oracle_impl(%input: buffer, %output: buffer, %items: index, %components: index) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<[%items]x[%components]xf32>
  %destination = buffer.view %output[%base] : buffer -> view<[%items]x16x[%components]xf32>
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %directions = index.constant 2 : index
  %planes_per_direction = index.constant 8 : index
  %exclusive_offset = index.constant 4 : index
  %minimum_offset = index.constant 2 : index
  %maximum_offset = index.constant 3 : index
  %last = index.sub %items, %step : index
  %empty_sum = scalar.constant -0.0 : f64
  %empty_product = scalar.constant 1.0 : f64
  %empty_minimum = scalar.constant inf : f32
  %empty_maximum = scalar.constant -inf : f32
  scf.for %component = [%begin to %components step %step] {
    scf.for %direction = [%begin to %directions step %step] {
      %reverse = index.cmp ne, %direction, %begin : index
      %sum_plane = index.mul %direction, %planes_per_direction : index
      %product_plane = index.add %sum_plane, %step : index
      %minimum_plane = index.add %sum_plane, %minimum_offset : index
      %maximum_plane = index.add %sum_plane, %maximum_offset : index
      %exclusive_sum_plane = index.add %sum_plane, %exclusive_offset : index
      %exclusive_product_plane = index.add %product_plane, %exclusive_offset : index
      %exclusive_minimum_plane = index.add %minimum_plane, %exclusive_offset : index
      %exclusive_maximum_plane = index.add %maximum_plane, %exclusive_offset : index
      %total_sum, %total_product, %total_minimum, %total_maximum = scf.for %position = [%begin to %items step %step](%sum = %empty_sum : f64, %product = %empty_product : f64, %minimum = %empty_minimum : f32, %maximum = %empty_maximum : f32) -> (f64, f64, f32, f32) {
        %reverse_item = index.sub %last, %position : index
        %item = scf.select %reverse, %reverse_item, %position : index
        %value = view.load %source[%item, %component] : view<[%items]x[%components]xf32> -> f32
        %wide_value = scalar.extf %value : f32 to f64
        %first = index.cmp eq, %position, %begin : index
        %combined_sum = scalar.addf %sum, %wide_value : f64
        %combined_product = scalar.mulf %product, %wide_value : f64
        %combined_minimum = scalar.minnumf %minimum, %value : f32
        %combined_maximum = scalar.maxnumf %maximum, %value : f32
        %next_sum = scf.select %first, %wide_value, %combined_sum : f64
        %next_product = scf.select %first, %wide_value, %combined_product : f64
        %next_minimum = scf.select %first, %value, %combined_minimum : f32
        %next_maximum = scf.select %first, %value, %combined_maximum : f32
        %inclusive_sum = scalar.fptrunc %next_sum : f64 to f32
        %inclusive_product = scalar.fptrunc %next_product : f64 to f32
        %exclusive_sum = scalar.fptrunc %sum : f64 to f32
        %exclusive_product = scalar.fptrunc %product : f64 to f32
        view.store %inclusive_sum, %destination[%item, %sum_plane, %component] : f32, view<[%items]x16x[%components]xf32>
        view.store %inclusive_product, %destination[%item, %product_plane, %component] : f32, view<[%items]x16x[%components]xf32>
        view.store %next_minimum, %destination[%item, %minimum_plane, %component] : f32, view<[%items]x16x[%components]xf32>
        view.store %next_maximum, %destination[%item, %maximum_plane, %component] : f32, view<[%items]x16x[%components]xf32>
        view.store %exclusive_sum, %destination[%item, %exclusive_sum_plane, %component] : f32, view<[%items]x16x[%components]xf32>
        view.store %exclusive_product, %destination[%item, %exclusive_product_plane, %component] : f32, view<[%items]x16x[%components]xf32>
        view.store %minimum, %destination[%item, %exclusive_minimum_plane, %component] : f32, view<[%items]x16x[%components]xf32>
        view.store %maximum, %destination[%item, %exclusive_maximum_plane, %component] : f32, view<[%items]x16x[%components]xf32>
        scf.yield %next_sum, %next_product, %next_minimum, %next_maximum : f64, f64, f32, f32
      }
    }
  }
  func.return
}

func.def @workgroup_scan_float_oracle(%input: buffer, %output: buffer) {
  %items = index.constant 33 : index
  %components = index.constant 1 : index
  func.call @workgroup_scan_float_oracle_impl(%input, %output, %items, %components) : (buffer, buffer, index, index)
  func.return
}

func.def @workgroup_scan_vector_oracle(%input: buffer, %output: buffer) {
  %items = index.constant 83 : index
  %components = index.constant 2 : index
  func.call @workgroup_scan_float_oracle_impl(%input, %output, %items, %components) : (buffer, buffer, index, index)
  func.return
}

check.scenario @workgroup_scan_float_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(1.4012984643248171e-45) : tensor<33xf32>
    %output = check.generate.fill value(2.0) : tensor<33x16xf32>
    check.compare<@workgroup_scan_float, @workgroup_scan_float_oracle>(%input, %output) : (tensor<33xf32>, tensor<33x16xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<33x16xf32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(inf) : tensor<33xf32>
    %output = check.generate.fill value(2.0) : tensor<33x16xf32>
    check.compare<@workgroup_scan_float, @workgroup_scan_float_oracle>(%input, %output) : (tensor<33xf32>, tensor<33x16xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<33x16xf32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(nan) : tensor<33xf32>
    %output = check.generate.fill value(2.0) : tensor<33x16xf32>
    check.compare<@workgroup_scan_float, @workgroup_scan_float_oracle>(%input, %output) : (tensor<33xf32>, tensor<33x16xf32>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(0.0) rtol(0.0) nan(same) : tensor<33x16xf32>, tensor<33x16xf32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(-0.0) : tensor<33xf32>
    %output = check.generate.fill value(2.0) : tensor<33x16xf32>
    check.compare<@workgroup_scan_float, @workgroup_scan_float_oracle>(%input, %output) : (tensor<33xf32>, tensor<33x16xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<33x16xf32>
    }
  }
  // Near-one inputs keep products finite. The tolerance covers the rounding
  // error of single-precision evaluation against the double-precision oracle.
  check.trial[4](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(0.98999999999999999 to 1.01) : tensor<33xf32>
    %output = check.generate.fill value(2.0) : tensor<33x16xf32>
    check.compare<@workgroup_scan_float, @workgroup_scan_float_oracle>(%input, %output) : (tensor<33xf32>, tensor<33x16xf32>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(0.0) rtol(1.0000000000000001e-05) nan(same) : tensor<33x16xf32>, tensor<33x16xf32>
    }
  }
  check.return
}

func.def @workgroup_scan_zero_signs(%input: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 83 : index
  %step = index.constant 1 : index
  %c0 = scalar.constant 0 : i32
  %sign_mask = scalar.constant -2147483648 : i32
  %bits = buffer.view %input[%base] : buffer -> view<83x2xi32>
  scf.for %item = [%begin to %end step %step] {
    %parity = index.andi %item, %step : index
    %odd = index.cmp ne, %parity, %begin : index
    %first = scf.select %odd, %sign_mask, %c0 : i32
    %second = scf.select %odd, %c0, %sign_mask : i32
    view.store %first, %bits[%item, 0] : i32, view<83x2xi32>
    view.store %second, %bits[%item, 1] : i32, view<83x2xi32>
  }
  func.return
}

check.scenario @workgroup_scan_vector_values {
  // Both zero signs occur within each component's scan.
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(0.0) : tensor<83x2xf32>
    check.generate<@workgroup_scan_zero_signs>(%input) : (tensor<83x2xf32>) -> ()
    %output = check.generate.fill value(2.0) : tensor<83x16x2xf32>
    check.compare<@workgroup_scan_vector, @workgroup_scan_vector_oracle>(%input, %output) : (tensor<83x2xf32>, tensor<83x16x2xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<83x16x2xf32>
    }
  }
  // Exactly representable cancellation has a bitwise oracle for every prefix.
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-1.0) step(1.0) period(3) : tensor<83x2xf32>
    %output = check.generate.fill value(2.0) : tensor<83x16x2xf32>
    check.compare<@workgroup_scan_vector, @workgroup_scan_vector_oracle>(%input, %output) : (tensor<83x2xf32>, tensor<83x16x2xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<83x16x2xf32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(1.4012984643248171e-45) : tensor<83x2xf32>
    %output = check.generate.fill value(2.0) : tensor<83x16x2xf32>
    check.compare<@workgroup_scan_vector, @workgroup_scan_vector_oracle>(%input, %output) : (tensor<83x2xf32>, tensor<83x16x2xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<83x16x2xf32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(inf) : tensor<83x2xf32>
    %output = check.generate.fill value(2.0) : tensor<83x16x2xf32>
    check.compare<@workgroup_scan_vector, @workgroup_scan_vector_oracle>(%input, %output) : (tensor<83x2xf32>, tensor<83x16x2xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<83x16x2xf32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(nan) : tensor<83x2xf32>
    %output = check.generate.fill value(2.0) : tensor<83x16x2xf32>
    check.compare<@workgroup_scan_vector, @workgroup_scan_vector_oracle>(%input, %output) : (tensor<83x2xf32>, tensor<83x16x2xf32>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(0.0) rtol(0.0) nan(same) : tensor<83x16x2xf32>, tensor<83x16x2xf32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(-0.0) : tensor<83x2xf32>
    %output = check.generate.fill value(2.0) : tensor<83x16x2xf32>
    check.compare<@workgroup_scan_vector, @workgroup_scan_vector_oracle>(%input, %output) : (tensor<83x2xf32>, tensor<83x16x2xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<83x16x2xf32>
    }
  }
  check.trial[4](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(0.98999999999999999 to 1.01) : tensor<83x2xf32>
    %output = check.generate.fill value(2.0) : tensor<83x16x2xf32>
    check.compare<@workgroup_scan_vector, @workgroup_scan_vector_oracle>(%input, %output) : (tensor<83x2xf32>, tensor<83x16x2xf32>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(0.0) rtol(1.0000000000000001e-05) nan(same) : tensor<83x16x2xf32>, tensor<83x16x2xf32>
    }
  }
  check.return
}

// Three independent components cross several scan partitions, with an
// irregular final partition. Every integer combining kind shares this shape.
kernel.def @workgroup_scan_integer_family() {
  %unit = index.constant 1 : index
  %items = index.constant 83 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %item = kernel.workitem.id<x> : index
  %source = buffer.view %input[%base] : buffer -> view<83x3xi32>
  %destination = buffer.view %output[%base] : buffer -> view<83x4x9x3xi32>
  %value = vector.load %source[%item, 0] : view<83x3xi32> -> vector<3xi32>
  %forward_sum = kernel.workgroup.scan<addi> %value {direction = forward, mode = inclusive} : vector<3xi32>
  %forward_product = kernel.workgroup.scan<muli> %value {direction = forward, mode = inclusive} : vector<3xi32>
  %forward_minimum_signed = kernel.workgroup.scan<minsi> %value {direction = forward, mode = inclusive} : vector<3xi32>
  %forward_maximum_signed = kernel.workgroup.scan<maxsi> %value {direction = forward, mode = inclusive} : vector<3xi32>
  %forward_minimum_unsigned = kernel.workgroup.scan<minui> %value {direction = forward, mode = inclusive} : vector<3xi32>
  %forward_maximum_unsigned = kernel.workgroup.scan<maxui> %value {direction = forward, mode = inclusive} : vector<3xi32>
  %forward_and = kernel.workgroup.scan<andi> %value {direction = forward, mode = inclusive} : vector<3xi32>
  %forward_or = kernel.workgroup.scan<ori> %value {direction = forward, mode = inclusive} : vector<3xi32>
  %forward_xor = kernel.workgroup.scan<xori> %value {direction = forward, mode = inclusive} : vector<3xi32>
  vector.store %forward_sum, %destination[%item, 0, 0, 0] : vector<3xi32>, view<83x4x9x3xi32>
  vector.store %forward_product, %destination[%item, 0, 1, 0] : vector<3xi32>, view<83x4x9x3xi32>
  vector.store %forward_minimum_signed, %destination[%item, 0, 2, 0] : vector<3xi32>, view<83x4x9x3xi32>
  vector.store %forward_maximum_signed, %destination[%item, 0, 3, 0] : vector<3xi32>, view<83x4x9x3xi32>
  vector.store %forward_minimum_unsigned, %destination[%item, 0, 4, 0] : vector<3xi32>, view<83x4x9x3xi32>
  vector.store %forward_maximum_unsigned, %destination[%item, 0, 5, 0] : vector<3xi32>, view<83x4x9x3xi32>
  vector.store %forward_and, %destination[%item, 0, 6, 0] : vector<3xi32>, view<83x4x9x3xi32>
  vector.store %forward_or, %destination[%item, 0, 7, 0] : vector<3xi32>, view<83x4x9x3xi32>
  vector.store %forward_xor, %destination[%item, 0, 8, 0] : vector<3xi32>, view<83x4x9x3xi32>
  %forward_exclusive_sum = kernel.workgroup.scan<addi> %value {direction = forward, mode = exclusive} : vector<3xi32>
  %forward_exclusive_product = kernel.workgroup.scan<muli> %value {direction = forward, mode = exclusive} : vector<3xi32>
  %forward_exclusive_minimum_signed = kernel.workgroup.scan<minsi> %value {direction = forward, mode = exclusive} : vector<3xi32>
  %forward_exclusive_maximum_signed = kernel.workgroup.scan<maxsi> %value {direction = forward, mode = exclusive} : vector<3xi32>
  %forward_exclusive_minimum_unsigned = kernel.workgroup.scan<minui> %value {direction = forward, mode = exclusive} : vector<3xi32>
  %forward_exclusive_maximum_unsigned = kernel.workgroup.scan<maxui> %value {direction = forward, mode = exclusive} : vector<3xi32>
  %forward_exclusive_and = kernel.workgroup.scan<andi> %value {direction = forward, mode = exclusive} : vector<3xi32>
  %forward_exclusive_or = kernel.workgroup.scan<ori> %value {direction = forward, mode = exclusive} : vector<3xi32>
  %forward_exclusive_xor = kernel.workgroup.scan<xori> %value {direction = forward, mode = exclusive} : vector<3xi32>
  vector.store %forward_exclusive_sum, %destination[%item, 1, 0, 0] : vector<3xi32>, view<83x4x9x3xi32>
  vector.store %forward_exclusive_product, %destination[%item, 1, 1, 0] : vector<3xi32>, view<83x4x9x3xi32>
  vector.store %forward_exclusive_minimum_signed, %destination[%item, 1, 2, 0] : vector<3xi32>, view<83x4x9x3xi32>
  vector.store %forward_exclusive_maximum_signed, %destination[%item, 1, 3, 0] : vector<3xi32>, view<83x4x9x3xi32>
  vector.store %forward_exclusive_minimum_unsigned, %destination[%item, 1, 4, 0] : vector<3xi32>, view<83x4x9x3xi32>
  vector.store %forward_exclusive_maximum_unsigned, %destination[%item, 1, 5, 0] : vector<3xi32>, view<83x4x9x3xi32>
  vector.store %forward_exclusive_and, %destination[%item, 1, 6, 0] : vector<3xi32>, view<83x4x9x3xi32>
  vector.store %forward_exclusive_or, %destination[%item, 1, 7, 0] : vector<3xi32>, view<83x4x9x3xi32>
  vector.store %forward_exclusive_xor, %destination[%item, 1, 8, 0] : vector<3xi32>, view<83x4x9x3xi32>
  %reverse_sum = kernel.workgroup.scan<addi> %value {direction = reverse, mode = inclusive} : vector<3xi32>
  %reverse_product = kernel.workgroup.scan<muli> %value {direction = reverse, mode = inclusive} : vector<3xi32>
  %reverse_minimum_signed = kernel.workgroup.scan<minsi> %value {direction = reverse, mode = inclusive} : vector<3xi32>
  %reverse_maximum_signed = kernel.workgroup.scan<maxsi> %value {direction = reverse, mode = inclusive} : vector<3xi32>
  %reverse_minimum_unsigned = kernel.workgroup.scan<minui> %value {direction = reverse, mode = inclusive} : vector<3xi32>
  %reverse_maximum_unsigned = kernel.workgroup.scan<maxui> %value {direction = reverse, mode = inclusive} : vector<3xi32>
  %reverse_and = kernel.workgroup.scan<andi> %value {direction = reverse, mode = inclusive} : vector<3xi32>
  %reverse_or = kernel.workgroup.scan<ori> %value {direction = reverse, mode = inclusive} : vector<3xi32>
  %reverse_xor = kernel.workgroup.scan<xori> %value {direction = reverse, mode = inclusive} : vector<3xi32>
  vector.store %reverse_sum, %destination[%item, 2, 0, 0] : vector<3xi32>, view<83x4x9x3xi32>
  vector.store %reverse_product, %destination[%item, 2, 1, 0] : vector<3xi32>, view<83x4x9x3xi32>
  vector.store %reverse_minimum_signed, %destination[%item, 2, 2, 0] : vector<3xi32>, view<83x4x9x3xi32>
  vector.store %reverse_maximum_signed, %destination[%item, 2, 3, 0] : vector<3xi32>, view<83x4x9x3xi32>
  vector.store %reverse_minimum_unsigned, %destination[%item, 2, 4, 0] : vector<3xi32>, view<83x4x9x3xi32>
  vector.store %reverse_maximum_unsigned, %destination[%item, 2, 5, 0] : vector<3xi32>, view<83x4x9x3xi32>
  vector.store %reverse_and, %destination[%item, 2, 6, 0] : vector<3xi32>, view<83x4x9x3xi32>
  vector.store %reverse_or, %destination[%item, 2, 7, 0] : vector<3xi32>, view<83x4x9x3xi32>
  vector.store %reverse_xor, %destination[%item, 2, 8, 0] : vector<3xi32>, view<83x4x9x3xi32>
  %reverse_exclusive_sum = kernel.workgroup.scan<addi> %value {direction = reverse, mode = exclusive} : vector<3xi32>
  %reverse_exclusive_product = kernel.workgroup.scan<muli> %value {direction = reverse, mode = exclusive} : vector<3xi32>
  %reverse_exclusive_minimum_signed = kernel.workgroup.scan<minsi> %value {direction = reverse, mode = exclusive} : vector<3xi32>
  %reverse_exclusive_maximum_signed = kernel.workgroup.scan<maxsi> %value {direction = reverse, mode = exclusive} : vector<3xi32>
  %reverse_exclusive_minimum_unsigned = kernel.workgroup.scan<minui> %value {direction = reverse, mode = exclusive} : vector<3xi32>
  %reverse_exclusive_maximum_unsigned = kernel.workgroup.scan<maxui> %value {direction = reverse, mode = exclusive} : vector<3xi32>
  %reverse_exclusive_and = kernel.workgroup.scan<andi> %value {direction = reverse, mode = exclusive} : vector<3xi32>
  %reverse_exclusive_or = kernel.workgroup.scan<ori> %value {direction = reverse, mode = exclusive} : vector<3xi32>
  %reverse_exclusive_xor = kernel.workgroup.scan<xori> %value {direction = reverse, mode = exclusive} : vector<3xi32>
  vector.store %reverse_exclusive_sum, %destination[%item, 3, 0, 0] : vector<3xi32>, view<83x4x9x3xi32>
  vector.store %reverse_exclusive_product, %destination[%item, 3, 1, 0] : vector<3xi32>, view<83x4x9x3xi32>
  vector.store %reverse_exclusive_minimum_signed, %destination[%item, 3, 2, 0] : vector<3xi32>, view<83x4x9x3xi32>
  vector.store %reverse_exclusive_maximum_signed, %destination[%item, 3, 3, 0] : vector<3xi32>, view<83x4x9x3xi32>
  vector.store %reverse_exclusive_minimum_unsigned, %destination[%item, 3, 4, 0] : vector<3xi32>, view<83x4x9x3xi32>
  vector.store %reverse_exclusive_maximum_unsigned, %destination[%item, 3, 5, 0] : vector<3xi32>, view<83x4x9x3xi32>
  vector.store %reverse_exclusive_and, %destination[%item, 3, 6, 0] : vector<3xi32>, view<83x4x9x3xi32>
  vector.store %reverse_exclusive_or, %destination[%item, 3, 7, 0] : vector<3xi32>, view<83x4x9x3xi32>
  vector.store %reverse_exclusive_xor, %destination[%item, 3, 8, 0] : vector<3xi32>, view<83x4x9x3xi32>
  kernel.return
}

func.def @workgroup_scan_integer_family_oracle(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<83x3xi32>
  %destination = buffer.view %output[%base] : buffer -> view<83x4x9x3xi32>
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %directions = index.constant 2 : index
  %components = index.constant 3 : index
  %items = index.constant 83 : index
  %last = index.constant 82 : index
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %all_bits = scalar.constant -1 : i32
  %minimum_signed_bound = scalar.constant 2147483647 : i32
  %maximum_signed_bound = scalar.constant -2147483648 : i32
  scf.for %component = [%begin to %components step %step] {
    scf.for %direction = [%begin to %directions step %step] {
      %reverse = index.cmp ne, %direction, %begin : index
      %inclusive_plane = index.mul %direction, %directions : index
      %exclusive_plane = index.add %inclusive_plane, %step : index
      %total_sum, %total_product, %total_minimum_signed, %total_maximum_signed, %total_minimum_unsigned, %total_maximum_unsigned, %total_and, %total_or, %total_xor = scf.for %position = [%begin to %items step %step](%sum = %c0_i32 : i32, %product = %c1_i32 : i32, %minimum_signed = %minimum_signed_bound : i32, %maximum_signed = %maximum_signed_bound : i32, %minimum_unsigned = %all_bits : i32, %maximum_unsigned = %c0_i32 : i32, %and = %all_bits : i32, %or = %c0_i32 : i32, %xor = %c0_i32 : i32) -> (i32, i32, i32, i32, i32, i32, i32, i32, i32) {
        %reverse_item = index.sub %last, %position : index
        %item = scf.select %reverse, %reverse_item, %position : index
        %value = view.load %source[%item, %component] : view<83x3xi32> -> i32
        %next_sum = scalar.addi %sum, %value : i32
        %next_product = scalar.muli %product, %value : i32
        %next_minimum_signed = scalar.minsi %minimum_signed, %value : i32
        %next_maximum_signed = scalar.maxsi %maximum_signed, %value : i32
        %next_minimum_unsigned = scalar.minui %minimum_unsigned, %value : i32
        %next_maximum_unsigned = scalar.maxui %maximum_unsigned, %value : i32
        %next_and = scalar.andi %and, %value : i32
        %next_or = scalar.ori %or, %value : i32
        %next_xor = scalar.xori %xor, %value : i32
        view.store %next_sum, %destination[%item, %inclusive_plane, 0, %component] : i32, view<83x4x9x3xi32>
        view.store %next_product, %destination[%item, %inclusive_plane, 1, %component] : i32, view<83x4x9x3xi32>
        view.store %next_minimum_signed, %destination[%item, %inclusive_plane, 2, %component] : i32, view<83x4x9x3xi32>
        view.store %next_maximum_signed, %destination[%item, %inclusive_plane, 3, %component] : i32, view<83x4x9x3xi32>
        view.store %next_minimum_unsigned, %destination[%item, %inclusive_plane, 4, %component] : i32, view<83x4x9x3xi32>
        view.store %next_maximum_unsigned, %destination[%item, %inclusive_plane, 5, %component] : i32, view<83x4x9x3xi32>
        view.store %next_and, %destination[%item, %inclusive_plane, 6, %component] : i32, view<83x4x9x3xi32>
        view.store %next_or, %destination[%item, %inclusive_plane, 7, %component] : i32, view<83x4x9x3xi32>
        view.store %next_xor, %destination[%item, %inclusive_plane, 8, %component] : i32, view<83x4x9x3xi32>
        view.store %sum, %destination[%item, %exclusive_plane, 0, %component] : i32, view<83x4x9x3xi32>
        view.store %product, %destination[%item, %exclusive_plane, 1, %component] : i32, view<83x4x9x3xi32>
        view.store %minimum_signed, %destination[%item, %exclusive_plane, 2, %component] : i32, view<83x4x9x3xi32>
        view.store %maximum_signed, %destination[%item, %exclusive_plane, 3, %component] : i32, view<83x4x9x3xi32>
        view.store %minimum_unsigned, %destination[%item, %exclusive_plane, 4, %component] : i32, view<83x4x9x3xi32>
        view.store %maximum_unsigned, %destination[%item, %exclusive_plane, 5, %component] : i32, view<83x4x9x3xi32>
        view.store %and, %destination[%item, %exclusive_plane, 6, %component] : i32, view<83x4x9x3xi32>
        view.store %or, %destination[%item, %exclusive_plane, 7, %component] : i32, view<83x4x9x3xi32>
        view.store %xor, %destination[%item, %exclusive_plane, 8, %component] : i32, view<83x4x9x3xi32>
        scf.yield %next_sum, %next_product, %next_minimum_signed, %next_maximum_signed, %next_minimum_unsigned, %next_maximum_unsigned, %next_and, %next_or, %next_xor : i32, i32, i32, i32, i32, i32, i32, i32, i32
      }
    }
  }
  func.return
}

check.scenario @workgroup_scan_integer_family_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-17) step(3) period(23) : tensor<83x3xi32>
    %output = check.generate.fill value(-559038737) : tensor<83x4x9x3xi32>
    check.compare<@workgroup_scan_integer_family, @workgroup_scan_integer_family_oracle>(%input, %output) : (tensor<83x3xi32>, tensor<83x4x9x3xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<83x3xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<83x4x9x3xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-1073741823) step(104729) period(17) : tensor<83x3xi32>
    %output = check.generate.fill value(-559038737) : tensor<83x4x9x3xi32>
    check.compare<@workgroup_scan_integer_family, @workgroup_scan_integer_family_oracle>(%input, %output) : (tensor<83x3xi32>, tensor<83x4x9x3xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<83x3xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<83x4x9x3xi32>
    }
  }
  check.return
}

// Floating extrema use infinity only for an empty exclusive result. In
// particular, combining that seed with a nonempty all-NaN minnum/maxnum prefix
// would turn NaN into infinity. The scalar f64 and vector bf16 paths exercise
// shared composition beyond native single-precision workgroup scans.
kernel.def @workgroup_scan_extrema_f64() {
  %unit = index.constant 1 : index
  %items = index.constant 83 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %item = kernel.workitem.id<x> : index
  %source = buffer.view %input[%base] : buffer -> view<83xf64>
  %destination = buffer.view %output[%base] : buffer -> view<83x16xf64>
  %value = view.load %source[%item] : view<83xf64> -> f64
  %forward_minimum = kernel.workgroup.scan<minimumf> %value {direction = forward, mode = inclusive} : f64
  %forward_maximum = kernel.workgroup.scan<maximumf> %value {direction = forward, mode = inclusive} : f64
  %forward_minnum = kernel.workgroup.scan<minnumf> %value {direction = forward, mode = inclusive} : f64
  %forward_maxnum = kernel.workgroup.scan<maxnumf> %value {direction = forward, mode = inclusive} : f64
  %before_minimum = kernel.workgroup.scan<minimumf> %value {direction = forward, mode = exclusive} : f64
  %before_maximum = kernel.workgroup.scan<maximumf> %value {direction = forward, mode = exclusive} : f64
  %before_minnum = kernel.workgroup.scan<minnumf> %value {direction = forward, mode = exclusive} : f64
  %before_maxnum = kernel.workgroup.scan<maxnumf> %value {direction = forward, mode = exclusive} : f64
  %reverse_minimum = kernel.workgroup.scan<minimumf> %value {direction = reverse, mode = inclusive} : f64
  %reverse_maximum = kernel.workgroup.scan<maximumf> %value {direction = reverse, mode = inclusive} : f64
  %reverse_minnum = kernel.workgroup.scan<minnumf> %value {direction = reverse, mode = inclusive} : f64
  %reverse_maxnum = kernel.workgroup.scan<maxnumf> %value {direction = reverse, mode = inclusive} : f64
  %after_minimum = kernel.workgroup.scan<minimumf> %value {direction = reverse, mode = exclusive} : f64
  %after_maximum = kernel.workgroup.scan<maximumf> %value {direction = reverse, mode = exclusive} : f64
  %after_minnum = kernel.workgroup.scan<minnumf> %value {direction = reverse, mode = exclusive} : f64
  %after_maxnum = kernel.workgroup.scan<maxnumf> %value {direction = reverse, mode = exclusive} : f64
  view.store %forward_minimum, %destination[%item, 0] : f64, view<83x16xf64>
  view.store %forward_maximum, %destination[%item, 1] : f64, view<83x16xf64>
  view.store %forward_minnum, %destination[%item, 2] : f64, view<83x16xf64>
  view.store %forward_maxnum, %destination[%item, 3] : f64, view<83x16xf64>
  view.store %before_minimum, %destination[%item, 4] : f64, view<83x16xf64>
  view.store %before_maximum, %destination[%item, 5] : f64, view<83x16xf64>
  view.store %before_minnum, %destination[%item, 6] : f64, view<83x16xf64>
  view.store %before_maxnum, %destination[%item, 7] : f64, view<83x16xf64>
  view.store %reverse_minimum, %destination[%item, 8] : f64, view<83x16xf64>
  view.store %reverse_maximum, %destination[%item, 9] : f64, view<83x16xf64>
  view.store %reverse_minnum, %destination[%item, 10] : f64, view<83x16xf64>
  view.store %reverse_maxnum, %destination[%item, 11] : f64, view<83x16xf64>
  view.store %after_minimum, %destination[%item, 12] : f64, view<83x16xf64>
  view.store %after_maximum, %destination[%item, 13] : f64, view<83x16xf64>
  view.store %after_minnum, %destination[%item, 14] : f64, view<83x16xf64>
  view.store %after_maxnum, %destination[%item, 15] : f64, view<83x16xf64>
  kernel.return
}

kernel.def @workgroup_scan_extrema_bf16() {
  %unit = index.constant 1 : index
  %items = index.constant 83 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %item = kernel.workitem.id<x> : index
  %source = buffer.view %input[%base] : buffer -> view<83x2xf64>
  %destination = buffer.view %output[%base] : buffer -> view<83x16x2xf64>
  %wide = vector.load %source[%item, 0] : view<83x2xf64> -> vector<2xf64>
  %value = vector.fptrunc %wide : vector<2xf64> to vector<2xbf16>
  %forward_minimum = kernel.workgroup.scan<minimumf> %value {direction = forward, mode = inclusive} : vector<2xbf16>
  %forward_maximum = kernel.workgroup.scan<maximumf> %value {direction = forward, mode = inclusive} : vector<2xbf16>
  %forward_minnum = kernel.workgroup.scan<minnumf> %value {direction = forward, mode = inclusive} : vector<2xbf16>
  %forward_maxnum = kernel.workgroup.scan<maxnumf> %value {direction = forward, mode = inclusive} : vector<2xbf16>
  %before_minimum = kernel.workgroup.scan<minimumf> %value {direction = forward, mode = exclusive} : vector<2xbf16>
  %before_maximum = kernel.workgroup.scan<maximumf> %value {direction = forward, mode = exclusive} : vector<2xbf16>
  %before_minnum = kernel.workgroup.scan<minnumf> %value {direction = forward, mode = exclusive} : vector<2xbf16>
  %before_maxnum = kernel.workgroup.scan<maxnumf> %value {direction = forward, mode = exclusive} : vector<2xbf16>
  %reverse_minimum = kernel.workgroup.scan<minimumf> %value {direction = reverse, mode = inclusive} : vector<2xbf16>
  %reverse_maximum = kernel.workgroup.scan<maximumf> %value {direction = reverse, mode = inclusive} : vector<2xbf16>
  %reverse_minnum = kernel.workgroup.scan<minnumf> %value {direction = reverse, mode = inclusive} : vector<2xbf16>
  %reverse_maxnum = kernel.workgroup.scan<maxnumf> %value {direction = reverse, mode = inclusive} : vector<2xbf16>
  %after_minimum = kernel.workgroup.scan<minimumf> %value {direction = reverse, mode = exclusive} : vector<2xbf16>
  %after_maximum = kernel.workgroup.scan<maximumf> %value {direction = reverse, mode = exclusive} : vector<2xbf16>
  %after_minnum = kernel.workgroup.scan<minnumf> %value {direction = reverse, mode = exclusive} : vector<2xbf16>
  %after_maxnum = kernel.workgroup.scan<maxnumf> %value {direction = reverse, mode = exclusive} : vector<2xbf16>
  %wide_forward_minimum = vector.extf %forward_minimum : vector<2xbf16> to vector<2xf64>
  %wide_forward_maximum = vector.extf %forward_maximum : vector<2xbf16> to vector<2xf64>
  %wide_forward_minnum = vector.extf %forward_minnum : vector<2xbf16> to vector<2xf64>
  %wide_forward_maxnum = vector.extf %forward_maxnum : vector<2xbf16> to vector<2xf64>
  %wide_before_minimum = vector.extf %before_minimum : vector<2xbf16> to vector<2xf64>
  %wide_before_maximum = vector.extf %before_maximum : vector<2xbf16> to vector<2xf64>
  %wide_before_minnum = vector.extf %before_minnum : vector<2xbf16> to vector<2xf64>
  %wide_before_maxnum = vector.extf %before_maxnum : vector<2xbf16> to vector<2xf64>
  %wide_reverse_minimum = vector.extf %reverse_minimum : vector<2xbf16> to vector<2xf64>
  %wide_reverse_maximum = vector.extf %reverse_maximum : vector<2xbf16> to vector<2xf64>
  %wide_reverse_minnum = vector.extf %reverse_minnum : vector<2xbf16> to vector<2xf64>
  %wide_reverse_maxnum = vector.extf %reverse_maxnum : vector<2xbf16> to vector<2xf64>
  %wide_after_minimum = vector.extf %after_minimum : vector<2xbf16> to vector<2xf64>
  %wide_after_maximum = vector.extf %after_maximum : vector<2xbf16> to vector<2xf64>
  %wide_after_minnum = vector.extf %after_minnum : vector<2xbf16> to vector<2xf64>
  %wide_after_maxnum = vector.extf %after_maxnum : vector<2xbf16> to vector<2xf64>
  vector.store %wide_forward_minimum, %destination[%item, 0, 0] : vector<2xf64>, view<83x16x2xf64>
  vector.store %wide_forward_maximum, %destination[%item, 1, 0] : vector<2xf64>, view<83x16x2xf64>
  vector.store %wide_forward_minnum, %destination[%item, 2, 0] : vector<2xf64>, view<83x16x2xf64>
  vector.store %wide_forward_maxnum, %destination[%item, 3, 0] : vector<2xf64>, view<83x16x2xf64>
  vector.store %wide_before_minimum, %destination[%item, 4, 0] : vector<2xf64>, view<83x16x2xf64>
  vector.store %wide_before_maximum, %destination[%item, 5, 0] : vector<2xf64>, view<83x16x2xf64>
  vector.store %wide_before_minnum, %destination[%item, 6, 0] : vector<2xf64>, view<83x16x2xf64>
  vector.store %wide_before_maxnum, %destination[%item, 7, 0] : vector<2xf64>, view<83x16x2xf64>
  vector.store %wide_reverse_minimum, %destination[%item, 8, 0] : vector<2xf64>, view<83x16x2xf64>
  vector.store %wide_reverse_maximum, %destination[%item, 9, 0] : vector<2xf64>, view<83x16x2xf64>
  vector.store %wide_reverse_minnum, %destination[%item, 10, 0] : vector<2xf64>, view<83x16x2xf64>
  vector.store %wide_reverse_maxnum, %destination[%item, 11, 0] : vector<2xf64>, view<83x16x2xf64>
  vector.store %wide_after_minimum, %destination[%item, 12, 0] : vector<2xf64>, view<83x16x2xf64>
  vector.store %wide_after_maximum, %destination[%item, 13, 0] : vector<2xf64>, view<83x16x2xf64>
  vector.store %wide_after_minnum, %destination[%item, 14, 0] : vector<2xf64>, view<83x16x2xf64>
  vector.store %wide_after_maxnum, %destination[%item, 15, 0] : vector<2xf64>, view<83x16x2xf64>
  kernel.return
}

// Both subjects consume exactly representable inputs. The oracle evaluates
// each scalar component serially in f64, without subgroup or workgroup scans.
func.def inline @workgroup_scan_extrema_oracle_impl(%input: buffer, %output: buffer, %components: index) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<83x[%components]xf64>
  %destination = buffer.view %output[%base] : buffer -> view<83x16x[%components]xf64>
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %items = index.constant 83 : index
  %last = index.constant 82 : index
  %directions = index.constant 2 : index
  %planes = index.constant 8 : index
  %exclusive = index.constant 4 : index
  %number_minimum = index.constant 2 : index
  %number_maximum = index.constant 3 : index
  %empty_minimum = scalar.constant inf : f64
  %empty_maximum = scalar.constant -inf : f64
  scf.for %component = [%begin to %components step %step] {
    scf.for %direction = [%begin to %directions step %step] {
      %reverse = index.cmp ne, %direction, %begin : index
      %minimum_plane = index.mul %direction, %planes : index
      %maximum_plane = index.add %minimum_plane, %step : index
      %minnum_plane = index.add %minimum_plane, %number_minimum : index
      %maxnum_plane = index.add %minimum_plane, %number_maximum : index
      %exclusive_minimum_plane = index.add %minimum_plane, %exclusive : index
      %exclusive_maximum_plane = index.add %maximum_plane, %exclusive : index
      %exclusive_minnum_plane = index.add %minnum_plane, %exclusive : index
      %exclusive_maxnum_plane = index.add %maxnum_plane, %exclusive : index
      %total_minimum, %total_maximum, %total_minnum, %total_maxnum = scf.for %position = [%begin to %items step %step](%minimum = %empty_minimum : f64, %maximum = %empty_maximum : f64, %minnum = %empty_minimum : f64, %maxnum = %empty_maximum : f64) -> (f64, f64, f64, f64) {
        %reverse_item = index.sub %last, %position : index
        %item = scf.select %reverse, %reverse_item, %position : index
        %value = view.load %source[%item, %component] : view<83x[%components]xf64> -> f64
        %first = index.cmp eq, %position, %begin : index
        %combined_minimum = scalar.minimumf %minimum, %value : f64
        %combined_maximum = scalar.maximumf %maximum, %value : f64
        %combined_minnum = scalar.minnumf %minnum, %value : f64
        %combined_maxnum = scalar.maxnumf %maxnum, %value : f64
        %next_minimum = scf.select %first, %value, %combined_minimum : f64
        %next_maximum = scf.select %first, %value, %combined_maximum : f64
        %next_minnum = scf.select %first, %value, %combined_minnum : f64
        %next_maxnum = scf.select %first, %value, %combined_maxnum : f64
        view.store %next_minimum, %destination[%item, %minimum_plane, %component] : f64, view<83x16x[%components]xf64>
        view.store %next_maximum, %destination[%item, %maximum_plane, %component] : f64, view<83x16x[%components]xf64>
        view.store %next_minnum, %destination[%item, %minnum_plane, %component] : f64, view<83x16x[%components]xf64>
        view.store %next_maxnum, %destination[%item, %maxnum_plane, %component] : f64, view<83x16x[%components]xf64>
        view.store %minimum, %destination[%item, %exclusive_minimum_plane, %component] : f64, view<83x16x[%components]xf64>
        view.store %maximum, %destination[%item, %exclusive_maximum_plane, %component] : f64, view<83x16x[%components]xf64>
        view.store %minnum, %destination[%item, %exclusive_minnum_plane, %component] : f64, view<83x16x[%components]xf64>
        view.store %maxnum, %destination[%item, %exclusive_maxnum_plane, %component] : f64, view<83x16x[%components]xf64>
        scf.yield %next_minimum, %next_maximum, %next_minnum, %next_maxnum : f64, f64, f64, f64
      }
    }
  }
  func.return
}

func.def @workgroup_scan_extrema_f64_oracle(%input: buffer, %output: buffer) {
  %components = index.constant 1 : index
  func.call @workgroup_scan_extrema_oracle_impl(%input, %output, %components) : (buffer, buffer, index)
  func.return
}

func.def @workgroup_scan_extrema_bf16_oracle(%input: buffer, %output: buffer) {
  %components = index.constant 2 : index
  func.call @workgroup_scan_extrema_oracle_impl(%input, %output, %components) : (buffer, buffer, index)
  func.return
}

// The second trial inserts one finite contribution between all-NaN prefixes
// and suffixes, crossing both a subgroup boundary and an exclusive endpoint.
func.def @workgroup_scan_extrema_interior(%input: buffer, %components: index, %trial: index) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %view = buffer.view %input[%base] : buffer -> view<83x[%components]xf64>
  %all_nan = index.cmp eq, %trial, %begin : index
  %nan = scalar.constant nan : f64
  %finite = scalar.constant 3.0 : f64
  %value = scf.select %all_nan, %nan, %finite : f64
  scf.for %component = [%begin to %components step %step] {
    view.store %value, %view[41, %component] : f64, view<83x[%components]xf64>
  }
  func.return
}

check.scenario @workgroup_scan_extrema_f64_values {
  check.trial[2](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(nan) : tensor<83xf64>
    %components = check.literal value(1) : index
    check.generate<@workgroup_scan_extrema_interior>(%input, %components, %trial) : (tensor<83xf64>, index, index) -> ()
    %output = check.generate.fill value(2.0) : tensor<83x16xf64>
    check.compare<@workgroup_scan_extrema_f64, @workgroup_scan_extrema_f64_oracle>(%input, %output) : (tensor<83xf64>, tensor<83x16xf64>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(0.0) rtol(0.0) nan(same) : tensor<83x16xf64>, tensor<83x16xf64>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(-0.0) : tensor<83xf64>
    %output = check.generate.fill value(2.0) : tensor<83x16xf64>
    check.compare<@workgroup_scan_extrema_f64, @workgroup_scan_extrema_f64_oracle>(%input, %output) : (tensor<83xf64>, tensor<83x16xf64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<83x16xf64>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-16.0) step(1.0) period(31) : tensor<83xf64>
    %output = check.generate.fill value(2.0) : tensor<83x16xf64>
    check.compare<@workgroup_scan_extrema_f64, @workgroup_scan_extrema_f64_oracle>(%input, %output) : (tensor<83xf64>, tensor<83x16xf64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<83x16xf64>
    }
  }
  check.return
}

check.scenario @workgroup_scan_extrema_bf16_values {
  check.trial[2](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(nan) : tensor<83x2xf64>
    %components = check.literal value(2) : index
    check.generate<@workgroup_scan_extrema_interior>(%input, %components, %trial) : (tensor<83x2xf64>, index, index) -> ()
    %output = check.generate.fill value(2.0) : tensor<83x16x2xf64>
    check.compare<@workgroup_scan_extrema_bf16, @workgroup_scan_extrema_bf16_oracle>(%input, %output) : (tensor<83x2xf64>, tensor<83x16x2xf64>) -> () {
      check.expect.approximate actual(%output) expected(%output) atol(0.0) rtol(0.0) nan(same) : tensor<83x16x2xf64>, tensor<83x16x2xf64>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(-0.0) : tensor<83x2xf64>
    %output = check.generate.fill value(2.0) : tensor<83x16x2xf64>
    check.compare<@workgroup_scan_extrema_bf16, @workgroup_scan_extrema_bf16_oracle>(%input, %output) : (tensor<83x2xf64>, tensor<83x16x2xf64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<83x16x2xf64>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-16.0) step(1.0) period(31) : tensor<83x2xf64>
    %output = check.generate.fill value(2.0) : tensor<83x16x2xf64>
    check.compare<@workgroup_scan_extrema_bf16, @workgroup_scan_extrema_bf16_oracle>(%input, %output) : (tensor<83x2xf64>, tensor<83x16x2xf64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<83x16x2xf64>
    }
  }
  check.return
}

// Independent components span multiple shared-memory batches on portable
// targets. The tail is partial in both the logical relay and physical subgroup
// partitions. All four scans reuse their scratch without caller barriers.
kernel.def @workgroup_scan_wide() {
  %unit = index.constant 1 : index
  %items = index.constant 67 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %item = kernel.workitem.id<x> : index
  %source = buffer.view %input[%base] : buffer -> view<67x8xi32>
  %destination = buffer.view %output[%base] : buffer -> view<67x4x8xi32>
  %value = vector.load %source[%item, 0] : view<67x8xi32> -> vector<8xi32>
  %forward = kernel.workgroup.scan<addi> %value {direction = forward, mode = inclusive} : vector<8xi32>
  %before = kernel.workgroup.scan<addi> %value {direction = forward, mode = exclusive} : vector<8xi32>
  %reverse = kernel.workgroup.scan<addi> %value {direction = reverse, mode = inclusive} : vector<8xi32>
  %after = kernel.workgroup.scan<addi> %value {direction = reverse, mode = exclusive} : vector<8xi32>
  vector.store %forward, %destination[%item, 0, 0] : vector<8xi32>, view<67x4x8xi32>
  vector.store %before, %destination[%item, 1, 0] : vector<8xi32>, view<67x4x8xi32>
  vector.store %reverse, %destination[%item, 2, 0] : vector<8xi32>, view<67x4x8xi32>
  vector.store %after, %destination[%item, 3, 0] : vector<8xi32>, view<67x4x8xi32>
  kernel.return
}

func.def @workgroup_scan_wide_oracle(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %unit = index.constant 1 : index
  %items = index.constant 67 : index
  %last = index.constant 66 : index
  %components = index.constant 8 : index
  %identity = scalar.constant 0 : i32
  %source = buffer.view %input[%base] : buffer -> view<67x8xi32>
  %destination = buffer.view %output[%base] : buffer -> view<67x4x8xi32>
  scf.for %component = [%begin to %components step %unit] {
    %forward_total, %reverse_total = scf.for %item = [%begin to %items step %unit](%forward = %identity : i32, %reverse = %identity : i32) -> (i32, i32) {
      %reverse_item = index.sub %last, %item : index
      %forward_value = view.load %source[%item, %component] : view<67x8xi32> -> i32
      %reverse_value = view.load %source[%reverse_item, %component] : view<67x8xi32> -> i32
      %next_forward = scalar.addi %forward, %forward_value : i32
      %next_reverse = scalar.addi %reverse, %reverse_value : i32
      view.store %next_forward, %destination[%item, 0, %component] : i32, view<67x4x8xi32>
      view.store %forward, %destination[%item, 1, %component] : i32, view<67x4x8xi32>
      view.store %next_reverse, %destination[%reverse_item, 2, %component] : i32, view<67x4x8xi32>
      view.store %reverse, %destination[%reverse_item, 3, %component] : i32, view<67x4x8xi32>
      scf.yield %next_forward, %next_reverse : i32, i32
    }
  }
  func.return
}

check.scenario @workgroup_scan_wide_values {
  check.trial[2](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-255 to 255) : tensor<67x8xi32>
    %output = check.generate.fill value(-559038737) : tensor<67x4x8xi32>
    check.compare<@workgroup_scan_wide, @workgroup_scan_wide_oracle>(%input, %output) : (tensor<67x8xi32>, tensor<67x4x8xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<67x8xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<67x4x8xi32>
    }
  }
  check.return
}

// Predicate addition is parity. Scratch uses a target-supported integer;
// exclusive endpoints and all published results stay normalized.
kernel.def @workgroup_scan_predicate() {
  %unit = index.constant 1 : index
  %items = index.constant 80 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %item = kernel.workitem.id<x> : index
  %source = buffer.view %input[%base] : buffer -> view<80xi32>
  %destination = buffer.view %output[%base] : buffer -> view<80x4xi32>
  %word = view.load %source[%item] : view<80xi32> -> i32
  %value = scalar.trunci %word : i32 to i1
  %forward = kernel.workgroup.scan<addi> %value {direction = forward, mode = inclusive} : i1
  %before = kernel.workgroup.scan<addi> %value {direction = forward, mode = exclusive} : i1
  %reverse = kernel.workgroup.scan<addi> %value {direction = reverse, mode = inclusive} : i1
  %after = kernel.workgroup.scan<addi> %value {direction = reverse, mode = exclusive} : i1
  %forward_word = scalar.extui %forward : i1 to i32
  %before_word = scalar.extui %before : i1 to i32
  %reverse_word = scalar.extui %reverse : i1 to i32
  %after_word = scalar.extui %after : i1 to i32
  view.store %forward_word, %destination[%item, 0] : i32, view<80x4xi32>
  view.store %before_word, %destination[%item, 1] : i32, view<80x4xi32>
  view.store %reverse_word, %destination[%item, 2] : i32, view<80x4xi32>
  view.store %after_word, %destination[%item, 3] : i32, view<80x4xi32>
  kernel.return
}

func.def @workgroup_scan_predicate_oracle(%input: buffer, %output: buffer) {
  func.call @workgroup_scan_i32_oracle(%input, %output) : (buffer, buffer)
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 320 : index
  %unit = index.constant 1 : index
  %mask = scalar.constant 1 : i32
  %destination = buffer.view %output[%base] : buffer -> view<320xi32>
  scf.for %position = [%begin to %end step %unit] {
    %sum = view.load %destination[%position] : view<320xi32> -> i32
    %parity = scalar.andi %sum, %mask : i32
    view.store %parity, %destination[%position] : i32, view<320xi32>
  }
  func.return
}

check.scenario @workgroup_scan_predicate_values {
  check.trial[2](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-255 to 255) : tensor<80xi32>
    %output = check.generate.fill value(-1) : tensor<80x4xi32>
    check.compare<@workgroup_scan_predicate, @workgroup_scan_predicate_oracle>(%input, %output) : (tensor<80xi32>, tensor<80x4xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<80x4xi32>
    }
  }
  check.return
}

// Eight Boolean components require multiple scratch batches; 83 workitems
// leave both logical and physical partitions partial. Every combining kind
// exercises both exclusive endpoints and both traversal directions.
kernel.def @workgroup_scan_predicate_family() {
  %unit = index.constant 1 : index
  %items = index.constant 83 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %item = kernel.workitem.id<x> : index
  %source = buffer.view %input[%base] : buffer -> view<83x8xi32>
  %destination = buffer.view %output[%base] : buffer -> view<83x4x9x8xi32>
  %words = vector.load %source[%item, 0] : view<83x8xi32> -> vector<8xi32>
  %value = vector.trunci %words : vector<8xi32> to vector<8xi1>
  %forward_inclusive_addi = kernel.workgroup.scan<addi> %value {direction = forward, mode = inclusive} : vector<8xi1>
  %forward_inclusive_addi_words = vector.extui %forward_inclusive_addi : vector<8xi1> to vector<8xi32>
  vector.store %forward_inclusive_addi_words, %destination[%item, 0, 0, 0] : vector<8xi32>, view<83x4x9x8xi32>
  %forward_inclusive_muli = kernel.workgroup.scan<muli> %value {direction = forward, mode = inclusive} : vector<8xi1>
  %forward_inclusive_muli_words = vector.extui %forward_inclusive_muli : vector<8xi1> to vector<8xi32>
  vector.store %forward_inclusive_muli_words, %destination[%item, 0, 1, 0] : vector<8xi32>, view<83x4x9x8xi32>
  %forward_inclusive_minsi = kernel.workgroup.scan<minsi> %value {direction = forward, mode = inclusive} : vector<8xi1>
  %forward_inclusive_minsi_words = vector.extui %forward_inclusive_minsi : vector<8xi1> to vector<8xi32>
  vector.store %forward_inclusive_minsi_words, %destination[%item, 0, 2, 0] : vector<8xi32>, view<83x4x9x8xi32>
  %forward_inclusive_maxsi = kernel.workgroup.scan<maxsi> %value {direction = forward, mode = inclusive} : vector<8xi1>
  %forward_inclusive_maxsi_words = vector.extui %forward_inclusive_maxsi : vector<8xi1> to vector<8xi32>
  vector.store %forward_inclusive_maxsi_words, %destination[%item, 0, 3, 0] : vector<8xi32>, view<83x4x9x8xi32>
  %forward_inclusive_minui = kernel.workgroup.scan<minui> %value {direction = forward, mode = inclusive} : vector<8xi1>
  %forward_inclusive_minui_words = vector.extui %forward_inclusive_minui : vector<8xi1> to vector<8xi32>
  vector.store %forward_inclusive_minui_words, %destination[%item, 0, 4, 0] : vector<8xi32>, view<83x4x9x8xi32>
  %forward_inclusive_maxui = kernel.workgroup.scan<maxui> %value {direction = forward, mode = inclusive} : vector<8xi1>
  %forward_inclusive_maxui_words = vector.extui %forward_inclusive_maxui : vector<8xi1> to vector<8xi32>
  vector.store %forward_inclusive_maxui_words, %destination[%item, 0, 5, 0] : vector<8xi32>, view<83x4x9x8xi32>
  %forward_inclusive_andi = kernel.workgroup.scan<andi> %value {direction = forward, mode = inclusive} : vector<8xi1>
  %forward_inclusive_andi_words = vector.extui %forward_inclusive_andi : vector<8xi1> to vector<8xi32>
  vector.store %forward_inclusive_andi_words, %destination[%item, 0, 6, 0] : vector<8xi32>, view<83x4x9x8xi32>
  %forward_inclusive_ori = kernel.workgroup.scan<ori> %value {direction = forward, mode = inclusive} : vector<8xi1>
  %forward_inclusive_ori_words = vector.extui %forward_inclusive_ori : vector<8xi1> to vector<8xi32>
  vector.store %forward_inclusive_ori_words, %destination[%item, 0, 7, 0] : vector<8xi32>, view<83x4x9x8xi32>
  %forward_inclusive_xori = kernel.workgroup.scan<xori> %value {direction = forward, mode = inclusive} : vector<8xi1>
  %forward_inclusive_xori_words = vector.extui %forward_inclusive_xori : vector<8xi1> to vector<8xi32>
  vector.store %forward_inclusive_xori_words, %destination[%item, 0, 8, 0] : vector<8xi32>, view<83x4x9x8xi32>
  %forward_exclusive_addi = kernel.workgroup.scan<addi> %value {direction = forward, mode = exclusive} : vector<8xi1>
  %forward_exclusive_addi_words = vector.extui %forward_exclusive_addi : vector<8xi1> to vector<8xi32>
  vector.store %forward_exclusive_addi_words, %destination[%item, 1, 0, 0] : vector<8xi32>, view<83x4x9x8xi32>
  %forward_exclusive_muli = kernel.workgroup.scan<muli> %value {direction = forward, mode = exclusive} : vector<8xi1>
  %forward_exclusive_muli_words = vector.extui %forward_exclusive_muli : vector<8xi1> to vector<8xi32>
  vector.store %forward_exclusive_muli_words, %destination[%item, 1, 1, 0] : vector<8xi32>, view<83x4x9x8xi32>
  %forward_exclusive_minsi = kernel.workgroup.scan<minsi> %value {direction = forward, mode = exclusive} : vector<8xi1>
  %forward_exclusive_minsi_words = vector.extui %forward_exclusive_minsi : vector<8xi1> to vector<8xi32>
  vector.store %forward_exclusive_minsi_words, %destination[%item, 1, 2, 0] : vector<8xi32>, view<83x4x9x8xi32>
  %forward_exclusive_maxsi = kernel.workgroup.scan<maxsi> %value {direction = forward, mode = exclusive} : vector<8xi1>
  %forward_exclusive_maxsi_words = vector.extui %forward_exclusive_maxsi : vector<8xi1> to vector<8xi32>
  vector.store %forward_exclusive_maxsi_words, %destination[%item, 1, 3, 0] : vector<8xi32>, view<83x4x9x8xi32>
  %forward_exclusive_minui = kernel.workgroup.scan<minui> %value {direction = forward, mode = exclusive} : vector<8xi1>
  %forward_exclusive_minui_words = vector.extui %forward_exclusive_minui : vector<8xi1> to vector<8xi32>
  vector.store %forward_exclusive_minui_words, %destination[%item, 1, 4, 0] : vector<8xi32>, view<83x4x9x8xi32>
  %forward_exclusive_maxui = kernel.workgroup.scan<maxui> %value {direction = forward, mode = exclusive} : vector<8xi1>
  %forward_exclusive_maxui_words = vector.extui %forward_exclusive_maxui : vector<8xi1> to vector<8xi32>
  vector.store %forward_exclusive_maxui_words, %destination[%item, 1, 5, 0] : vector<8xi32>, view<83x4x9x8xi32>
  %forward_exclusive_andi = kernel.workgroup.scan<andi> %value {direction = forward, mode = exclusive} : vector<8xi1>
  %forward_exclusive_andi_words = vector.extui %forward_exclusive_andi : vector<8xi1> to vector<8xi32>
  vector.store %forward_exclusive_andi_words, %destination[%item, 1, 6, 0] : vector<8xi32>, view<83x4x9x8xi32>
  %forward_exclusive_ori = kernel.workgroup.scan<ori> %value {direction = forward, mode = exclusive} : vector<8xi1>
  %forward_exclusive_ori_words = vector.extui %forward_exclusive_ori : vector<8xi1> to vector<8xi32>
  vector.store %forward_exclusive_ori_words, %destination[%item, 1, 7, 0] : vector<8xi32>, view<83x4x9x8xi32>
  %forward_exclusive_xori = kernel.workgroup.scan<xori> %value {direction = forward, mode = exclusive} : vector<8xi1>
  %forward_exclusive_xori_words = vector.extui %forward_exclusive_xori : vector<8xi1> to vector<8xi32>
  vector.store %forward_exclusive_xori_words, %destination[%item, 1, 8, 0] : vector<8xi32>, view<83x4x9x8xi32>
  %reverse_inclusive_addi = kernel.workgroup.scan<addi> %value {direction = reverse, mode = inclusive} : vector<8xi1>
  %reverse_inclusive_addi_words = vector.extui %reverse_inclusive_addi : vector<8xi1> to vector<8xi32>
  vector.store %reverse_inclusive_addi_words, %destination[%item, 2, 0, 0] : vector<8xi32>, view<83x4x9x8xi32>
  %reverse_inclusive_muli = kernel.workgroup.scan<muli> %value {direction = reverse, mode = inclusive} : vector<8xi1>
  %reverse_inclusive_muli_words = vector.extui %reverse_inclusive_muli : vector<8xi1> to vector<8xi32>
  vector.store %reverse_inclusive_muli_words, %destination[%item, 2, 1, 0] : vector<8xi32>, view<83x4x9x8xi32>
  %reverse_inclusive_minsi = kernel.workgroup.scan<minsi> %value {direction = reverse, mode = inclusive} : vector<8xi1>
  %reverse_inclusive_minsi_words = vector.extui %reverse_inclusive_minsi : vector<8xi1> to vector<8xi32>
  vector.store %reverse_inclusive_minsi_words, %destination[%item, 2, 2, 0] : vector<8xi32>, view<83x4x9x8xi32>
  %reverse_inclusive_maxsi = kernel.workgroup.scan<maxsi> %value {direction = reverse, mode = inclusive} : vector<8xi1>
  %reverse_inclusive_maxsi_words = vector.extui %reverse_inclusive_maxsi : vector<8xi1> to vector<8xi32>
  vector.store %reverse_inclusive_maxsi_words, %destination[%item, 2, 3, 0] : vector<8xi32>, view<83x4x9x8xi32>
  %reverse_inclusive_minui = kernel.workgroup.scan<minui> %value {direction = reverse, mode = inclusive} : vector<8xi1>
  %reverse_inclusive_minui_words = vector.extui %reverse_inclusive_minui : vector<8xi1> to vector<8xi32>
  vector.store %reverse_inclusive_minui_words, %destination[%item, 2, 4, 0] : vector<8xi32>, view<83x4x9x8xi32>
  %reverse_inclusive_maxui = kernel.workgroup.scan<maxui> %value {direction = reverse, mode = inclusive} : vector<8xi1>
  %reverse_inclusive_maxui_words = vector.extui %reverse_inclusive_maxui : vector<8xi1> to vector<8xi32>
  vector.store %reverse_inclusive_maxui_words, %destination[%item, 2, 5, 0] : vector<8xi32>, view<83x4x9x8xi32>
  %reverse_inclusive_andi = kernel.workgroup.scan<andi> %value {direction = reverse, mode = inclusive} : vector<8xi1>
  %reverse_inclusive_andi_words = vector.extui %reverse_inclusive_andi : vector<8xi1> to vector<8xi32>
  vector.store %reverse_inclusive_andi_words, %destination[%item, 2, 6, 0] : vector<8xi32>, view<83x4x9x8xi32>
  %reverse_inclusive_ori = kernel.workgroup.scan<ori> %value {direction = reverse, mode = inclusive} : vector<8xi1>
  %reverse_inclusive_ori_words = vector.extui %reverse_inclusive_ori : vector<8xi1> to vector<8xi32>
  vector.store %reverse_inclusive_ori_words, %destination[%item, 2, 7, 0] : vector<8xi32>, view<83x4x9x8xi32>
  %reverse_inclusive_xori = kernel.workgroup.scan<xori> %value {direction = reverse, mode = inclusive} : vector<8xi1>
  %reverse_inclusive_xori_words = vector.extui %reverse_inclusive_xori : vector<8xi1> to vector<8xi32>
  vector.store %reverse_inclusive_xori_words, %destination[%item, 2, 8, 0] : vector<8xi32>, view<83x4x9x8xi32>
  %reverse_exclusive_addi = kernel.workgroup.scan<addi> %value {direction = reverse, mode = exclusive} : vector<8xi1>
  %reverse_exclusive_addi_words = vector.extui %reverse_exclusive_addi : vector<8xi1> to vector<8xi32>
  vector.store %reverse_exclusive_addi_words, %destination[%item, 3, 0, 0] : vector<8xi32>, view<83x4x9x8xi32>
  %reverse_exclusive_muli = kernel.workgroup.scan<muli> %value {direction = reverse, mode = exclusive} : vector<8xi1>
  %reverse_exclusive_muli_words = vector.extui %reverse_exclusive_muli : vector<8xi1> to vector<8xi32>
  vector.store %reverse_exclusive_muli_words, %destination[%item, 3, 1, 0] : vector<8xi32>, view<83x4x9x8xi32>
  %reverse_exclusive_minsi = kernel.workgroup.scan<minsi> %value {direction = reverse, mode = exclusive} : vector<8xi1>
  %reverse_exclusive_minsi_words = vector.extui %reverse_exclusive_minsi : vector<8xi1> to vector<8xi32>
  vector.store %reverse_exclusive_minsi_words, %destination[%item, 3, 2, 0] : vector<8xi32>, view<83x4x9x8xi32>
  %reverse_exclusive_maxsi = kernel.workgroup.scan<maxsi> %value {direction = reverse, mode = exclusive} : vector<8xi1>
  %reverse_exclusive_maxsi_words = vector.extui %reverse_exclusive_maxsi : vector<8xi1> to vector<8xi32>
  vector.store %reverse_exclusive_maxsi_words, %destination[%item, 3, 3, 0] : vector<8xi32>, view<83x4x9x8xi32>
  %reverse_exclusive_minui = kernel.workgroup.scan<minui> %value {direction = reverse, mode = exclusive} : vector<8xi1>
  %reverse_exclusive_minui_words = vector.extui %reverse_exclusive_minui : vector<8xi1> to vector<8xi32>
  vector.store %reverse_exclusive_minui_words, %destination[%item, 3, 4, 0] : vector<8xi32>, view<83x4x9x8xi32>
  %reverse_exclusive_maxui = kernel.workgroup.scan<maxui> %value {direction = reverse, mode = exclusive} : vector<8xi1>
  %reverse_exclusive_maxui_words = vector.extui %reverse_exclusive_maxui : vector<8xi1> to vector<8xi32>
  vector.store %reverse_exclusive_maxui_words, %destination[%item, 3, 5, 0] : vector<8xi32>, view<83x4x9x8xi32>
  %reverse_exclusive_andi = kernel.workgroup.scan<andi> %value {direction = reverse, mode = exclusive} : vector<8xi1>
  %reverse_exclusive_andi_words = vector.extui %reverse_exclusive_andi : vector<8xi1> to vector<8xi32>
  vector.store %reverse_exclusive_andi_words, %destination[%item, 3, 6, 0] : vector<8xi32>, view<83x4x9x8xi32>
  %reverse_exclusive_ori = kernel.workgroup.scan<ori> %value {direction = reverse, mode = exclusive} : vector<8xi1>
  %reverse_exclusive_ori_words = vector.extui %reverse_exclusive_ori : vector<8xi1> to vector<8xi32>
  vector.store %reverse_exclusive_ori_words, %destination[%item, 3, 7, 0] : vector<8xi32>, view<83x4x9x8xi32>
  %reverse_exclusive_xori = kernel.workgroup.scan<xori> %value {direction = reverse, mode = exclusive} : vector<8xi1>
  %reverse_exclusive_xori_words = vector.extui %reverse_exclusive_xori : vector<8xi1> to vector<8xi32>
  vector.store %reverse_exclusive_xori_words, %destination[%item, 3, 8, 0] : vector<8xi32>, view<83x4x9x8xi32>
  kernel.return
}

// Boolean sum/xor is parity, product/unsigned-min/signed-max/and is all,
// and signed-min/unsigned-max/or is any. Ordinary scalar i32 operations form
// an independent serial oracle, including the empty-prefix identities.
func.def @workgroup_scan_predicate_family_oracle(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<83x8xi32>
  %destination = buffer.view %output[%base] : buffer -> view<83x4x9x8xi32>
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %directions = index.constant 2 : index
  %components = index.constant 8 : index
  %items = index.constant 83 : index
  %last = index.constant 82 : index
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  scf.for %component = [%begin to %components step %step] {
    scf.for %direction = [%begin to %directions step %step] {
      %reverse = index.cmp ne, %direction, %begin : index
      %inclusive = index.mul %direction, %directions : index
      %exclusive = index.add %inclusive, %step : index
      %total_parity, %total_all, %total_any = scf.for %position = [%begin to %items step %step](%parity = %c0 : i32, %all = %c1 : i32, %any = %c0 : i32) -> (i32, i32, i32) {
        %reverse_item = index.sub %last, %position : index
        %item = scf.select %reverse, %reverse_item, %position : index
        %word = view.load %source[%item, %component] : view<83x8xi32> -> i32
        %value = scalar.andi %word, %c1 : i32
        %next_parity = scalar.xori %parity, %value : i32
        %next_all = scalar.andi %all, %value : i32
        %next_any = scalar.ori %any, %value : i32
        view.store %next_parity, %destination[%item, %inclusive, 0, %component] : i32, view<83x4x9x8xi32>
        view.store %next_all, %destination[%item, %inclusive, 1, %component] : i32, view<83x4x9x8xi32>
        view.store %next_any, %destination[%item, %inclusive, 2, %component] : i32, view<83x4x9x8xi32>
        view.store %next_all, %destination[%item, %inclusive, 3, %component] : i32, view<83x4x9x8xi32>
        view.store %next_all, %destination[%item, %inclusive, 4, %component] : i32, view<83x4x9x8xi32>
        view.store %next_any, %destination[%item, %inclusive, 5, %component] : i32, view<83x4x9x8xi32>
        view.store %next_all, %destination[%item, %inclusive, 6, %component] : i32, view<83x4x9x8xi32>
        view.store %next_any, %destination[%item, %inclusive, 7, %component] : i32, view<83x4x9x8xi32>
        view.store %next_parity, %destination[%item, %inclusive, 8, %component] : i32, view<83x4x9x8xi32>
        view.store %parity, %destination[%item, %exclusive, 0, %component] : i32, view<83x4x9x8xi32>
        view.store %all, %destination[%item, %exclusive, 1, %component] : i32, view<83x4x9x8xi32>
        view.store %any, %destination[%item, %exclusive, 2, %component] : i32, view<83x4x9x8xi32>
        view.store %all, %destination[%item, %exclusive, 3, %component] : i32, view<83x4x9x8xi32>
        view.store %all, %destination[%item, %exclusive, 4, %component] : i32, view<83x4x9x8xi32>
        view.store %any, %destination[%item, %exclusive, 5, %component] : i32, view<83x4x9x8xi32>
        view.store %all, %destination[%item, %exclusive, 6, %component] : i32, view<83x4x9x8xi32>
        view.store %any, %destination[%item, %exclusive, 7, %component] : i32, view<83x4x9x8xi32>
        view.store %parity, %destination[%item, %exclusive, 8, %component] : i32, view<83x4x9x8xi32>
        scf.yield %next_parity, %next_all, %next_any : i32, i32, i32
      }
    }
  }
  func.return
}

check.scenario @workgroup_scan_predicate_family_values {
  check.trial[2](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-255 to 255) : tensor<83x8xi32>
    %output = check.generate.fill value(-1) : tensor<83x4x9x8xi32>
    check.compare<@workgroup_scan_predicate_family, @workgroup_scan_predicate_family_oracle>(%input, %output) : (tensor<83x8xi32>, tensor<83x4x9x8xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<83x4x9x8xi32>
    }
  }
  check.return
}
