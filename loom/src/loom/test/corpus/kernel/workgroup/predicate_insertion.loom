// Every work-item has its own source mask, replacement and insertion position.
// Two complementary active sets cover all cases through divergent control flow;
// 132 work-items also leave a partial final wave on wave32 and wave64 targets.

func.def device inline @store_predicate_mask(%mask: vector<4xi1>, %position: index, %output: buffer) {
  %base = index.constant 0 : offset
  %destination = buffer.view %output[%base] : buffer -> view<2112xi32>
  %true_words = vector.splati -1431655766 : vector<4xi32>
  %false_words = vector.splati 1431655765 : vector<4xi32>
  %words = vector.select %mask, %true_words, %false_words : vector<4xi32>
  vector.store %words, %destination[%position] : vector<4xi32>, view<2112xi32>
  func.return
}

kernel.def @workitem_predicate_insertion() {
  %unit = index.constant 1 : index
  %items = index.constant 132 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%active_parity: index, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %item = kernel.workitem.id<x> : index
  %source_view = buffer.view %input[%base] : buffer -> view<132xi32>
  %case = view.load %source_view[%item] : view<132xi32> -> i32
  %c0 = scalar.constant 0 : i32
  %c3 = scalar.constant 3 : i32
  %c4 = scalar.constant 4 : i32
  %c8 = scalar.constant 8 : i32
  %c16 = scalar.constant 16 : i32
  %c32 = scalar.constant 32 : i32
  %c64 = scalar.constant 64 : i32
  %lane_bits = scalar.andi %case, %c3 : i32
  %lane = index.cast %lane_bits : i32 to index
  %replacement_bits = scalar.andi %case, %c4 : i32
  %replacement = scalar.cmpi ne, %replacement_bits, %c0 : i32
  %words = vector.splat %case : vector<4xi32>
  %bit_positions = vector.from_elements %c8, %c16, %c32, %c64 : vector<4xi32>
  %bits = vector.andi %words, %bit_positions : vector<4xi32>
  %zeros = vector.splat %c0 : vector<4xi32>
  %source = vector.cmpi ne, %bits, %zeros : vector<4xi32> -> vector<4xi1>
  %c1_index = index.constant 1 : index
  %parity = index.andi %item, %c1_index : index
  %active = index.cmp eq, %parity, %active_parity : index
  scf.if %active {
    %dynamic = vector.insert %replacement into %source[%lane] : i1, vector<4xi1>
    %fixed = vector.insert %replacement into %source[1] : i1, vector<4xi1>
    %true = scalar.constant true : i1
    %false = scalar.constant false : i1
    %set = vector.insert %true into %source[%lane] : i1, vector<4xi1>
    %cleared = vector.insert %false into %source[%lane] : i1, vector<4xi1>
    %fields = index.constant 16 : index
    %packet = index.constant 4 : index
    %dynamic_position = index.mul %item, %fields : index
    %fixed_position = index.add %dynamic_position, %packet : index
    %set_position = index.add %fixed_position, %packet : index
    %cleared_position = index.add %set_position, %packet : index
    func.call @store_predicate_mask(%dynamic, %dynamic_position, %output) : (vector<4xi1>, index, buffer)
    func.call @store_predicate_mask(%fixed, %fixed_position, %output) : (vector<4xi1>, index, buffer)
    func.call @store_predicate_mask(%set, %set_position, %output) : (vector<4xi1>, index, buffer)
    func.call @store_predicate_mask(%cleared, %cleared_position, %output) : (vector<4xi1>, index, buffer)
  }
  kernel.return
}

// The oracle addresses scalar output words and updates integer source bits;
// it has no predicate vector, lane insertion or hardware-mask representation.
func.def @workitem_predicate_insertion_oracle(%active_parity: index, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source_view = buffer.view %input[%base] : buffer -> view<132xi32>
  %destination = buffer.view %output[%base] : buffer -> view<2112xi32>
  %begin = index.constant 0 : index
  %end = index.constant 132 : index
  %step = index.constant 1 : index
  %packet = index.constant 4 : index
  %fields = index.constant 16 : index
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %c3 = scalar.constant 3 : i32
  %c4 = scalar.constant 4 : i32
  %true = scalar.constant true : i1
  %true_word = scalar.constant -1431655766 : i32
  %false_word = scalar.constant 1431655765 : i32
  scf.for %item = [%begin to %end step %step] {
    %parity = index.andi %item, %step : index
    %active = index.cmp eq, %parity, %active_parity : index
    scf.if %active {
      %case = view.load %source_view[%item] : view<132xi32> -> i32
      %lane_bits = scalar.andi %case, %c3 : i32
      %insertion_lane = index.cast %lane_bits : i32 to index
      %replacement_bits = scalar.andi %case, %c4 : i32
      %replacement = scalar.cmpi ne, %replacement_bits, %c0 : i32
      %source_bits = scalar.shrui %case, %c3 : i32
      %item_position = index.mul %item, %fields : index
      scf.for %lane = [%begin to %packet step %step] {
        %shift = index.cast %lane : index to i32
        %shifted = scalar.shrui %source_bits, %shift : i32
        %bit = scalar.andi %shifted, %c1 : i32
        %source = scalar.cmpi ne, %bit, %c0 : i32
        %is_dynamic = index.cmp eq, %lane, %insertion_lane : index
        %is_fixed = index.cmp eq, %lane, %step : index
        %dynamic = scf.select %is_dynamic, %replacement, %source : i1
        %fixed = scf.select %is_fixed, %replacement, %source : i1
        %set = scalar.ori %source, %is_dynamic : i1
        %not_inserted = scalar.xori %is_dynamic, %true : i1
        %cleared = scalar.andi %source, %not_inserted : i1
        %dynamic_word = scf.select %dynamic, %true_word, %false_word : i32
        %fixed_word = scf.select %fixed, %true_word, %false_word : i32
        %set_word = scf.select %set, %true_word, %false_word : i32
        %cleared_word = scf.select %cleared, %true_word, %false_word : i32
        %dynamic_position = index.add %item_position, %lane : index
        %fixed_position = index.add %dynamic_position, %packet : index
        %set_position = index.add %fixed_position, %packet : index
        %cleared_position = index.add %set_position, %packet : index
        view.store %dynamic_word, %destination[%dynamic_position] : i32, view<2112xi32>
        view.store %fixed_word, %destination[%fixed_position] : i32, view<2112xi32>
        view.store %set_word, %destination[%set_position] : i32, view<2112xi32>
        view.store %cleared_word, %destination[%cleared_position] : i32, view<2112xi32>
      }
    }
  }
  func.return
}

check.scenario @workitem_predicate_insertion_values {
  check.trial[2](%parity: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(0) step(1) : tensor<132xi32>
    %storage = check.generate.fill value(123) : tensor<2144xi32>
    %output = check.tensor.view %storage offset(64) : tensor<2144xi32> -> tensor<2112xi32>
    check.compare<@workitem_predicate_insertion, @workitem_predicate_insertion_oracle>(%parity, %input, %output) : (index, tensor<132xi32>, tensor<2112xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<132xi32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<2144xi32>
    }
  }
  check.return
}

// Exercise all positions of a 32-lane predicate vector with independent source
// bits. Each work-item replaces a different logical lane, including both ends.
kernel.def @wide_predicate_insertion() {
  %unit = index.constant 1 : index
  %items = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%items, %unit, %unit) : index
} launch(%replacement_parity: index, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %item = kernel.workitem.id<x> : index
  %width = index.constant 32 : index
  %position = index.mul %item, %width : index
  %source_view = buffer.view %input[%base] : buffer -> view<1024xi32>
  %destination = buffer.view %output[%base] : buffer -> view<1024xi32>
  %words = vector.load %source_view[%position] : view<1024xi32> -> vector<32xi32>
  %sign_boundary = vector.splati 0 : vector<32xi32>
  %source = vector.cmpi slt, %words, %sign_boundary : vector<32xi32> -> vector<32xi1>
  %c1 = index.constant 1 : index
  %parity = index.andi %item, %c1 : index
  %replacement = index.cmp eq, %parity, %replacement_parity : index
  %inserted = vector.insert %replacement into %source[%item] : i1, vector<32xi1>
  %true_words = vector.splati -1431655766 : vector<32xi32>
  %false_words = vector.splati 1431655765 : vector<32xi32>
  %result = vector.select %inserted, %true_words, %false_words : vector<32xi32>
  vector.store %result, %destination[%position] : vector<32xi32>, view<1024xi32>
  kernel.return
}

func.def @wide_predicate_insertion_oracle(%replacement_parity: index, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source_view = buffer.view %input[%base] : buffer -> view<1024xi32>
  %destination = buffer.view %output[%base] : buffer -> view<1024xi32>
  %begin = index.constant 0 : index
  %end = index.constant 32 : index
  %step = index.constant 1 : index
  %c0 = scalar.constant 0 : i32
  %true_word = scalar.constant -1431655766 : i32
  %false_word = scalar.constant 1431655765 : i32
  scf.for %item = [%begin to %end step %step] {
    %parity = index.andi %item, %step : index
    %replacement = index.cmp eq, %parity, %replacement_parity : index
    %item_position = index.mul %item, %end : index
    scf.for %lane = [%begin to %end step %step] {
      %position = index.add %item_position, %lane : index
      %word = view.load %source_view[%position] : view<1024xi32> -> i32
      %source = scalar.cmpi slt, %word, %c0 : i32
      %is_inserted = index.cmp eq, %lane, %item : index
      %inserted = scf.select %is_inserted, %replacement, %source : i1
      %result = scf.select %inserted, %true_word, %false_word : i32
      view.store %result, %destination[%position] : i32, view<1024xi32>
    }
  }
  func.return
}

check.scenario @wide_predicate_insertion_values {
  check.trial[2](%parity: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%parity] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-2147483648 to 2147483647) : tensor<1024xi32>
    %storage = check.generate.fill value(123) : tensor<1056xi32>
    %output = check.tensor.view %storage offset(64) : tensor<1056xi32> -> tensor<1024xi32>
    check.compare<@wide_predicate_insertion, @wide_predicate_insertion_oracle>(%parity, %input, %output) : (index, tensor<1024xi32>, tensor<1024xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<1024xi32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<1056xi32>
    }
  }
  check.return
}
