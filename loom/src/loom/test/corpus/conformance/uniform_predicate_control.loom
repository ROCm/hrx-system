}

check.case public @uniform_predicate_control_upper_half {
  %start = check.literal value(32) : index
  %end = check.literal value(64) : index
  %rounds = check.literal value(2) : index
  %mode = check.literal value(5) : i32
  %input = check.generate.iota offset(-2) step(3) : tensor<32xi32>
  %actual = check.generate.fill value(-12345) : tensor<64xi32>
  kernel.launch @uniform_predicate_control(%start, %end, %rounds, %mode, %input, %actual) : (index, index, index, i32, tensor<32xi32>, tensor<64xi32>)
  %prefix = check.tensor.view %actual offset(0) : tensor<64xi32> -> tensor<32xi32>
  %expected_prefix = check.generate.iota offset(-700) step(0) : tensor<32xi32>
  check.expect.equal actual(%prefix) expected(%expected_prefix) : tensor<32xi32>
  %active = check.tensor.view %actual offset(128) : tensor<64xi32> -> tensor<32xi32>
  %expected_active = check.generate.iota offset(60) step(8) : tensor<32xi32>
  check.expect.equal actual(%active) expected(%expected_active) : tensor<32xi32>
  check.return
}

check.case public @uniform_predicate_control_full {
  %start = check.literal value(0) : index
  %end = check.literal value(64) : index
  %rounds = check.literal value(3) : index
  %mode = check.literal value(2) : i32
  %input = check.generate.iota offset(-2) step(3) : tensor<64xi32>
  %actual = check.generate.fill value(-12345) : tensor<64xi32>
  kernel.launch @uniform_predicate_control(%start, %end, %rounds, %mode, %input, %actual) : (index, index, index, i32, tensor<64xi32>, tensor<64xi32>)
  %active = check.tensor.view %actual offset(0) : tensor<64xi32> -> tensor<64xi32>
  %expected_active = check.generate.iota offset(-7) step(8) : tensor<64xi32>
  check.expect.equal actual(%active) expected(%expected_active) : tensor<64xi32>
  check.return
}
