  %prefix = check.tensor.view %actual offset(0) : tensor<64xi32> -> tensor<17xi32>
  %expected_prefix = check.generate.iota offset(-700) step(0) : tensor<17xi32>
  check.expect.equal actual(%prefix) expected(%expected_prefix) : tensor<17xi32>
  %active = check.tensor.view %actual offset(68) : tensor<64xi32> -> tensor<36xi32>
  %expected_active = check.generate.iota offset(-15) step(0) : tensor<36xi32>
  check.expect.equal actual(%active) expected(%expected_active) : tensor<36xi32>
  %suffix = check.tensor.view %actual offset(212) : tensor<64xi32> -> tensor<11xi32>
  %expected_suffix = check.generate.iota offset(-700) step(0) : tensor<11xi32>
  check.expect.equal actual(%suffix) expected(%expected_suffix) : tensor<11xi32>
  check.return
}

check.case public @uniform_predicate_control_mixed {
  %start = check.literal value(17) : index
  %end = check.literal value(53) : index
  %rounds = check.literal value(5) : index
  %mode = check.literal value(3) : i32
  %input = check.generate.iota offset(-2) step(3) : tensor<36xi32>
  %actual = check.generate.fill value(-12345) : tensor<64xi32>
  kernel.launch @uniform_predicate_control(%start, %end, %rounds, %mode, %input, %actual) : (index, index, index, i32, tensor<36xi32>, tensor<64xi32>)
  %prefix = check.tensor.view %actual offset(0) : tensor<64xi32> -> tensor<17xi32>
  %expected_prefix = check.generate.iota offset(-700) step(0) : tensor<17xi32>
  check.expect.equal actual(%prefix) expected(%expected_prefix) : tensor<17xi32>
  %active = check.tensor.view %actual offset(68) : tensor<64xi32> -> tensor<36xi32>
  %expected_active = check.generate.iota offset(39) step(12) : tensor<36xi32>
  check.expect.equal actual(%active) expected(%expected_active) : tensor<36xi32>
  %suffix = check.tensor.view %actual offset(212) : tensor<64xi32> -> tensor<11xi32>
  %expected_suffix = check.generate.iota offset(-700) step(0) : tensor<11xi32>
  check.expect.equal actual(%suffix) expected(%expected_suffix) : tensor<11xi32>
