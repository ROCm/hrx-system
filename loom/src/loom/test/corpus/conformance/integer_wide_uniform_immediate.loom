check.case public @uniform_i64_add_negative_immediate_wrap {
  %input = check.literal value(-9223372036854775680) : i64
  %output = check.generate.fill value(99) : tensor<1xi64>
  %expected = check.generate.fill value(9223372036854775680) : tensor<1xi64>
  kernel.launch @uniform_i64_add_negative_immediate(%input, %output) : (i64, tensor<1xi64>)
  check.expect.equal actual(%output) expected(%expected) : tensor<1xi64>
