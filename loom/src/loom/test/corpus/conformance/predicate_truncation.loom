// Runtime inputs separate low-bit truncation from nonzero truth conversion.
// The complete byte domain and wider high-bit patterns remain unknown while
// the subject is compiled. Scalar arguments exercise the uniform bank too.
func.def @truncate_integer_predicates(%input8: buffer, %input16: buffer, %input32: buffer, %input64: buffer, %ordinal: index, %uniform64: i64, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 256 : index
  %step = index.constant 1 : index
  %true = scalar.constant 37 : i32
  %false = scalar.constant -29 : i32
  %values8 = buffer.view %input8[%base] : buffer -> view<256xi8>
  %values16 = buffer.view %input16[%base] : buffer -> view<256xi16>
  %values32 = buffer.view %input32[%base] : buffer -> view<256xi32>
  %values64 = buffer.view %input64[%base] : buffer -> view<256xi64>
  %outputs = buffer.view %output[%base] : buffer -> view<258x4xi32>
  scf.for %i = [%begin to %end step %step] {
    %value8 = view.load %values8[%i] : view<256xi8> -> i8
    %predicate8 = scalar.trunci %value8 : i8 to i1
    %selected8 = scf.select %predicate8, %true, %false : i32
    view.store %selected8, %outputs[%i, 0] : i32, view<258x4xi32>
    %value16 = view.load %values16[%i] : view<256xi16> -> i16
    %predicate16 = scalar.trunci %value16 : i16 to i1
    %selected16 = scf.select %predicate16, %true, %false : i32
    view.store %selected16, %outputs[%i, 1] : i32, view<258x4xi32>
    %value32 = view.load %values32[%i] : view<256xi32> -> i32
    %predicate32 = scalar.trunci %value32 : i32 to i1
    %selected32 = scf.select %predicate32, %true, %false : i32
    view.store %selected32, %outputs[%i, 2] : i32, view<258x4xi32>
    %value64 = view.load %values64[%i] : view<256xi64> -> i64
    %predicate64 = scalar.trunci %value64 : i64 to i1
    %selected64 = scf.select %predicate64, %true, %false : i32
    view.store %selected64, %outputs[%i, 3] : i32, view<258x4xi32>
  }
  %ordinal32 = index.cast %ordinal : index to i32
  %high = scalar.constant -2147483648 : i32
  %uniform32 = scalar.ori %ordinal32, %high : i32
  %predicate32 = scalar.trunci %uniform32 : i32 to i1
  %selected32 = scf.select %predicate32, %true, %false : i32
  view.store %selected32, %outputs[256, 0] : i32, view<258x4xi32>
  %predicate64 = scalar.trunci %uniform64 : i64 to i1
  %selected64 = scf.select %predicate64, %true, %false : i32
  view.store %selected64, %outputs[256, 1] : i32, view<258x4xi32>
  func.return
}

check.scenario @integer_low_bits {
  check.trial[4](%trial: index, %entropy: check.entropy) {
    %input8 = check.generate.iota offset(-128) step(1) : tensor<256xi8>
    %input16 = check.generate.iota offset(-32768) step(257) : tensor<256xi16>
    %input32 = check.generate.iota offset(-2147483648) step(16843009) : tensor<256xi32>
    %input64 = check.generate.iota offset(-4294967424) step(33554433) : tensor<256xi64>
    %uniform64 = check.entropy.read %entropy[0] : check.entropy -> i64
    %output = check.generate.fill value(-123) : tensor<258x4xi32>
    check.compare<@truncate_integer_predicates>(%input8, %input16, %input32, %input64, %trial, %uniform64, %output) : (tensor<256xi8>, tensor<256xi16>, tensor<256xi32>, tensor<256xi64>, index, i64, tensor<258x4xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<258x4xi32>
    }
  }
  check.return
}
