  %actual = check.tensor.view %output offset(88) : tensor<56xi32> -> tensor<4xi32>
  %expected = check.generate.iota offset(131) step(1) : tensor<4xi32>
  check.expect.bitwise actual(%actual) expected(%expected) : tensor<4xi32>
  %prefix = check.tensor.view %output offset(0) : tensor<56xi32> -> tensor<22xi32>
  %prefix_expected = check.generate.fill value(-99) : tensor<22xi32>
  check.expect.bitwise actual(%prefix) expected(%prefix_expected) : tensor<22xi32>
  %suffix = check.tensor.view %output offset(104) : tensor<56xi32> -> tensor<30xi32>
  %suffix_expected = check.generate.fill value(-99) : tensor<30xi32>
  check.expect.bitwise actual(%suffix) expected(%suffix_expected) : tensor<30xi32>
  check.expect.bitwise actual(%input) expected(%input_expected) : tensor<56xi32>
  check.expect.event<device> {count = 0, type = "asan_report"}
  check.return
}

