kernel.def @subview_atomic_origins() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 8 : offset
  %output_base = index.constant 0 : offset
  %aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %layout = encoding.layout.strided [8, 1] : encoding<layout>
  %view = buffer.view %aligned[%base] : buffer -> view<4x8xi32, %layout>
  %crop = view.subview %view[1, 2] : view<4x8xi32, %layout> -> view<2x3xi32, %layout>
  %increment = scalar.constant 1 : i32
  view.atomic.reduce<addi> %increment, %crop[1, 1] {ordering = relaxed, scope = device} : i32, view<2x3xi32, %layout>
  %old = view.atomic.rmw<addi> %increment, %crop[1, 1] {ordering = relaxed, scope = device} : i32, view<2x3xi32, %layout> -> i32
  %expected = scalar.addi %old, %increment : i32
  %replacement = scalar.constant 99 : i32
  %observed = view.atomic.cmpxchg %expected, %replacement, %crop[1, 1] {failure_ordering = relaxed, scope = device, success_ordering = relaxed} : i32, view<2x3xi32, %layout> -> i32
  %results = buffer.view %output[%output_base] : buffer -> view<2xi32>
  view.store %old, %results[0] : i32, view<2xi32>
  view.store %observed, %results[1] : i32, view<2xi32>
  kernel.return
}

check.case public @subview_atomic_returns_and_guards {
  %input = check.generate.iota offset(100) step(1) : tensor<36xi32>
  %output = check.generate.fill value(-99) : tensor<2xi32>
  kernel.launch @subview_atomic_origins(%input, %output) : (tensor<36xi32>, tensor<2xi32>)
  %expected = check.generate.iota offset(122) step(1) : tensor<2xi32>
  check.expect.bitwise actual(%output) expected(%expected) : tensor<2xi32>
  %changed = check.tensor.view %input offset(84) : tensor<36xi32> -> tensor<1xi32>
  %replacement = check.generate.fill value(99) : tensor<1xi32>
  check.expect.bitwise actual(%changed) expected(%replacement) : tensor<1xi32>
  %prefix = check.tensor.view %input offset(0) : tensor<36xi32> -> tensor<21xi32>
  %prefix_expected = check.generate.iota offset(100) step(1) : tensor<21xi32>
  check.expect.bitwise actual(%prefix) expected(%prefix_expected) : tensor<21xi32>
  %suffix = check.tensor.view %input offset(88) : tensor<36xi32> -> tensor<14xi32>
  %suffix_expected = check.generate.iota offset(122) step(1) : tensor<14xi32>
  check.expect.bitwise actual(%suffix) expected(%suffix_expected) : tensor<14xi32>
  check.expect.event<device> {count = 0, type = "asan_report"}
  check.return
}

kernel.def @subview_vector_aligned() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %input_base = index.constant 32 : offset
  %output_base = index.constant 64 : offset
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 32} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 32} : buffer
  %layout = encoding.layout.strided [24, 1] : encoding<layout>
  %source = buffer.view %input_aligned[%input_base] : buffer -> view<4x24xi32, %layout>
  %destination = buffer.view %output_aligned[%output_base] : buffer -> view<4x24xi32, %layout>
  %source_crop = view.subview %source[1, 8] : view<4x24xi32, %layout> -> view<2x8xi32, %layout>
  %destination_crop = view.subview %destination[1, 0] : view<4x24xi32, %layout> -> view<2x16xi32, %layout>
  %value = vector.load %source_crop[1, 0] : view<2x8xi32, %layout> -> vector<8xi32>
  vector.store %value, %destination_crop[0, 8] : vector<8xi32>, view<2x16xi32, %layout>
  kernel.return
}

// Source words 8 + (1 + 1) * 24 + 8 = 64 through 71.
// Destination words 16 + 1 * 24 + 8 = 48 through 55.
check.case public @subview_vector_aligned_guards {
  %input = check.generate.iota offset(100) step(1) : tensor<112xi32>
  %input_expected = check.generate.iota offset(100) step(1) : tensor<112xi32>
  %output = check.generate.fill value(-99) : tensor<112xi32>
  kernel.launch @subview_vector_aligned(%input, %output) : (tensor<112xi32>, tensor<112xi32>)
  %actual = check.tensor.view %output offset(192) : tensor<112xi32> -> tensor<8xi32>
  %expected = check.generate.iota offset(164) step(1) : tensor<8xi32>
  check.expect.bitwise actual(%actual) expected(%expected) : tensor<8xi32>
  %prefix = check.tensor.view %output offset(0) : tensor<112xi32> -> tensor<48xi32>
  %prefix_expected = check.generate.fill value(-99) : tensor<48xi32>
  check.expect.bitwise actual(%prefix) expected(%prefix_expected) : tensor<48xi32>
  %suffix = check.tensor.view %output offset(224) : tensor<112xi32> -> tensor<56xi32>
  %suffix_expected = check.generate.fill value(-99) : tensor<56xi32>
  check.expect.bitwise actual(%suffix) expected(%suffix_expected) : tensor<56xi32>
  check.expect.bitwise actual(%input) expected(%input_expected) : tensor<112xi32>
  check.expect.event<device> {count = 0, type = "asan_report"}
  check.return
}
