load("//loom/build_tools/bazel:defs.bzl", "loom_module")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_CASES = glob(["*.loom"])

exports_files(_CASES)

loom_module(
    name = "conformance_cases",
    srcs = _CASES,
    output_format = "bc",
)
