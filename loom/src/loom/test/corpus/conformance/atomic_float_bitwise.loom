// Exchange and CAS preserve payload bits and return the previous representation.
kernel.def @global_atomic_bitwise_f32() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %initial_bits: i32, %replacement_bits: i32) {
  %base = index.constant 0 : offset
  %storage = buffer.assume.memory_space<global> %input : buffer
  %cell = buffer.view %storage[%base] : buffer -> view<1xf32>
  %results = buffer.view %output[%base] : buffer -> view<4xi32>
  %initial = scalar.bitcast %initial_bits : i32 to f32
  %replacement = scalar.bitcast %replacement_bits : i32 to f32
  %exchanged = view.atomic.rmw<xchgf> %replacement, %cell[0] {ordering = acq_rel, scope = system} : f32, view<1xf32> -> f32
  %succeeded = view.atomic.cmpxchg %replacement, %initial, %cell[0] {failure_ordering = acquire, scope = system, success_ordering = acq_rel} : f32, view<1xf32> -> f32
  %failed = view.atomic.cmpxchg %replacement, %replacement, %cell[0] {failure_ordering = seq_cst, scope = system, success_ordering = seq_cst} : f32, view<1xf32> -> f32
  %final = view.load %cell[0] : view<1xf32> -> f32
  %exchanged_bits = scalar.bitcast %exchanged : f32 to i32
  %succeeded_bits = scalar.bitcast %succeeded : f32 to i32
  %failed_bits = scalar.bitcast %failed : f32 to i32
  %final_bits = scalar.bitcast %final : f32 to i32
  view.store %exchanged_bits, %results[0] : i32, view<4xi32>
  view.store %succeeded_bits, %results[1] : i32, view<4xi32>
  view.store %failed_bits, %results[2] : i32, view<4xi32>
  view.store %final_bits, %results[3] : i32, view<4xi32>
  kernel.return
}

