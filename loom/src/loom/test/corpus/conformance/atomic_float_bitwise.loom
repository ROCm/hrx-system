// NaN payloads, opposite signed zeros, and subnormals remain raw bits.
check.case public @atomic_bitwise_f32_nan_payload {
  %initial = check.literal value(2139169605) : i32
  %replacement = check.literal value(2143634209) : i32
  %expected_initial = check.generate.fill value(2139169605) : tensor<1xi32>
  %expected_replacement = check.generate.fill value(2143634209) : tensor<1xi32>
  %global_cell = check.generate.fill value(2139169605) : tensor<1xi32>
  %global_output = check.generate.fill value(0) : tensor<4xi32>
  kernel.launch @global_atomic_bitwise_f32(%global_cell, %global_output, %initial, %replacement) : (tensor<1xi32>, tensor<4xi32>, i32, i32)
  %global_0 = check.tensor.view %global_output offset(0) : tensor<4xi32> -> tensor<1xi32>
  check.expect.bitwise actual(%global_0) expected(%expected_initial) : tensor<1xi32>
  %global_1 = check.tensor.view %global_output offset(4) : tensor<4xi32> -> tensor<1xi32>
  check.expect.bitwise actual(%global_1) expected(%expected_replacement) : tensor<1xi32>
  %global_2 = check.tensor.view %global_output offset(8) : tensor<4xi32> -> tensor<1xi32>
  check.expect.bitwise actual(%global_2) expected(%expected_initial) : tensor<1xi32>
  %global_3 = check.tensor.view %global_output offset(12) : tensor<4xi32> -> tensor<1xi32>
  check.expect.bitwise actual(%global_3) expected(%expected_initial) : tensor<1xi32>
  %generic_cell = check.generate.fill value(2139169605) : tensor<1xi32>
  %generic_output = check.generate.fill value(0) : tensor<3xi32>
  kernel.launch @generic_atomic_bitwise_f32(%generic_cell, %generic_output, %initial, %replacement) : (tensor<1xi32>, tensor<3xi32>, i32, i32)
  %generic_0 = check.tensor.view %generic_output offset(0) : tensor<3xi32> -> tensor<1xi32>
  check.expect.bitwise actual(%generic_0) expected(%expected_initial) : tensor<1xi32>
  %generic_1 = check.tensor.view %generic_output offset(4) : tensor<3xi32> -> tensor<1xi32>
  check.expect.bitwise actual(%generic_1) expected(%expected_replacement) : tensor<1xi32>
  %generic_2 = check.tensor.view %generic_output offset(8) : tensor<3xi32> -> tensor<1xi32>
  check.expect.bitwise actual(%generic_2) expected(%expected_initial) : tensor<1xi32>
  check.expect.bitwise actual(%generic_cell) expected(%expected_initial) : tensor<1xi32>
  %workgroup_output = check.generate.fill value(0) : tensor<4xi32>
  kernel.launch @workgroup_atomic_bitwise_f32(%workgroup_output, %initial, %replacement) : (tensor<4xi32>, i32, i32)
  %workgroup_0 = check.tensor.view %workgroup_output offset(0) : tensor<4xi32> -> tensor<1xi32>
  check.expect.bitwise actual(%workgroup_0) expected(%expected_initial) : tensor<1xi32>
  %workgroup_1 = check.tensor.view %workgroup_output offset(4) : tensor<4xi32> -> tensor<1xi32>
  check.expect.bitwise actual(%workgroup_1) expected(%expected_replacement) : tensor<1xi32>
  %workgroup_2 = check.tensor.view %workgroup_output offset(8) : tensor<4xi32> -> tensor<1xi32>
  check.expect.bitwise actual(%workgroup_2) expected(%expected_initial) : tensor<1xi32>
  %workgroup_3 = check.tensor.view %workgroup_output offset(12) : tensor<4xi32> -> tensor<1xi32>
  check.expect.bitwise actual(%workgroup_3) expected(%expected_initial) : tensor<1xi32>
  check.return
}

