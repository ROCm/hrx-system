  %exchanged = view.atomic.rmw<xchgf> %replacement, %cell[0] {ordering = acq_rel, scope = workgroup} : f32, view<1xf32> -> f32
  %succeeded = view.atomic.cmpxchg %replacement, %initial, %cell[0] {failure_ordering = acquire, scope = workgroup, success_ordering = acq_rel} : f32, view<1xf32> -> f32
  %failed = view.atomic.cmpxchg %replacement, %replacement, %cell[0] {failure_ordering = seq_cst, scope = workgroup, success_ordering = seq_cst} : f32, view<1xf32> -> f32
  %final = view.load %cell[0] : view<1xf32> -> f32
