// Each lane is an independent atomic; inactive exchange lanes keep passthrough.
kernel.def @vector_atomic_bitwise_f32() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %initial_bits: i32, %replacement_bits: i32, %flag: i32) {
  %base = index.constant 0 : offset
  %global = buffer.assume.memory_space<global> %input : buffer
  %cells = buffer.view %global[%base] : buffer -> view<2xf32>
  %results = buffer.view %output[%base] : buffer -> view<6xf32>
  %initial_scalar = scalar.bitcast %initial_bits : i32 to f32
  %replacement_scalar = scalar.bitcast %replacement_bits : i32 to f32
  %initial = vector.from_elements %initial_scalar, %initial_scalar : vector<2xf32>
  %replacement = vector.from_elements %replacement_scalar, %replacement_scalar : vector<2xf32>
  %origin = index.constant 0 : index
  %stride = index.constant 1 : index
  %offsets = vector.iota %origin step %stride : vector<2xindex>
  %c0 = scalar.constant 0 : i32
  %enabled = scalar.cmpi ne, %flag, %c0 : i32
  %disabled = scalar.constant false : i1
  %mask = vector.from_elements %enabled, %disabled : vector<2xi1>
  %exchanged = vector.atomic.rmw.mask<xchgf> %replacement, %cells[0][%offsets], %mask, %replacement {ordering = acq_rel, scope = device} : vector<2xf32>, view<2xf32>, vector<2xindex>, vector<2xi1>, vector<2xf32>
  %observed = vector.atomic.cmpxchg %replacement, %initial, %cells[0][%offsets] {failure_ordering = acquire, scope = device, success_ordering = acq_rel} : vector<2xf32>, view<2xf32>, vector<2xindex> -> vector<2xf32>
  %final = vector.load %cells[0] : view<2xf32> -> vector<2xf32>
  vector.store %exchanged, %results[0] : vector<2xf32>, view<6xf32>
  vector.store %observed, %results[2] : vector<2xf32>, view<6xf32>
  vector.store %final, %results[4] : vector<2xf32>, view<6xf32>
  kernel.return
}

