} launch(%output: buffer, %initial_bits: i32, %replacement_bits: i32) {
  %base = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %storage = buffer.alloca<workgroup> align(4) %bytes : buffer
  %cell = buffer.view %storage[%base] : buffer -> view<1xf32>
  %results = buffer.view %output[%base] : buffer -> view<4xi32>
