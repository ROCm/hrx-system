  %source = buffer.view %input[%base] : buffer -> view<64x3xi8>
  %temporary = buffer.view %scratch[%base] : buffer -> view<64x3xi8>
  %target = buffer.view %output[%guard] : buffer -> view<64x3xi8>
  %value = vector.load %source[%lane, 0] : view<64x3xi8> -> vector<3xi8>
  vector.store<volatile> %value, %temporary[%lane, 0] : vector<3xi8>, view<64x3xi8>
  %staged = vector.load<volatile> %temporary[%lane, 0] : view<64x3xi8> -> vector<3xi8>
  vector.store %staged, %target[%lane, 0] : vector<3xi8>, view<64x3xi8>
  kernel.return
}

check.case public @stage_private_i8_3_bits {
  %input = check.generate.iota offset(-128) step(1) : tensor<192xi8>
  %output = check.generate.fill value(91) : tensor<194xi8>
  kernel.launch @stage_private_i8_3(%input, %output) : (tensor<192xi8>, tensor<194xi8>)
  %actual = check.tensor.view %output offset(1) : tensor<194xi8> -> tensor<192xi8>
  %prefix = check.tensor.view %output offset(0) : tensor<194xi8> -> tensor<1xi8>
  %suffix = check.tensor.view %output offset(193) : tensor<194xi8> -> tensor<1xi8>
  %expected = check.generate.iota offset(-128) step(1) : tensor<192xi8>
  %guard = check.generate.fill value(91) : tensor<1xi8>
  check.expect.bitwise actual(%actual) expected(%expected) : tensor<192xi8>
  check.expect.bitwise actual(%input) expected(%expected) : tensor<192xi8>
  check.expect.bitwise actual(%prefix) expected(%guard) : tensor<1xi8>
  check.expect.bitwise actual(%suffix) expected(%guard) : tensor<1xi8>
  check.expect.event<device> {count = 0, type = "asan_report"}
  check.return
}
