// The strict recurrence must retain source order: (2^24 + 1) - (2^24 - 2)
// rounds to 2, while reassociating the final two terms produces 3.
check.case @guarded_state_strict_cancellation {
  %count = check.literal value(3) : index
  %initial = check.literal value(0) : i32
  %flags = check.generate.fill value(1) : tensor<16xi32>
  %values = check.generate.iota offset(16777216.0) step(-16777215.0) : tensor<16xf32>
  %sum = check.generate.fill value(nan) : tensor<1xf32>
  %last = check.generate.fill value(nan) : tensor<1xf32>
  %expected_sum = check.generate.fill value(2.0) : tensor<1xf32>
  %expected_last = check.generate.fill value(-16777214.0) : tensor<1xf32>
  kernel.launch @guarded_state(%count, %initial, %flags, %values, %sum, %last) : (index, i32, tensor<16xi32>, tensor<16xf32>, tensor<1xf32>, tensor<1xf32>)
  check.expect.bitwise actual(%sum) expected(%expected_sum) : tensor<1xf32>
  check.expect.bitwise actual(%last) expected(%expected_last) : tensor<1xf32>
  check.return
}

// A skipped update forwards both carried values exactly. The one-element input
// also makes every payload address after the first invalid under access checks.
check.case @guarded_state_skipped_negative_zero {
  %count = check.literal value(9) : index
  %initial = check.literal value(-2147483648) : i32
  %flags = check.generate.fill value(-1) : tensor<16xi32>
  %values = check.generate.fill value(nan) : tensor<1xf32>
  %sum = check.generate.fill value(1.0) : tensor<1xf32>
  %last = check.generate.fill value(1.0) : tensor<1xf32>
  %expected = check.generate.fill value(-0.0) : tensor<1xf32>
  kernel.launch @guarded_state(%count, %initial, %flags, %values, %sum, %last) : (index, i32, tensor<16xi32>, tensor<1xf32>, tensor<1xf32>, tensor<1xf32>)
  check.expect.bitwise actual(%sum) expected(%expected) : tensor<1xf32>
  check.expect.bitwise actual(%last) expected(%expected) : tensor<1xf32>
  check.return
}

check.case @guarded_state_skipped_nan {
  %count = check.literal value(7) : index
  %initial = check.literal value(2143289344) : i32
  %flags = check.generate.fill value(-1) : tensor<16xi32>
  %values = check.generate.fill value(1.0) : tensor<1xf32>
  %sum = check.generate.fill value(0.0) : tensor<1xf32>
  %last = check.generate.fill value(0.0) : tensor<1xf32>
  %expected = check.generate.fill value(nan) : tensor<1xf32>
  kernel.launch @guarded_state(%count, %initial, %flags, %values, %sum, %last) : (index, i32, tensor<16xi32>, tensor<1xf32>, tensor<1xf32>, tensor<1xf32>)
  check.expect.bitwise actual(%sum) expected(%expected) : tensor<1xf32>
  check.expect.bitwise actual(%last) expected(%expected) : tensor<1xf32>
  check.return
}

check.case @guarded_state_active_infinity {
  %count = check.literal value(5) : index
  %initial = check.literal value(0) : i32
  %flags = check.generate.fill value(1) : tensor<16xi32>
  %values = check.generate.fill value(inf) : tensor<16xf32>
  %sum = check.generate.fill value(nan) : tensor<1xf32>
  %last = check.generate.fill value(nan) : tensor<1xf32>
  %expected = check.generate.fill value(inf) : tensor<1xf32>
  kernel.launch @guarded_state(%count, %initial, %flags, %values, %sum, %last) : (index, i32, tensor<16xi32>, tensor<16xf32>, tensor<1xf32>, tensor<1xf32>)
  check.expect.bitwise actual(%sum) expected(%expected) : tensor<1xf32>
  check.expect.bitwise actual(%last) expected(%expected) : tensor<1xf32>
  check.return
}

check.case @guarded_state_active_nan {
  %count = check.literal value(5) : index
  %initial = check.literal value(2139095040) : i32
  %flags = check.generate.fill value(1) : tensor<16xi32>
  %values = check.generate.fill value(-inf) : tensor<16xf32>
  %sum = check.generate.fill value(0.0) : tensor<1xf32>
  %last = check.generate.fill value(0.0) : tensor<1xf32>
  %expected_sum = check.generate.fill value(nan) : tensor<1xf32>
  %expected_last = check.generate.fill value(-inf) : tensor<1xf32>
  kernel.launch @guarded_state(%count, %initial, %flags, %values, %sum, %last) : (index, i32, tensor<16xi32>, tensor<16xf32>, tensor<1xf32>, tensor<1xf32>)
  check.expect.close actual(%sum) expected(%expected_sum) atol(0.0) rtol(0.0) nan(same) : tensor<1xf32>
  check.expect.bitwise actual(%last) expected(%expected_last) : tensor<1xf32>
  check.return
}

// The compile-throughput witness runs eight segments here. Alternating flags
// select odd rows; each segment starts 64 elements after its predecessor.
kernel.decl @segmented_guarded_read_ahead() launch(%flags: buffer, %input: buffer, %output: buffer, %length: index)

check.case @segmented_predicate_queues_n0 {
  %count = check.literal value(0) : index
  %flags = check.generate.iota offset(-1) step(2) period(2) : tensor<32768xi32>
  %input = check.generate.iota offset(1.0) step(1.0) : tensor<32768xf32>
  %actual = check.generate.fill value(-1.0) : tensor<1xf32>
  %expected = check.generate.fill value(0.0) : tensor<1xf32>
  kernel.launch @segmented_guarded_read_ahead(%flags, %input, %actual, %count) : (tensor<32768xi32>, tensor<32768xf32>, tensor<1xf32>, index)
  check.expect.close actual(%actual) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<1xf32>
  check.return
}

