// FP16 has no same-width integer compare-exchange fallback in Vulkan SPIR-V,
// so exchange and add are independently gated native operations.
kernel.def @global_atomic_f16_exchange() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%value: buffer, %result: buffer) {
  %base = index.constant 0 : offset
  %value_index = index.constant 0 : index
  %failure = scalar.constant 0 : i32
  %success = scalar.constant 1 : i32
  %initial_value_bits = scalar.constant 15360 : i16
  %update_value_bits = scalar.constant 16384 : i16
  %one = scalar.bitcast %initial_value_bits : i16 to f16
  %two = scalar.bitcast %update_value_bits : i16 to f16
  %value_global = buffer.assume.memory_space<global> %value : buffer
  %result_global = buffer.assume.memory_space<global> %result : buffer
  %value_aligned = buffer.assume.alignment %value_global {minimum_alignment = 2} : buffer
  %result_aligned = buffer.assume.alignment %result_global {minimum_alignment = 4} : buffer
  %value_view = buffer.view %value_aligned[%base] : buffer -> view<1xf16>
  %result_view = buffer.view %result_aligned[%base] : buffer -> view<1xi32>

  view.store %one, %value_view[%value_index] : f16, view<1xf16>
  %xchg_old = view.atomic.rmw<xchgf> %two, %value_view[%value_index] {ordering = relaxed, scope = thread} : f16, view<1xf16> -> f16
  %xchg_final = view.load %value_view[%value_index] : view<1xf16> -> f16
  %xchg_old_bits = scalar.bitcast %xchg_old : f16 to i16
  %xchg_final_bits = scalar.bitcast %xchg_final : f16 to i16
  %xchg_old_ok = scalar.cmpi eq, %xchg_old_bits, %initial_value_bits : i16
  %xchg_final_ok = scalar.cmpi eq, %xchg_final_bits, %update_value_bits : i16
  %xchg_ok = scalar.andi %xchg_old_ok, %xchg_final_ok : i1
  %xchg_result = scf.select %xchg_ok, %success, %failure : i32
  view.store %xchg_result, %result_view[%value_index] : i32, view<1xi32>
  kernel.return
}

