  %add_final_ok = scalar.cmpi eq, %add_final_bits, %combined_value_bits : i16
  %add_ok = scalar.andi %add_old_ok, %add_final_ok : i1
  %add_result = scf.select %add_ok, %success, %failure : i32
  view.store %add_result, %result_view[%value_index] : i32, view<1xi32>
