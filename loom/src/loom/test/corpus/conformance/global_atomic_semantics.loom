// Vulkan SPIR-V integer atomics must preserve the operation, signedness,
// ordering, scope, returned old value, and final memory value. One invocation
// keeps each observation deterministic while still executing the production
// storage-buffer atomic path on the device.
kernel.def @global_atomic_i32_operations() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%values: buffer, %results: buffer) {
  %base = index.constant 0 : offset
  %values_global = buffer.assume.memory_space<global> %values : buffer
  %results_global = buffer.assume.memory_space<global> %results : buffer
  %values_aligned = buffer.assume.alignment %values_global {minimum_alignment = 4} : buffer
  %results_aligned = buffer.assume.alignment %results_global {minimum_alignment = 4} : buffer
  %values_view = buffer.view %values_aligned[%base] : buffer -> view<11xi32>
  %results_view = buffer.view %results_aligned[%base] : buffer -> view<11xi32>

  %c0_index = index.constant 0 : index
  %c1_index = index.constant 1 : index
  %c2_index = index.constant 2 : index
  %c3_index = index.constant 3 : index
  %c4_index = index.constant 4 : index
  %c5_index = index.constant 5 : index
  %c6_index = index.constant 6 : index
  %c7_index = index.constant 7 : index
  %c8_index = index.constant 8 : index
  %c9_index = index.constant 9 : index
  %c10_index = index.constant 10 : index
  %failure = scalar.constant 0 : i32
  %success = scalar.constant 1 : i32

  %xchg_initial = scalar.constant 5 : i32
  %xchg_value = scalar.constant 9 : i32
  view.store %xchg_initial, %values_view[%c0_index] : i32, view<11xi32>
  %xchg_old = view.atomic.rmw<xchgi> %xchg_value, %values_view[%c0_index] {ordering = relaxed, scope = thread} : i32, view<11xi32> -> i32
  %xchg_final = view.load %values_view[%c0_index] : view<11xi32> -> i32
  %xchg_old_ok = scalar.cmpi eq, %xchg_old, %xchg_initial : i32
  %xchg_final_ok = scalar.cmpi eq, %xchg_final, %xchg_value : i32
  %xchg_ok = scalar.andi %xchg_old_ok, %xchg_final_ok : i1
  %xchg_result = scf.select %xchg_ok, %success, %failure : i32
  view.store %xchg_result, %results_view[%c0_index] : i32, view<11xi32>

  %add_initial = scalar.constant 5 : i32
  %add_value = scalar.constant 3 : i32
  %add_expected = scalar.constant 8 : i32
  view.store %add_initial, %values_view[%c1_index] : i32, view<11xi32>
  %add_old = view.atomic.rmw<addi> %add_value, %values_view[%c1_index] {ordering = acquire, scope = subgroup} : i32, view<11xi32> -> i32
  %add_final = view.load %values_view[%c1_index] : view<11xi32> -> i32
  %add_old_ok = scalar.cmpi eq, %add_old, %add_initial : i32
  %add_final_ok = scalar.cmpi eq, %add_final, %add_expected : i32
  %add_ok = scalar.andi %add_old_ok, %add_final_ok : i1
  %add_result = scf.select %add_ok, %success, %failure : i32
  view.store %add_result, %results_view[%c1_index] : i32, view<11xi32>

  %sub_initial = scalar.constant 5 : i32
  %sub_value = scalar.constant 3 : i32
  %sub_expected = scalar.constant 2 : i32
  view.store %sub_initial, %values_view[%c2_index] : i32, view<11xi32>
  %sub_old = view.atomic.rmw<subi> %sub_value, %values_view[%c2_index] {ordering = release, scope = workgroup} : i32, view<11xi32> -> i32
  %sub_final = view.load %values_view[%c2_index] : view<11xi32> -> i32
  %sub_old_ok = scalar.cmpi eq, %sub_old, %sub_initial : i32
  %sub_final_ok = scalar.cmpi eq, %sub_final, %sub_expected : i32
  %sub_ok = scalar.andi %sub_old_ok, %sub_final_ok : i1
  %sub_result = scf.select %sub_ok, %success, %failure : i32
  view.store %sub_result, %results_view[%c2_index] : i32, view<11xi32>

  %and_initial = scalar.constant 15 : i32
  %and_value = scalar.constant 6 : i32
  %and_expected = scalar.constant 6 : i32
  view.store %and_initial, %values_view[%c3_index] : i32, view<11xi32>
  %and_old = view.atomic.rmw<andi> %and_value, %values_view[%c3_index] {ordering = acq_rel, scope = device} : i32, view<11xi32> -> i32
  %and_final = view.load %values_view[%c3_index] : view<11xi32> -> i32
  %and_old_ok = scalar.cmpi eq, %and_old, %and_initial : i32
  %and_final_ok = scalar.cmpi eq, %and_final, %and_expected : i32
  %and_ok = scalar.andi %and_old_ok, %and_final_ok : i1
  %and_result = scf.select %and_ok, %success, %failure : i32
  view.store %and_result, %results_view[%c3_index] : i32, view<11xi32>

  %or_initial = scalar.constant 8 : i32
  %or_value = scalar.constant 3 : i32
  %or_expected = scalar.constant 11 : i32
  view.store %or_initial, %values_view[%c4_index] : i32, view<11xi32>
  %or_old = view.atomic.rmw<ori> %or_value, %values_view[%c4_index] {ordering = relaxed, scope = thread} : i32, view<11xi32> -> i32
  %or_final = view.load %values_view[%c4_index] : view<11xi32> -> i32
  %or_old_ok = scalar.cmpi eq, %or_old, %or_initial : i32
  %or_final_ok = scalar.cmpi eq, %or_final, %or_expected : i32
  %or_ok = scalar.andi %or_old_ok, %or_final_ok : i1
  %or_result = scf.select %or_ok, %success, %failure : i32
  view.store %or_result, %results_view[%c4_index] : i32, view<11xi32>

  %xor_initial = scalar.constant 10 : i32
  %xor_value = scalar.constant 12 : i32
  %xor_expected = scalar.constant 6 : i32
  view.store %xor_initial, %values_view[%c5_index] : i32, view<11xi32>
  %xor_old = view.atomic.rmw<xori> %xor_value, %values_view[%c5_index] {ordering = acq_rel, scope = subgroup} : i32, view<11xi32> -> i32
  %xor_final = view.load %values_view[%c5_index] : view<11xi32> -> i32
  %xor_old_ok = scalar.cmpi eq, %xor_old, %xor_initial : i32
  %xor_final_ok = scalar.cmpi eq, %xor_final, %xor_expected : i32
  %xor_ok = scalar.andi %xor_old_ok, %xor_final_ok : i1
  %xor_result = scf.select %xor_ok, %success, %failure : i32
  view.store %xor_result, %results_view[%c5_index] : i32, view<11xi32>

  %smin_initial = scalar.constant -5 : i32
  %smin_value = scalar.constant -9 : i32
  view.store %smin_initial, %values_view[%c6_index] : i32, view<11xi32>
  %smin_old = view.atomic.rmw<minsi> %smin_value, %values_view[%c6_index] {ordering = acquire, scope = workgroup} : i32, view<11xi32> -> i32
  %smin_final = view.load %values_view[%c6_index] : view<11xi32> -> i32
  %smin_old_ok = scalar.cmpi eq, %smin_old, %smin_initial : i32
  %smin_final_ok = scalar.cmpi eq, %smin_final, %smin_value : i32
  %smin_ok = scalar.andi %smin_old_ok, %smin_final_ok : i1
  %smin_result = scf.select %smin_ok, %success, %failure : i32
  view.store %smin_result, %results_view[%c6_index] : i32, view<11xi32>

  %smax_initial = scalar.constant -5 : i32
  %smax_value = scalar.constant 2 : i32
  view.store %smax_initial, %values_view[%c7_index] : i32, view<11xi32>
  %smax_old = view.atomic.rmw<maxsi> %smax_value, %values_view[%c7_index] {ordering = release, scope = device} : i32, view<11xi32> -> i32
  %smax_final = view.load %values_view[%c7_index] : view<11xi32> -> i32
  %smax_old_ok = scalar.cmpi eq, %smax_old, %smax_initial : i32
  %smax_final_ok = scalar.cmpi eq, %smax_final, %smax_value : i32
  %smax_ok = scalar.andi %smax_old_ok, %smax_final_ok : i1
  %smax_result = scf.select %smax_ok, %success, %failure : i32
  view.store %smax_result, %results_view[%c7_index] : i32, view<11xi32>

  %umin_initial = scalar.constant -1 : i32
  %umin_value = scalar.constant 2 : i32
  view.store %umin_initial, %values_view[%c8_index] : i32, view<11xi32>
  %umin_old = view.atomic.rmw<minui> %umin_value, %values_view[%c8_index] {ordering = release, scope = subgroup} : i32, view<11xi32> -> i32
  %umin_final = view.load %values_view[%c8_index] : view<11xi32> -> i32
  %umin_old_ok = scalar.cmpi eq, %umin_old, %umin_initial : i32
  %umin_final_ok = scalar.cmpi eq, %umin_final, %umin_value : i32
  %umin_ok = scalar.andi %umin_old_ok, %umin_final_ok : i1
  %umin_result = scf.select %umin_ok, %success, %failure : i32
  view.store %umin_result, %results_view[%c8_index] : i32, view<11xi32>

  %umax_initial = scalar.constant -1 : i32
  %umax_value = scalar.constant 2 : i32
  view.store %umax_initial, %values_view[%c9_index] : i32, view<11xi32>
  %umax_old = view.atomic.rmw<maxui> %umax_value, %values_view[%c9_index] {ordering = acq_rel, scope = workgroup} : i32, view<11xi32> -> i32
  %umax_final = view.load %values_view[%c9_index] : view<11xi32> -> i32
  %umax_old_ok = scalar.cmpi eq, %umax_old, %umax_initial : i32
  %umax_final_ok = scalar.cmpi eq, %umax_final, %umax_initial : i32
  %umax_ok = scalar.andi %umax_old_ok, %umax_final_ok : i1
  %umax_result = scf.select %umax_ok, %success, %failure : i32
  view.store %umax_result, %results_view[%c9_index] : i32, view<11xi32>

  %cmpx_initial = scalar.constant 7 : i32
  %cmpx_success_replacement = scalar.constant 9 : i32
  %cmpx_failure_replacement = scalar.constant 11 : i32
  view.store %cmpx_initial, %values_view[%c10_index] : i32, view<11xi32>
  %cmpx_success_old = view.atomic.cmpxchg %cmpx_initial, %cmpx_success_replacement, %values_view[%c10_index] {failure_ordering = acquire, scope = device, success_ordering = acq_rel} : i32, view<11xi32> -> i32
  %cmpx_failure_old = view.atomic.cmpxchg %cmpx_initial, %cmpx_failure_replacement, %values_view[%c10_index] {failure_ordering = relaxed, scope = device, success_ordering = release} : i32, view<11xi32> -> i32
  %cmpx_final = view.load %values_view[%c10_index] : view<11xi32> -> i32
  %cmpx_success_old_ok = scalar.cmpi eq, %cmpx_success_old, %cmpx_initial : i32
  %cmpx_failure_old_ok = scalar.cmpi eq, %cmpx_failure_old, %cmpx_success_replacement : i32
  %cmpx_final_ok = scalar.cmpi eq, %cmpx_final, %cmpx_success_replacement : i32
  %cmpx_old_ok = scalar.andi %cmpx_success_old_ok, %cmpx_failure_old_ok : i1
  %cmpx_ok = scalar.andi %cmpx_old_ok, %cmpx_final_ok : i1
  %cmpx_result = scf.select %cmpx_ok, %success, %failure : i32
  view.store %cmpx_result, %results_view[%c10_index] : i32, view<11xi32>
  kernel.return
}

check.case public @global_atomic_i32_operations_case {
  check.requires<hal.vulkan.feature> {feature = "vulkan_memory_model_device_scope"}
  %values = check.generate.fill value(0) : tensor<11xi32>
  %results = check.generate.fill value(0) : tensor<11xi32>
  %expected = check.generate.fill value(1) : tensor<11xi32>
  kernel.launch @global_atomic_i32_operations(%values, %results) : (tensor<11xi32>, tensor<11xi32>)
  check.expect.equal actual(%results) expected(%expected) : tensor<11xi32>
  check.return
}

// Floating-point minimum and maximum preserve Loom's exact NaN and signed-zero
// semantics. Compare-exchange compares float payloads bitwise, while native
// exchange/add and compare-exchange-loop operations all return the old value.
kernel.def @global_atomic_f32_operations() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%values: buffer, %results: buffer) {
  %base = index.constant 0 : offset
  %values_global = buffer.assume.memory_space<global> %values : buffer
  %results_global = buffer.assume.memory_space<global> %results : buffer
  %values_aligned = buffer.assume.alignment %values_global {minimum_alignment = 4} : buffer
  %results_aligned = buffer.assume.alignment %results_global {minimum_alignment = 4} : buffer
  %values_view = buffer.view %values_aligned[%base] : buffer -> view<14xf32>
  %results_view = buffer.view %results_aligned[%base] : buffer -> view<14xi32>

  %c0_index = index.constant 0 : index
  %c1_index = index.constant 1 : index
  %c2_index = index.constant 2 : index
  %c3_index = index.constant 3 : index
  %c4_index = index.constant 4 : index
  %c5_index = index.constant 5 : index
  %c6_index = index.constant 6 : index
  %c7_index = index.constant 7 : index
  %c8_index = index.constant 8 : index
  %c9_index = index.constant 9 : index
  %c10_index = index.constant 10 : index
  %c11_index = index.constant 11 : index
  %c12_index = index.constant 12 : index
  %c13_index = index.constant 13 : index
  %failure = scalar.constant 0 : i32
  %success = scalar.constant 1 : i32

  %positive_signed_zero_bits = scalar.constant 0 : i32
  %negative_signed_zero_bits = scalar.constant -2147483648 : i32
  %initial_value_bits = scalar.constant 1065353216 : i32
  %update_value_bits = scalar.constant 1073741824 : i32
  %combined_value_bits = scalar.constant 1077936128 : i32
  %nan_a_bits = scalar.constant 2143289345 : i32
  %nan_b_bits = scalar.constant 2143289346 : i32
  %positive_zero = scalar.bitcast %positive_signed_zero_bits : i32 to f32
  %negative_zero = scalar.bitcast %negative_signed_zero_bits : i32 to f32
  %one = scalar.bitcast %initial_value_bits : i32 to f32
  %two = scalar.bitcast %update_value_bits : i32 to f32
  %nan_a = scalar.bitcast %nan_a_bits : i32 to f32
  %nan_b = scalar.bitcast %nan_b_bits : i32 to f32

  view.store %one, %values_view[%c0_index] : f32, view<14xf32>
  %xchg_old = view.atomic.rmw<xchgf> %two, %values_view[%c0_index] {ordering = relaxed, scope = thread} : f32, view<14xf32> -> f32
  %xchg_final = view.load %values_view[%c0_index] : view<14xf32> -> f32
  %xchg_old_bits = scalar.bitcast %xchg_old : f32 to i32
  %xchg_final_bits = scalar.bitcast %xchg_final : f32 to i32
  %xchg_old_ok = scalar.cmpi eq, %xchg_old_bits, %initial_value_bits : i32
  %xchg_final_ok = scalar.cmpi eq, %xchg_final_bits, %update_value_bits : i32
  %xchg_ok = scalar.andi %xchg_old_ok, %xchg_final_ok : i1
  %xchg_result = scf.select %xchg_ok, %success, %failure : i32
  view.store %xchg_result, %results_view[%c0_index] : i32, view<14xi32>

  view.store %one, %values_view[%c1_index] : f32, view<14xf32>
  %add_old = view.atomic.rmw<addf> %two, %values_view[%c1_index] {ordering = acquire, scope = subgroup} : f32, view<14xf32> -> f32
  %add_final = view.load %values_view[%c1_index] : view<14xf32> -> f32
  %add_old_bits = scalar.bitcast %add_old : f32 to i32
  %add_final_bits = scalar.bitcast %add_final : f32 to i32
  %add_old_ok = scalar.cmpi eq, %add_old_bits, %initial_value_bits : i32
  %add_final_ok = scalar.cmpi eq, %add_final_bits, %combined_value_bits : i32
  %add_ok = scalar.andi %add_old_ok, %add_final_ok : i1
  %add_result = scf.select %add_ok, %success, %failure : i32
  view.store %add_result, %results_view[%c1_index] : i32, view<14xi32>

  view.store %two, %values_view[%c2_index] : f32, view<14xf32>
  %minimum_numeric_old = view.atomic.rmw<minimumf> %one, %values_view[%c2_index] {ordering = release, scope = workgroup} : f32, view<14xf32> -> f32
  %minimum_numeric_final = view.load %values_view[%c2_index] : view<14xf32> -> f32
  %minimum_numeric_old_bits = scalar.bitcast %minimum_numeric_old : f32 to i32
  %minimum_numeric_final_bits = scalar.bitcast %minimum_numeric_final : f32 to i32
  %minimum_numeric_old_ok = scalar.cmpi eq, %minimum_numeric_old_bits, %update_value_bits : i32
  %minimum_numeric_final_ok = scalar.cmpi eq, %minimum_numeric_final_bits, %initial_value_bits : i32
  %minimum_numeric_ok = scalar.andi %minimum_numeric_old_ok, %minimum_numeric_final_ok : i1
  %minimum_numeric_result = scf.select %minimum_numeric_ok, %success, %failure : i32
  view.store %minimum_numeric_result, %results_view[%c2_index] : i32, view<14xi32>

  view.store %positive_zero, %values_view[%c3_index] : f32, view<14xf32>
  %minimum_zero_old = view.atomic.rmw<minimumf> %negative_zero, %values_view[%c3_index] {ordering = acq_rel, scope = device} : f32, view<14xf32> -> f32
  %minimum_zero_final = view.load %values_view[%c3_index] : view<14xf32> -> f32
  %minimum_zero_old_bits = scalar.bitcast %minimum_zero_old : f32 to i32
  %minimum_zero_final_bits = scalar.bitcast %minimum_zero_final : f32 to i32
  %minimum_zero_old_ok = scalar.cmpi eq, %minimum_zero_old_bits, %positive_signed_zero_bits : i32
  %minimum_zero_final_ok = scalar.cmpi eq, %minimum_zero_final_bits, %negative_signed_zero_bits : i32
  %minimum_zero_ok = scalar.andi %minimum_zero_old_ok, %minimum_zero_final_ok : i1
  %minimum_zero_result = scf.select %minimum_zero_ok, %success, %failure : i32
  view.store %minimum_zero_result, %results_view[%c3_index] : i32, view<14xi32>

  view.store %one, %values_view[%c4_index] : f32, view<14xf32>
  %minimum_nan_old = view.atomic.rmw<minimumf> %nan_a, %values_view[%c4_index] {ordering = relaxed, scope = workgroup} : f32, view<14xf32> -> f32
  %minimum_nan_final = view.load %values_view[%c4_index] : view<14xf32> -> f32
  %minimum_nan_old_bits = scalar.bitcast %minimum_nan_old : f32 to i32
  %minimum_nan_final_bits = scalar.bitcast %minimum_nan_final : f32 to i32
  %minimum_nan_old_ok = scalar.cmpi eq, %minimum_nan_old_bits, %initial_value_bits : i32
  %minimum_nan_final_ok = scalar.cmpi eq, %minimum_nan_final_bits, %nan_a_bits : i32
  %minimum_nan_ok = scalar.andi %minimum_nan_old_ok, %minimum_nan_final_ok : i1
  %minimum_nan_result = scf.select %minimum_nan_ok, %success, %failure : i32
  view.store %minimum_nan_result, %results_view[%c4_index] : i32, view<14xi32>

  view.store %one, %values_view[%c5_index] : f32, view<14xf32>
  %maximum_numeric_old = view.atomic.rmw<maximumf> %two, %values_view[%c5_index] {ordering = acquire, scope = subgroup} : f32, view<14xf32> -> f32
  %maximum_numeric_final = view.load %values_view[%c5_index] : view<14xf32> -> f32
  %maximum_numeric_old_bits = scalar.bitcast %maximum_numeric_old : f32 to i32
  %maximum_numeric_final_bits = scalar.bitcast %maximum_numeric_final : f32 to i32
  %maximum_numeric_old_ok = scalar.cmpi eq, %maximum_numeric_old_bits, %initial_value_bits : i32
  %maximum_numeric_final_ok = scalar.cmpi eq, %maximum_numeric_final_bits, %update_value_bits : i32
  %maximum_numeric_ok = scalar.andi %maximum_numeric_old_ok, %maximum_numeric_final_ok : i1
  %maximum_numeric_result = scf.select %maximum_numeric_ok, %success, %failure : i32
  view.store %maximum_numeric_result, %results_view[%c5_index] : i32, view<14xi32>

  view.store %negative_zero, %values_view[%c6_index] : f32, view<14xf32>
  %maximum_zero_old = view.atomic.rmw<maximumf> %positive_zero, %values_view[%c6_index] {ordering = release, scope = workgroup} : f32, view<14xf32> -> f32
  %maximum_zero_final = view.load %values_view[%c6_index] : view<14xf32> -> f32
  %maximum_zero_old_bits = scalar.bitcast %maximum_zero_old : f32 to i32
  %maximum_zero_final_bits = scalar.bitcast %maximum_zero_final : f32 to i32
  %maximum_zero_old_ok = scalar.cmpi eq, %maximum_zero_old_bits, %negative_signed_zero_bits : i32
  %maximum_zero_final_ok = scalar.cmpi eq, %maximum_zero_final_bits, %positive_signed_zero_bits : i32
  %maximum_zero_ok = scalar.andi %maximum_zero_old_ok, %maximum_zero_final_ok : i1
  %maximum_zero_result = scf.select %maximum_zero_ok, %success, %failure : i32
  view.store %maximum_zero_result, %results_view[%c6_index] : i32, view<14xi32>

  view.store %nan_a, %values_view[%c7_index] : f32, view<14xf32>
  %maximum_nan_old = view.atomic.rmw<maximumf> %one, %values_view[%c7_index] {ordering = acq_rel, scope = device} : f32, view<14xf32> -> f32
  %maximum_nan_final = view.load %values_view[%c7_index] : view<14xf32> -> f32
  %maximum_nan_old_bits = scalar.bitcast %maximum_nan_old : f32 to i32
  %maximum_nan_final_bits = scalar.bitcast %maximum_nan_final : f32 to i32
  %maximum_nan_old_ok = scalar.cmpi eq, %maximum_nan_old_bits, %nan_a_bits : i32
  %maximum_nan_final_ok = scalar.cmpi eq, %maximum_nan_final_bits, %nan_a_bits : i32
  %maximum_nan_ok = scalar.andi %maximum_nan_old_ok, %maximum_nan_final_ok : i1
  %maximum_nan_result = scf.select %maximum_nan_ok, %success, %failure : i32
  view.store %maximum_nan_result, %results_view[%c7_index] : i32, view<14xi32>

  view.store %two, %values_view[%c8_index] : f32, view<14xf32>
  %minnum_numeric_old = view.atomic.rmw<minnumf> %one, %values_view[%c8_index] {ordering = relaxed, scope = thread} : f32, view<14xf32> -> f32
  %minnum_numeric_final = view.load %values_view[%c8_index] : view<14xf32> -> f32
  %minnum_numeric_old_bits = scalar.bitcast %minnum_numeric_old : f32 to i32
  %minnum_numeric_final_bits = scalar.bitcast %minnum_numeric_final : f32 to i32
  %minnum_numeric_old_ok = scalar.cmpi eq, %minnum_numeric_old_bits, %update_value_bits : i32
  %minnum_numeric_final_ok = scalar.cmpi eq, %minnum_numeric_final_bits, %initial_value_bits : i32
  %minnum_numeric_ok = scalar.andi %minnum_numeric_old_ok, %minnum_numeric_final_ok : i1
  %minnum_numeric_result = scf.select %minnum_numeric_ok, %success, %failure : i32
  view.store %minnum_numeric_result, %results_view[%c8_index] : i32, view<14xi32>

  view.store %nan_a, %values_view[%c9_index] : f32, view<14xf32>
  %minnum_nan_old = view.atomic.rmw<minnumf> %one, %values_view[%c9_index] {ordering = acquire, scope = subgroup} : f32, view<14xf32> -> f32
  %minnum_nan_final = view.load %values_view[%c9_index] : view<14xf32> -> f32
  %minnum_nan_old_bits = scalar.bitcast %minnum_nan_old : f32 to i32
  %minnum_nan_old_ok = scalar.cmpi eq, %minnum_nan_old_bits, %nan_a_bits : i32
  %minnum_nan_final_bits = scalar.bitcast %minnum_nan_final : f32 to i32
  %minnum_nan_final_ok = scalar.cmpi eq, %minnum_nan_final_bits, %initial_value_bits : i32
  %minnum_nan_ok = scalar.andi %minnum_nan_old_ok, %minnum_nan_final_ok : i1
  %minnum_nan_result = scf.select %minnum_nan_ok, %success, %failure : i32
  view.store %minnum_nan_result, %results_view[%c9_index] : i32, view<14xi32>

  view.store %one, %values_view[%c10_index] : f32, view<14xf32>
  %maxnum_numeric_old = view.atomic.rmw<maxnumf> %two, %values_view[%c10_index] {ordering = release, scope = workgroup} : f32, view<14xf32> -> f32
  %maxnum_numeric_final = view.load %values_view[%c10_index] : view<14xf32> -> f32
  %maxnum_numeric_old_bits = scalar.bitcast %maxnum_numeric_old : f32 to i32
  %maxnum_numeric_final_bits = scalar.bitcast %maxnum_numeric_final : f32 to i32
  %maxnum_numeric_old_ok = scalar.cmpi eq, %maxnum_numeric_old_bits, %initial_value_bits : i32
  %maxnum_numeric_final_ok = scalar.cmpi eq, %maxnum_numeric_final_bits, %update_value_bits : i32
  %maxnum_numeric_ok = scalar.andi %maxnum_numeric_old_ok, %maxnum_numeric_final_ok : i1
  %maxnum_numeric_result = scf.select %maxnum_numeric_ok, %success, %failure : i32
  view.store %maxnum_numeric_result, %results_view[%c10_index] : i32, view<14xi32>

  view.store %one, %values_view[%c11_index] : f32, view<14xf32>
  %maxnum_nan_old = view.atomic.rmw<maxnumf> %nan_a, %values_view[%c11_index] {ordering = acq_rel, scope = device} : f32, view<14xf32> -> f32
  %maxnum_nan_final = view.load %values_view[%c11_index] : view<14xf32> -> f32
  %maxnum_nan_old_bits = scalar.bitcast %maxnum_nan_old : f32 to i32
  %maxnum_nan_final_bits = scalar.bitcast %maxnum_nan_final : f32 to i32
  %maxnum_nan_old_ok = scalar.cmpi eq, %maxnum_nan_old_bits, %initial_value_bits : i32
  %maxnum_nan_final_ok = scalar.cmpi eq, %maxnum_nan_final_bits, %initial_value_bits : i32
  %maxnum_nan_ok = scalar.andi %maxnum_nan_old_ok, %maxnum_nan_final_ok : i1
  %maxnum_nan_result = scf.select %maxnum_nan_ok, %success, %failure : i32
  view.store %maxnum_nan_result, %results_view[%c11_index] : i32, view<14xi32>

  view.store %nan_a, %values_view[%c12_index] : f32, view<14xf32>
  %cmpx_success_old = view.atomic.cmpxchg %nan_a, %two, %values_view[%c12_index] {failure_ordering = acquire, scope = device, success_ordering = acq_rel} : f32, view<14xf32> -> f32
  %cmpx_success_final = view.load %values_view[%c12_index] : view<14xf32> -> f32
  %cmpx_success_old_bits = scalar.bitcast %cmpx_success_old : f32 to i32
  %cmpx_success_final_bits = scalar.bitcast %cmpx_success_final : f32 to i32
  %cmpx_success_old_ok = scalar.cmpi eq, %cmpx_success_old_bits, %nan_a_bits : i32
  %cmpx_success_final_ok = scalar.cmpi eq, %cmpx_success_final_bits, %update_value_bits : i32
  %cmpx_success_ok = scalar.andi %cmpx_success_old_ok, %cmpx_success_final_ok : i1
  %cmpx_success_result = scf.select %cmpx_success_ok, %success, %failure : i32
  view.store %cmpx_success_result, %results_view[%c12_index] : i32, view<14xi32>

  view.store %nan_a, %values_view[%c13_index] : f32, view<14xf32>
  %cmpx_failure_old = view.atomic.cmpxchg %nan_b, %two, %values_view[%c13_index] {failure_ordering = relaxed, scope = device, success_ordering = release} : f32, view<14xf32> -> f32
  %cmpx_failure_final = view.load %values_view[%c13_index] : view<14xf32> -> f32
