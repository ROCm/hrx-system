// Workgroup allocation carriers are selected for the entire allocation. Pure
// native float use may retain a float carrier; exact operations and mixed
// integer/float aliases use a same-width integer carrier and CAS lowering.
kernel.def @workgroup_atomic_carriers() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%results: buffer) {
  %base = index.constant 0 : offset
  %word_bytes = index.constant 4 : offset
  %c0_index = index.constant 0 : index
  %c1_index = index.constant 1 : index
  %c2_index = index.constant 2 : index
  %c3_index = index.constant 3 : index
  %failure = scalar.constant 0 : i32
  %success = scalar.constant 1 : i32
  %positive_signed_zero_bits = scalar.constant 0 : i32
  %negative_signed_zero_bits = scalar.constant -2147483648 : i32
  %initial_value_bits = scalar.constant 1065353216 : i32
  %update_value_bits = scalar.constant 1073741824 : i32
  %combined_value_bits = scalar.constant 1077936128 : i32
  %positive_zero = scalar.bitcast %positive_signed_zero_bits : i32 to f32
  %negative_zero = scalar.bitcast %negative_signed_zero_bits : i32 to f32
  %one = scalar.bitcast %initial_value_bits : i32 to f32
  %two = scalar.bitcast %update_value_bits : i32 to f32

  %results_global = buffer.assume.memory_space<global> %results : buffer
  %results_aligned = buffer.assume.alignment %results_global {minimum_alignment = 4} : buffer
  %results_view = buffer.view %results_aligned[%base] : buffer -> view<4xi32>

  %native_scratch = buffer.alloca<workgroup> align(4) %word_bytes : buffer
  %native_view = buffer.view %native_scratch[%base] : buffer -> view<1xf32>
  view.store %one, %native_view[%c0_index] : f32, view<1xf32>
  %native_xchg_old = view.atomic.rmw<xchgf> %two, %native_view[%c0_index] {ordering = relaxed, scope = workgroup} : f32, view<1xf32> -> f32
  %native_add_old = view.atomic.rmw<addf> %one, %native_view[%c0_index] {ordering = acq_rel, scope = workgroup} : f32, view<1xf32> -> f32
  %native_final = view.load %native_view[%c0_index] : view<1xf32> -> f32
  %native_xchg_old_bits = scalar.bitcast %native_xchg_old : f32 to i32
  %native_add_old_bits = scalar.bitcast %native_add_old : f32 to i32
  %native_final_bits = scalar.bitcast %native_final : f32 to i32
  %native_xchg_ok = scalar.cmpi eq, %native_xchg_old_bits, %initial_value_bits : i32
  %native_add_ok = scalar.cmpi eq, %native_add_old_bits, %update_value_bits : i32
  %native_final_ok = scalar.cmpi eq, %native_final_bits, %combined_value_bits : i32
  %native_old_ok = scalar.andi %native_xchg_ok, %native_add_ok : i1
  %native_ok = scalar.andi %native_old_ok, %native_final_ok : i1
  %native_result = scf.select %native_ok, %success, %failure : i32
  view.store %native_result, %results_view[%c0_index] : i32, view<4xi32>

  %exact_scratch = buffer.alloca<workgroup> align(4) %word_bytes : buffer
  %exact_view = buffer.view %exact_scratch[%base] : buffer -> view<1xf32>
  view.store %positive_zero, %exact_view[%c0_index] : f32, view<1xf32>
  %exact_old = view.atomic.rmw<minimumf> %negative_zero, %exact_view[%c0_index] {ordering = acq_rel, scope = workgroup} : f32, view<1xf32> -> f32
  %exact_final = view.load %exact_view[%c0_index] : view<1xf32> -> f32
  %exact_old_bits = scalar.bitcast %exact_old : f32 to i32
  %exact_final_bits = scalar.bitcast %exact_final : f32 to i32
  %exact_old_ok = scalar.cmpi eq, %exact_old_bits, %positive_signed_zero_bits : i32
  %exact_final_ok = scalar.cmpi eq, %exact_final_bits, %negative_signed_zero_bits : i32
  %exact_ok = scalar.andi %exact_old_ok, %exact_final_ok : i1
  %exact_result = scf.select %exact_ok, %success, %failure : i32
  view.store %exact_result, %results_view[%c1_index] : i32, view<4xi32>

  %mixed_scratch = buffer.alloca<workgroup> align(4) %word_bytes : buffer
  %mixed_float_view = buffer.view %mixed_scratch[%base] : buffer -> view<1xf32>
  %mixed_integer_view = buffer.view %mixed_scratch[%base] : buffer -> view<1xi32>
  view.store %initial_value_bits, %mixed_integer_view[%c0_index] : i32, view<1xi32>
  %mixed_old = view.atomic.rmw<addf> %one, %mixed_float_view[%c0_index] {ordering = acq_rel, scope = workgroup} : f32, view<1xf32> -> f32
  %mixed_final_bits = view.load %mixed_integer_view[%c0_index] : view<1xi32> -> i32
  %mixed_old_bits = scalar.bitcast %mixed_old : f32 to i32
  %mixed_old_ok = scalar.cmpi eq, %mixed_old_bits, %initial_value_bits : i32
  %mixed_final_ok = scalar.cmpi eq, %mixed_final_bits, %update_value_bits : i32
  %mixed_ok = scalar.andi %mixed_old_ok, %mixed_final_ok : i1
  %mixed_result = scf.select %mixed_ok, %success, %failure : i32
  view.store %mixed_result, %results_view[%c2_index] : i32, view<4xi32>

  %integer_scratch = buffer.alloca<workgroup> align(4) %word_bytes : buffer
  %integer_view = buffer.view %integer_scratch[%base] : buffer -> view<1xi32>
  %integer_initial = scalar.constant 7 : i32
  %integer_replacement = scalar.constant 9 : i32
  %integer_increment = scalar.constant 1 : i32
  %integer_final_expected = scalar.constant 10 : i32
  view.store %integer_initial, %integer_view[%c0_index] : i32, view<1xi32>
  %integer_cmpx_old = view.atomic.cmpxchg %integer_initial, %integer_replacement, %integer_view[%c0_index] {failure_ordering = acquire, scope = workgroup, success_ordering = acq_rel} : i32, view<1xi32> -> i32
  %integer_add_old = view.atomic.rmw<addi> %integer_increment, %integer_view[%c0_index] {ordering = acq_rel, scope = workgroup} : i32, view<1xi32> -> i32
  %integer_final = view.load %integer_view[%c0_index] : view<1xi32> -> i32
  %integer_cmpx_ok = scalar.cmpi eq, %integer_cmpx_old, %integer_initial : i32
  %integer_add_ok = scalar.cmpi eq, %integer_add_old, %integer_replacement : i32
  %integer_final_ok = scalar.cmpi eq, %integer_final, %integer_final_expected : i32
  %integer_old_ok = scalar.andi %integer_cmpx_ok, %integer_add_ok : i1
  %integer_ok = scalar.andi %integer_old_ok, %integer_final_ok : i1
  %integer_result = scf.select %integer_ok, %success, %failure : i32
  view.store %integer_result, %results_view[%c3_index] : i32, view<4xi32>
  kernel.return
}

check.case public @workgroup_atomic_carriers_case {
  %results = check.generate.fill value(0) : tensor<4xi32>
  %expected = check.generate.fill value(1) : tensor<4xi32>
  kernel.launch @workgroup_atomic_carriers(%results) : (tensor<4xi32>)
  check.expect.equal actual(%results) expected(%expected) : tensor<4xi32>
  check.return
}

// Vector atomic forms scalarize through the standard vector memory path before
// selecting the same scalar SPIR-V contracts. This covers unmasked and masked
// reductions, unmasked and masked RMW results, and compare-exchange results.
kernel.def @global_vector_atomic_forms() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%values: buffer, %results: buffer) {
  %base = index.constant 0 : offset
  %layout = encoding.layout.dense : encoding<layout>
  %c0_index = index.constant 0 : index
  %c1_index = index.constant 1 : index
  %c2_index = index.constant 2 : index
  %c3_index = index.constant 3 : index
  %c4_index = index.constant 4 : index
  %c5_index = index.constant 5 : index
  %c6_index = index.constant 6 : index
  %c7_index = index.constant 7 : index
  %c8_index = index.constant 8 : index
  %c9_index = index.constant 9 : index
  %false = scalar.constant false : i1
  %true = scalar.constant true : i1
  %failure = scalar.constant 0 : i32
  %success = scalar.constant 1 : i32
  %offsets = vector.from_elements %c0_index, %c1_index : vector<2xindex>
  %first_lane_mask = vector.from_elements %true, %false : vector<2xi1>
  %second_lane_mask = vector.from_elements %false, %true : vector<2xi1>

  %values_global = buffer.assume.memory_space<global> %values : buffer
  %results_global = buffer.assume.memory_space<global> %results : buffer
  %values_aligned = buffer.assume.alignment %values_global {minimum_alignment = 4} : buffer
  %results_aligned = buffer.assume.alignment %results_global {minimum_alignment = 4} : buffer
  %values_view = buffer.view %values_aligned[%base] : buffer -> view<10xi32, %layout>
  %results_view = buffer.view %results_aligned[%base] : buffer -> view<5xi32>

  %reduce_initial0 = scalar.constant 1 : i32
  %reduce_initial1 = scalar.constant 2 : i32
  %reduce_value0 = scalar.constant 3 : i32
  %reduce_value1 = scalar.constant 4 : i32
  %reduce_expected0 = scalar.constant 4 : i32
  %reduce_expected1 = scalar.constant 6 : i32
  %reduce_values = vector.from_elements %reduce_value0, %reduce_value1 : vector<2xi32>
  view.store %reduce_initial0, %values_view[%c0_index] : i32, view<10xi32, %layout>
  view.store %reduce_initial1, %values_view[%c1_index] : i32, view<10xi32, %layout>
  vector.atomic.reduce<addi> %reduce_values, %values_view[0][%offsets] {ordering = relaxed, scope = workgroup} : vector<2xi32>, view<10xi32, %layout>, vector<2xindex>
  %reduce_final0 = view.load %values_view[%c0_index] : view<10xi32, %layout> -> i32
  %reduce_final1 = view.load %values_view[%c1_index] : view<10xi32, %layout> -> i32
  %reduce_final0_ok = scalar.cmpi eq, %reduce_final0, %reduce_expected0 : i32
  %reduce_final1_ok = scalar.cmpi eq, %reduce_final1, %reduce_expected1 : i32
  %reduce_ok = scalar.andi %reduce_final0_ok, %reduce_final1_ok : i1
  %reduce_result = scf.select %reduce_ok, %success, %failure : i32
  view.store %reduce_result, %results_view[%c0_index] : i32, view<5xi32>

  %masked_reduce_initial = scalar.constant 8 : i32
  %masked_reduce_value = scalar.constant 3 : i32
  %masked_reduce_expected0 = scalar.constant 11 : i32
  %masked_reduce_values = vector.splat %masked_reduce_value : vector<2xi32>
  view.store %masked_reduce_initial, %values_view[%c2_index] : i32, view<10xi32, %layout>
  view.store %masked_reduce_initial, %values_view[%c3_index] : i32, view<10xi32, %layout>
  vector.atomic.reduce.mask<ori> %masked_reduce_values, %values_view[2][%offsets], %first_lane_mask {ordering = release, scope = workgroup} : vector<2xi32>, view<10xi32, %layout>, vector<2xindex>, vector<2xi1>
  %masked_reduce_final0 = view.load %values_view[%c2_index] : view<10xi32, %layout> -> i32
  %masked_reduce_final1 = view.load %values_view[%c3_index] : view<10xi32, %layout> -> i32
  %masked_reduce_final0_ok = scalar.cmpi eq, %masked_reduce_final0, %masked_reduce_expected0 : i32
  %masked_reduce_final1_ok = scalar.cmpi eq, %masked_reduce_final1, %masked_reduce_initial : i32
  %masked_reduce_ok = scalar.andi %masked_reduce_final0_ok, %masked_reduce_final1_ok : i1
  %masked_reduce_result = scf.select %masked_reduce_ok, %success, %failure : i32
  view.store %masked_reduce_result, %results_view[%c1_index] : i32, view<5xi32>

  %rmw_initial0 = scalar.constant 5 : i32
  %rmw_initial1 = scalar.constant 6 : i32
  %rmw_value0 = scalar.constant 7 : i32
  %rmw_value1 = scalar.constant 8 : i32
  %rmw_values = vector.from_elements %rmw_value0, %rmw_value1 : vector<2xi32>
  view.store %rmw_initial0, %values_view[%c4_index] : i32, view<10xi32, %layout>
  view.store %rmw_initial1, %values_view[%c5_index] : i32, view<10xi32, %layout>
  %rmw_old = vector.atomic.rmw<xchgi> %rmw_values, %values_view[4][%offsets] {ordering = acquire, scope = workgroup} : vector<2xi32>, view<10xi32, %layout>, vector<2xindex>
  %rmw_old0 = vector.extract %rmw_old[0] : vector<2xi32> -> i32
  %rmw_old1 = vector.extract %rmw_old[1] : vector<2xi32> -> i32
  %rmw_final0 = view.load %values_view[%c4_index] : view<10xi32, %layout> -> i32
  %rmw_final1 = view.load %values_view[%c5_index] : view<10xi32, %layout> -> i32
  %rmw_old0_ok = scalar.cmpi eq, %rmw_old0, %rmw_initial0 : i32
  %rmw_old1_ok = scalar.cmpi eq, %rmw_old1, %rmw_initial1 : i32
  %rmw_final0_ok = scalar.cmpi eq, %rmw_final0, %rmw_value0 : i32
  %rmw_final1_ok = scalar.cmpi eq, %rmw_final1, %rmw_value1 : i32
  %rmw_old_ok = scalar.andi %rmw_old0_ok, %rmw_old1_ok : i1
  %rmw_final_ok = scalar.andi %rmw_final0_ok, %rmw_final1_ok : i1
  %rmw_ok = scalar.andi %rmw_old_ok, %rmw_final_ok : i1
  %rmw_result = scf.select %rmw_ok, %success, %failure : i32
  view.store %rmw_result, %results_view[%c2_index] : i32, view<5xi32>

  %masked_rmw_initial0 = scalar.constant 10 : i32
  %masked_rmw_initial1 = scalar.constant 12 : i32
  %masked_rmw_value0 = scalar.constant 3 : i32
  %masked_rmw_value1 = scalar.constant 5 : i32
  %masked_rmw_passthrough0 = scalar.constant 101 : i32
  %masked_rmw_passthrough1 = scalar.constant 102 : i32
  %masked_rmw_expected1 = scalar.constant 9 : i32
  %masked_rmw_values = vector.from_elements %masked_rmw_value0, %masked_rmw_value1 : vector<2xi32>
  %masked_rmw_passthrough = vector.from_elements %masked_rmw_passthrough0, %masked_rmw_passthrough1 : vector<2xi32>
  view.store %masked_rmw_initial0, %values_view[%c6_index] : i32, view<10xi32, %layout>
  view.store %masked_rmw_initial1, %values_view[%c7_index] : i32, view<10xi32, %layout>
  %masked_rmw_old = vector.atomic.rmw.mask<xori> %masked_rmw_values, %values_view[6][%offsets], %second_lane_mask, %masked_rmw_passthrough {ordering = acq_rel, scope = workgroup} : vector<2xi32>, view<10xi32, %layout>, vector<2xindex>, vector<2xi1>, vector<2xi32>
  %masked_rmw_old0 = vector.extract %masked_rmw_old[0] : vector<2xi32> -> i32
  %masked_rmw_old1 = vector.extract %masked_rmw_old[1] : vector<2xi32> -> i32
  %masked_rmw_final0 = view.load %values_view[%c6_index] : view<10xi32, %layout> -> i32
  %masked_rmw_final1 = view.load %values_view[%c7_index] : view<10xi32, %layout> -> i32
  %masked_rmw_old0_ok = scalar.cmpi eq, %masked_rmw_old0, %masked_rmw_passthrough0 : i32
  %masked_rmw_old1_ok = scalar.cmpi eq, %masked_rmw_old1, %masked_rmw_initial1 : i32
  %masked_rmw_final0_ok = scalar.cmpi eq, %masked_rmw_final0, %masked_rmw_initial0 : i32
  %masked_rmw_final1_ok = scalar.cmpi eq, %masked_rmw_final1, %masked_rmw_expected1 : i32
  %masked_rmw_old_ok = scalar.andi %masked_rmw_old0_ok, %masked_rmw_old1_ok : i1
  %masked_rmw_final_ok = scalar.andi %masked_rmw_final0_ok, %masked_rmw_final1_ok : i1
  %masked_rmw_ok = scalar.andi %masked_rmw_old_ok, %masked_rmw_final_ok : i1
  %masked_rmw_result = scf.select %masked_rmw_ok, %success, %failure : i32
  view.store %masked_rmw_result, %results_view[%c3_index] : i32, view<5xi32>

  %cmpx_initial0 = scalar.constant 20 : i32
  %cmpx_initial1 = scalar.constant 21 : i32
  %cmpx_expected1 = scalar.constant 99 : i32
  %cmpx_replacement0 = scalar.constant 30 : i32
  %cmpx_replacement1 = scalar.constant 31 : i32
  %cmpx_expected = vector.from_elements %cmpx_initial0, %cmpx_expected1 : vector<2xi32>
  %cmpx_replacement = vector.from_elements %cmpx_replacement0, %cmpx_replacement1 : vector<2xi32>
  view.store %cmpx_initial0, %values_view[%c8_index] : i32, view<10xi32, %layout>
  view.store %cmpx_initial1, %values_view[%c9_index] : i32, view<10xi32, %layout>
  %cmpx_old = vector.atomic.cmpxchg %cmpx_expected, %cmpx_replacement, %values_view[8][%offsets] {failure_ordering = acquire, scope = workgroup, success_ordering = acq_rel} : vector<2xi32>, view<10xi32, %layout>, vector<2xindex> -> vector<2xi32>
  %cmpx_old0 = vector.extract %cmpx_old[0] : vector<2xi32> -> i32
  %cmpx_old1 = vector.extract %cmpx_old[1] : vector<2xi32> -> i32
  %cmpx_final0 = view.load %values_view[%c8_index] : view<10xi32, %layout> -> i32
  %cmpx_final1 = view.load %values_view[%c9_index] : view<10xi32, %layout> -> i32
  %cmpx_old0_ok = scalar.cmpi eq, %cmpx_old0, %cmpx_initial0 : i32
  %cmpx_old1_ok = scalar.cmpi eq, %cmpx_old1, %cmpx_initial1 : i32
  %cmpx_final0_ok = scalar.cmpi eq, %cmpx_final0, %cmpx_replacement0 : i32
  %cmpx_final1_ok = scalar.cmpi eq, %cmpx_final1, %cmpx_initial1 : i32
  %cmpx_old_ok = scalar.andi %cmpx_old0_ok, %cmpx_old1_ok : i1
  %cmpx_final_ok = scalar.andi %cmpx_final0_ok, %cmpx_final1_ok : i1
  %cmpx_ok = scalar.andi %cmpx_old_ok, %cmpx_final_ok : i1
  %cmpx_result = scf.select %cmpx_ok, %success, %failure : i32
  view.store %cmpx_result, %results_view[%c4_index] : i32, view<5xi32>
  kernel.return
}

check.case public @global_vector_atomic_forms_case {
  %values = check.generate.fill value(0) : tensor<10xi32>
  %results = check.generate.fill value(0) : tensor<5xi32>
  %expected = check.generate.fill value(1) : tensor<5xi32>
  kernel.launch @global_vector_atomic_forms(%values, %results) : (tensor<10xi32>, tensor<5xi32>)
  check.expect.equal actual(%results) expected(%expected) : tensor<5xi32>
  check.return
}
