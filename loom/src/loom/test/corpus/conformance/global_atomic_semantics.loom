// FP64 exchange can use a native instruction while add and exact min/max use
// the same-width integer compare-exchange fallback when native operations are
// absent. The case is feature-gated as one unit by the selected target profile.
kernel.def @global_atomic_f64_operations() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%values: buffer, %results: buffer) {
  %base = index.constant 0 : offset
  %values_global = buffer.assume.memory_space<global> %values : buffer
  %results_global = buffer.assume.memory_space<global> %results : buffer
  %values_aligned = buffer.assume.alignment %values_global {minimum_alignment = 8} : buffer
  %results_aligned = buffer.assume.alignment %results_global {minimum_alignment = 4} : buffer
  %values_view = buffer.view %values_aligned[%base] : buffer -> view<5xf64>
  %results_view = buffer.view %results_aligned[%base] : buffer -> view<5xi32>

  %c0_index = index.constant 0 : index
  %c1_index = index.constant 1 : index
  %c2_index = index.constant 2 : index
  %c3_index = index.constant 3 : index
  %c4_index = index.constant 4 : index
  %failure = scalar.constant 0 : i32
  %success = scalar.constant 1 : i32

  %positive_signed_zero_bits = scalar.constant 0 : i64
  %negative_signed_zero_bits = scalar.constant -9223372036854775808 : i64
  %initial_value_bits = scalar.constant 4607182418800017408 : i64
  %update_value_bits = scalar.constant 4611686018427387904 : i64
  %combined_value_bits = scalar.constant 4613937818241073152 : i64
  %nan_bits = scalar.constant 9221120237041090561 : i64
  %positive_zero = scalar.bitcast %positive_signed_zero_bits : i64 to f64
  %negative_zero = scalar.bitcast %negative_signed_zero_bits : i64 to f64
  %one = scalar.bitcast %initial_value_bits : i64 to f64
  %two = scalar.bitcast %update_value_bits : i64 to f64
  %nan = scalar.bitcast %nan_bits : i64 to f64

  view.store %one, %values_view[%c0_index] : f64, view<5xf64>
  %xchg_old = view.atomic.rmw<xchgf> %two, %values_view[%c0_index] {ordering = relaxed, scope = thread} : f64, view<5xf64> -> f64
  %xchg_final = view.load %values_view[%c0_index] : view<5xf64> -> f64
  %xchg_old_bits = scalar.bitcast %xchg_old : f64 to i64
  %xchg_final_bits = scalar.bitcast %xchg_final : f64 to i64
  %xchg_old_ok = scalar.cmpi eq, %xchg_old_bits, %initial_value_bits : i64
  %xchg_final_ok = scalar.cmpi eq, %xchg_final_bits, %update_value_bits : i64
  %xchg_ok = scalar.andi %xchg_old_ok, %xchg_final_ok : i1
  %xchg_result = scf.select %xchg_ok, %success, %failure : i32
  view.store %xchg_result, %results_view[%c0_index] : i32, view<5xi32>

  view.store %one, %values_view[%c1_index] : f64, view<5xf64>
  %add_old = view.atomic.rmw<addf> %two, %values_view[%c1_index] {ordering = acquire, scope = subgroup} : f64, view<5xf64> -> f64
  %add_final = view.load %values_view[%c1_index] : view<5xf64> -> f64
  %add_old_bits = scalar.bitcast %add_old : f64 to i64
  %add_final_bits = scalar.bitcast %add_final : f64 to i64
  %add_old_ok = scalar.cmpi eq, %add_old_bits, %initial_value_bits : i64
  %add_final_ok = scalar.cmpi eq, %add_final_bits, %combined_value_bits : i64
  %add_ok = scalar.andi %add_old_ok, %add_final_ok : i1
  %add_result = scf.select %add_ok, %success, %failure : i32
  view.store %add_result, %results_view[%c1_index] : i32, view<5xi32>

  view.store %positive_zero, %values_view[%c2_index] : f64, view<5xf64>
  %minimum_old = view.atomic.rmw<minimumf> %negative_zero, %values_view[%c2_index] {ordering = release, scope = workgroup} : f64, view<5xf64> -> f64
  %minimum_final = view.load %values_view[%c2_index] : view<5xf64> -> f64
  %minimum_old_bits = scalar.bitcast %minimum_old : f64 to i64
  %minimum_final_bits = scalar.bitcast %minimum_final : f64 to i64
  %minimum_old_ok = scalar.cmpi eq, %minimum_old_bits, %positive_signed_zero_bits : i64
  %minimum_final_ok = scalar.cmpi eq, %minimum_final_bits, %negative_signed_zero_bits : i64
  %minimum_ok = scalar.andi %minimum_old_ok, %minimum_final_ok : i1
  %minimum_result = scf.select %minimum_ok, %success, %failure : i32
  view.store %minimum_result, %results_view[%c2_index] : i32, view<5xi32>

  view.store %nan, %values_view[%c3_index] : f64, view<5xf64>
  %minnum_old = view.atomic.rmw<minnumf> %one, %values_view[%c3_index] {ordering = acq_rel, scope = device} : f64, view<5xf64> -> f64
  %minnum_final = view.load %values_view[%c3_index] : view<5xf64> -> f64
  %minnum_old_bits = scalar.bitcast %minnum_old : f64 to i64
  %minnum_final_bits = scalar.bitcast %minnum_final : f64 to i64
  %minnum_old_ok = scalar.cmpi eq, %minnum_old_bits, %nan_bits : i64
  %minnum_final_ok = scalar.cmpi eq, %minnum_final_bits, %initial_value_bits : i64
  %minnum_ok = scalar.andi %minnum_old_ok, %minnum_final_ok : i1
  %minnum_result = scf.select %minnum_ok, %success, %failure : i32
  view.store %minnum_result, %results_view[%c3_index] : i32, view<5xi32>

  view.store %nan, %values_view[%c4_index] : f64, view<5xf64>
  %cmpx_old = view.atomic.cmpxchg %nan, %two, %values_view[%c4_index] {failure_ordering = acquire, scope = device, success_ordering = acq_rel} : f64, view<5xf64> -> f64
  %cmpx_final = view.load %values_view[%c4_index] : view<5xf64> -> f64
  %cmpx_old_bits = scalar.bitcast %cmpx_old : f64 to i64
  %cmpx_final_bits = scalar.bitcast %cmpx_final : f64 to i64
  %cmpx_old_ok = scalar.cmpi eq, %cmpx_old_bits, %nan_bits : i64
  %cmpx_final_ok = scalar.cmpi eq, %cmpx_final_bits, %update_value_bits : i64
  %cmpx_ok = scalar.andi %cmpx_old_ok, %cmpx_final_ok : i1
  %cmpx_result = scf.select %cmpx_ok, %success, %failure : i32
  view.store %cmpx_result, %results_view[%c4_index] : i32, view<5xi32>
  kernel.return
}

