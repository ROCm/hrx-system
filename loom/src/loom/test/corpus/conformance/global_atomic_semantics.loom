  %value_global = buffer.assume.memory_space<global> %value : buffer
  %result_global = buffer.assume.memory_space<global> %result : buffer
  %value_aligned = buffer.assume.alignment %value_global {minimum_alignment = 2} : buffer
  %result_aligned = buffer.assume.alignment %result_global {minimum_alignment = 4} : buffer
  %value_view = buffer.view %value_aligned[%base] : buffer -> view<1xf16>
