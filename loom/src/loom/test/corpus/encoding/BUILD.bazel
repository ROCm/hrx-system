load("//build_tools/bazel:executable.bzl", "iree_executable_test")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")
load("//loom/build_tools/bazel:loom_link.bzl", "loom_link_module")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

exports_files([
    "fp8_bidirectional_decode_e4m3.loom",
    "fp8_bidirectional_decode_e5m2.loom",
    "fp8_bidirectional_encode_e4m3.loom",
    "fp8_bidirectional_encode_e5m2.loom",
    "fp8_encode.loom",
    "mxfp4_decode_bf16.loom",
])

loom_link_module(
    name = "numeric_conversion_test_module",
    srcs = [
        "fp8_bidirectional_decode_e4m3.loom",
        "fp8_bidirectional_decode_e5m2.loom",
        "fp8_bidirectional_encode_e4m3.loom",
        "fp8_bidirectional_encode_e5m2.loom",
        "fp8_encode.loom",
        "mxfp4_decode_bf16.loom",
    ],
    configs = [
        "fp8_bidirectional_decode.row_capacity=65536",
        "fp8_bidirectional_encode.row_capacity=65536",
        "fp8_encode.row_capacity=65536",
    ],
    output = "numeric_conversion_test.loombc",
    output_format = "bc",
    require_resolved_config = True,
)

iree_executable_test(
    name = "numeric_conversion_amdgpu_test",
    src = "//loom/src/loom/tools/iree-test-loom",
    args = [
        "$(rootpath :numeric_conversion_test_module)",
        "--device=amdgpu",
    ],
    data = [":numeric_conversion_test_module"],
    tags = [
        "iree-run-requirement=runtime.resource.amd_gpu",
        "requires-gpu-amd",
        "runtime-resource=amd-gpu",
    ],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/execute:amdgpu_hal",
    ]),
)
