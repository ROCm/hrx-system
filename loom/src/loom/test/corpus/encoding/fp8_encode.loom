// The pair gives the device benchmark a physical conversion baseline and a
// schema-driven candidate with identical launch geometry and data movement.
check.benchmark<@f32_to_fp8_random_case> @f32_to_fp8_fptrunc_rows {row_count = 65536}

check.benchmark<@f32_to_fp8_schema_random_case> @f32_to_fp8_schema_rows {row_count = 65536}
