check.case public @f32_to_fp8_random_case {
  %row_count = check.param.choice values([257, 65536]) name("row_count") : index
  %seed = check.param.seed base(77185700745272) count(1) : i64
  %input = check.generate.random.uniform seed(%seed) range(-1024.0 to 1024.0) : tensor<[%row_count]x4xf32>
  %output = check.generate.fill value(0.0) : tensor<[%row_count]x4xf8E4M3>
  %expected = check.generate.random.uniform seed(%seed) range(-1024.0 to 1024.0) : tensor<[%row_count]x4xf8E4M3>
  kernel.launch @f32_to_fp8[%row_count](%row_count, %input, %output) : [index](index, tensor<[%row_count]x4xf32>, tensor<[%row_count]x4xf8E4M3>)
  check.expect.bitwise actual(%output) expected(%expected) : tensor<[%row_count]x4xf8E4M3>
  check.return
}

check.case public @f32_to_fp8_schema_random_case {
  %row_count = check.param.choice values([257, 65536]) name("row_count") : index
  %seed = check.param.seed base(77185700745272) count(1) : i64
  %input = check.generate.random.uniform seed(%seed) range(-1024.0 to 1024.0) : tensor<[%row_count]x4xf32>
  %output = check.generate.fill value(0.0) : tensor<[%row_count]x4xf8E4M3>
  %expected = check.generate.random.uniform seed(%seed) range(-1024.0 to 1024.0) : tensor<[%row_count]x4xf8E4M3>
  kernel.launch @f32_to_fp8_schema[%row_count](%row_count, %input, %output) : [index](index, tensor<[%row_count]x4xf32>, tensor<[%row_count]x4xf8E4M3>)
  check.expect.bitwise actual(%output) expected(%expected) : tensor<[%row_count]x4xf8E4M3>
  check.return
}

check.case public @f32_to_fp8_subnormal_case {
  %row_count = check.literal value(257) : index
  %seed = check.param.seed base(5058442084042167125) count(1) : i64
  %input = check.generate.random.uniform seed(%seed) range(-0.02 to 0.02) : tensor<[%row_count]x4xf32>
  %output = check.generate.fill value(0.0) : tensor<[%row_count]x4xf8E4M3>
  %expected = check.generate.random.uniform seed(%seed) range(-0.02 to 0.02) : tensor<[%row_count]x4xf8E4M3>
