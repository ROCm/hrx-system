  %lane = kernel.workitem.id<x> : index
  %workgroup_size = index.constant 64 : index
  %row = index.madd %workgroup, %workgroup_size, %lane : index
  %vector_column = index.constant 0 : index
  %in_bounds = index.cmp ult, %row, %bounded_row_count : index
  %input_noalias, %output_noalias = buffer.assume.noalias %input, %output : buffer, buffer
  %input_view = buffer.view %input_noalias[%base] : buffer -> view<[%bounded_row_count]x4xi32>
  %output_view = buffer.view %output_noalias[%base] : buffer -> view<[%bounded_row_count]x4xi8>
  %schema = encoding.define #encoding.f8e4m3fn<payload_elements=4, rounding=finite_only> : encoding<schema>
  scf.if %in_bounds {
    %source_bits = vector.load %input_view[%row, %vector_column] : view<[%bounded_row_count]x4xi32> -> vector<4xi32>
    %source = vector.bitcast %source_bits : vector<4xi32> to vector<4xf32>
    %encoded = vector.encode %source using %schema : vector<4xf32>, encoding<schema> -> vector<4xf8E4M3>
    %encoded_bits = vector.bitcast %encoded : vector<4xf8E4M3> to vector<4xi8>
    vector.store %encoded_bits, %output_view[%row, %vector_column] : vector<4xi8>, view<[%bounded_row_count]x4xi8>
  }
  kernel.return
}

