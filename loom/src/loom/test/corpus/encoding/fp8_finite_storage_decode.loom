  %input_noalias, %output_noalias = buffer.assume.noalias %input, %output : buffer, buffer
  %input_layout = encoding.layout.strided [4, 1] : encoding<layout>
  %input_schema = encoding.define #encoding.operand<element_format=f8e4m3fn, payload_elements=4, payload_registers=1, rounding=finite_only> : encoding<schema>
  %input_storage = encoding.define #encoding.storage {layout = %input_layout : encoding<layout>, schema = %input_schema : encoding<schema>} : encoding<storage>
  %input_view = buffer.view %input_noalias[%base] : buffer -> view<[%bounded_row_count]x4xf8E4M3, %input_storage>
  %output_view = buffer.view %output_noalias[%base] : buffer -> view<[%bounded_row_count]x4xbf16>
