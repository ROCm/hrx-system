}

check.case public @fp8_finite_storage_compact_rhs_tile_zero_scale_bf16_k2048_case {
  %output_size = check.param.choice values([16]) name("output_size") : index
  %input_size = check.param.choice values([2048]) name("input_size") : index
  %seed = check.param.seed base(19791451332629071) count(1) : i64
  %weight = check.generate.random.uniform seed(%seed) range(-448.0 to 448.0) : tensor<[%output_size]x[%input_size]xf8E4M3>
  %scale = check.generate.fill value(0.0) : tensor<[%output_size]xf32>
  %target = check.generate.fill value(1.0) : tensor<[%output_size]x[%input_size]xbf16>
  %expected = check.generate.fill value(0.0) : tensor<[%output_size]x[%input_size]xbf16>
  kernel.launch @fp8_finite_storage_compact_rhs_tile_zero_scale_bf16[%output_size, %input_size](%output_size, %input_size, %weight, %scale, %target) : [index, index](index, index, tensor<[%output_size]x[%input_size]xf8E4M3>, tensor<[%output_size]xf32>, tensor<[%output_size]x[%input_size]xbf16>)
  check.expect.close actual(%target) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<[%output_size]x[%input_size]xbf16>
  check.return
}

