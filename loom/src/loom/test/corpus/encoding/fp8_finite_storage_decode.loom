// FP8 checkpoint storage with finite payload facts on the view.
//
// Model checkpoint importers that have validated FP8 weights as finite should
// encode that contract in the physical storage schema. The element type still
// names the logical payload type, while the storage schema tells the compiler
// that loads from the view cannot produce NaN or infinity payloads.
config.decl @finite_storage_decode.row_capacity : %value: index where [range(%value, 1, 4294967295)]

config.decl @finite_storage_decode.input_capacity : %value: index where [range(%value, 16, 65536), mul(%value, 16)]

config.decl @finite_storage_decode.output_capacity : %value: index where [range(%value, 16, 16384), mul(%value, 16)]

kernel.def @fp8_finite_storage_decode(%row_count: index) {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  %rounding = index.constant 63 : index
  %row_capacity = config.get @finite_storage_decode.row_capacity : index
  %rounded_rows = index.add %row_capacity, %rounding : index
  %workgroups = index.div %rounded_rows, %workgroup_size : index
  kernel.launch.config workgroups(%workgroups, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%row_count: index, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %row_capacity = config.get @finite_storage_decode.row_capacity : index
  %bounded_row_count = index.assume %row_count [le(%row_count, %row_capacity)] : index
  %workgroup = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %workgroup_size = index.constant 64 : index
  %vector_column = index.constant 0 : index
  %row = index.madd %workgroup, %workgroup_size, %lane : index
  %in_bounds = index.cmp ult, %row, %bounded_row_count : index
  %input_noalias, %output_noalias = buffer.assume.noalias %input, %output : buffer, buffer
  %input_layout = encoding.layout.strided [4, 1] : encoding<layout>
  %input_schema = encoding.define #encoding.operand<element_format=f8e4m3fn, payload_elements=4, payload_registers=1, rounding=finite_only> : encoding<schema>
  %input_storage = encoding.define #encoding.storage {layout = %input_layout : encoding<layout>, schema = %input_schema : encoding<schema>} : encoding<storage>
  %input_view = buffer.view %input_noalias[%base] : buffer -> view<[%bounded_row_count]x4xf8E4M3, %input_storage>
  %output_view = buffer.view %output_noalias[%base] : buffer -> view<[%bounded_row_count]x4xf32>
  scf.if %in_bounds {
    %packed = vector.load %input_view[%row, %vector_column] : view<[%bounded_row_count]x4xf8E4M3, %input_storage> -> vector<4xf8E4M3>
    %decoded = vector.extf %packed : vector<4xf8E4M3> to vector<4xf32>
    vector.store %decoded, %output_view[%row, %vector_column] : vector<4xf32>, view<[%bounded_row_count]x4xf32>
  }
  kernel.return
}

