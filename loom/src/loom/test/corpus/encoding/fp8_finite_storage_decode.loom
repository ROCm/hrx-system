check.case public @fp8_finite_storage_zero_decode_bf16_case {
  // Zero is finite but still needs exact repair in the packed BF16 decode path.
  %row_count = check.param.choice values([1, 65]) name("row_count") : index
  %input = check.generate.fill value(0.0) : tensor<[%row_count]x4xf8E4M3>
  %output = check.generate.fill value(1.0) : tensor<[%row_count]x4xbf16>
  %expected = check.generate.fill value(0.0) : tensor<[%row_count]x4xbf16>
  kernel.launch @fp8_finite_storage_decode_bf16[%row_count](%row_count, %input, %output) : [index](index, tensor<[%row_count]x4xf8E4M3>, tensor<[%row_count]x4xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<[%row_count]x4xbf16>
  check.return
}

check.case public @fp8_finite_storage_mixed_subnormal_decode_bf16_case {
  // Span -7 through +7 subnormal units, zero, and the minimum normal value
  // across adjacent packed lanes.
  %row_count = check.param.choice values([4]) name("row_count") : index
  %input = check.generate.iota offset(-0.013671875) step(0.001953125) : tensor<[%row_count]x4xf8E4M3>
  %output = check.generate.fill value(0.0) : tensor<[%row_count]x4xbf16>
  %expected = check.generate.iota offset(-0.013671875) step(0.001953125) : tensor<[%row_count]x4xbf16>
  kernel.launch @fp8_finite_storage_decode_bf16[%row_count](%row_count, %input, %output) : [index](index, tensor<[%row_count]x4xf8E4M3>, tensor<[%row_count]x4xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<[%row_count]x4xbf16>
  check.return
}

