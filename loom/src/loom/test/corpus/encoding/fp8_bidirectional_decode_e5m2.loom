  %output = check.generate.fill value(0) : tensor<16xi16>
  %expected = check.generate.fill value(0) : tensor<16xi16>
  kernel.launch @fp8_decode_f8e5m2fnuz_bf16_exact(%output) : (tensor<16xi16>)
  check.expect.equal actual(%output) expected(%expected) : tensor<16xi16>
