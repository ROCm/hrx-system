  %bounded_row_count = index.assume %row_count [le(%row_count, %row_capacity)] : index
  %workgroup = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %workgroup_size = index.constant 64 : index
  %row = index.madd %workgroup, %workgroup_size, %lane : index
  %column = index.constant 0 : index
  %in_bounds = index.cmp ult, %row, %bounded_row_count : index
  %input_noalias, %output_noalias = buffer.assume.noalias %input, %output : buffer, buffer
  %input_view = buffer.view %input_noalias[%base] : buffer -> view<[%bounded_row_count]x8xbf16>
  %output_view = buffer.view %output_noalias[%base] : buffer -> view<[%bounded_row_count]x8xi8>
  %schema = encoding.define #encoding.f8e4m3fnuz<payload_elements=8> : encoding<schema>
  scf.if %in_bounds {
    %source = vector.load %input_view[%row, %column] : view<[%bounded_row_count]x8xbf16> -> vector<8xbf16>
    %encoded = vector.encode %source using %schema : vector<8xbf16>, encoding<schema> -> vector<8xf8E4M3>
    %encoded_bits = vector.bitcast %encoded : vector<8xf8E4M3> to vector<8xi8>
    vector.store %encoded_bits, %output_view[%row, %column] : vector<8xi8>, view<[%bounded_row_count]x8xi8>
  }
  kernel.return
}

check.case public @fp8_encode_f8e4m3fnuz_bf16_exact_case {
  %output = check.generate.fill value(0) : tensor<16xi8>
  %expected = check.generate.fill value(0) : tensor<16xi8>
  kernel.launch @fp8_encode_f8e4m3fnuz_bf16_exact(%output) : (tensor<16xi8>)
  check.expect.equal actual(%output) expected(%expected) : tensor<16xi8>
  check.return
}

check.case public @fp8_encode_f8e4m3fnuz_bf16_rows_case {
  %row_count = check.param.choice values([257, 65536]) name("row_count") : index
  %input = check.generate.fill value(1.0) : tensor<[%row_count]x8xbf16>
  %output = check.generate.fill value(0) : tensor<[%row_count]x8xi8>
  %expected = check.generate.fill value(64) : tensor<[%row_count]x8xi8>
  kernel.launch @fp8_encode_f8e4m3fnuz_bf16_rows[%row_count](%row_count, %input, %output) : [index](index, tensor<[%row_count]x8xbf16>, tensor<[%row_count]x8xi8>)
  check.expect.equal actual(%output) expected(%expected) : tensor<[%row_count]x8xi8>
  check.return
}

check.benchmark<@fp8_encode_f8e4m3fnuz_bf16_rows_case> @fp8_encode_f8e4m3fnuz_bf16_rows_benchmark {row_count = 65536}
