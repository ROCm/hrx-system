// f8e4m3fnuz to bf16: exact special values and finite
// boundaries through two packed eight-lane conversions. The final zero
// lane pads the fifteen semantic witnesses to a complete register.
// NaN sign is outside the numeric contract and is the only result bit
// excluded from the exact comparison.
kernel.def @fp8_decode_f8e4m3fnuz_bf16_exact() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%output: buffer) {
  %base = index.constant 0 : offset
  %head_offset = index.constant 0 : index
  %tail_offset = index.constant 8 : index
  %output_view = buffer.view %output[%base] : buffer -> view<16xi16>
  %head_schema = encoding.define #encoding.f8e4m3fnuz<payload_elements=8> : encoding<schema>
  %tail_schema = encoding.define #encoding.f8e4m3fnuz<payload_elements=8> : encoding<schema>
  %comparison_mask_all_bits = scalar.constant -1 : i16
  %comparison_mask_without_sign = scalar.constant 32767 : i16
  %source_positive_zero_decode = scalar.constant 0 : i8
  %expected_positive_zero_decode = scalar.constant 0 : i16
  %source_negative_zero_or_nan_decode = scalar.constant -128 : i8
  %expected_negative_zero_or_nan_decode = scalar.constant 32704 : i16
  %source_minimum_subnormal_decode = scalar.constant 1 : i8
  %expected_minimum_subnormal_decode = scalar.constant 14976 : i16
  %source_negative_minimum_subnormal_decode = scalar.constant -127 : i8
  %expected_negative_minimum_subnormal_decode = scalar.constant -17792 : i16
  %source_maximum_subnormal_decode = scalar.constant 7 : i8
  %expected_maximum_subnormal_decode = scalar.constant 15328 : i16
  %source_negative_maximum_subnormal_decode = scalar.constant -121 : i8
  %expected_negative_maximum_subnormal_decode = scalar.constant -17440 : i16
  %source_minimum_normal_decode = scalar.constant 8 : i8
  %expected_minimum_normal_decode = scalar.constant 15360 : i16
  %source_negative_minimum_normal_decode = scalar.constant -120 : i8
  %expected_negative_minimum_normal_decode = scalar.constant -17408 : i16
  %source_one_decode = scalar.constant 64 : i8
  %expected_one_decode = scalar.constant 16256 : i16
  %source_negative_one_decode = scalar.constant -64 : i8
  %expected_negative_one_decode = scalar.constant -16512 : i16
  %source_maximum_finite_decode = scalar.constant 127 : i8
  %expected_maximum_finite_decode = scalar.constant 17264 : i16
  %source_negative_maximum_finite_decode = scalar.constant -1 : i8
  %expected_negative_maximum_finite_decode = scalar.constant -15504 : i16
  %source_finite_payload_2_decode = scalar.constant 2 : i8
  %expected_finite_payload_2_decode = scalar.constant 15104 : i16
  %source_finite_payload_3_decode = scalar.constant 3 : i8
  %expected_finite_payload_3_decode = scalar.constant 15168 : i16
  %source_finite_payload_4_decode = scalar.constant 4 : i8
  %expected_finite_payload_4_decode = scalar.constant 15232 : i16
  %source_bits_head = vector.from_elements %source_positive_zero_decode, %source_negative_zero_or_nan_decode, %source_minimum_subnormal_decode, %source_negative_minimum_subnormal_decode, %source_maximum_subnormal_decode, %source_negative_maximum_subnormal_decode, %source_minimum_normal_decode, %source_negative_minimum_normal_decode : vector<8xi8>
  %expected_bits_head = vector.from_elements %expected_positive_zero_decode, %expected_negative_zero_or_nan_decode, %expected_minimum_subnormal_decode, %expected_negative_minimum_subnormal_decode, %expected_maximum_subnormal_decode, %expected_negative_maximum_subnormal_decode, %expected_minimum_normal_decode, %expected_negative_minimum_normal_decode : vector<8xi16>
  %comparison_mask_head = vector.from_elements %comparison_mask_all_bits, %comparison_mask_without_sign, %comparison_mask_all_bits, %comparison_mask_all_bits, %comparison_mask_all_bits, %comparison_mask_all_bits, %comparison_mask_all_bits, %comparison_mask_all_bits : vector<8xi16>
  %source_head = vector.bitcast %source_bits_head : vector<8xi8> to vector<8xf8E4M3>
  %decoded_head = vector.decode %source_head using %head_schema : vector<8xf8E4M3>, encoding<schema> -> vector<8xbf16>
  %decoded_bits_head = vector.bitcast %decoded_head : vector<8xbf16> to vector<8xi16>
  %raw_difference_head = vector.xori %decoded_bits_head, %expected_bits_head : vector<8xi16>
  %difference_head = vector.andi %raw_difference_head, %comparison_mask_head : vector<8xi16>
  vector.store %difference_head, %output_view[%head_offset] : vector<8xi16>, view<16xi16>
  %source_bits_tail = vector.from_elements %source_one_decode, %source_negative_one_decode, %source_maximum_finite_decode, %source_negative_maximum_finite_decode, %source_finite_payload_2_decode, %source_finite_payload_3_decode, %source_finite_payload_4_decode, %source_positive_zero_decode : vector<8xi8>
  %expected_bits_tail = vector.from_elements %expected_one_decode, %expected_negative_one_decode, %expected_maximum_finite_decode, %expected_negative_maximum_finite_decode, %expected_finite_payload_2_decode, %expected_finite_payload_3_decode, %expected_finite_payload_4_decode, %expected_positive_zero_decode : vector<8xi16>
  %comparison_mask_tail = vector.from_elements %comparison_mask_all_bits, %comparison_mask_all_bits, %comparison_mask_all_bits, %comparison_mask_all_bits, %comparison_mask_all_bits, %comparison_mask_all_bits, %comparison_mask_all_bits, %comparison_mask_all_bits : vector<8xi16>
  %source_tail = vector.bitcast %source_bits_tail : vector<8xi8> to vector<8xf8E4M3>
  %decoded_tail = vector.decode %source_tail using %tail_schema : vector<8xf8E4M3>, encoding<schema> -> vector<8xbf16>
  %decoded_bits_tail = vector.bitcast %decoded_tail : vector<8xbf16> to vector<8xi16>
  %raw_difference_tail = vector.xori %decoded_bits_tail, %expected_bits_tail : vector<8xi16>
  %difference_tail = vector.andi %raw_difference_tail, %comparison_mask_tail : vector<8xi16>
  vector.store %difference_tail, %output_view[%tail_offset] : vector<8xi16>, view<16xi16>
  kernel.return
}

