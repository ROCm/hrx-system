// Indexed row gather with loaded row ids and real dynamic view extents.
//
// This is the compact authoring shape for indexed row gathers. The source
// keeps row and column coordinates in `index`, lets kernel ABI buffers publish
// their global memory-space facts, states only aliasing explicitly, and guards
// an i32 row id before casting it to an index.
config.decl @indexed_row_gather_f32.row_capacity : %value: index where [range(%value, 1, 65535)]

config.decl @indexed_row_gather_f32.column_capacity : %value: index where [range(%value, 1, 65535)]

config.decl @indexed_row_gather_f32.source_row_capacity : %value: index where [range(%value, 1, 65535)]

kernel.def @indexed_row_gather_f32(%nrows: index, %ncols: index, %source_rows: index) {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 256 : index
  %rounding = index.constant 255 : index
  %row_capacity = config.get @indexed_row_gather_f32.row_capacity : index
  %column_capacity = config.get @indexed_row_gather_f32.column_capacity : index
  %element_capacity = index.mul %row_capacity, %column_capacity : index
  %rounded = index.add %element_capacity, %rounding : index
  %workgroups = index.div %rounded, %workgroup_size : index
  kernel.launch.config workgroups(%workgroups, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%nrows: index, %ncols: index, %source_rows: index, %source: buffer, %indices: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %minimum_row_id = scalar.constant 0 : i32
  %workgroup = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %workgroup_size = index.constant 256 : index
  %row_capacity = config.get @indexed_row_gather_f32.row_capacity : index
  %bounded_ncols = config.get @indexed_row_gather_f32.column_capacity : index
  %bounded_source_rows = config.get @indexed_row_gather_f32.source_row_capacity : index
  %bounded_nrows = index.assume %nrows [range(%nrows, 1, 65535), le(%nrows, %row_capacity)] : index
  %linear = index.madd %workgroup, %workgroup_size, %lane : index
  %total = index.mul %bounded_nrows, %bounded_ncols : index
  %in_bounds = index.cmp ult, %linear, %total : index
  %source_noalias, %indices_noalias, %output_noalias = buffer.assume.noalias %source, %indices, %output : buffer, buffer, buffer
  %source_view = buffer.view %source_noalias[%base] : buffer -> view<[%bounded_source_rows]x[%bounded_ncols]xf32>
  %indices_view = buffer.view %indices_noalias[%base] : buffer -> view<[%bounded_nrows]xi32>
  %output_view = buffer.view %output_noalias[%base] : buffer -> view<[%bounded_nrows]x[%bounded_ncols]xf32>
  scf.if %in_bounds {
    %column0 = index.rem %linear, %bounded_ncols : index
    %column = index.assume %column0 [range(%column0, 0, 65534), lt(%column0, %bounded_ncols)] : index
    %row0 = index.div %linear, %bounded_ncols : index
    %row = index.assume %row0 [range(%row0, 0, 65534), lt(%row0, %bounded_nrows)] : index
    %source_row_i32 = view.load %indices_view[%row] : view<[%bounded_nrows]xi32> -> i32
    %source_row_nonnegative = scalar.cmpi sge, %source_row_i32, %minimum_row_id : i32
    scf.if %source_row_nonnegative {
      %source_row = index.cast %source_row_i32 : i32 to index
      %source_row_valid = index.cmp ult, %source_row, %bounded_source_rows : index
      scf.if %source_row_valid {
        %value = view.load %source_view[%source_row, %column] : view<[%bounded_source_rows]x[%bounded_ncols]xf32> -> f32
        view.store %value, %output_view[%row, %column] : f32, view<[%bounded_nrows]x[%bounded_ncols]xf32>
      }
    }
  }
  kernel.return
}

check.case public @indexed_row_gather_f32_case {
  %nrows = check.param.choice values([1, 5]) name("nrows") : index
  %ncols = check.literal value(4) : index
  %source_rows = check.literal value(2) : index
  %source = check.generate.fill value(7.0) : tensor<2x4xf32>
  %indices = check.generate.fill value(1) : tensor<[%nrows]xi32>
  %output = check.generate.fill value(0.0) : tensor<[%nrows]x4xf32>
  %expected = check.generate.fill value(7.0) : tensor<[%nrows]x4xf32>
  kernel.launch @indexed_row_gather_f32[%nrows, %ncols, %source_rows](%nrows, %ncols, %source_rows, %source, %indices, %output) : [index, index, index](index, index, index, tensor<2x4xf32>, tensor<[%nrows]xi32>, tensor<[%nrows]x4xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<[%nrows]x4xf32>
  check.return
}

check.benchmark<@indexed_row_gather_f32_case>

check.benchmark<@indexed_row_gather_f32_case> @indexed_row_gather_f32_single {nrows = 1}

check.benchmark<@indexed_row_gather_f32_case> @indexed_row_gather_f32_rows {nrows = 5}
