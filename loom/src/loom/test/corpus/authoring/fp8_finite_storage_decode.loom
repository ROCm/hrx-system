// FP8 checkpoint storage with finite payload facts on the view.
//
// Model checkpoint importers that have validated FP8 weights as finite should
// encode that contract in the physical storage schema. The element type still
// names the logical payload type, while the storage schema tells the compiler
// that loads from the view cannot produce NaN or infinity payloads.
kernel.def @fp8_finite_storage_decode(%row_count: index) {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  %rounding = index.constant 63 : index
  %rounded_rows = index.add %row_count, %rounding : index
  %workgroups = index.div %rounded_rows, %workgroup_size : index
  kernel.launch.config workgroups(%workgroups, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%row_count: index, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %workgroup = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %workgroup_size = index.constant 64 : index
  %zero_column = index.constant 0 : index

  %row = index.madd %workgroup, %workgroup_size, %lane : index
  %in_bounds = index.cmp ult, %row, %row_count : index

  %input_noalias, %output_noalias = buffer.assume.noalias %input, %output : buffer, buffer
  %input_layout = encoding.layout.strided [4, 1] : encoding<layout>
  %input_schema = encoding.define #matrix_operand<element_format=f8e4m3fn, payload_elements=4, payload_registers=1, rounding=finite_only> : encoding<schema>
  %input_storage = encoding.define #physical_storage {layout = %input_layout : encoding<layout>, schema = %input_schema : encoding<schema>} : encoding<storage>
  %input_view = buffer.view %input_noalias[%base] : buffer -> view<[%row_count]x4xf8E4M3, %input_storage>
  %output_view = buffer.view %output_noalias[%base] : buffer -> view<[%row_count]x4xf32, #dense>

  scf.if %in_bounds {
    %packed = vector.load %input_view[%row, %zero_column] : view<[%row_count]x4xf8E4M3, %input_storage> -> vector<4xf8E4M3>
    %decoded = vector.extf %packed : vector<4xf8E4M3> to vector<4xf32>
    vector.store %decoded, %output_view[%row, %zero_column] : vector<4xf32>, view<[%row_count]x4xf32, #dense>
  }
  kernel.return
}

// Materialize finite FP8 checkpoint rows into BF16 values for BF16 GEMM paths.
kernel.def @fp8_finite_storage_decode_bf16(%row_count: index) {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  %rounding = index.constant 63 : index
  %rounded_rows = index.add %row_count, %rounding : index
  %workgroups = index.div %rounded_rows, %workgroup_size : index
  kernel.launch.config workgroups(%workgroups, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%row_count: index, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %workgroup = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %workgroup_size = index.constant 64 : index
  %zero_column = index.constant 0 : index

  %row = index.madd %workgroup, %workgroup_size, %lane : index
  %in_bounds = index.cmp ult, %row, %row_count : index

  %input_noalias, %output_noalias = buffer.assume.noalias %input, %output : buffer, buffer
  %input_layout = encoding.layout.strided [4, 1] : encoding<layout>
  %input_schema = encoding.define #matrix_operand<element_format=f8e4m3fn, payload_elements=4, payload_registers=1, rounding=finite_only> : encoding<schema>
  %input_storage = encoding.define #physical_storage {layout = %input_layout : encoding<layout>, schema = %input_schema : encoding<schema>} : encoding<storage>
  %input_view = buffer.view %input_noalias[%base] : buffer -> view<[%row_count]x4xf8E4M3, %input_storage>
  %output_view = buffer.view %output_noalias[%base] : buffer -> view<[%row_count]x4xbf16, #dense>

  scf.if %in_bounds {
    %packed = vector.load %input_view[%row, %zero_column] : view<[%row_count]x4xf8E4M3, %input_storage> -> vector<4xf8E4M3>
    %decoded = vector.extf %packed : vector<4xf8E4M3> to vector<4xbf16>
    vector.store %decoded, %output_view[%row, %zero_column] : vector<4xbf16>, view<[%row_count]x4xbf16, #dense>
  }
  kernel.return
}

// Materialize finite FP8 checkpoint rows through per-row scales into BF16.
kernel.def @fp8_finite_storage_scale_decode_bf16(%row_count: index) {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  %rounding = index.constant 63 : index
  %rounded_rows = index.add %row_count, %rounding : index
  %workgroups = index.div %rounded_rows, %workgroup_size : index
  kernel.launch.config workgroups(%workgroups, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%row_count: index, %input: buffer, %scale: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %workgroup = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %workgroup_size = index.constant 64 : index
  %zero_column = index.constant 0 : index

  %row = index.madd %workgroup, %workgroup_size, %lane : index
  %in_bounds = index.cmp ult, %row, %row_count : index

  %input_noalias, %scale_noalias, %output_noalias = buffer.assume.noalias %input, %scale, %output : buffer, buffer, buffer
  %input_layout = encoding.layout.strided [4, 1] : encoding<layout>
  %input_schema = encoding.define #matrix_operand<element_format=f8e4m3fn, payload_elements=4, payload_registers=1, rounding=finite_only> : encoding<schema>
  %input_storage = encoding.define #physical_storage {layout = %input_layout : encoding<layout>, schema = %input_schema : encoding<schema>} : encoding<storage>
  %decode_schema = encoding.define #matrix_operand<affine=scale_only, element_format=f8e4m3fn, payload_elements=4, payload_packing=dense_lanes, payload_registers=0, rounding=finite_only, scale_format=f32, scale_group_elements=4, scale_operands=1, scale_topology=block_1d> : encoding<schema>
  %input_view = buffer.view %input_noalias[%base] : buffer -> view<[%row_count]x4xf8E4M3, %input_storage>
  %scale_view = buffer.view %scale_noalias[%base] : buffer -> view<[%row_count]xf32, #dense>
  %output_view = buffer.view %output_noalias[%base] : buffer -> view<[%row_count]x4xbf16, #dense>

  scf.if %in_bounds {
    %packed = vector.load %input_view[%row, %zero_column] : view<[%row_count]x4xf8E4M3, %input_storage> -> vector<4xf8E4M3>
    %row_scale = view.load %scale_view[%row] : view<[%row_count]xf32, #dense> -> f32
    %scale_vector = vector.splat %row_scale : vector<1xf32>
    %decoded = vector.decode %packed using %decode_schema {scale = %scale_vector : vector<1xf32>} : vector<4xf8E4M3>, encoding<schema> -> vector<4xbf16>
    vector.store %decoded, %output_view[%row, %zero_column] : vector<4xbf16>, view<[%row_count]x4xbf16, #dense>
  }
  kernel.return
}

// Keep adjacent FP8 lanes independent when one finite lane is subnormal and the
// paired lane is normal. This covers the packed repair path used before scaling
// compact FP8 checkpoint payloads into BF16 GEMM inputs.
kernel.def @fp8_finite_storage_zero_scale_mixed_pair_bf16() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %scale: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index

  %input_layout = encoding.layout.strided [1] : encoding<layout>
  %input_schema = encoding.define #matrix_operand<element_format=f8e4m3, payload_elements=8, payload_registers=2, rounding=finite_only> : encoding<schema>
  %input_storage = encoding.define #physical_storage {layout = %input_layout : encoding<layout>, schema = %input_schema : encoding<schema>} : encoding<storage>
  %input_view = buffer.view %input[%base] : buffer -> view<8xf8E4M3, %input_storage>
  %scale_view = buffer.view %scale[%base] : buffer -> view<1xf32, #dense>
  %output_view = buffer.view %output[%base] : buffer -> view<8xbf16, #dense>

  %packed = vector.load %input_view[%zero] : view<8xf8E4M3, %input_storage> -> vector<8xf8E4M3>
  %wide = vector.extf %packed : vector<8xf8E4M3> to vector<8xf32>
  %row_scale = view.load %scale_view[%zero] : view<1xf32, #dense> -> f32
  %scale_vector = vector.splat %row_scale : vector<8xf32>
  %scaled = vector.mulf %wide, %scale_vector : vector<8xf32>
  %rounded = vector.fptrunc %scaled : vector<8xf32> to vector<8xbf16>
  vector.store %rounded, %output_view[%zero] : vector<8xbf16>, view<8xbf16, #dense>
  kernel.return
}

kernel.def @bf8_finite_storage_zero_scale_mixed_pair_bf16() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %scale: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index

  %input_layout = encoding.layout.strided [1] : encoding<layout>
  %input_schema = encoding.define #matrix_operand<element_format=f8e5m2, payload_elements=8, payload_registers=2, rounding=finite_only> : encoding<schema>
  %input_storage = encoding.define #physical_storage {layout = %input_layout : encoding<layout>, schema = %input_schema : encoding<schema>} : encoding<storage>
  %input_view = buffer.view %input[%base] : buffer -> view<8xf8E5M2, %input_storage>
  %scale_view = buffer.view %scale[%base] : buffer -> view<1xf32, #dense>
  %output_view = buffer.view %output[%base] : buffer -> view<8xbf16, #dense>

  %packed = vector.load %input_view[%zero] : view<8xf8E5M2, %input_storage> -> vector<8xf8E5M2>
  %wide = vector.extf %packed : vector<8xf8E5M2> to vector<8xf32>
  %row_scale = view.load %scale_view[%zero] : view<1xf32, #dense> -> f32
  %scale_vector = vector.splat %row_scale : vector<8xf32>
  %scaled = vector.mulf %wide, %scale_vector : vector<8xf32>
  %rounded = vector.fptrunc %scaled : vector<8xf32> to vector<8xbf16>
  vector.store %rounded, %output_view[%zero] : vector<8xbf16>, view<8xbf16, #dense>
  kernel.return
}

check.case public @fp8_finite_storage_decode_case {
  // Cover a single row and a tail row crossing the 64-workitem boundary.
  %row_count = check.param.choice values([1, 65]) name("row_count") : index
  %input = check.generate.fill value(1.0) : tensor<[%row_count]x4xf8E4M3>
  %output = check.generate.fill value(0.0) : tensor<[%row_count]x4xf32>
  %expected = check.generate.fill value(1.0) : tensor<[%row_count]x4xf32>
  func.call @fp8_finite_storage_decode(%row_count, %input, %output) : (index, tensor<[%row_count]x4xf8E4M3>, tensor<[%row_count]x4xf32>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<[%row_count]x4xf32>
  check.return
}

check.case public @fp8_finite_storage_decode_bf16_case {
  // Cover a single row and a tail row crossing the 64-workitem boundary.
  %row_count = check.param.choice values([1, 65]) name("row_count") : index
  %input = check.generate.fill value(1.0) : tensor<[%row_count]x4xf8E4M3>
  %output = check.generate.fill value(0.0) : tensor<[%row_count]x4xbf16>
  %expected = check.generate.fill value(1.0) : tensor<[%row_count]x4xbf16>
  func.call @fp8_finite_storage_decode_bf16(%row_count, %input, %output) : (index, tensor<[%row_count]x4xf8E4M3>, tensor<[%row_count]x4xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<[%row_count]x4xbf16>
  check.return
}

check.case public @fp8_finite_storage_scale_decode_bf16_case {
  // Cover a single row and a tail row crossing the 64-workitem boundary.
  %row_count = check.param.choice values([1, 65]) name("row_count") : index
  %input = check.generate.fill value(1.0) : tensor<[%row_count]x4xf8E4M3>
  %scale = check.generate.fill value(2.0) : tensor<[%row_count]xf32>
  %output = check.generate.fill value(0.0) : tensor<[%row_count]x4xbf16>
  %expected = check.generate.fill value(2.0) : tensor<[%row_count]x4xbf16>
  func.call @fp8_finite_storage_scale_decode_bf16(%row_count, %input, %scale, %output) : (index, tensor<[%row_count]x4xf8E4M3>, tensor<[%row_count]xf32>, tensor<[%row_count]x4xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<[%row_count]x4xbf16>
  check.return
}

check.case public @fp8_finite_storage_zero_scale_mixed_pair_bf16_case {
  // The first pair contains FP8 0x01 and a normal value after materialization.
  %input = check.generate.iota offset(0.001953125) step(43.998046875) : tensor<8xf8E4M3>
  %scale = check.generate.fill value(0.0) : tensor<1xf32>
  %output = check.generate.fill value(1.0) : tensor<8xbf16>
  %expected = check.generate.fill value(0.0) : tensor<8xbf16>
  func.call @fp8_finite_storage_zero_scale_mixed_pair_bf16(%input, %scale, %output) : (tensor<8xf8E4M3>, tensor<1xf32>, tensor<8xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<8xbf16>
  check.return
}

check.case public @bf8_finite_storage_zero_scale_mixed_pair_bf16_case {
  // The first pair contains BF8 0x01 and a normal value after materialization.
  %input = check.generate.iota offset(0.0000152587890625) step(43.9999847412109375) : tensor<8xf8E5M2>
  %scale = check.generate.fill value(0.0) : tensor<1xf32>
  %output = check.generate.fill value(1.0) : tensor<8xbf16>
  %expected = check.generate.fill value(0.0) : tensor<8xbf16>
  func.call @bf8_finite_storage_zero_scale_mixed_pair_bf16(%input, %scale, %output) : (tensor<8xf8E5M2>, tensor<1xf32>, tensor<8xbf16>)
  check.expect.close actual(%output) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<8xbf16>
  check.return
}

check.benchmark<@fp8_finite_storage_decode_case>
check.benchmark<@fp8_finite_storage_decode_case> @fp8_finite_storage_decode_single {row_count = 1}
check.benchmark<@fp8_finite_storage_decode_case> @fp8_finite_storage_decode_tail {row_count = 65}
check.benchmark<@fp8_finite_storage_decode_bf16_case>
check.benchmark<@fp8_finite_storage_decode_bf16_case> @fp8_finite_storage_decode_bf16_single {row_count = 1}
check.benchmark<@fp8_finite_storage_decode_bf16_case> @fp8_finite_storage_decode_bf16_tail {row_count = 65}
check.benchmark<@fp8_finite_storage_scale_decode_bf16_case>
check.benchmark<@fp8_finite_storage_scale_decode_bf16_case> @fp8_finite_storage_scale_decode_bf16_single {row_count = 1}
check.benchmark<@fp8_finite_storage_scale_decode_bf16_case> @fp8_finite_storage_scale_decode_bf16_tail {row_count = 65}
check.benchmark<@fp8_finite_storage_zero_scale_mixed_pair_bf16_case>
check.benchmark<@bf8_finite_storage_zero_scale_mixed_pair_bf16_case>
