load("//loom/build_tools/bazel:defs.bzl", "loom_library", "loom_test_module")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

exports_files(glob(["*.loom"]))

loom_library(
    name = "mlp_down_projection_residual_bf16_library",
    srcs = ["//loom/src/loom/test/corpus/authoring:mlp_down_projection_residual_bf16.loom"],
    tags = ["manual"],
    visibility = ["//visibility:private"],
)

loom_test_module(
    name = "authoring_benchmark_workload_module",
    srcs = glob(["*.loom"]),
    deps = [":mlp_down_projection_residual_bf16_library"],
)
