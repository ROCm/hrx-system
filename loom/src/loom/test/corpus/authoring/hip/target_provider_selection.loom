// HIP concept: wave-size-specialized implementations of one operation.
// Loom spelling: providers state only the normalized target fact they need.
// The kernel and providers remain targetless so this source can specialize for
// AMDGPU, SPIR-V, or another backend that projects a subgroup-size fact.
// Both specialized providers and the fallback implement the same contract:
// double one i32 value. Selection changes the implementation, not semantics.
template.decl @hip.recipe.scale_i32(%value: i32) -> (i32)

template.def<@hip.recipe.scale_i32> requires [#target.subgroup.size<64>] priority(20) @scale_i32_subgroup_64(%value: i32) -> (i32) {
  %scale_factor = scalar.constant 2 : i32
  %scaled = scalar.muli %value, %scale_factor : i32
  template.return %scaled : i32
}

template.def<@hip.recipe.scale_i32> requires [#target.subgroup.size<32>] priority(20) @scale_i32_subgroup_32(%value: i32) -> (i32) {
  %scaled = scalar.addi %value, %value : i32
  template.return %scaled : i32
}

// A correct fallback keeps the library usable when subgroup size is unknown or
// neither specialized size applies.
template.def<@hip.recipe.scale_i32> priority(1) @scale_i32_fallback(%value: i32) -> (i32) {
  %shift = scalar.constant 1 : i32
  %scaled = scalar.shli %value, %shift : i32
  template.return %scaled : i32
}

// The source does not select a backend or processor. A live JIT projects facts
// from its device; offline compilation supplies a profile with --target. The
// launch geometry and provider selection consume the same effective fact.
kernel.def @selects_subgroup_provider() {
  %c1 = index.constant 1 : index
  %subgroup_size = target.subgroup.size : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%subgroup_size, %c1, %c1) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %element_index = index.constant 0 : index
  %input_view = buffer.view %input[%base] : buffer -> view<1xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<1xi32>
  %value = view.load %input_view[%element_index] : view<1xi32> -> i32
  %scaled = template.apply<@hip.recipe.scale_i32>(%value) : (i32) -> (i32)
  view.store %scaled, %output_view[%element_index] : i32, view<1xi32>
  kernel.return
}

check.case @case_target_provider_selection {
  %input = check.generate.fill value(7) : tensor<1xi32>
  %output = check.generate.fill value(0) : tensor<1xi32>
  %expected = check.generate.fill value(14) : tensor<1xi32>
  kernel.launch @selects_subgroup_provider(%input, %output) : (tensor<1xi32>, tensor<1xi32>)
  check.expect.equal actual(%output) expected(%expected) : tensor<1xi32>
  check.return
}

check.benchmark<@case_target_provider_selection> @bench_target_provider_selection
