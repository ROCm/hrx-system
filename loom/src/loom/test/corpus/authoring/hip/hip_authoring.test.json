            "kernel.def target(@gfx11_wave64) @wave64_workgroup_reduce_full_wave",
            "kernel.def target(@gfx11_wave64) @wave64_workgroup_reduce_cross_wave",
            "kernel.def target(@gfx11_wave64) @wave64_workgroup_reduce_sparse_loop_accumulation",
            "kernel.workgroup.reduce<addf>"
