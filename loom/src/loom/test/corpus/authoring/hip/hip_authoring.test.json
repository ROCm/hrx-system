{
  "version": 1,
  "cases": [
    {
      "name": "proves hip lane distribution recipe",
      "run": {
        "tool": "loom-opt",
        "args": [
          "{srcdir}/lane_distribution.loom",
          "--pass=canonicalize",
          "--output={tmp}/lane_distribution.loom"
        ]
      },
      "files": [
        {
          "path": "{tmp}/lane_distribution.loom",
          "contains": [
            "%block_is_uniform = scalar.constant true : i1",
            "%block_is_varying = scalar.constant false : i1",
            "%thread_is_varying = scalar.constant true : i1",
            "%thread_is_uniform = scalar.constant false : i1",
            "%element_is_varying = scalar.constant true : i1",
            "%element_is_uniform = scalar.constant false : i1",
            "%lane_is_varying = scalar.constant true : i1",
            "%predicate_is_lane = scalar.constant true : i1",
            "%selected_is_varying = scalar.constant true : i1",
            "%dot_operand_is_varying = scalar.constant true : i1",
            "%dot_operand_is_uniform = scalar.constant false : i1"
          ]
        }
      ]
    },
    {
      "name": "unrolls q8 hip-shaped dynamic lower bound loop",
      "run": {
        "tool": "loom-opt",
        "args": [
          "{srcdir}/q8_block_unroll.loom",
          "--pass=unroll-scf-for",
          "--pass-report=json",
          "--output={tmp}/q8_block_unrolled.loom"
        ]
      },
      "stderr": {
        "contains": [
          "\"pass\":\"unroll-scf-for\"",
          "\"loops-unrolled\":1",
          "\"category\":\"scf-unroll\"",
          "\"outcome\":\"unrolled\"",
          "\"trip_count\":2",
          "\"step\":8",
          "\"lower_bound_kind\":\"dynamic\"",
          "\"lower_range_min\":0",
          "\"lower_range_max\":7"
        ]
      },
      "files": [
        {
          "path": "{tmp}/q8_block_unrolled.loom",
          "contains": [
            "vector.bitunpacks<8>",
            "vector.dotf"
          ],
          "not_contains": [
            "scf.for %block_idx_raw"
          ]
        }
      ]
    },
    {
      "name": "preserves explicit q8 vector load width recipe",
      "run": {
        "tool": "loom-opt",
        "args": [
          "{srcdir}/q8_load_width.loom",
          "--pass=canonicalize",
          "--output={tmp}/q8_load_width.loom"
        ]
      },
      "files": [
        {
          "path": "{tmp}/q8_load_width.loom",
          "contains": [
            "vector.load %input_words[0] : view<4xi32> -> vector<1xi32>",
            "vector.load %input_words[0] : view<4xi32> -> vector<4xi32>",
            "vector.store %wide, %vector_words[0] : vector<4xi32>, view<4xi32>"
          ]
        }
      ]
    },
    {
      "name": "preserves q8 q4 signedness source shape",
      "run": {
        "tool": "loom-opt",
        "args": [
          "{srcdir}/q8_q4_signedness.loom",
          "--output={tmp}/q8_q4_signedness.loom"
        ]
      },
      "files": [
        {
          "path": "{tmp}/q8_q4_signedness.loom",
          "contains": [
            "vector.bitunpacku<8>",
            "vector.bitunpacks<8>",
            "vector.bitunpacku<4>",
            "vector.bitunpacks<4>",
            "vector.dot4i<u8s8>"
          ]
        }
      ]
    },
    {
      "name": "preserves shared memory tile source shape",
      "run": {
        "tool": "loom-opt",
        "args": [
          "{srcdir}/shared_memory_tile.loom",
          "--pass=canonicalize",
          "--output={tmp}/shared_memory_tile.loom"
        ]
      },
      "files": [
        {
          "path": "{tmp}/shared_memory_tile.loom",
          "contains": [
            "buffer.alloca<workgroup> align(16) %scratch_bytes : buffer",
            "vector.store %loaded, %scratch_view[%lane] : vector<1xi32>, view<64xi32>",
            "kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)",
            "vector.load %scratch_view[%reverse_lane] : view<64xi32> -> vector<1xi32>"
          ]
        }
      ]
    },
    {
      "name": "compiles shared memory tile to AMDGPU HAL artifact",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/shared_memory_tile.loom",
          "--backend=amdgpu-hal",
          "--target=gfx11-generic",
          "--output={tmp}/shared_memory_tile.hal",
          "--emit-target-artifact={tmp}/shared_memory_tile.hsaco",
          "--artifact-manifest=summary",
          "--compile-report=summary"
        ]
      },
      "stderr": {
        "contains": {
          "unordered": [
            "\"target_key\":\"gfx11-generic\"",
            "\"artifact_format\":\"elf\"",
            "\"status\":{\"code\":0,\"name\":\"OK\"}",
            "\"local_memory_bytes\":256",
            "\"local_memory_count\":2",
            "\"barrier_count\":1"
          ]
        }
      },
      "files": [
        {
          "path": "{tmp}/shared_memory_tile.hal",
          "non_empty": true
        },
        {
          "path": "{tmp}/shared_memory_tile.hsaco",
          "non_empty": true
        },
        {
          "path": "{tmp}/shared_memory_tile.hsaco.manifest.json",
          "non_empty": true
        }
      ]
    },
    {
      "name": "preserves shared memory wave tile source shape",
      "run": {
        "tool": "loom-opt",
        "args": [
          "{srcdir}/shared_memory_wave_tile.loom",
          "--pass=canonicalize",
          "--output={tmp}/shared_memory_wave_tile.loom"
        ]
      },
      "files": [
        {
          "path": "{tmp}/shared_memory_wave_tile.loom",
          "contains": [
            "view.store %value, %scratch_view[%lane] : i32, view<32xi32>",
            "kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)",
            "view.load %scratch_view[%lane] : view<32xi32> -> i32",
            "view.store %value, %scratch_view[%scratch_index] : i32, view<40xi32>",
            "view.load %scratch_view[%scratch_index] : view<40xi32> -> i32",
            "%result = scf.if %is_active_lane -> (i32)",
            "scf.yield %roundtrip : i32",
            "scf.yield %value : i32",
            "vector.store %word0, %scratch_view[%lane] : vector<1xi32>, view<256xi32>",
            "vector.store %word1, %scratch_view[%second_region_index] : vector<1xi32>, view<256xi32>",
            "vector.load %scratch_view[%lane] : view<256xi32> -> vector<1xi32>",
            "vector.load %scratch_view[%second_region_index] : view<256xi32> -> vector<1xi32>"
          ]
        }
      ]
    },
    {
      "name": "compiles shared memory wave tile to AMDGPU HAL artifact",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/shared_memory_wave_tile.loom",
          "--backend=amdgpu-hal",
          "--target=gfx11-generic",
