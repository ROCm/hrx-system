      "stderr": {
        "contains": {
          "unordered": [
            "\"target_key\":\"gfx11-generic\"",
            "\"artifact_format\":\"elf\"",
            "\"status\":{\"code\":0,\"name\":\"OK\"}",
            "\"function\":\"shared_memory_wave_i32_roundtrip\"",
            "\"function\":\"shared_memory_wave_i32_roundtrip_static_offset\"",
            "\"function\":\"shared_memory_wave_i32_partial_lane_roundtrip\"",
            "\"function\":\"shared_memory_cross_wave_i32_roundtrip_two_regions\"",
            "\"local_memory_bytes\":128",
            "\"local_memory_bytes\":160",
            "\"local_memory_bytes\":1024",
            "\"local_memory_count\":10"
          ]
        }
      },
      "files": [
        {
          "path": "{tmp}/shared_memory_wave_tile.hal",
          "non_empty": true
        },
        {
          "path": "{tmp}/shared_memory_wave_tile.hsaco",
          "non_empty": true
        },
        {
          "path": "{tmp}/shared_memory_wave_tile.hsaco.manifest.json",
          "non_empty": true
        }
      ]
    },
    {
      "name": "preserves wave64 reductions source shape",
      "run": {
        "tool": "loom-opt",
        "args": [
          "{srcdir}/wave64_reductions.loom",
