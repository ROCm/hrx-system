{
  "version": 1,
  "cases": [
    {
      "name": "compiles wave64 reductions to AMDGPU HAL artifact",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/wave64_reductions.loom",
          "--backend=amdgpu-hal",
          "--target=gfx1151",
          "--output={tmp}/wave64_reductions.hal",
          "--emit-target-artifact={tmp}/wave64_reductions.hsaco",
          "--artifact-manifest=summary",
          "--compile-report=summary"
        ]
      },
      "stderr": {
        "contains": {
          "unordered": [
            "\"target_key\":\"gfx1151\"",
            "\"artifact_format\":\"elf\"",
            "\"status\":{\"code\":0,\"name\":\"OK\"}",
            "\"function\":\"wave64_workgroup_reduce_sub_wave\"",
            "\"function\":\"wave64_workgroup_reduce_full_wave\"",
            "\"function\":\"wave64_workgroup_reduce_cross_wave\"",
            "\"local_memory_bytes\":8",
            "\"local_memory_bytes\":16",
            "\"barrier_count\":1"
          ]
        }
      },
      "files": [
        {
          "path": "{tmp}/wave64_reductions.hal",
          "non_empty": true
        },
        {
          "path": "{tmp}/wave64_reductions.hsaco",
          "non_empty": true
        },
        {
          "path": "{tmp}/wave64_reductions.hsaco.manifest.json",
          "contains": [
            "\"family\":\"amdgpu\"",
            "\"selector\":\"gfx1151\"",
            "\"processor\":\"gfx1151\"",
            "\"code_object_target\":\"amdgcn-amd-amdhsa--gfx1151\""
          ]
        }
      ]
    },
    {
      "name": "compiles shared memory vector tile to AMDGPU HAL artifact",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/shared_memory_vector_tile.loom",
          "--backend=amdgpu-hal",
          "--target=gfx11-generic",
          "--output={tmp}/shared_memory_vector_tile.hal",
          "--emit-target-artifact={tmp}/shared_memory_vector_tile.hsaco",
          "--artifact-manifest=summary",
          "--compile-report=summary"
        ]
      },
      "stderr": {
        "contains": {
          "unordered": [
            "\"target_key\":\"gfx11-generic\"",
            "\"artifact_format\":\"elf\"",
            "\"status\":{\"code\":0,\"name\":\"OK\"}",
            "\"local_memory_bytes\":1024",
            "\"local_memory_count\":2",
            "\"barrier_count\":1"
          ]
        }
      },
      "files": [
        {
          "path": "{tmp}/shared_memory_vector_tile.hal",
          "non_empty": true
        },
        {
          "path": "{tmp}/shared_memory_vector_tile.hsaco",
          "non_empty": true
        },
        {
          "path": "{tmp}/shared_memory_vector_tile.hsaco.manifest.json",
          "non_empty": true
        }
      ]
    },
    {
      "name": "compiles gfx1250 cluster b128 multicast recipe",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/cluster_b128_multicast.loom",
          "--backend=amdgpu-hal",
          "--target=gfx1250",
          "--output={tmp}/cluster_b128_multicast.hal",
          "--emit-target-artifact={tmp}/cluster_b128_multicast.hsaco",
          "--artifact-manifest=summary",
          "--compile-report=summary"
        ]
      },
      "stderr": {
        "contains": {
          "unordered": [
            "\"target_key\":\"gfx1250\"",
            "\"artifact_format\":\"elf\"",
            "\"status\":{\"code\":0,\"name\":\"OK\"}",
            "\"cluster_size\":{\"x\":1,\"y\":2,\"z\":1,\"flat\":2}",
            "\"local_memory_bytes\":512",
            "\"explicit_action_count\":1",
            "\"barrier_count\":0"
          ]
        }
      },
      "files": [
        {
          "path": "{tmp}/cluster_b128_multicast.hal",
          "non_empty": true
        },
        {
          "path": "{tmp}/cluster_b128_multicast.hsaco",
          "non_empty": true
        },
        {
          "path": "{tmp}/cluster_b128_multicast.hsaco.manifest.json",
          "non_empty": true
        }
      ]
    }
  ]
}
