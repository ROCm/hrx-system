// HIP -> Loom target-template math legalization recipe.
//
// HIP concept tags: template, specialization, expf, vector math, target
// legalization, device function, inline.
//
// Position: provider selection and inlining establish the concrete body after
// the compile or JIT invocation specializes this targetless kernel. Math
// authored inside the selected provider then follows the same target policy
// and lowering path as math written directly in the caller.
// HIP concept:
//   template <typename MathPolicy>
//   __device__ float4 evaluate_exp(float scalar, float4 values);
//
// Loom spelling: keep the semantic operation in the provider. The target
// pipeline selects and materializes this body before legalizing `expf` to the
// target's supported operation and approximation policy.
template.decl @hip.recipe.exp_f32(%scalar: f32, %values: vector<4xf32>) -> (f32, vector<4xf32>)

template.def<@hip.recipe.exp_f32> device @exp_f32_provider(%scalar: f32, %values: vector<4xf32>) -> (f32, vector<4xf32>) {
  %scalar_result = scalar.expf<afn> %scalar : f32
  %vector_result = vector.expf<afn> %values : vector<4xf32>
  template.return %scalar_result, %vector_result : f32, vector<4xf32>
}

kernel.def @template_math_legalization() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%scalar_input: buffer, %vector_input: buffer, %scalar_output: buffer, %vector_output: buffer) {
  %base = index.constant 0 : offset
  %element_index = index.constant 0 : index
  %scalar_input_noalias, %vector_input_noalias, %scalar_output_noalias, %vector_output_noalias = buffer.assume.noalias %scalar_input, %vector_input, %scalar_output, %vector_output : buffer, buffer, buffer, buffer
  %scalar_input_view = buffer.view %scalar_input_noalias[%base] : buffer -> view<1xf32>
  %vector_input_view = buffer.view %vector_input_noalias[%base] : buffer -> view<4xf32>
  %scalar_output_view = buffer.view %scalar_output_noalias[%base] : buffer -> view<1xf32>
  %vector_output_view = buffer.view %vector_output_noalias[%base] : buffer -> view<4xf32>
  %scalar = view.load %scalar_input_view[%element_index] : view<1xf32> -> f32
  %values = vector.load %vector_input_view[%element_index] : view<4xf32> -> vector<4xf32>
  %scalar_result, %vector_result = template.apply<@hip.recipe.exp_f32>(%scalar, %values) : (f32, vector<4xf32>) -> (f32, vector<4xf32>)
  view.store %scalar_result, %scalar_output_view[%element_index] : f32, view<1xf32>
  vector.store %vector_result, %vector_output_view[%element_index] : vector<4xf32>, view<4xf32>
  kernel.return
}

check.case @case_template_math_legalization {
  %scalar_input = check.generate.fill value(0.0) : tensor<1xf32>
  %vector_input = check.generate.fill value(0.0) : tensor<4xf32>
  %scalar_output = check.generate.fill value(0.0) : tensor<1xf32>
  %vector_output = check.generate.fill value(0.0) : tensor<4xf32>
  %expected_scalar = check.generate.fill value(1.0) : tensor<1xf32>
  %expected_vector = check.generate.fill value(1.0) : tensor<4xf32>
  kernel.launch @template_math_legalization(%scalar_input, %vector_input, %scalar_output, %vector_output) : (tensor<1xf32>, tensor<4xf32>, tensor<1xf32>, tensor<4xf32>)
  check.expect.close actual(%scalar_output) expected(%expected_scalar) atol(0.0001) rtol(0.0001) nan(same) : tensor<1xf32>
  check.expect.close actual(%vector_output) expected(%expected_vector) atol(0.0001) rtol(0.0001) nan(same) : tensor<4xf32>
  check.return
}

check.benchmark<@case_template_math_legalization> @bench_template_math_legalization
