{
  "version": 1,
  "cases": [
    {
      "name": "links bytecode provider library",
      "steps": [
        {
          "name": "encode-providers",
          "run": {
            "tool": "loom-format",
            "args": [
              "--from=text",
              "--to=bc",
              "--output={tmp}/providers.loom",
              "{srcdir}/providers.loom"
            ]
          },
          "files": [
            {
              "path": "{tmp}/providers.loom",
              "non_empty": true
            }
          ]
        },
        {
          "name": "link-text",
          "cwd": "{tmp}",
          "run": {
            "tool": "loom-link",
            "args": [
              "{srcdir}/root.loom",
              "--library=providers.loom",
              "--root=@scale_i32_buffer",
              "--strip-check",
              "--output={tmp}/linked.loom"
            ]
          },
          "files": [
            {
              "path": "{tmp}/linked.loom",
              "non_empty": true
            }
          ]
        },
        {
          "name": "show-linked",
          "run": {
            "tool": "loom-format",
            "args": [
              "{tmp}/linked.loom"
            ]
          },
          "stdout": {
            "contains": {
              "unordered": [
                "kernel.def retain export(\"scale_i32_buffer\") @scale_i32_buffer",
                "template.def<@authoring.link.scale_i32> priority(1) @scale_i32_fallback",
                "@scale_i32_gfx1100",
                "@scale_i32_gfx1200"
              ]
            },
            "not_contains": [
              "check.case",
              "@unused_provider"
            ]
          }
        }
      ]
    },
    {
      "name": "compiles linked bytecode after receiving target facts",
      "steps": [
        {
          "name": "encode-providers",
          "run": {
            "tool": "loom-format",
            "args": [
              "--from=text",
              "--to=bc",
              "--output={tmp}/providers.loom",
              "{srcdir}/providers.loom"
            ]
          },
          "files": [
            {
              "path": "{tmp}/providers.loom",
              "non_empty": true
            }
          ]
        },
        {
          "name": "link-bytecode",
          "cwd": "{tmp}",
          "run": {
            "tool": "loom-link",
            "args": [
              "{srcdir}/root.loom",
              "--library=providers.loom",
              "--root=@scale_i32_buffer",
              "--strip-check",
              "--to=bc",
              "--output={tmp}/linked.loombc"
            ]
          },
          "files": [
            {
              "path": "{tmp}/linked.loombc",
              "non_empty": true
            }
          ]
        },
        {
          "name": "compile",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{tmp}/linked.loombc",
              "--format=amdgpu-hsaco",
              "--target=amdgpu:gfx1100",
              "--output={tmp}/scale_i32.hsaco",
              "--artifact-manifest=summary",
              "--compile-report=summary"
            ]
          },
          "stderr": {
            "contains": {
              "unordered": [
                "\"target_key\":\"gfx1100\"",
                "\"status\":{\"code\":0,\"name\":\"OK\"}"
              ]
            }
          },
          "files": [
            {
              "path": "{tmp}/scale_i32.hsaco",
              "non_empty": true
            },
            {
              "path": "{tmp}/scale_i32.hsaco.manifest.json",
              "non_empty": true
            }
          ]
        }
      ]
    }
  ]
}
