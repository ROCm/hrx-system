amdgpu.target<gfx1100> @gfx1100

amdgpu.target<gfx1200> @gfx1200

template.decl @authoring.link.scale_i32(%value: i32) -> (i32)

template.decl @authoring.link.unused(%value: i32) -> (i32)

// RDNA3 provider selected when its caller specializes to @gfx1100.
template.def<@authoring.link.scale_i32> target(@gfx1100) priority(20) @scale_i32_gfx1100(%value: i32) -> (i32) {
  %scale_factor = scalar.constant 2 : i32
  %scaled = scalar.muli %value, %scale_factor : i32
  template.return %scaled : i32
}

// RDNA4 provider selected when its caller specializes to @gfx1200. It is
// semantically the same as the RDNA3 provider so the generic correctness case
// remains target-neutral.
template.def<@authoring.link.scale_i32> target(@gfx1200) priority(20) @scale_i32_gfx1200(%value: i32) -> (i32) {
  %scaled = scalar.addi %value, %value : i32
  template.return %scaled : i32
}

// Fallback provider used when no target-specific implementation applies.
template.def<@authoring.link.scale_i32> priority(1) @scale_i32_fallback(%value: i32) -> (i32) {
  %scaled = scalar.addi %value, %value : i32
  template.return %scaled : i32
}

template.def<@authoring.link.unused> @unused_provider(%value: i32) -> (i32) {
  template.return %value : i32
}
