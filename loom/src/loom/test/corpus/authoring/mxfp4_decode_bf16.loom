func.def inline @decode_mxfp4_group_bits(%payload: vector<4xi32>, %scale: vector<1xi32>) -> (vector<16xi32>) {
  %schema = encoding.define #matrix_operand<affine=scale_only, element_format=f4e2m1, payload_elements=32, payload_packing=little_endian_nibbles, payload_registers=4, scale_format=e8m0, scale_group_elements=32, scale_operands=1, scale_topology=block_1d, zero_scale_fallback=true> : encoding<schema>
  %decoded = vector.decode %payload using %schema {scale = %scale : vector<1xi32>} : vector<4xi32>, encoding<schema> -> vector<32xbf16>
  %bits = vector.bitcast %decoded : vector<32xbf16> to vector<16xi32>
  func.return %bits : vector<16xi32>
}

kernel.def target(@gfx9_4) @decode_mxfp4_group_bits_gfx9_4() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%payload_buffer: buffer, %scale_buffer: buffer, %out_buffer: buffer) {
  %base = index.constant 0 : offset
  %payload_view = buffer.view %payload_buffer[%base] : buffer -> view<4xi32, #dense>
  %scale_view = buffer.view %scale_buffer[%base] : buffer -> view<1xi32, #dense>
  %out_view = buffer.view %out_buffer[%base] : buffer -> view<16xi32, #dense>
  %payload = vector.load %payload_view[0] : view<4xi32, #dense> -> vector<4xi32>
  %scale = vector.load %scale_view[0] : view<1xi32, #dense> -> vector<1xi32>
  %bits = func.call @decode_mxfp4_group_bits(%payload, %scale) : (vector<4xi32>, vector<1xi32>) -> (vector<16xi32>)
  vector.store %bits, %out_view[0] : vector<16xi32>, view<16xi32, #dense>
  kernel.return
}

