    check.compare<@packed_snapshot_consumers, @packed_snapshot_consumers_oracle>(%input, %table, %unsigned_output, %signed_output) : (tensor<16xi8>, tensor<256xi32>, tensor<16xi32>, tensor<16xi32>) -> () {
