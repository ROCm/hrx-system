// Packed indices cover both signed-byte halves and distinct lanes in every word.

func.def device inline @compute_packed_word_lookup(%input: buffer, %table: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<4xi32>
  %table_view = buffer.view %table[%base] : buffer -> view<256xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<16xi32>
  %packed = vector.load %input_view[0] : view<4xi32> -> vector<4xi32>
  %bytes = vector.bitcast %packed : vector<4xi32> to vector<16xi8>
  %indices = vector.extui %bytes : vector<16xi8> to vector<16xi32>
  %values = vector.gather %table_view[0][%indices] : view<256xi32>, vector<16xi32> -> vector<16xi32>
  vector.store %values, %output_view[0] : vector<16xi32>, view<16xi32>
  func.return
}

kernel.def @packed_word_lookup() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %table: buffer, %output: buffer) {
  func.call @compute_packed_word_lookup(%input, %table, %output) : (buffer, buffer, buffer)
  kernel.return
}

func.def @packed_word_lookup_oracle(%input: buffer, %table: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<16xi8>
  %table_view = buffer.view %table[%base] : buffer -> view<256xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<16xi32>
  %begin = index.constant 0 : index
  %end = index.constant 16 : index
  %step = index.constant 1 : index
  scf.for %lane = [%begin to %end step %step] {
    %byte = view.load %input_view[%lane] : view<16xi8> -> i8
    %unsigned = scalar.extui %byte : i8 to i32
    %position = index.cast %unsigned : i32 to index
    %value = view.load %table_view[%position] : view<256xi32> -> i32
    view.store %value, %output_view[%lane] : i32, view<16xi32>
  }
  func.return
}

check.scenario @packed_word_lookup_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-128) step(17) : tensor<16xi8>
    %table = check.generate.iota offset(7) step(3) : tensor<256xi32>
    %output = check.generate.fill value(-99) : tensor<16xi32>
    check.compare<@packed_word_lookup, @packed_word_lookup_oracle>(%input, %table, %output) : (tensor<16xi8>, tensor<256xi32>, tensor<16xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<16xi8>
      check.expect.bitwise actual(%table) expected(%table) : tensor<256xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<16xi32>
    }
  }
  check.trial[64](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-128 to 127) : tensor<16xi8>
    %table = check.generate.iota offset(7) step(3) : tensor<256xi32>
    %output = check.generate.fill value(-99) : tensor<16xi32>
    check.compare<@packed_word_lookup, @packed_word_lookup_oracle>(%input, %table, %output) : (tensor<16xi8>, tensor<256xi32>, tensor<16xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<16xi8>
      check.expect.bitwise actual(%table) expected(%table) : tensor<256xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<16xi32>
    }
  }
  check.return
}

