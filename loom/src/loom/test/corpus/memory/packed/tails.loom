// Packed rows retain their exact spans across global and workgroup storage.
// Integer tensors initialize and check floating storage without numeric conversion.

kernel.def @stage_i8_3() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %guard = index.constant 1 : offset
  %length = index.constant 192 : offset
  %scratch = buffer.alloca<workgroup> align(16) %length : buffer
  %source = buffer.view %input[%base] : buffer -> view<64x3xi8>
  %temporary = buffer.view %scratch[%base] : buffer -> view<64x3xi8>
  %target = buffer.view %output[%guard] : buffer -> view<64x3xi8>
  %value = vector.load %source[%lane, 0] : view<64x3xi8> -> vector<3xi8>
  vector.store<volatile> %value, %temporary[%lane, 0] : vector<3xi8>, view<64x3xi8>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %staged = vector.load<volatile> %temporary[%lane, 0] : view<64x3xi8> -> vector<3xi8>
  vector.store %staged, %target[%lane, 0] : vector<3xi8>, view<64x3xi8>
  kernel.return
}

// The oracle copies the complete input byte span into the centered output
// span. Typed staging kernels must preserve exactly this raw state while their
// workgroup/private storage, volatile accesses, barriers, and tail vectors are
// exercised on the target.
func.def @stage_packed_span_oracle(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %c2 = index.constant 2 : index
  %input_length = buffer.length %input
  %output_length = buffer.length %output
  %bounded_input_length = index.assume %input_length [range(%input_length, 0, 9223372036854775807)] : offset
  %bounded_output_length = index.assume %output_length [range(%output_length, 0, 9223372036854775807)] : offset
  %input_extent = index.cast %bounded_input_length : offset to index
  %output_extent = index.cast %bounded_output_length : offset to index
  %guard_span = index.sub %output_extent, %input_extent : index
  %guard_index = index.div %guard_span, %c2 : index
  %bounded_guard = index.assume %guard_index [range(%guard_index, 0, 9223372036854775807)] : index
  %guard = index.cast %bounded_guard : index to offset
  buffer.copy %input[%origin], %output[%guard], %input_length
  func.return
}

check.scenario @stage_i8_3_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-128) step(1) : tensor<192xi8>
    %output = check.generate.fill value(91) : tensor<194xi8>
    check.compare<@stage_i8_3, @stage_packed_span_oracle>(%input, %output) : (tensor<192xi8>, tensor<194xi8>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<192xi8>
      check.expect.bitwise actual(%output) expected(%output) : tensor<194xi8>
    }
  }
  check.return
}

