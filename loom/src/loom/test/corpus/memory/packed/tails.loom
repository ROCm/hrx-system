kernel.def @capture_tail() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %observed: buffer) {
  %base = index.constant 0 : offset
  %guard_offset = index.constant 1 : offset
  %source = buffer.view %input[%base] : buffer -> view<3xi8>
  %target = buffer.view %output[%guard_offset] : buffer -> view<3xi8>
  %after = buffer.view %observed[%base] : buffer -> view<3xi8>
  %captured = vector.load<volatile> %source[0] : view<3xi8> -> vector<3xi8>
  %replacement = vector.splati 0 : vector<3xi8>
  vector.store<volatile> %replacement, %source[0] : vector<3xi8>, view<3xi8>
  %reloaded = vector.load<volatile> %source[0] : view<3xi8> -> vector<3xi8>
  vector.store %captured, %target[0] : vector<3xi8>, view<3xi8>
  vector.store %reloaded, %after[0] : vector<3xi8>, view<3xi8>
  kernel.return
}

func.def @capture_tail_oracle(%input: buffer, %output: buffer, %observed: buffer) {
  %origin = index.constant 0 : offset
  %guard = index.constant 1 : offset
  %length = index.constant 3 : offset
  %c0 = scalar.constant 0 : i8
  buffer.copy %input[%origin], %output[%guard], %length
  buffer.fill %c0, %input[%origin], %length : i8
  buffer.fill %c0, %observed[%origin], %length : i8
  func.return
}

