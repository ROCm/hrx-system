  %target = buffer.view %output[%guard] : buffer -> view<64x3xi8>
  %value = vector.load %source[%lane, 0] : view<64x3xi8> -> vector<3xi8>
  vector.store<volatile> %value, %temporary[%lane, 0] : vector<3xi8>, view<64x3xi8>
  %staged = vector.load<volatile> %temporary[%lane, 0] : view<64x3xi8> -> vector<3xi8>
