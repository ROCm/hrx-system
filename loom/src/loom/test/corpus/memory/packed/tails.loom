    %observed = check.generate.fill value(99) : tensor<3xi8>
    check.compare<@capture_tail, @capture_tail_oracle>(%input, %output, %observed) : (tensor<3xi8>, tensor<5xi8>, tensor<3xi8>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<3xi8>
      check.expect.bitwise actual(%output) expected(%output) : tensor<5xi8>
      check.expect.bitwise actual(%observed) expected(%observed) : tensor<3xi8>
    }
  }
  check.return
}

