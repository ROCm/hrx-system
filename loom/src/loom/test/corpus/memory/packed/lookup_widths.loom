  %threads = index.constant 17 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%table: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %thread = kernel.workitem.id<x> : index
  %start = index.cast %thread : index to i8
  %step = scalar.constant 1 : i8
  %raw = vector.iota %start step %step : vector<64xi8>
  %table_view = buffer.view %table[%base] : buffer -> view<4xi8>
  %output_view = buffer.view %output[%base] : buffer -> view<1088xi8>
  %mask = vector.constant 3 : vector<64xi8>
  %indices = vector.andi %raw, %mask : vector<64xi8>
  %entries = vector.load %table_view[0] : view<4xi8> -> vector<4xi8>
  %values = vector.table.lookup %entries[%indices] : vector<4xi8>, vector<64xi8> -> vector<64xi8>
  %origin = scalar.constant 0 : i32
  %stride = scalar.constant 17 : i32
  %offsets = vector.iota %origin step %stride : vector<64xi32>
  vector.scatter %values, %output_view[%thread][%offsets] : vector<64xi8>, view<1088xi8>, vector<64xi32>
  kernel.return
}

check.case public @computed_short_lookup_64 {
  %table = check.generate.iota offset(-127) step(64) : tensor<4xi8>
  %output = check.generate.fill value(91) : tensor<1088xi8>
  kernel.launch @lookup_short_computed_64(%table, %output) : (tensor<4xi8>, tensor<1088xi8>)
  %expected = check.generate.iota offset(-127) step(64) period(4) : tensor<1088xi8>
  check.expect.bitwise actual(%output) expected(%expected) : tensor<1088xi8>
  check.return
}

// Predicate tables keep their packed representation while selecting both true
// and false values at alternating runtime indices.
kernel.def @lookup_predicates() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%table_input: buffer, %index_input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %table_view = buffer.view %table_input[%base] : buffer -> view<2xi32>
  %index_view = buffer.view %index_input[%base] : buffer -> view<8xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<8xi32>
  %table_words = vector.load %table_view[0] : view<2xi32> -> vector<2xi32>
  %c0 = vector.constant 0 : vector<2xi32>
  %table = vector.cmpi slt, %table_words, %c0 : vector<2xi32> -> vector<2xi1>
  %indices = vector.load %index_view[0] : view<8xi32> -> vector<8xi32>
  %selected = vector.table.lookup %table[%indices] : vector<2xi1>, vector<8xi32> -> vector<8xi1>
  %selected_words = vector.extui %selected : vector<8xi1> to vector<8xi32>
  vector.store %selected_words, %output_view[0] : vector<8xi32>, view<8xi32>
  kernel.return
}

check.case public @predicate_lookup_values {
  %table = check.generate.iota offset(-1) step(2) : tensor<2xi32>
  %indices = check.generate.iota offset(0) step(1) period(2) : tensor<8xi32>
  %output = check.generate.fill value(91) : tensor<8xi32>
  kernel.launch @lookup_predicates(%table, %indices, %output) : (tensor<2xi32>, tensor<8xi32>, tensor<8xi32>)
  %expected = check.generate.iota offset(1) step(-1) period(2) : tensor<8xi32>
  check.expect.bitwise actual(%output) expected(%expected) : tensor<8xi32>
  check.return
}
