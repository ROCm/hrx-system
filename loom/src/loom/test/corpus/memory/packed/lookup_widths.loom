// Nibble values cross every packed output word before signed conversion.
kernel.def @lookup_nibbles_4() {
  %unit = index.constant 1 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%input: buffer, %table: buffer, %bytes: buffer, %floats: buffer) {
  %base = index.constant 0 : offset
  %thread = kernel.workitem.id<x> : index
  %input_view = buffer.view %input[%base] : buffer -> view<32x2xi8>
  %table_view = buffer.view %table[%base] : buffer -> view<16xi8>
  %byte_view = buffer.view %bytes[%base] : buffer -> view<32x4xi8>
  %float_view = buffer.view %floats[%base] : buffer -> view<32x4xf32>
  %packed = vector.load %input_view[%thread, 0] : view<32x2xi8> -> vector<2xi8>
  %indices = vector.bitunpacku<4> %packed : vector<2xi8> -> vector<4xi8>
  %entries = vector.load %table_view[0] : view<16xi8> -> vector<16xi8>
  %values = vector.table.lookup %entries[%indices] : vector<16xi8>, vector<4xi8> -> vector<4xi8>
  %converted = vector.sitofp %values : vector<4xi8> to vector<4xf32>
  vector.store %values, %byte_view[%thread, 0] : vector<4xi8>, view<32x4xi8>
  vector.store %converted, %float_view[%thread, 0] : vector<4xf32>, view<32x4xf32>
  kernel.return
}

check.case public @nibble_lookup_4_consumers {
  // Alternating 0x76543210 and 0xfedcba98 encodes all sixteen nibble values.
  %input = check.generate.iota offset(1985229328) step(-2004318072) period(2) : tensor<16xi32>
  %table = check.generate.iota offset(-127) step(16) : tensor<16xi8>
  %bytes = check.generate.fill value(91) : tensor<128xi8>
  %floats = check.generate.fill value(91.0) : tensor<128xf32>
  kernel.launch @lookup_nibbles_4(%input, %table, %bytes, %floats) : (tensor<16xi32>, tensor<16xi8>, tensor<128xi8>, tensor<128xf32>)
  %expected_bytes = check.generate.iota offset(-127) step(16) period(16) : tensor<128xi8>
  %expected_floats = check.generate.iota offset(-127.0) step(16.0) period(16) : tensor<128xf32>
  check.expect.bitwise actual(%bytes) expected(%expected_bytes) : tensor<128xi8>
  check.expect.bitwise actual(%floats) expected(%expected_floats) : tensor<128xf32>
  check.return
}

