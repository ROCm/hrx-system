// Seventeen workitems exercise every table entry at every vector position.
// Transposed stores are disjoint; 17 is one modulo both table sizes, so their
// flattened expected values form simple periodic iotas.
kernel.def @lookup_computed_1() {
  %unit = index.constant 1 : index
  %threads = index.constant 17 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%short_table: buffer, %table: buffer, %short_output: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %thread = kernel.workitem.id<x> : index
  %start = index.cast %thread : index to i8
  %step = scalar.constant 1 : i8
  %raw = vector.iota %start step %step : vector<1xi8>
  %short_table_view = buffer.view %short_table[%base] : buffer -> view<4xi8>
  %table_view = buffer.view %table[%base] : buffer -> view<16xi8>
  %short_output_view = buffer.view %short_output[%base] : buffer -> view<17xi8>
  %output_view = buffer.view %output[%base] : buffer -> view<17xi8>
  %short_mask = vector.constant 3 : vector<1xi8>
  %mask = vector.constant 15 : vector<1xi8>
  %short_indices = vector.andi %raw, %short_mask : vector<1xi8>
  %indices = vector.andi %raw, %mask : vector<1xi8>
  %short_entries = vector.load %short_table_view[0] : view<4xi8> -> vector<4xi8>
  %entries = vector.load %table_view[0] : view<16xi8> -> vector<16xi8>
  %short_values = vector.table.lookup %short_entries[%short_indices] : vector<4xi8>, vector<1xi8> -> vector<1xi8>
  %values = vector.table.lookup %entries[%indices] : vector<16xi8>, vector<1xi8> -> vector<1xi8>
  %origin = scalar.constant 0 : i32
  %stride = scalar.constant 17 : i32
  %offsets = vector.iota %origin step %stride : vector<1xi32>
  vector.scatter %short_values, %short_output_view[%thread][%offsets] : vector<1xi8>, view<17xi8>, vector<1xi32>
  vector.scatter %values, %output_view[%thread][%offsets] : vector<1xi8>, view<17xi8>, vector<1xi32>
  kernel.return
}

check.case public @computed_lookup_1 {
  %short_table = check.generate.iota offset(-127) step(64) : tensor<4xi8>
  %table = check.generate.iota offset(-127) step(16) : tensor<16xi8>
  %short_output = check.generate.fill value(91) : tensor<17xi8>
  %output = check.generate.fill value(91) : tensor<17xi8>
  kernel.launch @lookup_computed_1(%short_table, %table, %short_output, %output) : (tensor<4xi8>, tensor<16xi8>, tensor<17xi8>, tensor<17xi8>)
  %short_expected = check.generate.iota offset(-127) step(64) period(4) : tensor<17xi8>
  %expected = check.generate.iota offset(-127) step(16) period(16) : tensor<17xi8>
  check.expect.bitwise actual(%short_output) expected(%short_expected) : tensor<17xi8>
  check.expect.bitwise actual(%output) expected(%expected) : tensor<17xi8>
  check.return
}

