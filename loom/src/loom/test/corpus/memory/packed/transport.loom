// Packed vectors preserve every raw payload through odd lane counts. Integer
// tensors initialize and observe floating storage without numeric conversion.
func.def @copy_packed_byte_values(%byte_input: buffer, %byte_output: buffer, %capture_input: buffer, %replacement_input: buffer, %capture_output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index

  // The byte output concatenates i8, E4M3, and E5M2 width-three rows;
  // equivalent width-seven rows; then i8 width-17 and width-63 rows.
  %byte3_input = buffer.view %byte_input[%base] : buffer -> view<258xi8>
  %e4m3_3_input = buffer.view %byte_input[%base] : buffer -> view<258xf8E4M3>
  %e5m2_3_input = buffer.view %byte_input[%base] : buffer -> view<258xf8E5M2>
  %byte3_output = buffer.view %byte_output[%base] : buffer -> view<258xi8>
  %e4m3_3_origin = index.constant 258 : offset
  %e4m3_3_output = buffer.view %byte_output[%e4m3_3_origin] : buffer -> view<258xf8E4M3>
  %e5m2_3_origin = index.constant 516 : offset
  %e5m2_3_output = buffer.view %byte_output[%e5m2_3_origin] : buffer -> view<258xf8E5M2>
  %byte3_end = index.constant 258 : index
  %byte3_step = index.constant 3 : index
  scf.for %i = [%begin to %byte3_end step %byte3_step] {
    %byte = vector.load %byte3_input[%i] : view<258xi8> -> vector<3xi8>
    %e4m3 = vector.load %e4m3_3_input[%i] : view<258xf8E4M3> -> vector<3xf8E4M3>
    %e5m2 = vector.load %e5m2_3_input[%i] : view<258xf8E5M2> -> vector<3xf8E5M2>
    vector.store %byte, %byte3_output[%i] : vector<3xi8>, view<258xi8>
    vector.store %e4m3, %e4m3_3_output[%i] : vector<3xf8E4M3>, view<258xf8E4M3>
    vector.store %e5m2, %e5m2_3_output[%i] : vector<3xf8E5M2>, view<258xf8E5M2>
  }

  %byte7_input = buffer.view %byte_input[%base] : buffer -> view<259xi8>
  %e4m3_7_input = buffer.view %byte_input[%base] : buffer -> view<259xf8E4M3>
  %e5m2_7_input = buffer.view %byte_input[%base] : buffer -> view<259xf8E5M2>
  %byte7_origin = index.constant 774 : offset
  %byte7_output = buffer.view %byte_output[%byte7_origin] : buffer -> view<259xi8>
  %e4m3_7_origin = index.constant 1033 : offset
  %e4m3_7_output = buffer.view %byte_output[%e4m3_7_origin] : buffer -> view<259xf8E4M3>
  %e5m2_7_origin = index.constant 1292 : offset
  %e5m2_7_output = buffer.view %byte_output[%e5m2_7_origin] : buffer -> view<259xf8E5M2>
  %byte7_end = index.constant 259 : index
  %byte7_step = index.constant 7 : index
  scf.for %i = [%begin to %byte7_end step %byte7_step] {
    %byte = vector.load %byte7_input[%i] : view<259xi8> -> vector<7xi8>
    %e4m3 = vector.load %e4m3_7_input[%i] : view<259xf8E4M3> -> vector<7xf8E4M3>
    %e5m2 = vector.load %e5m2_7_input[%i] : view<259xf8E5M2> -> vector<7xf8E5M2>
    vector.store %byte, %byte7_output[%i] : vector<7xi8>, view<259xi8>
    vector.store %e4m3, %e4m3_7_output[%i] : vector<7xf8E4M3>, view<259xf8E4M3>
    vector.store %e5m2, %e5m2_7_output[%i] : vector<7xf8E5M2>, view<259xf8E5M2>
  }

  %byte17_input = buffer.view %byte_input[%base] : buffer -> view<272xi8>
  %byte17_origin = index.constant 1551 : offset
  %byte17_output = buffer.view %byte_output[%byte17_origin] : buffer -> view<272xi8>
  %byte17_end = index.constant 272 : index
  %byte17_step = index.constant 17 : index
  scf.for %i = [%begin to %byte17_end step %byte17_step] {
    %value = vector.load %byte17_input[%i] : view<272xi8> -> vector<17xi8>
    vector.store %value, %byte17_output[%i] : vector<17xi8>, view<272xi8>
  }

  %byte63_input = buffer.view %byte_input[%base] : buffer -> view<315xi8>
  %byte63_origin = index.constant 1823 : offset
  %byte63_output = buffer.view %byte_output[%byte63_origin] : buffer -> view<315xi8>
  %byte63_end = index.constant 315 : index
  %byte63_step = index.constant 63 : index
  scf.for %i = [%begin to %byte63_end step %byte63_step] {
    %value = vector.load %byte63_input[%i] : view<315xi8> -> vector<63xi8>
    vector.store %value, %byte63_output[%i] : vector<63xi8>, view<315xi8>
  }

  %capture_source = buffer.view %capture_input[%base] : buffer -> view<258xi8>
  %replacement_source = buffer.view %replacement_input[%base] : buffer -> view<258xi8>
  %captured_output = buffer.view %capture_output[%base] : buffer -> view<258xi8>
  %reloaded_origin = index.constant 258 : offset
  %reloaded_output = buffer.view %capture_output[%reloaded_origin] : buffer -> view<258xi8>
  scf.for %i = [%begin to %byte3_end step %byte3_step] {
    %captured = vector.load<volatile> %capture_source[%i] : view<258xi8> -> vector<3xi8>
    %replacement = vector.load %replacement_source[%i] : view<258xi8> -> vector<3xi8>
    vector.store<volatile> %replacement, %capture_source[%i] : vector<3xi8>, view<258xi8>
    %reloaded = vector.load<volatile> %capture_source[%i] : view<258xi8> -> vector<3xi8>
    vector.store %captured, %captured_output[%i] : vector<3xi8>, view<258xi8>
    vector.store %reloaded, %reloaded_output[%i] : vector<3xi8>, view<258xi8>
  }
  func.return
}

func.def @copy_packed_word_values(%word_input: buffer, %word_output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 65541 : index
  %step = index.constant 7 : index
  // The output concatenates i16, F16, and BF16 width-seven rows.
  %word_input_view = buffer.view %word_input[%base] : buffer -> view<65541xi16>
  %half_input_view = buffer.view %word_input[%base] : buffer -> view<65541xf16>
  %bfloat_input_view = buffer.view %word_input[%base] : buffer -> view<65541xbf16>
  %word_output_view = buffer.view %word_output[%base] : buffer -> view<65541xi16>
  %half_origin = index.constant 131082 : offset
  %half_output_view = buffer.view %word_output[%half_origin] : buffer -> view<65541xf16>
  %bfloat_origin = index.constant 262164 : offset
  %bfloat_output_view = buffer.view %word_output[%bfloat_origin] : buffer -> view<65541xbf16>
  scf.for %i = [%begin to %end step %step] {
    %word = vector.load %word_input_view[%i] : view<65541xi16> -> vector<7xi16>
    %half = vector.load %half_input_view[%i] : view<65541xf16> -> vector<7xf16>
    %bfloat = vector.load %bfloat_input_view[%i] : view<65541xbf16> -> vector<7xbf16>
    vector.store %word, %word_output_view[%i] : vector<7xi16>, view<65541xi16>
    vector.store %half, %half_output_view[%i] : vector<7xf16>, view<65541xf16>
    vector.store %bfloat, %bfloat_output_view[%i] : vector<7xbf16>, view<65541xbf16>
  }
  func.return
}

check.scenario @packed_byte_transport_all_bits {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %byte_input_owner = check.generate.iota offset(-128) step(1) period(256) : tensor<323xi8>
    %byte_input = check.tensor.view %byte_input_owner offset(4) : tensor<323xi8> -> tensor<315xi8>
    %byte_output_owner = check.generate.fill value(-91) : tensor<2146xi8>
    %byte_output = check.tensor.view %byte_output_owner offset(4) : tensor<2146xi8> -> tensor<2138xi8>
    %capture_input_owner = check.generate.iota offset(-128) step(1) period(256) : tensor<266xi8>
    %capture_input = check.tensor.view %capture_input_owner offset(4) : tensor<266xi8> -> tensor<258xi8>
    %replacement_input_owner = check.generate.iota offset(127) step(-1) period(256) : tensor<266xi8>
    %replacement_input = check.tensor.view %replacement_input_owner offset(4) : tensor<266xi8> -> tensor<258xi8>
    %capture_output_owner = check.generate.fill value(-91) : tensor<524xi8>
    %capture_output = check.tensor.view %capture_output_owner offset(4) : tensor<524xi8> -> tensor<516xi8>
    check.compare<@copy_packed_byte_values>(%byte_input, %byte_output, %capture_input, %replacement_input, %capture_output) : (tensor<315xi8>, tensor<2138xi8>, tensor<258xi8>, tensor<258xi8>, tensor<516xi8>) -> () {
      check.expect.bitwise actual(%byte_input_owner) expected(%byte_input_owner) : tensor<323xi8>
      check.expect.bitwise actual(%byte_output_owner) expected(%byte_output_owner) : tensor<2146xi8>
      check.expect.bitwise actual(%capture_input_owner) expected(%capture_input_owner) : tensor<266xi8>
      check.expect.bitwise actual(%replacement_input_owner) expected(%replacement_input_owner) : tensor<266xi8>
      check.expect.bitwise actual(%capture_output_owner) expected(%capture_output_owner) : tensor<524xi8>
    }
  }
  check.return
}

check.scenario @packed_word_transport_all_bits {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %word_input_owner = check.generate.iota offset(-32768) step(1) period(65536) : tensor<65549xi16>
    %word_input = check.tensor.view %word_input_owner offset(8) : tensor<65549xi16> -> tensor<65541xi16>
    %word_output_owner = check.generate.fill value(-21846) : tensor<196631xi16>
    %word_output = check.tensor.view %word_output_owner offset(8) : tensor<196631xi16> -> tensor<196623xi16>
    check.compare<@copy_packed_word_values>(%word_input, %word_output) : (tensor<65541xi16>, tensor<196623xi16>) -> () {
      check.expect.bitwise actual(%word_input_owner) expected(%word_input_owner) : tensor<65549xi16>
      check.expect.bitwise actual(%word_output_owner) expected(%word_output_owner) : tensor<196631xi16>
    }
  }
  check.return
}

// I64 and F64 carriers transport identical raw bits at native, split, and
// multi-register widths. Every result has an independently checked guard.
func.def @transport_64bit_vectors(%input: buffer, %output: buffer) {
  %source, %destination = buffer.assume.alignment %input, %output {minimum_alignment = 64} : buffer, buffer
  %origin = index.constant 0 : offset
  %source_i64 = buffer.view %source[%origin] : buffer -> view<64xi64>
  %source_f64 = buffer.view %source[%origin] : buffer -> view<64xf64>
  %destination_i64 = buffer.view %destination[%origin] : buffer -> view<192xi64>
  %destination_f64 = buffer.view %destination[%origin] : buffer -> view<192xf64>
  %guards = buffer.view %destination[%origin] : buffer -> view<384xi32>
  %sentinel = vector.splati -1515870811 : vector<16xi32>
  %begin = index.constant 0 : index
  %end = index.constant 384 : index
  %step = index.constant 16 : index
  scf.for %i = [%begin to %end step %step] {
    vector.store<volatile> %sentinel, %guards[%i] : vector<16xi32>, view<384xi32>
  }
  %i64x2 = vector.load %source_i64[0] : view<64xi64> -> vector<2xi64>
  vector.store %i64x2, %destination_i64[0] : vector<2xi64>, view<192xi64>
  %f64x2 = vector.load %source_f64[8] : view<64xf64> -> vector<2xf64>
  vector.store %f64x2, %destination_f64[16] : vector<2xf64>, view<192xf64>
  %i64x4 = vector.load %source_i64[16] : view<64xi64> -> vector<4xi64>
  vector.store %i64x4, %destination_i64[32] : vector<4xi64>, view<192xi64>
  %f64x4 = vector.load %source_f64[24] : view<64xf64> -> vector<4xf64>
  vector.store %f64x4, %destination_f64[48] : vector<4xf64>, view<192xf64>
  %i64x8 = vector.load %source_i64[32] : view<64xi64> -> vector<8xi64>
  vector.store %i64x8, %destination_i64[64] : vector<8xi64>, view<192xi64>
  %f64x8 = vector.load %source_f64[40] : view<64xf64> -> vector<8xf64>
  vector.store %f64x8, %destination_f64[80] : vector<8xf64>, view<192xf64>
  // These origins are sixteen bytes into a thirty-two-byte alignment boundary.
  %i64_split = vector.load %source_i64[50] : view<64xi64> -> vector<4xi64>
  vector.store %i64_split, %destination_i64[96] : vector<4xi64>, view<192xi64>
  %f64_split = vector.load %source_f64[58] : view<64xf64> -> vector<4xf64>
  vector.store %f64_split, %destination_f64[112] : vector<4xf64>, view<192xf64>
  // Each wide payload is followed by an equally sized untouched guard.
  %i64x16 = vector.load %source_i64[0] : view<64xi64> -> vector<16xi64>
  vector.store %i64x16, %destination_i64[128] : vector<16xi64>, view<192xi64>
  %f64x16 = vector.load %source_f64[32] : view<64xf64> -> vector<16xf64>
  vector.store %f64x16, %destination_f64[160] : vector<16xf64>, view<192xf64>
  func.return
}

// Signed zero, infinities, and quiet/signaling NaNs precede all 64 one-bit
// payloads. The final trials retain independently generated random words.
global.rodata.def @transport_64bit_edges = align(8) bytes("0000000000000000ffffffffffffffff0000000000000080000000000000f07f000000000000f0ff010000000000f87f010000000000f0ff")

func.def @generate_64bit_transport(%trial: index, %input: buffer) {
  %begin = index.constant 0 : index
  %count = index.constant 64 : index
  %step = index.constant 1 : index
  %edge_count = index.constant 7 : index
  %pattern_count = index.constant 71 : index
  %is_pattern = index.cmp ult, %trial, %pattern_count : index
  scf.if %is_pattern {
    %origin = index.constant 0 : offset
    %destination = buffer.view %input[%origin] : buffer -> view<64xi64>
    %storage = global.load @transport_64bit_edges : buffer
    %edges = buffer.view %storage[%origin] : buffer -> view<7xi64>
    scf.for %i = [%begin to %count step %step] {
      %position = index.add %trial, %i : index
      %pattern = index.rem %position, %pattern_count : index
      %is_edge = index.cmp ult, %pattern, %edge_count : index
      %value = scf.if %is_edge -> (i64) {
        %edge = view.load %edges[%pattern] : view<7xi64> -> i64
        scf.yield %edge : i64
      } else {
        %bit = index.sub %pattern, %edge_count : index
        %shift = index.cast %bit : index to i64
        %unit = scalar.constant 1 : i64
        %one_bit = scalar.shli %unit, %shift : i64
        scf.yield %one_bit : i64
      }
      view.store %value, %destination[%i] : i64, view<64xi64>
    }
  }
  func.return
}

func.def @transport_64bit_reference(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %destination = buffer.view %output[%origin] : buffer -> view<1536xi8>
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %output_bytes = index.constant 1536 : index
  %sentinel = scalar.constant -91 : i8
  scf.for %i = [%begin to %output_bytes step %step] {
    view.store %sentinel, %destination[%i] : i8, view<1536xi8>
  }
  %slots = index.constant 10 : index
  %native_slots = index.constant 8 : index
  %split_begin = index.constant 6 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %c128 = index.constant 128 : index
  %c256 = index.constant 256 : index
  %c1024 = index.constant 1024 : index
  scf.for %slot = [%begin to %slots step %step] {
    %is_native = index.cmp ult, %slot, %native_slots : index
    %source_offset, %destination_offset, %length = scf.if %is_native -> (index, index, index) {
      %split = index.cmp uge, %slot, %split_begin : index
      %extra = scf.select %split, %c16, %begin : index
      %source_base = index.mul %slot, %c64 : index
      %source_start = index.add %source_base, %extra : index
      %destination_start = index.mul %slot, %c128 : index
      %small = index.cmp ult, %slot, %c2 : index
      %medium = index.cmp ult, %slot, %c4 : index
      %is_medium = scalar.ori %medium, %split : i1
      %wide_length = scf.select %is_medium, %c32, %c64 : index
      %native_length = scf.select %small, %c16, %wide_length : index
      scf.yield %source_start, %destination_start, %native_length : index, index, index
    } else {
      %wide_slot = index.sub %slot, %native_slots : index
      %source_start = index.mul %wide_slot, %c256 : index
      %destination_start = index.add %source_start, %c1024 : index
      scf.yield %source_start, %destination_start, %c128 : index, index, index
    }
    scf.for %i = [%begin to %length step %step] {
      %source_index = index.add %source_offset, %i : index
      %destination_index = index.add %destination_offset, %i : index
      %source_byte = index.cast %source_index : index to offset
      %destination_byte = index.cast %destination_index : index to offset
      %value = buffer.load.i8.u %input[%source_byte]
      buffer.store.i8 %value, %output[%destination_byte]
    }
  }
  func.return
}

check.scenario @vector_64bit_transport_values {
  check.trial[80](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input_storage = check.generate.random.uniform seed(%seed) range(-9223372036854775808 to 9223372036854775807) : tensor<80xi64>
    %input = check.tensor.view %input_storage offset(64) : tensor<80xi64> -> tensor<64xi64>
    check.generate<@generate_64bit_transport>(%trial, %input) : (index, tensor<64xi64>) -> ()
    %output_storage = check.generate.fill value(-842150451) : tensor<416xi32>
    %output = check.tensor.view %output_storage offset(64) : tensor<416xi32> -> tensor<384xi32>
    check.compare<@transport_64bit_vectors, @transport_64bit_reference>(%input, %output) : (tensor<64xi64>, tensor<384xi32>) -> () {
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<80xi64>
      check.expect.bitwise actual(%output_storage) expected(%output_storage) : tensor<416xi32>
    }
  }
  check.return
}
