// A view can begin before its storage origin while its accessed elements are
// inside the storage. Select the origin at runtime so scalar and packet accesses
// must preserve the signed position through view transport.
func.def @copy_from_signed_origin(%input: buffer, %output: buffer) {
  %c0 = index.constant 0 : index
  %control_view = buffer.view %input[%c0] : buffer -> view<8xi32>
  %control = view.load %control_view[0] : view<8xi32> -> i32
  %control_zero = scalar.constant 0 : i32
  %shift_origin = scalar.cmpi ne, %control, %control_zero : i32
  %backward = index.constant -16 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c1 = index.constant 1 : index
  %ordinary = buffer.view %input[%c0] : buffer -> view<12xi32>
  %shifted = buffer.view %input[%backward] : buffer -> view<12xi32>
  %source = scf.select %shift_origin, %shifted, %ordinary : view<12xi32>
  %coordinate_bias = scf.select %shift_origin, %c4, %c0 : index
  %destination = buffer.view %output[%backward] : buffer -> view<20xi32>
  scf.for %position = [%c0 to %c8 step %c1] {
    %source_position = index.add %position, %coordinate_bias : index
    %destination_position = index.add %position, %c4 : index
    %value = view.load %source[%source_position] : view<12xi32> -> i32
    view.store %value, %destination[%destination_position] : i32, view<20xi32>
  }
  scf.for %position = [%c0 to %c8 step %c4] {
    %source_position = index.add %position, %coordinate_bias : index
    %second_copy = index.add %position, %c8 : index
    %destination_position = index.add %second_copy, %c4 : index
    %packet = vector.load %source[%source_position] : view<12xi32> -> vector<4xi32>
    vector.store %packet, %destination[%destination_position] : vector<4xi32>, view<20xi32>
  }
  func.return
}

// The oracle addresses the supplied storage directly and copies each element
// twice, independently of the subject's view selection and packet accesses.
func.def @copy_origin_oracle(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %source = buffer.view %input[%origin] : buffer -> view<8xi32>
  %destination = buffer.view %output[%origin] : buffer -> view<16xi32>
  %c0 = index.constant 0 : index
  %c8 = index.constant 8 : index
  %c1 = index.constant 1 : index
  scf.for %position = [%c0 to %c8 step %c1] {
    %value = view.load %source[%position] : view<8xi32> -> i32
    %second = index.add %position, %c8 : index
    view.store %value, %destination[%position] : i32, view<16xi32>
    view.store %value, %destination[%second] : i32, view<16xi32>
  }
  func.return
}

check.scenario @signed_origin_values {
  check.trial[2](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-71) step(23) : tensor<8xi32>
    check.generate<@set_origin_control>(%input, %trial) : (tensor<8xi32>, index) -> ()
    %output = check.generate.fill value(0) : tensor<16xi32>
    check.compare<@copy_from_signed_origin, @copy_origin_oracle>(%input, %output) : (tensor<8xi32>, tensor<16xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<8xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<16xi32>
    }
  }
  check.return
}

// Private storage has explicit bounds. Both selected origins access valid
// elements without requiring a correlation between separate selections.
func.def @private_signed_origin(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %source_bytes = index.constant 32 : offset
  %private_input = buffer.alloca<private> align(16) %source_bytes : buffer
  %incoming = buffer.view %input[%origin] : buffer -> view<8xi32>
  %outgoing = buffer.view %output[%origin] : buffer -> view<4xi32>
  %source = buffer.view %private_input[%origin] : buffer -> view<8xi32>
  %begin = index.constant 0 : index
  %end = index.constant 8 : index
  %c1 = index.constant 1 : index
  scf.for %position = [%begin to %end step %c1] {
    %value = view.load %incoming[%position] : view<8xi32> -> i32
    view.store<volatile> %value, %source[%position] : i32, view<8xi32>
  }
  %control = view.load %incoming[0] : view<8xi32> -> i32
  %control_zero = scalar.constant 0 : i32
  %shift_origin = scalar.cmpi ne, %control, %control_zero : i32
  %backward = index.constant -16 : index
  %ordinary = buffer.view %private_input[%origin] : buffer -> view<12xi32>
  %shifted = buffer.view %private_input[%backward] : buffer -> view<12xi32>
  %selected = scf.select %shift_origin, %shifted, %ordinary : view<12xi32>
  %packet = vector.load<volatile> %selected[4] : view<12xi32> -> vector<4xi32>
  vector.store %packet, %outgoing[0] : vector<4xi32>, view<4xi32>
  func.return
}

func.def @private_origin_oracle(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %source = buffer.view %input[%origin] : buffer -> view<8xi32>
  %destination = buffer.view %output[%origin] : buffer -> view<4xi32>
  %control = view.load %source[0] : view<8xi32> -> i32
  %control_zero = scalar.constant 0 : i32
  %first_half = scalar.cmpi ne, %control, %control_zero : i32
  %c0 = index.constant 0 : index
  %c4 = index.constant 4 : index
  %c1 = index.constant 1 : index
  %start = scf.select %first_half, %c0, %c4 : index
  scf.for %position = [%c0 to %c4 step %c1] {
    %source_position = index.add %start, %position : index
    %value = view.load %source[%source_position] : view<8xi32> -> i32
    view.store %value, %destination[%position] : i32, view<4xi32>
  }
  func.return
}

func.def @set_origin_control(%input: buffer, %trial: index) {
  %origin = index.constant 0 : offset
  %view = buffer.view %input[%origin] : buffer -> view<8xi32>
  %control = index.cast %trial : index to i32
  view.store %control, %view[0] : i32, view<8xi32>
  func.return
}

check.scenario @private_signed_origin_values {
  check.trial[2](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-71) step(23) : tensor<8xi32>
    check.generate<@set_origin_control>(%input, %trial) : (tensor<8xi32>, index) -> ()
    %output = check.generate.fill value(0) : tensor<4xi32>
    check.compare<@private_signed_origin, @private_origin_oracle>(%input, %output) : (tensor<8xi32>, tensor<4xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<8xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi32>
    }
  }
  check.return
}

func.def noinline @make_signed_origin(%input: buffer) -> (view<12xi32>) {
  %backward = index.constant -16 : index
  %view = buffer.view %input[%backward] : buffer -> view<12xi32>
  func.return %view : view<12xi32>
}

func.def noinline @read_signed_origin(%input: view<12xi32>) -> (i32) {
  %value = view.load %input[4] : view<12xi32> -> i32
  func.return %value : i32
}

func.def @call_signed_origin(%input: buffer, %output: buffer) {
  %view = func.call @make_signed_origin(%input) : (buffer) -> (view<12xi32>)
  %value = func.call @read_signed_origin(%view) : (view<12xi32>) -> (i32)
  %origin = index.constant 0 : offset
  %destination = buffer.view %output[%origin] : buffer -> view<1xi32>
  view.store %value, %destination[0] : i32, view<1xi32>
  func.return
}

func.def @call_origin_oracle(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %source = buffer.view %input[%origin] : buffer -> view<8xi32>
  %destination = buffer.view %output[%origin] : buffer -> view<1xi32>
  %value = view.load %source[0] : view<8xi32> -> i32
  view.store %value, %destination[0] : i32, view<1xi32>
  func.return
}

check.scenario @call_signed_origin_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-71) step(23) : tensor<8xi32>
    %output = check.generate.fill value(0) : tensor<1xi32>
    check.compare<@call_signed_origin, @call_origin_oracle>(%input, %output) : (tensor<8xi32>, tensor<1xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<1xi32>
    }
  }
  check.return
}
