// Runtime pitches combine with uniform, varying, and predicate coordinates.
// A lane-selected buffer also exercises full-width pointer arithmetic around
// the bounded products. Inputs cross the kernel boundary without specialization.
kernel.def @runtime_address_factors() {
  %unit = index.constant 1 : index
  %lanes = index.constant 8 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%lanes, %unit, %unit) : index
} launch(%input: buffer, %alternate: buffer, %output: buffer, %row_input: index, %columns_input: offset) {
  %row = index.assume %row_input [range(%row_input, 0, 7)] : index
  %columns_offset = index.assume %columns_input [range(%columns_input, 1, 8)] : offset
  %columns = index.cast %columns_offset : offset to index
  %lane = kernel.workitem.id<x> : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %pitch = index.add %row, %c1 : index
  %lane_pitch = index.add %lane, %c1 : index
  %parity = index.rem %lane, %c2 : index
  %even = index.cmp eq, %parity, %c0 : index
  %predicate_coordinate = index.cast %even : i1 to index
  %row_nonzero = index.cmp ne, %row, %c0 : index
  %uniform_predicate_coordinate = index.cast %row_nonzero : i1 to index
  %base = index.constant 0 : offset
  %scalar_layout = encoding.layout.strided [%pitch, 1] : encoding<layout>
  %varying_layout = encoding.layout.strided [%lane_pitch, 1] : encoding<layout>
  %scalar_view = buffer.view %input[%base] : buffer -> view<8x1xi32, %scalar_layout>
  %varying_view = buffer.view %input[%base] : buffer -> view<8x1xi32, %varying_layout>
  %cube = buffer.view %input[%base] : buffer -> view<8x[%pitch]x[%columns]xi32>
  %selected = scf.select %even, %input, %alternate : buffer
  %selected_view = buffer.view %selected[%base] : buffer -> view<8x1xi32, %scalar_layout>
  %vector_scalar = view.load %scalar_view[%lane, 0] : view<8x1xi32, %scalar_layout> -> i32
  %scalar_vector = view.load %varying_view[%row, 0] : view<8x1xi32, %varying_layout> -> i32
  %vector_vector = view.load %varying_view[%lane, 0] : view<8x1xi32, %varying_layout> -> i32
  %multiple_factors = view.load %cube[%lane, 0, 0] : view<8x[%pitch]x[%columns]xi32> -> i32
  %predicate_scalar = view.load %scalar_view[%predicate_coordinate, 0] : view<8x1xi32, %scalar_layout> -> i32
  %predicate_vector = view.load %varying_view[%uniform_predicate_coordinate, 0] : view<8x1xi32, %varying_layout> -> i32
  %flat_product = view.load %selected_view[%lane, 0] : view<8x1xi32, %scalar_layout> -> i32
  %destination = buffer.view %output[%base] : buffer -> view<7x8xi32>
  view.store %vector_scalar, %destination[0, %lane] : i32, view<7x8xi32>
  view.store %scalar_vector, %destination[1, %lane] : i32, view<7x8xi32>
  view.store %vector_vector, %destination[2, %lane] : i32, view<7x8xi32>
  view.store %multiple_factors, %destination[3, %lane] : i32, view<7x8xi32>
  view.store %predicate_scalar, %destination[4, %lane] : i32, view<7x8xi32>
  view.store %predicate_vector, %destination[5, %lane] : i32, view<7x8xi32>
  view.store %flat_product, %destination[6, %lane] : i32, view<7x8xi32>
  kernel.return
}

// The scalar oracle uses flat element indices, with no dynamic layout or
// multidimensional view expansion shared with the subject.
func.def @runtime_address_factors_oracle(%input: buffer, %alternate: buffer, %output: buffer, %row_input: index, %columns_input: offset) {
  %row = index.assume %row_input [range(%row_input, 0, 7)] : index
  %columns_offset = index.assume %columns_input [range(%columns_input, 1, 8)] : offset
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<512xi32>
  %other = buffer.view %alternate[%base] : buffer -> view<512xi32>
  %destination = buffer.view %output[%base] : buffer -> view<7x8xi32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c8 = index.constant 8 : index
  %pitch = index.add %row, %c1 : index
  %columns = index.cast %columns_offset : offset to index
  %row_nonzero = index.cmp ne, %row, %c0 : index
  scf.for %lane = [%c0 to %c8 step %c1] {
    %lane_pitch = index.add %lane, %c1 : index
    %parity = index.rem %lane, %c2 : index
    %even = index.cmp eq, %parity, %c0 : index
    %vector_scalar_index = index.mul %lane, %pitch : index
    %scalar_vector_index = index.mul %row, %lane_pitch : index
    %vector_vector_index = index.mul %lane, %lane_pitch : index
    %multiple_index = index.mul %vector_scalar_index, %columns : index
    %predicate_scalar_index = scf.select %even, %pitch, %c0 : index
    %predicate_vector_index = scf.select %row_nonzero, %lane_pitch, %c0 : index
    %vector_scalar = view.load %source[%vector_scalar_index] : view<512xi32> -> i32
    %scalar_vector = view.load %source[%scalar_vector_index] : view<512xi32> -> i32
    %vector_vector = view.load %source[%vector_vector_index] : view<512xi32> -> i32
    %multiple = view.load %source[%multiple_index] : view<512xi32> -> i32
    %predicate_scalar = view.load %source[%predicate_scalar_index] : view<512xi32> -> i32
    %predicate_vector = view.load %source[%predicate_vector_index] : view<512xi32> -> i32
    %alternate_value = view.load %other[%vector_scalar_index] : view<512xi32> -> i32
    %selected = scf.select %even, %vector_scalar, %alternate_value : i32
    view.store %vector_scalar, %destination[0, %lane] : i32, view<7x8xi32>
    view.store %scalar_vector, %destination[1, %lane] : i32, view<7x8xi32>
    view.store %vector_vector, %destination[2, %lane] : i32, view<7x8xi32>
    view.store %multiple, %destination[3, %lane] : i32, view<7x8xi32>
    view.store %predicate_scalar, %destination[4, %lane] : i32, view<7x8xi32>
    view.store %predicate_vector, %destination[5, %lane] : i32, view<7x8xi32>
    view.store %selected, %destination[6, %lane] : i32, view<7x8xi32>
  }
  func.return
}

check.scenario @runtime_factor_values {
  check.trial[8](%trial: index, %entropy: check.entropy) {
    %columns = check.literal value(8) : offset
    %input_storage = check.generate.iota offset(101) step(7) : tensor<520xi32>
    %alternate_storage = check.generate.iota offset(-701) step(-11) : tensor<520xi32>
    %output_storage = check.generate.fill value(-889275714) : tensor<64xi32>
    %input = check.tensor.view %input_storage offset(16) : tensor<520xi32> -> tensor<512xi32>
    %alternate = check.tensor.view %alternate_storage offset(16) : tensor<520xi32> -> tensor<512xi32>
    %output = check.tensor.view %output_storage offset(16) : tensor<64xi32> -> tensor<56xi32>
    check.compare<@runtime_address_factors, @runtime_address_factors_oracle>(%input, %alternate, %output, %trial, %columns) : (tensor<512xi32>, tensor<512xi32>, tensor<56xi32>, index, offset) -> () {
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<520xi32>
      check.expect.bitwise actual(%alternate_storage) expected(%alternate_storage) : tensor<520xi32>
      check.expect.bitwise actual(%output_storage) expected(%output_storage) : tensor<64xi32>
    }
  }
  check.return
}

// Complete packets occupy a runtime number of blocks. The launch guard counts
// packets while the view capacity multiplies the block count by its row size.
kernel.def @runtime_block_transfer() {
  %groups = index.constant 2 : index
  %lanes = index.constant 32 : index
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %unit, %unit) workgroup_size(%lanes, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %blocks_input: index, %packets_input: index) {
  %blocks = index.assume %blocks_input [range(%blocks_input, 0, 7)] : index
  %packets = index.assume %packets_input [range(%packets_input, 0, 8)] : index
  %base = index.constant 0 : offset
  %packet_width = index.constant 16 : index
  %workgroup_width = index.constant 32 : index
  %group = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %packet = index.madd %group, %workgroup_width, %lane : index
  %packet_count = index.mul %blocks, %packets : index
  %block_elements = index.mul %packets, %packet_width : index
  %elements = index.mul %blocks, %block_elements : index
  %source = buffer.view %input[%base] : buffer -> view<[%elements]xi32>
  %destination = buffer.view %output[%base] : buffer -> view<[%elements]xi32>
  %active = index.cmp ult, %packet, %packet_count : index
  scf.if %active {
    %position = index.mul %packet, %packet_width : index
    %values = vector.load %source[%position] : view<[%elements]xi32> -> vector<16xi32>
    vector.store %values, %destination[%position] : vector<16xi32>, view<[%elements]xi32>
  }
  kernel.return
}

// A flat scalar copy independently computes the active prefix. It shares no
// packet launch, vector footprint, or dynamically shaped view with the subject.
func.def @runtime_block_transfer_oracle(%input: buffer, %output: buffer, %blocks_input: index, %packets_input: index) {
  %blocks = index.assume %blocks_input [range(%blocks_input, 0, 7)] : index
  %packets = index.assume %packets_input [range(%packets_input, 0, 8)] : index
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %packet_width = index.constant 16 : index
  %packet_count = index.mul %blocks, %packets : index
  %element_count = index.mul %packet_count, %packet_width : index
  %source = buffer.view %input[%base] : buffer -> view<896xi32>
  %destination = buffer.view %output[%base] : buffer -> view<896xi32>
  scf.for %position = [%c0 to %element_count step %c1] {
    %value = view.load %source[%position] : view<896xi32> -> i32
    view.store %value, %destination[%position] : i32, view<896xi32>
  }
  func.return
}

// The two harness domains enumerate every block/packet pair. Both coordinates
// are runtime arguments, not specialization parameters of the subject.
check.scenario @runtime_block_transfer_values configure[8](%blocks: index, %configuration_entropy: check.entropy) {
  check.trial[9](%packets: index, %entropy: check.entropy) {
    %input_storage = check.generate.iota offset(-311) step(7) : tensor<904xi32>
    %output_storage = check.generate.fill value(-889275714) : tensor<904xi32>
    %input = check.tensor.view %input_storage offset(16) : tensor<904xi32> -> tensor<896xi32>
    %output = check.tensor.view %output_storage offset(16) : tensor<904xi32> -> tensor<896xi32>
    check.compare<@runtime_block_transfer, @runtime_block_transfer_oracle>(%input, %output, %blocks, %packets) : (tensor<896xi32>, tensor<896xi32>, index, index) -> () {
      check.expect.bitwise actual(%input_storage) expected(%input_storage) : tensor<904xi32>
      check.expect.bitwise actual(%output_storage) expected(%output_storage) : tensor<904xi32>
    }
  }
  check.return
}
