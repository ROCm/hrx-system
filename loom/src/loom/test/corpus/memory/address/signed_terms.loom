// Signed lookup coordinates remain signed after their bias is folded into
// the memory instruction. Exercise byte, word, and non-power-of-two strides.
func.def device inline @evaluate_signed_lookup(%input: buffer, %bytes: buffer, %words: buffer, %byte_output: buffer, %word_output: buffer, %strided_output: buffer, %lane: index) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<256xi8>
  %byte_table = buffer.view %bytes[%base] : buffer -> view<256xi8>
  %word_table = buffer.view %words[%base] : buffer -> view<768xi32>
  %layout = encoding.layout.strided [3] : encoding<layout>
  %strided_table = buffer.view %words[%base] : buffer -> view<256xi32, %layout>
  %byte_destination = buffer.view %byte_output[%base] : buffer -> view<256xi8>
  %word_destination = buffer.view %word_output[%base] : buffer -> view<256xi32>
  %strided_destination = buffer.view %strided_output[%base] : buffer -> view<256xi32>
  %byte = view.load %source[%lane] : view<256xi8> -> i8
  %signed = scalar.extsi %byte : i8 to i32
  %bias = scalar.constant 128 : i32
  %ordinal = scalar.addi %signed, %bias : i32
  %position = index.cast %ordinal : i32 to index
  %byte_value = view.load %byte_table[%position] : view<256xi8> -> i8
  %word_value = view.load %word_table[%position] : view<768xi32> -> i32
  %strided_value = view.load %strided_table[%position] : view<256xi32, %layout> -> i32
  view.store %byte_value, %byte_destination[%lane] : i8, view<256xi8>
  view.store %word_value, %word_destination[%lane] : i32, view<256xi32>
  view.store %strided_value, %strided_destination[%lane] : i32, view<256xi32>
  func.return
}

kernel.def @signed_lookup() {
  %unit = index.constant 1 : index
  %width = index.constant 256 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %bytes: buffer, %words: buffer, %byte_output: buffer, %word_output: buffer, %strided_output: buffer) {
  %lane = kernel.workitem.id<x> : index
  func.call @evaluate_signed_lookup(%input, %bytes, %words, %byte_output, %word_output, %strided_output, %lane) : (buffer, buffer, buffer, buffer, buffer, buffer, index)
  kernel.return
}

func.def @signed_lookup_oracle(%input: buffer, %bytes: buffer, %words: buffer, %byte_output: buffer, %word_output: buffer, %strided_output: buffer) {
  %begin = index.constant 0 : index
  %end = index.constant 256 : index
  %step = index.constant 1 : index
  scf.for %lane = [%begin to %end step %step] {
    func.call @evaluate_signed_lookup(%input, %bytes, %words, %byte_output, %word_output, %strided_output, %lane) : (buffer, buffer, buffer, buffer, buffer, buffer, index)
  }
  func.return
}

check.scenario @signed_lookup_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-128) step(1) : tensor<256xi8>
    %bytes = check.generate.iota offset(-128) step(1) : tensor<256xi8>
    %words = check.generate.iota offset(11) step(7) : tensor<768xi32>
    %byte_output = check.generate.fill value(0) : tensor<256xi8>
    %word_output = check.generate.fill value(-1) : tensor<256xi32>
    %strided_output = check.generate.fill value(-1) : tensor<256xi32>
    check.compare<@signed_lookup, @signed_lookup_oracle>(%input, %bytes, %words, %byte_output, %word_output, %strided_output) : (tensor<256xi8>, tensor<256xi8>, tensor<768xi32>, tensor<256xi8>, tensor<256xi32>, tensor<256xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<256xi8>
      check.expect.bitwise actual(%bytes) expected(%bytes) : tensor<256xi8>
      check.expect.bitwise actual(%words) expected(%words) : tensor<768xi32>
      check.expect.bitwise actual(%byte_output) expected(%byte_output) : tensor<256xi8>
      check.expect.bitwise actual(%word_output) expected(%word_output) : tensor<256xi32>
      check.expect.bitwise actual(%strided_output) expected(%strided_output) : tensor<256xi32>
    }
  }
  check.return
}

func.def device inline @evaluate_signed_uniform_lookup(%input: i32, %table: buffer, %output: buffer) {
  %signed = scalar.assume %input [range(%input, -128, 127)] : i32
  %bias = scalar.constant 128 : i32
  %ordinal = scalar.addi %signed, %bias : i32
  %position = index.cast %ordinal : i32 to index
  %base = index.constant 0 : offset
  %source = buffer.view %table[%base] : buffer -> view<256xi32>
  %destination = buffer.view %output[%base] : buffer -> view<1xi32>
  %value = view.load %source[%position] : view<256xi32> -> i32
  view.store %value, %destination[0] : i32, view<1xi32>
  func.return
}

kernel.def @signed_uniform_lookup() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: i32, %table: buffer, %output: buffer) {
  func.call @evaluate_signed_uniform_lookup(%input, %table, %output) : (i32, buffer, buffer)
  kernel.return
}

func.def @signed_uniform_lookup_oracle(%input: i32, %table: buffer, %output: buffer) {
  func.call @evaluate_signed_uniform_lookup(%input, %table, %output) : (i32, buffer, buffer)
  func.return
}

check.scenario @signed_uniform_lookup_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.literal value(-128) : i32
    %table = check.generate.iota offset(11) step(7) : tensor<256xi32>
    %output = check.generate.fill value(-1) : tensor<1xi32>
    check.compare<@signed_uniform_lookup, @signed_uniform_lookup_oracle>(%input, %table, %output) : (i32, tensor<256xi32>, tensor<1xi32>) -> () {
      check.expect.bitwise actual(%table) expected(%table) : tensor<256xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<1xi32>
    }
  }
  check.return
}

kernel.def @workgroup_signed_coordinates() {
  %unit = index.constant 1 : index
  %width = index.constant 256 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<256xi8>
  %destination = buffer.view %output[%base] : buffer -> view<256xi32>
  %length = index.constant 1024 : offset
  %scratch = buffer.alloca<workgroup> align(4) %length : buffer
  %scratch_view = buffer.view %scratch[%base] : buffer -> view<256xi32>
  %byte = view.load %source[%lane] : view<256xi8> -> i8
  %signed = scalar.extsi %byte : i8 to i32
  %bias = scalar.constant 128 : i32
  %ordinal = scalar.addi %signed, %bias : i32
  %position = index.cast %ordinal : i32 to index
  view.store %signed, %scratch_view[%position] : i32, view<256xi32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %value = view.load %scratch_view[%lane] : view<256xi32> -> i32
  view.store %value, %destination[%lane] : i32, view<256xi32>
  kernel.return
}

func.def @workgroup_signed_coordinates_oracle(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<256xi8>
  %destination = buffer.view %output[%base] : buffer -> view<256xi32>
  %begin = index.constant 0 : index
  %end = index.constant 256 : index
  %step = index.constant 1 : index
  scf.for %lane = [%begin to %end step %step] {
    %byte = view.load %source[%lane] : view<256xi8> -> i8
    %signed = scalar.extsi %byte : i8 to i32
    %bias = scalar.constant 128 : i32
    %ordinal = scalar.addi %signed, %bias : i32
    %position = index.cast %ordinal : i32 to index
    view.store %signed, %destination[%position] : i32, view<256xi32>
  }
  func.return
}

check.scenario @workgroup_signed_coordinate_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-128) step(1) : tensor<256xi8>
    %output = check.generate.fill value(999) : tensor<256xi32>
    check.compare<@workgroup_signed_coordinates, @workgroup_signed_coordinates_oracle>(%input, %output) : (tensor<256xi8>, tensor<256xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<256xi8>
      check.expect.bitwise actual(%output) expected(%output) : tensor<256xi32>
    }
  }
  check.return
}

// Uniform and varying countdowns address the same private array from opposite
// ends while keeping every complete byte address in bounds.
kernel.def @private_descending_coordinates() {
  %unit = index.constant 1 : index
  %width = index.constant 15 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%position: i64, %input: buffer, %output: buffer) where [range(%position, 0, 14)] {
  %lane = kernel.workitem.id<x> : index
  %lane_i64 = index.cast %lane : index to i64
  %base = index.constant 0 : offset
  %bytes = index.constant 60 : offset
  %begin = index.constant 0 : index
  %end = index.constant 15 : index
  %step = index.constant 1 : index
  %last = scalar.constant 14 : i64
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %scratch = buffer.alloca<private> align(4) %bytes : buffer
  %source = buffer.view %input[%base] : buffer -> view<15xi32>
  %private = buffer.view %scratch[%base] : buffer -> view<15xi32>
  %destination = buffer.view %output[%base] : buffer -> view<15x2xi32>
  scf.for %i = [%begin to %end step %step] {
    %value = view.load %source[%i] : view<15xi32> -> i32
    view.store %value, %private[%i] : i32, view<15xi32>
  }
  %uniform_i64 = scalar.subi %last, %position : i64
  %uniform = index.cast %uniform_i64 : i64 to index
  %varying_i64 = scalar.subi %last, %lane_i64 : i64
  %varying = index.cast %varying_i64 : i64 to index
  %uniform_value = view.load %private[%uniform] : view<15xi32> -> i32
  %varying_value = view.load %private[%varying] : view<15xi32> -> i32
  view.store %uniform_value, %destination[%lane, %c0] : i32, view<15x2xi32>
  view.store %varying_value, %destination[%lane, %c1] : i32, view<15x2xi32>
  kernel.return
}

func.def @private_descending_coordinates_oracle(%position: i64, %input: buffer, %output: buffer) where [range(%position, 0, 14)] {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 15 : index
  %step = index.constant 1 : index
  %last = scalar.constant 14 : i64
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %source = buffer.view %input[%base] : buffer -> view<15xi32>
  %destination = buffer.view %output[%base] : buffer -> view<15x2xi32>
  %uniform_i64 = scalar.subi %last, %position : i64
  %uniform = index.cast %uniform_i64 : i64 to index
  %uniform_value = view.load %source[%uniform] : view<15xi32> -> i32
  scf.for %lane = [%begin to %end step %step] {
    %lane_i64 = index.cast %lane : index to i64
    %varying_i64 = scalar.subi %last, %lane_i64 : i64
    %varying = index.cast %varying_i64 : i64 to index
    %varying_value = view.load %source[%varying] : view<15xi32> -> i32
    view.store %uniform_value, %destination[%lane, %c0] : i32, view<15x2xi32>
    view.store %varying_value, %destination[%lane, %c1] : i32, view<15x2xi32>
  }
  func.return
}

check.scenario @private_descending_coordinate_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %position = check.literal value(7) : i64
    %input = check.generate.iota offset(17) step(13) : tensor<15xi32>
    %output = check.generate.fill value(-1) : tensor<15x2xi32>
    check.compare<@private_descending_coordinates, @private_descending_coordinates_oracle>(%position, %input, %output) : (i64, tensor<15xi32>, tensor<15x2xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<15xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<15x2xi32>
    }
  }
  check.return
}
