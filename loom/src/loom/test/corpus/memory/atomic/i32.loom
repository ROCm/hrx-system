// Each cell isolates one integer atomic operation. Reductions run before their
// returning forms so both packet shapes contribute to the observed result.
func.def inline @integer_atomic_i32_cells(%initial: i32, %value: i32, %storage: buffer, %output: buffer, %output_base: offset, %storage_base: offset) {
  %begin = index.constant 1 : index
  %end = index.constant 13 : index
  %step = index.constant 1 : index
  %final_bias = index.constant 12 : index
  %inversion_mask = scalar.constant -1 : i32
  %state = buffer.view %storage[%storage_base] : buffer -> view<14xi32>
  %results = buffer.view %output[%output_base] : buffer -> view<26xi32>
  scf.for %cell = [%begin to %end step %step] {
    view.store %initial, %state[%cell] : i32, view<14xi32>
  }
  view.atomic.reduce<addi> %value, %state[1] {ordering = relaxed, scope = device} : i32, view<14xi32>
  %old_add = view.atomic.rmw<addi> %value, %state[1] {ordering = relaxed, scope = device} : i32, view<14xi32> -> i32
  view.store %old_add, %results[1] : i32, view<26xi32>
  view.atomic.reduce<subi> %value, %state[2] {ordering = relaxed, scope = device} : i32, view<14xi32>
  %old_sub = view.atomic.rmw<subi> %value, %state[2] {ordering = relaxed, scope = device} : i32, view<14xi32> -> i32
  view.store %old_sub, %results[2] : i32, view<26xi32>
  view.atomic.reduce<minsi> %value, %state[3] {ordering = relaxed, scope = device} : i32, view<14xi32>
  %old_signed_min = view.atomic.rmw<minsi> %value, %state[3] {ordering = relaxed, scope = device} : i32, view<14xi32> -> i32
  view.store %old_signed_min, %results[3] : i32, view<26xi32>
  view.atomic.reduce<maxsi> %value, %state[4] {ordering = relaxed, scope = device} : i32, view<14xi32>
  %old_signed_max = view.atomic.rmw<maxsi> %value, %state[4] {ordering = relaxed, scope = device} : i32, view<14xi32> -> i32
  view.store %old_signed_max, %results[4] : i32, view<26xi32>
  view.atomic.reduce<minui> %value, %state[5] {ordering = relaxed, scope = device} : i32, view<14xi32>
  %old_unsigned_min = view.atomic.rmw<minui> %value, %state[5] {ordering = relaxed, scope = device} : i32, view<14xi32> -> i32
  view.store %old_unsigned_min, %results[5] : i32, view<26xi32>
  view.atomic.reduce<maxui> %value, %state[6] {ordering = relaxed, scope = device} : i32, view<14xi32>
  %old_unsigned_max = view.atomic.rmw<maxui> %value, %state[6] {ordering = relaxed, scope = device} : i32, view<14xi32> -> i32
  view.store %old_unsigned_max, %results[6] : i32, view<26xi32>
  view.atomic.reduce<andi> %value, %state[7] {ordering = relaxed, scope = device} : i32, view<14xi32>
  %old_and = view.atomic.rmw<andi> %value, %state[7] {ordering = relaxed, scope = device} : i32, view<14xi32> -> i32
  view.store %old_and, %results[7] : i32, view<26xi32>
  view.atomic.reduce<ori> %value, %state[8] {ordering = relaxed, scope = device} : i32, view<14xi32>
  %old_or = view.atomic.rmw<ori> %value, %state[8] {ordering = relaxed, scope = device} : i32, view<14xi32> -> i32
  view.store %old_or, %results[8] : i32, view<26xi32>
  view.atomic.reduce<xori> %value, %state[9] {ordering = relaxed, scope = device} : i32, view<14xi32>
  %old_xor = view.atomic.rmw<xori> %value, %state[9] {ordering = relaxed, scope = device} : i32, view<14xi32> -> i32
  view.store %old_xor, %results[9] : i32, view<26xi32>
  %old_exchange = view.atomic.rmw<xchgi> %value, %state[10] {ordering = relaxed, scope = device} : i32, view<14xi32> -> i32
  view.store %old_exchange, %results[10] : i32, view<26xi32>
  %old_success = view.atomic.cmpxchg %initial, %value, %state[11] {failure_ordering = relaxed, scope = device, success_ordering = relaxed} : i32, view<14xi32> -> i32
  view.store %old_success, %results[11] : i32, view<26xi32>
  %wrong = scalar.xori %initial, %inversion_mask : i32
  %old_failure = view.atomic.cmpxchg %wrong, %value, %state[12] {failure_ordering = relaxed, scope = device, success_ordering = relaxed} : i32, view<14xi32> -> i32
  view.store %old_failure, %results[12] : i32, view<26xi32>
  scf.for %cell = [%begin to %end step %step] {
    %result = index.add %cell, %final_bias : index
    %final = view.load %state[%cell] : view<14xi32> -> i32
    view.store %final, %results[%result] : i32, view<26xi32>
  }
  %first_guard = view.load %state[0] : view<14xi32> -> i32
  %last_guard = view.load %state[13] : view<14xi32> -> i32
  view.store %first_guard, %results[0] : i32, view<26xi32>
  view.store %last_guard, %results[25] : i32, view<26xi32>
  func.return
}

kernel.def @integer_atomic_i32() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%initial_bits: i64, %value_bits: i64, %global_storage: buffer, %generic_storage: buffer, %output: buffer) {
  %global_base = index.constant 0 : offset
  %generic_base = index.constant 104 : offset
  %workgroup_base = index.constant 208 : offset
  %workgroup_bytes = index.constant 56 : offset
  %guard = scalar.constant 1515870810 : i32
  %initial = scalar.trunci %initial_bits : i64 to i32
  %value = scalar.trunci %value_bits : i64 to i32
  %global = buffer.assume.memory_space<global> %global_storage : buffer
  %generic = buffer.assume.memory_space<generic> %generic_storage : buffer
  %workgroup = buffer.alloca<workgroup> align(4) %workgroup_bytes : buffer
  %workgroup_view = buffer.view %workgroup[%global_base] : buffer -> view<14xi32>
  view.store %guard, %workgroup_view[0] : i32, view<14xi32>
  view.store %guard, %workgroup_view[13] : i32, view<14xi32>
  func.call @integer_atomic_i32_cells(%initial, %value, %global, %output, %global_base, %global_base) : (i32, i32, buffer, buffer, offset, offset)
  func.call @integer_atomic_i32_cells(%initial, %value, %generic, %output, %generic_base, %global_base) : (i32, i32, buffer, buffer, offset, offset)
  func.call @integer_atomic_i32_cells(%initial, %value, %workgroup, %output, %workgroup_base, %global_base) : (i32, i32, buffer, buffer, offset, offset)
  kernel.return
}

// Runtime-loaded byte origins exercise the same complete operation family
// without a static address-range proof. Guard cells surround every update.
kernel.def @indirect_integer_atomic_i32() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%initial_bits: i64, %value_bits: i64, %offsets: buffer, %global_storage: buffer, %generic_storage: buffer, %output: buffer) {
  %c0 = index.constant 0 : offset
  %generic_base = index.constant 104 : offset
  %indices = buffer.view %offsets[%c0] : buffer -> view<1xi64>
  %byte_offset = view.load %indices[0] : view<1xi64> -> i64
  %nonnegative = scalar.assume %byte_offset [range(%byte_offset, 0, 9223372036854775807)] : i64
  %storage_base = index.cast %nonnegative : i64 to offset
  %initial = scalar.trunci %initial_bits : i64 to i32
  %value = scalar.trunci %value_bits : i64 to i32
  %global = buffer.assume.memory_space<global> %global_storage : buffer
  %generic = buffer.assume.memory_space<generic> %generic_storage : buffer
  func.call @integer_atomic_i32_cells(%initial, %value, %global, %output, %c0, %storage_base) : (i32, i32, buffer, buffer, offset, offset)
  func.call @integer_atomic_i32_cells(%initial, %value, %generic, %output, %generic_base, %storage_base) : (i32, i32, buffer, buffer, offset, offset)
  kernel.return
}

// The oracle computes ordinary scalar expressions. It neither executes atomic
// operations nor shares storage with the device invocation.
func.def inline @integer_atomic_i32_cells_oracle(%initial: i32, %value: i32, %storage: buffer, %output: buffer, %output_base: offset, %storage_base: offset) {
  %state = buffer.view %storage[%storage_base] : buffer -> view<14xi32>
  %results = buffer.view %output[%output_base] : buffer -> view<26xi32>
  %guard = scalar.constant 1515870810 : i32
  view.store %guard, %state[0] : i32, view<14xi32>
  view.store %guard, %state[13] : i32, view<14xi32>
  view.store %guard, %results[0] : i32, view<26xi32>
  view.store %guard, %results[25] : i32, view<26xi32>
  %old_add = scalar.addi %initial, %value : i32
  %final_add = scalar.addi %old_add, %value : i32
  view.store %old_add, %results[1] : i32, view<26xi32>
  view.store %final_add, %results[13] : i32, view<26xi32>
  view.store %final_add, %state[1] : i32, view<14xi32>
  %old_sub = scalar.subi %initial, %value : i32
  %final_sub = scalar.subi %old_sub, %value : i32
  view.store %old_sub, %results[2] : i32, view<26xi32>
  view.store %final_sub, %results[14] : i32, view<26xi32>
  view.store %final_sub, %state[2] : i32, view<14xi32>
  %signed_min = scalar.minsi %initial, %value : i32
  view.store %signed_min, %results[3] : i32, view<26xi32>
  view.store %signed_min, %results[15] : i32, view<26xi32>
  view.store %signed_min, %state[3] : i32, view<14xi32>
  %signed_max = scalar.maxsi %initial, %value : i32
  view.store %signed_max, %results[4] : i32, view<26xi32>
  view.store %signed_max, %results[16] : i32, view<26xi32>
  view.store %signed_max, %state[4] : i32, view<14xi32>
  %unsigned_min = scalar.minui %initial, %value : i32
  view.store %unsigned_min, %results[5] : i32, view<26xi32>
  view.store %unsigned_min, %results[17] : i32, view<26xi32>
  view.store %unsigned_min, %state[5] : i32, view<14xi32>
  %unsigned_max = scalar.maxui %initial, %value : i32
  view.store %unsigned_max, %results[6] : i32, view<26xi32>
  view.store %unsigned_max, %results[18] : i32, view<26xi32>
  view.store %unsigned_max, %state[6] : i32, view<14xi32>
  %bitwise_and = scalar.andi %initial, %value : i32
  view.store %bitwise_and, %results[7] : i32, view<26xi32>
  view.store %bitwise_and, %results[19] : i32, view<26xi32>
  view.store %bitwise_and, %state[7] : i32, view<14xi32>
  %bitwise_or = scalar.ori %initial, %value : i32
  view.store %bitwise_or, %results[8] : i32, view<26xi32>
  view.store %bitwise_or, %results[20] : i32, view<26xi32>
  view.store %bitwise_or, %state[8] : i32, view<14xi32>
  %old_xor = scalar.xori %initial, %value : i32
  %final_xor = scalar.xori %old_xor, %value : i32
  view.store %old_xor, %results[9] : i32, view<26xi32>
  view.store %final_xor, %results[21] : i32, view<26xi32>
  view.store %final_xor, %state[9] : i32, view<14xi32>
  view.store %initial, %results[10] : i32, view<26xi32>
  view.store %value, %results[22] : i32, view<26xi32>
  view.store %value, %state[10] : i32, view<14xi32>
  view.store %initial, %results[11] : i32, view<26xi32>
  view.store %value, %results[23] : i32, view<26xi32>
  view.store %value, %state[11] : i32, view<14xi32>
  view.store %initial, %results[12] : i32, view<26xi32>
  view.store %initial, %results[24] : i32, view<26xi32>
  view.store %initial, %state[12] : i32, view<14xi32>
  func.return
}

func.def @integer_atomic_i32_oracle(%initial_bits: i64, %value_bits: i64, %global_storage: buffer, %generic_storage: buffer, %output: buffer) {
  %global_base = index.constant 0 : offset
  %generic_base = index.constant 104 : offset
  %workgroup_base = index.constant 208 : offset
  %workgroup_bytes = index.constant 56 : offset
  %initial = scalar.trunci %initial_bits : i64 to i32
  %value = scalar.trunci %value_bits : i64 to i32
  %workgroup = buffer.alloca<private> align(4) %workgroup_bytes : buffer
  func.call @integer_atomic_i32_cells_oracle(%initial, %value, %global_storage, %output, %global_base, %global_base) : (i32, i32, buffer, buffer, offset, offset)
  func.call @integer_atomic_i32_cells_oracle(%initial, %value, %generic_storage, %output, %generic_base, %global_base) : (i32, i32, buffer, buffer, offset, offset)
  func.call @integer_atomic_i32_cells_oracle(%initial, %value, %workgroup, %output, %workgroup_base, %global_base) : (i32, i32, buffer, buffer, offset, offset)
  func.return
}

func.def @indirect_integer_atomic_i32_oracle(%initial_bits: i64, %value_bits: i64, %offsets: buffer, %global_storage: buffer, %generic_storage: buffer, %output: buffer) {
  %c0 = index.constant 0 : offset
  %generic_base = index.constant 104 : offset
