check.scenario @integer_atomic_i32_values {
  check.trial[32](%trial: index, %entropy: check.entropy) {
    %initial_entropy = check.entropy.fork %entropy name("initial") : check.entropy
    %value_entropy = check.entropy.fork %entropy name("value") : check.entropy
    %initial_bits = check.entropy.read %initial_entropy[%trial] : check.entropy -> i64
    %value_bits = check.entropy.read %value_entropy[%trial] : check.entropy -> i64
    %global = check.generate.fill value(1515870810) : tensor<14xi32>
    %generic = check.generate.fill value(1515870810) : tensor<14xi32>
    %output = check.generate.fill value(-1) : tensor<78xi32>
    check.compare<@integer_atomic_i32, @integer_atomic_i32_oracle>(%initial_bits, %value_bits, %global, %generic, %output) : (i64, i64, tensor<14xi32>, tensor<14xi32>, tensor<78xi32>) -> () {
      check.expect.bitwise actual(%global) expected(%global) : tensor<14xi32>
      check.expect.bitwise actual(%generic) expected(%generic) : tensor<14xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<78xi32>
    }
  }
  check.return
}

check.scenario @indirect_integer_atomic_i32_values {
  check.trial[16](%trial: index, %entropy: check.entropy) {
    %initial_entropy = check.entropy.fork %entropy name("initial") : check.entropy
    %value_entropy = check.entropy.fork %entropy name("value") : check.entropy
    %initial_bits = check.entropy.read %initial_entropy[%trial] : check.entropy -> i64
    %value_bits = check.entropy.read %value_entropy[%trial] : check.entropy -> i64
    %offsets = check.generate.fill value(8) : tensor<1xi64>
    %global = check.generate.fill value(1515870810) : tensor<18xi32>
    %generic = check.generate.fill value(1515870810) : tensor<18xi32>
    %output = check.generate.fill value(-1) : tensor<52xi32>
    check.compare<@indirect_integer_atomic_i32, @indirect_integer_atomic_i32_oracle>(%initial_bits, %value_bits, %offsets, %global, %generic, %output) : (i64, i64, tensor<1xi64>, tensor<18xi32>, tensor<18xi32>, tensor<52xi32>) -> () {
      check.expect.bitwise actual(%global) expected(%global) : tensor<18xi32>
      check.expect.bitwise actual(%generic) expected(%generic) : tensor<18xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<52xi32>
    }
  }
  check.return
}
