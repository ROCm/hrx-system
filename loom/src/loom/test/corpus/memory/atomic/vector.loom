      check.expect.bitwise actual(%memory) expected(%memory) : tensor<2xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<2xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %flag = check.literal value(1) : i32
    %memory = check.generate.fill value(2143294004) : tensor<2xi32>
    %output = check.generate.fill value(0) : tensor<2xi32>
    check.compare<@masked_float_old_bits, @masked_float_old_bits_oracle>(%flag, %memory, %output) : (i32, tensor<2xi32>, tensor<2xi32>) -> () {
      check.expect.bitwise actual(%memory) expected(%memory) : tensor<2xi32>
