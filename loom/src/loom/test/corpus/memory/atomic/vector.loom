// Duplicate active addresses must return distinct old values. Disabled lanes
// preserve their passthrough and leave the corresponding guard cells untouched.
kernel.def @masked_duplicate_atomic() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%flag: i32, %memory: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %global = buffer.assume.memory_space<global> %memory : buffer
  %view = buffer.view %global[%base] : buffer -> view<4xi32>
  %output_global = buffer.assume.memory_space<global> %output : buffer
  %results = buffer.view %output_global[%base] : buffer -> view<4xi32>
  %c0 = scalar.constant 0 : i32
  %enabled = scalar.cmpi ne, %flag, %c0 : i32
  %disabled = scalar.constant false : i1
  %mask = vector.from_elements %enabled, %disabled, %enabled, %disabled : vector<4xi1>
  %index0 = index.constant 0 : index
  %index2 = index.constant 2 : index
  %index3 = index.constant 3 : index
  %offsets = vector.from_elements %index0, %index2, %index0, %index3 : vector<4xindex>
  %increment = vector.splati 1 : vector<4xi32>
  %passthrough = vector.splati -101 : vector<4xi32>
  %old = vector.atomic.rmw.mask<addi> %increment, %view[0][%offsets], %mask, %passthrough {ordering = relaxed, scope = device} : vector<4xi32>, view<4xi32>, vector<4xindex>, vector<4xi1>, vector<4xi32>
  %first = vector.extract %old[0] : vector<4xi32> -> i32
  %second = vector.extract %old[2] : vector<4xi32> -> i32
  %lower = scalar.minsi %first, %second : i32
  %upper = scalar.maxsi %first, %second : i32
  %inactive1 = vector.extract %old[1] : vector<4xi32> -> i32
  %inactive3 = vector.extract %old[3] : vector<4xi32> -> i32
  view.store %lower, %results[0] : i32, view<4xi32>
  view.store %upper, %results[1] : i32, view<4xi32>
  view.store %inactive1, %results[2] : i32, view<4xi32>
  view.store %inactive3, %results[3] : i32, view<4xi32>
  kernel.return
}

func.def @masked_duplicate_atomic_oracle(%flag: i32, %memory: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %cells = buffer.view %memory[%base] : buffer -> view<4xi32>
  %results = buffer.view %output[%base] : buffer -> view<4xi32>
  %flag_clear = scalar.constant 0 : i32
  %enabled = scalar.cmpi ne, %flag, %flag_clear : i32
  %increment = scalar.constant 1 : i32
  %passthrough = scalar.constant -101 : i32
  %initial = view.load %cells[0] : view<4xi32> -> i32
  %successor = scalar.addi %initial, %increment : i32
  %final = scalar.addi %successor, %increment : i32
  %lower = scalar.minsi %initial, %successor : i32
  %upper = scalar.maxsi %initial, %successor : i32
  %selected_final = scf.select %enabled, %final, %initial : i32
  %selected_lower = scf.select %enabled, %lower, %passthrough : i32
  %selected_upper = scf.select %enabled, %upper, %passthrough : i32
  view.store %selected_final, %cells[0] : i32, view<4xi32>
  view.store %selected_lower, %results[0] : i32, view<4xi32>
  view.store %selected_upper, %results[1] : i32, view<4xi32>
  view.store %passthrough, %results[2] : i32, view<4xi32>
  view.store %passthrough, %results[3] : i32, view<4xi32>
  func.return
}

check.scenario @masked_duplicate_values {
  check.trial[16](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %flag = check.literal value(1) : i32
    %memory = check.generate.random.uniform seed(%seed) range(-2147483648 to 2147483647) : tensor<4xi32>
    %output = check.generate.fill value(0) : tensor<4xi32>
    check.compare<@masked_duplicate_atomic, @masked_duplicate_atomic_oracle>(%flag, %memory, %output) : (i32, tensor<4xi32>, tensor<4xi32>) -> () {
      check.expect.bitwise actual(%memory) expected(%memory) : tensor<4xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi32>
    }
  }
  check.trial[16](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %flag = check.literal value(0) : i32
    %memory = check.generate.random.uniform seed(%seed) range(-2147483648 to 2147483647) : tensor<4xi32>
    %output = check.generate.fill value(0) : tensor<4xi32>
    check.compare<@masked_duplicate_atomic, @masked_duplicate_atomic_oracle>(%flag, %memory, %output) : (i32, tensor<4xi32>, tensor<4xi32>) -> () {
      check.expect.bitwise actual(%memory) expected(%memory) : tensor<4xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi32>
    }
  }
  check.return
}

// An inactive offset may lie outside the view and must not become an access.
kernel.def @masked_outside_view() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%memory: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %global = buffer.assume.memory_space<global> %memory : buffer
  %view = buffer.view %global[%base] : buffer -> view<1xi32>
  %output_global = buffer.assume.memory_space<global> %output : buffer
  %results = buffer.view %output_global[%base] : buffer -> view<2xi32>
  %c0 = index.constant 0 : index
  %outside = index.constant -100 : index
  %offsets = vector.from_elements %c0, %outside : vector<2xindex>
  %enabled = scalar.constant true : i1
  %disabled = scalar.constant false : i1
  %mask = vector.from_elements %enabled, %disabled : vector<2xi1>
  %increment = vector.splati 1 : vector<2xi32>
  %passthrough = vector.splati -101 : vector<2xi32>
  %old = vector.atomic.rmw.mask<addi> %increment, %view[0][%offsets], %mask, %passthrough {ordering = relaxed, scope = device} : vector<2xi32>, view<1xi32>, vector<2xindex>, vector<2xi1>, vector<2xi32>
  vector.store %old, %results[0] : vector<2xi32>, view<2xi32>
  kernel.return
}

func.def @masked_outside_view_oracle(%memory: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %cells = buffer.view %memory[%base] : buffer -> view<1xi32>
  %results = buffer.view %output[%base] : buffer -> view<2xi32>
  %increment = scalar.constant 1 : i32
  %passthrough = scalar.constant -101 : i32
  %initial = view.load %cells[0] : view<1xi32> -> i32
  %final = scalar.addi %initial, %increment : i32
  view.store %final, %cells[0] : i32, view<1xi32>
  view.store %initial, %results[0] : i32, view<2xi32>
  view.store %passthrough, %results[1] : i32, view<2xi32>
  func.return
}

check.scenario @inactive_offset_outside_view {
  check.trial[16](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %memory = check.generate.random.uniform seed(%seed) range(-2147483648 to 2147483647) : tensor<1xi32>
    %output = check.generate.fill value(0) : tensor<2xi32>
    check.compare<@masked_outside_view, @masked_outside_view_oracle>(%memory, %output) : (tensor<1xi32>, tensor<2xi32>) -> () {
      check.expect.bitwise actual(%memory) expected(%memory) : tensor<1xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<2xi32>
    }
  }
  check.return
}

// NaN payloads in old values and passthrough lanes are transported as bits.
// The active lane uses the target's scalar floating-point atomic recipe.
kernel.def @masked_float_old_bits() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%flag: i32, %memory: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %global = buffer.assume.memory_space<global> %memory : buffer
  %view = buffer.view %global[%base] : buffer -> view<2xf32>
  %output_global = buffer.assume.memory_space<global> %output : buffer
  %results = buffer.view %output_global[%base] : buffer -> view<2xi32>
  %c0 = scalar.constant 0 : i32
  %enabled = scalar.cmpi ne, %flag, %c0 : i32
  %disabled = scalar.constant false : i1
  %mask = vector.from_elements %enabled, %disabled : vector<2xi1>
  %index0 = index.constant 0 : index
  %index1 = index.constant 1 : index
  %offsets = vector.iota %index0 step %index1 : vector<2xindex>
  %value = vector.splatf 1.0 : vector<2xf32>
  %passthrough_bits = vector.splati 2143311480 : vector<2xi32>
  %passthrough = vector.bitcast %passthrough_bits : vector<2xi32> to vector<2xf32>
  %old = vector.atomic.rmw.mask<minnumf> %value, %view[0][%offsets], %mask, %passthrough {ordering = relaxed, scope = device} : vector<2xf32>, view<2xf32>, vector<2xindex>, vector<2xi1>, vector<2xf32>
  %old_bits = vector.bitcast %old : vector<2xf32> to vector<2xi32>
  vector.store %old_bits, %results[0] : vector<2xi32>, view<2xi32>
  kernel.return
}

func.def @masked_float_old_bits_oracle(%flag: i32, %memory: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %cells = buffer.view %memory[%base] : buffer -> view<2xi32>
  %results = buffer.view %output[%base] : buffer -> view<2xi32>
  %flag_clear = scalar.constant 0 : i32
  %enabled = scalar.cmpi ne, %flag, %flag_clear : i32
  %first_bits = view.load %cells[0] : view<2xi32> -> i32
  %first = scalar.bitcast %first_bits : i32 to f32
  %update = scalar.constant 1.0 : f32
  %updated = scalar.minnumf %first, %update : f32
  %updated_bits = scalar.bitcast %updated : f32 to i32
  %passthrough_bits = scalar.constant 2143311480 : i32
  %final_bits = scf.select %enabled, %updated_bits, %first_bits : i32
  %old_bits = scf.select %enabled, %first_bits, %passthrough_bits : i32
  view.store %final_bits, %cells[0] : i32, view<2xi32>
  view.store %old_bits, %results[0] : i32, view<2xi32>
  view.store %passthrough_bits, %results[1] : i32, view<2xi32>
  func.return
}

check.scenario @float_old_and_passthrough_nan_payloads {
  check.trial[16](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %flag = check.literal value(1) : i32
    %memory = check.generate.random.uniform seed(%seed) range(-2147483648 to 2147483647) : tensor<2xi32>
    %output = check.generate.fill value(0) : tensor<2xi32>
