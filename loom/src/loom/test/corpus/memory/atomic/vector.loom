    }
  }
  check.return
}

// Reversing destinations makes an early update alias a later input lane.
// Every update must still consume the snapshot captured by the vector load.
kernel.def @atomic_input_snapshot() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%memory: buffer) {
  %base = index.constant 0 : offset
  %global = buffer.assume.memory_space<global> %memory : buffer
  %view = buffer.view %global[%base] : buffer -> view<2xi32>
  %captured = vector.load %view[0] : view<2xi32> -> vector<2xi32>
  %origin = index.constant 1 : index
  %stride = index.constant -1 : index
  %offsets = vector.iota %origin step %stride : vector<2xindex>
  vector.atomic.reduce<addi> %captured, %view[0][%offsets] {ordering = relaxed, scope = device} : vector<2xi32>, view<2xi32>, vector<2xindex>
  kernel.return
}

func.def @atomic_input_snapshot_oracle(%memory: buffer) {
  %base = index.constant 0 : offset
  %cells = buffer.view %memory[%base] : buffer -> view<2xi32>
  %first = view.load %cells[0] : view<2xi32> -> i32
  %second = view.load %cells[1] : view<2xi32> -> i32
  %sum = scalar.addi %first, %second : i32
  view.store %sum, %cells[0] : i32, view<2xi32>
  view.store %sum, %cells[1] : i32, view<2xi32>
  func.return
}

check.scenario @vector_atomic_input_snapshot {
  check.trial[16](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %memory = check.generate.random.uniform seed(%seed) range(-2147483648 to 2147483647) : tensor<2xi32>
    check.compare<@atomic_input_snapshot, @atomic_input_snapshot_oracle>(%memory) : (tensor<2xi32>) -> () {
      check.expect.bitwise actual(%memory) expected(%memory) : tensor<2xi32>
    }
  }
  check.return
}

// Both words of every old value survive reduction, exchange and CAS.
kernel.def @vector_atomic_i64() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%memory: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %global = buffer.assume.memory_space<global> %memory : buffer
  %view = buffer.view %global[%base] : buffer -> view<2xi64>
  %results = buffer.view %output[%base] : buffer -> view<4xi64>
  %origin = index.constant 0 : index
  %stride = index.constant 1 : index
  %offsets = vector.iota %origin step %stride : vector<2xindex>
  %increment = vector.splati 4294967297 : vector<2xi64>
  vector.atomic.reduce<addi> %increment, %view[0][%offsets] {ordering = relaxed, scope = device} : vector<2xi64>, view<2xi64>, vector<2xindex>
  %old = vector.atomic.rmw<xchgi> %increment, %view[0][%offsets] {ordering = relaxed, scope = device} : vector<2xi64>, view<2xi64>, vector<2xindex>
  %observed = vector.atomic.cmpxchg %increment, %old, %view[0][%offsets] {failure_ordering = relaxed, scope = device, success_ordering = relaxed} : vector<2xi64>, view<2xi64>, vector<2xindex> -> vector<2xi64>
  vector.store %old, %results[0] : vector<2xi64>, view<4xi64>
  vector.store %observed, %results[2] : vector<2xi64>, view<4xi64>
  kernel.return
}

func.def @vector_atomic_i64_oracle(%memory: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %cells = buffer.view %memory[%base] : buffer -> view<2xi64>
  %results = buffer.view %output[%base] : buffer -> view<4xi64>
  %increment = scalar.constant 4294967297 : i64
  %first = view.load %cells[0] : view<2xi64> -> i64
  %second = view.load %cells[1] : view<2xi64> -> i64
  %first_final = scalar.addi %first, %increment : i64
  %second_final = scalar.addi %second, %increment : i64
  view.store %first_final, %cells[0] : i64, view<2xi64>
  view.store %second_final, %cells[1] : i64, view<2xi64>
  view.store %first_final, %results[0] : i64, view<4xi64>
  view.store %second_final, %results[1] : i64, view<4xi64>
  view.store %increment, %results[2] : i64, view<4xi64>
  view.store %increment, %results[3] : i64, view<4xi64>
  func.return
}

check.scenario @vector_atomic_i64_high_words {
  check.trial[16](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %memory = check.generate.random.uniform seed(%seed) range(-9223372036854775808 to 9223372036854775807) : tensor<2xi64>
    %output = check.generate.fill value(0) : tensor<4xi64>
    check.compare<@vector_atomic_i64, @vector_atomic_i64_oracle>(%memory, %output) : (tensor<2xi64>, tensor<4xi64>) -> () {
      check.expect.bitwise actual(%memory) expected(%memory) : tensor<2xi64>
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi64>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %memory = check.generate.fill value(4294967295) : tensor<2xi64>
    %output = check.generate.fill value(0) : tensor<4xi64>
    check.compare<@vector_atomic_i64, @vector_atomic_i64_oracle>(%memory, %output) : (tensor<2xi64>, tensor<4xi64>) -> () {
      check.expect.bitwise actual(%memory) expected(%memory) : tensor<2xi64>
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi64>
    }
  }
  check.return
}

// Compare-exchange compares floating-point encodings, including zero signs and
// NaNs. Equal NaN payloads succeed; unequal zero signs fail.
kernel.def @vector_atomic_float_cmpxchg() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%memory: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %global = buffer.assume.memory_space<global> %memory : buffer
  %view = buffer.view %global[%base] : buffer -> view<2xf32>
  %results = buffer.view %output[%base] : buffer -> view<4xi32>
  %origin = index.constant 0 : index
  %stride = index.constant 1 : index
  %offsets = vector.iota %origin step %stride : vector<2xindex>
  %mismatch_bits = scalar.constant -2147483648 : i32
  %match_bits = scalar.constant 0 : i32
  %expected_bits = vector.from_elements %mismatch_bits, %match_bits : vector<2xi32>
  %expected = vector.bitcast %expected_bits : vector<2xi32> to vector<2xf32>
  %nan_bits = vector.splati 2143294004 : vector<2xi32>
  %nan = vector.bitcast %nan_bits : vector<2xi32> to vector<2xf32>
  %replacement = vector.splatf 1.0 : vector<2xf32>
  %old = vector.atomic.cmpxchg %expected, %nan, %view[0][%offsets] {failure_ordering = relaxed, scope = device, success_ordering = relaxed} : vector<2xf32>, view<2xf32>, vector<2xindex> -> vector<2xf32>
  %observed = vector.atomic.cmpxchg %nan, %replacement, %view[0][%offsets] {failure_ordering = relaxed, scope = device, success_ordering = relaxed} : vector<2xf32>, view<2xf32>, vector<2xindex> -> vector<2xf32>
  %old_bits = vector.bitcast %old : vector<2xf32> to vector<2xi32>
  %observed_bits = vector.bitcast %observed : vector<2xf32> to vector<2xi32>
  vector.store %old_bits, %results[0] : vector<2xi32>, view<4xi32>
  vector.store %observed_bits, %results[2] : vector<2xi32>, view<4xi32>
  kernel.return
}

func.def @vector_atomic_float_cmpxchg_oracle(%memory: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %cells = buffer.view %memory[%base] : buffer -> view<2xi32>
  %results = buffer.view %output[%base] : buffer -> view<4xi32>
  %first = view.load %cells[0] : view<2xi32> -> i32
  %second = view.load %cells[1] : view<2xi32> -> i32
  %expected_first = scalar.constant -2147483648 : i32
  %expected_second = scalar.constant 0 : i32
  %nan_bits = scalar.constant 2143294004 : i32
  %unit_bits = scalar.constant 1065353216 : i32
  %first_matches = scalar.cmpi eq, %first, %expected_first : i32
  %second_matches = scalar.cmpi eq, %second, %expected_second : i32
  %first_observed = scf.select %first_matches, %nan_bits, %first : i32
  %second_observed = scf.select %second_matches, %nan_bits, %second : i32
  %first_nan = scalar.cmpi eq, %first_observed, %nan_bits : i32
  %second_nan = scalar.cmpi eq, %second_observed, %nan_bits : i32
  %first_final = scf.select %first_nan, %unit_bits, %first_observed : i32
  %second_final = scf.select %second_nan, %unit_bits, %second_observed : i32
  view.store %first_final, %cells[0] : i32, view<2xi32>
  view.store %second_final, %cells[1] : i32, view<2xi32>
  view.store %first, %results[0] : i32, view<4xi32>
  view.store %second, %results[1] : i32, view<4xi32>
  view.store %first_observed, %results[2] : i32, view<4xi32>
  view.store %second_observed, %results[3] : i32, view<4xi32>
  func.return
}

check.scenario @vector_atomic_float_bitwise_comparison {
  check.trial[16](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %memory = check.generate.random.uniform seed(%seed) range(-2147483648 to 2147483647) : tensor<2xi32>
    %output = check.generate.fill value(-1) : tensor<4xi32>
    check.compare<@vector_atomic_float_cmpxchg, @vector_atomic_float_cmpxchg_oracle>(%memory, %output) : (tensor<2xi32>, tensor<4xi32>) -> () {
      check.expect.bitwise actual(%memory) expected(%memory) : tensor<2xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %memory = check.generate.fill value(0) : tensor<2xi32>
    %output = check.generate.fill value(-1) : tensor<4xi32>
    check.compare<@vector_atomic_float_cmpxchg, @vector_atomic_float_cmpxchg_oracle>(%memory, %output) : (tensor<2xi32>, tensor<4xi32>) -> () {
      check.expect.bitwise actual(%memory) expected(%memory) : tensor<2xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %memory = check.generate.fill value(2143294004) : tensor<2xi32>
    %output = check.generate.fill value(-1) : tensor<4xi32>
    check.compare<@vector_atomic_float_cmpxchg, @vector_atomic_float_cmpxchg_oracle>(%memory, %output) : (tensor<2xi32>, tensor<4xi32>) -> () {
      check.expect.bitwise actual(%memory) expected(%memory) : tensor<2xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi32>
    }
  }
  check.return
}

// Two updates per workitem contend on the same cell across two workgroups.
// Returned tickets form 0..255 regardless of lane or workgroup scheduling.
kernel.def @contended_vector_atomic() {
  %unit = index.constant 1 : index
  %groups = index.constant 2 : index
  %size = index.constant 64 : index
  kernel.launch.config workgroups(%groups, %unit, %unit) workgroup_size(%size, %unit, %unit) : index
} launch(%memory: buffer, %old_sum: buffer) {
  %base = index.constant 0 : offset
  %global = buffer.assume.memory_space<global> %memory : buffer
  %view = buffer.view %global[%base] : buffer -> view<1xi32>
  %sum_global = buffer.assume.memory_space<global> %old_sum : buffer
  %sum_view = buffer.view %sum_global[%base] : buffer -> view<1xi32>
  %offsets = vector.splati 0 : vector<2xi32>
  %increment = vector.splati 1 : vector<2xi32>
  %old = vector.atomic.rmw<addi> %increment, %view[0][%offsets] {ordering = relaxed, scope = device} : vector<2xi32>, view<1xi32>, vector<2xi32>
  %first = vector.extract %old[0] : vector<2xi32> -> i32
  %second = vector.extract %old[1] : vector<2xi32> -> i32
  %sum = scalar.addi %first, %second : i32
  view.atomic.reduce<addi> %sum, %sum_view[0] {ordering = relaxed, scope = device} : i32, view<1xi32>
  kernel.return
}

func.def @contended_vector_atomic_oracle(%memory: buffer, %old_sum: buffer) {
  %base = index.constant 0 : offset
  %cells = buffer.view %memory[%base] : buffer -> view<1xi32>
  %sum_cell = buffer.view %old_sum[%base] : buffer -> view<1xi32>
  %ticket_count = scalar.constant 256 : i32
  %ticket_bias = scalar.constant 32640 : i32
  %initial = view.load %cells[0] : view<1xi32> -> i32
  %initial_sum = view.load %sum_cell[0] : view<1xi32> -> i32
  %final = scalar.addi %initial, %ticket_count : i32
  %scaled = scalar.muli %initial, %ticket_count : i32
  %tickets = scalar.addi %scaled, %ticket_bias : i32
  %final_sum = scalar.addi %initial_sum, %tickets : i32
  view.store %final, %cells[0] : i32, view<1xi32>
  view.store %final_sum, %sum_cell[0] : i32, view<1xi32>
  func.return
}

check.scenario @vector_atomic_contended_tickets {
  check.trial[16](%trial: index, %entropy: check.entropy) {
    %memory_seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %sum_entropy = check.entropy.fork %entropy name("sum") : check.entropy
    %sum_seed = check.entropy.read %sum_entropy[%trial] : check.entropy -> i64
    %memory = check.generate.random.uniform seed(%memory_seed) range(-2147483648 to 2147483647) : tensor<1xi32>
    %old_sum = check.generate.random.uniform seed(%sum_seed) range(-2147483648 to 2147483647) : tensor<1xi32>
    check.compare<@contended_vector_atomic, @contended_vector_atomic_oracle>(%memory, %old_sum) : (tensor<1xi32>, tensor<1xi32>) -> () {
      check.expect.bitwise actual(%memory) expected(%memory) : tensor<1xi32>
      check.expect.bitwise actual(%old_sum) expected(%old_sum) : tensor<1xi32>
    }
  }
  check.return
}
