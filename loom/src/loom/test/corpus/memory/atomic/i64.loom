  %after = view.load %whole[10] : view<11xi64> -> i64
  view.store %before, %results[18] : i64, view<20xi64>
  view.store %after, %results[19] : i64, view<20xi64>
  kernel.return
}

// The oracle computes ordinary scalar expressions. It neither executes atomic
// operations nor shares storage with the device invocation.
func.def inline @integer_atomic_i64_cells_oracle(%initial: i64, %value: i64, %storage: buffer, %output: buffer, %output_base: offset, %storage_base: offset) {
  %whole = buffer.view %storage[%storage_base] : buffer -> view<14xi64>
  %state = view.subview %whole[1] : view<14xi64> -> view<12xi64>
  %results = buffer.view %output[%output_base] : buffer -> view<12xi64>
  %old_add = scalar.addi %initial, %value : i64
  %final_add = scalar.addi %old_add, %value : i64
  view.store %old_add, %results[0] : i64, view<12xi64>
  view.store %final_add, %state[0] : i64, view<12xi64>
  %old_sub = scalar.subi %initial, %value : i64
  %final_sub = scalar.subi %old_sub, %value : i64
  view.store %old_sub, %results[1] : i64, view<12xi64>
  view.store %final_sub, %state[1] : i64, view<12xi64>
  %signed_min = scalar.minsi %initial, %value : i64
  view.store %signed_min, %results[2] : i64, view<12xi64>
  view.store %signed_min, %state[2] : i64, view<12xi64>
  %signed_max = scalar.maxsi %initial, %value : i64
  view.store %signed_max, %results[3] : i64, view<12xi64>
  view.store %signed_max, %state[3] : i64, view<12xi64>
  %unsigned_min = scalar.minui %initial, %value : i64
  view.store %unsigned_min, %results[4] : i64, view<12xi64>
  view.store %unsigned_min, %state[4] : i64, view<12xi64>
  %unsigned_max = scalar.maxui %initial, %value : i64
  view.store %unsigned_max, %results[5] : i64, view<12xi64>
  view.store %unsigned_max, %state[5] : i64, view<12xi64>
  %bitwise_and = scalar.andi %initial, %value : i64
  view.store %bitwise_and, %results[6] : i64, view<12xi64>
  view.store %bitwise_and, %state[6] : i64, view<12xi64>
  %bitwise_or = scalar.ori %initial, %value : i64
  view.store %bitwise_or, %results[7] : i64, view<12xi64>
  view.store %bitwise_or, %state[7] : i64, view<12xi64>
  %old_xor = scalar.xori %initial, %value : i64
  view.store %old_xor, %results[8] : i64, view<12xi64>
  view.store %initial, %state[8] : i64, view<12xi64>
  view.store %initial, %results[9] : i64, view<12xi64>
  view.store %value, %state[9] : i64, view<12xi64>
  view.store %initial, %results[10] : i64, view<12xi64>
  view.store %value, %state[10] : i64, view<12xi64>
  view.store %initial, %results[11] : i64, view<12xi64>
  view.store %initial, %state[11] : i64, view<12xi64>
  func.return
}

