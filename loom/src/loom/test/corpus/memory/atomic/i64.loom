}

check.scenario @integer_atomic_i64_values {
  check.trial[16](%trial: index, %entropy: check.entropy) {
    %initial_entropy = check.entropy.fork %entropy name("global_initial") : check.entropy
    %value_entropy = check.entropy.fork %entropy name("global_value") : check.entropy
    %initial = check.entropy.read %initial_entropy[%trial] : check.entropy -> i64
    %value = check.entropy.read %value_entropy[%trial] : check.entropy -> i64
    %global = check.generate.fill value(37) : tensor<1040xi64>
    %generic = check.generate.fill value(37) : tensor<1040xi64>
    %output = check.generate.fill value(-1) : tensor<28xi64>
    check.compare<@integer_atomic_i64, @integer_atomic_i64_oracle>(%global, %generic, %output, %value, %initial) : (tensor<1040xi64>, tensor<1040xi64>, tensor<28xi64>, i64, i64) -> () {
      check.expect.bitwise actual(%global) expected(%global) : tensor<1040xi64>
      check.expect.bitwise actual(%generic) expected(%generic) : tensor<1040xi64>
      check.expect.bitwise actual(%output) expected(%output) : tensor<28xi64>
    }
  }
  // These operands force every update across a 32-bit word boundary.
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %initial = check.literal value(-4294967297) : i64
    %value = check.literal value(4294967299) : i64
    %global = check.generate.fill value(37) : tensor<1040xi64>
    %generic = check.generate.fill value(37) : tensor<1040xi64>
    %output = check.generate.fill value(-1) : tensor<28xi64>
    check.compare<@integer_atomic_i64, @integer_atomic_i64_oracle>(%global, %generic, %output, %value, %initial) : (tensor<1040xi64>, tensor<1040xi64>, tensor<28xi64>, i64, i64) -> () {
      check.expect.bitwise actual(%global) expected(%global) : tensor<1040xi64>
      check.expect.bitwise actual(%generic) expected(%generic) : tensor<1040xi64>
      check.expect.bitwise actual(%output) expected(%output) : tensor<28xi64>
    }
  }
  check.trial[16](%trial: index, %entropy: check.entropy) {
    %initial_entropy = check.entropy.fork %entropy name("workgroup_initial") : check.entropy
    %value_entropy = check.entropy.fork %entropy name("workgroup_value") : check.entropy
    %initial = check.entropy.read %initial_entropy[%trial] : check.entropy -> i64
    %value = check.entropy.read %value_entropy[%trial] : check.entropy -> i64
    %output = check.generate.fill value(-1) : tensor<20xi64>
    check.compare<@workgroup_integer_atomic_i64, @workgroup_integer_atomic_i64_oracle>(%output, %value, %initial) : (tensor<20xi64>, i64, i64) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<20xi64>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %initial = check.literal value(-4294967297) : i64
    %value = check.literal value(4294967299) : i64
    %output = check.generate.fill value(-1) : tensor<20xi64>
    check.compare<@workgroup_integer_atomic_i64, @workgroup_integer_atomic_i64_oracle>(%output, %value, %initial) : (tensor<20xi64>, i64, i64) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<20xi64>
    }
  }
  check.return
}

check.scenario @indirect_integer_atomic_i64_values {
  check.trial[16](%trial: index, %entropy: check.entropy) {
    %initial_entropy = check.entropy.fork %entropy name("initial") : check.entropy
    %value_entropy = check.entropy.fork %entropy name("value") : check.entropy
    %initial = check.entropy.read %initial_entropy[%trial] : check.entropy -> i64
    %value = check.entropy.read %value_entropy[%trial] : check.entropy -> i64
    %offsets = check.generate.fill value(16) : tensor<1xi64>
    %global = check.generate.fill value(37) : tensor<20xi64>
    %generic = check.generate.fill value(37) : tensor<20xi64>
    %output = check.generate.fill value(-1) : tensor<28xi64>
    check.compare<@indirect_integer_atomic_i64, @indirect_integer_atomic_i64_oracle>(%global, %generic, %output, %offsets, %value, %initial) : (tensor<20xi64>, tensor<20xi64>, tensor<28xi64>, tensor<1xi64>, i64, i64) -> () {
      check.expect.bitwise actual(%global) expected(%global) : tensor<20xi64>
      check.expect.bitwise actual(%generic) expected(%generic) : tensor<20xi64>
      check.expect.bitwise actual(%output) expected(%output) : tensor<28xi64>
    }
  }
  check.return
}

// Four workgroups allocate unique descending tickets across a low-word borrow.
// Only 17 lanes in each workgroup participate; the remaining lanes leave both
// the counters and high-word bit sets untouched.
kernel.def @contended_atomic_i64() {
  %unit = index.constant 1 : index
  %groups = index.constant 4 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%groups, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%global_storage: buffer, %generic_storage: buffer, %global_output: buffer, %generic_output: buffer, %initial: i64, %decrement: i64) {
  %lane = kernel.workitem.id<x> : index
  %active_count = index.constant 17 : index
  %active = index.cmp ult, %lane, %active_count : index
  %base = index.constant 8 : offset
  %global = buffer.assume.memory_space<global> %global_storage : buffer
  %generic = buffer.assume.memory_space<generic> %generic_storage : buffer
  %global_cells = buffer.view %global[%base] : buffer -> view<2xi64>
  %generic_cells = buffer.view %generic[%base] : buffer -> view<2xi64>
  %global_slots = buffer.view %global_output[%base] : buffer -> view<68xi64>
  %generic_slots = buffer.view %generic_output[%base] : buffer -> view<68xi64>
  scf.if %active {
    %lane_wide = index.cast %lane : index to i64
    %high_word = scalar.constant 32 : i64
    %bit = scalar.addi %lane_wide, %high_word : i64
    %unit_wide = scalar.constant 1 : i64
    %contribution = scalar.shli %unit_wide, %bit : i64
    view.atomic.reduce<ori> %contribution, %global_cells[1] {ordering = relaxed, scope = device} : i64, view<2xi64>
    view.atomic.reduce<ori> %contribution, %generic_cells[1] {ordering = relaxed, scope = device} : i64, view<2xi64>
    %global_old = view.atomic.rmw<subi> %decrement, %global_cells[0] {ordering = relaxed, scope = device} : i64, view<2xi64> -> i64
    %generic_old = view.atomic.rmw<subi> %decrement, %generic_cells[0] {ordering = relaxed, scope = device} : i64, view<2xi64> -> i64
    %global_distance = scalar.subi %initial, %global_old : i64
    %generic_distance = scalar.subi %initial, %generic_old : i64
    // The initialized counters assign exactly 68 unique in-range tickets.
    %global_bounded = scalar.assume %global_distance [range(%global_distance, 0, 67)] : i64
    %generic_bounded = scalar.assume %generic_distance [range(%generic_distance, 0, 67)] : i64
    %global_slot = index.cast %global_bounded : i64 to index
    %generic_slot = index.cast %generic_bounded : i64 to index
    view.store %global_old, %global_slots[%global_slot] : i64, view<68xi64>
    view.store %generic_old, %generic_slots[%generic_slot] : i64, view<68xi64>
  }
  kernel.return
}

func.def @contended_atomic_i64_oracle(%global_storage: buffer, %generic_storage: buffer, %global_output: buffer, %generic_output: buffer, %initial: i64, %decrement: i64) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 68 : index
  %step = index.constant 1 : index
  %count = scalar.constant 68 : i64
  %active_mask = scalar.constant 131071 : i64
  %high_word = scalar.constant 32 : i64
  %global = buffer.view %global_storage[%base] : buffer -> view<4xi64>
  %generic = buffer.view %generic_storage[%base] : buffer -> view<4xi64>
  %global_slots = buffer.view %global_output[%base] : buffer -> view<70xi64>
  %generic_slots = buffer.view %generic_output[%base] : buffer -> view<70xi64>
  %total_decrement = scalar.muli %decrement, %count : i64
  %final_counter = scalar.subi %initial, %total_decrement : i64
  %shifted_mask = scalar.shli %active_mask, %high_word : i64
  %final_bits = scalar.ori %initial, %shifted_mask : i64
  view.store %final_counter, %global[1] : i64, view<4xi64>
  view.store %final_bits, %global[2] : i64, view<4xi64>
  view.store %final_counter, %generic[1] : i64, view<4xi64>
  view.store %final_bits, %generic[2] : i64, view<4xi64>
  scf.for %position = [%begin to %end step %step] {
    %distance = index.cast %position : index to i64
    %scaled_distance = scalar.muli %distance, %decrement : i64
    %ticket = scalar.subi %initial, %scaled_distance : i64
    %slot = index.add %position, %step : index
    view.store %ticket, %global_slots[%slot] : i64, view<70xi64>
    view.store %ticket, %generic_slots[%slot] : i64, view<70xi64>
  }
  func.return
}

check.scenario @contended_atomic_i64_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %initial = check.literal value(4294967330) : i64
    %decrement = check.literal value(1) : i64
    %global = check.generate.fill value(4294967330) : tensor<4xi64>
    %generic = check.generate.fill value(4294967330) : tensor<4xi64>
    %global_output = check.generate.fill value(-1) : tensor<70xi64>
    %generic_output = check.generate.fill value(-1) : tensor<70xi64>
    check.compare<@contended_atomic_i64, @contended_atomic_i64_oracle>(%global, %generic, %global_output, %generic_output, %initial, %decrement) : (tensor<4xi64>, tensor<4xi64>, tensor<70xi64>, tensor<70xi64>, i64, i64) -> () {
      check.expect.bitwise actual(%global) expected(%global) : tensor<4xi64>
      check.expect.bitwise actual(%generic) expected(%generic) : tensor<4xi64>
      check.expect.bitwise actual(%global_output) expected(%global_output) : tensor<70xi64>
      check.expect.bitwise actual(%generic_output) expected(%generic_output) : tensor<70xi64>
    }
  }
  check.return
}

// Sixty-five lanes span wave32 and wave64 boundaries. Each workgroup owns
// an independent counter; both cross a low-word borrow under contention.
kernel.def @contended_workgroup_atomic_i64() {
  %unit = index.constant 1 : index
  %groups = index.constant 2 : index
  %width = index.constant 128 : index
  kernel.launch.config workgroups(%groups, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%output: buffer, %summary: buffer, %initial: i64) {
  %lane = kernel.workitem.id<x> : index
  %group = kernel.workgroup.id<x> : index
  %origin = index.constant 0 : index
  %base = index.constant 0 : offset
  %bytes = index.constant 32 : offset
  %storage = buffer.alloca<workgroup> align(8) %bytes : buffer
  %cells = buffer.view %storage[%base] : buffer -> view<4xi64>
  %tickets = buffer.view %output[%base] : buffer -> view<2x65xi64>
  %summaries = buffer.view %summary[%base] : buffer -> view<2x4xi64>
  %leader = index.cmp eq, %lane, %origin : index
  %empty = scalar.constant 0 : i64
  scf.if %leader {
    view.store %initial, %cells[0] : i64, view<4xi64>
    view.store %initial, %cells[1] : i64, view<4xi64>
    view.store %empty, %cells[2] : i64, view<4xi64>
    view.store %initial, %cells[3] : i64, view<4xi64>
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %active_count = index.constant 65 : index
  %active = index.cmp ult, %lane, %active_count : index
  scf.if %active {
    %lane_wide = index.cast %lane : index to i64
    %low_bits = scalar.constant 31 : i64
    %bit_index = scalar.andi %lane_wide, %low_bits : i64
    %high_word = scalar.constant 32 : i64
    %bit = scalar.addi %bit_index, %high_word : i64
    %increment = scalar.constant 1 : i64
    %contribution = scalar.shli %increment, %bit : i64
    view.atomic.reduce<ori> %contribution, %cells[2] {ordering = relaxed, scope = workgroup} : i64, view<4xi64>
    %old = view.atomic.rmw<subi> %increment, %cells[1] {ordering = relaxed, scope = workgroup} : i64, view<4xi64> -> i64
    %distance = scalar.subi %initial, %old : i64
    %bounded = scalar.assume %distance [range(%distance, 0, 64)] : i64
    %slot = index.cast %bounded : i64 to index
    view.store %old, %tickets[%group, %slot] : i64, view<2x65xi64>
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  scf.if %leader {
    %before = view.load %cells[0] : view<4xi64> -> i64
    %counter = view.load %cells[1] : view<4xi64> -> i64
    %bits = view.load %cells[2] : view<4xi64> -> i64
    %after = view.load %cells[3] : view<4xi64> -> i64
    view.store %before, %summaries[%group, 0] : i64, view<2x4xi64>
    view.store %counter, %summaries[%group, 1] : i64, view<2x4xi64>
    view.store %bits, %summaries[%group, 2] : i64, view<2x4xi64>
    view.store %after, %summaries[%group, 3] : i64, view<2x4xi64>
  }
  kernel.return
}

func.def @contended_workgroup_atomic_i64_oracle(%output: buffer, %summary: buffer, %initial: i64) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %group_end = index.constant 2 : index
  %ticket_end = index.constant 65 : index
  %step = index.constant 1 : index
  %count = scalar.constant 65 : i64
  %all_bits = scalar.constant -1 : i64
  %high_word = scalar.constant 32 : i64
  %final_counter = scalar.subi %initial, %count : i64
  %final_bits = scalar.shli %all_bits, %high_word : i64
  %tickets = buffer.view %output[%base] : buffer -> view<2x65xi64>
  %summaries = buffer.view %summary[%base] : buffer -> view<2x4xi64>
  scf.for %position = [%begin to %ticket_end step %step] {
    %distance = index.cast %position : index to i64
    %ticket = scalar.subi %initial, %distance : i64
    view.store %ticket, %tickets[0, %position] : i64, view<2x65xi64>
    view.store %ticket, %tickets[1, %position] : i64, view<2x65xi64>
  }
  scf.for %group = [%begin to %group_end step %step] {
    view.store %initial, %summaries[%group, 0] : i64, view<2x4xi64>
    view.store %final_counter, %summaries[%group, 1] : i64, view<2x4xi64>
    view.store %final_bits, %summaries[%group, 2] : i64, view<2x4xi64>
    view.store %initial, %summaries[%group, 3] : i64, view<2x4xi64>
  }
  func.return
}

check.scenario @contended_workgroup_atomic_i64_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %initial = check.literal value(4294967330) : i64
    %output = check.generate.fill value(-1) : tensor<2x65xi64>
    %summary = check.generate.fill value(-1) : tensor<8xi64>
    check.compare<@contended_workgroup_atomic_i64, @contended_workgroup_atomic_i64_oracle>(%output, %summary, %initial) : (tensor<2x65xi64>, tensor<8xi64>, i64) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<2x65xi64>
      check.expect.bitwise actual(%summary) expected(%summary) : tensor<8xi64>
    }
  }
  check.return
}
