  view.store %unsigned_max, %results[14] : i64, view<20xi64>
  %bitwise_and = scalar.andi %initial, %value : i64
  view.store %bitwise_and, %results[6] : i64, view<20xi64>
  view.store %bitwise_and, %results[15] : i64, view<20xi64>
  %bitwise_or = scalar.ori %initial, %value : i64
  view.store %bitwise_or, %results[7] : i64, view<20xi64>
  view.store %bitwise_or, %results[16] : i64, view<20xi64>
  %old_xor = scalar.xori %initial, %value : i64
  view.store %old_xor, %results[8] : i64, view<20xi64>
  view.store %initial, %results[17] : i64, view<20xi64>
  view.store %initial, %results[18] : i64, view<20xi64>
  view.store %initial, %results[19] : i64, view<20xi64>
