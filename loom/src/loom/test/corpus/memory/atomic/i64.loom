func.def @workgroup_integer_atomic_i64_oracle(%output: buffer, %value: i64, %initial: i64) {
  %base = index.constant 0 : offset
  %results = buffer.view %output[%base] : buffer -> view<20xi64>
  %old_add = scalar.addi %initial, %value : i64
