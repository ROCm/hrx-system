// Each cell isolates one integer atomic operation. Reductions run before their
// returning forms so both packet shapes contribute to the observed result.
func.def inline @integer_atomic_i64_cells(%initial: i64, %value: i64, %storage: buffer, %output: buffer, %output_base: offset, %storage_base: offset) {
  %begin = index.constant 0 : index
  %end = index.constant 12 : index
  %step = index.constant 1 : index
  %inversion_mask = scalar.constant -1 : i64
  %whole = buffer.view %storage[%storage_base] : buffer -> view<14xi64>
  %state = view.subview %whole[1] : view<14xi64> -> view<12xi64>
  %results = buffer.view %output[%output_base] : buffer -> view<12xi64>
  scf.for %cell = [%begin to %end step %step] {
    view.store %initial, %state[%cell] : i64, view<12xi64>
  }
  view.atomic.reduce<addi> %value, %state[0] {ordering = relaxed, scope = device} : i64, view<12xi64>
  %old_add = view.atomic.rmw<addi> %value, %state[0] {ordering = relaxed, scope = device} : i64, view<12xi64> -> i64
  view.store %old_add, %results[0] : i64, view<12xi64>
  view.atomic.reduce<subi> %value, %state[1] {ordering = relaxed, scope = device} : i64, view<12xi64>
  %old_sub = view.atomic.rmw<subi> %value, %state[1] {ordering = relaxed, scope = device} : i64, view<12xi64> -> i64
  view.store %old_sub, %results[1] : i64, view<12xi64>
  view.atomic.reduce<minsi> %value, %state[2] {ordering = relaxed, scope = device} : i64, view<12xi64>
  %old_signed_min = view.atomic.rmw<minsi> %value, %state[2] {ordering = relaxed, scope = device} : i64, view<12xi64> -> i64
  view.store %old_signed_min, %results[2] : i64, view<12xi64>
  view.atomic.reduce<maxsi> %value, %state[3] {ordering = relaxed, scope = device} : i64, view<12xi64>
  %old_signed_max = view.atomic.rmw<maxsi> %value, %state[3] {ordering = relaxed, scope = device} : i64, view<12xi64> -> i64
  view.store %old_signed_max, %results[3] : i64, view<12xi64>
  view.atomic.reduce<minui> %value, %state[4] {ordering = relaxed, scope = device} : i64, view<12xi64>
  %old_unsigned_min = view.atomic.rmw<minui> %value, %state[4] {ordering = relaxed, scope = device} : i64, view<12xi64> -> i64
  view.store %old_unsigned_min, %results[4] : i64, view<12xi64>
  view.atomic.reduce<maxui> %value, %state[5] {ordering = relaxed, scope = device} : i64, view<12xi64>
  %old_unsigned_max = view.atomic.rmw<maxui> %value, %state[5] {ordering = relaxed, scope = device} : i64, view<12xi64> -> i64
  view.store %old_unsigned_max, %results[5] : i64, view<12xi64>
  view.atomic.reduce<andi> %value, %state[6] {ordering = relaxed, scope = device} : i64, view<12xi64>
  %old_and = view.atomic.rmw<andi> %value, %state[6] {ordering = relaxed, scope = device} : i64, view<12xi64> -> i64
  view.store %old_and, %results[6] : i64, view<12xi64>
  view.atomic.reduce<ori> %value, %state[7] {ordering = relaxed, scope = device} : i64, view<12xi64>
  %old_or = view.atomic.rmw<ori> %value, %state[7] {ordering = relaxed, scope = device} : i64, view<12xi64> -> i64
  view.store %old_or, %results[7] : i64, view<12xi64>
  view.atomic.reduce<xori> %value, %state[8] {ordering = relaxed, scope = device} : i64, view<12xi64>
  %old_xor = view.atomic.rmw<xori> %value, %state[8] {ordering = relaxed, scope = device} : i64, view<12xi64> -> i64
  view.store %old_xor, %results[8] : i64, view<12xi64>
  %old_exchange = view.atomic.rmw<xchgi> %value, %state[9] {ordering = relaxed, scope = device} : i64, view<12xi64> -> i64
  view.store %old_exchange, %results[9] : i64, view<12xi64>
  %old_success = view.atomic.cmpxchg %initial, %value, %state[10] {failure_ordering = relaxed, scope = device, success_ordering = relaxed} : i64, view<12xi64> -> i64
  view.store %old_success, %results[10] : i64, view<12xi64>
  %wrong = scalar.xori %initial, %inversion_mask : i64
  %old_failure = view.atomic.cmpxchg %wrong, %value, %state[11] {failure_ordering = relaxed, scope = device, success_ordering = relaxed} : i64, view<12xi64> -> i64
  view.store %old_failure, %results[11] : i64, view<12xi64>
  func.return
}

// Global and generic paths retain the base and subview address chain. The
// 8 KiB origin also requires splitting the address on narrower-immediate ISAs.
kernel.def @integer_atomic_i64() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%global_storage: buffer, %generic_storage: buffer, %output: buffer, %value: i64, %initial: i64) {
  %storage_base = index.constant 8192 : offset
  %global_output_base = index.constant 16 : offset
  %generic_output_base = index.constant 112 : offset
  %global = buffer.assume.memory_space<global> %global_storage : buffer
  %generic = buffer.assume.memory_space<generic> %generic_storage : buffer
  func.call @integer_atomic_i64_cells(%initial, %value, %global, %output, %global_output_base, %storage_base) : (i64, i64, buffer, buffer, offset, offset)
  func.call @integer_atomic_i64_cells(%initial, %value, %generic, %output, %generic_output_base, %storage_base) : (i64, i64, buffer, buffer, offset, offset)
  kernel.return
}

// The loaded byte origin remains a full-width runtime value through inlining,
// subview formation, reductions, returning updates, and both CAS outcomes.
kernel.def @indirect_integer_atomic_i64() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%global_storage: buffer, %generic_storage: buffer, %output: buffer, %offsets: buffer, %value: i64, %initial: i64) {
  %c0 = index.constant 0 : offset
  %global_output_base = index.constant 16 : offset
  %generic_output_base = index.constant 112 : offset
  %indices = buffer.view %offsets[%c0] : buffer -> view<1xi64>
  %byte_offset = view.load %indices[0] : view<1xi64> -> i64
  %nonnegative = scalar.assume %byte_offset [range(%byte_offset, 0, 9223372036854775807)] : i64
  %storage_base = index.cast %nonnegative : i64 to offset
  %global = buffer.assume.memory_space<global> %global_storage : buffer
  %generic = buffer.assume.memory_space<generic> %generic_storage : buffer
  func.call @integer_atomic_i64_cells(%initial, %value, %global, %output, %global_output_base, %storage_base) : (i64, i64, buffer, buffer, offset, offset)
  func.call @integer_atomic_i64_cells(%initial, %value, %generic, %output, %generic_output_base, %storage_base) : (i64, i64, buffer, buffer, offset, offset)
  kernel.return
}

// LDS reductions and returning updates preserve both words, signed ordering,
// and neighboring cells. Each operation starts from the same source value.
kernel.def @workgroup_integer_atomic_i64() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%output: buffer, %value: i64, %initial: i64) {
  %base = index.constant 0 : offset
  %bytes = index.constant 88 : offset
  %storage = buffer.alloca<workgroup> align(8) %bytes : buffer
  %whole = buffer.view %storage[%base] : buffer -> view<11xi64>
  %cells = view.subview %whole[1] : view<11xi64> -> view<9xi64>
  %results = buffer.view %output[%base] : buffer -> view<20xi64>
  view.store %initial, %whole[0] : i64, view<11xi64>
  view.store %initial, %whole[10] : i64, view<11xi64>
  view.store %initial, %cells[0] : i64, view<9xi64>
  view.atomic.reduce<addi> %value, %cells[0] {ordering = relaxed, scope = workgroup} : i64, view<9xi64>
  %addi_old = view.atomic.rmw<addi> %value, %cells[0] {ordering = relaxed, scope = workgroup} : i64, view<9xi64> -> i64
  %addi_final = view.load %cells[0] : view<9xi64> -> i64
  view.store %addi_old, %results[0] : i64, view<20xi64>
  view.store %addi_final, %results[9] : i64, view<20xi64>
  view.store %initial, %cells[1] : i64, view<9xi64>
  view.atomic.reduce<subi> %value, %cells[1] {ordering = relaxed, scope = workgroup} : i64, view<9xi64>
  %subi_old = view.atomic.rmw<subi> %value, %cells[1] {ordering = relaxed, scope = workgroup} : i64, view<9xi64> -> i64
  %subi_final = view.load %cells[1] : view<9xi64> -> i64
  view.store %subi_old, %results[1] : i64, view<20xi64>
  view.store %subi_final, %results[10] : i64, view<20xi64>
  view.store %initial, %cells[2] : i64, view<9xi64>
  view.atomic.reduce<minsi> %value, %cells[2] {ordering = relaxed, scope = workgroup} : i64, view<9xi64>
  %minsi_old = view.atomic.rmw<minsi> %value, %cells[2] {ordering = relaxed, scope = workgroup} : i64, view<9xi64> -> i64
  %minsi_final = view.load %cells[2] : view<9xi64> -> i64
  view.store %minsi_old, %results[2] : i64, view<20xi64>
  view.store %minsi_final, %results[11] : i64, view<20xi64>
  view.store %initial, %cells[3] : i64, view<9xi64>
  view.atomic.reduce<maxsi> %value, %cells[3] {ordering = relaxed, scope = workgroup} : i64, view<9xi64>
  %maxsi_old = view.atomic.rmw<maxsi> %value, %cells[3] {ordering = relaxed, scope = workgroup} : i64, view<9xi64> -> i64
  %maxsi_final = view.load %cells[3] : view<9xi64> -> i64
  view.store %maxsi_old, %results[3] : i64, view<20xi64>
  view.store %maxsi_final, %results[12] : i64, view<20xi64>
  view.store %initial, %cells[4] : i64, view<9xi64>
  view.atomic.reduce<minui> %value, %cells[4] {ordering = relaxed, scope = workgroup} : i64, view<9xi64>
  %minui_old = view.atomic.rmw<minui> %value, %cells[4] {ordering = relaxed, scope = workgroup} : i64, view<9xi64> -> i64
  %minui_final = view.load %cells[4] : view<9xi64> -> i64
  view.store %minui_old, %results[4] : i64, view<20xi64>
  view.store %minui_final, %results[13] : i64, view<20xi64>
  view.store %initial, %cells[5] : i64, view<9xi64>
  view.atomic.reduce<maxui> %value, %cells[5] {ordering = relaxed, scope = workgroup} : i64, view<9xi64>
  %maxui_old = view.atomic.rmw<maxui> %value, %cells[5] {ordering = relaxed, scope = workgroup} : i64, view<9xi64> -> i64
  %maxui_final = view.load %cells[5] : view<9xi64> -> i64
  view.store %maxui_old, %results[5] : i64, view<20xi64>
  view.store %maxui_final, %results[14] : i64, view<20xi64>
  view.store %initial, %cells[6] : i64, view<9xi64>
  view.atomic.reduce<andi> %value, %cells[6] {ordering = relaxed, scope = workgroup} : i64, view<9xi64>
  %andi_old = view.atomic.rmw<andi> %value, %cells[6] {ordering = relaxed, scope = workgroup} : i64, view<9xi64> -> i64
  %andi_final = view.load %cells[6] : view<9xi64> -> i64
  view.store %andi_old, %results[6] : i64, view<20xi64>
  view.store %andi_final, %results[15] : i64, view<20xi64>
  view.store %initial, %cells[7] : i64, view<9xi64>
  view.atomic.reduce<ori> %value, %cells[7] {ordering = relaxed, scope = workgroup} : i64, view<9xi64>
  %ori_old = view.atomic.rmw<ori> %value, %cells[7] {ordering = relaxed, scope = workgroup} : i64, view<9xi64> -> i64
  %ori_final = view.load %cells[7] : view<9xi64> -> i64
  view.store %ori_old, %results[7] : i64, view<20xi64>
  view.store %ori_final, %results[16] : i64, view<20xi64>
  view.store %initial, %cells[8] : i64, view<9xi64>
  view.atomic.reduce<xori> %value, %cells[8] {ordering = relaxed, scope = workgroup} : i64, view<9xi64>
  %xori_old = view.atomic.rmw<xori> %value, %cells[8] {ordering = relaxed, scope = workgroup} : i64, view<9xi64> -> i64
