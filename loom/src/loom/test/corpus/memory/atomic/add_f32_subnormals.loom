// Input and output subnormals must survive the arithmetic path. Returned old
// values remain bit-exact independently of the addition result.
kernel.def @global_atomic_add_f32_subnormal() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input_increment_bits: i32, %result_increment_bits: i32, %accumulator: buffer, %old_value: buffer) {
  %base = index.constant 0 : offset
  %global = buffer.assume.memory_space<global> %accumulator : buffer
  %view = buffer.view %global[%base] : buffer -> view<2xf32>
  %old_global = buffer.assume.memory_space<global> %old_value : buffer
  %old_view = buffer.view %old_global[%base] : buffer -> view<1xi32>
  %input_increment = scalar.bitcast %input_increment_bits : i32 to f32
  %result_increment = scalar.bitcast %result_increment_bits : i32 to f32
  %old = view.atomic.rmw<addf, noftz> %input_increment, %view[0] {ordering = relaxed, scope = device} : f32, view<2xf32> -> f32
  view.atomic.reduce<addf, noftz> %result_increment, %view[1] {ordering = relaxed, scope = device} : f32, view<2xf32>
  %old_bits = scalar.bitcast %old : f32 to i32
  view.store %old_bits, %old_view[0] : i32, view<1xi32>
  kernel.return
}

// The oracle performs the two additions as ordinary scalar operations. This
// keeps the arithmetic semantics independent from the atomic lowering.
func.def @global_atomic_add_f32_subnormal_oracle(%input_increment_bits: i32, %result_increment_bits: i32, %accumulator: buffer, %old_value: buffer) {
  %base = index.constant 0 : offset
  %view = buffer.view %accumulator[%base] : buffer -> view<2xf32>
  %old_view = buffer.view %old_value[%base] : buffer -> view<1xi32>
  %input_increment = scalar.bitcast %input_increment_bits : i32 to f32
  %result_increment = scalar.bitcast %result_increment_bits : i32 to f32
  %first = view.load %view[0] : view<2xf32> -> f32
  %second = view.load %view[1] : view<2xf32> -> f32
  %first_sum = scalar.addf %first, %input_increment : f32
  %second_sum = scalar.addf %second, %result_increment : f32
  view.store %first_sum, %view[0] : f32, view<2xf32>
  view.store %second_sum, %view[1] : f32, view<2xf32>
  %old_bits = scalar.bitcast %first : f32 to i32
  view.store %old_bits, %old_view[0] : i32, view<1xi32>
  func.return
}

// Workgroup aliases share an integer carrier when explicit preservation selects
// a CAS loop. Masked lanes retain their old value without issuing an update.
kernel.def @workgroup_atomic_add_f32_subnormal() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%initial_bits: i32, %increment_bits: i32, %flag: index, %output: buffer) {
  %base = index.constant 0 : offset
  %bytes = index.constant 8 : offset
  %scratch = buffer.alloca<workgroup> align(4) %bytes : buffer
  %view = buffer.view %scratch[%base] : buffer -> view<2xf32>
  %alias = buffer.view %scratch[%base] : buffer -> view<2xf32>
  %results = buffer.view %output[%base] : buffer -> view<4xf32>
  %initial = scalar.bitcast %initial_bits : i32 to f32
  %increment = scalar.bitcast %increment_bits : i32 to f32
  %initials = vector.from_elements %initial, %initial : vector<2xf32>
  %increments = vector.from_elements %increment, %increment : vector<2xf32>
  vector.store %initials, %view[0] : vector<2xf32>, view<2xf32>
  %origin = index.constant 0 : index
  %stride = index.constant 1 : index
  %offsets = vector.iota %origin step %stride : vector<2xindex>
  %c0 = index.constant 0 : index
  %enabled = index.cmp ne, %flag, %c0 : index
  %disabled = scalar.constant false : i1
  %mask = vector.from_elements %enabled, %disabled : vector<2xi1>
  vector.atomic.reduce<addf, noftz> %increments, %view[0][%offsets] {ordering = relaxed, scope = workgroup} : vector<2xf32>, view<2xf32>, vector<2xindex>
  %old = vector.atomic.rmw.mask<addf, noftz> %increments, %alias[0][%offsets], %mask, %initials {ordering = relaxed, scope = workgroup} : vector<2xf32>, view<2xf32>, vector<2xindex>, vector<2xi1>, vector<2xf32>
  %final = vector.load %view[0] : view<2xf32> -> vector<2xf32>
  vector.store %old, %results[0] : vector<2xf32>, view<4xf32>
  vector.store %final, %results[2] : vector<2xf32>, view<4xf32>
  kernel.return
}

// The oracle spells the active and passthrough paths with scalar arithmetic.
func.def @workgroup_atomic_add_f32_subnormal_oracle(%initial_bits: i32, %increment_bits: i32, %flag: index, %output: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %results = buffer.view %output[%base] : buffer -> view<4xi32>
  %initial = scalar.bitcast %initial_bits : i32 to f32
  %increment = scalar.bitcast %increment_bits : i32 to f32
  %once = scalar.addf %initial, %increment : f32
  %twice = scalar.addf %once, %increment : f32
  %enabled = index.cmp ne, %flag, %c0 : index
  %first_old = scf.select %enabled, %once, %initial : f32
  %first_final = scf.select %enabled, %twice, %once : f32
  %first_old_bits = scalar.bitcast %first_old : f32 to i32
  %first_final_bits = scalar.bitcast %first_final : f32 to i32
  %once_bits = scalar.bitcast %once : f32 to i32
  view.store %first_old_bits, %results[0] : i32, view<4xi32>
  view.store %initial_bits, %results[1] : i32, view<4xi32>
  view.store %first_final_bits, %results[2] : i32, view<4xi32>
  view.store %once_bits, %results[3] : i32, view<4xi32>
  func.return
}

check.scenario @atomic_add_f32_subnormal_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    // The first lane proves subnormal inputs survive; the second starts from a
    // normal value and produces a subnormal result. Neither floating result
    // matches integer addition of the payload bits.
    %accumulator = check.generate.iota offset(2) step(8388606) : tensor<2xi32>
    %old_value = check.generate.fill value(0) : tensor<1xi32>
    %input_increment = check.literal value(-2147483647) : i32
    %result_increment = check.literal value(-2139095039) : i32
    check.compare<@global_atomic_add_f32_subnormal, @global_atomic_add_f32_subnormal_oracle>(%input_increment, %result_increment, %accumulator, %old_value) : (i32, i32, tensor<2xi32>, tensor<1xi32>) -> () {
      check.expect.bitwise actual(%accumulator) expected(%accumulator) : tensor<2xi32>
      check.expect.bitwise actual(%old_value) expected(%old_value) : tensor<1xi32>
    }
  }
  check.trial[2](%trial: index, %entropy: check.entropy) {
    %initial = check.literal value(2) : i32
    %increment = check.literal value(-2147483647) : i32
    %output = check.generate.fill value(0) : tensor<4xi32>
    check.compare<@workgroup_atomic_add_f32_subnormal, @workgroup_atomic_add_f32_subnormal_oracle>(%initial, %increment, %trial, %output) : (i32, i32, index, tensor<4xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi32>
    }
  }
  check.return
}
