// Advisory CU cache hints cannot narrow the authored atomic coherence scope.
// Misaligned and reversed half pairs consume the original loaded snapshot.
// Duplicate destinations serialize independently of vector lane order.
kernel.def @half_snapshot_and_duplicates() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%memory: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %interior = index.constant 2 : offset
  %global = buffer.assume.memory_space<global> %memory : buffer
  %cells = buffer.view %global[%interior] : buffer -> view<2xf16>
  %results = buffer.view %output[%origin] : buffer -> view<2xf16>
  %captured = vector.load %cells[0] : view<2xf16> -> vector<2xf16>
  %first = index.constant 0 : index
  %last = index.constant 1 : index
  %reverse = vector.from_elements %last, %first : vector<2xindex>
  vector.atomic.reduce<addf, noftz> %captured, %cells[0][%reverse] {cache_scope = workgroup, cache_temporal = non_temporal, ordering = release, scope = device} : vector<2xf16>, view<2xf16>, vector<2xindex>
  %duplicate = vector.from_elements %first, %first : vector<2xindex>
  %increment = vector.splatf 1.0 : vector<2xf16>
  %old = vector.atomic.rmw<addf, noftz> %increment, %cells[0][%duplicate] {cache_scope = workgroup, cache_temporal = non_temporal, ordering = acq_rel, scope = device} : vector<2xf16>, view<2xf16>, vector<2xindex>
  %left = vector.extract %old[0] : vector<2xf16> -> f16
  %right = vector.extract %old[1] : vector<2xf16> -> f16
  %lower = scalar.minnumf %left, %right : f16
  %upper = scalar.maxnumf %left, %right : f16
  view.store %lower, %results[0] : f16, view<2xf16>
  view.store %upper, %results[1] : f16, view<2xf16>
  kernel.return
}

func.def @half_snapshot_and_duplicates_oracle(%memory: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %cells = buffer.view %memory[%origin] : buffer -> view<4xf16>
  %results = buffer.view %output[%origin] : buffer -> view<2xf16>
  %left = view.load %cells[1] : view<4xf16> -> f16
  %right = view.load %cells[2] : view<4xf16> -> f16
  %sum = scalar.addf %left, %right : f16
  %increment = scalar.constant 1.0 : f16
  %successor = scalar.addf %sum, %increment : f16
  %final = scalar.addf %successor, %increment : f16
  %lower = scalar.minnumf %sum, %successor : f16
  %upper = scalar.maxnumf %sum, %successor : f16
  view.store %final, %cells[1] : f16, view<4xf16>
  view.store %sum, %cells[2] : f16, view<4xf16>
  view.store %lower, %results[0] : f16, view<2xf16>
  view.store %upper, %results[1] : f16, view<2xf16>
  func.return
}

check.scenario @half_snapshot_and_duplicate_old_values {
  check.trial[16](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %memory = check.generate.random.uniform seed(%seed) range(-16.0 to 16.0) : tensor<4xf16>
    %output = check.generate.fill value(0.0) : tensor<2xf16>
    check.compare<@half_snapshot_and_duplicates, @half_snapshot_and_duplicates_oracle>(%memory, %output) : (tensor<4xf16>, tensor<2xf16>) -> () {
      check.expect.bitwise actual(%memory) expected(%memory) : tensor<4xf16>
      check.expect.bitwise actual(%output) expected(%output) : tensor<2xf16>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %memory = check.generate.iota offset(2.0) step(1.0) : tensor<4xf16>
    %output = check.generate.fill value(0.0) : tensor<2xf16>
    check.compare<@half_snapshot_and_duplicates, @half_snapshot_and_duplicates_oracle>(%memory, %output) : (tensor<4xf16>, tensor<2xf16>) -> () {
      check.expect.bitwise actual(%memory) expected(%memory) : tensor<4xf16>
      check.expect.bitwise actual(%output) expected(%output) : tensor<2xf16>
    }
  }
  check.return
}

// Inactive lanes preserve NaN payloads and never access their invalid offsets.
// The odd vector update is followed by bitwise CAS on the same adjacent cells.
kernel.def @masked_brain_payloads() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%flag: i32, %output: buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %scratch = buffer.alloca<workgroup> align(4) %bytes : buffer
  %cells = buffer.view %scratch[%origin] : buffer -> view<2xbf16>
  %results = buffer.view %output[%origin] : buffer -> view<9xi16>
  %nan_bits = vector.splati 32641 : vector<2xi16>
  %nan = vector.bitcast %nan_bits : vector<2xi16> to vector<2xbf16>
  vector.store %nan, %cells[0] : vector<2xbf16>, view<2xbf16>
  %flag_clear = scalar.constant 0 : i32
  %enabled = scalar.cmpi ne, %flag, %flag_clear : i32
  %disabled = scalar.constant false : i1
  %mask = vector.from_elements %enabled, %disabled, %disabled : vector<3xi1>
  %first = index.constant 0 : index
  %outside = index.constant -100 : index
  %last = index.constant 1 : index
  %offsets = vector.from_elements %first, %outside, %last : vector<3xindex>
  %subnormal_bits = vector.splati 1 : vector<3xi16>
  %subnormal = vector.bitcast %subnormal_bits : vector<3xi16> to vector<3xbf16>
  %passthrough_bits = vector.splati 32709 : vector<3xi16>
  %passthrough = vector.bitcast %passthrough_bits : vector<3xi16> to vector<3xbf16>
  %old = vector.atomic.rmw.mask<xchgf> %subnormal, %cells[0][%offsets], %mask, %passthrough {cache_scope = workgroup, cache_temporal = non_temporal, ordering = acq_rel, scope = workgroup} : vector<3xbf16>, view<2xbf16>, vector<3xindex>, vector<3xi1>, vector<3xbf16>
  vector.atomic.reduce.mask<addf, noftz> %subnormal, %cells[0][%offsets], %mask {cache_scope = workgroup, cache_temporal = non_temporal, ordering = release, scope = workgroup} : vector<3xbf16>, view<2xbf16>, vector<3xindex>, vector<3xi1>
  %old_bits = vector.bitcast %old : vector<3xbf16> to vector<3xi16>
  vector.store %old_bits, %results[0] : vector<3xi16>, view<9xi16>
  %pair_offsets = vector.from_elements %first, %last : vector<2xindex>
  %added_bits = scalar.constant 2 : i16
  %original_bits = scalar.constant 32641 : i16
  %active_bits = scf.select %enabled, %added_bits, %original_bits : i16
  %expected_bits = vector.from_elements %active_bits, %original_bits : vector<2xi16>
  %expected = vector.bitcast %expected_bits : vector<2xi16> to vector<2xbf16>
  %replacement_bits = vector.splati -32768 : vector<2xi16>
  %replacement = vector.bitcast %replacement_bits : vector<2xi16> to vector<2xbf16>
  %observed = vector.atomic.cmpxchg %expected, %replacement, %cells[0][%pair_offsets] {cache_scope = workgroup, cache_temporal = non_temporal, failure_ordering = acquire, scope = workgroup, success_ordering = acq_rel} : vector<2xbf16>, view<2xbf16>, vector<2xindex> -> vector<2xbf16>
  %failed = vector.atomic.cmpxchg %expected, %nan, %cells[0][%pair_offsets] {cache_scope = workgroup, cache_temporal = non_temporal, failure_ordering = acquire, scope = workgroup, success_ordering = acq_rel} : vector<2xbf16>, view<2xbf16>, vector<2xindex> -> vector<2xbf16>
  %final = vector.load %cells[0] : view<2xbf16> -> vector<2xbf16>
  %observed_bits = vector.bitcast %observed : vector<2xbf16> to vector<2xi16>
  %failed_bits = vector.bitcast %failed : vector<2xbf16> to vector<2xi16>
  %final_bits = vector.bitcast %final : vector<2xbf16> to vector<2xi16>
  vector.store %observed_bits, %results[3] : vector<2xi16>, view<9xi16>
  vector.store %failed_bits, %results[5] : vector<2xi16>, view<9xi16>
  vector.store %final_bits, %results[7] : vector<2xi16>, view<9xi16>
  kernel.return
}

func.def @masked_brain_payloads_oracle(%flag: i32, %output: buffer) {
  %origin = index.constant 0 : offset
  %results = buffer.view %output[%origin] : buffer -> view<9xi16>
  %flag_clear = scalar.constant 0 : i32
  %enabled = scalar.cmpi ne, %flag, %flag_clear : i32
  %nan_bits = scalar.constant 32641 : i16
  %passthrough_bits = scalar.constant 32709 : i16
  %added_bits = scalar.constant 2 : i16
  %replacement_bits = scalar.constant -32768 : i16
  %old_first = scf.select %enabled, %nan_bits, %passthrough_bits : i16
  %observed_first = scf.select %enabled, %added_bits, %nan_bits : i16
  view.store %old_first, %results[0] : i16, view<9xi16>
  view.store %passthrough_bits, %results[1] : i16, view<9xi16>
  view.store %passthrough_bits, %results[2] : i16, view<9xi16>
  view.store %observed_first, %results[3] : i16, view<9xi16>
  view.store %nan_bits, %results[4] : i16, view<9xi16>
  view.store %replacement_bits, %results[5] : i16, view<9xi16>
  view.store %replacement_bits, %results[6] : i16, view<9xi16>
  view.store %replacement_bits, %results[7] : i16, view<9xi16>
  view.store %replacement_bits, %results[8] : i16, view<9xi16>
  func.return
}

check.scenario @brain_mask_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %flag = check.literal value(1) : i32
    %output = check.generate.fill value(0) : tensor<9xi16>
    check.compare<@masked_brain_payloads, @masked_brain_payloads_oracle>(%flag, %output) : (i32, tensor<9xi16>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<9xi16>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %flag = check.literal value(0) : i32
    %output = check.generate.fill value(0) : tensor<9xi16>
    check.compare<@masked_brain_payloads, @masked_brain_payloads_oracle>(%flag, %output) : (i32, tensor<9xi16>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<9xi16>
    }
  }
  check.return
}
