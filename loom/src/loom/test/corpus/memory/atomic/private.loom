kernel.def @private_cmpxchg() {
  %unit = index.constant 1 : index
  %width = index.constant 128 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %storage = buffer.alloca<private> align(4) %bytes : buffer
  %cell = buffer.view %storage[%origin] : buffer -> view<1xf32>
  %source = buffer.view %input[%origin] : buffer -> view<128xi32>
  %results = buffer.view %output[%origin] : buffer -> view<3x128xi32>
  %lane = kernel.workitem.id<x> : index
  %initial_bits = view.load %source[%lane] : view<128xi32> -> i32
  %initial = scalar.bitcast %initial_bits : i32 to f32
  view.atomic.store %initial, %cell[0] {ordering = seq_cst, scope = system} : f32, view<1xf32>
  %different_bits = scalar.constant 2143363909 : i32
  %different = scalar.bitcast %different_bits : i32 to f32
  %matching_bits = scalar.constant 2139169605 : i32
  %matching = scalar.bitcast %matching_bits : i32 to f32
  %replacement_bits = scalar.constant -2147483648 : i32
  %replacement = scalar.bitcast %replacement_bits : i32 to f32
  %failed = view.atomic.cmpxchg %different, %replacement, %cell[0] {failure_ordering = seq_cst, scope = system, success_ordering = seq_cst} : f32, view<1xf32> -> f32
  %succeeded = view.atomic.cmpxchg %matching, %replacement, %cell[0] {failure_ordering = acquire, scope = device, success_ordering = acq_rel} : f32, view<1xf32> -> f32
  %final = view.atomic.load %cell[0] {ordering = acquire, scope = system} : view<1xf32> -> f32
  %failed_bits = scalar.bitcast %failed : f32 to i32
  %succeeded_bits = scalar.bitcast %succeeded : f32 to i32
  %final_bits = scalar.bitcast %final : f32 to i32
  view.store %failed_bits, %results[0, %lane] : i32, view<3x128xi32>
  view.store %succeeded_bits, %results[1, %lane] : i32, view<3x128xi32>
  view.store %final_bits, %results[2, %lane] : i32, view<3x128xi32>
  kernel.return
}

func.def @private_cmpxchg_oracle(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 128 : index
  %step = index.constant 1 : index
  %source = buffer.view %input[%origin] : buffer -> view<128xi32>
  %results = buffer.view %output[%origin] : buffer -> view<3x128xi32>
  %different = scalar.constant 2143363909 : i32
  %matching = scalar.constant 2139169605 : i32
  %replacement = scalar.constant -2147483648 : i32
  scf.for %lane = [%begin to %end step %step] {
    %initial = view.load %source[%lane] : view<128xi32> -> i32
    %failed_matches = scalar.cmpi eq, %initial, %different : i32
    %after_failed = scf.select %failed_matches, %replacement, %initial : i32
    %succeeded_matches = scalar.cmpi eq, %after_failed, %matching : i32
    %final = scf.select %succeeded_matches, %replacement, %after_failed : i32
    view.store %initial, %results[0, %lane] : i32, view<3x128xi32>
    view.store %after_failed, %results[1, %lane] : i32, view<3x128xi32>
    view.store %final, %results[2, %lane] : i32, view<3x128xi32>
  }
  func.return
}

check.scenario @private_bitwise_compare {
  check.trial[8](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-2147483648 to 2147483647) : tensor<128xi32>
    %output = check.generate.fill value(0) : tensor<3x128xi32>
    check.compare<@private_cmpxchg, @private_cmpxchg_oracle>(%input, %output) : (tensor<128xi32>, tensor<3x128xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<128xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<3x128xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(2139169605) : tensor<128xi32>
    %output = check.generate.fill value(0) : tensor<3x128xi32>
    check.compare<@private_cmpxchg, @private_cmpxchg_oracle>(%input, %output) : (tensor<128xi32>, tensor<3x128xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<128xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<3x128xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(2143363909) : tensor<128xi32>
    %output = check.generate.fill value(0) : tensor<3x128xi32>
    check.compare<@private_cmpxchg, @private_cmpxchg_oracle>(%input, %output) : (tensor<128xi32>, tensor<3x128xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<128xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<3x128xi32>
    }
  }
  check.return
}

// Every lane owns its cells. Runtime inputs keep updates and comparisons live.
kernel.def @private_integer_updates() {
  %unit = index.constant 1 : index
  %width = index.constant 128 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 8 : offset
  %storage = buffer.alloca<private> align(8) %bytes : buffer
  %cell = buffer.view %storage[%origin] : buffer -> view<1xi64>
  %source = buffer.view %input[%origin] : buffer -> view<128xi64>
  %results = buffer.view %output[%origin] : buffer -> view<21x128xi64>
  %lane = kernel.workitem.id<x> : index
  %initial = view.load %source[%lane] : view<128xi64> -> i64
  %update = scalar.constant 5 : i64
  view.atomic.store %initial, %cell[0] {ordering = release, scope = system} : i64, view<1xi64>
  %old_xchgi = view.atomic.rmw<xchgi> %update, %cell[0] {ordering = acq_rel, scope = system} : i64, view<1xi64> -> i64
  %final_xchgi = view.atomic.load %cell[0] {ordering = acquire, scope = system} : view<1xi64> -> i64
  view.store %old_xchgi, %results[0, %lane] : i64, view<21x128xi64>
  view.store %final_xchgi, %results[10, %lane] : i64, view<21x128xi64>
  view.atomic.store %initial, %cell[0] {ordering = release, scope = system} : i64, view<1xi64>
  %old_addi = view.atomic.rmw<addi> %update, %cell[0] {ordering = acq_rel, scope = system} : i64, view<1xi64> -> i64
  %final_addi = view.atomic.load %cell[0] {ordering = acquire, scope = system} : view<1xi64> -> i64
  view.store %old_addi, %results[1, %lane] : i64, view<21x128xi64>
  view.store %final_addi, %results[11, %lane] : i64, view<21x128xi64>
  view.atomic.store %initial, %cell[0] {ordering = release, scope = system} : i64, view<1xi64>
  %old_subi = view.atomic.rmw<subi> %update, %cell[0] {ordering = acq_rel, scope = system} : i64, view<1xi64> -> i64
  %final_subi = view.atomic.load %cell[0] {ordering = acquire, scope = system} : view<1xi64> -> i64
  view.store %old_subi, %results[2, %lane] : i64, view<21x128xi64>
  view.store %final_subi, %results[12, %lane] : i64, view<21x128xi64>
  view.atomic.store %initial, %cell[0] {ordering = release, scope = system} : i64, view<1xi64>
  %old_andi = view.atomic.rmw<andi> %update, %cell[0] {ordering = acq_rel, scope = system} : i64, view<1xi64> -> i64
  %final_andi = view.atomic.load %cell[0] {ordering = acquire, scope = system} : view<1xi64> -> i64
  view.store %old_andi, %results[3, %lane] : i64, view<21x128xi64>
  view.store %final_andi, %results[13, %lane] : i64, view<21x128xi64>
  view.atomic.store %initial, %cell[0] {ordering = release, scope = system} : i64, view<1xi64>
  %old_ori = view.atomic.rmw<ori> %update, %cell[0] {ordering = acq_rel, scope = system} : i64, view<1xi64> -> i64
  %final_ori = view.atomic.load %cell[0] {ordering = acquire, scope = system} : view<1xi64> -> i64
  view.store %old_ori, %results[4, %lane] : i64, view<21x128xi64>
  view.store %final_ori, %results[14, %lane] : i64, view<21x128xi64>
  view.atomic.store %initial, %cell[0] {ordering = release, scope = system} : i64, view<1xi64>
  %old_xori = view.atomic.rmw<xori> %update, %cell[0] {ordering = acq_rel, scope = system} : i64, view<1xi64> -> i64
  %final_xori = view.atomic.load %cell[0] {ordering = acquire, scope = system} : view<1xi64> -> i64
  view.store %old_xori, %results[5, %lane] : i64, view<21x128xi64>
  view.store %final_xori, %results[15, %lane] : i64, view<21x128xi64>
  view.atomic.store %initial, %cell[0] {ordering = release, scope = system} : i64, view<1xi64>
  %old_minsi = view.atomic.rmw<minsi> %update, %cell[0] {ordering = acq_rel, scope = system} : i64, view<1xi64> -> i64
  %final_minsi = view.atomic.load %cell[0] {ordering = acquire, scope = system} : view<1xi64> -> i64
  view.store %old_minsi, %results[6, %lane] : i64, view<21x128xi64>
  view.store %final_minsi, %results[16, %lane] : i64, view<21x128xi64>
  view.atomic.store %initial, %cell[0] {ordering = release, scope = system} : i64, view<1xi64>
  %old_maxsi = view.atomic.rmw<maxsi> %update, %cell[0] {ordering = acq_rel, scope = system} : i64, view<1xi64> -> i64
  %final_maxsi = view.atomic.load %cell[0] {ordering = acquire, scope = system} : view<1xi64> -> i64
  view.store %old_maxsi, %results[7, %lane] : i64, view<21x128xi64>
  view.store %final_maxsi, %results[17, %lane] : i64, view<21x128xi64>
  view.atomic.store %initial, %cell[0] {ordering = release, scope = system} : i64, view<1xi64>
  %old_minui = view.atomic.rmw<minui> %update, %cell[0] {ordering = acq_rel, scope = system} : i64, view<1xi64> -> i64
  %final_minui = view.atomic.load %cell[0] {ordering = acquire, scope = system} : view<1xi64> -> i64
  view.store %old_minui, %results[8, %lane] : i64, view<21x128xi64>
  view.store %final_minui, %results[18, %lane] : i64, view<21x128xi64>
  view.atomic.store %initial, %cell[0] {ordering = release, scope = system} : i64, view<1xi64>
  %old_maxui = view.atomic.rmw<maxui> %update, %cell[0] {ordering = acq_rel, scope = system} : i64, view<1xi64> -> i64
  %final_maxui = view.atomic.load %cell[0] {ordering = acquire, scope = system} : view<1xi64> -> i64
  view.store %old_maxui, %results[9, %lane] : i64, view<21x128xi64>
  view.store %final_maxui, %results[19, %lane] : i64, view<21x128xi64>
  view.atomic.reduce<subi> %update, %cell[0] {ordering = seq_cst, scope = system} : i64, view<1xi64>
  %reduced = view.atomic.load %cell[0] {ordering = seq_cst, scope = system} : view<1xi64> -> i64
  view.store %reduced, %results[20, %lane] : i64, view<21x128xi64>
  kernel.return
}

func.def @private_integer_updates_oracle(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 128 : index
  %step = index.constant 1 : index
  %source = buffer.view %input[%origin] : buffer -> view<128xi64>
  %results = buffer.view %output[%origin] : buffer -> view<21x128xi64>
  %update = scalar.constant 5 : i64
  scf.for %lane = [%begin to %end step %step] {
    %initial = view.load %source[%lane] : view<128xi64> -> i64
    %add = scalar.addi %initial, %update : i64
    %sub = scalar.subi %initial, %update : i64
    %and = scalar.andi %initial, %update : i64
    %or = scalar.ori %initial, %update : i64
    %xor = scalar.xori %initial, %update : i64
    %signed_min = scalar.minsi %initial, %update : i64
    %signed_max = scalar.maxsi %initial, %update : i64
    %unsigned_min = scalar.minui %initial, %update : i64
    %unsigned_max = scalar.maxui %initial, %update : i64
    %reduced = scalar.subi %unsigned_max, %update : i64
    view.store %initial, %results[0, %lane] : i64, view<21x128xi64>
    view.store %initial, %results[1, %lane] : i64, view<21x128xi64>
    view.store %initial, %results[2, %lane] : i64, view<21x128xi64>
    view.store %initial, %results[3, %lane] : i64, view<21x128xi64>
    view.store %initial, %results[4, %lane] : i64, view<21x128xi64>
    view.store %initial, %results[5, %lane] : i64, view<21x128xi64>
    view.store %initial, %results[6, %lane] : i64, view<21x128xi64>
    view.store %initial, %results[7, %lane] : i64, view<21x128xi64>
    view.store %initial, %results[8, %lane] : i64, view<21x128xi64>
    view.store %initial, %results[9, %lane] : i64, view<21x128xi64>
    view.store %update, %results[10, %lane] : i64, view<21x128xi64>
    view.store %add, %results[11, %lane] : i64, view<21x128xi64>
    view.store %sub, %results[12, %lane] : i64, view<21x128xi64>
    view.store %and, %results[13, %lane] : i64, view<21x128xi64>
    view.store %or, %results[14, %lane] : i64, view<21x128xi64>
    view.store %xor, %results[15, %lane] : i64, view<21x128xi64>
    view.store %signed_min, %results[16, %lane] : i64, view<21x128xi64>
    view.store %signed_max, %results[17, %lane] : i64, view<21x128xi64>
    view.store %unsigned_min, %results[18, %lane] : i64, view<21x128xi64>
    view.store %unsigned_max, %results[19, %lane] : i64, view<21x128xi64>
    view.store %reduced, %results[20, %lane] : i64, view<21x128xi64>
  }
  func.return
}

check.scenario @private_integer_results {
  check.trial[16](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-9223372036854775808 to 9223372036854775807) : tensor<128xi64>
    %output = check.generate.fill value(0) : tensor<21x128xi64>
    check.compare<@private_integer_updates, @private_integer_updates_oracle>(%input, %output) : (tensor<128xi64>, tensor<21x128xi64>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<128xi64>
      check.expect.bitwise actual(%output) expected(%output) : tensor<21x128xi64>
    }
  }
  check.return
}

// A minimum positive subnormal from memory doubles without flushing. Mixed
// private fields also check exact access widths and signed narrow wrapping.
kernel.def @private_carriers() {
  %unit = index.constant 1 : index
  %width = index.constant 128 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 24 : offset
  %storage = buffer.alloca<private> align(8) %bytes : buffer
  %source = buffer.view %input[%origin] : buffer -> view<128xi64>
  %results = buffer.view %output[%origin] : buffer -> view<16x128xi64>
  %lane = kernel.workitem.id<x> : index
  %bits_i64 = view.load %source[%lane] : view<128xi64> -> i64
  %bits_i32 = scalar.trunci %bits_i64 : i64 to i32
  %bits_i16 = scalar.trunci %bits_i64 : i64 to i16
  %bits_i8 = scalar.trunci %bits_i64 : i64 to i8
  %offset_f16 = index.constant 0 : offset
  %cell_f16 = buffer.view %storage[%offset_f16] : buffer -> view<1xf16>
  %initial_f16 = scalar.bitcast %bits_i16 : i16 to f16
  view.atomic.store %initial_f16, %cell_f16[0] {ordering = release, scope = system} : f16, view<1xf16>
  %old_f16 = view.atomic.rmw<addf, noftz> %initial_f16, %cell_f16[0] {ordering = acq_rel, scope = system} : f16, view<1xf16> -> f16
  %final_f16 = view.atomic.load %cell_f16[0] {ordering = acquire, scope = system} : view<1xf16> -> f16
  %old_f16_bits = scalar.bitcast %old_f16 : f16 to i16
  %old_f16_wide = scalar.extui %old_f16_bits : i16 to i64
  view.store %old_f16_wide, %results[0, %lane] : i64, view<16x128xi64>
  %final_f16_bits = scalar.bitcast %final_f16 : f16 to i16
  %final_f16_wide = scalar.extui %final_f16_bits : i16 to i64
  view.store %final_f16_wide, %results[6, %lane] : i64, view<16x128xi64>
  %offset_bf16 = index.constant 2 : offset
  %cell_bf16 = buffer.view %storage[%offset_bf16] : buffer -> view<1xbf16>
  %initial_bf16 = scalar.bitcast %bits_i16 : i16 to bf16
  view.atomic.store %initial_bf16, %cell_bf16[0] {ordering = release, scope = system} : bf16, view<1xbf16>
  %old_bf16 = view.atomic.rmw<addf, noftz> %initial_bf16, %cell_bf16[0] {ordering = acq_rel, scope = system} : bf16, view<1xbf16> -> bf16
  %final_bf16 = view.atomic.load %cell_bf16[0] {ordering = acquire, scope = system} : view<1xbf16> -> bf16
  %old_bf16_bits = scalar.bitcast %old_bf16 : bf16 to i16
  %old_bf16_wide = scalar.extui %old_bf16_bits : i16 to i64
  view.store %old_bf16_wide, %results[1, %lane] : i64, view<16x128xi64>
  %final_bf16_bits = scalar.bitcast %final_bf16 : bf16 to i16
  %final_bf16_wide = scalar.extui %final_bf16_bits : i16 to i64
  view.store %final_bf16_wide, %results[7, %lane] : i64, view<16x128xi64>
  %offset_f32 = index.constant 4 : offset
  %cell_f32 = buffer.view %storage[%offset_f32] : buffer -> view<1xf32>
  %initial_f32 = scalar.bitcast %bits_i32 : i32 to f32
  view.atomic.store %initial_f32, %cell_f32[0] {ordering = release, scope = system} : f32, view<1xf32>
  %old_f32 = view.atomic.rmw<addf, noftz> %initial_f32, %cell_f32[0] {ordering = acq_rel, scope = system} : f32, view<1xf32> -> f32
  %final_f32 = view.atomic.load %cell_f32[0] {ordering = acquire, scope = system} : view<1xf32> -> f32
  %old_f32_bits = scalar.bitcast %old_f32 : f32 to i32
  %old_f32_wide = scalar.extui %old_f32_bits : i32 to i64
  view.store %old_f32_wide, %results[2, %lane] : i64, view<16x128xi64>
  %final_f32_bits = scalar.bitcast %final_f32 : f32 to i32
  %final_f32_wide = scalar.extui %final_f32_bits : i32 to i64
  view.store %final_f32_wide, %results[8, %lane] : i64, view<16x128xi64>
  %offset_f64 = index.constant 8 : offset
  %cell_f64 = buffer.view %storage[%offset_f64] : buffer -> view<1xf64>
  %initial_f64 = scalar.bitcast %bits_i64 : i64 to f64
  view.atomic.store %initial_f64, %cell_f64[0] {ordering = release, scope = system} : f64, view<1xf64>
  %old_f64 = view.atomic.rmw<addf, noftz> %initial_f64, %cell_f64[0] {ordering = acq_rel, scope = system} : f64, view<1xf64> -> f64
  %final_f64 = view.atomic.load %cell_f64[0] {ordering = acquire, scope = system} : view<1xf64> -> f64
  %old_f64_bits = scalar.bitcast %old_f64 : f64 to i64
  view.store %old_f64_bits, %results[3, %lane] : i64, view<16x128xi64>
  %final_f64_bits = scalar.bitcast %final_f64 : f64 to i64
  view.store %final_f64_bits, %results[9, %lane] : i64, view<16x128xi64>
  %offset_i8 = index.constant 16 : offset
  %cell_i8 = buffer.view %storage[%offset_i8] : buffer -> view<1xi8>
  %initial_i8 = scalar.constant 127 : i8
  %update_i8 = scalar.addi %bits_i8, %bits_i8 : i8
  view.atomic.store %initial_i8, %cell_i8[0] {ordering = release, scope = system} : i8, view<1xi8>
  %old_i8 = view.atomic.rmw<addi> %update_i8, %cell_i8[0] {ordering = acq_rel, scope = system} : i8, view<1xi8> -> i8
  %final_i8 = view.atomic.load %cell_i8[0] {ordering = acquire, scope = system} : view<1xi8> -> i8
  %old_i8_wide = scalar.extsi %old_i8 : i8 to i64
  view.store %old_i8_wide, %results[4, %lane] : i64, view<16x128xi64>
  %final_i8_wide = scalar.extsi %final_i8 : i8 to i64
  view.store %final_i8_wide, %results[10, %lane] : i64, view<16x128xi64>
  %offset_i16 = index.constant 18 : offset
  %cell_i16 = buffer.view %storage[%offset_i16] : buffer -> view<1xi16>
  %initial_i16 = scalar.constant 32767 : i16
  %update_i16 = scalar.addi %bits_i16, %bits_i16 : i16
  view.atomic.store %initial_i16, %cell_i16[0] {ordering = release, scope = system} : i16, view<1xi16>
  %old_i16 = view.atomic.rmw<addi> %update_i16, %cell_i16[0] {ordering = acq_rel, scope = system} : i16, view<1xi16> -> i16
  %final_i16 = view.atomic.load %cell_i16[0] {ordering = acquire, scope = system} : view<1xi16> -> i16
  %old_i16_wide = scalar.extsi %old_i16 : i16 to i64
  view.store %old_i16_wide, %results[5, %lane] : i64, view<16x128xi64>
  %final_i16_wide = scalar.extsi %final_i16 : i16 to i64
  view.store %final_i16_wide, %results[11, %lane] : i64, view<16x128xi64>
  %offset_f8e4m3 = index.constant 20 : offset
  %cell_f8e4m3 = buffer.view %storage[%offset_f8e4m3] : buffer -> view<1xf8E4M3>
  %initial_f8e4m3 = scalar.bitcast %bits_i8 : i8 to f8E4M3
  view.atomic.store %initial_f8e4m3, %cell_f8e4m3[0] {ordering = release, scope = system} : f8E4M3, view<1xf8E4M3>
  %old_f8e4m3 = view.atomic.rmw<addf, noftz> %initial_f8e4m3, %cell_f8e4m3[0] {ordering = acq_rel, scope = system} : f8E4M3, view<1xf8E4M3> -> f8E4M3
  %final_f8e4m3 = view.atomic.load %cell_f8e4m3[0] {ordering = acquire, scope = system} : view<1xf8E4M3> -> f8E4M3
  %old_f8e4m3_bits = scalar.bitcast %old_f8e4m3 : f8E4M3 to i8
  %old_f8e4m3_wide = scalar.extui %old_f8e4m3_bits : i8 to i64
  view.store %old_f8e4m3_wide, %results[12, %lane] : i64, view<16x128xi64>
  %final_f8e4m3_bits = scalar.bitcast %final_f8e4m3 : f8E4M3 to i8
  %final_f8e4m3_wide = scalar.extui %final_f8e4m3_bits : i8 to i64
  view.store %final_f8e4m3_wide, %results[13, %lane] : i64, view<16x128xi64>
  %offset_f8e5m2 = index.constant 21 : offset
  %cell_f8e5m2 = buffer.view %storage[%offset_f8e5m2] : buffer -> view<1xf8E5M2>
  %initial_f8e5m2 = scalar.bitcast %bits_i8 : i8 to f8E5M2
  view.atomic.store %initial_f8e5m2, %cell_f8e5m2[0] {ordering = release, scope = system} : f8E5M2, view<1xf8E5M2>
  %old_f8e5m2 = view.atomic.rmw<addf, noftz> %initial_f8e5m2, %cell_f8e5m2[0] {ordering = acq_rel, scope = system} : f8E5M2, view<1xf8E5M2> -> f8E5M2
  %final_f8e5m2 = view.atomic.load %cell_f8e5m2[0] {ordering = acquire, scope = system} : view<1xf8E5M2> -> f8E5M2
  %old_f8e5m2_bits = scalar.bitcast %old_f8e5m2 : f8E5M2 to i8
  %old_f8e5m2_wide = scalar.extui %old_f8e5m2_bits : i8 to i64
  view.store %old_f8e5m2_wide, %results[14, %lane] : i64, view<16x128xi64>
  %final_f8e5m2_bits = scalar.bitcast %final_f8e5m2 : f8E5M2 to i8
  %final_f8e5m2_wide = scalar.extui %final_f8e5m2_bits : i8 to i64
  view.store %final_f8e5m2_wide, %results[15, %lane] : i64, view<16x128xi64>
  kernel.return
}

// The directed input is the minimum positive bit pattern for every floating
// carrier. Integer bit arithmetic independently models exact gradual underflow.
func.def @private_carriers_oracle(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 128 : index
  %step = index.constant 1 : index
  %source = buffer.view %input[%origin] : buffer -> view<128xi64>
  %results = buffer.view %output[%origin] : buffer -> view<16x128xi64>
  %initial_i8 = scalar.constant 127 : i8
  %initial_i16 = scalar.constant 32767 : i16
  scf.for %lane = [%begin to %end step %step] {
    %bits_i64 = view.load %source[%lane] : view<128xi64> -> i64
    %bits_i32 = scalar.trunci %bits_i64 : i64 to i32
    %bits_i16 = scalar.trunci %bits_i64 : i64 to i16
    %bits_i8 = scalar.trunci %bits_i64 : i64 to i8
    %old_i16 = scalar.extui %bits_i16 : i16 to i64
    %old_i32 = scalar.extui %bits_i32 : i32 to i64
    %old_i8 = scalar.extui %bits_i8 : i8 to i64
    %final_f64 = scalar.addi %bits_i64, %bits_i64 : i64
    %final_i32_bits = scalar.addi %bits_i32, %bits_i32 : i32
    %final_i32 = scalar.extui %final_i32_bits : i32 to i64
    %final_i16_bits = scalar.addi %bits_i16, %bits_i16 : i16
    %final_i16 = scalar.extui %final_i16_bits : i16 to i64
    %final_i8_bits = scalar.addi %bits_i8, %bits_i8 : i8
    %final_i8 = scalar.extui %final_i8_bits : i8 to i64
    %integer_i8 = scalar.addi %initial_i8, %final_i8_bits : i8
    %integer_i8_wide = scalar.extsi %integer_i8 : i8 to i64
    %integer_i16 = scalar.addi %initial_i16, %final_i16_bits : i16
    %integer_i16_wide = scalar.extsi %integer_i16 : i16 to i64
    view.store %old_i16, %results[0, %lane] : i64, view<16x128xi64>
    view.store %old_i16, %results[1, %lane] : i64, view<16x128xi64>
    view.store %old_i32, %results[2, %lane] : i64, view<16x128xi64>
    view.store %bits_i64, %results[3, %lane] : i64, view<16x128xi64>
    %initial_i8_wide = scalar.extsi %initial_i8 : i8 to i64
    %initial_i16_wide = scalar.extsi %initial_i16 : i16 to i64
    view.store %initial_i8_wide, %results[4, %lane] : i64, view<16x128xi64>
    view.store %initial_i16_wide, %results[5, %lane] : i64, view<16x128xi64>
    view.store %final_i16, %results[6, %lane] : i64, view<16x128xi64>
    view.store %final_i16, %results[7, %lane] : i64, view<16x128xi64>
    view.store %final_i32, %results[8, %lane] : i64, view<16x128xi64>
    view.store %final_f64, %results[9, %lane] : i64, view<16x128xi64>
    view.store %integer_i8_wide, %results[10, %lane] : i64, view<16x128xi64>
    view.store %integer_i16_wide, %results[11, %lane] : i64, view<16x128xi64>
    view.store %old_i8, %results[12, %lane] : i64, view<16x128xi64>
    view.store %final_i8, %results[13, %lane] : i64, view<16x128xi64>
    view.store %old_i8, %results[14, %lane] : i64, view<16x128xi64>
    view.store %final_i8, %results[15, %lane] : i64, view<16x128xi64>
  }
  func.return
}

check.scenario @private_carrier_results {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(1) : tensor<128xi64>
    %output = check.generate.fill value(0) : tensor<16x128xi64>
    check.compare<@private_carriers, @private_carriers_oracle>(%input, %output) : (tensor<128xi64>, tensor<16x128xi64>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<128xi64>
      check.expect.bitwise actual(%output) expected(%output) : tensor<16x128xi64>
    }
  }
  check.return
}

// Adjacent invocations enable opposite vector lanes. Every update preserves
// minimum subnormals, inactive lanes return the passthrough bits, and duplicate
// addresses accumulate both contributions to the same private element.
kernel.def @private_vector_updates() {
  %unit = index.constant 1 : index
  %width = index.constant 128 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %storage = buffer.alloca<private> align(4) %bytes : buffer
  %cells = buffer.view %storage[%origin] : buffer -> view<2xf16>
  %source = buffer.view %input[%origin] : buffer -> view<128x2xi16>
  %results = buffer.view %output[%origin] : buffer -> view<5x128x2xi16>
  %lane = kernel.workitem.id<x> : index
  %bits = vector.load %source[%lane, 0] : view<128x2xi16> -> vector<2xi16>
  %initial = vector.bitcast %bits : vector<2xi16> to vector<2xf16>
  vector.store %initial, %cells[0] : vector<2xf16>, view<2xf16>
  %first = index.constant 0 : index
  %step = index.constant 1 : index
  %offsets = vector.iota %first step %step : vector<2xindex>
  %lane_bits = index.cast %lane : index to i32
  %parity_mask = scalar.constant 1 : i32
  %c0 = scalar.constant 0 : i32
  %parity = scalar.andi %lane_bits, %parity_mask : i32
  %even = scalar.cmpi eq, %parity, %c0 : i32
  %odd = scalar.cmpi ne, %parity, %c0 : i32
  %mask = vector.from_elements %even, %odd : vector<2xi1>
  %passthrough_bits = vector.splati 11 : vector<2xi16>
  %passthrough = vector.bitcast %passthrough_bits : vector<2xi16> to vector<2xf16>
  vector.atomic.reduce<addf, noftz> %initial, %cells[0][%offsets] {ordering = release, scope = system} : vector<2xf16>, view<2xf16>, vector<2xindex>
  vector.atomic.reduce.mask<addf, noftz> %initial, %cells[0][%offsets], %mask {ordering = relaxed, scope = thread} : vector<2xf16>, view<2xf16>, vector<2xindex>, vector<2xi1>
  %old = vector.atomic.rmw<addf, noftz> %initial, %cells[0][%offsets] {ordering = acq_rel, scope = system} : vector<2xf16>, view<2xf16>, vector<2xindex>
  %masked = vector.atomic.rmw.mask<addf, noftz> %initial, %cells[0][%offsets], %mask, %passthrough {ordering = relaxed, scope = thread} : vector<2xf16>, view<2xf16>, vector<2xindex>, vector<2xi1>, vector<2xf16>
  %expected_bits = vector.splati 3 : vector<2xi16>
  %expected = vector.bitcast %expected_bits : vector<2xi16> to vector<2xf16>
  %replacement_bits = vector.splati 7 : vector<2xi16>
  %replacement = vector.bitcast %replacement_bits : vector<2xi16> to vector<2xf16>
  %observed = vector.atomic.cmpxchg %expected, %replacement, %cells[0][%offsets] {failure_ordering = acquire, scope = system, success_ordering = acq_rel} : vector<2xf16>, view<2xf16>, vector<2xindex> -> vector<2xf16>
  %final = vector.load %cells[0] : view<2xf16> -> vector<2xf16>
  %duplicates = vector.splati 0 : vector<2xindex>
  vector.atomic.reduce<addf, noftz> %initial, %cells[0][%duplicates] {ordering = seq_cst, scope = system} : vector<2xf16>, view<2xf16>, vector<2xindex>
  %accumulated = vector.load %cells[0] : view<2xf16> -> vector<2xf16>
  %old_bits = vector.bitcast %old : vector<2xf16> to vector<2xi16>
  %masked_bits = vector.bitcast %masked : vector<2xf16> to vector<2xi16>
  %observed_bits = vector.bitcast %observed : vector<2xf16> to vector<2xi16>
  %final_bits = vector.bitcast %final : vector<2xf16> to vector<2xi16>
  %accumulated_bits = vector.bitcast %accumulated : vector<2xf16> to vector<2xi16>
  vector.store %old_bits, %results[0, %lane, 0] : vector<2xi16>, view<5x128x2xi16>
  vector.store %masked_bits, %results[1, %lane, 0] : vector<2xi16>, view<5x128x2xi16>
  vector.store %observed_bits, %results[2, %lane, 0] : vector<2xi16>, view<5x128x2xi16>
  vector.store %final_bits, %results[3, %lane, 0] : vector<2xi16>, view<5x128x2xi16>
  vector.store %accumulated_bits, %results[4, %lane, 0] : vector<2xi16>, view<5x128x2xi16>
  kernel.return
}

func.def @private_vector_updates_oracle(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 128 : index
  %pair = index.constant 2 : index
  %step = index.constant 1 : index
  %source = buffer.view %input[%origin] : buffer -> view<128x2xi16>
  %results = buffer.view %output[%origin] : buffer -> view<5x128x2xi16>
  %inactive_delta = scalar.constant 0.0 : f16
  %passthrough_bits = scalar.constant 11 : i16
  %passthrough = scalar.bitcast %passthrough_bits : i16 to f16
  %expected_bits = scalar.constant 3 : i16
  %replacement_bits = scalar.constant 7 : i16
  scf.for %lane = [%begin to %end step %step] {
    %first_bits = view.load %source[%lane, 0] : view<128x2xi16> -> i16
    %second_bits = view.load %source[%lane, 1] : view<128x2xi16> -> i16
    %first = scalar.bitcast %first_bits : i16 to f16
    %second = scalar.bitcast %second_bits : i16 to f16
    %first_twice = scalar.addf %first, %first : f16
    %second_twice = scalar.addf %second, %second : f16
    %first_thrice = scalar.addf %first_twice, %first : f16
    %second_thrice = scalar.addf %second_twice, %second : f16
    %parity = index.rem %lane, %pair : index
    %even = index.cmp eq, %parity, %begin : index
    %old_first = scf.select %even, %first_thrice, %first_twice : f16
    %old_second = scf.select %even, %second_twice, %second_thrice : f16
    %updated_first = scalar.addf %old_first, %first : f16
    %updated_second = scalar.addf %old_second, %second : f16
    %masked_first = scf.select %even, %updated_first, %passthrough : f16
    %masked_second = scf.select %even, %passthrough, %updated_second : f16
    %first_delta = scf.select %even, %first, %inactive_delta : f16
    %second_delta = scf.select %even, %inactive_delta, %second : f16
    %observed_first = scalar.addf %updated_first, %first_delta : f16
    %observed_second = scalar.addf %updated_second, %second_delta : f16
    %observed_first_bits = scalar.bitcast %observed_first : f16 to i16
    %observed_second_bits = scalar.bitcast %observed_second : f16 to i16
    %first_matches = scalar.cmpi eq, %observed_first_bits, %expected_bits : i16
    %second_matches = scalar.cmpi eq, %observed_second_bits, %expected_bits : i16
    %final_first_bits = scf.select %first_matches, %replacement_bits, %observed_first_bits : i16
    %final_second_bits = scf.select %second_matches, %replacement_bits, %observed_second_bits : i16
    %final_first = scalar.bitcast %final_first_bits : i16 to f16
    %first_accumulated = scalar.addf %final_first, %first : f16
    %accumulated = scalar.addf %first_accumulated, %second : f16
    %accumulated_bits = scalar.bitcast %accumulated : f16 to i16
    %old_first_bits = scalar.bitcast %old_first : f16 to i16
    %old_second_bits = scalar.bitcast %old_second : f16 to i16
    %masked_first_bits = scalar.bitcast %masked_first : f16 to i16
    %masked_second_bits = scalar.bitcast %masked_second : f16 to i16
    view.store %old_first_bits, %results[0, %lane, 0] : i16, view<5x128x2xi16>
    view.store %old_second_bits, %results[0, %lane, 1] : i16, view<5x128x2xi16>
    view.store %masked_first_bits, %results[1, %lane, 0] : i16, view<5x128x2xi16>
    view.store %masked_second_bits, %results[1, %lane, 1] : i16, view<5x128x2xi16>
    view.store %observed_first_bits, %results[2, %lane, 0] : i16, view<5x128x2xi16>
    view.store %observed_second_bits, %results[2, %lane, 1] : i16, view<5x128x2xi16>
    view.store %final_first_bits, %results[3, %lane, 0] : i16, view<5x128x2xi16>
    view.store %final_second_bits, %results[3, %lane, 1] : i16, view<5x128x2xi16>
    view.store %accumulated_bits, %results[4, %lane, 0] : i16, view<5x128x2xi16>
    view.store %final_second_bits, %results[4, %lane, 1] : i16, view<5x128x2xi16>
  }
  func.return
}

check.scenario @private_vector_results {
  check.trial[8](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(1 to 32) : tensor<128x2xi16>
    %output = check.generate.fill value(0) : tensor<5x128x2xi16>
    check.compare<@private_vector_updates, @private_vector_updates_oracle>(%input, %output) : (tensor<128x2xi16>, tensor<5x128x2xi16>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<128x2xi16>
      check.expect.bitwise actual(%output) expected(%output) : tensor<5x128x2xi16>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(1) : tensor<128x2xi16>
    %output = check.generate.fill value(0) : tensor<5x128x2xi16>
    check.compare<@private_vector_updates, @private_vector_updates_oracle>(%input, %output) : (tensor<128x2xi16>, tensor<5x128x2xi16>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<128x2xi16>
      check.expect.bitwise actual(%output) expected(%output) : tensor<5x128x2xi16>
    }
  }
  check.return
}

// The returned value keeps a signaling NaN payload while number-preferring
// arithmetic stores the finite operand. The update is an immediate half.
kernel.def @private_half_number() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 2 : offset
  %storage = buffer.alloca<private> align(2) %bytes : buffer
  %cell = buffer.view %storage[%origin] : buffer -> view<1xf16>
  %source = buffer.view %input[%origin] : buffer -> view<1xi16>
  %results = buffer.view %output[%origin] : buffer -> view<2xi16>
  %bits = view.load %source[0] : view<1xi16> -> i16
  %initial = scalar.bitcast %bits : i16 to f16
  %update = scalar.constant 1.0 : f16
  view.store %initial, %cell[0] : f16, view<1xf16>
  %old = view.atomic.rmw<minnumf> %update, %cell[0] {ordering = relaxed, scope = device} : f16, view<1xf16> -> f16
  %final = view.load %cell[0] : view<1xf16> -> f16
  %old_bits = scalar.bitcast %old : f16 to i16
  %final_bits = scalar.bitcast %final : f16 to i16
  view.store %old_bits, %results[0] : i16, view<2xi16>
  view.store %final_bits, %results[1] : i16, view<2xi16>
  kernel.return
}

func.def @private_half_number_oracle(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %source = buffer.view %input[%origin] : buffer -> view<1xi16>
  %results = buffer.view %output[%origin] : buffer -> view<2xi16>
  %bits = view.load %source[0] : view<1xi16> -> i16
  %initial = scalar.bitcast %bits : i16 to f16
  %update = scalar.constant 1.0 : f16
  %final = scalar.minnumf %initial, %update : f16
  %final_bits = scalar.bitcast %final : f16 to i16
  view.store %bits, %results[0] : i16, view<2xi16>
  view.store %final_bits, %results[1] : i16, view<2xi16>
  func.return
}

check.scenario @private_half_number_values {
  check.trial[16](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-32768 to 32767) : tensor<1xi16>
    %output = check.generate.fill value(0) : tensor<2xi16>
    check.compare<@private_half_number, @private_half_number_oracle>(%input, %output) : (tensor<1xi16>, tensor<2xi16>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<1xi16>
      check.expect.bitwise actual(%output) expected(%output) : tensor<2xi16>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(31745) : tensor<1xi16>
    %output = check.generate.fill value(0) : tensor<2xi16>
    check.compare<@private_half_number, @private_half_number_oracle>(%input, %output) : (tensor<1xi16>, tensor<2xi16>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<1xi16>
      check.expect.bitwise actual(%output) expected(%output) : tensor<2xi16>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(1) : tensor<1xi16>
    %output = check.generate.fill value(0) : tensor<2xi16>
    check.compare<@private_half_number, @private_half_number_oracle>(%input, %output) : (tensor<1xi16>, tensor<2xi16>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<1xi16>
      check.expect.bitwise actual(%output) expected(%output) : tensor<2xi16>
    }
  }
  check.return
}

// Every FP8 bit pattern participates in both successful and failed comparisons.
// Independently loaded expected bits keep the comparison live after promotion;
// signed zeros and NaNs compare by representation, without conversion.
kernel.def @private_float8_compare() {
  %unit = index.constant 1 : index
  %width = index.constant 256 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %comparisons: buffer, %choice: i32, %output: buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 2 : offset
  %storage = buffer.alloca<private> align(1) %bytes : buffer
  %source = buffer.view %input[%origin] : buffer -> view<256xi8>
  %expected_source = buffer.view %comparisons[%origin] : buffer -> view<256xi8>
  %results = buffer.view %output[%origin] : buffer -> view<6x256xi8>
  // Adjacent invocations alternate between the matching and nonmatching halves.
  %item = kernel.workitem.id<x> : index
  %pair_width = index.constant 2 : index
  %half_width = index.constant 128 : index
  %pair = index.div %item, %pair_width : index
  %parity = index.rem %item, %pair_width : index
  %half = index.mul %parity, %half_width : index
  %lane = index.add %pair, %half : index
  %initial_bits = view.load %source[%lane] : view<256xi8> -> i8
  %expected_bits = view.load %expected_source[%lane] : view<256xi8> -> i8
  %threshold = scalar.constant 0 : i32
  %condition = scalar.cmpi ne, %choice, %threshold : i32
  %offset_f8e4m3 = index.constant 0 : offset
  %cell_f8e4m3 = buffer.view %storage[%offset_f8e4m3] : buffer -> view<1xf8E4M3>
  %initial_f8e4m3 = scalar.bitcast %initial_bits : i8 to f8E4M3
  %expected_f8e4m3 = scalar.bitcast %expected_bits : i8 to f8E4M3
  %replacement_f8e4m3 = scalar.constant 1.0 : f8E4M3
  view.store %initial_f8e4m3, %cell_f8e4m3[0] : f8E4M3, view<1xf8E4M3>
  %old_f8e4m3 = view.atomic.cmpxchg %expected_f8e4m3, %replacement_f8e4m3, %cell_f8e4m3[0] {failure_ordering = acquire, scope = system, success_ordering = acq_rel} : f8E4M3, view<1xf8E4M3> -> f8E4M3
  %final_f8e4m3 = view.load %cell_f8e4m3[0] : view<1xf8E4M3> -> f8E4M3
  %selected_f8e4m3 = scf.select %condition, %initial_f8e4m3, %replacement_f8e4m3 : f8E4M3
  %old_f8e4m3_bits = scalar.bitcast %old_f8e4m3 : f8E4M3 to i8
  view.store %old_f8e4m3_bits, %results[0, %lane] : i8, view<6x256xi8>
  %final_f8e4m3_bits = scalar.bitcast %final_f8e4m3 : f8E4M3 to i8
  view.store %final_f8e4m3_bits, %results[1, %lane] : i8, view<6x256xi8>
  %selected_f8e4m3_bits = scalar.bitcast %selected_f8e4m3 : f8E4M3 to i8
  view.store %selected_f8e4m3_bits, %results[2, %lane] : i8, view<6x256xi8>
  %offset_f8e5m2 = index.constant 1 : offset
  %cell_f8e5m2 = buffer.view %storage[%offset_f8e5m2] : buffer -> view<1xf8E5M2>
  %initial_f8e5m2 = scalar.bitcast %initial_bits : i8 to f8E5M2
  %expected_f8e5m2 = scalar.bitcast %expected_bits : i8 to f8E5M2
  %replacement_f8e5m2 = scalar.constant 1.0 : f8E5M2
  view.store %initial_f8e5m2, %cell_f8e5m2[0] : f8E5M2, view<1xf8E5M2>
  %old_f8e5m2 = view.atomic.cmpxchg %expected_f8e5m2, %replacement_f8e5m2, %cell_f8e5m2[0] {failure_ordering = acquire, scope = system, success_ordering = acq_rel} : f8E5M2, view<1xf8E5M2> -> f8E5M2
  %final_f8e5m2 = view.load %cell_f8e5m2[0] : view<1xf8E5M2> -> f8E5M2
  %selected_f8e5m2 = scf.select %condition, %initial_f8e5m2, %replacement_f8e5m2 : f8E5M2
  %old_f8e5m2_bits = scalar.bitcast %old_f8e5m2 : f8E5M2 to i8
  view.store %old_f8e5m2_bits, %results[3, %lane] : i8, view<6x256xi8>
  %final_f8e5m2_bits = scalar.bitcast %final_f8e5m2 : f8E5M2 to i8
  view.store %final_f8e5m2_bits, %results[4, %lane] : i8, view<6x256xi8>
  %selected_f8e5m2_bits = scalar.bitcast %selected_f8e5m2 : f8E5M2 to i8
  view.store %selected_f8e5m2_bits, %results[5, %lane] : i8, view<6x256xi8>
  kernel.return
}

func.def @private_float8_compare_oracle(%input: buffer, %comparisons: buffer, %choice: i32, %output: buffer) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 256 : index
  %step = index.constant 1 : index
  %source = buffer.view %input[%origin] : buffer -> view<256xi8>
  %expected_source = buffer.view %comparisons[%origin] : buffer -> view<256xi8>
  %results = buffer.view %output[%origin] : buffer -> view<6x256xi8>
  %threshold = scalar.constant 0 : i32
  %replacement_e4 = scalar.constant 56 : i8
  %replacement_e5 = scalar.constant 60 : i8
  %choose_initial = scalar.cmpi ne, %choice, %threshold : i32
  scf.for %lane = [%begin to %end step %step] {
    %initial = view.load %source[%lane] : view<256xi8> -> i8
    %expected = view.load %expected_source[%lane] : view<256xi8> -> i8
    %matches = scalar.cmpi eq, %initial, %expected : i8
    %final_e4 = scf.select %matches, %replacement_e4, %initial : i8
    %selected_e4 = scf.select %choose_initial, %initial, %replacement_e4 : i8
    %final_e5 = scf.select %matches, %replacement_e5, %initial : i8
    %selected_e5 = scf.select %choose_initial, %initial, %replacement_e5 : i8
    view.store %initial, %results[0, %lane] : i8, view<6x256xi8>
    view.store %final_e4, %results[1, %lane] : i8, view<6x256xi8>
    view.store %selected_e4, %results[2, %lane] : i8, view<6x256xi8>
    view.store %initial, %results[3, %lane] : i8, view<6x256xi8>
    view.store %final_e5, %results[4, %lane] : i8, view<6x256xi8>
    view.store %selected_e5, %results[5, %lane] : i8, view<6x256xi8>
  }
  func.return
}

check.scenario @private_float8_compare_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-128) step(1) : tensor<256xi8>
    %comparisons = check.generate.iota offset(-128) step(1) period(128) : tensor<256xi8>
    %choice = check.literal value(1) : i32
    %output = check.generate.fill value(-85) : tensor<6x256xi8>
    check.compare<@private_float8_compare, @private_float8_compare_oracle>(%input, %comparisons, %choice, %output) : (tensor<256xi8>, tensor<256xi8>, i32, tensor<6x256xi8>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<256xi8>
      check.expect.bitwise actual(%comparisons) expected(%comparisons) : tensor<256xi8>
      check.expect.bitwise actual(%output) expected(%output) : tensor<6x256xi8>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-128) step(1) : tensor<256xi8>
    %comparisons = check.generate.iota offset(0) step(1) period(128) : tensor<256xi8>
    %choice = check.literal value(0) : i32
    %output = check.generate.fill value(-85) : tensor<6x256xi8>
    check.compare<@private_float8_compare, @private_float8_compare_oracle>(%input, %comparisons, %choice, %output) : (tensor<256xi8>, tensor<256xi8>, i32, tensor<6x256xi8>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<256xi8>
      check.expect.bitwise actual(%comparisons) expected(%comparisons) : tensor<256xi8>
      check.expect.bitwise actual(%output) expected(%output) : tensor<6x256xi8>
    }
  }
  check.return
}

// Narrow extrema preserve old NaN payloads and gradual underflow. Each
// minimum-subnormal input must survive a minimum with the immediate 1.0.
kernel.def @private_bf16_number() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %bytes = index.constant 2 : offset
  %storage = buffer.alloca<private> align(2) %bytes : buffer
  %cell = buffer.view %storage[%origin] : buffer -> view<1xbf16>
  %source = buffer.view %input[%origin] : buffer -> view<1xi16>
  %results = buffer.view %output[%origin] : buffer -> view<2xi16>
  %bits = view.load %source[0] : view<1xi16> -> i16
  %initial = scalar.bitcast %bits : i16 to bf16
  %update = scalar.constant 1.0 : bf16
  view.store %initial, %cell[0] : bf16, view<1xbf16>
  %old = view.atomic.rmw<minnumf> %update, %cell[0] {ordering = relaxed, scope = device} : bf16, view<1xbf16> -> bf16
  %final = view.load %cell[0] : view<1xbf16> -> bf16
  %old_bits = scalar.bitcast %old : bf16 to i16
  %final_bits = scalar.bitcast %final : bf16 to i16
  view.store %old_bits, %results[0] : i16, view<2xi16>
  view.store %final_bits, %results[1] : i16, view<2xi16>
  kernel.return
}

func.def @private_bf16_number_oracle(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %source = buffer.view %input[%origin] : buffer -> view<1xi16>
  %results = buffer.view %output[%origin] : buffer -> view<2xi16>
  %bits = view.load %source[0] : view<1xi16> -> i16
  %initial = scalar.bitcast %bits : i16 to bf16
  %update = scalar.constant 1.0 : bf16
  %final = scalar.minnumf %initial, %update : bf16
  %final_bits = scalar.bitcast %final : bf16 to i16
  view.store %bits, %results[0] : i16, view<2xi16>
  view.store %final_bits, %results[1] : i16, view<2xi16>
  func.return
}

