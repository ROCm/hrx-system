// Only one source element exists. A dynamic mask selects the first load while
// the absent second element always comes from the passthrough value.
func.def @masked_tail_load(%active: i1, %value: i32, %old: i32) -> (i32, i32) {
  %length = index.constant 4 : offset
  %base = index.constant 0 : offset
  %storage = buffer.alloca<private> align(4) %length : buffer
  %view = buffer.view %storage[%base] : buffer -> view<1xi32>
  view.store %value, %view[0] : i32, view<1xi32>
  %inactive = scalar.constant false : i1
  %mask = vector.from_elements %active, %inactive : vector<2xi1>
  %passthrough = vector.splat %old : vector<2xi32>
  %loaded = vector.load.mask %view[0], %mask, %passthrough : view<1xi32>, vector<2xi1>, vector<2xi32>
  %first = vector.extract %loaded[0] : vector<2xi32> -> i32
  %second = vector.extract %loaded[1] : vector<2xi32> -> i32
  func.return %first, %second : i32, i32
}

// The target view ends before the adjacent canary. Inactive lanes neither
// write past that view nor change the initialized first element.
func.def @masked_tail_store(%active: i1, %value: i32) -> (i32, i32) {
  %length = index.constant 8 : offset
  %base = index.constant 0 : offset
  %storage = buffer.alloca<private> align(4) %length : buffer
  %all = buffer.view %storage[%base] : buffer -> view<2xi32>
  %target = buffer.view %storage[%base] : buffer -> view<1xi32>
  %initial = scalar.constant 19 : i32
  %canary = scalar.constant 91 : i32
  view.store %initial, %all[0] : i32, view<2xi32>
  view.store %canary, %all[1] : i32, view<2xi32>
  %inactive = scalar.constant false : i1
  %mask = vector.from_elements %active, %inactive : vector<2xi1>
  %values = vector.splat %value : vector<2xi32>
  vector.store.mask %values, %target[0], %mask : vector<2xi32>, view<1xi32>, vector<2xi1>
  %first = view.load %all[0] : view<2xi32> -> i32
  %second = view.load %all[1] : view<2xi32> -> i32
  func.return %first, %second : i32, i32
}

// No element exists at this origin, but an all-false mask performs no access.
func.def @masked_empty_view(%value: i32) -> (i32, i32) {
  %length = index.constant 0 : offset
  %storage = buffer.alloca<private> align(4) %length : buffer
  %view = buffer.view %storage[%length] : buffer -> view<0xi32>
  %mask = vector.constant false : vector<2xi1>
  %values = vector.splat %value : vector<2xi32>
  vector.store.mask %values, %view[7], %mask : vector<2xi32>, view<0xi32>, vector<2xi1>
  %loaded = vector.load.mask %view[7], %mask, %values : view<0xi32>, vector<2xi1>, vector<2xi32>
  %first = vector.extract %loaded[0] : vector<2xi32> -> i32
  %second = vector.extract %loaded[1] : vector<2xi32> -> i32
  func.return %first, %second : i32, i32
}

// Two active lanes of a four-lane vector consume two compact memory elements.
// Checking the expanded lanes separately prevents inverse errors in expansion
// and compression from canceling each other in the round trip.
func.def @compact_masked_memory(%left: i32, %right: i32, %old: i32) -> (i32, i32, i32, i32, i32, i32) {
  %length = index.constant 8 : offset
  %base = index.constant 0 : offset
  %input = buffer.alloca<private> align(4) %length : buffer
  %output = buffer.alloca<private> align(4) %length : buffer
  %source = buffer.view %input[%base] : buffer -> view<2xi32>
  %target = buffer.view %output[%base] : buffer -> view<2xi32>
  view.store %left, %source[0] : i32, view<2xi32>
  view.store %right, %source[1] : i32, view<2xi32>
  %active = scalar.constant true : i1
  %inactive = scalar.constant false : i1
  %mask = vector.from_elements %inactive, %active, %inactive, %active : vector<4xi1>
  %passthrough = vector.splat %old : vector<4xi32>
  %loaded = vector.load.expand %source[0], %mask, %passthrough : view<2xi32>, vector<4xi1>, vector<4xi32>
  %lane0 = vector.extract %loaded[0] : vector<4xi32> -> i32
  %lane1 = vector.extract %loaded[1] : vector<4xi32> -> i32
  %lane2 = vector.extract %loaded[2] : vector<4xi32> -> i32
  %lane3 = vector.extract %loaded[3] : vector<4xi32> -> i32
  vector.store.compress %loaded, %target[0], %mask : vector<4xi32>, view<2xi32>, vector<4xi1>
  %first = view.load %target[0] : view<2xi32> -> i32
  %second = view.load %target[1] : view<2xi32> -> i32
  func.return %lane0, %lane1, %lane2, %lane3, %first, %second : i32, i32, i32, i32, i32, i32
}

func.def @masked_memory_observations(%ordinal: index, %left_entropy: i64, %right_entropy: i64, %old_entropy: i64, %output: buffer) {
  %c0 = index.constant 0 : index
  %active = index.cmp ne, %ordinal, %c0 : index
  %left = scalar.trunci %left_entropy : i64 to i32
  %right = scalar.trunci %right_entropy : i64 to i32
  %old = scalar.trunci %old_entropy : i64 to i32
  %load0, %load1 = func.call @masked_tail_load(%active, %left, %old) : (i1, i32, i32) -> (i32, i32)
  %store0, %store1 = func.call @masked_tail_store(%active, %left) : (i1, i32) -> (i32, i32)
  %empty0, %empty1 = func.call @masked_empty_view(%old) : (i32) -> (i32, i32)
  %lane0, %lane1, %lane2, %lane3, %compact0, %compact1 = func.call @compact_masked_memory(%left, %right, %old) : (i32, i32, i32) -> (i32, i32, i32, i32, i32, i32)
  %values = vector.from_elements %load0, %load1, %store0, %store1, %empty0, %empty1, %lane0, %lane1, %lane2, %lane3, %compact0, %compact1 : vector<12xi32>
  %origin = index.constant 0 : offset
  %results = buffer.view %output[%origin] : buffer -> view<12xi32>
  vector.store %values, %results[0] : vector<12xi32>, view<12xi32>
  func.return
}

check.scenario @masked_memory_values {
  check.trial[32](%trial: index, %entropy: check.entropy) {
    %left_source = check.entropy.fork %entropy name("left") : check.entropy
    %right_source = check.entropy.fork %entropy name("right") : check.entropy
    %old_source = check.entropy.fork %entropy name("old") : check.entropy
    %left = check.entropy.read %left_source[%trial] : check.entropy -> i64
    %right = check.entropy.read %right_source[%trial] : check.entropy -> i64
    %old = check.entropy.read %old_source[%trial] : check.entropy -> i64
    %output = check.generate.fill value(0) : tensor<12xi32>
    check.compare<@masked_memory_observations>(%trial, %left, %right, %old, %output) : (index, i64, i64, i64, tensor<12xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<12xi32>
    }
  }
  check.return
}

// Complete packets need no lane predicates even when the logical view has a
// partial tail. Elements outside the complete packets retain their canaries.
func.def @counted_masked_packets(%ordinal: index, %input: buffer, %output: buffer) {
  %trial = index.assume %ordinal [range(%ordinal, 0, 63)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %packet_width = index.constant 4 : index
  %minimum_extent = index.constant 16 : index
  %extent = index.add %trial, %minimum_extent : index
  %count = index.div %extent, %packet_width : index
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<[%extent]xi32>
  %target = buffer.view %output[%base] : buffer -> view<80xi32>
  %fallback = vector.constant -1 : vector<4xi32>
  scf.for %packet = [%c0 to %count step %c1] {
    %origin = index.mul %packet, %packet_width : index
    %mask = vector.mask.range [%origin to %extent step %c1] : index -> vector<4xi1>
    %value = vector.load.mask %source[%origin], %mask, %fallback : view<[%extent]xi32>, vector<4xi1>, vector<4xi32>
    vector.store %value, %target[%origin] : vector<4xi32>, view<80xi32>
  }
  func.return
}

func.def @counted_masked_packets_oracle(%ordinal: index, %input: buffer, %output: buffer) {
  %trial = index.assume %ordinal [range(%ordinal, 0, 63)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %packet_width = index.constant 4 : index
  %minimum_extent = index.constant 16 : index
  %extent = index.add %trial, %minimum_extent : index
  %tail = index.rem %extent, %packet_width : index
  %end = index.sub %extent, %tail : index
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<80xi32>
  %target = buffer.view %output[%base] : buffer -> view<80xi32>
  scf.for %element = [%c0 to %end step %c1] {
    %value = view.load %source[%element] : view<80xi32> -> i32
    view.store %value, %target[%element] : i32, view<80xi32>
  }
  func.return
}

check.scenario @counted_packet_masks {
  check.trial[64](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-137) step(13) : tensor<80xi32>
    %output = check.generate.fill value(91) : tensor<80xi32>
    check.compare<@counted_masked_packets, @counted_masked_packets_oracle>(%trial, %input, %output) : (index, tensor<80xi32>, tensor<80xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<80xi32>
    }
  }
  check.return
}

// Every element shares a runtime predicate. Inactive packets point beyond both
// views, take distinct passthrough values, and leave the written buffer intact.
func.def @uniform_masked_packets(%ordinal: index, %input: buffer, %previous: buffer, %output: buffer, %written: buffer) {
  %c0 = index.constant 0 : index
  %past_end = index.constant 4 : index
  %active = index.cmp eq, %ordinal, %c0 : index
  %position = scf.select %active, %c0, %past_end : index
  %mask = vector.splat %active : vector<4xi1>
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<4xi32>
  %old = buffer.view %previous[%base] : buffer -> view<4xi32>
  %results = buffer.view %output[%base] : buffer -> view<4xi32>
  %destination = buffer.view %written[%base] : buffer -> view<4xi32>
  %passthrough = vector.load %old[0] : view<4xi32> -> vector<4xi32>
  %value = vector.load.mask %source[%position], %mask, %passthrough : view<4xi32>, vector<4xi1>, vector<4xi32>
  vector.store %value, %results[0] : vector<4xi32>, view<4xi32>
  vector.store.mask %value, %destination[%position], %mask : vector<4xi32>, view<4xi32>, vector<4xi1>
  func.return
}

// Whole-buffer copies establish the expected bytes independently of vector
// mask lowering and the deliberately inaccessible inactive packet positions.
func.def @uniform_masked_packets_oracle(%ordinal: index, %input: buffer, %previous: buffer, %output: buffer, %written: buffer) {
  %c0 = index.constant 0 : index
  %active = index.cmp eq, %ordinal, %c0 : index
  %base = index.constant 0 : offset
  %length = index.constant 16 : offset
  scf.if %active {
    buffer.copy %input[%base], %output[%base], %length
    buffer.copy %input[%base], %written[%base], %length
  } else {
    buffer.copy %previous[%base], %output[%base], %length
  }
  func.return
}

check.scenario @uniform_packet_masks {
  check.trial[2](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(13) step(17) : tensor<4xi32>
    %previous = check.generate.iota offset(-37) step(3) : tensor<4xi32>
    %output = check.generate.fill value(91) : tensor<4xi32>
    %written = check.generate.fill value(19) : tensor<4xi32>
    check.compare<@uniform_masked_packets, @uniform_masked_packets_oracle>(%trial, %input, %previous, %output, %written) : (index, tensor<4xi32>, tensor<4xi32>, tensor<4xi32>, tensor<4xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<4xi32>
      check.expect.bitwise actual(%previous) expected(%previous) : tensor<4xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi32>
      check.expect.bitwise actual(%written) expected(%written) : tensor<4xi32>
    }
  }
  check.return
}
