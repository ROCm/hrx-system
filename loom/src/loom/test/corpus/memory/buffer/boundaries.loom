// A partial pattern repeats its little-endian bytes. Adjacent canaries and
// independent byte observations detect both overrun and wrong tail handling.
// Copying disjoint ranges of one root is legal; overlapping ranges are not.
func.def @partial_pattern_copy(%pattern: i32) -> (i32, i32, i32, i32, i32, i32, i32, i32) {
  %c0 = index.constant 0 : offset
  %c1 = index.constant 1 : offset
  %c2 = index.constant 2 : offset
  %c3 = index.constant 3 : offset
  %c5 = index.constant 5 : offset
  %c6 = index.constant 6 : offset
  %c10 = index.constant 10 : offset
  %c11 = index.constant 11 : offset
  %length = index.constant 12 : offset
  %storage = buffer.alloca<private> align(4) %length : buffer
  %canary = scalar.constant 85 : i8
  buffer.fill %canary, %storage[%c0], %length : i8
  buffer.fill %pattern, %storage[%c0], %c5 : i32
  %byte0 = buffer.load.i8.u %storage[%c0]
  %byte1 = buffer.load.i8.u %storage[%c1]
  %byte2 = buffer.load.i8.u %storage[%c2]
  %byte3 = buffer.load.i8.u %storage[%c3]
  buffer.copy %storage[%c0], %storage[%c6], %c5
  %replacement = scalar.constant 0 : i32
  buffer.store.i8 %replacement, %storage[%c0]
  %copied_first = buffer.load.i8.u %storage[%c6]
  %copied_last = buffer.load.i8.u %storage[%c10]
  %middle_canary = buffer.load.i8.u %storage[%c5]
  %last_canary = buffer.load.i8.u %storage[%c11]
  func.return %byte0, %byte1, %byte2, %byte3, %copied_first, %copied_last, %middle_canary, %last_canary : i32, i32, i32, i32, i32, i32, i32, i32
}

// Only the final byte differs. Lexicographic order is unsigned and canonical,
// while signed and unsigned interpretations retain their distinct meanings.
func.def @last_byte_order(%a: i32, %b: i32) -> (i32, i32, i32, i32) {
  %c0 = index.constant 0 : offset
  %last = index.constant 4 : offset
  %length = index.constant 5 : offset
  %left = buffer.alloca<private> align(1) %length : buffer
  %right = buffer.alloca<private> align(1) %length : buffer
  %prefix = scalar.constant 42 : i8
  buffer.fill %prefix, %left[%c0], %length : i8
  buffer.fill %prefix, %right[%c0], %length : i8
  buffer.store.i8 %a, %left[%last]
  buffer.store.i8 %b, %right[%last]
  %forward = buffer.compare %left[%c0], %right[%c0], %length
  %reverse = buffer.compare %right[%c0], %left[%c0], %length
  %unsigned = buffer.load.i8.u %left[%last]
  %narrow = scalar.trunci %unsigned : i32 to i8
  %signed = scalar.extsi %narrow : i8 to i32
  func.return %forward, %reverse, %signed, %unsigned : i32, i32, i32, i32
}

// The invalid address belongs to a non-taken branch and must never be read.
func.def @guarded_byte_load(%position: i64) -> (i32) {
  %c0 = index.constant 0 : offset
  %length = index.constant 1 : offset
  %storage = buffer.alloca<private> align(1) %length : buffer
  %payload = scalar.constant 55 : i32
  buffer.store.i8 %payload, %storage[%c0]
  %limit = scalar.constant 1 : i64
  %in_bounds = scalar.cmpi ult, %position, %limit : i64
  %result = scf.if %in_bounds -> (i32) {
    %offset = index.cast %position : i64 to offset
    %byte = buffer.load.i8.u %storage[%offset]
    scf.yield %byte : i32
  } else {
    %other = scalar.constant 77 : i32
    scf.yield %other : i32
  }
  func.return %result : i32
}

// Combining these reads must preserve their snapshot before the overlapping
// overwrite. Observing raw bits covers signed zero, subnormals and NaN payloads.
func.def @adjacent_half_snapshot(%left_bits: i32, %right_bits: i32, %overwrite: i32) -> (i32, i32, i32) {
  %byte_base = index.constant 0 : offset
  %length = index.constant 4 : offset
  %storage = buffer.alloca<private> align(4) %length : buffer
  %integer_view = buffer.view %storage[%byte_base] : buffer -> view<2xi16>
  %left_value = scalar.trunci %left_bits : i32 to i16
  %right_value = scalar.trunci %right_bits : i32 to i16
  view.store %left_value, %integer_view[0] : i16, view<2xi16>
  view.store %right_value, %integer_view[1] : i16, view<2xi16>
  %view = buffer.view %storage[%byte_base] : buffer -> view<2xf16>
  %wide_view = buffer.view %storage[%byte_base] : buffer -> view<1xi32>
  %left = view.load %view[0] : view<2xf16> -> f16
  %right = view.load %view[1] : view<2xf16> -> f16
  view.store %overwrite, %wide_view[0] : i32, view<1xi32>
  %left_raw = scalar.bitcast %left : f16 to i16
  %right_raw = scalar.bitcast %right : f16 to i16
  %left_result = scalar.extui %left_raw : i16 to i32
  %right_result = scalar.extui %right_raw : i16 to i32
  %after = view.load %wide_view[0] : view<1xi32> -> i32
  func.return %left_result, %right_result, %after : i32, i32, i32
}

func.def @vector_input_buffer(%a: i32, %b: i32, %c: i32, %d: i32) -> (buffer) {
  %length = index.constant 24 : offset
  %origin = index.constant 0 : offset
  %storage = buffer.alloca<private> align(4) %length : buffer
  %view = buffer.view %storage[%origin] : buffer -> view<6xi32>
  %sentinel = scalar.constant 12345 : i32
  view.store %sentinel, %view[0] : i32, view<6xi32>
  view.store %a, %view[1] : i32, view<6xi32>
  view.store %b, %view[2] : i32, view<6xi32>
  view.store %c, %view[3] : i32, view<6xi32>
  view.store %d, %view[4] : i32, view<6xi32>
  view.store %sentinel, %view[5] : i32, view<6xi32>
  func.return %storage : buffer
}

// Loads skip the leading canary. Unequal lanes distinguish concat/shuffle order;
// stores overwrite exactly the middle four words, preserving both canaries.
func.def @vector_memory_transform(%storage: buffer, %bias: i32) -> (i32, i32, i32, i32, i32, i32) {
  %origin = index.constant 0 : offset
  %view = buffer.view %storage[%origin] : buffer -> view<6xi32>
  %loaded = vector.load %view[1] : view<6xi32> -> vector<4xi32>
  %reverse = vector.shuffle<[3, 2, 1, 0]> %loaded : vector<4xi32>
  %head = vector.slice %reverse[0] : vector<4xi32> -> vector<2xi32>
  %tail = vector.slice %reverse[2] : vector<4xi32> -> vector<2xi32>
  %rotated = vector.concat<0> %tail, %head : vector<2xi32>, vector<2xi32> -> vector<4xi32>
  %biases = vector.splat %bias : vector<4xi32>
  %result = vector.addi %rotated, %biases : vector<4xi32>
  vector.store %result, %view[1] : vector<4xi32>, view<6xi32>
  %before = view.load %view[0] : view<6xi32> -> i32
  %r0 = view.load %view[1] : view<6xi32> -> i32
  %r1 = view.load %view[2] : view<6xi32> -> i32
  %r2 = view.load %view[3] : view<6xi32> -> i32
  %r3 = view.load %view[4] : view<6xi32> -> i32
  %after = view.load %view[5] : view<6xi32> -> i32
  func.return %before, %r0, %r1, %r2, %r3, %after : i32, i32, i32, i32, i32, i32
}

// The scalar write happens after the vector snapshot and cannot change it.
func.def @vector_snapshot_before_write(%storage: buffer, %replacement: i32) -> (i32, i32) {
  %origin = index.constant 0 : offset
  %view = buffer.view %storage[%origin] : buffer -> view<6xi32>
  %loaded = vector.load %view[1] : view<6xi32> -> vector<2xi32>
  view.store %replacement, %view[2] : i32, view<6xi32>
  %swapped = vector.shuffle<[1, 0]> %loaded : vector<2xi32>
  vector.store %swapped, %view[1] : vector<2xi32>, view<6xi32>
  %a = view.load %view[1] : view<6xi32> -> i32
  %b = view.load %view[2] : view<6xi32> -> i32
  func.return %a, %b : i32, i32
}

// Writing the first payload must not change the second lane's captured mask.
func.def @store_mask_snapshot(%first_mask: i32, %second_mask: i32, %a: i32, %b: i32) -> (i32, i32) {
  %length = index.constant 12 : offset
  %base = index.constant 0 : offset
  %storage = buffer.alloca<private> align(4) %length : buffer
  %view = buffer.view %storage[%base] : buffer -> view<3xi32>
  %canary = scalar.constant 55 : i32
  view.store %first_mask, %view[0] : i32, view<3xi32>
  view.store %second_mask, %view[1] : i32, view<3xi32>
  view.store %canary, %view[2] : i32, view<3xi32>
  %loaded = vector.load %view[0] : view<3xi32> -> vector<2xi32>
  %c0 = scalar.constant 0 : i32
  %zeros = vector.splat %c0 : vector<2xi32>
  %mask = vector.cmpi ne, %loaded, %zeros : vector<2xi32> -> vector<2xi1>
  %values = vector.from_elements %a, %b : vector<2xi32>
  vector.store.mask %values, %view[1], %mask : vector<2xi32>, view<3xi32>, vector<2xi1>
  %left = view.load %view[1] : view<3xi32> -> i32
  %right = view.load %view[2] : view<3xi32> -> i32
  func.return %left, %right : i32, i32
}

// Offsets [1, 0] swap the destinations. The first write overwrites the second
// offset's storage, but must not redirect the second write to a canary.
func.def @scatter_offset_snapshot(%a: i32, %b: i32) -> (i32, i32, i32, i32) {
  %length = index.constant 16 : offset
  %base = index.constant 0 : offset
  %storage = buffer.alloca<private> align(4) %length : buffer
  %view = buffer.view %storage[%base] : buffer -> view<4xi32>
  %c1 = scalar.constant 1 : i32
  %c0 = scalar.constant 0 : i32
  %canary = scalar.constant 55 : i32
  view.store %c1, %view[0] : i32, view<4xi32>
  view.store %c0, %view[1] : i32, view<4xi32>
  view.store %canary, %view[2] : i32, view<4xi32>
  view.store %canary, %view[3] : i32, view<4xi32>
  %offsets = vector.load %view[0] : view<4xi32> -> vector<2xi32>
  %offset_mask = scalar.constant 3 : i32
  %offset_masks = vector.splat %offset_mask : vector<2xi32>
  %bounded_offsets = vector.andi %offsets, %offset_masks : vector<2xi32>
  %values = vector.from_elements %a, %b : vector<2xi32>
  vector.scatter %values, %view[0][%bounded_offsets] : vector<2xi32>, view<4xi32>, vector<2xi32>
  %left = view.load %view[0] : view<4xi32> -> i32
  %right = view.load %view[1] : view<4xi32> -> i32
  %after0 = view.load %view[2] : view<4xi32> -> i32
  %after1 = view.load %view[3] : view<4xi32> -> i32
  func.return %left, %right, %after0, %after1 : i32, i32, i32, i32
}

func.def noinline @overwrite_lane(%storage: buffer, %value: i32) {
  %position = index.constant 0 : offset
  %view = buffer.view %storage[%position] : buffer -> view<2xi32>
  view.store %value, %view[1] : i32, view<2xi32>
  func.return
}

func.def @captured_lane(%a: i32, %b: i32, %replacement: i32) -> (i32, i32, i32) {
  %length = index.constant 8 : offset
  %base = index.constant 0 : offset
  %storage = buffer.alloca<private> align(4) %length : buffer
  %view = buffer.view %storage[%base] : buffer -> view<2xi32>
  view.store %a, %view[0] : i32, view<2xi32>
  view.store %b, %view[1] : i32, view<2xi32>
  %captured = vector.load %view[0] : view<2xi32> -> vector<2xi32>
  func.call @overwrite_lane(%storage, %replacement) : (buffer, i32)
  %left = vector.extract %captured[0] : vector<2xi32> -> i32
  %right = vector.extract %captured[1] : vector<2xi32> -> i32
  %after = view.load %view[1] : view<2xi32> -> i32
  func.return %left, %right, %after : i32, i32, i32
}

func.def @byte_boundary_observations(%ordinal: index, %left_entropy: i64, %right_entropy: i64, %output: buffer) {
  %random_pattern = scalar.trunci %left_entropy : i64 to i32
  %c0 = index.constant 0 : index
  %is0 = index.cmp eq, %ordinal, %c0 : index
  %fixed_pattern = scalar.constant 305419896 : i32
  %pattern = scf.select %is0, %fixed_pattern, %random_pattern : i32
  %byte0, %byte1, %byte2, %byte3, %copied_first, %copied_last, %middle_canary, %last_canary = func.call @partial_pattern_copy(%pattern) : (i32) -> (i32, i32, i32, i32, i32, i32, i32, i32)
  %last_a = scalar.constant -1 : i32
  %last_b = scalar.constant 127 : i32
  %forward, %reverse, %signed, %unsigned = func.call @last_byte_order(%last_a, %last_b) : (i32, i32) -> (i32, i32, i32, i32)
  %c12 = index.constant 12 : index
  %c13 = index.constant 13 : index
  %c14 = index.constant 14 : index
  %is12 = index.cmp eq, %ordinal, %c12 : index
  %is13 = index.cmp eq, %ordinal, %c13 : index
  %is14 = index.cmp eq, %ordinal, %c14 : index
  %base_position = index.cast %ordinal : index to i64
  %position16 = scalar.constant 16 : i64
  %wide_position = scalar.constant 4294967296 : i64
  %negative_position = scalar.constant -1 : i64
  %selected16 = scf.select %is12, %position16, %base_position : i64
  %selected_wide = scf.select %is13, %wide_position, %selected16 : i64
  %position = scf.select %is14, %negative_position, %selected_wide : i64
  %guarded = func.call @guarded_byte_load(%position) : (i64) -> (i32)
  %random_left_bits = scalar.trunci %left_entropy : i64 to i32
  %random_right_bits = scalar.trunci %right_entropy : i64 to i32
  %ordinal_value = index.cast %ordinal : index to i32
  %selector_shift = scalar.constant 1 : i32
  %selector = scalar.shrui %ordinal_value, %selector_shift : i32
  %selector1 = scalar.constant 1 : i32
  %selector2 = scalar.constant 2 : i32
  %selector3 = scalar.constant 3 : i32
  %selector4 = scalar.constant 4 : i32
  %selector5 = scalar.constant 5 : i32
  %is1 = scalar.cmpi eq, %selector, %selector1 : i32
  %is2 = scalar.cmpi eq, %selector, %selector2 : i32
  %is3 = scalar.cmpi eq, %selector, %selector3 : i32
  %is4 = scalar.cmpi eq, %selector, %selector4 : i32
  %is5 = scalar.cmpi eq, %selector, %selector5 : i32
  %left0 = scalar.constant 0 : i32
  %left1 = scalar.constant 32768 : i32
  %left2 = scalar.constant 1 : i32
  %left3 = scalar.constant 31745 : i32
  %left4 = scalar.constant 32257 : i32
  %left5 = scalar.constant 65535 : i32
  %selected_left1 = scf.select %is1, %left1, %left0 : i32
  %selected_left2 = scf.select %is2, %left2, %selected_left1 : i32
  %selected_left3 = scf.select %is3, %left3, %selected_left2 : i32
  %selected_left4 = scf.select %is4, %left4, %selected_left3 : i32
  %directed_left = scf.select %is5, %left5, %selected_left4 : i32
  %is_directed = index.cmp ult, %ordinal, %c12 : index
  %left_bits = scf.select %is_directed, %directed_left, %random_left_bits : i32
  %parity = scalar.andi %ordinal_value, %selector1 : i32
  %even_parity = scalar.constant 0 : i32
  %odd = scalar.cmpi ne, %parity, %even_parity : i32
  %right0 = scalar.constant 15360 : i32
  %right1 = scalar.constant 64512 : i32
  %directed_right = scf.select %odd, %right1, %right0 : i32
  %right_bits = scf.select %is_directed, %directed_right, %random_right_bits : i32
  %overwrite = scalar.constant 305419896 : i32
  %half_left, %half_right, %half_after = func.call @adjacent_half_snapshot(%left_bits, %right_bits, %overwrite) : (i32, i32, i32) -> (i32, i32, i32)
  %values = vector.from_elements %byte0, %byte1, %byte2, %byte3, %copied_first, %copied_last, %middle_canary, %last_canary, %forward, %reverse, %signed, %unsigned, %guarded, %half_left, %half_right, %half_after : vector<16xi32>
  %origin = index.constant 0 : offset
  %results = buffer.view %output[%origin] : buffer -> view<16xi32>
  vector.store %values, %results[0] : vector<16xi32>, view<16xi32>
  func.return
}

func.def @vector_boundary_observations(%ordinal: index, %left_entropy: i64, %right_entropy: i64, %output: buffer) {
  %a = scalar.trunci %left_entropy : i64 to i32
  %b = scalar.trunci %right_entropy : i64 to i32
  %c17 = scalar.constant 17 : i32
  %c29 = scalar.constant 29 : i32
  %c = scalar.addi %a, %c17 : i32
  %d = scalar.subi %b, %c29 : i32
  %bias = scalar.constant 3 : i32
  %transform_storage = func.call @vector_input_buffer(%a, %b, %c, %d) : (i32, i32, i32, i32) -> (buffer)
  %before, %transform0, %transform1, %transform2, %transform3, %after = func.call @vector_memory_transform(%transform_storage, %bias) : (buffer, i32) -> (i32, i32, i32, i32, i32, i32)
  %snapshot_storage = func.call @vector_input_buffer(%a, %b, %c, %d) : (i32, i32, i32, i32) -> (buffer)
  %replacement = scalar.constant 99 : i32
  %snapshot0, %snapshot1 = func.call @vector_snapshot_before_write(%snapshot_storage, %replacement) : (buffer, i32) -> (i32, i32)
  %active_bit = scalar.constant 1 : i32
  %first_mask = scalar.ori %a, %active_bit : i32
  %c0 = index.constant 0 : index
  %second_active = index.cmp ne, %ordinal, %c0 : index
  %second_candidate = scalar.ori %b, %active_bit : i32
  %zero_mask = scalar.constant 0 : i32
  %second_mask = scf.select %second_active, %second_candidate, %zero_mask : i32
  %masked0, %masked1 = func.call @store_mask_snapshot(%first_mask, %second_mask, %a, %b) : (i32, i32, i32, i32) -> (i32, i32)
  %scatter0, %scatter1, %scatter_after0, %scatter_after1 = func.call @scatter_offset_snapshot(%a, %b) : (i32, i32) -> (i32, i32, i32, i32)
  %captured0, %captured1, %captured_after = func.call @captured_lane(%a, %b, %replacement) : (i32, i32, i32) -> (i32, i32, i32)
  %values = vector.from_elements %before, %transform0, %transform1, %transform2, %transform3, %after, %snapshot0, %snapshot1, %masked0, %masked1, %scatter0, %scatter1, %scatter_after0, %scatter_after1, %captured0, %captured1, %captured_after : vector<17xi32>
  %origin = index.constant 0 : offset
  %results = buffer.view %output[%origin] : buffer -> view<17xi32>
  vector.store %values, %results[0] : vector<17xi32>, view<17xi32>
  func.return
}

// Exercise every suffix length across the scalar and vector transfer widths.
// The complete output includes untouched prefix/suffix canaries. Source and
// destination offsets deliberately have different alignment residues.
func.def @copy_exact_range(%input: buffer, %output: buffer, %length: index) {
  %bounded = index.assume %length [range(%length, 0, 129)] : index
  %mask = index.constant 31 : index
  %source_position = index.andi %bounded, %mask : index
  %factor = index.constant 3 : index
  %shift = index.constant 7 : index
  %product = index.madd %bounded, %factor, %shift : index
  %target_position = index.andi %product, %mask : index
  %source_offset = index.cast %source_position : index to offset
  %target_offset = index.cast %target_position : index to offset
  %byte_length = index.cast %bounded : index to offset
  buffer.copy %input[%source_offset], %output[%target_offset], %byte_length
  func.return
}

// Each region exercises one pattern period with every partial repetition and
// destination alignment. Floating-point patterns are compared as raw bytes.
func.def @fill_exact_range(%output: buffer, %length: index, %bits: i64) {
  %bounded = index.assume %length [range(%length, 0, 129)] : index
  %mask = index.constant 31 : index
  %position = index.andi %bounded, %mask : index
  %origin = index.cast %position : index to offset
  %byte_length = index.cast %bounded : index to offset
  %region1 = index.constant 192 : offset
  %region2 = index.constant 384 : offset
  %region3 = index.constant 576 : offset
  %offset1 = index.add %origin, %region1 : offset
  %offset2 = index.add %origin, %region2 : offset
  %offset3 = index.add %origin, %region3 : offset
  %byte = scalar.trunci %bits : i64 to i8
  %half = scalar.trunci %bits : i64 to i16
  %word = scalar.trunci %bits : i64 to i32
  %double = scalar.bitcast %bits : i64 to f64
  buffer.fill %byte, %output[%origin], %byte_length : i8
  buffer.fill %half, %output[%offset1], %byte_length : i16
  buffer.fill %word, %output[%offset2], %byte_length : i32
  buffer.fill %double, %output[%offset3], %byte_length : f64
  func.return
}

// Every byte can be the first mismatch. A later byte has the opposite order,
// so comparing little-endian words numerically would produce the wrong result.
func.def @compare_first_difference(%left_storage: buffer, %right_storage: buffer, %position: index, %output: buffer) {
  %bounded = index.assume %position [range(%position, 0, 129)] : index
  %mismatch = index.cast %bounded : index to offset
  %origin = index.constant 0 : offset
  %length = index.constant 129 : offset
  %last = index.constant 128 : offset
  %left = buffer.assume.alignment %left_storage {minimum_alignment = 4} : buffer
  %right = buffer.assume.alignment %right_storage {minimum_alignment = 4} : buffer
  %pattern = scalar.constant 85 : i8
  buffer.fill %pattern, %left[%origin], %length : i8
  buffer.fill %pattern, %right[%origin], %length : i8
  %differs = index.cmp ult, %mismatch, %length : offset
  scf.if %differs {
    %high = scalar.constant 128 : i32
    %low = scalar.constant 127 : i32
    buffer.store.i8 %high, %left[%mismatch]
    buffer.store.i8 %low, %right[%mismatch]
    %has_suffix = index.cmp ult, %mismatch, %last : offset
    scf.if %has_suffix {
      %c0 = scalar.constant 0 : i32
      %maximum = scalar.constant 255 : i32
      buffer.store.i8 %c0, %left[%last]
      buffer.store.i8 %maximum, %right[%last]
    }
  }
  %forward = buffer.compare %left[%origin], %right[%origin], %length
  %reverse = buffer.compare %right[%origin], %left[%origin], %length
  %prefix = buffer.compare %left[%origin], %right[%origin], %mismatch
  %results = buffer.view %output[%origin] : buffer -> view<3xi32>
  view.store %forward, %results[0] : i32, view<3xi32>
  view.store %reverse, %results[1] : i32, view<3xi32>
  view.store %prefix, %results[2] : i32, view<3xi32>
  func.return
}

// Aligned roots admit word transfers; complete output comparisons retain the
// surrounding canaries as well as the copied and filled payloads.
func.def inline @observe_bulk_length(%input: buffer, %storage: buffer, %length: offset, %pattern: i32, %observations: buffer) {
  %source = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %target = buffer.assume.alignment %storage {minimum_alignment = 4} : buffer
  %origin = index.constant 16 : offset
  %fill_origin = index.constant 272 : offset
  buffer.copy %source[%origin], %target[%origin], %length
  %equal = buffer.compare %source[%origin], %target[%origin], %length
  buffer.fill %pattern, %target[%fill_origin], %length : i32
  %forward = buffer.compare %source[%origin], %target[%fill_origin], %length
  %reverse = buffer.compare %target[%fill_origin], %source[%origin], %length
  %observation_origin = index.constant 0 : offset
  %result = buffer.view %observations[%observation_origin] : buffer -> view<3xi32>
  view.store %equal, %result[0] : i32, view<3xi32>
  view.store %forward, %result[1] : i32, view<3xi32>
  view.store %reverse, %result[2] : i32, view<3xi32>
  func.return
}

// Byte counts span the full unsigned word domain during compilation. Word
// counts retain arithmetic divisibility without a separate alignment promise.
func.def @unsigned_length_bulk(%input: buffer, %storage: buffer, %raw_length: i32, %pattern: i32, %observations: buffer) {
  %length = index.cast %raw_length : i32 to offset
  func.call @observe_bulk_length(%input, %storage, %length, %pattern, %observations) : (buffer, buffer, offset, i32, buffer)
  func.return
}

func.def @word_length_bulk(%input: buffer, %storage: buffer, %word_count: i16, %pattern: i32, %observations: buffer) {
  %wide_count = scalar.extui %word_count : i16 to i64
  %byte_shift = scalar.constant 2 : i64
  %wide_bytes = scalar.shli %wide_count, %byte_shift : i64
  %length = index.cast %wide_bytes : i64 to offset
  func.call @observe_bulk_length(%input, %storage, %length, %pattern, %observations) : (buffer, buffer, offset, i32, buffer)
  func.return
}

func.def @bulk_length_inputs(%trial: index, %bits: i64) -> (i32, i16, i32) {
  %length = index.cast %trial : index to i32
  %count = scalar.trunci %length : i32 to i16
  %pattern = scalar.trunci %bits : i64 to i32
  func.return %length, %count, %pattern : i32, i16, i32
}

check.scenario @unsigned_length_bulk_values {
  check.trial[130](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-128) step(1) : tensor<48xi32>
    %output = check.generate.fill value(1431655765) : tensor<128xi32>
    %observations = check.generate.fill value(99) : tensor<3xi32>
    %bits = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %length, %count, %pattern = check.generate<@bulk_length_inputs>(%trial, %bits) : (index, i64) -> (i32, i16, i32)
    check.compare<@unsigned_length_bulk>(%input, %output, %length, %pattern, %observations) : (tensor<48xi32>, tensor<128xi32>, i32, i32, tensor<3xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<128xi32>
      check.expect.bitwise actual(%observations) expected(%observations) : tensor<3xi32>
    }
  }
  check.trial[33](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-128) step(1) : tensor<48xi32>
    %output = check.generate.fill value(1431655765) : tensor<128xi32>
    %observations = check.generate.fill value(99) : tensor<3xi32>
    %bits = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %length, %count, %pattern = check.generate<@bulk_length_inputs>(%trial, %bits) : (index, i64) -> (i32, i16, i32)
    check.compare<@word_length_bulk>(%input, %output, %count, %pattern, %observations) : (tensor<48xi32>, tensor<128xi32>, i16, i32, tensor<3xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<128xi32>
      check.expect.bitwise actual(%observations) expected(%observations) : tensor<3xi32>
    }
  }
  check.return
}

check.scenario @compare_first_difference_values {
  check.trial[130](%trial: index, %entropy: check.entropy) {
    %left = check.generate.fill value(0) : tensor<33xi32>
    %right = check.generate.fill value(0) : tensor<33xi32>
    %output = check.generate.fill value(0) : tensor<3xi32>
    check.compare<@compare_first_difference>(%left, %right, %trial, %output) : (tensor<33xi32>, tensor<33xi32>, index, tensor<3xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<3xi32>
    }
  }
  check.return
}

check.scenario @fill_exact_range_values {
  check.trial[130](%trial: index, %entropy: check.entropy) {
    %bits = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %output = check.generate.fill value(85) : tensor<768xi8>
    check.compare<@fill_exact_range>(%output, %trial, %bits) : (tensor<768xi8>, index, i64) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<768xi8>
    }
  }
  check.return
}

check.scenario @copy_exact_range_values {
  check.trial[130](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-128) step(1) : tensor<192xi8>
    %output = check.generate.fill value(85) : tensor<192xi8>
    check.compare<@copy_exact_range>(%input, %output, %trial) : (tensor<192xi8>, tensor<192xi8>, index) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<192xi8>
    }
  }
  check.return
}

check.scenario @byte_boundary_values {
  check.trial[16](%trial: index, %entropy: check.entropy) {
    %left_source = check.entropy.fork %entropy name("left") : check.entropy
    %right_source = check.entropy.fork %entropy name("right") : check.entropy
    %left = check.entropy.read %left_source[%trial] : check.entropy -> i64
    %right = check.entropy.read %right_source[%trial] : check.entropy -> i64
    %output = check.generate.fill value(0) : tensor<16xi32>
    check.compare<@byte_boundary_observations>(%trial, %left, %right, %output) : (index, i64, i64, tensor<16xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<16xi32>
    }
  }
  check.return
}

check.scenario @vector_boundary_values {
  check.trial[32](%trial: index, %entropy: check.entropy) {
    %left_source = check.entropy.fork %entropy name("left") : check.entropy
    %right_source = check.entropy.fork %entropy name("right") : check.entropy
    %left = check.entropy.read %left_source[%trial] : check.entropy -> i64
    %right = check.entropy.read %right_source[%trial] : check.entropy -> i64
    %output = check.generate.fill value(0) : tensor<17xi32>
    check.compare<@vector_boundary_observations>(%trial, %left, %right, %output) : (index, i64, i64, tensor<17xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<17xi32>
    }
  }
  check.return
}
