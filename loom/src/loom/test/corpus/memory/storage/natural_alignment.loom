// Ordinary typed accesses require natural scalar storage alignment without
// an allocation-root or offset assertion.
kernel.def @natural_copy() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  func.call @compute_natural_copy(%input, %output) : (buffer, buffer)
  kernel.return
}

func.def device inline @compute_natural_copy(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<4xi32>
  %destination = buffer.view %output[%base] : buffer -> view<1xi32>
  %value = view.load %source[2] : view<4xi32> -> i32
  view.store %value, %destination[0] : i32, view<1xi32>
  func.return
}

func.def @natural_copy_oracle(%input: buffer, %output: buffer) {
  func.call @compute_natural_copy(%input, %output) : (buffer, buffer)
  func.return
}

check.scenario @natural_copy_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(7) step(3) : tensor<4xi32>
    %output = check.generate.fill value(-99) : tensor<1xi32>
    check.compare<@natural_copy, @natural_copy_oracle>(%input, %output) : (tensor<4xi32>, tensor<1xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<4xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<1xi32>
    }
  }
  check.return
}

// A runtime-empty view has no accessible or aligned element. Its mask retains
// the footprint relation while the native code still handles a dynamic extent.
kernel.def @inactive_empty_view() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %count: index) {
  func.call @compute_inactive_empty_view(%input, %output, %count) : (buffer, buffer, index)
  kernel.return
}

func.def device inline @compute_inactive_empty_view(%input: buffer, %output: buffer, %count: index) {
  %extent = index.assume %count [range(%count, 0, 2)] : index
  %odd = index.constant 1 : offset
  %empty = buffer.view %input[%odd] : buffer -> view<[%extent]xi32>
  %base = index.constant 0 : offset
  %mask_start = index.constant 0 : index
  %mask_step = index.constant 1 : index
  %mask = vector.mask.range [%mask_start to %extent step %mask_step] : index -> vector<2xi1>
  %values = vector.splati -17 : vector<2xi32>
  %loaded = vector.load.mask %empty[0], %mask, %values : view<[%extent]xi32>, vector<2xi1>, vector<2xi32>
  vector.store.mask %values, %empty[0], %mask : vector<2xi32>, view<[%extent]xi32>, vector<2xi1>
  %destination = buffer.view %output[%base] : buffer -> view<2xi32>
  vector.store %loaded, %destination[0] : vector<2xi32>, view<2xi32>
  func.return
}

func.def @inactive_empty_view_oracle(%input: buffer, %output: buffer, %count: index) {
  func.call @compute_inactive_empty_view(%input, %output, %count) : (buffer, buffer, index)
  func.return
}

check.scenario @inactive_empty_view_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(37) : tensor<1xi8>
    %output = check.generate.fill value(-99) : tensor<2xi32>
    %count = check.literal value(0) : index
    check.compare<@inactive_empty_view, @inactive_empty_view_oracle>(%input, %output, %count) : (tensor<1xi8>, tensor<2xi32>, index) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<1xi8>
      check.expect.bitwise actual(%output) expected(%output) : tensor<2xi32>
    }
  }
  check.return
}
