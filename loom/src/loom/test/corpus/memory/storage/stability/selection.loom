  check.trial[1](%trial: index, %entropy: check.entropy) {
    %shared = check.generate.iota offset(-7) step(13) : tensor<4xi32>
    %output = check.generate.fill value(-889275714) : tensor<4xi32>
    check.compare<@restrict_shared_read_storage, @restrict_shared_read_storage_oracle>(%shared, %shared, %output) : (tensor<4xi32>, tensor<4xi32>, tensor<4xi32>) -> () {
      check.expect.bitwise actual(%shared) expected(%shared) : tensor<4xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi32>
    }
  }
  check.return
}
