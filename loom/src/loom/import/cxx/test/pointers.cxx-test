  %7 = scalar.muli %5, %6 : i64
  %8 = index.cast %p_byte_offset$1 : offset to i64
  %9 = scalar.addi %8, %7 : i64
  %10 = scalar.assume %9 [range(%9, 0, 9223372036854775807)] : i64
  %p_byte_offset$11 = index.cast %10 : i64 to offset
  func.return %p, %p_byte_offset$11 : buffer, offset
}

