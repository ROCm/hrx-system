// ====
// RUN: roundtrip
// Pointer unary plus preserves root and origin.
int* identity(int* p) { return +p; }
// ----
func.def public @identity(%p: buffer, %p_byte_offset: offset) -> (buffer, offset) {
  func.return %p, %p_byte_offset : buffer, offset
}

// ====
// RUN: verify
// Unsupported pointer operations produce source diagnostics.
// ERROR@+1: LOWERING/059 "pointer arithmetic requires a pointer and an integral displacement"
long diff(int* a, int* b) { return a - b; }

// ====
// RUN: verify
// Unsupported pointer operations produce source diagnostics.
// ERROR@+1: LOWERING/059 "pointer arithmetic requires a pointer and an integral displacement"
bool equal(int* a, int* b) { return a == b; }

// ====
// RUN: verify
// Unsupported pointer operations produce source diagnostics.
// ERROR@+1: LOWERING/059 "conversion must preserve pointer representation"
bool truth(int* a) { return a; }

// ====
// RUN: verify
// A pointer value's buffer and byte origin have no stored object representation.
int* local(int* input) {
  // ERROR@+1: LOWERING/059 "stored pointers and references require an object storage representation"
  int* pointer = input;
  auto** indirect = &pointer;
  return *indirect;
}

// ====
// RUN: verify
// An indeterminate pointer object still needs a memory representation before
// a later source assignment can initialize it.
int* deferred(int* input) {
  // ERROR@+1: LOWERING/059 "uninitialized locals require scalar or native vector object storage"
  int* result;
  result = input;
  return result;
}

// ====
// RUN: roundtrip
// Pointer increment results preserve the source ABI.
int* next(int* p) { return ++p; }
int* previous(int* p) { return p++; }
int* retreat(int* p) { return --p; }
int* old_retreat(int* p) { return p--; }
// ----
