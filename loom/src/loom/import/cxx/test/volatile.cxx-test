  %5 = buffer.view %input[%input_byte_offset] : buffer -> view<1xi32>
  %6 = view.load<volatile> %5[0] : view<1xi32> -> i32
  %value = view.load<volatile> %5[0] : view<1xi32> -> i32
  %9 = buffer.view %output[%output_byte_offset] : buffer -> view<1xi32>
  view.store<volatile> %value, %9[0] : i32, view<1xi32>
  func.return %value : i32
}

