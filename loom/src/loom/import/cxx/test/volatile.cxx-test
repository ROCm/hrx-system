  %value_storage_byte_offset = index.constant 0 : offset
  %value_view = buffer.view %value_storage[%value_storage_byte_offset] : buffer -> view<1xi32>
  view.store<volatile> %value$2, %value_view[0] : i32, view<1xi32>
  %16 = index.constant 16 : offset
  %vector_storage = buffer.alloca<private> align(16) %16 : buffer
  %vector_view = buffer.view %vector_storage[%value_storage_byte_offset] : buffer -> view<4xi32>
  vector.store<volatile> %vector$3, %vector_view[0] : vector<4xi32>, view<4xi32>
  %value$20 = view.load<volatile> %value_view[0] : view<1xi32> -> i32
  %value$21 = view.load<volatile> %value_view[0] : view<1xi32> -> i32
  %30 = buffer.view %output[%value_storage_byte_offset] : buffer -> view<1xi32>
  view.store %value$21, %30[0] : i32, view<1xi32>
  %vector$31 = vector.load<volatile> %vector_view[0] : view<4xi32> -> vector<4xi32>
  %vector$32 = vector.load<volatile> %vector_view[0] : view<4xi32> -> vector<4xi32>
  %41 = buffer.view %vector_output[%value_storage_byte_offset] : buffer -> view<4xi32>
