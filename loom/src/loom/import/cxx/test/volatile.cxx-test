// ====
// Pointer members and helper boundaries preserve the pointee qualifier.
struct Source { const volatile unsigned* data; };
static unsigned read(Source source) { return source.data[1]; }
unsigned through_helper(const unsigned* input) {
  Source source{input};
  return read(source);
}
// ----
func.def public @through_helper(%input: buffer, %input_byte_offset: offset) -> (i32) {
  %3 = func.call @read(%input, %input_byte_offset) : (buffer, offset) -> (i32)
  func.return %3 : i32
}

func.def @read(%source_data: buffer, %source_data_byte_offset: offset) -> (i32) {
  %17 = scalar.constant 4 : i64
  %11 = index.cast %source_data_byte_offset : offset to i64
  %12 = scalar.addi %11, %17 : i64
  %13 = scalar.assume %12 [range(%12, 0, 9223372036854775807)] : i64
  %14 = index.cast %13 : i64 to offset
  %15 = buffer.view %source_data[%14] : buffer -> view<1xi32>
  %16 = view.load<volatile> %15[0] : view<1xi32> -> i32
  func.return %16 : i32
}

// ====
// Whole-vector observations retain every lane even with a scalar result.
using Words = unsigned __attribute__((vector_size(16)));
unsigned vector_observations(const volatile Words* input, volatile Words* output) {
  *input;
  Words value = input[0];
  output[0] = value;
  output[0] = value;
  return value[2];
}
