// RUN: pass canonicalize,cse,dce
// Repeated observations survive cleanup even when their values are discarded.
unsigned observations(const volatile unsigned* input, volatile unsigned* output) {
  input[0];
  static_cast<void>(input[0]);
  (void)*input;
  (void(*input));
  unsigned first = input[0];
  unsigned second = input[0];
  output[0] = first;
  output[0] = second;
  return first + second;
}
