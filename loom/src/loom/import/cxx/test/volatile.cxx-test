  %25 = buffer.view %input[%input_byte_offset] : buffer -> view<1xi32>
  %26 = view.load<volatile> %25[0] : view<1xi32> -> i32
  %28 = view.load<volatile> %25[0] : view<1xi32> -> i32
  %first = view.load<volatile> %13[0] : view<1xi32> -> i32
  %second = view.load<volatile> %13[0] : view<1xi32> -> i32
  %53 = index.cast %output_byte_offset : offset to i64
  %55 = scalar.assume %53 [range(%53, 0, 9223372036854775807)] : i64
  %56 = index.cast %55 : i64 to offset
  %57 = buffer.view %output[%56] : buffer -> view<1xi32>
  view.store<volatile> %first, %57[0] : i32, view<1xi32>
  view.store<volatile> %second, %57[0] : i32, view<1xi32>
  %67 = scalar.addi %first, %second : i32
  func.return %67 : i32
}

// ====
// Ordinary reads still coalesce and unused reads disappear.
unsigned ordinary(const unsigned* input, unsigned* output) {
  input[0];
  static_cast<void>(input[0]);
  (void)*input;
  (void(*input));
  unsigned first = input[0];
  unsigned second = input[0];
  output[0] = first;
  output[0] = second;
  return first + second;
}
