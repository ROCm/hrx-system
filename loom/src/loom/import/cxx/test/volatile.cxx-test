// ====
// Kernel value arguments use the same unqualified ABI and qualified local
// objects as ordinary functions.
#include <loomcxx/kernel.h>
using Words = unsigned __attribute__((vector_size(16)));
[[loom::kernel, loom::workgroup_size(1, 1, 1),
  loom::workgroup_count(1, 1, 1)]]
void parameter_observations(unsigned* output, Words* vector_output,
                            volatile unsigned value, volatile Words vector) {
  static_cast<void>(value);
  output[0] = value;
  static_cast<void>(vector);
  vector_output[0] = vector;
}

