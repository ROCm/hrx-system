// RUN: roundtrip
// Equal-valued objects select different bodies when their identity matters.
constexpr unsigned left = 5, right = 5;
template <const unsigned& object>
unsigned choose(unsigned input) {
  if constexpr (&object == &left) {
    return input + 3;
  } else {
    return input + 7;
  }
}
unsigned entry(unsigned input) {
  return choose<left>(input) + choose<right>(input);
}

// ----
func.def public @entry(%input: i32) -> (i32) {
  %2 = func.call @choose_left(%input) : (i32) -> (i32)
  %3 = func.call @choose_right(%input) : (i32) -> (i32)
  %4 = scalar.addi %2, %3 : i32
  func.return %4 : i32
}

func.def @choose_left(%input: i32) -> (i32) {
  %7 = scalar.constant 3 : i32
  %8 = scalar.addi %input, %7 : i32
  func.return %8 : i32
}

func.def @choose_right(%input: i32) -> (i32) {
  %11 = scalar.constant 7 : i32
  %12 = scalar.addi %input, %11 : i32
  func.return %12 : i32
}

// ====
// Repeated base subobjects retain the selected inheritance path in reference
// arguments and emitted specialization names.
struct Base { unsigned value; };
struct Left : Base {};
struct Right : Base {};
struct Both : Left, Right {};
extern Both object;
template <const unsigned& value>
unsigned choose(unsigned input) {
  if constexpr (&value == &object.Left::value) return input + 3;
  return input + 7;
}
unsigned entry(unsigned input) {
  return choose<object.Left::value>(input) +
         choose<object.Right::value>(input);
}

// ----
func.def public @entry(%input: i32) -> (i32) {
  %2 = func.call @choose_object_Left_Base_value(%input) : (i32) -> (i32)
  %3 = func.call @choose_object_Right_Base_value(%input) : (i32) -> (i32)
  %4 = scalar.addi %2, %3 : i32
  func.return %4 : i32
}

func.def @choose_object_Left_Base_value(%input: i32) -> (i32) {
  %7 = scalar.constant 3 : i32
  %8 = scalar.addi %input, %7 : i32
  func.return %8 : i32
}

func.def @choose_object_Right_Base_value(%input: i32) -> (i32) {
  %11 = scalar.constant 7 : i32
  %12 = scalar.addi %input, %11 : i32
  func.return %12 : i32
}

// ====
// Unqualified using-declaration selection, anonymous members, reference
// returns, and explicit base conversions preserve the same subobject identity
// as their fully qualified spelling.
// RUN: verify
struct Base { unsigned value; };
struct Left : Base {};
struct Right : Base {};
struct Both : Left, Right {
  constexpr const Base& left_base() const {
    return static_cast<const Left&>(*this);
  }
};
struct Selected : Left, Right { using Left::value; };
struct Anonymous { struct { struct { unsigned value; }; }; };
extern Both object;
extern Selected selected;
extern Anonymous anonymous;
template <const unsigned& value> struct Ref {};
using SelectedValue = Ref<selected.value>;
using QualifiedValue = Ref<selected.Left::value>;
static_assert(__is_same(SelectedValue, QualifiedValue));
static_assert(&selected.value == &selected.Left::value);
using AnonymousValue = Ref<anonymous.value>;
using Direct = Ref<object.Left::value>;
using Returned = Ref<object.left_base().value>;
using Converted = Ref<static_cast<const Left&>(object).value>;
static_assert(__is_same(Direct, Returned));
static_assert(__is_same(Direct, Converted));

// ====
// Field addresses retain their declared object through direct access,
// reference-returning members, nested records, and arrays of records.
struct Parameters {
  unsigned scale, bias;
  constexpr const unsigned& get() const { return scale; }
};
struct Pair {
  Parameters left, right;
};
constexpr Parameters first{3, 5}, second{7, 11};
constexpr Pair pair{{3, 5}, {7, 11}};
constexpr Parameters table[2] = {{3, 5}, {7, 11}};
extern Parameters external;
template <const unsigned& value>
struct Ref {};
static_assert(__is_same(Ref<first.get()>, Ref<first.scale>));
static_assert(!__is_same(Ref<first.scale>, Ref<second.scale>));
static_assert(!__is_same(Ref<first.scale>, Ref<first.bias>));
static_assert(__is_same(Ref<pair.left.get()>, Ref<pair.left.scale>));
static_assert(!__is_same(Ref<pair.left.scale>, Ref<pair.right.scale>));
static_assert(__is_same(Ref<table[1].get()>, Ref<table[1].scale>));
static_assert(!__is_same(Ref<table[0].scale>, Ref<table[1].scale>));
static_assert(__is_same(Ref<external.get()>, Ref<external.scale>));
template <const unsigned& scale, const unsigned& bias>
unsigned apply(unsigned value) {
  return value * scale + bias;
}
unsigned entry(unsigned value) {
  return apply<first.get(), first.bias>(value) +
         apply<second.scale, second.bias>(value);
}

// ----
func.def public @entry(%value: i32) -> (i32) {
  %2 = func.call @apply_first_scale_first_bias(%value) : (i32) -> (i32)
  %3 = func.call @apply_second_scale_second_bias(%value) : (i32) -> (i32)
  %4 = scalar.addi %2, %3 : i32
  func.return %4 : i32
}

func.def @apply_first_scale_first_bias(%value: i32) -> (i32) {
  %7 = scalar.constant 3 : i32
  %8 = scalar.muli %value, %7 : i32
  %9 = scalar.constant 5 : i32
  %10 = scalar.addi %8, %9 : i32
  func.return %10 : i32
}

func.def @apply_second_scale_second_bias(%value: i32) -> (i32) {
  %13 = scalar.constant 7 : i32
  %14 = scalar.muli %value, %13 : i32
  %15 = scalar.constant 11 : i32
  %16 = scalar.addi %14, %15 : i32
  func.return %16 : i32
}

// ====
// Repeated references and aliases reuse a specialization; distinct objects do
// not, regardless of equal scalar contents.
constexpr unsigned left = 5, right = 5;
constexpr const unsigned& alias = left;
template <const unsigned& object>
struct Ref {};
static_assert(__is_same(Ref<left>, Ref<left>));
static_assert(__is_same(Ref<left>, Ref<alias>));
static_assert(!__is_same(Ref<left>, Ref<right>));
unsigned entry() { return 7; }

// ----
func.def public @entry() -> (i32) {
  %1 = scalar.constant 7 : i32
  func.return %1 : i32
}

// ====
// Pointer arguments compare their represented addresses, not evaluator
// allocations. Element offsets distinguish equal-valued array entries.
constexpr unsigned table[2] = {5, 5};
template <const unsigned* object>
struct Pointer {};
static_assert(__is_same(Pointer<&table[0]>, Pointer<&table[0]>));
static_assert(!__is_same(Pointer<&table[0]>, Pointer<&table[1]>));
static_assert(__is_same(Pointer<nullptr>,
                        Pointer<static_cast<const unsigned*>(nullptr)>));
unsigned entry() { return 7; }

// ----
func.def public @entry() -> (i32) {
  %1 = scalar.constant 7 : i32
  func.return %1 : i32
}

// ====
// Binding a static object requires its address, not a constant readable value.
extern unsigned object;
template <const unsigned& value = object>
constexpr const unsigned* address() {
  return &value;
}
static_assert(address<>() == &object);
static_assert(address<object>() == &object);
unsigned entry() { return 7; }

// ----
func.def public @entry() -> (i32) {
  %1 = scalar.constant 7 : i32
  func.return %1 : i32
}

// ====
// Explicit packs retain reference expressions through argument deduction.
extern unsigned left, right;
template <const unsigned&... values>
struct References {};
static_assert(__is_same(References<left, right>, References<left, right>));
static_assert(!__is_same(References<left, right>, References<right, left>));
template <const unsigned&... values>
constexpr unsigned count() {
  return sizeof...(values);
}
static_assert(count<left, right>() == 2);
unsigned entry() {
  constexpr unsigned result = count<left, right>();
  return result;
}

// ----
func.def public @entry() -> (i32) {
  %result = scalar.constant 2 : i32
  func.return %result : i32
}

// ====
// A placeholder reference retains the object's type and qualifications.
extern unsigned object;
template <auto& value>
constexpr auto address() {
  return &value;
}
static_assert(__is_same(decltype(address<object>()), unsigned*));
static_assert(address<object>() == &object);
unsigned entry() { return 7; }

// ----
func.def public @entry() -> (i32) {
  %1 = scalar.constant 7 : i32
  func.return %1 : i32
}

// ====
// Array reference binding preserves the whole-array type.
extern unsigned table[2];
template <unsigned (&value)[2]>
constexpr unsigned (*address())[2] {
  return &value;
}
static_assert(address<table>() == &table);
unsigned entry() { return 7; }

// ----
func.def public @entry() -> (i32) {
  %1 = scalar.constant 7 : i32
  func.return %1 : i32
}

// ====
// Function references retain the canonical function identity.
constexpr unsigned source() { return 5; }
template <unsigned (&function)()>
constexpr unsigned (*address())() {
  return &function;
}
static_assert(address<source>() == &source);
unsigned entry() { return 7; }

// ----
func.def public @source() -> (i32) {
  %1 = scalar.constant 5 : i32
  func.return %1 : i32
}

func.def public @entry() -> (i32) {
  %3 = scalar.constant 7 : i32
  func.return %3 : i32
}

// ====
// Aliases and redeclarations name the same static object.
extern unsigned object;
template <const unsigned& value>
struct Ref {};
using First = Ref<object>;
extern unsigned object;
static_assert(__is_same(First, Ref<object>));
unsigned entry() { return 7; }

// ----
func.def public @entry() -> (i32) {
  %1 = scalar.constant 7 : i32
  func.return %1 : i32
}

// ====
// Reference array elements retain their element positions.
constexpr unsigned table[2] = {5, 5};
template <const unsigned& value>
constexpr const unsigned* address() {
  return &value;
}
static_assert(address<table[0]>() == &table[0]);
static_assert(address<table[1]>() == &table[1]);
static_assert(address<table[0]>() != address<table[1]>());
unsigned entry() { return 7; }

// ----
func.def public @entry() -> (i32) {
  %1 = scalar.constant 7 : i32
  func.return %1 : i32
}

// ====
// Array references, pointer aliases and equivalent glvalue spellings retain
// the same element identity without loading the referent.
constexpr unsigned table[3] = {3, 5, 7};
constexpr const auto& alias = table;
constexpr const unsigned* pointer = table + 1;
template <const unsigned& value>
struct Ref {};
static_assert(__is_same(Ref<alias[1]>, Ref<table[1]>));
static_assert(__is_same(Ref<pointer[0]>, Ref<table[1]>));
static_assert(__is_same(Ref<*pointer>, Ref<table[1]>));
static_assert(__is_same(Ref<*(table + 1)>, Ref<table[1]>));
static_assert(!__is_same(Ref<pointer[0]>, Ref<table[0]>));
static_assert(__is_same(Ref<true ? table[0] : table[1]>, Ref<table[0]>));
unsigned entry() {
  constexpr unsigned result = alias[1];
  return result;
}

// ----
func.def public @entry() -> (i32) {
  %result = scalar.constant 5 : i32
  func.return %result : i32
}

// ====
// Reference-returning constexpr accessors preserve the address of their result.
constexpr unsigned table[3] = {3, 5, 7};
static constexpr const unsigned& second() { return table[1]; }
template <const unsigned& value>
struct Ref {};
static_assert(__is_same(Ref<second()>, Ref<table[1]>));
static_assert(!__is_same(Ref<second()>, Ref<table[0]>));
unsigned entry() {
  constexpr unsigned result = second();
  return result;
}

// ----
func.def public @entry() -> (i32) {
  %result = scalar.constant 5 : i32
  func.return %result : i32
}

// ====
// A class's static data member is independently addressable static storage.
struct Table {
  static constexpr unsigned value = 5;
};
template <const unsigned& value>
struct Ref {};
template <const unsigned& value>
constexpr unsigned read() { return value; }
static_assert(__is_same(Ref<Table::value>, Ref<Table::value>));
unsigned entry() {
  constexpr unsigned result = read<Table::value>();
  return result;
}

// ----
func.def public @entry() -> (i32) {
  %result = scalar.constant 5 : i32
  func.return %result : i32
}

// ====
// Canonical declaration identity does not lose the later definition's value.
extern const unsigned value;
constexpr unsigned value = 5;
constexpr const unsigned* pointer = &value;
static_assert(*pointer == 5);
unsigned entry() {
  constexpr unsigned result = *pointer;
  return result;
}

// ----
func.def public @entry() -> (i32) {
  %result = scalar.constant 5 : i32
  func.return %result : i32
}

// ====
// Forming an address evaluates side effects once, including reference-returning
// calls and the index expression of a subscript.
constexpr unsigned table[3] = {3, 5, 7};
static constexpr const unsigned& advance(unsigned& index) {
  ++index;
  return table[index];
}
static constexpr unsigned count() {
  unsigned index = 0;
  const unsigned* first = &table[++index];
  const unsigned* second = &advance(index);
  return index + *first + *second;
}
static_assert(count() == 14);
unsigned entry() {
  constexpr unsigned result = count();
  return result;
}

// ----
func.def public @entry() -> (i32) {
  %result = scalar.constant 14 : i32
  func.return %result : i32
}

// ====
// A one-past pointer retains its position without reading an array element.
constexpr unsigned table[3] = {3, 5, 7};
template <const unsigned* value>
struct Pointer {};
static_assert(__is_same(Pointer<table + 3>, Pointer<&table[0] + 3>));
static_assert(!__is_same(Pointer<table + 3>, Pointer<table + 2>));
unsigned entry() { return 7; }

// ----
func.def public @entry() -> (i32) {
  %1 = scalar.constant 7 : i32
  func.return %1 : i32
}

// ====
// A reference argument retains its identity until a value read. Reading a
// constant table element then imports its scalar value without global storage.
namespace model {
constexpr unsigned table[2] = {3, 5};
}
template <const unsigned& value>
unsigned add(unsigned input) { return input + value; }
unsigned entry(unsigned input) {
  return add<model::table[0]>(input) + add<model::table[1]>(input);
}

// ----
func.def public @entry(%input: i32) -> (i32) {
  %2 = func.call @add_model__table_0_(%input) : (i32) -> (i32)
  %3 = func.call @add_model__table_1_(%input) : (i32) -> (i32)
  %4 = scalar.addi %2, %3 : i32
  func.return %4 : i32
}

func.def @add_model__table_0_(%input: i32) -> (i32) {
  %7 = scalar.constant 3 : i32
  %8 = scalar.addi %input, %7 : i32
  func.return %8 : i32
}

func.def @add_model__table_1_(%input: i32) -> (i32) {
  %11 = scalar.constant 5 : i32
  %12 = scalar.addi %input, %11 : i32
  func.return %12 : i32
}

// ====
// Pointer arguments print an address, while reference arguments print the
// referenced object. This distinguishes the source forms in imported names.
namespace model {
constexpr unsigned table[2] = {3, 5};
}
template <const unsigned* value>
unsigned choose(unsigned input) {
  if constexpr (value == &model::table[0]) return input + 3;
  return input + 5;
}
unsigned entry(unsigned input) {
  return choose<&model::table[0]>(input) + choose<&model::table[1]>(input);
}

// ----
func.def public @entry(%input: i32) -> (i32) {
  %2 = func.call @choose__model__table_0_(%input) : (i32) -> (i32)
  %3 = func.call @choose__model__table_1_(%input) : (i32) -> (i32)
  %4 = scalar.addi %2, %3 : i32
  func.return %4 : i32
}

func.def @choose__model__table_0_(%input: i32) -> (i32) {
  %7 = scalar.constant 3 : i32
  %8 = scalar.addi %input, %7 : i32
  func.return %8 : i32
}

func.def @choose__model__table_1_(%input: i32) -> (i32) {
  %11 = scalar.constant 5 : i32
  %12 = scalar.addi %input, %11 : i32
  func.return %12 : i32
}

// ====
// Static member names retain their class qualification.
struct Settings {
  static constexpr unsigned gain = 5;
};
template <const unsigned& value>
unsigned scale(unsigned input) { return input * value; }
unsigned entry(unsigned input) { return scale<Settings::gain>(input); }

// ----
func.def public @entry(%input: i32) -> (i32) {
  %2 = func.call @scale_Settings__gain(%input) : (i32) -> (i32)
  func.return %2 : i32
}

func.def @scale_Settings__gain(%input: i32) -> (i32) {
  %5 = scalar.constant 5 : i32
  %6 = scalar.muli %input, %5 : i32
  func.return %6 : i32
}

// ====
// A whole-array reference prints the array's name, not its first element.
constexpr unsigned table[2] = {3, 5};
template <const unsigned (&values)[2]>
unsigned add(unsigned input) {
  constexpr unsigned first = values[0];
  return input + first;
}
unsigned entry(unsigned input) { return add<table>(input); }

// ----
func.def public @entry(%input: i32) -> (i32) {
  %2 = func.call @add_table(%input) : (i32) -> (i32)
  func.return %2 : i32
}

func.def @add_table(%input: i32) -> (i32) {
  %first = scalar.constant 3 : i32
  %6 = scalar.addi %input, %first : i32
  func.return %6 : i32
}

// ====
// Reference forwarding preserves identity without reading mutable storage.
extern unsigned left, right, table[3];
static constexpr const unsigned& forward(const unsigned& value) {
  return value;
}
static constexpr const unsigned* address(const unsigned& value) {
  return &value;
}
template <const unsigned& value>
unsigned choose(unsigned input) {
  if constexpr (&value == &left) return input + 3;
  return input + 7;
}
static_assert(&forward(left) == &left);
static_assert(address(right) == &right);
static_assert(&forward(table[1]) == &table[1]);
unsigned entry(unsigned input) {
  return choose<forward(left)>(input) + choose<forward(right)>(input);
}

// ----
func.def public @entry(%input: i32) -> (i32) {
  %2 = func.call @choose_left(%input) : (i32) -> (i32)
  %3 = func.call @choose_right(%input) : (i32) -> (i32)
  %4 = scalar.addi %2, %3 : i32
  func.return %4 : i32
}

func.def @choose_left(%input: i32) -> (i32) {
  %7 = scalar.constant 3 : i32
  %8 = scalar.addi %input, %7 : i32
  func.return %8 : i32
}

func.def @choose_right(%input: i32) -> (i32) {
  %11 = scalar.constant 7 : i32
  %12 = scalar.addi %input, %11 : i32
  func.return %12 : i32
}
