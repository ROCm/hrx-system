// RUN: with-checks pass inline-callables,canonicalize,cse,promote-private-fragments,canonicalize,cse,dce
// One allocation joins direct indexing and an interior helper alias. Shared
// promotion carries the changed element through the branch in registers.
[[loom::inline]] static void update(unsigned* value, unsigned enabled) {
  if (enabled) *value += 4;
}
unsigned guarded(unsigned input, unsigned enabled) {
  unsigned values[3] = {37, input, 41};
  update(values + 1, enabled);
  return values[0] + values[1] + values[2];
}
// ----
CHECK: *scf.select* : i32
CHECK: *scalar.addi* : i32
CHECK-NOT: *buffer.alloca*
CHECK-NOT: *view.load*
CHECK-NOT: *view.store*

// ====
// RUN: with-checks roundtrip
// Source layout owns the byte footprint and explicit allocation alignment.
// An uninitialized declaration emits no stores before the output-only helper.
static void fill(unsigned short* values) { values[1] = 7; }
unsigned initialized_by_helper() {
  alignas(32) unsigned short values[3];
  fill(values);
  return values[1];
}
// ----
CHECK: *index.constant 6 : offset
CHECK: *buffer.alloca<private> align(32)*
CHECK: *buffer.view* -> view<3xi16>
CHECK: *func.call @fill*
CHECK-NOT: *view.store*values_view*

// ====
// RUN: with-checks pass canonicalize,cse,promote-private-fragments,dce
// Initialization and element accesses preserve volatile observation semantics.
unsigned observed(unsigned input) {
  volatile unsigned values[2] = {input};
  values[1] = values[0] + 1;
  return values[1];
}
// ----
CHECK: *buffer.alloca<private>*
CHECK: *view.store<volatile>*
CHECK: *view.load<volatile>*
