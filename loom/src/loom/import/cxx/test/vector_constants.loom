kernel.decl @constant_vectors() launch(%partial: buffer, %zero: buffer, %first: buffer, %splat: buffer, %floating: buffer)

// Each word checks four independently specified source lanes, including the
// omitted zeros and the FP8 negative-zero payload.
check.case public @constant_vector_payloads {
  %partial = check.generate.fill value(-1) : tensor<32xi32>
  %zero = check.generate.fill value(-1) : tensor<32xi32>
  %first = check.generate.fill value(-1) : tensor<32xi32>
  %splat = check.generate.fill value(-1) : tensor<32xi32>
  %floating = check.generate.fill value(-1) : tensor<32xi32>
  kernel.launch @constant_vectors(%partial, %zero, %first, %splat, %floating) : (tensor<32xi32>, tensor<32xi32>, tensor<32xi32>, tensor<32xi32>, tensor<32xi32>)
  %expected_partial = check.generate.fill value(33023) : tensor<32xi32>
  %expected_zero = check.generate.fill value(0) : tensor<32xi32>
  %expected_first = check.generate.fill value(7) : tensor<32xi32>
  %expected_splat = check.generate.fill value(151587081) : tensor<32xi32>
  %expected_floating = check.generate.fill value(32825) : tensor<32xi32>
  check.expect.equal actual(%partial) expected(%expected_partial) : tensor<32xi32>
  check.expect.equal actual(%zero) expected(%expected_zero) : tensor<32xi32>
  check.expect.equal actual(%first) expected(%expected_first) : tensor<32xi32>
  check.expect.equal actual(%splat) expected(%expected_splat) : tensor<32xi32>
  check.expect.equal actual(%floating) expected(%expected_floating) : tensor<32xi32>
  check.return
}
