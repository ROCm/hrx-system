// RUN: verify
// Runtime reference ABIs require every caller to participate in the selected
// identity contract, so externally callable definitions remain rejected.
// ERROR@+1: LOWERING/059 "runtime reference signatures require an internal ordinary function definition"
void public_reference(unsigned& value) { ++value; }

// ====
// Bodyless declarations cannot establish the internal call graph contract.
static void external_reference(unsigned& value);
// ERROR@+1: LOWERING/059 "runtime reference signatures require an internal ordinary function definition"
void caller(unsigned& value) { external_reference(value); }

// ====
static void consume(unsigned&& value) { ++value; }
unsigned rvalue_reference(unsigned value) {
  // ERROR@+1: LOWERING/059 "rvalue-reference parameters require consuming object identity"
  consume(static_cast<unsigned&&>(value));
  return value;
}

// ====
static void combine(unsigned& output, const unsigned& input) { output += input; }
unsigned overlapping_references(unsigned value) {
  // ERROR@+1: LOWERING/059 "mutable value-reference arguments must select nonoverlapping automatic objects or member slices"
  combine(value, value);
  return value;
}

// ====
struct Pair { unsigned first, second; };
static void combine(Pair& output, const unsigned& input) { output.first += input; }
Pair overlapping_member_reference(Pair value) {
  // ERROR@+1: LOWERING/059 "mutable value-reference arguments must select nonoverlapping automatic objects or member slices"
  combine(value, value.first);
  return value;
}

// ====
using UInt4 = unsigned __attribute__((vector_size(16)));
static void update_lanes(unsigned& first, unsigned& second) {
  ++first;
  ++second;
}
UInt4 overlapping_vector_lanes(UInt4 values) {
  // ERROR@+1: LOWERING/059 "mutable value-reference arguments must select nonoverlapping automatic objects or member slices"
  update_lanes(values[0], values[1]);
  return values;
}

// ====
class [[loom::type("check.entropy")]] Entropy {};
static void replace_entropy(Entropy& value, Entropy replacement) {
  value = replacement;
}
Entropy opaque_copy(Entropy value, Entropy replacement) {
  const Entropy snapshot = value;
  // ERROR@+1: LOWERING/059 "copying an opaque dialect value across a mutable call requires a dialect-owned duplication operation"
  replace_entropy(value, replacement);
  return snapshot;
}

// ====
#include <loomcxx/pipeline.h>
using Payload = loom::type::tile<loom::type::shape<4>, unsigned>;
using Stream = loom::type::channel<Payload>;
static void replace_stream(Stream& stream, Stream replacement) {
  stream = replacement;
}
Stream channel_copy(Stream stream, Stream replacement) {
  const Stream snapshot = stream;
  // ERROR@+1: LOWERING/059 "channel capabilities cannot be structurally copied across a mutable call; use an explicit channel fanout or split operation"
  replace_stream(stream, replacement);
  return snapshot;
}
