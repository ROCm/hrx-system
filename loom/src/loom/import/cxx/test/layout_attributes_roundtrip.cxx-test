// RUN: roundtrip
// INPUT: cxx
#include "packed_layout.h"
unsigned stride() { return sizeof(Block<unsigned>); }
unsigned payload() { return __builtin_offsetof(Block<unsigned>, words); }
unsigned alignment() { return alignof(Block<unsigned>); }
// ----
func.def public @stride() -> (i32) {
  %1 = scalar.constant 18 : i64
  %2 = scalar.trunci %1 : i64 to i32
  func.return %2 : i32
}

func.def public @payload() -> (i32) {
  %4 = scalar.constant 2 : i64
  %5 = scalar.trunci %4 : i64 to i32
  func.return %5 : i32
}

func.def public @alignment() -> (i32) {
  %7 = scalar.constant 1 : i64
  %8 = scalar.trunci %7 : i64 to i32
  func.return %8 : i32
}

// ====
// INPUT: cxx
#include "aligned_layout.h"
AlignedWord add_aligned(AlignedWord lhs, AlignedWord rhs) { return lhs + rhs; }
unsigned typedef_alignment() { return alignof(AlignedWord); }
unsigned typedef_member_offset() { return __builtin_offsetof(TypedefAlignedMember, value); }
// ----
func.def public @add_aligned(%lhs: i32, %rhs: i32) -> (i32) {
  %3 = scalar.addi %lhs, %rhs : i32
  func.return %3 : i32
}

func.def public @typedef_alignment() -> (i32) {
  %5 = scalar.constant 16 : i64
  %6 = scalar.trunci %5 : i64 to i32
  func.return %6 : i32
}

func.def public @typedef_member_offset() -> (i32) {
  %8 = scalar.constant 16 : i64
  %9 = scalar.trunci %8 : i64 to i32
  func.return %9 : i32
}

// ====
// INPUT: cxx
[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void aligned_array(unsigned* output) {
  [[loom::workgroup]] unsigned __attribute__((aligned(32))) values[4];
  values[0] = 7;
  output[0] = values[0];
}

// ----
kernel.def @aligned_array() {
  %1 = index.constant 1 : index
  %2 = index.constant 1 : index
  %3 = index.constant 1 : index
  %4 = index.constant 1 : index
  %5 = index.constant 1 : index
  %6 = index.constant 1 : index
  kernel.launch.config workgroups(%1, %2, %3) workgroup_size(%4, %5, %6) : index
} launch(%output: buffer) {
  %output_byte_offset = index.constant 0 : offset
  %8 = index.constant 16 : offset
  %values = buffer.alloca<workgroup> align(32) %8 : buffer
  %values_byte_offset = index.constant 0 : offset
  %values_view = buffer.view %values[%values_byte_offset] : buffer -> view<4xi32>
  %12 = scalar.constant 7 : i32
  %13 = scalar.constant 0 : i32
  %14 = scalar.extsi %13 : i32 to i64
  %15 = scalar.assume %14 [range(%14, 0, 3)] : i64
  %16 = index.cast %15 : i64 to index
  view.store %12, %values_view[%16] : i32, view<4xi32>
  %17 = scalar.constant 0 : i32
  %18 = scalar.extsi %17 : i32 to i64
  %19 = scalar.assume %18 [range(%18, 0, 3)] : i64
  %20 = index.cast %19 : i64 to index
  %21 = view.load %values_view[%20] : view<4xi32> -> i32
  %22 = scalar.constant 0 : i32
  %23 = scalar.extsi %22 : i32 to i64
  %24 = scalar.constant 4 : i64
  %25 = scalar.muli %23, %24 : i64
  %26 = index.cast %output_byte_offset : offset to i64
  %27 = scalar.addi %26, %25 : i64
  %28 = scalar.assume %27 [range(%27, 0, 9223372036854775807)] : i64
  %29 = index.cast %28 : i64 to offset
  %30 = buffer.view %output[%29] : buffer -> view<1xi32>
  view.store %21, %30[0] : i32, view<1xi32>
  kernel.return
}
