// RUN: verify
// Increment rejects unprojected lvalues and source types.
unsigned entry() {
  const unsigned x = 1;
  // ERROR@+1: PARSE/036 "cannot increment a value of type 'const unsigned int'"
  return x++;
}

// ====
// Increment rejects unprojected lvalues and source types.
unsigned entry() {
  // ERROR@+1: LOWERING/059 "volatile objects require addressable storage"
  volatile unsigned x = 1;
  return ++x;
}

// ====
// Increment rejects unprojected lvalues and source types.
// ERROR@+1: LOWERING/059 "increment requires an integer or pointer binding"
float entry(float value) { return value++; }

// ====
// Increment rejects unprojected lvalues and source types.
extern unsigned value;
// ERROR@+1: LOWERING/059 "mutation requires an owned automatic source binding"
unsigned entry() { return ++value; }

// ====
// Increment rejects unprojected lvalues and source types.
using V = unsigned __attribute__((vector_size(16)));
// ERROR@+1: PARSE/036 "cannot increment a value of type 'unsigned int __attribute__((vector_size(4 * sizeof(unsigned int))))'"
V entry(V value) { return value++; }

// ====
// Global constants and unsupported storage.
// ERROR@+1: LOWERING/059 "global storage definitions require a global-storage projection"
int global = 3;
int entry() { return 1; }

// ====
// External storage cannot become an automatic binding.
extern int counter;
// ERROR@+1: LOWERING/059 "mutation requires an owned automatic source binding"
void entry() { counter = 3; }

// ====
// Storage updates preserve the pointee qualifier.
// ERROR@+1: LOWERING/059 "mutation requires a non-const destination"
void entry(const unsigned* words) { *words |= 1u; }

// ====
// User-defined operators do not acquire builtin read/modify/write semantics.
struct Word {
  // Stored arithmetic state.
  unsigned value;
  Word& operator+=(unsigned);
};
// ERROR@+1: LOWERING/059 "overloaded compound assignment is not admitted"
void entry(Word word) { word += 1u; }
