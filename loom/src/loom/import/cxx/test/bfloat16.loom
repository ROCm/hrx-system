kernel.decl @scale_bfloat_vectors() launch(%input: buffer, %output: buffer)

kernel.decl @convert_bfloat() launch(%input: buffer, %output: buffer, %expanded: buffer)

check.case public @bfloat_vectors {
  %input = check.generate.iota offset(0.0) step(0.125) : tensor<136xbf16>
  %output = check.generate.fill value(-37.0) : tensor<136xbf16>
  kernel.launch @scale_bfloat_vectors(%input, %output) : (tensor<136xbf16>, tensor<136xbf16>)
  %actual = check.tensor.view %output offset(8) : tensor<136xbf16> -> tensor<128xbf16>
  %expected = check.generate.iota offset(1.0) step(0.25) : tensor<128xbf16>
  check.expect.equal actual(%actual) expected(%expected) : tensor<128xbf16>
  %prefix = check.tensor.view %output offset(0) : tensor<136xbf16> -> tensor<4xbf16>
  %suffix = check.tensor.view %output offset(264) : tensor<136xbf16> -> tensor<4xbf16>
  %guard = check.generate.fill value(-37.0) : tensor<4xbf16>
  check.expect.equal actual(%prefix) expected(%guard) : tensor<4xbf16>
  check.expect.equal actual(%suffix) expected(%guard) : tensor<4xbf16>
  %unchanged = check.generate.iota offset(0.0) step(0.125) : tensor<136xbf16>
  check.expect.equal actual(%input) expected(%unchanged) : tensor<136xbf16>
  check.return
}

check.case public @bfloat_round_to_even {
  %input = check.generate.fill value(1.00390625) : tensor<32xf32>
  %output = check.generate.fill value(-37.0) : tensor<32xbf16>
  %expanded = check.generate.fill value(-37.0) : tensor<32xf32>
  kernel.launch @convert_bfloat(%input, %output, %expanded) : (tensor<32xf32>, tensor<32xbf16>, tensor<32xf32>)
  %expected_bfloat = check.generate.fill value(1.0) : tensor<32xbf16>
  %expected_float = check.generate.fill value(1.0) : tensor<32xf32>
  check.expect.equal actual(%output) expected(%expected_bfloat) : tensor<32xbf16>
  check.expect.equal actual(%expanded) expected(%expected_float) : tensor<32xf32>
  check.return
}

kernel.decl @convert_formats() launch(%input_half: buffer, %output_bfloat: buffer, %input_bfloat: buffer, %output_half: buffer)

check.case public @distinct_formats {
  %input_half = check.generate.fill value(1.0048828125) : tensor<32xf16>
  %output_bfloat = check.generate.fill value(-37.0) : tensor<32xbf16>
  %input_bfloat = check.generate.fill value(1.0078125) : tensor<32xbf16>
  %output_half = check.generate.fill value(-37.0) : tensor<32xf16>
  kernel.launch @convert_formats(%input_half, %output_bfloat, %input_bfloat, %output_half) : (tensor<32xf16>, tensor<32xbf16>, tensor<32xbf16>, tensor<32xf16>)
  %expected_bfloat = check.generate.fill value(1.0078125) : tensor<32xbf16>
  %expected_half = check.generate.fill value(1.0078125) : tensor<32xf16>
  check.expect.equal actual(%output_bfloat) expected(%expected_bfloat) : tensor<32xbf16>
  check.expect.equal actual(%output_half) expected(%expected_half) : tensor<32xf16>
  check.return
}
