// ====
// A reference result that always aliases one parameter reuses the evaluated
// argument. Mutable value-reference writeback becomes the same result value;
// multiple return statements may retain one common origin. Mixed origins keep
// durable pointer transport.
static unsigned& value_alias(unsigned& value) { return value; }
static unsigned& increment_alias(unsigned& value) { ++value; return value; }
static unsigned& branch_alias(bool condition, unsigned& value) {
  if (condition) return value;
  return value;
}
static unsigned& choose_alias(bool condition, unsigned& first, unsigned& second) {
  return condition ? first : second;
}

unsigned value_reference_results(bool condition, unsigned value) {
  const unsigned snapshot = value_alias(value) + 10u;
  const unsigned selected = branch_alias(condition, value) + 20u;
  return snapshot + selected;
}

unsigned mutable_reference_result(unsigned value) {
  return increment_alias(value);
}

unsigned mixed_reference_result(bool condition, unsigned first, unsigned second) {
  return choose_alias(condition, first, second);
}

