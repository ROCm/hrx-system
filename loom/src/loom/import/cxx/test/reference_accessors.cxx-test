struct DefaultReference {
  unsigned* pointer;
  unsigned& alias = *pointer;
};

unsigned default_reference(unsigned* values, unsigned amount) {
  DefaultReference reference{values};
  reference.alias += amount;
  return *reference.pointer;
}

