[[loom::symbol("deployment.array")]]
extern const loom::target::declaration rendered_target_deployment_array;

struct [[loom::target("target.generic")]] rendered_target_worker_target_type {
  const char* kind;
  const char* export_symbol;
  long long subgroup_size;
};
constexpr rendered_target_worker_target_type rendered_target_worker_target{
  .kind = "reference",
  .export_symbol = "resident_worker",
  .subgroup_size = 32,
};

[[loom::symbol("workers.adjust"), loom::target(rendered_target_deployment_array), loom::force_inline]]
unsigned workers_adjust(unsigned v21);

[[loom::pipeline("kernel"), loom::symbol("resident"), loom::target(rendered_target_deployment_array)]]
void resident(unsigned factor, loom::type::index column, loom::type::index count, [[loom::launch]] loom::type::buffer<unsigned char> output);

[[loom::pipeline("kernel"), loom::symbol("child")]]
void child(unsigned v19, [[loom::launch]] loom::type::buffer<unsigned char> v20);

[[loom::pipeline("kernel"), loom::symbol("resident"), loom::target(rendered_target_deployment_array)]]
void resident(unsigned factor, loom::type::index column, loom::type::index count, [[loom::launch]] loom::type::buffer<unsigned char> output) {
  auto pool = loom::pipeline::memory<loom::memory_space::workgroup>(loom::type::indices{column, loom::type::index{3}});
  auto* scratch = loom::buffer::alloca<unsigned char, loom::memory_space::workgroup, 64>(loom::type::index{256}, pool);
  loom::pipeline::compose<child>(factor, output);
  [[loom::strand(loom::type::indices{column, loom::type::index{2}}, loom::type::indices{count, loom::type::index{1}}, loom::type::indices{loom::type::index{1}, loom::type::index{1}}), loom::target(rendered_target_worker_target)]] {
    auto scratch_view = loom::buffer::view<256>(scratch, {});
    unsigned workitem = static_cast<unsigned>(loom::kernel::workitem::id.x);
    unsigned v15 = workers_adjust(workitem);
    loom::view::store(loom::convert<unsigned char>(v15), scratch_view, loom::type::index{0});
  }
}

