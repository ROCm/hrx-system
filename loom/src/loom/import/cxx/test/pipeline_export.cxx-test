// ====
#include <loomcxx/pipeline.h>

namespace loomt = loom::type;
using Layout = loomt::encoding<loom::encoding::role::layout, 2>;
using Payload = loomt::tile<loomt::shape<loomt::dynamic, 4>, float, Layout>;
using Stream = loomt::channel<Payload>;
using Slots = loomt::view<loomt::shape<2, loomt::dynamic, 4>, float>;
using PayloadView = loomt::view<loomt::shape<loomt::dynamic, 4>, const float, Layout>;

float first(PayloadView payload) { return loom::view::load(payload, 0, 0); }

float consume(Stream input) {
  auto read = loom::channel::accept(input);
  auto payload = loom::channel::wait(read);
  auto value = first(payload);
  loom::channel::release(read);
  return value;
}

[[loom::pipeline("kernel")]] void sink([[loom::launch]] Stream input);

[[loom::pipeline("kernel")]] void streaming(loomt::index column, loomt::index capacity, Layout payload_layout, [[loom::launch]] Slots slots) {
  auto input = loom::channel::bind<loom::channel::discipline::fifo>(slots, capacity, payload_layout);
  loom::pipeline::compose<sink>(input);
  [[loom::strand(loomt::indices{column, loomt::index{2}}, loomt::indices{capacity, loomt::index{1}}, loomt::indices{loomt::index{1}, loomt::index{1}})]] {
    auto reservation = loom::channel::reserve(input);
    loom::view::store(1.0f, reservation.payload, 0, 0);
    loom::channel::publish(reservation.write);

    auto acquisition = loom::channel::acquire(input);
    auto observed = loom::view::load(acquisition.payload, 0, 0);
    (void)observed;
    auto readers = loom::channel::fanout<2>(acquisition.read);
    loom::channel::release(readers.first);
    loom::channel::release(readers.second);

    auto pending = loom::channel::accept(input);
    auto payload = loom::channel::wait(pending);
    (void)loom::view::load(payload, 0, 0);
    loom::channel::release(pending);

    auto mutable_read = loom::channel::accept<loom::channel::mode::mutable_>(input);
    auto mutable_payload = loom::channel::wait(mutable_read);
    loom::view::store(2.0f, mutable_payload, 0, 0);
    loom::channel::release(mutable_read);

    auto source = loom::channel::accept(input);
    auto destination = loom::channel::reserve(input);
    loom::channel::copy(source, destination.write);

    auto selected = loom::channel::select(input);
    (void)selected.source_rank;
    loom::channel::release(selected.read);
    (void)consume(input);
  }
}

