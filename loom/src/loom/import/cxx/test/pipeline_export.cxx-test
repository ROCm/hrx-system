[[loom::symbol("first")]]
float first(loom::type::view<loom::type::shape<loom::type::dynamic, 4>, const float, loom::type::encoding<loom::encoding::role::layout, 2>> payload);

[[loom::symbol("consume")]]
float consume(loom::type::channel<loom::type::tile<loom::type::shape<loom::type::dynamic, 4>, float, loom::type::encoding<loom::encoding::role::layout, 2>>> input);

[[loom::pipeline("kernel"), loom::symbol("streaming")]]
void streaming(loom::type::index column, loom::type::index capacity, loom::type::encoding<loom::encoding::role::layout> payload_layout, [[loom::launch]] loom::type::view<loom::type::shape<2, loom::type::dynamic, 4>, float> slots);

[[loom::pipeline("kernel"), loom::symbol("sink")]]
void sink([[loom::launch]] loom::type::channel<loom::type::tile<loom::type::shape<loom::type::dynamic, 4>, float, loom::type::encoding<loom::encoding::role::layout, 2>>> v60);

[[loom::symbol("first")]]
float first(loom::type::view<loom::type::shape<loom::type::dynamic, 4>, const float, loom::type::encoding<loom::encoding::role::layout, 2>> payload) {
  float v8 = loom::view::load(payload, loom::type::index{0}, loom::type::index{0});
  return v8;
}

[[loom::symbol("consume")]]
float consume(loom::type::channel<loom::type::tile<loom::type::shape<loom::type::dynamic, 4>, float, loom::type::encoding<loom::encoding::role::layout, 2>>> input) {
  auto read = loom::channel::accept(input);
  auto payload = loom::channel::wait(read);
  float value = first(payload);
  loom::channel::release(read);
  return value;
}

[[loom::pipeline("kernel"), loom::symbol("streaming")]]
void streaming(loom::type::index column, loom::type::index capacity, loom::type::encoding<loom::encoding::role::layout> payload_layout, [[loom::launch]] loom::type::view<loom::type::shape<2, loom::type::dynamic, 4>, float> slots) {
  auto input = loom::channel::bind<loom::channel::discipline::fifo>(slots, capacity, payload_layout);
  loom::pipeline::compose<sink>(input);
  [[loom::strand(loom::type::indices{column, loom::type::index{2}}, loom::type::indices{capacity, loom::type::index{1}}, loom::type::indices{loom::type::index{1}, loom::type::index{1}})]] {
    auto reservation = loom::channel::reserve(input);
    loom::view::store(1.0f, reservation.payload, loom::type::index{0}, loom::type::index{0});
    loom::channel::publish(reservation.write);
    auto acquisition = loom::channel::acquire(input);
    float observed = loom::view::load(acquisition.payload, loom::type::index{0}, loom::type::index{0});
    auto fanout = loom::channel::fanout<2>(acquisition.read);
    loom::channel::release(fanout.first);
    loom::channel::release(fanout.second);
    auto pending = loom::channel::accept(input);
    auto payload = loom::channel::wait(pending);
    float v44 = loom::view::load(payload, loom::type::index{0}, loom::type::index{0});
    loom::channel::release(pending);
    auto mutable_read = loom::channel::accept<loom::channel::mode::mutable_>(input);
    auto mutable_payload = loom::channel::wait(mutable_read);
    loom::view::store(2.0f, mutable_payload, loom::type::index{0}, loom::type::index{0});
    loom::channel::release(mutable_read);
    auto source = loom::channel::accept(input);
    auto reservation_2 = loom::channel::reserve(input);
    loom::channel::copy(source, reservation_2.write);
    auto selection = loom::channel::select(input);
    loom::channel::release(selection.read);
    float v57 = consume(input);
  }
}

