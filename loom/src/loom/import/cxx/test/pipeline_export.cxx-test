[[loom::config("pipeline.byte"), loom::where(loom::predicate::range(static_cast<unsigned char>(1), static_cast<unsigned char>(127)))]]
extern const unsigned char byte;

[[loom::symbol("configured_scalars")]]
float configured_scalars();

[[loom::symbol("configured_scalars")]]
float configured_scalars() {
  float v5 = float{};
  if (enabled) {
    v5 = scale;
  } else {
    v5 = loom::convert<float>(byte);
  }
  return v5;
}
