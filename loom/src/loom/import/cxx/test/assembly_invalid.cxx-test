// RUN: verify
#include <loomcxx/low.h>
struct Contract {};
int entry(int value) {
  // ERROR@+1: LOWERING/059 "assembly contract type requires loom::representation"
  return loom::low::assembly<Contract, int>(R"(() {})", value);
}

// ====
#include <loomcxx/low.h>
// ERROR@+1: LOWERING/059 "assembly contract requires one nonempty string representation binding"
struct [[loom::representation("test.low.core", 42)]] Contract {};
int entry(int value) {
  return loom::low::assembly<Contract, int>(R"(() {})", value);
}

// ====
#include <loomcxx/low.h>
// ERROR@+1: LOWERING/059 "assembly contract requires one nonempty string representation binding"
struct [[loom::representation("test.low.core"), loom::representation("test.low.alt")]] Contract {};
int entry(int value) {
  return loom::low::assembly<Contract, int>(R"(() {})", value);
}

// ====
#include <loomcxx/low.h>
struct [[loom::representation("test.low.core")]] Contract {};
int entry(int value) {
  // ERROR@+1: LOWERING/059 "assembly requires one narrow raw string literal"
  return loom::low::assembly<Contract, int>("() {}", value);
}

// ====
#include <loomcxx/low.h>
struct [[loom::representation("test.low.core")]] Contract {};
int entry(int value) {
  // ERROR@+1: LOWERING/059 "assembly requires one narrow raw string literal"
  return loom::low::assembly<Contract, int>(R"(() )" R"({})", value);
}

// ====
#include <loomcxx/low.h>
struct [[loom::representation("test.low.core")]] Contract {};
int entry(int value) {
  // ERROR@+1: LOWERING/059 "assembly register signature must match the C++ operand and result counts"
  return loom::low::assembly<Contract, int>(R"(
      (%value: reg<test.i32>) -> (reg<test.i32>) { return %value }
  )");
}

// ====
#include <loomcxx/low.h>
struct [[loom::representation("test.low.core")]] Contract {};
int entry(int value) {
  // ERROR@+1: LOWERING/059 "assembly register signature must match the C++ operand and result counts"
  return loom::low::assembly<Contract, int>(R"(() { return })");
}

// ====
#include <loomcxx/low.h>
struct [[loom::representation("test.low.core")]] Contract {};
int entry(int value) {
  return loom::low::assembly<Contract, int>(R"(
      (%value: reg<test.i32>) -> (reg<test.i32>) {
        // ERROR@+1: PARSE/034 "invalid low asm syntax: unknown low asm mnemonic"
        unknown_instruction %value
        return %value
      }
  )", value);
}

// ====
#include <loomcxx/low.h>
struct [[loom::representation("test.low.missing")]] Contract {};
int entry(int value) {
  return loom::low::assembly<Contract, int>(R"(
      // ERROR@+1: PARSE/034 "invalid low asm syntax: function representation contract is not available"
      (%value: reg<test.i32>) -> (reg<test.i32>) { return %value }
  )", value);
}

// ====
#include <loomcxx/low.h>
struct [[loom::representation("test.low.core")]] Contract {};
int entry(int value) {
  return loom::low::assembly<Contract, int>(R"(
      // ERROR@+1: PARSE/001 "undefined SSA value '%outer'"
      (%value: reg<test.i32>) -> (reg<test.i32>) { return %outer }
  )", value);
}

// ====
#include <loomcxx/low.h>
struct [[loom::representation("test.low.core")]] Contract {};
// Parsed bodies are verified together with their original source snapshots.
int missing_result(int value) {
  return loom::low::assembly<Contract, int>(R"(
      // ERROR@+1: STRUCTURE/008 "yield has 0 operands, expected 1"
      (%value: reg<test.i32>) -> (reg<test.i32>) { return }
  )", value);
}
int wrong_result(int value) {
  return loom::low::assembly<Contract, int>(R"(
      // ERROR@+1: TYPE/009 "yielded value has type reg<test.i32>, but expected reg<test.i32 x2>"
      (%value: reg<test.i32>) -> (reg<test.i32 x2>) { return %value }
  )", value);
}

// ====
// Shaped objects do not silently become native addresses, including when
// hidden inside a result record.
#include <loomcxx/view.h>
#include <loomcxx/low.h>
struct [[loom::representation("test.low.core")]] Contract {};
struct Result {
  // Shaped values have no native register ABI.
  loom::type::view<loom::type::shape<4>, unsigned> value;
};
Result invalid(loom::type::buffer<unsigned> value) {
  // ERROR@+1: LOWERING/059 "assembly values require scalar, vector, buffer, or opaque dialect components"
  return loom::low::assembly<Contract, Result>(R"(
      (%value: reg<test.ptr>) -> (reg<test.ptr>) { return %value }
  )", value);
}

// ====
#include <loomcxx/view.h>
#include <loomcxx/low.h>
struct [[loom::representation("test.low.core")]] Contract {};
void invalid(loom::type::view<loom::type::shape<4>, unsigned> value) {
  // ERROR@+1: LOWERING/059 "assembly values require scalar, vector, buffer, or opaque dialect components"
  loom::low::assembly<Contract, void>(R"(() { return })", value);
}

// ====
#include <loomcxx/encoding_type.h>
#include <loomcxx/low.h>
struct [[loom::representation("test.low.core")]] Contract {};
using Layout = loom::type::encoding<loom::encoding::role::layout, 1>;
Layout invalid(Layout value) {
  // ERROR@+1: LOWERING/059 "assembly values require scalar, vector, buffer, or opaque dialect components"
  return loom::low::assembly<Contract, Layout>(R"(() { return })", value);
}

// ====
#include <loomcxx/view.h>
#include <loomcxx/low.h>
struct [[loom::representation("test.low.core")]] Contract {};
using Dynamic = loom::type::view<loom::type::shape<loom::type::dynamic>, unsigned>;
struct Result {
  // A dependent field requires source value identities.
  Dynamic value;
};
Result invalid() {
  // ERROR@+1: LOWERING/059 "dependent source values require reserved destination identities"
  return loom::low::assembly<Contract, Result>(R"(() { return })");
}

// ====
#include <loomcxx/check.h>
#include <loomcxx/low.h>
struct [[loom::representation("test.low.core")]] Contract {};
using Tensor = loom::type::tensor<loom::type::shape<4>, unsigned>;
Tensor invalid(Tensor value) {
  // ERROR@+1: LOWERING/059 "assembly values require scalar, vector, buffer, or opaque dialect components"
  return loom::low::assembly<Contract, Tensor>(R"(() { return })", value);
}
