// RUN: verify
// The pointer object itself has no memory backing in SSA transport.
// ERROR@+1: LOWERING/059 "stored pointers and references require an object storage representation"
unsigned pointer_object(unsigned* volatile input) { return *input; }

// ====
// Whole-record initialization needs aggregate memory operations rather than a
// scalar or vector store.
struct Record { unsigned value; };
// ERROR@+1: LOWERING/059 "addressable record parameters require aggregate object initialization"
unsigned record_object(volatile Record input) { return input.value; }

// ====
// Namespace storage cannot be substituted with a volatile initializer.
// ERROR@+1: LOWERING/059 "global storage definitions require a global-storage projection"
const volatile unsigned observed = 7;
unsigned global_observation() { return observed; }

// ====
// A const volatile access still cannot write its observed object.
// ERROR@+1: LOWERING/059 "mutation requires a non-const destination"
void constant_observation(const volatile unsigned* input) { *input = 7; }

// ====
// Volatile overloads preserve the view's read-only element contract.
#include <loomcxx/view.h>
template <class View>
concept Writable = requires(View destination) {
  loom::view::store(7u, destination, 0, 0);
};
static_assert(Writable<loom::type::view<unsigned, 2, 4>>);
static_assert(Writable<loom::type::view<volatile unsigned, 2, 4>>);
static_assert(!Writable<loom::type::view<const unsigned, 2, 4>>);
static_assert(!Writable<loom::type::view<const volatile unsigned, 2, 4>>);
