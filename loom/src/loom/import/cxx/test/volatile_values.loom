// The source helper receives real storage through the ordinary callable ABI.
func.decl @volatile_word(%input: buffer, %input_origin: offset, %output: buffer, %output_origin: offset) -> (i32)

func.decl @volatile_parameter(%value: i32) -> (i32)

func.def @memory_observations(%initial: i32) -> (i32, i32, i32, i32, i32) {
  %bytes = index.constant 16 : offset
  %storage = buffer.alloca<private> align(4) %bytes : buffer
  %storage_origin = index.constant 0 : offset
  %view = buffer.view %storage[%storage_origin] : buffer -> view<4xi32>
  %guard = scalar.constant -123 : i32
  view.store %guard, %view[0] : i32, view<4xi32>
  view.store %initial, %view[1] : i32, view<4xi32>
  view.store %guard, %view[2] : i32, view<4xi32>
  view.store %guard, %view[3] : i32, view<4xi32>
  %input_origin = index.constant 4 : offset
  %output_origin = index.constant 8 : offset
  %returned = func.call @volatile_word(%storage, %input_origin, %storage, %output_origin) : (buffer, offset, buffer, offset) -> (i32)
  %before = view.load %view[0] : view<4xi32> -> i32
  %input = view.load %view[1] : view<4xi32> -> i32
  %output = view.load %view[2] : view<4xi32> -> i32
  %after = view.load %view[3] : view<4xi32> -> i32
  func.return %returned, %input, %output, %before, %after : i32, i32, i32, i32, i32
}

check.case @qualified_pointer_observations {
  %initial = check.literal value(2147483647) : i32
  %returned, %input, %output, %before, %after = func.call @memory_observations(%initial) : (i32) -> (i32, i32, i32, i32, i32)
  %expected = check.literal value(-2) : i32
  %guard = check.literal value(-123) : i32
  check.expect.equal actual(%returned) expected(%expected) : i32
  check.expect.equal actual(%input) expected(%initial) : i32
  check.expect.equal actual(%output) expected(%expected) : i32
  check.expect.equal actual(%before) expected(%guard) : i32
  check.expect.equal actual(%after) expected(%guard) : i32
  check.return
}

check.case @qualified_parameter_observations {
  %zero = check.literal value(0) : i32
  %high = check.literal value(2147483647) : i32
  %all = check.literal value(-1) : i32
  %actual_zero = func.call @volatile_parameter(%zero) : (i32) -> (i32)
  %actual_high = func.call @volatile_parameter(%high) : (i32) -> (i32)
  %actual_all = func.call @volatile_parameter(%all) : (i32) -> (i32)
  check.expect.equal actual(%actual_zero) expected(%zero) : i32
  check.expect.equal actual(%actual_high) expected(%high) : i32
  check.expect.equal actual(%actual_all) expected(%all) : i32
  check.return
}
