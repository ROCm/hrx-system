// ====
// An outer zero phase is retained while nested default constructors run for
// records and every array element.
struct Inner { unsigned value = 9u; };
struct Outer { Inner inner; Inner values[2]; };
Outer nested() { return Outer(); }
struct Plain { unsigned value; };
struct PlainOuter { Plain inner; Plain values[2]; };
PlainOuter zeroed() { return PlainOuter(); }
using Int4 = int __attribute__((ext_vector_type(4)));
struct VectorZero {
  Int4 lanes;
  int first = lanes[0];
};
VectorZero zeroed_vector() { return VectorZero(); }
// ----
func.def public @nested() -> (i32, i32, i32) {
  %6 = scalar.constant 9 : i32
  func.return %6, %6, %6 : i32, i32, i32
}

func.def public @zeroed() -> (i32, i32, i32) {
  %zero$i32 = scalar.constant 0 : i32
  func.return %zero$i32, %zero$i32, %zero$i32 : i32, i32, i32
}

func.def public @zeroed_vector() -> (vector<4xi32>, i32) {
  %17 = scalar.constant 0 : i32
  %24 = vector.constant 0 : vector<4xi32>
  func.return %24, %17 : vector<4xi32>, i32
}

// ====
// Addressable records execute the same plan in source-layout storage, including
// volatile observations and a default that reads a later zeroed member.
struct ZeroPhase {
  unsigned copy = later;
  unsigned later;
};
unsigned stored_zero_phase() {
  volatile ZeroPhase value = ZeroPhase();
  return value.copy + value.later;
}
struct NestedZeroPhase {
  ZeroPhase inner;
  ZeroPhase values[2];
};
unsigned stored_nested_zero_phase() {
  volatile NestedZeroPhase value = NestedZeroPhase();
  return value.inner.copy + value.values[0].copy + value.values[1].later;
}
