// Complete byte oracles include every alignment residue, input and guards.
func.decl @packed_copy(%input: buffer, %input_origin: offset, %output: buffer, %output_origin: offset)

func.def @observations() -> (i1) {
  %bytes = index.constant 256 : offset
  %input = buffer.alloca<private> align(64) %bytes : buffer
  %output = buffer.alloca<private> align(64) %bytes : buffer
  %origin = index.constant 0 : offset
  %source = buffer.view %input[%origin] : buffer -> view<256xi8>
  %destination = buffer.view %output[%origin] : buffer -> view<256xi8>
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %end = index.constant 256 : index
  scf.for %i = [%begin to %end step %step] {
    %word = index.cast %i : index to i32
    %byte = scalar.trunci %word : i32 to i8
    view.store %byte, %source[%i] : i8, view<256xi8>
  }
  func.call @packed_copy(%input, %origin, %output, %origin) : (buffer, offset, buffer, offset)
  %true = scalar.constant true : i1
  %body_begin = scalar.constant 5 : i32
  %limit = scalar.constant 125 : i32
  %origin_delta = scalar.constant 4 : i32
  %guard = scalar.constant 37 : i32
  %valid = scf.for %i = [%begin to %end step %step](%matches = %true : i1) -> (i1) {
    %word = index.cast %i : index to i32
    %input_actual = view.load %source[%i] : view<256xi8> -> i8
    %input_word = scalar.extui %input_actual : i8 to i32
    %input_equal = scalar.cmpi eq, %input_word, %word : i32
    %body_word = scalar.subi %word, %origin_delta : i32
    %begins = scalar.cmpi uge, %word, %body_begin : i32
    %ends = scalar.cmpi ult, %word, %limit : i32
    %inside = scalar.andi %begins, %ends : i1
    %expected = scf.select %inside, %body_word, %guard : i32
    %actual = view.load %destination[%i] : view<256xi8> -> i8
    %actual_word = scalar.extui %actual : i8 to i32
    %equal = scalar.cmpi eq, %actual_word, %expected : i32
    %both = scalar.andi %input_equal, %equal : i1
    %all = scalar.andi %matches, %both : i1
    scf.yield %all : i1
  }
  func.return %valid : i1
}

check.case @packed_origins {
  %actual = func.call @observations() : () -> (i1)
  %expected = check.literal value(true) : i1
  check.expect.equal actual(%actual) expected(%expected) : i1
  check.return
}

func.decl @packed_update(%output: buffer, %output_origin: offset)

func.def @update_observations() -> (i1) {
  %length = index.constant 64 : offset
  %output = buffer.alloca<private> align(8) %length : buffer
  %origin = index.constant 0 : offset
  %bytes = buffer.view %output[%origin] : buffer -> view<64xi8>
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %end = index.constant 64 : index
  %guard_byte = scalar.constant 37 : i8
  scf.for %i = [%begin to %end step %step] {
    view.store %guard_byte, %bytes[%i] : i8, view<64xi8>
  }
  func.call @packed_update(%output, %origin) : (buffer, offset)
  %true = scalar.constant true : i1
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %c29 = scalar.constant 29 : i32
  %c31 = scalar.constant 31 : i32
  %c32 = scalar.constant 32 : i32
  %c34 = scalar.constant 34 : i32
  %c37 = scalar.constant 37 : i32
  %c38 = scalar.constant 38 : i32
  %c64 = scalar.constant 64 : i32
  %valid = scf.for %i = [%begin to %end step %step](%matches = %true : i1) -> (i1) {
    %position = index.cast %i : index to i32
    %begins = scalar.cmpi uge, %position, %c29 : i32
    %ends = scalar.cmpi ult, %position, %c38 : i32
    %inside = scalar.andi %begins, %ends : i1
    %initial = scf.select %inside, %c0, %c37 : i32
    %is31 = scalar.cmpi eq, %position, %c31 : i32
    %with31 = scf.select %is31, %c32, %initial : i32
    %is32 = scalar.cmpi eq, %position, %c32 : i32
    %is37 = scalar.cmpi eq, %position, %c37 : i32
    %is64 = scalar.ori %is32, %is37 : i1
    %with64 = scf.select %is64, %c64, %with31 : i32
    %is34 = scalar.cmpi eq, %position, %c34 : i32
    %expected = scf.select %is34, %c1, %with64 : i32
    %actual = view.load %bytes[%i] : view<64xi8> -> i8
    %word = scalar.extui %actual : i8 to i32
    %equal = scalar.cmpi eq, %word, %expected : i32
    %all = scalar.andi %matches, %equal : i1
    scf.yield %all : i1
  }
  func.return %valid : i1
}

check.case @packed_updates {
  %actual = func.call @update_observations() : () -> (i1)
  %expected = check.literal value(true) : i1
  check.expect.equal actual(%actual) expected(%expected) : i1
  check.return
}
