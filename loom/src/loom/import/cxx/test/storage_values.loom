func.def @floats_observations() -> (f32, f32, f32, f32, f32) {
  %bytes = index.constant 16 : offset
  %storage = buffer.alloca<private> align(4) %bytes : buffer
  %origin = index.constant 0 : offset
  %view = buffer.view %storage[%origin] : buffer -> view<4xf32>
  %guard = scalar.constant 37.0 : f32
  view.store %guard, %view[0] : f32, view<4xf32>
  view.store %guard, %view[3] : f32, view<4xf32>
  %returned = func.call @storage_floats(%storage, %origin) : (buffer, offset) -> (f32)
  %before = view.load %view[0] : view<4xf32> -> f32
  %first = view.load %view[1] : view<4xf32> -> f32
  %second = view.load %view[2] : view<4xf32> -> f32
