check.case @floats_values {
  %returned, %before, %first, %second, %after = func.call @floats_observations() : () -> (f32, f32, f32, f32, f32)
  %expected_returned = check.literal value(1.5) : f32
  %guard = check.literal value(37.0) : f32
  %expected_first = check.literal value(3.25) : f32
  %expected_second = check.literal value(-2.0) : f32
  check.expect.equal actual(%returned) expected(%expected_returned) : f32
  check.expect.equal actual(%before) expected(%guard) : f32
  check.expect.equal actual(%first) expected(%expected_first) : f32
  check.expect.equal actual(%second) expected(%expected_second) : f32
  check.expect.equal actual(%after) expected(%guard) : f32
  check.return
}

// Signed division is admitted by the importer and executes on the VM.
func.decl @storage_divide(%storage: buffer, %origin: offset) -> (i32)

func.def @division_observations() -> (i32, i8, i8, i8) {
  %bytes = index.constant 3 : offset
  %storage = buffer.alloca<private> align(1) %bytes : buffer
  %origin = index.constant 0 : offset
  %view = buffer.view %storage[%origin] : buffer -> view<3xi8>
  %guard = scalar.constant 37 : i8
  view.store %guard, %view[0] : i8, view<3xi8>
  view.store %guard, %view[2] : i8, view<3xi8>
  %returned = func.call @storage_divide(%storage, %origin) : (buffer, offset) -> (i32)
  %before = view.load %view[0] : view<3xi8> -> i8
  %value = view.load %view[1] : view<3xi8> -> i8
  %after = view.load %view[2] : view<3xi8> -> i8
  func.return %returned, %before, %value, %after : i32, i8, i8, i8
}

check.case @division_values {
  %returned, %before, %value, %after = func.call @division_observations() : () -> (i32, i8, i8, i8)
  %expected_returned = check.literal value(-41) : i32
  %expected_value = check.literal value(-41) : i8
  %guard = check.literal value(37) : i8
  check.expect.equal actual(%returned) expected(%expected_returned) : i32
  check.expect.equal actual(%before) expected(%guard) : i8
  check.expect.equal actual(%value) expected(%expected_value) : i8
  check.expect.equal actual(%after) expected(%guard) : i8
  check.return
}
