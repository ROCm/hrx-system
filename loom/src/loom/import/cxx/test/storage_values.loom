// Real storage crosses the ordinary C++ callable boundary.

func.decl @storage_words(%storage: buffer, %origin: offset) -> (i32)

func.def @words_observations() -> (i32, i32, i32, i32, i32) {
  %bytes = index.constant 16 : offset
  %storage = buffer.alloca<private> align(4) %bytes : buffer
  %origin = index.constant 0 : offset
  %view = buffer.view %storage[%origin] : buffer -> view<4xi32>
  %guard = scalar.constant 37 : i32
  view.store %guard, %view[0] : i32, view<4xi32>
  view.store %guard, %view[3] : i32, view<4xi32>
  %returned = func.call @storage_words(%storage, %origin) : (buffer, offset) -> (i32)
  %before = view.load %view[0] : view<4xi32> -> i32
  %first = view.load %view[1] : view<4xi32> -> i32
  %second = view.load %view[2] : view<4xi32> -> i32
  %after = view.load %view[3] : view<4xi32> -> i32
  func.return %returned, %before, %first, %second, %after : i32, i32, i32, i32, i32
}

check.case @words_values {
  %returned, %before, %first, %second, %after = func.call @words_observations() : () -> (i32, i32, i32, i32, i32)
  %expected_returned = check.literal value(1489) : i32
  %guard = check.literal value(37) : i32
  %expected_first = check.literal value(38) : i32
  %expected_second = check.literal value(12) : i32
  check.expect.equal actual(%returned) expected(%expected_returned) : i32
  check.expect.equal actual(%before) expected(%guard) : i32
  check.expect.equal actual(%first) expected(%expected_first) : i32
  check.expect.equal actual(%second) expected(%expected_second) : i32
  check.expect.equal actual(%after) expected(%guard) : i32
  check.return
}

