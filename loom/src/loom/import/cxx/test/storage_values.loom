func.decl @storage_bytes(%storage: buffer, %origin: offset) -> (i32)

func.def @bytes_observations() -> (i32, i8, i8, i8, i8) {
  %bytes = index.constant 4 : offset
  %storage = buffer.alloca<private> align(1) %bytes : buffer
  %origin = index.constant 0 : offset
  %view = buffer.view %storage[%origin] : buffer -> view<4xi8>
  %guard = scalar.constant 37 : i8
  view.store %guard, %view[0] : i8, view<4xi8>
  view.store %guard, %view[3] : i8, view<4xi8>
  %returned = func.call @storage_bytes(%storage, %origin) : (buffer, offset) -> (i32)
  %before = view.load %view[0] : view<4xi8> -> i8
  %first = view.load %view[1] : view<4xi8> -> i8
  %second = view.load %view[2] : view<4xi8> -> i8
  %after = view.load %view[3] : view<4xi8> -> i8
  func.return %returned, %before, %first, %second, %after : i32, i8, i8, i8, i8
}

check.case @bytes_values {
  %returned, %before, %first, %second, %after = func.call @bytes_observations() : () -> (i32, i8, i8, i8, i8)
  %expected_returned = check.literal value(555) : i32
  %guard = check.literal value(37) : i8
  %expected_first = check.literal value(0) : i8
  %expected_second = check.literal value(3) : i8
  check.expect.equal actual(%returned) expected(%expected_returned) : i32
  check.expect.equal actual(%before) expected(%guard) : i8
  check.expect.equal actual(%first) expected(%expected_first) : i8
  check.expect.equal actual(%second) expected(%expected_second) : i8
  check.expect.equal actual(%after) expected(%guard) : i8
