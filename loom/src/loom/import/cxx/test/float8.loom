  %e4m3 = check.generate.fill value(85) : tensor<32xi8>
  %e5m2 = check.generate.fill value(85) : tensor<32xi8>
  kernel.launch @encode_float8(%input, %e4m3, %e5m2) : (tensor<32xi32>, tensor<32xi8>, tensor<32xi8>)
  %expected_e4m3 = check.generate.fill value(56) : tensor<32xi8>
  %expected_e5m2 = check.generate.fill value(60) : tensor<32xi8>
  check.expect.equal actual(%e4m3) expected(%expected_e4m3) : tensor<32xi8>
  check.expect.equal actual(%e5m2) expected(%expected_e5m2) : tensor<32xi8>
