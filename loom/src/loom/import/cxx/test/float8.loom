kernel.decl @encode_float8() launch(%input: buffer, %e4m3: buffer, %e5m2: buffer)

kernel.decl @decode_float8() launch(%e4m3: buffer, %e5m2: buffer, %bfloat: buffer, %half: buffer, %converted_e5m2: buffer, %converted_e4m3: buffer)

kernel.decl @copy_float8_vectors() launch(%input: buffer, %output: buffer)

kernel.decl @constant_float8_vectors() launch(%e4m3: buffer, %e5m2: buffer)

kernel.decl @constant_float8_midpoints() launch(%e4m3: buffer, %e5m2: buffer)

// Input is the exact F32 payload; expected results are independent FP8 bytes.
check.case public @positive_infinity {
  %input = check.generate.fill value(2139095040) : tensor<32xi32>
  %e4m3 = check.generate.fill value(85) : tensor<32xi8>
  %e5m2 = check.generate.fill value(85) : tensor<32xi8>
  kernel.launch @encode_float8(%input, %e4m3, %e5m2) : (tensor<32xi32>, tensor<32xi8>, tensor<32xi8>)
  %expected_e4m3 = check.generate.fill value(126) : tensor<32xi8>
  %expected_e5m2 = check.generate.fill value(124) : tensor<32xi8>
  check.expect.equal actual(%e4m3) expected(%expected_e4m3) : tensor<32xi8>
  check.expect.equal actual(%e5m2) expected(%expected_e5m2) : tensor<32xi8>
  check.return
}

check.case public @negative_infinity {
  %input = check.generate.fill value(-8388608) : tensor<32xi32>
  %e4m3 = check.generate.fill value(85) : tensor<32xi8>
  %e5m2 = check.generate.fill value(85) : tensor<32xi8>
  kernel.launch @encode_float8(%input, %e4m3, %e5m2) : (tensor<32xi32>, tensor<32xi8>, tensor<32xi8>)
  %expected_e4m3 = check.generate.fill value(-2) : tensor<32xi8>
  %expected_e5m2 = check.generate.fill value(-4) : tensor<32xi8>
  check.expect.equal actual(%e4m3) expected(%expected_e4m3) : tensor<32xi8>
  check.expect.equal actual(%e5m2) expected(%expected_e5m2) : tensor<32xi8>
  check.return
}

