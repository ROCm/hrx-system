check.case public @widen_and_convert_formats {
  %e4m3 = check.generate.fill value(1.125) : tensor<32xf8E4M3>
  %e5m2 = check.generate.fill value(512.0) : tensor<32xf8E5M2>
  %bfloat = check.generate.fill value(-37.0) : tensor<32xbf16>
  %half = check.generate.fill value(-37.0) : tensor<32xf16>
  %converted_e5m2 = check.generate.fill value(-37.0) : tensor<32xf8E5M2>
  %converted_e4m3 = check.generate.fill value(-37.0) : tensor<32xf8E4M3>
  kernel.launch @decode_float8(%e4m3, %e5m2, %bfloat, %half, %converted_e5m2, %converted_e4m3) : (tensor<32xf8E4M3>, tensor<32xf8E5M2>, tensor<32xbf16>, tensor<32xf16>, tensor<32xf8E5M2>, tensor<32xf8E4M3>)
  %expected_bfloat = check.generate.fill value(1.125) : tensor<32xbf16>
  %expected_half = check.generate.fill value(512.0) : tensor<32xf16>
  %expected_e5m2 = check.generate.fill value(1.0) : tensor<32xf8E5M2>
  %expected_e4m3 = check.generate.fill value(448.0) : tensor<32xf8E4M3>
  check.expect.bitwise actual(%bfloat) expected(%expected_bfloat) : tensor<32xbf16>
  check.expect.bitwise actual(%half) expected(%expected_half) : tensor<32xf16>
  check.expect.bitwise actual(%converted_e5m2) expected(%expected_e5m2) : tensor<32xf8E5M2>
  check.expect.bitwise actual(%converted_e4m3) expected(%expected_e4m3) : tensor<32xf8E4M3>
  check.return
}

check.case public @vector_storage {
  %input = check.generate.iota offset(-4.0) step(0.0625) : tensor<136xf8E4M3>
  %output = check.generate.fill value(-37.0) : tensor<136xf8E4M3>
  kernel.launch @copy_float8_vectors(%input, %output) : (tensor<136xf8E4M3>, tensor<136xf8E4M3>)
  %actual = check.tensor.view %output offset(4) : tensor<136xf8E4M3> -> tensor<128xf8E4M3>
  %expected = check.generate.iota offset(-3.75) step(0.0625) : tensor<128xf8E4M3>
  check.expect.bitwise actual(%actual) expected(%expected) : tensor<128xf8E4M3>
  %prefix = check.tensor.view %output offset(0) : tensor<136xf8E4M3> -> tensor<4xf8E4M3>
  %suffix = check.tensor.view %output offset(132) : tensor<136xf8E4M3> -> tensor<4xf8E4M3>
  %guard = check.generate.fill value(-37.0) : tensor<4xf8E4M3>
  check.expect.bitwise actual(%prefix) expected(%guard) : tensor<4xf8E4M3>
  check.expect.bitwise actual(%suffix) expected(%guard) : tensor<4xf8E4M3>
  %unchanged = check.generate.iota offset(-4.0) step(0.0625) : tensor<136xf8E4M3>
  check.expect.bitwise actual(%input) expected(%unchanged) : tensor<136xf8E4M3>
  check.return
}

check.case public @source_constant_vectors {
  %e4m3 = check.generate.fill value(0) : tensor<32xi32>
  %e5m2 = check.generate.fill value(0) : tensor<32xi32>
  kernel.launch @constant_float8_vectors(%e4m3, %e5m2) : (tensor<32xi32>, tensor<32xi32>)
  // Packed lanes are [1.0, 1.25, 448.0, -0.0] and [1.0, 1.5, +inf, -0.0].
  %expected_e4m3 = check.generate.fill value(-2139211208) : tensor<32xi32>
  %expected_e5m2 = check.generate.fill value(-2139341252) : tensor<32xi32>
  check.expect.equal actual(%e4m3) expected(%expected_e4m3) : tensor<32xi32>
  check.expect.equal actual(%e5m2) expected(%expected_e5m2) : tensor<32xi32>
  check.return
}

check.case public @source_constant_midpoints {
  %e4m3 = check.generate.fill value(0) : tensor<32xi32>
  %e5m2 = check.generate.fill value(0) : tensor<32xi32>
  kernel.launch @constant_float8_midpoints(%e4m3, %e5m2) : (tensor<32xi32>, tensor<32xi32>)
  // Both constexpr and ordinary conversions round once, to 1.125 and 1.25.
  %expected_e4m3 = check.generate.fill value(960051513) : tensor<32xi32>
  %expected_e5m2 = check.generate.fill value(1027423549) : tensor<32xi32>
  check.expect.equal actual(%e4m3) expected(%expected_e4m3) : tensor<32xi32>
  check.expect.equal actual(%e5m2) expected(%expected_e5m2) : tensor<32xi32>
  check.return
}
