struct Split {
  double value;
  unsigned long long tag;
};

extern "C" Split split_identity(Split value) { return value; }

// ----
low.func.def public target<x86.avx2.core> abi(object_function) abi_layout({signature = (f64, i64) -> (f64, i64), sysv = {argument_offsets = [-1, -1], argument_registers = [0, 7], result_registers = [0, 0], stack_alignment = 0, stack_bytes = 0}}) @split_identity(%value_value: reg<x86.xmm>, %value_tag: reg<x86.gpr64>) -> (reg<x86.xmm>, reg<x86.gpr64>) asm {
  return %value_value, %value_tag
}

// ====

struct Wide {
  unsigned long long first;
  unsigned long long second;
};

extern "C" unsigned long long register_rollback(unsigned long long first, unsigned long long second, unsigned long long third, unsigned long long fourth, unsigned long long fifth, Wide wide, unsigned long long tail) {
  return wide.first + tail;
}

// ----
low.func.def public target<x86.avx2.core> abi(object_function) abi_layout({signature = (i64, i64, i64, i64, i64, i64, i64, i64) -> (i64), sysv = {argument_offsets = [-1, -1, -1, -1, -1, 0, 8, -1], argument_registers = [7, 6, 2, 1, 8, -1, -1, 9], result_registers = [0], stack_alignment = 16, stack_bytes = 16}}) @register_rollback(%first: reg<x86.gpr64>, %second: reg<x86.gpr64>, %third: reg<x86.gpr64>, %fourth: reg<x86.gpr64>, %fifth: reg<x86.gpr64>, %wide_first: reg<x86.gpr64>, %wide_second: reg<x86.gpr64>, %tail: reg<x86.gpr64>) -> (reg<x86.gpr64>) asm {
  %19 = copy %wide_first : reg<x86.gpr64> -> reg<x86.gpr64>
  %20 = add.gpr64 %19, %tail
  return %20
}

