// RUN: emit source-low target=x86:avx2 output=low

struct Pair {
  unsigned first;
  unsigned second;
};

extern "C" Pair pair_identity(Pair value) { return value; }

// ----
low.func.def public target<x86.avx2.core> abi(object_function) abi_layout({signature = (i64) -> (i64), sysv = {argument_offsets = [-1], argument_registers = [7], result_registers = [0], stack_alignment = 0, stack_bytes = 0}}) @pair_identity(%4: reg<x86.gpr64>) -> (reg<x86.gpr64>) asm {
  %value_first = mov.trunc.gpr32.gpr64 %4
  %7 = copy %4 : reg<x86.gpr64> -> reg<x86.gpr64>
  %8 = shr.imm.gpr64 %7 {shift = 32}
  %value_second = mov.trunc.gpr32.gpr64 %8
  %10 = movzx.gpr64.gpr32 %value_first
  %11 = movzx.gpr64.gpr32 %value_second
  %12 = shl.imm.gpr64 %11 {shift = 32}
  %13 = or.gpr64 %10, %12
  return %13
}

// ====

struct Mixed {
  float value;
  unsigned tag;
};

extern "C" Mixed mixed_identity(Mixed value) { return value; }

// ----
low.func.def public target<x86.avx2.core> abi(object_function) abi_layout({signature = (i64) -> (i64), sysv = {argument_offsets = [-1], argument_registers = [7], result_registers = [0], stack_alignment = 0, stack_bytes = 0}}) @mixed_identity(%4: reg<x86.gpr64>) -> (reg<x86.gpr64>) asm {
  %6 = mov.trunc.gpr32.gpr64 %4
  %value_value = vmovd.xmm.gpr32 %6
  %8 = copy %4 : reg<x86.gpr64> -> reg<x86.gpr64>
  %9 = shr.imm.gpr64 %8 {shift = 32}
  %value_tag = mov.trunc.gpr32.gpr64 %9
  %11 = vmovd.gpr32.xmm %value_value
  %12 = movzx.gpr64.gpr32 %11
  %13 = movzx.gpr64.gpr32 %value_tag
  %14 = shl.imm.gpr64 %13 {shift = 32}
  %15 = or.gpr64 %12, %14
  return %15
}

