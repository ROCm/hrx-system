struct Narrow {
  unsigned char byte;
  unsigned short half;
  bool flag;
};

extern "C" Narrow narrow_identity(Narrow value) { return value; }

// ----
low.func.def public target<x86.avx2.core> abi(object_function) abi_layout({signature = (i64) -> (i64), sysv = {argument_offsets = [-1], argument_registers = [7], result_registers = [0], stack_alignment = 0, stack_bytes = 0}}) @narrow_identity(%6: reg<x86.gpr64>) -> (reg<x86.gpr64>) asm {
  %8 = mov.trunc.gpr32.gpr64 %6
  %value_byte = and.imm.gpr32 %8 {imm32 = 255}
  %10 = copy %6 : reg<x86.gpr64> -> reg<x86.gpr64>
  %11 = shr.imm.gpr64 %10 {shift = 16}
  %12 = mov.trunc.gpr32.gpr64 %11
  %value_half = and.imm.gpr32 %12 {imm32 = 65535}
  %14 = copy %6 : reg<x86.gpr64> -> reg<x86.gpr64>
  %15 = shr.imm.gpr64 %14 {shift = 32}
  %16 = mov.trunc.gpr32.gpr64 %15
  %value_flag = and.imm.gpr32 %16 {imm32 = 1}
  %18 = copy %value_byte : reg<x86.gpr32> -> reg<x86.gpr32>
  %19 = and.imm.gpr32 %18 {imm32 = 255}
  %20 = movzx.gpr64.gpr32 %19
  %21 = copy %value_half : reg<x86.gpr32> -> reg<x86.gpr32>
  %22 = and.imm.gpr32 %21 {imm32 = 65535}
  %23 = movzx.gpr64.gpr32 %22
  %24 = shl.imm.gpr64 %23 {shift = 16}
  %25 = or.gpr64 %20, %24
  %26 = copy %value_flag : reg<x86.gpr32> -> reg<x86.gpr32>
  %27 = and.imm.gpr32 %26 {imm32 = 1}
  %28 = movzx.gpr64.gpr32 %27
  %29 = shl.imm.gpr64 %28 {shift = 32}
  %30 = or.gpr64 %25, %29
  return %30
}

