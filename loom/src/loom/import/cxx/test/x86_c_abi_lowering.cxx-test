low.func.def public target<x86.avx2.core> abi(object_function) abi_layout({signature = (vector<16xi8>) -> (vector<16xi8>), sysv = {argument_offsets = [-1], argument_registers = [0], result_registers = [0], stack_alignment = 0, stack_bytes = 0}}) @vector_identity(%value: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
