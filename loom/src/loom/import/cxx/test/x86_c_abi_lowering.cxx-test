struct Large {
  unsigned long long first;
  unsigned long long second;
  unsigned long long third;
};

extern "C" Large large_identity(Large value) { return value; }

// ----
low.func.def public target<x86.avx2.core> abi(object_function) abi_layout({signature = (buffer, i64, i64, i64) -> (buffer), sysv = {argument_offsets = [-1, 0, 8, 16], argument_registers = [7, -1, -1, -1], result_registers = [0], stack_alignment = 16, stack_bytes = 32}}) @large_identity(%6: reg<x86.gpr64>, %value_first: reg<x86.gpr64>, %value_second: reg<x86.gpr64>, %value_third: reg<x86.gpr64>) -> (%6 as reg<x86.gpr64>) asm {
  mov.store.gpr64 %value_first, %6 {disp32 = 0}
  mov.store.gpr64 %value_second, %6 {disp32 = 8}
  mov.store.gpr64 %value_third, %6 {disp32 = 16}
  return %6
}

// ====

extern "C" const unsigned* advance_pointer(const unsigned* base) {
  return base + 3;
}

// ----
low.func.def public target<x86.avx2.core> abi(object_function) abi_layout({signature = (i64) -> (i64), sysv = {argument_offsets = [-1], argument_registers = [7], result_registers = [0], stack_alignment = 0, stack_bytes = 0}}) @advance_pointer(%base: reg<x86.gpr64>) -> (reg<x86.gpr64>) asm {
  %base_byte_offset = mov.imm64 0
  %16 = copy %base_byte_offset : reg<x86.gpr64> -> reg<x86.gpr64>
  %17 = add.imm.gpr64 %16 {imm32 = 12}
  %18 = copy %base : reg<x86.gpr64> -> reg<x86.gpr64>
  %19 = add.gpr64 %18, %17
  return %19
}

// ====

struct Pair {
  unsigned first;
  unsigned second;
};

extern "C" Pair external_pair(Pair value);

Pair call_external_pair(Pair value) { return external_pair(value); }

// ----
low.func.def public target<x86.avx2.core> abi(object_function) @call_external_pair(%value_first: reg<x86.gpr32>, %value_second: reg<x86.gpr32>) -> (reg<x86.gpr32>, reg<x86.gpr32>) asm {
  %16 = movzx.gpr64.gpr32 %value_first
  %17 = movzx.gpr64.gpr32 %value_second
  %18 = shl.imm.gpr64 %17 {shift = 32}
  %19 = or.gpr64 %16, %18
  %20 = low.func.call @external_pair(%19) : (reg<x86.gpr64>) -> (reg<x86.gpr64>)
  %21 = mov.trunc.gpr32.gpr64 %20
  %22 = copy %20 : reg<x86.gpr64> -> reg<x86.gpr64>
  %23 = shr.imm.gpr64 %22 {shift = 32}
  %24 = mov.trunc.gpr32.gpr64 %23
  return %21, %24
}

low.func.decl target<x86.avx2.core> abi_layout({signature = (i64) -> (i64), sysv = {argument_offsets = [-1], argument_registers = [7], result_registers = [0], stack_alignment = 0, stack_bytes = 0}}) @external_pair(%10: reg<x86.gpr64>) -> (reg<x86.gpr64>)

