# Inline C++ check cases travel with the implementation as one optional module.
[
    loom_test_module(
        name = source + "_module",
        srcs = [source + ".cxx"],
        target_compatible_with = loom_config_compatible_with(["//loom/config/import:cxx"]),
    )
    for source in [
        "packed_byte_arithmetic",
        "packed_float16_conversion",
        "packed_float8_conversion",
        "vector_lookup",
    ]
]

# A source file and its independent reference cases form one test module.
# Kernel names, launch configuration, and schedule variants belong to those files.
# Target packages select applicable modules and own their execution policy.
_KERNEL_SOURCES = [
    "aiter_swiglu_f16",
    "assumptions",
    "constant_loops",
    "control_flow",
    "early_returns",
    "enum_values",
    "flash_attention",
    "increment_values",
    "integer_increment",
    "llama_rms_norm",
    "pointer_walk",
    "record_values",
    "scheduled_sum",
    "shaped_intrinsics",
    "short_circuit",
    "structured_continue",
    "symbol_exports",
    "typed_views",
    "vector_depth",
    "vector_initializers",
    "vector_values",
    "volatile_memory",
]

[
    loom_generated_file_family(
        name = source + "_checks_gen",
        testonly = True,
        args = [
            "kernel",
            "--group=" + source,
        ],
        generator = "//loom/py/loom/gen/test:cxx_kernel_cases",
        output_directories = [source + "_arrays"],
        output_flags = [
            "--output",
            "--arrays",
        ],
        outputs = [
            source + "_checks.loom",
            source + "_arrays",
        ],
    )
    for source in _KERNEL_SOURCES
]

[
    loom_test_module(
        name = source + "_module",
        srcs = [
            source + ".cxx",
            ":" + source + "_checks.loom",
        ],
        data = [":" + source + "_checks_gen"],
        inputopts = ["cxx:approximate-functions=true"] if source in [
            "aiter_swiglu_f16",
            "flash_attention",
            "llama_rms_norm",
        ] else [],
        target_compatible_with = loom_config_compatible_with(["//loom/config/import:cxx"]),
    )
    for source in _KERNEL_SOURCES
]

test_suite(
    name = "functions_test",
    tests = [":" + source.removesuffix(".cxx") + "_test" for source in _HOST_SOURCES],
)
