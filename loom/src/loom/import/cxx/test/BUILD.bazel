[
    loom_generated_file(
        name = source.removesuffix(".cxx") + "_cases_gen",
        testonly = True,
        args = [
            "host",
            "--source=$(location " + source + ")",
        ],
        generator = "//loom/py/loom/gen/test:cxx_kernel_cases",
        inputs = [source],
        output = source.removesuffix(".cxx") + "_cases.cxx",
        output_flag = "--output",
        target_compatible_with = _HOST_COMPATIBILITY,
    )
    for source in _HOST_SOURCES
]

[
    loom_test(
        name = source.removesuffix(".cxx") + "_test",
        srcs = [":" + source.removesuffix(".cxx") + "_cases.cxx"],
        data = [source],
        execution_profiles = [VM_REFERENCE_PROFILE],
        target_compatible_with = _HOST_COMPATIBILITY,
    )
    for source in _HOST_SOURCES
]

