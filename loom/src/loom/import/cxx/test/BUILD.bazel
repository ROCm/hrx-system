load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with", "loom_generated_file", "loom_generated_file_family")
load("//loom/build_tools/bazel:defs.bzl", "loom_test", "loom_test_module")
load("//loom/build_tools/bazel:loom_check.bzl", "loom_check_test_suite")
load("//loom/target/vm:execution_profiles.bzl", "VM_REFERENCE_PROFILE")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],
)

exports_files([
    "aiter_swiglu_f16.cpp",
    "flash_attention.cpp",
    "llama_rms_norm.cpp",
])

loom_check_test_suite(
    name = "compiler_test",
    srcs = [
        "assumptions.cxx-test",
        "assumptions_invalid.cxx-test",
        "check.cxx-test",
        "condition_declarations.cxx-test",
        "conditionals.cxx-test",
        "config.cxx-test",
        "config_cleanup.cxx-test",
        "config_invalid.cxx-test",
        "const.cxx-test",
        "constexpr.cxx-test",
        "constexpr_semantics.cxx-test",
        "control_invalid.cxx-test",
        "data_models.cxx-test",
        "enum_semantics.cxx-test",
        "enums.cxx-test",
        "enums_invalid.cxx-test",
        "frontend.cxx-test",
        "functions.cxx-test",
        "initializer_dependencies.cxx-test",
        "intrinsics_invalid.cxx-test",
        "kernel_intrinsics.cxx-test",
        "kernel_intrinsics_invalid.cxx-test",
        "launch.cxx-test",
        "launch_invalid.cxx-test",
        "layout_attributes.cxx-test",
        "layout_attributes_roundtrip.cxx-test",
        "locations.cxx-test",
        "loops.cxx-test",
        "macro_operators.cxx-test",
        "offsetof.cxx-test",
        "offsetof_roundtrip.cxx-test",
        "pointers.cxx-test",
        "records.cxx-test",
        "records_invalid.cxx-test",
        "scalar.cxx-test",
        "scalar_invalid.cxx-test",
        "schedule_lowering.cxx-test",
        "schedules.cxx-test",
        "schedules_invalid.cxx-test",
        "shaped_intrinsics.cxx-test",
        "shaped_intrinsics_invalid.cxx-test",
        "standards.cxx-test",
        "storage_updates.cxx-test",
        "symbols.cxx-test",
        "symbols_invalid.cxx-test",
        "template_calls.cxx-test",
        "vectors.cxx-test",
        "vectors_invalid.cxx-test",
        "view_values.cxx-test",
        "volatile.cxx-test",
        "volatile_invalid.cxx-test",
        "volatile_views.cxx-test",
    ],
    data = [
        "aligned_layout.h",
        "enum_semantics.h",
        "locations.h",
        "offsetof_layout.h",
        "packed_enums.h",
        "packed_layout.h",
        "record_layout.h",
        "record_values.cpp",
    ],
    target_compatible_with = loom_config_compatible_with(["//loom/config/import:cxx"]),
)

# Each source retains independent mathematical references and imports its
# implementation through the same source path as handwritten check cases.
_HOST_SOURCES = [
    "assumptions.cpp",
    "comparison_functions.cpp",
    "constant_loops.cpp",
    "enum_values.cpp",
    "increment_values.cpp",
    "integer_functions.cpp",
    "record_values.cpp",
    "schedule_values.cpp",
    "shaped_intrinsics.cpp",
    "structured_continue.cpp",
    "vector_initializers.cpp",
    "vector_values.cpp",
]

_HOST_COMPATIBILITY = loom_config_compatible_with([
    "//loom/config/import:cxx",
    "//loom/config/target/arch:vm",
])

loom_test(
    name = "condition_values_test",
    srcs = ["condition_values.cpp"],
    execution_profiles = [VM_REFERENCE_PROFILE],
    target_compatible_with = _HOST_COMPATIBILITY,
)

loom_test(
    name = "constexpr_values_test",
    srcs = ["constexpr_values.cpp"],
    execution_profiles = [VM_REFERENCE_PROFILE],
    target_compatible_with = _HOST_COMPATIBILITY,
)

loom_test(
    name = "storage_values_test",
    srcs = [
        "storage_updates.cpp",
        "storage_values.loom",
    ],
    execution_profiles = [VM_REFERENCE_PROFILE],
    target_compatible_with = _HOST_COMPATIBILITY,
)

loom_test(
    name = "volatile_values_test",
    srcs = [
        "volatile_memory.cpp",
        "volatile_values.loom",
    ],
    execution_profiles = [VM_REFERENCE_PROFILE],
    target_compatible_with = _HOST_COMPATIBILITY,
)

loom_test(
    name = "config_values_test",
    srcs = ["config_values.cpp"],
    configs = {"tuning.enabled": "true"},
    execution_profiles = [VM_REFERENCE_PROFILE],
    target_compatible_with = _HOST_COMPATIBILITY,
    variants = {
        "five": {
            "case": "five",
            "configs": {
                "tuning.count": "7",
                "tuning.factor": "5",
            },
        },
        "nine": {
            "case": "nine",
            "configs": {
                "tuning.count": "13",
                "tuning.enabled": "false",
                "tuning.factor": "9",
            },
        },
    },
)

[
    loom_generated_file(
        name = source.removesuffix(".cpp") + "_cases_gen",
        testonly = True,
        args = [
            "host",
            "--source=$(location " + source + ")",
        ],
        generator = "//loom/py/loom/gen/test:cxx_kernel_cases",
        inputs = [source],
        output = source.removesuffix(".cpp") + "_cases.cc",
        output_flag = "--output",
        target_compatible_with = _HOST_COMPATIBILITY,
    )
    for source in _HOST_SOURCES
]

[
    loom_test(
        name = source.removesuffix(".cpp") + "_test",
        srcs = [":" + source.removesuffix(".cpp") + "_cases.cc"],
        data = [source],
        execution_profiles = [VM_REFERENCE_PROFILE],
        target_compatible_with = _HOST_COMPATIBILITY,
    )
    for source in _HOST_SOURCES
]

loom_check_test_suite(
    name = "vm_compiler_test",
    srcs = ["vm_lowering.cxx-test"],
    target_compatible_with = _HOST_COMPATIBILITY,
)

loom_test_module(
    name = "storage_updates_module",
    srcs = [
        "storage_kernels.loom",
        "storage_updates.cpp",
    ],
    target_compatible_with = loom_config_compatible_with(["//loom/config/import:cxx"]),
)

# A source file and its independent reference cases form one test module.
# Kernel names, launch configuration, and schedule variants belong to those files.
# Target packages select applicable modules and own their execution policy.
_KERNEL_SOURCES = [
    "aiter_swiglu_f16",
    "assumptions",
    "constant_loops",
    "control_flow",
    "early_returns",
    "enum_values",
    "flash_attention",
    "increment_values",
    "integer_increment",
    "llama_rms_norm",
    "pointer_walk",
    "record_values",
    "scheduled_sum",
    "shaped_intrinsics",
    "short_circuit",
    "structured_continue",
    "symbol_exports",
    "typed_views",
    "vector_depth",
    "vector_initializers",
    "vector_values",
    "volatile_memory",
]

[
    loom_generated_file_family(
        name = source + "_checks_gen",
        testonly = True,
        args = [
            "kernel",
            "--group=" + source,
        ],
        generator = "//loom/py/loom/gen/test:cxx_kernel_cases",
        output_directories = [source + "_arrays"],
        output_flags = [
            "--output",
            "--arrays",
        ],
        outputs = [
            source + "_checks.loom",
            source + "_arrays",
        ],
    )
    for source in _KERNEL_SOURCES
]

[
    loom_test_module(
        name = source + "_module",
        srcs = [
            source + ".cpp",
            ":" + source + "_checks.loom",
        ],
        data = [":" + source + "_checks_gen"],
        inputopts = ["cxx:approximate-functions=true"] if source in [
            "aiter_swiglu_f16",
            "flash_attention",
            "llama_rms_norm",
        ] else [],
        target_compatible_with = loom_config_compatible_with(["//loom/config/import:cxx"]),
    )
    for source in _KERNEL_SOURCES
]

test_suite(
    name = "functions_test",
    tests = [":" + source.removesuffix(".cpp") + "_test" for source in _HOST_SOURCES],
)
