// RUN: verify
// Matching floating-point categories do not permit changing operand precision.
// ERROR@+1: LOWERING/059 "intrinsic operands must have the result's type"
[[loom::op("scalar.expf")]] float custom(double);
float entry(double value) { return custom(value); }

// ====
// Generated intrinsic signatures are checked.
// ERROR@+1: LOWERING/059 "operation bindings accept only string arguments"
[[loom::op("scalar.expf", 42)]] float broken(float);
float entry(float x) { return broken(x); }

// ====
// Generated intrinsic signatures are checked.
// ERROR@+1: LOWERING/059 "an intrinsic requires one operation binding and no function body"
[[loom::op("scalar.expf"), loom::op("scalar.logf")]] float broken(float);
float entry(float x) { return broken(x); }

// ====
// Generated intrinsic signatures are checked.
// ERROR@+1: LOWERING/059 "an intrinsic requires one operation binding and no function body"
[[loom::op("scalar.expf")]] float broken(float x) { return x; }

// ====
// Reference bodies belong only to the numeric conversion function template.
// ERROR@+1: LOWERING/059 "an intrinsic requires one operation binding and no function body"
[[loom::op("numeric.convert")]] int broken(int value) { return value; }

// ====
// Generated intrinsic signatures are checked.
// ERROR@+1: LOWERING/059 "intrinsic operands must have the result's type"
[[loom::op("scalar.expf")]] float broken(int);
float entry(int x) { return broken(x); }

// ====
// Generated intrinsic signatures are checked.
// ERROR@+1: LOWERING/059 "scalar intrinsic result must be _Float16, __bf16, float, or double"
[[loom::op("scalar.expf")]] int broken(int);
int entry(int x) { return broken(x); }

// ====
// Generated intrinsic signatures are checked.
// ERROR@+1: LOWERING/059 "intrinsic declaration has the wrong operand count"
[[loom::op("scalar.expf")]] float broken(float, float);
float entry(float x) { return broken(x, x); }

// ====
// Generated intrinsic signatures are checked.
// ERROR@+1: LOWERING/059 "intrinsic has an unsupported fast-math flag"
[[loom::op("scalar.expf", "surprise")]] float broken(float);
float entry(float x) { return broken(x); }

// ====
// Generated intrinsic signatures are checked.
// ERROR@+1: LOWERING/059 "operation has no C++ projection"
[[loom::op("scf.for")]] float broken(float);
float entry(float x) { return broken(x); }

// ====
[[loom::op("scalar.expf", "afn")]] float approximate(float);
// ERROR@+1: LOWERING/059 "conflicting intrinsic redeclarations"
[[loom::op("scalar.expf")]] float approximate(float);
