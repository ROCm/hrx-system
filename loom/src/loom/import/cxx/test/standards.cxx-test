// RUN: roundtrip
// INPUT: cxx std=c23
// Standard selection uses frontend macros.
#if __STDC_VERSION__ != 202311L
#error wrong standard
#endif
int entry(void) { return 1; }
// ----
func.def public source_signature(#func.abi.c.signature<arguments = [], results = [0], types = [#func.abi.c.type<signed_integer, byte_length = 4, byte_alignment = 4, component_count = 1, bitwidth = 32>]>) @entry() -> (i32) {
  %1 = scalar.constant 1 : i32
  func.return %1 : i32
}

// ====
// RUN: roundtrip
// INPUT: cxx std=c++17
// Standard selection uses frontend macros.
#if __cplusplus != 201703L
#error wrong standard
#endif
int entry() { return 1; }
// ----
func.def public @entry() -> (i32) {
  %1 = scalar.constant 1 : i32
  func.return %1 : i32
}
