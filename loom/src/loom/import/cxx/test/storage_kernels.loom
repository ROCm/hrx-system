check.case @bytes_values {
  %storage = check.generate.fill value(37) : tensor<4xi8>
  %output = check.generate.fill value(37) : tensor<3xi32>
  kernel.launch @storage_bytes_kernel(%storage, %output) : (tensor<4xi8>, tensor<3xi32>)
  %before = check.tensor.view %storage offset(0) : tensor<4xi8> -> tensor<1xi8>
  %first = check.tensor.view %storage offset(1) : tensor<4xi8> -> tensor<1xi8>
  %second = check.tensor.view %storage offset(2) : tensor<4xi8> -> tensor<1xi8>
  %after = check.tensor.view %storage offset(3) : tensor<4xi8> -> tensor<1xi8>
  %output_before = check.tensor.view %output offset(0) : tensor<3xi32> -> tensor<1xi32>
  %returned = check.tensor.view %output offset(4) : tensor<3xi32> -> tensor<1xi32>
  %output_after = check.tensor.view %output offset(8) : tensor<3xi32> -> tensor<1xi32>
  %guard = check.generate.fill value(37) : tensor<1xi8>
  %expected_first = check.generate.fill value(0) : tensor<1xi8>
  %expected_second = check.generate.fill value(3) : tensor<1xi8>
  %expected_returned = check.generate.fill value(555) : tensor<1xi32>
  %output_guard = check.generate.fill value(37) : tensor<1xi32>
  check.expect.bitwise actual(%before) expected(%guard) : tensor<1xi8>
  check.expect.bitwise actual(%first) expected(%expected_first) : tensor<1xi8>
  check.expect.bitwise actual(%second) expected(%expected_second) : tensor<1xi8>
  check.expect.bitwise actual(%after) expected(%guard) : tensor<1xi8>
  check.expect.bitwise actual(%returned) expected(%expected_returned) : tensor<1xi32>
  check.expect.bitwise actual(%output_before) expected(%output_guard) : tensor<1xi32>
