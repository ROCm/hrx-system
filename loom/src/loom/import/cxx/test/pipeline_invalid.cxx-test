// RUN: verify
#include <loomcxx/pipeline.h>

// ERROR@+1: LOWERING/059 "channel payload must be a Loom tile type"
void scalar_channel(loom::type::channel<float> value) {}

// ====
#include <loomcxx/pipeline.h>

using InvalidEncoding = loom::type::tile<loom::type::shape<4>, float, int>;
// ERROR@+1: LOWERING/059 "tile encoding must be void or a Loom encoding type"
void scalar_encoding(InvalidEncoding value) {}

// ====
#include <loomcxx/pipeline.h>

using Payload = loom::type::tile<loom::type::shape<4>, float>;
using InvalidRead = loom::type::read<
    Payload, static_cast<loom::channel::mode>(2)>;
// ERROR@+1: LOWERING/059 "read access mode must be immutable or mutable"
void invalid_read_mode(InvalidRead value) {}

// ====
#include <loomcxx/pipeline.h>

using ConstTile = loom::type::tile<loom::type::shape<4>, const float>;
// ERROR@+1: LOWERING/059 "tile elements require an unqualified source type"
void const_tile(ConstTile value) {}

// ====
#include <loomcxx/pipeline.h>

namespace loomt = loom::type;
using Layout = loomt::encoding<loom::encoding::role::layout, 1>;
using Payload = loomt::tile<loomt::shape<4>, float, Layout>;
using Stream = loomt::channel<Payload>;
using Slots = loomt::view<loomt::shape<2, 4>, float>;

template <loom::channel::discipline Discipline>
[[loom::op("channel.bind")]] Stream missing_encoding(Slots slots,
                                                       loomt::index capacity);

void bind_without_payload_encoding(Slots slots, loomt::index capacity) {
  // ERROR@+1: LOWERING/059 "encoded channel.bind requires its exact payload encoding"
  missing_encoding<loom::channel::discipline::fifo>(slots, capacity);
}

// ====
#include <loomcxx/pipeline.h>

namespace loomt = loom::type;
using Payload = loomt::tile<loomt::shape<4>, float>;
using Read = loomt::read<Payload>;
using Writable = loomt::view<loomt::shape<4>, float>;

// ERROR@+1: LOWERING/059 "channel.wait result must be a const view for immutable reads"
[[loom::op("channel.wait")]] Writable writable_immutable_wait(Read read);

// ====
#include <loomcxx/pipeline.h>

namespace loomt = loom::type;
using Payload = loomt::tile<loomt::shape<4>, float>;

void insufficient_fanout(loomt::read<Payload> read) {
  // ERROR@+1: LOWERING/059 "channel.fanout requires an immutable read and a result aggregate containing at least two matching reads"
  loom::channel::fanout<1>(read);
}

// ====
#include <loomcxx/pipeline.h>

namespace loomt = loom::type;
using Payload = loomt::tile<loomt::shape<4>, float>;
using Read = loomt::read<Payload>;

struct addressable_reads {
  Read values[2];
};

// ERROR@+1: LOWERING/059 "channel.fanout requires an immutable read and a result aggregate containing at least two matching reads"
[[loom::op("channel.fanout")]] addressable_reads addressable_fanout(Read read);

// ====
#include <loomcxx/pipeline.h>

template <class T, loom::memory_space Space, __SIZE_TYPE__ Alignment>
[[loom::op("buffer.alloca")]] T* invalid_pool(__SIZE_TYPE__ count,
                                               unsigned pool);

void pool_operand(__SIZE_TYPE__ count) {
  // ERROR@+1: LOWERING/059 "buffer.alloca second operand must be a Loom pool"
  invalid_pool<float, loom::memory_space::private_, 4>(count, 0);
}

// ====
#include <loomcxx/pipeline.h>

namespace loomt = loom::type;
using Payload = loomt::tile<loomt::shape<4>, float>;
using Stream = loomt::channel<Payload>;
using Slots = loomt::view<loomt::shape<2, 4>, float>;

void invalid_discipline(Slots slots, loomt::index capacity) {
  // ERROR@+1: LOWERING/059 "channel.bind requires a supported discipline template argument"
  loom::channel::bind<static_cast<loom::channel::discipline>(2)>(slots,
                                                                 capacity);
}

// ====
// ERROR@+1: LOWERING/059 "pipeline accepts no argument clause or the product scope"
[[loom::pipeline("device")]] void wrong_scope();

// ====
// ERROR@+1: LOWERING/059 "pipeline cannot be combined with another callable kind"
[[loom::pipeline("kernel"), loom::kernel]] void conflicting();

// ====
#include <loomcxx/buffer.h>
[[loom::pipeline("kernel")]] void changing(unsigned value, [[loom::launch]] loom::type::buffer<unsigned char> output);
// ERROR@+1: LOWERING/059 "conflicting launch boundaries across pipeline redeclarations"
[[loom::pipeline("kernel")]] void changing([[loom::launch]] unsigned value, loom::type::buffer<unsigned char> output);

// ====
#include <loomcxx/command.h>
#include <loomcxx/kernel.h>
using Bytes = loom::type::buffer<unsigned char>;
// ERROR@+1: LOWERING/059 "pipeline contracts require direct Loom value types instead of source pointers, records, or arrays"
[[loom::pipeline("kernel")]] void pointer([[loom::launch]] unsigned char* output);
[[loom::command_program]] void launch_pointer([[loom::launch]] Bytes output) {
  loom::kernel::launch<pointer>(output);
}

// ====
#include <loomcxx/command.h>
#include <loomcxx/kernel.h>
using Data = loom::type::buffer<unsigned char>;
[[loom::pipeline("kernel")]] void typed(unsigned count, [[loom::launch]] Data data);
[[loom::command_program]] void mismatched(float count, [[loom::launch]] Data data) {
  // ERROR@+1: LOWERING/059 "kernel.launch arguments must match the pipeline source types"
  loom::kernel::launch<typed>(count, data);
}

// ====
#include <loomcxx/command.h>
#include <loomcxx/kernel.h>
using Root = loom::type::buffer<unsigned char>;
[[loom::pipeline("kernel")]] void sink([[loom::launch]] Root data);
[[loom::command_program]] void launch_interior() {
  auto* scratch = loom::buffer::alloca<loom::memory_space::global, 64>(loom::type::offset{256});
  // ERROR@+1: LOWERING/059 "buffer ABI arguments require a zero-origin source pointer"
  loom::kernel::launch<sink>(scratch + 1);
}

// ====
#include <loomcxx/command.h>
using Storage = loom::type::buffer<unsigned char>;
[[loom::pipeline("kernel")]] void external([[loom::launch]] Storage data);
[[loom::command_program]] void call_directly([[loom::launch]] Storage data) {
  // ERROR@+1: LOWERING/059 "pipelines require explicit composition or kernel launch"
  external(data);
}

// ====
#include <loomcxx/command.h>
#include <loomcxx/kernel.h>
struct Pair { unsigned first; unsigned second; };
// ERROR@+1: LOWERING/059 "pipeline contracts require direct Loom value types instead of source pointers, records, or arrays"
[[loom::pipeline("kernel")]] void aggregate([[loom::launch]] Pair value);
[[loom::command_program]] void launch_aggregate(Pair value) {
  loom::kernel::launch<aggregate>(value);
}

// ====
#include <loomcxx/pipeline.h>

namespace loomt = loom::type;

void memory_outside_pipeline(loomt::index coordinate) {
  // ERROR@+1: LOWERING/059 "pipeline.memory requires a pipeline definition body"
  loom::pipeline::memory<loom::memory_space::workgroup>(loomt::indices{coordinate});
}

// ====
#include <loomcxx/pipeline.h>
namespace loomt = loom::type;
void strand_outside_pipeline(loomt::index coordinate) {
  // ERROR@+1: LOWERING/059 "strand requires a pipeline definition body"
  [[loom::strand(loomt::indices{coordinate}, loomt::indices{loomt::index{1}}, loomt::indices{loomt::index{1}})]] {}
}

// ====
#include <loomcxx/pipeline.h>
namespace loomt = loom::type;
[[loom::pipeline("kernel")]] void memory_inside_strand(loomt::index coordinate) {
  [[loom::strand(loomt::indices{coordinate}, loomt::indices{loomt::index{1}}, loomt::indices{loomt::index{1}})]] {
    // ERROR@+1: LOWERING/059 "pipeline.memory belongs outside pipeline strand bodies"
    loom::pipeline::memory<loom::memory_space::workgroup>(loomt::indices{coordinate});
  }
}

// ====
#include <loomcxx/kernel.h>
#include <loomcxx/pipeline.h>
[[loom::pipeline("kernel")]] void kernel_intrinsic_outside_strand() {
  // ERROR@+1: LOWERING/059 "kernel intrinsic in a pipeline requires a strand body"
  (void)loom::kernel::workitem::id.x;
}

// ====
#include <loomcxx/pipeline.h>
namespace loomt = loom::type;
[[loom::pipeline("kernel")]] void mutation(loomt::index coordinate) {
  // ERROR@+1: LOWERING/059 "pipeline strands cannot update enclosing automatic values because they have no results"
  [[loom::strand(loomt::indices{coordinate}, loomt::indices{loomt::index{1}}, loomt::indices{loomt::index{1}})]] { coordinate = loomt::index{2}; }
}

// ====
#include <loomcxx/pipeline.h>
namespace loomt = loom::type;
[[loom::pipeline("kernel")]] void impure(unsigned coordinate) {
  // ERROR@+1: LOWERING/059 "strand origin expressions require pure values without calls, mutation, or overloaded operations"
  [[loom::strand(loomt::indices{loomt::index{++coordinate}}, loomt::indices{loomt::index{1}}, loomt::indices{loomt::index{1}})]] {}
}

// ====
[[loom::pipeline("kernel")]] void unknown_statement() {
  // ERROR@+1: LOWERING/059 "unsupported Loom statement attribute"
  [[loom::surprise]] {}
}

// ====
constexpr int not_target = 0;
[[loom::pipeline("kernel")]] void target_without_strand() {
  // ERROR@+1: LOWERING/059 "statement target requires a pipeline strand"
  [[loom::target(not_target)]] {}
}

// ====
#include <loomcxx/pipeline.h>
namespace loomt = loom::type;
constexpr int not_a_target = 0;
[[loom::pipeline("kernel")]] void invalid_strand_target() {
  // ERROR@+1: LOWERING/059 "target binding requires an admitted target object"
  [[loom::strand(loomt::indices{loomt::index{0}}, loomt::indices{loomt::index{1}}, loomt::indices{loomt::index{1}}), loom::target(not_a_target)]] {}
}

// ====
#include <loomcxx/pipeline.h>
using Bytes = loom::type::buffer<unsigned char>;
[[loom::pipeline("kernel")]] void composed(unsigned factor, [[loom::launch]] Bytes output);
void compose_outside_pipeline(unsigned factor, Bytes output) {
  // ERROR@+1: LOWERING/059 "pipeline.compose requires a pipeline definition body"
  loom::pipeline::compose<composed>(factor, output);
}

// ====
#include <loomcxx/pipeline.h>
void ordinary(unsigned value);
[[loom::pipeline("kernel")]] void invalid_composition(unsigned value) {
  // ERROR@+1: LOWERING/059 "pipeline.compose requires a pipeline as its first template argument"
  loom::pipeline::compose<ordinary>(value);
}

// ====
#include <loomcxx/pipeline.h>
using Bytes = loom::type::buffer<unsigned char>;
[[loom::pipeline("kernel")]] void typed_child(unsigned factor, [[loom::launch]] Bytes output);
[[loom::pipeline("kernel")]] void mismatched_composition(Bytes output) {
  // ERROR@+1: LOWERING/059 "pipeline.compose arguments must match the pipeline signature"
  loom::pipeline::compose<typed_child>(output);
}

