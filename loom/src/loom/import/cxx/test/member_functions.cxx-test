struct Stored {
  unsigned value;

  void bump(unsigned amount) { value += amount; }
  void bump_twice(unsigned amount) {
    bump(amount);
    bump(amount);
  }
  void maybe_bump(bool enabled, unsigned amount) {
    if (enabled) bump(amount);
  }
  unsigned read() const { return value; }
  unsigned observe() volatile { return value; }
};

unsigned storage_members(Stored* object, bool enabled, unsigned amount) {
  object->bump_twice(amount);
  object->maybe_bump(enabled, amount);
  return object->read() + object->observe();
}

