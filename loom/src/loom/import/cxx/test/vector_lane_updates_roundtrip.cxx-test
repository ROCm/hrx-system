// RUN: emit cxx
// REQUIRES: loom-export-cxx
#include <loomcxx/kernel.h>
#include <loomcxx/vector.h>

using Lanes = unsigned __attribute__((ext_vector_type(4)));

[[loom::kernel, loom::workgroup_count(1, 1, 1), loom::workgroup_size(1, 1, 1)]]
void replace_lane(unsigned* output, unsigned index, unsigned replacement) {
  Lanes values = {};
  values[index] = replacement;
  auto output_view = loom::buffer::view<4>(output, {}, loom::encoding::layout::dense<1>());
  loom::vector::store(values, output_view, {0});
}

[[loom::kernel, loom::workgroup_count(1, 1, 1), loom::workgroup_size(1, 1, 1)]]
void fill_lanes(unsigned* output, unsigned count) {
  Lanes values = {};
  for (unsigned index = 0; index < count; ++index) {
    values[index] = index + 1;
  }
  auto output_view = loom::buffer::view<4>(output, {}, loom::encoding::layout::dense<1>());
  loom::vector::store(values, output_view, {0});
}

// ----
#include <loomcxx/kernel.h>
#include <loomcxx/vector.h>

using UInt32x4 = unsigned __attribute__((ext_vector_type(4)));

[[loom::kernel, loom::workgroup_count(1, 1, 1), loom::workgroup_size(1, 1, 1)]]
void replace_lane(unsigned* output, unsigned index, unsigned replacement) {
  UInt32x4 values = UInt32x4{0u, 0u, 0u, 0u};
  UInt32x4 values_1 = values;
  values_1[loom::index::cast(index)] = replacement;
  auto output_view = loom::buffer::view<4>(output, {}, loom::encoding::layout::dense<1>());
  loom::vector::store(values_1, output_view, loom::type::indices{loom::type::index{0}});
}

[[loom::kernel, loom::workgroup_count(1, 1, 1), loom::workgroup_size(1, 1, 1)]]
void fill_lanes(unsigned* output, unsigned count) {
  UInt32x4 values = UInt32x4{0u, 0u, 0u, 0u};
  for (unsigned index_1 = 0u; index_1 < count; ++index_1) {
    unsigned v37 = index_1;
    values[loom::index::cast(v37)] = (v37 + 1u);
  }
  auto output_view = loom::buffer::view<4>(output, {}, loom::encoding::layout::dense<1>());
  loom::vector::store(values, output_view, loom::type::indices{loom::type::index{0}});
}
