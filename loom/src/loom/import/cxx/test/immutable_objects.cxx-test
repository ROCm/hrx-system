// RUN: pass canonicalize,cse,dce
namespace detail {
alignas(64) static constexpr unsigned table[4] = {11, 22, 33, 44};
static constexpr unsigned scalar = 7;
static constexpr unsigned unreachable[2] = {98, 99};
}

unsigned lookup_pair(unsigned index) {
  return detail::table[index & 3u] + detail::table[(index + 1u) & 3u];
}

unsigned conditional_lookup(bool enabled, unsigned index) {
  return enabled ? detail::table[index & 3u] : 0u;
}

unsigned folded_scalar() { return detail::scalar; }

// ----
func.def public @lookup_pair(%index: i32) -> (i32) {
  %detail_table_storage = global.load @detail_table : buffer
  %detail_table_storage_byte_offset = index.constant 0 : offset
  %detail_table_view = buffer.view %detail_table_storage[%detail_table_storage_byte_offset] : buffer -> view<4xi32>
  %5 = scalar.constant 3 : i32
  %6 = scalar.andi %index, %5 : i32
  %7 = scalar.extui %6 : i32 to i64
  %8 = scalar.assume %7 [range(%7, 0, 3)] : i64
  %9 = index.cast %8 : i64 to index
  %10 = view.load %detail_table_view[%9] : view<4xi32> -> i32
  %11 = scalar.constant 1 : i32
  %12 = scalar.addi %index, %11 : i32
  %14 = scalar.andi %12, %5 : i32
  %15 = scalar.extui %14 : i32 to i64
  %16 = scalar.assume %15 [range(%15, 0, 3)] : i64
  %17 = index.cast %16 : i64 to index
  %18 = view.load %detail_table_view[%17] : view<4xi32> -> i32
  %19 = scalar.addi %10, %18 : i32
  func.return %19 : i32
}

func.def public @conditional_lookup(%enabled: i1, %index: i32) -> (i32) {
  %detail_table_storage = global.load @detail_table : buffer
  %detail_table_storage_byte_offset = index.constant 0 : offset
  %detail_table_view = buffer.view %detail_table_storage[%detail_table_storage_byte_offset] : buffer -> view<4xi32>
  %23 = scf.if %enabled -> (i32) {
    %27 = scalar.constant 3 : i32
    %28 = scalar.andi %index, %27 : i32
    %29 = scalar.extui %28 : i32 to i64
    %30 = scalar.assume %29 [range(%29, 0, 3)] : i64
    %31 = index.cast %30 : i64 to index
    %32 = view.load %detail_table_view[%31] : view<4xi32> -> i32
    scf.yield %32 : i32
  } else {
    %33 = scalar.constant 0 : i32
    scf.yield %33 : i32
  }
  func.return %23 : i32
}

func.def public @folded_scalar() -> (i32) {
  %scalar = scalar.constant 7 : i32
  func.return %scalar : i32
}

global.rodata.def @detail_table = align(64) bytes("0b00000016000000210000002c000000")

// ====
namespace detail {
struct Pair {
  unsigned first;
  unsigned second;
};
static constexpr Pair pairs[2] = {{10, 20}, {30, 40}};
static constexpr unsigned nested[2][3] = {{1, 2, 3}, {4, 5, 6}};
}

unsigned aggregate_lookup(unsigned row, unsigned column) {
  return detail::pairs[row & 1u].second +
         detail::nested[row & 1u][column % 3u];
}

// ----
func.def public @aggregate_lookup(%row: i32, %column: i32) -> (i32) {
  %detail_pairs_storage = global.load @detail_pairs : buffer
  %detail_nested_storage = global.load @detail_nested : buffer
  %6 = scalar.constant 1 : i32
  %7 = scalar.andi %row, %6 : i32
  %52 = scalar.constant 3 : i32
  %53 = scalar.shli %7, %52 : i32
  %54 = scalar.extui %53 : i32 to i64
  %13 = scalar.assume %54 [range(%54, 0, 9223372036854775807)] : i64
  %14 = index.cast %13 : i64 to offset
  %15 = index.constant 4 : offset
  %16 = index.add %14, %15 : offset
  %17 = index.assume %16 [range(%16, 0, 12)] : offset
  %18 = buffer.view %detail_pairs_storage[%17] : buffer -> view<1xi32>
  %second = view.load %18[0] : view<1xi32> -> i32
  %25 = scalar.extui %7 : i32 to i64
  %26 = scalar.constant 12 : i64
  %27 = scalar.muli %25, %26 : i64
  %30 = scalar.assume %27 [range(%27, 0, 9223372036854775807)] : i64
  %31 = index.cast %30 : i64 to offset
  %33 = scalar.remui %column, %52 : i32
  %47 = scalar.constant 2 : i32
  %48 = scalar.shli %33, %47 : i32
  %49 = scalar.extui %48 : i32 to i64
  %37 = index.cast %31 : offset to i64
  %38 = scalar.addi %37, %49 : i64
  %39 = scalar.assume %38 [range(%38, 0, 9223372036854775807)] : i64
  %40 = index.cast %39 : i64 to offset
  %41 = index.assume %40 [range(%40, 0, 20)] : offset
  %42 = buffer.view %detail_nested_storage[%41] : buffer -> view<1xi32>
  %43 = view.load %42[0] : view<1xi32> -> i32
  %44 = scalar.addi %second, %43 : i32
  func.return %44 : i32
}

global.rodata.def @detail_pairs = align(4) bytes("0a000000140000001e00000028000000")

global.rodata.def @detail_nested = align(4) bytes("010000000200000003000000040000000500000006000000")

// ====
namespace detail {
static constexpr unsigned value = 7;
}

unsigned addressed_scalar() {
  const unsigned* pointer = &detail::value;
  return *pointer;
}

// ----
func.def public @addressed_scalar() -> (i32) {
  %detail_value_storage = global.load @detail_value : buffer
  %7 = index.constant 0 : offset
  %5 = buffer.view %detail_value_storage[%7] : buffer -> view<1xi32>
  %6 = view.load %5[0] : view<1xi32> -> i32
  func.return %6 : i32
}

global.rodata.def @detail_value = align(4) bytes("07000000")

// ====
enum class Code : unsigned char { first = 3, second = 9 };
using Word = unsigned char __attribute__((vector_size(4)));
static constexpr bool flags[2] = {false, true};
static constexpr Code codes[2] = {Code::first, Code::second};
static constexpr Word words[2] = {{1, 2, 3, 4}, {5, 6, 7, 8}};
static constexpr char text[] = (("Loom"));

bool flag_lookup(unsigned index) { return flags[index & 1u]; }
Code code_lookup(unsigned index) { return codes[index & 1u]; }
Word vector_lookup(unsigned index) { return words[index & 1u]; }
char character_lookup(unsigned index) { return text[index % sizeof(text)]; }

// ----
func.def public @flag_lookup(%index: i32) -> (i1) {
  %flags_storage = global.load @flags : buffer
  %flags_storage_byte_offset = index.constant 0 : offset
  %flags_view = buffer.view %flags_storage[%flags_storage_byte_offset] : buffer -> view<2xi8>
  %5 = scalar.constant 1 : i32
  %6 = scalar.andi %index, %5 : i32
  %7 = scalar.extui %6 : i32 to i64
  %8 = scalar.assume %7 [range(%7, 0, 1)] : i64
  %9 = index.cast %8 : i64 to index
  %10 = view.load %flags_view[%9] : view<2xi8> -> i8
  %11 = scalar.constant 0 : i8
  %12 = scalar.cmpi ne, %10, %11 : i8
  func.return %12 : i1
}

func.def public @code_lookup(%index: i32) -> (i8) {
  %codes_storage = global.load @codes : buffer
  %codes_storage_byte_offset = index.constant 0 : offset
  %codes_view = buffer.view %codes_storage[%codes_storage_byte_offset] : buffer -> view<2xi8>
  %18 = scalar.constant 1 : i32
  %19 = scalar.andi %index, %18 : i32
  %20 = scalar.extui %19 : i32 to i64
  %21 = scalar.assume %20 [range(%20, 0, 1)] : i64
  %22 = index.cast %21 : i64 to index
  %23 = view.load %codes_view[%22] : view<2xi8> -> i8
  func.return %23 : i8
}

func.def public @vector_lookup(%index: i32) -> (vector<4xi8>) {
  %words_storage = global.load @words : buffer
  %29 = scalar.constant 1 : i32
  %30 = scalar.andi %index, %29 : i32
  %54 = scalar.constant 2 : i32
  %55 = scalar.shli %30, %54 : i32
  %56 = scalar.extui %55 : i32 to i64
  %36 = scalar.assume %56 [range(%56, 0, 9223372036854775807)] : i64
  %37 = index.cast %36 : i64 to offset
  %38 = index.assume %37 [range(%37, 0, 4)] : offset
  %39 = buffer.view %words_storage[%38] : buffer -> view<4xi8>
  %40 = vector.load %39[0] : view<4xi8> -> vector<4xi8>
  func.return %40 : vector<4xi8>
}

func.def public @character_lookup(%index: i32) -> (i8) {
  %text_storage = global.load @text : buffer
  %text_storage_byte_offset = index.constant 0 : offset
  %text_view = buffer.view %text_storage[%text_storage_byte_offset] : buffer -> view<5xi8>
  %46 = scalar.extui %index : i32 to i64
  %47 = scalar.constant 5 : i64
  %48 = scalar.remui %46, %47 : i64
  %49 = scalar.assume %48 [range(%48, 0, 4)] : i64
  %50 = index.cast %49 : i64 to index
  %51 = view.load %text_view[%50] : view<5xi8> -> i8
  func.return %51 : i8
}

global.rodata.def @flags = bytes("0001")

global.rodata.def @codes = bytes("0309")

global.rodata.def @words = align(4) bytes("0102030405060708")

global.rodata.def @text = bytes("4c6f6f6d00")

// ====
namespace shared {
extern const unsigned declaration[2];
extern const unsigned definition[2] = {3, 5};
inline constexpr unsigned inline_definition[2] = {7, 11};
static constexpr unsigned private_definition[2] = {13, 17};
}

unsigned linked_lookup(unsigned index) {
  const unsigned lane = index & 1u;
  return shared::declaration[lane] + shared::inline_definition[lane] +
         shared::private_definition[lane];
}

// ----
func.def public @linked_lookup(%index: i32) -> (i32) {
  %shared_declaration_storage = global.load @shared.declaration : buffer
  %shared_declaration_storage_byte_offset = index.constant 0 : offset
  %shared_declaration_view = buffer.view %shared_declaration_storage[%shared_declaration_storage_byte_offset] : buffer -> view<2xi32>
  %shared_inline_definition_storage = global.load @shared.inline_definition : buffer
  %shared_inline_definition_view = buffer.view %shared_inline_definition_storage[%shared_declaration_storage_byte_offset] : buffer -> view<2xi32>
  %shared_private_definition_storage = global.load @shared_private_definition : buffer
  %shared_private_definition_view = buffer.view %shared_private_definition_storage[%shared_declaration_storage_byte_offset] : buffer -> view<2xi32>
  %2 = scalar.constant 1 : i32
  %lane = scalar.andi %index, %2 : i32
  %7 = scalar.extui %lane : i32 to i64
  %8 = scalar.assume %7 [range(%7, 0, 1)] : i64
  %9 = index.cast %8 : i64 to index
  %10 = view.load %shared_declaration_view[%9] : view<2xi32> -> i32
  %17 = view.load %shared_inline_definition_view[%9] : view<2xi32> -> i32
  %18 = scalar.addi %10, %17 : i32
  %25 = view.load %shared_private_definition_view[%9] : view<2xi32> -> i32
  %26 = scalar.addi %18, %25 : i32
  func.return %26 : i32
}

global.rodata.def public @shared.definition = align(4) bytes("0300000005000000")

global.rodata.decl @shared.declaration

global.rodata.def public linkonce @shared.inline_definition = align(4) bytes("070000000b000000")

global.rodata.def @shared_private_definition = align(4) bytes("0d00000011000000")
