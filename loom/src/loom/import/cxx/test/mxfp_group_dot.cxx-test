// RUN: pass inline-callables,combine,cse,symbol-dce
// INPUT: cxx root=mxfp4_group_dot root=mxfp8_group_dot
#include "mxfp_group_dot.cxx"

// ----
func.def public @mxfp4_group_dot(%payload: vector<4xi32>, %scale: vector<1xi32>, %activations: vector<32xbf16>) -> (f32) {
  %schema = encoding.define #encoding.f4e2m1<affine=scale_only, payload_elements=32, payload_packing=little_endian_nibbles, payload_registers=4, scale_format=e8m0, scale_group_elements=32, scale_operands=1, scale_topology=block_1d, zero_scale_fallback=true> : encoding<schema>
  %weights = vector.decode %payload using %schema {scale = %scale : vector<1xi32>} : vector<4xi32>, encoding<schema> -> vector<32xbf16>
  %partial$22 = vector.splatf 0.0 : vector<16xf32>
  %partial$8 = vector.dot2f %weights, %activations, %partial$22 : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  %9 = scalar.constant 0.0 : f32
  %10 = vector.reduce<addf> %partial$8, %9 : vector<16xf32>, f32
  func.return %10 : f32
}

func.def public @mxfp8_group_dot(%payload: vector<32xf8E4M3>, %scale: vector<1xi32>, %activations: vector<32xbf16>) -> (f32) {
  %schema = encoding.define #encoding.f8e4m3fn<affine=scale_only, payload_elements=32, scale_format=e8m0, scale_group_elements=32, scale_operands=1, scale_topology=block_1d> : encoding<schema>
  %weights = vector.decode %payload using %schema {scale = %scale : vector<1xi32>} : vector<32xf8E4M3>, encoding<schema> -> vector<32xbf16>
  %partial$23 = vector.splatf 0.0 : vector<16xf32>
  %partial$19 = vector.dot2f %weights, %activations, %partial$23 : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  %20 = scalar.constant 0.0 : f32
  %21 = vector.reduce<addf> %partial$19, %20 : vector<16xf32>, f32
  func.return %21 : f32
}
