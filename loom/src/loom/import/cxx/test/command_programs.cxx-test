// RUN: roundtrip
#include <loomcxx/buffer.h>
#include <loomcxx/view.h>

namespace loomt = loom::type;
using Parameters = loomt::buffer<const unsigned char>;
using MutableBytes = loomt::buffer<unsigned char>;

[[loom::command_program, loom::symbol("decode.static")]] void decode_static(unsigned variant, [[loom::launch]] Parameters parameters, MutableBytes output) {
  (void)variant;
  (void)parameters;
  (void)output;
}

// ----
command.def public @decode.static(%variant: i32) launch(%parameters: buffer, %output: buffer) {
  command.return
}

// ====
// Dynamic view extents and encodings remain specializations while the final
// handle occupies the launch-binding suffix. Predicates resolve against the
// same retained source/native component permutation.
// RUN: roundtrip
#include <loomcxx/buffer.h>
#include <loomcxx/view.h>

namespace loomt = loom::type;
using Parameters = loomt::buffer<const unsigned char>;
using Output = loomt::view<loomt::shape<loomt::dynamic, 4>, float, loomt::encoding<loom::encoding::role::layout, 2>>;

[[loom::command_program, loom::symbol("decode.dynamic")]] void decode_dynamic(unsigned tokens, [[loom::launch]] Parameters parameters, Output output) [[loom::where(tokens > 0u)]] {
  (void)parameters;
  (void)output;
}

// ----
command.def public @decode.dynamic(%tokens: i32, %output_dim0: index, %output_layout: encoding<layout>) launch(%parameters: buffer, %output: view<[%output_dim0]x4xf32, %output_layout>) where [ne(%tokens, 0)] {
  command.return
}

// ====
// A program without a boundary has a specialization-only signature.
// RUN: roundtrip
[[loom::command_program]] void prepare(unsigned count) { (void)count; }

// ----
command.def public @prepare(%count: i32) launch() {
  command.return
}

// ====
// Explicit command launch preserves the callee's source/native signature
// projection, including dependent view specializations.
// RUN: roundtrip
#include <loomcxx/command.h>

namespace loomt = loom::type;
using Parameters = loomt::buffer<const unsigned char>;
using Output = loomt::view<loomt::shape<loomt::dynamic, 4>, float, loomt::encoding<loom::encoding::role::layout, 2>>;

[[loom::command_program, loom::symbol("decode.leaf")]] void decode_leaf(unsigned tokens, [[loom::launch]] Parameters parameters, Output output);

[[loom::command_program, loom::symbol("decode.root")]] void decode_root(unsigned tokens, [[loom::launch]] Parameters parameters, Output output) {
  [[loom::serial]] {
    loom::command::launch<decode_leaf>(tokens, parameters, output);
    [[loom::concurrent]] {
      loom::command::launch<decode_leaf>(tokens, parameters, output);
      loom::command::launch<decode_leaf>(tokens, parameters, output);
    }
  }
}

// ----
command.def public @decode.root(%tokens: i32, %output_dim0: index, %output_layout: encoding<layout>) launch(%parameters: buffer, %output: view<[%output_dim0]x4xf32, %output_layout>) {
  command.serial {
    command.launch @decode.leaf[%tokens, %output_dim0, %output_layout](%parameters, %output) : [i32, index, encoding<layout>](buffer, view<[%output_dim0]x4xf32, %output_layout>)
    command.concurrent {
      command.launch @decode.leaf[%tokens, %output_dim0, %output_layout](%parameters, %output) : [i32, index, encoding<layout>](buffer, view<[%output_dim0]x4xf32, %output_layout>)
      command.launch @decode.leaf[%tokens, %output_dim0, %output_layout](%parameters, %output) : [i32, index, encoding<layout>](buffer, view<[%output_dim0]x4xf32, %output_layout>)
    }
  }
  command.return
}

command.decl public @decode.leaf(%5: i32, %6: index, %7: encoding<layout>) launch(%8: buffer, %9: view<[%6]x4xf32, %7>)

// ====
// Kernels use the same explicit launch spelling and typed buffers materialize
// their pointer ABI operands without introducing C++ pointer arithmetic.
// RUN: roundtrip
#include <loomcxx/command.h>
#include <loomcxx/kernel.h>

namespace loomt = loom::type;
using Input = loomt::buffer<const float>;
using Output = loomt::buffer<float>;

[[loom::kernel, loom::workgroup_count(1, 1, 1), loom::workgroup_size(64, 1, 1)]] void copy(unsigned count, const float* input, float* output) {
  (void)count;
  (void)input;
  (void)output;
}

[[loom::command_program]] void run_copy(unsigned count, [[loom::launch]] Input input, Output output) {
  loom::kernel::launch<copy>(count, input, output);
}

// ----
kernel.def @copy() {
  %3 = index.constant 1 : index
  %4 = index.constant 1 : index
  %5 = index.constant 1 : index
  %6 = index.constant 64 : index
  %7 = index.constant 1 : index
  %8 = index.constant 1 : index
  kernel.launch.config workgroups(%3, %4, %5) workgroup_size(%6, %7, %8) : index
} launch(%count: i32, %input: buffer, %output: buffer) {
  %input_byte_offset = index.constant 0 : offset
  %output_byte_offset = index.constant 0 : offset
  kernel.return
}

command.def public @run_copy(%count: i32) launch(%input: buffer, %output: buffer) {
  kernel.launch @copy(%count, %input, %output) : (i32, buffer, buffer)
  command.return
}

// ====
// Named parameters bind dynamic dimensions and encodings directly into their
// typed result, while key substitutions remain explicit index operands.
// RUN: roundtrip
#include <loomcxx/command.h>

namespace loomt = loom::type;
using Parameters = loomt::buffer<const unsigned char>;
using Layout = loomt::encoding<loom::encoding::role::layout, 2>;

[[loom::command_program]] void resolve_weight(loomt::index rows, loomt::index layer, [[loom::launch]] Parameters parameters) {
  auto layout = loom::encoding::layout::dense<2>();
  auto weight = loom::command::parameter<loomt::shape<loomt::dynamic, 4>, const float, Layout>(parameters, rows, layout, "blk.{}.weight", layer);
  auto base = loom::command::base(weight);
  (void)base;
}

// ----
command.def public @resolve_weight(%rows: index, %layer: index) launch(%parameters: buffer) {
  %layout = encoding.layout.dense : encoding<layout>
  %weight = command.parameter %parameters, "blk.{}.weight"[%layer] : view<[%rows]x4xf32, %layout>
  %base = command.parameter.base %weight : view<[%rows]x4xf32, %layout> -> buffer
  command.return
}

// ====
// Configured launches retain a distinct workload bundle. A typed buffer can
// supply a zero-origin C++ pointer workload without becoming pointer arithmetic
// in the command program.
// RUN: roundtrip
#include <loomcxx/command.h>
#include <loomcxx/kernel.h>

namespace loomt = loom::type;
using Counts = loomt::buffer<const unsigned>;
using Output = loomt::buffer<float>;

static loom::kernel::configuration configure(unsigned count, const unsigned* counts) {
  (void)counts;
  return {{count, 1, 1}, {64, 1, 1}};
}

[[loom::kernel(configure)]] void configured(float* output) { (void)output; }

[[loom::command_program]] void run_configured(unsigned count, [[loom::launch]] Counts counts, Output output) {
  loom::kernel::launch<configured>(loom::kernel::workload(count, counts), output);
}

// ----
kernel.def @configured(%count: i32, %counts: buffer, %counts_byte_offset: offset) {
  %4 = scalar.constant 1 : i32
  %5 = scalar.constant 1 : i32
  %6 = scalar.constant 64 : i32
  %7 = scalar.constant 1 : i32
  %8 = scalar.constant 1 : i32
  %9 = scalar.extui %count : i32 to i64
  %10 = index.cast %9 : i64 to index
  %11 = scalar.extui %4 : i32 to i64
  %12 = index.cast %11 : i64 to index
  %13 = scalar.extui %5 : i32 to i64
  %14 = index.cast %13 : i64 to index
  %15 = scalar.extui %6 : i32 to i64
  %16 = index.cast %15 : i64 to index
  %17 = scalar.extui %7 : i32 to i64
  %18 = index.cast %17 : i64 to index
  %19 = scalar.extui %8 : i32 to i64
  %20 = index.cast %19 : i64 to index
  kernel.launch.config workgroups(%10, %12, %14) workgroup_size(%16, %18, %20) : index
} launch(%output: buffer) {
  %output_byte_offset = index.constant 0 : offset
  kernel.return
}

command.def public @run_configured(%count: i32) launch(%counts: buffer, %output: buffer) {
  %counts_byte_offset = index.constant 0 : offset
  kernel.launch @configured[%count, %counts, %counts_byte_offset](%output) : [i32, buffer, offset](buffer)
  command.return
}
