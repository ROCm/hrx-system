  %16 = scalar.shli %5, %15 : i64
  %8 = index.cast %words_byte_offset : offset to i64
  %9 = scalar.addi %8, %16 : i64
  %10 = scalar.assume %9 [range(%9, 0, 9223372036854775807)] : i64
  %11 = index.cast %10 : i64 to offset
  %12 = buffer.view %words[%11] : buffer -> view<1xi32>
  %13 = view.load %12[0] : view<1xi32> -> i32
  %14 = scalar.ori %13, %mask : i32
  view.store %14, %12[0] : i32, view<1xi32>
  func.return %14 : i32
}

// ====
// Address and RHS effects execute once, with the RHS sequenced first.
unsigned update(unsigned* words, unsigned index, unsigned mask) {
  unsigned result = words[index++] |= (index += 1, mask);
  return result + index;
}

