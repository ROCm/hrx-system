// ====
// Vector storage retains its lane footprint and observable access flags.
using Words = unsigned __attribute__((vector_size(16)));
Words update(volatile Words* words, Words mask) { return *words ^= mask; }

// ----
func.def public @update(%words: buffer, %words_byte_offset: offset, %mask: vector<4xi32>) -> (vector<4xi32>) {
  %4 = buffer.view %words[%words_byte_offset] : buffer -> view<4xi32>
  %5 = vector.load<volatile> %4[0] : view<4xi32> -> vector<4xi32>
  %6 = vector.xori %5, %mask : vector<4xi32>
  vector.store<volatile> %6, %4[0] : vector<4xi32>, view<4xi32>
  func.return %6 : vector<4xi32>
}

// ====
// Fixed workgroup arrays retain their indexed view for both accesses.
#include <loomcxx/kernel.h>
[[loom::kernel, loom::workgroup_size(64, 1, 1)]]
void update(unsigned* output) {
  [[loom::workgroup]] volatile unsigned words[64];
  unsigned index = loom::workitem_id.x;
  words[index] = index;
  words[index] += 5;
  output[index] = words[index];
}

