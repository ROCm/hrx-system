config.decl @update.workgroup_count.x : index

config.decl @update.workgroup_count.y : index

config.decl @update.workgroup_count.z : index

// ====
// Discarded compound results emit exactly one volatile read and write.
void update(volatile unsigned* words, unsigned mask) {
  *words |= mask;
  ++words[0];
  (*words)--;
}

