} launch(%output: buffer) {
  %11 = index.constant 256 : offset
  %words = buffer.alloca<workgroup> align(4) %11 : buffer
  %words_byte_offset = index.constant 0 : offset
  %words_view = buffer.view %words[%words_byte_offset] : buffer -> view<64xi32>
  %workitem_id_x = kernel.workitem.id<x> : index
  %index = index.cast %workitem_id_x : index to i32
  %17 = scalar.extui %index : i32 to i64
  %18 = scalar.assume %17 [range(%17, 0, 63)] : i64
  %19 = index.cast %18 : i64 to index
  view.store<volatile> %index, %words_view[%19] : i32, view<64xi32>
  %20 = scalar.constant 5 : i32
  %24 = view.load<volatile> %words_view[%19] : view<64xi32> -> i32
  %25 = scalar.addi %24, %20 : i32
  view.store<volatile> %25, %words_view[%19] : i32, view<64xi32>
  %29 = view.load<volatile> %words_view[%19] : view<64xi32> -> i32
  %40 = scalar.constant 2 : i32
  %41 = scalar.shli %index, %40 : i32
  %42 = scalar.extui %41 : i32 to i64
  %35 = scalar.assume %42 [range(%42, 0, 9223372036854775807)] : i64
  %36 = index.cast %35 : i64 to offset
  %37 = buffer.view %output[%36] : buffer -> view<1xi32>
  view.store %29, %37[0] : i32, view<1xi32>
  kernel.return
