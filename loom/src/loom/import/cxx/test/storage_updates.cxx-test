// ====
// Both signed and unsigned narrow elements use promoted arithmetic.
int update(unsigned char* bytes, signed char* signed_bytes, int amount) {
  unsigned first = bytes[0] += amount;
  int second = signed_bytes[0] /= amount;
  return first + second;
}

