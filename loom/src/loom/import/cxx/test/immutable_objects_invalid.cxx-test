// RUN: verify
struct Entry {
  mutable unsigned value;
};
static constexpr Entry mutable_table[1] = {{1}};
unsigned mutable_lookup(unsigned index) {
  // ERROR@+1: LOWERING/059 "immutable storage requires a nonvolatile deeply const object"
  return mutable_table[index % 1u].value;
}

// ====
static constexpr unsigned value = 1;
static constexpr const unsigned* address_table[1] = {&value};
bool address_lookup(unsigned index) {
  // ERROR@+1: LOWERING/059 "immutable storage requires a fully initialized, trivially copyable, address-free object representation"
  return address_table[index % 1u] != nullptr;
}

// ====
static thread_local const unsigned thread_table[1] = {1};
unsigned thread_lookup(unsigned index) {
  // ERROR@+1: LOWERING/059 "immutable storage requires a namespace-scope object without thread-local storage"
  return thread_table[index % 1u];
}

// ====
struct Bits {
  unsigned low : 4;
  unsigned high : 4;
};
static constexpr Bits bitfield_table[1] = {{3, 12}};
unsigned bitfield_lookup(unsigned index) {
  // ERROR@+1: LOWERING/059 "record storage requires named fields without bitfields or no_unique_address"
  return bitfield_table[index % 1u].low;
}

// ====
struct Empty {};
struct Compact {
  [[no_unique_address]] Empty empty;
  unsigned value;
};
static constexpr Compact compact_table[1] = {{{}, 7}};
unsigned compact_lookup(unsigned index) {
  // ERROR@+1: LOWERING/059 "record storage requires named fields without bitfields or no_unique_address"
  return compact_table[index % 1u].value;
}

// ====
struct Base {
  unsigned value;
};
struct Derived : Base {
  unsigned other;
};
static constexpr Derived base_table[1] = {{{7}, 9}};
unsigned base_lookup(unsigned index) {
  // ERROR@+1: LOWERING/059 "record storage requires a complete baseless non-union type with aggregate or user-provided construction and trivial copy and destruction"
  return base_table[index % 1u].other;
}

// ====
template <unsigned Value>
inline constexpr unsigned templated_table[1] = {Value};

unsigned templated_lookup(unsigned index) {
  // ERROR@+1: LOWERING/059 "linkable immutable object template specializations are unsupported"
  return templated_table<7>[index % 1u];
}
