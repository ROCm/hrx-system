#include <loomcxx/kernel.h>
#include <loomcxx/scalar.h>
#include <loomcxx/vector.h>

using Float32x4 = float __attribute__((ext_vector_type(4)));

[[loom::kernel, loom::workgroup_count(1, 1, 1), loom::workgroup_size(1, 1, 1)]]
void page_weighted_dot(const int* page_table, const float* lhs, const float* rhs, float* output) {
  auto pages = loom::buffer::view<1>(page_table, {}, loom::encoding::layout::dense<1>());
  auto lhs_values = loom::buffer::view<4>(lhs, {}, loom::encoding::layout::dense<1>());
  auto rhs_values = loom::buffer::view<4>(rhs, {}, loom::encoding::layout::dense<1>());
  auto result = loom::buffer::view<1>(output, {}, loom::encoding::layout::dense<1>());
  int page_id = loom::view::load(pages, loom::type::index{0});
  if (page_id >= 0) {
    Float32x4 lhs_vector = loom::vector::load<Float32x4>(lhs_values, loom::type::indices{loom::type::index{0}});
    Float32x4 rhs_vector = loom::vector::load<Float32x4>(rhs_values, loom::type::indices{loom::type::index{0}});
    float score = loom::vector::dotf(lhs_vector, rhs_vector, 0.0f);
    float weight = loom::scalar::approximate::expf(score);
    loom::view::store(weight, result, loom::type::index{0});
  }
}

