using Boolx4 = loom::type::vector<loom::type::shape<4>, bool>;
using Float16x4 = std::float16_t __attribute__((ext_vector_type(4)));
using Float32x4 = float __attribute__((ext_vector_type(4)));
using Int32x4 = int __attribute__((ext_vector_type(4)));

[[loom::symbol("classify")]]
Boolx4 classify(Int32x4 lhs, Int32x4 rhs, Float32x4 values);

[[loom::symbol("narrow")]]
Float16x4 narrow(Float32x4 values);

[[loom::symbol("bytes")]]
loom::type::view<loom::type::shape<16>, const unsigned char> bytes(loom::type::buffer<unsigned> data, loom::type::offset byte_offset);

[[loom::symbol("infinity")]]
float infinity();

[[loom::symbol("quiet_nan")]]
float quiet_nan();

[[loom::symbol("classify")]]
Boolx4 classify(Int32x4 lhs, Int32x4 rhs, Float32x4 values) {
  Boolx4 ordered = loom::vector::cmpi::slt<Boolx4>(lhs, rhs);
  Boolx4 unordered = loom::vector::cmpf::uno<Boolx4>(values, values);
  return (ordered | unordered);
}

[[loom::symbol("narrow")]]
Float16x4 narrow(Float32x4 values) {
  return loom::convert<Float16x4, loom::conversion::subnormal::daz_ftz>(values);
}

[[loom::symbol("bytes")]]
loom::type::view<loom::type::shape<16>, const unsigned char> bytes(loom::type::buffer<unsigned> data, loom::type::offset byte_offset) {
  auto words = loom::buffer::view<4>(loom::buffer::cast<const unsigned>(data), byte_offset, {});
  return loom::view::bitcast<loom::type::view<loom::type::shape<16>, const unsigned char>>(words);
}

[[loom::symbol("infinity")]]
float infinity() {
  return __builtin_bit_cast(float, 2139095040u);
}

[[loom::symbol("quiet_nan")]]
float quiet_nan() {
  return __builtin_bit_cast(float, 2143289344u);
}

