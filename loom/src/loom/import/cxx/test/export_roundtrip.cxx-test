#include <loomcxx/numeric.h>
#include <loomcxx/vector.h>

using Float4 = float __attribute__((ext_vector_type(4)));
using Half4 = _Float16 __attribute__((ext_vector_type(4)));
using Int4 = int __attribute__((ext_vector_type(4)));
using Mask4 = loom::type::vector<loom::type::shape<4>, bool>;
using Words = loom::type::view<loom::type::shape<4>, unsigned>;
using Bytes = loom::type::view<loom::type::shape<16>, unsigned char>;

Mask4 classify(Int4 lhs, Int4 rhs, Float4 values) {
  Mask4 ordered = loom::vector::cmpi::slt<Mask4>(lhs, rhs);
  Mask4 unordered = loom::vector::cmpf::uno<Mask4>(values, values);
  return ordered | unordered;
}
Half4 narrow(Float4 values) {
  return loom::convert<Half4, loom::conversion::subnormal::daz_ftz>(values);
}
Bytes bytes(loom::type::buffer<unsigned> data, loom::type::offset byte_offset) {
  Words words = loom::buffer::view<4>(data, byte_offset, {});
  return loom::view::bitcast<Bytes>(words);
}
float infinity() { return __builtin_bit_cast(float, 0x7f800000u); }
float quiet_nan() { return __builtin_bit_cast(float, 0x7fc00000u); }

