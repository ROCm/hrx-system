// RUN: roundtrip
// Redeclarations contribute to one kernel configuration.
[[loom::workgroup_size(64, 1, 1)]] void entry();
[[loom::workgroup_count(2, 1, 1)]] void entry();
[[loom::kernel]] void entry() {}
// ----
kernel.def @entry() {
  %0 = index.constant 2 : index
  %1 = index.constant 1 : index
  %2 = index.constant 1 : index
  %3 = index.constant 64 : index
  %4 = index.constant 1 : index
  %5 = index.constant 1 : index
  kernel.launch.config workgroups(%0, %1, %2) workgroup_size(%3, %4, %5) : index
} launch() {
  kernel.return
}

// ====
// RUN: roundtrip
// Multiple kernels retain exact and symbolic launch contracts.
[[loom::kernel, loom::workgroup_size(64, 1, 1),
  loom::workgroup_count(2, 1, 1)]] void
first() {}
[[loom::kernel]] void second() {}
// ----
kernel.def @first() {
  %0 = index.constant 2 : index
  %1 = index.constant 1 : index
  %2 = index.constant 1 : index
  %3 = index.constant 64 : index
  %4 = index.constant 1 : index
  %5 = index.constant 1 : index
  kernel.launch.config workgroups(%0, %1, %2) workgroup_size(%3, %4, %5) : index
} launch() {
  kernel.return
}

kernel.def @second() {
  %workgroup_count_x = config.get @second.workgroup_count.x : index
  %workgroup_count_y = config.get @second.workgroup_count.y : index
  %workgroup_count_z = config.get @second.workgroup_count.z : index
  %workgroup_size_x = config.get @second.workgroup_size.x : index
  %workgroup_size_y = config.get @second.workgroup_size.y : index
  %workgroup_size_z = config.get @second.workgroup_size.z : index
  kernel.launch.config workgroups(%workgroup_count_x, %workgroup_count_y, %workgroup_count_z) workgroup_size(%workgroup_size_x, %workgroup_size_y, %workgroup_size_z) : index
} launch() {
  kernel.return
}

config.decl @second.workgroup_count.x : index

config.decl @second.workgroup_count.y : index

config.decl @second.workgroup_count.z : index

config.decl @second.workgroup_size.x : index

config.decl @second.workgroup_size.y : index

config.decl @second.workgroup_size.z : index

// ====
// RUN: roundtrip
// Launch bounds from declarations become config predicates.
[[loom::kernel, loom::workgroup_count_range(1, 4, 1, 1, 1, 1)]]
void bounded();
[[using loom: workgroup_size_range(32, 128, 1, 1, 1, 1)]]
void bounded() {}
// ----
kernel.def @bounded() {
  %workgroup_count_x = config.get @bounded.workgroup_count.x : index
  %workgroup_count_y = config.get @bounded.workgroup_count.y : index
  %workgroup_count_z = config.get @bounded.workgroup_count.z : index
  %workgroup_size_x = config.get @bounded.workgroup_size.x : index
  %workgroup_size_y = config.get @bounded.workgroup_size.y : index
  %workgroup_size_z = config.get @bounded.workgroup_size.z : index
  kernel.launch.config workgroups(%workgroup_count_x, %workgroup_count_y, %workgroup_count_z) workgroup_size(%workgroup_size_x, %workgroup_size_y, %workgroup_size_z) : index
} launch() {
  kernel.return
}

config.decl @bounded.workgroup_count.x : %0: index where [range(%0, 1, 4)]

config.decl @bounded.workgroup_count.y : %2: index where [range(%2, 1, 1)]

config.decl @bounded.workgroup_count.z : %4: index where [range(%4, 1, 1)]

config.decl @bounded.workgroup_size.x : %6: index where [range(%6, 32, 128)]

config.decl @bounded.workgroup_size.y : %8: index where [range(%8, 1, 1)]

config.decl @bounded.workgroup_size.z : %10: index where [range(%10, 1, 1)]

// ====
// RUN: roundtrip
// Overloaded kernels have distinct configuration symbols.
namespace kernels {
[[loom::kernel, loom::symbol("kernels.entry.f32")]] void entry(float* output) {}
[[loom::kernel, loom::symbol("kernels.entry.i32")]] void entry(int* output) {}
}  // namespace kernels
// ----
kernel.def @kernels.entry.f32() {
  %workgroup_count_x = config.get @kernels.entry.f32.workgroup_count.x : index
  %workgroup_count_y = config.get @kernels.entry.f32.workgroup_count.y : index
  %workgroup_count_z = config.get @kernels.entry.f32.workgroup_count.z : index
  %workgroup_size_x = config.get @kernels.entry.f32.workgroup_size.x : index
  %workgroup_size_y = config.get @kernels.entry.f32.workgroup_size.y : index
  %workgroup_size_z = config.get @kernels.entry.f32.workgroup_size.z : index
  kernel.launch.config workgroups(%workgroup_count_x, %workgroup_count_y, %workgroup_count_z) workgroup_size(%workgroup_size_x, %workgroup_size_y, %workgroup_size_z) : index
} launch(%output: buffer) {
  %output_byte_offset = index.constant 0 : offset
  kernel.return
}

config.decl @kernels.entry.f32.workgroup_count.x : index

config.decl @kernels.entry.f32.workgroup_count.y : index

config.decl @kernels.entry.f32.workgroup_count.z : index

config.decl @kernels.entry.f32.workgroup_size.x : index

config.decl @kernels.entry.f32.workgroup_size.y : index

config.decl @kernels.entry.f32.workgroup_size.z : index

kernel.def @kernels.entry.i32() {
  %workgroup_count_x = config.get @kernels.entry.i32.workgroup_count.x : index
  %workgroup_count_y = config.get @kernels.entry.i32.workgroup_count.y : index
  %workgroup_count_z = config.get @kernels.entry.i32.workgroup_count.z : index
  %workgroup_size_x = config.get @kernels.entry.i32.workgroup_size.x : index
  %workgroup_size_y = config.get @kernels.entry.i32.workgroup_size.y : index
  %workgroup_size_z = config.get @kernels.entry.i32.workgroup_size.z : index
  kernel.launch.config workgroups(%workgroup_count_x, %workgroup_count_y, %workgroup_count_z) workgroup_size(%workgroup_size_x, %workgroup_size_y, %workgroup_size_z) : index
} launch(%output: buffer) {
  %output_byte_offset = index.constant 0 : offset
  kernel.return
}

config.decl @kernels.entry.i32.workgroup_count.x : index

config.decl @kernels.entry.i32.workgroup_count.y : index

config.decl @kernels.entry.i32.workgroup_count.z : index

config.decl @kernels.entry.i32.workgroup_size.x : index

config.decl @kernels.entry.i32.workgroup_size.y : index

config.decl @kernels.entry.i32.workgroup_size.z : index
