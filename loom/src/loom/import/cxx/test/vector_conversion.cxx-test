// RUN: roundtrip
static_assert(__has_builtin(__builtin_convertvector));
using Int4 = int __attribute__((ext_vector_type(4)));
using Float4 = float __attribute__((ext_vector_type(4)));
Float4 entry(Int4 value) { return __builtin_convertvector(value, Float4); }

// ----
func.def public @entry(%value: vector<4xi32>) -> (vector<4xf32>) {
  %2 = vector.sitofp %value : vector<4xi32> to vector<4xf32>
  func.return %2 : vector<4xf32>
}

