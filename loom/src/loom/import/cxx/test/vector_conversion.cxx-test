// ====
using Float8x4 = __float8_e4m3fn __attribute__((ext_vector_type(4)));
using Float4 = float __attribute__((ext_vector_type(4)));
Float8x4 entry(Float8x4 value, float scale) {
  auto wide = __builtin_convertvector(value, Float4);
  return __builtin_convertvector(wide * scale, Float8x4);
}

// ----
func.def public @entry(%value: vector<4xf8E4M3>, %scale: f32) -> (vector<4xf8E4M3>) {
  %wide = vector.extf %value : vector<4xf8E4M3> to vector<4xf32>
  %4 = vector.splat %scale : vector<4xf32>
  %5 = vector.mulf %wide, %4 : vector<4xf32>
  %6 = vector.fptrunc %5 : vector<4xf32> to vector<4xf8E4M3>
  func.return %6 : vector<4xf8E4M3>
}

