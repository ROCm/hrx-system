  func.return %value : vector<4xi32>
}

// ====
using Int4 = int __attribute__((ext_vector_type(4)));
using Float4 = float __attribute__((ext_vector_type(4)));
template <typename To, typename From>
static constexpr To convert(From value) {
  return __builtin_convertvector(value, To);
}
constexpr Float4 value{1.75f, -2.75f, 3.0f, -0.0f};
constexpr auto converted = convert<Int4>(value);
static_assert(converted[0] == 1 && converted[1] == -2);
static_assert(converted[2] == 3 && converted[3] == 0);
Int4 entry() { return converted; }

// ----
func.def public @entry() -> (vector<4xi32>) {
  %1 = scalar.constant 1 : i32
  %2 = scalar.constant -2 : i32
  %3 = scalar.constant 3 : i32
  %4 = scalar.constant 0 : i32
  %converted = vector.from_elements %1, %2, %3, %4 : vector<4xi32>
  func.return %converted : vector<4xi32>
}

// ====
using UInt64x2 = unsigned long long __attribute__((ext_vector_type(2)));
using Double2 = double __attribute__((ext_vector_type(2)));
constexpr UInt64x2 values{0xffffffffffffffffULL, 0x8000000000000000ULL};
constexpr auto converted = __builtin_convertvector(values, Double2);
static_assert(converted[0] == 0x1p64 && converted[1] == 0x1p63);
Double2 entry() { return converted; }

// ----
func.def public @entry() -> (vector<2xf64>) {
  %1 = scalar.constant 1.8446744073709552e+19 : f64
  %2 = scalar.constant 9.2233720368547758e+18 : f64
  %converted = vector.from_elements %1, %2 : vector<2xf64>
  func.return %converted : vector<2xf64>
}

// ====
using Double4 = double __attribute__((ext_vector_type(4)));
using Float8x4 = __float8_e4m3fn __attribute__((ext_vector_type(4)));
constexpr Double4 values{0x1.1000000000001p0, 1.0625, -0.0, 1000.0};
constexpr auto converted = __builtin_convertvector(values, Float8x4);
static_assert(converted[0] == 1.125 && converted[1] == 1.0);
static_assert(converted[2] == 0.0 && converted[3] == 448.0);
Float8x4 entry() { return converted; }

// ----
func.def public @entry() -> (vector<4xf8E4M3>) {
  %1 = scalar.constant 1.125 : f8E4M3
  %2 = scalar.constant 1.0 : f8E4M3
  %3 = scalar.constant -0.0 : f8E4M3
  %4 = scalar.constant 448.0 : f8E4M3
  %converted = vector.from_elements %1, %2, %3, %4 : vector<4xf8E4M3>
  func.return %converted : vector<4xf8E4M3>
}

