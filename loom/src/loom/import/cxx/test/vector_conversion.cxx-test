// INPUT: cxx std=c23
typedef unsigned char Byte4 __attribute__((vector_size(4)));
typedef float Float4 __attribute__((vector_size(16)));
Float4 entry(Byte4 value) { return __builtin_convertvector(value, Float4); }

// ----
func.def public source_signature(#func.abi.c.signature<arguments = [1], results = [3], types = [#func.abi.c.type<unsigned_integer, byte_length = 1, byte_alignment = 1, component_count = 1, bitwidth = 8>, #func.abi.c.type<vector, byte_length = 4, byte_alignment = 4, component_count = 1, element_type = 0, element_count = 4>, #func.abi.c.type<floating, byte_length = 4, byte_alignment = 4, component_count = 1, format = f32>, #func.abi.c.type<vector, byte_length = 16, byte_alignment = 16, component_count = 1, element_type = 2, element_count = 4>]>) @entry(%value: vector<4xi8>) -> (vector<4xf32>) {
  %2 = vector.uitofp %value : vector<4xi8> to vector<4xf32>
  func.return %2 : vector<4xf32>
}

// ====
using UInt64x2 = unsigned long long __attribute__((ext_vector_type(2)));
using BFloat2 = __bf16 __attribute__((ext_vector_type(2)));
constexpr UInt64x2 values{0x8080000000000001ULL, 0x8080000000000000ULL};
constexpr auto converted = __builtin_convertvector(values, BFloat2);
static_assert(converted[0] == 0x1.02p63 && converted[1] == 0x1p63);
static_assert(static_cast<__bf16>(0x8080000000000001ULL) == 0x1.02p63);
enum class Big : unsigned long long { value = 0xffffffffffffffffULL };
static_assert(static_cast<double>(Big::value) == 0x1p64);
BFloat2 entry() { return converted; }

// ----
func.def public @entry() -> (vector<2xbf16>) {
  %1 = scalar.constant 9.2954296308927037e+18 : bf16
  %2 = scalar.constant 9.2233720368547758e+18 : bf16
  %converted = vector.from_elements %1, %2 : vector<2xbf16>
  func.return %converted : vector<2xbf16>
}

// ====
using Float4 = float __attribute__((ext_vector_type(4)));
using UInt4 = unsigned __attribute__((ext_vector_type(4)));
constexpr Float4 values{-0.5f, 1.75f, 257.5f, 0x1p31f};
constexpr auto converted = __builtin_convertvector(values, UInt4);
static_assert(converted[0] == 0 && converted[1] == 1);
static_assert(converted[2] == 257 && converted[3] == 0x80000000U);
UInt4 entry() { return converted; }

// ----
func.def public @entry() -> (vector<4xi32>) {
  %1 = scalar.constant 0 : i32
  %2 = scalar.constant 1 : i32
  %3 = scalar.constant 257 : i32
  %4 = scalar.constant -2147483648 : i32
  %converted = vector.from_elements %1, %2, %3, %4 : vector<4xi32>
  func.return %converted : vector<4xi32>
}

