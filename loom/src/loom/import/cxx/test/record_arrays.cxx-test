// ====
// Array elements keep nested record layout and whole-vector load/store types.
using Float4 = float __attribute__((ext_vector_type(4)));
struct Record { unsigned tag; Float4 values[2]; };
struct Batch { unsigned count; Record records[3]; };
Float4 update(Batch* batches, unsigned batch, unsigned record, unsigned index) {
  auto* values = batches[batch].records[record].values;
  values[index] += Float4{1.0f, 2.0f, 3.0f, 4.0f};
  return values[index];
}

// ----
func.def public @update(%batches: buffer, %batches_byte_offset: offset, %batch: i32, %record: i32, %index: i32) -> (vector<4xf32>) {
  %6 = scalar.extui %batch : i32 to i64
  %7 = scalar.constant 160 : i64
  %8 = scalar.muli %6, %7 : i64
  %9 = index.cast %batches_byte_offset : offset to i64
  %10 = scalar.addi %9, %8 : i64
  %11 = scalar.assume %10 [range(%10, 0, 9223372036854775807)] : i64
  %12 = index.cast %11 : i64 to offset
  %13 = index.constant 16 : offset
  %records_byte_offset = index.add %12, %13 : offset
  %15 = scalar.extui %record : i32 to i64
  %16 = scalar.constant 48 : i64
  %17 = scalar.muli %15, %16 : i64
  %18 = index.cast %records_byte_offset : offset to i64
  %19 = scalar.addi %18, %17 : i64
  %20 = scalar.assume %19 [range(%19, 0, 9223372036854775807)] : i64
  %21 = index.cast %20 : i64 to offset
  %values_byte_offset = index.add %21, %13 : offset
  %24 = scalar.constant 1.0 : f32
  %25 = scalar.constant 2.0 : f32
  %26 = scalar.constant 3.0 : f32
  %27 = scalar.constant 4.0 : f32
  %28 = vector.from_elements %24, %25, %26, %27 : vector<4xf32>
  %29 = scalar.extui %index : i32 to i64
  %50 = scalar.constant 4 : i64
  %51 = scalar.shli %29, %50 : i64
  %32 = index.cast %values_byte_offset : offset to i64
  %33 = scalar.addi %32, %51 : i64
  %34 = scalar.assume %33 [range(%33, 0, 9223372036854775807)] : i64
  %35 = index.cast %34 : i64 to offset
  %36 = buffer.view %batches[%35] : buffer -> view<4xf32>
  %37 = vector.load %36[0] : view<4xf32> -> vector<4xf32>
  %38 = vector.addf %37, %28 : vector<4xf32>
  vector.store %38, %36[0] : vector<4xf32>, view<4xf32>
  %47 = vector.load %36[0] : view<4xf32> -> vector<4xf32>
  func.return %47 : vector<4xf32>
}

// ====
// Volatile propagates through the array and its elements, including decay.
struct Observed { unsigned tag; unsigned values[4]; };
unsigned update(volatile Observed* records, unsigned record, unsigned index) {
  auto* values = records[record].values;
  unsigned previous = values[index]++;
  return previous + records[record].values[index];
}

// ----
func.def public @update(%records: buffer, %records_byte_offset: offset, %record: i32, %index: i32) -> (i32) {
  %5 = scalar.extui %record : i32 to i64
  %6 = scalar.constant 20 : i64
  %7 = scalar.muli %5, %6 : i64
  %8 = index.cast %records_byte_offset : offset to i64
  %9 = scalar.addi %8, %7 : i64
  %10 = scalar.assume %9 [range(%9, 0, 9223372036854775807)] : i64
  %11 = index.cast %10 : i64 to offset
  %12 = index.constant 4 : offset
  %values_byte_offset = index.add %11, %12 : offset
  %14 = scalar.extui %index : i32 to i64
  %46 = scalar.constant 2 : i64
  %47 = scalar.shli %14, %46 : i64
  %17 = index.cast %values_byte_offset : offset to i64
  %18 = scalar.addi %17, %47 : i64
  %19 = scalar.assume %18 [range(%18, 0, 9223372036854775807)] : i64
  %20 = index.cast %19 : i64 to offset
  %21 = buffer.view %records[%20] : buffer -> view<1xi32>
  %previous = view.load<volatile> %21[0] : view<1xi32> -> i32
  %23 = scalar.constant 1 : i32
  %24 = scalar.addi %previous, %23 : i32
  view.store<volatile> %24, %21[0] : i32, view<1xi32>
  %42 = view.load<volatile> %21[0] : view<1xi32> -> i32
  %43 = scalar.addi %previous, %42 : i32
  func.return %43 : i32
}

// ====
// Addressing a shared array through a differently shaped alias retains origin.
#include <loomcxx/kernel.h>
[[loom::kernel, loom::workgroup_size(32, 1, 1)]]
void shared_rows(unsigned* output) {
  [[loom::workgroup]] unsigned words[64];
  auto* rows = reinterpret_cast<unsigned (*)[32]>(&words);
  unsigned index = loom::workitem_id.x;
  rows[1][index] = index;
  output[index] = words[index + 32];
}

// ----
kernel.def @shared_rows() {
  %workgroup_count_x = config.get @shared_rows.workgroup_count.x : index
  %workgroup_count_y = config.get @shared_rows.workgroup_count.y : index
  %workgroup_count_z = config.get @shared_rows.workgroup_count.z : index
  %7 = index.constant 32 : index
  %8 = index.constant 1 : index
  kernel.launch.config workgroups(%workgroup_count_x, %workgroup_count_y, %workgroup_count_z) workgroup_size(%7, %8, %8) : index
} launch(%output: buffer) {
  %11 = index.constant 256 : offset
  %words = buffer.alloca<workgroup> align(4) %11 : buffer
  %words_byte_offset = index.constant 0 : offset
  %words_view = buffer.view %words[%words_byte_offset] : buffer -> view<64xi32>
  %workitem_id_x = kernel.workitem.id<x> : index
  %index = index.cast %workitem_id_x : index to i32
  %57 = scalar.constant 2 : i32
  %58 = scalar.shli %index, %57 : i32
  %59 = scalar.extui %58 : i32 to i64
  %54 = scalar.constant 128 : i64
  %53 = scalar.addi %59, %54 : i64
  %30 = scalar.assume %53 [range(%53, 0, 9223372036854775807)] : i64
  %31 = index.cast %30 : i64 to offset
  %32 = index.assume %31 [range(%31, 0, 252)] : offset
  %33 = buffer.view %words[%32] : buffer -> view<1xi32>
  view.store %index, %33[0] : i32, view<1xi32>
  %34 = scalar.constant 32 : i32
  %35 = scalar.addi %index, %34 : i32
  %36 = scalar.extui %35 : i32 to i64
  %37 = scalar.assume %36 [range(%36, 0, 63)] : i64
  %38 = index.cast %37 : i64 to index
  %39 = view.load %words_view[%38] : view<64xi32> -> i32
  %45 = scalar.assume %59 [range(%59, 0, 9223372036854775807)] : i64
  %46 = index.cast %45 : i64 to offset
  %47 = buffer.view %output[%46] : buffer -> view<1xi32>
  view.store %39, %47[0] : i32, view<1xi32>
  kernel.return
}

config.decl @shared_rows.workgroup_count.x : index

config.decl @shared_rows.workgroup_count.y : index

config.decl @shared_rows.workgroup_count.z : index

// ====
// Workgroup record arrays retain one aggregate allocation while each field is
// projected with its C++ byte offset and scalar type.
#include <loomcxx/kernel.h>
struct SharedRecord {
  // Leading byte payload exercises record padding before the next field.
  unsigned char tag;
  // Naturally aligned scalar payload.
  unsigned sequence;
  // Nested array payload addressed within each record element.
  float values[2];
};
[[loom::kernel, loom::workgroup_size(4, 1, 1)]]
void shared_records(unsigned* output, float* values) {
  [[loom::workgroup]] SharedRecord records[4];
  unsigned index = loom::workitem_id.x;
  records[index].tag = 3;
  records[index].sequence = index + 7;
  records[index].values[1] = 2.0f;
  output[index] = records[index].sequence + records[index].tag;
  values[index] = records[index].values[1];
}

// ----
