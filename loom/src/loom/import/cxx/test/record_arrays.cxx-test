// RUN: pass canonicalize,cse,dce
// Arrays decay to borrowed pointers. The two fields retain separate origins.
struct Block {
  unsigned tag;
  unsigned char scales[4];
  unsigned char quants[128];
};
static unsigned read(const unsigned char* values, unsigned index) {
  return values[index];
}
unsigned decode(const Block* blocks, unsigned block, unsigned index) {
  return read(blocks[block].scales, index / 32) + blocks[block].quants[index];
}

// ----
func.def public @decode(%blocks: buffer, %blocks_byte_offset: offset, %block: i32, %index: i32) -> (i32) {
  %5 = scalar.extui %block : i32 to i64
  %6 = scalar.constant 136 : i64
  %7 = scalar.muli %5, %6 : i64
  %8 = index.cast %blocks_byte_offset : offset to i64
  %9 = scalar.addi %8, %7 : i64
  %10 = scalar.assume %9 [range(%9, 0, 9223372036854775807)] : i64
  %11 = index.cast %10 : i64 to offset
  %12 = index.constant 4 : offset
  %scales_byte_offset = index.add %11, %12 : offset
  %51 = scalar.constant 5 : i32
  %52 = scalar.shrui %index, %51 : i32
  %16 = func.call @read(%blocks, %scales_byte_offset, %52) : (buffer, offset, i32) -> (i32)
  %24 = index.constant 8 : offset
  %quants_byte_offset = index.add %11, %24 : offset
  %26 = scalar.extui %index : i32 to i64
  %29 = index.cast %quants_byte_offset : offset to i64
  %30 = scalar.addi %29, %26 : i64
  %31 = scalar.assume %30 [range(%30, 0, 9223372036854775807)] : i64
  %32 = index.cast %31 : i64 to offset
  %33 = buffer.view %blocks[%32] : buffer -> view<1xi8>
  %34 = view.load %33[0] : view<1xi8> -> i8
  %35 = scalar.extui %34 : i8 to i32
  %36 = scalar.addi %16, %35 : i32
  func.return %36 : i32
}

func.def @read(%values: buffer, %values_byte_offset: offset, %index: i32) -> (i32) {
  %41 = scalar.extui %index : i32 to i64
  %44 = index.cast %values_byte_offset : offset to i64
  %45 = scalar.addi %44, %41 : i64
  %46 = scalar.assume %45 [range(%45, 0, 9223372036854775807)] : i64
  %47 = index.cast %46 : i64 to offset
  %48 = buffer.view %values[%47] : buffer -> view<1xi8>
  %49 = view.load %48[0] : view<1xi8> -> i8
  %50 = scalar.extui %49 : i8 to i32
  func.return %50 : i32
}

// ====
// Each subscript consumes one array extent, including pointer-to-array steps.
struct Matrix { unsigned tag; short values[3][5]; };
short* row(Matrix* matrices, unsigned matrix, unsigned index) {
  return *(matrices[matrix].values + index);
}
short element(Matrix* matrices, unsigned matrix, unsigned index) {
  auto* rows = &matrices[matrix].values;
  return (*rows)[index][4];
}
void update(short (*rows)[5], unsigned row, unsigned column, short value) {
  rows[row][column] = value;
}

// ----
func.def public @row(%matrices: buffer, %matrices_byte_offset: offset, %matrix: i32, %index: i32) -> (buffer, offset) {
  %6 = scalar.extui %matrix : i32 to i64
  %7 = scalar.constant 36 : i64
  %8 = scalar.muli %6, %7 : i64
  %9 = index.cast %matrices_byte_offset : offset to i64
  %10 = scalar.addi %9, %8 : i64
  %11 = scalar.assume %10 [range(%10, 0, 9223372036854775807)] : i64
  %12 = index.cast %11 : i64 to offset
  %13 = index.constant 4 : offset
  %values_byte_offset = index.add %12, %13 : offset
  %15 = scalar.extui %index : i32 to i64
  %16 = scalar.constant 10 : i64
  %17 = scalar.muli %15, %16 : i64
  %18 = index.cast %values_byte_offset : offset to i64
  %19 = scalar.addi %18, %17 : i64
  %20 = scalar.assume %19 [range(%19, 0, 9223372036854775807)] : i64
  %21 = index.cast %20 : i64 to offset
  func.return %matrices, %21 : buffer, offset
}

func.def public @element(%matrices: buffer, %matrices_byte_offset: offset, %matrix: i32, %index: i32) -> (i16) {
  %27 = scalar.extui %matrix : i32 to i64
  %28 = scalar.constant 36 : i64
  %29 = scalar.muli %27, %28 : i64
  %30 = index.cast %matrices_byte_offset : offset to i64
  %31 = scalar.addi %30, %29 : i64
  %32 = scalar.assume %31 [range(%31, 0, 9223372036854775807)] : i64
  %33 = index.cast %32 : i64 to offset
  %34 = index.constant 4 : offset
  %rows_byte_offset = index.add %33, %34 : offset
  %36 = scalar.extui %index : i32 to i64
  %37 = scalar.constant 10 : i64
  %38 = scalar.muli %36, %37 : i64
  %39 = index.cast %rows_byte_offset : offset to i64
  %40 = scalar.addi %39, %38 : i64
  %41 = scalar.assume %40 [range(%40, 0, 9223372036854775807)] : i64
  %42 = index.cast %41 : i64 to offset
  %73 = scalar.constant 8 : i64
  %47 = index.cast %42 : offset to i64
  %48 = scalar.addi %47, %73 : i64
  %49 = scalar.assume %48 [range(%48, 0, 9223372036854775807)] : i64
  %50 = index.cast %49 : i64 to offset
  %51 = buffer.view %matrices[%50] : buffer -> view<1xi16>
  %52 = view.load %51[0] : view<1xi16> -> i16
  func.return %52 : i16
}

func.def public @update(%rows: buffer, %rows_byte_offset: offset, %row: i32, %column: i32, %value: i16) {
  %58 = scalar.extui %row : i32 to i64
  %59 = scalar.constant 10 : i64
  %60 = scalar.muli %58, %59 : i64
  %61 = index.cast %rows_byte_offset : offset to i64
  %62 = scalar.addi %61, %60 : i64
  %63 = scalar.assume %62 [range(%62, 0, 9223372036854775807)] : i64
  %64 = index.cast %63 : i64 to offset
  %65 = scalar.extui %column : i32 to i64
  %74 = scalar.constant 1 : i64
  %75 = scalar.shli %65, %74 : i64
  %68 = index.cast %64 : offset to i64
  %69 = scalar.addi %68, %75 : i64
  %70 = scalar.assume %69 [range(%69, 0, 9223372036854775807)] : i64
  %71 = index.cast %70 : i64 to offset
  %72 = buffer.view %rows[%71] : buffer -> view<1xi16>
  view.store %value, %72[0] : i16, view<1xi16>
  func.return
