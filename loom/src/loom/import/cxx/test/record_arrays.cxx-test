  %workgroup_count_x = config.get @shared_records.workgroup_count.x : index
  %workgroup_count_y = config.get @shared_records.workgroup_count.y : index
  %workgroup_count_z = config.get @shared_records.workgroup_count.z : index
  %8 = index.constant 4 : index
  %9 = index.constant 1 : index
  kernel.launch.config workgroups(%workgroup_count_x, %workgroup_count_y, %workgroup_count_z) workgroup_size(%8, %9, %9) : index
} launch(%output: buffer, %values: buffer) {
  %13 = index.constant 64 : offset
  %records = buffer.alloca<workgroup> align(4) %13 : buffer
  %workitem_id_x = kernel.workitem.id<x> : index
  %index = index.cast %workitem_id_x : index to i32
  %169 = scalar.constant 3 : i8
  %166 = scalar.constant 4 : i32
  %167 = scalar.shli %index, %166 : i32
  %168 = scalar.extui %167 : i32 to i64
  %26 = scalar.assume %168 [range(%168, 0, 9223372036854775807)] : i64
  %27 = index.cast %26 : i64 to offset
  %30 = index.assume %27 [range(%27, 0, 63)] : offset
  %31 = buffer.view %records[%30] : buffer -> view<1xi8>
  view.store %169, %31[0] : i8, view<1xi8>
  %32 = scalar.constant 7 : i32
  %33 = scalar.addi %index, %32 : i32
  %41 = index.constant 4 : offset
  %42 = index.add %27, %41 : offset
  %43 = index.assume %42 [range(%42, 0, 60)] : offset
  %44 = buffer.view %records[%43] : buffer -> view<1xi32>
  view.store %33, %44[0] : i32, view<1xi32>
  %45 = scalar.constant 2.0 : f32
  %53 = index.constant 8 : offset
  %values_byte_offset = index.add %27, %53 : offset
  %153 = scalar.constant 4 : i64
  %59 = index.cast %values_byte_offset : offset to i64
  %60 = scalar.addi %59, %153 : i64
  %61 = scalar.assume %60 [range(%60, 0, 9223372036854775807)] : i64
  %62 = index.cast %61 : i64 to offset
  %63 = index.assume %62 [range(%62, 0, 60)] : offset
  %64 = buffer.view %records[%63] : buffer -> view<1xf32>
  view.store %45, %64[0] : f32, view<1xf32>
  %sequence = view.load %44[0] : view<1xi32> -> i32
  %tag = view.load %31[0] : view<1xi8> -> i8
  %89 = scalar.extui %tag : i8 to i32
  %90 = scalar.addi %sequence, %89 : i32
  %140 = scalar.constant 2 : i32
  %141 = scalar.shli %index, %140 : i32
  %142 = scalar.extui %141 : i32 to i64
  %96 = scalar.assume %142 [range(%142, 0, 9223372036854775807)] : i64
  %97 = index.cast %96 : i64 to offset
  %98 = buffer.view %output[%97] : buffer -> view<1xi32>
  view.store %90, %98[0] : i32, view<1xi32>
  %118 = view.load %64[0] : view<1xf32> -> f32
  %126 = buffer.view %values[%97] : buffer -> view<1xf32>
  view.store %118, %126[0] : f32, view<1xf32>
  kernel.return
}

config.decl @shared_records.workgroup_count.x : index

config.decl @shared_records.workgroup_count.y : index

