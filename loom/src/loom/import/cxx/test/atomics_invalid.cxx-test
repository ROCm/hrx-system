// RUN: verify
#include <loomcxx/atomic.h>
using namespace loom::atomic;
unsigned entry(unsigned* pointer) {
  // ERROR@+1: LOWERING/059 "atomic binding requires an integer kind"
  return loom::view::atomic::rmw<kind(255), ordering::relaxed, scope::device>(1u, pointer);
}

// ====
#include <loomcxx/atomic.h>
using namespace loom::atomic;
unsigned entry(unsigned* pointer) {
  // ERROR@+1: LOWERING/059 "atomic selectors require constant enum values"
  return loom::view::atomic::rmw<kind::addi, ordering(-1), scope::device>(1u, pointer);
}

// ====
#include <loomcxx/atomic.h>
using namespace loom::atomic;
unsigned entry(unsigned* pointer) {
  // ERROR@+1: LOWERING/059 "unknown atomic ordering"
  return loom::view::atomic::rmw<kind::addi, ordering(5), scope::device>(1u, pointer);
}

// ====
#include <loomcxx/atomic.h>
using namespace loom::atomic;
unsigned entry(unsigned* pointer) {
  // ERROR@+1: LOWERING/059 "unknown atomic scope"
  return loom::view::atomic::rmw<kind::addi, ordering::relaxed, scope(5)>(1u, pointer);
}

// ====
#include <loomcxx/atomic.h>
using namespace loom::atomic;
int entry(int* pointer) {
  // ERROR@+1: LOWERING/059 "relaxed, acquire, or seq_cst failure ordering"
  return loom::view::atomic::cmpxchg<ordering::acq_rel, ordering::release, scope::device>(1, 2, pointer);
}

// ====
#include <loomcxx/atomic.h>
using namespace loom::atomic;
int entry(int* pointer) {
  // ERROR@+1: LOWERING/059 "failure ordering no stronger than success ordering"
  return loom::view::atomic::cmpxchg<ordering::relaxed, ordering::acquire, scope::device>(1, 2, pointer);
}

// ====
#include <loomcxx/atomic.h>
using namespace loom::atomic;
bool entry(bool* pointer) {
  // ERROR@+1: LOWERING/059 "atomic destination requires a non-boolean integer"
  return loom::view::atomic::rmw<kind::andi, ordering::relaxed, scope::device>(true, pointer);
}

// ====
#include <loomcxx/atomic.h>
using namespace loom::atomic;
float entry(float* pointer) {
  // ERROR@+1: LOWERING/059 "atomic destination requires a non-boolean integer"
  return loom::view::atomic::rmw<kind::addi, ordering::relaxed, scope::device>(1.0f, pointer);
}

// ====
#include <loomcxx/atomic.h>
using namespace loom::atomic;
enum class Flag : unsigned { set = 1 };
Flag entry(Flag* pointer) {
  // ERROR@+1: LOWERING/059 "atomic destination requires a non-boolean integer"
  return loom::view::atomic::rmw<kind::ori, ordering::relaxed, scope::device>(Flag::set, pointer);
}

// ====
#include <loomcxx/atomic.h>
using namespace loom::atomic;
unsigned entry(unsigned* pointer) {
  // ERROR@+1: LOWERING/059 "atomic minimum/maximum signedness must match the destination element type"
  return loom::view::atomic::rmw<kind::minsi, ordering::relaxed, scope::device>(1u, pointer);
}

// ====
#include <loomcxx/atomic.h>
using namespace loom::atomic;
int entry(int* pointer) {
  // ERROR@+1: LOWERING/059 "atomic binding requires an integer kind"
  return loom::view::atomic::rmw<kind::addf, ordering::relaxed, scope::device>(1, pointer);
}

// ====
// Custom operation declarations use the same admission boundary as the facade.
template <int Kind, int Ordering, int Scope>
[[loom::op("view.atomic.rmw")]] int custom(int, const int*);
int entry(const int* pointer) {
  // ERROR@+1: LOWERING/059 "atomic destination requires a mutable pointer"
  return custom<2, 0, 3>(1, pointer);
}

// ====
template <int Kind, int Ordering, int Scope>
[[loom::op("view.atomic.rmw")]] int custom(unsigned, int*);
int entry(int* pointer) {
  // ERROR@+1: LOWERING/059 "atomic operands must match the destination element type"
  return custom<2, 0, 3>(1u, pointer);
}

// ====
template <int Kind, int Ordering, int Scope>
[[loom::op("view.atomic.reduce")]] int custom(int, int*);
int entry(int* pointer) {
  // ERROR@+1: LOWERING/059 "atomic result must be the destination element type, or void for store/reduction"
  return custom<2, 0, 3>(1, pointer);
}

// ====
template <int Kind, int Ordering, int Scope>
[[loom::op("view.atomic.rmw")]] int custom(int*);
int entry(int* pointer) {
  // ERROR@+1: LOWERING/059 "atomic declaration has the wrong operand count"
  return custom<2, 0, 3>(pointer);
}

// ====
// ERROR@+1: LOWERING/059 "atomic binding requires three leading constant template arguments"
[[loom::op("view.atomic.rmw")]] int custom(int, int*);

// ====
// Numeric selectors cannot silently truncate a floating template argument.
template <auto Kind, auto Ordering, auto Scope>
[[loom::op("view.atomic.rmw")]] int custom(int, int*);
int entry(int* pointer) {
  // ERROR@+1: LOWERING/059 "atomic selectors require constant enum values"
  return custom<2.5, 0, 3>(1, pointer);
}

// ====
#include <loomcxx/atomic.h>
using namespace loom::atomic;
unsigned entry(const unsigned* source) {
  // ERROR@+1: LOWERING/059 "ordering is not permitted for this operation"
  return loom::view::atomic::load<ordering::release, scope::system>(source);
}

// ====
#include <loomcxx/atomic.h>
using namespace loom::atomic;
void entry(unsigned* destination) {
  // ERROR@+1: LOWERING/059 "ordering is not permitted for this operation"
  loom::view::atomic::store<ordering::acquire, scope::system>(1u, destination);
}

// ====
#include <loomcxx/atomic.h>
using namespace loom::atomic;
void entry() {
  // ERROR@+1: LOWERING/059 "ordering is not permitted for this operation"
  loom::buffer::fence<ordering::relaxed, scope::system>();
}

// ====
template <int Ordering, int Scope>
[[loom::op("view.atomic.store")]] void custom(unsigned, const unsigned*);
void entry(const unsigned* pointer) {
  // ERROR@+1: LOWERING/059 "atomic destination requires a mutable pointer"
  custom<2, 4>(1u, pointer);
}

// ====
template <int Ordering, int Scope>
[[loom::op("buffer.fence")]] int custom();
int entry() {
  // ERROR@+1: LOWERING/059 "buffer.fence requires void()"
  return custom<1, 4>();
}

// ====
unsigned entry(const unsigned* source, int ordering) {
  // ERROR@+1: LOWERING/059 "atomic ordering requires a pure integer constant"
  return __atomic_load_n(source, ordering);
}

// ====
void entry(unsigned* destination) {
  // ERROR@+1: LOWERING/059 "unsupported atomic ordering or target modifier"
  __atomic_store_n(destination, 1u, __ATOMIC_RELEASE | 65536);
}

// ====
unsigned entry(const unsigned* source) {
  // ERROR@+1: LOWERING/059 "ordering is not permitted for this operation"
  return __atomic_load_n(source, __ATOMIC_RELEASE);
}

// ====
void entry(const unsigned* destination) {
  // ERROR@+1: LOWERING/059 "atomic destination requires a mutable pointer"
  __atomic_store_n(destination, 1u, __ATOMIC_RELAXED);
}

// ====
bool entry(unsigned* destination, unsigned* expected) {
  // ERROR@+1: LOWERING/059 "relaxed, acquire, or seq_cst failure ordering"
  return __atomic_compare_exchange_n(destination, expected, 1u, false,
                                    __ATOMIC_ACQ_REL, __ATOMIC_RELEASE);
}

// ====
unsigned entry(const unsigned* destination) {
  // ERROR@+1: LOWERING/059 "atomic destination requires a mutable pointer"
  return __atomic_fetch_add(destination, 1u, __ATOMIC_RELAXED);
}
