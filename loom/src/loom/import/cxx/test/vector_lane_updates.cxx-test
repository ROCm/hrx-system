  %index = scalar.constant 0 : i32
  %4 = index.cast %index : i32 to offset
  %5 = index.cast %count : i32 to offset
  %6 = index.constant 1 : offset
  %values$9 = scf.for %index = [%4 to %5 step %6](%values$8 = %values$0 : vector<4xi32>) -> (vector<4xi32>) {
    %10 = index.cast %index : offset to i32
    %11 = scalar.constant 1 : i32
    %12 = scalar.addi %10, %11 : i32
    %13 = index.cast %10 : i32 to index
    %values$14 = vector.insert %12 into %values$8[%13] : i32, vector<4xi32>
    scf.yield %values$14 : vector<4xi32>
  }
  func.return %values$9 : vector<4xi32>
}

// ====
// Plain, compound, and pre/post lane updates replace nested value projections.
using Lanes = unsigned __attribute__((ext_vector_type(4)));
struct Packet {
  unsigned prefix;
  Lanes lanes;
};
Packet update(Packet packet, unsigned index, unsigned replacement) {
  packet.lanes[index++] = replacement;
  packet.lanes[index] += packet.prefix;
  unsigned previous = packet.lanes[index]++;
  packet.prefix += previous + ++packet.lanes[index];
  packet.lanes[index]--;
  --packet.lanes[index];
  return packet;
}

