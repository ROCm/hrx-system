// RUN: roundtrip
// Dynamic lane writes keep the vector in SSA through structured loops.
using Lanes = unsigned __attribute__((vector_size(16)));
Lanes fill(Lanes values, unsigned count) {
  for (unsigned index = 0; index < count; ++index) {
    values[index] = index + 1;
  }
  return values;
}

