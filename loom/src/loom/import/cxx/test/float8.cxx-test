// RUN: roundtrip
#include <loomcxx/numeric.h>
#include <loomcxx/scalar.h>
#include <stdfloat>

using loom::type::float8_e4m3fn_t;
using loom::type::float8_e5m2_t;
using Float8x4 = float8_e4m3fn_t __attribute__((ext_vector_type(4)));

static_assert(sizeof(float8_e4m3fn_t) == 1);
static_assert(alignof(float8_e4m3fn_t) == 1);
static_assert(sizeof(float8_e5m2_t) == 1);
static_assert(alignof(float8_e5m2_t) == 1);
static_assert(sizeof(Float8x4) == 4);
static_assert(alignof(Float8x4) == 4);
static_assert(__is_floating_point(float8_e4m3fn_t));
static_assert(__is_arithmetic(float8_e5m2_t));
static_assert(!__is_same(float8_e4m3fn_t, float8_e5m2_t));
static_assert(__is_same(decltype(float8_e4m3fn_t(1.0) + 2), float8_e4m3fn_t));
static_assert(__is_same(decltype(float8_e5m2_t(1.0) + 2.0f), float));
static_assert(__is_same(decltype(float8_e4m3fn_t(1.0) + 2.0f16), std::float16_t));
static_assert(__is_same(decltype(float8_e5m2_t(1.0) + 2.0bf16), std::bfloat16_t));
constexpr float8_e4m3fn_t rounded = 1.1875;
static_assert(rounded == 1.25);
static_assert(float8_e4m3fn_t(1000.0) == 448.0);

float8_e4m3fn_t scale(float8_e4m3fn_t value) {
  float8_e4m3fn_t factor = 2.0f;
  return value * factor;
}
float8_e4m3fn_t constant() { return rounded; }
float extend(float8_e4m3fn_t value) { return value; }
std::bfloat16_t to_bfloat(float8_e5m2_t value) { return value; }
float8_e4m3fn_t truncate(float value) { return value; }
float8_e5m2_t to_e5m2(float8_e4m3fn_t value) { return (float8_e5m2_t)value; }
float8_e4m3fn_t to_e4m3fn(float8_e5m2_t value) { return (float8_e4m3fn_t)value; }
float8_e5m2_t absolute(float8_e5m2_t value) { return loom::scalar::absf(value); }
Float8x4 pack(float8_e4m3fn_t first, float8_e4m3fn_t second) {
  return Float8x4{first, second, rounded, float8_e4m3fn_t(-2.0)};
}
float8_e4m3fn_t lane(Float8x4 values, unsigned index) { return values[index]; }
void copy(const Float8x4* input, Float8x4* output, unsigned index) {
  output[index + 1] = input[index];
}
// ----
func.def public @scale(%value: f8E4M3) -> (f8E4M3) {
  %2 = scalar.constant 2.0 : f32
  %factor = scalar.fptrunc %2 : f32 to f8E4M3
  %4 = scalar.mulf %value, %factor : f8E4M3
  func.return %4 : f8E4M3
}

func.def public @constant() -> (f8E4M3) {
  %rounded = scalar.constant 1.25 : f8E4M3
  func.return %rounded : f8E4M3
}

func.def public @extend(%value: f8E4M3) -> (f32) {
  %9 = scalar.extf %value : f8E4M3 to f32
  func.return %9 : f32
}

func.def public @to_bfloat(%value: f8E5M2) -> (bf16) {
  %12 = scalar.extf %value : f8E5M2 to bf16
  func.return %12 : bf16
}

func.def public @truncate(%value: f32) -> (f8E4M3) {
  %15 = scalar.fptrunc %value : f32 to f8E4M3
  func.return %15 : f8E4M3
}

func.def public @to_e5m2(%value: f8E4M3) -> (f8E5M2) {
  %18 = scalar.extf %value : f8E4M3 to f32
  %19 = scalar.fptrunc %18 : f32 to f8E5M2
  func.return %19 : f8E5M2
}

func.def public @to_e4m3fn(%value: f8E5M2) -> (f8E4M3) {
  %22 = scalar.extf %value : f8E5M2 to f32
  %23 = scalar.fptrunc %22 : f32 to f8E4M3
  func.return %23 : f8E4M3
}

func.def public @absolute(%value: f8E5M2) -> (f8E5M2) {
  %26 = scalar.absf %value : f8E5M2
  func.return %26 : f8E5M2
}

func.def public @pack(%first: f8E4M3, %second: f8E4M3) -> (vector<4xf8E4M3>) {
  %rounded = scalar.constant 1.25 : f8E4M3
  %31 = scalar.constant 2.0 : f64
  %32 = scalar.negf %31 : f64
  %33 = scalar.fptrunc %32 : f64 to f8E4M3
  %34 = vector.from_elements %first, %second, %rounded, %33 : vector<4xf8E4M3>
  func.return %34 : vector<4xf8E4M3>
}

func.def public @lane(%values: vector<4xf8E4M3>, %index: i32) -> (f8E4M3) {
  %38 = index.cast %index : i32 to index
  %39 = vector.extract %values[%38] : vector<4xf8E4M3> -> f8E4M3
  func.return %39 : f8E4M3
}

func.def public @copy(%input: buffer, %input_byte_offset: offset, %output: buffer, %output_byte_offset: offset, %index: i32) {
  %45 = scalar.extui %index : i32 to i64
  %46 = scalar.constant 4 : i64
  %47 = scalar.muli %45, %46 : i64
  %48 = index.cast %input_byte_offset : offset to i64
  %49 = scalar.addi %48, %47 : i64
  %50 = scalar.assume %49 [range(%49, 0, 9223372036854775807)] : i64
  %51 = index.cast %50 : i64 to offset
  %52 = buffer.view %input[%51] : buffer -> view<4xf8E4M3>
  %53 = vector.load %52[0] : view<4xf8E4M3> -> vector<4xf8E4M3>
  %54 = scalar.constant 1 : i32
  %55 = scalar.addi %index, %54 : i32
  %56 = scalar.extui %55 : i32 to i64
  %57 = scalar.constant 4 : i64
  %58 = scalar.muli %56, %57 : i64
  %59 = index.cast %output_byte_offset : offset to i64
  %60 = scalar.addi %59, %58 : i64
  %61 = scalar.assume %60 [range(%60, 0, 9223372036854775807)] : i64
  %62 = index.cast %61 : i64 to offset
  %63 = buffer.view %output[%62] : buffer -> view<4xf8E4M3>
  vector.store %53, %63[0] : vector<4xf8E4M3>, view<4xf8E4M3>
  func.return
}

// ====
// INPUT: cxx std=c23
__float8_e5m2 encode(float value) { return value; }
float decode(__float8_e5m2 value) { return value; }
// ----
func.def public @encode(%value: f32) -> (f8E5M2) {
  %2 = scalar.fptrunc %value : f32 to f8E5M2
  func.return %2 : f8E5M2
}

func.def public @decode(%value: f8E5M2) -> (f32) {
  %5 = scalar.extf %value : f8E5M2 to f32
  func.return %5 : f32
}

// ====
#include <loomcxx/numeric.h>
#include <loomcxx/view.h>
using loom::type::float8_e4m3fn_t;

float element(const float8_e4m3fn_t* input, unsigned row, unsigned column) {
  auto source = loom::buffer::view<4, 8>(
      input, {}, loom::encoding::layout::dense<2>());
  return loom::view::load(source, row, column);
}
// ----
func.def public @element(%input: buffer, %input_byte_offset: offset, %row: i32, %column: i32) -> (f32) {
  %source_layout = encoding.layout.dense : encoding<layout>
  %source = buffer.view %input[%input_byte_offset] : buffer -> view<4x8xf8E4M3, %source_layout>
  %7 = scalar.extui %row : i32 to i64
  %8 = index.cast %7 : i64 to index
  %9 = scalar.extui %column : i32 to i64
  %10 = index.cast %9 : i64 to index
  %11 = view.load %source[%8, %10] : view<4x8xf8E4M3, %source_layout> -> f8E4M3
  %12 = scalar.extf %11 : f8E4M3 to f32
  func.return %12 : f32
}
