// RUN: roundtrip
// Workload values and target properties compute a kernel launch configuration.
#include <loomcxx/kernel.h>
#include <loomcxx/target.h>

static loom::kernel::configuration configure(unsigned item_count,
                                             unsigned row_count) {
  unsigned width = loom::target::subgroup::size();
  unsigned group_count = (item_count + width - 1) / width;
  return {{group_count, row_count, 1}, {width, 1, 1}};
}

[[loom::kernel(configure)]] void transform(float* output) {
  output[loom::kernel::workitem::id.x] = 1.0f;
}

// ----
kernel.def @transform(%item_count: i32, %row_count: i32) {
  %3 = target.subgroup.size : index
  %width = index.cast %3 : index to i32
  %5 = scalar.addi %item_count, %width : i32
  %6 = scalar.constant 1 : i32
  %7 = scalar.subi %5, %6 : i32
  %group_count = scalar.divui %7, %width : i32
  %9 = scalar.constant 1 : i32
  %10 = scalar.constant 1 : i32
  %11 = scalar.constant 1 : i32
  %12 = scalar.extui %group_count : i32 to i64
  %13 = index.cast %12 : i64 to index
  %14 = scalar.extui %row_count : i32 to i64
  %15 = index.cast %14 : i64 to index
  %16 = scalar.extui %9 : i32 to i64
  %17 = index.cast %16 : i64 to index
  %18 = scalar.extui %width : i32 to i64
  %19 = index.cast %18 : i64 to index
  %20 = scalar.extui %10 : i32 to i64
  %21 = index.cast %20 : i64 to index
  %22 = scalar.extui %11 : i32 to i64
  %23 = index.cast %22 : i64 to index
  kernel.launch.config workgroups(%13, %15, %17) workgroup_size(%19, %21, %23) : index
} launch(%output: buffer) {
  %output_byte_offset = index.constant 0 : offset
  %25 = scalar.constant 1.0 : f32
  %workitem_id_x = kernel.workitem.id<x> : index
  %27 = index.cast %workitem_id_x : index to i32
  %28 = scalar.extui %27 : i32 to i64
  %29 = scalar.constant 4 : i64
  %30 = scalar.muli %28, %29 : i64
  %31 = index.cast %output_byte_offset : offset to i64
  %32 = scalar.addi %31, %30 : i64
  %33 = scalar.assume %32 [range(%32, 0, 9223372036854775807)] : i64
  %34 = index.cast %33 : i64 to offset
  %35 = buffer.view %output[%34] : buffer -> view<1xf32>
  view.store %25, %35[0] : f32, view<1xf32>
  kernel.return
}

// ====
// A configuration function may be shared and merged across redeclarations.
#include <loomcxx/check.h>
#include <loomcxx/kernel.h>

static loom::kernel::configuration fixed_configuration() {
  return {{2, 3, 4}, {64, 2, 1}};
}

[[loom::kernel(fixed_configuration)]] void first();
void first() {}

[[loom::kernel(fixed_configuration)]] void second();
[[loom::kernel(fixed_configuration)]] void second() {}

LOOM_CHECK_CASE(fixed_configuration_case) {
  loom::check::launch<first>();
  loom::check::launch<second>();
}

// ----
kernel.def @first() {
  %0 = scalar.constant 2 : i32
  %1 = scalar.constant 3 : i32
  %2 = scalar.constant 4 : i32
  %3 = scalar.constant 64 : i32
  %4 = scalar.constant 2 : i32
  %5 = scalar.constant 1 : i32
  %6 = scalar.extui %0 : i32 to i64
  %7 = index.cast %6 : i64 to index
  %8 = scalar.extui %1 : i32 to i64
  %9 = index.cast %8 : i64 to index
  %10 = scalar.extui %2 : i32 to i64
  %11 = index.cast %10 : i64 to index
  %12 = scalar.extui %3 : i32 to i64
  %13 = index.cast %12 : i64 to index
  %14 = scalar.extui %4 : i32 to i64
  %15 = index.cast %14 : i64 to index
  %16 = scalar.extui %5 : i32 to i64
  %17 = index.cast %16 : i64 to index
  kernel.launch.config workgroups(%7, %9, %11) workgroup_size(%13, %15, %17) : index
} launch() {
  kernel.return
}

kernel.def @second() {
  %18 = scalar.constant 2 : i32
  %19 = scalar.constant 3 : i32
  %20 = scalar.constant 4 : i32
  %21 = scalar.constant 64 : i32
  %22 = scalar.constant 2 : i32
  %23 = scalar.constant 1 : i32
  %24 = scalar.extui %18 : i32 to i64
  %25 = index.cast %24 : i64 to index
  %26 = scalar.extui %19 : i32 to i64
  %27 = index.cast %26 : i64 to index
  %28 = scalar.extui %20 : i32 to i64
  %29 = index.cast %28 : i64 to index
  %30 = scalar.extui %21 : i32 to i64
  %31 = index.cast %30 : i64 to index
  %32 = scalar.extui %22 : i32 to i64
  %33 = index.cast %32 : i64 to index
  %34 = scalar.extui %23 : i32 to i64
  %35 = index.cast %34 : i64 to index
  kernel.launch.config workgroups(%25, %27, %29) workgroup_size(%31, %33, %35) : index
} launch() {
  kernel.return
}

check.case public @fixed_configuration_case {
  kernel.launch @first() : ()
  kernel.launch @second() : ()
  check.return
}

// ====
// Cluster dimensions retain the complete source-computed launch geometry.
#include <loomcxx/kernel.h>
#include <loomcxx/target.h>

static loom::kernel::clustered_configuration configure_clustered(
    unsigned cluster_count, unsigned cluster_size) {
  unsigned width = loom::target::subgroup::size();
  return {{cluster_count * cluster_size, 1, 1},
          {width, 1, 1},
          {cluster_size, 1, 1}};
}

[[loom::kernel(configure_clustered)]] void clustered() {}

// ----
kernel.def @clustered(%cluster_count: i32, %cluster_size: i32) {
  %2 = target.subgroup.size : index
  %width = index.cast %2 : index to i32
  %4 = scalar.muli %cluster_count, %cluster_size : i32
  %5 = scalar.constant 1 : i32
  %6 = scalar.constant 1 : i32
  %7 = scalar.constant 1 : i32
  %8 = scalar.constant 1 : i32
  %9 = scalar.constant 1 : i32
  %10 = scalar.constant 1 : i32
  %11 = scalar.extui %4 : i32 to i64
  %12 = index.cast %11 : i64 to index
  %13 = scalar.extui %5 : i32 to i64
  %14 = index.cast %13 : i64 to index
  %15 = scalar.extui %6 : i32 to i64
  %16 = index.cast %15 : i64 to index
  %17 = scalar.extui %width : i32 to i64
  %18 = index.cast %17 : i64 to index
  %19 = scalar.extui %7 : i32 to i64
  %20 = index.cast %19 : i64 to index
  %21 = scalar.extui %8 : i32 to i64
  %22 = index.cast %21 : i64 to index
  %23 = scalar.extui %cluster_size : i32 to i64
  %24 = index.cast %23 : i64 to index
  %25 = scalar.extui %9 : i32 to i64
  %26 = index.cast %25 : i64 to index
  %27 = scalar.extui %10 : i32 to i64
  %28 = index.cast %27 : i64 to index
  kernel.launch.config workgroups(%12, %14, %16) workgroup_size(%18, %20, %22) cluster_size(%24, %26, %28) : index
} launch() {
  kernel.return
}

// ====
// Internal linkage includes unnamed namespaces, and workloads retain widths.
#include <loomcxx/kernel.h>

namespace {
loom::kernel::configuration configure_typed(short row_count,
                                            unsigned long long item_count) {
  return {
      {static_cast<unsigned>(item_count), static_cast<unsigned>(row_count), 1},
      {1, 1, 1}};
}
}  // namespace

[[loom::kernel(configure_typed)]] void typed_workload() {}

// ----
kernel.def @typed_workload(%row_count: i16, %item_count: i64) {
  %2 = scalar.trunci %item_count : i64 to i32
  %3 = scalar.extsi %row_count : i16 to i32
  %4 = scalar.constant 1 : i32
  %5 = scalar.constant 1 : i32
  %6 = scalar.constant 1 : i32
  %7 = scalar.constant 1 : i32
  %8 = scalar.extui %2 : i32 to i64
  %9 = index.cast %8 : i64 to index
  %10 = scalar.extui %3 : i32 to i64
  %11 = index.cast %10 : i64 to index
  %12 = scalar.extui %4 : i32 to i64
  %13 = index.cast %12 : i64 to index
  %14 = scalar.extui %5 : i32 to i64
  %15 = index.cast %14 : i64 to index
  %16 = scalar.extui %6 : i32 to i64
  %17 = index.cast %16 : i64 to index
  %18 = scalar.extui %7 : i32 to i64
  %19 = index.cast %18 : i64 to index
  kernel.launch.config workgroups(%9, %11, %13) workgroup_size(%15, %17, %19) : index
} launch() {
  kernel.return
}

// ====
// Check launches keep configuration workloads separate from device arguments.
#include <loomcxx/check.h>
#include <loomcxx/kernel.h>
#include <loomcxx/target.h>

static loom::kernel::configuration configure_copy(unsigned item_count) {
  unsigned width = loom::target::subgroup::size();
  return {{(item_count + width - 1) / width, 1, 1}, {width, 1, 1}};
}

[[loom::kernel(configure_copy)]] void configured_copy(unsigned item_count,
                                                      const float* input,
                                                      float* output) {
  unsigned item =
      loom::kernel::workgroup::id.x * loom::kernel::workgroup::size.x +
      loom::kernel::workitem::id.x;
  if (item < item_count) {
    output[item] = input[item];
  }
}

LOOM_CHECK_CASE(configured_copy_case) {
  const auto input = loom::check::iota<67, float>(-1.0f, 0.25f, 8);
  const auto output = loom::check::fill<67, float>(0.0f);
  loom::check::launch<configured_copy>(loom::kernel::workload(67u), 67u, input,
                                       output);
  loom::check::expect_bitwise(output, input);
}

// ----
kernel.def @configured_copy(%item_count: i32) {
  %4 = target.subgroup.size : index
  %width = index.cast %4 : index to i32
  %6 = scalar.addi %item_count, %width : i32
  %7 = scalar.constant 1 : i32
  %8 = scalar.subi %6, %7 : i32
  %9 = scalar.divui %8, %width : i32
  %10 = scalar.constant 1 : i32
  %11 = scalar.constant 1 : i32
  %12 = scalar.constant 1 : i32
  %13 = scalar.constant 1 : i32
  %14 = scalar.extui %9 : i32 to i64
  %15 = index.cast %14 : i64 to index
  %16 = scalar.extui %10 : i32 to i64
  %17 = index.cast %16 : i64 to index
  %18 = scalar.extui %11 : i32 to i64
  %19 = index.cast %18 : i64 to index
  %20 = scalar.extui %width : i32 to i64
  %21 = index.cast %20 : i64 to index
  %22 = scalar.extui %12 : i32 to i64
  %23 = index.cast %22 : i64 to index
  %24 = scalar.extui %13 : i32 to i64
  %25 = index.cast %24 : i64 to index
  kernel.launch.config workgroups(%15, %17, %19) workgroup_size(%21, %23, %25) : index
} launch(%item_count: i32, %input: buffer, %output: buffer) {
  %input_byte_offset = index.constant 0 : offset
  %output_byte_offset = index.constant 0 : offset
  %workgroup_id_x = kernel.workgroup.id<x> : index
  %29 = index.cast %workgroup_id_x : index to i32
  %workgroup_size_x = kernel.workgroup.size<x> : index
  %31 = index.cast %workgroup_size_x : index to i32
  %32 = scalar.muli %29, %31 : i32
  %workitem_id_x = kernel.workitem.id<x> : index
  %34 = index.cast %workitem_id_x : index to i32
  %item = scalar.addi %32, %34 : i32
  %36 = scalar.cmpi ult, %item, %item_count : i32
  scf.if %36 {
    %37 = scalar.extui %item : i32 to i64
    %38 = scalar.constant 4 : i64
    %39 = scalar.muli %37, %38 : i64
    %40 = index.cast %input_byte_offset : offset to i64
    %41 = scalar.addi %40, %39 : i64
    %42 = scalar.assume %41 [range(%41, 0, 9223372036854775807)] : i64
    %43 = index.cast %42 : i64 to offset
    %44 = buffer.view %input[%43] : buffer -> view<1xf32>
    %45 = view.load %44[0] : view<1xf32> -> f32
    %46 = scalar.extui %item : i32 to i64
    %47 = scalar.constant 4 : i64
    %48 = scalar.muli %46, %47 : i64
    %49 = index.cast %output_byte_offset : offset to i64
    %50 = scalar.addi %49, %48 : i64
    %51 = scalar.assume %50 [range(%50, 0, 9223372036854775807)] : i64
    %52 = index.cast %51 : i64 to offset
    %53 = buffer.view %output[%52] : buffer -> view<1xf32>
    view.store %45, %53[0] : f32, view<1xf32>
  }
  kernel.return
}

check.case public @configured_copy_case {
  %input = check.generate.iota offset(-1.0) step(0.25) period(8) : tensor<67xf32>
  %output = check.generate.fill value(0.0) : tensor<67xf32>
  %56 = check.literal value(67) : i32
  %57 = check.literal value(67) : i32
  kernel.launch @configured_copy[%56](%57, %input, %output) : [i32](i32, tensor<67xf32>, tensor<67xf32>)
  check.expect.bitwise actual(%output) expected(%input) : tensor<67xf32>
  check.return
}

// ====
// Kernel specializations retain their source-owned configuration contract.
#include <loomcxx/check.h>
#include <loomcxx/kernel.h>

static loom::kernel::configuration configure_specialization(
    unsigned item_count) {
  return {{item_count, 1, 1}, {1, 1, 1}};
}

template <class T>
[[loom::kernel(configure_specialization)]] void configured_template(
    T* output) {
  output[0] = T(42);
}

LOOM_CHECK_CASE(configured_template_case) {
  const auto output = loom::check::fill<1, unsigned>(0u);
  loom::check::launch<configured_template<unsigned>>(
      loom::kernel::workload(1u), output);
  loom::check::expect_bitwise(output,
                              loom::check::fill<1, unsigned>(42u));
}

// ----
check.case public @configured_template_case {
  %output = check.generate.fill value(0) : tensor<1xi32>
  %1 = check.literal value(1) : i32
  kernel.launch @configured_template_unsigned_int[%1](%output) : [i32](tensor<1xi32>)
  %2 = check.generate.fill value(42) : tensor<1xi32>
  check.expect.bitwise actual(%output) expected(%2) : tensor<1xi32>
  check.return
}

kernel.def @configured_template_unsigned_int(%item_count: i32) {
  %5 = scalar.constant 1 : i32
  %6 = scalar.constant 1 : i32
  %7 = scalar.constant 1 : i32
  %8 = scalar.constant 1 : i32
  %9 = scalar.constant 1 : i32
  %10 = scalar.extui %item_count : i32 to i64
  %11 = index.cast %10 : i64 to index
  %12 = scalar.extui %5 : i32 to i64
  %13 = index.cast %12 : i64 to index
  %14 = scalar.extui %6 : i32 to i64
  %15 = index.cast %14 : i64 to index
  %16 = scalar.extui %7 : i32 to i64
  %17 = index.cast %16 : i64 to index
  %18 = scalar.extui %8 : i32 to i64
  %19 = index.cast %18 : i64 to index
  %20 = scalar.extui %9 : i32 to i64
  %21 = index.cast %20 : i64 to index
  kernel.launch.config workgroups(%11, %13, %15) workgroup_size(%17, %19, %21) : index
} launch(%output: buffer) {
  %output_byte_offset = index.constant 0 : offset
  %23 = scalar.constant 42 : i32
  %24 = scalar.constant 0 : i32
  %25 = scalar.extsi %24 : i32 to i64
  %26 = scalar.constant 4 : i64
  %27 = scalar.muli %25, %26 : i64
  %28 = index.cast %output_byte_offset : offset to i64
  %29 = scalar.addi %28, %27 : i64
  %30 = scalar.assume %29 [range(%29, 0, 9223372036854775807)] : i64
  %31 = index.cast %30 : i64 to offset
  %32 = buffer.view %output[%31] : buffer -> view<1xi32>
  view.store %23, %32[0] : i32, view<1xi32>
  kernel.return
}

// ====
// Pointer workloads let launch geometry read data produced before dispatch.
#include <loomcxx/check.h>
#include <loomcxx/kernel.h>

static loom::kernel::configuration configure_indirect(const unsigned* counts) {
  return {{counts[0], 1, 1}, {64, 1, 1}};
}

[[loom::kernel(configure_indirect)]] void indirect() {}

LOOM_CHECK_CASE(indirect_case) {
  const auto counts = loom::check::fill<1, unsigned>(1u);
  loom::check::launch<indirect>(loom::kernel::workload(counts));
}

// ----
kernel.def @indirect(%counts: buffer, %counts_byte_offset: offset) {
  %2 = scalar.constant 0 : i32
  %3 = scalar.extsi %2 : i32 to i64
  %4 = scalar.constant 4 : i64
  %5 = scalar.muli %3, %4 : i64
  %6 = index.cast %counts_byte_offset : offset to i64
  %7 = scalar.addi %6, %5 : i64
  %8 = scalar.assume %7 [range(%7, 0, 9223372036854775807)] : i64
  %9 = index.cast %8 : i64 to offset
  %10 = buffer.view %counts[%9] : buffer -> view<1xi32>
  %11 = view.load %10[0] : view<1xi32> -> i32
  %12 = scalar.constant 1 : i32
  %13 = scalar.constant 1 : i32
  %14 = scalar.constant 64 : i32
  %15 = scalar.constant 1 : i32
  %16 = scalar.constant 1 : i32
  %17 = scalar.extui %11 : i32 to i64
  %18 = index.cast %17 : i64 to index
  %19 = scalar.extui %12 : i32 to i64
  %20 = index.cast %19 : i64 to index
  %21 = scalar.extui %13 : i32 to i64
  %22 = index.cast %21 : i64 to index
  %23 = scalar.extui %14 : i32 to i64
  %24 = index.cast %23 : i64 to index
  %25 = scalar.extui %15 : i32 to i64
  %26 = index.cast %25 : i64 to index
  %27 = scalar.extui %16 : i32 to i64
  %28 = index.cast %27 : i64 to index
  kernel.launch.config workgroups(%18, %20, %22) workgroup_size(%24, %26, %28) : index
} launch() {
  kernel.return
}

check.case public @indirect_case {
  %counts = check.generate.fill value(1) : tensor<1xi32>
  %30 = index.constant 0 : offset
  kernel.launch @indirect[%counts, %30]() : [tensor<1xi32>, offset]()
  check.return
}

// ====
// Buffer and view workloads retain their native High representations.
#include <loomcxx/kernel.h>

namespace loomt = loom::type;
using CountBuffer = loomt::buffer<const unsigned>;
using CountView = loomt::view<loomt::shape<3>, const unsigned>;

static loom::kernel::configuration configure_storage(CountBuffer buffer, CountView view) {
  auto layout = loom::encoding::layout::dense<1>();
  auto buffer_view = loom::buffer::view<1>(buffer, {}, layout);
  return {{loom::view::load(buffer_view, 0), loom::view::load(view, 1), 1},
          {64, 1, 1}};
}

[[loom::kernel(configure_storage)]] void storage_configured(unsigned count) [[loom::where(count > 0u)]] {}

// ----
kernel.def @storage_configured(%buffer: buffer, %view_layout: encoding<layout>, %view: view<3xi32, %view_layout>) {
  %layout = encoding.layout.dense : encoding<layout>
  %5 = index.constant 0 : offset
  %buffer_view = buffer.view %buffer[%5] : buffer -> view<1xi32, %layout>
  %7 = scalar.constant 0 : i32
  %8 = index.cast %7 : i32 to index
  %9 = view.load %buffer_view[%8] : view<1xi32, %layout> -> i32
  %10 = scalar.constant 1 : i32
  %11 = index.cast %10 : i32 to index
  %12 = view.load %view[%11] : view<3xi32, %view_layout> -> i32
  %13 = scalar.constant 1 : i32
  %14 = scalar.constant 64 : i32
  %15 = scalar.constant 1 : i32
  %16 = scalar.constant 1 : i32
  %17 = scalar.extui %9 : i32 to i64
  %18 = index.cast %17 : i64 to index
  %19 = scalar.extui %12 : i32 to i64
  %20 = index.cast %19 : i64 to index
  %21 = scalar.extui %13 : i32 to i64
  %22 = index.cast %21 : i64 to index
  %23 = scalar.extui %14 : i32 to i64
  %24 = index.cast %23 : i64 to index
  %25 = scalar.extui %15 : i32 to i64
  %26 = index.cast %25 : i64 to index
  %27 = scalar.extui %16 : i32 to i64
  %28 = index.cast %27 : i64 to index
  kernel.launch.config workgroups(%18, %20, %22) workgroup_size(%24, %26, %28) : index
} launch(%count: i32) where [ne(%count, 0)] {
  kernel.return
}

// ====
// Ordinary scalar workloads and pure helpers compose without a special path.
#include <loomcxx/kernel.h>

static unsigned choose_count(bool enabled, unsigned count) {
  return enabled ? count : 1u;
}

static loom::kernel::configuration configure_helper(bool enabled, unsigned count) {
  return {{choose_count(enabled, count), 1, 1}, {1, 1, 1}};
}

[[loom::kernel(configure_helper)]] void helper_configured() {}

// ----
kernel.def @helper_configured(%enabled: i1, %count: i32) {
  %2 = func.call pure @choose_count(%enabled, %count) : (i1, i32) -> (i32)
  %3 = scalar.constant 1 : i32
  %4 = scalar.constant 1 : i32
  %5 = scalar.constant 1 : i32
  %6 = scalar.constant 1 : i32
  %7 = scalar.constant 1 : i32
  %8 = scalar.extui %2 : i32 to i64
  %9 = index.cast %8 : i64 to index
  %10 = scalar.extui %3 : i32 to i64
  %11 = index.cast %10 : i64 to index
  %12 = scalar.extui %4 : i32 to i64
  %13 = index.cast %12 : i64 to index
  %14 = scalar.extui %5 : i32 to i64
  %15 = index.cast %14 : i64 to index
  %16 = scalar.extui %6 : i32 to i64
  %17 = index.cast %16 : i64 to index
  %18 = scalar.extui %7 : i32 to i64
  %19 = index.cast %18 : i64 to index
  kernel.launch.config workgroups(%9, %11, %13) workgroup_size(%15, %17, %19) : index
} launch() {
  kernel.return
}

func.def @choose_count(%enabled: i1, %count: i32) -> (i32) {
  %23 = scf.if %enabled -> (i32) {
    scf.yield %count : i32
  } else {
    %24 = scalar.constant 1 : i32
    scf.yield %24 : i32
  }
  func.return %23 : i32
}

// ====
// Required-inline helpers preserve target queries, nested pointer provenance,
// and deterministic workload reads until the normal inline phase.
#include <loomcxx/kernel.h>
#include <loomcxx/target.h>

LOOM_FORCE_INLINE const unsigned* select_counts(bool use_left, const unsigned* left, const unsigned* right) {
  return use_left ? left : right;
}

LOOM_FORCE_INLINE unsigned read_count(bool use_left, const unsigned* left, const unsigned* right) {
  return select_counts(use_left, left, right)[0];
}

LOOM_FORCE_INLINE unsigned launch_width() {
  return loom::target::subgroup::size();
}

static loom::kernel::configuration configure_helpers(bool use_left, const unsigned* left, const unsigned* right) {
  unsigned width = launch_width();
  return {{read_count(use_left, left, right), 1, 1}, {width, 1, 1}};
}

[[loom::kernel(configure_helpers)]] void helper_composed() {}

// ----
func.def public linkonce inline @select_counts(%use_left: i1, %left: buffer, %left_byte_offset: offset, %right: buffer, %right_byte_offset: offset) -> (buffer, offset) {
  %7, %8 = scf.if %use_left -> (buffer, offset) {
    scf.yield %left, %left_byte_offset : buffer, offset
  } else {
    scf.yield %right, %right_byte_offset : buffer, offset
  }
  func.return %7, %8 : buffer, offset
}

