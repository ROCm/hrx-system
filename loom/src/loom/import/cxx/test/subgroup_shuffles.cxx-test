// RUN: roundtrip
// Every mode preserves the payload and source-participation result together.
#include <loomcxx/kernel.h>
#include <loomcxx/numeric.h>
#include <loomcxx/vector.h>
#include <stdfloat>

using namespace loom::kernel::subgroup;

#define SHUFFLES(Name, Type)                                                  \
  [[loom::force_inline]] shuffle_result<Type> Name##_xor(                       \
      Type value, unsigned offset, unsigned width) {                           \
    return shuffle_xor(value, offset, width);                                  \
  }                                                                           \
  [[loom::force_inline]] shuffle_result<Type> Name##_up(                        \
      Type value, unsigned offset, unsigned width) {                           \
    return shuffle_up(value, offset, width);                                   \
  }                                                                           \
  [[loom::force_inline]] shuffle_result<Type> Name##_down(                      \
      Type value, unsigned offset, unsigned width) {                           \
    return shuffle_down(value, offset, width);                                 \
  }                                                                           \
  [[loom::force_inline]] shuffle_result<Type> Name##_index(                     \
      Type value, unsigned offset, unsigned width) {                           \
    return shuffle_index(value, offset, width);                                \
  }

SHUFFLES(boolean, bool)
SHUFFLES(signed8, signed char)
SHUFFLES(unsigned8, unsigned char)
SHUFFLES(signed16, short)
SHUFFLES(unsigned16, unsigned short)
SHUFFLES(signed32, int)
SHUFFLES(unsigned32, unsigned)
SHUFFLES(signed64, long long)
SHUFFLES(unsigned64, unsigned long long)
SHUFFLES(float8_e4m3, loom::type::float8_e4m3fn_t)
SHUFFLES(float8_e5m2, loom::type::float8_e5m2_t)
SHUFFLES(float16, std::float16_t)
SHUFFLES(bfloat16, std::bfloat16_t)
SHUFFLES(float32, float)
SHUFFLES(float64, double)

#define VECTOR_SHUFFLES(Name, Type, Width)                                    \
  using Name = Type __attribute__((ext_vector_type(Width)));                  \
  SHUFFLES(Name, Name)

VECTOR_SHUFFLES(Signed8x4, signed char, 4)
VECTOR_SHUFFLES(Unsigned8x4, unsigned char, 4)
VECTOR_SHUFFLES(Signed16x4, short, 4)
VECTOR_SHUFFLES(Unsigned16x4, unsigned short, 4)
VECTOR_SHUFFLES(Signed32x4, int, 4)
VECTOR_SHUFFLES(Unsigned32x4, unsigned, 4)
VECTOR_SHUFFLES(Signed64x2, long long, 2)
VECTOR_SHUFFLES(Unsigned64x2, unsigned long long, 2)
VECTOR_SHUFFLES(Float8E4M3x4, loom::type::float8_e4m3fn_t, 4)
VECTOR_SHUFFLES(Float8E5M2x4, loom::type::float8_e5m2_t, 4)
VECTOR_SHUFFLES(Float16x4, std::float16_t, 4)
VECTOR_SHUFFLES(BFloat16x4, std::bfloat16_t, 4)
VECTOR_SHUFFLES(Float32x4, float, 4)
VECTOR_SHUFFLES(Float64x2, double, 2)

using Static = loom::type::vector<loom::type::shape<3>, unsigned>;
using Dynamic = loom::type::vector<loom::type::shape<loom::type::dynamic>, float>;
using Predicate = loom::type::vector<loom::type::shape<4>, bool>;
SHUFFLES(predicate_vector, Predicate)
SHUFFLES(static_vector, Static)
SHUFFLES(dynamic_vector, Dynamic)

#undef VECTOR_SHUFFLES
#undef SHUFFLES
// ----
func.def public inline @boolean_xor(%value: i1, %offset: i32, %width: i32) -> (i1, i1) {
  %5, %6 = kernel.subgroup.shuffle<xor> %value, %offset, %width : i1, i32, i32
  func.return %5, %6 : i1, i1
}

func.def public inline @boolean_up(%value: i1, %offset: i32, %width: i32) -> (i1, i1) {
  %12, %13 = kernel.subgroup.shuffle<up> %value, %offset, %width : i1, i32, i32
  func.return %12, %13 : i1, i1
}

func.def public inline @boolean_down(%value: i1, %offset: i32, %width: i32) -> (i1, i1) {
  %19, %20 = kernel.subgroup.shuffle<down> %value, %offset, %width : i1, i32, i32
  func.return %19, %20 : i1, i1
}

func.def public inline @boolean_index(%value: i1, %offset: i32, %width: i32) -> (i1, i1) {
  %26, %27 = kernel.subgroup.shuffle<index> %value, %offset, %width : i1, i32, i32
  func.return %26, %27 : i1, i1
}

