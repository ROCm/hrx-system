// RUN: verify
unsigned mutable_binding(unsigned input) {
  // ERROR@+1: LOWERING/059 "constexpr requires a const binding"
  [[loom::constexpr]] unsigned value = input;
  return value;
}

// ====
unsigned volatile_binding(unsigned input) {
  // ERROR@+1: LOWERING/059 "constexpr does not accept volatile bindings"
  [[loom::constexpr]] const volatile unsigned value = input;
  return value;
}

// ====
unsigned addressed_binding(unsigned input) {
  // ERROR@+1: LOWERING/059 "constexpr does not accept addressable bindings"
  [[loom::constexpr]] const unsigned value = input;
  return *&value;
}

// ====
unsigned argument_clause(unsigned input) {
  // ERROR@+1: LOWERING/059 "constexpr does not take an argument clause"
  [[loom::constexpr(1)]] const unsigned value = input;
  return value;
}

// ====
unsigned duplicate(unsigned input) {
  [[loom::constexpr,
    // ERROR@+1: LOWERING/059 "one constexpr contract per declaration is allowed"
    loom::constexpr]] const unsigned value = input;
  return value;
}

// ====
unsigned static_binding() {
  // ERROR@+1: LOWERING/059 "constexpr requires a binding with automatic storage duration"
  [[loom::constexpr]] static const unsigned value = 7;
  return value;
}

// ====
unsigned pointer_binding(unsigned* input) {
  // ERROR@+1: LOWERING/059 "constexpr requires a scalar value binding"
  [[loom::constexpr]] unsigned* const value = input;
  return *value;
}

// ====
unsigned array_binding(unsigned input) {
  // ERROR@+1: LOWERING/059 "constexpr does not accept addressable bindings"
  [[loom::constexpr]] const unsigned value[1] = {input};
  return value[0];
}

// ====
struct Pair { unsigned first; unsigned second; };
unsigned record_binding(unsigned input) {
  // ERROR@+1: LOWERING/059 "constexpr requires a scalar value binding"
  [[loom::constexpr]] const Pair value{input, input};
  return value.first;
}

// ====
using Words = unsigned __attribute__((vector_size(16)));
unsigned vector_binding(unsigned input) {
  // ERROR@+1: LOWERING/059 "constexpr requires a scalar value binding"
  [[loom::constexpr]] const Words value{input, input, input, input};
  return value[0];
}

// ====
// ERROR@+1: LOWERING/059 "constexpr requires a leading automatic const scalar declaration attribute"
[[loom::constexpr]] const unsigned global = 1u;

// ====
unsigned parameter(
    // ERROR@+1: LOWERING/059 "constexpr requires a leading automatic const scalar declaration attribute"
    [[loom::constexpr]] const unsigned value) {
  return value;
}

// ====
// ERROR@+1: LOWERING/059 "constexpr requires a leading automatic const scalar declaration attribute"
[[loom::constexpr]] unsigned function_attribute(unsigned value) {
  return value;
}

// ====
unsigned declarator_attribute(unsigned input) {
  const unsigned
      // ERROR@+1: LOWERING/059 "constexpr requires a leading automatic const scalar declaration attribute"
      value [[loom::constexpr]] = input;
  return value;
}

// ====
unsigned statement_attribute(unsigned input) {
  // ERROR@+1: LOWERING/059 "constexpr requires a leading automatic const scalar declaration attribute"
  [[loom::constexpr]] return input;
}

// ====
unsigned mutable_condition(unsigned input) {
  if (
      // ERROR@+1: LOWERING/059 "constexpr requires a const binding"
      [[loom::constexpr]] bool enabled = input != 0u) return input;
  return 0u;
}
