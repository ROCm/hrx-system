// ====
// Vector members retain their complete lane footprint.
typedef float float4 __attribute__((vector_size(16)));
struct VectorRecord { unsigned tag; float4 value; };
float4 update(VectorRecord* records, unsigned index, float4 delta) {
  return records[index].value += delta;
}

