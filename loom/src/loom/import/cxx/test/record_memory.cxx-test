// Typed fields share an allocation and retain ordinary scalar semantics.
struct Particle { float position; float velocity; unsigned flags; };
void step(Particle* particles, unsigned index, float dt) {
  particles[index].position += particles[index].velocity * dt;
  particles[index].flags |= 1u;
}

