  %8 = scalar.addi %6, %7 : i32
  view.store<volatile> %8, %5[0] : i32, view<1xi32>
  func.return %8 : i32
}

// ====
// Signedness is source semantics; both word fields use signless integer views.
struct Counters { unsigned high; int low; };
float convert(const Counters* values) {
  return float(values->high / 3u) + float(values->low / 3);
}

