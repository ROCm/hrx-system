  %value$2 = scalar.assume %value$0 [ult(%value$0, -1879048192)] : i32
  %value$3 = scalar.assume %value$2 [ule(%value$2, -1879048192)] : i32
  %value$4 = scalar.assume %value$3 [ugt(%value$3, 7)] : i32
  %value$5 = scalar.assume %value$4 [uge(%value$4, 7)] : i32
  func.return %value$5 : i32
}

