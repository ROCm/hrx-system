  %value$5, %equal$6 = scalar.assume %value$0, %equal$1 [eq(%value$0, %equal$1)] : i32, i32
  %value$7, %lower$8 = scalar.assume %value$5, %lower$2 [ne(%value$5, %lower$2)] : i32, i32
  %lower$9, %value$10 = scalar.assume %lower$8, %value$7 [lt(%lower$8, %value$7)] : i32, i32
  %lower$11, %value$12 = scalar.assume %lower$9, %value$10 [le(%lower$9, %value$10)] : i32, i32
  %upper$13, %value$14 = scalar.assume %upper$3, %value$12 [gt(%upper$3, %value$12)] : i32, i32
  %upper$15, %value$16 = scalar.assume %upper$13, %value$14 [ge(%upper$13, %value$14)] : i32, i32
  %17 = scalar.addi %value$16, %equal$6 : i32
  %18 = scalar.addi %17, %lower$11 : i32
  %19 = scalar.addi %18, %upper$15 : i32
  func.return %19 : i32
}

// ====
// RUN: pass combine,cse,dce
// A derived assumption retains the computed SSA identity. Repeating the same
// expression consumes the assumed result instead of rebuilding the arithmetic.
[[loom::assume]] void assume(bool);
unsigned derived_identity(unsigned pair_index) {
  const unsigned index = 1u + 2u * pair_index;
  assume(index + 1u < 15u);
  return index + 1u;
}
// ----
func.def public @derived_identity(%pair_index: i32) -> (i32) {
  %15 = scalar.constant 1 : i32
  %16 = scalar.shli %pair_index, %15 : i32
  %13 = scalar.constant 2 : i32
  %14 = scalar.addi %16, %13 : i32
  %8 = scalar.assume %14 [range(%14, 0, 14)] : i32
  func.return %8 : i32
}

