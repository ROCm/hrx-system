// RUN: roundtrip
// Pure constant bounds retain C++ casts, wrapping, and unevaluated operands.
[[loom::assume]] void assume(bool);
unsigned bounded(unsigned value) {
  assume(value < 16u);
  assume(value < (1u << 4));
  assume(value < (0xffffffffu + 17u));
  assume(value < (unsigned char)272u);
  assume(value < unsigned(16));
  assume(value < sizeof(++value) * 4u);
  assume(value < alignof(unsigned) * 4u);
  assume(value < ((~0u & 15u) + 1u));
  assume(value < (true ? 16 : 8));
  return value;
}
// ----
func.def public @bounded(%value$0: i32) -> (i32) {
  %value$2 = scalar.assume %value$0 [range(%value$0, 0, 15)] : i32
  %value$3 = scalar.assume %value$2 [range(%value$2, 0, 15)] : i32
  %value$4 = scalar.assume %value$3 [range(%value$3, 0, 15)] : i32
  %value$5 = scalar.assume %value$4 [range(%value$4, 0, 15)] : i32
  %value$6 = scalar.assume %value$5 [range(%value$5, 0, 15)] : i32
  %7 = scalar.extui %value$6 : i32 to i64
  %8 = scalar.assume %7 [range(%7, 0, 15)] : i64
  %value$9 = scalar.trunci %8 : i64 to i32
  %10 = scalar.extui %value$9 : i32 to i64
  %11 = scalar.assume %10 [range(%10, 0, 15)] : i64
  %value$12 = scalar.trunci %11 : i64 to i32
  %value$13 = scalar.assume %value$12 [range(%value$12, 0, 15)] : i32
  %value$14 = scalar.assume %value$13 [range(%value$13, 0, 15)] : i32
  func.return %value$14 : i32
}

// ====
// RUN: roundtrip
// Runtime unsigned ordering and signed positivity retain their exact domains.
[[loom::assume]] void assume(bool);
unsigned entry(unsigned tokens, unsigned capacity, int hidden) {
  assume(tokens <= capacity && hidden > 0);
  return tokens + capacity + (unsigned)hidden;
}
// ----
func.def public @entry(%tokens$0: i32, %capacity$1: i32, %hidden$2: i32) -> (i32) {
  %tokens$4, %capacity$5 = scalar.assume %tokens$0, %capacity$1 [ule(%tokens$0, %capacity$1)] : i32, i32
  %hidden$6 = scalar.assume %hidden$2 [gt(%hidden$2, 0)] : i32
  %7 = scalar.addi %tokens$4, %capacity$5 : i32
  %8 = scalar.addi %7, %hidden$6 : i32
  func.return %8 : i32
}

// ====
// RUN: verify
// Unsupported conjuncts reject the complete assumption.
[[loom::assume]] void assume(bool);
unsigned side();
// ERROR@+1: LOWERING/059 "predicate operands must be retained scalar values, compile-time constants, or scalar expressions safe to evaluate unconditionally"
void entry(unsigned value) { assume(value < 256u && value < (side(), 16u)); }

// ====
// RUN: verify
// Unsupported conjuncts reject the complete assumption.
[[loom::assume]] void assume(bool);
struct Bound {};
bool operator&&(bool, Bound);
// ERROR@+1: PARSE/036 "invalid operands to binary expression ('bool' and '::Bound')"
void entry(unsigned value, Bound bound) { assume((value < 256u) && bound); }

// ====
// RUN: roundtrip
// Pure constant bounds constrain the original bindings.
[[loom::assume]] void assume(bool);
unsigned entry(unsigned value, unsigned other) {
  assume(value < (1u << 8) && other < 256u);
  return value + other;
}
// ----
func.def public @entry(%value$0: i32, %other$1: i32) -> (i32) {
  %value$3 = scalar.assume %value$0 [range(%value$0, 0, 255)] : i32
  %other$4 = scalar.assume %other$1 [range(%other$1, 0, 255)] : i32
  %5 = scalar.addi %value$3, %other$4 : i32
  func.return %5 : i32
}

// ====
// RUN: roundtrip
// Signed and unsigned relations, nonzero truth and Boolean truth all retain
// their source bindings.
[[loom::assume]] void assume(bool);
int relations(unsigned tokens, unsigned capacity, unsigned other, int hidden,
              int limit, bool enabled) {
  assume(tokens <= capacity && tokens != other && hidden > 0 &&
         hidden <= limit && enabled);
  return (int)tokens + (int)capacity + (int)other + hidden + limit + enabled;
}
// ----
func.def public @relations(%tokens$0: i32, %capacity$1: i32, %other$2: i32, %hidden$3: i32, %limit$4: i32, %enabled$5: i1) -> (i32) {
  %tokens$7, %capacity$8 = scalar.assume %tokens$0, %capacity$1 [ule(%tokens$0, %capacity$1)] : i32, i32
  %tokens$9, %other$10 = scalar.assume %tokens$7, %other$2 [ne(%tokens$7, %other$2)] : i32, i32
  %hidden$11 = scalar.assume %hidden$3 [gt(%hidden$3, 0)] : i32
  %hidden$12, %limit$13 = scalar.assume %hidden$11, %limit$4 [le(%hidden$11, %limit$4)] : i32, i32
  %enabled$14 = scalar.assume %enabled$5 [ne(%enabled$5, 0)] : i1
  %15 = scalar.addi %tokens$9, %capacity$8 : i32
  %16 = scalar.addi %15, %other$10 : i32
  %17 = scalar.addi %16, %hidden$12 : i32
  %18 = scalar.addi %17, %limit$13 : i32
  %19 = scalar.extui %enabled$14 : i1 to i32
  %20 = scalar.addi %18, %19 : i32
  func.return %20 : i32
}

// ====
// RUN: roundtrip
// Unsigned constant relations retain exact truth across the carrier sign bit.
[[loom::assume]] void assume(bool);
unsigned unsigned_bounds(unsigned value) {
  assume(value < 0x90000000u && value <= 0x90000000u && value > 7u &&
         value >= 7u);
  return value;
}
