}

// ====
// RUN: roundtrip
// Integral promotions and both unsigned carrier halves retain exact ranges.
[[loom::assume]] void assume(bool);
unsigned bounds(unsigned char narrow, unsigned below_sign, unsigned high,
                unsigned below_max, unsigned at_most_below_max) {
  assume(narrow <= 200 && below_sign < 2147483648u &&
         high >= 0x80000000u && below_max < 0xffffffffu &&
         at_most_below_max <= 0xfffffffeu);
  return narrow + below_sign + high + below_max + at_most_below_max;
}
// ----
func.def public @bounds(%narrow$0: i8, %below_sign$1: i32, %high$2: i32, %below_max$3: i32, %at_most_below_max$4: i32) -> (i32) {
  %6 = scalar.extui %narrow$0 : i8 to i32
  %7 = scalar.assume %6 [le(%6, 200)] : i32
  %narrow$8 = scalar.trunci %7 : i32 to i8
  %below_sign$9 = scalar.assume %below_sign$1 [range(%below_sign$1, 0, 2147483647)] : i32
  %high$10 = scalar.assume %high$2 [range(%high$2, -2147483648, -1)] : i32
  %below_max$11 = scalar.assume %below_max$3 [ne(%below_max$3, -1)] : i32
  %at_most_below_max$12 = scalar.assume %at_most_below_max$4 [ne(%at_most_below_max$4, -1)] : i32
  %13 = scalar.extui %narrow$8 : i8 to i32
  %14 = scalar.addi %13, %below_sign$9 : i32
  %15 = scalar.addi %14, %high$10 : i32
  %16 = scalar.addi %15, %below_max$11 : i32
  %17 = scalar.addi %16, %at_most_below_max$12 : i32
  func.return %17 : i32
}

// ====
// RUN: roundtrip
// Compile-time truths and identity relations add no IR.
[[loom::assume]] void assume(bool);
unsigned tautology(unsigned value) {
  assume(true && value <= 0xffffffffu && value >= 0u && value == value);
  return value;
}
// ----
func.def public @tautology(%value: i32) -> (i32) {
  func.return %value : i32
}

// ====
// RUN: roundtrip
// Every signed relation returns and rebinds both constrained operands.
[[loom::assume]] void assume(bool);
int relation_family(int value, int equal, int lower, int upper) {
  assume(value == equal && value != lower && lower < value && lower <= value &&
         upper > value && upper >= value);
  return value + equal + lower + upper;
}
// ----
