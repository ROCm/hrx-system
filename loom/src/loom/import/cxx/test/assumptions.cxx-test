  %19 = buffer.view %const_bounds[%const_bounds_byte_offset] : buffer -> view<1xi32>
  %count$20 = view.load %19[0] : view<1xi32> -> i32
  %21 = scalar.assume %count$20 [le(%count$20, 16)] : i32
