// ====
// Capture initializers execute in source order while the resulting values are
// assembled by semantic field identity.
unsigned ordered_init_capture(unsigned value) {
  unsigned sequence = value;
  auto combine = [left = sequence++, right = sequence++](unsigned input) {
    return left * 100u + right * 10u + input;
  };
  return combine(sequence);
}

