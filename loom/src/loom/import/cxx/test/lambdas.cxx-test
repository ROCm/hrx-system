// ====
// Default captures produce the same concrete value and reference fields as
// their explicit spellings after frontend capture analysis.
unsigned default_value_capture(unsigned value) {
  return [=](unsigned input) { return value + input; }(2u);
}

void default_reference_capture(unsigned value) {
  [&] { ++value; }();
}

