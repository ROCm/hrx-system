kernel.decl @scale_half_vectors() launch(%input: buffer, %output: buffer)

kernel.decl @convert_half() launch(%input: buffer, %output: buffer, %expanded: buffer)

check.case public @half_vectors {
  %input = check.generate.iota offset(0.0) step(0.25) : tensor<136xf16>
  %output = check.generate.fill value(-37.0) : tensor<136xf16>
  kernel.launch @scale_half_vectors(%input, %output) : (tensor<136xf16>, tensor<136xf16>)
  %actual = check.tensor.view %output offset(8) : tensor<136xf16> -> tensor<128xf16>
  %expected = check.generate.iota offset(5.0) step(1.25) : tensor<128xf16>
  check.expect.equal actual(%actual) expected(%expected) : tensor<128xf16>
  %prefix = check.tensor.view %output offset(0) : tensor<136xf16> -> tensor<4xf16>
  %suffix = check.tensor.view %output offset(264) : tensor<136xf16> -> tensor<4xf16>
  %guard = check.generate.fill value(-37.0) : tensor<4xf16>
  check.expect.equal actual(%prefix) expected(%guard) : tensor<4xf16>
  check.expect.equal actual(%suffix) expected(%guard) : tensor<4xf16>
  %unchanged = check.generate.iota offset(0.0) step(0.25) : tensor<136xf16>
  check.expect.equal actual(%input) expected(%unchanged) : tensor<136xf16>
  check.return
}

check.case public @half_round_to_even {
  %input = check.generate.fill value(1.00048828125) : tensor<32xf32>
  %output = check.generate.fill value(-37.0) : tensor<32xf16>
  %expanded = check.generate.fill value(-37.0) : tensor<32xf32>
  kernel.launch @convert_half(%input, %output, %expanded) : (tensor<32xf32>, tensor<32xf16>, tensor<32xf32>)
  %expected_half = check.generate.fill value(1.0) : tensor<32xf16>
  %expected_float = check.generate.fill value(1.0) : tensor<32xf32>
  check.expect.equal actual(%output) expected(%expected_half) : tensor<32xf16>
  check.expect.equal actual(%expanded) expected(%expected_float) : tensor<32xf32>
  check.return
}
