// RUN: verify
// A user-defined literal performs a call even when it looks like a constant.
unsigned operator""_factor(unsigned long long);
void entry() {
  // ERROR@+1: LOWERING/059 "loop scheduling expressions require pure values without calls, mutation, or overloaded operations"
  [[loom::unroll(3_factor)]]
  for (unsigned index = 0; index < 16u; ++index) {}
}

// ====
// RUN: verify
// Invalid loop schedules are not silently discarded.
unsigned opaque();
int entry(unsigned count) {
  int total = 0;
  // ERROR@+1: LOWERING/059 "loop scheduling value requires an integer expression"
  [[loom::unroll(2.5)]] for (unsigned i = 0; i < count; ++i) {
    total += (int)i;
  }
  return total;
}

// ====
// RUN: verify
// Invalid loop schedules are not silently discarded.
unsigned opaque();
int entry(unsigned count) {
  int total = 0;
  // ERROR@+1: LOWERING/059 "loop scheduling attribute requires one argument"
  [[loom::unroll()]] for (unsigned i = 0; i < count; ++i) { total += (int)i; }
  return total;
}

// ====
// RUN: verify
// Invalid loop schedules are not silently discarded.
unsigned opaque();
int entry(unsigned count) {
  int total = 0;
  // ERROR@+1: LOWERING/059 "loop scheduling attribute requires one argument"
  [[loom::unroll(2, 3)]] for (unsigned i = 0; i < count; ++i) {
    total += (int)i;
  }
  return total;
}

// ====
// RUN: verify
// Invalid loop schedules are not silently discarded.
unsigned opaque();
int entry(unsigned count) {
  int total = 0;
  // ERROR@+1: LOWERING/059 "duplicate loop unroll policy"
  [[loom::unroll, loom::unroll(2)]] for (unsigned i = 0; i < count; ++i) {
    total += (int)i;
  }
  return total;
}

