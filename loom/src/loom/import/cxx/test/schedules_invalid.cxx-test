// Invalid loop schedules are not silently discarded.
unsigned opaque();
int entry(unsigned count) {
  int total = 0;
  // ERROR@+1: LOWERING/059 "loop schedule requires an unroll policy"
  [[loom::schedule("linear")]] for (unsigned i = 0; i < count; ++i) {
    total += (int)i;
  }
  return total;
}

// ====
// RUN: verify
// Invalid loop schedules are not silently discarded.
unsigned opaque();
int entry(unsigned count) {
  int total = 0;
  // ERROR@+1: LOWERING/059 "loop schedule requires linear, interleaved, or recurrence as a string literal"
  [[loom::unroll(2), loom::schedule("unknown")]] for (unsigned i = 0; i < count;
                                                      ++i) {
    total += (int)i;
  }
  return total;
}

// ====
// RUN: verify
// Invalid loop schedules are not silently discarded.
unsigned opaque();
int entry(unsigned count) {
  int total = 0;
  [[loom::unroll(2), loom::schedule("linear"),
    // ERROR@+1: LOWERING/059 "duplicate loop unroll schedule"
    loom::schedule("linear")]] for (unsigned i = 0; i < count; ++i) {
    total += (int)i;
  }
  return total;
}

// ====
// RUN: verify
// Invalid loop schedules are not silently discarded.
unsigned opaque();
int entry(unsigned count) {
  int total = 0;
  // ERROR@+1: LOWERING/059 "unsupported Loom loop attribute"
  [[loom::surprise(2)]] for (unsigned i = 0; i < count; ++i) {
    total += (int)i;
  }
  return total;
}

// ====
// RUN: verify
// Invalid loop schedules are not silently discarded.
unsigned entry(unsigned count) {
  // ERROR@+1: LOWERING/059 "loop scheduling requires a counted for loop"
  [[loom::unroll(2)]] while (count) { --count; }
  return count;
}

// ====
// RUN: verify
// Invalid loop schedules are not silently discarded.
unsigned entry(unsigned count) {
  // ERROR@+1: LOWERING/059 "loop scheduling requires a counted for loop"
  [[loom::pipeline(2)]] do { --count; } while (count);
  return count;
}

// ====
// RUN: verify
// Invalid loop schedules are not silently discarded.
unsigned entry(unsigned count) {
  // ERROR@+1: LOWERING/059 "loop scheduling requires a nonwrapping counted for loop"
  [[loom::unroll]] for (int i = 0; i < (int)count; ++i) {}
  return count;
}

// ====
// RUN: verify
// Invalid loop schedules are not silently discarded.
unsigned entry(unsigned count) {
  // ERROR@+1: LOWERING/059 "loop scheduling requires a nonwrapping counted for loop"
  [[loom::unroll]] for (unsigned i = 0; i < 20ULL; ++i) {}
  return count;
}

// ====
// RUN: verify
// Invalid loop schedules are not silently discarded.
unsigned entry(unsigned count) {
  // ERROR@+1: LOWERING/059 "loop scheduling requires a nonwrapping counted for loop"
  [[loom::unroll]] for (unsigned i = 0; i < (count + 0u); ++i) {}
  return count;
}

// ====
// RUN: verify
// Explicit scheduling is never discarded to accommodate an early exit.
unsigned entry(unsigned count, unsigned stop) {
  unsigned total = 0;
  // ERROR@+1: LOWERING/059 "loop scheduling cannot preserve break exits"
  [[loom::unroll(2)]] for (unsigned i = 0; i < count; ++i) {
    total += i;
    if (i == stop) {
      break;
    }
  }
  return total;
}

// ====
// RUN: verify
// Invalid loop schedules are not silently discarded.
unsigned entry(unsigned count) {
  // ERROR@+1: LOWERING/059 "loop scheduling requires a nonwrapping counted for loop"
  [[loom::unroll]] for (unsigned i = 0; i < (count = 20u); ++i) {}
  return count;
}

// ====
// RUN: verify
// Invalid loop schedules are not silently discarded.
unsigned entry(unsigned count) {
  // ERROR@+1: LOWERING/059 "loop scheduling requires a nonwrapping counted for loop"
  [[loom::unroll]] for (unsigned i = 0; i < 20u; i += count) {}
  return count;
}

// ====
// RUN: verify
// Invalid loop schedules are not silently discarded.
unsigned entry(unsigned count) {
  // ERROR@+1: LOWERING/059 "loop scheduling requires a nonwrapping counted for loop"
  [[loom::unroll]] for (unsigned i = 0; i < ~0u; i += (1u << 2)) {}
  return count;
}

// ====
// RUN: verify
// Scheduling annotations cannot introduce observable volatile reads.
extern volatile unsigned* factor;
void entry() {
  // ERROR@+1: LOWERING/059 "loop scheduling expressions cannot read volatile values"
  [[loom::unroll(*factor)]]
  for (unsigned index = 0; index < 16u; ++index) {}
}

// ====
// RUN: verify
// Converting an annotation operand cannot invoke an overloaded conversion.
struct Factor { operator unsigned(); };
extern Factor factor;
void entry() {
  // ERROR@+1: LOWERING/059 "loop scheduling expressions require pure values without calls, mutation, or overloaded operations"
  [[loom::unroll(static_cast<unsigned>(factor))]]
  for (unsigned index = 0; index < 16u; ++index) {}
}

// ====
// RUN: verify
// Overloaded arithmetic cannot become part of a scheduling annotation.
struct Factor { unsigned operator+(unsigned); };
extern Factor factor;
void entry() {
  // ERROR@+1: LOWERING/059 "loop scheduling expressions require pure values without calls, mutation, or overloaded operations"
  [[loom::unroll(factor + 1u)]]
  for (unsigned index = 0; index < 16u; ++index) {}
}
