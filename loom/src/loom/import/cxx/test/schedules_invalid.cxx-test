// ====
// RUN: verify
// Invalid loop schedules are not silently discarded.
unsigned opaque();
int entry(unsigned count) {
  int total = 0;
  // ERROR@+1: LOWERING/059 "duplicate loop pipeline depth"
  [[loom::pipeline(1), loom::pipeline(2)]] for (unsigned i = 0; i < count;
