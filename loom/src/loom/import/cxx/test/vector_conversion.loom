kernel.decl @scale_float8() launch(%input: buffer, %output: buffer, %other_format: buffer)

kernel.decl @convert_integer_vectors() launch(%input: buffer, %unsigned_widened: buffer, %signed_widened: buffer, %unsigned_float: buffer, %signed_float: buffer)

kernel.decl @truncate_float_vectors() launch(%input: buffer, %signed_integer: buffer, %unsigned_integer: buffer, %bytes: buffer)

kernel.decl @convert_half_vectors() launch(%input: buffer, %output: buffer)

// E4M3 lanes [1, 1.25, 448, -0] scale to [1, 1.375, 448, -0]. This
// exercises an even midpoint, ordinary rounding, saturation and signed zero.
check.case public @float8_arithmetic_and_requantization {
  %input = check.generate.fill value(-2139211208) : tensor<32xi32>
  %output = check.generate.fill value(0) : tensor<32xi32>
  %other_format = check.generate.fill value(0) : tensor<32xi32>
  kernel.launch @scale_float8(%input, %output, %other_format) : (tensor<32xi32>, tensor<32xi32>, tensor<32xi32>)
  %expected = check.generate.fill value(-2139210952) : tensor<32xi32>
  %expected_other = check.generate.fill value(-2141242052) : tensor<32xi32>
  check.expect.equal actual(%output) expected(%expected) : tensor<32xi32>
  check.expect.equal actual(%other_format) expected(%expected_other) : tensor<32xi32>
  check.return
}

check.case public @integer_signedness {
  %input = check.generate.fill value(-2139062144) : tensor<32xi32>
  %unsigned_widened = check.generate.fill value(0) : tensor<128xi32>
  %signed_widened = check.generate.fill value(0) : tensor<128xi32>
  %unsigned_float = check.generate.fill value(0.0) : tensor<128xf32>
  %signed_float = check.generate.fill value(0.0) : tensor<128xf32>
  kernel.launch @convert_integer_vectors(%input, %unsigned_widened, %signed_widened, %unsigned_float, %signed_float) : (tensor<32xi32>, tensor<128xi32>, tensor<128xi32>, tensor<128xf32>, tensor<128xf32>)
  %expected_unsigned = check.generate.fill value(128) : tensor<128xi32>
  %expected_signed = check.generate.fill value(-128) : tensor<128xi32>
  %expected_unsigned_float = check.generate.fill value(128.0) : tensor<128xf32>
  %expected_signed_float = check.generate.fill value(-128.0) : tensor<128xf32>
  check.expect.equal actual(%unsigned_widened) expected(%expected_unsigned) : tensor<128xi32>
  check.expect.equal actual(%signed_widened) expected(%expected_signed) : tensor<128xi32>
  check.expect.equal actual(%unsigned_float) expected(%expected_unsigned_float) : tensor<128xf32>
  check.expect.equal actual(%signed_float) expected(%expected_signed_float) : tensor<128xf32>
  check.return
}

check.case public @float_to_integer_and_integer_narrowing {
  %input = check.generate.fill value(257.75) : tensor<128xf32>
  %signed_integer = check.generate.fill value(0) : tensor<128xi32>
  %unsigned_integer = check.generate.fill value(0) : tensor<128xi32>
  %bytes = check.generate.fill value(0) : tensor<128xi8>
  kernel.launch @truncate_float_vectors(%input, %signed_integer, %unsigned_integer, %bytes) : (tensor<128xf32>, tensor<128xi32>, tensor<128xi32>, tensor<128xi8>)
  %expected_integer = check.generate.fill value(257) : tensor<128xi32>
  %expected_bytes = check.generate.fill value(1) : tensor<128xi8>
  check.expect.equal actual(%signed_integer) expected(%expected_integer) : tensor<128xi32>
  check.expect.equal actual(%unsigned_integer) expected(%expected_integer) : tensor<128xi32>
  check.expect.equal actual(%bytes) expected(%expected_bytes) : tensor<128xi8>
  check.return
}

// Adjacent exact F16 midpoints round in opposite directions in BF16:
// [1 + 1/256, 1 + 3/256] becomes [1, 1 + 1/64].
check.case public @half_to_bfloat_rounding {
  %input = check.generate.fill value(1007434756) : tensor<32xi32>
  %output = check.generate.fill value(0) : tensor<32xi32>
  kernel.launch @convert_half_vectors(%input, %output) : (tensor<32xi32>, tensor<32xi32>)
  %expected = check.generate.fill value(1065500544) : tensor<32xi32>
  check.expect.equal actual(%output) expected(%expected) : tensor<32xi32>
  check.return
}
