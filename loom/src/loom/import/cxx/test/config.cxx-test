// RUN: roundtrip
// Header declarations preserve typed named dependencies across source aliases.
namespace tuning {
[[loom::config("attention.factor")]] extern const unsigned factor;
[[loom::config("attention.factor")]] extern const unsigned factor;
}
[[using loom: config("attention.factor")]] extern const unsigned alias;
unsigned scaled(unsigned value) { return value * tuning::factor + alias; }
// ----
config.decl @attention.factor : i32

func.def public @scaled(%value: i32) -> (i32) {
  %factor = config.get @attention.factor : i32
  %4 = scalar.muli %value, %factor : i32
  %alias = config.get @attention.factor : i32
  %6 = scalar.addi %4, %alias : i32
  func.return %6 : i32
}

// ====
// Native index configs preserve shape and schedule values without integer
// widening or index casts.
#include <loomcxx/index.h>
#include <loomcxx/predicate.h>
[[loom::config("model.extent"), loom::where(
  loom::predicate::range(1, 4096) && loom::predicate::multiple_of(16))]]
extern const loom::type::index extent;
loom::type::index read_extent() { return extent; }
// ----
config.decl @model.extent : %0: index where [range(%0, 1, 4096), multiple_of(%0, 16)]

func.def public @read_extent() -> (index) {
  %extent = config.get @model.extent : index
  func.return %extent : index
}

// ====
// A C++ constant initializes an exact index specialization and every source
// read materializes an index-domain constant.
#include <loomcxx/index.h>
[[loom::config("model.width")]]
const loom::type::index width{4096};
loom::type::index read_width() { return width; }
// ----
config.def @model.width = 4096 : index

func.def public @read_width() -> (index) {
  %width = index.constant 4096 : index
  func.return %width : index
}

// ====
// A provider translation unit needs no functions or roots.
[[loom::config("tuning.factor")]] const unsigned factor = 5;
[[loom::config("tuning.enabled")]] const bool enabled = true;
[[loom::config("tuning.scale")]] const float scale = 0.5f;
[[loom::config("tuning.byte")]] const unsigned char byte = 255;
[[loom::config("tuning.mask")]] const unsigned long long mask = ~0ull;
enum class Policy : unsigned short { Fast = 2 };
[[loom::config("tuning.policy")]] const Policy policy = Policy::Fast;
// ----
config.def @tuning.factor = 5 : i32

config.def @tuning.enabled = 1 : i1

config.def @tuning.scale = 0.5 : f32

config.def @tuning.byte = -1 : i8

config.def @tuning.mask = -1 : i64

config.def @tuning.policy = 2 : i16

// ====
// A same-TU definition fixes earlier reads, redeclarations and aliases alike.
[[loom::config("tuning.factor")]] extern const unsigned factor;
[[loom::config("tuning.factor")]] extern const unsigned alias;
unsigned before() { return factor + alias; }
[[loom::config("tuning.factor")]] const unsigned factor = 5;
constexpr unsigned twice = factor * 2;
unsigned after() { return factor + alias + twice; }
// ----
config.def @tuning.factor = 5 : i32

func.def public @before() -> (i32) {
  %factor = scalar.constant 5 : i32
  %alias = scalar.constant 5 : i32
  %4 = scalar.addi %factor, %alias : i32
  func.return %4 : i32
}

func.def public @after() -> (i32) {
  %factor = scalar.constant 5 : i32
  %alias = scalar.constant 5 : i32
  %8 = scalar.addi %factor, %alias : i32
  %twice = scalar.constant 10 : i32
  %10 = scalar.addi %8, %twice : i32
  func.return %10 : i32
}

// ====
// Schedule values can remain native index configs while ordinary loop bounds
// use scalar config reads.
#include <loomcxx/index.h>
[[loom::config("tuning.unroll")]] extern const loom::type::index unroll;
[[loom::config("tuning.depth")]] extern const loom::type::index depth;
[[loom::config("tuning.count")]] extern const unsigned count;
unsigned sum() {
  unsigned total = 0;
  [[loom::unroll(unroll), loom::pipeline(depth)]]
  for (unsigned index = 0; index < count; ++index) { total += index; }
  return total;
}
// ----
config.decl @tuning.unroll : index

config.decl @tuning.depth : index

config.decl @tuning.count : i32

func.def public @sum() -> (i32) {
  %total$4 = scalar.constant 0 : i32
  %index = scalar.constant 0 : i32
  %6 = index.cast %index : i32 to offset
  %count = config.get @tuning.count : i32
  %8 = index.cast %count : i32 to offset
  %9 = index.constant 1 : offset
  %depth = config.get @tuning.depth : index
  %unroll = config.get @tuning.unroll : index
  %total$14 = scf.for %index = [%6 to %8 step %9](%total$13 = %total$4 : i32) -> (i32) pipeline(%depth) unroll(%unroll) {
    %15 = index.cast %index : offset to i32
    %total$16 = scalar.addi %total$13, %15 : i32
    scf.yield %total$16 : i32
  }
  func.return %total$14 : i32
}

// ====
// Runtime C++ control flow stays available for specialization in Loom.
[[loom::config("tuning.enabled")]] extern const bool enabled;
int choose(int value) { if (enabled) return value + 1; return value - 1; }
// ----
config.decl @tuning.enabled : i1

func.def public @choose(%value: i32) -> (i32) {
  %enabled = config.get @tuning.enabled : i1
  %4 = scf.if %enabled -> (i32) {
    %5 = scalar.constant 1 : i32
    %6 = scalar.addi %value, %5 : i32
    scf.yield %6 : i32
  } else {
    %7 = scalar.constant 1 : i32
    %8 = scalar.subi %value, %7 : i32
    scf.yield %8 : i32
  }
  func.return %4 : i32
}

// ====
// Attribute placement is shared by the supported C and C++ source modes.
// INPUT: cxx std=c23
[[loom::config("tuning.factor")]] extern const unsigned factor;
unsigned scale(unsigned value) { return value * factor; }
// ----
config.decl @tuning.factor : i32

func.def public source_signature(#func.abi.c.signature<arguments = [0], results = [0], types = [#func.abi.c.type<unsigned_integer, byte_length = 4, byte_alignment = 4, component_count = 1, bitwidth = 32>]>) @scale(%value: i32) -> (i32) {
  %factor = config.get @tuning.factor : i32
  %4 = scalar.muli %value, %factor : i32
  func.return %4 : i32
}

// ====
// Predicate helper names map directly to the complete integer and floating
// config constraint vocabulary.
#include <loomcxx/predicate.h>
[[loom::config("tuning.tile"), loom::where(
  loom::predicate::eq(64u) && loom::predicate::ne(0u) &&
  loom::predicate::lt(128u) && loom::predicate::le(64u) &&
  loom::predicate::gt(32u) && loom::predicate::ge(64u) &&
  loom::predicate::multiple_of(16u) && loom::predicate::power_of_two() &&
  loom::predicate::range(32u, 128u) &&
  loom::predicate::ult(128u) && loom::predicate::ule(64u) &&
  loom::predicate::ugt(32u) && loom::predicate::uge(64u))]]
extern const unsigned tile;
[[loom::config("tuning.scale"), loom::where(
  loom::predicate::eq(1.0f) && loom::predicate::ne(2.0f) &&
  loom::predicate::not_nan() && loom::predicate::not_inf() &&
  loom::predicate::finite())]]
extern const float scale;
// ----
config.decl @tuning.tile : %0: i32 where [eq(%0, 64), ne(%0, 0), lt(%0, 128), le(%0, 64), gt(%0, 32), ge(%0, 64), multiple_of(%0, 16), power_of_two(%0), range(%0, 32, 128), ult(%0, 128), ule(%0, 64), ugt(%0, 32), uge(%0, 64)]

config.decl @tuning.scale : %1: f32 where [eq(%1, 1), ne(%1, 2), not_nan(%1), not_inf(%1), finite(%1)]

// ====
// Aliases contribute to one conjunction, and an exact definition is checked
// against the merged declaration contract before replacing symbolic reads.
#include <loomcxx/predicate.h>
[[loom::config("model.tile"),
  loom::where(loom::predicate::range(16u, 256u))]]
extern const unsigned tile;
[[loom::config("model.tile"),
  loom::where(loom::predicate::multiple_of(16u))]]
extern const unsigned tile_alias;
[[loom::config("model.tile")]] const unsigned tile = 64u;
unsigned read_tile() { return tile + tile_alias; }
// ----
config.def @model.tile = 64 : i32

func.def public @read_tile() -> (i32) {
  %tile = scalar.constant 64 : i32
  %tile_alias = scalar.constant 64 : i32
  %4 = scalar.addi %tile, %tile_alias : i32
  func.return %4 : i32
}
