kernel.decl @subtract_f16_8() launch(%lhs: buffer, %rhs: buffer, %output: buffer, %count: i32)

kernel.decl @subtract_bf16_8() launch(%lhs: buffer, %rhs: buffer, %output: buffer, %count: i32)

kernel.decl @subtract_f16_1() launch(%lhs: buffer, %rhs: buffer, %output: buffer, %count: i32)

kernel.decl @subtract_bf16_1() launch(%lhs: buffer, %rhs: buffer, %output: buffer, %count: i32)

// Positive and negative zeros, subnormals, normals around exponent boundaries,
// maximum finite values, infinities, and NaNs.
global.rodata.def @f16_edge_bits = align(2) bytes("000001000200ff0300040104ff3b003c013c023cff7b007c017c007e008001800280ff8300840184ffbb00bc01bc02bcfffb00fc01fc00fe")

global.rodata.def @bf16_edge_bits = align(2) bytes("0000010002007f00800081007f3f803f813f823f7f7f807f817fc07f0080018002807f80808081807fbf80bf81bf82bf7fff80ff81ffc0ff")

// Builds the Cartesian product of 28 edge payloads followed by a permutation
// in which each operand visits every 16-bit payload exactly once.
func.def @narrow_float_subtraction_inputs(%edge_data: buffer, %lhs_data: buffer, %rhs_data: buffer) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %edge_count = index.constant 28 : index
  %edge_pair_count = index.constant 784 : index
  %payload_count = index.constant 65536 : index
  %rhs_multiplier = scalar.constant 40503 : i64
  %rhs_offset = scalar.constant 17 : i64
  %edges = buffer.view %edge_data[%origin] : buffer -> view<28xi16>
  %lhs_storage = buffer.assume.memory_space<global> %lhs_data : buffer
  %rhs_storage = buffer.assume.memory_space<global> %rhs_data : buffer
  %lhs_values = buffer.view %lhs_storage[%origin] : buffer -> view<66320xi16>
  %rhs_values = buffer.view %rhs_storage[%origin] : buffer -> view<66320xi16>
  scf.for %row = [%begin to %edge_count step %step] {
    %lhs_bits = view.load %edges[%row] : view<28xi16> -> i16
    scf.for %column = [%begin to %edge_count step %step] {
      %row_base = index.mul %row, %edge_count : index
      %position = index.add %row_base, %column : index
      %rhs_bits = view.load %edges[%column] : view<28xi16> -> i16
      view.store %lhs_bits, %lhs_values[%position] : i16, view<66320xi16>
      view.store %rhs_bits, %rhs_values[%position] : i16, view<66320xi16>
    }
  }
  scf.for %ordinal = [%begin to %payload_count step %step] {
    %position = index.add %edge_pair_count, %ordinal : index
    %ordinal_i64 = index.cast %ordinal : index to i64
    %lhs_bits = scalar.trunci %ordinal_i64 : i64 to i16
    %scaled = scalar.muli %ordinal_i64, %rhs_multiplier : i64
    %shifted = scalar.addi %scaled, %rhs_offset : i64
    %rhs_bits = scalar.trunci %shifted : i64 to i16
    view.store %lhs_bits, %lhs_values[%position] : i16, view<66320xi16>
    view.store %rhs_bits, %rhs_values[%position] : i16, view<66320xi16>
  }
  func.return
}

func.def @f16_subtraction_inputs(%lhs: buffer, %rhs: buffer) {
  %edges = global.load @f16_edge_bits : buffer
  func.call @narrow_float_subtraction_inputs(%edges, %lhs, %rhs) : (buffer, buffer, buffer)
  func.return
}

func.def @bf16_subtraction_inputs(%lhs: buffer, %rhs: buffer) {
  %edges = global.load @bf16_edge_bits : buffer
  func.call @narrow_float_subtraction_inputs(%edges, %lhs, %rhs) : (buffer, buffer, buffer)
  func.return
}

// The narrow inputs are exactly representable in f64. Widening the operation
// and rounding once back to f16 gives an oracle independent of native f16
// subtraction.
func.def @subtract_f16_oracle(%lhs: buffer, %rhs: buffer, %output: buffer, %count: i32) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end_unbounded = index.cast %count : i32 to index
  %end = index.assume %end_unbounded [range(%end_unbounded, 0, 66320)] : index
  %step = index.constant 1 : index
  %lhs_values = buffer.view %lhs[%origin] : buffer -> view<66320xf16>
  %rhs_values = buffer.view %rhs[%origin] : buffer -> view<66320xf16>
  %output_values = buffer.view %output[%origin] : buffer -> view<66320xf32>
  scf.for %position = [%begin to %end step %step] {
    %lhs_value = view.load %lhs_values[%position] : view<66320xf16> -> f16
    %rhs_value = view.load %rhs_values[%position] : view<66320xf16> -> f16
    %lhs_wide = scalar.extf %lhs_value : f16 to f64
    %rhs_wide = scalar.extf %rhs_value : f16 to f64
    %difference_wide = scalar.subf %lhs_wide, %rhs_wide : f64
    %difference = scalar.fptrunc %difference_wide : f64 to f16
    %result = scalar.extf %difference : f16 to f32
    view.store %result, %output_values[%position] : f32, view<66320xf32>
  }
  func.return
}

// The f64 intermediate supplies substantially more precision than bf16 before
// the one explicit round back to the subject type.
func.def @subtract_bf16_oracle(%lhs: buffer, %rhs: buffer, %output: buffer, %count: i32) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end_unbounded = index.cast %count : i32 to index
  %end = index.assume %end_unbounded [range(%end_unbounded, 0, 66320)] : index
  %step = index.constant 1 : index
  %lhs_values = buffer.view %lhs[%origin] : buffer -> view<66320xbf16>
  %rhs_values = buffer.view %rhs[%origin] : buffer -> view<66320xbf16>
  %output_values = buffer.view %output[%origin] : buffer -> view<66320xf32>
  scf.for %position = [%begin to %end step %step] {
    %lhs_value = view.load %lhs_values[%position] : view<66320xbf16> -> bf16
    %rhs_value = view.load %rhs_values[%position] : view<66320xbf16> -> bf16
    %lhs_wide = scalar.extf %lhs_value : bf16 to f64
    %rhs_wide = scalar.extf %rhs_value : bf16 to f64
    %difference_wide = scalar.subf %lhs_wide, %rhs_wide : f64
    %difference = scalar.fptrunc %difference_wide : f64 to bf16
    %result = scalar.extf %difference : bf16 to f32
    view.store %result, %output_values[%position] : f32, view<66320xf32>
  }
  func.return
}

check.scenario @subtract_f16_8_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %lhs = check.generate.fill value(0) : tensor<66320xi16>
    %rhs = check.generate.fill value(0) : tensor<66320xi16>
    check.generate<@f16_subtraction_inputs>(%lhs, %rhs) : (tensor<66320xi16>, tensor<66320xi16>) -> ()
    %storage = check.generate.fill value(-123.5) : tensor<66352xf32>
    %output = check.tensor.view %storage offset(64) : tensor<66352xf32> -> tensor<66320xf32>
    %positive_zero = check.tensor.view %output offset(0) : tensor<66320xf32> -> tensor<1xf32>
    %negative_zero = check.tensor.view %output offset(1568) : tensor<66320xf32> -> tensor<1xf32>
    %count = check.literal value(66320) : i32
    check.compare<@subtract_f16_8, @subtract_f16_oracle>(%lhs, %rhs, %output, %count) : (tensor<66320xi16>, tensor<66320xi16>, tensor<66320xf32>, i32) -> () {
      check.expect.bitwise actual(%lhs) expected(%lhs) : tensor<66320xi16>
      check.expect.bitwise actual(%rhs) expected(%rhs) : tensor<66320xi16>
      check.expect.approximate actual(%storage) expected(%storage) atol(0.0) rtol(0.0) nan(same) : tensor<66352xf32>, tensor<66352xf32>
      check.expect.bitwise actual(%positive_zero) expected(%positive_zero) : tensor<1xf32>
      check.expect.bitwise actual(%negative_zero) expected(%negative_zero) : tensor<1xf32>
    }
  }
  check.return
}

