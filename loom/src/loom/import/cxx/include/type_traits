#ifndef LOOMCXX_TYPE_TRAITS_
#define LOOMCXX_TYPE_TRAITS_

namespace std {

// The false specialization deliberately has no member type: substitution
// removes a candidate only when that member is required by its signature.
template <bool Condition, class Type = void>
struct enable_if {};

template <class Type>
struct enable_if<true, Type> {
  using type = Type;
};

template <bool Condition, class Type = void>
using enable_if_t = typename enable_if<Condition, Type>::type;

}  // namespace std

#endif  // LOOMCXX_TYPE_TRAITS_
