load("//build_tools/bazel:query.bzl", "iree_assert_dependency_boundary")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test", "loom_config_compatible_with")
load(":build_defs.bzl", "CXX_COMPILER_OPTIONS")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],
)

exports_files([
    "include/hip/hip_fp16.h",
    "include/hip/hip_runtime.h",
    "include/loomcxx/atomic.h",
    "include/loomcxx/check.h",
    "include/loomcxx/kernel.h",
    "include/loomcxx/low.h",
    "include/loomcxx/math.h",
    "include/loomcxx/numeric.h",
    "include/loomcxx/scalar.h",
    "include/loomcxx/view.h",
    "include/stdfloat",
])

loom_cc_test(
    name = "import_test",
    srcs = ["import_test.cc"],
    deps = [
        ":cxx",
        "//loom/src/loom/format/text:printer",
        "//loom/src/loom/import/cxx/source:catalog",
        "//loom/src/loom/ops:op_registry",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

iree_assert_dependency_boundary(
    name = "native_dependencies",
    forbidden_subtrees = [
        "//loom/binding/...",
        "//loom/src/loom/target/arch/...",
        "//loom/src/loom/tooling/...",
    ],
    target = ":cxx",
    target_compatible_with = loom_config_compatible_with(["//loom/config/import:cxx"]),
)

loom_cc_library(
    name = "cxx",
    srcs = [
        "check.cc",
        "check.h",
        "import.cc",
        "translation.cc",
        "translation.h",
    ],
    hdrs = ["import.h"],
    cxx_features = CXX_COMPILER_OPTIONS["cxx_features"],
    cxx_standard = CXX_COMPILER_OPTIONS["cxx_standard"],
    deps = [
        "//loom/src/loom/error:diagnostic",
        "//loom/src/loom/error:error_defs",
        "//loom/src/loom/import/cxx/binding:assumptions",
        "//loom/src/loom/import/cxx/binding:check",
        "//loom/src/loom/import/cxx/binding:config",
        "//loom/src/loom/import/cxx/binding:intrinsics",
        "//loom/src/loom/import/cxx/binding:launch",
        "//loom/src/loom/import/cxx/binding:loop_schedule",
        "//loom/src/loom/import/cxx/binding:parameter_contracts",
        "//loom/src/loom/import/cxx/control:analysis",
        "//loom/src/loom/import/cxx/source",
        "//loom/src/loom/import/cxx/source:attributes",
        "//loom/src/loom/import/cxx/source:catalog",
        "//loom/src/loom/import/cxx/source:constants",
        "//loom/src/loom/import/cxx/source:error",
        "//loom/src/loom/import/cxx/source:locations",
        "//loom/src/loom/import/cxx/source:options",
        "//loom/src/loom/import/cxx/symbol:functions",
        "//loom/src/loom/import/cxx/value:bitcast",
        "//loom/src/loom/import/cxx/value:representation",
        "//loom/src/loom/import/cxx/value:scalar",
        "//loom/src/loom/import/cxx/value:signature",
        "//loom/src/loom/import/cxx/value:storage",
        "//loom/src/loom/import/cxx/value:types",
        "//loom/src/loom/import/cxx/value:vector",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/ops/check",
        "//loom/src/loom/ops/func",
        "//loom/src/loom/ops/index",
        "//loom/src/loom/ops/kernel",
        "//loom/src/loom/ops/scalar",
        "//loom/src/loom/ops/scf",
        "//loom/src/loom/ops/vector",
        "//loom/src/loom/verify",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
        "//third_party:cxx_parser",
    ],
)
