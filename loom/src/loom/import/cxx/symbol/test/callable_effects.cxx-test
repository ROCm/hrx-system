// RUN: roundtrip

// Effects flow once through complete helper chains and remain explicit on the
// imported calls consumed by verification and later compiler passes.
static unsigned pure_leaf(unsigned value) { return value + 1; }
static unsigned pure_middle(unsigned value) { return pure_leaf(value); }
static unsigned read_leaf(const unsigned* input) { return input[0]; }
static unsigned read_middle(const unsigned* input) { return read_leaf(input); }

unsigned combine(const unsigned* input, unsigned value) {
  return pure_middle(value) + read_middle(input);
}

// ----
func.def public @combine(%input: buffer, %input_byte_offset: offset, %value: i32) -> (i32) {
  %4 = func.call pure @pure_middle(%value) : (i32) -> (i32)
  %5 = func.call readonly @read_middle(%input, %input_byte_offset) : (buffer, offset) -> (i32)
  %6 = scalar.addi %4, %5 : i32
  func.return %6 : i32
}

func.def @pure_middle(%value: i32) -> (i32) {
  %9 = func.call pure @pure_leaf(%value) : (i32) -> (i32)
  func.return %9 : i32
}

func.def @read_middle(%input: buffer, %input_byte_offset: offset) -> (i32) {
  %13 = func.call readonly @read_leaf(%input, %input_byte_offset) : (buffer, offset) -> (i32)
  func.return %13 : i32
}

func.def @pure_leaf(%value: i32) -> (i32) {
  %16 = scalar.constant 1 : i32
  %17 = scalar.addi %value, %16 : i32
  func.return %17 : i32
}

func.def @read_leaf(%input: buffer, %input_byte_offset: offset) -> (i32) {
  %21 = scalar.constant 0 : i32
  %22 = scalar.extsi %21 : i32 to i64
  %23 = scalar.constant 4 : i64
  %24 = scalar.muli %22, %23 : i64
  %25 = index.cast %input_byte_offset : offset to i64
  %26 = scalar.addi %25, %24 : i64
  %27 = scalar.assume %26 [range(%26, 0, 9223372036854775807)] : i64
  %28 = index.cast %27 : i64 to offset
  %29 = buffer.view %input[%28] : buffer -> view<1xi32>
  %30 = view.load<root_in_bounds> %29[0] : view<1xi32> -> i32
  func.return %30 : i32
}

// ====
#include <loomcxx/pipeline.h>

namespace loomt = loom::type;
using Payload = loomt::tile<loomt::shape<4>, unsigned>;
using Stream = loomt::channel<Payload>;
using Slots = loomt::view<loomt::shape<2, 4>, unsigned>;

struct Resources {
  // Storage allocated from the caller's workgroup pool.
  unsigned char* storage;
  // FIFO bound to the caller's slots.
  Stream stream;
};

[[loom::inline]] static Resources make_resources(loomt::pool pool, loomt::index storage_size, Slots slots) {
  auto* storage = loom::buffer::alloca<unsigned char, loom::memory_space::workgroup, 64>(storage_size, pool);
  auto stream = loom::channel::bind<loom::channel::discipline::fifo>(slots, loomt::index{2});
  return {.storage = storage, .stream = stream};
}

Resources construct_resources(loomt::pool pool, loomt::index storage_size, Slots slots) {
  return make_resources(pool, storage_size, slots);
}

// ----
func.def public @construct_resources(%pool: pool, %storage_size: index, %slots: view<2x4xi32>) -> (buffer, offset, channel<tile<4xi32>>) {
  %6, %7, %8 = func.call @make_resources(%pool, %storage_size, %slots) : (pool, index, view<2x4xi32>) -> (buffer, offset, channel<tile<4xi32>>)
  func.return %6, %7, %8 : buffer, offset, channel<tile<4xi32>>
}

func.def inline @make_resources(%pool: pool, %storage_size: index, %slots: view<2x4xi32>) -> (buffer, offset, channel<tile<4xi32>>) {
  %15 = index.constant 1 : offset
  %16 = index.scale %storage_size, %15 : index, offset -> offset
  %storage = buffer.alloca<workgroup> pool(%pool) align(64) %16 : buffer
  %storage_byte_offset = index.constant 0 : offset
  %19 = scalar.constant 2 : i32
  %20 = scalar.extsi %19 : i32 to i64
  %21 = index.cast %20 : i64 to index
  %stream = channel.bind<fifo> %slots, %21 : view<2x4xi32>, index -> channel<tile<4xi32>>
  func.return %storage, %storage_byte_offset, %stream : buffer, offset, channel<tile<4xi32>>
}
