  %73 = buffer.view %keys[%keys_byte_offset] : buffer -> view<1xi32>
  %74 = view.load<root_in_bounds|type_disjoint> %73[0] : view<1xi32> -> i32
  %state_first$75 = scalar.addi %state_first$62, %74 : i32
  func.return %state_first$75, %state_second : i32, i32
}

