  %150 = scalar.constant 4 : i64
  %58 = index.cast %keys_byte_offset : offset to i64
  %59 = scalar.addi %58, %150 : i64
  %60 = scalar.assume %59 [range(%59, 0, 9223372036854775807)] : i64
