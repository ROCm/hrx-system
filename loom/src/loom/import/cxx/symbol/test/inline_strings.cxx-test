// RUN: pass canonicalize,cse,dce
// Every literal retains its source code units and terminator.
const char* empty() { return ""; }
const char* ordinary() { return "Loom"; }
const char* concatenated() { return "one" " two"; }
const char* raw() { return R"(one\two)"; }
const char* embedded_nul() { return "a\0b"; }
const char* binary() { return "\xff"; }
const char8_t* unicode() { return u8"café 🧵"; }
const char8_t* binary_utf8() { return u8"\xff"; }
const char16_t* utf16() { return u"L\U0001F9F5"; }
const char32_t* utf32() { return U"L\U0001F9F5"; }
const wchar_t* wide() { return L"Loom"; }

// ----
func.def public @empty() -> (buffer, offset) {
  %2 = buffer.constant align(1) utf8("\u0000") : buffer
  %3 = index.constant 0 : offset
  func.return %2, %3 : buffer, offset
}

func.def public @ordinary() -> (buffer, offset) {
  %7 = buffer.constant align(1) utf8("Loom\u0000") : buffer
  %8 = index.constant 0 : offset
  func.return %7, %8 : buffer, offset
}

func.def public @concatenated() -> (buffer, offset) {
  %12 = buffer.constant align(1) utf8("one two\u0000") : buffer
  %13 = index.constant 0 : offset
  func.return %12, %13 : buffer, offset
}

func.def public @raw() -> (buffer, offset) {
  %17 = buffer.constant align(1) utf8("one\\two\u0000") : buffer
  %18 = index.constant 0 : offset
  func.return %17, %18 : buffer, offset
}

func.def public @embedded_nul() -> (buffer, offset) {
  %22 = buffer.constant align(1) utf8("a\u0000b\u0000") : buffer
  %23 = index.constant 0 : offset
  func.return %22, %23 : buffer, offset
}

func.def public @binary() -> (buffer, offset) {
  %27 = buffer.constant align(1) bytes("ff00") : buffer
  %28 = index.constant 0 : offset
  func.return %27, %28 : buffer, offset
}

func.def public @unicode() -> (buffer, offset) {
  %32 = buffer.constant align(1) utf8("café 🧵\u0000") : buffer
  %33 = index.constant 0 : offset
  func.return %32, %33 : buffer, offset
}

func.def public @binary_utf8() -> (buffer, offset) {
  %37 = buffer.constant align(1) bytes("ff00") : buffer
  %38 = index.constant 0 : offset
  func.return %37, %38 : buffer, offset
}

func.def public @utf16() -> (buffer, offset) {
  %42 = buffer.constant align(2) bytes("4c003ed8f5dd0000") : buffer
  %43 = index.constant 0 : offset
  func.return %42, %43 : buffer, offset
}

func.def public @utf32() -> (buffer, offset) {
  %47 = buffer.constant align(4) bytes("4c000000f5f9010000000000") : buffer
  %48 = index.constant 0 : offset
  func.return %47, %48 : buffer, offset
}

func.def public @wide() -> (buffer, offset) {
  %52 = buffer.constant align(4) bytes("4c0000006f0000006f0000006d00000000000000") : buffer
  %53 = index.constant 0 : offset
  func.return %52, %53 : buffer, offset
}

// ====
// RUN: pass canonicalize,cse,dce
// INPUT: cxx data-model=llp64
const wchar_t* wide_windows() { return L"L\uffff"; }
unsigned wide_load(unsigned position) { return L"\uffffL"[position % 3u]; }

// ----
func.def public @wide_windows() -> (buffer, offset) {
  %2 = buffer.constant align(2) bytes("4c00ffff0000") : buffer
  %3 = index.constant 0 : offset
  func.return %2, %3 : buffer, offset
}

func.def public @wide_load(%position: i32) -> (i32) {
  %7 = buffer.constant align(2) bytes("ffff4c000000") : buffer
  %8 = index.constant 0 : offset
  %9 = buffer.view %7[%8] : buffer -> view<3xi16>
  %10 = scalar.constant 3 : i32
  %11 = scalar.remui %position, %10 : i32
  %12 = scalar.extui %11 : i32 to i64
  %13 = scalar.assume %12 [range(%12, 0, 2)] : i64
  %14 = index.cast %13 : i64 to index
  %15 = view.load %9[%14] : view<3xi16> -> i16
  %16 = scalar.extui %15 : i16 to i32
  func.return %16 : i32
}

// ====
// RUN: pass canonicalize,cse,dce
// Array references and pointers to the whole literal preserve its extent.
unsigned references(unsigned position) {
  const auto& text = "abc";
  auto* whole = &"def";
  return static_cast<unsigned char>(text[position & 3u]) +
         static_cast<unsigned char>((*whole)[position & 3u]);
}

// ----
func.def public @references(%position: i32) -> (i32) {
  %2 = buffer.constant align(1) utf8("abc\u0000") : buffer
  %3 = index.constant 0 : offset
  %4 = buffer.view %2[%3] : buffer -> view<4xi8>
  %whole = buffer.constant align(1) utf8("def\u0000") : buffer
  %7 = buffer.view %whole[%3] : buffer -> view<4xi8>
  %8 = scalar.constant 3 : i32
  %9 = scalar.andi %position, %8 : i32
  %10 = scalar.extui %9 : i32 to i64
  %11 = scalar.assume %10 [range(%10, 0, 3)] : i64
  %12 = index.cast %11 : i64 to index
  %13 = view.load %4[%12] : view<4xi8> -> i8
  %14 = scalar.extui %13 : i8 to i32
  %20 = view.load %7[%12] : view<4xi8> -> i8
  %21 = scalar.extui %20 : i8 to i32
  %22 = scalar.addi %14, %21 : i32
  func.return %22 : i32
}

// ====
// RUN: pass canonicalize,cse,dce
unsigned writable(unsigned position, unsigned replacement) {
  alignas(16) char first[8] = "abc";
  const char second[8] = {"abc"};
  first[position & 7u] = replacement;
  return static_cast<unsigned char>(first[position & 7u]) +
         256u * static_cast<unsigned char>(second[position & 7u]);
}

// ----
func.def public @writable(%position: i32, %replacement: i32) -> (i32) {
  %first_storage = buffer.alloca.init<private> align(16) utf8("abc\u0000\u0000\u0000\u0000\u0000") : buffer
  %first_storage_byte_offset = index.constant 0 : offset
  %first_view = buffer.view %first_storage[%first_storage_byte_offset] : buffer -> view<8xi8>
  %second_storage = buffer.alloca.init<private> align(1) utf8("abc\u0000\u0000\u0000\u0000\u0000") : buffer
  %second_view = buffer.view %second_storage[%first_storage_byte_offset] : buffer -> view<8xi8>
  %9 = scalar.trunci %replacement : i32 to i8
  %10 = scalar.constant 7 : i32
  %11 = scalar.andi %position, %10 : i32
  %12 = scalar.extui %11 : i32 to i64
  %13 = scalar.assume %12 [range(%12, 0, 7)] : i64
  %14 = index.cast %13 : i64 to index
  view.store %9, %first_view[%14] : i8, view<8xi8>
  %20 = view.load %first_view[%14] : view<8xi8> -> i8
  %21 = scalar.extui %20 : i8 to i32
  %28 = view.load %second_view[%14] : view<8xi8> -> i8
  %29 = scalar.extui %28 : i8 to i32
  %32 = scalar.constant 8 : i32
  %33 = scalar.shli %29, %32 : i32
  %31 = scalar.addi %21, %33 : i32
  func.return %31 : i32
}

// ====
// RUN: pass canonicalize,cse,dce
unsigned nested(unsigned row, unsigned position) {
  struct Record { char label[4]; unsigned value; };
  Record record = {"abc", 7};
  char nested[2][4] = {"def", "ghi"};
  return static_cast<unsigned char>(record.label[position & 3u]) +
         static_cast<unsigned char>(nested[row & 1u][position & 3u]) + record.value;
}

// ----
func.def public @nested(%row: i32, %position: i32) -> (i32) {
  %record_label_0 = scalar.constant 97 : i8
  %record_label_1 = scalar.constant 98 : i8
  %record_label_2 = scalar.constant 99 : i8
  %record_label_3 = scalar.constant 0 : i8
  %record_value = scalar.constant 7 : i32
  %8 = index.constant 8 : offset
  %nested_storage = buffer.alloca<private> align(1) %8 : buffer
  %nested_storage_byte_offset = index.constant 0 : offset
  %12 = buffer.constant align(1) utf8("def\u0000") : buffer
  %14 = index.constant 4 : offset
  buffer.copy %12[%nested_storage_byte_offset], %nested_storage[%nested_storage_byte_offset], %14
  %17 = buffer.constant align(1) utf8("ghi\u0000") : buffer
  buffer.copy %17[%nested_storage_byte_offset], %nested_storage[%14], %14
  %20 = scalar.constant 3 : i32
  %21 = scalar.andi %position, %20 : i32
  %22 = scalar.constant 2 : i32
  %23 = scalar.cmpi ult, %21, %22 : i32
  %25 = scalar.constant 0 : i32
  %26 = scalar.cmpi eq, %21, %25 : i32
  %29 = scalar.cmpi eq, %21, %22 : i32
  %68 = scf.select %23, %26, %29 : i1
  %69 = scf.select %23, %record_label_0, %record_label_2 : i8
  %70 = scf.select %23, %record_label_1, %record_label_3 : i8
  %67 = scf.select %68, %69, %70 : i8
  %31 = scalar.extui %67 : i8 to i32
  %32 = scalar.constant 1 : i32
  %33 = scalar.andi %row, %32 : i32
  %34 = scalar.extui %33 : i32 to i64
  %62 = scalar.constant 2 : i64
  %63 = scalar.shli %34, %62 : i64
  %39 = scalar.assume %63 [range(%63, 0, 9223372036854775807)] : i64
  %40 = index.cast %39 : i64 to offset
  %43 = scalar.extui %21 : i32 to i64
  %46 = index.cast %40 : offset to i64
  %47 = scalar.addi %46, %43 : i64
  %48 = scalar.assume %47 [range(%47, 0, 9223372036854775807)] : i64
  %49 = index.cast %48 : i64 to offset
  %50 = index.assume %49 [range(%49, 0, 7)] : offset
  %51 = buffer.view %nested_storage[%50] : buffer -> view<1xi8>
  %52 = view.load %51[0] : view<1xi8> -> i8
  %53 = scalar.extui %52 : i8 to i32
  %54 = scalar.addi %31, %53 : i32
  %55 = scalar.addi %54, %record_value : i32
  func.return %55 : i32
}

// ====
// RUN: pass canonicalize,cse,dce
unsigned volatile_string(unsigned position) {
  volatile char text[3] = "ab";
  return static_cast<unsigned char>(text[position % 3u]);
}

