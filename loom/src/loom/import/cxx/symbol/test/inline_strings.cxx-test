  %2 = index.constant 8 : offset
  %observed_storage = buffer.alloca<private> align(2) %2 : buffer
  %observed_storage_byte_offset = index.constant 0 : offset
  %observed_view = buffer.view %observed_storage[%observed_storage_byte_offset] : buffer -> view<4xi16>
  %6 = scalar.constant -10178 : i16
  %8 = buffer.view %observed_storage[%observed_storage_byte_offset] : buffer -> view<1xi16>
  view.store<volatile> %6, %8[0] : i16, view<1xi16>
  %9 = scalar.constant -8715 : i16
  %33 = index.constant 2 : offset
  %13 = buffer.view %observed_storage[%33] : buffer -> view<1xi16>
  view.store<volatile> %9, %13[0] : i16, view<1xi16>
  %14 = scalar.constant 0 : i16
  %32 = index.constant 4 : offset
  %18 = buffer.view %observed_storage[%32] : buffer -> view<1xi16>
  view.store<volatile> %14, %18[0] : i16, view<1xi16>
  %31 = index.constant 6 : offset
  %23 = buffer.view %observed_storage[%31] : buffer -> view<1xi16>
  view.store<volatile> %14, %23[0] : i16, view<1xi16>
  %24 = scalar.constant 3 : i32
  %25 = scalar.andi %position, %24 : i32
  %26 = scalar.extui %25 : i32 to i64
  %27 = scalar.assume %26 [range(%26, 0, 3)] : i64
  %28 = index.cast %27 : i64 to index
  %29 = view.load<volatile> %observed_view[%28] : view<4xi16> -> i16
  %30 = scalar.extui %29 : i16 to i32
  func.return %30 : i32
}

// ====
// Literal references, whole-array pointers, empty literals, and a pointer
// returned by a helper retain the selected byte and terminator observations.
static const char* text() { return "a\0b"; }
unsigned literal_aliases() {
  const auto* escaped = text();
  const auto& reference = "xyz";
  auto* whole = &"xyz";
  return escaped[2] + reference[1] + (*whole)[3] + ""[0];
}
// ----
func.def public @literal_aliases() -> (i32) {
  %escaped, %escaped_byte_offset = func.call pure @text() : () -> (buffer, offset)
  %3 = buffer.constant align(1) utf8("xyz\u0000") : buffer
  %4 = index.constant 0 : offset
  %5 = buffer.view %3[%4] : buffer -> view<4xi8>
  %52 = scalar.constant 2 : i64
  %13 = index.cast %escaped_byte_offset : offset to i64
  %14 = scalar.addi %13, %52 : i64
  %15 = scalar.assume %14 [range(%14, 0, 9223372036854775807)] : i64
  %16 = index.cast %15 : i64 to offset
  %17 = buffer.view %escaped[%16] : buffer -> view<1xi8>
  %18 = view.load<root_in_bounds> %17[0] : view<1xi8> -> i8
  %19 = scalar.extsi %18 : i8 to i32
  %51 = index.constant 1 : index
  %24 = view.load %5[%51] : view<4xi8> -> i8
  %25 = scalar.extsi %24 : i8 to i32
  %26 = scalar.addi %19, %25 : i32
  %50 = index.constant 3 : index
  %31 = view.load %5[%50] : view<4xi8> -> i8
  %32 = scalar.extsi %31 : i8 to i32
  %33 = scalar.addi %26, %32 : i32
  %34 = buffer.constant align(1) utf8("\u0000") : buffer
  %36 = buffer.view %34[%4] : buffer -> view<1xi8>
  %49 = index.constant 0 : index
  %41 = view.load %36[%49] : view<1xi8> -> i8
  %42 = scalar.extsi %41 : i8 to i32
  %43 = scalar.addi %33, %42 : i32
  func.return %43 : i32
}

func.def @text() -> (buffer, offset) {
  %46 = buffer.constant align(1) utf8("a\u0000b\u0000") : buffer
  %47 = index.constant 0 : offset
  func.return %46, %47 : buffer, offset
}
