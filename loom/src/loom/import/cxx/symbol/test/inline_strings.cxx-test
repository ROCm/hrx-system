  %2 = index.constant 3 : offset
  %text_storage = buffer.alloca<private> align(1) %2 : buffer
  %text_storage_byte_offset = index.constant 0 : offset
  %text_view = buffer.view %text_storage[%text_storage_byte_offset] : buffer -> view<3xi8>
  %6 = scalar.constant 97 : i8
  %8 = buffer.view %text_storage[%text_storage_byte_offset] : buffer -> view<1xi8>
  view.store<volatile> %6, %8[0] : i8, view<1xi8>
  %9 = scalar.constant 98 : i8
  %27 = index.constant 1 : offset
  %13 = buffer.view %text_storage[%27] : buffer -> view<1xi8>
  view.store<volatile> %9, %13[0] : i8, view<1xi8>
  %14 = scalar.constant 0 : i8
  %26 = index.constant 2 : offset
  %18 = buffer.view %text_storage[%26] : buffer -> view<1xi8>
  view.store<volatile> %14, %18[0] : i8, view<1xi8>
  %19 = scalar.constant 3 : i32
  %20 = scalar.remui %position, %19 : i32
  %21 = scalar.extui %20 : i32 to i64
  %22 = scalar.assume %21 [range(%21, 0, 2)] : i64
  %23 = index.cast %22 : i64 to index
  %24 = view.load<volatile> %text_view[%23] : view<3xi8> -> i8
  %25 = scalar.extui %24 : i8 to i32
  func.return %25 : i32
}

// ====
// RUN: pass canonicalize,cse,dce
// A single clause initializes the first inner array, not the whole outer array.
unsigned one_row(unsigned position) {
  char table[1][4] = {"abc"};
  volatile char observed[1][4] = {"def"};
  return table[0][position & 3u] + observed[0][position & 3u];
}

// ----
func.def public @one_row(%position: i32) -> (i32) {
  %2 = index.constant 4 : offset
  %table_storage = buffer.alloca<private> align(1) %2 : buffer
  %table_storage_byte_offset = index.constant 0 : offset
  %6 = buffer.constant align(1) utf8("abc\u0000") : buffer
  buffer.copy %6[%table_storage_byte_offset], %table_storage[%table_storage_byte_offset], %2
  %observed_storage = buffer.alloca<private> align(1) %2 : buffer
  %13 = scalar.constant 100 : i8
  %15 = buffer.view %observed_storage[%table_storage_byte_offset] : buffer -> view<1xi8>
  view.store<volatile> %13, %15[0] : i8, view<1xi8>
  %16 = scalar.constant 101 : i8
  %76 = index.constant 1 : offset
  %20 = buffer.view %observed_storage[%76] : buffer -> view<1xi8>
  view.store<volatile> %16, %20[0] : i8, view<1xi8>
  %21 = scalar.constant 102 : i8
  %75 = index.constant 2 : offset
  %25 = buffer.view %observed_storage[%75] : buffer -> view<1xi8>
  view.store<volatile> %21, %25[0] : i8, view<1xi8>
  %26 = scalar.constant 0 : i8
  %74 = index.constant 3 : offset
  %30 = buffer.view %observed_storage[%74] : buffer -> view<1xi8>
  view.store<volatile> %26, %30[0] : i8, view<1xi8>
  %39 = scalar.constant 3 : i32
  %40 = scalar.andi %position, %39 : i32
  %41 = scalar.extui %40 : i32 to i64
  %46 = scalar.assume %41 [range(%41, 0, 9223372036854775807)] : i64
  %47 = index.cast %46 : i64 to offset
  %48 = index.assume %47 [range(%47, 0, 3)] : offset
  %49 = buffer.view %table_storage[%48] : buffer -> view<1xi8>
  %50 = view.load %49[0] : view<1xi8> -> i8
  %51 = scalar.extsi %50 : i8 to i32
  %70 = buffer.view %observed_storage[%48] : buffer -> view<1xi8>
  %71 = view.load<volatile> %70[0] : view<1xi8> -> i8
  %72 = scalar.extsi %71 : i8 to i32
  %73 = scalar.addi %51, %72 : i32
  func.return %73 : i32
}

// ====
// RUN: pass canonicalize,cse,dce
unsigned character_arrays(unsigned position) {
  signed char signed_bytes[] = "\xff";
  unsigned char unsigned_bytes[] = {"\xff"};
  char8_t utf8[4] = u8"é";
  char16_t utf16[4] = u"\U0001F9F5";
  char32_t utf32[4] = U"\U0001F9F5";
  wchar_t wide[4] = L"\U0001F9F5";
  return signed_bytes[position & 1u] + unsigned_bytes[position & 1u] +
         utf8[position & 3u] + utf16[position & 3u] +
         utf32[position & 3u] + wide[position & 3u];
}

// ----
func.def public @character_arrays(%position: i32) -> (i32) {
