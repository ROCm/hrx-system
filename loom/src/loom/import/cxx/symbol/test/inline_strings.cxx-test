// RUN: pass canonicalize,cse,dce
// Every literal retains its source code units and terminator.
const char* empty() { return ""; }
const char* ordinary() { return "Loom"; }
const char* concatenated() { return "one" " two"; }
const char* raw() { return R"(one\two)"; }
const char* embedded_nul() { return "a\0b"; }
const char* binary() { return "\xff"; }
const char8_t* unicode() { return u8"café 🧵"; }
const char8_t* binary_utf8() { return u8"\xff"; }
const char16_t* utf16() { return u"L\U0001F9F5"; }
const char32_t* utf32() { return U"L\U0001F9F5"; }
const wchar_t* wide() { return L"Loom"; }

// ----
func.def public @empty() -> (buffer, index) {
  %2 = buffer.constant align(1) utf8("\u0000") : buffer
  %3 = index.constant 0 : index
  func.return %2, %3 : buffer, index
}

func.def public @ordinary() -> (buffer, index) {
  %7 = buffer.constant align(1) utf8("Loom\u0000") : buffer
  %8 = index.constant 0 : index
  func.return %7, %8 : buffer, index
}

func.def public @concatenated() -> (buffer, index) {
  %12 = buffer.constant align(1) utf8("one two\u0000") : buffer
  %13 = index.constant 0 : index
  func.return %12, %13 : buffer, index
}

func.def public @raw() -> (buffer, index) {
  %17 = buffer.constant align(1) utf8("one\\two\u0000") : buffer
  %18 = index.constant 0 : index
  func.return %17, %18 : buffer, index
}

func.def public @embedded_nul() -> (buffer, index) {
  %22 = buffer.constant align(1) utf8("a\u0000b\u0000") : buffer
  %23 = index.constant 0 : index
  func.return %22, %23 : buffer, index
}

func.def public @binary() -> (buffer, index) {
  %27 = buffer.constant align(1) bytes("ff00") : buffer
  %28 = index.constant 0 : index
  func.return %27, %28 : buffer, index
}

func.def public @unicode() -> (buffer, index) {
  %32 = buffer.constant align(1) utf8("café 🧵\u0000") : buffer
  %33 = index.constant 0 : index
  func.return %32, %33 : buffer, index
}

func.def public @binary_utf8() -> (buffer, index) {
  %37 = buffer.constant align(1) bytes("ff00") : buffer
  %38 = index.constant 0 : index
  func.return %37, %38 : buffer, index
}

func.def public @utf16() -> (buffer, index) {
  %42 = buffer.constant align(2) bytes("4c003ed8f5dd0000") : buffer
  %43 = index.constant 0 : index
  func.return %42, %43 : buffer, index
}

func.def public @utf32() -> (buffer, index) {
  %47 = buffer.constant align(4) bytes("4c000000f5f9010000000000") : buffer
  %48 = index.constant 0 : index
  func.return %47, %48 : buffer, index
}

func.def public @wide() -> (buffer, index) {
  %52 = buffer.constant align(4) bytes("4c0000006f0000006f0000006d00000000000000") : buffer
  %53 = index.constant 0 : index
  func.return %52, %53 : buffer, index
}

// ====
// RUN: pass canonicalize,cse,dce
// INPUT: cxx data-model=llp64
const wchar_t* wide_windows() { return L"L\uffff"; }
unsigned wide_load(unsigned position) { return L"\uffffL"[position % 3u]; }

// ----
func.def public @wide_windows() -> (buffer, index) {
  %2 = buffer.constant align(2) bytes("4c00ffff0000") : buffer
  %3 = index.constant 0 : index
  func.return %2, %3 : buffer, index
}

func.def public @wide_load(%position: i32) -> (i32) {
  %7 = buffer.constant align(2) bytes("ffff4c000000") : buffer
  %8 = index.constant 0 : index
  %9 = buffer.view %7[%8] : buffer -> view<3xi16>
  %10 = scalar.constant 3 : i32
  %11 = scalar.remui %position, %10 : i32
  %12 = scalar.extui %11 : i32 to i64
  %13 = scalar.assume %12 [range(%12, 0, 2)] : i64
  %14 = index.cast %13 : i64 to index
  %15 = view.load<type_disjoint> %9[%14] : view<3xi16> -> i16
  %16 = scalar.extui %15 : i16 to i32
  func.return %16 : i32
}

// ====
// RUN: pass canonicalize,cse,dce
// Array references and pointers to the whole literal preserve its extent.
unsigned references(unsigned position) {
  const auto& text = "abc";
  auto* whole = &"def";
  return static_cast<unsigned char>(text[position & 3u]) +
         static_cast<unsigned char>((*whole)[position & 3u]);
}

// ----
func.def public @references(%position: i32) -> (i32) {
  %2 = buffer.constant align(1) utf8("abc\u0000") : buffer
  %3 = index.constant 0 : index
  %4 = buffer.view %2[%3] : buffer -> view<4xi8>
  %whole = buffer.constant align(1) utf8("def\u0000") : buffer
  %7 = buffer.view %whole[%3] : buffer -> view<4xi8>
  %8 = scalar.constant 3 : i32
  %9 = scalar.andi %position, %8 : i32
  %10 = scalar.extui %9 : i32 to i64
  %11 = scalar.assume %10 [range(%10, 0, 3)] : i64
  %12 = index.cast %11 : i64 to index
  %13 = view.load %4[%12] : view<4xi8> -> i8
  %14 = scalar.extui %13 : i8 to i32
  %20 = view.load %7[%12] : view<4xi8> -> i8
  %21 = scalar.extui %20 : i8 to i32
  %22 = scalar.addi %14, %21 : i32
  func.return %22 : i32
}

// ====
// RUN: pass canonicalize,cse,dce
unsigned writable(unsigned position, unsigned replacement) {
  alignas(16) char first[8] = "abc";
  const char second[8] = {"abc"};
  first[position & 7u] = replacement;
  return static_cast<unsigned char>(first[position & 7u]) +
         256u * static_cast<unsigned char>(second[position & 7u]);
}

// ----
func.def public @writable(%position: i32, %replacement: i32) -> (i32) {
  %first_storage = buffer.alloca.init<private> align(16) utf8("abc\u0000\u0000\u0000\u0000\u0000") : buffer
  %first_storage_byte_offset = index.constant 0 : index
  %first_view = buffer.view %first_storage[%first_storage_byte_offset] : buffer -> view<8xi8>
  %second_storage = buffer.alloca.init<private> align(1) utf8("abc\u0000\u0000\u0000\u0000\u0000") : buffer
  %second_view = buffer.view %second_storage[%first_storage_byte_offset] : buffer -> view<8xi8>
  %9 = scalar.trunci %replacement : i32 to i8
  %10 = scalar.constant 7 : i32
  %11 = scalar.andi %position, %10 : i32
  %12 = scalar.extui %11 : i32 to i64
  %13 = scalar.assume %12 [range(%12, 0, 7)] : i64
  %14 = index.cast %13 : i64 to index
  view.store %9, %first_view[%14] : i8, view<8xi8>
  %20 = view.load %first_view[%14] : view<8xi8> -> i8
  %21 = scalar.extui %20 : i8 to i32
  %28 = view.load %second_view[%14] : view<8xi8> -> i8
  %29 = scalar.extui %28 : i8 to i32
  %32 = scalar.constant 8 : i32
  %33 = scalar.shli %29, %32 : i32
  %31 = scalar.addi %21, %33 : i32
  func.return %31 : i32
}

// ====
// RUN: pass canonicalize,cse,dce
unsigned nested(unsigned row, unsigned position) {
  struct Record { char label[4]; unsigned value; };
  Record record = {"abc", 7};
  char nested[2][4] = {"def", "ghi"};
  return static_cast<unsigned char>(record.label[position & 3u]) +
         static_cast<unsigned char>(nested[row & 1u][position & 3u]) + record.value;
}

// ----
func.def public @nested(%row: i32, %position: i32) -> (i32) {
  %record_label_0 = scalar.constant 97 : i8
  %record_label_1 = scalar.constant 98 : i8
  %record_label_2 = scalar.constant 99 : i8
  %record_label_3 = scalar.constant 0 : i8
  %record_value = scalar.constant 7 : i32
  %8 = index.constant 8 : offset
  %nested_storage = buffer.alloca<private> align(1) %8 : buffer
  %nested_storage_byte_offset = index.constant 0 : index
  %12 = buffer.constant align(1) utf8("def\u0000") : buffer
  %14 = index.constant 4 : offset
  buffer.copy %12[%nested_storage_byte_offset], %nested_storage[%nested_storage_byte_offset], %14
  %46 = index.constant 4 : index
  %17 = buffer.constant align(1) utf8("ghi\u0000") : buffer
  buffer.copy %17[%nested_storage_byte_offset], %nested_storage[%46], %14
  %20 = scalar.constant 3 : i32
  %21 = scalar.andi %position, %20 : i32
  %22 = index.cast %21 : i32 to index
  %23 = scf.lookup %22 {
    0 = (%record_label_0),
    1 = (%record_label_1),
    2 = (%record_label_2)
  } default(%record_label_3) : i8
  %24 = scalar.extui %23 : i8 to i32
  %25 = scalar.constant 1 : i32
  %26 = scalar.andi %row, %25 : i32
  %27 = scalar.extui %26 : i32 to i64
  %28 = index.cast %27 : i64 to index
  %34 = scalar.extui %21 : i32 to i64
  %35 = index.cast %34 : i64 to index
  %45 = index.madd %28, %46, %35 : index
  %39 = index.assume %45 [range(%45, 0, 7)] : index
  %40 = buffer.view %nested_storage[%39] : buffer -> view<1xi8>
  %41 = view.load %40[0] : view<1xi8> -> i8
  %42 = scalar.extui %41 : i8 to i32
  %43 = scalar.addi %24, %42 : i32
  %44 = scalar.addi %43, %record_value : i32
  func.return %44 : i32
}

// ====
// RUN: pass canonicalize,cse,dce
unsigned volatile_string(unsigned position) {
  volatile char text[3] = "ab";
  return static_cast<unsigned char>(text[position % 3u]);
}

// ----
func.def public @volatile_string(%position: i32) -> (i32) {
  %2 = index.constant 3 : offset
  %text_storage = buffer.alloca<private> align(1) %2 : buffer
  %text_storage_byte_offset = index.constant 0 : index
  %text_view = buffer.view %text_storage[%text_storage_byte_offset] : buffer -> view<3xi8>
  %6 = scalar.constant 97 : i8
  %8 = buffer.view %text_storage[%text_storage_byte_offset] : buffer -> view<1xi8>
  view.store<volatile> %6, %8[0] : i8, view<1xi8>
  %9 = scalar.constant 98 : i8
  %27 = index.constant 1 : index
  %13 = buffer.view %text_storage[%27] : buffer -> view<1xi8>
  view.store<volatile> %9, %13[0] : i8, view<1xi8>
  %14 = scalar.constant 0 : i8
  %26 = index.constant 2 : index
  %18 = buffer.view %text_storage[%26] : buffer -> view<1xi8>
  view.store<volatile> %14, %18[0] : i8, view<1xi8>
  %19 = scalar.constant 3 : i32
  %20 = scalar.remui %position, %19 : i32
  %21 = scalar.extui %20 : i32 to i64
  %22 = scalar.assume %21 [range(%21, 0, 2)] : i64
  %23 = index.cast %22 : i64 to index
  %24 = view.load<volatile> %text_view[%23] : view<3xi8> -> i8
  %25 = scalar.extui %24 : i8 to i32
  func.return %25 : i32
}

// ====
// RUN: pass canonicalize,cse,dce
// A single clause initializes the first inner array, not the whole outer array.
unsigned one_row(unsigned position) {
  char table[1][4] = {"abc"};
  volatile char observed[1][4] = {"def"};
  return table[0][position & 3u] + observed[0][position & 3u];
}

// ----
func.def public @one_row(%position: i32) -> (i32) {
  %2 = index.constant 4 : offset
  %table_storage = buffer.alloca<private> align(1) %2 : buffer
  %table_storage_byte_offset = index.constant 0 : index
  %6 = buffer.constant align(1) utf8("abc\u0000") : buffer
  buffer.copy %6[%table_storage_byte_offset], %table_storage[%table_storage_byte_offset], %2
  %observed_storage = buffer.alloca<private> align(1) %2 : buffer
  %13 = scalar.constant 100 : i8
  %15 = buffer.view %observed_storage[%table_storage_byte_offset] : buffer -> view<1xi8>
  view.store<volatile> %13, %15[0] : i8, view<1xi8>
  %16 = scalar.constant 101 : i8
  %66 = index.constant 1 : index
  %20 = buffer.view %observed_storage[%66] : buffer -> view<1xi8>
  view.store<volatile> %16, %20[0] : i8, view<1xi8>
  %21 = scalar.constant 102 : i8
  %65 = index.constant 2 : index
  %25 = buffer.view %observed_storage[%65] : buffer -> view<1xi8>
  view.store<volatile> %21, %25[0] : i8, view<1xi8>
  %26 = scalar.constant 0 : i8
  %64 = index.constant 3 : index
  %30 = buffer.view %observed_storage[%64] : buffer -> view<1xi8>
  view.store<volatile> %26, %30[0] : i8, view<1xi8>
  %36 = scalar.constant 3 : i32
  %37 = scalar.andi %position, %36 : i32
  %38 = scalar.extui %37 : i32 to i64
  %39 = index.cast %38 : i64 to index
  %43 = index.assume %39 [range(%39, 0, 3)] : index
  %44 = buffer.view %table_storage[%43] : buffer -> view<1xi8>
  %45 = view.load %44[0] : view<1xi8> -> i8
  %46 = scalar.extsi %45 : i8 to i32
  %60 = buffer.view %observed_storage[%43] : buffer -> view<1xi8>
  %61 = view.load<volatile> %60[0] : view<1xi8> -> i8
  %62 = scalar.extsi %61 : i8 to i32
  %63 = scalar.addi %46, %62 : i32
  func.return %63 : i32
}

// ====
// RUN: pass canonicalize,cse,dce
unsigned character_arrays(unsigned position) {
  signed char signed_bytes[] = "\xff";
  unsigned char unsigned_bytes[] = {"\xff"};
  char8_t utf8[4] = u8"é";
  char16_t utf16[4] = u"\U0001F9F5";
  char32_t utf32[4] = U"\U0001F9F5";
  wchar_t wide[4] = L"\U0001F9F5";
  return signed_bytes[position & 1u] + unsigned_bytes[position & 1u] +
         utf8[position & 3u] + utf16[position & 3u] +
         utf32[position & 3u] + wide[position & 3u];
}

// ----
func.def public @character_arrays(%position: i32) -> (i32) {
  %signed_bytes_storage = buffer.alloca.init<private> align(1) bytes("ff00") : buffer
  %signed_bytes_storage_byte_offset = index.constant 0 : index
  %signed_bytes_view = buffer.view %signed_bytes_storage[%signed_bytes_storage_byte_offset] : buffer -> view<2xi8>
  %unsigned_bytes_storage = buffer.alloca.init<private> align(1) bytes("ff00") : buffer
  %unsigned_bytes_view = buffer.view %unsigned_bytes_storage[%signed_bytes_storage_byte_offset] : buffer -> view<2xi8>
  %utf8_storage = buffer.alloca.init<private> align(1) utf8("é\u0000\u0000") : buffer
  %utf8_view = buffer.view %utf8_storage[%signed_bytes_storage_byte_offset] : buffer -> view<4xi8>
  %utf16_storage = buffer.alloca.init<private> align(2) bytes("3ed8f5dd00000000") : buffer
  %utf16_view = buffer.view %utf16_storage[%signed_bytes_storage_byte_offset] : buffer -> view<4xi16>
  %utf32_storage = buffer.alloca.init<private> align(4) bytes("f5f90100000000000000000000000000") : buffer
  %utf32_view = buffer.view %utf32_storage[%signed_bytes_storage_byte_offset] : buffer -> view<4xi32>
  %wide_storage = buffer.alloca.init<private> align(4) bytes("f5f90100000000000000000000000000") : buffer
  %wide_view = buffer.view %wide_storage[%signed_bytes_storage_byte_offset] : buffer -> view<4xi32>
  %20 = scalar.constant 1 : i32
  %21 = scalar.andi %position, %20 : i32
  %22 = scalar.extui %21 : i32 to i64
  %23 = scalar.assume %22 [range(%22, 0, 1)] : i64
  %24 = index.cast %23 : i64 to index
  %25 = view.load<type_disjoint> %signed_bytes_view[%24] : view<2xi8> -> i8
  %26 = scalar.extsi %25 : i8 to i32
  %32 = view.load %unsigned_bytes_view[%24] : view<2xi8> -> i8
  %33 = scalar.extui %32 : i8 to i32
  %34 = scalar.addi %26, %33 : i32
  %35 = scalar.constant 3 : i32
  %36 = scalar.andi %position, %35 : i32
  %37 = scalar.extui %36 : i32 to i64
  %38 = scalar.assume %37 [range(%37, 0, 3)] : i64
  %39 = index.cast %38 : i64 to index
  %40 = view.load<type_disjoint> %utf8_view[%39] : view<4xi8> -> i8
  %41 = scalar.extui %40 : i8 to i32
  %42 = scalar.addi %34, %41 : i32
  %48 = view.load<type_disjoint> %utf16_view[%39] : view<4xi16> -> i16
  %49 = scalar.extui %48 : i16 to i32
  %50 = scalar.addi %42, %49 : i32
  %56 = view.load<type_disjoint> %utf32_view[%39] : view<4xi32> -> i32
  %57 = scalar.addi %50, %56 : i32
  %63 = view.load<type_disjoint> %wide_view[%39] : view<4xi32> -> i32
  %64 = scalar.addi %57, %63 : i32
  func.return %64 : i32
}

// ====
// A literal pointer returned by a helper carries its storage and origin to the
// caller. Loads of ordinary, UTF-8, and UTF-16 code units use their own widths.
#include <loomcxx/kernel.h>
static const char* text() { return "a\0b"; }
unsigned code_units(unsigned position) {
  loom::assume(position < 3u);
  return static_cast<unsigned char>(text()[position]) + u8"é"[position] +
         u"\U0001F9F5"[position];
}
// ----
func.def public @code_units(%position$0: i32) -> (i32) {
  %position$2 = scalar.assume %position$0 [range(%position$0, 0, 2)] : i32
  %3, %4 = func.call pure @text() : () -> (buffer, index)
  %5 = scalar.extui %position$2 : i32 to i64
  %6 = index.cast %5 : i64 to index
  %9 = index.add %4, %6 : index
  %10 = buffer.view %3[%9] : buffer -> view<1xi8>
  %11 = view.load<root_in_bounds> %10[0] : view<1xi8> -> i8
  %12 = scalar.extui %11 : i8 to i32
  %13 = buffer.constant align(1) utf8("é\u0000") : buffer
  %14 = index.constant 0 : index
  %15 = buffer.view %13[%14] : buffer -> view<3xi8>
  %17 = scalar.assume %5 [range(%5, 0, 2)] : i64
  %18 = index.cast %17 : i64 to index
  %19 = view.load<type_disjoint> %15[%18] : view<3xi8> -> i8
  %20 = scalar.extui %19 : i8 to i32
  %21 = scalar.addi %12, %20 : i32
  %22 = buffer.constant align(2) bytes("3ed8f5dd0000") : buffer
  %24 = buffer.view %22[%14] : buffer -> view<3xi16>
  %28 = view.load<type_disjoint> %24[%18] : view<3xi16> -> i16
  %29 = scalar.extui %28 : i16 to i32
  %30 = scalar.addi %21, %29 : i32
  func.return %30 : i32
}

func.def @text() -> (buffer, index) {
  %33 = buffer.constant align(1) utf8("a\u0000b\u0000") : buffer
  %34 = index.constant 0 : index
  func.return %33, %34 : buffer, index
}

// ====
// Volatile wide initialization emits element observations, including both
// surrogate code units and the explicit terminator and trailing zero.
unsigned volatile_wide(unsigned position) {
  volatile char16_t observed[4] = u"\U0001F9F5";
  return observed[position & 3u];
}
// ----
func.def public @volatile_wide(%position: i32) -> (i32) {
  %2 = index.constant 8 : offset
  %observed_storage = buffer.alloca<private> align(2) %2 : buffer
  %observed_storage_byte_offset = index.constant 0 : index
  %observed_view = buffer.view %observed_storage[%observed_storage_byte_offset] : buffer -> view<4xi16>
  %6 = scalar.constant -10178 : i16
  %8 = buffer.view %observed_storage[%observed_storage_byte_offset] : buffer -> view<1xi16>
  view.store<volatile|type_disjoint> %6, %8[0] : i16, view<1xi16>
  %9 = scalar.constant -8715 : i16
  %33 = index.constant 2 : index
  %13 = buffer.view %observed_storage[%33] : buffer -> view<1xi16>
  view.store<volatile|type_disjoint> %9, %13[0] : i16, view<1xi16>
  %14 = scalar.constant 0 : i16
  %32 = index.constant 4 : index
  %18 = buffer.view %observed_storage[%32] : buffer -> view<1xi16>
  view.store<volatile|type_disjoint> %14, %18[0] : i16, view<1xi16>
  %31 = index.constant 6 : index
  %23 = buffer.view %observed_storage[%31] : buffer -> view<1xi16>
  view.store<volatile|type_disjoint> %14, %23[0] : i16, view<1xi16>
  %24 = scalar.constant 3 : i32
  %25 = scalar.andi %position, %24 : i32
  %26 = scalar.extui %25 : i32 to i64
  %27 = scalar.assume %26 [range(%26, 0, 3)] : i64
  %28 = index.cast %27 : i64 to index
  %29 = view.load<volatile|type_disjoint> %observed_view[%28] : view<4xi16> -> i16
  %30 = scalar.extui %29 : i16 to i32
  func.return %30 : i32
}

// ====
// Literal references, whole-array pointers, empty literals, and a pointer
// returned by a helper retain the selected byte and terminator observations.
static const char* text() { return "a\0b"; }
unsigned literal_aliases() {
  const auto* escaped = text();
  const auto& reference = "xyz";
  auto* whole = &"xyz";
  return escaped[2] + reference[1] + (*whole)[3] + ""[0];
}
// ----
func.def public @literal_aliases() -> (i32) {
  %escaped, %escaped_byte_offset = func.call pure @text() : () -> (buffer, index)
  %3 = buffer.constant align(1) utf8("xyz\u0000") : buffer
  %4 = index.constant 0 : index
  %5 = buffer.view %3[%4] : buffer -> view<4xi8>
  %51 = index.constant 2 : index
  %50 = index.add %escaped_byte_offset, %51 : index
  %14 = buffer.view %escaped[%50] : buffer -> view<1xi8>
  %15 = view.load<root_in_bounds> %14[0] : view<1xi8> -> i8
  %16 = scalar.extsi %15 : i8 to i32
  %48 = index.constant 1 : index
  %21 = view.load %5[%48] : view<4xi8> -> i8
  %22 = scalar.extsi %21 : i8 to i32
  %23 = scalar.addi %16, %22 : i32
  %47 = index.constant 3 : index
  %28 = view.load %5[%47] : view<4xi8> -> i8
  %29 = scalar.extsi %28 : i8 to i32
  %30 = scalar.addi %23, %29 : i32
  %31 = buffer.constant align(1) utf8("\u0000") : buffer
  %33 = buffer.view %31[%4] : buffer -> view<1xi8>
  %38 = view.load %33[%4] : view<1xi8> -> i8
  %39 = scalar.extsi %38 : i8 to i32
  %40 = scalar.addi %30, %39 : i32
  func.return %40 : i32
}

func.def @text() -> (buffer, index) {
  %43 = buffer.constant align(1) utf8("a\u0000b\u0000") : buffer
  %44 = index.constant 0 : index
  func.return %43, %44 : buffer, index
}
