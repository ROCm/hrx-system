  %unsigned_bytes_storage = buffer.alloca.init<private> align(1) bytes("ff00") : buffer
  %unsigned_bytes_view = buffer.view %unsigned_bytes_storage[%signed_bytes_storage_byte_offset] : buffer -> view<2xi8>
