  %utf16_storage = buffer.alloca.init<private> align(2) bytes("3ed8f5dd00000000") : buffer
  %utf16_view = buffer.view %utf16_storage[%signed_bytes_storage_byte_offset] : buffer -> view<4xi16>
  %utf32_storage = buffer.alloca.init<private> align(4) bytes("f5f90100000000000000000000000000") : buffer
  %utf32_view = buffer.view %utf32_storage[%signed_bytes_storage_byte_offset] : buffer -> view<4xi32>
  %wide_storage = buffer.alloca.init<private> align(4) bytes("f5f90100000000000000000000000000") : buffer
  %wide_view = buffer.view %wide_storage[%signed_bytes_storage_byte_offset] : buffer -> view<4xi32>
  %20 = scalar.constant 1 : i32
  %21 = scalar.andi %position, %20 : i32
  %22 = scalar.extui %21 : i32 to i64
  %23 = scalar.assume %22 [range(%22, 0, 1)] : i64
  %24 = index.cast %23 : i64 to index
  %25 = view.load %signed_bytes_view[%24] : view<2xi8> -> i8
  %26 = scalar.extsi %25 : i8 to i32
  %32 = view.load %unsigned_bytes_view[%24] : view<2xi8> -> i8
  %33 = scalar.extui %32 : i8 to i32
  %34 = scalar.addi %26, %33 : i32
  %35 = scalar.constant 3 : i32
  %36 = scalar.andi %position, %35 : i32
  %37 = scalar.extui %36 : i32 to i64
  %38 = scalar.assume %37 [range(%37, 0, 3)] : i64
  %39 = index.cast %38 : i64 to index
  %40 = view.load %utf8_view[%39] : view<4xi8> -> i8
  %41 = scalar.extui %40 : i8 to i32
  %42 = scalar.addi %34, %41 : i32
  %48 = view.load %utf16_view[%39] : view<4xi16> -> i16
  %49 = scalar.extui %48 : i16 to i32
  %50 = scalar.addi %42, %49 : i32
  %56 = view.load %utf32_view[%39] : view<4xi32> -> i32
  %57 = scalar.addi %50, %56 : i32
  %63 = view.load %wide_view[%39] : view<4xi32> -> i32
  %64 = scalar.addi %57, %63 : i32
  func.return %64 : i32
}

// ====
// A literal pointer returned by a helper carries its storage and origin to the
// caller. Loads of ordinary, UTF-8, and UTF-16 code units use their own widths.
#include <loomcxx/kernel.h>
static const char* text() { return "a\0b"; }
unsigned code_units(unsigned position) {
  loom::assume(position < 3u);
  return static_cast<unsigned char>(text()[position]) + u8"é"[position] +
         u"\U0001F9F5"[position];
}
// ----
func.def public @code_units(%position$0: i32) -> (i32) {
  %position$2 = scalar.assume %position$0 [range(%position$0, 0, 2)] : i32
  %3, %4 = func.call pure @text() : () -> (buffer, offset)
  %5 = scalar.extui %position$2 : i32 to i64
  %8 = index.cast %4 : offset to i64
  %9 = scalar.addi %8, %5 : i64
  %10 = scalar.assume %9 [range(%9, 0, 9223372036854775807)] : i64
  %11 = index.cast %10 : i64 to offset
  %12 = buffer.view %3[%11] : buffer -> view<1xi8>
  %13 = view.load<root_in_bounds> %12[0] : view<1xi8> -> i8
  %14 = scalar.extui %13 : i8 to i32
  %15 = buffer.constant align(1) utf8("é\u0000") : buffer
  %16 = index.constant 0 : offset
  %17 = buffer.view %15[%16] : buffer -> view<3xi8>
  %19 = scalar.assume %5 [range(%5, 0, 2)] : i64
  %20 = index.cast %19 : i64 to index
  %21 = view.load %17[%20] : view<3xi8> -> i8
  %22 = scalar.extui %21 : i8 to i32
  %23 = scalar.addi %14, %22 : i32
  %24 = buffer.constant align(2) bytes("3ed8f5dd0000") : buffer
  %26 = buffer.view %24[%16] : buffer -> view<3xi16>
  %30 = view.load %26[%20] : view<3xi16> -> i16
  %31 = scalar.extui %30 : i16 to i32
  %32 = scalar.addi %23, %31 : i32
  func.return %32 : i32
}

func.def @text() -> (buffer, offset) {
  %35 = buffer.constant align(1) utf8("a\u0000b\u0000") : buffer
  %36 = index.constant 0 : offset
  func.return %35, %36 : buffer, offset
}

// ====
// Volatile wide initialization emits element observations, including both
// surrogate code units and the explicit terminator and trailing zero.
unsigned volatile_wide(unsigned position) {
  volatile char16_t observed[4] = u"\U0001F9F5";
  return observed[position & 3u];
}
// ----
