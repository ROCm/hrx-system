// RUN: verify
// Loom semantic handles have their own linking contracts and cannot masquerade
// as native C records merely because their facade is written in C++.
#include <loomcxx/buffer.h>
// ERROR@+1: LOWERING/059 "C ABI records require a named plain aggregate"
extern "C" void semantic_buffer(loom::type::buffer<unsigned> value) {}

// ====
// Overlapping no_unique_address fields have no independent physical C ABI slot.
struct Empty {};
struct Record { [[no_unique_address]] Empty empty; unsigned value; };
// ERROR@+1: LOWERING/059 "C ABI record fields require distinct named object storage"
extern "C" Record overlapping_record(Record value) { return value; }
