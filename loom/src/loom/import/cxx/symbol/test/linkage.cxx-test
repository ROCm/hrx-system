// RUN: pass canonicalize,cse,dce
// A provider exports its exact symbol and inline definition while retaining
// separate private identities for local helpers and template instantiations.
inline unsigned shared_inline(unsigned value) { return value * 3u + 1u; }
template <unsigned Bias>
constexpr unsigned shared_template(unsigned value) { return value * 2u + Bias; }
static unsigned local_adjust(unsigned value) { return value + 5u; }
[[loom::symbol("library.adjust")]] unsigned adjust(unsigned value) {
  return shared_inline(value) + shared_template<7u>(value) + local_adjust(value);
}
// ----
func.def public linkonce @shared_inline(%value: i32) -> (i32) {
  %2 = scalar.constant 3 : i32
  %3 = scalar.muli %value, %2 : i32
  %4 = scalar.constant 1 : i32
  %5 = scalar.addi %3, %4 : i32
  func.return %5 : i32
}

func.def public @library.adjust(%value: i32) -> (i32) {
  %8 = func.call pure @shared_inline(%value) : (i32) -> (i32)
  %9 = func.call pure @shared_template_7(%value) : (i32) -> (i32)
  %10 = scalar.addi %8, %9 : i32
  %11 = func.call pure @local_adjust(%value) : (i32) -> (i32)
  %12 = scalar.addi %10, %11 : i32
  func.return %12 : i32
}

func.def @shared_template_7(%value: i32) -> (i32) {
  %23 = scalar.constant 1 : i32
  %24 = scalar.shli %value, %23 : i32
  %17 = scalar.constant 7 : i32
  %18 = scalar.addi %24, %17 : i32
  func.return %18 : i32
}

func.def @local_adjust(%value: i32) -> (i32) {
  %21 = scalar.constant 5 : i32
  %22 = scalar.addi %value, %21 : i32
  func.return %22 : i32
}

// ====
// An independently imported caller uses the same external symbol and public
// inline contract, with its own local helper body and template instance.
inline unsigned shared_inline(unsigned value) { return value * 3u + 1u; }
template <unsigned Bias>
constexpr unsigned shared_template(unsigned value) { return value * 2u + Bias; }
[[loom::symbol("library.adjust")]] unsigned adjust(unsigned value);
static unsigned local_adjust(unsigned value) { return value + 11u; }
unsigned apply_adjustment(unsigned value) {
  return adjust(value) + shared_inline(value) + shared_template<7u>(value) +
         local_adjust(value);
}
// ----
func.def public linkonce @shared_inline(%value: i32) -> (i32) {
  %2 = scalar.constant 3 : i32
  %3 = scalar.muli %value, %2 : i32
  %4 = scalar.constant 1 : i32
  %5 = scalar.addi %3, %4 : i32
  func.return %5 : i32
}

func.def public @apply_adjustment(%value: i32) -> (i32) {
  %8 = func.call @library.adjust(%value) : (i32) -> (i32)
  %9 = func.call pure @shared_inline(%value) : (i32) -> (i32)
  %10 = scalar.addi %8, %9 : i32
  %11 = func.call pure @shared_template_7(%value) : (i32) -> (i32)
  %12 = scalar.addi %10, %11 : i32
  %13 = func.call pure @local_adjust(%value) : (i32) -> (i32)
  %14 = scalar.addi %12, %13 : i32
  func.return %14 : i32
}

func.def @shared_template_7(%value: i32) -> (i32) {
  %27 = scalar.constant 1 : i32
  %28 = scalar.shli %value, %27 : i32
  %19 = scalar.constant 7 : i32
  %20 = scalar.addi %28, %19 : i32
  func.return %20 : i32
}

func.def @local_adjust(%value: i32) -> (i32) {
  %23 = scalar.constant 11 : i32
  %24 = scalar.addi %value, %23 : i32
  func.return %24 : i32
}

func.decl @library.adjust(%25: i32) -> (i32)
