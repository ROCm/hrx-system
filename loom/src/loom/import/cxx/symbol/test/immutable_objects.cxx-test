// ====
// Repeated indexed reads share one aligned static payload. Constant-only and
// unused locals need no automatic storage or per-call initialization.
unsigned local_table(unsigned index) {
  alignas(64) static constexpr unsigned values[4] = {11, 22, 33, 44};
  return values[index & 3u] + values[(index + 1u) & 3u];
}
