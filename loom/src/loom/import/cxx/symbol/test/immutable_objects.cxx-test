// ====
// The same source name in disjoint scopes denotes distinct objects.
inline const unsigned* scoped_table(bool first) {
  if (first) {
    static constexpr unsigned table[2] = {7, 11};
    return table;
  } else {
    static constexpr unsigned table[2] = {13, 17};
    return table;
  }
}
unsigned local_scopes(bool first, unsigned index) {
  return scoped_table(first)[index & 1u];
}

