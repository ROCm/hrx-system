// RUN: verify
#include <loomcxx/kernel.h>

LOOM_TEMPLATE_DECL("test.value") unsigned value(unsigned input);

// ERROR@+1: LOWERING/059 "one unambiguous family function name"
[[loom::template_def(7)]] unsigned bad_family(unsigned input) { return input; }

// ====
#include <loomcxx/kernel.h>
unsigned ordinary(unsigned input);
// ERROR@+1: LOWERING/059 "requires a LOOM_TEMPLATE_DECL declaration"
LOOM_TEMPLATE_DEF(ordinary)
unsigned ordinary_provider(unsigned input) { return input; }

// ====
#include <loomcxx/kernel.h>
LOOM_TEMPLATE_DECL("test.value") unsigned value(unsigned input);
// ERROR@+1: LOWERING/059 "signature must exactly match"
LOOM_TEMPLATE_DEF(value)
int signed_provider(int input) { return input; }

// ====
#include <loomcxx/kernel.h>
LOOM_TEMPLATE_DECL("test.value") unsigned value(unsigned input);
// ERROR@+1: LOWERING/059 "require a function body"
LOOM_TEMPLATE_DEF(value)
unsigned declaration_only(unsigned input);

// ====
#include <loomcxx/kernel.h>
LOOM_TEMPLATE_DECL("test.first") unsigned first(unsigned input);
LOOM_TEMPLATE_DECL("test.second") unsigned second(unsigned input);
LOOM_TEMPLATE_DEF(first)
unsigned conflicting(unsigned input);
// ERROR@+1: LOWERING/059 "conflicting template families"
LOOM_TEMPLATE_DEF(second)
unsigned conflicting(unsigned input) { return input; }

// ====
#include <loomcxx/kernel.h>
LOOM_TEMPLATE_DECL("test.value") unsigned value(unsigned input);
// ERROR@+1: LOWERING/059 "one template definition binding"
[[loom::template_def(value), loom::template_def(value)]]
unsigned duplicate(unsigned input) { return input; }

// ====
#include <loomcxx/kernel.h>
// ERROR@+1: LOWERING/059 "priority requires a template definition"
[[loom::priority(4)]] unsigned priority_only(unsigned input) { return input; }

// ====
#include <loomcxx/kernel.h>
LOOM_TEMPLATE_DECL("test.value") unsigned value(unsigned input);
extern unsigned dynamic_priority;
// ERROR@+2: LOWERING/059 "i64 integer constant expression"
LOOM_TEMPLATE_DEF(value)
[[loom::priority(dynamic_priority)]]
unsigned invalid_priority(unsigned input) { return input; }

// ====
#include <loomcxx/kernel.h>
LOOM_TEMPLATE_DECL("test.value") unsigned value(unsigned input);
LOOM_TEMPLATE_DEF(value)
unsigned provider(unsigned input) { return input; }
unsigned caller(unsigned input) {
  // ERROR@+1: LOWERING/059 "cannot be selected or called directly"
  return provider(input);
}

// ====
#include <loomcxx/kernel.h>
LOOM_TEMPLATE_DECL("test.value") unsigned value(unsigned input);
// ERROR@+1: LOWERING/059 "require ordinary source functions"
LOOM_TEMPLATE_DEF(value)
[[loom::kernel]] void provider() {}

// ====
#include <loomcxx/kernel.h>
LOOM_TEMPLATE_DECL("test.value") unsigned value(unsigned input);
unsigned entry(unsigned input) {
  // ERROR@+1: LOWERING/059 "namespace-scope functions with a leading attribute"
  [[loom::template_def(value)]] unsigned local = input;
  return local;
}

// ====
#include <loomcxx/kernel.h>
LOOM_TEMPLATE_DECL("test.value") unsigned value(unsigned input);
LOOM_TEMPLATE_DEF(value)
[[loom::priority(2)]] unsigned conflicting_priority(unsigned input);
// ERROR@+2: LOWERING/059 "conflicting template priorities"
LOOM_TEMPLATE_DEF(value)
[[loom::priority(3)]] unsigned conflicting_priority(unsigned input) {
  return input;
}

// ====
#include <loomcxx/kernel.h>
LOOM_TEMPLATE_DECL("test.value") unsigned value(unsigned input);
// ERROR@+1: LOWERING/059 "calling convention must match"
LOOM_TEMPLATE_DEF(value)
LOOM_DEVICE unsigned device_provider(unsigned input) { return input; }

// ====
#include <loomcxx/kernel.h>
LOOM_TEMPLATE_DECL("test.loop_exit") unsigned loop_exit(unsigned input);
LOOM_TEMPLATE_DEF(loop_exit)
unsigned loop_exit_provider(unsigned input) {
  // ERROR@+1: LOWERING/059 "returns inside structured control require a runtime function or kernel body"
  while (input) return input;
  return 0;
}
