#include <loomcxx/template.h>
#include <loomcxx/pipeline.h>
namespace t = loom::type;
using Dynamic = t::tile<t::shape<t::dynamic, 4, t::dynamic>, float>;
using Fixed = t::tile<t::shape<2, 4, 8>, float>;
LOOM_TEMPLATE_DECL("input.classify") int classify(Dynamic value);
LOOM_TEMPLATE_DEF(classify)
int classify_fixed(Fixed value) { return 248; }
int entry(Fixed value) { return loom::template_apply<classify>(value); }

// ----
func.def public @entry(%value: tile<2x4x8xf32>) -> (i32) {
  %13 = scalar.constant 248 : i32
  func.return %13 : i32
}

