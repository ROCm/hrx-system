namespace t = loom::type;
using Fixed = t::view<t::shape<16>, const float>;
using Dynamic = t::view<t::shape<t::dynamic>, const float>;
LOOM_TEMPLATE_DECL("input.read") float read(Fixed value);
LOOM_TEMPLATE_DEF(read)
float read_dynamic(Dynamic value) { return loom::view::load(value, 15u); }
float entry(Fixed value) { return loom::template_apply<read>(value); }

// ----
func.def public @entry(%value: view<16xf32>) -> (f32) {
  %14 = index.constant 15 : index
  %12 = view.load %value[%14] : view<16xf32> -> f32
  func.return %12 : f32
}

