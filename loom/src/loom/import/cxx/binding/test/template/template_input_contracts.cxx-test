// ====
// RUN: pass select-templates{mode=final,rewrite=inline},canonicalize,symbol-dce
#include <loomcxx/template.h>
#include <loomcxx/vector.h>
namespace t = loom::type;
using Dynamic = t::vector<t::shape<t::dynamic>, float>;
using Fixed = float __attribute__((ext_vector_type(4)));
LOOM_TEMPLATE_DECL("input.reduce") float reduce(Dynamic value);
LOOM_TEMPLATE_DEF(reduce)
float reduce_four(Fixed value) { return value[0] + value[3]; }
float entry(Fixed value) { return loom::template_apply<reduce>(value); }

// ----
func.def public @entry(%value: vector<4xf32>) -> (f32) {
  %19 = vector.extract %value[0] : vector<4xf32> -> f32
  %18 = vector.extract %value[3] : vector<4xf32> -> f32
  %16 = scalar.addf %19, %18 : f32
  func.return %16 : f32
}

