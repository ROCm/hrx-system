// RUN: pass select-templates{mode=final,rewrite=inline},canonicalize,symbol-dce
#include <loomcxx/template.h>
#include <loomcxx/view.h>
namespace t = loom::type;
using Family = t::view<t::shape<t::dynamic, 8, t::dynamic>, const float>;
using Fixed = t::view<t::shape<4, 8, 6>, const float>;
LOOM_TEMPLATE_DECL("input.read") float read(Family value);
LOOM_TEMPLATE_DEF(read)
float read_fixed(Fixed value) { return loom::view::load(value, 3u, 7u, 5u); }
float entry(Fixed value) { return loom::template_apply<read>(value); }

// ----
func.def public @entry(%value: view<4x8x6xf32>) -> (f32) {
  %26 = index.constant 3 : index
  %25 = index.constant 7 : index
  %24 = index.constant 5 : index
  %22 = view.load %value[%26, %25, %24] : view<4x8x6xf32> -> f32
  func.return %22 : f32
}

