// RUN: verify
// ERROR@+1: LOWERING/059 "check.expect.approximate requires" "scoped enum"
[[loom::op("check.expect.approximate")]] void wrong_signature(float, float, float, float, int);

// ====
enum class policy { same };
// ERROR@+1: LOWERING/059 "typed expectation requires two floating-point scalars or tensors"
[[loom::op("check.expect.approximate")]] void integer_operands(int, int, double, double, policy);

// ====
#include <loomcxx/check.h>
LOOM_CHECK_CASE(integer_tensors) {
  const auto values = loom::check::fill<2, unsigned>(1u);
  // ERROR@+1: LOWERING/059 "typed expectation requires two floating-point scalars or tensors"
  loom::check::expect_approximate(values, values, 0.0, 0.0);
}

// ====
#include <loomcxx/check.h>
double runtime_tolerance() { return 0.125; }
LOOM_CHECK_CASE(runtime_attribute) {
  const auto tolerance = runtime_tolerance();
  // ERROR@+1: LOWERING/059 "check attributes require pure scalar constants"
  loom::check::expect_approximate(1.0f, 1.0f, tolerance, 0.0);
}

// ====
#include <loomcxx/check.h>
LOOM_CHECK_CASE(negative_absolute) {
  // ERROR@+1: LOWERING/059 "check tolerances must be finite and non-negative"
  loom::check::expect_approximate(1.0f, 1.0f, -0.125, 0.0);
}

// ====
#include <loomcxx/check.h>
LOOM_CHECK_CASE(negative_relative) {
  // ERROR@+1: LOWERING/059 "check tolerances must be finite and non-negative"
  loom::check::expect_approximate(1.0f, 1.0f, 0.0, -0.125);
}

// ====
#include <loomcxx/check.h>
LOOM_CHECK_CASE(infinite_tolerance) {
  // ERROR@+1: LOWERING/059 "check tolerances must be finite and non-negative"
  loom::check::expect_approximate(1.0f, 1.0f, 1.7976931348623157e308 * 2.0, 0.0);
}

// ====
#include <loomcxx/check.h>
float identity(float value) { return value; }
LOOM_CHECK_CASE(invocation_after_observation) {
  loom::check::expect_approximate(1.0f, 1.0f, 0.0, 0.0);
  // ERROR@+1: LOWERING/059 "check expectations must be terminal"
  identity(1.0f);
}
