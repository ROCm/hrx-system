// RUN: roundtrip
#include <loomcxx/check.h>
#include <loomcxx/view.h>

using U4 = unsigned __attribute__((vector_size(16)));
using F4 = float __attribute__((ext_vector_type(4)));

loom::type::index vector_count(loom::check::ordinal trial) {
  return loom::index::cast((unsigned)trial + 2u);
}

[[loom::kernel, loom::workgroup_size(1, 1, 1),
  loom::workgroup_count(1, 1, 1)]] void
copy_vectors(const U4* input, U4* output) {
  output[0] = input[0];
  output[1] = input[1];
}

void copy_vectors_oracle(loom::type::buffer<unsigned> input,
                         loom::type::buffer<unsigned> output) {
  auto input_lanes =
      loom::buffer::view<8>(input, {}, loom::encoding::layout::dense<1>());
  auto output_lanes =
      loom::buffer::view<8>(output, {}, loom::encoding::layout::dense<1>());
  for (unsigned lane = 0; lane < 8; ++lane) {
    loom::view::store(loom::view::load(input_lanes, lane), output_lanes, lane);
  }
}

LOOM_CHECK_SCENARIO(vector_tensor_objects) {
  loom::check::trial<1>(
      [](loom::check::ordinal trial, loom::check::entropy entropy) {
        const auto count = loom::check::generate<vector_count>(trial);
        const auto input = loom::check::iota<2, U4>(1u, 1u);
        const auto dynamic = loom::check::fill<U4>(count, 9u);
        const auto floating = loom::check::fill<2, F4>(1.5f);
        const auto storage = loom::check::fill<4, U4>(-123u);
        const auto output = loom::check::slice<2>(storage, 1);
        loom::check::compare<copy_vectors, copy_vectors_oracle>(
            input, output, [&] {
              loom::check::expect_bitwise(input, input);
              loom::check::expect_bitwise(dynamic, dynamic);
              loom::check::expect_approximate(floating, floating, 0.0, 0.0);
              loom::check::expect_bitwise(storage, storage);
            });
      });
}

// ----
func.def public @vector_count(%trial: index) -> (index) {
  %2 = index.cast %trial : index to i64
  %3 = scalar.trunci %2 : i64 to i32
  %4 = scalar.constant 2 : i32
  %5 = scalar.addi %3, %4 : i32
  %6 = scalar.extui %5 : i32 to i64
  %7 = index.cast %6 : i64 to index
  func.return %7 : index
}

kernel.def @copy_vectors() {
  %10 = index.constant 1 : index
  %11 = index.constant 1 : index
  %12 = index.constant 1 : index
  %13 = index.constant 1 : index
  %14 = index.constant 1 : index
  %15 = index.constant 1 : index
  kernel.launch.config workgroups(%10, %11, %12) workgroup_size(%13, %14, %15) : index
} launch(%input: buffer, %output: buffer) {
  %input_byte_offset = index.constant 0 : offset
  %output_byte_offset = index.constant 0 : offset
  %18 = scalar.constant 0 : i32
  %19 = scalar.extsi %18 : i32 to i64
  %20 = scalar.constant 16 : i64
  %21 = scalar.muli %19, %20 : i64
  %22 = index.cast %input_byte_offset : offset to i64
  %23 = scalar.addi %22, %21 : i64
  %24 = scalar.assume %23 [range(%23, 0, 9223372036854775807)] : i64
  %25 = index.cast %24 : i64 to offset
  %26 = buffer.view %input[%25] : buffer -> view<4xi32>
  %27 = vector.load %26[0] : view<4xi32> -> vector<4xi32>
  %28 = scalar.constant 0 : i32
  %29 = scalar.extsi %28 : i32 to i64
  %30 = scalar.constant 16 : i64
  %31 = scalar.muli %29, %30 : i64
  %32 = index.cast %output_byte_offset : offset to i64
  %33 = scalar.addi %32, %31 : i64
  %34 = scalar.assume %33 [range(%33, 0, 9223372036854775807)] : i64
  %35 = index.cast %34 : i64 to offset
  %36 = buffer.view %output[%35] : buffer -> view<4xi32>
  vector.store %27, %36[0] : vector<4xi32>, view<4xi32>
  %37 = scalar.constant 1 : i32
  %38 = scalar.extsi %37 : i32 to i64
  %39 = scalar.constant 16 : i64
  %40 = scalar.muli %38, %39 : i64
  %41 = index.cast %input_byte_offset : offset to i64
  %42 = scalar.addi %41, %40 : i64
  %43 = scalar.assume %42 [range(%42, 0, 9223372036854775807)] : i64
  %44 = index.cast %43 : i64 to offset
  %45 = buffer.view %input[%44] : buffer -> view<4xi32>
  %46 = vector.load %45[0] : view<4xi32> -> vector<4xi32>
  %47 = scalar.constant 1 : i32
  %48 = scalar.extsi %47 : i32 to i64
  %49 = scalar.constant 16 : i64
  %50 = scalar.muli %48, %49 : i64
  %51 = index.cast %output_byte_offset : offset to i64
  %52 = scalar.addi %51, %50 : i64
  %53 = scalar.assume %52 [range(%52, 0, 9223372036854775807)] : i64
  %54 = index.cast %53 : i64 to offset
  %55 = buffer.view %output[%54] : buffer -> view<4xi32>
  vector.store %46, %55[0] : vector<4xi32>, view<4xi32>
  kernel.return
}

func.def public @copy_vectors_oracle(%input: buffer, %output: buffer) {
  %input_lanes_layout = encoding.layout.dense : encoding<layout>
  %59 = index.constant 0 : offset
  %input_lanes = buffer.view %input[%59] : buffer -> view<8xi32, %input_lanes_layout>
  %output_lanes_layout = encoding.layout.dense : encoding<layout>
  %62 = index.constant 0 : offset
  %output_lanes = buffer.view %output[%62] : buffer -> view<8xi32, %output_lanes_layout>
  %lane = scalar.constant 0 : i32
  %65 = index.cast %lane : i32 to offset
  %66 = scalar.constant 8 : i32
  %67 = index.cast %66 : i32 to offset
  %68 = index.constant 1 : offset
  scf.for %lane = [%65 to %67 step %68] {
    %70 = index.cast %lane : offset to i32
    %71 = scalar.extui %70 : i32 to i64
    %72 = index.cast %71 : i64 to index
    %73 = view.load %input_lanes[%72] : view<8xi32, %input_lanes_layout> -> i32
    %74 = scalar.extui %70 : i32 to i64
    %75 = index.cast %74 : i64 to index
    view.store %73, %output_lanes[%75] : i32, view<8xi32, %output_lanes_layout>
  }
  func.return
}

check.scenario public @vector_tensor_objects {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %count = check.generate<@vector_count>(%trial) : (index) -> (index)
    %input = check.generate.iota offset(1) step(1) : tensor<2x4xi32>
    %dynamic = check.generate.fill value(9) : tensor<[%count]x4xi32>
    %floating = check.generate.fill value(1.5) : tensor<2x4xf32>
    %storage = check.generate.fill value(-123) : tensor<4x4xi32>
    %output = check.tensor.view %storage offset(16) : tensor<4x4xi32> -> tensor<2x4xi32>
    check.compare<@copy_vectors, @copy_vectors_oracle>(%input, %output) : (tensor<2x4xi32>, tensor<2x4xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<2x4xi32>
      check.expect.bitwise actual(%dynamic) expected(%dynamic) : tensor<[%count]x4xi32>
      check.expect.approximate actual(%floating) expected(%floating) atol(0.0) rtol(0.0) nan(same) : tensor<2x4xf32>, tensor<2x4xf32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<4x4xi32>
    }
  }
  check.return
}
