// RUN: verify
#include <loomcxx/check.h>
#include <loomcxx/buffer.h>

using U4 = unsigned __attribute__((vector_size(16)));

void consume(loom::type::buffer<U4> value) {}

LOOM_CHECK_SCENARIO(vector_fill_payload) {
  loom::check::trial<1>(
      [](loom::check::ordinal trial, loom::check::entropy entropy) {
        // ERROR@+1: LOWERING/059 "check.generate.fill payload must match its tensor scalar lane type"
        const auto output = loom::check::fill<2, U4>(U4{1u});
        loom::check::invoke<consume>(output);
      });
}

// ====
#include <loomcxx/check.h>

using U4 = unsigned __attribute__((vector_size(16)));

[[loom::kernel, loom::workgroup_size(1, 1, 1),
  loom::workgroup_count(1, 1, 1)]] void
consume_scalar(unsigned* value) {}

LOOM_CHECK_SCENARIO(vector_object_mismatch) {
  loom::check::trial<1>(
      [](loom::check::ordinal trial, loom::check::entropy entropy) {
        const auto output = loom::check::fill<2, U4>(1u);
        // ERROR@+1: LOWERING/059 "check tensor element type must match the subject buffer element type"
        loom::check::invoke<consume_scalar>(output);
      });
}

// ====
#include <loomcxx/check.h>

using F3 = float __attribute__((ext_vector_type(3)));

LOOM_CHECK_SCENARIO(padded_vector_tensor) {
  loom::check::trial<1>(
      [](loom::check::ordinal trial, loom::check::entropy entropy) {
        // ERROR@+1: LOWERING/059 "tensor elements require vectors without object padding"
        const auto output = loom::check::fill<2, F3>(0.0f);
      });
}
