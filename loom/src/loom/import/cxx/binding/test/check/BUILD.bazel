load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")
load("//loom/build_tools/bazel:loom_check.bzl", "loom_check_test_suite")

package(
    default_visibility = ["//visibility:private"],
    licenses = ["notice"],
)

loom_check_test_suite(
    name = "compiler_test",
    srcs = [
        "check.cxx-test",
        "check_approximate.cxx-test",
        "check_approximate_invalid.cxx-test",
        "check_records.cxx-test",
        "check_resources.cxx-test",
        "check_scenarios.cxx-test",
        "check_scenarios_invalid.cxx-test",
        "check_typed_expectations.cxx-test",
        "check_typed_expectations_invalid.cxx-test",
        "generated_shapes.cxx-test",
        "header_cases.cxx-test",
        "vector_tensors.cxx-test",
        "vector_tensors_invalid.cxx-test",
    ],
    data = ["header_cases.h"],
    target_compatible_with = loom_config_compatible_with(["//loom/config/import:cxx"]),
)
