// RUN: roundtrip
#include <loomcxx/check.h>
LOOM_CHECK_CASE(typed_metadata) {
  loom::check::require("custom", "enabled", true, "rate", 0.5, "mode", "one");
}
// ----
check.case public @typed_metadata {
  check.requires<custom> {enabled = true, mode = "one", rate = 0.5}
  check.return
}

// ====
// RUN: roundtrip
// Nested slices retain the same storage identity and compose their byte origins.
#include <loomcxx/check.h>
#include <loomcxx/kernel.h>

#ifndef CHECK_ALIAS_EXPECTED
#define CHECK_ALIAS_EXPECTED 17u
#endif

[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void alias_update(unsigned* left, unsigned* right) {
  left[1] = 13;
  right[0] += 4;
}

LOOM_CHECK_CASE(alias_values) {
  const auto storage = loom::check::fill<5, unsigned>(37u);
  const auto copy = storage;
  const auto left = loom::check::slice<3>(copy, 1);
  const auto right = loom::check::slice<2>(left, 1);
  loom::check::launch<alias_update>(left, right);
  loom::check::expect_bitwise(loom::check::slice<2>(storage, 0),
                              loom::check::fill<2, unsigned>(37u));
  loom::check::expect_bitwise(
      loom::check::slice<1>(storage, 2),
      loom::check::fill<1, unsigned>(CHECK_ALIAS_EXPECTED));
  loom::check::expect_bitwise(loom::check::slice<2>(storage, 3),
                              loom::check::fill<2, unsigned>(37u));
}

LOOM_CHECK_BENCHMARK(alias_values_benchmark, alias_values);

// ----
kernel.def @alias_update() {
  %2 = index.constant 1 : index
  %3 = index.constant 1 : index
  %4 = index.constant 1 : index
  %5 = index.constant 1 : index
  %6 = index.constant 1 : index
  %7 = index.constant 1 : index
  kernel.launch.config workgroups(%2, %3, %4) workgroup_size(%5, %6, %7) : index
} launch(%left: buffer, %right: buffer) {
  %left_byte_offset = index.constant 0 : offset
  %right_byte_offset = index.constant 0 : offset
  %10 = scalar.constant 13 : i32
  %11 = scalar.constant 1 : i32
  %12 = scalar.extsi %11 : i32 to i64
  %13 = scalar.constant 4 : i64
  %14 = scalar.muli %12, %13 : i64
  %15 = index.cast %left_byte_offset : offset to i64
  %16 = scalar.addi %15, %14 : i64
  %17 = scalar.assume %16 [range(%16, 0, 9223372036854775807)] : i64
  %18 = index.cast %17 : i64 to offset
  %19 = buffer.view %left[%18] : buffer -> view<1xi32>
  view.store<root_in_bounds> %10, %19[0] : i32, view<1xi32>
  %20 = scalar.constant 4 : i32
  %21 = scalar.constant 0 : i32
  %22 = scalar.extsi %21 : i32 to i64
  %23 = scalar.constant 4 : i64
  %24 = scalar.muli %22, %23 : i64
  %25 = index.cast %right_byte_offset : offset to i64
  %26 = scalar.addi %25, %24 : i64
  %27 = scalar.assume %26 [range(%26, 0, 9223372036854775807)] : i64
  %28 = index.cast %27 : i64 to offset
  %29 = buffer.view %right[%28] : buffer -> view<1xi32>
  %30 = view.load<root_in_bounds> %29[0] : view<1xi32> -> i32
  %31 = scalar.addi %30, %20 : i32
  view.store<root_in_bounds> %31, %29[0] : i32, view<1xi32>
  kernel.return
}

check.case public @alias_values {
  %storage = check.generate.fill value(37) : tensor<5xi32>
  %left = check.tensor.view %storage offset(4) : tensor<5xi32> -> tensor<3xi32>
  %right = check.tensor.view %left offset(4) : tensor<3xi32> -> tensor<2xi32>
  kernel.launch @alias_update(%left, %right) : (tensor<3xi32>, tensor<2xi32>)
  %35 = check.tensor.view %storage offset(0) : tensor<5xi32> -> tensor<2xi32>
  %36 = check.generate.fill value(37) : tensor<2xi32>
  check.expect.bitwise actual(%35) expected(%36) : tensor<2xi32>
  %37 = check.tensor.view %storage offset(8) : tensor<5xi32> -> tensor<1xi32>
  %38 = check.generate.fill value(17) : tensor<1xi32>
  check.expect.bitwise actual(%37) expected(%38) : tensor<1xi32>
  %39 = check.tensor.view %storage offset(12) : tensor<5xi32> -> tensor<2xi32>
  %40 = check.generate.fill value(37) : tensor<2xi32>
  check.expect.bitwise actual(%39) expected(%40) : tensor<2xi32>
  check.return
}

check.benchmark<@alias_values> @alias_values_benchmark
