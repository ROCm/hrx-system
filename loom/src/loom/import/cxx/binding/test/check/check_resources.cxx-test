// RUN: verify
#include <loomcxx/check.h>
void ordinary() {
  // ERROR@+1: LOWERING/059 "check declarations cannot be called from ordinary functions"
  const auto storage = loom::check::fill<1, unsigned>(0u);
}

// ====
// RUN: verify
#include <loomcxx/check.h>
LOOM_CHECK_CASE(boolean_elements) {
  // ERROR@+1: LOWERING/059 "tensor elements require unqualified non-boolean scalar or vector types"
  const auto storage = loom::check::fill<1, bool>(true);
}

// ====
// RUN: verify
#include <loomcxx/check.h>
LOOM_CHECK_CASE(qualified_elements) {
  // ERROR@+1: LOWERING/059 "tensor elements require unqualified non-boolean scalar or vector types"
  const auto storage = loom::check::fill<1, const unsigned>(7u);
}

// ====
// RUN: verify
#include <loomcxx/check.h>
LOOM_CHECK_CASE(overflowing_byte_length) {
  // ERROR@+1: LOWERING/059 "tensor extent has an unrepresentable byte length"
  const auto storage = loom::check::fill<0x2000000000000000ULL, unsigned long long>(7ULL);
}

