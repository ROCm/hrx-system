// RUN: verify
#include <loomcxx/check.h>
LOOM_CHECK_CASE(metadata_name) {
  // ERROR@+1: LOWERING/059 "check metadata requires string names and scalar or string values"
  loom::check::require("provider", 1, 2);
}

// ====
// RUN: verify
#include <loomcxx/check.h>
const char* provider_name();
LOOM_CHECK_CASE(metadata_provider) {
  // ERROR@+1: LOWERING/059 "check attributes require a string literal"
  loom::check::require(provider_name(), "count", 0);
}

