// RUN: roundtrip
#include <loomcxx/check.h>
#include <loomcxx/kernel.h>
[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void update(unsigned* output, unsigned value) { output[0] = value; }
LOOM_CHECK_CASE(resource_values) {
  loom::check::require("sample.device", "feature", "vector_math");
  const auto storage = loom::check::fill<4, unsigned>(37u);
  const auto alias = storage;
  const auto selected = loom::check::slice<2>(alias, 1);
  loom::check::launch<update>(selected, 13u);
  loom::check::expect_bitwise(loom::check::slice<1>(storage, 1),
                            loom::check::fill<1, unsigned>(13u));
}
LOOM_CHECK_BENCHMARK(resource_benchmark, resource_values);
// ----
kernel.def @update() {
  %2 = index.constant 1 : index
  %3 = index.constant 1 : index
  %4 = index.constant 1 : index
  %5 = index.constant 1 : index
  %6 = index.constant 1 : index
  %7 = index.constant 1 : index
  kernel.launch.config workgroups(%2, %3, %4) workgroup_size(%5, %6, %7) : index
} launch(%output: buffer, %value: i32) {
  %output_byte_offset = index.constant 0 : offset
  %9 = scalar.constant 0 : i32
  %10 = scalar.extsi %9 : i32 to i64
  %11 = scalar.constant 4 : i64
  %12 = scalar.muli %10, %11 : i64
  %13 = index.cast %output_byte_offset : offset to i64
  %14 = scalar.addi %13, %12 : i64
  %15 = scalar.assume %14 [range(%14, 0, 9223372036854775807)] : i64
  %16 = index.cast %15 : i64 to offset
  %17 = buffer.view %output[%16] : buffer -> view<1xi32>
  view.store<root_in_bounds> %value, %17[0] : i32, view<1xi32>
  kernel.return
}

check.case public @resource_values {
  check.requires<sample.device> {feature = "vector_math"}
  %storage = check.generate.fill value(37) : tensor<4xi32>
  %selected = check.tensor.view %storage offset(4) : tensor<4xi32> -> tensor<2xi32>
  %20 = check.literal value(13) : i32
  kernel.launch @update(%selected, %20) : (tensor<2xi32>, i32)
  %21 = check.tensor.view %storage offset(4) : tensor<4xi32> -> tensor<1xi32>
  %22 = check.generate.fill value(13) : tensor<1xi32>
  check.expect.bitwise actual(%21) expected(%22) : tensor<1xi32>
  check.return
}

check.benchmark<@resource_values> @resource_benchmark

// ====
// RUN: verify
#include <loomcxx/check.h>
unsigned runtime_value() { return 7; }
LOOM_CHECK_CASE(runtime_fill) {
  // ERROR@+1: LOWERING/059 "check attributes require pure scalar constants"
  const auto storage = loom::check::fill<1, unsigned>(runtime_value());
}

// ====
// RUN: verify
#include <loomcxx/check.h>
unsigned runtime_value() { return 0; }
LOOM_CHECK_CASE(runtime_offset) {
  const auto storage = loom::check::fill<4, unsigned>(7u);
  // ERROR@+1: LOWERING/059 "check tensor slice must select an in-bounds constant element range"
  const auto selected = loom::check::slice<1>(storage, runtime_value());
}

// ====
// RUN: verify
#include <loomcxx/check.h>
LOOM_CHECK_CASE(past_end) {
  const auto storage = loom::check::fill<4, unsigned>(7u);
  // ERROR@+1: LOWERING/059 "check tensor slice must select an in-bounds constant element range"
  const auto selected = loom::check::slice<2>(storage, 3);
}

// ====
// RUN: verify
#include <loomcxx/check.h>
LOOM_CHECK_CASE(negative_offset) {
  const auto storage = loom::check::fill<4, unsigned>(7u);
  // ERROR@+1: LOWERING/059 "check tensor slice must select an in-bounds constant element range"
  const auto selected = loom::check::slice<1>(storage, -1);
}

// ====
// RUN: verify
#include <loomcxx/check.h>
void ordinary(unsigned* output) { output[0] = 7; }
LOOM_CHECK_CASE(not_a_kernel) {
  const auto storage = loom::check::fill<1, unsigned>(0u);
  // ERROR@+1: LOWERING/059 "kernel.launch requires a kernel or kernel-scoped pipeline as its first template argument"
  loom::check::launch<ordinary>(storage);
}

// ====
// RUN: verify
#include <loomcxx/check.h>
#include <loomcxx/kernel.h>
[[loom::kernel]] void update(unsigned* output, unsigned value) { output[0] = value; }
LOOM_CHECK_CASE(wrong_argument_count) {
  const auto storage = loom::check::fill<1, unsigned>(0u);
  // ERROR@+1: LOWERING/059 "kernel.launch arguments must match the kernel signature"
  loom::check::launch<update>(storage);
}

// ====
// RUN: verify
#include <loomcxx/check.h>
#include <loomcxx/kernel.h>
[[loom::kernel]] void update(unsigned* output, unsigned value) { output[0] = value; }
LOOM_CHECK_CASE(wrong_scalar_type) {
  const auto storage = loom::check::fill<1, unsigned>(0u);
  // ERROR@+1: LOWERING/059 "kernel.launch scalar arguments must match the kernel parameter types"
  loom::check::launch<update>(storage, 7.0f);
}

// ====
// RUN: verify
#include <loomcxx/check.h>
#include <loomcxx/kernel.h>
[[loom::kernel]] void update(unsigned* output) { output[0] = 7; }
LOOM_CHECK_CASE(late_launch) {
  const auto storage = loom::check::fill<1, unsigned>(0u);
  loom::check::expect_bitwise(storage, storage);
  // ERROR@+1: LOWERING/059 "check expectations must be terminal"
  loom::check::launch<update>(storage);
}

