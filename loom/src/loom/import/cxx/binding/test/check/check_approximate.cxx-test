// RUN: roundtrip
#include <loomcxx/check.h>

static float increment(float value) { return value + 0.125f; }
static double identity(double value) { return value; }
static float from_bits(unsigned bits) {
  return __builtin_bit_cast(float, bits);
}

LOOM_CHECK_CASE(absolute_error) {
  const auto actual = increment(1.0f);
  loom::check::expect_approximate(actual, 1.0f, 1.0 / 8.0, 0.0);
  loom::check::expect_approximate(actual, 1.0f, 0.125, 0.0,
                                  loom::check::nan_policy::different);
}

LOOM_CHECK_CASE(relative_error) {
  const auto actual = identity(2.125);
  loom::check::expect_approximate(actual, 2.0, 0.0, 1.0 / 16.0);
}

LOOM_CHECK_CASE(exceptional_values) {
  const auto actual_nan = from_bits(0x7fc00001u);
  const auto expected_nan = from_bits(0x7fc00002u);
  const auto infinity = from_bits(0x7f800000u);
  loom::check::expect_approximate(actual_nan, expected_nan, 0.0, 0.0,
                                  loom::check::nan_policy::same);
  loom::check::expect_approximate(infinity, infinity, 0.0, 0.0,
                                  loom::check::nan_policy::different);
}

// ----
check.case public @absolute_error {
  %0 = check.literal value(1.0) : f32
  %actual = func.call @increment(%0) : (f32) -> (f32)
  %2 = check.literal value(1.0) : f32
  check.expect.approximate actual(%actual) expected(%2) atol(0.125) rtol(0.0) nan(same) : f32, f32
  %3 = check.literal value(1.0) : f32
  check.expect.approximate actual(%actual) expected(%3) atol(0.125) rtol(0.0) nan(different) : f32, f32
  check.return
}

check.case public @relative_error {
  %4 = check.literal value(2.125) : f64
  %actual = func.call @identity(%4) : (f64) -> (f64)
  %6 = check.literal value(2.0) : f64
  check.expect.approximate actual(%actual) expected(%6) atol(0.0) rtol(0.0625) nan(same) : f64, f64
  check.return
}

check.case public @exceptional_values {
  %7 = check.literal value(2143289345) : i32
  %actual_nan = func.call @from_bits(%7) : (i32) -> (f32)
  %9 = check.literal value(2143289346) : i32
  %expected_nan = func.call @from_bits(%9) : (i32) -> (f32)
  %11 = check.literal value(2139095040) : i32
  %infinity = func.call @from_bits(%11) : (i32) -> (f32)
  check.expect.approximate actual(%actual_nan) expected(%expected_nan) atol(0.0) rtol(0.0) nan(same) : f32, f32
  check.expect.approximate actual(%infinity) expected(%infinity) atol(0.0) rtol(0.0) nan(different) : f32, f32
  check.return
}

func.def @increment(%value: f32) -> (f32) {
  %15 = scalar.constant 0.125 : f32
  %16 = scalar.addf %value, %15 : f32
  func.return %16 : f32
}

func.def @identity(%value: f64) -> (f64) {
  func.return %value : f64
}

func.def @from_bits(%bits: i32) -> (f32) {
  %21 = scalar.bitcast %bits : i32 to f32
  func.return %21 : f32
}

// ====
#include <loomcxx/check.h>
LOOM_CHECK_CASE(tensor_error) {
  const auto actual = loom::check::fill<4, float>(3.125f);
  const auto expected = loom::check::fill<4, float>(3.0f);
  loom::check::expect_approximate(actual, expected, 0.125, 0.0);
}

// ----
check.case public @tensor_error {
  %actual = check.generate.fill value(3.125) : tensor<4xf32>
  %expected = check.generate.fill value(3.0) : tensor<4xf32>
  check.expect.approximate actual(%actual) expected(%expected) atol(0.125) rtol(0.0) nan(same) : tensor<4xf32>, tensor<4xf32>
  check.return
}
