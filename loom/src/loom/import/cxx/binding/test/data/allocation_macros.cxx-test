// RUN: pass canonicalize,cse,dce
// System headers may define this function-like macro before either facade.
#define alloca(size) __builtin_alloca(size)
#include <loomcxx/view.h>
#include <loomcxx/buffer.h>

#ifndef alloca
#error Allocation facades must preserve the caller's macro.
#endif

unsigned roundtrip(unsigned value) {
  using Values = loom::type::view<loom::type::shape<4>, unsigned>;
  auto values = loom::view::alloca<Values>();
  loom::view::store(value, values, 1);
  auto* elements =
      loom::buffer::alloca<unsigned, loom::memory_space::private_>(4);
  elements[0] = loom::view::load(values, 1);
  return elements[0];
}

// ----
func.def public @roundtrip(%value: i32) -> (i32) {
  %values = view.alloca<private> : view<4xi32>
  %38 = index.constant 1 : index
  view.store<type_disjoint> %value, %values[%38] : i32, view<4xi32>
  %37 = index.constant 16 : offset
  %elements = buffer.alloca<private> align(4) %37 : buffer
  %14 = view.load<type_disjoint> %values[%38] : view<4xi32> -> i32
  %35 = index.constant 0 : offset
  %23 = buffer.view %elements[%35] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %14, %23[0] : i32, view<1xi32>
  %33 = view.load<root_in_bounds|type_disjoint> %23[0] : view<1xi32> -> i32
  func.return %33 : i32
}

// ====
// Include buffer first and verify that the macro still expands after inclusion.
#define alloca(size) ((size) + 7)
#include <loomcxx/buffer.h>
#include <loomcxx/view.h>
static_assert(alloca(8) == 15);

unsigned char bytes(loom::type::offset count, unsigned char value) {
  auto* storage = loom::buffer::alloca<loom::memory_space::private_>(count);
  storage[0] = value;
  return storage[0];
}

// ----
func.def public @bytes(%count: offset, %value: i8) -> (i8) {
  %storage = buffer.alloca<private> align(1) %count : buffer
  %25 = index.constant 0 : offset
  %13 = buffer.view %storage[%25] : buffer -> view<1xi8>
  view.store<root_in_bounds> %value, %13[0] : i8, view<1xi8>
  %23 = view.load<root_in_bounds> %13[0] : view<1xi8> -> i8
  func.return %23 : i8
}

// ====
// A macro introduced after the headers leaves the same template calls usable.
#include <loomcxx/view.h>
#include <loomcxx/buffer.h>
#define alloca(size) __builtin_alloca(size)

unsigned roundtrip(unsigned value) {
  using Values = loom::type::view<loom::type::shape<4>, unsigned>;
  auto values = loom::view::alloca<Values>();
  loom::view::store(value, values, 1);
  auto* elements =
      loom::buffer::alloca<unsigned, loom::memory_space::private_>(4);
  elements[0] = loom::view::load(values, 1);
  return elements[0];
}

// ----
func.def public @roundtrip(%value: i32) -> (i32) {
  %values = view.alloca<private> : view<4xi32>
  %38 = index.constant 1 : index
  view.store<type_disjoint> %value, %values[%38] : i32, view<4xi32>
  %37 = index.constant 16 : offset
  %elements = buffer.alloca<private> align(4) %37 : buffer
  %14 = view.load<type_disjoint> %values[%38] : view<4xi32> -> i32
  %35 = index.constant 0 : offset
  %23 = buffer.view %elements[%35] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %14, %23[0] : i32, view<1xi32>
  %33 = view.load<root_in_bounds|type_disjoint> %23[0] : view<1xi32> -> i32
  func.return %33 : i32
}
