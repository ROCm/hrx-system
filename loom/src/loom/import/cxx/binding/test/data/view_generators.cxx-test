// RUN: pass canonicalize,cse,dce
// A generated value is stored at its own loop coordinate.
#include <loomcxx/check.h>
#include <loomcxx/view.h>
unsigned volatile_input_value(unsigned position) {
  return position * 0x10203041u + 0x7fffff00u;
}

void volatile_input(loom::type::buffer<unsigned> input) {
  auto values =
      loom::buffer::view<64>(input, {}, loom::encoding::layout::dense<1>());
  for (unsigned position = 0; position < 64u; ++position) {
    loom::view::store(volatile_input_value(position), values, position);
  }
}

// ----
func.def public @volatile_input_value(%position: i32) -> (i32) {
  %2 = scalar.constant 270544961 : i32
  %3 = scalar.muli %position, %2 : i32
  %4 = scalar.constant 2147483392 : i32
  %5 = scalar.addi %3, %4 : i32
  func.return %5 : i32
}

func.def public @volatile_input(%input: buffer) {
  %8 = index.constant 0 : offset
  %values = buffer.view %input[%8] : buffer -> view<64xi32>
  %20 = index.constant 64 : offset
  %14 = index.constant 1 : offset
  scf.for %position = [%8 to %20 step %14] {
    %16 = index.cast %position : offset to i32
    %17 = func.call pure @volatile_input_value(%16) : (i32) -> (i32)
    %18 = scalar.extui %16 : i32 to i64
    %19 = index.cast %18 : i64 to index
    view.store %17, %values[%19] : i32, view<64xi32>
  }
  func.return
}

// ====
// RUN: pass canonicalize,cse,dce
// Ordinal-selected constants flow through a helper into a typed view.
#include <loomcxx/check.h>
#include <loomcxx/view.h>
unsigned volatile_parameter_value(loom::check::ordinal trial) {
  if (trial == 0) {
    return 0u;
  }
  if (trial == 1) {
    return 37u;
  }
  if (trial == 2) {
    return (unsigned)-128;
  }
  return 0x7fffffffu;
}

void volatile_scalar_input(loom::type::buffer<unsigned> input,
                           loom::check::ordinal trial) {
  auto value =
      loom::buffer::view<1>(input, {}, loom::encoding::layout::dense<1>());
  loom::view::store(volatile_parameter_value(trial), value, 0);
}

// ----
func.def public @volatile_parameter_value(%trial: index) -> (i32) {
  %2 = index.cast %trial : index to i64
  %34 = scalar.constant 0 : i64
  %5 = scalar.cmpi eq, %2, %34 : i64
  %6 = scf.if %5 -> (i32) {
    %7 = scalar.constant 0 : i32
    scf.yield %7 : i32
  } else {
    %33 = scalar.constant 1 : i64
    %11 = scalar.cmpi eq, %2, %33 : i64
    %12 = scf.if %11 -> (i32) {
      %13 = scalar.constant 37 : i32
      scf.yield %13 : i32
    } else {
      %32 = scalar.constant 2 : i64
      %17 = scalar.cmpi eq, %2, %32 : i64
      %31 = scalar.constant -128 : i32
      %22 = scalar.constant 2147483647 : i32
      %35 = scf.select %17, %31, %22 : i32
      scf.yield %35 : i32
    }
    scf.yield %12 : i32
  }
  func.return %6 : i32
}

func.def public @volatile_scalar_input(%input: buffer, %trial: index) {
  %26 = index.constant 0 : offset
  %value = buffer.view %input[%26] : buffer -> view<1xi32>
  %28 = func.call pure @volatile_parameter_value(%trial) : (index) -> (i32)
  %36 = index.constant 0 : index
  view.store %28, %value[%36] : i32, view<1xi32>
  func.return
}

// ====
// RUN: pass canonicalize,cse,dce
// Signed and unsigned source literals preserve their stored bit patterns.
#include <loomcxx/check.h>
#include <loomcxx/view.h>
void volatile_parameter_input(loom::type::buffer<unsigned> input) {
  auto values =
      loom::buffer::view<4>(input, {}, loom::encoding::layout::dense<1>());
  loom::view::store(0u, values, 0);
  loom::view::store(37u, values, 1);
  loom::view::store((unsigned)-128, values, 2);
  loom::view::store(0x7fffffffu, values, 3);
}

// ----
func.def public @volatile_parameter_input(%input: buffer) {
  %2 = index.constant 0 : offset
  %values = buffer.view %input[%2] : buffer -> view<4xi32>
  %4 = scalar.constant 0 : i32
  %22 = index.constant 0 : index
  view.store %4, %values[%22] : i32, view<4xi32>
  %7 = scalar.constant 37 : i32
  %21 = index.constant 1 : index
  view.store %7, %values[%21] : i32, view<4xi32>
  %20 = scalar.constant -128 : i32
  %19 = index.constant 2 : index
  view.store %20, %values[%19] : i32, view<4xi32>
  %15 = scalar.constant 2147483647 : i32
  %18 = index.constant 3 : index
  view.store %15, %values[%18] : i32, view<4xi32>
  func.return
}

// ====
// RUN: pass canonicalize,cse,dce
// Ordinal branches preserve zero, partial, and full extents.
#include <loomcxx/check.h>
#include <loomcxx/view.h>
unsigned volatile_memory_count(loom::check::ordinal trial) {
  if (trial == 0) {
    return 0u;
  }
  if (trial == 1) {
    return 1u;
  }
  if (trial == 2) {
    return 17u;
  }
  return 64u;
}

// ----
func.def public @volatile_memory_count(%trial: index) -> (i32) {
  %2 = index.cast %trial : index to i64
  %23 = scalar.constant 0 : i64
  %5 = scalar.cmpi eq, %2, %23 : i64
  %6 = scf.if %5 -> (i32) {
    %7 = scalar.constant 0 : i32
    scf.yield %7 : i32
  } else {
    %22 = scalar.constant 1 : i64
    %11 = scalar.cmpi eq, %2, %22 : i64
    %12 = scf.if %11 -> (i32) {
      %13 = scalar.constant 1 : i32
      scf.yield %13 : i32
    } else {
      %21 = scalar.constant 2 : i64
      %17 = scalar.cmpi eq, %2, %21 : i64
      %19 = scalar.constant 17 : i32
      %20 = scalar.constant 64 : i32
      %24 = scf.select %17, %19, %20 : i32
      scf.yield %24 : i32
    }
    scf.yield %12 : i32
  }
  func.return %6 : i32
}

// ====
// RUN: pass canonicalize,cse,dce
// Literal branches and generated-loop branches share the same output
// storage.
#include <loomcxx/check.h>
#include <loomcxx/view.h>
unsigned volatile_input_value(unsigned position) {
  return position * 0x10203041u + 0x7fffff00u;
}

void volatile_vector_input(loom::type::buffer<unsigned> input,
                           loom::check::ordinal trial) {
  auto values =
      loom::buffer::view<4>(input, {}, loom::encoding::layout::dense<1>());
  if (trial == 0) {
    loom::view::store(0u, values, 0);
    loom::view::store(1u, values, 1);
    loom::view::store(0xffffffffu, values, 2);
    loom::view::store(0x80000000u, values, 3);
  } else if (trial == 1) {
    loom::view::store(37u, values, 0);
    loom::view::store((unsigned)-128, values, 1);
    loom::view::store(65535u, values, 2);
    loom::view::store(0x7fffffffu, values, 3);
  } else {
    for (unsigned position = 0; position < 4u; ++position) {
      loom::view::store(volatile_input_value(position), values, position);
    }
  }
}

// ----
func.def public @volatile_input_value(%position: i32) -> (i32) {
  %2 = scalar.constant 270544961 : i32
  %3 = scalar.muli %position, %2 : i32
  %4 = scalar.constant 2147483392 : i32
  %5 = scalar.addi %3, %4 : i32
  func.return %5 : i32
}

func.def public @volatile_vector_input(%input: buffer, %trial: index) {
  %9 = index.constant 0 : offset
  %values = buffer.view %input[%9] : buffer -> view<4xi32>
  %11 = index.cast %trial : index to i64
  %67 = scalar.constant 0 : i64
  %14 = scalar.cmpi eq, %11, %67 : i64
  scf.if %14 {
    %15 = scalar.constant 0 : i32
    %66 = index.constant 0 : index
    view.store %15, %values[%66] : i32, view<4xi32>
    %18 = scalar.constant 1 : i32
    %65 = index.constant 1 : index
    view.store %18, %values[%65] : i32, view<4xi32>
    %21 = scalar.constant -1 : i32
    %64 = index.constant 2 : index
    view.store %21, %values[%64] : i32, view<4xi32>
    %24 = scalar.constant -2147483648 : i32
    %63 = index.constant 3 : index
    view.store %24, %values[%63] : i32, view<4xi32>
  } else {
    %62 = scalar.constant 1 : i64
    %30 = scalar.cmpi eq, %11, %62 : i64
    scf.if %30 {
      %31 = scalar.constant 37 : i32
      %61 = index.constant 0 : index
      view.store %31, %values[%61] : i32, view<4xi32>
      %60 = scalar.constant -128 : i32
      %59 = index.constant 1 : index
      view.store %60, %values[%59] : i32, view<4xi32>
      %39 = scalar.constant 65535 : i32
      %58 = index.constant 2 : index
      view.store %39, %values[%58] : i32, view<4xi32>
      %42 = scalar.constant 2147483647 : i32
      %57 = index.constant 3 : index
      view.store %42, %values[%57] : i32, view<4xi32>
    } else {
      %55 = index.constant 4 : offset
      %49 = index.constant 1 : offset
      scf.for %position = [%9 to %55 step %49] {
        %51 = index.cast %position : offset to i32
        %52 = func.call pure @volatile_input_value(%51) : (i32) -> (i32)
        %53 = scalar.extui %51 : i32 to i64
        %54 = index.cast %53 : i64 to index
        view.store %52, %values[%54] : i32, view<4xi32>
      }
    }
  }
  func.return
}

// ====
// RUN: pass canonicalize,cse,dce
// Independent ordinal selections preserve their different origin and stride
// values.
#include <loomcxx/check.h>
#include <loomcxx/view.h>
unsigned volatile_view_origin(loom::check::ordinal trial) {
  if (trial == 0) {
    return 0u;
  }
  if (trial == 1) {
    return 3u;
  }
  return 15u;
}

unsigned volatile_view_stride(loom::check::ordinal trial) {
  if (trial == 0) {
    return 4u;
  }
  if (trial == 1) {
    return 7u;
  }
  return 15u;
}

// ----
func.def public @volatile_view_origin(%trial: index) -> (i32) {
  %2 = index.cast %trial : index to i64
  %31 = scalar.constant 0 : i64
  %5 = scalar.cmpi eq, %2, %31 : i64
  %6 = scf.if %5 -> (i32) {
    %7 = scalar.constant 0 : i32
    scf.yield %7 : i32
  } else {
    %30 = scalar.constant 1 : i64
    %11 = scalar.cmpi eq, %2, %30 : i64
    %13 = scalar.constant 3 : i32
    %14 = scalar.constant 15 : i32
    %32 = scf.select %11, %13, %14 : i32
    scf.yield %32 : i32
  }
  func.return %6 : i32
}

func.def public @volatile_view_stride(%trial: index) -> (i32) {
  %17 = index.cast %trial : index to i64
  %34 = scalar.constant 0 : i64
  %20 = scalar.cmpi eq, %17, %34 : i64
  %21 = scf.if %20 -> (i32) {
    %22 = scalar.constant 4 : i32
    scf.yield %22 : i32
  } else {
    %33 = scalar.constant 1 : i64
    %26 = scalar.cmpi eq, %17, %33 : i64
    %28 = scalar.constant 7 : i32
    %29 = scalar.constant 15 : i32
    %35 = scf.select %26, %28, %29 : i32
    scf.yield %35 : i32
  }
  func.return %21 : i32
}
