// RUN: roundtrip
#include <loomcxx/object.h>

struct [[loom::import("lifetime", "object")]] Object;

namespace primitive {
template <class T>
struct [[loom::type("ref")]] Owner {
  T* identity;
};
template <class T>
[[loom::op("ref.null")]] Owner<T> null();
template <class T>
[[loom::op("ref.duplicate")]] Owner<T> duplicate(Owner<T>);
template <class T>
[[loom::op("ref.borrow")]] loom::ptr<T> borrow(Owner<T>);
template <class T>
[[loom::op("ref.release")]] void release(Owner<T>);
}  // namespace primitive

template <class T>
class Ref {
 public:
  Ref() : owner_(primitive::null<T>()) {}
  explicit Ref(primitive::Owner<T> owner) : owner_(owner) {}
  Ref(const Ref& other) : owner_(primitive::duplicate(other.owner_)) {}
  Ref(Ref&& other) : owner_(other.owner_) {
    other.owner_ = primitive::null<T>();
  }
  ~Ref() { primitive::release(owner_); }
  Ref& operator=(Ref other) {
    auto next = other.owner_;
    other.owner_ = primitive::null<T>();
    auto previous = owner_;
    owner_ = next;
    primitive::release(previous);
    return *this;
  }
  loom::ptr<T> get() const { return primitive::borrow(owner_); }

 private:
  primitive::Owner<T> owner_;
};

struct Handles {
  Handles(primitive::Owner<Object> owner, loom::ptr<Object> pointer)
      : owner(owner), pointer(pointer) {}
  ~Handles() { primitive::release(owner); }

  primitive::Owner<Object> owner;
  loom::ptr<Object> pointer;
};

struct RefArray {
  RefArray(primitive::Owner<Object> first,
           primitive::Owner<Object> second)
      : values{Ref<Object>(first), Ref<Object>(second)} {}

  Ref<Object> values[2];
};

[[loom::import("lifetime", "read_pair")]]
void read_pair(loom::ptr<Object> first, loom::ptr<Object> second);

[[loom::noinline]] static void inspect(const Ref<Object>& first,
                                       const Ref<Object>& second) {
  read_pair(first.get(), second.get());
}

[[loom::noinline]] static void replace(Ref<Object>& first,
                                       const Ref<Object>& second,
                                       const Ref<Object>& replacement) {
  auto saved = second.get();
  first = replacement;
  read_pair(second.get(), saved);
}

[[loom::noinline]] static Ref<Object> identity(Ref<Object> owner) {
  return owner;
}

void route(primitive::Owner<Object> first,
           primitive::Owner<Object> second) {
  Ref<Object> owner(first);
  Ref<Object> replacement(second);
  inspect(owner, owner);
  replace(owner, owner, replacement);
  auto result = identity(static_cast<Ref<Object>&&>(owner));
  read_pair(result.get(), replacement.get());
}

[[loom::noinline]] static void alias_handles(Handles& target,
                                             const Handles& source) {
  target.pointer = source.pointer;
}

void route_columns(primitive::Owner<Object> owner,
                   loom::ptr<Object> pointer) {
  Handles handles{owner, pointer};
  alias_handles(handles, handles);
}

[[loom::noinline]] static void inspect_array(const RefArray& first,
                                             const RefArray& second) {
  read_pair(first.values[0].get(), second.values[1].get());
}

void route_array(primitive::Owner<Object> first,
                 primitive::Owner<Object> second) {
  RefArray owners(first, second);
  inspect_array(owners, owners);
}

