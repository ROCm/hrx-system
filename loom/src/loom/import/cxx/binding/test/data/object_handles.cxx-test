// RUN: roundtrip
#include <loomcxx/object.h>

struct [[loom::import("lifetime", "object")]] Object;

[[loom::import("lifetime", "create_owner")]]
loom::ref<Object> create_owner(unsigned identity);
[[loom::import("lifetime", "read")]]
void read(loom::ptr<Object> value);

[[loom::noinline]] static loom::ref<Object> identity(loom::ref<Object> owner) {
  return owner;
}

[[loom::noinline]] static bool present(const loom::ref<Object>& owner) {
  return static_cast<bool>(owner);
}

void run(unsigned identity_value, bool replace) {
  auto owner = create_owner(identity_value);
  auto copy = owner;
  if (copy && present(copy)) {
    read(copy.get());
  }
  auto moved = identity(static_cast<loom::ref<Object>&&>(copy));
  if (replace) {
    owner = moved;
  }
  moved.reset();
  read(owner.get());
}

void drain(unsigned identity_value, unsigned iterations) {
  auto owner = create_owner(identity_value);
  while (iterations-- && owner) {
    read(owner.get());
    owner.reset();
  }
  read(owner.get());
}

