// RUN: roundtrip
#include <loomcxx/kernel.h>
#include <loomcxx/view.h>

namespace loomt = loom::type;
using layout2 = loomt::encoding<loom::encoding::role::layout, 2>;
using rows32 =
    loomt::view<loomt::shape<loomt::dynamic, 32>, const float, layout2>;
using rows16 =
    loomt::view<loomt::shape<loomt::dynamic, 16>, const float, layout2>;
static_assert(__is_trivially_copyable(layout2));
static_assert(__is_trivially_copyable(rows32));
static_assert(__is_trivially_copyable(rows16));
static_assert(sizeof(layout2) == 2 * sizeof(loomt::size_type));
static_assert(sizeof(rows32) == sizeof(void*) + 4 * sizeof(loomt::size_type));

static rows32 suffix(rows32 source, unsigned first, unsigned remaining) {
  return loom::view::subview(source, {first, 0}, {remaining});
}

static rows16 narrow(rows32 source, unsigned first, unsigned column,
                     unsigned remaining) {
  return loom::view::subview<loomt::dynamic, 16>(
      source, {first, column}, {remaining});
}

static rows32 choose(bool use_right, rows32 left, rows32 right) {
  return use_right ? right : left;
}

[[loom::kernel, loom::workgroup_size(32, 1, 1),
  loom::workgroup_count(1, 1, 1)]]
void repack(const float* input, float* output, unsigned rows,
            unsigned input_stride) {
  auto input_layout = loom::encoding::layout::strided(input_stride, 1);
  auto output_layout = loom::encoding::layout::dense<2>();
  auto source = loom::buffer::view<loomt::dynamic, 32>(
      input, {rows}, input_layout);
  auto destination = loom::buffer::view<loomt::dynamic, 32>(
      output, {rows}, output_layout);
  auto tail = suffix(source, 1, rows - 1);
  auto narrow_tail = narrow(source, 1, 8, rows - 1);
  auto selected = choose(rows > 2, source, tail);
  if (rows > 3) {
    selected = tail;
  }
  auto column = loom::kernel::workitem::id.x;
  float value = loom::view::load(selected, 0, column);
  loom::view::store(value, destination, 0, column);
}
// ----
kernel.def @repack() {
  %4 = index.constant 1 : index
  %5 = index.constant 1 : index
  %6 = index.constant 1 : index
  %7 = index.constant 32 : index
  %8 = index.constant 1 : index
  %9 = index.constant 1 : index
  kernel.launch.config workgroups(%4, %5, %6) workgroup_size(%7, %8, %9) : index
} launch(%input: buffer, %output: buffer, %rows: i32, %input_stride: i32) {
  %input_byte_offset = index.constant 0 : offset
  %output_byte_offset = index.constant 0 : offset
  %12 = scalar.constant 1 : i32
  %13 = scalar.extui %input_stride : i32 to i64
  %14 = index.cast %13 : i64 to index
  %15 = index.cast %12 : i32 to index
  %input_layout = encoding.layout.strided [%14, %15] : encoding<layout>
  %output_layout = encoding.layout.dense : encoding<layout>
  %18 = scalar.extui %rows : i32 to i64
  %source_dim0 = index.cast %18 : i64 to index
  %source = buffer.view %input[%input_byte_offset] : buffer -> view<[%source_dim0]x32xf32, %input_layout>
  %21 = scalar.extui %rows : i32 to i64
  %destination_dim0 = index.cast %21 : i64 to index
  %destination = buffer.view %output[%output_byte_offset] : buffer -> view<[%destination_dim0]x32xf32, %output_layout>
  %24 = scalar.constant 1 : i32
  %25 = scalar.constant 1 : i32
  %26 = scalar.subi %rows, %25 : i32
  %tail_dim0, %tail_layout, %tail = func.call pure @suffix(%source_dim0, %input_layout, %source, %24, %26) : (index, encoding<layout>, view<[%source_dim0]x32xf32, %input_layout>, i32, i32) -> (index, encoding<layout>, view<[%tail_dim0]x32xf32, %tail_layout>)
  %30 = scalar.constant 1 : i32
  %31 = scalar.constant 8 : i32
  %32 = scalar.constant 1 : i32
  %33 = scalar.subi %rows, %32 : i32
  %narrow_tail_dim0, %narrow_tail_layout, %narrow_tail = func.call pure @narrow(%source_dim0, %input_layout, %source, %30, %31, %33) : (index, encoding<layout>, view<[%source_dim0]x32xf32, %input_layout>, i32, i32, i32) -> (index, encoding<layout>, view<[%narrow_tail_dim0]x16xf32, %narrow_tail_layout>)
  %37 = scalar.constant 2 : i32
  %38 = scalar.cmpi ugt, %rows, %37 : i32
  %selected_dim0$39, %selected_layout$40, %selected$41 = func.call pure @choose(%38, %source_dim0, %input_layout, %source, %tail_dim0, %tail_layout, %tail) : (i1, index, encoding<layout>, view<[%source_dim0]x32xf32, %input_layout>, index, encoding<layout>, view<[%tail_dim0]x32xf32, %tail_layout>) -> (index, encoding<layout>, view<[%selected_dim0$39]x32xf32, %selected_layout$40>)
  %42 = scalar.constant 3 : i32
  %43 = scalar.cmpi ugt, %rows, %42 : i32
  %selected_dim0$44, %selected_layout$45, %selected$46 = scf.if %43 -> (index, encoding<layout>, view<[%selected_dim0$44]x32xf32, %selected_layout$45>) {
    scf.yield %tail_dim0, %tail_layout, %tail : index, encoding<layout>, view<[%tail_dim0]x32xf32, %tail_layout>
  } else {
    scf.yield %selected_dim0$39, %selected_layout$40, %selected$41 : index, encoding<layout>, view<[%selected_dim0$39]x32xf32, %selected_layout$40>
  }
  %workitem_id_x = kernel.workitem.id<x> : index
  %48 = scalar.constant 0 : i32
  %49 = index.cast %48 : i32 to index
  %value = view.load %selected$46[%49, %workitem_id_x] : view<[%selected_dim0$44]x32xf32, %selected_layout$45> -> f32
  %51 = scalar.constant 0 : i32
  %52 = index.cast %51 : i32 to index
  view.store %value, %destination[%52, %workitem_id_x] : f32, view<[%destination_dim0]x32xf32, %output_layout>
  kernel.return
}

func.def @suffix(%source_dim0: index, %source_layout: encoding<layout>, %source: view<[%source_dim0]x32xf32, %source_layout>, %first: i32, %remaining: i32) -> (%58: index, %59: encoding<layout>, view<[%58]x32xf32, %59>) {
  %61 = scalar.extui %first : i32 to i64
  %62 = scalar.constant 0 : i32
  %63 = scalar.extsi %62 : i32 to i64
  %64 = scalar.extui %remaining : i32 to i64
  %65 = index.cast %64 : i64 to index
  %66 = index.cast %61 : i64 to index
  %67 = index.cast %63 : i64 to index
  %68 = view.subview %source[%66, %67] : view<[%source_dim0]x32xf32, %source_layout> -> view<[%65]x32xf32, %source_layout>
  func.return %65, %source_layout, %68 : index, encoding<layout>, view<[%65]x32xf32, %source_layout>
}

func.def @narrow(%source_dim0: index, %source_layout: encoding<layout>, %source: view<[%source_dim0]x32xf32, %source_layout>, %first: i32, %column: i32, %remaining: i32) -> (%75: index, %76: encoding<layout>, view<[%75]x16xf32, %76>) {
  %78 = scalar.extui %first : i32 to i64
  %79 = scalar.extui %column : i32 to i64
  %80 = scalar.extui %remaining : i32 to i64
  %81 = index.cast %80 : i64 to index
  %82 = index.cast %78 : i64 to index
  %83 = index.cast %79 : i64 to index
  %84, %85 = view.subview %source[%82, %83] : view<[%source_dim0]x32xf32, %source_layout> -> view<[%81]x16xf32, %85>
  func.return %81, %85, %84 : index, encoding<layout>, view<[%81]x16xf32, %85>
}

func.def @choose(%use_right: i1, %left_dim0: index, %left_layout: encoding<layout>, %left: view<[%left_dim0]x32xf32, %left_layout>, %right_dim0: index, %right_layout: encoding<layout>, %right: view<[%right_dim0]x32xf32, %right_layout>) -> (%93: index, %94: encoding<layout>, view<[%93]x32xf32, %94>) {
  %96, %97, %98 = scf.if %use_right -> (index, encoding<layout>, view<[%96]x32xf32, %97>) {
    scf.yield %right_dim0, %right_layout, %right : index, encoding<layout>, view<[%right_dim0]x32xf32, %right_layout>
  } else {
    scf.yield %left_dim0, %left_layout, %left : index, encoding<layout>, view<[%left_dim0]x32xf32, %left_layout>
  }
  func.return %96, %97, %98 : index, encoding<layout>, view<[%96]x32xf32, %97>
}

// ====
// Rank-three physical storage remains an ordinary view across a helper and
// subview boundary.
#include <loomcxx/encoding.h>
#include <loomcxx/numeric.h>
#include <loomcxx/view.h>
namespace loomt = loom::type;
using Weight = loomt::float8_e4m3fn_t;
using Weights =
    loomt::view<loomt::shape<loomt::dynamic, loomt::dynamic, 16>,
                const Weight,
                loomt::encoding<loom::encoding::role::storage, 3>>;

static Weights preserve_weights(Weights weights) { return weights; }

Weight read_weight(const Weight* data, unsigned rows, unsigned tiles,
                   unsigned row, unsigned tile, unsigned lane) {
  auto layout = loom::encoding::layout::dense<3>();
  auto schema = loom::encoding::define<loom::encoding::f8e4m3fn{
      .payload_elements = 16, .scale_group_elements = 16}>();
  auto storage = loom::encoding::define(layout, schema);
  auto raw_weights = loom::buffer::view<loomt::dynamic, loomt::dynamic, 16>(
      data, {rows, tiles}, storage);
  auto weights = preserve_weights(raw_weights);
  auto tail = loom::view::subview(weights, {row, 0, 0}, {rows - row, tiles});
  return loom::view::load(tail, 0, tile, lane);
}

// ----
func.def public @read_weight(%data: buffer, %data_byte_offset: offset, %rows: i32, %tiles: i32, %row: i32, %tile: i32, %lane: i32) -> (f8E4M3) {
  %layout = encoding.layout.dense : encoding<layout>
  %schema = encoding.define #encoding.f8e4m3fn<affine=scale_only, payload_elements=16, scale_format=e8m0, scale_group_elements=16, scale_operands=1, scale_topology=block_1d> : encoding<schema>
  %storage = encoding.define #encoding.storage {layout = %layout : encoding<layout>, schema = %schema : encoding<schema>} : encoding<storage>
  %11 = scalar.extui %rows : i32 to i64
  %12 = scalar.extui %tiles : i32 to i64
  %raw_weights_dim0 = index.cast %11 : i64 to index
  %raw_weights_dim1 = index.cast %12 : i64 to index
  %raw_weights = buffer.view %data[%data_byte_offset] : buffer -> view<[%raw_weights_dim0]x[%raw_weights_dim1]x16xf8E4M3, %storage>
  %weights_dim0, %weights_dim1, %weights_storage, %weights = func.call pure @preserve_weights(%raw_weights_dim0, %raw_weights_dim1, %storage, %raw_weights) : (index, index, encoding<storage>, view<[%raw_weights_dim0]x[%raw_weights_dim1]x16xf8E4M3, %storage>) -> (index, index, encoding<storage>, view<[%weights_dim0]x[%weights_dim1]x16xf8E4M3, %weights_storage>)
  %20 = scalar.extui %row : i32 to i64
  %21 = scalar.constant 0 : i32
  %22 = scalar.extsi %21 : i32 to i64
  %23 = scalar.constant 0 : i32
  %24 = scalar.extsi %23 : i32 to i64
  %25 = scalar.subi %rows, %row : i32
  %26 = scalar.extui %25 : i32 to i64
  %27 = scalar.extui %tiles : i32 to i64
  %tail_dim0 = index.cast %26 : i64 to index
  %tail_dim1 = index.cast %27 : i64 to index
  %30 = index.cast %20 : i64 to index
  %31 = index.cast %22 : i64 to index
  %32 = index.cast %24 : i64 to index
  %tail, %tail_storage = view.subview %weights[%30, %31, %32] : view<[%weights_dim0]x[%weights_dim1]x16xf8E4M3, %weights_storage> -> view<[%tail_dim0]x[%tail_dim1]x16xf8E4M3, %tail_storage>
  %35 = scalar.constant 0 : i32
  %36 = index.cast %35 : i32 to index
  %37 = scalar.extui %tile : i32 to i64
  %38 = index.cast %37 : i64 to index
  %39 = scalar.extui %lane : i32 to i64
  %40 = index.cast %39 : i64 to index
  %41 = view.load %tail[%36, %38, %40] : view<[%tail_dim0]x[%tail_dim1]x16xf8E4M3, %tail_storage> -> f8E4M3
  func.return %41 : f8E4M3
}

func.def @preserve_weights(%weights_dim0: index, %weights_dim1: index, %weights_storage: encoding<storage>, %weights: view<[%weights_dim0]x[%weights_dim1]x16xf8E4M3, %weights_storage>) -> (%46: index, %47: index, %48: encoding<storage>, view<[%46]x[%47]x16xf8E4M3, %48>) {
  func.return %weights_dim0, %weights_dim1, %weights_storage, %weights : index, index, encoding<storage>, view<[%weights_dim0]x[%weights_dim1]x16xf8E4M3, %weights_storage>
}

// ====
// Typed buffers preserve one zero-origin buffer value across ordinary calls.
#include <loomcxx/view.h>

void increment_root(loom::type::buffer<unsigned> data) {
  auto values = loom::buffer::view<4>(
      data, {}, loom::encoding::layout::dense<1>());
  auto value = loom::view::load(values, 0);
  loom::view::store(value + 1u, values, 0);
}

// ----
func.def public @increment_root(%data: buffer) {
  %values_layout = encoding.layout.dense : encoding<layout>
  %2 = index.constant 0 : offset
  %values = buffer.view %data[%2] : buffer -> view<4xi32, %values_layout>
  %4 = scalar.constant 0 : i32
  %5 = index.cast %4 : i32 to index
  %value = view.load %values[%5] : view<4xi32, %values_layout> -> i32
  %7 = scalar.constant 1 : i32
  %8 = scalar.addi %value, %7 : i32
  %9 = scalar.constant 0 : i32
  %10 = index.cast %9 : i32 to index
  view.store %8, %values[%10] : i32, view<4xi32, %values_layout>
  func.return
}


// ====
// Plain typed buffers preserve byte origins and can change their source element
// interpretation before constructing and bitcasting equal-sized views.
#include <loomcxx/view.h>
using Words = loom::type::view<loom::type::shape<4>, unsigned>;
using Bytes = loom::type::view<loom::type::shape<16>, unsigned char>;

static Words words(loom::type::buffer<unsigned> data,
                   loom::type::offset byte_offset) {
  return loom::buffer::view<4>(data, byte_offset, {});
}
Bytes bytes(loom::type::buffer<unsigned char> data,
            loom::type::offset byte_offset) {
  Words source = words(loom::buffer::cast<unsigned>(data), byte_offset);
  return loom::view::bitcast<Bytes>(source);
}

// ----
func.def public @bytes(%data: buffer, %byte_offset: offset) -> (view<16xi8>) {
  %source = func.call pure @words(%data, %byte_offset) : (buffer, offset) -> (view<4xi32>)
  %4 = view.bitcast %source : view<4xi32> -> view<16xi8>
  func.return %4 : view<16xi8>
}

func.def @words(%data: buffer, %byte_offset: offset) -> (view<4xi32>) {
  %8 = buffer.view %data[%byte_offset] : buffer -> view<4xi32>
  func.return %8 : view<4xi32>
}
