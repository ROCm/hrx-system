  %64 = scalar.constant 1 : i32
  %65 = scalar.extsi %64 : i32 to i64
  %66 = index.cast %65 : i64 to index
  %tail = view.subview %values[%66] : view<3xi8> -> view<1xi8>
  %68 = scalar.constant 0 : i32
  %69 = index.cast %68 : i32 to index
  %70 = view.load %tail[%69] : view<1xi8> -> i8
  func.return %70 : i8
}

