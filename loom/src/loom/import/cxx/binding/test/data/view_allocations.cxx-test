// RUN: roundtrip
#include <loomcxx/view.h>

namespace loomt = loom::type;

template <class T>
static T local(T value) {
  using Values = loomt::view<loomt::shape<3>, T>;
  auto values = loom::view::alloca<Values>();
  loom::view::store(value, values, 1);
  auto tail = loom::view::subview<1>(values, {1}, {});
  return loom::view::load(tail, 0);
}

// Every scalar carrier uses the same typed allocation path.
double scalar_family(signed char a, unsigned char b, short c,
                     unsigned short d, int e, unsigned f, long long g,
                     unsigned long long h, float i, double j,
                     loomt::index k, loomt::offset l) {
  return local(a) + local(b) + local(c) + local(d) + local(e) + local(f) +
         local(g) + local(h) + local(i) + local(j) +
         loom::index::cast<unsigned>(local(k)) +
         loom::offset::cast<unsigned>(local(l));
}
// ----
func.def public @scalar_family(%a: i8, %b: i8, %c: i16, %d: i16, %e: i32, %f: i32, %g: i64, %h: i64, %i: f32, %j: f64, %k: index, %l: offset) -> (f64) {
  %13 = func.call @local_signed_char(%a) : (i8) -> (i8)
  %14 = scalar.extsi %13 : i8 to i32
  %15 = func.call @local_unsigned_char(%b) : (i8) -> (i8)
  %16 = scalar.extui %15 : i8 to i32
  %17 = scalar.addi %14, %16 : i32
  %18 = func.call @local_short(%c) : (i16) -> (i16)
  %19 = scalar.extsi %18 : i16 to i32
  %20 = scalar.addi %17, %19 : i32
  %21 = func.call @local_unsigned_short(%d) : (i16) -> (i16)
  %22 = scalar.extui %21 : i16 to i32
  %23 = scalar.addi %20, %22 : i32
  %24 = func.call @local_int(%e) : (i32) -> (i32)
  %25 = scalar.addi %23, %24 : i32
  %26 = func.call @local_unsigned_int(%f) : (i32) -> (i32)
  %27 = scalar.addi %25, %26 : i32
  %28 = scalar.extui %27 : i32 to i64
  %29 = func.call @local_long_long(%g) : (i64) -> (i64)
  %30 = scalar.addi %28, %29 : i64
  %31 = func.call @local_unsigned_long_long(%h) : (i64) -> (i64)
  %32 = scalar.addi %30, %31 : i64
  %33 = scalar.uitofp %32 : i64 to f32
  %34 = func.call @local_float(%i) : (f32) -> (f32)
  %35 = scalar.addf %33, %34 : f32
  %36 = scalar.extf %35 : f32 to f64
  %37 = func.call @local_double(%j) : (f64) -> (f64)
  %38 = scalar.addf %36, %37 : f64
  %39 = func.call @local___loom__type__index(%k) : (index) -> (index)
  %40 = index.cast %39 : index to i32
  %41 = scalar.uitofp %40 : i32 to f64
  %42 = scalar.addf %38, %41 : f64
  %43 = func.call @local___loom__type__offset(%l) : (offset) -> (offset)
  %44 = index.cast %43 : offset to i32
  %45 = scalar.uitofp %44 : i32 to f64
  %46 = scalar.addf %42, %45 : f64
  func.return %46 : f64
}

func.def @local_signed_char(%value: i8) -> (i8) {
  %values = view.alloca<private> : view<3xi8>
  %50 = scalar.constant 1 : i32
  %51 = index.cast %50 : i32 to index
  view.store<type_disjoint> %value, %values[%51] : i8, view<3xi8>
  %52 = scalar.constant 1 : i32
  %53 = scalar.extsi %52 : i32 to i64
  %54 = index.cast %53 : i64 to index
  %tail = view.subview %values[%54] : view<3xi8> -> view<1xi8>
  %56 = scalar.constant 0 : i32
  %57 = index.cast %56 : i32 to index
  %58 = view.load<type_disjoint> %tail[%57] : view<1xi8> -> i8
  func.return %58 : i8
}

