// RUN: pass canonicalize,cse,dce
// Auto return deduction keeps dense and strided view types distinct across calls.
#include <loomcxx/encoding.h>
#include <loomcxx/kernel.h>
#include <loomcxx/numeric.h>
#include <loomcxx/view.h>

namespace loomt = loom::type;

using rows8 = loomt::view<loomt::shape<loomt::dynamic, 8>, const float,
                          loomt::encoding<loom::encoding::role::layout, 2>>;

static rows8 preserve_view(rows8 source) { return source; }

template <class View>
static float read_view(View source) {
  return loom::view::load(source, 2, 3);
}

// Specializations retain different shape types through auto return deduction.
template <bool Strided>
static auto make_view(const float* input) {
  if constexpr (Strided) {
    auto layout = loom::encoding::layout::strided(11u, 1u);
    return loom::buffer::view<loomt::dynamic, 8>(input, {3}, layout);
  } else {
    auto layout = loom::encoding::layout::dense<2>();
    return loom::buffer::view<3, 8>(input, {}, layout);
  }
}

[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void typed_view_static_layouts(const float* input, float* output,
                               unsigned input_origin) {
  loom::assume(input_origin < 16);
  auto dense_source = make_view<false>(input + input_origin);
  auto strided_source = preserve_view(make_view<true>(input + input_origin));
  output[0] = read_view(dense_source);
  output[1] = read_view(strided_source);
}
// ----
kernel.def @typed_view_static_layouts() {
  %3 = index.constant 1 : index
  kernel.launch.config workgroups(%3, %3, %3) workgroup_size(%3, %3, %3) : index
} launch(%input: buffer, %output: buffer, %input_origin$2: i32) {
  %input_origin$11 = scalar.assume %input_origin$2 [range(%input_origin$2, 0, 15)] : i32
  %12 = scalar.extui %input_origin$11 : i32 to i64
  %13 = index.cast %12 : i64 to index
  %14 = index.constant 4 : index
  %15 = index.mul %13, %14 : index
  %dense_source_layout, %dense_source = func.call pure @make_view_0(%input, %15) : (buffer, index) -> (encoding<layout>, view<3x8xf32, %dense_source_layout>)
  %24, %25, %26 = func.call pure @make_view_1(%input, %15) : (buffer, index) -> (index, encoding<layout>, view<[%24]x8xf32, %25>)
  %strided_source_dim0, %strided_source_layout, %strided_source = func.call pure @preserve_view(%24, %25, %26) : (index, encoding<layout>, view<[%24]x8xf32, %25>) -> (index, encoding<layout>, view<[%strided_source_dim0]x8xf32, %strided_source_layout>)
  %30 = func.call readonly @read_view___loom__type__view___loom__type__shape_3__8___const_float____loom__type__encoding_0__2__(%dense_source_layout, %dense_source) : (encoding<layout>, view<3x8xf32, %dense_source_layout>) -> (f32)
  %90 = index.constant 0 : index
  %36 = buffer.view %output[%90] : buffer -> view<1xf32>
  view.store<root_in_bounds|type_disjoint> %30, %36[0] : f32, view<1xf32>
  %37 = func.call readonly @read_view___loom__type__view___loom__type__shape_18446744073709551615__8___const_float____loom__type__encoding_0__2__(%strided_source_dim0, %strided_source_layout, %strided_source) : (index, encoding<layout>, view<[%strided_source_dim0]x8xf32, %strided_source_layout>) -> (f32)
  %43 = buffer.view %output[%14] : buffer -> view<1xf32>
  view.store<root_in_bounds|type_disjoint> %37, %43[0] : f32, view<1xf32>
  kernel.return
}

func.def @make_view_0(%input: buffer, %input_byte_offset: index) -> (%46: encoding<layout>, view<3x8xf32, %46>) {
  %layout = encoding.layout.dense : encoding<layout>
  %49 = buffer.view %input[%input_byte_offset] : buffer -> view<3x8xf32, %layout>
  func.return %layout, %49 : encoding<layout>, view<3x8xf32, %layout>
