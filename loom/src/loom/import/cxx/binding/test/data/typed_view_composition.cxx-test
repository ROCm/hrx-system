}

func.def @make_view_0(%input: buffer, %input_byte_offset: offset) -> (%56: encoding<layout>, view<3x8xf32, %56>) {
  %layout = encoding.layout.dense : encoding<layout>
  %59 = buffer.view %input[%input_byte_offset] : buffer -> view<3x8xf32, %layout>
  func.return %layout, %59 : encoding<layout>, view<3x8xf32, %layout>
