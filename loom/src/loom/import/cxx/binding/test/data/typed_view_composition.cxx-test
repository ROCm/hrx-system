func.def @preserve_view(%source_dim0: index, %source_layout: encoding<layout>, %source: view<[%source_dim0]x8xf32, %source_layout>) -> (%53: index, %54: encoding<layout>, view<[%53]x8xf32, %54>) {
  func.return %source_dim0, %source_layout, %source : index, encoding<layout>, view<[%source_dim0]x8xf32, %source_layout>
}

