func.def @preserve_view(%source_dim0: index, %source_layout: encoding<layout>, %source: view<[%source_dim0]x8xf32, %source_layout>) -> (%63: index, %64: encoding<layout>, view<[%63]x8xf32, %64>) {
  func.return %source_dim0, %source_layout, %source : index, encoding<layout>, view<[%source_dim0]x8xf32, %source_layout>
