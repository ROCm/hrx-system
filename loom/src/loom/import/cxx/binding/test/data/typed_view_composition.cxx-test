// ====
// RUN: pass canonicalize,cse,dce
// Interior origins, dynamic rows, and input stride survive the typed-view helper ABI.
#include <loomcxx/encoding.h>
#include <loomcxx/kernel.h>
#include <loomcxx/numeric.h>
#include <loomcxx/view.h>

namespace loomt = loom::type;

using rows8 = loomt::view<loomt::shape<loomt::dynamic, 8>, const float,
                          loomt::encoding<loom::encoding::role::layout, 2>>;

static rows8 preserve_view(rows8 source) { return source; }

template <class Input, class Output>
static void copy_view_element(Input source, Output destination, unsigned row,
                              unsigned column) {
  loom::view::store(loom::view::load(source, row, column), destination, row,
                    column);
}

[[loom::kernel, loom::workgroup_size(8, 8, 1), loom::workgroup_count(1, 1, 1)]]
void typed_view_copy(const float* input, float* output, unsigned rows,
                     unsigned input_stride, unsigned input_origin,
                     unsigned output_origin) {
  loom::assume(rows < 9);
  loom::assume(input_stride < 32);
  loom::assume(input_origin < 16);
  loom::assume(output_origin < 16);

  auto input_layout = loom::encoding::layout::strided(input_stride, 1u);
  auto output_layout = loom::encoding::layout::dense<2>();
  auto row_count = loom::index::cast(rows);
  auto source = preserve_view(loom::buffer::view<loomt::dynamic, 8>(
      input + input_origin, {row_count}, input_layout));
  auto destination = loom::buffer::view<loomt::dynamic, 8>(
      output + output_origin, {row_count}, output_layout);

  unsigned row = loom::kernel::workitem::id.y;
  unsigned column = loom::kernel::workitem::id.x;
  if (loom::index::cast(row) < row_count) {
    copy_view_element(source, destination, row, column);
  }
}
// ----
kernel.def @typed_view_copy() {
  %6 = index.constant 1 : index
  %9 = index.constant 8 : index
  kernel.launch.config workgroups(%6, %6, %6) workgroup_size(%9, %9, %6) : index
} launch(%input: buffer, %output: buffer, %rows$2: i32, %input_stride$3: i32, %input_origin$4: i32, %output_origin$5: i32) {
  %rows$14 = scalar.assume %rows$2 [range(%rows$2, 0, 8)] : i32
  %input_stride$15 = scalar.assume %input_stride$3 [range(%input_stride$3, 0, 31)] : i32
  %input_origin$16 = scalar.assume %input_origin$4 [range(%input_origin$4, 0, 15)] : i32
  %output_origin$17 = scalar.assume %output_origin$5 [range(%output_origin$5, 0, 15)] : i32
  %19 = scalar.extui %input_stride$15 : i32 to i64
  %20 = index.cast %19 : i64 to index
  %78 = index.constant 1 : index
  %input_layout = encoding.layout.strided [%20, %78] : encoding<layout>
  %output_layout = encoding.layout.dense : encoding<layout>
  %25 = scalar.extui %rows$14 : i32 to i64
  %row_count = index.cast %25 : i64 to index
  %27 = scalar.extui %input_origin$16 : i32 to i64
  %81 = scalar.constant 2 : i64
  %82 = scalar.shli %27, %81 : i64
  %32 = scalar.assume %82 [range(%82, 0, 9223372036854775807)] : i64
  %33 = index.cast %32 : i64 to offset
  %34 = buffer.view %input[%33] : buffer -> view<[%row_count]x8xf32, %input_layout>
  %source_dim0, %source_layout, %source = func.call pure @preserve_view(%row_count, %input_layout, %34) : (index, encoding<layout>, view<[%row_count]x8xf32, %input_layout>) -> (index, encoding<layout>, view<[%source_dim0]x8xf32, %source_layout>)
  %38 = scalar.extui %output_origin$17 : i32 to i64
  %80 = scalar.shli %38, %81 : i64
  %43 = scalar.assume %80 [range(%80, 0, 9223372036854775807)] : i64
  %44 = index.cast %43 : i64 to offset
  %destination = buffer.view %output[%44] : buffer -> view<[%row_count]x8xf32, %output_layout>
  %workitem_id_y = kernel.workitem.id<y> : index
  %row = index.cast %workitem_id_y : index to i32
  %workitem_id_x = kernel.workitem.id<x> : index
  %column = index.cast %workitem_id_x : index to i32
  %50 = scalar.extui %row : i32 to i64
  %51 = index.cast %50 : i64 to index
  %52 = index.cmp slt, %51, %row_count : index
  scf.if %52 {
    func.call @copy_view_element___loom__type__view___loom__type__shape_18446744073709551615__8___const_float____loom__type__encoding_0__2_____loom__type__view___loom__type__shape_18446744073709551615__8___float____loom__type__encoding_0__2__(%source_dim0, %source_layout, %source, %row_count, %output_layout, %destination, %row, %column) : (index, encoding<layout>, view<[%source_dim0]x8xf32, %source_layout>, index, encoding<layout>, view<[%row_count]x8xf32, %output_layout>, i32, i32)
  }
  kernel.return
}

func.def @preserve_view(%source_dim0: index, %source_layout: encoding<layout>, %source: view<[%source_dim0]x8xf32, %source_layout>) -> (%56: index, %57: encoding<layout>, view<[%56]x8xf32, %57>) {
  func.return %source_dim0, %source_layout, %source : index, encoding<layout>, view<[%source_dim0]x8xf32, %source_layout>
}

func.def @copy_view_element___loom__type__view___loom__type__shape_18446744073709551615__8___const_float____loom__type__encoding_0__2_____loom__type__view___loom__type__shape_18446744073709551615__8___float____loom__type__encoding_0__2__(%source_dim0: index, %source_layout: encoding<layout>, %source: view<[%source_dim0]x8xf32, %source_layout>, %destination_dim0: index, %destination_layout: encoding<layout>, %destination: view<[%destination_dim0]x8xf32, %destination_layout>, %row: i32, %column: i32) {
  %67 = scalar.extui %row : i32 to i64
  %68 = index.cast %67 : i64 to index
  %69 = scalar.extui %column : i32 to i64
  %70 = index.cast %69 : i64 to index
  %71 = view.load %source[%68, %70] : view<[%source_dim0]x8xf32, %source_layout> -> f32
  view.store %71, %destination[%68, %70] : f32, view<[%destination_dim0]x8xf32, %destination_layout>
  func.return
}

// ====
// RUN: pass canonicalize,cse,dce
// Selected pointer roots and origins stay paired through loop-carried subviews.
#include <loomcxx/encoding.h>
#include <loomcxx/kernel.h>
#include <loomcxx/numeric.h>
#include <loomcxx/view.h>

namespace loomt = loom::type;

[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void typed_view_loop(const unsigned* left, const unsigned* right,
                     unsigned* output, unsigned rows, unsigned stride,
                     unsigned iterations, bool use_right, bool share_root) {
  loom::assume(rows >= 3 && rows <= 8);
  loom::assume(stride >= 7 && stride <= 16);
  loom::assume(iterations <= 2);
  auto layout = loom::encoding::layout::strided(stride, 1u);
  const unsigned* right_root = share_root ? left : right;
  const unsigned* source = use_right ? right_root + 3u : left + 2u;
  auto selected = loom::buffer::view<loomt::dynamic, 7>(source, {rows}, layout);
  for (unsigned i = 0; i < iterations; ++i) {
    --rows;
    loom::assume(rows >= 1 && rows <= 8);
    selected = loom::view::subview(selected, {1u, 0u}, {rows});
  }
  auto cell = loom::view::subview<1, 1>(selected, {0u, 0u}, {});
  output[0] = loom::view::load(cell, 0u, 0u);
}
// ----
kernel.def @typed_view_loop() {
  %8 = index.constant 1 : index
  kernel.launch.config workgroups(%8, %8, %8) workgroup_size(%8, %8, %8) : index
} launch(%left: buffer, %right: buffer, %output: buffer, %rows$3: i32, %stride$4: i32, %iterations$5: i32, %use_right: i1, %share_root: i1) {
  %rows$17 = scalar.assume %rows$3 [uge(%rows$3, 3)] : i32
  %rows$18 = scalar.assume %rows$17 [range(%rows$17, 0, 8)] : i32
  %stride$19 = scalar.assume %stride$4 [uge(%stride$4, 7)] : i32
  %stride$20 = scalar.assume %stride$19 [range(%stride$19, 0, 16)] : i32
  %iterations$21 = scalar.assume %iterations$5 [range(%iterations$5, 0, 2)] : i32
  %23 = scalar.extui %stride$20 : i32 to i64
  %24 = index.cast %23 : i64 to index
  %112 = index.constant 1 : index
  %layout = encoding.layout.strided [%24, %112] : encoding<layout>
  %right_root = scf.select %share_root, %left, %right : buffer
  %source, %source_byte_offset = scf.if %use_right -> (buffer, offset) {
    %111 = index.constant 12 : offset
    scf.yield %right_root, %111 : buffer, offset
  } else {
    %110 = index.constant 8 : offset
    scf.yield %left, %110 : buffer, offset
  }
  %48 = scalar.extui %rows$18 : i32 to i64
  %selected_dim0$49 = index.cast %48 : i64 to index
  %selected$50 = buffer.view %source[%source_byte_offset] : buffer -> view<[%selected_dim0$49]x7xi32, %layout>
  %109 = index.constant 0 : offset
  %53 = index.cast %iterations$21 : i32 to offset
  %54 = index.constant 1 : offset
  %rows$119, %selected_dim0$120, %selected$121 = scf.for %i = [%109 to %53 step %54](%rows$116 = %rows$18 : i32, %selected_dim0$117 = %selected_dim0$49 : index, %selected$118 = %selected$50 : view<[%selected_dim0$49]x7xi32, %layout>) -> (i32, index, view<[%selected_dim0$120]x7xi32, %layout>) {
    %113 = scalar.constant -1 : i32
    %rows$114 = scalar.addi %rows$116, %113 : i32
    %rows$67 = scalar.assume %rows$114 [ne(%rows$114, 0)] : i32
    %rows$68 = scalar.assume %rows$67 [range(%rows$67, 0, 8)] : i32
    %73 = scalar.extui %rows$68 : i32 to i64
    %selected_dim0$74 = index.cast %73 : i64 to index
    %107 = index.constant 0 : index
    %selected$77 = view.subview %selected$118[%112, %107] : view<[%selected_dim0$117]x7xi32, %layout> -> view<[%selected_dim0$74]x7xi32, %layout>
    scf.yield %rows$68, %selected_dim0$74, %selected$77 : i32, index, view<[%selected_dim0$74]x7xi32, %layout>
  }
  %106 = index.constant 0 : index
  %cell, %cell_layout = view.subview %selected$121[%106, %106] : view<[%selected_dim0$120]x7xi32, %layout> -> view<1x1xi32, %cell_layout>
  %92 = view.load %cell[%106, %106] : view<1x1xi32, %cell_layout> -> i32
  %101 = buffer.view %output[%109] : buffer -> view<1xi32>
  view.store %92, %101[0] : i32, view<1xi32>
  kernel.return
}

// ====
// RUN: pass canonicalize,cse,dce
// Two dependent dimensions and a storage schema retain encoded element accesses.
#include <loomcxx/encoding.h>
#include <loomcxx/kernel.h>
#include <loomcxx/numeric.h>
#include <loomcxx/view.h>

namespace loomt = loom::type;

using Weight = loomt::float8_e4m3fn_t;

[[loom::kernel, loom::workgroup_size(16, 1, 1), loom::workgroup_count(1, 1, 1)]]
void typed_storage_rank3(
    [[loom::noalias, loom::assume_aligned(64)]] const Weight* input,
    [[loom::noalias, loom::assume_aligned(64)]] Weight* output, unsigned rows,
    unsigned tiles) {
  loom::assume(rows >= 1 && rows <= 65535);
  loom::assume(tiles >= 1 && tiles <= 65535);
  auto layout = loom::encoding::layout::dense<3>();
  auto schema = loom::encoding::define<loom::encoding::f8e4m3fn{
      .payload_elements = 16,
      .scale_group_elements = 16,
  }>();
  auto storage = loom::encoding::define(layout, schema);
  auto source = loom::buffer::view<loomt::dynamic, loomt::dynamic, 16>(
      input, {rows, tiles}, storage);
  auto lane = loom::kernel::workitem::id.x;
  output[lane] = loom::view::load(source, 0, 0, lane);
}
// ----
kernel.def @typed_storage_rank3() {
  %4 = index.constant 1 : index
  %7 = index.constant 16 : index
  kernel.launch.config workgroups(%4, %4, %4) workgroup_size(%7, %4, %4) : index
} launch(%0: buffer, %1: buffer, %rows$2: i32, %tiles$3: i32) {
  %10 = buffer.assume.alignment %0 {minimum_alignment = 64} : buffer
  %input = buffer.assume.noalias %10 : buffer
  %input_byte_offset = index.constant 0 : offset
  %13 = buffer.assume.alignment %1 {minimum_alignment = 64} : buffer
  %output = buffer.assume.noalias %13 : buffer
  %rows$16 = scalar.assume %rows$2 [ne(%rows$2, 0)] : i32
  %rows$17 = scalar.assume %rows$16 [range(%rows$16, 0, 65535)] : i32
  %tiles$18 = scalar.assume %tiles$3 [ne(%tiles$3, 0)] : i32
  %tiles$19 = scalar.assume %tiles$18 [range(%tiles$18, 0, 65535)] : i32
  %23 = scalar.extui %rows$17 : i32 to i64
  %24 = scalar.extui %tiles$19 : i32 to i64
  %source_dim0 = index.cast %23 : i64 to index
  %source_dim1 = index.cast %24 : i64 to index
  %source = buffer.view %input[%input_byte_offset] : buffer -> view<[%source_dim0]x[%source_dim1]x16xf8E4M3, #encoding.storage<layout=#encoding.layout.dense, schema=#encoding.f8e4m3fn<affine=scale_only, payload_elements=16, scale_format=e8m0, scale_group_elements=16, scale_operands=1, scale_topology=block_1d>>>
  %workitem_id_x = kernel.workitem.id<x> : index
  %44 = index.constant 0 : index
  %33 = view.load %source[%44, %44, %workitem_id_x] : view<[%source_dim0]x[%source_dim1]x16xf8E4M3, #encoding.storage<layout=#encoding.layout.dense, schema=#encoding.f8e4m3fn<affine=scale_only, payload_elements=16, scale_format=e8m0, scale_group_elements=16, scale_operands=1, scale_topology=block_1d>>> -> f8E4M3
  %34 = index.cast %workitem_id_x : index to i32
  %35 = scalar.extui %34 : i32 to i64
  %40 = scalar.assume %35 [range(%35, 0, 9223372036854775807)] : i64
  %41 = index.cast %40 : i64 to offset
  %42 = buffer.view %output[%41] : buffer -> view<1xf8E4M3>
  view.store %33, %42[0] : f8E4M3, view<1xf8E4M3>
  kernel.return
}
