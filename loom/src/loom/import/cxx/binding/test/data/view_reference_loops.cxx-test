// ====
// RUN: pass canonicalize,cse,dce
// Nested coordinates skip inactive items while retaining every selected
// output mode.
#include <loomcxx/view.h>
void exchange_oracle(loom::type::buffer<unsigned long long> input,
                     loom::type::buffer<unsigned> output) {
  auto values =
      loom::buffer::view<5978>(output, {}, loom::encoding::layout::dense<1>());
  for (unsigned distance = 0; distance < 18; ++distance) {
    for (unsigned item = 0; item < 83; ++item) {
      if (item % 4 != 3) {
        for (unsigned mode = 0; mode < 4; ++mode) {
          loom::view::store(0u, values, 1 + (distance * 83 + item) * 4 + mode);
        }
      }
    }
  }
}

// ----
func.def public @exchange_oracle(%input: buffer, %output: buffer) {
  %3 = index.constant 0 : offset
  %values = buffer.view %output[%3] : buffer -> view<5978xi32>
  %45 = index.constant 18 : offset
  %9 = index.constant 1 : offset
  scf.for %distance = [%3 to %45 step %9] {
    %11 = index.cast %distance : offset to i32
    %43 = index.constant 83 : offset
    scf.for %item = [%3 to %43 step %9] {
      %18 = index.cast %item : offset to i32
      %51 = scalar.constant 3 : i32
      %52 = scalar.andi %18, %51 : i32
      %22 = scalar.cmpi ne, %52, %51 : i32
      scf.if %22 {
        %41 = index.constant 4 : offset
        scf.for %mode = [%3 to %41 step %9] {
          %29 = index.cast %mode : offset to i32
          %30 = scalar.constant 0 : i32
          %31 = scalar.constant 1 : i32
          %32 = scalar.constant 83 : i32
          %33 = scalar.muli %11, %32 : i32
          %34 = scalar.addi %33, %18 : i32
          %49 = scalar.constant 2 : i32
          %50 = scalar.shli %34, %49 : i32
          %47 = scalar.addi %50, %29 : i32
          %48 = scalar.addi %47, %31 : i32
          %39 = scalar.extui %48 : i32 to i64
          %40 = index.cast %39 : i64 to index
          view.store %30, %values[%40] : i32, view<5978xi32>
        }
      }
    }
  }
  func.return
}

// ====
// RUN: pass canonicalize,cse,dce
// View extents follow both concrete template arguments through calls.
#include <loomcxx/view.h>
template <unsigned Count>
void volatile_copy_oracle(loom::type::buffer<unsigned> input,
                          loom::type::buffer<unsigned> output) {
  auto input_values =
      loom::buffer::view<Count>(input, {}, loom::encoding::layout::dense<1>());
  auto output_values =
      loom::buffer::view<Count>(output, {}, loom::encoding::layout::dense<1>());
  for (unsigned position = 0; position < Count; ++position) {
    loom::view::store(loom::view::load(input_values, position), output_values,
                      position);
  }
}
void volatile_scalar_parameter_oracle(loom::type::buffer<unsigned> input,
                                      loom::type::buffer<unsigned> output) {
  volatile_copy_oracle<1>(input, output);
}
void volatile_vector_parameter_oracle(loom::type::buffer<unsigned> input,
                                      loom::type::buffer<unsigned> output) {
  volatile_copy_oracle<4>(input, output);
}

// ----
func.def public @volatile_scalar_parameter_oracle(%input: buffer, %output: buffer) {
  func.call @volatile_copy_oracle_1(%input, %output) : (buffer, buffer)
  func.return
}

func.def public @volatile_vector_parameter_oracle(%input: buffer, %output: buffer) {
  func.call @volatile_copy_oracle_4(%input, %output) : (buffer, buffer)
  func.return
}

func.def @volatile_copy_oracle_1(%input: buffer, %output: buffer) {
  %7 = index.constant 0 : offset
  %input_values = buffer.view %input[%7] : buffer -> view<1xi32>
  %output_values = buffer.view %output[%7] : buffer -> view<1xi32>
  %45 = index.constant 0 : index
  %21 = view.load %input_values[%45] : view<1xi32> -> i32
  view.store %21, %output_values[%45] : i32, view<1xi32>
  func.return
}

func.def @volatile_copy_oracle_4(%input: buffer, %output: buffer) {
  %27 = index.constant 0 : offset
  %input_values = buffer.view %input[%27] : buffer -> view<4xi32>
  %output_values = buffer.view %output[%27] : buffer -> view<4xi32>
  %48 = index.constant 4 : offset
  %36 = index.constant 1 : offset
  scf.for %position = [%27 to %48 step %36] {
    %38 = index.cast %position : offset to i32
    %39 = scalar.extui %38 : i32 to i64
    %40 = index.cast %39 : i64 to index
    %41 = view.load %input_values[%40] : view<4xi32> -> i32
    view.store %41, %output_values[%40] : i32, view<4xi32>
  }
  func.return
}

// ====
// RUN: pass canonicalize,cse,dce
// A dynamic bound and per-iteration assumption refine the shared source and
// two output ranges.
#include <loomcxx/kernel.h>
void volatile_memory_oracle(loom::type::buffer<unsigned> input,
                            loom::type::buffer<unsigned> output,
                            unsigned count) {
  loom::assume(count <= 64u);
  auto input_values =
      loom::buffer::view<64>(input, {}, loom::encoding::layout::dense<1>());
  auto output_values =
      loom::buffer::view<128>(output, {}, loom::encoding::layout::dense<1>());
  for (unsigned position = 0; position < count; ++position) {
    loom::assume(position < 64u);
    unsigned doubled = loom::view::load(input_values, position) * 2u;
    loom::view::store(doubled, output_values, position);
    loom::view::store(doubled ^ 0xa5a55a5au, output_values, 64u + position);
  }
}

// ----
func.def public @volatile_memory_oracle(%input: buffer, %output: buffer, %count$2: i32) {
  %count$3 = scalar.assume %count$2 [range(%count$2, 0, 64)] : i32
  %5 = index.constant 0 : offset
  %input_values = buffer.view %input[%5] : buffer -> view<64xi32>
  %output_values = buffer.view %output[%5] : buffer -> view<128xi32>
  %12 = index.cast %count$3 : i32 to offset
  %13 = index.constant 1 : offset
  scf.for %position$14 = [%5 to %12 step %13] {
    %15 = index.cast %position$14 : offset to i32
    %position$16 = scalar.assume %15 [range(%15, 0, 63)] : i32
    %17 = scalar.extui %position$16 : i32 to i64
    %18 = index.cast %17 : i64 to index
    %19 = view.load %input_values[%18] : view<64xi32> -> i32
    %32 = scalar.constant 1 : i32
    %doubled = scalar.shli %19, %32 : i32
    view.store %doubled, %output_values[%18] : i32, view<128xi32>
    %24 = scalar.constant -1515890086 : i32
    %25 = scalar.xori %doubled, %24 : i32
    %26 = scalar.constant 64 : i32
    %31 = scalar.addi %position$16, %26 : i32
    %28 = scalar.extui %31 : i32 to i64
    %29 = index.cast %28 : i64 to index
    view.store %25, %output_values[%29] : i32, view<128xi32>
  }
  func.return
}

// ====
// RUN: pass canonicalize,cse,dce
// A scalar view loop preserves the load, arithmetic, and matching store
// coordinate.
#include <loomcxx/kernel.h>
void volatile_shared_oracle(loom::type::buffer<unsigned> input,
                            loom::type::buffer<unsigned> output) {
  auto input_values =
      loom::buffer::view<64>(input, {}, loom::encoding::layout::dense<1>());
  auto output_values =
      loom::buffer::view<64>(output, {}, loom::encoding::layout::dense<1>());
  for (unsigned position = 0; position < 64u; ++position) {
    loom::view::store(loom::view::load(input_values, position) + 1u,
                      output_values, position);
  }
}

// ----
func.def public @volatile_shared_oracle(%input: buffer, %output: buffer) {
  %3 = index.constant 0 : offset
  %input_values = buffer.view %input[%3] : buffer -> view<64xi32>
  %output_values = buffer.view %output[%3] : buffer -> view<64xi32>
  %22 = index.constant 64 : offset
  %12 = index.constant 1 : offset
  scf.for %position = [%3 to %22 step %12] {
    %14 = index.cast %position : offset to i32
    %15 = scalar.extui %14 : i32 to i64
    %16 = index.cast %15 : i64 to index
    %17 = view.load %input_values[%16] : view<64xi32> -> i32
    %18 = scalar.constant 1 : i32
    %19 = scalar.addi %17, %18 : i32
    view.store %19, %output_values[%16] : i32, view<64xi32>
  }
  func.return
}

// ====
// RUN: pass canonicalize,cse,dce
// Origin and stride compose before a refined scalar view load.
#include <loomcxx/kernel.h>
void volatile_views_oracle(loom::type::buffer<unsigned> input,
                           loom::type::buffer<unsigned> output, unsigned origin,
                           unsigned stride) {
  auto input_values =
      loom::buffer::view<64>(input, {}, loom::encoding::layout::dense<1>());
  auto output_values =
      loom::buffer::view<4>(output, {}, loom::encoding::layout::dense<1>());
  unsigned position = origin + stride + 1u;
  loom::assume(position < 64u);
  unsigned source = loom::view::load(input_values, position);
  loom::view::store(source * 2u, output_values, 1);
}

// ----
func.def public @volatile_views_oracle(%input: buffer, %output: buffer, %origin: i32, %stride: i32) {
  %5 = index.constant 0 : offset
  %input_values = buffer.view %input[%5] : buffer -> view<64xi32>
  %output_values = buffer.view %output[%5] : buffer -> view<4xi32>
  %10 = scalar.addi %origin, %stride : i32
  %11 = scalar.constant 1 : i32
  %position$12 = scalar.addi %10, %11 : i32
  %position$13 = scalar.assume %position$12 [range(%position$12, 0, 63)] : i32
  %14 = scalar.extui %position$13 : i32 to i64
  %15 = index.cast %14 : i64 to index
  %source = view.load %input_values[%15] : view<64xi32> -> i32
  %23 = scalar.shli %source, %11 : i32
  %21 = index.constant 1 : index
  view.store %23, %output_values[%21] : i32, view<4xi32>
  func.return
}
