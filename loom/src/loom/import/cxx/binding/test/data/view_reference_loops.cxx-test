// RUN: pass canonicalize,cse,dce
// Independent forward and reverse prefixes share typed views and retain
// five output columns.
#include <loomcxx/view.h>
void scan_u32_oracle(loom::type::buffer<unsigned> input,
                     loom::type::buffer<unsigned> output) {
  auto source = loom::buffer::view<242>(
      input, {}, loom::encoding::layout::dense<1>());
  auto destination = loom::buffer::view<1202>(
      output, {}, loom::encoding::layout::dense<1>());
  for (unsigned item = 0; item < 240; ++item) {
    unsigned begin = (item / 80) * 80;
    unsigned end = begin + 80;
    unsigned before = 0u;
    unsigned after = 0u;
    for (unsigned position = begin; position < item; ++position) {
      before += loom::view::load(source, position + 1);
    }
    for (unsigned position = item + 1; position < end; ++position) {
      after += loom::view::load(source, position + 1);
    }
    unsigned value = loom::view::load(source, item + 1);
    loom::view::store(before + value, destination, item * 5 + 1);
    loom::view::store(before, destination, item * 5 + 2);
    loom::view::store(value + after, destination, item * 5 + 3);
    loom::view::store(after, destination, item * 5 + 4);
    loom::view::store(before + value + after, destination, item * 5 + 5);
  }
}

// ----
func.def public @scan_u32_oracle(%input: buffer, %output: buffer) {
  %3 = index.constant 0 : offset
  %source = buffer.view %input[%3] : buffer -> view<242xi32>
  %destination = buffer.view %output[%3] : buffer -> view<1202xi32>
  %90 = index.constant 240 : offset
  %12 = index.constant 1 : offset
  scf.for %item = [%3 to %90 step %12] {
    %14 = index.cast %item : offset to i32
    %15 = scalar.constant 80 : i32
    %16 = scalar.divui %14, %15 : i32
    %begin = scalar.muli %16, %15 : i32
    %end = scalar.addi %begin, %15 : i32
    %before$21 = scalar.constant 0 : i32
    %23 = index.cast %begin : i32 to offset
    %before$28 = scf.for %position = [%23 to %item step %12](%before$27 = %before$21 : i32) -> (i32) {
      %29 = index.cast %position : offset to i32
      %30 = scalar.constant 1 : i32
      %31 = scalar.addi %29, %30 : i32
      %32 = scalar.extui %31 : i32 to i64
      %33 = index.cast %32 : i64 to index
      %34 = view.load %source[%33] : view<242xi32> -> i32
      %before$35 = scalar.addi %before$27, %34 : i32
      scf.yield %before$35 : i32
    }
    %36 = scalar.constant 1 : i32
    %position = scalar.addi %14, %36 : i32
    %38 = index.cast %position : i32 to offset
    %39 = index.cast %end : i32 to offset
    %after = scf.for %position = [%38 to %39 step %12](%after$42 = %before$21 : i32) -> (i32) {
      %44 = index.cast %position : offset to i32
      %46 = scalar.addi %44, %36 : i32
      %47 = scalar.extui %46 : i32 to i64
      %48 = index.cast %47 : i64 to index
      %49 = view.load %source[%48] : view<242xi32> -> i32
      %after$50 = scalar.addi %after$42, %49 : i32
      scf.yield %after$50 : i32
    }
    %53 = scalar.extui %position : i32 to i64
    %54 = index.cast %53 : i64 to index
    %value = view.load %source[%54] : view<242xi32> -> i32
    %56 = scalar.addi %before$28, %value : i32
    %57 = scalar.constant 5 : i32
    %58 = scalar.muli %14, %57 : i32
    %60 = scalar.addi %58, %36 : i32
    %61 = scalar.extui %60 : i32 to i64
    %62 = index.cast %61 : i64 to index
    view.store %56, %destination[%62] : i32, view<1202xi32>
    %65 = scalar.constant 2 : i32
    %66 = scalar.addi %58, %65 : i32
    %67 = scalar.extui %66 : i32 to i64
    %68 = index.cast %67 : i64 to index
    view.store %before$28, %destination[%68] : i32, view<1202xi32>
    %69 = scalar.addi %value, %after : i32
    %72 = scalar.constant 3 : i32
    %73 = scalar.addi %58, %72 : i32
    %74 = scalar.extui %73 : i32 to i64
    %75 = index.cast %74 : i64 to index
    view.store %69, %destination[%75] : i32, view<1202xi32>
    %78 = scalar.constant 4 : i32
    %79 = scalar.addi %58, %78 : i32
    %80 = scalar.extui %79 : i32 to i64
    %81 = index.cast %80 : i64 to index
    view.store %after, %destination[%81] : i32, view<1202xi32>
    %83 = scalar.addi %56, %after : i32
    %87 = scalar.addi %58, %57 : i32
    %88 = scalar.extui %87 : i32 to i64
    %89 = index.cast %88 : i64 to index
    view.store %83, %destination[%89] : i32, view<1202xi32>
  }
  func.return
}

