  %58 = index.constant 1 : offset
  %grid_dim0$59, %grid_dim1$60, %grid_layout$61, %grid$62, %rows$63, %columns$64 = scf.for %i = [%56 to %57 step %58](%grid_dim0$66 = %grid_dim0$51 : index, %grid_dim1$67 = %grid_dim1$52 : index, %grid_layout$68 = %grid_layout$53 : encoding<layout>, %grid$69 = %grid$54 : view<[%grid_dim0$51]x[%grid_dim1$52]xi32, %grid_layout$53>, %rows$70 = %rows$45 : i32, %columns$71 = %columns$46 : i32) -> (index, index, encoding<layout>, view<[%grid_dim0$59]x[%grid_dim1$60]xi32, %grid_layout$61>, i32, i32) {
