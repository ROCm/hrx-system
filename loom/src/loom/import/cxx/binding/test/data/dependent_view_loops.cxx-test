// RUN: roundtrip
#include <loomcxx/view.h>

namespace loomt = loom::type;
using Grid = loomt::view<
    loomt::shape<loomt::dynamic, loomt::dynamic>, const unsigned,
    loomt::encoding<loom::encoding::role::layout, 2>>;

static Grid crop_once(Grid grid, unsigned& rows, unsigned& columns) {
  --rows;
  --columns;
  return loom::view::subview(grid, {1u, 1u}, {rows, columns});
}

Grid crop_for(Grid grid, unsigned iterations, unsigned rows, unsigned columns) {
  for (unsigned i = 0; i < iterations; ++i) grid = crop_once(grid, rows, columns);
  return grid;
}

Grid crop_selected_for(Grid left, Grid right, bool use_right, unsigned iterations, unsigned rows, unsigned columns) {
  Grid grid = use_right ? right : left;
  for (unsigned i = 0; i < iterations; ++i) grid = crop_once(grid, rows, columns);
  return grid;
}

Grid crop_while(Grid grid, unsigned iterations, unsigned rows, unsigned columns) {
  unsigned i = 0;
  while (i++ < iterations) grid = crop_once(grid, rows, columns);
  return grid;
}

Grid crop_do(Grid grid, unsigned iterations, unsigned rows, unsigned columns) {
  unsigned i = 0;
  do {
    grid = crop_once(grid, rows, columns);
  } while (++i < iterations);
  return grid;
}

Grid crop_break(Grid grid, unsigned iterations, unsigned rows, unsigned columns, unsigned skip) {
  for (unsigned i = 0;; ++i) {
    if (i == iterations) break;
    if (i == skip) continue;
    grid = crop_once(grid, rows, columns);
  }
  return grid;
}

