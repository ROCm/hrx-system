  %58 = index.constant 1 : offset
  %rows$59, %columns$60, %grid_dim0$61, %grid_dim1$62, %grid_layout$63, %grid$64 = scf.for %i = [%56 to %57 step %58](%rows$66 = %rows$45 : i32, %columns$67 = %columns$46 : i32, %grid_dim0$68 = %grid_dim0$51 : index, %grid_dim1$69 = %grid_dim1$52 : index, %grid_layout$70 = %grid_layout$53 : encoding<layout>, %grid$71 = %grid$54 : view<[%grid_dim0$51]x[%grid_dim1$52]xi32, %grid_layout$53>) -> (i32, i32, index, index, encoding<layout>, view<[%grid_dim0$61]x[%grid_dim1$62]xi32, %grid_layout$63>) {
