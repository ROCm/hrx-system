    scf.yield %rows$77, %columns$78, %grid_dim0$73, %grid_dim1$74, %grid_layout$75, %grid$76 : i32, i32, index, index, encoding<layout>, view<[%grid_dim0$73]x[%grid_dim1$74]xi32, %grid_layout$75>
