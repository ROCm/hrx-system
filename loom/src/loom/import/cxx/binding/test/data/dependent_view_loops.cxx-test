func.def @crop_once(%grid_dim0: index, %grid_dim1: index, %grid_layout: encoding<layout>, %grid: view<[%grid_dim0]x[%grid_dim1]xi32, %grid_layout>, %rows$250: i32, %columns$251: i32) -> (%252: index, %253: index, %254: encoding<layout>, view<[%252]x[%253]xi32, %254>, i32, i32) {
  %258 = scalar.constant 1 : i32
  %rows$259 = scalar.subi %rows$250, %258 : i32
  %260 = scalar.constant 1 : i32
  %columns$261 = scalar.subi %columns$251, %260 : i32
  %262 = scalar.constant 1 : i32
  %263 = scalar.extui %262 : i32 to i64
  %264 = scalar.constant 1 : i32
  %265 = scalar.extui %264 : i32 to i64
  %266 = scalar.extui %rows$259 : i32 to i64
  %267 = scalar.extui %columns$261 : i32 to i64
  %268 = index.cast %266 : i64 to index
  %269 = index.cast %267 : i64 to index
  %270 = index.cast %263 : i64 to index
  %271 = index.cast %265 : i64 to index
  %272, %273 = view.subview %grid[%270, %271] : view<[%grid_dim0]x[%grid_dim1]xi32, %grid_layout> -> view<[%268]x[%269]xi32, %273>
  func.return %268, %269, %273, %272, %rows$259, %columns$261 : index, index, encoding<layout>, view<[%268]x[%269]xi32, %273>, i32, i32
}
