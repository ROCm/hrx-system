  %i = scalar.constant 0 : i32
  %12 = index.cast %i : i32 to offset
  %13 = index.cast %iterations : i32 to offset
  %14 = index.constant 1 : offset
  %grid_dim0$15, %grid_dim1$16, %grid_layout$17, %grid$18, %rows$19, %columns$20 = scf.for %i = [%12 to %13 step %14](%grid_dim0$22 = %grid_dim0$0 : index, %grid_dim1$23 = %grid_dim1$1 : index, %grid_layout$24 = %grid_layout$2 : encoding<layout>, %grid$25 = %grid$3 : view<[%grid_dim0$0]x[%grid_dim1$1]xi32, %grid_layout$2>, %rows$26 = %rows$5 : i32, %columns$27 = %columns$6 : i32) -> (index, index, encoding<layout>, view<[%grid_dim0$15]x[%grid_dim1$16]xi32, %grid_layout$17>, i32, i32) {
    %28 = index.cast %i : offset to i32
    %grid_dim0$29, %grid_dim1$30, %grid_layout$31, %grid$32, %rows$33, %columns$34 = func.call pure @crop_once(%grid_dim0$22, %grid_dim1$23, %grid_layout$24, %grid$25, %rows$26, %columns$27) : (index, index, encoding<layout>, view<[%grid_dim0$22]x[%grid_dim1$23]xi32, %grid_layout$24>, i32, i32) -> (index, index, encoding<layout>, view<[%grid_dim0$29]x[%grid_dim1$30]xi32, %grid_layout$31>, %rows$26 as i32, %columns$27 as i32)
    scf.yield %grid_dim0$29, %grid_dim1$30, %grid_layout$31, %grid$32, %rows$33, %columns$34 : index, index, encoding<layout>, view<[%grid_dim0$29]x[%grid_dim1$30]xi32, %grid_layout$31>, i32, i32
  }
  func.return %grid_dim0$15, %grid_dim1$16, %grid_layout$17, %grid$18 : index, index, encoding<layout>, view<[%grid_dim0$15]x[%grid_dim1$16]xi32, %grid_layout$17>
}

