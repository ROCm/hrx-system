  %i = scalar.constant 0 : i32
  %12 = index.cast %i : i32 to offset
  %13 = index.cast %iterations : i32 to offset
  %14 = index.constant 1 : offset
  %rows$15, %columns$16, %grid_dim0$17, %grid_dim1$18, %grid_layout$19, %grid$20 = scf.for %i = [%12 to %13 step %14](%rows$22 = %rows$5 : i32, %columns$23 = %columns$6 : i32, %grid_dim0$24 = %grid_dim0$0 : index, %grid_dim1$25 = %grid_dim1$1 : index, %grid_layout$26 = %grid_layout$2 : encoding<layout>, %grid$27 = %grid$3 : view<[%grid_dim0$0]x[%grid_dim1$1]xi32, %grid_layout$2>) -> (i32, i32, index, index, encoding<layout>, view<[%grid_dim0$17]x[%grid_dim1$18]xi32, %grid_layout$19>) {
    %28 = index.cast %i : offset to i32
    %grid_dim0$29, %grid_dim1$30, %grid_layout$31, %grid$32, %rows$33, %columns$34 = func.call pure @crop_once(%grid_dim0$24, %grid_dim1$25, %grid_layout$26, %grid$27, %rows$22, %columns$23) : (index, index, encoding<layout>, view<[%grid_dim0$24]x[%grid_dim1$25]xi32, %grid_layout$26>, i32, i32) -> (index, index, encoding<layout>, view<[%grid_dim0$29]x[%grid_dim1$30]xi32, %grid_layout$31>, i32, i32)
    scf.yield %rows$33, %columns$34, %grid_dim0$29, %grid_dim1$30, %grid_layout$31, %grid$32 : i32, i32, index, index, encoding<layout>, view<[%grid_dim0$29]x[%grid_dim1$30]xi32, %grid_layout$31>
  }
  func.return %grid_dim0$17, %grid_dim1$18, %grid_layout$19, %grid$20 : index, index, encoding<layout>, view<[%grid_dim0$17]x[%grid_dim1$18]xi32, %grid_layout$19>
}

