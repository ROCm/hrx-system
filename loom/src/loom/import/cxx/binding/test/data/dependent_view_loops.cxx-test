    scf.yield %right_dim0, %right_dim1, %right_layout, %right : index, index, encoding<layout>, view<[%right_dim0]x[%right_dim1]xi32, %right_layout>
  } else {
    scf.yield %left_dim0, %left_dim1, %left_layout, %left : index, index, encoding<layout>, view<[%left_dim0]x[%left_dim1]xi32, %left_layout>
