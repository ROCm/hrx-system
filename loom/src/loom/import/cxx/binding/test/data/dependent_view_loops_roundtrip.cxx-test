// Re-importing the guarded form emitted above must retain one source loop.
#include <loomcxx/kernel.h>

[[loom::kernel, loom::workgroup_count(1, 1, 1), loom::workgroup_size(1, 1, 1)]]
void crop_while_exported(const unsigned* input, unsigned* output, unsigned rows, unsigned columns, unsigned iterations) {
  loom::assume(rows >= 3u);
  loom::assume(rows <= 8u);
  loom::assume(columns >= 3u);
  loom::assume(columns <= 8u);
  loom::assume(iterations <= 2u);
  loom::type::index selected_dim0 = loom::index::cast(rows);
  loom::type::index selected_dim1 = loom::index::cast(columns);
  auto selected = loom::buffer::view<loom::type::dynamic, loom::type::dynamic>(input, loom::type::indices{selected_dim0, selected_dim1}, loom::encoding::layout::dense<2>());
  auto destination = loom::buffer::view<1>(output, {}, loom::encoding::layout::dense<1>());
  unsigned i = 0u;
  unsigned selected_rows = rows;
  auto selected_view = selected;
  bool loop_continues = true;
  do {
    unsigned next_i = i + 1u;
    loop_continues = i < iterations;
    i = next_i;
    if (loop_continues) {
      unsigned next_rows = selected_rows - 1u;
      loom::assume(next_rows != 0u);
      loom::assume(next_rows <= 8u);
      loom::type::index next_dim0 = loom::index::cast(next_rows);
      loom::type::index next_dim1 = loom::index::cast(columns);
      selected_view = loom::view::subview<loom::type::dynamic, loom::type::dynamic>(selected_view, loom::type::indices{loom::type::index{1}, loom::type::index{0}}, loom::type::indices{next_dim0, next_dim1});
      selected_rows = next_rows;
    }
  } while (loop_continues);
  unsigned value = loom::view::load(selected_view, loom::type::index{0}, loom::type::index{0});
  loom::view::store(value, destination, loom::type::index{0});
}

