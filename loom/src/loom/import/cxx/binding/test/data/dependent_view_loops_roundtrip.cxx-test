// RUN: emit cxx roundtrip
// REQUIRES: loom-export-cxx
#include <loomcxx/kernel.h>

[[loom::kernel, loom::workgroup_count(1, 1, 1), loom::workgroup_size(1, 1, 1)]]
void crop_for(const unsigned* input, unsigned* output, unsigned rows, unsigned stride, unsigned iterations) {
  loom::assume(rows >= 3 && rows <= 8);
  loom::assume(iterations <= 2);
  auto selected = loom::buffer::view<loom::type::dynamic, 7>(input, {rows}, loom::encoding::layout::strided(stride, 1u));
  auto destination = loom::buffer::view<1>(output, {}, loom::encoding::layout::dense<1>());
  for (unsigned i = 0; i < iterations; ++i) {
    --rows;
    loom::assume(rows >= 1 && rows <= 8);
    selected = loom::view::subview(selected, {1u, 0u}, {rows});
  }
  loom::view::store(loom::view::load(selected, 0u, 0u), destination, 0u);
}

[[loom::kernel, loom::workgroup_count(1, 1, 1), loom::workgroup_size(1, 1, 1)]]
void crop_while(const unsigned* input, unsigned* output, unsigned rows, unsigned columns, unsigned iterations) {
  loom::assume(rows >= 3 && rows <= 8);
  loom::assume(columns >= 3 && columns <= 8);
  loom::assume(iterations <= 2);
  auto selected = loom::buffer::view<loom::type::dynamic, loom::type::dynamic>(input, {rows, columns}, loom::encoding::layout::dense<2>());
  auto destination = loom::buffer::view<1>(output, {}, loom::encoding::layout::dense<1>());
  unsigned i = 0;
  while (i++ < iterations) {
    --rows;
    loom::assume(rows >= 1 && rows <= 8);
    selected = loom::view::subview(selected, {1u, 0u}, {rows, columns});
  }
  loom::view::store(loom::view::load(selected, 0u, 0u), destination, 0u);
}

