#include <loomcxx/kernel.h>
#include <loomcxx/predicate.h>

[[loom::kernel, loom::workgroup_count(1, 1, 1), loom::workgroup_size(1, 1, 1)]]
void crop_for(const unsigned* input, unsigned* output, unsigned rows, unsigned stride, unsigned iterations) {
  loom::assume(rows >= 3u);
  loom::assume(rows <= 8u);
  loom::assume(iterations <= 2u);
  auto selected_layout = loom::encoding::layout::strided(loom::index::cast(stride), loom::type::index{1});
  loom::type::index selected_dim0 = loom::index::cast(rows);
  auto selected = loom::buffer::view<loom::type::dynamic, 7>(input, loom::type::indices{selected_dim0}, selected_layout);
  auto destination = loom::buffer::view<1>(output, {}, loom::encoding::layout::dense<1>());
  unsigned rows_1 = rows;
  for (unsigned i = 0u; i < iterations; ++i) {
    unsigned v40 = i;
    unsigned rows_3 = rows_1 - 1u;
    loom::assume(rows_3 != 0u);
    loom::assume(rows_3 <= 8u);
    selected_dim0 = loom::index::cast(rows_3);
    selected = loom::view::subview<loom::type::dynamic, 7>(selected, loom::type::indices{loom::type::index{1}, loom::type::index{0}}, loom::type::indices{selected_dim0});
    rows_1 = rows_3;
  }
  unsigned v60 = loom::view::load(selected, loom::type::index{0}, loom::type::index{0});
  loom::view::store(v60, destination, loom::type::index{0});
}

[[loom::kernel, loom::workgroup_count(1, 1, 1), loom::workgroup_size(1, 1, 1)]]
void crop_while(const unsigned* input, unsigned* output, unsigned rows, unsigned columns, unsigned iterations) {
  loom::assume(rows >= 3u);
  loom::assume(rows <= 8u);
  loom::assume(columns >= 3u);
  loom::assume(columns <= 8u);
  loom::assume(iterations <= 2u);
  loom::type::index selected_dim0 = loom::index::cast(rows);
  loom::type::index selected_dim1 = loom::index::cast(columns);
  auto selected = loom::buffer::view<loom::type::dynamic, loom::type::dynamic>(input, loom::type::indices{selected_dim0, selected_dim1}, loom::encoding::layout::dense<2>());
  auto destination = loom::buffer::view<1>(output, {}, loom::encoding::layout::dense<1>());
  unsigned i_1 = 0u;
  unsigned rows_1 = rows;
  auto selected_1 = selected;
  bool loop_continues = true;
  do {
    unsigned i_3 = i_1 + 1u;
    loop_continues = i_1 < iterations;
    i_1 = i_3;
    if (loop_continues) {
      unsigned rows_4 = rows_1 - 1u;
      loom::assume(rows_4 != 0u);
      loom::assume(rows_4 <= 8u);
      loom::type::index selected_dim0_4 = loom::index::cast(rows_4);
      loom::type::index selected_dim1_4 = loom::index::cast(columns);
      selected_1 = loom::view::subview<loom::type::dynamic, loom::type::dynamic>(selected_1, loom::type::indices{loom::type::index{1}, loom::type::index{0}}, loom::type::indices{selected_dim0_4, selected_dim1_4});
      rows_1 = rows_4;
    }
  } while (loop_continues);
  unsigned v134 = loom::view::load(selected_1, loom::type::index{0}, loom::type::index{0});
  loom::view::store(v134, destination, loom::type::index{0});
}

