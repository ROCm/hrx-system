[[loom::pipeline, loom::symbol("child")]]
void child([[loom::launch]] loom::type::buffer<unsigned char> output, unsigned phase) {
  [[loom::strand(loom::type::indices{loom::type::index{0}, loom::type::index{2}}, loom::type::indices{loom::type::index{1}, loom::type::index{1}}, loom::type::indices{loom::type::index{1}, loom::type::index{1}})]] {
    auto values = loom::buffer::view<4>(loom::buffer::cast<unsigned>(output), {});
    loom::view::store((phase + 1u), values, loom::index::cast(phase));
  }
}

[[loom::pipeline("kernel"), loom::symbol("resident"), loom::retain]]
void resident([[loom::launch]] loom::type::buffer<unsigned char> output) {
  [[loom::serial]] {
    for (unsigned phase_1 = 0u; phase_1 < 3u; ++phase_1) {
      loom::pipeline::compose<child>(output, phase_1);
    }
    [[loom::serial]] {
      loom::pipeline::compose<child>(output, 3u);
    }
  }
}

// ====
// REQUIRES: loom-export-cxx
// RUN: emit cxx
// Local typed storage crosses the same byte-buffer boundary as external roots.
#include <loomcxx/pipeline.h>
using Bytes = loom::type::buffer<unsigned char>;
[[loom::pipeline]] void child(Bytes specialized, [[loom::launch]] Bytes runtime);
[[loom::pipeline("kernel")]] void root() {
  auto memory = loom::pipeline::memory<loom::memory_space::workgroup>(loom::type::indices{loom::type::index{0}, loom::type::index{2}});
  auto* storage = loom::buffer::alloca<unsigned, loom::memory_space::workgroup, 64>(loom::type::index{4}, memory);
  auto bytes = loom::buffer::cast<unsigned char>(loom::buffer::root(storage));
  [[loom::serial]] {
    loom::pipeline::compose<child>(bytes, bytes);
  }
  [[loom::strand(loom::type::indices{loom::type::index{0}, loom::type::index{2}}, loom::type::indices{loom::type::index{1}, loom::type::index{1}}, loom::type::indices{loom::type::index{1}, loom::type::index{1}})]] {
    auto values = loom::buffer::view<4>(storage, {});
    loom::view::store(7u, values, 0u);
  }
}

