// RUN: verify
// A statically false leaf rejects the complete conjunction.
[[loom::assume]] void assume(bool);
void entry(unsigned value, unsigned other) {
  // ERROR@+1: LOWERING/059 "predicate condition is statically false; Loom has no unreachable-path contract representation"
  assume(other < 32u && value < 0u);
}

// ====
// RUN: verify
// A false relation between the same binding is diagnosed before IR emission.
[[loom::assume]] void assume(bool);
void entry(int value) {
  // ERROR@+1: LOWERING/059 "predicate condition is statically false; Loom has no unreachable-path contract representation"
  assume(value < value);
}

// ====
// RUN: verify
// Disjunction does not establish simultaneous facts on either arm.
[[loom::assume]] void assume(bool);
void entry(unsigned value, unsigned other) {
  // ERROR@+1: LOWERING/059 "predicate expressions require comparisons, predicate helpers, or conjunctions joined by &&"
  assume(other < 32u && (value < 16u || other < 16u));
}

// ====
// RUN: verify
// A call is not a retained binding or a pure constant.
[[loom::assume]] void assume(bool);
unsigned opaque();
void entry(unsigned value, unsigned other) {
  // ERROR@+1: LOWERING/059 "predicate operands must be retained scalar values, compile-time constants, or scalar expressions safe to evaluate unconditionally"
  assume(other < 32u && value < opaque());
}

// ====
// RUN: verify
// A constexpr function is constant only when all of its arguments are.
[[loom::assume]] void assume(bool);
constexpr unsigned identity(unsigned value) { return value; }
void entry(unsigned value, unsigned runtime_bound) {
  // ERROR@+1: LOWERING/059 "predicate operands must be retained scalar values, compile-time constants, or scalar expressions safe to evaluate unconditionally"
  assume(value < identity(runtime_bound));
}

// ====
// RUN: verify
// A comma expression cannot hide a call in an otherwise constant operand.
[[loom::assume]] void assume(bool);
unsigned opaque();
void entry(unsigned value, unsigned other) {
  // ERROR@+1: LOWERING/059 "predicate operands must be retained scalar values, compile-time constants, or scalar expressions safe to evaluate unconditionally"
  assume(other < 32u && value < (opaque(), 16u));
}

// ====
// RUN: verify
// Mutating the constrained operand cannot produce an identity refinement.
[[loom::assume]] void assume(bool);
void entry(unsigned value, unsigned other) {
  // ERROR@+1: LOWERING/059 "predicate operands must be retained scalar values, compile-time constants, or scalar expressions safe to evaluate unconditionally"
  assume(other < 32u && value++ < 16u);
}

// ====
// RUN: verify
// Mutation in the other operand is equally outside the metadata contract.
[[loom::assume]] void assume(bool);
void entry(unsigned value, unsigned other) {
  // ERROR@+1: LOWERING/059 "predicate operands must be retained scalar values, compile-time constants, or scalar expressions safe to evaluate unconditionally"
  assume(other < 32u && value < (other = 16u));
}

// ====
// RUN: verify
// Pointer arithmetic is partial and cannot become an implicit metadata load.
[[loom::assume]] void assume(bool);
struct Bounds { int limit; };
void entry(int value, const Bounds* bounds, int offset) {
  // ERROR@+1: LOWERING/059 "predicate pointer-member reads require a direct retained pointer binding"
  assume(value < (bounds + offset)->limit);
}

// ====
// RUN: verify
// Volatile record storage cannot disappear into compile-time metadata.
[[loom::assume]] void assume(bool);
struct Bounds { int limit; };
void entry(int value, const volatile Bounds* bounds) {
  // ERROR@+1: LOWERING/059 "predicate expressions cannot read volatile values because no runtime comparison is emitted"
  assume(value < bounds->limit);
}

// ====
// RUN: verify
// Integer division is partial and cannot be materialized from an unevaluated
// assumption condition.
[[loom::assume]] void assume(bool);
void entry(unsigned value, unsigned divisor) {
  // ERROR@+1: LOWERING/059 "predicate operands must be retained scalar values, compile-time constants, or scalar expressions safe to evaluate unconditionally"
  assume(value / divisor < 16u);
}

// ====
// RUN: verify
// A runtime shift count is partial for values outside the source width.
[[loom::assume]] void assume(bool);
void entry(unsigned value, unsigned amount) {
  // ERROR@+1: LOWERING/059 "predicate operands must be retained scalar values, compile-time constants, or scalar expressions safe to evaluate unconditionally"
  assume((value << amount) < 16u);
}

// ====
// RUN: verify
// Mixed floating and integer ordering has no predicate contract.
[[loom::assume]] void assume(bool);
void entry(unsigned value, unsigned other) {
  // ERROR@+1: LOWERING/059 "floating predicate comparisons support only == and !=; use classification helpers for other facts"
  assume(other < 32u && value < 16.5f);
}

// ====
// RUN: verify
// A value-changing cast does not constrain the original binding.
[[loom::assume]] void assume(bool);
void entry(unsigned value, unsigned other) {
  // ERROR@+1: LOWERING/059 "predicate operands must be retained scalar values, compile-time constants, or scalar expressions safe to evaluate unconditionally"
  assume(other < 32u && (unsigned char)value < 16u);
}

// ====
// RUN: verify
// Even an unselected call is outside the pure constant contract.
[[loom::assume]] void assume(bool);
unsigned opaque();
void entry(unsigned value, unsigned other) {
  // ERROR@+1: LOWERING/059 "predicate operands must be retained scalar values, compile-time constants, or scalar expressions safe to evaluate unconditionally"
  assume(other < 32u && value < (false ? opaque() : 16u));
}

// ====
// RUN: verify
// A volatile read cannot disappear into compile-time metadata.
[[loom::assume]] void assume(bool);
extern volatile unsigned bound;
void entry(unsigned value, unsigned other) {
  // ERROR@+1: LOWERING/059 "predicate expressions cannot read volatile values because no runtime comparison is emitted"
  assume(other < 32u && value < bound);
}

// ====
// RUN: verify
// Addressable storage cannot be rebound to an SSA identity fact.
[[loom::assume]] void assume(bool);
int entry(int value) {
  int* address = &value;
  // ERROR@+1: LOWERING/059 "assume cannot retain facts for an addressable binding whose storage may change through an alias"
  assume(value > 0);
  return *address;
}

// ====
// RUN: verify
// Derived facts cannot read addressable storage either: materializing the
// expression would snapshot a value that an alias can subsequently change.
[[loom::assume]] void assume(bool);
int entry(int value) {
  int* address = &value;
  // ERROR@+1: LOWERING/059 "assume expressions cannot read an addressable binding whose storage may change through an alias"
  assume(value + 1 > 0);
  return *address;
}

// ====
// RUN: verify
// Non-automatic bindings have no current SSA identity to refine.
[[loom::assume]] void assume(bool);
extern int global_value;
void entry(int value) {
  // ERROR@+1: LOWERING/059 "assume can retain facts only for an owned automatic scalar binding"
  assume(value > 0 && global_value > 0);
}

// ====
// RUN: verify
// Derived facts likewise require every runtime dependency to have an owned
// automatic SSA identity.
[[loom::assume]] void assume(bool);
extern int global_value;
void entry(int value) {
  // ERROR@+1: LOWERING/059 "assume expressions can read only owned automatic scalar bindings"
  assume(value + global_value > 0);
}

// ====
// RUN: verify
// An overloaded comparison has no builtin integer truth domain.
[[loom::assume]] void assume(bool);
struct Bound {};
bool operator<(unsigned, Bound);
extern Bound bound;
void entry(unsigned value) {
  // ERROR@+1: LOWERING/059 "predicate comparisons require builtin operators"
  assume(value < bound);
}

// ====
// RUN: verify
// Overloaded arithmetic is not a pure integer constant expression.
[[loom::assume]] void assume(bool);
struct Bound {};
unsigned operator+(Bound, unsigned);
extern Bound bound;
void entry(unsigned value) {
  // ERROR@+1: LOWERING/059 "predicate operands must be retained scalar values, compile-time constants, or scalar expressions safe to evaluate unconditionally"
  assume(value < (bound + 1u));
}

// ====
// RUN: verify
// Invalid constant arithmetic is not promoted into a source contract.
[[loom::assume]] void assume(bool);
void entry(unsigned value, unsigned other) {
  // WARNING@+2: PARSE/036 "invalid binary expression"
  // ERROR@+1: LOWERING/059 "predicate operands must be retained scalar values, compile-time constants, or scalar expressions safe to evaluate unconditionally"
  assume(other < 32u && value < (1u / 0u));
}

// ====
// RUN: verify
// Heterogeneous constants preserve a strong subject, but two retained address
// values must agree on their logical or physical domain.
#include <loomcxx/kernel.h>
#include <loomcxx/predicate.h>

loom::type::index mixed_address_domains(loom::type::index logical, loom::type::offset physical) {
  // ERROR@+1: LOWERING/059 "retained predicate values must use the first operand's type"
  loom::assume(loom::predicate::eq(logical, physical));
  return logical;
}
