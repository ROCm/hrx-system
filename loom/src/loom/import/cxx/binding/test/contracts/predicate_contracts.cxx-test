// RUN: roundtrip
// Trailing attributes bind parameters and structured results directly into
// callable predicates while preserving source names.
#include <loomcxx/predicate.h>

struct Pair {
  float scale;
  unsigned count;
};

Pair select(unsigned count, unsigned capacity)
    [[loom::where(count > 0u && count <= capacity &&
                  loom::predicate::multiple_of(count, 16u) &&
                  loom::predicate::finite(
                      loom::predicate::result<Pair>().scale))]] {
  return {1.0f, count};
}

// ----
func.def public @select(%count: i32, %capacity: i32) -> (%2: f32, i32) where [ne(%count, 0), ule(%count, %capacity), multiple_of(%count, 16), finite(%2)] {
  %4 = scalar.constant 1.0 : f32
  func.return %4, %count : f32, i32
}

// ====
// Contracts follow semantic parameter ordinals across renamed declarations;
// conjunction order does not change their meaning.
#include <loomcxx/predicate.h>

unsigned bounded(unsigned count, unsigned capacity)
    [[loom::where(count > 0u && count <= capacity)]];
unsigned bounded(unsigned value, unsigned limit)
    [[loom::where(value <= limit && value > 0u)]] {
  return value;
}

// ----
func.def public @bounded(%value: i32, %limit: i32) -> (i32) where [ne(%value, 0), ule(%value, %limit)] {
  func.return %value : i32
}

// ====
// Kernel contracts reference launch bindings after configuration arguments.
#include <loomcxx/kernel.h>
#include <loomcxx/predicate.h>

[[loom::kernel, loom::workgroup_size(1, 1, 1),
  loom::workgroup_count(1, 1, 1)]]
void constrained(unsigned count)
    [[loom::where(count > 0u &&
                  loom::predicate::multiple_of(count, 16u))]] {}

// ----
kernel.def @constrained() {
  %1 = index.constant 1 : index
  %2 = index.constant 1 : index
  %3 = index.constant 1 : index
  %4 = index.constant 1 : index
  %5 = index.constant 1 : index
  %6 = index.constant 1 : index
  kernel.launch.config workgroups(%1, %2, %3) workgroup_size(%4, %5, %6) : index
} launch(%count: i32) where [ne(%count, 0), multiple_of(%count, 16)] {
  kernel.return
}

// ====
// A template family and each provider retain independent applicability
// contracts for link-time selection.
#include <loomcxx/kernel.h>
#include <loomcxx/predicate.h>
#include <loomcxx/target.h>

LOOM_TEMPLATE_DECL("test.scaled")
unsigned scaled(unsigned value)
    [[loom::where(loom::predicate::multiple_of(value, 8u))]];

LOOM_TEMPLATE_DEF(scaled)
[[loom::priority(20)]] unsigned scaled_wave64(unsigned value)
    [[loom::where(loom::target::subgroup::size() == 64u && value > 0u)]] {
  return value;
}

LOOM_TEMPLATE_DEF(scaled)
[[loom::priority(20)]] unsigned scaled_wave32(unsigned value)
    [[loom::where(32u == loom::target::subgroup::size() && value > 0u)]] {
  return value;
}

LOOM_TEMPLATE_DEF(scaled)
[[loom::priority(1)]] unsigned scaled_fallback(unsigned value) {
  return value;
}

unsigned apply(unsigned value) { return scaled(value); }

// ----
func.def public @apply(%value: i32) -> (i32) {
  %4 = template.apply<@test.scaled>(%value) : (i32) -> (i32)
  func.return %4 : i32
}

template.decl @test.scaled(%2: i32) -> (i32) where [multiple_of(%2, 8)]

template.def<@test.scaled> requires [#target.subgroup.size<64>] priority(20) @scaled_wave64(%value: i32) -> (i32) where [ne(%value, 0)] {
  template.return %value : i32
}

template.def<@test.scaled> requires [#target.subgroup.size<32>] priority(20) @scaled_wave32(%value: i32) -> (i32) where [ne(%value, 0)] {
  template.return %value : i32
}

template.def<@test.scaled> priority(1) @scaled_fallback(%value: i32) -> (i32) {
  template.return %value : i32
}

// ====
// A family-level target condition constrains every application before
// provider selection while retaining independent value predicates.
#include <loomcxx/kernel.h>
#include <loomcxx/predicate.h>
#include <loomcxx/target.h>

LOOM_TEMPLATE_DECL("test.wave64_only")
unsigned wave64_only(unsigned value)
    [[loom::where(loom::target::subgroup::size() == 64u &&
                  loom::predicate::multiple_of(value, 16u))]];

unsigned use_wave64(unsigned value) { return wave64_only(value); }

// ----
func.def public @use_wave64(%value: i32) -> (i32) {
  %4 = template.apply<@test.wave64_only>(%value) : (i32) -> (i32)
  func.return %4 : i32
}

template.decl requires [#target.subgroup.size<64>] @test.wave64_only(%2: i32) -> (i32) where [multiple_of(%2, 16)]

// ====
// General function assumptions need only the predicate contract header; they
// do not acquire a kernel source dependency.
#include <loomcxx/predicate.h>

void assume_bounded(unsigned value) {
  loom::assume(loom::predicate::range(value, 1u, 8u));
}

// ----
func.def public @assume_bounded(%value$0: i32) {
  %value$1 = scalar.assume %value$0 [range(%value$0, 1, 8)] : i32
  func.return
}

// ====
// The selected base path keeps same-named fields distinct in callable facts.
#include <loomcxx/predicate.h>
struct Base { unsigned count; };
struct Left : Base {};
struct Right : Base {};
struct Shape : Left, Right {};
unsigned base_count(Shape value) [[loom::where(loom::predicate::ule(value.Left::count, value.Right::count))]] {
  return value.Left::count;
}
// ----
func.def public @base_count(%value_Left_Base_count: i32, %value_Right_Base_count: i32) -> (i32) where [ule(%value_Left_Base_count, %value_Right_Base_count)] {
  func.return %value_Left_Base_count : i32
}
