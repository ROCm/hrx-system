// RUN: pass unroll-scf-for
// The importer preserves the schedule expression; the shared pass validates it.
unsigned scheduled(unsigned count, unsigned factor) {
  unsigned total = 0;
  // ERROR@+1: STRUCTURE/014 "compile-time exact i64 value"
  [[loom::unroll(factor)]]
  for (unsigned index = 0; index < count; ++index) {
    total += index;
  }
  return total;
}

// ====
// RUN: pass unroll-scf-for
// Serial unrolling preserves the source order around a callable exit.
int serial_find(const int* values, unsigned count) {
  [[loom::unroll(2)]]
  for (unsigned index = 0; index < count; ++index) {
    if (values[index] < 0) return (int)index;
  }
  return -1;
}

// ----
func.def public @serial_find(%values: buffer, %values_byte_offset: offset, %count: i32) -> (i32) {
  %index = scalar.constant 0 : i32
  %5 = index.cast %index : i32 to offset
  %6 = index.cast %count : i32 to offset
  %7 = index.constant 1 : offset
  %8 = scalar.constant 2 : i32
  %9 = index.cast %8 : i32 to index
  %27 = index.constant 2 : offset
  scf.for %index = [%5 to %6 step %27] {
    %29 = index.cast %index : offset to i32
    %30 = scalar.extui %29 : i32 to i64
    %31 = scalar.constant 4 : i64
    %32 = scalar.muli %30, %31 : i64
    %33 = index.cast %values_byte_offset : offset to i64
    %34 = scalar.addi %33, %32 : i64
    %35 = scalar.assume %34 [range(%34, 0, 9223372036854775807)] : i64
    %36 = index.cast %35 : i64 to offset
    %37 = buffer.view %values[%36] : buffer -> view<1xi32>
    %38 = view.load %37[0] : view<1xi32> -> i32
    %39 = scalar.constant 0 : i32
    %40 = scalar.cmpi slt, %38, %39 : i32
    scf.if %40 {
      %41 = scalar.constant 1 : i1
      func.exit %41 : i1 {
        func.return %29 : i32
      }
    }
    %42 = index.constant 1 : offset
    %index_1 = index.add %index, %42 : offset
    %44 = index.cmp ult, %index_1, %6 : offset
    scf.if %44 {
      %45 = index.cast %index_1 : offset to i32
      %46 = scalar.extui %45 : i32 to i64
      %47 = scalar.constant 4 : i64
      %48 = scalar.muli %46, %47 : i64
      %49 = index.cast %values_byte_offset : offset to i64
      %50 = scalar.addi %49, %48 : i64
      %51 = scalar.assume %50 [range(%50, 0, 9223372036854775807)] : i64
      %52 = index.cast %51 : i64 to offset
      %53 = buffer.view %values[%52] : buffer -> view<1xi32>
      %54 = view.load %53[0] : view<1xi32> -> i32
      %55 = scalar.constant 0 : i32
      %56 = scalar.cmpi slt, %54, %55 : i32
      scf.if %56 {
        %57 = scalar.constant 1 : i1
        func.exit %57 : i1 {
          func.return %45 : i32
        }
      }
    }
  }
  %24 = scalar.constant 1 : i32
  %25 = scalar.constant 0 : i32
  %26 = scalar.subi %25, %24 : i32
  func.return %26 : i32
}

// ====
// RUN: pass unroll-scf-for
// Interleaving iterations across a callable exit would execute skipped work.
int interleaved_find(const int* values, unsigned count) {
  // ERROR@+1: STRUCTURE/014 "body operations with only scf.if/scf.for regions and no successors"
  [[loom::unroll(2), loom::schedule("interleaved")]]
  for (unsigned index = 0; index < count; ++index) {
    if (values[index] < 0) return (int)index;
  }
  return -1;
}

// ====
// RUN: pass pipeline-scf-for
// Pipelining iterations across a callable exit would execute skipped work.
int pipelined_find(const int* values, unsigned count) {
  [[loom::pipeline(2)]]
  for (unsigned index = 0; index < count; ++index) {
    // ERROR@+1: STRUCTURE/014 "body operations with only scf.if/scf.for regions and no successors"
    if (values[index] < 0) return (int)index;
  }
  return -1;
}

// ====
// RUN: pass pipeline-scf-for
// The importer preserves the schedule expression; the shared pass validates it.
unsigned scheduled(unsigned count, unsigned factor) {
  unsigned total = 0;
  // ERROR@+1: STRUCTURE/014 "a compile-time exact depth"
  [[loom::pipeline(factor)]]
  for (unsigned index = 0; index < count; ++index) {
    total += index;
  }
  return total;
}

