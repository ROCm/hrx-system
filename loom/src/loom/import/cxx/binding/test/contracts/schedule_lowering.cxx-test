// RUN: pass unroll-scf-for
// The importer preserves the schedule expression; the shared pass validates it.
unsigned scheduled(unsigned count, unsigned factor) {
  unsigned total = 0;
  // ERROR@+1: STRUCTURE/014 "compile-time exact i64 value"
  [[loom::unroll(factor)]]
  for (unsigned index = 0; index < count; ++index) {
    total += index;
  }
  return total;
}

// ====
// RUN: pass unroll-scf-for
// Serial unrolling preserves the source order around a callable exit.
int serial_find(const int* values, unsigned count) {
  [[loom::unroll(2)]]
  for (unsigned index = 0; index < count; ++index) {
    if (values[index] < 0) return (int)index;
  }
  return -1;
}

// ----
func.def public @serial_find(%values: buffer, %values_byte_offset: index, %count: i32) -> (i32) {
  %index = scalar.constant 0 : i32
  %5 = index.cast %index : i32 to offset
  %6 = index.cast %count : i32 to offset
  %7 = index.constant 1 : offset
  %8 = scalar.constant 2 : i32
  %9 = index.cast %8 : i32 to index
  %25 = index.constant 2 : offset
  scf.for %index = [%5 to %6 step %25] {
    %27 = index.cast %index : offset to i32
    %28 = scalar.extui %27 : i32 to i64
    %29 = index.cast %28 : i64 to index
    %30 = index.constant 4 : index
    %31 = index.mul %29, %30 : index
    %32 = index.add %values_byte_offset, %31 : index
    %33 = buffer.view %values[%32] : buffer -> view<1xi32>
    %34 = view.load<root_in_bounds|type_disjoint> %33[0] : view<1xi32> -> i32
    %35 = scalar.constant 0 : i32
    %36 = scalar.cmpi slt, %34, %35 : i32
    scf.if %36 {
      %37 = scalar.constant 1 : i1
      func.exit %37 : i1 {
        func.return %27 : i32
      }
    }
    %38 = index.constant 1 : offset
    %index_1 = index.add %index, %38 : offset
    %40 = index.cmp ult, %index_1, %6 : offset
    scf.if %40 {
      %41 = index.cast %index_1 : offset to i32
      %42 = scalar.extui %41 : i32 to i64
      %43 = index.cast %42 : i64 to index
      %44 = index.constant 4 : index
      %45 = index.mul %43, %44 : index
      %46 = index.add %values_byte_offset, %45 : index
      %47 = buffer.view %values[%46] : buffer -> view<1xi32>
      %48 = view.load<root_in_bounds|type_disjoint> %47[0] : view<1xi32> -> i32
      %49 = scalar.constant 0 : i32
      %50 = scalar.cmpi slt, %48, %49 : i32
      scf.if %50 {
        %51 = scalar.constant 1 : i1
        func.exit %51 : i1 {
          func.return %41 : i32
        }
      }
    }
  }
  %22 = scalar.constant 1 : i32
  %23 = scalar.constant 0 : i32
  %24 = scalar.subi %23, %22 : i32
  func.return %24 : i32
}

// ====
// RUN: pass unroll-scf-for
// Interleaving iterations across a callable exit would execute skipped work.
int interleaved_find(const int* values, unsigned count) {
  // ERROR@+1: STRUCTURE/014 "body operations with only scf.if/scf.for regions and no successors"
  [[loom::unroll(2), loom::schedule("interleaved")]]
  for (unsigned index = 0; index < count; ++index) {
    if (values[index] < 0) return (int)index;
  }
  return -1;
}

// ====
// RUN: pass pipeline-scf-for
// Pipelining iterations across a callable exit would execute skipped work.
int pipelined_find(const int* values, unsigned count) {
  [[loom::pipeline(2)]]
  for (unsigned index = 0; index < count; ++index) {
    // ERROR@+1: STRUCTURE/014 "body operations with only scf.if/scf.for regions and no successors"
    if (values[index] < 0) return (int)index;
  }
  return -1;
}

// ====
// RUN: pass pipeline-scf-for
// The importer preserves the schedule expression; the shared pass validates it.
unsigned scheduled(unsigned count, unsigned factor) {
  unsigned total = 0;
  // ERROR@+1: STRUCTURE/014 "a compile-time exact depth"
  [[loom::pipeline(factor)]]
  for (unsigned index = 0; index < count; ++index) {
    total += index;
  }
  return total;
}

