unsigned scheduled(unsigned count, unsigned factor) {
  unsigned total = 0;
  // ERROR@+1: STRUCTURE/014 "a depth in [1, 65535]"
  [[loom::pipeline(0x100000001ULL)]]
  for (unsigned index = 0; index < count; ++index) {
    total += index;
  }
  return total;
}
