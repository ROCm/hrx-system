  %width = func.call pure @launch_width() : () -> (i32)
  %33 = func.call readonly @read_count(%use_left, %left, %left_byte_offset, %right, %right_byte_offset) : (i1, buffer, index, buffer, index) -> (i32)
  %34 = scalar.constant 1 : i32
  %35 = scalar.constant 1 : i32
  %36 = scalar.constant 1 : i32
  %37 = scalar.constant 1 : i32
  %38 = scalar.extui %33 : i32 to i64
  %39 = index.cast %38 : i64 to index
  %40 = scalar.extui %34 : i32 to i64
  %41 = index.cast %40 : i64 to index
  %42 = scalar.extui %35 : i32 to i64
  %43 = index.cast %42 : i64 to index
