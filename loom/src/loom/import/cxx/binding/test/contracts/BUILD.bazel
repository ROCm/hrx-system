load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")
load("//loom/build_tools/bazel:loom_check.bzl", "loom_check_test", "loom_check_test_suite")

package(
    default_visibility = ["//visibility:private"],
    licenses = ["notice"],
)

loom_check_test_suite(
    name = "compiler_test",
    srcs = [
        "assumption_tables.cxx-test",
        "assumption_values.cxx-test",
        "assumptions.cxx-test",
        "assumptions_invalid.cxx-test",
        "config.cxx-test",
        "config_cleanup.cxx-test",
        "config_invalid.cxx-test",
        "constexpr_contract.cxx-test",
        "constexpr_contract_invalid.cxx-test",
        "intrinsics_invalid.cxx-test",
        "parameter_alignment.cxx-test",
        "parameter_alignment_invalid.cxx-test",
        "parameter_noalias.cxx-test",
        "parameter_noalias_invalid.cxx-test",
        "predicate_contracts.cxx-test",
        "predicate_contracts_invalid.cxx-test",
        "schedule_kernels.cxx-test",
        "schedule_lowering.cxx-test",
        "schedule_values.cxx-test",
        "schedules.cxx-test",
        "schedules_invalid.cxx-test",
        "targets.cxx-test",
        "targets_invalid.cxx-test",
        "workload_config.cxx-test",
        "workload_config_invalid.cxx-test",
    ],
    target_compatible_with = loom_config_compatible_with(["//loom/config/import:cxx"]),
)

loom_check_test(
    name = "contracts_export_test",
    src = "contracts_export.cxx-test",
    data = ["//loom/py/loom/tools:loom-export-cxx"],
    env = {
        "LOOM_EXPORT_CXX": "$(rootpath //loom/py/loom/tools:loom-export-cxx)",
    },
    tags = ["skip-bazel_to_cmake"],
    target_compatible_with = loom_config_compatible_with(["//loom/config/import:cxx"]),
)

loom_check_test(
    name = "config_export_test",
    src = "config_export.cxx-test",
    data = ["//loom/py/loom/tools:loom-export-cxx"],
    env = {
        "LOOM_EXPORT_CXX": "$(rootpath //loom/py/loom/tools:loom-export-cxx)",
    },
    tags = ["skip-bazel_to_cmake"],
    target_compatible_with = loom_config_compatible_with(["//loom/config/import:cxx"]),
)
