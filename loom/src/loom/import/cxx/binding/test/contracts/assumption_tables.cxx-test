  %table = buffer.alloca<workgroup> align(16) %183 : buffer
  %23 = scalar.constant 6 : i32
  %24 = scalar.cmpi ult, %lane, %23 : i32
  scf.if %24 {
    %177 = scalar.assume %lane [ge(%lane, 0), lt(%lane, 6)] : i32
    %25 = scalar.constant 10 : i32
    %26 = scalar.addi %177, %25 : i32
    %186 = scalar.constant 2 : i32
    %187 = scalar.shli %177, %186 : i32
    %188 = scalar.extui %187 : i32 to i64
    %32 = scalar.assume %188 [range(%188, 0, 9223372036854775807)] : i64
    %33 = index.cast %32 : i64 to offset
    %34 = buffer.view %table[%33] : buffer -> view<1xi32>
    view.store %26, %34[0] : i32, view<1xi32>
  }
  kernel.barrier<global> scope(workgroup) ordering(acq_rel)
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
