// RUN: pass canonicalize,cse,dce
// Four independent unsigned bounds, including reversed operands,
// constrain indexed workgroup reads without losing their input width.
#include <loomcxx/buffer.h>
#include <loomcxx/kernel.h>
template <class Index>
static LOOM_INLINE void assumed_table_indices(const Index* input,
                                              unsigned* output) {
  unsigned lane = loom::kernel::workitem::id.x;
  auto* table =
      loom::buffer::alloca<unsigned, loom::memory_space::workgroup, 16>(6);
  if (lane < 6u) {
    table[lane] = lane + 10u;
  }
  loom::kernel::workgroup::barrier();

  // Each relation constrains a separate unbounded input. The dynamic-operand
  // assumption must prove both nonnegativity and the table's upper bound.
  Index first = input[4u * lane];
  Index second = input[4u * lane + 1u];
  Index third = input[4u * lane + 2u];
  Index fourth = input[4u * lane + 3u];
  Index count = 6;
  Index last = 5;
  loom::assume(first < count);
  loom::assume(second <= last);
  loom::assume(count > third);
  loom::assume(last >= fourth);
  output[4u * lane] = table[first];
  output[4u * lane + 1u] = table[second];
  output[4u * lane + 2u] = table[third];
  output[4u * lane + 3u] = table[fourth];
}

[[loom::kernel, loom::workgroup_size(32, 1, 1), loom::workgroup_count(1, 1, 1)]]
void assumed_table_u32(const unsigned* input, unsigned* output) {
  assumed_table_indices(input, output);
}
// ----
kernel.def @assumed_table_u32() {
  %2 = index.constant 1 : index
  %5 = index.constant 32 : index
  kernel.launch.config workgroups(%2, %2, %2) workgroup_size(%5, %2, %2) : index
} launch(%input: buffer, %output: buffer) {
  %input_byte_offset = index.constant 0 : index
  func.call @assumed_table_indices_unsigned_int(%input, %input_byte_offset, %output, %input_byte_offset) : (buffer, index, buffer, index)
  kernel.return
}

func.def inline @assumed_table_indices_unsigned_int(%input: buffer, %input_byte_offset: index, %output: buffer, %output_byte_offset: index) {
  %workitem_id_x = kernel.workitem.id<x> : index
  %lane = index.cast %workitem_id_x : index to i32
  %154 = index.constant 24 : offset
  %table = buffer.alloca<workgroup> align(16) %154 : buffer
  %23 = scalar.constant 6 : i32
  %24 = scalar.cmpi ult, %lane, %23 : i32
  scf.if %24 {
    %151 = scalar.assume %lane [ge(%lane, 0), lt(%lane, 6)] : i32
    %25 = scalar.constant 10 : i32
    %26 = scalar.addi %151, %25 : i32
    %27 = scalar.extui %151 : i32 to i64
    %152 = scalar.assume %27 [lt(%27, 6)] : i64
    %28 = index.cast %152 : i64 to index
    %153 = index.assume %28 [lt(%28, 6)] : index
    %29 = index.constant 4 : index
    %30 = index.mul %153, %29 : index
    %32 = buffer.view %table[%30] : buffer -> view<1xi32>
    view.store<root_in_bounds|type_disjoint> %26, %32[0] : i32, view<1xi32>
  }
  kernel.barrier<global> scope(workgroup) ordering(acq_rel)
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %177 = scalar.constant 2 : i32
  %178 = scalar.shli %lane, %177 : i32
  %35 = scalar.extui %178 : i32 to i64
  %36 = index.cast %35 : i64 to index
  %37 = index.constant 4 : index
  %176 = index.madd %36, %37, %input_byte_offset : index
  %40 = buffer.view %input[%176] : buffer -> view<1xi32>
  %first$41 = view.load<root_in_bounds|type_disjoint> %40[0] : view<1xi32> -> i32
  %44 = scalar.constant 1 : i32
  %45 = scalar.addi %178, %44 : i32
  %46 = scalar.extui %45 : i32 to i64
  %47 = index.cast %46 : i64 to index
  %173 = index.madd %47, %37, %input_byte_offset : index
  %51 = buffer.view %input[%173] : buffer -> view<1xi32>
  %second$52 = view.load<root_in_bounds|type_disjoint> %51[0] : view<1xi32> -> i32
  %56 = scalar.addi %178, %177 : i32
  %57 = scalar.extui %56 : i32 to i64
  %58 = index.cast %57 : i64 to index
  %170 = index.madd %58, %37, %input_byte_offset : index
  %62 = buffer.view %input[%170] : buffer -> view<1xi32>
  %third$63 = view.load<root_in_bounds|type_disjoint> %62[0] : view<1xi32> -> i32
  %66 = scalar.constant 3 : i32
  %67 = scalar.addi %178, %66 : i32
  %68 = scalar.extui %67 : i32 to i64
  %69 = index.cast %68 : i64 to index
  %167 = index.madd %69, %37, %input_byte_offset : index
  %73 = buffer.view %input[%167] : buffer -> view<1xi32>
  %fourth$74 = view.load<root_in_bounds|type_disjoint> %73[0] : view<1xi32> -> i32
  %last$76 = scalar.constant 5 : i32
  %first$77, %count$78 = scalar.assume %first$41, %23 [ult(%first$41, %23)] : i32, i32
  %second$79, %last$80 = scalar.assume %second$52, %last$76 [ule(%second$52, %last$76)] : i32, i32
  %count$81, %third$82 = scalar.assume %count$78, %third$63 [ugt(%count$78, %third$63)] : i32, i32
  %last$83, %fourth$84 = scalar.assume %last$80, %fourth$74 [uge(%last$80, %fourth$74)] : i32, i32
  %85 = scalar.extui %first$77 : i32 to i64
  %86 = index.cast %85 : i64 to index
  %88 = index.mul %86, %37 : index
  %90 = buffer.view %table[%88] : buffer -> view<1xi32>
  %91 = view.load<root_in_bounds|type_disjoint> %90[0] : view<1xi32> -> i32
  %164 = index.madd %36, %37, %output_byte_offset : index
  %99 = buffer.view %output[%164] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %91, %99[0] : i32, view<1xi32>
  %100 = scalar.extui %second$79 : i32 to i64
  %101 = index.cast %100 : i64 to index
  %103 = index.mul %101, %37 : index
  %105 = buffer.view %table[%103] : buffer -> view<1xi32>
  %106 = view.load<root_in_bounds|type_disjoint> %105[0] : view<1xi32> -> i32
  %161 = index.madd %47, %37, %output_byte_offset : index
  %116 = buffer.view %output[%161] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %106, %116[0] : i32, view<1xi32>
  %117 = scalar.extui %third$82 : i32 to i64
  %118 = index.cast %117 : i64 to index
  %120 = index.mul %118, %37 : index
  %122 = buffer.view %table[%120] : buffer -> view<1xi32>
  %123 = view.load<root_in_bounds|type_disjoint> %122[0] : view<1xi32> -> i32
  %158 = index.madd %58, %37, %output_byte_offset : index
  %133 = buffer.view %output[%158] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %123, %133[0] : i32, view<1xi32>
  %134 = scalar.extui %fourth$84 : i32 to i64
  %135 = index.cast %134 : i64 to index
  %137 = index.mul %135, %37 : index
  %139 = buffer.view %table[%137] : buffer -> view<1xi32>
  %140 = view.load<root_in_bounds|type_disjoint> %139[0] : view<1xi32> -> i32
  %155 = index.madd %69, %37, %output_byte_offset : index
  %150 = buffer.view %output[%155] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %140, %150[0] : i32, view<1xi32>
  func.return
}

