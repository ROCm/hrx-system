// RUN: roundtrip
// Signed scheduling constants become index operands with explicit ordering.
void entry() {
  [[loom::unroll(3), loom::pipeline(2), loom::schedule("recurrence")]]
  for (unsigned index = 0; index < 16u; ++index) {}
}
// ----
func.def public @entry() {
  %index = scalar.constant 0 : i32
  %1 = index.cast %index : i32 to offset
  %2 = scalar.constant 16 : i32
  %3 = index.cast %2 : i32 to offset
  %4 = index.constant 1 : offset
  %5 = scalar.constant 2 : i32
  %6 = scalar.constant 3 : i32
  %7 = index.cast %5 : i32 to index
  %8 = index.cast %6 : i32 to index
  scf.for %index = [%1 to %3 step %4] pipeline(%7) unroll(%8) schedule(recurrence) {
    %10 = index.cast %index : offset to i32
  }
  func.return
}

// ====
// RUN: roundtrip
// Signed-int counted loops use the signed native index domain.
void entry(int begin, int end) {
  [[loom::unroll(2)]] for (int index = begin; index < end; ++index) {}
}
// ----
func.def public @entry(%begin: i32, %end: i32) {
  %2 = index.cast %begin : i32 to index
  %3 = index.cast %end : i32 to index
  %4 = index.constant 1 : index
  %5 = scalar.constant 2 : i32
  %6 = index.cast %5 : i32 to index
  scf.for %index = [%2 to %3 step %4] unroll(%6) {
    %8 = index.cast %index : index to i32
  }
  func.return
}

// ====
// RUN: roundtrip
// Unsigned operands widen to i64 before entering the signed index domain.
void entry(unsigned factor, unsigned char depth) {
  [[loom::unroll(factor), loom::pipeline(depth)]]
  for (unsigned index = 0; index < 16u; ++index) {}
}
// ----
func.def public @entry(%factor: i32, %depth: i8) {
  %index = scalar.constant 0 : i32
  %3 = index.cast %index : i32 to offset
  %4 = scalar.constant 16 : i32
  %5 = index.cast %4 : i32 to offset
  %6 = index.constant 1 : offset
  %7 = scalar.extui %depth : i8 to i64
  %8 = index.cast %7 : i64 to index
  %9 = scalar.extui %factor : i32 to i64
  %10 = index.cast %9 : i64 to index
  scf.for %index = [%3 to %5 step %6] pipeline(%8) unroll(%10) {
    %12 = index.cast %index : offset to i32
  }
  func.return
}

// ====
// RUN: roundtrip
// Constant loop headers preserve schedules and source conversions.
#define PIXELS 320u
template <unsigned Width, unsigned Step>
static unsigned sum(const unsigned* input, unsigned start) {
  constexpr unsigned lanes = 16;
  unsigned total = 0;
  [[loom::unroll(3), loom::pipeline(2)]]
  for (unsigned index = start; index < (Width / lanes); index += Step / 2u) {
    total += input[index];
  }
  return total;
}
unsigned entry(const unsigned* input, unsigned start) {
  unsigned total = sum<PIXELS, 4>(input, start);
  [[loom::unroll(2)]]
  for (unsigned index = start;
       index < static_cast<unsigned>(sizeof(++start) * 5u); index++) {
    total += input[index];
  }
  [[loom::unroll(2)]]
  for (unsigned index = start; index < (0xffffffffu + 21u);
       index += (1u << 2)) {
    total += input[index];
  }
  return total;
}
// ----
func.def public @entry(%input: buffer, %input_byte_offset: offset, %start: i32) -> (i32) {
  %total$4 = func.call readonly @sum_320_4(%input, %input_byte_offset, %start) : (buffer, offset, i32) -> (i32)
  %5 = index.cast %start : i32 to offset
  %6 = scalar.constant 20 : i32
  %7 = index.cast %6 : i32 to offset
  %8 = index.constant 1 : offset
  %9 = scalar.constant 2 : i32
  %10 = index.cast %9 : i32 to index
  %total$13 = scf.for %index = [%5 to %7 step %8](%total$12 = %total$4 : i32) -> (i32) unroll(%10) {
    %14 = index.cast %index : offset to i32
    %15 = scalar.extui %14 : i32 to i64
    %16 = scalar.constant 4 : i64
    %17 = scalar.muli %15, %16 : i64
    %18 = index.cast %input_byte_offset : offset to i64
    %19 = scalar.addi %18, %17 : i64
    %20 = scalar.assume %19 [range(%19, 0, 9223372036854775807)] : i64
    %21 = index.cast %20 : i64 to offset
    %22 = buffer.view %input[%21] : buffer -> view<1xi32>
    %23 = view.load<root_in_bounds> %22[0] : view<1xi32> -> i32
    %total$24 = scalar.addi %total$12, %23 : i32
    scf.yield %total$24 : i32
  }
  %25 = index.cast %start : i32 to offset
  %26 = scalar.constant 20 : i32
  %27 = index.cast %26 : i32 to offset
  %28 = index.constant 4 : offset
  %29 = scalar.constant 2 : i32
  %30 = index.cast %29 : i32 to index
  %total$33 = scf.for %index = [%25 to %27 step %28](%total$32 = %total$13 : i32) -> (i32) unroll(%30) {
    %34 = index.cast %index : offset to i32
    %35 = scalar.extui %34 : i32 to i64
    %36 = scalar.constant 4 : i64
    %37 = scalar.muli %35, %36 : i64
    %38 = index.cast %input_byte_offset : offset to i64
    %39 = scalar.addi %38, %37 : i64
    %40 = scalar.assume %39 [range(%39, 0, 9223372036854775807)] : i64
    %41 = index.cast %40 : i64 to offset
    %42 = buffer.view %input[%41] : buffer -> view<1xi32>
    %43 = view.load<root_in_bounds> %42[0] : view<1xi32> -> i32
    %total$44 = scalar.addi %total$32, %43 : i32
    scf.yield %total$44 : i32
  }
  func.return %total$33 : i32
}

func.def @sum_320_4(%input: buffer, %input_byte_offset: offset, %start: i32) -> (i32) {
  %lanes = scalar.constant 16 : i32
  %total$50 = scalar.constant 0 : i32
  %51 = index.cast %start : i32 to offset
  %52 = scalar.constant 20 : i32
  %53 = index.cast %52 : i32 to offset
  %54 = index.constant 2 : offset
  %55 = scalar.constant 2 : i32
  %56 = scalar.constant 3 : i32
  %57 = index.cast %55 : i32 to index
  %58 = index.cast %56 : i32 to index
  %total$61 = scf.for %index = [%51 to %53 step %54](%total$60 = %total$50 : i32) -> (i32) pipeline(%57) unroll(%58) {
    %62 = index.cast %index : offset to i32
    %63 = scalar.extui %62 : i32 to i64
    %64 = scalar.constant 4 : i64
    %65 = scalar.muli %63, %64 : i64
    %66 = index.cast %input_byte_offset : offset to i64
    %67 = scalar.addi %66, %65 : i64
    %68 = scalar.assume %67 [range(%67, 0, 9223372036854775807)] : i64
    %69 = index.cast %68 : i64 to offset
    %70 = buffer.view %input[%69] : buffer -> view<1xi32>
    %71 = view.load<root_in_bounds> %70[0] : view<1xi32> -> i32
    %total$72 = scalar.addi %total$60, %71 : i32
    scf.yield %total$72 : i32
  }
  func.return %total$61 : i32
}

// ====
// RUN: roundtrip
// Scheduling expressions retain values until Loom specialization.
[[loom::inline]] static unsigned sum(unsigned count, unsigned factor,
                                           unsigned long long depth) {
  unsigned total = 0;
  [[loom::unroll(factor + 1u), loom::pipeline(depth / sizeof(unsigned)),
    loom::schedule("linear")]]
  for (unsigned index = 0; index < count; ++index) {
    total += index;
  }
  return total;
}
unsigned entry(unsigned count, unsigned factor, unsigned long long depth) {
  return sum(count, factor, depth);
}
// ----
func.def public @entry(%count: i32, %factor: i32, %depth: i64) -> (i32) {
  %4 = func.call pure @sum(%count, %factor, %depth) : (i32, i32, i64) -> (i32)
  func.return %4 : i32
}

func.def inline @sum(%count: i32, %factor: i32, %depth: i64) -> (i32) {
  %total$9 = scalar.constant 0 : i32
  %index = scalar.constant 0 : i32
  %11 = index.cast %index : i32 to offset
  %12 = index.cast %count : i32 to offset
  %13 = index.constant 1 : offset
  %14 = scalar.constant 4 : i64
  %15 = scalar.divui %depth, %14 : i64
  %16 = scalar.constant 1 : i32
  %17 = scalar.addi %factor, %16 : i32
  %18 = index.cast %15 : i64 to index
  %19 = scalar.extui %17 : i32 to i64
  %20 = index.cast %19 : i64 to index
  %total$23 = scf.for %index = [%11 to %12 step %13](%total$22 = %total$9 : i32) -> (i32) pipeline(%18) unroll(%20) schedule(linear) {
    %24 = index.cast %index : offset to i32
    %total$25 = scalar.addi %total$22, %24 : i32
    scf.yield %total$25 : i32
  }
  func.return %total$23 : i32
}

// ====
// RUN: roundtrip
// Schedule numeric policies belong to Loom transforms.
unsigned entry(unsigned count) {
  unsigned total = 0;
  [[loom::unroll(0)]] for (unsigned i = 0; i < count; ++i) { total += i; }
  return total;
}
// ----
func.def public @entry(%count: i32) -> (i32) {
  %total$2 = scalar.constant 0 : i32
  %i = scalar.constant 0 : i32
  %4 = index.cast %i : i32 to offset
  %5 = index.cast %count : i32 to offset
  %6 = index.constant 1 : offset
  %7 = scalar.constant 0 : i32
  %8 = index.cast %7 : i32 to index
  %total$11 = scf.for %i = [%4 to %5 step %6](%total$10 = %total$2 : i32) -> (i32) unroll(%8) {
    %12 = index.cast %i : offset to i32
    %total$13 = scalar.addi %total$10, %12 : i32
    scf.yield %total$13 : i32
  }
  func.return %total$11 : i32
}

