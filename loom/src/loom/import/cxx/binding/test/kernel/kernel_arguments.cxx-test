// RUN: roundtrip
// A typed buffer keeps its source element identity through copies and calls.
#include <loomcxx/kernel.h>
#include <loomcxx/view.h>

using Input = loom::type::buffer<const unsigned>;
static Input forward(Input input) { return input; }

[[loom::kernel, loom::workgroup_size(1, 1, 1),
  loom::workgroup_count(1, 1, 1)]]
void buffers(Input input, loom::type::buffer<unsigned> output) {
  auto retained = forward(input);
  auto source = loom::buffer::view<4>(
      retained, {}, loom::encoding::layout::dense<1>());
  auto target = loom::buffer::view<4>(
      output, {}, loom::encoding::layout::dense<1>());
  loom::view::store(loom::view::load(source, 2), target, 1);
}

// ----
kernel.def @buffers() {
  %2 = index.constant 1 : index
  %3 = index.constant 1 : index
  %4 = index.constant 1 : index
  %5 = index.constant 1 : index
  %6 = index.constant 1 : index
  %7 = index.constant 1 : index
  kernel.launch.config workgroups(%2, %3, %4) workgroup_size(%5, %6, %7) : index
} launch(%input: buffer, %output: buffer) {
  %retained = func.call pure @forward(%input) : (buffer) -> (buffer)
  %source_layout = encoding.layout.dense : encoding<layout>
  %10 = index.constant 0 : offset
  %source = buffer.view %retained[%10] : buffer -> view<4xi32, %source_layout>
  %target_layout = encoding.layout.dense : encoding<layout>
  %13 = index.constant 0 : offset
  %target = buffer.view %output[%13] : buffer -> view<4xi32, %target_layout>
  %15 = scalar.constant 2 : i32
  %16 = index.cast %15 : i32 to index
  %17 = view.load %source[%16] : view<4xi32, %source_layout> -> i32
  %18 = scalar.constant 1 : i32
  %19 = index.cast %18 : i32 to index
  view.store %17, %target[%19] : i32, view<4xi32, %target_layout>
  kernel.return
}

func.def @forward(%input: buffer) -> (buffer) {
  func.return %input : buffer
}

// ====
// Address wrappers retain their distinct logical and physical domains.
#include <loomcxx/kernel.h>

[[loom::kernel, loom::workgroup_size(1, 1, 1),
  loom::workgroup_count(1, 1, 1)]]
void addresses(loom::type::index position, loom::type::offset displacement,
               unsigned long long* output) {
  auto next = position + loom::type::index{1};
  auto bytes = displacement + loom::type::offset{4};
  output[0] = loom::index::cast<unsigned long long>(next);
  output[1] = loom::offset::cast<unsigned long long>(bytes);
}

// ----
kernel.def @addresses() {
  %3 = index.constant 1 : index
  %4 = index.constant 1 : index
  %5 = index.constant 1 : index
  %6 = index.constant 1 : index
  %7 = index.constant 1 : index
  %8 = index.constant 1 : index
  kernel.launch.config workgroups(%3, %4, %5) workgroup_size(%6, %7, %8) : index
} launch(%position: index, %displacement: offset, %output: buffer) {
  %output_byte_offset = index.constant 0 : offset
  %10 = scalar.constant 1 : i32
  %11 = scalar.extsi %10 : i32 to i64
  %12 = index.cast %11 : i64 to index
  %next = index.add %position, %12 : index
  %14 = scalar.constant 4 : i32
  %15 = scalar.extsi %14 : i32 to i64
  %16 = index.cast %15 : i64 to offset
  %bytes = index.add %displacement, %16 : offset
  %18 = index.cast %next : index to i64
  %19 = scalar.constant 0 : i32
  %20 = scalar.extsi %19 : i32 to i64
  %21 = scalar.constant 8 : i64
  %22 = scalar.muli %20, %21 : i64
  %23 = index.cast %output_byte_offset : offset to i64
  %24 = scalar.addi %23, %22 : i64
  %25 = scalar.assume %24 [range(%24, 0, 9223372036854775807)] : i64
  %26 = index.cast %25 : i64 to offset
  %27 = buffer.view %output[%26] : buffer -> view<1xi64>
  view.store %18, %27[0] : i64, view<1xi64>
  %28 = index.cast %bytes : offset to i64
  %29 = scalar.constant 1 : i32
  %30 = scalar.extsi %29 : i32 to i64
  %31 = scalar.constant 8 : i64
  %32 = scalar.muli %30, %31 : i64
  %33 = index.cast %output_byte_offset : offset to i64
  %34 = scalar.addi %33, %32 : i64
  %35 = scalar.assume %34 [range(%34, 0, 9223372036854775807)] : i64
  %36 = index.cast %35 : i64 to offset
  %37 = buffer.view %output[%36] : buffer -> view<1xi64>
  view.store %28, %37[0] : i64, view<1xi64>
  kernel.return
}

// ====
// Semantic and native vectors share High types but keep distinct source kinds.
#include <loomcxx/kernel.h>
#include <loomcxx/vector.h>

using Semantic = loom::type::vector<loom::type::shape<4>, unsigned>;
using Native = unsigned __attribute__((ext_vector_type(4)));
static Semantic forward(Semantic value) { return value; }

[[loom::kernel, loom::workgroup_size(1, 1, 1),
  loom::workgroup_count(1, 1, 1)]]
void vectors(Semantic semantic, Native native, unsigned seed,
             unsigned* output) {
  output[0] = loom::vector::reduce::addi(forward(semantic), seed);
  output[1] = loom::vector::reduce::addi(native, seed);
}

// ----
kernel.def @vectors() {
  %4 = index.constant 1 : index
  %5 = index.constant 1 : index
  %6 = index.constant 1 : index
  %7 = index.constant 1 : index
  %8 = index.constant 1 : index
  %9 = index.constant 1 : index
  kernel.launch.config workgroups(%4, %5, %6) workgroup_size(%7, %8, %9) : index
} launch(%semantic: vector<4xi32>, %native: vector<4xi32>, %seed: i32, %output: buffer) {
  %output_byte_offset = index.constant 0 : offset
  %11 = func.call pure @forward(%semantic) : (vector<4xi32>) -> (vector<4xi32>)
  %12 = vector.reduce<addi> %11, %seed : vector<4xi32>, i32
  %13 = scalar.constant 0 : i32
  %14 = scalar.extsi %13 : i32 to i64
  %15 = scalar.constant 4 : i64
  %16 = scalar.muli %14, %15 : i64
  %17 = index.cast %output_byte_offset : offset to i64
  %18 = scalar.addi %17, %16 : i64
  %19 = scalar.assume %18 [range(%18, 0, 9223372036854775807)] : i64
  %20 = index.cast %19 : i64 to offset
  %21 = buffer.view %output[%20] : buffer -> view<1xi32>
  view.store %12, %21[0] : i32, view<1xi32>
  %22 = vector.reduce<addi> %native, %seed : vector<4xi32>, i32
  %23 = scalar.constant 1 : i32
  %24 = scalar.extsi %23 : i32 to i64
  %25 = scalar.constant 4 : i64
  %26 = scalar.muli %24, %25 : i64
  %27 = index.cast %output_byte_offset : offset to i64
  %28 = scalar.addi %27, %26 : i64
  %29 = scalar.assume %28 [range(%28, 0, 9223372036854775807)] : i64
  %30 = index.cast %29 : i64 to offset
  %31 = buffer.view %output[%30] : buffer -> view<1xi32>
  view.store %22, %31[0] : i32, view<1xi32>
  kernel.return
}

func.def @forward(%value: vector<4xi32>) -> (vector<4xi32>) {
  func.return %value : vector<4xi32>
}

// ====
// The importer preserves admitted static tensor and opaque dialect handles.
#include <loomcxx/check.h>
#include <loomcxx/kernel.h>

using Tensor = loom::type::tensor<loom::type::shape<4>, unsigned>;
struct Handles {
  // Dense check storage transported as one High tensor value.
  Tensor tensor;
  // Opaque completion state transported as one dialect value.
  loom::type::async_group group;
};
static void consume(Handles handles) {}

[[loom::kernel, loom::workgroup_size(1, 1, 1),
  loom::workgroup_count(1, 1, 1)]]
void handles(Tensor tensor, loom::type::async_group group) {
  consume({tensor, group});
}

// ----
kernel.def @handles() {
  %2 = index.constant 1 : index
  %3 = index.constant 1 : index
  %4 = index.constant 1 : index
  %5 = index.constant 1 : index
  %6 = index.constant 1 : index
  %7 = index.constant 1 : index
  kernel.launch.config workgroups(%2, %3, %4) workgroup_size(%5, %6, %7) : index
} launch(%tensor: tensor<4xi32>, %group: kernel.async.group) {
  func.call pure @consume(%tensor, %group) : (tensor<4xi32>, kernel.async.group)
  kernel.return
}

func.def @consume(%handles_tensor: tensor<4xi32>, %handles_group: kernel.async.group) {
  func.return
}

// ====
// Raw pointers, including adjusted array formals, enter at zero byte origin.
#include <loomcxx/kernel.h>
enum class Increment : unsigned { value = 3 };
static unsigned read(const unsigned* pointer) { return pointer[1]; }

[[loom::kernel, loom::workgroup_size(1, 1, 1),
  loom::workgroup_count(1, 1, 1)]]
void pointers(const unsigned input[4], unsigned* output, Increment increment) {
  output[0] = read(input + 1) + static_cast<unsigned>(increment);
}

// ----
kernel.def @pointers() {
  %3 = index.constant 1 : index
  %4 = index.constant 1 : index
  %5 = index.constant 1 : index
  %6 = index.constant 1 : index
  %7 = index.constant 1 : index
  %8 = index.constant 1 : index
  kernel.launch.config workgroups(%3, %4, %5) workgroup_size(%6, %7, %8) : index
} launch(%input: buffer, %output: buffer, %increment: i32) {
  %input_byte_offset = index.constant 0 : offset
  %output_byte_offset = index.constant 0 : offset
  %11 = scalar.constant 1 : i32
  %12 = scalar.extsi %11 : i32 to i64
  %13 = scalar.constant 4 : i64
  %14 = scalar.muli %12, %13 : i64
  %15 = index.cast %input_byte_offset : offset to i64
  %16 = scalar.addi %15, %14 : i64
  %17 = scalar.assume %16 [range(%16, 0, 9223372036854775807)] : i64
  %18 = index.cast %17 : i64 to offset
  %19 = func.call readonly @read(%input, %18) : (buffer, offset) -> (i32)
  %20 = scalar.addi %19, %increment : i32
  %21 = scalar.constant 0 : i32
  %22 = scalar.extsi %21 : i32 to i64
  %23 = scalar.constant 4 : i64
  %24 = scalar.muli %22, %23 : i64
  %25 = index.cast %output_byte_offset : offset to i64
  %26 = scalar.addi %25, %24 : i64
  %27 = scalar.assume %26 [range(%26, 0, 9223372036854775807)] : i64
  %28 = index.cast %27 : i64 to offset
  %29 = buffer.view %output[%28] : buffer -> view<1xi32>
  view.store %20, %29[0] : i32, view<1xi32>
  kernel.return
}

func.def @read(%pointer: buffer, %pointer_byte_offset: offset) -> (i32) {
  %33 = scalar.constant 1 : i32
  %34 = scalar.extsi %33 : i32 to i64
  %35 = scalar.constant 4 : i64
  %36 = scalar.muli %34, %35 : i64
  %37 = index.cast %pointer_byte_offset : offset to i64
  %38 = scalar.addi %37, %36 : i64
  %39 = scalar.assume %38 [range(%38, 0, 9223372036854775807)] : i64
  %40 = index.cast %39 : i64 to offset
  %41 = buffer.view %pointer[%40] : buffer -> view<1xi32>
  %42 = view.load %41[0] : view<1xi32> -> i32
  func.return %42 : i32
}
