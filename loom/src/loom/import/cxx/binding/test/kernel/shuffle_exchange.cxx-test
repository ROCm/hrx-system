// RUN: pass canonicalize,cse,dce
// Topology is published before divergent return. All four shuffle modes
// retain validity and payload checks against the same topology search.
#include <loomcxx/kernel.h>
#include "shuffle_payloads.h"

// The oracle searches actual topology metadata. It assumes neither workitem
// order within a subgroup nor that the final physical subgroup is full.
template <class T>
LOOM_INLINE unsigned mismatch(loom::kernel::subgroup::shuffle_result<T> actual,
                              unsigned source_lane, bool in_range,
                              unsigned subgroup, const unsigned* lanes,
                              const unsigned* subgroups,
                              const unsigned long long* input) {
  bool found = false;
  T expected = payload<T>(0);
  for (unsigned other = 0; other < 83; ++other) {
    if (in_range && other % 4 != 3 && lanes[other] == source_lane &&
        subgroups[other] == subgroup) {
      found = true;
      expected = payload<T>(input[other + 1]);
    }
  }
  unsigned difference = actual.valid != found;
  if (actual.valid && found && !same_bits(actual.value, expected)) {
    difference |= 2;
  }
  return difference;
}

template <class T>
LOOM_INLINE void exchange_values(const unsigned long long* input,
                                 unsigned* output) {
  const unsigned item = loom::kernel::workitem::id.x;
  const unsigned lane = loom::kernel::subgroup::lane_id();
  const unsigned subgroup = loom::kernel::subgroup::id();
  auto* lanes =
      loom::buffer::alloca<unsigned, loom::memory_space::workgroup>(83);
  auto* subgroups =
      loom::buffer::alloca<unsigned, loom::memory_space::workgroup>(83);
  lanes[item] = lane;
  subgroups[item] = subgroup;
  loom::kernel::barrier<loom::memory_space::workgroup,
                        loom::atomic::scope::workgroup,
                        loom::atomic::ordering::acq_rel>();
  if (item % 4 == 3) {
    return;
  }
  const unsigned base = (lane / 16) * 16;
  const unsigned relative = lane % 16;
  T value = payload<T>(input[item + 1]);
  for (unsigned distance = 0; distance < 18; ++distance) {
    const unsigned position = 1 + (distance * 83 + item) * 4;
    output[position] = mismatch(
        loom::kernel::subgroup::shuffle_index(value, distance, 16),
        base + distance, distance < 16, subgroup, lanes, subgroups, input);
    output[position + 1] =
        mismatch(loom::kernel::subgroup::shuffle_xor(value, distance, 16),
                 base + (relative ^ distance), (relative ^ distance) < 16,
                 subgroup, lanes, subgroups, input);
    output[position + 2] =
        mismatch(loom::kernel::subgroup::shuffle_up(value, distance, 16),
                 lane - distance, distance <= relative, subgroup, lanes,
                 subgroups, input);
    output[position + 3] =
        mismatch(loom::kernel::subgroup::shuffle_down(value, distance, 16),
                 lane + distance, relative + distance < 16, subgroup, lanes,
                 subgroups, input);
  }
}

[[loom::kernel, loom::workgroup_size(83, 1, 1), loom::workgroup_count(1, 1, 1)]]
void exchange_u64(const unsigned long long* input, unsigned* output) {
  exchange_values<unsigned long long>(input, output);
}
// ----
kernel.def @exchange_u64() {
  %2 = index.constant 1 : index
  %5 = index.constant 83 : index
  kernel.launch.config workgroups(%2, %2, %2) workgroup_size(%5, %2, %2) : index
} launch(%input: buffer, %output: buffer) {
  %input_byte_offset = index.constant 0 : index
  func.call @exchange_values_unsigned_long_long(%input, %input_byte_offset, %output, %input_byte_offset) : (buffer, index, buffer, index)
  kernel.return
}

func.def inline @exchange_values_unsigned_long_long(%input: buffer, %input_byte_offset: index, %output: buffer, %output_byte_offset: index) {
  %workitem_id_x = kernel.workitem.id<x> : index
  %item = index.cast %workitem_id_x : index to i32
  %16 = kernel.subgroup.lane.id : index
  %lane = index.cast %16 : index to i32
  %18 = kernel.subgroup.id : index
  %subgroup = index.cast %18 : index to i32
  %224 = index.constant 332 : offset
  %lanes = buffer.alloca<workgroup> align(4) %224 : buffer
  %lanes_byte_offset = index.constant 0 : index
  %subgroups = buffer.alloca<workgroup> align(4) %224 : buffer
  %34 = scalar.extui %item : i32 to i64
  %35 = index.cast %34 : i64 to index
  %36 = index.constant 4 : index
  %37 = index.mul %35, %36 : index
  %39 = buffer.view %lanes[%37] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %lane, %39[0] : i32, view<1xi32>
  %45 = buffer.view %subgroups[%37] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %subgroup, %45[0] : i32, view<1xi32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %247 = scalar.constant 3 : i32
  %248 = scalar.andi %item, %247 : i32
  %49 = scalar.cmpi eq, %248, %247 : i32
  %245 = scalar.constant true : i1
  %246 = scalar.xori %49, %245 : i1
  scf.if %246 {
    %243 = scalar.constant 4 : i32
    %244 = scalar.shrui %lane, %243 : i32
    %base = scalar.shli %244, %243 : i32
    %239 = scalar.constant 15 : i32
    %relative = scalar.andi %lane, %239 : i32
    %56 = scalar.constant 1 : i32
    %57 = scalar.addi %item, %56 : i32
    %58 = scalar.extui %57 : i32 to i64
    %59 = index.cast %58 : i64 to index
    %60 = index.constant 8 : index
    %238 = index.madd %59, %60, %input_byte_offset : index
    %63 = buffer.view %input[%238] : buffer -> view<1xi64>
    %64 = view.load<root_in_bounds|type_disjoint> %63[0] : view<1xi64> -> i64
    %value = func.call pure @payload_unsigned_long_long(%64) : (i64) -> (i64)
    %222 = index.constant 0 : offset
    %221 = index.constant 18 : offset
    %70 = index.constant 1 : offset
    scf.for %distance = [%222 to %221 step %70] {
      %72 = index.cast %distance : offset to i32
      %74 = scalar.constant 83 : i32
      %75 = scalar.muli %72, %74 : i32
      %76 = scalar.addi %75, %item : i32
      %236 = scalar.constant 2 : i32
      %237 = scalar.shli %76, %236 : i32
      %position = scalar.addi %237, %56 : i32
      %80 = scalar.constant 16 : i32
      %81, %82 = kernel.subgroup.shuffle<index> %value, %72, %80 : i64, i32, i32
      %83 = scalar.addi %base, %72 : i32
      %85 = scalar.cmpi ult, %72, %80 : i32
      %86 = func.call readonly @mismatch_unsigned_long_long(%81, %82, %83, %85, %subgroup, %lanes, %lanes_byte_offset, %subgroups, %lanes_byte_offset, %input, %input_byte_offset) : (i64, i1, i32, i1, i32, buffer, index, buffer, index, buffer, index) -> (i32)
      %87 = scalar.extui %position : i32 to i64
      %88 = index.cast %87 : i64 to index
      %234 = index.madd %88, %36, %output_byte_offset : index
      %92 = buffer.view %output[%234] : buffer -> view<1xi32>
      view.store<root_in_bounds|type_disjoint> %86, %92[0] : i32, view<1xi32>
      %94, %95 = kernel.subgroup.shuffle<xor> %value, %72, %80 : i64, i32, i32
      %96 = scalar.xori %relative, %72 : i32
      %97 = scalar.addi %base, %96 : i32
      %100 = scalar.cmpi ult, %96, %80 : i32
      %101 = func.call readonly @mismatch_unsigned_long_long(%94, %95, %97, %100, %subgroup, %lanes, %lanes_byte_offset, %subgroups, %lanes_byte_offset, %input, %input_byte_offset) : (i64, i1, i32, i1, i32, buffer, index, buffer, index, buffer, index) -> (i32)
      %233 = scalar.addi %237, %236 : i32
      %104 = scalar.extui %233 : i32 to i64
      %105 = index.cast %104 : i64 to index
      %231 = index.madd %105, %36, %output_byte_offset : index
      %109 = buffer.view %output[%231] : buffer -> view<1xi32>
      view.store<root_in_bounds|type_disjoint> %101, %109[0] : i32, view<1xi32>
      %111, %112 = kernel.subgroup.shuffle<up> %value, %72, %80 : i64, i32, i32
      %113 = scalar.subi %lane, %72 : i32
      %114 = scalar.cmpi ule, %72, %relative : i32
      %115 = func.call readonly @mismatch_unsigned_long_long(%111, %112, %113, %114, %subgroup, %lanes, %lanes_byte_offset, %subgroups, %lanes_byte_offset, %input, %input_byte_offset) : (i64, i1, i32, i1, i32, buffer, index, buffer, index, buffer, index) -> (i32)
      %230 = scalar.addi %237, %247 : i32
      %118 = scalar.extui %230 : i32 to i64
      %119 = index.cast %118 : i64 to index
      %228 = index.madd %119, %36, %output_byte_offset : index
      %123 = buffer.view %output[%228] : buffer -> view<1xi32>
      view.store<root_in_bounds|type_disjoint> %115, %123[0] : i32, view<1xi32>
      %125, %126 = kernel.subgroup.shuffle<down> %value, %72, %80 : i64, i32, i32
      %127 = scalar.addi %lane, %72 : i32
      %128 = scalar.addi %relative, %72 : i32
      %130 = scalar.cmpi ult, %128, %80 : i32
      %131 = func.call readonly @mismatch_unsigned_long_long(%125, %126, %127, %130, %subgroup, %lanes, %lanes_byte_offset, %subgroups, %lanes_byte_offset, %input, %input_byte_offset) : (i64, i1, i32, i1, i32, buffer, index, buffer, index, buffer, index) -> (i32)
      %227 = scalar.addi %237, %243 : i32
      %134 = scalar.extui %227 : i32 to i64
      %135 = index.cast %134 : i64 to index
      %225 = index.madd %135, %36, %output_byte_offset : index
      %139 = buffer.view %output[%225] : buffer -> view<1xi32>
      view.store<root_in_bounds|type_disjoint> %131, %139[0] : i32, view<1xi32>
    }
  }
  func.return
}

func.def inline @payload_unsigned_long_long(%bits: i64) -> (i64) {
  func.return %bits : i64
}

func.def inline @mismatch_unsigned_long_long(%actual_value: i64, %actual_valid: i1, %source_lane: i32, %in_range: i1, %subgroup: i32, %lanes: buffer, %lanes_byte_offset: index, %subgroups: buffer, %subgroups_byte_offset: index, %input: buffer, %input_byte_offset: index) -> (i32) {
  %found$154 = scalar.constant 0 : i1
  %261 = scalar.constant 0 : i64
  %expected$157 = func.call pure @payload_unsigned_long_long(%261) : (i64) -> (i64)
  %260 = index.constant 0 : offset
  %259 = index.constant 83 : offset
  %162 = index.constant 1 : offset
  %found$166, %expected$167 = scf.for %other = [%260 to %259 step %162](%found$164 = %found$154 : i1, %expected$165 = %expected$157 : i64) -> (i1, i64) {
    %168 = index.cast %other : offset to i32
    %262 = scalar.constant 3 : i32
    %263 = scalar.andi %168, %262 : i32
    %173 = scalar.cmpi ne, %263, %262 : i32
    %258 = scalar.constant false : i1
    %267 = scf.select %in_range, %173, %258 : i1
    %174 = scf.if %267 -> (i1) {
      %175 = scalar.extui %168 : i32 to i64
      %176 = index.cast %175 : i64 to index
      %177 = index.constant 4 : index
      %264 = index.madd %176, %177, %lanes_byte_offset : index
      %180 = buffer.view %lanes[%264] : buffer -> view<1xi32>
      %181 = view.load<root_in_bounds|type_disjoint> %180[0] : view<1xi32> -> i32
      %182 = scalar.cmpi eq, %181, %source_lane : i32
      scf.yield %182 : i1
    } else {
      scf.yield %258 : i1
    }
    %183 = scf.if %174 -> (i1) {
      %184 = scalar.extui %168 : i32 to i64
      %185 = index.cast %184 : i64 to index
      %186 = index.constant 4 : index
      %265 = index.madd %185, %186, %subgroups_byte_offset : index
      %189 = buffer.view %subgroups[%265] : buffer -> view<1xi32>
      %190 = view.load<root_in_bounds|type_disjoint> %189[0] : view<1xi32> -> i32
      %191 = scalar.cmpi eq, %190, %subgroup : i32
      scf.yield %191 : i1
    } else {
      scf.yield %258 : i1
    }
    %found$192, %expected$193 = scf.if %183 -> (i1, i64) {
      %found = scalar.constant 1 : i1
      %195 = scalar.constant 1 : i32
      %196 = scalar.addi %168, %195 : i32
      %197 = scalar.extui %196 : i32 to i64
      %198 = index.cast %197 : i64 to index
      %199 = index.constant 8 : index
      %266 = index.madd %198, %199, %input_byte_offset : index
      %202 = buffer.view %input[%266] : buffer -> view<1xi64>
      %203 = view.load<root_in_bounds|type_disjoint> %202[0] : view<1xi64> -> i64
      %expected = func.call pure @payload_unsigned_long_long(%203) : (i64) -> (i64)
      scf.yield %found, %expected : i1, i64
    } else {
      scf.yield %found$164, %expected$165 : i1, i64
    }
    scf.yield %found$192, %expected$193 : i1, i64
  }
  %205 = scalar.extui %actual_valid : i1 to i32
  %206 = scalar.extui %found$166 : i1 to i32
  %207 = scalar.cmpi ne, %205, %206 : i32
  %difference$208 = scalar.extui %207 : i1 to i32
  %255 = scalar.constant false : i1
  %269 = scf.select %actual_valid, %found$166, %255 : i1
  %210 = scf.if %269 -> (i1) {
    %211 = func.call pure @same_bits_unsigned_long_long(%actual_value, %expected$167) : (i64, i64) -> (i1)
    %212 = scalar.constant 1 : i1
    %213 = scalar.xori %211, %212 : i1
    scf.yield %213 : i1
  } else {
    scf.yield %255 : i1
  }
  %215 = scalar.constant 2 : i32
  %difference$216 = scalar.ori %difference$208, %215 : i32
  %difference$268 = scf.select %210, %difference$216, %difference$208 : i32
  func.return %difference$268 : i32
}

func.def inline @same_bits_unsigned_long_long(%left: i64, %right: i64) -> (i1) {
  %220 = scalar.cmpi eq, %left, %right : i64
  func.return %220 : i1
}
