      %89 = scalar.addi %base, %78 : i32
      %91 = scalar.cmpi ult, %78, %86 : i32
      %92 = func.call readonly @mismatch_unsigned_long_long(%87, %88, %89, %91, %subgroup, %lanes, %lanes_byte_offset, %subgroups, %lanes_byte_offset, %input, %input_byte_offset) : (i64, i1, i32, i1, i32, buffer, offset, buffer, offset, buffer, offset) -> (i32)
      %93 = scalar.extui %position : i32 to i64
