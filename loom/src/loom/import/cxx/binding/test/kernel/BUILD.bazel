load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")
load("//loom/build_tools/bazel:loom_check.bzl", "loom_check_test", "loom_check_test_suite")

package(
    default_visibility = ["//visibility:private"],
    licenses = ["notice"],
)

loom_check_test_suite(
    name = "compiler_test",
    srcs = [
        "async.cxx-test",
        "async_invalid.cxx-test",
        "atomic_builtins.cxx-test",
        "atomic_compare_values.cxx-test",
        "atomic_fetch_values.cxx-test",
        "atomic_kernels.cxx-test",
        "atomic_observers.cxx-test",
        "atomic_publication.cxx-test",
        "atomic_sequences.cxx-test",
        "atomics.cxx-test",
        "atomics_invalid.cxx-test",
        "barrier_helpers.cxx-test",
        "collective_scans.cxx-test",
        "configured_workgroup_storage.cxx-test",
        "kernel_arguments.cxx-test",
        "kernel_arguments_invalid.cxx-test",
        "kernel_callers.cxx-test",
        "kernel_intrinsics.cxx-test",
        "kernel_intrinsics_invalid.cxx-test",
        "launch.cxx-test",
        "launch_invalid.cxx-test",
        "scans.cxx-test",
        "scans_invalid.cxx-test",
        "shuffle_exchange.cxx-test",
        "shuffle_payloads.cxx-test",
        "subgroup_reductions.cxx-test",
        "subgroup_reductions_invalid.cxx-test",
        "subgroup_shuffles.cxx-test",
        "subgroup_shuffles_invalid.cxx-test",
        "subgroups.cxx-test",
        "subgroups_invalid.cxx-test",
        "workgroup_reductions.cxx-test",
    ],
    data = ["shuffle_payloads.h"],
    target_compatible_with = loom_config_compatible_with(["//loom/config/import:cxx"]),
)

loom_check_test(
    name = "kernel_export_test",
    src = "kernel_export.cxx-test",
    data = ["//loom/py/loom/tools:loom-export-cxx"],
    env = {
        "LOOM_EXPORT_CXX": "$(rootpath //loom/py/loom/tools:loom-export-cxx)",
    },
    tags = ["skip-bazel_to_cmake"],
    target_compatible_with = loom_config_compatible_with(["//loom/config/import:cxx"]),
)
