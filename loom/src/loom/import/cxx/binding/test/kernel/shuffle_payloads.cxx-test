// ====
// RUN: pass canonicalize,cse,dce
// Boolean payloads compare truth values and use only the source low bit.
#include "shuffle_payloads.h"

bool make_payload(unsigned long long bits) {
  return payload<bool>(bits);
}
bool compare_payload(bool left, bool right) {
  return same_bits(left, right);
}
// ----
func.def public @make_payload(%bits: i64) -> (i1) {
  %2 = func.call pure @payload_bool(%bits) : (i64) -> (i1)
  func.return %2 : i1
}

func.def public @compare_payload(%left: i1, %right: i1) -> (i1) {
  %6 = func.call pure @same_bits_bool(%left, %right) : (i1, i1) -> (i1)
  func.return %6 : i1
}

func.def inline @payload_bool(%bits: i64) -> (i1) {
  %22 = scalar.constant 1 : i64
  %11 = scalar.andi %bits, %22 : i64
  %21 = scalar.constant 0 : i64
  %14 = scalar.cmpi ne, %11, %21 : i64
  func.return %14 : i1
}

func.def inline @same_bits_bool(%left: i1, %right: i1) -> (i1) {
  %18 = scalar.extui %left : i1 to i32
  %19 = scalar.extui %right : i1 to i32
  %20 = scalar.cmpi eq, %18, %19 : i32
  func.return %20 : i1
}

// ====
// RUN: pass canonicalize,cse,dce
// Encoded floating payloads retain their object bits rather than converting.
#include "shuffle_payloads.h"

loom::type::float8_e4m3fn_t make_payload(unsigned long long bits) {
  return payload<loom::type::float8_e4m3fn_t>(bits);
}
bool compare_payload(loom::type::float8_e4m3fn_t left,
                     loom::type::float8_e4m3fn_t right) {
  return same_bits(left, right);
}
// ----
func.def public @make_payload(%bits: i64) -> (f8E4M3) {
  %2 = func.call pure @payload___float8_e4m3fn(%bits) : (i64) -> (f8E4M3)
  func.return %2 : f8E4M3
}

func.def public @compare_payload(%left: f8E4M3, %right: f8E4M3) -> (i1) {
  %6 = func.call pure @same_bits___float8_e4m3fn(%left, %right) : (f8E4M3, f8E4M3) -> (i1)
  func.return %6 : i1
}

func.def inline @payload___float8_e4m3fn(%bits: i64) -> (f8E4M3) {
  %9 = scalar.trunci %bits : i64 to i8
  %10 = scalar.bitcast %9 : i8 to f8E4M3
  func.return %10 : f8E4M3
}

func.def inline @same_bits___float8_e4m3fn(%left: f8E4M3, %right: f8E4M3) -> (i1) {
  %14 = scalar.bitcast %left : f8E4M3 to i8
  %15 = scalar.extui %14 : i8 to i32
  %16 = scalar.bitcast %right : f8E4M3 to i8
  %17 = scalar.extui %16 : i8 to i32
  %18 = scalar.cmpi eq, %15, %17 : i32
  func.return %18 : i1
}

// ====
// RUN: pass canonicalize,cse,dce
// Four-byte floating payloads compare integer object representations.
#include "shuffle_payloads.h"

float make_payload(unsigned long long bits) {
  return payload<float>(bits);
}
bool compare_payload(float left, float right) {
  return same_bits(left, right);
}
// ----
func.def public @make_payload(%bits: i64) -> (f32) {
  %2 = func.call pure @payload_float(%bits) : (i64) -> (f32)
  func.return %2 : f32
}

func.def public @compare_payload(%left: f32, %right: f32) -> (i1) {
  %6 = func.call pure @same_bits_float(%left, %right) : (f32, f32) -> (i1)
  func.return %6 : i1
}

func.def inline @payload_float(%bits: i64) -> (f32) {
  %9 = scalar.trunci %bits : i64 to i32
  %10 = scalar.bitcast %9 : i32 to f32
  func.return %10 : f32
}

func.def inline @same_bits_float(%left: f32, %right: f32) -> (i1) {
  %14 = scalar.bitcast %left : f32 to i32
  %15 = scalar.bitcast %right : f32 to i32
  %16 = scalar.cmpi eq, %14, %15 : i32
  func.return %16 : i1
}

// ====
// RUN: pass canonicalize,cse,dce
