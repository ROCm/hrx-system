// RUN: pass canonicalize,cse,dce
// Wide payloads preserve per-component fingerprints and bitwise comparisons
// through source vector insertion and extraction, including floating NaNs.
#include "shuffle_payloads.h"
Bytes32 make_payload(unsigned long long bits) {
  return payload<Bytes32>(bits);
}
bool compare_payload(Bytes32 left, Bytes32 right) {
  return same_bits(left, right);
}
// ----
func.def public @make_payload(%bits: i64) -> (vector<32xi8>) {
  %2 = func.call pure @payload_unsigned_char___attribute____ext_vector_type_32___(%bits) : (i64) -> (vector<32xi8>)
  func.return %2 : vector<32xi8>
}

func.def public @compare_payload(%left: vector<32xi8>, %right: vector<32xi8>) -> (i1) {
  %6 = func.call pure @same_bits_unsigned_char___attribute____ext_vector_type_32___(%left, %right) : (vector<32xi8>, vector<32xi8>) -> (i1)
  func.return %6 : i1
}

func.def inline @payload_unsigned_char___attribute____ext_vector_type_32___(%bits: i64) -> (vector<32xi8>) {
  %values$60 = vector.splati 0 : vector<32xi8>
  %59 = index.constant 0 : offset
  %58 = index.constant 32 : offset
  %14 = index.constant 1 : offset
  %values$17 = scf.for %component = [%59 to %58 step %14](%values$16 = %values$60 : vector<32xi8>) -> (vector<32xi8>) {
    %18 = index.cast %component : offset to i32
    %19 = scalar.constant 37669 : i64
    %20 = scalar.extui %18 : i32 to i64
    %21 = scalar.muli %19, %20 : i64
    %22 = scalar.xori %bits, %21 : i64
    %23 = func.call pure @payload_unsigned_char(%22) : (i64) -> (i8)
    %24 = index.cast %18 : i32 to index
    %values$25 = vector.insert %23 into %values$16[%24] : i8, vector<32xi8>
    scf.yield %values$25 : vector<32xi8>
  }
  func.return %values$17 : vector<32xi8>
}

func.def inline @same_bits_unsigned_char___attribute____ext_vector_type_32___(%left: vector<32xi8>, %right: vector<32xi8>) -> (i1) {
  %equal$29 = scalar.constant 1 : i1
  %62 = index.constant 0 : offset
  %61 = index.constant 32 : offset
  %34 = index.constant 1 : offset
  %equal$37 = scf.for %component = [%62 to %61 step %34](%equal$36 = %equal$29 : i1) -> (i1) {
    %38 = index.cast %component : offset to i32
    %39 = index.cast %38 : i32 to index
    %40 = vector.extract %left[%39] : vector<32xi8> -> i8
    %42 = vector.extract %right[%39] : vector<32xi8> -> i8
    %43 = func.call pure @same_bits_unsigned_char(%40, %42) : (i8, i8) -> (i1)
    %44 = scalar.extui %43 : i1 to i32
    %45 = scalar.extui %equal$36 : i1 to i32
    %46 = scalar.andi %45, %44 : i32
    %47 = scalar.constant 0 : i32
    %equal$48 = scalar.cmpi ne, %46, %47 : i32
    scf.yield %equal$48 : i1
  }
  func.return %equal$37 : i1
}

func.def inline @payload_unsigned_char(%bits: i64) -> (i8) {
  %51 = scalar.trunci %bits : i64 to i8
  func.return %51 : i8
}

func.def inline @same_bits_unsigned_char(%left: i8, %right: i8) -> (i1) {
  %55 = scalar.extui %left : i8 to i32
  %56 = scalar.extui %right : i8 to i32
  %57 = scalar.cmpi eq, %55, %56 : i32
  func.return %57 : i1
}

