  %6 = func.call pure @same_bits_double(%left, %right) : (f64, f64) -> (i1)
  func.return %6 : i1
}

func.def inline @payload_double(%bits: i64) -> (f64) {
  %9 = scalar.bitcast %bits : i64 to f64
  func.return %9 : f64
}

func.def inline @same_bits_double(%left: f64, %right: f64) -> (i1) {
  %13 = scalar.bitcast %left : f64 to i64
  %14 = scalar.bitcast %right : f64 to i64
  %15 = scalar.cmpi eq, %13, %14 : i64
  func.return %15 : i1
}

// ====
// RUN: pass canonicalize,cse,dce
// Sixteen-byte payloads retain all four fingerprint words and
// short-circuit comparisons.
#include "shuffle_payloads.h"

using Floats4 = float __attribute__((ext_vector_type(4)));
Floats4 make_payload(unsigned long long bits) {
  return payload<Floats4>(bits);
}
bool compare_payload(Floats4 left, Floats4 right) {
  return same_bits(left, right);
}
// ----
func.def public @make_payload(%bits: i64) -> (vector<4xf32>) {
  %2 = func.call pure @payload_float___attribute____ext_vector_type_4___(%bits) : (i64) -> (vector<4xf32>)
  func.return %2 : vector<4xf32>
}

func.def public @compare_payload(%left: vector<4xf32>, %right: vector<4xf32>) -> (i1) {
  %6 = func.call pure @same_bits_float___attribute____ext_vector_type_4___(%left, %right) : (vector<4xf32>, vector<4xf32>) -> (i1)
  func.return %6 : i1
}

func.def inline @payload_float___attribute____ext_vector_type_4___(%bits: i64) -> (vector<4xf32>) {
  %9 = scalar.trunci %bits : i64 to i32
  %66 = scalar.constant 32 : i64
  %12 = scalar.shrui %bits, %66 : i64
  %13 = scalar.trunci %12 : i64 to i32
  %65 = scalar.constant 1933650197 : i64
  %16 = scalar.xori %bits, %65 : i64
  %17 = scalar.trunci %16 : i64 to i32
  %63 = scalar.constant 3560564659 : i64
  %23 = scalar.xori %12, %63 : i64
  %24 = scalar.trunci %23 : i64 to i32
  %words = vector.from_elements %9, %13, %17, %24 : vector<4xi32>
  %26 = vector.bitcast %words : vector<4xi32> to vector<4xf32>
  func.return %26 : vector<4xf32>
}

func.def inline @same_bits_float___attribute____ext_vector_type_4___(%left: vector<4xf32>, %right: vector<4xf32>) -> (i1) {
  %a = vector.bitcast %left : vector<4xf32> to vector<4xi32>
  %b = vector.bitcast %right : vector<4xf32> to vector<4xi32>
  %74 = vector.extract %a[0] : vector<4xi32> -> i32
  %73 = vector.extract %b[0] : vector<4xi32> -> i32
  %38 = scalar.cmpi eq, %74, %73 : i32
  %72 = vector.extract %a[1] : vector<4xi32> -> i32
  %71 = vector.extract %b[1] : vector<4xi32> -> i32
  %46 = scalar.cmpi eq, %72, %71 : i32
  %81 = scf.select %38, %46, %38 : i1
  %70 = vector.extract %a[2] : vector<4xi32> -> i32
  %69 = vector.extract %b[2] : vector<4xi32> -> i32
  %54 = scalar.cmpi eq, %70, %69 : i32
  %78 = scalar.constant false : i1
  %80 = scf.select %81, %54, %78 : i1
  %68 = vector.extract %a[3] : vector<4xi32> -> i32
  %67 = vector.extract %b[3] : vector<4xi32> -> i32
  %62 = scalar.cmpi eq, %68, %67 : i32
  %79 = scf.select %80, %62, %78 : i1
  func.return %79 : i1
}
