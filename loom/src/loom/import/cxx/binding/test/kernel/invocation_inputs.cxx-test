// RUN: pass inline-callables{stage=prepare},canonicalize,cse,dce
#include <loomcxx/kernel.h>

// The numeric helper can stay outlined while a required wrapper disappears.
[[loom::inline]] static unsigned lane() {
  return static_cast<unsigned>(loom::kernel::workitem::id.x);
}

[[loom::noinline]] static unsigned position(unsigned bias) {
  return lane() + bias + static_cast<unsigned>(loom::kernel::workgroup::size.x);
}

[[loom::kernel, loom::workgroup_size(64, 1, 1), loom::workgroup_count(1, 1, 1)]]
void shifted(unsigned* output, unsigned bias) {
  output[lane()] = position(bias);
}

// ----
kernel.def @shifted() {
  %2 = index.constant 1 : index
  %5 = index.constant 64 : index
  kernel.launch.config workgroups(%2, %2, %2) workgroup_size(%5, %2, %2) : index
} launch(%output: buffer, %bias: i32) {
  %workgroup_size_x = index.constant 64 : index
  %workitem_id_x = kernel.workitem.id<x> : index
  %32 = func.call pure @position(%bias, %workgroup_size_x, %workitem_id_x) : (i32, index, index) -> (i32)
  %35 = index.cast %workitem_id_x : index to i32
  %11 = scalar.extui %35 : i32 to i64
  %12 = index.cast %11 : i64 to index
  %13 = index.constant 4 : index
  %14 = index.mul %12, %13 : index
  %16 = buffer.view %output[%14] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %32, %16[0] : i32, view<1xi32>
  kernel.return
}

func.def noinline @position(%bias: i32, %workgroup_size_x: index, %workitem_id_x: index) -> (i32) {
  %26 = index.cast %workitem_id_x : index to i32
  %20 = scalar.addi %26, %bias : i32
  %22 = index.cast %workgroup_size_x : index to i32
  %23 = scalar.addi %20, %22 : i32
  func.return %23 : i32
}

// ====

#include <loomcxx/kernel.h>

// The two entry geometries supply different values to one retained helper.
[[loom::noinline]] static unsigned width_plus(unsigned value) {
  return value + static_cast<unsigned>(loom::kernel::workgroup::size.x);
}

[[loom::kernel, loom::workgroup_size(32, 1, 1), loom::workgroup_count(1, 1, 1)]]
void narrow(unsigned* output, unsigned value) {
  output[loom::kernel::workitem::id.x] = width_plus(value);
}

[[loom::kernel, loom::workgroup_size(64, 1, 1), loom::workgroup_count(1, 1, 1)]]
void wide(unsigned* output, unsigned value) {
  output[loom::kernel::workitem::id.x] = width_plus(value);
}

// ----
kernel.def @narrow() {
  %2 = index.constant 1 : index
  %5 = index.constant 32 : index
  kernel.launch.config workgroups(%2, %2, %2) workgroup_size(%5, %2, %2) : index
} launch(%output: buffer, %value: i32) {
  %workgroup_size_x = index.constant 32 : index
  %45 = func.call pure @width_plus(%value, %workgroup_size_x) : (i32, index) -> (i32)
  %workitem_id_x = kernel.workitem.id<x> : index
  %11 = index.cast %workitem_id_x : index to i32
  %12 = scalar.extui %11 : i32 to i64
  %13 = index.cast %12 : i64 to index
  %14 = index.constant 4 : index
  %15 = index.mul %13, %14 : index
  %17 = buffer.view %output[%15] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %45, %17[0] : i32, view<1xi32>
  kernel.return
}

kernel.def @wide() {
  %20 = index.constant 1 : index
  %23 = index.constant 64 : index
  kernel.launch.config workgroups(%20, %20, %20) workgroup_size(%23, %20, %20) : index
} launch(%output: buffer, %value: i32) {
  %workgroup_size_x = index.constant 64 : index
  %44 = func.call pure @width_plus(%value, %workgroup_size_x) : (i32, index) -> (i32)
  %workitem_id_x = kernel.workitem.id<x> : index
  %29 = index.cast %workitem_id_x : index to i32
  %30 = scalar.extui %29 : i32 to i64
  %31 = index.cast %30 : i64 to index
  %32 = index.constant 4 : index
  %33 = index.mul %31, %32 : index
  %35 = buffer.view %output[%33] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %44, %35[0] : i32, view<1xi32>
  kernel.return
}

func.def noinline @width_plus(%value: i32, %workgroup_size_x: index) -> (i32) {
  %39 = index.cast %workgroup_size_x : index to i32
  %40 = scalar.addi %value, %39 : i32
  func.return %40 : i32
}

// ====

#include <loomcxx/kernel.h>

// Subgroup queries use the same stable input contract as coordinate members.
[[loom::noinline]] static unsigned subgroup() {
  return static_cast<unsigned>(loom::kernel::subgroup::id())
      + static_cast<unsigned>(loom::kernel::subgroup::count())
      + static_cast<unsigned>(loom::kernel::subgroup::size())
      + static_cast<unsigned>(loom::kernel::subgroup::lane_id());
}

[[loom::kernel, loom::workgroup_size(64, 1, 1), loom::workgroup_count(1, 1, 1)]]
void topology(unsigned* output) {
  output[loom::kernel::workitem::id.x] = subgroup();
}

// ----
kernel.def @topology() {
  %1 = index.constant 1 : index
  %4 = index.constant 64 : index
  kernel.launch.config workgroups(%1, %1, %1) workgroup_size(%4, %1, %1) : index
} launch(%output: buffer) {
  %33 = kernel.subgroup.id : index
  %34 = kernel.subgroup.count : index
  %35 = kernel.subgroup.size : index
  %36 = kernel.subgroup.lane.id : index
  %37 = func.call pure @subgroup(%33, %34, %35, %36) : (index, index, index, index) -> (i32)
  %workitem_id_x = kernel.workitem.id<x> : index
  %10 = index.cast %workitem_id_x : index to i32
  %11 = scalar.extui %10 : i32 to i64
  %12 = index.cast %11 : i64 to index
  %13 = index.constant 4 : index
  %14 = index.mul %12, %13 : index
  %16 = buffer.view %output[%14] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %37, %16[0] : i32, view<1xi32>
  kernel.return
}

func.def noinline @subgroup(%29: index, %30: index, %31: index, %32: index) -> (i32) {
  %19 = index.cast %29 : index to i32
  %21 = index.cast %30 : index to i32
  %22 = scalar.addi %19, %21 : i32
  %24 = index.cast %31 : index to i32
  %25 = scalar.addi %22, %24 : i32
  %27 = index.cast %32 : index to i32
  %28 = scalar.addi %25, %27 : i32
  func.return %28 : i32
}
