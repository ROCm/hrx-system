// RUN: pass canonicalize,cse,dce
// The complete i32 sequence retains old-value observations, min/max signedness,
// reduction effects, all orderings, and compare-exchange return values.
#include <loomcxx/atomic.h>
#include <loomcxx/kernel.h>
using loom::atomic::kind;
using loom::atomic::ordering;
using loom::atomic::scope;
using loom::view::atomic::cmpxchg;
using loom::view::atomic::reduce;
using loom::view::atomic::rmw;

template <kind Minimum, kind Maximum, class T>
static unsigned sequence(volatile T* destination) {
  constexpr T minimum = Minimum == kind::minsi ? T(-2) : T(30);
  constexpr T maximum = Maximum == kind::maxsi ? T(2) : T(-2);
  unsigned passed = 0;
  if (rmw<kind::xchgi, ordering::relaxed, scope::device>(T(-4), destination) ==
      T(37)) {
    passed |= 1;
  }
  if (rmw<kind::addi, ordering::relaxed, scope::device>(T(3), destination) ==
      T(-4)) {
    passed |= 2;
  }
  if (rmw<kind::subi, ordering::relaxed, scope::device>(T(2), destination) ==
      T(-1)) {
    passed |= 4;
  }
  if (rmw<kind::andi, ordering::relaxed, scope::device>(T(15), destination) ==
      T(-3)) {
    passed |= 8;
  }
  if (rmw<kind::ori, ordering::relaxed, scope::device>(T(16), destination) ==
      T(13)) {
    passed |= 16;
  }
  if (rmw<kind::xori, ordering::relaxed, scope::device>(T(3), destination) ==
      T(29)) {
    passed |= 32;
  }
  if (rmw<Minimum, ordering::relaxed, scope::device>(T(-2), destination) ==
      T(30)) {
    passed |= 64;
  }
  if (rmw<Maximum, ordering::relaxed, scope::device>(T(2), destination) ==
      minimum) {
    passed |= 128;
  }
  // Unsigned maximum also exercises the high half of the representation.
  reduce<Maximum, ordering::relaxed, scope::device>(maximum, destination);
  if (cmpxchg<ordering::acq_rel, ordering::acquire, scope::device>(
          maximum, T(7), destination) == maximum) {
    passed |= 256;
  }
  if (cmpxchg<ordering::acquire, ordering::relaxed, scope::device>(
          T(5), T(11), destination) == T(7)) {
    passed |= 512;
  }
  reduce<kind::addi, ordering::release, scope::device>(T(5), destination);
  if (cmpxchg<ordering::seq_cst, ordering::seq_cst, scope::device>(
          T(12), T(13), destination) == T(12)) {
    passed |= 1024;
  }
  return passed;
}

unsigned atomic_i32(int* storage) {
  return sequence<kind::minsi, kind::maxsi>(storage + 1);
}
// ----
func.def public @atomic_i32(%storage: buffer, %storage_byte_offset: index) -> (i32) {
  %116 = index.constant 4 : index
  %7 = index.add %storage_byte_offset, %116 : index
  %8 = func.call @sequence_8_9_int(%storage, %7) : (buffer, index) -> (i32)
  func.return %8 : i32
}

func.def @sequence_8_9_int(%destination: buffer, %destination_byte_offset: index) -> (i32) {
  %minimum = scalar.constant -2 : i32
  %maximum = scalar.constant 2 : i32
  %passed$14 = scalar.constant 0 : i32
  %122 = scalar.constant -4 : i32
  %18 = buffer.view %destination[%destination_byte_offset] : buffer -> view<1xi32>
  %19 = view.atomic.rmw<xchgi, root_in_bounds|type_disjoint> %122, %18[0] {ordering = relaxed, scope = device} : i32, view<1xi32> -> i32
  %20 = scalar.constant 37 : i32
  %21 = scalar.cmpi eq, %19, %20 : i32
  %passed$121 = scalar.constant 1 : i32
  %passed$133 = scf.select %21, %passed$121, %passed$14 : i32
  %25 = scalar.constant 3 : i32
  %27 = view.atomic.rmw<addi, root_in_bounds|type_disjoint> %25, %18[0] {ordering = relaxed, scope = device} : i32, view<1xi32> -> i32
  %31 = scalar.cmpi eq, %27, %122 : i32
  %passed$34 = scalar.ori %passed$133, %maximum : i32
  %passed$132 = scf.select %31, %passed$34, %passed$133 : i32
  %37 = view.atomic.rmw<subi, root_in_bounds|type_disjoint> %maximum, %18[0] {ordering = relaxed, scope = device} : i32, view<1xi32> -> i32
  %119 = scalar.constant -1 : i32
  %41 = scalar.cmpi eq, %37, %119 : i32
  %43 = scalar.constant 4 : i32
  %passed$44 = scalar.ori %passed$132, %43 : i32
  %passed$131 = scf.select %41, %passed$44, %passed$132 : i32
  %45 = scalar.constant 15 : i32
  %47 = view.atomic.rmw<andi, root_in_bounds|type_disjoint> %45, %18[0] {ordering = relaxed, scope = device} : i32, view<1xi32> -> i32
  %118 = scalar.constant -3 : i32
  %51 = scalar.cmpi eq, %47, %118 : i32
  %53 = scalar.constant 8 : i32
  %passed$54 = scalar.ori %passed$131, %53 : i32
  %passed$130 = scf.select %51, %passed$54, %passed$131 : i32
  %55 = scalar.constant 16 : i32
  %57 = view.atomic.rmw<ori, root_in_bounds|type_disjoint> %55, %18[0] {ordering = relaxed, scope = device} : i32, view<1xi32> -> i32
  %58 = scalar.constant 13 : i32
  %59 = scalar.cmpi eq, %57, %58 : i32
  %passed$62 = scalar.ori %passed$130, %55 : i32
  %passed$129 = scf.select %59, %passed$62, %passed$130 : i32
  %65 = view.atomic.rmw<xori, root_in_bounds|type_disjoint> %25, %18[0] {ordering = relaxed, scope = device} : i32, view<1xi32> -> i32
  %66 = scalar.constant 29 : i32
  %67 = scalar.cmpi eq, %65, %66 : i32
  %69 = scalar.constant 32 : i32
  %passed$70 = scalar.ori %passed$129, %69 : i32
  %passed$128 = scf.select %67, %passed$70, %passed$129 : i32
  %75 = view.atomic.rmw<minsi, root_in_bounds|type_disjoint> %minimum, %18[0] {ordering = relaxed, scope = device} : i32, view<1xi32> -> i32
  %76 = scalar.constant 30 : i32
  %77 = scalar.cmpi eq, %75, %76 : i32
  %79 = scalar.constant 64 : i32
  %passed$80 = scalar.ori %passed$128, %79 : i32
  %passed$127 = scf.select %77, %passed$80, %passed$128 : i32
  %83 = view.atomic.rmw<maxsi, root_in_bounds|type_disjoint> %maximum, %18[0] {ordering = relaxed, scope = device} : i32, view<1xi32> -> i32
  %84 = scalar.cmpi eq, %83, %minimum : i32
  %86 = scalar.constant 128 : i32
  %passed$87 = scalar.ori %passed$127, %86 : i32
  %passed$126 = scf.select %84, %passed$87, %passed$127 : i32
  view.atomic.reduce<maxsi, root_in_bounds|type_disjoint> %maximum, %18[0] {ordering = relaxed, scope = device} : i32, view<1xi32>
  %89 = scalar.constant 7 : i32
  %91 = view.atomic.cmpxchg<root_in_bounds|type_disjoint> %maximum, %89, %18[0] {failure_ordering = acquire, scope = device, success_ordering = acq_rel} : i32, view<1xi32> -> i32
  %92 = scalar.cmpi eq, %91, %maximum : i32
  %94 = scalar.constant 256 : i32
  %passed$95 = scalar.ori %passed$126, %94 : i32
  %passed$125 = scf.select %92, %passed$95, %passed$126 : i32
  %96 = scalar.constant 5 : i32
  %97 = scalar.constant 11 : i32
  %99 = view.atomic.cmpxchg<root_in_bounds|type_disjoint> %96, %97, %18[0] {failure_ordering = relaxed, scope = device, success_ordering = acquire} : i32, view<1xi32> -> i32
  %101 = scalar.cmpi eq, %99, %89 : i32
  %103 = scalar.constant 512 : i32
  %passed$104 = scalar.ori %passed$125, %103 : i32
  %passed$124 = scf.select %101, %passed$104, %passed$125 : i32
  view.atomic.reduce<addi, root_in_bounds|type_disjoint> %96, %18[0] {ordering = release, scope = device} : i32, view<1xi32>
  %107 = scalar.constant 12 : i32
  %110 = view.atomic.cmpxchg<root_in_bounds|type_disjoint> %107, %58, %18[0] {failure_ordering = seq_cst, scope = device, success_ordering = seq_cst} : i32, view<1xi32> -> i32
  %112 = scalar.cmpi eq, %110, %107 : i32
  %114 = scalar.constant 1024 : i32
  %passed$115 = scalar.ori %passed$124, %114 : i32
  %passed$123 = scf.select %112, %passed$115, %passed$124 : i32
  func.return %passed$123 : i32
}

