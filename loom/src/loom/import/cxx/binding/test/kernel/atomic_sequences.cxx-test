  %21 = buffer.view %destination[%destination_byte_offset] : buffer -> view<1xi32>
  %22 = view.atomic.rmw<xchgi> %125, %21[0] {ordering = relaxed, scope = device} : i32, view<1xi32> -> i32
  %23 = scalar.constant 37 : i32
  %24 = scalar.cmpi eq, %22, %23 : i32
  %passed$124 = scalar.constant 1 : i32
  %passed$136 = scf.select %24, %passed$124, %passed$17 : i32
  %28 = scalar.constant 3 : i32
  %30 = view.atomic.rmw<addi> %28, %21[0] {ordering = relaxed, scope = device} : i32, view<1xi32> -> i32
  %34 = scalar.cmpi eq, %30, %125 : i32
  %passed$37 = scalar.ori %passed$136, %maximum : i32
  %passed$135 = scf.select %34, %passed$37, %passed$136 : i32
  %40 = view.atomic.rmw<subi> %maximum, %21[0] {ordering = relaxed, scope = device} : i32, view<1xi32> -> i32
  %122 = scalar.constant -1 : i32
  %44 = scalar.cmpi eq, %40, %122 : i32
  %46 = scalar.constant 4 : i32
  %passed$47 = scalar.ori %passed$135, %46 : i32
  %passed$134 = scf.select %44, %passed$47, %passed$135 : i32
  %48 = scalar.constant 15 : i32
  %50 = view.atomic.rmw<andi> %48, %21[0] {ordering = relaxed, scope = device} : i32, view<1xi32> -> i32
  %121 = scalar.constant -3 : i32
  %54 = scalar.cmpi eq, %50, %121 : i32
  %56 = scalar.constant 8 : i32
  %passed$57 = scalar.ori %passed$134, %56 : i32
  %passed$133 = scf.select %54, %passed$57, %passed$134 : i32
  %58 = scalar.constant 16 : i32
  %60 = view.atomic.rmw<ori> %58, %21[0] {ordering = relaxed, scope = device} : i32, view<1xi32> -> i32
  %61 = scalar.constant 13 : i32
  %62 = scalar.cmpi eq, %60, %61 : i32
  %passed$65 = scalar.ori %passed$133, %58 : i32
  %passed$132 = scf.select %62, %passed$65, %passed$133 : i32
  %68 = view.atomic.rmw<xori> %28, %21[0] {ordering = relaxed, scope = device} : i32, view<1xi32> -> i32
  %69 = scalar.constant 29 : i32
  %70 = scalar.cmpi eq, %68, %69 : i32
  %72 = scalar.constant 32 : i32
  %passed$73 = scalar.ori %passed$132, %72 : i32
  %passed$131 = scf.select %70, %passed$73, %passed$132 : i32
  %78 = view.atomic.rmw<minsi> %minimum, %21[0] {ordering = relaxed, scope = device} : i32, view<1xi32> -> i32
  %79 = scalar.constant 30 : i32
  %80 = scalar.cmpi eq, %78, %79 : i32
  %82 = scalar.constant 64 : i32
  %passed$83 = scalar.ori %passed$131, %82 : i32
  %passed$130 = scf.select %80, %passed$83, %passed$131 : i32
  %86 = view.atomic.rmw<maxsi> %maximum, %21[0] {ordering = relaxed, scope = device} : i32, view<1xi32> -> i32
  %87 = scalar.cmpi eq, %86, %minimum : i32
  %89 = scalar.constant 128 : i32
  %passed$90 = scalar.ori %passed$130, %89 : i32
  %passed$129 = scf.select %87, %passed$90, %passed$130 : i32
  view.atomic.reduce<maxsi> %maximum, %21[0] {ordering = relaxed, scope = device} : i32, view<1xi32>
  %92 = scalar.constant 7 : i32
  %94 = view.atomic.cmpxchg %maximum, %92, %21[0] {failure_ordering = acquire, scope = device, success_ordering = acq_rel} : i32, view<1xi32> -> i32
  %95 = scalar.cmpi eq, %94, %maximum : i32
  %97 = scalar.constant 256 : i32
  %passed$98 = scalar.ori %passed$129, %97 : i32
  %passed$128 = scf.select %95, %passed$98, %passed$129 : i32
  %99 = scalar.constant 5 : i32
  %100 = scalar.constant 11 : i32
  %102 = view.atomic.cmpxchg %99, %100, %21[0] {failure_ordering = relaxed, scope = device, success_ordering = acquire} : i32, view<1xi32> -> i32
  %104 = scalar.cmpi eq, %102, %92 : i32
  %106 = scalar.constant 512 : i32
  %passed$107 = scalar.ori %passed$128, %106 : i32
  %passed$127 = scf.select %104, %passed$107, %passed$128 : i32
  view.atomic.reduce<addi> %99, %21[0] {ordering = release, scope = device} : i32, view<1xi32>
  %110 = scalar.constant 12 : i32
  %113 = view.atomic.cmpxchg %110, %61, %21[0] {failure_ordering = seq_cst, scope = device, success_ordering = seq_cst} : i32, view<1xi32> -> i32
  %115 = scalar.cmpi eq, %113, %110 : i32
  %117 = scalar.constant 1024 : i32
  %passed$118 = scalar.ori %passed$127, %117 : i32
  %passed$126 = scf.select %115, %passed$118, %passed$127 : i32
  func.return %passed$126 : i32
}

