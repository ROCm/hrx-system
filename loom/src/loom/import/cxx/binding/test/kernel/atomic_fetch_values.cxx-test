// RUN: pass canonicalize,cse,dce
// Every update consumes the returned old/new value with its distinct ordering.
unsigned builtin_fetch_values(volatile unsigned* storage) {
  auto* word = storage + 1;
  unsigned failures = 0;
  failures += __atomic_exchange_n(word, 0xfffffffcu, __ATOMIC_SEQ_CST) != 37u;
  failures += __atomic_fetch_add(word, 3u, __ATOMIC_RELAXED) != 0xfffffffcu;
  failures += __atomic_add_fetch(word, 1u, __ATOMIC_ACQUIRE) != 0u;
  failures += __atomic_fetch_sub(word, 1u, __ATOMIC_RELEASE) != 0u;
  failures += __atomic_sub_fetch(word, 2u, __ATOMIC_ACQ_REL) != 0xfffffffdu;
  failures += __atomic_fetch_and(word, 15u, __ATOMIC_RELAXED) != 0xfffffffdu;
  failures += __atomic_and_fetch(word, 7u, __ATOMIC_RELAXED) != 5u;
  failures += __atomic_fetch_or(word, 16u, __ATOMIC_RELAXED) != 5u;
  failures += __atomic_or_fetch(word, 32u, __ATOMIC_RELAXED) != 53u;
  failures += __atomic_fetch_xor(word, 3u, __ATOMIC_RELAXED) != 53u;
  failures += __atomic_xor_fetch(word, 7u, __ATOMIC_RELAXED) != 49u;
  return failures;
}
// ----
func.def public @builtin_fetch_values(%storage: buffer, %storage_byte_offset: index) -> (i32) {
  %97 = index.constant 4 : index
  %word_byte_offset = index.add %storage_byte_offset, %97 : index
  %9 = scalar.constant -4 : i32
  %10 = buffer.view %storage[%word_byte_offset] : buffer -> view<1xi32>
  %11 = view.atomic.rmw<xchgi, root_in_bounds|type_disjoint> %9, %10[0] {ordering = seq_cst, scope = system} : i32, view<1xi32> -> i32
  %12 = scalar.constant 37 : i32
  %13 = scalar.cmpi ne, %11, %12 : i32
  %14 = scalar.extui %13 : i1 to i32
  %16 = scalar.constant 3 : i32
  %18 = view.atomic.rmw<addi, root_in_bounds|type_disjoint> %16, %10[0] {ordering = relaxed, scope = system} : i32, view<1xi32> -> i32
  %20 = scalar.cmpi ne, %18, %9 : i32
  %21 = scalar.extui %20 : i1 to i32
  %93 = scalar.addi %14, %21 : i32
  %23 = scalar.constant 1 : i32
  %25 = view.atomic.rmw<addi, root_in_bounds|type_disjoint> %23, %10[0] {ordering = acquire, scope = system} : i32, view<1xi32> -> i32
  %26 = scalar.addi %25, %23 : i32
  %27 = scalar.constant 0 : i32
  %28 = scalar.cmpi ne, %26, %27 : i32
  %29 = scalar.extui %28 : i1 to i32
  %95 = scalar.addi %93, %29 : i32
  %33 = view.atomic.rmw<subi, root_in_bounds|type_disjoint> %23, %10[0] {ordering = release, scope = system} : i32, view<1xi32> -> i32
  %35 = scalar.cmpi ne, %33, %27 : i32
  %36 = scalar.extui %35 : i1 to i32
  %failures$37 = scalar.addi %95, %36 : i32
  %38 = scalar.constant 2 : i32
  %40 = view.atomic.rmw<subi, root_in_bounds|type_disjoint> %38, %10[0] {ordering = acq_rel, scope = system} : i32, view<1xi32> -> i32
  %91 = scalar.constant -2 : i32
  %92 = scalar.addi %40, %91 : i32
  %42 = scalar.constant -3 : i32
  %43 = scalar.cmpi ne, %92, %42 : i32
  %44 = scalar.extui %43 : i1 to i32
  %failures$45 = scalar.addi %failures$37, %44 : i32
  %46 = scalar.constant 15 : i32
  %48 = view.atomic.rmw<andi, root_in_bounds|type_disjoint> %46, %10[0] {ordering = relaxed, scope = system} : i32, view<1xi32> -> i32
  %50 = scalar.cmpi ne, %48, %42 : i32
  %51 = scalar.extui %50 : i1 to i32
  %failures$52 = scalar.addi %failures$45, %51 : i32
  %53 = scalar.constant 7 : i32
  %55 = view.atomic.rmw<andi, root_in_bounds|type_disjoint> %53, %10[0] {ordering = relaxed, scope = system} : i32, view<1xi32> -> i32
  %56 = scalar.andi %55, %53 : i32
  %57 = scalar.constant 5 : i32
  %58 = scalar.cmpi ne, %56, %57 : i32
  %59 = scalar.extui %58 : i1 to i32
  %failures$60 = scalar.addi %failures$52, %59 : i32
  %61 = scalar.constant 16 : i32
  %63 = view.atomic.rmw<ori, root_in_bounds|type_disjoint> %61, %10[0] {ordering = relaxed, scope = system} : i32, view<1xi32> -> i32
  %65 = scalar.cmpi ne, %63, %57 : i32
  %66 = scalar.extui %65 : i1 to i32
  %failures$67 = scalar.addi %failures$60, %66 : i32
  %68 = scalar.constant 32 : i32
  %70 = view.atomic.rmw<ori, root_in_bounds|type_disjoint> %68, %10[0] {ordering = relaxed, scope = system} : i32, view<1xi32> -> i32
  %71 = scalar.ori %70, %68 : i32
  %72 = scalar.constant 53 : i32
  %73 = scalar.cmpi ne, %71, %72 : i32
  %74 = scalar.extui %73 : i1 to i32
  %failures$75 = scalar.addi %failures$67, %74 : i32
  %78 = view.atomic.rmw<xori, root_in_bounds|type_disjoint> %16, %10[0] {ordering = relaxed, scope = system} : i32, view<1xi32> -> i32
  %80 = scalar.cmpi ne, %78, %72 : i32
  %81 = scalar.extui %80 : i1 to i32
  %failures$82 = scalar.addi %failures$75, %81 : i32
  %85 = view.atomic.rmw<xori, root_in_bounds|type_disjoint> %53, %10[0] {ordering = relaxed, scope = system} : i32, view<1xi32> -> i32
  %86 = scalar.xori %85, %53 : i32
  %87 = scalar.constant 49 : i32
  %88 = scalar.cmpi ne, %86, %87 : i32
  %89 = scalar.extui %88 : i1 to i32
  %failures$90 = scalar.addi %failures$82, %89 : i32
  func.return %failures$90 : i32
}

// ====
// RUN: pass canonicalize,cse,dce
// Signed atomic returned-new arithmetic retains modular operations at i32 width.
unsigned builtin_signed_wrap(int* storage) {
  auto* word = storage + 1;
  unsigned failures = 0;
  __atomic_exchange_n(word, 2147483647, __ATOMIC_RELAXED);
  failures +=
      __atomic_add_fetch(word, 1, __ATOMIC_RELAXED) != (-2147483647 - 1);
  failures += __atomic_sub_fetch(word, 1, __ATOMIC_RELAXED) != 2147483647;
  return failures;
}
// ----
func.def public @builtin_signed_wrap(%storage: buffer, %storage_byte_offset: index) -> (i32) {
  %37 = index.constant 4 : index
  %word_byte_offset = index.add %storage_byte_offset, %37 : index
  %9 = scalar.constant 2147483647 : i32
  %10 = buffer.view %storage[%word_byte_offset] : buffer -> view<1xi32>
  %11 = view.atomic.rmw<xchgi, root_in_bounds|type_disjoint> %9, %10[0] {ordering = relaxed, scope = system} : i32, view<1xi32> -> i32
  %12 = scalar.constant 1 : i32
  %14 = view.atomic.rmw<addi, root_in_bounds|type_disjoint> %12, %10[0] {ordering = relaxed, scope = system} : i32, view<1xi32> -> i32
  %15 = scalar.addi %14, %12 : i32
  %36 = scalar.constant -2147483648 : i32
  %21 = scalar.cmpi ne, %15, %36 : i32
  %22 = scalar.extui %21 : i1 to i32
  %26 = view.atomic.rmw<subi, root_in_bounds|type_disjoint> %12, %10[0] {ordering = relaxed, scope = system} : i32, view<1xi32> -> i32
  %34 = scalar.constant -1 : i32
  %35 = scalar.addi %26, %34 : i32
  %29 = scalar.cmpi ne, %35, %9 : i32
  %30 = scalar.extui %29 : i1 to i32
  %32 = scalar.addi %22, %30 : i32
  func.return %32 : i32
}

// ====
// RUN: pass canonicalize,cse,dce
// High-half values and compare-exchange results remain i64 throughout the sequence.
unsigned builtin_wide_values(unsigned long long* storage) {
  auto* word = storage + 1;
  auto* expected = storage + 2;
  unsigned failures = 0;
  failures += __atomic_exchange_n(word, 0xffffffffffffffffULL,
                                  __ATOMIC_RELAXED) != 37ULL;
  failures += __atomic_add_fetch(word, 1ULL, __ATOMIC_RELAXED) != 0ULL;
  failures += __atomic_fetch_add(word, 37ULL, __ATOMIC_RELAXED) != 0ULL;
  failures +=
      !__atomic_compare_exchange_n(word, expected, 0x100000003ULL, false,
                                   __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE);
  failures += *expected != 37ULL;
  failures += __atomic_compare_exchange_n(word, expected, 19ULL, true,
                                          __ATOMIC_ACQUIRE, __ATOMIC_CONSUME);
  failures += *expected != 0x100000003ULL;
  failures += !__atomic_compare_exchange_n(word, word, 0x100000004ULL, false,
                                           __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST);
  return failures;
}
// ----
func.def public @builtin_wide_values(%storage: buffer, %storage_byte_offset: index) -> (i32) {
  %89 = index.constant 8 : index
  %word_byte_offset = index.add %storage_byte_offset, %89 : index
  %88 = index.constant 16 : index
  %expected_byte_offset = index.add %storage_byte_offset, %88 : index
  %14 = scalar.constant -1 : i64
  %15 = buffer.view %storage[%word_byte_offset] : buffer -> view<1xi64>
  %16 = view.atomic.rmw<xchgi, root_in_bounds|type_disjoint> %14, %15[0] {ordering = relaxed, scope = system} : i64, view<1xi64> -> i64
  %17 = scalar.constant 37 : i64
  %18 = scalar.cmpi ne, %16, %17 : i64
  %19 = scalar.extui %18 : i1 to i32
  %21 = scalar.constant 1 : i64
  %23 = view.atomic.rmw<addi, root_in_bounds|type_disjoint> %21, %15[0] {ordering = relaxed, scope = system} : i64, view<1xi64> -> i64
  %24 = scalar.addi %23, %21 : i64
  %25 = scalar.constant 0 : i64
  %26 = scalar.cmpi ne, %24, %25 : i64
  %27 = scalar.extui %26 : i1 to i32
  %90 = scalar.addi %19, %27 : i32
  %31 = view.atomic.rmw<addi, root_in_bounds|type_disjoint> %17, %15[0] {ordering = relaxed, scope = system} : i64, view<1xi64> -> i64
  %33 = scalar.cmpi ne, %31, %25 : i64
  %34 = scalar.extui %33 : i1 to i32
  %92 = scalar.addi %90, %34 : i32
  %36 = scalar.constant 4294967299 : i64
  %38 = buffer.view %storage[%expected_byte_offset] : buffer -> view<1xi64>
  %39 = view.load<root_in_bounds|type_disjoint> %38[0] : view<1xi64> -> i64
  %41 = view.atomic.cmpxchg<root_in_bounds|type_disjoint> %39, %36, %15[0] {failure_ordering = acquire, scope = system, success_ordering = acq_rel} : i64, view<1xi64> -> i64
  %42 = scalar.cmpi eq, %41, %39 : i64
  %43 = scalar.constant 1 : i1
  %44 = scalar.xori %42, %43 : i1
  scf.if %44 {
    %85 = scalar.assume %41 [ne(%41, %39)] : i64
    view.store<root_in_bounds|type_disjoint> %85, %38[0] : i64, view<1xi64>
  }
  %47 = scalar.extui %44 : i1 to i32
  %failures$48 = scalar.addi %92, %47 : i32
  %50 = view.load<root_in_bounds|type_disjoint> %38[0] : view<1xi64> -> i64
  %52 = scalar.cmpi ne, %50, %17 : i64
  %53 = scalar.extui %52 : i1 to i32
  %failures$54 = scalar.addi %failures$48, %53 : i32
  %55 = scalar.constant 19 : i64
  %60 = view.atomic.cmpxchg<root_in_bounds|type_disjoint> %50, %55, %15[0] {failure_ordering = acquire, scope = system, success_ordering = acquire} : i64, view<1xi64> -> i64
  %61 = scalar.cmpi eq, %60, %50 : i64
  %63 = scalar.xori %61, %43 : i1
  scf.if %63 {
    %86 = scalar.assume %60 [ne(%60, %50)] : i64
    view.store<root_in_bounds|type_disjoint> %86, %38[0] : i64, view<1xi64>
  }
  %64 = scalar.extui %61 : i1 to i32
  %failures$65 = scalar.addi %failures$54, %64 : i32
  %67 = view.load<root_in_bounds|type_disjoint> %38[0] : view<1xi64> -> i64
  %69 = scalar.cmpi ne, %67, %36 : i64
  %70 = scalar.extui %69 : i1 to i32
  %failures$71 = scalar.addi %failures$65, %70 : i32
  %72 = scalar.constant 4294967300 : i64
  %75 = view.load<root_in_bounds|type_disjoint> %15[0] : view<1xi64> -> i64
  %77 = view.atomic.cmpxchg<root_in_bounds|type_disjoint> %75, %72, %15[0] {failure_ordering = seq_cst, scope = system, success_ordering = seq_cst} : i64, view<1xi64> -> i64
  %78 = scalar.cmpi eq, %77, %75 : i64
  %80 = scalar.xori %78, %43 : i1
  scf.if %80 {
    %87 = scalar.assume %77 [ne(%77, %75)] : i64
    view.store<root_in_bounds|type_disjoint> %87, %15[0] : i64, view<1xi64>
  }
  %83 = scalar.extui %80 : i1 to i32
  %failures$84 = scalar.addi %failures$71, %83 : i32
  func.return %failures$84 : i32
}
