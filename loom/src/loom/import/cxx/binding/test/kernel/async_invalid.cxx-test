// RUN: verify
#include <loomcxx/kernel.h>
using view = loom::type::view<loom::type::shape<4>, unsigned char>;
void ordinary(view source, view destination) {
  // ERROR@+1: LOWERING/059 "kernel intrinsic requires a kernel or inline helper"
  (void)loom::kernel::async::copy<
      loom::kernel::async::direction::global_to_workgroup,
      loom::cache::scope::workgroup, loom::cache::temporal::regular>(
      source, destination);
}

// ====
#include <loomcxx/kernel.h>
using view = loom::type::view<loom::type::shape<4>, unsigned char>;
LOOM_INLINE void invalid_direction(view source, view destination) {
  // ERROR@+1: LOWERING/059 "unknown kernel async copy direction"
  (void)loom::kernel::async::copy<loom::kernel::async::direction(2),
                                  loom::cache::scope::workgroup,
                                  loom::cache::temporal::regular>(source,
                                                                  destination);
}

// ====
#include <loomcxx/kernel.h>
using view = loom::type::view<loom::type::shape<4>, unsigned char>;
LOOM_INLINE void invalid_scope(view source, view destination) {
  // ERROR@+1: LOWERING/059 "unknown kernel async cache scope"
  (void)loom::kernel::async::gather<loom::cache::scope(4),
                                    loom::cache::temporal::regular>(
      source, destination);
}

// ====
#include <loomcxx/kernel.h>
using view = loom::type::view<loom::type::shape<4>, unsigned char>;
LOOM_INLINE void invalid_temporal(view source, view destination) {
  // ERROR@+1: LOWERING/059 "unknown kernel async temporal cache policy"
  (void)loom::kernel::async::gather<loom::cache::scope::workgroup,
                                    loom::cache::temporal(10)>(source,
                                                               destination);
}

// ====
#include <loomcxx/kernel.h>
using view = loom::type::view<loom::type::shape<4>, unsigned char>;
LOOM_INLINE void invalid_load_policy(view source, view destination) {
  // ERROR@+1: LOWERING/059 "kernel async load requires a load-compatible temporal policy"
  (void)loom::kernel::async::copy<
      loom::kernel::async::direction::global_to_workgroup,
      loom::cache::scope::workgroup, loom::cache::temporal::writeback>(
      source, destination);
}

// ====
#include <loomcxx/kernel.h>
using view = loom::type::view<loom::type::shape<4>, unsigned char>;
LOOM_INLINE void invalid_store_policy(view source, view destination) {
  // ERROR@+1: LOWERING/059 "kernel async store requires a store-compatible temporal policy"
  (void)loom::kernel::async::copy<
      loom::kernel::async::direction::workgroup_to_global,
      loom::cache::scope::workgroup, loom::cache::temporal::last_use>(
      source, destination);
}

// ====
#include <loomcxx/kernel.h>
using view = loom::type::view<loom::type::shape<4>, unsigned char>;
LOOM_INLINE void invalid_bypass_scope(view source, view destination) {
  // ERROR@+1: LOWERING/059 "bypass requires system cache scope"
  (void)loom::kernel::async::gather<loom::cache::scope::workgroup,
                                    loom::cache::temporal::bypass>(source,
                                                                   destination);
}

// ====
#include <loomcxx/kernel.h>
using view = loom::type::view<loom::type::shape<4>, unsigned char>;
using const_view = loom::type::view<loom::type::shape<4>, const unsigned char>;
LOOM_INLINE void immutable_destination(view source,
                                             const_view destination) {
  // ERROR@+1: LOWERING/059 "kernel async destination requires a mutable view"
  (void)loom::kernel::async::copy<
      loom::kernel::async::direction::global_to_workgroup,
      loom::cache::scope::workgroup, loom::cache::temporal::regular>(
      source, destination);
}

// ====
#include <loomcxx/kernel.h>
using view = loom::type::view<loom::type::shape<4>, unsigned char>;
using volatile_view =
    loom::type::view<loom::type::shape<4>, volatile unsigned char>;
LOOM_INLINE void volatile_source(volatile_view source, view destination) {
  // ERROR@+1: LOWERING/059 "kernel async transfers do not support volatile views"
  (void)loom::kernel::async::copy<
      loom::kernel::async::direction::global_to_workgroup,
      loom::cache::scope::workgroup, loom::cache::temporal::regular>(
      source, destination);
}

// ====
#include <loomcxx/kernel.h>
template <int Direction, int Scope, int Temporal, class Destination>
[[loom::op("kernel.async.copy")]] loom::type::async_token invalid_source(
    int source, Destination destination);
using view = loom::type::view<loom::type::shape<4>, unsigned char>;
LOOM_INLINE void source_must_be_view(view destination) {
  // ERROR@+1: LOWERING/059 "kernel async source requires a view value"
  (void)invalid_source<0, 0, 0>(1, destination);
}

// ====
#include <loomcxx/kernel.h>
template <int Scope, int Temporal, class Source, class Destination>
[[loom::op("kernel.async.gather.mask")]] loom::type::async_token
invalid_predicate(Source source, Destination destination, int predicate);
using view = loom::type::view<loom::type::shape<4>, unsigned char>;
LOOM_INLINE void predicate_must_be_bool(view source, view destination) {
  // ERROR@+1: LOWERING/059 "kernel async predicate requires a bool value"
  (void)invalid_predicate<0, 0>(source, destination, 1);
}

// ====
#include <loomcxx/kernel.h>
template <int Scope, int Temporal, class Source, class Destination>
[[loom::op("kernel.async.cluster.gather")]] loom::type::async_token
invalid_mask(Source source, Destination destination,
             unsigned long long participant_mask);
using view = loom::type::view<loom::type::shape<4>, unsigned char>;
LOOM_INLINE void mask_must_be_i32(view source, view destination) {
  // ERROR@+1: LOWERING/059 "kernel async cluster participant mask requires unsigned i32"
  (void)invalid_mask<0, 0>(source, destination, 1ull);
}

// ====
#include <loomcxx/kernel.h>
template <class... Values>
[[loom::op("kernel.async.group")]] loom::type::async_group invalid_group(
    Values... values);
LOOM_INLINE void group_requires_tokens() {
  // ERROR@+1: LOWERING/059 "kernel.async.group operand must be loom::type::async_token"
  (void)invalid_group(1);
}

// ====
#include <loomcxx/kernel.h>
LOOM_INLINE void bounded_wait() {
  auto stage = loom::kernel::async::group();
  // ERROR@+1: LOWERING/059 "kernel.async.wait selectors require nonnegative constant enum values"
  loom::kernel::async::wait<65536>(stage);
}

// ====
#include <loomcxx/kernel.h>
void ordinary_wait(loom::type::async_group stage) {
  // ERROR@+1: LOWERING/059 "kernel intrinsic requires a kernel or inline helper"
  loom::kernel::async::wait<0>(stage);
}
