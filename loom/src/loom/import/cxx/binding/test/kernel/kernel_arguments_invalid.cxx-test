// RUN: verify
// Dynamic vectors require extent bindings unavailable in the kernel ABI.
#include <loomcxx/kernel.h>
#include <loomcxx/vector.h>
using Input = loom::type::vector<loom::type::shape<loom::type::dynamic>, float>;
// ERROR@+1: LOWERING/059 "dynamic vector types require bound extent identities"
LOOM_KERNEL void entry(Input input) {}

// ====
// Dynamic tensors require a bound extent rather than an implicit extra argument.
#include <loomcxx/check.h>
#include <loomcxx/kernel.h>
using Input = loom::type::tensor<loom::type::shape<loom::type::dynamic>, unsigned>;
// ERROR@+1: LOWERING/059 "dynamic tensor types require a bound extent identity"
LOOM_KERNEL void entry(Input input) {}

// ====
// Views carry an encoding and cannot be reduced to one kernel argument.
#include <loomcxx/kernel.h>
#include <loomcxx/view.h>
using Input = loom::type::view<loom::type::shape<4>, unsigned>;
// ERROR@+1: LOWERING/059 "unsupported C++ type: ::loom::type::view<::loom::type::shape<4>, unsigned int, void>"
LOOM_KERNEL void entry(Input input) {}

// ====
// Encoding values require the ordinary callable transport contract.
#include <loomcxx/kernel.h>
#include <loomcxx/view.h>
using Input = loom::type::encoding<loom::encoding::role::layout, 1>;
// ERROR@+1: LOWERING/059 "unsupported C++ type: ::loom::type::encoding<0, 1>"
LOOM_KERNEL void entry(Input input) {}

// ====
// A reference member has no cross-dispatch object identity.
#include <loomcxx/kernel.h>
struct Input { unsigned& value; };
// ERROR@+1: LOWERING/059 "kernel record parameters cannot contain reference members or by-reference lambda captures"
LOOM_KERNEL void entry(Input input) {}

// ====
// Nested dependent handles cannot use a static kernel argument projection.
#include <loomcxx/kernel.h>
#include <loomcxx/vector.h>
struct Input { loom::type::vector<loom::type::shape<loom::type::dynamic>, float> values; };
// ERROR@+1: LOWERING/059 "kernel record parameters cannot contain dependent shaped values"
LOOM_KERNEL void entry(Input input) {}

// ====
// A record does not make native pointer-bearing memory addressable.
#include <loomcxx/kernel.h>
struct Node { float* data; Node* next; };
// ERROR@+1: LOWERING/059 "stored pointers and references require an object storage representation"
LOOM_KERNEL void entry(const Node* input, float* output) { output[0] = input->data[0]; }

// ====
// Source launches cannot carry native pointers hidden inside record constants.
#include <loomcxx/check.h>
#include <loomcxx/kernel.h>
struct Input { const float* data; };
LOOM_KERNEL void entry(Input input) {}
LOOM_CHECK_CASE(native_pointer) {
  Input input{nullptr};
  // ERROR@+1: LOWERING/059 "kernel record launches require typed buffer members instead of native pointer members"
  loom::check::launch<entry>(input);
}

// ====
// A lambda's reference capture needs an object identity across the dispatch.
#include <loomcxx/check.h>
#include <loomcxx/kernel.h>
template <class F>
LOOM_KERNEL void entry(F body) { body(); }
LOOM_CHECK_CASE(reference_capture) {
  unsigned value = 3;
  auto body = [&value] { value += 1; };
  // ERROR@+1: LOWERING/059 "kernel record parameters cannot contain reference members or by-reference lambda captures"
  loom::check::launch<entry<decltype(body)>>(body);
}

// ====
// Matching physical leaves do not erase a record's source type.
#include <loomcxx/check.h>
#include <loomcxx/kernel.h>
struct Input { unsigned value; };
struct Other { unsigned value; };
LOOM_KERNEL void entry(Input input) {}
LOOM_CHECK_CASE(wrong_record) {
  Other input{3};
  // ERROR@+1: LOWERING/059 "kernel record arguments must match the parameter's source type"
  loom::check::launch<entry>(input);
}

// ====
// A kernel receives a record value, not an identity borrowed from its caller.
#include <loomcxx/kernel.h>
struct Body { float* output; int count; };
// ERROR@+1: LOWERING/059 "runtime reference signatures require an internal ordinary function definition"
LOOM_KERNEL void borrow_parameter(const Body& body) { body.output[0] = body.count; }

// ====
// Nesting a view in a record does not admit an unsupported kernel leaf type.
#include <loomcxx/kernel.h>
#include <loomcxx/view.h>
struct Body { loom::type::view<loom::type::shape<4>, float> values; };
// ERROR@+1: LOWERING/059 "kernel record parameter members require scalars, vectors, typed buffers, pointers, index/offset values, or nested records of those"
LOOM_KERNEL void view_member(Body body, float* output) { output[0] = loom::view::load(body.values, 0); }

// ====
// Record value admission also applies to a kernel's bitfields.
#include <loomcxx/kernel.h>
struct Body { unsigned flag : 3; float* output; };
// ERROR@+1: LOWERING/059 "record value fields cannot be bitfields"
LOOM_KERNEL void bitfield_member(Body body) { body.output[0] = body.flag; }

// ====
// A union member has no unconditional partition into kernel argument leaves.
#include <loomcxx/kernel.h>
union Number { int integer; float real; };
struct Body { Number number; float* output; };
// ERROR@+1: LOWERING/059 "record values require a complete non-union type without virtual members"
LOOM_KERNEL void union_member(Body body) { body.output[0] = body.number.real; }
