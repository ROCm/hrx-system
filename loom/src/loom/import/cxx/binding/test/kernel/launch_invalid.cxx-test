// RUN: verify
// Rejects invalid or contradictory launch contracts.
// ERROR@+1: LOWERING/059 "launch dimensions require positive i32 integer constant expressions"
[[loom::kernel, loom::workgroup_size(64.5, 1, 1)]] void entry() {}

// ====
// RUN: verify
// Rejects invalid or contradictory launch contracts.
// ERROR@+1: LOWERING/059 "launch dimensions require positive i32 integer constant expressions"
[[loom::kernel, loom::workgroup_size(0, 1, 1)]] void entry() {}

// ====
// RUN: verify
// Rejects invalid or contradictory launch contracts.
// ERROR@+1: LOWERING/059 "launch dimensions require positive i32 integer constant expressions"
[[loom::kernel, loom::workgroup_size(2147483648u, 1, 1)]] void entry() {}

// ====
// RUN: verify
// Rejects invalid or contradictory launch contracts.
// ERROR@+1: LOWERING/059 "exact launch dimensions require three constants: x, y, z"
[[loom::kernel, loom::workgroup_size(64, 1)]] void entry() {}

// ====
// RUN: verify
// Rejects invalid or contradictory launch contracts.
// ERROR@+1: LOWERING/059 "exact launch dimensions require three constants: x, y, z"
[[loom::kernel, loom::workgroup_size]] void entry() {}

// ====
// RUN: verify
// Rejects invalid or contradictory launch contracts.
[[loom::kernel, loom::workgroup_size(64, 1, 1),
  // ERROR@+1: LOWERING/059 "one launch contract per dimension group is allowed on a declaration"
  loom::workgroup_size(64, 1, 1)]] void
entry() {}

// ====
// RUN: verify
// Rejects invalid or contradictory launch contracts.
[[loom::kernel, loom::workgroup_size(64, 1, 1),
  // ERROR@+1: LOWERING/059 "one launch contract per dimension group is allowed on a declaration"
  loom::workgroup_size_range(32, 128, 1, 1, 1, 1)]] void
entry() {}

// ====
// RUN: verify
// Rejects invalid or contradictory launch contracts.
// ERROR@+1: LOWERING/059 "launch range lower bound exceeds its upper bound"
[[loom::kernel, loom::workgroup_count_range(4, 1, 1, 1, 1, 1)]] void entry() {}

// ====
// RUN: verify
// Rejects invalid or contradictory launch contracts.
// ERROR@+1: LOWERING/059 "launch ranges require six constants: xmin, xmax, ymin, ymax, zmin, zmax"
[[loom::kernel, loom::workgroup_count_range(1, 4, 1, 1, 1)]] void entry() {}

// ====
// RUN: verify
// Rejects invalid or contradictory launch contracts.
// ERROR@+1: LOWERING/059 "launch dimensions require positive i32 integer constant expressions"
[[loom::kernel, loom::workgroup_count_range(1, 4, 1, 1, 1, 1, 1)]] void
entry() {}

// ====
// RUN: verify
// Rejects invalid or contradictory launch contracts.
[[loom::kernel, loom::workgroup_size(32, 1, 1)]] void entry();
// ERROR@+1: LOWERING/059 "conflicting launch contracts across declarations"
[[loom::workgroup_size(64, 1, 1)]] void entry() {}

// ====
// RUN: verify
// Rejects invalid or contradictory launch contracts.
// ERROR@+1: LOWERING/059 "launch contracts require a kernel function"
[[loom::workgroup_size(64, 1, 1)]] void ordinary_function() {}
