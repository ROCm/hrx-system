// RUN: pass canonicalize,cse,dce
// A device-scope ticket determines its destination slot.
#include <loomcxx/atomic.h>
#include <loomcxx/kernel.h>
using loom::atomic::kind;
using loom::atomic::ordering;
using loom::atomic::scope;
using loom::view::atomic::cmpxchg;
using loom::view::atomic::reduce;
using loom::view::atomic::rmw;

[[loom::kernel, loom::workgroup_size(32, 1, 1), loom::workgroup_count(8, 1, 1)]]
void atomic_tickets(unsigned* counter, unsigned* slots) {
  unsigned ticket =
      rmw<kind::addi, ordering::relaxed, scope::device>(1u, counter + 1) - 37u;
  slots[ticket + 1] = 1;
}
// ----
kernel.def @atomic_tickets() {
  %2 = index.constant 8 : index
  %3 = index.constant 1 : index
  %5 = index.constant 32 : index
  kernel.launch.config workgroups(%2, %3, %3) workgroup_size(%5, %3, %3) : index
} launch(%counter: buffer, %slots: buffer) {
  %10 = scalar.constant 1 : i32
  %33 = index.constant 4 : index
  %16 = buffer.view %counter[%33] : buffer -> view<1xi32>
  %17 = view.atomic.rmw<addi, root_in_bounds|type_disjoint> %10, %16[0] {ordering = relaxed, scope = device} : i32, view<1xi32> -> i32
  %31 = scalar.constant -36 : i32
  %32 = scalar.addi %17, %31 : i32
  %23 = scalar.extui %32 : i32 to i64
  %24 = index.cast %23 : i64 to index
  %26 = index.mul %24, %33 : index
  %28 = buffer.view %slots[%26] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %10, %28[0] : i32, view<1xi32>
  kernel.return
}

// ====
// RUN: pass canonicalize,cse,dce
// Unsigned high-bit min/max and both compare outcomes feed distinct outputs.
#include <loomcxx/atomic.h>
#include <loomcxx/kernel.h>
using loom::atomic::kind;
using loom::atomic::ordering;
using loom::atomic::scope;
using loom::view::atomic::cmpxchg;
using loom::view::atomic::reduce;
using loom::view::atomic::rmw;

[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void atomic_unsigned(unsigned* storage, unsigned* output) {
  unsigned* destination = storage + 1;
  output[1] = rmw<kind::minui, ordering::relaxed, scope::device>(0x80000001u,
                                                                 destination);
  output[2] = rmw<kind::maxui, ordering::relaxed, scope::device>(0x80000001u,
                                                                 destination);
  output[3] = cmpxchg<ordering::acq_rel, ordering::acquire, scope::device>(
      0x80000001u, 13u, destination);
  output[4] = cmpxchg<ordering::acquire, ordering::relaxed, scope::device>(
      0x80000001u, 19u, destination);
}
// ----
kernel.def @atomic_unsigned() {
  %2 = index.constant 1 : index
  kernel.launch.config workgroups(%2, %2, %2) workgroup_size(%2, %2, %2) : index
} launch(%storage: buffer, %output: buffer) {
  %destination_byte_offset = index.constant 4 : index
  %15 = scalar.constant -2147483647 : i32
  %16 = buffer.view %storage[%destination_byte_offset] : buffer -> view<1xi32>
  %17 = view.atomic.rmw<minui, root_in_bounds|type_disjoint> %15, %16[0] {ordering = relaxed, scope = device} : i32, view<1xi32> -> i32
  %23 = buffer.view %output[%destination_byte_offset] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %17, %23[0] : i32, view<1xi32>
  %26 = view.atomic.rmw<maxui, root_in_bounds|type_disjoint> %15, %16[0] {ordering = relaxed, scope = device} : i32, view<1xi32> -> i32
  %55 = index.constant 8 : index
  %32 = buffer.view %output[%55] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %26, %32[0] : i32, view<1xi32>
  %34 = scalar.constant 13 : i32
  %36 = view.atomic.cmpxchg<root_in_bounds|type_disjoint> %15, %34, %16[0] {failure_ordering = acquire, scope = device, success_ordering = acq_rel} : i32, view<1xi32> -> i32
  %54 = index.constant 12 : index
  %42 = buffer.view %output[%54] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %36, %42[0] : i32, view<1xi32>
  %44 = scalar.constant 19 : i32
  %46 = view.atomic.cmpxchg<root_in_bounds|type_disjoint> %15, %44, %16[0] {failure_ordering = relaxed, scope = device, success_ordering = acquire} : i32, view<1xi32> -> i32
  %53 = index.constant 16 : index
  %52 = buffer.view %output[%53] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %46, %52[0] : i32, view<1xi32>
  kernel.return
}

// ====
// RUN: pass canonicalize,cse,dce
// Workgroup-local tickets retain initialization and both barriers around the counter.
#include <loomcxx/atomic.h>
#include <loomcxx/kernel.h>
using loom::atomic::kind;
using loom::atomic::ordering;
using loom::atomic::scope;
using loom::view::atomic::cmpxchg;
using loom::view::atomic::reduce;
using loom::view::atomic::rmw;

[[loom::kernel, loom::workgroup_size(32, 1, 1), loom::workgroup_count(8, 1, 1)]]
void atomic_workgroup_tickets(unsigned* counts, unsigned* slots) {
  [[loom::workgroup]] unsigned counter[1];
  unsigned lane = loom::kernel::workitem::id.x;
  unsigned group = loom::kernel::workgroup::id.x;
  if (lane == 0) {
    counter[0] = 0;
  }
  loom::kernel::workgroup::barrier();
  unsigned ticket =
      rmw<kind::addi, ordering::relaxed, scope::workgroup>(1u, &counter[0]);
  slots[group * 32 + ticket + 1] = 1;
  loom::kernel::workgroup::barrier();
  if (lane == 0) {
    counts[group + 1] = counter[0];
  }
}
// ----
kernel.def @atomic_workgroup_tickets() {
  %2 = index.constant 8 : index
  %3 = index.constant 1 : index
  %5 = index.constant 32 : index
  kernel.launch.config workgroups(%2, %3, %3) workgroup_size(%5, %3, %3) : index
} launch(%counts: buffer, %slots: buffer) {
  %10 = index.constant 4 : offset
  %counter = buffer.alloca<workgroup> align(4) %10 : buffer
  %counter_byte_offset = index.constant 0 : index
  %counter_view = buffer.view %counter[%counter_byte_offset] : buffer -> view<1xi32>
  %workitem_id_x = kernel.workitem.id<x> : index
  %lane = index.cast %workitem_id_x : index to i32
  %workgroup_id_x = kernel.workgroup.id<x> : index
  %group = index.cast %workgroup_id_x : index to i32
  %18 = scalar.constant 0 : i32
  %19 = scalar.cmpi eq, %lane, %18 : i32
  scf.if %19 {
    view.store<type_disjoint> %18, %counter_view[%counter_byte_offset] : i32, view<1xi32>
  }
  kernel.barrier<global> scope(workgroup) ordering(acq_rel)
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %25 = scalar.constant 1 : i32
  %ticket = view.atomic.rmw<addi, root_in_bounds|type_disjoint> %25, %counter_view[0] {ordering = relaxed, scope = workgroup} : i32, view<1xi32> -> i32
  %64 = scalar.constant 5 : i32
  %65 = scalar.shli %group, %64 : i32
  %37 = scalar.addi %65, %ticket : i32
  %39 = scalar.addi %37, %25 : i32
  %40 = scalar.extui %39 : i32 to i64
  %41 = index.cast %40 : i64 to index
  %42 = index.constant 4 : index
  %43 = index.mul %41, %42 : index
  %45 = buffer.view %slots[%43] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %25, %45[0] : i32, view<1xi32>
  kernel.barrier<global> scope(workgroup) ordering(acq_rel)
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  scf.if %19 {
    %52 = view.load<type_disjoint> %counter_view[%counter_byte_offset] : view<1xi32> -> i32
    %54 = scalar.addi %group, %25 : i32
    %55 = scalar.extui %54 : i32 to i64
    %56 = index.cast %55 : i64 to index
    %58 = index.mul %56, %42 : index
    %60 = buffer.view %counts[%58] : buffer -> view<1xi32>
    view.store<root_in_bounds|type_disjoint> %52, %60[0] : i32, view<1xi32>
  }
  kernel.return
}

// ====
// RUN: pass canonicalize,cse,dce
// Distinct helper roots and output slots survive the kernel ABI boundary.
unsigned builtin_fetch_values(volatile unsigned*);
unsigned builtin_signed_wrap(int*);
unsigned builtin_compare_values(unsigned*, unsigned*);
unsigned builtin_wide_values(unsigned long long*);
[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void builtin_updates(unsigned* storage, unsigned long long* wide,
                     unsigned* evaluations, unsigned* output) {
  output[0] = builtin_fetch_values(storage);
  output[1] = builtin_signed_wrap(reinterpret_cast<int*>(storage + 3));
  output[2] = builtin_compare_values(storage + 6, evaluations);
  output[3] = builtin_wide_values(wide);
}
// ----
kernel.def @builtin_updates() {
  %4 = index.constant 1 : index
  kernel.launch.config workgroups(%4, %4, %4) workgroup_size(%4, %4, %4) : index
} launch(%storage: buffer, %wide: buffer, %evaluations: buffer, %output: buffer) {
  %storage_byte_offset = index.constant 0 : index
  %14 = func.call @builtin_fetch_values(%storage, %storage_byte_offset) : (buffer, index) -> (i32)
  %20 = buffer.view %output[%storage_byte_offset] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %14, %20[0] : i32, view<1xi32>
  %70 = index.constant 12 : index
  %26 = func.call @builtin_signed_wrap(%storage, %70) : (buffer, index) -> (i32)
  %69 = index.constant 4 : index
  %32 = buffer.view %output[%69] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %26, %32[0] : i32, view<1xi32>
  %68 = index.constant 24 : index
  %38 = func.call @builtin_compare_values(%storage, %68, %evaluations, %storage_byte_offset) : (buffer, index, buffer, index) -> (i32)
  %67 = index.constant 8 : index
  %44 = buffer.view %output[%67] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %38, %44[0] : i32, view<1xi32>
  %45 = func.call @builtin_wide_values(%wide, %storage_byte_offset) : (buffer, index) -> (i32)
  %51 = buffer.view %output[%70] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %45, %51[0] : i32, view<1xi32>
  kernel.return
}

func.decl @builtin_fetch_values(%52: buffer, %53: index) -> (i32)

func.decl @builtin_signed_wrap(%55: buffer, %56: index) -> (i32)

func.decl @builtin_compare_values(%58: buffer, %59: index, %60: buffer, %61: index) -> (i32)

func.decl @builtin_wide_values(%63: buffer, %64: index) -> (i32)

// ====
// RUN: pass canonicalize,cse,dce
// Distinct helper roots and output slots survive the kernel ABI boundary.
unsigned atomic_i32(int*);
unsigned atomic_i64(long long*);
unsigned atomic_u64(unsigned long long*);
[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void atomic_sequences(int* signed_words, long long* signed_wide,
                      unsigned long long* unsigned_wide, unsigned* output) {
  output[1] = atomic_i32(signed_words);
  output[2] = atomic_i64(signed_wide);
  output[3] = atomic_u64(unsigned_wide);
}
// ----
kernel.def @atomic_sequences() {
  %4 = index.constant 1 : index
  kernel.launch.config workgroups(%4, %4, %4) workgroup_size(%4, %4, %4) : index
} launch(%signed_words: buffer, %signed_wide: buffer, %unsigned_wide: buffer, %output: buffer) {
  %signed_words_byte_offset = index.constant 0 : index
  %14 = func.call @atomic_i32(%signed_words, %signed_words_byte_offset) : (buffer, index) -> (i32)
  %46 = index.constant 4 : index
  %20 = buffer.view %output[%46] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %14, %20[0] : i32, view<1xi32>
  %21 = func.call @atomic_i64(%signed_wide, %signed_words_byte_offset) : (buffer, index) -> (i32)
  %45 = index.constant 8 : index
  %27 = buffer.view %output[%45] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %21, %27[0] : i32, view<1xi32>
  %28 = func.call @atomic_u64(%unsigned_wide, %signed_words_byte_offset) : (buffer, index) -> (i32)
  %44 = index.constant 12 : index
  %34 = buffer.view %output[%44] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %28, %34[0] : i32, view<1xi32>
  kernel.return
}

func.decl @atomic_i32(%35: buffer, %36: index) -> (i32)

func.decl @atomic_i64(%38: buffer, %39: index) -> (i32)

func.decl @atomic_u64(%41: buffer, %42: index) -> (i32)
