// RUN: pass canonicalize,cse,dce
// A header helper controls a uniform barrier independently for each workgroup.
#include <loomcxx/check.h>
#include <loomcxx/kernel.h>

constexpr unsigned kWorkgroupSize = 64u;
constexpr unsigned kWorkgroupCount = 2u;
constexpr unsigned kElementCount = kWorkgroupSize * kWorkgroupCount;

LOOM_INLINE unsigned read_active_workgroups(const unsigned* header) {
  return header[0];
}

[[loom::kernel, loom::workgroup_size(64, 1, 1), loom::workgroup_count(2, 1, 1)]]
void uniform_helper_barrier(const unsigned* header, unsigned* output) {
  unsigned workgroup = loom::kernel::workgroup::id.x;
  if (workgroup < read_active_workgroups(header)) {
    loom::kernel::workgroup::barrier();
  }
  unsigned item = workgroup * kWorkgroupSize + loom::kernel::workitem::id.x;
  output[item] = item;
}
// ----
func.def public linkonce inline @read_active_workgroups(%header: buffer, %header_byte_offset: index) -> (i32) {
  %8 = buffer.view %header[%header_byte_offset] : buffer -> view<1xi32>
  %9 = view.load<root_in_bounds|type_disjoint> %8[0] : view<1xi32> -> i32
  func.return %9 : i32
}

kernel.def @uniform_helper_barrier() {
  %12 = index.constant 2 : index
  %13 = index.constant 1 : index
  %15 = index.constant 64 : index
  kernel.launch.config workgroups(%12, %13, %13) workgroup_size(%15, %13, %13) : index
} launch(%header: buffer, %output: buffer) {
  %header_byte_offset = index.constant 0 : index
  %workgroup_id_x = kernel.workgroup.id<x> : index
  %workgroup = index.cast %workgroup_id_x : index to i32
  %22 = func.call readonly @read_active_workgroups(%header, %header_byte_offset) : (buffer, index) -> (i32)
  %23 = scalar.cmpi ult, %workgroup, %22 : i32
  scf.if %23 {
    kernel.barrier<global> scope(workgroup) ordering(acq_rel)
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  }
  %35 = scalar.constant 6 : i32
  %36 = scalar.shli %workgroup, %35 : i32
  %workitem_id_x = kernel.workitem.id<x> : index
  %27 = index.cast %workitem_id_x : index to i32
  %item = scalar.addi %36, %27 : i32
  %29 = scalar.extui %item : i32 to i64
  %30 = index.cast %29 : i64 to index
  %31 = index.constant 4 : index
  %32 = index.mul %30, %31 : index
  %34 = buffer.view %output[%32] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %item, %34[0] : i32, view<1xi32>
  kernel.return
}
