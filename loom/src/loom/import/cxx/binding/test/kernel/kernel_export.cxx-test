#include <loomcxx/kernel.h>

static loom::kernel::clustered_configuration clustered_configuration(unsigned groups, unsigned cluster) {
  return {{(groups * cluster), 1u, 1u}, {64u, 1u, 1u}, {cluster, 1u, 1u}};
}

[[loom::kernel(clustered_configuration)]]
void clustered() {
}
