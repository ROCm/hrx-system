// REQUIRES: loom-export-cxx
// RUN: emit cxx
#include <loomcxx/kernel.h>

static loom::kernel::clustered_configuration configure_clustered(unsigned groups, unsigned cluster) {
  return {{groups * cluster, 1, 1}, {64, 1, 1}, {cluster, 1, 1}};
}

[[loom::kernel(configure_clustered)]]
void clustered() {}

