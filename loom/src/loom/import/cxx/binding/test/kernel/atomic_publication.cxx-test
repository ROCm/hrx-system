// RUN: pass canonicalize,cse,dce
// Const-volatile interior origins survive a helper before release, fence, and reload.
static unsigned observe(const volatile unsigned* source) {
  return __atomic_load_n(source, __ATOMIC_ACQUIRE);
}
unsigned publication_value(unsigned* storage) {
  volatile unsigned* destination = storage + 1;
  unsigned value = observe(destination) ^ 0x80000000u;
  __atomic_store_n(destination, value, __ATOMIC_RELEASE);
  __atomic_thread_fence(__ATOMIC_ACQ_REL);
  return __atomic_load_n(destination, __ATOMIC_SEQ_CST);
}
// ----
func.def public @publication_value(%storage: buffer, %storage_byte_offset: index) -> (i32) {
  %19 = index.constant 4 : index
  %destination_byte_offset = index.add %storage_byte_offset, %19 : index
  %8 = func.call @observe(%storage, %destination_byte_offset) : (buffer, index) -> (i32)
  %9 = scalar.constant -2147483648 : i32
  %value = scalar.xori %8, %9 : i32
  %11 = buffer.view %storage[%destination_byte_offset] : buffer -> view<1xi32>
  view.atomic.store<root_in_bounds|type_disjoint> %value, %11[0] {ordering = release, scope = system} : i32, view<1xi32>
  buffer.fence scope(system) ordering(acq_rel)
  %13 = view.atomic.load<root_in_bounds|type_disjoint> %11[0] {ordering = seq_cst, scope = system} : view<1xi32> -> i32
  func.return %13 : i32
}

func.def @observe(%source: buffer, %source_byte_offset: index) -> (i32) {
  %17 = buffer.view %source[%source_byte_offset] : buffer -> view<1xi32>
  %18 = view.atomic.load<root_in_bounds|type_disjoint> %17[0] {ordering = acquire, scope = system} : view<1xi32> -> i32
  func.return %18 : i32
}

// ====
// RUN: pass canonicalize,cse,dce
// Wide publication keeps full object bits and eight-byte interior origins.
[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void wide_publication(unsigned long long* storage, unsigned long long* output) {
  volatile unsigned long long* destination = storage + 1;
  output[0] = __atomic_load_n(destination, __ATOMIC_ACQUIRE);
  __atomic_store_n(destination, 0x1234567887654321ull, __ATOMIC_RELEASE);
  __atomic_thread_fence(__ATOMIC_ACQ_REL);
  output[1] = __atomic_load_n(destination, __ATOMIC_SEQ_CST);
}
// ----
kernel.def @wide_publication() {
  %2 = index.constant 1 : index
  kernel.launch.config workgroups(%2, %2, %2) workgroup_size(%2, %2, %2) : index
} launch(%storage: buffer, %output: buffer) {
  %destination_byte_offset = index.constant 8 : index
  %15 = buffer.view %storage[%destination_byte_offset] : buffer -> view<1xi64>
  %16 = view.atomic.load<root_in_bounds|type_disjoint> %15[0] {ordering = acquire, scope = system} : view<1xi64> -> i64
  %34 = index.constant 0 : index
  %22 = buffer.view %output[%34] : buffer -> view<1xi64>
  view.store<root_in_bounds|type_disjoint> %16, %22[0] : i64, view<1xi64>
  %23 = scalar.constant 1311768467139281697 : i64
  view.atomic.store<root_in_bounds|type_disjoint> %23, %15[0] {ordering = release, scope = system} : i64, view<1xi64>
  buffer.fence scope(system) ordering(acq_rel)
  %26 = view.atomic.load<root_in_bounds|type_disjoint> %15[0] {ordering = seq_cst, scope = system} : view<1xi64> -> i64
  %32 = buffer.view %output[%destination_byte_offset] : buffer -> view<1xi64>
  view.store<root_in_bounds|type_disjoint> %26, %32[0] : i64, view<1xi64>
  kernel.return
}
