// RUN: pass canonicalize,cse,dce
// Const-volatile interior origins survive a helper before release, fence, and reload.
static unsigned observe(const volatile unsigned* source) {
  return __atomic_load_n(source, __ATOMIC_ACQUIRE);
}
unsigned publication_value(unsigned* storage) {
  volatile unsigned* destination = storage + 1;
  unsigned value = observe(destination) ^ 0x80000000u;
  __atomic_store_n(destination, value, __ATOMIC_RELEASE);
  __atomic_thread_fence(__ATOMIC_ACQ_REL);
  return __atomic_load_n(destination, __ATOMIC_SEQ_CST);
}
// ----
func.def public @publication_value(%storage: buffer, %storage_byte_offset: offset) -> (i32) {
  %22 = scalar.constant 4 : i64
  %7 = index.cast %storage_byte_offset : offset to i64
  %8 = scalar.addi %7, %22 : i64
  %9 = scalar.assume %8 [range(%8, 0, 9223372036854775807)] : i64
  %destination_byte_offset = index.cast %9 : i64 to offset
  %11 = func.call @observe(%storage, %destination_byte_offset) : (buffer, offset) -> (i32)
  %12 = scalar.constant -2147483648 : i32
  %value = scalar.xori %11, %12 : i32
  %14 = buffer.view %storage[%destination_byte_offset] : buffer -> view<1xi32>
  view.atomic.store %value, %14[0] {ordering = release, scope = system} : i32, view<1xi32>
  buffer.fence scope(system) ordering(acq_rel)
  %16 = view.atomic.load %14[0] {ordering = seq_cst, scope = system} : view<1xi32> -> i32
  func.return %16 : i32
}

func.def @observe(%source: buffer, %source_byte_offset: offset) -> (i32) {
  %20 = buffer.view %source[%source_byte_offset] : buffer -> view<1xi32>
  %21 = view.atomic.load %20[0] {ordering = acquire, scope = system} : view<1xi32> -> i32
  func.return %21 : i32
}

// ====
// RUN: pass canonicalize,cse,dce
// Wide publication keeps full object bits and eight-byte interior origins.
[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void wide_publication(unsigned long long* storage, unsigned long long* output) {
  volatile unsigned long long* destination = storage + 1;
  output[0] = __atomic_load_n(destination, __ATOMIC_ACQUIRE);
  __atomic_store_n(destination, 0x1234567887654321ull, __ATOMIC_RELEASE);
  __atomic_thread_fence(__ATOMIC_ACQ_REL);
  output[1] = __atomic_load_n(destination, __ATOMIC_SEQ_CST);
}
// ----
kernel.def @wide_publication() {
  %2 = index.constant 1 : index
  kernel.launch.config workgroups(%2, %2, %2) workgroup_size(%2, %2, %2) : index
} launch(%storage: buffer, %output: buffer) {
  %destination_byte_offset = index.constant 8 : offset
  %18 = buffer.view %storage[%destination_byte_offset] : buffer -> view<1xi64>
  %19 = view.atomic.load %18[0] {ordering = acquire, scope = system} : view<1xi64> -> i64
  %43 = index.constant 0 : offset
  %28 = buffer.view %output[%43] : buffer -> view<1xi64>
  view.store %19, %28[0] : i64, view<1xi64>
  %29 = scalar.constant 1311768467139281697 : i64
  view.atomic.store %29, %18[0] {ordering = release, scope = system} : i64, view<1xi64>
  buffer.fence scope(system) ordering(acq_rel)
  %32 = view.atomic.load %18[0] {ordering = seq_cst, scope = system} : view<1xi64> -> i64
  %41 = buffer.view %output[%destination_byte_offset] : buffer -> view<1xi64>
  view.store %32, %41[0] : i64, view<1xi64>
  kernel.return
}
