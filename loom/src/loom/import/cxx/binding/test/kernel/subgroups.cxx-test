  %30 = buffer.view %output[%29] : buffer -> view<1xi32>
  view.store %22, %30[0] : i32, view<1xi32>
  %31 = scalar.constant 3 : i32
  %32 = scalar.cmpi ugt, %lane, %31 : i32
  %33 = kernel.subgroup.vote.ballot %32 : i1 -> i64
  %131 = scalar.constant 3 : i64
  %132 = scalar.shli %23, %131 : i64
  %39 = scalar.assume %132 [range(%132, 0, 9223372036854775807)] : i64
  %40 = index.cast %39 : i64 to offset
  %41 = buffer.view %masks[%40] : buffer -> view<1xi64>
  view.store %33, %41[0] : i64, view<1xi64>
  %42 = kernel.subgroup.active.mask : i64
  %43 = scalar.constant 32 : i32
  %44 = scalar.addi %lane, %43 : i32
  %45 = scalar.extui %44 : i32 to i64
  %130 = scalar.shli %45, %131 : i64
  %50 = scalar.assume %130 [range(%130, 0, 9223372036854775807)] : i64
  %51 = index.cast %50 : i64 to offset
  %52 = buffer.view %masks[%51] : buffer -> view<1xi64>
  view.store %42, %52[0] : i64, view<1xi64>
  %54 = scalar.cmpi ult, %lane, %31 : i32
  %55 = kernel.subgroup.vote.ballot %54 : i1 -> i32
  %128 = scalar.shli %45, %133 : i64
  %63 = scalar.assume %128 [range(%128, 0, 9223372036854775807)] : i64
  %64 = index.cast %63 : i64 to offset
  %65 = buffer.view %output[%64] : buffer -> view<1xi32>
  view.store %55, %65[0] : i32, view<1xi32>
  %66 = kernel.subgroup.active.mask : i32
  %67 = scalar.constant 64 : i32
  %68 = scalar.addi %lane, %67 : i32
  %69 = scalar.extui %68 : i32 to i64
  %126 = scalar.shli %69, %133 : i64
  %74 = scalar.assume %126 [range(%126, 0, 9223372036854775807)] : i64
  %75 = index.cast %74 : i64 to offset
  %76 = buffer.view %output[%75] : buffer -> view<1xi32>
  view.store %66, %76[0] : i32, view<1xi32>
  %77 = scalar.constant 7 : i32
  %78 = scalar.cmpi eq, %lane, %77 : i32
  %79 = kernel.subgroup.vote.any %78 : i1
  %80 = scalar.extui %79 : i1 to i32
