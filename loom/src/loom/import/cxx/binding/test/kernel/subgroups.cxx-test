// RUN: pass canonicalize,cse,dce
#include <loomcxx/kernel.h>
using Float4 = float __attribute__((ext_vector_type(4)));

[[loom::inline]] static Float4 first(Float4 value) {
  return loom::kernel::subgroup::broadcast_first(value);
}

[[loom::kernel, loom::workgroup_size(32, 1, 1), loom::workgroup_count(1, 1, 1)]]
void entry(unsigned* output, unsigned long long* masks, Float4* vectors,
           Float4 value) {
  unsigned lane = loom::kernel::subgroup::lane_id();
  output[lane] = loom::kernel::subgroup::id() +
                 loom::kernel::subgroup::count() +
                 loom::kernel::subgroup::size();
  masks[lane] = loom::kernel::subgroup::vote::ballot(lane > 3);
  masks[lane + 32] = loom::kernel::subgroup::active_mask();
  output[lane + 32] = loom::kernel::subgroup::vote::ballot<unsigned>(lane < 3);
  output[lane + 64] = loom::kernel::subgroup::active_mask<unsigned>();
  output[lane + 96] = loom::kernel::subgroup::vote::any(lane == 7);
  output[lane + 128] = loom::kernel::subgroup::vote::all(lane < 31);
  vectors[lane] = first(loom::kernel::subgroup::broadcast(value, 7));
  loom::kernel::barrier<loom::memory_space::global,
                        loom::atomic::scope::subgroup,
                        loom::atomic::ordering::acq_rel>();
}
// ----
kernel.def @entry() {
  %4 = index.constant 1 : index
  %7 = index.constant 32 : index
  kernel.launch.config workgroups(%4, %4, %4) workgroup_size(%7, %4, %4) : index
} launch(%output: buffer, %masks: buffer, %vectors: buffer, %value: vector<4xf32>) {
  %13 = kernel.subgroup.lane.id : index
  %lane = index.cast %13 : index to i32
  %15 = kernel.subgroup.id : index
  %16 = index.cast %15 : index to i32
  %17 = kernel.subgroup.count : index
  %18 = index.cast %17 : index to i32
  %19 = scalar.addi %16, %18 : i32
  %20 = kernel.subgroup.size : index
  %21 = index.cast %20 : index to i32
  %22 = scalar.addi %19, %21 : i32
  %23 = scalar.extui %lane : i32 to i64
  %24 = index.cast %23 : i64 to index
  %25 = index.constant 4 : index
  %26 = index.mul %24, %25 : index
  %28 = buffer.view %output[%26] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %22, %28[0] : i32, view<1xi32>
  %29 = scalar.constant 3 : i32
  %30 = scalar.cmpi ugt, %lane, %29 : i32
  %31 = kernel.subgroup.vote.ballot %30 : i1 -> i64
  %34 = index.constant 8 : index
  %35 = index.mul %24, %34 : index
  %37 = buffer.view %masks[%35] : buffer -> view<1xi64>
  view.store<root_in_bounds|type_disjoint> %31, %37[0] : i64, view<1xi64>
  %38 = kernel.subgroup.active.mask : i64
  %39 = scalar.constant 32 : i32
  %40 = scalar.addi %lane, %39 : i32
  %41 = scalar.extui %40 : i32 to i64
  %42 = index.cast %41 : i64 to index
  %44 = index.mul %42, %34 : index
  %46 = buffer.view %masks[%44] : buffer -> view<1xi64>
  view.store<root_in_bounds|type_disjoint> %38, %46[0] : i64, view<1xi64>
  %48 = scalar.cmpi ult, %lane, %29 : i32
  %49 = kernel.subgroup.vote.ballot %48 : i1 -> i32
  %55 = index.mul %42, %25 : index
  %57 = buffer.view %output[%55] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %49, %57[0] : i32, view<1xi32>
  %58 = kernel.subgroup.active.mask : i32
  %59 = scalar.constant 64 : i32
  %60 = scalar.addi %lane, %59 : i32
  %61 = scalar.extui %60 : i32 to i64
  %62 = index.cast %61 : i64 to index
  %64 = index.mul %62, %25 : index
  %66 = buffer.view %output[%64] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %58, %66[0] : i32, view<1xi32>
  %67 = scalar.constant 7 : i32
  %68 = scalar.cmpi eq, %lane, %67 : i32
  %69 = kernel.subgroup.vote.any %68 : i1
  %70 = scalar.extui %69 : i1 to i32
  %71 = scalar.constant 96 : i32
  %72 = scalar.addi %lane, %71 : i32
  %73 = scalar.extui %72 : i32 to i64
  %74 = index.cast %73 : i64 to index
  %76 = index.mul %74, %25 : index
  %78 = buffer.view %output[%76] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %70, %78[0] : i32, view<1xi32>
  %79 = scalar.constant 31 : i32
  %80 = scalar.cmpi ult, %lane, %79 : i32
  %81 = kernel.subgroup.vote.all %80 : i1
  %82 = scalar.extui %81 : i1 to i32
  %83 = scalar.constant 128 : i32
  %84 = scalar.addi %lane, %83 : i32
  %85 = scalar.extui %84 : i32 to i64
  %86 = index.cast %85 : i64 to index
  %88 = index.mul %86, %25 : index
  %90 = buffer.view %output[%88] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %82, %90[0] : i32, view<1xi32>
  %92 = kernel.subgroup.broadcast %value from %67 : vector<4xf32>, i32
  %93 = func.call @first(%92) : (vector<4xf32>) -> (vector<4xf32>)
  %96 = index.constant 16 : index
  %97 = index.mul %24, %96 : index
  %99 = buffer.view %vectors[%97] : buffer -> view<4xf32>
  vector.store<root_in_bounds> %93, %99[0] : vector<4xf32>, view<4xf32>
  kernel.barrier<global> scope(subgroup) ordering(acq_rel)
  kernel.return
}

func.def inline @first(%value: vector<4xf32>) -> (vector<4xf32>) {
  %102 = kernel.subgroup.broadcast.first %value : vector<4xf32>
  func.return %102 : vector<4xf32>
}

// ====
// Custom declarations and ordinary callable barriers use the same bindings.
[[loom::op("kernel.subgroup.lane.id")]] unsigned lane_id();
[[loom::op("kernel.subgroup.vote.ballot")]] unsigned ready_mask(bool);
template <int Space, int Scope, int Ordering>
[[loom::op("kernel.barrier")]] void synchronize();
void workgroup_memory() { synchronize<2, 2, 3>(); }
[[loom::kernel]] void entry(unsigned* output, bool ready) {
  output[0] = ready_mask(ready);
  output[1] = lane_id();
  workgroup_memory();
}
// ----
func.def public @workgroup_memory() {
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  func.return
}

kernel.def @entry() {
  %workgroup_count_x = config.get @entry.workgroup_count.x : index
  %workgroup_count_y = config.get @entry.workgroup_count.y : index
  %workgroup_count_z = config.get @entry.workgroup_count.z : index
  %workgroup_size_x = config.get @entry.workgroup_size.x : index
  %workgroup_size_y = config.get @entry.workgroup_size.y : index
  %workgroup_size_z = config.get @entry.workgroup_size.z : index
  kernel.launch.config workgroups(%workgroup_count_x, %workgroup_count_y, %workgroup_count_z) workgroup_size(%workgroup_size_x, %workgroup_size_y, %workgroup_size_z) : index
} launch(%output: buffer, %ready: i1) {
  %15 = kernel.subgroup.vote.ballot %ready : i1 -> i32
  %31 = index.constant 0 : index
  %21 = buffer.view %output[%31] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %15, %21[0] : i32, view<1xi32>
  %22 = kernel.subgroup.lane.id : index
  %23 = index.cast %22 : index to i32
  %30 = index.constant 4 : index
  %29 = buffer.view %output[%30] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %23, %29[0] : i32, view<1xi32>
  func.call @workgroup_memory() : ()
  kernel.return
}

config.decl @entry.workgroup_count.x : index

config.decl @entry.workgroup_count.y : index

config.decl @entry.workgroup_count.z : index

config.decl @entry.workgroup_size.x : index

config.decl @entry.workgroup_size.y : index

config.decl @entry.workgroup_size.z : index

// ====
// Source transport retains a wide payload for the selected target to legalize.
#include <loomcxx/kernel.h>
[[loom::inline]] unsigned long long first(unsigned long long value) {
  return loom::kernel::subgroup::broadcast_first(value);
}
// ----
func.def public inline @first(%value: i64) -> (i64) {
  %2 = kernel.subgroup.broadcast.first %value : i64
  func.return %2 : i64
}
