// ====
// Custom declarations and ordinary callable barriers use the same bindings.
[[loom::op("kernel.subgroup.lane.id")]] unsigned lane_id();
[[loom::op("kernel.subgroup.vote.ballot")]] unsigned ready_mask(bool);
template <int Space, int Scope, int Ordering>
[[loom::op("kernel.barrier")]] void synchronize();
void workgroup_memory() { synchronize<2, 2, 3>(); }
[[loom::kernel]] void entry(unsigned* output, bool ready) {
  output[0] = ready_mask(ready);
  output[1] = lane_id();
  workgroup_memory();
}
// ----
func.def public @workgroup_memory() {
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  func.return
}

kernel.def @entry() {
  %workgroup_count_x = config.get @entry.workgroup_count.x : index
  %workgroup_count_y = config.get @entry.workgroup_count.y : index
  %workgroup_count_z = config.get @entry.workgroup_count.z : index
  %workgroup_size_x = config.get @entry.workgroup_size.x : index
  %workgroup_size_y = config.get @entry.workgroup_size.y : index
  %workgroup_size_z = config.get @entry.workgroup_size.z : index
  kernel.launch.config workgroups(%workgroup_count_x, %workgroup_count_y, %workgroup_count_z) workgroup_size(%workgroup_size_x, %workgroup_size_y, %workgroup_size_z) : index
} launch(%output: buffer, %ready: i1) {
  %15 = kernel.subgroup.vote.ballot %ready : i1 -> i32
  %37 = index.constant 0 : offset
  %24 = buffer.view %output[%37] : buffer -> view<1xi32>
  view.store %15, %24[0] : i32, view<1xi32>
  %25 = kernel.subgroup.lane.id : index
  %26 = index.cast %25 : index to i32
  %36 = index.constant 4 : offset
  %35 = buffer.view %output[%36] : buffer -> view<1xi32>
  view.store %26, %35[0] : i32, view<1xi32>
  func.call @workgroup_memory() : ()
  kernel.return
}

config.decl @entry.workgroup_count.x : index

config.decl @entry.workgroup_count.y : index

config.decl @entry.workgroup_count.z : index

config.decl @entry.workgroup_size.x : index

config.decl @entry.workgroup_size.y : index

config.decl @entry.workgroup_size.z : index

// ====
// Source transport retains a wide payload for the selected target to legalize.
#include <loomcxx/kernel.h>
[[loom::inline]] unsigned long long first(unsigned long long value) {
  return loom::kernel::subgroup::broadcast_first(value);
}
// ----
func.def public inline @first(%value: i64) -> (i64) {
  %2 = kernel.subgroup.broadcast.first %value : i64
  func.return %2 : i64
}
