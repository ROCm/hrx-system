  %88 = scalar.assume %124 [range(%124, 0, 9223372036854775807)] : i64
  %89 = index.cast %88 : i64 to offset
  %90 = buffer.view %output[%89] : buffer -> view<1xi32>
  view.store %80, %90[0] : i32, view<1xi32>
