// RUN: pass canonicalize,cse,dce
// Every non-order argument is evaluated once before expected is loaded.
// Only a failed exchange writes expected, including when expected aliases state.
template <class T>
static T once(T value, unsigned* evaluations) {
  ++*evaluations;
  return value;
}

unsigned builtin_compare_values(unsigned* storage, unsigned* evaluations) {
  auto* word = storage + 1;
  auto* expected = storage + 2;
  unsigned failures = 0;
  failures += !__atomic_compare_exchange_n(
      once(word, evaluations + 1), once(expected, evaluations + 2),
      once(7u, evaluations + 3), once(true, evaluations + 4), __ATOMIC_ACQ_REL,
      __ATOMIC_ACQUIRE);
  failures += *expected != 37u;
  failures += __atomic_compare_exchange_n(
      once(word, evaluations + 1), once(expected, evaluations + 2),
      once(11u, evaluations + 3), once(false, evaluations + 4),
      __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST);
  failures += *expected != 7u;
  // Aliasing makes an erroneous store on success observable: it would undo 13.
  failures += !__atomic_compare_exchange_n(word, word, 13u, false,
                                           __ATOMIC_RELAXED, __ATOMIC_RELAXED);
  return failures;
}
// ----
func.def public @builtin_compare_values(%storage: buffer, %storage_byte_offset: index, %evaluations: buffer, %evaluations_byte_offset: index) -> (i32) {
  %155 = index.constant 4 : index
  %word_byte_offset = index.add %storage_byte_offset, %155 : index
  %154 = index.constant 8 : index
  %expected_byte_offset = index.add %storage_byte_offset, %154 : index
  %20 = index.add %evaluations_byte_offset, %155 : index
  %21, %22 = func.call @once_unsigned_int_(%storage, %word_byte_offset, %evaluations, %20) : (buffer, index, buffer, index) -> (buffer, index)
  %27 = index.add %evaluations_byte_offset, %154 : index
  %28, %29 = func.call @once_unsigned_int_(%storage, %expected_byte_offset, %evaluations, %27) : (buffer, index, buffer, index) -> (buffer, index)
  %30 = scalar.constant 7 : i32
  %151 = index.constant 12 : index
  %35 = index.add %evaluations_byte_offset, %151 : index
  %36 = func.call @once_unsigned_int(%30, %evaluations, %35) : (i32, buffer, index) -> (i32)
  %37 = scalar.constant 1 : i1
  %150 = index.constant 16 : index
  %42 = index.add %evaluations_byte_offset, %150 : index
  %43 = func.call @once_bool(%37, %evaluations, %42) : (i1, buffer, index) -> (i1)
  %44 = buffer.view %28[%29] : buffer -> view<1xi32>
  %45 = view.load<root_in_bounds|type_disjoint> %44[0] : view<1xi32> -> i32
  %46 = buffer.view %21[%22] : buffer -> view<1xi32>
  %47 = view.atomic.cmpxchg<root_in_bounds|type_disjoint> %45, %36, %46[0] {failure_ordering = acquire, scope = system, success_ordering = acq_rel} : i32, view<1xi32> -> i32
  %48 = scalar.cmpi eq, %47, %45 : i32
  %50 = scalar.xori %48, %37 : i1
  scf.if %50 {
    %143 = scalar.assume %47 [ne(%47, %45)] : i32
    view.store<root_in_bounds|type_disjoint> %143, %44[0] : i32, view<1xi32>
  }
  %53 = scalar.extui %50 : i1 to i32
  %55 = buffer.view %storage[%expected_byte_offset] : buffer -> view<1xi32>
  %56 = view.load<root_in_bounds|type_disjoint> %55[0] : view<1xi32> -> i32
  %57 = scalar.constant 37 : i32
  %58 = scalar.cmpi ne, %56, %57 : i32
  %59 = scalar.extui %58 : i1 to i32
  %156 = scalar.addi %53, %59 : i32
  %66, %67 = func.call @once_unsigned_int_(%storage, %word_byte_offset, %evaluations, %20) : (buffer, index, buffer, index) -> (buffer, index)
  %73, %74 = func.call @once_unsigned_int_(%storage, %expected_byte_offset, %evaluations, %27) : (buffer, index, buffer, index) -> (buffer, index)
  %75 = scalar.constant 11 : i32
  %81 = func.call @once_unsigned_int(%75, %evaluations, %35) : (i32, buffer, index) -> (i32)
  %82 = scalar.constant 0 : i1
  %88 = func.call @once_bool(%82, %evaluations, %42) : (i1, buffer, index) -> (i1)
  %89 = buffer.view %73[%74] : buffer -> view<1xi32>
  %90 = view.load<root_in_bounds|type_disjoint> %89[0] : view<1xi32> -> i32
  %91 = buffer.view %66[%67] : buffer -> view<1xi32>
  %92 = view.atomic.cmpxchg<root_in_bounds|type_disjoint> %90, %81, %91[0] {failure_ordering = seq_cst, scope = system, success_ordering = seq_cst} : i32, view<1xi32> -> i32
  %93 = scalar.cmpi eq, %92, %90 : i32
  %95 = scalar.xori %93, %37 : i1
  scf.if %95 {
    %144 = scalar.assume %92 [ne(%92, %90)] : i32
    view.store<root_in_bounds|type_disjoint> %144, %89[0] : i32, view<1xi32>
  }
  %96 = scalar.extui %93 : i1 to i32
  %158 = scalar.addi %156, %96 : i32
  %99 = view.load<root_in_bounds|type_disjoint> %55[0] : view<1xi32> -> i32
  %101 = scalar.cmpi ne, %99, %30 : i32
  %102 = scalar.extui %101 : i1 to i32
  %failures$103 = scalar.addi %158, %102 : i32
  %104 = scalar.constant 13 : i32
  %106 = buffer.view %storage[%word_byte_offset] : buffer -> view<1xi32>
  %107 = view.load<root_in_bounds|type_disjoint> %106[0] : view<1xi32> -> i32
  %109 = view.atomic.cmpxchg<root_in_bounds|type_disjoint> %107, %104, %106[0] {failure_ordering = relaxed, scope = system, success_ordering = relaxed} : i32, view<1xi32> -> i32
  %110 = scalar.cmpi eq, %109, %107 : i32
  %112 = scalar.xori %110, %37 : i1
  scf.if %112 {
    %145 = scalar.assume %109 [ne(%109, %107)] : i32
    view.store<root_in_bounds|type_disjoint> %145, %106[0] : i32, view<1xi32>
  }
  %115 = scalar.extui %112 : i1 to i32
  %failures$116 = scalar.addi %failures$103, %115 : i32
  func.return %failures$116 : i32
}

func.def @once_unsigned_int_(%value: buffer, %value_byte_offset: index, %evaluations: buffer, %evaluations_byte_offset: index) -> (buffer, index) {
  %123 = buffer.view %evaluations[%evaluations_byte_offset] : buffer -> view<1xi32>
  %124 = view.load<root_in_bounds|type_disjoint> %123[0] : view<1xi32> -> i32
  %125 = scalar.constant 1 : i32
  %126 = scalar.addi %124, %125 : i32
  view.store<root_in_bounds|type_disjoint> %126, %123[0] : i32, view<1xi32>
  func.return %value, %value_byte_offset : buffer, index
}

func.def @once_unsigned_int(%value: i32, %evaluations: buffer, %evaluations_byte_offset: index) -> (i32) {
  %131 = buffer.view %evaluations[%evaluations_byte_offset] : buffer -> view<1xi32>
  %132 = view.load<root_in_bounds|type_disjoint> %131[0] : view<1xi32> -> i32
  %133 = scalar.constant 1 : i32
  %134 = scalar.addi %132, %133 : i32
  view.store<root_in_bounds|type_disjoint> %134, %131[0] : i32, view<1xi32>
  func.return %value : i32
}

func.def @once_bool(%value: i1, %evaluations: buffer, %evaluations_byte_offset: index) -> (i1) {
  %139 = buffer.view %evaluations[%evaluations_byte_offset] : buffer -> view<1xi32>
  %140 = view.load<root_in_bounds|type_disjoint> %139[0] : view<1xi32> -> i32
  %141 = scalar.constant 1 : i32
  %142 = scalar.addi %140, %141 : i32
  view.store<root_in_bounds|type_disjoint> %142, %139[0] : i32, view<1xi32>
  func.return %value : i1
}
