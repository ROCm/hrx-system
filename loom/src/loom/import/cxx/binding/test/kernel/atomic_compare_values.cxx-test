func.def @once_unsigned_int_(%value: buffer, %value_byte_offset: offset, %evaluations: buffer, %evaluations_byte_offset: offset) -> (buffer, offset) {
  %153 = buffer.view %evaluations[%evaluations_byte_offset] : buffer -> view<1xi32>
  %154 = view.load %153[0] : view<1xi32> -> i32
  %155 = scalar.constant 1 : i32
  %156 = scalar.addi %154, %155 : i32
  view.store %156, %153[0] : i32, view<1xi32>
  func.return %value, %value_byte_offset : buffer, offset
}

