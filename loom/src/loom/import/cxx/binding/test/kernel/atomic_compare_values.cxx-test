  %49 = scalar.assume %48 [range(%48, 0, 9223372036854775807)] : i64
  %50 = index.cast %49 : i64 to offset
  %51 = func.call @once_unsigned_int(%42, %evaluations, %50) : (i32, buffer, offset) -> (i32)
  %52 = scalar.constant 1 : i1
  %180 = scalar.constant 16 : i64
  %58 = scalar.addi %26, %180 : i64
  %59 = scalar.assume %58 [range(%58, 0, 9223372036854775807)] : i64
  %60 = index.cast %59 : i64 to offset
  %61 = func.call @once_bool(%52, %evaluations, %60) : (i1, buffer, offset) -> (i1)
  %62 = buffer.view %40[%41] : buffer -> view<1xi32>
