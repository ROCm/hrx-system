  %75 = scalar.constant 37 : i32
  %76 = scalar.cmpi ne, %74, %75 : i32
  %77 = scalar.extui %76 : i1 to i32
  %186 = scalar.addi %71, %77 : i32
  %87, %88 = func.call @once_unsigned_int_(%storage, %word_byte_offset, %evaluations, %29) : (buffer, offset, buffer, offset) -> (buffer, offset)
  %97, %98 = func.call @once_unsigned_int_(%storage, %expected_byte_offset, %evaluations, %39) : (buffer, offset, buffer, offset) -> (buffer, offset)
  %99 = scalar.constant 11 : i32
  %108 = func.call @once_unsigned_int(%99, %evaluations, %50) : (i32, buffer, offset) -> (i32)
  %109 = scalar.constant 0 : i1
