// ====
// RUN: pass canonicalize,cse,dce
// INPUT: cxx root=observe_builtin_compare
// The observer retains independent storage slots and returned result components.
template <class T>
struct CompareObservation {
  // Failed comparisons of atomic return and expected-value semantics.
  unsigned failures;
  // Guard immediately before the atomic and expected-value slots.
  T before;
  // Final value of the atomically updated word.
  T value;
  // Expected-value slot written by a failed compare-exchange.
  T expected;
  // Guard immediately after the atomic and expected-value slots.
  T after;
};

struct CountedObservation {
  // Atomic values observed after all compare-exchange operations.
  CompareObservation<unsigned> compare;
  // Mismatches in argument evaluation counts and their neighboring guards.
  unsigned evaluation_failures;
};

unsigned builtin_compare_values(unsigned* storage, unsigned* evaluations);
static CountedObservation observe_builtin_compare() {
  // The trailing counters and their guards start at zero. Both helper
  // arguments name disjoint regions of this same automatic allocation.
  unsigned storage[10] = {37, 37, 37, 37};
  unsigned failures = builtin_compare_values(storage, storage + 4);
  unsigned evaluation_failures = 0;
  for (unsigned index = 4; index < 10; ++index) {
    unsigned wanted = index >= 5 && index < 9 ? 2 : 0;
    evaluation_failures += storage[index] != wanted;
  }
  return {{failures, storage[0], storage[1], storage[2], storage[3]},
          evaluation_failures};
}
// ----
func.def public @observe_builtin_compare() -> (i32, i32, i32, i32, i32, i32) {
  %6 = index.constant 40 : offset
  %storage_storage = buffer.alloca<private> align(4) %6 : buffer
  %storage_storage_byte_offset = index.constant 0 : offset
  %storage_view = buffer.view %storage_storage[%storage_storage_byte_offset] : buffer -> view<10xi32>
  %10 = scalar.constant 37 : i32
  %11 = index.constant 0 : index
  view.store %10, %storage_view[%11] : i32, view<10xi32>
  %13 = index.constant 1 : index
  view.store %10, %storage_view[%13] : i32, view<10xi32>
  %15 = index.constant 2 : index
  view.store %10, %storage_view[%15] : i32, view<10xi32>
  %17 = index.constant 3 : index
  view.store %10, %storage_view[%17] : i32, view<10xi32>
  %zero$i32 = scalar.constant 0 : i32
  %19 = index.constant 4 : index
  view.store %zero$i32, %storage_view[%19] : i32, view<10xi32>
  %21 = index.constant 5 : index
  view.store %zero$i32, %storage_view[%21] : i32, view<10xi32>
  %23 = index.constant 6 : index
  view.store %zero$i32, %storage_view[%23] : i32, view<10xi32>
  %25 = index.constant 7 : index
  view.store %zero$i32, %storage_view[%25] : i32, view<10xi32>
  %27 = index.constant 8 : index
  view.store %zero$i32, %storage_view[%27] : i32, view<10xi32>
  %29 = index.constant 9 : index
  view.store %zero$i32, %storage_view[%29] : i32, view<10xi32>
  %96 = index.constant 16 : offset
  %failures = func.call @builtin_compare_values(%storage_storage, %storage_storage_byte_offset, %storage_storage, %96) : (buffer, offset, buffer, offset) -> (i32)
  %95 = index.constant 4 : offset
  %94 = index.constant 10 : offset
  %44 = index.constant 1 : offset
  %evaluation_failures = scf.for %index = [%95 to %94 step %44](%evaluation_failures$46 = %zero$i32 : i32) -> (i32) {
    %48 = index.cast %index : offset to i32
    %49 = scalar.constant 5 : i32
    %50 = scalar.cmpi uge, %48, %49 : i32
    %52 = scalar.constant 9 : i32
    %53 = scalar.cmpi ult, %48, %52 : i32
    %98 = scf.select %50, %53, %50 : i1
    %55 = scalar.constant 2 : i32
    %wanted = scf.select %98, %55, %zero$i32 : i32
    %57 = scalar.extui %48 : i32 to i64
    %58 = scalar.assume %57 [range(%57, 0, 9)] : i64
    %59 = index.cast %58 : i64 to index
    %60 = view.load %storage_view[%59] : view<10xi32> -> i32
    %61 = scalar.cmpi ne, %60, %wanted : i32
    %62 = scalar.extui %61 : i1 to i32
    %evaluation_failures$63 = scalar.addi %evaluation_failures$46, %62 : i32
    scf.yield %evaluation_failures$63 : i32
  }
  %68 = view.load %storage_view[%11] : view<10xi32> -> i32
  %73 = view.load %storage_view[%13] : view<10xi32> -> i32
  %78 = view.load %storage_view[%15] : view<10xi32> -> i32
  %83 = view.load %storage_view[%17] : view<10xi32> -> i32
  func.return %failures, %68, %73, %78, %83, %evaluation_failures : i32, i32, i32, i32, i32, i32
}

func.decl @builtin_compare_values(%84: buffer, %85: offset, %86: buffer, %87: offset) -> (i32)

