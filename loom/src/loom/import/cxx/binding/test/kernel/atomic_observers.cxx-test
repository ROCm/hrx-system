// RUN: pass canonicalize,cse,dce
// INPUT: cxx root=observe_i32
// Guarded local storage is observed after the call and returned in source field order.
template <class T>
struct SequenceObservation {
  // Bitmask of independently verified atomic return values.
  unsigned passed;
  // Guard immediately before the updated word.
  T before;
  // Final value of the updated word.
  T value;
  // Guard immediately after the updated word.
  T after;
};

unsigned atomic_i32(int* storage);
static SequenceObservation<int> observe_i32() {
  int storage[3] = {37, 37, 37};
  unsigned passed = atomic_i32(storage);
  return {passed, storage[0], storage[1], storage[2]};
}
// ----
func.def public @observe_i32() -> (i32, i32, i32, i32) {
  %4 = index.constant 12 : offset
  %storage_storage = buffer.alloca<private> align(4) %4 : buffer
  %storage_storage_byte_offset = index.constant 0 : offset
  %storage_view = buffer.view %storage_storage[%storage_storage_byte_offset] : buffer -> view<3xi32>
  %8 = scalar.constant 37 : i32
  %9 = index.constant 0 : index
  view.store %8, %storage_view[%9] : i32, view<3xi32>
  %11 = index.constant 1 : index
  view.store %8, %storage_view[%11] : i32, view<3xi32>
  %13 = index.constant 2 : index
  view.store %8, %storage_view[%13] : i32, view<3xi32>
  %passed = func.call @atomic_i32(%storage_storage, %storage_storage_byte_offset) : (buffer, offset) -> (i32)
  %19 = view.load %storage_view[%9] : view<3xi32> -> i32
  %24 = view.load %storage_view[%11] : view<3xi32> -> i32
  %29 = view.load %storage_view[%13] : view<3xi32> -> i32
  func.return %passed, %19, %24, %29 : i32, i32, i32, i32
}

func.decl @atomic_i32(%30: buffer, %31: offset) -> (i32)

