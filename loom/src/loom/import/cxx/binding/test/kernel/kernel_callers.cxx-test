// RUN: pass canonicalize,cse,dce
// HIP kernel admission preserves the enum argument and pointee width.
#include <hip/hip_runtime.h>
enum class Short : unsigned short { zero, high = 65535 };
template <class T>
static T add(T value, T delta) {
  return static_cast<T>(static_cast<unsigned long long>(value) +
                        static_cast<unsigned long long>(delta));
}
__global__ [[loom::workgroup_size(64, 1, 1), loom::workgroup_count(1, 1, 1)]]
void enum_storage_u16(const Short* input, Short* output, Short delta) {
  Short* cursor = output + threadIdx.x + 1;
  cursor[-1] = add(input[threadIdx.x], delta);
}

// ----
kernel.def @enum_storage_u16() {
  %3 = index.constant 1 : index
  %6 = index.constant 64 : index
  kernel.launch.config workgroups(%3, %3, %3) workgroup_size(%6, %3, %3) : index
} launch(%input: buffer, %output: buffer, %delta: i16) {
  %workitem_id_x = kernel.workitem.id<x> : index
  %12 = index.cast %workitem_id_x : index to i32
  %13 = scalar.extui %12 : i32 to i64
  %14 = index.cast %13 : i64 to index
  %15 = index.constant 2 : index
  %cursor_byte_offset = index.madd %14, %15, %15 : index
  %28 = index.mul %14, %15 : index
  %30 = buffer.view %input[%28] : buffer -> view<1xi16>
  %31 = view.load<root_in_bounds|type_disjoint> %30[0] : view<1xi16> -> i16
  %32 = func.call pure @add___Short(%31, %delta) : (i16, i16) -> (i16)
  %49 = index.constant -2 : index
  %50 = index.add %cursor_byte_offset, %49 : index
  %40 = buffer.view %output[%50] : buffer -> view<1xi16>
  view.store<root_in_bounds|type_disjoint> %32, %40[0] : i16, view<1xi16>
  kernel.return
}

func.def @add___Short(%value: i16, %delta: i16) -> (i16) {
  %44 = scalar.extui %value : i16 to i64
  %45 = scalar.extui %delta : i16 to i64
  %46 = scalar.addi %44, %45 : i64
  %47 = scalar.trunci %46 : i64 to i16
  func.return %47 : i16
}

