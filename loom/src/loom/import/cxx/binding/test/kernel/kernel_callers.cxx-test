} launch(%output: buffer, %input: i32) {
  %workitem_id_x = kernel.workitem.id<x> : index
  %lane = index.cast %workitem_id_x : index to i32
  %value = scalar.addi %input, %lane : i32
  %12 = scalar.constant 12 : i32
