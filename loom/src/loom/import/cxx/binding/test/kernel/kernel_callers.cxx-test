// ====
// RUN: pass canonicalize,cse,dce
// Two retained aggregate calls compose with the actual kernel entry ABI.
#include <loomcxx/kernel.h>

struct Pair {
  // Additive observation of the loaded value.
  unsigned sum;
  // Bitwise observation of the same loaded value.
  unsigned mixed;
};

[[loom::noinline]]
static Pair update(const unsigned* input, unsigned index, unsigned bias) {
  const unsigned value = input[index];
  return {value + bias, value ^ bias};
}

[[loom::kernel, loom::workgroup_count(1, 1, 1), loom::workgroup_size(64, 1, 1)]]
void retained_calls(const unsigned* input, unsigned* sums, unsigned* mixed) {
  const unsigned index = loom::kernel::workitem::id.x;
  const Pair first = update(input, index, 7u);
  const Pair second = update(input, index, 13u);
  sums[index] = first.sum + second.sum;
  mixed[index] = first.mixed + second.mixed;
}

// ----
kernel.def @retained_calls() {
  %3 = index.constant 1 : index
  %6 = index.constant 64 : index
  kernel.launch.config workgroups(%3, %3, %3) workgroup_size(%6, %3, %3) : index
} launch(%input: buffer, %sums: buffer, %mixed: buffer) {
  %input_byte_offset = index.constant 0 : offset
  %workitem_id_x = kernel.workitem.id<x> : index
  %index = index.cast %workitem_id_x : index to i32
  %14 = scalar.constant 7 : i32
  %first_sum, %first_mixed = func.call readonly @update(%input, %input_byte_offset, %index, %14) : (buffer, offset, i32, i32) -> (i32, i32)
  %17 = scalar.constant 13 : i32
  %second_sum, %second_mixed = func.call readonly @update(%input, %input_byte_offset, %index, %17) : (buffer, offset, i32, i32) -> (i32, i32)
  %20 = scalar.addi %first_sum, %second_sum : i32
  %21 = scalar.extui %index : i32 to i64
  %57 = scalar.constant 2 : i64
  %58 = scalar.shli %21, %57 : i64
  %26 = scalar.assume %58 [range(%58, 0, 9223372036854775807)] : i64
  %27 = index.cast %26 : i64 to offset
  %28 = buffer.view %sums[%27] : buffer -> view<1xi32>
  view.store<root_in_bounds> %20, %28[0] : i32, view<1xi32>
  %29 = scalar.addi %first_mixed, %second_mixed : i32
  %37 = buffer.view %mixed[%27] : buffer -> view<1xi32>
  view.store<root_in_bounds> %29, %37[0] : i32, view<1xi32>
  kernel.return
}

func.def noinline @update(%input: buffer, %input_byte_offset: offset, %index: i32, %bias: i32) -> (i32, i32) {
  %44 = scalar.extui %index : i32 to i64
  %59 = scalar.constant 2 : i64
  %60 = scalar.shli %44, %59 : i64
  %47 = index.cast %input_byte_offset : offset to i64
  %48 = scalar.addi %47, %60 : i64
  %49 = scalar.assume %48 [range(%48, 0, 9223372036854775807)] : i64
  %50 = index.cast %49 : i64 to offset
  %51 = buffer.view %input[%50] : buffer -> view<1xi32>
  %value = view.load<root_in_bounds> %51[0] : view<1xi32> -> i32
  %53 = scalar.addi %value, %bias : i32
  %54 = scalar.xori %value, %bias : i32
  func.return %53, %54 : i32, i32
}

// ====
// RUN: pass canonicalize,cse,dce
// HIP kernel admission preserves the enum argument and pointee width.
#include <hip/hip_runtime.h>
enum class Byte : unsigned char { zero, high = 255 };
template <class T>
static T add(T value, T delta) {
  return static_cast<T>(static_cast<unsigned long long>(value) +
                        static_cast<unsigned long long>(delta));
}
__global__ [[loom::workgroup_size(64, 1, 1), loom::workgroup_count(1, 1, 1)]]
void enum_storage_u8(const Byte* input, Byte* output, Byte delta) {
  Byte* cursor = output + threadIdx.x + 1;
  cursor[-1] = add(input[threadIdx.x], delta);
}

