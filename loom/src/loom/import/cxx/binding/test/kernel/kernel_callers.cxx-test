// ====
// RUN: pass canonicalize,cse,dce
// Two retained aggregate calls compose with the actual kernel entry ABI.
#include <loomcxx/kernel.h>

struct Pair {
  // Additive observation of the loaded value.
  unsigned sum;
  // Bitwise observation of the same loaded value.
  unsigned mixed;
};

[[loom::noinline]]
static Pair update(const unsigned* input, unsigned index, unsigned bias) {
  const unsigned value = input[index];
  return {value + bias, value ^ bias};
}

[[loom::kernel, loom::workgroup_count(1, 1, 1), loom::workgroup_size(64, 1, 1)]]
void retained_calls(const unsigned* input, unsigned* sums, unsigned* mixed) {
  const unsigned index = loom::kernel::workitem::id.x;
  const Pair first = update(input, index, 7u);
  const Pair second = update(input, index, 13u);
  sums[index] = first.sum + second.sum;
  mixed[index] = first.mixed + second.mixed;
}

// ----
kernel.def @retained_calls() {
  %3 = index.constant 1 : index
  %6 = index.constant 64 : index
  kernel.launch.config workgroups(%3, %3, %3) workgroup_size(%6, %3, %3) : index
} launch(%input: buffer, %sums: buffer, %mixed: buffer) {
  %input_byte_offset = index.constant 0 : index
  %workitem_id_x = kernel.workitem.id<x> : index
  %index = index.cast %workitem_id_x : index to i32
  %14 = scalar.constant 7 : i32
  %first_sum, %first_mixed = func.call readonly @update(%input, %input_byte_offset, %index, %14) : (buffer, index, i32, i32) -> (i32, i32)
  %17 = scalar.constant 13 : i32
  %second_sum, %second_mixed = func.call readonly @update(%input, %input_byte_offset, %index, %17) : (buffer, index, i32, i32) -> (i32, i32)
  %20 = scalar.addi %first_sum, %second_sum : i32
  %21 = scalar.extui %index : i32 to i64
  %22 = index.cast %21 : i64 to index
  %23 = index.constant 4 : index
  %24 = index.mul %22, %23 : index
  %26 = buffer.view %sums[%24] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %20, %26[0] : i32, view<1xi32>
  %27 = scalar.addi %first_mixed, %second_mixed : i32
  %33 = buffer.view %mixed[%24] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %27, %33[0] : i32, view<1xi32>
  kernel.return
}

func.def noinline @update(%input: buffer, %input_byte_offset: index, %index: i32, %bias: i32) -> (i32, i32) {
  %40 = scalar.extui %index : i32 to i64
  %41 = index.cast %40 : i64 to index
  %42 = index.constant 4 : index
  %49 = index.madd %41, %42, %input_byte_offset : index
  %45 = buffer.view %input[%49] : buffer -> view<1xi32>
  %value = view.load<root_in_bounds|type_disjoint> %45[0] : view<1xi32> -> i32
  %47 = scalar.addi %value, %bias : i32
  %48 = scalar.xori %value, %bias : i32
  func.return %47, %48 : i32, i32
}

// ====
// RUN: pass canonicalize,cse,dce
// HIP kernel admission preserves the enum argument and pointee width.
#include <hip/hip_runtime.h>
enum class Byte : unsigned char { zero, high = 255 };
template <class T>
static T add(T value, T delta) {
  return static_cast<T>(static_cast<unsigned long long>(value) +
                        static_cast<unsigned long long>(delta));
}
__global__ [[loom::workgroup_size(64, 1, 1), loom::workgroup_count(1, 1, 1)]]
void enum_storage_u8(const Byte* input, Byte* output, Byte delta) {
  Byte* cursor = output + threadIdx.x + 1;
  cursor[-1] = add(input[threadIdx.x], delta);
}

// ----
kernel.def @enum_storage_u8() {
  %3 = index.constant 1 : index
  %6 = index.constant 64 : index
  kernel.launch.config workgroups(%3, %3, %3) workgroup_size(%6, %3, %3) : index
} launch(%input: buffer, %output: buffer, %delta: i8) {
  %workitem_id_x = kernel.workitem.id<x> : index
  %12 = index.cast %workitem_id_x : index to i32
  %13 = scalar.extui %12 : i32 to i64
  %14 = index.cast %13 : i64 to index
  %49 = index.constant 1 : index
  %cursor_byte_offset = index.add %14, %49 : index
  %30 = buffer.view %input[%14] : buffer -> view<1xi8>
  %31 = view.load<root_in_bounds|type_disjoint> %30[0] : view<1xi8> -> i8
  %32 = func.call pure @add___Byte(%31, %delta) : (i8, i8) -> (i8)
  %48 = index.constant -1 : index
  %39 = index.add %cursor_byte_offset, %48 : index
  %40 = buffer.view %output[%39] : buffer -> view<1xi8>
  view.store<root_in_bounds|type_disjoint> %32, %40[0] : i8, view<1xi8>
  kernel.return
}

func.def @add___Byte(%value: i8, %delta: i8) -> (i8) {
  %44 = scalar.extui %value : i8 to i64
  %45 = scalar.extui %delta : i8 to i64
  %46 = scalar.addi %44, %45 : i64
  %47 = scalar.trunci %46 : i64 to i8
  func.return %47 : i8
}

