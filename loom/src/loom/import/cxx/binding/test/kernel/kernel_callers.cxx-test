  %25 = scalar.addi %24, %59 : i64
  %26 = scalar.assume %25 [range(%25, 0, 9223372036854775807)] : i64
  %cursor_byte_offset = index.cast %26 : i64 to offset
  %37 = buffer.view %input[%19] : buffer -> view<1xi8>
  %38 = view.load<root_in_bounds> %37[0] : view<1xi8> -> i8
  %39 = func.call pure @add___Byte(%38, %delta) : (i8, i8) -> (i8)
  %58 = scalar.constant -1 : i64
  %46 = index.cast %cursor_byte_offset : offset to i64
  %47 = scalar.addi %46, %58 : i64
  %48 = scalar.assume %47 [range(%47, 0, 9223372036854775807)] : i64
  %49 = index.cast %48 : i64 to offset
  %50 = buffer.view %output[%49] : buffer -> view<1xi8>
  view.store<root_in_bounds> %39, %50[0] : i8, view<1xi8>
  kernel.return
}

func.def @add___Byte(%value: i8, %delta: i8) -> (i8) {
  %54 = scalar.extui %value : i8 to i64
  %55 = scalar.extui %delta : i8 to i64
  %56 = scalar.addi %54, %55 : i64
  %57 = scalar.trunci %56 : i64 to i8
  func.return %57 : i8
}

