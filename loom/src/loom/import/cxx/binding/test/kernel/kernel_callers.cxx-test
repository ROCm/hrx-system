// RUN: pass canonicalize,cse,dce
// Per-lane calls retain their source widths, argument order, and output slots.
#include <hip/hip_runtime.h>
[[loom::inline]] unsigned bound_pair(unsigned first, unsigned second);
[[loom::inline]] unsigned bound_seven(unsigned a, unsigned b, unsigned c,
                                      unsigned d, unsigned e, unsigned f,
                                      unsigned g);
[[loom::inline]] unsigned bound_repeated(unsigned value);
[[loom::inline]] unsigned bound_capacity(unsigned value);
[[loom::inline]] unsigned bound_cast(unsigned value);
[[loom::inline]] unsigned bound_byte(unsigned char value);
[[loom::inline]] unsigned bound_wide(unsigned long long value);
[[loom::inline]] unsigned bound_size(unsigned value);
[[loom::inline]] unsigned bound_scoped(unsigned value);
[[loom::inline]] unsigned bound_inclusive(unsigned tokens);
[[loom::inline]] int bound_signed(int hidden, int capacity);
[[loom::inline]] unsigned bound_unsigned(unsigned tokens, unsigned capacity);

[[loom::kernel, loom::workgroup_size(64, 1, 1), loom::workgroup_count(1, 1, 1)]]
void assumption_kernel(unsigned* output, unsigned input) {
  unsigned lane = threadIdx.x;
  unsigned value = input + lane;
  unsigned output_offset = lane * 12u;
  output[output_offset] = bound_pair(value & 255u, (value >> 8u) & 255u);
  output[output_offset + 1u] =
      bound_seven(value & 255u, 1u, 2u, 3u, 5u, 7u, 11u);
  output[output_offset + 2u] = bound_repeated(value & 31u);
  output[output_offset + 3u] = bound_capacity(value % 428u);
  output[output_offset + 4u] = bound_cast(value & 15u);
  output[output_offset + 5u] = bound_byte((unsigned char)value);
  output[output_offset + 6u] = bound_wide(value & 255u);
  output[output_offset + 7u] = bound_size(value & 15u);
  output[output_offset + 8u] = bound_scoped(value);
  output[output_offset + 9u] = bound_inclusive(value % 428u);
  int hidden = (int)(value % 63u) + 1;
  int capacity = hidden + (int)(value % 5u);
  output[output_offset + 10u] = (unsigned)bound_signed(hidden, capacity);
  unsigned tokens = value & 0x7fffffffu;
  unsigned token_capacity = tokens | 0x80000000u;
  output[output_offset + 11u] = bound_unsigned(tokens, token_capacity);
}

// ----
kernel.def @assumption_kernel() {
  %2 = index.constant 1 : index
  %5 = index.constant 64 : index
  kernel.launch.config workgroups(%2, %2, %2) workgroup_size(%5, %2, %2) : index
} launch(%output: buffer, %input: i32) {
  %workitem_id_x = kernel.workitem.id<x> : index
  %lane = index.cast %workitem_id_x : index to i32
  %value = scalar.addi %input, %lane : i32
  %12 = scalar.constant 12 : i32
  %output_offset = scalar.muli %lane, %12 : i32
  %14 = scalar.constant 255 : i32
  %15 = scalar.andi %value, %14 : i32
  %16 = scalar.constant 8 : i32
  %17 = scalar.shrui %value, %16 : i32
  %19 = scalar.andi %17, %14 : i32
  %20 = func.call @bound_pair(%15, %19) : (i32, i32) -> (i32)
  %21 = scalar.extui %output_offset : i32 to i64
  %22 = index.cast %21 : i64 to index
  %23 = index.constant 4 : index
  %24 = index.mul %22, %23 : index
  %26 = buffer.view %output[%24] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %20, %26[0] : i32, view<1xi32>
  %29 = scalar.constant 1 : i32
  %30 = scalar.constant 2 : i32
  %31 = scalar.constant 3 : i32
  %32 = scalar.constant 5 : i32
  %33 = scalar.constant 7 : i32
  %34 = scalar.constant 11 : i32
  %35 = func.call @bound_seven(%15, %29, %30, %31, %32, %33, %34) : (i32, i32, i32, i32, i32, i32, i32) -> (i32)
  %37 = scalar.addi %output_offset, %29 : i32
  %38 = scalar.extui %37 : i32 to i64
  %39 = index.cast %38 : i64 to index
  %41 = index.mul %39, %23 : index
  %43 = buffer.view %output[%41] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %35, %43[0] : i32, view<1xi32>
  %44 = scalar.constant 31 : i32
  %45 = scalar.andi %value, %44 : i32
  %46 = func.call @bound_repeated(%45) : (i32) -> (i32)
  %48 = scalar.addi %output_offset, %30 : i32
  %49 = scalar.extui %48 : i32 to i64
  %50 = index.cast %49 : i64 to index
  %52 = index.mul %50, %23 : index
  %54 = buffer.view %output[%52] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %46, %54[0] : i32, view<1xi32>
  %55 = scalar.constant 428 : i32
  %56 = scalar.remui %value, %55 : i32
  %57 = func.call @bound_capacity(%56) : (i32) -> (i32)
  %59 = scalar.addi %output_offset, %31 : i32
  %60 = scalar.extui %59 : i32 to i64
  %61 = index.cast %60 : i64 to index
  %63 = index.mul %61, %23 : index
  %65 = buffer.view %output[%63] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %57, %65[0] : i32, view<1xi32>
  %66 = scalar.constant 15 : i32
  %67 = scalar.andi %value, %66 : i32
  %68 = func.call @bound_cast(%67) : (i32) -> (i32)
  %69 = scalar.constant 4 : i32
  %70 = scalar.addi %output_offset, %69 : i32
  %71 = scalar.extui %70 : i32 to i64
  %72 = index.cast %71 : i64 to index
  %74 = index.mul %72, %23 : index
  %76 = buffer.view %output[%74] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %68, %76[0] : i32, view<1xi32>
  %77 = scalar.trunci %value : i32 to i8
  %78 = func.call @bound_byte(%77) : (i8) -> (i32)
  %80 = scalar.addi %output_offset, %32 : i32
  %81 = scalar.extui %80 : i32 to i64
  %82 = index.cast %81 : i64 to index
  %84 = index.mul %82, %23 : index
  %86 = buffer.view %output[%84] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %78, %86[0] : i32, view<1xi32>
  %89 = scalar.extui %15 : i32 to i64
  %90 = func.call @bound_wide(%89) : (i64) -> (i32)
  %91 = scalar.constant 6 : i32
  %92 = scalar.addi %output_offset, %91 : i32
  %93 = scalar.extui %92 : i32 to i64
  %94 = index.cast %93 : i64 to index
  %96 = index.mul %94, %23 : index
  %98 = buffer.view %output[%96] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %90, %98[0] : i32, view<1xi32>
  %101 = func.call @bound_size(%67) : (i32) -> (i32)
  %103 = scalar.addi %output_offset, %33 : i32
  %104 = scalar.extui %103 : i32 to i64
  %105 = index.cast %104 : i64 to index
  %107 = index.mul %105, %23 : index
  %109 = buffer.view %output[%107] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %101, %109[0] : i32, view<1xi32>
  %110 = func.call @bound_scoped(%value) : (i32) -> (i32)
  %112 = scalar.addi %output_offset, %16 : i32
  %113 = scalar.extui %112 : i32 to i64
  %114 = index.cast %113 : i64 to index
  %116 = index.mul %114, %23 : index
  %118 = buffer.view %output[%116] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %110, %118[0] : i32, view<1xi32>
  %121 = func.call @bound_inclusive(%56) : (i32) -> (i32)
  %122 = scalar.constant 9 : i32
  %123 = scalar.addi %output_offset, %122 : i32
  %124 = scalar.extui %123 : i32 to i64
  %125 = index.cast %124 : i64 to index
  %127 = index.mul %125, %23 : index
  %129 = buffer.view %output[%127] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %121, %129[0] : i32, view<1xi32>
  %130 = scalar.constant 63 : i32
  %131 = scalar.remui %value, %130 : i32
  %hidden = scalar.addi %131, %29 : i32
  %135 = scalar.remui %value, %32 : i32
  %capacity = scalar.addi %hidden, %135 : i32
  %137 = func.call @bound_signed(%hidden, %capacity) : (i32, i32) -> (i32)
  %138 = scalar.constant 10 : i32
  %139 = scalar.addi %output_offset, %138 : i32
  %140 = scalar.extui %139 : i32 to i64
  %141 = index.cast %140 : i64 to index
  %143 = index.mul %141, %23 : index
  %145 = buffer.view %output[%143] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %137, %145[0] : i32, view<1xi32>
  %146 = scalar.constant 2147483647 : i32
  %tokens = scalar.andi %value, %146 : i32
  %148 = scalar.constant -2147483648 : i32
  %token_capacity = scalar.ori %tokens, %148 : i32
  %150 = func.call @bound_unsigned(%tokens, %token_capacity) : (i32, i32) -> (i32)
  %152 = scalar.addi %output_offset, %34 : i32
  %153 = scalar.extui %152 : i32 to i64
  %154 = index.cast %153 : i64 to index
  %156 = index.mul %154, %23 : index
  %158 = buffer.view %output[%156] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %150, %158[0] : i32, view<1xi32>
  kernel.return
}

