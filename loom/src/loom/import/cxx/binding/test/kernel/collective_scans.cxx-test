// RUN: pass canonicalize,cse,dce
// All four prefix modes and the reduction consume the same loaded element
// and retain five distinct destinations within each 80-lane workgroup.
#include <loomcxx/kernel.h>
using loom::kernel::scan_direction;
using loom::kernel::scan_mode;
[[loom::kernel, loom::workgroup_count(3, 1, 1), loom::workgroup_size(80, 1, 1)]]
void scan_u32(const unsigned* input, unsigned* output) {
  unsigned item =
      loom::kernel::workgroup::id.x * 80u + loom::kernel::workitem::id.x;
  unsigned value = input[item + 1];
  output[item * 5 + 1] = loom::kernel::workgroup::scan::addi(value);
  output[item * 5 + 2] =
      loom::kernel::workgroup::scan::addi<scan_mode::exclusive>(value);
  output[item * 5 + 3] =
      loom::kernel::workgroup::scan::addi<scan_mode::inclusive,
                                          scan_direction::reverse>(value);
  output[item * 5 + 4] =
      loom::kernel::workgroup::scan::addi<scan_mode::exclusive,
                                          scan_direction::reverse>(value);
  output[item * 5 + 5] = loom::kernel::workgroup::reduce::addi(value);
}
// ----
kernel.def @scan_u32() {
  %2 = index.constant 3 : index
  %3 = index.constant 1 : index
  %5 = index.constant 80 : index
  kernel.launch.config workgroups(%2, %3, %3) workgroup_size(%5, %3, %3) : index
} launch(%input: buffer, %output: buffer) {
  %workgroup_id_x = kernel.workgroup.id<x> : index
  %11 = index.cast %workgroup_id_x : index to i32
  %12 = scalar.constant 80 : i32
  %13 = scalar.muli %11, %12 : i32
  %workitem_id_x = kernel.workitem.id<x> : index
  %15 = index.cast %workitem_id_x : index to i32
  %item = scalar.addi %13, %15 : i32
  %17 = scalar.constant 1 : i32
  %18 = scalar.addi %item, %17 : i32
  %19 = scalar.extui %18 : i32 to i64
  %103 = scalar.constant 2 : i64
  %104 = scalar.shli %19, %103 : i64
  %24 = scalar.assume %104 [range(%104, 0, 9223372036854775807)] : i64
  %25 = index.cast %24 : i64 to offset
  %26 = buffer.view %input[%25] : buffer -> view<1xi32>
  %value = view.load %26[0] : view<1xi32> -> i32
  %28 = kernel.workgroup.scan<addi> %value {direction = forward, mode = inclusive} : i32
  %29 = scalar.constant 5 : i32
  %30 = scalar.muli %item, %29 : i32
  %32 = scalar.addi %30, %17 : i32
  %33 = scalar.extui %32 : i32 to i64
  %102 = scalar.shli %33, %103 : i64
  %38 = scalar.assume %102 [range(%102, 0, 9223372036854775807)] : i64
  %39 = index.cast %38 : i64 to offset
  %40 = buffer.view %output[%39] : buffer -> view<1xi32>
  view.store %28, %40[0] : i32, view<1xi32>
  %41 = kernel.workgroup.scan<addi> %value {direction = forward, mode = exclusive} : i32
  %44 = scalar.constant 2 : i32
  %45 = scalar.addi %30, %44 : i32
  %46 = scalar.extui %45 : i32 to i64
  %100 = scalar.shli %46, %103 : i64
  %51 = scalar.assume %100 [range(%100, 0, 9223372036854775807)] : i64
  %52 = index.cast %51 : i64 to offset
  %53 = buffer.view %output[%52] : buffer -> view<1xi32>
  view.store %41, %53[0] : i32, view<1xi32>
  %54 = kernel.workgroup.scan<addi> %value {direction = reverse, mode = inclusive} : i32
  %57 = scalar.constant 3 : i32
  %58 = scalar.addi %30, %57 : i32
  %59 = scalar.extui %58 : i32 to i64
  %98 = scalar.shli %59, %103 : i64
  %64 = scalar.assume %98 [range(%98, 0, 9223372036854775807)] : i64
  %65 = index.cast %64 : i64 to offset
  %66 = buffer.view %output[%65] : buffer -> view<1xi32>
  view.store %54, %66[0] : i32, view<1xi32>
  %67 = kernel.workgroup.scan<addi> %value {direction = reverse, mode = exclusive} : i32
  %70 = scalar.constant 4 : i32
  %71 = scalar.addi %30, %70 : i32
  %72 = scalar.extui %71 : i32 to i64
  %96 = scalar.shli %72, %103 : i64
  %77 = scalar.assume %96 [range(%96, 0, 9223372036854775807)] : i64
  %78 = index.cast %77 : i64 to offset
  %79 = buffer.view %output[%78] : buffer -> view<1xi32>
  view.store %67, %79[0] : i32, view<1xi32>
  %80 = kernel.workgroup.reduce<addi> %value : i32
  %84 = scalar.addi %30, %29 : i32
  %85 = scalar.extui %84 : i32 to i64
  %94 = scalar.shli %85, %103 : i64
  %90 = scalar.assume %94 [range(%94, 0, 9223372036854775807)] : i64
  %91 = index.cast %90 : i64 to offset
  %92 = buffer.view %output[%91] : buffer -> view<1xi32>
  view.store %80, %92[0] : i32, view<1xi32>
  kernel.return
}

