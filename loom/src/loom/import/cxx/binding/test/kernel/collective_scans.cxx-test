// RUN: pass canonicalize,cse,dce
// All four prefix modes and the reduction consume the same loaded element
// and retain five distinct destinations within each 80-lane workgroup.
#include <loomcxx/kernel.h>
using loom::kernel::scan_direction;
using loom::kernel::scan_mode;
[[loom::kernel, loom::workgroup_count(3, 1, 1), loom::workgroup_size(80, 1, 1)]]
void scan_u32(const unsigned* input, unsigned* output) {
  unsigned item =
      loom::kernel::workgroup::id.x * 80u + loom::kernel::workitem::id.x;
  unsigned value = input[item + 1];
  output[item * 5 + 1] = loom::kernel::workgroup::scan::addi(value);
  output[item * 5 + 2] =
      loom::kernel::workgroup::scan::addi<scan_mode::exclusive>(value);
  output[item * 5 + 3] =
      loom::kernel::workgroup::scan::addi<scan_mode::inclusive,
                                          scan_direction::reverse>(value);
  output[item * 5 + 4] =
      loom::kernel::workgroup::scan::addi<scan_mode::exclusive,
                                          scan_direction::reverse>(value);
  output[item * 5 + 5] = loom::kernel::workgroup::reduce::addi(value);
}
// ----
kernel.def @scan_u32() {
  %2 = index.constant 3 : index
  %3 = index.constant 1 : index
  %5 = index.constant 80 : index
  kernel.launch.config workgroups(%2, %3, %3) workgroup_size(%5, %3, %3) : index
} launch(%input: buffer, %output: buffer) {
  %workgroup_id_x = kernel.workgroup.id<x> : index
  %11 = index.cast %workgroup_id_x : index to i32
  %12 = scalar.constant 80 : i32
  %13 = scalar.muli %11, %12 : i32
  %workitem_id_x = kernel.workitem.id<x> : index
  %15 = index.cast %workitem_id_x : index to i32
  %item = scalar.addi %13, %15 : i32
  %17 = scalar.constant 1 : i32
  %18 = scalar.addi %item, %17 : i32
  %19 = scalar.extui %18 : i32 to i64
  %20 = index.cast %19 : i64 to index
  %21 = index.constant 4 : index
  %22 = index.mul %20, %21 : index
  %24 = buffer.view %input[%22] : buffer -> view<1xi32>
  %value = view.load<root_in_bounds|type_disjoint> %24[0] : view<1xi32> -> i32
  %26 = kernel.workgroup.scan<addi> %value {direction = forward, mode = inclusive} : i32
  %27 = scalar.constant 5 : i32
  %28 = scalar.muli %item, %27 : i32
  %30 = scalar.addi %28, %17 : i32
  %31 = scalar.extui %30 : i32 to i64
  %32 = index.cast %31 : i64 to index
  %34 = index.mul %32, %21 : index
  %36 = buffer.view %output[%34] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %26, %36[0] : i32, view<1xi32>
  %37 = kernel.workgroup.scan<addi> %value {direction = forward, mode = exclusive} : i32
  %40 = scalar.constant 2 : i32
  %41 = scalar.addi %28, %40 : i32
  %42 = scalar.extui %41 : i32 to i64
  %43 = index.cast %42 : i64 to index
  %45 = index.mul %43, %21 : index
  %47 = buffer.view %output[%45] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %37, %47[0] : i32, view<1xi32>
  %48 = kernel.workgroup.scan<addi> %value {direction = reverse, mode = inclusive} : i32
  %51 = scalar.constant 3 : i32
  %52 = scalar.addi %28, %51 : i32
  %53 = scalar.extui %52 : i32 to i64
  %54 = index.cast %53 : i64 to index
  %56 = index.mul %54, %21 : index
  %58 = buffer.view %output[%56] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %48, %58[0] : i32, view<1xi32>
  %59 = kernel.workgroup.scan<addi> %value {direction = reverse, mode = exclusive} : i32
  %62 = scalar.constant 4 : i32
  %63 = scalar.addi %28, %62 : i32
  %64 = scalar.extui %63 : i32 to i64
  %65 = index.cast %64 : i64 to index
  %67 = index.mul %65, %21 : index
  %69 = buffer.view %output[%67] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %59, %69[0] : i32, view<1xi32>
  %70 = kernel.workgroup.reduce<addi> %value : i32
  %74 = scalar.addi %28, %27 : i32
  %75 = scalar.extui %74 : i32 to i64
  %76 = index.cast %75 : i64 to index
  %78 = index.mul %76, %21 : index
  %80 = buffer.view %output[%78] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %70, %80[0] : i32, view<1xi32>
  kernel.return
}

// ====
// RUN: pass canonicalize,cse,dce
// All four prefix modes and the reduction consume the same loaded element
// and retain five distinct destinations within each 80-lane workgroup.
#include <loomcxx/kernel.h>
using loom::kernel::scan_direction;
using loom::kernel::scan_mode;
[[loom::kernel, loom::workgroup_count(3, 1, 1), loom::workgroup_size(80, 1, 1)]]
void scan_u64(const unsigned long long* input, unsigned long long* output) {
  unsigned item =
      loom::kernel::workgroup::id.x * 80u + loom::kernel::workitem::id.x;
  unsigned long long value = input[item + 1];
  output[item * 5 + 1] = loom::kernel::workgroup::scan::addi(value);
  output[item * 5 + 2] =
      loom::kernel::workgroup::scan::addi<scan_mode::exclusive>(value);
  output[item * 5 + 3] =
      loom::kernel::workgroup::scan::addi<scan_mode::inclusive,
                                          scan_direction::reverse>(value);
  output[item * 5 + 4] =
      loom::kernel::workgroup::scan::addi<scan_mode::exclusive,
                                          scan_direction::reverse>(value);
  output[item * 5 + 5] = loom::kernel::workgroup::reduce::addi(value);
}
// ----
kernel.def @scan_u64() {
  %2 = index.constant 3 : index
  %3 = index.constant 1 : index
  %5 = index.constant 80 : index
  kernel.launch.config workgroups(%2, %3, %3) workgroup_size(%5, %3, %3) : index
} launch(%input: buffer, %output: buffer) {
  %workgroup_id_x = kernel.workgroup.id<x> : index
  %11 = index.cast %workgroup_id_x : index to i32
  %12 = scalar.constant 80 : i32
  %13 = scalar.muli %11, %12 : i32
  %workitem_id_x = kernel.workitem.id<x> : index
  %15 = index.cast %workitem_id_x : index to i32
  %item = scalar.addi %13, %15 : i32
  %17 = scalar.constant 1 : i32
  %18 = scalar.addi %item, %17 : i32
  %19 = scalar.extui %18 : i32 to i64
  %20 = index.cast %19 : i64 to index
  %21 = index.constant 8 : index
  %22 = index.mul %20, %21 : index
  %24 = buffer.view %input[%22] : buffer -> view<1xi64>
  %value = view.load<root_in_bounds|type_disjoint> %24[0] : view<1xi64> -> i64
  %26 = kernel.workgroup.scan<addi> %value {direction = forward, mode = inclusive} : i64
  %27 = scalar.constant 5 : i32
  %28 = scalar.muli %item, %27 : i32
  %30 = scalar.addi %28, %17 : i32
  %31 = scalar.extui %30 : i32 to i64
  %32 = index.cast %31 : i64 to index
  %34 = index.mul %32, %21 : index
  %36 = buffer.view %output[%34] : buffer -> view<1xi64>
  view.store<root_in_bounds|type_disjoint> %26, %36[0] : i64, view<1xi64>
  %37 = kernel.workgroup.scan<addi> %value {direction = forward, mode = exclusive} : i64
  %40 = scalar.constant 2 : i32
  %41 = scalar.addi %28, %40 : i32
  %42 = scalar.extui %41 : i32 to i64
  %43 = index.cast %42 : i64 to index
  %45 = index.mul %43, %21 : index
  %47 = buffer.view %output[%45] : buffer -> view<1xi64>
  view.store<root_in_bounds|type_disjoint> %37, %47[0] : i64, view<1xi64>
  %48 = kernel.workgroup.scan<addi> %value {direction = reverse, mode = inclusive} : i64
  %51 = scalar.constant 3 : i32
  %52 = scalar.addi %28, %51 : i32
  %53 = scalar.extui %52 : i32 to i64
  %54 = index.cast %53 : i64 to index
  %56 = index.mul %54, %21 : index
  %58 = buffer.view %output[%56] : buffer -> view<1xi64>
  view.store<root_in_bounds|type_disjoint> %48, %58[0] : i64, view<1xi64>
  %59 = kernel.workgroup.scan<addi> %value {direction = reverse, mode = exclusive} : i64
  %62 = scalar.constant 4 : i32
  %63 = scalar.addi %28, %62 : i32
  %64 = scalar.extui %63 : i32 to i64
  %65 = index.cast %64 : i64 to index
  %67 = index.mul %65, %21 : index
  %69 = buffer.view %output[%67] : buffer -> view<1xi64>
  view.store<root_in_bounds|type_disjoint> %59, %69[0] : i64, view<1xi64>
  %70 = kernel.workgroup.reduce<addi> %value : i64
  %74 = scalar.addi %28, %27 : i32
  %75 = scalar.extui %74 : i32 to i64
  %76 = index.cast %75 : i64 to index
  %78 = index.mul %76, %21 : index
  %80 = buffer.view %output[%78] : buffer -> view<1xi64>
  view.store<root_in_bounds|type_disjoint> %70, %80[0] : i64, view<1xi64>
  kernel.return
}

// ====
// RUN: pass canonicalize,cse,dce
// All four prefix modes and the reduction consume the same loaded element
// and retain five distinct destinations within each 80-lane workgroup.
#include <loomcxx/kernel.h>
using loom::kernel::scan_direction;
using loom::kernel::scan_mode;
[[loom::kernel, loom::workgroup_count(3, 1, 1), loom::workgroup_size(80, 1, 1)]]
void scan_f32(const float* input, float* output) {
  unsigned item =
      loom::kernel::workgroup::id.x * 80u + loom::kernel::workitem::id.x;
  float value = input[item + 1];
  output[item * 5 + 1] = loom::kernel::workgroup::scan::addf(value);
  output[item * 5 + 2] =
      loom::kernel::workgroup::scan::addf<scan_mode::exclusive>(value);
  output[item * 5 + 3] =
      loom::kernel::workgroup::scan::addf<scan_mode::inclusive,
                                          scan_direction::reverse>(value);
  output[item * 5 + 4] =
      loom::kernel::workgroup::scan::addf<scan_mode::exclusive,
                                          scan_direction::reverse>(value);
  output[item * 5 + 5] = loom::kernel::workgroup::reduce::addf(value);
}
// ----
kernel.def @scan_f32() {
  %2 = index.constant 3 : index
  %3 = index.constant 1 : index
  %5 = index.constant 80 : index
  kernel.launch.config workgroups(%2, %3, %3) workgroup_size(%5, %3, %3) : index
} launch(%input: buffer, %output: buffer) {
  %workgroup_id_x = kernel.workgroup.id<x> : index
  %11 = index.cast %workgroup_id_x : index to i32
  %12 = scalar.constant 80 : i32
  %13 = scalar.muli %11, %12 : i32
  %workitem_id_x = kernel.workitem.id<x> : index
  %15 = index.cast %workitem_id_x : index to i32
  %item = scalar.addi %13, %15 : i32
  %17 = scalar.constant 1 : i32
  %18 = scalar.addi %item, %17 : i32
  %19 = scalar.extui %18 : i32 to i64
  %20 = index.cast %19 : i64 to index
  %21 = index.constant 4 : index
  %22 = index.mul %20, %21 : index
  %24 = buffer.view %input[%22] : buffer -> view<1xf32>
  %value = view.load<root_in_bounds|type_disjoint> %24[0] : view<1xf32> -> f32
  %26 = kernel.workgroup.scan<addf> %value {direction = forward, mode = inclusive} : f32
  %27 = scalar.constant 5 : i32
  %28 = scalar.muli %item, %27 : i32
  %30 = scalar.addi %28, %17 : i32
  %31 = scalar.extui %30 : i32 to i64
  %32 = index.cast %31 : i64 to index
  %34 = index.mul %32, %21 : index
  %36 = buffer.view %output[%34] : buffer -> view<1xf32>
  view.store<root_in_bounds|type_disjoint> %26, %36[0] : f32, view<1xf32>
  %37 = kernel.workgroup.scan<addf> %value {direction = forward, mode = exclusive} : f32
  %40 = scalar.constant 2 : i32
  %41 = scalar.addi %28, %40 : i32
  %42 = scalar.extui %41 : i32 to i64
  %43 = index.cast %42 : i64 to index
  %45 = index.mul %43, %21 : index
  %47 = buffer.view %output[%45] : buffer -> view<1xf32>
  view.store<root_in_bounds|type_disjoint> %37, %47[0] : f32, view<1xf32>
  %48 = kernel.workgroup.scan<addf> %value {direction = reverse, mode = inclusive} : f32
  %51 = scalar.constant 3 : i32
  %52 = scalar.addi %28, %51 : i32
  %53 = scalar.extui %52 : i32 to i64
  %54 = index.cast %53 : i64 to index
  %56 = index.mul %54, %21 : index
  %58 = buffer.view %output[%56] : buffer -> view<1xf32>
  view.store<root_in_bounds|type_disjoint> %48, %58[0] : f32, view<1xf32>
  %59 = kernel.workgroup.scan<addf> %value {direction = reverse, mode = exclusive} : f32
  %62 = scalar.constant 4 : i32
  %63 = scalar.addi %28, %62 : i32
  %64 = scalar.extui %63 : i32 to i64
  %65 = index.cast %64 : i64 to index
  %67 = index.mul %65, %21 : index
  %69 = buffer.view %output[%67] : buffer -> view<1xf32>
  view.store<root_in_bounds|type_disjoint> %59, %69[0] : f32, view<1xf32>
  %70 = kernel.workgroup.reduce<addf> %value : f32
  %74 = scalar.addi %28, %27 : i32
  %75 = scalar.extui %74 : i32 to i64
  %76 = index.cast %75 : i64 to index
  %78 = index.mul %76, %21 : index
  %80 = buffer.view %output[%78] : buffer -> view<1xf32>
  view.store<root_in_bounds|type_disjoint> %70, %80[0] : f32, view<1xf32>
  kernel.return
}
