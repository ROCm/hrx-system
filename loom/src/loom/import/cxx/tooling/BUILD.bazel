load("//build_tools/embed_data:build_defs.bzl", "iree_c_embed_data")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test", "loom_config_compatible_with")
load("//loom/build_tools/bazel:defs.bzl", "loom_test")
load("//loom/target/vm:execution_profiles.bzl", "VM_REFERENCE_PROFILE")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],
)

loom_cc_test(
    name = "input_test",
    srcs = ["input_test.cc"],
    deps = [
        ":input",
        ":loomc_input",
        ":options",
        ":source_capture_test_data",
        "//loom/binding/c:interop",
        "//loom/binding/c:loomc",
        "//loom/src/loom/error:source",
        "//loom/src/loom/format:location",
        "//loom/src/loom/import/cxx",
        "//loom/src/loom/import/cxx/source:options",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/ops:op_registry",
        "//loom/src/loom/ops/func",
        "//loom/src/loom/ops/func:location_capture",
        "//loom/src/loom/target:provider",
        "//loom/src/loom/testing:test_file",
        "//loom/src/loom/tooling/input",
        "//loom/src/loom/tools/loom-check:execute",
        "//loom/src/loom/tools/loom-check:file",
        "//loom/src/loom/tools/loom-check:test_util",
        "//loom/src/loom/util:json",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/io:file_handle",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
        "//runtime/src/iree/testing:temp_file",
    ],
)

iree_c_embed_data(
    name = "source_capture_test_data",
    testonly = True,
    srcs = [
        "//loom/src/loom/import/cxx/tooling/test:source_capture.cxx-test",
        "//loom/src/loom/import/cxx/tooling/test:source_capture.h",
    ],
    c_file_output = "source_capture_test_data.c",
    h_file_output = "source_capture_test_data.h",
    identifier = "loom_cxx_source_capture_test_data",
)

loom_cc_library(
    name = "options",
    srcs = ["options.c"],
    hdrs = ["options.h"],
    deps = [
        "//loom/binding/c:loomc",
        "//loom/binding/c/import/cxx",
        "//loom/src/loom/tooling/input:format",
        "//loom/src/loom/tooling/io:file",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/base/internal:path",
    ],
)

loom_cc_library(
    name = "input",
    srcs = ["input.c"],
    hdrs = ["input.h"],
    deps = [
        ":options",
        "//loom/binding/c:loomc",
        "//loom/src/loom/import/cxx",
        "//loom/src/loom/import/cxx/source:options",
        "//loom/src/loom/tooling/input",
        "//loom/src/loom/tooling/io:file",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/base/internal:path",
    ],
)

loom_cc_library(
    name = "loomc_input",
    srcs = ["loomc_input.c"],
    hdrs = ["loomc_input.h"],
    deps = [
        ":options",
        "//loom/binding/c:loomc",
        "//loom/binding/c/import/cxx",
        "//loom/src/loom/tooling/io:source_path",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
    ],
)

loom_test(
    name = "source_test",
    srcs = ["check_cases.cxx"],
    data = ["check_cases.h"],
    execution_profiles = [VM_REFERENCE_PROFILE],
    inputopts = ["cxx:D=CHECK_EXPECTED=0u"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/import:cxx",
        "//loom/config/target/arch:vm",
    ]),
)
