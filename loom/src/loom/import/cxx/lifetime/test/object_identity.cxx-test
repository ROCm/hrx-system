// ====
// A prvalue argument is constructed by the caller and destroyed by the callee.
// Ordinary scalar reference writeback remains independent of object ownership.
struct Identity {
  unsigned value;
  Identity(unsigned input, unsigned*& observed) : value(input) { observed = &value; }
  ~Identity() { value = 0; }
};
