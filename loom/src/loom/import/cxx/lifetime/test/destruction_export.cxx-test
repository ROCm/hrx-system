// Automatic destruction projects back to ordinary explicit calls. The source
// RAII spelling is presentation that High IR no longer carries; cleanup order,
// receiver values, addressed objects, and structured control remain semantic.
void observe(unsigned);

struct Guard {
  unsigned digit;
  ~Guard() { observe(digit); }
};

struct Pair {
  Guard first;
  Guard second;
  ~Pair() = default;
};

static void consume(const Guard& guard) { observe(guard.digit + 10); }

unsigned cleanup_return(bool choose) {
  Guard outer{1};
  if (choose) {
    Guard inner{2};
    return inner.digit;
  }
  Guard tail{3};
  return tail.digit;
}

void cleanup_aggregates() {
  Guard array[2]{{4}, {5}};
  Pair pair{{6}, {7}};
}

void cleanup_expressions(bool choose) {
  consume(choose ? (Guard{8}, Guard{9}) : Guard{10});
  const Guard& extended = Guard{11};
  observe(extended.digit + 10);
}

