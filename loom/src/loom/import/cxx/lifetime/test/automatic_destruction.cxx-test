void observe(unsigned);

struct Guard {
  unsigned digit;
  ~Guard() { observe(digit); }
};

struct Decision {
  unsigned value;
  operator bool() const {
    observe(value + 100);
    return value != 0;
  }
  ~Decision() { observe(value + 200); }
};

