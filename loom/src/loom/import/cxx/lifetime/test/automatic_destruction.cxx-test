// ====
// Default array members initialize every element once and destroy them in
// reverse order after the constructor body observes their completed values.
void observe(unsigned);
struct Guard {
  // Payload observed during construction and destruction.
  unsigned value;
  Guard(unsigned input) : value(input) { observe(input); }
  ~Guard() { observe(value + 100); }
};
struct Owner {
  // Elements initialized by the member default and owned by this object.
  Guard values[2] = {3, 5};
  Owner() { observe(values[0].value + values[1].value); }
};
void default_array_lifetime() { Owner value; }
