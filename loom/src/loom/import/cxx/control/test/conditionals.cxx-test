// RUN: roundtrip
// A return before a load keeps the load in the fallthrough region.
int guarded(const int* input, unsigned length) {
  if (length == 0u) {
    return 3;
  }
  return input[0u];
}
// ----
func.def public @guarded(%input: buffer, %input_byte_offset: index, %length: i32) -> (i32) {
  %4 = scalar.constant 0 : i32
  %5 = scalar.cmpi eq, %length, %4 : i32
  %6 = scf.if %5 -> (i32) {
    %7 = scalar.constant 3 : i32
    scf.yield %7 : i32
  } else {
    %8 = scalar.constant 0 : i32
    %9 = scalar.extui %8 : i32 to i64
    %10 = index.cast %9 : i64 to index
    %11 = index.constant 4 : index
    %12 = index.mul %10, %11 : index
    %13 = index.add %input_byte_offset, %12 : index
    %14 = buffer.view %input[%13] : buffer -> view<1xi32>
    %15 = view.load<root_in_bounds|type_disjoint> %14[0] : view<1xi32> -> i32
    scf.yield %15 : i32
  }
  func.return %6 : i32
}

// ====
// RUN: roundtrip
// All nested arms return through one function exit.
int nested(int x, int y) {
  if (x) {
    if (y) {
      return 2;
    }
    return 3;
  } else {
    return 4;
  }
}
// ----
func.def public @nested(%x: i32, %y: i32) -> (i32) {
  %3 = scalar.constant 0 : i32
  %4 = scalar.cmpi ne, %x, %3 : i32
  %5 = scf.if %4 -> (i32) {
    %6 = scalar.constant 0 : i32
    %7 = scalar.cmpi ne, %y, %6 : i32
    %8 = scf.if %7 -> (i32) {
      %9 = scalar.constant 2 : i32
      scf.yield %9 : i32
    } else {
      %10 = scalar.constant 3 : i32
      scf.yield %10 : i32
    }
    scf.yield %8 : i32
  } else {
    %11 = scalar.constant 4 : i32
    scf.yield %11 : i32
  }
  func.return %5 : i32
}

// ====
// RUN: roundtrip
// Partially returning branches share the final fallthrough return.
int partial(int x, int y) {
  if (x) {
    if (y) {
      return 2;
    }
  } else {
    return 4;
  }
  return 3;
}
// ----
func.def public @partial(%x: i32, %y: i32) -> (i32) {
  %3 = scalar.constant 0 : i32
  %4 = scalar.cmpi ne, %x, %3 : i32
  %5 = scf.if %4 -> (i32) {
    %6 = scalar.constant 0 : i32
    %7 = scalar.cmpi ne, %y, %6 : i32
    %8 = scf.if %7 -> (i32) {
      %9 = scalar.constant 2 : i32
      scf.yield %9 : i32
    } else {
      %10 = scalar.constant 3 : i32
      scf.yield %10 : i32
    }
    scf.yield %8 : i32
  } else {
    %11 = scalar.constant 4 : i32
    scf.yield %11 : i32
  }
  func.return %5 : i32
}

// ====
// RUN: roundtrip
// Returns capture the current state through nested lexical scopes.
int state(int x, int y) {
  if (x < 0) {
    y += 10;
    return y;
  } else {
    y += 4;
  }
  {
    if (x == 0) {
      return y;
    }
    y += 2;
  }
  return y;
}
// ----
func.def public @state(%x: i32, %y$1: i32) -> (i32) {
  %3 = scalar.constant 0 : i32
  %4 = scalar.cmpi slt, %x, %3 : i32
  %5 = scf.if %4 -> (i32) {
    %6 = scalar.constant 10 : i32
    %y = scalar.addi %y$1, %6 : i32
    scf.yield %y : i32
  } else {
    %8 = scalar.constant 4 : i32
    %y$9 = scalar.addi %y$1, %8 : i32
    %10 = scalar.constant 0 : i32
    %11 = scalar.cmpi eq, %x, %10 : i32
    %12 = scf.if %11 -> (i32) {
      scf.yield %y$9 : i32
    } else {
      %13 = scalar.constant 2 : i32
      %y = scalar.addi %y$9, %13 : i32
      scf.yield %y : i32
    }
    scf.yield %12 : i32
  }
  func.return %5 : i32
}

// ====
// RUN: roundtrip
// Each return converts to the declared result type.
int convert_result(bool choose, float value) {
  if (choose) {
    return value;
  }
  return 7.5;
}
// ----
func.def public @convert_result(%choose: i1, %value: f32) -> (i32) {
  %3 = scf.if %choose -> (i32) {
    %4 = scalar.fptosi %value : f32 to i32
    scf.yield %4 : i32
  } else {
    %5 = scalar.constant 7.5 : f64
    %6 = scalar.fptosi %5 : f64 to i32
    scf.yield %6 : i32
  }
  func.return %3 : i32
}

// ====
// RUN: roundtrip
// A void return expression retains its call and skips later effects.
void store(int* output) { output[0u] = 7; }
void effect(int* output, bool choose) {
  if (choose) {
    return store(output);
  }
  output[0u] = 9;
}
// ----
func.def public @store(%output: buffer, %output_byte_offset: index) {
  %2 = scalar.constant 7 : i32
  %3 = scalar.constant 0 : i32
  %4 = scalar.extui %3 : i32 to i64
  %5 = index.cast %4 : i64 to index
  %6 = index.constant 4 : index
  %7 = index.mul %5, %6 : index
  %8 = index.add %output_byte_offset, %7 : index
  %9 = buffer.view %output[%8] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %2, %9[0] : i32, view<1xi32>
  func.return
}

func.def public @effect(%output: buffer, %output_byte_offset: index, %choose: i1) {
  scf.if %choose {
    func.call @store(%output, %output_byte_offset) : (buffer, index)
  } else {
    %13 = scalar.constant 9 : i32
    %14 = scalar.constant 0 : i32
    %15 = scalar.extui %14 : i32 to i64
    %16 = index.cast %15 : i64 to index
    %17 = index.constant 4 : index
    %18 = index.mul %16, %17 : index
    %19 = index.add %output_byte_offset, %18 : index
    %20 = buffer.view %output[%19] : buffer -> view<1xi32>
    view.store<root_in_bounds|type_disjoint> %13, %20[0] : i32, view<1xi32>
  }
  func.return
}

// ====
// RUN: roundtrip
// Statements after an unconditional return are unreachable.
void unreachable(int* output) {
  return;
  output[0u] = 10;
}
// ----
func.def public @unreachable(%output: buffer, %output_byte_offset: index) {
  func.return
}
