  %total$24 = scf.for %index = [%13 to %14 step %15](%total$23 = %total$11 : i32) -> (i32) pipeline(%19) unroll(%21) {
    %25 = index.cast %index : offset to i32
    %26 = scalar.extui %25 : i32 to i64
    %27 = scalar.constant 4 : i64
    %28 = scalar.muli %26, %27 : i64
    %29 = index.cast %input_byte_offset : offset to i64
    %30 = scalar.addi %29, %28 : i64
    %31 = scalar.assume %30 [range(%30, 0, 9223372036854775807)] : i64
    %32 = index.cast %31 : i64 to offset
    %33 = buffer.view %input[%32] : buffer -> view<1xi32>
    %value = view.load %33[0] : view<1xi32> -> i32
    %35 = scalar.andi %25, %choose : i32
    %36 = scalar.constant 0 : i32
    %37 = scalar.cmpi ne, %35, %36 : i32
    %38, %total$39 = scf.if %37 -> (i1, i32) {
      %40 = scalar.constant 0 : i1
      scf.yield %40, %total$23 : i1, i32
    } else {
      %total = scalar.addi %total$23, %value : i32
      %42 = scalar.constant 1 : i1
      scf.yield %42, %total : i1, i32
    }
    scf.yield %total$39 : i32
  }
  func.return %total$24 : i32
