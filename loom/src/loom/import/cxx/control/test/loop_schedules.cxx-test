// RUN: roundtrip
// Template loop schedules become explicit SSA operands.
template <unsigned Factor, unsigned Depth>
static int sum(unsigned count) {
  int total = 0;
  [[loom::unroll(Factor), loom::pipeline(Depth + 1),
    loom::schedule("interleaved")]]
  for (unsigned index = 0; index < count; ++index) {
    if constexpr (false) {
      break;
    }
    total += (int)index;
  }
  return total;
}
int entry(unsigned count) { return sum<3, 1>(count); }
// ----
func.def public @entry(%count: i32) -> (i32) {
  %2 = func.call pure @sum_3_1(%count) : (i32) -> (i32)
  func.return %2 : i32
}

func.def @sum_3_1(%count: i32) -> (i32) {
  %total$5 = scalar.constant 0 : i32
  %index = scalar.constant 0 : i32
  %7 = index.cast %index : i32 to offset
  %8 = index.cast %count : i32 to offset
  %9 = index.constant 1 : offset
  %10 = scalar.constant 1 : i32
  %11 = scalar.constant 1 : i32
  %12 = scalar.addi %10, %11 : i32
  %13 = scalar.constant 3 : i32
  %14 = scalar.extui %12 : i32 to i64
  %15 = index.cast %14 : i64 to index
  %16 = scalar.extui %13 : i32 to i64
  %17 = index.cast %16 : i64 to index
  %total$20 = scf.for %index = [%7 to %8 step %9](%total$19 = %total$5 : i32) -> (i32) pipeline(%15) unroll(%17) schedule(interleaved) {
    %21 = index.cast %index : offset to i32
    %total$22 = scalar.addi %total$19, %21 : i32
    scf.yield %total$22 : i32
  }
  func.return %total$20 : i32
}
// ====
// RUN: roundtrip
// Bare unroll and constant expressions retain loop schedules.
int entry() {
  constexpr unsigned depth = 1;
  int total = 0;
  [[using loom: unroll, pipeline(depth), schedule("recurrence")]]
  for (unsigned index = 0; index < 4u; ++index) {
    total += (int)index;
  }
  return total;
}
// ----
func.def public @entry() -> (i32) {
  %depth = scalar.constant 1 : i32
  %total$2 = scalar.constant 0 : i32
  %index = scalar.constant 0 : i32
  %4 = index.cast %index : i32 to offset
  %5 = scalar.constant 4 : i32
  %6 = index.cast %5 : i32 to offset
  %7 = index.constant 1 : offset
  %8 = scalar.extui %depth : i32 to i64
  %9 = index.cast %8 : i64 to index
  %total$12 = scf.for %index = [%4 to %6 step %7](%total$11 = %total$2 : i32) -> (i32) pipeline(%9) unroll schedule(recurrence) {
    %13 = index.cast %index : offset to i32
    %total$14 = scalar.addi %total$11, %13 : i32
    scf.yield %total$14 : i32
  }
  func.return %total$12 : i32
}

// ====
// RUN: roundtrip
// Template schedules retain the unconditional load before a conditional continue.
template <unsigned Unroll, unsigned Pipeline>
static unsigned continue_schedule(const unsigned* input, unsigned count,
                                  unsigned choose) {
  unsigned total = 0;
  [[loom::unroll(Unroll), loom::pipeline(Pipeline)]]
  for (unsigned index = 0; index < count; ++index) {
    unsigned value = input[index];
    if ((index & choose) != 0u) continue;
    total += value;
  }
  return total;
}
unsigned selected(const unsigned* input, unsigned count, unsigned choose) {
  return continue_schedule<3, 2>(input, count, choose);
}
// ----
func.def public @selected(%input: buffer, %input_byte_offset: offset, %count: i32, %choose: i32) -> (i32) {
  %5 = func.call readonly @continue_schedule_3_2(%input, %input_byte_offset, %count, %choose) : (buffer, offset, i32, i32) -> (i32)
  func.return %5 : i32
}

