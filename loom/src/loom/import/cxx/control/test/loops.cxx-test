// RUN: roundtrip
// Pre and post test loops preserve scalar recurrences.
unsigned long long entry(unsigned count) {
  unsigned char narrow = 254;
  unsigned long long wide = 0;
  while (wide < count) {
    do {
      ++narrow;
      ++wide;
    } while (narrow < 2);
  }
  for (; wide < count + 2;) {
    ++wide;
  }
  return wide + narrow;
}
// ----
func.def public @entry(%count: i32) -> (i64) {
  %2 = scalar.constant 254 : i32
  %narrow$3 = scalar.trunci %2 : i32 to i8
  %4 = scalar.constant 0 : i32
  %wide$5 = scalar.extsi %4 : i32 to i64
  %narrow$10, %wide$11 = scf.while(%narrow = %narrow$3 : i8, %wide = %wide$5 : i64) -> (i8, i64) {
    %12 = scalar.extui %count : i32 to i64
    %13 = scalar.cmpi ult, %wide, %12 : i64
    scf.condition %13, %narrow, %wide : i1, i8, i64
  } do(%narrow$8: i8, %wide$9: i64) {
    %narrow$18, %wide$19 = scf.while(%narrow$14 = %narrow$8 : i8, %wide$15 = %wide$9 : i64) -> (i8, i64) {
      %20 = scalar.extui %narrow$14 : i8 to i32
      %21 = scalar.constant 1 : i32
      %22 = scalar.addi %20, %21 : i32
      %narrow$23 = scalar.trunci %22 : i32 to i8
      %24 = scalar.constant 1 : i64
      %wide$25 = scalar.addi %wide$15, %24 : i64
      %26 = scalar.extui %narrow$23 : i8 to i32
      %27 = scalar.constant 2 : i32
      %28 = scalar.cmpi slt, %26, %27 : i32
      scf.condition %28, %narrow$23, %wide$25 : i1, i8, i64
    } do(%narrow: i8, %wide: i64) {
      scf.yield %narrow, %wide : i8, i64
    }
    scf.yield %narrow$18, %wide$19 : i8, i64
  }
  %wide$31 = scf.while(%wide = %wide$11 : i64) -> (i64) {
    %32 = scalar.constant 2 : i32
    %33 = scalar.addi %count, %32 : i32
    %34 = scalar.extui %33 : i32 to i64
    %35 = scalar.cmpi ult, %wide, %34 : i64
    scf.condition %35, %wide : i1, i64
  } do(%wide$30: i64) {
    %36 = scalar.constant 1 : i64
    %wide$37 = scalar.addi %wide$30, %36 : i64
    scf.yield %wide$37 : i64
  }
  %38 = scalar.extui %narrow$10 : i8 to i64
  %39 = scalar.addi %wide$31, %38 : i64
  func.return %39 : i64
}
// ====
// RUN: roundtrip
// Wide loop comparison retains induction wraparound.
unsigned entry(unsigned long long upper) {
  unsigned sum = 0;
  for (unsigned i = 0; i < upper; ++i) {
    sum += i;
  }
  return sum;
}
// ----
func.def public @entry(%upper: i64) -> (i32) {
  %sum$2 = scalar.constant 0 : i32
  %i$3 = scalar.constant 0 : i32
  %sum$8, %i$9 = scf.while(%sum = %sum$2 : i32, %i = %i$3 : i32) -> (i32, i32) {
    %10 = scalar.extui %i : i32 to i64
    %11 = scalar.cmpi ult, %10, %upper : i64
    scf.condition %11, %sum, %i : i1, i32, i32
  } do(%sum$6: i32, %i$7: i32) {
    %sum$12 = scalar.addi %sum$6, %i$7 : i32
    %13 = scalar.constant 1 : i32
    %i$14 = scalar.addi %i$7, %13 : i32
    scf.yield %sum$12, %i$14 : i32, i32
  }
  func.return %sum$8 : i32
}

// ====
// RUN: roundtrip
// The condition call executes before each while body, including the false exit.
[[loom::import("effects")]] bool next(unsigned* value, unsigned count);
unsigned pre_test(unsigned* value, unsigned count) {
  unsigned total = 0;
  while (next(value, count)) ++total;
  return total;
}
// ----
func.def public @pre_test(%value: buffer, %value_byte_offset: offset, %count: i32) -> (i32) {
  %total$4 = scalar.constant 0 : i32
  %total$7 = scf.while(%total = %total$4 : i32) -> (i32) {
    %8 = func.call @next(%value, %value_byte_offset, %count) : (buffer, offset, i32) -> (i1)
    scf.condition %8, %total : i1, i32
  } do(%total$6: i32) {
    %9 = scalar.constant 1 : i32
    %total$10 = scalar.addi %total$6, %9 : i32
    scf.yield %total$10 : i32
  }
  func.return %total$7 : i32
}

func.decl import("effects") @next(%11: buffer, %12: offset, %13: i32) -> (i1)

// ====
// RUN: roundtrip
// The do body executes before its first condition call.
[[loom::import("effects")]] bool next(unsigned* value, unsigned count);
unsigned post_test(unsigned* value, unsigned count) {
  unsigned total = 0;
  do { ++total; } while (next(value, count));
  return total;
}
// ----
func.def public @post_test(%value: buffer, %value_byte_offset: offset, %count: i32) -> (i32) {
  %total$4 = scalar.constant 0 : i32
  %total$7 = scf.while(%total$5 = %total$4 : i32) -> (i32) {
    %8 = scalar.constant 1 : i32
    %total$9 = scalar.addi %total$5, %8 : i32
    %10 = func.call @next(%value, %value_byte_offset, %count) : (buffer, offset, i32) -> (i1)
    scf.condition %10, %total$9 : i1, i32
  } do(%total: i32) {
    scf.yield %total : i32
  }
  func.return %total$7 : i32
}

func.decl import("effects") @next(%11: buffer, %12: offset, %13: i32) -> (i1)

// ====
// RUN: roundtrip
// A condition that mutates its bound remains a while with the final bound live.
unsigned mutable_bound(const unsigned* input, unsigned start) {
  unsigned bound = 20;
  unsigned total = 0;
  for (unsigned index = start; index < --bound; ++index) {
    total += input[index];
  }
  return total + bound;
}
// ----
func.def public @mutable_bound(%input: buffer, %input_byte_offset: offset, %start: i32) -> (i32) {
  %bound$4 = scalar.constant 20 : i32
  %total$5 = scalar.constant 0 : i32
  %bound$12, %total$13, %index = scf.while(%bound$6 = %bound$4 : i32, %total = %total$5 : i32, %index = %start : i32) -> (i32, i32, i32) {
    %15 = scalar.constant 1 : i32
    %bound$16 = scalar.subi %bound$6, %15 : i32
    %17 = scalar.cmpi ult, %index, %bound$16 : i32
    scf.condition %17, %bound$16, %total, %index : i1, i32, i32, i32
  } do(%bound: i32, %total$10: i32, %index$11: i32) {
    %18 = scalar.extui %index$11 : i32 to i64
    %19 = scalar.constant 4 : i64
    %20 = scalar.muli %18, %19 : i64
    %21 = index.cast %input_byte_offset : offset to i64
    %22 = scalar.addi %21, %20 : i64
    %23 = scalar.assume %22 [range(%22, 0, 9223372036854775807)] : i64
    %24 = index.cast %23 : i64 to offset
    %25 = buffer.view %input[%24] : buffer -> view<1xi32>
    %26 = view.load<root_in_bounds> %25[0] : view<1xi32> -> i32
    %total$27 = scalar.addi %total$10, %26 : i32
    %28 = scalar.constant 1 : i32
    %index$29 = scalar.addi %index$11, %28 : i32
    scf.yield %bound, %total$27, %index$29 : i32, i32, i32
  }
  %30 = scalar.addi %total$13, %bound$12 : i32
  func.return %30 : i32
}
