  %8 = scalar.constant 1 : i32
  %value$9 = scalar.addi %value$6, %8 : i32
  %10 = scalar.constant 10 : i32
  %11 = scalar.cmpi ult, %value$9, %10 : i32
  %12 = scf.if %11 -> (i32) {
    %13 = scalar.constant 20 : i32
    %14 = scalar.addi %value$9, %13 : i32
    scf.yield %14 : i32
  } else {
    %15 = scalar.constant 40 : i32
    %16 = scalar.addi %value$9, %15 : i32
    scf.yield %16 : i32
  }
  func.return %12 : i32
}

func.def @selected_return_0(%value$17: i32) -> (i32) {
  %19 = scalar.constant 1 : i32
  %value$20 = scalar.addi %value$17, %19 : i32
