// ====
// RUN: roundtrip
// Both runtime branches join the state changed by the initializer.
unsigned runtime_initializer_join(unsigned value, bool selected) {
  if (unsigned original = value++; selected) {
    value += original;
  } else {
    value += 10;
  }
  return value;
}
// ----
