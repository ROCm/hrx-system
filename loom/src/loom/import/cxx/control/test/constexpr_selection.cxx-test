// ====
// RUN: roundtrip
// An if initializer is sequenced before the condition and lives in the selected arm.
unsigned runtime_initializer(unsigned value, bool selected) {
  if (unsigned original = value++; selected) {
    return value + original;
  }
  return value;
}
