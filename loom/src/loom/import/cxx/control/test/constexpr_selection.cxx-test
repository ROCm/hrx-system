// RUN: roundtrip
// A discarded source branch contributes no runtime operations.
int entry(int value) {
  if constexpr (false) {
    switch (value) {
      case 1: return 20;
      default: return 30;
    }
  }
  if constexpr (true) return value + 1;
  else return value - 1;
}
// ----
func.def public @entry(%value: i32) -> (i32) {
  %2 = scalar.constant 1 : i32
  %3 = scalar.addi %value, %2 : i32
  func.return %3 : i32
}

// ====
// A constant initializer can supply the selection after substitution.
template <unsigned Bias>
static unsigned select(unsigned value) {
  if constexpr (const unsigned bias = Bias; bias > 3) return value + bias;
  else return value - bias;
}
unsigned entry(unsigned value) { return select<5>(value) + select<2>(value); }
// ----
func.def public @entry(%value: i32) -> (i32) {
  %2 = func.call pure @select_5(%value) : (i32) -> (i32)
  %3 = func.call pure @select_2(%value) : (i32) -> (i32)
  %4 = scalar.addi %2, %3 : i32
  func.return %4 : i32
}

func.def @select_5(%value: i32) -> (i32) {
  %bias = scalar.constant 5 : i32
  %8 = scalar.addi %value, %bias : i32
  func.return %8 : i32
}

func.def @select_2(%value: i32) -> (i32) {
  %bias = scalar.constant 2 : i32
  %12 = scalar.subi %value, %bias : i32
  func.return %12 : i32
}

// ====
// Discarded dependent expressions need no implementation for this source type.
template <class T>
static auto select(T value) {
  if constexpr (sizeof(T) == sizeof(int)) return value + 1;
  else return value.missing();
}
int entry(int value) { return select(value); }
// ----
func.def public @entry(%value: i32) -> (i32) {
  %2 = func.call pure @select_int(%value) : (i32) -> (i32)
  func.return %2 : i32
}

func.def @select_int(%value: i32) -> (i32) {
  %5 = scalar.constant 1 : i32
  %6 = scalar.addi %value, %5 : i32
  func.return %6 : i32
}

// ====
// Concrete return types can differ between specializations.
template <bool Floating>
static auto select(int value) {
  if constexpr (Floating) return float(value);
  else return value;
}
float floating(int value) { return select<true>(value); }
int integer(int value) { return select<false>(value); }
// ----
func.def public @floating(%value: i32) -> (f32) {
  %2 = func.call pure @select_1(%value) : (i32) -> (f32)
  func.return %2 : f32
}

func.def public @integer(%value: i32) -> (i32) {
  %5 = func.call pure @select_0(%value) : (i32) -> (i32)
  func.return %5 : i32
}

func.def @select_1(%value: i32) -> (f32) {
  %8 = scalar.sitofp %value : i32 to f32
  func.return %8 : f32
}

func.def @select_0(%value: i32) -> (i32) {
  func.return %value : i32
}

// ====
// Discarded writes and exits do not prevent a scheduled counted loop.
unsigned entry(unsigned count) {
  unsigned total = 0;
  [[loom::unroll(2)]]
  for (unsigned index = 0; index < count; ++index) {
    if constexpr (false) {
      --count;
      return 100;
    }
    if constexpr (true) {
      if (index & 1u) continue;
    }
    total += index;
  }
  return total;
}
// ----
