  %total$2 = scalar.constant 0 : i32
  %index = scalar.constant 0 : i32
  %4 = index.cast %index : i32 to offset
  %5 = index.cast %count : i32 to offset
  %6 = index.constant 1 : offset
  %7 = scalar.constant 2 : i32
  %8 = index.cast %7 : i32 to index
  %total$11 = scf.for %index = [%4 to %5 step %6](%total$10 = %total$2 : i32) -> (i32) unroll(%8) {
    %12 = index.cast %index : offset to i32
    %13 = scalar.constant 1 : i32
    %14 = scalar.andi %12, %13 : i32
    %15 = scalar.constant 0 : i32
    %16 = scalar.cmpi ne, %14, %15 : i32
    %17 = scf.if %16 -> (i1) {
      %18 = scalar.constant 0 : i1
      scf.yield %18 : i1
    } else {
      %19 = scalar.constant 1 : i1
      scf.yield %19 : i1
    }
    %20, %total$21 = scf.if %17 -> (i1, i32) {
      %total = scalar.addi %total$10, %12 : i32
      %23 = scalar.constant 1 : i1
      scf.yield %23, %total : i1, i32
    } else {
      %24 = scalar.constant 0 : i1
      scf.yield %24, %total$10 : i1, i32
    }
    scf.yield %total$21 : i32
  }
  func.return %total$11 : i32
}

// ====
// Initializer bindings participate in runtime regions just like outer locals.
unsigned entry(unsigned value, bool selected) {
  if (unsigned original = value++; selected) value += original;
  return value;
}
// ----
func.def public @entry(%value$0: i32, %selected: i1) -> (i32) {
  %3 = scalar.constant 1 : i32
  %value$4 = scalar.addi %value$0, %3 : i32
  %value$5 = scf.if %selected -> (i32) {
    %value = scalar.addi %value$4, %value$0 : i32
    scf.yield %value : i32
  } else {
    scf.yield %value$4 : i32
  }
  func.return %value$5 : i32
}

// ====
// RUN: roundtrip
// A constexpr selection keeps its initializer and every selected runtime return.
template <bool Selected>
static unsigned selected_return(unsigned value) {
  if constexpr (++value; Selected) {
    if (value < 10) {
      return value + 20;
    }
  } else {
    return value + 30;
  }
  return value + 40;
}
unsigned taken(unsigned value) { return selected_return<true>(value); }
unsigned other(unsigned value) { return selected_return<false>(value); }
// ----
func.def public @taken(%value: i32) -> (i32) {
  %2 = func.call pure @selected_return_1(%value) : (i32) -> (i32)
  func.return %2 : i32
}

func.def public @other(%value: i32) -> (i32) {
  %5 = func.call pure @selected_return_0(%value) : (i32) -> (i32)
  func.return %5 : i32
}

