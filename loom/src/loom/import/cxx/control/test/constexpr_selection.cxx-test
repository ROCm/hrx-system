// ====
// RUN: roundtrip
// A constexpr else arm can continue past a runtime if initializer and its shared tail.
unsigned selected_continue_tail(unsigned count) {
  unsigned total = 0;
  unsigned visits = 0;
  for (unsigned index = 0; index < count; ++index) {
    if (unsigned previous = visits++; index & 1u) {
      total += previous;
    } else if constexpr (true) {
      continue;
    }
    total += 10;
  }
  return total + 100 * visits;
}
