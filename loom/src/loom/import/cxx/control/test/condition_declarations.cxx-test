    %20 = scalar.constant 0 : i32
    %21 = scalar.cmpi ne, %value, %20 : i32
    scf.condition %21, %checks, %count, %total, %value : i1, i32, i32, i32, i32
  } do(%checks$12: i32, %count$13: i32, %total$14: i32, %value$15: i32) {
    %22 = scalar.constant 2 : i32
    %23 = scalar.cmpi eq, %value$15, %22 : i32
    %24, %value$25, %total$26 = scf.if %23 -> (i1, i32, i32) {
      %27 = scalar.constant 10 : i32
      %value = scalar.addi %value$15, %27 : i32
      %total = scalar.addi %total$14, %value : i32
      %30 = scalar.constant 0 : i1
      scf.yield %30, %value, %total : i1, i32, i32
    } else {
      %total = scalar.addi %total$14, %value$15 : i32
      %32 = scalar.constant 1 : i1
      scf.yield %32, %value$15, %total : i1, i32, i32
    }
    %33 = scalar.constant 1 : i32
    %checks$34 = scalar.addi %checks$12, %33 : i32
    %35 = scalar.constant 1 : i32
    %count$36 = scalar.subi %count$13, %35 : i32
    scf.yield %checks$34, %count$36, %total$26, %count$13 : i32, i32, i32, i32
  }
  %37 = scalar.constant 100 : i32
  %38 = scalar.muli %37, %checks$16 : i32
  %39 = scalar.addi %total$18, %38 : i32
  %40 = scalar.constant 10000 : i32
  %41 = scalar.constant 1 : i32
  %42 = scalar.addi %count$17, %41 : i32
  %43 = scalar.muli %40, %42 : i32
  %44 = scalar.addi %39, %43 : i32
  func.return %44 : i32
}

// ====
// RUN: roundtrip
// Continue reaches the step with the body-modified condition variable.
unsigned for_values(unsigned count) {
  unsigned checks = 0;
  unsigned total = 0;
  for (unsigned remaining = count; unsigned value = (++checks, remaining);
       remaining = value - 1) {
    if (value > 2) {
      --value;
      continue;
    }
    total += value;
  }
  return total + 100 * checks;
}
// ----
func.def public @for_values(%count: i32) -> (i32) {
  %checks$2 = scalar.constant 0 : i32
  %total$3 = scalar.constant 0 : i32
  %4 = scalar.constant 1 : i32
  %checks$5 = scalar.addi %checks$2, %4 : i32
  %checks$14, %total$15, %remaining, %value = scf.while(%checks = %checks$5 : i32, %total = %total$3 : i32, %remaining = %count : i32, %value = %count : i32) -> (i32, i32, i32, i32) {
    %18 = scalar.constant 0 : i32
    %19 = scalar.cmpi ne, %value, %18 : i32
    scf.condition %19, %checks, %total, %remaining, %value : i1, i32, i32, i32, i32
  } do(%checks$10: i32, %total$11: i32, %remaining$12: i32, %value$13: i32) {
    %20 = scalar.constant 2 : i32
    %21 = scalar.cmpi ugt, %value$13, %20 : i32
    %22, %value$23, %total$24 = scf.if %21 -> (i1, i32, i32) {
      %25 = scalar.constant 1 : i32
      %value = scalar.subi %value$13, %25 : i32
      %27 = scalar.constant 0 : i1
      scf.yield %27, %value, %total$11 : i1, i32, i32
    } else {
      %total = scalar.addi %total$11, %value$13 : i32
      %29 = scalar.constant 1 : i1
      scf.yield %29, %value$13, %total : i1, i32, i32
    }
    %30 = scalar.constant 1 : i32
    %remaining$31 = scalar.subi %value$23, %30 : i32
    %32 = scalar.constant 1 : i32
    %checks$33 = scalar.addi %checks$10, %32 : i32
    scf.yield %checks$33, %total$24, %remaining$31, %remaining$31 : i32, i32, i32, i32
  }
  %34 = scalar.constant 100 : i32
  %35 = scalar.muli %34, %checks$14 : i32
  %36 = scalar.addi %total$15, %35 : i32
  func.return %36 : i32
}

// ====
// RUN: roundtrip
// Void-cast increments still update both loop recurrences.
unsigned discarded_values(unsigned count) {
  unsigned total = 0;
  for (; unsigned value = count; (void)++total, (void)--count) {
    total += value;
  }
  return total;
}
// ----
func.def public @discarded_values(%count$0: i32) -> (i32) {
  %total$2 = scalar.constant 0 : i32
  %total$9, %count$10, %value = scf.while(%total = %total$2 : i32, %count = %count$0 : i32, %value = %count$0 : i32) -> (i32, i32, i32) {
    %12 = scalar.constant 0 : i32
    %13 = scalar.cmpi ne, %value, %12 : i32
    scf.condition %13, %total, %count, %value : i1, i32, i32, i32
  } do(%total$6: i32, %count$7: i32, %value: i32) {
    %total$14 = scalar.addi %total$6, %value : i32
    %15 = scalar.constant 1 : i32
    %total$16 = scalar.addi %total$14, %15 : i32
    %17 = scalar.constant 1 : i32
    %count$18 = scalar.subi %count$7, %17 : i32
    scf.yield %total$16, %count$18, %count$18 : i32, i32, i32
  }
  func.return %total$9 : i32
}

// ====
// RUN: pass canonicalize,cse,dce
// The condition name is in scope in sizeof and in either constexpr arm.
template <unsigned Choice>
static unsigned selected_value(unsigned input) {
  if constexpr (const unsigned value = sizeof(value) ? Choice : 0u) {
    return input + value;
  } else {
    return input + value + 20;
  }
}
unsigned selected(unsigned input) { return selected_value<7>(input); }
unsigned discarded(unsigned input) { return selected_value<0>(input); }
// ----
func.def public @selected(%input: i32) -> (i32) {
  %2 = func.call pure @selected_value_7(%input) : (i32) -> (i32)
  func.return %2 : i32
}

func.def public @discarded(%input: i32) -> (i32) {
  %5 = func.call pure @selected_value_0(%input) : (i32) -> (i32)
  func.return %5 : i32
}

func.def @selected_value_7(%input: i32) -> (i32) {
  %value = scalar.constant 7 : i32
  %9 = scalar.addi %input, %value : i32
  func.return %9 : i32
}

func.def @selected_value_0(%input: i32) -> (i32) {
  %16 = scalar.constant 20 : i32
  %17 = scalar.addi %input, %16 : i32
  func.return %17 : i32
}
