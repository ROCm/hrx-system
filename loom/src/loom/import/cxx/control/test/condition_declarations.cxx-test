  %checks$2 = scalar.constant 0 : i32
  %total$3 = scalar.constant 0 : i32
  %4 = scalar.constant 1 : i32
  %checks$5 = scalar.addi %checks$2, %4 : i32
  %6 = scalar.constant 1 : i32
