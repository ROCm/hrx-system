// RUN: roundtrip
// Each operand uses its own contextual Boolean conversion.
bool conjunction(int left, float right) { return left && right; }
// ----
func.def public @conjunction(%left: i32, %right: f32) -> (i1) {
  %3 = scalar.constant 0 : i32
  %4 = scalar.cmpi ne, %left, %3 : i32
  %5 = scf.if %4 -> (i1) {
    %6 = scalar.constant 0.0 : f32
    %7 = scalar.cmpf une, %right, %6 : f32
    scf.yield %7 : i1
  } else {
    scf.yield %4 : i1
  }
  func.return %5 : i1
}

// ====
// RUN: roundtrip
// A true left operand bypasses the right operand conversion.
bool disjunction(double left, unsigned long long right) {
  return left || right;
}
// ----
func.def public @disjunction(%left: f64, %right: i64) -> (i1) {
  %3 = scalar.constant 0.0 : f64
  %4 = scalar.cmpf une, %left, %3 : f64
  %5 = scf.if %4 -> (i1) {
    scf.yield %4 : i1
  } else {
    %6 = scalar.constant 0 : i64
    %7 = scalar.cmpi ne, %right, %6 : i64
    scf.yield %7 : i1
  }
  func.return %5 : i1
}

// ====
// RUN: roundtrip
// Parenthesized logical expressions preserve their nested evaluation.
bool nested(int a, int b, int c) { return a && (b || !c); }
// ----
func.def public @nested(%a: i32, %b: i32, %c: i32) -> (i1) {
  %4 = scalar.constant 0 : i32
  %5 = scalar.cmpi ne, %a, %4 : i32
  %6 = scf.if %5 -> (i1) {
    %7 = scalar.constant 0 : i32
    %8 = scalar.cmpi ne, %b, %7 : i32
    %9 = scf.if %8 -> (i1) {
      scf.yield %8 : i1
    } else {
      %10 = scalar.constant 0 : i32
      %11 = scalar.cmpi ne, %c, %10 : i32
      %12 = scalar.constant 1 : i1
      %13 = scalar.xori %11, %12 : i1
      scf.yield %13 : i1
    }
    scf.yield %9 : i1
  } else {
    scf.yield %5 : i1
  }
  func.return %6 : i1
}

// ====
// RUN: roundtrip
// The load belongs only to the successful bounds-check region.
bool guarded(const int* input, unsigned index, unsigned length) {
  return index < length && input[index];
}
// ----
func.def public @guarded(%input: buffer, %input_byte_offset: offset, %index: i32, %length: i32) -> (i1) {
  %5 = scalar.cmpi ult, %index, %length : i32
  %6 = scf.if %5 -> (i1) {
    %7 = scalar.extui %index : i32 to i64
    %8 = scalar.constant 4 : i64
    %9 = scalar.muli %7, %8 : i64
    %10 = index.cast %input_byte_offset : offset to i64
    %11 = scalar.addi %10, %9 : i64
    %12 = scalar.assume %11 [range(%11, 0, 9223372036854775807)] : i64
    %13 = index.cast %12 : i64 to offset
    %14 = buffer.view %input[%13] : buffer -> view<1xi32>
    %15 = view.load %14[0] : view<1xi32> -> i32
    %16 = scalar.constant 0 : i32
    %17 = scalar.cmpi ne, %15, %16 : i32
    scf.yield %17 : i1
  } else {
    scf.yield %5 : i1
  }
  func.return %6 : i1
}

// ====
// RUN: roundtrip
// Each loop condition guards the next source load.
unsigned scan(const int* input, unsigned length) {
  unsigned index = 0;
  while (index < length && input[index]) {
    ++index;
  }
  return index;
}
// ----
func.def public @scan(%input: buffer, %input_byte_offset: offset, %length: i32) -> (i32) {
  %index$4 = scalar.constant 0 : i32
  %index$7 = scf.while(%index = %index$4 : i32) -> (i32) {
    %8 = scalar.cmpi ult, %index, %length : i32
    %9 = scf.if %8 -> (i1) {
      %10 = scalar.extui %index : i32 to i64
      %11 = scalar.constant 4 : i64
      %12 = scalar.muli %10, %11 : i64
      %13 = index.cast %input_byte_offset : offset to i64
      %14 = scalar.addi %13, %12 : i64
      %15 = scalar.assume %14 [range(%14, 0, 9223372036854775807)] : i64
      %16 = index.cast %15 : i64 to offset
      %17 = buffer.view %input[%16] : buffer -> view<1xi32>
      %18 = view.load %17[0] : view<1xi32> -> i32
      %19 = scalar.constant 0 : i32
      %20 = scalar.cmpi ne, %18, %19 : i32
      scf.yield %20 : i1
    } else {
      scf.yield %8 : i1
    }
    scf.condition %9, %index : i1, i32
  } do(%index$6: i32) {
    %21 = scalar.constant 1 : i32
    %index$22 = scalar.addi %index$6, %21 : i32
    scf.yield %index$22 : i32
  }
  func.return %index$7 : i32
}

// ====
// RUN: roundtrip
// The left call completes before the right call, which is conditional.
[[loom::import("effects")]] int record(int digit, int value);
bool conjunction(int left, int right) {
  return record(1, left) && record(2, right);
}
// ----
func.def public @conjunction(%left: i32, %right: i32) -> (i1) {
  %3 = scalar.constant 1 : i32
  %4 = func.call @record(%3, %left) : (i32, i32) -> (i32)
  %5 = scalar.constant 0 : i32
  %6 = scalar.cmpi ne, %4, %5 : i32
  %7 = scf.if %6 -> (i1) {
    %8 = scalar.constant 2 : i32
    %9 = func.call @record(%8, %right) : (i32, i32) -> (i32)
    %10 = scalar.constant 0 : i32
    %11 = scalar.cmpi ne, %9, %10 : i32
    scf.yield %11 : i1
  } else {
    scf.yield %6 : i1
  }
  func.return %7 : i1
}

func.decl import("effects") @record(%12: i32, %13: i32) -> (i32)

// ====
// RUN: roundtrip
// Logical disjunction evaluates the right call only after a false left call.
[[loom::import("effects")]] int record(int digit, int value);
bool disjunction(int left, int right) {
  return record(1, left) || record(2, right);
}
// ----
func.def public @disjunction(%left: i32, %right: i32) -> (i1) {
  %3 = scalar.constant 1 : i32
  %4 = func.call @record(%3, %left) : (i32, i32) -> (i32)
  %5 = scalar.constant 0 : i32
  %6 = scalar.cmpi ne, %4, %5 : i32
  %7 = scf.if %6 -> (i1) {
    scf.yield %6 : i1
  } else {
    %8 = scalar.constant 2 : i32
    %9 = func.call @record(%8, %right) : (i32, i32) -> (i32)
    %10 = scalar.constant 0 : i32
    %11 = scalar.cmpi ne, %9, %10 : i32
    scf.yield %11 : i1
  }
  func.return %7 : i1
}

func.decl import("effects") @record(%12: i32, %13: i32) -> (i32)

// ====
// RUN: roundtrip
// Discarding the logical result preserves the conditional call.
[[loom::import("effects")]] int record(int digit, int value);
void discarded(unsigned mask) {
  (mask & 8u) && record(4, 1);
}
// ----
func.def public @discarded(%mask: i32) {
  %1 = scalar.constant 8 : i32
  %2 = scalar.andi %mask, %1 : i32
  %3 = scalar.constant 0 : i32
  %4 = scalar.cmpi ne, %2, %3 : i32
  %5 = scf.if %4 -> (i1) {
    %6 = scalar.constant 4 : i32
    %7 = scalar.constant 1 : i32
    %8 = func.call @record(%6, %7) : (i32, i32) -> (i32)
    %9 = scalar.constant 0 : i32
    %10 = scalar.cmpi ne, %8, %9 : i32
    scf.yield %10 : i1
  } else {
    scf.yield %4 : i1
  }
  func.return
}

func.decl import("effects") @record(%11: i32, %12: i32) -> (i32)

// ====
// RUN: roundtrip
// Every successful bound enables the next effect and bound in source order.
[[loom::import("effects")]] int record(int digit, int value);
bool chain(unsigned value) {
  return value < 64u && record(1, 1) && value < 32u && record(2, 1) &&
         value < 16u && record(3, 1) && value < 8u && record(4, 1) &&
         value < 4u && record(5, 1) && value < 2u && record(6, 1) &&
         value < 1u;
}
// ----
func.def public @chain(%value: i32) -> (i1) {
  %2 = scalar.constant 64 : i32
  %3 = scalar.cmpi ult, %value, %2 : i32
  %4 = scf.if %3 -> (i1) {
    %5 = scalar.constant 1 : i32
    %6 = scalar.constant 1 : i32
    %7 = func.call @record(%5, %6) : (i32, i32) -> (i32)
    %8 = scalar.constant 0 : i32
    %9 = scalar.cmpi ne, %7, %8 : i32
    scf.yield %9 : i1
  } else {
    scf.yield %3 : i1
  }
  %10 = scf.if %4 -> (i1) {
    %11 = scalar.constant 32 : i32
    %12 = scalar.cmpi ult, %value, %11 : i32
    scf.yield %12 : i1
  } else {
    scf.yield %4 : i1
  }
  %13 = scf.if %10 -> (i1) {
    %14 = scalar.constant 2 : i32
    %15 = scalar.constant 1 : i32
    %16 = func.call @record(%14, %15) : (i32, i32) -> (i32)
    %17 = scalar.constant 0 : i32
    %18 = scalar.cmpi ne, %16, %17 : i32
    scf.yield %18 : i1
  } else {
    scf.yield %10 : i1
  }
  %19 = scf.if %13 -> (i1) {
    %20 = scalar.constant 16 : i32
    %21 = scalar.cmpi ult, %value, %20 : i32
    scf.yield %21 : i1
  } else {
    scf.yield %13 : i1
  }
  %22 = scf.if %19 -> (i1) {
    %23 = scalar.constant 3 : i32
    %24 = scalar.constant 1 : i32
    %25 = func.call @record(%23, %24) : (i32, i32) -> (i32)
    %26 = scalar.constant 0 : i32
    %27 = scalar.cmpi ne, %25, %26 : i32
    scf.yield %27 : i1
  } else {
    scf.yield %19 : i1
  }
  %28 = scf.if %22 -> (i1) {
    %29 = scalar.constant 8 : i32
    %30 = scalar.cmpi ult, %value, %29 : i32
    scf.yield %30 : i1
  } else {
    scf.yield %22 : i1
  }
  %31 = scf.if %28 -> (i1) {
    %32 = scalar.constant 4 : i32
    %33 = scalar.constant 1 : i32
    %34 = func.call @record(%32, %33) : (i32, i32) -> (i32)
    %35 = scalar.constant 0 : i32
    %36 = scalar.cmpi ne, %34, %35 : i32
    scf.yield %36 : i1
  } else {
    scf.yield %28 : i1
  }
  %37 = scf.if %31 -> (i1) {
    %38 = scalar.constant 4 : i32
    %39 = scalar.cmpi ult, %value, %38 : i32
    scf.yield %39 : i1
  } else {
    scf.yield %31 : i1
  }
  %40 = scf.if %37 -> (i1) {
    %41 = scalar.constant 5 : i32
    %42 = scalar.constant 1 : i32
    %43 = func.call @record(%41, %42) : (i32, i32) -> (i32)
    %44 = scalar.constant 0 : i32
    %45 = scalar.cmpi ne, %43, %44 : i32
    scf.yield %45 : i1
  } else {
    scf.yield %37 : i1
  }
  %46 = scf.if %40 -> (i1) {
    %47 = scalar.constant 2 : i32
    %48 = scalar.cmpi ult, %value, %47 : i32
    scf.yield %48 : i1
  } else {
    scf.yield %40 : i1
  }
  %49 = scf.if %46 -> (i1) {
    %50 = scalar.constant 6 : i32
    %51 = scalar.constant 1 : i32
    %52 = func.call @record(%50, %51) : (i32, i32) -> (i32)
    %53 = scalar.constant 0 : i32
    %54 = scalar.cmpi ne, %52, %53 : i32
    scf.yield %54 : i1
  } else {
    scf.yield %46 : i1
  }
  %55 = scf.if %49 -> (i1) {
    %56 = scalar.constant 1 : i32
    %57 = scalar.cmpi ult, %value, %56 : i32
    scf.yield %57 : i1
  } else {
    scf.yield %49 : i1
  }
  func.return %55 : i1
}

func.decl import("effects") @record(%58: i32, %59: i32) -> (i32)

// ====
// RUN: pass canonicalize,cse,dce
// A left-associated comparison chain retains all seven unsigned bounds.
unsigned comparison_chain(unsigned first, unsigned second, unsigned third,
                          unsigned fourth, unsigned fifth, unsigned sixth,
                          unsigned seventh) {
  return first < 256u && second < 256u && third < 256u && fourth < 256u &&
         fifth < 256u && sixth < 256u && seventh < 256u;
}
// ----
func.def public @comparison_chain(%first: i32, %second: i32, %third: i32, %fourth: i32, %fifth: i32, %sixth: i32, %seventh: i32) -> (i32) {
  %8 = scalar.constant 256 : i32
  %9 = scalar.cmpi ult, %first, %8 : i32
  %12 = scalar.cmpi ult, %second, %8 : i32
  %44 = scf.select %9, %12, %9 : i1
  %15 = scalar.cmpi ult, %third, %8 : i32
  %38 = scalar.constant false : i1
  %43 = scf.select %44, %15, %38 : i1
  %18 = scalar.cmpi ult, %fourth, %8 : i32
  %42 = scf.select %43, %18, %38 : i1
  %21 = scalar.cmpi ult, %fifth, %8 : i32
  %41 = scf.select %42, %21, %38 : i1
  %24 = scalar.cmpi ult, %sixth, %8 : i32
  %40 = scf.select %41, %24, %38 : i1
  %27 = scalar.cmpi ult, %seventh, %8 : i32
  %39 = scf.select %40, %27, %38 : i1
  %28 = scalar.extui %39 : i1 to i32
  func.return %28 : i32
}

// ====
// RUN: roundtrip
// Both the argument load and its effectful consumer stay inside the successful guard.
[[loom::import("effects")]] int record(int digit, int value);
bool guarded_call(const int* input, unsigned index, unsigned length) {
  return index < length && record(1, input[index]);
}
// ----
func.def public @guarded_call(%input: buffer, %input_byte_offset: offset, %index: i32, %length: i32) -> (i1) {
  %5 = scalar.cmpi ult, %index, %length : i32
  %6 = scf.if %5 -> (i1) {
    %7 = scalar.constant 1 : i32
    %8 = scalar.extui %index : i32 to i64
    %9 = scalar.constant 4 : i64
    %10 = scalar.muli %8, %9 : i64
    %11 = index.cast %input_byte_offset : offset to i64
    %12 = scalar.addi %11, %10 : i64
    %13 = scalar.assume %12 [range(%12, 0, 9223372036854775807)] : i64
    %14 = index.cast %13 : i64 to offset
    %15 = buffer.view %input[%14] : buffer -> view<1xi32>
    %16 = view.load %15[0] : view<1xi32> -> i32
    %17 = func.call @record(%7, %16) : (i32, i32) -> (i32)
    %18 = scalar.constant 0 : i32
    %19 = scalar.cmpi ne, %17, %18 : i32
    scf.yield %19 : i1
  } else {
    scf.yield %5 : i1
  }
  func.return %6 : i1
}

func.decl import("effects") @record(%20: i32, %21: i32) -> (i32)

// ====
// RUN: roundtrip
// Disjunction suppresses both the argument load and the call when the guard is true.
[[loom::import("effects")]] int record(int digit, int value);
bool guarded_disjunction(const int* input, unsigned index, unsigned length) {
  return index >= length || record(2, input[index]);
}
// ----
func.def public @guarded_disjunction(%input: buffer, %input_byte_offset: offset, %index: i32, %length: i32) -> (i1) {
  %5 = scalar.cmpi uge, %index, %length : i32
  %6 = scf.if %5 -> (i1) {
    scf.yield %5 : i1
  } else {
    %7 = scalar.constant 2 : i32
    %8 = scalar.extui %index : i32 to i64
    %9 = scalar.constant 4 : i64
    %10 = scalar.muli %8, %9 : i64
    %11 = index.cast %input_byte_offset : offset to i64
    %12 = scalar.addi %11, %10 : i64
    %13 = scalar.assume %12 [range(%12, 0, 9223372036854775807)] : i64
    %14 = index.cast %13 : i64 to offset
    %15 = buffer.view %input[%14] : buffer -> view<1xi32>
    %16 = view.load %15[0] : view<1xi32> -> i32
    %17 = func.call @record(%7, %16) : (i32, i32) -> (i32)
    %18 = scalar.constant 0 : i32
    %19 = scalar.cmpi ne, %17, %18 : i32
    scf.yield %19 : i1
  }
  func.return %6 : i1
}

func.decl import("effects") @record(%20: i32, %21: i32) -> (i32)
