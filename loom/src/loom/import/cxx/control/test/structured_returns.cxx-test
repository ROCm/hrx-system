// ====
// Loop-carried values and continue paths remain structured around two exits.
int integrate(double* values, double step) {
  int iteration = 0;
  while (true) {
    if (iteration >= 1000) return -4;
    double error = values[0];
    if (error > 1.0) {
      step *= 0.5;
      ++iteration;
      continue;
    }
    values[0] += step;
    ++iteration;
    if (values[0] > 10.0) return 1;
  }
}

