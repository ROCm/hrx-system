// ====
// Mutable reference writeback is captured at the taken return point.
static bool advance(unsigned& value, unsigned limit) {
  while (value < limit) {
    ++value;
    if ((value & 3u) == 0u) return true;
  }
  return false;
}
unsigned advance_entry(unsigned value, unsigned limit) {
  bool stopped = advance(value, limit);
  return value + (stopped ? 100u : 0u);
}

