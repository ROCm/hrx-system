// ====
// An early return stays lexical before a later counted loop that can return.
int early_then_counted(const int* values, int count) {
  if (values[0] > 9) return -2;
  for (int index = 0; index < count; ++index) {
    if (values[index] < 0) return index;
  }
  return -1;
}

