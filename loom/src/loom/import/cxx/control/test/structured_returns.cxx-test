  %28 = scalar.constant 1 : i32
  %29 = scalar.constant 0 : i32
  %30 = scalar.subi %29, %28 : i32
  func.return %30 : i32
}

// ====
// A helper return exits two nested counted loops without a source-level flag.
bool nested_matrix_finite(const double* values) {
  for (int row = 0; row < 4; ++row) {
    for (int column = 0; column < 4; ++column) {
      double value = values[row * 4 + column];
      if (value != value) return false;
    }
  }
  return true;
}

// ----
func.def public @nested_matrix_finite(%values: buffer, %values_byte_offset: index) -> (i1) {
  %row = scalar.constant 0 : i32
  %4 = index.cast %row : i32 to index
  %5 = scalar.constant 4 : i32
  %6 = index.cast %5 : i32 to index
  %7 = index.constant 1 : index
  scf.for %row = [%4 to %6 step %7] {
    %9 = index.cast %row : index to i32
    %column = scalar.constant 0 : i32
    %11 = index.cast %column : i32 to index
    %12 = scalar.constant 4 : i32
    %13 = index.cast %12 : i32 to index
    %14 = index.constant 1 : index
    scf.for %column = [%11 to %13 step %14] {
      %16 = index.cast %column : index to i32
      %17 = scalar.constant 4 : i32
      %18 = scalar.muli %9, %17 : i32
      %19 = scalar.addi %18, %16 : i32
      %20 = index.cast %19 : i32 to index
      %21 = index.constant 8 : index
      %22 = index.mul %20, %21 : index
      %23 = index.add %values_byte_offset, %22 : index
      %24 = buffer.view %values[%23] : buffer -> view<1xf64>
      %value = view.load<root_in_bounds|type_disjoint> %24[0] : view<1xf64> -> f64
      %26 = scalar.cmpf une, %value, %value : f64
      scf.if %26 {
        %27 = scalar.constant 0 : i1
        %28 = scalar.constant 1 : i1
        func.exit %28 : i1 {
          func.return %27 : i1
        }
      }
    }
  }
  %29 = scalar.constant 1 : i1
  func.return %29 : i1
}

// ====
// RUN: roundtrip
// A value-returning exit crosses three runtime loop bounds, including empty axes.
int nested_position(unsigned selected, unsigned planes, unsigned rows,
                    unsigned columns) {
  for (unsigned plane = 0; plane < planes; ++plane) {
    for (unsigned row = 0; row < rows; ++row) {
      for (unsigned column = 0; column < columns; ++column) {
        if (plane * 4u + row * 2u + column == selected) {
          return int(plane * 100u + row * 10u + column);
        }
      }
    }
  }
  return -1;
}
// ----
func.def public @nested_position(%selected: i32, %planes: i32, %rows: i32, %columns: i32) -> (i32) {
  %plane = scalar.constant 0 : i32
  %6 = index.cast %plane : i32 to offset
  %7 = index.cast %planes : i32 to offset
  %8 = index.constant 1 : offset
  scf.for %plane = [%6 to %7 step %8] {
    %10 = index.cast %plane : offset to i32
    %row = scalar.constant 0 : i32
    %12 = index.cast %row : i32 to offset
    %13 = index.cast %rows : i32 to offset
    %14 = index.constant 1 : offset
    scf.for %row = [%12 to %13 step %14] {
      %16 = index.cast %row : offset to i32
      %column = scalar.constant 0 : i32
      %18 = index.cast %column : i32 to offset
      %19 = index.cast %columns : i32 to offset
      %20 = index.constant 1 : offset
      scf.for %column = [%18 to %19 step %20] {
        %22 = index.cast %column : offset to i32
        %23 = scalar.constant 4 : i32
        %24 = scalar.muli %10, %23 : i32
        %25 = scalar.constant 2 : i32
        %26 = scalar.muli %16, %25 : i32
        %27 = scalar.addi %24, %26 : i32
        %28 = scalar.addi %27, %22 : i32
        %29 = scalar.cmpi eq, %28, %selected : i32
        scf.if %29 {
          %30 = scalar.constant 100 : i32
          %31 = scalar.muli %10, %30 : i32
          %32 = scalar.constant 10 : i32
          %33 = scalar.muli %16, %32 : i32
          %34 = scalar.addi %31, %33 : i32
          %35 = scalar.addi %34, %22 : i32
          %36 = scalar.constant 1 : i1
          func.exit %36 : i1 {
            func.return %35 : i32
          }
        }
      }
    }
  }
  %37 = scalar.constant 1 : i32
  %38 = scalar.constant 0 : i32
  %39 = scalar.subi %38, %37 : i32
  func.return %39 : i32
}

// ====
// RUN: roundtrip
// Each early return retains preceding stores and suppresses later loads and effects.
int classify(const int* input, unsigned index, unsigned length, int* trace,
             unsigned position) {
  if (index >= length) {
    trace[position] = 1;
    return -7;
  }
  int value = input[index];
  trace[position] = 2;
  if (value < 0) {
    return -value;
  }
  if (value == 0) {
    trace[position] = 3;
    return 3;
  }
  return value + 4;
}
// ----
func.def public @classify(%input: buffer, %input_byte_offset: index, %index: i32, %length: i32, %trace: buffer, %trace_byte_offset: index, %position: i32) -> (i32) {
  %8 = scalar.cmpi uge, %index, %length : i32
  %9 = scf.if %8 -> (i32) {
    %10 = scalar.constant 1 : i32
    %11 = scalar.extui %position : i32 to i64
    %12 = index.cast %11 : i64 to index
    %13 = index.constant 4 : index
    %14 = index.mul %12, %13 : index
    %15 = index.add %trace_byte_offset, %14 : index
    %16 = buffer.view %trace[%15] : buffer -> view<1xi32>
    view.store<root_in_bounds|type_disjoint> %10, %16[0] : i32, view<1xi32>
    %17 = scalar.constant 7 : i32
    %18 = scalar.constant 0 : i32
    %19 = scalar.subi %18, %17 : i32
    scf.yield %19 : i32
  } else {
    %20 = scalar.extui %index : i32 to i64
    %21 = index.cast %20 : i64 to index
    %22 = index.constant 4 : index
    %23 = index.mul %21, %22 : index
    %24 = index.add %input_byte_offset, %23 : index
    %25 = buffer.view %input[%24] : buffer -> view<1xi32>
    %value = view.load<root_in_bounds|type_disjoint> %25[0] : view<1xi32> -> i32
    %27 = scalar.constant 2 : i32
    %28 = scalar.extui %position : i32 to i64
    %29 = index.cast %28 : i64 to index
    %30 = index.constant 4 : index
    %31 = index.mul %29, %30 : index
    %32 = index.add %trace_byte_offset, %31 : index
    %33 = buffer.view %trace[%32] : buffer -> view<1xi32>
    view.store<root_in_bounds|type_disjoint> %27, %33[0] : i32, view<1xi32>
    %34 = scalar.constant 0 : i32
    %35 = scalar.cmpi slt, %value, %34 : i32
    %36 = scf.if %35 -> (i32) {
      %37 = scalar.constant 0 : i32
      %38 = scalar.subi %37, %value : i32
      scf.yield %38 : i32
    } else {
      %39 = scalar.constant 0 : i32
      %40 = scalar.cmpi eq, %value, %39 : i32
      %41 = scf.if %40 -> (i32) {
        %42 = scalar.constant 3 : i32
        %43 = scalar.extui %position : i32 to i64
        %44 = index.cast %43 : i64 to index
        %45 = index.constant 4 : index
        %46 = index.mul %44, %45 : index
        %47 = index.add %trace_byte_offset, %46 : index
        %48 = buffer.view %trace[%47] : buffer -> view<1xi32>
        view.store<root_in_bounds|type_disjoint> %42, %48[0] : i32, view<1xi32>
        %49 = scalar.constant 3 : i32
        scf.yield %49 : i32
      } else {
        %50 = scalar.constant 4 : i32
        %51 = scalar.addi %value, %50 : i32
        scf.yield %51 : i32
      }
      scf.yield %41 : i32
    }
    scf.yield %36 : i32
  }
  func.return %9 : i32
}
