// ====
// A nonfallthrough loop remains lexical after an earlier return.
int early_then_forever(const int* values, int count) {
  if (values[0] > 9) return -2;
  int index = 0;
  for (;;) {
    if (values[index] < 0) return index;
    ++index;
    if (index >= count) return -1;
  }
}

