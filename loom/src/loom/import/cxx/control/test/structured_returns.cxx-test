  %7 = index.constant 1 : index
  scf.for %index = [%5 to %6 step %7] {
    %9 = index.cast %index : index to i32
    %10 = index.cast %9 : i32 to index
    %11 = index.constant 8 : index
    %12 = index.mul %10, %11 : index
    %13 = index.add %values_byte_offset, %12 : index
    %14 = buffer.view %values[%13] : buffer -> view<1xf64>
    %15 = view.load<root_in_bounds|type_disjoint> %14[0] : view<1xf64> -> f64
    %16 = scalar.constant 0.0 : f64
    %17 = scalar.cmpf olt, %15, %16 : f64
    scf.if %17 {
      %18 = scalar.constant 1 : i1
      func.exit %18 : i1 {
        func.return %9 : i32
      }
    }
  }
  %19 = scalar.constant 1 : i32
  %20 = scalar.constant 0 : i32
  %21 = scalar.subi %20, %19 : i32
  func.return %21 : i32
}

// ====
// Post-test loops preserve a taken exit and the mutated fallthrough value.
int post_test(int value) {
  do {
    if (value == 0) return 7;
    --value;
  } while (value > 0);
  return value;
}

