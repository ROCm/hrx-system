int early_then_two_loops(int first_limit, int second_limit, int selected) {
  if (selected < 0) return -2;
  for (int index = 0; index < first_limit; ++index) {
    if (index == selected) return index;
  }
  for (int index = 0; index < second_limit; ++index) {
    if (index + first_limit == selected) return index + first_limit;
  }
  return -1;
}

// ----
func.def public @early_then_two_loops(%first_limit: i32, %second_limit: i32, %selected: i32) -> (i32) {
  %4 = scalar.constant 0 : i32
  %5 = scalar.cmpi slt, %selected, %4 : i32
  scf.if %5 {
    %6 = scalar.constant 2 : i32
    %7 = scalar.constant 0 : i32
    %8 = scalar.subi %7, %6 : i32
    %9 = scalar.constant 1 : i1
    func.exit %9 : i1 {
      func.return %8 : i32
    }
  }
  %index$10 = scalar.constant 0 : i32
  %11 = index.cast %index$10 : i32 to index
  %12 = index.cast %first_limit : i32 to index
  %13 = index.constant 1 : index
  scf.for %index = [%11 to %12 step %13] {
    %15 = index.cast %index : index to i32
    %16 = scalar.cmpi eq, %15, %selected : i32
    scf.if %16 {
      %17 = scalar.constant 1 : i1
      func.exit %17 : i1 {
        func.return %15 : i32
      }
    }
  }
  %index$18 = scalar.constant 0 : i32
  %19 = index.cast %index$18 : i32 to index
  %20 = index.cast %second_limit : i32 to index
  %21 = index.constant 1 : index
  scf.for %index = [%19 to %20 step %21] {
    %23 = index.cast %index : index to i32
    %24 = scalar.addi %23, %first_limit : i32
    %25 = scalar.cmpi eq, %24, %selected : i32
    scf.if %25 {
      %26 = scalar.addi %23, %first_limit : i32
      %27 = scalar.constant 1 : i1
      func.exit %27 : i1 {
        func.return %26 : i32
      }
    }
  }
  %28 = scalar.constant 1 : i32
  %29 = scalar.constant 0 : i32
  %30 = scalar.subi %29, %28 : i32
  func.return %30 : i32
}

// ====
// A helper return exits two nested counted loops without a source-level flag.
bool nested_matrix_finite(const double* values) {
  for (int row = 0; row < 4; ++row) {
    for (int column = 0; column < 4; ++column) {
      double value = values[row * 4 + column];
      if (value != value) return false;
    }
  }
  return true;
}

// ----
func.def public @nested_matrix_finite(%values: buffer, %values_byte_offset: offset) -> (i1) {
  %row = scalar.constant 0 : i32
  %4 = index.cast %row : i32 to index
  %5 = scalar.constant 4 : i32
  %6 = index.cast %5 : i32 to index
  %7 = index.constant 1 : index
  scf.for %row = [%4 to %6 step %7] {
    %9 = index.cast %row : index to i32
    %column = scalar.constant 0 : i32
    %11 = index.cast %column : i32 to index
    %12 = scalar.constant 4 : i32
    %13 = index.cast %12 : i32 to index
    %14 = index.constant 1 : index
    scf.for %column = [%11 to %13 step %14] {
      %16 = index.cast %column : index to i32
      %17 = scalar.constant 4 : i32
      %18 = scalar.muli %9, %17 : i32
      %19 = scalar.addi %18, %16 : i32
      %20 = scalar.extsi %19 : i32 to i64
      %21 = scalar.constant 8 : i64
      %22 = scalar.muli %20, %21 : i64
      %23 = index.cast %values_byte_offset : offset to i64
      %24 = scalar.addi %23, %22 : i64
      %25 = scalar.assume %24 [range(%24, 0, 9223372036854775807)] : i64
      %26 = index.cast %25 : i64 to offset
      %27 = buffer.view %values[%26] : buffer -> view<1xf64>
      %value = view.load %27[0] : view<1xf64> -> f64
      %29 = scalar.cmpf une, %value, %value : f64
      scf.if %29 {
        %30 = scalar.constant 0 : i1
        %31 = scalar.constant 1 : i1
        func.exit %31 : i1 {
          func.return %30 : i1
        }
      }
    }
  }
  %32 = scalar.constant 1 : i1
  func.return %32 : i1
}

// ====
// RUN: roundtrip
// A value-returning exit crosses three runtime loop bounds, including empty axes.
int nested_position(unsigned selected, unsigned planes, unsigned rows,
                    unsigned columns) {
  for (unsigned plane = 0; plane < planes; ++plane) {
    for (unsigned row = 0; row < rows; ++row) {
      for (unsigned column = 0; column < columns; ++column) {
        if (plane * 4u + row * 2u + column == selected) {
          return int(plane * 100u + row * 10u + column);
        }
      }
    }
  }
  return -1;
}
// ----
func.def public @nested_position(%selected: i32, %planes: i32, %rows: i32, %columns: i32) -> (i32) {
  %plane = scalar.constant 0 : i32
  %6 = index.cast %plane : i32 to offset
  %7 = index.cast %planes : i32 to offset
  %8 = index.constant 1 : offset
  scf.for %plane = [%6 to %7 step %8] {
    %10 = index.cast %plane : offset to i32
    %row = scalar.constant 0 : i32
    %12 = index.cast %row : i32 to offset
    %13 = index.cast %rows : i32 to offset
    %14 = index.constant 1 : offset
    scf.for %row = [%12 to %13 step %14] {
      %16 = index.cast %row : offset to i32
      %column = scalar.constant 0 : i32
      %18 = index.cast %column : i32 to offset
      %19 = index.cast %columns : i32 to offset
      %20 = index.constant 1 : offset
      scf.for %column = [%18 to %19 step %20] {
        %22 = index.cast %column : offset to i32
        %23 = scalar.constant 4 : i32
        %24 = scalar.muli %10, %23 : i32
        %25 = scalar.constant 2 : i32
        %26 = scalar.muli %16, %25 : i32
        %27 = scalar.addi %24, %26 : i32
        %28 = scalar.addi %27, %22 : i32
        %29 = scalar.cmpi eq, %28, %selected : i32
        scf.if %29 {
          %30 = scalar.constant 100 : i32
          %31 = scalar.muli %10, %30 : i32
          %32 = scalar.constant 10 : i32
          %33 = scalar.muli %16, %32 : i32
          %34 = scalar.addi %31, %33 : i32
          %35 = scalar.addi %34, %22 : i32
          %36 = scalar.constant 1 : i1
          func.exit %36 : i1 {
            func.return %35 : i32
          }
        }
      }
    }
  }
  %37 = scalar.constant 1 : i32
  %38 = scalar.constant 0 : i32
  %39 = scalar.subi %38, %37 : i32
  func.return %39 : i32
}

// ====
// RUN: roundtrip
// Each early return retains preceding stores and suppresses later loads and effects.
int classify(const int* input, unsigned index, unsigned length, int* trace,
             unsigned position) {
  if (index >= length) {
    trace[position] = 1;
    return -7;
  }
  int value = input[index];
  trace[position] = 2;
  if (value < 0) {
    return -value;
  }
  if (value == 0) {
    trace[position] = 3;
    return 3;
  }
  return value + 4;
}
// ----
func.def public @classify(%input: buffer, %input_byte_offset: offset, %index: i32, %length: i32, %trace: buffer, %trace_byte_offset: offset, %position: i32) -> (i32) {
  %8 = scalar.cmpi uge, %index, %length : i32
  %9 = scf.if %8 -> (i32) {
    %10 = scalar.constant 1 : i32
    %11 = scalar.extui %position : i32 to i64
    %12 = scalar.constant 4 : i64
    %13 = scalar.muli %11, %12 : i64
    %14 = index.cast %trace_byte_offset : offset to i64
    %15 = scalar.addi %14, %13 : i64
    %16 = scalar.assume %15 [range(%15, 0, 9223372036854775807)] : i64
    %17 = index.cast %16 : i64 to offset
    %18 = buffer.view %trace[%17] : buffer -> view<1xi32>
    view.store %10, %18[0] : i32, view<1xi32>
    %19 = scalar.constant 7 : i32
    %20 = scalar.constant 0 : i32
    %21 = scalar.subi %20, %19 : i32
    scf.yield %21 : i32
  } else {
    %22 = scalar.extui %index : i32 to i64
    %23 = scalar.constant 4 : i64
    %24 = scalar.muli %22, %23 : i64
    %25 = index.cast %input_byte_offset : offset to i64
    %26 = scalar.addi %25, %24 : i64
    %27 = scalar.assume %26 [range(%26, 0, 9223372036854775807)] : i64
    %28 = index.cast %27 : i64 to offset
    %29 = buffer.view %input[%28] : buffer -> view<1xi32>
    %value = view.load %29[0] : view<1xi32> -> i32
    %31 = scalar.constant 2 : i32
    %32 = scalar.extui %position : i32 to i64
    %33 = scalar.constant 4 : i64
    %34 = scalar.muli %32, %33 : i64
    %35 = index.cast %trace_byte_offset : offset to i64
    %36 = scalar.addi %35, %34 : i64
    %37 = scalar.assume %36 [range(%36, 0, 9223372036854775807)] : i64
    %38 = index.cast %37 : i64 to offset
    %39 = buffer.view %trace[%38] : buffer -> view<1xi32>
    view.store %31, %39[0] : i32, view<1xi32>
    %40 = scalar.constant 0 : i32
    %41 = scalar.cmpi slt, %value, %40 : i32
    %42 = scf.if %41 -> (i32) {
      %43 = scalar.constant 0 : i32
      %44 = scalar.subi %43, %value : i32
      scf.yield %44 : i32
    } else {
      %45 = scalar.constant 0 : i32
      %46 = scalar.cmpi eq, %value, %45 : i32
      %47 = scf.if %46 -> (i32) {
        %48 = scalar.constant 3 : i32
        %49 = scalar.extui %position : i32 to i64
        %50 = scalar.constant 4 : i64
        %51 = scalar.muli %49, %50 : i64
        %52 = index.cast %trace_byte_offset : offset to i64
        %53 = scalar.addi %52, %51 : i64
        %54 = scalar.assume %53 [range(%53, 0, 9223372036854775807)] : i64
        %55 = index.cast %54 : i64 to offset
        %56 = buffer.view %trace[%55] : buffer -> view<1xi32>
        view.store %48, %56[0] : i32, view<1xi32>
        %57 = scalar.constant 3 : i32
        scf.yield %57 : i32
      } else {
        %58 = scalar.constant 4 : i32
        %59 = scalar.addi %value, %58 : i32
        scf.yield %59 : i32
      }
      scf.yield %47 : i32
    }
    scf.yield %42 : i32
  }
  func.return %9 : i32
}
