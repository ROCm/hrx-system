// RUN: roundtrip
// Local arrays retain their bounded source type and one-past-end iteration.
#include <loomcxx/kernel.h>

[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void k(int* out, int a, int b, int c) {
  int values[3] = {a, b, c};
  int sum = 0;
  for (int v : values) sum += v;
  out[0] = sum;
}

// ----
kernel.def @k() {
  %4 = index.constant 1 : index
  %5 = index.constant 1 : index
  %6 = index.constant 1 : index
  %7 = index.constant 1 : index
  %8 = index.constant 1 : index
  %9 = index.constant 1 : index
  kernel.launch.config workgroups(%4, %5, %6) workgroup_size(%7, %8, %9) : index
} launch(%out: buffer, %a: i32, %b: i32, %c: i32) {
  %out_byte_offset = index.constant 0 : index
  %11 = index.constant 12 : offset
  %values_storage = buffer.alloca<private> align(4) %11 : buffer
  %values_storage_byte_offset = index.constant 0 : index
  %values_view = buffer.view %values_storage[%values_storage_byte_offset] : buffer -> view<3xi32>
  %15 = index.constant 0 : index
  view.store<type_disjoint> %a, %values_view[%15] : i32, view<3xi32>
  %16 = index.constant 1 : index
  view.store<type_disjoint> %b, %values_view[%16] : i32, view<3xi32>
  %17 = index.constant 2 : index
  view.store<type_disjoint> %c, %values_view[%17] : i32, view<3xi32>
  %sum$18 = scalar.constant 0 : i32
  %19 = scalar.constant 3 : i64
  %20 = index.cast %19 : i64 to index
  %21 = index.constant 4 : index
  %22 = index.mul %20, %21 : index
  %_byte_offset$23 = index.add %values_storage_byte_offset, %22 : index
  %sum$30, %31, %_byte_offset$32 = scf.while(%sum = %sum$18 : i32, %25 = %values_storage : buffer, %_byte_offset = %values_storage_byte_offset : index) -> (i32, buffer, index) {
    %33 = buffer.compare.address ne, %25[%_byte_offset], %values_storage[%_byte_offset$23]
    scf.condition %33, %sum, %25, %_byte_offset : i1, i32, buffer, index
  } do(%sum$27: i32, %28: buffer, %_byte_offset$29: index) {
    %34 = buffer.view %28[%_byte_offset$29] : buffer -> view<1xi32>
    %v = view.load<root_in_bounds|type_disjoint> %34[0] : view<1xi32> -> i32
    %sum$36 = scalar.addi %sum$27, %v : i32
    %37 = scalar.constant 1 : i32
    %38 = index.cast %37 : i32 to index
    %39 = index.constant 4 : index
    %40 = index.mul %38, %39 : index
    %_byte_offset$41 = index.add %_byte_offset$29, %40 : index
    scf.yield %sum$36, %28, %_byte_offset$41 : i32, buffer, index
  }
  %42 = scalar.constant 0 : i32
  %43 = index.cast %42 : i32 to index
  %44 = index.constant 4 : index
  %45 = index.mul %43, %44 : index
  %46 = index.add %out_byte_offset, %45 : index
  %47 = buffer.view %out[%46] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %sum$30, %47[0] : i32, view<1xi32>
  kernel.return
}

// ====
// A user iterator carries ordinary mutable values through the loop.
#include <loomcxx/kernel.h>

struct Range {
  struct iterator {
    long i;
    long operator*() const { return i; }
    void operator++() { ++i; }
    bool operator!=(const iterator& o) const { return i != o.i; }
  };
  long n;
  iterator begin() const { return {0}; }
  iterator end() const { return {n}; }
};

[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void k(long* out, long n) {
  long sum = 0;
  for (long i : Range{n}) sum += i;
  out[0] = sum;
}

// ----
kernel.def @k() {
  %2 = index.constant 1 : index
  %3 = index.constant 1 : index
  %4 = index.constant 1 : index
  %5 = index.constant 1 : index
  %6 = index.constant 1 : index
  %7 = index.constant 1 : index
  kernel.launch.config workgroups(%2, %3, %4) workgroup_size(%5, %6, %7) : index
} launch(%out: buffer, %n: i64) {
  %out_byte_offset = index.constant 0 : index
  %9 = scalar.constant 0 : i32
  %sum$10 = scalar.extsi %9 : i32 to i64
  %11 = index.constant 8 : offset
  %12 = buffer.alloca<private> align(8) %11 : buffer
  %13 = index.constant 0 : index
  %14 = buffer.view %12[%13] : buffer -> view<8xi8>
  %15 = index.constant 0 : index
  %16 = index.add %13, %15 : index
  %17 = index.assume %16 [range(%16, 0, 0)] : index
  %18 = buffer.view %12[%17] : buffer -> view<1xi64>
  view.store<type_disjoint> %n, %18[0] : i64, view<1xi64>
  %_i$19 = func.call pure @Range__begin_storage(%12, %13) : (buffer, index) -> (i64)
  %_i$20 = func.call readonly @Range__end_storage(%12, %13) : (buffer, index) -> (i64)
  %sum$25, %_i$26 = scf.while(%sum = %sum$10 : i64, %_i = %_i$19 : i64) -> (i64, i64) {
    %27 = func.call pure @Range__iterator__operator_not_equal_value(%_i, %_i$20) : (i64, i64) -> (i1)
    scf.condition %27, %sum, %_i : i1, i64, i64
  } do(%sum$23: i64, %_i$24: i64) {
    %i = func.call pure @Range__iterator__operator_dereference_value(%_i$24) : (i64) -> (i64)
    %sum$29 = scalar.addi %sum$23, %i : i64
    %_i$30 = func.call pure @Range__iterator__operator_pre_increment_value(%_i$24) : (i64) -> (i64)
    scf.yield %sum$29, %_i$30 : i64, i64
  }
  %31 = scalar.constant 0 : i32
  %32 = index.cast %31 : i32 to index
  %33 = index.constant 8 : index
  %34 = index.mul %32, %33 : index
  %35 = index.add %out_byte_offset, %34 : index
  %36 = buffer.view %out[%35] : buffer -> view<1xi64>
  view.store<root_in_bounds|type_disjoint> %sum$25, %36[0] : i64, view<1xi64>
  kernel.return
}

func.def @Range__begin_storage(%this: buffer, %this_byte_offset: index) -> (i64) {
  %40 = scalar.constant 0 : i32
  %41 = scalar.extsi %40 : i32 to i64
  func.return %41 : i64
}

func.def @Range__end_storage(%this: buffer, %this_byte_offset: index) -> (i64) {
  %45 = index.constant 0 : index
  %46 = index.add %this_byte_offset, %45 : index
  %47 = buffer.view %this[%46] : buffer -> view<1xi64>
  %n = view.load<root_in_bounds|type_disjoint> %47[0] : view<1xi64> -> i64
  func.return %n : i64
}

func.def @Range__iterator__operator_not_equal_value(%this_i: i64, %o_i: i64) -> (i1) {
  %52 = scalar.cmpi ne, %this_i, %o_i : i64
  func.return %52 : i1
}

func.def @Range__iterator__operator_dereference_value(%this_i: i64) -> (i64) {
  func.return %this_i : i64
}

func.def @Range__iterator__operator_pre_increment_value(%this_i: i64) -> (i64) {
  %57 = scalar.constant 1 : i64
  %i = scalar.addi %this_i, %57 : i64
  func.return %i : i64
}
