// RUN: roundtrip
// Local arrays retain their bounded source type and one-past-end iteration.
#include <loomcxx/kernel.h>

[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void k(int* out, int a, int b, int c) {
  int values[3] = {a, b, c};
  int sum = 0;
  for (int v : values) sum += v;
  out[0] = sum;
}

// ----
kernel.def @k() {
  %4 = index.constant 1 : index
  %5 = index.constant 1 : index
  %6 = index.constant 1 : index
  %7 = index.constant 1 : index
  %8 = index.constant 1 : index
  %9 = index.constant 1 : index
  kernel.launch.config workgroups(%4, %5, %6) workgroup_size(%7, %8, %9) : index
} launch(%out: buffer, %a: i32, %b: i32, %c: i32) {
  %out_byte_offset = index.constant 0 : offset
  %11 = index.constant 12 : offset
  %values_storage = buffer.alloca<private> align(4) %11 : buffer
  %values_storage_byte_offset = index.constant 0 : offset
  %values_view = buffer.view %values_storage[%values_storage_byte_offset] : buffer -> view<3xi32>
  %15 = index.constant 0 : index
  view.store %a, %values_view[%15] : i32, view<3xi32>
  %16 = index.constant 1 : index
  view.store %b, %values_view[%16] : i32, view<3xi32>
  %17 = index.constant 2 : index
  view.store %c, %values_view[%17] : i32, view<3xi32>
  %sum$18 = scalar.constant 0 : i32
  %19 = scalar.constant 3 : i64
  %20 = scalar.constant 4 : i64
  %21 = scalar.muli %19, %20 : i64
  %22 = index.cast %values_storage_byte_offset : offset to i64
  %23 = scalar.addi %22, %21 : i64
  %24 = scalar.assume %23 [range(%23, 0, 9223372036854775807)] : i64
  %_byte_offset$25 = index.cast %24 : i64 to offset
  %sum$32, %33, %_byte_offset$34 = scf.while(%sum = %sum$18 : i32, %27 = %values_storage : buffer, %_byte_offset = %values_storage_byte_offset : offset) -> (i32, buffer, offset) {
    %35 = buffer.compare.address ne, %27[%_byte_offset], %values_storage[%_byte_offset$25]
    scf.condition %35, %sum, %27, %_byte_offset : i1, i32, buffer, offset
  } do(%sum$29: i32, %30: buffer, %_byte_offset$31: offset) {
    %36 = buffer.view %30[%_byte_offset$31] : buffer -> view<1xi32>
    %v = view.load<root_in_bounds> %36[0] : view<1xi32> -> i32
    %sum$38 = scalar.addi %sum$29, %v : i32
    %39 = scalar.constant 1 : i32
    %40 = scalar.extsi %39 : i32 to i64
    %41 = scalar.constant 4 : i64
    %42 = scalar.muli %40, %41 : i64
    %43 = index.cast %_byte_offset$31 : offset to i64
    %44 = scalar.addi %43, %42 : i64
    %45 = scalar.assume %44 [range(%44, 0, 9223372036854775807)] : i64
    %_byte_offset$46 = index.cast %45 : i64 to offset
    scf.yield %sum$38, %30, %_byte_offset$46 : i32, buffer, offset
  }
  %47 = scalar.constant 0 : i32
  %48 = scalar.extsi %47 : i32 to i64
  %49 = scalar.constant 4 : i64
  %50 = scalar.muli %48, %49 : i64
  %51 = index.cast %out_byte_offset : offset to i64
  %52 = scalar.addi %51, %50 : i64
  %53 = scalar.assume %52 [range(%52, 0, 9223372036854775807)] : i64
  %54 = index.cast %53 : i64 to offset
  %55 = buffer.view %out[%54] : buffer -> view<1xi32>
  view.store<root_in_bounds> %sum$32, %55[0] : i32, view<1xi32>
