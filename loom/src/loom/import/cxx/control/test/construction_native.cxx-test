// ====
// RUN: emit vm-object-lifetime
[[loom::import("lifetime", "event")]] void event(unsigned value);
struct Object {
  // The implicit constructor evaluates this default member initializer.
  unsigned value = 7;
  ~Object() { event(value); }
};
void run() {
  Object value;
  event(value.value);
}

