// ====
// RUN: emit vm-object-lifetime
[[loom::import("lifetime", "event")]] void event(unsigned value);
[[loom::noinline]] static void trial(unsigned count) {
  unsigned value;
  unsigned index = 0;
  do {
    if (index == 0) {
      value = 7;
    } else {
      ++value;
    }
    ++index;
  } while (index < count);
  event(value);
}
void run() {
  trial(1);
  trial(3);
}

