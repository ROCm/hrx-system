// RUN: emit vm-object-lifetime
[[loom::import("lifetime", "event")]] void event(unsigned value);
[[loom::noinline]] static void trial(bool enabled) {
  unsigned value;
  if (enabled) {
    value = 7;
  }
  if (enabled) {
    event(value);
  }
}
void run() {
  trial(false);
  trial(true);
}

// ----
event 7
OK 0
retired 0

// ====
// RUN: emit vm-object-lifetime
[[loom::import("lifetime", "event")]] void event(unsigned value);
struct Partial {
  // Remains uninitialized and is never observed.
  unsigned unused;
  // The destructor reads only this initialized field.
  unsigned last;
  ~Partial() { event(last); }
};
void run() {
  Partial value;
  value.last = 7;
}

// ----
event 7
