// ====
// RUN: emit vm-object-lifetime
[[loom::import("lifetime", "event")]] void event(unsigned value);
struct Object {
  // The explicit constructor initializes this before its observable body.
  unsigned value;
  Object() : value(7) { event(1); }
  ~Object() { event(value); }
};
void run() {
  Object value;
  event(value.value);
}

