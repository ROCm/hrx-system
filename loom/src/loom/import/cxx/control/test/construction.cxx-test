// ====
// RUN: emit vm-object-lifetime
// A dynamic view is one construction group even though its extent and payload
// occupy separate SSA values. Replacing it also replaces its dependent extent.
#include <loomcxx/view.h>
[[loom::import("lifetime", "event")]] void event(unsigned value);
using View = loom::type::view<loom::type::shape<loom::type::dynamic>,
                              const unsigned char>;
struct Slice {
  // Complete view, including the current dynamic extent.
  View data;
  // Scalar independent of the view's dependent group.
  unsigned stamp;
};
[[loom::inline]] static Slice choose(unsigned count) {
  Slice result;
  unsigned index = 0;
  do {
    if (index % 2 == 0) {
      result.data = loom::buffer::view<loom::type::dynamic>(
          loom::buffer::constant("\x16\x17"), {2});
      result.stamp = 10;
    } else {
      result.data = loom::buffer::view<loom::type::dynamic>(
          loom::buffer::constant("\x21\x22\x23"), {3});
      result.stamp = 20;
    }
    ++index;
  } while (index < count);
  return result;
}
void run() {
  auto first = choose(1);
  auto second = choose(4);
  event(loom::view::load(first.data, 0));
  event(first.stamp);
  event(loom::view::load(second.data, 0));
  event(second.stamp);
}

