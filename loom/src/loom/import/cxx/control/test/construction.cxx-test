// RUN: emit vm-object-lifetime
// Declared semantic values become ordinary SSA only after construction. Each
// control edge carries complete source subobjects, including dependent groups.
#include <loomcxx/view.h>
[[loom::import("lifetime", "event")]] void event(unsigned value);
using Buffer = loom::type::buffer<const unsigned char>;
struct Packet {
  // Independently initialized resource handle.
  Buffer data;
  // State that may exist before the resource is selected.
  unsigned position;
};
struct Marker {
  // Cleanup event identifying this scope.
  unsigned value;
  ~Marker() { event(value); }
};
[[loom::noinline]] static unsigned first_byte(Buffer data) {
  return loom::view::load(loom::buffer::view<1>(data, {}), 0);
}
[[loom::noinline]] static Packet select(Buffer first, Buffer second,
                                        bool choose) {
  Packet result;
  if (choose) {
    result.data = first;
  } else {
    result.data = second;
  }
  result.position = 4;
  return result;
}
[[loom::noinline]] static Packet iterate(Buffer first, Buffer second,
                                         unsigned count, bool stop) {
  Marker outer{90};
  Packet result;
  result.position = 7;
  unsigned iteration = 0;
  do {
    Marker inner{80};
    event(result.position);
    if (iteration & 1) {
      result.data = second;
    } else {
      result.data = first;
    }
    ++result.position;
    ++iteration;
    if (stop && iteration == 2) {
      break;
    }
    if (iteration < 3) {
      continue;
    }
    event(70);
  } while (iteration < count);
  return result;
}
[[loom::noinline]] static Buffer early(Buffer first, Buffer second, bool exit) {
  Marker outer{60};
  Buffer result;
  unsigned iteration = 0;
  do {
    Marker inner{50};
    if (exit && iteration == 1) {
      return first;
    }
    result = second;
    ++iteration;
  } while (iteration < 2);
  return result;
}
[[loom::noinline]] static Buffer switch_value(Buffer first, Buffer second,
                                              unsigned choice) {
  Buffer result;
  switch (choice) {
    case 0:
      result = first;
      break;
    case 1:
      result = second;
      break;
    default:
      result = first;
      break;
  }
  return result;
}
[[loom::noinline]] static Buffer conditional(Buffer first, Buffer second,
                                             bool choose) {
  Buffer result;
  choose ? (result = first) : (result = second);
  return result;
}
void run() {
  auto first = loom::buffer::root(loom::buffer::constant("\x16"));
  auto second = loom::buffer::root(loom::buffer::constant("\x21"));
  auto a = select(first, second, true);
  auto snapshot = a;
  a.data = second;
  event(first_byte(snapshot.data));
  event(first_byte(a.data));
  event(snapshot.position);
  auto b = select(first, second, false);
  event(first_byte(b.data));
  auto one = iterate(first, second, 1, false);
  event(first_byte(one.data));
  event(one.position);
  auto many = iterate(first, second, 3, false);
  event(first_byte(many.data));
  event(many.position);
  auto stopped = iterate(first, second, 4, true);
  event(first_byte(stopped.data));
  event(stopped.position);
  event(first_byte(early(first, second, true)));
  event(first_byte(early(first, second, false)));
  event(first_byte(switch_value(first, second, 0)));
  event(first_byte(switch_value(first, second, 1)));
  event(first_byte(switch_value(first, second, 2)));
  event(first_byte(conditional(first, second, true)));
  event(first_byte(conditional(first, second, false)));
}

