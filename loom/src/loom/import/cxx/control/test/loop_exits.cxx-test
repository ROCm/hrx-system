// ====
// RUN: roundtrip
// A while break suppresses the next source-condition evaluation while a
// continue still reaches it.
unsigned entry(unsigned count, unsigned stop) {
  unsigned checked = 0;
  unsigned total = 0;
  while (checked++ < count) {
    if (checked == stop) {
      break;
    }
    if (checked & 1u) {
      continue;
    }
    total += checked;
  }
  return checked * 100u + total;
}
