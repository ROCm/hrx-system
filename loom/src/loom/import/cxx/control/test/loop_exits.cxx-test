// ====
// RUN: roundtrip
// Continue executes the for step, including a step separate from the condition update.
unsigned continue_for_step(unsigned count, unsigned choose) {
  unsigned index = 0;
  unsigned steps = 0;
  unsigned total = 0;
  for (; index++ < count; ++steps) {
    if ((index & choose) != 0u) {
      continue;
    }
    total += index;
  }
  return total + steps * 257u + index * 65537u;
}
