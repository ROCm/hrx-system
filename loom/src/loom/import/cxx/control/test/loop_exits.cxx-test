// ====
// RUN: roundtrip
// An omitted for condition is true. Continue still executes the source step,
// while break suppresses it; an unbroken form remains an explicit infinite
// structured loop.
unsigned staged(unsigned tail) {
  unsigned total = 0;
  for (unsigned stage = 0;; ++stage) {
    if (stage < 2u) {
      total += stage;
      continue;
    }
    total += tail;
    break;
  }
  return total;
}
void spin(volatile unsigned* value) {
  for (;;) ++*value;
}
