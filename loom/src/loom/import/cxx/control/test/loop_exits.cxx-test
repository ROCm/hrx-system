// ====
// RUN: roundtrip
// A reverse walk returns the decremented position and carry at the taken break.
struct Prefix {
  // Sum accumulated through the terminating predecessor.
  unsigned carry;
  // Index of the last visited predecessor.
  unsigned previous;
  // Number of predecessors observed.
  unsigned visits;
};
Prefix lookback(unsigned group, const unsigned* states,
                const unsigned* aggregates, const unsigned* prefixes) {
  Prefix result{0, group, 0};
  while (result.previous > 0) {
    --result.previous;
    unsigned state = states[result.previous];
    unsigned value = 0;
    if (state == 1u) value = aggregates[result.previous];
    if (state == 2u) value = prefixes[result.previous];
    result.carry = value + result.carry;
    ++result.visits;
    if (state == 2u) break;
  }
  return result;
}
