// RUN: roundtrip
// Continue retains counted schedules and conditional loop regions.
unsigned entry(const unsigned* input, unsigned count, unsigned choose) {
  unsigned total = 0;
  [[loom::unroll(3), loom::pipeline(2)]]
  for (unsigned index = 0; index < count; ++index) {
    if (index & choose) {
      continue;
    }
    total += input[index];
  }
  unsigned index = 0;
  while (index++ < count) {
    if (index & choose) {
      continue;
    }
    total += index;
  }
  do {
    if (index & choose) {
      continue;
    }
    total += index;
  } while (++index < count);
  return total;
}
