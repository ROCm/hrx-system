// RUN: roundtrip
// Breaking from a declaration condition skips its next initialization.
unsigned entry(unsigned count, unsigned stop) {
  unsigned checks = 0;
  unsigned total = 0;
  while (unsigned value = (++checks, count--)) {
    total += value;
    if (value == stop) {
      break;
    }
  }
  return total + checks * 100u + count;
}
