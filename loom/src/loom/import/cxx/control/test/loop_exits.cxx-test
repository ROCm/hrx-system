// ====
// RUN: roundtrip
// The vector recurrence is preserved on both iteration exits.
using Words4 = unsigned __attribute__((vector_size(16)));
Words4 update_vector(Words4 value, unsigned count, unsigned choose) {
  for (unsigned index = 0; index < count; ++index) {
    value += Words4{index, index * 2u, index * 3u, index * 4u};
    if ((index & choose) != 0u) continue;
    value ^= Words4{17u, 31u, 63u, 127u};
  }
  return value;
}
