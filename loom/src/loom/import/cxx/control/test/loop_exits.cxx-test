// RUN: roundtrip
// Each continue edge carries exactly the pointer origins advanced before it.
unsigned select_values(const unsigned* input, unsigned* output,
                       unsigned length, unsigned choose) {
  const unsigned* cursor = input;
  unsigned* result = output;
  unsigned stored = 0;
  for (unsigned index = 0; index < 33u; ++index) {
    if (index >= length) continue;
    unsigned value = *cursor++;
    if ((value & choose) == 0u) continue;
    *result++ = value;
    ++stored;
  }
  return stored;
}
