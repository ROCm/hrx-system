// ====
// RUN: roundtrip
// Both conditional arms may continue; their shared tail executes only on fallthrough.
unsigned continue_branches(unsigned count, unsigned choose) {
  unsigned total = 0;
  for (unsigned index = 0; index < count; ++index) {
    ++total;
    if ((index & choose) != 0u) {
      total += 2u;
      if ((index & 2u) != 0u) {
        continue;
      }
      total += 4u;
    } else {
      total += 8u;
      if ((index & 4u) != 0u) {
        continue;
      }
      total += 16u;
    }
    total += 32u + index;
  }
  return total;
}
