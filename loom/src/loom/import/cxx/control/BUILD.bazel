load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test")
load("//loom/src/loom/import/cxx:build_defs.bzl", "CXX_COMPILER_OPTIONS")

package(
    default_visibility = ["//loom/src/loom/import/cxx:__subpackages__"],
    features = ["layering_check"],
    licenses = ["notice"],
)

loom_cc_library(
    name = "construction",
    srcs = ["construction.cc"],
    hdrs = ["construction.h"],
    cxx_features = CXX_COMPILER_OPTIONS["cxx_features"],
    cxx_standard = CXX_COMPILER_OPTIONS["cxx_standard"],
    deps = ["//third_party:cxx_parser"],
)

loom_cc_test(
    name = "construction_test",
    srcs = ["construction_test.cc"],
    cxx_features = CXX_COMPILER_OPTIONS["cxx_features"],
    cxx_standard = CXX_COMPILER_OPTIONS["cxx_standard"],
    deps = [
        ":construction",
        "//loom/src/loom/import/cxx/source",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
        "//third_party:cxx_parser",
    ],
)

loom_cc_library(
    name = "regions",
    srcs = ["regions.cc"],
    hdrs = ["regions.h"],
    cxx_features = CXX_COMPILER_OPTIONS["cxx_features"],
    cxx_standard = CXX_COMPILER_OPTIONS["cxx_standard"],
    deps = [
        "//loom/src/loom/import/cxx/source:error",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:builders",
        "//loom/src/loom/ops/scf",
    ],
)

loom_cc_library(
    name = "analysis",
    srcs = ["analysis.cc"],
    hdrs = ["analysis.h"],
    cxx_features = CXX_COMPILER_OPTIONS["cxx_features"],
    cxx_standard = CXX_COMPILER_OPTIONS["cxx_standard"],
    deps = [
        ":construction",
        "//loom/src/loom/import/cxx/lifetime:destruction",
        "//loom/src/loom/import/cxx/lifetime:origins",
        "//loom/src/loom/import/cxx/source",
        "//loom/src/loom/import/cxx/source:attributes",
        "//loom/src/loom/import/cxx/source:constants",
        "//loom/src/loom/import/cxx/source:expressions",
        "//loom/src/loom/import/cxx/source:objects",
        "//loom/src/loom/import/cxx/value:bindings",
        "//loom/src/loom/import/cxx/value:types",
        "//third_party:cxx_parser",
    ],
)

loom_cc_test(
    name = "analysis_test",
    srcs = ["analysis_test.cc"],
    cxx_features = CXX_COMPILER_OPTIONS["cxx_features"],
    cxx_standard = CXX_COMPILER_OPTIONS["cxx_standard"],
    deps = [
        ":analysis",
        "//loom/src/loom/import/cxx/source",
        "//loom/src/loom/import/cxx/source:expressions",
        "//loom/src/loom/import/cxx/source:options",
        "//loom/src/loom/import/cxx/value:types",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
        "//third_party:cxx_parser",
    ],
)
