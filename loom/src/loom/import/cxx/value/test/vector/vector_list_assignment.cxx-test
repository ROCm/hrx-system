// ====
using Int4 = int __attribute__((ext_vector_type(4)));
static constexpr Int4 first_two(int first, int second) {
  Int4 value{};
  value = {first, second};
  return value;
}
static constexpr Int4 identity(Int4 value) { return value; }
static constexpr int sum(Int4 value) {
  return value[0] + value[1] + value[2] + value[3];
}
static_assert(sum({1, 2, 3, 4}) == 10);
static_assert(sum({7}) == 7);
static_assert(sum({}) == 0);
static_assert(first_two(7, 9)[3] == 0);
Int4 entry(int first) { return identity({first, 9}); }

// ----
func.def public @entry(%first: i32) -> (vector<4xi32>) {
  %2 = vector.constanti [0, 9, 0, 0] : vector<4xi32>
  %3 = vector.insert %first into %2[0] : i32, vector<4xi32>
  %4 = func.call pure @identity(%3) : (vector<4xi32>) -> (vector<4xi32>)
  func.return %4 : vector<4xi32>
}

func.def @identity(%value: vector<4xi32>) -> (vector<4xi32>) {
  func.return %value : vector<4xi32>
}

// ====
using Int4 = int __attribute__((ext_vector_type(4)));
using Float4 = float __attribute__((ext_vector_type(4)));
static constexpr int choose(Int4 value) { return 1; }
static constexpr int choose(Float4 value) { return 2; }
static_assert(choose({1, 2, 3, 4}) == 1);
static_assert(choose({1.0f, 2.0f, 3.0f, 4.0f}) == 2);
int entry() { return choose({1, 2, 3, 4}); }

// ----
func.def public @entry() -> (i32) {
  %1 = vector.constanti [1, 2, 3, 4] : vector<4xi32>
  %2 = func.call pure @choose(%1) : (vector<4xi32>) -> (i32)
  func.return %2 : i32
}

func.def @choose(%value: vector<4xi32>) -> (i32) {
  %5 = scalar.constant 1 : i32
  func.return %5 : i32
}

// ====
// RUN: roundtrip
// List element calls are sequenced before the effectful assignment destination.
using Words4 = unsigned __attribute__((ext_vector_type(4)));
unsigned record(unsigned* trace, unsigned digit, unsigned value);
Words4* destination(unsigned* trace, Words4* output);
void assign(unsigned first, Words4* output, unsigned* trace) {
  *destination(trace, output) = {
      record(trace, 1, first), record(trace, 2, first + 1u),
      record(trace, 3, first + 2u), record(trace, 4, first + 3u)};
}

// ----
func.def public @assign(%first: i32, %output: buffer, %output_byte_offset: offset, %trace: buffer, %trace_byte_offset: offset) {
  %5 = scalar.constant 1 : i32
  %6 = func.call @record(%trace, %trace_byte_offset, %5, %first) : (buffer, offset, i32, i32) -> (i32)
  %7 = scalar.constant 2 : i32
  %8 = scalar.constant 1 : i32
  %9 = scalar.addi %first, %8 : i32
  %10 = func.call @record(%trace, %trace_byte_offset, %7, %9) : (buffer, offset, i32, i32) -> (i32)
  %11 = scalar.constant 3 : i32
  %12 = scalar.constant 2 : i32
  %13 = scalar.addi %first, %12 : i32
  %14 = func.call @record(%trace, %trace_byte_offset, %11, %13) : (buffer, offset, i32, i32) -> (i32)
  %15 = scalar.constant 4 : i32
  %16 = scalar.constant 3 : i32
  %17 = scalar.addi %first, %16 : i32
  %18 = func.call @record(%trace, %trace_byte_offset, %15, %17) : (buffer, offset, i32, i32) -> (i32)
  %19 = vector.from_elements %6, %10, %14, %18 : vector<4xi32>
  %20, %21 = func.call @destination(%trace, %trace_byte_offset, %output, %output_byte_offset) : (buffer, offset, buffer, offset) -> (buffer, offset)
  %22 = buffer.view %20[%21] : buffer -> view<4xi32>
  vector.store %19, %22[0] : vector<4xi32>, view<4xi32>
  func.return
}

func.decl @record(%23: buffer, %24: offset, %25: i32, %26: i32) -> (i32)

func.decl @destination(%28: buffer, %29: offset, %30: buffer, %31: offset) -> (buffer, offset)

// ====
// RUN: roundtrip
// List assignment converts its first lane and preserves signed zero and tail zero.
using Floats4 = float __attribute__((vector_size(16)));
using Words4 = unsigned __attribute__((vector_size(16)));
Words4 assign(unsigned first) {
  Floats4 values{};
  values = {float(first), -0.0f, 1.5f};
  return __builtin_bit_cast(Words4, values);
}

// ----
func.def public @assign(%first: i32) -> (vector<4xi32>) {
  %values$2 = vector.constantf [0.0, 0.0, 0.0, 0.0] : vector<4xf32>
  %3 = vector.constantf [0.0, -0.0, 1.5, 0.0] : vector<4xf32>
  %4 = scalar.uitofp %first : i32 to f32
  %values$5 = vector.insert %4 into %3[0] : f32, vector<4xf32>
  %6 = vector.bitcast %values$5 : vector<4xf32> to vector<4xi32>
  func.return %6 : vector<4xi32>
}

// ====
// RUN: roundtrip
// Narrow explicit conversion and unsigned literal payloads retain four byte lanes.
using Bytes4 = unsigned char __attribute__((ext_vector_type(4)));
Bytes4 assign(unsigned first) {
  Bytes4 values{};
  values = {static_cast<unsigned char>(first), 255u, 128u};
  return values;
}

// ----
func.def public @assign(%first: i32) -> (vector<4xi8>) {
  %values$2 = vector.constanti [0, 0, 0, 0] : vector<4xi8>
  %3 = vector.constanti [0, -1, -128, 0] : vector<4xi8>
  %4 = scalar.trunci %first : i32 to i8
  %values$5 = vector.insert %4 into %3[0] : i8, vector<4xi8>
  func.return %values$5 : vector<4xi8>
}
