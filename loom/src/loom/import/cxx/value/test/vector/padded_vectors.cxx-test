// RUN: roundtrip
using Half3 = _Float16 __attribute__((ext_vector_type(3)));
using BFloat3 = __bf16 __attribute__((ext_vector_type(3)));

static_assert(sizeof(Half3) == 8);
static_assert(sizeof(BFloat3) == 8);

struct BFloatRecord {
  unsigned before;
  BFloat3 value;
  unsigned after;
};
static_assert(sizeof(BFloatRecord) == 24);
static_assert(__builtin_offsetof(BFloatRecord, value) == 8);

static Half3 adjust(Half3 value) {
  return value + Half3{1.0f, 2.0f, 3.0f};
}

BFloat3 convert(Half3 value) {
  return __builtin_convertvector(value, BFloat3);
}

BFloat3 reinterpret_bits(Half3 value) {
  return __builtin_bit_cast(BFloat3, value);
}

BFloat3 record_value(BFloatRecord* records) {
  return records[1].value;
}

Half3 update(Half3* values) {
  Half3 result = adjust(values[0]);
  values[1] = result;
  return values[1];
}

// ----
func.def public @convert(%value: vector<3xf16>) -> (vector<3xbf16>) {
  %2 = vector.extf %value : vector<3xf16> to vector<3xf32>
  %3 = vector.fptrunc %2 : vector<3xf32> to vector<3xbf16>
  func.return %3 : vector<3xbf16>
}

func.def public @reinterpret_bits(%value: vector<3xf16>) -> (vector<3xbf16>) {
  %6 = vector.bitcast %value : vector<3xf16> to vector<3xbf16>
  func.return %6 : vector<3xbf16>
}

func.def public @record_value(%records: buffer, %records_byte_offset: index) -> (vector<3xbf16>) {
  %10 = scalar.constant 1 : i32
  %11 = index.cast %10 : i32 to index
  %12 = index.constant 24 : index
  %13 = index.mul %11, %12 : index
  %14 = index.add %records_byte_offset, %13 : index
  %15 = index.constant 8 : index
  %16 = index.add %14, %15 : index
  %17 = buffer.view %records[%16] : buffer -> view<3xbf16>
  %value = vector.load<root_in_bounds> %17[0] : view<3xbf16> -> vector<3xbf16>
  func.return %value : vector<3xbf16>
}

func.def public @update(%values: buffer, %values_byte_offset: index) -> (vector<3xf16>) {
  %22 = scalar.constant 0 : i32
  %23 = index.cast %22 : i32 to index
  %24 = index.constant 8 : index
  %25 = index.mul %23, %24 : index
  %26 = index.add %values_byte_offset, %25 : index
  %27 = buffer.view %values[%26] : buffer -> view<3xf16>
  %28 = vector.load<root_in_bounds> %27[0] : view<3xf16> -> vector<3xf16>
  %result = func.call pure @adjust(%28) : (vector<3xf16>) -> (vector<3xf16>)
  %30 = scalar.constant 1 : i32
  %31 = index.cast %30 : i32 to index
  %32 = index.constant 8 : index
  %33 = index.mul %31, %32 : index
  %34 = index.add %values_byte_offset, %33 : index
  %35 = buffer.view %values[%34] : buffer -> view<3xf16>
  vector.store<root_in_bounds> %result, %35[0] : vector<3xf16>, view<3xf16>
  %36 = scalar.constant 1 : i32
  %37 = index.cast %36 : i32 to index
  %38 = index.constant 8 : index
  %39 = index.mul %37, %38 : index
  %40 = index.add %values_byte_offset, %39 : index
  %41 = buffer.view %values[%40] : buffer -> view<3xf16>
  %42 = vector.load<root_in_bounds> %41[0] : view<3xf16> -> vector<3xf16>
  func.return %42 : vector<3xf16>
}

func.def @adjust(%value: vector<3xf16>) -> (vector<3xf16>) {
  %45 = vector.constantf [1.0, 2.0, 3.0] : vector<3xf16>
  %46 = vector.addf %value, %45 : vector<3xf16>
  func.return %46 : vector<3xf16>
}

// ====
// RUN: pass canonicalize,cse,dce
// Padded vector arrays use eight-byte object stride but six-byte value access.
using Half3 = _Float16 __attribute__((ext_vector_type(3)));
using Float3 = float __attribute__((ext_vector_type(3)));
Half3 update(unsigned selected) {
  Half3 values[2];
  values[0] = Half3{1.0f, 2.0f, 3.0f};
  values[1] = Half3{4.0f, 5.0f, 6.0f};
  auto* padding = reinterpret_cast<unsigned char*>(&values[0]);
  padding[6] = 0xa5;
  padding[7] = 0x5a;
  Float3 wide = __builtin_convertvector(values[selected], Float3);
  values[1u - selected] = __builtin_convertvector(
      wide + Float3{1.0f, 2.0f, 3.0f}, Half3);
  return values[1u - selected];
}

// ----
func.def public @update(%selected: i32) -> (vector<3xf16>) {
  %2 = index.constant 16 : offset
  %values_storage = buffer.alloca<private> align(8) %2 : buffer
  %6 = vector.constantf [1.0, 2.0, 3.0] : vector<3xf16>
  %81 = index.constant 0 : index
  %13 = buffer.view %values_storage[%81] : buffer -> view<3xf16>
  vector.store %6, %13[0] : vector<3xf16>, view<3xf16>
  %14 = vector.constantf [4.0, 5.0, 6.0] : vector<3xf16>
  %80 = index.constant 8 : index
  %21 = buffer.view %values_storage[%80] : buffer -> view<3xf16>
  vector.store %14, %21[0] : vector<3xf16>, view<3xf16>
  %79 = scalar.constant -91 : i8
  %78 = index.constant 6 : index
  %35 = buffer.view %values_storage[%78] : buffer -> view<1xi8>
  view.store %79, %35[0] : i8, view<1xi8>
  %77 = scalar.constant 90 : i8
  %76 = index.constant 7 : index
  %44 = buffer.view %values_storage[%76] : buffer -> view<1xi8>
  view.store %77, %44[0] : i8, view<1xi8>
  %45 = scalar.extui %selected : i32 to i64
  %46 = index.cast %45 : i64 to index
  %48 = index.mul %46, %80 : index
  %50 = index.assume %48 [range(%48, 0, 8)] : index
  %51 = buffer.view %values_storage[%50] : buffer -> view<3xf16>
  %52 = vector.load %51[0] : view<3xf16> -> vector<3xf16>
  %wide = vector.extf %52 : vector<3xf16> to vector<3xf32>
  %54 = vector.constantf [1.0, 2.0, 3.0] : vector<3xf32>
  %55 = vector.addf %wide, %54 : vector<3xf32>
  %56 = vector.fptrunc %55 : vector<3xf32> to vector<3xf16>
  %57 = scalar.constant 1 : i32
  %58 = scalar.subi %57, %selected : i32
  %59 = scalar.extui %58 : i32 to i64
  %60 = index.cast %59 : i64 to index
  %62 = index.mul %60, %80 : index
  %64 = index.assume %62 [range(%62, 0, 8)] : index
  %65 = buffer.view %values_storage[%64] : buffer -> view<3xf16>
  vector.store %56, %65[0] : vector<3xf16>, view<3xf16>
  %75 = vector.load %65[0] : view<3xf16> -> vector<3xf16>
  func.return %75 : vector<3xf16>
}

// ====
// RUN: pass canonicalize,cse,dce
// Record field offsets stay independent of the padded vector value extent.
using BFloat3 = __bf16 __attribute__((ext_vector_type(3)));
using Float3 = float __attribute__((ext_vector_type(3)));
struct Record {
  // Integer preceding the aligned vector member.
  unsigned before;
  // Three logical elements in an eight-byte object slot.
  BFloat3 value;
  // Integer following the vector object and its padding.
  unsigned after;
};
static_assert(sizeof(Record) == 24 && alignof(Record) == 8);
static_assert(__builtin_offsetof(Record, value) == 8);
static_assert(__builtin_offsetof(Record, after) == 16);
unsigned update(Record* records) {
  records[0].before = 11;
  records[0].after = 13;
  auto* padding = reinterpret_cast<unsigned char*>(&records[0].value);
  padding[6] = 0x3c;
  padding[7] = 0xc3;
  Float3 wide = __builtin_convertvector(records[1].value, Float3);
  records[0].value = __builtin_convertvector(
      wide + Float3{1.0f, 2.0f, 3.0f}, BFloat3);
  return records[0].before + records[0].after + padding[6] + padding[7];
}

// ----
func.def public @update(%records: buffer, %records_byte_offset: index) -> (i32) {
  %3 = scalar.constant 11 : i32
  %11 = buffer.view %records[%records_byte_offset] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %3, %11[0] : i32, view<1xi32>
  %12 = scalar.constant 13 : i32
  %18 = index.constant 16 : index
  %19 = index.add %records_byte_offset, %18 : index
  %20 = buffer.view %records[%19] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %12, %20[0] : i32, view<1xi32>
  %26 = index.constant 8 : index
  %padding_byte_offset = index.add %records_byte_offset, %26 : index
  %116 = scalar.constant 60 : i8
  %115 = index.constant 6 : index
  %114 = index.add %padding_byte_offset, %115 : index
  %35 = buffer.view %records[%114] : buffer -> view<1xi8>
  view.store<root_in_bounds> %116, %35[0] : i8, view<1xi8>
  %112 = scalar.constant -61 : i8
  %111 = index.constant 7 : index
  %110 = index.add %padding_byte_offset, %111 : index
  %43 = buffer.view %records[%110] : buffer -> view<1xi8>
  view.store<root_in_bounds> %112, %43[0] : i8, view<1xi8>
  %108 = index.constant 24 : index
  %48 = index.add %records_byte_offset, %108 : index
  %50 = index.add %48, %26 : index
  %51 = buffer.view %records[%50] : buffer -> view<3xbf16>
  %value = vector.load<root_in_bounds> %51[0] : view<3xbf16> -> vector<3xbf16>
  %wide = vector.extf %value : vector<3xbf16> to vector<3xf32>
  %54 = vector.constantf [1.0, 2.0, 3.0] : vector<3xf32>
  %55 = vector.addf %wide, %54 : vector<3xf32>
  %56 = vector.fptrunc %55 : vector<3xf32> to vector<3xbf16>
  %64 = buffer.view %records[%padding_byte_offset] : buffer -> view<3xbf16>
  vector.store<root_in_bounds> %56, %64[0] : vector<3xbf16>, view<3xbf16>
  %before = view.load<root_in_bounds|type_disjoint> %11[0] : view<1xi32> -> i32
  %after = view.load<root_in_bounds|type_disjoint> %20[0] : view<1xi32> -> i32
  %83 = scalar.addi %before, %after : i32
  %90 = view.load<root_in_bounds> %35[0] : view<1xi8> -> i8
  %91 = scalar.extui %90 : i8 to i32
  %92 = scalar.addi %83, %91 : i32
  %99 = view.load<root_in_bounds> %43[0] : view<1xi8> -> i8
  %100 = scalar.extui %99 : i8 to i32
  %101 = scalar.addi %92, %100 : i32
  func.return %101 : i32
}
