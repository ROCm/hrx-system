// RUN: roundtrip
#include <loomcxx/vector.h>

using Shorts2 = unsigned short __attribute__((ext_vector_type(2)));
using Floats4 = float __attribute__((ext_vector_type(4)));
using Mask4 = signed char __attribute__((ext_vector_type(4)));

Shorts2 load_packet(const unsigned short* input,
                    loom::type::size_type index) {
  auto source = loom::buffer::view<1024>(
      input, {}, loom::encoding::layout::dense<1>());
  return loom::vector::load<Shorts2>(source, {index});
}

void store_row(Floats4 value, float* output, loom::type::size_type row,
               loom::type::size_type column) {
  auto destination = loom::buffer::view<16, 32>(
      output, {}, loom::encoding::layout::dense<2>());
  loom::vector::store(value, destination, {row, column});
}

Floats4 load_dynamic_view(const float* input, loom::type::size_type rows,
                          loom::type::size_type row,
                          loom::type::size_type column) {
  auto source = loom::buffer::view<loom::type::dynamic, 32>(
      input, {rows}, loom::encoding::layout::dense<2>());
  return loom::vector::load<Floats4>(source, {row, column});
}

Floats4 load_volatile(const volatile float* input,
                      loom::type::size_type index) {
  auto source = loom::buffer::view<64>(
      input, {}, loom::encoding::layout::dense<1>());
  return loom::vector::load<Floats4>(source, {index});
}

Floats4 load_masked(const float* input, loom::type::size_type index,
                    Mask4 mask, Floats4 passthrough) {
  auto source = loom::buffer::view<64>(
      input, {}, loom::encoding::layout::dense<1>());
  return loom::vector::load_mask<Floats4>(source, {index}, mask, passthrough);
}

void store_masked(Floats4 value, float* output,
                  loom::type::size_type index, Mask4 mask) {
  auto destination = loom::buffer::view<64>(
      output, {}, loom::encoding::layout::dense<1>());
  loom::vector::store_mask(value, destination, {index}, mask);
}

Floats4 load_expanded(const float* input, loom::type::size_type index,
                      Mask4 mask, Floats4 passthrough) {
  auto source = loom::buffer::view<64>(
      input, {}, loom::encoding::layout::dense<1>());
  return loom::vector::load_expand<Floats4>(source, {index}, mask,
                                            passthrough);
}

void store_compressed(Floats4 value, float* output,
                      loom::type::size_type index, Mask4 mask) {
  auto destination = loom::buffer::view<64>(
      output, {}, loom::encoding::layout::dense<1>());
  loom::vector::store_compress(value, destination, {index}, mask);
}

// ----
func.def public @load_packet(%input: buffer, %input_byte_offset: offset, %index: i64) -> (vector<2xi16>) {
  %source_layout = encoding.layout.dense : encoding<layout>
  %source = buffer.view %input[%input_byte_offset] : buffer -> view<1024xi16, %source_layout>
  %6 = index.cast %index : i64 to index
  %7 = vector.load %source[%6] : view<1024xi16, %source_layout> -> vector<2xi16>
  func.return %7 : vector<2xi16>
}

func.def public @store_row(%value: vector<4xf32>, %output: buffer, %output_byte_offset: offset, %row: i64, %column: i64) {
  %destination_layout = encoding.layout.dense : encoding<layout>
  %destination = buffer.view %output[%output_byte_offset] : buffer -> view<16x32xf32, %destination_layout>
  %15 = index.cast %row : i64 to index
  %16 = index.cast %column : i64 to index
  vector.store %value, %destination[%15, %16] : vector<4xf32>, view<16x32xf32, %destination_layout>
  func.return
}

func.def public @load_dynamic_view(%input: buffer, %input_byte_offset: offset, %rows: i64, %row: i64, %column: i64) -> (vector<4xf32>) {
  %source_layout = encoding.layout.dense : encoding<layout>
  %source_dim0 = index.cast %rows : i64 to index
  %source = buffer.view %input[%input_byte_offset] : buffer -> view<[%source_dim0]x32xf32, %source_layout>
  %26 = index.cast %row : i64 to index
  %27 = index.cast %column : i64 to index
  %28 = vector.load %source[%26, %27] : view<[%source_dim0]x32xf32, %source_layout> -> vector<4xf32>
  func.return %28 : vector<4xf32>
}

func.def public @load_volatile(%input: buffer, %input_byte_offset: offset, %index: i64) -> (vector<4xf32>) {
  %source_layout = encoding.layout.dense : encoding<layout>
  %source = buffer.view %input[%input_byte_offset] : buffer -> view<64xf32, %source_layout>
  %35 = index.cast %index : i64 to index
  %36 = vector.load<volatile> %source[%35] : view<64xf32, %source_layout> -> vector<4xf32>
  func.return %36 : vector<4xf32>
}

func.def public @load_masked(%input: buffer, %input_byte_offset: offset, %index: i64, %mask: vector<4xi8>, %passthrough: vector<4xf32>) -> (vector<4xf32>) {
  %source_layout = encoding.layout.dense : encoding<layout>
  %source = buffer.view %input[%input_byte_offset] : buffer -> view<64xf32, %source_layout>
  %45 = index.cast %index : i64 to index
  %46 = vector.splati 0 : vector<4xi8>
  %47 = vector.cmpi ne, %mask, %46 : vector<4xi8> -> vector<4xi1>
  %48 = vector.load.mask %source[%45], %47, %passthrough : view<64xf32, %source_layout>, vector<4xi1>, vector<4xf32>
  func.return %48 : vector<4xf32>
}

func.def public @store_masked(%value: vector<4xf32>, %output: buffer, %output_byte_offset: offset, %index: i64, %mask: vector<4xi8>) {
  %destination_layout = encoding.layout.dense : encoding<layout>
  %destination = buffer.view %output[%output_byte_offset] : buffer -> view<64xf32, %destination_layout>
  %56 = index.cast %index : i64 to index
  %57 = vector.splati 0 : vector<4xi8>
  %58 = vector.cmpi ne, %mask, %57 : vector<4xi8> -> vector<4xi1>
  vector.store.mask %value, %destination[%56], %58 : vector<4xf32>, view<64xf32, %destination_layout>, vector<4xi1>
  func.return
}

func.def public @load_expanded(%input: buffer, %input_byte_offset: offset, %index: i64, %mask: vector<4xi8>, %passthrough: vector<4xf32>) -> (vector<4xf32>) {
  %source_layout = encoding.layout.dense : encoding<layout>
  %source = buffer.view %input[%input_byte_offset] : buffer -> view<64xf32, %source_layout>
  %67 = index.cast %index : i64 to index
  %68 = vector.splati 0 : vector<4xi8>
  %69 = vector.cmpi ne, %mask, %68 : vector<4xi8> -> vector<4xi1>
  %70 = vector.load.expand %source[%67], %69, %passthrough : view<64xf32, %source_layout>, vector<4xi1>, vector<4xf32>
  func.return %70 : vector<4xf32>
}

func.def public @store_compressed(%value: vector<4xf32>, %output: buffer, %output_byte_offset: offset, %index: i64, %mask: vector<4xi8>) {
  %destination_layout = encoding.layout.dense : encoding<layout>
  %destination = buffer.view %output[%output_byte_offset] : buffer -> view<64xf32, %destination_layout>
  %78 = index.cast %index : i64 to index
  %79 = vector.splati 0 : vector<4xi8>
  %80 = vector.cmpi ne, %mask, %79 : vector<4xi8> -> vector<4xi1>
  vector.store.compress %value, %destination[%78], %80 : vector<4xf32>, view<64xf32, %destination_layout>, vector<4xi1>
  func.return
}

// ====
// Semantic vector memory retains each dynamic result dimension and consumes the
// same self-contained representation at a store.
#include <loomcxx/vector.h>
namespace loomt = loom::type;
using Fragment = loomt::vector<loomt::shape<loomt::dynamic>, float>;
using Tile = loomt::vector<loomt::shape<loomt::dynamic, 4, loomt::dynamic>, float>;
using Block = loomt::vector<loomt::shape<2, 4>, float>;

Fragment load_fragment(const float* input, loomt::size_type index, loomt::index width) {
  auto source = loom::buffer::view<4096>(input, {}, loom::encoding::layout::dense<1>());
  return loom::vector::load<Fragment>(source, {index}, {width});
}

void copy_fragment(const float* input, float* output, loomt::size_type index, loomt::index width) {
  auto source = loom::buffer::view<4096>(input, {}, loom::encoding::layout::dense<1>());
  auto destination = loom::buffer::view<4096>(output, {}, loom::encoding::layout::dense<1>());
  auto value = loom::vector::load<Fragment>(source, {index}, {width});
  loom::vector::store(value, destination, {index});
}

Tile load_tile(const float* input, loomt::index x, loomt::index y, loomt::index z, loomt::index rows, loomt::index columns) {
  auto source = loom::buffer::view<64, 64, 64>(input, {}, loom::encoding::layout::dense<3>());
  return loom::vector::load<Tile>(source, loomt::indices{x, y, z}, {rows, columns});
}

Block load_block(const float* input, loomt::index row, loomt::index column) {
  auto source = loom::buffer::view<64, 64>(input, {}, loom::encoding::layout::dense<2>());
  return loom::vector::load<Block>(source, loomt::indices{row, column});
}

// ----
func.def public @load_fragment(%input: buffer, %input_byte_offset: offset, %index: i64, %width: index) -> (%4: index, vector<[%4]xf32>) {
  %source_layout = encoding.layout.dense : encoding<layout>
  %source = buffer.view %input[%input_byte_offset] : buffer -> view<4096xf32, %source_layout>
  %8 = index.cast %index : i64 to index
  %9 = vector.load %source[%8] : view<4096xf32, %source_layout> -> vector<[%width]xf32>
  func.return %width, %9 : index, vector<[%width]xf32>
}

func.def public @copy_fragment(%input: buffer, %input_byte_offset: offset, %output: buffer, %output_byte_offset: offset, %index: i64, %width: index) {
  %source_layout = encoding.layout.dense : encoding<layout>
  %source = buffer.view %input[%input_byte_offset] : buffer -> view<4096xf32, %source_layout>
  %destination_layout = encoding.layout.dense : encoding<layout>
  %destination = buffer.view %output[%output_byte_offset] : buffer -> view<4096xf32, %destination_layout>
  %20 = index.cast %index : i64 to index
  %value = vector.load %source[%20] : view<4096xf32, %source_layout> -> vector<[%width]xf32>
  %22 = index.cast %index : i64 to index
  vector.store %value, %destination[%22] : vector<[%width]xf32>, view<4096xf32, %destination_layout>
  func.return
}

func.def public @load_tile(%input: buffer, %input_byte_offset: offset, %x: index, %y: index, %z: index, %rows: index, %columns: index) -> (%30: index, %31: index, vector<[%30]x4x[%31]xf32>) {
  %source_layout = encoding.layout.dense : encoding<layout>
  %source = buffer.view %input[%input_byte_offset] : buffer -> view<64x64x64xf32, %source_layout>
  %35 = vector.load %source[%x, %y, %z] : view<64x64x64xf32, %source_layout> -> vector<[%rows]x4x[%columns]xf32>
  func.return %rows, %columns, %35 : index, index, vector<[%rows]x4x[%columns]xf32>
}

func.def public @load_block(%input: buffer, %input_byte_offset: offset, %row: index, %column: index) -> (vector<2x4xf32>) {
  %source_layout = encoding.layout.dense : encoding<layout>
  %source = buffer.view %input[%input_byte_offset] : buffer -> view<64x64xf32, %source_layout>
  %43 = vector.load %source[%row, %column] : view<64x64xf32, %source_layout> -> vector<2x4xf32>
  func.return %43 : vector<2x4xf32>
}
