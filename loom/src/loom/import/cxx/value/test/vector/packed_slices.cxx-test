// RUN: roundtrip
// Register slices preserve element bits at variable, crossing, and tail offsets.
#include <loomcxx/vector.h>
using Source = unsigned char __attribute__((ext_vector_type(16)));
using Four = unsigned char __attribute__((ext_vector_type(4)));
using Eight = unsigned char __attribute__((ext_vector_type(8)));
using Two = unsigned char __attribute__((ext_vector_type(2)));
Four unaligned(Source value, unsigned offset) {
  return loom::vector::slice<Four>(value, offset);
}
Eight crossing(Source value) { return loom::vector::slice<Eight>(value, 3u); }
Two tail(Source value) { return loom::vector::slice<Two>(value, 14u); }

// ----
func.def public @unaligned(%value: vector<16xi8>, %offset: i32) -> (vector<4xi8>) {
  %3 = scalar.extui %offset : i32 to i64
  %4 = index.cast %3 : i64 to index
  %5 = vector.slice %value[%4] : vector<16xi8> -> vector<4xi8>
  func.return %5 : vector<4xi8>
}

func.def public @crossing(%value: vector<16xi8>) -> (vector<8xi8>) {
  %8 = scalar.constant 3 : i32
  %9 = scalar.extui %8 : i32 to i64
  %10 = index.cast %9 : i64 to index
  %11 = vector.slice %value[%10] : vector<16xi8> -> vector<8xi8>
  func.return %11 : vector<8xi8>
}

func.def public @tail(%value: vector<16xi8>) -> (vector<2xi8>) {
  %14 = scalar.constant 14 : i32
  %15 = scalar.extui %14 : i32 to i64
  %16 = index.cast %15 : i64 to index
  %17 = vector.slice %value[%16] : vector<16xi8> -> vector<2xi8>
  func.return %17 : vector<2xi8>
}

