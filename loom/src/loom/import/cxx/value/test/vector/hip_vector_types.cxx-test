func.def device inline @make_uint2(%x: i32, %y: i32) -> (vector<2xi32>) {
  %493 = vector.from_elements %x, %y : vector<2xi32>
  func.return %493 : vector<2xi32>
}

func.def device inline @make_uint3(%x: i32, %y: i32, %z: i32) -> (i32, i32, i32) {
  func.return %x, %y, %z : i32, i32, i32
}

func.def device inline @make_uchar1(%x: i8) -> (i8) {
  func.return %x : i8
}

func.def device inline @make_short3(%x: i16, %y: i16, %z: i16) -> (i16, i16, i16) {
  func.return %x, %y, %z : i16, i16, i16
}

func.def device inline @make_ulonglong2(%x: i64, %y: i64) -> (vector<2xi64>) {
  %511 = vector.from_elements %x, %y : vector<2xi64>
  func.return %511 : vector<2xi64>
}

func.def device inline @make_float4(%x: f32, %y: f32, %z: f32, %w: f32) -> (vector<4xf32>) {
  %517 = vector.from_elements %x, %y, %z, %w : vector<4xf32>
  func.return %517 : vector<4xf32>
}

func.def device inline @make_double2(%x: f64, %y: f64) -> (vector<2xf64>) {
  %521 = vector.from_elements %x, %y : vector<2xf64>
  func.return %521 : vector<2xf64>
}

func.def device inline @make_longlong1(%x: i64) -> (i64) {
  func.return %x : i64
}

func.def device inline @make_ulonglong4(%x: i64, %y: i64, %z: i64, %w: i64) -> (vector<4xi64>) {
  %529 = vector.from_elements %x, %y, %z, %w : vector<4xi64>
  func.return %529 : vector<4xi64>
}

// ====
// RUN: pass canonicalize,cse,dce
// INPUT: cxx root=hip_vector_oracle
// The scalar reference independently computes every output word.
#include "hip_vector_types.cxx"

// ----
func.def public @hip_vector_oracle(%input: buffer, %output: buffer) {
  %3 = index.constant 0 : offset
  %source = buffer.view %input[%3] : buffer -> view<8xi32>
  %result = buffer.view %output[%3] : buffer -> view<24xi32>
  %155 = index.constant 1 : index
  %input1 = view.load %source[%155] : view<8xi32> -> i32
  %154 = index.constant 2 : index
  %input2 = view.load %source[%154] : view<8xi32> -> i32
  %153 = index.constant 3 : index
  %input3 = view.load %source[%153] : view<8xi32> -> i32
  %152 = index.constant 4 : index
  %input4 = view.load %source[%152] : view<8xi32> -> i32
  %word0 = scalar.addi %input3, %input1 : i32
  %word1 = scalar.xori %input1, %input4 : i32
  %word2 = scalar.addi %input2, %word1 : i32
  %word3 = scalar.subi %input3, %word0 : i32
  %151 = index.constant 0 : index
  view.store %word0, %result[%151] : i32, view<24xi32>
  view.store %word1, %result[%155] : i32, view<24xi32>
  view.store %word2, %result[%154] : i32, view<24xi32>
  view.store %word3, %result[%153] : i32, view<24xi32>
  %32 = scalar.xori %input4, %input2 : i32
  view.store %32, %result[%152] : i32, view<24xi32>
  %35 = scalar.addi %input2, %input1 : i32
  %146 = index.constant 5 : index
  view.store %35, %result[%146] : i32, view<24xi32>
  %38 = scalar.constant 6 : i32
  %triple0 = scalar.addi %input1, %38 : i32
  %triple1 = scalar.subi %input2, %triple0 : i32
  %145 = index.constant 6 : index
  view.store %triple0, %result[%145] : i32, view<24xi32>
  %144 = index.constant 7 : index
  view.store %triple1, %result[%144] : i32, view<24xi32>
  %45 = scalar.xori %input3, %triple1 : i32
  %143 = index.constant 8 : index
  view.store %45, %result[%143] : i32, view<24xi32>
  %48 = scalar.trunci %input3 : i32 to i8
  %49 = scalar.extui %48 : i8 to i32
  %50 = scalar.constant 2 : i32
  %51 = scalar.addi %49, %50 : i32
  %52 = scalar.trunci %51 : i32 to i8
  %53 = scalar.extui %52 : i8 to i32
  %142 = index.constant 9 : index
  view.store %53, %result[%142] : i32, view<24xi32>
  %141 = scalar.constant -32768 : i32
  %140 = index.constant 10 : index
  view.store %141, %result[%140] : i32, view<24xi32>
  %63 = scalar.constant 1 : i32
  %139 = index.constant 11 : index
  view.store %63, %result[%139] : i32, view<24xi32>
  %66 = scalar.constant 32760 : i32
  %138 = index.constant 12 : index
  view.store %66, %result[%138] : i32, view<24xi32>
  %69 = scalar.extui %input2 : i32 to i64
  %137 = scalar.constant 32 : i64
