// RUN: roundtrip
typedef unsigned U4 __attribute__((vector_size(16)));
unsigned vector_unsigned(unsigned input, unsigned lane) {
  U4 value = {input, 0x80000000u, 0xffffffffu, 7u};
  U4 result = ((value + 17u) >> 3u) / 3u;
  return result[lane];
}

// ----
func.def public @vector_unsigned(%input: i32, %lane: i32) -> (i32) {
  %3 = vector.constanti [0, -2147483648, -1, 7] : vector<4xi32>
  %value = vector.insert %input into %3[0] : i32, vector<4xi32>
  %5 = scalar.constant 17 : i32
  %6 = vector.splat %5 : vector<4xi32>
  %7 = vector.addi %value, %6 : vector<4xi32>
  %8 = scalar.constant 3 : i32
  %9 = vector.splat %8 : vector<4xi32>
  %10 = vector.shrui %7, %9 : vector<4xi32>
  %11 = scalar.constant 3 : i32
  %12 = vector.splat %11 : vector<4xi32>
  %result = vector.divui %10, %12 : vector<4xi32>
  %14 = index.cast %lane : i32 to index
  %15 = vector.extract %result[%14] : vector<4xi32> -> i32
  func.return %15 : i32
}

// ====
// RUN: roundtrip
typedef unsigned U4 __attribute__((vector_size(16)));
typedef int I4 __attribute__((vector_size(16)));
int vector_mask(unsigned left, unsigned right, unsigned lane) {
  U4 a = {left, 0xffffffffu, 0u, 0x80000000u};
  U4 b = {right, 0u, 0u, 0x7fffffffu};
  I4 mask = a > b;
  return mask[lane];
}

// ----
func.def public @vector_mask(%left: i32, %right: i32, %lane: i32) -> (i32) {
  %4 = vector.constanti [0, -1, 0, -2147483648] : vector<4xi32>
  %a = vector.insert %left into %4[0] : i32, vector<4xi32>
  %6 = vector.constanti [0, 0, 0, 2147483647] : vector<4xi32>
  %b = vector.insert %right into %6[0] : i32, vector<4xi32>
  %8 = vector.cmpi ugt, %a, %b : vector<4xi32> -> vector<4xi1>
  %mask = vector.extsi %8 : vector<4xi1> to vector<4xi32>
  %10 = index.cast %lane : i32 to index
  %11 = vector.extract %mask[%10] : vector<4xi32> -> i32
  func.return %11 : i32
}

