  %6 = scalar.constant 257 : i32
  %7 = scalar.trunci %6 : i32 to i16
  %8 = vector.splat %7 : vector<8xi16>
  %9 = vector.muli %value, %8 : vector<8xi16>
  %10 = scalar.constant 60000 : i32
  %11 = scalar.trunci %10 : i32 to i16
  %12 = vector.splat %11 : vector<8xi16>
  %13 = vector.addi %9, %12 : vector<8xi16>
  %14 = scalar.constant 5 : i32
  %15 = scalar.trunci %14 : i32 to i16
  %16 = vector.splat %15 : vector<8xi16>
  %result = vector.shrui %13, %16 : vector<8xi16>
  %18 = index.cast %lane : i32 to index
  %19 = vector.extract %result[%18] : vector<8xi16> -> i16
  %20 = scalar.extui %19 : i16 to i32
  func.return %20 : i32
}

// ====
// RUN: roundtrip
typedef unsigned U4 __attribute__((vector_size(16)));
typedef float F4 __attribute__((vector_size(16)));
unsigned vector_bitcast(unsigned first, unsigned second, unsigned lane) {
  U4 bits = {first, second, 0x3f800000u, 0x80000000u};
  F4 floats = __builtin_bit_cast(F4, bits);
  U4 result = (U4)(-floats);
  return result[lane];
}

// ----
func.def public @vector_bitcast(%first: i32, %second: i32, %lane: i32) -> (i32) {
  %4 = scalar.constant 1065353216 : i32
  %5 = scalar.constant -2147483648 : i32
  %bits = vector.from_elements %first, %second, %4, %5 : vector<4xi32>
  %floats = vector.bitcast %bits : vector<4xi32> to vector<4xf32>
  %8 = vector.negf %floats : vector<4xf32>
  %result = vector.bitcast %8 : vector<4xf32> to vector<4xi32>
  %10 = index.cast %lane : i32 to index
  %11 = vector.extract %result[%10] : vector<4xi32> -> i32
  func.return %11 : i32
}

// ====
// RUN: roundtrip
typedef unsigned U4 __attribute__((vector_size(16)));
typedef float F4 __attribute__((vector_size(16)));
typedef int I4 __attribute__((vector_size(16)));
int vector_float_ne(unsigned left, unsigned right, unsigned lane) {
  U4 a = {left, 0x7fc00000u, 0u, 0x80000000u};
  U4 b = {right, 0x3f800000u, 0x80000000u, 0u};
  F4 x = (F4)a;
  F4 y = (F4)b;
  I4 result = x != y;
  return result[lane];
}

// ----
func.def public @vector_float_ne(%left: i32, %right: i32, %lane: i32) -> (i32) {
  %4 = vector.constanti [0, 2143289344, 0, -2147483648] : vector<4xi32>
  %a = vector.insert %left into %4[0] : i32, vector<4xi32>
  %6 = vector.constanti [0, 1065353216, -2147483648, 0] : vector<4xi32>
  %b = vector.insert %right into %6[0] : i32, vector<4xi32>
  %x = vector.bitcast %a : vector<4xi32> to vector<4xf32>
  %y = vector.bitcast %b : vector<4xi32> to vector<4xf32>
  %10 = vector.cmpf une, %x, %y : vector<4xf32> -> vector<4xi1>
  %result = vector.extsi %10 : vector<4xi1> to vector<4xi32>
  %12 = index.cast %lane : i32 to index
  %13 = vector.extract %result[%12] : vector<4xi32> -> i32
  func.return %13 : i32
}

// ====
// RUN: roundtrip
typedef unsigned U4 __attribute__((vector_size(16)));
static U4 advance(U4 value, unsigned count) {
  while (count > 0u) {
    value += 3u;
    --count;
  }
  return value;
}
unsigned vector_control(unsigned input, unsigned count, unsigned lane) {
  U4 value = {input, 1u};
  U4 result = count ? advance(value, count) : value;
  for (unsigned i = 0; i < count; ++i) {
    result += 1u;
  }
  if (count > 2u) {
    result = ~result;
  }
  return result[lane];
}

// ----
func.def public @vector_control(%input: i32, %count: i32, %lane: i32) -> (i32) {
  %4 = vector.constanti [0, 1, 0, 0] : vector<4xi32>
  %value = vector.insert %input into %4[0] : i32, vector<4xi32>
  %6 = scalar.constant 0 : i32
  %7 = scalar.cmpi ne, %count, %6 : i32
  %result$8 = scf.if %7 -> (vector<4xi32>) {
    %9 = func.call pure @advance(%value, %count) : (vector<4xi32>, i32) -> (vector<4xi32>)
    scf.yield %9 : vector<4xi32>
  } else {
    scf.yield %value : vector<4xi32>
  }
  %i = scalar.constant 0 : i32
  %11 = index.cast %i : i32 to offset
  %12 = index.cast %count : i32 to offset
  %13 = index.constant 1 : offset
  %result$16 = scf.for %i = [%11 to %12 step %13](%result$15 = %result$8 : vector<4xi32>) -> (vector<4xi32>) {
    %17 = index.cast %i : offset to i32
    %18 = scalar.constant 1 : i32
    %19 = vector.splat %18 : vector<4xi32>
    %result$20 = vector.addi %result$15, %19 : vector<4xi32>
    scf.yield %result$20 : vector<4xi32>
  }
  %21 = scalar.constant 2 : i32
  %22 = scalar.cmpi ugt, %count, %21 : i32
  %result$23 = scf.if %22 -> (vector<4xi32>) {
    %24 = vector.splati -1 : vector<4xi32>
    %result = vector.xori %result$16, %24 : vector<4xi32>
    scf.yield %result : vector<4xi32>
  } else {
    scf.yield %result$16 : vector<4xi32>
  }
  %26 = index.cast %lane : i32 to index
  %27 = vector.extract %result$23[%26] : vector<4xi32> -> i32
  func.return %27 : i32
}

func.def @advance(%value$28: vector<4xi32>, %count$29: i32) -> (vector<4xi32>) {
  %value$35, %count$36 = scf.while(%value = %value$28 : vector<4xi32>, %count = %count$29 : i32) -> (vector<4xi32>, i32) {
    %37 = scalar.constant 0 : i32
    %38 = scalar.cmpi ugt, %count, %37 : i32
    scf.condition %38, %value, %count : i1, vector<4xi32>, i32
  } do(%value$33: vector<4xi32>, %count$34: i32) {
    %39 = scalar.constant 3 : i32
    %40 = vector.splat %39 : vector<4xi32>
    %value$41 = vector.addi %value$33, %40 : vector<4xi32>
    %42 = scalar.constant 1 : i32
    %count$43 = scalar.subi %count$34, %42 : i32
    scf.yield %value$41, %count$43 : vector<4xi32>, i32
  }
  func.return %value$35 : vector<4xi32>
}

