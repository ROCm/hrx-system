// RUN: roundtrip
typedef unsigned E4 __attribute__((ext_vector_type(4)));
unsigned vector_ext_splat(unsigned input, unsigned lane) {
  E4 value = input;
  return value[lane];
}

// ----
func.def public @vector_ext_splat(%input: i32, %lane: i32) -> (i32) {
  %value = vector.splat %input : vector<4xi32>
  %4 = index.cast %lane : i32 to index
  %5 = vector.extract %value[%4] : vector<4xi32> -> i32
  func.return %5 : i32
}

// ====
// RUN: roundtrip
// C++ comparison masks sign-extend true lanes to all ones.
using Words4 = unsigned __attribute__((vector_size(16)));
using Signed4 = int __attribute__((vector_size(16)));
Signed4 less_unsigned(Words4 left, Words4 right) { return left < right; }
Signed4 less_signed(Words4 left, Words4 right) { return (Signed4)left < (Signed4)right; }
Signed4 equal(Words4 left, Words4 right) { return left == right; }
Signed4 logical_not(Words4 value) { return !value; }

// ----
func.def public @less_unsigned(%left: vector<4xi32>, %right: vector<4xi32>) -> (vector<4xi32>) {
  %3 = vector.cmpi ult, %left, %right : vector<4xi32> -> vector<4xi1>
  %4 = vector.extsi %3 : vector<4xi1> to vector<4xi32>
  func.return %4 : vector<4xi32>
}

func.def public @less_signed(%left: vector<4xi32>, %right: vector<4xi32>) -> (vector<4xi32>) {
  %8 = vector.cmpi slt, %left, %right : vector<4xi32> -> vector<4xi1>
  %9 = vector.extsi %8 : vector<4xi1> to vector<4xi32>
  func.return %9 : vector<4xi32>
}

func.def public @equal(%left: vector<4xi32>, %right: vector<4xi32>) -> (vector<4xi32>) {
  %13 = vector.cmpi eq, %left, %right : vector<4xi32> -> vector<4xi1>
  %14 = vector.extsi %13 : vector<4xi1> to vector<4xi32>
  func.return %14 : vector<4xi32>
}

func.def public @logical_not(%value: vector<4xi32>) -> (vector<4xi32>) {
  %17 = vector.splati 0 : vector<4xi32>
  %18 = vector.cmpi eq, %value, %17 : vector<4xi32> -> vector<4xi1>
  %19 = vector.extsi %18 : vector<4xi1> to vector<4xi32>
  func.return %19 : vector<4xi32>
}
