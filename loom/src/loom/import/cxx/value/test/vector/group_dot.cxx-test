// ----
kernel.def @mxfp8_decode_dot() {
  %4 = index.constant 1 : index
  kernel.launch.config workgroups(%4, %4, %4) workgroup_size(%4, %4, %4) : index
} launch(%0: buffer, %1: buffer, %2: buffer, %3: buffer) {
  %10 = buffer.assume.alignment %0 {minimum_alignment = 64} : buffer
