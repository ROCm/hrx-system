// ====
// Odd-width half selectors expose one poison padding lane on reads and ignore
// that lane on writes while retaining the three-lane logical value.
using Lanes2 = int __attribute__((ext_vector_type(2)));
using Lanes3 = int __attribute__((ext_vector_type(3)));
Lanes3 update_odd_width(Lanes3 values, Lanes2 replacement) {
  values.hi = replacement;
  values.odd = replacement;
  return values;
}
int read_odd_width(Lanes3 values) {
  Lanes2 high = values.hi;
  return high.x;
}

