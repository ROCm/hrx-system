  %23 = scalar.constant 1 : i32
  %24 = scalar.addi %22, %23 : i32
  %25 = index.cast %index$7 : i32 to index
  %packet_lanes$26 = vector.insert %24 into %packet_lanes$20[%25] : i32, vector<4xi32>
  %27 = scalar.addi %previous, %24 : i32
  %packet_prefix$28 = scalar.addi %packet_prefix$0, %27 : i32
  %29 = index.cast %index$7 : i32 to index
  %30 = vector.extract %packet_lanes$26[%29] : vector<4xi32> -> i32
