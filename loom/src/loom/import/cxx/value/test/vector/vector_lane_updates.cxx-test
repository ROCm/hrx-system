// ====
// Named scalar components use static projections and retain SSA updates.
using Lanes = unsigned __attribute__((ext_vector_type(4)));
Lanes update_named(Lanes values, unsigned replacement) {
  unsigned previous = values.x++;
  values.g = replacement;
  values.s2 += previous;
  --values.w;
  return values;
}

