  %values$6 = vector.insert %5 into %values$0[0] : i32, vector<4xi32>
  %values$7 = vector.insert %replacement into %values$6[1] : i32, vector<4xi32>
  %8 = vector.extract %values$7[2] : vector<4xi32> -> i32
  %9 = scalar.addi %8, %previous : i32
  %values$10 = vector.insert %9 into %values$7[2] : i32, vector<4xi32>
  %11 = vector.extract %values$10[3] : vector<4xi32> -> i32
  %12 = scalar.constant 1 : i32
  %13 = scalar.subi %11, %12 : i32
  %values$14 = vector.insert %13 into %values$10[3] : i32, vector<4xi32>
  func.return %values$14 : vector<4xi32>
}

// ====
// Every extended-vector selector family uses static gather and insertion.
using Lanes = unsigned __attribute__((ext_vector_type(4)));
Lanes update_swizzles(Lanes values) {
  values.xy = values.yx;
  values.rgba = values.abgr;
  values.s30 = values.S12;
  values.hi = values.lo;
  values.even = values.odd;
  return values;
}

