  %33 = index.cast %32 : i64 to offset
  %34 = index.constant 16 : offset
  %35 = index.add %33, %34 : offset
  %36 = scalar.extui %lane_index$18 : i32 to i64
  %37 = scalar.constant 4 : i64
  %38 = scalar.muli %36, %37 : i64
  %39 = index.cast %35 : offset to i64
  %40 = scalar.addi %39, %38 : i64
