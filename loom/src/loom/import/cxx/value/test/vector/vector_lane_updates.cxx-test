// ====
// Odd-width half selectors expose one poison padding lane on reads and ignore
// that lane on writes while retaining the three-lane logical value.
using Lanes2 = int __attribute__((ext_vector_type(2)));
using Lanes3 = int __attribute__((ext_vector_type(3)));
Lanes3 update_odd_width(Lanes3 values, Lanes2 replacement) {
  values.hi = replacement;
  values.odd = replacement;
  return values;
}
int read_odd_width(Lanes3 values) {
  Lanes2 high = values.hi;
  return high.x;
}

// ----
func.def public @update_odd_width(%values$0: vector<3xi32>, %replacement: vector<2xi32>) -> (vector<3xi32>) {
  %3 = vector.extract %replacement[0] : vector<2xi32> -> i32
  %values$4 = vector.insert %3 into %values$0[2] : i32, vector<3xi32>
  %5 = vector.extract %replacement[0] : vector<2xi32> -> i32
  %values$6 = vector.insert %5 into %values$4[1] : i32, vector<3xi32>
  func.return %values$6 : vector<3xi32>
}

func.def public @read_odd_width(%values: vector<3xi32>) -> (i32) {
  %9 = vector.extract %values[2] : vector<3xi32> -> i32
  %10 = scalar.poison : i32
  %high = vector.from_elements %9, %10 : vector<2xi32>
  %12 = vector.extract %high[0] : vector<2xi32> -> i32
  func.return %12 : i32
}
