// ====
// Memory-backed vector lanes evaluate record and lane indices exactly once.
using Lanes = unsigned __attribute__((ext_vector_type(4)));
struct Packet {
  unsigned prefix;
  Lanes lanes;
};
unsigned update_memory(Packet* packets, unsigned packet_index, unsigned lane_index, unsigned replacement) {
  packets[packet_index++].lanes[lane_index++] = replacement;
  packets[packet_index].lanes[lane_index] ^= replacement;
  return packet_index + lane_index;
}

