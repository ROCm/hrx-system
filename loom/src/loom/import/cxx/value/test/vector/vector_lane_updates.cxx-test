// ====
// Memory-backed components preserve source side effects and whole-vector IO.
using Lanes = unsigned __attribute__((ext_vector_type(4)));
unsigned update_named_memory(Lanes* values, unsigned index,
                             unsigned replacement) {
  values[index++].x = replacement;
  values[index].g ^= replacement;
  return values[index].s2 + index;
}
unsigned update_named_pointer(Lanes* value, unsigned replacement) {
  value->w += replacement;
  return value->w;
}

