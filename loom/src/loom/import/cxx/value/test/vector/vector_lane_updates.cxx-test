  %5 = vector.extract %replacement[0] : vector<2xi32> -> i32
  %values$6 = vector.insert %5 into %values$4[1] : i32, vector<3xi32>
  func.return %values$6 : vector<3xi32>
}

func.def public @read_odd_width(%values: vector<3xi32>) -> (i32) {
