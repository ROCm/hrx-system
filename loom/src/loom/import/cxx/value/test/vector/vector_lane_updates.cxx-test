  %8 = scalar.extui %packet_index$2 : i32 to i64
  %9 = index.cast %8 : i64 to index
  %10 = index.constant 32 : index
  %11 = index.mul %9, %10 : index
  %12 = index.add %packets_byte_offset, %11 : index
  %13 = index.constant 16 : index
  %14 = index.add %12, %13 : index
  %15 = scalar.constant 1 : i32
  %lane_index$16 = scalar.addi %lane_index$3, %15 : i32
  %17 = scalar.extui %lane_index$3 : i32 to i64
  %18 = index.cast %17 : i64 to index
  %19 = index.constant 4 : index
  %20 = index.mul %18, %19 : index
  %21 = index.add %14, %20 : index
  %22 = buffer.view %packets[%21] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %replacement, %22[0] : i32, view<1xi32>
  %23 = scalar.extui %packet_index$7 : i32 to i64
  %24 = index.cast %23 : i64 to index
  %25 = index.constant 32 : index
  %26 = index.mul %24, %25 : index
  %27 = index.add %packets_byte_offset, %26 : index
  %28 = index.constant 16 : index
  %29 = index.add %27, %28 : index
  %30 = scalar.extui %lane_index$16 : i32 to i64
  %31 = index.cast %30 : i64 to index
  %32 = index.constant 4 : index
  %33 = index.mul %31, %32 : index
  %34 = index.add %29, %33 : index
  %35 = buffer.view %packets[%34] : buffer -> view<1xi32>
  %36 = view.load<root_in_bounds|type_disjoint> %35[0] : view<1xi32> -> i32
  %37 = scalar.xori %36, %replacement : i32
  %38 = buffer.view %packets[%34] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %37, %38[0] : i32, view<1xi32>
  %39 = scalar.addi %packet_index$7, %lane_index$16 : i32
  func.return %39 : i32
}

// ====
// Named scalar components use static projections and retain SSA updates.
using Lanes = unsigned __attribute__((ext_vector_type(4)));
Lanes update_named(Lanes values, unsigned replacement) {
  unsigned previous = values.x++;
  values.g = replacement;
  values.s2 += previous;
  --values.w;
  return values;
}

// ----
