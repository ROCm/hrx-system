// RUN: verify
// Lookup requires a vector result.
typedef int Integers __attribute__((vector_size(16)));
// ERROR@+1: LOWERING/059 "shaped intrinsic result must be a vector"
[[loom::op("vector.table.lookup")]] int custom(Integers, Integers);

// ====
// Lookup requires vector operands.
typedef int Integers __attribute__((vector_size(16)));
// ERROR@+1: LOWERING/059 "shaped intrinsic operands must be vectors"
[[loom::op("vector.table.lookup")]] Integers custom(int, Integers);

// ====
// Lookup indices must be integral.
typedef int Integers __attribute__((vector_size(16)));
typedef float Floats __attribute__((vector_size(16)));
// ERROR@+1: LOWERING/059 "register table lookup requires the table's element type and the integer index vector's lane count"
[[loom::op("vector.table.lookup")]] Integers custom(Integers, Floats);

// ====
// Lookup index lanes must match the result.
typedef signed char SignedBytes __attribute__((vector_size(16)));
typedef int Integers __attribute__((vector_size(16)));
// ERROR@+1: LOWERING/059 "register table lookup requires the table's element type and the integer index vector's lane count"
[[loom::op("vector.table.lookup")]] Integers custom(Integers, SignedBytes);

// ====
// Lookup preserves the table element signedness.
typedef int Integers __attribute__((vector_size(16)));
typedef unsigned UnsignedIntegers __attribute__((vector_size(16)));
// ERROR@+1: LOWERING/059 "register table lookup requires the table's element type and the integer index vector's lane count"
[[loom::op("vector.table.lookup")]] Integers custom(UnsignedIntegers, Integers);

// ====
// Lookup requires two operands.
typedef int Integers __attribute__((vector_size(16)));
// ERROR@+1: LOWERING/059 "intrinsic declaration has the wrong operand count"
[[loom::op("vector.table.lookup")]] Integers custom(Integers);

// ====
// Lookup cannot accept variadic operands.
typedef int Integers __attribute__((vector_size(16)));
// ERROR@+1: LOWERING/059 "intrinsic declaration has the wrong operand count"
[[loom::op("vector.table.lookup")]] Integers custom(Integers, Integers, ...);

// ====
// Lookup has no math flags.
typedef int Integers __attribute__((vector_size(16)));
// ERROR@+1: LOWERING/059 "register table lookup has no semantic arguments"
[[loom::op("vector.table.lookup", "afn")]] Integers custom(Integers, Integers);

// ====
// Dot rejects unknown signedness choices.
typedef signed char SignedBytes __attribute__((vector_size(16)));
typedef int Integers __attribute__((vector_size(16)));
// ERROR@+1: LOWERING/059 "unsupported dot4i signedness argument"
[[loom::op("vector.dot4i", "unknown")]] Integers custom(SignedBytes, SignedBytes, Integers);

// ====
// Dot accepts exactly one semantic argument.
typedef signed char SignedBytes __attribute__((vector_size(16)));
typedef int Integers __attribute__((vector_size(16)));
// ERROR@+1: LOWERING/059 "dot4i accepts no semantic arguments or one signedness argument: s8s8, u8s8, s8u8, or u8u8"
[[loom::op("vector.dot4i", "s8s8", "afn")]] Integers custom(SignedBytes, SignedBytes, Integers);

// ====
// Dot inputs must contain bytes.
typedef int Integers __attribute__((vector_size(16)));
// ERROR@+1: LOWERING/059 "dot4i requires equal i8 input shapes with four lanes per i32 accumulator/result lane"
[[loom::op("vector.dot4i", "s8s8")]] Integers custom(Integers, Integers, Integers);

// ====
// Dot input shapes must agree.
typedef signed char SignedBytes __attribute__((vector_size(16)));
typedef signed char ShortBytes __attribute__((vector_size(8)));
typedef int Integers __attribute__((vector_size(16)));
// ERROR@+1: LOWERING/059 "dot4i requires equal i8 input shapes with four lanes per i32 accumulator/result lane"
[[loom::op("vector.dot4i", "s8s8")]] Integers custom(SignedBytes, ShortBytes, Integers);

// ====
// Dot needs four byte lanes per result lane.
typedef signed char ShortBytes __attribute__((vector_size(8)));
typedef int Integers __attribute__((vector_size(16)));
// ERROR@+1: LOWERING/059 "dot4i requires equal i8 input shapes with four lanes per i32 accumulator/result lane"
[[loom::op("vector.dot4i", "s8s8")]] Integers custom(ShortBytes, ShortBytes, Integers);

// ====
// Dot results and accumulators must contain i32 values.
typedef signed char SignedBytes __attribute__((vector_size(16)));
typedef float Floats __attribute__((vector_size(16)));
// ERROR@+1: LOWERING/059 "dot4i requires equal i8 input shapes with four lanes per i32 accumulator/result lane"
[[loom::op("vector.dot4i", "s8s8")]] Floats custom(SignedBytes, SignedBytes, Floats);

// ====
// Dot accumulator and result types must match exactly.
typedef signed char SignedBytes __attribute__((vector_size(16)));
typedef int Integers __attribute__((vector_size(16)));
typedef unsigned UnsignedIntegers __attribute__((vector_size(16)));
// ERROR@+1: LOWERING/059 "dot4i requires equal i8 input shapes with four lanes per i32 accumulator/result lane"
[[loom::op("vector.dot4i", "s8s8")]] Integers custom(SignedBytes, SignedBytes, UnsignedIntegers);

// ====
// The left byte type must match the dot signedness.
typedef signed char SignedBytes __attribute__((vector_size(16)));
typedef unsigned char UnsignedBytes __attribute__((vector_size(16)));
typedef int Integers __attribute__((vector_size(16)));
// ERROR@+1: LOWERING/059 "dot4i signedness must match the source byte types"
[[loom::op("vector.dot4i", "s8s8")]] Integers custom(UnsignedBytes, SignedBytes, Integers);

// ====
// The right byte type must match the dot signedness.
typedef signed char SignedBytes __attribute__((vector_size(16)));
typedef unsigned char UnsignedBytes __attribute__((vector_size(16)));
typedef int Integers __attribute__((vector_size(16)));
// ERROR@+1: LOWERING/059 "dot4i signedness must match the source byte types"
[[loom::op("vector.dot4i", "u8u8")]] Integers custom(UnsignedBytes, SignedBytes, Integers);

// ====
// Dot requires an accumulator operand.
typedef signed char SignedBytes __attribute__((vector_size(16)));
typedef int Integers __attribute__((vector_size(16)));
// ERROR@+1: LOWERING/059 "intrinsic declaration has the wrong operand count"
[[loom::op("vector.dot4i", "s8s8")]] Integers custom(SignedBytes, SignedBytes);

// ====
// Splat constructs only the shape-preserving semantic vector representation.
#include <loomcxx/vector.h>
// ERROR@+1: LOWERING/059 "vector.splat result must be a semantic vector"
[[loom::op("vector.splat")]] float custom(loom::type::indices<0>, float);

// ====
// One source index is required for every dynamic result axis.
#include <loomcxx/vector.h>
using Fragment = loom::type::vector<loom::type::shape<loom::type::dynamic>, float>;
// ERROR@+1: LOWERING/059 "vector.splat dimensions have the wrong arity"
[[loom::op("vector.splat")]] Fragment custom(loom::type::indices<0>, float);

// ====
// Dependent type references require native index identities.
#include <loomcxx/vector.h>
using Fragment = loom::type::vector<loom::type::shape<loom::type::dynamic>, float>;
struct Dimensions { unsigned width; };
// ERROR@+1: LOWERING/059 "vector.splat dimensions require logical indices"
[[loom::op("vector.splat")]] Fragment custom(Dimensions, float);

// ====
// Splat preserves its scalar element type exactly.
#include <loomcxx/vector.h>
using Fragment = loom::type::vector<loom::type::shape<loom::type::dynamic>, float>;
// ERROR@+1: LOWERING/059 "vector.splat value must match its result element"
[[loom::op("vector.splat")]] Fragment custom(loom::type::indices<1>, int);

// ====
// Semantic-vector reductions preserve the vector element in seed and result.
#include <loomcxx/vector.h>
using Fragment = loom::type::vector<loom::type::shape<loom::type::dynamic>, float>;
// ERROR@+1: LOWERING/059 "vector element, scalar seed, and result types must match"
[[loom::op("vector.reduce", "addf")]] float custom(Fragment, int);

// ====
// Signed relational predicates require signed source carriers.
#include <loomcxx/vector.h>
using Values = unsigned __attribute__((ext_vector_type(4)));
using Mask = loom::type::vector<loom::type::shape<4>, bool>;
Mask invalid(Values lhs, Values rhs) {
  // ERROR@+1: LOWERING/059 "integer vector comparison predicate signedness must match its operands"
  return loom::vector::cmpi::slt<Mask>(lhs, rhs);
}

// ====
// A transpose is a permutation rather than arbitrary axis replication.
#include <loomcxx/vector.h>
using Matrix = loom::type::vector<loom::type::shape<2, 2>, unsigned>;
Matrix invalid(Matrix value) {
  // ERROR@+1: LOWERING/059 "vector.transpose permutation must select each source axis exactly once"
  return loom::vector::transpose<Matrix, 0, 0>(value);
}

// ====
// Vector bitcasts preserve the complete register footprint.
#include <loomcxx/vector.h>
using Source = unsigned __attribute__((ext_vector_type(4)));
using Result = unsigned char __attribute__((ext_vector_type(4)));
Result invalid(Source value) {
  // ERROR@+1: LOWERING/059 "vector.bitcast requires equal total value bit counts"
  return loom::vector::bitcast<Result>(value);
}

// ====
// Selection conditions use Loom i1 lanes rather than native integer masks.
#include <loomcxx/vector.h>
using Values = unsigned __attribute__((ext_vector_type(4)));
Values invalid(Values condition, Values lhs, Values rhs) {
  // ERROR@+1: LOWERING/059 "vector.select requires an i1 condition shape and one value type"
  return loom::vector::select(condition, lhs, rhs);
}

// ====
// Runtime extraction cannot consume more leading axes than the source owns.
#include <loomcxx/vector.h>
using Values = loom::type::vector<loom::type::shape<4>, unsigned>;
unsigned invalid(Values source, unsigned first, unsigned second) {
  // ERROR@+1: LOWERING/059 "vector.extract must consume one or more leading source axes"
  return loom::vector::extract<unsigned>(source, first, second);
}
