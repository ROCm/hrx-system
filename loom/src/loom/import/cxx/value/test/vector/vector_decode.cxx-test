// RUN: roundtrip
#include <loomcxx/encoding.h>
#include <loomcxx/numeric.h>
#include <loomcxx/vector.h>
using Words4 = unsigned __attribute__((ext_vector_type(4)));
using ScaleWord = unsigned __attribute__((ext_vector_type(1)));
using BFloat32 = __bf16 __attribute__((ext_vector_type(32)));
using Float32 = float __attribute__((ext_vector_type(32)));
using Fp8x32 = loom::type::float8_e4m3fn_t __attribute__((ext_vector_type(32)));
struct Scales { ScaleWord scale; };
BFloat32 fp4(Words4 payload, ScaleWord scale) {
  auto schema = loom::encoding::define<loom::encoding::f4e2m1{}>();
  return loom::vector::decode<BFloat32>(payload, schema, Scales{scale});
}
Float32 fp8(Fp8x32 payload, ScaleWord scale) {
  auto schema = loom::encoding::define<loom::encoding::f8e4m3fn{}>();
  return loom::vector::decode<Float32>(payload, schema, Scales{scale});
}

// ----
func.def public @fp4(%payload: vector<4xi32>, %scale: vector<1xi32>) -> (vector<32xbf16>) {
  %schema = encoding.define #encoding.f4e2m1<affine=scale_only, payload_elements=32, payload_packing=little_endian_nibbles, payload_registers=4, scale_format=e8m0, scale_group_elements=32, scale_operands=1, scale_topology=block_1d, zero_scale_fallback=true> : encoding<schema>
  %4 = vector.decode %payload using %schema {scale = %scale : vector<1xi32>} : vector<4xi32>, encoding<schema> -> vector<32xbf16>
  func.return %4 : vector<32xbf16>
}

func.def public @fp8(%payload: vector<32xf8E4M3>, %scale: vector<1xi32>) -> (vector<32xf32>) {
  %schema = encoding.define #encoding.f8e4m3fn<affine=scale_only, payload_elements=32, scale_format=e8m0, scale_group_elements=32, scale_operands=1, scale_topology=block_1d> : encoding<schema>
  %9 = vector.decode %payload using %schema {scale = %scale : vector<1xi32>} : vector<32xf8E4M3>, encoding<schema> -> vector<32xf32>
  func.return %9 : vector<32xf32>
}

// ====
// Auxiliary field order differs from dictionary order and remains correctly
// wired through record copies and an ordinary helper.
#include <loomcxx/encoding_type.h>
#include <loomcxx/vector.h>
using Schema = loom::type::encoding<loom::encoding::role::schema>;
using Words4 = unsigned __attribute__((ext_vector_type(4)));
using Float4 = float __attribute__((ext_vector_type(4)));
using ScaleWord = unsigned __attribute__((ext_vector_type(1)));
struct Auxiliary { Float4 zero_point; ScaleWord scale; Float4 codebook; };
static Auxiliary copy(Auxiliary value) { return value; }
Float4 decode(Words4 payload, Schema schema, Auxiliary values) {
  return loom::vector::decode<Float4>(payload, schema, copy(values));
}

// ----
func.def public @decode(%payload: vector<4xi32>, %schema: encoding<schema>, %values_zero_point: vector<4xf32>, %values_scale: vector<1xi32>, %values_codebook: vector<4xf32>) -> (vector<4xf32>) {
  %6, %7, %8 = func.call pure @copy(%values_zero_point, %values_scale, %values_codebook) : (vector<4xf32>, vector<1xi32>, vector<4xf32>) -> (vector<4xf32>, vector<1xi32>, vector<4xf32>)
  %9 = vector.decode %payload using %schema {codebook = %8 : vector<4xf32>, scale = %7 : vector<1xi32>, zero_point = %6 : vector<4xf32>} : vector<4xi32>, encoding<schema> -> vector<4xf32>
  func.return %9 : vector<4xf32>
}

func.def @copy(%value_zero_point: vector<4xf32>, %value_scale: vector<1xi32>, %value_codebook: vector<4xf32>) -> (vector<4xf32>, vector<1xi32>, vector<4xf32>) {
  func.return %value_zero_point, %value_scale, %value_codebook : vector<4xf32>, vector<1xi32>, vector<4xf32>
}

// ====
// Schemas without auxiliary values use the two-argument form.
#include <loomcxx/encoding_type.h>
#include <loomcxx/vector.h>
using Schema = loom::type::encoding<loom::encoding::role::schema>;
using Bytes4 = unsigned char __attribute__((ext_vector_type(4)));
using Float4 = float __attribute__((ext_vector_type(4)));
Float4 decode(Bytes4 payload, Schema schema) {
  return loom::vector::decode<Float4>(payload, schema);
}

// ----
func.def public @decode(%payload: vector<4xi8>, %schema: encoding<schema>) -> (vector<4xf32>) {
  %3 = vector.decode %payload using %schema : vector<4xi8>, encoding<schema> -> vector<4xf32>
  func.return %3 : vector<4xf32>
}
