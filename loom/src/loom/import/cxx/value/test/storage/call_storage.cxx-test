// RUN: pass canonicalize,cse,dce
// Loop-local array storage remains addressable across a noinline publication;
// a separate scalar is passed to a mutator and reread after the call.
[[loom::noinline]] static unsigned increment(unsigned* value) {
  return ++*value;
}

[[loom::noinline]] static void publish(unsigned* output, unsigned value) {
  *output = value;
}

[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void call_lifetimes_kernel(const unsigned* parameters, unsigned* output) {
  for (unsigned index = 0; index < parameters[0]; ++index) {
    // Dynamic indexing keeps an unpassed array addressable across a call.
    unsigned values[2] = {index, index + 7};
    publish(output + index, values[parameters[1] & 1]);
    // A passed scalar is read and written by the callee before it returns.
    unsigned counter = index;
    unsigned updated = increment(&counter);
    output[parameters[0] + index] = updated + counter;
  }
}
// ----
kernel.def @call_lifetimes_kernel() {
  %2 = index.constant 1 : index
  kernel.launch.config workgroups(%2, %2, %2) workgroup_size(%2, %2, %2) : index
} launch(%parameters: buffer, %output: buffer) {
  %index$10 = scalar.constant 0 : i32
  %index$13 = scf.while(%index = %index$10 : i32) -> (i32) {
    %84 = index.constant 0 : index
    %19 = buffer.view %parameters[%84] : buffer -> view<1xi32>
    %20 = view.load<root_in_bounds|type_disjoint> %19[0] : view<1xi32> -> i32
    %21 = scalar.cmpi ult, %index, %20 : i32
    scf.condition %21, %index : i1, i32
  } do(%index$12: i32) {
    %22 = index.constant 8 : offset
    %values_storage = buffer.alloca<private> align(4) %22 : buffer
    %values_storage_byte_offset = index.constant 0 : index
    %values_view = buffer.view %values_storage[%values_storage_byte_offset] : buffer -> view<2xi32>
    view.store<type_disjoint> %index$12, %values_view[%values_storage_byte_offset] : i32, view<2xi32>
    %27 = scalar.constant 7 : i32
    %28 = scalar.addi %index$12, %27 : i32
    %29 = index.constant 1 : index
    view.store<type_disjoint> %28, %values_view[%29] : i32, view<2xi32>
    %30 = scalar.extui %index$12 : i32 to i64
    %31 = index.cast %30 : i64 to index
    %32 = index.constant 4 : index
    %33 = index.mul %31, %32 : index
    %40 = buffer.view %parameters[%32] : buffer -> view<1xi32>
    %41 = view.load<root_in_bounds|type_disjoint> %40[0] : view<1xi32> -> i32
    %42 = scalar.constant 1 : i32
    %43 = scalar.andi %41, %42 : i32
    %44 = scalar.extui %43 : i32 to i64
    %45 = scalar.assume %44 [range(%44, 0, 1)] : i64
    %46 = index.cast %45 : i64 to index
    %47 = view.load<type_disjoint> %values_view[%46] : view<2xi32> -> i32
    func.call @publish(%output, %33, %47) : (buffer, index, i32)
    %48 = index.constant 4 : offset
    %counter_storage = buffer.alloca<private> align(4) %48 : buffer
    %counter_view = buffer.view %counter_storage[%values_storage_byte_offset] : buffer -> view<1xi32>
    view.store<type_disjoint> %index$12, %counter_view[0] : i32, view<1xi32>
    %updated = func.call @increment(%counter_storage, %values_storage_byte_offset) : (buffer, index) -> (i32)
    %counter = view.load<type_disjoint> %counter_view[0] : view<1xi32> -> i32
    %54 = scalar.addi %updated, %counter : i32
    %60 = buffer.view %parameters[%values_storage_byte_offset] : buffer -> view<1xi32>
    %61 = view.load<root_in_bounds|type_disjoint> %60[0] : view<1xi32> -> i32
    %62 = scalar.addi %61, %index$12 : i32
    %63 = scalar.extui %62 : i32 to i64
    %64 = index.cast %63 : i64 to index
    %66 = index.mul %64, %32 : index
    %68 = buffer.view %output[%66] : buffer -> view<1xi32>
    view.store<root_in_bounds|type_disjoint> %54, %68[0] : i32, view<1xi32>
    %index$70 = scalar.addi %index$12, %42 : i32
    scf.yield %index$70 : i32
  }
  kernel.return
}

func.def noinline @publish(%output: buffer, %output_byte_offset: index, %value: i32) {
  %74 = buffer.view %output[%output_byte_offset] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %value, %74[0] : i32, view<1xi32>
  func.return
}

func.def noinline @increment(%value: buffer, %value_byte_offset: index) -> (i32) {
  %78 = buffer.view %value[%value_byte_offset] : buffer -> view<1xi32>
  %79 = view.load<root_in_bounds|type_disjoint> %78[0] : view<1xi32> -> i32
  %80 = scalar.constant 1 : i32
  %81 = scalar.addi %79, %80 : i32
  view.store<root_in_bounds|type_disjoint> %81, %78[0] : i32, view<1xi32>
  func.return %81 : i32
}
