// RUN: pass canonicalize,cse,dce
// Direct, zero, forward, and backward subscripts retain the caller origin.
int read(const int* pointer) { return *pointer; }
int read_zero(const int* pointer) { return pointer[0]; }
int read_next(const int* pointer) { return pointer[1]; }
int read_previous(const int* pointer) { return pointer[-1]; }
// ----
func.def public @read(%pointer: buffer, %pointer_byte_offset: index) -> (i32) {
  %3 = buffer.view %pointer[%pointer_byte_offset] : buffer -> view<1xi32>
  %4 = view.load<root_in_bounds|type_disjoint> %3[0] : view<1xi32> -> i32
  func.return %4 : i32
}

func.def public @read_zero(%pointer: buffer, %pointer_byte_offset: index) -> (i32) {
  %13 = buffer.view %pointer[%pointer_byte_offset] : buffer -> view<1xi32>
  %14 = view.load<root_in_bounds|type_disjoint> %13[0] : view<1xi32> -> i32
  func.return %14 : i32
}

func.def public @read_next(%pointer: buffer, %pointer_byte_offset: index) -> (i32) {
  %37 = index.constant 4 : index
  %22 = index.add %pointer_byte_offset, %37 : index
  %23 = buffer.view %pointer[%22] : buffer -> view<1xi32>
  %24 = view.load<root_in_bounds|type_disjoint> %23[0] : view<1xi32> -> i32
  func.return %24 : i32
}

func.def public @read_previous(%pointer: buffer, %pointer_byte_offset: index) -> (i32) {
  %39 = index.constant -4 : index
  %40 = index.add %pointer_byte_offset, %39 : index
  %35 = buffer.view %pointer[%40] : buffer -> view<1xi32>
  %36 = view.load<root_in_bounds|type_disjoint> %35[0] : view<1xi32> -> i32
  func.return %36 : i32
}

// ====
// RUN: pass canonicalize,cse,dce
// Dynamic signed coordinates are added to the incoming byte origin;
// read-modify-write reuses that exact projection and returns the old value.
int read_at(const int* pointer, int index) { return pointer[index]; }
int exchange(int* pointer, int index, int replacement) {
  int previous = pointer[index];
  pointer[index] = replacement;
  return previous;
}
// ----
func.def public @read_at(%pointer: buffer, %pointer_byte_offset: index, %index: i32) -> (i32) {
  %4 = index.cast %index : i32 to index
  %5 = index.constant 4 : index
  %26 = index.madd %4, %5, %pointer_byte_offset : index
  %8 = buffer.view %pointer[%26] : buffer -> view<1xi32>
  %9 = view.load<root_in_bounds|type_disjoint> %8[0] : view<1xi32> -> i32
  func.return %9 : i32
}

func.def public @exchange(%pointer: buffer, %pointer_byte_offset: index, %index: i32, %replacement: i32) -> (i32) {
  %15 = index.cast %index : i32 to index
  %16 = index.constant 4 : index
  %28 = index.madd %15, %16, %pointer_byte_offset : index
  %19 = buffer.view %pointer[%28] : buffer -> view<1xi32>
  %previous = view.load<root_in_bounds|type_disjoint> %19[0] : view<1xi32> -> i32
  view.store<root_in_bounds|type_disjoint> %replacement, %19[0] : i32, view<1xi32>
  func.return %previous : i32
}

// ====
// RUN: pass canonicalize,cse,dce
// Member projection and nested helper displacement both retain the root
// and accumulate their offsets onto the caller-provided interior origin.
struct Pair {
  // Leading member that determines the following member's byte offset.
  int first;
  // Member selected through an interior record pointer.
  int second;
};
int read_member(const Pair* pointer) { return pointer->second; }
static int load_next(const int* pointer) { return pointer[1]; }
int read_helper(const int* pointer) { return load_next(pointer + 1); }
// ----
func.def public @read_member(%pointer: buffer, %pointer_byte_offset: index) -> (i32) {
  %3 = index.constant 4 : index
  %4 = index.add %pointer_byte_offset, %3 : index
  %5 = buffer.view %pointer[%4] : buffer -> view<1xi32>
  %second = view.load<root_in_bounds|type_disjoint> %5[0] : view<1xi32> -> i32
  func.return %second : i32
}

func.def public @read_helper(%pointer: buffer, %pointer_byte_offset: index) -> (i32) {
  %26 = index.constant 4 : index
  %14 = index.add %pointer_byte_offset, %26 : index
  %15 = func.call readonly @load_next(%pointer, %14) : (buffer, index) -> (i32)
  func.return %15 : i32
}

func.def @load_next(%pointer: buffer, %pointer_byte_offset: index) -> (i32) {
  %27 = index.constant 4 : index
  %23 = index.add %pointer_byte_offset, %27 : index
  %24 = buffer.view %pointer[%23] : buffer -> view<1xi32>
  %25 = view.load<root_in_bounds|type_disjoint> %24[0] : view<1xi32> -> i32
  func.return %25 : i32
}

// ====
// RUN: emit source-low @local_pointer_bounds target=amdgpu:gfx90a output=low
// A dynamic helper subscript preserves the source allocation-root bounds
// promise through its pointer ABI. After inlining, memory planning combines the
// promise with the caller's finite local allocation before target lowering.
static int select_local(const int* values, int index) {
  return values[index];
}
static int forward_local(const int* values, int index) {
  return select_local(values, index);
}
int local_pointer_bounds(int index) {
  int values[4] = {3, 5, 7, 11};
  return forward_local(values, index);
}

// ----
low.func.def public target<amdgpu.cdna2.core> abi(hal_kernel) @local_pointer_bounds(%index: reg<amdgpu.vgpr>) -> (reg<amdgpu.vgpr>) asm {
  %36 = storage {byte_alignment = 4, byte_length = 16} : low.storage<private>
  %39 = v_mov_b32 3
  %40 = v_mov_b32 0
  scratch_store_dword_vaddr %40, %39
  %42 = v_mov_b32 5
  scratch_store_dword_vaddr %40, %42 {offset = 4}
  %46 = v_mov_b32 7
  scratch_store_dword_vaddr %40, %46 {offset = 8}
  %49 = v_mov_b32 11
  scratch_store_dword_vaddr %40, %49 {offset = 12}
  %55 = v_lshlrev_b32_src0_inline %index, 2
  %56 = scratch_load_dword_vaddr %55 : reg<amdgpu.vgpr>
  return %56
}

// ====
// RUN: pass canonicalize,cse,dce
// Retained helpers carry signed origins for both byte and scaled pointers.
template <typename T> [[loom::noinline]] static T* advance(T* pointer, int distance) {
  return pointer + distance;
}
void byte_call(char* base, const long long* offsets, int distance) {
  *advance(base + offsets[0], distance) = 1;
}
void word_call(int* base, const long long* offsets, int distance) {
  *advance(base + offsets[0], distance) = 1;
}
// ----
func.def public @byte_call(%base: buffer, %base_byte_offset: index, %offsets: buffer, %offsets_byte_offset: index, %distance: i32) {
  %59 = scalar.constant 1 : i8
  %12 = buffer.view %offsets[%offsets_byte_offset] : buffer -> view<1xi64>
  %13 = view.load<root_in_bounds|type_disjoint> %12[0] : view<1xi64> -> i64
  %14 = index.cast %13 : i64 to index
  %17 = index.add %base_byte_offset, %14 : index
  %18, %19 = func.call pure @advance_char(%base, %17, %distance) : (buffer, index, i32) -> (buffer, index)
  %20 = buffer.view %18[%19] : buffer -> view<1xi8>
  view.store<root_in_bounds> %59, %20[0] : i8, view<1xi8>
  func.return
}

func.def public @word_call(%base: buffer, %base_byte_offset: index, %offsets: buffer, %offsets_byte_offset: index, %distance: i32) {
  %26 = scalar.constant 1 : i32
  %32 = buffer.view %offsets[%offsets_byte_offset] : buffer -> view<1xi64>
  %33 = view.load<root_in_bounds|type_disjoint> %32[0] : view<1xi64> -> i64
  %34 = index.cast %33 : i64 to index
  %35 = index.constant 4 : index
  %60 = index.madd %34, %35, %base_byte_offset : index
  %38, %39 = func.call pure @advance_int(%base, %60, %distance) : (buffer, index, i32) -> (buffer, index)
  %40 = buffer.view %38[%39] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %26, %40[0] : i32, view<1xi32>
  func.return
}

func.def noinline @advance_char(%pointer: buffer, %pointer_byte_offset: index, %distance: i32) -> (buffer, index) {
  %46 = index.cast %distance : i32 to index
  %49 = index.add %pointer_byte_offset, %46 : index
  func.return %pointer, %49 : buffer, index
}

func.def noinline @advance_int(%pointer: buffer, %pointer_byte_offset: index, %distance: i32) -> (buffer, index) {
  %55 = index.cast %distance : i32 to index
  %56 = index.constant 4 : index
  %61 = index.madd %55, %56, %pointer_byte_offset : index
  func.return %pointer, %61 : buffer, index
}
