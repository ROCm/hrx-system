// RUN: pass canonicalize,cse,dce
// Direct, zero, forward, and backward subscripts retain the caller origin.
int read(const int* pointer) { return *pointer; }
int read_zero(const int* pointer) { return pointer[0]; }
int read_next(const int* pointer) { return pointer[1]; }
int read_previous(const int* pointer) { return pointer[-1]; }
// ----
func.def public @read(%pointer: buffer, %pointer_byte_offset: offset) -> (i32) {
  %3 = buffer.view %pointer[%pointer_byte_offset] : buffer -> view<1xi32>
  %4 = view.load %3[0] : view<1xi32> -> i32
  func.return %4 : i32
}

func.def public @read_zero(%pointer: buffer, %pointer_byte_offset: offset) -> (i32) {
  %12 = index.cast %pointer_byte_offset : offset to i64
  %14 = scalar.assume %12 [range(%12, 0, 9223372036854775807)] : i64
  %15 = index.cast %14 : i64 to offset
  %16 = buffer.view %pointer[%15] : buffer -> view<1xi32>
  %17 = view.load %16[0] : view<1xi32> -> i32
  func.return %17 : i32
}

func.def public @read_next(%pointer: buffer, %pointer_byte_offset: offset) -> (i32) {
  %46 = scalar.constant 4 : i64
  %25 = index.cast %pointer_byte_offset : offset to i64
  %26 = scalar.addi %25, %46 : i64
  %27 = scalar.assume %26 [range(%26, 0, 9223372036854775807)] : i64
  %28 = index.cast %27 : i64 to offset
  %29 = buffer.view %pointer[%28] : buffer -> view<1xi32>
  %30 = view.load %29[0] : view<1xi32> -> i32
  func.return %30 : i32
}

func.def public @read_previous(%pointer: buffer, %pointer_byte_offset: offset) -> (i32) {
  %47 = scalar.constant -4 : i64
  %40 = index.cast %pointer_byte_offset : offset to i64
  %41 = scalar.addi %40, %47 : i64
  %42 = scalar.assume %41 [range(%41, 0, 9223372036854775807)] : i64
  %43 = index.cast %42 : i64 to offset
  %44 = buffer.view %pointer[%43] : buffer -> view<1xi32>
  %45 = view.load %44[0] : view<1xi32> -> i32
  func.return %45 : i32
}

// ====
// RUN: pass canonicalize,cse,dce
// Dynamic signed coordinates are added to the incoming byte origin;
// read-modify-write reuses that exact projection and returns the old value.
int read_at(const int* pointer, int index) { return pointer[index]; }
int exchange(int* pointer, int index, int replacement) {
  int previous = pointer[index];
  pointer[index] = replacement;
  return previous;
}
// ----
func.def public @read_at(%pointer: buffer, %pointer_byte_offset: offset, %index: i32) -> (i32) {
  %4 = scalar.extsi %index : i32 to i64
  %35 = scalar.constant 2 : i64
  %36 = scalar.shli %4, %35 : i64
  %7 = index.cast %pointer_byte_offset : offset to i64
  %8 = scalar.addi %7, %36 : i64
  %9 = scalar.assume %8 [range(%8, 0, 9223372036854775807)] : i64
  %10 = index.cast %9 : i64 to offset
  %11 = buffer.view %pointer[%10] : buffer -> view<1xi32>
  %12 = view.load %11[0] : view<1xi32> -> i32
  func.return %12 : i32
}

func.def public @exchange(%pointer: buffer, %pointer_byte_offset: offset, %index: i32, %replacement: i32) -> (i32) {
  %18 = scalar.extsi %index : i32 to i64
  %39 = scalar.constant 2 : i64
  %40 = scalar.shli %18, %39 : i64
  %21 = index.cast %pointer_byte_offset : offset to i64
  %22 = scalar.addi %21, %40 : i64
  %23 = scalar.assume %22 [range(%22, 0, 9223372036854775807)] : i64
  %24 = index.cast %23 : i64 to offset
  %25 = buffer.view %pointer[%24] : buffer -> view<1xi32>
  %previous = view.load %25[0] : view<1xi32> -> i32
  view.store %replacement, %25[0] : i32, view<1xi32>
  func.return %previous : i32
}

// ====
// RUN: pass canonicalize,cse,dce
// Member projection and nested helper displacement both retain the root
// and accumulate their offsets onto the caller-provided interior origin.
struct Pair {
  // Leading member that determines the following member's byte offset.
  int first;
  // Member selected through an interior record pointer.
  int second;
};
int read_member(const Pair* pointer) { return pointer->second; }
static int load_next(const int* pointer) { return pointer[1]; }
int read_helper(const int* pointer) { return load_next(pointer + 1); }
// ----
func.def public @read_member(%pointer: buffer, %pointer_byte_offset: offset) -> (i32) {
  %3 = index.constant 4 : offset
  %4 = index.add %pointer_byte_offset, %3 : offset
  %5 = buffer.view %pointer[%4] : buffer -> view<1xi32>
  %second = view.load %5[0] : view<1xi32> -> i32
  func.return %second : i32
}

func.def public @read_helper(%pointer: buffer, %pointer_byte_offset: offset) -> (i32) {
  %32 = scalar.constant 4 : i64
  %14 = index.cast %pointer_byte_offset : offset to i64
  %15 = scalar.addi %14, %32 : i64
  %16 = scalar.assume %15 [range(%15, 0, 9223372036854775807)] : i64
  %17 = index.cast %16 : i64 to offset
  %18 = func.call readonly @load_next(%pointer, %17) : (buffer, offset) -> (i32)
  func.return %18 : i32
}

func.def @load_next(%pointer: buffer, %pointer_byte_offset: offset) -> (i32) {
  %33 = scalar.constant 4 : i64
  %26 = index.cast %pointer_byte_offset : offset to i64
  %27 = scalar.addi %26, %33 : i64
  %28 = scalar.assume %27 [range(%27, 0, 9223372036854775807)] : i64
  %29 = index.cast %28 : i64 to offset
  %30 = buffer.view %pointer[%29] : buffer -> view<1xi32>
  %31 = view.load %30[0] : view<1xi32> -> i32
  func.return %31 : i32
}
