// RUN: pass canonicalize,cse,dce
// Bitmap updates reuse one resolved address for both accesses.
unsigned update(unsigned* words, unsigned index, unsigned mask) {
  return words[index] |= mask;
}

// ----
func.def public @update(%words: buffer, %words_byte_offset: index, %index: i32, %mask: i32) -> (i32) {
  %5 = scalar.extui %index : i32 to i64
  %6 = index.cast %5 : i64 to index
  %7 = index.constant 4 : index
  %13 = index.madd %6, %7, %words_byte_offset : index
  %10 = buffer.view %words[%13] : buffer -> view<1xi32>
  %11 = view.load<root_in_bounds|type_disjoint> %10[0] : view<1xi32> -> i32
  %12 = scalar.ori %11, %mask : i32
  view.store<root_in_bounds|type_disjoint> %12, %10[0] : i32, view<1xi32>
  func.return %12 : i32
}

// ====
// Address and RHS effects execute once, with the RHS sequenced first.
unsigned update(unsigned* words, unsigned index, unsigned mask) {
  unsigned result = words[index++] |= (index += 1, mask);
  return result + index;
}

