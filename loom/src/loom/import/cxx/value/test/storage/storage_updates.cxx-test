func.def public @update(%words: buffer, %words_byte_offset: index, %index$2: i32, %mask: i32) -> (i32) {
  %5 = scalar.constant 1 : i32
  %index$6 = scalar.addi %index$2, %5 : i32
  %9 = scalar.extui %index$6 : i32 to i64
  %10 = index.cast %9 : i64 to index
  %11 = index.constant 4 : index
  %20 = index.madd %10, %11, %words_byte_offset : index
  %14 = buffer.view %words[%20] : buffer -> view<1xi32>
  %15 = view.load<root_in_bounds|type_disjoint> %14[0] : view<1xi32> -> i32
  %result = scalar.ori %15, %mask : i32
  view.store<root_in_bounds|type_disjoint> %result, %14[0] : i32, view<1xi32>
  %18 = scalar.addi %index$6, %result : i32
  %19 = scalar.addi %18, %5 : i32
  func.return %19 : i32
}

// ====
// Pointer effects preserve the location selected for the update.
unsigned update(unsigned* words) {
  unsigned previous = (*words++)++;
  return previous + ++words[0];
}

// ----
func.def public @update(%words: buffer, %words_byte_offset$1: index) -> (i32) {
  %22 = index.constant 4 : index
  %words_byte_offset$7 = index.add %words_byte_offset$1, %22 : index
  %8 = buffer.view %words[%words_byte_offset$1] : buffer -> view<1xi32>
  %previous = view.load<root_in_bounds|type_disjoint> %8[0] : view<1xi32> -> i32
  %10 = scalar.constant 1 : i32
  %11 = scalar.addi %previous, %10 : i32
  view.store<root_in_bounds|type_disjoint> %11, %8[0] : i32, view<1xi32>
  %17 = buffer.view %words[%words_byte_offset$7] : buffer -> view<1xi32>
  %18 = view.load<root_in_bounds|type_disjoint> %17[0] : view<1xi32> -> i32
  %20 = scalar.addi %18, %10 : i32
  view.store<root_in_bounds|type_disjoint> %20, %17[0] : i32, view<1xi32>
  %21 = scalar.addi %previous, %20 : i32
  func.return %21 : i32
}

// ====
// Both signed and unsigned narrow elements use promoted arithmetic.
int update(unsigned char* bytes, signed char* signed_bytes, int amount) {
  unsigned first = bytes[0] += amount;
  int second = signed_bytes[0] /= amount;
  return first + second;
}

// ----
func.def public @update(%bytes: buffer, %bytes_byte_offset: index, %signed_bytes: buffer, %signed_bytes_byte_offset: index, %amount: i32) -> (i32) {
  %11 = buffer.view %bytes[%bytes_byte_offset] : buffer -> view<1xi8>
  %12 = view.load<root_in_bounds> %11[0] : view<1xi8> -> i8
  %13 = scalar.extui %12 : i8 to i32
  %14 = scalar.addi %13, %amount : i32
  %15 = scalar.trunci %14 : i32 to i8
  view.store<root_in_bounds> %15, %11[0] : i8, view<1xi8>
  %first = scalar.extui %15 : i8 to i32
  %22 = buffer.view %signed_bytes[%signed_bytes_byte_offset] : buffer -> view<1xi8>
  %23 = view.load<root_in_bounds|type_disjoint> %22[0] : view<1xi8> -> i8
  %24 = scalar.extsi %23 : i8 to i32
  %25 = scalar.divsi %24, %amount : i32
  %26 = scalar.trunci %25 : i32 to i8
  view.store<root_in_bounds|type_disjoint> %26, %22[0] : i8, view<1xi8>
  %second = scalar.extsi %26 : i8 to i32
  %28 = scalar.addi %first, %second : i32
  func.return %28 : i32
}

// ====
// Vector storage retains its lane footprint and observable access flags.
using Words = unsigned __attribute__((vector_size(16)));
Words update(volatile Words* words, Words mask) { return *words ^= mask; }

// ----
func.def public @update(%words: buffer, %words_byte_offset: index, %mask: vector<4xi32>) -> (vector<4xi32>) {
  %4 = buffer.view %words[%words_byte_offset] : buffer -> view<4xi32>
  %5 = vector.load<volatile|root_in_bounds> %4[0] : view<4xi32> -> vector<4xi32>
  %6 = vector.xori %5, %mask : vector<4xi32>
  vector.store<volatile|root_in_bounds> %6, %4[0] : vector<4xi32>, view<4xi32>
  func.return %6 : vector<4xi32>
}

// ====
// Fixed workgroup arrays retain their indexed view for both accesses.
#include <loomcxx/kernel.h>
[[loom::kernel, loom::workgroup_size(64, 1, 1)]]
void update(unsigned* output) {
  [[loom::workgroup]] volatile unsigned words[64];
  unsigned index = loom::kernel::workitem::id.x;
  words[index] = index;
  words[index] += 5;
  output[index] = words[index];
}

// ----
kernel.def @update() {
  %workgroup_count_x = config.get @update.workgroup_count.x : index
  %workgroup_count_y = config.get @update.workgroup_count.y : index
  %workgroup_count_z = config.get @update.workgroup_count.z : index
  %7 = index.constant 64 : index
  %8 = index.constant 1 : index
  kernel.launch.config workgroups(%workgroup_count_x, %workgroup_count_y, %workgroup_count_z) workgroup_size(%7, %8, %8) : index
} launch(%output: buffer) {
  %11 = index.constant 256 : offset
  %words = buffer.alloca<workgroup> align(4) %11 : buffer
  %words_byte_offset = index.constant 0 : index
  %words_view = buffer.view %words[%words_byte_offset] : buffer -> view<64xi32>
  %workitem_id_x = kernel.workitem.id<x> : index
  %index = index.cast %workitem_id_x : index to i32
  %17 = scalar.extui %index : i32 to i64
  %18 = scalar.assume %17 [range(%17, 0, 63)] : i64
  %19 = index.cast %18 : i64 to index
  view.store<volatile|type_disjoint> %index, %words_view[%19] : i32, view<64xi32>
  %20 = scalar.constant 5 : i32
  %24 = view.load<volatile|type_disjoint> %words_view[%19] : view<64xi32> -> i32
  %25 = scalar.addi %24, %20 : i32
  view.store<volatile|type_disjoint> %25, %words_view[%19] : i32, view<64xi32>
  %29 = view.load<volatile|type_disjoint> %words_view[%19] : view<64xi32> -> i32
  %32 = index.constant 4 : index
  %33 = index.mul %19, %32 : index
  %35 = buffer.view %output[%33] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %29, %35[0] : i32, view<1xi32>
  kernel.return
}

config.decl @update.workgroup_count.x : index

config.decl @update.workgroup_count.y : index

config.decl @update.workgroup_count.z : index

// ====
// RUN: pass canonicalize,cse,dce
// Scalar workgroup objects use ordinary scalar lvalue and address semantics.
#include <loomcxx/kernel.h>
[[loom::kernel, loom::workgroup_size(1, 1, 1),
  loom::workgroup_count(1, 1, 1)]]
void update(unsigned input, unsigned* output) {
  [[loom::workgroup]] unsigned __attribute__((aligned(32))) slot;
  unsigned* alias = &slot;
  *alias = input;
  slot += 5u;
  loom::kernel::workgroup::barrier();
  output[0] = *alias;
}

// ----
kernel.def @update() {
  %2 = index.constant 1 : index
  kernel.launch.config workgroups(%2, %2, %2) workgroup_size(%2, %2, %2) : index
} launch(%input: i32, %output: buffer) {
  %9 = index.constant 4 : offset
  %slot_storage = buffer.alloca<workgroup> align(32) %9 : buffer
  %slot_storage_byte_offset = index.constant 0 : index
  %slot_view = buffer.view %slot_storage[%slot_storage_byte_offset] : buffer -> view<1xi32>
  view.store<type_disjoint> %input, %slot_view[0] : i32, view<1xi32>
  %15 = scalar.constant 5 : i32
  %16 = view.load<type_disjoint> %slot_view[0] : view<1xi32> -> i32
  %17 = scalar.addi %16, %15 : i32
  view.store<type_disjoint> %17, %slot_view[0] : i32, view<1xi32>
  kernel.barrier<global> scope(workgroup) ordering(acq_rel)
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %20 = view.load<type_disjoint> %slot_view[0] : view<1xi32> -> i32
  %26 = buffer.view %output[%slot_storage_byte_offset] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %20, %26[0] : i32, view<1xi32>
  kernel.return
}

// ====
// RUN: pass canonicalize,cse,dce
// Supported vector objects share the same workgroup storage contract.
#include <loomcxx/kernel.h>
using Words = unsigned __attribute__((vector_size(16)));
[[loom::kernel, loom::workgroup_size(1, 1, 1),
  loom::workgroup_count(1, 1, 1)]]
void update(Words input, Words* output) {
  [[loom::workgroup]] Words slot;
  slot = input;
  loom::kernel::workgroup::barrier();
  output[0] = slot;
}

// ----
kernel.def @update() {
  %2 = index.constant 1 : index
  kernel.launch.config workgroups(%2, %2, %2) workgroup_size(%2, %2, %2) : index
} launch(%input: vector<4xi32>, %output: buffer) {
  %9 = index.constant 16 : offset
  %slot_storage = buffer.alloca<workgroup> align(16) %9 : buffer
  %slot_storage_byte_offset = index.constant 0 : index
  %slot_view = buffer.view %slot_storage[%slot_storage_byte_offset] : buffer -> view<4xi32>
  vector.store %input, %slot_view[0] : vector<4xi32>, view<4xi32>
  kernel.barrier<global> scope(workgroup) ordering(acq_rel)
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %slot = vector.load %slot_view[0] : view<4xi32> -> vector<4xi32>
  %19 = buffer.view %output[%slot_storage_byte_offset] : buffer -> view<4xi32>
  vector.store<root_in_bounds> %slot, %19[0] : vector<4xi32>, view<4xi32>
  kernel.return
}

// ====
// RUN: verify
// Workgroup lifetime belongs to a kernel or selected template body.
#include <loomcxx/kernel.h>
void helper() {
  // ERROR@+1: LOWERING/059 "requires a kernel or template definition body"
  LOOM_WORKGROUP unsigned slot;
}

// ====
// RUN: verify
// Workgroup storage begins uninitialized for the cooperating invocations.
#include <loomcxx/kernel.h>
LOOM_KERNEL void initialized() {
  // ERROR@+1: LOWERING/059 "workgroup storage cannot have an initializer"
  LOOM_WORKGROUP unsigned slot = 0;
}

// ====
// Discarded compound results emit exactly one volatile read and write.
void update(volatile unsigned* words, unsigned mask) {
  *words |= mask;
  ++words[0];
  (*words)--;
}

// ----
func.def public @update(%words: buffer, %words_byte_offset: index, %mask: i32) {
  %3 = buffer.view %words[%words_byte_offset] : buffer -> view<1xi32>
  %4 = view.load<volatile|root_in_bounds|type_disjoint> %3[0] : view<1xi32> -> i32
  %5 = scalar.ori %4, %mask : i32
  view.store<volatile|root_in_bounds|type_disjoint> %5, %3[0] : i32, view<1xi32>
  %12 = view.load<volatile|root_in_bounds|type_disjoint> %3[0] : view<1xi32> -> i32
  %13 = scalar.constant 1 : i32
  %14 = scalar.addi %12, %13 : i32
  view.store<volatile|root_in_bounds|type_disjoint> %14, %3[0] : i32, view<1xi32>
  %16 = view.load<volatile|root_in_bounds|type_disjoint> %3[0] : view<1xi32> -> i32
  %19 = scalar.constant -1 : i32
  %20 = scalar.addi %16, %19 : i32
  view.store<volatile|root_in_bounds|type_disjoint> %20, %3[0] : i32, view<1xi32>
  func.return
}

// ====
// C compound assignment uses the same promoted load/update/store contract.
// INPUT: cxx std=c23
unsigned update(unsigned char* bytes, unsigned amount) {
  return *bytes += amount;
}

// ----
func.def public source_signature(#func.abi.c.signature<arguments = [0, 1], results = [1], types = [#func.abi.c.type<pointer, byte_length = 8, byte_alignment = 8, component_count = 2>, #func.abi.c.type<unsigned_integer, byte_length = 4, byte_alignment = 4, component_count = 1, bitwidth = 32>]>) @update(%bytes: buffer, %bytes_byte_offset: index, %amount: i32) -> (i32) {
  %4 = buffer.view %bytes[%bytes_byte_offset] : buffer -> view<1xi8>
  %5 = view.load<root_in_bounds> %4[0] : view<1xi8> -> i8
  %6 = scalar.extui %5 : i8 to i32
  %7 = scalar.addi %6, %amount : i32
  %8 = scalar.trunci %7 : i32 to i8
  view.store<root_in_bounds> %8, %4[0] : i8, view<1xi8>
  %9 = scalar.extui %8 : i8 to i32
  func.return %9 : i32
}
