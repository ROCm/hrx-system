// ====
// Qualifiers on an aggregate apply to each nested array initialization store.
struct Record { unsigned values[2][2]; };
unsigned record_initializer(unsigned input) {
  volatile Record value{{{input, 7}, {11, 13}}};
  return value.values[0][0] + value.values[1][1];
}

