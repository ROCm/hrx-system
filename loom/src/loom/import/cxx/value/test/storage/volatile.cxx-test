  %20 = view.load<volatile|root_in_bounds|type_disjoint> %10[0] : view<1xi32> -> i32
  %22 = view.load<volatile|root_in_bounds|type_disjoint> %10[0] : view<1xi32> -> i32
  %first = view.load<volatile|root_in_bounds|type_disjoint> %10[0] : view<1xi32> -> i32
  %second = view.load<volatile|root_in_bounds|type_disjoint> %10[0] : view<1xi32> -> i32
