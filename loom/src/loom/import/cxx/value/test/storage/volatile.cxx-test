// ====
// Top-level qualification belongs to the callee's parameter object rather than
// its callable ABI. Initialization and every source read remain observable.
unsigned parameter_observations(unsigned value);
unsigned parameter_observations(volatile unsigned value) {
  static_cast<void>(value);
  return value;
}
using Words = unsigned __attribute__((vector_size(16)));
Words vector_parameter_observations(volatile Words value) {
  static_cast<void>(value);
  return value;
}
bool boolean_parameter_observation(volatile bool value) { return value; }
unsigned constant_parameter_observation(const volatile unsigned value) {
  return value;
}

