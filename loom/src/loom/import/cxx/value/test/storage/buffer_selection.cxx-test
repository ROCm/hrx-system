// RUN: pass canonicalize,cse,dce
// Writes through a selected root are observed through that pointer and
// through both original interior pointers, with distinct output positions.
unsigned* choose_pointer(bool choose_first, unsigned* first, unsigned* second) {
  return choose_first ? first : second;
}
void observe_selection(unsigned* input, unsigned* output, unsigned choice) {
  for (unsigned word = 0; word < 16u; ++word) {
    unsigned* first = input + 16u + word;
    unsigned* second = output + 64u + word;
    unsigned* selected =
        choose_pointer(((choice + word) & 1u) != 0u, first, second);
    *selected ^= 0x7f00ff80u;
    output[128u + word] = *selected;
    output[160u + word] = *first;
    output[192u + word] = *second;
  }
}
// ----
func.def public @choose_pointer(%choose_first: i1, %first: buffer, %first_byte_offset: offset, %second: buffer, %second_byte_offset: offset) -> (buffer, offset) {
  %98 = scf.select %choose_first, %first, %second : buffer
  %99 = scf.select %choose_first, %first_byte_offset, %second_byte_offset : offset
  func.return %98, %99 : buffer, offset
}

func.def public @observe_selection(%input: buffer, %input_byte_offset: offset, %output: buffer, %output_byte_offset: offset, %choice: i32) {
  %103 = index.constant 0 : offset
  %102 = index.constant 16 : offset
  %18 = index.constant 1 : offset
  scf.for %word = [%103 to %102 step %18] {
    %20 = index.cast %word : offset to i32
    %101 = scalar.constant 64 : i64
    %25 = index.cast %input_byte_offset : offset to i64
    %26 = scalar.addi %25, %101 : i64
    %27 = scalar.assume %26 [range(%26, 0, 9223372036854775807)] : i64
    %28 = index.cast %27 : i64 to offset
    %29 = scalar.extui %20 : i32 to i64
    %115 = scalar.constant 2 : i64
    %116 = scalar.shli %29, %115 : i64
    %32 = index.cast %28 : offset to i64
    %33 = scalar.addi %32, %116 : i64
    %34 = scalar.assume %33 [range(%33, 0, 9223372036854775807)] : i64
    %first_byte_offset = index.cast %34 : i64 to offset
    %100 = scalar.constant 256 : i64
    %40 = index.cast %output_byte_offset : offset to i64
    %41 = scalar.addi %40, %100 : i64
    %42 = scalar.assume %41 [range(%41, 0, 9223372036854775807)] : i64
    %43 = index.cast %42 : i64 to offset
    %47 = index.cast %43 : offset to i64
    %48 = scalar.addi %47, %116 : i64
    %49 = scalar.assume %48 [range(%48, 0, 9223372036854775807)] : i64
    %second_byte_offset = index.cast %49 : i64 to offset
    %51 = scalar.addi %choice, %20 : i32
    %52 = scalar.constant 1 : i32
    %53 = scalar.andi %51, %52 : i32
    %54 = scalar.constant 0 : i32
    %55 = scalar.cmpi ne, %53, %54 : i32
    %selected, %selected_byte_offset = func.call pure @choose_pointer(%55, %input, %first_byte_offset, %output, %second_byte_offset) : (i1, buffer, offset, buffer, offset) -> (buffer, offset)
    %58 = scalar.constant 2130771840 : i32
    %59 = buffer.view %selected[%selected_byte_offset] : buffer -> view<1xi32>
    %60 = view.load<root_in_bounds> %59[0] : view<1xi32> -> i32
    %61 = scalar.xori %60, %58 : i32
    view.store<root_in_bounds> %61, %59[0] : i32, view<1xi32>
    %63 = view.load<root_in_bounds> %59[0] : view<1xi32> -> i32
    %64 = scalar.constant 128 : i32
    %112 = scalar.addi %20, %64 : i32
    %66 = scalar.extui %112 : i32 to i64
    %111 = scalar.shli %66, %115 : i64
    %70 = scalar.addi %40, %111 : i64
    %71 = scalar.assume %70 [range(%70, 0, 9223372036854775807)] : i64
    %72 = index.cast %71 : i64 to offset
    %73 = buffer.view %output[%72] : buffer -> view<1xi32>
    view.store<root_in_bounds> %63, %73[0] : i32, view<1xi32>
    %74 = buffer.view %input[%first_byte_offset] : buffer -> view<1xi32>
    %75 = view.load<root_in_bounds> %74[0] : view<1xi32> -> i32
    %76 = scalar.constant 160 : i32
    %109 = scalar.addi %20, %76 : i32
    %78 = scalar.extui %109 : i32 to i64
    %108 = scalar.shli %78, %115 : i64
    %82 = scalar.addi %40, %108 : i64
    %83 = scalar.assume %82 [range(%82, 0, 9223372036854775807)] : i64
    %84 = index.cast %83 : i64 to offset
    %85 = buffer.view %output[%84] : buffer -> view<1xi32>
    view.store<root_in_bounds> %75, %85[0] : i32, view<1xi32>
    %86 = buffer.view %output[%second_byte_offset] : buffer -> view<1xi32>
    %87 = view.load<root_in_bounds> %86[0] : view<1xi32> -> i32
    %88 = scalar.constant 192 : i32
    %106 = scalar.addi %20, %88 : i32
    %90 = scalar.extui %106 : i32 to i64
    %105 = scalar.shli %90, %115 : i64
    %94 = scalar.addi %40, %105 : i64
    %95 = scalar.assume %94 [range(%94, 0, 9223372036854775807)] : i64
    %96 = index.cast %95 : i64 to offset
    %97 = buffer.view %output[%96] : buffer -> view<1xi32>
    view.store<root_in_bounds> %87, %97[0] : i32, view<1xi32>
  }
  func.return
}

// ====
// RUN: pass canonicalize,cse,dce
// Each backedge simultaneously exchanges both root and byte origin of
// two pointers. Zero trips retain their initial coordinates.
using U16 = unsigned __attribute__((vector_size(64)));
void swap_coordinates(unsigned* input, unsigned* output, unsigned count) {
  unsigned* current = input + 32u;
  unsigned* other = output + 96u;
  for (unsigned iteration = 0; iteration < count; ++iteration) {
    unsigned* previous = current;
    current = other;
    other = previous;
  }
  *reinterpret_cast<U16*>(output + 224u) =
      *reinterpret_cast<const U16*>(current);
  *reinterpret_cast<U16*>(output + 240u) = *reinterpret_cast<const U16*>(other);
}
// ----
func.def public @swap_coordinates(%input: buffer, %input_byte_offset: offset, %output: buffer, %output_byte_offset: offset, %count: i32) {
  %61 = scalar.constant 128 : i64
  %9 = index.cast %input_byte_offset : offset to i64
  %10 = scalar.addi %9, %61 : i64
  %11 = scalar.assume %10 [range(%10, 0, 9223372036854775807)] : i64
  %current_byte_offset$12 = index.cast %11 : i64 to offset
  %60 = scalar.constant 384 : i64
  %17 = index.cast %output_byte_offset : offset to i64
  %18 = scalar.addi %17, %60 : i64
  %19 = scalar.assume %18 [range(%18, 0, 9223372036854775807)] : i64
  %other_byte_offset$20 = index.cast %19 : i64 to offset
  %59 = index.constant 0 : offset
  %23 = index.cast %count : i32 to offset
  %24 = index.constant 1 : offset
  %current, %current_byte_offset$31, %other, %other_byte_offset$33 = scf.for %iteration = [%59 to %23 step %24](%current = %input : buffer, %current_byte_offset = %current_byte_offset$12 : offset, %other = %output : buffer, %other_byte_offset = %other_byte_offset$20 : offset) -> (buffer, offset, buffer, offset) {
    scf.yield %other, %other_byte_offset, %current, %current_byte_offset : buffer, offset, buffer, offset
  }
  %35 = buffer.view %current[%current_byte_offset$31] : buffer -> view<16xi32>
  %36 = vector.load<root_in_bounds> %35[0] : view<16xi32> -> vector<16xi32>
  %58 = scalar.constant 896 : i64
  %42 = scalar.addi %17, %58 : i64
  %43 = scalar.assume %42 [range(%42, 0, 9223372036854775807)] : i64
  %44 = index.cast %43 : i64 to offset
  %45 = buffer.view %output[%44] : buffer -> view<16xi32>
  vector.store<root_in_bounds> %36, %45[0] : vector<16xi32>, view<16xi32>
  %46 = buffer.view %other[%other_byte_offset$33] : buffer -> view<16xi32>
  %47 = vector.load<root_in_bounds> %46[0] : view<16xi32> -> vector<16xi32>
  %57 = scalar.constant 960 : i64
  %53 = scalar.addi %17, %57 : i64
  %54 = scalar.assume %53 [range(%53, 0, 9223372036854775807)] : i64
  %55 = index.cast %54 : i64 to offset
  %56 = buffer.view %output[%55] : buffer -> view<16xi32>
  vector.store<root_in_bounds> %47, %56[0] : vector<16xi32>, view<16xi32>
  func.return
}

// ====
// RUN: pass canonicalize,cse,dce
// Destination initialization retains its full loop bound, element offsets,
// and per-element values used by later selected-root observations.
void initialize_selection(unsigned* output) {
  for (unsigned word = 0; word < 256u; ++word) {
    output[word] = 0x6bad0000u + word;
  }
}
// ----
func.def public @initialize_selection(%output: buffer, %output_byte_offset: offset) {
  %20 = index.constant 0 : offset
  %19 = index.constant 256 : offset
  %6 = index.constant 1 : offset
  scf.for %word = [%20 to %19 step %6] {
    %8 = index.cast %word : offset to i32
    %9 = scalar.constant 1806499840 : i32
    %23 = scalar.addi %8, %9 : i32
    %11 = scalar.extui %8 : i32 to i64
    %21 = scalar.constant 2 : i64
    %22 = scalar.shli %11, %21 : i64
    %14 = index.cast %output_byte_offset : offset to i64
    %15 = scalar.addi %14, %22 : i64
    %16 = scalar.assume %15 [range(%15, 0, 9223372036854775807)] : i64
    %17 = index.cast %16 : i64 to offset
    %18 = buffer.view %output[%17] : buffer -> view<1xi32>
    view.store<root_in_bounds> %23, %18[0] : i32, view<1xi32>
  }
  func.return
}
