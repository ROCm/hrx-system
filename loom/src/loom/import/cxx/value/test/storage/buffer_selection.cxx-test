// RUN: pass canonicalize,cse,dce
// Writes through a selected root are observed through that pointer and
// through both original interior pointers, with distinct output positions.
unsigned* choose_pointer(bool choose_first, unsigned* first, unsigned* second) {
  return choose_first ? first : second;
}
void observe_selection(unsigned* input, unsigned* output, unsigned choice) {
  for (unsigned word = 0; word < 16u; ++word) {
    unsigned* first = input + 16u + word;
    unsigned* second = output + 64u + word;
    unsigned* selected =
        choose_pointer(((choice + word) & 1u) != 0u, first, second);
    *selected ^= 0x7f00ff80u;
    output[128u + word] = *selected;
    output[160u + word] = *first;
    output[192u + word] = *second;
  }
}
// ----
func.def public @choose_pointer(%choose_first: i1, %first: buffer, %first_byte_offset: index, %second: buffer, %second_byte_offset: index) -> (buffer, index) {
  %84 = scf.select %choose_first, %first, %second : buffer
  %85 = scf.select %choose_first, %first_byte_offset, %second_byte_offset : index
  func.return %84, %85 : buffer, index
}

func.def public @observe_selection(%input: buffer, %input_byte_offset: index, %output: buffer, %output_byte_offset: index, %choice: i32) {
  %89 = index.constant 0 : offset
  %88 = index.constant 16 : offset
  %18 = index.constant 1 : offset
  scf.for %word = [%89 to %88 step %18] {
    %20 = index.cast %word : offset to i32
    %87 = index.constant 64 : index
    %26 = index.add %input_byte_offset, %87 : index
    %27 = scalar.extui %20 : i32 to i64
    %28 = index.cast %27 : i64 to index
    %29 = index.constant 4 : index
    %first_byte_offset = index.madd %28, %29, %26 : index
    %86 = index.constant 256 : index
    %37 = index.add %output_byte_offset, %86 : index
    %second_byte_offset = index.madd %28, %29, %37 : index
    %43 = scalar.addi %choice, %20 : i32
    %44 = scalar.constant 1 : i32
    %45 = scalar.andi %43, %44 : i32
    %46 = scalar.constant 0 : i32
    %47 = scalar.cmpi ne, %45, %46 : i32
    %selected, %selected_byte_offset = func.call pure @choose_pointer(%47, %input, %first_byte_offset, %output, %second_byte_offset) : (i1, buffer, index, buffer, index) -> (buffer, index)
    %50 = scalar.constant 2130771840 : i32
    %51 = buffer.view %selected[%selected_byte_offset] : buffer -> view<1xi32>
    %52 = view.load<root_in_bounds|type_disjoint> %51[0] : view<1xi32> -> i32
    %53 = scalar.xori %52, %50 : i32
    view.store<root_in_bounds|type_disjoint> %53, %51[0] : i32, view<1xi32>
    %55 = view.load<root_in_bounds|type_disjoint> %51[0] : view<1xi32> -> i32
    %56 = scalar.constant 128 : i32
    %95 = scalar.addi %20, %56 : i32
    %58 = scalar.extui %95 : i32 to i64
    %59 = index.cast %58 : i64 to index
    %94 = index.madd %59, %29, %output_byte_offset : index
    %63 = buffer.view %output[%94] : buffer -> view<1xi32>
    view.store<root_in_bounds|type_disjoint> %55, %63[0] : i32, view<1xi32>
    %64 = buffer.view %input[%first_byte_offset] : buffer -> view<1xi32>
    %65 = view.load<root_in_bounds|type_disjoint> %64[0] : view<1xi32> -> i32
    %66 = scalar.constant 160 : i32
    %93 = scalar.addi %20, %66 : i32
    %68 = scalar.extui %93 : i32 to i64
    %69 = index.cast %68 : i64 to index
    %92 = index.madd %69, %29, %output_byte_offset : index
    %73 = buffer.view %output[%92] : buffer -> view<1xi32>
    view.store<root_in_bounds|type_disjoint> %65, %73[0] : i32, view<1xi32>
    %74 = buffer.view %output[%second_byte_offset] : buffer -> view<1xi32>
    %75 = view.load<root_in_bounds|type_disjoint> %74[0] : view<1xi32> -> i32
    %76 = scalar.constant 192 : i32
    %91 = scalar.addi %20, %76 : i32
    %78 = scalar.extui %91 : i32 to i64
    %79 = index.cast %78 : i64 to index
    %90 = index.madd %79, %29, %output_byte_offset : index
    %83 = buffer.view %output[%90] : buffer -> view<1xi32>
    view.store<root_in_bounds|type_disjoint> %75, %83[0] : i32, view<1xi32>
  }
  func.return
}

// ====
// RUN: pass canonicalize,cse,dce
// Each backedge simultaneously exchanges both root and byte origin of
// two pointers. Zero trips retain their initial coordinates.
using U16 = unsigned __attribute__((vector_size(64)));
void swap_coordinates(unsigned* input, unsigned* output, unsigned count) {
  unsigned* current = input + 32u;
  unsigned* other = output + 96u;
  for (unsigned iteration = 0; iteration < count; ++iteration) {
    unsigned* previous = current;
    current = other;
    other = previous;
  }
  *reinterpret_cast<U16*>(output + 224u) =
      *reinterpret_cast<const U16*>(current);
  *reinterpret_cast<U16*>(output + 240u) = *reinterpret_cast<const U16*>(other);
}
// ----
func.def public @swap_coordinates(%input: buffer, %input_byte_offset: index, %output: buffer, %output_byte_offset: index, %count: i32) {
  %53 = index.constant 128 : index
  %current_byte_offset$10 = index.add %input_byte_offset, %53 : index
  %52 = index.constant 384 : index
  %other_byte_offset$16 = index.add %output_byte_offset, %52 : index
  %51 = index.constant 0 : offset
  %19 = index.cast %count : i32 to offset
  %20 = index.constant 1 : offset
  %current, %current_byte_offset$27, %other, %other_byte_offset$29 = scf.for %iteration = [%51 to %19 step %20](%current = %input : buffer, %current_byte_offset = %current_byte_offset$10 : index, %other = %output : buffer, %other_byte_offset = %other_byte_offset$16 : index) -> (buffer, index, buffer, index) {
    scf.yield %other, %other_byte_offset, %current, %current_byte_offset : buffer, index, buffer, index
  }
  %31 = buffer.view %current[%current_byte_offset$27] : buffer -> view<16xi32>
  %32 = vector.load<root_in_bounds> %31[0] : view<16xi32> -> vector<16xi32>
  %50 = index.constant 896 : index
  %38 = index.add %output_byte_offset, %50 : index
  %39 = buffer.view %output[%38] : buffer -> view<16xi32>
  vector.store<root_in_bounds> %32, %39[0] : vector<16xi32>, view<16xi32>
  %40 = buffer.view %other[%other_byte_offset$29] : buffer -> view<16xi32>
  %41 = vector.load<root_in_bounds> %40[0] : view<16xi32> -> vector<16xi32>
  %49 = index.constant 960 : index
  %47 = index.add %output_byte_offset, %49 : index
  %48 = buffer.view %output[%47] : buffer -> view<16xi32>
  vector.store<root_in_bounds> %41, %48[0] : vector<16xi32>, view<16xi32>
  func.return
}

// ====
// RUN: pass canonicalize,cse,dce
// Destination initialization retains its full loop bound, element offsets,
// and per-element values used by later selected-root observations.
void initialize_selection(unsigned* output) {
  for (unsigned word = 0; word < 256u; ++word) {
    output[word] = 0x6bad0000u + word;
  }
}
// ----
func.def public @initialize_selection(%output: buffer, %output_byte_offset: index) {
  %18 = index.constant 0 : offset
  %17 = index.constant 256 : offset
  %6 = index.constant 1 : offset
  scf.for %word = [%18 to %17 step %6] {
    %8 = index.cast %word : offset to i32
    %9 = scalar.constant 1806499840 : i32
    %20 = scalar.addi %8, %9 : i32
    %11 = scalar.extui %8 : i32 to i64
    %12 = index.cast %11 : i64 to index
    %13 = index.constant 4 : index
    %19 = index.madd %12, %13, %output_byte_offset : index
    %16 = buffer.view %output[%19] : buffer -> view<1xi32>
    view.store<root_in_bounds|type_disjoint> %20, %16[0] : i32, view<1xi32>
  }
  func.return
}
