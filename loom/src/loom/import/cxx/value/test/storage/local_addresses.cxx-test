// RUN: pass inline-callables,promote-private-fragments,canonicalize,cse,dce
// The source owns the temporary; shared promotion, after ordinary inlining,
// carries its mutated value out of the conditional without temporary memory.
[[loom::inline]] static void increment(unsigned* value) { ++*value; }
unsigned update(unsigned input, unsigned enabled) {
  unsigned value = input;
  if (enabled) increment(&value);
  return value;
}
// ----
func.def public @update(%input: i32, %enabled: i32) -> (i32) {
  %7 = scalar.constant 0 : i32
  %8 = scalar.cmpi ne, %enabled, %7 : i32
  %14 = scalar.constant 1 : i32
  %15 = scalar.addi %input, %14 : i32
  %17 = scf.select %8, %15, %input : i32
  func.return %17 : i32
}

// ====
// RUN: pass canonicalize,cse,dce
// Default initialization leaves scalar and native vector objects
// indeterminate. Their first source writes initialize private storage; no
// invented value is stored at the declaration.
typedef unsigned uint4 __attribute__((vector_size(16)));
double select(bool first, double left, double right) {
  double result;
  if (first) result = left;
  else result = right;
  return result;
}
uint4 copy(uint4 input) {
  uint4 result;
  result = input;
  return result;
}
// ----
func.def public @select(%first: i1, %left: f64, %right: f64) -> (f64) {
  %4 = index.constant 8 : offset
  %result_storage = buffer.alloca<private> align(8) %4 : buffer
  %result_storage_byte_offset = index.constant 0 : offset
  %result_view = buffer.view %result_storage[%result_storage_byte_offset] : buffer -> view<1xf64>
  scf.if %first {
    view.store %left, %result_view[0] : f64, view<1xf64>
  } else {
    view.store %right, %result_view[0] : f64, view<1xf64>
  }
  %result = view.load %result_view[0] : view<1xf64> -> f64
  func.return %result : f64
}

func.def public @copy(%input: vector<4xi32>) -> (vector<4xi32>) {
  %11 = index.constant 16 : offset
  %result_storage = buffer.alloca<private> align(16) %11 : buffer
  %result_storage_byte_offset = index.constant 0 : offset
  %result_view = buffer.view %result_storage[%result_storage_byte_offset] : buffer -> view<4xi32>
  vector.store %input, %result_view[0] : vector<4xi32>, view<4xi32>
  %result = vector.load %result_view[0] : view<4xi32> -> vector<4xi32>
  func.return %result : vector<4xi32>
}

// ====
// RUN: roundtrip
// Byte layout and over-alignment belong to the declaration, not the pointer's
// first use. The output-only helper supplies the initial stored value.
[[loom::inline]] static void initialize(unsigned short* value) { *value = 7; }
unsigned output_parameter() {
  alignas(32) unsigned short value;
  initialize(&value);
  return value;
}
// ----
func.def public @output_parameter() -> (i32) {
  %1 = index.constant 2 : offset
  %value_storage = buffer.alloca<private> align(32) %1 : buffer
  %value_storage_byte_offset = index.constant 0 : offset
  %value_view = buffer.view %value_storage[%value_storage_byte_offset] : buffer -> view<1xi16>
  func.call @initialize(%value_storage, %value_storage_byte_offset) : (buffer, offset)
  %value = view.load %value_view[0] : view<1xi16> -> i16
  %6 = scalar.extui %value : i16 to i32
  func.return %6 : i32
}

func.def inline @initialize(%value: buffer, %value_byte_offset: offset) {
  %9 = scalar.constant 7 : i32
  %10 = scalar.trunci %9 : i32 to i16
  %11 = buffer.view %value[%value_byte_offset] : buffer -> view<1xi16>
  view.store %10, %11[0] : i16, view<1xi16>
  func.return
}

// ====
// RUN: pass canonicalize,cse,promote-private-fragments,dce
// Taking an address is not required for a volatile local to own real storage.
unsigned observations(unsigned input) {
  volatile unsigned value = input;
  (void)value;
  value = input + 1;
  return value;
}
// ----
func.def public @observations(%input: i32) -> (i32) {
  %2 = index.constant 4 : offset
  %value_storage = buffer.alloca<private> align(4) %2 : buffer
  %value_storage_byte_offset = index.constant 0 : offset
  %value_view = buffer.view %value_storage[%value_storage_byte_offset] : buffer -> view<1xi32>
  view.store<volatile> %input, %value_view[0] : i32, view<1xi32>
  %value$6 = view.load<volatile> %value_view[0] : view<1xi32> -> i32
  %7 = scalar.constant 1 : i32
  %8 = scalar.addi %input, %7 : i32
  view.store<volatile> %8, %value_view[0] : i32, view<1xi32>
  %value$9 = view.load<volatile> %value_view[0] : view<1xi32> -> i32
  func.return %value$9 : i32
}

// ====
// RUN: roundtrip
// Unevaluated addresses and source-discarded branches do not demand storage.
unsigned no_storage(unsigned value) {
  (void)sizeof(&value);
  if constexpr (false) (void)&value;
  return value + 1;
}
// ----
func.def public @no_storage(%value: i32) -> (i32) {
  %2 = scalar.constant 8 : i64
  %3 = scalar.constant 1 : i32
  %4 = scalar.addi %value, %3 : i32
  func.return %4 : i32
}

// ====
// RUN: pass inline-callables,canonicalize,cse,promote-private-fragments,canonicalize,cse,dce
// A direct update before the first address expression reaches the same
// object as the helper; the false arm keeps the original value.
[[loom::inline]] static void increment(unsigned* value) { ++*value; }
unsigned conditional(unsigned input, unsigned choice) {
  unsigned value = input;
  if (choice) {
    value += 3;
    increment(&value);
  }
  return value;
}
// ----
func.def public @conditional(%input: i32, %choice: i32) -> (i32) {
  %7 = scalar.constant 0 : i32
  %8 = scalar.cmpi ne, %choice, %7 : i32
  %20 = scalar.constant 4 : i32
  %21 = scalar.addi %input, %20 : i32
  %22 = scf.select %8, %21, %input : i32
  func.return %22 : i32
}

// ====
// RUN: pass inline-callables,canonicalize,cse,promote-private-fragments,canonicalize,cse,dce
// Returned pointers and copied aliases all observe the same mutated local.
[[loom::inline]] static void increment(unsigned* value) { ++*value; }
[[loom::inline]] static unsigned* identity(unsigned* value) { return value; }
unsigned aliases(unsigned input) {
  unsigned value = input;
  auto* first = &value;
  auto* second = identity(first);
  *first += 3;
  increment(second);
  return value + *first + *second;
}
// ----
func.def public @aliases(%input: i32) -> (i32) {
  %33 = scalar.constant 4 : i32
  %34 = scalar.addi %input, %33 : i32
  %17 = scalar.addi %34, %34 : i32
  %20 = scalar.addi %17, %34 : i32
  func.return %20 : i32
}

// ====
// RUN: pass inline-callables,canonicalize,cse,promote-private-fragments,canonicalize,cse,dce
// Output-only helpers establish the first value; an addressed by-value
// parameter remains the local parameter object.
[[loom::inline]] static void increment(unsigned* value) { ++*value; }
[[loom::inline]] static void initialize(unsigned* value, unsigned input) {
  *value = input + 7;
}
unsigned output_parameter(unsigned input) {
  unsigned value;
  initialize(&value, input);
  return value;
}
unsigned parameter(unsigned value) {
  increment(&value);
  return value;
}
// ----
func.def public @output_parameter(%input: i32) -> (i32) {
  %17 = scalar.constant 7 : i32
  %18 = scalar.addi %input, %17 : i32
  func.return %18 : i32
}

func.def public @parameter(%value: i32) -> (i32) {
  %24 = scalar.constant 1 : i32
  %25 = scalar.addi %value, %24 : i32
  func.return %25 : i32
}

// ====
// RUN: pass inline-callables,canonicalize,cse,promote-private-fragments,canonicalize,cse,dce
// An aliased loop bound changes in the body and must be tested again.
unsigned mutable_bound(unsigned limit) {
  auto* bound = &limit;
  unsigned total = 0;
  for (unsigned i = 0; i < limit; ++i) {
    total += i;
    if (i == 1) {
      *bound = 2;
    }
  }
  return total;
}
// ----
func.def public @mutable_bound(%limit: i32) -> (i32) {
  %total$6 = scalar.constant 0 : i32
  %total$29, %i, %28 = scf.while(%total = %total$6 : i32, %i = %total$6 : i32, %26 = %limit : i32) -> (i32, i32, i32) {
    %15 = scalar.cmpi ult, %i, %26 : i32
    scf.condition %15, %total, %i, %26 : i1, i32, i32, i32
  } do(%total$33: i32, %i$34: i32, %27: i32) {
    %total$16 = scalar.addi %total$33, %i$34 : i32
    %17 = scalar.constant 1 : i32
    %18 = scalar.cmpi eq, %i$34, %17 : i32
    %19 = scalar.constant 2 : i32
    %35 = scf.select %18, %19, %27 : i32
    %i$23 = scalar.addi %i$34, %17 : i32
    scf.yield %total$16, %i$23, %35 : i32, i32, i32
  }
  func.return %total$29 : i32
}

// ====
// RUN: pass inline-callables,canonicalize,cse,promote-private-fragments,canonicalize,cse,dce
// Helper mutation and the for increment both update the induction object.
[[loom::inline]] static void increment(unsigned* value) { ++*value; }
unsigned mutable_induction(unsigned limit) {
  unsigned total = 0;
  for (unsigned i = 0; i < limit; ++i) {
    total += i;
    increment(&i);
  }
  return total;
}
// ----
func.def public @mutable_induction(%limit: i32) -> (i32) {
  %total$2 = scalar.constant 0 : i32
  %total$27, %26 = scf.while(%total = %total$2 : i32, %24 = %total$2 : i32) -> (i32, i32) {
    %12 = scalar.cmpi ult, %24, %limit : i32
    scf.condition %12, %total, %24 : i1, i32, i32
  } do(%total$29: i32, %25: i32) {
    %total$14 = scalar.addi %total$29, %25 : i32
    %30 = scalar.constant 2 : i32
    %31 = scalar.addi %25, %30 : i32
    scf.yield %total$14, %31 : i32, i32
  }
  func.return %total$27 : i32
}

// ====
// RUN: pass inline-callables,canonicalize,cse,promote-private-fragments,canonicalize,cse,dce
// Each loop iteration initializes a fresh local before passing its address.
[[loom::inline]] static void increment(unsigned* value) { ++*value; }
unsigned repeated_declaration(unsigned limit) {
  unsigned total = 0;
  for (unsigned i = 0; i < limit; ++i) {
    unsigned value = i;
    increment(&value);
    total += value;
  }
  return total;
}
// ----
func.def public @repeated_declaration(%limit: i32) -> (i32) {
  %total$2 = scalar.constant 0 : i32
  %23 = index.constant 0 : offset
  %5 = index.cast %limit : i32 to offset
  %6 = index.constant 1 : offset
  %total$9 = scf.for %i = [%23 to %5 step %6](%total$8 = %total$2 : i32) -> (i32) {
    %10 = index.cast %i : offset to i32
    %21 = scalar.constant 1 : i32
    %24 = scalar.addi %10, %total$8 : i32
    %total$25 = scalar.addi %24, %21 : i32
    scf.yield %total$25 : i32
  }
  func.return %total$9 : i32
}

// ====
// RUN: pass inline-callables,canonicalize,cse,promote-private-fragments,canonicalize,cse,dce
// A condition declaration is recreated on every test, including after
// continue and on the final false test.
[[loom::inline]] static void increment(unsigned* value) { ++*value; }
unsigned decision(unsigned count) {
  unsigned checks = 0;
  unsigned total = 0;
  while (unsigned value = (++checks, count--)) {
    increment(&value);
    if (value == 3) {
      continue;
    }
    total += value;
  }
  return total + 100 * checks;
}
// ----
func.def public @decision(%count$0: i32) -> (i32) {
  %total$3 = scalar.constant 0 : i32
  %checks$46 = scalar.constant 1 : i32
  %50 = scalar.constant -1 : i32
  %count$51 = scalar.addi %count$0, %50 : i32
  %checks$55, %count$56, %total$57, %54 = scf.while(%checks = %checks$46 : i32, %count = %count$51 : i32, %total = %total$3 : i32, %52 = %count$0 : i32) -> (i32, i32, i32, i32) {
    %23 = scalar.cmpi ne, %52, %total$3 : i32
    scf.condition %23, %checks, %count, %total, %52 : i1, i32, i32, i32, i32
  } do(%checks$61: i32, %count$62: i32, %total$63: i32, %53: i32) {
    %45 = scalar.addi %53, %checks$46 : i32
    %25 = scalar.constant 3 : i32
    %26 = scalar.cmpi eq, %45, %25 : i32
    %total$31 = scalar.addi %total$63, %45 : i32
    %total$65 = scf.select %26, %total$63, %total$31 : i32
    %checks$34 = scalar.addi %checks$61, %checks$46 : i32
    %count$48 = scalar.addi %count$62, %50 : i32
    scf.yield %checks$34, %count$48, %total$65, %count$62 : i32, i32, i32, i32
  }
  %37 = scalar.constant 100 : i32
  %38 = scalar.muli %37, %checks$55 : i32
  %39 = scalar.addi %total$57, %38 : i32
  func.return %39 : i32
}

// ====
// RUN: pass inline-callables,canonicalize,cse,promote-private-fragments,canonicalize,cse,dce
// Failed compare-exchange writes the observed value through expected; the
// next operation and ordinary reads retain those same local storage roots.
unsigned atomic_local(unsigned input) {
  unsigned value = input;
  unsigned expected = input + 1;
  bool failed = __atomic_compare_exchange_n(&value, &expected, 41u, false,
                                            __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST);
  bool succeeded = __atomic_compare_exchange_n(
      &value, &expected, 41u, false, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST);
  return value + expected + (failed ? 1000u : 0u) + (succeeded ? 100u : 0u);
}
// ----
func.def public @atomic_local(%input: i32) -> (i32) {
  %2 = index.constant 4 : offset
  %value_storage = buffer.alloca<private> align(4) %2 : buffer
  %value_storage_byte_offset = index.constant 0 : offset
  %value_view = buffer.view %value_storage[%value_storage_byte_offset] : buffer -> view<1xi32>
  view.store %input, %value_view[0] : i32, view<1xi32>
  %10 = scalar.constant 1 : i32
  %11 = scalar.addi %input, %10 : i32
  %12 = scalar.constant 41 : i32
  %19 = view.atomic.cmpxchg %11, %12, %value_view[0] {failure_ordering = seq_cst, scope = system, success_ordering = seq_cst} : i32, view<1xi32> -> i32
  %failed = scalar.cmpi eq, %19, %11 : i32
  %21 = scalar.constant 1 : i1
  %22 = scalar.xori %failed, %21 : i1
  %58 = scf.select %22, %19, %11 : i32
  %30 = view.atomic.cmpxchg %58, %12, %value_view[0] {failure_ordering = seq_cst, scope = system, success_ordering = seq_cst} : i32, view<1xi32> -> i32
  %succeeded = scalar.cmpi eq, %30, %58 : i32
  %33 = scalar.xori %succeeded, %21 : i1
  %57 = scf.select %33, %30, %58 : i32
  %value = view.load %value_view[0] : view<1xi32> -> i32
  %36 = scalar.addi %value, %57 : i32
  %38 = scalar.constant 1000 : i32
  %39 = scalar.constant 0 : i32
  %52 = scf.select %failed, %38, %39 : i32
  %40 = scalar.addi %36, %52 : i32
  %42 = scalar.constant 100 : i32
  %51 = scf.select %succeeded, %42, %39 : i32
  %44 = scalar.addi %40, %51 : i32
  func.return %44 : i32
}

// ====
// RUN: pass inline-callables,canonicalize,cse,promote-private-fragments,canonicalize,cse,dce
// A pointer helper updates every vector lane of the caller-owned local.
using Words = unsigned __attribute__((vector_size(16)));
[[loom::inline]] static void update_vector(Words* value) {
  *value += Words{1, 2, 3, 4};
}
unsigned vector_local(unsigned input) {
  Words value = {input, input, input, input};
  update_vector(&value);
  return value[0] + value[1] + value[2] + value[3];
}
// ----
func.def public @vector_local(%input: i32) -> (i32) {
  %2 = index.constant 16 : offset
  %value_storage = buffer.alloca<private> align(16) %2 : buffer
  %value_storage_byte_offset = index.constant 0 : offset
  %value_view = buffer.view %value_storage[%value_storage_byte_offset] : buffer -> view<4xi32>
  %40 = vector.splat %input : vector<4xi32>
  vector.store %40, %value_view[0] : vector<4xi32>, view<4xi32>
  %28 = vector.constanti [1, 2, 3, 4] : vector<4xi32>
  %30 = vector.load %value_view[0] : view<4xi32> -> vector<4xi32>
  %31 = vector.addi %30, %28 : vector<4xi32>
  vector.store %31, %value_view[0] : vector<4xi32>, view<4xi32>
  %39 = view.load %value_view[0] : view<4xi32> -> i32
  %38 = view.load %value_view[1] : view<4xi32> -> i32
  %15 = scalar.addi %39, %38 : i32
  %37 = view.load %value_view[2] : view<4xi32> -> i32
  %20 = scalar.addi %15, %37 : i32
  %36 = view.load %value_view[3] : view<4xi32> -> i32
  %25 = scalar.addi %20, %36 : i32
  func.return %25 : i32
}
