// RUN: roundtrip
// The callable ABI transports predicates; its pointed-to objects occupy bytes.
bool exchange(bool* output, const bool* input) {
  bool value = *input;
  *output = !value;
  return value;
}
// ----
func.def public @exchange(%output: buffer, %output_byte_offset: index, %input: buffer, %input_byte_offset: index) -> (i1) {
  %5 = buffer.view %input[%input_byte_offset] : buffer -> view<1xi8>
  %6 = view.load<root_in_bounds|type_disjoint> %5[0] : view<1xi8> -> i8
  %7 = scalar.constant 0 : i8
  %value = scalar.cmpi ne, %6, %7 : i8
  %9 = scalar.constant 1 : i1
  %10 = scalar.xori %value, %9 : i1
  %11 = buffer.view %output[%output_byte_offset] : buffer -> view<1xi8>
  %12 = scalar.extui %10 : i1 to i8
  view.store<root_in_bounds|type_disjoint> %12, %11[0] : i8, view<1xi8>
  func.return %value : i1
}

// ====
// Erased pointers recover the same byte storage at their typed access.
bool load(const void* storage) {
  return *static_cast<const bool*>(storage);
}
// ----
func.def public @load(%storage: buffer, %storage_byte_offset: index) -> (i1) {
  %3 = buffer.view %storage[%storage_byte_offset] : buffer -> view<1xi8>
  %4 = view.load<root_in_bounds|type_disjoint> %3[0] : view<1xi8> -> i8
  %5 = scalar.constant 0 : i8
  %6 = scalar.cmpi ne, %4, %5 : i8
  func.return %6 : i1
}

// ====
// INPUT: cxx std=c23
// C truth conversion tests the whole integer before writing a canonical byte.
void initialize(bool* output, unsigned value) { *output = value; }
// ----
func.def public source_signature(#func.abi.c.signature<arguments = [0, 1], results = [], types = [#func.abi.c.type<pointer, byte_length = 8, byte_alignment = 8, component_count = 2>, #func.abi.c.type<unsigned_integer, byte_length = 4, byte_alignment = 4, component_count = 1, bitwidth = 32>]>) @initialize(%output: buffer, %output_byte_offset: index, %value: i32) {
  %3 = scalar.constant 0 : i32
  %4 = scalar.cmpi ne, %value, %3 : i32
  %5 = buffer.view %output[%output_byte_offset] : buffer -> view<1xi8>
  %6 = scalar.extui %4 : i1 to i8
  view.store<root_in_bounds> %6, %5[0] : i8, view<1xi8>
  func.return
}

// ====
// Boolean enums retain their nominal source type and use the bool footprint.
enum class Flag : bool { no, yes };
Flag exchange(Flag* output, const Flag* input) {
  Flag value = *input;
  *output = value;
  return value;
}
// ----
func.def public @exchange(%output: buffer, %output_byte_offset: index, %input: buffer, %input_byte_offset: index) -> (i1) {
  %5 = buffer.view %input[%input_byte_offset] : buffer -> view<1xi8>
  %6 = view.load<root_in_bounds|type_disjoint> %5[0] : view<1xi8> -> i8
  %7 = scalar.constant 0 : i8
  %value = scalar.cmpi ne, %6, %7 : i8
  %9 = buffer.view %output[%output_byte_offset] : buffer -> view<1xi8>
  %10 = scalar.extui %value : i1 to i8
  view.store<root_in_bounds|type_disjoint> %10, %9[0] : i8, view<1xi8>
  func.return %value : i1
}

// ====
// Partial initialization fills the remaining Boolean bytes with false.
bool local_array(bool input, unsigned index) {
  bool values[4] = {input, true};
  return values[index];
}
// ----
func.def public @local_array(%input: i1, %index: i32) -> (i1) {
  %3 = index.constant 4 : offset
  %values_storage = buffer.alloca<private> align(1) %3 : buffer
  %values_storage_byte_offset = index.constant 0 : index
  %values_view = buffer.view %values_storage[%values_storage_byte_offset] : buffer -> view<4xi8>
  %7 = index.constant 0 : index
  %8 = scalar.extui %input : i1 to i8
  view.store<type_disjoint> %8, %values_view[%7] : i8, view<4xi8>
  %9 = scalar.constant 1 : i1
  %10 = index.constant 1 : index
  %11 = scalar.extui %9 : i1 to i8
  view.store<type_disjoint> %11, %values_view[%10] : i8, view<4xi8>
  %zero$i1$12 = scalar.constant 0 : i1
  %13 = index.constant 2 : index
  %14 = scalar.extui %zero$i1$12 : i1 to i8
  view.store<type_disjoint> %14, %values_view[%13] : i8, view<4xi8>
  %zero$i1$15 = scalar.constant 0 : i1
  %16 = index.constant 3 : index
  %17 = scalar.extui %zero$i1$15 : i1 to i8
  view.store<type_disjoint> %17, %values_view[%16] : i8, view<4xi8>
  %18 = scalar.extui %index : i32 to i64
  %19 = scalar.assume %18 [range(%18, 0, 3)] : i64
  %20 = index.cast %19 : i64 to index
  %21 = view.load<type_disjoint> %values_view[%20] : view<4xi8> -> i8
  %22 = scalar.constant 0 : i8
  %23 = scalar.cmpi ne, %21, %22 : i8
  func.return %23 : i1
}

// ====
// Source field offsets and the array's one-byte stride share the record root.
struct Record {
  // Unmodified byte preceding the flags.
  unsigned char prefix;
  // Single Boolean object at offset one.
  bool value;
  // Four consecutive Boolean objects at offset two.
  bool values[4];
};
bool read(const Record* record, unsigned index) {
  return record->value != record->values[index];
}
// ----
func.def public @read(%record: buffer, %record_byte_offset: index, %index: i32) -> (i1) {
  %4 = index.constant 1 : index
  %5 = index.add %record_byte_offset, %4 : index
  %6 = buffer.view %record[%5] : buffer -> view<1xi8>
  %7 = view.load<root_in_bounds|type_disjoint> %6[0] : view<1xi8> -> i8
  %8 = scalar.constant 0 : i8
  %value = scalar.cmpi ne, %7, %8 : i8
  %10 = scalar.extui %value : i1 to i32
  %11 = index.constant 2 : index
  %values_byte_offset = index.add %record_byte_offset, %11 : index
  %13 = scalar.extui %index : i32 to i64
  %14 = index.cast %13 : i64 to index
  %15 = index.constant 1 : index
  %16 = index.mul %14, %15 : index
  %17 = index.add %values_byte_offset, %16 : index
  %18 = buffer.view %record[%17] : buffer -> view<1xi8>
  %19 = view.load<root_in_bounds|type_disjoint> %18[0] : view<1xi8> -> i8
  %20 = scalar.constant 0 : i8
  %21 = scalar.cmpi ne, %19, %20 : i8
  %22 = scalar.extui %21 : i1 to i32
  %23 = scalar.cmpi ne, %10, %22 : i32
  func.return %23 : i1
}

// ====
#include <loomcxx/kernel.h>
LOOM_KERNEL void shared(bool* output) {
  LOOM_WORKGROUP bool slot;
  slot = true;
  *output = slot;
}
// ----
kernel.def @shared() {
  %workgroup_count_x = config.get @shared.workgroup_count.x : index
  %workgroup_count_y = config.get @shared.workgroup_count.y : index
  %workgroup_count_z = config.get @shared.workgroup_count.z : index
  %workgroup_size_x = config.get @shared.workgroup_size.x : index
  %workgroup_size_y = config.get @shared.workgroup_size.y : index
  %workgroup_size_z = config.get @shared.workgroup_size.z : index
  kernel.launch.config workgroups(%workgroup_count_x, %workgroup_count_y, %workgroup_count_z) workgroup_size(%workgroup_size_x, %workgroup_size_y, %workgroup_size_z) : index
} launch(%output: buffer) {
  %output_byte_offset = index.constant 0 : index
  %14 = index.constant 1 : offset
  %slot_storage = buffer.alloca<workgroup> align(1) %14 : buffer
  %slot_storage_byte_offset = index.constant 0 : index
  %slot_view = buffer.view %slot_storage[%slot_storage_byte_offset] : buffer -> view<1xi8>
  %18 = scalar.constant 1 : i1
  %19 = scalar.extui %18 : i1 to i8
  view.store<type_disjoint> %19, %slot_view[0] : i8, view<1xi8>
  %20 = view.load<type_disjoint> %slot_view[0] : view<1xi8> -> i8
  %21 = scalar.constant 0 : i8
  %slot = scalar.cmpi ne, %20, %21 : i8
  %23 = buffer.view %output[%output_byte_offset] : buffer -> view<1xi8>
  %24 = scalar.extui %slot : i1 to i8
  view.store<root_in_bounds|type_disjoint> %24, %23[0] : i8, view<1xi8>
  kernel.return
}

config.decl @shared.workgroup_count.x : index

config.decl @shared.workgroup_count.y : index

config.decl @shared.workgroup_count.z : index

config.decl @shared.workgroup_size.x : index

config.decl @shared.workgroup_size.y : index

config.decl @shared.workgroup_size.z : index

// ====
// RUN: pass inline-callables,canonicalize,cse,promote-private-fragments,canonicalize,cse,dce
// An interior Boolean alias changes only its own byte while omitted
// array elements stay zero and dynamic indexing retains byte stride.
bool array_value(unsigned input, unsigned index) {
  bool values[4] = {bool(input), true};
  auto* alias = values + 1;
  *alias = !values[0];
  return values[index];
}
// ----
func.def public @array_value(%input: i32, %index: i32) -> (i1) {
  %3 = index.constant 4 : offset
  %values_storage = buffer.alloca<private> align(1) %3 : buffer
  %values_storage_byte_offset = index.constant 0 : index
  %values_view = buffer.view %values_storage[%values_storage_byte_offset] : buffer -> view<4xi8>
  %7 = scalar.constant 0 : i32
  %8 = scalar.cmpi ne, %input, %7 : i32
  %10 = scalar.extui %8 : i1 to i8
  view.store<type_disjoint> %10, %values_view[%values_storage_byte_offset] : i8, view<4xi8>
  %12 = index.constant 1 : index
  %47 = scalar.constant 1 : i8
  view.store<type_disjoint> %47, %values_view[%12] : i8, view<4xi8>
  %15 = index.constant 2 : index
  %46 = scalar.constant 0 : i8
  view.store<type_disjoint> %46, %values_view[%15] : i8, view<4xi8>
  %18 = index.constant 3 : index
  view.store<type_disjoint> %46, %values_view[%18] : i8, view<4xi8>
  %29 = view.load<type_disjoint> %values_view[%values_storage_byte_offset] : view<4xi8> -> i8
  %31 = scalar.cmpi ne, %29, %46 : i8
  %32 = scalar.constant 1 : i1
  %33 = scalar.xori %31, %32 : i1
  %35 = buffer.view %values_storage[%12] : buffer -> view<1xi8>
  %36 = scalar.extui %33 : i1 to i8
  view.store<type_disjoint> %36, %35[0] : i8, view<1xi8>
  %37 = scalar.extui %index : i32 to i64
  %38 = scalar.assume %37 [range(%37, 0, 3)] : i64
  %39 = index.cast %38 : i64 to index
  %40 = view.load<type_disjoint> %values_view[%39] : view<4xi8> -> i8
  %42 = scalar.cmpi ne, %40, %46 : i8
  func.return %42 : i1
}

// ====
// RUN: pass inline-callables,canonicalize,cse,promote-private-fragments,canonicalize,cse,dce
// A nominal Boolean enum uses the same canonical byte storage, including
// the named true element and the omitted false tail.
enum class Flag : bool { no, yes };
unsigned enum_array(bool input, unsigned index) {
  Flag values[3] = {static_cast<Flag>(input), Flag::yes};
  return static_cast<unsigned>(values[index]);
}
// ----
func.def public @enum_array(%input: i1, %index: i32) -> (i32) {
  %3 = index.constant 3 : offset
  %values_storage = buffer.alloca<private> align(1) %3 : buffer
  %values_storage_byte_offset = index.constant 0 : index
  %values_view = buffer.view %values_storage[%values_storage_byte_offset] : buffer -> view<3xi8>
  %8 = scalar.extui %input : i1 to i8
  view.store<type_disjoint> %8, %values_view[%values_storage_byte_offset] : i8, view<3xi8>
  %10 = index.constant 1 : index
  %23 = scalar.constant 1 : i8
  view.store<type_disjoint> %23, %values_view[%10] : i8, view<3xi8>
  %13 = index.constant 2 : index
  %22 = scalar.constant 0 : i8
  view.store<type_disjoint> %22, %values_view[%13] : i8, view<3xi8>
  %15 = scalar.extui %index : i32 to i64
  %16 = scalar.assume %15 [range(%15, 0, 2)] : i64
  %17 = index.cast %16 : i64 to index
  %18 = view.load<type_disjoint> %values_view[%17] : view<3xi8> -> i8
  %20 = scalar.cmpi ne, %18, %22 : i8
  %21 = scalar.extui %20 : i1 to i32
  func.return %21 : i32
}

// ====
// RUN: pass inline-callables,canonicalize,cse,promote-private-fragments,canonicalize,cse,dce
// Volatile pointer transfer, a returned Boolean, local inversion, and
// output-only initialization compose into distinct byte destinations.
[[loom::inline]] static void invert(bool* value) { *value = !*value; }
[[loom::inline]] static void initialize(bool* value, unsigned input) {
  *value = input;
}
static bool array_value(unsigned input, unsigned index) {
  bool values[4] = {bool(input), true};
  auto* alias = values + 1;
  *alias = !values[0];
  return values[index];
}
bool boolean_transfer(volatile bool* destination, const volatile bool* source) {
  bool value = *source;
  *destination = value;
  return value;
}
[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void boolean_objects(const volatile bool* input, volatile bool* output,
                     unsigned number) {
  bool value = boolean_transfer(output + 1, input);
  invert(&value);
  output[2] = value;
  output[3] = array_value(number, 2);
  bool initialized;
  initialize(&initialized, number);
  output[4] = initialized;
}
// ----
func.def public @boolean_transfer(%destination: buffer, %destination_byte_offset: index, %source: buffer, %source_byte_offset: index) -> (i1) {
  %5 = buffer.view %source[%source_byte_offset] : buffer -> view<1xi8>
  %6 = view.load<volatile|root_in_bounds|type_disjoint> %5[0] : view<1xi8> -> i8
  %7 = scalar.constant 0 : i8
  %value = scalar.cmpi ne, %6, %7 : i8
  %9 = buffer.view %destination[%destination_byte_offset] : buffer -> view<1xi8>
  %10 = scalar.extui %value : i1 to i8
  view.store<volatile|root_in_bounds|type_disjoint> %10, %9[0] : i8, view<1xi8>
  func.return %value : i1
}

kernel.def @boolean_objects() {
  %14 = index.constant 1 : index
  kernel.launch.config workgroups(%14, %14, %14) workgroup_size(%14, %14, %14) : index
} launch(%input: buffer, %output: buffer, %number: i32) {
  %input_byte_offset = index.constant 0 : index
  %141 = index.constant 1 : index
  %126 = buffer.view %input[%input_byte_offset] : buffer -> view<1xi8>
  %127 = view.load<volatile|root_in_bounds|type_disjoint> %126[0] : view<1xi8> -> i8
  %128 = scalar.constant 0 : i8
  %value = scalar.cmpi ne, %127, %128 : i8
  %130 = buffer.view %output[%141] : buffer -> view<1xi8>
  %131 = scalar.extui %value : i1 to i8
  view.store<volatile|root_in_bounds|type_disjoint> %131, %130[0] : i8, view<1xi8>
  %72 = scalar.constant 1 : i1
  %73 = scalar.xori %value, %72 : i1
  %140 = index.constant 2 : index
  %41 = buffer.view %output[%140] : buffer -> view<1xi8>
  %42 = scalar.extui %73 : i1 to i8
  view.store<volatile|root_in_bounds|type_disjoint> %42, %41[0] : i8, view<1xi8>
  %83 = scalar.constant 0 : i32
  %84 = scalar.cmpi ne, %number, %83 : i32
  %94 = index.constant 3 : index
  %50 = buffer.view %output[%94] : buffer -> view<1xi8>
  view.store<volatile|root_in_bounds|type_disjoint> %128, %50[0] : i8, view<1xi8>
  %132 = index.constant 4 : index
  %64 = buffer.view %output[%132] : buffer -> view<1xi8>
  %65 = scalar.extui %84 : i1 to i8
  view.store<volatile|root_in_bounds|type_disjoint> %65, %64[0] : i8, view<1xi8>
  kernel.return
}

// ====
// RUN: pass inline-callables,canonicalize,cse,promote-private-fragments,canonicalize,cse,dce
// Record stride and member offsets preserve the two byte guards around
// scalar, nominal-enum, and array Boolean fields.
enum class Flag : bool { no, yes };
struct Flags {
  // Guard preceding the Boolean fields.
  unsigned char prefix;
  // Independent Boolean object.
  bool enabled;
  // Nominal enum with Boolean storage.
  Flag selected;
  // Consecutive Boolean objects with byte stride.
  bool lanes[3];
  // Guard following the Boolean fields.
  unsigned char suffix;
};
static_assert(sizeof(Flags) == 7);
static_assert(alignof(Flags) == 1);

[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void boolean_records(const Flags* input, Flags* output) {
  output[1].enabled = !input[1].enabled;
  output[1].selected = input[1].selected;
  output[1].lanes[0] = input[0].lanes[2];
  output[1].lanes[1] = !input[1].lanes[0];
  output[1].lanes[2] = true;
}
// ----
kernel.def @boolean_records() {
  %2 = index.constant 1 : index
  kernel.launch.config workgroups(%2, %2, %2) workgroup_size(%2, %2, %2) : index
} launch(%input: buffer, %output: buffer) {
  %138 = index.constant 8 : index
  %17 = buffer.view %input[%138] : buffer -> view<1xi8>
  %18 = view.load<root_in_bounds|type_disjoint> %17[0] : view<1xi8> -> i8
  %19 = scalar.constant 0 : i8
  %enabled = scalar.cmpi ne, %18, %19 : i8
  %21 = scalar.constant 1 : i1
  %22 = scalar.xori %enabled, %21 : i1
  %30 = buffer.view %output[%138] : buffer -> view<1xi8>
  %31 = scalar.extui %22 : i1 to i8
  view.store<root_in_bounds|type_disjoint> %31, %30[0] : i8, view<1xi8>
  %136 = index.constant 9 : index
  %39 = buffer.view %input[%136] : buffer -> view<1xi8>
  %40 = view.load<root_in_bounds|type_disjoint> %39[0] : view<1xi8> -> i8
  %selected = scalar.cmpi ne, %40, %19 : i8
  %50 = buffer.view %output[%136] : buffer -> view<1xi8>
  %51 = scalar.extui %selected : i1 to i8
  view.store<root_in_bounds|type_disjoint> %51, %50[0] : i8, view<1xi8>
  %134 = index.constant 5 : index
  %64 = buffer.view %input[%134] : buffer -> view<1xi8>
  %65 = view.load<root_in_bounds|type_disjoint> %64[0] : view<1xi8> -> i8
  %67 = scalar.cmpi ne, %65, %19 : i8
  %133 = index.constant 10 : index
  %80 = buffer.view %output[%133] : buffer -> view<1xi8>
  %81 = scalar.extui %67 : i1 to i8
  view.store<root_in_bounds|type_disjoint> %81, %80[0] : i8, view<1xi8>
  %94 = buffer.view %input[%133] : buffer -> view<1xi8>
  %95 = view.load<root_in_bounds|type_disjoint> %94[0] : view<1xi8> -> i8
  %97 = scalar.cmpi ne, %95, %19 : i8
  %99 = scalar.xori %97, %21 : i1
  %131 = index.constant 11 : index
  %112 = buffer.view %output[%131] : buffer -> view<1xi8>
  %113 = scalar.extui %99 : i1 to i8
  view.store<root_in_bounds|type_disjoint> %113, %112[0] : i8, view<1xi8>
  %130 = index.constant 12 : index
  %127 = buffer.view %output[%130] : buffer -> view<1xi8>
  %129 = scalar.constant 1 : i8
  view.store<root_in_bounds|type_disjoint> %129, %127[0] : i8, view<1xi8>
  kernel.return
}

// ====
// RUN: pass inline-callables,canonicalize,cse,promote-private-fragments,canonicalize,cse,dce
// Workgroup Boolean arrays retain one-byte element storage and preserve
// the input and inverted values through separate slots.
#include <loomcxx/kernel.h>
[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void boolean_shared(const bool* input, bool* output) {
  LOOM_WORKGROUP bool slots[2];
  slots[0] = input[0];
  slots[1] = !slots[0];
  output[1] = slots[0];
  output[2] = slots[1];
}
// ----
kernel.def @boolean_shared() {
  %2 = index.constant 1 : index
  kernel.launch.config workgroups(%2, %2, %2) workgroup_size(%2, %2, %2) : index
} launch(%input: buffer, %output: buffer) {
  %10 = index.constant 2 : offset
  %slots = buffer.alloca<workgroup> align(1) %10 : buffer
  %slots_byte_offset = index.constant 0 : index
  %slots_view = buffer.view %slots[%slots_byte_offset] : buffer -> view<2xi8>
  %19 = buffer.view %input[%slots_byte_offset] : buffer -> view<1xi8>
  %20 = view.load<root_in_bounds|type_disjoint> %19[0] : view<1xi8> -> i8
  %21 = scalar.constant 0 : i8
  %22 = scalar.cmpi ne, %20, %21 : i8
  %27 = scalar.extui %22 : i1 to i8
  view.store<type_disjoint> %27, %slots_view[%slots_byte_offset] : i8, view<2xi8>
  %32 = view.load<type_disjoint> %slots_view[%slots_byte_offset] : view<2xi8> -> i8
  %34 = scalar.cmpi ne, %32, %21 : i8
  %35 = scalar.constant 1 : i1
  %36 = scalar.xori %34, %35 : i1
  %74 = index.constant 1 : index
  %41 = scalar.extui %36 : i1 to i8
  view.store<type_disjoint> %41, %slots_view[%74] : i8, view<2xi8>
  %46 = view.load<type_disjoint> %slots_view[%slots_byte_offset] : view<2xi8> -> i8
  %48 = scalar.cmpi ne, %46, %21 : i8
  %54 = buffer.view %output[%74] : buffer -> view<1xi8>
  %55 = scalar.extui %48 : i1 to i8
  view.store<root_in_bounds|type_disjoint> %55, %54[0] : i8, view<1xi8>
  %60 = view.load<type_disjoint> %slots_view[%74] : view<2xi8> -> i8
  %62 = scalar.cmpi ne, %60, %21 : i8
  %70 = index.constant 2 : index
  %68 = buffer.view %output[%70] : buffer -> view<1xi8>
  %69 = scalar.extui %62 : i1 to i8
  view.store<root_in_bounds|type_disjoint> %69, %68[0] : i8, view<1xi8>
  kernel.return
}
