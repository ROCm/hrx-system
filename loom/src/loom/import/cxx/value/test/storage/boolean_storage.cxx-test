// RUN: roundtrip
// The callable ABI transports predicates; its pointed-to objects occupy bytes.
bool exchange(bool* output, const bool* input) {
  bool value = *input;
  *output = !value;
  return value;
}
// ----
func.def public @exchange(%output: buffer, %output_byte_offset: offset, %input: buffer, %input_byte_offset: offset) -> (i1) {
  %5 = buffer.view %input[%input_byte_offset] : buffer -> view<1xi8>
  %6 = view.load<root_in_bounds> %5[0] : view<1xi8> -> i8
  %7 = scalar.constant 0 : i8
  %value = scalar.cmpi ne, %6, %7 : i8
  %9 = scalar.constant 1 : i1
  %10 = scalar.xori %value, %9 : i1
  %11 = buffer.view %output[%output_byte_offset] : buffer -> view<1xi8>
  %12 = scalar.extui %10 : i1 to i8
  view.store<root_in_bounds> %12, %11[0] : i8, view<1xi8>
  func.return %value : i1
}

// ====
// Erased pointers recover the same byte storage at their typed access.
bool load(const void* storage) {
  return *static_cast<const bool*>(storage);
}
// ----
func.def public @load(%storage: buffer, %storage_byte_offset: offset) -> (i1) {
  %3 = buffer.view %storage[%storage_byte_offset] : buffer -> view<1xi8>
  %4 = view.load<root_in_bounds> %3[0] : view<1xi8> -> i8
  %5 = scalar.constant 0 : i8
  %6 = scalar.cmpi ne, %4, %5 : i8
  func.return %6 : i1
}

// ====
// INPUT: cxx std=c23
// C truth conversion tests the whole integer before writing a canonical byte.
void initialize(bool* output, unsigned value) { *output = value; }
// ----
func.def public source_signature(#func.abi.c.signature<arguments = [0, 1], results = [], types = [#func.abi.c.type<pointer, byte_length = 8, byte_alignment = 8, component_count = 2>, #func.abi.c.type<unsigned_integer, byte_length = 4, byte_alignment = 4, component_count = 1, bitwidth = 32>]>) @initialize(%output: buffer, %output_byte_offset: offset, %value: i32) {
  %3 = scalar.constant 0 : i32
  %4 = scalar.cmpi ne, %value, %3 : i32
  %5 = buffer.view %output[%output_byte_offset] : buffer -> view<1xi8>
  %6 = scalar.extui %4 : i1 to i8
  view.store<root_in_bounds> %6, %5[0] : i8, view<1xi8>
  func.return
}

// ====
// Boolean enums retain their nominal source type and use the bool footprint.
enum class Flag : bool { no, yes };
Flag exchange(Flag* output, const Flag* input) {
  Flag value = *input;
  *output = value;
  return value;
}
// ----
func.def public @exchange(%output: buffer, %output_byte_offset: offset, %input: buffer, %input_byte_offset: offset) -> (i1) {
  %5 = buffer.view %input[%input_byte_offset] : buffer -> view<1xi8>
  %6 = view.load<root_in_bounds> %5[0] : view<1xi8> -> i8
  %7 = scalar.constant 0 : i8
  %value = scalar.cmpi ne, %6, %7 : i8
  %9 = buffer.view %output[%output_byte_offset] : buffer -> view<1xi8>
  %10 = scalar.extui %value : i1 to i8
  view.store<root_in_bounds> %10, %9[0] : i8, view<1xi8>
  func.return %value : i1
}

// ====
// Partial initialization fills the remaining Boolean bytes with false.
bool local_array(bool input, unsigned index) {
  bool values[4] = {input, true};
  return values[index];
}
// ----
func.def public @local_array(%input: i1, %index: i32) -> (i1) {
  %3 = index.constant 4 : offset
  %values_storage = buffer.alloca<private> align(1) %3 : buffer
  %values_storage_byte_offset = index.constant 0 : offset
  %values_view = buffer.view %values_storage[%values_storage_byte_offset] : buffer -> view<4xi8>
  %7 = index.constant 0 : index
  %8 = scalar.extui %input : i1 to i8
  view.store %8, %values_view[%7] : i8, view<4xi8>
  %9 = scalar.constant 1 : i1
  %10 = index.constant 1 : index
  %11 = scalar.extui %9 : i1 to i8
  view.store %11, %values_view[%10] : i8, view<4xi8>
  %zero$i1$12 = scalar.constant 0 : i1
  %13 = index.constant 2 : index
  %14 = scalar.extui %zero$i1$12 : i1 to i8
  view.store %14, %values_view[%13] : i8, view<4xi8>
  %zero$i1$15 = scalar.constant 0 : i1
  %16 = index.constant 3 : index
  %17 = scalar.extui %zero$i1$15 : i1 to i8
  view.store %17, %values_view[%16] : i8, view<4xi8>
  %18 = scalar.extui %index : i32 to i64
  %19 = scalar.assume %18 [range(%18, 0, 3)] : i64
  %20 = index.cast %19 : i64 to index
  %21 = view.load %values_view[%20] : view<4xi8> -> i8
  %22 = scalar.constant 0 : i8
  %23 = scalar.cmpi ne, %21, %22 : i8
  func.return %23 : i1
}

// ====
// Source field offsets and the array's one-byte stride share the record root.
struct Record {
  // Unmodified byte preceding the flags.
  unsigned char prefix;
  // Single Boolean object at offset one.
  bool value;
  // Four consecutive Boolean objects at offset two.
  bool values[4];
};
bool read(const Record* record, unsigned index) {
  return record->value != record->values[index];
}
// ----
func.def public @read(%record: buffer, %record_byte_offset: offset, %index: i32) -> (i1) {
  %4 = index.constant 1 : offset
  %5 = index.add %record_byte_offset, %4 : offset
  %6 = buffer.view %record[%5] : buffer -> view<1xi8>
  %7 = view.load<root_in_bounds> %6[0] : view<1xi8> -> i8
  %8 = scalar.constant 0 : i8
  %value = scalar.cmpi ne, %7, %8 : i8
  %10 = scalar.extui %value : i1 to i32
  %11 = index.constant 2 : offset
  %values_byte_offset = index.add %record_byte_offset, %11 : offset
  %13 = scalar.extui %index : i32 to i64
  %14 = scalar.constant 1 : i64
  %15 = scalar.muli %13, %14 : i64
  %16 = index.cast %values_byte_offset : offset to i64
  %17 = scalar.addi %16, %15 : i64
  %18 = scalar.assume %17 [range(%17, 0, 9223372036854775807)] : i64
  %19 = index.cast %18 : i64 to offset
  %20 = buffer.view %record[%19] : buffer -> view<1xi8>
  %21 = view.load<root_in_bounds> %20[0] : view<1xi8> -> i8
  %22 = scalar.constant 0 : i8
  %23 = scalar.cmpi ne, %21, %22 : i8
  %24 = scalar.extui %23 : i1 to i32
  %25 = scalar.cmpi ne, %10, %24 : i32
  func.return %25 : i1
}

// ====
#include <loomcxx/kernel.h>
LOOM_KERNEL void shared(bool* output) {
  LOOM_WORKGROUP bool slot;
  slot = true;
  *output = slot;
}
// ----
kernel.def @shared() {
  %workgroup_count_x = config.get @shared.workgroup_count.x : index
  %workgroup_count_y = config.get @shared.workgroup_count.y : index
  %workgroup_count_z = config.get @shared.workgroup_count.z : index
  %workgroup_size_x = config.get @shared.workgroup_size.x : index
  %workgroup_size_y = config.get @shared.workgroup_size.y : index
  %workgroup_size_z = config.get @shared.workgroup_size.z : index
  kernel.launch.config workgroups(%workgroup_count_x, %workgroup_count_y, %workgroup_count_z) workgroup_size(%workgroup_size_x, %workgroup_size_y, %workgroup_size_z) : index
} launch(%output: buffer) {
  %output_byte_offset = index.constant 0 : offset
  %14 = index.constant 1 : offset
  %slot_storage = buffer.alloca<workgroup> align(1) %14 : buffer
  %slot_storage_byte_offset = index.constant 0 : offset
  %slot_view = buffer.view %slot_storage[%slot_storage_byte_offset] : buffer -> view<1xi8>
  %18 = scalar.constant 1 : i1
  %19 = scalar.extui %18 : i1 to i8
  view.store %19, %slot_view[0] : i8, view<1xi8>
  %20 = view.load %slot_view[0] : view<1xi8> -> i8
  %21 = scalar.constant 0 : i8
  %slot = scalar.cmpi ne, %20, %21 : i8
  %23 = buffer.view %output[%output_byte_offset] : buffer -> view<1xi8>
  %24 = scalar.extui %slot : i1 to i8
  view.store<root_in_bounds> %24, %23[0] : i8, view<1xi8>
  kernel.return
}

config.decl @shared.workgroup_count.x : index

config.decl @shared.workgroup_count.y : index

config.decl @shared.workgroup_count.z : index

config.decl @shared.workgroup_size.x : index

config.decl @shared.workgroup_size.y : index

config.decl @shared.workgroup_size.z : index

// ====
// RUN: pass inline-callables,canonicalize,cse,promote-private-fragments,canonicalize,cse,dce
// An interior Boolean alias changes only its own byte while omitted
// array elements stay zero and dynamic indexing retains byte stride.
bool array_value(unsigned input, unsigned index) {
  bool values[4] = {bool(input), true};
  auto* alias = values + 1;
  *alias = !values[0];
  return values[index];
}
// ----
func.def public @array_value(%input: i32, %index: i32) -> (i1) {
  %3 = index.constant 4 : offset
  %values_storage = buffer.alloca<private> align(1) %3 : buffer
  %values_storage_byte_offset = index.constant 0 : offset
  %values_view = buffer.view %values_storage[%values_storage_byte_offset] : buffer -> view<4xi8>
  %7 = scalar.constant 0 : i32
  %8 = scalar.cmpi ne, %input, %7 : i32
  %9 = index.constant 0 : index
  %10 = scalar.extui %8 : i1 to i8
  view.store %10, %values_view[%9] : i8, view<4xi8>
  %12 = index.constant 1 : index
  %50 = scalar.constant 1 : i8
  view.store %50, %values_view[%12] : i8, view<4xi8>
  %15 = index.constant 2 : index
  %49 = scalar.constant 0 : i8
  view.store %49, %values_view[%15] : i8, view<4xi8>
  %18 = index.constant 3 : index
  view.store %49, %values_view[%18] : i8, view<4xi8>
  %32 = view.load %values_view[%9] : view<4xi8> -> i8
  %34 = scalar.cmpi ne, %32, %49 : i8
  %35 = scalar.constant 1 : i1
  %36 = scalar.xori %34, %35 : i1
  %46 = index.constant 1 : offset
  %38 = buffer.view %values_storage[%46] : buffer -> view<1xi8>
  %39 = scalar.extui %36 : i1 to i8
  view.store %39, %38[0] : i8, view<1xi8>
  %40 = scalar.extui %index : i32 to i64
  %41 = scalar.assume %40 [range(%40, 0, 3)] : i64
  %42 = index.cast %41 : i64 to index
  %43 = view.load %values_view[%42] : view<4xi8> -> i8
  %45 = scalar.cmpi ne, %43, %49 : i8
  func.return %45 : i1
}

// ====
// RUN: pass inline-callables,canonicalize,cse,promote-private-fragments,canonicalize,cse,dce
// A nominal Boolean enum uses the same canonical byte storage, including
// the named true element and the omitted false tail.
enum class Flag : bool { no, yes };
unsigned enum_array(bool input, unsigned index) {
  Flag values[3] = {static_cast<Flag>(input), Flag::yes};
  return static_cast<unsigned>(values[index]);
}
// ----
func.def public @enum_array(%input: i1, %index: i32) -> (i32) {
  %3 = index.constant 3 : offset
  %values_storage = buffer.alloca<private> align(1) %3 : buffer
  %values_storage_byte_offset = index.constant 0 : offset
  %values_view = buffer.view %values_storage[%values_storage_byte_offset] : buffer -> view<3xi8>
  %7 = index.constant 0 : index
  %8 = scalar.extui %input : i1 to i8
  view.store %8, %values_view[%7] : i8, view<3xi8>
  %10 = index.constant 1 : index
  %23 = scalar.constant 1 : i8
  view.store %23, %values_view[%10] : i8, view<3xi8>
  %13 = index.constant 2 : index
  %22 = scalar.constant 0 : i8
  view.store %22, %values_view[%13] : i8, view<3xi8>
  %15 = scalar.extui %index : i32 to i64
  %16 = scalar.assume %15 [range(%15, 0, 2)] : i64
  %17 = index.cast %16 : i64 to index
  %18 = view.load %values_view[%17] : view<3xi8> -> i8
  %20 = scalar.cmpi ne, %18, %22 : i8
  %21 = scalar.extui %20 : i1 to i32
  func.return %21 : i32
}

// ====
// RUN: pass inline-callables,canonicalize,cse,promote-private-fragments,canonicalize,cse,dce
// Volatile pointer transfer, a returned Boolean, local inversion, and
// output-only initialization compose into distinct byte destinations.
[[loom::inline]] static void invert(bool* value) { *value = !*value; }
[[loom::inline]] static void initialize(bool* value, unsigned input) {
  *value = input;
}
static bool array_value(unsigned input, unsigned index) {
  bool values[4] = {bool(input), true};
  auto* alias = values + 1;
  *alias = !values[0];
  return values[index];
}
bool boolean_transfer(volatile bool* destination, const volatile bool* source) {
  bool value = *source;
  *destination = value;
  return value;
}
[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void boolean_objects(const volatile bool* input, volatile bool* output,
                     unsigned number) {
  bool value = boolean_transfer(output + 1, input);
  invert(&value);
  output[2] = value;
  output[3] = array_value(number, 2);
  bool initialized;
  initialize(&initialized, number);
  output[4] = initialized;
}
// ----
func.def public @boolean_transfer(%destination: buffer, %destination_byte_offset: offset, %source: buffer, %source_byte_offset: offset) -> (i1) {
  %5 = buffer.view %source[%source_byte_offset] : buffer -> view<1xi8>
  %6 = view.load<volatile|root_in_bounds> %5[0] : view<1xi8> -> i8
  %7 = scalar.constant 0 : i8
  %value = scalar.cmpi ne, %6, %7 : i8
  %9 = buffer.view %destination[%destination_byte_offset] : buffer -> view<1xi8>
  %10 = scalar.extui %value : i1 to i8
  view.store<volatile|root_in_bounds> %10, %9[0] : i8, view<1xi8>
  func.return %value : i1
}

kernel.def @boolean_objects() {
  %14 = index.constant 1 : index
  kernel.launch.config workgroups(%14, %14, %14) workgroup_size(%14, %14, %14) : index
} launch(%input: buffer, %output: buffer, %number: i32) {
  %input_byte_offset = index.constant 0 : offset
  %22 = index.constant 1 : offset
  %141 = buffer.view %input[%input_byte_offset] : buffer -> view<1xi8>
  %142 = view.load<volatile|root_in_bounds> %141[0] : view<1xi8> -> i8
  %143 = scalar.constant 0 : i8
  %value = scalar.cmpi ne, %142, %143 : i8
  %145 = buffer.view %output[%22] : buffer -> view<1xi8>
  %146 = scalar.extui %value : i1 to i8
  view.store<volatile|root_in_bounds> %146, %145[0] : i8, view<1xi8>
  %84 = scalar.constant 1 : i1
  %85 = scalar.xori %value, %84 : i1
  %155 = index.constant 2 : offset
  %47 = buffer.view %output[%155] : buffer -> view<1xi8>
  %48 = scalar.extui %85 : i1 to i8
  view.store<volatile|root_in_bounds> %48, %47[0] : i8, view<1xi8>
  %91 = index.constant 4 : offset
  %95 = scalar.constant 0 : i32
  %96 = scalar.cmpi ne, %number, %95 : i32
  %148 = index.constant 3 : offset
  %59 = buffer.view %output[%148] : buffer -> view<1xi8>
  view.store<volatile|root_in_bounds> %143, %59[0] : i8, view<1xi8>
  %76 = buffer.view %output[%91] : buffer -> view<1xi8>
  %77 = scalar.extui %96 : i1 to i8
  view.store<volatile|root_in_bounds> %77, %76[0] : i8, view<1xi8>
  kernel.return
}

// ====
// RUN: pass inline-callables,canonicalize,cse,promote-private-fragments,canonicalize,cse,dce
// Record stride and member offsets preserve the two byte guards around
// scalar, nominal-enum, and array Boolean fields.
enum class Flag : bool { no, yes };
struct Flags {
  // Guard preceding the Boolean fields.
  unsigned char prefix;
  // Independent Boolean object.
  bool enabled;
  // Nominal enum with Boolean storage.
  Flag selected;
  // Consecutive Boolean objects with byte stride.
  bool lanes[3];
  // Guard following the Boolean fields.
  unsigned char suffix;
};
static_assert(sizeof(Flags) == 7);
static_assert(alignof(Flags) == 1);

[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void boolean_records(const Flags* input, Flags* output) {
  output[1].enabled = !input[1].enabled;
  output[1].selected = input[1].selected;
  output[1].lanes[0] = input[0].lanes[2];
  output[1].lanes[1] = !input[1].lanes[0];
  output[1].lanes[2] = true;
}
// ----
kernel.def @boolean_records() {
  %2 = index.constant 1 : index
  kernel.launch.config workgroups(%2, %2, %2) workgroup_size(%2, %2, %2) : index
} launch(%input: buffer, %output: buffer) {
  %180 = index.constant 8 : offset
  %20 = buffer.view %input[%180] : buffer -> view<1xi8>
  %21 = view.load<root_in_bounds> %20[0] : view<1xi8> -> i8
  %22 = scalar.constant 0 : i8
  %enabled = scalar.cmpi ne, %21, %22 : i8
  %24 = scalar.constant 1 : i1
  %25 = scalar.xori %enabled, %24 : i1
  %36 = buffer.view %output[%180] : buffer -> view<1xi8>
  %37 = scalar.extui %25 : i1 to i8
  view.store<root_in_bounds> %37, %36[0] : i8, view<1xi8>
  %178 = index.constant 9 : offset
  %48 = buffer.view %input[%178] : buffer -> view<1xi8>
  %49 = view.load<root_in_bounds> %48[0] : view<1xi8> -> i8
  %selected = scalar.cmpi ne, %49, %22 : i8
  %62 = buffer.view %output[%178] : buffer -> view<1xi8>
  %63 = scalar.extui %selected : i1 to i8
  view.store<root_in_bounds> %63, %62[0] : i8, view<1xi8>
  %176 = index.constant 5 : offset
  %82 = buffer.view %input[%176] : buffer -> view<1xi8>
  %83 = view.load<root_in_bounds> %82[0] : view<1xi8> -> i8
  %85 = scalar.cmpi ne, %83, %22 : i8
  %175 = index.constant 10 : offset
  %104 = buffer.view %output[%175] : buffer -> view<1xi8>
  %105 = scalar.extui %85 : i1 to i8
  view.store<root_in_bounds> %105, %104[0] : i8, view<1xi8>
  %124 = buffer.view %input[%175] : buffer -> view<1xi8>
  %125 = view.load<root_in_bounds> %124[0] : view<1xi8> -> i8
  %127 = scalar.cmpi ne, %125, %22 : i8
  %129 = scalar.xori %127, %24 : i1
  %173 = index.constant 11 : offset
  %148 = buffer.view %output[%173] : buffer -> view<1xi8>
  %149 = scalar.extui %129 : i1 to i8
  view.store<root_in_bounds> %149, %148[0] : i8, view<1xi8>
  %172 = index.constant 12 : offset
  %169 = buffer.view %output[%172] : buffer -> view<1xi8>
  %171 = scalar.constant 1 : i8
  view.store<root_in_bounds> %171, %169[0] : i8, view<1xi8>
  kernel.return
}

// ====
// RUN: pass inline-callables,canonicalize,cse,promote-private-fragments,canonicalize,cse,dce
// Workgroup Boolean arrays retain one-byte element storage and preserve
// the input and inverted values through separate slots.
#include <loomcxx/kernel.h>
[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void boolean_shared(const bool* input, bool* output) {
  LOOM_WORKGROUP bool slots[2];
  slots[0] = input[0];
  slots[1] = !slots[0];
  output[1] = slots[0];
  output[2] = slots[1];
}
// ----
kernel.def @boolean_shared() {
  %2 = index.constant 1 : index
  kernel.launch.config workgroups(%2, %2, %2) workgroup_size(%2, %2, %2) : index
} launch(%input: buffer, %output: buffer) {
  %10 = index.constant 2 : offset
  %slots = buffer.alloca<workgroup> align(1) %10 : buffer
  %slots_byte_offset = index.constant 0 : offset
  %slots_view = buffer.view %slots[%slots_byte_offset] : buffer -> view<2xi8>
  %22 = buffer.view %input[%slots_byte_offset] : buffer -> view<1xi8>
  %23 = view.load<root_in_bounds> %22[0] : view<1xi8> -> i8
  %24 = scalar.constant 0 : i8
  %25 = scalar.cmpi ne, %23, %24 : i8
  %85 = index.constant 0 : index
  %30 = scalar.extui %25 : i1 to i8
  view.store %30, %slots_view[%85] : i8, view<2xi8>
  %35 = view.load %slots_view[%85] : view<2xi8> -> i8
  %37 = scalar.cmpi ne, %35, %24 : i8
  %38 = scalar.constant 1 : i1
  %39 = scalar.xori %37, %38 : i1
  %83 = index.constant 1 : index
  %44 = scalar.extui %39 : i1 to i8
  view.store %44, %slots_view[%83] : i8, view<2xi8>
  %49 = view.load %slots_view[%85] : view<2xi8> -> i8
  %51 = scalar.cmpi ne, %49, %24 : i8
  %81 = index.constant 1 : offset
  %60 = buffer.view %output[%81] : buffer -> view<1xi8>
  %61 = scalar.extui %51 : i1 to i8
  view.store<root_in_bounds> %61, %60[0] : i8, view<1xi8>
  %66 = view.load %slots_view[%83] : view<2xi8> -> i8
  %68 = scalar.cmpi ne, %66, %24 : i8
  %77 = buffer.view %output[%10] : buffer -> view<1xi8>
  %78 = scalar.extui %68 : i1 to i8
  view.store<root_in_bounds> %78, %77[0] : i8, view<1xi8>
  kernel.return
}
