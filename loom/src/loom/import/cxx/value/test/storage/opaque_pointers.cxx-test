// RUN: pass canonicalize,cse,dce
// Erasing and recovering an object type does not change either pointer component.
void* erase(unsigned* pointer) { return pointer; }
unsigned* recover(void* pointer) { return static_cast<unsigned*>(pointer); }
const unsigned* observe(const void* pointer) {
  return static_cast<const unsigned*>(pointer);
}

// ----
func.def public @erase(%pointer: buffer, %pointer_byte_offset: offset) -> (buffer, offset) {
  func.return %pointer, %pointer_byte_offset : buffer, offset
}

func.def public @recover(%pointer: buffer, %pointer_byte_offset: offset) -> (buffer, offset) {
  func.return %pointer, %pointer_byte_offset : buffer, offset
}

func.def public @observe(%pointer: buffer, %pointer_byte_offset: offset) -> (buffer, offset) {
  func.return %pointer, %pointer_byte_offset : buffer, offset
}

// ====
// A forward declaration is enough for helper calls and branch transport.
struct Opaque;
static const Opaque* forward(const Opaque* handle) { return handle; }
const Opaque* select(const Opaque* first, const Opaque* second, bool choose) {
  const Opaque* selected = forward(first);
  if (choose) selected = forward(second);
  return selected;
}

// ----
func.def public @select(%first: buffer, %first_byte_offset: offset, %second: buffer, %second_byte_offset: offset, %choose: i1) -> (buffer, offset) {
  %selected$7, %selected_byte_offset$8 = func.call pure @forward(%first, %first_byte_offset) : (buffer, offset) -> (buffer, offset)
  %selected$9, %selected_byte_offset$10 = scf.if %choose -> (buffer, offset) {
    %selected, %selected_byte_offset = func.call pure @forward(%second, %second_byte_offset) : (buffer, offset) -> (buffer, offset)
    scf.yield %selected, %selected_byte_offset : buffer, offset
  } else {
    scf.yield %selected$7, %selected_byte_offset$8 : buffer, offset
  }
  func.return %selected$9, %selected_byte_offset$10 : buffer, offset
}

func.def @forward(%handle: buffer, %handle_byte_offset: offset) -> (buffer, offset) {
  func.return %handle, %handle_byte_offset : buffer, offset
}

// ====
// Byte displacement is applied to the retained interior origin.
unsigned read_erased(const void* storage, unsigned byte_offset) {
  auto* bytes = static_cast<const unsigned char*>(storage);
  auto* element = reinterpret_cast<const unsigned*>(bytes + byte_offset);
  return *element;
}

// ----
func.def public @read_erased(%storage: buffer, %storage_byte_offset: offset, %byte_offset: i32) -> (i32) {
  %4 = scalar.extui %byte_offset : i32 to i64
  %7 = index.cast %storage_byte_offset : offset to i64
  %8 = scalar.addi %7, %4 : i64
  %9 = scalar.assume %8 [range(%8, 0, 9223372036854775807)] : i64
  %element_byte_offset = index.cast %9 : i64 to offset
  %11 = buffer.view %storage[%element_byte_offset] : buffer -> view<1xi32>
  %12 = view.load %11[0] : view<1xi32> -> i32
  func.return %12 : i32
}

// ====
// Access qualifiers survive erasure and C-style recovery.
unsigned exchange(volatile void* storage, unsigned value) {
  auto* pointer = (volatile unsigned*)storage;
  auto previous = *pointer;
  *pointer = value;
  return previous;
}

// ----
func.def public @exchange(%storage: buffer, %storage_byte_offset: offset, %value: i32) -> (i32) {
  %4 = buffer.view %storage[%storage_byte_offset] : buffer -> view<1xi32>
  %previous = view.load<volatile> %4[0] : view<1xi32> -> i32
  view.store<volatile> %value, %4[0] : i32, view<1xi32>
  func.return %previous : i32
}

// ====
// An SSA record can carry opaque pointer fields without storing raw addresses.
struct Opaque;
struct Handle { Opaque* object; unsigned tag; };
Handle tagged(void* pointer, unsigned tag) {
  return {static_cast<Opaque*>(pointer), tag};
}
const void* untag(Handle handle) { return handle.object; }

// ----
func.def public @tagged(%pointer: buffer, %pointer_byte_offset: offset, %tag: i32) -> (buffer, offset, i32) {
  func.return %pointer, %pointer_byte_offset, %tag : buffer, offset, i32
}

func.def public @untag(%handle_object: buffer, %handle_object_byte_offset: offset, %handle_tag: i32) -> (buffer, offset) {
  func.return %handle_object, %handle_object_byte_offset : buffer, offset
}

// ====
// Address/dereference cancellation does not request a complete object layout.
struct Opaque;
static Opaque* forward(Opaque* pointer) { return pointer; }
Opaque* address(Opaque* pointer) { return &(*(forward(pointer))); }

// ----
func.def public @address(%pointer: buffer, %pointer_byte_offset: offset) -> (buffer, offset) {
  %4, %5 = func.call pure @forward(%pointer, %pointer_byte_offset) : (buffer, offset) -> (buffer, offset)
  func.return %4, %5 : buffer, offset
}

func.def @forward(%pointer: buffer, %pointer_byte_offset: offset) -> (buffer, offset) {
  func.return %pointer, %pointer_byte_offset : buffer, offset
}

// ====
// Pointer transport does not imply support for the pointed-to storage format.
union Payload { unsigned integer; float real; };
struct Owned { ~Owned() {} };
Payload* payload(Payload* pointer) { return pointer; }
Owned* owned(Owned* pointer) { return pointer; }
bool* boolean(bool* pointer) { return pointer; }
unsigned** indirect(unsigned** pointer) { return pointer; }

// ----
func.def public @payload(%pointer: buffer, %pointer_byte_offset: offset) -> (buffer, offset) {
  func.return %pointer, %pointer_byte_offset : buffer, offset
}

func.def public @owned(%pointer: buffer, %pointer_byte_offset: offset) -> (buffer, offset) {
  func.return %pointer, %pointer_byte_offset : buffer, offset
}

func.def public @boolean(%pointer: buffer, %pointer_byte_offset: offset) -> (buffer, offset) {
  func.return %pointer, %pointer_byte_offset : buffer, offset
}

func.def public @indirect(%pointer: buffer, %pointer_byte_offset: offset) -> (buffer, offset) {
  func.return %pointer, %pointer_byte_offset : buffer, offset
}

// ====
// Pointee destruction does not alter ordinary pointer arithmetic.
struct Owned { unsigned value; ~Owned() {} };
const Owned* advance(const void* storage) {
  auto* pointer = static_cast<const Owned*>(storage);
  return pointer + 1;
}

// ----
func.def public @advance(%storage: buffer, %storage_byte_offset: offset) -> (buffer, offset) {
  %12 = scalar.constant 4 : i64
  %8 = index.cast %storage_byte_offset : offset to i64
  %9 = scalar.addi %8, %12 : i64
  %10 = scalar.assume %9 [range(%9, 0, 9223372036854775807)] : i64
  %11 = index.cast %10 : i64 to offset
  func.return %storage, %11 : buffer, offset
}

// ====
// RUN: pass canonicalize,cse,dce
// Two different roots and nonzero origins cross opaque helper selection,
// byte stepping, a loop backedge, and typed loads into an interior destination.
struct Opaque;
static const Opaque* select(const Opaque* first, const Opaque* second,
                            unsigned choose_second) {
  if (choose_second) {
    return second;
  }
  return first;
}
static const void* advance(const void* pointer, unsigned bytes) {
  return static_cast<const unsigned char*>(pointer) + bytes;
}
[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void erased(const void* first, const void* second, void* output,
            unsigned choose_second, unsigned step_bytes) {
  auto* first_handle =
      reinterpret_cast<const Opaque*>(static_cast<const unsigned*>(first) + 1);
  auto* second_handle =
      reinterpret_cast<const Opaque*>(static_cast<const unsigned*>(second) + 3);
  const void* cursor = select(first_handle, second_handle, choose_second);
  auto* destination = static_cast<unsigned*>(output) + 1;
  for (unsigned index = 0; index < 3; ++index) {
    cursor = advance(cursor, step_bytes);
    destination[index] = *static_cast<const unsigned*>(cursor);
  }
}
// ----
kernel.def @erased() {
  %5 = index.constant 1 : index
  kernel.launch.config workgroups(%5, %5, %5) workgroup_size(%5, %5, %5) : index
} launch(%first: buffer, %second: buffer, %output: buffer, %choose_second: i32, %step_bytes: i32) {
  %first_handle_byte_offset = index.constant 4 : offset
  %second_handle_byte_offset = index.constant 12 : offset
  %cursor$30, %cursor_byte_offset$31 = func.call pure @select(%first, %first_handle_byte_offset, %second, %second_handle_byte_offset, %choose_second) : (buffer, offset, buffer, offset, i32) -> (buffer, offset)
  %88 = index.constant 0 : offset
  %87 = index.constant 3 : offset
  %44 = index.constant 1 : offset
  %cursor$48, %cursor_byte_offset$49 = scf.for %index = [%88 to %87 step %44](%cursor$46 = %cursor$30 : buffer, %cursor_byte_offset$47 = %cursor_byte_offset$31 : offset) -> (buffer, offset) {
    %50 = index.cast %index : offset to i32
    %cursor$51, %cursor_byte_offset$52 = func.call pure @advance(%cursor$46, %cursor_byte_offset$47, %step_bytes) : (buffer, offset, i32) -> (buffer, offset)
    %53 = buffer.view %cursor$51[%cursor_byte_offset$52] : buffer -> view<1xi32>
    %54 = view.load %53[0] : view<1xi32> -> i32
    %55 = scalar.extui %50 : i32 to i64
    %92 = scalar.constant 2 : i64
    %93 = scalar.shli %55, %92 : i64
    %86 = scalar.constant 4 : i64
    %91 = scalar.addi %93, %86 : i64
    %60 = scalar.assume %91 [range(%91, 0, 9223372036854775807)] : i64
    %61 = index.cast %60 : i64 to offset
    %62 = buffer.view %output[%61] : buffer -> view<1xi32>
    view.store %54, %62[0] : i32, view<1xi32>
    scf.yield %cursor$51, %cursor_byte_offset$52 : buffer, offset
  }
  kernel.return
}

func.def @select(%first: buffer, %first_byte_offset: offset, %second: buffer, %second_byte_offset: offset, %choose_second: i32) -> (buffer, offset) {
  %70 = scalar.constant 0 : i32
  %71 = scalar.cmpi ne, %choose_second, %70 : i32
  %94 = scf.select %71, %second, %first : buffer
  %95 = scf.select %71, %second_byte_offset, %first_byte_offset : offset
  func.return %94, %95 : buffer, offset
}

func.def @advance(%pointer: buffer, %pointer_byte_offset: offset, %bytes: i32) -> (buffer, offset) {
  %79 = scalar.extui %bytes : i32 to i64
  %82 = index.cast %pointer_byte_offset : offset to i64
  %83 = scalar.addi %82, %79 : i64
  %84 = scalar.assume %83 [range(%83, 0, 9223372036854775807)] : i64
  %85 = index.cast %84 : i64 to offset
  func.return %pointer, %85 : buffer, offset
}

// ====
// RUN: pass canonicalize,cse,dce
// The directly typed form keeps the same root/origin selection and byte
// displacement contract without opaque helper transport.
[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void typed(const unsigned* first, const unsigned* second, unsigned* output,
           unsigned choose_second, unsigned step_bytes) {
  const unsigned* cursor = choose_second ? second + 3 : first + 1;
  auto* destination = output + 1;
  for (unsigned index = 0; index < 3; ++index) {
    cursor = reinterpret_cast<const unsigned*>(
        reinterpret_cast<const unsigned char*>(cursor) + step_bytes);
    destination[index] = *cursor;
  }
}
// ----
kernel.def @typed() {
  %5 = index.constant 1 : index
  kernel.launch.config workgroups(%5, %5, %5) workgroup_size(%5, %5, %5) : index
} launch(%first: buffer, %second: buffer, %output: buffer, %choose_second: i32, %step_bytes: i32) {
  %14 = scalar.constant 0 : i32
  %15 = scalar.cmpi ne, %choose_second, %14 : i32
  %cursor, %cursor_byte_offset$17 = scf.if %15 -> (buffer, offset) {
    %74 = index.constant 12 : offset
    scf.yield %second, %74 : buffer, offset
  } else {
    %73 = index.constant 4 : offset
    scf.yield %first, %73 : buffer, offset
  }
  %72 = index.constant 0 : offset
  %71 = index.constant 3 : offset
  %46 = index.constant 1 : offset
  %cursor_byte_offset$80 = scf.for %index = [%72 to %71 step %46](%cursor_byte_offset$79 = %cursor_byte_offset$17 : offset) -> (offset) {
    %52 = index.cast %index : offset to i32
    %53 = scalar.extui %step_bytes : i32 to i64
    %56 = index.cast %cursor_byte_offset$79 : offset to i64
    %57 = scalar.addi %56, %53 : i64
    %58 = scalar.assume %57 [range(%57, 0, 9223372036854775807)] : i64
    %cursor_byte_offset$59 = index.cast %58 : i64 to offset
    %60 = buffer.view %cursor[%cursor_byte_offset$59] : buffer -> view<1xi32>
    %61 = view.load %60[0] : view<1xi32> -> i32
    %62 = scalar.extui %52 : i32 to i64
    %76 = scalar.constant 2 : i64
    %77 = scalar.shli %62, %76 : i64
    %70 = scalar.constant 4 : i64
    %75 = scalar.addi %77, %70 : i64
    %67 = scalar.assume %75 [range(%75, 0, 9223372036854775807)] : i64
    %68 = index.cast %67 : i64 to offset
    %69 = buffer.view %output[%68] : buffer -> view<1xi32>
    view.store %61, %69[0] : i32, view<1xi32>
    scf.yield %cursor_byte_offset$59 : offset
  }
  kernel.return
}
