// RUN: pass canonicalize,cse,dce
// Erasing and recovering an object type does not change either pointer component.
void* erase(unsigned* pointer) { return pointer; }
unsigned* recover(void* pointer) { return static_cast<unsigned*>(pointer); }
const unsigned* observe(const void* pointer) {
  return static_cast<const unsigned*>(pointer);
}

// ----
func.def public @erase(%pointer: buffer, %pointer_byte_offset: index) -> (buffer, index) {
  func.return %pointer, %pointer_byte_offset : buffer, index
}

func.def public @recover(%pointer: buffer, %pointer_byte_offset: index) -> (buffer, index) {
  func.return %pointer, %pointer_byte_offset : buffer, index
}

func.def public @observe(%pointer: buffer, %pointer_byte_offset: index) -> (buffer, index) {
  func.return %pointer, %pointer_byte_offset : buffer, index
}

// ====
// A forward declaration is enough for helper calls and branch transport.
struct Opaque;
static const Opaque* forward(const Opaque* handle) { return handle; }
const Opaque* select(const Opaque* first, const Opaque* second, bool choose) {
  const Opaque* selected = forward(first);
  if (choose) selected = forward(second);
  return selected;
}

// ----
func.def public @select(%first: buffer, %first_byte_offset: index, %second: buffer, %second_byte_offset: index, %choose: i1) -> (buffer, index) {
  %selected$7, %selected_byte_offset$8 = func.call pure @forward(%first, %first_byte_offset) : (buffer, index) -> (buffer, index)
  %selected$9, %selected_byte_offset$10 = scf.if %choose -> (buffer, index) {
    %selected, %selected_byte_offset = func.call pure @forward(%second, %second_byte_offset) : (buffer, index) -> (buffer, index)
    scf.yield %selected, %selected_byte_offset : buffer, index
  } else {
    scf.yield %selected$7, %selected_byte_offset$8 : buffer, index
  }
  func.return %selected$9, %selected_byte_offset$10 : buffer, index
}

func.def @forward(%handle: buffer, %handle_byte_offset: index) -> (buffer, index) {
  func.return %handle, %handle_byte_offset : buffer, index
}

// ====
// Byte displacement is applied to the retained interior origin.
unsigned read_erased(const void* storage, unsigned byte_offset) {
  auto* bytes = static_cast<const unsigned char*>(storage);
  auto* element = reinterpret_cast<const unsigned*>(bytes + byte_offset);
  return *element;
}

// ----
func.def public @read_erased(%storage: buffer, %storage_byte_offset: index, %byte_offset: i32) -> (i32) {
  %4 = scalar.extui %byte_offset : i32 to i64
  %5 = index.cast %4 : i64 to index
  %element_byte_offset = index.add %storage_byte_offset, %5 : index
  %9 = buffer.view %storage[%element_byte_offset] : buffer -> view<1xi32>
  %10 = view.load<root_in_bounds|type_disjoint> %9[0] : view<1xi32> -> i32
  func.return %10 : i32
}

// ====
// Access qualifiers survive erasure and C-style recovery.
unsigned exchange(volatile void* storage, unsigned value) {
  auto* pointer = (volatile unsigned*)storage;
  auto previous = *pointer;
  *pointer = value;
  return previous;
}

// ----
func.def public @exchange(%storage: buffer, %storage_byte_offset: index, %value: i32) -> (i32) {
  %4 = buffer.view %storage[%storage_byte_offset] : buffer -> view<1xi32>
  %previous = view.load<volatile|root_in_bounds|type_disjoint> %4[0] : view<1xi32> -> i32
  view.store<volatile|root_in_bounds|type_disjoint> %value, %4[0] : i32, view<1xi32>
  func.return %previous : i32
}

// ====
// An SSA record can carry opaque pointer fields without storing raw addresses.
struct Opaque;
struct Handle { Opaque* object; unsigned tag; };
Handle tagged(void* pointer, unsigned tag) {
  return {static_cast<Opaque*>(pointer), tag};
}
const void* untag(Handle handle) { return handle.object; }

// ----
func.def public @tagged(%pointer: buffer, %pointer_byte_offset: index, %tag: i32) -> (buffer, index, i32) {
  func.return %pointer, %pointer_byte_offset, %tag : buffer, index, i32
}

func.def public @untag(%handle_object: buffer, %handle_object_byte_offset: index, %handle_tag: i32) -> (buffer, index) {
  func.return %handle_object, %handle_object_byte_offset : buffer, index
}

// ====
// Address/dereference cancellation does not request a complete object layout.
struct Opaque;
static Opaque* forward(Opaque* pointer) { return pointer; }
Opaque* address(Opaque* pointer) { return &(*(forward(pointer))); }

// ----
func.def public @address(%pointer: buffer, %pointer_byte_offset: index) -> (buffer, index) {
  %4, %5 = func.call pure @forward(%pointer, %pointer_byte_offset) : (buffer, index) -> (buffer, index)
  func.return %4, %5 : buffer, index
}

func.def @forward(%pointer: buffer, %pointer_byte_offset: index) -> (buffer, index) {
  func.return %pointer, %pointer_byte_offset : buffer, index
}

// ====
// Pointer transport does not imply support for the pointed-to storage format.
union Payload { unsigned integer; float real; };
struct Owned { ~Owned() {} };
Payload* payload(Payload* pointer) { return pointer; }
Owned* owned(Owned* pointer) { return pointer; }
bool* boolean(bool* pointer) { return pointer; }
unsigned** indirect(unsigned** pointer) { return pointer; }

// ----
func.def public @payload(%pointer: buffer, %pointer_byte_offset: index) -> (buffer, index) {
  func.return %pointer, %pointer_byte_offset : buffer, index
}

func.def public @owned(%pointer: buffer, %pointer_byte_offset: index) -> (buffer, index) {
  func.return %pointer, %pointer_byte_offset : buffer, index
}

func.def public @boolean(%pointer: buffer, %pointer_byte_offset: index) -> (buffer, index) {
  func.return %pointer, %pointer_byte_offset : buffer, index
}

func.def public @indirect(%pointer: buffer, %pointer_byte_offset: index) -> (buffer, index) {
  func.return %pointer, %pointer_byte_offset : buffer, index
}

// ====
// Pointee destruction does not alter ordinary pointer arithmetic.
struct Owned { unsigned value; ~Owned() {} };
const Owned* advance(const void* storage) {
  auto* pointer = static_cast<const Owned*>(storage);
  return pointer + 1;
}

// ----
func.def public @advance(%storage: buffer, %storage_byte_offset: index) -> (buffer, index) {
  %9 = index.constant 4 : index
  %8 = index.add %storage_byte_offset, %9 : index
  func.return %storage, %8 : buffer, index
}

// ====
// RUN: pass canonicalize,cse,dce
// Two different roots and nonzero origins cross opaque helper selection,
// byte stepping, a loop backedge, and typed loads into an interior destination.
struct Opaque;
static const Opaque* select(const Opaque* first, const Opaque* second,
                            unsigned choose_second) {
  if (choose_second) {
    return second;
  }
  return first;
}
static const void* advance(const void* pointer, unsigned bytes) {
  return static_cast<const unsigned char*>(pointer) + bytes;
}
[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void erased(const void* first, const void* second, void* output,
            unsigned choose_second, unsigned step_bytes) {
  auto* first_handle =
      reinterpret_cast<const Opaque*>(static_cast<const unsigned*>(first) + 1);
  auto* second_handle =
      reinterpret_cast<const Opaque*>(static_cast<const unsigned*>(second) + 3);
  const void* cursor = select(first_handle, second_handle, choose_second);
  auto* destination = static_cast<unsigned*>(output) + 1;
  for (unsigned index = 0; index < 3; ++index) {
    cursor = advance(cursor, step_bytes);
    destination[index] = *static_cast<const unsigned*>(cursor);
  }
}
// ----
kernel.def @erased() {
  %5 = index.constant 1 : index
  kernel.launch.config workgroups(%5, %5, %5) workgroup_size(%5, %5, %5) : index
} launch(%first: buffer, %second: buffer, %output: buffer, %choose_second: i32, %step_bytes: i32) {
  %first_handle_byte_offset = index.constant 4 : index
  %second_handle_byte_offset = index.constant 12 : index
  %cursor$24, %cursor_byte_offset$25 = func.call pure @select(%first, %first_handle_byte_offset, %second, %second_handle_byte_offset, %choose_second) : (buffer, index, buffer, index, i32) -> (buffer, index)
  %74 = index.constant 0 : offset
  %73 = index.constant 3 : offset
  %35 = index.constant 1 : offset
  %cursor$39, %cursor_byte_offset$40 = scf.for %index = [%74 to %73 step %35](%cursor$37 = %cursor$24 : buffer, %cursor_byte_offset$38 = %cursor_byte_offset$25 : index) -> (buffer, index) {
    %41 = index.cast %index : offset to i32
    %cursor$42, %cursor_byte_offset$43 = func.call pure @advance(%cursor$37, %cursor_byte_offset$38, %step_bytes) : (buffer, index, i32) -> (buffer, index)
    %44 = buffer.view %cursor$42[%cursor_byte_offset$43] : buffer -> view<1xi32>
    %45 = view.load<root_in_bounds|type_disjoint> %44[0] : view<1xi32> -> i32
    %46 = scalar.extui %41 : i32 to i64
    %47 = index.cast %46 : i64 to index
    %78 = index.madd %47, %first_handle_byte_offset, %first_handle_byte_offset : index
    %51 = buffer.view %output[%78] : buffer -> view<1xi32>
    view.store<root_in_bounds|type_disjoint> %45, %51[0] : i32, view<1xi32>
    scf.yield %cursor$42, %cursor_byte_offset$43 : buffer, index
  }
  kernel.return
}

func.def @select(%first: buffer, %first_byte_offset: index, %second: buffer, %second_byte_offset: index, %choose_second: i32) -> (buffer, index) {
  %59 = scalar.constant 0 : i32
  %60 = scalar.cmpi ne, %choose_second, %59 : i32
  %79 = scf.select %60, %second, %first : buffer
  %80 = scf.select %60, %second_byte_offset, %first_byte_offset : index
  func.return %79, %80 : buffer, index
}

func.def @advance(%pointer: buffer, %pointer_byte_offset: index, %bytes: i32) -> (buffer, index) {
  %68 = scalar.extui %bytes : i32 to i64
  %69 = index.cast %68 : i64 to index
  %72 = index.add %pointer_byte_offset, %69 : index
  func.return %pointer, %72 : buffer, index
}

// ====
// RUN: pass canonicalize,cse,dce
// The directly typed form keeps the same root/origin selection and byte
// displacement contract without opaque helper transport.
[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void typed(const unsigned* first, const unsigned* second, unsigned* output,
           unsigned choose_second, unsigned step_bytes) {
  const unsigned* cursor = choose_second ? second + 3 : first + 1;
  auto* destination = output + 1;
  for (unsigned index = 0; index < 3; ++index) {
    cursor = reinterpret_cast<const unsigned*>(
        reinterpret_cast<const unsigned char*>(cursor) + step_bytes);
    destination[index] = *cursor;
  }
}
// ----
kernel.def @typed() {
  %5 = index.constant 1 : index
  kernel.launch.config workgroups(%5, %5, %5) workgroup_size(%5, %5, %5) : index
} launch(%first: buffer, %second: buffer, %output: buffer, %choose_second: i32, %step_bytes: i32) {
  %14 = scalar.constant 0 : i32
  %15 = scalar.cmpi ne, %choose_second, %14 : i32
  %cursor, %cursor_byte_offset$17 = scf.if %15 -> (buffer, index) {
    %61 = index.constant 12 : index
    scf.yield %second, %61 : buffer, index
  } else {
    %60 = index.constant 4 : index
    scf.yield %first, %60 : buffer, index
  }
  %destination_byte_offset = index.constant 4 : index
  %58 = index.constant 0 : offset
  %57 = index.constant 3 : offset
  %37 = index.constant 1 : offset
  %cursor_byte_offset$65 = scf.for %index = [%58 to %57 step %37](%cursor_byte_offset$64 = %cursor_byte_offset$17 : index) -> (index) {
    %43 = index.cast %index : offset to i32
    %44 = scalar.extui %step_bytes : i32 to i64
    %45 = index.cast %44 : i64 to index
    %cursor_byte_offset$48 = index.add %cursor_byte_offset$64, %45 : index
    %49 = buffer.view %cursor[%cursor_byte_offset$48] : buffer -> view<1xi32>
    %50 = view.load<root_in_bounds|type_disjoint> %49[0] : view<1xi32> -> i32
    %51 = scalar.extui %43 : i32 to i64
    %52 = index.cast %51 : i64 to index
    %62 = index.madd %52, %destination_byte_offset, %destination_byte_offset : index
    %56 = buffer.view %output[%62] : buffer -> view<1xi32>
    view.store<root_in_bounds|type_disjoint> %50, %56[0] : i32, view<1xi32>
    scf.yield %cursor_byte_offset$48 : index
  }
  kernel.return
}
