{
  "version": 1,
  "cases": [
    {
      "name": "preserves exact byte and UTF8 payloads through C++ export and reimport",
      "steps": [
        {
          "name": "import-first",
          "run": {
            "tool": "loom-import-cxx",
            "args": [
              "--cleanup=false",
              "--to=bc",
              "--output={tmp}/first.loombc",
              "-"
            ]
          },
          "stderr": {
            "empty": true
          },
          "stdin": {
            "text": "#include <loomcxx/kernel.h>\n[[loom::kernel, loom::workgroup_count(1, 1, 1), loom::workgroup_size(1, 1, 1)]]\nvoid payloads() {\n  auto* raw = loom::buffer::constant<16>(\"\\000123\\377A\\\\\\\"\");\n  auto* text = loom::buffer::constant(u8\"café 🧵\\n\\0\");\n  auto* empty = loom::buffer::constant(\"\");\n  auto* empty_text = loom::buffer::constant(u8\"\");\n  auto* scratch = loom::buffer::alloca_init<loom::memory_space::private_, 4>(\"abcd\");\n  auto* shared = loom::buffer::alloca_init<loom::memory_space::workgroup, 16>(u8\"abcd\");\n}\n"
          }
        },
        {
          "name": "export-first",
          "run": {
            "tool": "loom-export-cxx",
            "args": [
              "{tmp}/first.loombc",
              "--output={tmp}/first.cxx"
            ]
          },
          "stderr": {
            "empty": true
          }
        },
        {
          "name": "import-second",
          "run": {
            "tool": "loom-import-cxx",
            "args": [
              "--cleanup=false",
              "--to=bc",
              "--output={tmp}/second.loombc",
              "{tmp}/first.cxx"
            ]
          },
          "stderr": {
            "empty": true
          }
        },
        {
          "name": "export-second",
          "run": {
            "tool": "loom-export-cxx",
            "args": [
              "{tmp}/second.loombc",
              "--output={tmp}/second.cxx"
            ]
          },
          "stderr": {
            "empty": true
          },
          "files": [
            {
              "path": "{tmp}/second.cxx",
              "equals": "{tmp}/first.cxx"
            }
          ]
        }
      ]
    }
  ]
}
