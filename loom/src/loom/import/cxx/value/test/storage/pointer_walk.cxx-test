  %total$19 = scalar.constant 0 : i32
  %177 = index.constant 0 : offset
  %22 = index.cast %count : i32 to offset
  %23 = index.constant 1 : offset
  %total$183, %cursor_byte_offset$184 = scf.for %index = [%177 to %22 step %23](%total$181 = %total$19 : i32, %cursor_byte_offset$182 = %base_byte_offset : index) -> (i32, index) {
    %31 = index.cast %index : offset to i32
