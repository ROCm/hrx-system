  %174 = index.constant 12 : index
  %47 = index.add %result_byte_offset, %174 : index
  %48 = buffer.view %result[%47] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %total$183, %48[0] : i32, view<1xi32>
