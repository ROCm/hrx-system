// RUN: pass inline-callables,canonicalize,cse,dce
// Signed wide displacements, reversed subscripts, unary pointer plus,
// and branch-selected interior origins compose without losing the root.
#include <hip/hip_runtime.h>
__device__ __forceinline__ const int* advance(const int* pointer,
                                              long long count) {
  if (count == 0) {
    return pointer;
  }
  return +(pointer + count);
}
void selected_access(const int* input, int* output, unsigned lane,
                     long long start, long long displacement) {
  const int* base = advance(input, start + (long long)lane * 64);
  const int* selected = (lane & 1u) ? base + 2 : 4 + base;
  int* result = output + (unsigned long long)lane * 10;
  result[0] = selected[-1];
  result[1] = *advance(selected, displacement);
  result[2] = *(&2 [base]);
}
// ----
func.def public linkonce device inline @advance(%pointer: buffer, %pointer_byte_offset: index, %count: i64) -> (buffer, index) {
  %110 = scalar.constant 0 : i64
  %7 = scalar.cmpi eq, %count, %110 : i64
  %112 = scf.if %7 -> (index) {
    scf.yield %pointer_byte_offset : index
  } else {
    %108 = scalar.assume %count [ne(%count, 0)] : i64
    %10 = index.cast %108 : i64 to index
    %109 = index.assume %10 [ne(%10, 0)] : index
    %11 = index.constant 4 : index
    %111 = index.madd %109, %11, %pointer_byte_offset : index
    scf.yield %111 : index
  }
  func.return %pointer, %112 : buffer, index
}

func.def public @selected_access(%input: buffer, %input_byte_offset: index, %output: buffer, %output_byte_offset: index, %lane: i32, %start: i64, %displacement: i64) {
  %21 = scalar.extui %lane : i32 to i64
  %139 = scalar.constant 6 : i64
  %140 = scalar.shli %21, %139 : i64
  %25 = scalar.addi %start, %140 : i64
  %126 = scalar.constant 0 : i64
  %101 = scalar.cmpi eq, %25, %126 : i64
  %base_byte_offset = scf.if %101 -> (index) {
    scf.yield %input_byte_offset : index
  } else {
    %113 = scalar.assume %25 [ne(%25, 0)] : i64
    %104 = index.cast %113 : i64 to index
    %114 = index.assume %104 [ne(%104, 0)] : index
    %105 = index.constant 4 : index
    %128 = index.madd %114, %105, %input_byte_offset : index
    scf.yield %128 : index
  }
  %28 = scalar.constant 1 : i32
  %29 = scalar.andi %lane, %28 : i32
  %30 = scalar.constant 0 : i32
  %31 = scalar.cmpi ne, %29, %30 : i32
  %125 = index.constant 8 : index
  %124 = index.constant 16 : index
  %137 = scf.select %31, %125, %124 : index
  %selected_byte_offset = index.add %base_byte_offset, %137 : index
  %123 = scalar.constant 10 : i64
  %47 = scalar.muli %21, %123 : i64
  %48 = index.cast %47 : i64 to index
  %49 = index.constant 4 : index
  %result_byte_offset = index.madd %48, %49, %output_byte_offset : index
  %122 = index.constant -4 : index
  %58 = index.add %selected_byte_offset, %122 : index
  %59 = buffer.view %input[%58] : buffer -> view<1xi32>
  %60 = view.load<root_in_bounds|type_disjoint> %59[0] : view<1xi32> -> i32
  %66 = buffer.view %output[%result_byte_offset] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %60, %66[0] : i32, view<1xi32>
  %92 = scalar.cmpi eq, %displacement, %126 : i64
  %130 = scf.if %92 -> (index) {
    scf.yield %selected_byte_offset : index
  } else {
    %115 = scalar.assume %displacement [ne(%displacement, 0)] : i64
    %95 = index.cast %115 : i64 to index
    %116 = index.assume %95 [ne(%95, 0)] : index
    %129 = index.madd %116, %49, %selected_byte_offset : index
    scf.yield %129 : index
  }
  %69 = buffer.view %input[%130] : buffer -> view<1xi32>
  %70 = view.load<root_in_bounds|type_disjoint> %69[0] : view<1xi32> -> i32
  %75 = index.add %result_byte_offset, %49 : index
  %76 = buffer.view %output[%75] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %70, %76[0] : i32, view<1xi32>
  %81 = index.add %base_byte_offset, %125 : index
  %82 = buffer.view %input[%81] : buffer -> view<1xi32>
  %83 = view.load<root_in_bounds|type_disjoint> %82[0] : view<1xi32> -> i32
  %88 = index.add %result_byte_offset, %125 : index
  %89 = buffer.view %output[%88] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %83, %89[0] : i32, view<1xi32>
  func.return
}

// ====
// RUN: pass inline-callables,canonicalize,cse,dce
// Forward and backward walks carry the cursor through their backedges.
// The do loop advances once even when count is zero; every final cursor and
// accumulated sum is observed separately.
#include <hip/hip_runtime.h>
__device__ __forceinline__ const int* advance(const int* pointer,
                                              long long count) {
  if (count == 0) {
    return pointer;
  }
  return +(pointer + count);
}
void cursor_loops(const int* base, int* result, unsigned count) {
  const int* cursor = base;
  int total = 0;
  for (unsigned index = 0; index < count; ++index) {
    total += *advance(base, index);
    ++cursor;
  }
  result[3] = total;
  result[4] = *cursor;
  unsigned index = 0;
  total = 0;
  while (index < count) {
    --cursor;
    total += *cursor;
    ++index;
  }
  result[5] = total;
  result[6] = *cursor;
  index = 0;
  do {
    cursor += 1;
    ++index;
  } while (index < count);
  result[7] = *cursor;
  cursor -= 1;
  result[8] = *cursor;
  (*(result + 9)) = *(cursor - 1);
}
// ----
func.def public linkonce device inline @advance(%pointer: buffer, %pointer_byte_offset: index, %count: i64) -> (buffer, index) {
  %159 = scalar.constant 0 : i64
  %7 = scalar.cmpi eq, %count, %159 : i64
  %161 = scf.if %7 -> (index) {
    scf.yield %pointer_byte_offset : index
  } else {
    %157 = scalar.assume %count [ne(%count, 0)] : i64
    %10 = index.cast %157 : i64 to index
    %158 = index.assume %10 [ne(%10, 0)] : index
    %11 = index.constant 4 : index
    %160 = index.madd %158, %11, %pointer_byte_offset : index
    scf.yield %160 : index
  }
  func.return %pointer, %161 : buffer, index
}

