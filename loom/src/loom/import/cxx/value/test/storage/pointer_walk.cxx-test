    }
    %35 = buffer.view %base[%179] : buffer -> view<1xi32>
    %36 = view.load<root_in_bounds|type_disjoint> %35[0] : view<1xi32> -> i32
    %total$37 = scalar.addi %total$181, %36 : i32
    %175 = index.constant 4 : index
    %cursor_byte_offset$42 = index.add %cursor_byte_offset$182, %175 : index
