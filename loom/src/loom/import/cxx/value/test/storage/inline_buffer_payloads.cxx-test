// RUN: pass canonicalize,cse,dce
#include <loomcxx/buffer.h>

const unsigned char* raw() { return loom::buffer::constant<16>("a\0\xff"); }
const unsigned char* text() { return loom::buffer::constant(u8"café 🧵"); }
const unsigned char* empty() { return loom::buffer::constant(""); }
const unsigned char* zero() { return loom::buffer::constant(u8"\0"); }

// ----
func.def public @raw() -> (buffer, index) {
  %2 = buffer.constant align(16) bytes("6100ff") : buffer
  %3 = index.constant 0 : index
  func.return %2, %3 : buffer, index
}

func.def public @text() -> (buffer, index) {
  %6 = buffer.constant align(1) utf8("café 🧵") : buffer
  %7 = index.constant 0 : index
  func.return %6, %7 : buffer, index
}

func.def public @empty() -> (buffer, index) {
  %10 = buffer.constant align(1) bytes("") : buffer
  %11 = index.constant 0 : index
  func.return %10, %11 : buffer, index
}

func.def public @zero() -> (buffer, index) {
  %14 = buffer.constant align(1) utf8("\u0000") : buffer
  %15 = index.constant 0 : index
  func.return %14, %15 : buffer, index
}

// ====
// RUN: pass canonicalize,cse,dce
#include <loomcxx/buffer.h>
unsigned initialized(unsigned position, unsigned replacement) {
  auto* first = loom::buffer::alloca_init<loom::memory_space::private_, 8>("abcd");
  auto* second = loom::buffer::alloca_init<loom::memory_space::private_, 8>("abcd");
  first[position] = replacement;
  return first[position] + second[position];
}

// ----
func.def public @initialized(%position: i32, %replacement: i32) -> (i32) {
  %first = buffer.alloca.init<private> align(8) bytes("61626364") : buffer
  %second = buffer.alloca.init<private> align(8) bytes("61626364") : buffer
  %7 = scalar.trunci %replacement : i32 to i8
  %8 = scalar.extui %position : i32 to i64
  %9 = index.cast %8 : i64 to index
  %13 = index.assume %9 [range(%9, 0, 3)] : index
  %14 = buffer.view %first[%13] : buffer -> view<1xi8>
  view.store %7, %14[0] : i8, view<1xi8>
  %22 = view.load %14[0] : view<1xi8> -> i8
  %23 = scalar.extui %22 : i8 to i32
  %30 = buffer.view %second[%13] : buffer -> view<1xi8>
  %31 = view.load %30[0] : view<1xi8> -> i8
  %32 = scalar.extui %31 : i8 to i32
  %33 = scalar.addi %23, %32 : i32
  func.return %33 : i32
}

// ====
// RUN: verify
#include <loomcxx/buffer.h>
const unsigned char* dynamic() {
  const char input[] = "abc";
  // ERROR@+1: LOWERING/059 "buffer payload requires a string literal"
  return loom::buffer::constant(input);
}

// ====
// RUN: verify
#include <loomcxx/buffer.h>
const unsigned char* invalid_utf8() {
  // ERROR@+1: LOWERING/059 "utf8 buffer payload must be valid UTF-8"
  return loom::buffer::constant(u8"\xff");
}

// ====
// RUN: verify
#include <loomcxx/buffer.h>
const unsigned char* alignment() {
  // ERROR@+1: LOWERING/059 "buffer.constant alignment must be a positive power-of-two byte count"
  return loom::buffer::constant<3>("abcd");
}

// ====
// RUN: verify
#include <loomcxx/buffer.h>
unsigned char* readonly_space() {
  // ERROR@+1: LOWERING/059 "buffer.alloca.init requires an allocatable memory space: global, workgroup, private, host, or generic"
  return loom::buffer::alloca_init<loom::memory_space::constant>("abcd");
}

// ====
// INPUT: cxx std=c++17
// RUN: pass canonicalize,cse,dce
#include <loomcxx/buffer.h>
const unsigned char* compatibility() { return loom::buffer::constant("abc"); }

// ----
func.def public @compatibility() -> (buffer, index) {
  %2 = buffer.constant align(1) bytes("616263") : buffer
  %3 = index.constant 0 : index
  func.return %2, %3 : buffer, index
}

// ====
// RUN: pass kernel-synchronization-legality
#include <loomcxx/buffer.h>
#include <loomcxx/kernel.h>
[[loom::kernel, loom::workgroup_count(1, 1, 1), loom::workgroup_size(4, 1, 1)]]
void divergent() {
  if (static_cast<unsigned>(loom::kernel::workitem::id.x) != 0) {
    // ERROR@+1: STRUCTURE/038 "buffer.alloca.init" "workgroup"
    auto* shared = loom::buffer::alloca_init<loom::memory_space::workgroup>("abc");
  }
}

// ====
// RUN: pass canonicalize,cse,dce
// A write to one initialized buffer must not change the other two payload identities.
#include <loomcxx/buffer.h>
#include <loomcxx/predicate.h>

unsigned payloads(unsigned position, unsigned replacement) {
  loom::assume(position < 16u);
  auto* original = loom::buffer::constant<16>("a\0\xffZ");
  auto* first =
      loom::buffer::alloca_init<loom::memory_space::private_, 16>("a\0\xffZ");
  auto* second =
      loom::buffer::alloca_init<loom::memory_space::private_, 16>("a\0\xffZ");
  first[position] = replacement;
  return first[position] + 256u * second[position] +
         65536u * original[position];
}

// ----
func.def public @payloads(%position$0: i32, %replacement: i32) -> (i32) {
  %position$3 = scalar.assume %position$0 [range(%position$0, 0, 15)] : i32
  %original = buffer.constant align(16) bytes("6100ff5a") : buffer
  %first = buffer.alloca.init<private> align(16) bytes("6100ff5a") : buffer
  %second = buffer.alloca.init<private> align(16) bytes("6100ff5a") : buffer
  %10 = scalar.trunci %replacement : i32 to i8
  %11 = scalar.extui %position$3 : i32 to i64
  %12 = index.cast %11 : i64 to index
  %16 = index.assume %12 [range(%12, 0, 3)] : index
  %17 = buffer.view %first[%16] : buffer -> view<1xi8>
  view.store %10, %17[0] : i8, view<1xi8>
  %25 = view.load %17[0] : view<1xi8> -> i8
  %26 = scalar.extui %25 : i8 to i32
  %34 = buffer.view %second[%16] : buffer -> view<1xi8>
  %35 = view.load %34[0] : view<1xi8> -> i8
  %36 = scalar.extui %35 : i8 to i32
  %53 = scalar.constant 8 : i32
  %54 = scalar.shli %36, %53 : i32
  %38 = scalar.addi %26, %54 : i32
  %46 = buffer.view %original[%16] : buffer -> view<1xi8>
  %47 = view.load %46[0] : view<1xi8> -> i8
  %48 = scalar.extui %47 : i8 to i32
  %51 = scalar.constant 16 : i32
  %52 = scalar.shli %48, %51 : i32
  %50 = scalar.addi %38, %52 : i32
  func.return %50 : i32
}
