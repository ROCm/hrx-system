// RUN: roundtrip
// Restricted pointer paths and every representable incoming storage peer enter
// one callable scope. Returning a restricted path removes that association
// without changing its physical root or byte origin.
using restricted_pointer = int* __restrict__;

int* combine(restricted_pointer left, int* __restrict right, int* peer) {
  left += 1;
  int* derived = left - 1;
  derived[0] += right[0];
  peer[0] = derived[0];
  return derived;
}

// ----
func.def public @combine(%left$0: buffer, %left_byte_offset$1: index, %right: buffer, %right_byte_offset: index, %peer: buffer, %peer_byte_offset: index) -> (buffer, index) {
  %left$8, %9, %10 = buffer.restrict.begin %left$0, %right peers %peer : buffer, buffer, buffer
  %11 = scalar.constant 1 : i32
  %12 = index.cast %11 : i32 to index
  %13 = index.constant 4 : index
  %14 = index.mul %12, %13 : index
  %left_byte_offset$15 = index.add %left_byte_offset$1, %14 : index
  %16 = scalar.constant 1 : i32
  %17 = index.cast %16 : i32 to index
  %18 = index.constant 4 : index
  %19 = index.mul %17, %18 : index
  %derived_byte_offset = index.sub %left_byte_offset$15, %19 : index
  %21 = scalar.constant 0 : i32
  %22 = index.cast %21 : i32 to index
  %23 = index.constant 4 : index
  %24 = index.mul %22, %23 : index
  %25 = index.add %right_byte_offset, %24 : index
  %26 = buffer.view %9[%25] : buffer -> view<1xi32>
  %27 = view.load<root_in_bounds|type_disjoint> %26[0] : view<1xi32> -> i32
  %28 = scalar.constant 0 : i32
  %29 = index.cast %28 : i32 to index
  %30 = index.constant 4 : index
  %31 = index.mul %29, %30 : index
  %32 = index.add %derived_byte_offset, %31 : index
  %33 = buffer.view %left$8[%32] : buffer -> view<1xi32>
  %34 = view.load<root_in_bounds|type_disjoint> %33[0] : view<1xi32> -> i32
  %35 = scalar.addi %34, %27 : i32
  view.store<root_in_bounds|type_disjoint> %35, %33[0] : i32, view<1xi32>
  %36 = scalar.constant 0 : i32
  %37 = index.cast %36 : i32 to index
  %38 = index.constant 4 : index
  %39 = index.mul %37, %38 : index
  %40 = index.add %derived_byte_offset, %39 : index
  %41 = buffer.view %left$8[%40] : buffer -> view<1xi32>
  %42 = view.load<root_in_bounds|type_disjoint> %41[0] : view<1xi32> -> i32
  %43 = scalar.constant 0 : i32
  %44 = index.cast %43 : i32 to index
  %45 = index.constant 4 : index
  %46 = index.mul %44, %45 : index
  %47 = index.add %peer_byte_offset, %46 : index
  %48 = buffer.view %10[%47] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %42, %48[0] : i32, view<1xi32>
  %49 = buffer.restrict.end %left$8 : buffer
  func.return %49, %derived_byte_offset : buffer, index
}

// ====
// Address observation retains reference parameters as storage paths. The
// restricted reference and ordinary reference share one access domain while
// remaining ordinary physical roots.
static int combine_references(int& __restrict__ left, int& peer) {
  int* left_address = &left;
  int* peer_address = &peer;
  left += peer;
  return left_address == peer_address ? left : peer;
}

int reference_access(int* left, int* peer) {
  return combine_references(*left, *peer);
}

// ----
func.def public @reference_access(%left: buffer, %left_byte_offset: index, %peer: buffer, %peer_byte_offset: index) -> (i32) {
  %5 = func.call @combine_references(%left, %left_byte_offset, %peer, %peer_byte_offset) : (buffer, index, buffer, index) -> (i32)
  func.return %5 : i32
}

func.def @combine_references(%left: buffer, %left_byte_offset: index, %peer$8: buffer, %peer_byte_offset: index) -> (i32) {
  %left_address, %peer_address = buffer.restrict.begin %left peers %peer$8 : buffer, buffer
  %13 = buffer.view %peer_address[%peer_byte_offset] : buffer -> view<1xi32>
  %peer$14 = view.load<root_in_bounds|type_disjoint> %13[0] : view<1xi32> -> i32
  %15 = buffer.view %left_address[%left_byte_offset] : buffer -> view<1xi32>
  %16 = view.load<root_in_bounds|type_disjoint> %15[0] : view<1xi32> -> i32
  %17 = scalar.addi %16, %peer$14 : i32
  %18 = buffer.view %left_address[%left_byte_offset] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %17, %18[0] : i32, view<1xi32>
  %19 = buffer.compare.address eq, %left_address[%left_byte_offset], %peer_address[%peer_byte_offset]
  %20 = scf.if %19 -> (i32) {
    %21 = buffer.view %left_address[%left_byte_offset] : buffer -> view<1xi32>
    %left = view.load<root_in_bounds|type_disjoint> %21[0] : view<1xi32> -> i32
    scf.yield %left : i32
  } else {
    %23 = buffer.view %peer_address[%peer_byte_offset] : buffer -> view<1xi32>
    %peer = view.load<root_in_bounds|type_disjoint> %23[0] : view<1xi32> -> i32
    scf.yield %peer : i32
  }
  func.return %20 : i32
}

// ====
// A trailing restrict qualifier applies to the storage-backed implicit object.
// Its explicit pointer argument is the ordinary peer path in the same scope.
struct Counter {
  int value;

  int add(int* peer) __restrict__ {
    value += peer[0];
    return value;
  }
};

int update_counter(Counter* counter, int* peer) {
  return counter->add(peer);
}

// ----
func.def public @update_counter(%counter: buffer, %counter_byte_offset: index, %peer: buffer, %peer_byte_offset: index) -> (i32) {
  %5 = func.call @Counter__add_storage(%counter, %counter_byte_offset, %peer, %peer_byte_offset) : (buffer, index, buffer, index) -> (i32)
  func.return %5 : i32
}

func.def @Counter__add_storage(%this: buffer, %this_byte_offset: index, %peer: buffer, %peer_byte_offset: index) -> (i32) {
  %11, %12 = buffer.restrict.begin %this peers %peer : buffer, buffer
  %13 = scalar.constant 0 : i32
  %14 = index.cast %13 : i32 to index
  %15 = index.constant 4 : index
  %16 = index.mul %14, %15 : index
  %17 = index.add %peer_byte_offset, %16 : index
  %18 = buffer.view %12[%17] : buffer -> view<1xi32>
  %19 = view.load<root_in_bounds|type_disjoint> %18[0] : view<1xi32> -> i32
  %20 = index.constant 0 : index
  %21 = index.add %this_byte_offset, %20 : index
  %22 = buffer.view %11[%21] : buffer -> view<1xi32>
  %23 = view.load<root_in_bounds|type_disjoint> %22[0] : view<1xi32> -> i32
  %24 = scalar.addi %23, %19 : i32
  view.store<root_in_bounds|type_disjoint> %24, %22[0] : i32, view<1xi32>
  %25 = index.constant 0 : index
  %26 = index.add %this_byte_offset, %25 : index
  %27 = buffer.view %11[%26] : buffer -> view<1xi32>
  %value = view.load<root_in_bounds|type_disjoint> %27[0] : view<1xi32> -> i32
  func.return %value : i32
}

// ====
// Concrete template instances retain the qualifier on their own parameters.
// The returned root leaves the instantiated helper's scope before crossing the
// function boundary.
template <class T>
static T* select_restricted(T* __restrict__ selected, T* peer) {
  selected[0] += peer[0];
  return selected;
}

int template_access(int* selected, int* peer) {
  return select_restricted(selected, peer)[0];
}

// ----
func.def public @template_access(%selected: buffer, %selected_byte_offset: index, %peer: buffer, %peer_byte_offset: index) -> (i32) {
  %5, %6 = func.call @select_restricted_int(%selected, %selected_byte_offset, %peer, %peer_byte_offset) : (buffer, index, buffer, index) -> (buffer, index)
  %7 = scalar.constant 0 : i32
  %8 = index.cast %7 : i32 to index
  %9 = index.constant 4 : index
  %10 = index.mul %8, %9 : index
  %11 = index.add %6, %10 : index
  %12 = buffer.view %5[%11] : buffer -> view<1xi32>
  %13 = view.load<root_in_bounds|type_disjoint> %12[0] : view<1xi32> -> i32
  func.return %13 : i32
}

func.def @select_restricted_int(%selected: buffer, %selected_byte_offset: index, %peer: buffer, %peer_byte_offset: index) -> (buffer, index) {
  %20, %21 = buffer.restrict.begin %selected peers %peer : buffer, buffer
  %22 = scalar.constant 0 : i32
  %23 = index.cast %22 : i32 to index
  %24 = index.constant 4 : index
  %25 = index.mul %23, %24 : index
  %26 = index.add %peer_byte_offset, %25 : index
  %27 = buffer.view %21[%26] : buffer -> view<1xi32>
  %28 = view.load<root_in_bounds|type_disjoint> %27[0] : view<1xi32> -> i32
  %29 = scalar.constant 0 : i32
  %30 = index.cast %29 : i32 to index
  %31 = index.constant 4 : index
  %32 = index.mul %30, %31 : index
  %33 = index.add %selected_byte_offset, %32 : index
  %34 = buffer.view %20[%33] : buffer -> view<1xi32>
  %35 = view.load<root_in_bounds|type_disjoint> %34[0] : view<1xi32> -> i32
  %36 = scalar.addi %35, %28 : i32
  view.store<root_in_bounds|type_disjoint> %36, %34[0] : i32, view<1xi32>
  %37 = buffer.restrict.end %20 : buffer
  func.return %37, %selected_byte_offset : buffer, index
}

// ====
// Kernel buffer bindings use the same source access contract as helpers. A
// void boundary has no reference result requiring an explicit scope end.
[[loom::kernel, loom::workgroup_size(1, 1, 1),
  loom::workgroup_count(1, 1, 1)]]
void restricted_kernel(const int* __restrict__ input, int* output) {
  output[0] = input[0];
}

// ----
kernel.def @restricted_kernel() {
  %2 = index.constant 1 : index
  %3 = index.constant 1 : index
  %4 = index.constant 1 : index
  %5 = index.constant 1 : index
  %6 = index.constant 1 : index
  %7 = index.constant 1 : index
  kernel.launch.config workgroups(%2, %3, %4) workgroup_size(%5, %6, %7) : index
} launch(%input: buffer, %output: buffer) {
  %input_byte_offset = index.constant 0 : index
  %output_byte_offset = index.constant 0 : index
  %10, %11 = buffer.restrict.begin %input peers %output : buffer, buffer
  %12 = scalar.constant 0 : i32
  %13 = index.cast %12 : i32 to index
  %14 = index.constant 4 : index
  %15 = index.mul %13, %14 : index
  %16 = index.add %input_byte_offset, %15 : index
  %17 = buffer.view %10[%16] : buffer -> view<1xi32>
  %18 = view.load<root_in_bounds|type_disjoint> %17[0] : view<1xi32> -> i32
  %19 = scalar.constant 0 : i32
  %20 = index.cast %19 : i32 to index
  %21 = index.constant 4 : index
  %22 = index.mul %20, %21 : index
  %23 = index.add %output_byte_offset, %22 : index
  %24 = buffer.view %11[%23] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %18, %24[0] : i32, view<1xi32>
  kernel.return
}

// ====
// Typed-view references participate in the same access domain as raw storage
// roots; restrict is not limited to the pointer representation.
#include <loomcxx/view.h>

using word_view = loom::type::view<loom::type::shape<4>, unsigned>;

static word_view update_view(word_view& __restrict__ target, word_view& peer) {
  unsigned value = loom::view::load(peer, 0);
  loom::view::store(value, target, 0);
  return target;
}

unsigned view_access(word_view target, word_view peer) {
  return loom::view::load(update_view(target, peer), 0);
}

// ----
func.def public @view_access(%target: view<4xi32>, %peer: view<4xi32>) -> (i32) {
  %3 = func.call @update_view(%target, %peer) : (view<4xi32>, view<4xi32>) -> (view<4xi32>)
  %4 = scalar.constant 0 : i32
  %5 = index.cast %4 : i32 to index
  %6 = view.load<type_disjoint> %3[%5] : view<4xi32> -> i32
  func.return %6 : i32
}

func.def @update_view(%target: view<4xi32>, %peer: view<4xi32>) -> (view<4xi32>) {
  %10, %11 = buffer.restrict.begin %target peers %peer : view<4xi32>, view<4xi32>
  %12 = scalar.constant 0 : i32
  %13 = index.cast %12 : i32 to index
  %value = view.load<type_disjoint> %11[%13] : view<4xi32> -> i32
  %15 = scalar.constant 0 : i32
  %16 = index.cast %15 : i32 to index
  view.store<type_disjoint> %value, %10[%16] : i32, view<4xi32>
  %17 = buffer.restrict.end %10 : view<4xi32>
  func.return %17 : view<4xi32>
}

// ====
// RUN: pass canonicalize,cse,dce
// Field/local qualifiers do not invent independent restrict domains. Copies,
// nested values, and lambda captures retain the same pointer root and origin.
struct View { double* __restrict__ data; long stride; };
double load(View view, long index) { return view.data[index * view.stride]; }
struct Nested { View views[2]; };
double copy_and_capture(double* input, long stride, long index) {
  View view{input, stride};
  View copy = view;
  Nested nested{{view, copy}};
  auto read = [nested, index]() { return nested.views[1].data[index * nested.views[1].stride]; };
  return read();
}
int local_pointer(int* input) {
  int* __restrict__ local = input;
  local[0] += 1;
  return input[0];
}
constexpr const unsigned* __restrict__ empty = nullptr;
bool global_pointer() { return empty == nullptr; }
// Restrict facts attached to a parameter survive field copies and returns.
int* return_field(int* __restrict__ input, int* peer) {
  struct Field { int* __restrict__ pointer; };
  Field value{input};
  value.pointer[0] += peer[0];
  return value.pointer;
}
// ----
func.def public @load(%view_data: buffer, %view_data_byte_offset: index, %view_stride: i64, %index: i64) -> (f64) {
  %5 = scalar.muli %index, %view_stride : i64
  %6 = index.cast %5 : i64 to index
  %7 = index.constant 8 : index
  %81 = index.madd %6, %7, %view_data_byte_offset : index
  %10 = buffer.view %view_data[%81] : buffer -> view<1xf64>
  %11 = view.load<root_in_bounds|type_disjoint> %10[0] : view<1xf64> -> f64
  func.return %11 : f64
}

func.def public @copy_and_capture(%input: buffer, %input_byte_offset: index, %stride: i64, %index: i64) -> (f64) {
  %17 = func.call readonly @operator_call_value(%input, %input_byte_offset, %stride, %index) : (buffer, index, i64, i64) -> (f64)
  func.return %17 : f64
}

func.def public @local_pointer(%input: buffer, %input_byte_offset: index) -> (i32) {
  %21 = scalar.constant 1 : i32
  %27 = buffer.view %input[%input_byte_offset] : buffer -> view<1xi32>
  %28 = view.load<root_in_bounds|type_disjoint> %27[0] : view<1xi32> -> i32
  %29 = scalar.addi %28, %21 : i32
  view.store<root_in_bounds|type_disjoint> %29, %27[0] : i32, view<1xi32>
  %36 = view.load<root_in_bounds|type_disjoint> %27[0] : view<1xi32> -> i32
  func.return %36 : i32
}

func.def public @global_pointer() -> (i1) {
  %82 = scalar.constant true : i1
  func.return %82 : i1
}

func.def public @return_field(%input: buffer, %input_byte_offset: index, %peer: buffer, %peer_byte_offset: index) -> (buffer, index) {
  %value_pointer, %50 = buffer.restrict.begin %input peers %peer : buffer, buffer
  %56 = buffer.view %50[%peer_byte_offset] : buffer -> view<1xi32>
  %57 = view.load<root_in_bounds|type_disjoint> %56[0] : view<1xi32> -> i32
  %63 = buffer.view %value_pointer[%input_byte_offset] : buffer -> view<1xi32>
  %64 = view.load<root_in_bounds|type_disjoint> %63[0] : view<1xi32> -> i32
  %65 = scalar.addi %64, %57 : i32
  view.store<root_in_bounds|type_disjoint> %65, %63[0] : i32, view<1xi32>
  %66 = buffer.restrict.end %value_pointer : buffer
  func.return %66, %input_byte_offset : buffer, index
}

func.def @operator_call_value(%this_nested_views_1_data: buffer, %this_nested_views_1_data_byte_offset: index, %this_nested_views_1_stride: i64, %this_index: i64) -> (f64) {
  %74 = scalar.muli %this_index, %this_nested_views_1_stride : i64
  %75 = index.cast %74 : i64 to index
  %76 = index.constant 8 : index
  %83 = index.madd %75, %76, %this_nested_views_1_data_byte_offset : index
  %79 = buffer.view %this_nested_views_1_data[%83] : buffer -> view<1xf64>
  %80 = view.load<root_in_bounds|type_disjoint> %79[0] : view<1xf64> -> f64
  func.return %80 : f64
}

// ====
// RUN: verify
// INPUT: cxx std=c23
// The same qualifier admission applies to C records and local pointer aliases.
struct View { const int* restrict data; unsigned stride; };
int load(struct View view, unsigned index) {
  const int* restrict local = view.data;
  return local[index * view.stride];
}
