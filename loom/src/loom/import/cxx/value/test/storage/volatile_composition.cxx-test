// ====
// RUN: pass canonicalize,cse,dce
// A loaded scalar becomes a qualified by-value parameter object; its
// initialization and two reads are observed before the kernel stores the result.
unsigned volatile_parameter(volatile unsigned value) {
  static_cast<void>(value);
  return value;
}

[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void volatile_scalar_parameter(const unsigned* input, unsigned* output) {
  output[0] = volatile_parameter(input[0]);
}
// ----
func.def public @volatile_parameter(%value$0: i32) -> (i32) {
  %2 = index.constant 4 : offset
  %value_storage = buffer.alloca<private> align(4) %2 : buffer
  %value_storage_byte_offset = index.constant 0 : offset
  %value_view = buffer.view %value_storage[%value_storage_byte_offset] : buffer -> view<1xi32>
  view.store<volatile> %value$0, %value_view[0] : i32, view<1xi32>
  %value$6 = view.load<volatile> %value_view[0] : view<1xi32> -> i32
  %value$7 = view.load<volatile> %value_view[0] : view<1xi32> -> i32
  func.return %value$7 : i32
}

kernel.def @volatile_scalar_parameter() {
  %10 = index.constant 1 : index
  kernel.launch.config workgroups(%10, %10, %10) workgroup_size(%10, %10, %10) : index
} launch(%input: buffer, %output: buffer) {
  %39 = index.constant 0 : offset
  %26 = buffer.view %input[%39] : buffer -> view<1xi32>
  %27 = view.load %26[0] : view<1xi32> -> i32
  %28 = func.call @volatile_parameter(%27) : (i32) -> (i32)
  %37 = buffer.view %output[%39] : buffer -> view<1xi32>
  view.store %28, %37[0] : i32, view<1xi32>
  kernel.return
}

// ====
// RUN: pass canonicalize,cse,dce
// Reinterpreting word buffers as vectors preserves four lanes through
// a volatile by-value helper parameter and the final kernel store.
using Words = unsigned __attribute__((vector_size(16)));

static Words volatile_vector_parameter(volatile Words value) {
  static_cast<void>(value);
  return value;
}

[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void volatile_vector_parameter_kernel(const unsigned* input_words,
                                      unsigned* output_words) {
  const Words* input = reinterpret_cast<const Words*>(input_words);
  Words* output = reinterpret_cast<Words*>(output_words);
  output[0] = volatile_vector_parameter(input[0]);
}
// ----
kernel.def @volatile_vector_parameter_kernel() {
  %2 = index.constant 1 : index
  kernel.launch.config workgroups(%2, %2, %2) workgroup_size(%2, %2, %2) : index
} launch(%input_words: buffer, %output_words: buffer) {
  %39 = index.constant 0 : offset
  %18 = buffer.view %input_words[%39] : buffer -> view<4xi32>
  %19 = vector.load %18[0] : view<4xi32> -> vector<4xi32>
  %20 = func.call @volatile_vector_parameter(%19) : (vector<4xi32>) -> (vector<4xi32>)
  %29 = buffer.view %output_words[%39] : buffer -> view<4xi32>
  vector.store %20, %29[0] : vector<4xi32>, view<4xi32>
  kernel.return
}

func.def @volatile_vector_parameter(%value$30: vector<4xi32>) -> (vector<4xi32>) {
  %32 = index.constant 16 : offset
  %value_storage = buffer.alloca<private> align(16) %32 : buffer
  %value_storage_byte_offset = index.constant 0 : offset
  %value_view = buffer.view %value_storage[%value_storage_byte_offset] : buffer -> view<4xi32>
  vector.store<volatile> %value$30, %value_view[0] : vector<4xi32>, view<4xi32>
  %value$36 = vector.load<volatile> %value_view[0] : view<4xi32> -> vector<4xi32>
  %value$37 = vector.load<volatile> %value_view[0] : view<4xi32> -> vector<4xi32>
  func.return %value$37 : vector<4xi32>
}

// ====
// RUN: pass canonicalize,cse,dce
// Whole-vector observations retain the discarded load and zero store
// before publishing the independently loaded four-lane value.
using Words = unsigned __attribute__((vector_size(16)));
[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void volatile_vectors(const volatile unsigned* input_words,
                      volatile unsigned* output_words) {
  const volatile Words* input =
      reinterpret_cast<const volatile Words*>(input_words);
  volatile Words* output = reinterpret_cast<volatile Words*>(output_words);
  static_cast<void>(*input);
  Words value = input[0];
  output[0] = Words{0, 0, 0, 0};
  output[0] = value;
}
// ----
kernel.def @volatile_vectors() {
  %2 = index.constant 1 : index
  kernel.launch.config workgroups(%2, %2, %2) workgroup_size(%2, %2, %2) : index
} launch(%input_words: buffer, %output_words: buffer) {
  %input_words_byte_offset = index.constant 0 : offset
  %10 = buffer.view %input_words[%input_words_byte_offset] : buffer -> view<4xi32>
  %11 = vector.load<volatile> %10[0] : view<4xi32> -> vector<4xi32>
  %value = vector.load<volatile> %10[0] : view<4xi32> -> vector<4xi32>
  %43 = vector.splati 0 : vector<4xi32>
  %31 = buffer.view %output_words[%input_words_byte_offset] : buffer -> view<4xi32>
  vector.store<volatile> %43, %31[0] : vector<4xi32>, view<4xi32>
  vector.store<volatile> %value, %31[0] : vector<4xi32>, view<4xi32>
  kernel.return
}

// ====
// RUN: pass canonicalize,cse,dce
// Each workitem owns one volatile shared element. Its discarded read,
// update read, and final read remain distinct without cross-lane barriers.
#include <loomcxx/kernel.h>
[[loom::kernel, loom::workgroup_size(64, 1, 1), loom::workgroup_count(1, 1, 1)]]
void volatile_shared(const unsigned* input, unsigned* output) {
  [[loom::workgroup]] volatile unsigned table[64];
  unsigned lane = loom::kernel::workitem::id.x;
  // Each invocation owns its element, so no cross-invocation ordering is
  // needed.
  table[lane] = input[lane];
  table[lane];
  unsigned first = table[lane];
  table[lane] = first + 1u;
  output[lane] = table[lane];
}
// ----
kernel.def @volatile_shared() {
  %2 = index.constant 1 : index
  %5 = index.constant 64 : index
  kernel.launch.config workgroups(%2, %2, %2) workgroup_size(%5, %2, %2) : index
} launch(%input: buffer, %output: buffer) {
  %10 = index.constant 256 : offset
  %table = buffer.alloca<workgroup> align(4) %10 : buffer
  %table_byte_offset = index.constant 0 : offset
  %table_view = buffer.view %table[%table_byte_offset] : buffer -> view<64xi32>
  %workitem_id_x = kernel.workitem.id<x> : index
  %lane = index.cast %workitem_id_x : index to i32
  %60 = scalar.constant 2 : i32
  %61 = scalar.shli %lane, %60 : i32
  %62 = scalar.extui %61 : i32 to i64
  %21 = scalar.assume %62 [range(%62, 0, 9223372036854775807)] : i64
  %22 = index.cast %21 : i64 to offset
  %23 = buffer.view %input[%22] : buffer -> view<1xi32>
  %24 = view.load %23[0] : view<1xi32> -> i32
  %25 = scalar.extui %lane : i32 to i64
  %26 = scalar.assume %25 [range(%25, 0, 63)] : i64
  %27 = index.cast %26 : i64 to index
  view.store<volatile> %24, %table_view[%27] : i32, view<64xi32>
  %31 = view.load<volatile> %table_view[%27] : view<64xi32> -> i32
  %first = view.load<volatile> %table_view[%27] : view<64xi32> -> i32
  %36 = scalar.constant 1 : i32
  %37 = scalar.addi %first, %36 : i32
  view.store<volatile> %37, %table_view[%27] : i32, view<64xi32>
  %44 = view.load<volatile> %table_view[%27] : view<64xi32> -> i32
  %52 = buffer.view %output[%22] : buffer -> view<1xi32>
  view.store %44, %52[0] : i32, view<1xi32>
  kernel.return
}
