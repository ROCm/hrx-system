    %25 = scalar.addi %24, %135 : i64
    %26 = scalar.assume %25 [range(%25, 0, 9223372036854775807)] : i64
    %27 = index.cast %26 : i64 to offset
    %31 = index.cast %output_byte_offset : offset to i64
    %32 = scalar.addi %31, %135 : i64
    %33 = scalar.assume %32 [range(%32, 0, 9223372036854775807)] : i64
    %34 = index.cast %33 : i64 to offset
    %observed = func.call @observe_one_const_volatile_unsigned_int_volatile_unsigned_int(%input, %27, %output, %34) : (buffer, offset, buffer, offset) -> (i32)
    %36 = scalar.constant -1515890086 : i32
    %37 = scalar.xori %observed, %36 : i32
