  %3 = index.constant 1 : index
  %6 = index.constant 64 : index
  kernel.launch.config workgroups(%3, %3, %3) workgroup_size(%6, %3, %3) : index
} launch(%input: buffer, %output: buffer, %count: i32) {
  %input_byte_offset = index.constant 0 : offset
  %workitem_id_x = kernel.workitem.id<x> : index
  %12 = index.cast %workitem_id_x : index to i32
  func.call @copy_observations_const_unsigned_int_unsigned_int(%input, %input_byte_offset, %output, %input_byte_offset, %count, %12) : (buffer, offset, buffer, offset, i32, i32)
  kernel.return
}

