// RUN: pass canonicalize,cse,dce
// Pointer-member qualification propagates through template helper calls.
// Four input observations precede two output stores and an independent reload.
template <class T>
struct Source {
  // Borrowed storage; the pointee qualifier determines each observation.
  T* data;
};

template <class T>
static unsigned read_twice(Source<T> source) {
  source.data[0];
  static_cast<void>(*source.data);
  unsigned first = source.data[0];
  unsigned second = source.data[0];
  return first + second;
}

template <class Input, class Output>
static unsigned observe_one(Input* input, Output* output) {
  unsigned value = read_twice(Source<Input>{input});
  output[0] = 0;
  output[0] = value;
  return output[0];
}

unsigned volatile_word(const volatile unsigned* input,
                       volatile unsigned* output) {
  return observe_one(input, output);
}
// ----
func.def public @volatile_word(%input: buffer, %input_byte_offset: index, %output: buffer, %output_byte_offset: index) -> (i32) {
  %5 = func.call @observe_one_const_volatile_unsigned_int_volatile_unsigned_int(%input, %input_byte_offset, %output, %output_byte_offset) : (buffer, index, buffer, index) -> (i32)
  func.return %5 : i32
}

func.def @observe_one_const_volatile_unsigned_int_volatile_unsigned_int(%input: buffer, %input_byte_offset: index, %output: buffer, %output_byte_offset: index) -> (i32) {
  %value = func.call @read_twice_const_volatile_unsigned_int(%input, %input_byte_offset) : (buffer, index) -> (i32)
  %12 = scalar.constant 0 : i32
  %18 = buffer.view %output[%output_byte_offset] : buffer -> view<1xi32>
  view.store<volatile|root_in_bounds|type_disjoint> %12, %18[0] : i32, view<1xi32>
  view.store<volatile|root_in_bounds|type_disjoint> %value, %18[0] : i32, view<1xi32>
  %31 = view.load<volatile|root_in_bounds|type_disjoint> %18[0] : view<1xi32> -> i32
  func.return %31 : i32
}

func.def @read_twice_const_volatile_unsigned_int(%source_data: buffer, %source_data_byte_offset: index) -> (i32) {
  %40 = buffer.view %source_data[%source_data_byte_offset] : buffer -> view<1xi32>
  %41 = view.load<volatile|root_in_bounds|type_disjoint> %40[0] : view<1xi32> -> i32
  %43 = view.load<volatile|root_in_bounds|type_disjoint> %40[0] : view<1xi32> -> i32
  %first = view.load<volatile|root_in_bounds|type_disjoint> %40[0] : view<1xi32> -> i32
  %second = view.load<volatile|root_in_bounds|type_disjoint> %40[0] : view<1xi32> -> i32
  %58 = scalar.addi %first, %second : i32
  func.return %58 : i32
}

// ====
// RUN: pass canonicalize,cse,dce
// Predicated per-lane copying preserves the volatile specialization and
// two separate output ranges, including a final observed-value transform.
#include <loomcxx/kernel.h>
template <class T>
struct Source {
  // Borrowed storage; the pointee qualifier determines each observation.
  T* data;
};

template <class T>
static unsigned read_twice(Source<T> source) {
  source.data[0];
  static_cast<void>(*source.data);
  unsigned first = source.data[0];
  unsigned second = source.data[0];
  return first + second;
}

template <class Input, class Output>
static unsigned observe_one(Input* input, Output* output) {
  unsigned value = read_twice(Source<Input>{input});
  output[0] = 0;
  output[0] = value;
  return output[0];
}

template <class Input, class Output>
static void copy_observations(Input* input, Output* output, unsigned count,
                              unsigned lane) {
  loom::assume(count < 65);
  if (lane < count) {
    unsigned observed = observe_one(input + lane, output + lane);
    output[64 + lane] = observed ^ 0xa5a55a5au;
  }
}

[[loom::kernel, loom::workgroup_size(64, 1, 1), loom::workgroup_count(1, 1, 1)]]
void volatile_memory(const volatile unsigned* input, volatile unsigned* output,
                     unsigned count) {
  copy_observations(input, output, count, loom::kernel::workitem::id.x);
}
// ----
kernel.def @volatile_memory() {
  %3 = index.constant 1 : index
  %6 = index.constant 64 : index
  kernel.launch.config workgroups(%3, %3, %3) workgroup_size(%6, %3, %3) : index
} launch(%input: buffer, %output: buffer, %count: i32) {
  %input_byte_offset = index.constant 0 : index
  %workitem_id_x = kernel.workitem.id<x> : index
  %12 = index.cast %workitem_id_x : index to i32
  func.call @copy_observations_const_volatile_unsigned_int_volatile_unsigned_int(%input, %input_byte_offset, %output, %input_byte_offset, %count, %12) : (buffer, index, buffer, index, i32, i32)
  kernel.return
}

func.def @copy_observations_const_volatile_unsigned_int_volatile_unsigned_int(%input: buffer, %input_byte_offset: index, %output: buffer, %output_byte_offset: index, %count$17: i32, %lane: i32) {
  %count$19 = scalar.assume %count$17 [range(%count$17, 0, 64)] : i32
  %20 = scalar.cmpi ult, %lane, %count$19 : i32
  scf.if %20 {
    %95 = scalar.assume %lane [ge(%lane, 0), lt(%lane, %count$19)] : i32
    %21 = scalar.extui %95 : i32 to i64
    %96 = scalar.assume %21 [lt(%21, %count$19)] : i64
    %22 = index.cast %96 : i64 to index
    %97 = index.assume %22 [lt(%22, %count$19)] : index
    %23 = index.constant 4 : index
    %103 = index.madd %97, %23, %input_byte_offset : index
    %102 = index.madd %97, %23, %output_byte_offset : index
    %observed = func.call @observe_one_const_volatile_unsigned_int_volatile_unsigned_int(%input, %103, %output, %102) : (buffer, index, buffer, index) -> (i32)
    %32 = scalar.constant -1515890086 : i32
    %33 = scalar.xori %observed, %32 : i32
    %34 = scalar.constant 64 : i32
    %101 = scalar.addi %95, %34 : i32
    %36 = scalar.extui %101 : i32 to i64
    %37 = index.cast %36 : i64 to index
    %100 = index.madd %37, %23, %output_byte_offset : index
    %41 = buffer.view %output[%100] : buffer -> view<1xi32>
    view.store<volatile|root_in_bounds|type_disjoint> %33, %41[0] : i32, view<1xi32>
  }
  func.return
}

func.def @observe_one_const_volatile_unsigned_int_volatile_unsigned_int(%input: buffer, %input_byte_offset: index, %output: buffer, %output_byte_offset: index) -> (i32) {
  %value = func.call @read_twice_const_volatile_unsigned_int(%input, %input_byte_offset) : (buffer, index) -> (i32)
  %48 = scalar.constant 0 : i32
  %54 = buffer.view %output[%output_byte_offset] : buffer -> view<1xi32>
  view.store<volatile|root_in_bounds|type_disjoint> %48, %54[0] : i32, view<1xi32>
  view.store<volatile|root_in_bounds|type_disjoint> %value, %54[0] : i32, view<1xi32>
  %67 = view.load<volatile|root_in_bounds|type_disjoint> %54[0] : view<1xi32> -> i32
