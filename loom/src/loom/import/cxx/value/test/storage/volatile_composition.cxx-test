  %count$19 = scalar.assume %count$17 [range(%count$17, 0, 64)] : i32
  %20 = scalar.cmpi ult, %lane, %count$19 : i32
  scf.if %20 {
    %119 = scalar.assume %lane [ge(%lane, 0), lt(%lane, %count$19)] : i32
    %133 = scalar.constant 2 : i32
