// RUN: pass canonicalize,cse,dce
// Pointer-member qualification propagates through template helper calls.
// Four input observations precede two output stores and an independent reload.
template <class T>
struct Source {
  // Borrowed storage; the pointee qualifier determines each observation.
  T* data;
};

template <class T>
static unsigned read_twice(Source<T> source) {
  source.data[0];
  static_cast<void>(*source.data);
  unsigned first = source.data[0];
  unsigned second = source.data[0];
  return first + second;
}

template <class Input, class Output>
static unsigned observe_one(Input* input, Output* output) {
  unsigned value = read_twice(Source<Input>{input});
  output[0] = 0;
  output[0] = value;
  return output[0];
}

unsigned volatile_word(const volatile unsigned* input,
                       volatile unsigned* output) {
  return observe_one(input, output);
}
// ----
func.def public @volatile_word(%input: buffer, %input_byte_offset: offset, %output: buffer, %output_byte_offset: offset) -> (i32) {
  %5 = func.call @observe_one_const_volatile_unsigned_int_volatile_unsigned_int(%input, %input_byte_offset, %output, %output_byte_offset) : (buffer, offset, buffer, offset) -> (i32)
  func.return %5 : i32
}

func.def @observe_one_const_volatile_unsigned_int_volatile_unsigned_int(%input: buffer, %input_byte_offset: offset, %output: buffer, %output_byte_offset: offset) -> (i32) {
  %value = func.call @read_twice_const_volatile_unsigned_int(%input, %input_byte_offset) : (buffer, offset) -> (i32)
  %12 = scalar.constant 0 : i32
  %17 = index.cast %output_byte_offset : offset to i64
  %19 = scalar.assume %17 [range(%17, 0, 9223372036854775807)] : i64
  %20 = index.cast %19 : i64 to offset
  %21 = buffer.view %output[%20] : buffer -> view<1xi32>
  view.store<volatile> %12, %21[0] : i32, view<1xi32>
  view.store<volatile> %value, %21[0] : i32, view<1xi32>
  %40 = view.load<volatile> %21[0] : view<1xi32> -> i32
  func.return %40 : i32
}

func.def @read_twice_const_volatile_unsigned_int(%source_data: buffer, %source_data_byte_offset: offset) -> (i32) {
  %48 = index.cast %source_data_byte_offset : offset to i64
  %50 = scalar.assume %48 [range(%48, 0, 9223372036854775807)] : i64
  %51 = index.cast %50 : i64 to offset
  %52 = buffer.view %source_data[%51] : buffer -> view<1xi32>
  %53 = view.load<volatile> %52[0] : view<1xi32> -> i32
  %54 = buffer.view %source_data[%source_data_byte_offset] : buffer -> view<1xi32>
  %55 = view.load<volatile> %54[0] : view<1xi32> -> i32
  %first = view.load<volatile> %52[0] : view<1xi32> -> i32
  %second = view.load<volatile> %52[0] : view<1xi32> -> i32
  %76 = scalar.addi %first, %second : i32
  func.return %76 : i32
}

// ====
// RUN: pass canonicalize,cse,dce
// Predicated per-lane copying preserves the volatile specialization and
// two separate output ranges, including a final observed-value transform.
#include <loomcxx/kernel.h>
template <class T>
struct Source {
  // Borrowed storage; the pointee qualifier determines each observation.
  T* data;
};

template <class T>
static unsigned read_twice(Source<T> source) {
  source.data[0];
  static_cast<void>(*source.data);
  unsigned first = source.data[0];
  unsigned second = source.data[0];
  return first + second;
}

template <class Input, class Output>
static unsigned observe_one(Input* input, Output* output) {
  unsigned value = read_twice(Source<Input>{input});
  output[0] = 0;
  output[0] = value;
  return output[0];
}

template <class Input, class Output>
static void copy_observations(Input* input, Output* output, unsigned count,
                              unsigned lane) {
  loom::assume(count < 65);
  if (lane < count) {
    unsigned observed = observe_one(input + lane, output + lane);
    output[64 + lane] = observed ^ 0xa5a55a5au;
  }
}

[[loom::kernel, loom::workgroup_size(64, 1, 1), loom::workgroup_count(1, 1, 1)]]
void volatile_memory(const volatile unsigned* input, volatile unsigned* output,
                     unsigned count) {
  copy_observations(input, output, count, loom::kernel::workitem::id.x);
}
// ----
kernel.def @volatile_memory() {
  %3 = index.constant 1 : index
  %6 = index.constant 64 : index
  kernel.launch.config workgroups(%3, %3, %3) workgroup_size(%6, %3, %3) : index
} launch(%input: buffer, %output: buffer, %count: i32) {
  %input_byte_offset = index.constant 0 : offset
  %workitem_id_x = kernel.workitem.id<x> : index
  %12 = index.cast %workitem_id_x : index to i32
  func.call @copy_observations_const_volatile_unsigned_int_volatile_unsigned_int(%input, %input_byte_offset, %output, %input_byte_offset, %count, %12) : (buffer, offset, buffer, offset, i32, i32)
  kernel.return
}

