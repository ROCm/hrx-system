// RUN: pass inline-callables,canonicalize,cse,dce

// The source object footprint selects element units; sign survives scaling.
// Independent incoming roots retain their proof obligation in High IR.
using Float3 = float __attribute__((ext_vector_type(3)));
struct Triple { int x, y, z; };
using Row = short[3];
auto bytes(const char* first, const char* last) { return last - first; }
auto words(const int* first, const int* last) { return first - last; }
auto records(const Triple* first, const Triple* last) { return last - first; }
auto vectors(const Float3* first, const Float3* last) { return last - first; }
auto rows(const Row* first, const Row* last) { return last - first; }

// ----
func.def public @bytes(%first: buffer, %first_byte_offset: index, %last: buffer, %last_byte_offset: index) -> (i64) {
  %5 = buffer.distance %last[%last_byte_offset], %first[%first_byte_offset] : i64
  func.return %5 : i64
}

func.def public @words(%first: buffer, %first_byte_offset: index, %last: buffer, %last_byte_offset: index) -> (i64) {
  %11 = buffer.distance %first[%first_byte_offset], %last[%last_byte_offset] : i64
  %12 = scalar.constant 4 : i64
  %13 = scalar.divsi %11, %12 : i64
  func.return %13 : i64
}

func.def public @records(%first: buffer, %first_byte_offset: index, %last: buffer, %last_byte_offset: index) -> (i64) {
  %19 = buffer.distance %last[%last_byte_offset], %first[%first_byte_offset] : i64
  %20 = scalar.constant 12 : i64
  %21 = scalar.divsi %19, %20 : i64
  func.return %21 : i64
}

func.def public @vectors(%first: buffer, %first_byte_offset: index, %last: buffer, %last_byte_offset: index) -> (i64) {
  %27 = buffer.distance %last[%last_byte_offset], %first[%first_byte_offset] : i64
  %28 = scalar.constant 16 : i64
  %29 = scalar.divsi %27, %28 : i64
  func.return %29 : i64
}

func.def public @rows(%first: buffer, %first_byte_offset: index, %last: buffer, %last_byte_offset: index) -> (i64) {
  %35 = buffer.distance %last[%last_byte_offset], %first[%first_byte_offset] : i64
  %36 = scalar.constant 6 : i64
  %37 = scalar.divsi %35, %36 : i64
  func.return %37 : i64
}

// ====

#include <initializer_list>
static auto distance(const int* first, const int* last) { return last - first; }
long forward(int value) {
  std::initializer_list<int> values{value, value + 1, value + 2};
  return distance(values.begin(), values.end());
}
long reverse(int value) {
  std::initializer_list<int> values{value, value + 1, value + 2};
  return distance(values.end(), values.begin());
}
long empty() {
  const int* first = nullptr;
  const int* last = nullptr;
  return last - first;
}

// ----
func.def public @forward(%value: i32) -> (i64) {
  %2 = index.constant 12 : offset
  %values_begin_ = buffer.alloca<private> align(4) %2 : buffer
  %94 = index.constant 0 : index
  %7 = buffer.view %values_begin_[%94] : buffer -> view<1xi32>
  view.store<type_disjoint> %value, %7[0] : i32, view<1xi32>
  %10 = scalar.constant 1 : i32
  %11 = scalar.addi %value, %10 : i32
  %93 = index.constant 4 : index
  %13 = buffer.view %values_begin_[%93] : buffer -> view<1xi32>
  view.store<type_disjoint> %11, %13[0] : i32, view<1xi32>
  %16 = scalar.constant 2 : i32
  %17 = scalar.addi %value, %16 : i32
  %92 = index.constant 8 : index
  %19 = buffer.view %values_begin_[%92] : buffer -> view<1xi32>
  view.store<type_disjoint> %17, %19[0] : i32, view<1xi32>
  %91 = scalar.constant 3 : i64
  func.return %91 : i64
}

func.def public @reverse(%value: i32) -> (i64) {
  %28 = index.constant 12 : offset
  %values_begin_ = buffer.alloca<private> align(4) %28 : buffer
  %101 = index.constant 0 : index
  %33 = buffer.view %values_begin_[%101] : buffer -> view<1xi32>
  view.store<type_disjoint> %value, %33[0] : i32, view<1xi32>
  %36 = scalar.constant 1 : i32
  %37 = scalar.addi %value, %36 : i32
  %100 = index.constant 4 : index
  %39 = buffer.view %values_begin_[%100] : buffer -> view<1xi32>
  view.store<type_disjoint> %37, %39[0] : i32, view<1xi32>
  %42 = scalar.constant 2 : i32
  %43 = scalar.addi %value, %42 : i32
  %99 = index.constant 8 : index
  %45 = buffer.view %values_begin_[%99] : buffer -> view<1xi32>
  view.store<type_disjoint> %43, %45[0] : i32, view<1xi32>
  %98 = scalar.constant -3 : i64
  func.return %98 : i64
}

func.def public @empty() -> (i64) {
  %105 = scalar.constant 0 : i64
  func.return %105 : i64
}

// ====

// Member arrays, nested helpers, and branch-selected positions keep one root.
struct Block { long tag; int values[8]; };
static const int* advance(const int* pointer, int count) { return pointer + count; }
auto selected(const Block* block, int start, int count, bool reverse) {
  const int* begin = advance(block->values, start);
  const int* end = advance(begin, count);
  const int* selected = reverse ? begin : end;
  return selected - begin;
}
auto walked(const int* begin, unsigned count) {
  const int* cursor = begin;
  for (unsigned i = 0; i < count; ++i) ++cursor;
  return cursor - begin;
}

// ----
func.def public @selected(%block: buffer, %block_byte_offset: index, %start: i32, %count: i32, %reverse: i1) -> (i64) {
  %6 = index.constant 8 : index
  %values_byte_offset = index.add %block_byte_offset, %6 : index
  %48 = index.cast %start : i32 to index
  %49 = index.constant 4 : index
  %begin_byte_offset = index.madd %48, %49, %values_byte_offset : index
  %44 = index.cast %count : i32 to index
  %end_byte_offset = index.madd %44, %49, %begin_byte_offset : index
  %selected_byte_offset = scf.select %reverse, %begin_byte_offset, %end_byte_offset : index
  %52 = index.cast %selected_byte_offset : index to i64
  %53 = index.cast %begin_byte_offset : index to i64
  %54 = scalar.subi %52, %53 : i64
  %15 = scalar.constant 4 : i64
  %16 = scalar.divsi %54, %15 : i64
  func.return %16 : i64
}

func.def public @walked(%begin: buffer, %begin_byte_offset: index, %count: i32) -> (i64) {
  %60 = index.constant 0 : offset
  %23 = index.cast %count : i32 to offset
  %24 = index.constant 1 : offset
  %cursor_byte_offset = scf.for %i = [%60 to %23 step %24](%cursor_byte_offset$65 = %begin_byte_offset : index) -> (index) {
    %59 = index.constant 4 : index
    %cursor_byte_offset$35 = index.add %cursor_byte_offset$65, %59 : index
    scf.yield %cursor_byte_offset$35 : index
  }
  %61 = index.cast %cursor_byte_offset : index to i64
  %62 = index.cast %begin_byte_offset : index to i64
  %63 = scalar.subi %61, %62 : i64
  %37 = scalar.constant 4 : i64
  %38 = scalar.divsi %63, %37 : i64
  func.return %38 : i64
}

// ====
// INPUT: cxx data-model=lp64
auto source_layout(const long* first, const long* last) { return last - first; }

// ----
func.def public @source_layout(%first: buffer, %first_byte_offset: index, %last: buffer, %last_byte_offset: index) -> (i64) {
  %5 = buffer.distance %last[%last_byte_offset], %first[%first_byte_offset] : i64
  %6 = scalar.constant 8 : i64
  %7 = scalar.divsi %5, %6 : i64
  func.return %7 : i64
}

// ====
// INPUT: cxx data-model=llp64
auto source_layout(const long* first, const long* last) { return last - first; }

// ----
func.def public @source_layout(%first: buffer, %first_byte_offset: index, %last: buffer, %last_byte_offset: index) -> (i64) {
  %5 = buffer.distance %last[%last_byte_offset], %first[%first_byte_offset] : i64
  %6 = scalar.constant 4 : i64
  %7 = scalar.divsi %5, %6 : i64
  func.return %7 : i64
}

// ====
// INPUT: cxx data-model=ilp32
// Byte subtraction stays wide until after element division, even though the
// source pointer and ptrdiff_t are 32 bits.
auto source_layout(const long* first, const long* last) { return last - first; }

// ----
func.def public @source_layout(%first: buffer, %first_byte_offset: index, %last: buffer, %last_byte_offset: index) -> (i32) {
  %5 = buffer.distance %last[%last_byte_offset], %first[%first_byte_offset] : i64
  %6 = scalar.constant 4 : i64
  %7 = scalar.divsi %5, %6 : i64
  %8 = scalar.trunci %7 : i64 to i32
  func.return %8 : i32
}
