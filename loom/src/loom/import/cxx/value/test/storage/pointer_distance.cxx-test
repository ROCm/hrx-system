// RUN: pass inline-callables,canonicalize,cse,dce

// The source object footprint selects element units; sign survives scaling.
// Independent incoming roots retain their proof obligation in High IR.
using Float3 = float __attribute__((ext_vector_type(3)));
struct Triple { int x, y, z; };
using Row = short[3];
auto bytes(const char* first, const char* last) { return last - first; }
auto words(const int* first, const int* last) { return first - last; }
auto records(const Triple* first, const Triple* last) { return last - first; }
auto vectors(const Float3* first, const Float3* last) { return last - first; }
auto rows(const Row* first, const Row* last) { return last - first; }

// ----
func.def public @bytes(%first: buffer, %first_byte_offset: offset, %last: buffer, %last_byte_offset: offset) -> (i64) {
  %5 = buffer.distance %last[%last_byte_offset], %first[%first_byte_offset] : i64
  func.return %5 : i64
}

func.def public @words(%first: buffer, %first_byte_offset: offset, %last: buffer, %last_byte_offset: offset) -> (i64) {
  %11 = buffer.distance %first[%first_byte_offset], %last[%last_byte_offset] : i64
  %12 = scalar.constant 4 : i64
  %13 = scalar.divsi %11, %12 : i64
  func.return %13 : i64
}

func.def public @records(%first: buffer, %first_byte_offset: offset, %last: buffer, %last_byte_offset: offset) -> (i64) {
  %19 = buffer.distance %last[%last_byte_offset], %first[%first_byte_offset] : i64
  %20 = scalar.constant 12 : i64
  %21 = scalar.divsi %19, %20 : i64
  func.return %21 : i64
}

func.def public @vectors(%first: buffer, %first_byte_offset: offset, %last: buffer, %last_byte_offset: offset) -> (i64) {
  %27 = buffer.distance %last[%last_byte_offset], %first[%first_byte_offset] : i64
  %28 = scalar.constant 16 : i64
  %29 = scalar.divsi %27, %28 : i64
  func.return %29 : i64
}

func.def public @rows(%first: buffer, %first_byte_offset: offset, %last: buffer, %last_byte_offset: offset) -> (i64) {
  %35 = buffer.distance %last[%last_byte_offset], %first[%first_byte_offset] : i64
  %36 = scalar.constant 6 : i64
  %37 = scalar.divsi %35, %36 : i64
  func.return %37 : i64
}

// ====

#include <initializer_list>
static auto distance(const int* first, const int* last) { return last - first; }
long forward(int value) {
  std::initializer_list<int> values{value, value + 1, value + 2};
  return distance(values.begin(), values.end());
}
long reverse(int value) {
  std::initializer_list<int> values{value, value + 1, value + 2};
  return distance(values.end(), values.begin());
}
long empty() {
  const int* first = nullptr;
  const int* last = nullptr;
  return last - first;
}

// ----
