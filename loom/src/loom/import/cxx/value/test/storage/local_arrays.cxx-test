// RUN: pass inline-callables,canonicalize,cse,promote-private-fragments,canonicalize,cse,dce
// One allocation joins direct indexing and an interior helper alias. Shared
// promotion carries the changed element through the branch in registers.
[[loom::inline]] static void update(unsigned* value, unsigned enabled) {
  if (enabled) *value += 4;
}
unsigned guarded(unsigned input, unsigned enabled) {
  unsigned values[3] = {37, input, 41};
  update(values + 1, enabled);
  return values[0] + values[1] + values[2];
}
// ----
func.def public @guarded(%input: i32, %enabled: i32) -> (i32) {
  %40 = scalar.constant 0 : i32
  %41 = scalar.cmpi ne, %enabled, %40 : i32
  %42 = scalar.constant 4 : i32
  %45 = scalar.addi %input, %42 : i32
  %53 = scf.select %41, %45, %input : i32
  %51 = scalar.constant 78 : i32
  %52 = scalar.addi %53, %51 : i32
  func.return %52 : i32
}

// ====
// RUN: roundtrip
// Source layout owns the byte footprint and explicit allocation alignment.
// An uninitialized declaration emits no stores before the output-only helper.
static void fill(unsigned short* values) { values[1] = 7; }
unsigned initialized_by_helper() {
  alignas(32) unsigned short values[3];
  fill(values);
  return values[1];
}
// ----
func.def public @initialized_by_helper() -> (i32) {
  %1 = index.constant 6 : offset
  %values_storage = buffer.alloca<private> align(32) %1 : buffer
  %values_storage_byte_offset = index.constant 0 : offset
  %values_view = buffer.view %values_storage[%values_storage_byte_offset] : buffer -> view<3xi16>
  func.call @fill(%values_storage, %values_storage_byte_offset) : (buffer, offset)
  %5 = scalar.constant 1 : i32
  %6 = scalar.extsi %5 : i32 to i64
  %7 = scalar.assume %6 [range(%6, 0, 2)] : i64
  %8 = index.cast %7 : i64 to index
  %9 = view.load %values_view[%8] : view<3xi16> -> i16
  %10 = scalar.extui %9 : i16 to i32
  func.return %10 : i32
}

func.def @fill(%values: buffer, %values_byte_offset: offset) {
  %13 = scalar.constant 7 : i32
  %14 = scalar.trunci %13 : i32 to i16
  %15 = scalar.constant 1 : i32
  %16 = scalar.extsi %15 : i32 to i64
  %17 = scalar.constant 2 : i64
  %18 = scalar.muli %16, %17 : i64
  %19 = index.cast %values_byte_offset : offset to i64
  %20 = scalar.addi %19, %18 : i64
  %21 = scalar.assume %20 [range(%20, 0, 9223372036854775807)] : i64
  %22 = index.cast %21 : i64 to offset
  %23 = buffer.view %values[%22] : buffer -> view<1xi16>
  view.store %14, %23[0] : i16, view<1xi16>
  func.return
}

// ====
// RUN: pass canonicalize,cse,promote-private-fragments,dce
// Initialization and element accesses preserve volatile observation semantics.
unsigned observed(unsigned input) {
  volatile unsigned values[2] = {input};
  values[1] = values[0] + 1;
  return values[1];
}
// ----
func.def public @observed(%input: i32) -> (i32) {
  %2 = index.constant 8 : offset
  %values_storage = buffer.alloca<private> align(4) %2 : buffer
  %values_storage_byte_offset = index.constant 0 : offset
  %values_view = buffer.view %values_storage[%values_storage_byte_offset] : buffer -> view<2xi32>
  %6 = index.constant 0 : index
  view.store<volatile> %input, %values_view[%6] : i32, view<2xi32>
  %zero$i32 = scalar.constant 0 : i32
  %8 = index.constant 1 : index
  view.store<volatile> %zero$i32, %values_view[%8] : i32, view<2xi32>
  %13 = view.load<volatile> %values_view[%6] : view<2xi32> -> i32
  %14 = scalar.constant 1 : i32
  %15 = scalar.addi %13, %14 : i32
  view.store<volatile> %15, %values_view[%8] : i32, view<2xi32>
  %24 = view.load<volatile> %values_view[%8] : view<2xi32> -> i32
  func.return %24 : i32
}

// ====
// The helper changes only the selected middle element; both neighboring
// elements remain independent returned observations.
struct Observation {
  // Value produced through the borrowed element pointer.
  unsigned value;
  // Element preceding the helper's writable range.
  unsigned before;
  // Element following the helper's writable range.
  unsigned after;
};

[[loom::inline]] static void update(unsigned* value, unsigned enabled) {
  if (enabled) {
    *value += 4;
  }
}
Observation guarded(unsigned input, unsigned enabled) {
  unsigned values[3] = {37, input, 41};
  auto* element = values + 1;
  update(element, enabled);
  return {values[1], values[0], values[2]};
}
// ----
func.def public @guarded(%input: i32, %enabled: i32) -> (i32, i32, i32) {
  %9 = scalar.constant 37 : i32
  %12 = scalar.constant 41 : i32
  %40 = scalar.constant 0 : i32
  %41 = scalar.cmpi ne, %enabled, %40 : i32
  %42 = scalar.constant 4 : i32
  %45 = scalar.addi %input, %42 : i32
  %51 = scf.select %41, %45, %input : i32
  func.return %51, %9, %12 : i32, i32, i32
}

// ====
// Each initializer observes completed earlier elements and ordered side
// effects; the omitted final element is zero-initialized.
unsigned ordered() {
  unsigned next = 3;
  unsigned values[4] = {next++, next++, values[0] + values[1]};
  return values[0] + 10 * values[1] + 100 * values[2] + 1000 * values[3] +
         10000 * next;
}
// ----
func.def public @ordered() -> (i32) {
  %66 = scalar.constant 50743 : i32
  func.return %66 : i32
}

// ====
// Empty, deduced, parenthesized, converted, and nested-brace array
// initialization retain their explicit values and zero-filled tails.
unsigned value_initialized() {
  const unsigned empty[3]{};
  constexpr unsigned deduced[] = {3, 5};
  const unsigned parenthesized[3](7, 11);
  float converted[3] = {2, 3};
  unsigned short nested[2] = {{13}, {}};
  return empty[0] + empty[1] + empty[2] + deduced[0] + deduced[1] +
         parenthesized[0] + parenthesized[1] + parenthesized[2] +
         static_cast<unsigned>(converted[0] + converted[1] + converted[2]) +
         nested[0] + nested[1];
}
// ----
func.def public @value_initialized() -> (i32) {
  %146 = scalar.constant 44 : i32
  func.return %146 : i32
}

// ====
// The output helper initializes the array before dynamic indexing.
[[loom::inline]] static void fill(unsigned* values, unsigned count) {
  for (unsigned i = 0; i < count; ++i) {
    values[i] = i + 3;
  }
}
unsigned output_parameter(unsigned index) {
  unsigned values[4];
  fill(values, 4);
  return values[index];
}
// ----
func.def public @output_parameter(%index: i32) -> (i32) {
  %2 = index.constant 16 : offset
  %values_storage = buffer.alloca<private> align(4) %2 : buffer
  %values_storage_byte_offset = index.constant 0 : offset
  %values_view = buffer.view %values_storage[%values_storage_byte_offset] : buffer -> view<4xi32>
  %31 = index.constant 4 : offset
  %17 = index.constant 1 : offset
  scf.for %i = [%values_storage_byte_offset to %31 step %17] {
    %19 = index.cast %i : offset to i32
    %20 = scalar.constant 3 : i32
    %21 = scalar.addi %19, %20 : i32
    %22 = scalar.extui %19 : i32 to i64
    %33 = scalar.constant 2 : i64
    %34 = scalar.shli %22, %33 : i64
    %27 = scalar.assume %34 [range(%34, 0, 9223372036854775807)] : i64
    %28 = index.cast %27 : i64 to offset
    %29 = buffer.view %values_storage[%28] : buffer -> view<1xi32>
    view.store %21, %29[0] : i32, view<1xi32>
  }
  %7 = scalar.extui %index : i32 to i64
  %8 = scalar.assume %7 [range(%7, 0, 3)] : i64
  %9 = index.cast %8 : i64 to index
  %10 = view.load %values_view[%9] : view<4xi32> -> i32
  func.return %10 : i32
}

// ====
// Signed and wide unsigned subscripts retain their distinct source widths.
unsigned indexed(int first, unsigned long long second) {
  const unsigned values[4] = {3, 5, 7, 11};
  return 10 * values[first] + values[second];
}
// ----
func.def public @indexed(%first: i32, %second: i64) -> (i32) {
  %3 = index.constant 16 : offset
  %values_storage = buffer.alloca<private> align(4) %3 : buffer
  %values_storage_byte_offset = index.constant 0 : offset
  %values_view = buffer.view %values_storage[%values_storage_byte_offset] : buffer -> view<4xi32>
  %7 = scalar.constant 3 : i32
  %8 = index.constant 0 : index
  view.store %7, %values_view[%8] : i32, view<4xi32>
  %9 = scalar.constant 5 : i32
  %10 = index.constant 1 : index
  view.store %9, %values_view[%10] : i32, view<4xi32>
  %11 = scalar.constant 7 : i32
  %12 = index.constant 2 : index
  view.store %11, %values_view[%12] : i32, view<4xi32>
  %13 = scalar.constant 11 : i32
  %14 = index.constant 3 : index
  view.store %13, %values_view[%14] : i32, view<4xi32>
  %15 = scalar.constant 10 : i32
  %16 = scalar.extsi %first : i32 to i64
  %17 = scalar.assume %16 [range(%16, 0, 3)] : i64
  %18 = index.cast %17 : i64 to index
  %19 = view.load %values_view[%18] : view<4xi32> -> i32
  %20 = scalar.muli %15, %19 : i32
  %21 = scalar.assume %second [range(%second, 0, 3)] : i64
  %22 = index.cast %21 : i64 to index
  %23 = view.load %values_view[%22] : view<4xi32> -> i32
  %24 = scalar.addi %20, %23 : i32
  func.return %24 : i32
}

// ====
// A pointer to the whole array aliases its direct element projections.
unsigned whole_array() {
  unsigned values[3] = {3, 5, 7};
  auto* array = &values;
  (*array)[1] += 4;
  return values[0] + values[1] + values[2];
}
// ----
func.def public @whole_array() -> (i32) {
  %39 = scalar.constant 19 : i32
  func.return %39 : i32
}

// ====
// Loop-local arrays are initialized anew, including their omitted element,
// while continue skips the helper and the observation for that iteration.
[[loom::inline]] static void update(unsigned* value, unsigned enabled) {
  if (enabled) {
    *value += 4;
  }
}
unsigned repeated(unsigned count) {
  unsigned total = 0;
  for (unsigned i = 0; i < count; ++i) {
    unsigned values[2] = {i};
    if (i == 1) {
      continue;
    }
    update(&values[0], 1);
    total += values[0] + values[1];
  }
  return total;
}
// ----
func.def public @repeated(%count: i32) -> (i32) {
  %total$2 = scalar.constant 0 : i32
  %57 = index.constant 0 : offset
  %5 = index.cast %count : i32 to offset
  %6 = index.constant 1 : offset
  %total$9 = scf.for %i = [%57 to %5 step %6](%total$8 = %total$2 : i32) -> (i32) {
    %10 = index.cast %i : offset to i32
    %18 = scalar.constant 1 : i32
    %19 = scalar.cmpi eq, %10, %18 : i32
    %50 = scalar.constant 4 : i32
    %63 = scalar.addi %10, %total$8 : i32
    %64 = scalar.addi %63, %50 : i32
    %total$62 = scf.select %19, %total$8, %64 : i32
    scf.yield %total$62 : i32
  }
  func.return %total$9 : i32
}

// ====
// Volatile initialization includes the omitted zero elements, and every
// source observation remains an ordered memory access.
unsigned volatile_elements() {
  volatile unsigned values[3] = {7};
  values[1] = values[0] + 3;
  return values[0] + values[1] + values[2];
}
// ----
func.def public @volatile_elements() -> (i32) {
  %1 = index.constant 12 : offset
  %values_storage = buffer.alloca<private> align(4) %1 : buffer
  %values_storage_byte_offset = index.constant 0 : offset
  %values_view = buffer.view %values_storage[%values_storage_byte_offset] : buffer -> view<3xi32>
  %5 = scalar.constant 7 : i32
  %6 = index.constant 0 : index
  view.store<volatile> %5, %values_view[%6] : i32, view<3xi32>
  %zero$i32 = scalar.constant 0 : i32
  %8 = index.constant 1 : index
  view.store<volatile> %zero$i32, %values_view[%8] : i32, view<3xi32>
  %10 = index.constant 2 : index
  view.store<volatile> %zero$i32, %values_view[%10] : i32, view<3xi32>
  %15 = view.load<volatile> %values_view[%6] : view<3xi32> -> i32
  %16 = scalar.constant 3 : i32
  %17 = scalar.addi %15, %16 : i32
  view.store<volatile> %17, %values_view[%8] : i32, view<3xi32>
  %26 = view.load<volatile> %values_view[%6] : view<3xi32> -> i32
  %31 = view.load<volatile> %values_view[%8] : view<3xi32> -> i32
  %32 = scalar.addi %26, %31 : i32
  %37 = view.load<volatile> %values_view[%10] : view<3xi32> -> i32
  %38 = scalar.addi %32, %37 : i32
  func.return %38 : i32
}

// ====

// Computing coordinates into an unread automatic array cannot retain the
// loop, its input reads, or its division/remainder arithmetic.
void unused_coordinates(const int* lower, const int* length, unsigned long linear) {
  int coordinates[3];
  for (int dimension = 0; dimension < 3; ++dimension) {
    coordinates[dimension] = static_cast<int>(linear % static_cast<unsigned long>(length[dimension])) + lower[dimension];
    linear /= static_cast<unsigned long>(length[dimension]);
  }
}

// ----
func.def public @unused_coordinates(%lower: buffer, %lower_byte_offset: offset, %length: buffer, %length_byte_offset: offset, %linear: i64) {
  func.return
}
