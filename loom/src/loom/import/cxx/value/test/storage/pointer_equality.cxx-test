// RUN: pass inline-callables,canonicalize,cse,dce

// Pointer equality preserves each independently passed byte origin.
bool equal(const int* left, const int* right) { return left == right; }
bool unequal(const void* left, const void* right) { return left != right; }
bool qualification(int* left, const int* right) { return left == right; }
bool selected(const int* left, const int* right, bool choose) {
  return (choose ? left + 1 : right) == right;
}
bool same_base(const int* data, unsigned left, unsigned right) {
  return data + left == data + right;
}
bool one_past(const int* begin, const int* end) { return begin + 3 == end; }

// ----
func.def public @equal(%left: buffer, %left_byte_offset: index, %right: buffer, %right_byte_offset: index) -> (i1) {
  %5 = buffer.compare.address eq, %left[%left_byte_offset], %right[%right_byte_offset]
  func.return %5 : i1
}

func.def public @unequal(%left: buffer, %left_byte_offset: index, %right: buffer, %right_byte_offset: index) -> (i1) {
  %11 = buffer.compare.address ne, %left[%left_byte_offset], %right[%right_byte_offset]
  func.return %11 : i1
}

func.def public @qualification(%left: buffer, %left_byte_offset: index, %right: buffer, %right_byte_offset: index) -> (i1) {
  %17 = buffer.compare.address eq, %left[%left_byte_offset], %right[%right_byte_offset]
  func.return %17 : i1
}

func.def public @selected(%left: buffer, %left_byte_offset: index, %right: buffer, %right_byte_offset: index, %choose: i1) -> (i1) {
  %24, %25 = scf.if %choose -> (buffer, index) {
    %59 = index.constant 4 : index
    %30 = index.add %left_byte_offset, %59 : index
    scf.yield %left, %30 : buffer, index
  } else {
    scf.yield %right, %right_byte_offset : buffer, index
  }
  %31 = buffer.compare.address eq, %24[%25], %right[%right_byte_offset]
  func.return %31 : i1
}

func.def public @same_base(%data: buffer, %data_byte_offset: index, %left: i32, %right: i32) -> (i1) {
  %37 = scalar.extui %left : i32 to i64
  %38 = index.cast %37 : i64 to index
  %39 = index.constant 4 : index
  %62 = index.madd %38, %39, %data_byte_offset : index
  %42 = scalar.extui %right : i32 to i64
  %43 = index.cast %42 : i64 to index
  %61 = index.madd %43, %39, %data_byte_offset : index
  %60 = index.cmp eq, %62, %61 : index
  func.return %60 : i1
}

func.def public @one_past(%begin: buffer, %begin_byte_offset: index, %end: buffer, %end_byte_offset: index) -> (i1) {
  %64 = index.constant 3 : index
  %55 = index.constant 4 : index
  %63 = index.madd %55, %64, %begin_byte_offset : index
  %58 = buffer.compare.address eq, %begin[%63], %end[%end_byte_offset]
  func.return %58 : i1
}

// ====

// The helper receives independent pointer pairs. Inlining can establish their
// common root without requiring source annotations or an integer-loop rewrite.
static const long* largest(const long* first, const long* last) {
  const long* best = first;
  for (const long* p = first + 1; p != last; ++p) {
    if (*best < *p) best = p;
  }
  return best;
}
[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void k(long* out, long a, long b, long c) {
  long values[3] = {a, b, c};
  out[0] = *largest(values, values + 3);
}

// ----
kernel.def @k() {
  %4 = index.constant 1 : index
  kernel.launch.config workgroups(%4, %4, %4) workgroup_size(%4, %4, %4) : index
} launch(%out: buffer, %a: i64, %b: i64, %c: i64) {
  %11 = index.constant 24 : offset
  %values_storage = buffer.alloca<private> align(8) %11 : buffer
  %values_storage_byte_offset = index.constant 0 : index
  %values_view = buffer.view %values_storage[%values_storage_byte_offset] : buffer -> view<3xi64>
  view.store<type_disjoint> %a, %values_view[%values_storage_byte_offset] : i64, view<3xi64>
  %16 = index.constant 1 : index
  view.store<type_disjoint> %b, %values_view[%16] : i64, view<3xi64>
  %17 = index.constant 2 : index
  view.store<type_disjoint> %c, %values_view[%17] : i64, view<3xi64>
  %72 = index.constant 24 : index
  %p_byte_offset$71 = index.constant 8 : index
  %best, %best_byte_offset, %p, %p_byte_offset$55 = scf.while(%best = %values_storage : buffer, %best_byte_offset = %values_storage_byte_offset : index, %p = %values_storage : buffer, %p_byte_offset = %p_byte_offset$71 : index) -> (buffer, index, buffer, index) {
    %56 = buffer.compare.address ne, %p[%p_byte_offset], %values_storage[%72]
    scf.condition %56, %best, %best_byte_offset, %p, %p_byte_offset : i1, buffer, index, buffer, index
  } do(%best$48: buffer, %best_byte_offset$49: index, %p: buffer, %p_byte_offset$51: index) {
    %57 = buffer.view %best$48[%best_byte_offset$49] : buffer -> view<1xi64>
    %58 = view.load<root_in_bounds|type_disjoint> %57[0] : view<1xi64> -> i64
    %59 = buffer.view %p[%p_byte_offset$51] : buffer -> view<1xi64>
    %60 = view.load<root_in_bounds|type_disjoint> %59[0] : view<1xi64> -> i64
    %61 = scalar.cmpi slt, %58, %60 : i64
    %best$73 = scf.select %61, %p, %best$48 : buffer
    %best_byte_offset$74 = scf.select %61, %p_byte_offset$51, %best_byte_offset$49 : index
    %p_byte_offset$68 = index.add %p_byte_offset$51, %p_byte_offset$71 : index
    scf.yield %best$73, %best_byte_offset$74, %p, %p_byte_offset$68 : buffer, index, buffer, index
  }
  %25 = buffer.view %best[%best_byte_offset] : buffer -> view<1xi64>
  %26 = view.load<root_in_bounds|type_disjoint> %25[0] : view<1xi64> -> i64
  %32 = buffer.view %out[%values_storage_byte_offset] : buffer -> view<1xi64>
  view.store<root_in_bounds|type_disjoint> %26, %32[0] : i64, view<1xi64>
  kernel.return
}
