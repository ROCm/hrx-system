    %65 = buffer.compare.address ne, %p[%p_byte_offset], %values_storage[%11]
    scf.condition %65, %best, %best_byte_offset, %p, %p_byte_offset : i1, buffer, offset, buffer, offset
  } do(%best$57: buffer, %best_byte_offset$58: offset, %p: buffer, %p_byte_offset$60: offset) {
    %66 = buffer.view %best$57[%best_byte_offset$58] : buffer -> view<1xi64>
