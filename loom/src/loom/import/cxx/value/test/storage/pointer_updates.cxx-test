// RUN: pass canonicalize,cse,dce
// Prefix and postfix updates select different read origins while output
// pointer increments preserve the order of the observations.
void observe(const int* cursor, int* result) {
  *result++ = *cursor++;
  *result++ = *++cursor;
  *result++ = *cursor--;
  *result++ = *--cursor;
  *result = *cursor;
}

