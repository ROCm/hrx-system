// ====
// Short-circuit expressions skip both the read and the pointer update.
void observe(const int* cursor, int* result, unsigned choose) {
  bool accepted = (choose & 2u) || *cursor++ != 0;
  *result++ = (int)accepted;
  *result++ = *cursor;
  bool guarded = (choose & 4u) && *cursor++ != 0;
  *result++ = (int)guarded;
  *result = *cursor;
}

