// ====
// The chosen expression returns either the old or new pointer, while both
// branches carry the updated pointer into the following observation.
void observe(const int* cursor, int* result, unsigned choose) {
  const int* selected = (choose & 1u) ? cursor++ : ++cursor;
  *result++ = *selected;
  *result = *cursor;
}

