// ====
// The loop carries the pointer updated by each body, including its final
// position after the post-increment condition fails.
void observe(const int* cursor, int* result) {
  unsigned index = 0;
  int total = 0;
  while (index++ < 2u) {
    total += *cursor++;
  }
  *result++ = total;
  *result = *cursor;
}

