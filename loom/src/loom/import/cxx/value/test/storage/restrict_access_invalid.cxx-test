// RUN: verify
// ERROR@+1: LOWERING/059 "address-taken restrict-qualified parameters require a stored pointer representation"
int addressed_parameter(int* __restrict__ pointer) {
  int* __restrict__* address = &pointer;
  (void)address;
  return pointer[0];
}

// ====
// Reference initialization must bind the original object, not a value copy.
// The frontend does not yet preserve that distinction for qualified references.
static int local_reference(int& input) {
  // ERROR@+1: LOWERING/059 "restrict-qualified reference initialization is not supported"
  int& __restrict__ local = input;
  local += 1;
  return input;
}
int caller(int* input) { return local_reference(*input); }

// ====
struct Reference { int& __restrict__ value; };
// ERROR@+1: LOWERING/059 "restrict-qualified reference initialization is not supported"
int field_reference(int* input) { Reference reference{*input}; return reference.value; }

// ====
constexpr int value = 3;
// ERROR@+1: LOWERING/059 "restrict-qualified reference initialization is not supported"
const int& __restrict__ global_reference = value;
int caller() { return global_reference; }
