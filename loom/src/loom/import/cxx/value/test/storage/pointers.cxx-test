  %13 = scalar.constant 1 : i32
  %14 = index.cast %13 : i32 to index
  %15 = index.constant 4 : index
  %16 = index.mul %14, %15 : index
  %p_byte_offset$17 = index.add %p_byte_offset$10, %16 : index
  func.return %p, %p_byte_offset$10 : buffer, index
}

