  %22 = scalar.constant 1 : i32
  %23 = index.cast %22 : i32 to index
  %24 = index.constant 4 : index
  %25 = index.mul %23, %24 : index
  %p_byte_offset$26 = index.sub %p_byte_offset$19, %25 : index
  func.return %p, %p_byte_offset$26 : buffer, index
