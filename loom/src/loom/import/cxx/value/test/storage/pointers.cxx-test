// ====
// RUN: roundtrip
// Ordinary pointer parameters expand into a buffer and index; kernel bindings
// expose one buffer and retain the zero origin inside the body.
int* ordinary(int* pointer, long long displacement) {
  return pointer + displacement;
}
[[loom::kernel]] void entry(int* pointer, long long displacement) {}
// ----
func.def public @ordinary(%pointer: buffer, %pointer_byte_offset: index, %displacement: i64) -> (buffer, index) {
  %5 = index.cast %displacement : i64 to index
  %6 = index.constant 4 : index
  %7 = index.mul %5, %6 : index
  %8 = index.add %pointer_byte_offset, %7 : index
  func.return %pointer, %8 : buffer, index
}

kernel.def @entry() {
  %workgroup_count_x = config.get @entry.workgroup_count.x : index
  %workgroup_count_y = config.get @entry.workgroup_count.y : index
  %workgroup_count_z = config.get @entry.workgroup_count.z : index
  %workgroup_size_x = config.get @entry.workgroup_size.x : index
  %workgroup_size_y = config.get @entry.workgroup_size.y : index
  %workgroup_size_z = config.get @entry.workgroup_size.z : index
  kernel.launch.config workgroups(%workgroup_count_x, %workgroup_count_y, %workgroup_count_z) workgroup_size(%workgroup_size_x, %workgroup_size_y, %workgroup_size_z) : index
} launch(%pointer: buffer, %displacement: i64) {
  %pointer_byte_offset = index.constant 0 : index
  kernel.return
}

config.decl @entry.workgroup_count.x : index

config.decl @entry.workgroup_count.y : index

config.decl @entry.workgroup_count.z : index

config.decl @entry.workgroup_size.x : index

config.decl @entry.workgroup_size.y : index

config.decl @entry.workgroup_size.z : index

// ====
// A source pointer retains its allocation root independently of its current
// byte origin, allowing root-only Loom interfaces to consume local storage.
#include <loomcxx/buffer.h>

loom::type::buffer<unsigned> recover_root(unsigned* pointer) {
  return loom::buffer::root(pointer + 4);
}
// ----
func.def public @recover_root(%pointer: buffer, %pointer_byte_offset: index) -> (buffer) {
  %3 = scalar.constant 4 : i32
  %4 = index.cast %3 : i32 to index
  %5 = index.constant 4 : index
  %6 = index.mul %4, %5 : index
  %7 = index.add %pointer_byte_offset, %6 : index
  func.return %pointer : buffer
}

// ====

int* advance_unsigned(int* pointer, unsigned count) { return pointer + count; }
int* advance_boolean(int* pointer, bool advance) { return pointer + advance; }

// ----
func.def public @advance_unsigned(%pointer: buffer, %pointer_byte_offset: index, %count: i32) -> (buffer, index) {
  %5 = scalar.extui %count : i32 to i64
  %6 = index.cast %5 : i64 to index
  %7 = index.constant 4 : index
  %8 = index.mul %6, %7 : index
  %9 = index.add %pointer_byte_offset, %8 : index
  func.return %pointer, %9 : buffer, index
}

func.def public @advance_boolean(%pointer: buffer, %pointer_byte_offset: index, %advance: i1) -> (buffer, index) {
  %15 = scalar.extui %advance : i1 to i32
  %16 = index.cast %15 : i32 to index
  %17 = index.constant 4 : index
  %18 = index.mul %16, %17 : index
  %19 = index.add %pointer_byte_offset, %18 : index
  func.return %pointer, %19 : buffer, index
}
