  %4 = scalar.constant 1 : i32
  %5 = index.cast %4 : i32 to index
  %6 = index.constant 4 : index
  %7 = index.mul %5, %6 : index
  %p_byte_offset$8 = index.add %p_byte_offset$1, %7 : index
  func.return %p, %p_byte_offset$8 : buffer, index
}

