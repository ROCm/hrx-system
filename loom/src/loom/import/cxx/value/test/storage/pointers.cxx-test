// ====
// RUN: roundtrip
// Pointer unary plus preserves root and origin.
int* identity(int* p) { return +p; }
// ----
func.def public @identity(%p: buffer, %p_byte_offset: index) -> (buffer, index) {
  func.return %p, %p_byte_offset : buffer, index
}

// ====
// RUN: roundtrip
// Taking the address of a pointer value needs no stored object representation
// when the indirect pointer is used only to read the original value.
int* local(int* input) {
  int* pointer = input;
  auto** indirect = &pointer;
  return *indirect;
}

// ----
func.def public @local(%input: buffer, %input_byte_offset: index) -> (buffer, index) {
  func.return %input, %input_byte_offset : buffer, index
}

// ====
// RUN: roundtrip
// Declaration-only pointers acquire their complete root/origin group on
// assignment without creating an addressable pointer object.
int* deferred(int* input) {
  int* result;
  result = input;
  return result;
}
// ----
func.def public @deferred(%input: buffer, %input_byte_offset: index) -> (buffer, index) {
  func.return %input, %input_byte_offset : buffer, index
}

// ====
// RUN: roundtrip
// Pointer increment results preserve the source ABI.
int* next(int* p) { return ++p; }
int* previous(int* p) { return p++; }
int* retreat(int* p) { return --p; }
int* old_retreat(int* p) { return p--; }
// ----
