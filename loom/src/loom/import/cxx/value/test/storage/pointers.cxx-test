  %31 = scalar.constant 1 : i32
  %32 = index.cast %31 : i32 to index
  %33 = index.constant 4 : index
  %34 = index.mul %32, %33 : index
  %p_byte_offset$35 = index.sub %p_byte_offset$28, %34 : index
  func.return %p, %p_byte_offset$28 : buffer, index
