  %27 = buffer.view %other[%other_byte_offset] : buffer -> view<1xi32>
  %other_value = view.load<volatile|root_in_bounds> %27[0] : view<1xi32> -> i32
  %29 = scalar.constant 1 : i32
  %30 = scalar.addi %other_value, %29 : i32
  %31 = buffer.view %this[%this_byte_offset] : buffer -> view<1xi32>
  view.store<volatile|root_in_bounds> %30, %31[0] : i32, view<1xi32>
