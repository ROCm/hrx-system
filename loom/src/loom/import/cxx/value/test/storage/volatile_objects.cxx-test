// RUN: pass canonicalize,cse,dce
// A later default member initializer observes the element already constructed.
struct Observed { volatile unsigned values[2] = {7, values[0] + 2}; };
unsigned read() { Observed object; return object.values[1]; }

// ----
func.def public @read() -> (i32) {
  %1 = index.constant 8 : offset
  %object_storage = buffer.alloca<private> align(4) %1 : buffer
  %7 = scalar.constant 7 : i32
  %45 = index.constant 0 : offset
  %9 = buffer.view %object_storage[%45] : buffer -> view<1xi32>
  view.store<volatile> %7, %9[0] : i32, view<1xi32>
  %24 = view.load<volatile> %9[0] : view<1xi32> -> i32
  %25 = scalar.constant 2 : i32
  %26 = scalar.addi %24, %25 : i32
  %43 = index.constant 4 : offset
  %28 = buffer.view %object_storage[%43] : buffer -> view<1xi32>
  view.store<volatile> %26, %28[0] : i32, view<1xi32>
  %41 = view.load<volatile> %28[0] : view<1xi32> -> i32
  func.return %41 : i32
}

// ====
// Result and parameter transport construct directly in the destination. Only
// authored reads and the destructor's authored write observe the volatile field.
struct Observed {
  volatile unsigned value;
  Observed(unsigned input) : value(input) {}
  ~Observed() { value = 0; }
};
[[loom::noinline]] static Observed make(unsigned input) { return Observed(input); }
[[loom::noinline]] static unsigned consume(Observed object) { return object.value; }
unsigned observe(unsigned input) {
  Observed object = make(input);
  unsigned first = object.value;
  return first + consume(make(input + 1));
}

// ----
func.def public @observe(%input: i32) -> (i32) {
  %2 = index.constant 4 : offset
  %object_storage = buffer.alloca<private> align(4) %2 : buffer
  %object_storage_byte_offset = index.constant 0 : offset
  func.call @make(%object_storage, %object_storage_byte_offset, %input) : (buffer, offset, i32)
  %9 = buffer.view %object_storage[%object_storage_byte_offset] : buffer -> view<1xi32>
  %value = view.load<volatile> %9[0] : view<1xi32> -> i32
  %12 = buffer.alloca<private> align(4) %2 : buffer
  %15 = scalar.constant 1 : i32
  %16 = scalar.addi %input, %15 : i32
  func.call @make(%12, %object_storage_byte_offset, %16) : (buffer, offset, i32)
  %17 = func.call @consume(%12, %object_storage_byte_offset) : (buffer, offset) -> (i32)
  %18 = scalar.addi %value, %17 : i32
  func.call @Observed___Observed_storage(%object_storage, %object_storage_byte_offset) : (buffer, offset)
  func.return %18 : i32
}

func.def noinline @make(%result: buffer, %result_byte_offset: offset, %input: i32) {
  func.call @Observed__Observed_storage(%result, %result_byte_offset, %input) : (buffer, offset, i32)
  func.return
}

func.def noinline @consume(%object: buffer, %object_byte_offset: offset) -> (i32) {
  %27 = buffer.view %object[%object_byte_offset] : buffer -> view<1xi32>
  %value = view.load<volatile|root_in_bounds> %27[0] : view<1xi32> -> i32
  func.call @Observed___Observed_storage(%object, %object_byte_offset) : (buffer, offset)
  func.return %value : i32
}

func.def inline @Observed___Observed_storage(%this: buffer, %this_byte_offset: offset) {
  %31 = scalar.constant 0 : i32
  %34 = buffer.view %this[%this_byte_offset] : buffer -> view<1xi32>
  view.store<volatile|root_in_bounds> %31, %34[0] : i32, view<1xi32>
  func.return
}

func.def inline @Observed__Observed_storage(%this: buffer, %this_byte_offset: offset, %input: i32) {
  %40 = buffer.view %this[%this_byte_offset] : buffer -> view<1xi32>
  view.store<volatile|root_in_bounds> %input, %40[0] : i32, view<1xi32>
  func.return
}

// ====
// Owned qualification follows bases, nested arrays, and native vector fields.
using Words = unsigned __attribute__((ext_vector_type(2)));
struct Base { volatile unsigned count; };
struct Packet : Base { volatile Words words; unsigned ordinary; };
struct Table { Packet packets[2]; };
unsigned nested(unsigned input) {
  Table table{{{{input}, Words{input + 1, input + 2}, 3}, {{4}, Words{5, 6}, 7}}};
  return table.packets[0].count + table.packets[0].words[1] + table.packets[1].ordinary;
}

// ----
func.def public @nested(%input: i32) -> (i32) {
  %2 = index.constant 48 : offset
  %table_storage = buffer.alloca<private> align(8) %2 : buffer
  %106 = index.constant 0 : offset
  %13 = buffer.view %table_storage[%106] : buffer -> view<1xi32>
  view.store<volatile> %input, %13[0] : i32, view<1xi32>
  %16 = scalar.constant 1 : i32
  %17 = scalar.addi %input, %16 : i32
  %18 = scalar.constant 2 : i32
  %19 = scalar.addi %input, %18 : i32
  %20 = vector.from_elements %17, %19 : vector<2xi32>
  %105 = index.constant 8 : offset
  %22 = buffer.view %table_storage[%105] : buffer -> view<2xi32>
  vector.store<volatile> %20, %22[0] : vector<2xi32>, view<2xi32>
  %25 = scalar.constant 3 : i32
  %104 = index.constant 16 : offset
  %27 = buffer.view %table_storage[%104] : buffer -> view<1xi32>
  view.store %25, %27[0] : i32, view<1xi32>
  %34 = scalar.constant 4 : i32
  %103 = index.constant 24 : offset
  %36 = buffer.view %table_storage[%103] : buffer -> view<1xi32>
  view.store<volatile> %34, %36[0] : i32, view<1xi32>
  %39 = vector.constanti [5, 6] : vector<2xi32>
  %102 = index.constant 32 : offset
  %41 = buffer.view %table_storage[%102] : buffer -> view<2xi32>
  vector.store<volatile> %39, %41[0] : vector<2xi32>, view<2xi32>
  %44 = scalar.constant 7 : i32
  %101 = index.constant 40 : offset
  %46 = buffer.view %table_storage[%101] : buffer -> view<1xi32>
  view.store %44, %46[0] : i32, view<1xi32>
  %count = view.load<volatile> %13[0] : view<1xi32> -> i32
  %words = vector.load<volatile> %22[0] : view<2xi32> -> vector<2xi32>
  %97 = vector.extract %words[1] : vector<2xi32> -> i32
  %80 = scalar.addi %count, %97 : i32
  %ordinary = view.load %46[0] : view<1xi32> -> i32
  %96 = scalar.addi %80, %ordinary : i32
  func.return %96 : i32
}

// ====
// Qualification on the complete object applies to every member access and
// survives a volatile-qualified member function's receiver contract.
struct Pair {
  unsigned first;
  unsigned second;
  unsigned read() const volatile { return first + second; }
};
unsigned qualified(unsigned input) {
  volatile Pair value{input, input + 1};
  return value.read();
}
unsigned adapted_receiver(Pair value) { return value.read(); }

// ----
func.def public @qualified(%input: i32) -> (i32) {
  %2 = index.constant 8 : offset
  %value_storage = buffer.alloca<private> align(4) %2 : buffer
  %value_storage_byte_offset = index.constant 0 : offset
  %9 = buffer.view %value_storage[%value_storage_byte_offset] : buffer -> view<1xi32>
  view.store<volatile> %input, %9[0] : i32, view<1xi32>
  %12 = scalar.constant 1 : i32
  %13 = scalar.addi %input, %12 : i32
  %45 = index.constant 4 : offset
  %15 = buffer.view %value_storage[%45] : buffer -> view<1xi32>
  view.store<volatile> %13, %15[0] : i32, view<1xi32>
  %16 = func.call @Pair__read_storage(%value_storage, %value_storage_byte_offset) : (buffer, offset) -> (i32)
  func.return %16 : i32
}

func.def public @adapted_receiver(%value_first: i32, %value_second: i32) -> (i32) {
  %20 = index.constant 8 : offset
  %value_storage = buffer.alloca<private> align(4) %20 : buffer
  %value_storage_byte_offset = index.constant 0 : offset
  %27 = buffer.view %value_storage[%value_storage_byte_offset] : buffer -> view<1xi32>
  view.store %value_first, %27[0] : i32, view<1xi32>
  %47 = index.constant 4 : offset
  %31 = buffer.view %value_storage[%47] : buffer -> view<1xi32>
  view.store %value_second, %31[0] : i32, view<1xi32>
  %32 = func.call @Pair__read_storage(%value_storage, %value_storage_byte_offset) : (buffer, offset) -> (i32)
  func.return %32 : i32
}

func.def @Pair__read_storage(%this: buffer, %this_byte_offset: offset) -> (i32) {
  %38 = buffer.view %this[%this_byte_offset] : buffer -> view<1xi32>
  %first = view.load<volatile|root_in_bounds> %38[0] : view<1xi32> -> i32
  %40 = index.constant 4 : offset
  %41 = index.add %this_byte_offset, %40 : offset
  %42 = buffer.view %this[%41] : buffer -> view<1xi32>
  %second = view.load<volatile|root_in_bounds> %42[0] : view<1xi32> -> i32
  %44 = scalar.addi %first, %second : i32
  func.return %44 : i32
}

// ====
// Volatile character arrays initialize each code unit, including the terminator.
struct Text { volatile char bytes[3] = "hi"; };
unsigned character_array() { Text text; return text.bytes[1]; }

// ----
func.def public @character_array() -> (i32) {
  %1 = index.constant 3 : offset
  %text_storage = buffer.alloca<private> align(1) %1 : buffer
  %7 = scalar.constant 104 : i8
  %37 = index.constant 0 : offset
  %9 = buffer.view %text_storage[%37] : buffer -> view<1xi8>
  view.store<volatile> %7, %9[0] : i8, view<1xi8>
  %10 = scalar.constant 105 : i8
  %36 = index.constant 1 : offset
  %14 = buffer.view %text_storage[%36] : buffer -> view<1xi8>
  view.store<volatile> %10, %14[0] : i8, view<1xi8>
  %15 = scalar.constant 0 : i8
  %35 = index.constant 2 : offset
  %19 = buffer.view %text_storage[%35] : buffer -> view<1xi8>
  view.store<volatile> %15, %19[0] : i8, view<1xi8>
  %32 = view.load<volatile> %14[0] : view<1xi8> -> i8
  %33 = scalar.extsi %32 : i8 to i32
  func.return %33 : i32
}

// ====
// Real source copies and assignments still perform their volatile reads and
// writes. Prvalue initialization and discarded results add no transport reads.
struct Observed { volatile unsigned value; unsigned ordinary; };
[[loom::noinline]] static Observed make(unsigned input) { return {input, 3}; }
unsigned copies(unsigned input) {
  Observed first = make(input);
  static_cast<void>(first);
  Observed second = first;
  second = first;
  make(input + 1);
  return second.value;
}

// ----
func.def public @copies(%input: i32) -> (i32) {
  %2 = index.constant 8 : offset
  %first_storage = buffer.alloca<private> align(4) %2 : buffer
  %first_storage_byte_offset = index.constant 0 : offset
  func.call @make(%first_storage, %first_storage_byte_offset, %input) : (buffer, offset, i32)
  %second_storage = buffer.alloca<private> align(4) %2 : buffer
  %13 = buffer.view %first_storage[%first_storage_byte_offset] : buffer -> view<1xi32>
  %first_value$14 = view.load<volatile> %13[0] : view<1xi32> -> i32
  %74 = index.constant 4 : offset
  %18 = buffer.view %first_storage[%74] : buffer -> view<1xi32>
  %first_ordinary$19 = view.load %18[0] : view<1xi32> -> i32
  %23 = buffer.view %second_storage[%first_storage_byte_offset] : buffer -> view<1xi32>
  view.store<volatile> %first_value$14, %23[0] : i32, view<1xi32>
  %27 = buffer.view %second_storage[%74] : buffer -> view<1xi32>
  view.store %first_ordinary$19, %27[0] : i32, view<1xi32>
  %first_value$32 = view.load<volatile> %13[0] : view<1xi32> -> i32
  %first_ordinary$37 = view.load %18[0] : view<1xi32> -> i32
  view.store<volatile> %first_value$32, %23[0] : i32, view<1xi32>
  view.store %first_ordinary$37, %27[0] : i32, view<1xi32>
  %47 = buffer.alloca<private> align(4) %2 : buffer
  %50 = scalar.constant 1 : i32
  %51 = scalar.addi %input, %50 : i32
  func.call @make(%47, %first_storage_byte_offset, %51) : (buffer, offset, i32)
  %value = view.load<volatile> %23[0] : view<1xi32> -> i32
  func.return %value : i32
}

func.def noinline @make(%result: buffer, %result_byte_offset: offset, %input: i32) {
  %62 = buffer.view %result[%result_byte_offset] : buffer -> view<1xi32>
  view.store<volatile|root_in_bounds> %input, %62[0] : i32, view<1xi32>
  %63 = index.constant 4 : offset
  %64 = index.add %result_byte_offset, %63 : offset
  %65 = scalar.constant 3 : i32
  %66 = buffer.view %result[%64] : buffer -> view<1xi32>
  view.store<root_in_bounds> %65, %66[0] : i32, view<1xi32>
  func.return
}

// ====
// Discarding a volatile class lvalue performs its selected volatile copy and
// destroys that temporary. This differs from discarding the ordinary class
// containing a volatile field above, which does not read its members.
struct Observed {
  volatile unsigned value;
  Observed(unsigned input) : value(input) {}
  Observed(const volatile Observed& other) : value(other.value + 1) {}
  ~Observed() { value = 0; }
};
void discarded(unsigned input) {
  volatile Observed object(input);
  object;
  static_cast<void>(object);
}

// ----
func.def public @discarded(%input: i32) {
  %1 = index.constant 4 : offset
  %object_storage = buffer.alloca<private> align(4) %1 : buffer
  %object_storage_byte_offset = index.constant 0 : offset
  func.call @Observed__Observed_storage(%object_storage, %object_storage_byte_offset, %input) : (buffer, offset, i32)
  %6 = buffer.alloca<private> align(4) %1 : buffer
  func.call @Observed__Observed_storage_1(%6, %object_storage_byte_offset, %object_storage, %object_storage_byte_offset) : (buffer, offset, buffer, offset)
  func.call @Observed___Observed_storage(%6, %object_storage_byte_offset) : (buffer, offset)
  %10 = buffer.alloca<private> align(4) %1 : buffer
  func.call @Observed__Observed_storage_1(%10, %object_storage_byte_offset, %object_storage, %object_storage_byte_offset) : (buffer, offset, buffer, offset)
  func.call @Observed___Observed_storage(%10, %object_storage_byte_offset) : (buffer, offset)
  func.call @Observed___Observed_storage(%object_storage, %object_storage_byte_offset) : (buffer, offset)
  func.return
}

func.def inline @Observed__Observed_storage(%this: buffer, %this_byte_offset: offset, %input: i32) {
  %18 = buffer.view %this[%this_byte_offset] : buffer -> view<1xi32>
  view.store<volatile|root_in_bounds> %input, %18[0] : i32, view<1xi32>
  func.return
}

