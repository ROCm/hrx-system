// RUN: pass canonicalize,cse,dce
// Class packing retains both the odd stride and the one-byte member origin.
struct [[gnu::packed]] Record { unsigned char tag; unsigned value; };
unsigned read(const Record* records, unsigned index) {
  return records[index].value;
}

// ----
func.def public @read(%records: buffer, %records_byte_offset: offset, %index: i32) -> (i32) {
  %4 = scalar.extui %index : i32 to i64
  %5 = scalar.constant 5 : i64
  %6 = scalar.muli %4, %5 : i64
  %7 = index.cast %records_byte_offset : offset to i64
  %8 = scalar.addi %7, %6 : i64
  %9 = scalar.assume %8 [range(%8, 0, 9223372036854775807)] : i64
  %10 = index.cast %9 : i64 to offset
  %11 = index.constant 1 : offset
  %12 = index.add %10, %11 : offset
  %13 = buffer.view %records[%12] : buffer -> view<1xi32, align(1)>
  %value = view.load<root_in_bounds> %13[0] : view<1xi32, align(1)> -> i32
  func.return %value : i32
}

// ====
// Member packing uses the same projection contract.
struct Record { unsigned char tag; unsigned value [[gnu::packed]]; };
void update(Record* records) { records[1].value /= 2u; }

// ----
func.def public @update(%records: buffer, %records_byte_offset: offset) {
  %18 = scalar.constant 5 : i64
  %7 = index.cast %records_byte_offset : offset to i64
  %8 = scalar.addi %7, %18 : i64
  %9 = scalar.assume %8 [range(%8, 0, 9223372036854775807)] : i64
  %10 = index.cast %9 : i64 to offset
  %11 = index.constant 1 : offset
  %12 = index.add %10, %11 : offset
  %13 = buffer.view %records[%12] : buffer -> view<1xi32, align(1)>
  %14 = view.load<root_in_bounds> %13[0] : view<1xi32, align(1)> -> i32
  %16 = scalar.constant 1 : i32
  %17 = scalar.shrui %14, %16 : i32
  view.store<root_in_bounds> %17, %13[0] : i32, view<1xi32, align(1)>
  func.return
}

// ====
// A packing cap changes outer placement, not a nested record's own layout.
struct Payload { unsigned char tag; float value; };
#pragma pack(push, 2)
struct Record { unsigned char tag; Payload payload; };
#pragma pack(pop)
void update(volatile Record* records) { records[1].payload.value += 2.0f; }

// ----
func.def public @update(%records: buffer, %records_byte_offset: offset) {
  %2 = scalar.constant 2.0 : f32
  %18 = scalar.constant 10 : i64
  %7 = index.cast %records_byte_offset : offset to i64
  %8 = scalar.addi %7, %18 : i64
  %9 = scalar.assume %8 [range(%8, 0, 9223372036854775807)] : i64
  %10 = index.cast %9 : i64 to offset
  %11 = index.constant 2 : offset
  %12 = index.add %10, %11 : offset
  %13 = index.constant 4 : offset
  %14 = index.add %12, %13 : offset
  %15 = buffer.view %records[%14] : buffer -> view<1xf32, align(2)>
  %16 = view.load<volatile|root_in_bounds> %15[0] : view<1xf32, align(2)> -> f32
  %17 = scalar.addf %16, %2 : f32
  view.store<volatile|root_in_bounds> %17, %15[0] : f32, view<1xf32, align(2)>
  func.return
}

// ====
// Record alignment raises the stride without changing the packed field offset.
struct alignas(16) __attribute__((packed)) Record {
  unsigned char tag;
  double value;
};
void copy(Record* output, const Record* input) {
  output[1].value = input[2].value;
}

// ----
func.def public @copy(%output: buffer, %output_byte_offset: offset, %input: buffer, %input_byte_offset: offset) {
  %28 = scalar.constant 32 : i64
  %8 = index.cast %input_byte_offset : offset to i64
  %9 = scalar.addi %8, %28 : i64
  %10 = scalar.assume %9 [range(%9, 0, 9223372036854775807)] : i64
  %11 = index.cast %10 : i64 to offset
  %12 = index.constant 1 : offset
  %13 = index.add %11, %12 : offset
  %14 = buffer.view %input[%13] : buffer -> view<1xf64, align(1)>
  %value = view.load<root_in_bounds> %14[0] : view<1xf64, align(1)> -> f64
  %27 = scalar.constant 16 : i64
  %20 = index.cast %output_byte_offset : offset to i64
  %21 = scalar.addi %20, %27 : i64
  %22 = scalar.assume %21 [range(%21, 0, 9223372036854775807)] : i64
  %23 = index.cast %22 : i64 to offset
  %25 = index.add %23, %12 : offset
  %26 = buffer.view %output[%25] : buffer -> view<1xf64, align(1)>
  view.store<root_in_bounds> %value, %26[0] : f64, view<1xf64, align(1)>
  func.return
}

// ====
// Vector accesses retain the whole footprint at the exact packed origin.
typedef unsigned U4 __attribute__((vector_size(16)));
struct [[gnu::packed]] Record { unsigned char tag; U4 value; };
void copy(Record* output, const Record* input) { output->value = input->value; }

// ----
func.def public @copy(%output: buffer, %output_byte_offset: offset, %input: buffer, %input_byte_offset: offset) {
  %4 = index.constant 1 : offset
  %5 = index.add %input_byte_offset, %4 : offset
  %6 = buffer.view %input[%5] : buffer -> view<4xi32, align(1)>
  %value = vector.load<root_in_bounds> %6[0] : view<4xi32, align(1)> -> vector<4xi32>
  %9 = index.add %output_byte_offset, %4 : offset
  %10 = buffer.view %output[%9] : buffer -> view<4xi32, align(1)>
  vector.store<root_in_bounds> %value, %10[0] : vector<4xi32>, view<4xi32, align(1)>
  func.return
}

// ====
// RUN: pass canonicalize,cse,dce
// Typed fields of an odd-stride record visit every alignment residue.
// Initial byte filling precedes the copy, and every access retains align(1).
template <class Wide>
struct [[gnu::packed]] Packet {
  // Eight bytes transported without changing their bit representation.
  Wide wide;
  // Floating-point field with an independently typed memory access.
  float real;
  // Narrow field whose access must leave adjacent bytes untouched.
  unsigned short narrow;
  // Final byte makes consecutive records visit every alignment residue.
  unsigned char byte;
};
using IntegerPacket = Packet<unsigned long long>;
static_assert(sizeof(IntegerPacket) == 15 && alignof(IntegerPacket) == 1);
static_assert(__builtin_offsetof(IntegerPacket, real) == 8);
static_assert(__builtin_offsetof(IntegerPacket, narrow) == 12);
static_assert(__builtin_offsetof(IntegerPacket, byte) == 14);

// The source and destination visit all residues modulo eight in different
// orders. The surrounding bytes expose stores wider than the source fields.
void packed_copy(const unsigned char* input, unsigned char* output) {
  for (unsigned i = 0; i < 256; ++i) {
    output[i] = 37;
  }
  auto* source = reinterpret_cast<const IntegerPacket*>(input + 1);
  auto* destination = reinterpret_cast<IntegerPacket*>(output + 5);
  for (unsigned i = 0; i < 8; ++i) {
    destination[i].wide = source[i].wide;
    destination[i].real = source[i].real;
    destination[i].narrow = source[i].narrow;
    destination[i].byte = source[i].byte;
  }
}

[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void packed_copy_kernel(const unsigned char* input, unsigned char* output) {
  packed_copy(input, output);
}
// ----
func.def public @packed_copy(%input: buffer, %input_byte_offset: offset, %output: buffer, %output_byte_offset: offset) {
  %144 = index.constant 0 : offset
  %143 = index.constant 256 : offset
  %8 = index.constant 1 : offset
  scf.for %i = [%144 to %143 step %8] {
    %10 = index.cast %i : offset to i32
    %142 = scalar.constant 37 : i8
    %13 = scalar.extui %10 : i32 to i64
    %16 = index.cast %output_byte_offset : offset to i64
    %17 = scalar.addi %16, %13 : i64
    %18 = scalar.assume %17 [range(%17, 0, 9223372036854775807)] : i64
    %19 = index.cast %18 : i64 to offset
    %20 = buffer.view %output[%19] : buffer -> view<1xi8>
    view.store<root_in_bounds> %142, %20[0] : i8, view<1xi8>
  }
  %141 = scalar.constant 1 : i64
  %25 = index.cast %input_byte_offset : offset to i64
  %26 = scalar.addi %25, %141 : i64
  %27 = scalar.assume %26 [range(%26, 0, 9223372036854775807)] : i64
  %source_byte_offset = index.cast %27 : i64 to offset
  %140 = scalar.constant 5 : i64
  %33 = index.cast %output_byte_offset : offset to i64
  %34 = scalar.addi %33, %140 : i64
  %35 = scalar.assume %34 [range(%34, 0, 9223372036854775807)] : i64
  %destination_byte_offset = index.cast %35 : i64 to offset
  %138 = index.constant 8 : offset
  scf.for %i = [%144 to %138 step %8] {
    %43 = index.cast %i : offset to i32
    %44 = scalar.extui %43 : i32 to i64
    %45 = scalar.constant 15 : i64
    %46 = scalar.muli %44, %45 : i64
    %47 = index.cast %source_byte_offset : offset to i64
    %48 = scalar.addi %47, %46 : i64
    %49 = scalar.assume %48 [range(%48, 0, 9223372036854775807)] : i64
    %50 = index.cast %49 : i64 to offset
    %53 = buffer.view %input[%50] : buffer -> view<1xi64, align(1)>
    %wide = view.load<root_in_bounds> %53[0] : view<1xi64, align(1)> -> i64
    %58 = index.cast %destination_byte_offset : offset to i64
    %59 = scalar.addi %58, %46 : i64
    %60 = scalar.assume %59 [range(%59, 0, 9223372036854775807)] : i64
    %61 = index.cast %60 : i64 to offset
    %64 = buffer.view %output[%61] : buffer -> view<1xi64, align(1)>
    view.store<root_in_bounds> %wide, %64[0] : i64, view<1xi64, align(1)>
    %73 = index.add %50, %138 : offset
    %74 = buffer.view %input[%73] : buffer -> view<1xf32, align(1)>
    %real = view.load<root_in_bounds> %74[0] : view<1xf32, align(1)> -> f32
    %84 = index.add %61, %138 : offset
    %85 = buffer.view %output[%84] : buffer -> view<1xf32, align(1)>
    view.store<root_in_bounds> %real, %85[0] : f32, view<1xf32, align(1)>
    %93 = index.constant 12 : offset
    %94 = index.add %50, %93 : offset
    %95 = buffer.view %input[%94] : buffer -> view<1xi16, align(1)>
    %narrow = view.load<root_in_bounds> %95[0] : view<1xi16, align(1)> -> i16
    %105 = index.add %61, %93 : offset
    %106 = buffer.view %output[%105] : buffer -> view<1xi16, align(1)>
    view.store<root_in_bounds> %narrow, %106[0] : i16, view<1xi16, align(1)>
    %114 = index.constant 14 : offset
    %115 = index.add %50, %114 : offset
    %116 = buffer.view %input[%115] : buffer -> view<1xi8>
    %byte = view.load<root_in_bounds> %116[0] : view<1xi8> -> i8
    %126 = index.add %61, %114 : offset
    %127 = buffer.view %output[%126] : buffer -> view<1xi8>
    view.store<root_in_bounds> %byte, %127[0] : i8, view<1xi8>
  }
  func.return
}

kernel.def @packed_copy_kernel() {
  %130 = index.constant 1 : index
  kernel.launch.config workgroups(%130, %130, %130) workgroup_size(%130, %130, %130) : index
} launch(%input: buffer, %output: buffer) {
  %input_byte_offset = index.constant 0 : offset
  func.call @packed_copy(%input, %input_byte_offset, %output, %input_byte_offset) : (buffer, offset, buffer, offset)
  kernel.return
}

// ====
// RUN: pass canonicalize,cse,dce
// Nested class/member packing and a capped child layout preserve the
// exact float, unsigned-word, and wrapping-byte destinations under volatile
// read-modify-write, including when reached from a kernel binding.
struct MemberPacked {
  // The following packed member begins immediately after this byte.
  unsigned char tag;
  // Packing belongs to this member, rather than its enclosing record.
  unsigned value [[gnu::packed]];
};
static_assert(sizeof(MemberPacked) == 5 && alignof(MemberPacked) == 1);

#pragma pack(push, 2)
struct Capped {
  // The pack cap still permits one byte of padding before the float.
  unsigned char tag;
  // Two-byte aligned field in the nested record.
  float real;
  // Nested member retains its own packed layout.
  MemberPacked member;
};
#pragma pack(pop)
static_assert(sizeof(Capped) == 12 && alignof(Capped) == 2);
static_assert(__builtin_offsetof(Capped, real) == 2);
static_assert(__builtin_offsetof(Capped, member) == 6);

struct __attribute__((packed)) Envelope {
  // Moves the nested record to an odd byte origin.
  unsigned char prefix;
  // Packing the parent retains the child's internal padding and tail byte.
  Capped data;
};
static_assert(sizeof(Envelope) == 13 && alignof(Envelope) == 1);

// Volatile qualifiers propagate through both nested records. Unsigned updates
// retain their arithmetic conversions even at an unaligned byte origin.
void packed_update(volatile Envelope* output) {
  output[2].data.real = 1.25f;
  output[2].data.real *= 2.0f;
  output[2].data.member.value = 0x80000000u;
  output[2].data.member.value /= 2u;
  output[2].data.member.value |= 1u;
  output[2].data.member.tag = 255;
  output[2].data.member.tag++;
}

[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void packed_update_kernel(volatile Envelope* output) {
  packed_update(output);
}
// ----
func.def public @packed_update(%output: buffer, %output_byte_offset: offset) {
  %2 = scalar.constant 1.25 : f32
  %138 = scalar.constant 26 : i64
  %7 = index.cast %output_byte_offset : offset to i64
  %8 = scalar.addi %7, %138 : i64
