// RUN: pass canonicalize,cse,dce
// Class packing retains both the odd stride and the one-byte member origin.
struct [[gnu::packed]] Record { unsigned char tag; unsigned value; };
unsigned read(const Record* records, unsigned index) {
  return records[index].value;
}

// ----
func.def public @read(%records: buffer, %records_byte_offset: index, %index: i32) -> (i32) {
  %4 = scalar.extui %index : i32 to i64
  %5 = index.cast %4 : i64 to index
  %6 = index.constant 5 : index
  %13 = index.madd %5, %6, %records_byte_offset : index
  %9 = index.constant 1 : index
  %10 = index.add %13, %9 : index
  %11 = buffer.view %records[%10] : buffer -> view<1xi32, align(1)>
  %value = view.load<root_in_bounds|type_disjoint> %11[0] : view<1xi32, align(1)> -> i32
  func.return %value : i32
}

// ====
// Member packing uses the same projection contract.
struct Record { unsigned char tag; unsigned value [[gnu::packed]]; };
void update(Record* records) { records[1].value /= 2u; }

// ----
func.def public @update(%records: buffer, %records_byte_offset: index) {
  %15 = index.constant 5 : index
  %7 = index.add %records_byte_offset, %15 : index
  %8 = index.constant 1 : index
  %9 = index.add %7, %8 : index
  %10 = buffer.view %records[%9] : buffer -> view<1xi32, align(1)>
  %11 = view.load<root_in_bounds|type_disjoint> %10[0] : view<1xi32, align(1)> -> i32
  %13 = scalar.constant 1 : i32
  %14 = scalar.shrui %11, %13 : i32
  view.store<root_in_bounds|type_disjoint> %14, %10[0] : i32, view<1xi32, align(1)>
  func.return
}

// ====
// A packing cap changes outer placement, not a nested record's own layout.
struct Payload { unsigned char tag; float value; };
#pragma pack(push, 2)
struct Record { unsigned char tag; Payload payload; };
#pragma pack(pop)
void update(volatile Record* records) { records[1].payload.value += 2.0f; }

// ----
func.def public @update(%records: buffer, %records_byte_offset: index) {
  %2 = scalar.constant 2.0 : f32
  %15 = index.constant 10 : index
  %7 = index.add %records_byte_offset, %15 : index
  %8 = index.constant 2 : index
  %9 = index.add %7, %8 : index
  %10 = index.constant 4 : index
  %11 = index.add %9, %10 : index
  %12 = buffer.view %records[%11] : buffer -> view<1xf32, align(2)>
  %13 = view.load<volatile|root_in_bounds|type_disjoint> %12[0] : view<1xf32, align(2)> -> f32
  %14 = scalar.addf %13, %2 : f32
  view.store<volatile|root_in_bounds|type_disjoint> %14, %12[0] : f32, view<1xf32, align(2)>
  func.return
}

// ====
// Record alignment raises the stride without changing the packed field offset.
struct alignas(16) __attribute__((packed)) Record {
  unsigned char tag;
  double value;
};
void copy(Record* output, const Record* input) {
  output[1].value = input[2].value;
}

// ----
func.def public @copy(%output: buffer, %output_byte_offset: index, %input: buffer, %input_byte_offset: index) {
  %23 = index.constant 32 : index
  %24 = index.add %input_byte_offset, %23 : index
  %9 = index.constant 1 : index
  %10 = index.add %24, %9 : index
  %11 = buffer.view %input[%10] : buffer -> view<1xf64, align(1)>
  %value = view.load<root_in_bounds|type_disjoint> %11[0] : view<1xf64, align(1)> -> f64
  %21 = index.constant 16 : index
  %17 = index.add %output_byte_offset, %21 : index
  %19 = index.add %17, %9 : index
  %20 = buffer.view %output[%19] : buffer -> view<1xf64, align(1)>
  view.store<root_in_bounds|type_disjoint> %value, %20[0] : f64, view<1xf64, align(1)>
  func.return
}

// ====
// Vector accesses retain the whole footprint at the exact packed origin.
typedef unsigned U4 __attribute__((vector_size(16)));
struct [[gnu::packed]] Record { unsigned char tag; U4 value; };
void copy(Record* output, const Record* input) { output->value = input->value; }

// ----
func.def public @copy(%output: buffer, %output_byte_offset: index, %input: buffer, %input_byte_offset: index) {
  %4 = index.constant 1 : index
  %5 = index.add %input_byte_offset, %4 : index
  %6 = buffer.view %input[%5] : buffer -> view<4xi32, align(1)>
  %value = vector.load<root_in_bounds> %6[0] : view<4xi32, align(1)> -> vector<4xi32>
  %9 = index.add %output_byte_offset, %4 : index
  %10 = buffer.view %output[%9] : buffer -> view<4xi32, align(1)>
  vector.store<root_in_bounds> %value, %10[0] : vector<4xi32>, view<4xi32, align(1)>
  func.return
}

// ====
// RUN: pass canonicalize,cse,dce
// Typed fields of an odd-stride record visit every alignment residue.
// Initial byte filling precedes the copy, and every access retains align(1).
template <class Wide>
struct [[gnu::packed]] Packet {
  // Eight bytes transported without changing their bit representation.
  Wide wide;
  // Floating-point field with an independently typed memory access.
  float real;
  // Narrow field whose access must leave adjacent bytes untouched.
  unsigned short narrow;
  // Final byte makes consecutive records visit every alignment residue.
  unsigned char byte;
};
using IntegerPacket = Packet<unsigned long long>;
static_assert(sizeof(IntegerPacket) == 15 && alignof(IntegerPacket) == 1);
static_assert(__builtin_offsetof(IntegerPacket, real) == 8);
static_assert(__builtin_offsetof(IntegerPacket, narrow) == 12);
static_assert(__builtin_offsetof(IntegerPacket, byte) == 14);

// The source and destination visit all residues modulo eight in different
// orders. The surrounding bytes expose stores wider than the source fields.
void packed_copy(const unsigned char* input, unsigned char* output) {
  for (unsigned i = 0; i < 256; ++i) {
    output[i] = 37;
  }
  auto* source = reinterpret_cast<const IntegerPacket*>(input + 1);
  auto* destination = reinterpret_cast<IntegerPacket*>(output + 5);
  for (unsigned i = 0; i < 8; ++i) {
    destination[i].wide = source[i].wide;
    destination[i].real = source[i].real;
    destination[i].narrow = source[i].narrow;
    destination[i].byte = source[i].byte;
  }
}

[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void packed_copy_kernel(const unsigned char* input, unsigned char* output) {
  packed_copy(input, output);
}
// ----
func.def public @packed_copy(%input: buffer, %input_byte_offset: index, %output: buffer, %output_byte_offset: index) {
  %120 = index.constant 0 : offset
  %119 = index.constant 256 : offset
  %8 = index.constant 1 : offset
  scf.for %i = [%120 to %119 step %8] {
    %10 = index.cast %i : offset to i32
    %118 = scalar.constant 37 : i8
    %13 = scalar.extui %10 : i32 to i64
    %14 = index.cast %13 : i64 to index
    %17 = index.add %output_byte_offset, %14 : index
    %18 = buffer.view %output[%17] : buffer -> view<1xi8>
    view.store<root_in_bounds> %118, %18[0] : i8, view<1xi8>
  }
  %117 = index.constant 1 : index
  %source_byte_offset = index.add %input_byte_offset, %117 : index
  %116 = index.constant 5 : index
  %destination_byte_offset = index.add %output_byte_offset, %116 : index
  %114 = index.constant 8 : offset
  scf.for %i = [%120 to %114 step %8] {
    %35 = index.cast %i : offset to i32
    %36 = scalar.extui %35 : i32 to i64
    %37 = index.cast %36 : i64 to index
    %38 = index.constant 15 : index
    %128 = index.madd %37, %38, %source_byte_offset : index
    %43 = buffer.view %input[%128] : buffer -> view<1xi64, align(1)>
    %wide = view.load<root_in_bounds|type_disjoint> %43[0] : view<1xi64, align(1)> -> i64
    %127 = index.madd %37, %38, %destination_byte_offset : index
    %52 = buffer.view %output[%127] : buffer -> view<1xi64, align(1)>
    view.store<root_in_bounds|type_disjoint> %wide, %52[0] : i64, view<1xi64, align(1)>
    %58 = index.constant 8 : index
    %59 = index.add %128, %58 : index
    %60 = buffer.view %input[%59] : buffer -> view<1xf32, align(1)>
    %real = view.load<root_in_bounds|type_disjoint> %60[0] : view<1xf32, align(1)> -> f32
    %68 = index.add %127, %58 : index
    %69 = buffer.view %output[%68] : buffer -> view<1xf32, align(1)>
    view.store<root_in_bounds|type_disjoint> %real, %69[0] : f32, view<1xf32, align(1)>
    %75 = index.constant 12 : index
    %76 = index.add %128, %75 : index
    %77 = buffer.view %input[%76] : buffer -> view<1xi16, align(1)>
    %narrow = view.load<root_in_bounds|type_disjoint> %77[0] : view<1xi16, align(1)> -> i16
    %85 = index.add %127, %75 : index
    %86 = buffer.view %output[%85] : buffer -> view<1xi16, align(1)>
    view.store<root_in_bounds|type_disjoint> %narrow, %86[0] : i16, view<1xi16, align(1)>
    %92 = index.constant 14 : index
    %93 = index.add %128, %92 : index
    %94 = buffer.view %input[%93] : buffer -> view<1xi8>
    %byte = view.load<root_in_bounds> %94[0] : view<1xi8> -> i8
    %102 = index.add %127, %92 : index
    %103 = buffer.view %output[%102] : buffer -> view<1xi8>
    view.store<root_in_bounds> %byte, %103[0] : i8, view<1xi8>
  }
  func.return
}

kernel.def @packed_copy_kernel() {
  %106 = index.constant 1 : index
  kernel.launch.config workgroups(%106, %106, %106) workgroup_size(%106, %106, %106) : index
} launch(%input: buffer, %output: buffer) {
  %input_byte_offset = index.constant 0 : index
  func.call @packed_copy(%input, %input_byte_offset, %output, %input_byte_offset) : (buffer, index, buffer, index)
  kernel.return
}

// ====
// RUN: pass canonicalize,cse,dce
// Nested class/member packing and a capped child layout preserve the
// exact float, unsigned-word, and wrapping-byte destinations under volatile
// read-modify-write, including when reached from a kernel binding.
struct MemberPacked {
  // The following packed member begins immediately after this byte.
  unsigned char tag;
  // Packing belongs to this member, rather than its enclosing record.
  unsigned value [[gnu::packed]];
};
static_assert(sizeof(MemberPacked) == 5 && alignof(MemberPacked) == 1);

#pragma pack(push, 2)
struct Capped {
  // The pack cap still permits one byte of padding before the float.
  unsigned char tag;
  // Two-byte aligned field in the nested record.
  float real;
  // Nested member retains its own packed layout.
  MemberPacked member;
};
#pragma pack(pop)
static_assert(sizeof(Capped) == 12 && alignof(Capped) == 2);
static_assert(__builtin_offsetof(Capped, real) == 2);
static_assert(__builtin_offsetof(Capped, member) == 6);

struct __attribute__((packed)) Envelope {
  // Moves the nested record to an odd byte origin.
  unsigned char prefix;
  // Packing the parent retains the child's internal padding and tail byte.
  Capped data;
};
static_assert(sizeof(Envelope) == 13 && alignof(Envelope) == 1);

// Volatile qualifiers propagate through both nested records. Unsigned updates
// retain their arithmetic conversions even at an unaligned byte origin.
void packed_update(volatile Envelope* output) {
  output[2].data.real = 1.25f;
  output[2].data.real *= 2.0f;
  output[2].data.member.value = 0x80000000u;
  output[2].data.member.value /= 2u;
  output[2].data.member.value |= 1u;
  output[2].data.member.tag = 255;
  output[2].data.member.tag++;
}

[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void packed_update_kernel(volatile Envelope* output) {
  packed_update(output);
}
// ----
func.def public @packed_update(%output: buffer, %output_byte_offset: index) {
  %2 = scalar.constant 1.25 : f32
  %130 = index.constant 26 : index
  %131 = index.add %output_byte_offset, %130 : index
  %8 = index.constant 1 : index
  %9 = index.add %131, %8 : index
  %10 = index.constant 2 : index
  %11 = index.add %9, %10 : index
  %12 = buffer.view %output[%11] : buffer -> view<1xf32, align(1)>
  view.store<volatile|root_in_bounds|type_disjoint> %2, %12[0] : f32, view<1xf32, align(1)>
  %13 = scalar.constant 2.0 : f32
  %24 = view.load<volatile|root_in_bounds|type_disjoint> %12[0] : view<1xf32, align(1)> -> f32
  %25 = scalar.mulf %24, %13 : f32
  view.store<volatile|root_in_bounds|type_disjoint> %25, %12[0] : f32, view<1xf32, align(1)>
  %26 = scalar.constant -2147483648 : i32
  %34 = index.constant 6 : index
  %35 = index.add %9, %34 : index
  %37 = index.add %35, %8 : index
  %38 = buffer.view %output[%37] : buffer -> view<1xi32, align(1)>
  view.store<volatile|root_in_bounds|type_disjoint> %26, %38[0] : i32, view<1xi32, align(1)>
  %52 = view.load<volatile|root_in_bounds|type_disjoint> %38[0] : view<1xi32, align(1)> -> i32
  %118 = scalar.constant 1 : i32
  %119 = scalar.shrui %52, %118 : i32
  view.store<volatile|root_in_bounds|type_disjoint> %119, %38[0] : i32, view<1xi32, align(1)>
  %67 = view.load<volatile|root_in_bounds|type_disjoint> %38[0] : view<1xi32, align(1)> -> i32
  %68 = scalar.ori %67, %118 : i32
  view.store<volatile|root_in_bounds|type_disjoint> %68, %38[0] : i32, view<1xi32, align(1)>
  %114 = scalar.constant -1 : i8
  %82 = buffer.view %output[%35] : buffer -> view<1xi8>
  view.store<volatile|root_in_bounds> %114, %82[0] : i8, view<1xi8>
  %95 = view.load<volatile|root_in_bounds> %82[0] : view<1xi8> -> i8
  %96 = scalar.extui %95 : i8 to i32
  %98 = scalar.addi %96, %118 : i32
  %99 = scalar.trunci %98 : i32 to i8
  view.store<volatile|root_in_bounds> %99, %82[0] : i8, view<1xi8>
  func.return
}

kernel.def @packed_update_kernel() {
  %101 = index.constant 1 : index
  kernel.launch.config workgroups(%101, %101, %101) workgroup_size(%101, %101, %101) : index
} launch(%output: buffer) {
  %output_byte_offset = index.constant 0 : index
  func.call @packed_update(%output, %output_byte_offset) : (buffer, index)
  kernel.return
}

// ====
// RUN: pass canonicalize,cse,dce
// The packed vector kernel transports all four lanes at byte offset one
// without expanding the source footprint to include its tag.
typedef unsigned U4 __attribute__((vector_size(16)));
struct [[gnu::packed]] VectorPacket {
  // The vector begins at an odd byte offset.
  unsigned char tag;
  // The source access spans all four lanes without touching the tag.
  U4 value;
};
static_assert(sizeof(VectorPacket) == 17 && alignof(VectorPacket) == 1);

[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void packed_vector_kernel(const VectorPacket* input, VectorPacket* output) {
  output->value = input->value;
}
// ----
kernel.def @packed_vector_kernel() {
  %2 = index.constant 1 : index
  kernel.launch.config workgroups(%2, %2, %2) workgroup_size(%2, %2, %2) : index
} launch(%input: buffer, %output: buffer) {
  %18 = index.constant 1 : index
  %12 = buffer.view %input[%18] : buffer -> view<4xi32, align(1)>
  %value = vector.load<root_in_bounds> %12[0] : view<4xi32, align(1)> -> vector<4xi32>
  %16 = buffer.view %output[%18] : buffer -> view<4xi32, align(1)>
  vector.store<root_in_bounds> %value, %16[0] : vector<4xi32>, view<4xi32, align(1)>
  kernel.return
}

// ====
// RUN: pass canonicalize,cse,dce
// Nested array decays retain reduced alignment. Each side-effecting index
// in a compound assignment is evaluated once, including reversed subscripting.
struct [[gnu::packed]] ArrayPacket {
  // The two-dimensional array starts at a byte-aligned origin.
  unsigned char tag;
  // Each projection retains the enclosing record's reduced alignment.
  unsigned values[2][3];
};
static_assert(sizeof(ArrayPacket) == 25 && alignof(ArrayPacket) == 1);

void packed_array_copy(const ArrayPacket* input, volatile ArrayPacket* output,
                       unsigned* observations) {
  for (unsigned row = 0; row < 2; ++row) {
    for (unsigned column = 0; column < 3; ++column) {
      output->values[row][column] = input->values[row][column];
    }
  }
  unsigned object = 0, row = 0, column = 0;
  output[object++].values[row++][column++] += 1u;
  unsigned reverse = 0;
  (reverse++)[output[0].values[1]] += 2u;
  observations[0] = object;
  observations[1] = row;
  observations[2] = column;
  observations[3] = reverse;
}

[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void packed_array_kernel(const ArrayPacket* input, volatile ArrayPacket* output,
                         unsigned* observations) {
  packed_array_copy(input, output, observations);
}
// ----
func.def public @packed_array_copy(%input: buffer, %input_byte_offset: index, %output: buffer, %output_byte_offset: index, %observations: buffer, %observations_byte_offset: index) {
  %154 = index.constant 0 : offset
  %153 = index.constant 2 : offset
  %10 = index.constant 1 : offset
  scf.for %row = [%154 to %153 step %10] {
    %12 = index.cast %row : offset to i32
    %151 = index.constant 3 : offset
    scf.for %column = [%154 to %151 step %10] {
      %19 = index.cast %column : offset to i32
      %20 = index.constant 1 : index
      %values_byte_offset$21 = index.add %input_byte_offset, %20 : index
      %22 = scalar.extui %12 : i32 to i64
      %23 = index.cast %22 : i64 to index
      %24 = index.constant 12 : index
      %158 = index.madd %23, %24, %values_byte_offset$21 : index
      %27 = scalar.extui %19 : i32 to i64
      %28 = index.cast %27 : i64 to index
      %29 = index.constant 4 : index
      %157 = index.madd %28, %29, %158 : index
      %32 = buffer.view %input[%157] : buffer -> view<1xi32, align(1)>
      %33 = view.load<root_in_bounds|type_disjoint> %32[0] : view<1xi32, align(1)> -> i32
      %values_byte_offset$35 = index.add %output_byte_offset, %20 : index
      %156 = index.madd %23, %24, %values_byte_offset$35 : index
      %155 = index.madd %28, %29, %156 : index
      %46 = buffer.view %output[%155] : buffer -> view<1xi32, align(1)>
      view.store<volatile|root_in_bounds|type_disjoint> %33, %46[0] : i32, view<1xi32, align(1)>
    }
  }
  %50 = scalar.constant 1 : i32
  %58 = index.constant 1 : index
  %values_byte_offset = index.add %output_byte_offset, %58 : index
  %74 = buffer.view %output[%values_byte_offset] : buffer -> view<1xi32, align(1)>
  %75 = view.load<volatile|root_in_bounds|type_disjoint> %74[0] : view<1xi32, align(1)> -> i32
  %76 = scalar.addi %75, %50 : i32
  view.store<volatile|root_in_bounds|type_disjoint> %76, %74[0] : i32, view<1xi32, align(1)>
  %78 = scalar.constant 2 : i32
  %142 = index.constant 12 : index
  %92 = index.add %values_byte_offset, %142 : index
  %98 = buffer.view %output[%92] : buffer -> view<1xi32, align(1)>
  %99 = view.load<volatile|root_in_bounds|type_disjoint> %98[0] : view<1xi32, align(1)> -> i32
  %100 = scalar.addi %99, %78 : i32
  view.store<volatile|root_in_bounds|type_disjoint> %100, %98[0] : i32, view<1xi32, align(1)>
  %106 = buffer.view %observations[%observations_byte_offset] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %50, %106[0] : i32, view<1xi32>
  %139 = index.constant 4 : index
  %111 = index.add %observations_byte_offset, %139 : index
  %112 = buffer.view %observations[%111] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %50, %112[0] : i32, view<1xi32>
  %138 = index.constant 8 : index
  %117 = index.add %observations_byte_offset, %138 : index
  %118 = buffer.view %observations[%117] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %50, %118[0] : i32, view<1xi32>
  %123 = index.add %observations_byte_offset, %142 : index
  %124 = buffer.view %observations[%123] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %50, %124[0] : i32, view<1xi32>
  func.return
}

kernel.def @packed_array_kernel() {
  %128 = index.constant 1 : index
  kernel.launch.config workgroups(%128, %128, %128) workgroup_size(%128, %128, %128) : index
} launch(%input: buffer, %output: buffer, %observations: buffer) {
  %input_byte_offset = index.constant 0 : index
  func.call @packed_array_copy(%input, %input_byte_offset, %output, %input_byte_offset, %observations, %input_byte_offset) : (buffer, index, buffer, index, buffer, index)
  kernel.return
}
