  view.store<volatile> %82, %91[0] : i32, view<1xi32>
  %92 = scalar.constant 5 : i32
  %103 = view.load<volatile> %91[0] : view<1xi32> -> i32
  %result = scalar.ori %103, %92 : i32
  view.store<volatile> %result, %91[0] : i32, view<1xi32>
  %144 = scalar.constant 200 : i32
  %107 = scalar.addi %result, %144 : i32
  func.return %107 : i32
}

func.def @increment_storage_volatile_unsigned_int(%words: buffer, %words_byte_offset$109: offset) -> (i32) {
  %147 = scalar.constant 4 : i64
  %115 = index.cast %words_byte_offset$109 : offset to i64
  %116 = scalar.addi %115, %147 : i64
  %117 = scalar.assume %116 [range(%116, 0, 9223372036854775807)] : i64
  %words_byte_offset$118 = index.cast %117 : i64 to offset
  %119 = buffer.view %words[%words_byte_offset$109] : buffer -> view<1xi32>
  %previous = view.load<volatile> %119[0] : view<1xi32> -> i32
  %121 = scalar.constant 1 : i32
  %122 = scalar.addi %previous, %121 : i32
  view.store<volatile> %122, %119[0] : i32, view<1xi32>
  %127 = index.cast %words_byte_offset$118 : offset to i64
  %129 = scalar.assume %127 [range(%127, 0, 9223372036854775807)] : i64
  %130 = index.cast %129 : i64 to offset
  %131 = buffer.view %words[%130] : buffer -> view<1xi32>
  %132 = view.load<volatile> %131[0] : view<1xi32> -> i32
  %next = scalar.addi %132, %121 : i32
  view.store<volatile> %next, %131[0] : i32, view<1xi32>
  %135 = scalar.constant 100 : i32
  %136 = scalar.muli %135, %next : i32
  %137 = scalar.addi %previous, %136 : i32
  func.return %137 : i32
}

// ====
// RUN: pass canonicalize,cse,dce
// Byte compound results are converted to the stored type before becoming
// expression values, and post-increment returns the previous byte.
unsigned storage_bytes(unsigned char* bytes) {
  bytes[1] = 255;
  bytes[2] = 1;
  unsigned previous = bytes[1]++;
  unsigned assigned = bytes[2] += 258u;
  return previous + 100 * assigned;
}

[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void storage_bytes_kernel(unsigned char* bytes, unsigned* output) {
  output[1] = storage_bytes(bytes);
}
// ----
func.def public @storage_bytes(%bytes: buffer, %bytes_byte_offset: offset) -> (i32) {
  %83 = scalar.constant -1 : i8
  %82 = scalar.constant 1 : i64
  %9 = index.cast %bytes_byte_offset : offset to i64
  %10 = scalar.addi %9, %82 : i64
  %11 = scalar.assume %10 [range(%10, 0, 9223372036854775807)] : i64
  %12 = index.cast %11 : i64 to offset
  %13 = buffer.view %bytes[%12] : buffer -> view<1xi8>
  view.store %83, %13[0] : i8, view<1xi8>
  %81 = scalar.constant 1 : i8
  %80 = scalar.constant 2 : i64
  %21 = scalar.addi %9, %80 : i64
  %22 = scalar.assume %21 [range(%21, 0, 9223372036854775807)] : i64
  %23 = index.cast %22 : i64 to offset
  %24 = buffer.view %bytes[%23] : buffer -> view<1xi8>
  view.store %81, %24[0] : i8, view<1xi8>
  %34 = view.load %13[0] : view<1xi8> -> i8
  %35 = scalar.extui %34 : i8 to i32
  %36 = scalar.constant 1 : i32
  %37 = scalar.addi %35, %36 : i32
  %38 = scalar.trunci %37 : i32 to i8
  view.store %38, %13[0] : i8, view<1xi8>
  %40 = scalar.constant 258 : i32
  %50 = view.load %24[0] : view<1xi8> -> i8
  %51 = scalar.extui %50 : i8 to i32
  %52 = scalar.addi %51, %40 : i32
  %53 = scalar.trunci %52 : i32 to i8
  view.store %53, %24[0] : i8, view<1xi8>
  %assigned = scalar.extui %53 : i8 to i32
  %55 = scalar.constant 100 : i32
  %56 = scalar.muli %55, %assigned : i32
  %57 = scalar.addi %35, %56 : i32
  func.return %57 : i32
}

kernel.def @storage_bytes_kernel() {
  %60 = index.constant 1 : index
  kernel.launch.config workgroups(%60, %60, %60) workgroup_size(%60, %60, %60) : index
} launch(%bytes: buffer, %output: buffer) {
  %bytes_byte_offset = index.constant 0 : offset
  %68 = func.call @storage_bytes(%bytes, %bytes_byte_offset) : (buffer, offset) -> (i32)
  %84 = index.constant 4 : offset
  %77 = buffer.view %output[%84] : buffer -> view<1xi32>
  view.store %68, %77[0] : i32, view<1xi32>
  kernel.return
}

// ====
// RUN: pass canonicalize,cse,dce
// Signed-byte updates truncate before sign extension; the shift uses
// the promoted signed left operand despite an unsigned wide shift count.
int storage_signed(signed char* bytes) {
  bytes[1] = -127;
  bytes[2] = 125;
  int first = bytes[1] -= 2;
  int second = bytes[2] += -250;
  bytes[1] >>= 1ull;
  --bytes[2];
  return first + 100 * second;
}

[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void storage_signed_kernel(signed char* bytes, int* output) {
  output[1] = storage_signed(bytes);
}
// ----
func.def public @storage_signed(%bytes: buffer, %bytes_byte_offset: offset) -> (i32) {
  %124 = scalar.constant -127 : i8
  %123 = scalar.constant 1 : i64
  %11 = index.cast %bytes_byte_offset : offset to i64
  %12 = scalar.addi %11, %123 : i64
  %13 = scalar.assume %12 [range(%12, 0, 9223372036854775807)] : i64
  %14 = index.cast %13 : i64 to offset
  %15 = buffer.view %bytes[%14] : buffer -> view<1xi8>
  view.store %124, %15[0] : i8, view<1xi8>
  %122 = scalar.constant 125 : i8
  %121 = scalar.constant 2 : i64
  %23 = scalar.addi %11, %121 : i64
  %24 = scalar.assume %23 [range(%23, 0, 9223372036854775807)] : i64
  %25 = index.cast %24 : i64 to offset
  %26 = buffer.view %bytes[%25] : buffer -> view<1xi8>
  view.store %122, %26[0] : i8, view<1xi8>
  %37 = view.load %15[0] : view<1xi8> -> i8
  %38 = scalar.extsi %37 : i8 to i32
  %118 = scalar.constant -2 : i32
  %119 = scalar.addi %38, %118 : i32
  %40 = scalar.trunci %119 : i32 to i8
  view.store %40, %15[0] : i8, view<1xi8>
  %first = scalar.extsi %40 : i8 to i32
  %117 = scalar.constant -250 : i32
  %54 = view.load %26[0] : view<1xi8> -> i8
  %55 = scalar.extsi %54 : i8 to i32
  %56 = scalar.addi %55, %117 : i32
  %57 = scalar.trunci %56 : i32 to i8
  view.store %57, %26[0] : i8, view<1xi8>
  %second = scalar.extsi %57 : i8 to i32
  %69 = view.load %15[0] : view<1xi8> -> i8
  %70 = scalar.extsi %69 : i8 to i32
  %114 = scalar.constant 1 : i32
  %72 = scalar.shrsi %70, %114 : i32
  %73 = scalar.trunci %72 : i32 to i8
  view.store %73, %15[0] : i8, view<1xi8>
  %83 = view.load %26[0] : view<1xi8> -> i8
  %84 = scalar.extsi %83 : i8 to i32
  %111 = scalar.constant -1 : i32
  %112 = scalar.addi %84, %111 : i32
  %87 = scalar.trunci %112 : i32 to i8
  view.store %87, %26[0] : i8, view<1xi8>
  %88 = scalar.constant 100 : i32
  %89 = scalar.muli %88, %second : i32
  %90 = scalar.addi %first, %89 : i32
  func.return %90 : i32
}

kernel.def @storage_signed_kernel() {
  %93 = index.constant 1 : index
  kernel.launch.config workgroups(%93, %93, %93) workgroup_size(%93, %93, %93) : index
} launch(%bytes: buffer, %output: buffer) {
  %bytes_byte_offset = index.constant 0 : offset
  %101 = func.call @storage_signed(%bytes, %bytes_byte_offset) : (buffer, offset) -> (i32)
  %125 = index.constant 4 : offset
  %110 = buffer.view %output[%125] : buffer -> view<1xi32>
  view.store %101, %110[0] : i32, view<1xi32>
