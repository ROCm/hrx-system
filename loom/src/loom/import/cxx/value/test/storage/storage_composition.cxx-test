// RUN: pass canonicalize,cse,dce
// Compound updates through specialized helpers preserve RHS-before-LHS
// order and independently weighted observations of prefix/postfix effects.
template <class Word>
static unsigned bitmap_update(Word* words, unsigned index, unsigned mask) {
  return words[index] |= mask;
}

template <class Word>
static unsigned sequenced_update(Word* words) {
  unsigned index = 0;
  // The RHS writes element one before the LHS selects and updates it once.
  unsigned result = words[index++] |= (index = 1, words[1] = 32, 5);
  return result + 100 * index;
}

template <class Word>
static unsigned increment_storage(Word* words) {
  unsigned previous = (*words++)++;
  unsigned next = ++words[0];
  return previous + 100 * next;
}

template <class Word>
static unsigned update_words(Word* words) {
  words[1] = 7;
  words[2] = 11;
  unsigned bitmap = bitmap_update(words, 1, 8);
  unsigned sequenced = sequenced_update(words);
  unsigned increments = increment_storage(words + 1);
  return bitmap + sequenced + increments;
}

unsigned storage_words(unsigned* words) { return update_words(words); }

[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void storage_words_kernel(unsigned* words, unsigned* output) {
  output[1] = storage_words(words);
}
// ----
func.def public @storage_words(%words: buffer, %words_byte_offset: index) -> (i32) {
  %3 = func.call @update_words_unsigned_int(%words, %words_byte_offset) : (buffer, index) -> (i32)
  func.return %3 : i32
}

kernel.def @storage_words_kernel() {
  %6 = index.constant 1 : index
  kernel.launch.config workgroups(%6, %6, %6) workgroup_size(%6, %6, %6) : index
} launch(%words: buffer, %output: buffer) {
  %words_byte_offset = index.constant 0 : index
  %14 = func.call @storage_words(%words, %words_byte_offset) : (buffer, index) -> (i32)
  %113 = index.constant 4 : index
  %20 = buffer.view %output[%113] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %14, %20[0] : i32, view<1xi32>
  kernel.return
}

func.def @update_words_unsigned_int(%words: buffer, %words_byte_offset: index) -> (i32) {
  %24 = scalar.constant 7 : i32
  %118 = index.constant 4 : index
  %29 = index.add %words_byte_offset, %118 : index
  %30 = buffer.view %words[%29] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %24, %30[0] : i32, view<1xi32>
  %31 = scalar.constant 11 : i32
  %116 = index.constant 8 : index
  %117 = index.add %words_byte_offset, %116 : index
  %37 = buffer.view %words[%117] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %31, %37[0] : i32, view<1xi32>
  %38 = scalar.constant 1 : i32
  %39 = scalar.constant 8 : i32
  %bitmap = func.call @bitmap_update_unsigned_int(%words, %words_byte_offset, %38, %39) : (buffer, index, i32, i32) -> (i32)
  %sequenced = func.call @sequenced_update_unsigned_int(%words, %words_byte_offset) : (buffer, index) -> (i32)
  %increments = func.call @increment_storage_unsigned_int(%words, %29) : (buffer, index) -> (i32)
  %48 = scalar.addi %bitmap, %sequenced : i32
  %49 = scalar.addi %48, %increments : i32
  func.return %49 : i32
}

func.def @bitmap_update_unsigned_int(%words: buffer, %words_byte_offset: index, %index: i32, %mask: i32) -> (i32) {
  %55 = scalar.extui %index : i32 to i64
  %56 = index.cast %55 : i64 to index
  %57 = index.constant 4 : index
  %119 = index.madd %56, %57, %words_byte_offset : index
  %60 = buffer.view %words[%119] : buffer -> view<1xi32>
  %61 = view.load<root_in_bounds|type_disjoint> %60[0] : view<1xi32> -> i32
  %62 = scalar.ori %61, %mask : i32
  view.store<root_in_bounds|type_disjoint> %62, %60[0] : i32, view<1xi32>
  func.return %62 : i32
}

func.def @sequenced_update_unsigned_int(%words: buffer, %words_byte_offset: index) -> (i32) {
  %68 = scalar.constant 32 : i32
  %122 = index.constant 4 : index
  %73 = index.add %words_byte_offset, %122 : index
  %74 = buffer.view %words[%73] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %68, %74[0] : i32, view<1xi32>
  %75 = scalar.constant 5 : i32
  %84 = view.load<root_in_bounds|type_disjoint> %74[0] : view<1xi32> -> i32
  %result = scalar.ori %84, %75 : i32
  view.store<root_in_bounds|type_disjoint> %result, %74[0] : i32, view<1xi32>
  %120 = scalar.constant 200 : i32
  %88 = scalar.addi %result, %120 : i32
  func.return %88 : i32
}

func.def @increment_storage_unsigned_int(%words: buffer, %words_byte_offset$90: index) -> (i32) {
  %123 = index.constant 4 : index
  %words_byte_offset$96 = index.add %words_byte_offset$90, %123 : index
  %97 = buffer.view %words[%words_byte_offset$90] : buffer -> view<1xi32>
  %previous = view.load<root_in_bounds|type_disjoint> %97[0] : view<1xi32> -> i32
  %99 = scalar.constant 1 : i32
  %100 = scalar.addi %previous, %99 : i32
  view.store<root_in_bounds|type_disjoint> %100, %97[0] : i32, view<1xi32>
  %106 = buffer.view %words[%words_byte_offset$96] : buffer -> view<1xi32>
  %107 = view.load<root_in_bounds|type_disjoint> %106[0] : view<1xi32> -> i32
  %next = scalar.addi %107, %99 : i32
  view.store<root_in_bounds|type_disjoint> %next, %106[0] : i32, view<1xi32>
  %110 = scalar.constant 100 : i32
  %111 = scalar.muli %110, %next : i32
  %112 = scalar.addi %previous, %111 : i32
  func.return %112 : i32
}

// ====
// RUN: pass canonicalize,cse,dce
// Volatile specialization retains each load and store across the same
// helper chain; the final value cannot replace the intermediate effects.
template <class Word>
static unsigned bitmap_update(Word* words, unsigned index, unsigned mask) {
  return words[index] |= mask;
}

template <class Word>
static unsigned sequenced_update(Word* words) {
  unsigned index = 0;
  // The RHS writes element one before the LHS selects and updates it once.
  unsigned result = words[index++] |= (index = 1, words[1] = 32, 5);
  return result + 100 * index;
}

template <class Word>
static unsigned increment_storage(Word* words) {
  unsigned previous = (*words++)++;
  unsigned next = ++words[0];
  return previous + 100 * next;
}

template <class Word>
static unsigned update_words(Word* words) {
  words[1] = 7;
  words[2] = 11;
  unsigned bitmap = bitmap_update(words, 1, 8);
  unsigned sequenced = sequenced_update(words);
  unsigned increments = increment_storage(words + 1);
  return bitmap + sequenced + increments;
}

unsigned storage_volatile(volatile unsigned* words) {
  return update_words(words);
}

[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void storage_volatile_kernel(volatile unsigned* words, unsigned* output) {
  output[1] = storage_volatile(words);
}
// ----
func.def public @storage_volatile(%words: buffer, %words_byte_offset: index) -> (i32) {
  %3 = func.call @update_words_volatile_unsigned_int(%words, %words_byte_offset) : (buffer, index) -> (i32)
  func.return %3 : i32
}

kernel.def @storage_volatile_kernel() {
  %6 = index.constant 1 : index
  kernel.launch.config workgroups(%6, %6, %6) workgroup_size(%6, %6, %6) : index
} launch(%words: buffer, %output: buffer) {
  %words_byte_offset = index.constant 0 : index
  %14 = func.call @storage_volatile(%words, %words_byte_offset) : (buffer, index) -> (i32)
  %113 = index.constant 4 : index
  %20 = buffer.view %output[%113] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %14, %20[0] : i32, view<1xi32>
  kernel.return
}

func.def @update_words_volatile_unsigned_int(%words: buffer, %words_byte_offset: index) -> (i32) {
  %24 = scalar.constant 7 : i32
  %118 = index.constant 4 : index
  %29 = index.add %words_byte_offset, %118 : index
  %30 = buffer.view %words[%29] : buffer -> view<1xi32>
  view.store<volatile|root_in_bounds|type_disjoint> %24, %30[0] : i32, view<1xi32>
  %31 = scalar.constant 11 : i32
  %116 = index.constant 8 : index
  %117 = index.add %words_byte_offset, %116 : index
  %37 = buffer.view %words[%117] : buffer -> view<1xi32>
  view.store<volatile|root_in_bounds|type_disjoint> %31, %37[0] : i32, view<1xi32>
  %38 = scalar.constant 1 : i32
  %39 = scalar.constant 8 : i32
  %bitmap = func.call @bitmap_update_volatile_unsigned_int(%words, %words_byte_offset, %38, %39) : (buffer, index, i32, i32) -> (i32)
  %sequenced = func.call @sequenced_update_volatile_unsigned_int(%words, %words_byte_offset) : (buffer, index) -> (i32)
  %increments = func.call @increment_storage_volatile_unsigned_int(%words, %29) : (buffer, index) -> (i32)
  %48 = scalar.addi %bitmap, %sequenced : i32
  %49 = scalar.addi %48, %increments : i32
  func.return %49 : i32
}

func.def @bitmap_update_volatile_unsigned_int(%words: buffer, %words_byte_offset: index, %index: i32, %mask: i32) -> (i32) {
  %55 = scalar.extui %index : i32 to i64
  %56 = index.cast %55 : i64 to index
  %57 = index.constant 4 : index
  %119 = index.madd %56, %57, %words_byte_offset : index
  %60 = buffer.view %words[%119] : buffer -> view<1xi32>
  %61 = view.load<volatile|root_in_bounds|type_disjoint> %60[0] : view<1xi32> -> i32
  %62 = scalar.ori %61, %mask : i32
  view.store<volatile|root_in_bounds|type_disjoint> %62, %60[0] : i32, view<1xi32>
  func.return %62 : i32
}

func.def @sequenced_update_volatile_unsigned_int(%words: buffer, %words_byte_offset: index) -> (i32) {
  %68 = scalar.constant 32 : i32
  %122 = index.constant 4 : index
  %73 = index.add %words_byte_offset, %122 : index
  %74 = buffer.view %words[%73] : buffer -> view<1xi32>
  view.store<volatile|root_in_bounds|type_disjoint> %68, %74[0] : i32, view<1xi32>
  %75 = scalar.constant 5 : i32
  %84 = view.load<volatile|root_in_bounds|type_disjoint> %74[0] : view<1xi32> -> i32
  %result = scalar.ori %84, %75 : i32
  view.store<volatile|root_in_bounds|type_disjoint> %result, %74[0] : i32, view<1xi32>
  %120 = scalar.constant 200 : i32
  %88 = scalar.addi %result, %120 : i32
  func.return %88 : i32
}

func.def @increment_storage_volatile_unsigned_int(%words: buffer, %words_byte_offset$90: index) -> (i32) {
  %123 = index.constant 4 : index
  %words_byte_offset$96 = index.add %words_byte_offset$90, %123 : index
  %97 = buffer.view %words[%words_byte_offset$90] : buffer -> view<1xi32>
  %previous = view.load<volatile|root_in_bounds|type_disjoint> %97[0] : view<1xi32> -> i32
  %99 = scalar.constant 1 : i32
  %100 = scalar.addi %previous, %99 : i32
  view.store<volatile|root_in_bounds|type_disjoint> %100, %97[0] : i32, view<1xi32>
  %106 = buffer.view %words[%words_byte_offset$96] : buffer -> view<1xi32>
  %107 = view.load<volatile|root_in_bounds|type_disjoint> %106[0] : view<1xi32> -> i32
  %next = scalar.addi %107, %99 : i32
  view.store<volatile|root_in_bounds|type_disjoint> %next, %106[0] : i32, view<1xi32>
  %110 = scalar.constant 100 : i32
  %111 = scalar.muli %110, %next : i32
  %112 = scalar.addi %previous, %111 : i32
  func.return %112 : i32
}

// ====
// RUN: pass canonicalize,cse,dce
// Byte compound results are converted to the stored type before becoming
// expression values, and post-increment returns the previous byte.
unsigned storage_bytes(unsigned char* bytes) {
  bytes[1] = 255;
  bytes[2] = 1;
  unsigned previous = bytes[1]++;
  unsigned assigned = bytes[2] += 258u;
  return previous + 100 * assigned;
}

[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void storage_bytes_kernel(unsigned char* bytes, unsigned* output) {
  output[1] = storage_bytes(bytes);
}
// ----
func.def public @storage_bytes(%bytes: buffer, %bytes_byte_offset: index) -> (i32) {
  %72 = scalar.constant -1 : i8
  %71 = index.constant 1 : index
  %9 = index.add %bytes_byte_offset, %71 : index
  %10 = buffer.view %bytes[%9] : buffer -> view<1xi8>
  view.store<root_in_bounds> %72, %10[0] : i8, view<1xi8>
  %70 = scalar.constant 1 : i8
  %69 = index.constant 2 : index
  %68 = index.add %bytes_byte_offset, %69 : index
  %18 = buffer.view %bytes[%68] : buffer -> view<1xi8>
  view.store<root_in_bounds> %70, %18[0] : i8, view<1xi8>
  %25 = view.load<root_in_bounds> %10[0] : view<1xi8> -> i8
  %26 = scalar.extui %25 : i8 to i32
  %27 = scalar.constant 1 : i32
  %28 = scalar.addi %26, %27 : i32
  %29 = scalar.trunci %28 : i32 to i8
  view.store<root_in_bounds> %29, %10[0] : i8, view<1xi8>
  %31 = scalar.constant 258 : i32
  %38 = view.load<root_in_bounds> %18[0] : view<1xi8> -> i8
  %39 = scalar.extui %38 : i8 to i32
  %40 = scalar.addi %39, %31 : i32
  %41 = scalar.trunci %40 : i32 to i8
  view.store<root_in_bounds> %41, %18[0] : i8, view<1xi8>
  %assigned = scalar.extui %41 : i8 to i32
  %43 = scalar.constant 100 : i32
  %44 = scalar.muli %43, %assigned : i32
  %45 = scalar.addi %26, %44 : i32
  func.return %45 : i32
}

kernel.def @storage_bytes_kernel() {
  %48 = index.constant 1 : index
  kernel.launch.config workgroups(%48, %48, %48) workgroup_size(%48, %48, %48) : index
} launch(%bytes: buffer, %output: buffer) {
  %bytes_byte_offset = index.constant 0 : index
  %56 = func.call @storage_bytes(%bytes, %bytes_byte_offset) : (buffer, index) -> (i32)
  %73 = index.constant 4 : index
  %62 = buffer.view %output[%73] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %56, %62[0] : i32, view<1xi32>
  kernel.return
}

// ====
// RUN: pass canonicalize,cse,dce
// Signed-byte updates truncate before sign extension; the shift uses
// the promoted signed left operand despite an unsigned wide shift count.
int storage_signed(signed char* bytes) {
  bytes[1] = -127;
  bytes[2] = 125;
  int first = bytes[1] -= 2;
  int second = bytes[2] += -250;
  bytes[1] >>= 1ull;
  --bytes[2];
  return first + 100 * second;
}

[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void storage_signed_kernel(signed char* bytes, int* output) {
  output[1] = storage_signed(bytes);
}
// ----
func.def public @storage_signed(%bytes: buffer, %bytes_byte_offset: index) -> (i32) {
  %109 = scalar.constant -127 : i8
  %108 = index.constant 1 : index
  %11 = index.add %bytes_byte_offset, %108 : index
  %12 = buffer.view %bytes[%11] : buffer -> view<1xi8>
  view.store<root_in_bounds|type_disjoint> %109, %12[0] : i8, view<1xi8>
  %107 = scalar.constant 125 : i8
  %106 = index.constant 2 : index
  %105 = index.add %bytes_byte_offset, %106 : index
  %20 = buffer.view %bytes[%105] : buffer -> view<1xi8>
  view.store<root_in_bounds|type_disjoint> %107, %20[0] : i8, view<1xi8>
  %28 = view.load<root_in_bounds|type_disjoint> %12[0] : view<1xi8> -> i8
  %29 = scalar.extsi %28 : i8 to i32
  %101 = scalar.constant -2 : i32
  %102 = scalar.addi %29, %101 : i32
  %31 = scalar.trunci %102 : i32 to i8
  view.store<root_in_bounds|type_disjoint> %31, %12[0] : i8, view<1xi8>
  %first = scalar.extsi %31 : i8 to i32
  %100 = scalar.constant -250 : i32
  %42 = view.load<root_in_bounds|type_disjoint> %20[0] : view<1xi8> -> i8
  %43 = scalar.extsi %42 : i8 to i32
  %44 = scalar.addi %43, %100 : i32
  %45 = scalar.trunci %44 : i32 to i8
  view.store<root_in_bounds|type_disjoint> %45, %20[0] : i8, view<1xi8>
  %second = scalar.extsi %45 : i8 to i32
  %54 = view.load<root_in_bounds|type_disjoint> %12[0] : view<1xi8> -> i8
  %55 = scalar.extsi %54 : i8 to i32
  %95 = scalar.constant 1 : i32
  %57 = scalar.shrsi %55, %95 : i32
  %58 = scalar.trunci %57 : i32 to i8
  view.store<root_in_bounds|type_disjoint> %58, %12[0] : i8, view<1xi8>
  %65 = view.load<root_in_bounds|type_disjoint> %20[0] : view<1xi8> -> i8
  %66 = scalar.extsi %65 : i8 to i32
  %90 = scalar.constant -1 : i32
  %91 = scalar.addi %66, %90 : i32
  %69 = scalar.trunci %91 : i32 to i8
  view.store<root_in_bounds|type_disjoint> %69, %20[0] : i8, view<1xi8>
  %70 = scalar.constant 100 : i32
  %71 = scalar.muli %70, %second : i32
  %72 = scalar.addi %first, %71 : i32
  func.return %72 : i32
}

kernel.def @storage_signed_kernel() {
  %75 = index.constant 1 : index
  kernel.launch.config workgroups(%75, %75, %75) workgroup_size(%75, %75, %75) : index
} launch(%bytes: buffer, %output: buffer) {
  %bytes_byte_offset = index.constant 0 : index
  %83 = func.call @storage_signed(%bytes, %bytes_byte_offset) : (buffer, index) -> (i32)
  %110 = index.constant 4 : index
  %89 = buffer.view %output[%110] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %83, %89[0] : i32, view<1xi32>
  kernel.return
}

// ====
// RUN: pass canonicalize,cse,dce
// Signed byte division truncates toward zero and returns the converted
// stored value, not an unsigned quotient.
int storage_divide(signed char* bytes) {
  bytes[1] = -125;
  return bytes[1] /= 3;
}
// ----
func.def public @storage_divide(%bytes: buffer, %bytes_byte_offset: index) -> (i32) {
  %27 = scalar.constant -125 : i8
  %26 = index.constant 1 : index
  %11 = index.add %bytes_byte_offset, %26 : index
  %12 = buffer.view %bytes[%11] : buffer -> view<1xi8>
  view.store<root_in_bounds|type_disjoint> %27, %12[0] : i8, view<1xi8>
  %13 = scalar.constant 3 : i32
  %20 = view.load<root_in_bounds|type_disjoint> %12[0] : view<1xi8> -> i8
  %21 = scalar.extsi %20 : i8 to i32
  %22 = scalar.divsi %21, %13 : i32
  %23 = scalar.trunci %22 : i32 to i8
  view.store<root_in_bounds|type_disjoint> %23, %12[0] : i8, view<1xi8>
  %24 = scalar.extsi %23 : i8 to i32
  func.return %24 : i32
}

// ====
// RUN: pass canonicalize,cse,dce
// Floating compound results retain their value before later mutations
// of the same storage, and integer RHS values convert to floating point.
float storage_floats(float* values) {
  values[1] = 1.5f;
  values[2] = -3.0f;
  float first = values[1] *= 2;
  float second = values[2] /= 2;
  values[1] += 0.25f;
  values[2] -= 0.5f;
  return first + second;
}

[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void storage_floats_kernel(float* values, float* output) {
  output[1] = storage_floats(values);
}
// ----
func.def public @storage_floats(%values: buffer, %values_byte_offset: index) -> (f32) {
  %3 = scalar.constant 1.5 : f32
  %88 = index.constant 4 : index
  %8 = index.add %values_byte_offset, %88 : index
  %9 = buffer.view %values[%8] : buffer -> view<1xf32>
  view.store<root_in_bounds|type_disjoint> %3, %9[0] : f32, view<1xf32>
  %87 = scalar.constant -3.0 : f32
  %85 = index.constant 8 : index
  %86 = index.add %values_byte_offset, %85 : index
  %17 = buffer.view %values[%86] : buffer -> view<1xf32>
  view.store<root_in_bounds|type_disjoint> %87, %17[0] : f32, view<1xf32>
  %83 = scalar.constant 2.0 : f32
  %26 = view.load<root_in_bounds|type_disjoint> %9[0] : view<1xf32> -> f32
  %first = scalar.mulf %26, %83 : f32
  view.store<root_in_bounds|type_disjoint> %first, %9[0] : f32, view<1xf32>
  %36 = view.load<root_in_bounds|type_disjoint> %17[0] : view<1xf32> -> f32
  %second = scalar.divf %36, %83 : f32
  view.store<root_in_bounds|type_disjoint> %second, %17[0] : f32, view<1xf32>
  %38 = scalar.constant 0.25 : f32
  %45 = view.load<root_in_bounds|type_disjoint> %9[0] : view<1xf32> -> f32
  %46 = scalar.addf %45, %38 : f32
  view.store<root_in_bounds|type_disjoint> %46, %9[0] : f32, view<1xf32>
  %47 = scalar.constant 0.5 : f32
  %54 = view.load<root_in_bounds|type_disjoint> %17[0] : view<1xf32> -> f32
  %55 = scalar.subf %54, %47 : f32
  view.store<root_in_bounds|type_disjoint> %55, %17[0] : f32, view<1xf32>
  %56 = scalar.addf %first, %second : f32
  func.return %56 : f32
}

kernel.def @storage_floats_kernel() {
  %59 = index.constant 1 : index
  kernel.launch.config workgroups(%59, %59, %59) workgroup_size(%59, %59, %59) : index
} launch(%values: buffer, %output: buffer) {
  %values_byte_offset = index.constant 0 : index
  %67 = func.call @storage_floats(%values, %values_byte_offset) : (buffer, index) -> (f32)
  %89 = index.constant 4 : index
  %73 = buffer.view %output[%89] : buffer -> view<1xf32>
  view.store<root_in_bounds|type_disjoint> %67, %73[0] : f32, view<1xf32>
  kernel.return
}
