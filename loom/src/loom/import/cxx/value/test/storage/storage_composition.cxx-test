// RUN: pass canonicalize,cse,dce
// Compound updates through specialized helpers preserve RHS-before-LHS
// order and independently weighted observations of prefix/postfix effects.
template <class Word>
static unsigned bitmap_update(Word* words, unsigned index, unsigned mask) {
  return words[index] |= mask;
}

template <class Word>
static unsigned sequenced_update(Word* words) {
  unsigned index = 0;
  // The RHS writes element one before the LHS selects and updates it once.
  unsigned result = words[index++] |= (index = 1, words[1] = 32, 5);
  return result + 100 * index;
}

template <class Word>
static unsigned increment_storage(Word* words) {
  unsigned previous = (*words++)++;
  unsigned next = ++words[0];
  return previous + 100 * next;
}

template <class Word>
static unsigned update_words(Word* words) {
  words[1] = 7;
  words[2] = 11;
  unsigned bitmap = bitmap_update(words, 1, 8);
  unsigned sequenced = sequenced_update(words);
  unsigned increments = increment_storage(words + 1);
  return bitmap + sequenced + increments;
}

unsigned storage_words(unsigned* words) { return update_words(words); }

[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void storage_words_kernel(unsigned* words, unsigned* output) {
  output[1] = storage_words(words);
}
// ----
func.def public @storage_words(%words: buffer, %words_byte_offset: offset) -> (i32) {
  %3 = func.call @update_words_unsigned_int(%words, %words_byte_offset) : (buffer, offset) -> (i32)
  func.return %3 : i32
}

kernel.def @storage_words_kernel() {
  %6 = index.constant 1 : index
  kernel.launch.config workgroups(%6, %6, %6) workgroup_size(%6, %6, %6) : index
} launch(%words: buffer, %output: buffer) {
  %words_byte_offset = index.constant 0 : offset
  %14 = func.call @storage_words(%words, %words_byte_offset) : (buffer, offset) -> (i32)
  %138 = index.constant 4 : offset
  %23 = buffer.view %output[%138] : buffer -> view<1xi32>
  view.store %14, %23[0] : i32, view<1xi32>
  kernel.return
}

func.def @update_words_unsigned_int(%words: buffer, %words_byte_offset: offset) -> (i32) {
  %27 = scalar.constant 7 : i32
  %141 = scalar.constant 4 : i64
  %32 = index.cast %words_byte_offset : offset to i64
  %33 = scalar.addi %32, %141 : i64
  %34 = scalar.assume %33 [range(%33, 0, 9223372036854775807)] : i64
  %35 = index.cast %34 : i64 to offset
  %36 = buffer.view %words[%35] : buffer -> view<1xi32>
  view.store %27, %36[0] : i32, view<1xi32>
  %37 = scalar.constant 11 : i32
  %140 = scalar.constant 8 : i64
  %43 = scalar.addi %32, %140 : i64
  %44 = scalar.assume %43 [range(%43, 0, 9223372036854775807)] : i64
  %45 = index.cast %44 : i64 to offset
  %46 = buffer.view %words[%45] : buffer -> view<1xi32>
  view.store %37, %46[0] : i32, view<1xi32>
  %47 = scalar.constant 1 : i32
  %48 = scalar.constant 8 : i32
  %bitmap = func.call @bitmap_update_unsigned_int(%words, %words_byte_offset, %47, %48) : (buffer, offset, i32, i32) -> (i32)
  %sequenced = func.call @sequenced_update_unsigned_int(%words, %words_byte_offset) : (buffer, offset) -> (i32)
  %increments = func.call @increment_storage_unsigned_int(%words, %35) : (buffer, offset) -> (i32)
  %60 = scalar.addi %bitmap, %sequenced : i32
  %61 = scalar.addi %60, %increments : i32
  func.return %61 : i32
}

func.def @bitmap_update_unsigned_int(%words: buffer, %words_byte_offset: offset, %index: i32, %mask: i32) -> (i32) {
  %67 = scalar.extui %index : i32 to i64
  %142 = scalar.constant 2 : i64
  %143 = scalar.shli %67, %142 : i64
  %70 = index.cast %words_byte_offset : offset to i64
  %71 = scalar.addi %70, %143 : i64
  %72 = scalar.assume %71 [range(%71, 0, 9223372036854775807)] : i64
  %73 = index.cast %72 : i64 to offset
  %74 = buffer.view %words[%73] : buffer -> view<1xi32>
  %75 = view.load %74[0] : view<1xi32> -> i32
  %76 = scalar.ori %75, %mask : i32
  view.store %76, %74[0] : i32, view<1xi32>
  func.return %76 : i32
}

func.def @sequenced_update_unsigned_int(%words: buffer, %words_byte_offset: offset) -> (i32) {
  %82 = scalar.constant 32 : i32
  %146 = scalar.constant 4 : i64
  %87 = index.cast %words_byte_offset : offset to i64
  %88 = scalar.addi %87, %146 : i64
  %89 = scalar.assume %88 [range(%88, 0, 9223372036854775807)] : i64
  %90 = index.cast %89 : i64 to offset
  %91 = buffer.view %words[%90] : buffer -> view<1xi32>
  view.store %82, %91[0] : i32, view<1xi32>
  %92 = scalar.constant 5 : i32
  %103 = view.load %91[0] : view<1xi32> -> i32
  %result = scalar.ori %103, %92 : i32
  view.store %result, %91[0] : i32, view<1xi32>
  %144 = scalar.constant 200 : i32
  %107 = scalar.addi %result, %144 : i32
  func.return %107 : i32
}

func.def @increment_storage_unsigned_int(%words: buffer, %words_byte_offset$109: offset) -> (i32) {
  %147 = scalar.constant 4 : i64
  %115 = index.cast %words_byte_offset$109 : offset to i64
  %116 = scalar.addi %115, %147 : i64
  %117 = scalar.assume %116 [range(%116, 0, 9223372036854775807)] : i64
  %words_byte_offset$118 = index.cast %117 : i64 to offset
  %119 = buffer.view %words[%words_byte_offset$109] : buffer -> view<1xi32>
  %previous = view.load %119[0] : view<1xi32> -> i32
  %121 = scalar.constant 1 : i32
  %122 = scalar.addi %previous, %121 : i32
  view.store %122, %119[0] : i32, view<1xi32>
  %127 = index.cast %words_byte_offset$118 : offset to i64
  %129 = scalar.assume %127 [range(%127, 0, 9223372036854775807)] : i64
  %130 = index.cast %129 : i64 to offset
  %131 = buffer.view %words[%130] : buffer -> view<1xi32>
  %132 = view.load %131[0] : view<1xi32> -> i32
  %next = scalar.addi %132, %121 : i32
  view.store %next, %131[0] : i32, view<1xi32>
  %135 = scalar.constant 100 : i32
  %136 = scalar.muli %135, %next : i32
  %137 = scalar.addi %previous, %136 : i32
  func.return %137 : i32
}

// ====
// RUN: pass canonicalize,cse,dce
// Volatile specialization retains each load and store across the same
// helper chain; the final value cannot replace the intermediate effects.
template <class Word>
static unsigned bitmap_update(Word* words, unsigned index, unsigned mask) {
  return words[index] |= mask;
}

template <class Word>
static unsigned sequenced_update(Word* words) {
  unsigned index = 0;
  // The RHS writes element one before the LHS selects and updates it once.
  unsigned result = words[index++] |= (index = 1, words[1] = 32, 5);
  return result + 100 * index;
}

template <class Word>
static unsigned increment_storage(Word* words) {
  unsigned previous = (*words++)++;
  unsigned next = ++words[0];
  return previous + 100 * next;
}

template <class Word>
static unsigned update_words(Word* words) {
  words[1] = 7;
  words[2] = 11;
  unsigned bitmap = bitmap_update(words, 1, 8);
  unsigned sequenced = sequenced_update(words);
  unsigned increments = increment_storage(words + 1);
  return bitmap + sequenced + increments;
}

unsigned storage_volatile(volatile unsigned* words) {
  return update_words(words);
}

[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void storage_volatile_kernel(volatile unsigned* words, unsigned* output) {
  output[1] = storage_volatile(words);
}
// ----
func.def public @storage_volatile(%words: buffer, %words_byte_offset: offset) -> (i32) {
  %3 = func.call @update_words_volatile_unsigned_int(%words, %words_byte_offset) : (buffer, offset) -> (i32)
  func.return %3 : i32
}

kernel.def @storage_volatile_kernel() {
  %6 = index.constant 1 : index
  kernel.launch.config workgroups(%6, %6, %6) workgroup_size(%6, %6, %6) : index
} launch(%words: buffer, %output: buffer) {
  %words_byte_offset = index.constant 0 : offset
  %14 = func.call @storage_volatile(%words, %words_byte_offset) : (buffer, offset) -> (i32)
  %138 = index.constant 4 : offset
  %23 = buffer.view %output[%138] : buffer -> view<1xi32>
  view.store %14, %23[0] : i32, view<1xi32>
  kernel.return
}

func.def @update_words_volatile_unsigned_int(%words: buffer, %words_byte_offset: offset) -> (i32) {
  %27 = scalar.constant 7 : i32
  %141 = scalar.constant 4 : i64
  %32 = index.cast %words_byte_offset : offset to i64
  %33 = scalar.addi %32, %141 : i64
  %34 = scalar.assume %33 [range(%33, 0, 9223372036854775807)] : i64
  %35 = index.cast %34 : i64 to offset
  %36 = buffer.view %words[%35] : buffer -> view<1xi32>
  view.store<volatile> %27, %36[0] : i32, view<1xi32>
  %37 = scalar.constant 11 : i32
  %140 = scalar.constant 8 : i64
  %43 = scalar.addi %32, %140 : i64
  %44 = scalar.assume %43 [range(%43, 0, 9223372036854775807)] : i64
  %45 = index.cast %44 : i64 to offset
  %46 = buffer.view %words[%45] : buffer -> view<1xi32>
  view.store<volatile> %37, %46[0] : i32, view<1xi32>
  %47 = scalar.constant 1 : i32
  %48 = scalar.constant 8 : i32
  %bitmap = func.call @bitmap_update_volatile_unsigned_int(%words, %words_byte_offset, %47, %48) : (buffer, offset, i32, i32) -> (i32)
  %sequenced = func.call @sequenced_update_volatile_unsigned_int(%words, %words_byte_offset) : (buffer, offset) -> (i32)
  %increments = func.call @increment_storage_volatile_unsigned_int(%words, %35) : (buffer, offset) -> (i32)
  %60 = scalar.addi %bitmap, %sequenced : i32
  %61 = scalar.addi %60, %increments : i32
  func.return %61 : i32
}

func.def @bitmap_update_volatile_unsigned_int(%words: buffer, %words_byte_offset: offset, %index: i32, %mask: i32) -> (i32) {
  %67 = scalar.extui %index : i32 to i64
  %142 = scalar.constant 2 : i64
  %143 = scalar.shli %67, %142 : i64
  %70 = index.cast %words_byte_offset : offset to i64
  %71 = scalar.addi %70, %143 : i64
  %72 = scalar.assume %71 [range(%71, 0, 9223372036854775807)] : i64
  %73 = index.cast %72 : i64 to offset
  %74 = buffer.view %words[%73] : buffer -> view<1xi32>
  %75 = view.load<volatile> %74[0] : view<1xi32> -> i32
  %76 = scalar.ori %75, %mask : i32
  view.store<volatile> %76, %74[0] : i32, view<1xi32>
  func.return %76 : i32
}

func.def @sequenced_update_volatile_unsigned_int(%words: buffer, %words_byte_offset: offset) -> (i32) {
  %82 = scalar.constant 32 : i32
  %146 = scalar.constant 4 : i64
  %87 = index.cast %words_byte_offset : offset to i64
  %88 = scalar.addi %87, %146 : i64
