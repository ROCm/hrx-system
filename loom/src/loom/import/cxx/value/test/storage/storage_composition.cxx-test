// ====
// RUN: pass canonicalize,cse,dce
// Signed byte division truncates toward zero and returns the converted
// stored value, not an unsigned quotient.
int storage_divide(signed char* bytes) {
  bytes[1] = -125;
  return bytes[1] /= 3;
}
// ----
func.def public @storage_divide(%bytes: buffer, %bytes_byte_offset: offset) -> (i32) {
  %33 = scalar.constant -125 : i8
  %32 = scalar.constant 1 : i64
  %11 = index.cast %bytes_byte_offset : offset to i64
  %12 = scalar.addi %11, %32 : i64
  %13 = scalar.assume %12 [range(%12, 0, 9223372036854775807)] : i64
  %14 = index.cast %13 : i64 to offset
  %15 = buffer.view %bytes[%14] : buffer -> view<1xi8>
  view.store %33, %15[0] : i8, view<1xi8>
  %16 = scalar.constant 3 : i32
  %26 = view.load %15[0] : view<1xi8> -> i8
  %27 = scalar.extsi %26 : i8 to i32
  %28 = scalar.divsi %27, %16 : i32
  %29 = scalar.trunci %28 : i32 to i8
  view.store %29, %15[0] : i8, view<1xi8>
  %30 = scalar.extsi %29 : i8 to i32
  func.return %30 : i32
}

// ====
// RUN: pass canonicalize,cse,dce
// Floating compound results retain their value before later mutations
// of the same storage, and integer RHS values convert to floating point.
float storage_floats(float* values) {
  values[1] = 1.5f;
  values[2] = -3.0f;
  float first = values[1] *= 2;
  float second = values[2] /= 2;
  values[1] += 0.25f;
  values[2] -= 0.5f;
  return first + second;
}

[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void storage_floats_kernel(float* values, float* output) {
  output[1] = storage_floats(values);
}
// ----
func.def public @storage_floats(%values: buffer, %values_byte_offset: offset) -> (f32) {
  %3 = scalar.constant 1.5 : f32
  %103 = scalar.constant 4 : i64
  %8 = index.cast %values_byte_offset : offset to i64
  %9 = scalar.addi %8, %103 : i64
  %10 = scalar.assume %9 [range(%9, 0, 9223372036854775807)] : i64
  %11 = index.cast %10 : i64 to offset
  %12 = buffer.view %values[%11] : buffer -> view<1xf32>
  view.store %3, %12[0] : f32, view<1xf32>
  %102 = scalar.constant -3.0 : f32
  %101 = scalar.constant 8 : i64
  %20 = scalar.addi %8, %101 : i64
  %21 = scalar.assume %20 [range(%20, 0, 9223372036854775807)] : i64
  %22 = index.cast %21 : i64 to offset
  %23 = buffer.view %values[%22] : buffer -> view<1xf32>
  view.store %102, %23[0] : f32, view<1xf32>
  %100 = scalar.constant 2.0 : f32
  %35 = view.load %12[0] : view<1xf32> -> f32
  %first = scalar.mulf %35, %100 : f32
  view.store %first, %12[0] : f32, view<1xf32>
  %48 = view.load %23[0] : view<1xf32> -> f32
  %second = scalar.divf %48, %100 : f32
  view.store %second, %23[0] : f32, view<1xf32>
