// RUN: roundtrip
#include <loomcxx/buffer.h>
#include <loomcxx/index.h>

struct Pair {
  unsigned first;
  float second;
};

template <class T, loom::memory_space Space,
          __SIZE_TYPE__ Alignment = alignof(T)>
static T exchange(__SIZE_TYPE__ count, __SIZE_TYPE__ write_index,
                  __SIZE_TYPE__ read_index, T value) {
  auto* values = loom::buffer::alloca<T, Space, Alignment>(count);
  values[write_index] = value;
  return values[read_index];
}

Pair private_records(__SIZE_TYPE__ count, __SIZE_TYPE__ write_index,
                     __SIZE_TYPE__ read_index, Pair value) {
  return exchange<Pair, loom::memory_space::private_, 64>(count, write_index,
                                                          read_index, value);
}

unsigned global_words(__SIZE_TYPE__ count, __SIZE_TYPE__ write_index,
                      __SIZE_TYPE__ read_index, unsigned value) {
  return exchange<unsigned, loom::memory_space::global>(count, write_index,
                                                        read_index, value);
}

unsigned workgroup_words(__SIZE_TYPE__ count, __SIZE_TYPE__ write_index,
                         __SIZE_TYPE__ read_index, unsigned value) {
  return exchange<unsigned, loom::memory_space::workgroup>(count, write_index,
                                                           read_index, value);
}

unsigned host_words(__SIZE_TYPE__ count, __SIZE_TYPE__ write_index,
                    __SIZE_TYPE__ read_index, unsigned value) {
  return exchange<unsigned, loom::memory_space::host>(count, write_index,
                                                      read_index, value);
}

unsigned generic_words(__SIZE_TYPE__ count, __SIZE_TYPE__ write_index,
                       __SIZE_TYPE__ read_index, unsigned value) {
  return exchange<unsigned, loom::memory_space::generic>(count, write_index,
                                                         read_index, value);
}

unsigned char private_bytes(loom::type::offset byte_length, unsigned char value) {
  auto* bytes = loom::buffer::alloca<loom::memory_space::private_, 16>(byte_length);
  bytes[0] = value;
  return bytes[0];
}

// ----
func.def public @private_records(%count: i64, %write_index: i64, %read_index: i64, %value_first: i32, %value_second: f32) -> (i32, f32) {
  %7, %8 = func.call @exchange___Pair_3_64(%count, %write_index, %read_index, %value_first, %value_second) : (i64, i64, i64, i32, f32) -> (i32, f32)
  func.return %7, %8 : i32, f32
}

func.def public @global_words(%count: i64, %write_index: i64, %read_index: i64, %value: i32) -> (i32) {
  %14 = func.call @exchange_unsigned_int_1_4(%count, %write_index, %read_index, %value) : (i64, i64, i64, i32) -> (i32)
  func.return %14 : i32
}

func.def public @workgroup_words(%count: i64, %write_index: i64, %read_index: i64, %value: i32) -> (i32) {
  %20 = func.call @exchange_unsigned_int_2_4(%count, %write_index, %read_index, %value) : (i64, i64, i64, i32) -> (i32)
  func.return %20 : i32
}

func.def public @host_words(%count: i64, %write_index: i64, %read_index: i64, %value: i32) -> (i32) {
  %26 = func.call @exchange_unsigned_int_5_4(%count, %write_index, %read_index, %value) : (i64, i64, i64, i32) -> (i32)
  func.return %26 : i32
}

func.def public @generic_words(%count: i64, %write_index: i64, %read_index: i64, %value: i32) -> (i32) {
  %32 = func.call @exchange_unsigned_int_7_4(%count, %write_index, %read_index, %value) : (i64, i64, i64, i32) -> (i32)
  func.return %32 : i32
}

func.def public @private_bytes(%byte_length: offset, %value: i8) -> (i8) {
  %bytes = buffer.alloca<private> align(16) %byte_length : buffer
  %bytes_byte_offset = index.constant 0 : offset
  %38 = scalar.constant 0 : i32
  %39 = scalar.extsi %38 : i32 to i64
  %40 = scalar.constant 1 : i64
  %41 = scalar.muli %39, %40 : i64
  %42 = index.cast %bytes_byte_offset : offset to i64
  %43 = scalar.addi %42, %41 : i64
  %44 = scalar.assume %43 [range(%43, 0, 9223372036854775807)] : i64
  %45 = index.cast %44 : i64 to offset
  %46 = buffer.view %bytes[%45] : buffer -> view<1xi8>
  view.store %value, %46[0] : i8, view<1xi8>
  %47 = scalar.constant 0 : i32
  %48 = scalar.extsi %47 : i32 to i64
  %49 = scalar.constant 1 : i64
  %50 = scalar.muli %48, %49 : i64
  %51 = index.cast %bytes_byte_offset : offset to i64
  %52 = scalar.addi %51, %50 : i64
  %53 = scalar.assume %52 [range(%52, 0, 9223372036854775807)] : i64
  %54 = index.cast %53 : i64 to offset
  %55 = buffer.view %bytes[%54] : buffer -> view<1xi8>
  %56 = view.load %55[0] : view<1xi8> -> i8
  func.return %56 : i8
}

func.def @exchange___Pair_3_64(%count: i64, %write_index: i64, %read_index: i64, %value_first: i32, %value_second: f32) -> (i32, f32) {
  %64 = index.cast %count : i64 to index
  %65 = index.constant 8 : offset
  %66 = index.scale %64, %65 : index, offset -> offset
  %values = buffer.alloca<private> align(64) %66 : buffer
  %values_byte_offset = index.constant 0 : offset
  %69 = scalar.constant 8 : i64
  %70 = scalar.muli %write_index, %69 : i64
  %71 = index.cast %values_byte_offset : offset to i64
  %72 = scalar.addi %71, %70 : i64
  %73 = scalar.assume %72 [range(%72, 0, 9223372036854775807)] : i64
  %74 = index.cast %73 : i64 to offset
  %75 = index.constant 0 : offset
  %76 = index.add %74, %75 : offset
  %77 = buffer.view %values[%76] : buffer -> view<1xi32>
  view.store %value_first, %77[0] : i32, view<1xi32>
  %78 = index.constant 4 : offset
  %79 = index.add %74, %78 : offset
  %80 = buffer.view %values[%79] : buffer -> view<1xf32>
  view.store %value_second, %80[0] : f32, view<1xf32>
  %81 = scalar.constant 8 : i64
  %82 = scalar.muli %read_index, %81 : i64
  %83 = index.cast %values_byte_offset : offset to i64
  %84 = scalar.addi %83, %82 : i64
  %85 = scalar.assume %84 [range(%84, 0, 9223372036854775807)] : i64
  %86 = index.cast %85 : i64 to offset
  %87 = index.constant 0 : offset
  %88 = index.add %86, %87 : offset
  %89 = buffer.view %values[%88] : buffer -> view<1xi32>
  %90 = view.load %89[0] : view<1xi32> -> i32
  %91 = index.constant 4 : offset
  %92 = index.add %86, %91 : offset
  %93 = buffer.view %values[%92] : buffer -> view<1xf32>
  %94 = view.load %93[0] : view<1xf32> -> f32
  func.return %90, %94 : i32, f32
}

