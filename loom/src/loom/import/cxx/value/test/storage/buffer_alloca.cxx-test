  %111 = index.cast %count : i64 to index
  %112 = index.constant 4 : offset
  %113 = index.scale %111, %112 : index, offset -> offset
  %values = buffer.alloca<workgroup> align(4) %113 : buffer
  %values_byte_offset = index.constant 0 : index
  %116 = index.cast %write_index : i64 to index
  %117 = index.constant 4 : index
  %118 = index.mul %116, %117 : index
  %119 = index.add %values_byte_offset, %118 : index
  %120 = buffer.view %values[%119] : buffer -> view<1xi32>
