// ====
// INPUT: cxx data-model=ilp32
#include <loomcxx/buffer.h>

int private_words(__SIZE_TYPE__ count, __SIZE_TYPE__ write_index,
                  __SIZE_TYPE__ read_index, int value) {
  auto* values = loom::buffer::alloca<int, loom::memory_space::private_>(count);
  values[write_index] = value;
  return values[read_index];
}

// ----
func.def public @private_words(%count: i32, %write_index: i32, %read_index: i32, %value: i32) -> (i32) {
  %5 = scalar.extui %count : i32 to i64
  %6 = index.cast %5 : i64 to index
  %7 = index.constant 4 : offset
  %8 = index.scale %6, %7 : index, offset -> offset
  %values = buffer.alloca<private> align(4) %8 : buffer
  %values_byte_offset = index.constant 0 : offset
  %11 = scalar.extui %write_index : i32 to i64
  %12 = scalar.constant 4 : i64
  %13 = scalar.muli %11, %12 : i64
  %14 = index.cast %values_byte_offset : offset to i64
  %15 = scalar.addi %14, %13 : i64
  %16 = scalar.assume %15 [range(%15, 0, 4294967295)] : i64
  %17 = index.cast %16 : i64 to offset
  %18 = buffer.view %values[%17] : buffer -> view<1xi32>
  view.store %value, %18[0] : i32, view<1xi32>
  %19 = scalar.extui %read_index : i32 to i64
  %20 = scalar.constant 4 : i64
  %21 = scalar.muli %19, %20 : i64
  %22 = index.cast %values_byte_offset : offset to i64
  %23 = scalar.addi %22, %21 : i64
  %24 = scalar.assume %23 [range(%23, 0, 4294967295)] : i64
  %25 = index.cast %24 : i64 to offset
  %26 = buffer.view %values[%25] : buffer -> view<1xi32>
  %27 = view.load %26[0] : view<1xi32> -> i32
  func.return %27 : i32
}

// ====
// Allocation and view construction remain independent facade layers.
#include <loomcxx/buffer.h>
#include <loomcxx/view.h>

float view_private(__SIZE_TYPE__ count, __SIZE_TYPE__ write_index,
                   __SIZE_TYPE__ read_index, float value) {
  auto* values =
      loom::buffer::alloca<float, loom::memory_space::private_>(count);
  auto layout = loom::encoding::layout::dense<1>();
  auto view = loom::buffer::view<loom::type::dynamic>(values, {count}, layout);
  loom::view::store(value, view, write_index);
  return loom::view::load(view, read_index);
}

// ----
func.def public @view_private(%count: i64, %write_index: i64, %read_index: i64, %value: f32) -> (f32) {
  %5 = index.cast %count : i64 to index
  %6 = index.constant 4 : offset
  %7 = index.scale %5, %6 : index, offset -> offset
  %values = buffer.alloca<private> align(4) %7 : buffer
  %values_byte_offset = index.constant 0 : offset
  %layout = encoding.layout.dense : encoding<layout>
  %view_dim0 = index.cast %count : i64 to index
  %view = buffer.view %values[%values_byte_offset] : buffer -> view<[%view_dim0]xf32, %layout>
  %13 = index.cast %write_index : i64 to index
  view.store %value, %view[%13] : f32, view<[%view_dim0]xf32, %layout>
  %14 = index.cast %read_index : i64 to index
  %15 = view.load %view[%14] : view<[%view_dim0]xf32, %layout> -> f32
  func.return %15 : f32
}

// ====
// Native index counts remain in the address domain through allocation sizing.
#include <loomcxx/buffer.h>
#include <loomcxx/index.h>

void allocate_words(loom::type::index count) {
  loom::buffer::alloca<unsigned, loom::memory_space::private_>(count);
}

// ----
func.def public @allocate_words(%count: index) {
  %1 = index.constant 4 : offset
  %2 = index.scale %count, %1 : index, offset -> offset
  %3 = buffer.alloca<private> align(4) %2 : buffer
  %4 = index.constant 0 : offset
  func.return
}
