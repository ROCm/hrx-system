// RUN: roundtrip
#include <loomcxx/buffer.h>
#include <loomcxx/index.h>

struct Pair {
  unsigned first;
  float second;
};

template <class T, loom::memory_space Space,
          __SIZE_TYPE__ Alignment = alignof(T)>
static T exchange(__SIZE_TYPE__ count, __SIZE_TYPE__ write_index,
                  __SIZE_TYPE__ read_index, T value) {
  auto* values = loom::buffer::alloca<T, Space, Alignment>(count);
  values[write_index] = value;
  return values[read_index];
}

Pair private_records(__SIZE_TYPE__ count, __SIZE_TYPE__ write_index,
                     __SIZE_TYPE__ read_index, Pair value) {
  return exchange<Pair, loom::memory_space::private_, 64>(count, write_index,
                                                          read_index, value);
}

unsigned global_words(__SIZE_TYPE__ count, __SIZE_TYPE__ write_index,
                      __SIZE_TYPE__ read_index, unsigned value) {
  return exchange<unsigned, loom::memory_space::global>(count, write_index,
                                                        read_index, value);
}

unsigned workgroup_words(__SIZE_TYPE__ count, __SIZE_TYPE__ write_index,
                         __SIZE_TYPE__ read_index, unsigned value) {
  return exchange<unsigned, loom::memory_space::workgroup>(count, write_index,
                                                           read_index, value);
}

unsigned host_words(__SIZE_TYPE__ count, __SIZE_TYPE__ write_index,
                    __SIZE_TYPE__ read_index, unsigned value) {
  return exchange<unsigned, loom::memory_space::host>(count, write_index,
                                                      read_index, value);
}

unsigned generic_words(__SIZE_TYPE__ count, __SIZE_TYPE__ write_index,
                       __SIZE_TYPE__ read_index, unsigned value) {
  return exchange<unsigned, loom::memory_space::generic>(count, write_index,
                                                         read_index, value);
}

unsigned char private_bytes(loom::type::offset byte_length, unsigned char value) {
  auto* bytes = loom::buffer::alloca<loom::memory_space::private_, 16>(byte_length);
  bytes[0] = value;
  return bytes[0];
}

// ----
func.def public @private_records(%count: i64, %write_index: i64, %read_index: i64, %value_first: i32, %value_second: f32) -> (i32, f32) {
  %7, %8 = func.call @exchange___Pair_3_64(%count, %write_index, %read_index, %value_first, %value_second) : (i64, i64, i64, i32, f32) -> (i32, f32)
  func.return %7, %8 : i32, f32
}

func.def public @global_words(%count: i64, %write_index: i64, %read_index: i64, %value: i32) -> (i32) {
  %14 = func.call @exchange_unsigned_int_1_4(%count, %write_index, %read_index, %value) : (i64, i64, i64, i32) -> (i32)
  func.return %14 : i32
}

func.def public @workgroup_words(%count: i64, %write_index: i64, %read_index: i64, %value: i32) -> (i32) {
  %20 = func.call @exchange_unsigned_int_2_4(%count, %write_index, %read_index, %value) : (i64, i64, i64, i32) -> (i32)
  func.return %20 : i32
}

func.def public @host_words(%count: i64, %write_index: i64, %read_index: i64, %value: i32) -> (i32) {
  %26 = func.call @exchange_unsigned_int_5_4(%count, %write_index, %read_index, %value) : (i64, i64, i64, i32) -> (i32)
  func.return %26 : i32
}

func.def public @generic_words(%count: i64, %write_index: i64, %read_index: i64, %value: i32) -> (i32) {
  %32 = func.call @exchange_unsigned_int_7_4(%count, %write_index, %read_index, %value) : (i64, i64, i64, i32) -> (i32)
  func.return %32 : i32
}

func.def public @private_bytes(%byte_length: offset, %value: i8) -> (i8) {
  %bytes = buffer.alloca<private> align(16) %byte_length : buffer
  %bytes_byte_offset = index.constant 0 : index
  %38 = scalar.constant 0 : i32
  %39 = index.cast %38 : i32 to index
  %40 = index.constant 1 : index
  %41 = index.mul %39, %40 : index
  %42 = index.add %bytes_byte_offset, %41 : index
  %43 = buffer.view %bytes[%42] : buffer -> view<1xi8>
  view.store<root_in_bounds> %value, %43[0] : i8, view<1xi8>
  %44 = scalar.constant 0 : i32
  %45 = index.cast %44 : i32 to index
  %46 = index.constant 1 : index
  %47 = index.mul %45, %46 : index
  %48 = index.add %bytes_byte_offset, %47 : index
  %49 = buffer.view %bytes[%48] : buffer -> view<1xi8>
  %50 = view.load<root_in_bounds> %49[0] : view<1xi8> -> i8
  func.return %50 : i8
}

func.def @exchange___Pair_3_64(%count: i64, %write_index: i64, %read_index: i64, %value_first: i32, %value_second: f32) -> (i32, f32) {
  %58 = index.cast %count : i64 to index
  %59 = index.constant 8 : offset
  %60 = index.scale %58, %59 : index, offset -> offset
  %values = buffer.alloca<private> align(64) %60 : buffer
  %values_byte_offset = index.constant 0 : index
  %63 = index.cast %write_index : i64 to index
  %64 = index.constant 8 : index
  %65 = index.mul %63, %64 : index
  %66 = index.add %values_byte_offset, %65 : index
  %67 = index.constant 0 : index
  %68 = index.add %66, %67 : index
  %69 = buffer.view %values[%68] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %value_first, %69[0] : i32, view<1xi32>
  %70 = index.constant 4 : index
  %71 = index.add %66, %70 : index
  %72 = buffer.view %values[%71] : buffer -> view<1xf32>
  view.store<root_in_bounds|type_disjoint> %value_second, %72[0] : f32, view<1xf32>
  %73 = index.cast %read_index : i64 to index
  %74 = index.constant 8 : index
  %75 = index.mul %73, %74 : index
  %76 = index.add %values_byte_offset, %75 : index
  %77 = index.constant 0 : index
  %78 = index.add %76, %77 : index
  %79 = buffer.view %values[%78] : buffer -> view<1xi32>
  %80 = view.load<root_in_bounds|type_disjoint> %79[0] : view<1xi32> -> i32
  %81 = index.constant 4 : index
  %82 = index.add %76, %81 : index
  %83 = buffer.view %values[%82] : buffer -> view<1xf32>
  %84 = view.load<root_in_bounds|type_disjoint> %83[0] : view<1xf32> -> f32
  func.return %80, %84 : i32, f32
}

func.def @exchange_unsigned_int_1_4(%count: i64, %write_index: i64, %read_index: i64, %value: i32) -> (i32) {
  %90 = index.cast %count : i64 to index
  %91 = index.constant 4 : offset
  %92 = index.scale %90, %91 : index, offset -> offset
  %values = buffer.alloca<global> align(4) %92 : buffer
  %values_byte_offset = index.constant 0 : index
  %95 = index.cast %write_index : i64 to index
  %96 = index.constant 4 : index
  %97 = index.mul %95, %96 : index
  %98 = index.add %values_byte_offset, %97 : index
  %99 = buffer.view %values[%98] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %value, %99[0] : i32, view<1xi32>
  %100 = index.cast %read_index : i64 to index
  %101 = index.constant 4 : index
  %102 = index.mul %100, %101 : index
  %103 = index.add %values_byte_offset, %102 : index
  %104 = buffer.view %values[%103] : buffer -> view<1xi32>
  %105 = view.load<root_in_bounds|type_disjoint> %104[0] : view<1xi32> -> i32
  func.return %105 : i32
}

