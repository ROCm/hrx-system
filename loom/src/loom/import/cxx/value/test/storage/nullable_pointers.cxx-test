// ====
// Optional pointers retain guarded accesses, byte origins, and loop transport.
[[loom::noinline]] const int* optional(const int* input, bool use) {
  return use ? input + 1 : nullptr;
}
int guarded(const int* input, bool use) {
  const int* pointer = optional(input, use);
  return pointer ? *pointer : 7;
}
int rotated(const int* input, unsigned count) {
  const int* current = input;
  const int* next = nullptr;
  for (unsigned i = 0; i < count; ++i) {
    const int* previous = current;
    current = next;
    next = previous;
  }
  return current != nullptr ? current[0] : 11;
}
