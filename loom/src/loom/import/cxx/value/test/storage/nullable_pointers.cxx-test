  %4 = index.constant 0 : index
  %5, %6, %7 = func.call pure @OptionalOwner__OptionalOwner_value(%3, %4) : (buffer, index) -> (buffer, index, i32)
  func.return %5, %6, %7 : buffer, index, i32
}

