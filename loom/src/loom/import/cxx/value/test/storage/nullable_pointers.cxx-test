  %5, %6 = scf.if %use -> (buffer, index) {
    %61 = index.constant 4 : index
    %11 = index.add %input_byte_offset, %61 : index
    scf.yield %input, %11 : buffer, index
  } else {
    %12 = buffer.null : buffer
    %13 = index.constant 0 : index
    scf.yield %12, %13 : buffer, index
  }
  func.return %5, %6 : buffer, index
}

