  %23 = scf.if %22 -> (i32) {
    %24 = buffer.view %pointer[%pointer_byte_offset] : buffer -> view<1xi32>
    %25 = view.load<root_in_bounds|type_disjoint> %24[0] : view<1xi32> -> i32
    scf.yield %25 : i32
