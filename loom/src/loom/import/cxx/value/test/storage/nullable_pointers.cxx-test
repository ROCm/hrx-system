    scf.yield %19, %20 : buffer, index
  }
  %value_pointer, %value_pointer_byte_offset, %value_fallback = func.call pure @OptionalOwner__OptionalOwner_value(%17, %18) : (buffer, index) -> (buffer, index, i32)
  %24 = buffer.compare.null %value_pointer : buffer
  %25 = scalar.constant 1 : i1
  %26 = scalar.xori %24, %25 : i1
  %27 = scf.if %26 -> (i32) {
    %33 = buffer.view %value_pointer[%value_pointer_byte_offset] : buffer -> view<1xi32>
    %34 = view.load<root_in_bounds|type_disjoint> %33[0] : view<1xi32> -> i32
    scf.yield %34 : i32
  } else {
    scf.yield %value_fallback : i32
  }
  func.return %27 : i32
}

