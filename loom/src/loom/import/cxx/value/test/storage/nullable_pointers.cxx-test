// ====
// Null members stay in the existing aggregate and closure value partitions.
struct Optional {
  const int* data;
  explicit operator bool() const { return data != nullptr; }
  int read() const { return data ? *data : 13; }
};
int record(Optional value) { return value ? value.read() : 17; }
Optional empty_record() { return {}; }
int closure(const int* input, bool use) {
  auto read = [pointer = use ? input : nullptr]() {
    return pointer ? pointer[0] : 19;
  };
  return read();
}
