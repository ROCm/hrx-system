// RUN: pass canonicalize,cse,dce
// All source null spellings retain one absent root with zero byte origin.
using Pointer = const int*;
Pointer literal() { return nullptr; }
Pointer integer() { return 0; }
Pointer braces() { Pointer value{}; return value; }
Pointer functional() { return Pointer(); }
Pointer cast_zero() { return static_cast<Pointer>(0); }
Pointer reinterpret_zero() { return reinterpret_cast<Pointer>(0); }
decltype(nullptr) null_type() { return nullptr; }
bool equal(Pointer input) { return input == nullptr; }
bool reversed(Pointer input) { return nullptr == input; }
bool unequal(Pointer input) { return input != 0; }
bool boolean(Pointer input) { return bool(input); }
bool negated(Pointer input) { return !input; }
bool explicit_boolean(Pointer input) { return static_cast<bool>(input); }
constexpr Pointer absent = nullptr;
bool constant_pointer(Pointer input) { return input == absent; }
bool constructed_pointer(Pointer input) { return input == Pointer(); }
bool braced_pointer(Pointer input) { return Pointer{} == input; }
bool constructed_zero(Pointer input) { return input == Pointer(0); }
