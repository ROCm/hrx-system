// ====
// A nullptr_t result is known null, but the producing call still executes.
[[loom::noinline]] decltype(nullptr) observed_null(unsigned* calls) {
  ++*calls;
  return nullptr;
}
bool compare_effect(const int* input, unsigned* calls) {
  return input == observed_null(calls);
}
// ----
func.def public noinline @observed_null(%calls: buffer, %calls_byte_offset: index) -> (buffer, index) {
  %4 = buffer.view %calls[%calls_byte_offset] : buffer -> view<1xi32>
  %5 = view.load<root_in_bounds|type_disjoint> %4[0] : view<1xi32> -> i32
  %6 = scalar.constant 1 : i32
  %7 = scalar.addi %5, %6 : i32
  view.store<root_in_bounds|type_disjoint> %7, %4[0] : i32, view<1xi32>
  %8 = buffer.null : buffer
  %9 = index.constant 0 : index
  func.return %8, %9 : buffer, index
}

func.def public @compare_effect(%input: buffer, %input_byte_offset: index, %calls: buffer, %calls_byte_offset: index) -> (i1) {
  %15, %16 = func.call @observed_null(%calls, %calls_byte_offset) : (buffer, index) -> (buffer, index)
  %17 = buffer.compare.null %input : buffer
  func.return %17 : i1
}

// ====
// Kernel bindings retain their one-buffer ABI through an optional local pointer.
#include <hip/hip_runtime.h>
extern "C" __global__ void probe(const float* input, float* output, unsigned use) {
  const float* pointer = use ? input : nullptr;
  if (use) output[0] = pointer[0];
}

// ----
kernel.def @probe() {
  %workgroup_count_x = config.get @probe.workgroup_count.x : index
  %workgroup_count_y = config.get @probe.workgroup_count.y : index
  %workgroup_count_z = config.get @probe.workgroup_count.z : index
  %workgroup_size_x = config.get @probe.workgroup_size.x : index
  %workgroup_size_y = config.get @probe.workgroup_size.y : index
  %workgroup_size_z = config.get @probe.workgroup_size.z : index
  kernel.launch.config workgroups(%workgroup_count_x, %workgroup_count_y, %workgroup_count_z) workgroup_size(%workgroup_size_x, %workgroup_size_y, %workgroup_size_z) : index
} launch(%input: buffer, %output: buffer, %use: i32) {
  %17 = scalar.constant 0 : i32
  %18 = scalar.cmpi ne, %use, %17 : i32
  %pointer = scf.if %18 -> (buffer) {
    scf.yield %input : buffer
  } else {
    %21 = buffer.null : buffer
    scf.yield %21 : buffer
  }
  scf.if %18 {
    %39 = index.constant 0 : index
    %30 = buffer.view %pointer[%39] : buffer -> view<1xf32>
    %31 = view.load<root_in_bounds|type_disjoint> %30[0] : view<1xf32> -> f32
    %37 = buffer.view %output[%39] : buffer -> view<1xf32>
    view.store<root_in_bounds|type_disjoint> %31, %37[0] : f32, view<1xf32>
  }
  kernel.return
}

config.decl @probe.workgroup_count.x : index

config.decl @probe.workgroup_count.y : index

config.decl @probe.workgroup_count.z : index

config.decl @probe.workgroup_size.x : index

config.decl @probe.workgroup_size.y : index

config.decl @probe.workgroup_size.z : index

// ====
// Null buffers remain ordinary semantic record components through
// user-provided construction, function boundaries, lifetime extension, and a
// nonescaping pointer alias of the retained temporary.
struct OptionalOwner {
  const unsigned* pointer;
  unsigned fallback;

  OptionalOwner(const unsigned* pointer)
      : pointer(pointer), fallback(7u) {}
};

OptionalOwner null_record() { return OptionalOwner(nullptr); }

const unsigned* record_pointer(OptionalOwner value) { return value.pointer; }

unsigned temporary_alias(const unsigned* input, bool use) {
  const OptionalOwner& value = OptionalOwner(use ? input : nullptr);
  const OptionalOwner* alias = &value;
  return alias->pointer ? alias->pointer[0] : alias->fallback;
}

