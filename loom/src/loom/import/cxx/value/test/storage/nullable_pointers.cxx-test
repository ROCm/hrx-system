// ====
// Kernel bindings retain their one-buffer ABI through an optional local pointer.
#include <hip/hip_runtime.h>
extern "C" __global__ void probe(const float* input, float* output, unsigned use) {
  const float* pointer = use ? input : nullptr;
  if (use) output[0] = pointer[0];
}

