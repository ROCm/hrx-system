// ====
// INPUT: cxx data-model=lp64
struct IntegerResults {
  // The three C standard integer absolute-value signatures.
  int narrow;
  // Source-model long width.
  long natural;
  // Source-model long long width.
  long long wide;
};
IntegerResults magnitudes(int narrow, long natural, long long wide) {
  return {__builtin_abs(narrow), __builtin_labs(natural), __builtin_llabs(wide)};
}
// ----
func.def public @magnitudes(%narrow: i32, %natural: i64, %wide: i64) -> (i32, i64, i64) {
  %6 = scalar.absi %narrow : i32
  %7 = scalar.absi %natural : i64
  %8 = scalar.absi %wide : i64
  func.return %6, %7, %8 : i32, i64, i64
}

// ====
// INPUT: cxx data-model=llp64
struct IntegerResults {
  // The three C standard integer absolute-value signatures.
  int narrow;
  // Source-model long width.
  long natural;
  // Source-model long long width.
  long long wide;
};
IntegerResults magnitudes(int narrow, long natural, long long wide) {
  return {__builtin_abs(narrow), __builtin_labs(natural), __builtin_llabs(wide)};
}
// ----
func.def public @magnitudes(%narrow: i32, %natural: i32, %wide: i64) -> (i32, i32, i64) {
  %6 = scalar.absi %narrow : i32
  %7 = scalar.absi %natural : i32
  %8 = scalar.absi %wide : i64
  func.return %6, %7, %8 : i32, i32, i64
}

// ====
// INPUT: cxx data-model=ilp32
struct IntegerResults {
  // The three C standard integer absolute-value signatures.
  int narrow;
  // Source-model long width.
  long natural;
  // Source-model long long width.
  long long wide;
};
IntegerResults magnitudes(int narrow, long natural, long long wide) {
  return {__builtin_abs(narrow), __builtin_labs(natural), __builtin_llabs(wide)};
}
// ----
func.def public @magnitudes(%narrow: i32, %natural: i32, %wide: i64) -> (i32, i32, i64) {
  %6 = scalar.absi %narrow : i32
  %7 = scalar.absi %natural : i32
  %8 = scalar.absi %wide : i64
  func.return %6, %7, %8 : i32, i32, i64
}

// ====
// The existing operation bindings own lexical floating-point permissions.
[[loom::fastmath]] double relaxed(double value, double other, double addend) {
  return __builtin_fma(__builtin_sqrt(value), __builtin_pow(value, other), addend);
}
[[loom::fastmath(false)]] double strict(double value) { return __builtin_sqrt(value); }
// ----
func.def public @relaxed(%value: f64, %other: f64, %addend: f64) -> (f64) {
  %4 = scalar.sqrtf<reassoc|nnan|ninf|nsz|arcp|contract|afn> %value : f64
  %5 = scalar.powf<reassoc|nnan|ninf|nsz|arcp|contract|afn> %value, %other : f64
  %6 = scalar.fmaf<reassoc|nnan|ninf|nsz|arcp|contract|afn> %4, %5, %addend : f64
  func.return %6 : f64
}

func.def public @strict(%value: f64) -> (f64) {
  %9 = scalar.sqrtf %value : f64
  func.return %9 : f64
}

// ====
// A discarded result still evaluates the source operands exactly once.
float discarded(float value) {
  __builtin_fmaf(value++, value++, value++);
  return value;
}
// ----
func.def public @discarded(%value$0: f32) -> (f32) {
  %2 = scalar.constant 1 : i32
  %3 = scalar.sitofp %2 : i32 to f32
  %value$4 = scalar.addf %value$0, %3 : f32
  %5 = scalar.constant 1 : i32
  %6 = scalar.sitofp %5 : i32 to f32
  %value$7 = scalar.addf %value$4, %6 : f32
  %8 = scalar.constant 1 : i32
  %9 = scalar.sitofp %8 : i32 to f32
  %value$10 = scalar.addf %value$7, %9 : f32
  %11 = scalar.fmaf %value$0, %value$4, %value$7 : f32
  func.return %value$10 : f32
}

