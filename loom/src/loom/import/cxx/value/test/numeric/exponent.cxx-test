  %input$14 = scalar.subf %input$11, %13 : f16
  %pair_fraction, %pair_exponent = scalar.frexpf %input$14 : f16, i32
  %17 = scalar.ldexpf %pair_fraction, %pair_exponent : f16, i32
  %18 = scalar.addf %17, %input$7 : f16
  %19 = scalar.addf %18, %input$14 : f16
