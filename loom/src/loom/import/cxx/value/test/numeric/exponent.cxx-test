// ====
// RUN: roundtrip
// Builtin argument effects happen once, and discarding the fraction preserves its exponent store.
double builtin_evaluation(double input, int index, int* exponents) {
  double fraction = __builtin_frexp(input++, &exponents[index++]);
  __builtin_frexpf(4.0f, &exponents[1]);
  double scaled = __builtin_ldexp(input++, index++);
  float scaled_float = __builtin_ldexpf(-0.75f, -3);
  return fraction + scaled + scaled_float + input + index;
}
// ----
func.def public @builtin_evaluation(%input$0: f64, %index$1: i32, %exponents: buffer, %exponents_byte_offset: offset) -> (f64) {
  %5 = scalar.constant 1 : i32
  %6 = scalar.sitofp %5 : i32 to f64
  %input$7 = scalar.addf %input$0, %6 : f64
  %8 = scalar.constant 1 : i32
  %index$9 = scalar.addi %index$1, %8 : i32
  %10 = scalar.extsi %index$1 : i32 to i64
  %11 = scalar.constant 4 : i64
  %12 = scalar.muli %10, %11 : i64
  %13 = index.cast %exponents_byte_offset : offset to i64
  %14 = scalar.addi %13, %12 : i64
  %15 = scalar.assume %14 [range(%14, 0, 9223372036854775807)] : i64
  %16 = index.cast %15 : i64 to offset
  %fraction, %18 = scalar.frexpf %input$0 : f64, i32
  %19 = buffer.view %exponents[%16] : buffer -> view<1xi32>
  view.store %18, %19[0] : i32, view<1xi32>
  %20 = scalar.constant 4.0 : f32
  %21 = scalar.constant 1 : i32
  %22 = scalar.extsi %21 : i32 to i64
  %23 = scalar.constant 4 : i64
  %24 = scalar.muli %22, %23 : i64
  %25 = index.cast %exponents_byte_offset : offset to i64
  %26 = scalar.addi %25, %24 : i64
  %27 = scalar.assume %26 [range(%26, 0, 9223372036854775807)] : i64
  %28 = index.cast %27 : i64 to offset
  %29, %30 = scalar.frexpf %20 : f32, i32
  %31 = buffer.view %exponents[%28] : buffer -> view<1xi32>
  view.store %30, %31[0] : i32, view<1xi32>
  %32 = scalar.constant 1 : i32
  %33 = scalar.sitofp %32 : i32 to f64
  %input$34 = scalar.addf %input$7, %33 : f64
  %35 = scalar.constant 1 : i32
  %index$36 = scalar.addi %index$9, %35 : i32
  %scaled = scalar.ldexpf %input$7, %index$9 : f64, i32
  %38 = scalar.constant 0.75 : f32
  %39 = scalar.negf %38 : f32
  %40 = scalar.constant 3 : i32
  %41 = scalar.constant 0 : i32
  %42 = scalar.subi %41, %40 : i32
  %scaled_float = scalar.ldexpf %39, %42 : f32, i32
  %44 = scalar.addf %fraction, %scaled : f64
  %45 = scalar.extf %scaled_float : f32 to f64
  %46 = scalar.addf %44, %45 : f64
  %47 = scalar.addf %46, %input$34 : f64
  %48 = scalar.sitofp %index$36 : i32 to f64
  %49 = scalar.addf %47, %48 : f64
  func.return %49 : f64
}
