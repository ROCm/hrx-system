  func.return %2 : i32
}

func.def @counts_long_long(%value: i64) -> (i32) {
  %5 = scalar.ctlzi %value : i64
  %6 = scalar.trunci %5 : i64 to i32
  %7 = scalar.constant 10000 : i32
  %8 = scalar.muli %6, %7 : i32
  %9 = scalar.cttzi %value : i64
  %10 = scalar.trunci %9 : i64 to i32
  %11 = scalar.constant 100 : i32
  %12 = scalar.muli %10, %11 : i32
  %13 = scalar.addi %8, %12 : i32
  %14 = scalar.ctpopi %value : i64
  %15 = scalar.trunci %14 : i64 to i32
  %16 = scalar.addi %13, %15 : i32
  func.return %16 : i32
}

