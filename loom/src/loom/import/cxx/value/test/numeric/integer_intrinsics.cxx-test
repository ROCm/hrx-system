// RUN: roundtrip
#include <loomcxx/scalar.h>

unsigned char narrow(unsigned char value) {
  return loom::scalar::ctlzi(value);
}
unsigned first_lane(unsigned mask) {
  return loom::scalar::cttzi(mask);
}
long long wide(long long value) {
  return loom::scalar::ctpopi(value);
}
// ----
func.def public @narrow(%value: i8) -> (i8) {
  %2 = scalar.ctlzi %value : i8
  func.return %2 : i8
}

func.def public @first_lane(%mask: i32) -> (i32) {
  %5 = scalar.cttzi %mask : i32
  func.return %5 : i32
}

func.def public @wide(%value: i64) -> (i64) {
  %8 = scalar.ctpopi %value : i64
  func.return %8 : i64
}

// ====
// RUN: verify
// Bit counts do not admit floating-point permissions or implicit width changes.
// ERROR@+1: LOWERING/059 "intrinsic has an unsupported math flag"
[[loom::op("scalar.cttzi", "afn")]] unsigned count(unsigned);

// ====
// RUN: verify
// ERROR@+1: LOWERING/059 "intrinsic operands must have the result's type"
[[loom::op("scalar.ctpopi")]] unsigned count(unsigned long long);

// ====
// RUN: verify
// ERROR@+1: LOWERING/059 "scalar intrinsic result must be a non-boolean integer"
[[loom::op("scalar.ctlzi")]] float count(float);

// ====
// RUN: verify
#include <loomcxx/scalar.h>
template <class T>
concept HasCount = requires(T value) { loom::scalar::cttzi(value); };
static_assert(HasCount<signed char>);
static_assert(HasCount<unsigned short>);
static_assert(HasCount<unsigned>);
static_assert(HasCount<long long>);
static_assert(!HasCount<bool>);
static_assert(!HasCount<float>);

// ====
// RUN: roundtrip
// Template deduction keeps signed char bit counts at their source width.
#include <loomcxx/scalar.h>
template <class T>
static unsigned counts(T value) {
  return static_cast<unsigned>(loom::scalar::ctlzi(value)) * 10000u +
         static_cast<unsigned>(loom::scalar::cttzi(value)) * 100u +
         static_cast<unsigned>(loom::scalar::ctpopi(value));
}
unsigned evaluate(signed char value) { return counts(value); }
// ----
func.def public @evaluate(%value: i8) -> (i32) {
  %2 = func.call pure @counts_signed_char(%value) : (i8) -> (i32)
  func.return %2 : i32
}

func.def @counts_signed_char(%value: i8) -> (i32) {
  %5 = scalar.ctlzi %value : i8
  %6 = scalar.extsi %5 : i8 to i32
  %7 = scalar.constant 10000 : i32
  %8 = scalar.muli %6, %7 : i32
  %9 = scalar.cttzi %value : i8
  %10 = scalar.extsi %9 : i8 to i32
  %11 = scalar.constant 100 : i32
  %12 = scalar.muli %10, %11 : i32
  %13 = scalar.addi %8, %12 : i32
  %14 = scalar.ctpopi %value : i8
  %15 = scalar.extsi %14 : i8 to i32
  %16 = scalar.addi %13, %15 : i32
  func.return %16 : i32
}

