// ====
// RUN: roundtrip
// An effectful intrinsic operand is evaluated once before its updated state is read.
#include <loomcxx/scalar.h>
unsigned once(unsigned value) {
  unsigned count = loom::scalar::cttzi(value++);
  return value * 100u + count;
}
// ----
func.def public @once(%value$0: i32) -> (i32) {
  %2 = scalar.constant 1 : i32
  %value$3 = scalar.addi %value$0, %2 : i32
  %count = scalar.cttzi %value$0 : i32
  %5 = scalar.constant 100 : i32
  %6 = scalar.muli %value$3, %5 : i32
  %7 = scalar.addi %6, %count : i32
  func.return %7 : i32
}

// ====
// RUN: pass canonicalize,cse,dce
// Constant source operands retain narrow widths through folding.
#include <loomcxx/scalar.h>
unsigned narrow_counts() {
  return static_cast<unsigned>(
             loom::scalar::ctlzi(static_cast<unsigned char>(0))) *
             10000u +
         static_cast<unsigned>(
             loom::scalar::cttzi(static_cast<signed char>(-128))) *
             100u +
         static_cast<unsigned>(
             loom::scalar::ctpopi(static_cast<unsigned short>(0x8000)));
}
// ----
func.def public @narrow_counts() -> (i32) {
  %21 = scalar.constant 80701 : i32
  func.return %21 : i32
}
