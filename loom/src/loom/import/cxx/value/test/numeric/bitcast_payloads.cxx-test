// RUN: roundtrip
// Typed loads and stores transport __float8_e4m3fn payloads without numeric conversion.
using Payload = __float8_e4m3fn __attribute__((ext_vector_type(4)));
void store(unsigned bits, Payload* output) {
  *output = __builtin_bit_cast(Payload, bits);
}
unsigned load(const Payload* input) {
  return __builtin_bit_cast(unsigned, *input);
}
// ----
func.def public @store(%bits: i32, %output: buffer, %output_byte_offset: offset) {
  %3 = vector.from_elements %bits : vector<1xi32>
  %4 = vector.bitcast %3 : vector<1xi32> to vector<4xf8E4M3>
  %5 = buffer.view %output[%output_byte_offset] : buffer -> view<4xf8E4M3>
  vector.store %4, %5[0] : vector<4xf8E4M3>, view<4xf8E4M3>
  func.return
}

func.def public @load(%input: buffer, %input_byte_offset: offset) -> (i32) {
  %9 = buffer.view %input[%input_byte_offset] : buffer -> view<4xf8E4M3>
  %10 = vector.load %9[0] : view<4xf8E4M3> -> vector<4xf8E4M3>
  %11 = vector.bitcast %10 : vector<4xf8E4M3> to vector<1xi32>
  %12 = vector.extract %11[0] : vector<1xi32> -> i32
  func.return %12 : i32
}

// ====
// RUN: roundtrip
// Constant object representations retain their bits in the typed value.
using Payload = __float8_e4m3fn __attribute__((ext_vector_type(4)));
Payload payload() {
  constexpr Payload value = __builtin_bit_cast(Payload, 0x7E7F0080u);
  return value;
}
// ----
func.def public @payload() -> (vector<4xf8E4M3>) {
  %1 = scalar.constant -0.0 : f8E4M3
  %2 = scalar.constant 0.0 : f8E4M3
  %3 = scalar.constant 127 : i8
  %4 = scalar.bitcast %3 : i8 to f8E4M3
  %5 = scalar.constant 448.0 : f8E4M3
  %value = vector.from_elements %1, %2, %4, %5 : vector<4xf8E4M3>
  func.return %value : vector<4xf8E4M3>
}

