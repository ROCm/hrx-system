// ====
// RUN: roundtrip
// Ordinary operations do not acquire approximation permission.
#include <loomcxx/scalar.h>
double ordinary(double value) {
  return loom::scalar::expf(loom::scalar::exp2f(loom::scalar::expm1f(value)));
}
// ----
func.def public @ordinary(%value: f64) -> (f64) {
  %2 = scalar.expm1f %value : f64
  %3 = scalar.exp2f %2 : f64
  %4 = scalar.expf %3 : f64
  func.return %4 : f64
}

// ====
// RUN: roundtrip
// The small-lambda Poisson composition keeps the stopping threshold in double
// precision. Only the exponential has approximation permission.
#include <loomcxx/scalar.h>
unsigned poisson(double lambda, const double* uniforms) {
  const double limit = loom::scalar::approximate::expf(-lambda);
  unsigned count = 0;
  double product = 1.0;
  do {
    product *= uniforms[count++];
  } while (product > limit);
  return count - 1;
}
// ----
func.def public @poisson(%lambda: f64, %uniforms: buffer, %uniforms_byte_offset: index) -> (i32) {
  %4 = scalar.negf %lambda : f64
  %limit = scalar.expf<afn> %4 : f64
  %count$6 = scalar.constant 0 : i32
  %product$7 = scalar.constant 1.0 : f64
  %count$12, %product$13 = scf.while(%count$8 = %count$6 : i32, %product$9 = %product$7 : f64) -> (i32, f64) {
    %14 = scalar.constant 1 : i32
    %count$15 = scalar.addi %count$8, %14 : i32
    %16 = scalar.extui %count$8 : i32 to i64
    %17 = index.cast %16 : i64 to index
    %18 = index.constant 8 : index
    %19 = index.mul %17, %18 : index
    %20 = index.add %uniforms_byte_offset, %19 : index
    %21 = buffer.view %uniforms[%20] : buffer -> view<1xf64>
    %22 = view.load<root_in_bounds|type_disjoint> %21[0] : view<1xf64> -> f64
    %product$23 = scalar.mulf %product$9, %22 : f64
    %24 = scalar.cmpf ogt, %product$23, %limit : f64
    scf.condition %24, %count$15, %product$23 : i1, i32, f64
  } do(%count: i32, %product: f64) {
    scf.yield %count, %product : i32, f64
  }
  %25 = scalar.constant 1 : i32
  %26 = scalar.subi %count$12, %25 : i32
  func.return %26 : i32
}
