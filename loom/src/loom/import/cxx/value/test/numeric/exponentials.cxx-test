// RUN: roundtrip
// Explicit approximation preserves the authored single precision.
#include <loomcxx/numeric.h>
#include <loomcxx/scalar.h>
using Float = float;
Float exponential_chain(Float value) {
  return loom::scalar::approximate::expf(
      loom::scalar::approximate::exp2f(
          loom::scalar::approximate::expm1f(value)));
}
// ----
func.def public @exponential_chain(%value: f32) -> (f32) {
  %2 = scalar.expm1f<afn> %value : f32
  %3 = scalar.exp2f<afn> %2 : f32
  %4 = scalar.expf<afn> %3 : f32
  func.return %4 : f32
}

