// ====
// RUN: roundtrip
// Ordinary operations do not acquire approximation permission.
#include <loomcxx/scalar.h>
double ordinary(double value) {
  return loom::scalar::expf(loom::scalar::exp2f(loom::scalar::expm1f(value)));
}
// ----
func.def public @ordinary(%value: f64) -> (f64) {
  %2 = scalar.expm1f %value : f64
  %3 = scalar.exp2f %2 : f64
  %4 = scalar.expf %3 : f64
  func.return %4 : f64
}

// ====
// RUN: roundtrip
// The small-lambda Poisson composition keeps the stopping threshold in double
// precision. Only the exponential has approximation permission.
#include <loomcxx/scalar.h>
unsigned poisson(double lambda, const double* uniforms) {
  const double limit = loom::scalar::approximate::expf(-lambda);
  unsigned count = 0;
  double product = 1.0;
  do {
    product *= uniforms[count++];
  } while (product > limit);
  return count - 1;
}
// ----
func.def public @poisson(%lambda: f64, %uniforms: buffer, %uniforms_byte_offset: offset) -> (i32) {
  %4 = scalar.negf %lambda : f64
  %limit = scalar.expf<afn> %4 : f64
  %count$6 = scalar.constant 0 : i32
  %product$7 = scalar.constant 1.0 : f64
  %product$12, %count$13 = scf.while(%product$8 = %product$7 : f64, %count$9 = %count$6 : i32) -> (f64, i32) {
    %14 = scalar.constant 1 : i32
    %count$15 = scalar.addi %count$9, %14 : i32
    %16 = scalar.extui %count$9 : i32 to i64
    %17 = scalar.constant 8 : i64
    %18 = scalar.muli %16, %17 : i64
    %19 = index.cast %uniforms_byte_offset : offset to i64
    %20 = scalar.addi %19, %18 : i64
    %21 = scalar.assume %20 [range(%20, 0, 9223372036854775807)] : i64
    %22 = index.cast %21 : i64 to offset
    %23 = buffer.view %uniforms[%22] : buffer -> view<1xf64>
    %24 = view.load %23[0] : view<1xf64> -> f64
    %product$25 = scalar.mulf %product$8, %24 : f64
    %26 = scalar.cmpf ogt, %product$25, %limit : f64
    scf.condition %26, %product$25, %count$15 : i1, f64, i32
  } do(%product: f64, %count: i32) {
    scf.yield %product, %count : f64, i32
  }
  %27 = scalar.constant 1 : i32
  %28 = scalar.subi %count$13, %27 : i32
  func.return %28 : i32
}
