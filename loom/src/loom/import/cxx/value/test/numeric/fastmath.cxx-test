    %11 = index.cast %i : offset to i32
    %12 = scalar.uitofp %11 : i32 to f32
    %13 = scalar.mulf<reassoc> %scale, %12 : f32
    %value$14 = scalar.addf<reassoc> %value$9, %13 : f32
    scf.yield %value$14 : f32
  }
