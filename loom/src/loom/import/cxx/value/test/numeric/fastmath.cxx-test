  %result$13 = scalar.mulf<reassoc|nnan|ninf|nsz|arcp|contract|afn> %left, %right : f32
  %14 = scalar.divf %left, %right : f32
  %result$15 = scalar.addf %result$13, %14 : f32
  %16 = scalar.mulf<contract> %left, %right : f32
  %result$17 = scalar.addf<contract> %result$15, %16 : f32
  %18 = scalar.addf<reassoc|nnan|ninf|nsz|arcp|contract|afn> %result$17, %right : f32
  func.return %18 : f32
}

