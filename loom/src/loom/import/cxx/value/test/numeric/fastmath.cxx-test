}

// ====
// RUN: roundtrip
float structured(float left, float right) {
  [[loom::fastmath("nnan")]] if (left > right) {
    return left + right;
  } else {
    return left - right;
  }
}
// ----
func.def public @structured(%left: f32, %right: f32) -> (f32) {
  %3 = scalar.cmpf<nnan> ogt, %left, %right : f32
  %4 = scf.if %3 -> (f32) {
    %5 = scalar.addf<nnan> %left, %right : f32
    scf.yield %5 : f32
  } else {
    %6 = scalar.subf<nnan> %left, %right : f32
    scf.yield %6 : f32
  }
  func.return %4 : f32
}

