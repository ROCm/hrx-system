// ====
// INPUT: cxx fp-model=fast
// Invocation policy is inherited and exact source contracts replace it.
float inherited(float left, float right) { return left * right + left; }

[[loom::fastmath(false)]]
float precise(float left, float right) {
  return left * right + left;
}

float mixed(float left, float right) {
  float result = left * right;
  [[loom::fastmath(false)]] { result += left / right; }
  [[loom::fastmath("contract")]] { result += left * right; }
  return result + right;
}

int integer_unchanged(int left, int right) { return left + right; }

[[loom::op("scalar.cttzi")]] unsigned count_trailing_zeros(unsigned value);
unsigned integer_intrinsic_unchanged(unsigned value) {
  return count_trailing_zeros(value);
}

using Int4 = int __attribute__((ext_vector_type(4)));
Int4 vector_integer_unchanged(Int4 left, Int4 right) { return left + right; }

// ----
