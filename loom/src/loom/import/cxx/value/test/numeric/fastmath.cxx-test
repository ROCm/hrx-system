// ====
// RUN: roundtrip
float returning_scope(float value, bool early) {
  [[loom::fastmath("nnan")]] if (early) {
    return value * value;
  }
  return value + 1.0f;
}
// ----
func.def public @returning_scope(%value: f32, %early: i1) -> (f32) {
  %3 = scf.if %early -> (f32) {
    %4 = scalar.mulf<nnan> %value, %value : f32
    scf.yield %4 : f32
  } else {
    %5 = scalar.constant 1.0 : f32
    %6 = scalar.addf %value, %5 : f32
    scf.yield %6 : f32
  }
  func.return %3 : f32
}

// ====
// RUN: roundtrip
float continuing_scope(float value, bool skip) {
  for (unsigned i = 0; i < 2; ++i) {
    [[loom::fastmath("ninf")]] if (skip) {
      value *= 2.0f;
      continue;
    }
    value += 1.0f;
  }
  return value * 3.0f;
}
// ----
func.def public @continuing_scope(%value$0: f32, %skip: i1) -> (f32) {
  %i = scalar.constant 0 : i32
  %4 = index.cast %i : i32 to offset
  %5 = scalar.constant 2 : i32
  %6 = index.cast %5 : i32 to offset
  %7 = index.constant 1 : offset
  %value$10 = scf.for %i = [%4 to %6 step %7](%value$9 = %value$0 : f32) -> (f32) {
    %11 = index.cast %i : offset to i32
    %12, %value$13 = scf.if %skip -> (i1, f32) {
      %14 = scalar.constant 2.0 : f32
      %value = scalar.mulf<ninf> %value$9, %14 : f32
      %16 = scalar.constant 0 : i1
      scf.yield %16, %value : i1, f32
    } else {
      %17 = scalar.constant 1.0 : f32
      %value = scalar.addf %value$9, %17 : f32
      %19 = scalar.constant 1 : i1
      scf.yield %19, %value : i1, f32
    }
    scf.yield %value$13 : f32
  }
  %20 = scalar.constant 3.0 : f32
  %21 = scalar.mulf %value$10, %20 : f32
  func.return %21 : f32
}

