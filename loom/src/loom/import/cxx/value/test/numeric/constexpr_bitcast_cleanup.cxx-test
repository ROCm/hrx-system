// RUN: pass canonicalize,cse,dce
using Fp8x4 = __float8_e4m3fn __attribute__((ext_vector_type(4)));
using Float4 = float __attribute__((ext_vector_type(4)));
constexpr Fp8x4 kScale = __builtin_bit_cast(Fp8x4, 0x403c3830u);
void apply_scale(const Float4* input, Float4* output) {
  *output = *input * __builtin_convertvector(kScale, Float4);
}

// ----
func.def public @apply_scale(%input: buffer, %input_byte_offset: offset, %output: buffer, %output_byte_offset: offset) {
  %4 = buffer.view %input[%input_byte_offset] : buffer -> view<4xf32>
  %5 = vector.load %4[0] : view<4xf32> -> vector<4xf32>
  %10 = vector.constantf [0.5, 1.0, 1.5, 2.0] : vector<4xf32>
  %8 = vector.mulf %5, %10 : vector<4xf32>
  %9 = buffer.view %output[%output_byte_offset] : buffer -> view<4xf32>
  vector.store %8, %9[0] : vector<4xf32>, view<4xf32>
  func.return
}

// ====
constexpr float kNaN = __builtin_bit_cast(float, 0x7f812345u);
float payload() { return kNaN; }

// ----
func.def public @payload() -> (f32) {
  %1 = scalar.constant 2139169605 : i32
  %kNaN = scalar.bitcast %1 : i32 to f32
  func.return %kNaN : f32
}

// ====
using Words4 = unsigned __attribute__((ext_vector_type(4)));
using Fp8x16 = __float8_e4m3fn __attribute__((ext_vector_type(16)));
constexpr Fp8x16 kCodebook = __builtin_bit_cast(
    Fp8x16, Words4{0xb8b0a800u, 0xbebdbbbau, 0x302800bfu, 0x3e3d3b38u});
float decode(unsigned code) { return kCodebook[code & 15u]; }

// ----
func.def public @decode(%code: i32) -> (f32) {
  %kCodebook = vector.constantf [0.0, -0.25, -0.5, -1.0, -1.25, -1.375, -1.625, -1.75, -1.875, 0.0, 0.25, 0.5, 1.0, 1.375, 1.625, 1.75] : vector<16xf8E4M3>
  %3 = scalar.constant 15 : i32
  %4 = scalar.andi %code, %3 : i32
  %5 = index.cast %4 : i32 to index
  %6 = vector.extract %kCodebook[%5] : vector<16xf8E4M3> -> f8E4M3
  %7 = scalar.extf %6 : f8E4M3 to f32
  func.return %7 : f32
}
