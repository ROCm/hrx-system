// RUN: roundtrip
// Reordering __float8_e5m2 lanes transports their bits without numeric conversion.
using Packed = __float8_e5m2 __attribute__((ext_vector_type(4)));
unsigned reorder(unsigned bits) {
  auto value = __builtin_bit_cast(Packed, bits);
  return __builtin_bit_cast(unsigned, Packed{value[3], value[2], value[1], value[0]});
}
// ----
func.def public @reorder(%bits: i32) -> (i32) {
  %2 = vector.from_elements %bits : vector<1xi32>
  %value = vector.bitcast %2 : vector<1xi32> to vector<4xf8E5M2>
  %4 = scalar.constant 3 : i32
  %5 = index.cast %4 : i32 to index
  %6 = vector.extract %value[%5] : vector<4xf8E5M2> -> f8E5M2
  %7 = scalar.constant 2 : i32
  %8 = index.cast %7 : i32 to index
  %9 = vector.extract %value[%8] : vector<4xf8E5M2> -> f8E5M2
  %10 = scalar.constant 1 : i32
  %11 = index.cast %10 : i32 to index
  %12 = vector.extract %value[%11] : vector<4xf8E5M2> -> f8E5M2
  %13 = scalar.constant 0 : i32
  %14 = index.cast %13 : i32 to index
  %15 = vector.extract %value[%14] : vector<4xf8E5M2> -> f8E5M2
  %16 = vector.from_elements %6, %9, %12, %15 : vector<4xf8E5M2>
  %17 = vector.bitcast %16 : vector<4xf8E5M2> to vector<1xi32>
  %18 = vector.extract %17[0] : vector<1xi32> -> i32
  func.return %18 : i32
}

// ====
// RUN: roundtrip
// The wide byte permutation crosses a double value without changing its payload.
using Bytes8 = unsigned char __attribute__((ext_vector_type(8)));
using Words2 = unsigned __attribute__((ext_vector_type(2)));
Words2 reorder(unsigned long long bits) {
  auto bytes = __builtin_bit_cast(Bytes8, bits);
  Bytes8 reversed{bytes[7], bytes[6], bytes[5], bytes[4],
                  bytes[3], bytes[2], bytes[1], bytes[0]};
  double payload = __builtin_bit_cast(double, reversed);
  return __builtin_bit_cast(Words2, payload);
}
// ----
func.def public @reorder(%bits: i64) -> (vector<2xi32>) {
  %2 = vector.from_elements %bits : vector<1xi64>
  %bytes = vector.bitcast %2 : vector<1xi64> to vector<8xi8>
  %4 = scalar.constant 7 : i32
  %5 = index.cast %4 : i32 to index
  %6 = vector.extract %bytes[%5] : vector<8xi8> -> i8
  %7 = scalar.constant 6 : i32
  %8 = index.cast %7 : i32 to index
  %9 = vector.extract %bytes[%8] : vector<8xi8> -> i8
  %10 = scalar.constant 5 : i32
  %11 = index.cast %10 : i32 to index
  %12 = vector.extract %bytes[%11] : vector<8xi8> -> i8
  %13 = scalar.constant 4 : i32
  %14 = index.cast %13 : i32 to index
  %15 = vector.extract %bytes[%14] : vector<8xi8> -> i8
  %16 = scalar.constant 3 : i32
  %17 = index.cast %16 : i32 to index
  %18 = vector.extract %bytes[%17] : vector<8xi8> -> i8
  %19 = scalar.constant 2 : i32
  %20 = index.cast %19 : i32 to index
  %21 = vector.extract %bytes[%20] : vector<8xi8> -> i8
  %22 = scalar.constant 1 : i32
  %23 = index.cast %22 : i32 to index
  %24 = vector.extract %bytes[%23] : vector<8xi8> -> i8
  %25 = scalar.constant 0 : i32
  %26 = index.cast %25 : i32 to index
  %27 = vector.extract %bytes[%26] : vector<8xi8> -> i8
  %reversed = vector.from_elements %6, %9, %12, %15, %18, %21, %24, %27 : vector<8xi8>
  %29 = vector.bitcast %reversed : vector<8xi8> to vector<1xf64>
  %payload = vector.extract %29[0] : vector<1xf64> -> f64
  %31 = vector.from_elements %payload : vector<1xf64>
  %32 = vector.bitcast %31 : vector<1xf64> to vector<2xi32>
  func.return %32 : vector<2xi32>
}

// ====
// RUN: roundtrip
// Constant signaling-NaN and signed-zero lanes combine with runtime payloads.
using Packed = __float8_e5m2 __attribute__((ext_vector_type(4)));
unsigned mixed(unsigned bits) {
  constexpr auto constants = __builtin_bit_cast(Packed, 0x00817d80u);
  auto value = __builtin_bit_cast(Packed, bits);
  Packed result{constants[1], value[1], constants[0], value[3]};
  return __builtin_bit_cast(unsigned, result);
}
// ----
func.def public @mixed(%bits: i32) -> (i32) {
  %2 = scalar.constant -0.0 : f8E5M2
  %3 = scalar.constant 125 : i8
  %4 = scalar.bitcast %3 : i8 to f8E5M2
  %5 = scalar.constant -1.52587890625e-05 : f8E5M2
  %6 = scalar.constant 0.0 : f8E5M2
  %constants = vector.from_elements %2, %4, %5, %6 : vector<4xf8E5M2>
  %8 = vector.from_elements %bits : vector<1xi32>
  %value = vector.bitcast %8 : vector<1xi32> to vector<4xf8E5M2>
  %10 = scalar.constant 1 : i32
  %11 = index.cast %10 : i32 to index
  %12 = vector.extract %constants[%11] : vector<4xf8E5M2> -> f8E5M2
  %13 = scalar.constant 1 : i32
  %14 = index.cast %13 : i32 to index
  %15 = vector.extract %value[%14] : vector<4xf8E5M2> -> f8E5M2
  %16 = scalar.constant 0 : i32
  %17 = index.cast %16 : i32 to index
  %18 = vector.extract %constants[%17] : vector<4xf8E5M2> -> f8E5M2
  %19 = scalar.constant 3 : i32
  %20 = index.cast %19 : i32 to index
  %21 = vector.extract %value[%20] : vector<4xf8E5M2> -> f8E5M2
  %result = vector.from_elements %12, %15, %18, %21 : vector<4xf8E5M2>
  %23 = vector.bitcast %result : vector<4xf8E5M2> to vector<1xi32>
  %24 = vector.extract %23[0] : vector<1xi32> -> i32
  func.return %24 : i32
}

// ====
// RUN: roundtrip
// A byte-vector intermediate preserves the representation across a scalar store.
using Bytes4 = unsigned char __attribute__((ext_vector_type(4)));
void store(unsigned bits, float* output) {
  auto bytes = __builtin_bit_cast(Bytes4, bits);
  *output = __builtin_bit_cast(float, bytes);
}

// ----
func.def public @store(%bits: i32, %output: buffer, %output_byte_offset: offset) {
  %3 = vector.from_elements %bits : vector<1xi32>
  %bytes = vector.bitcast %3 : vector<1xi32> to vector<4xi8>
  %5 = vector.bitcast %bytes : vector<4xi8> to vector<1xf32>
  %6 = vector.extract %5[0] : vector<1xf32> -> f32
  %7 = buffer.view %output[%output_byte_offset] : buffer -> view<1xf32>
  view.store<root_in_bounds> %6, %7[0] : f32, view<1xf32>
  func.return
}

// ====
// RUN: roundtrip
// Loading a scalar payload and projecting its bytes does not convert its value.
using Bytes4 = unsigned char __attribute__((ext_vector_type(4)));
unsigned load(const float* input) {
  auto bytes = __builtin_bit_cast(Bytes4, *input);
  return __builtin_bit_cast(unsigned, bytes);
}

// ----
func.def public @load(%input: buffer, %input_byte_offset: offset) -> (i32) {
  %3 = buffer.view %input[%input_byte_offset] : buffer -> view<1xf32>
  %4 = view.load<root_in_bounds> %3[0] : view<1xf32> -> f32
  %5 = vector.from_elements %4 : vector<1xf32>
  %bytes = vector.bitcast %5 : vector<1xf32> to vector<4xi8>
  %7 = vector.bitcast %bytes : vector<4xi8> to vector<1xi32>
  %8 = vector.extract %7[0] : vector<1xi32> -> i32
  func.return %8 : i32
}

// ====
// RUN: roundtrip
// The wide scalar store also accepts a two-word representation intermediate.
using Words2 = unsigned __attribute__((ext_vector_type(2)));
void store(unsigned long long bits, double* output) {
  auto words = __builtin_bit_cast(Words2, bits);
  *output = __builtin_bit_cast(double, words);
}

// ----
func.def public @store(%bits: i64, %output: buffer, %output_byte_offset: offset) {
  %3 = vector.from_elements %bits : vector<1xi64>
  %words = vector.bitcast %3 : vector<1xi64> to vector<2xi32>
  %5 = vector.bitcast %words : vector<2xi32> to vector<1xf64>
  %6 = vector.extract %5[0] : vector<1xf64> -> f64
  %7 = buffer.view %output[%output_byte_offset] : buffer -> view<1xf64>
  view.store<root_in_bounds> %6, %7[0] : f64, view<1xf64>
  func.return
}
