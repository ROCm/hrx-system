  %7 = scalar.constant 0 : i32
  %8 = index.cast %7 : i32 to index
  %9 = vector.extract %value[%8] : vector<2xbf16> -> bf16
  %10 = vector.from_elements %6, %9 : vector<2xbf16>
  %11 = vector.bitcast %10 : vector<2xbf16> to vector<1xi32>
