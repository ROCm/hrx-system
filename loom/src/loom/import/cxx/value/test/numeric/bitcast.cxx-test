// ====
enum class Word : unsigned {};
using Bytes4 = unsigned char __attribute__((ext_vector_type(4)));
Bytes4 entry(Word value) { return __builtin_bit_cast(Bytes4, value); }

// ----
func.def public @entry(%value: i32) -> (vector<4xi8>) {
  %2 = vector.from_elements %value : vector<1xi32>
  %3 = vector.bitcast %2 : vector<1xi32> to vector<4xi8>
  func.return %3 : vector<4xi8>
}

// ====
bool entry(bool value) { return __builtin_bit_cast(bool, value); }

// ----
func.def public @entry(%value: i1) -> (i1) {
  func.return %value : i1
}

// ====
using Float8x4 = __float8_e4m3fn __attribute__((ext_vector_type(4)));
using Floats4 = float __attribute__((ext_vector_type(4)));
unsigned entry(unsigned bits, float factor) {
  auto packed = __builtin_bit_cast(Float8x4, bits);
  auto wide = __builtin_convertvector(packed, Floats4);
  auto scaled = __builtin_convertvector(wide * factor, Float8x4);
  return __builtin_bit_cast(unsigned, scaled);
}

// ----
func.def public @entry(%bits: i32, %factor: f32) -> (i32) {
  %3 = vector.from_elements %bits : vector<1xi32>
  %packed = vector.bitcast %3 : vector<1xi32> to vector<4xf8E4M3>
  %wide = vector.extf %packed : vector<4xf8E4M3> to vector<4xf32>
  %6 = vector.splat %factor : vector<4xf32>
  %7 = vector.mulf %wide, %6 : vector<4xf32>
  %scaled = vector.fptrunc %7 : vector<4xf32> to vector<4xf8E4M3>
  %9 = vector.bitcast %scaled : vector<4xf8E4M3> to vector<1xi32>
  %10 = vector.extract %9[0] : vector<1xi32> -> i32
  func.return %10 : i32
}

// ====
// RUN: roundtrip
// Byte order and lane addition stay explicit between the two bit casts.
using Bytes4 = unsigned char __attribute__((ext_vector_type(4)));
unsigned reorder(unsigned bits) {
  auto bytes = __builtin_bit_cast(Bytes4, bits);
  Bytes4 reversed{bytes[3], bytes[2], bytes[1], bytes[0]};
  return __builtin_bit_cast(unsigned, reversed + Bytes4{1, 2, 3, 4});
}
// ----
func.def public @reorder(%bits: i32) -> (i32) {
  %2 = vector.from_elements %bits : vector<1xi32>
  %bytes = vector.bitcast %2 : vector<1xi32> to vector<4xi8>
  %4 = scalar.constant 3 : i32
  %5 = index.cast %4 : i32 to index
  %6 = vector.extract %bytes[%5] : vector<4xi8> -> i8
  %7 = scalar.constant 2 : i32
  %8 = index.cast %7 : i32 to index
  %9 = vector.extract %bytes[%8] : vector<4xi8> -> i8
  %10 = scalar.constant 1 : i32
  %11 = index.cast %10 : i32 to index
  %12 = vector.extract %bytes[%11] : vector<4xi8> -> i8
  %13 = scalar.constant 0 : i32
  %14 = index.cast %13 : i32 to index
  %15 = vector.extract %bytes[%14] : vector<4xi8> -> i8
  %reversed = vector.from_elements %6, %9, %12, %15 : vector<4xi8>
  %17 = vector.constanti [1, 2, 3, 4] : vector<4xi8>
  %18 = vector.addi %reversed, %17 : vector<4xi8>
  %19 = vector.bitcast %18 : vector<4xi8> to vector<1xi32>
  %20 = vector.extract %19[0] : vector<1xi32> -> i32
  func.return %20 : i32
}

// ====
// RUN: roundtrip
// Reordering _Float16 lanes transports their bits without numeric conversion.
using Packed = _Float16 __attribute__((ext_vector_type(2)));
unsigned reorder(unsigned bits) {
  auto value = __builtin_bit_cast(Packed, bits);
  return __builtin_bit_cast(unsigned, Packed{value[1], value[0]});
}
// ----
func.def public @reorder(%bits: i32) -> (i32) {
  %2 = vector.from_elements %bits : vector<1xi32>
  %value = vector.bitcast %2 : vector<1xi32> to vector<2xf16>
  %4 = scalar.constant 1 : i32
  %5 = index.cast %4 : i32 to index
  %6 = vector.extract %value[%5] : vector<2xf16> -> f16
  %7 = scalar.constant 0 : i32
  %8 = index.cast %7 : i32 to index
  %9 = vector.extract %value[%8] : vector<2xf16> -> f16
  %10 = vector.from_elements %6, %9 : vector<2xf16>
  %11 = vector.bitcast %10 : vector<2xf16> to vector<1xi32>
  %12 = vector.extract %11[0] : vector<1xi32> -> i32
  func.return %12 : i32
}

