// RUN: roundtrip
using Bytes4 = unsigned char __attribute__((ext_vector_type(4)));
unsigned entry(Bytes4 value) { return __builtin_bit_cast(unsigned, value); }

// ----
func.def public @entry(%value: vector<4xi8>) -> (i32) {
  %2 = vector.bitcast %value : vector<4xi8> to vector<1xi32>
  %3 = vector.extract %2[0] : vector<1xi32> -> i32
  func.return %3 : i32
}

// ====
using Bytes4 = unsigned char __attribute__((ext_vector_type(4)));
Bytes4 entry(unsigned value) { return __builtin_bit_cast(Bytes4, value); }

// ----
func.def public @entry(%value: i32) -> (vector<4xi8>) {
  %2 = vector.from_elements %value : vector<1xi32>
  %3 = vector.bitcast %2 : vector<1xi32> to vector<4xi8>
  func.return %3 : vector<4xi8>
}

