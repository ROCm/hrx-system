  func.return %12 : i32
}

// ====
// RUN: roundtrip
// Reordering __float8_e4m3fn lanes transports their bits without numeric conversion.
using Packed = __float8_e4m3fn __attribute__((ext_vector_type(4)));
unsigned reorder(unsigned bits) {
  auto value = __builtin_bit_cast(Packed, bits);
  return __builtin_bit_cast(unsigned, Packed{value[1], value[3], value[0], value[2]});
}
// ----
func.def public @reorder(%bits: i32) -> (i32) {
  %2 = vector.from_elements %bits : vector<1xi32>
  %value = vector.bitcast %2 : vector<1xi32> to vector<4xf8E4M3>
  %4 = scalar.constant 1 : i32
  %5 = index.cast %4 : i32 to index
  %6 = vector.extract %value[%5] : vector<4xf8E4M3> -> f8E4M3
  %7 = scalar.constant 3 : i32
  %8 = index.cast %7 : i32 to index
  %9 = vector.extract %value[%8] : vector<4xf8E4M3> -> f8E4M3
  %10 = scalar.constant 0 : i32
  %11 = index.cast %10 : i32 to index
  %12 = vector.extract %value[%11] : vector<4xf8E4M3> -> f8E4M3
  %13 = scalar.constant 2 : i32
  %14 = index.cast %13 : i32 to index
  %15 = vector.extract %value[%14] : vector<4xf8E4M3> -> f8E4M3
  %16 = vector.from_elements %6, %9, %12, %15 : vector<4xf8E4M3>
  %17 = vector.bitcast %16 : vector<4xf8E4M3> to vector<1xi32>
  %18 = vector.extract %17[0] : vector<1xi32> -> i32
  func.return %18 : i32
}

