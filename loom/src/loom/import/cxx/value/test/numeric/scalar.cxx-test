// RUN: roundtrip
// Promotions and assignment conversions produce verified IR.
unsigned long long shift(unsigned long long x, unsigned count) {
  return x << count;
}
unsigned char narrow(unsigned char x) {
  x += 300;
  ++x;
  return x;
}
unsigned char retreat(unsigned char x) {
  x--;
  return x;
}
short signed_retreat(short x) {
  --x;
  return x;
}
unsigned long long increment(unsigned long long x) {
  ++x;
  return x;
}
bool truth(double x) { return bool(x); }
double widen(bool x) { return double(x); }
// ----
func.def public @shift(%x: i64, %count: i32) -> (i64) {
  %3 = scalar.extui %count : i32 to i64
  %4 = scalar.shli %x, %3 : i64
  func.return %4 : i64
}

func.def public @narrow(%x$5: i8) -> (i8) {
  %7 = scalar.constant 300 : i32
  %8 = scalar.extui %x$5 : i8 to i32
  %9 = scalar.addi %8, %7 : i32
  %x$10 = scalar.trunci %9 : i32 to i8
  %11 = scalar.extui %x$10 : i8 to i32
  %12 = scalar.constant 1 : i32
  %13 = scalar.addi %11, %12 : i32
  %x$14 = scalar.trunci %13 : i32 to i8
  func.return %x$14 : i8
}

func.def public @retreat(%x$15: i8) -> (i8) {
  %17 = scalar.extui %x$15 : i8 to i32
  %18 = scalar.constant 1 : i32
  %19 = scalar.subi %17, %18 : i32
  %x$20 = scalar.trunci %19 : i32 to i8
  func.return %x$20 : i8
}

func.def public @signed_retreat(%x$21: i16) -> (i16) {
  %23 = scalar.extsi %x$21 : i16 to i32
  %24 = scalar.constant 1 : i32
  %25 = scalar.subi %23, %24 : i32
  %x$26 = scalar.trunci %25 : i32 to i16
  func.return %x$26 : i16
}

func.def public @increment(%x$27: i64) -> (i64) {
  %29 = scalar.constant 1 : i64
  %x$30 = scalar.addi %x$27, %29 : i64
  func.return %x$30 : i64
}

func.def public @truth(%x: f64) -> (i1) {
  %33 = scalar.constant 0.0 : f64
  %34 = scalar.cmpf une, %x, %33 : f64
  func.return %34 : i1
}

func.def public @widen(%x: i1) -> (f64) {
  %37 = scalar.uitofp %x : i1 to f64
  func.return %37 : f64
}

// ====
// RUN: roundtrip
// Intrinsic calls retain their flags and scalar types.
[[loom::op("scalar.expf", "afn")]] float approximate(float);
[[loom::op("scalar.maxnumf")]] double maximum(double, double);
[[loom::op("scalar.sqrtf")]] _Float16 root(_Float16);
float entry(float x) { return approximate(x); }
double wide(double x) { return maximum(x, 1.0); }
_Float16 narrow(_Float16 x) { return root(x); }
// ----
func.def public @entry(%x: f32) -> (f32) {
  %2 = scalar.expf<afn> %x : f32
  func.return %2 : f32
}

func.def public @wide(%x: f64) -> (f64) {
  %5 = scalar.constant 1.0 : f64
  %6 = scalar.maxnumf %x, %5 : f64
  func.return %6 : f64
}

func.def public @narrow(%x: f16) -> (f16) {
  %9 = scalar.sqrtf %x : f16
  func.return %9 : f16
}

// ====
// RUN: roundtrip
// Global constants retain their source widths.
constexpr int factor = 3;
int entry(int x) { return x * factor; }
constexpr unsigned mask = 0xffffffffu;
unsigned bits() { return mask; }
constexpr unsigned char byte = 255;
unsigned char small() { return byte; }
// ----
func.def public @entry(%x: i32) -> (i32) {
  %factor = scalar.constant 3 : i32
  %3 = scalar.muli %x, %factor : i32
  func.return %3 : i32
}

func.def public @bits() -> (i32) {
  %mask = scalar.constant -1 : i32
  func.return %mask : i32
}

func.def public @small() -> (i8) {
  %byte = scalar.constant -1 : i8
  func.return %byte : i8
}

// ====
// RUN: roundtrip
double post_increment(double* value) { return (*value)++; }
_Float16 pre_decrement(_Float16 value) { return --value; }

// ----
func.def public @post_increment(%value: buffer, %value_byte_offset: offset) -> (f64) {
  %3 = buffer.view %value[%value_byte_offset] : buffer -> view<1xf64>
  %4 = view.load %3[0] : view<1xf64> -> f64
  %5 = scalar.constant 1 : i32
  %6 = scalar.sitofp %5 : i32 to f64
  %7 = scalar.addf %4, %6 : f64
  view.store %7, %3[0] : f64, view<1xf64>
  func.return %4 : f64
}

func.def public @pre_decrement(%value$8: f16) -> (f16) {
  %10 = scalar.constant 1 : i32
  %11 = scalar.sitofp %10 : i32 to f16
  %value$12 = scalar.subf %value$8, %11 : f16
  func.return %value$12 : f16
}
