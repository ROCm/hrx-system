  %2 = scalar.constant 1 : i32
  %value$3 = scalar.addi %value$0, %2 : i32
  %4 = scalar.constant 1 : i32
  %5 = scalar.andi %value$0, %4 : i32
  %6 = scalar.constant 0 : i32
  %7 = scalar.cmpi ne, %5, %6 : i32
  %selected, %value$9 = scf.if %7 -> (i32, i32) {
    %10 = scalar.constant 1 : i32
    %value = scalar.addi %value$3, %10 : i32
    scf.yield %value, %value : i32, i32
  } else {
    %12 = scalar.constant 1 : i32
    %value = scalar.subi %value$3, %12 : i32
    scf.yield %value$3, %value : i32, i32
  }
  %14 = scalar.constant 17 : i32
  %15 = scalar.muli %value$9, %14 : i32
  %16 = scalar.xori %selected, %15 : i32
  func.return %16 : i32
}

// ====
// RUN: roundtrip
// The last false condition still increments the induction value.
unsigned increment_while(unsigned count) {
  unsigned index = 0;
  unsigned total = 0;
  while (index++ < count) {
    total += index;
  }
  return total * 257u + index;
}
// ----
