// RUN: roundtrip
// Pre/post results observe byte truncation after each individual update.
unsigned increment_byte(unsigned input) {
  unsigned char value = (unsigned char)input;
  unsigned previous = (value)++;
  unsigned next = ++(value);
  unsigned retreat = value--;
  unsigned final = --value;
  return previous | (next << 8) | (retreat << 16) | (final << 24);
}
// ----
func.def public @increment_byte(%input: i32) -> (i32) {
  %value$2 = scalar.trunci %input : i32 to i8
  %3 = scalar.extui %value$2 : i8 to i32
  %4 = scalar.constant 1 : i32
  %5 = scalar.addi %3, %4 : i32
  %value$6 = scalar.trunci %5 : i32 to i8
  %previous = scalar.extui %value$2 : i8 to i32
  %8 = scalar.extui %value$6 : i8 to i32
  %9 = scalar.constant 1 : i32
  %10 = scalar.addi %8, %9 : i32
  %value$11 = scalar.trunci %10 : i32 to i8
  %next = scalar.extui %value$11 : i8 to i32
  %13 = scalar.extui %value$11 : i8 to i32
  %14 = scalar.constant 1 : i32
  %15 = scalar.subi %13, %14 : i32
  %value$16 = scalar.trunci %15 : i32 to i8
  %retreat = scalar.extui %value$11 : i8 to i32
  %18 = scalar.extui %value$16 : i8 to i32
  %19 = scalar.constant 1 : i32
  %20 = scalar.subi %18, %19 : i32
  %value$21 = scalar.trunci %20 : i32 to i8
  %final = scalar.extui %value$21 : i8 to i32
  %23 = scalar.constant 8 : i32
  %24 = scalar.shli %next, %23 : i32
  %25 = scalar.ori %previous, %24 : i32
  %26 = scalar.constant 16 : i32
  %27 = scalar.shli %retreat, %26 : i32
  %28 = scalar.ori %25, %27 : i32
  %29 = scalar.constant 24 : i32
  %30 = scalar.shli %final, %29 : i32
  %31 = scalar.ori %28, %30 : i32
  func.return %31 : i32
}

// ====
// RUN: roundtrip
// Postdecrement returns the old signed value; predecrement returns the updated value.
int decrement_short(int input) {
  short value = (short)input;
  int previous = value--;
  int next = --value;
  return previous * 65536 + next + 32768;
}
// ----
func.def public @decrement_short(%input: i32) -> (i32) {
  %value$2 = scalar.trunci %input : i32 to i16
  %3 = scalar.extsi %value$2 : i16 to i32
  %4 = scalar.constant 1 : i32
  %5 = scalar.subi %3, %4 : i32
  %value$6 = scalar.trunci %5 : i32 to i16
  %previous = scalar.extsi %value$2 : i16 to i32
  %8 = scalar.extsi %value$6 : i16 to i32
  %9 = scalar.constant 1 : i32
  %10 = scalar.subi %8, %9 : i32
  %value$11 = scalar.trunci %10 : i32 to i16
  %next = scalar.extsi %value$11 : i16 to i32
  %13 = scalar.constant 65536 : i32
  %14 = scalar.muli %previous, %13 : i32
  %15 = scalar.addi %14, %next : i32
  %16 = scalar.constant 32768 : i32
  %17 = scalar.addi %15, %16 : i32
  func.return %17 : i32
}

// ====
// RUN: roundtrip
// Chained updates keep the original and final wide values distinct.
unsigned long long increment_wide(unsigned long long value) {
  unsigned long long previous = value++;
  unsigned long long next = ++value;
  return previous ^ (next * 17ull) ^ (value * 3ull);
}
// ----
func.def public @increment_wide(%value$0: i64) -> (i64) {
  %2 = scalar.constant 1 : i64
  %value$3 = scalar.addi %value$0, %2 : i64
  %4 = scalar.constant 1 : i64
  %value$5 = scalar.addi %value$3, %4 : i64
  %6 = scalar.constant 17 : i64
  %7 = scalar.muli %value$5, %6 : i64
  %8 = scalar.xori %value$0, %7 : i64
  %9 = scalar.constant 3 : i64
  %10 = scalar.muli %value$5, %9 : i64
  %11 = scalar.xori %8, %10 : i64
  func.return %11 : i64
}

// ====
// RUN: roundtrip
// Each short-circuit join carries the update only when its operand was reached.
unsigned increment_chain(unsigned value) {
  unsigned visits = 0;
  bool accepted = value < 256u && visits++ < 1u && value < 128u &&
                  visits++ < 2u && value < 64u && visits++ < 3u &&
                  value < 32u && visits++ < 4u && value < 16u &&
                  visits++ < 5u && value < 8u && visits++ < 6u && value < 4u;
  return visits + (accepted ? 256u : 0u);
}
// ----
