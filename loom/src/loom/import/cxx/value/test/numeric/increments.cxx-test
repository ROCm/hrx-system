    scf.yield %34, %visits$26 : i1, i32
  } else {
    scf.yield %25, %visits$26 : i1, i32
  }
  %35, %visits$36 = scf.if %31 -> (i1, i32) {
    %37 = scalar.constant 1 : i32
    %visits = scalar.addi %visits$32, %37 : i32
    %39 = scalar.constant 4 : i32
    %40 = scalar.cmpi ult, %visits$32, %39 : i32
    scf.yield %40, %visits : i1, i32
  } else {
    scf.yield %31, %visits$32 : i1, i32
  }
  %41, %visits$42 = scf.if %35 -> (i1, i32) {
