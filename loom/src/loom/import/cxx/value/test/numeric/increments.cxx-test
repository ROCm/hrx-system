// ====
// RUN: roundtrip
// The condition update precedes either arm and is visible in its result.
unsigned increment_condition(unsigned value) {
  unsigned selected = (value++ & 1u) ? ++value : value--;
  return selected ^ (value * 17u);
}
// ----
