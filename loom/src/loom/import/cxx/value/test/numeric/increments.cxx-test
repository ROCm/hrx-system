    %7 = scalar.constant 1 : i32
    %visits = scalar.addi %visits$2, %7 : i32
    %9 = scalar.constant 1 : i32
    %10 = scalar.cmpi ult, %visits$2, %9 : i32
    scf.yield %10, %visits : i1, i32
  } else {
    scf.yield %4, %visits$2 : i1, i32
  }
  %11, %visits$12 = scf.if %5 -> (i1, i32) {
    %13 = scalar.constant 128 : i32
    %14 = scalar.cmpi ult, %value, %13 : i32
    scf.yield %14, %visits$6 : i1, i32
  } else {
    scf.yield %5, %visits$6 : i1, i32
  }
  %15, %visits$16 = scf.if %11 -> (i1, i32) {
    %17 = scalar.constant 1 : i32
    %visits = scalar.addi %visits$12, %17 : i32
    %19 = scalar.constant 2 : i32
    %20 = scalar.cmpi ult, %visits$12, %19 : i32
    scf.yield %20, %visits : i1, i32
  } else {
    scf.yield %11, %visits$12 : i1, i32
  }
  %21, %visits$22 = scf.if %15 -> (i1, i32) {
    %23 = scalar.constant 64 : i32
    %24 = scalar.cmpi ult, %value, %23 : i32
    scf.yield %24, %visits$16 : i1, i32
  } else {
    scf.yield %15, %visits$16 : i1, i32
  }
  %25, %visits$26 = scf.if %21 -> (i1, i32) {
    %27 = scalar.constant 1 : i32
    %visits = scalar.addi %visits$22, %27 : i32
    %29 = scalar.constant 3 : i32
    %30 = scalar.cmpi ult, %visits$22, %29 : i32
    scf.yield %30, %visits : i1, i32
  } else {
    scf.yield %21, %visits$22 : i1, i32
  }
  %31, %visits$32 = scf.if %25 -> (i1, i32) {
    %33 = scalar.constant 32 : i32
