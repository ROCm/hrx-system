  %total$3 = scalar.constant 0 : i32
  %index$8, %total$9 = scf.while(%index$4 = %index$2 : i32, %total = %total$3 : i32) -> (i32, i32) {
    %10 = scalar.constant 1 : i32
    %index$11 = scalar.addi %index$4, %10 : i32
    %12 = scalar.cmpi ult, %index$4, %count : i32
    scf.condition %12, %index$11, %total : i1, i32, i32
  } do(%index: i32, %total$7: i32) {
    %total$13 = scalar.addi %total$7, %index : i32
    scf.yield %index, %total$13 : i32, i32
  }
  %14 = scalar.constant 257 : i32
  %15 = scalar.muli %total$9, %14 : i32
  %16 = scalar.addi %15, %index$8 : i32
  func.return %16 : i32
}

// ====
// RUN: roundtrip
// Post-test conditions update state after the first body execution.
unsigned increment_do(unsigned count) {
  unsigned index = 0;
  unsigned total = 0;
  do {
    total += index;
  } while (++index < count);
  return total * 257u + index;
}
