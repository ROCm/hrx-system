// ====
// RUN: roundtrip
// A true left operand preserves the unincremented state.
unsigned increment_or(unsigned value, unsigned choose) {
  unsigned visits = value;
  bool accepted = choose || visits++ < 128u;
  return visits * 2u + (unsigned)accepted;
}
// ----
func.def public @increment_or(%value: i32, %choose: i32) -> (i32) {
  %3 = scalar.constant 0 : i32
  %4 = scalar.cmpi ne, %choose, %3 : i32
  %accepted, %visits = scf.if %4 -> (i1, i32) {
    scf.yield %4, %value : i1, i32
  } else {
    %7 = scalar.constant 1 : i32
    %visits = scalar.addi %value, %7 : i32
    %9 = scalar.constant 128 : i32
    %10 = scalar.cmpi ult, %value, %9 : i32
    scf.yield %10, %visits : i1, i32
  }
  %11 = scalar.constant 2 : i32
  %12 = scalar.muli %visits, %11 : i32
  %13 = scalar.extui %accepted : i1 to i32
  %14 = scalar.addi %12, %13 : i32
  func.return %14 : i32
}

// ====
// RUN: roundtrip
// Nested selections update only the selected narrow lvalue and join both states.
unsigned increment_select(unsigned input, unsigned choose) {
  unsigned char first = (unsigned char)input;
  unsigned char second = (unsigned char)(input * 3u + 1u);
  unsigned value = (choose & 1u) ? first++ : --second;
  unsigned nested =
      (choose & 2u) ? ((choose & 4u) ? ++first : second--) : first--;
  return value | (nested << 8) | ((unsigned)first << 16) |
         ((unsigned)second << 24);
}
