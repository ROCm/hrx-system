// ====
// RUN: roundtrip
// roundf retains the float operand and result.
#include <loomcxx/scalar.h>
float rounded(float value) { return loom::scalar::roundf(value); }
// ----
func.def public @rounded(%value: f32) -> (f32) {
  %2 = scalar.roundf %value : f32
  func.return %2 : f32
}

// ====
// RUN: roundtrip
// Arithmetic stays in the selected source precision before rounding.
#include <loomcxx/scalar.h>
float candidate(float value) {
  return loom::scalar::floorf(value + float(0.5));
}
float bucket(float value) {
  return loom::scalar::roundf(float(256) * value + float(65536));
}
// ----
func.def public @candidate(%value: f32) -> (f32) {
  %2 = scalar.constant 0.5 : f64
  %3 = scalar.fptrunc %2 : f64 to f32
  %4 = scalar.addf %value, %3 : f32
  %5 = scalar.floorf %4 : f32
  func.return %5 : f32
}

func.def public @bucket(%value: f32) -> (f32) {
  %8 = scalar.constant 256 : i32
  %9 = scalar.sitofp %8 : i32 to f32
  %10 = scalar.mulf %9, %value : f32
  %11 = scalar.constant 65536 : i32
  %12 = scalar.sitofp %11 : i32 to f32
  %13 = scalar.addf %10, %12 : f32
  %14 = scalar.roundf %13 : f32
  func.return %14 : f32
}

