// RUN: roundtrip
// ceilf retains the float operand and result.
#include <loomcxx/scalar.h>
float rounded(float value) { return loom::scalar::ceilf(value); }
// ----
func.def public @rounded(%value: f32) -> (f32) {
  %2 = scalar.ceilf %value : f32
  func.return %2 : f32
}

// ====
// RUN: roundtrip
// floorf retains the float operand and result.
#include <loomcxx/scalar.h>
float rounded(float value) { return loom::scalar::floorf(value); }
