// ====
// RUN: roundtrip
// Arithmetic stays in the selected source precision before rounding.
#include <loomcxx/scalar.h>
double candidate(double value) {
  return loom::scalar::floorf(value + double(0.5));
}
double bucket(double value) {
  return loom::scalar::roundf(double(256) * value + double(65536));
}
// ----
func.def public @candidate(%value: f64) -> (f64) {
  %2 = scalar.constant 0.5 : f64
  %3 = scalar.addf %value, %2 : f64
  %4 = scalar.floorf %3 : f64
  func.return %4 : f64
}

func.def public @bucket(%value: f64) -> (f64) {
  %7 = scalar.constant 256 : i32
  %8 = scalar.sitofp %7 : i32 to f64
  %9 = scalar.mulf %8, %value : f64
  %10 = scalar.constant 65536 : i32
  %11 = scalar.sitofp %10 : i32 to f64
  %12 = scalar.addf %9, %11 : f64
  %13 = scalar.roundf %12 : f64
  func.return %13 : f64
}
