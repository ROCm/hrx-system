// RUN: verify
// Unions do not have an unconditional component partition.
union Value { unsigned integer; float real; };
// ERROR@+1: LOWERING/059 "record values require a complete non-union type without virtual members"
Value entry(Value value) { return value; }

// ====
// Aggregate defaults can observe only the completed initialization prefix.
// ERROR@+1: LOWERING/059 "member is read before its initialization is complete"
struct Value { unsigned first = second; unsigned second = 9u; };
Value entry() { return Value{}; }

// ====
// Virtual bases require a dynamic object-layout contract.
struct Base { unsigned base; };
struct Value : virtual Base { unsigned member; };
// ERROR@+1: LOWERING/059 "virtual base objects require a dynamic object layout"
Value entry(Value value) { return value; }

// ====
// Virtual members require an explicit dynamic-object representation.
struct Value { unsigned member; virtual unsigned read() { return member; } };
// ERROR@+1: LOWERING/059 "record values require a complete non-union type without virtual members"
Value entry(Value value) { return value; }

// ====
// Bitfields require source storage semantics.
struct Value { unsigned member : 7; };
// ERROR@+1: LOWERING/059 "record value fields cannot be bitfields"
Value entry(Value value) { return value; }

// ====
// Public value signatures cannot erase owned volatile observations.
struct Value { volatile unsigned member; };
// ERROR@+1: LOWERING/059 "identity-sensitive object signatures require an internal ordinary function definition"
Value entry(Value value) { return value; }

// ====
// Byte reinterpretation cannot use the flattened value transport as C++ layout.
struct Value { unsigned member; };
// ERROR@+1: LOWERING/059 "unsupported C++ type: ::Value"
unsigned entry(Value value) { return __builtin_bit_cast(unsigned, value); }

// ====
// Ordinary record arguments do not change the kernel launch ABI.
struct Value { unsigned member; };
// ERROR@+1: LOWERING/059 "unsupported C++ type: ::Value"
[[loom::kernel]] void entry(Value value, unsigned* output) { output[0]=value.member; }

// ====
// A constant address retains source storage identity and cannot be flattened
// into the immutable component transport used by record values.
constexpr unsigned storage = 7;
struct Value { const unsigned* pointer; };
constexpr Value value{&storage};
Value entry() {
  // ERROR@+1: LOWERING/059 "constant addresses require an addressable source object"
  return value;
}

// ====
// A semantic handle has its own dialect representation, not a base layout.
template<class T> struct [[loom::type("buffer")]] Buffer { T* data; };
struct Value : Buffer<unsigned> { unsigned tag; };
// ERROR@+1: LOWERING/059 "Loom semantic handles cannot be base subobjects"
Value entry(Value value) { return value; }
