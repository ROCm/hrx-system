// RUN: roundtrip
// Empty, two-scalar and nested records retain source identity across calls.
struct Empty {};
struct Pair { unsigned first, second; };
struct Packet { Empty tag; Pair pair; bool valid; };
Empty empty(Empty value) { return value; }
Pair pair(Pair value) { Pair copy(value); copy.second++; return copy; }
Packet packet(Packet value, unsigned choose) {
  Packet copy{value};
  copy.pair = pair(copy.pair);
  copy.tag = empty(copy.tag);
  if (choose) copy.pair.first += 3u;
  return choose ? copy : value;
}
unsigned temporary(unsigned value) { return Pair{value, 7u}.first; }
// ----
func.def public @empty() {
  func.return
}

func.def public @pair(%value_first: i32, %value_second: i32) -> (i32, i32) {
  %4 = scalar.constant 1 : i32
  %copy_second = scalar.addi %value_second, %4 : i32
  func.return %value_first, %copy_second : i32, i32
}

func.def public @packet(%value_pair_first: i32, %value_pair_second: i32, %value_valid: i1, %choose: i32) -> (i32, i32, i1) {
  %copy_pair_first$13, %copy_pair_second$14 = func.call pure @pair(%value_pair_first, %value_pair_second) : (i32, i32) -> (i32, i32)
  func.call pure @empty() : ()
  %15 = scalar.constant 0 : i32
  %16 = scalar.cmpi ne, %choose, %15 : i32
  %copy_pair_first$17, %copy_pair_second$18, %copy_valid = scf.if %16 -> (i32, i32, i1) {
    %20 = scalar.constant 3 : i32
    %copy_pair_first = scalar.addi %copy_pair_first$13, %20 : i32
    scf.yield %copy_pair_first, %copy_pair_second$14, %value_valid : i32, i32, i1
  } else {
    scf.yield %copy_pair_first$13, %copy_pair_second$14, %value_valid : i32, i32, i1
  }
  %22 = scalar.constant 0 : i32
  %23 = scalar.cmpi ne, %choose, %22 : i32
  %24, %25, %26 = scf.if %23 -> (i32, i32, i1) {
    scf.yield %copy_pair_first$17, %copy_pair_second$18, %copy_valid : i32, i32, i1
  } else {
    scf.yield %value_pair_first, %value_pair_second, %value_valid : i32, i32, i1
  }
  func.return %24, %25, %26 : i32, i32, i1
}

func.def public @temporary(%value: i32) -> (i32) {
  %29 = scalar.constant 7 : i32
  func.return %value : i32
}

// ====
// RUN: pass canonicalize,cse,dce
// Template instantiation rechecks an array-valued default member initializer
// as element initialization rather than an invalid array copy.
struct EosState { double xn[4]{}; };
template <typename T>
static double update_eos_state(const T* input, unsigned index) {
  EosState state{};
  state.xn[index & 3u] = input[index];
  return state.xn[index & 3u];
}
double eos_state(const double* input, unsigned index) {
  return update_eos_state(input, index);
}
// ----
func.def public @eos_state(%input: buffer, %input_byte_offset: offset, %index: i32) -> (f64) {
  %4 = func.call readonly @update_eos_state_double(%input, %input_byte_offset, %index) : (buffer, offset, i32) -> (f64)
  func.return %4 : f64
}

func.def @update_eos_state_double(%input: buffer, %input_byte_offset: offset, %index: i32) -> (f64) {
  %zero$f64 = scalar.constant 0.0 : f64
  %13 = scalar.extui %index : i32 to i64
  %62 = scalar.constant 3 : i64
  %63 = scalar.shli %13, %62 : i64
  %16 = index.cast %input_byte_offset : offset to i64
  %17 = scalar.addi %16, %63 : i64
  %18 = scalar.assume %17 [range(%17, 0, 9223372036854775807)] : i64
  %19 = index.cast %18 : i64 to offset
  %20 = buffer.view %input[%19] : buffer -> view<1xf64>
  %21 = view.load<root_in_bounds> %20[0] : view<1xf64> -> f64
  %22 = scalar.constant 3 : i32
  %23 = scalar.andi %index, %22 : i32
  %24 = scalar.constant 0 : i32
  %25 = scalar.cmpi eq, %23, %24 : i32
  %state_xn_0 = scf.select %25, %21, %zero$f64 : f64
  %27 = scalar.constant 1 : i32
  %28 = scalar.cmpi eq, %23, %27 : i32
  %state_xn_1 = scf.select %28, %21, %zero$f64 : f64
  %30 = scalar.constant 2 : i32
  %31 = scalar.cmpi eq, %23, %30 : i32
  %state_xn_2 = scf.select %31, %21, %zero$f64 : f64
  %34 = scalar.cmpi eq, %23, %22 : i32
  %state_xn_3 = scf.select %34, %21, %zero$f64 : f64
  %39 = scalar.cmpi ult, %23, %30 : i32
  %55 = scf.select %39, %25, %31 : i1
  %56 = scf.select %39, %state_xn_0, %state_xn_2 : f64
  %57 = scf.select %39, %state_xn_1, %state_xn_3 : f64
  %54 = scf.select %55, %56, %57 : f64
  func.return %54 : f64
}

// ====
// INPUT: cxx data-model=lp64
// RUN: verify
// Source layouts remain independent of flattened High component order.
#include "record_values.cxx"
static_assert(sizeof(State) == 32);
static_assert(sizeof(void*) == 8 && sizeof(long) == 8);

// ====
// INPUT: cxx data-model=llp64
// RUN: verify
#include "record_values.cxx"
static_assert(sizeof(State) == 32);
static_assert(sizeof(void*) == 8 && sizeof(long) == 4);

// ====
// INPUT: cxx data-model=ilp32
// RUN: verify
#include "record_values.cxx"
static_assert(sizeof(State) == 32);
static_assert(sizeof(void*) == 4 && sizeof(long) == 4);
