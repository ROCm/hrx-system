// ====
// Copying the complete receiver reads its field values without requesting
// physical identity. Later changes to either object preserve the copy.
struct Cursor {
  float* pointer;
  int length;
  Cursor shifted(int amount) const {
    Cursor copy = *this;
    copy.pointer += amount;
    copy.length -= amount;
    return copy;
  }
  Cursor advance(int amount) {
    Cursor previous = *this;
    pointer += amount;
    length -= amount;
    return previous;
  }
};
float copy_receiver(float* input, int amount) {
  Cursor cursor{input, 8};
  auto shifted = cursor.shifted(amount);
  auto previous = cursor.advance(amount);
  return shifted.pointer[0] + previous.pointer[0] + cursor.length;
}

