// ====
// Trivial member copies read their record operands in either initializer form.
struct Coordinates { int values[3]; };
struct Bounds {
  Coordinates lower, upper;
  Bounds(const Coordinates& first, const Coordinates& last) : lower(first), upper{last} {}
  int length() const { return upper.values[0] - lower.values[0]; }
};
struct Body {
  Coordinates first, last;
  int length() const { Bounds bounds(first, last); return bounds.length(); }
};
int copied_bounds(int length) {
  Body body{{{0, 0, 0}}, {{length, length, length}}};
  return body.length();
}
