// ====
// Projected value calls and retained reference results keep the same nonzero
// base/member displacement when raised and imported again.
struct Prefix { int tag; };
struct Bounds { int lower, upper; };
struct Record : Prefix, Bounds {};
static int read(const Record& record) { return record.upper; }
static const int& reference(const Record& record) { return record.upper; }
int stored_record(const Record* record) { return read(*record) + reference(*record); }
// ----
#include <loomcxx/view.h>

struct reference_result {
  loom::type::buffer<unsigned char> value0;
  loom::type::index value1;
};

[[loom::symbol("stored_record")]]
