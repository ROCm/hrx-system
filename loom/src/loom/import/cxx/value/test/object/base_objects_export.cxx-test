// RUN: emit cxx roundtrip
// Raising preserves base selection and destruction as ordinary calls and SSA
// operands, without depending on the original inheritance spelling.
void observe(unsigned);
struct Base {
  unsigned value;
  [[loom::inline]] void add(unsigned delta) { value += delta; }
  ~Base() { observe(value); }
};
struct Left : Base {};
struct Right : Base {};
struct Both : Left, Right { unsigned extra; };
unsigned update(unsigned input) {
  Both value{{{input}}, {{7}}, 11};
  value.Right::add(3);
  return value.Left::value + value.Right::value * 5 + value.extra;
}
