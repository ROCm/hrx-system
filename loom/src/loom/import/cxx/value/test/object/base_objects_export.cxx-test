[[loom::symbol("Base___Base_value"), loom::inline]]
static void Base___Base_value(unsigned this_value);

[[loom::symbol("observe")]]
void observe(unsigned v19);

[[loom::symbol("update")]]
unsigned update(unsigned input) {
  unsigned value_Right_Base_value_1 = Base__add_value(7u, 3u);
  Both___Both_value(input, value_Right_Base_value_1);
  return ((input + (value_Right_Base_value_1 * 5u)) + 11u);
}

