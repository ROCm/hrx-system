// RUN: verify
// Rejects mutation of const objects and bindings.
// ERROR@+1: PARSE/036 "cannot assign to a non-modifiable lvalue of type 'const int'"
void store(const int* p) { p[0u] = 1; }

// ====
// RUN: verify
// Rejects mutation of const objects and bindings.
int entry() {
  const int value = 1;
  // ERROR@+1: PARSE/036 "cannot assign to a non-modifiable lvalue of type 'const int'"
  value = 2;
  return value;
}

// ====
// RUN: verify
// Rejects mutation of const objects and bindings.
int entry() {
  const int value = 1;
  // ERROR@+1: PARSE/036 "cannot assign to a non-modifiable lvalue of type 'const int'"
  value += 2;
  return value;
}

// ====
// RUN: verify
// Rejects mutation of const objects and bindings.
// ERROR@+1: PARSE/036 "cannot assign to a non-modifiable lvalue of type 'int* const'"
void entry(int* const p, int* q) { p = q; }

// ====
// RUN: verify
// Rejects mutation of const objects and bindings.
// ERROR@+1: PARSE/036 "cannot assign to a non-modifiable lvalue of type 'int* const'"
void entry(int* const p) { p += 1; }

// ====
// RUN: verify
// Rejects mutation of const objects and bindings.
int entry() {
  const int value = 1;
  // ERROR@+1: PARSE/036 "cannot increment a non-modifiable lvalue of type 'const int'"
  ++value;
  return value;
}

// ====
// RUN: roundtrip
// Const bindings permit reads and writes through mutable pointees.
int entry(int* const output, const int* input) {
  const int value = input[0u];
  output[0u] = value;
  return value;
}
// ----
func.def public @entry(%output: buffer, %output_byte_offset: index, %input: buffer, %input_byte_offset: index) -> (i32) {
  %5 = scalar.constant 0 : i32
  %6 = scalar.extui %5 : i32 to i64
  %7 = index.cast %6 : i64 to index
  %8 = index.constant 4 : index
  %9 = index.mul %7, %8 : index
  %10 = index.add %input_byte_offset, %9 : index
  %11 = buffer.view %input[%10] : buffer -> view<1xi32>
  %value = view.load<root_in_bounds|type_disjoint> %11[0] : view<1xi32> -> i32
  %13 = scalar.constant 0 : i32
  %14 = scalar.extui %13 : i32 to i64
  %15 = index.cast %14 : i64 to index
  %16 = index.constant 4 : index
  %17 = index.mul %15, %16 : index
  %18 = index.add %output_byte_offset, %17 : index
  %19 = buffer.view %output[%18] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %value, %19[0] : i32, view<1xi32>
  func.return %value : i32
}
