// RUN: verify
// An explicit conversion cannot supply a builtin operand implicitly.
struct Scalar {
  explicit operator unsigned() const;
};
unsigned entry(Scalar value) {
  // ERROR@+1: PARSE/036 "invalid operands to binary expression ('::Scalar' and 'unsigned int')"
  return value * 3u;
}

// ====
// Distinct arithmetic conversion destinations do not select an arbitrary type.
struct Scalar {
  operator unsigned() const;
  operator int() const;
};
unsigned entry(Scalar value) {
  // ERROR@+1: PARSE/036 "invalid operands to binary expression ('int' and '::Scalar')"
  return 1 << value;
}

// ====
// A floating conversion cannot turn bitwise arithmetic into floating arithmetic.
struct Scalar {
  operator float() const;
};
unsigned entry(Scalar value) {
  // ERROR@+1: PARSE/036 "invalid operands to binary expression ('float' and 'float')"
  return value & 3u;
}

// ====
// Operand conversion does not make a runtime conversion function constexpr.
struct Scalar {
  operator unsigned() const { return 5; }
};
constexpr Scalar value{};
// ERROR@+1: PARSE/036 "constexpr variable must be initialized"
constexpr unsigned result = value * 3u;

// ====
// The selected conversion function still enforces deletion.
struct Scalar {
  operator unsigned() const = delete;
};
unsigned entry(Scalar value) {
  // ERROR@+1: PARSE/036 "use of deleted function 'operator unsigned int'"
  unsigned shifted = 1u << value;
  // ERROR@+1: PARSE/036 "use of deleted function 'operator unsigned int'"
  return shifted + value;
}

// ====
// A non-const conversion function cannot be called on a const object.
struct Scalar {
  operator unsigned();
};
unsigned entry(const Scalar value) {
  // ERROR@+1: PARSE/036 "invalid operands to binary expression ('const ::Scalar' and 'unsigned int')"
  return value % 3u;
}
