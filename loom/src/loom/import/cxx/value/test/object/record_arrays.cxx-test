// RUN: pass canonicalize,cse,dce
// Arrays decay to borrowed pointers. The two fields retain separate origins.
struct Block {
  unsigned tag;
  unsigned char scales[4];
  unsigned char quants[128];
};
static unsigned read(const unsigned char* values, unsigned index) {
  return values[index];
}
unsigned decode(const Block* blocks, unsigned block, unsigned index) {
  return read(blocks[block].scales, index / 32) + blocks[block].quants[index];
}

// ----
func.def public @decode(%blocks: buffer, %blocks_byte_offset: index, %block: i32, %index: i32) -> (i32) {
  %5 = scalar.extui %block : i32 to i64
  %6 = index.cast %5 : i64 to index
  %7 = index.constant 136 : index
  %46 = index.madd %6, %7, %blocks_byte_offset : index
  %10 = index.constant 4 : index
  %scales_byte_offset = index.add %46, %10 : index
  %44 = scalar.constant 5 : i32
  %45 = scalar.shrui %index, %44 : i32
  %14 = func.call readonly @read(%blocks, %scales_byte_offset, %45) : (buffer, index, i32) -> (i32)
  %20 = index.constant 8 : index
  %quants_byte_offset = index.add %46, %20 : index
  %22 = scalar.extui %index : i32 to i64
  %23 = index.cast %22 : i64 to index
  %26 = index.add %quants_byte_offset, %23 : index
  %27 = buffer.view %blocks[%26] : buffer -> view<1xi8>
  %28 = view.load<root_in_bounds> %27[0] : view<1xi8> -> i8
  %29 = scalar.extui %28 : i8 to i32
  %30 = scalar.addi %14, %29 : i32
  func.return %30 : i32
}

func.def @read(%values: buffer, %values_byte_offset: index, %index: i32) -> (i32) {
  %35 = scalar.extui %index : i32 to i64
  %36 = index.cast %35 : i64 to index
  %39 = index.add %values_byte_offset, %36 : index
  %40 = buffer.view %values[%39] : buffer -> view<1xi8>
  %41 = view.load<root_in_bounds> %40[0] : view<1xi8> -> i8
  %42 = scalar.extui %41 : i8 to i32
  func.return %42 : i32
}

// ====
// Each subscript consumes one array extent, including pointer-to-array steps.
struct Matrix { unsigned tag; short values[3][5]; };
short* row(Matrix* matrices, unsigned matrix, unsigned index) {
  return *(matrices[matrix].values + index);
}
short element(Matrix* matrices, unsigned matrix, unsigned index) {
  auto* rows = &matrices[matrix].values;
  return (*rows)[index][4];
}
void update(short (*rows)[5], unsigned row, unsigned column, short value) {
  rows[row][column] = value;
}

// ----
func.def public @row(%matrices: buffer, %matrices_byte_offset: index, %matrix: i32, %index: i32) -> (buffer, index) {
  %6 = scalar.extui %matrix : i32 to i64
  %7 = index.cast %6 : i64 to index
  %8 = index.constant 36 : index
  %59 = index.madd %7, %8, %matrices_byte_offset : index
  %11 = index.constant 4 : index
  %values_byte_offset = index.add %59, %11 : index
  %13 = scalar.extui %index : i32 to i64
  %14 = index.cast %13 : i64 to index
  %15 = index.constant 10 : index
  %58 = index.madd %14, %15, %values_byte_offset : index
  func.return %matrices, %58 : buffer, index
}

func.def public @element(%matrices: buffer, %matrices_byte_offset: index, %matrix: i32, %index: i32) -> (i16) {
  %23 = scalar.extui %matrix : i32 to i64
  %24 = index.cast %23 : i64 to index
  %25 = index.constant 36 : index
  %64 = index.madd %24, %25, %matrices_byte_offset : index
  %28 = index.constant 4 : index
  %rows_byte_offset = index.add %64, %28 : index
  %30 = scalar.extui %index : i32 to i64
  %31 = index.cast %30 : i64 to index
  %32 = index.constant 10 : index
  %63 = index.madd %31, %32, %rows_byte_offset : index
  %61 = index.constant 8 : index
  %62 = index.add %63, %61 : index
  %40 = buffer.view %matrices[%62] : buffer -> view<1xi16>
  %41 = view.load<root_in_bounds|type_disjoint> %40[0] : view<1xi16> -> i16
  func.return %41 : i16
}

func.def public @update(%rows: buffer, %rows_byte_offset: index, %row: i32, %column: i32, %value: i16) {
  %47 = scalar.extui %row : i32 to i64
  %48 = index.cast %47 : i64 to index
  %49 = index.constant 10 : index
  %66 = index.madd %48, %49, %rows_byte_offset : index
  %52 = scalar.extui %column : i32 to i64
  %53 = index.cast %52 : i64 to index
  %54 = index.constant 2 : index
  %65 = index.madd %53, %54, %66 : index
  %57 = buffer.view %rows[%65] : buffer -> view<1xi16>
  view.store<root_in_bounds|type_disjoint> %value, %57[0] : i16, view<1xi16>
  func.return
}

// ====
// Array elements keep nested record layout and whole-vector load/store types.
using Float4 = float __attribute__((ext_vector_type(4)));
struct Record { unsigned tag; Float4 values[2]; };
struct Batch { unsigned count; Record records[3]; };
Float4 update(Batch* batches, unsigned batch, unsigned record, unsigned index) {
  auto* values = batches[batch].records[record].values;
  values[index] += Float4{1.0f, 2.0f, 3.0f, 4.0f};
  return values[index];
}

// ----
func.def public @update(%batches: buffer, %batches_byte_offset: index, %batch: i32, %record: i32, %index: i32) -> (vector<4xf32>) {
  %6 = scalar.extui %batch : i32 to i64
  %7 = index.cast %6 : i64 to index
  %8 = index.constant 160 : index
  %39 = index.madd %7, %8, %batches_byte_offset : index
  %11 = index.constant 16 : index
  %records_byte_offset = index.add %39, %11 : index
  %13 = scalar.extui %record : i32 to i64
  %14 = index.cast %13 : i64 to index
  %15 = index.constant 48 : index
  %38 = index.madd %14, %15, %records_byte_offset : index
  %values_byte_offset = index.add %38, %11 : index
  %20 = vector.constantf [1.0, 2.0, 3.0, 4.0] : vector<4xf32>
  %21 = scalar.extui %index : i32 to i64
  %22 = index.cast %21 : i64 to index
  %37 = index.madd %22, %11, %values_byte_offset : index
  %26 = buffer.view %batches[%37] : buffer -> view<4xf32>
  %27 = vector.load<root_in_bounds> %26[0] : view<4xf32> -> vector<4xf32>
  %28 = vector.addf %27, %20 : vector<4xf32>
  vector.store<root_in_bounds> %28, %26[0] : vector<4xf32>, view<4xf32>
  %35 = vector.load<root_in_bounds> %26[0] : view<4xf32> -> vector<4xf32>
  func.return %35 : vector<4xf32>
}

// ====
// Volatile propagates through the array and its elements, including decay.
struct Observed { unsigned tag; unsigned values[4]; };
unsigned update(volatile Observed* records, unsigned record, unsigned index) {
  auto* values = records[record].values;
  unsigned previous = values[index]++;
  return previous + records[record].values[index];
}

// ----
func.def public @update(%records: buffer, %records_byte_offset: index, %record: i32, %index: i32) -> (i32) {
  %5 = scalar.extui %record : i32 to i64
  %6 = index.cast %5 : i64 to index
  %7 = index.constant 20 : index
  %39 = index.madd %6, %7, %records_byte_offset : index
  %10 = index.constant 4 : index
  %values_byte_offset = index.add %39, %10 : index
  %12 = scalar.extui %index : i32 to i64
  %13 = index.cast %12 : i64 to index
  %38 = index.madd %13, %10, %values_byte_offset : index
  %17 = buffer.view %records[%38] : buffer -> view<1xi32>
  %previous = view.load<volatile|root_in_bounds|type_disjoint> %17[0] : view<1xi32> -> i32
  %19 = scalar.constant 1 : i32
  %20 = scalar.addi %previous, %19 : i32
  view.store<volatile|root_in_bounds|type_disjoint> %20, %17[0] : i32, view<1xi32>
  %34 = view.load<volatile|root_in_bounds|type_disjoint> %17[0] : view<1xi32> -> i32
  %35 = scalar.addi %previous, %34 : i32
  func.return %35 : i32
}

// ====
// Addressing a shared array through a differently shaped alias retains origin.
#include <loomcxx/kernel.h>
[[loom::kernel, loom::workgroup_size(32, 1, 1)]]
void shared_rows(unsigned* output) {
  [[loom::workgroup]] unsigned words[64];
  auto* rows = reinterpret_cast<unsigned (*)[32]>(&words);
  unsigned index = loom::kernel::workitem::id.x;
  rows[1][index] = index;
  output[index] = words[index + 32];
}

// ----
kernel.def @shared_rows() {
  %workgroup_count_x = config.get @shared_rows.workgroup_count.x : index
  %workgroup_count_y = config.get @shared_rows.workgroup_count.y : index
  %workgroup_count_z = config.get @shared_rows.workgroup_count.z : index
  %7 = index.constant 32 : index
  %8 = index.constant 1 : index
  kernel.launch.config workgroups(%workgroup_count_x, %workgroup_count_y, %workgroup_count_z) workgroup_size(%7, %8, %8) : index
} launch(%output: buffer) {
  %11 = index.constant 256 : offset
  %words = buffer.alloca<workgroup> align(4) %11 : buffer
  %words_byte_offset = index.constant 0 : index
  %words_view = buffer.view %words[%words_byte_offset] : buffer -> view<64xi32>
  %workitem_id_x = kernel.workitem.id<x> : index
  %index = index.cast %workitem_id_x : index to i32
  %42 = index.constant 128 : index
  %22 = scalar.extui %index : i32 to i64
  %23 = index.cast %22 : i64 to index
  %24 = index.constant 4 : index
  %41 = index.madd %23, %24, %42 : index
  %27 = index.assume %41 [range(%41, 0, 252)] : index
  %28 = buffer.view %words[%27] : buffer -> view<1xi32>
  view.store<type_disjoint> %index, %28[0] : i32, view<1xi32>
  %29 = scalar.constant 32 : i32
  %30 = scalar.addi %index, %29 : i32
  %31 = scalar.extui %30 : i32 to i64
  %32 = scalar.assume %31 [range(%31, 0, 63)] : i64
  %33 = index.cast %32 : i64 to index
  %34 = view.load<type_disjoint> %words_view[%33] : view<64xi32> -> i32
  %38 = index.mul %23, %24 : index
  %40 = buffer.view %output[%38] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %34, %40[0] : i32, view<1xi32>
  kernel.return
}

config.decl @shared_rows.workgroup_count.x : index

config.decl @shared_rows.workgroup_count.y : index

config.decl @shared_rows.workgroup_count.z : index

// ====
// Workgroup record arrays retain one aggregate allocation while each field is
// projected with its C++ byte offset and scalar type.
#include <loomcxx/kernel.h>
struct SharedRecord {
  // Leading byte payload exercises record padding before the next field.
  unsigned char tag;
  // Naturally aligned scalar payload.
  unsigned sequence;
  // Nested array payload addressed within each record element.
  float values[2];
};
[[loom::kernel, loom::workgroup_size(4, 1, 1)]]
void shared_records(unsigned* output, float* values) {
  [[loom::workgroup]] SharedRecord records[4];
  unsigned index = loom::kernel::workitem::id.x;
  records[index].tag = 3;
  records[index].sequence = index + 7;
  records[index].values[1] = 2.0f;
  output[index] = records[index].sequence + records[index].tag;
  values[index] = records[index].values[1];
}

// ----
kernel.def @shared_records() {
  %workgroup_count_x = config.get @shared_records.workgroup_count.x : index
  %workgroup_count_y = config.get @shared_records.workgroup_count.y : index
  %workgroup_count_z = config.get @shared_records.workgroup_count.z : index
  %8 = index.constant 4 : index
  %9 = index.constant 1 : index
  kernel.launch.config workgroups(%workgroup_count_x, %workgroup_count_y, %workgroup_count_z) workgroup_size(%8, %9, %9) : index
} launch(%output: buffer, %values: buffer) {
  %13 = index.constant 64 : offset
  %records = buffer.alloca<workgroup> align(4) %13 : buffer
  %workitem_id_x = kernel.workitem.id<x> : index
  %index = index.cast %workitem_id_x : index to i32
  %111 = scalar.constant 3 : i8
  %21 = scalar.extui %index : i32 to i64
  %22 = index.cast %21 : i64 to index
  %23 = index.constant 16 : index
  %24 = index.mul %22, %23 : index
  %28 = index.assume %24 [range(%24, 0, 63)] : index
  %29 = buffer.view %records[%28] : buffer -> view<1xi8>
  view.store %111, %29[0] : i8, view<1xi8>
  %30 = scalar.constant 7 : i32
  %31 = scalar.addi %index, %30 : i32
  %37 = index.constant 4 : index
  %110 = index.madd %22, %23, %37 : index
  %39 = index.assume %110 [range(%110, 0, 60)] : index
  %40 = buffer.view %records[%39] : buffer -> view<1xi32>
  view.store<type_disjoint> %31, %40[0] : i32, view<1xi32>
  %41 = scalar.constant 2.0 : f32
  %47 = index.constant 8 : index
  %values_byte_offset = index.madd %22, %23, %47 : index
  %53 = index.add %values_byte_offset, %37 : index
  %54 = index.assume %53 [range(%53, 0, 60)] : index
  %55 = buffer.view %records[%54] : buffer -> view<1xf32>
  view.store<type_disjoint> %41, %55[0] : f32, view<1xf32>
  %sequence = view.load<type_disjoint> %40[0] : view<1xi32> -> i32
  %tag = view.load %29[0] : view<1xi8> -> i8
  %76 = scalar.extui %tag : i8 to i32
  %77 = scalar.addi %sequence, %76 : i32
  %81 = index.mul %22, %37 : index
  %83 = buffer.view %output[%81] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %77, %83[0] : i32, view<1xi32>
  %98 = view.load<type_disjoint> %55[0] : view<1xf32> -> f32
  %104 = buffer.view %values[%81] : buffer -> view<1xf32>
  view.store<root_in_bounds|type_disjoint> %98, %104[0] : f32, view<1xf32>
  kernel.return
}

config.decl @shared_records.workgroup_count.x : index

config.decl @shared_records.workgroup_count.y : index

config.decl @shared_records.workgroup_count.z : index
