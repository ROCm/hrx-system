// RUN: roundtrip
unsigned captureless(unsigned value) {
  return [](unsigned input) { return input + 1u; }(value);
}

unsigned value_capture(unsigned value) {
  auto add = [value](unsigned input) { return value + input; };
  return add(2u);
}

unsigned mutable_capture(unsigned value) {
  auto increment = [value]() mutable { return ++value; };
  return increment() + increment();
}

unsigned reference_capture(unsigned value) {
  auto add = [&value](unsigned amount) { value += amount; };
  add(3u);
  return value;
}

unsigned init_capture(unsigned value) {
  auto scale = [factor = value * 2u](unsigned input) {
    return factor * input;
  };
  return scale(3u);
}

unsigned generic_capture(unsigned value) {
  auto add = [value](auto input) { return value + input; };
  return add(4u);
}

