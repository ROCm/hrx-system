// A captured this pointer retains the identity of its outer object. Unqualified
// outer members in operator() project through that pointer.
struct Owner {
  static constexpr int bias = 7;
  int value;

  int add(int amount) {
    auto apply = [this](int input) { return bias + value + input; };
    return apply(amount);
  }
};

int this_capture(int owner_value) {
  Owner owner{owner_value};
  return owner.add(6);
}

