int selected(int* output, int value, bool upper, unsigned index) {
  State state{output, {{value, value + 1}, {value + 2, value + 3}}};
  int* pointer = state.box.select(upper);
  pointer[index] += 4;
  return state.box.lower[index] * 3 + state.box.upper[index] * 5;
}
