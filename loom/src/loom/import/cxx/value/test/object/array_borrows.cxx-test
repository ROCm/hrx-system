// ====
// Nested value receivers and reference parameters preserve array-result
// origins across the complete call chain.
struct Box {
  int lower[3];
  int upper[3];
  const int* lo() const { return lower; }
  const int* hi() const { return upper; }
};
struct Fill {
  void operator()(int index, int* output, const Box& box) const {
    const auto& lower = box.lo();
    const auto& upper = box.hi();
    output[index] = index < lower[0] || index > upper[0];
  }
};
struct Body {
  int* output;
  Box box;
  Fill fill;
  void operator()(int index) const { fill(index, output, box); }
};
void boundary(int* output, int index, int lower, int upper) {
  Body body{output, {{lower, lower, lower}, {upper, upper, upper}}, {}};
  body(index);
}
