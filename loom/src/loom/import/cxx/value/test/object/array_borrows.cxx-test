// ====
// Const pointer references and copied pointer aliases retain one evaluated
// owner rather than snapshots of its elements.
struct Box {
  int values[3];
  const int* data() const { return values; }
};
struct State { int* output; Box box; };
int accessor(int* output, int value, unsigned index) {
  State state{output, {{value, value + 1, value + 2}}};
  const auto& pointer = state.box.data();
  const auto* copy = pointer;
  state.box.values[index] += 7;
  return copy[index] + pointer[0];
}
