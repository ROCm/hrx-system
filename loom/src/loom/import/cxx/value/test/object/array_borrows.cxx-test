// ====
// Returning one of several arrays transports only the selected identity;
// subsequent reads still see later mutations to that array.
struct Box {
  int lower[2];
  int upper[2];
  int* select(bool upper) { if (upper) return this->upper; return lower; }
};
struct State { int* output; Box box; };
int selected(int* output, int value, bool upper, unsigned index) {
  State state{output, {{value, value + 1}, {value + 2, value + 3}}};
  int* pointer = state.box.select(upper);
  pointer[index] += 4;
  return state.box.lower[index] * 3 + state.box.upper[index] * 5;
}
