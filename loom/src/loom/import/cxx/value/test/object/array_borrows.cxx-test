// RUN: roundtrip
// Borrowed fixed-array elements remain the current source object, including
// writes through either spelling after the pointer is initialized.
struct State { int* output; int bounds[3]; };
int observe(int* output, int value, unsigned index) {
  State state{output, {value, value + 1, value + 2}};
  int* pointer = state.bounds;
  int before = pointer[index];
  state.bounds[index] = value + 10;
  int after = index[pointer];
  pointer[index] += 3;
  return before + after + state.bounds[index];
}
int first(int* output, int value) {
  State state{output, {value, value + 1, value + 2}};
  int* pointer = state.bounds;
  *pointer += 5;
  return *pointer + state.bounds[0];
}
