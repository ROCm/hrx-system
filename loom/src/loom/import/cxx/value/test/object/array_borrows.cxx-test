// ====
// A closure captures an accessor beside arrays whose pointer-returning
// methods are used by a separate function.
struct Array { double* data; double& operator()(int index) const { return data[index]; } };
struct Geometry {
  double lower[3];
  double step[3];
  const double* origin() const { return lower; }
  const double* spacing() const { return step; }
};
static void initialize(int index, const Array& array, const Geometry& geometry) {
  const double* lower = geometry.origin();
  const double* step = geometry.spacing();
  array(index) = lower[0] + (index + 0.5) * step[0];
}
void closure(double* output, double lower, double step, int index) {
  Array array{output};
  Geometry geometry{{lower, lower, lower}, {step, step, step}};
  auto body = [=](int index) { initialize(index, array, geometry); };
  body(index);
}
