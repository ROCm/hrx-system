// ====
// Borrowed result identities carry reads and writes through reference
// parameters, even while the callee's array extent is still being resolved.
struct Box { int values[2]; int* data() { return values; } };
struct State { int* output; Box box; };
static int update(State& state, unsigned index) {
  int* pointer = state.box.data();
  for (unsigned turn = 0; turn < 2; ++turn) pointer[index] += 4 + turn;
  return pointer[index];
}
int forwarded(int* output, int value, unsigned index) {
  State state{output, {{value, value + 1}}};
  int observed = update(state, index);
  return observed + state.box.values[index];
}
