// RUN: pass inline-callables,promote-private-fragments,canonicalize,cse,dce
// Built-in pointer uses and a by-value overload become value reads only after
// the generic call operator's dependent operands have concrete types.
template<class Index>
[[loom::inline]] static int read_value(const int* input, Index index) { return input[index]; }

int dependent_operations(const int* input, int index) {
  auto read = [&](auto step) {
    const int* next = input + step;
    const int* previous = input - step;
    return step[input] + *next + *previous + read_value(input, step);
  };
  return read(index) + read(static_cast<long>(index));
}

// ----
func.def public @dependent_operations(%input: buffer, %input_byte_offset: index, %index: i32) -> (i32) {
  %12 = index.cast %index : i32 to index
  %13 = index.constant 4 : index
  %next_byte_offset$85 = index.madd %12, %13, %input_byte_offset : index
  %18 = index.mul %12, %13 : index
  %previous_byte_offset$19 = index.sub %input_byte_offset, %18 : index
  %24 = buffer.view %input[%next_byte_offset$85] : buffer -> view<1xi32>
  %25 = view.load<root_in_bounds|type_disjoint> %24[0] : view<1xi32> -> i32
  %28 = scalar.addi %25, %25 : i32
  %29 = buffer.view %input[%previous_byte_offset$19] : buffer -> view<1xi32>
  %30 = view.load<root_in_bounds|type_disjoint> %29[0] : view<1xi32> -> i32
  %31 = scalar.addi %28, %30 : i32
  %33 = scalar.addi %31, %25 : i32
  %5 = scalar.extsi %index : i32 to i64
  %38 = index.cast %5 : i64 to index
  %next_byte_offset$82 = index.madd %38, %13, %input_byte_offset : index
  %44 = index.mul %38, %13 : index
  %previous_byte_offset$45 = index.sub %input_byte_offset, %44 : index
  %50 = buffer.view %input[%next_byte_offset$82] : buffer -> view<1xi32>
  %51 = view.load<root_in_bounds|type_disjoint> %50[0] : view<1xi32> -> i32
  %54 = scalar.addi %51, %51 : i32
  %55 = buffer.view %input[%previous_byte_offset$45] : buffer -> view<1xi32>
  %56 = view.load<root_in_bounds|type_disjoint> %55[0] : view<1xi32> -> i32
  %57 = scalar.addi %54, %56 : i32
  %59 = scalar.addi %57, %51 : i32
  %7 = scalar.addi %33, %59 : i32
  func.return %7 : i32
}

// ====
// Discarded identity uses do not constrain the instantiated operator. Copying
// or forwarding the closure preserves the same selected capture fields.
template<bool Mutates> struct Mode { static constexpr bool mutates = Mutates; };
template<class Function>
[[loom::inline]] static int copied_call(Function function, int index) { return function(index); }

int discarded_mutation(const int* input, int index) {
  auto selected = [&](auto mode) {
    if constexpr (decltype(mode)::mutates) { ++input; }
    return input[index];
  };
  auto read = [&](auto step) {
    return [input, step] { return input[step]; }();
  };
  return selected(Mode<false>{}) + copied_call(read, index);
}

// ----
func.def public @discarded_mutation(%input: buffer, %input_byte_offset: index, %index: i32) -> (i32) {
  %19 = index.cast %index : i32 to index
  %20 = index.constant 4 : index
  %46 = index.madd %19, %20, %input_byte_offset : index
  %23 = buffer.view %input[%46] : buffer -> view<1xi32>
  %24 = view.load<root_in_bounds|type_disjoint> %23[0] : view<1xi32> -> i32
  %11 = scalar.addi %24, %24 : i32
  func.return %11 : i32
}

// ====
struct Sample {
  int value;
  int read() { return value + 10; }
  int read() const { return value + 20; }
};

struct Readings {
  int copy;
  int reference;
  int mutable_copy;
};

Readings capture_overloads() {
  Sample input{1};
  return {
    [=] { return input.read(); }(),
    [&] { return input.read(); }(),
    [=]() mutable { return input.read(); }(),
  };
}

// ----
func.def public @capture_overloads() -> (i32, i32, i32) {
  %54 = scalar.constant 21 : i32
  %53 = scalar.constant 11 : i32
  func.return %54, %53, %53 : i32, i32, i32
}

// ====
// The branch updates the captured objects through storage. Only the mutable
// value capture carries a new binding into the next invocation.
struct Totals { int positive, negative, count; };

Totals split_signs() {
  int positive = 0, negative = 0;
  auto add = [&, count = 0](int value) mutable {
    if (value > 0) { positive += value; ++count; }
    else { negative += value; }
    return count;
  };
  add(4);
  int count = add(-3);
  return {positive, negative, count};
}

// ----
func.def public @split_signs() -> (i32, i32, i32) {
  %68 = scalar.constant 4 : i32
  %count = scalar.constant 1 : i32
  %70 = scalar.constant -3 : i32
  func.return %68, %70, %count : i32, i32, i32
}
