// The raised program retains each pointer to the same numeric subobject.
struct View { int* data; int bounds[2]; };
static int update(int* pointer, View& owner) {
  owner.bounds[1] = 12;
  return pointer[1];
}
int shared(const int value) {
  View view{nullptr, {value, value}};
  return update(view.bounds, view);
}
