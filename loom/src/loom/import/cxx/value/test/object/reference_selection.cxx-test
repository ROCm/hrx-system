// RUN: roundtrip
// Independent automatic references use one ordinary call. Each selected
// source binding receives its own updated result.
[[loom::noinline]] static void replace(unsigned& left, unsigned& right,
                                      unsigned next) {
  left = next;
  right = next + 1u;
}
unsigned selected(bool choose_left, bool choose_right, unsigned first,
                  unsigned second, unsigned third, unsigned fourth,
                  unsigned next) {
  unsigned& left = choose_left ? first : second;
  unsigned& right = choose_right ? third : fourth;
  replace(left, right, next);
  return first + second + third + fourth;
}

