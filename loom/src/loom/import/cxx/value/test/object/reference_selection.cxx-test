func.def public @projected(%input: i32, %next: i32) -> (i32) {
  %value_prefix = scalar.constant 1 : i32
  %value_pair_first = scalar.constant 2 : i32
  %value_suffix = scalar.constant 3 : i32
  %value_pair_second = func.call pure @Envelope__update_value(%value_prefix, %value_pair_first, %input, %value_suffix, %next) : (i32, i32, i32, i32, i32) -> (i32)
  %7 = scalar.addi %value_pair_second, %value_suffix : i32
  func.return %7 : i32
}

func.def @Envelope__update_value(%this_prefix: i32, %this_pair_first: i32, %this_pair_second: i32, %this_suffix: i32, %next: i32) -> (i32) {
  func.call pure @Envelope__self_value(%this_prefix, %this_pair_first, %this_pair_second, %this_suffix) : (i32, i32, i32, i32)
  func.return %next : i32
}

func.def @Envelope__self_value(%this_prefix: i32, %this_pair_first: i32, %this_pair_second: i32, %this_suffix: i32) {
  func.return
}

// ====
// Dynamic writes carry only the selected field through each region. The
// neighboring semantic pointer and copied record keep their original values.
struct Item {
  // Semantic member outside the selected update.
  int* data;
  // Independently updated scalar member.
  unsigned value;
};
struct Items {
  // First selection candidate.
  Item first;
  // Second selection candidate.
  Item second;
  // Third selection candidate.
  Item third;
};
unsigned update(int* data, unsigned choice, unsigned next) {
  Items items{{data, 1u}, {data, 2u}, {data, 3u}};
  const auto saved = items;
  Item& selected = choice == 0u ? items.first : choice == 1u ? items.second : items.third;
  selected.value = next;
  return items.first.value + 10u * items.second.value + 100u * items.third.value + 1000u * saved.first.value;
}

