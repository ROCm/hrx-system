// ====
// Wide selected-reference reads use a balanced ordinal tree. The source
// choice is evaluated once, and no read path is deeper than log2(N).
unsigned selected_read(unsigned choice, unsigned first, unsigned second,
                       unsigned third, unsigned fourth) {
  unsigned& selected = choice == 0u   ? first
                       : choice == 1u ? second
                       : choice == 2u ? third
                                      : fourth;
  return selected;
}

