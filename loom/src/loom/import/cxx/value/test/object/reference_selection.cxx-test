// ====
// A returned reference that may designate either a stored subobject or an
// automatic value uses the storage ABI. The automatic alternative is promoted
// once so both choices retain one uniform identity representation.
struct StoredPair {
  unsigned first;
  unsigned second;
};
[[loom::noinline]] static unsigned& mixed_storage_reference(
    bool stored, StoredPair& pair, unsigned& value) {
  return stored ? pair.second : value;
}
