  %2 = func.call pure @Cell__observe_value(%input) : (i32) -> (i32)
  func.return %2 : i32
}

func.def @Cell__observe_value(%this_payload: i32) -> (i32) {
  func.call pure @Cell__self_value(%this_payload) : (i32)
  %5 = func.call pure @inspect(%this_payload) : (i32) -> (i32)
  %6 = func.call pure @inspect(%this_payload) : (i32) -> (i32)
  %7 = scalar.addi %5, %6 : i32
  func.return %7 : i32
}

func.def @inspect(%value_payload: i32) -> (i32) {
  func.return %value_payload : i32
}

func.def @Cell__self_value(%this_payload: i32) {
  func.return
}

// ====
// A nested assignment through a returned receiver updates only its owning
// field in the callable signature; neighboring fields stay unchanged.
struct Pair {
  // Neighbor retained unchanged by the nested assignment.
  unsigned first;
  // Subobject replaced through the returned receiver.
  unsigned second;
};
struct Envelope {
  // Leading field outside the written range.
  unsigned prefix;
  // Direct field carrying the nested writeback.
  Pair pair;
  // Trailing field outside the written range.
  unsigned suffix;
  Envelope& self() { return *this; }
  void update(unsigned next) { self().pair.second = next; }
};
unsigned projected(unsigned input, unsigned next) {
  Envelope value{1u, {2u, input}, 3u};
  value.update(next);
  return value.pair.second + value.suffix;
}

