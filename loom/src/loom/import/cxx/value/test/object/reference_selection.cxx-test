// ====
// A reference result projects one of several semantic record elements from a
// value-backed parameter. Forwarding the result through another call keeps the
// pointer-bearing owner in SSA form and writes only the selected scalar field.
struct ProjectedCell {
  unsigned* data;
  unsigned marker;
};
struct ProjectedArray {
  ProjectedCell values[3];
  [[loom::noinline]] ProjectedCell& operator[](unsigned index) {
    return values[index];
  }
};
[[loom::noinline]] static ProjectedCell& forward_projected_cell(
    ProjectedArray& array, unsigned index) {
  return array[index];
}
unsigned projected_call_reference(unsigned* data, unsigned index,
                                  unsigned next) {
  ProjectedArray array{{{data, 1u}, {data, 2u}, {data, 3u}}};
  ProjectedCell& selected = forward_projected_cell(array, index);
  selected.marker = next;
  return array.values[0].marker + 10u * array.values[1].marker +
         100u * array.values[2].marker;
}

