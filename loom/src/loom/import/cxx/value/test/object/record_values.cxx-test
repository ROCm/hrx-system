// ====
// RUN: pass canonicalize,cse,dce
// Nested snapshots and conditional selections retain each component origin
// across helpers and independent output writes. Pointer-field updates preserve
// the copied pointer. Scalar helper bodies are asserted in preceding cases.
struct Empty {};
struct Pair {
  // First independently transported scalar field.
  unsigned first;
  // Second independently transported scalar field.
  unsigned second;
};
using U4 = unsigned __attribute__((vector_size(16)));
struct State {
  // Vector transported as one field through record copies and loop state.
  U4 lanes;
  // Pointer retains both its allocation identity and byte origin.
  const unsigned* cursor;
  // Boolean toggled independently of the vector and pointer.
  bool valid;
};
struct Packet {
  // Empty subobject contributes no transported value components.
  Empty empty;
  // Scalar record independent of the mixed state record.
  Pair pair;
  // Vector, pointer, and predicate nested in the outer record.
  State state;
};
[[loom::inline]] static Pair update_pair(Pair value, unsigned count) {
  Pair original = value;
  Pair copy(value);
  for (unsigned index = 0; index < count; ++index) {
    copy.first += index;
    if (index & 1u) {
      continue;
    }
    ++copy.second;
  }
  return count ? copy : original;
}

[[loom::inline]] static State advance_state(State value, unsigned count) {
  State original = value;
  State copy{value};
  for (unsigned index = 0; index < count; ++index) {
    copy.cursor += 1;
    copy.lanes += U4{1u, 2u, 3u, 4u};
    copy.valid = !copy.valid;
  }
  return count ? copy : original;
}

unsigned record_pairs(unsigned input, unsigned count);
unsigned record_defaults(unsigned input);
unsigned record_sequencing(unsigned input, unsigned choose);
[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void record_values(const unsigned* input, unsigned* output, unsigned seed,
                   unsigned count, unsigned choose) {
  State state{U4{seed, seed + 1u, seed + 2u, seed + 3u}, input + 3u, true};
  const Packet original{{}, {seed, seed + 7u}, state};
  Packet copy = original;
  copy.state = advance_state(copy.state, count);
  copy.pair = update_pair(copy.pair, count);
  if (choose & 1u) {
    copy.pair.first++;
    copy.state.lanes += U4{5u, 6u, 7u, 8u};
  } else {
    copy.pair.second *= 3u;
  }
  Packet selected = choose ? copy : original;
  auto* vectors = reinterpret_cast<U4*>(output);
  vectors[0] = copy.state.lanes;
  vectors[1] = original.state.lanes;
  vectors[2] = selected.state.lanes;
  output[12] = *copy.state.cursor;
  output[13] = *original.state.cursor;
  output[14] = *selected.state.cursor;
  output[15] = copy.state.valid;
  output[16] = original.state.valid;
  output[17] = copy.pair.first;
  output[18] = copy.pair.second;
  output[19] = selected.pair.first;
  output[20] = selected.pair.second;
  output[21] = record_pairs(seed, count);
  output[22] = record_defaults(seed);
  output[23] = record_sequencing(seed, choose);
  struct Pointers {
    // Unchanged pointer observed after copying the enclosing record.
    const unsigned* first;
    // Advanced in the original while the saved record keeps its prior origin.
    const unsigned* second;
  };
  Pointers pointers{input + 1u, input + 7u};
  Pointers saved = pointers;
  ++pointers.second;
  output[24] = *pointers.first;
  output[25] = *pointers.second;
  output[26] = *saved.second;
}
// ----
kernel.def @record_values() {
  %5 = index.constant 1 : index
  kernel.launch.config workgroups(%5, %5, %5) workgroup_size(%5, %5, %5) : index
} launch(%input: buffer, %output: buffer, %seed: i32, %count: i32, %choose: i32) {
  %13 = scalar.constant 1 : i32
  %14 = scalar.addi %seed, %13 : i32
  %15 = scalar.constant 2 : i32
  %16 = scalar.addi %seed, %15 : i32
  %17 = scalar.constant 3 : i32
  %18 = scalar.addi %seed, %17 : i32
  %state_lanes = vector.from_elements %seed, %14, %16, %18 : vector<4xi32>
  %state_cursor_byte_offset = index.constant 12 : index
  %state_valid = scalar.constant 1 : i1
  %27 = scalar.constant 7 : i32
  %original_pair_second = scalar.addi %seed, %27 : i32
  %copy_state_lanes$29, %copy_state_cursor, %copy_state_cursor_byte_offset, %copy_state_valid = func.call pure @advance_state(%state_lanes, %input, %state_cursor_byte_offset, %state_valid, %count) : (vector<4xi32>, buffer, index, i1, i32) -> (vector<4xi32>, buffer, index, i1)
  %copy_pair_first$33, %copy_pair_second$34 = func.call pure @update_pair(%seed, %original_pair_second, %count) : (i32, i32, i32) -> (i32, i32)
  %36 = scalar.andi %choose, %13 : i32
  %37 = scalar.constant 0 : i32
  %38 = scalar.cmpi ne, %36, %37 : i32
  %copy_pair_first$46 = scalar.addi %copy_pair_first$33, %13 : i32
  %47 = vector.constanti [5, 6, 7, 8] : vector<4xi32>
  %copy_state_lanes$48 = vector.addi %copy_state_lanes$29, %47 : vector<4xi32>
  %copy_pair_second$50 = scalar.muli %copy_pair_second$34, %17 : i32
  %copy_pair_first$314 = scf.select %38, %copy_pair_first$46, %copy_pair_first$33 : i32
  %copy_pair_second$315 = scf.select %38, %copy_pair_second$34, %copy_pair_second$50 : i32
  %copy_state_lanes$316 = scf.select %38, %copy_state_lanes$48, %copy_state_lanes$29 : vector<4xi32>
  %52 = scalar.cmpi ne, %choose, %37 : i32
  %selected_pair_first = scf.select %52, %copy_pair_first$314, %seed : i32
  %selected_pair_second = scf.select %52, %copy_pair_second$315, %original_pair_second : i32
  %selected_state_lanes = scf.select %52, %copy_state_lanes$316, %state_lanes : vector<4xi32>
  %selected_state_cursor = scf.select %52, %copy_state_cursor, %input : buffer
  %selected_state_cursor_byte_offset = scf.select %52, %copy_state_cursor_byte_offset, %state_cursor_byte_offset : index
  %299 = index.constant 0 : index
  %64 = buffer.view %output[%299] : buffer -> view<4xi32>
  vector.store<root_in_bounds> %copy_state_lanes$316, %64[0] : vector<4xi32>, view<4xi32>
  %298 = index.constant 16 : index
  %70 = buffer.view %output[%298] : buffer -> view<4xi32>
  vector.store<root_in_bounds> %state_lanes, %70[0] : vector<4xi32>, view<4xi32>
  %297 = index.constant 32 : index
  %76 = buffer.view %output[%297] : buffer -> view<4xi32>
  vector.store<root_in_bounds> %selected_state_lanes, %76[0] : vector<4xi32>, view<4xi32>
  %77 = buffer.view %copy_state_cursor[%copy_state_cursor_byte_offset] : buffer -> view<1xi32>
  %78 = view.load<root_in_bounds|type_disjoint> %77[0] : view<1xi32> -> i32
  %296 = index.constant 48 : index
  %84 = buffer.view %output[%296] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %78, %84[0] : i32, view<1xi32>
  %85 = buffer.view %input[%state_cursor_byte_offset] : buffer -> view<1xi32>
  %86 = view.load<root_in_bounds|type_disjoint> %85[0] : view<1xi32> -> i32
  %295 = index.constant 52 : index
  %92 = buffer.view %output[%295] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %86, %92[0] : i32, view<1xi32>
  %93 = buffer.view %selected_state_cursor[%selected_state_cursor_byte_offset] : buffer -> view<1xi32>
  %94 = view.load<root_in_bounds|type_disjoint> %93[0] : view<1xi32> -> i32
  %294 = index.constant 56 : index
  %100 = buffer.view %output[%294] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %94, %100[0] : i32, view<1xi32>
  %101 = scalar.extui %copy_state_valid : i1 to i32
  %293 = index.constant 60 : index
  %107 = buffer.view %output[%293] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %101, %107[0] : i32, view<1xi32>
