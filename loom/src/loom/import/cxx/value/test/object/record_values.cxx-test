  %selected_lanes = scf.select %98, %lanes, %original : vector<4xi32>
  %selected_cursor_byte_offset = scf.select %98, %cursor_byte_offset, %start_byte_offset : index
  %selected_valid = scf.select %98, %valid$195, %valid$73 : i1
