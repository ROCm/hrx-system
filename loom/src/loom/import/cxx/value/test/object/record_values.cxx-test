// RUN: pass inline-callables,canonicalize,cse,dce
// By-value loop mutation carries both fields through continue paths and
// preserves the original for zero trips and later weighted observations.
struct Pair {
  // First independently transported scalar field.
  unsigned first;
  // Second independently transported scalar field.
  unsigned second;
};
[[loom::inline]] static Pair update_pair(Pair value, unsigned count) {
  Pair original = value;
  Pair copy(value);
  for (unsigned index = 0; index < count; ++index) {
    copy.first += index;
    if (index & 1u) {
      continue;
    }
    ++copy.second;
  }
  return count ? copy : original;
}

unsigned record_pairs(unsigned input, unsigned count) {
  const Pair original{input, input + 7u};
  Pair copy{original};
  Pair assigned{};
  assigned = update_pair(copy, count);
  Pair selected = count ? Pair{assigned} : original;
  return selected.first + selected.second * 3u + original.first * 5u;
}
// ----
func.def public @record_pairs(%input: i32, %count: i32) -> (i32) {
  %3 = scalar.constant 7 : i32
  %original_second = scalar.addi %input, %3 : i32
  %50 = index.constant 0 : offset
  %26 = index.cast %count : i32 to offset
  %27 = index.constant 1 : offset
  %copy_first, %copy_second = scf.for %index = [%50 to %26 step %27](%copy_first$29 = %input : i32, %copy_second$30 = %original_second : i32) -> (i32, i32) {
    %33 = index.cast %index : offset to i32
    %copy_first$34 = scalar.addi %copy_first$29, %33 : i32
    %35 = scalar.constant 1 : i32
    %36 = scalar.andi %33, %35 : i32
    %37 = scalar.constant 0 : i32
    %38 = scalar.cmpi ne, %36, %37 : i32
    %copy_second$44 = scalar.addi %copy_second$30, %35 : i32
    %copy_second$52 = scf.select %38, %copy_second$30, %copy_second$44 : i32
    scf.yield %copy_first$34, %copy_second$52 : i32, i32
  }
  %46 = scalar.constant 0 : i32
  %47 = scalar.cmpi ne, %count, %46 : i32
  %assigned_first = scf.select %47, %copy_first, %input : i32
  %assigned_second = scf.select %47, %copy_second, %original_second : i32
  %selected_first = scf.select %47, %assigned_first, %input : i32
  %selected_second = scf.select %47, %assigned_second, %original_second : i32
  %13 = scalar.constant 3 : i32
  %14 = scalar.muli %selected_second, %13 : i32
  %15 = scalar.addi %selected_first, %14 : i32
  %16 = scalar.constant 5 : i32
  %17 = scalar.muli %input, %16 : i32
  %18 = scalar.addi %15, %17 : i32
  func.return %18 : i32
}

// ====
// RUN: pass inline-callables,canonicalize,cse,dce
// Defaults, designated members, brace elision, independent copies, and an
// empty subobject contribute their own values to the returned observation.
struct Empty {};
struct Pair {
  // First independently transported scalar field.
  unsigned first;
  // Second independently transported scalar field.
  unsigned second;
};
struct Defaults {
  // Scalar default retained when only the nested record is designated.
  unsigned value = 9;
  // Nested aggregate default and brace-elision destination.
  Pair pair{2, 3};
};
[[loom::inline]] static Empty forward_empty(Empty value) { return value; }

unsigned record_defaults(unsigned input) {
  Defaults defaults{};
  Defaults designated{.pair = {input, 7u}};
  Defaults elided{3u, 4u, 5u};
  Defaults copy = designated;
  copy.pair.second++;
  Empty empty{};
  empty = forward_empty(empty);
  return defaults.value + defaults.pair.first + defaults.pair.second +
         designated.value + copy.pair.first + copy.pair.second + elided.value +
         elided.pair.first + elided.pair.second + (unsigned)sizeof(empty);
}
// ----
func.def public @record_defaults(%input: i32) -> (i32) {
  %31 = scalar.constant 44 : i32
  %32 = scalar.addi %input, %31 : i32
  func.return %32 : i32
}

// ====
// RUN: pass inline-callables,canonicalize,cse,dce
// Selected member mutations and a self-dependent compound assignment
// observe the source evaluation order before the final weighted reads.
struct Pair {
  // First independently transported scalar field.
  unsigned first;
  // Second independently transported scalar field.
  unsigned second;
};
unsigned record_sequencing(unsigned input, unsigned choose) {
  Pair value{input, input + 1u};
  unsigned selected = choose ? (value.first = 7u) : (value.second += 3u);
  value.first += ++value.first;
  return selected + value.first * 3u + value.second * 5u;
}
// ----
func.def public @record_sequencing(%input: i32, %choose: i32) -> (i32) {
  %3 = scalar.constant 1 : i32
  %value_second$4 = scalar.addi %input, %3 : i32
  %5 = scalar.constant 0 : i32
  %6 = scalar.cmpi ne, %choose, %5 : i32
  %value_first$10 = scalar.constant 7 : i32
  %22 = scalar.constant 4 : i32
  %value_second$23 = scalar.addi %input, %22 : i32
  %selected = scf.select %6, %value_first$10, %value_second$23 : i32
  %value_first$25 = scf.select %6, %value_first$10, %input : i32
  %value_second$26 = scf.select %6, %value_second$4, %value_second$23 : i32
  %value_first$14 = scalar.addi %value_first$25, %3 : i32
  %value_first$15 = scalar.addi %value_first$14, %value_first$14 : i32
  %16 = scalar.constant 3 : i32
  %17 = scalar.muli %value_first$15, %16 : i32
  %18 = scalar.addi %selected, %17 : i32
  %19 = scalar.constant 5 : i32
  %20 = scalar.muli %value_second$26, %19 : i32
  %21 = scalar.addi %18, %20 : i32
  func.return %21 : i32
}

// ====
// RUN: pass inline-callables,canonicalize,cse,dce
// The same loop expressed as a mixed record and as independent leaves
// retains vector, pointer, and predicate state plus the untouched original.
using U4 = unsigned __attribute__((vector_size(16)));
struct State {
  // Vector transported as one field through record copies and loop state.
  U4 lanes;
  // Pointer retains both its allocation identity and byte origin.
  const unsigned* cursor;
  // Boolean toggled independently of the vector and pointer.
  bool valid;
};
[[loom::inline]] static State advance_state(State value, unsigned count) {
  State original = value;
  State copy{value};
  for (unsigned index = 0; index < count; ++index) {
    copy.cursor += 1;
    copy.lanes += U4{1u, 2u, 3u, 4u};
    copy.valid = !copy.valid;
  }
  return count ? copy : original;
}

[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void record_control(const unsigned* input, U4* output, unsigned seed,
                    unsigned count) {
  State initial{U4{seed, seed + 1u, seed + 2u, seed + 3u}, input + 3u, true};
  State result = advance_state(initial, count);
  output[0] = result.lanes;
  output[1] = U4{*result.cursor, (unsigned)result.valid, *initial.cursor, seed};
}

[[loom::kernel, loom::workgroup_size(1, 1, 1), loom::workgroup_count(1, 1, 1)]]
void leaf_control(const unsigned* input, U4* output, unsigned seed,
                  unsigned count) {
  U4 original{seed, seed + 1u, seed + 2u, seed + 3u};
  const unsigned* start = input + 3u;
  U4 lanes = original;
  const unsigned* cursor = start;
  bool valid = true;
  for (unsigned index = 0; index < count; ++index) {
    cursor += 1;
    lanes += U4{1u, 2u, 3u, 4u};
    valid = !valid;
  }
  U4 selected_lanes = count ? lanes : original;
  const unsigned* selected_cursor = count ? cursor : start;
  bool selected_valid = count ? valid : true;
  output[0] = selected_lanes;
  output[1] = U4{*selected_cursor, (unsigned)selected_valid, *start, seed};
}
// ----
kernel.def @record_control() {
  %4 = index.constant 1 : index
  kernel.launch.config workgroups(%4, %4, %4) workgroup_size(%4, %4, %4) : index
} launch(%input: buffer, %output: buffer, %seed: i32, %count: i32) {
  %12 = scalar.constant 1 : i32
  %13 = scalar.addi %seed, %12 : i32
  %14 = scalar.constant 2 : i32
  %15 = scalar.addi %seed, %14 : i32
  %16 = scalar.constant 3 : i32
  %17 = scalar.addi %seed, %16 : i32
  %initial_lanes = vector.from_elements %seed, %13, %15, %17 : vector<4xi32>
  %initial_cursor_byte_offset = index.constant 12 : offset
  %initial_valid = scalar.constant 1 : i1
  %189 = index.constant 0 : offset
  %156 = index.cast %count : i32 to offset
  %157 = index.constant 1 : offset
  %copy_lanes, %copy_cursor_byte_offset, %copy_valid = scf.for %index = [%189 to %156 step %157](%copy_lanes$196 = %initial_lanes : vector<4xi32>, %copy_cursor_byte_offset$197 = %initial_cursor_byte_offset : offset, %copy_valid$198 = %initial_valid : i1) -> (vector<4xi32>, offset, i1) {
    %188 = scalar.constant 4 : i64
    %172 = index.cast %copy_cursor_byte_offset$197 : offset to i64
    %173 = scalar.addi %172, %188 : i64
    %174 = scalar.assume %173 [range(%173, 0, 9223372036854775807)] : i64
    %copy_cursor_byte_offset$175 = index.cast %174 : i64 to offset
    %176 = vector.constanti [1, 2, 3, 4] : vector<4xi32>
    %copy_lanes$177 = vector.addi %copy_lanes$196, %176 : vector<4xi32>
    %copy_valid$179 = scalar.xori %copy_valid$198, %initial_valid : i1
    scf.yield %copy_lanes$177, %copy_cursor_byte_offset$175, %copy_valid$179 : vector<4xi32>, offset, i1
  }
  %180 = scalar.constant 0 : i32
  %181 = scalar.cmpi ne, %count, %180 : i32
  %result_lanes = scf.select %181, %copy_lanes, %initial_lanes : vector<4xi32>
  %result_cursor_byte_offset = scf.select %181, %copy_cursor_byte_offset, %initial_cursor_byte_offset : offset
  %result_valid = scf.select %181, %copy_valid, %initial_valid : i1
  %40 = buffer.view %output[%189] : buffer -> view<4xi32>
  vector.store %result_lanes, %40[0] : vector<4xi32>, view<4xi32>
  %41 = buffer.view %input[%result_cursor_byte_offset] : buffer -> view<1xi32>
  %42 = view.load %41[0] : view<1xi32> -> i32
  %43 = scalar.extui %result_valid : i1 to i32
  %44 = buffer.view %input[%initial_cursor_byte_offset] : buffer -> view<1xi32>
  %45 = view.load %44[0] : view<1xi32> -> i32
  %46 = vector.from_elements %42, %43, %45, %seed : vector<4xi32>
  %186 = index.constant 16 : offset
  %55 = buffer.view %output[%186] : buffer -> view<4xi32>
  vector.store %46, %55[0] : vector<4xi32>, view<4xi32>
  kernel.return
}

