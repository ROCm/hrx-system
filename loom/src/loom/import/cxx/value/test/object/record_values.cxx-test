  %289 = index.constant 72 : index
  %126 = buffer.view %output[%289] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %copy_pair_second$315, %126[0] : i32, view<1xi32>
  %288 = index.constant 76 : index
  %132 = buffer.view %output[%288] : buffer -> view<1xi32>
