  %5 = index.constant 1 : index
  kernel.launch.config workgroups(%5, %5, %5) workgroup_size(%5, %5, %5) : index
} launch(%input: buffer, %output: buffer, %seed: i32, %count: i32, %choose: i32) {
  %13 = scalar.constant 1 : i32
  %14 = scalar.addi %seed, %13 : i32
  %15 = scalar.constant 2 : i32
