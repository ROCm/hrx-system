  %78 = buffer.view %output[%364] : buffer -> view<4xi32>
  vector.store %state_lanes, %78[0] : vector<4xi32>, view<4xi32>
  %363 = index.constant 32 : offset
  %87 = buffer.view %output[%363] : buffer -> view<4xi32>
  vector.store %selected_state_lanes, %87[0] : vector<4xi32>, view<4xi32>
  %88 = buffer.view %copy_state_cursor[%copy_state_cursor_byte_offset] : buffer -> view<1xi32>
  %89 = view.load %88[0] : view<1xi32> -> i32
  %362 = index.constant 48 : offset
  %98 = buffer.view %output[%362] : buffer -> view<1xi32>
