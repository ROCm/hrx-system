  %115 = view.load<root_in_bounds|type_disjoint> %114[0] : view<1xi32> -> i32
  %116 = scalar.extui %selected_valid : i1 to i32
  %117 = buffer.view %input[%start_byte_offset] : buffer -> view<1xi32>
  %118 = view.load<root_in_bounds|type_disjoint> %117[0] : view<1xi32> -> i32
