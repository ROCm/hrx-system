struct Pair {
  unsigned x;
  unsigned y;

  unsigned sum(unsigned value) const { return x + y + value; }
  void bump(unsigned value) { y += value; }
  unsigned operator()(unsigned value) const { return sum(value); }
  static unsigned twice(unsigned value) { return value * 2u; }
  template <unsigned Amount>
  [[loom::noinline]]
  unsigned add() const {
    return x + Amount;
  }
};

