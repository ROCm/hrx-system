// RUN: pass canonicalize,cse,dce
// Returning the current receiver through self() preserves the overlap between
// that receiver and its member passed to the next method call.
struct CurrentReceiverAlias {
  // Receiver member updated from the aliased selected argument.
  unsigned first;
  // Member also passed as the selected reference argument.
  unsigned second;

  void update(unsigned& selected) {
    ++selected;
    first += selected;
    selected += first;
  }
  CurrentReceiverAlias& self() { return *this; }
  void apply() { self().update(second); }
};

unsigned current_receiver_alias() {
  CurrentReceiverAlias value{3u, 5u};
  value.apply();
  return value.first * 100u + value.second;
}
