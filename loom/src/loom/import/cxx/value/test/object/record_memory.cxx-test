  %17 = scalar.addf %9, %16 : f32
  func.return %17 : f32
}

// ====
// Concrete templates retain their own completed layout and scalar views.
template<class T> struct Box { unsigned char tag; T value; };
float read(const Box<float>* boxes, unsigned index) {
  return boxes[index].value;
}

