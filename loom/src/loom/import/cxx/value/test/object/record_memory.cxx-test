  %22 = view.load<root_in_bounds|type_disjoint> %21[0] : view<1xf32> -> f32
  %23 = scalar.addf %22, %13 : f32
  view.store<root_in_bounds|type_disjoint> %23, %21[0] : f32, view<1xf32>
  %24 = scalar.constant 1 : i32
  %30 = index.constant 8 : index
  %31 = index.add %37, %30 : index
  %32 = buffer.view %particles[%31] : buffer -> view<1xi32>
  %33 = view.load<root_in_bounds|type_disjoint> %32[0] : view<1xi32> -> i32
  %34 = scalar.ori %33, %24 : i32
  view.store<root_in_bounds|type_disjoint> %34, %32[0] : i32, view<1xi32>
  func.return
}

// ====
// Nested fields and field addresses preserve both enclosing record strides.
#include "record_layout.h"
unsigned nested(Nested* records, unsigned index) {
  auto* value = &records[index].value;
  auto* count = &value->count;
  *count += 7;
  return value->last + 1u + *count;
}
void aligned(Aligned* records, unsigned index, unsigned value) {
  (records + index)->count = value;
}

