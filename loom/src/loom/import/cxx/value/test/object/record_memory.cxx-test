  %86 = scalar.extsi %85 : i8 to i32
  %138 = scalar.constant -2 : i32
  %139 = scalar.addi %86, %138 : i32
  %88 = scalar.trunci %139 : i32 to i8
  view.store<volatile> %88, %80[0] : i8, view<1xi8>
  %137 = scalar.constant -1 : i8
  %93 = buffer.view %records[%sample_byte_offset] : buffer -> view<1xi8>
  view.store<volatile> %137, %93[0] : i8, view<1xi8>
  %104 = view.load<volatile> %93[0] : view<1xi8> -> i8
  %105 = scalar.extui %104 : i8 to i32
  %107 = scalar.addi %105, %142 : i32
  %108 = scalar.trunci %107 : i32 to i8
  view.store<volatile> %108, %93[0] : i8, view<1xi8>
  %112 = scalar.constant 0.5 : f32
  %114 = view.load<volatile> %45[0] : view<1xf32> -> f32
  %115 = scalar.addf %114, %112 : f32
  view.store<volatile> %115, %45[0] : f32, view<1xf32>
  %position$119 = view.load<volatile> %45[0] : view<1xf32> -> f32
  %120 = scalar.fptoui %position$119 : f32 to i32
  %121 = scalar.addi %120, %105 : i32
  %count = view.load<volatile> %65[0] : view<1xi16> -> i16
