  %7 = index.cast %particles_byte_offset : offset to i64
  %8 = scalar.addi %7, %6 : i64
  %9 = scalar.assume %8 [range(%8, 0, 9223372036854775807)] : i64
  %10 = index.cast %9 : i64 to offset
  %11 = index.constant 4 : offset
  %12 = index.add %10, %11 : offset
  %13 = buffer.view %particles[%12] : buffer -> view<1xf32>
  %velocity = view.load %13[0] : view<1xf32> -> f32
  %15 = scalar.mulf %velocity, %dt : f32
