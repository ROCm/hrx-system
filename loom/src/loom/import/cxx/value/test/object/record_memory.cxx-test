  %6 = index.constant 12 : index
  %37 = index.madd %5, %6, %particles_byte_offset : index
  %9 = index.constant 4 : index
  %10 = index.add %37, %9 : index
  %11 = buffer.view %particles[%10] : buffer -> view<1xf32>
  %velocity = view.load<root_in_bounds|type_disjoint> %11[0] : view<1xf32> -> f32
  %13 = scalar.mulf %velocity, %dt : f32
