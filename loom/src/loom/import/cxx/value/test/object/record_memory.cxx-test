  %36 = index.constant 8 : offset
  %37 = index.add %10, %36 : offset
  %38 = buffer.view %particles[%37] : buffer -> view<1xi32>
  %39 = view.load %38[0] : view<1xi32> -> i32
  %40 = scalar.ori %39, %28 : i32
  view.store %40, %38[0] : i32, view<1xi32>
  func.return
}

// ====
// Nested fields and field addresses preserve both enclosing record strides.
#include "record_layout.h"
unsigned nested(Nested* records, unsigned index) {
  auto* value = &records[index].value;
  auto* count = &value->count;
  *count += 7;
  return value->last + 1u + *count;
}
void aligned(Aligned* records, unsigned index, unsigned value) {
  (records + index)->count = value;
}

