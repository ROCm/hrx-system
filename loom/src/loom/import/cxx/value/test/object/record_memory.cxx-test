func.def public @record_update(%records: buffer, %records_byte_offset: index, %input: buffer, %input_byte_offset: index, %index: i32) -> (i32) {
  %6 = func.call @update_sample___Sample(%records, %records_byte_offset, %input, %input_byte_offset, %index) : (buffer, index, buffer, index, i32) -> (i32)
  func.return %6 : i32
}

