// ====
// Pointer updates execute once; volatile propagates through the object type.
struct Payload { unsigned count; };
struct Packet { unsigned prefix; Payload payload; };
unsigned observed(volatile Packet* packets) {
  unsigned previous = (packets++)->payload.count++;
  return previous + ++(*packets).payload.count;
}

