// RUN: verify
union Record { unsigned integer; float real; };
// ERROR@+1: LOWERING/059 "record storage requires a complete non-union type without virtual members"
unsigned read(const Record* record) { return record->integer; }

// ====
struct Base { unsigned first; };
struct Record : virtual Base { unsigned second; };
// ERROR@+1: LOWERING/059 "virtual base objects require a dynamic object layout"
unsigned read(const Record* record) { return record->second; }

// ====
struct Record { unsigned value : 7; };
// ERROR@+1: LOWERING/059 "record storage requires named fields without bitfields or no_unique_address"
unsigned read(const Record* record) { return record->value; }

// ====
struct Empty {};
struct Record { [[no_unique_address]] Empty empty; unsigned value; };
// ERROR@+1: LOWERING/059 "record storage requires named fields without bitfields or no_unique_address"
unsigned read(const Record* record) { return record->value; }

// ====
struct Record { unsigned* pointer; };
// ERROR@+1: LOWERING/059 "stored pointers and references require an object storage representation"
unsigned read(const Record* record) { return *record->pointer; }

// ====
struct Record { unsigned* pointers[4]; };
// ERROR@+1: LOWERING/059 "stored pointers and references require an object storage representation"
unsigned read(const Record* record) { return *record->pointers[0]; }

// ====
struct Record { unsigned values[4]; };
// ERROR@+1: LOWERING/059 "mutation requires a non-const destination"
void write(const Record* record) { record->values[0] = 7; }

// ====
struct Record { unsigned values[4]; };
// ERROR@+1: LOWERING/059 "mutation requires a non-const destination"
void write(const Record* record) { auto* values = record->values; values[0] = 7; }

// ====
#include <loomcxx/view.h>
// ERROR@+2: LOWERING/059 "Loom source types require SSA value transport"
void read(const loom::type::view<loom::type::shape<4, 4>, float>* view) {
  auto value = *view;
}

// ====
// Exposing an array's address still requires storage for its complete owner.
struct View { int* data; int values[3]; };
static void observe(const int* values);
void escaped(int* data) {
  // ERROR@+1: LOWERING/059 "stored pointers and references require an object storage representation"
  View view{data, {1, 2, 3}};
  observe(view.values);
}
