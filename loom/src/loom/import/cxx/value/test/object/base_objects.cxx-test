  %value_Left_Base_value = scalar.constant 1 : i32
  %value_Right_Base_value = scalar.constant 2 : i32
  %value_member_value = scalar.constant 3 : i32
  %6 = scalar.constant 9 : i32
  func.call @observe(%6) : (i32)
  func.call @observe(%value_member_value) : (i32)
  func.call @observe(%value_Right_Base_value) : (i32)
  func.call @observe(%value_Left_Base_value) : (i32)
  func.return
}

func.decl @observe(%10: i32)

// ====
// Addressable volatile base fields never require a by-value record partition.
struct Prefix { unsigned tag; };
struct Base { volatile unsigned status; };
struct Device : Prefix, Base {};
unsigned read(Device* device) {
  unsigned before = device->status;
  static_cast<Base&>(*device).status = 7;
  return before + device->Base::status;
}
