  %19 = index.constant 4 : offset
  %17 = buffer.view %base_table_storage[%19] : buffer -> view<1xi32>
  %other = view.load %17[0] : view<1xi32> -> i32
  func.return %other : i32
}

global.rodata.def @base_table = align(4) bytes("0700000009000000")

// ====
// Packed bases preserve their layout and alignment through a derived pointer.
struct [[gnu::packed]] Base { unsigned char tag; unsigned value; };
struct Derived : Base { unsigned short extra; };
unsigned packed(const Derived* value) { return value->value + value->extra; }
