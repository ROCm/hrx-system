  %value_Right_Base_value = scalar.constant 7 : i32
  %23 = index.constant 0 : offset
  %13 = index.cast %count : i32 to offset
  %14 = index.constant 1 : offset
  %Right_Base_value = scf.for %i = [%23 to %13 step %14](%Right_Base_value$16 = %value_Right_Base_value : i32) -> (i32) {
    %18 = index.cast %i : offset to i32
    %Right_Base_value$19 = scalar.addi %Right_Base_value$16, %18 : i32
    scf.yield %Right_Base_value$19 : i32
  }
  %20 = scalar.constant 3 : i32
  %21 = scalar.muli %Right_Base_value, %20 : i32
  %22 = scalar.addi %input, %21 : i32
  func.return %22 : i32
}

// ====
// Class access control is resolved in the frontend; private bases stay useful
// through ordinary member functions and inherited constructors.
struct Base {
  unsigned value;
  Base(unsigned value) : value(value) {}
  [[loom::inline]] unsigned read() const { return value; }
};
class Derived : private Base {
 public:
  using Base::Base;
  [[loom::inline]] unsigned scaled() const { return read() * 3; }
};
unsigned private_base(unsigned input) {
  Derived value(input);
  return value.scaled();
}
// ----
func.def public @private_base(%input: i32) -> (i32) {
  %2 = index.constant 4 : offset
  %value_storage = buffer.alloca<private> align(4) %2 : buffer
  %34 = index.constant 0 : offset
  %25 = buffer.view %value_storage[%34] : buffer -> view<1xi32>
  view.store<root_in_bounds> %input, %25[0] : i32, view<1xi32>
  %value = view.load<root_in_bounds> %25[0] : view<1xi32> -> i32
  %18 = scalar.constant 3 : i32
  %19 = scalar.muli %value, %18 : i32
  func.return %19 : i32
}

// ====
// Nonvirtual base destruction follows members, in reverse declaration order.
void observe(unsigned);
struct Base {
  unsigned value;
  ~Base() { observe(value); }
};
struct Left : Base {};
struct Right : Base {};
struct Both : Left, Right {
  Base member;
  ~Both() { observe(9); }
};
void destruction() {
  Both value{{{1}}, {{2}}, {3}};
}
