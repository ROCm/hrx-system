  %status$6 = view.load<volatile|root_in_bounds> %5[0] : view<1xi32> -> i32
  %7 = scalar.constant 7 : i32
  view.store<volatile|root_in_bounds> %7, %5[0] : i32, view<1xi32>
  %status$16 = view.load<volatile|root_in_bounds> %5[0] : view<1xi32> -> i32
  %17 = scalar.addi %status$6, %status$16 : i32
  func.return %17 : i32
}

// ====
// Source template instantiation preserves base paths for native vector lanes.
using U4 = unsigned __attribute__((vector_size(16)));
template<class T> struct Base { T value; };
template<class T> struct Derived : Base<T> { unsigned tag; };
U4 lanes(U4 input, unsigned lane) {
  Derived<U4> value{{input}, 7};
  value.value[lane] = value.tag;
  return value.value;
}
