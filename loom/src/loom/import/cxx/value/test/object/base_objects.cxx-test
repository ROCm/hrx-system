  %14 = scalar.constant 18 : i32
  %15 = scalar.addi %input, %14 : i32
  func.return %15 : i32
}

// ====
// A loop mutates one inherited field; its same-named sibling stays unchanged.
struct Base { unsigned value; };
struct Left : Base {};
struct Right : Base {};
struct Both : Left, Right {
  [[loom::inline]] unsigned accumulate(unsigned count) {
    for (unsigned i = 0; i < count; ++i) {
      Right::value += i;
    }
    return Left::value + Right::value * 3;
  }
};
unsigned loop(unsigned input, unsigned count) {
  Both value{{{input}}, {{7}}};
  return value.accumulate(count);
}
// ----
