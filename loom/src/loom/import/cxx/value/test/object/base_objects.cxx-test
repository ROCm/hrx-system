// ====
// Operator lookup selects the same base as explicit inherited member calls.
struct Prefix { unsigned tag; };
struct Base {
  unsigned value;
  [[loom::inline]] unsigned& operator[](unsigned delta) { value += delta; return value; }
  [[loom::inline]] unsigned operator()(unsigned delta) { value += delta; return value; }
  [[loom::inline]] Base& operator++() { ++value; return *this; }
};
struct Derived : Prefix, Base { unsigned extra; };
unsigned inherited_operators(unsigned input) {
  Derived value{{99}, {input}, 7};
  value[2] += 3;
  unsigned previous = value(4);
  ++value;
  return value.value + previous + value.tag + value.extra;
}
// ----
func.def public @inherited_operators(%input: i32) -> (i32) {
  %36 = scalar.constant 9 : i32
  %value = scalar.addi %input, %36 : i32
  %30 = scalar.addi %value, %value : i32
  %32 = scalar.constant 107 : i32
  %33 = scalar.addi %30, %32 : i32
  func.return %33 : i32
}

// ====
// Mutable inherited fields remain loop-carried through a const member call.
struct Base { mutable unsigned value; };
struct Derived : Base {
  [[loom::inline]] unsigned next() const { return ++value; }
};
unsigned advance(unsigned input, unsigned count) {
  Derived value{{input}};
  for (unsigned i = 0; i < count; ++i) value.next();
  return value.value;
}
// ----
func.def public @advance(%input: i32, %count: i32) -> (i32) {
  %18 = index.constant 0 : offset
  %5 = index.cast %count : i32 to offset
  %6 = index.constant 1 : offset
  %value_Base_value = scf.for %i = [%18 to %5 step %6](%value_Base_value = %input : i32) -> (i32) {
    %16 = scalar.constant 1 : i32
    %Base_value = scalar.addi %value_Base_value, %16 : i32
    scf.yield %Base_value : i32
  }
  func.return %value_Base_value : i32
}

// ====
// RUN: pass inline-callables,canonicalize,cse,dce
// Instantiated member bodies retain their specialized base subobject paths.
struct TemplatePrefix { unsigned words[3]; };
struct TemplateBase {
  unsigned value;
  [[loom::inline]] unsigned get() const { return value; }
};
template <class T>
struct TemplateDerived : TemplatePrefix, TemplateBase {
  [[loom::inline]] unsigned read() const { return this->get(); }
};
unsigned template_base_member(TemplateDerived<unsigned>* object) {
  return object->read();
}
// ----
func.def public @template_base_member(%object: buffer, %object_byte_offset: offset) -> (i32) {
  %7 = index.constant 12 : offset
  %8 = index.add %object_byte_offset, %7 : offset
  %15 = buffer.view %object[%8] : buffer -> view<1xi32>
  %value = view.load<root_in_bounds> %15[0] : view<1xi32> -> i32
  func.return %value : i32
}
