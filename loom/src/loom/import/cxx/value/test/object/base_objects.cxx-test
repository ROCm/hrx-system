// ====
// A mutable base method updates the enclosing temporary before its destructor.
void observe(unsigned);
struct Base {
  unsigned value;
  [[loom::inline]] unsigned increment() { return ++value; }
};
struct Derived : Base {
  unsigned tag;
  ~Derived() { observe(value * 10 + tag); }
};
unsigned temporary(unsigned input) { return Derived{{input}, 3}.increment(); }
