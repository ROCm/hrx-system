  %4 = index.cast %lane : i32 to index
  %value_Base_value = vector.insert %value_tag into %input[%4] : i32, vector<4xi32>
  func.return %value_Base_value : vector<4xi32>
}

// ====
// Capturing this observes the selected inherited field through its live object.
struct Base { unsigned value; };
struct Left : Base {};
struct Right : Base {};
struct Both : Left, Right {
  [[loom::inline]] unsigned change(unsigned input) {
    auto update = [this, input] { Right::value += input; };
    update();
    return Left::value + Right::value * 3;
  }
};
