  %2 = scalar.constant 3 : i32
  %8 = scalar.constant 1 : i32
  %value = scalar.addi %input, %8 : i32
  %12 = scalar.constant 10 : i32
  %13 = scalar.muli %value, %12 : i32
  %14 = scalar.addi %13, %2 : i32
  func.call @observe(%14) : (i32)
  func.return %value : i32
}

func.decl @observe(%15: i32)

// ====
// Constant tables retain their complete source object layout.

struct Base {
  unsigned value;
};
struct Derived : Base {
  unsigned other;
};
static constexpr Derived base_table[1] = {{{7}, 9}};
unsigned base_lookup(unsigned index) {
  return base_table[index % 1u].other;
}

// ----
