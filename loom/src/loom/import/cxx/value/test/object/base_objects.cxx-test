// RUN: pass inline-callables,canonicalize,cse,dce
// Two instances of the same base retain independent values and mutations.
struct Base { unsigned value; };
struct Left : Base { unsigned tag; };
struct Right : Base {};
struct Both : Left, Right { unsigned extra; };
unsigned repeated(unsigned input) {
  Both value{{{input}, 2}, {{7}}, 11};
  value.Right::value += 3;
  return value.Left::value + value.Right::value * value.tag + value.extra;
}
