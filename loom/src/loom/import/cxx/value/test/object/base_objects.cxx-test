// ====
// Explicit downcasts preserve the enclosing allocation and signed displacement.
struct Base { unsigned value; };
struct Prefix { unsigned tag; };
struct Derived : Prefix, Base { unsigned extra; };
[[loom::inline]] static void change(Base& base) {
  auto& complete = static_cast<Derived&>(base);
  complete.tag += 5;
  complete.value += 7;
  complete.extra += 11;
}
unsigned enclosing(unsigned input) {
  Derived value{{input}, {2}, 3};
  change(value);
  return value.tag + value.value * 3 + value.extra * 5;
}
