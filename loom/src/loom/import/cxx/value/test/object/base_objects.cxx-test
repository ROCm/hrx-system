// ====
// Read-only constants and default clauses use the same direct-base schema.
struct Base { unsigned value = 3; };
struct Left : Base {};
struct Right : Base {};
struct Both : Left, Right {
  unsigned extra = Left::value + Right::value;
};
constexpr Both constant{{{2}}, {{7}}, 11};
unsigned defaults(unsigned input) {
  Both value{};
  Both changed{{{input}}, {{5}}};
  return value.extra + changed.extra + constant.Right::value;
}
