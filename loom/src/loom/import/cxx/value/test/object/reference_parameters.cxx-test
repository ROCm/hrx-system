// ====
// Rvalue references share the analysis-selected value/storage ABI with lvalue
// references. Named xvalues update their automatic owner, mutable prvalues
// carry an updated value with no external destination, exact returned aliases stay
// in SSA, and runtime-selected conditional identities use durable storage.
struct RvalueState {
  int value;
};

static void increment_rvalue(RvalueState&& state) { state.value += 1; }

int mutate_named_xvalue(int input) {
  RvalueState state{input};
  increment_rvalue(static_cast<RvalueState&&>(state));
  return state.value;
}

template <class Function>
static int invoke_rvalue(Function&& function) {
  return function();
}

int mutate_prvalue_closure() {
  return invoke_rvalue([value = 4]() mutable { return ++value; });
}

static int address_rvalue(RvalueState&& state) {
  RvalueState* pointer = &state;
  return pointer->value;
}

int storage_prvalue() { return address_rvalue(RvalueState{7}); }

static RvalueState&& identity_rvalue(RvalueState&& state) {
  return static_cast<RvalueState&&>(state);
}

int mutate_returned_xvalue(int input) {
  RvalueState state{input};
  RvalueState&& alias = identity_rvalue(static_cast<RvalueState&&>(state));
  alias.value += 2;
  return state.value;
}

static int read_const_rvalue(const RvalueState&& state) {
  return state.value;
}

int read_const_prvalue() { return read_const_rvalue(RvalueState{8}); }

static RvalueState&& identity_value_rvalue(RvalueState&& state) {
  return static_cast<RvalueState&&>(state);
}

int read_returned_prvalue() {
  return identity_value_rvalue(RvalueState{9}).value;
}

static void increment_chained_rvalue(RvalueState&& state) {
  state.value += 2;
}

int mutate_chained_xvalue(int input) {
  RvalueState state{input};
  increment_chained_rvalue(identity_value_rvalue(static_cast<RvalueState&&>(state)));
  return state.value;
}

static void increment_conditional_rvalue(RvalueState&& state) {
  state.value += 3;
}

int mutate_conditional_xvalue(bool choose, int left_value, int right_value) {
  RvalueState left{left_value};
  RvalueState right{right_value};
  increment_conditional_rvalue(choose ? static_cast<RvalueState&&>(left) : static_cast<RvalueState&&>(right));
  return left.value + right.value;
}

