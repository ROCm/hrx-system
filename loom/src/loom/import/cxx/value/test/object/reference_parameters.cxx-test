// ====
// RUN: pass canonicalize,cse,dce
// Two mutable references to the same scalar must observe the first mutation in
// the second update; the remaining scalars retain their original values.
static void update_overlapping_references(unsigned& first, unsigned& second) {
  ++first;
  second += first;
}

unsigned overlapping_mutable_references() {
  unsigned first = 2u;
  unsigned second = 3u;
  unsigned third = 5u;
  unsigned fourth = 7u;
  update_overlapping_references(first, first);
  return first * 1000u + second * 100u + third * 10u + fourth;
}
