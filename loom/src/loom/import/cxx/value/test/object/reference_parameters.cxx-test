// ====
// RUN: pass canonicalize,cse,dce
// A selected reference can alias the other argument. A conditional with two
// identical storage origins must retain that same identity across the call.
static void sequence_overlapping_alias(unsigned& output,
                                       const unsigned& input) {
  ++output;
  output += input;
}

static unsigned& choose_overlapping_alias(bool condition, unsigned& first,
                                          unsigned& second) {
  return condition ? first : second;
}

unsigned overlapping_conditional_result(bool condition) {
  unsigned first = 5u;
  unsigned second = 7u;
  sequence_overlapping_alias(choose_overlapping_alias(condition, first, second),
                             first);
  return first * 100u + second;
}

unsigned overlapping_storage_result(bool condition, unsigned value) {
  unsigned* pointer = &value;
  sequence_overlapping_alias(
      choose_overlapping_alias(condition, *pointer, *pointer), *pointer);
  return value;
}
