// ====
// RUN: pass canonicalize,cse,dce
// The weighted original snapshot cannot be exchanged with the current owner
// after a helper mutates the owner through a returned reference.
static unsigned& increment_alias(unsigned& value) {
  ++value;
  return value;
}

unsigned stale_value_copy(unsigned value) {
  const unsigned snapshot = value;
  increment_alias(value);
  return snapshot * 100u + value;
}

