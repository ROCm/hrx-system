// RUN: pass canonicalize,cse,dce
struct Slice {
  double* pointer;
  int lower;
  int stride;

  double& operator()(int index) const {
    return pointer[(index - lower) * stride];
  }
};

struct Table {
  double* base;

  Slice operator[](int block) const { return Slice{base + block, 0, 1}; }
};

double complete_temporary(double* output, int block) {
  Table table{output};
  const auto& slice = table[block];
  return slice(0);
}

