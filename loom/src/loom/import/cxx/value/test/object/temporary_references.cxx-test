// ====
// Pointer temporaries retain buffer identity and offsets as values. Reference
// aliases observe writes to that value, while a conversion makes its own copy.
float qualified_pointer(float* input) {
  const float* const& pointer = input + 1;
  return *pointer;
}
const void* erased_pointer(float* input) {
  const void* const& pointer = input + 1;
  return pointer;
}
float selected_pointer(bool choose, float* first, float* second) {
  float* const& pointer = choose ? first : second;
  return *pointer;
}
float mutate_pointer(float* input, int amount) {
  float*&& pointer = input + 1;
  float*& alias = pointer;
  alias += amount;
  return *pointer;
}
float copied_pointer(float* input) {
  float*&& pointer = input + 1;
  const void* const& copied = pointer;
  pointer += 2;
  return *static_cast<const float*>(copied) + *pointer;
}
float ordered_pointer(float* input, int* evaluations) {
  float* const& pointer = (++*evaluations, input + *evaluations);
  return *pointer;
}
bool null_pointer() {
  const auto& pointer = nullptr;
  return pointer == nullptr;
}

