// ====
// Reference parameters and results preserve the selected pointer object.
static float* const& select(bool choose, float* const& first, float* const& second) {
  return choose ? first : second;
}
float forwarded_pointer(bool choose, float* first, float* second) {
  return *select(choose, first + 1, second + 2);
}
static float read(float* const& pointer) { return *pointer; }
float nested_pointer(bool choose, float* first, float* second) {
  return read(select(choose, first + 1, second + 2));
}
struct Owner {
  float* pointer;
  float* const& operator[](int) const { return pointer; }
};
float projected_pointer(float* input) { return read(Owner{input}[0]); }

