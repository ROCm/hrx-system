func.def @Slice__operator_call_value(%this_pointer: buffer, %this_pointer_byte_offset: index, %this_lower: i32, %this_stride: i32, %index: i32) -> (buffer, index) {
  %54 = scalar.subi %index, %this_lower : i32
  %55 = scalar.muli %54, %this_stride : i32
