  %8 = buffer.view %input[%input_byte_offset] : buffer -> view<1xf64>
  %9 = view.load<root_in_bounds|type_disjoint> %8[0] : view<1xf64> -> f64
  func.call @Owner___Owner_value(%input, %input_byte_offset) : (buffer, index)
  func.return %9 : f64
}

func.def public @nontrivial_temporary(%input: buffer, %input_byte_offset: index) {
  func.call @observe(%input, %input_byte_offset) : (buffer, index)
  func.call @Owner___Owner_value(%input, %input_byte_offset) : (buffer, index)
  func.return
}

func.def public @mutable_nontrivial_temporary(%first: buffer, %first_byte_offset: index, %second: buffer, %second_byte_offset: index) {
  func.call @Owner___Owner_value(%second, %second_byte_offset) : (buffer, index)
  func.return
}

func.def public @conditional_nontrivial_temporary(%choose: i1, %first: buffer, %first_byte_offset: index, %second: buffer, %second_byte_offset: index) {
  %owner_pointer = scf.select %choose, %first, %second : buffer
  %owner_pointer_byte_offset = scf.select %choose, %first_byte_offset, %second_byte_offset : index
  func.call @observe(%owner_pointer, %owner_pointer_byte_offset) : (buffer, index)
  func.call @Owner___Owner_value(%owner_pointer, %owner_pointer_byte_offset) : (buffer, index)
  func.return
}

func.def public @comma_nontrivial_temporary(%first: buffer, %first_byte_offset: index, %second: buffer, %second_byte_offset: index) {
  func.call @Owner___Owner_value(%first, %first_byte_offset) : (buffer, index)
  func.call @observe(%second, %second_byte_offset) : (buffer, index)
  func.call @Owner___Owner_value(%second, %second_byte_offset) : (buffer, index)
  func.return
}

func.def inline @Owner___Owner_value(%this_pointer: buffer, %this_pointer_byte_offset: index) {
  func.call @observe(%this_pointer, %this_pointer_byte_offset) : (buffer, index)
  func.return
}

func.decl @observe(%29: buffer, %30: index)

// ====
// RUN: pass canonicalize,cse,dce
struct Slice {
  double* pointer;
  int lower;
  int stride;

  double& operator()(int index) const {
    return pointer[(index - lower) * stride];
  }
};

struct Nested {
  Slice slices[2];
};

double nested_temporary(double* first, double* second) {
  const Nested& nested = Nested{{{first, 0, 1}, {second, 1, 2}}};
  return nested.slices[1](3);
}

double array_subobject_temporary(double* first, double* second) {
  const Slice& slice = Nested{{{first, 0, 1}, {second, 1, 2}}}.slices[1];
  return slice(3);
}

double dynamic_array_subobject_temporary(int index, double* first,
                                         double* second) {
  const Slice& slice =
      Nested{{{first, 0, 1}, {second, 1, 2}}}.slices[index & 1];
  return slice(3);
}

struct Base {
  double* pointer;
};

struct Derived : Base {
  int offset;
};

double base_subobject_temporary(double* input) {
  const Base& base = Derived{{input}, 0};
  return base.pointer[0];
}

