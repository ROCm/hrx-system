// ====
// RUN: pass canonicalize,cse,dce
struct Slice {
  double* pointer;
  int lower;
  int stride;

  double& operator()(int index) const {
    return pointer[(index - lower) * stride];
  }
};

double conditional_temporary(bool choose, double* first, double* second) {
  const Slice& slice = choose ? Slice{first, 0, 1} : Slice{second, 1, 1};
  return slice(1);
}

double mutable_temporary(double* input) {
  Slice&& slice = Slice{input, 0, 1};
  slice.lower = 1;
  return slice(1);
}

double branch_mutation(bool choose, double* input) {
  Slice&& slice = Slice{input, 0, 1};
  if (choose) {
    slice.lower = 1;
  } else {
    slice.stride = 2;
  }
  return slice(2);
}

// ----
func.def public @conditional_temporary(%choose: i1, %first: buffer, %first_byte_offset: offset, %second: buffer, %second_byte_offset: offset) -> (f64) {
