  %10 = index.cast %9 : i64 to offset
  %11 = buffer.view %input[%10] : buffer -> view<1xf64>
  %12 = view.load<root_in_bounds> %11[0] : view<1xf64> -> f64
  func.call @Owner___Owner_value(%input, %input_byte_offset) : (buffer, offset)
  func.return %12 : f64
}

func.def public @nontrivial_temporary(%input: buffer, %input_byte_offset: offset) {
  func.call @observe(%input, %input_byte_offset) : (buffer, offset)
  func.call @Owner___Owner_value(%input, %input_byte_offset) : (buffer, offset)
  func.return
}

func.def public @mutable_nontrivial_temporary(%first: buffer, %first_byte_offset: offset, %second: buffer, %second_byte_offset: offset) {
  func.call @Owner___Owner_value(%second, %second_byte_offset) : (buffer, offset)
  func.return
}

func.def public @conditional_nontrivial_temporary(%choose: i1, %first: buffer, %first_byte_offset: offset, %second: buffer, %second_byte_offset: offset) {
  %owner_pointer = scf.select %choose, %first, %second : buffer
  %owner_pointer_byte_offset = scf.select %choose, %first_byte_offset, %second_byte_offset : offset
  func.call @observe(%owner_pointer, %owner_pointer_byte_offset) : (buffer, offset)
  func.call @Owner___Owner_value(%owner_pointer, %owner_pointer_byte_offset) : (buffer, offset)
  func.return
}

func.def public @comma_nontrivial_temporary(%first: buffer, %first_byte_offset: offset, %second: buffer, %second_byte_offset: offset) {
  func.call @Owner___Owner_value(%first, %first_byte_offset) : (buffer, offset)
  func.call @observe(%second, %second_byte_offset) : (buffer, offset)
  func.call @Owner___Owner_value(%second, %second_byte_offset) : (buffer, offset)
  func.return
}

func.def inline @Owner___Owner_value(%this_pointer: buffer, %this_pointer_byte_offset: offset) {
  func.call @observe(%this_pointer, %this_pointer_byte_offset) : (buffer, offset)
  func.return
}

func.decl @observe(%32: buffer, %33: offset)

// ====
// RUN: pass canonicalize,cse,dce
struct Slice {
  double* pointer;
  int lower;
  int stride;

  double& operator()(int index) const {
    return pointer[(index - lower) * stride];
  }
};

struct Nested {
  Slice slices[2];
};

double nested_temporary(double* first, double* second) {
  const Nested& nested = Nested{{{first, 0, 1}, {second, 1, 2}}};
  return nested.slices[1](3);
}

double array_subobject_temporary(double* first, double* second) {
  const Slice& slice = Nested{{{first, 0, 1}, {second, 1, 2}}}.slices[1];
  return slice(3);
}

double dynamic_array_subobject_temporary(int index, double* first,
                                         double* second) {
  const Slice& slice =
      Nested{{{first, 0, 1}, {second, 1, 2}}}.slices[index & 1];
  return slice(3);
}

struct Base {
  double* pointer;
};

struct Derived : Base {
  int offset;
};

double base_subobject_temporary(double* input) {
  const Base& base = Derived{{input}, 0};
  return base.pointer[0];
}

