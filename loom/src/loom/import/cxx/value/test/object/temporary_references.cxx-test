// ====
// RUN: pass canonicalize,cse,dce
void observe(double* pointer);

struct Owner {
  double* pointer;
  ~Owner() { observe(pointer); }
};

double projected_temporary(double* input) {
  double* const& pointer = Owner{input}.pointer;
  return pointer[0];
}

void nontrivial_temporary(double* input) {
  const Owner& owner = Owner{input};
  observe(owner.pointer);
}

void mutable_nontrivial_temporary(double* first, double* second) {
  Owner&& owner = Owner{first};
  owner.pointer = second;
}

void conditional_nontrivial_temporary(bool choose, double* first,
                                      double* second) {
  const Owner& owner = choose ? Owner{first} : Owner{second};
  observe(owner.pointer);
}

void comma_nontrivial_temporary(double* first, double* second) {
  const Owner& owner = (Owner{first}, Owner{second});
  observe(owner.pointer);
}

