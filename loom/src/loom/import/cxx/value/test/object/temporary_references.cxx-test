  %slice_pointer, %slice_pointer_byte_offset, %slice_lower, %slice_stride = scf.if %choose -> (buffer, index, i32, i32) {
    %10 = scalar.constant 0 : i32
    %11 = scalar.constant 1 : i32
    scf.yield %first, %first_byte_offset, %10, %11 : buffer, index, i32, i32
  } else {
    %12 = scalar.constant 1 : i32
    scf.yield %second, %second_byte_offset, %12, %12 : buffer, index, i32, i32
  }
  %14 = scalar.constant 1 : i32
  %15, %16 = func.call pure @Slice__operator_call_value(%slice_pointer, %slice_pointer_byte_offset, %slice_lower, %slice_stride, %14) : (buffer, index, i32, i32, i32) -> (buffer, index)
  %17 = buffer.view %15[%16] : buffer -> view<1xf64>
  %18 = view.load<root_in_bounds|type_disjoint> %17[0] : view<1xf64> -> f64
  func.return %18 : f64
}

func.def public @mutable_temporary(%input: buffer, %input_byte_offset: index) -> (f64) {
  %slice_stride = scalar.constant 1 : i32
  %26, %27 = func.call pure @Slice__operator_call_value(%input, %input_byte_offset, %slice_stride, %slice_stride, %slice_stride) : (buffer, index, i32, i32, i32) -> (buffer, index)
  %28 = buffer.view %26[%27] : buffer -> view<1xf64>
  %29 = view.load<root_in_bounds|type_disjoint> %28[0] : view<1xf64> -> f64
  func.return %29 : f64
