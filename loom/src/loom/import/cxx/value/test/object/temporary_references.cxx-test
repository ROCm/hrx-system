  %45 = buffer.view %43[%44] : buffer -> view<1xf64>
  %46 = view.load<root_in_bounds> %45[0] : view<1xf64> -> f64
  func.return %46 : f64
}

func.def @Slice__operator_call_value(%this_pointer: buffer, %this_pointer_byte_offset: offset, %this_lower: i32, %this_stride: i32, %index: i32) -> (buffer, offset) {
  %54 = scalar.subi %index, %this_lower : i32
  %55 = scalar.muli %54, %this_stride : i32
  %56 = scalar.extsi %55 : i32 to i64
