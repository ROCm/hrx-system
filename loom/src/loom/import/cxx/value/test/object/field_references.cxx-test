  %slice = scf.if %choose -> (i32) {
    %4 = func.call pure @initialize(%input) : (i32) -> (i32)
    scf.yield %4 : i32
  } else {
    %5 = scalar.constant 1 : i32
    %6 = scalar.addi %input, %5 : i32
    %7 = func.call pure @initialize(%6) : (i32) -> (i32)
    scf.yield %7 : i32
  }
  %8 = func.call pure @forwarded(%slice) : (i32) -> (i32)
  func.return %8 : i32
}

func.def @initialize(%input: i32) -> (i32) {
  func.return %input : i32
}

func.def @forwarded(%slice_length: i32) -> (i32) {
  %13 = func.call pure @length(%slice_length) : (i32) -> (i32)
  func.return %13 : i32
}

func.def @length(%slice_length: i32) -> (i32) {
  func.return %slice_length : i32
}

// ====
// A pointer is one semantic group: its buffer identity and byte offset travel
// together, without reading or returning the untouched length field.
struct Slice { float* data; unsigned length; };
static void advance(Slice& slice) { slice.data += 2; }
float read_advanced(float* data) {
  Slice slice;
  slice.data = data;
  advance(slice);
  return *slice.data;
}
// ----
func.def public @read_advanced(%data: buffer, %data_byte_offset: offset) -> (f32) {
  %3, %4 = func.call pure @advance(%data, %data_byte_offset) : (buffer, offset) -> (buffer, offset)
  %5 = buffer.view %3[%4] : buffer -> view<1xf32>
  %6 = view.load %5[0] : view<1xf32> -> f32
  func.return %6 : f32
}

