  %index$7 = scalar.constant 0 : i32
  %8 = scalar.constant 1 : i1
  %state_length$14, %index$15 = scf.while(%state_length$9 = %state_length$4 : i32, %index$10 = %index$7 : i32, %11 = %8 : i1) -> (i32, i32) {
    %16, %state_length$17, %index$18 = scf.if %11 -> (i1, i32, i32) {
      %19 = scalar.cmpi ult, %index$10, %count : i32
      scf.yield %19, %state_length$9, %index$10 : i1, i32, i32
    } else {
      %20 = scalar.constant 0 : i1
      scf.yield %20, %state_length$9, %index$10 : i1, i32, i32
    }
    scf.condition %16, %state_length$17, %index$18 : i1, i32, i32
  } do(%state_length$12: i32, %index$13: i32) {
    %state_length$21 = scalar.constant 1 : i32
    %22 = scalar.constant 9 : i32
    %23 = scalar.cmpi eq, %count, %22 : i32
    %24, %25 = scf.if %23 -> (i1, i1) {
      %26 = scalar.constant 0 : i1
      scf.yield %26, %26 : i1, i1
    } else {
      %27 = scalar.constant 1 : i1
      scf.yield %27, %27 : i1, i1
    }
    %state_length$28, %index$29 = scf.if %25 -> (i32, i32) {
      %index = scalar.addi %index$13, %state_length$21 : i32
      scf.yield %state_length$21, %index : i32, i32
    } else {
      scf.yield %state_length$21, %index$13 : i32, i32
