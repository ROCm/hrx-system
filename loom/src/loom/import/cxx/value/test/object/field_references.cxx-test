// ====
// Read-only aliases of the receiver retain their source identities. Selecting
// the second receiver must not replace the object named by the argument.
struct Cell {
  unsigned value;
  [[loom::noinline]] unsigned compare(const Cell& other) const { return value * 10 + other.value; }
};
unsigned selected_receiver(bool choose, unsigned first, unsigned second) {
  Cell left{first}, right{second};
  return (choose ? left : right).compare(left);
}
