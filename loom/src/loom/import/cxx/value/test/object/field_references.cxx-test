  %11 = scalar.constant 2 : i32
  %12 = scalar.extsi %11 : i32 to i64
  %13 = scalar.constant 4 : i64
  %14 = scalar.muli %12, %13 : i64
  %15 = index.cast %slice_data_byte_offset : offset to i64
  %16 = scalar.addi %15, %14 : i64
  %17 = scalar.assume %16 [range(%16, 0, 9223372036854775807)] : i64
  %18 = index.cast %17 : i64 to offset
  func.return %slice_data, %18 : buffer, offset
}

// ====
// Recursive helper contracts converge across forward declarations. A path
// without a write preserves the original value as an input.
struct Pair { unsigned first; unsigned second; };
static void odd(Pair&, unsigned);
static void even(Pair& pair, unsigned count) {
  if (count) odd(pair, count - 1);
  else pair.first = 7;
}
static void odd(Pair& pair, unsigned count) {
  if (count) even(pair, count - 1);
}
unsigned recursive(unsigned count) {
  Pair pair;
  pair.first = 3;
  even(pair, count);
  return pair.first;
}
