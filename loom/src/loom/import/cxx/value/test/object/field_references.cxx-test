// ====
// Selected references read and replace only the helper's fields. Both source
// objects retain their uninitialized pointer field without an invented value.
struct Slice { unsigned* data; unsigned length; };
[[loom::noinline]] static unsigned advance(Slice& slice, unsigned step) {
  slice.length += step;
  return slice.length;
}
unsigned selected_length(bool choose, unsigned first, unsigned second) {
  Slice left, right;
  left.length = first;
  right.length = second;
  auto& chosen = choose ? left : right;
  unsigned result = advance(chosen, 3);
  return result + left.length * 10 + right.length;
}
