  %pair_storage = buffer.alloca<private> align(4) %2 : buffer
  %pair_storage_byte_offset = index.constant 0 : offset
  %pair_view = buffer.view %pair_storage[%pair_storage_byte_offset] : buffer -> view<8xi8>
  %6 = scalar.constant 3 : i32
  %7 = index.constant 0 : offset
  %8 = index.add %pair_storage_byte_offset, %7 : offset
  %9 = index.assume %8 [range(%8, 0, 4)] : offset
  %10 = buffer.view %pair_storage[%9] : buffer -> view<1xi32>
  view.store %6, %10[0] : i32, view<1xi32>
  func.call @even(%pair_storage, %pair_storage_byte_offset, %count) : (buffer, offset, i32)
  %11 = index.constant 0 : offset
  %12 = index.add %pair_storage_byte_offset, %11 : offset
  %13 = index.assume %12 [range(%12, 0, 4)] : offset
  %14 = buffer.view %pair_storage[%13] : buffer -> view<1xi32>
  %first = view.load %14[0] : view<1xi32> -> i32
  func.return %first : i32
}

func.def @even(%pair: buffer, %pair_byte_offset: offset, %count: i32) {
  %19 = scalar.constant 0 : i32
  %20 = scalar.cmpi ne, %count, %19 : i32
  scf.if %20 {
    %21 = scalar.constant 1 : i32
    %22 = scalar.subi %count, %21 : i32
    func.call @odd(%pair, %pair_byte_offset, %22) : (buffer, offset, i32)
  } else {
    %23 = scalar.constant 7 : i32
    %24 = index.constant 0 : offset
    %25 = index.add %pair_byte_offset, %24 : offset
    %26 = buffer.view %pair[%25] : buffer -> view<1xi32>
    view.store %23, %26[0] : i32, view<1xi32>
  }
  func.return
}

func.def @odd(%pair: buffer, %pair_byte_offset: offset, %count: i32) {
  %30 = scalar.constant 0 : i32
  %31 = scalar.cmpi ne, %count, %30 : i32
  scf.if %31 {
    %32 = scalar.constant 1 : i32
    %33 = scalar.subi %count, %32 : i32
    func.call @even(%pair, %pair_byte_offset, %33) : (buffer, offset, i32)
  }
  func.return
