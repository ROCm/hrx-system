// ====
// The assignment RHS reads length before the destination expression changes it.
struct State { unsigned length; };
static void store(unsigned* output, State& state) {
  output[state.length = 1] = state.length;
}
unsigned ordered(unsigned* output, unsigned input) {
  State state{input};
  store(output, state);
  return state.length;
}
// ----
func.def public @ordered(%output: buffer, %output_byte_offset: offset, %input: i32) -> (i32) {
  %state_length = func.call @store(%output, %output_byte_offset, %input) : (buffer, offset, i32) -> (i32)
  func.return %state_length : i32
}

