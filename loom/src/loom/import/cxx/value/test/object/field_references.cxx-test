// ====
// The loop body defines length before the increment expression consumes it.
// A break skips that increment. A zero-trip loop still preserves its input.
struct State { unsigned length; };
static void run(State& state, unsigned count) {
  for (unsigned index = 0; index < count; index += state.length) {
    state.length = 1;
    if (count == 9) break;
  }
}
unsigned loop(unsigned count) {
  State state{4};
  run(state, count);
  return state.length;
}
