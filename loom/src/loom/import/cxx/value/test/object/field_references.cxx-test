  %state_length$9 = scalar.constant 1 : i32
  %10 = scalar.extui %state_length$9 : i32 to i64
  %11 = scalar.constant 4 : i64
  %12 = scalar.muli %10, %11 : i64
  %13 = index.cast %output_byte_offset : offset to i64
  %14 = scalar.addi %13, %12 : i64
  %15 = scalar.assume %14 [range(%14, 0, 9223372036854775807)] : i64
  %16 = index.cast %15 : i64 to offset
  %17 = buffer.view %output[%16] : buffer -> view<1xi32>
  view.store %state_length$7, %17[0] : i32, view<1xi32>
  func.return %state_length$9 : i32
}

// ====
// The loop body defines length before the increment expression consumes it.
// A break skips that increment. A zero-trip loop still preserves its input.
struct State { unsigned length; };
static void run(State& state, unsigned count) {
  for (unsigned index = 0; index < count; index += state.length) {
    state.length = 1;
    if (count == 9) break;
  }
}
unsigned loop(unsigned count) {
  State state{4};
  run(state, count);
  return state.length;
}
