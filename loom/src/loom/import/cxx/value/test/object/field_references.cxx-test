  %13 = scalar.constant 0 : i32
  %14 = scalar.cmpi eq, %6, %13 : i32
  %15 = scf.if %14 -> (i32) {
    scf.yield %12 : i32
  } else {
    scf.yield %first : i32
  }
  %16 = scalar.constant 0 : i32
  %17 = scalar.cmpi eq, %6, %16 : i32
  %18 = scf.if %17 -> (i32) {
    scf.yield %second : i32
  } else {
    scf.yield %12 : i32
  }
  %19 = scalar.constant 10 : i32
  %20 = scalar.muli %15, %19 : i32
  %21 = scalar.addi %result, %20 : i32
  %22 = scalar.addi %21, %18 : i32
