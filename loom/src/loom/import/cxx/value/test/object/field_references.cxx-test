// A selected vector lane uses the index evaluated by its own arm. An index
// valid for the larger vector is never read against the shorter alternative.
using Small = unsigned __attribute__((vector_size(8)));
using Large = unsigned __attribute__((vector_size(16)));
static void update(unsigned& value) { value += 5; }
unsigned selected_lane(bool choose, unsigned first_index, unsigned second_index) {
  Small first{1, 2};
  Large second{3, 4, 5, 6};
  update(choose ? first[first_index] : second[second_index]);
  return first[1] * 10 + second[3];
}
