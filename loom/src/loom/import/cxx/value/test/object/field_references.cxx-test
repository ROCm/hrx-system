// ====
// A dynamic view remains a complete dependent group while the unrelated
// pointer field stays uninitialized.
#include <loomcxx/view.h>
namespace loomt = loom::type;
using Rows = loomt::view<loomt::shape<loomt::dynamic, 4>, const float, loomt::encoding<loom::encoding::role::layout, 2>>;
struct Window { Rows rows; const float* unused; };
static void trim(Window& window, unsigned remaining) {
  window.rows = loom::view::subview(window.rows, {1, 0}, {remaining});
}
Rows cropped(Rows rows, unsigned remaining) {
  Window window;
  window.rows = rows;
  trim(window, remaining);
  return window.rows;
}
// ----
func.def public @cropped(%rows_dim0: index, %rows_layout: encoding<layout>, %rows: view<[%rows_dim0]x4xf32, %rows_layout>, %remaining: i32) -> (%4: index, %5: encoding<layout>, view<[%4]x4xf32, %5>) {
  %7, %8, %9 = func.call pure @trim(%rows_dim0, %rows_layout, %rows, %remaining) : (index, encoding<layout>, view<[%rows_dim0]x4xf32, %rows_layout>, i32) -> (index, encoding<layout>, view<[%7]x4xf32, %8>)
  func.return %7, %8, %9 : index, encoding<layout>, view<[%7]x4xf32, %8>
}

func.def @trim(%window_rows_dim0: index, %window_rows_layout: encoding<layout>, %window_rows: view<[%window_rows_dim0]x4xf32, %window_rows_layout>, %remaining: i32) -> (%14: index, %15: encoding<layout>, view<[%14]x4xf32, %15>) {
  %17 = scalar.constant 1 : i32
  %18 = scalar.extsi %17 : i32 to i64
  %19 = scalar.constant 0 : i32
  %20 = scalar.extsi %19 : i32 to i64
  %21 = scalar.extui %remaining : i32 to i64
  %22 = index.cast %21 : i64 to index
  %23 = index.cast %18 : i64 to index
  %24 = index.cast %20 : i64 to index
  %25 = view.subview %window_rows[%23, %24] : view<[%window_rows_dim0]x4xf32, %window_rows_layout> -> view<[%22]x4xf32, %window_rows_layout>
  func.return %22, %window_rows_layout, %25 : index, encoding<layout>, view<[%22]x4xf32, %window_rows_layout>
}
