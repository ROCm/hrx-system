// RUN: roundtrip
// Private helpers transport only the initialized fields they actually use.
struct Slice { float* data; unsigned length; };
static unsigned length(const Slice&);
static unsigned forwarded(const Slice& slice) { return length(slice); }
static unsigned length(const Slice& slice) { return slice.length; }
static void initialize(unsigned& output, unsigned input) { output = input; }
unsigned partial_length(unsigned input, bool choose) {
  Slice slice;
  if (choose) initialize(slice.length, input);
  else initialize(slice.length, input + 1);
  return forwarded(slice);
}
