load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")
load("//loom/build_tools/bazel:loom_check.bzl", "loom_check_test_suite")

package(
    default_visibility = ["//visibility:private"],
    licenses = ["notice"],
)

loom_check_test_suite(
    name = "compiler_test",
    srcs = [
        "array_records.cxx-test",
        "layout_attributes.cxx-test",
        "layout_attributes_roundtrip.cxx-test",
        "member_functions.cxx-test",
        "member_functions_cleanup.cxx-test",
        "member_functions_invalid.cxx-test",
        "offsetof.cxx-test",
        "offsetof_roundtrip.cxx-test",
        "record_arrays.cxx-test",
        "record_constructors.cxx-test",
        "record_initialization.cxx-test",
        "record_memory.cxx-test",
        "record_memory_invalid.cxx-test",
        "reference_accessors.cxx-test",
        "reference_parameters.cxx-test",
        "reference_parameters_invalid.cxx-test",
    ],
    data = [
        "aligned_layout.h",
        "offsetof_layout.h",
        "packed_layout.h",
        "record_layout.h",
    ],
    target_compatible_with = loom_config_compatible_with(["//loom/config/import:cxx"]),
)
