  %3 = scf.if %choose -> (i32) {
    %value = func.call pure @increment(%value$1) : (i32) -> (i32)
    scf.yield %value : i32
  } else {
    scf.yield %value$1 : i32
  }
  func.return %3 : i32
}

func.def public @right(%choose: i1, %value$6: i32) -> (i32) {
  %8 = scf.if %choose -> (i32) {
    scf.yield %value$6 : i32
  } else {
    %value = func.call pure @increment(%value$6) : (i32) -> (i32)
    scf.yield %value : i32
  }
  func.return %8 : i32
}

