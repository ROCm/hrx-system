// ====
// Loops and earlier reads use ordinary SSA results without copy bookkeeping.
[[loom::import("example", "observe")]] void observe(unsigned value);
static void increment(unsigned& value) { ++value; }
unsigned last_use(unsigned value) {
  unsigned unused = value;
  observe(value);
  increment(value);
  return value;
