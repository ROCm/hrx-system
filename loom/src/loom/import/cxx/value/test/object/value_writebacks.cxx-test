  %value$3 = func.call pure @replace_entropy(%replacement) : (check.entropy) -> (check.entropy)
  func.return %value$0 : check.entropy
}

func.def @replace_entropy(%replacement: check.entropy) -> (check.entropy) {
  func.return %replacement : check.entropy
}

