// RUN: roundtrip
// Exclusive uses keep the original identity in either branch ordering.
static void increment(unsigned& value) { ++value; }
unsigned left(bool choose, unsigned value) {
  unsigned saved = value;
  if (choose) {
    increment(value);
    return value;
  }
  return saved;
}
unsigned right(bool choose, unsigned value) {
  unsigned saved = value;
  if (choose) return saved;
  increment(value);
  return value;
}

