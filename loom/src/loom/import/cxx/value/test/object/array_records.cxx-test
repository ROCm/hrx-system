// ====
// Explicit vectors remain whole components in a copied record array, including
// dynamic element mutation, a helper call, and a separate local vector array.
using Words = unsigned __attribute__((vector_size(16)));
struct VectorRecord {
  // Two vector components with independent lane values.
  Words values[2];
};
static Words forward(Words value) { return value; }
unsigned vector_elements(unsigned index) {
  VectorRecord original{{Words{1, 2, 3, 4}, Words{5, 6, 7, 8}}};
  VectorRecord copy = original;
  copy.values[index] += Words{1, 1, 1, 1};
  Words observed = forward(copy.values[index]);
  Words first = original.values[0];
  Words array[2] = {Words{11, 13, 17, 19}, Words{23, 29, 31, 37}};
  Words selected = array[index];
  return observed[3] + first[0] + selected[0];
}
