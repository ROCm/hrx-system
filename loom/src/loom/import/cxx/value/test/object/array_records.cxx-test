// ====
// Snapshot both source fields before a member alias mutates the copy. A
// self-assignment preserves it; subsequent whole-record stores use distinct
// saved snapshots even if the source record aliases a destination.
struct Command {
  // Two scalar components belonging to each independent object.
  unsigned words[2];
};
void snapshots(Command* records, unsigned index) {
  Command saved = records[index];
  Command other = saved;
  Command* object = &saved;
  unsigned* member = object->words;
  member[1] += 17u;
  *object = *object;
  records[0] = saved;
  records[1] = other;
}
