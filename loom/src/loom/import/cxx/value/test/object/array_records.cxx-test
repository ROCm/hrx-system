// ====
// Inherited array storage promotes exactly as the same composed object does.
struct Base { double a[3]; };
struct Grad : Base { double scale; };
struct Composed { Base base; double scale; };
double inherited(double input) {
  Grad value{{{input, 2.0, 3.0}}, 4.0};
  return value.a[0] * value.scale + value.a[1];
}
double composed(double input) {
  Composed value{{{input, 2.0, 3.0}}, 4.0};
  return value.base.a[0] * value.scale + value.base.a[1];
}
