  %230 = index.constant 0 : offset
  %152 = buffer.view %words[%230] : buffer -> view<1xi32>
  view.store %143, %152[0] : i32, view<1xi32>
  %229 = index.constant 4 : offset
  %156 = buffer.view %words[%229] : buffer -> view<1xi32>
  view.store %144, %156[0] : i32, view<1xi32>
  %159 = scalar.extui %index : i32 to i64
  %227 = scalar.constant 2 : i64
  %228 = scalar.shli %159, %227 : i64
  %164 = scalar.assume %228 [range(%228, 0, 9223372036854775807)] : i64
  %165 = index.cast %164 : i64 to offset
  %166 = index.assume %165 [range(%165, 0, 4)] : offset
  %167 = buffer.view %words[%166] : buffer -> view<1xi32>
  %168 = view.load %167[0] : view<1xi32> -> i32
  func.return %168 : i32
}

