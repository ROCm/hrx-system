// ====
// Nested array extents retain their row strides through by-value calls and
// copies. Updating a copy leaves both the original and the untouched row intact.
struct Matrix {
  // Two rows, each containing two words.
  unsigned values[2][2];
};
static Matrix forward(Matrix value) { return value; }
unsigned matrix_copy(unsigned index, unsigned seed) {
  Matrix original{};
  original.values[1][index] = seed;
  Matrix copy = forward(original);
  copy.values[1][index] += 2u;
  return original.values[1][index] + copy.values[1][index] + original.values[0][0];
}
