// ====
// An array of records containing arrays keeps every object partition separate.
struct Command {
  // Two words belonging to one command.
  unsigned words[2];
};
struct Commands {
  // Two independently copied commands.
  Command values[2];
};
static Commands forward(Commands value) { return value; }
unsigned command_copy(unsigned index, unsigned seed) {
  Commands original{};
  original.values[index].words[1] = seed;
  Commands copy = forward(original);
  copy.values[index].words[1] += 3u;
  return original.values[index].words[1] + copy.values[index].words[1] +
         original.values[1u - index].words[0];
}
