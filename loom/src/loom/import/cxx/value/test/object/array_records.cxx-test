  %value_words_0$15 = view.load<root_in_bounds> %14[0] : view<1xi32> -> i32
  %16 = index.constant 4 : offset
  %17 = index.add %11, %16 : offset
  %18 = buffer.view %source[%17] : buffer -> view<1xi32>
  %value_words_1 = view.load<root_in_bounds> %18[0] : view<1xi32> -> i32
