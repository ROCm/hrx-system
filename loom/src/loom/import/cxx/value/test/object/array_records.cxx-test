  %8 = scalar.constant 37 : i32
  %13 = scalar.constant 41 : i32
  %52, %53 = func.call @adjust(%8, %13, %index) : (i32, i32, i32) -> (i32, i32)
  %90 = scalar.constant 100 : i32
  %104 = scalar.muli %90, %53 : i32
  %105 = scalar.addi %52, %104 : i32
  %225 = scalar.constant 37420000 : i32
  %226 = scalar.addi %105, %225 : i32
  func.return %226 : i32
}

