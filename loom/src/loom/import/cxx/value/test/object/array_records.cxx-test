// ====
// Const array elements remain independently copied values and support dynamic
// observations of both the original object and its copy.
struct ConstArray {
  // Read-only source words carried through the record value partition.
  const unsigned words[2];
};
unsigned constant_member(unsigned index) {
  ConstArray original{{3, 5}};
  ConstArray copy = original;
  return copy.words[index] + original.words[1u - index];
}
