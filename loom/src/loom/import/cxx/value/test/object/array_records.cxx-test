// ====
// Arrays containing semantic pointer members remain value partitions. A
// commuted dynamic subscript retains an alias for sparse field mutation, and
// nested selectors flatten to one row-major ordinal.
struct SemanticItem {
  // Semantic component that cannot be materialized as C++ object bytes.
  int* data;
  // Independently writable scalar component.
  unsigned value;
};
unsigned semantic_array(int* data, unsigned choice, unsigned next) {
  SemanticItem items[3] = {{data, 1u}, {data, 2u}, {data, 3u}};
  SemanticItem& selected = choice[items];
  selected.value += next;
  return selected.value + items[2].value;
}
unsigned semantic_matrix(int* data, unsigned row, unsigned column,
                         unsigned next) {
  SemanticItem items[2][2] = {
      {{data, 1u}, {data, 2u}},
      {{data, 3u}, {data, 4u}},
  };
  items[row][column].value += next;
  return items[row][column].value + items[1][0].value;
}

