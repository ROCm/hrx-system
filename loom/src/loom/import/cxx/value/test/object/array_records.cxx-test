  view.store<root_in_bounds|type_disjoint> %3, %16[0] : i32, view<1xi32>
  %17 = scalar.constant 19 : i32
  %18 = index.constant 16 : index
  %commands_byte_offset = index.add %value_byte_offset, %18 : index
  %59 = index.madd %12, %61, %commands_byte_offset : index
  %31 = index.add %59, %13 : index
  %32 = buffer.view %value[%31] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %17, %32[0] : i32, view<1xi32>
  %57 = scalar.constant -7 : i16
  %37 = index.constant 32 : index
  %narrow_byte_offset = index.add %value_byte_offset, %37 : index
  %41 = index.constant 2 : index
