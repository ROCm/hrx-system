// ====
// Mixed nested shapes share one source layout: array extents and narrow field
// offsets must compose before any by-value snapshot flattens their components.
struct Command {
  // Two words belonging to one nested command.
  unsigned words[2];
};
struct Nested {
  // Two independent row and column extents.
  unsigned matrix[2][2];
  // Two commands, each with its own word array.
  Command commands[2];
  // Signed 16-bit values after the command array.
  short narrow[2];
  // Byte-sized boolean storage after the narrow array.
  bool flags[2];
};
static_assert(sizeof(Nested) == 40);
void nested_layout(Nested* value, unsigned index) {
  value->matrix[1][index] = 17;
  value->commands[index].words[1] = 19;
  value->narrow[index] = -7;
  value->flags[index] = true;
}
