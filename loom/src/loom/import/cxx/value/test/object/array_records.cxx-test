  %10 = index.cast %value_byte_offset : offset to i64
  %11 = scalar.addi %10, %78 : i64
  %12 = scalar.assume %11 [range(%11, 0, 9223372036854775807)] : i64
  %13 = index.cast %12 : i64 to offset
  %14 = scalar.extui %index : i32 to i64
