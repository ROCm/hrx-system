  %112 = index.madd %8, %9, %records_byte_offset : index
  %14 = buffer.view %records[%112] : buffer -> view<1xi32>
  %15 = view.load<root_in_bounds|type_disjoint> %14[0] : view<1xi32> -> i32
  %16 = index.constant 4 : index
  %17 = index.add %112, %16 : index
  %18 = buffer.view %records[%17] : buffer -> view<1xi32>
  %19 = view.load<root_in_bounds|type_disjoint> %18[0] : view<1xi32> -> i32
  %40 = scalar.constant 17 : i32
  %49 = scalar.addi %19, %40 : i32
  %85 = buffer.view %records[%records_byte_offset] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %15, %85[0] : i32, view<1xi32>
  %87 = index.add %records_byte_offset, %16 : index
  %88 = buffer.view %records[%87] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %49, %88[0] : i32, view<1xi32>
  %93 = index.add %records_byte_offset, %9 : index
  %96 = buffer.view %records[%93] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %15, %96[0] : i32, view<1xi32>
  %98 = index.add %93, %16 : index
  %99 = buffer.view %records[%98] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %19, %99[0] : i32, view<1xi32>
  func.return
}

// ====
// Nested array extents retain their row strides through by-value calls and
// copies. Updating a copy leaves both the original and the untouched row intact.
struct Matrix {
  // Two rows, each containing two words.
  unsigned values[2][2];
};
static Matrix forward(Matrix value) { return value; }
unsigned matrix_copy(unsigned index, unsigned seed) {
  Matrix original{};
  original.values[1][index] = seed;
  Matrix copy = forward(original);
  copy.values[1][index] += 2u;
  return original.values[1][index] + copy.values[1][index] + original.values[0][0];
}
