// ====
// Narrow signed and boolean arrays use their source storage widths while
// transported values preserve signed extension and boolean normalization.
struct Observations {
  // Signed 16-bit fields updated through integer promotion.
  short narrow[2];
  // Boolean fields stored as bytes and transported as predicates.
  bool flags[2];
};
static Observations forward(Observations value) { return value; }
unsigned narrow_copy(unsigned index) {
  Observations original{};
  original.narrow[index] = -7;
  original.flags[index] = true;
  Observations copy = forward(original);
  copy.narrow[index] += 5;
  copy.flags[index] = false;
  return unsigned(copy.narrow[index] + 7) + original.flags[index] + copy.flags[index];
}
