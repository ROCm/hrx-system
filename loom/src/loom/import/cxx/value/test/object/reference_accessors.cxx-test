template <class T>
struct RemoveReference {
  using Type = T;
};
template <class T>
struct RemoveReference<T&> {
  using Type = T;
};
template <class T>
using RemoveReferenceT = typename RemoveReference<T>::Type;
template <class T>
constexpr RemoveReferenceT<T>&& move(T&& value) {
  return static_cast<RemoveReferenceT<T>&&>(value);
}

struct ReceiverValue;
static void mutate_forwarded_receiver(ReceiverValue&& value);

struct ReceiverValue {
  unsigned member;
  void increment() && { ++member; }
  unsigned observe() const&& { return member; }
  ReceiverValue&& advance(unsigned amount) && {
    member += amount;
    return static_cast<ReceiverValue&&>(*this);
  }
  ReceiverValue&& operator+() && {
    member += 4u;
    return static_cast<ReceiverValue&&>(*this);
  }
  ReceiverValue&& operator[](unsigned amount) && {
    member += amount;
    return static_cast<ReceiverValue&&>(*this);
  }
  ReceiverValue&& self() && { return static_cast<ReceiverValue&&>(*this); }
  void forward() { mutate_forwarded_receiver(static_cast<ReceiverValue&&>(*this).self()); }
};

static void mutate_forwarded_receiver(ReceiverValue&& value) {
  value.member += 5u;
}

unsigned reference_receiver(bool condition, unsigned input) {
  ReceiverValue value{input};
  if (condition) {
    (+move(value))[3u].advance(2u).increment();
  }
  return move(value).observe() + value.member;
}

static void mutate_receiver(ReceiverValue& value) { move(value).increment(); }

unsigned reference_parameter_receiver(unsigned input) {
  ReceiverValue value{input};
  mutate_receiver(value);
  return value.member;
}

unsigned forwarded_current_receiver(unsigned input) {
  ReceiverValue value{input};
  value.forward();
  return value.member;
}

struct AddressedReceiverValue {
  unsigned member;
  unsigned* address() && { return &member; }
};

unsigned storage_reference_receiver(unsigned input) {
  AddressedReceiverValue value{input};
  unsigned* pointer = move(value).address();
  ++*pointer;
  return value.member;
}

