  %29 = scalar.constant 7 : i32
  %94 = scalar.addi %input, %29 : i32
  %33 = scalar.constant 1000 : i32
  %184 = scalar.muli %input, %33 : i32
  %40 = scalar.constant 100 : i32
  %41 = scalar.muli %94, %40 : i32
  %186 = scalar.addi %184, %41 : i32
  %56 = scalar.constant 10 : i32
  %57 = scalar.muli %94, %56 : i32
  %188 = scalar.addi %186, %57 : i32
  %190 = scalar.constant 16004 : i32
  %191 = scalar.addi %188, %190 : i32
  func.return %191 : i32
}

