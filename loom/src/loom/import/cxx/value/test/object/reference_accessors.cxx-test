// ====
// Observing the returned address deliberately selects the durable pointer ABI;
// an ordinal result is used only while source identity remains abstract.
static unsigned& choose_address(bool first, unsigned& left, unsigned& right) {
  return first ? left : right;
}

unsigned address_selected_result(bool first, unsigned left, unsigned right) {
  unsigned* selected = &choose_address(first, left, right);
  ++*selected;
  return left + right;
}

