// ====
// Volatile origins retain one access in each selector arm; runtime execution
// performs only the chosen load and never snapshots both referents eagerly.
static const volatile unsigned& choose_volatile(
    bool first, const volatile unsigned& left,
    const volatile unsigned& right) {
  return first ? left : right;
}

unsigned read_selected_volatile(bool first, const volatile unsigned* left,
                                const volatile unsigned* right) {
  return choose_volatile(first, *left, *right);
}

