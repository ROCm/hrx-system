  %3 = scalar.constant 10 : i32
  %snapshot = scalar.addi %value, %3 : i32
  func.call pure @branch_alias(%condition, %value) : (i1, i32)
  %5 = scalar.constant 20 : i32
  %selected = scalar.addi %value, %5 : i32
  %7 = scalar.addi %snapshot, %selected : i32
  func.return %7 : i32
}

