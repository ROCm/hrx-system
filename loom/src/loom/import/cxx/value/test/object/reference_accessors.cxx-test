// RUN: roundtrip
using UInt4 = unsigned __attribute__((vector_size(16)));

unsigned local_alias(unsigned value, UInt4 values, unsigned lane) {
  unsigned& scalar = value;
  scalar += 3u;
  scalar *= 2u;
  unsigned& element = values[lane & 3u];
  element += scalar;
  element *= 2u;
  return scalar + element + values[lane & 3u];
}

