// RUN: pass canonicalize,cse,dce
// Reading both a lexical alias and its owner observes the same mutations.
unsigned local_alias_value(unsigned value) {
  unsigned& alias = value;
  alias += 3u;
  alias *= 2u;
  return alias + value;
}

