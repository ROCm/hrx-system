// ====
// RUN: pass inline-callables,promote-private-fragments,canonicalize,cse,dce
// A default reference member borrows caller-owned local storage. The returned
// snapshot and the caller reload both observe the helper mutation.
struct DefaultReference {
  // Address used by the default reference initializer.
  unsigned* pointer;
  // Reference to the pointee, retaining its original identity.
  unsigned& alias = *pointer;
};

static unsigned default_reference(unsigned* values, unsigned amount) {
  DefaultReference reference{values};
  reference.alias += amount;
  return *reference.pointer;
}

unsigned default_reference_value(unsigned input, unsigned amount) {
  unsigned value = input;
  const unsigned result = default_reference(&value, amount);
  return result * 100u + value;
}
// ----
