// ====
// Lexical references retain exact nested SSA destinations and observe later
// whole-object replacements. An identity escape makes the same owner physical.
struct Pair {
  unsigned first;
  unsigned second;
};
struct Outer {
  unsigned prefix;
  Pair pair;
};
unsigned member_references(unsigned first, unsigned second) {
  Outer value{1u, {first, second}};
  Pair& pair = value.pair;
  unsigned& scalar = pair.first;
  const unsigned& observed = pair.second;
  pair = Pair{second, first + second};
  scalar += 3u;
  pair.second += scalar;
  return scalar * 100u + observed;
}
unsigned escaped_member_reference(unsigned input) {
  Pair value{input, 2u};
  unsigned& alias = value.first;
  unsigned* pointer = &alias;
  ++*pointer;
  return value.first;
}

