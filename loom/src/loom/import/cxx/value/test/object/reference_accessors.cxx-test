// ====
// A finite set of returned parameter origins uses one ordinal result. Separate
// returns and a nested conditional map into the same callable contract, and a
// write through the result updates exactly the selected caller destination.
static unsigned& choose_written_origin(unsigned choice, unsigned& first,
                                       unsigned& second, unsigned& third) {
  if (choice == 0u) return second;
  return choice == 1u ? first : third;
}

unsigned write_selected_result(unsigned choice, unsigned first,
                               unsigned second, unsigned third,
                               unsigned replacement) {
  choose_written_origin(choice, first, second, third) = replacement;
  return first + 10u * second + 100u * third;
}

