// ====
// Default-initialized objects retain physical storage before interprocedural
// reference ABI selection. Explicit aggregate values remain ordinary SSA.
struct Pair {
  unsigned first;
  unsigned second;
};
static void initialize_pair(unsigned seed, Pair& output) {
  output.first = seed;
  output.second = seed + 1u;
}
static void initialize_scalar(unsigned seed, unsigned& output) {
  output = seed * 2u;
}
unsigned automatic_outputs(unsigned seed) {
  Pair pair;
  unsigned scalar;
  initialize_pair(seed, pair);
  initialize_scalar(pair.second, scalar);
  return pair.first + scalar;
}
unsigned initialized_value(unsigned seed) {
  Pair pair{seed, seed + 1u};
  return pair.first + pair.second;
}
// ----
func.def public @automatic_outputs(%seed: i32) -> (i32) {
  %2 = index.constant 8 : offset
  %pair_storage = buffer.alloca<private> align(4) %2 : buffer
  %pair_storage_byte_offset = index.constant 0 : index
  %6 = index.constant 4 : offset
  %scalar_storage = buffer.alloca<private> align(4) %6 : buffer
  %scalar_view = buffer.view %scalar_storage[%pair_storage_byte_offset] : buffer -> view<1xi32>
  func.call @initialize_pair(%seed, %pair_storage, %pair_storage_byte_offset) : (i32, buffer, index)
  %44 = index.constant 4 : index
  %13 = buffer.view %pair_storage[%44] : buffer -> view<1xi32>
  %second = view.load<type_disjoint> %13[0] : view<1xi32> -> i32
  %15 = func.call pure @initialize_scalar(%second) : (i32) -> (i32)
  view.store<type_disjoint> %15, %scalar_view[0] : i32, view<1xi32>
  %19 = buffer.view %pair_storage[%pair_storage_byte_offset] : buffer -> view<1xi32>
  %first = view.load<type_disjoint> %19[0] : view<1xi32> -> i32
  %scalar = view.load<type_disjoint> %scalar_view[0] : view<1xi32> -> i32
  %22 = scalar.addi %first, %scalar : i32
  func.return %22 : i32
}

func.def public @initialized_value(%seed: i32) -> (i32) {
  %25 = scalar.constant 1 : i32
  %45 = scalar.addi %seed, %seed : i32
  %46 = scalar.addi %45, %25 : i32
  func.return %46 : i32
}

func.def @initialize_pair(%seed: i32, %output: buffer, %output_byte_offset: index) {
  %33 = buffer.view %output[%output_byte_offset] : buffer -> view<1xi32>
  view.store<root_in_bounds|type_disjoint> %seed, %33[0] : i32, view<1xi32>
  %34 = scalar.constant 1 : i32
