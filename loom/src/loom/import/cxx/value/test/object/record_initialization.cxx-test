func.def @initialize_scalar(%seed: i32) -> (i32) {
  %47 = scalar.constant 1 : i32
  %output = scalar.shli %seed, %47 : i32
  func.return %output : i32
}

// ====
// A frontend-evaluated record follows the same flattened value partition as a
// runtime record. Control flow inside the constexpr helper leaves no runtime
// switch or unused members behind.
struct Rhs {
  int species_a{-1};
  int species_b{-1};
  int exponent_a{0};
  double branching{1.0};
};
static constexpr Rhs rhs_data(int rate) {
  Rhs value{};
  switch (rate) {
    case 1:
      value.species_a = 1;
      value.exponent_a = 3;
      break;
    case 2:
      value.species_a = 2;
      value.species_b = 1;
      value.exponent_a = 1;
      break;
    default:
      break;
  }
  return value;
}
double apply(double input) {
  constexpr Rhs value = rhs_data(1);
  if constexpr (value.exponent_a == 3) return input * input * input;
  return input * value.species_b;
}

// ----
func.def public @apply(%input: f64) -> (f64) {
  %6 = scalar.mulf %input, %input : f64
  %7 = scalar.mulf %6, %input : f64
  func.return %7 : f64
}

// ====
// Nested records, arrays, enums, and native vectors retain their admitted
// component types when a namespace constant is read into runtime IR.
using Int2 = int __attribute__((ext_vector_type(2)));
enum class Mode : unsigned { first = 3, second = 7 };
struct Leaf { Mode mode; Int2 lanes; };
struct Bundle { Leaf leaves[2]; unsigned bias; };
static constexpr Bundle make_bundle() {
  Bundle value{{{Mode::first, {1, 2}}, {Mode::second, {3, 4}}}, 9};
  value.leaves[1].lanes[0] = 11;
  return value;
}
constexpr Bundle bundle = make_bundle();
Bundle read_bundle() { return bundle; }

// ----
func.def public @read_bundle() -> (i32, vector<2xi32>, i32, vector<2xi32>, i32) {
  %bundle_leaves_0_mode = scalar.constant 3 : i32
  %bundle_leaves_0_lanes = vector.constanti [1, 2] : vector<2xi32>
  %bundle_leaves_1_mode = scalar.constant 7 : i32
  %bundle_leaves_1_lanes = vector.constanti [11, 4] : vector<2xi32>
  %bundle_bias = scalar.constant 9 : i32
  func.return %bundle_leaves_0_mode, %bundle_leaves_0_lanes, %bundle_leaves_1_mode, %bundle_leaves_1_lanes, %bundle_bias : i32, vector<2xi32>, i32, vector<2xi32>, i32
}

// ====
// RUN: pass canonicalize,cse,promote-private-fragments,canonicalize,cse,dce
// Each completed destination element is visible to the next initializer, across
// inner arrays and enclosing record elements. Omitted elements become zero.
struct Command {
  // Two words initialized in source order.
  unsigned words[2];
};
unsigned ordered() {
  Command records[2] = {{{3u, records[0].words[0] + 2u}},
                        {{records[0].words[1] + 2u}}};
  Command value{{11u, value.words[0] + 2u}};
  return records[0].words[0] + 10u * records[0].words[1] +
         100u * records[1].words[0] + 1000u * records[1].words[1] +
         10000u * value.words[0] + 1000000u * value.words[1];
}
// ----
func.def public @ordered() -> (i32) {
  %194 = scalar.constant 13110753 : i32
  func.return %194 : i32
}

// ====
// Same-type prvalues initialize their destinations directly in copy, braced,
// and parenthesized forms. Later clauses read the destination's earlier word.
struct Command {
  // Destination-owned words observed during initialization.
  unsigned words[2];
};
unsigned elided(unsigned seed) {
  Command value = Command{{seed, value.words[0] + 2u}};
  Command wrapped{(Command{{seed + 6u, wrapped.words[0] + 2u}})};
  Command direct(Command{{seed + 14u, direct.words[0] + 2u}});
  return value.words[1] + 100u * wrapped.words[1] + 10000u * direct.words[1];
}
// ----
func.def public @elided(%seed: i32) -> (i32) {
  %2 = index.constant 8 : offset
  %value_storage = buffer.alloca<private> align(4) %2 : buffer
  %125 = index.constant 0 : index
  %9 = buffer.view %value_storage[%125] : buffer -> view<1xi32>
  view.store<type_disjoint> %seed, %9[0] : i32, view<1xi32>
  %21 = view.load<type_disjoint> %9[0] : view<1xi32> -> i32
  %22 = scalar.constant 2 : i32
  %23 = scalar.addi %21, %22 : i32
  %123 = index.constant 4 : index
  %25 = buffer.view %value_storage[%123] : buffer -> view<1xi32>
  view.store<type_disjoint> %23, %25[0] : i32, view<1xi32>
  %wrapped_storage = buffer.alloca<private> align(4) %2 : buffer
  %32 = scalar.constant 6 : i32
  %33 = scalar.addi %seed, %32 : i32
  %35 = buffer.view %wrapped_storage[%125] : buffer -> view<1xi32>
  view.store<type_disjoint> %33, %35[0] : i32, view<1xi32>
  %47 = view.load<type_disjoint> %35[0] : view<1xi32> -> i32
  %49 = scalar.addi %47, %22 : i32
  %51 = buffer.view %wrapped_storage[%123] : buffer -> view<1xi32>
  view.store<type_disjoint> %49, %51[0] : i32, view<1xi32>
  %direct_storage = buffer.alloca<private> align(4) %2 : buffer
  %58 = scalar.constant 14 : i32
  %59 = scalar.addi %seed, %58 : i32
  %61 = buffer.view %direct_storage[%125] : buffer -> view<1xi32>
  view.store<type_disjoint> %59, %61[0] : i32, view<1xi32>
  %73 = view.load<type_disjoint> %61[0] : view<1xi32> -> i32
  %75 = scalar.addi %73, %22 : i32
  %77 = buffer.view %direct_storage[%123] : buffer -> view<1xi32>
  view.store<type_disjoint> %75, %77[0] : i32, view<1xi32>
  %87 = view.load<type_disjoint> %25[0] : view<1xi32> -> i32
  %88 = scalar.constant 100 : i32
  %98 = view.load<type_disjoint> %51[0] : view<1xi32> -> i32
  %99 = scalar.muli %88, %98 : i32
  %100 = scalar.addi %87, %99 : i32
  %101 = scalar.constant 10000 : i32
  %111 = view.load<type_disjoint> %77[0] : view<1xi32> -> i32
  %112 = scalar.muli %101, %111 : i32
  %113 = scalar.addi %100, %112 : i32
  func.return %113 : i32
}

// ====
// A conditional initializer updates the outer scalar only in its selected arm
// and publishes the first destination word before the second clause reads it.
struct Command {
  // Initialized word pair owned by the selected destination.
  unsigned words[2];
};
unsigned selected(unsigned choice) {
  unsigned marker = 3;
  Command value = choice ? Command{{++marker, value.words[0] + 2}}
                         : (marker += 7, Command{{13, value.words[0] + 2}});
  return value.words[0] + 100u * value.words[1] + 10000u * marker;
}
// ----
func.def public @selected(%choice: i32) -> (i32) {
  %3 = index.constant 8 : offset
  %value_storage = buffer.alloca<private> align(4) %3 : buffer
  %7 = scalar.constant 0 : i32
  %8 = scalar.cmpi ne, %choice, %7 : i32
  %marker = scf.if %8 -> (i32) {
    %marker = scalar.constant 4 : i32
    %89 = index.constant 0 : index
    %15 = buffer.view %value_storage[%89] : buffer -> view<1xi32>
    view.store<type_disjoint> %marker, %15[0] : i32, view<1xi32>
    %27 = view.load<type_disjoint> %15[0] : view<1xi32> -> i32
    %28 = scalar.constant 2 : i32
    %29 = scalar.addi %27, %28 : i32
    %87 = index.constant 4 : index
    %31 = buffer.view %value_storage[%87] : buffer -> view<1xi32>
    view.store<type_disjoint> %29, %31[0] : i32, view<1xi32>
    scf.yield %marker : i32
  } else {
    %marker = scalar.constant 10 : i32
    %36 = scalar.constant 13 : i32
    %85 = index.constant 0 : index
    %38 = buffer.view %value_storage[%85] : buffer -> view<1xi32>
    view.store<type_disjoint> %36, %38[0] : i32, view<1xi32>
    %50 = view.load<type_disjoint> %38[0] : view<1xi32> -> i32
    %51 = scalar.constant 2 : i32
    %52 = scalar.addi %50, %51 : i32
    %83 = index.constant 4 : index
    %54 = buffer.view %value_storage[%83] : buffer -> view<1xi32>
    view.store<type_disjoint> %52, %54[0] : i32, view<1xi32>
    scf.yield %marker : i32
  }
  %82 = index.constant 0 : index
  %63 = buffer.view %value_storage[%82] : buffer -> view<1xi32>
  %64 = view.load<type_disjoint> %63[0] : view<1xi32> -> i32
  %65 = scalar.constant 100 : i32
  %81 = index.constant 4 : index
  %74 = buffer.view %value_storage[%81] : buffer -> view<1xi32>
  %75 = view.load<type_disjoint> %74[0] : view<1xi32> -> i32
  %76 = scalar.muli %65, %75 : i32
  %77 = scalar.addi %64, %76 : i32
  %78 = scalar.constant 10000 : i32
  %79 = scalar.muli %78, %marker : i32
  %80 = scalar.addi %77, %79 : i32
  func.return %80 : i32
}

// ====
// RUN: pass inline-callables,canonicalize,cse,promote-private-fragments,canonicalize,cse,dce
// A default member clause initializes the complete array in both synthesized
// and user constructors. An explicit member initializer replaces that default.
struct ZeroArray {
  // Scalar initialized before the array.
  int bias = 7;
  // Empty default list supplies all three zero elements.
  int values[3] = {};
};
struct UserArray {
  // Explicitly initialized constructor input.
  int bias;
  // Default used only when no explicit member initializer is present.
  int values[3] = {1, 2, 3};
  UserArray(int input) : bias(input) {}
  UserArray() : UserArray(5) {}
};
struct OverrideArray {
  // Default used only when no explicit member initializer is present.
  int values[3] = {1, 2, 3};
  OverrideArray(int input) : values{input, 9} {}
};
int default_array_zero(int input) {
  ZeroArray value;
  value.bias = input;
  return value.bias + value.values[2];
}
int default_array_user(int input) {
  UserArray value(input);
  return value.bias + value.values[2];
}
int default_array_delegate() {
  UserArray value;
  return value.bias + value.values[1];
}
int default_array_override(int input) {
  OverrideArray value(input);
  return value.values[0] + value.values[1] + value.values[2];
}

// Nested and partial defaults preserve source order and element types. Const
// qualification does not change the initialized array's component structure.
using Words = unsigned __attribute__((ext_vector_type(2)));
struct Element {
  // Aggregate payload inside an array element.
  unsigned value;
};
struct Defaults {
  // Each array clause advances this completed member once.
  unsigned seed = 3;
  // Nested lists retain their own zero-filled tails.
  unsigned values[2][3] = {{++seed, ++seed}, {++seed}};
  // Observes all side effects from the preceding array.
  unsigned final = seed;
};
struct TypedArrays {
  // Native vector elements remain vectors in the value partition.
  Words vectors[2] = {{1, 2}, {3, 4}};
  // Record elements retain their aggregate member partition.
  Element records[2] = {{5}, {6}};
};
struct ConstantArray {
  // Constructor-provided input for the following member default.
  unsigned seed;
  // Const elements include the omitted zero-initialized tail.
  const unsigned values[3] = {seed, seed + 1};
  ConstantArray(unsigned input) : seed(input) {}
};
Defaults nested_defaults() { return Defaults(); }
TypedArrays typed_defaults() { return TypedArrays(); }
unsigned const_defaults(unsigned input) {
  ConstantArray value(input);
  return value.values[0] + value.values[1] + value.values[2];
}

// Default initialization writes the actual array destination. Later elements
// read its completed prefix, and the enclosing constructor sees the result.
struct Prefix {
  // Constructor-provided input for the following member default.
  unsigned seed;
  // Each element reads the preceding initialized destination.
  unsigned values[3] = {seed, values[0] + 2, values[1] + 3};
  // Observes the completed array from the next member initializer.
  unsigned last = values[2];
  Prefix(unsigned input) : seed(input) {}
};
unsigned default_prefix(unsigned input) {
  Prefix value(input);
  return value.last;
}
struct Observed {
  // Construction and the final read use a volatile destination.
  unsigned values[2] = {7, values[0] + 2};
  Observed() = default;
};
unsigned volatile_defaults() {
  volatile Observed value;
  return value.values[1];
}
struct Label {
  // String initialization includes the terminating zero.
  char text[4] = "abc";
};
unsigned string_default() { Label value; return value.text[1]; }
// ----
func.def public @default_array_zero(%input: i32) -> (i32) {
  func.return %input : i32
}

func.def public @default_array_user(%input: i32) -> (i32) {
  %value_values_2 = scalar.constant 3 : i32
  %53 = scalar.addi %input, %value_values_2 : i32
  func.return %53 : i32
}

func.def public @default_array_delegate() -> (i32) {
  %311 = scalar.constant 7 : i32
  func.return %311 : i32
}

func.def public @default_array_override(%input: i32) -> (i32) {
  %value_values_1 = scalar.constant 9 : i32
  %82 = scalar.addi %input, %value_values_1 : i32
  func.return %82 : i32
}

func.def public @nested_defaults() -> (i32, i32, i32, i32, i32, i32, i32, i32) {
  %seed$314 = scalar.constant 4 : i32
  %seed$313 = scalar.constant 5 : i32
  %zero$i32 = scalar.constant 0 : i32
  %seed$312 = scalar.constant 6 : i32
  func.return %seed$312, %seed$314, %seed$313, %zero$i32, %seed$312, %zero$i32, %zero$i32, %seed$312 : i32, i32, i32, i32, i32, i32, i32, i32
}

func.def public @typed_defaults() -> (vector<2xi32>, vector<2xi32>, i32, i32) {
  %119 = vector.constanti [1, 2] : vector<2xi32>
  %120 = vector.constanti [3, 4] : vector<2xi32>
  %121 = scalar.constant 5 : i32
  %122 = scalar.constant 6 : i32
  func.return %119, %120, %121, %122 : vector<2xi32>, vector<2xi32>, i32, i32
}

func.def public @const_defaults(%input: i32) -> (i32) {
  %224 = scalar.constant 1 : i32
  %315 = scalar.addi %input, %input : i32
  %316 = scalar.addi %315, %224 : i32
  func.return %316 : i32
}

func.def public @default_prefix(%input: i32) -> (i32) {
  %327 = scalar.constant 5 : i32
  %328 = scalar.addi %input, %327 : i32
  func.return %328 : i32
}

func.def public @volatile_defaults() -> (i32) {
  %146 = index.constant 8 : offset
  %value_storage = buffer.alloca<private> align(4) %146 : buffer
  %152 = scalar.constant 7 : i32
  %332 = index.constant 0 : index
  %154 = buffer.view %value_storage[%332] : buffer -> view<1xi32>
  view.store<volatile|type_disjoint> %152, %154[0] : i32, view<1xi32>
  %166 = view.load<type_disjoint> %154[0] : view<1xi32> -> i32
  %167 = scalar.constant 2 : i32
  %168 = scalar.addi %166, %167 : i32
  %330 = index.constant 4 : index
  %170 = buffer.view %value_storage[%330] : buffer -> view<1xi32>
  view.store<volatile|type_disjoint> %168, %170[0] : i32, view<1xi32>
  %180 = view.load<volatile|type_disjoint> %170[0] : view<1xi32> -> i32
  func.return %180 : i32
}

func.def public @string_default() -> (i32) {
  %182 = index.constant 4 : offset
  %value_storage = buffer.alloca<private> align(1) %182 : buffer
  %334 = index.constant 0 : index
  %188 = buffer.constant align(1) utf8("abc\u0000") : buffer
  buffer.copy %188[%334], %value_storage[%334], %182
  %333 = index.constant 1 : index
  %199 = buffer.view %value_storage[%333] : buffer -> view<1xi8>
  %200 = view.load %199[0] : view<1xi8> -> i8
  %201 = scalar.extsi %200 : i8 to i32
  func.return %201 : i32
}

// ====
// INPUT: cxx data-model=lp64
// String initialization creates array elements, not a pointer to the literal.
// Embedded zeros, encoded code units, and zero-filled tails retain their types.
struct Text {
  // Embedded zero does not truncate the following character.
  char narrow[4] = "A\0B";
  // Signed and unsigned byte arrays preserve the same source bit pattern.
  signed char signed_bytes[3] = "\xff";
  // The array's signedness affects uses, not its initialized bits.
  unsigned char unsigned_bytes[3] = "\xff";
  // Const qualification preserves the character-array shape.
  const char fixed[3] = "pq";
  // UTF-8 stores both bytes of the multibyte character, then pads the tail.
  char8_t utf8[4] = u8"\u00e9";
  // UTF-16 stores the surrogate pair as two separate code units.
  char16_t utf16[4] = u"\U0001f642";
  // UTF-32 stores one code unit for the same character.
  char32_t utf32[3] = U"\U0001f642";
  // The source data model determines the width of wide characters.
  wchar_t wide[3] = L"\u03bb";
};
Text string_value_defaults() { return Text(); }
struct Aggregate {
  // Explicit aggregate clauses use the same complete-array initialization.
  char text[4];
};
Aggregate aggregate_string() { return {"xy"}; }
// ----
func.def public @string_value_defaults() -> (i8, i8, i8, i8, i8, i8, i8, i8, i8, i8, i8, i8, i8, i8, i8, i8, i8, i16, i16, i16, i16, i32, i32, i32, i32, i32, i32) {
  %54 = scalar.constant 65 : i8
  %55 = scalar.constant 0 : i8
  %56 = scalar.constant 66 : i8
  %58 = scalar.constant -1 : i8
  %64 = scalar.constant 112 : i8
  %65 = scalar.constant 113 : i8
  %67 = scalar.constant -61 : i8
  %68 = scalar.constant -87 : i8
  %71 = scalar.constant -10179 : i16
  %72 = scalar.constant -8638 : i16
  %73 = scalar.constant 0 : i16
  %75 = scalar.constant 128578 : i32
  %76 = scalar.constant 0 : i32
  %78 = scalar.constant 955 : i32
  func.return %54, %55, %56, %55, %58, %55, %55, %58, %55, %55, %64, %65, %55, %67, %68, %55, %55, %71, %72, %73, %73, %75, %76, %76, %78, %76, %76 : i8, i8, i8, i8, i8, i8, i8, i8, i8, i8, i8, i8, i8, i8, i8, i8, i8, i16, i16, i16, i16, i32, i32, i32, i32, i32, i32
}

func.def public @aggregate_string() -> (i8, i8, i8, i8) {
  %85 = scalar.constant 120 : i8
  %86 = scalar.constant 121 : i8
  %87 = scalar.constant 0 : i8
  func.return %85, %86, %87, %87 : i8, i8, i8, i8
}

// ====
// INPUT: cxx data-model=llp64
// A wide string follows the 16-bit wchar_t source model without truncating
// a supplementary character into one element.
struct Text {
  // Two code units followed by the terminator and one padded element.
  wchar_t text[4] = L"\U0001f642";
};
Text wide_string_value() { return Text(); }
// ----
func.def public @wide_string_value() -> (i16, i16, i16, i16) {
  %8 = scalar.constant -10179 : i16
  %9 = scalar.constant -8638 : i16
  %10 = scalar.constant 0 : i16
  func.return %8, %9, %10, %10 : i16, i16, i16, i16
}
