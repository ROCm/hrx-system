  %14 = buffer.view %value_storage[%152] : buffer -> view<1xi32>
  view.store<volatile> %zero$i32, %14[0] : i32, view<1xi32>
  %later$21 = view.load<volatile> %14[0] : view<1xi32> -> i32
  view.store<volatile> %later$21, %9[0] : i32, view<1xi32>
  %copy = view.load<volatile> %9[0] : view<1xi32> -> i32
  %later$33 = view.load<volatile> %14[0] : view<1xi32> -> i32
  %34 = scalar.addi %copy, %later$33 : i32
  func.return %34 : i32
}

