// RUN: pass canonicalize,cse,dce
// Aggregate defaults see the completed prefix and explicit clauses bypass the
// corresponding default while later defaults retain the same current object.
struct Descriptor {
  unsigned elements;
  unsigned words = elements / 8u;
  unsigned pairs = this->words * 2u;
};
struct Batch {
  unsigned elements;
  Descriptor first{elements};
  Descriptor second{this->elements * 2u};
  unsigned total = first.words + second.words;
};
Batch describe(unsigned elements) { return Batch{elements}; }
Descriptor override_words(unsigned elements, unsigned words) {
  return Descriptor{elements, words};
}
// ----
func.def public @describe(%elements: i32) -> (i32, i32, i32, i32, i32, i32, i32, i32) {
  %35 = scalar.constant 3 : i32
  %words$36 = scalar.shrui %elements, %35 : i32
  %33 = scalar.constant 1 : i32
  %34 = scalar.shli %words$36, %33 : i32
  %32 = scalar.shli %elements, %33 : i32
  %words$30 = scalar.shrui %32, %35 : i32
  %28 = scalar.shli %words$30, %33 : i32
  %19 = scalar.addi %words$36, %words$30 : i32
  func.return %elements, %elements, %words$36, %34, %32, %words$30, %28, %19 : i32, i32, i32, i32, i32, i32, i32, i32
}

func.def public @override_words(%elements: i32, %words: i32) -> (i32, i32, i32) {
  %37 = scalar.constant 1 : i32
  %38 = scalar.shli %words, %37 : i32
  func.return %elements, %words, %38 : i32, i32, i32
}

// ====
// Mutations in default clauses update the current object across structured
// expressions. Parenthesized value initialization uses the same plan after its
// zero-initialization phase.
struct Sequence {
  unsigned count;
  unsigned next = ++count;
  unsigned selected = (count & 1u) ? (count += 3u) : (count *= 2u);
  unsigned final = count;
};
Sequence sequence(unsigned count) { return Sequence{count}; }
unsigned seed_value() { return 3u; }
struct Synthesized {
  unsigned count = seed_value();
  unsigned result = (count & 1u) ? ++count : (count += 2u);
  unsigned final = count;
};
Synthesized synthesized() { return Synthesized(); }
struct InnerSequence { unsigned value = 2u; };
struct NestedSequence {
  InnerSequence inner;
  unsigned result = ++this->inner.value;
  unsigned final = inner.value;
};
NestedSequence nested_sequence() { return NestedSequence(); }
struct CopyIsolation {
  InnerSequence original;
  InnerSequence copy = original;
  unsigned changed = ++copy.value;
  unsigned preserved = original.value;
};
CopyIsolation copy_isolation() { return CopyIsolation(); }
unsigned stored_synthesized_array() {
  volatile Synthesized values[2]{};
  return values[0].final + values[1].final;
}
unsigned stored_nested_sequence() {
  volatile NestedSequence value = NestedSequence();
  return value.inner.value + value.result + value.final;
}
unsigned stored_copy_isolation() {
  volatile CopyIsolation value = CopyIsolation();
  return value.original.value + value.copy.value + value.changed + value.preserved;
}
