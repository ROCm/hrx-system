// RUN: roundtrip
// INPUT: cxx root=k
constexpr int first(const int (&a)[2]) { return a[0]; }
constexpr int arr[2] = {1, 2};
static_assert(first(arr) == 1);
void k(int* out) { out[0] = first(arr); }

// ----
func.def public @k(%out: buffer, %out_byte_offset: offset) {
  %2 = scalar.constant 1 : i32
  %3 = scalar.constant 0 : i32
  %4 = scalar.extsi %3 : i32 to i64
  %5 = scalar.constant 4 : i64
  %6 = scalar.muli %4, %5 : i64
  %7 = index.cast %out_byte_offset : offset to i64
  %8 = scalar.addi %7, %6 : i64
  %9 = scalar.assume %8 [range(%8, 0, 9223372036854775807)] : i64
  %10 = index.cast %9 : i64 to offset
  %11 = buffer.view %out[%10] : buffer -> view<1xi32>
  view.store<root_in_bounds> %2, %11[0] : i32, view<1xi32>
  func.return
}

// ====
// INPUT: cxx root=reference_member_result
constexpr unsigned weights[3] = {2, 3, 5};

struct Policy {
  unsigned width = 7;
  const unsigned& alias = width;
  const unsigned (&table)[3] = weights;
};

constexpr Policy policy = Policy();

constexpr unsigned evaluate() {
  return policy.alias + policy.table[2] +
         (&policy.alias == &policy.width ? 100u : 0u) +
         (&policy.table == &weights ? 1000u : 0u);
}

constexpr unsigned result = evaluate();

unsigned reference_member_result() { return result; }

// ----
func.def public @reference_member_result() -> (i32) {
  %result = scalar.constant 1112 : i32
  func.return %result : i32
}

// ====
// INPUT: cxx root=entry
constexpr const int& identity(const int& value) { return value; }
static_assert(identity(3) == 3);
void entry(int* output) { output[0] = identity(3); }

// ----
func.def public @entry(%output: buffer, %output_byte_offset: offset) {
  %2 = scalar.constant 3 : i32
  %3 = scalar.constant 0 : i32
  %4 = scalar.extsi %3 : i32 to i64
  %5 = scalar.constant 4 : i64
  %6 = scalar.muli %4, %5 : i64
  %7 = index.cast %output_byte_offset : offset to i64
  %8 = scalar.addi %7, %6 : i64
  %9 = scalar.assume %8 [range(%8, 0, 9223372036854775807)] : i64
  %10 = index.cast %9 : i64 to offset
  %11 = buffer.view %output[%10] : buffer -> view<1xi32>
  view.store<root_in_bounds> %2, %11[0] : i32, view<1xi32>
  func.return
}

// ====
// Anonymous paths keep the original storage for scalar references and record
// assignment, including when the anonymous member has a nonzero byte offset.
// INPUT: cxx root=anonymous_member_result
struct Representation { unsigned count; unsigned stride; };
struct Descriptor {
  unsigned prefix;
  struct {
    Representation representation;
    unsigned bias;
  };
  constexpr Descriptor() : prefix(91), representation{0, 0}, bias(0) {}
  constexpr unsigned& offset() { return bias; }
  constexpr void reset(unsigned value) {
    representation = Representation{value, value + 4};
    bias = 5;
  }
};
constexpr unsigned evaluate() {
  Descriptor original;
  unsigned& bias = original.offset();
  original.reset(3);
  bias += 2;
  Descriptor copy = original;
  copy.reset(9);
  return original.representation.count * original.representation.stride + original.bias + (original.prefix == 91 && &bias == &original.bias ? 100u : 0u);
}
constexpr unsigned result = evaluate();
static_assert(result == 128);
unsigned anonymous_member_result() { return result; }

// ----
func.def public @anonymous_member_result() -> (i32) {
  %result = scalar.constant 128 : i32
  func.return %result : i32
}
