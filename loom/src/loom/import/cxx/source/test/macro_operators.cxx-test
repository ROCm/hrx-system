// ====
// RUN: with-locations pass canonicalize,cse,dce
#include "locations.h"
int pasted() { return header_pasted() + HEADER_JOIN(1, 2); }

// ----
func.def public @pasted() -> (i32) {
  %1 = func.call pure @header_pasted() : () -> (i32) loc("loom/src/loom/import/cxx/source/test/macro_operators.cxx-test":2:23 to 2:38)
  %2 = scalar.constant 12 : i32 loc("loom/src/loom/import/cxx/source/test/macro_operators.cxx-test":2:41 to 2:52)
  %3 = scalar.addi %1, %2 : i32 loc("loom/src/loom/import/cxx/source/test/macro_operators.cxx-test":2:23 to 2:52)
  func.return %3 : i32 loc("loom/src/loom/import/cxx/source/test/macro_operators.cxx-test":2:16 to 2:59)
} loc("loom/src/loom/import/cxx/source/test/macro_operators.cxx-test":2:1 to 2:61)

func.def @header_pasted() -> (i32) {
  %5 = scalar.constant 42 : i32 loc("loom/src/loom/import/cxx/source/test/locations.h":14:37 to 14:48)
  func.return %5 : i32 loc("loom/src/loom/import/cxx/source/test/locations.h":14:30 to 14:55)
} loc("loom/src/loom/import/cxx/source/test/locations.h":14:1 to 14:57)

// ====
// RUN: verify
#define QUOTE(value) #value
static_assert(sizeof(QUOTE()) == 1);
static_assert(sizeof(QUOTE(ab)) == 3);
static_assert(sizeof(QUOTE(a   b)) == 4);
static_assert(sizeof(QUOTE(__FILE__)) == 9);
static_assert(sizeof(QUOTE("a")) == 4);

// ====
// RUN: with-locations pass canonicalize,cse,dce
#define QUOTE(value) #value
const char* quoted() {
  return QUOTE(ab);
}

