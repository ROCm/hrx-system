// RUN: with-locations pass canonicalize,cse,dce
#define JOIN(left, right) left##right
#define PREFIX(value) 4##value
#define SUFFIX(value) value##2
#define FORWARD(value) value
int pasted() { return JOIN(1, 2); }
int prefix() { return PREFIX(2); }
int suffix() { return SUFFIX(4); }
int nested() { return FORWARD(JOIN(3, 4)); }
int empty_left() { return JOIN(, 5); }

// ----
func.def public @pasted() -> (i32) {
  %1 = scalar.constant 12 : i32 loc("loom/src/loom/import/cxx/source/test/macro_operators.cxx-test":5:23 to 5:27)
  func.return %1 : i32 loc("loom/src/loom/import/cxx/source/test/macro_operators.cxx-test":5:16 to 5:34)
} loc("loom/src/loom/import/cxx/source/test/macro_operators.cxx-test":5:1 to 5:36)

