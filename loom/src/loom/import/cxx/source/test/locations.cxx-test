// ====
// RUN: pass unroll-scf-for
void unresolved_schedule(unsigned factor) {
  // ERROR@+1: STRUCTURE/014 {attr_name="unroll_factor", expected_constraint="compile-time exact i64 value"}
  [[loom::unroll(factor)]] for (unsigned index = 0; index < 8u; ++index) {}
}
