// RUN: roundtrip
// INPUT: cxx data-model=lp64
// A dependent prefix must not bind a later component to an unrelated global.
struct Deep {
  using type = float;
};
struct Item {
  struct Inner {
    struct Deep {
      using type = long long;
      static constexpr int value = 17;
    };
  };
};
template <class T>
using Result = typename T::Inner::Deep::type;
static_assert(__is_same(Result<Item>, long long));

Result<Item> identity(Result<Item> value) { return value; }
unsigned width() { return sizeof(Result<Item>); }

template <class T>
constexpr int nested_value() {
  return T::Inner::Deep::value;
}
int value() { return nested_value<Item>(); }

// ----
func.def public @identity(%value: i64) -> (i64) {
  func.return %value : i64
}

func.def public @width() -> (i32) {
  %3 = scalar.constant 8 : i64
  %4 = scalar.trunci %3 : i64 to i32
  func.return %4 : i32
}

func.def public @value() -> (i32) {
  %6 = func.call pure @nested_value___Item() : () -> (i32)
  func.return %6 : i32
}

func.def @nested_value___Item() -> (i32) {
  %8 = scalar.constant 17 : i32
  func.return %8 : i32
}

// ====
// RUN: roundtrip
// INPUT: cxx data-model=lp64
// Member alias templates discovered during substitution retain their scope.
struct Deep {
  using type = float;
};
struct Item {
  struct Inner {
    struct Deep {
      using type = unsigned;
    };
  };
};
struct Provider {
  template <class T>
  using Rebind = T;
};
template <class T, class U>
using Result = typename T::template Rebind<U>::Inner::Deep::type;
static_assert(__is_same(Result<Provider, Item>, unsigned));
Result<Provider, Item> entry(Result<Provider, Item> value) {
  return value + sizeof(Result<Provider, Item>);
}

// ----
func.def public @entry(%value: i32) -> (i32) {
  %2 = scalar.extui %value : i32 to i64
  %3 = scalar.constant 4 : i64
  %4 = scalar.addi %2, %3 : i64
  %5 = scalar.trunci %4 : i64 to i32
  func.return %5 : i32
}

// ====
// RUN: roundtrip
// INPUT: cxx data-model=lp64
// An alias can remain dependent while an enclosing template is instantiated.
struct Item {
  using type = long long;
};
template <class T>
struct Holder {
  using Alias = T;
  using Result = typename Alias::type;
};
template <class T>
using Identity = T;
template <class T>
using Result = typename Holder<Identity<T>>::Result;
static_assert(__is_same(Result<Item>, long long));
Result<Item> entry(Result<Item> value) { return value + 1; }

// ----
func.def public @entry(%value: i64) -> (i64) {
  %2 = scalar.constant 1 : i32
  %3 = scalar.extsi %2 : i32 to i64
  %4 = scalar.addi %value, %3 : i64
  func.return %4 : i64
}

// ====
// A template-template prefix stays dependent even with concrete arguments.
template <bool Value> struct Boolean { static constexpr bool value = Value; };
template <class... Ts> struct All { static constexpr bool value = (Ts::value && ...); };
template <class... Ts>
struct Tuple {
  template <template <class...> class A = All, bool = A<Boolean<true>>::value>
  constexpr Tuple(const Ts&...) : count(sizeof...(Ts)) {}
  int count;
};
static_assert(Tuple<int>(1).count == 1);
int entry(int value) {
  constexpr Tuple<int, float> tuple(1, 2.0f);
  return value + tuple.count;
}
// ----
func.def public @entry(%value: i32) -> (i32) {
  %2 = index.constant 4 : offset
  %tuple_storage = buffer.alloca<private> align(4) %2 : buffer
  %tuple_storage_byte_offset = index.constant 0 : offset
  %tuple_view = buffer.view %tuple_storage[%tuple_storage_byte_offset] : buffer -> view<4xi8>
  %6 = scalar.constant 1 : i32
  %7 = index.constant 4 : offset
  %8 = buffer.alloca<private> align(4) %7 : buffer
  %9 = index.constant 0 : offset
  %10 = buffer.view %8[%9] : buffer -> view<1xi32>
  %11 = index.assume %9 [range(%9, 0, 0)] : offset
  %12 = buffer.view %8[%11] : buffer -> view<1xi32>
  view.store %6, %12[0] : i32, view<1xi32>
  %13 = index.assume %9 [range(%9, 0, 0)] : offset
  %14 = buffer.view %8[%13] : buffer -> view<1xi32>
  %15 = scalar.constant 2.0 : f32
  %16 = index.constant 4 : offset
  %17 = buffer.alloca<private> align(4) %16 : buffer
  %18 = index.constant 0 : offset
  %19 = buffer.view %17[%18] : buffer -> view<1xf32>
  %20 = index.assume %18 [range(%18, 0, 0)] : offset
  %21 = buffer.view %17[%20] : buffer -> view<1xf32>
  view.store %15, %21[0] : f32, view<1xf32>
  %22 = index.assume %18 [range(%18, 0, 0)] : offset
  %23 = buffer.view %17[%22] : buffer -> view<1xf32>
  func.call @Tuple__Tuple___All_1_storage(%tuple_storage, %tuple_storage_byte_offset) : (buffer, offset)
  %24 = index.constant 0 : offset
  %25 = index.add %tuple_storage_byte_offset, %24 : offset
  %26 = index.assume %25 [range(%25, 0, 0)] : offset
  %27 = buffer.view %tuple_storage[%26] : buffer -> view<1xi32>
  %count = view.load %27[0] : view<1xi32> -> i32
  %29 = scalar.addi %value, %count : i32
  func.return %29 : i32
}

func.def inline @Tuple__Tuple___All_1_storage(%this: buffer, %this_byte_offset: offset) {
  %32 = index.constant 0 : offset
  %33 = index.add %this_byte_offset, %32 : offset
  %34 = scalar.constant 2 : i64
  %35 = scalar.trunci %34 : i64 to i32
  %36 = buffer.view %this[%33] : buffer -> view<1xi32>
  view.store<root_in_bounds> %35, %36[0] : i32, view<1xi32>
  func.return
}
