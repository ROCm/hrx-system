// RUN: roundtrip
// INPUT: cxx data-model=lp64
// Pointer subscripts preserve source integer widths.
int read(const int* input, long index, unsigned large,
         unsigned long long wide) {
  return input[index] + input[large] + input[wide];
}
// ----
func.def public @read(%input: buffer, %input_byte_offset: index, %index: i64, %large: i32, %wide: i64) -> (i32) {
  %6 = index.cast %index : i64 to index
  %7 = index.constant 4 : index
  %8 = index.mul %6, %7 : index
  %9 = index.add %input_byte_offset, %8 : index
  %10 = buffer.view %input[%9] : buffer -> view<1xi32>
  %11 = view.load<root_in_bounds|type_disjoint> %10[0] : view<1xi32> -> i32
  %12 = scalar.extui %large : i32 to i64
  %13 = index.cast %12 : i64 to index
  %14 = index.constant 4 : index
  %15 = index.mul %13, %14 : index
  %16 = index.add %input_byte_offset, %15 : index
  %17 = buffer.view %input[%16] : buffer -> view<1xi32>
  %18 = view.load<root_in_bounds|type_disjoint> %17[0] : view<1xi32> -> i32
  %19 = scalar.addi %11, %18 : i32
  %20 = index.cast %wide : i64 to index
  %21 = index.constant 4 : index
  %22 = index.mul %20, %21 : index
  %23 = index.add %input_byte_offset, %22 : index
  %24 = buffer.view %input[%23] : buffer -> view<1xi32>
  %25 = view.load<root_in_bounds|type_disjoint> %24[0] : view<1xi32> -> i32
  %26 = scalar.addi %19, %25 : i32
  func.return %26 : i32
}

