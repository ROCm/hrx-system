func.def public @read(%input: buffer, %input_byte_offset: index, %index: i32, %large: i32, %wide: i64) -> (i32) {
  %6 = index.cast %index : i32 to index
  %7 = index.constant 4 : index
  %8 = index.mul %6, %7 : index
  %9 = index.add %input_byte_offset, %8 : index
  %10 = buffer.view %input[%9] : buffer -> view<1xi32>
  %11 = view.load<root_in_bounds|type_disjoint> %10[0] : view<1xi32> -> i32
  %12 = scalar.extui %large : i32 to i64
  %13 = index.cast %12 : i64 to index
  %14 = index.constant 4 : index
  %15 = index.mul %13, %14 : index
