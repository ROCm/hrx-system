// RUN: roundtrip
// INPUT: cxx data-model=lp64
// Pointer subscripts preserve source integer widths.
int read(const int* input, long index, unsigned large,
         unsigned long long wide) {
  return input[index] + input[large] + input[wide];
}
// ----
func.def public @read(%input: buffer, %input_byte_offset: offset, %index: i64, %large: i32, %wide: i64) -> (i32) {
  %6 = scalar.constant 4 : i64
  %7 = scalar.muli %index, %6 : i64
  %8 = index.cast %input_byte_offset : offset to i64
  %9 = scalar.addi %8, %7 : i64
  %10 = scalar.assume %9 [range(%9, 0, 9223372036854775807)] : i64
  %11 = index.cast %10 : i64 to offset
  %12 = buffer.view %input[%11] : buffer -> view<1xi32>
  %13 = view.load %12[0] : view<1xi32> -> i32
  %14 = scalar.extui %large : i32 to i64
  %15 = scalar.constant 4 : i64
  %16 = scalar.muli %14, %15 : i64
  %17 = index.cast %input_byte_offset : offset to i64
  %18 = scalar.addi %17, %16 : i64
  %19 = scalar.assume %18 [range(%18, 0, 9223372036854775807)] : i64
  %20 = index.cast %19 : i64 to offset
  %21 = buffer.view %input[%20] : buffer -> view<1xi32>
  %22 = view.load %21[0] : view<1xi32> -> i32
  %23 = scalar.addi %13, %22 : i32
  %24 = scalar.constant 4 : i64
  %25 = scalar.muli %wide, %24 : i64
  %26 = index.cast %input_byte_offset : offset to i64
  %27 = scalar.addi %26, %25 : i64
  %28 = scalar.assume %27 [range(%27, 0, 9223372036854775807)] : i64
  %29 = index.cast %28 : i64 to offset
  %30 = buffer.view %input[%29] : buffer -> view<1xi32>
  %31 = view.load %30[0] : view<1xi32> -> i32
  %32 = scalar.addi %23, %31 : i32
  func.return %32 : i32
}

// ====
// RUN: roundtrip
// INPUT: cxx data-model=llp64
// Pointer subscripts preserve source integer widths.
int read(const int* input, long index, unsigned large,
         unsigned long long wide) {
  return input[index] + input[large] + input[wide];
}
// ----
func.def public @read(%input: buffer, %input_byte_offset: offset, %index: i32, %large: i32, %wide: i64) -> (i32) {
  %6 = scalar.extsi %index : i32 to i64
  %7 = scalar.constant 4 : i64
  %8 = scalar.muli %6, %7 : i64
  %9 = index.cast %input_byte_offset : offset to i64
  %10 = scalar.addi %9, %8 : i64
  %11 = scalar.assume %10 [range(%10, 0, 9223372036854775807)] : i64
  %12 = index.cast %11 : i64 to offset
  %13 = buffer.view %input[%12] : buffer -> view<1xi32>
  %14 = view.load %13[0] : view<1xi32> -> i32
  %15 = scalar.extui %large : i32 to i64
  %16 = scalar.constant 4 : i64
  %17 = scalar.muli %15, %16 : i64
  %18 = index.cast %input_byte_offset : offset to i64
  %19 = scalar.addi %18, %17 : i64
  %20 = scalar.assume %19 [range(%19, 0, 9223372036854775807)] : i64
  %21 = index.cast %20 : i64 to offset
  %22 = buffer.view %input[%21] : buffer -> view<1xi32>
  %23 = view.load %22[0] : view<1xi32> -> i32
  %24 = scalar.addi %14, %23 : i32
  %25 = scalar.constant 4 : i64
  %26 = scalar.muli %wide, %25 : i64
  %27 = index.cast %input_byte_offset : offset to i64
  %28 = scalar.addi %27, %26 : i64
  %29 = scalar.assume %28 [range(%28, 0, 9223372036854775807)] : i64
  %30 = index.cast %29 : i64 to offset
  %31 = buffer.view %input[%30] : buffer -> view<1xi32>
  %32 = view.load %31[0] : view<1xi32> -> i32
  %33 = scalar.addi %24, %32 : i32
  func.return %33 : i32
}

// ====
// RUN: roundtrip
// INPUT: cxx data-model=ilp32
// Pointer subscripts preserve source integer widths.
int read(const int* input, long index, unsigned large,
         unsigned long long wide) {
  return input[index] + input[large] + input[wide];
}
// ----
func.def public @read(%input: buffer, %input_byte_offset: offset, %index: i32, %large: i32, %wide: i64) -> (i32) {
  %6 = scalar.extsi %index : i32 to i64
  %7 = scalar.constant 4 : i64
  %8 = scalar.muli %6, %7 : i64
  %9 = index.cast %input_byte_offset : offset to i64
  %10 = scalar.addi %9, %8 : i64
  %11 = scalar.assume %10 [range(%10, 0, 4294967295)] : i64
  %12 = index.cast %11 : i64 to offset
  %13 = buffer.view %input[%12] : buffer -> view<1xi32>
  %14 = view.load %13[0] : view<1xi32> -> i32
  %15 = scalar.extui %large : i32 to i64
  %16 = scalar.constant 4 : i64
  %17 = scalar.muli %15, %16 : i64
  %18 = index.cast %input_byte_offset : offset to i64
  %19 = scalar.addi %18, %17 : i64
  %20 = scalar.assume %19 [range(%19, 0, 4294967295)] : i64
  %21 = index.cast %20 : i64 to offset
  %22 = buffer.view %input[%21] : buffer -> view<1xi32>
  %23 = view.load %22[0] : view<1xi32> -> i32
  %24 = scalar.addi %14, %23 : i32
  %25 = scalar.constant 4 : i64
  %26 = scalar.muli %wide, %25 : i64
  %27 = index.cast %input_byte_offset : offset to i64
  %28 = scalar.addi %27, %26 : i64
  %29 = scalar.assume %28 [range(%28, 0, 4294967295)] : i64
  %30 = index.cast %29 : i64 to offset
  %31 = buffer.view %input[%30] : buffer -> view<1xi32>
  %32 = view.load %31[0] : view<1xi32> -> i32
  %33 = scalar.addi %24, %32 : i32
  func.return %33 : i32
}

// ====
// RUN: roundtrip
// INPUT: cxx data-model=lp64
// Source data model controls long width.
long identity(long x) { return x; }
// ----
func.def public @identity(%x: i64) -> (i64) {
  func.return %x : i64
}

// ====
// RUN: roundtrip
// INPUT: cxx data-model=llp64
// Source data model controls long width.
long identity(long x) { return x; }
// ----
func.def public @identity(%x: i32) -> (i32) {
  func.return %x : i32
}

// ====
// RUN: verify
// INPUT: cxx data-model=ilp32
static_assert(sizeof(void*) == 4);
static_assert(sizeof(long) == 4);
static_assert(sizeof(long long) == 8);
static_assert(sizeof(long long) == __SIZEOF_LONG_LONG__);
static_assert((1LL << 40) == 1099511627776LL);
