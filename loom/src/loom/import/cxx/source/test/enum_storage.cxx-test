// RUN: pass canonicalize,cse,dce
// Enum storage uses its underlying width through pointer steps and arithmetic.
enum class Value : unsigned char { zero };
template <class T>
static T add(T value, T delta) {
  return static_cast<T>(static_cast<unsigned long long>(value) +
                        static_cast<unsigned long long>(delta));
}
void update(const Value* input, Value* output, unsigned lane, Value delta) {
  Value* cursor = output + lane + 1;
  cursor[-1] = add(input[lane], delta);
}

// ----
func.def public @update(%input: buffer, %input_byte_offset: index, %output: buffer, %output_byte_offset: index, %lane: i32, %delta: i8) {
  %6 = scalar.extui %lane : i32 to i64
  %7 = index.cast %6 : i64 to index
  %10 = index.add %output_byte_offset, %7 : index
  %40 = index.constant 1 : index
  %cursor_byte_offset = index.add %10, %40 : index
  %20 = index.add %input_byte_offset, %7 : index
  %21 = buffer.view %input[%20] : buffer -> view<1xi8>
  %22 = view.load<root_in_bounds|type_disjoint> %21[0] : view<1xi8> -> i8
  %23 = func.call pure @add___Value(%22, %delta) : (i8, i8) -> (i8)
  %39 = index.constant -1 : index
  %30 = index.add %cursor_byte_offset, %39 : index
  %31 = buffer.view %output[%30] : buffer -> view<1xi8>
  view.store<root_in_bounds|type_disjoint> %23, %31[0] : i8, view<1xi8>
  func.return
}

func.def @add___Value(%value: i8, %delta: i8) -> (i8) {
  %35 = scalar.extui %value : i8 to i64
  %36 = scalar.extui %delta : i8 to i64
  %37 = scalar.addi %35, %36 : i64
  %38 = scalar.trunci %37 : i64 to i8
  func.return %38 : i8
}

