load("//build_tools/embed_data:build_defs.bzl", "iree_c_embed_data")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test", "loom_config_compatible_with")
load("//loom/src/loom/import/cxx:build_defs.bzl", "CXX_COMPILER_OPTIONS")

package(
    default_visibility = ["//loom/src/loom/import/cxx:__subpackages__"],
    features = ["layering_check"],
    licenses = ["notice"],
)

_EMBED_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/import:cxx",
    "//loom/config/import/cxx:embed_includes_enabled",
])

iree_c_embed_data(
    name = "embedded_standard_headers",
    srcs = [
        "//loom/src/loom/import/cxx:include/initializer_list",
        "//loom/src/loom/import/cxx:include/stdfloat",
    ],
    c_file_output = "embedded_standard_headers.c",
    flatten = True,
    h_file_output = "embedded_standard_headers.h",
    identifier = "loom_cxx_embedded_standard_headers",
    target_compatible_with = _EMBED_COMPATIBLE_WITH,
)

iree_c_embed_data(
    name = "embedded_loomcxx_headers",
    srcs = [
        "//loom/src/loom/import/cxx:include/loomcxx/atomic.h",
        "//loom/src/loom/import/cxx:include/loomcxx/check.h",
        "//loom/src/loom/import/cxx:include/loomcxx/encoding.h",
        "//loom/src/loom/import/cxx:include/loomcxx/encoding_type.h",
        "//loom/src/loom/import/cxx:include/loomcxx/kernel.h",
        "//loom/src/loom/import/cxx:include/loomcxx/low.h",
        "//loom/src/loom/import/cxx:include/loomcxx/math.h",
        "//loom/src/loom/import/cxx:include/loomcxx/numeric.h",
        "//loom/src/loom/import/cxx:include/loomcxx/scalar.h",
        "//loom/src/loom/import/cxx:include/loomcxx/vector.h",
        "//loom/src/loom/import/cxx:include/loomcxx/view.h",
    ],
    c_file_output = "embedded_loomcxx_headers.c",
    flatten = True,
    h_file_output = "embedded_loomcxx_headers.h",
    identifier = "loom_cxx_embedded_loomcxx_headers",
    target_compatible_with = _EMBED_COMPATIBLE_WITH,
)

iree_c_embed_data(
    name = "embedded_hip_headers",
    srcs = [
        "//loom/src/loom/import/cxx:include/hip/hip_fp16.h",
        "//loom/src/loom/import/cxx:include/hip/hip_runtime.h",
    ],
    c_file_output = "embedded_hip_headers.c",
    flatten = True,
    h_file_output = "embedded_hip_headers.h",
    identifier = "loom_cxx_embedded_hip_headers",
    target_compatible_with = _EMBED_COMPATIBLE_WITH,
)

loom_cc_library(
    name = "catalog",
    srcs = ["catalog.cc"],
    hdrs = ["catalog.h"],
    defines = select({
        "//loom/config/import/cxx:embed_includes_enabled": ["LOOM_CXX_EMBED_INCLUDES=1"],
        "//conditions:default": ["LOOM_CXX_EMBED_INCLUDES=0"],
    }),
    deps = select({
        "//loom/config/import/cxx:embed_includes_enabled": [
            ":embedded_hip_headers",
            ":embedded_loomcxx_headers",
            ":embedded_standard_headers",
        ],
        "//conditions:default": [],
    }),
)

loom_cc_library(
    name = "options",
    srcs = ["options.c"],
    hdrs = ["options.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//loom/src/loom/error:diagnostic",
        "//loom/src/loom/format/text:low_asm",
    ],
)

loom_cc_library(
    name = "error",
    hdrs = ["error.h"],
    deps = ["//runtime/src/iree/base"],
)

loom_cc_library(
    name = "source",
    srcs = ["source.cc"],
    hdrs = ["source.h"],
    cxx_features = CXX_COMPILER_OPTIONS["cxx_features"],
    cxx_standard = CXX_COMPILER_OPTIONS["cxx_standard"],
    deps = [
        ":catalog",
        ":error",
        ":options",
        "//loom/src/loom/error:error_defs",
        "//third_party:cxx_parser",
    ],
)

