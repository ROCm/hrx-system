load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_instance_library", "loom_cc_library", "loom_generated_cc_library")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_WASM_ROOT_VISIBILITY = [
    "//loom/src/loom/target/arch/wasm:__pkg__",
    "//loom/src/loom/target/emit/wasm:__pkg__",
]

loom_cc_library(
    name = "op_defs",
    hdrs = ["ops.h"],
    textual_hdrs = ["ops.inc"],
    visibility = ["//visibility:public"],
    deps = [
        "//loom/src/loom/ops:headers",
        "//loom/src/loom/target:types",
    ],
)

loom_cc_instance_library(
    name = "builders",
    srcs = ["builders.c"],
    hdrs = ["ops.h"],
    textual_hdrs = ["ops.inc"],
    visibility = ["//visibility:public"],
    deps = [
        "//loom/src/loom/ir:builders",
        "//loom/src/loom/ops:builders",
        "//loom/src/loom/target:types",
    ],
)

loom_generated_cc_library(
    name = "ops",
    srcs = [
        "registry.c",
    ],
    hdrs = [
        "ops.h",
        "registry.h",
    ],
    args = ["--dialect=wasm"],
    extra_output_flags = [
        "--ops-include",
        "--builders",
    ],
    extra_outputs = [
        "ops.inc",
        "builders.c",
    ],
    generated_src_flags = ["--tables"],
    generated_srcs = ["tables.c"],
    generator = "//loom/py/loom/gen/ops:c_tables_wasm_generator",
    textual_hdrs = ["ops.inc"],
    visibility = _WASM_ROOT_VISIBILITY,
    deps = [
        ":builders",
        "//loom/src/loom/error:error_defs",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/ops/target",
        "//loom/src/loom/target:types",
        "//loom/src/loom/target/arch/wasm/records:target_records",
        "//runtime/src/iree/base",
    ],
)
