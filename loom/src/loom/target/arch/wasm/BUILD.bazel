load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_library",
    "loom_cc_test",
    "loom_generated_cc_library",
)

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_WASM_PROVIDER_VISIBILITY = [
    "//loom/src/loom/target/configured:__pkg__",
    "//loom/src/loom/target/emit/wasm:__pkg__",
]

#===------------------------------------------------------------------------===#
# Wasm low descriptors
#===------------------------------------------------------------------------===#

loom_generated_cc_library(
    name = "error_defs",
    args = [
        "--catalog-symbol=loom_wasm_error_catalog",
        "--fallback-catalog-symbol=loom_error_catalog_core",
        "--fallback-public-header=loom/error/error_catalog.h",
        "--public-header=loom/target/arch/wasm/error_catalog.h",
        "--shard=wasm",
    ],
    generated_hdr_flags = ["--header"],
    generated_hdrs = ["error_catalog.h"],
    generator = "//loom/py/loom/gen/error:c_errors",
    source = "error_catalog.c",
    visibility = ["//loom/src/loom/target/arch/wasm/lower:__pkg__"],
    deps = ["//loom/src/loom/error:error_defs"],
)

loom_cc_library(
    name = "math_policy",
    srcs = ["math_policy.c"],
    hdrs = ["math_policy.h"],
    deps = [
        "//loom/src/loom/target:math_policy",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "low_verify",
    srcs = ["low_verify.c"],
    hdrs = ["low_verify.h"],
    deps = [
        "//loom/src/loom/codegen/low:diagnostics",
        "//loom/src/loom/codegen/low:verify",
        "//loom/src/loom/error:error_defs",
        "//loom/src/loom/error:parameter",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops/low",
        "//loom/src/loom/target:registers",
        "//loom/src/loom/target/arch/wasm/descriptors:descriptors_ids",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
    ],
)

loom_cc_library(
    name = "ir_provider",
    srcs = ["ir_provider.c"],
    hdrs = ["ir_provider.h"],
    visibility = ["//loom/src/loom/target/configured:__pkg__"],
    deps = [
        "//loom/src/loom/target:provider",
        "//loom/src/loom/target/arch/wasm/descriptors:low_registry",
        "//loom/src/loom/target/arch/wasm/ops",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "provider",
    srcs = [
        "legalization_float.c",
        "legalization_memory.c",
        "provider.c",
    ],
    hdrs = [
        "legalization_float.h",
        "legalization_memory.h",
        "provider.h",
    ],
    visibility = _WASM_PROVIDER_VISIBILITY,
    deps = [
        ":low_verify",
        ":math_policy",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops/scalar",
        "//loom/src/loom/ops/scf",
        "//loom/src/loom/ops/vector",
        "//loom/src/loom/ops/view",
        "//loom/src/loom/target:legalization",
        "//loom/src/loom/target:provider",
        "//loom/src/loom/target/arch/wasm/descriptors",
        "//loom/src/loom/target/arch/wasm/descriptors:low_registry",
        "//loom/src/loom/target/arch/wasm/lower",
        "//loom/src/loom/target/arch/wasm/ops",
        "//loom/src/loom/target/arch/wasm/records:target_records",
        "//loom/src/loom/transforms/scalar:target_legalization",
        "//loom/src/loom/transforms/vector:packet_legalization",
        "//loom/src/loom/transforms/vector:shape_legalization",
        "//loom/src/loom/transforms/vector:target_legalization",
        "//loom/src/loom/transforms/vector:to_scalar",
        "//loom/src/loom/util:numeric_format",
        "//runtime/src/iree/base",
    ],
)

loom_cc_test(
    name = "provider_test",
    srcs = ["provider_test.cc"],
    deps = [
        ":provider",
        "//loom/src/loom/target:profile",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_test(
    name = "registers_test",
    srcs = ["registers_test.cc"],
    deps = [
        "//loom/src/loom/codegen/low:representation_binding",
        "//loom/src/loom/target:registers",
        "//loom/src/loom/target/arch/wasm/descriptors",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
