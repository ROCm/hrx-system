// Captured bytes survive an aliasing write and a second volatile observation.
func.def @capture_byte_tail(%input: buffer, %output: buffer, %replacement_input: buffer) {
  %base = index.constant 0 : offset
  %next = index.constant 3 : offset
  %source = buffer.view %input[%base] : buffer -> view<3xi8>
  %before = buffer.view %output[%base] : buffer -> view<3xi8>
  %after = buffer.view %output[%next] : buffer -> view<3xi8>
  %captured = vector.load<volatile> %source[0] : view<3xi8> -> vector<3xi8>
  %replacement_view = buffer.view %replacement_input[%base] : buffer -> view<3xi8>
  %replacement = vector.load %replacement_view[0] : view<3xi8> -> vector<3xi8>
  vector.store<volatile> %replacement, %source[0] : vector<3xi8>, view<3xi8>
  %reloaded = vector.load<volatile> %source[0] : view<3xi8> -> vector<3xi8>
  vector.store %captured, %before[0] : vector<3xi8>, view<3xi8>
  vector.store %reloaded, %after[0] : vector<3xi8>, view<3xi8>
  func.return
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @capture_byte_tail(%source: reg<wasm.i32>, %after: reg<wasm.i32>, %replacement_view: reg<wasm.i32>) asm {
  %45 = i32.load8_u<volatile> %source
  %46 = i32.load8_u<volatile> %source {offset = 1}
  %47 = i32.load8_u<volatile> %source {offset = 2}
  %48 = i32.load8_u %replacement_view
  %49 = i32.load8_u %replacement_view {offset = 1}
  %50 = i32.load8_u %replacement_view {offset = 2}
  i32.store8<volatile> %source, %48
  i32.store8<volatile> %source, %49 {offset = 1}
  i32.store8<volatile> %source, %50 {offset = 2}
  %51 = i32.load8_u<volatile> %source
  %52 = i32.load8_u<volatile> %source {offset = 1}
  %53 = i32.load8_u<volatile> %source {offset = 2}
  i32.store8 %after, %45
  i32.store8 %after, %46 {offset = 1}
  i32.store8 %after, %47 {offset = 2}
  i32.store8 %after, %51 {offset = 3}
  i32.store8 %after, %52 {offset = 4}
  i32.store8 %after, %53 {offset = 5}
  return
}
