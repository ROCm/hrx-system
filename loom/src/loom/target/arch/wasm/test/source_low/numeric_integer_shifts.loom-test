// RUN: emit source-low target=wasm:simd128 output=low

func.def @varying_i8(%lhs: vector<16xi8>, %rhs: vector<16xi8>) -> (vector<16xi8>) {
  %result = vector.shli %lhs, %rhs : vector<16xi8>
  func.return %result : vector<16xi8>
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @varying_i8(%lhs: reg<wasm.v128>, %rhs: reg<wasm.v128>) -> (reg<wasm.v128>) asm {
  %7 = v128.const 72340172838076673, 72340172838076673
  %8 = i32.const 1
  %9 = v128.const 144680345676153346, 144680345676153346
  %10 = i32.const 2
  %11 = v128.const 289360691352306692, 289360691352306692
  %12 = i32.const 4
  %13 = v128.and %rhs, %7
  %14 = i8x16.eq %13, %7
  %15 = i8x16.shl %lhs, %8
  %16 = v128.bitselect %15, %lhs, %14
  %17 = v128.and %rhs, %9
  %18 = i8x16.eq %17, %9
  %19 = i8x16.shl %16, %10
  %20 = v128.bitselect %19, %16, %18
  %21 = v128.and %rhs, %11
  %22 = i8x16.eq %21, %11
  %23 = i8x16.shl %20, %12
  %result = v128.bitselect %23, %20, %22
  return %result
}

// ====

func.def @varying_i16(%lhs: vector<8xi16>, %rhs: vector<8xi16>) -> (vector<8xi16>) {
  %result = vector.shrsi %lhs, %rhs : vector<8xi16>
  func.return %result : vector<8xi16>
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @varying_i16(%lhs: reg<wasm.v128>, %rhs: reg<wasm.v128>) -> (reg<wasm.v128>) asm {
  %7 = v128.const 281479271743489, 281479271743489
  %8 = i32.const 1
  %9 = v128.const 562958543486978, 562958543486978
  %10 = i32.const 2
  %11 = v128.const 1125917086973956, 1125917086973956
  %12 = i32.const 4
  %13 = v128.const 2251834173947912, 2251834173947912
  %14 = i32.const 8
  %15 = v128.and %rhs, %7
  %16 = i16x8.eq %15, %7
  %17 = i16x8.shr_s %lhs, %8
  %18 = v128.bitselect %17, %lhs, %16
  %19 = v128.and %rhs, %9
  %20 = i16x8.eq %19, %9
  %21 = i16x8.shr_s %18, %10
  %22 = v128.bitselect %21, %18, %20
  %23 = v128.and %rhs, %11
  %24 = i16x8.eq %23, %11
  %25 = i16x8.shr_s %22, %12
  %26 = v128.bitselect %25, %22, %24
  %27 = v128.and %rhs, %13
  %28 = i16x8.eq %27, %13
  %29 = i16x8.shr_s %26, %14
  %result = v128.bitselect %29, %26, %28
  return %result
}

