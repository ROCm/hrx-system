wasm.target<simd128> @target

func.def target(@target) @subview_vector_strided(%input: buffer, %output: buffer) {
  %input_base = index.constant 16 : offset
  %output_base = index.constant 32 : offset
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %layout = encoding.layout.strided [12, 1] : encoding<layout>
  %source = buffer.view %input_aligned[%input_base] : buffer -> view<4x12xi32, %layout>
  %destination = buffer.view %output_aligned[%output_base] : buffer -> view<4x12xi32, %layout>
  %source_crop = view.subview %source[1, 2] : view<4x12xi32, %layout> -> view<2x8xi32, %layout>
  %destination_crop = view.subview %destination[1, 1] : view<4x12xi32, %layout> -> view<2x8xi32, %layout>
  %value = vector.load %source_crop[1, 1] : view<2x8xi32, %layout> -> vector<4xi32>
  vector.store %value, %destination_crop[0, 1] : vector<4xi32>, view<2x8xi32, %layout>
  func.return
}

// ----
low.func.def target<wasm.core.simd128>(@target) abi(wasm_function) @subview_vector_strided(%source_crop: reg<wasm.i32>, %destination_crop: reg<wasm.i32>) asm {
  %value = v128.load %source_crop {offset = 124}
  v128.store %destination_crop, %value {offset = 88}
  return
}

