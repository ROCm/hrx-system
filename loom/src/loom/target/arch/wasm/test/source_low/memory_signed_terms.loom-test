  %ordinal = scalar.addi %signed, %bias : i32
  %position = index.cast %ordinal : i32 to index
  %base = index.constant 0 : offset
  %layout = encoding.layout.strided [2] : encoding<layout>
  %view = buffer.view %table[%base] : buffer -> view<128xi32, %layout>
  %value = view.load %view[%position] : view<128xi32, %layout> -> i32
