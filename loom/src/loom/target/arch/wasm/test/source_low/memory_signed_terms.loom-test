func.def @negative_uniform_coefficient(%selector0: i32, %value: i32, %table: buffer) {
  %selector = scalar.assume %selector0 [range(%selector0, 0, 1)] : i32
  %coordinate = index.cast %selector : i32 to index
  %c1 = index.constant 1 : index
  %position = index.sub %c1, %coordinate : index
  %word_bytes = index.constant 4 : offset
  %origin = index.scale %position, %word_bytes : index, offset -> offset
  %view = buffer.view %table[%origin] : buffer -> view<1xi32>
  view.store %value, %view[0] : i32, view<1xi32>
  func.return
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @negative_uniform_coefficient(%selector: reg<wasm.i32>, %value: reg<wasm.i32>, %view: reg<wasm.i32>) asm {
  %13 = i32.const 4
  %14 = i32.const -4
  %15 = i32.mul %selector, %14
  %16 = i32.add %15, %13
  %17 = i32.add %view, %16
  i32.store %17, %value
  return
}

// ====

func.def @negative_varying_coefficient(%input: buffer, %table: buffer) -> (i32) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<1xi32>
  %raw = view.load %source[0] : view<1xi32> -> i32
  %signed = scalar.assume %raw [range(%raw, -1, 0)] : i32
  %coordinate = index.cast %signed : i32 to index
  %c0 = index.constant 0 : index
  %position = index.sub %c0, %coordinate : index
  %word_bytes = index.constant 4 : offset
  %origin = index.scale %position, %word_bytes : index, offset -> offset
  %view = buffer.view %table[%origin] : buffer -> view<1xi32>
  %value = view.load %view[0] : view<1xi32> -> i32
  func.return %value : i32
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @negative_varying_coefficient(%source: reg<wasm.i32>, %view: reg<wasm.i32>) -> (reg<wasm.i32>) asm {
  %coordinate = i32.load %source
  %c0 = i32.const 0
  %position = i32.sub %c0, %coordinate
  %word_bytes = i32.const 4
  %origin = i32.mul %position, %word_bytes
  %22 = i32.add %view, %origin
  %value = i32.load %22
  return %value
}
