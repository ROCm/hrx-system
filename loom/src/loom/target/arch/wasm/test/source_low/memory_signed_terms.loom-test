// RUN: emit source-low target=wasm:simd128 output=low

func.def @signed_uniform_word(%input: i32, %table: buffer) -> (i32) {
  %signed = scalar.assume %input [range(%input, -128, 127)] : i32
  %bias = scalar.constant 128 : i32
  %ordinal = scalar.addi %signed, %bias : i32
  %position = index.cast %ordinal : i32 to index
  %base = index.constant 0 : offset
  %view = buffer.view %table[%base] : buffer -> view<256xi32>
  %value = view.load %view[%position] : view<256xi32> -> i32
  func.return %value : i32
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @signed_uniform_word(%signed: reg<wasm.i32>, %view: reg<wasm.i32>) -> (reg<wasm.i32>) asm {
  %13 = i32.const 512
  %14 = i32.const 4
  %15 = i32.mul %signed, %14
  %16 = i32.add %15, %13
  %17 = i32.add %view, %16
  %value = i32.load %17
  return %value
}

