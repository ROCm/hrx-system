// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @dynamic_stride_static_bias(%view: reg<wasm.i32>, %position: reg<wasm.i32>, %stride: reg<wasm.i32>) -> (reg<wasm.i32>) asm {
  %14 = i32.mul %position, %stride
  %15 = i32.add %view, %14
