// RUN: with-checks compile-report target=wasm:simd128 source-to-low,low-dce

func.def @report_narrow_float_widening(%e4_packet: vector<16xf8E4M3>, %e5_packet: vector<16xf8E5M2>, %f16_packet: vector<8xf16>, %bf16_packet: vector<8xbf16>) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) {
  %e4 = vector.slice %e4_packet[0] : vector<16xf8E4M3> -> vector<4xf8E4M3>
  %e5 = vector.slice %e5_packet[0] : vector<16xf8E5M2> -> vector<4xf8E5M2>
  %f16 = vector.slice %f16_packet[0] : vector<8xf16> -> vector<4xf16>
  %bf16 = vector.slice %bf16_packet[0] : vector<8xbf16> -> vector<4xbf16>
  %e4_wide = vector.extf %e4 : vector<4xf8E4M3> to vector<4xf32>
  %e5_wide = vector.extf %e5 : vector<4xf8E5M2> to vector<4xf32>
  %f16_wide = vector.extf %f16 : vector<4xf16> to vector<4xf32>
  %bf16_wide = vector.extf %bf16 : vector<4xbf16> to vector<4xf32>
  func.return %e4_wide, %e5_wide, %f16_wide, %bf16_wide : vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>
}

