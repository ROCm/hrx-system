// TEMPLATE: loom/src/loom/test/corpus/source_low/packed_memory_values.loom-test
// TEMPLATE-EXCLUDE: @uniform_table Narrow indexed extraction requires i8 selection and index conversion contracts.
// TEMPLATE-EXCLUDE: @uniform_i8 Scalarized byte arithmetic requires an i32-to-i8 truncation contract.
// TEMPLATE-EXCLUDE: @uniform_i16 Scalarized halfword arithmetic requires an i32-to-i16 truncation contract.
// TEMPLATE-EXCLUDE: @uniform_f16 The target math policy does not admit FP16 vector addition.
// TEMPLATE-EXCLUDE: @uniform_bf16 The target lacks the BF16 load-to-FP32 conversion contract.
// TEMPLATE-EXCLUDE: @uniform_f16_extf The target lacks the FP16 vector load-to-FP32 conversion contract.
// RUN: emit source-low target=wasm:simd128 output=low

func.def @uniform_f8E4M3(%input: buffer, %output: buffer) {
  %aligned = buffer.assume.alignment %input {minimum_alignment = 64} : buffer
  %source, %destination = buffer.assume.noalias %aligned, %output : buffer, buffer
  %c0 = index.constant 0 : offset
  %source_view = buffer.view %source[%c0] : buffer -> view<8xf8E4M3>
  %value = vector.load %source_view[0] : view<8xf8E4M3> -> vector<8xf8E4M3>
  %result = vector.extf %value : vector<8xf8E4M3> to vector<8xf32>
  %output_view = buffer.view %destination[%c0] : buffer -> view<8xf32>
  vector.store %result, %output_view[0] : vector<8xf32>, view<8xf32>
  func.return
}

