  %19 = i32.load8_u %source_view
  %20 = i32.load8_u %source_view {offset = 1}
  i32.store8 %output_view, %19
  i32.store8 %output_view, %20 {offset = 1}
  return
}

// ====

// Potentially aliasing writes prevent treating the input as stable.
func.def @mutable_bytes(%input: buffer, %output: buffer) {
  %aligned = buffer.assume.alignment %input {minimum_alignment = 64} : buffer
  %start = index.constant 0 : offset
  %c0 = index.constant 0 : offset
  %source_view = buffer.view %aligned[%start] : buffer -> view<16xi8>
  %value = vector.load %source_view[0] : view<16xi8> -> vector<16xi8>
  %output_view = buffer.view %output[%c0] : buffer -> view<16xi8>
  vector.store %value, %output_view[0] : vector<16xi8>, view<16xi8>
  func.return
}

