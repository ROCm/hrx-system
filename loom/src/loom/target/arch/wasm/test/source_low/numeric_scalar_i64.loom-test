wasm.target<simd128> @target

func.def target(@target) @scalar_f64_select_reuse(%condition: i1, %true_value: f64, %false_value: f64) -> (f64, f64, f64, i1) {
  %result = scf.select %condition, %true_value, %false_value : f64
  func.return %result, %true_value, %false_value, %condition : f64, f64, f64, i1
}

// ----
low.func.def target<wasm.core.simd128>(@target) abi(wasm_function) @scalar_f64_select_reuse(%condition: reg<wasm.i32>, %true_value: reg<wasm.f64>, %false_value: reg<wasm.f64>) -> (reg<wasm.f64>, reg<wasm.f64>, reg<wasm.f64>, reg<wasm.i32>) asm {
  %result = f64.select %true_value, %false_value, %condition
  return %result, %true_value, %false_value, %condition
}
