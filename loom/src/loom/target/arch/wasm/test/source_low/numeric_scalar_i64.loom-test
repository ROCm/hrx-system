func.def target(@target) @scalar_i64_bitwise_sgpr(%lhs: i64, %rhs: i64) -> (i64, i64, i64) {
  %and = scalar.andi %lhs, %rhs : i64
  %or = scalar.ori %and, %lhs : i64
  %xor = scalar.xori %or, %rhs : i64
  func.return %and, %or, %xor : i64, i64, i64
}

// ----
low.func.def target<wasm.core.simd128>(@target) abi(wasm_function) @scalar_i64_bitwise_sgpr(%lhs: reg<wasm.i64>, %rhs: reg<wasm.i64>) -> (reg<wasm.i64>, reg<wasm.i64>, reg<wasm.i64>) asm {
  %and = i64.and %lhs, %rhs
  %or = i64.or %and, %lhs
  %xor = i64.xor %or, %rhs
  return %and, %or, %xor
}

