func.def target(@target) @scalar_i64_compare_all_predicates_vgpr_select(%lhs_values: vector<2xi64>, %rhs_values: vector<2xi64>, %true_value: f32, %false_value: f32) -> (f32, f32, f32, f32, f32, f32, f32, f32, f32, f32) {
  %lhs = vector.extract %lhs_values[0] : vector<2xi64> -> i64
  %rhs = vector.extract %rhs_values[0] : vector<2xi64> -> i64
  %eq = scalar.cmpi eq, %lhs, %rhs : i64
  %ne = scalar.cmpi ne, %lhs, %rhs : i64
  %slt = scalar.cmpi slt, %lhs, %rhs : i64
  %sle = scalar.cmpi sle, %lhs, %rhs : i64
  %sgt = scalar.cmpi sgt, %lhs, %rhs : i64
  %sge = scalar.cmpi sge, %lhs, %rhs : i64
  %ult = scalar.cmpi ult, %lhs, %rhs : i64
  %ule = scalar.cmpi ule, %lhs, %rhs : i64
  %ugt = scalar.cmpi ugt, %lhs, %rhs : i64
  %uge = scalar.cmpi uge, %lhs, %rhs : i64
  %eq_result = scf.select %eq, %true_value, %false_value : f32
  %ne_result = scf.select %ne, %true_value, %false_value : f32
  %slt_result = scf.select %slt, %true_value, %false_value : f32
  %sle_result = scf.select %sle, %true_value, %false_value : f32
  %sgt_result = scf.select %sgt, %true_value, %false_value : f32
  %sge_result = scf.select %sge, %true_value, %false_value : f32
  %ult_result = scf.select %ult, %true_value, %false_value : f32
  %ule_result = scf.select %ule, %true_value, %false_value : f32
  %ugt_result = scf.select %ugt, %true_value, %false_value : f32
  %uge_result = scf.select %uge, %true_value, %false_value : f32
  func.return %eq_result, %ne_result, %slt_result, %sle_result, %sgt_result, %sge_result, %ult_result, %ule_result, %ugt_result, %uge_result : f32, f32, f32, f32, f32, f32, f32, f32, f32, f32
}

// ----
low.func.def target<wasm.core.simd128>(@target) abi(wasm_function) @scalar_i64_compare_all_predicates_vgpr_select(%lhs_values: reg<wasm.v128>, %rhs_values: reg<wasm.v128>, %true_value: reg<wasm.f32>, %false_value: reg<wasm.f32>) -> (reg<wasm.f32>, reg<wasm.f32>, reg<wasm.f32>, reg<wasm.f32>, reg<wasm.f32>, reg<wasm.f32>, reg<wasm.f32>, reg<wasm.f32>, reg<wasm.f32>, reg<wasm.f32>) asm {
  %lhs = i64x2.extract_lane %lhs_values, 0
  %rhs = i64x2.extract_lane %rhs_values, 0
  %eq = i64.eq %lhs, %rhs
  %ne = i64.ne %lhs, %rhs
  %slt = i64.lt_s %lhs, %rhs
  %sle = i64.le_s %lhs, %rhs
  %sgt = i64.gt_s %lhs, %rhs
  %sge = i64.ge_s %lhs, %rhs
  %ult = i64.lt_u %lhs, %rhs
  %ule = i64.le_u %lhs, %rhs
  %ugt = i64.gt_u %lhs, %rhs
  %uge = i64.ge_u %lhs, %rhs
  %eq_result = f32.select %true_value, %false_value, %eq
  %ne_result = f32.select %true_value, %false_value, %ne
  %slt_result = f32.select %true_value, %false_value, %slt
  %sle_result = f32.select %true_value, %false_value, %sle
  %sgt_result = f32.select %true_value, %false_value, %sgt
  %sge_result = f32.select %true_value, %false_value, %sge
  %ult_result = f32.select %true_value, %false_value, %ult
  %ule_result = f32.select %true_value, %false_value, %ule
  %ugt_result = f32.select %true_value, %false_value, %ugt
  %uge_result = f32.select %true_value, %false_value, %uge
  return %eq_result, %ne_result, %slt_result, %sle_result, %sgt_result, %sge_result, %ult_result, %ule_result, %ugt_result, %uge_result
}

