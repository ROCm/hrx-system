// RUN: emit source-low target=wasm:simd128 output=low

func.def @integer_division_i32(%dividend: i32, %divisor: i32) -> (i32, i32, i32, i32) {
  %signed_quotient = scalar.divsi %dividend, %divisor : i32
  %signed_remainder = scalar.remsi %dividend, %divisor : i32
  %unsigned_quotient = scalar.divui %dividend, %divisor : i32
  %unsigned_remainder = scalar.remui %dividend, %divisor : i32
  func.return %signed_quotient, %signed_remainder, %unsigned_quotient, %unsigned_remainder : i32, i32, i32, i32
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @integer_division_i32(%dividend: reg<wasm.i32>, %divisor: reg<wasm.i32>) -> (reg<wasm.i32>, reg<wasm.i32>, reg<wasm.i32>, reg<wasm.i32>) asm {
  %signed_quotient = i32.div_s %dividend, %divisor
  %signed_remainder = i32.rem_s %dividend, %divisor
  %unsigned_quotient = i32.div_u %dividend, %divisor
  %unsigned_remainder = i32.rem_u %dividend, %divisor
  return %signed_quotient, %signed_remainder, %unsigned_quotient, %unsigned_remainder
}

// ====

func.def @integer_division_i64(%dividend: i64, %divisor: i64) -> (i64, i64, i64, i64) {
  %signed_quotient = scalar.divsi %dividend, %divisor : i64
  %signed_remainder = scalar.remsi %dividend, %divisor : i64
  %unsigned_quotient = scalar.divui %dividend, %divisor : i64
  %unsigned_remainder = scalar.remui %dividend, %divisor : i64
  func.return %signed_quotient, %signed_remainder, %unsigned_quotient, %unsigned_remainder : i64, i64, i64, i64
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @integer_division_i64(%dividend: reg<wasm.i64>, %divisor: reg<wasm.i64>) -> (reg<wasm.i64>, reg<wasm.i64>, reg<wasm.i64>, reg<wasm.i64>) asm {
  %signed_quotient = i64.div_s %dividend, %divisor
  %signed_remainder = i64.rem_s %dividend, %divisor
  %unsigned_quotient = i64.div_u %dividend, %divisor
  %unsigned_remainder = i64.rem_u %dividend, %divisor
  return %signed_quotient, %signed_remainder, %unsigned_quotient, %unsigned_remainder
}
