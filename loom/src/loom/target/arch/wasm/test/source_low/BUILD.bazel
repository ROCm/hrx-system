load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")
load("//loom/build_tools/bazel:loom_check.bzl", "loom_check_test_suite")

package(
    default_visibility = ["//visibility:private"],
    licenses = ["notice"],  # Apache 2.0
)

loom_check_test_suite(
    name = "test",
    srcs = glob(["*.loom-test"]),
)

loom_check_test_suite(
    name = "cxx_test",
    srcs = [
        "wasm_lowering.cxx-test",
        "wasm_lowering_invalid.cxx-test",
        "wasm_pointer_narrowing.cxx-test",
    ],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/import:cxx",
        "//loom/config/arch:wasm",
    ]),
)
