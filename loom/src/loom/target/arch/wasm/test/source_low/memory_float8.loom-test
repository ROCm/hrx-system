low.func.def target<wasm.core.simd128> abi(wasm_function) @copy_float8_vector(%source_e5m2: reg<wasm.i32>, %target_e5m2: reg<wasm.i32>) asm {
  %110 = i32.load8_u %source_e5m2
  %111 = i32.load8_u %source_e5m2 {offset = 1}
