  %133 = i32.load8_u %source_e5m2 {offset = 23}
  %134 = i32.load8_u %source_e5m2 {offset = 24}
  %135 = i32.load8_u %source_e5m2 {offset = 25}
  %136 = i32.load8_u %source_e5m2 {offset = 26}
  %137 = i32.load8_u %source_e5m2 {offset = 27}
