// RUN: emit source-low output=low

// A direct-call target admits semantic calls. Profitability expands the
// ordinary cohort while authored noinline retains its boundary.
wasm.target<simd128> @target

func.def target(@target) @callee(%value: i32, %delta: i32) -> (i32) {
  %result = scalar.addi %value, %delta : i32
  func.return %result : i32
}

func.def public target(@target) @caller(%value: i32, %delta: i32) -> (i32, i32) {
  %ordinary = func.call @callee(%value, %delta) : (i32, i32) -> (i32)
  %explicit = func.call noinline @callee(%ordinary, %delta) : (i32, i32) -> (i32)
  func.return %ordinary, %explicit : i32, i32
}

// ----
low.func.def target<wasm.core.simd128>(@target) @callee(%value: reg<wasm.i32>, %delta: reg<wasm.i32>) -> (reg<wasm.i32>) asm {
  %result = i32.add %value, %delta
  return %result
}

low.func.def public target<wasm.core.simd128>(@target) abi(wasm_function) @caller(%value: reg<wasm.i32>, %delta: reg<wasm.i32>) -> (reg<wasm.i32>, reg<wasm.i32>) asm {
  %result = i32.add %value, %delta
  %explicit = low.func.call pure noinline @callee(%result, %delta) : (reg<wasm.i32>, reg<wasm.i32>) -> (reg<wasm.i32>)
  return %result, %explicit
}
