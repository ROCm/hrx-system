func.def @copy_word_vector_large(%input: buffer, %output: buffer) {
  %first = index.constant 0 : offset
  %second = index.constant 64 : offset
  %third = index.constant 128 : offset
  %source_half = buffer.view %input[%first] : buffer -> view<32xf16>
  %source_bfloat = buffer.view %input[%second] : buffer -> view<32xbf16>
  %source_integer = buffer.view %input[%third] : buffer -> view<32xi16>
  %target_half = buffer.view %output[%first] : buffer -> view<32xf16>
  %target_bfloat = buffer.view %output[%second] : buffer -> view<32xbf16>
  %target_integer = buffer.view %output[%third] : buffer -> view<32xi16>
  %half = vector.load %source_half[0] : view<32xf16> -> vector<32xf16>
  %bfloat = vector.load %source_bfloat[0] : view<32xbf16> -> vector<32xbf16>
  %integer = vector.load %source_integer[0] : view<32xi16> -> vector<32xi16>
  vector.store %half, %target_half[0] : vector<32xf16>, view<32xf16>
  vector.store %bfloat, %target_bfloat[0] : vector<32xbf16>, view<32xbf16>
  vector.store %integer, %target_integer[0] : vector<32xi16>, view<32xi16>
  func.return
}

