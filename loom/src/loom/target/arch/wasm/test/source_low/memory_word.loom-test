low.func.def target<wasm.core.simd128> abi(wasm_function) @copy_word_unaligned(%source_integer: reg<wasm.i32>, %target_integer: reg<wasm.i32>) asm {
  %91 = i32.load16_u %source_integer {offset = 1}
  %92 = i32.load16_u %source_integer {offset = 3}
  %93 = i32.load16_u %source_integer {offset = 5}
  %94 = i32.load16_u %source_integer {offset = 7}
  %95 = i32.load16_u %source_integer {offset = 9}
  %96 = i32.load16_u %source_integer {offset = 11}
  %97 = i32.load16_u %source_integer {offset = 13}
  %98 = i32.load16_u %source_integer {offset = 15}
  %99 = i32.load16_u %source_integer {offset = 17}
  %100 = i32.load16_u %source_integer {offset = 19}
  %101 = i32.load16_u %source_integer {offset = 21}
  %102 = i32.load16_u %source_integer {offset = 23}
  %103 = i32.load16_u %source_integer {offset = 25}
  %104 = i32.load16_u %source_integer {offset = 27}
  %105 = i32.load16_u %source_integer {offset = 29}
  %106 = i32.load16_u %source_integer {offset = 31}
  %107 = i32.load16_u %source_integer {offset = 33}
  %108 = i32.load16_u %source_integer {offset = 35}
  %109 = i32.load16_u %source_integer {offset = 37}
  %110 = i32.load16_u %source_integer {offset = 39}
  %111 = i32.load16_u %source_integer {offset = 41}
  %112 = i32.load16_u %source_integer {offset = 43}
  %113 = i32.load16_u %source_integer {offset = 45}
  %114 = i32.load16_u %source_integer {offset = 47}
  i32.store16 %target_integer, %91 {offset = 1}
  i32.store16 %target_integer, %92 {offset = 3}
  i32.store16 %target_integer, %93 {offset = 5}
  i32.store16 %target_integer, %94 {offset = 7}
  i32.store16 %target_integer, %95 {offset = 9}
  i32.store16 %target_integer, %96 {offset = 11}
  i32.store16 %target_integer, %97 {offset = 13}
  i32.store16 %target_integer, %98 {offset = 15}
  i32.store16 %target_integer, %99 {offset = 17}
  i32.store16 %target_integer, %100 {offset = 19}
  i32.store16 %target_integer, %101 {offset = 21}
  i32.store16 %target_integer, %102 {offset = 23}
  i32.store16 %target_integer, %103 {offset = 25}
  i32.store16 %target_integer, %104 {offset = 27}
  i32.store16 %target_integer, %105 {offset = 29}
  i32.store16 %target_integer, %106 {offset = 31}
  i32.store16 %target_integer, %107 {offset = 33}
  i32.store16 %target_integer, %108 {offset = 35}
  i32.store16 %target_integer, %109 {offset = 37}
  i32.store16 %target_integer, %110 {offset = 39}
  i32.store16 %target_integer, %111 {offset = 41}
  i32.store16 %target_integer, %112 {offset = 43}
  i32.store16 %target_integer, %113 {offset = 45}
  i32.store16 %target_integer, %114 {offset = 47}
  return
}

// ====

// Three-word tails must not read or write a fourth word.
func.def @copy_word_tail(%input: buffer, %output: buffer) {
  %first = index.constant 1 : offset
  %second = index.constant 7 : offset
  %third = index.constant 13 : offset
  %source_half = buffer.view %input[%first] : buffer -> view<3xf16, align(1)>
  %source_bfloat = buffer.view %input[%second] : buffer -> view<3xbf16, align(1)>
  %source_integer = buffer.view %input[%third] : buffer -> view<3xi16, align(1)>
  %target_half = buffer.view %output[%first] : buffer -> view<3xf16, align(1)>
  %target_bfloat = buffer.view %output[%second] : buffer -> view<3xbf16, align(1)>
  %target_integer = buffer.view %output[%third] : buffer -> view<3xi16, align(1)>
  %half = vector.load %source_half[0] : view<3xf16, align(1)> -> vector<3xf16>
  %bfloat = vector.load %source_bfloat[0] : view<3xbf16, align(1)> -> vector<3xbf16>
  %integer = vector.load %source_integer[0] : view<3xi16, align(1)> -> vector<3xi16>
  vector.store %half, %target_half[0] : vector<3xf16>, view<3xf16, align(1)>
  vector.store %bfloat, %target_bfloat[0] : vector<3xbf16>, view<3xbf16, align(1)>
  vector.store %integer, %target_integer[0] : vector<3xi16>, view<3xi16, align(1)>
  func.return
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @copy_word_tail(%source_integer: reg<wasm.i32>, %target_integer: reg<wasm.i32>) asm {
  %46 = i32.load16_u %source_integer {offset = 1}
  %47 = i32.load16_u %source_integer {offset = 3}
  %48 = i32.load16_u %source_integer {offset = 5}
  %49 = i32.load16_u %source_integer {offset = 7}
  %50 = i32.load16_u %source_integer {offset = 9}
  %51 = i32.load16_u %source_integer {offset = 11}
  %52 = i32.load16_u %source_integer {offset = 13}
  %53 = i32.load16_u %source_integer {offset = 15}
  %54 = i32.load16_u %source_integer {offset = 17}
  i32.store16 %target_integer, %46 {offset = 1}
  i32.store16 %target_integer, %47 {offset = 3}
  i32.store16 %target_integer, %48 {offset = 5}
  i32.store16 %target_integer, %49 {offset = 7}
  i32.store16 %target_integer, %50 {offset = 9}
  i32.store16 %target_integer, %51 {offset = 11}
  i32.store16 %target_integer, %52 {offset = 13}
  i32.store16 %target_integer, %53 {offset = 15}
  i32.store16 %target_integer, %54 {offset = 17}
  return
}

// ====

// Runtime byte origins remain distinct from the two-byte element coordinate.
func.def @copy_word_index(%input: buffer, %output: buffer, %byte_offset: offset, %element: index) {
  %base = index.assume %byte_offset [range(%byte_offset, 0, 128)] : offset
  %position = index.assume %element [range(%element, 0, 7)] : index
  %source_half = buffer.view %input[%base] : buffer -> view<8xf16, align(1)>
  %source_bfloat_base = buffer.view %input[%base] : buffer -> view<24xbf16, align(1)>
  %source_integer_base = buffer.view %input[%base] : buffer -> view<24xi16, align(1)>
  %target_half = buffer.view %output[%base] : buffer -> view<8xf16, align(1)>
  %target_bfloat_base = buffer.view %output[%base] : buffer -> view<24xbf16, align(1)>
  %target_integer_base = buffer.view %output[%base] : buffer -> view<24xi16, align(1)>
  %source_bfloat = view.subview %source_bfloat_base[8] : view<24xbf16, align(1)> -> view<8xbf16, align(1)>
  %source_integer = view.subview %source_integer_base[16] : view<24xi16, align(1)> -> view<8xi16, align(1)>
  %target_bfloat = view.subview %target_bfloat_base[8] : view<24xbf16, align(1)> -> view<8xbf16, align(1)>
  %target_integer = view.subview %target_integer_base[16] : view<24xi16, align(1)> -> view<8xi16, align(1)>
  %half = view.load %source_half[%position] : view<8xf16, align(1)> -> f16
  %bfloat = view.load %source_bfloat[%position] : view<8xbf16, align(1)> -> bf16
  %integer = view.load %source_integer[%position] : view<8xi16, align(1)> -> i16
  view.store %half, %target_half[%position] : f16, view<8xf16, align(1)>
  view.store %bfloat, %target_bfloat[%position] : bf16, view<8xbf16, align(1)>
  view.store %integer, %target_integer[%position] : i16, view<8xi16, align(1)>
  func.return
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @copy_word_index(%source_integer: reg<wasm.i32>, %target_integer: reg<wasm.i32>, %base: reg<wasm.i32>, %position: reg<wasm.i32>) asm {
  %23 = i32.const 2
  %24 = i32.mul %position, %23
  %25 = i32.add %base, %24
  %26 = i32.add %source_integer, %25
  %half = i32.load16_u %26
  %bfloat = i32.load16_u %26 {offset = 16}
  %integer = i32.load16_u %26 {offset = 32}
  %41 = i32.add %target_integer, %25
  i32.store16 %41, %half
  i32.store16 %41, %bfloat {offset = 16}
  i32.store16 %41, %integer {offset = 32}
  return
}

// ====

func.def @copy_word_stride(%input: buffer, %output: buffer, %column_count: index, %row_index: index, %column_index: index) {
  %columns = index.assume %column_count [range(%column_count, 1, 16)] : index
  %row = index.assume %row_index [range(%row_index, 0, 3)] : index
  %column = index.assume %column_index [range(%column_index, 0, 15), lt(%column_index, %columns)] : index
  %base = index.constant 3 : offset
  %source = buffer.view %input[%base] : buffer -> view<4x[%columns]xbf16, align(1)>
  %target = buffer.view %output[%base] : buffer -> view<4x[%columns]xbf16, align(1)>
  %value = view.load %source[%row, %column] : view<4x[%columns]xbf16, align(1)> -> bf16
  view.store %value, %target[%row, %column] : bf16, view<4x[%columns]xbf16, align(1)>
  func.return
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @copy_word_stride(%source: reg<wasm.i32>, %target: reg<wasm.i32>, %columns: reg<wasm.i32>, %row: reg<wasm.i32>, %column: reg<wasm.i32>) asm {
  %17 = i32.mul %row, %columns
  %18 = i32.const 2
  %19 = i32.mul %17, %18
  %21 = i32.mul %column, %18
  %22 = i32.add %19, %21
  %23 = i32.add %source, %22
  %value = i32.load16_u %23 {offset = 3}
  %31 = i32.add %target, %22
  i32.store16 %31, %value {offset = 3}
  return
}

// ====

func.def @copy_word_volatile(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<1xbf16>
  %target = buffer.view %output[%base] : buffer -> view<2xbf16>
  %first = view.load<volatile> %source[0] : view<1xbf16> -> bf16
  %second = view.load<volatile> %source[0] : view<1xbf16> -> bf16
  view.store<volatile> %first, %target[0] : bf16, view<2xbf16>
  view.store<volatile> %second, %target[1] : bf16, view<2xbf16>
  func.return
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @copy_word_volatile(%source: reg<wasm.i32>, %target: reg<wasm.i32>) asm {
  %first = i32.load16_u<volatile> %source
  %second = i32.load16_u<volatile> %source
  i32.store16<volatile> %target, %first
  i32.store16<volatile> %target, %second {offset = 2}
  return
}
