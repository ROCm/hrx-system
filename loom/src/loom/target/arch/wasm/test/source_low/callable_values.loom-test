// RUN: emit source-low target=wasm:simd128 output=low

func.def public @call_vector_result(%input: i32, %lane: index) -> (i32) where [range(%lane, 0, 3)] {
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %c3 = scalar.constant 3 : i32
  %values = vector.from_elements %input, %c1, %c2, %c3 : vector<4xi32>
  %result = func.call inline @select_lane(%values, %lane) : (vector<4xi32>, index) -> (i32)
  func.return %result : i32
}

func.def @select_lane(%values: vector<4xi32>, %lane: index) -> (i32) where [range(%lane, 0, 3)] {
  %result = vector.extract %values[%lane] : vector<4xi32> -> i32
  func.return %result : i32
}

// ----
low.func.def public target<wasm.core.simd128> abi(wasm_function) @call_vector_result(%input: reg<wasm.i32>, %lane: reg<wasm.i32>) -> (reg<wasm.i32>) where [range(%lane, 0, 3)] asm {
  %c1 = i32.const 1
  %c2 = i32.const 2
  %c3 = i32.const 3
  %28 = i32.eq %lane, %c1
  %29 = i32.select %c1, %input, %28
  %31 = i32.eq %lane, %c2
  %32 = i32.select %c2, %29, %31
  %34 = i32.eq %lane, %c3
  %result = i32.select %c3, %32, %34
  return %result
}

// ====

func.def public @call_scalar(%value: i32, %delta: i32) -> (i32) {
  %result = func.call @scalar_add(%value, %delta) : (i32, i32) -> (i32)
  func.return %result : i32
}

func.def @scalar_add(%value: i32, %delta: i32) -> (i32) {
  %result = scalar.addi %value, %delta : i32
  func.return %result : i32
}

// ----
low.func.def public target<wasm.core.simd128> abi(wasm_function) @call_scalar(%value: reg<wasm.i32>, %delta: reg<wasm.i32>) -> (reg<wasm.i32>) asm {
  %result = low.func.call pure @scalar_add(%value, %delta) : (reg<wasm.i32>, reg<wasm.i32>) -> (reg<wasm.i32>)
  return %result
}

low.func.def target<wasm.core.simd128> @scalar_add(%value: reg<wasm.i32>, %delta: reg<wasm.i32>) -> (reg<wasm.i32>) asm {
  %result = i32.add %value, %delta
  return %result
}

// ====

// Callable contracts retain argument and result identities across source-to-Low
// boundary mapping. Results are signature values rather than body-local values.
func.def public @preserve_contracts(%limit: index, %value: i32) -> (%bounded: index, %echo: i32) where [range(%limit, 1, 8), eq(%bounded, %limit), eq(%echo, %value)] {
  func.return %limit, %value : index, i32
}

// ----
low.func.def public target<wasm.core.simd128> abi(wasm_function) @preserve_contracts(%limit: reg<wasm.i32>, %value: reg<wasm.i32>) -> (%bounded: reg<wasm.i32>, %echo: reg<wasm.i32>) where [range(%limit, 1, 8), eq(%bounded, %limit), eq(%echo, %value)] asm {
  return %limit, %value
}

// ====

// A separately compiled definition must use the same signature as its caller's
// declaration. The declaration is resolved by IR linking, not a runtime import.
func.def public @call_external(%value: i32) -> (i32) {
  %result = func.call @increment(%value) : (i32) -> (i32)
  func.return %result : i32
}

func.decl @increment(%value: i32) -> (%result: i32) where [eq(%result, %value)]

// ----
low.func.def public target<wasm.core.simd128> abi(wasm_function) @call_external(%value: reg<wasm.i32>) -> (reg<wasm.i32>) asm {
  %result = low.func.call @increment(%value) : (reg<wasm.i32>) -> (reg<wasm.i32>)
  return %result
}

low.func.decl target<wasm.core.simd128> @increment(%value: reg<wasm.i32>) -> (%result: reg<wasm.i32>) where [eq(%result, %value)]
