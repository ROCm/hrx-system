wasm.target<simd128> @target

func.def target(@target) @pair_by_power_of_two(%input: i32) -> (i32, i32) {
  %divisor = scalar.constant 16 : i32
  %quotient = scalar.divui %input, %divisor : i32
  %remainder = scalar.remui %input, %divisor : i32
  func.return %quotient, %remainder : i32, i32
}

// ----
low.func.def target<wasm.core.simd128>(@target) abi(wasm_function) @pair_by_power_of_two(%input: reg<wasm.i32>) -> (reg<wasm.i32>, reg<wasm.i32>) asm {
  %13 = i32.const 4
  %quotient = i32.shr_u %input, %13
  %15 = i32.const 15
  %remainder = i32.and %input, %15
  return %quotient, %remainder
}

