// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_unsigned_constant_division.loom-test
// RUN: emit source-low target=wasm:simd128 output=low

func.def @quotient_by_three(%input: i32) -> (i32) {
  %divisor = scalar.constant 3 : i32
  // ERROR@+1: TARGET/001 {op_name="scalar.divui"}
  %quotient = scalar.divui %input, %divisor : i32
  func.return %quotient : i32
}

// ====

func.def @quotient_by_seven(%input: i32) -> (i32) {
  %divisor = scalar.constant 7 : i32
  // ERROR@+1: TARGET/001 {op_name="scalar.divui"}
  %quotient = scalar.divui %input, %divisor : i32
  func.return %quotient : i32
}

// ====

func.def @remainder_by_twenty(%input: i32) -> (i32) {
  %divisor = scalar.constant 20 : i32
  %remainder = scalar.remui %input, %divisor : i32
  func.return %remainder : i32
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @remainder_by_twenty(%input: reg<wasm.i32>) -> (reg<wasm.i32>) asm {
  %divisor = i32.const 20
  %remainder = i32.rem_u %input, %divisor
  return %remainder
}

