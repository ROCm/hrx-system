wasm.target<simd128> @target

func.def target(@target) @index_remainder_unproven_dividend(%value: index) -> (index) {
  %divisor = index.constant 3 : index
  // ERROR@+1: TARGET/005 {op_name="index.rem", subject_name="lhs", minimum="0", maximum="4294967295"}
  %remainder = index.rem %value, %divisor : index
  func.return %remainder : index
}

