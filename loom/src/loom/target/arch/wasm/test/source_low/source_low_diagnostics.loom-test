// ====

wasm.target<simd128> @target

// The function boundary owns carrier admission before any body operation can
// select a native descriptor or scalar reference recipe.
// ERROR@+1: TARGET/031 {op_name="func.def", type_constraint="vector.target_carrier"}
func.def target(@target) @unsupported_vector_carrier(%value: vector<8xi32>) {
  func.return
}

// ====

// RUN: with-checks compile-report target-legalize{mode=eager}

wasm.target<simd128> @target

// Structural reduction legalization must preserve the same boundary. Expanding
// this operation would hide the invalid callable carrier behind a much larger
// scalar program.
func.def target(@target) @unsupported_reduction_carrier(%values: vector<2x4xi32>, %init: vector<4xi32>) -> (vector<4xi32>) {
  %result = vector.reduce.axes<addi> %values, %init axes [0] : vector<2x4xi32>, vector<4xi32>
  func.return %result : vector<4xi32>
}

// ----
CHECK: COMPILE-REPORT: target_legalization legal=0 rewritten=0 scalarized=0 target_rewritten=0 reference_rewritten=0 deferred=0 invalid_ir=0 unsupported=0 unhandled=1 rows=1 *
CHECK: COMPILE-REPORT: target_legalization[0] function=unsupported_reduction_carrier source_op=vector.reduce.axes * action=unhandled outcome=unhandled * scalarized=false * created_ops=0 erased_ops=0

// ====

// RUN: with-checks compile-report target-legalize{mode=eager}

wasm.target<simd128> @target

// Wasm explicitly rejects the complete unmatched vector-cast family so the
// ordinary policy can select its shared lane-wise reference implementation.
func.def target(@target) @reference_vector_cast(%input: vector<4xf32>) {
  %rounded = vector.fptrunc %input : vector<4xf32> to vector<4xbf16>
  test.use %rounded : vector<4xbf16>
  func.return
}

// ----
CHECK: COMPILE-REPORT: target_legalization legal=0 rewritten=1 scalarized=1 target_rewritten=0 reference_rewritten=1 deferred=0 invalid_ir=0 unsupported=0 unhandled=0 rows=1 *
CHECK: COMPILE-REPORT: target_legalization[0] function=reference_vector_cast source_op=vector.fptrunc * action=rewritten outcome=reference-fallback contract=unsupported legalizer=vector strategy=reference * scalarized=true *

// ====

wasm.target<simd128> @target

func.def target(@target) @rejects_wasm32_address_overflow(%input: buffer, %i: index) -> (vector<4xi32>) {
  %bounded_i = index.assume %i [range(%i, 0, 1073741824)] : index
  %input_base = index.constant 0 : offset
  %input_view = buffer.view %input[%input_base] : buffer -> view<1073741828xi32>
  // ERROR@+1: WASM/006 {bit_count="32"}
  %loaded = vector.load %input_view[%bounded_i] : view<1073741828xi32> -> vector<4xi32>
  func.return %loaded : vector<4xi32>
}

