// RUN: emit source-low output=low

wasm.target<simd128> @target

func.def target(@target) @scalar_powf_rejected_by_math_policy(%base: f32, %exponent: f32) -> (f32) {
  // ERROR@+1: LOWERING/036 {op_name="scalar.powf", phase_name="legalize-math", policy_name="wasm-math", math_op="powf", lane_domain="scalar", element_type="f32", constraint_key="math.op.supported"}
  %result = scalar.powf<afn> %base, %exponent : f32
  func.return %result : f32
}

// ====

wasm.target<simd128> @target

func.def target(@target) @scalar_tanhf_rejected_by_math_policy(%input: f32) -> (f32) {
  // ERROR@+1: LOWERING/036 {op_name="scalar.tanhf", phase_name="legalize-math", policy_name="wasm-math", math_op="tanhf", lane_domain="scalar", element_type="f32", constraint_key="math.op.supported"}
  %result = scalar.tanhf<afn> %input : f32
  func.return %result : f32
}

// ====

// RUN: with-checks compile-report target-legalize{mode=complete}

wasm.target<simd128> @target

// Packed float narrowing is a native target contract and must remain legal
// through target legalization instead of selecting the scalar reference path.
func.def target(@target) @native_vector_cast(%input: vector<4xf32>) {
  %rounded = vector.fptrunc %input : vector<4xf32> to vector<4xbf16>
  test.use %rounded : vector<4xbf16>
  func.return
}

// ----
CHECK: COMPILE-REPORT: summary artifact=none status=OK *
CHECK-NOT: COMPILE-REPORT: target_legalization*

// ====

wasm.target<simd128> @target

func.def target(@target) @negative_index_offset(%input: index) -> (offset) {
  %negative = index.assume %input [range(%input, -7, -1)] : index
  // ERROR@+1: TARGET/005 {op_name="index.cast", subject_role="operand", subject_name="input", constraint_key="index_cast.offset_non_negative", minimum="0", maximum="9223372036854775807"}
  %result = index.cast %negative : index to offset
  func.return %result : offset
}

// ====

wasm.target<simd128> @target

func.def target(@target) @wide_offset_overflows_carrier(%input: i64) -> (offset) {
  %bounded = scalar.assume %input [range(%input, 0, 4294967296)] : i64
  // ERROR@+1: TARGET/005 {op_name="index.cast", subject_name="input", minimum="0", maximum="4294967295"}
  %offset = index.cast %bounded : i64 to offset
  func.return %offset : offset
}

// ====

wasm.target<simd128> @target

func.def target(@target) @wide_offset_rejects_negative(%input: i64) -> (offset) {
  %bounded = scalar.assume %input [range(%input, -1, 0)] : i64
  // ERROR@+1: TARGET/005 {op_name="index.cast", subject_name="input", constraint_key="index_cast.offset_non_negative"}
  %offset = index.cast %bounded : i64 to offset
  func.return %offset : offset
}

// ====

wasm.target<simd128> @target

// Twelve source packets require 126 Low operations and remain admissible. The
// next packet raises the complete native sequence to 147 operations, so the
// authored window is rejected before its store can trigger scalar fallback.
func.def target(@target) @materialized_window_exceeds_operation_limit(%packet: vector<16xi8>, %offset0: index, %output: buffer) {
  %offset = index.assume %offset0 [range(%offset0, 0, 80)] : index
  %source = vector.concat<0> %packet, %packet, %packet, %packet, %packet, %packet, %packet, %packet, %packet, %packet, %packet, %packet, %packet : vector<16xi8>, vector<16xi8>, vector<16xi8>, vector<16xi8>, vector<16xi8>, vector<16xi8>, vector<16xi8>, vector<16xi8>, vector<16xi8>, vector<16xi8>, vector<16xi8>, vector<16xi8>, vector<16xi8> -> vector<208xi8>
  // ERROR@+1: WASM/007 {op_name="vector.slice", required_operation_count="147", maximum_operation_count="128"}
  %window = vector.slice %source[%offset] : vector<208xi8> -> vector<128xi8>
  %base = index.constant 0 : offset
  %results = buffer.view %output[%base] : buffer -> view<128xi8>
  vector.store %window, %results[0] : vector<128xi8>, view<128xi8>
  func.return
}

// ====
// RUN: emit source-low output=low

wasm.target<simd128> @target

func.def target(@target) @view_origin_below_wasm32(%input: buffer) -> (view<1xi32>) {
  // ERROR@+1: WASM/003 {op_name="index.constant"}
  %origin = index.constant -2147483649 : index
  %view = buffer.view %input[%origin] : buffer -> view<1xi32>
  func.return %view : view<1xi32>
}
