// ====

wasm.target<simd128> @target

func.def target(@target) @offset_cast_result_cannot_prove_input(%input: offset) -> (index) {
  // ERROR@+1: TARGET/005 {op_name="index.cast", subject_name="input", minimum="0", maximum="2147483647"}
  %position = index.cast %input : offset to index
