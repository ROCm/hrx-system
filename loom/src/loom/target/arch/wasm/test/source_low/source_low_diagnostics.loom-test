wasm.target<simd128> @target

func.def target(@target) @offset_outside_signed_index(%input: offset) -> (index) {
  %wide = index.assume %input [range(%input, 2147483648, 4294967295)] : offset
  // ERROR@+1: TARGET/005 {op_name="index.cast", subject_name="input", minimum="0", maximum="2147483647"}
  %position = index.cast %wide : offset to index
