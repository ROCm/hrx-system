// ====

wasm.target<simd128> @target

func.def target(@target) @wide_offset_rejects_negative(%input: i64) -> (offset) {
  %bounded = scalar.assume %input [range(%input, -1, 0)] : i64
  // ERROR@+1: TARGET/005 {op_name="index.cast", subject_name="input", constraint_key="index_cast.offset_non_negative"}
  %offset = index.cast %bounded : i64 to offset
