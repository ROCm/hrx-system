  // ERROR@+1: LOWERING/036 {op_name="scalar.addf", element_type="f8E4M3"}
  %result = scalar.addf %lhs, %rhs : f8E4M3
  func.return %result : f8E4M3
}

// ====

wasm.target<simd128> @target

func.def target(@target) @negative_index_offset(%input: index) -> (offset) {
  %negative = index.assume %input [range(%input, -7, -1)] : index
  // ERROR@+1: TARGET/005 {op_name="index.cast", subject_role="operand", subject_name="input", constraint_key="index_cast.offset_non_negative", minimum="0", maximum="9223372036854775807"}
  %result = index.cast %negative : index to offset
  func.return %result : offset
}

