  %bounded = scalar.assume %input [range(%input, 0, 4294967296)] : i64
  // ERROR@+1: TARGET/005 {op_name="index.cast", subject_name="input", minimum="0", maximum="4294967295"}
  %offset = index.cast %bounded : i64 to offset
