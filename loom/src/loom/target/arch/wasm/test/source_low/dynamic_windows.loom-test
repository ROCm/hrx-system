// ====

func.def @materialized_predicate_window(%a: vector<16xi1>, %b: vector<16xi1>, %c: vector<16xi1>, %d: vector<16xi1>, %offset0: index) -> (vector<16xi8>) {
  %offset = index.assume %offset0 [range(%offset0, 0, 48)] : index
  %source = vector.concat<0> %a, %b, %c, %d : vector<16xi1>, vector<16xi1>, vector<16xi1>, vector<16xi1> -> vector<64xi1>
  %window = vector.slice %source[%offset] : vector<64xi1> -> vector<16xi1>
  %result = vector.extui %window : vector<16xi1> to vector<16xi8>
  func.return %result : vector<16xi8>
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @materialized_predicate_window(%a: reg<wasm.v128>, %b: reg<wasm.v128>, %c: reg<wasm.v128>, %d: reg<wasm.v128>, %offset: reg<wasm.i32>) -> (reg<wasm.v128>) asm {
  %26 = i32.const 15
  %27 = i32.and %offset, %26
  %28 = i8x16.splat %27
  %29 = v128.const 506097522914230528, 1084818905618843912
  %30 = i8x16.add %28, %29
  %31 = v128.const 1157442765409226768, 1157442765409226768
  %32 = i8x16.sub %30, %31
  %33 = v128.const 0, 0
  %34 = i32.const 0
  %35 = i32.const 16
  %36 = i32.ge_u %offset, %35
  %37 = i32.sub %34, %36
  %38 = i8x16.splat %37
  %39 = i32.const 32
  %40 = i32.ge_u %offset, %39
  %41 = i32.sub %34, %40
  %42 = i8x16.splat %41
  %43 = i32.const 48
  %44 = i32.ge_u %offset, %43
  %45 = i32.sub %34, %44
  %46 = i8x16.splat %45
  %50 = v128.bitselect %b, %a, %38
  %51 = v128.bitselect %c, %b, %38
  %53 = v128.bitselect %c, %50, %42
  %54 = v128.bitselect %d, %51, %42
  %55 = v128.bitselect %d, %53, %46
  %56 = v128.bitselect %33, %54, %46
  %57 = i8x16.swizzle %55, %30
  %58 = i8x16.swizzle %56, %32
  %window = v128.or %57, %58
  %60 = v128.const 72340172838076673, 72340172838076673
  %result = v128.and %window, %60
  return %result
}

// ====

// RUN: with-checks compile-report target-legalize{mode=final},source-to-low

wasm.target<simd128> @target

// The dynamic window remains one packet-tuple plan while its unsigned
// extension reaches the store as two native packets. Scalarization would
// replace these rows with a lane-proportional reference rewrite.
func.def target(@target) @materialized_predicate_window_report(%a: vector<16xi1>, %b: vector<16xi1>, %c: vector<16xi1>, %d: vector<16xi1>, %offset0: index, %output: buffer) {
  %offset = index.assume %offset0 [range(%offset0, 0, 32)] : index
  %source = vector.concat<0> %a, %b, %c, %d : vector<16xi1>, vector<16xi1>, vector<16xi1>, vector<16xi1> -> vector<64xi1>
  %window = vector.slice %source[%offset] : vector<64xi1> -> vector<32xi1>
  %result = vector.extui %window : vector<32xi1> to vector<32xi8>
  %base = index.constant 0 : offset
  %results = buffer.view %output[%base] : buffer -> view<32xi8>
  vector.store %result, %results[0] : vector<32xi8>, view<32xi8>
  func.return
}

// ----
CHECK: COMPILE-REPORT: target_legalization * scalarized=0 *
CHECK: COMPILE-REPORT: source_low[*] function=materialized_predicate_window_report source_op=vector.slice selection=plan plan_key=slice.dynamic-v128-packets emitted_ops=36
CHECK-COUNT-2: COMPILE-REPORT: source_low[*] function=materialized_predicate_window_report source_op=vector.extui selection=plan plan_key=predicate.extend-unsigned.v128-packets emitted_ops=2
CHECK-NOT: scalarized=true

// ====

// Runtime packet selection over scalar-authored register values stays in SSA
// while the target legalizes the oversized source carrier.
func.def @from_elements_packet_window(%offset0: index, %v0: i32, %v1: i32, %v2: i32, %v3: i32, %v4: i32, %v5: i32, %v6: i32, %v7: i32, %v8: i32, %v9: i32, %v10: i32, %v11: i32, %v12: i32, %v13: i32, %v14: i32, %v15: i32) -> (vector<4xi32>) {
  %offset = index.assume %offset0 [range(%offset0, 0, 12), multiple_of(%offset0, 4)] : index
  %source = vector.from_elements %v0, %v1, %v2, %v3, %v4, %v5, %v6, %v7, %v8, %v9, %v10, %v11, %v12, %v13, %v14, %v15 : vector<16xi32>
  %window = vector.slice %source[%offset] : vector<16xi32> -> vector<4xi32>
  func.return %window : vector<4xi32>
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @from_elements_packet_window(%offset: reg<wasm.i32>, %v0: reg<wasm.i32>, %v1: reg<wasm.i32>, %v2: reg<wasm.i32>, %v3: reg<wasm.i32>, %v4: reg<wasm.i32>, %v5: reg<wasm.i32>, %v6: reg<wasm.i32>, %v7: reg<wasm.i32>, %v8: reg<wasm.i32>, %v9: reg<wasm.i32>, %v10: reg<wasm.i32>, %v11: reg<wasm.i32>, %v12: reg<wasm.i32>, %v13: reg<wasm.i32>, %v14: reg<wasm.i32>, %v15: reg<wasm.i32>) -> (reg<wasm.v128>) asm {
  %68 = i32x4.splat %v0
  %69 = i32x4.replace_lane %68, %v1, 1
  %70 = i32x4.replace_lane %69, %v2, 2
  %71 = i32x4.replace_lane %70, %v3, 3
  %72 = i32x4.splat %v4
  %73 = i32x4.replace_lane %72, %v5, 1
  %74 = i32x4.replace_lane %73, %v6, 2
  %75 = i32x4.replace_lane %74, %v7, 3
  %76 = i32.const 4
  %77 = i32.eq %offset, %76
  %78 = v128.select %75, %71, %77
  %79 = i32x4.splat %v8
  %80 = i32x4.replace_lane %79, %v9, 1
  %81 = i32x4.replace_lane %80, %v10, 2
  %82 = i32x4.replace_lane %81, %v11, 3
  %83 = i32.const 8
  %84 = i32.eq %offset, %83
  %85 = v128.select %82, %78, %84
  %86 = i32x4.splat %v12
  %87 = i32x4.replace_lane %86, %v13, 1
  %88 = i32x4.replace_lane %87, %v14, 2
  %89 = i32x4.replace_lane %88, %v15, 3
  %90 = i32.const 12
  %91 = i32.eq %offset, %90
  %window = v128.select %89, %85, %91
  return %window
}
