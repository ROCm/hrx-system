low.func.def target<wasm.core.simd128> abi(wasm_function) @materialized_bf16_window(%lhs: reg<wasm.v128>, %rhs: reg<wasm.v128>, %offset: reg<wasm.i32>) -> (reg<wasm.v128>) asm {
  %12 = i32.const 2
  %13 = i32.mul %offset, %12
  %14 = i32.const 15
  %15 = i32.and %13, %14
  %16 = i8x16.splat %15
  %17 = v128.const 506097522914230528, 1084818905618843912
  %18 = i8x16.add %16, %17
  %19 = v128.const 1157442765409226768, 1157442765409226768
  %20 = i8x16.sub %18, %19
  %21 = v128.const 0, 0
  %22 = i32.const 0
  %23 = i32.const 16
  %24 = i32.ge_u %13, %23
  %25 = i32.sub %22, %24
  %26 = i8x16.splat %25
  %29 = v128.bitselect %rhs, %lhs, %26
  %30 = v128.bitselect %21, %rhs, %26
  %31 = i8x16.swizzle %29, %18
  %32 = i8x16.swizzle %30, %20
  %result = v128.or %31, %32
  return %result
}

