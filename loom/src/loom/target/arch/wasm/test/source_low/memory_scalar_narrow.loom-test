// TEMPLATE: loom/src/loom/test/corpus/source_low/memory_scalar_narrow.loom-test
// RUN: emit source-low target=wasm:simd128 output=low

func.def @copy_narrow_static(%input: buffer, %output: buffer) {
  %byte_base = index.constant 0 : offset
  %word_base = index.constant 1 : offset
  %source_bytes = buffer.view %input[%byte_base] : buffer -> view<8xi8>
  %source_words = buffer.view %input[%word_base] : buffer -> view<4xi16>
  %destination_bytes = buffer.view %output[%byte_base] : buffer -> view<8xi8>
  %destination_words = buffer.view %output[%word_base] : buffer -> view<4xi16>
  %byte = view.load %source_bytes[3] : view<8xi8> -> i8
  %word = view.load %source_words[2] : view<4xi16> -> i16
  view.store %byte, %destination_bytes[3] : i8, view<8xi8>
  view.store %word, %destination_words[2] : i16, view<4xi16>
  func.return
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @copy_narrow_static(%source_words: reg<wasm.i32>, %destination_words: reg<wasm.i32>) asm {
  %byte = i32.load8_u %source_words {offset = 3}
  %word = i32.load16_u %source_words {offset = 5}
  i32.store8 %destination_words, %byte {offset = 3}
  i32.store16 %destination_words, %word {offset = 5}
  return
}

// ====

func.def @copy_narrow_index(%input: buffer, %output: buffer, %element: index) {
  %position = index.assume %element [range(%element, 0, 15)] : index
  %byte_base = index.constant 1 : offset
  %word_base = index.constant 33 : offset
  %source_bytes = buffer.view %input[%byte_base] : buffer -> view<16xi8>
  %source_words = buffer.view %input[%word_base] : buffer -> view<16xi16>
  %destination_bytes = buffer.view %output[%byte_base] : buffer -> view<16xi8>
  %destination_words = buffer.view %output[%word_base] : buffer -> view<16xi16>
  %byte = view.load %source_bytes[%position] : view<16xi8> -> i8
  %word = view.load %source_words[%position] : view<16xi16> -> i16
  view.store %byte, %destination_bytes[%position] : i8, view<16xi8>
  view.store %word, %destination_words[%position] : i16, view<16xi16>
  func.return
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @copy_narrow_index(%source_words: reg<wasm.i32>, %destination_words: reg<wasm.i32>, %position: reg<wasm.i32>) asm {
  %15 = i32.add %source_words, %position
  %byte = i32.load8_u %15 {offset = 1}
  %17 = i32.const 2
  %18 = i32.mul %position, %17
  %19 = i32.add %source_words, %18
  %word = i32.load16_u %19 {offset = 33}
  %21 = i32.add %destination_words, %position
  i32.store8 %21, %byte {offset = 1}
  %24 = i32.add %destination_words, %18
  i32.store16 %24, %word {offset = 33}
  return
}

// ====

func.def @copy_narrow_origin(%input: buffer, %output: buffer, %byte_offset: offset, %element: index) {
  %base = index.assume %byte_offset [range(%byte_offset, 0, 128)] : offset
  %position = index.assume %element [range(%element, 0, 15)] : index
  %prefix = index.constant 33 : offset
  %word_base = index.add %base, %prefix : offset
  %source_bytes = buffer.view %input[%base] : buffer -> view<16xi8>
  %source_words = buffer.view %input[%word_base] : buffer -> view<16xi16>
  %destination_bytes = buffer.view %output[%base] : buffer -> view<16xi8>
  %destination_words = buffer.view %output[%word_base] : buffer -> view<16xi16>
  %byte = view.load<volatile> %source_bytes[%position] : view<16xi8> -> i8
  %word = view.load<volatile> %source_words[%position] : view<16xi16> -> i16
  view.store<volatile> %byte, %destination_bytes[%position] : i8, view<16xi8>
  view.store<volatile> %word, %destination_words[%position] : i16, view<16xi16>
  func.return
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @copy_narrow_origin(%source_words: reg<wasm.i32>, %destination_words: reg<wasm.i32>, %base: reg<wasm.i32>, %position: reg<wasm.i32>) asm {
  %18 = i32.add %base, %position
  %19 = i32.add %source_words, %18
  %byte = i32.load8_u<volatile> %19
  %21 = i32.const 2
  %22 = i32.mul %position, %21
  %23 = i32.add %base, %22
  %24 = i32.add %source_words, %23
  %word = i32.load16_u<volatile> %24 {offset = 33}
  %27 = i32.add %destination_words, %18
  i32.store8<volatile> %27, %byte
  %31 = i32.add %destination_words, %23
  i32.store16<volatile> %31, %word {offset = 33}
  return
}

// ====

func.def @copy_narrow_stride(%input: buffer, %output: buffer, %column_count: index, %row_index: index, %column_index: index) {
  %columns = index.assume %column_count [range(%column_count, 1, 16)] : index
  %row = index.assume %row_index [range(%row_index, 0, 3)] : index
  %column = index.assume %column_index [range(%column_index, 0, 15), lt(%column_index, %columns)] : index
  %byte_base = index.constant 1 : offset
  %word_base = index.constant 65 : offset
  %source_bytes = buffer.view %input[%byte_base] : buffer -> view<4x[%columns]xi8>
  %source_words = buffer.view %input[%word_base] : buffer -> view<4x[%columns]xi16>
  %destination_bytes = buffer.view %output[%byte_base] : buffer -> view<4x[%columns]xi8>
  %destination_words = buffer.view %output[%word_base] : buffer -> view<4x[%columns]xi16>
  %byte = view.load %source_bytes[%row, %column] : view<4x[%columns]xi8> -> i8
  %word = view.load %source_words[%row, %column] : view<4x[%columns]xi16> -> i16
  view.store %byte, %destination_bytes[%row, %column] : i8, view<4x[%columns]xi8>
  view.store %word, %destination_words[%row, %column] : i16, view<4x[%columns]xi16>
  func.return
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @copy_narrow_stride(%source_words: reg<wasm.i32>, %destination_words: reg<wasm.i32>, %columns: reg<wasm.i32>, %row: reg<wasm.i32>, %column: reg<wasm.i32>) asm {
  %21 = i32.mul %row, %columns
  %22 = i32.add %21, %column
  %23 = i32.add %source_words, %22
  %byte = i32.load8_u %23 {offset = 1}
  %26 = i32.const 2
  %27 = i32.mul %21, %26
  %29 = i32.mul %column, %26
  %30 = i32.add %27, %29
  %31 = i32.add %source_words, %30
  %word = i32.load16_u %31 {offset = 65}
  %35 = i32.add %destination_words, %22
  i32.store8 %35, %byte {offset = 1}
  %42 = i32.add %destination_words, %30
  i32.store16 %42, %word {offset = 65}
  return
}

// ====

func.def @exchange_narrow(%buffer: buffer, %byte_value: i8, %word_value: i16) -> (i32, i32) {
  %byte_base = index.constant 0 : offset
  %word_base = index.constant 1 : offset
  %bytes = buffer.view %buffer[%byte_base] : buffer -> view<1xi8>
  %words = buffer.view %buffer[%word_base] : buffer -> view<1xi16>
  %previous_byte = view.load %bytes[0] : view<1xi8> -> i8
  %previous_word = view.load %words[0] : view<1xi16> -> i16
  view.store %byte_value, %bytes[0] : i8, view<1xi8>
  view.store %word_value, %words[0] : i16, view<1xi16>
  %byte_bits = scalar.extui %previous_byte : i8 to i32
  %word_bits = scalar.extui %previous_word : i16 to i32
  func.return %byte_bits, %word_bits : i32, i32
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @exchange_narrow(%words: reg<wasm.i32>, %byte_value: reg<wasm.i32>, %word_value: reg<wasm.i32>) -> (reg<wasm.i32>, reg<wasm.i32>) asm {
  %previous_byte = i32.load8_u %words
  %previous_word = i32.load16_u %words {offset = 1}
  i32.store8 %words, %byte_value
  i32.store16 %words, %word_value {offset = 1}
  %20 = i32.const 255
  %byte_bits = i32.and %previous_byte, %20
  %22 = i32.const 65535
  %word_bits = i32.and %previous_word, %22
  return %byte_bits, %word_bits
}
