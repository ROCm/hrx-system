// RUN: emit source-low output=low control-flow=structured-low

wasm.target<simd128> @target

func.def target(@target) @copy(%source: buffer, %source_offset: offset, %target: buffer, %target_offset: offset, %byte_length: offset) {
  buffer.copy %source[%source_offset], %target[%target_offset], %byte_length
  func.return
}

// ----
low.func.def target<wasm.core.simd128>(@target) abi(wasm_function) @copy(%source: reg<wasm.i32>, %source_offset: reg<wasm.i32>, %target: reg<wasm.i32>, %target_offset: reg<wasm.i32>, %byte_length: reg<wasm.i32>) asm {
  %59 = i32.const 0
  %60 = i32.const -16
  %61 = i32.and %byte_length, %60
  %62 = i32.const 16
  low.scf.for unsigned [%59 to %61 step %62] do(%63: reg<wasm.i32>) {
    %64 = i32.add %source_offset, %63
    %65 = i32.add %source, %64
    %66 = v128.load %65
    %67 = i32.add %target_offset, %63
    %68 = i32.add %target, %67
    v128.store %68, %66
  }
  %69 = i32.const -8
  %70 = i32.and %byte_length, %69
  %71 = i32.lt_u %61, %70
  low.scf.if %71 {
    %72 = i32.add %source_offset, %61
    %73 = i32.add %source, %72
    %74 = i64.load %73
    %75 = i32.add %target_offset, %61
    %76 = i32.add %target, %75
    i64.store %76, %74
  }
  %77 = i32.const -4
  %78 = i32.and %byte_length, %77
  %79 = i32.lt_u %70, %78
  low.scf.if %79 {
    %80 = i32.add %source_offset, %70
    %81 = i32.add %source, %80
    %82 = i32.load %81
    %83 = i32.add %target_offset, %70
    %84 = i32.add %target, %83
    i32.store %84, %82
  }
  %85 = i32.const -2
  %86 = i32.and %byte_length, %85
  %87 = i32.lt_u %78, %86
  low.scf.if %87 {
    %88 = i32.add %source_offset, %78
    %89 = i32.add %source, %88
    %90 = i32.load16_u %89
    %91 = i32.add %target_offset, %78
    %92 = i32.add %target, %91
    i32.store16 %92, %90
  }
  %93 = i32.lt_u %86, %byte_length
  low.scf.if %93 {
    %94 = i32.add %source_offset, %86
    %95 = i32.add %source, %94
    %96 = i32.load8_u %95
    %97 = i32.add %target_offset, %86
    %98 = i32.add %target, %97
    i32.store8 %98, %96
  }
  return
}

