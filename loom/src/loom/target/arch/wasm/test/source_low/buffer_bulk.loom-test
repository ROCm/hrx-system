// RUN: with-checks emit source-low output=low control-flow=structured-low

wasm.target<simd128> @target

func.def target(@target) @copy(%source: buffer, %source_offset: offset, %target: buffer, %target_offset: offset, %byte_length: offset) {
  buffer.copy %source[%source_offset], %target[%target_offset], %byte_length
  func.return
}

// ----
CHECK: low.scf.for unsigned [* to %byte_length step *] do(*) {
CHECK: %* = i32.load8_u %*
CHECK: i32.store8 %*, %*
CHECK-NOT: low.br *
CHECK-NOT: low.cond_br *

// ====

wasm.target<simd128> @target

func.def target(@target) @fill_f32(%pattern: f32, %target: buffer, %target_offset: offset, %byte_length: offset) {
  buffer.fill %pattern, %target[%target_offset], %byte_length : f32
  func.return
}

// ----
CHECK: %* = i32.reinterpret_f32 %pattern
CHECK: %* = low.scf.for unsigned [* to %byte_length step *] iter_args(*) -> (reg<wasm.i32>) do(*) {
CHECK: i32.store8 %*, %*
CHECK: %* = i32.shr_u %*, %*
CHECK: %* = i32.shl %*, %*
CHECK: low.scf.yield %* : reg<wasm.i32>
CHECK-NOT: low.br *
CHECK-NOT: low.cond_br *

// ====

wasm.target<simd128> @target

func.def target(@target) @fill_f8(%pattern: f8E4M3, %target: buffer, %target_offset: offset, %byte_length: offset) {
  buffer.fill %pattern, %target[%target_offset], %byte_length : f8E4M3
  func.return
}

// ----
CHECK: %* = i32.const 255
CHECK: %* = i32.and %pattern, %*
CHECK: low.scf.for unsigned [* to %byte_length step *] do(*) {
CHECK: i32.store8 %*, %*
CHECK-NOT: low.br *
CHECK-NOT: low.cond_br *

// ====

wasm.target<simd128> @target

func.def target(@target) @fill_bf16(%pattern: bf16, %target: buffer, %target_offset: offset, %byte_length: offset) {
  buffer.fill %pattern, %target[%target_offset], %byte_length : bf16
  func.return
}

// ----
CHECK: %* = i32.const 65535
CHECK: %* = i32.and %pattern, %*
CHECK: %* = low.scf.for unsigned [* to %byte_length step *] iter_args(*) -> (reg<wasm.i32>) do(*) {
CHECK: i32.store8 %*, %*
CHECK: low.scf.yield %* : reg<wasm.i32>
CHECK-NOT: low.br *
CHECK-NOT: low.cond_br *

// ====

wasm.target<simd128> @target

func.def target(@target) @fill_f64(%pattern: f64, %target: buffer, %target_offset: offset, %byte_length: offset) {
  buffer.fill %pattern, %target[%target_offset], %byte_length : f64
  func.return
}

// ----
CHECK: %* = i64.reinterpret_f64 %pattern
CHECK: %* = low.scf.for unsigned [* to %byte_length step *] iter_args(*) -> (reg<wasm.i64>) do(*) {
CHECK: %* = i32.wrap_i64 %*
CHECK: i32.store8 %*, %*
CHECK: low.scf.yield %* : reg<wasm.i64>
CHECK-NOT: low.br *
CHECK-NOT: low.cond_br *

// ====

wasm.target<simd128> @target

func.def target(@target) @compare(%lhs: buffer, %lhs_offset: offset, %rhs: buffer, %rhs_offset: offset, %byte_length: offset) -> (i32) {
  %order = buffer.compare %lhs[%lhs_offset], %rhs[%rhs_offset], %byte_length
  func.return %order : i32
}

// ----
CHECK: %*, %order = low.scf.while(*) -> (reg<wasm.i32>, reg<wasm.i32>) {
CHECK: low.scf.condition %*, %*, %* : reg<wasm.i32>, reg<wasm.i32>, reg<wasm.i32>
CHECK: %* = i32.load8_u %*
CHECK: %* = i32.select %*, %*, %*
CHECK: return %order
CHECK-NOT: low.br *
CHECK-NOT: low.cond_br *
