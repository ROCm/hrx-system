// TEMPLATE: loom/src/loom/test/corpus/source_low/memory_source_address_domain.loom-test
// RUN: emit source-low target=wasm:simd128 output=low

func.def @source_address_domain_static_coordinate(%input: buffer, %origin: offset) -> (i32) {
  %source = buffer.view %input[%origin] address_bits(32) : buffer -> view<4x8xi32>
  %loaded = view.load %source[3, 7] : view<4x8xi32> -> i32
  func.return %loaded : i32
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @source_address_domain_static_coordinate(%source: reg<wasm.i32>, %origin: reg<wasm.i32>) -> (reg<wasm.i32>) asm {
  %10 = i32.const 124
  %11 = i32.add %origin, %10
  %12 = i32.add %source, %11
  %loaded = i32.load %12
  return %loaded
}

// ====

func.def @source_address_domain_derived_view(%input: buffer, %origin: offset, %columns: index) -> (i32) {
  %bounded_columns = index.assume %columns [range(%columns, 4, 8)] : index
  %source = buffer.view %input[%origin] address_bits(32) : buffer -> view<4x[%bounded_columns]xi32>
  %row = view.subview %source[1, 0] : view<4x[%bounded_columns]xi32> -> view<1x[%bounded_columns]xi32>
  %prefix = view.refine %row : view<1x[%bounded_columns]xi32> -> view<1x4xi32>
  %loaded = view.load %prefix[0, 3] : view<1x4xi32> -> i32
  func.return %loaded : i32
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @source_address_domain_derived_view(%prefix: reg<wasm.i32>, %origin: reg<wasm.i32>, %bounded_columns: reg<wasm.i32>) -> (reg<wasm.i32>) asm {
  %13 = i32.const 12
  %14 = i32.const 4
  %15 = i32.mul %bounded_columns, %14
  %16 = i32.add %origin, %15
  %17 = i32.add %16, %13
  %18 = i32.add %prefix, %17
  %loaded = i32.load %18
  return %loaded
}
