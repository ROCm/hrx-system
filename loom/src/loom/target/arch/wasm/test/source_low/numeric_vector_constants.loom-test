  %minimum = v128.const -9223372036854775808, -9223372036854775808
  v128.store %view, %minimum {offset = 80}
  %maximum = v128.const 9223372036854775807, 9223372036854775807
  v128.store %view, %maximum {offset = 96}
  %folded = v128.const -1, -1
  v128.store %view, %folded {offset = 112}
  return
}

