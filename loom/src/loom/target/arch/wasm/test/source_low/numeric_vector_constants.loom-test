// ====

// A dynamic whole-vector choice keeps both constant masks live. Numeric payload
// selection observes every mask bit, and scalar consumers observe logical 0/1.
func.def @vector_constants_predicate(%output: buffer, %condition: i1, %true_payload: i32, %false_payload: i32) -> (i32, i32) {
  %base = index.constant 0 : offset
  %view = buffer.view %output[%base] : buffer -> view<4xi32>
  %off = vector.constant false : vector<4xi1>
  %scalar = scalar.constant true : i1
  %on = vector.splat %scalar : vector<4xi1>
  %mask = scf.select %condition, %on, %off : vector<4xi1>
  %true_values = vector.splat %true_payload : vector<4xi32>
  %false_values = vector.splat %false_payload : vector<4xi32>
  %payload = vector.select %mask, %true_values, %false_values : vector<4xi32>
  vector.store %payload, %view[0] : vector<4xi32>, view<4xi32>
  %first = vector.extract %mask[0] : vector<4xi1> -> i1
  %last = vector.extract %mask[3] : vector<4xi1> -> i1
  %signed = scalar.extsi %first : i1 to i32
  %unsigned = scalar.extui %last : i1 to i32
  func.return %signed, %unsigned : i32, i32
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @vector_constants_predicate(%view: reg<wasm.i32>, %condition: reg<wasm.i32>, %true_payload: reg<wasm.i32>, %false_payload: reg<wasm.i32>) -> (reg<wasm.i32>, reg<wasm.i32>) asm {
  %off = v128.const 0, 0
  %on = v128.const -1, -1
  %mask = v128.select %on, %off, %condition
  %true_values = i32x4.splat %true_payload
  %false_values = i32x4.splat %false_payload
  %payload = v128.bitselect %true_values, %false_values, %mask
  v128.store %view, %payload
  %35 = i32x4.extract_lane %mask, 0
  %36 = i32.const 1
  %first = i32.and %35, %36
  %38 = i32x4.extract_lane %mask, 3
  %unsigned = i32.and %38, %36
  %41 = i32.const -1
  %42 = i32.const 0
  %signed = i32.select %41, %42, %first
  return %signed, %unsigned
}

// ====

// Keep independent lane bits through native f64 memory and vector selection.
func.def @vector_constants_f64_select(%input: buffer, %output: buffer, %condition: i1) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<2xf64>
  %output_view = buffer.view %output[%base] : buffer -> view<2xf64>
  %input_values = vector.load %input_view[0] : view<2xf64> -> vector<2xf64>
  %cn0 = vector.constant -0.0 : vector<2xf64>
  %selected = scf.select %condition, %cn0, %input_values : vector<2xf64>
  vector.store %selected, %output_view[0] : vector<2xf64>, view<2xf64>
  func.return
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @vector_constants_f64_select(%input_view: reg<wasm.i32>, %output_view: reg<wasm.i32>, %condition: reg<wasm.i32>) asm {
  %input_values = v128.load %input_view
  %cn0 = v128.const -9223372036854775808, -9223372036854775808
  %selected = v128.select %cn0, %input_values, %condition
  v128.store %output_view, %selected
  return
}
