low.func.def target<wasm.core.simd128> abi(wasm_function) @vector_constants_i64(%view: reg<wasm.i32>) asm {
  %c0 = v128.const 0, 0
  v128.store %view, %c0
  %c1 = v128.const 1, 1
  v128.store %view, %c1 {offset = 16}
  %low_word = v128.const 4294967295, 4294967295
  v128.store %view, %low_word {offset = 32}
  %high_word = v128.const -4294967296, -4294967296
  v128.store %view, %high_word {offset = 48}
  %both_words = v128.const -9223372036854775807, -9223372036854775807
