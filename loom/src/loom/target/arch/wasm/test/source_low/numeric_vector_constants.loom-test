func.def @vector_constants_f32(%output: buffer) {
  %base = index.constant 0 : offset
  %view = buffer.view %output[%base] : buffer -> view<36xf32>
  %c0 = vector.constant 0.0 : vector<4xf32>
  vector.store %c0, %view[0] : vector<4xf32>, view<36xf32>
  %cn0 = vector.constant -0.0 : vector<4xf32>
  vector.store %cn0, %view[4] : vector<4xf32>, view<36xf32>
  %fraction = vector.constant -1.1000000000000001 : vector<4xf32>
  vector.store %fraction, %view[8] : vector<4xf32>, view<36xf32>
  %subnormal = vector.constant 1.4012984643248171e-45 : vector<4xf32>
  vector.store %subnormal, %view[12] : vector<4xf32>, view<36xf32>
  %normal = vector.constant 1.1754943508222875e-38 : vector<4xf32>
  vector.store %normal, %view[16] : vector<4xf32>, view<36xf32>
  %positive_infinity = vector.constant inf : vector<4xf32>
  vector.store %positive_infinity, %view[20] : vector<4xf32>, view<36xf32>
  %negative_infinity = vector.constant -inf : vector<4xf32>
  vector.store %negative_infinity, %view[24] : vector<4xf32>, view<36xf32>
  %nan = vector.constant nan : vector<4xf32>
  vector.store %nan, %view[28] : vector<4xf32>, view<36xf32>
  // Normal folding must preserve native support for a constant splat.
  %scalar = scalar.constant 1.0000000596046448 : f32
  %folded = vector.splat %scalar : vector<4xf32>
  vector.store %folded, %view[32] : vector<4xf32>, view<36xf32>
  func.return
}

