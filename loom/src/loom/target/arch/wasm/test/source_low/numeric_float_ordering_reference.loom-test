// F64 extrema use the same exact scalar recipe with an I64 tie carrier.
func.def @scalar_f64_reference_extrema(%value: f64, %lhs: f64, %rhs: f64) -> (f64, f64, f64, f64, f64) {
  %minnum = scalar.minnumf %lhs, %rhs : f64
  %maxnum = scalar.maxnumf %lhs, %rhs : f64
  %ordered = scalar.clampf<ordered> %value, %lhs, %rhs : f64
  %number = scalar.clampf<number> %value, %lhs, %rhs : f64
  %ieee = scalar.clampf<ieee> %value, %lhs, %rhs : f64
  func.return %minnum, %maxnum, %ordered, %number, %ieee : f64, f64, f64, f64, f64
}

