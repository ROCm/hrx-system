// RUN: pass target=wasm:simd128 target-legalize{mode=final}

func.def @scalar_f32_reference_extrema(%value: f32, %lhs: f32, %rhs: f32) -> (f32, f32, f32, f32, f32) {
  %minnum = scalar.minnumf %lhs, %rhs : f32
  %maxnum = scalar.maxnumf %lhs, %rhs : f32
  %ordered = scalar.clampf<ordered> %value, %lhs, %rhs : f32
  %number = scalar.clampf<number> %value, %lhs, %rhs : f32
  %ieee = scalar.clampf<ieee> %value, %lhs, %rhs : f32
  func.return %minnum, %maxnum, %ordered, %number, %ieee : f32, f32, f32, f32, f32
}

// ----
func.def @scalar_f32_reference_extrema(%value: f32, %lhs: f32, %rhs: f32) -> (f32, f32, f32, f32, f32) {
  %61 = scalar.bitcast %lhs : f32 to i32
  %62 = scalar.bitcast %rhs : f32 to i32
  %63 = scalar.ori %61, %62 : i32
  %64 = scalar.bitcast %63 : i32 to f32
  %65 = scalar.cmpf olt, %lhs, %rhs : f32
  %66 = scalar.cmpf olt, %rhs, %lhs : f32
  %67 = scf.select %66, %rhs, %64 : f32
  %68 = scf.select %65, %lhs, %67 : f32
  %69 = scalar.cmpf une, %lhs, %lhs : f32
  %70 = scalar.cmpf une, %rhs, %rhs : f32
  %71 = scalar.constant nan : f32
  %72 = scf.select %70, %71, %rhs : f32
  %73 = scf.select %70, %lhs, %68 : f32
  %minnum = scf.select %69, %72, %73 : f32
  %47 = scalar.bitcast %lhs : f32 to i32
  %48 = scalar.bitcast %rhs : f32 to i32
  %49 = scalar.andi %47, %48 : i32
  %50 = scalar.bitcast %49 : i32 to f32
  %51 = scalar.cmpf ogt, %lhs, %rhs : f32
  %52 = scalar.cmpf ogt, %rhs, %lhs : f32
  %53 = scf.select %52, %rhs, %50 : f32
  %54 = scf.select %51, %lhs, %53 : f32
  %55 = scalar.cmpf une, %lhs, %lhs : f32
  %56 = scalar.cmpf une, %rhs, %rhs : f32
  %57 = scalar.constant nan : f32
  %58 = scf.select %56, %57, %rhs : f32
  %59 = scf.select %56, %lhs, %54 : f32
  %maxnum = scf.select %55, %58, %59 : f32
  %43 = scalar.cmpf olt, %value, %lhs : f32
  %44 = scf.select %43, %lhs, %value : f32
  %45 = scalar.cmpf ogt, %44, %rhs : f32
  %ordered = scf.select %45, %rhs, %44 : f32
  %15 = scalar.bitcast %value : f32 to i32
  %16 = scalar.bitcast %lhs : f32 to i32
  %17 = scalar.andi %15, %16 : i32
  %18 = scalar.bitcast %17 : i32 to f32
  %19 = scalar.cmpf ogt, %value, %lhs : f32
  %20 = scalar.cmpf ogt, %lhs, %value : f32
  %21 = scf.select %20, %lhs, %18 : f32
  %22 = scf.select %19, %value, %21 : f32
  %23 = scalar.cmpf une, %value, %value : f32
  %24 = scalar.cmpf une, %lhs, %lhs : f32
  %25 = scalar.constant nan : f32
  %26 = scf.select %24, %25, %lhs : f32
  %27 = scf.select %24, %value, %22 : f32
  %28 = scf.select %23, %26, %27 : f32
  %29 = scalar.bitcast %28 : f32 to i32
  %30 = scalar.bitcast %rhs : f32 to i32
  %31 = scalar.ori %29, %30 : i32
  %32 = scalar.bitcast %31 : i32 to f32
  %33 = scalar.cmpf olt, %28, %rhs : f32
  %34 = scalar.cmpf olt, %rhs, %28 : f32
  %35 = scf.select %34, %rhs, %32 : f32
  %36 = scf.select %33, %28, %35 : f32
  %37 = scalar.cmpf une, %28, %28 : f32
  %38 = scalar.cmpf une, %rhs, %rhs : f32
  %39 = scalar.constant nan : f32
  %40 = scf.select %38, %39, %rhs : f32
  %41 = scf.select %38, %28, %36 : f32
  %number = scf.select %37, %40, %41 : f32
  %13 = scalar.maximumf %value, %lhs : f32
  %ieee = scalar.minimumf %13, %rhs : f32
  func.return %minnum, %maxnum, %ordered, %number, %ieee : f32, f32, f32, f32, f32
}

