  %15 = vector.bitcast %value : vector<4xf32> to vector<4xi32>
  %16 = vector.bitcast %lhs : vector<4xf32> to vector<4xi32>
  %17 = vector.andi %15, %16 : vector<4xi32>
  %18 = vector.bitcast %17 : vector<4xi32> to vector<4xf32>
  %19 = vector.cmpf ogt, %value, %lhs : vector<4xf32> -> vector<4xi1>
  %20 = vector.cmpf ogt, %lhs, %value : vector<4xf32> -> vector<4xi1>
  %21 = vector.select %20, %lhs, %18 : vector<4xf32>
  %22 = vector.select %19, %value, %21 : vector<4xf32>
  %23 = vector.cmpf une, %value, %value : vector<4xf32> -> vector<4xi1>
  %24 = vector.cmpf une, %lhs, %lhs : vector<4xf32> -> vector<4xi1>
  %25 = vector.splatf nan : vector<4xf32>
  %26 = vector.select %24, %25, %lhs : vector<4xf32>
  %27 = vector.select %24, %value, %22 : vector<4xf32>
  %28 = vector.select %23, %26, %27 : vector<4xf32>
  %29 = vector.bitcast %28 : vector<4xf32> to vector<4xi32>
  %30 = vector.bitcast %rhs : vector<4xf32> to vector<4xi32>
  %31 = vector.ori %29, %30 : vector<4xi32>
  %32 = vector.bitcast %31 : vector<4xi32> to vector<4xf32>
  %33 = vector.cmpf olt, %28, %rhs : vector<4xf32> -> vector<4xi1>
  %34 = vector.cmpf olt, %rhs, %28 : vector<4xf32> -> vector<4xi1>
  %35 = vector.select %34, %rhs, %32 : vector<4xf32>
  %36 = vector.select %33, %28, %35 : vector<4xf32>
  %37 = vector.cmpf une, %28, %28 : vector<4xf32> -> vector<4xi1>
  %38 = vector.cmpf une, %rhs, %rhs : vector<4xf32> -> vector<4xi1>
