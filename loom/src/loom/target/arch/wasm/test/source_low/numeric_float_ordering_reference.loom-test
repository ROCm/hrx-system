  %15 = vector.bitcast %value : vector<2xf64> to vector<2xi64>
  %16 = vector.bitcast %lhs : vector<2xf64> to vector<2xi64>
  %17 = vector.andi %15, %16 : vector<2xi64>
  %18 = vector.bitcast %17 : vector<2xi64> to vector<2xf64>
