  %20 = vector.cmpf ogt, %lhs, %value : vector<2xf64> -> vector<2xi1>
  %21 = vector.select %20, %lhs, %18 : vector<2xf64>
  %22 = vector.select %19, %value, %21 : vector<2xf64>
