  %72 = vector.select %70, %71, %rhs : vector<2xf64>
  %73 = vector.select %70, %lhs, %68 : vector<2xf64>
  %minnum = vector.select %69, %72, %73 : vector<2xf64>
  %47 = vector.bitcast %lhs : vector<2xf64> to vector<2xi64>
  %48 = vector.bitcast %rhs : vector<2xf64> to vector<2xi64>
