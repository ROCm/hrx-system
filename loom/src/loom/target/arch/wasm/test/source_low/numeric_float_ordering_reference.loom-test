// RUN: pass target=wasm:simd128 target-legalize{mode=final}

// F64 extrema use the same exact recipe on Wasm's two-lane native carrier.
// Wider authored vectors reach this shape through ordinary packetization.
func.def @vector_f64_reference_extrema(%value: vector<2xf64>, %lhs: vector<2xf64>, %rhs: vector<2xf64>) -> (vector<2xf64>, vector<2xf64>, vector<2xf64>, vector<2xf64>, vector<2xf64>) {
  %minnum = vector.minnumf %lhs, %rhs : vector<2xf64>
  %maxnum = vector.maxnumf %lhs, %rhs : vector<2xf64>
  %ordered = vector.clampf<ordered> %value, %lhs, %rhs : vector<2xf64>
  %number = vector.clampf<number> %value, %lhs, %rhs : vector<2xf64>
  %ieee = vector.clampf<ieee> %value, %lhs, %rhs : vector<2xf64>
  func.return %minnum, %maxnum, %ordered, %number, %ieee : vector<2xf64>, vector<2xf64>, vector<2xf64>, vector<2xf64>, vector<2xf64>
}

