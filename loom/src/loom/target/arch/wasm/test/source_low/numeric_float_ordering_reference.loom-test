func.def @scalar_f64_reference_extrema(%value: f64, %lhs: f64, %rhs: f64) -> (f64, f64, f64, f64, f64) {
  %61 = scalar.bitcast %lhs : f64 to i64
  %62 = scalar.bitcast %rhs : f64 to i64
  %63 = scalar.ori %61, %62 : i64
  %64 = scalar.bitcast %63 : i64 to f64
  %65 = scalar.cmpf olt, %lhs, %rhs : f64
  %66 = scalar.cmpf olt, %rhs, %lhs : f64
  %67 = scf.select %66, %rhs, %64 : f64
  %68 = scf.select %65, %lhs, %67 : f64
  %69 = scalar.cmpf une, %lhs, %lhs : f64
  %70 = scalar.cmpf une, %rhs, %rhs : f64
  %71 = scalar.constant nan : f64
  %72 = scf.select %70, %71, %rhs : f64
  %73 = scf.select %70, %lhs, %68 : f64
  %minnum = scf.select %69, %72, %73 : f64
  %47 = scalar.bitcast %lhs : f64 to i64
  %48 = scalar.bitcast %rhs : f64 to i64
  %49 = scalar.andi %47, %48 : i64
  %50 = scalar.bitcast %49 : i64 to f64
  %51 = scalar.cmpf ogt, %lhs, %rhs : f64
  %52 = scalar.cmpf ogt, %rhs, %lhs : f64
  %53 = scf.select %52, %rhs, %50 : f64
  %54 = scf.select %51, %lhs, %53 : f64
  %55 = scalar.cmpf une, %lhs, %lhs : f64
  %56 = scalar.cmpf une, %rhs, %rhs : f64
  %57 = scalar.constant nan : f64
  %58 = scf.select %56, %57, %rhs : f64
  %59 = scf.select %56, %lhs, %54 : f64
  %maxnum = scf.select %55, %58, %59 : f64
  %43 = scalar.cmpf olt, %value, %lhs : f64
  %44 = scf.select %43, %lhs, %value : f64
  %45 = scalar.cmpf ogt, %44, %rhs : f64
  %ordered = scf.select %45, %rhs, %44 : f64
  %15 = scalar.bitcast %value : f64 to i64
  %16 = scalar.bitcast %lhs : f64 to i64
  %17 = scalar.andi %15, %16 : i64
  %18 = scalar.bitcast %17 : i64 to f64
  %19 = scalar.cmpf ogt, %value, %lhs : f64
  %20 = scalar.cmpf ogt, %lhs, %value : f64
  %21 = scf.select %20, %lhs, %18 : f64
  %22 = scf.select %19, %value, %21 : f64
  %23 = scalar.cmpf une, %value, %value : f64
  %24 = scalar.cmpf une, %lhs, %lhs : f64
  %25 = scalar.constant nan : f64
  %26 = scf.select %24, %25, %lhs : f64
  %27 = scf.select %24, %value, %22 : f64
  %28 = scf.select %23, %26, %27 : f64
  %29 = scalar.bitcast %28 : f64 to i64
  %30 = scalar.bitcast %rhs : f64 to i64
  %31 = scalar.ori %29, %30 : i64
  %32 = scalar.bitcast %31 : i64 to f64
  %33 = scalar.cmpf olt, %28, %rhs : f64
  %34 = scalar.cmpf olt, %rhs, %28 : f64
  %35 = scf.select %34, %rhs, %32 : f64
  %36 = scf.select %33, %28, %35 : f64
  %37 = scalar.cmpf une, %28, %28 : f64
  %38 = scalar.cmpf une, %rhs, %rhs : f64
  %39 = scalar.constant nan : f64
  %40 = scf.select %38, %39, %rhs : f64
  %41 = scf.select %38, %28, %36 : f64
  %number = scf.select %37, %40, %41 : f64
  %13 = scalar.maximumf %value, %lhs : f64
  %ieee = scalar.minimumf %13, %rhs : f64
  func.return %minnum, %maxnum, %ordered, %number, %ieee : f64, f64, f64, f64, f64
}

