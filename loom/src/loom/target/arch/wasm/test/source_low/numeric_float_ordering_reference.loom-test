// ====

// RUN: with-checks pass target=wasm:simd128 target-legalize{mode=final}

// Every narrow scalar encoding shares the exact widen-to-F32 comparison path.
func.def @scalar_narrow_reference_comparisons(%e4_lhs: f8E4M3, %e4_rhs: f8E4M3, %e5_lhs: f8E5M2, %e5_rhs: f8E5M2, %f16_lhs: f16, %f16_rhs: f16, %bf16_lhs: bf16, %bf16_rhs: bf16) -> (i1, i1, i1, i1) {
  %e4_one = scalar.cmpf one, %e4_lhs, %e4_rhs : f8E4M3
  %e5_ord = scalar.cmpf ord, %e5_lhs, %e5_rhs : f8E5M2
  %f16_ueq = scalar.cmpf ueq, %f16_lhs, %f16_rhs : f16
  %bf16_uno = scalar.cmpf uno, %bf16_lhs, %bf16_rhs : bf16
  func.return %e4_one, %e5_ord, %f16_ueq, %bf16_uno : i1, i1, i1, i1
}

// ----
CHECK: %e4_one = scalar.cmpf one, *, * : f32
CHECK: %e5_ord = scalar.cmpf ord, *, * : f32
CHECK: %f16_ueq = scalar.cmpf ueq, *, * : f32
CHECK: %bf16_uno = scalar.cmpf uno, *, * : f32

// ====

// RUN: pass target=wasm:simd128 target-legalize{mode=final}

// Narrow comparisons widen exactly to F32 while retaining the canonical
// four-lane Wasm predicate carrier. Full-width arguments keep the authored
// function inside Wasm's callable ABI while the slices exercise partial
// internal carriers.
func.def @vector_f16_reference_comparisons(%lhs_packet: vector<8xf16>, %rhs_packet: vector<8xf16>) -> (vector<4xi1>, vector<4xi1>, vector<4xi1>) {
  %lhs = vector.slice %lhs_packet[0] : vector<8xf16> -> vector<4xf16>
  %rhs = vector.slice %rhs_packet[0] : vector<8xf16> -> vector<4xf16>
  %not_equal = vector.cmpf one, %lhs, %rhs : vector<4xf16> -> vector<4xi1>
  %unordered = vector.cmpf uno, %lhs, %rhs : vector<4xf16> -> vector<4xi1>
  %unordered_greater = vector.cmpf ugt, %lhs, %rhs : vector<4xf16> -> vector<4xi1>
  func.return %not_equal, %unordered, %unordered_greater : vector<4xi1>, vector<4xi1>, vector<4xi1>
}

// ----
func.def @vector_f16_reference_comparisons(%lhs_packet: vector<8xf16>, %rhs_packet: vector<8xf16>) -> (vector<4xi1>, vector<4xi1>, vector<4xi1>) {
  %lhs = vector.slice %lhs_packet[0] : vector<8xf16> -> vector<4xf16>
  %rhs = vector.slice %rhs_packet[0] : vector<8xf16> -> vector<4xf16>
  %16 = vector.extf %lhs : vector<4xf16> to vector<4xf32>
  %17 = vector.extf %rhs : vector<4xf16> to vector<4xf32>
  %not_equal = vector.cmpf one, %16, %17 : vector<4xf32> -> vector<4xi1>
  %13 = vector.extf %lhs : vector<4xf16> to vector<4xf32>
  %14 = vector.extf %rhs : vector<4xf16> to vector<4xf32>
  %unordered = vector.cmpf uno, %13, %14 : vector<4xf32> -> vector<4xi1>
  %10 = vector.extf %lhs : vector<4xf16> to vector<4xf32>
  %11 = vector.extf %rhs : vector<4xf16> to vector<4xf32>
  %unordered_greater = vector.cmpf ugt, %10, %11 : vector<4xf32> -> vector<4xi1>
  func.return %not_equal, %unordered, %unordered_greater : vector<4xi1>, vector<4xi1>, vector<4xi1>
}

// ====

// Extrema predicates use widened comparisons while all selected values remain
// in their original narrow payload representation. Duplicating the partial
// results forms callable full-width vectors without changing their lanes.
func.def @vector_f16_reference_extrema(%value_packet: vector<8xf16>, %lhs_packet: vector<8xf16>, %rhs_packet: vector<8xf16>) -> (vector<8xf16>, vector<8xf16>, vector<8xf16>) {
  %value = vector.slice %value_packet[0] : vector<8xf16> -> vector<4xf16>
  %lhs = vector.slice %lhs_packet[0] : vector<8xf16> -> vector<4xf16>
  %rhs = vector.slice %rhs_packet[0] : vector<8xf16> -> vector<4xf16>
  %minnum = vector.minnumf %lhs, %rhs : vector<4xf16>
  %minimum = vector.minimumf %lhs, %rhs : vector<4xf16>
  %number = vector.clampf<number> %value, %lhs, %rhs : vector<4xf16>
  %minnum_packet = vector.concat<0> %minnum, %minnum : vector<4xf16>, vector<4xf16> -> vector<8xf16>
  %minimum_packet = vector.concat<0> %minimum, %minimum : vector<4xf16>, vector<4xf16> -> vector<8xf16>
  %number_packet = vector.concat<0> %number, %number : vector<4xf16>, vector<4xf16> -> vector<8xf16>
  func.return %minnum_packet, %minimum_packet, %number_packet : vector<8xf16>, vector<8xf16>, vector<8xf16>
}

// ----
func.def @vector_f16_reference_extrema(%value_packet: vector<8xf16>, %lhs_packet: vector<8xf16>, %rhs_packet: vector<8xf16>) -> (vector<8xf16>, vector<8xf16>, vector<8xf16>) {
  %value = vector.slice %value_packet[0] : vector<8xf16> -> vector<4xf16>
  %lhs = vector.slice %lhs_packet[0] : vector<8xf16> -> vector<4xf16>
  %rhs = vector.slice %rhs_packet[0] : vector<8xf16> -> vector<4xf16>
  %94 = vector.bitcast %lhs : vector<4xf16> to vector<4xi16>
  %95 = vector.bitcast %rhs : vector<4xf16> to vector<4xi16>
  %96 = vector.ori %94, %95 : vector<4xi16>
  %97 = vector.bitcast %96 : vector<4xi16> to vector<4xf16>
  %115 = vector.extf %lhs : vector<4xf16> to vector<4xf32>
  %116 = vector.extf %rhs : vector<4xf16> to vector<4xf32>
  %117 = vector.cmpf olt, %115, %116 : vector<4xf32> -> vector<4xi1>
  %112 = vector.extf %rhs : vector<4xf16> to vector<4xf32>
  %113 = vector.extf %lhs : vector<4xf16> to vector<4xf32>
  %114 = vector.cmpf olt, %112, %113 : vector<4xf32> -> vector<4xi1>
  %100 = vector.select %114, %rhs, %97 : vector<4xf16>
  %101 = vector.select %117, %lhs, %100 : vector<4xf16>
  %110 = vector.extf %lhs : vector<4xf16> to vector<4xf32>
  %111 = vector.cmpf une, %110, %110 : vector<4xf32> -> vector<4xi1>
  %108 = vector.extf %rhs : vector<4xf16> to vector<4xf32>
  %109 = vector.cmpf une, %108, %108 : vector<4xf32> -> vector<4xi1>
  %104 = vector.splatf nan : vector<4xf16>
  %105 = vector.select %109, %104, %rhs : vector<4xf16>
  %106 = vector.select %109, %lhs, %101 : vector<4xf16>
  %minnum = vector.select %111, %105, %106 : vector<4xf16>
  %70 = vector.bitcast %lhs : vector<4xf16> to vector<4xi16>
  %71 = vector.bitcast %rhs : vector<4xf16> to vector<4xi16>
  %72 = vector.ori %70, %71 : vector<4xi16>
  %73 = vector.bitcast %72 : vector<4xi16> to vector<4xf16>
  %91 = vector.extf %lhs : vector<4xf16> to vector<4xf32>
  %92 = vector.extf %rhs : vector<4xf16> to vector<4xf32>
  %93 = vector.cmpf olt, %91, %92 : vector<4xf32> -> vector<4xi1>
  %88 = vector.extf %rhs : vector<4xf16> to vector<4xf32>
  %89 = vector.extf %lhs : vector<4xf16> to vector<4xf32>
  %90 = vector.cmpf olt, %88, %89 : vector<4xf32> -> vector<4xi1>
  %76 = vector.select %90, %rhs, %73 : vector<4xf16>
  %77 = vector.select %93, %lhs, %76 : vector<4xf16>
  %86 = vector.extf %lhs : vector<4xf16> to vector<4xf32>
  %87 = vector.cmpf une, %86, %86 : vector<4xf32> -> vector<4xi1>
  %84 = vector.extf %rhs : vector<4xf16> to vector<4xf32>
  %85 = vector.cmpf une, %84, %84 : vector<4xf32> -> vector<4xi1>
  %80 = vector.splatf nan : vector<4xf16>
  %81 = vector.select %85, %80, %rhs : vector<4xf16>
  %82 = vector.select %85, %lhs, %77 : vector<4xf16>
  %83 = vector.select %87, %81, %82 : vector<4xf16>
  %67 = vector.extf %lhs : vector<4xf16> to vector<4xf32>
  %68 = vector.extf %rhs : vector<4xf16> to vector<4xf32>
  %69 = vector.cmpf uno, %67, %68 : vector<4xf32> -> vector<4xi1>
  %65 = vector.splatf nan : vector<4xf16>
  %minimum = vector.select %69, %65, %83 : vector<4xf16>
  %15 = vector.bitcast %value : vector<4xf16> to vector<4xi16>
  %16 = vector.bitcast %lhs : vector<4xf16> to vector<4xi16>
  %17 = vector.andi %15, %16 : vector<4xi16>
  %18 = vector.bitcast %17 : vector<4xi16> to vector<4xf16>
