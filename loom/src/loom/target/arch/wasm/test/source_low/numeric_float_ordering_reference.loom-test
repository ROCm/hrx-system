  %52 = vector.cmpf ogt, %rhs, %lhs : vector<4xf32> -> vector<4xi1>
  %53 = vector.select %52, %rhs, %50 : vector<4xf32>
  %54 = vector.select %51, %lhs, %53 : vector<4xf32>
