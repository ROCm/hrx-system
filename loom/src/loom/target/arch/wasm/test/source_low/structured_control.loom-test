// RUN: emit source-low output=low control-flow=structured-low

wasm.target<simd128> @target

func.def target(@target) @if_without_results(%control: i32, %limit: i32, %lhs: vector<4xi32>, %rhs: vector<4xi32>, %output: buffer) {
  %cond = scalar.cmpi ult, %control, %limit : i32
  %output_base = index.constant 0 : offset
  %output_view = buffer.view %output[%output_base] : buffer -> view<4xi32>
  scf.if %cond {
    %sum = vector.addi %lhs, %rhs : vector<4xi32>
    vector.store %sum, %output_view[0] : vector<4xi32>, view<4xi32>
  }
  func.return
}

// ----
low.func.def target<wasm.core.simd128>(@target) abi(wasm_function) @if_without_results(%control: reg<wasm.i32>, %limit: reg<wasm.i32>, %lhs: reg<wasm.v128>, %rhs: reg<wasm.v128>, %output: reg<wasm.i32>) asm {
  %cond = i32.lt_u %control, %limit
  low.scf.if %cond {
    %sum = i32x4.add %lhs, %rhs
    v128.store %output, %sum
  }
  return
}

// ====

wasm.target<simd128> @target

func.def target(@target) @if_with_results(%control: i32, %limit: i32, %lhs: vector<4xi32>, %rhs: vector<4xi32>, %fallback: vector<4xi32>) -> (vector<4xi32>) {
  %cond = scalar.cmpi ult, %control, %limit : i32
  %result = scf.if %cond -> (vector<4xi32>) {
    %then = vector.addi %lhs, %rhs : vector<4xi32>
    scf.yield %then : vector<4xi32>
  } else {
    %else = vector.subi %fallback, %rhs : vector<4xi32>
    scf.yield %else : vector<4xi32>
  }
  func.return %result : vector<4xi32>
}

// ----
low.func.def target<wasm.core.simd128>(@target) abi(wasm_function) @if_with_results(%control: reg<wasm.i32>, %limit: reg<wasm.i32>, %lhs: reg<wasm.v128>, %rhs: reg<wasm.v128>, %fallback: reg<wasm.v128>) -> (reg<wasm.v128>) asm {
  %cond = i32.lt_u %control, %limit
  %then = i32x4.add %lhs, %rhs
  %else = i32x4.sub %fallback, %rhs
  %result = v128.select %then, %else, %cond
  return %result
}

// ====

wasm.target<simd128> @target

func.def target(@target) @for_without_iter_args(%lo: index, %hi: index, %step: index, %lhs: vector<4xi32>, %rhs: vector<4xi32>, %output: buffer) {
  %output_base = index.constant 0 : offset
  %output_view = buffer.view %output[%output_base] : buffer -> view<4xi32>
  scf.for %iv = [%lo to %hi step %step] {
    %sum = vector.addi %lhs, %rhs : vector<4xi32>
    vector.store %sum, %output_view[0] : vector<4xi32>, view<4xi32>
  }
  func.return
}

// ----
low.func.def target<wasm.core.simd128>(@target) abi(wasm_function) @for_without_iter_args(%lo: reg<wasm.i32>, %hi: reg<wasm.i32>, %step: reg<wasm.i32>, %lhs: reg<wasm.v128>, %rhs: reg<wasm.v128>, %output: reg<wasm.i32>) asm {
  %sum = i32x4.add %lhs, %rhs
  low.scf.for signed [%lo to %hi step %step] do(%iv: reg<wasm.i32>) {
    v128.store %output, %sum
  }
  return
}

// ====

wasm.target<simd128> @target

func.def target(@target) @for_with_iter_args(%lo: index, %hi: index, %step: index, %seed: vector<4xf32>, %bias: vector<4xf32>) -> (vector<4xf32>) {
  %result = scf.for %iv = [%lo to %hi step %step](%acc = %seed : vector<4xf32>) -> (vector<4xf32>) {
    %next = vector.addf %acc, %bias : vector<4xf32>
    scf.yield %next : vector<4xf32>
  }
  func.return %result : vector<4xf32>
}

// ----
low.func.def target<wasm.core.simd128>(@target) abi(wasm_function) @for_with_iter_args(%lo: reg<wasm.i32>, %hi: reg<wasm.i32>, %step: reg<wasm.i32>, %seed: reg<wasm.v128>, %bias: reg<wasm.v128>) -> (reg<wasm.v128>) asm {
  %result = low.scf.for signed [%lo to %hi step %step] iter_args(%seed: reg<wasm.v128>) -> (reg<wasm.v128>) do(%iv: reg<wasm.i32>, %acc: reg<wasm.v128>) {
    %next = f32x4.add %acc, %bias
    low.scf.yield %next : reg<wasm.v128>
  }
  return %result
}

// ====

wasm.target<simd128> @target

func.def target(@target) @for_with_partial_integer_iter_arg(%lo: index, %hi: index, %step: index, %a: i32, %b: i32) -> (i32, i32) {
  %initial = vector.from_elements %a, %b : vector<2xi32>
  %result = scf.for %iv = [%lo to %hi step %step](%state = %initial : vector<2xi32>) -> (vector<2xi32>) {
    %x = vector.extract %state[0] : vector<2xi32> -> i32
    %y = vector.extract %state[1] : vector<2xi32> -> i32
    %sum = scalar.addi %x, %y : i32
    %next = vector.from_elements %y, %sum : vector<2xi32>
    scf.yield %next : vector<2xi32>
  }
  %x = vector.extract %result[0] : vector<2xi32> -> i32
  %y = vector.extract %result[1] : vector<2xi32> -> i32
  func.return %x, %y : i32, i32
}

// ----
low.func.def target<wasm.core.simd128>(@target) abi(wasm_function) @for_with_partial_integer_iter_arg(%lo: reg<wasm.i32>, %hi: reg<wasm.i32>, %step: reg<wasm.i32>, %a: reg<wasm.i32>, %b: reg<wasm.i32>) -> (reg<wasm.i32>, reg<wasm.i32>) asm {
  %result_slot_0, %result_slot_1 = low.scf.for signed [%lo to %hi step %step] iter_args(%a: reg<wasm.i32>, %b: reg<wasm.i32>) -> (reg<wasm.i32>, reg<wasm.i32>) do(%iv: reg<wasm.i32>, %state_slot_0: reg<wasm.i32>, %state_slot_1: reg<wasm.i32>) {
    %sum = i32.add %state_slot_0, %state_slot_1
    low.scf.yield %state_slot_1, %sum : reg<wasm.i32>, reg<wasm.i32>
  }
  return %result_slot_0, %result_slot_1
}

// ====

wasm.target<simd128> @target

func.def target(@target) @nested_if_inside_for(%lo: index, %hi: index, %step: index, %seed: vector<4xi32>, %bias: vector<4xi32>) -> (vector<4xi32>) {
  %cond = index.cmp ult, %lo, %hi : index
  %result = scf.for %iv = [%lo to %hi step %step](%acc = %seed : vector<4xi32>) -> (vector<4xi32>) {
    %next = scf.if %cond -> (vector<4xi32>) {
      %then = vector.addi %acc, %bias : vector<4xi32>
      scf.yield %then : vector<4xi32>
    } else {
      scf.yield %acc : vector<4xi32>
    }
    scf.yield %next : vector<4xi32>
  }
  func.return %result : vector<4xi32>
}

// ----
low.func.def target<wasm.core.simd128>(@target) abi(wasm_function) @nested_if_inside_for(%lo: reg<wasm.i32>, %hi: reg<wasm.i32>, %step: reg<wasm.i32>, %seed: reg<wasm.v128>, %bias: reg<wasm.v128>) -> (reg<wasm.v128>) asm {
  %cond = i32.lt_u %lo, %hi
  %result = low.scf.for signed [%lo to %hi step %step] iter_args(%seed: reg<wasm.v128>) -> (reg<wasm.v128>) do(%iv: reg<wasm.i32>, %acc: reg<wasm.v128>) {
    %then = i32x4.add %acc, %bias
    %next = v128.select %then, %acc, %cond
    low.scf.yield %next : reg<wasm.v128>
  }
  return %result
}

// ====

wasm.target<simd128> @target

func.def target(@target) @while_with_condition_payload(%limit: i32, %step: i32, %seed: i32, %bias: i32) -> (i32, i32) {
  %result_state, %result_payload = scf.while(%before = %seed : i32) -> (i32, i32) {
    %keep_going = scalar.cmpi ult, %before, %limit : i32
    %payload = scalar.addi %before, %bias : i32
    scf.condition %keep_going, %before, %payload : i1, i32, i32
  } do(%body_state: i32, %body_payload: i32) {
    %next = scalar.addi %body_payload, %step : i32
    scf.yield %next : i32
  }
  func.return %result_state, %result_payload : i32, i32
}

// ----
low.func.def target<wasm.core.simd128>(@target) abi(wasm_function) @while_with_condition_payload(%limit: reg<wasm.i32>, %step: reg<wasm.i32>, %seed: reg<wasm.i32>, %bias: reg<wasm.i32>) -> (reg<wasm.i32>, reg<wasm.i32>) asm {
  %result_state, %result_payload = low.scf.while(%before = %seed : reg<wasm.i32>) -> (reg<wasm.i32>, reg<wasm.i32>) {
    %keep_going = i32.lt_u %before, %limit
    %payload = i32.add %before, %bias
    low.scf.condition %keep_going, %before, %payload : reg<wasm.i32>, reg<wasm.i32>, reg<wasm.i32>
  } do(%body_state: reg<wasm.i32>, %body_payload: reg<wasm.i32>) {
    %next = i32.add %body_payload, %step
    low.scf.yield %next : reg<wasm.i32>
  }
  return %result_state, %result_payload
}

