  %count = scalar.constant 6 : i64
  %shifted = scalar.shli %value, %count : i64
  %result = scalar.trunci %shifted : i64 to i32
  func.return %result : i32
}

// ----
low.func.def target<wasm.core.simd128>(@target) abi(wasm_function) @wide_shift_low_word(%value: reg<wasm.i64>) -> (reg<wasm.i32>) asm {
  %count = i64.const 6
  %shifted = i64.shl %value, %count
  %result = i32.wrap_i64 %shifted
  return %result
}

