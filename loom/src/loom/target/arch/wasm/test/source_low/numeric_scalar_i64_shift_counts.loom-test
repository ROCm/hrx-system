// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_scalar_i64_shift_counts.loom-test
// RUN: emit source-low output=low

wasm.target<simd128> @target

func.def target(@target) @wide_shift_constant(%values: vector<2xi64>) -> (i64) {
  %value = vector.extract %values[0] : vector<2xi64> -> i64
  %count = scalar.constant 31 : i64
  %shifted = scalar.shli %value, %count : i64
  func.return %shifted : i64
}

// ----
low.func.def target<wasm.core.simd128>(@target) abi(wasm_function) @wide_shift_constant(%values: reg<wasm.v128>) -> (reg<wasm.i64>) asm {
  %value = i64x2.extract_lane %values, 0
  %count = i64.const 31
  %shifted = i64.shl %value, %count
  return %shifted
}

