// ====

wasm.target<simd128> @target

func.def target(@target) @wide_shift_word_boundaries(%value: i64) -> (i64, i64, i64, i64) {
  %identity_count = scalar.constant 0 : i64
  %last_low = scalar.constant 31 : i64
  %first_high = scalar.constant 32 : i64
  %last_high = scalar.constant 63 : i64
  %unchanged = scalar.shli %value, %identity_count : i64
  %low_edge = scalar.shli %value, %last_low : i64
  %high_edge = scalar.shli %value, %first_high : i64
  %top_bit = scalar.shli %value, %last_high : i64
  func.return %unchanged, %low_edge, %high_edge, %top_bit : i64, i64, i64, i64
}

// ----
low.func.def target<wasm.core.simd128>(@target) abi(wasm_function) @wide_shift_word_boundaries(%value: reg<wasm.i64>) -> (reg<wasm.i64>, reg<wasm.i64>, reg<wasm.i64>, reg<wasm.i64>) asm {
  %last_low = i64.const 31
  %first_high = i64.const 32
  %last_high = i64.const 63
  %low_edge = i64.shl %value, %last_low
  %high_edge = i64.shl %value, %first_high
  %top_bit = i64.shl %value, %last_high
  return %value, %low_edge, %high_edge, %top_bit
}

