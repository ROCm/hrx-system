// Allocation and finalizer events instrument physical work; the declared
// pure producer has no application-visible resource acquisition.
// RUN: emit vm-object-lifetime
type.decl import("lifetime", "object") @Object

func.decl import("lifetime", "create") pure @create(%id: i32) -> (ref<@Object>, ptr<@Object>)

func.decl import("lifetime", "observe") @observe()

func.def public @run() {
  %id = scalar.constant 13 : i32
  %owner, %unused = func.call pure @create(%id) : (i32) -> (ref<@Object>, ptr<@Object>)
  %copy = ref.duplicate %owner : ref<@Object>
  %pointer = ref.borrow %copy : ref<@Object> -> ptr<@Object>
  %dead = ref.compare.null %pointer : ptr<@Object>
  ref.release %copy : ref<@Object>
  ref.release %owner : ref<@Object>
  func.call @observe() : ()
  func.return
}

// ----
live 0
OK 0
retired 0

// ====

// An effectful resource producer must remain, along with its cleanup.
// RUN: emit vm-object-lifetime
type.decl import("lifetime", "object") @Object

func.decl import("lifetime", "create") @create(%id: i32) -> (ref<@Object>, ptr<@Object>)

func.decl import("lifetime", "observe") @observe()

func.def public @run() {
  %id = scalar.constant 14 : i32
  %owner, %unused = func.call @create(%id) : (i32) -> (ref<@Object>, ptr<@Object>)
  ref.release %owner : ref<@Object>
  func.call @observe() : ()
  func.return
}

// ----
create 14
destroy 14
live 0
OK 0
retired 0

// ====

// A real payload observation keeps even a pure producer and its cleanup.
// RUN: emit vm-object-lifetime
type.decl import("lifetime", "object") @Object

func.decl import("lifetime", "create") pure @create(%id: i32) -> (ref<@Object>, ptr<@Object>)

func.decl import("lifetime", "read") @read(%pointer: ptr<@Object>)

func.decl import("lifetime", "observe") @observe()

func.def public @run() {
  %id = scalar.constant 15 : i32
  %owner, %unused = func.call pure @create(%id) : (i32) -> (ref<@Object>, ptr<@Object>)
  %pointer = ref.borrow %owner : ref<@Object> -> ptr<@Object>
  func.call @read(%pointer) : (ptr<@Object>)
  ref.release %owner : ref<@Object>
  func.call @observe() : ()
  func.return
}

// ----
create 15
read 15
destroy 15
live 0
OK 0
retired 0

// ====

// Pure computation that consumes a materialized owner must retain cleanup.
