type.decl import("lifetime", "object") @Object

func.decl import("lifetime", "create") @create(%id: i32) -> (ref<@Object>, ptr<@Object>)

func.decl import("lifetime", "consume") pure @consume(%owner: ref<@Object>)

func.decl import("lifetime", "observe") @observe()

func.def public @run() {
  %id = scalar.constant 17 : i32
  %owner, %unused = func.call @create(%id) : (i32) -> (ref<@Object>, ptr<@Object>)
  func.call pure @consume(%owner) : (ref<@Object>)
  func.call @observe() : ()
  func.return
}
// ----
create 17
consume 17
destroy 17
live 0
OK 0
retired 0

// ====

// Pure creators have independent handle identities even with identical inputs.
// RUN: emit vm-object-lifetime
type.decl import("lifetime", "object") @Object

func.decl import("lifetime", "create") pure @create(%id: i32) -> (ref<@Object>, ptr<@Object>)

func.decl import("lifetime", "consume") @consume(%owner: ref<@Object>)

func.decl import("lifetime", "observe") @observe()

func.def public @run() {
  %id = scalar.constant 18 : i32
  %first, %unused_first = func.call pure @create(%id) : (i32) -> (ref<@Object>, ptr<@Object>)
  %second, %unused_second = func.call pure @create(%id) : (i32) -> (ref<@Object>, ptr<@Object>)
  func.call @consume(%first) : (ref<@Object>)
  func.call @consume(%second) : (ref<@Object>)
  func.call @observe() : ()
  func.return
}
// ----
create 18
create 18
consume 18
destroy 18
consume 18
destroy 18
live 0
OK 0
retired 0

