// A host owner covers every stored and loaded pointer. Array transport must
// preserve a single owner through dynamic indexing, slicing, and native calls.
// RUN: emit vm-object-lifetime borrowed-argument
type.decl import("lifetime", "object") @Object

func.decl import("lifetime", "count") @count(%value: ptr<@Object>)

func.decl import("lifetime", "read") @read(%value: ptr<@Object>)

func.decl import("lifetime", "event") @event(%value: i32)

func.def noinline @use_array(%value: ptr<@Object>, %capacity: index) {
  %bounded = index.assume %capacity [range(%capacity, 4, 8)] : index
  %objects = view.alloca<private> : view<[%bounded]xptr<@Object>>
  %empty = view.load %objects[0] : view<[%bounded]xptr<@Object>> -> ptr<@Object>
  %is_null = ref.compare.null %empty : ptr<@Object>
  %null_word = scalar.extui %is_null : i1 to i32
  func.call @event(%null_word) : (i32)
  %tail = view.subview %objects[1] : view<[%bounded]xptr<@Object>> -> view<3xptr<@Object>>
  %begin = index.constant 0 : index
  %end = index.constant 3 : index
  %step = index.constant 1 : index
  scf.for %i = [%begin to %end step %step] {
    view.store %value, %tail[%i] : ptr<@Object>, view<3xptr<@Object>>
    %loaded = view.load %tail[%i] : view<3xptr<@Object>> -> ptr<@Object>
    func.call @count(%loaded) : (ptr<@Object>)
    func.call @read(%loaded) : (ptr<@Object>)
  }
  func.call @count(%value) : (ptr<@Object>)
  func.return
}

func.def public @run(%value: ptr<@Object>) {
  %capacity = index.constant 6 : index
  func.call @use_array(%value, %capacity) : (ptr<@Object>, index)
  func.return
}

// ----
create 1
event 1
references 1
read 1
references 1
read 1
references 1
read 1
references 1
OK 1
destroy 1
retired 0

// ====

// Owning cells retain independently of the source SSA owner and the loaded
// owner. Replacing the cell with null releases the array's ownership.
// RUN: emit vm-object-lifetime
type.decl import("lifetime", "object") @Object

func.decl import("lifetime", "create") @create(%identity: i32) -> (ref<@Object>, ptr<@Object>)

func.decl import("lifetime", "count") @count(%value: ptr<@Object>)

func.decl import("lifetime", "read") @read(%value: ptr<@Object>)

func.decl import("lifetime", "observe") @observe()

func.def public @run() {
  %objects = view.alloca<private> : view<2xref<@Object>>
  %identity = scalar.constant 7 : i32
  %owner, %unused = func.call @create(%identity) : (i32) -> (ref<@Object>, ptr<@Object>)
  view.store %owner, %objects[1] : ref<@Object>, view<2xref<@Object>>
  ref.release %owner : ref<@Object>
  %loaded = view.load %objects[1] : view<2xref<@Object>> -> ref<@Object>
  %pointer = ref.borrow %loaded : ref<@Object> -> ptr<@Object>
  func.call @count(%pointer) : (ptr<@Object>)
  func.call @read(%pointer) : (ptr<@Object>)
  ref.release %pointer : ptr<@Object>
  ref.release %loaded : ref<@Object>
  %empty = ref.null : ref<@Object>
  view.store %empty, %objects[1] : ref<@Object>, view<2xref<@Object>>
  ref.release %empty : ref<@Object>
  func.call @observe() : ()
  func.return
}

// ----
create 7
references 2
read 7
destroy 7
live 0
OK 0
retired 0

// ====

// A pointer stored beyond its original owner's lifetime requires protection.
// Clearing the array must release that protection after the loaded copy dies.
// RUN: emit vm-object-lifetime
type.decl import("lifetime", "object") @Object

func.decl import("lifetime", "create") @create(%identity: i32) -> (ref<@Object>, ptr<@Object>)

func.decl import("lifetime", "count") @count(%value: ptr<@Object>)

func.decl import("lifetime", "read") @read(%value: ptr<@Object>)

func.decl import("lifetime", "observe") @observe()

func.def public @run() {
  %objects = view.alloca<private> : view<2xptr<@Object>>
  %identity = scalar.constant 7 : i32
  %owner, %unused = func.call @create(%identity) : (i32) -> (ref<@Object>, ptr<@Object>)
  // REMARK@+1: DOMINANCE/021
  %pointer = ref.borrow %owner : ref<@Object> -> ptr<@Object>
  view.store %pointer, %objects[1] : ptr<@Object>, view<2xptr<@Object>>
  ref.release %pointer : ptr<@Object>
  ref.release %owner : ref<@Object>
  %loaded = view.load %objects[1] : view<2xptr<@Object>> -> ptr<@Object>
  func.call @count(%loaded) : (ptr<@Object>)
  func.call @read(%loaded) : (ptr<@Object>)
  ref.release %loaded : ptr<@Object>
  %empty = ref.null : ptr<@Object>
  view.store %empty, %objects[1] : ptr<@Object>, view<2xptr<@Object>>
  func.call @observe() : ()
  func.return
}

// ----
create 7
references 2
read 7
destroy 7
live 0
OK 0
retired 0

// ====

// A repeated allocation reinitializes at the source execution point. It must
// clear the previous iteration's owner before the new cell is observed.
// RUN: emit vm-object-lifetime
type.decl import("lifetime", "object") @Object

func.decl import("lifetime", "create") @create(%identity: i32) -> (ref<@Object>, ptr<@Object>)

func.decl import("lifetime", "event") @event(%value: i32)

func.def public @run() {
  %begin = index.constant 0 : index
  %end = index.constant 3 : index
  %step = index.constant 1 : index
  scf.for %i = [%begin to %end step %step] {
    %objects = view.alloca<private> : view<1xref<@Object>>
    %old = view.load %objects[0] : view<1xref<@Object>> -> ref<@Object>
    %is_null = ref.compare.null %old : ref<@Object>
    %null_word = scalar.extui %is_null : i1 to i32
    func.call @event(%null_word) : (i32)
    ref.release %old : ref<@Object>
    %identity = index.cast %i : index to i32
    %owner, %unused = func.call @create(%identity) : (i32) -> (ref<@Object>, ptr<@Object>)
    view.store %owner, %objects[0] : ref<@Object>, view<1xref<@Object>>
    ref.release %owner : ref<@Object>
  }
  func.return
}

// ----
event 1
create 0
destroy 0
event 1
create 1
destroy 1
event 1
create 2
destroy 2
OK 0
retired 0

// ====

// Array cells remain disjoint from outgoing reference-overflow arguments.
// RUN: emit vm-object-lifetime borrowed-argument
type.decl import("lifetime", "object") @Object

func.decl import("lifetime", "count") @count(%value: ptr<@Object>)

func.decl import("lifetime", "read") @read(%value: ptr<@Object>)

func.def noinline @overflow(%first: ptr<@Object>, %unused1: ptr<@Object>, %unused2: ptr<@Object>, %unused3: ptr<@Object>, %unused4: ptr<@Object>, %unused5: ptr<@Object>, %unused6: ptr<@Object>, %unused7: ptr<@Object>, %unused8: ptr<@Object>, %unused9: ptr<@Object>, %unused10: ptr<@Object>, %unused11: ptr<@Object>, %unused12: ptr<@Object>, %unused13: ptr<@Object>, %unused14: ptr<@Object>, %unused15: ptr<@Object>, %last: ptr<@Object>) {
  func.call @count(%first) : (ptr<@Object>)
  func.call @read(%last) : (ptr<@Object>)
  func.return
}

func.def public @run(%value: ptr<@Object>) {
  %objects = view.alloca<private> : view<2xptr<@Object>>
  view.store %value, %objects[1] : ptr<@Object>, view<2xptr<@Object>>
  func.call @overflow(%value, %value, %value, %value, %value, %value, %value, %value, %value, %value, %value, %value, %value, %value, %value, %value, %value) : (ptr<@Object>, ptr<@Object>, ptr<@Object>, ptr<@Object>, ptr<@Object>, ptr<@Object>, ptr<@Object>, ptr<@Object>, ptr<@Object>, ptr<@Object>, ptr<@Object>, ptr<@Object>, ptr<@Object>, ptr<@Object>, ptr<@Object>, ptr<@Object>, ptr<@Object>)
  %loaded = view.load %objects[1] : view<2xptr<@Object>> -> ptr<@Object>
  func.call @count(%loaded) : (ptr<@Object>)
  func.call @read(%loaded) : (ptr<@Object>)
  func.return
}

// ----
create 1
references 1
read 1
references 1
read 1
OK 1
destroy 1
retired 0
