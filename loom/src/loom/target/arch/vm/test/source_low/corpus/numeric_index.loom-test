vm.target<core> @target
func.def target(@target) @offset_compare_select(%lhs: offset, %rhs: offset) -> (i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, offset) {
  %eq = index.cmp eq, %lhs, %rhs : offset
  %ne = index.cmp ne, %lhs, %rhs : offset
  %slt = index.cmp slt, %lhs, %rhs : offset
  %sle = index.cmp sle, %lhs, %rhs : offset
  %sgt = index.cmp sgt, %lhs, %rhs : offset
  %sge = index.cmp sge, %lhs, %rhs : offset
  %ult = index.cmp ult, %lhs, %rhs : offset
  %ule = index.cmp ule, %lhs, %rhs : offset
  %ugt = index.cmp ugt, %lhs, %rhs : offset
  %uge = index.cmp uge, %lhs, %rhs : offset
  %selected = scf.select %ult, %lhs, %rhs : offset
  func.return %eq, %ne, %slt, %sle, %sgt, %sge, %ult, %ule, %ugt, %uge, %selected : i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, offset
}

