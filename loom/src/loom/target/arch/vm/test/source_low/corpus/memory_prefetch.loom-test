vm.target<core> @target
func.def target(@target) @prefetch_static(%input: buffer) {
  %base = index.constant 16 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<64xi32>
  view.prefetch %input_view[4] {intent = read, locality = l1} : view<64xi32>
  func.return
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.ref : buffer>) -> ()>}) @prefetch_static(%input: reg<vm.ref : buffer>) asm {
  return
}

