// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_narrow_conversion.loom-test
// RUN: emit source-low target=vm:core output=low

func.def @extend_narrow(%arg0: f8E4M3, %arg1: f8E5M2, %arg2: f16, %arg3: bf16) -> (f32, f32, f32, f32) {
  %result0 = scalar.extf %arg0 : f8E4M3 to f32
  %result1 = scalar.extf %arg1 : f8E5M2 to f32
  %result2 = scalar.extf %arg2 : f16 to f32
  %result3 = scalar.extf %arg3 : bf16 to f32
  func.return %result0, %result1, %result2, %result3 : f32, f32, f32, f32
}

// ----
low.func.def target<vm.core> abi(vm_function) @extend_narrow(%arg0: reg<vm.value : f8E4M3>, %arg1: reg<vm.value : f8E5M2>, %arg2: reg<vm.value : f16>, %arg3: reg<vm.value : bf16>) -> (reg<vm.value : f32>, reg<vm.value : f32>, reg<vm.value : f32>, reg<vm.value : f32>) asm {
  %result0 = conversion.float.extend %arg0, "f8e4m3.to.f32" : reg<vm.value : f32>
  %result1 = conversion.float.extend %arg1, "f8e5m2.to.f32" : reg<vm.value : f32>
  %result2 = conversion.float.extend %arg2, "f16.to.f32" : reg<vm.value : f32>
  %result3 = conversion.float.extend %arg3, "bf16.to.f32" : reg<vm.value : f32>
  return %result0, %result1, %result2, %result3
}

// ====

func.def @truncate_single(%input: f32) -> (f8E4M3, f8E5M2, f16, bf16) {
  %result0 = scalar.fptrunc %input : f32 to f8E4M3
  %result1 = scalar.fptrunc %input : f32 to f8E5M2
  %result2 = scalar.fptrunc %input : f32 to f16
  %result3 = scalar.fptrunc %input : f32 to bf16
  func.return %result0, %result1, %result2, %result3 : f8E4M3, f8E5M2, f16, bf16
}

// ----
low.func.def target<vm.core> abi(vm_function) @truncate_single(%input: reg<vm.value : f32>) -> (reg<vm.value : f8E4M3>, reg<vm.value : f8E5M2>, reg<vm.value : f16>, reg<vm.value : bf16>) asm {
  %result0 = conversion.float.truncate %input, "f32.to.f8e4m3" : reg<vm.value : f8E4M3>
  %result1 = conversion.float.truncate %input, "f32.to.f8e5m2" : reg<vm.value : f8E5M2>
  %result2 = conversion.float.truncate %input, "f32.to.f16" : reg<vm.value : f16>
  %result3 = conversion.float.truncate %input, "f32.to.bf16" : reg<vm.value : bf16>
  return %result0, %result1, %result2, %result3
}

// ====

func.def @truncate_double(%input: f64) -> (f8E4M3, f8E5M2, f16, bf16) {
  %result0 = scalar.fptrunc %input : f64 to f8E4M3
  %result1 = scalar.fptrunc %input : f64 to f8E5M2
  %result2 = scalar.fptrunc %input : f64 to f16
  %result3 = scalar.fptrunc %input : f64 to bf16
  func.return %result0, %result1, %result2, %result3 : f8E4M3, f8E5M2, f16, bf16
}

// ----
low.func.def target<vm.core> abi(vm_function) @truncate_double(%input: reg<vm.value : f64>) -> (reg<vm.value : f8E4M3>, reg<vm.value : f8E5M2>, reg<vm.value : f16>, reg<vm.value : bf16>) asm {
  %result0 = conversion.float.truncate %input, "f64.to.f8e4m3" : reg<vm.value : f8E4M3>
  %result1 = conversion.float.truncate %input, "f64.to.f8e5m2" : reg<vm.value : f8E5M2>
  %result2 = conversion.float.truncate %input, "f64.to.f16" : reg<vm.value : f16>
  %result3 = conversion.float.truncate %input, "f64.to.bf16" : reg<vm.value : bf16>
  return %result0, %result1, %result2, %result3
}

// ====

func.def @narrow_bits(%byte: i8, %word: i16, %condition: i1) -> (i8, i16) {
  %e4m3 = scalar.bitcast %byte : i8 to f8E4M3
  %e5m2 = scalar.bitcast %byte : i8 to f8E5M2
  %other_byte = scalar.bitcast %e5m2 : f8E5M2 to f8E4M3
  %selected_byte = scf.select %condition, %e4m3, %other_byte : f8E4M3
  %byte_result = scalar.bitcast %selected_byte : f8E4M3 to i8
  %half = scalar.bitcast %word : i16 to f16
  %brain = scalar.bitcast %word : i16 to bf16
  %other_word = scalar.bitcast %brain : bf16 to f16
  %selected_word = scf.select %condition, %half, %other_word : f16
  %word_result = scalar.bitcast %selected_word : f16 to i16
  func.return %byte_result, %word_result : i8, i16
}

// ----
low.func.def target<vm.core> abi(vm_function) @narrow_bits(%byte: reg<vm.value : i8>, %word: reg<vm.value : i16>, %condition: reg<vm.value : i1>) -> (reg<vm.value : i8>, reg<vm.value : i16>) asm {
  %e4m3 = value.copy %byte : reg<vm.value : f8E4M3>
  %e5m2 = value.copy %byte : reg<vm.value : f8E5M2>
  %other_byte = value.copy %e5m2 : reg<vm.value : f8E4M3>
  %selected_byte = value.select %condition, %e4m3, %other_byte : reg<vm.value : f8E4M3>
  %byte_result = value.copy %selected_byte : reg<vm.value : i8>
  %half = value.copy %word : reg<vm.value : f16>
  %brain = value.copy %word : reg<vm.value : bf16>
  %other_word = value.copy %brain : reg<vm.value : f16>
  %selected_word = value.select %condition, %half, %other_word : reg<vm.value : f16>
  %word_result = value.copy %selected_word : reg<vm.value : i16>
  return %byte_result, %word_result
}

// ====

func.def @integer_to_bf16(%word: i32, %wide: i64) -> (bf16, bf16, bf16, bf16) {
  %signed_word = scalar.sitofp %word : i32 to bf16
  %unsigned_word = scalar.uitofp %word : i32 to bf16
  %signed_wide = scalar.sitofp %wide : i64 to bf16
  %unsigned_wide = scalar.uitofp %wide : i64 to bf16
  func.return %signed_word, %unsigned_word, %signed_wide, %unsigned_wide : bf16, bf16, bf16, bf16
}

// ----
low.func.def target<vm.core> abi(vm_function) @integer_to_bf16(%word: reg<vm.value : i32>, %wide: reg<vm.value : i64>) -> (reg<vm.value : bf16>, reg<vm.value : bf16>, reg<vm.value : bf16>, reg<vm.value : bf16>) asm {
  %signed_word = conversion.integer.to.float %word, "s32.to.bf16" : reg<vm.value : bf16>
  %unsigned_word = conversion.integer.to.float %word, "u32.to.bf16" : reg<vm.value : bf16>
  %signed_wide = conversion.integer.to.float %wide, "s64.to.bf16" : reg<vm.value : bf16>
  %unsigned_wide = conversion.integer.to.float %wide, "u64.to.bf16" : reg<vm.value : bf16>
  return %signed_word, %unsigned_word, %signed_wide, %unsigned_wide
}

// ====

func.def @narrow_constants() -> (i8, i16, f16, bf16) {
  %byte = scalar.constant -127 : i8
  %word = scalar.constant -32767 : i16
  %half = scalar.constant -1.5 : f16
  %brain = scalar.constant 1.25 : bf16
  func.return %byte, %word, %half, %brain : i8, i16, f16, bf16
}

// ----
low.func.def target<vm.core> abi(vm_function) @narrow_constants() -> (reg<vm.value : i8>, reg<vm.value : i16>, reg<vm.value : f16>, reg<vm.value : bf16>) asm {
  %byte = constant.i32 4294967169 : reg<vm.value : i8>
  %word = constant.i32 4294934529 : reg<vm.value : i16>
  %half = constant.i32 48640 : reg<vm.value : f16>
  %brain = constant.i32 16288 : reg<vm.value : bf16>
  return %byte, %word, %half, %brain
}

// ====

func.def @float8_constants() -> (f8E4M3, f8E5M2, f8E4M3, f8E5M2) {
  %finite_e4 = scalar.constant -1.5 : f8E4M3
  %finite_e5 = scalar.constant 1.25 : f8E5M2
  %zero_e4 = scalar.constant -0.0 : f8E4M3
  %zero_e5 = scalar.constant -0.0 : f8E5M2
  func.return %finite_e4, %finite_e5, %zero_e4, %zero_e5 : f8E4M3, f8E5M2, f8E4M3, f8E5M2
}

// ----
low.func.def target<vm.core> abi(vm_function) @float8_constants() -> (reg<vm.value : f8E4M3>, reg<vm.value : f8E5M2>, reg<vm.value : f8E4M3>, reg<vm.value : f8E5M2>) asm {
  %finite_e4 = constant.i32 188 : reg<vm.value : f8E4M3>
  %finite_e5 = constant.i32 61 : reg<vm.value : f8E5M2>
  %zero_e4 = constant.i32 128 : reg<vm.value : f8E4M3>
  %zero_e5 = constant.i32 128 : reg<vm.value : f8E5M2>
  return %finite_e4, %finite_e5, %zero_e4, %zero_e5
}

// ====

func.def @float_nan_constants() -> (f8E4M3, f8E5M2, f16, bf16, f32, f64) {
  %e4 = scalar.constant nan : f8E4M3
  %e5 = scalar.constant nan : f8E5M2
  %half = scalar.constant nan : f16
  %brain = scalar.constant nan : bf16
  %single = scalar.constant nan : f32
  %wide = scalar.constant nan : f64
  func.return %e4, %e5, %half, %brain, %single, %wide : f8E4M3, f8E5M2, f16, bf16, f32, f64
}

// ----
low.func.def target<vm.core> abi(vm_function) @float_nan_constants() -> (reg<vm.value : f8E4M3>, reg<vm.value : f8E5M2>, reg<vm.value : f16>, reg<vm.value : bf16>, reg<vm.value : f32>, reg<vm.value : f64>) asm {
  %e4 = constant.i32 127 : reg<vm.value : f8E4M3>
  %e5 = constant.i32 127 : reg<vm.value : f8E5M2>
  %half = constant.i32 32767 : reg<vm.value : f16>
  %brain = constant.i32 32767 : reg<vm.value : bf16>
  %single = constant.i32 2143289344 : reg<vm.value : f32>
  %wide = constant.i64 9221120237041090560 : reg<vm.value : f64>
  return %e4, %e5, %half, %brain, %single, %wide
}

// ====

func.def @float_conversion_paths(%e4: f8E4M3, %e5: f8E5M2, %half: f16, %brain: bf16) -> (f16, bf16, f64, f64, f8E4M3, f8E5M2, i8, i16, i32, i64) {
  %r0 = scalar.extf %e4 : f8E4M3 to f16
  %r1 = scalar.extf %e5 : f8E5M2 to bf16
  %r2 = scalar.extf %half : f16 to f64
  %r3 = scalar.extf %brain : bf16 to f64
  %r4 = scalar.fptrunc %half : f16 to f8E4M3
  %r5 = scalar.fptrunc %brain : bf16 to f8E5M2
  %r6 = scalar.fptosi %e5 : f8E5M2 to i8
  %r7 = scalar.fptoui %half : f16 to i16
  %r8 = scalar.fptosi %brain : bf16 to i32
  %r9 = scalar.fptoui %e4 : f8E4M3 to i64
  func.return %r0, %r1, %r2, %r3, %r4, %r5, %r6, %r7, %r8, %r9 : f16, bf16, f64, f64, f8E4M3, f8E5M2, i8, i16, i32, i64
}

// ----
low.func.def target<vm.core> abi(vm_function) @float_conversion_paths(%e4: reg<vm.value : f8E4M3>, %e5: reg<vm.value : f8E5M2>, %half: reg<vm.value : f16>, %brain: reg<vm.value : bf16>) -> (reg<vm.value : f16>, reg<vm.value : bf16>, reg<vm.value : f64>, reg<vm.value : f64>, reg<vm.value : f8E4M3>, reg<vm.value : f8E5M2>, reg<vm.value : i8>, reg<vm.value : i16>, reg<vm.value : i32>, reg<vm.value : i64>) asm {
  %38 = conversion.float.extend %e4, "f8e4m3.to.f32" : reg<vm.value : f32>
  %r0 = conversion.float.truncate %38, "f32.to.f16" : reg<vm.value : f16>
  %40 = conversion.float.extend %e5, "f8e5m2.to.f32" : reg<vm.value : f32>
  %r1 = conversion.float.truncate %40, "f32.to.bf16" : reg<vm.value : bf16>
  %42 = conversion.float.extend %half, "f16.to.f32" : reg<vm.value : f32>
  %r2 = conversion.float.width %42, "f32.to.f64" : reg<vm.value : f64>
  %44 = conversion.float.extend %brain, "bf16.to.f32" : reg<vm.value : f32>
  %r3 = conversion.float.width %44, "f32.to.f64" : reg<vm.value : f64>
  %r4 = conversion.float.truncate %42, "f32.to.f8e4m3" : reg<vm.value : f8E4M3>
  %r5 = conversion.float.truncate %44, "f32.to.f8e5m2" : reg<vm.value : f8E5M2>
  %r6 = conversion.float.to.integer %40, "f32.to.s8" : reg<vm.value : i8>
  %r7 = conversion.float.to.integer %42, "f32.to.u16" : reg<vm.value : i16>
  %r8 = conversion.float.to.integer %44, "f32.to.s32" : reg<vm.value : i32>
  %r9 = conversion.float.to.integer %38, "f32.to.u64"
  return %r0, %r1, %r2, %r3, %r4, %r5, %r6, %r7, %r8, %r9
}

// ====

func.def @small_integer_float(%flag: i1, %byte: i8, %word: i16) -> (f8E4M3, f16, f32, f64, bf16, bf16, f8E5M2) {
  %r0 = scalar.sitofp %flag : i1 to f8E4M3
  %r1 = scalar.uitofp %flag : i1 to f16
  %r2 = scalar.sitofp %byte : i8 to f32
  %r3 = scalar.uitofp %byte : i8 to f64
  %r4 = scalar.sitofp %word : i16 to bf16
  %r5 = scalar.uitofp %word : i16 to bf16
  %r6 = scalar.sitofp %byte : i8 to f8E5M2
  func.return %r0, %r1, %r2, %r3, %r4, %r5, %r6 : f8E4M3, f16, f32, f64, bf16, bf16, f8E5M2
}

// ----
low.func.def target<vm.core> abi(vm_function) @small_integer_float(%flag: reg<vm.value : i1>, %byte: reg<vm.value : i8>, %word: reg<vm.value : i16>) -> (reg<vm.value : f8E4M3>, reg<vm.value : f16>, reg<vm.value : f32>, reg<vm.value : f64>, reg<vm.value : bf16>, reg<vm.value : bf16>, reg<vm.value : f8E5M2>) asm {
  %27 = conversion.integer %flag, "s1.to.i32" : reg<vm.value : i32>
  %28 = conversion.integer.to.float %27, "s32.to.f32" : reg<vm.value : f32>
  %r0 = conversion.float.truncate %28, "f32.to.f8e4m3" : reg<vm.value : f8E4M3>
  %30 = conversion.integer %flag, "u1.to.i32" : reg<vm.value : i32>
  %31 = conversion.integer.to.float %30, "u32.to.f32" : reg<vm.value : f32>
  %r1 = conversion.float.truncate %31, "f32.to.f16" : reg<vm.value : f16>
  %33 = conversion.integer %byte, "s8.to.i32" : reg<vm.value : i32>
  %r2 = conversion.integer.to.float %33, "s32.to.f32" : reg<vm.value : f32>
  %35 = conversion.integer %byte, "u8.to.i32" : reg<vm.value : i32>
  %r3 = conversion.integer.to.float %35, "u32.to.f64" : reg<vm.value : f64>
  %37 = conversion.integer %word, "s16.to.i32" : reg<vm.value : i32>
  %r4 = conversion.integer.to.float %37, "s32.to.bf16" : reg<vm.value : bf16>
  %39 = conversion.integer %word, "u16.to.i32" : reg<vm.value : i32>
  %r5 = conversion.integer.to.float %39, "u32.to.bf16" : reg<vm.value : bf16>
  %r6 = conversion.float.truncate %r2, "f32.to.f8e5m2" : reg<vm.value : f8E5M2>
  return %r0, %r1, %r2, %r3, %r4, %r5, %r6
}

// ====

func.def @wide_integer_narrow_float(%wide: i64) -> (f16, f8E4M3, f8E5M2, f16, f8E4M3, f8E5M2) {
  %r0 = scalar.sitofp %wide : i64 to f16
  %r1 = scalar.sitofp %wide : i64 to f8E4M3
  %r2 = scalar.sitofp %wide : i64 to f8E5M2
  %r3 = scalar.uitofp %wide : i64 to f16
  %r4 = scalar.uitofp %wide : i64 to f8E4M3
  %r5 = scalar.uitofp %wide : i64 to f8E5M2
  func.return %r0, %r1, %r2, %r3, %r4, %r5 : f16, f8E4M3, f8E5M2, f16, f8E4M3, f8E5M2
}

// ----
low.func.def target<vm.core> abi(vm_function) @wide_integer_narrow_float(%wide: reg<vm.value : i64>) -> (reg<vm.value : f16>, reg<vm.value : f8E4M3>, reg<vm.value : f8E5M2>, reg<vm.value : f16>, reg<vm.value : f8E4M3>, reg<vm.value : f8E5M2>) asm {
  %20 = conversion.integer.to.float %wide, "s64.to.f32" : reg<vm.value : f32>
  %r0 = conversion.float.truncate %20, "f32.to.f16" : reg<vm.value : f16>
  %r1 = conversion.float.truncate %20, "f32.to.f8e4m3" : reg<vm.value : f8E4M3>
  %r2 = conversion.float.truncate %20, "f32.to.f8e5m2" : reg<vm.value : f8E5M2>
  %26 = conversion.integer.to.float %wide, "u64.to.f32" : reg<vm.value : f32>
  %r3 = conversion.float.truncate %26, "f32.to.f16" : reg<vm.value : f16>
  %r4 = conversion.float.truncate %26, "f32.to.f8e4m3" : reg<vm.value : f8E4M3>
  %r5 = conversion.float.truncate %26, "f32.to.f8e5m2" : reg<vm.value : f8E5M2>
  return %r0, %r1, %r2, %r3, %r4, %r5
}
