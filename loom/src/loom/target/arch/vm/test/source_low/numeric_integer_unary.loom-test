// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_integer_unary.loom-test
// RUN: emit source-low target=vm:core output=low

func.def @integer_unary_i32(%value: i32) -> (i32, i32, i32, i32, i32) {
  %negated = scalar.negi %value : i32
  %absolute = scalar.absi %value : i32
  %leading = scalar.ctlzi %value : i32
  %trailing = scalar.cttzi %value : i32
  %population = scalar.ctpopi %value : i32
  func.return %negated, %absolute, %leading, %trailing, %population : i32, i32, i32, i32, i32
}

// ----
low.func.def target<vm.core> abi(vm_function) @integer_unary_i32(%value: reg<vm.value : i32>) -> (reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>) asm {
  %negated = integer.neg.i32 %value
  %absolute = integer.abs.s32 %value
  %leading = integer.count.leading.zeros.i32 %value
  %trailing = integer.count.trailing.zeros.i32 %value
  %population = integer.popcount.i32 %value
  return %negated, %absolute, %leading, %trailing, %population
}

// ====

func.def @integer_unary_i64(%value: i64) -> (i64, i64, i64, i64, i64) {
  %negated = scalar.negi %value : i64
  %absolute = scalar.absi %value : i64
  %leading = scalar.ctlzi %value : i64
  %trailing = scalar.cttzi %value : i64
  %population = scalar.ctpopi %value : i64
  func.return %negated, %absolute, %leading, %trailing, %population : i64, i64, i64, i64, i64
}

// ----
low.func.def target<vm.core> abi(vm_function) @integer_unary_i64(%value: reg<vm.value : i64>) -> (reg<vm.value : i64>, reg<vm.value : i64>, reg<vm.value : i64>, reg<vm.value : i64>, reg<vm.value : i64>) asm {
  %negated = integer.neg.i64 %value
  %absolute = integer.abs.s64 %value
  %leading = integer.count.leading.zeros.i64 %value
  %trailing = integer.count.trailing.zeros.i64 %value
  %population = integer.popcount.i64 %value
  return %negated, %absolute, %leading, %trailing, %population
}
