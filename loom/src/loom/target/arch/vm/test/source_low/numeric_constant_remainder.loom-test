// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_constant_remainder.loom-test
// RUN: emit source-low target=vm:core output=low

func.def @constant_remainder_uniform(%value: i32) -> (i32) {
  %divisor = scalar.constant 3 : i32
  %remainder = scalar.remui %value, %divisor : i32
  func.return %remainder : i32
}

// ----
low.func.def target<vm.core> abi(vm_function) @constant_remainder_uniform(%value: reg<vm.value : i32>) -> (reg<vm.value : i32>) asm {
  %divisor = constant.i32 3
  %remainder = integer.rem.u32 %value, %divisor
  return %remainder
}

// ====

func.def @constant_remainder_loaded(%input: buffer) -> (i32, index) {
  %base = index.constant 0 : offset
  %aligned_input = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %input_view = buffer.view %aligned_input[%base] : buffer -> view<1xi32>
  %value = view.load %input_view[0] : view<1xi32> -> i32
  %divisor = scalar.constant 3 : i32
  %remainder = scalar.remui %value, %divisor : i32
  %mask = scalar.constant 2147483647 : i32
  %nonnegative = scalar.andi %value, %mask : i32
  %position = index.cast %nonnegative : i32 to index
  %index_divisor = index.constant 3 : index
  %index_remainder = index.rem %position, %index_divisor : index
  func.return %remainder, %index_remainder : i32, index
}

// ----
low.func.def target<vm.core> abi(vm_function) @constant_remainder_loaded(%input_view: reg<vm.ref : buffer>) -> (reg<vm.value : i32>, reg<vm.value : i64>) asm {
  %17 = constant.i64 0
  %value = buffer.load %input_view, %17, %17, 0, "i32.x1" : reg<vm.value : i32>
  %divisor = constant.i32 3
  %remainder = integer.rem.u32 %value, %divisor
  %mask = constant.i32 2147483647
  %nonnegative = integer.and.i32 %value, %mask
  %position = conversion.integer %nonnegative, "s32.to.i64"
  %index_divisor = constant.i64 3
  %index_remainder = integer.rem.u64 %position, %index_divisor
  return %remainder, %index_remainder
}

// ====

func.def @constant_remainder_factors(%word: i32, %position: index) -> (i32, i32, index, index) {
  %bounded = index.assume %position [range(%position, 0, 4294967295)] : index
  %c5 = scalar.constant 5 : i32
  %c9 = scalar.constant 9 : i32
  %c5_index = index.constant 5 : index
  %c9_index = index.constant 9 : index
  %word_five = scalar.remui %word, %c5 : i32
  %word_nine = scalar.remui %word, %c9 : i32
  %position_five = index.rem %bounded, %c5_index : index
  %position_nine = index.rem %bounded, %c9_index : index
  func.return %word_five, %word_nine, %position_five, %position_nine : i32, i32, index, index
}

// ----
low.func.def target<vm.core> abi(vm_function) @constant_remainder_factors(%word: reg<vm.value : i32>, %bounded: reg<vm.value : i64>) -> (reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i64>, reg<vm.value : i64>) asm {
  %c5 = constant.i32 5
  %c9 = constant.i32 9
  %c5_index = constant.i64 5
  %c9_index = constant.i64 9
  %word_five = integer.rem.u32 %word, %c5
  %word_nine = integer.rem.u32 %word, %c9
  %position_five = integer.rem.u64 %bounded, %c5_index
  %position_nine = integer.rem.u64 %bounded, %c9_index
  return %word_five, %word_nine, %position_five, %position_nine
}

// ====

func.def @constant_remainder_by_seven(%word: i32, %position: index) -> (i32, index, i32, index) {
  %bounded = index.assume %position [range(%position, 0, 4294967295)] : index
  %word_divisor = scalar.constant 7 : i32
  %index_divisor = index.constant 7 : index
  %word_remainder = scalar.remui %word, %word_divisor : i32
  %index_remainder = index.rem %bounded, %index_divisor : index
  func.return %word_remainder, %index_remainder, %word, %bounded : i32, index, i32, index
}

// ----
low.func.def target<vm.core> abi(vm_function) @constant_remainder_by_seven(%word: reg<vm.value : i32>, %bounded: reg<vm.value : i64>) -> (reg<vm.value : i32>, reg<vm.value : i64>, reg<vm.value : i32>, reg<vm.value : i64>) asm {
  %word_divisor = constant.i32 7
  %index_divisor = constant.i64 7
  %word_remainder = integer.rem.u32 %word, %word_divisor
  %index_remainder = integer.rem.u64 %bounded, %index_divisor
  return %word_remainder, %index_remainder, %word, %bounded
}
