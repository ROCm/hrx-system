load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")
load("//loom/build_tools/bazel:loom_check.bzl", "loom_check_test", "loom_check_test_suite")

package(
    default_visibility = ["//visibility:private"],
    licenses = ["notice"],  # Apache 2.0
)

loom_check_test_suite(
    name = "test",
    srcs = glob(
        ["*.loom-test"],
        exclude = ["callable_policy.loom-test"],
    ),
    target_compatible_with = loom_config_compatible_with(["//loom/config/arch:vm"]),
)

loom_check_test(
    name = "callable_policy_test",
    src = "callable_policy.loom-test",
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/emit:vm_binary",
    ]),
)

loom_check_test_suite(
    name = "cxx_test",
    srcs = [
        "vm_lowering.cxx-test",
    ],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/import:cxx",
        "//loom/config/arch:vm",
    ]),
)
