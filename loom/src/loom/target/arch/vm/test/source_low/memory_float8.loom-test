// TEMPLATE: loom/src/loom/test/corpus/source_low/memory_float8.loom
// RUN: emit source-low target=vm:core output=low

// Both FP8 formats retain their bytes, including NaN payloads, through storage.
func.def @copy_float8_scalar(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source_e4m3 = buffer.view %input[%base] : buffer -> view<8xf8E4M3>
  %source_e5m2 = buffer.view %input[%base] : buffer -> view<8xf8E5M2>
  %target_e4m3 = buffer.view %output[%base] : buffer -> view<8xf8E4M3>
  %target_e5m2 = buffer.view %output[%base] : buffer -> view<8xf8E5M2>
  %e4m3 = view.load %source_e4m3[3] : view<8xf8E4M3> -> f8E4M3
  %e5m2 = view.load %source_e5m2[5] : view<8xf8E5M2> -> f8E5M2
  view.store %e4m3, %target_e4m3[3] : f8E4M3, view<8xf8E4M3>
  view.store %e5m2, %target_e5m2[5] : f8E5M2, view<8xf8E5M2>
  func.return
}

// ----
low.func.def target<vm.core> abi(vm_function) @copy_float8_scalar(%source_e5m2: reg<vm.ref : buffer>, %target_e5m2: reg<vm.ref : buffer>) asm {
  %11 = constant.i64 3
  %e4m3 = buffer.load %source_e5m2, %11, %11, 0, "i8.x1" : reg<vm.value : f8E4M3>
  %13 = constant.i64 5
  %e5m2 = buffer.load %source_e5m2, %13, %13, 0, "i8.x1" : reg<vm.value : f8E5M2>
  buffer.store %target_e5m2, %11, %11, %e4m3, 0, "i8.x1"
  buffer.store %target_e5m2, %13, %13, %e5m2, 0, "i8.x1"
  return
}

// ====

// Full-register copies use the same physical transfers as integer bytes.
func.def @copy_float8_vector(%input: buffer, %output: buffer) {
  %first = index.constant 0 : offset
  %second = index.constant 16 : offset
  %source_e4m3 = buffer.view %input[%first] : buffer -> view<16xf8E4M3>
  %source_e5m2 = buffer.view %input[%second] : buffer -> view<16xf8E5M2>
  %target_e4m3 = buffer.view %output[%first] : buffer -> view<16xf8E4M3>
  %target_e5m2 = buffer.view %output[%second] : buffer -> view<16xf8E5M2>
  %e4m3 = vector.load %source_e4m3[0] : view<16xf8E4M3> -> vector<16xf8E4M3>
  %e5m2 = vector.load %source_e5m2[0] : view<16xf8E5M2> -> vector<16xf8E5M2>
  vector.store %e4m3, %target_e4m3[0] : vector<16xf8E4M3>, view<16xf8E4M3>
  vector.store %e5m2, %target_e5m2[0] : vector<16xf8E5M2>, view<16xf8E5M2>
  func.return
}

