  %29 = float.math.ternary.f32 %27, %28, %acc, fma : reg<vm.value : f32>
  %30 = slice %lhs[1] : reg<vm.value x4 : vector<4xf32>> -> reg<vm.value : f32>
  %31 = slice %rhs[1] : reg<vm.value x4 : vector<4xf32>> -> reg<vm.value : f32>
  %32 = float.math.ternary.f32 %30, %31, %29, fma : reg<vm.value : f32>
  %33 = slice %lhs[2] : reg<vm.value x4 : vector<4xf32>> -> reg<vm.value : f32>
  %34 = slice %rhs[2] : reg<vm.value x4 : vector<4xf32>> -> reg<vm.value : f32>
  %35 = float.math.ternary.f32 %33, %34, %32, fma : reg<vm.value : f32>
  %36 = slice %lhs[3] : reg<vm.value x4 : vector<4xf32>> -> reg<vm.value : f32>
  %37 = slice %rhs[3] : reg<vm.value x4 : vector<4xf32>> -> reg<vm.value : f32>
  %dot = float.math.ternary.f32 %36, %37, %35, fma : reg<vm.value : f32>
  %inside = integer.compare.i32 %lane, %limit, slt : reg<vm.value : i1>
  %selected = value.select %inside, %dot, %acc : reg<vm.value : f32>
  return %selected
}
