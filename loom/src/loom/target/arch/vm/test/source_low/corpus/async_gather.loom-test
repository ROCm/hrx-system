vm.target<core> @target
kernel.def target(@target) @async_gather_dword() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%input: buffer) {
  %tid = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %bytes = index.constant 256 : offset
  %global = buffer.assume.memory_space<global> %input : buffer
  %source_base = buffer.view %global[%buffer_base] : buffer -> view<64x4xi8>
  %source = view.subview %source_base[%tid, 0] : view<64x4xi8> -> view<1x4xi8>
  %scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  %dest = buffer.view %scratch[%buffer_base] : buffer -> view<64x1x4xi8>
  %copy = kernel.async.gather %source to %dest {cache_scope = device, cache_temporal = regular} : view<1x4xi8> to view<64x1x4xi8> -> kernel.async.token
  %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
  kernel.async.wait %group {newer_groups = 0} : kernel.async.group
  kernel.return
}

