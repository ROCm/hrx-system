// RUN: pass vm-materialize-call-abi

vm.target<core> @target

low.func.def target<vm.core>(@target) abi(vm_function) @return_input(%input: reg<vm.value : i32>) -> (reg<vm.value : i32>) asm {
  return %input
}

// ----
vm.target<core> @target

low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = (reg<vm.value : i32>) -> (reg<vm.value : i32>)}) @return_input(%input: reg<vm.value : i32>) -> (reg<vm.value : i32>) asm {
  %2 = copy %input : reg<vm.value : i32> -> reg<vm.value : i32>
  %3 = copy %2 : reg<vm.value : i32> -> reg<vm.value : i32>
  return %3
}

// ====

// RUN: pass vm-materialize-call-abi

vm.target<core> @target

low.func.def target<vm.core>(@target) abi(vm_function) @callee(%input: reg<vm.value : i32>) -> (reg<vm.value : i32>) asm {
  %one = constant.s16 1 : reg<vm.value : i32>
  %result = integer.add.i32 %input, %one : reg<vm.value : i32>
  return %result
}

low.func.def target<vm.core>(@target) abi(vm_function) @caller(%input: reg<vm.value : i32>) -> (reg<vm.value : i32>) asm {
  %result = low.func.call @callee(%input) : (reg<vm.value : i32>) -> (reg<vm.value : i32>)
  %sum = integer.add.i32 %result, %input : reg<vm.value : i32>
  return %sum
}

// ----
vm.target<core> @target

low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = (reg<vm.value : i32>) -> (reg<vm.value : i32>)}) @callee(%input: reg<vm.value : i32>) -> (reg<vm.value : i32>) asm {
  %8 = copy %input : reg<vm.value : i32> -> reg<vm.value : i32>
  %one = constant.s16 1 : reg<vm.value : i32>
  %result = integer.add.i32 %8, %one : reg<vm.value : i32>
  %9 = copy %result : reg<vm.value : i32> -> reg<vm.value : i32>
  return %9
}

low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = (reg<vm.value : i32>) -> (reg<vm.value : i32>)}) @caller(%input: reg<vm.value : i32>) -> (reg<vm.value : i32>) asm {
  %10 = copy %input : reg<vm.value : i32> -> reg<vm.value : i32>
  %11 = copy %10 : reg<vm.value : i32> -> reg<vm.value : i32>
  %result = low.func.call @callee(%11) : (reg<vm.value : i32>) -> (reg<vm.value : i32>)
  %12 = copy %result : reg<vm.value : i32> -> reg<vm.value : i32>
  %sum = integer.add.i32 %12, %10 : reg<vm.value : i32>
  %13 = copy %sum : reg<vm.value : i32> -> reg<vm.value : i32>
  return %13
}

// ====

// RUN: pass vm-materialize-call-abi

vm.target<core> @target

low.func.def target<vm.core>(@target) abi(vm_function) @empty() asm {
  return
}

// ----
vm.target<core> @target

low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = () -> ()}) @empty() asm {
  return
}

// ====

// RUN: pass vm-materialize-call-abi

vm.target<core> @target

low.func.def target<vm.core>(@target) abi(vm_function) @mixed_banks(%value: reg<vm.value : i32>, %buffer: reg<vm.ref : hal.buffer>, %callback: reg<vm.function : func.ref<(i32) -> (i32)>>) -> (reg<vm.function : func.ref<(i32) -> (i32)>>, reg<vm.value : i32>, reg<vm.ref : hal.buffer>) asm {
  return %callback, %value, %buffer
}

// ----
vm.target<core> @target

low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = (reg<vm.value : i32>, reg<vm.ref : hal.buffer>, reg<vm.function : func.ref<(i32) -> (i32)>>) -> (reg<vm.function : func.ref<(i32) -> (i32)>>, reg<vm.value : i32>, reg<vm.ref : hal.buffer>)}) @mixed_banks(%value: reg<vm.value : i32>, %buffer: reg<vm.ref : hal.buffer>, %callback: reg<vm.function : func.ref<(i32) -> (i32)>>) -> (reg<vm.function : func.ref<(i32) -> (i32)>>, reg<vm.value : i32>, reg<vm.ref : hal.buffer>) asm {
  %6 = copy %value : reg<vm.value : i32> -> reg<vm.value : i32>
  %7 = move %buffer : reg<vm.ref : hal.buffer> -> reg<vm.ref : hal.buffer>
  %8 = copy %callback : reg<vm.function : func.ref<(i32) -> (i32)>> -> reg<vm.function : func.ref<(i32) -> (i32)>>
  %9 = copy %8 : reg<vm.function : func.ref<(i32) -> (i32)>> -> reg<vm.function : func.ref<(i32) -> (i32)>>
  %10 = copy %6 : reg<vm.value : i32> -> reg<vm.value : i32>
  %11 = move %7 : reg<vm.ref : hal.buffer> -> reg<vm.ref : hal.buffer>
  return %9, %10, %11
}
