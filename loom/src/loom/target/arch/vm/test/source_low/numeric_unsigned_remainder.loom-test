// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_unsigned_remainder.loom-test
// RUN: with-checks emit source-low target=vm:core output=low

func.def @unsigned_remainder_i32(%value: i32, %divisor: i32) -> (i32) {
  %remainder = scalar.remui %value, %divisor : i32
  func.return %remainder : i32
}

// ----
CHECK: %* = integer.rem.u32 *
CHECK: return %remainder

// ====

func.def @unsigned_remainder_i64(%value: i64, %divisor: i64) -> (i64) {
  %remainder = scalar.remui %value, %divisor : i64
  func.return %remainder : i64
}

// ----
CHECK: %* = integer.rem.u64 *
CHECK: return %remainder

// ====

func.def @unsigned_remainder_index(%value: index, %divisor: index) -> (index) {
  %bounded_value = index.assume %value [range(%value, 0, 4294967295)] : index
  %bounded_divisor = index.assume %divisor [range(%divisor, 1, 4294967295)] : index
  %remainder = index.rem %bounded_value, %bounded_divisor : index
  func.return %remainder : index
}

// ----
CHECK: %* = integer.rem.u64 *
CHECK: return %remainder
