// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_scalar_conversion.loom-test
// RUN: emit source-low target=vm:core output=low

func.def @integer_widths(%boolean: i1, %word: i32, %wide: i64) -> (i32, i64, i64, i64, i1, i32) {
  %signed_boolean = scalar.extsi %boolean : i1 to i32
  %unsigned_boolean = scalar.extui %boolean : i1 to i64
  %signed_word = scalar.extsi %word : i32 to i64
  %unsigned_word = scalar.extui %word : i32 to i64
  %low_bit = scalar.trunci %wide : i64 to i1
  %low_word = scalar.trunci %wide : i64 to i32
  func.return %signed_boolean, %unsigned_boolean, %signed_word, %unsigned_word, %low_bit, %low_word : i32, i64, i64, i64, i1, i32
}

// ----
low.func.def target<vm.core> abi(vm_function) @integer_widths(%boolean: reg<vm.value : i1>, %word: reg<vm.value : i32>, %wide: reg<vm.value : i64>) -> (reg<vm.value : i32>, reg<vm.value : i64>, reg<vm.value : i64>, reg<vm.value : i64>, reg<vm.value : i1>, reg<vm.value : i32>) asm {
  %signed_boolean = conversion.integer %boolean, "s1.to.i32" : reg<vm.value : i32>
  %unsigned_boolean = conversion.integer %boolean, "u1.to.i64"
  %signed_word = conversion.integer %word, "s32.to.i64"
  %unsigned_word = conversion.integer %word, "u32.to.i64"
  %low_bit = conversion.integer %wide, "i64.to.i1" : reg<vm.value : i1>
  %low_word = conversion.integer %wide, "i64.to.i32" : reg<vm.value : i32>
  return %signed_boolean, %unsigned_boolean, %signed_word, %unsigned_word, %low_bit, %low_word
}

// ====

func.def @float_widths(%single: f32, %double: f64) -> (f64, f32) {
  %wide = scalar.extf %single : f32 to f64
  %narrow = scalar.fptrunc %double : f64 to f32
  func.return %wide, %narrow : f64, f32
}

// ----
low.func.def target<vm.core> abi(vm_function) @float_widths(%single: reg<vm.value : f32>, %double: reg<vm.value : f64>) -> (reg<vm.value : f64>, reg<vm.value : f32>) asm {
  %wide = conversion.float.width %single, "f32.to.f64" : reg<vm.value : f64>
  %narrow = conversion.float.width %double, "f64.to.f32" : reg<vm.value : f32>
  return %wide, %narrow
}

// ====

func.def @integer_to_float(%word: i32, %wide: i64) -> (f32, f64, f32, f64, f32, f64, f32, f64) {
  %signed_word_f32 = scalar.sitofp %word : i32 to f32
  %signed_word_f64 = scalar.sitofp %word : i32 to f64
  %unsigned_word_f32 = scalar.uitofp %word : i32 to f32
  %unsigned_word_f64 = scalar.uitofp %word : i32 to f64
  %signed_wide_f32 = scalar.sitofp %wide : i64 to f32
  %signed_wide_f64 = scalar.sitofp %wide : i64 to f64
  %unsigned_wide_f32 = scalar.uitofp %wide : i64 to f32
  %unsigned_wide_f64 = scalar.uitofp %wide : i64 to f64
  func.return %signed_word_f32, %signed_word_f64, %unsigned_word_f32, %unsigned_word_f64, %signed_wide_f32, %signed_wide_f64, %unsigned_wide_f32, %unsigned_wide_f64 : f32, f64, f32, f64, f32, f64, f32, f64
}

// ----
low.func.def target<vm.core> abi(vm_function) @integer_to_float(%word: reg<vm.value : i32>, %wide: reg<vm.value : i64>) -> (reg<vm.value : f32>, reg<vm.value : f64>, reg<vm.value : f32>, reg<vm.value : f64>, reg<vm.value : f32>, reg<vm.value : f64>, reg<vm.value : f32>, reg<vm.value : f64>) asm {
  %signed_word_f32 = conversion.integer.to.float %word, "s32.to.f32" : reg<vm.value : f32>
  %signed_word_f64 = conversion.integer.to.float %word, "s32.to.f64" : reg<vm.value : f64>
  %unsigned_word_f32 = conversion.integer.to.float %word, "u32.to.f32" : reg<vm.value : f32>
  %unsigned_word_f64 = conversion.integer.to.float %word, "u32.to.f64" : reg<vm.value : f64>
  %signed_wide_f32 = conversion.integer.to.float %wide, "s64.to.f32" : reg<vm.value : f32>
  %signed_wide_f64 = conversion.integer.to.float %wide, "s64.to.f64" : reg<vm.value : f64>
  %unsigned_wide_f32 = conversion.integer.to.float %wide, "u64.to.f32" : reg<vm.value : f32>
  %unsigned_wide_f64 = conversion.integer.to.float %wide, "u64.to.f64" : reg<vm.value : f64>
  return %signed_word_f32, %signed_word_f64, %unsigned_word_f32, %unsigned_word_f64, %signed_wide_f32, %signed_wide_f64, %unsigned_wide_f32, %unsigned_wide_f64
}

// ====

func.def @float_to_integer(%single: f32, %double: f64) -> (i32, i64, i32, i64, i32, i64, i32, i64) {
  %signed_single_i32 = scalar.fptosi %single : f32 to i32
  %signed_single_i64 = scalar.fptosi %single : f32 to i64
  %unsigned_single_i32 = scalar.fptoui %single : f32 to i32
  %unsigned_single_i64 = scalar.fptoui %single : f32 to i64
  %signed_double_i32 = scalar.fptosi %double : f64 to i32
  %signed_double_i64 = scalar.fptosi %double : f64 to i64
  %unsigned_double_i32 = scalar.fptoui %double : f64 to i32
  %unsigned_double_i64 = scalar.fptoui %double : f64 to i64
  func.return %signed_single_i32, %signed_single_i64, %unsigned_single_i32, %unsigned_single_i64, %signed_double_i32, %signed_double_i64, %unsigned_double_i32, %unsigned_double_i64 : i32, i64, i32, i64, i32, i64, i32, i64
}

// ----
low.func.def target<vm.core> abi(vm_function) @float_to_integer(%single: reg<vm.value : f32>, %double: reg<vm.value : f64>) -> (reg<vm.value : i32>, reg<vm.value : i64>, reg<vm.value : i32>, reg<vm.value : i64>, reg<vm.value : i32>, reg<vm.value : i64>, reg<vm.value : i32>, reg<vm.value : i64>) asm {
  %signed_single_i32 = conversion.float.to.integer %single, "f32.to.s32" : reg<vm.value : i32>
  %signed_single_i64 = conversion.float.to.integer %single, "f32.to.s64"
  %unsigned_single_i32 = conversion.float.to.integer %single, "f32.to.u32" : reg<vm.value : i32>
  %unsigned_single_i64 = conversion.float.to.integer %single, "f32.to.u64"
  %signed_double_i32 = conversion.float.to.integer %double, "f64.to.s32" : reg<vm.value : i32>
  %signed_double_i64 = conversion.float.to.integer %double, "f64.to.s64"
  %unsigned_double_i32 = conversion.float.to.integer %double, "f64.to.u32" : reg<vm.value : i32>
  %unsigned_double_i64 = conversion.float.to.integer %double, "f64.to.u64"
  return %signed_single_i32, %signed_single_i64, %unsigned_single_i32, %unsigned_single_i64, %signed_double_i32, %signed_double_i64, %unsigned_double_i32, %unsigned_double_i64
}
