vm.target<core> @target
kernel.def target(@target) @i32_shift() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<64xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<64xi32>
  %loaded = vector.load %input_view[%lane] : view<64xi32> -> vector<1xi32>
  %shift = vector.constant 3 : vector<1xi32>
  %left = vector.shli %loaded, %shift : vector<1xi32>
  %logical = vector.shrui %loaded, %shift : vector<1xi32>
  %arithmetic = vector.shrsi %loaded, %shift : vector<1xi32>
  %joined = vector.ori %left, %logical : vector<1xi32>
  %result = vector.xori %joined, %arithmetic : vector<1xi32>
  vector.store %result, %output_view[%lane] : vector<1xi32>, view<64xi32>
  kernel.return
}

