// ====

vm.target<core> @target
func.def target(@target) @scalar_i64_literals() -> (i64, i64) {
  %s16_min = scalar.constant -32768 : i64
  %below_s16 = scalar.constant -32769 : i64
  func.return %s16_min, %below_s16 : i64, i64
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) @scalar_i64_literals() -> (reg<vm.value : i64>, reg<vm.value : i64>) asm {
  %s16_min = constant.s16 -32768 : reg<vm.value : i64>
  %below_s16 = constant.i64 4294934527, 4294967295 : reg<vm.value : i64>
  return %s16_min, %below_s16
}

// ====

vm.target<core> @target
func.def target(@target) @index_literals() -> (index, index, index) {
  %negative = index.constant -1 : index
  %u32_max = index.constant 4294967295 : index
  %above_u32 = index.constant 4294967296 : index
  func.return %negative, %u32_max, %above_u32 : index, index, index
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) @index_literals() -> (reg<vm.value : index>, reg<vm.value : index>, reg<vm.value : index>) asm {
  %negative = constant.s16 -1 : reg<vm.value : index>
  %u32_max = constant.i32 4294967295 : reg<vm.value : index>
  %above_u32 = constant.i64 0, 1 : reg<vm.value : index>
  return %negative, %u32_max, %above_u32
}

