// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_scalar_literals.loom-test
// RUN: emit source-low output=low

vm.target<core> @target
func.def target(@target) @scalar_i1_literals() -> (i1, i1) {
  %true = scalar.constant true : i1
  %false = scalar.constant false : i1
  func.return %true, %false : i1, i1
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) @scalar_i1_literals() -> (reg<vm.value : i1>, reg<vm.value : i1>) asm {
  %true = constant.s16 1 : reg<vm.value : i1>
  %false = constant.zero : reg<vm.value : i1>
  return %true, %false
}

