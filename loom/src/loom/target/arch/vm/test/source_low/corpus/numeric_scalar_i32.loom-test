// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_scalar_i32.loom-test
// RUN: emit source-low output=low

vm.target<core> @target
func.def target(@target) @scalar_i32_uniform_sgpr(%lhs: i32, %rhs: i32, %shift: i32) -> (i32) {
  %add = scalar.addi %lhs, %rhs : i32
  %sub = scalar.subi %add, %rhs : i32
  %product = scalar.muli %sub, %rhs : i32
  %and = scalar.andi %product, %lhs : i32
  %or = scalar.ori %and, %rhs : i32
  %xor = scalar.xori %or, %lhs : i32
  %shl = scalar.shli %xor, %shift : i32
  %ashr = scalar.shrsi %shl, %shift : i32
  %lshr = scalar.shrui %ashr, %shift : i32
  func.return %lshr : i32
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>) -> (reg<vm.value : i32>)>}) @scalar_i32_uniform_sgpr(%lhs: reg<vm.value : i32>, %rhs: reg<vm.value : i32>, %shift: reg<vm.value : i32>) -> (reg<vm.value : i32>) asm {
  %product = integer.mul.i32 %lhs, %rhs : reg<vm.value : i32>
  %and = integer.and.i32 %product, %lhs : reg<vm.value : i32>
  %or = integer.or.i32 %and, %rhs : reg<vm.value : i32>
  %xor = integer.xor.i32 %or, %lhs : reg<vm.value : i32>
  %shl = integer.shift.left.i32 %xor, %shift : reg<vm.value : i32>
  %ashr = integer.shift.right.s32 %shl, %shift : reg<vm.value : i32>
  %lshr = integer.shift.right.u32 %ashr, %shift : reg<vm.value : i32>
  return %lshr
}

// ====

vm.target<core> @target
func.def target(@target) @scalar_i32_bitfield_sgpr(%word: i32) -> (i32, i32, i32, i32) {
  %unsigned_byte = scalar.bitfield.extractu %word {offset = 8, width = 8} : i32 -> i32
  %signed_byte = scalar.bitfield.extracts %word {offset = 16, width = 8} : i32 -> i32
  %unsigned_nibble = scalar.bitfield.extractu %word {offset = 4, width = 4} : i32 -> i32
  %signed_nibble = scalar.bitfield.extracts %word {offset = 4, width = 4} : i32 -> i32
  func.return %unsigned_byte, %signed_byte, %unsigned_nibble, %signed_nibble : i32, i32, i32, i32
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value : i32>) -> (reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>)>}) @scalar_i32_bitfield_sgpr(%word: reg<vm.value : i32>) -> (reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>) asm {
  %30 = constant.s16 8 : reg<vm.value : i32>
  %31 = integer.shift.right.u32 %word, %30 : reg<vm.value : i32>
  %32 = constant.s16 255 : reg<vm.value : i32>
  %unsigned_byte = integer.and.i32 %31, %32 : reg<vm.value : i32>
  %34 = integer.shift.left.i32 %word, %30 : reg<vm.value : i32>
  %35 = constant.s16 24 : reg<vm.value : i32>
  %signed_byte = integer.shift.right.s32 %34, %35 : reg<vm.value : i32>
  %37 = constant.s16 4 : reg<vm.value : i32>
  %38 = integer.shift.right.u32 %word, %37 : reg<vm.value : i32>
  %39 = constant.s16 15 : reg<vm.value : i32>
  %unsigned_nibble = integer.and.i32 %38, %39 : reg<vm.value : i32>
  %41 = integer.shift.left.i32 %word, %35 : reg<vm.value : i32>
  %42 = constant.s16 28 : reg<vm.value : i32>
  %signed_nibble = integer.shift.right.s32 %41, %42 : reg<vm.value : i32>
  return %unsigned_byte, %signed_byte, %unsigned_nibble, %signed_nibble
}

