vm.target<core> @target
func.def target(@target) @scalar_i32_compare_scc(%lhs: i32, %rhs: i32) -> (i1) {
  %cmp = scalar.cmpi slt, %lhs, %rhs : i32
  func.return %cmp : i1
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value : i32>, reg<vm.value : i32>) -> (reg<vm.value : i1>)>}) @scalar_i32_compare_scc(%lhs: reg<vm.value : i32>, %rhs: reg<vm.value : i32>) -> (reg<vm.value : i1>) asm {
  %cmp = integer.compare.i32 %lhs, %rhs, slt : reg<vm.value : i1>
  return %cmp
}

// ====

vm.target<core> @target
func.def target(@target) @scalar_i1_constants_scc() -> (i1, i1) {
  %true = scalar.constant true : i1
  %false = scalar.constant false : i1
  func.return %true, %false : i1, i1
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<() -> (reg<vm.value : i1>, reg<vm.value : i1>)>}) @scalar_i1_constants_scc() -> (reg<vm.value : i1>, reg<vm.value : i1>) asm {
  %true = constant.s16 1 : reg<vm.value : i1>
  %false = constant.zero : reg<vm.value : i1>
  return %true, %false
}

// ====

vm.target<core> @target
func.def target(@target) @scalar_i1_bitwise_scc(%lhs: i32, %rhs: i32) -> (i1) {
  %inactive_condition = scalar.constant 0 : i32
  %lhs_nonzero = scalar.cmpi ne, %lhs, %inactive_condition : i32
  %rhs_nonzero = scalar.cmpi ne, %rhs, %inactive_condition : i32
  %both_nonzero = scalar.andi %lhs_nonzero, %rhs_nonzero : i1
  %either_nonzero = scalar.ori %lhs_nonzero, %rhs_nonzero : i1
  %one_nonzero = scalar.xori %both_nonzero, %either_nonzero : i1
  func.return %one_nonzero : i1
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value : i32>, reg<vm.value : i32>) -> (reg<vm.value : i1>)>}) @scalar_i1_bitwise_scc(%lhs: reg<vm.value : i32>, %rhs: reg<vm.value : i32>) -> (reg<vm.value : i1>) asm {
  %inactive_condition = constant.zero : reg<vm.value : i32>
  %lhs_nonzero = integer.compare.i32 %lhs, %inactive_condition, ne : reg<vm.value : i1>
  %rhs_nonzero = integer.compare.i32 %rhs, %inactive_condition, ne : reg<vm.value : i1>
  %both_nonzero = integer.and.i32 %lhs_nonzero, %rhs_nonzero : reg<vm.value : i1>
  %either_nonzero = integer.or.i32 %lhs_nonzero, %rhs_nonzero : reg<vm.value : i1>
  %one_nonzero = integer.xor.i32 %both_nonzero, %either_nonzero : reg<vm.value : i1>
  return %one_nonzero
}
