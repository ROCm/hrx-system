// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_bitfield.loom-test
// RUN: emit source-low target=vm:core output=low

func.def @bitfield_full_width(%byte: i8, %word: i32, %wide: i64) -> (i8, i32, i64) {
  %byte_bits = scalar.bitfield.extracts %byte {offset = 0, width = 8} : i8 -> i8
  %word_bits = scalar.bitfield.extractu %word {offset = 0, width = 32} : i32 -> i32
  %wide_bits = scalar.bitfield.extracts %wide {offset = 0, width = 64} : i64 -> i64
  func.return %byte_bits, %word_bits, %wide_bits : i8, i32, i64
}

// ----
low.func.def target<vm.core> abi(vm_function) @bitfield_full_width(%byte: reg<vm.value : i8>, %word: reg<vm.value : i32>, %wide: reg<vm.value : i64>) -> (reg<vm.value : i8>, reg<vm.value : i32>, reg<vm.value : i64>) asm {
  return %byte, %word, %wide
}

// ====

func.def @bitfield_widen(%byte: i8, %half: i16) -> (i32, i64, i16, i64) {
  %low = scalar.bitfield.extractu %byte {offset = 0, width = 4} : i8 -> i32
  %high = scalar.bitfield.extracts %byte {offset = 4, width = 4} : i8 -> i64
  %middle = scalar.bitfield.extractu %half {offset = 3, width = 8} : i16 -> i16
  %top = scalar.bitfield.extracts %half {offset = 8, width = 8} : i16 -> i64
  func.return %low, %high, %middle, %top : i32, i64, i16, i64
}

// ----
low.func.def target<vm.core> abi(vm_function) @bitfield_widen(%byte: reg<vm.value : i8>, %half: reg<vm.value : i16>) -> (reg<vm.value : i32>, reg<vm.value : i64>, reg<vm.value : i16>, reg<vm.value : i64>) asm {
  %37 = conversion.integer %byte, "u8.to.i32" : reg<vm.value : i32>
  %38 = constant.i32 15
  %low = integer.and.i32 %37, %38
  %40 = constant.i32 24
  %41 = integer.shift.left.i32 %37, %40
  %42 = constant.i32 28
  %43 = integer.shift.right.s32 %41, %42
  %high = conversion.integer %43, "s32.to.i64"
  %45 = conversion.integer %half, "u16.to.i32" : reg<vm.value : i32>
  %46 = constant.i32 3
  %47 = integer.shift.right.u32 %45, %46
  %48 = constant.i32 255
  %49 = integer.and.i32 %47, %48
  %middle = conversion.integer %49, "i32.to.i16" : reg<vm.value : i16>
  %51 = constant.i32 16
  %52 = integer.shift.left.i32 %45, %51
  %53 = integer.shift.right.s32 %52, %40
  %top = conversion.integer %53, "s32.to.i64"
  return %low, %high, %middle, %top
}

// ====

func.def @bitfield_narrow(%wide: i64) -> (i8, i16, i64, i64) {
  %byte = scalar.bitfield.extractu %wide {offset = 32, width = 8} : i64 -> i8
  %half = scalar.bitfield.extracts %wide {offset = 40, width = 12} : i64 -> i16
  %sign = scalar.bitfield.extracts %wide {offset = 63, width = 1} : i64 -> i64
  %low = scalar.bitfield.extractu %wide {offset = 0, width = 63} : i64 -> i64
  func.return %byte, %half, %sign, %low : i8, i16, i64, i64
}

// ----
low.func.def target<vm.core> abi(vm_function) @bitfield_narrow(%wide: reg<vm.value : i64>) -> (reg<vm.value : i8>, reg<vm.value : i16>, reg<vm.value : i64>, reg<vm.value : i64>) asm {
  %28 = constant.i64 32
  %29 = integer.shift.right.u64 %wide, %28
  %30 = constant.i64 255
  %31 = integer.and.i64 %29, %30
  %byte = conversion.integer %31, "i64.to.i8" : reg<vm.value : i8>
  %33 = constant.i64 12
  %34 = integer.shift.left.i64 %wide, %33
  %35 = constant.i64 52
  %36 = integer.shift.right.s64 %34, %35
  %half = conversion.integer %36, "i64.to.i16" : reg<vm.value : i16>
  %38 = constant.i64 63
  %sign = integer.shift.right.s64 %wide, %38
  %40 = constant.i64 9223372036854775807
  %low = integer.and.i64 %wide, %40
  return %byte, %half, %sign, %low
}

// ====

func.def @bitfield_predicate(%condition: i1, %word: i32) -> (i1, i32, i64, i1) {
  %identity = scalar.bitfield.extractu %condition {offset = 0, width = 1} : i1 -> i1
  %unsigned = scalar.bitfield.extractu %condition {offset = 0, width = 1} : i1 -> i32
  %signed = scalar.bitfield.extracts %condition {offset = 0, width = 1} : i1 -> i64
  %top = scalar.bitfield.extractu %word {offset = 31, width = 1} : i32 -> i1
  func.return %identity, %unsigned, %signed, %top : i1, i32, i64, i1
}

// ----
low.func.def target<vm.core> abi(vm_function) @bitfield_predicate(%condition: reg<vm.value : i1>, %word: reg<vm.value : i32>) -> (reg<vm.value : i1>, reg<vm.value : i32>, reg<vm.value : i64>, reg<vm.value : i1>) asm {
  %unsigned = conversion.integer %condition, "u1.to.i32" : reg<vm.value : i32>
  %signed = conversion.integer %condition, "s1.to.i64"
  %23 = constant.i32 31
  %24 = integer.shift.right.u32 %word, %23
  %top = conversion.integer %24, "i32.to.i1" : reg<vm.value : i1>
  return %condition, %unsigned, %signed, %top
}
