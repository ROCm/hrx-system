// TEMPLATE: loom/src/loom/test/corpus/source_low/callable_returns.loom-test
// RUN: emit source-low target=vm:core output=low

// Return representation depends on all paths, regardless of block layout.
func.def @return_loaded_or_argument(%input: buffer, %load: i1, %fallback: i32) -> (i32) {
  %origin = index.constant 0 : offset
  %view = buffer.view %input[%origin] : buffer -> view<1xi32>
  cfg.cond_br %load, ^loaded, ^argument
^loaded:
  %value = view.load %view[0] : view<1xi32> -> i32
  func.return %value : i32
^argument:
  func.return %fallback : i32
}

// ----
low.func.def target<vm.core> abi(vm_function) @return_loaded_or_argument(%view: reg<vm.ref : buffer>, %load: reg<vm.value : i1>, %fallback: reg<vm.value : i32>) -> (reg<vm.value : i32>) asm {
  low.cond_br %load, ^loaded, ^argument : reg<vm.value : i1>
^loaded:
  %11 = constant.i64 0
  %value = buffer.load %view, %11, %11, 0, "i32.x1" : reg<vm.value : i32>
  return %value
^argument:
  return %fallback
}

// ====

