  %count = global.load @count : i64
  func.return %count : i64
}

// ----
vm.target<core> @target

global.variable @count : i64 = -1

low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<() -> (reg<vm.value : i64>)>}) @read_count() -> (reg<vm.value : i64>) asm {
  %count = global.value.mutable.load 0 : reg<vm.value : i64>
  return %count
}

low.func.def initializer target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<() -> ()>}) export("initialize") @__vm_initialize() asm {
  %5 = constant.s16 -1 : reg<vm.value : i64>
  global.value.mutable.store %5, 0
  return
}
vm.global @count ordinal(0)

