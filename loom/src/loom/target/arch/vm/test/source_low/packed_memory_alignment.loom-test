// RUN: emit source-low target=vm:core output=low

// Byte-aligned vector accesses retain every byte offset through scalarization.
kernel.def @byte_origin() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%input: buffer, %output: buffer) {
  %aligned = buffer.assume.alignment %input {minimum_alignment = 64} : buffer
  %source, %destination = buffer.assume.noalias %aligned, %output : buffer, buffer
  %start = index.constant 1 : offset
  %c0 = index.constant 0 : offset
  %source_view = buffer.view %source[%start] : buffer -> view<32xi8>
  %value = vector.load %source_view[0] : view<32xi8> -> vector<32xi8>
  %destination_view = buffer.view %destination[%c0] : buffer -> view<32xi8>
  vector.store %value, %destination_view[0] : vector<32xi8>, view<32xi8>
  kernel.return
}

