vm.target<core> @target
func.def target(@target) @scf_select_q6_nibble_i8(%code: i32, %use_high: i32) -> (i8) {
  %low_selector = scalar.constant 0 : i32
  %nibble_shift = scalar.constant 4 : i32
  %mask = scalar.constant 15 : i32
  %high_shifted = scalar.shrui %code, %nibble_shift : i32
  %low_i32 = scalar.andi %code, %mask : i32
  %high_i32 = scalar.andi %high_shifted, %mask : i32
  %low = scalar.trunci %low_i32 : i32 to i8
  %high = scalar.trunci %high_i32 : i32 to i8
  %cond = scalar.cmpi ne, %use_high, %low_selector : i32
  %selected = scf.select %cond, %high, %low : i8
  func.return %selected : i8
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value : i32>, reg<vm.value : i32>) -> (reg<vm.value : i8>)>}) @scf_select_q6_nibble_i8(%code: reg<vm.value : i32>, %use_high: reg<vm.value : i32>) -> (reg<vm.value : i8>) asm {
  %low_selector = constant.zero : reg<vm.value : i32>
  %nibble_shift = constant.s16 4 : reg<vm.value : i32>
  %mask = constant.s16 15 : reg<vm.value : i32>
  %high_shifted = integer.shift.right.u32 %code, %nibble_shift : reg<vm.value : i32>
  %low_i32 = integer.and.i32 %code, %mask : reg<vm.value : i32>
  %high_i32 = integer.and.i32 %high_shifted, %mask : reg<vm.value : i32>
  %low = conversion.integer %low_i32, i32.to.i8 : reg<vm.value : i8>
  %high = conversion.integer %high_i32, i32.to.i8 : reg<vm.value : i8>
  %cond = integer.compare.i32 %use_high, %low_selector, ne : reg<vm.value : i1>
  %selected = value.select %cond, %high, %low : reg<vm.value : i8>
  return %selected
}

