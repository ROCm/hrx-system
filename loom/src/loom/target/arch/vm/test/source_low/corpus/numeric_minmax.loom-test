  %min = float.minmax.f32 %min_init, %43, minnum : reg<vm.value : f32>
  %max_init = constant.i32 3296329728 : reg<vm.value : f32>
  %46 = float.minmax.f32 %31, %34, maxnum : reg<vm.value : f32>
  %47 = float.minmax.f32 %38, %41, maxnum : reg<vm.value : f32>
  %48 = float.minmax.f32 %46, %47, maxnum : reg<vm.value : f32>
