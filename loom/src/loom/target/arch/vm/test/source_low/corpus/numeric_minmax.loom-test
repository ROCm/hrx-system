  %limit = constant.s16 31 : reg<vm.value : index>
  %min = integer.min.s64 %workitem_id_x, %limit : reg<vm.value : index>
  %max = integer.max.s64 %workitem_id_x, %limit : reg<vm.value : index>
  %cond = integer.compare.i64 %workitem_id_x, %limit, slt : reg<vm.value : i1>
  %selected = value.select %cond, %min, %max : reg<vm.value : index>
  %30 = constant.s16 1 : reg<vm.value : i32>
  %stored = concat(%30) : (reg<vm.value : i32>) -> reg<vm.value : vector<1xi32>>
  %32 = constant.zero : reg<vm.value : offset>
  buffer.store %output, %32, %selected, %stored, 4, i32.x1
  return
}

