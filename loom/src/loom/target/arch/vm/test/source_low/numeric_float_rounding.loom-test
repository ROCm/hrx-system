// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_float_rounding.loom-test
// RUN: emit source-low target=vm:core output=low

func.def @rounding_f32(%value: f32) -> (f32, f32, f32, f32, f32) {
  %ceil = scalar.ceilf %value : f32
  %floor = scalar.floorf %value : f32
  %roundeven = scalar.roundevenf %value : f32
  %trunc = scalar.truncf %value : f32
  %round_away = scalar.roundf %value : f32
  func.return %ceil, %floor, %roundeven, %trunc, %round_away : f32, f32, f32, f32, f32
}

// ----
low.func.def target<vm.core> abi(vm_function) @rounding_f32(%value: reg<vm.value : f32>) -> (reg<vm.value : f32>, reg<vm.value : f32>, reg<vm.value : f32>, reg<vm.value : f32>, reg<vm.value : f32>) asm {
  %ceil = float.math.unary.f32 %value, "ceil"
  %floor = float.math.unary.f32 %value, "floor"
  %roundeven = float.math.unary.f32 %value, "round_even"
  %trunc = float.math.unary.f32 %value, "trunc"
  %30 = constant.i32 1056964608 : reg<vm.value : f32>
  %31 = constant.i32 1065353216 : reg<vm.value : f32>
  %32 = float.sub.f32 %value, %trunc
  %33 = float.abs.f32 %32
  %34 = float.compare.f32 %33, %30, "oge"
  %35 = float.copysign.f32 %31, %value
  %36 = float.add.f32 %trunc, %35
  %round_away = value.select %34, %36, %trunc : reg<vm.value : f32>
  return %ceil, %floor, %roundeven, %trunc, %round_away
}

// ====

func.def @rounding_f64(%value: f64) -> (f64, f64, f64, f64, f64) {
  %ceil = scalar.ceilf %value : f64
  %floor = scalar.floorf %value : f64
  %roundeven = scalar.roundevenf %value : f64
  %trunc = scalar.truncf %value : f64
  %round_away = scalar.roundf %value : f64
  func.return %ceil, %floor, %roundeven, %trunc, %round_away : f64, f64, f64, f64, f64
}

// ----
low.func.def target<vm.core> abi(vm_function) @rounding_f64(%value: reg<vm.value : f64>) -> (reg<vm.value : f64>, reg<vm.value : f64>, reg<vm.value : f64>, reg<vm.value : f64>, reg<vm.value : f64>) asm {
  %ceil = float.math.unary.f64 %value, "ceil"
  %floor = float.math.unary.f64 %value, "floor"
  %roundeven = float.math.unary.f64 %value, "round_even"
  %trunc = float.math.unary.f64 %value, "trunc"
  %30 = constant.i64 4602678819172646912 : reg<vm.value : f64>
  %31 = constant.i64 4607182418800017408 : reg<vm.value : f64>
  %32 = float.sub.f64 %value, %trunc
  %33 = float.abs.f64 %32
  %34 = float.compare.f64 %33, %30, "oge"
  %35 = float.copysign.f64 %31, %value
  %36 = float.add.f64 %trunc, %35
  %round_away = value.select %34, %36, %trunc : reg<vm.value : f64>
  return %ceil, %floor, %roundeven, %trunc, %round_away
}
