vm.target<core> @target
func.def target(@target) @i32_to_i8x4_bitcast(%word: vector<1xi32>) -> (vector<4xi8>) {
  %bytes = vector.bitcast %word : vector<1xi32> to vector<4xi8>
  func.return %bytes : vector<4xi8>
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value : vector<1xi32>>) -> (reg<vm.value x4 : vector<4xi8>>)>}) @i32_to_i8x4_bitcast(%word: reg<vm.value : vector<1xi32>>) -> (reg<vm.value x4 : vector<4xi8>>) asm {
  %28 = slice %word[0] : reg<vm.value : vector<1xi32>> -> reg<vm.value : i32>
  %29 = constant.s16 255 : reg<vm.value : i32>
  %30 = integer.and.i32 %28, %29 : reg<vm.value : i32>
  %31 = conversion.integer %30, i32.to.i8 : reg<vm.value : i8>
  %32 = constant.s16 8 : reg<vm.value : i32>
  %33 = integer.shift.right.u32 %28, %32 : reg<vm.value : i32>
  %34 = integer.and.i32 %33, %29 : reg<vm.value : i32>
  %35 = conversion.integer %34, i32.to.i8 : reg<vm.value : i8>
  %36 = constant.s16 16 : reg<vm.value : i32>
  %37 = integer.shift.right.u32 %28, %36 : reg<vm.value : i32>
  %38 = integer.and.i32 %37, %29 : reg<vm.value : i32>
  %39 = conversion.integer %38, i32.to.i8 : reg<vm.value : i8>
  %40 = constant.s16 24 : reg<vm.value : i32>
  %41 = integer.shift.right.u32 %28, %40 : reg<vm.value : i32>
  %42 = integer.and.i32 %41, %29 : reg<vm.value : i32>
  %43 = conversion.integer %42, i32.to.i8 : reg<vm.value : i8>
  %bytes = concat(%31, %35, %39, %43) : (reg<vm.value : i8>, reg<vm.value : i8>, reg<vm.value : i8>, reg<vm.value : i8>) -> reg<vm.value x4 : vector<4xi8>>
  return %bytes
}

