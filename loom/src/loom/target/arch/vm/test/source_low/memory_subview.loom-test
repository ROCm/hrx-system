low.func.def public target<vm.core> abi(vm_function) @subview_composed_refined_nested(%inner: reg<vm.ref : buffer>, %destination: reg<vm.ref : buffer>, %origin: reg<vm.value : i64>, %row_stride: reg<vm.value : i64>, %column_stride: reg<vm.value : i64>) asm {
  %25 = constant.i64 3 : reg<vm.value>
  %26 = integer.shift.left.i64 %row_stride, %25
  %27 = integer.add.i64 %origin, %26
  %29 = integer.shift.left.i64 %column_stride, %25
  %30 = integer.add.i64 %27, %29
  %31 = constant.i64 2 : reg<vm.value>
  %32 = integer.shift.left.i64 %row_stride, %31
  %33 = integer.add.i64 %30, %32
  %value = buffer.load %inner, %33, %33, 0, "i32.x1" : reg<vm.value : f32>
  %35 = constant.i64 4
  buffer.store %destination, %35, %35, %value, 0, "i32.x1"
  return
}

