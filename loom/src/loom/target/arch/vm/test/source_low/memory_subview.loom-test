vm.target<core> @target

func.def target(@target) @subview_vector_aligned(%input: buffer, %output: buffer) {
  %input_base = index.constant 32 : offset
  %output_base = index.constant 64 : offset
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 32} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 32} : buffer
  %layout = encoding.layout.strided [24, 1] : encoding<layout>
  %source = buffer.view %input_aligned[%input_base] : buffer -> view<4x24xi32, %layout>
  %destination = buffer.view %output_aligned[%output_base] : buffer -> view<4x24xi32, %layout>
  %source_crop = view.subview %source[1, 8] : view<4x24xi32, %layout> -> view<2x8xi32, %layout>
  %destination_crop = view.subview %destination[1, 0] : view<4x24xi32, %layout> -> view<2x16xi32, %layout>
  %value = vector.load %source_crop[1, 0] : view<2x8xi32, %layout> -> vector<8xi32>
  vector.store %value, %destination_crop[0, 8] : vector<8xi32>, view<2x16xi32, %layout>
  func.return
}

