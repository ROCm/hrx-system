low.func.def target<vm.core>(@target) abi(vm_function) @subview_vector_strided(%source_crop: reg<vm.ref : buffer>, %destination_crop: reg<vm.ref : buffer>) asm {
  %22 = constant.i64 124
  %23 = buffer.load %source_crop, %22, %22, 0, 8 : reg<vm.value : i32>
  %24 = constant.i64 128
  %25 = buffer.load %source_crop, %24, %24, 0, 8 : reg<vm.value : i32>
  %26 = constant.i64 132
  %27 = buffer.load %source_crop, %26, %26, 0, 8 : reg<vm.value : i32>
  %28 = constant.i64 136
  %29 = buffer.load %source_crop, %28, %28, 0, 8 : reg<vm.value : i32>
  %30 = constant.i64 88
  buffer.store %destination_crop, %30, %30, %23, 0, 8
  %31 = constant.i64 92
  buffer.store %destination_crop, %31, %31, %25, 0, 8
  %32 = constant.i64 96
  buffer.store %destination_crop, %32, %32, %27, 0, 8
  %33 = constant.i64 100
  buffer.store %destination_crop, %33, %33, %29, 0, 8
  return
}

