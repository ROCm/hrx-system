  %loaded = vector.load %input_view[%lane, 0] : view<64x4xf16> -> vector<4xf16>
  vector.store %loaded, %scratch_view[%lane, 0] : vector<4xf16>, view<64x4xf16>
  %roundtrip = vector.load %scratch_view[%lane, 0] : view<64x4xf16> -> vector<4xf16>
  vector.store %roundtrip, %output_view[%lane, 0] : vector<4xf16>, view<64x4xf16>
