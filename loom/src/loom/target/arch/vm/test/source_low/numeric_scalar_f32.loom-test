// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_scalar_f32.loom-test
// RUN: emit source-low target=vm:core output=low

func.def @scalar_f32_arith(%lhs: f32, %rhs: f32, %bias: f32) -> (f32) {
  %sum = scalar.addf %lhs, %rhs : f32
  %difference = scalar.subf %sum, %bias : f32
  %product = scalar.mulf %difference, %rhs : f32
  %result = scalar.fmaf %product, %rhs, %bias : f32
  func.return %result : f32
}

// ----
low.func.def target<vm.core> abi(vm_function) @scalar_f32_arith(%lhs: reg<vm.value : f32>, %rhs: reg<vm.value : f32>, %bias: reg<vm.value : f32>) -> (reg<vm.value : f32>) asm {
  %sum = float.add.f32 %lhs, %rhs
  %difference = float.sub.f32 %sum, %bias
  %product = float.mul.f32 %difference, %rhs
  %result = float.fma.f32 %product, %rhs, %bias
  return %result
}

// ====

func.def @scalar_f32_sign_bits(%input: f32) -> (f32, f32) {
  %negated = scalar.negf %input : f32
  %absolute = scalar.absf %input : f32
  func.return %negated, %absolute : f32, f32
}

// ----
low.func.def target<vm.core> abi(vm_function) @scalar_f32_sign_bits(%input: reg<vm.value : f32>) -> (reg<vm.value : f32>, reg<vm.value : f32>) asm {
  %negated = float.neg.f32 %input
  %absolute = float.abs.f32 %input
  return %negated, %absolute
}

// ====

// XFAIL: VM vector sign-bit results have no complete scalar ABI lowering.
func.def @vector_f32_sign_bits(%input: vector<4xf32>) -> (vector<4xf32>, vector<4xf32>) {
  %negated = vector.negf %input : vector<4xf32>
  %absolute = vector.absf %input : vector<4xf32>
  func.return %negated, %absolute : vector<4xf32>, vector<4xf32>
}
