  %73 = float.math.ternary.f32 %s2, %72, %71, fma : reg<vm.value : f32>
  %74 = slice %rhs[3] : reg<vm.value x4 : vector<4xf32>> -> reg<vm.value : f32>
  %dot = float.math.ternary.f32 %s3, %74, %73, fma : reg<vm.value : f32>
  return %dot
}
