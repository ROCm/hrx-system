// RUN: pass target=vm:core source-to-low

// ERROR@+1: TARGET/031 {op_name="func.def", type_constraint="vector.target_carrier", actual_type="vector<4xi32>"}
func.def public @selected_truncated(%input: vector<4xi32>, %left: i64, %right: i64) -> (i32) {
  // ERROR@+1: TARGET/031 {op_name="vector.extract", type_constraint="vector.target_carrier"}
  %value = vector.extract %input[0] : vector<4xi32> -> i32
  %threshold = scalar.constant 0 : i32
  %condition = scalar.cmpi sgt, %value, %threshold : i32
  %selected = scf.select %condition, %left, %right : i64
  %payload = scalar.trunci %selected : i64 to i32
  cfg.br ^forward(%payload: i32)
^forward(%carried: i32):
  func.return %carried : i32
}

// ====

func.def public @selected_converted_offset(%choice: i32, %narrow: i32, %fallback: offset) -> (offset) {
  %threshold = scalar.constant 0 : i32
  %condition = scalar.cmpi ne, %choice, %threshold : i32
  %converted = index.cast %narrow : i32 to offset
  %selected = scf.select %condition, %converted, %fallback : offset
  cfg.br ^forward(%selected: offset)
^forward(%carried: offset):
  func.return %carried : offset
}

// ----
low.func.def public target<vm.core> abi(vm_function) @selected_converted_offset(%choice: reg<vm.value : i32>, %narrow: reg<vm.value : i32>, %fallback: reg<vm.value : i64>) -> (reg<vm.value : i64>) asm {
  %threshold = constant.i32 0
  %condition = integer.compare.i32 %choice, %threshold, "ne"
  %converted = conversion.integer %narrow, "u32.to.i64"
  %selected = value.select %condition, %converted, %fallback
  low.br ^forward(%selected: reg<vm.value : i64>)
^forward(%carried: reg<vm.value : i64>):
  return %carried
}

// ====

func.def public @uniform_selected_truncated(%value: i32, %left: i64, %right: i64) -> (i32) {
  %threshold = scalar.constant 0 : i32
  %condition = scalar.cmpi sgt, %value, %threshold : i32
  %selected = scf.select %condition, %left, %right : i64
  %payload = scalar.trunci %selected : i64 to i32
  cfg.br ^forward(%payload: i32)
^forward(%carried: i32):
  func.return %carried : i32
}

// ----
low.func.def public target<vm.core> abi(vm_function) @uniform_selected_truncated(%value: reg<vm.value : i32>, %left: reg<vm.value : i64>, %right: reg<vm.value : i64>) -> (reg<vm.value : i32>) asm {
  %threshold = constant.i32 0
  %condition = integer.compare.i32 %value, %threshold, "sgt"
  %selected = value.select %condition, %left, %right
  %payload = conversion.integer %selected, "i64.to.i32" : reg<vm.value : i32>
  low.br ^forward(%payload: reg<vm.value : i32>)
^forward(%carried: reg<vm.value : i32>):
  return %carried
}
