low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value : i8>, reg<vm.value : i16>, reg<vm.value : i32>, reg<vm.value : i64>, reg<vm.value : offset>) -> (reg<vm.value : offset>, reg<vm.value : offset>, reg<vm.value : offset>, reg<vm.value : offset>, reg<vm.value : i8>, reg<vm.value : i16>, reg<vm.value : i32>, reg<vm.value : i64>)>}) @offset_payload_cast_family(%i8: reg<vm.value : i8>, %i16: reg<vm.value : i16>, %i32: reg<vm.value : i32>, %i64: reg<vm.value : i64>, %byte_offset: reg<vm.value : offset>) -> (reg<vm.value : offset>, reg<vm.value : offset>, reg<vm.value : offset>, reg<vm.value : offset>, reg<vm.value : i8>, reg<vm.value : i16>, reg<vm.value : i32>, reg<vm.value : i64>) asm {
  %from_i8 = conversion.integer %i8, u8.to.i64 : reg<vm.value : offset>
  %from_i16 = conversion.integer %i16, u16.to.i64 : reg<vm.value : offset>
  %from_i32 = conversion.integer %i32, u32.to.i64 : reg<vm.value : offset>
  %from_i64 = value.copy %i64 : reg<vm.value : offset>
  %to_i8 = conversion.integer %byte_offset, i64.to.i8 : reg<vm.value : i8>
  %to_i16 = conversion.integer %byte_offset, i64.to.i16 : reg<vm.value : i16>
  %to_i32 = conversion.integer %byte_offset, i64.to.i32 : reg<vm.value : i32>
  %to_i64 = value.copy %byte_offset : reg<vm.value : i64>
  return %from_i8, %from_i16, %from_i32, %from_i64, %to_i8, %to_i16, %to_i32, %to_i64
}

// ====

vm.target<core> @target
func.def target(@target) @address_domain_cast_family(%coordinate0: index, %byte_offset0: offset) -> (offset, index) {
  %coordinate, %byte_offset = index.assume %coordinate0, %byte_offset0 [range(%coordinate0, 0, 2147483647), range(%byte_offset0, 0, 2147483647)] : index, offset
  %as_offset = index.cast %coordinate : index to offset
  %as_index = index.cast %byte_offset : offset to index
  func.return %as_offset, %as_index : offset, index
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value : index>, reg<vm.value : offset>) -> (reg<vm.value : offset>, reg<vm.value : index>)>}) @address_domain_cast_family(%coordinate: reg<vm.value : index>, %byte_offset: reg<vm.value : offset>) -> (reg<vm.value : offset>, reg<vm.value : index>) asm {
  %as_offset = value.copy %coordinate : reg<vm.value : offset>
  %as_index = value.copy %byte_offset : reg<vm.value : index>
  return %as_offset, %as_index
}
