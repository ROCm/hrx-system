// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_index_conversion.loom-test
// RUN: emit source-low output=low

vm.target<core> @target
func.def target(@target) @index_constants() -> (index, index, offset) {
  %minimum = index.constant -2147483648 : index
  %maximum = index.constant 2147483647 : index
  %byte_limit = index.constant 9223372036854775807 : offset
  func.return %minimum, %maximum, %byte_limit : index, index, offset
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<() -> (reg<vm.value : index>, reg<vm.value : index>, reg<vm.value : offset>)>}) @index_constants() -> (reg<vm.value : index>, reg<vm.value : index>, reg<vm.value : offset>) asm {
  %minimum = constant.i64 2147483648, 4294967295 : reg<vm.value : index>
  %maximum = constant.i32 2147483647 : reg<vm.value : index>
  %byte_limit = constant.i64 4294967295, 2147483647 : reg<vm.value : offset>
  return %minimum, %maximum, %byte_limit
}

// ====

vm.target<core> @target
func.def target(@target) @index_assume_ordinals(%coordinate0: index, %byte_offset0: offset) -> (index, offset) {
  %coordinate, %byte_offset = index.assume %coordinate0, %byte_offset0 [range(%coordinate0, 0, 1024), range(%byte_offset0, 0, 4096)] : index, offset
  func.return %coordinate, %byte_offset : index, offset
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value : index>, reg<vm.value : offset>) -> (reg<vm.value : index>, reg<vm.value : offset>)>}) @index_assume_ordinals(%coordinate: reg<vm.value : index>, %byte_offset: reg<vm.value : offset>) -> (reg<vm.value : index>, reg<vm.value : offset>) asm {
  return %coordinate, %byte_offset
}

// ====

vm.target<core> @target
func.def target(@target) @boolean_address_cast_family(%flag: i1, %coordinate: index, %byte_offset: offset) -> (index, offset, i1, i1) {
  %flag_index = index.cast %flag : i1 to index
  %flag_offset = index.cast %flag : i1 to offset
  %index_low_bit = index.cast %coordinate : index to i1
  %offset_low_bit = index.cast %byte_offset : offset to i1
  func.return %flag_index, %flag_offset, %index_low_bit, %offset_low_bit : index, offset, i1, i1
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value : i1>, reg<vm.value : index>, reg<vm.value : offset>) -> (reg<vm.value : index>, reg<vm.value : offset>, reg<vm.value : i1>, reg<vm.value : i1>)>}) @boolean_address_cast_family(%flag: reg<vm.value : i1>, %coordinate: reg<vm.value : index>, %byte_offset: reg<vm.value : offset>) -> (reg<vm.value : index>, reg<vm.value : offset>, reg<vm.value : i1>, reg<vm.value : i1>) asm {
  %flag_index = conversion.integer %flag, u1.to.i64 : reg<vm.value : index>
  %flag_offset = conversion.integer %flag, u1.to.i64 : reg<vm.value : offset>
  %index_low_bit = conversion.integer %coordinate, i64.to.i1 : reg<vm.value : i1>
  %offset_low_bit = conversion.integer %byte_offset, i64.to.i1 : reg<vm.value : i1>
  return %flag_index, %flag_offset, %index_low_bit, %offset_low_bit
}

// ====

vm.target<core> @target
func.def target(@target) @index_payload_cast_family(%i8: i8, %i16: i16, %i32: i32, %i64_raw: i64, %coordinate: index) -> (index, index, index, index, i8, i16, i32, i64) {
  %i64 = scalar.assume %i64_raw [range(%i64_raw, -2147483648, 2147483647)] : i64
  %from_i8 = index.cast %i8 : i8 to index
  %from_i16 = index.cast %i16 : i16 to index
  %from_i32 = index.cast %i32 : i32 to index
  %from_i64 = index.cast %i64 : i64 to index
  %to_i8 = index.cast %coordinate : index to i8
  %to_i16 = index.cast %coordinate : index to i16
  %to_i32 = index.cast %coordinate : index to i32
  %to_i64 = index.cast %coordinate : index to i64
  func.return %from_i8, %from_i16, %from_i32, %from_i64, %to_i8, %to_i16, %to_i32, %to_i64 : index, index, index, index, i8, i16, i32, i64
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value : i8>, reg<vm.value : i16>, reg<vm.value : i32>, reg<vm.value : i64>, reg<vm.value : index>) -> (reg<vm.value : index>, reg<vm.value : index>, reg<vm.value : index>, reg<vm.value : index>, reg<vm.value : i8>, reg<vm.value : i16>, reg<vm.value : i32>, reg<vm.value : i64>)>}) @index_payload_cast_family(%i8: reg<vm.value : i8>, %i16: reg<vm.value : i16>, %i32: reg<vm.value : i32>, %i64: reg<vm.value : i64>, %coordinate: reg<vm.value : index>) -> (reg<vm.value : index>, reg<vm.value : index>, reg<vm.value : index>, reg<vm.value : index>, reg<vm.value : i8>, reg<vm.value : i16>, reg<vm.value : i32>, reg<vm.value : i64>) asm {
  %from_i8 = conversion.integer %i8, s8.to.i64 : reg<vm.value : index>
  %from_i16 = conversion.integer %i16, s16.to.i64 : reg<vm.value : index>
  %from_i32 = conversion.integer %i32, s32.to.i64 : reg<vm.value : index>
  %from_i64 = value.copy %i64 : reg<vm.value : index>
  %to_i8 = conversion.integer %coordinate, i64.to.i8 : reg<vm.value : i8>
  %to_i16 = conversion.integer %coordinate, i64.to.i16 : reg<vm.value : i16>
  %to_i32 = conversion.integer %coordinate, i64.to.i32 : reg<vm.value : i32>
  %to_i64 = value.copy %coordinate : reg<vm.value : i64>
  return %from_i8, %from_i16, %from_i32, %from_i64, %to_i8, %to_i16, %to_i32, %to_i64
}

