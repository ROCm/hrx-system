// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_logical_constants.loom-test
// RUN: emit source-low target=vm:core output=low

func.def @logical_constants() -> (f32, f64, i1, i1) {
  %narrow = scalar.constant 1.25 : f32
  %wide = scalar.constant 4294967297.5 : f64
  %yes = scalar.constant true : i1
  %no = scalar.constant false : i1
  func.return %narrow, %wide, %yes, %no : f32, f64, i1, i1
}

// ----
low.func.def target<vm.core> abi(vm_function) @logical_constants() -> (reg<vm.value : f32>, reg<vm.value : f64>, reg<vm.value : i1>, reg<vm.value : i1>) asm {
  %narrow = constant.i32 1067450368 : reg<vm.value : f32>
  %wide = constant.i64 4751297606877446144 : reg<vm.value : f64>
  %yes = constant.i32 1 : reg<vm.value : i1>
  %no = constant.i32 0 : reg<vm.value : i1>
  return %narrow, %wide, %yes, %no
}

// ====

func.def @boolean_logic(%a: i1, %b: i1) -> (i1, i1, i1) {
  %both = scalar.andi %a, %b : i1
  %either = scalar.ori %a, %b : i1
  %exclusive = scalar.xori %a, %b : i1
  func.return %both, %either, %exclusive : i1, i1, i1
}

// ----
low.func.def target<vm.core> abi(vm_function) @boolean_logic(%a: reg<vm.value : i1>, %b: reg<vm.value : i1>) -> (reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>) asm {
  %both = integer.and.i32 %a, %b : reg<vm.value : i1>
  %either = integer.or.i32 %a, %b : reg<vm.value : i1>
  %exclusive = integer.xor.i32 %a, %b : reg<vm.value : i1>
  return %both, %either, %exclusive
}

// ====

func.def @integer_constant_boundaries() -> (i64, i64, i64, i64, i64, i64, i64, i64) {
  %c0 = scalar.constant 0 : i64
  %negative = scalar.constant -1 : i64
  %signed_min = scalar.constant -32768 : i64
  %signed_max = scalar.constant 32767 : i64
  %below_signed = scalar.constant -32769 : i64
  %above_signed = scalar.constant 32768 : i64
  %unsigned_max = scalar.constant 4294967295 : i64
  %above_unsigned = scalar.constant 4294967296 : i64
  func.return %c0, %negative, %signed_min, %signed_max, %below_signed, %above_signed, %unsigned_max, %above_unsigned : i64, i64, i64, i64, i64, i64, i64, i64
}

// ----
low.func.def target<vm.core> abi(vm_function) @integer_constant_boundaries() -> (reg<vm.value : i64>, reg<vm.value : i64>, reg<vm.value : i64>, reg<vm.value : i64>, reg<vm.value : i64>, reg<vm.value : i64>, reg<vm.value : i64>, reg<vm.value : i64>) asm {
  %c0 = constant.i64 0
  %negative = constant.i64 -1
  %signed_min = constant.i64 -32768
  %signed_max = constant.i64 32767
  %below_signed = constant.i64 -32769
  %above_signed = constant.i64 32768
  %unsigned_max = constant.i64 4294967295
  %above_unsigned = constant.i64 4294967296
  return %c0, %negative, %signed_min, %signed_max, %below_signed, %above_signed, %unsigned_max, %above_unsigned
}

// ====

func.def @narrow_integer_constant_boundaries() -> (i32, i32, i32, i32, i32) {
  %c0 = scalar.constant 0 : i32
  %negative = scalar.constant -1 : i32
  %signed_min = scalar.constant -32768 : i32
  %signed_max = scalar.constant 32767 : i32
  %above_signed = scalar.constant 32768 : i32
  func.return %c0, %negative, %signed_min, %signed_max, %above_signed : i32, i32, i32, i32, i32
}

// ----
low.func.def target<vm.core> abi(vm_function) @narrow_integer_constant_boundaries() -> (reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>) asm {
  %c0 = constant.i32 0
  %negative = constant.i32 4294967295
  %signed_min = constant.i32 4294934528
  %signed_max = constant.i32 32767
  %above_signed = constant.i32 32768
  return %c0, %negative, %signed_min, %signed_max, %above_signed
}
