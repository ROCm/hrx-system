vm.target<core> @target
func.def target(@target) @scalar_mixed_rank2_i32(%input: buffer, %output: buffer, %base: offset, %row: index, %column: index) -> (i32) {
  %base_aligned = index.assume %base [range(%base, 0, 4092), mul(%base, 4)] : offset
  %row_bounded = index.assume %row [range(%row, 0, 3)] : index
  %column_bounded = index.assume %column [range(%column, 0, 7)] : index
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %input_view = buffer.view %input_aligned[%base_aligned] : buffer -> view<4x8xi32>
  %output_view = buffer.view %output_aligned[%base_aligned] : buffer -> view<4x8xi32>
  %loaded = view.load %input_view[%row_bounded, %column_bounded] : view<4x8xi32> -> i32
  view.store %loaded, %output_view[%row_bounded, %column_bounded] : i32, view<4x8xi32>
  func.return %loaded : i32
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.ref : buffer>, reg<vm.ref : buffer>, reg<vm.value : offset>, reg<vm.value : index>, reg<vm.value : index>) -> (reg<vm.value : i32>)>}) @scalar_mixed_rank2_i32(%input_aligned: reg<vm.ref : buffer>, %output_aligned: reg<vm.ref : buffer>, %base_aligned: reg<vm.value : offset>, %row_bounded: reg<vm.value : index>, %column_bounded: reg<vm.value : index>) -> (reg<vm.value : i32>) asm {
  %27 = constant.s16 5 : reg<vm.value : offset>
  %28 = integer.shift.left.i64 %row_bounded, %27 : reg<vm.value : offset>
  %29 = integer.add.i64 %base_aligned, %28 : reg<vm.value : offset>
  %30 = constant.s16 2 : reg<vm.value : offset>
  %31 = integer.shift.left.i64 %column_bounded, %30 : reg<vm.value : offset>
  %32 = integer.add.i64 %29, %31 : reg<vm.value : offset>
  %33 = constant.zero : reg<vm.value : offset>
  %loaded = buffer.load %input_aligned, %32, %33, 0, i32.x1 : reg<vm.value : i32>
  buffer.store %output_aligned, %32, %33, %loaded, 0, i32.x1
  return %loaded
}

