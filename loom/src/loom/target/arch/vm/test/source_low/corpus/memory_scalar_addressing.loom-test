low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.ref : buffer>, reg<vm.ref : buffer>, reg<vm.value : offset>) -> (reg<vm.value : i32>)>}) @scalar_dynamic_view_base_i32(%input_aligned: reg<vm.ref : buffer>, %output_aligned: reg<vm.ref : buffer>, %base_aligned: reg<vm.value : offset>) -> (reg<vm.value : i32>) asm {
  %15 = constant.s16 8 : reg<vm.value : offset>
  %loaded = buffer.load %input_aligned, %15, %base_aligned, 1, i32.x1 : reg<vm.value : i32>
  %17 = constant.zero : reg<vm.value : offset>
  buffer.store %output_aligned, %17, %17, %loaded, 0, i32.x1
  return %loaded
}

