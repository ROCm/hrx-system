vm.target<core> @target
func.def target(@target) @scalar_dynamic_stride_i32(%input: buffer, %output: buffer, %columns: index, %row: index, %column: index) -> (i32) {
  %buffer_base = index.constant 0 : offset
  %columns_bounded = index.assume %columns [range(%columns, 1, 8)] : index
  %row_bounded = index.assume %row [range(%row, 0, 3)] : index
  %column_bounded = index.assume %column [range(%column, 0, 7), lt(%column, %columns_bounded)] : index
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %input_view = buffer.view %input_aligned[%buffer_base] : buffer -> view<4x[%columns_bounded]xi32>
  %output_view = buffer.view %output_aligned[%buffer_base] : buffer -> view<4x[%columns_bounded]xi32>
  %loaded = view.load %input_view[%row_bounded, %column_bounded] : view<4x[%columns_bounded]xi32> -> i32
  view.store %loaded, %output_view[%row_bounded, %column_bounded] : i32, view<4x[%columns_bounded]xi32>
  func.return %loaded : i32
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.ref : buffer>, reg<vm.ref : buffer>, reg<vm.value : index>, reg<vm.value : index>, reg<vm.value : index>) -> (reg<vm.value : i32>)>}) @scalar_dynamic_stride_i32(%input_aligned: reg<vm.ref : buffer>, %output_aligned: reg<vm.ref : buffer>, %columns_bounded: reg<vm.value : index>, %row_bounded: reg<vm.value : index>, %column_bounded: reg<vm.value : index>) -> (reg<vm.value : i32>) asm {
  %21 = integer.mul.i64 %row_bounded, %columns_bounded : reg<vm.value : offset>
  %22 = constant.s16 2 : reg<vm.value : offset>
  %23 = integer.shift.left.i64 %21, %22 : reg<vm.value : offset>
  %25 = integer.shift.left.i64 %column_bounded, %22 : reg<vm.value : offset>
  %26 = integer.add.i64 %23, %25 : reg<vm.value : offset>
  %27 = constant.zero : reg<vm.value : offset>
  %loaded = buffer.load %input_aligned, %26, %27, 0, i32.x1 : reg<vm.value : i32>
  buffer.store %output_aligned, %26, %27, %loaded, 0, i32.x1
  return %loaded
}

