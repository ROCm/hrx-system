low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.ref : buffer>, reg<vm.ref : buffer>, reg<vm.value : index>) -> (reg<vm.value : i32>)>}) @scalar_dynamic_index_i32(%input_aligned: reg<vm.ref : buffer>, %output_aligned: reg<vm.ref : buffer>, %element_bounded: reg<vm.value : index>) -> (reg<vm.value : i32>) asm {
  %15 = constant.zero : reg<vm.value : offset>
  %loaded = buffer.load %input_aligned, %15, %element_bounded, 4, i32.x1 : reg<vm.value : i32>
  buffer.store %output_aligned, %15, %element_bounded, %loaded, 4, i32.x1
  return %loaded
}

