low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.ref : buffer>, reg<vm.ref : buffer>, reg<vm.value : offset>) -> (reg<vm.value : i32>)>}) @scalar_materialized_view_base_suffix_i32(%input_aligned: reg<vm.ref : buffer>, %output_aligned: reg<vm.ref : buffer>, %base_aligned: reg<vm.value : offset>) -> (reg<vm.value : i32>) asm {
  %16 = constant.s16 12 : reg<vm.value : offset>
  %loaded = buffer.load %input_aligned, %16, %base_aligned, 1, i32.x1 : reg<vm.value : i32>
  %18 = constant.s16 16 : reg<vm.value : offset>
  buffer.store %output_aligned, %18, %base_aligned, %loaded, 1, i32.x1
  return %loaded
}

