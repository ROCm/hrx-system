low.kernel.def target<vm.core>(@target) abi_layout({authored_signature = type<(reg<vm.ref : buffer>, reg<vm.ref : buffer>) -> ()>, signature = type<(reg<vm.ref : buffer>, reg<vm.ref : buffer>, reg<vm.value : index>, reg<vm.value : index>, reg<vm.value : index>, reg<vm.value : index>, reg<vm.value : index>, reg<vm.value : index>, reg<vm.value : index>, reg<vm.value : index>, reg<vm.value : index>, reg<vm.value : index>, reg<vm.value : index>, reg<vm.value : index>) -> ()>}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @f32_configured_width_square_reduce(%input: reg<vm.ref : buffer>, %output: reg<vm.ref : buffer>, %workgroup_id_x: reg<vm.value : index>, %workgroup_id_y: reg<vm.value : index>, %workgroup_id_z: reg<vm.value : index>, %workgroup_size_x: reg<vm.value : index>, %workgroup_size_y: reg<vm.value : index>, %workgroup_size_z: reg<vm.value : index>, %workgroup_count_x: reg<vm.value : index>, %workgroup_count_y: reg<vm.value : index>, %workgroup_count_z: reg<vm.value : index>, %lane: reg<vm.value : index>, %workitem_id_y: reg<vm.value : index>, %workitem_id_z: reg<vm.value : index>) asm {
  %65 = constant.zero : reg<vm.value : offset>
  %66 = buffer.load %input, %65, %lane, 16, i32.x1 : reg<vm.value : f32>
  %67 = float.mul.f32 %66, %66 : reg<vm.value : f32>
  %68 = constant.s16 4 : reg<vm.value : offset>
  %69 = buffer.load %input, %68, %lane, 16, i32.x1 : reg<vm.value : f32>
  %70 = float.math.ternary.f32 %69, %69, %67, fma : reg<vm.value : f32>
  %71 = constant.s16 8 : reg<vm.value : offset>
  %72 = buffer.load %input, %71, %lane, 16, i32.x1 : reg<vm.value : f32>
  %73 = float.math.ternary.f32 %72, %72, %70, fma : reg<vm.value : f32>
  %74 = constant.s16 12 : reg<vm.value : offset>
  %75 = buffer.load %input, %74, %lane, 16, i32.x1 : reg<vm.value : f32>
  %sum = float.math.ternary.f32 %75, %75, %73, fma : reg<vm.value : f32>
  %stored = concat(%sum) : (reg<vm.value : f32>) -> reg<vm.value : vector<1xf32>>
  buffer.store %output, %65, %65, %stored, 0, i32.x1
