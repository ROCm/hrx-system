  %34 = buffer.load %input, %33, %21, 0, i32.x1 : reg<vm.value : f32>
  %sum = float.add.f32 %31, %34 : reg<vm.value : f32>
  %stored = concat(%sum) : (reg<vm.value : f32>) -> reg<vm.value : vector<1xf32>>
  buffer.store %output, %21, %21, %stored, 0, i32.x1
