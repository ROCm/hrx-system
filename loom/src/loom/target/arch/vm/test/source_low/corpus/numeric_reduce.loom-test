low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.ref : buffer>, reg<vm.ref : buffer>) -> ()>}) @f32_reduce_add(%input: reg<vm.ref : buffer>, %output: reg<vm.ref : buffer>) asm {
  %init = constant.zero : reg<vm.value : f32>
