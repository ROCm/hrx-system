// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_reduce.loom-test
// RUN: emit source-low output=low

vm.target<core> @target
func.def target(@target) @i32_reduce_add(%input: buffer, %output: buffer) {
  %buffer_base = index.constant 0 : offset
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<4xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<1xi32>
  %loaded = vector.load %input_view[0] : view<4xi32> -> vector<4xi32>
  %init = scalar.constant 0 : i32
  %sum = vector.reduce<addi> %loaded, %init : vector<4xi32>, i32
  %stored = vector.from_elements %sum : vector<1xi32>
  vector.store %stored, %output_view[0] : vector<1xi32>, view<1xi32>
  func.return
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.ref : buffer>, reg<vm.ref : buffer>) -> ()>}) @i32_reduce_add(%input: reg<vm.ref : buffer>, %output: reg<vm.ref : buffer>) asm {
  %20 = constant.zero : reg<vm.value : offset>
  %21 = buffer.load %input, %20, %20, 0, i32.x1 : reg<vm.value : i32>
  %23 = constant.s16 4 : reg<vm.value : offset>
  %24 = buffer.load %input, %23, %20, 0, i32.x1 : reg<vm.value : i32>
  %25 = integer.add.i32 %21, %24 : reg<vm.value : i32>
  %27 = constant.s16 8 : reg<vm.value : offset>
  %28 = buffer.load %input, %27, %20, 0, i32.x1 : reg<vm.value : i32>
  %29 = integer.add.i32 %25, %28 : reg<vm.value : i32>
  %31 = constant.s16 12 : reg<vm.value : offset>
  %32 = buffer.load %input, %31, %20, 0, i32.x1 : reg<vm.value : i32>
  %sum = integer.add.i32 %29, %32 : reg<vm.value : i32>
  %stored = concat(%sum) : (reg<vm.value : i32>) -> reg<vm.value : vector<1xi32>>
  buffer.store %output, %20, %20, %stored, 0, i32.x1
  return
}

