low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value x4 : vector<4xi32>>) -> (reg<vm.value : i32>)>}) @i32_reduce_minui_select_sentinel(%values: reg<vm.value x4 : vector<4xi32>>) -> (reg<vm.value : i32>) asm {
  %45 = constant.zero : reg<vm.value : i32>
