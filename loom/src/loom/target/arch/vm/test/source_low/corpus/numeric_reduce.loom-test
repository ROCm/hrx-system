vm.target<core> @target
func.def target(@target) @f32_reduce_add_fastmath(%input: buffer, %output: buffer) {
  %buffer_base = index.constant 0 : offset
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<4xf32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<1xf32>
  %loaded = vector.load %input_view[0] : view<4xf32> -> vector<4xf32>
  %init = scalar.constant 0.0 : f32
  %sum = vector.reduce<addf, reassoc|nnan|nsz> %loaded, %init : vector<4xf32>, f32
  %stored = vector.from_elements %sum : vector<1xf32>
  vector.store %stored, %output_view[0] : vector<1xf32>, view<1xf32>
  func.return
}

