  %ugt = integer.compare.i64 %lhs, %rhs, ugt : reg<vm.value : i1>
  %uge = integer.compare.i64 %lhs, %rhs, uge : reg<vm.value : i1>
  %eq_result = value.select %eq, %true_value, %false_value : reg<vm.value : f32>
  %ne_result = value.select %ne, %true_value, %false_value : reg<vm.value : f32>
  %slt_result = value.select %slt, %true_value, %false_value : reg<vm.value : f32>
