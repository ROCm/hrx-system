  %mask = slice %mask_values[0] : reg<vm.value x2 : vector<2xi64>> -> reg<vm.value : i64>
  %product = integer.mul.i64 %lhs, %rhs : reg<vm.value : i64>
  %mixed = integer.xor.i64 %product, %mask : reg<vm.value : i64>
