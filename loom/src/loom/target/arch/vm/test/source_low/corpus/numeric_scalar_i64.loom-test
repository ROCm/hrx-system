vm.target<core> @target
func.def target(@target) @scalar_i64_compare_slt_if(%lhs: i64, %rhs: i64, %then_value: i32, %else_value: i32) -> (i32) {
  %cmp = scalar.cmpi slt, %lhs, %rhs : i64
  %result = scf.if %cmp -> (i32) {
    scf.yield %then_value : i32
  } else {
    scf.yield %else_value : i32
  }
  func.return %result : i32
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value : i64>, reg<vm.value : i64>, reg<vm.value : i32>, reg<vm.value : i32>) -> (reg<vm.value : i32>)>}) @scalar_i64_compare_slt_if(%lhs: reg<vm.value : i64>, %rhs: reg<vm.value : i64>, %then_value: reg<vm.value : i32>, %else_value: reg<vm.value : i32>) -> (reg<vm.value : i32>) asm {
  %cmp = integer.compare.i64 %lhs, %rhs, slt : reg<vm.value : i1>
  %result = value.select %cmp, %then_value, %else_value : reg<vm.value : i32>
  return %result
}

// ====

vm.target<core> @target
func.def target(@target) @scalar_i64_compare_constant_select(%lhs: i64, %true_value: f32, %false_value: f32) -> (f32) {
  %limit = scalar.constant 4294967296 : i64
  %cmp = scalar.cmpi ult, %lhs, %limit : i64
  %result = scf.select %cmp, %true_value, %false_value : f32
  func.return %result : f32
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value : i64>, reg<vm.value : f32>, reg<vm.value : f32>) -> (reg<vm.value : f32>)>}) @scalar_i64_compare_constant_select(%lhs: reg<vm.value : i64>, %true_value: reg<vm.value : f32>, %false_value: reg<vm.value : f32>) -> (reg<vm.value : f32>) asm {
  %limit = constant.i64 0, 1 : reg<vm.value : i64>
  %cmp = integer.compare.i64 %lhs, %limit, ult : reg<vm.value : i1>
  %result = value.select %cmp, %true_value, %false_value : reg<vm.value : f32>
  return %result
}

