vm.target<core> @target
func.def target(@target) @scalar_i64_bitwise_sgpr(%lhs: i64, %rhs: i64) -> (i64, i64, i64) {
  %and = scalar.andi %lhs, %rhs : i64
  %or = scalar.ori %and, %lhs : i64
  %xor = scalar.xori %or, %rhs : i64
  func.return %and, %or, %xor : i64, i64, i64
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value : i64>, reg<vm.value : i64>) -> (reg<vm.value : i64>, reg<vm.value : i64>, reg<vm.value : i64>)>}) @scalar_i64_bitwise_sgpr(%lhs: reg<vm.value : i64>, %rhs: reg<vm.value : i64>) -> (reg<vm.value : i64>, reg<vm.value : i64>, reg<vm.value : i64>) asm {
  %and = integer.and.i64 %lhs, %rhs : reg<vm.value : i64>
  %or = integer.or.i64 %and, %lhs : reg<vm.value : i64>
  %xor = integer.xor.i64 %or, %rhs : reg<vm.value : i64>
  return %and, %or, %xor
}

