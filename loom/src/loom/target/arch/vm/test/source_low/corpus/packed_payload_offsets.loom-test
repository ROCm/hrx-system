// TEMPLATE: loom/src/loom/test/corpus/source_low/packed_payload_offsets.loom-test
// RUN: emit source-low output=low

vm.target<core> @target
func.def target(@target) @packed4_payload_word_offset(%weights: buffer, %block0: index, %word0: index) -> (i32) {
  %block = index.assume %block0 [range(%block0, 0, 63)] : index
  %word = index.assume %word0 [range(%word0, 0, 3)] : index
  %block_byte_stride = index.constant 18 : offset
  %payload_header_offset = index.constant 2 : offset
  %word_byte_stride = index.constant 4 : offset
  %block_base = index.scale %block, %block_byte_stride : index, offset -> offset
  %payload_base = index.add %block_base, %payload_header_offset : offset
  %word_byte_offset = index.scale %word, %word_byte_stride : index, offset -> offset
  %byte_offset = index.add %payload_base, %word_byte_offset : offset
  %weights_global = buffer.assume.memory_space<global> %weights : buffer
  %word_view = buffer.view %weights_global[%byte_offset] : buffer -> view<1xi32>
  %packed_word = view.load %word_view[0] : view<1xi32> -> i32
  func.return %packed_word : i32
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.ref : buffer>, reg<vm.value : index>, reg<vm.value : index>) -> (reg<vm.value : i32>)>}) @packed4_payload_word_offset(%weights_global: reg<vm.ref : buffer>, %block: reg<vm.value : index>, %word: reg<vm.value : index>) -> (reg<vm.value : i32>) asm {
  %20 = constant.s16 18 : reg<vm.value : offset>
  %21 = integer.mul.i64 %block, %20 : reg<vm.value : offset>
  %22 = constant.s16 2 : reg<vm.value : offset>
  %23 = integer.shift.left.i64 %word, %22 : reg<vm.value : offset>
  %24 = integer.add.i64 %21, %23 : reg<vm.value : offset>
  %25 = constant.zero : reg<vm.value : offset>
  %27 = integer.add.i64 %24, %22 : reg<vm.value : offset>
  %packed_word = buffer.load %weights_global, %27, %25, 0, i32.x1 : reg<vm.value : i32>
  return %packed_word
}

