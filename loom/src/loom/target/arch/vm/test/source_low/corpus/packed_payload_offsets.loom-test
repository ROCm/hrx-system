vm.target<core> @target
func.def target(@target) @packed5_split_payload_offsets(%weights: buffer, %block0: index, %word0: index) -> (i32, i32) {
  %block = index.assume %block0 [range(%block0, 0, 63)] : index
  %word = index.assume %word0 [range(%word0, 0, 3)] : index
  %block_byte_stride = index.constant 22 : offset
  %side_bits_header_offset = index.constant 2 : offset
  %low_bits_header_offset = index.constant 6 : offset
  %word_byte_stride = index.constant 4 : offset
  %block_base = index.scale %block, %block_byte_stride : index, offset -> offset
  %side_bits_byte_offset = index.add %block_base, %side_bits_header_offset : offset
  %low_bits_base = index.add %block_base, %low_bits_header_offset : offset
  %low_word_byte_offset = index.scale %word, %word_byte_stride : index, offset -> offset
  %low_bits_byte_offset = index.add %low_bits_base, %low_word_byte_offset : offset
  %weights_global = buffer.assume.memory_space<global> %weights : buffer
  %side_bits_view = buffer.view %weights_global[%side_bits_byte_offset] : buffer -> view<1xi32>
  %low_bits_view = buffer.view %weights_global[%low_bits_byte_offset] : buffer -> view<1xi32>
  %side_bits_word = view.load %side_bits_view[0] : view<1xi32> -> i32
  %low_bits_word = view.load %low_bits_view[0] : view<1xi32> -> i32
  func.return %side_bits_word, %low_bits_word : i32, i32
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.ref : buffer>, reg<vm.value : index>, reg<vm.value : index>) -> (reg<vm.value : i32>, reg<vm.value : i32>)>}) @packed5_split_payload_offsets(%weights_global: reg<vm.ref : buffer>, %block: reg<vm.value : index>, %word: reg<vm.value : index>) -> (reg<vm.value : i32>, reg<vm.value : i32>) asm {
  %26 = constant.s16 2 : reg<vm.value : offset>
  %side_bits_word = buffer.load %weights_global, %26, %block, 22, i32.x1 : reg<vm.value : i32>
  %28 = constant.s16 22 : reg<vm.value : offset>
  %29 = integer.mul.i64 %block, %28 : reg<vm.value : offset>
  %31 = integer.shift.left.i64 %word, %26 : reg<vm.value : offset>
  %32 = integer.add.i64 %29, %31 : reg<vm.value : offset>
  %33 = constant.zero : reg<vm.value : offset>
  %34 = constant.s16 6 : reg<vm.value : offset>
  %35 = integer.add.i64 %32, %34 : reg<vm.value : offset>
  %low_bits_word = buffer.load %weights_global, %35, %33, 0, i32.x1 : reg<vm.value : i32>
  return %side_bits_word, %low_bits_word
}

