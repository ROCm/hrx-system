vm.target<core> @target
func.def target(@target) @global_f32x64_add_roundtrip(%lhs: buffer, %rhs: buffer, %output: buffer) {
  %buffer_base = index.constant 0 : offset
  %lhs_view = buffer.view %lhs[%buffer_base] : buffer -> view<64xf32>
  %rhs_view = buffer.view %rhs[%buffer_base] : buffer -> view<64xf32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<64xf32>
  %lhs_loaded = vector.load %lhs_view[0] : view<64xf32> -> vector<64xf32>
  %rhs_loaded = vector.load %rhs_view[0] : view<64xf32> -> vector<64xf32>
  %sum = vector.addf %lhs_loaded, %rhs_loaded : vector<64xf32>
  vector.store %sum, %output_view[0] : vector<64xf32>, view<64xf32>
  func.return
}

