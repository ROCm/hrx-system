// RUN: emit source-low output=low

vm.target<core> @target

global.variable @sink : index

kernel.def target(@target) @scalar_kernel_profile(%workgroup_count_x: index, %workgroup_count_y: index, %workgroup_count_z: index) {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%workgroup_count_x, %workgroup_count_y, %workgroup_count_z) workgroup_size(%c1, %c1, %c1) : index
} launch(%bias: index) {
  %workgroup_id_x = kernel.workgroup.id<x> : index
  %workgroup_count_y = kernel.workgroup.count<y> : index
  %cluster_id_z = kernel.cluster.id<z> : index
  %cluster_count_x = kernel.cluster.count<x> : index
  %workitem_id_z = kernel.workitem.id<z> : index
  %subgroup_size = kernel.subgroup.size : index
  %sum0 = index.add %bias, %workgroup_id_x : index
  %sum1 = index.add %sum0, %workgroup_count_y : index
  %sum2 = index.add %sum1, %cluster_id_z : index
  %sum3 = index.add %sum2, %cluster_count_x : index
  %sum4 = index.add %sum3, %workitem_id_z : index
  %sum5 = index.add %sum4, %subgroup_size : index
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  global.store %sum5, @sink : index
  kernel.return
}

// ----
low.kernel.def target<vm.core>(@target) workgroup_size(1, 1, 1) @scalar_kernel_profile(%bias: reg<vm.value : index>, %workgroup_id_x: reg<vm.value : index>, %workgroup_id_y: reg<vm.value : index>, %workgroup_id_z: reg<vm.value : index>, %workgroup_count_x: reg<vm.value : index>, %workgroup_count_y: reg<vm.value : index>, %workgroup_count_z: reg<vm.value : index>) asm {
  %subgroup_size = constant.s16 1 : reg<vm.value : index>
  %sum0 = integer.add.i64 %bias, %workgroup_id_x : reg<vm.value : index>
  %sum1 = integer.add.i64 %sum0, %workgroup_count_y : reg<vm.value : index>
  %sum2 = integer.add.i64 %sum1, %workgroup_id_z : reg<vm.value : index>
  %sum3 = integer.add.i64 %sum2, %workgroup_count_x : reg<vm.value : index>
  %sum5 = integer.add.i64 %sum3, %subgroup_size : reg<vm.value : index>
  global.value.mutable.store %sum5, 0
  return
}
