low.kernel.def target<vm.core>(@target) abi_layout({authored_signature = type<() -> ()>, signature = type<(reg<vm.value : index>, reg<vm.value : index>, reg<vm.value : index>, reg<vm.value : index>, reg<vm.value : index>, reg<vm.value : index>, reg<vm.value : index>, reg<vm.value : index>, reg<vm.value : index>, reg<vm.value : index>, reg<vm.value : index>, reg<vm.value : index>) -> ()>}) @dynamic_kernel_profile(%workgroup_id_x: reg<vm.value : index>, %workgroup_id_y: reg<vm.value : index>, %workgroup_id_z: reg<vm.value : index>, %workgroup_size_x: reg<vm.value : index>, %workgroup_size_y: reg<vm.value : index>, %workgroup_size_z: reg<vm.value : index>, %workgroup_count_x: reg<vm.value : index>, %workgroup_count_y: reg<vm.value : index>, %workgroup_count_z: reg<vm.value : index>, %workitem_id_x: reg<vm.value : index>, %workitem_id_y: reg<vm.value : index>, %workitem_id_z: reg<vm.value : index>) asm {
  %27 = integer.mul.i64 %workgroup_id_x, %workgroup_size_x : reg<vm.value : index>
  %dispatch_id_x = integer.add.i64 %27, %workitem_id_x : reg<vm.value : index>
  %29 = integer.mul.i64 %workgroup_size_y, %workitem_id_z : reg<vm.value : index>
  %30 = integer.add.i64 %29, %workitem_id_y : reg<vm.value : index>
  %31 = integer.mul.i64 %workgroup_size_x, %30 : reg<vm.value : index>
  %subgroup_id = integer.add.i64 %31, %workitem_id_x : reg<vm.value : index>
  %33 = integer.mul.i64 %workgroup_size_x, %workgroup_size_y : reg<vm.value : index>
  %subgroup_count = integer.mul.i64 %33, %workgroup_size_z : reg<vm.value : index>
  %sum0 = integer.add.i64 %workgroup_id_x, %workgroup_size_x : reg<vm.value : index>
  %sum1 = integer.add.i64 %sum0, %workitem_id_x : reg<vm.value : index>
  %sum2 = integer.add.i64 %sum1, %dispatch_id_x : reg<vm.value : index>
  %sum3 = integer.add.i64 %sum2, %subgroup_id : reg<vm.value : index>
  %sum4 = integer.add.i64 %sum3, %subgroup_count : reg<vm.value : index>
  global.value.mutable.store %sum4, 0
  return
}
