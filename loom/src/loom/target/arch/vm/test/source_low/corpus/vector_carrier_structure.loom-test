vm.target<core> @target
func.def target(@target) @vector_insert_static(%vector: vector<4xf32>, %value: f32) -> (vector<4xf32>) {
  %result = vector.insert %value into %vector[2] : f32, vector<4xf32>
  func.return %result : vector<4xf32>
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value x4 : vector<4xf32>>, reg<vm.value : f32>) -> (reg<vm.value x4 : vector<4xf32>>)>}) @vector_insert_static(%vector: reg<vm.value x4 : vector<4xf32>>, %value: reg<vm.value : f32>) -> (reg<vm.value x4 : vector<4xf32>>) asm {
  %7 = slice %vector[0] : reg<vm.value x4 : vector<4xf32>> -> reg<vm.value x2 : vector<2xf32>>
  %8 = slice %vector[3] : reg<vm.value x4 : vector<4xf32>> -> reg<vm.value : vector<1xf32>>
  %result = concat(%7, %value, %8) : (reg<vm.value x2 : vector<2xf32>>, reg<vm.value : f32>, reg<vm.value : vector<1xf32>>) -> reg<vm.value x4 : vector<4xf32>>
  return %result
}

