vm.target<core> @target
func.def target(@target) @vector_concat_outer(%lhs: vector<1x2xi8>, %rhs: vector<2x2xi8>) -> (vector<3x2xi8>) {
  %result = vector.concat<0> %lhs, %rhs : vector<1x2xi8>, vector<2x2xi8> -> vector<3x2xi8>
  func.return %result : vector<3x2xi8>
}

