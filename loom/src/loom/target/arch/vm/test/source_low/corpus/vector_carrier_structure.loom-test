vm.target<core> @target
func.def target(@target) @vector_concat_inner(%lhs: vector<2x1xi8>, %rhs: vector<2x2xi8>) -> (vector<2x3xi8>) {
  %result = vector.concat<1> %lhs, %rhs : vector<2x1xi8>, vector<2x2xi8> -> vector<2x3xi8>
  func.return %result : vector<2x3xi8>
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value x2 : vector<2x1xi8>>, reg<vm.value x4 : vector<2x2xi8>>) -> (reg<vm.value x6 : vector<2x3xi8>>)>}) @vector_concat_inner(%lhs: reg<vm.value x2 : vector<2x1xi8>>, %rhs: reg<vm.value x4 : vector<2x2xi8>>) -> (reg<vm.value x6 : vector<2x3xi8>>) asm {
  %7 = slice %lhs[0] : reg<vm.value x2 : vector<2x1xi8>> -> reg<vm.value : vector<1xi8>>
  %8 = slice %rhs[0] : reg<vm.value x4 : vector<2x2xi8>> -> reg<vm.value x2 : vector<2xi8>>
  %9 = slice %lhs[1] : reg<vm.value x2 : vector<2x1xi8>> -> reg<vm.value : vector<1xi8>>
  %10 = slice %rhs[2] : reg<vm.value x4 : vector<2x2xi8>> -> reg<vm.value x2 : vector<2xi8>>
  %result = concat(%7, %8, %9, %10) : (reg<vm.value : vector<1xi8>>, reg<vm.value x2 : vector<2xi8>>, reg<vm.value : vector<1xi8>>, reg<vm.value x2 : vector<2xi8>>) -> reg<vm.value x6 : vector<2x3xi8>>
  return %result
}
