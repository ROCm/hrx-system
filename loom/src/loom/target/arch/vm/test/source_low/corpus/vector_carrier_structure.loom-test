low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value x2 : vector<1x2xi8>>, reg<vm.value x4 : vector<2x2xi8>>) -> (reg<vm.value x6 : vector<3x2xi8>>)>}) @vector_concat_outer(%lhs: reg<vm.value x2 : vector<1x2xi8>>, %rhs: reg<vm.value x4 : vector<2x2xi8>>) -> (reg<vm.value x6 : vector<3x2xi8>>) asm {
  %result = concat(%lhs, %rhs) : (reg<vm.value x2 : vector<1x2xi8>>, reg<vm.value x4 : vector<2x2xi8>>) -> reg<vm.value x6 : vector<3x2xi8>>
  return %result
}

