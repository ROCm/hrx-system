vm.target<core> @target
func.def target(@target) @vector_extract_tail(%vector: vector<2x3xi32>) -> (vector<3xi32>) {
  %result = vector.extract %vector[1] : vector<2x3xi32> -> vector<3xi32>
  func.return %result : vector<3xi32>
}

