low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value x12 : vector<3x4xi16>>) -> (reg<vm.value x4 : vector<2x2xi16>>)>}) @vector_slice_tile(%vector: reg<vm.value x12 : vector<3x4xi16>>) -> (reg<vm.value x4 : vector<2x2xi16>>) asm {
  %5 = slice %vector[5] : reg<vm.value x12 : vector<3x4xi16>> -> reg<vm.value x2 : vector<2xi16>>
  %6 = slice %vector[9] : reg<vm.value x12 : vector<3x4xi16>> -> reg<vm.value x2 : vector<2xi16>>
  %result = concat(%5, %6) : (reg<vm.value x2 : vector<2xi16>>, reg<vm.value x2 : vector<2xi16>>) -> reg<vm.value x4 : vector<2x2xi16>>
  return %result
}

