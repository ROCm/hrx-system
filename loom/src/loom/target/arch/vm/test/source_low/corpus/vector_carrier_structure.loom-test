vm.target<core> @target
func.def target(@target) @vector_from_elements_extract(%a: i32, %b: i32, %c: i32, %d: i32) -> (vector<4xi32>, i32) {
  %vector = vector.from_elements %a, %b, %c, %d : vector<4xi32>
  %selected = vector.extract %vector[2] : vector<4xi32> -> i32
  func.return %vector, %selected : vector<4xi32>, i32
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>) -> (reg<vm.value x4 : vector<4xi32>>, reg<vm.value : i32>)>}) @vector_from_elements_extract(%a: reg<vm.value : i32>, %b: reg<vm.value : i32>, %c: reg<vm.value : i32>, %d: reg<vm.value : i32>) -> (reg<vm.value x4 : vector<4xi32>>, reg<vm.value : i32>) asm {
  %vector = concat(%a, %b, %c, %d) : (reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>) -> reg<vm.value x4 : vector<4xi32>>
  return %vector, %c
}

