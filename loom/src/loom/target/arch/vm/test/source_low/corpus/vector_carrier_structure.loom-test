low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value x6 : vector<2x3xi32>>) -> (reg<vm.value x3 : vector<3xi32>>)>}) @vector_extract_tail(%vector: reg<vm.value x6 : vector<2x3xi32>>) -> (reg<vm.value x3 : vector<3xi32>>) asm {
  %result = slice %vector[3] : reg<vm.value x6 : vector<2x3xi32>> -> reg<vm.value x3 : vector<3xi32>>
  return %result
}

