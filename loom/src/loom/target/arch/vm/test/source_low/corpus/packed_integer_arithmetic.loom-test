  %69 = conversion.integer %68, i32.to.i16 : reg<vm.value : i16>
  %result = concat(%51, %57, %63, %69) : (reg<vm.value : i16>, reg<vm.value : i16>, reg<vm.value : i16>, reg<vm.value : i16>) -> reg<vm.value x4 : vector<4xi16>>
  return %result
}
