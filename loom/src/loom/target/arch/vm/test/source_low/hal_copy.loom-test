// RUN: emit source-low target=vm:core output=low

// The invocation supplies the target. Authored symbols may use the generated
// import prefix; the common function registry and target context stay distinct.
func.def public @__hal_1(%queue: hal.queue, %semaphore: hal.semaphore, %source: hal.buffer, %target: hal.buffer, %offset: i64, %length: i64, %value: i64, %flags: i64) {
  hal.queue.copy (%queue, [(%semaphore, %value)], [], (%source, %offset), (%target, %offset), %length, (none, []), %flags)
  func.return
}

// ----
low.func.def public target<vm.core> abi(vm_function) @__hal_1(%queue: reg<vm.ref : hal.queue>, %semaphore: reg<vm.ref : hal.semaphore>, %source: reg<vm.ref : hal.buffer>, %target: reg<vm.ref : hal.buffer>, %offset: reg<vm.value : i64>, %length: reg<vm.value : i64>, %value: reg<vm.value : i64>, %flags: reg<vm.value : i64>) asm {
  low.func.call @__hal_2(%queue, [(%semaphore, %value)], [], %source, %offset, %target, %offset, %length, [], [[]], %flags) : (reg<vm.ref : hal.queue>, reg<vm.ref : hal.semaphore>, reg<vm.value : i64>, reg<vm.ref : hal.buffer>, reg<vm.value : i64>, reg<vm.ref : hal.buffer>, reg<vm.value : i64>, reg<vm.value : i64>, reg<vm.value : i64>)
  return
}

low.func.decl import(native, "queue.copy", module = "hal") target<vm.core> abi(vm_native) abi_layout({signature = vm.record<hal.queue, vm.range<hal.semaphore, i64>, vm.range<hal.semaphore, i64>, hal.buffer, i64, hal.buffer, i64, i64, vm.range<vm.range<i32, i32, i64, i32, vm.range<i32, i32>, vm.range<i32, i32, hal.buffer, i64, i64, vm.range<i32, vm.range<i32, i32, i32, i64, i32, i32, i32>>>>>, vm.range<vm.range<i32, i32, i64, i32, vm.range<i32, i32>, vm.range<i32, i32, hal.buffer, i64, i64, vm.range<i32, vm.range<i32, i32, i32, i64, i32, i32, i32>>>>>, i64>, version = 1}) @__hal_2(%16: reg<vm.ref : hal.queue>, %17: reg<vm.ref : hal.semaphore>, %18: reg<vm.value : i64>, %19: reg<vm.ref : hal.buffer>, %20: reg<vm.value : i64>, %21: reg<vm.ref : hal.buffer>, %22: reg<vm.value : i64>, %23: reg<vm.value : i64>, %24: reg<vm.value : i64>)
