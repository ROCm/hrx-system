// TEMPLATE: loom/src/loom/test/corpus/source_low/rodata.loom-test
// RUN: emit vm-dis target=vm:core

global.rodata.def @unused = align(4096) bytes("aabbcc")

global.rodata.def @table = align(64) bytes("1122334480ff007e")

func.def @table_byte(%position: offset) -> (i32) {
  %table = global.load @table : buffer
  %result = buffer.load.i8.u %table[%position]
  func.return %result : i32
}

// ----
vm.module core(0.0) {
  section signatures alignment(8) {
    signature @signature0 (i64) -> (i32)
  }

  section callable_types alignment(8) {
    callable @callable0 flags([]) depth(0) : @signature0
  }

  section functions alignment(8) {
    func @function0 : @callable0 flags([]) frame(local_bytes = 0, value_registers = 1, ref_registers = 1, function_registers = 0, local_refs = 0, local_functions = 0) {
    ^bb0:
      control.block
      %r0 = buffer.rodata.load @rodata0
      %v0.x1 = buffer.load.i8 %r0, %v0, %v0 {scale = 0}
      control.return
    }
  }

  section rodata alignment(64) {
    rodata @rodata0 alignment(64) = hex"1122334480FF007E"
  }

}

// ====

global.rodata.def @empty = bytes("")

global.rodata.def @odd = align(2) bytes("abcdef")

global.rodata.def @wide = align(128) bytes("01020304")

func.def @data_roots() -> (buffer, buffer, buffer) {
  %empty = global.load @empty : buffer
  %odd = global.load @odd : buffer
  %wide = global.load @wide : buffer
  func.return %empty, %odd, %wide : buffer, buffer, buffer
}

// ----
vm.module core(0.0) {
  section strings alignment(8) {
    string @string0 = "vm"
    string @string1 = "buffer"
  }

  section ref_types alignment(8) {
    namespace @ref_group0 name(@string0) {
      ref_type @ref_type0 name(@string1)
    }
  }

  section signatures alignment(8) {
    signature @signature0 () -> (ref(@ref_type0), ref(@ref_type0), ref(@ref_type0))
  }

  section callable_types alignment(8) {
    callable @callable0 flags([]) depth(0) : @signature0
  }

  section functions alignment(8) {
    func @function0 : @callable0 flags([]) frame(local_bytes = 0, value_registers = 0, ref_registers = 3, function_registers = 0, local_refs = 0, local_functions = 0) {
    ^bb0:
      control.block
      %r0 = buffer.rodata.load @rodata0
      %r1 = buffer.rodata.load @rodata1
      %r2 = buffer.rodata.load @rodata2
      control.return
    }
  }

  section rodata alignment(128) {
    rodata @rodata0 alignment(1) = hex""
    rodata @rodata1 alignment(2) = hex"ABCDEF"
    rodata @rodata2 alignment(128) = hex"01020304"
  }

}

// ====

global.rodata.def @shared = align(8) bytes("0102030405060708")

func.def @data_copy(%target: buffer, %start: offset, %length: offset) {
  %source = global.load @shared : buffer
  %target_offset = index.constant 0 : offset
  buffer.copy %source[%start], %target[%target_offset], %length
  func.return
}

// ----
vm.module core(0.0) {
  section strings alignment(8) {
    string @string0 = "vm"
    string @string1 = "buffer"
  }

  section ref_types alignment(8) {
    namespace @ref_group0 name(@string0) {
      ref_type @ref_type0 name(@string1)
    }
  }

  section signatures alignment(8) {
    signature @signature0 (ref(@ref_type0), i64, i64) -> ()
  }

  section callable_types alignment(8) {
    callable @callable0 flags([]) depth(0) : @signature0
  }

  section functions alignment(8) {
    func @function0 : @callable0 flags([]) frame(local_bytes = 0, value_registers = 3, ref_registers = 2, function_registers = 0, local_refs = 0, local_functions = 0) {
    ^bb0:
      control.block
      %r1 = buffer.rodata.load @rodata0
      %v2 = constant.zero
      buffer.copy %r0, %v2, %r1, %v0, %v1
      control.return
    }
  }

  section rodata alignment(8) {
    rodata @rodata0 alignment(8) = hex"0102030405060708"
  }

}
