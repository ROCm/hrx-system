// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_float_arithmetic.loom-test
// RUN: emit source-low target=vm:core output=low

func.def @float_arithmetic_f32(%a: f32, %b: f32) -> (f32, f32, f32, f32, f32, f32, f32, f32) {
  %sum = scalar.addf %a, %b : f32
  %difference = scalar.subf %a, %b : f32
  %product = scalar.mulf %a, %b : f32
  %quotient = scalar.divf %a, %b : f32
  %remainder = scalar.remf %a, %b : f32
  %signed = scalar.copysignf %a, %b : f32
  %negated = scalar.negf %a : f32
  %absolute = scalar.absf %a : f32
  func.return %sum, %difference, %product, %quotient, %remainder, %signed, %negated, %absolute : f32, f32, f32, f32, f32, f32, f32, f32
}

// ----
low.func.def target<vm.core> abi(vm_function) @float_arithmetic_f32(%a: reg<vm.value : f32>, %b: reg<vm.value : f32>) -> (reg<vm.value : f32>, reg<vm.value : f32>, reg<vm.value : f32>, reg<vm.value : f32>, reg<vm.value : f32>, reg<vm.value : f32>, reg<vm.value : f32>, reg<vm.value : f32>) asm {
  %sum = float.add.f32 %a, %b
  %difference = float.sub.f32 %a, %b
  %product = float.mul.f32 %a, %b
  %quotient = float.div.f32 %a, %b
  %remainder = float.rem.f32 %a, %b
  %signed = float.copysign.f32 %a, %b
  %negated = float.neg.f32 %a
  %absolute = float.abs.f32 %a
  return %sum, %difference, %product, %quotient, %remainder, %signed, %negated, %absolute
}

// ====

func.def @float_arithmetic_f64(%a: f64, %b: f64) -> (f64, f64, f64, f64, f64, f64, f64, f64) {
  %sum = scalar.addf %a, %b : f64
  %difference = scalar.subf %a, %b : f64
  %product = scalar.mulf %a, %b : f64
  %quotient = scalar.divf %a, %b : f64
  %remainder = scalar.remf %a, %b : f64
  %signed = scalar.copysignf %a, %b : f64
  %negated = scalar.negf %a : f64
  %absolute = scalar.absf %a : f64
  func.return %sum, %difference, %product, %quotient, %remainder, %signed, %negated, %absolute : f64, f64, f64, f64, f64, f64, f64, f64
}

// ----
low.func.def target<vm.core> abi(vm_function) @float_arithmetic_f64(%a: reg<vm.value : f64>, %b: reg<vm.value : f64>) -> (reg<vm.value : f64>, reg<vm.value : f64>, reg<vm.value : f64>, reg<vm.value : f64>, reg<vm.value : f64>, reg<vm.value : f64>, reg<vm.value : f64>, reg<vm.value : f64>) asm {
  %sum = float.add.f64 %a, %b
  %difference = float.sub.f64 %a, %b
  %product = float.mul.f64 %a, %b
  %quotient = float.div.f64 %a, %b
  %remainder = float.rem.f64 %a, %b
  %signed = float.copysign.f64 %a, %b
  %negated = float.neg.f64 %a
  %absolute = float.abs.f64 %a
  return %sum, %difference, %product, %quotient, %remainder, %signed, %negated, %absolute
}

// ====

func.def @float_arithmetic_f16(%a: f16, %b: f16) -> (f16, f16) {
  %sum = scalar.addf %a, %b : f16
  %product = scalar.mulf %a, %b : f16
  func.return %sum, %product : f16, f16
}

// ----
low.func.def target<vm.core> abi(vm_function) @float_arithmetic_f16(%a: reg<vm.value : f16>, %b: reg<vm.value : f16>) -> (reg<vm.value : f16>, reg<vm.value : f16>) asm {
  %18 = conversion.float.extend %a, "f16.to.f32" : reg<vm.value : f32>
  %19 = conversion.float.extend %b, "f16.to.f32" : reg<vm.value : f32>
  %20 = float.add.f32 %18, %19
  %sum = conversion.float.truncate %20, "f32.to.f16" : reg<vm.value : f16>
  %22 = float.mul.f32 %18, %19
  %product = conversion.float.truncate %22, "f32.to.f16" : reg<vm.value : f16>
  return %sum, %product
}

// ====

func.def @float_arithmetic_bf16(%a: bf16, %b: bf16) -> (bf16, bf16) {
  %sum = scalar.addf %a, %b : bf16
  %product = scalar.mulf %a, %b : bf16
  func.return %sum, %product : bf16, bf16
}

// ----
low.func.def target<vm.core> abi(vm_function) @float_arithmetic_bf16(%a: reg<vm.value : bf16>, %b: reg<vm.value : bf16>) -> (reg<vm.value : bf16>, reg<vm.value : bf16>) asm {
  %18 = conversion.float.extend %a, "bf16.to.f32" : reg<vm.value : f32>
  %19 = conversion.float.extend %b, "bf16.to.f32" : reg<vm.value : f32>
  %20 = float.add.f32 %18, %19
  %sum = conversion.float.truncate %20, "f32.to.bf16" : reg<vm.value : bf16>
  %22 = float.mul.f32 %18, %19
  %product = conversion.float.truncate %22, "f32.to.bf16" : reg<vm.value : bf16>
  return %sum, %product
}
