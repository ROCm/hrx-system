// ====

func.def @roots_f32(%value: f32) -> (f32, f32) {
  %root = scalar.sqrtf %value : f32
  %inverse = scalar.rsqrtf %value : f32
  func.return %root, %inverse : f32, f32
}

// ----
low.func.def target<vm.core> abi(vm_function) @roots_f32(%value: reg<vm.value : f32>) -> (reg<vm.value : f32>, reg<vm.value : f32>) asm {
  %8 = constant.i32 8388608 : reg<vm.value : f32>
  %9 = constant.i32 1266679808 : reg<vm.value : f32>
  %10 = constant.i32 964689920 : reg<vm.value : f32>
  %11 = constant.i32 1065353216 : reg<vm.value : f32>
  %12 = float.abs.f32 %value
  %13 = float.compare.f32 %12, %8, "olt"
  %14 = value.select %13, %9, %11 : reg<vm.value : f32>
  %15 = value.select %13, %10, %11 : reg<vm.value : f32>
  %16 = float.mul.f32 %value, %14
  %17 = float.math.unary.f32 %16, "sqrt.approx"
  %root = float.mul.f32 %17, %15
  %21 = constant.i32 1166016512 : reg<vm.value : f32>
  %26 = value.select %13, %21, %11 : reg<vm.value : f32>
  %28 = float.math.unary.f32 %16, "rsqrt.approx"
  %inverse = float.mul.f32 %28, %26
  return %root, %inverse
}

// ====

func.def @log2_f32(%value: f32) -> (f32) {
  %result = scalar.log2f<afn> %value : f32
  func.return %result : f32
}

// ----
low.func.def target<vm.core> abi(vm_function) @log2_f32(%value: reg<vm.value : f32>) -> (reg<vm.value : f32>) asm {
  %5 = constant.i32 8388608 : reg<vm.value : f32>
  %6 = constant.i32 1266679808 : reg<vm.value : f32>
  %7 = constant.i32 1103101952 : reg<vm.value : f32>
  %8 = constant.i32 1065353216 : reg<vm.value : f32>
  %9 = constant.i32 0 : reg<vm.value : f32>
  %10 = float.abs.f32 %value
  %11 = float.compare.f32 %10, %5, "olt"
  %12 = value.select %11, %6, %8 : reg<vm.value : f32>
  %13 = value.select %11, %7, %9 : reg<vm.value : f32>
  %14 = float.mul.f32 %value, %12
  %15 = float.math.unary.f32 %14, "log2.approx"
  %result = float.sub.f32 %15, %13
  return %result
}

// ====

func.def @log_f32(%value: f32) -> (f32) {
  %result = scalar.logf<afn> %value : f32
  func.return %result : f32
}

// ----
low.func.def target<vm.core> abi(vm_function) @log_f32(%value: reg<vm.value : f32>) -> (reg<vm.value : f32>) asm {
  %8 = constant.i32 1060205080 : reg<vm.value : f32>
  %9 = constant.i32 8388608 : reg<vm.value : f32>
  %10 = constant.i32 1266679808 : reg<vm.value : f32>
  %11 = constant.i32 1103101952 : reg<vm.value : f32>
  %12 = constant.i32 1065353216 : reg<vm.value : f32>
  %13 = constant.i32 0 : reg<vm.value : f32>
  %14 = float.abs.f32 %value
  %15 = float.compare.f32 %14, %9, "olt"
  %16 = value.select %15, %10, %12 : reg<vm.value : f32>
  %17 = value.select %15, %11, %13 : reg<vm.value : f32>
  %18 = float.mul.f32 %value, %16
  %19 = float.math.unary.f32 %18, "log2.approx"
  %20 = float.sub.f32 %19, %17
  %result = float.mul.f32 %20, %8
  return %result
}
