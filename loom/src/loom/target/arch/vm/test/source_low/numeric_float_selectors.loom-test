func.def @float_bitcasts_f32(%bits: i32, %number: f32) -> (f32, i32) {
  %as_number = scalar.bitcast %bits : i32 to f32
  %as_bits = scalar.bitcast %number : f32 to i32
  func.return %as_number, %as_bits : f32, i32
}

// ----
low.func.def target<vm.core> abi(vm_function) @float_bitcasts_f32(%bits: reg<vm.value : i32>, %number: reg<vm.value : f32>) -> (reg<vm.value : f32>, reg<vm.value : i32>) asm {
  %as_number = value.copy %bits : reg<vm.value : f32>
  %as_bits = value.copy %number : reg<vm.value : i32>
  return %as_number, %as_bits
}

