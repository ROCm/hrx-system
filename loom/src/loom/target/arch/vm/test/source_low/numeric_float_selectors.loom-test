low.func.def target<vm.core> abi(vm_function) @float_predicates_f32(%a: reg<vm.value : f32>, %b: reg<vm.value : f32>) -> (reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>) asm {
  %oeq = float.compare.f32 %a, %b, "oeq"
  %ogt = float.compare.f32 %a, %b, "ogt"
  %oge = float.compare.f32 %a, %b, "oge"
  %olt = float.compare.f32 %a, %b, "olt"
  %ole = float.compare.f32 %a, %b, "ole"
  %one = float.compare.f32 %a, %b, "one"
  %ord = float.compare.f32 %a, %b, "ord"
  %ueq = float.compare.f32 %a, %b, "ueq"
  %ugt = float.compare.f32 %a, %b, "ugt"
  %uge = float.compare.f32 %a, %b, "uge"
  %ult = float.compare.f32 %a, %b, "ult"
  %ule = float.compare.f32 %a, %b, "ule"
  %une = float.compare.f32 %a, %b, "une"
  %uno = float.compare.f32 %a, %b, "uno"
  return %oeq, %ogt, %oge, %olt, %ole, %one, %ord, %ueq, %ugt, %uge, %ult, %ule, %une, %uno
}

// ====

func.def @float_selected_f32(%a: f32, %b: f32, %c: f32) -> (f32, f32, f32, f32, i1, i1, i1, f32, f32, f32, f32) {
  %minimum = scalar.minimumf %a, %b : f32
  %maximum = scalar.maximumf %a, %b : f32
  %minnum = scalar.minnumf %a, %b : f32
  %maxnum = scalar.maxnumf %a, %b : f32
  %isnan = scalar.isnanf %a : f32
  %isinf = scalar.isinff %a : f32
  %isfinite = scalar.isfinitef %a : f32
  %ordered = scalar.clampf<ordered> %a, %b, %c : f32
  %number = scalar.clampf<number> %a, %b, %c : f32
  %ieee = scalar.clampf<ieee> %a, %b, %c : f32
  %fused = scalar.fmaf %a, %b, %c : f32
  func.return %minimum, %maximum, %minnum, %maxnum, %isnan, %isinf, %isfinite, %ordered, %number, %ieee, %fused : f32, f32, f32, f32, i1, i1, i1, f32, f32, f32, f32
}

// ----
low.func.def target<vm.core> abi(vm_function) @float_selected_f32(%a: reg<vm.value : f32>, %b: reg<vm.value : f32>, %c: reg<vm.value : f32>) -> (reg<vm.value : f32>, reg<vm.value : f32>, reg<vm.value : f32>, reg<vm.value : f32>, reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : f32>, reg<vm.value : f32>, reg<vm.value : f32>, reg<vm.value : f32>) asm {
  %minimum = float.minmax.f32 %a, %b, "minimum"
  %maximum = float.minmax.f32 %a, %b, "maximum"
  %minnum = float.minmax.f32 %a, %b, "minnum"
  %maxnum = float.minmax.f32 %a, %b, "maxnum"
  %isnan = float.classify.f32 %a, "isnan"
  %isinf = float.classify.f32 %a, "isinf"
  %isfinite = float.classify.f32 %a, "isfinite"
  %ordered = float.clamp.f32 %a, %b, %c, "ordered"
  %number = float.clamp.f32 %a, %b, %c, "number"
  %ieee = float.clamp.f32 %a, %b, %c, "ieee"
  %fused = float.fma.f32 %a, %b, %c
  return %minimum, %maximum, %minnum, %maxnum, %isnan, %isinf, %isfinite, %ordered, %number, %ieee, %fused
}

