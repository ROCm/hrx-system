  %bytes = constant.s16 1024 : reg<vm.value : offset>
  %scratch = buffer.allocate %bytes, 4 : reg<vm.ref : buffer>
  %shift = constant.s16 4 : reg<vm.value : index>
  %shifted = integer.shift.right.u64 %workitem_id_x, %shift : reg<vm.value : index>
  %mask = constant.s16 3 : reg<vm.value : index>
  %swizzle_bits = integer.and.i64 %shifted, %mask : reg<vm.value : index>
  %swizzled = integer.xor.i64 %workitem_id_x, %swizzle_bits : reg<vm.value : index>
  %60 = constant.zero : reg<vm.value : offset>
  %loaded = buffer.load %input, %60, %workitem_id_x, 16, i32.x4 : reg<vm.value x4 : vector<4xi32>>
  buffer.store %scratch, %60, %swizzled, %loaded, 16, i32.x4
  %roundtrip = buffer.load %scratch, %60, %swizzled, 16, i32.x4 : reg<vm.value x4 : vector<4xi32>>
  buffer.store %output, %60, %workitem_id_x, %roundtrip, 16, i32.x4
  return
}

