  %roundtrip = buffer.load %scratch, %50, %workitem_id_x, 16, i32.x4 : reg<vm.value x4 : vector<4xi32>>
  buffer.store %output, %50, %workitem_id_x, %roundtrip, 16, i32.x4
  return
}

