  %136 = integer.shift.right.u32 %135, %116
  %137 = integer.and.i32 %136, %118
  %138 = integer.and.i32 %135, %120
  %139 = integer.shift.left.i32 %137, %116
  %140 = integer.and.i32 %138, %123
  %141 = integer.or.i32 %140, %139
  %142 = constant.i64 12
  %143 = buffer.load %input_view, %142, %142, 0, "i32.x1" : reg<vm.value : i32>
  %144 = integer.shift.right.u32 %143, %116
  %145 = integer.and.i32 %144, %118
  %146 = integer.and.i32 %143, %120
