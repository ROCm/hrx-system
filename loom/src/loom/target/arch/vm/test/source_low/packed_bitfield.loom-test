  %28 = buffer.load %field_view, %27, %27, 0, "i32.x1" : reg<vm.value : i32>
  %30 = buffer.load %base_view, %27, %27, 0, "i32.x1" : reg<vm.value : i32>
  %31 = constant.i32 15
  %32 = integer.and.i32 %28, %31
  %33 = constant.i32 8
  %34 = integer.shift.left.i32 %32, %33
  %35 = constant.i32 4294963455
  %36 = integer.and.i32 %30, %35
  %37 = integer.or.i32 %36, %34
  buffer.store %output_view, %27, %27, %37, 0, "i32.x1"
