  %output_view = buffer.view %output[%buffer_base] : buffer -> view<1xi32>
  %field = vector.load %field_view[0] : view<1xi32> -> vector<1xi32>
  %base = vector.load %base_view[0] : view<1xi32> -> vector<1xi32>
  %inserted = vector.bitfield.insert %field into %base {offset = 8, width = 4} : vector<1xi32>, vector<1xi32>
  vector.store %inserted, %output_view[0] : vector<1xi32>, view<1xi32>
  func.return
