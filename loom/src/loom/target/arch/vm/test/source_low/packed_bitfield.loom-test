  %124 = integer.shift.right.u32 %123, %112
  %125 = integer.and.i32 %124, %114
  %126 = integer.and.i32 %123, %116
  %127 = integer.shift.left.i32 %125, %112
  %128 = integer.and.i32 %126, %119
  %129 = integer.or.i32 %128, %127
  %130 = constant.i64 8
  %131 = buffer.load %input_view, %130, %130, 0, 8 : reg<vm.value : i32>
  %132 = integer.shift.right.u32 %131, %112
  %133 = integer.and.i32 %132, %114
  %134 = integer.and.i32 %131, %116
  %135 = integer.shift.left.i32 %133, %112
  %136 = integer.and.i32 %134, %119
  %137 = integer.or.i32 %136, %135
  %138 = constant.i64 12
  %139 = buffer.load %input_view, %138, %138, 0, 8 : reg<vm.value : i32>
  %140 = integer.shift.right.u32 %139, %112
  %141 = integer.and.i32 %140, %114
  %142 = integer.and.i32 %139, %116
  %143 = integer.shift.left.i32 %141, %112
  %144 = integer.and.i32 %142, %119
  %145 = integer.or.i32 %144, %143
  %146 = constant.i32 4294967264
  %147 = integer.add.i32 %121, %146
  %148 = integer.add.i32 %129, %146
  %149 = integer.add.i32 %137, %146
  %150 = integer.add.i32 %145, %146
  buffer.store %output_view, %110, %110, %147, 0, 8
  buffer.store %output_view, %122, %122, %148, 0, 8
  buffer.store %output_view, %130, %130, %149, 0, 8
  buffer.store %output_view, %138, %138, %150, 0, 8
  return
}
