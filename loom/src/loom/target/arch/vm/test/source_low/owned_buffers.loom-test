// TEMPLATE: loom/src/loom/test/corpus/source_low/owned_buffers.loom-test
// RUN: emit source-low target=vm:core output=low

func.def @owned_bytes(%byte_count: i64, %byte_start: i64, %pattern: i32) -> (i32, i32, i32) {
  %count_input = scalar.assume %byte_count [range(%byte_count, 0, 9223372036854775807)] : i64
  %length = index.cast %count_input : i64 to offset
  %start_input = scalar.assume %byte_start [range(%byte_start, 0, 9223372036854775807)] : i64
  %start = index.cast %start_input : i64 to offset
  %base_offset = index.constant 0 : offset
  %extent = index.add %start, %length : offset
  %source = buffer.alloca<private> align(64) %extent : buffer
  %target = buffer.alloca<private> align(8) %extent : buffer
  %zero_pattern = scalar.constant 0 : i32
  buffer.fill %zero_pattern, %target[%base_offset], %extent : i32
  buffer.fill %pattern, %source[%start], %length : i32
  %before = buffer.compare %source[%start], %target[%base_offset], %length
  buffer.copy %source[%start], %target[%base_offset], %length
  %equal = buffer.compare %source[%start], %target[%base_offset], %length
  %increment = scalar.constant 1 : i32
  %other = scalar.addi %pattern, %increment : i32
  buffer.fill %other, %target[%base_offset], %length : i32
  %after = buffer.compare %source[%start], %target[%base_offset], %length
  func.return %before, %equal, %after : i32, i32, i32
}

// ----
low.func.def target<vm.core> abi(vm_function) @owned_bytes(%length: reg<vm.value : i64>, %start: reg<vm.value : i64>, %pattern: reg<vm.value : i32>) -> (reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>) asm {
  %base_offset = constant.i64 0
  %extent = integer.add.i64 %start, %length
  %source = buffer.allocate %extent, 6 : reg<vm.ref : buffer>
  %target = buffer.allocate %extent, 3 : reg<vm.ref : buffer>
  %zero_pattern = constant.i32 0
  buffer.fill %target, %base_offset, %extent, %zero_pattern, 4
  buffer.fill %source, %start, %length, %pattern, 4
  %before = buffer.compare %source, %start, %target, %base_offset, %length
  buffer.copy %target, %base_offset, %source, %start, %length
  %equal = buffer.compare %source, %start, %target, %base_offset, %length
  %increment = constant.i32 1
  %other = integer.add.i32 %pattern, %increment
  buffer.fill %target, %base_offset, %length, %other, 4
  %after = buffer.compare %source, %start, %target, %base_offset, %length
  return %before, %equal, %after
}

// ====

func.def @buffer_generations(%count: i32, %byte_count: i64) -> (i32) {
  %count_input = scalar.assume %byte_count [range(%byte_count, 0, 9223372036854775807)] : i64
  %length = index.cast %count_input : i64 to offset
  %base_offset = index.constant 0 : offset
  %first = buffer.alloca<private> align(8) %length : buffer
  %second = buffer.alloca<private> align(8) %length : buffer
  %a = scalar.constant 17 : i8
  %b = scalar.constant 18 : i8
  buffer.fill %a, %first[%base_offset], %length : i8
  buffer.fill %b, %second[%base_offset], %length : i8
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %remaining, %left, %right = scf.while(%before = %count : i32, %x = %first : buffer, %y = %second : buffer) -> (i32, buffer, buffer) {
    %condition = scalar.cmpi sgt, %before, %c0 : i32
    scf.condition %condition, %before, %x, %y : i1, i32, buffer, buffer
  } do(%current: i32, %x: buffer, %y: buffer) {
    %extra = index.cast %current : i32 to offset
    %extent = index.add %length, %extra : offset
    %replacement = buffer.alloca<private> align(8) %extent : buffer
    buffer.copy %x[%base_offset], %replacement[%base_offset], %length
    %next = scalar.subi %current, %c1 : i32
    scf.yield %next, %y, %replacement : i32, buffer, buffer
  }
  %order = buffer.compare %left[%base_offset], %right[%base_offset], %length
  func.return %order : i32
}

// ----
low.func.def target<vm.core> abi(vm_function) @buffer_generations(%count: reg<vm.value : i32>, %length: reg<vm.value : i64>) -> (reg<vm.value : i32>) asm {
  %base_offset = constant.i64 0
  %first = buffer.allocate %length, 3 : reg<vm.ref : buffer>
  %second = buffer.allocate %length, 3 : reg<vm.ref : buffer>
  %a = constant.i32 17 : reg<vm.value : i8>
  %b = constant.i32 18 : reg<vm.value : i8>
  buffer.fill %first, %base_offset, %length, %a, 1
  buffer.fill %second, %base_offset, %length, %b, 1
  %c0 = constant.i32 0
  low.br ^_bb1(%count: reg<vm.value : i32>, %first: reg<vm.ref : buffer>, %second: reg<vm.ref : buffer>)
^_bb1(%before: reg<vm.value : i32>, %x: reg<vm.ref : buffer>, %y: reg<vm.ref : buffer>):
  %condition = integer.compare.i32 %before, %c0, "sgt"
  low.cond_br %condition, ^_bb2, ^_bb3 : reg<vm.value : i1>
^_bb2:
  %extra = conversion.integer %before, "u32.to.i64"
  %extent = integer.add.i64 %length, %extra
  %replacement = buffer.allocate %extent, 3 : reg<vm.ref : buffer>
  buffer.copy %replacement, %base_offset, %x, %base_offset, %length
  %51 = constant.i32 4294967295
  %next = integer.add.i32 %before, %51
  low.br ^_bb1(%next: reg<vm.value : i32>, %y: reg<vm.ref : buffer>, %replacement: reg<vm.ref : buffer>)
^_bb3:
  %order = buffer.compare %x, %base_offset, %y, %base_offset, %length
  return %order
}

// ====

func.def @floating_patterns(%byte_count: i64, %half: bf16, %byte: f8E4M3, %wide: f64) -> (i32, i32, i32) {
  %count_input = scalar.assume %byte_count [range(%byte_count, 0, 9223372036854775807)] : i64
  %length = index.cast %count_input : i64 to offset
  %base_offset = index.constant 0 : offset
  %left = buffer.alloca<private> align(8) %length : buffer
  %right = buffer.alloca<private> align(8) %length : buffer
  %half_bits = scalar.bitcast %half : bf16 to i16
  buffer.fill %half, %left[%base_offset], %length : bf16
  buffer.fill %half_bits, %right[%base_offset], %length : i16
  %half_order = buffer.compare %left[%base_offset], %right[%base_offset], %length
  %byte_bits = scalar.bitcast %byte : f8E4M3 to i8
  buffer.fill %byte, %left[%base_offset], %length : f8E4M3
  buffer.fill %byte_bits, %right[%base_offset], %length : i8
  %byte_order = buffer.compare %left[%base_offset], %right[%base_offset], %length
  %wide_bits = scalar.bitcast %wide : f64 to i64
  buffer.fill %wide, %left[%base_offset], %length : f64
  buffer.fill %wide_bits, %right[%base_offset], %length : i64
  %wide_order = buffer.compare %left[%base_offset], %right[%base_offset], %length
  func.return %half_order, %byte_order, %wide_order : i32, i32, i32
}

// ----
low.func.def target<vm.core> abi(vm_function) @floating_patterns(%length: reg<vm.value : i64>, %half: reg<vm.value : bf16>, %byte: reg<vm.value : f8E4M3>, %wide: reg<vm.value : f64>) -> (reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>) asm {
  %base_offset = constant.i64 0
  %left = buffer.allocate %length, 3 : reg<vm.ref : buffer>
  %right = buffer.allocate %length, 3 : reg<vm.ref : buffer>
  %half_bits = value.copy %half : reg<vm.value : i16>
  buffer.fill %left, %base_offset, %length, %half, 2
  buffer.fill %right, %base_offset, %length, %half_bits, 2
  %half_order = buffer.compare %left, %base_offset, %right, %base_offset, %length
  %byte_bits = value.copy %byte : reg<vm.value : i8>
  buffer.fill %left, %base_offset, %length, %byte, 1
  buffer.fill %right, %base_offset, %length, %byte_bits, 1
  %byte_order = buffer.compare %left, %base_offset, %right, %base_offset, %length
  %wide_bits = value.copy %wide
  buffer.fill %left, %base_offset, %length, %wide, 8
  buffer.fill %right, %base_offset, %length, %wide_bits, 8
  %wide_order = buffer.compare %left, %base_offset, %right, %base_offset, %length
  return %half_order, %byte_order, %wide_order
}
