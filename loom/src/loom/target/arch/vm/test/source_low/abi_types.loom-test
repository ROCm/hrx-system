// RUN: emit source-low output=low

vm.target<core> @target

func.def target(@target) @typed_boundaries(%value: i32, %buffer: hal.buffer, %callback: func.ref<(i32) -> (i32)>) -> (hal.buffer, func.ref<(i32) -> (i32)>) {
  func.return %buffer, %callback : hal.buffer, func.ref<(i32) -> (i32)>
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value : i32>, reg<vm.ref : hal.buffer>, reg<vm.function : func.ref<(i32) -> (i32)>>) -> (reg<vm.ref : hal.buffer>, reg<vm.function : func.ref<(i32) -> (i32)>>)>}) @typed_boundaries(%value: reg<vm.value : i32>, %buffer: reg<vm.ref : hal.buffer>, %callback: reg<vm.function : func.ref<(i32) -> (i32)>>) -> (reg<vm.ref : hal.buffer>, reg<vm.function : func.ref<(i32) -> (i32)>>) asm {
  return %buffer, %callback
}
