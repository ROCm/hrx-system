func.def @reverse_view_bytes(%index_value: i64, %pattern: i32) -> (i32, i32) {
  %length = index.constant 16 : offset
  %origin = index.constant 0 : offset
  %last_word = index.constant 12 : offset
  %storage = buffer.alloca<private> align(4) %length : buffer
  %clear = scalar.constant 0 : i32
  buffer.fill %clear, %storage[%origin], %length : i32
  %index_input = index.cast %index_value : i64 to index
  %index = index.assume %index_input [range(%index_input, 0, 3)] : index
  %element_bytes = index.constant 4 : index
  %bytes = index.mul %index, %element_bytes : index
  %offset = index.cast %bytes : index to offset
  %address = index.sub %last_word, %offset : offset
  %selected = buffer.view %storage[%address] : buffer -> view<1xi32>
  view.store %pattern, %selected[0] : i32, view<1xi32>
  %loaded = view.load %selected[0] : view<1xi32> -> i32
  %byte = buffer.load.i8.u %storage[%address]
  func.return %loaded, %byte : i32, i32
}

// ----
low.func.def target<vm.core> abi(vm_function) @reverse_view_bytes(%index: reg<vm.value : i64>, %pattern: reg<vm.value : i32>) -> (reg<vm.value : i32>, reg<vm.value : i32>) asm {
  %length = constant.i64 16
  %origin = constant.i64 0
  %last_word = constant.i64 12
  %selected = buffer.allocate %length, 2 : reg<vm.ref : buffer>
  %clear = constant.i32 0
  buffer.fill %selected, %origin, %length, %clear, 4
  %29 = constant.i64 2
  %offset = integer.shift.left.i64 %index, %29
  %address = integer.sub.i64 %last_word, %offset
  %33 = constant.i64 -4 : reg<vm.value>
  %34 = integer.mul.i64 %index, %33
  %35 = integer.add.i64 %34, %last_word
  buffer.store %selected, %35, %35, %pattern, 0, "i32.x1"
  %loaded = buffer.load %selected, %35, %35, 0, "i32.x1" : reg<vm.value : i32>
  %byte = buffer.load %selected, %address, %address, 0, "i8.x1" : reg<vm.value : i32>
  return %loaded, %byte
}

