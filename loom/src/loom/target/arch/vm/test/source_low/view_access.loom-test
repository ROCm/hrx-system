func.def @view_tail_sum(%column_count: i64, %pattern: i32) -> (i32, i32) {
  %column_input = index.cast %column_count : i64 to index
  %columns = index.assume %column_input [range(%column_input, 1, 4)] : index
  %length = index.constant 64 : offset
  %origin = index.constant 0 : offset
  %base = index.constant 4 : offset
  %storage = buffer.alloca<private> align(4) %length : buffer
  %clear = scalar.constant 0 : i32
  buffer.fill %clear, %storage[%origin], %length : i32
  %matrix = buffer.view %storage[%base] : buffer -> view<2x[%columns]xi32>
  %tail = view.subview %matrix[1, 0] : view<2x[%columns]xi32> -> view<1x[%columns]xi32>
  %selected = view.refine %tail : view<1x[%columns]xi32> -> view<1x[%columns]xi32>
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  scf.for %column = [%begin to %columns step %step] {
    %ordinal = index.cast %column : index to i32
    %value = scalar.addi %pattern, %ordinal : i32
    view.store %value, %selected[0, %column] : i32, view<1x[%columns]xi32>
  }
  %sum = scf.for %column = [%begin to %columns step %step](%partial = %clear : i32) -> (i32) {
    %value = view.load %matrix[1, %column] : view<2x[%columns]xi32> -> i32
    %next = scalar.addi %partial, %value : i32
    scf.yield %next : i32
  }
  %element_bytes = index.constant 4 : index
  %row_bytes = index.mul %columns, %element_bytes : index
  %row_offset = index.cast %row_bytes : index to offset
  %address = index.add %base, %row_offset : offset
  %byte = buffer.load.i8.u %storage[%address]
  func.return %sum, %byte : i32, i32
}

// ----
low.func.def target<vm.core> abi(vm_function) @view_tail_sum(%columns: reg<vm.value : i64>, %pattern: reg<vm.value : i32>) -> (reg<vm.value : i32>, reg<vm.value : i32>) asm {
  %length = constant.i64 64
  %origin = constant.i64 0
  %base = constant.i64 4
  %selected = buffer.allocate %length, 2 : reg<vm.ref : buffer>
  %clear = constant.i32 0
  buffer.fill %selected, %origin, %length, %clear, 4
  %step = constant.i64 1
  low.br ^_bb1(%origin: reg<vm.value : i64>)
^_bb1(%column$45: reg<vm.value : i64>):
  %55 = integer.compare.i64 %column$45, %columns, "slt"
  low.cond_br %55, ^_bb2, ^_bb3 : reg<vm.value : i1>
^_bb2:
  %ordinal = conversion.integer %column$45, "i64.to.i32" : reg<vm.value : i32>
  %value$57 = integer.add.i32 %pattern, %ordinal
  %59 = constant.i64 2 : reg<vm.value>
  %60 = integer.shift.left.i64 %columns, %59
  %62 = integer.shift.left.i64 %column$45, %59
  %63 = integer.add.i64 %60, %62
  %64 = integer.add.i64 %63, %base
  buffer.store %selected, %64, %64, %value$57, 0, "i32.x1"
  %65 = integer.add.i64 %column$45, %step
  low.br ^_bb1(%65: reg<vm.value : i64>)
^_bb3:
  low.br ^_bb4(%origin: reg<vm.value : i64>, %clear: reg<vm.value : i32>)
^_bb4(%column$46: reg<vm.value : i64>, %partial: reg<vm.value : i32>):
  %66 = integer.compare.i64 %column$46, %columns, "slt"
  low.cond_br %66, ^_bb5, ^_bb6 : reg<vm.value : i1>
^_bb5:
  %68 = constant.i64 2 : reg<vm.value>
  %69 = integer.shift.left.i64 %columns, %68
  %71 = integer.shift.left.i64 %column$46, %68
  %72 = integer.add.i64 %69, %71
  %73 = integer.add.i64 %72, %base
  %value$74 = buffer.load %selected, %73, %73, 0, "i32.x1" : reg<vm.value : i32>
  %next = integer.add.i32 %partial, %value$74
  %76 = integer.add.i64 %column$46, %step
  low.br ^_bb4(%76: reg<vm.value : i64>, %next: reg<vm.value : i32>)
^_bb6:
  %77 = constant.i64 2
  %row_offset = integer.shift.left.i64 %columns, %77
  %address = integer.add.i64 %base, %row_offset
  %byte = buffer.load %selected, %address, %address, 0, "i8.x1" : reg<vm.value : i32>
  return %partial, %byte
}
