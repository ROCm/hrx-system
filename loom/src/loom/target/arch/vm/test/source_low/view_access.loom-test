low.func.def target<vm.core> abi(vm_function) @view_payloads(%input_i8: reg<vm.value : i8>, %input_i16: reg<vm.value : i16>, %input_i32: reg<vm.value : i32>, %input_i64: reg<vm.value : i64>, %input_f8E4M3: reg<vm.value : f8E4M3>, %input_f8E5M2: reg<vm.value : f8E5M2>, %input_f16: reg<vm.value : f16>, %input_bf16: reg<vm.value : bf16>, %input_f32: reg<vm.value : f32>, %input_f64: reg<vm.value : f64>) -> (reg<vm.value : i8>, reg<vm.value : i16>, reg<vm.value : i32>, reg<vm.value : i64>, reg<vm.value : f8E4M3>, reg<vm.value : f8E5M2>, reg<vm.value : f16>, reg<vm.value : bf16>, reg<vm.value : f32>, reg<vm.value : f64>) asm {
  %length = constant.i64 64
  %view_f64 = buffer.allocate %length, 3 : reg<vm.ref : buffer>
  %65 = constant.i64 0
  buffer.store %view_f64, %65, %65, %input_i8, 0, "i8.x1"
  %66 = constant.i64 2
  buffer.store %view_f64, %66, %66, %input_i16, 0, "i16.x1"
  %67 = constant.i64 4
  buffer.store %view_f64, %67, %67, %input_i32, 0, "i32.x1"
  %68 = constant.i64 8
  buffer.store %view_f64, %68, %68, %input_i64, 0, "i64.x1"
  %69 = constant.i64 16
  buffer.store %view_f64, %69, %69, %input_f8E4M3, 0, "i8.x1"
  %70 = constant.i64 17
  buffer.store %view_f64, %70, %70, %input_f8E5M2, 0, "i8.x1"
  %71 = constant.i64 18
  buffer.store %view_f64, %71, %71, %input_f16, 0, "i16.x1"
  %72 = constant.i64 20
  buffer.store %view_f64, %72, %72, %input_bf16, 0, "i16.x1"
  %73 = constant.i64 24
  buffer.store %view_f64, %73, %73, %input_f32, 0, "i32.x1"
  %74 = constant.i64 32
  buffer.store %view_f64, %74, %74, %input_f64, 0, "i64.x1"
  %loaded_i8 = buffer.load %view_f64, %65, %65, 0, "i8.x1" : reg<vm.value : i8>
  %loaded_i16 = buffer.load %view_f64, %66, %66, 0, "i16.x1" : reg<vm.value : i16>
  %loaded_i32 = buffer.load %view_f64, %67, %67, 0, "i32.x1" : reg<vm.value : i32>
  %loaded_i64 = buffer.load %view_f64, %68, %68, 0, "i64.x1"
  %loaded_f8E4M3 = buffer.load %view_f64, %69, %69, 0, "i8.x1" : reg<vm.value : f8E4M3>
  %loaded_f8E5M2 = buffer.load %view_f64, %70, %70, 0, "i8.x1" : reg<vm.value : f8E5M2>
  %loaded_f16 = buffer.load %view_f64, %71, %71, 0, "i16.x1" : reg<vm.value : f16>
  %loaded_bf16 = buffer.load %view_f64, %72, %72, 0, "i16.x1" : reg<vm.value : bf16>
  %loaded_f32 = buffer.load %view_f64, %73, %73, 0, "i32.x1" : reg<vm.value : f32>
  %loaded_f64 = buffer.load %view_f64, %74, %74, 0, "i64.x1" : reg<vm.value : f64>
  return %loaded_i8, %loaded_i16, %loaded_i32, %loaded_i64, %loaded_f8E4M3, %loaded_f8E5M2, %loaded_f16, %loaded_bf16, %loaded_f32, %loaded_f64
}

