low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = (reg<vm.value : index>, reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>) -> (reg<vm.value : i32>)}) @sparse_scalar_switch(%selector: reg<vm.value : index>, %case0: reg<vm.value : i32>, %case8: reg<vm.value : i32>, %fallback: reg<vm.value : i32>) -> (reg<vm.value : i32>) asm {
  low.cond_br %selector, ^_bb1, ^case0 : reg<vm.value : index>
^_bb1:
  %10 = constant.s16 8 : reg<vm.value : index>
  %11 = integer.sub.i64 %selector, %10 : reg<vm.value : index>
  low.cond_br %11, ^default, ^case8 : reg<vm.value : index>
^case0:
