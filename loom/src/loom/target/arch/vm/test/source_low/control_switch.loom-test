vm.target<core> @target

func.def target(@target) @direct_negative_switch(%selector: index, %negative2: i32, %negative1: i32, %zero: i32, %fallback: i32) -> (i32) {
  cfg.switch %selector cases [-2, -1, 0] -> [^negative2, ^negative1, ^zero] default ^default
^negative2:
  func.return %negative2 : i32
^negative1:
  func.return %negative1 : i32
^zero:
  func.return %zero : i32
^default:
  func.return %fallback : i32
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = (reg<vm.value : index>, reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>) -> (reg<vm.value : i32>)}) @direct_negative_switch(%selector: reg<vm.value : index>, %negative2: reg<vm.value : i32>, %negative1: reg<vm.value : i32>, %zero: reg<vm.value : i32>, %fallback: reg<vm.value : i32>) -> (reg<vm.value : i32>) asm {
  %12 = constant.s16 -2 : reg<vm.value : index>
  %13 = integer.sub.i64 %selector, %12 : reg<vm.value : index>
  control.switch %13 targets [^negative2, ^negative1, ^zero] default ^default
^negative2:
  return %negative2
^negative1:
  return %negative1
^zero:
  return %zero
^default:
  return %fallback
}

