// RUN: emit source-low output=low

vm.target<core> @target

func.def target(@target) @direct_dense_switch(%selector: index, %case0: i32, %case1: i32, %fallback: i32) -> (i32) {
  cfg.switch %selector cases [0, 1] -> [^case0, ^case1] default ^default
^case0:
  func.return %case0 : i32
^case1:
  func.return %case1 : i32
^default:
  func.return %fallback : i32
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = (reg<vm.value : index>, reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>) -> (reg<vm.value : i32>)}) @direct_dense_switch(%selector: reg<vm.value : index>, %case0: reg<vm.value : i32>, %case1: reg<vm.value : i32>, %fallback: reg<vm.value : i32>) -> (reg<vm.value : i32>) asm {
  control.switch %selector targets [^case0, ^case1] default ^default
^case0:
  return %case0
^case1:
  return %case1
^default:
  return %fallback
}

