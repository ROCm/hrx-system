// TEMPLATE: loom/src/loom/test/corpus/source_low/buffer_calls.loom-test
// RUN: emit vm-dis target=vm:core

func.def @buffer_pair(%a: buffer, %tag: i64, %b: buffer) -> (buffer, i64, buffer) {
  func.return %b, %tag, %a : buffer, i64, buffer
}

// ----
vm.module core(0.0) {
  section strings alignment(8) {
    string @string0 = "vm"
    string @string1 = "buffer"
  }

  section ref_types alignment(8) {
    namespace @ref_group0 name(@string0) {
      ref_type @ref_type0 name(@string1)
    }
  }

  section signatures alignment(8) {
    signature @signature0 (ref(@ref_type0), i64, ref(@ref_type0)) -> (ref(@ref_type0), i64, ref(@ref_type0))
  }

  section callable_types alignment(8) {
    callable @callable0 flags([]) depth(0) : @signature0
  }

  section functions alignment(8) {
    func @function0 : @callable0 flags([]) frame(local_bytes = 0, value_registers = 1, ref_registers = 3, function_registers = 0, local_refs = 0, local_functions = 0) {
    ^bb0:
      control.block
      %r2 = ref.retain %r0
      %r0 = ref.retain %r1
      %r1 = ref.retain %r2
      control.return
    }
  }

}

