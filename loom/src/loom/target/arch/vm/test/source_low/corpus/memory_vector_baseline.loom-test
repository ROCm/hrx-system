vm.target<core> @target
func.def target(@target) @vector_load_store_i32x4_dynamic(%input: buffer, %output: buffer, %element: index) -> (vector<4xi32>) {
  %base = index.constant 0 : offset
  %element_bounded = index.assume %element [range(%element, 0, 12)] : index
  %input_view = buffer.view %input[%base] : buffer -> view<16xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<16xi32>
  %loaded = vector.load %input_view[%element_bounded] : view<16xi32> -> vector<4xi32>
  vector.store %loaded, %output_view[%element_bounded] : vector<4xi32>, view<16xi32>
  func.return %loaded : vector<4xi32>
}

