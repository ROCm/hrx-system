  %13 = constant.zero : reg<vm.value : offset>
  %loaded = buffer.load %input, %13, %element_bounded, 4, i32.x4 : reg<vm.value x4 : vector<4xi32>>
  buffer.store %output, %13, %element_bounded, %loaded, 4, i32.x4
  return %loaded
}

