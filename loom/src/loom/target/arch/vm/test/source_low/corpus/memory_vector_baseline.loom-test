vm.target<core> @target
func.def target(@target) @vector_load_store_i8x1(%input: buffer, %output: buffer) -> (vector<1xi8>) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<1xi8>
  %output_view = buffer.view %output[%base] : buffer -> view<1xi8>
  %loaded = vector.load %input_view[0] : view<1xi8> -> vector<1xi8>
  vector.store %loaded, %output_view[0] : vector<1xi8>, view<1xi8>
  func.return %loaded : vector<1xi8>
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.ref : buffer>, reg<vm.ref : buffer>) -> (reg<vm.value : vector<1xi8>>)>}) @vector_load_store_i8x1(%input: reg<vm.ref : buffer>, %output: reg<vm.ref : buffer>) -> (reg<vm.value : vector<1xi8>>) asm {
  %10 = constant.zero : reg<vm.value : offset>
  %loaded = buffer.load %input, %10, %10, 0, i8.x1 : reg<vm.value : vector<1xi8>>
  buffer.store %output, %10, %10, %loaded, 0, i8.x1
  return %loaded
}

