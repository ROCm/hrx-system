vm.target<core> @target
func.def target(@target) @vector_load_store_f32x12(%input: buffer, %output: buffer, %value: vector<12xf32>) -> (vector<12xf32>) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<12xf32>
  %output_view = buffer.view %output[%base] : buffer -> view<12xf32>
  %loaded = vector.load %input_view[0] : view<12xf32> -> vector<12xf32>
  vector.store %value, %output_view[0] : vector<12xf32>, view<12xf32>
  func.return %loaded : vector<12xf32>
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.ref : buffer>, reg<vm.ref : buffer>, reg<vm.value x12 : vector<12xf32>>) -> (reg<vm.value x12 : vector<12xf32>>)>}) @vector_load_store_f32x12(%input: reg<vm.ref : buffer>, %output: reg<vm.ref : buffer>, %value: reg<vm.value x12 : vector<12xf32>>) -> (reg<vm.value x12 : vector<12xf32>>) asm {
  %12 = constant.zero : reg<vm.value : offset>
  %13 = buffer.load %input, %12, %12, 0, i32.x8 : reg<vm.value x8 : vector<8xf32>>
  %14 = constant.s16 32 : reg<vm.value : offset>
  %15 = buffer.load %input, %14, %12, 0, i32.x4 : reg<vm.value x4 : vector<4xf32>>
  %loaded = concat(%13, %15) : (reg<vm.value x8 : vector<8xf32>>, reg<vm.value x4 : vector<4xf32>>) -> reg<vm.value x12 : vector<12xf32>>
  %18 = slice %value[0] : reg<vm.value x12 : vector<12xf32>> -> reg<vm.value x8 : vector<8xf32>>
  buffer.store %output, %12, %12, %18, 0, i32.x8
  %20 = slice %value[8] : reg<vm.value x12 : vector<12xf32>> -> reg<vm.value x4 : vector<4xf32>>
  buffer.store %output, %14, %12, %20, 0, i32.x4
  return %loaded
}
