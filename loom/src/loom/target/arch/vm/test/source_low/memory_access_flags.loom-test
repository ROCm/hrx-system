// RUN: emit source-low target=vm:core output=low

func.def @observe_unused(%input: buffer) {
  %base = index.constant 0 : offset
  %aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %source = buffer.view %aligned[%base] : buffer -> view<2xi32>
  %first = view.load<volatile> %source[0] : view<2xi32> -> i32
  %second = view.load<volatile> %source[1] : view<2xi32> -> i32
  func.return
}

// ----
low.func.def target<vm.core> abi(vm_function) @observe_unused(%source: reg<vm.ref : buffer>) asm {
  %7 = constant.i64 0
  %first = buffer.load<volatile> %source, %7, %7, 0, "i32.x1" : reg<vm.value : i32>
  %9 = constant.i64 4
  %second = buffer.load<volatile> %source, %9, %9, 0, "i32.x1" : reg<vm.value : i32>
  return
}

// ====

func.def @observe_vector(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source_aligned = buffer.assume.alignment %input {minimum_alignment = 64} : buffer
  %destination_aligned = buffer.assume.alignment %output {minimum_alignment = 64} : buffer
  %source = buffer.view %source_aligned[%base] : buffer -> view<16xi32>
  %destination = buffer.view %destination_aligned[%base] : buffer -> view<32xi32>
  %first = vector.load<volatile> %source[0] : view<16xi32> -> vector<16xi32>
  %second = vector.load<volatile> %source[0] : view<16xi32> -> vector<16xi32>
  vector.store<volatile> %first, %destination[0] : vector<16xi32>, view<32xi32>
  vector.store<volatile> %second, %destination[16] : vector<16xi32>, view<32xi32>
  func.return
}

