// RUN: emit source-low target=vm:core output=low

func.def @observe_unused(%input: buffer) {
  %base = index.constant 0 : offset
  %aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %source = buffer.view %aligned[%base] : buffer -> view<2xi32>
  %first = view.load<volatile> %source[0] : view<2xi32> -> i32
  %second = view.load<volatile> %source[1] : view<2xi32> -> i32
  func.return
}

// ----
low.func.def target<vm.core> abi(vm_function) @observe_unused(%source: reg<vm.ref : buffer>) asm {
  %7 = constant.i64 0
  %first = buffer.load<volatile> %source, %7, %7, 0, "i32.x1" : reg<vm.value : i32>
  %9 = constant.i64 4
  %second = buffer.load<volatile> %source, %9, %9, 0, "i32.x1" : reg<vm.value : i32>
  return
}

// ====

func.def @observe_vector(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source_aligned = buffer.assume.alignment %input {minimum_alignment = 64} : buffer
  %destination_aligned = buffer.assume.alignment %output {minimum_alignment = 64} : buffer
  %source = buffer.view %source_aligned[%base] : buffer -> view<3xi32>
  %destination = buffer.view %destination_aligned[%base] : buffer -> view<6xi32>
  %first = vector.load<volatile> %source[0] : view<3xi32> -> vector<3xi32>
  %second = vector.load<volatile> %source[0] : view<3xi32> -> vector<3xi32>
  vector.store<volatile> %first, %destination[0] : vector<3xi32>, view<6xi32>
  vector.store<volatile> %second, %destination[3] : vector<3xi32>, view<6xi32>
  func.return
}

// ----
low.func.def target<vm.core> abi(vm_function) @observe_vector(%source: reg<vm.ref : buffer>, %destination: reg<vm.ref : buffer>) asm {
  %25 = constant.i64 0
  %26 = buffer.load<volatile> %source, %25, %25, 0, "i32.x1" : reg<vm.value : i32>
  %27 = constant.i64 4
  %28 = buffer.load<volatile> %source, %27, %27, 0, "i32.x1" : reg<vm.value : i32>
  %29 = constant.i64 8
  %30 = buffer.load<volatile> %source, %29, %29, 0, "i32.x1" : reg<vm.value : i32>
  %32 = buffer.load<volatile> %source, %25, %25, 0, "i32.x1" : reg<vm.value : i32>
  %34 = buffer.load<volatile> %source, %27, %27, 0, "i32.x1" : reg<vm.value : i32>
  %36 = buffer.load<volatile> %source, %29, %29, 0, "i32.x1" : reg<vm.value : i32>
  buffer.store<volatile> %destination, %25, %25, %26, 0, "i32.x1"
  buffer.store<volatile> %destination, %27, %27, %28, 0, "i32.x1"
  buffer.store<volatile> %destination, %29, %29, %30, 0, "i32.x1"
  %40 = constant.i64 12
  buffer.store<volatile> %destination, %40, %40, %32, 0, "i32.x1"
  %41 = constant.i64 16
  buffer.store<volatile> %destination, %41, %41, %34, 0, "i32.x1"
  %42 = constant.i64 20
  buffer.store<volatile> %destination, %42, %42, %36, 0, "i32.x1"
  return
}

// ====

func.def @observe_byte(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<1xi8>
  %destination = buffer.view %output[%base] : buffer -> view<2xi8>
  %first = view.load<volatile> %source[0] : view<1xi8> -> i8
  %second = view.load<volatile> %source[0] : view<1xi8> -> i8
  view.store<volatile> %first, %destination[0] : i8, view<2xi8>
  view.store<volatile> %second, %destination[1] : i8, view<2xi8>
  func.return
}

// ----
low.func.def target<vm.core> abi(vm_function) @observe_byte(%source: reg<vm.ref : buffer>, %destination: reg<vm.ref : buffer>) asm {
  %9 = constant.i64 0
  %first = buffer.load<volatile> %source, %9, %9, 0, "i8.x1" : reg<vm.value : i8>
  %second = buffer.load<volatile> %source, %9, %9, 0, "i8.x1" : reg<vm.value : i8>
  buffer.store<volatile> %destination, %9, %9, %first, 0, "i8.x1"
  %14 = constant.i64 1
  buffer.store<volatile> %destination, %14, %14, %second, 0, "i8.x1"
  return
}

// ====

func.def @observe_dynamic_address(%input: buffer, %byte_offset: offset) -> (i32, i32) {
  %base = index.assume %byte_offset [range(%byte_offset, 0, 4092), multiple_of(%byte_offset, 4)] : offset
  %aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %source = buffer.view %aligned[%base] : buffer -> view<2xi32>
  %first = view.load<volatile> %source[0] : view<2xi32> -> i32
  %second = view.load<volatile> %source[1] : view<2xi32> -> i32
  func.return %first, %second : i32, i32
}

// ----
low.func.def target<vm.core> abi(vm_function) @observe_dynamic_address(%source: reg<vm.ref : buffer>, %base: reg<vm.value : i64>) -> (reg<vm.value : i32>, reg<vm.value : i32>) asm {
  %first = buffer.load<volatile> %source, %base, %base, 0, "i32.x1" : reg<vm.value : i32>
  %14 = constant.i64 4
  %15 = integer.add.i64 %base, %14
  %second = buffer.load<volatile> %source, %15, %15, 0, "i32.x1" : reg<vm.value : i32>
  return %first, %second
}
