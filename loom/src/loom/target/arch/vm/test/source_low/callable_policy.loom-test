// RUN: with-checks emit source-low target=vm:core output=low

func.def retain pure noinline @private_entry(%value: i32) -> (i32) {
  func.return %value : i32
}

// ----
CHECK: low.func.def retain pure noinline target<vm.core>* @private_entry*
CHECK: *return %value

// ====

// RUN: with-checks emit source-low target=vm:core output=low

func.def pure noinline @helper(%value: i32) -> (i32) {
  %result = scalar.addi %value, %value : i32
  func.return %result : i32
}

func.def public @unbound_entry(%value: i32) -> (i32) {
  %result = func.call @helper(%value) : (i32) -> (i32)
  func.return %result : i32
}

// ----
CHECK: low.func.def pure noinline target<vm.core>* @helper*
CHECK: low.func.def public target<vm.core>* @unbound_entry*
CHECK: *low.func.call* @helper*

