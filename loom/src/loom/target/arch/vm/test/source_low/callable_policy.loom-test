// RUN: emit source-low output=low

// A direct-call target retains semantic calls, including noinline policy.
vm.target<core> @target

func.def target(@target) @callee(%value: i32, %delta: i32) -> (i32) {
  %result = scalar.addi %value, %delta : i32
  func.return %result : i32
}

func.def public target(@target) @caller(%value: i32, %delta: i32) -> (i32, i32) {
  %ordinary = func.call @callee(%value, %delta) : (i32, i32) -> (i32)
  %explicit = func.call noinline @callee(%ordinary, %delta) : (i32, i32) -> (i32)
  func.return %ordinary, %explicit : i32, i32
}

// ----
low.func.def target<vm.core>(@target) @callee(%value: reg<vm.value : i32>, %delta: reg<vm.value : i32>) -> (reg<vm.value : i32>) asm {
  %result = integer.add.i32 %value, %delta
  return %result
}

low.func.def public target<vm.core>(@target) abi(vm_function) @caller(%value: reg<vm.value : i32>, %delta: reg<vm.value : i32>) -> (reg<vm.value : i32>, reg<vm.value : i32>) asm {
  %ordinary = low.func.call pure @callee(%value, %delta) : (reg<vm.value : i32>, reg<vm.value : i32>) -> (reg<vm.value : i32>)
  %explicit = low.func.call pure noinline @callee(%ordinary, %delta) : (reg<vm.value : i32>, reg<vm.value : i32>) -> (reg<vm.value : i32>)
  return %ordinary, %explicit
}

// ====

// RUN: with-checks emit source-low target=vm:core output=low

vm.target<core> @authored

func.def noinline target(@authored) @callee(%value: i32) -> (i32) {
  func.return %value : i32
}

func.def public @caller(%value: i32) -> (i32) {
  %result = func.call @callee(%value) : (i32) -> (i32)
  func.return %result : i32
}

// ----
CHECK: low.func.def noinline target<vm.core>* @callee*
CHECK: low.func.def public target<vm.core>* @caller*
CHECK: *low.func.call* @callee*

// ====

