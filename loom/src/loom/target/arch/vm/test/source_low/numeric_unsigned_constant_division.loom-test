// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_unsigned_constant_division.loom-test
// RUN: emit source-low target=vm:core output=low

func.def @quotient_by_three(%input: i32) -> (i32) {
  %divisor = scalar.constant 3 : i32
  %quotient = scalar.divui %input, %divisor : i32
  func.return %quotient : i32
}

// ----
low.func.def target<vm.core> abi(vm_function) @quotient_by_three(%input: reg<vm.value : i32>) -> (reg<vm.value : i32>) asm {
  %divisor = constant.i32 3
  %quotient = integer.div.u32 %input, %divisor
  return %quotient
}

