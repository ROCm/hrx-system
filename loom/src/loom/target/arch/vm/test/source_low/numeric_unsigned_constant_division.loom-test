func.def @index_pair_by_7(%input: index) -> (index, index) {
  %bounded = index.assume %input [range(%input, 0, 4294967295)] : index
  %divisor = index.constant 7 : index
  %quotient = index.div %bounded, %divisor : index
  %remainder = index.rem %bounded, %divisor : index
  func.return %quotient, %remainder : index, index
}

// ----
low.func.def target<vm.core> abi(vm_function) @index_pair_by_7(%bounded: reg<vm.value : i64>) -> (reg<vm.value : i64>, reg<vm.value : i64>) asm {
  %divisor = constant.i64 7
  %quotient = integer.div.u64 %bounded, %divisor
  %remainder = integer.rem.u64 %bounded, %divisor
  return %quotient, %remainder
}

// ====

