func.def @pair_by_power_of_two(%input: i32) -> (i32, i32) {
  %divisor = scalar.constant 16 : i32
  %quotient = scalar.divui %input, %divisor : i32
  %remainder = scalar.remui %input, %divisor : i32
  func.return %quotient, %remainder : i32, i32
}

// ----
low.func.def target<vm.core> abi(vm_function) @pair_by_power_of_two(%input: reg<vm.value : i32>) -> (reg<vm.value : i32>, reg<vm.value : i32>) asm {
  %13 = constant.i32 4
  %quotient = integer.shift.right.u32 %input, %13
  %15 = constant.i32 15
  %remainder = integer.and.i32 %input, %15
  return %quotient, %remainder
}

