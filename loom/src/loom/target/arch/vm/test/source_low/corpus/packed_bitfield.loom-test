low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.ref : buffer>, reg<vm.ref : buffer>) -> ()>}) @i32_bitfield_extractu(%input: reg<vm.ref : buffer>, %output: reg<vm.ref : buffer>) asm {
  %16 = constant.zero : reg<vm.value : offset>
  %17 = buffer.load %input, %16, %16, 0, i32.x1 : reg<vm.value : i32>
  %18 = constant.s16 4 : reg<vm.value : i32>
  %19 = integer.shift.right.u32 %17, %18 : reg<vm.value : i32>
  %20 = constant.s16 15 : reg<vm.value : i32>
  %21 = integer.and.i32 %19, %20 : reg<vm.value : i32>
  %nibble = concat(%21) : (reg<vm.value : i32>) -> reg<vm.value : vector<1xi32>>
  buffer.store %output, %16, %16, %nibble, 0, i32.x1
  return
}

