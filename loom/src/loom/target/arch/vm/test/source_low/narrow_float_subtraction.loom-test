func.def @subtract_f16_1(%lhs: f16, %rhs: f16) -> (f16) {
  %difference = scalar.subf %lhs, %rhs : f16
  func.return %difference : f16
}

// ----
low.func.def target<vm.core> abi(vm_function) @subtract_f16_1(%lhs: reg<vm.value : f16>, %rhs: reg<vm.value : f16>) -> (reg<vm.value : f16>) asm {
  %11 = conversion.float.extend %lhs, "f16.to.f32" : reg<vm.value : f32>
  %12 = conversion.float.extend %rhs, "f16.to.f32" : reg<vm.value : f32>
  %13 = float.sub.f32 %11, %12
  %difference = conversion.float.truncate %13, "f32.to.f16" : reg<vm.value : f16>
  return %difference
}

