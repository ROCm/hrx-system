  %17 = slice %input[0] : reg<vm.value x2 : vector<2xi32>> -> reg<vm.value : i32>
  %18 = conversion.integer.to.float %17, s32.to.f32 : reg<vm.value : f32>
  %19 = slice %scale[0] : reg<vm.value x2 : vector<2xf32>> -> reg<vm.value : f32>
  %20 = float.mul.f32 %18, %19 : reg<vm.value : f32>
  %21 = slice %input[1] : reg<vm.value x2 : vector<2xi32>> -> reg<vm.value : i32>
  %22 = conversion.integer.to.float %21, s32.to.f32 : reg<vm.value : f32>
  %23 = slice %scale[1] : reg<vm.value x2 : vector<2xf32>> -> reg<vm.value : f32>
  %24 = float.mul.f32 %22, %23 : reg<vm.value : f32>
  %scaled = concat(%20, %24) : (reg<vm.value : f32>, reg<vm.value : f32>) -> reg<vm.value x2 : vector<2xf32>>
  return %scaled
}

