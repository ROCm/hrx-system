low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.ref : buffer>, reg<vm.value : i32>) -> ()>}) @scalar_extui_i32_store(%output: reg<vm.ref : buffer>, %input: reg<vm.value : i32>) asm {
  %converted = conversion.integer %input, u32.to.i64 : reg<vm.value : i64>
  %8 = constant.zero : reg<vm.value : offset>
  buffer.store %output, %8, %8, %converted, 0, i64.x1
  return
}

// ====

vm.target<core> @target
func.def target(@target) @scalar_extui_i32_store_mask(%output: buffer, %input: i32) {
  %base = index.constant 0 : offset
  %output_view = buffer.view %output[%base] : buffer -> view<1xi64>
  %true = scalar.constant true : i1
  %mask = vector.splat %true : vector<1xi1>
  %converted = scalar.extui %input : i32 to i64
  %value = vector.splat %converted : vector<1xi64>
  vector.store.mask %value, %output_view[0], %mask : vector<1xi64>, view<1xi64>, vector<1xi1>
  func.return
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.ref : buffer>, reg<vm.value : i32>) -> ()>}) @scalar_extui_i32_store_mask(%output: reg<vm.ref : buffer>, %input: reg<vm.value : i32>) asm {
  %converted = conversion.integer %input, u32.to.i64 : reg<vm.value : i64>
  %value = concat(%converted) : (reg<vm.value : i64>) -> reg<vm.value : vector<1xi64>>
  %12 = constant.zero : reg<vm.value : offset>
  buffer.store %output, %12, %12, %value, 0, i64.x1
  return
}
