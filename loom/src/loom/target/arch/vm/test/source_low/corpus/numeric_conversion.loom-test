vm.target<core> @target
func.def target(@target) @vector_decode_splat_f8_scale(%input: buffer, %base: offset, %scale: vector<1xf32>) -> (vector<2xf32>) {
  %layout = encoding.layout.dense : encoding<layout>
  %input_view = buffer.view %input[%base] : buffer -> view<1xf8E4M3, %layout>
  %raw = view.load %input_view[0] : view<1xf8E4M3, %layout> -> f8E4M3
  %payload = vector.splat %raw : vector<2xf8E4M3>
  %schema = encoding.define #encoding.f8e4m3<affine=scale_only, payload_elements=2, scale_format=f32, scale_group_elements=2, scale_operands=1, scale_topology=block_1d> : encoding<schema>
  %decoded = vector.decode %payload using %schema {scale = %scale : vector<1xf32>} : vector<2xf8E4M3>, encoding<schema> -> vector<2xf32>
  func.return %decoded : vector<2xf32>
}

