// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_integer_order_bits.loom-test
// RUN: emit source-low target=vm:core output=low

func.def @integer_order_bits_i32(%lhs: i32, %rhs: i32, %count: i32) -> (i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32) {
  %signed_min = scalar.minsi %lhs, %rhs : i32
  %unsigned_min = scalar.minui %lhs, %rhs : i32
  %signed_max = scalar.maxsi %lhs, %rhs : i32
  %unsigned_max = scalar.maxui %lhs, %rhs : i32
  %and = scalar.andi %lhs, %rhs : i32
  %or = scalar.ori %lhs, %rhs : i32
  %xor = scalar.xori %lhs, %rhs : i32
  %shift_left = scalar.shli %lhs, %count : i32
  %shift_signed = scalar.shrsi %lhs, %count : i32
  %shift_unsigned = scalar.shrui %lhs, %count : i32
  %rotate_left = scalar.rotli %lhs, %count : i32
  %rotate_right = scalar.rotri %lhs, %count : i32
  func.return %signed_min, %unsigned_min, %signed_max, %unsigned_max, %and, %or, %xor, %shift_left, %shift_signed, %shift_unsigned, %rotate_left, %rotate_right : i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32
}

// ----
low.func.def target<vm.core> abi(vm_function) @integer_order_bits_i32(%lhs: reg<vm.value : i32>, %rhs: reg<vm.value : i32>, %count: reg<vm.value : i32>) -> (reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>) asm {
  %signed_min = integer.min.s32 %lhs, %rhs
  %unsigned_min = integer.min.u32 %lhs, %rhs
  %signed_max = integer.max.s32 %lhs, %rhs
  %unsigned_max = integer.max.u32 %lhs, %rhs
  %and = integer.and.i32 %lhs, %rhs
  %or = integer.or.i32 %lhs, %rhs
  %xor = integer.xor.i32 %lhs, %rhs
  %shift_left = integer.shift.left.i32 %lhs, %count
  %shift_signed = integer.shift.right.s32 %lhs, %count
  %shift_unsigned = integer.shift.right.u32 %lhs, %count
  %rotate_left = integer.rotate.left.i32 %lhs, %count
  %rotate_right = integer.rotate.right.i32 %lhs, %count
  return %signed_min, %unsigned_min, %signed_max, %unsigned_max, %and, %or, %xor, %shift_left, %shift_signed, %shift_unsigned, %rotate_left, %rotate_right
}

// ====

