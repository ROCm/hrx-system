func.def @scalar_i64_right_shift_select(%value: i64, %condition: i1) -> (i64, i64, i64, i64, i64) {
  %word_count = scalar.constant 32 : i64
  %sign_count = scalar.constant 63 : i64
  %logical_word = scalar.shrui %value, %word_count : i64
  %signed_word = scalar.shrsi %value, %word_count : i64
  %logical_sign = scalar.shrui %value, %sign_count : i64
  %signed_sign = scalar.shrsi %value, %sign_count : i64
  %selected = scf.select %condition, %logical_word, %signed_word : i64
  func.return %logical_word, %signed_word, %logical_sign, %signed_sign, %selected : i64, i64, i64, i64, i64
}

// ----
low.func.def target<vm.core> abi(vm_function) @scalar_i64_right_shift_select(%value: reg<vm.value : i64>, %condition: reg<vm.value : i1>) -> (reg<vm.value : i64>, reg<vm.value : i64>, reg<vm.value : i64>, reg<vm.value : i64>, reg<vm.value : i64>) asm {
  %word_count = constant.i64 32
  %sign_count = constant.i64 63
  %logical_word = integer.shift.right.u64 %value, %word_count
  %signed_word = integer.shift.right.s64 %value, %word_count
  %logical_sign = integer.shift.right.u64 %value, %sign_count
  %signed_sign = integer.shift.right.s64 %value, %sign_count
  %selected = value.select %condition, %logical_word, %signed_word
  return %logical_word, %signed_word, %logical_sign, %signed_sign, %selected
}

