func.def @scalar_i64_bitwise_sgpr(%lhs: i64, %rhs: i64) -> (i64, i64, i64) {
  %and = scalar.andi %lhs, %rhs : i64
  %or = scalar.ori %and, %lhs : i64
  %xor = scalar.xori %or, %rhs : i64
  func.return %and, %or, %xor : i64, i64, i64
}

// ----
low.func.def target<vm.core> abi(vm_function) @scalar_i64_bitwise_sgpr(%lhs: reg<vm.value : i64>, %rhs: reg<vm.value : i64>) -> (reg<vm.value : i64>, reg<vm.value : i64>, reg<vm.value : i64>) asm {
  %and = integer.and.i64 %lhs, %rhs
  %or = integer.or.i64 %and, %lhs
  %xor = integer.xor.i64 %or, %rhs
  return %and, %or, %xor
}

