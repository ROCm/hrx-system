func.def @scalar_i32_control(%lhs: i32, %rhs: i32) -> (i32) {
  %product = scalar.muli %lhs, %rhs : i32
  %mixed = scalar.xori %product, %rhs : i32
  %less = scalar.cmpi slt, %lhs, %rhs : i32
  %selected = scf.select %less, %mixed, %product : i32
  func.return %selected : i32
}

// ----
low.func.def target<vm.core> abi(vm_function) @scalar_i32_control(%lhs: reg<vm.value : i32>, %rhs: reg<vm.value : i32>) -> (reg<vm.value : i32>) asm {
  %product = integer.mul.i32 %lhs, %rhs
  %mixed = integer.xor.i32 %product, %rhs
  %less = integer.compare.i32 %lhs, %rhs, "slt"
  %selected = value.select %less, %mixed, %product : reg<vm.value : i32>
  return %selected
}

