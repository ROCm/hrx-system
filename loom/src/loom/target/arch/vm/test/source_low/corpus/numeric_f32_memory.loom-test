vm.target<core> @target
func.def target(@target) @f32_exact_scalar_div(%lhs_buffer: buffer, %rhs_buffer: buffer) -> (f32) {
  %base = index.constant 0 : offset
  %lhs_global = buffer.assume.memory_space<global> %lhs_buffer : buffer
  %rhs_global = buffer.assume.memory_space<global> %rhs_buffer : buffer
  %lhs_noalias, %rhs_noalias = buffer.assume.noalias %lhs_global, %rhs_global : buffer, buffer
  %lhs_view = buffer.view %lhs_noalias[%base] : buffer -> view<1xf32>
  %rhs_view = buffer.view %rhs_noalias[%base] : buffer -> view<1xf32>
  %lhs = view.load %lhs_view[0] : view<1xf32> -> f32
  %rhs = view.load %rhs_view[0] : view<1xf32> -> f32
  %quotient = scalar.divf %lhs, %rhs : f32
  func.return %quotient : f32
}

