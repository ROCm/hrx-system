vm.target<core> @target
func.def target(@target) @f32_guarded_arcp_reciprocal_scale(%amax: f32) -> (f32) {
  %fallback_scale = scalar.constant 0.0 : f32
  %reciprocal_numerator = scalar.constant 1.0 : f32
  %inverse_scale_limit = scalar.constant 0.007874015700000001 : f32
  %scale_limit = scalar.constant 127.0 : f32
  %d = scalar.mulf<nnan|ninf|nsz|arcp> %amax, %inverse_scale_limit : f32
  %zero_for_cmp = scalar.subf %d, %d : f32
  %nonzero = scalar.cmpf one, %d, %zero_for_cmp : f32
  %d_inv = scf.if %nonzero -> (f32) {
    %amax_inv = scalar.divf<nnan|ninf|nsz|arcp> %reciprocal_numerator, %amax : f32
    %candidate = scalar.mulf<nnan|ninf|nsz|arcp> %amax_inv, %scale_limit : f32
    scf.yield %candidate : f32
  } else {
    scf.yield %fallback_scale : f32
  }
  func.return %d_inv : f32
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value : f32>) -> (reg<vm.value : f32>)>}) @f32_guarded_arcp_reciprocal_scale(%amax: reg<vm.value : f32>) -> (reg<vm.value : f32>) asm {
  %fallback_scale = constant.zero : reg<vm.value : f32>
  %reciprocal_numerator = constant.i32 1065353216 : reg<vm.value : f32>
  %inverse_scale_limit = constant.i32 1006699012 : reg<vm.value : f32>
  %scale_limit = constant.i32 1123942400 : reg<vm.value : f32>
  %d = float.mul.f32 %amax, %inverse_scale_limit : reg<vm.value : f32>
  %zero_for_cmp = float.sub.f32 %d, %d : reg<vm.value : f32>
  %nonzero = float.compare.f32 %d, %zero_for_cmp, one : reg<vm.value : i1>
  %amax_inv = float.div.f32 %reciprocal_numerator, %amax : reg<vm.value : f32>
  %candidate = float.mul.f32 %amax_inv, %scale_limit : reg<vm.value : f32>
  %d_inv = value.select %nonzero, %candidate, %fallback_scale : reg<vm.value : f32>
  return %d_inv
}

