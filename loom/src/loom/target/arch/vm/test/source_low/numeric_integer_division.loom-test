  %signed_remainder = scalar.remsi %dividend, %divisor : i64
  %unsigned_quotient = scalar.divui %dividend, %divisor : i64
  %unsigned_remainder = scalar.remui %dividend, %divisor : i64
  func.return %signed_quotient, %signed_remainder, %unsigned_quotient, %unsigned_remainder : i64, i64, i64, i64
}

// ----
low.func.def target<vm.core> abi(vm_function) @integer_division_i64(%dividend: reg<vm.value : i64>, %divisor: reg<vm.value : i64>) -> (reg<vm.value : i64>, reg<vm.value : i64>, reg<vm.value : i64>, reg<vm.value : i64>) asm {
  %signed_quotient = integer.div.s64 %dividend, %divisor
  %signed_remainder = integer.rem.s64 %dividend, %divisor
  %unsigned_quotient = integer.div.u64 %dividend, %divisor
  %unsigned_remainder = integer.rem.u64 %dividend, %divisor
  return %signed_quotient, %signed_remainder, %unsigned_quotient, %unsigned_remainder
}
