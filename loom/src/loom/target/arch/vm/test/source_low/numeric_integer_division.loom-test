// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_integer_division.loom-test
// RUN: emit source-low target=vm:core output=low

func.def @integer_division_i32(%dividend: i32, %divisor: i32) -> (i32, i32, i32, i32) {
  %signed_quotient = scalar.divsi %dividend, %divisor : i32
  %signed_remainder = scalar.remsi %dividend, %divisor : i32
  %unsigned_quotient = scalar.divui %dividend, %divisor : i32
  %unsigned_remainder = scalar.remui %dividend, %divisor : i32
  func.return %signed_quotient, %signed_remainder, %unsigned_quotient, %unsigned_remainder : i32, i32, i32, i32
}

// ----
low.func.def target<vm.core> abi(vm_function) @integer_division_i32(%dividend: reg<vm.value : i32>, %divisor: reg<vm.value : i32>) -> (reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>) asm {
  %signed_quotient = integer.div.s32 %dividend, %divisor
  %signed_remainder = integer.rem.s32 %dividend, %divisor
  %unsigned_quotient = integer.div.u32 %dividend, %divisor
  %unsigned_remainder = integer.rem.u32 %dividend, %divisor
  return %signed_quotient, %signed_remainder, %unsigned_quotient, %unsigned_remainder
}

// ====

