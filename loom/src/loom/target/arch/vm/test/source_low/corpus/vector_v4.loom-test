vm.target<core> @target
func.def target(@target) @f32x4_memory_indexed_add(%lhs: buffer, %rhs: buffer, %output: buffer, %i: index) {
  %bounded_i = index.assume %i [range(%i, 0, 12)] : index
  %buffer_base = index.constant 0 : offset
  %lhs_view = buffer.view %lhs[%buffer_base] : buffer -> view<16xf32>
  %rhs_view = buffer.view %rhs[%buffer_base] : buffer -> view<16xf32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<16xf32>
  %lhs_v = vector.load %lhs_view[%bounded_i] : view<16xf32> -> vector<4xf32>
  %rhs_v = vector.load %rhs_view[%bounded_i] : view<16xf32> -> vector<4xf32>
  %sum = vector.addf %lhs_v, %rhs_v : vector<4xf32>
  vector.store %sum, %output_view[%bounded_i] : vector<4xf32>, view<16xf32>
  func.return
