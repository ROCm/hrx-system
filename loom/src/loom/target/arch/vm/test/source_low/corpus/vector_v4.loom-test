vm.target<core> @target
func.def target(@target) @i32x4_memory_copy(%input: buffer, %output: buffer) {
  %buffer_base = index.constant 0 : offset
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<4xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<4xi32>
  %loaded = vector.load %input_view[0] : view<4xi32> -> vector<4xi32>
  vector.store %loaded, %output_view[0] : vector<4xi32>, view<4xi32>
  func.return
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.ref : buffer>, reg<vm.ref : buffer>) -> ()>}) @i32x4_memory_copy(%input: reg<vm.ref : buffer>, %output: reg<vm.ref : buffer>) asm {
  %8 = constant.zero : reg<vm.value : offset>
  %loaded = buffer.load %input, %8, %8, 0, i32.x4 : reg<vm.value x4 : vector<4xi32>>
  buffer.store %output, %8, %8, %loaded, 0, i32.x4
  return
}

