low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.ref : buffer>, reg<vm.ref : buffer>, reg<vm.ref : buffer>, reg<vm.value : index>) -> ()>}) @f32x4_memory_indexed_add(%lhs: reg<vm.ref : buffer>, %rhs: reg<vm.ref : buffer>, %output: reg<vm.ref : buffer>, %bounded_i: reg<vm.value : index>) asm {
  %41 = constant.zero : reg<vm.value : offset>
  %42 = buffer.load %lhs, %41, %bounded_i, 4, i32.x1 : reg<vm.value : f32>
  %44 = buffer.load %rhs, %41, %bounded_i, 4, i32.x1 : reg<vm.value : f32>
  %45 = float.add.f32 %42, %44 : reg<vm.value : f32>
  %46 = constant.s16 4 : reg<vm.value : offset>
  %47 = buffer.load %lhs, %46, %bounded_i, 4, i32.x1 : reg<vm.value : f32>
  %49 = buffer.load %rhs, %46, %bounded_i, 4, i32.x1 : reg<vm.value : f32>
  %50 = float.add.f32 %47, %49 : reg<vm.value : f32>
  %51 = constant.s16 8 : reg<vm.value : offset>
  %52 = buffer.load %lhs, %51, %bounded_i, 4, i32.x1 : reg<vm.value : f32>
  %54 = buffer.load %rhs, %51, %bounded_i, 4, i32.x1 : reg<vm.value : f32>
  %55 = float.add.f32 %52, %54 : reg<vm.value : f32>
  %56 = constant.s16 12 : reg<vm.value : offset>
  %57 = buffer.load %lhs, %56, %bounded_i, 4, i32.x1 : reg<vm.value : f32>
  %59 = buffer.load %rhs, %56, %bounded_i, 4, i32.x1 : reg<vm.value : f32>
  %60 = float.add.f32 %57, %59 : reg<vm.value : f32>
  %sum = concat(%45, %50, %55, %60) : (reg<vm.value : f32>, reg<vm.value : f32>, reg<vm.value : f32>, reg<vm.value : f32>) -> reg<vm.value x4 : vector<4xf32>>
  buffer.store %output, %41, %bounded_i, %sum, 4, i32.x4
  return
}
