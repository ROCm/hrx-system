// RUN: emit source-low output=low

vm.target<core> @target

func.def target(@target) @narrow_integer_bitwise(%lhs: i8, %rhs: i8) -> (i8, i8, i8) {
  %and = scalar.andi %lhs, %rhs : i8
  %or = scalar.ori %lhs, %rhs : i8
  %xor = scalar.xori %lhs, %rhs : i8
  func.return %and, %or, %xor : i8, i8, i8
}

func.def target(@target) @narrow_integer_shifts(%lhs: i16, %rhs: i16) -> (i16, i16, i16) {
  %left = scalar.shli %lhs, %rhs : i16
  %signed_right = scalar.shrsi %lhs, %rhs : i16
  %unsigned_right = scalar.shrui %lhs, %rhs : i16
  func.return %left, %signed_right, %unsigned_right : i16, i16, i16
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value : i8>, reg<vm.value : i8>) -> (reg<vm.value : i8>, reg<vm.value : i8>, reg<vm.value : i8>)>}) @narrow_integer_bitwise(%lhs: reg<vm.value : i8>, %rhs: reg<vm.value : i8>) -> (reg<vm.value : i8>, reg<vm.value : i8>, reg<vm.value : i8>) asm {
  %45 = conversion.integer %lhs, u8.to.i32 : reg<vm.value : i32>
  %46 = conversion.integer %rhs, u8.to.i32 : reg<vm.value : i32>
  %47 = integer.and.i32 %45, %46 : reg<vm.value : i32>
  %and = conversion.integer %47, i32.to.i8 : reg<vm.value : i8>
  %49 = integer.or.i32 %45, %46 : reg<vm.value : i32>
  %or = conversion.integer %49, i32.to.i8 : reg<vm.value : i8>
  %51 = integer.xor.i32 %45, %46 : reg<vm.value : i32>
  %xor = conversion.integer %51, i32.to.i8 : reg<vm.value : i8>
  return %and, %or, %xor
}

low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value : i16>, reg<vm.value : i16>) -> (reg<vm.value : i16>, reg<vm.value : i16>, reg<vm.value : i16>)>}) @narrow_integer_shifts(%lhs: reg<vm.value : i16>, %rhs: reg<vm.value : i16>) -> (reg<vm.value : i16>, reg<vm.value : i16>, reg<vm.value : i16>) asm {
  %58 = conversion.integer %lhs, u16.to.i32 : reg<vm.value : i32>
  %59 = conversion.integer %rhs, u16.to.i32 : reg<vm.value : i32>
  %60 = integer.shift.left.i32 %58, %59 : reg<vm.value : i32>
  %left = conversion.integer %60, i32.to.i16 : reg<vm.value : i16>
  %62 = conversion.integer %lhs, s16.to.i32 : reg<vm.value : i32>
  %63 = integer.shift.right.s32 %62, %59 : reg<vm.value : i32>
  %signed_right = conversion.integer %63, i32.to.i16 : reg<vm.value : i16>
  %65 = integer.shift.right.u32 %58, %59 : reg<vm.value : i32>
  %unsigned_right = conversion.integer %65, i32.to.i16 : reg<vm.value : i16>
  return %left, %signed_right, %unsigned_right
}
