  %bytes = constant.s16 32 : reg<vm.value : offset>
  %scratch = buffer.allocate %bytes, 2 : reg<vm.ref : buffer>
  %increment = constant.s16 1 : reg<vm.value : i32>
  low.br ^_bb1(%loop_begin: reg<vm.value : index>)
^_bb1(%i: reg<vm.value : index>):
  %33 = integer.compare.i64 %i, %loop_end, slt : reg<vm.value : i1>
  low.cond_br %33, ^_bb2, ^_bb3 : reg<vm.value : i1>
^_bb2:
  %34 = constant.s16 2 : reg<vm.value : offset>
  %35 = integer.shift.left.i64 %i, %34 : reg<vm.value : offset>
  buffer.atomic.reduce %scratch, %35, %increment, 2, 16
  %36 = integer.add.i64 %i, %loop_step : reg<vm.value : index>
  low.br ^_bb1(%36: reg<vm.value : index>)
^_bb3:
  return
}

