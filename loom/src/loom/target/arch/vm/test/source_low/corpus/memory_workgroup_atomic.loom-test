vm.target<core> @target
kernel.def target(@target) @lds_atomic_add_i32() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch() {
  %tid = kernel.workitem.id<x> : index
  %scratch_base = index.constant 0 : offset
  %bytes = index.constant 256 : offset
  %scratch = buffer.alloca<workgroup> align(4) %bytes : buffer
  %scratch_view = buffer.view %scratch[%scratch_base] : buffer -> view<64xi32>
  %increment = scalar.constant 1 : i32
  view.atomic.reduce<addi> %increment, %scratch_view[%tid] {ordering = relaxed, scope = workgroup} : i32, view<64xi32>
  %old = view.atomic.rmw<addi> %increment, %scratch_view[%tid] {ordering = relaxed, scope = workgroup} : i32, view<64xi32> -> i32
  kernel.return
}

