  %7 = slice %values[0] : reg<vm.value x4 : vector<4xf32>> -> reg<vm.value x2 : vector<2xf32>>
  %8 = slice %values[3] : reg<vm.value x4 : vector<4xf32>> -> reg<vm.value : vector<1xf32>>
  %updated = concat(%7, %value, %8) : (reg<vm.value x2 : vector<2xf32>>, reg<vm.value : f32>, reg<vm.value : vector<1xf32>>) -> reg<vm.value x4 : vector<4xf32>>
  return %updated
}

