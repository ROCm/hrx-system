  func.return %updated : vector<1xf32>
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value : vector<1xf32>>, reg<vm.value : f32>, reg<vm.value : index>) -> (reg<vm.value : vector<1xf32>>)>}) @f32x1_insert_dynamic(%values: reg<vm.value : vector<1xf32>>, %value: reg<vm.value : f32>, %lane: reg<vm.value : index>) -> (reg<vm.value : vector<1xf32>>) asm {
  %15 = constant.zero : reg<vm.value : index>
  %16 = integer.compare.i64 %15, %lane, eq : reg<vm.value : i1>
  %17 = slice %values[0] : reg<vm.value : vector<1xf32>> -> reg<vm.value : f32>
  %18 = value.select %16, %value, %17 : reg<vm.value : f32>
  %updated = concat(%18) : (reg<vm.value : f32>) -> reg<vm.value : vector<1xf32>>
  return %updated
}

