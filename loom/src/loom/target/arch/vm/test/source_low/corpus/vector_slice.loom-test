  %35 = integer.compare.i64 %34, %lane, eq : reg<vm.value : i1>
  %36 = slice %values[2] : reg<vm.value x4 : vector<4xf32>> -> reg<vm.value : f32>
  %37 = value.select %35, %value, %36 : reg<vm.value : f32>
  %38 = constant.s16 3 : reg<vm.value : index>
  %39 = integer.compare.i64 %38, %lane, eq : reg<vm.value : i1>
  %40 = slice %values[3] : reg<vm.value x4 : vector<4xf32>> -> reg<vm.value : f32>
  %41 = value.select %39, %value, %40 : reg<vm.value : f32>
