vm.target<core> @target

func.def target(@target) @index_shift_constant_boundaries(%value: index) -> (index, index, index, index, index, index) {
  %identity_count = index.constant 0 : index
  %last = index.constant 31 : index
  %left_zero = index.shli %value, %identity_count : index
  %logical_zero = index.shrui %value, %identity_count : index
  %signed_zero = index.shrsi %value, %identity_count : index
  %left_last = index.shli %value, %last : index
  %logical_last = index.shrui %value, %last : index
  %signed_last = index.shrsi %value, %last : index
  func.return %left_zero, %logical_zero, %signed_zero, %left_last, %logical_last, %signed_last : index, index, index, index, index, index
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) @index_shift_constant_boundaries(%value: reg<vm.value : i64>) -> (reg<vm.value : i64>, reg<vm.value : i64>, reg<vm.value : i64>, reg<vm.value : i64>, reg<vm.value : i64>, reg<vm.value : i64>) asm {
  %last = constant.i64 31
  %left_last = integer.shift.left.i64 %value, %last
  %logical_last = integer.shift.right.u64 %value, %last
  %signed_last = integer.shift.right.s64 %value, %last
  return %value, %value, %value, %left_last, %logical_last, %signed_last
}

// ====

vm.target<core> @target

func.def target(@target) @index_shift_arithmetic_reuse(%value: index, %count: index) -> (index) {
  %shifted = index.shrsi %value, %count : index
  %with_count = index.add %shifted, %count : index
  %result = index.xori %with_count, %value : index
  func.return %result : index
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) @index_shift_arithmetic_reuse(%value: reg<vm.value : i64>, %count: reg<vm.value : i64>) -> (reg<vm.value : i64>) asm {
  %shifted = integer.shift.right.s64 %value, %count
  %with_count = integer.add.i64 %shifted, %count
  %result = integer.xor.i64 %with_count, %value
  return %result
}
