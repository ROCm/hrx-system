// ====

vm.target<core> @target

// All three shifts preserve their input and the count for later arithmetic.
func.def target(@target) @word_shifts_reuse_input(%value: i32, %count: i32) -> (i32) {
  %left = scalar.shli %value, %count : i32
  %logical = scalar.shrui %value, %count : i32
  %signed = scalar.shrsi %value, %count : i32
  %directions = scalar.xori %left, %logical : i32
  %combined = scalar.xori %directions, %signed : i32
  %with_count = scalar.addi %combined, %count : i32
  %result = scalar.xori %with_count, %value : i32
  func.return %result : i32
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) @word_shifts_reuse_input(%value: reg<vm.value : i32>, %count: reg<vm.value : i32>) -> (reg<vm.value : i32>) asm {
  %left = integer.shift.left.i32 %value, %count
  %logical = integer.shift.right.u32 %value, %count
  %signed = integer.shift.right.s32 %value, %count
  %directions = integer.xor.i32 %left, %logical
  %combined = integer.xor.i32 %directions, %signed
  %with_count = integer.add.i32 %combined, %count
  %result = integer.xor.i32 %with_count, %value
  return %result
}

// ====

vm.target<core> @target

func.def target(@target) @wide_shifts_reuse_counts(%value: i64, %left_count: i64, %right_count: i64) -> (i64) {
  %left = scalar.shli %value, %left_count : i64
  %logical = scalar.shrui %value, %right_count : i64
  %signed = scalar.shrsi %left, %left_count : i64
  %directions = scalar.xori %logical, %signed : i64
  %with_left_count = scalar.addi %directions, %left_count : i64
  %with_counts = scalar.addi %with_left_count, %right_count : i64
  %result = scalar.xori %with_counts, %value : i64
  func.return %result : i64
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) @wide_shifts_reuse_counts(%value: reg<vm.value : i64>, %left_count: reg<vm.value : i64>, %right_count: reg<vm.value : i64>) -> (reg<vm.value : i64>) asm {
  %left = integer.shift.left.i64 %value, %left_count
  %logical = integer.shift.right.u64 %value, %right_count
  %signed = integer.shift.right.s64 %left, %left_count
  %directions = integer.xor.i64 %logical, %signed
  %with_left_count = integer.add.i64 %directions, %left_count
  %with_counts = integer.add.i64 %with_left_count, %right_count
  %result = integer.xor.i64 %with_counts, %value
  return %result
}

