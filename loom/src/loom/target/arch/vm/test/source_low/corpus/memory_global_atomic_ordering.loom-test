vm.target<core> @target
kernel.def target(@target) @global_atomic_acq_rel_cmpxchg_i32() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%input: buffer) {
  %tid = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %global = buffer.assume.memory_space<global> %input : buffer
  %view = buffer.view %global[%buffer_base] : buffer -> view<64xi32>
  %expected = scalar.constant 7 : i32
  %replacement = scalar.constant 9 : i32
  %old = view.atomic.cmpxchg %expected, %replacement, %view[%tid] {failure_ordering = acquire, scope = device, success_ordering = acq_rel} : i32, view<64xi32> -> i32
  kernel.return
}

