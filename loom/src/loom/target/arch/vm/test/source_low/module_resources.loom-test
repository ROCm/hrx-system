global.variable @mutable_function : func.ref<(i32) -> (i32)>

global.constant @immutable_function : func.ref<(i32) -> (i32)>

global.rodata.def @message = align(8) bytes("6c6f6f6d")

low.func.def initializer target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value : i32>, reg<vm.ref : hal.buffer>, reg<vm.function : func.ref<(i32) -> (i32)>>) -> ()>}) export("initialize") @initialize_resources(%value: reg<vm.value : i32>, %ref: reg<vm.ref : hal.buffer>, %function: reg<vm.function : func.ref<(i32) -> (i32)>>) asm {
  global.value.immutable.store %value, 0
  %31 = ref.retain %ref : reg<vm.ref : hal.buffer>
  global.ref.immutable.store.move %31, 0
  global.func.immutable.store %function, 0
  return
}

low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value : i64>, reg<vm.ref : hal.buffer>, reg<vm.function : func.ref<(i32) -> (i32)>>) -> (reg<vm.value : i64>, reg<vm.value : i32>, reg<vm.ref : hal.buffer>, reg<vm.ref : hal.buffer>, reg<vm.function : func.ref<(i32) -> (i32)>>, reg<vm.function : func.ref<(i32) -> (i32)>>, reg<vm.ref : buffer>)>}) @access_resources(%value: reg<vm.value : i64>, %ref: reg<vm.ref : hal.buffer>, %function: reg<vm.function : func.ref<(i32) -> (i32)>>) -> (reg<vm.value : i64>, reg<vm.value : i32>, reg<vm.ref : hal.buffer>, reg<vm.ref : hal.buffer>, reg<vm.function : func.ref<(i32) -> (i32)>>, reg<vm.function : func.ref<(i32) -> (i32)>>, reg<vm.ref : buffer>) asm {
  global.value.mutable.store %value, 1
  %42 = ref.retain %ref : reg<vm.ref : hal.buffer>
  global.ref.mutable.store.move %42, 1
  global.func.mutable.store %function, 1
  %mutable_value = global.value.mutable.load 1 : reg<vm.value : i64>
  %immutable_value = global.value.immutable.load 0 : reg<vm.value : i32>
  %mutable_ref = global.ref.mutable.load.retain 1 : reg<vm.ref : hal.buffer>
  %immutable_ref = global.ref.immutable.load.borrow 0 : reg<vm.ref : hal.buffer>
  %mutable_function = global.func.mutable.load 1 : reg<vm.function : func.ref<(i32) -> (i32)>>
  %immutable_function = global.func.immutable.load 0 : reg<vm.function : func.ref<(i32) -> (i32)>>
