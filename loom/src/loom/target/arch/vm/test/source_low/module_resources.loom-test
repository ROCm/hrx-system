  return %mutable_value, %immutable_value, %mutable_ref, %immutable_ref, %mutable_function, %immutable_function, %message
}

low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.ref : hal.buffer>) -> (reg<vm.ref : hal.buffer>)>}) @store_and_return_ref(%ref: reg<vm.ref : hal.buffer>) -> (reg<vm.ref : hal.buffer>) asm {
  %52 = ref.retain %ref : reg<vm.ref : hal.buffer>
  global.ref.mutable.store.move %52, 1
  return %ref
}
vm.global @mutable_value ordinal(1)
vm.global @immutable_value ordinal(0)
vm.global @mutable_ref ordinal(1)
vm.global @immutable_ref ordinal(0)
vm.global @mutable_function ordinal(1)
vm.global @immutable_function ordinal(0)
