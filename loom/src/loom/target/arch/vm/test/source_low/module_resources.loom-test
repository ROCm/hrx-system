vm.target<core> @target

global.variable @mutable_value : i64
global.constant @immutable_value : i32
global.variable @mutable_ref : hal.buffer
global.constant @immutable_ref : hal.buffer
global.variable @mutable_function : func.ref<(i32) -> (i32)>
global.constant @immutable_function : func.ref<(i32) -> (i32)>
global.rodata.def @message = align(8) bytes("6c6f6f6d")

func.def initializer target(@target) @initialize_resources(%value: i32, %ref: hal.buffer, %function: func.ref<(i32) -> (i32)>) {
  global.store %value, @immutable_value : i32
  global.store %ref, @immutable_ref : hal.buffer
  global.store %function, @immutable_function : func.ref<(i32) -> (i32)>
  func.return
}

func.def target(@target) @access_resources(%value: i64, %ref: hal.buffer, %function: func.ref<(i32) -> (i32)>) -> (i64, i32, hal.buffer, hal.buffer, func.ref<(i32) -> (i32)>, func.ref<(i32) -> (i32)>, buffer) {
  global.store %value, @mutable_value : i64
  global.store %ref, @mutable_ref : hal.buffer
  global.store %function, @mutable_function : func.ref<(i32) -> (i32)>
  %mutable_value = global.load @mutable_value : i64
  %immutable_value = global.load @immutable_value : i32
  %mutable_ref = global.load @mutable_ref : hal.buffer
  %immutable_ref = global.load @immutable_ref : hal.buffer
  %mutable_function = global.load @mutable_function : func.ref<(i32) -> (i32)>
  %immutable_function = global.load @immutable_function : func.ref<(i32) -> (i32)>
  %message = global.load @message : buffer
  func.return %mutable_value, %immutable_value, %mutable_ref, %immutable_ref, %mutable_function, %immutable_function, %message : i64, i32, hal.buffer, hal.buffer, func.ref<(i32) -> (i32)>, func.ref<(i32) -> (i32)>, buffer
}

func.def target(@target) @store_and_return_ref(%ref: hal.buffer) -> (hal.buffer) {
  global.store %ref, @mutable_ref : hal.buffer
  func.return %ref : hal.buffer
}

