low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value x4 : vector<4xf32>>, reg<vm.ref : buffer>) -> (reg<vm.value : f32>)>}) @f32_uniform_smem_vector_operands(%lhs: reg<vm.value x4 : vector<4xf32>>, %weights_noalias: reg<vm.ref : buffer>) -> (reg<vm.value : f32>) asm {
  %46 = constant.zero : reg<vm.value : offset>
  %47 = constant.s16 16 : reg<vm.value : offset>
  %bias = buffer.load %weights_noalias, %47, %46, 0, i32.x1 : reg<vm.value : f32>
  %49 = slice %lhs[0] : reg<vm.value x4 : vector<4xf32>> -> reg<vm.value : f32>
  %51 = buffer.load %weights_noalias, %46, %46, 0, i32.x1 : reg<vm.value : f32>
  %52 = float.mul.f32 %49, %51 : reg<vm.value : f32>
  %53 = float.math.ternary.f32 %52, %51, %bias, fma : reg<vm.value : f32>
  %54 = slice %lhs[1] : reg<vm.value x4 : vector<4xf32>> -> reg<vm.value : f32>
  %56 = constant.s16 4 : reg<vm.value : offset>
  %57 = buffer.load %weights_noalias, %56, %46, 0, i32.x1 : reg<vm.value : f32>
  %58 = float.mul.f32 %54, %57 : reg<vm.value : f32>
  %59 = float.math.ternary.f32 %58, %57, %53, fma : reg<vm.value : f32>
  %60 = slice %lhs[2] : reg<vm.value x4 : vector<4xf32>> -> reg<vm.value : f32>
  %62 = constant.s16 8 : reg<vm.value : offset>
  %63 = buffer.load %weights_noalias, %62, %46, 0, i32.x1 : reg<vm.value : f32>
  %64 = float.mul.f32 %60, %63 : reg<vm.value : f32>
  %65 = float.math.ternary.f32 %64, %63, %59, fma : reg<vm.value : f32>
  %66 = slice %lhs[3] : reg<vm.value x4 : vector<4xf32>> -> reg<vm.value : f32>
  %68 = constant.s16 12 : reg<vm.value : offset>
  %69 = buffer.load %weights_noalias, %68, %46, 0, i32.x1 : reg<vm.value : f32>
  %70 = float.mul.f32 %66, %69 : reg<vm.value : f32>
  %dot = float.math.ternary.f32 %70, %69, %65, fma : reg<vm.value : f32>
  return %dot
}
