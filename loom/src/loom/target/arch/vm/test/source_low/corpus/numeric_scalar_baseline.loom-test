vm.target<core> @target
func.def target(@target) @scalar_boolean_logic(%lhs: i1, %rhs: i1) -> (i1, i1, i1) {
  %both = scalar.andi %lhs, %rhs : i1
  %either = scalar.ori %lhs, %rhs : i1
  %different = scalar.xori %lhs, %rhs : i1
  func.return %both, %either, %different : i1, i1, i1
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value : i1>, reg<vm.value : i1>) -> (reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>)>}) @scalar_boolean_logic(%lhs: reg<vm.value : i1>, %rhs: reg<vm.value : i1>) -> (reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>) asm {
  %both = integer.and.i32 %lhs, %rhs : reg<vm.value : i1>
  %either = integer.or.i32 %lhs, %rhs : reg<vm.value : i1>
  %different = integer.xor.i32 %lhs, %rhs : reg<vm.value : i1>
  return %both, %either, %different
}

// ====

vm.target<core> @target
func.def target(@target) @index_native_integer_ops(%lhs: index, %rhs: index, %stride: offset) -> (index, index, index, index, i1, offset) {
  %difference = index.sub %lhs, %rhs : index
  %bits = index.andi %difference, %rhs : index
  %rotated = index.rotri %bits, %rhs : index
  %population = index.ctpopi %rotated : index
  %ordered = index.cmp ult, %population, %lhs : index
  %byte_offset = index.scale %population, %stride : index, offset -> offset
  func.return %difference, %bits, %rotated, %population, %ordered, %byte_offset : index, index, index, index, i1, offset
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value : index>, reg<vm.value : index>, reg<vm.value : offset>) -> (reg<vm.value : index>, reg<vm.value : index>, reg<vm.value : index>, reg<vm.value : index>, reg<vm.value : i1>, reg<vm.value : offset>)>}) @index_native_integer_ops(%lhs: reg<vm.value : index>, %rhs: reg<vm.value : index>, %stride: reg<vm.value : offset>) -> (reg<vm.value : index>, reg<vm.value : index>, reg<vm.value : index>, reg<vm.value : index>, reg<vm.value : i1>, reg<vm.value : offset>) asm {
  %difference = integer.sub.i64 %lhs, %rhs : reg<vm.value : index>
  %bits = integer.and.i64 %difference, %rhs : reg<vm.value : index>
  %rotated = integer.rotate.right.i64 %bits, %rhs : reg<vm.value : index>
  %population = integer.popcount.i64 %rotated : reg<vm.value : index>
  %ordered = integer.compare.i64 %population, %lhs, ult : reg<vm.value : i1>
  %byte_offset = integer.mul.i64 %population, %stride : reg<vm.value : offset>
  return %difference, %bits, %rotated, %population, %ordered, %byte_offset
}

// ====

vm.target<core> @target
func.def target(@target) @scalar_f32_core_records(%value: f32, %rhs: f32, %lower: f32, %upper: f32) -> (f32, f32, f32, i1, i1, f32, f32, f32) {
  %sum = scalar.addf %value, %rhs : f32
  %minimum = scalar.minimumf %value, %rhs : f32
  %clamped = scalar.clampf<ieee> %value, %lower, %upper : f32
  %ordered = scalar.cmpf olt, %value, %rhs : f32
  %finite = scalar.isfinitef %value : f32
  %root = scalar.sqrtf %value : f32
  %power = scalar.powf %value, %rhs : f32
  %fused = scalar.fmaf %value, %rhs, %sum : f32
  func.return %sum, %minimum, %clamped, %ordered, %finite, %root, %power, %fused : f32, f32, f32, i1, i1, f32, f32, f32
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value : f32>, reg<vm.value : f32>, reg<vm.value : f32>, reg<vm.value : f32>) -> (reg<vm.value : f32>, reg<vm.value : f32>, reg<vm.value : f32>, reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : f32>, reg<vm.value : f32>, reg<vm.value : f32>)>}) @scalar_f32_core_records(%value: reg<vm.value : f32>, %rhs: reg<vm.value : f32>, %lower: reg<vm.value : f32>, %upper: reg<vm.value : f32>) -> (reg<vm.value : f32>, reg<vm.value : f32>, reg<vm.value : f32>, reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : f32>, reg<vm.value : f32>, reg<vm.value : f32>) asm {
  %sum = float.add.f32 %value, %rhs : reg<vm.value : f32>
  %minimum = float.minmax.f32 %value, %rhs, minimum : reg<vm.value : f32>
  %clamped = float.clamp.f32 %value, %lower, %upper, ieee : reg<vm.value : f32>
  %ordered = float.compare.f32 %value, %rhs, olt : reg<vm.value : i1>
  %finite = float.classify.f32 %value, isfinite : reg<vm.value : i1>
  %root = float.math.unary.f32 %value, sqrt : reg<vm.value : f32>
  %power = float.math.binary.f32 %value, %rhs, pow : reg<vm.value : f32>
  %fused = float.math.ternary.f32 %value, %rhs, %sum, fma : reg<vm.value : f32>
  return %sum, %minimum, %clamped, %ordered, %finite, %root, %power, %fused
}

