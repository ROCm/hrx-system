vm.target<core> @target
func.def target(@target) @scalar_native_integer_ops(%lhs: i32, %rhs: i32) -> (i32, i32, i32, i32, i32) {
  %quotient = scalar.divsi %lhs, %rhs : i32
  %minimum = scalar.minui %lhs, %rhs : i32
  %bits = scalar.ori %lhs, %rhs : i32
  %rotated = scalar.rotli %bits, %rhs : i32
  %leading_zeros = scalar.ctlzi %rotated : i32
  func.return %quotient, %minimum, %bits, %rotated, %leading_zeros : i32, i32, i32, i32, i32
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value : i32>, reg<vm.value : i32>) -> (reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>)>}) @scalar_native_integer_ops(%lhs: reg<vm.value : i32>, %rhs: reg<vm.value : i32>) -> (reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>) asm {
  %quotient = integer.div.s32 %lhs, %rhs : reg<vm.value : i32>
  %minimum = integer.min.u32 %lhs, %rhs : reg<vm.value : i32>
  %bits = integer.or.i32 %lhs, %rhs : reg<vm.value : i32>
  %rotated = integer.rotate.left.i32 %bits, %rhs : reg<vm.value : i32>
  %leading_zeros = integer.count.leading.zeros.i32 %rotated : reg<vm.value : i32>
  return %quotient, %minimum, %bits, %rotated, %leading_zeros
}

