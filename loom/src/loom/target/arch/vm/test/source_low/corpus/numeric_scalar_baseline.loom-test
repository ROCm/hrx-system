low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value : i32>, reg<vm.value : i32>) -> (reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>)>}) @scalar_i32_compare_predicates(%lhs: reg<vm.value : i32>, %rhs: reg<vm.value : i32>) -> (reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>) asm {
  %eq = integer.compare.i32 %lhs, %rhs, eq : reg<vm.value : i1>
  %ne = integer.compare.i32 %lhs, %rhs, ne : reg<vm.value : i1>
  %slt = integer.compare.i32 %lhs, %rhs, slt : reg<vm.value : i1>
  %sle = integer.compare.i32 %lhs, %rhs, sle : reg<vm.value : i1>
  %sgt = integer.compare.i32 %lhs, %rhs, sgt : reg<vm.value : i1>
  %sge = integer.compare.i32 %lhs, %rhs, sge : reg<vm.value : i1>
  %ult = integer.compare.i32 %lhs, %rhs, ult : reg<vm.value : i1>
  %ule = integer.compare.i32 %lhs, %rhs, ule : reg<vm.value : i1>
  %ugt = integer.compare.i32 %lhs, %rhs, ugt : reg<vm.value : i1>
  %uge = integer.compare.i32 %lhs, %rhs, uge : reg<vm.value : i1>
  return %eq, %ne, %slt, %sle, %sgt, %sge, %ult, %ule, %ugt, %uge
}

