vm.target<core> @target
func.def target(@target) @scalar_bf16_extend(%source: bf16) -> (f32) {
  %result = scalar.extf %source : bf16 to f32
  func.return %result : f32
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value : bf16>) -> (reg<vm.value : f32>)>}) @scalar_bf16_extend(%source: reg<vm.value : bf16>) -> (reg<vm.value : f32>) asm {
  %result = conversion.float.extend %source, bf16.to.f32 : reg<vm.value : f32>
  return %result
}

// ====

vm.target<core> @target
func.def target(@target) @index_i32_cast(%source: i32) -> (index) {
  %result = index.cast %source : i32 to index
  func.return %result : index
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value : i32>) -> (reg<vm.value : index>)>}) @index_i32_cast(%source: reg<vm.value : i32>) -> (reg<vm.value : index>) asm {
  %result = conversion.integer %source, s32.to.i64 : reg<vm.value : index>
  return %result
}

// ====

vm.target<core> @target
func.def target(@target) @index_divide_remainder(%lhs: index, %rhs: index) -> (index, index) where [range(%rhs, 1, 65535)] {
  %quotient = index.div %lhs, %rhs : index
  %remainder = index.rem %lhs, %rhs : index
  func.return %quotient, %remainder : index, index
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value : index>, reg<vm.value : index>) -> (reg<vm.value : index>, reg<vm.value : index>)>}) @index_divide_remainder(%lhs: reg<vm.value : index>, %rhs: reg<vm.value : index>) -> (reg<vm.value : index>, reg<vm.value : index>) where [range(%rhs, 1, 65535)] asm {
  %quotient = integer.div.u64 %lhs, %rhs : reg<vm.value : index>
  %remainder = integer.rem.u64 %lhs, %rhs : reg<vm.value : index>
  return %quotient, %remainder
}

// ====

vm.target<core> @target
func.def target(@target) @index_shifts(%value: index, %amount: index) -> (index, index, index) {
  %left = index.shli %value, %amount : index
  %signed_right = index.shrsi %value, %amount : index
  %unsigned_right = index.shrui %value, %amount : index
  func.return %left, %signed_right, %unsigned_right : index, index, index
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value : index>, reg<vm.value : index>) -> (reg<vm.value : index>, reg<vm.value : index>, reg<vm.value : index>)>}) @index_shifts(%value: reg<vm.value : index>, %amount: reg<vm.value : index>) -> (reg<vm.value : index>, reg<vm.value : index>, reg<vm.value : index>) asm {
  %left = integer.shift.left.i64 %value, %amount : reg<vm.value : index>
  %signed_right = integer.shift.right.s64 %value, %amount : reg<vm.value : index>
  %unsigned_right = integer.shift.right.u64 %value, %amount : reg<vm.value : index>
  return %left, %signed_right, %unsigned_right
}
