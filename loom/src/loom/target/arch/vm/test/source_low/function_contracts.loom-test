// RUN: pass vm-materialize-function-contracts

vm.target<core> @target

low.func.def target<vm.core>(@target) abi(vm_function) @narrow_integer_contract(%value: reg<vm.value : i8>) -> (reg<vm.value : i8>) where [ge(%value, -7)] asm {
  return %value
}

// ----
vm.target<core> @target

low.func.def target<vm.core>(@target) abi(vm_function) @narrow_integer_contract(%value: reg<vm.value : i8>) -> (reg<vm.value : i8>) asm {
  %2 = conversion.integer %value, s8.to.i32 : reg<vm.value : i32>
  %3 = constant.i32 4294967289 : reg<vm.value : i32>
  %4 = integer.compare.i32 %2, %3, sge : reg<vm.value : i1>
  %5 = ref.null : reg<vm.ref : buffer>
  control.assert %4, %5
  return %value
}

// ====

// RUN: pass vm-materialize-function-contracts

vm.target<core> @target

low.func.def target<vm.core>(@target) abi(vm_function) @integer_relations(%lhs: reg<vm.value : i32>, %rhs: reg<vm.value : i32>) -> (reg<vm.value : i32>) where [eq(%lhs, %rhs), ne(%lhs, %rhs), lt(%lhs, %rhs), le(%lhs, %rhs), gt(%lhs, %rhs), ge(%lhs, %rhs), min(%lhs, -4), max(%lhs, 1024)] asm {
  return %lhs
}

// ----
vm.target<core> @target

low.func.def target<vm.core>(@target) abi(vm_function) @integer_relations(%lhs: reg<vm.value : i32>, %rhs: reg<vm.value : i32>) -> (reg<vm.value : i32>) asm {
  %3 = integer.compare.i32 %lhs, %rhs, eq : reg<vm.value : i1>
  %4 = ref.null : reg<vm.ref : buffer>
  control.assert %3, %4
  %5 = integer.compare.i32 %lhs, %rhs, ne : reg<vm.value : i1>
  control.assert %5, %4
  %6 = integer.compare.i32 %lhs, %rhs, slt : reg<vm.value : i1>
  control.assert %6, %4
  %7 = integer.compare.i32 %lhs, %rhs, sle : reg<vm.value : i1>
  control.assert %7, %4
  %8 = integer.compare.i32 %lhs, %rhs, sgt : reg<vm.value : i1>
  control.assert %8, %4
  %9 = integer.compare.i32 %lhs, %rhs, sge : reg<vm.value : i1>
  control.assert %9, %4
  %10 = constant.i32 4294967292 : reg<vm.value : i32>
  %11 = integer.compare.i32 %lhs, %10, sge : reg<vm.value : i1>
  control.assert %11, %4
  %12 = constant.s16 1024 : reg<vm.value : i32>
  %13 = integer.compare.i32 %lhs, %12, sle : reg<vm.value : i1>
  control.assert %13, %4
  return %lhs
}

