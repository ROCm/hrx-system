// RUN: pass vm-materialize-function-contracts

vm.target<core> @target

low.func.def pure target<vm.core>(@target) abi(vm_function) @result_postcondition(%minimum: reg<vm.value : i32>) -> (%result: reg<vm.value : i32>) where [ge(%result, %minimum)] asm {
  return %minimum
}

// ----
vm.target<core> @target

low.func.def target<vm.core>(@target) abi(vm_function) @result_postcondition(%minimum: reg<vm.value : i32>) -> (%result: reg<vm.value : i32>) asm {
  %2 = integer.compare.i32 %minimum, %minimum, sge : reg<vm.value : i1>
  %3 = ref.null : reg<vm.ref : buffer>
  control.assert %2, %3
  return %minimum
}

// ====

// RUN: emit source-low output=low

vm.target<core> @target

func.def pure target(@target) @result_postconditions(%condition: i1, %minimum: i32, %alternate: i32) -> (%result: i32) where [ge(%minimum, 0), ge(%result, %minimum)] {
  cfg.cond_br %condition, ^minimum, ^alternate
^minimum:
  func.return %minimum : i32
^alternate:
  func.return %alternate : i32
}

// ----
low.func.def pure target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value : i1>, reg<vm.value : i32>, reg<vm.value : i32>) -> (reg<vm.value : i32>)>}) @result_postconditions(%condition: reg<vm.value : i1>, %minimum: reg<vm.value : i32>, %alternate: reg<vm.value : i32>) -> (%result: reg<vm.value : i32>) where [ge(%minimum, 0), ge(%result, %minimum)] asm {
  low.cond_br %condition, ^minimum, ^alternate : reg<vm.value : i1>
^minimum:
  return %minimum
^alternate:
  return %alternate
}
