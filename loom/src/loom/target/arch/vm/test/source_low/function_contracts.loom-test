// RUN: pass vm-materialize-function-contracts

vm.target<core> @target

low.func.def pure target<vm.core>(@target) abi(vm_function) @integer_contracts(%value: reg<vm.value : index>, %limit: reg<vm.value : index>) -> (reg<vm.value : index>) where [range(%value, 4, 4096), le(%value, %limit), mul(%value, 4), pow2(%value)] asm {
  return %value
}

// ----
vm.target<core> @target

low.func.def target<vm.core>(@target) abi(vm_function) @integer_contracts(%value: reg<vm.value : index>, %limit: reg<vm.value : index>) -> (reg<vm.value : index>) asm {
  %3 = constant.s16 4 : reg<vm.value : i64>
  %4 = constant.s16 4096 : reg<vm.value : i64>
  %5 = integer.compare.i64 %value, %3, sge : reg<vm.value : i1>
  %6 = ref.null : reg<vm.ref : buffer>
  control.assert %5, %6
  %7 = integer.compare.i64 %value, %4, sle : reg<vm.value : i1>
  control.assert %7, %6
  %8 = integer.compare.i64 %value, %limit, sle : reg<vm.value : i1>
  control.assert %8, %6
  %9 = constant.s16 4 : reg<vm.value : i64>
  %10 = constant.zero : reg<vm.value : i64>
  %11 = integer.compare.i64 %9, %10, ne : reg<vm.value : i1>
  control.assert %11, %6
  %12 = integer.rem.s64 %value, %9 : reg<vm.value : i64>
  %13 = integer.compare.i64 %12, %10, eq : reg<vm.value : i1>
  control.assert %13, %6
  %14 = constant.zero : reg<vm.value : i64>
  %15 = constant.s16 1 : reg<vm.value : i64>
  %16 = integer.compare.i64 %value, %14, sgt : reg<vm.value : i1>
  control.assert %16, %6
  %17 = integer.sub.i64 %value, %15 : reg<vm.value : i64>
  %18 = integer.and.i64 %value, %17 : reg<vm.value : i64>
  %19 = integer.compare.i64 %18, %14, eq : reg<vm.value : i1>
  control.assert %19, %6
  return %value
}

