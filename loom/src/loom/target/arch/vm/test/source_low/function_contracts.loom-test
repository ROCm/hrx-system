// RUN: pass vm-materialize-function-contracts

vm.target<core> @target

low.func.def target<vm.core>(@target) abi(vm_function) @narrow_integer_wide_contract(%value: reg<vm.value : i16>) -> (reg<vm.value : i16>) where [lt(%value, 2147483648)] asm {
  return %value
}

// ----
vm.target<core> @target

low.func.def target<vm.core>(@target) abi(vm_function) @narrow_integer_wide_contract(%value: reg<vm.value : i16>) -> (reg<vm.value : i16>) asm {
  %2 = conversion.integer %value, s16.to.i32 : reg<vm.value : i32>
  %3 = conversion.integer %2, s32.to.i64 : reg<vm.value : i64>
  %4 = constant.i32 2147483648 : reg<vm.value : i64>
  %5 = integer.compare.i64 %3, %4, slt : reg<vm.value : i1>
  control.assert %5
  return %value
}

// ====

// RUN: pass vm-materialize-function-contracts

vm.target<core> @target

low.func.def target<vm.core>(@target) abi(vm_function) @float_contracts(%narrow: reg<vm.value : bf16>, %wide: reg<vm.value : f64>) -> (reg<vm.value : bf16>) where [not_nan(%narrow), not_inf(%narrow), finite(%wide)] asm {
  return %narrow
}

// ----
vm.target<core> @target

low.func.def target<vm.core>(@target) abi(vm_function) @float_contracts(%narrow: reg<vm.value : bf16>, %wide: reg<vm.value : f64>) -> (reg<vm.value : bf16>) asm {
  %3 = conversion.float.extend %narrow, bf16.to.f32 : reg<vm.value : f32>
  %4 = float.classify.f32 %3, isnan : reg<vm.value : i1>
  %5 = constant.zero : reg<vm.value : i32>
  %6 = integer.compare.i32 %4, %5, eq : reg<vm.value : i1>
  control.assert %6
  %7 = conversion.float.extend %narrow, bf16.to.f32 : reg<vm.value : f32>
  %8 = float.classify.f32 %7, isinf : reg<vm.value : i1>
  %9 = constant.zero : reg<vm.value : i32>
  %10 = integer.compare.i32 %8, %9, eq : reg<vm.value : i1>
  control.assert %10
  %11 = float.classify.f64 %wide, isfinite : reg<vm.value : i1>
  control.assert %11
  return %narrow
}

// ====

// RUN: pass vm-materialize-function-contracts

vm.target<core> @target

low.func.def target<vm.core>(@target) abi(vm_function) @narrow_float_contracts(%e4m3: reg<vm.value : f8E4M3>, %e5m2: reg<vm.value : f8E5M2>, %half: reg<vm.value : f16>) -> (reg<vm.value : f16>) where [finite(%e4m3), finite(%e5m2), finite(%half)] asm {
  return %half
}

// ----
vm.target<core> @target

low.func.def target<vm.core>(@target) abi(vm_function) @narrow_float_contracts(%e4m3: reg<vm.value : f8E4M3>, %e5m2: reg<vm.value : f8E5M2>, %half: reg<vm.value : f16>) -> (reg<vm.value : f16>) asm {
  %4 = conversion.float.extend %e4m3, f8e4m3.to.f32 : reg<vm.value : f32>
  %5 = float.classify.f32 %4, isfinite : reg<vm.value : i1>
  control.assert %5
  %6 = conversion.float.extend %e5m2, f8e5m2.to.f32 : reg<vm.value : f32>
  %7 = float.classify.f32 %6, isfinite : reg<vm.value : i1>
  control.assert %7
  %8 = conversion.float.extend %half, f16.to.f32 : reg<vm.value : f32>
  %9 = float.classify.f32 %8, isfinite : reg<vm.value : i1>
  control.assert %9
  return %half
}

// ====

// RUN: pass vm-materialize-function-contracts,vm-materialize-call-abi,low-dce

vm.target<core> @target

low.func.def target<vm.core>(@target) abi(vm_function) @contract_precedes_call_abi(%value: reg<vm.value : index>) -> (reg<vm.value : index>) where [range(%value, 1, 64)] asm {
  return %value
}

// ----
vm.target<core> @target

low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = (reg<vm.value : index>) -> (reg<vm.value : index>)}) @contract_precedes_call_abi(%value: reg<vm.value : index>) -> (reg<vm.value : index>) asm {
  %6 = copy %value : reg<vm.value : index> -> reg<vm.value : index>
  %2 = constant.s16 1 : reg<vm.value : i64>
  %3 = constant.s16 64 : reg<vm.value : i64>
  %4 = integer.compare.i64 %6, %2, sge : reg<vm.value : i1>
  control.assert %4
  %5 = integer.compare.i64 %6, %3, sle : reg<vm.value : i1>
  control.assert %5
  %7 = copy %6 : reg<vm.value : index> -> reg<vm.value : index>
  return %7
}
