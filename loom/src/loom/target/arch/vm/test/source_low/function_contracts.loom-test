// RUN: pass vm-materialize-function-contracts

vm.target<core> @target

low.func.def pure target<vm.core>(@target) abi(vm_function) @integer_contracts(%value: reg<vm.value : index>, %limit: reg<vm.value : index>) -> (reg<vm.value : index>) where [range(%value, 4, 4096), le(%value, %limit), mul(%value, 4), pow2(%value)] asm {
  return %value
}

// ----
vm.target<core> @target

low.func.def target<vm.core>(@target) abi(vm_function) @integer_contracts(%value: reg<vm.value : index>, %limit: reg<vm.value : index>) -> (reg<vm.value : index>) asm {
  %3 = constant.s16 4 : reg<vm.value : i64>
  %4 = constant.s16 4096 : reg<vm.value : i64>
  %5 = integer.compare.i64 %value, %3, sge : reg<vm.value : i1>
  control.assert %5
  %6 = integer.compare.i64 %value, %4, sle : reg<vm.value : i1>
  control.assert %6
  %7 = integer.compare.i64 %value, %limit, sle : reg<vm.value : i1>
  control.assert %7
  %8 = constant.s16 4 : reg<vm.value : i64>
  %9 = constant.zero : reg<vm.value : i64>
  %10 = integer.compare.i64 %8, %9, ne : reg<vm.value : i1>
  control.assert %10
  %11 = integer.rem.s64 %value, %8 : reg<vm.value : i64>
  %12 = integer.compare.i64 %11, %9, eq : reg<vm.value : i1>
  control.assert %12
  %13 = constant.zero : reg<vm.value : i64>
  %14 = constant.s16 1 : reg<vm.value : i64>
  %15 = integer.compare.i64 %value, %13, sgt : reg<vm.value : i1>
  control.assert %15
  %16 = integer.sub.i64 %value, %14 : reg<vm.value : i64>
  %17 = integer.and.i64 %value, %16 : reg<vm.value : i64>
  %18 = integer.compare.i64 %17, %13, eq : reg<vm.value : i1>
  control.assert %18
  return %value
}

// ====

// RUN: pass vm-materialize-function-contracts

vm.target<core> @target

low.func.def target<vm.core>(@target) abi(vm_function) @narrow_integer_contract(%value: reg<vm.value : i8>) -> (reg<vm.value : i8>) where [ge(%value, -7)] asm {
  return %value
}

// ----
vm.target<core> @target

low.func.def target<vm.core>(@target) abi(vm_function) @narrow_integer_contract(%value: reg<vm.value : i8>) -> (reg<vm.value : i8>) asm {
  %2 = conversion.integer %value, s8.to.i32 : reg<vm.value : i32>
  %3 = constant.i32 4294967289 : reg<vm.value : i32>
  %4 = integer.compare.i32 %2, %3, sge : reg<vm.value : i1>
  control.assert %4
  return %value
}

// ====

// RUN: pass vm-materialize-function-contracts

vm.target<core> @target

low.func.def target<vm.core>(@target) abi(vm_function) @integer_relations(%lhs: reg<vm.value : i32>, %rhs: reg<vm.value : i32>) -> (reg<vm.value : i32>) where [eq(%lhs, %rhs), ne(%lhs, %rhs), lt(%lhs, %rhs), le(%lhs, %rhs), gt(%lhs, %rhs), ge(%lhs, %rhs), min(%lhs, -4), max(%lhs, 1024)] asm {
  return %lhs
}

// ----
vm.target<core> @target

low.func.def target<vm.core>(@target) abi(vm_function) @integer_relations(%lhs: reg<vm.value : i32>, %rhs: reg<vm.value : i32>) -> (reg<vm.value : i32>) asm {
  %3 = integer.compare.i32 %lhs, %rhs, eq : reg<vm.value : i1>
  control.assert %3
  %4 = integer.compare.i32 %lhs, %rhs, ne : reg<vm.value : i1>
  control.assert %4
  %5 = integer.compare.i32 %lhs, %rhs, slt : reg<vm.value : i1>
  control.assert %5
  %6 = integer.compare.i32 %lhs, %rhs, sle : reg<vm.value : i1>
  control.assert %6
  %7 = integer.compare.i32 %lhs, %rhs, sgt : reg<vm.value : i1>
  control.assert %7
  %8 = integer.compare.i32 %lhs, %rhs, sge : reg<vm.value : i1>
  control.assert %8
  %9 = constant.i32 4294967292 : reg<vm.value : i32>
  %10 = integer.compare.i32 %lhs, %9, sge : reg<vm.value : i1>
  control.assert %10
  %11 = constant.s16 1024 : reg<vm.value : i32>
  %12 = integer.compare.i32 %lhs, %11, sle : reg<vm.value : i1>
  control.assert %12
  return %lhs
}

