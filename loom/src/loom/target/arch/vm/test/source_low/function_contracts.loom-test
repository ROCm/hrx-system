// RUN: pass vm-materialize-function-contracts

vm.target<core> @target

low.func.def target<vm.core>(@target) abi(vm_function) @narrow_integer_wide_contract(%value: reg<vm.value : i16>) -> (reg<vm.value : i16>) where [lt(%value, 2147483648)] asm {
  return %value
}

// ----
vm.target<core> @target

low.func.def target<vm.core>(@target) abi(vm_function) @narrow_integer_wide_contract(%value: reg<vm.value : i16>) -> (reg<vm.value : i16>) asm {
  %2 = conversion.integer %value, s16.to.i32 : reg<vm.value : i32>
  %3 = conversion.integer %2, s32.to.i64 : reg<vm.value : i64>
  %4 = constant.i32 2147483648 : reg<vm.value : i64>
  %5 = integer.compare.i64 %3, %4, slt : reg<vm.value : i1>
  %6 = ref.null : reg<vm.ref : buffer>
  control.assert %5, %6
  return %value
}

// ====

// RUN: pass vm-materialize-function-contracts

vm.target<core> @target

low.func.def target<vm.core>(@target) abi(vm_function) @float_contracts(%narrow: reg<vm.value : bf16>, %wide: reg<vm.value : f64>) -> (%result: reg<vm.value : bf16>) where [not_nan(%narrow), not_inf(%narrow), finite(%wide), finite(%result)] asm {
  return %narrow
}

// ----
vm.target<core> @target

low.func.def target<vm.core>(@target) abi(vm_function) @float_contracts(%narrow: reg<vm.value : bf16>, %wide: reg<vm.value : f64>) -> (%result: reg<vm.value : bf16>) asm {
  %3 = conversion.float.extend %narrow, bf16.to.f32 : reg<vm.value : f32>
  %4 = float.classify.f32 %3, isnan : reg<vm.value : i1>
  %5 = constant.zero : reg<vm.value : i32>
  %6 = integer.compare.i32 %4, %5, eq : reg<vm.value : i1>
  %7 = ref.null : reg<vm.ref : buffer>
  control.assert %6, %7
  %8 = conversion.float.extend %narrow, bf16.to.f32 : reg<vm.value : f32>
  %9 = float.classify.f32 %8, isinf : reg<vm.value : i1>
  %10 = constant.zero : reg<vm.value : i32>
  %11 = integer.compare.i32 %9, %10, eq : reg<vm.value : i1>
  control.assert %11, %7
  %12 = float.classify.f64 %wide, isfinite : reg<vm.value : i1>
  control.assert %12, %7
  %13 = conversion.float.extend %narrow, bf16.to.f32 : reg<vm.value : f32>
  %14 = float.classify.f32 %13, isfinite : reg<vm.value : i1>
  %15 = ref.null : reg<vm.ref : buffer>
  control.assert %14, %15
  return %narrow
}

