// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_boolean_comparison.loom-test
// RUN: emit source-low target=vm:core output=low

func.def public @boolean_comparisons(%left: i32, %right: i32) -> (i32) {
  %c0 = scalar.constant 0 : i32
  %lhs = scalar.cmpi ne, %left, %c0 : i32
  %rhs = scalar.cmpi ne, %right, %c0 : i32
  %eq = scalar.cmpi eq, %lhs, %rhs : i1
  %eq_bit = scalar.extui %eq : i1 to i32
  %ne = scalar.cmpi ne, %lhs, %rhs : i1
  %ne_bit = scalar.extui %ne : i1 to i32
  %shift_1 = scalar.constant 1 : i32
  %ne_shifted = scalar.shli %ne_bit, %shift_1 : i32
  %mask_1 = scalar.ori %eq_bit, %ne_shifted : i32
  %slt = scalar.cmpi slt, %lhs, %rhs : i1
  %slt_bit = scalar.extui %slt : i1 to i32
  %shift_2 = scalar.constant 2 : i32
  %slt_shifted = scalar.shli %slt_bit, %shift_2 : i32
  %mask_2 = scalar.ori %mask_1, %slt_shifted : i32
  %sle = scalar.cmpi sle, %lhs, %rhs : i1
  %sle_bit = scalar.extui %sle : i1 to i32
  %shift_3 = scalar.constant 3 : i32
  %sle_shifted = scalar.shli %sle_bit, %shift_3 : i32
  %mask_3 = scalar.ori %mask_2, %sle_shifted : i32
  %sgt = scalar.cmpi sgt, %lhs, %rhs : i1
  %sgt_bit = scalar.extui %sgt : i1 to i32
  %shift_4 = scalar.constant 4 : i32
  %sgt_shifted = scalar.shli %sgt_bit, %shift_4 : i32
  %mask_4 = scalar.ori %mask_3, %sgt_shifted : i32
  %sge = scalar.cmpi sge, %lhs, %rhs : i1
  %sge_bit = scalar.extui %sge : i1 to i32
  %shift_5 = scalar.constant 5 : i32
  %sge_shifted = scalar.shli %sge_bit, %shift_5 : i32
  %mask_5 = scalar.ori %mask_4, %sge_shifted : i32
  %ult = scalar.cmpi ult, %lhs, %rhs : i1
  %ult_bit = scalar.extui %ult : i1 to i32
  %shift_6 = scalar.constant 6 : i32
  %ult_shifted = scalar.shli %ult_bit, %shift_6 : i32
  %mask_6 = scalar.ori %mask_5, %ult_shifted : i32
  %ule = scalar.cmpi ule, %lhs, %rhs : i1
  %ule_bit = scalar.extui %ule : i1 to i32
  %shift_7 = scalar.constant 7 : i32
  %ule_shifted = scalar.shli %ule_bit, %shift_7 : i32
  %mask_7 = scalar.ori %mask_6, %ule_shifted : i32
  %ugt = scalar.cmpi ugt, %lhs, %rhs : i1
  %ugt_bit = scalar.extui %ugt : i1 to i32
  %shift_8 = scalar.constant 8 : i32
  %ugt_shifted = scalar.shli %ugt_bit, %shift_8 : i32
  %mask_8 = scalar.ori %mask_7, %ugt_shifted : i32
  %uge = scalar.cmpi uge, %lhs, %rhs : i1
  %uge_bit = scalar.extui %uge : i1 to i32
  %shift_9 = scalar.constant 9 : i32
  %uge_shifted = scalar.shli %uge_bit, %shift_9 : i32
  %mask_9 = scalar.ori %mask_8, %uge_shifted : i32
  func.return %mask_9 : i32
}

// ----
low.func.def public target<vm.core> abi(vm_function) @boolean_comparisons(%left: reg<vm.value : i32>, %right: reg<vm.value : i32>) -> (reg<vm.value : i32>) asm {
  %c0 = constant.i32 0
  %lhs = integer.compare.i32 %left, %c0, "ne"
  %rhs = integer.compare.i32 %right, %c0, "ne"
  %87 = integer.xor.i32 %lhs, %rhs : reg<vm.value : i1>
  %88 = constant.i32 1 : reg<vm.value : i1>
  %eq = integer.xor.i32 %87, %88 : reg<vm.value : i1>
  %eq_bit = conversion.integer %eq, "u1.to.i32" : reg<vm.value : i32>
  %ne_bit = conversion.integer %87, "u1.to.i32" : reg<vm.value : i32>
  %shift_1 = constant.i32 1
  %ne_shifted = integer.shift.left.i32 %ne_bit, %shift_1
  %mask_1 = integer.or.i32 %eq_bit, %ne_shifted
  %95 = integer.xor.i32 %rhs, %88 : reg<vm.value : i1>
  %slt = integer.and.i32 %95, %lhs : reg<vm.value : i1>
  %slt_bit = conversion.integer %slt, "u1.to.i32" : reg<vm.value : i32>
  %shift_2 = constant.i32 2
  %slt_shifted = integer.shift.left.i32 %slt_bit, %shift_2
  %mask_2 = integer.or.i32 %mask_1, %slt_shifted
  %sle = integer.or.i32 %95, %lhs : reg<vm.value : i1>
  %sle_bit = conversion.integer %sle, "u1.to.i32" : reg<vm.value : i32>
  %shift_3 = constant.i32 3
  %sle_shifted = integer.shift.left.i32 %sle_bit, %shift_3
  %mask_3 = integer.or.i32 %mask_2, %sle_shifted
  %106 = integer.xor.i32 %lhs, %88 : reg<vm.value : i1>
  %sgt = integer.and.i32 %106, %rhs : reg<vm.value : i1>
  %sgt_bit = conversion.integer %sgt, "u1.to.i32" : reg<vm.value : i32>
  %shift_4 = constant.i32 4
  %sgt_shifted = integer.shift.left.i32 %sgt_bit, %shift_4
  %mask_4 = integer.or.i32 %mask_3, %sgt_shifted
  %sge = integer.or.i32 %106, %rhs : reg<vm.value : i1>
  %sge_bit = conversion.integer %sge, "u1.to.i32" : reg<vm.value : i32>
  %shift_5 = constant.i32 5
  %sge_shifted = integer.shift.left.i32 %sge_bit, %shift_5
  %mask_5 = integer.or.i32 %mask_4, %sge_shifted
  %shift_6 = constant.i32 6
  %ult_shifted = integer.shift.left.i32 %sgt_bit, %shift_6
  %mask_6 = integer.or.i32 %mask_5, %ult_shifted
  %shift_7 = constant.i32 7
  %ule_shifted = integer.shift.left.i32 %sge_bit, %shift_7
  %mask_7 = integer.or.i32 %mask_6, %ule_shifted
  %shift_8 = constant.i32 8
  %ugt_shifted = integer.shift.left.i32 %slt_bit, %shift_8
  %mask_8 = integer.or.i32 %mask_7, %ugt_shifted
  %shift_9 = constant.i32 9
  %uge_shifted = integer.shift.left.i32 %sle_bit, %shift_9
  %mask_9 = integer.or.i32 %mask_8, %uge_shifted
  return %mask_9
}

// ====

func.def public @boolean_constants() -> (i1, i1) {
  %false = scalar.constant false : i1
  %true = scalar.constant true : i1
  func.return %false, %true : i1, i1
}

// ----
low.func.def public target<vm.core> abi(vm_function) @boolean_constants() -> (reg<vm.value : i1>, reg<vm.value : i1>) asm {
  %false = constant.i32 0 : reg<vm.value : i1>
  %true = constant.i32 1 : reg<vm.value : i1>
  return %false, %true
}

// ====

func.def public @boolean_algebra(%lhs: i1, %rhs: i1) -> (i1, i1, i1) {
  %and = scalar.andi %lhs, %rhs : i1
  %or = scalar.ori %lhs, %rhs : i1
  %xor = scalar.xori %lhs, %rhs : i1
  func.return %and, %or, %xor : i1, i1, i1
}

// ----
low.func.def public target<vm.core> abi(vm_function) @boolean_algebra(%lhs: reg<vm.value : i1>, %rhs: reg<vm.value : i1>) -> (reg<vm.value : i1>, reg<vm.value : i1>, reg<vm.value : i1>) asm {
  %and = integer.and.i32 %lhs, %rhs : reg<vm.value : i1>
  %or = integer.or.i32 %lhs, %rhs : reg<vm.value : i1>
  %xor = integer.xor.i32 %lhs, %rhs : reg<vm.value : i1>
  return %and, %or, %xor
}

// ====

func.def public @boolean_unsigned_extensions(%input: i1) -> (i32, i64) {
  %word = scalar.extui %input : i1 to i32
  %wide = scalar.extui %input : i1 to i64
  func.return %word, %wide : i32, i64
}

// ----
low.func.def public target<vm.core> abi(vm_function) @boolean_unsigned_extensions(%input: reg<vm.value : i1>) -> (reg<vm.value : i32>, reg<vm.value : i64>) asm {
  %word = conversion.integer %input, "u1.to.i32" : reg<vm.value : i32>
  %wide = conversion.integer %input, "u1.to.i64"
  return %word, %wide
}
