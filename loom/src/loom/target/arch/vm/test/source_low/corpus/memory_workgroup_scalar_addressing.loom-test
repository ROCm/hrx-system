low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value : i32>, reg<vm.value : index>, reg<vm.value : index>, reg<vm.value : index>) -> (reg<vm.value : i32>)>}) @workgroup_dynamic_stride_rank2_i32(%value: reg<vm.value : i32>, %column_count_bounded: reg<vm.value : index>, %row_bounded: reg<vm.value : index>, %column_bounded: reg<vm.value : index>) -> (reg<vm.value : i32>) asm {
  %byte_length = constant.s16 128 : reg<vm.value : offset>
  %scratch = buffer.allocate %byte_length, 2 : reg<vm.ref : buffer>
  %20 = integer.mul.i64 %row_bounded, %column_count_bounded : reg<vm.value : offset>
  %21 = constant.s16 2 : reg<vm.value : offset>
  %22 = integer.shift.left.i64 %20, %21 : reg<vm.value : offset>
  %24 = integer.shift.left.i64 %column_bounded, %21 : reg<vm.value : offset>
  %25 = integer.add.i64 %22, %24 : reg<vm.value : offset>
  %26 = constant.zero : reg<vm.value : offset>
  buffer.store %scratch, %25, %26, %value, 0, i32.x1
  %loaded = buffer.load %scratch, %25, %26, 0, i32.x1 : reg<vm.value : i32>
  return %loaded
}

