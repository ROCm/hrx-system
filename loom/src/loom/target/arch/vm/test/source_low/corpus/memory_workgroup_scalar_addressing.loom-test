vm.target<core> @target
func.def target(@target) @workgroup_float_scalar_widths(%value_f16: f16, %value_bf16: bf16, %value_f32: f32, %value_f64: f64) -> (f16, bf16, f32, f64) {
  %byte_length = index.constant 16 : offset
  %scratch_base = index.constant 0 : offset
  %scratch_f16 = buffer.alloca<workgroup> align(2) %byte_length : buffer
  %scratch_bf16 = buffer.alloca<workgroup> align(2) %byte_length : buffer
  %scratch_f32 = buffer.alloca<workgroup> align(4) %byte_length : buffer
  %scratch_f64 = buffer.alloca<workgroup> align(8) %byte_length : buffer
  %view_f16 = buffer.view %scratch_f16[%scratch_base] : buffer -> view<2xf16>
  %view_bf16 = buffer.view %scratch_bf16[%scratch_base] : buffer -> view<2xbf16>
  %view_f32 = buffer.view %scratch_f32[%scratch_base] : buffer -> view<2xf32>
  %view_f64 = buffer.view %scratch_f64[%scratch_base] : buffer -> view<2xf64>
  view.store %value_f16, %view_f16[1] : f16, view<2xf16>
  view.store %value_bf16, %view_bf16[1] : bf16, view<2xbf16>
  view.store %value_f32, %view_f32[1] : f32, view<2xf32>
  view.store %value_f64, %view_f64[1] : f64, view<2xf64>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %loaded_f16 = view.load %view_f16[1] : view<2xf16> -> f16
  %loaded_bf16 = view.load %view_bf16[1] : view<2xbf16> -> bf16
  %loaded_f32 = view.load %view_f32[1] : view<2xf32> -> f32
  %loaded_f64 = view.load %view_f64[1] : view<2xf64> -> f64
  func.return %loaded_f16, %loaded_bf16, %loaded_f32, %loaded_f64 : f16, bf16, f32, f64
}

