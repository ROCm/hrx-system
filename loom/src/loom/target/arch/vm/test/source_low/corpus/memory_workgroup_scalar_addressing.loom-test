low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value : i32>, reg<vm.value : index>) -> (reg<vm.value : i32>)>}) @workgroup_subview_refine_i32(%value: reg<vm.value : i32>, %element_bounded: reg<vm.value : index>) -> (reg<vm.value : i32>) asm {
  %byte_length = constant.s16 64 : reg<vm.value : offset>
  %scratch_refined = buffer.allocate %byte_length, 2 : reg<vm.ref : buffer>
  %16 = constant.s16 12 : reg<vm.value : offset>
  buffer.store %scratch_refined, %16, %element_bounded, %value, 4, i32.x1
  %loaded = buffer.load %scratch_refined, %16, %element_bounded, 4, i32.x1 : reg<vm.value : i32>
  return %loaded
}

