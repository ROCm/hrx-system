low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value : f16>, reg<vm.value : bf16>, reg<vm.value : f32>, reg<vm.value : f64>) -> (reg<vm.value : f16>, reg<vm.value : bf16>, reg<vm.value : f32>, reg<vm.value : f64>)>}) @workgroup_float_scalar_widths(%value_f16: reg<vm.value : f16>, %value_bf16: reg<vm.value : bf16>, %value_f32: reg<vm.value : f32>, %value_f64: reg<vm.value : f64>) -> (reg<vm.value : f16>, reg<vm.value : bf16>, reg<vm.value : f32>, reg<vm.value : f64>) asm {
