vm.target<core> @target
func.def target(@target) @workgroup_static_rank2_i32(%value: i32) -> (i32) {
  %byte_length = index.constant 256 : offset
  %base = index.constant 8 : offset
  %scratch = buffer.alloca<workgroup> align(4) %byte_length : buffer
  %scratch_view = buffer.view %scratch[%base] : buffer -> view<4x8xi32>
  view.store %value, %scratch_view[2, 3] : i32, view<4x8xi32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %loaded = view.load %scratch_view[2, 3] : view<4x8xi32> -> i32
  func.return %loaded : i32
}

// ----
low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value : i32>) -> (reg<vm.value : i32>)>}) @workgroup_static_rank2_i32(%value: reg<vm.value : i32>) -> (reg<vm.value : i32>) asm {
  %byte_length = constant.s16 256 : reg<vm.value : offset>
  %scratch = buffer.allocate %byte_length, 2 : reg<vm.ref : buffer>
  %13 = constant.zero : reg<vm.value : offset>
  %14 = constant.s16 84 : reg<vm.value : offset>
  buffer.store %scratch, %14, %13, %value, 0, i32.x1
  %loaded = buffer.load %scratch, %14, %13, 0, i32.x1 : reg<vm.value : i32>
  return %loaded
}

