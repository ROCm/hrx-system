  %scratch_bf16 = buffer.allocate %byte_length, 1 : reg<vm.ref : buffer>
  %scratch_f32 = buffer.allocate %byte_length, 2 : reg<vm.ref : buffer>
  %scratch_f64 = buffer.allocate %byte_length, 3 : reg<vm.ref : buffer>
  %35 = constant.zero : reg<vm.value : offset>
  %36 = constant.s16 2 : reg<vm.value : offset>
  buffer.store %scratch_f16, %36, %35, %value_f16, 0, i16.x1
  buffer.store %scratch_bf16, %36, %35, %value_bf16, 0, i16.x1
  %40 = constant.s16 4 : reg<vm.value : offset>
  buffer.store %scratch_f32, %40, %35, %value_f32, 0, i32.x1
  %42 = constant.s16 8 : reg<vm.value : offset>
  buffer.store %scratch_f64, %42, %35, %value_f64, 0, i64.x1
  %loaded_f16 = buffer.load %scratch_f16, %36, %35, 0, i16.x1 : reg<vm.value : f16>
  %loaded_bf16 = buffer.load %scratch_bf16, %36, %35, 0, i16.x1 : reg<vm.value : bf16>
  %loaded_f32 = buffer.load %scratch_f32, %40, %35, 0, i32.x1 : reg<vm.value : f32>
  %loaded_f64 = buffer.load %scratch_f64, %42, %35, 0, i64.x1 : reg<vm.value : f64>
  return %loaded_f16, %loaded_bf16, %loaded_f32, %loaded_f64
