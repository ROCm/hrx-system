low.func.def target<vm.core>(@target) abi(vm_function) abi_layout({signature = type<(reg<vm.value : i8>, reg<vm.value : i16>, reg<vm.value : i32>, reg<vm.value : i64>) -> (reg<vm.value : i8>, reg<vm.value : i16>, reg<vm.value : i32>, reg<vm.value : i64>)>}) @workgroup_integer_scalar_widths(%value_i8: reg<vm.value : i8>, %value_i16: reg<vm.value : i16>, %value_i32: reg<vm.value : i32>, %value_i64: reg<vm.value : i64>) -> (reg<vm.value : i8>, reg<vm.value : i16>, reg<vm.value : i32>, reg<vm.value : i64>) asm {
  %byte_length = constant.s16 16 : reg<vm.value : offset>
  %scratch_i8 = buffer.allocate %byte_length, 0 : reg<vm.ref : buffer>
  %scratch_i16 = buffer.allocate %byte_length, 1 : reg<vm.ref : buffer>
  %scratch_i32 = buffer.allocate %byte_length, 2 : reg<vm.ref : buffer>
  %scratch_i64 = buffer.allocate %byte_length, 3 : reg<vm.ref : buffer>
  %35 = constant.zero : reg<vm.value : offset>
  %36 = constant.s16 1 : reg<vm.value : offset>
  buffer.store %scratch_i8, %36, %35, %value_i8, 0, i8.x1
  %38 = constant.s16 2 : reg<vm.value : offset>
  buffer.store %scratch_i16, %38, %35, %value_i16, 0, i16.x1
  %40 = constant.s16 4 : reg<vm.value : offset>
  buffer.store %scratch_i32, %40, %35, %value_i32, 0, i32.x1
  %42 = constant.s16 8 : reg<vm.value : offset>
  buffer.store %scratch_i64, %42, %35, %value_i64, 0, i64.x1
  %loaded_i8 = buffer.load %scratch_i8, %36, %35, 0, i8.x1 : reg<vm.value : i8>
  %loaded_i16 = buffer.load %scratch_i16, %38, %35, 0, i16.x1 : reg<vm.value : i16>
  %loaded_i32 = buffer.load %scratch_i32, %40, %35, 0, i32.x1 : reg<vm.value : i32>
  %loaded_i64 = buffer.load %scratch_i64, %42, %35, 0, i64.x1 : reg<vm.value : i64>
  return %loaded_i8, %loaded_i16, %loaded_i32, %loaded_i64
}

