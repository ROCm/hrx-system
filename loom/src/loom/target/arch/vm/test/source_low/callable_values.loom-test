func.def public @call_loop(%input: vector<1xi32>, %delta: i32, %count: index) -> (i32) {
  %values = func.call @repeat_add(%input, %delta, %count) : (vector<1xi32>, i32, index) -> (vector<1xi32>)
  %result = vector.extract %values[0] : vector<1xi32> -> i32
  func.return %result : i32
}

func.def @repeat_add(%values: vector<1xi32>, %delta: i32, %count: index) -> (vector<1xi32>) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %result = scf.for %i = [%c0 to %count step %c1](%current = %values : vector<1xi32>) -> (vector<1xi32>) {
    %current_value = vector.extract %current[0] : vector<1xi32> -> i32
    %next_value = func.call @advance_i32(%current_value, %delta) : (i32, i32) -> (i32)
    %next = vector.from_elements %next_value : vector<1xi32>
    scf.yield %next : vector<1xi32>
  }
  func.return %result : vector<1xi32>
}

func.def @advance_i32(%value: i32, %delta: i32) -> (i32) {
  %result = scalar.addi %value, %delta : i32
  func.return %result : i32
}

// ----
low.func.def public target<vm.core> abi(vm_function) @call_loop(%50: reg<vm.value : i32>, %delta: reg<vm.value : i32>, %count: reg<vm.value : i64>) -> (reg<vm.value : i32>) asm {
  %54 = low.func.call pure @repeat_add(%50, %delta, %count) : (reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i64>) -> (reg<vm.value : i32>)
  return %54
}

low.func.def target<vm.core> @repeat_add(%55: reg<vm.value : i32>, %delta: reg<vm.value : i32>, %count: reg<vm.value : i64>) -> (reg<vm.value : i32>) asm {
  %c0 = constant.i64 0
  %c1 = constant.i64 1
  low.br ^_bb1(%c0: reg<vm.value : i64>, %55: reg<vm.value : i32>)
^_bb1(%i: reg<vm.value : i64>, %current_slot_0: reg<vm.value : i32>):
  %63 = integer.compare.i64 %i, %count, "slt"
  low.cond_br %63, ^_bb2, ^_bb3 : reg<vm.value : i1>
^_bb2:
  %next_value = low.func.call pure @advance_i32(%current_slot_0, %delta) : (reg<vm.value : i32>, reg<vm.value : i32>) -> (reg<vm.value : i32>)
  %65 = integer.add.i64 %i, %c1
  low.br ^_bb1(%65: reg<vm.value : i64>, %next_value: reg<vm.value : i32>)
^_bb3:
  return %current_slot_0
}

low.func.def target<vm.core> @advance_i32(%value: reg<vm.value : i32>, %delta: reg<vm.value : i32>) -> (reg<vm.value : i32>) asm {
  %result = integer.add.i32 %value, %delta
  return %result
}

