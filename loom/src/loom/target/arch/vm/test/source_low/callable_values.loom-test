func.def public @call_scalar(%value: i32, %delta: i32) -> (i32) {
  %result = func.call @scalar_add(%value, %delta) : (i32, i32) -> (i32)
  func.return %result : i32
}

func.def @scalar_add(%value: i32, %delta: i32) -> (i32) {
  %result = scalar.addi %value, %delta : i32
  func.return %result : i32
}

// ----
low.func.def public target<vm.core> abi(vm_function) @call_scalar(%value: reg<vm.value : i32>, %delta: reg<vm.value : i32>) -> (reg<vm.value : i32>) asm {
  %result = low.func.call pure @scalar_add(%value, %delta) : (reg<vm.value : i32>, reg<vm.value : i32>) -> (reg<vm.value : i32>)
  return %result
}

low.func.def target<vm.core> @scalar_add(%value: reg<vm.value : i32>, %delta: reg<vm.value : i32>) -> (reg<vm.value : i32>) asm {
  %result = integer.add.i32 %value, %delta
  return %result
}
