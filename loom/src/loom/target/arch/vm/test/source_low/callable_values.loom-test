// Every scalar value representation admitted by VM remains available when a
// singleton vector crosses an ordinary call boundary.
func.def public @call_integer_vector_family(%predicate: i1, %byte: i8, %half: i16, %word: i32, %wide: i64, %position: index, %address: offset) -> (i1, i8, i16, i32, i64, index, offset) {
  %predicate_vector = vector.from_elements %predicate : vector<1xi1>
  %byte_vector = vector.from_elements %byte : vector<1xi8>
  %half_vector = vector.from_elements %half : vector<1xi16>
  %word_vector = vector.from_elements %word : vector<1xi32>
  %wide_vector = vector.from_elements %wide : vector<1xi64>
  %position_vector = vector.from_elements %position : vector<1xindex>
  %address_vector = vector.from_elements %address : vector<1xoffset>
  %predicate_result, %byte_result, %half_result, %word_result, %wide_result, %position_result, %address_result = func.call @identity_integer_vectors(%predicate_vector, %byte_vector, %half_vector, %word_vector, %wide_vector, %position_vector, %address_vector) : (vector<1xi1>, vector<1xi8>, vector<1xi16>, vector<1xi32>, vector<1xi64>, vector<1xindex>, vector<1xoffset>) -> (vector<1xi1>, vector<1xi8>, vector<1xi16>, vector<1xi32>, vector<1xi64>, vector<1xindex>, vector<1xoffset>)
  %predicate_value = vector.extract %predicate_result[0] : vector<1xi1> -> i1
  %byte_value = vector.extract %byte_result[0] : vector<1xi8> -> i8
  %half_value = vector.extract %half_result[0] : vector<1xi16> -> i16
  %word_value = vector.extract %word_result[0] : vector<1xi32> -> i32
  %wide_value = vector.extract %wide_result[0] : vector<1xi64> -> i64
  %position_value = vector.extract %position_result[0] : vector<1xindex> -> index
  %address_value = vector.extract %address_result[0] : vector<1xoffset> -> offset
  func.return %predicate_value, %byte_value, %half_value, %word_value, %wide_value, %position_value, %address_value : i1, i8, i16, i32, i64, index, offset
}

func.def noinline @identity_integer_vectors(%predicate: vector<1xi1>, %byte: vector<1xi8>, %half: vector<1xi16>, %word: vector<1xi32>, %wide: vector<1xi64>, %position: vector<1xindex>, %address: vector<1xoffset>) -> (vector<1xi1>, vector<1xi8>, vector<1xi16>, vector<1xi32>, vector<1xi64>, vector<1xindex>, vector<1xoffset>) {
  func.return %predicate, %byte, %half, %word, %wide, %position, %address : vector<1xi1>, vector<1xi8>, vector<1xi16>, vector<1xi32>, vector<1xi64>, vector<1xindex>, vector<1xoffset>
}

