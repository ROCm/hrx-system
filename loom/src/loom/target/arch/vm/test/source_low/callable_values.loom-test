func.def public @call_float_vector_family(%e4m3: f8E4M3, %e5m2: f8E5M2, %half: f16, %brain: bf16, %single: f32, %double: f64) -> (f8E4M3, f8E5M2, f16, bf16, f32, f64) {
  %e4m3_vector = vector.from_elements %e4m3 : vector<1xf8E4M3>
  %e5m2_vector = vector.from_elements %e5m2 : vector<1xf8E5M2>
  %half_vector = vector.from_elements %half : vector<1xf16>
  %brain_vector = vector.from_elements %brain : vector<1xbf16>
  %single_vector = vector.from_elements %single : vector<1xf32>
  %double_vector = vector.from_elements %double : vector<1xf64>
  %e4m3_result, %e5m2_result, %half_result, %brain_result, %single_result, %double_result = func.call @identity_float_vectors(%e4m3_vector, %e5m2_vector, %half_vector, %brain_vector, %single_vector, %double_vector) : (vector<1xf8E4M3>, vector<1xf8E5M2>, vector<1xf16>, vector<1xbf16>, vector<1xf32>, vector<1xf64>) -> (vector<1xf8E4M3>, vector<1xf8E5M2>, vector<1xf16>, vector<1xbf16>, vector<1xf32>, vector<1xf64>)
  %e4m3_value = vector.extract %e4m3_result[0] : vector<1xf8E4M3> -> f8E4M3
  %e5m2_value = vector.extract %e5m2_result[0] : vector<1xf8E5M2> -> f8E5M2
  %half_value = vector.extract %half_result[0] : vector<1xf16> -> f16
  %brain_value = vector.extract %brain_result[0] : vector<1xbf16> -> bf16
  %single_value = vector.extract %single_result[0] : vector<1xf32> -> f32
  %double_value = vector.extract %double_result[0] : vector<1xf64> -> f64
  func.return %e4m3_value, %e5m2_value, %half_value, %brain_value, %single_value, %double_value : f8E4M3, f8E5M2, f16, bf16, f32, f64
}

func.def noinline @identity_float_vectors(%e4m3: vector<1xf8E4M3>, %e5m2: vector<1xf8E5M2>, %half: vector<1xf16>, %brain: vector<1xbf16>, %single: vector<1xf32>, %double: vector<1xf64>) -> (vector<1xf8E4M3>, vector<1xf8E5M2>, vector<1xf16>, vector<1xbf16>, vector<1xf32>, vector<1xf64>) {
