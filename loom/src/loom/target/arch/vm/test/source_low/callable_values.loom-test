// ====

// Declarations and definitions project the same signature independently so
// ordinary IR linking retains the scalar VM call contract.
func.def public @call_external_vector(%a: i32, %b: i32, %c: i32) -> (i32, i32, i32) {
  %values = vector.from_elements %a, %b, %c : vector<3xi32>
  %result = func.call @external_identity_i32x3(%values) : (vector<3xi32>) -> (vector<3xi32>)
  %r0 = vector.extract %result[0] : vector<3xi32> -> i32
  %r1 = vector.extract %result[1] : vector<3xi32> -> i32
  %r2 = vector.extract %result[2] : vector<3xi32> -> i32
  func.return %r0, %r1, %r2 : i32, i32, i32
}

func.decl @external_identity_i32x3(%values: vector<3xi32>) -> (vector<3xi32>)

