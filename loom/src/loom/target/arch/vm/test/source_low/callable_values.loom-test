low.func.def public target<vm.core> abi(vm_function) @call_vector_result(%input: reg<vm.value : i32>) -> (reg<vm.value : i32>, reg<vm.value : i32>) asm {
  %c1 = constant.i32 1
  %c2 = constant.i32 2
  %c3 = constant.i32 3
  %39, %40, %41, %42 = low.func.call pure @identity_i32x4(%input, %c1, %c2, %c3) : (reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>) -> (reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>)
  return %39, %42
}

