low.func.def public target<vm.core> abi(vm_function) @call_external_vector(%a: reg<vm.value : i32>, %b: reg<vm.value : i32>, %c: reg<vm.value : i32>) -> (reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>) asm {
  %38, %39, %40 = low.func.call @external_identity_i32x3(%a, %b, %c) : (reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>) -> (reg<vm.value : i32>, reg<vm.value : i32>, reg<vm.value : i32>)
  return %38, %39, %40
}

