// RUN: emit source-low target=vm:core output=low

func.def public @call_mixed_i32(%input: vector<1xi32>, %delta: i32) -> (i32, i32) {
  %value = vector.extract %input[0] : vector<1xi32> -> i32
  %mixed = func.call @add_i32(%value, %delta) : (i32, i32) -> (i32)
  %uniform = func.call @add_i32(%delta, %delta) : (i32, i32) -> (i32)
  func.return %mixed, %uniform : i32, i32
}

func.def @add_i32(%value: i32, %delta: i32) -> (i32) {
  %wide_value = scalar.extui %value : i32 to i64
  %wide_delta = scalar.extui %delta : i32 to i64
  %sum = scalar.addi %wide_value, %wide_delta : i64
  %result = scalar.trunci %sum : i64 to i32
  func.return %result : i32
}

// ----
low.func.def public target<vm.core> abi(vm_function) @call_mixed_i32(%19: reg<vm.value : i32>, %delta: reg<vm.value : i32>) -> (reg<vm.value : i32>, reg<vm.value : i32>) asm {
  %mixed = low.func.call pure @add_i32(%19, %delta) : (reg<vm.value : i32>, reg<vm.value : i32>) -> (reg<vm.value : i32>)
  %uniform = low.func.call pure @add_i32(%delta, %delta) : (reg<vm.value : i32>, reg<vm.value : i32>) -> (reg<vm.value : i32>)
  return %mixed, %uniform
}

low.func.def target<vm.core> @add_i32(%value: reg<vm.value : i32>, %delta: reg<vm.value : i32>) -> (reg<vm.value : i32>) asm {
  %wide_value = conversion.integer %value, "u32.to.i64"
  %wide_delta = conversion.integer %delta, "u32.to.i64"
  %sum = integer.add.i64 %wide_value, %wide_delta
  %result = conversion.integer %sum, "i64.to.i32" : reg<vm.value : i32>
  return %result
}

