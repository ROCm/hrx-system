// ====

// Runtime-dependent lane counts cannot become a fixed VM register signature.
// ERROR@+1: TARGET/031 {op_name="func.def", actual_type="vector<[%count]xi32>", type_constraint="vector.static"}
func.def public @reject_dynamic_vector(%count: index, %values: vector<[%count]xi32>) -> (index) {
  func.return %count : index
}

// ====

// The shared boundary limit rejects signatures that would expand one authored
// value into more than 64 physical fields.
// ERROR@+1: TARGET/031 {op_name="func.def", actual_type="vector<65xi8>", type_constraint="vector.target_carrier"}
func.def public @reject_oversized_vector(%values: vector<65xi8>) {
  func.return
}

