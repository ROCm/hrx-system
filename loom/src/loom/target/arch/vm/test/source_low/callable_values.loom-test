// ====

// Multi-rank vectors flatten in row-major logical order at the call and are
// reconstructed with their authored shape inside the callee.
func.def public @call_shaped_vector(%a: i32, %b: i32, %c: i32, %d: i32) -> (i32, i32, i32, i32) {
  %matrix = vector.from_elements %a, %b, %c, %d : vector<2x2xi32>
  %result = func.call @identity_i32x2x2(%matrix) : (vector<2x2xi32>) -> (vector<2x2xi32>)
  %r0 = vector.extract %result[0, 0] : vector<2x2xi32> -> i32
  %r1 = vector.extract %result[0, 1] : vector<2x2xi32> -> i32
  %r2 = vector.extract %result[1, 0] : vector<2x2xi32> -> i32
  %r3 = vector.extract %result[1, 1] : vector<2x2xi32> -> i32
  func.return %r0, %r1, %r2, %r3 : i32, i32, i32, i32
}

func.def noinline @identity_i32x2x2(%matrix: vector<2x2xi32>) -> (vector<2x2xi32>) {
  func.return %matrix : vector<2x2xi32>
}

