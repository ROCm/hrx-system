func.def public @call_vector_result(%input: i32) -> (i32, i32) {
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %c3 = scalar.constant 3 : i32
  %values = vector.from_elements %input, %c1, %c2, %c3 : vector<4xi32>
  %result = func.call @identity_i32x4(%values) : (vector<4xi32>) -> (vector<4xi32>)
  %first = vector.extract %result[0] : vector<4xi32> -> i32
  %last = vector.extract %result[3] : vector<4xi32> -> i32
  func.return %first, %last : i32, i32
}

func.def noinline @identity_i32x4(%values: vector<4xi32>) -> (vector<4xi32>) {
  func.return %values : vector<4xi32>
}

