// RUN: with-checks emit source-low target=vm:core output=low

func.def @generic_vector_atomic(%input: buffer, %increment: i32, %flag: i32) -> (i32) {
  %base = index.constant 0 : offset
  %generic = buffer.assume.memory_space<generic> %input : buffer
  %view = buffer.view %generic[%base] : buffer -> view<2x4xi32>
  %backward = index.constant -1 : index
  %forward = index.constant 1 : index
  %offsets = vector.from_elements %backward, %forward : vector<2xindex>
  %value = vector.from_elements %increment, %increment : vector<2xi32>
  %c0 = scalar.constant 0 : i32
  %enabled = scalar.cmpi ne, %flag, %c0 : i32
  %disabled = scalar.constant false : i1
  %mask = vector.from_elements %enabled, %disabled : vector<2xi1>
  vector.atomic.reduce<addi> %value, %view[1, 1][%offsets] {ordering = release, scope = device} : vector<2xi32>, view<2x4xi32>, vector<2xindex>
  vector.atomic.reduce.mask<subi> %value, %view[1, 1][%offsets], %mask {ordering = relaxed, scope = device} : vector<2xi32>, view<2x4xi32>, vector<2xindex>, vector<2xi1>
  %old = vector.atomic.rmw<addi> %value, %view[1, 1][%offsets] {ordering = acq_rel, scope = device} : vector<2xi32>, view<2x4xi32>, vector<2xindex>
  %masked = vector.atomic.rmw.mask<xchgi> %value, %view[1, 1][%offsets], %mask, %old {ordering = acquire, scope = device} : vector<2xi32>, view<2x4xi32>, vector<2xindex>, vector<2xi1>, vector<2xi32>
  %observed = vector.atomic.cmpxchg %masked, %old, %view[1, 1][%offsets] {failure_ordering = acquire, scope = device, success_ordering = acq_rel} : vector<2xi32>, view<2x4xi32>, vector<2xindex> -> vector<2xi32>
  %result = vector.extract %observed[1] : vector<2xi32> -> i32
  func.return %result : i32
}

// ----
CHECK-NOT: *vector.atomic.*
CHECK-NOT: *low.op<*
CHECK: *buffer.atomic.reduce*
CHECK: *buffer.atomic.rmw*
CHECK: *buffer.atomic.cmpxchg*

// ====

func.def @generic_vector_atomic_i64(%input: buffer, %increment: i64) -> (i64) {
  %base = index.constant 0 : offset
  %generic = buffer.assume.memory_space<generic> %input : buffer
  %view = buffer.view %generic[%base] : buffer -> view<2xi64>
  %origin = index.constant 0 : index
  %stride = index.constant 1 : index
  %offsets = vector.iota %origin step %stride : vector<2xindex>
  %value = vector.from_elements %increment, %increment : vector<2xi64>
  vector.atomic.reduce<addi> %value, %view[0][%offsets] {ordering = relaxed, scope = device} : vector<2xi64>, view<2xi64>, vector<2xindex>
  %old = vector.atomic.rmw<xchgi> %value, %view[0][%offsets] {ordering = relaxed, scope = device} : vector<2xi64>, view<2xi64>, vector<2xindex>
  %observed = vector.atomic.cmpxchg %value, %old, %view[0][%offsets] {failure_ordering = relaxed, scope = device, success_ordering = relaxed} : vector<2xi64>, view<2xi64>, vector<2xindex> -> vector<2xi64>
  %result = vector.extract %observed[1] : vector<2xi64> -> i64
  func.return %result : i64
}

// ----
CHECK-NOT: *vector.atomic.*
CHECK-NOT: *low.op<*
CHECK: *buffer.atomic.reduce*
CHECK: *buffer.atomic.rmw*
CHECK: *buffer.atomic.cmpxchg*
