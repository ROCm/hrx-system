// ====

// Packed scalar ranges preserve their byte coordinates without imposing native
// C alignment on the caller. Native code uses unaligned scalar accessors.
// RUN: emit vm-object-lifetime
vm.target<core> @vm

type.decl import("lifetime", "object") @Object

func.decl import("lifetime", "read_spans") target(@vm) @read(%count: index, %objects: view<1xptr<@Object>> {access = read}, %values: view<1xi64, align(1)> {access = read}) -> (i64)

func.decl import("lifetime", "event") target(@vm) @event(%value: i32)

func.def public target(@vm) @run() {
  %objects = view.alloca<private> : view<1xptr<@Object>>
  %storage = view.alloca<private> : view<9xi8>
  %bytes = view.subview %storage[1] : view<9xi8> -> view<8xi8>
  %values = view.bitcast %bytes : view<8xi8> -> view<1xi64, align(1)>
  %value = scalar.constant 42 : i64
  view.store %value, %values[0] : i64, view<1xi64, align(1)>
  %c1 = index.constant 1 : index
  %sum = func.call @read(%c1, %objects, %values) : (index, view<1xptr<@Object>>, view<1xi64, align(1)>) -> (i64)
  %word = scalar.trunci %sum : i64 to i32
  func.call @event(%word) : (i32)
  func.return
}

// ----
span_count 1
maximum_references 0
event 42
OK 0
retired 0

// ====

// A malicious packet can advertise a different element type from the actual
// ref cell. The native decoder rejects it before dereferencing the object.
// RUN: emit vm-object-lifetime
vm.target<core> @vm

type.decl import("lifetime", "object") @Object

low.func.decl import(native, "read_spans", module = "lifetime") target<vm.core>(@vm) abi(vm_function) @read(%count: reg<vm.value : i64>, %objects: reg<vm.value x2 : vm.span<ptr<@Object>>>, %values: reg<vm.value x2 : vm.span<i64>>) -> (reg<vm.value : i64>)

low.func.def public target<vm.core>(@vm) abi(vm_function) @run() asm {
  %ref_storage = storage {byte_alignment = 16, byte_length = 16} : low.storage<private>
  %scalar_storage = storage {byte_alignment = 8, byte_length = 8} : low.storage<stack>
  %length = constant.i64 8
  %buffer = buffer.allocate %length, 3 : reg<vm.ref : buffer>
  low.spill %buffer, %ref_storage : reg<vm.ref : buffer>, low.storage<private>
  %c0 = constant.i64 0
  low.spill %c0, %scalar_storage : reg<vm.value : i64>, low.storage<stack>
  %c1 = constant.i64 1
  %objects = concat(%c0, %c1) : (reg<vm.value : i64>, reg<vm.value : i64>) -> reg<vm.value x2 : vm.span<ptr<@Object>>>
  %values = concat(%c0, %c1) : (reg<vm.value : i64>, reg<vm.value : i64>) -> reg<vm.value x2 : vm.span<i64>>
  %sum = low.func.call @read(%c1, %objects, %values) : (reg<vm.value : i64>, reg<vm.value x2 : vm.span<ptr<@Object>>>, reg<vm.value x2 : vm.span<i64>>) -> (reg<vm.value : i64>)
  return
}

// ----
INVALID_ARGUMENT 0
retired 0

// ====

// Every byte-addressable scalar element kind crosses the same span ABI.
// Index and offset retain their 64-bit target representation.
// RUN: emit vm-object-lifetime
vm.target<core> @vm

func.decl import("lifetime", "scalar_spans") target(@vm) @consume(%values0: view<2xi8> {access = read}, %values1: view<2xi16> {access = read}, %values2: view<2xi32> {access = read}, %values3: view<2xi64> {access = read}, %values4: view<2xf8E4M3> {access = read}, %values5: view<2xf8E5M2> {access = read}, %values6: view<2xf16> {access = read}, %values7: view<2xbf16> {access = read}, %values8: view<2xf32> {access = read}, %values9: view<2xf64> {access = read}, %values10: view<2xindex> {access = read}, %values11: view<2xoffset> {access = read})

func.def public target(@vm) @run() {
  %values0 = view.alloca<private> : view<2xi8>
  %value0 = scalar.constant -23 : i8
  view.store %value0, %values0[0] : i8, view<2xi8>
  view.store %value0, %values0[1] : i8, view<2xi8>
  %values1 = view.alloca<private> : view<2xi16>
  %value1 = scalar.constant -12345 : i16
  view.store %value1, %values1[0] : i16, view<2xi16>
  view.store %value1, %values1[1] : i16, view<2xi16>
  %values2 = view.alloca<private> : view<2xi32>
  %value2 = scalar.constant -2345678 : i32
  view.store %value2, %values2[0] : i32, view<2xi32>
  view.store %value2, %values2[1] : i32, view<2xi32>
  %values3 = view.alloca<private> : view<2xi64>
  %value3 = scalar.constant 12345 : i64
  view.store %value3, %values3[0] : i64, view<2xi64>
  view.store %value3, %values3[1] : i64, view<2xi64>
  %values4 = view.alloca<private> : view<2xf8E4M3>
  %value4 = scalar.constant 1.5 : f8E4M3
  view.store %value4, %values4[0] : f8E4M3, view<2xf8E4M3>
  view.store %value4, %values4[1] : f8E4M3, view<2xf8E4M3>
  %values5 = view.alloca<private> : view<2xf8E5M2>
  %value5 = scalar.constant 1.5 : f8E5M2
  view.store %value5, %values5[0] : f8E5M2, view<2xf8E5M2>
  view.store %value5, %values5[1] : f8E5M2, view<2xf8E5M2>
  %values6 = view.alloca<private> : view<2xf16>
  %value6 = scalar.constant 1.5 : f16
  view.store %value6, %values6[0] : f16, view<2xf16>
  view.store %value6, %values6[1] : f16, view<2xf16>
  %values7 = view.alloca<private> : view<2xbf16>
  %value7 = scalar.constant 1.5 : bf16
  view.store %value7, %values7[0] : bf16, view<2xbf16>
  view.store %value7, %values7[1] : bf16, view<2xbf16>
  %values8 = view.alloca<private> : view<2xf32>
  %value8 = scalar.constant 1.5 : f32
  view.store %value8, %values8[0] : f32, view<2xf32>
  view.store %value8, %values8[1] : f32, view<2xf32>
  %values9 = view.alloca<private> : view<2xf64>
