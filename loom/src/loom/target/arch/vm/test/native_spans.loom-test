// Source-owned arrays reach a native call as borrowed contiguous ranges.
// RUN: emit vm-object-lifetime borrowed-argument
vm.target<core> @vm

type.decl import("lifetime", "object") @Object

func.decl import("lifetime", "read_spans") target(@vm) @consume(%count: index, %objects: view<[%count]xptr<@Object>> {access = read}, %values: view<[%count]xi64> {access = read}) -> (i64)

func.decl import("lifetime", "event") target(@vm) @event(%value: i32)

func.def public target(@vm) @run(%object: ptr<@Object>) {
  %value = scalar.constant 24 : i64
  %objects = view.alloca<private> : view<4xptr<@Object>>
  %values = view.alloca<private> : view<4xi64>
  view.store %object, %objects[1] : ptr<@Object>, view<4xptr<@Object>>
  view.store %value, %values[1] : i64, view<4xi64>
  %empty = ref.null : ptr<@Object>
  view.store %empty, %objects[2] : ptr<@Object>, view<4xptr<@Object>>
  %other = scalar.constant 17 : i64
  view.store %other, %values[2] : i64, view<4xi64>
  %c2 = index.constant 2 : index
  %object_slice = view.subview %objects[1] : view<4xptr<@Object>> -> view<[%c2]xptr<@Object>>
  %value_slice = view.subview %values[1] : view<4xi64> -> view<[%c2]xi64>
  %result = func.call @consume(%c2, %object_slice, %value_slice) : (index, view<[%c2]xptr<@Object>>, view<[%c2]xi64>) -> (i64)
  %word = scalar.trunci %result : i64 to i32
  func.call @event(%word) : (i32)
  func.return
}


// ----
create 1
span_count 2
maximum_references 1
event 42
OK 1
destroy 1
retired 0

// ====

// RUN: emit vm-object-lifetime borrowed-argument
vm.target<core> @vm

type.decl import("lifetime", "object") @Object

func.decl import("lifetime", "read_spans") target(@vm) @read(%count: index, %objects: view<[%count]xptr<@Object>> {access = read}, %values: view<[%count]xi64> {access = read}) -> (i64)

func.decl import("lifetime", "write_spans") target(@vm) @write(%count: index, %objects: view<[%count]xptr<@Object>> {access = read}, %values: view<[%count]xi64> {access = read_write}) -> (i64)

func.decl import("lifetime", "event") target(@vm) @event(%value: i32)

func.def public target(@vm) @run(%object: ptr<@Object>) {
  %count = index.constant 257 : index
  %objects = view.alloca<private> : view<259xptr<@Object>>
  %values = view.alloca<private> : view<259xi64>
  %sentinel = scalar.constant 12345 : i64
  view.store %sentinel, %values[0] : i64, view<259xi64>
  view.store %sentinel, %values[258] : i64, view<259xi64>
  %object_slice = view.subview %objects[1] : view<259xptr<@Object>> -> view<[%count]xptr<@Object>>
  %value_slice = view.subview %values[1] : view<259xi64> -> view<[%count]xi64>
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  scf.for %i = [%begin to %count step %step] {
    %value = index.cast %i : index to i64
    view.store %object, %object_slice[%i] : ptr<@Object>, view<[%count]xptr<@Object>>
    view.store %value, %value_slice[%i] : i64, view<[%count]xi64>
  }
  %sum = func.call @write(%count, %object_slice, %value_slice) : (index, view<[%count]xptr<@Object>>, view<[%count]xi64>) -> (i64)
  %sum_word = scalar.trunci %sum : i64 to i32
  func.call @event(%sum_word) : (i32)
  %again = func.call @read(%count, %object_slice, %value_slice) : (index, view<[%count]xptr<@Object>>, view<[%count]xi64>) -> (i64)
  %again_word = scalar.trunci %again : i64 to i32
  func.call @event(%again_word) : (i32)
  %left = view.load %values[0] : view<259xi64> -> i64
  %right = view.load %values[258] : view<259xi64> -> i64
  %left_word = scalar.trunci %left : i64 to i32
  %right_word = scalar.trunci %right : i64 to i32
  func.call @event(%left_word) : (i32)
  func.call @event(%right_word) : (i32)
  %last = view.load %values[257] : view<259xi64> -> i64
  %last_word = scalar.trunci %last : i64 to i32
  func.call @event(%last_word) : (i32)
  func.return
}

// ----
create 1
span_count 257
maximum_references 1
event 33153
span_count 257
maximum_references 1
event 33410
event 12345
event 12345
event 257
OK 1
destroy 1
retired 0

// ====

// The array owns the object after the creating SSA owner is explicitly released.
// Calling with a ref span borrows the cells without retaining each element.
// RUN: emit vm-object-lifetime
vm.target<core> @vm

type.decl import("lifetime", "object") @Object

func.decl import("lifetime", "create") target(@vm) @create(%identity: i32) -> (ref<@Object>, ptr<@Object>)

func.decl import("lifetime", "read_owners") target(@vm) @read(%count: index, %objects: view<1xref<@Object>> {access = read}, %values: view<1xi64> {access = read}) -> (i64)

func.decl import("lifetime", "event") target(@vm) @event(%value: i32)

func.def public target(@vm) @run() {
  %objects = view.alloca<private> : view<1xref<@Object>>
  %values = view.alloca<private> : view<1xi64>
  %identity = scalar.constant 7 : i32
  %owner, %unused = func.call @create(%identity) : (i32) -> (ref<@Object>, ptr<@Object>)
  view.store %owner, %objects[0] : ref<@Object>, view<1xref<@Object>>
  ref.release %owner : ref<@Object>
  %value = scalar.constant 41 : i64
  view.store %value, %values[0] : i64, view<1xi64>
  %c1 = index.constant 1 : index
  %sum = func.call @read(%c1, %objects, %values) : (index, view<1xref<@Object>>, view<1xi64>) -> (i64)
  %word = scalar.trunci %sum : i64 to i32
  func.call @event(%word) : (i32)
  func.return
}

// ----
create 7
span_count 1
maximum_references 1
event 48
destroy 7
OK 0
retired 0

