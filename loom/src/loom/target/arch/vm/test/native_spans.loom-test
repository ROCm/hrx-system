// ====

// Empty ranges in empty banks are legal.
// RUN: emit vm-object-lifetime
vm.target<core> @vm

type.decl import("lifetime", "object") @Object

low.func.decl import(native, "read_spans", module = "lifetime") target<vm.core>(@vm) abi(vm_function) @read(%count: reg<vm.value : i64>, %objects: reg<vm.value x2 : vm.span<ptr<@Object>>>, %values: reg<vm.value x2 : vm.span<i64>>) -> (reg<vm.value : i64>)

low.func.def public target<vm.core>(@vm) abi(vm_function) @run() asm {
  %c0 = constant.i64 0
  %ref_offset = constant.i64 0
  %ref_count = constant.i64 0
  %scalar_offset = constant.i64 0
  %scalar_count = constant.i64 0
  %objects = concat(%ref_offset, %ref_count) : (reg<vm.value : i64>, reg<vm.value : i64>) -> reg<vm.value x2 : vm.span<ptr<@Object>>>
  %values = concat(%scalar_offset, %scalar_count) : (reg<vm.value : i64>, reg<vm.value : i64>) -> reg<vm.value x2 : vm.span<i64>>
  %sum = low.func.call @read(%c0, %objects, %values) : (reg<vm.value : i64>, reg<vm.value x2 : vm.span<ptr<@Object>>>, reg<vm.value x2 : vm.span<i64>>) -> (reg<vm.value : i64>)
  return
}

