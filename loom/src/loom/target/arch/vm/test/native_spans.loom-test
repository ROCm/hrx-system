  %objects = view.alloca<private> : view<1xptr<@Object>>
  %values = view.alloca<private> : view<1xi64>
  %c0 = index.constant 0 : index
  %object_slice = view.subview %objects[1] : view<1xptr<@Object>> -> view<0xptr<@Object>>
  %value_slice = view.subview %values[1] : view<1xi64> -> view<0xi64>
  %sum = func.call @read(%c0, %object_slice, %value_slice) : (index, view<0xptr<@Object>>, view<0xi64>) -> (i64)
