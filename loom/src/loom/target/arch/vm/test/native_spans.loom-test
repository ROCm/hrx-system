  %a13 = scalar.constant 13 : i64
  %a14 = scalar.constant 14 : i64
  %sum = func.call @read(%c1, %a1, %a2, %a3, %a4, %a5, %a6, %a7, %a8, %a9, %a10, %a11, %a12, %a13, %a14, %objects, %values) : (index, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, view<1xptr<@Object>>, view<1xi64>) -> (i64)
