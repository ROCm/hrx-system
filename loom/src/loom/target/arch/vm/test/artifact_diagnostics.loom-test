// RUN: emit vm-dis

vm.target<core> @target

// ERROR@+1: BACKEND/055 {format="VM", export="untyped", constraint="signature fields carrying scalar or managed reference types"}
low.func.def public target<vm.core>(@target) @untyped(%value: reg<vm.value>) -> (reg<vm.value>) asm {
  return %value
}

