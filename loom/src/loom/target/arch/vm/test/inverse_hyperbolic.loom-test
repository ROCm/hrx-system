vm.target<core> @math_target

func.def target(@math_target) @inverse(%input: bf16) -> (bf16) {
  %3 = scalar.extf %input : bf16 to f32
  %4 = scalar.absf<afn> %3 : f32
  %5 = scalar.mulf<afn> %4, %4 : f32
  %6 = scalar.constant 0.043478260869565216 : f32
  %7 = scalar.constant 0.047619047619047616 : f32
  %8 = scalar.mulf<contract|afn> %6, %5 : f32
  %9 = scalar.addf<contract|afn> %8, %7 : f32
  %10 = scalar.constant 0.052631578947368418 : f32
  %11 = scalar.mulf<contract|afn> %9, %5 : f32
  %12 = scalar.addf<contract|afn> %11, %10 : f32
  %13 = scalar.constant 0.058823529411764705 : f32
  %14 = scalar.mulf<contract|afn> %12, %5 : f32
  %15 = scalar.addf<contract|afn> %14, %13 : f32
  %16 = scalar.constant 0.066666666666666666 : f32
  %17 = scalar.mulf<contract|afn> %15, %5 : f32
  %18 = scalar.addf<contract|afn> %17, %16 : f32
  %19 = scalar.constant 0.076923076923076927 : f32
  %20 = scalar.mulf<contract|afn> %18, %5 : f32
  %21 = scalar.addf<contract|afn> %20, %19 : f32
  %22 = scalar.constant 0.090909090909090912 : f32
  %23 = scalar.mulf<contract|afn> %21, %5 : f32
  %24 = scalar.addf<contract|afn> %23, %22 : f32
  %25 = scalar.constant 0.1111111111111111 : f32
  %26 = scalar.mulf<contract|afn> %24, %5 : f32
  %27 = scalar.addf<contract|afn> %26, %25 : f32
  %28 = scalar.constant 0.14285714285714285 : f32
  %29 = scalar.mulf<contract|afn> %27, %5 : f32
  %30 = scalar.addf<contract|afn> %29, %28 : f32
  %31 = scalar.constant 0.20000000000000001 : f32
  %32 = scalar.mulf<contract|afn> %30, %5 : f32
  %33 = scalar.addf<contract|afn> %32, %31 : f32
  %34 = scalar.constant 0.33333333333333331 : f32
  %35 = scalar.mulf<contract|afn> %33, %5 : f32
  %36 = scalar.addf<contract|afn> %35, %34 : f32
  %37 = scalar.constant 1.0 : f32
  %38 = scalar.mulf<contract|afn> %36, %5 : f32
  %39 = scalar.addf<contract|afn> %38, %37 : f32
  %40 = scalar.mulf<afn> %4, %39 : f32
  %41 = scalar.constant 1.0 : f32
  %42 = scalar.addf<afn> %41, %4 : f32
  %43 = scalar.subf<afn> %41, %4 : f32
  %44 = scalar.divf<afn> %42, %43 : f32
  %45 = scalar.log2f<afn> %44 : f32
  %46 = scalar.constant 0.69314718055994529 : f32
  %47 = scalar.mulf<afn> %45, %46 : f32
  %48 = scalar.constant 0.5 : f32
  %49 = scalar.mulf<afn> %48, %47 : f32
  %50 = scalar.cmpf<afn> oge, %4, %48 : f32
  %51 = scf.select %50, %49, %40 : f32
  %52 = scalar.cmpf<afn> oge, %41, %4 : f32
  %53 = scalar.constant nan : f32
  %54 = scf.select %52, %51, %53 : f32
  %55 = scalar.copysignf<afn> %54, %3 : f32
  %result = scalar.fptrunc %55 : f32 to bf16
  func.return %result : bf16
}

