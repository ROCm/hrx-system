vm.target<core> @math_target

func.def target(@math_target) @inverse(%input: vector<3xf16>) -> (vector<3xf16>) {
  %result = vector.acoshf<afn> %input : vector<3xf16>
  func.return %result : vector<3xf16>
}

// ----
vm.target<core> @math_target

func.def target(@math_target) @inverse(%input: vector<3xf16>) -> (vector<3xf16>) {
  %3 = vector.extf %input : vector<3xf16> to vector<3xf32>
  %4 = vector.splatf 1.0 : vector<3xf32>
  %5 = vector.subf<afn> %3, %4 : vector<3xf32>
  %6 = vector.addf<afn> %3, %4 : vector<3xf32>
  %7 = vector.divf<afn> %5, %6 : vector<3xf32>
  %8 = vector.sqrtf<afn> %7 : vector<3xf32>
  %9 = vector.mulf<afn> %8, %8 : vector<3xf32>
  %10 = vector.splatf 0.043478260869565216 : vector<3xf32>
  %11 = vector.splatf 0.047619047619047616 : vector<3xf32>
  %12 = vector.mulf<contract|afn> %10, %9 : vector<3xf32>
  %13 = vector.addf<contract|afn> %12, %11 : vector<3xf32>
  %14 = vector.splatf 0.052631578947368418 : vector<3xf32>
  %15 = vector.mulf<contract|afn> %13, %9 : vector<3xf32>
  %16 = vector.addf<contract|afn> %15, %14 : vector<3xf32>
  %17 = vector.splatf 0.058823529411764705 : vector<3xf32>
  %18 = vector.mulf<contract|afn> %16, %9 : vector<3xf32>
  %19 = vector.addf<contract|afn> %18, %17 : vector<3xf32>
  %20 = vector.splatf 0.066666666666666666 : vector<3xf32>
  %21 = vector.mulf<contract|afn> %19, %9 : vector<3xf32>
  %22 = vector.addf<contract|afn> %21, %20 : vector<3xf32>
  %23 = vector.splatf 0.076923076923076927 : vector<3xf32>
  %24 = vector.mulf<contract|afn> %22, %9 : vector<3xf32>
  %25 = vector.addf<contract|afn> %24, %23 : vector<3xf32>
  %26 = vector.splatf 0.090909090909090912 : vector<3xf32>
  %27 = vector.mulf<contract|afn> %25, %9 : vector<3xf32>
  %28 = vector.addf<contract|afn> %27, %26 : vector<3xf32>
  %29 = vector.splatf 0.1111111111111111 : vector<3xf32>
  %30 = vector.mulf<contract|afn> %28, %9 : vector<3xf32>
  %31 = vector.addf<contract|afn> %30, %29 : vector<3xf32>
  %32 = vector.splatf 0.14285714285714285 : vector<3xf32>
  %33 = vector.mulf<contract|afn> %31, %9 : vector<3xf32>
  %34 = vector.addf<contract|afn> %33, %32 : vector<3xf32>
  %35 = vector.splatf 0.20000000000000001 : vector<3xf32>
  %36 = vector.mulf<contract|afn> %34, %9 : vector<3xf32>
  %37 = vector.addf<contract|afn> %36, %35 : vector<3xf32>
  %38 = vector.splatf 0.33333333333333331 : vector<3xf32>
  %39 = vector.mulf<contract|afn> %37, %9 : vector<3xf32>
  %40 = vector.addf<contract|afn> %39, %38 : vector<3xf32>
  %41 = vector.splatf 1.0 : vector<3xf32>
  %42 = vector.mulf<contract|afn> %40, %9 : vector<3xf32>
  %43 = vector.addf<contract|afn> %42, %41 : vector<3xf32>
  %44 = vector.mulf<afn> %8, %43 : vector<3xf32>
  %45 = vector.addf<afn> %44, %44 : vector<3xf32>
  %46 = vector.mulf<afn> %5, %6 : vector<3xf32>
  %47 = vector.sqrtf<afn> %46 : vector<3xf32>
  %48 = vector.addf<afn> %3, %47 : vector<3xf32>
  %49 = vector.splatf 4096.0 : vector<3xf32>
  %50 = vector.cmpf<afn> oge, %3, %49 : vector<3xf32> -> vector<3xi1>
  %51 = vector.select %50, %3, %48 : vector<3xf32>
  %52 = vector.log2f<afn> %51 : vector<3xf32>
  %53 = vector.splatf 0.69314718055994529 : vector<3xf32>
  %54 = vector.mulf<afn> %52, %53 : vector<3xf32>
  %55 = vector.splatf 0.69314718055994529 : vector<3xf32>
  %56 = vector.addf<afn> %54, %55 : vector<3xf32>
  %57 = vector.select %50, %56, %54 : vector<3xf32>
  %58 = vector.splatf 1.5 : vector<3xf32>
  %59 = vector.cmpf<afn> oge, %3, %58 : vector<3xf32> -> vector<3xi1>
  %60 = vector.select %59, %57, %45 : vector<3xf32>
  %61 = vector.cmpf<afn> oge, %3, %4 : vector<3xf32> -> vector<3xi1>
  %62 = vector.splatf nan : vector<3xf32>
  %63 = vector.select %61, %60, %62 : vector<3xf32>
  %result = vector.fptrunc %63 : vector<3xf32> to vector<3xf16>
  func.return %result : vector<3xf16>
}

