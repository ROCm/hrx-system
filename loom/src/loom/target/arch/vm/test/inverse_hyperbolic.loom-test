vm.target<core> @math_target

func.def target(@math_target) @wide_inverse(%input: vector<3xf64>) -> (vector<3xf64>) {
  %result = vector.asinhf<afn> %input : vector<3xf64>
  func.return %result : vector<3xf64>
}
