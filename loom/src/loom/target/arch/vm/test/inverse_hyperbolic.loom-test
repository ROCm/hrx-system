// RUN: pass legalize-math

vm.target<core> @math_target

func.def target(@math_target) @inverse(%input: f32) -> (f32) {
  %result = scalar.asinhf<afn> %input : f32
  func.return %result : f32
}

// ----
vm.target<core> @math_target

func.def target(@math_target) @inverse(%input: f32) -> (f32) {
  %3 = scalar.absf<afn> %input : f32
  %4 = scalar.mulf<afn> %3, %3 : f32
  %5 = scalar.constant 0.011551800896139705 : f32
  %6 = scalar.constant -0.013964843750000001 : f32
  %7 = scalar.mulf<contract|afn> %5, %4 : f32
  %8 = scalar.addf<contract|afn> %7, %6 : f32
  %9 = scalar.constant 0.017352764423076924 : f32
  %10 = scalar.mulf<contract|afn> %8, %4 : f32
  %11 = scalar.addf<contract|afn> %10, %9 : f32
  %12 = scalar.constant -0.022372159090909092 : f32
  %13 = scalar.mulf<contract|afn> %11, %4 : f32
  %14 = scalar.addf<contract|afn> %13, %12 : f32
  %15 = scalar.constant 0.030381944444444444 : f32
  %16 = scalar.mulf<contract|afn> %14, %4 : f32
  %17 = scalar.addf<contract|afn> %16, %15 : f32
  %18 = scalar.constant -0.044642857142857144 : f32
  %19 = scalar.mulf<contract|afn> %17, %4 : f32
  %20 = scalar.addf<contract|afn> %19, %18 : f32
  %21 = scalar.constant 0.074999999999999997 : f32
  %22 = scalar.mulf<contract|afn> %20, %4 : f32
  %23 = scalar.addf<contract|afn> %22, %21 : f32
  %24 = scalar.constant -0.16666666666666666 : f32
  %25 = scalar.mulf<contract|afn> %23, %4 : f32
  %26 = scalar.addf<contract|afn> %25, %24 : f32
  %27 = scalar.constant 1.0 : f32
  %28 = scalar.mulf<contract|afn> %26, %4 : f32
  %29 = scalar.addf<contract|afn> %28, %27 : f32
  %30 = scalar.mulf<afn> %3, %29 : f32
  %31 = scalar.constant 1.0 : f32
  %32 = scalar.mulf<contract|afn> %3, %3 : f32
  %33 = scalar.addf<contract|afn> %32, %31 : f32
  %34 = scalar.sqrtf<afn> %33 : f32
  %35 = scalar.addf<afn> %3, %34 : f32
  %36 = scalar.constant 4096.0 : f32
  %37 = scalar.cmpf<afn> oge, %3, %36 : f32
  %38 = scf.select %37, %3, %35 : f32
  %39 = scalar.log2f<afn> %38 : f32
  %40 = scalar.constant 0.69314718055994529 : f32
  %41 = scalar.mulf<afn> %39, %40 : f32
  %42 = scalar.constant 0.69314718055994529 : f32
  %43 = scalar.addf<afn> %41, %42 : f32
  %44 = scf.select %37, %43, %41 : f32
  %45 = scalar.constant 0.5 : f32
  %46 = scalar.cmpf<afn> oge, %3, %45 : f32
  %47 = scf.select %46, %44, %30 : f32
  %result = scalar.copysignf<afn> %47, %input : f32
  func.return %result : f32
}

