vm.module core(0.0) {
  section strings alignment(8) {
    string @string0 = "run"
    string @string1 = "host"
    string @string2 = "scalar"
    string @string3 = "host"
    string @string4 = "empty"
  }

  section signatures alignment(8) {
    signature @signature0 (i64) -> (i64)
  }

  section callable_types alignment(8) {
    callable @callable0 flags([]) depth(0) : @signature0
  }

  section exports alignment(8) {
    export @export0 name(@string0) : @callable0 = @function0
  }

  section functions alignment(8) {
    func @function0 : @callable0 flags([has_native_call]) frame(local_bytes = 0, value_registers = 1, ref_registers = 0, function_registers = 0, local_refs = 0, local_functions = 0) {
    ^bb0:
      control.block
      control.call.native @native_callsite0
      control.call.native @native_callsite1
      control.return
    }
  }

  section native_calls alignment(8) {
    native_layout @native_layout0 (i64, out i64)
    native_layout @native_layout1 ()
    native_import @native_import0 module(@string1) export(@string2) version(1) : @native_layout0
    native_import @native_import1 module(@string3) export(@string4) version(1) : @native_layout1
    native_callsite @native_callsite0 function(@function0) callee(@native_import0) (%v0, out %v0)
    native_callsite @native_callsite1 function(@function0) callee(@native_import1) ()
