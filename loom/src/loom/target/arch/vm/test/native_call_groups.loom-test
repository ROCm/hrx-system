low.func.decl import(native, "pairs", module = "host") target<vm.core>(@vm) abi(vm_native) abi_layout({signature = vm.record<vm.range<i64, vm.out<buffer>>>, version = 1}) @pairs(%a: reg<vm.value : i64>) -> (reg<vm.ref : buffer>)

low.func.def public target<vm.core>(@vm) @run(%left: reg<vm.value : i64>, %right: reg<vm.value : i64>) -> (reg<vm.ref : buffer>, reg<vm.ref : buffer>) asm {
  %owner$11 = low.func.call @pairs([(%right, out)]) : (reg<vm.value : i64>) -> (reg<vm.ref : buffer>)
  %owner$4 = low.func.call @pairs([(%left, out)]) : (reg<vm.value : i64>) -> (reg<vm.ref : buffer>)
  return %owner$11, %owner$4
}

// ====
// RUN: emit vm-dis

vm.target<core> @vm

// Flat signatures retain ordinary call syntax, including implicit results and
// calls with no operands or results.
low.func.decl import(native, "scalar", module = "host") target<vm.core>(@vm) abi(vm_native) abi_layout({signature = vm.record<i64, vm.out<i64>>, version = 1}) @scalar(%value: reg<vm.value : i64>) -> (reg<vm.value : i64>)

low.func.decl import(native, "empty", module = "host") target<vm.core>(@vm) abi(vm_native) abi_layout({signature = vm.record, version = 1}) @empty()

low.func.def public target<vm.core>(@vm) @run(%value: reg<vm.value : i64>) -> (reg<vm.value : i64>) asm {
  %result = low.func.call @scalar(%value) : (reg<vm.value : i64>) -> (reg<vm.value : i64>)
  low.func.call @empty() : ()
  return %result
}

