// ====
// RUN: pass inline-callables

vm.target<core> @vm

low.func.decl import(native, "pairs", module = "host") target<vm.core>(@vm) abi(vm_native) abi_layout({signature = vm.record<vm.range<i64, vm.out<buffer>>>, version = 1}) @pairs(%a: reg<vm.value : i64>) -> (reg<vm.ref : buffer>)

low.func.def inline target<vm.core>(@vm) @helper(%a: reg<vm.value : i64>) -> (reg<vm.ref : buffer>) asm {
  %owner = low.func.call @pairs([(%a, out)]) : (reg<vm.value : i64>) -> (reg<vm.ref : buffer>)
  return %owner
}

low.func.def public target<vm.core>(@vm) @run(%left: reg<vm.value : i64>, %right: reg<vm.value : i64>) -> (reg<vm.ref : buffer>, reg<vm.ref : buffer>) asm {
  %first = low.func.call @helper(%right) : (reg<vm.value : i64>) -> (reg<vm.ref : buffer>)
  %second = low.func.call @helper(%left) : (reg<vm.value : i64>) -> (reg<vm.ref : buffer>)
  return %first, %second
}

