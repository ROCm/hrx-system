// RUN: format bytecode

vm.target<core> @vm

// One declaration admits different partitions of the same logical signature.
// Results inside records are ordinary SSA definitions in preorder result order.
low.func.decl import(native, "pairs", module = "host") target<vm.core>(@vm) abi(vm_native) abi_layout({signature = vm.record<vm.range<i64, vm.out<buffer>>, vm.range<i64, vm.out<buffer>>>, version = 1}) @pairs(%a: reg<vm.value : i64>, %b: reg<vm.value : i64>) -> (reg<vm.ref : buffer>, reg<vm.ref : buffer>)

low.func.def public target<vm.core>(@vm) @run(%a: reg<vm.value : i64>, %b: reg<vm.value : i64>) -> (reg<vm.ref : buffer>, reg<vm.ref : buffer>) asm {
  %first, %second = low.func.call @pairs([(%a, out), (%b, out)], []) : (reg<vm.value : i64>, reg<vm.value : i64>) -> (reg<vm.ref : buffer>, reg<vm.ref : buffer>)
  %third, %fourth = low.func.call @pairs([], [(%b, out), (%a, out)]) : (reg<vm.value : i64>, reg<vm.value : i64>) -> (reg<vm.ref : buffer>, reg<vm.ref : buffer>)
  return %first, %fourth
}

