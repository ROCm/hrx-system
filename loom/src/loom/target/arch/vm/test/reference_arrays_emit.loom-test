// RUN: emit vm-dis target=vm:core

// Opaque cells use the reference bank, while addresses stay integer coordinates.
// No managed container or per-element native mutator appears in the artifact.
type.decl import("lifetime", "object") @Object

func.def public @contains(%object: ptr<@Object>, %position: index) -> (i1) {
  %bounded = index.assume %position [range(%position, 0, 7)] : index
  %objects = view.alloca<private> : view<8xptr<@Object>>
  view.store %object, %objects[%bounded] : ptr<@Object>, view<8xptr<@Object>>
  %loaded = view.load %objects[%bounded] : view<8xptr<@Object>> -> ptr<@Object>
  %same = ref.compare.eq %object, %loaded : ptr<@Object>, ptr<@Object>
  func.return %same : i1
}

// ----
vm.module core(0.0) {
  section strings alignment(8) {
    string @string0 = "contains"
    string @string1 = "lifetime"
    string @string2 = "object"
  }

  section ref_types alignment(8) {
    namespace @ref_group0 name(@string1) {
      ref_type @ref_type0 name(@string2)
    }
  }

  section signatures alignment(8) {
    signature @signature0 (ptr(@ref_type0), i64) -> (i32)
  }

  section callable_types alignment(8) {
    callable @callable0 flags([]) depth(0) : @signature0
  }

  section exports alignment(8) {
    export @export0 name(@string0) : @callable0 = @function0
  }

  section functions alignment(8) {
    func @function0 : @callable0 flags([]) frame(local_bytes = 0, value_registers = 3, ref_registers = 2, function_registers = 0, local_refs = 8, local_functions = 0) {
    ^bb0:
      control.block
      %v1 = constant.i32 0x00000000
      ref.stack.discard.range %v1 {count = 8}
      %v2 = constant.s16 4
      %v0 = integer.shift.left.i64 %v0, %v2
      %v0 = integer.add.i64 %v1, %v0
      ref.stack.store.indexed.copy %r0, %v0
      %r1 = ref.stack.load.indexed.copy %v0
      %v0 = ref.compare.eq %r0, %r1
      ref.discard %r1
      ref.discard %r0
      control.return
    }
  }

}
