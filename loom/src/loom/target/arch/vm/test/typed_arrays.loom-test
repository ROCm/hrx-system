// RUN: emit vm-object-lifetime

func.decl import("lifetime", "event") @event(%value: i32)

func.def noinline @array_tail(%seed: i64, %capacity: index) -> (i64) {
  %bounded = index.assume %capacity [range(%capacity, 4, 8)] : index
  %values = view.alloca<private> : view<[%bounded]xi64>
  %tail = view.subview %values[1] : view<[%bounded]xi64> -> view<3xi64>
  %begin = index.constant 0 : index
  %end = index.constant 3 : index
  %step = index.constant 1 : index
  scf.for %i = [%begin to %end step %step] {
    %position = index.cast %i : index to i64
    %value = scalar.addi %seed, %position : i64
    view.store %value, %tail[%i] : i64, view<3xi64>
  }
  %result = view.load %tail[2] : view<3xi64> -> i64
  func.return %result : i64
}

func.def public @run() {
  %seed = scalar.constant 40 : i64
  %capacity = index.constant 6 : index
  %value = func.call @array_tail(%seed, %capacity) : (i64, index) -> (i64)
  %word = scalar.trunci %value : i64 to i32
  func.call @event(%word) : (i32)
  func.return
}

// ----
event 42
OK 0
retired 0

// ====

// Array ranges remain disjoint from the outgoing overflow argument packet.
func.decl import("lifetime", "event") @event(%value: i32)

func.def noinline @sum(%a0: i64, %a1: i64, %a2: i64, %a3: i64, %a4: i64, %a5: i64, %a6: i64, %a7: i64, %a8: i64, %a9: i64, %a10: i64, %a11: i64, %a12: i64, %a13: i64, %a14: i64, %a15: i64, %a16: i64) -> (i64) {
  %sum1 = scalar.addi %a0, %a1 : i64
  %sum2 = scalar.addi %sum1, %a2 : i64
  %sum3 = scalar.addi %sum2, %a3 : i64
  %sum4 = scalar.addi %sum3, %a4 : i64
  %sum5 = scalar.addi %sum4, %a5 : i64
  %sum6 = scalar.addi %sum5, %a6 : i64
  %sum7 = scalar.addi %sum6, %a7 : i64
  %sum8 = scalar.addi %sum7, %a8 : i64
  %sum9 = scalar.addi %sum8, %a9 : i64
  %sum10 = scalar.addi %sum9, %a10 : i64
  %sum11 = scalar.addi %sum10, %a11 : i64
  %sum12 = scalar.addi %sum11, %a12 : i64
  %sum13 = scalar.addi %sum12, %a13 : i64
  %sum14 = scalar.addi %sum13, %a14 : i64
  %sum15 = scalar.addi %sum14, %a15 : i64
  %sum16 = scalar.addi %sum15, %a16 : i64
  func.return %sum16 : i64
}

func.def noinline @arrays(%value: i64) {
  %left = view.alloca<private> : view<4xi64>
  %right = view.alloca<private> align(64) : view<8xi16>
  %right_value = scalar.constant 7 : i16
  view.store %value, %left[3] : i64, view<4xi64>
  view.store %right_value, %right[2] : i16, view<8xi16>
  %overflow_value = scalar.constant 3 : i64
  %sum = func.call @sum(%value, %value, %value, %value, %value, %value, %value, %value, %value, %value, %value, %value, %value, %value, %value, %value, %overflow_value) : (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) -> (i64)
  %original = view.load %left[3] : view<4xi64> -> i64
  %other = view.load %right[2] : view<8xi16> -> i16
  %original_word = scalar.trunci %original : i64 to i32
  %other_word = scalar.extui %other : i16 to i32
  %sum_word = scalar.trunci %sum : i64 to i32
  func.call @event(%original_word) : (i32)
  func.call @event(%other_word) : (i32)
  func.call @event(%sum_word) : (i32)
  func.return
}

func.def public @run() {
  %value = scalar.constant 42 : i64
  func.call @arrays(%value) : (i64)
  func.return
}

