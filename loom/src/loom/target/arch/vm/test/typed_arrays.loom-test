// ====

// A rank-zero cell and a strided matrix share the same address machinery.
func.decl import("lifetime", "event") @event(%value: i32)

func.def public @run() {
  %cell = view.alloca<private> : view<i32>
  %matrix = view.alloca<private> : view<2x3xi32, #encoding.layout.strided<strides=[8, 2]>>
  %first = scalar.constant 321 : i32
  %second = scalar.constant 987 : i32
  view.store %first, %cell[] : i32, view<i32>
  view.store %second, %matrix[1, 2] : i32, view<2x3xi32, #encoding.layout.strided<strides=[8, 2]>>
  %cell_value = view.load %cell[] : view<i32> -> i32
  %matrix_value = view.load %matrix[1, 2] : view<2x3xi32, #encoding.layout.strided<strides=[8, 2]>> -> i32
  func.call @event(%cell_value) : (i32)
  func.call @event(%matrix_value) : (i32)
  func.return
}

// ----
event 321
event 987
OK 0
retired 0
