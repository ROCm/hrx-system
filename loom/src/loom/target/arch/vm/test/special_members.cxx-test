// ====
// An implicitly constructed aggregate may have nontrivial assignment.

[[loom::import("lifetime", "event")]] void event(unsigned value);
struct Value {
  // Payload whose changes make lifecycle effects observable.
  unsigned value;
  Value& operator=(const Value& other) {
    value = other.value + 1u;
    event(100u + value);
    return *this;
  }
};
void run() {
  Value first{3u};
  Value second = first;
  second = first;
  Value third = static_cast<Value&&>(second);
  event(first.value * 100u + second.value * 10u + third.value);
}

