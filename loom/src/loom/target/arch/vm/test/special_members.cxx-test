// ====
// Defaulted array members preserve element order and source identity.
[[loom::import("lifetime", "event")]] void event(unsigned value);

struct Owner {
  // Payload whose changes make lifecycle effects observable.
  unsigned value;
  explicit Owner(unsigned value) : value(value) { event(100u + value); }
  Owner(const Owner& other) : value(other.value) { event(200u + value); }
  Owner(Owner&& other) : value(other.value) {
    other.value = 0;
    event(300u + value);
  }
  Owner& operator=(const Owner& other) {
    event(400u + value);
    value = other.value;
    return *this;
  }
  Owner& operator=(Owner&& other) {
    event(500u + value);
    unsigned incoming = other.value;
    other.value = 0;
    value = incoming;
    return *this;
  }
  ~Owner() { event(600u + value); }
};

struct Packet {
  // Elements retain independent state across defaulted operations.
  Owner values[2];
  explicit Packet(unsigned seed) : values{Owner(seed), Owner(seed + 1u)} {}
};
void run() {
  Packet source(4u);
  Packet copied(source);
  Packet moved(static_cast<Packet&&>(source));
  copied = moved;
  moved = static_cast<Packet&&>(copied);
  event(700u + source.values[0].value + copied.values[1].value + moved.values[0].value);
}

