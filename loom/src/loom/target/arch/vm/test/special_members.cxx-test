// RUN: emit vm-object-lifetime
// INPUT: cxx root=run
// Explicit copy/move, replacement, aliases, and reverse destruction.
[[loom::import("lifetime", "event")]] void event(unsigned value);

struct Owner {
  // Payload whose changes make lifecycle effects observable.
  unsigned value;
  explicit Owner(unsigned value) : value(value) { event(100u + value); }
  Owner(const Owner& other) : value(other.value) { event(200u + value); }
  Owner(Owner&& other) : value(other.value) {
    other.value = 0;
    event(300u + value);
  }
  Owner& operator=(const Owner& other) {
    event(400u + value);
    value = other.value;
    return *this;
  }
  Owner& operator=(Owner&& other) {
    event(500u + value);
    unsigned incoming = other.value;
    other.value = 0;
    value = incoming;
    return *this;
  }
  ~Owner() { event(600u + value); }
};

void run() {
  {
    Owner first(7);
    Owner second(first);
    Owner third(static_cast<Owner&&>(first));
    second = third;
    third = static_cast<Owner&&>(second);
    third = third;
    third = static_cast<Owner&&>(third);
    event(700u + first.value * 100u + second.value * 10u + third.value);
  }
  event(999u);
}

