// ====
// Out-of-line defaulted members retain their resolved definitions.
[[loom::import("lifetime", "event")]] void event(unsigned value);

struct Owner {
  // Payload whose changes make lifecycle effects observable.
  unsigned value;
  explicit Owner(unsigned value) : value(value) { event(100u + value); }
  Owner(const Owner& other) : value(other.value) { event(200u + value); }
  Owner(Owner&& other) : value(other.value) {
    other.value = 0;
    event(300u + value);
  }
  Owner& operator=(const Owner& other) {
    event(400u + value);
    value = other.value;
    return *this;
  }
  Owner& operator=(Owner&& other) {
    event(500u + value);
    unsigned incoming = other.value;
    other.value = 0;
    value = incoming;
    return *this;
  }
  ~Owner() { event(600u + value); }
};

struct Box {
  // Nested owner supplies the defaulted lifecycle behavior.
  Owner value;
  explicit Box(unsigned seed) : value(seed) {}
  Box(const Box&);
  Box(Box&&);
  Box& operator=(const Box&);
  Box& operator=(Box&&);
};
Box::Box(const Box&) = default;
Box::Box(Box&&) = default;
Box& Box::operator=(const Box&) = default;
Box& Box::operator=(Box&&) = default;
void run() {
  Box first(4u);
  Box second(first);
  Box third(static_cast<Box&&>(first));
  second = third;
  third = static_cast<Box&&>(second);
}

