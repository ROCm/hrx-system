// ====
// Defaulted special members execute their nested member operations in order.
[[loom::import("lifetime", "event")]] void event(unsigned value);

struct Owner {
  // Payload whose changes make lifecycle effects observable.
  unsigned value;
  explicit Owner(unsigned value) : value(value) { event(100u + value); }
  Owner(const Owner& other) : value(other.value) { event(200u + value); }
  Owner(Owner&& other) : value(other.value) {
    other.value = 0;
    event(300u + value);
  }
  Owner& operator=(const Owner& other) {
    event(400u + value);
    value = other.value;
    return *this;
  }
  Owner& operator=(Owner&& other) {
    event(500u + value);
    unsigned incoming = other.value;
    other.value = 0;
    value = incoming;
    return *this;
  }
  ~Owner() { event(600u + value); }
};

struct Pair {
  // First member constructed, copied, and assigned.
  Owner first;
  // Second member, destroyed before the first.
  Owner second;
  explicit Pair(unsigned seed) : first(seed), second(seed + 1u) {}
  Pair(const Pair&) = default;
  Pair(Pair&&) = default;
  Pair& operator=(const Pair&) = default;
  Pair& operator=(Pair&&) = default;
  ~Pair() = default;
};
void run() {
  Pair source(2u);
  Pair copied(source);
  Pair moved(static_cast<Pair&&>(source));
  copied = moved;
  moved = static_cast<Pair&&>(copied);
  event(700u + source.first.value + copied.second.value + moved.first.value);
}

