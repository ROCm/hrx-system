// ====
// Template special members instantiate their ordinary bodies and cleanup.
[[loom::import("lifetime", "event")]] void event(unsigned value);

struct Owner {
  // Payload whose changes make lifecycle effects observable.
  unsigned value;
  explicit Owner(unsigned value) : value(value) { event(100u + value); }
  Owner(const Owner& other) : value(other.value) { event(200u + value); }
  Owner(Owner&& other) : value(other.value) {
    other.value = 0;
    event(300u + value);
  }
  Owner& operator=(const Owner& other) {
    event(400u + value);
    value = other.value;
    return *this;
  }
  Owner& operator=(Owner&& other) {
    event(500u + value);
    unsigned incoming = other.value;
    other.value = 0;
    value = incoming;
    return *this;
  }
  ~Owner() { event(600u + value); }
};

template <typename T> struct Wrapper {
  // Member lifecycle is selected after template instantiation.
  T value;
  explicit Wrapper(unsigned seed) : value(seed) {}
  Wrapper(const Wrapper&) = default;
  Wrapper(Wrapper&&) = default;
  Wrapper& operator=(const Wrapper&) = default;
  Wrapper& operator=(Wrapper&&) = default;
};
void run() {
  Wrapper<Owner> first(9u);
  Wrapper<Owner> second(first);
  Wrapper<Owner> third(static_cast<Wrapper<Owner>&&>(first));
  second = third;
  third = static_cast<Wrapper<Owner>&&>(second);
}

