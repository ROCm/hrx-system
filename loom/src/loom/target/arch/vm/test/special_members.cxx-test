// ====
// Other selected plain-assignment overloads retain their declared result type.
[[loom::import("lifetime", "event")]] void event(unsigned value);

struct Value {
  // Payload whose changes make lifecycle effects observable.
  unsigned value;
  unsigned operator=(unsigned next) {
    value = next;
    event(100u + value);
    return value + 1u;
  }
};
struct Sink {
  // Payload whose changes make lifecycle effects observable.
  unsigned value;
  void operator=(unsigned next) { value = next; event(200u + value); }
};

void run() {
  Value value{1u};
  unsigned result = (value = 7u);
  event(result * 10u + value.value);
  Sink sink{2u};
  sink = 9u;
  event(sink.value);
}

