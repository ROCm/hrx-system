// ====
// Assignment notation sequences RHS first and returns the destination alias.
[[loom::import("lifetime", "event")]] void event(unsigned value);

struct Owner {
  // Payload whose changes make lifecycle effects observable.
  unsigned value;
  explicit Owner(unsigned value) : value(value) { event(100u + value); }
  Owner(const Owner& other) : value(other.value) { event(200u + value); }
  Owner(Owner&& other) : value(other.value) {
    other.value = 0;
    event(300u + value);
  }
  Owner& operator=(const Owner& other) {
    event(400u + value);
    value = other.value;
    return *this;
  }
  Owner& operator=(Owner&& other) {
    event(500u + value);
    unsigned incoming = other.value;
    other.value = 0;
    value = incoming;
    return *this;
  }
  ~Owner() { event(600u + value); }
};

Owner& left(Owner& value) { event(801u); return value; }
const Owner& right(const Owner& value) { event(802u); return value; }
void run() {
  Owner first(3u);
  Owner second(4u);
  (left(first) = right(second)).value += 1u;
  event(700u + first.value);
  first.operator=(second);
  event(700u + first.value);
}

