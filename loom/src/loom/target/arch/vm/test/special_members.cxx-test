// ====
// A move-only record transfers; a copy-only record accepts an xvalue by copy.

[[loom::import("lifetime", "event")]] void event(unsigned value);
struct MoveOnly {
  // Payload whose changes make lifecycle effects observable.
  unsigned value;
  explicit MoveOnly(unsigned value) : value(value) {}
  MoveOnly(const MoveOnly&) = delete;
  MoveOnly& operator=(const MoveOnly&) = delete;
  MoveOnly(MoveOnly&& other) : value(other.value) { other.value = 0; event(100u + value); }
  MoveOnly& operator=(MoveOnly&& other) {
    unsigned incoming = other.value;
    other.value = 0;
    value = incoming;
    event(200u + value);
    return *this;
  }
};
struct CopyOnly {
  // Payload whose changes make lifecycle effects observable.
  unsigned value;
  explicit CopyOnly(unsigned value) : value(value) {}
  CopyOnly(const CopyOnly& other) : value(other.value) { event(300u + value); }
  CopyOnly& operator=(const CopyOnly& other) {
    value = other.value;
    event(400u + value);
    return *this;
  }
};
void run() {
  MoveOnly source(7u);
  MoveOnly moved(static_cast<MoveOnly&&>(source));
  source = static_cast<MoveOnly&&>(moved);
  event(source.value * 10u + moved.value);
  CopyOnly original(9u);
  CopyOnly copy(static_cast<CopyOnly&&>(original));
  original = static_cast<CopyOnly&&>(copy);
  event(original.value * 10u + copy.value);
}

