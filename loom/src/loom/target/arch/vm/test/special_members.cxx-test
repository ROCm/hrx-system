// ====
// Copy-list initialization, nested aggregate clauses, and temporaries execute once.
[[loom::import("lifetime", "event")]] void event(unsigned value);

struct Owner {
  // Payload whose changes make lifecycle effects observable.
  unsigned value;
  explicit Owner(unsigned value) : value(value) { event(100u + value); }
  Owner(const Owner& other) : value(other.value) { event(200u + value); }
  Owner(Owner&& other) : value(other.value) {
    other.value = 0;
    event(300u + value);
  }
  Owner& operator=(const Owner& other) {
    event(400u + value);
    value = other.value;
    return *this;
  }
  Owner& operator=(Owner&& other) {
    event(500u + value);
    unsigned incoming = other.value;
    other.value = 0;
    value = incoming;
    return *this;
  }
  ~Owner() { event(600u + value); }
};

struct Aggregate {
  // Nested owner is copy-initialized by the aggregate clause.
  Owner owner;
};
void inspect(const Owner& value) { event(800u + value.value); }
void run() {
  Owner first(2u);
  Owner second = first;
  Owner third{second};
  Owner fourth = {third};
  Aggregate aggregate{first};
  inspect(Owner(first));
  event(900u);
}

