// ====
// By-value calls and returned objects retain selected moves and exactly one cleanup.
[[loom::import("lifetime", "event")]] void event(unsigned value);

struct Owner {
  // Payload whose changes make lifecycle effects observable.
  unsigned value;
  explicit Owner(unsigned value) : value(value) { event(100u + value); }
  Owner(const Owner& other) : value(other.value) { event(200u + value); }
  Owner(Owner&& other) : value(other.value) {
    other.value = 0;
    event(300u + value);
  }
  Owner& operator=(const Owner& other) {
    event(400u + value);
    value = other.value;
    return *this;
  }
  Owner& operator=(Owner&& other) {
    event(500u + value);
    unsigned incoming = other.value;
    other.value = 0;
    value = incoming;
    return *this;
  }
  ~Owner() { event(600u + value); }
};

void consume(Owner value) { event(800u + value.value); }
Owner make(unsigned value) { return Owner(value); }
Owner relay(Owner value) { return value; }
void run() {
  Owner source(5u);
  consume(source);
  event(900u);
  consume(static_cast<Owner&&>(source));
  event(901u);
  Owner result = make(6u);
  Owner relayed = relay(static_cast<Owner&&>(result));
  event(902u + relayed.value);
}

