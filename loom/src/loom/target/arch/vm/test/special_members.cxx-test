// ====
// Explicit calls to trivial special members still return the destination alias.
[[loom::import("lifetime", "event")]] void event(unsigned value);

struct Value {
  // Payload whose changes make lifecycle effects observable.
  unsigned value;
  Value(const Value&) = default;
  Value(Value&&) = default;
  Value& operator=(const Value&) = default;
  Value& operator=(Value&&) = default;
  explicit Value(unsigned value) : value(value) {}
};

void run() {
  Value first(1u);
  Value second(2u);
  first.operator=(second).value = 3u;
  second.operator=(static_cast<Value&&>(first)).value = 4u;
  Value third(first);
  Value fourth(static_cast<Value&&>(second));
  event(first.value * 1000u + second.value * 100u +
        third.value * 10u + fourth.value);
}

