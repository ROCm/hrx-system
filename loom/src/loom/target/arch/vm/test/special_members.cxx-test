// ====
// Overload selection distinguishes mutable, const, and xvalue sources.

[[loom::import("lifetime", "event")]] void event(unsigned value);
struct Selected {
  // Payload whose changes make lifecycle effects observable.
  unsigned value;
  explicit Selected(unsigned value) : value(value) {}
  Selected(Selected&) : value(1u) { event(101u); }
  Selected(const Selected&) = default;
  Selected(Selected&&) : value(3u) { event(103u); }
  Selected& operator=(Selected&) { value = 4u; event(104u); return *this; }
  Selected& operator=(const Selected&) = default;
  Selected& operator=(Selected&&) { value = 6u; event(106u); return *this; }
};
void run() {
  Selected source(7u);
  const Selected fixed(8u);
  Selected first(source);
  Selected second(fixed);
  Selected third(static_cast<Selected&&>(source));
  event(first.value * 100u + second.value * 10u + third.value);
  first = source;
  second = fixed;
  third = static_cast<Selected&&>(source);
  event(first.value * 100u + second.value * 10u + third.value);
}

