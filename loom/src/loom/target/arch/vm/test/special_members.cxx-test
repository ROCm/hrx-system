// ====
// Array leaf constructors evaluate defaults and retire their temporaries per element.

[[loom::import("lifetime", "event")]] void event(unsigned value);
struct Marker {
  // Payload whose changes make lifecycle effects observable.
  unsigned value;
  explicit Marker(unsigned value) : value(value) { event(100u + value); }
  ~Marker() { event(200u + value); }
};
struct Element {
  // Payload whose changes make lifecycle effects observable.
  unsigned value;
  explicit Element(unsigned value) : value(value) {}
  Element(const Element& other, const Marker& marker = Marker(3u))
      : value(other.value + marker.value) { event(300u + value); }
};
struct Grid {
  // Array leaves are initialized in row-major order.
  Element values[2][2];
  Grid() : values{{Element(1u), Element(2u)}, {Element(3u), Element(4u)}} {}
};
void run() {
  Grid original;
  Grid copied(original);
  event(copied.values[0][0].value * 100u + copied.values[1][1].value);
}

