low.func.def target<vm.core>(@vm) @forward_ptr(%input: reg<vm.ref : ptr<@Object>>) -> (reg<vm.ref : ptr<@Object>>) asm {
  low.br ^current(%input: reg<vm.ref : ptr<@Object>>)
^current(%value: reg<vm.ref : ptr<@Object>>):
  %copy = copy %value : reg<vm.ref : ptr<@Object>> -> reg<vm.ref : ptr<@Object>>
  low.release %copy : reg<vm.ref : ptr<@Object>>
  low.func.call @observe(%value) : (reg<vm.ref : ptr<@Object>>)
  low.br ^exit(%value: reg<vm.ref : ptr<@Object>>)
^exit(%result: reg<vm.ref : ptr<@Object>>):
  return %result
}
