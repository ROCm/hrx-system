load("//build_tools/bazel:python.bzl", "iree_py_test")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")
load("//loom/build_tools/bazel:loom_check.bzl", "loom_check_test", "loom_check_test_suite")

package(
    default_visibility = ["//visibility:private"],
    licenses = ["notice"],  # Apache 2.0
)

loom_check_test_suite(
    name = "test",
    srcs = [
        "activation.loom-test",
        "assembly.loom-test",
        "atomic_policy.loom-test",
        "effects.loom-test",
        "inverse_hyperbolic.loom-test",
        "math_contraction.loom-test",
        "math_policy.loom-test",
        "remainder.loom-test",
        "rounding.loom-test",
        "scalar.loom-test",
        "scaling.loom-test",
    ],
    target_compatible_with = loom_config_compatible_with(["//loom/config/arch:vm"]),
)

loom_check_test_suite(
    name = "artifact_test",
    srcs = [
        "buffer_packets.loom-test",
        "call_overflow.loom-test",
        "calls.loom-test",
        "emission.loom-test",
        "imports.loom-test",
        "managed_consumption.loom-test",
        "managed_types.loom-test",
        "native_references.loom-test",
        "object_borrow_retirement.loom-test",
        "object_borrow_transport.loom-test",
        "object_copy.loom-test",
        "object_dead_lifetimes.loom-test",
        "object_lifetime.loom-test",
        "object_release.loom-test",
        "object_source_borrow.loom-test",
        "object_source_borrow_cfg.loom-test",
        "object_source_borrow_emit.loom-test",
        "object_source_copy.loom-test",
        "object_source_release.loom-test",
        "object_state.loom-test",
        "reference_transfers.loom-test",
        "storage.loom-test",
        "storage_transfers.loom-test",
    ],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/emit:vm_binary",
    ]),
)

loom_check_test(
    name = "reference_evaluation_test",
    src = "reference_evaluation.cxx-test",
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/import:cxx",
        "//loom/config/emit:vm_binary",
    ]),
)

loom_check_test(
    name = "value_evaluation_test",
    src = "value_evaluation.cxx-test",
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/import:cxx",
        "//loom/config/emit:vm_binary",
    ]),
)

loom_check_test(
    name = "special_members_test",
    src = "special_members.cxx-test",
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/import:cxx",
        "//loom/config/emit:vm_binary",
    ]),
)

iree_py_test(
    name = "source_roundtrip_test",
    size = "small",
    srcs = ["source_roundtrip_test.py"],
    args = [
        "--importer=$(rootpath //loom/src/loom/tools/loom-import-cxx)",
        "--checker=$(rootpath //loom/src/loom/tools/loom-check:loom-check-test)",
        "--source=$(rootpath special_members.cxx-test)",
        "--source=$(rootpath value_evaluation.cxx-test)",
    ],
    data = [
        "special_members.cxx-test",
        "value_evaluation.cxx-test",
        "//loom/src/loom/tools/loom-check:loom-check-test",
        "//loom/src/loom/tools/loom-import-cxx",
    ],
    tags = ["skip-bazel_to_cmake"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/import:cxx",
        "//loom/config/emit:vm_binary",
    ]),
    deps = ["//loom/py/loom/tools:export_cxx"],
)
