// ====

// A local slot owns the only remaining protection. Its reload feeds direct and
// overflow arguments without extra owners; the slot outlives the call.
// RUN: emit vm-object-lifetime
vm.target<core> @vm

type.decl import("lifetime", "object") @Object

low.func.decl import(native, "create", module = "lifetime") target<vm.core>(@vm) abi(vm_function) @create(%identity: reg<vm.value : i32>) -> (reg<vm.ref : ref<@Object>>, reg<vm.ref : ptr<@Object>>)

low.func.decl import(native, "count", module = "lifetime") target<vm.core>(@vm) abi(vm_function) @count(%pointer: reg<vm.ref : ptr<@Object>>)

low.func.def noinline target<vm.core>(@vm) abi(vm_function) @overflow(%first: reg<vm.ref : ptr<@Object>>, %unused1: reg<vm.ref : ptr<@Object>>, %unused2: reg<vm.ref : ptr<@Object>>, %unused3: reg<vm.ref : ptr<@Object>>, %unused4: reg<vm.ref : ptr<@Object>>, %unused5: reg<vm.ref : ptr<@Object>>, %unused6: reg<vm.ref : ptr<@Object>>, %unused7: reg<vm.ref : ptr<@Object>>, %unused8: reg<vm.ref : ptr<@Object>>, %unused9: reg<vm.ref : ptr<@Object>>, %unused10: reg<vm.ref : ptr<@Object>>, %unused11: reg<vm.ref : ptr<@Object>>, %unused12: reg<vm.ref : ptr<@Object>>, %unused13: reg<vm.ref : ptr<@Object>>, %unused14: reg<vm.ref : ptr<@Object>>, %unused15: reg<vm.ref : ptr<@Object>>, %last: reg<vm.ref : ptr<@Object>>) asm {
  low.func.call @count(%first) : (reg<vm.ref : ptr<@Object>>)
  low.func.call @count(%last) : (reg<vm.ref : ptr<@Object>>)
  return
}

low.func.def public target<vm.core>(@vm) abi(vm_function) @run() asm {
  %identity = constant.i32 1
  %owner, %pointer = low.func.call @create(%identity) : (reg<vm.value : i32>) -> (reg<vm.ref : ref<@Object>>, reg<vm.ref : ptr<@Object>>)
  low.release %owner : reg<vm.ref : ref<@Object>>
  %slot = storage {byte_alignment = 16, byte_length = 16} : low.storage<private>
  low.spill.move %pointer, %slot : reg<vm.ref : ptr<@Object>>, low.storage<private>
  %loaded = low.reload %slot : low.storage<private> -> reg<vm.ref : ptr<@Object>>
  low.func.call @overflow(%loaded, %loaded, %loaded, %loaded, %loaded, %loaded, %loaded, %loaded, %loaded, %loaded, %loaded, %loaded, %loaded, %loaded, %loaded, %loaded, %loaded) : (reg<vm.ref : ptr<@Object>>, reg<vm.ref : ptr<@Object>>, reg<vm.ref : ptr<@Object>>, reg<vm.ref : ptr<@Object>>, reg<vm.ref : ptr<@Object>>, reg<vm.ref : ptr<@Object>>, reg<vm.ref : ptr<@Object>>, reg<vm.ref : ptr<@Object>>, reg<vm.ref : ptr<@Object>>, reg<vm.ref : ptr<@Object>>, reg<vm.ref : ptr<@Object>>, reg<vm.ref : ptr<@Object>>, reg<vm.ref : ptr<@Object>>, reg<vm.ref : ptr<@Object>>, reg<vm.ref : ptr<@Object>>, reg<vm.ref : ptr<@Object>>, reg<vm.ref : ptr<@Object>>)
  return
}

