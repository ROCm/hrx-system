references 2
read 1
references 1
OK 1
destroy 1
retired 0

// ====

// One protected carrier anchors repeated direct and overflow arguments across
// a source loop. The original owner is gone before the calls. The child may
// retire unused arguments and return an alias; only that escaping result needs
// a new owner, which is released before the next submission.
// RUN: emit vm-object-lifetime
type.decl import("lifetime", "object") @Object

func.decl import("lifetime", "create") @create(%identity: i32) -> (ref<@Object>, ptr<@Object>)

func.decl import("lifetime", "consume") @consume(%owner: ref<@Object>)

func.decl import("lifetime", "count") @count(%pointer: ptr<@Object>)

func.decl import("lifetime", "read") @read(%pointer: ptr<@Object>)

func.decl import("lifetime", "observe") @observe()

func.def noinline @overflow(%first: ptr<@Object>, %unused1: ptr<@Object>, %unused2: ptr<@Object>, %unused3: ptr<@Object>, %unused4: ptr<@Object>, %unused5: ptr<@Object>, %unused6: ptr<@Object>, %unused7: ptr<@Object>, %unused8: ptr<@Object>, %unused9: ptr<@Object>, %unused10: ptr<@Object>, %unused11: ptr<@Object>, %unused12: ptr<@Object>, %unused13: ptr<@Object>, %unused14: ptr<@Object>, %unused15: ptr<@Object>, %last: ptr<@Object>) -> (ptr<@Object>) {
  func.call @count(%first) : (ptr<@Object>)
  func.call @count(%last) : (ptr<@Object>)
  func.return %last : ptr<@Object>
}

func.def public @run() {
  %identity = scalar.constant 1 : i32
  %owner, %unused = func.call @create(%identity) : (i32) -> (ref<@Object>, ptr<@Object>)
  // REMARK@+1: DOMINANCE/021
  %pointer = ref.borrow %owner : ref<@Object> -> ptr<@Object>
  func.call @consume(%owner) : (ref<@Object>)
  %begin = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  scf.for %iteration = [%begin to %end step %step] {
    %returned = func.call @overflow(%pointer, %pointer, %pointer, %pointer, %pointer, %pointer, %pointer, %pointer, %pointer, %pointer, %pointer, %pointer, %pointer, %pointer, %pointer, %pointer, %pointer) : (ptr<@Object>, ptr<@Object>, ptr<@Object>, ptr<@Object>, ptr<@Object>, ptr<@Object>, ptr<@Object>, ptr<@Object>, ptr<@Object>, ptr<@Object>, ptr<@Object>, ptr<@Object>, ptr<@Object>, ptr<@Object>, ptr<@Object>, ptr<@Object>, ptr<@Object>) -> (ptr<@Object>)
    func.call @read(%returned) : (ptr<@Object>)
  }
  func.call @read(%pointer) : (ptr<@Object>)
  func.call @observe() : ()
  func.return
}

// ----
create 1
consume 1
references 1
references 1
read 1
references 1
references 1
read 1
