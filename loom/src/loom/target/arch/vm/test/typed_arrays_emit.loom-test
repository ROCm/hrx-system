// RUN: emit vm-dis target=vm:core

// Typed source arrays use byte-stack reservations, with no managed buffer.
func.def public @arrays(%value: i64, %position: index) -> (i64, i32) {
  %bounded = index.assume %position [range(%position, 0, 3)] : index
  %left = view.alloca<private> : view<4xi64>
  %right = view.alloca<private> align(16) : view<4xi32>
  %word = scalar.trunci %value : i64 to i32
  view.store %value, %left[%bounded] : i64, view<4xi64>
  view.store %word, %right[2] : i32, view<4xi32>
  %original = view.load %left[%bounded] : view<4xi64> -> i64
  %other = view.load %right[2] : view<4xi32> -> i32
  func.return %original, %other : i64, i32
}

// ----
vm.module core(0.0) {
  section strings alignment(8) {
    string @string0 = "arrays"
  }

  section signatures alignment(8) {
    signature @signature0 (i64, i64) -> (i64, i32)
  }

  section callable_types alignment(8) {
    callable @callable0 flags([]) depth(0) : @signature0
  }

  section exports alignment(8) {
    export @export0 name(@string0) : @callable0 = @function0
  }

  section functions alignment(8) {
    func @function0 : @callable0 flags([]) frame(local_bytes = 48, value_registers = 6, ref_registers = 0, function_registers = 0, local_refs = 0, local_functions = 0) {
    ^bb0:
      control.block
      %v2 = constant.i32 0x00000000
      %v3 = constant.i32 0x00000020
      %v4 = conversion.integer %v0 {selector = i64.to.i32}
      %v5 = constant.s16 3
      %v1 = integer.shift.left.i64 %v1, %v5
      %v1 = integer.add.i64 %v2, %v1
      stack.store.indexed.i64 #v0, %v1, %v0.x1 {scale = 1}
      %v0 = constant.s16 8
      %v0 = integer.add.i64 %v3, %v0
      stack.store.indexed.i32 #v0, %v0, %v4.x1 {scale = 1}
      %v1.x1 = stack.load.indexed.i64 #v0, %v1 {scale = 1}
      %v0.x1 = stack.load.indexed.i32 #v0, %v0 {scale = 1}
      %v2 = value.copy %v1
      %v1 = value.copy %v0
      %v0 = value.copy %v2
      control.return
    }
  }

}
