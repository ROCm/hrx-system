// ====

func.decl import("lifetime", "event") @event(%value: i32)

// Recursive calls exchange the parameter qualifiers. The source projection
// reaches a finite set of signatures and retains each call's selected one.
func.def noinline @rotate(%first: buffer, %second: buffer, %count: index) -> (buffer) {
  %c0 = index.constant 0 : index
  %done = index.cmp eq, %count, %c0 : index
  func.exit %done : i1 {
    func.return %first : buffer
  }
  %c1 = index.constant 1 : index
  %remaining = index.sub %count, %c1 : index
  %result = func.call @rotate(%second, %first, %remaining) : (buffer, buffer, index) -> (buffer)
  func.return %result : buffer
}

func.def noinline @observe(%data: buffer) {
  %c0 = index.constant 0 : offset
  %view = buffer.view %data[%c0] : buffer -> view<1xi8>
  %byte = view.load %view[0] : view<1xi8> -> i8
  %value = scalar.extui %byte : i8 to i32
  func.call @event(%value) : (i32)
  func.return
}

func.def public @run() {
  %constant = buffer.constant bytes("0b") : buffer
  %storage = buffer.alloca.init<private> align(1) bytes("16") : buffer
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %initial = func.call @rotate(%constant, %storage, %c0) : (buffer, buffer, index) -> (buffer)
  %odd = func.call @rotate(%constant, %storage, %c1) : (buffer, buffer, index) -> (buffer)
  %even = func.call @rotate(%constant, %storage, %c2) : (buffer, buffer, index) -> (buffer)
  func.call @observe(%initial) : (buffer)
  func.call @observe(%odd) : (buffer)
  func.call @observe(%even) : (buffer)
  func.return
}

