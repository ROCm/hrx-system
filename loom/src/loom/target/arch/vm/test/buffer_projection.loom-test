// RUN: emit vm-object-lifetime

func.decl import("lifetime", "event") @event(%value: i32)

// One IR helper serves both immutable data and writable caller-owned storage.
func.def noinline @identity(%value: buffer) -> (buffer) {
  func.return %value : buffer
}

func.def noinline @pair(%left: buffer, %right: buffer) -> (buffer, buffer) {
  %a = func.call pure @identity(%left) : (buffer) -> (buffer)
  %b = func.call pure @identity(%right) : (buffer) -> (buffer)
  func.return %a, %b : buffer, buffer
}

func.def noinline @literal() -> (buffer) {
  %data = buffer.constant bytes("0b") : buffer
  func.return %data : buffer
}

func.def noinline @select(%first: buffer, %second: buffer, %condition: i1) -> (buffer) {
  %selected = scf.select %condition, %first, %second : buffer
  func.return %selected : buffer
}

func.def noinline @observe(%data: buffer) {
  %c0 = index.constant 0 : offset
  %view = buffer.view %data[%c0] : buffer -> view<1xi8>
  %byte = view.load %view[0] : view<1xi8> -> i8
  %value = scalar.extui %byte : i8 to i32
  func.call @event(%value) : (i32)
  func.return
}

func.def public @run() {
  %constant = func.call pure @literal() : () -> (buffer)
  %storage = buffer.alloca.init<private> align(1) bytes("16") : buffer
  %first, %second = func.call pure @pair(%constant, %storage) : (buffer, buffer) -> (buffer, buffer)
  %c0 = index.constant 0 : offset
  %writable = buffer.view %second[%c0] : buffer -> view<1xi8>
  %replacement = scalar.constant 33 : i8
  view.store %replacement, %writable[0] : i8, view<1xi8>
  func.call @observe(%first) : (buffer)
  func.call @observe(%second) : (buffer)
  %true = scalar.constant true : i1
  %false = scalar.constant false : i1
  %selected_first = func.call pure @select(%first, %second, %true) : (buffer, buffer, i1) -> (buffer)
  %selected_second = func.call pure @select(%first, %second, %false) : (buffer, buffer, i1) -> (buffer)
  func.call @observe(%selected_first) : (buffer)
  func.call @observe(%selected_second) : (buffer)
  func.return
}

