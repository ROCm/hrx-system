// ====

// Qualifiers join over loop backedges without changing the outside owner.
func.decl import("lifetime", "event") @event(%value: i32)

func.def noinline @choose(%initial: buffer, %replacement: buffer, %count: index) -> (buffer) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %result = scf.for %i = [%c0 to %count step %c1](%value = %initial : buffer) -> (buffer) {
    scf.yield %replacement : buffer
  }
  func.return %result : buffer
}

func.def noinline @observe(%data: buffer) {
  %c0 = index.constant 0 : offset
  %view = buffer.view %data[%c0] : buffer -> view<1xi8>
  %byte = view.load %view[0] : view<1xi8> -> i8
  %value = scalar.extui %byte : i8 to i32
  func.call @event(%value) : (i32)
  func.return
}

func.def public @run() {
  %storage = buffer.alloca.init<private> align(1) bytes("16") : buffer
  %constant = buffer.constant bytes("0b") : buffer
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %unchanged = func.call pure @choose(%storage, %constant, %c0) : (buffer, buffer, index) -> (buffer)
  %replaced = func.call pure @choose(%storage, %constant, %c1) : (buffer, buffer, index) -> (buffer)
  func.call @observe(%unchanged) : (buffer)
  func.call @observe(%replaced) : (buffer)
  %offset = index.constant 0 : offset
  %writable = buffer.view %storage[%offset] : buffer -> view<1xi8>
  %replacement = scalar.constant 44 : i8
  view.store %replacement, %writable[0] : i8, view<1xi8>
  func.call @observe(%storage) : (buffer)
  func.return
}

