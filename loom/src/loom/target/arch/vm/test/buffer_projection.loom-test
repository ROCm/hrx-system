// ====

func.decl import("lifetime", "event") @event(%value: i32)

// The loop header publishes a result group different from its input group.
func.def noinline @choose(%initial: buffer, %replacement: buffer, %again: i1) -> (buffer) {
  %result = scf.while(%flag = %again : i1, %value = %initial : buffer) -> (buffer) {
    scf.condition %flag, %value : i1, buffer
  } do(%current: buffer) {
    %false = scalar.constant false : i1
    scf.yield %false, %replacement : i1, buffer
  }
  func.return %result : buffer
}

// A callable exit joins return qualification without qualifying its input.
func.def noinline @early(%input: buffer, %condition: i1) -> (buffer) {
  func.exit %condition : i1 {
    %constant = buffer.constant bytes("0b") : buffer
    func.return %constant : buffer
  }
  func.return %input : buffer
}

func.def noinline @observe(%data: buffer) {
  %c0 = index.constant 0 : offset
  %view = buffer.view %data[%c0] : buffer -> view<1xi8>
  %byte = view.load %view[0] : view<1xi8> -> i8
  %value = scalar.extui %byte : i8 to i32
  func.call @event(%value) : (i32)
  func.return
}

func.def public @run() {
  %storage = buffer.alloca.init<private> align(1) bytes("16") : buffer
  %constant = buffer.constant bytes("0b") : buffer
  %false = scalar.constant false : i1
  %true = scalar.constant true : i1
  %unchanged = func.call pure @choose(%storage, %constant, %false) : (buffer, buffer, i1) -> (buffer)
  %replaced = func.call pure @choose(%storage, %constant, %true) : (buffer, buffer, i1) -> (buffer)
  func.call @observe(%unchanged) : (buffer)
  func.call @observe(%replaced) : (buffer)
  %early = func.call @early(%storage, %true) : (buffer, i1) -> (buffer)
  %late = func.call @early(%storage, %false) : (buffer, i1) -> (buffer)
  func.call @observe(%early) : (buffer)
  func.call @observe(%late) : (buffer)
  func.return
}

