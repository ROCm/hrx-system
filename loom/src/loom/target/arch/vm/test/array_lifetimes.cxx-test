// ====
// An implicit array member copy evaluates and retires its default arguments
// independently for each copied element.
[[loom::import("lifetime", "event")]] void observe(unsigned value);
struct Guard {
  // Payload observed by construction or destruction.
  unsigned value;
  ~Guard() { observe(value); }
};
struct Element {
  // Payload observed by construction or destruction.
  unsigned value;
  Element(const Element& other, const Guard& argument = Guard{6})
      : value(other.value + argument.value) {
    observe(200 + value);
  }
  Element(const Guard& argument = Guard{8}) : value(argument.value) {
    observe(100 + value);
  }
};
struct Packet {
  // Elements initialized by the synthesized constructor.
  Element elements[2];
};
void run() {
  Packet source{{Element{Guard{1}}, Element{Guard{2}}}};
  Packet copied(source);
  observe(copied.elements[0].value + copied.elements[1].value);
}

