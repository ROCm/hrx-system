// ====
// A synthesized member initializer preserves the array leaf constructor
// arguments.
[[loom::import("lifetime", "event")]] void observe(unsigned value);
struct Guard {
  // Payload observed by construction or destruction.
  unsigned value;
  ~Guard() { observe(value); }
};
struct Element {
  // Payload observed by construction or destruction.
  unsigned value;
  Element(const Guard& argument = Guard{8}) : value(argument.value) {
    observe(100 + value);
  }
};
struct Packet {
  // Elements initialized by the synthesized constructor.
  Element elements[2];
};
void run() {
  Packet packet;
  observe(packet.elements[0].value + packet.elements[1].value);
}

