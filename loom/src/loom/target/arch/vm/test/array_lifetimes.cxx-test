event 5
event 6
event 9
OK 0
retired 0

// ====
// Saving a decayed pointer does not extend the complete temporary. The pointer
// is never dereferenced after destruction.
[[loom::import("lifetime", "event")]] void observe(unsigned);
struct Holder {
  // Elements whose sum identifies complete-object destruction.
  unsigned values[2];
  ~Holder() { observe(values[0] + values[1]); }
};
void run() {
  auto* unused = Holder{{4, 5}}.values;
  observe(6);
}

