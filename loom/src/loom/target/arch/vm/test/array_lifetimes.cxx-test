// ====
// Default construction repeats the selected leaf plan through every array
// extent.
[[loom::import("lifetime", "event")]] void observe(unsigned value);
struct Guard {
  // Payload observed by construction or destruction.
  unsigned value;
  ~Guard() { observe(value); }
};
struct Element {
  // Payload observed by construction or destruction.
  unsigned value;
  Element(const Guard& argument = Guard{8}) : value(argument.value) {
    observe(100 + value);
  }
};
void run() {
  Element elements[2][2];
  observe(elements[0][0].value + elements[1][1].value);
}

