// RUN: emit vm-object-lifetime
// INPUT: cxx root=run
// Default constructor arguments are evaluated separately for each element.
// Their temporaries retire before construction of the next element.
[[loom::import("lifetime", "event")]] void observe(unsigned value);
struct Guard {
  // Payload observed by construction or destruction.
  unsigned value;
  ~Guard() { observe(value); }
};
struct Element {
  // Payload observed by construction or destruction.
  unsigned value;
  Element(const Guard& argument = Guard{8}) : value(argument.value) {
    observe(100 + value);
  }
};
void run() {
  Element elements[2];
  observe(elements[0].value + elements[1].value);
}

