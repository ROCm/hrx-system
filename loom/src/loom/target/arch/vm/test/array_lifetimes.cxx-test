// ====
// Explicit initializer temporaries survive the whole list. Omitted element
// default arguments finish before the following element starts.
[[loom::import("lifetime", "event")]] void observe(unsigned value);
struct Guard {
  // Payload observed by construction or destruction.
  unsigned value;
  ~Guard() { observe(value); }
};
struct Element {
  // Payload observed by construction or destruction.
  unsigned value;
  Element(const Guard& argument = Guard{8}) : value(argument.value) {
    observe(100 + value);
  }
};
void run() {
  Element elements[3]{Element{Guard{3}}};
  observe(elements[0].value + elements[1].value + elements[2].value);
}

