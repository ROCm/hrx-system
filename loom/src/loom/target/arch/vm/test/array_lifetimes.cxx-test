// ====
// An element reference extends the complete temporary array, whose elements
// retire in reverse construction order.
[[loom::import("lifetime", "event")]] void observe(unsigned);
struct Guard {
  // Payload reported at element destruction.
  unsigned value;
  ~Guard() { observe(value); }
};
using Pair = Guard[2];
void run() {
  const Guard& value = Pair{{4}, {5}}[1];
  observe(value.value + 10);
}

