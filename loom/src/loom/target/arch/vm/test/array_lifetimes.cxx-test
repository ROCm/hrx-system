// ====
// Binding to an array subobject extends the complete temporary through the
// scope.
[[loom::import("lifetime", "event")]] void observe(unsigned);
struct Holder {
  // Elements whose sum identifies complete-object destruction.
  unsigned values[2];
  ~Holder() { observe(values[0] + values[1]); }
};
void run() {
  const unsigned& value = Holder{{4, 5}}.values[1];
  observe(value);
  observe(6);
}

