// RUN: emit vm-dis

vm.target<core> @vm

// Cardinalities and optional presence belong to the callsite, not the export.
func.def public target(@vm) @copy(%queue: hal.queue, %semaphore: hal.semaphore, %source: hal.buffer, %target: hal.buffer, %offset: i64, %length: i64, %value: i64, %scope: i32, %stage: i32, %flags: i64, %effects: i32) {
  hal.queue.copy (%queue, [(%semaphore, %value)], [], (%source, %offset), (%target, %offset), %length, (none, []), %flags)
  hal.queue.copy (%queue, [], [(%semaphore, %value)], (%source, %offset), (%target, %offset), %length, ([(%stage, %stage, %flags, %effects, [(%scope, %scope)], []), (%stage, %stage, %flags, %effects, [], [(%scope, %scope, (%source, %offset, %length), none), (%scope, %scope, (%target, %offset, %length), (%effects, []))])], none), %flags)
  func.return
}

