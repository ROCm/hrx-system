// ====
// A forwarding call and both arms of the caller initialize only length. No
// pointer value is invented for the untouched field.
[[loom::import("lifetime", "event")]] void event(unsigned value);
struct Slice { unsigned* data; unsigned length; };
[[loom::noinline]] static void initialize(unsigned& value, unsigned input) { value = input; }
[[loom::noinline]] static unsigned length(const Slice& slice) { return slice.length; }
[[loom::noinline]] static unsigned forwarded(const Slice& slice) { return length(slice); }
[[loom::noinline]] static void conditional(Slice& slice, bool choose) {
  if (choose) { slice.length = 19; return; }
}
void run() {
  for (unsigned choice = 0; choice < 2; ++choice) {
    Slice slice;
    if (choice) initialize(slice.length, 11);
    else initialize(slice.length, 13);
    event(forwarded(slice));
    conditional(slice, choice != 0);
    event(forwarded(slice));
  }
  unsigned value;
  initialize(value, 23);
  event(value);
}
