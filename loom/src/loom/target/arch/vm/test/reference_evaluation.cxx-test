// ====
// Every source read precedes or follows definitions according to C++ sequencing,
// including assignment destinations, loop increments, and short-circuit paths.
[[loom::import("lifetime", "event")]] void event(unsigned value);
struct State { unsigned length; unsigned unused; };
[[loom::noinline]] static void store(unsigned* output, State& state) {
  output[state.length = 1] = state.length;
}
[[loom::noinline]] static unsigned define(State& state) { state.length = 3; return 1; }
[[loom::noinline]] static void loop(State& state, unsigned count) {
  for (unsigned index = 0; index < count; index += state.length) {
    state.length = 1;
    if (count == 9) break;
  }
}
[[loom::noinline]] static void ordered(State& state, unsigned* output) {
  store(output, state);
  event(state.length);
  event(state.length && define(state));
  event(state.length);
}
void run() {
  unsigned output[2]{0, 0};
  State state;
  state.length = 17;
  ordered(state, output);
  event(output[1]);
  loop(state, 0);
  event(state.length);
  loop(state, 2);
  event(state.length);
  state.length = 5;
  loop(state, 9);
  event(state.length);
}
