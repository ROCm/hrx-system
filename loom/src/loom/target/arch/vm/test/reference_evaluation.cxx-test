// ====
// A sparse result updates the temporary's destructor payload and preserves the
// fields which the helper never touched.
[[loom::import("lifetime", "event")]] void event(unsigned value);
struct Owner {
  unsigned value;
  unsigned preserved;
  ~Owner() { event(value); event(preserved); }
};
[[loom::noinline]] static void update(Owner&& owner) { owner.value = 29; }
[[loom::noinline]] static void initialize(unsigned& updated, const unsigned& observed) {
  updated = 31;
  event(observed);
}
void run() {
  update(Owner{7, 11});
  event(101);
  unsigned shared;
  initialize(shared, shared);
  event(shared);
}
