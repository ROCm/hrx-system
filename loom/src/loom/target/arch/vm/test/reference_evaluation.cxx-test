// ====
// Source selections transport only required groups and preserve read-only
// aliases of a selected receiver while evaluating exactly one helper call.
[[loom::import("lifetime", "event")]] void event(unsigned value);
struct Slice { unsigned* data; unsigned length; };
[[loom::noinline]] static unsigned advance(Slice& slice, unsigned step) {
  event(1);
  slice.length += step;
  return slice.length;
}
struct Cell {
  unsigned value;
  [[loom::noinline]] unsigned compare(const Cell& other) const { return value * 10 + other.value; }
};
void run() {
  for (unsigned choice = 0; choice < 2; ++choice) {
    Slice left, right;
    left.length = 5;
    right.length = 7;
    auto& chosen = choice ? left : right;
    event(advance(chosen, 3));
    event(left.length);
    event(right.length);
    Cell first{2}, second{3};
    event((choice ? first : second).compare(first));
  }
}
