// ====
// Partial receiver fields survive method calls and every lexical cleanup exit.
[[loom::import("lifetime", "event")]] void event(unsigned value);
struct Cursor {
  const float* data;
  unsigned position;
  unsigned* output;
  void reset() { position = 0; }
  ~Cursor() { *output = position; }
};
static void cursor(unsigned* output, bool early) {
  Cursor current;
  current.output = output;
  current.reset();
  if (early) { current.position = 3; return; }
  current.position = 4;
}
struct Leaf {
  float* unused;
  unsigned position;
  void reset() { position = 7; }
  void increment() { ++position; }
  ~Leaf() { event(position); }
};
struct Holder {
  Leaf nested;
  void reset() { nested.reset(); }
  void increment() { nested.increment(); }
  ~Holder() { nested.increment(); }
};
struct Derived : Leaf {
  unsigned unrelated;
  void initialize() { reset(); }
};
static void nested(bool early) {
  Holder holder;
  holder.reset();
  if (early) { holder.increment(); return; }
  holder.increment();
  holder.increment();
}
void run() {
  unsigned output = 99;
  cursor(&output, true);
  event(output);
  cursor(&output, false);
  event(output);
  nested(false);
  nested(true);
  { Derived item; item.initialize(); }
  for (unsigned i = 0; i < 3; ++i) {
    Leaf local;
    local.reset();
    if (i == 0) continue;
    local.increment();
    if (i == 1) break;
  }
}
