// ====
// Storage-backed references retain the once-evaluated address, and later
// argument evaluation may mutate the pointee before the callee reads it.
[[loom::import("lifetime", "event")]] void event(unsigned value);

static unsigned replace(unsigned& owner) { owner = 22; return 0; }
static void observe(const unsigned& value, unsigned) { event(value); }
static unsigned& at(unsigned* values) { return values[1]; }

void run() {
  unsigned values[2]{11, 33};
  observe(at(values), replace(values[1]));
  event(values[0]);
  event(values[1]);
}

