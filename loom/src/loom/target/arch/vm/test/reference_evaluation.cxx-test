// ====
// Destructor-body initialization precedes member/base destruction. Reference
// members retain their binding, and nested arrays destroy in reverse order.
[[loom::import("lifetime", "event")]] void event(unsigned value);
struct Leaf {
  float* unused;
  unsigned position;
  void reset() { position = 7; }
  ~Leaf() { event(position); }
};
struct InitializeOnExit {
  Leaf child;
  ~InitializeOnExit() { child.reset(); }
};
struct Reference {
  unsigned& output;
  unsigned ignored;
  void set(unsigned value) { output = value; }
  ~Reference() { event(output); }
};
struct Array {
  Leaf items[2];
};
void run() {
  { InitializeOnExit holder; }
  unsigned output = 0;
  { Reference reference{output, 19}; reference.set(12); }
  event(output);
  float unused = 0;
  { Array array{{{&unused, 2}, {&unused, 3}}}; }
}
