// ====
// Conditional outputs preserve the unselected object, including a reference
// selected against a by-value formal and a pointer's two-component payload.
[[loom::import("lifetime", "event")]] void event(unsigned value);
static void initialize(unsigned& value) { value = 17; }
[[loom::noinline]] static void maybe_initialize(unsigned& output, unsigned other, bool choose) {
  initialize(choose ? output : other);
}
struct Slice { const unsigned* data; unsigned unused; };
[[loom::noinline]] static void advance(Slice& slice) { ++slice.data; }
void run() {
  unsigned first[2]{5, 7};
  unsigned second[2]{11, 13};
  for (unsigned choice = 0; choice < 2; ++choice) {
    unsigned value = 3;
    maybe_initialize(value, 19, choice != 0);
    event(value);
    Slice left, right;
    left.data = first;
    right.data = second;
    advance(choice ? left : right);
    event(*left.data);
    event(*right.data);
  }
}
