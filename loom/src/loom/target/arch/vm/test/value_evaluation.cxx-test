// ====
// A builtin comma sequences its left operand while retaining the right
// operand's destination for references, assignments, and borrowed addresses.
[[loom::import("lifetime", "event")]] void event(unsigned value);
[[loom::noinline]] static void update(unsigned& value) { value += 10; }
void run() {
  unsigned value = 1;
  unsigned& selected = (event(2), value);
  selected = 3;
  (event(4), value) += 5;
  update((event(6), value));
  unsigned* pointer = &(event(7), value);
  *pointer += 2;
  event(value);
  unsigned values[] = {30, 40};
  (event(8), values)[1] = 50;
  event(values[1]);
}

