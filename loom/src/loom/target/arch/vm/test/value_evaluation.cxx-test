// ====
// An overloaded shift snapshots its by-value left operand, while the following
// mutation updates the original record. Member/prvalue forms retain the same
// rule when a later argument changes the source used to construct the receiver.
[[loom::import("lifetime", "event")]] void event(unsigned value);
struct Owner {
  // Saved payload of this source instance.
  unsigned value;
  void observe(unsigned) const { event(value); }
};
[[loom::noinline]] static unsigned replace(Owner& owner) { owner.value = 22; return 0; }
[[loom::noinline]] static void operator<<(Owner saved, unsigned) { event(saved.value); }
void run() {
  Owner owner{11};
  owner << replace(owner);
  event(owner.value);
  owner.value = 11;
  Owner{owner.value}.observe(replace(owner));
  event(owner.value);
}
