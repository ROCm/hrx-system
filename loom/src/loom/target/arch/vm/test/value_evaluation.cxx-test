  // Sum accumulated by the selected list constructor.
  unsigned value = 0;
  Sum(std::initializer_list<unsigned> values) {
    for (auto element : values) value += element;
  }
};
void run() {
  Sum named{3u, 5u};
  event(named.value);
  event(Sum{7u, 11u}.value);
