// ====
// ADL lookup with pointer iterators preserves references to original elements.
[[loom::import("lifetime", "event")]] void event(unsigned value);
namespace custom {
struct Range {
  // Inclusive start and exclusive end of caller-owned storage.
  int* first;
  // One-past-end pointer, including for an empty range.
  int* last;
};
static int* begin(Range& range) { return range.first; }
static int* end(Range& range) { return range.last; }
}
void run() {
  int values[3] = {2, 5, 9};
  custom::Range range{values, values + 3};
  for (auto& value : range) value += 10;
  for (int value : values) event(value);
  custom::Range empty{values, values};
  for (int value : empty) event(99);
}

