#include <loomcxx/view.h>
[[loom::import("lifetime", "event")]] void event(unsigned value);
namespace loomt = loom::type;
using Rows = loomt::view<loomt::shape<loomt::dynamic>, const unsigned char,
                        loomt::encoding<loom::encoding::role::layout, 1>>;
[[loom::noinline]] static unsigned trim(Rows& rows) {
  rows = loom::view::subview(rows, {1}, {1});
  return 0;
}
struct Pair {
  // Earlier view keeps its complete shape and layout tuple.
  Rows saved;
  // Later call result after changing the original source view.
  unsigned ignored;
};
void run() {
  auto data = loom::buffer::constant("\x0b\x16");
  auto layout = loom::encoding::layout::dense<1>();
  auto source = loom::buffer::view<loomt::dynamic>(data, {2}, layout);
  Pair result{source, trim(source)};
  event(loom::view::load(result.saved, 0));
  event(loom::view::load(source, 0));
}

