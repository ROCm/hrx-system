// ====

[[loom::import("lifetime", "event")]] void event(unsigned value);
[[loom::noinline]] static unsigned increment(unsigned& value) { ++value; return 0; }
[[loom::noinline]] static unsigned exclusive(bool choose, unsigned value) {
  unsigned saved = value;
  if (choose) { increment(value); return value; }
  else { return saved; }
}
[[loom::noinline]] static unsigned exclusive_reversed(bool choose, unsigned value) {
  unsigned saved = value;
  if (choose) { return saved; }
  else { increment(value); return value; }
}
[[loom::noinline]] static unsigned dead_copy(unsigned value) {
  unsigned saved = value;
  increment(value);
  return value;
}
[[loom::noinline]] static unsigned last_read_before_update(unsigned value) {
  event(value);
  increment(value);
  return value;
}
[[loom::noinline]] static unsigned loop(unsigned value, unsigned count) {
  for (unsigned i = 0; i < count; ++i) increment(value);
  return value;
}
[[loom::noinline]] static unsigned loop_snapshot(unsigned value, unsigned count) {
  unsigned total = 0;
  for (unsigned i = 0; i < count; ++i) total += value << increment(value);
  return total + value;
}
[[loom::noinline]] static unsigned same_call(unsigned& value, unsigned saved) {
  ++value;
  return value + saved;
}
[[loom::noinline]] static void increment_pair(unsigned& first, unsigned& second) {
  ++first;
  second += 2u;
}
[[loom::noinline]] static unsigned independent_writebacks(unsigned value) {
  unsigned first = value;
  unsigned second = value;
  increment_pair(first, second);
  return first * 100u + second;
}
void run() {
  event(exclusive(true, 11));
  event(exclusive(false, 11));
  event(exclusive_reversed(true, 11));
  event(exclusive_reversed(false, 11));
  event(dead_copy(11));
  event(last_read_before_update(11));
  event(loop(11, 0));
  event(loop(11, 2));
  event(loop_snapshot(11, 2));
  unsigned value = 11;
  event(same_call(value, value));
  event(independent_writebacks(11));
}

