// ====
// Libraries with pointer/end layout retain the same backing identity and
// initialize the end pointer one past the last element, including empty lists.
namespace std {
template<class E> class initializer_list {
  // Beginning of the compiler-created const array.
  const E* first_;
  // One-past-end iterator, equal to first_ when empty.
  const E* last_;
 public:
  const E* begin() const { return first_; }
  const E* end() const { return last_; }
};
}
[[loom::import("lifetime", "event")]] void event(unsigned value);
static unsigned sum(std::initializer_list<unsigned> values) {
  unsigned result = 0;
  for (unsigned value : values) result += value;
  return result;
}
void run() {
  event(sum({3u, 7u, 11u}));
  event(sum({}));
  std::initializer_list<unsigned> values{5u, 8u};
  event(values.end() == values.begin() + 2);
  event(*(values.end() - 1));
}

