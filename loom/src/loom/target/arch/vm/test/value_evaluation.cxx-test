// ====
// Vector and plain-record elements use the same const-array initialization
// and addressing as scalar elements; no scalar-only list ABI is introduced.
#include <initializer_list>
[[loom::import("lifetime", "event")]] void event(unsigned value);
using Packet = unsigned __attribute__((ext_vector_type(4)));
struct Pair {
  // First scalar component.
  unsigned first;
  // Second scalar component.
  unsigned second;
};
void run() {
  std::initializer_list<Packet> packets{Packet{1, 2, 3, 4}, Packet{5, 6, 7, 8}};
  for (const auto& packet : packets) event(packet[2]);
  std::initializer_list<Pair> pairs{{1, 2}, {3, 4}};
  for (const auto& pair : pairs) event(pair.first * 10 + pair.second);
  std::initializer_list<float> weights{1.5f, 2.5f};
  event(static_cast<unsigned>(weights.begin()[0] + weights.begin()[1]));
}

