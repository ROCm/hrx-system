// ====
// A vector passed by value retains its lanes while an independent binding is
// updated through a mutable reference. Runtime lane indices cover both source
// subscripting and the exported C++ integer conversion.
[[loom::import("lifetime", "event")]] void event(unsigned value);
using Lanes = unsigned __attribute__((ext_vector_type(2)));
[[loom::noinline]] static void replace_lane(Lanes& lanes, unsigned index) {
  lanes[index] = 33;
}
[[loom::noinline]] static unsigned read_lane(Lanes lanes, unsigned index) {
  return lanes[index];
}
void run() {
  Lanes lanes{11, 22};
  Lanes saved = lanes;
  replace_lane(lanes, 1);
  event(read_lane(saved, 1));
  event(read_lane(lanes, 1));
  event(read_lane(lanes, 0));
}
