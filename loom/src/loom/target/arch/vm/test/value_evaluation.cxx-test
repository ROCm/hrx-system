// ====

[[loom::import("lifetime", "event")]] void event(unsigned value);
[[loom::noinline]] static unsigned replace(unsigned& value) { value = 22; return 0; }
[[loom::noinline]] static unsigned increment(unsigned& value) { ++value; return 0; }
[[loom::noinline]] static void conditional(bool choose) {
  unsigned value = 11;
  event(value << (choose ? replace(value) : 0u));
  event(value);
}
[[loom::noinline]] static void captured_loop(unsigned value) {
  for (unsigned i = 0; i < 2; ++i) {
    unsigned local = value;
    increment(local);
    event(local);
  }
  event(value);
}
[[loom::noinline]] static unsigned early_exit(bool choose, unsigned value) {
  for (unsigned i = 0; i < 2; ++i) {
    if (choose) { increment(value); return value; }
  }
  return value;
}
[[loom::noinline]] static void closure_snapshot() {
  unsigned value = 11;
  auto closure = [saved = value, ignored = replace(value)] { return saved + ignored; };
  event(closure());
  event(value);
}
using Lanes = unsigned __attribute__((ext_vector_type(2)));
[[loom::noinline]] static void vector_snapshot() {
  unsigned value = 11;
  Lanes lanes{value, replace(value)};
  event(lanes[0]);
  event(lanes[1]);
  event(value);
}
[[loom::noinline]] static void multiple_copies(unsigned value) {
  unsigned first = value;
  unsigned second = value;
  increment(first);
  increment(second);
  event(first);
  event(second);
  event(value);
}
void run() {
  conditional(true);
  conditional(false);
  captured_loop(11);
  event(early_exit(true, 11));
  event(early_exit(false, 11));
  closure_snapshot();
  vector_snapshot();
  multiple_copies(11);
}
