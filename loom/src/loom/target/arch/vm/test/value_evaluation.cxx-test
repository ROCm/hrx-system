// ====
// List construction performs conversions in source order. Empty lists and
// copies preserve the pointer/count contract, including end equality.
#include <initializer_list>
[[loom::import("lifetime", "event")]] void event(unsigned value);
static unsigned next(unsigned& value) { return ++value; }
static unsigned sum(std::initializer_list<unsigned long long> values) {
  unsigned result = 0;
  for (auto value : values) result += static_cast<unsigned>(value);
  return result;
}
static long largest(std::initializer_list<long> values) {
  long result = values.begin()[0];
  for (decltype(sizeof(0)) index = 1; index < values.size(); ++index)
    if (result < values.begin()[index]) result = values.begin()[index];
  return result;
}
void run() {
  unsigned counter = 0;
  event(sum({next(counter), next(counter), next(counter)}));
  event(counter);
  std::initializer_list<unsigned> empty{};
  event(empty.size());
  event(empty.begin() == empty.end());
  auto values = {7u, 9u};
  auto copy = values;
  event(copy.begin() == values.begin());
  event(*std::begin(copy));
  event(*(std::end(copy) - 1));
  for (unsigned value : {2u, 3u}) event(value);
  event(static_cast<unsigned>(largest({-7L, 9L, 3L})));
}

