[[loom::import("lifetime", "event")]] void event(unsigned value);
[[loom::noinline]] static unsigned replace(unsigned& owner) { owner = 22; return 0; }
struct Owner {
  // Current source payload; outer and constructed instances share a declaration.
  unsigned value;
  // Secondary component initialized after the saved payload.
  unsigned second;
  unsigned construct() {
    Owner result{value, replace(value)};
    event(result.value);
    event(result.second);
    return value;
  }
};
void run() {
  Owner owner{11, 33};
  event(owner.construct());
  event(owner.value);
  event(owner.second);
}

