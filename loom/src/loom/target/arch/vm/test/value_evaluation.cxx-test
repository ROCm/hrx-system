// ====
// A constructor's escaped this pointer names the final backing-array element,
// including during construction of later elements.
#include <initializer_list>
[[loom::import("lifetime", "event")]] void event(unsigned value);
struct Element {
  // Scalar payload stored in the final element object.
  unsigned value;
  Element(unsigned input, const Element*& observed) : value(input) { observed = this; }
};
void run() {
  const Element* first = nullptr;
  const Element* second = nullptr;
  std::initializer_list<Element> values{Element{7, first}, Element{first->value + 2, second}};
  event(first == values.begin());
  event(second == values.begin() + 1);
  event(first->value + second->value);
}

