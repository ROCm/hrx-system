// ====
// Array deduction, mutable structured bindings, nested ranges, and the
// C++20 initializer all share the ordinary declaration and loop paths.
[[loom::import("lifetime", "event")]] void event(unsigned value);
template <class T, unsigned Count>
static unsigned sum(const T (&values)[Count]) {
  unsigned total = 0;
  for (auto value : values) total += value;
  return total;
}
void run() {
  int rows[2][2] = {{1, 2}, {3, 4}};
  for (int increment = 10; auto& [first, second] : rows) {
    first += increment;
    second *= 2;
  }
  for (const auto& row : rows) event(sum(row));
}

