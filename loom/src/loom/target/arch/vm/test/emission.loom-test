// ====

// An empty source module emits only the bytecode image header.

// ----
vm.module core(0.0) {
}

// ====

vm.target<core> @vm

// Retained imports require callable tables but no local function definitions.
low.func.decl retain import(native, "observe", module = "host") target<vm.core>(@vm) @observe(%value: reg<vm.value : i32>)

// ----
vm.module core(0.0) {
  section strings alignment(8) {
    string @string0 = "host"
    string @string1 = "observe"
  }

  section signatures alignment(8) {
    signature @signature0 (i32) -> ()
  }

  section callable_types alignment(8) {
    callable @callable0 flags([]) depth(0) : @signature0
  }

  section imports alignment(8) {
    group @import_group0 module_name(@string0) {
      import @import0 name(@string1) flags([]) : @callable0
    }
  }

}

// ====

vm.target<core> @vm

// An artifact with no data references does not serialize unused payloads.
global.rodata.def @unused = align(4096) bytes("0123456789abcdef")

// Constant compaction preserves complete cells, including the high zero half
// of an i32 literal and the sign bit of floating-point negative zero.
func.def public target(@vm) @constant_cells() -> (i64, i64, i64, i64, i64, i64, i32, f64) {
  %c0 = scalar.constant 0 : i64
  %short = scalar.constant -32768 : i64
  %below_short = scalar.constant -32769 : i64
  %above_short = scalar.constant 32768 : i64
  %unsigned_max = scalar.constant 4294967295 : i64
  %above_unsigned = scalar.constant 4294967296 : i64
  %narrow_negative = scalar.constant -1 : i32
  %float_negative_zero = scalar.constant -0.0 : f64
  func.return %c0, %short, %below_short, %above_short, %unsigned_max, %above_unsigned, %narrow_negative, %float_negative_zero : i64, i64, i64, i64, i64, i64, i32, f64
}

// ----
vm.module core(0.0) {
  section strings alignment(8) {
    string @string0 = "constant_cells"
  }

  section signatures alignment(8) {
    signature @signature0 () -> (i64, i64, i64, i64, i64, i64, i32, f64)
  }

  section callable_types alignment(8) {
    callable @callable0 flags([]) depth(0) : @signature0
  }

  section exports alignment(8) {
    export @export0 name(@string0) : @callable0 = @function0
  }

  section functions alignment(8) {
    func @function0 : @callable0 flags([]) frame(local_bytes = 0, value_registers = 8, ref_registers = 0, function_registers = 0, local_refs = 0, local_functions = 0) {
    ^bb0:
      control.block
      %v0 = constant.zero
      %v1 = constant.s16 -32768
      %v2 = constant.i64 0xFFFFFFFFFFFF7FFF
      %v3 = constant.i32 0x00008000
      %v4 = constant.i32 0xFFFFFFFF
      %v5 = constant.i64 0x0000000100000000
      %v6 = constant.i32 0xFFFFFFFF
      %v7 = constant.i64 0x8000000000000000
      control.return
    }
  }

  section rodata alignment(8) {
  }

}

// ====

vm.target<core> @vm

func.def public target(@vm) @arithmetic(%a: i32, %b: i32, %c: i32) -> (i32) {
  %sum = scalar.addi %a, %b : i32
  %scaled = scalar.muli %sum, %c : i32
  %result = scalar.subi %scaled, %b : i32
  func.return %result : i32
}

// ----
vm.module core(0.0) {
  section strings alignment(8) {
    string @string0 = "arithmetic"
  }

  section signatures alignment(8) {
    signature @signature0 (i32, i32, i32) -> (i32)
  }

  section callable_types alignment(8) {
    callable @callable0 flags([]) depth(0) : @signature0
  }

  section exports alignment(8) {
    export @export0 name(@string0) : @callable0 = @function0
  }

  section functions alignment(8) {
    func @function0 : @callable0 flags([]) frame(local_bytes = 0, value_registers = 3, ref_registers = 0, function_registers = 0, local_refs = 0, local_functions = 0) {
    ^bb0:
      control.block
      %v0 = integer.add.i32 %v0, %v1
      %v0 = integer.mul.i32 %v0, %v2
      %v0 = integer.sub.i32 %v0, %v1
      control.return
    }
  }

}

// ====

vm.target<core> @vm

func.def public target(@vm) @swap(%a: i64, %b: i64) -> (i64, i64) {
  func.return %b, %a : i64, i64
}

func.def public target(@vm) @passthrough(%a: i64, %b: i64) -> (i64, i64) {
  func.return %a, %b : i64, i64
}

func.def public target(@vm) @empty() {
  func.return
}

// ----
vm.module core(0.0) {
  section strings alignment(8) {
    string @string0 = "empty"
    string @string1 = "passthrough"
    string @string2 = "swap"
  }

  section signatures alignment(8) {
    signature @signature0 () -> ()
    signature @signature1 (i64, i64) -> (i64, i64)
  }

  section callable_types alignment(8) {
    callable @callable0 flags([]) depth(0) : @signature0
    callable @callable1 flags([]) depth(0) : @signature1
  }

  section exports alignment(8) {
    export @export0 name(@string0) : @callable0 = @function2
    export @export1 name(@string1) : @callable1 = @function1
    export @export2 name(@string2) : @callable1 = @function0
  }

  section functions alignment(8) {
    func @function0 : @callable1 flags([]) frame(local_bytes = 0, value_registers = 3, ref_registers = 0, function_registers = 0, local_refs = 0, local_functions = 0) {
    ^bb0:
      control.block
      %v2 = value.copy %v0
      %v0 = value.copy %v1
      %v1 = value.copy %v2
      control.return
    }
    func @function1 : @callable1 flags([]) frame(local_bytes = 0, value_registers = 2, ref_registers = 0, function_registers = 0, local_refs = 0, local_functions = 0) {
    ^bb0:
      control.block
      control.return
    }
    func @function2 : @callable0 flags([]) frame(local_bytes = 0, value_registers = 0, ref_registers = 0, function_registers = 0, local_refs = 0, local_functions = 0) {
    ^bb0:
      control.block
      control.return
    }
  }

}

// ====

vm.target<core> @vm

// The true and false destinations both skip the physically next block. Each
// arm then branches backwards to the join instead of falling through.
low.func.def public target<vm.core>(@vm) abi(vm_function) @routed(%condition: reg<vm.value : i1>, %a: reg<vm.value : i32>, %b: reg<vm.value : i32>) -> (reg<vm.value : i32>) asm {
  low.cond_br %condition, ^yes, ^no : reg<vm.value : i1>
^join(%result: reg<vm.value : i32>):
  return %result
^yes:
  %sum = integer.add.i32 %a, %b
  low.br ^join(%sum: reg<vm.value : i32>)
^no:
  %difference = integer.sub.i32 %a, %b
  low.br ^join(%difference: reg<vm.value : i32>)
}

// ----
vm.module core(0.0) {
  section strings alignment(8) {
    string @string0 = "routed"
  }

  section signatures alignment(8) {
    signature @signature0 (i32, i32, i32) -> (i32)
  }

  section callable_types alignment(8) {
    callable @callable0 flags([]) depth(0) : @signature0
  }

  section exports alignment(8) {
    export @export0 name(@string0) : @callable0 = @function0
  }

  section functions alignment(8) {
    func @function0 : @callable0 flags([]) frame(local_bytes = 0, value_registers = 3, ref_registers = 0, function_registers = 0, local_refs = 0, local_functions = 0) {
    ^bb0:
      control.block
      control.branch.if.s32 %v0, ^bb2
      control.branch.s32 ^bb3
    ^bb1:
      control.block
      control.return
    ^bb2:
      control.block
      %v0 = integer.add.i32 %v1, %v2
      control.branch.s32 ^bb1
    ^bb3:
      control.block
      %v0 = integer.sub.i32 %v1, %v2
      control.branch.s32 ^bb1
    }
  }

}

// ====

vm.target<core> @vm

// Named predicates reach physical selectors and equivalent comparisons share
// one result before return-register placement.
