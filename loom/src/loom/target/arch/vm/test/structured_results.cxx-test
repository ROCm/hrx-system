// ====
// RUN: emit vm-object-lifetime
#include <loomcxx/view.h>
[[loom::import("lifetime", "event")]] void event(unsigned value);
using Buffer = loom::type::buffer<const unsigned char>;
struct Marker {
  // Cleanup event identifying this scope.
  unsigned value;
  ~Marker() { event(value); }
};
[[loom::noinline]] static unsigned first_byte(Buffer data) {
  return loom::view::load(loom::buffer::view<1>(data, {}), 0);
}
[[loom::noinline]] static Buffer choose(Buffer first, Buffer second,
                                        bool early) {
  Marker outer{9};
  Buffer result;
  unsigned index = 0;
  do {
    Marker inner{8};
    if (early && index == 1) {
      return second;
    }
    result = first;
    ++index;
  } while (index < 3);
  event(7);
  return result;
}
void run() {
  auto first = loom::buffer::root(loom::buffer::constant("\x16"));
  auto second = loom::buffer::root(loom::buffer::constant("\x21"));
  event(first_byte(choose(first, second, false)));
  event(first_byte(choose(first, second, true)));
}

