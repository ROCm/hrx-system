// ====
// Numeric results retain their widths, lane values, and address domains.
// RUN: emit vm-object-lifetime
#include <loomcxx/index.h>

[[loom::import("lifetime", "event")]] void event(unsigned value);

template <class T>
[[loom::noinline]] T choose(T first, T second, bool condition) {
  T result = first;
  if (condition) {
    result = first;
  } else {
    result = second;
  }
  return result;
}

using Vector = unsigned __attribute__((ext_vector_type(4)));

[[loom::noinline]] static void trial(bool condition) {
  auto wide = choose(0x10000000bull, 0x200000016ull, condition);
  event(static_cast<unsigned>(wide >> 32));
  event(static_cast<unsigned>(wide));
  event(static_cast<unsigned>(choose(13.0f, 23.0f, condition)));
  event(static_cast<unsigned>(choose(14.0, 24.0, condition)));
  auto position =
      choose(loom::type::index{15}, loom::type::index{25}, condition);
  event(loom::index::cast<unsigned>(position));
  auto origin =
      choose(loom::type::offset{16}, loom::type::offset{26}, condition);
  event(loom::offset::cast<unsigned>(origin));
  auto lanes =
      choose(Vector{17, 18, 19, 20}, Vector{27, 28, 29, 30}, condition);
  event(lanes[0]);
  event(lanes[3]);
}

void run() {
  trial(true);
  trial(false);
}

