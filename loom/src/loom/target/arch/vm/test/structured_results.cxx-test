// Fresh resource results preserve branch effects, callable exits, and
// cleanup through public C++ export, reimport, and execution.
// RUN: emit vm-object-lifetime
#include <loomcxx/view.h>

[[loom::import("lifetime", "event")]] void event(unsigned value);

using Buffer = loom::type::buffer<const unsigned char>;
struct Slice {
  // Selected immutable resource.
  Buffer data;
  // Scalar returned alongside the selected resource.
  unsigned last;
};
struct Marker {
  // Cleanup event identifying this scope.
  unsigned value;
  ~Marker() { event(value); }
};

[[loom::noinline]] static Slice choose(Slice incoming, bool first, bool early) {
  Marker marker{8};
  Slice selected = incoming;
  if (first) {
    event(1);
    if (early) {
      return {loom::buffer::root(loom::buffer::constant("\x07")), 0};
    }
    selected = {loom::buffer::root(loom::buffer::constant("\x16\x17")), 1};
  } else {
    event(2);
    selected = {loom::buffer::root(loom::buffer::constant("\x21\x22\x23")), 2};
  }
  event(3);
  return selected;
}

[[loom::noinline]] static void trial(bool first, bool early) {
  Slice initial{loom::buffer::root(loom::buffer::constant("\x0b")), 0};
  Slice selected = choose(initial, first, early);
  event(loom::view::load(loom::buffer::view<1>(selected.data, {}), 0));
  event(selected.last);
}

void run() {
  trial(false, false);
  trial(false, true);
  trial(true, false);
  trial(true, true);
}

