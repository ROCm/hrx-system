// ====
// RUN: emit vm-object-lifetime
#include <loomcxx/view.h>

[[loom::import("lifetime", "event")]] void event(unsigned value);

using Buffer = loom::type::buffer<const unsigned char>;

struct Owners {
  // First independently replaceable root.
  Buffer first;
  // Second independently replaceable root.
  Buffer second;
};

[[loom::noinline]] static void observe(Buffer payload) {
  event(loom::view::load(loom::buffer::view<1>(payload, {}), 0));
}

[[loom::noinline]] static Owners replace_and_read(Owners current, Buffer next,
                                                  bool replace_second,
                                                  bool observe_second) {
  if (replace_second) {
    current.second = next;
  } else {
    current.first = next;
  }
  if (observe_second) {
    observe(current.second);
  } else {
    observe(current.first);
  }
  return current;
}

[[loom::noinline]] static void trial(bool replace_second, bool observe_second) {
  Owners owners{loom::buffer::root(loom::buffer::constant("\x0b")),
                loom::buffer::root(loom::buffer::constant("\x0c"))};
  auto saved = owners.first;
  owners = replace_and_read(owners,
                            loom::buffer::root(loom::buffer::constant("\x16")),
                            replace_second, observe_second);
  observe(saved);
  observe(owners.first);
  observe(owners.second);
}

void run() {
  trial(false, false);
  trial(false, true);
  trial(true, false);
  trial(true, true);
}

