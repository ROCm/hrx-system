// Complete view copies retain dimensions and layout through each control form.
// RUN: emit vm-object-lifetime
#include <loomcxx/view.h>

[[loom::import("lifetime", "event")]] void event(unsigned value);

template <class View>
[[loom::inline]] View select(View first, View second, bool condition) {
  View selected;
  if (condition) selected = first;
  else selected = second;
  return selected;
}

template <class View>
[[loom::inline]] View counted(View first, View second, bool condition,
                              unsigned count) {
  View selected = first;
  for (unsigned i = 0; i < count; ++i) {
    if (condition) selected = first;
    else selected = second;
  }
  return selected;
}

template <class View>
[[loom::inline]] View exchanged(View first, View second, bool condition) {
  View left = first;
  View right = second;
  unsigned i = 0;
  while (i < 3) {
    View saved = left;
    left = right;
    right = saved;
    ++i;
  }
  if (condition) return right;
  return left;
}

template <class View>
[[loom::inline]] View constructed(View first, View second, bool condition) {
  View selected;
  unsigned i = 0;
  do {
    if (condition) selected = first;
    else selected = second;
    ++i;
  } while (i < 3);
  return selected;
}

template <class View>
[[loom::inline]] void exercise(View first, View second, bool condition) {
  event(loom::view::load(select(first, second, condition), 1u, 0u));
  event(loom::view::load(counted(first, second, condition, 0u), 1u, 0u));
  event(loom::view::load(counted(first, second, condition, 3u), 1u, 0u));
  event(loom::view::load(exchanged(first, second, condition), 1u, 0u));
  event(loom::view::load(constructed(first, second, condition), 1u, 0u));
}

[[loom::noinline]] static void plain(bool condition) {
  auto first = loom::buffer::view<2, loom::type::dynamic>(
      loom::buffer::constant("\x0b\x0c\x0c\x0d"), {2u});
  auto second = loom::buffer::view<2, loom::type::dynamic>(
      loom::buffer::constant("\x21\x22\x23\x22\x24\x25"), {3u});
  exercise(first, second, condition);
}

[[loom::noinline]] static void encoded(bool condition) {
  auto first = loom::buffer::view<2, loom::type::dynamic>(
      loom::buffer::constant("\x0b\x0c\x63\x0c\x0d\x63"), {2u},
      loom::encoding::layout::strided(3u, 1u));
  auto second = loom::buffer::view<2, loom::type::dynamic>(
      loom::buffer::constant("\x21\x22\x23\x63\x22\x24\x25\x63"),
      {3u}, loom::encoding::layout::strided(4u, 1u));
  exercise(first, second, condition);
}

void run() {
  plain(true);
  plain(false);
  encoded(true);
  encoded(false);
}

