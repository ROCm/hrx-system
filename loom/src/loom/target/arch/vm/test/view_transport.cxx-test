// ====
// Independent dimensions feed arithmetic, new view construction, and output.
// RUN: emit vm-object-lifetime
#include <loomcxx/view.h>

[[loom::import("lifetime", "event")]] void event(unsigned value);
using Index = loom::type::index;

[[loom::noinline]] static void trial(bool condition) {
  Index length{3u};
  if (condition) length = Index{2u};
  auto selected = loom::buffer::view<loom::type::dynamic>(
      loom::buffer::constant("\x0b\x0c\x0d\x0e\x0f"), {length});
  for (unsigned i = 0; i < 2; ++i) {
    length = length + Index{1u};
    selected = loom::buffer::view<loom::type::dynamic>(
        loom::buffer::constant("\x0b\x0c\x0d\x0e\x0f"), {length});
  }
  event(loom::index::cast<unsigned>(length));
  event(loom::view::load(selected, 1u));
}

void run() {
  trial(true);
  trial(false);
}

// ----
event 4
event 12
event 5
event 12
OK 0
retired 0

// ====
// Omitting an unobserved loop carrier must preserve the calls producing it.
// RUN: emit vm-object-lifetime
#include <loomcxx/view.h>

[[loom::import("lifetime", "event")]] void event(unsigned value);
using View = loom::type::view<loom::type::shape<loom::type::dynamic>,
                            const unsigned char>;

[[loom::noinline]] View observed(View input, unsigned iteration) {
  event(iteration);
  return input;
}

void run() {
  auto input = loom::buffer::view<loom::type::dynamic>(
      loom::buffer::constant("\x0b\x0c"), {2u});
  View unused = input;
  for (unsigned i = 0; i < 3; ++i) unused = observed(input, i);
  event(10u);
}

