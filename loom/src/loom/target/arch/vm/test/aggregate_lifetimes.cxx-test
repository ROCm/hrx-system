// ====
// Passing a temporary aggregate to a helper keeps its referent only through
// the call's full expression. Naming its reference member also creates no new
// lifetime extension; the resulting expired reference is never read.
[[loom::import("lifetime", "event")]] void observe(unsigned value);

struct Guard {
  // Identifies the independently evaluated temporary.
  unsigned value;
  ~Guard() { observe(value); }
};

struct Holder {
  // Has the lifetime of the containing aggregate expression.
  const Guard& member;
};

[[loom::noinline]] static void use(const Holder& holder) {
  observe(holder.member.value + 10);
}

void run() {
  use(Holder{Guard{1}});
  observe(2);
  const Guard& expired = Holder{Guard{3}}.member;
  observe(4);
}

