// ====
// Each continue and break exits the holder's scope. Its temporary must retire
// at that exit, before another iteration or the statement after the loop.
[[loom::import("lifetime", "event")]] void observe(unsigned value);

struct Guard {
  // Identifies the current iteration's object.
  unsigned value;
  ~Guard() { observe(value); }
};

struct Holder {
  // The loop-body scope owns this reference's temporary.
  const Guard& member;
};

void run() {
  for (unsigned index = 1; index < 4; ++index) {
    Holder holder{Guard{index}};
    if (index == 1) continue;
    observe(holder.member.value + 10);
    break;
  }
  observe(20);
}

