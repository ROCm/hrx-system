// ====
// Guaranteed copy elision initializes the named aggregate directly. A
// structured binding's hidden by-value object follows the same lifetime rule.
[[loom::import("lifetime", "event")]] void observe(unsigned value);

struct Guard {
  // Identifies the referent owned by the enclosing aggregate's lifetime.
  unsigned value;
  ~Guard() { observe(value); }
};

struct Holder {
  // Bound during direct construction of the result object.
  const Guard& member;
};

void run() {
  {
    Holder result = Holder{Guard{1}};
    observe(result.member.value + 10);
  }
  {
    auto [member] = Holder{Guard{2}};
    observe(member.value + 10);
  }
}

