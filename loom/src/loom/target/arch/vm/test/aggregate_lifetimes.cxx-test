// ====
// RUN: emit vm-object-lifetime
// INPUT: cxx root=run
// A conditional prvalue initializes one result object. Both paths keep that
// object's lifetime through the aggregate reference, then destroy it once.
[[loom::import("lifetime", "event")]] void observe(unsigned value);

struct Guard {
  // Identifies the selected result object.
  unsigned value;
  ~Guard() { observe(value); }
};

struct Holder {
  // Refers to the conditional's complete result object.
  const Guard& member;
};

[[loom::noinline]] static void select(bool first) {
  Holder holder{first ? Guard{1} : Guard{2}};
  observe(holder.member.value + 10);
}

void run() {
  select(true);
  select(false);
}

