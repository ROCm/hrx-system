// ====
// A glvalue conditional selects an existing referent. It creates no result
// object and neither duplicates nor transfers the selected object's cleanup.
[[loom::import("lifetime", "event")]] void observe(unsigned value);

struct Guard {
  // Independently owned by the local declaration.
  unsigned value;
  ~Guard() { observe(value); }
};

struct Holder {
  // Selects one existing source identity.
  const Guard& member;
};

[[loom::noinline]] static void select(bool first) {
  Guard left{3};
  Guard right{4};
  Holder holder{first ? left : right};
  observe(holder.member.value + 10);
}

void run() {
  select(true);
  select(false);
}

