// ====
// C++23 extends caller-owned temporaries throughout the range initializer,
// including a discarded comma operand and a range returned through an accessor.
[[loom::import("lifetime", "event")]] void observe(unsigned value);
struct Guard {
  // Destruction marker for a temporary preceding the selected range.
  unsigned value;
  ~Guard() { observe(value); }
};
struct Iterator {
  // Current scalar index.
  unsigned value;
  unsigned operator*() const { return value; }
  void operator++() { ++value; }
  bool operator!=(const Iterator& other) const { return value != other.value; }
};
struct Range {
  // Exclusive upper bound.
  unsigned count;
  Range& self() { return *this; }
  Iterator begin() { return {0}; }
  Iterator end() { return {count}; }
  ~Range() { observe(100); }
};
void run() {
  for (unsigned value : (Guard{7}, Range{3}.self())) observe(value);
  observe(200);
}

