// ====
// Conversion, indexing, and ordinary operator results all materialize the
// returned object once and retire it after the addressed consumer finishes.
[[loom::import("lifetime", "event")]] void observe(unsigned value);
struct Result {
  // Distinguishes the returned object from the operator's input.
  unsigned value;
  ~Result() { observe(80u + value); }
};
struct Source {
  // Shared source for the four independent value-producing operators.
  unsigned value;
  operator Result() const { observe(1); return Result{value * 2u}; }
  Result operator[](unsigned index) const { observe(2); return Result{value + index}; }
  Result operator+() const { observe(3); return Result{value + 3u}; }
  Result operator+(unsigned amount) const { observe(4); return Result{value + amount}; }
};
static void consume(const Result& result) { const Result* pointer = &result; observe(pointer->value); }
void run() {
  Source source{4};
  consume(source);
  consume(source[2]);
  consume(+source);
  consume(source + 5u);
}
