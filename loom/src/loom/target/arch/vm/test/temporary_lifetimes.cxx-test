// ====
// Converted reference temporaries execute the selected constructor and retain
// their complete-expression or extended lexical lifetime, including mutations.
[[loom::import("lifetime", "event")]] void observe(unsigned value);
struct Input {
  // Aggregate argument whose cleanup follows the converted temporary.
  unsigned value;
  ~Input() { observe(50u + value); }
};
struct Doubled {
  // The selected constructor computes this payload before the reference binds.
  unsigned value;
  Doubled(const unsigned& source) : value(source * 2u) { observe(10u + source); }
  Doubled(const Input& source) : value(source.value * 3u) { observe(40u + source.value); }
  ~Doubled() { observe(20u + value); }
};
static void consume(const Doubled& value) { const Doubled* pointer = &value; observe(pointer->value); }
static void modify(Doubled&& value) { Doubled* pointer = &value; ++pointer->value; observe(pointer->value); }
void run() {
  consume(3u);
  observe(1);
  { const Doubled& held = 5u; observe(held.value); observe(2); }
  modify(7u);
  observe(3);
  { Doubled&& held = 9u; ++held.value; observe(held.value); }
  consume(Input{4});
  {
    const Doubled& parenthesized(11u);
    const Doubled& braced{13u};
    observe(parenthesized.value);
    observe(braced.value);
  }
}
