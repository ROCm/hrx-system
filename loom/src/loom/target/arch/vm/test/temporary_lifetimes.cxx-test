// RUN: emit vm-object-lifetime
// INPUT: cxx root=run
// A copy returned by value belongs to the caller. The constructor's implicit
// conversion and argument initializer describe one result object.
[[loom::import("lifetime", "event")]] void observe(unsigned value);

struct Guard {
  // Payload reported at the actual destruction boundary.
  unsigned value;
  ~Guard() { observe(value); }
};

[[loom::noinline]] static Guard copy_of(const Guard& source) { return source; }

void run() {
  Guard source{7};
  {
    Guard copied = copy_of(source);
    observe(copied.value + 10);
  }
  observe(20);
}

// ----
event 17
event 7
event 20
event 7
OK 0
retired 0

// ====
// Direct reference binding extends a temporary; returning its reference through
// a function does not. The expired reference is never read.
[[loom::import("lifetime", "event")]] void observe(unsigned value);

struct Guard {
  // Payload reported at the actual destruction boundary.
  unsigned value;
  [[loom::noinline]] Guard& self() { return *this; }
  ~Guard() { observe(value); }
};

void run() {
  {
    const Guard& extended = Guard{1};
    observe(2);
  }
  {
    const Guard& expired = Guard{3}.self();
    observe(4);
  }
}

