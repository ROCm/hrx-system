// ====
// The hidden iterator copies begin()'s reference. Element destruction happens
// on continue and break before iterator and temporary-range destruction.
[[loom::import("lifetime", "event")]] void observe(unsigned value);
struct Sentinel {
  // Exclusive upper bound, with a different type from the iterator.
  unsigned limit;
};
struct Element {
  // Value observed during the iteration and at its cleanup boundary.
  unsigned value;
  ~Element() { observe(10 + value); }
};
struct Iterator {
  // Current iteration value; copying must preserve the original range member.
  unsigned value;
  Iterator(unsigned initial) : value(initial) {}
  Iterator(const Iterator& source) : value(source.value) { observe(5); }
  ~Iterator() { observe(30 + value); }
  Element operator*() const { return {value}; }
  void operator++() { ++value; }
  bool operator!=(Sentinel end) const { return value != end.limit; }
};
struct Range {
  // Original iterator, never advanced by the loop's independent copy.
  Iterator first{0};
  // Bound supplied to the distinct sentinel.
  unsigned limit;
  Range(unsigned count) : limit(count) { observe(1); }
  ~Range() { observe(40 + first.value); }
  Iterator& begin() { observe(2); return first; }
  Sentinel end() { observe(3); return {limit}; }
};
void run() {
  for (auto value : Range{4}) {
    observe(value.value);
    if (value.value == 1) continue;
    if (value.value == 2) break;
  }
  observe(50);
}

