// ====
// Temporary cleanup follows construction order even when the selected range
// was constructed before a later subscript operand. Function parameters keep
// their own cleanup boundary, and early return unwinds the entire loop scope.
[[loom::import("lifetime", "event")]] void observe(unsigned value);
struct Guard {
  // Marker observed when this temporary or parameter is destroyed.
  unsigned value;
  ~Guard() { observe(value); }
};
struct Ranges {
  // Selected subarray keeps its containing temporary alive through the loop.
  unsigned values[1][2] = {{11, 12}};
  ~Ranges() { observe(100); }
};
static void consume(Guard value) { observe(value.value + 1); }
static unsigned select(const Guard& value) { return value.value; }
static unsigned early() {
  for (unsigned value : Ranges{}.values[(consume(Guard{20}), Guard{30}, select(Guard{0}))]) {
    if (value == 12) return value;
    observe(value);
  }
  return 0;
}
void run() { observe(early()); }

