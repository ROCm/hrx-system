// ====
// The semantic range stays in SSA. Binding its reference retains the original
// temporary's cleanup position instead of appending another destructor. A
// constructor member initializer still finishes its own temporary immediately.
[[loom::import("lifetime", "event")]] void observe(unsigned value);
struct Guard {
  // Marker for the temporary preceding the range object.
  unsigned value;
  ~Guard() { observe(value); }
};
struct Range {
  // Borrowed elements, represented as a buffer identity and offset.
  unsigned* first;
  // Number of elements owned by the caller.
  unsigned count;
  Range(unsigned* input, unsigned length) : first(input), count((Guard{8}, length)) {}
  unsigned* begin() { return first; }
  unsigned* end() { return first + count; }
  ~Range() { observe(100 + *first); }
};
void run() {
  unsigned values[] = {1, 2};
  for (auto& value : (Guard{7}, Range{values, 2})) value += 10;
  observe(values[1]);
}

