// ====
// Only the selected conditional arm constructs objects. Its materialized
// range and side temporary survive the full expression and die at loop exit.
[[loom::import("lifetime", "event")]] void observe(unsigned value);
struct Guard {
  // Branch-local marker.
  unsigned value;
  ~Guard() { observe(value); }
};
struct Range {
  // One element whose address is returned by begin and end.
  unsigned value;
  Range& self() { return *this; }
  unsigned* begin() { return &value; }
  unsigned* end() { return &value + 1; }
  ~Range() { observe(100 + value); }
};
static void selected(bool condition) {
  for (unsigned value : condition ? (Guard{1}, Range{2}.self()) : (Guard{3}, Range{4}.self())) observe(value);
}
void run() { selected(true); selected(false); }

