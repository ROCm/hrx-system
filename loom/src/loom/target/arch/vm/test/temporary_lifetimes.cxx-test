// ====
// A returned reference into a nonzero-offset base still names the complete
// temporary. Addressing that base preserves the other fields for destruction.
[[loom::import("lifetime", "event")]] void observe(unsigned value);

struct Prefix {
  // Earlier base occupying a distinct component and source-layout interval.
  unsigned prefix;
};
struct Base {
  // Component replaced through the returned base reference.
  unsigned value;
  [[loom::noinline]] Base& replace(unsigned next) {
    value = next;
    return *this;
  }
};
struct Derived : Prefix, Base {
  // Later component that remains part of the complete temporary.
  unsigned tail;
  ~Derived() { observe(prefix * 100 + value * 10 + tail); }
};

void run() {
  const auto result = (Derived{{4}, {5}, 6}.replace(7).value = 8);
  observe(result);
}

