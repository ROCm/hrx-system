load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_library",
    "loom_generated_cc_library",
)
load(
    "//loom/build_tools/bazel:loom_check.bzl",
    "loom_check_test_suite",
)

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

_VM_PROVIDER_VISIBILITY = [
    "//loom/src/loom/target/all:__pkg__",
    "//loom/src/loom/target/configured:__pkg__",
]

_VM_CHECK_PROVIDER_VISIBILITY = [
    "//loom/src/loom/tools/loom-check:__pkg__",
]

loom_cc_library(
    name = "target_records",
    srcs = ["records/target_records.c"],
    hdrs = ["records/target_records.h"],
    deps = [
        "//loom/src/loom/target:types",
        "//runtime/src/iree/base",
    ],
)

loom_generated_cc_library(
    name = "ops",
    srcs = ["ops/registry.c"],
    hdrs = [
        "ops/ops.h",
        "ops/registry.h",
    ],
    args = ["--dialect=vm"],
    generated_src_flags = [
        "--builders",
        "--tables",
    ],
    generated_srcs = [
        "ops/builders.c",
        "ops/tables.c",
    ],
    generator = "//loom/py/loom/gen/ops:c_tables_vm_generator",
    deps = [
        ":target_records",
        "//loom/src/loom/error:error_defs",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/ops/target",
        "//loom/src/loom/target:types",
        "//runtime/src/iree/base",
    ],
)

loom_generated_cc_library(
    name = "descriptors",
    extra_output_flags = ["--lowering-rows"],
    extra_outputs = ["lowering_rows.inl"],
    generated_hdr_flags = ["--header"],
    generated_hdrs = ["descriptors.h"],
    generator = "//loom/py/loom/gen/target/arch/vm:tables",
    source = "descriptors.c",
    textual_hdrs = [":lowering_rows.inl"],
    deps = ["//loom/src/loom/codegen/low:descriptors"],
)

loom_cc_library(
    name = "lower",
    srcs = ["lower/lower.c"],
    hdrs = ["lower/lower.h"],
    deps = [
        ":descriptors",
        "//loom/src/loom/codegen/low/lower",
        "//loom/src/loom/error:error_defs",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops/index",
        "//loom/src/loom/ops/scalar",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal",
    ],
)

loom_cc_library(
    name = "provider",
    srcs = ["provider.c"],
    hdrs = ["provider.h"],
    visibility = _VM_PROVIDER_VISIBILITY,
    deps = [
        ":descriptors",
        ":lower",
        ":ops",
        "//loom/src/loom/target:low_descriptor_registry",
        "//loom/src/loom/target:provider",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "check_provider",
    testonly = True,
    srcs = ["check/provider.c"],
    hdrs = ["check/provider.h"],
    visibility = _VM_CHECK_PROVIDER_VISIBILITY,
    deps = [
        ":provider",
        "//loom/src/loom/tools/loom-check:provider",
        "//runtime/src/iree/base",
    ],
)

loom_check_test_suite(
    name = "loom_check_file_test",
    srcs = [
        "test/source_low/corpus/numeric_scalar_baseline.loom-test",
        "test/source_low/corpus/numeric_scalar_literals.loom-test",
    ],
    data = [
        "//loom/src/loom/test/corpus/source_low:numeric_scalar_baseline.loom-test",
        "//loom/src/loom/test/corpus/source_low:numeric_scalar_literals.loom-test",
    ],
    test_name_prefix_to_strip = "test/source_low/",
)
