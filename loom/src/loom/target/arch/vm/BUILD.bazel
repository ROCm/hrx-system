load("//build_tools/bazel:query.bzl", "iree_assert_dependency_boundary")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test", "loom_config_compatible_with", "loom_generated_file")
load("//loom/build_tools/bazel:loom_check.bzl", "loom_check_test_suite")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_cc_library(
    name = "records",
    srcs = ["records.c"],
    hdrs = ["records.h"],
    visibility = ["//loom/src/loom/target/arch/vm/ops:__pkg__"],
    deps = [
        "//loom/src/loom/target:types",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "types",
    srcs = ["types.c"],
    hdrs = ["types.h"],
    visibility = ["//loom/src/loom/tooling/target/vm:__pkg__"],
    deps = [
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:type_registry",
        "//runtime/src/iree/base",
        "//runtime/src/iree/vm/bytecode:wire",
    ],
)

loom_cc_library(
    name = "program",
    srcs = ["program.c"],
    hdrs = ["program.h"],
    visibility = ["//loom/src/loom/target/emit/vm:__pkg__"],
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/vm/bytecode:wire",
    ],
)

iree_assert_dependency_boundary(
    name = "program_has_no_tooling_dependencies",
    forbidden_subtrees = ["//loom/src/loom/tooling/..."],
    message = "The prepared VM program is a target-owned physical contract and must not depend on tooling",
    target = ":program",
)

loom_cc_library(
    name = "reference_plan",
