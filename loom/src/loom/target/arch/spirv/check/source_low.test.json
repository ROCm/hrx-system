{
  "version": 1,
  "cases": [
    {
      "name": "invalid limit refinements",
      "steps": [
        {
          "name": "fixture",
          "write": {
            "path": "{tmp}/fixture.loom-test",
            "text": "// RUN: emit spirv-low target=spirv:vulkan1.3+bda+hal limits=MISSING:1\nfunc.def @entry() { func.return }\n// ====\n// RUN: emit spirv-low target=spirv:vulkan1.3+bda+hal limits=SUBGROUP_SIZE:32,SUBGROUP_SIZE:32\nfunc.def @entry() { func.return }\n// ====\n// RUN: emit spirv-low target=spirv:vulkan1.3+bda+hal limits=MAX_WORKGROUP_SIZE_X:-1\nfunc.def @entry() { func.return }\n// ====\n// RUN: emit spirv-low target=spirv:vulkan1.3+bda+hal limits=MAX_WORKGROUP_SIZE_Y:1junk\nfunc.def @entry() { func.return }\n// ====\n// RUN: emit spirv-low target=spirv:vulkan1.3+bda+hal limits=MAX_WORKGROUP_SIZE_Z:18446744073709551616\nfunc.def @entry() { func.return }\n// ====\n// RUN: emit spirv-low target=spirv:vulkan1.3+bda+hal limits=MAX_FLAT_WORKGROUP_SIZE:\nfunc.def @entry() { func.return }\n// ====\n// RUN: emit spirv-low target=spirv:vulkan1.3+bda+hal limits=\nfunc.def @entry() { func.return }\n// ====\n// RUN: emit spirv-low limits=MAX_WORKGROUP_STORAGE_BYTES:512\nfunc.def @entry() { func.return }\n"
          }
        },
        {
          "name": "execute",
          "run": {
            "tool": "loom-check",
            "args": [
              "{tmp}/fixture.loom-test"
            ]
          },
          "exit": {
            "nonzero": true
          },
          "stderr": {
            "contains": [
              "unknown or duplicate SPIR-V limit 'MISSING'",
              "unknown or duplicate SPIR-V limit 'SUBGROUP_SIZE'",
              "SPIR-V limit 'MAX_WORKGROUP_SIZE_X' expects an unsigned integer",
              "SPIR-V limit 'MAX_WORKGROUP_SIZE_Y' expects an unsigned integer",
              "SPIR-V limit 'MAX_WORKGROUP_SIZE_Z' expects an unsigned integer",
              "SPIR-V limit 'MAX_FLAT_WORKGROUP_SIZE' expects an unsigned integer",
              "spirv-low requires one nonempty limits list",
              "spirv-low @function, features, or limits requires target=family:selector"
            ]
          }
        }
      ]
    },
    {
      "name": "unknown feature",
      "steps": [
        {
          "name": "fixture",
          "write": {
            "path": "{tmp}/fixture.loom-test",
            "text": "// RUN: emit spirv-low target=spirv:vulkan1.3+bda+hal features=MISSING\n\nfunc.def @entry() {\n  func.return\n}\n"
          }
        },
        {
          "name": "execute",
          "run": {
            "tool": "loom-check",
            "args": [
              "{tmp}/fixture.loom-test"
            ]
