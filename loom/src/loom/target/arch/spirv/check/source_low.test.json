    {
      "name": "profile refinement contradiction",
      "steps": [
        {
          "name": "fixture",
          "write": {
            "path": "{tmp}/fixture.loom-test",
            "text": "// RUN: emit spirv-low target=spirv:vulkan1.3+bda+hal features=-PHYSICAL_STORAGE_BUFFER\n\nfunc.def @entry() {\n  func.return\n}\n"
          }
        },
        {
          "name": "execute",
          "run": {
            "tool": "loom-check",
            "args": [
              "--json=failures",
              "{tmp}/fixture.loom-test"
            ]
          },
          "exit": {
            "nonzero": true
          },
          "stderr": {
            "contains": [
              "unexpected error at line 0:",
              "SPIRV/035",
              "SPIR-V feature 'spirv.physical_storage_buffer' has contradictory facts",
              "'spirv:vulkan1.3+bda+hal' says true",
              "'SPIR-V checker features option' says false"
            ]
          },
          "stdout": {
            "contains": [
              "\"detail\":\"unexpected error at line 0:",
              "\"domain\":\"SPIRV\",\"code\":35"
            ]
          }
        }
      ]
    },
    {
