load("//build_tools/testing:build_defs.bzl", "iree_execution_test_suite")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_config_compatible_with")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_cc_library(
    name = "profile",
    srcs = ["profile.c"],
    hdrs = ["profile.h"],
    visibility = ["//loom/src/loom/tooling/target/spirv:__pkg__"],
    deps = [
        "//loom/binding/c:loomc",
        "//loom/binding/c/target/spirv:profile",
        "//loom/src/loom/tools/loom-check:execute",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "source_low",
    srcs = ["source_low.c"],
    hdrs = ["source_low.h"],
    deps = [
        ":profile",
        "//loom/binding/c:loomc",
        "//loom/src/loom/tools/loom-check:execute",
        "//loom/src/loom/tools/loom-check:source_low",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "provider",
    srcs = ["provider.c"],
    hdrs = ["provider.h"],
    visibility = ["//loom/src/loom/tools/loom-check:__pkg__"],
    deps = [
        ":source_low",
        "//loom/src/loom/tools/loom-check:provider",
        "//runtime/src/iree/base",
    ],
)

iree_execution_test_suite(
    name = "source_low_test",
    manifests = ["source_low.test.json"],
    tags = ["hostonly"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/arch:spirv",
    ]),
    tools = {
        "loom-check": "//loom/src/loom/tools/loom-check",
    },
)
