low.func.def target<spirv.logical.core> abi(shader_entry_point) @dot_s8u8(%left_word: reg<spirv.id : i32>, %right_word: reg<spirv.id : i32>, %acc: reg<spirv.id : i32>) -> (reg<spirv.id : i32>) asm {
  %left = OpBitcast.i32.v4i8 %left_word
