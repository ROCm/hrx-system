// ====
// RUN: emit spirv-low target=spirv:vulkan1.3+bda+extended-types features=INTEGER_DOT_PRODUCT,INTEGER_DOT_PRODUCT_INPUT4X8_BIT,INTEGER_DOT_PRODUCT_INPUT4X8_BIT_PACKED control-flow=structured-low

func.def @affine_dot(%lhs0: i32, %lhs1: i32, %lhs2: i32, %lhs3: i32, %rhs0: i32, %rhs1: i32, %rhs2: i32, %rhs3: i32) -> (i32) {
  %left_word0 = vector.from_elements %lhs0 : vector<1xi32>
  %left_packet0 = vector.bitcast %left_word0 : vector<1xi32> to vector<4xi8>
  %left_word1 = vector.from_elements %lhs1 : vector<1xi32>
  %left_packet1 = vector.bitcast %left_word1 : vector<1xi32> to vector<4xi8>
  %left_word2 = vector.from_elements %lhs2 : vector<1xi32>
  %left_packet2 = vector.bitcast %left_word2 : vector<1xi32> to vector<4xi8>
  %left_word3 = vector.from_elements %lhs3 : vector<1xi32>
  %left_packet3 = vector.bitcast %left_word3 : vector<1xi32> to vector<4xi8>
  %left = vector.concat<0> %left_packet0, %left_packet1, %left_packet2, %left_packet3 : vector<4xi8>, vector<4xi8>, vector<4xi8>, vector<4xi8> -> vector<16xi8>
  %right_word0 = vector.from_elements %rhs0 : vector<1xi32>
  %right_packet0 = vector.bitcast %right_word0 : vector<1xi32> to vector<4xi8>
  %right_word1 = vector.from_elements %rhs1 : vector<1xi32>
  %right_packet1 = vector.bitcast %right_word1 : vector<1xi32> to vector<4xi8>
  %right_word2 = vector.from_elements %rhs2 : vector<1xi32>
  %right_packet2 = vector.bitcast %right_word2 : vector<1xi32> to vector<4xi8>
  %right_word3 = vector.from_elements %rhs3 : vector<1xi32>
  %right_packet3 = vector.bitcast %right_word3 : vector<1xi32> to vector<4xi8>
  %right = vector.concat<0> %right_packet0, %right_packet1, %right_packet2, %right_packet3 : vector<4xi8>, vector<4xi8>, vector<4xi8>, vector<4xi8> -> vector<16xi8>
  %accumulator = vector.splati 0 : vector<4xi32>
  %dot = vector.dot4i<s8s8> %left, %right, %accumulator : vector<16xi8>, vector<16xi8>, vector<4xi32>
  %reduction_init = scalar.constant 0 : i32
  %sum = vector.reduce<addi> %dot, %reduction_init : vector<4xi32>, i32
  func.return %sum : i32
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @affine_dot(%left_word0: reg<spirv.id : i32>, %left_word1: reg<spirv.id : i32>, %left_word2: reg<spirv.id : i32>, %left_word3: reg<spirv.id : i32>, %right_word0: reg<spirv.id : i32>, %right_word1: reg<spirv.id : i32>, %right_word2: reg<spirv.id : i32>, %right_word3: reg<spirv.id : i32>) -> (reg<spirv.id : i32>) asm {
  %left_packet0 = OpBitcast.i32.v4i8 %left_word0
  %left_packet1 = OpBitcast.i32.v4i8 %left_word1
  %left_packet2 = OpBitcast.i32.v4i8 %left_word2
  %left_packet3 = OpBitcast.i32.v4i8 %left_word3
  %right_packet0 = OpBitcast.i32.v4i8 %right_word0
  %right_packet1 = OpBitcast.i32.v4i8 %right_word1
  %right_packet2 = OpBitcast.i32.v4i8 %right_word2
  %right_packet3 = OpBitcast.i32.v4i8 %right_word3
  %114 = OpConstant.i32 0 : reg<spirv.id>
  %115 = OpBitcast.v4i8.i32 %left_packet0
  %116 = OpBitcast.v4i8.i32 %right_packet0
  %117 = OpSDot.packed4x8 %115, %116
  %118 = OpIAdd %117, %114
  %119 = OpBitcast.v4i8.i32 %left_packet1
  %120 = OpBitcast.v4i8.i32 %right_packet1
  %121 = OpSDot.packed4x8 %119, %120
  %122 = OpIAdd %121, %114
  %123 = OpBitcast.v4i8.i32 %left_packet2
  %124 = OpBitcast.v4i8.i32 %right_packet2
  %125 = OpSDot.packed4x8 %123, %124
  %126 = OpIAdd %125, %114
  %127 = OpBitcast.v4i8.i32 %left_packet3
  %128 = OpBitcast.v4i8.i32 %right_packet3
  %129 = OpSDot.packed4x8 %127, %128
  %130 = OpIAdd %129, %114
  %131 = OpIAdd %118, %122
  %132 = OpIAdd %131, %126
  %sum = OpIAdd %132, %130
  return %sum
}

// ====
// RUN: emit spirv-low target=spirv:vulkan1.3+bda+extended-types features=INTEGER_DOT_PRODUCT,INTEGER_DOT_PRODUCT_INPUT4X8_BIT_PACKED control-flow=structured-low

// Packed dot input signedness belongs to the operation, while the accumulator
// wraps at 32 bits. Both mixed forms must retain which byte vector is signed.
func.def @packed_dot_signedness(%left_word: i32, %right_word: i32, %accumulator: i32) -> (i32, i32, i32, i32) {
  %left_vector = vector.from_elements %left_word : vector<1xi32>
  %right_vector = vector.from_elements %right_word : vector<1xi32>
  %lhs = vector.bitcast %left_vector : vector<1xi32> to vector<4xi8>
  %rhs = vector.bitcast %right_vector : vector<1xi32> to vector<4xi8>
  %acc = vector.from_elements %accumulator : vector<1xi32>
  %signed = vector.dot4i<s8s8> %lhs, %rhs, %acc : vector<4xi8>, vector<4xi8>, vector<1xi32>
  %unsigned = vector.dot4i<u8u8> %lhs, %rhs, %acc : vector<4xi8>, vector<4xi8>, vector<1xi32>
  %signed_unsigned = vector.dot4i<s8u8> %lhs, %rhs, %acc : vector<4xi8>, vector<4xi8>, vector<1xi32>
  %unsigned_signed = vector.dot4i<u8s8> %lhs, %rhs, %acc : vector<4xi8>, vector<4xi8>, vector<1xi32>
  %signed_result = vector.extract %signed[0] : vector<1xi32> -> i32
  %unsigned_result = vector.extract %unsigned[0] : vector<1xi32> -> i32
  %signed_unsigned_result = vector.extract %signed_unsigned[0] : vector<1xi32> -> i32
  %unsigned_signed_result = vector.extract %unsigned_signed[0] : vector<1xi32> -> i32
  func.return %signed_result, %unsigned_result, %signed_unsigned_result, %unsigned_signed_result : i32, i32, i32, i32
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @packed_dot_signedness(%left_vector: reg<spirv.id : i32>, %right_vector: reg<spirv.id : i32>, %acc: reg<spirv.id : i32>) -> (reg<spirv.id : i32>, reg<spirv.id : i32>, reg<spirv.id : i32>, reg<spirv.id : i32>) asm {
  %lhs = OpBitcast.i32.v4i8 %left_vector
  %rhs = OpBitcast.i32.v4i8 %right_vector
  %32 = OpBitcast.v4i8.i32 %lhs
  %33 = OpBitcast.v4i8.i32 %rhs
  %34 = OpSDot.packed4x8 %32, %33
  %signed_result = OpIAdd %34, %acc
  %38 = OpUDot.packed4x8 %32, %33
  %39 = OpBitcast.u32.i32 %38
  %unsigned_result = OpIAdd %39, %acc
  %43 = OpSUDot.packed4x8 %32, %33
  %signed_unsigned_result = OpIAdd %43, %acc
  %47 = OpSUDot.packed4x8 %33, %32
  %unsigned_signed_result = OpIAdd %47, %acc
  return %signed_result, %unsigned_result, %signed_unsigned_result, %unsigned_signed_result
}

// ====
// RUN: emit spirv-low target=spirv:vulkan1.3+bda+extended-types features=INTEGER_DOT_PRODUCT,INTEGER_DOT_PRODUCT_INPUT4X8_BIT_PACKED control-flow=structured-low

// Publication and arithmetic share one packed word even when the arithmetic
// recipe creates its own intermediate from the same byte vector.
func.def @packed_dot_publication_reuse(%a: i32, %b: i32, %c: i32, %d: i32) -> (i32, i32) {
  %wide = vector.from_elements %a, %b, %c, %d : vector<4xi32>
  %bytes = vector.trunci %wide : vector<4xi32> to vector<4xi8>
  %packed = vector.bitcast %bytes : vector<4xi8> to vector<1xi32>
  %dot_weights = vector.splati 1 : vector<4xi8>
  %accumulator = vector.splati 0 : vector<1xi32>
  %sum = vector.dot4i<s8s8> %bytes, %dot_weights, %accumulator : vector<4xi8>, vector<4xi8>, vector<1xi32>
  %word = vector.extract %packed[0] : vector<1xi32> -> i32
  %total = vector.extract %sum[0] : vector<1xi32> -> i32
  func.return %word, %total : i32, i32
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @packed_dot_publication_reuse(%a: reg<spirv.id : i32>, %b: reg<spirv.id : i32>, %c: reg<spirv.id : i32>, %d: reg<spirv.id : i32>) -> (reg<spirv.id : i32>, reg<spirv.id : i32>) asm {
  %wide = OpCompositeConstruct.v4i32 %a, %b, %c, %d
  %bytes = OpSConvert.v4i32.v4i8 %wide
  %word = OpBitcast.v4i8.i32 %bytes
  %23 = OpConstant.i8 1
  %dot_weights = OpCompositeConstruct.v4i8 %23, %23, %23, %23
  %accumulator = OpConstant.i32 0 : reg<spirv.id>
  %27 = OpBitcast.v4i8.i32 %dot_weights
  %28 = OpSDot.packed4x8 %word, %27
  %total = OpIAdd %28, %accumulator
  return %word, %total
}
