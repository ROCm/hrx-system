low.func.def target<spirv.logical.core> abi(shader_entry_point) @dot_u8s8(%left_word: reg<spirv.id : i32>, %right_word: reg<spirv.id : i32>, %acc: reg<spirv.id : i32>) -> (reg<spirv.id : i32>) asm {
