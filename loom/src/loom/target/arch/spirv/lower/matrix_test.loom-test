// RUN: emit spirv-low target=spirv:vulkan1.3+bda+hal features=INT8,COOPERATIVE_MATRIX_KHR

kernel.def @signed_wrapping_k16() {
  %unit = index.constant 1 : index
  %threads = target.subgroup.size : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%output: buffer) {
  %origin = index.constant 0 : offset
  %tile = index.constant 16 : index
  %aligned = buffer.assume.alignment %output {minimum_alignment = 16} : buffer
  %storage = encoding.define #encoding.storage<layout=#encoding.layout.dense, schema=#encoding.operand<element_format=i32, payload_elements=8, payload_registers=8>> : encoding<storage>
  %destination = buffer.view %aligned[%origin] : buffer -> view<16x16xi32, %storage>
  %a_values_scalar = scalar.constant -2 : i8
  %a_values = vector.splat %a_values_scalar : vector<1xi8>
  %b_values_scalar = scalar.constant 3 : i8
  %b_values = vector.splat %b_values_scalar : vector<1xi8>
  %c_values_scalar = scalar.constant 7 : i32
  %c_values = vector.splat %c_values_scalar : vector<1xi32>
  %lhs = vector.fragment<lhs> %a_values shape [%tile, %tile] : vector<1xi8>
  %rhs = vector.fragment<rhs> %b_values shape [%tile, %tile] : vector<1xi8>
  %initial = vector.fragment<init> %c_values shape [%tile, %tile] : vector<1xi32>
  %result = vector.mma %lhs, %rhs, %initial : vector<1xi8>, vector<1xi8>, vector<1xi32>
  vector.fragment.store<result> %result, %destination[0, 0] shape [%tile, %tile] : vector<1xi32>, view<16x16xi32, %storage>
  kernel.return
}

// ----
low.kernel.def target<spirv.logical.core> abi_layout({signature = (buffer) -> ()}) workgroup_count(1, 1, 1) @signed_wrapping_k16() asm {
  %aligned = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %19 = OpConstant.i8 -2 : reg<spirv.id>
  %lhs = OpCompositeConstruct.cooperative.i8.16x16.lhs %19 : reg<spirv.id : spirv.cooperative_matrix<16x16xs8, subgroup, matrix_a>>
  %21 = OpConstant.i8 3 : reg<spirv.id>
  %rhs = OpCompositeConstruct.cooperative.i8.16x16.rhs %21 : reg<spirv.id : spirv.cooperative_matrix<16x16xs8, subgroup, matrix_b>>
  %23 = OpConstant.i32 7 : reg<spirv.id>
  %initial = OpCompositeConstruct.cooperative.i32.16x16.accumulator %23 : reg<spirv.id : spirv.cooperative_matrix<16x16xs32, subgroup, matrix_accumulator>>
  %result = OpCooperativeMatrixMulAddKHR.s8.16x16x16.s32.subgroup %lhs, %rhs, %initial : reg<spirv.id : spirv.cooperative_matrix<16x16xs32, subgroup, matrix_accumulator>>
  %26 = OpConstant.offset64 16
  %27 = OpUConvert.offset64.u32 %26
  %28 = OpConstant.offset64 0
  %29 = OpPtrAccessChain.storage_buffer.i32.byte_offset %aligned, %28
  OpCooperativeMatrixStoreKHR.result.i32.16x16.subgroup.storage_buffer %29, %result, %27, 0
  return
}

// ====

// RUN: emit spirv-low target=spirv:vulkan1.3+bda+hal features=INT8,COOPERATIVE_MATRIX_KHR

kernel.def @mixed_signed_saturating_k16() {
  %unit = index.constant 1 : index
  %threads = target.subgroup.size : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%output: buffer) {
  %origin = index.constant 0 : offset
  %tile = index.constant 16 : index
  %reduction = index.constant 16 : index
  %aligned = buffer.assume.alignment %output {minimum_alignment = 16} : buffer
  %storage = encoding.define #encoding.storage<layout=#encoding.layout.dense, schema=#encoding.operand<element_format=i32, payload_elements=8, payload_registers=8>> : encoding<storage>
  %destination = buffer.view %aligned[%origin] : buffer -> view<16x16xi32, %storage>
  %lhs_schema = encoding.define #encoding.operand<element_format=i8, payload_elements=16, payload_registers=4> : encoding<schema>
  %rhs_schema = encoding.define #encoding.operand<element_format=u8, payload_elements=16, payload_registers=4> : encoding<schema>
  %acc_schema = encoding.define #encoding.operand<element_format=i32, payload_elements=8, payload_registers=8> : encoding<schema>
  %a_values_scalar = scalar.constant -2 : i8
  %a_values = vector.splat %a_values_scalar : vector<1xi8>
  %b_values_scalar = scalar.constant 3 : i8
  %b_values = vector.splat %b_values_scalar : vector<1xi8>
  %c_values_scalar = scalar.constant 7 : i32
  %c_values = vector.splat %c_values_scalar : vector<1xi32>
  %lhs = vector.fragment<lhs> %a_values shape [%tile, %reduction] using {schema = %lhs_schema : encoding<schema>} : vector<1xi8>
  %rhs = vector.fragment<rhs> %b_values shape [%reduction, %tile] using {schema = %rhs_schema : encoding<schema>} : vector<1xi8>
  %initial = vector.fragment<init> %c_values shape [%tile, %tile] using {schema = %acc_schema : encoding<schema>} : vector<1xi32>
  %result = vector.mma<saturate> %lhs, %rhs, %initial : vector<1xi8>, vector<1xi8>, vector<1xi32>
  vector.fragment.store<result> %result, %destination[0, 0] shape [%tile, %tile] : vector<1xi32>, view<16x16xi32, %storage>
  kernel.return
}

// ----
low.kernel.def target<spirv.logical.core> abi_layout({signature = (buffer) -> ()}) workgroup_count(1, 1, 1) @mixed_signed_saturating_k16() asm {
  %aligned = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %23 = OpConstant.i8 -2 : reg<spirv.id>
  %lhs = OpCompositeConstruct.cooperative.i8.16x16.lhs %23 : reg<spirv.id : spirv.cooperative_matrix<16x16xs8, subgroup, matrix_a>>
  %25 = OpConstant.i8 3 : reg<spirv.id>
  %26 = OpBitcast.i8.u8 %25
  %rhs = OpCompositeConstruct.cooperative.u8.16x16.rhs %26 : reg<spirv.id : spirv.cooperative_matrix<16x16xu8, subgroup, matrix_b>>
  %28 = OpConstant.i32 7 : reg<spirv.id>
  %initial = OpCompositeConstruct.cooperative.i32.16x16.accumulator %28 : reg<spirv.id : spirv.cooperative_matrix<16x16xs32, subgroup, matrix_accumulator>>
  %result = OpCooperativeMatrixMulAddKHR.s8_u8.16x16x16.s32.subgroup.saturating %lhs, %rhs, %initial : reg<spirv.id : spirv.cooperative_matrix<16x16xs32, subgroup, matrix_accumulator>>
  %31 = OpConstant.offset64 16
  %32 = OpUConvert.offset64.u32 %31
  %33 = OpConstant.offset64 0
  %34 = OpPtrAccessChain.storage_buffer.i32.byte_offset %aligned, %33
  OpCooperativeMatrixStoreKHR.result.i32.16x16.subgroup.storage_buffer %34, %result, %32, 0
  return
}

