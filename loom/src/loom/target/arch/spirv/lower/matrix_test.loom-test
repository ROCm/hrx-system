// RUN: emit spirv-low target=spirv:vulkan1.3+bda+hal features=INT8,COOPERATIVE_MATRIX_KHR

kernel.def @mixed_unsigned_saturating_k32() {
  %unit = index.constant 1 : index
  %threads = target.subgroup.size : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%output: buffer) {
  %origin = index.constant 0 : offset
  %tile = index.constant 16 : index
  %reduction = index.constant 32 : index
  %aligned = buffer.assume.alignment %output {minimum_alignment = 16} : buffer
  %storage = encoding.define #encoding.storage<layout=#encoding.layout.dense, schema=#encoding.operand<element_format=u32, payload_elements=8, payload_registers=8>> : encoding<storage>
  %destination = buffer.view %aligned[%origin] : buffer -> view<16x16xi32, %storage>
  %lhs_schema = encoding.define #encoding.operand<element_format=u8, payload_elements=32, payload_registers=8> : encoding<schema>
  %rhs_schema = encoding.define #encoding.operand<element_format=i8, payload_elements=32, payload_registers=8> : encoding<schema>
  %acc_schema = encoding.define #encoding.operand<element_format=u32, payload_elements=8, payload_registers=8> : encoding<schema>
  %a_values = vector.splati -2 : vector<1xi8>
  %b_values = vector.splati 3 : vector<1xi8>
  %c_values = vector.splati 7 : vector<1xi32>
  %lhs = vector.fragment<lhs> %a_values shape [%tile, %reduction] using {schema = %lhs_schema : encoding<schema>} : vector<1xi8>
  %rhs = vector.fragment<rhs> %b_values shape [%reduction, %tile] using {schema = %rhs_schema : encoding<schema>} : vector<1xi8>
  %initial = vector.fragment<init> %c_values shape [%tile, %tile] using {schema = %acc_schema : encoding<schema>} : vector<1xi32>
  %result = vector.mma<saturate> %lhs, %rhs, %initial : vector<1xi8>, vector<1xi8>, vector<1xi32>
  vector.fragment.store<result> %result, %destination[0, 0] shape [%tile, %tile] : vector<1xi32>, view<16x16xi32, %storage>
  kernel.return
}

// ----
low.kernel.def target<spirv.logical.core> abi_layout({signature = (buffer) -> ()}) workgroup_count(1, 1, 1) @mixed_unsigned_saturating_k32() asm {
  %aligned = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %20 = OpConstant.i8 -2 : reg<spirv.id>
  %21 = OpBitcast.i8.u8 %20
  %lhs = OpCompositeConstruct.cooperative.u8.16x32.lhs %21 : reg<spirv.id : spirv.cooperative_matrix<16x32xu8, subgroup, matrix_a>>
  %23 = OpConstant.i8 3 : reg<spirv.id>
  %rhs = OpCompositeConstruct.cooperative.i8.32x16.rhs %23 : reg<spirv.id : spirv.cooperative_matrix<32x16xs8, subgroup, matrix_b>>
  %25 = OpConstant.i32 7 : reg<spirv.id>
  %26 = OpBitcast.i32.u32 %25
  %initial = OpCompositeConstruct.cooperative.u32.16x16.accumulator %26 : reg<spirv.id : spirv.cooperative_matrix<16x16xu32, subgroup, matrix_accumulator>>
  %result = OpCooperativeMatrixMulAddKHR.u8_s8.16x16x32.u32.subgroup.saturating %lhs, %rhs, %initial : reg<spirv.id : spirv.cooperative_matrix<16x16xu32, subgroup, matrix_accumulator>>
  %29 = OpConstant.offset64 16
  %30 = OpUConvert.offset64.u32 %29
  %31 = OpConstant.offset64 0
  %32 = OpPtrAccessChain.storage_buffer.u32.byte_offset %aligned, %31
  OpCooperativeMatrixStoreKHR.result.u32.16x16.subgroup.storage_buffer %32, %result, %30, 0
  return
}
