// RUN: emit spirv-low target=spirv:vulkan1.3+bda+hal features=COOPERATIVE_MATRIX_KHR

// A source carrier wider than an ordinary SPIR-V vector stays one matrix.
kernel.def @accumulator_8() {
  %unit = index.constant 1 : index
  %width = target.subgroup.size : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %tile = index.constant 16 : index
  %source = buffer.assume.alignment %input {minimum_alignment = 16} : buffer
  %destination = buffer.assume.alignment %output {minimum_alignment = 16} : buffer
  %in = buffer.view %source[%origin] : buffer -> view<32x16xf32>
  %out = buffer.view %destination[%origin] : buffer -> view<16x16xf32>
  %a = vector.fragment.load<init> %in[0, 0] shape [%tile, %tile] : view<32x16xf32> -> vector<8xf32>
  %b = vector.fragment.load<init> %in[16, 0] shape [%tile, %tile] : view<32x16xf32> -> vector<8xf32>
  %added = vector.addf %a, %b : vector<8xf32>
  %product = vector.mulf<contract> %added, %a : vector<8xf32>
  %difference = vector.subf %product, %b : vector<8xf32>
  %quotient = vector.divf %difference, %a : vector<8xf32>
  %negative = vector.negf %quotient : vector<8xf32>
  vector.fragment.store<result> %negative, %out[0, 0] shape [%tile, %tile] : vector<8xf32>, view<16x16xf32>
  kernel.return
}

// ----
low.kernel.def target<spirv.logical.core> abi_layout({signature = (buffer, buffer) -> ()}) workgroup_count(1, 1, 1) @accumulator_8() asm {
  %source = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %destination = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %19 = OpConstant.offset64 16
  %20 = OpUConvert.offset64.u32 %19
  %21 = OpConstant.offset64 0
  %22 = OpPtrAccessChain.storage_buffer.f32.byte_offset %source, %21
  %a = OpCooperativeMatrixLoadKHR.accumulator.f32.16x16.subgroup.storage_buffer %22, %20, 0 : reg<spirv.id : spirv.cooperative_matrix<16x16xf32, subgroup, matrix_accumulator>>
  %24 = OpConstant.offset64 16
  %25 = OpUConvert.offset64.u32 %24
  %26 = OpConstant.offset64 1024
  %27 = OpPtrAccessChain.storage_buffer.f32.byte_offset %source, %26
  %b = OpCooperativeMatrixLoadKHR.accumulator.f32.16x16.subgroup.storage_buffer %27, %25, 0 : reg<spirv.id : spirv.cooperative_matrix<16x16xf32, subgroup, matrix_accumulator>>
  %added = OpFAdd.cooperative.f32.16x16.accumulator %a, %b : reg<spirv.id : spirv.cooperative_matrix<16x16xf32, subgroup, matrix_accumulator>>
  %product = OpFMul.cooperative.f32.16x16.accumulator %added, %a {allow_contraction = 1} : reg<spirv.id : spirv.cooperative_matrix<16x16xf32, subgroup, matrix_accumulator>>
  %difference = OpFSub.cooperative.f32.16x16.accumulator %product, %b : reg<spirv.id : spirv.cooperative_matrix<16x16xf32, subgroup, matrix_accumulator>>
  %quotient = OpFDiv.cooperative.f32.16x16.accumulator %difference, %a : reg<spirv.id : spirv.cooperative_matrix<16x16xf32, subgroup, matrix_accumulator>>
  %negative = OpFNegate.cooperative.f32.16x16.accumulator %quotient : reg<spirv.id : spirv.cooperative_matrix<16x16xf32, subgroup, matrix_accumulator>>
  %34 = OpConstant.offset64 16
  %35 = OpUConvert.offset64.u32 %34
  %36 = OpConstant.offset64 0
  %37 = OpPtrAccessChain.storage_buffer.f32.byte_offset %destination, %36
  OpCooperativeMatrixStoreKHR.accumulator.f32.16x16.subgroup.storage_buffer %37, %negative, %35, 0
  return
}

// ====

// RUN: emit spirv-low target=spirv:vulkan1.3+bda+hal features=FLOAT16,STORAGE_BUFFER_16BIT_ACCESS,COOPERATIVE_MATRIX_KHR

// Arithmetic preserves A/B uses independently of the accumulator use.
kernel.def @operand_1() {
  %unit = index.constant 1 : index
  %width = target.subgroup.size : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%output: buffer, %a: f16, %b: f16, %c: f16) {
  %origin = index.constant 0 : offset
  %tile = index.constant 16 : index
  %destination = buffer.assume.alignment %output {minimum_alignment = 16} : buffer
  %out = buffer.view %destination[%origin] : buffer -> view<16x16xf16>
  %a_vector = vector.splat %a : vector<1xf16>
  %b_vector = vector.splat %b : vector<1xf16>
  %c_vector = vector.splat %c : vector<1xf16>
  %lhs = vector.fragment<lhs> %a_vector shape [%tile, %tile] : vector<1xf16>
  %rhs = vector.fragment<rhs> %b_vector shape [%tile, %tile] : vector<1xf16>
  %init = vector.fragment<init> %c_vector shape [%tile, %tile] : vector<1xf16>
  %negative = vector.negf %lhs : vector<1xf16>
  %sum = vector.addf %rhs, %rhs : vector<1xf16>
  %result = vector.mma %negative, %sum, %init : vector<1xf16>, vector<1xf16>, vector<1xf16>
  %product = vector.mulf %result, %init : vector<1xf16>
  vector.fragment.store<result> %product, %out[0, 0] shape [%tile, %tile] : vector<1xf16>, view<16x16xf16>
  kernel.return
}

// ----
low.kernel.def target<spirv.logical.core> abi_layout({signature = (buffer, f16, f16, f16) -> ()}) workgroup_count(1, 1, 1) @operand_1(%a: reg<spirv.id : f16>, %b: reg<spirv.id : f16>, %c: reg<spirv.id : f16>) asm {
  %destination = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %lhs = OpCompositeConstruct.cooperative.f16.16x16.lhs %a : reg<spirv.id : spirv.cooperative_matrix<16x16xf16, subgroup, matrix_a>>
  %rhs = OpCompositeConstruct.cooperative.f16.16x16.rhs %b : reg<spirv.id : spirv.cooperative_matrix<16x16xf16, subgroup, matrix_b>>
  %init = OpCompositeConstruct.cooperative.f16.16x16.accumulator %c : reg<spirv.id : spirv.cooperative_matrix<16x16xf16, subgroup, matrix_accumulator>>
  %negative = OpFNegate.cooperative.f16.16x16.lhs %lhs : reg<spirv.id : spirv.cooperative_matrix<16x16xf16, subgroup, matrix_a>>
  %sum = OpFAdd.cooperative.f16.16x16.rhs %rhs, %rhs : reg<spirv.id : spirv.cooperative_matrix<16x16xf16, subgroup, matrix_b>>
  %result = OpCooperativeMatrixMulAddKHR.f16.16x16x16.f16.subgroup %negative, %sum, %init : reg<spirv.id : spirv.cooperative_matrix<16x16xf16, subgroup, matrix_accumulator>>
  %product = OpFMul.cooperative.f16.16x16.accumulator %result, %init : reg<spirv.id : spirv.cooperative_matrix<16x16xf16, subgroup, matrix_accumulator>>
  %31 = OpConstant.offset64 16
  %32 = OpUConvert.offset64.u32 %31
  %33 = OpConstant.offset64 0
  %34 = OpPtrAccessChain.storage_buffer.f16.byte_offset %destination, %33
  OpCooperativeMatrixStoreKHR.accumulator.f16.16x16.subgroup.storage_buffer %34, %product, %32, 0
  return
}

