// RUN: emit spirv-low target=spirv:vulkan1.3+bda+hal features=COOPERATIVE_MATRIX_KHR

kernel.def @integer_4() {
  %unit = index.constant 1 : index
  %width = target.subgroup.size : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %tile = index.constant 16 : index
  %source = buffer.assume.alignment %input {minimum_alignment = 16} : buffer
  %destination = buffer.assume.alignment %output {minimum_alignment = 16} : buffer
  %storage = encoding.define #encoding.storage<layout=#encoding.layout.dense, schema=#encoding.operand<element_format=i32, payload_elements=4, payload_registers=4>> : encoding<storage>
  %in = buffer.view %source[%origin] : buffer -> view<32x16xi32, %storage>
  %out = buffer.view %destination[%origin] : buffer -> view<16x16xi32, %storage>
  %a = vector.fragment.load<init> %in[0, 0] shape [%tile, %tile] : view<32x16xi32, %storage> -> vector<4xi32>
  %b = vector.fragment.load<init> %in[16, 0] shape [%tile, %tile] : view<32x16xi32, %storage> -> vector<4xi32>
  %added = vector.addi %a, %b : vector<4xi32>
  %product = vector.muli %added, %a : vector<4xi32>
  %difference = vector.subi %product, %b : vector<4xi32>
  %signed = vector.divsi %difference, %a : vector<4xi32>
  %unsigned = vector.divui %signed, %b : vector<4xi32>
  %negative = vector.negi %unsigned : vector<4xi32>
  vector.fragment.store<result> %negative, %out[0, 0] shape [%tile, %tile] : vector<4xi32>, view<16x16xi32, %storage>
  kernel.return
}

