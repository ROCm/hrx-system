low.kernel.def target<spirv.logical.core> abi_layout({signature = (buffer, buffer) -> ()}) workgroup_count(1, 1, 1) @integer_4() asm {
  %source = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %destination = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %21 = OpConstant.offset64 16
  %22 = OpUConvert.offset64.u32 %21
  %23 = OpConstant.offset64 0
  %24 = OpPtrAccessChain.storage_buffer.i32.byte_offset %source, %23
  %a = OpCooperativeMatrixLoadKHR.accumulator.i32.16x16.subgroup.storage_buffer %24, %22, 0 : reg<spirv.id : spirv.cooperative_matrix<16x16xs32, subgroup, matrix_accumulator>>
  %26 = OpConstant.offset64 16
  %27 = OpUConvert.offset64.u32 %26
  %28 = OpConstant.offset64 1024
  %29 = OpPtrAccessChain.storage_buffer.i32.byte_offset %source, %28
  %b = OpCooperativeMatrixLoadKHR.accumulator.i32.16x16.subgroup.storage_buffer %29, %27, 0 : reg<spirv.id : spirv.cooperative_matrix<16x16xs32, subgroup, matrix_accumulator>>
  %added = OpIAdd.cooperative.i32.16x16.accumulator %a, %b : reg<spirv.id : spirv.cooperative_matrix<16x16xs32, subgroup, matrix_accumulator>>
  %product = OpIMul.cooperative.i32.16x16.accumulator %added, %a : reg<spirv.id : spirv.cooperative_matrix<16x16xs32, subgroup, matrix_accumulator>>
  %difference = OpISub.cooperative.i32.16x16.accumulator %product, %b : reg<spirv.id : spirv.cooperative_matrix<16x16xs32, subgroup, matrix_accumulator>>
  %signed = OpSDiv.cooperative.i32.16x16.accumulator %difference, %a : reg<spirv.id : spirv.cooperative_matrix<16x16xs32, subgroup, matrix_accumulator>>
  %unsigned = OpUDiv.cooperative.i32.16x16.accumulator %signed, %b : reg<spirv.id : spirv.cooperative_matrix<16x16xs32, subgroup, matrix_accumulator>>
  %negative = OpSNegate.cooperative.i32.16x16.accumulator %unsigned : reg<spirv.id : spirv.cooperative_matrix<16x16xs32, subgroup, matrix_accumulator>>
  %37 = OpConstant.offset64 16
  %38 = OpUConvert.offset64.u32 %37
  %39 = OpConstant.offset64 0
  %40 = OpPtrAccessChain.storage_buffer.i32.byte_offset %destination, %39
  OpCooperativeMatrixStoreKHR.accumulator.i32.16x16.subgroup.storage_buffer %40, %negative, %38, 0
  return
}

