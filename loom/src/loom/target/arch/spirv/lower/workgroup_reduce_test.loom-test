// RUN: emit spirv-low target=spirv:vulkan1.3+bda+subgroup32+reductions+hal limits=MAX_WORKGROUP_SUBGROUP_COUNT:2

// Boolean packets keep logical arithmetic at both levels and use integer
// scratch solely for the Workgroup storage boundary. The profile's subgroup
// count bound narrows each array to two partial slots plus the final value.
kernel.def @boolean_packet() {
  %unit = index.constant 1 : index
  %width = index.constant 3 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %item = kernel.workitem.id<x> : index
  %source = buffer.view %input[%base] : buffer -> view<3x2xi32>
  %destination = buffer.view %output[%base] : buffer -> view<3x2xi32>
  %values = vector.load %source[%item, 0] : view<3x2xi32> -> vector<2xi32>
  %predicates = vector.trunci %values : vector<2xi32> to vector<2xi1>
  %parity = kernel.workgroup.reduce<addi> %predicates : vector<2xi1>
  %bits = vector.extui %parity : vector<2xi1> to vector<2xi32>
  vector.store %bits, %destination[%item, 0] : vector<2xi32>, view<3x2xi32>
  kernel.return
}

// ----
low.kernel.def target<spirv.logical.core> abi_layout({signature = (buffer, buffer) -> ()}) workgroup_size(3, 1, 1) workgroup_count(1, 1, 1) @boolean_packet() asm {
  %input = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %output = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %item = OpLoadBuiltin.local_invocation_id.x
  %47 = OpSConvert.i32.offset64 %item
  %48 = OpConstant.offset64 8
  %49 = OpIMul.offset64 %47, %48
  %50 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input, %49
  %51 = OpLoad.storage_buffer.i32 %50
  %55 = OpConstant.offset64 4
  %56 = OpIAdd.offset64 %49, %55
  %57 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input, %56
  %58 = OpLoad.storage_buffer.i32 %57
  %59 = OpConstant.i32 1
  %60 = OpBitwiseAnd %51, %59
  %61 = OpIEqual %60, %59
  %63 = OpBitwiseAnd %58, %59
  %64 = OpIEqual %63, %59
  %predicates = OpCompositeConstruct.v2bool %61, %64
  %66 = OpConstant.i32 0
  %68 = OpLoadBuiltin.subgroup_id : reg<spirv.id : i32>
  %69 = OpLoadBuiltin.num_subgroups : reg<spirv.id : i32>
  %70 = OpGroupNonUniformIAdd.exclusive_scan.i32 %59
  %71 = OpConstantFalse.bool
  %72 = OpCompositeExtract.v2bool.bool %predicates, 0
  %73 = OpGroupNonUniformLogicalXor.reduce.bool %72
  %74 = OpSelect %73, %59, %66
  %75 = storage {byte_alignment = 4, byte_length = 12} : low.storage<workgroup>
  %76 = storage_address %75 : low.storage<workgroup> -> reg<spirv.ptr.workgroup.array.i32>
  %77 = OpCompositeExtract.v2bool.bool %predicates, 1
  %78 = OpGroupNonUniformLogicalXor.reduce.bool %77
  %79 = OpSelect %78, %59, %66
  %80 = storage {byte_alignment = 4, byte_length = 12} : low.storage<workgroup>
  %81 = storage_address %80 : low.storage<workgroup> -> reg<spirv.ptr.workgroup.array.i32>
  %82 = OpIEqual %70, %66
  low.scf.if %82 {
    %83 = OpAccessChain.workgroup.i32.element_index %76, %68
    OpStore.workgroup.i32 %83, %74
    %84 = OpAccessChain.workgroup.i32.element_index %81, %68
    OpStore.workgroup.i32 %84, %79
  }
  OpControlBarrier.workgroup.workgroup.acq_rel
  %85 = OpConstant.i32 2
  %86 = OpAccessChain.workgroup.i32.element_index %76, %85
  %87 = OpAccessChain.workgroup.i32.element_index %81, %85
  %88 = OpIEqual %68, %66
  low.scf.if %88 {
    %89 = OpGroupNonUniformIAdd.reduce.i32 %59
    %93, %94 = low.scf.for unsigned [%70 to %69 step %89] iter_args(%71: reg<spirv.id : i1>, %71: reg<spirv.id : i1>) -> (reg<spirv.id : i1>, reg<spirv.id : i1>) do(%90: reg<spirv.id : i32>, %91: reg<spirv.id : i1>, %92: reg<spirv.id : i1>) {
      %95 = OpAccessChain.workgroup.i32.element_index %76, %90
      %96 = OpLoad.workgroup.i32 %95
      %97 = OpINotEqual %96, %66
      %98 = OpLogicalNotEqual.bool %91, %97
      %99 = OpAccessChain.workgroup.i32.element_index %81, %90
      %100 = OpLoad.workgroup.i32 %99
      %101 = OpINotEqual %100, %66
      %102 = OpLogicalNotEqual.bool %92, %101
      low.scf.yield %98, %102 : reg<spirv.id : i1>, reg<spirv.id : i1>
    }
    %103 = OpGroupNonUniformLogicalXor.reduce.bool %93
    %104 = OpSelect %103, %59, %66
    %105 = OpGroupNonUniformLogicalXor.reduce.bool %94
    %106 = OpSelect %105, %59, %66
    low.scf.if %82 {
      OpStore.workgroup.i32 %86, %104
      OpStore.workgroup.i32 %87, %106
    }
  }
  OpControlBarrier.workgroup.workgroup.acq_rel
  %107 = OpLoad.workgroup.i32 %86
  %108 = OpINotEqual %107, %66
  %109 = OpLoad.workgroup.i32 %87
  %110 = OpINotEqual %109, %66
  %parity = OpCompositeConstruct.v2bool %108, %110
  %112 = OpConstant.i32 1
  %113 = OpCompositeConstruct.v2i32 %112, %112
  %114 = OpConstant.i32 0
  %115 = OpCompositeConstruct.v2i32 %114, %114
  %bits = OpSelect.v2i32 %parity, %113, %115
  %117 = OpCompositeExtract.v2i32.i32 %bits, 0
  %118 = OpCompositeExtract.v2i32.i32 %bits, 1
  %119 = OpSConvert.i32.offset64 %item
  %120 = OpConstant.offset64 8
  %121 = OpIMul.offset64 %119, %120
  %122 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output, %121
  OpStore.storage_buffer.i32 %122, %117
  %126 = OpConstant.offset64 4
  %127 = OpIAdd.offset64 %121, %126
  %128 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output, %127
  OpStore.storage_buffer.i32 %128, %118
  return
}

// ====

// RUN: emit spirv-low target=spirv:vulkan1.3+bda+hal features=GROUP_NON_UNIFORM_ARITHMETIC,INT8,-SUBGROUP_EXTENDED_TYPES

// A valid first payload cannot hide a later payload's missing capability.
kernel.def @later_payload_capability() {
  %unit = index.constant 1 : index
  %width = index.constant 3 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%output: buffer, %value: i32) {
  %base = index.constant 0 : offset
  %destination = buffer.view %output[%base] : buffer -> view<2xi32>
  %byte = scalar.trunci %value : i32 to i8
  // ERROR@+1: TARGET/003 {subject_role="feature", subject_name="spirv.subgroup_extended_types", constraint_key="native_collective_features"}
  %word_sum, %byte_sum = kernel.workgroup.reduce<addi> %value, %byte : i32, i8
  %byte_result = scalar.extui %byte_sum : i8 to i32
  view.store %word_sum, %destination[0] : i32, view<2xi32>
  view.store %byte_result, %destination[1] : i32, view<2xi32>
  kernel.return
}

// ====

// RUN: emit spirv-low target=spirv:vulkan1.3+bda+subgroup32+reductions+hal features=BFLOAT16_TYPE_KHR

kernel.def @bfloat_preservation_requires_provider() {
  %unit = index.constant 1 : index
  %width = index.constant 3 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%output: buffer, %value: bf16) {
  %base = index.constant 0 : offset
  %destination = buffer.view %output[%base] : buffer -> view<1xbf16>
  // ERROR@+1: TARGET/003 {subject_role="flags", subject_name="math", constraint_key="has_none.preserve"}
  %sum = kernel.workgroup.reduce<addf, preserve> %value : bf16
  view.store %sum, %destination[0] : bf16, view<1xbf16>
  kernel.return
}

