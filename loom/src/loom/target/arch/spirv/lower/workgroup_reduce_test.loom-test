// RUN: emit spirv-low target=spirv:vulkan1.3+bda+subgroup32+reductions+hal limits=MAX_WORKGROUP_STORAGE_BYTES:616

// Differently sized unsigned values share topology but retain typed scratch
// and their own identities. Signed source carriers are restored at the result.
kernel.def @mixed_unsigned() {
  %unit = index.constant 1 : index
  %width = index.constant 67 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %item = kernel.workitem.id<x> : index
  %source = buffer.view %input[%base] : buffer -> view<67xi64>
  %destination = buffer.view %output[%base] : buffer -> view<67x2xi64>
  %value = view.load %source[%item] : view<67xi64> -> i64
  %byte = scalar.trunci %value : i64 to i8
  %byte_minimum, %wide_minimum = kernel.workgroup.reduce<minui> %byte, %value : i8, i64
  %byte_result = scalar.extui %byte_minimum : i8 to i64
  view.store %byte_result, %destination[%item, 0] : i64, view<67x2xi64>
  view.store %wide_minimum, %destination[%item, 1] : i64, view<67x2xi64>
  kernel.return
}

// ----
low.kernel.def target<spirv.logical.core> abi_layout({signature = (buffer, buffer) -> ()}) workgroup_size(67, 1, 1) workgroup_count(1, 1, 1) @mixed_unsigned() asm {
  %input = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %output = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %item = OpLoadBuiltin.local_invocation_id.x
  %26 = OpSConvert.i32.offset64 %item
  %27 = OpConstant.offset64 8
  %28 = OpIMul.offset64 %26, %27
  %29 = OpPtrAccessChain.storage_buffer.i64.byte_offset %input, %28
  %value = OpLoad.storage_buffer.i64 %29
  %byte = OpSConvert.i64.i8 %value
  %32 = OpConstant.i32 0
  %33 = OpConstant.i32 1
  %34 = OpLoadBuiltin.subgroup_id : reg<spirv.id : i32>
  %35 = OpLoadBuiltin.num_subgroups : reg<spirv.id : i32>
  %36 = OpGroupNonUniformIAdd.exclusive_scan.i32 %33
  %37 = OpConstant.i8 -1
  %38 = OpBitcast.i8.u8 %37 : reg<spirv.id : i8>
  %39 = OpBitcast.i8.u8 %byte : reg<spirv.id : i8>
  %40 = OpGroupNonUniformUMin.reduce.u8 %39 : reg<spirv.id : i8>
  %41 = storage {byte_alignment = 1, byte_length = 68} : low.storage<workgroup>
  %42 = storage_address %41 : low.storage<workgroup> -> reg<spirv.ptr.workgroup.array.u8>
  %43 = OpConstant.i64 -1
  %44 = OpBitcast.i64.u64 %43 : reg<spirv.id : i64>
  %45 = OpBitcast.i64.u64 %value : reg<spirv.id : i64>
  %46 = OpGroupNonUniformUMin.reduce.u64 %45 : reg<spirv.id : i64>
  %47 = storage {byte_alignment = 8, byte_length = 544} : low.storage<workgroup>
  %48 = storage_address %47 : low.storage<workgroup> -> reg<spirv.ptr.workgroup.array.u64>
  %49 = OpIEqual %36, %32
  low.scf.if %49 {
    %50 = OpAccessChain.workgroup.u8.element_index %42, %34
    OpStore.workgroup.u8 %50, %40
    %51 = OpAccessChain.workgroup.u64.element_index %48, %34
    OpStore.workgroup.u64 %51, %46
  }
  OpControlBarrier.workgroup.workgroup.acq_rel
  %52 = OpConstant.i32 67
  %53 = OpAccessChain.workgroup.u8.element_index %42, %52
  %54 = OpAccessChain.workgroup.u64.element_index %48, %52
  %55 = OpIEqual %34, %32
  low.scf.if %55 {
    %56 = OpGroupNonUniformIAdd.reduce.i32 %33
    %60, %61 = low.scf.for unsigned [%36 to %35 step %56] iter_args(%38: reg<spirv.id : i8>, %44: reg<spirv.id : i64>) -> (reg<spirv.id : i8>, reg<spirv.id : i64>) do(%57: reg<spirv.id : i32>, %58: reg<spirv.id : i8>, %59: reg<spirv.id : i64>) {
      %62 = OpAccessChain.workgroup.u8.element_index %42, %57
      %63 = OpLoad.workgroup.u8 %62 : reg<spirv.id : i8>
      %64 = OpULessThan.u8 %58, %63
      %65 = OpSelect.u8 %64, %58, %63 : reg<spirv.id : i8>
      %66 = OpAccessChain.workgroup.u64.element_index %48, %57
      %67 = OpLoad.workgroup.u64 %66 : reg<spirv.id : i64>
      %68 = OpULessThan.u64 %59, %67
      %69 = OpSelect.u64 %68, %59, %67 : reg<spirv.id : i64>
      low.scf.yield %65, %69 : reg<spirv.id : i8>, reg<spirv.id : i64>
    }
    %70 = OpGroupNonUniformUMin.reduce.u8 %60 : reg<spirv.id : i8>
    %71 = OpGroupNonUniformUMin.reduce.u64 %61 : reg<spirv.id : i64>
    low.scf.if %49 {
      OpStore.workgroup.u8 %53, %70
      OpStore.workgroup.u64 %54, %71
    }
  }
  OpControlBarrier.workgroup.workgroup.acq_rel
  %72 = OpLoad.workgroup.u8 %53 : reg<spirv.id : i8>
  %byte_minimum = OpBitcast.u8.i8 %72
  %74 = OpLoad.workgroup.u64 %54 : reg<spirv.id : i64>
  %wide_minimum = OpBitcast.u64.i64 %74
  %76 = OpBitcast.i8.u8 %byte_minimum
  %77 = OpUConvert.u8.u64 %76
  %byte_result = OpBitcast.u64.i64 %77
  %79 = OpSConvert.i32.offset64 %item
  %80 = OpConstant.offset64 16
  %81 = OpIMul.offset64 %79, %80
  %82 = OpPtrAccessChain.storage_buffer.i64.byte_offset %output, %81
  OpStore.storage_buffer.i64 %82, %byte_result
  %86 = OpConstant.offset64 8
  %87 = OpIAdd.offset64 %81, %86
  %88 = OpPtrAccessChain.storage_buffer.i64.byte_offset %output, %87
  OpStore.storage_buffer.i64 %88, %wide_minimum
  return
}

