// RUN: emit spirv-low target=spirv:vulkan1.3+bda+subgroup32+reductions+hal limits=MAX_WORKGROUP_SUBGROUP_COUNT:2

// Boolean packets keep logical arithmetic at both levels and use integer
// scratch solely for the Workgroup storage boundary. The profile's subgroup
// count bound narrows each array to two partial slots plus the final value.
kernel.def @boolean_packet() {
  %unit = index.constant 1 : index
  %width = index.constant 3 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %item = kernel.workitem.id<x> : index
  %source = buffer.view %input[%base] : buffer -> view<3x2xi32>
  %destination = buffer.view %output[%base] : buffer -> view<3x2xi32>
  %values = vector.load %source[%item, 0] : view<3x2xi32> -> vector<2xi32>
  %predicates = vector.trunci %values : vector<2xi32> to vector<2xi1>
  %parity = kernel.workgroup.reduce<addi> %predicates : vector<2xi1>
  %bits = vector.extui %parity : vector<2xi1> to vector<2xi32>
  vector.store %bits, %destination[%item, 0] : vector<2xi32>, view<3x2xi32>
  kernel.return
}

// ----
low.kernel.def target<spirv.logical.core> abi_layout({signature = (buffer, buffer) -> ()}) workgroup_size(3, 1, 1) workgroup_count(1, 1, 1) @boolean_packet() asm {
  %input = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %output = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %item = OpLoadBuiltin.local_invocation_id.x
  %38 = OpSConvert.i32.offset64 %item
  %39 = OpConstant.offset64 8
  %40 = OpIMul.offset64 %38, %39
  %41 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input, %40
  %42 = OpLoad.storage_buffer.i32 %41
  %46 = OpConstant.offset64 4
  %47 = OpIAdd.offset64 %40, %46
  %48 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input, %47
  %49 = OpLoad.storage_buffer.i32 %48
  %values = OpCompositeConstruct.v2i32 %42, %49
  %51 = OpConstant.i32 1
  %52 = OpCompositeConstruct.v2i32 %51, %51
  %53 = OpBitwiseAnd.v2i32 %values, %52
  %54 = OpConstant.i32 0
  %55 = OpCompositeConstruct.v2i32 %54, %54
  %56 = OpBitcast.v2i32.v2u32 %55
  %57 = OpBitcast.v2i32.v2u32 %53
  %predicates = OpULessThan.v2u32 %56, %57
  %61 = OpLoadBuiltin.subgroup_id : reg<spirv.id : i32>
  %62 = OpLoadBuiltin.num_subgroups : reg<spirv.id : i32>
  %63 = OpGroupNonUniformIAdd.exclusive_scan.i32 %51
  %64 = OpConstantFalse.bool
  %65 = OpCompositeExtract.v2bool.bool %predicates, 0
  %66 = OpGroupNonUniformLogicalXor.reduce.bool %65
  %67 = OpSelect %66, %51, %54
  %68 = storage {byte_alignment = 4, byte_length = 12} : low.storage<workgroup>
  %69 = storage_address %68 : low.storage<workgroup> -> reg<spirv.ptr.workgroup.array.i32>
  %70 = OpCompositeExtract.v2bool.bool %predicates, 1
  %71 = OpGroupNonUniformLogicalXor.reduce.bool %70
  %72 = OpSelect %71, %51, %54
  %73 = storage {byte_alignment = 4, byte_length = 12} : low.storage<workgroup>
  %74 = storage_address %73 : low.storage<workgroup> -> reg<spirv.ptr.workgroup.array.i32>
  %75 = OpIEqual %63, %54
  low.scf.if %75 {
    %76 = OpAccessChain.workgroup.i32.element_index %69, %61
    OpStore.workgroup.i32 %76, %67
    %77 = OpAccessChain.workgroup.i32.element_index %74, %61
    OpStore.workgroup.i32 %77, %72
  }
  OpControlBarrier.workgroup.workgroup.acq_rel
  %78 = OpConstant.i32 2
  %79 = OpAccessChain.workgroup.i32.element_index %69, %78
  %80 = OpAccessChain.workgroup.i32.element_index %74, %78
  %81 = OpIEqual %61, %54
  low.scf.if %81 {
    %82 = OpGroupNonUniformIAdd.reduce.i32 %51
    %86, %87 = low.scf.for unsigned [%63 to %62 step %82] iter_args(%64: reg<spirv.id : i1>, %64: reg<spirv.id : i1>) -> (reg<spirv.id : i1>, reg<spirv.id : i1>) do(%83: reg<spirv.id : i32>, %84: reg<spirv.id : i1>, %85: reg<spirv.id : i1>) {
      %88 = OpAccessChain.workgroup.i32.element_index %69, %83
      %89 = OpLoad.workgroup.i32 %88
      %90 = OpINotEqual %89, %54
      %91 = OpLogicalNotEqual.bool %84, %90
      %92 = OpAccessChain.workgroup.i32.element_index %74, %83
      %93 = OpLoad.workgroup.i32 %92
      %94 = OpINotEqual %93, %54
      %95 = OpLogicalNotEqual.bool %85, %94
      low.scf.yield %91, %95 : reg<spirv.id : i1>, reg<spirv.id : i1>
    }
    %96 = OpGroupNonUniformLogicalXor.reduce.bool %86
    %97 = OpSelect %96, %51, %54
    %98 = OpGroupNonUniformLogicalXor.reduce.bool %87
    %99 = OpSelect %98, %51, %54
    low.scf.if %75 {
      OpStore.workgroup.i32 %79, %97
      OpStore.workgroup.i32 %80, %99
    }
  }
  OpControlBarrier.workgroup.workgroup.acq_rel
  %100 = OpLoad.workgroup.i32 %79
  %101 = OpINotEqual %100, %54
  %102 = OpLoad.workgroup.i32 %80
  %103 = OpINotEqual %102, %54
  %parity = OpCompositeConstruct.v2bool %101, %103
  %bits = OpSelect.v2i32 %parity, %52, %55
  %106 = OpCompositeExtract.v2i32.i32 %bits, 0
  %107 = OpCompositeExtract.v2i32.i32 %bits, 1
  %108 = OpSConvert.i32.offset64 %item
  %109 = OpConstant.offset64 8
  %110 = OpIMul.offset64 %108, %109
  %111 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output, %110
  OpStore.storage_buffer.i32 %111, %106
  %115 = OpConstant.offset64 4
  %116 = OpIAdd.offset64 %110, %115
  %117 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output, %116
  OpStore.storage_buffer.i32 %117, %107
  return
}

// ====

// RUN: emit spirv-low target=spirv:vulkan1.3+bda+hal features=GROUP_NON_UNIFORM_ARITHMETIC,INT8,-SUBGROUP_EXTENDED_TYPES

// A valid first payload cannot hide a later payload's missing capability.
kernel.def @later_payload_capability() {
  %unit = index.constant 1 : index
  %width = index.constant 3 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%output: buffer, %value: i32) {
  %base = index.constant 0 : offset
  %destination = buffer.view %output[%base] : buffer -> view<2xi32>
  %byte = scalar.trunci %value : i32 to i8
  // ERROR@+1: TARGET/003 {subject_role="feature", subject_name="spirv.subgroup_extended_types", constraint_key="native_collective_features"}
  %word_sum, %byte_sum = kernel.workgroup.reduce<addi> %value, %byte : i32, i8
  %byte_result = scalar.extui %byte_sum : i8 to i32
  view.store %word_sum, %destination[0] : i32, view<2xi32>
  view.store %byte_result, %destination[1] : i32, view<2xi32>
  kernel.return
}

// ====

// RUN: emit spirv-low target=spirv:vulkan1.3+bda+subgroup32+reductions+hal features=BFLOAT16_TYPE_KHR

kernel.def @bfloat_preservation_requires_provider() {
  %unit = index.constant 1 : index
  %width = index.constant 3 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%output: buffer, %value: bf16) {
  %base = index.constant 0 : offset
  %destination = buffer.view %output[%base] : buffer -> view<1xbf16>
  // ERROR@+1: TARGET/003 {subject_role="flags", subject_name="math", constraint_key="has_none.preserve"}
  %sum = kernel.workgroup.reduce<addf, preserve> %value : bf16
  view.store %sum, %destination[0] : bf16, view<1xbf16>
  kernel.return
}

