// RUN: emit spirv-low target=spirv:vulkan1.3+bda+subgroup32+reductions+hal limits=MAX_WORKGROUP_SUBGROUP_COUNT:2

// Boolean packets keep logical arithmetic at both levels and use integer
// scratch solely for the Workgroup storage boundary. The profile's subgroup
// count bound narrows each array to two partial slots plus the final value.
kernel.def @boolean_packet() {
  %unit = index.constant 1 : index
  %width = index.constant 3 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %item = kernel.workitem.id<x> : index
  %source = buffer.view %input[%base] : buffer -> view<3x2xi32>
  %destination = buffer.view %output[%base] : buffer -> view<3x2xi32>
  %values = vector.load %source[%item, 0] : view<3x2xi32> -> vector<2xi32>
  %predicates = vector.trunci %values : vector<2xi32> to vector<2xi1>
  %parity = kernel.workgroup.reduce<addi> %predicates : vector<2xi1>
  %bits = vector.extui %parity : vector<2xi1> to vector<2xi32>
  vector.store %bits, %destination[%item, 0] : vector<2xi32>, view<3x2xi32>
  kernel.return
}

// ----
low.kernel.def target<spirv.logical.core> abi_layout({signature = (buffer, buffer) -> ()}) workgroup_size(3, 1, 1) workgroup_count(1, 1, 1) @boolean_packet() asm {
  %input = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %output = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %item = OpLoadBuiltin.local_invocation_id.x
  %39 = OpSConvert.i32.offset64 %item
  %40 = OpConstant.offset64 8
  %41 = OpIMul.offset64 %39, %40
  %42 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input, %41
  %43 = OpLoad.storage_buffer.i32 %42
  %47 = OpConstant.offset64 4
  %48 = OpIAdd.offset64 %41, %47
  %49 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input, %48
  %50 = OpLoad.storage_buffer.i32 %49
  %51 = OpConstant.i32 1
  %52 = OpBitwiseAnd %43, %51
  %53 = OpIEqual %52, %51
  %55 = OpBitwiseAnd %50, %51
  %56 = OpIEqual %55, %51
  %predicates = OpCompositeConstruct.v2bool %53, %56
  %58 = OpConstant.i32 0
  %60 = OpLoadBuiltin.subgroup_id : reg<spirv.id : i32>
  %61 = OpLoadBuiltin.num_subgroups : reg<spirv.id : i32>
  %62 = OpGroupNonUniformIAdd.exclusive_scan.i32 %51
  %63 = OpConstantFalse.bool
  %64 = OpCompositeExtract.v2bool.bool %predicates, 0
  %65 = OpGroupNonUniformLogicalXor.reduce.bool %64
  %66 = OpSelect %65, %51, %58
  %67 = storage {byte_alignment = 4, byte_length = 12} : low.storage<workgroup>
  %68 = storage_address %67 : low.storage<workgroup> -> reg<spirv.ptr.workgroup.array.i32>
  %69 = OpCompositeExtract.v2bool.bool %predicates, 1
  %70 = OpGroupNonUniformLogicalXor.reduce.bool %69
  %71 = OpSelect %70, %51, %58
  %72 = storage {byte_alignment = 4, byte_length = 12} : low.storage<workgroup>
  %73 = storage_address %72 : low.storage<workgroup> -> reg<spirv.ptr.workgroup.array.i32>
  %74 = OpIEqual %62, %58
  low.scf.if %74 {
    %75 = OpAccessChain.workgroup.i32.element_index %68, %60
    OpStore.workgroup.i32 %75, %66
    %76 = OpAccessChain.workgroup.i32.element_index %73, %60
    OpStore.workgroup.i32 %76, %71
  }
  OpControlBarrier.workgroup.workgroup.acq_rel
  %77 = OpConstant.i32 2
  %78 = OpAccessChain.workgroup.i32.element_index %68, %77
  %79 = OpAccessChain.workgroup.i32.element_index %73, %77
  %80 = OpIEqual %60, %58
  low.scf.if %80 {
    %81 = OpGroupNonUniformIAdd.reduce.i32 %51
    %85, %86 = low.scf.for unsigned [%62 to %61 step %81] iter_args(%63: reg<spirv.id : i1>, %63: reg<spirv.id : i1>) -> (reg<spirv.id : i1>, reg<spirv.id : i1>) do(%82: reg<spirv.id : i32>, %83: reg<spirv.id : i1>, %84: reg<spirv.id : i1>) {
      %87 = OpAccessChain.workgroup.i32.element_index %68, %82
      %88 = OpLoad.workgroup.i32 %87
      %89 = OpINotEqual %88, %58
      %90 = OpLogicalNotEqual.bool %83, %89
      %91 = OpAccessChain.workgroup.i32.element_index %73, %82
      %92 = OpLoad.workgroup.i32 %91
      %93 = OpINotEqual %92, %58
      %94 = OpLogicalNotEqual.bool %84, %93
      low.scf.yield %90, %94 : reg<spirv.id : i1>, reg<spirv.id : i1>
    }
    %95 = OpGroupNonUniformLogicalXor.reduce.bool %85
    %96 = OpSelect %95, %51, %58
    %97 = OpGroupNonUniformLogicalXor.reduce.bool %86
    %98 = OpSelect %97, %51, %58
    low.scf.if %74 {
      OpStore.workgroup.i32 %78, %96
      OpStore.workgroup.i32 %79, %98
    }
  }
  OpControlBarrier.workgroup.workgroup.acq_rel
  %99 = OpLoad.workgroup.i32 %78
  %100 = OpINotEqual %99, %58
  %101 = OpLoad.workgroup.i32 %79
  %102 = OpINotEqual %101, %58
  %parity = OpCompositeConstruct.v2bool %100, %102
  %104 = OpConstant.i32 1
  %105 = OpCompositeConstruct.v2i32 %104, %104
  %106 = OpConstant.i32 0
  %107 = OpCompositeConstruct.v2i32 %106, %106
  %bits = OpSelect.v2i32 %parity, %105, %107
  %109 = OpCompositeExtract.v2i32.i32 %bits, 0
  %110 = OpCompositeExtract.v2i32.i32 %bits, 1
  %111 = OpSConvert.i32.offset64 %item
  %112 = OpConstant.offset64 8
  %113 = OpIMul.offset64 %111, %112
  %114 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output, %113
  OpStore.storage_buffer.i32 %114, %109
  %118 = OpConstant.offset64 4
  %119 = OpIAdd.offset64 %113, %118
  %120 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output, %119
  OpStore.storage_buffer.i32 %120, %110
  return
}

// ====

// RUN: emit spirv-low target=spirv:vulkan1.3+bda+hal features=GROUP_NON_UNIFORM_ARITHMETIC,INT8,-SUBGROUP_EXTENDED_TYPES

// A valid first payload cannot hide a later payload's missing capability.
kernel.def @later_payload_capability() {
  %unit = index.constant 1 : index
  %width = index.constant 3 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%output: buffer, %value: i32) {
  %base = index.constant 0 : offset
  %destination = buffer.view %output[%base] : buffer -> view<2xi32>
  %byte = scalar.trunci %value : i32 to i8
  // ERROR@+1: TARGET/003 {subject_role="feature", subject_name="spirv.subgroup_extended_types", constraint_key="native_collective_features"}
  %word_sum, %byte_sum = kernel.workgroup.reduce<addi> %value, %byte : i32, i8
  %byte_result = scalar.extui %byte_sum : i8 to i32
  view.store %word_sum, %destination[0] : i32, view<2xi32>
  view.store %byte_result, %destination[1] : i32, view<2xi32>
  kernel.return
}

// ====

// RUN: emit spirv-low target=spirv:vulkan1.3+bda+subgroup32+reductions+hal features=BFLOAT16_TYPE_KHR

kernel.def @bfloat_preservation_requires_provider() {
  %unit = index.constant 1 : index
  %width = index.constant 3 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%output: buffer, %value: bf16) {
  %base = index.constant 0 : offset
  %destination = buffer.view %output[%base] : buffer -> view<1xbf16>
  // ERROR@+1: TARGET/003 {subject_role="flags", subject_name="math", constraint_key="has_none.preserve"}
  %sum = kernel.workgroup.reduce<addf, preserve> %value : bf16
  view.store %sum, %destination[0] : bf16, view<1xbf16>
  kernel.return
}

