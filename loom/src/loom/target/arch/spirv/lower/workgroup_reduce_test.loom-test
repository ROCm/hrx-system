// RUN: emit spirv-low target=spirv:vulkan1.3+bda+subgroup32+reductions+hal limits=MAX_WORKGROUP_STORAGE_BYTES:616

// Differently sized unsigned values share topology but retain typed scratch
// and their own identities. Signed source carriers are restored at the result.
kernel.def @mixed_unsigned() {
  %unit = index.constant 1 : index
  %width = index.constant 67 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %item = kernel.workitem.id<x> : index
  %source = buffer.view %input[%base] : buffer -> view<67xi64>
  %destination = buffer.view %output[%base] : buffer -> view<67x2xi64>
  %value = view.load %source[%item] : view<67xi64> -> i64
  %byte = scalar.trunci %value : i64 to i8
  %byte_minimum, %wide_minimum = kernel.workgroup.reduce<minui> %byte, %value : i8, i64
  %byte_result = scalar.extui %byte_minimum : i8 to i64
  view.store %byte_result, %destination[%item, 0] : i64, view<67x2xi64>
  view.store %wide_minimum, %destination[%item, 1] : i64, view<67x2xi64>
  kernel.return
}

// ----
low.kernel.def target<spirv.logical.core> abi_layout({signature = (buffer, buffer) -> ()}) workgroup_size(67, 1, 1) workgroup_count(1, 1, 1) @mixed_unsigned() asm {
  %input = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %output = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %item = OpLoadBuiltin.local_invocation_id.x
  %20 = OpSConvert.i32.offset64 %item
  %21 = OpConstant.offset64 8
  %22 = OpIMul.offset64 %20, %21
  %23 = OpPtrAccessChain.storage_buffer.i64.byte_offset %input, %22
  %value = OpLoad.storage_buffer.i64 %23
  %byte = OpSConvert.i64.i8 %value
  %26 = OpConstant.i32 0
  %27 = OpConstant.i32 1
  %28 = OpLoadBuiltin.subgroup_id : reg<spirv.id : i32>
  %29 = OpLoadBuiltin.num_subgroups : reg<spirv.id : i32>
  %30 = OpGroupNonUniformIAdd.exclusive_scan.i32 %27
  %31 = OpConstant.i8 -1
  %32 = OpBitcast.i8.u8 %31 : reg<spirv.id : i8>
  %33 = OpBitcast.i8.u8 %byte : reg<spirv.id : i8>
  %34 = OpGroupNonUniformUMin.reduce.u8 %33 : reg<spirv.id : i8>
  %35 = storage {byte_alignment = 1, byte_length = 68} : low.storage<workgroup>
  %36 = storage_address %35 : low.storage<workgroup> -> reg<spirv.ptr.workgroup.array.u8>
  %37 = OpConstant.i64 -1
  %38 = OpBitcast.i64.u64 %37 : reg<spirv.id : i64>
  %39 = OpBitcast.i64.u64 %value : reg<spirv.id : i64>
  %40 = OpGroupNonUniformUMin.reduce.u64 %39 : reg<spirv.id : i64>
  %41 = storage {byte_alignment = 8, byte_length = 544} : low.storage<workgroup>
  %42 = storage_address %41 : low.storage<workgroup> -> reg<spirv.ptr.workgroup.array.u64>
  %43 = OpIEqual %30, %26
  low.scf.if %43 {
    %44 = OpAccessChain.workgroup.u8.element_index %36, %28
    OpStore.workgroup.u8 %44, %34
    %45 = OpAccessChain.workgroup.u64.element_index %42, %28
    OpStore.workgroup.u64 %45, %40
  }
  OpControlBarrier.workgroup.workgroup.acq_rel
  %46 = OpConstant.i32 67
  %47 = OpAccessChain.workgroup.u8.element_index %36, %46
  %48 = OpAccessChain.workgroup.u64.element_index %42, %46
  %49 = OpIEqual %28, %26
  low.scf.if %49 {
    %50 = OpGroupNonUniformIAdd.reduce.i32 %27
    %54, %55 = low.scf.for unsigned [%30 to %29 step %50] iter_args(%32: reg<spirv.id : i8>, %38: reg<spirv.id : i64>) -> (reg<spirv.id : i8>, reg<spirv.id : i64>) do(%51: reg<spirv.id : i32>, %52: reg<spirv.id : i8>, %53: reg<spirv.id : i64>) {
      %56 = OpAccessChain.workgroup.u8.element_index %36, %51
      %57 = OpLoad.workgroup.u8 %56 : reg<spirv.id : i8>
      %58 = OpULessThan.u8 %52, %57
      %59 = OpSelect.u8 %58, %52, %57 : reg<spirv.id : i8>
      %60 = OpAccessChain.workgroup.u64.element_index %42, %51
      %61 = OpLoad.workgroup.u64 %60 : reg<spirv.id : i64>
      %62 = OpULessThan.u64 %53, %61
      %63 = OpSelect.u64 %62, %53, %61 : reg<spirv.id : i64>
      low.scf.yield %59, %63 : reg<spirv.id : i8>, reg<spirv.id : i64>
    }
    %64 = OpGroupNonUniformUMin.reduce.u8 %54 : reg<spirv.id : i8>
    %65 = OpGroupNonUniformUMin.reduce.u64 %55 : reg<spirv.id : i64>
    low.scf.if %43 {
      OpStore.workgroup.u8 %47, %64
      OpStore.workgroup.u64 %48, %65
    }
  }
  OpControlBarrier.workgroup.workgroup.acq_rel
  %66 = OpLoad.workgroup.u8 %47 : reg<spirv.id : i8>
  %byte_minimum = OpBitcast.u8.i8 %66
  %68 = OpLoad.workgroup.u64 %48 : reg<spirv.id : i64>
  %wide_minimum = OpBitcast.u64.i64 %68
  %70 = OpBitcast.i8.u8 %byte_minimum
  %71 = OpUConvert.u8.u64 %70
  %byte_result = OpBitcast.u64.i64 %71
  %73 = OpSConvert.i32.offset64 %item
  %74 = OpConstant.offset64 16
  %75 = OpIMul.offset64 %73, %74
  %76 = OpPtrAccessChain.storage_buffer.i64.byte_offset %output, %75
  OpStore.storage_buffer.i64 %76, %byte_result
  %80 = OpConstant.offset64 8
  %81 = OpIAdd.offset64 %75, %80
  %82 = OpPtrAccessChain.storage_buffer.i64.byte_offset %output, %81
  OpStore.storage_buffer.i64 %82, %wide_minimum
  return
}

