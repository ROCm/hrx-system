// RUN: emit spirv-low target=spirv:vulkan1.3+bda+subgroup32+reductions+hal limits=MAX_WORKGROUP_STORAGE_BYTES:47

// Seven explicit bytes, four I8 partial/final slots, padding, and four I64
// partial/final slots reserve 48 bytes together, not 43 bytes independently.
// ERROR@+1: TARGET/051 {reserved_bytes="48", limit_bytes="47"}
kernel.def @mixed_storage_limit() {
  %unit = index.constant 1 : index
  %width = index.constant 3 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%output: buffer, %value: i64) {
  %base = index.constant 0 : offset
  %bytes = index.constant 7 : offset
  %allocation = buffer.alloca<workgroup> align(1) %bytes : buffer
  %saved = buffer.view %allocation[%base] : buffer -> view<7xi8>
  %destination = buffer.view %output[%base] : buffer -> view<2xi64>
  %item = kernel.workitem.id<x> : index
  %byte = scalar.trunci %value : i64 to i8
  view.store %byte, %saved[%item] : i8, view<7xi8>
  %byte_sum, %wide_sum = kernel.workgroup.reduce<addi> %byte, %value : i8, i64
  %reloaded = view.load %saved[%item] : view<7xi8> -> i8
  %combined = scalar.addi %reloaded, %byte_sum : i8
  %byte_result = scalar.extui %combined : i8 to i64
  view.store %byte_result, %destination[0] : i64, view<2xi64>
  view.store %wide_sum, %destination[1] : i64, view<2xi64>
  kernel.return
}

// ====

// RUN: emit spirv-low target=spirv:vulkan1.3+bda+hal features=FLOAT16,STORAGE_BUFFER_16BIT_ACCESS,GROUP_NON_UNIFORM_ARITHMETIC,SUBGROUP_EXTENDED_TYPES,-INT16

// Native half arithmetic needs no integer16 operations just to form its identity.
kernel.def @half_without_integer16() {
  %unit = index.constant 1 : index
  %width = index.constant 3 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%output: buffer, %value: f16) {
  %base = index.constant 0 : offset
  %destination = buffer.view %output[%base] : buffer -> view<1xf16>
  %sum = kernel.workgroup.reduce<addf> %value : f16
  view.store %sum, %destination[0] : f16, view<1xf16>
  kernel.return
}

// ----
low.kernel.def target<spirv.logical.core> abi_layout({signature = (buffer, f16) -> ()}) workgroup_size(3, 1, 1) workgroup_count(1, 1, 1) @half_without_integer16(%value: reg<spirv.id : f16>) asm {
  %output = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %9 = OpConstant.i32 0
  %10 = OpConstant.i32 1
  %11 = OpLoadBuiltin.subgroup_id : reg<spirv.id : i32>
  %12 = OpLoadBuiltin.num_subgroups : reg<spirv.id : i32>
  %13 = OpGroupNonUniformIAdd.exclusive_scan.i32 %10
  %14 = OpConstant.f16 0
  %15 = OpGroupNonUniformFAdd.reduce.f16 %value
  %16 = storage {byte_alignment = 2, byte_length = 8} : low.storage<workgroup>
  %17 = storage_address %16 : low.storage<workgroup> -> reg<spirv.ptr.workgroup.array.f16>
  %18 = OpIEqual %13, %9
  low.scf.if %18 {
    %19 = OpAccessChain.workgroup.f16.element_index %17, %11
    OpStore.workgroup.f16 %19, %15
  }
  OpControlBarrier.workgroup.workgroup.acq_rel
  %20 = OpConstant.i32 3
  %21 = OpAccessChain.workgroup.f16.element_index %17, %20
  %22 = OpIEqual %11, %9
  low.scf.if %22 {
    %23 = OpGroupNonUniformIAdd.reduce.i32 %10
    %26 = low.scf.for unsigned [%13 to %12 step %23] iter_args(%14: reg<spirv.id : f16>) -> (reg<spirv.id : f16>) do(%24: reg<spirv.id : i32>, %25: reg<spirv.id : f16>) {
      %27 = OpAccessChain.workgroup.f16.element_index %17, %24
      %28 = OpLoad.workgroup.f16 %27
      %29 = OpFAdd.f16 %25, %28
      low.scf.yield %29 : reg<spirv.id : f16>
    }
    %30 = OpGroupNonUniformFAdd.reduce.f16 %26
    low.scf.if %18 {
      OpStore.workgroup.f16 %21, %30
    }
  }
  OpControlBarrier.workgroup.workgroup.acq_rel
  %sum = OpLoad.workgroup.f16 %21
  %32 = OpConstant.offset64 0
  %33 = OpPtrAccessChain.storage_buffer.f16.byte_offset %output, %32
  OpStore.storage_buffer.f16 %33, %sum
  return
}
