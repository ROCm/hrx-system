// RUN: emit spirv-low target=spirv:vulkan1.3+bda+subgroup32+reductions+hal

kernel.def @preservation_requires_provider() {
  %unit = index.constant 1 : index
  %width = index.constant 3 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%output: buffer, %value: f32) {
  %base = index.constant 0 : offset
  %destination = buffer.view %output[%base] : buffer -> view<1xf32>
  // ERROR@+1: TARGET/003 {subject_role="flags", subject_name="math", constraint_key="has_none.preserve"}
  %sum = kernel.workgroup.reduce<addf, preserve> %value : f32
  view.store %sum, %destination[0] : f32, view<1xf32>
  kernel.return
}

