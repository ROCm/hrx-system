load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_library",
    "loom_config_compatible_with",
)
load("//loom/build_tools/bazel:loom_check.bzl", "loom_check_test_suite")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_SPIRV_ROOT_VISIBILITY = ["//loom/src/loom/target/arch/spirv:__pkg__"]

loom_cc_library(
    name = "lower",
    srcs = [
        "matrix.c",
        "registry.c",
        "workgroup.c",
        "workgroup_layout.c",
    ],
    hdrs = [
        "lower.h",
        "matrix.h",
        "workgroup.h",
        "workgroup_layout.h",
    ],
    textual_hdrs = ["//loom/src/loom/target/arch/spirv/contracts:tables.inl"],
    visibility = _SPIRV_ROOT_VISIBILITY,
    deps = [
        "//loom/src/loom/analysis:contract_vector",
        "//loom/src/loom/analysis:source_storage_packing",
        "//loom/src/loom/analysis:storage_interference",
        "//loom/src/loom/analysis:storage_layout",
        "//loom/src/loom/codegen/low:descriptors",
        "//loom/src/loom/codegen/low:source_memory_plan",
        "//loom/src/loom/codegen/low/lower",
        "//loom/src/loom/error:error_defs",
        "//loom/src/loom/ir",
        "//loom/src/loom/ir:facts",
        "//loom/src/loom/ops:atomic",
        "//loom/src/loom/ops/buffer",
        "//loom/src/loom/ops/func",
        "//loom/src/loom/ops/kernel",
        "//loom/src/loom/ops/low",
        "//loom/src/loom/ops/vector",
        "//loom/src/loom/ops/view",
        "//loom/src/loom/target:registers",
        "//loom/src/loom/target/arch/spirv:cooperative_properties",
        "//loom/src/loom/target/arch/spirv:error_defs",
        "//loom/src/loom/target/arch/spirv:facts",
        "//loom/src/loom/target/arch/spirv:features",
        "//loom/src/loom/target/arch/spirv:isa",
        "//loom/src/loom/target/arch/spirv:registers",
        "//loom/src/loom/target/arch/spirv:scalar_types",
        "//loom/src/loom/target/arch/spirv:value_types",
        "//loom/src/loom/target/arch/spirv/contracts",
        "//loom/src/loom/target/arch/spirv/descriptors",
        "//loom/src/loom/target/arch/spirv/descriptors:descriptors_ids",
        "//loom/src/loom/target/arch/spirv/ops",
        "//loom/src/loom/util:fact_table",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal",
    ],
)

loom_cc_library(
    name = "cooperative_initializer",
    srcs = ["cooperative_initializer.c"],
    hdrs = ["cooperative_initializer.h"],
    visibility = ["//loom/src/loom/target/arch/spirv/contracts:__pkg__"],
    deps = [
        "//loom/src/loom/codegen/low/lower",
        "//loom/src/loom/ir",
        "//loom/src/loom/ir:facts",
        "//loom/src/loom/ops/vector",
        "//loom/src/loom/util:fact_table",
        "//runtime/src/iree/base",
    ],
)

loom_check_test_suite(
    name = "cooperative_initializer_tests",
    srcs = ["cooperative_initializer_test.loom-test"],
    tags = ["hostonly"],
    target_compatible_with = loom_config_compatible_with(["//loom/config/target:spirv_artifacts"]),
)

loom_check_test_suite(
    name = "cooperative_memory_tests",
    srcs = ["cooperative_memory_test.loom-test"],
    tags = ["hostonly"],
    target_compatible_with = loom_config_compatible_with(["//loom/config/target:spirv_artifacts"]),
)
