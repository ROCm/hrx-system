// ====

// RUN: emit spirv-low target=spirv:vulkan1.3+bda+hal features=FLOAT64,INT8,STORAGE_BUFFER_8BIT_ACCESS

// Two byte packets cover exactly eight bytes and retain volatility on both.
kernel.def @byte_doubles() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%source: buffer, %target: buffer) {
  %origin = index.constant 1 : offset
  %input = buffer.view %source[%origin] : buffer -> view<1xf64, align(1)>
  %output = buffer.view %target[%origin] : buffer -> view<1xf64, align(1)>
  %value = view.load<volatile> %input[0] : view<1xf64, align(1)> -> f64
  view.store<volatile> %value, %output[0] : f64, view<1xf64, align(1)>
  kernel.return
}

// ----
low.kernel.def target<spirv.logical.core> abi_layout({signature = (buffer, buffer) -> ()}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @byte_doubles() asm {
  %source = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %target = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %9 = OpConstant.offset64 0
  %10 = OpConstant.offset64 1
  %11 = OpIAdd.storage_buffer.byte_offset %source, %10
  %12 = OpPtrAccessChain.storage_buffer.v4i8.byte_offset %11, %9
  %13 = OpLoad.storage_buffer.v4i8<volatile> %12
  %14 = OpBitcast.v4i8.i32 %13 : reg<spirv.id>
  %15 = OpConstant.offset64 4
  %18 = OpPtrAccessChain.storage_buffer.v4i8.byte_offset %11, %15
  %19 = OpLoad.storage_buffer.v4i8<volatile> %18
  %20 = OpBitcast.v4i8.i32 %19 : reg<spirv.id>
  %21 = OpCompositeConstruct.v2i32 %14, %20 : reg<spirv.id>
  %value = OpBitcast.v2i32.f64 %21
  %23 = OpBitcast.f64.v2i32 %value : reg<spirv.id>
  %26 = OpIAdd.storage_buffer.byte_offset %target, %10
  %27 = OpPtrAccessChain.storage_buffer.v4i8.byte_offset %26, %9
  %28 = OpCompositeExtract.v2i32.i32 %23, 0 : reg<spirv.id>
  %29 = OpBitcast.i32.v4i8 %28 : reg<spirv.id>
  OpStore.storage_buffer.v4i8<volatile> %27, %29
  %33 = OpPtrAccessChain.storage_buffer.v4i8.byte_offset %26, %15
  %34 = OpCompositeExtract.v2i32.i32 %23, 1 : reg<spirv.id>
  %35 = OpBitcast.i32.v4i8 %34 : reg<spirv.id>
  OpStore.storage_buffer.v4i8<volatile> %33, %35
  return
}

