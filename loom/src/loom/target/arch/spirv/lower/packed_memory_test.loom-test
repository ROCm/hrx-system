// RUN: emit spirv-low target=spirv:vulkan1.3+bda+hal features=INT16,STORAGE_BUFFER_16BIT_ACCESS

// The 210-byte Q6 record stride leaves alternating i32 payloads halfword aligned.
kernel.def @halfword_words() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%source: buffer, %target: buffer, %element: index) {
  %position = index.assume %element [range(%element, 0, 7)] : index
  %origin = index.constant 2 : offset
  %input = buffer.view %source[%origin] : buffer -> view<8xi32, align(2)>
  %output = buffer.view %target[%origin] : buffer -> view<8xi32, align(2)>
  %value = view.load<volatile> %input[%position] : view<8xi32, align(2)> -> i32
  view.store<volatile> %value, %output[%position] : i32, view<8xi32, align(2)>
  kernel.return
}

// ----
low.kernel.def target<spirv.logical.core> abi_layout({signature = (buffer, buffer, index) -> ()}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @halfword_words(%position: reg<spirv.id : index>) asm {
  %source = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %target = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %12 = OpSConvert.i32.offset64 %position
  %13 = OpConstant.offset64 4
  %14 = OpIMul.offset64 %12, %13
  %15 = OpConstant.offset64 2
  %16 = OpIAdd.offset64 %14, %15
  %17 = OpPtrAccessChain.storage_buffer.v2i16.byte_offset %source, %16
  %18 = OpLoad.storage_buffer.v2i16<volatile> %17
  %value = OpBitcast.v2i16.i32 %18
  %20 = OpBitcast.i32.v2i16 %value : reg<spirv.id>
  %26 = OpPtrAccessChain.storage_buffer.v2i16.byte_offset %target, %16
  OpStore.storage_buffer.v2i16<volatile> %26, %20
  return
}

// ====

// RUN: emit spirv-low target=spirv:vulkan1.3+bda+hal features=INT8,INT16,STORAGE_BUFFER_8BIT_ACCESS

kernel.def @byte_halfwords() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%source: buffer, %target: buffer) {
  %origin = index.constant 1 : offset
  %input = buffer.view %source[%origin] : buffer -> view<1xi16, align(1)>
  %output = buffer.view %target[%origin] : buffer -> view<1xi16, align(1)>
  %value = view.load %input[0] : view<1xi16, align(1)> -> i16
  view.store %value, %output[0] : i16, view<1xi16, align(1)>
  kernel.return
}

// ----
low.kernel.def target<spirv.logical.core> abi_layout({signature = (buffer, buffer) -> ()}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @byte_halfwords() asm {
  %source = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %target = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %9 = OpConstant.offset64 1
  %10 = OpPtrAccessChain.storage_buffer.v2i8.byte_offset %source, %9
  %11 = OpLoad.storage_buffer.v2i8 %10
  %value = OpBitcast.v2i8.i16 %11
  %13 = OpBitcast.i16.v2i8 %value : reg<spirv.id>
  %15 = OpPtrAccessChain.storage_buffer.v2i8.byte_offset %target, %9
  OpStore.storage_buffer.v2i8 %15, %13
  return
}

