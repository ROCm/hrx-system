  %10 = OpPtrAccessChain.storage_buffer.v2i8.byte_offset %source, %9
  %11 = OpLoad.storage_buffer.v2i8 %10
  %value = OpBitcast.v2i8.bf16 %11
  %13 = OpBitcast.bf16.v2i8 %value : reg<spirv.id>
  %15 = OpPtrAccessChain.storage_buffer.v2i8.byte_offset %target, %9
