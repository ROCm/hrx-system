// RUN: emit spirv-low target=spirv:vulkan1.3+bda+hal features=INT8,INT16,STORAGE_BUFFER_8BIT_ACCESS

kernel.def @carried_bfloat() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%source: buffer, %target: buffer) {
  %origin = index.constant 1 : offset
  %input = buffer.view %source[%origin] : buffer -> view<1xbf16, align(1)>
  %output = buffer.view %target[%origin] : buffer -> view<1xbf16, align(1)>
  %value = view.load %input[0] : view<1xbf16, align(1)> -> bf16
  view.store %value, %output[0] : bf16, view<1xbf16, align(1)>
  kernel.return
}

// ----
low.kernel.def target<spirv.logical.core> abi_layout({signature = (buffer, buffer) -> ()}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @carried_bfloat() asm {
  %source = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %target = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %9 = OpConstant.offset64 1
  %10 = OpPtrAccessChain.storage_buffer.v2i8.byte_offset %source, %9
  %11 = OpLoad.storage_buffer.v2i8 %10
  %12 = OpBitcast.v2i8.i16 %11 : reg<spirv.id>
  %13 = OpBitcast.i16.u16 %12
  %14 = OpUConvert.u16.u32 %13
  %value = OpBitcast.u32.i32 %14
  %16 = OpSConvert.i32.i16 %value
  %17 = OpBitcast.i16.v2i8 %16 : reg<spirv.id>
  %19 = OpPtrAccessChain.storage_buffer.v2i8.byte_offset %target, %9
  OpStore.storage_buffer.v2i8 %19, %17
  return
}

// ====

// RUN: emit spirv-low target=spirv:vulkan1.3+bda+hal features=INT8,INT16,STORAGE_BUFFER_8BIT_ACCESS,STORAGE_BUFFER_16BIT_ACCESS

// Retained root alignment can prove more than the declared view alignment.
kernel.def @proven_word_alignment() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%source: buffer, %target: buffer) {
  %aligned_source = buffer.assume.alignment %source {minimum_alignment = 4} : buffer
  %aligned_target = buffer.assume.alignment %target {minimum_alignment = 4} : buffer
  %origin = index.constant 0 : offset
  %input = buffer.view %aligned_source[%origin] : buffer -> view<1xi32, align(1)>
  %output = buffer.view %aligned_target[%origin] : buffer -> view<1xi32, align(1)>
  %value = view.load %input[0] : view<1xi32, align(1)> -> i32
  view.store %value, %output[0] : i32, view<1xi32, align(1)>
  kernel.return
}

// ----
low.kernel.def target<spirv.logical.core> abi_layout({signature = (buffer, buffer) -> ()}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @proven_word_alignment() asm {
  %aligned_source = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %aligned_target = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %11 = OpConstant.offset64 0
  %12 = OpPtrAccessChain.storage_buffer.i32.byte_offset %aligned_source, %11
  %value = OpLoad.storage_buffer.i32 %12
  %15 = OpPtrAccessChain.storage_buffer.i32.byte_offset %aligned_target, %11
  OpStore.storage_buffer.i32 %15, %value
  return
}
