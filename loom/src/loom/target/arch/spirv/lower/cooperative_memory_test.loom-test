// RUN: emit spirv-low target=spirv:vulkan1.3+bda+hal features=INT8,COOPERATIVE_MATRIX_KHR

kernel.def @unsigned_integer_storage() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%output: buffer) {
  %base = index.constant 0 : offset
  %m = index.constant 16 : index
  %k = index.constant 32 : index
  %aligned = buffer.assume.alignment %output {minimum_alignment = 16} : buffer
  %bytes = index.constant 2048 : offset
  %tile_bytes = index.constant 1024 : offset
  %allocation = buffer.alloca<workgroup> align(16) %bytes : buffer
  %subgroup0 = kernel.subgroup.id : index
  %subgroup = index.assume %subgroup0 [range(%subgroup0, 0, 1)] : index
  %tile_offset = index.scale %subgroup, %tile_bytes : index, offset -> offset
  %input_schema = encoding.define #encoding.operand<element_format=u8, payload_elements=32, payload_registers=8> : encoding<schema>
  %acc_schema = encoding.define #encoding.operand<element_format=u32, payload_elements=8, payload_registers=8> : encoding<schema>
  %layout = encoding.define #encoding.storage<layout=#encoding.layout.dense, schema=#encoding.operand<element_format=u32, payload_elements=8, payload_registers=8>> : encoding<storage>
  %view = buffer.view %allocation[%tile_offset] : buffer -> view<16x16xi32, %layout>
  %output_view = buffer.view %aligned[%base] : buffer -> view<64xi32>
  %a_values = vector.splati -3 : vector<1xi8>
  %b_values = vector.splati 3 : vector<1xi8>
  %c_values = vector.splati 7 : vector<1xi32>
  %lhs = vector.fragment<lhs> %a_values shape [%m, %k] using {schema = %input_schema : encoding<schema>} : vector<1xi8>
  %rhs = vector.fragment<rhs> %b_values shape [%k, %m] using {schema = %input_schema : encoding<schema>} : vector<1xi8>
  %init = vector.fragment<init> %c_values shape [%m, %m] using {schema = %acc_schema : encoding<schema>} : vector<1xi32>
  %result = vector.mma %lhs, %rhs, %init : vector<1xi8>, vector<1xi8>, vector<1xi32>
  vector.fragment.store<result> %result, %view[0, 0] shape [%m, %m] : vector<1xi32>, view<16x16xi32, %layout>
  kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
  %loaded = vector.fragment.load<init> %view[0, 0] shape [%m, %m] : view<16x16xi32, %layout> -> vector<1xi32>
  %accumulated = vector.mma %lhs, %rhs, %loaded : vector<1xi8>, vector<1xi8>, vector<1xi32>
  vector.fragment.store<result> %accumulated, %view[0, 0] shape [%m, %m] : vector<1xi32>, view<16x16xi32, %layout>
  kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
  %integer_view = buffer.view %allocation[%tile_offset] : buffer -> view<16x16xi32>
  %bits = view.load %integer_view[0, 0] : view<16x16xi32> -> i32
  %thread = kernel.workitem.id<x> : index
  view.store %bits, %output_view[%thread] : i32, view<64xi32>
  kernel.return
}

// ----
low.kernel.def target<spirv.logical.core> abi_layout({signature = (buffer) -> ()}) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @unsigned_integer_storage() asm {
  %aligned = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %allocation = storage {byte_alignment = 16, byte_length = 2048} : low.storage<workgroup>
  %tile_bytes = OpConstant.offset64 1024
  %subgroup = OpLoadBuiltin.subgroup_id
  %36 = OpSConvert.i32.offset64 %subgroup
  %tile_offset = OpIMul.offset64 %36, %tile_bytes
  %view = storage_address %allocation : low.storage<workgroup> -> reg<spirv.ptr.workgroup.array.i32>
  %39 = OpConstant.i8 -3 : reg<spirv.id>
  %40 = OpBitcast.i8.u8 %39
  %lhs = OpCompositeConstruct.cooperative.u8.16x32.lhs %40 : reg<spirv.id : spirv.cooperative_matrix<16x32xu8, subgroup, matrix_a>>
  %42 = OpConstant.i8 3 : reg<spirv.id>
  %43 = OpBitcast.i8.u8 %42
  %rhs = OpCompositeConstruct.cooperative.u8.32x16.rhs %43 : reg<spirv.id : spirv.cooperative_matrix<32x16xu8, subgroup, matrix_b>>
  %45 = OpConstant.i32 7 : reg<spirv.id>
  %46 = OpBitcast.i32.u32 %45
  %init = OpCompositeConstruct.cooperative.u32.16x16.accumulator %46 : reg<spirv.id : spirv.cooperative_matrix<16x16xu32, subgroup, matrix_accumulator>>
  %result = OpCooperativeMatrixMulAddKHR.u8.16x16x32.u32.subgroup %lhs, %rhs, %init : reg<spirv.id : spirv.cooperative_matrix<16x16xu32, subgroup, matrix_accumulator>>
  %49 = OpConstant.offset64 16
  %50 = OpUConvert.offset64.u32 %49
  %51 = OpAccessChain.workgroup.i32.byte_offset %view, %tile_offset
  OpCooperativeMatrixStoreKHR.result.u32.16x16.subgroup.workgroup.i32 %51, %result, %50, 0
  OpControlBarrier.subgroup.workgroup.acq_rel
  %52 = OpConstant.offset64 16
  %53 = OpUConvert.offset64.u32 %52
  %54 = OpAccessChain.workgroup.i32.byte_offset %view, %tile_offset
  %loaded = OpCooperativeMatrixLoadKHR.init.u32.16x16.subgroup.workgroup.i32 %54, %53, 0 : reg<spirv.id : spirv.cooperative_matrix<16x16xu32, subgroup, matrix_accumulator>>
  %accumulated = OpCooperativeMatrixMulAddKHR.u8.16x16x32.u32.subgroup %lhs, %rhs, %loaded : reg<spirv.id : spirv.cooperative_matrix<16x16xu32, subgroup, matrix_accumulator>>
  %57 = OpConstant.offset64 16
  %58 = OpUConvert.offset64.u32 %57
  %59 = OpAccessChain.workgroup.i32.byte_offset %view, %tile_offset
  OpCooperativeMatrixStoreKHR.result.u32.16x16.subgroup.workgroup.i32 %59, %accumulated, %58, 0
  OpControlBarrier.subgroup.workgroup.acq_rel
  %integer_view = storage_address %allocation : low.storage<workgroup> -> reg<spirv.ptr.workgroup.array.i32>
  %61 = OpConstant.i32 8 : reg<spirv.id : index>
  %62 = OpShiftLeftLogical %subgroup, %61 : reg<spirv.id : index>
  %63 = OpAccessChain.workgroup.i32.element_index %integer_view, %62
  %bits = OpLoad.workgroup.i32 %63
  %thread = OpLoadBuiltin.local_invocation_id.x
  %66 = OpSConvert.i32.offset64 %thread
  %67 = OpConstant.offset64 4
  %68 = OpIMul.offset64 %66, %67
  %69 = OpPtrAccessChain.storage_buffer.i32.byte_offset %aligned, %68
  OpStore.storage_buffer.i32 %69, %bits
  return
}

// ====

// RUN: emit spirv-low target=spirv:vulkan1.3+bda+hal features=COOPERATIVE_MATRIX_KHR

kernel.def @cooperative_matrix_rejects_unproven_uniform_address() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %byte_offset: offset) {
  %base = index.constant 0 : offset
  %tile = index.constant 16 : index
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 16} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 16} : buffer
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<16x16xf32>
  %lane = kernel.workitem.id<x> : index
  %stride = index.constant 16 : offset
  %varying_offset = index.scale %lane, %stride : index, offset -> offset
  %input_view = buffer.view %input_aligned[%varying_offset] : buffer -> view<32x16xf32>
  // ERROR@+1: TARGET/003 {subject_role="source-memory", subject_name="access", constraint_key="source_memory.subgroup_uniform"}
  %fragment = vector.fragment.load<init> %input_view[0, 0] shape [%tile, %tile] : view<32x16xf32> -> vector<8xf32>
  vector.fragment.store<result> %fragment, %output_view[0, 0] shape [%tile, %tile] : vector<8xf32>, view<16x16xf32>
  kernel.return
}

// ====

// RUN: emit spirv-low target=spirv:vulkan1.3+bda+hal features=COOPERATIVE_MATRIX_KHR

kernel.def @cooperative_matrix_rejects_gapped_storage_layout() {
  %unit = index.constant 1 : index
  %width = target.subgroup.size : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %byte_offset: offset) {
  %base = index.constant 0 : offset
  %tile = index.constant 16 : index
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 16} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 16} : buffer
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<16x16xf32>
  %byte_offset_aligned = index.assume %byte_offset [multiple_of(%byte_offset, 16)] : offset
  %layout = encoding.layout.strided [32, 2] : encoding<layout>
  %input_view = buffer.view %input_aligned[%byte_offset_aligned] : buffer -> view<16x16xf32, %layout>
  // ERROR@+1: TARGET/003 {subject_role="source-memory", subject_name="access", constraint_key="source_memory.address_layout"}
  %fragment = vector.fragment.load<init> %input_view[0, 0] shape [%tile, %tile] : view<16x16xf32, %layout> -> vector<8xf32>
  vector.fragment.store<result> %fragment, %output_view[0, 0] shape [%tile, %tile] : vector<8xf32>, view<16x16xf32>
  kernel.return
}
