// RUN: emit spirv-low target=spirv:vulkan1.3+bda+hal features=BFLOAT16_TYPE_KHR,BFLOAT16_COOPERATIVE_MATRIX_KHR,COOPERATIVE_MATRIX_KHR

kernel.def @bf16_uniform_8_schema() {
  %unit = index.constant 1 : index
  %width = target.subgroup.size : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%output: buffer, %a: bf16, %b: bf16, %c: f32) {
  %base = index.constant 0 : offset
  %m = index.constant 16 : index
  %k = index.constant 16 : index
  %unit = index.constant 1 : index
  %aligned = buffer.assume.alignment %output {minimum_alignment = 16} : buffer
  %input_schema = encoding.define #encoding.operand<element_format=bf16, payload_elements=32, payload_registers=8> : encoding<schema>
  %acc_schema = encoding.define #encoding.operand<element_format=f32, payload_elements=8, payload_registers=8> : encoding<schema>
  %output_storage = encoding.define #encoding.storage<layout=#encoding.layout.dense, schema=#encoding.operand<element_format=f32, payload_elements=8, payload_registers=8>> : encoding<storage>
  %view = buffer.view %aligned[%base] : buffer -> view<16x16xf32, %output_storage>
  %a_values = vector.splat %a : vector<8xbf16>
  %b_values = vector.splat %b : vector<8xbf16>
  %c_values = vector.splat %c : vector<8xf32>
  %lhs = vector.fragment<lhs> %a_values shape [blocks(%unit), %m, %k] using {schema = %input_schema : encoding<schema>} : vector<8xbf16>
  %rhs = vector.fragment<rhs> %b_values shape [blocks(%unit), %k, %m] using {schema = %input_schema : encoding<schema>} : vector<8xbf16>
  %init = vector.fragment<init> %c_values shape [blocks(%unit), %m, %m] using {schema = %acc_schema : encoding<schema>} : vector<8xf32>
  %result = vector.mma %lhs, %rhs, %init : vector<8xbf16>, vector<8xbf16>, vector<8xf32>
  vector.fragment.store<result> %result, %view[0, 0] shape [%m, %m] : vector<8xf32>, view<16x16xf32, %output_storage>
  kernel.return
}

