// RUN: emit spirv-low target=spirv:vulkan1.3+bda+hal features=FLOAT16,COOPERATIVE_MATRIX_KHR

kernel.def @f16_constant_1_plain() {
  %unit = index.constant 1 : index
  %width = target.subgroup.size : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%output: buffer) {
  %base = index.constant 0 : offset
  %m = index.constant 16 : index
  %k = index.constant 16 : index
  %unit = index.constant 1 : index
  %aligned = buffer.assume.alignment %output {minimum_alignment = 16} : buffer
  %view = buffer.view %aligned[%base] : buffer -> view<16x16xf32>
  %a_values = vector.splatf -2.0 : vector<1xf16>
  %b_values = vector.splatf 3.0 : vector<1xf16>
  %c_values = vector.splatf 7.0 : vector<1xf32>
  %lhs = vector.fragment<lhs> %a_values shape [blocks(%unit), %m, %k] : vector<1xf16>
  %rhs = vector.fragment<rhs> %b_values shape [blocks(%unit), %k, %m] : vector<1xf16>
  %init = vector.fragment<init> %c_values shape [blocks(%unit), %m, %m] : vector<1xf32>
  %result = vector.mma %lhs, %rhs, %init : vector<1xf16>, vector<1xf16>, vector<1xf32>
  vector.fragment.store<result> %result, %view[0, 0] shape [%m, %m] : vector<1xf32>, view<16x16xf32>
  kernel.return
}

// ----
low.kernel.def target<spirv.logical.core> abi_layout({signature = (buffer) -> ()}) workgroup_count(1, 1, 1) @f16_constant_1_plain() asm {
  %aligned = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %17 = OpConstant.f16 49152 : reg<spirv.id>
  %lhs = OpCompositeConstruct.cooperative.f16.16x16.lhs %17 : reg<spirv.id : spirv.cooperative_matrix<16x16xf16, subgroup, matrix_a>>
  %19 = OpConstant.f16 16896 : reg<spirv.id>
  %rhs = OpCompositeConstruct.cooperative.f16.16x16.rhs %19 : reg<spirv.id : spirv.cooperative_matrix<16x16xf16, subgroup, matrix_b>>
  %21 = OpConstant.f32 1088421888 : reg<spirv.id>
  %init = OpCompositeConstruct.cooperative.f32.16x16.accumulator %21 : reg<spirv.id : spirv.cooperative_matrix<16x16xf32, subgroup, matrix_accumulator>>
  %result = OpCooperativeMatrixMulAddKHR.f16.16x16x16.f32.subgroup %lhs, %rhs, %init : reg<spirv.id : spirv.cooperative_matrix<16x16xf32, subgroup, matrix_accumulator>>
  %24 = OpConstant.offset64 16
  %25 = OpUConvert.offset64.u32 %24
  %26 = OpConstant.offset64 0
  %27 = OpPtrAccessChain.storage_buffer.f32.byte_offset %aligned, %26
  OpCooperativeMatrixStoreKHR.result.f32.16x16.subgroup.storage_buffer %27, %result, %25, 0
  return
}

