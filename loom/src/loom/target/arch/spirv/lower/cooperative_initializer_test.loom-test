low.kernel.def target<spirv.logical.core> abi_layout({signature = (buffer, bf16, bf16, f32) -> ()}) workgroup_count(1, 1, 1) @bf16_uniform_8_schema(%a: reg<spirv.id : bf16>, %b: reg<spirv.id : bf16>, %c: reg<spirv.id : f32>) asm {
  %aligned = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %lhs = OpCompositeConstruct.cooperative.bf16.16x16.lhs %a : reg<spirv.id : spirv.cooperative_matrix<16x16xbf16, subgroup, matrix_a>>
  %rhs = OpCompositeConstruct.cooperative.bf16.16x16.rhs %b : reg<spirv.id : spirv.cooperative_matrix<16x16xbf16, subgroup, matrix_b>>
  %init = OpCompositeConstruct.cooperative.f32.16x16.accumulator %c : reg<spirv.id : spirv.cooperative_matrix<16x16xf32, subgroup, matrix_accumulator>>
  %result = OpCooperativeMatrixMulAddKHR.bf16.16x16x16.f32.subgroup %lhs, %rhs, %init : reg<spirv.id : spirv.cooperative_matrix<16x16xf32, subgroup, matrix_accumulator>>
  %30 = OpConstant.offset64 16
  %31 = OpUConvert.offset64.u32 %30
  %32 = OpConstant.offset64 0
  %33 = OpPtrAccessChain.storage_buffer.f32.byte_offset %aligned, %32
  OpCooperativeMatrixStoreKHR.result.f32.16x16.subgroup.storage_buffer %33, %result, %31, 0
  return
}

