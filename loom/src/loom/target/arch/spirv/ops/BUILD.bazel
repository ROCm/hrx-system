load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_instance_library", "loom_cc_library", "loom_cc_library_group", "loom_generated_cc_library")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_SPIRV_ROOT_VISIBILITY = ["//loom/src/loom/target/arch/spirv:__pkg__"]

_SPIRV_LOWER_VISIBILITY = ["//loom/src/loom/target/arch/spirv/lower:__pkg__"]

_SPIRV_TOOLING_VISIBILITY = [
    "//loom/src/loom/tooling/target/spirv:__pkg__",
]

loom_cc_library(
    name = "op_defs",
    hdrs = ["ops.h"],
    textual_hdrs = ["ops.inc"],
    visibility = ["//visibility:public"],
    deps = [
        "//loom/src/loom/ops:headers",
        "//loom/src/loom/target:types",
        "//loom/src/loom/target/arch/spirv/records:record_defs",
    ],
)

loom_cc_library_group(
    name = "builders",
    visibility = ["//visibility:public"],
    deps = [
        ":op_builders",
        ":op_defs",
        ":type_builders",
    ],
)

loom_cc_instance_library(
    name = "op_builders",
    srcs = ["builders.c"],
    visibility = ["//visibility:private"],
    deps = [
        ":op_defs",
        "//loom/src/loom/ir:builders",
        "//loom/src/loom/ops:builders",
    ],
)

loom_generated_cc_library(
    name = "ops",
    srcs = [
        "fact_projection.c",
        "registry.c",
        "target.c",
    ],
    hdrs = [
        "ops.h",
        "registry.h",
        "target.h",
        "types.h",
    ],
    args = ["--dialect=spirv"],
    extra_output_flags = [
        "--ops-include",
        "--type-builders",
        "--builders",
    ],
    extra_outputs = [
        "ops.inc",
        "type_builders.c",
        "builders.c",
    ],
    generated_src_flags = [
        "--tables",
        "--types",
    ],
    generated_srcs = [
        "tables.c",
        "types.c",
    ],
    generator = "//loom/py/loom/gen/ops:c_tables_spirv_generator",
    textual_hdrs = ["ops.inc"],
    visibility = _SPIRV_ROOT_VISIBILITY + _SPIRV_LOWER_VISIBILITY + _SPIRV_TOOLING_VISIBILITY,
    deps = [
        ":builders",
        ":type_builders",
        "//loom/src/loom/error:error_defs",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/ops:type_registry",
        "//loom/src/loom/ops/target",
        "//loom/src/loom/target:resolved_target",
        "//loom/src/loom/target:types",
        "//loom/src/loom/target/arch/spirv:facts",
        "//loom/src/loom/target/arch/spirv:isa",
        "//loom/src/loom/target/arch/spirv:scalar_types",
        "//loom/src/loom/target/arch/spirv/records:target_records",
        "//runtime/src/iree/base",
    ],
)

# Native value typing consumes the same construction API without the target's
# semantic providers. Other compiler consumers retain the combined ops rule.
loom_cc_instance_library(
    name = "type_builders",
    srcs = ["type_builders.c"],
    hdrs = ["type_builders.h"],
    visibility = _SPIRV_ROOT_VISIBILITY,
    deps = [
        "//loom/src/loom/ir:builders",
        "//loom/src/loom/target/arch/spirv:isa",
        "//loom/src/loom/target/arch/spirv:vocabulary",
        "//runtime/src/iree/base",
    ],
)
