// RUN: pass target=spirv:vulkan1.3+bda+subgroup32+reductions+hal target-legalize{mode=eager},canonicalize,dce

// Narrow payloads share one addressing calculation while keeping four bytes
// per exchanged word. The final byte is padded from the captured value.
kernel.def @packed_byte_shuffle_validity() {
  %unit = index.constant 1 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%values: vector<17xi8>, %source_lane: i32, %width: i32) {
  %result, %valid = kernel.subgroup.shuffle<index> %values, %source_lane, %width : vector<17xi8>, i32, i32
  test.use %result, %valid : vector<17xi8>, i1
  kernel.return
}

