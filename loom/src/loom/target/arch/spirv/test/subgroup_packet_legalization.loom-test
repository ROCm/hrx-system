// RUN: pass target=spirv:vulkan1.3+bda+subgroup32+reductions+hal target-legalize{mode=eager},canonicalize,dce

// Software bfloat transport likewise packs object bits after normalizing the
// logical source lane; numerical conversion would destroy NaN payloads.
kernel.def @packed_bfloat_shuffle_validity() {
  %unit = index.constant 1 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%values: vector<13xbf16>, %source_lane: i32, %width: i32) {
  %result, %valid = kernel.subgroup.shuffle<index> %values, %source_lane, %width : vector<13xbf16>, i32, i32
  test.use %result, %valid : vector<13xbf16>, i1
  kernel.return
}

