// RUN: with-checks emit source-low output=pipeline control-flow=structured-low

func.def @structured_pipeline_probe(%value: i32) -> (i32) {
  func.return %value : i32
}

// ----
CHECK: select-templates(mode = "final", rewrite = "inline")
CHECK: specialize-target-callgraph
CHECK: target-legalize(mode = "complete")
CHECK: source-to-low(control-flow = "structured-low")
CHECK: low-decompose-cfg-tuples
CHECK-NOT: scf-to-cfg
CHECK-NOT: cfg-simplify

// ====
// RUN: pass source-to-low{control-flow=structured-low}

spirv.target<vulkan1_3> @target

func.def target(@target) @rejects_unsupported_structured_region_op(%selector: index, %a: i32, %b: i32) -> (i32) {
  // ERROR@+1: TARGET/030 {op_name="scf.switch", region_count="2"}
  %result = scf.switch %selector -> (i32) {
    case 0 {
      scf.yield %a : i32
    }
    default {
      scf.yield %b : i32
    }
  }
  func.return %result : i32
}
