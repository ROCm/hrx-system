// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_index_conversion.loom-test
// RUN: emit source-low output=low control-flow=structured-low

spirv.target<vulkan1_3> @target {contract_feature_bits = 37374}

func.def target(@target) @index_constants() -> (index, index, offset) {
  %minimum = index.constant -2147483648 : index
  %maximum = index.constant 2147483647 : index
  %byte_limit = index.constant 9223372036854775807 : offset
  func.return %minimum, %maximum, %byte_limit : index, index, offset
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @index_constants() -> (reg<spirv.id : index>, reg<spirv.id : index>, reg<spirv.offset64>) asm {
  %minimum = OpConstant.i32 -2147483648 : reg<spirv.id : index>
  %maximum = OpConstant.i32 2147483647 : reg<spirv.id : index>
  %byte_limit = OpConstant.offset64 9223372036854775807
  return %minimum, %maximum, %byte_limit
}

// ====

spirv.target<vulkan1_3> @target {contract_feature_bits = 37374}

func.def target(@target) @index_assume_ordinals(%coordinate0: index, %byte_offset0: offset) -> (index, offset) {
  %coordinate, %byte_offset = index.assume %coordinate0, %byte_offset0 [range(%coordinate0, 0, 1024), range(%byte_offset0, 0, 4096)] : index, offset
  func.return %coordinate, %byte_offset : index, offset
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @index_assume_ordinals(%coordinate: reg<spirv.id : index>, %byte_offset: reg<spirv.offset64>) -> (reg<spirv.id : index>, reg<spirv.offset64>) asm {
  return %coordinate, %byte_offset
}

// ====

spirv.target<vulkan1_3> @target {contract_feature_bits = 37374}

func.def target(@target) @boolean_address_cast_family(%flag: i1, %coordinate: index, %byte_offset: offset) -> (index, offset, i1, i1) {
  %flag_index = index.cast %flag : i1 to index
  %flag_offset = index.cast %flag : i1 to offset
  %index_low_bit = index.cast %coordinate : index to i1
  %offset_low_bit = index.cast %byte_offset : offset to i1
  func.return %flag_index, %flag_offset, %index_low_bit, %offset_low_bit : index, offset, i1, i1
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @boolean_address_cast_family(%flag: reg<spirv.id : i1>, %coordinate: reg<spirv.id : index>, %byte_offset: reg<spirv.offset64>) -> (reg<spirv.id : index>, reg<spirv.offset64>, reg<spirv.id : i1>, reg<spirv.id : i1>) asm {
  %18 = OpConstant.i32 1 : reg<spirv.id : index>
  %19 = OpConstant.i32 0 : reg<spirv.id : index>
  %flag_index = OpSelect %flag, %18, %19 : reg<spirv.id : index>
  %21 = OpConstant.offset64 1
  %22 = OpConstant.offset64 0
  %flag_offset = OpSelect.offset64 %flag, %21, %22
  %25 = OpBitwiseAnd %coordinate, %18
  %index_low_bit = OpINotEqual %25, %19
  %28 = OpUConvert.offset64.u32 %byte_offset
  %29 = OpBitcast.u32.i32 %28
  %31 = OpBitwiseAnd %29, %18
  %offset_low_bit = OpINotEqual %31, %19
  return %flag_index, %flag_offset, %index_low_bit, %offset_low_bit
}

// ====

spirv.target<vulkan1_3> @target {contract_feature_bits = 37374}

func.def target(@target) @index_payload_cast_family(%i8: i8, %i16: i16, %i32: i32, %i64_raw: i64, %coordinate: index) -> (index, index, index, index, i8, i16, i32, i64) {
  %i64 = scalar.assume %i64_raw [range(%i64_raw, -2147483648, 2147483647)] : i64
  %from_i8 = index.cast %i8 : i8 to index
  %from_i16 = index.cast %i16 : i16 to index
  %from_i32 = index.cast %i32 : i32 to index
  %from_i64 = index.cast %i64 : i64 to index
  %to_i8 = index.cast %coordinate : index to i8
  %to_i16 = index.cast %coordinate : index to i16
  %to_i32 = index.cast %coordinate : index to i32
  %to_i64 = index.cast %coordinate : index to i64
  func.return %from_i8, %from_i16, %from_i32, %from_i64, %to_i8, %to_i16, %to_i32, %to_i64 : index, index, index, index, i8, i16, i32, i64
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @index_payload_cast_family(%i8: reg<spirv.id : i8>, %i16: reg<spirv.id : i16>, %i32: reg<spirv.id : i32>, %i64: reg<spirv.id : i64>, %coordinate: reg<spirv.id : index>) -> (reg<spirv.id : index>, reg<spirv.id : index>, reg<spirv.id : index>, reg<spirv.id : index>, reg<spirv.id : i8>, reg<spirv.id : i16>, reg<spirv.id : i32>, reg<spirv.id : i64>) asm {
  %from_i8 = OpSConvert.i8.i32 %i8 : reg<spirv.id : index>
  %from_i16 = OpSConvert.i16.i32 %i16 : reg<spirv.id : index>
  %from_i32 = OpCopyObject.i32 %i32 : reg<spirv.id : index>
  %from_i64 = OpSConvert.i64.i32 %i64 : reg<spirv.id : index>
  %to_i8 = OpSConvert.i32.i8 %coordinate
  %to_i16 = OpSConvert.i32.i16 %coordinate
  %to_i32 = OpCopyObject.i32 %coordinate
  %to_i64 = OpSConvert.i32.i64 %coordinate
  return %from_i8, %from_i16, %from_i32, %from_i64, %to_i8, %to_i16, %to_i32, %to_i64
}

// ====

spirv.target<vulkan1_3> @target {contract_feature_bits = 37374}

func.def target(@target) @offset_payload_cast_family(%i8: i8, %i16: i16, %i32: i32, %i64_raw: i64, %byte_offset: offset) -> (offset, offset, offset, offset, i8, i16, i32, i64) {
  %i64 = scalar.assume %i64_raw [range(%i64_raw, 0, 9223372036854775807)] : i64
  %from_i8 = index.cast %i8 : i8 to offset
  %from_i16 = index.cast %i16 : i16 to offset
  %from_i32 = index.cast %i32 : i32 to offset
  %from_i64 = index.cast %i64 : i64 to offset
  %to_i8 = index.cast %byte_offset : offset to i8
  %to_i16 = index.cast %byte_offset : offset to i16
  %to_i32 = index.cast %byte_offset : offset to i32
  %to_i64 = index.cast %byte_offset : offset to i64
  func.return %from_i8, %from_i16, %from_i32, %from_i64, %to_i8, %to_i16, %to_i32, %to_i64 : offset, offset, offset, offset, i8, i16, i32, i64
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @offset_payload_cast_family(%i8: reg<spirv.id : i8>, %i16: reg<spirv.id : i16>, %i32: reg<spirv.id : i32>, %i64: reg<spirv.id : i64>, %byte_offset: reg<spirv.offset64>) -> (reg<spirv.offset64>, reg<spirv.offset64>, reg<spirv.offset64>, reg<spirv.offset64>, reg<spirv.id : i8>, reg<spirv.id : i16>, reg<spirv.id : i32>, reg<spirv.id : i64>) asm {
  %35 = OpBitcast.i8.u8 %i8
  %from_i8 = OpUConvert.u8.offset64 %35
  %37 = OpBitcast.i16.u16 %i16
  %from_i16 = OpUConvert.u16.offset64 %37
  %39 = OpBitcast.i32.u32 %i32
  %from_i32 = OpUConvert.u32.offset64 %39
  %from_i64 = OpBitcast.i64.offset64 %i64
  %42 = OpUConvert.offset64.u8 %byte_offset
  %to_i8 = OpBitcast.u8.i8 %42
  %44 = OpUConvert.offset64.u16 %byte_offset
  %to_i16 = OpBitcast.u16.i16 %44
  %46 = OpUConvert.offset64.u32 %byte_offset
  %to_i32 = OpBitcast.u32.i32 %46
  %to_i64 = OpBitcast.offset64.i64 %byte_offset
  return %from_i8, %from_i16, %from_i32, %from_i64, %to_i8, %to_i16, %to_i32, %to_i64
}

// ====

spirv.target<vulkan1_3> @target {contract_feature_bits = 37374}

func.def target(@target) @address_domain_cast_family(%coordinate0: index, %byte_offset0: offset) -> (offset, index) {
  %coordinate, %byte_offset = index.assume %coordinate0, %byte_offset0 [range(%coordinate0, 0, 2147483647), range(%byte_offset0, 0, 2147483647)] : index, offset
  %as_offset = index.cast %coordinate : index to offset
  %as_index = index.cast %byte_offset : offset to index
  func.return %as_offset, %as_index : offset, index
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @address_domain_cast_family(%coordinate: reg<spirv.id : index>, %byte_offset: reg<spirv.offset64>) -> (reg<spirv.offset64>, reg<spirv.id : index>) asm {
  %12 = OpBitcast.i32.u32 %coordinate
  %as_offset = OpUConvert.u32.offset64 %12
  %14 = OpUConvert.offset64.u32 %byte_offset
  %as_index = OpBitcast.u32.i32 %14 : reg<spirv.id : index>
  return %as_offset, %as_index
}
