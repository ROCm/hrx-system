// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_constant_remainder.loom-test
// RUN: emit source-low output=low control-flow=structured-low

spirv.target<vulkan1_3> @target

func.def target(@target) @constant_remainder_uniform(%value: i32) -> (i32) {
  %divisor = scalar.constant 3 : i32
  %remainder = scalar.remui %value, %divisor : i32
  func.return %remainder : i32
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @constant_remainder_uniform(%value: reg<spirv.id : i32>) -> (reg<spirv.id : i32>) asm {
  %divisor = OpConstant.i32 3
  %7 = OpBitcast.i32.u32 %value
  %8 = OpBitcast.i32.u32 %divisor
  %9 = OpUMod.u32 %7, %8
  %remainder = OpBitcast.u32.i32 %9
  return %remainder
}

// ====

spirv.target<vulkan1_3> @target

func.def target(@target) @constant_remainder_loaded(%input: buffer) -> (i32, index) {
  %base = index.constant 0 : offset
  %aligned_input = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %input_view = buffer.view %aligned_input[%base] : buffer -> view<1xi32>
  %value = view.load %input_view[0] : view<1xi32> -> i32
  %divisor = scalar.constant 3 : i32
  %remainder = scalar.remui %value, %divisor : i32
  %mask = scalar.constant 2147483647 : i32
  %nonnegative = scalar.andi %value, %mask : i32
  %position = index.cast %nonnegative : i32 to index
  %index_divisor = index.constant 3 : index
  %index_remainder = index.rem %position, %index_divisor : index
  func.return %remainder, %index_remainder : i32, index
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @constant_remainder_loaded(%aligned_input: reg<spirv.ptr.storage_buffer>) -> (reg<spirv.id : i32>, reg<spirv.id : index>) asm {
  %17 = OpConstant.offset64 0
  %18 = OpPtrAccessChain.storage_buffer.i32.byte_offset %aligned_input, %17
  %value = OpLoad.storage_buffer.i32 %18
  %divisor = OpConstant.i32 3
  %21 = OpBitcast.i32.u32 %value
  %22 = OpBitcast.i32.u32 %divisor
  %23 = OpUMod.u32 %21, %22
  %remainder = OpBitcast.u32.i32 %23
  %mask = OpConstant.i32 2147483647
  %nonnegative = OpBitwiseAnd %value, %mask
  %position = OpCopyObject.i32 %nonnegative : reg<spirv.id : index>
  %index_divisor = OpConstant.i32 3 : reg<spirv.id : index>
  %29 = OpBitcast.i32.u32 %position
  %30 = OpBitcast.i32.u32 %index_divisor
  %31 = OpUMod.u32 %29, %30
  %index_remainder = OpBitcast.u32.i32 %31 : reg<spirv.id : index>
  return %remainder, %index_remainder
}

// ====

spirv.target<vulkan1_3> @target

func.def target(@target) @constant_remainder_factors(%word: i32, %position: index) -> (i32, i32, index, index) {
  %bounded = index.assume %position [range(%position, 0, 4294967295)] : index
  %c5 = scalar.constant 5 : i32
  %c9 = scalar.constant 9 : i32
  %c5_index = index.constant 5 : index
  %c9_index = index.constant 9 : index
  %word_five = scalar.remui %word, %c5 : i32
  %word_nine = scalar.remui %word, %c9 : i32
  %position_five = index.rem %bounded, %c5_index : index
  %position_nine = index.rem %bounded, %c9_index : index
  func.return %word_five, %word_nine, %position_five, %position_nine : i32, i32, index, index
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @constant_remainder_factors(%word: reg<spirv.id : i32>, %bounded: reg<spirv.id : index>) -> (reg<spirv.id : i32>, reg<spirv.id : i32>, reg<spirv.id : index>, reg<spirv.id : index>) asm {
  %c5 = OpConstant.i32 5
  %c9 = OpConstant.i32 9
  %c5_index = OpConstant.i32 5 : reg<spirv.id : index>
  %c9_index = OpConstant.i32 9 : reg<spirv.id : index>
  %25 = OpBitcast.i32.u32 %word
  %26 = OpBitcast.i32.u32 %c5
  %27 = OpUMod.u32 %25, %26
  %word_five = OpBitcast.u32.i32 %27
  %30 = OpBitcast.i32.u32 %c9
  %31 = OpUMod.u32 %25, %30
  %word_nine = OpBitcast.u32.i32 %31
  %33 = OpBitcast.i32.u32 %bounded
  %34 = OpBitcast.i32.u32 %c5_index
  %35 = OpUMod.u32 %33, %34
  %position_five = OpBitcast.u32.i32 %35 : reg<spirv.id : index>
  %38 = OpBitcast.i32.u32 %c9_index
  %39 = OpUMod.u32 %33, %38
  %position_nine = OpBitcast.u32.i32 %39 : reg<spirv.id : index>
  return %word_five, %word_nine, %position_five, %position_nine
}

// ====

spirv.target<vulkan1_3> @target

func.def target(@target) @constant_remainder_by_seven(%word: i32, %position: index) -> (i32, index, i32, index) {
  %bounded = index.assume %position [range(%position, 0, 4294967295)] : index
  %word_divisor = scalar.constant 7 : i32
  %index_divisor = index.constant 7 : index
  %word_remainder = scalar.remui %word, %word_divisor : i32
  %index_remainder = index.rem %bounded, %index_divisor : index
  func.return %word_remainder, %index_remainder, %word, %bounded : i32, index, i32, index
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @constant_remainder_by_seven(%word: reg<spirv.id : i32>, %bounded: reg<spirv.id : index>) -> (reg<spirv.id : i32>, reg<spirv.id : index>, reg<spirv.id : i32>, reg<spirv.id : index>) asm {
  %word_divisor = OpConstant.i32 7
  %index_divisor = OpConstant.i32 7 : reg<spirv.id : index>
  %19 = OpBitcast.i32.u32 %word
  %20 = OpBitcast.i32.u32 %word_divisor
  %21 = OpUMod.u32 %19, %20
  %word_remainder = OpBitcast.u32.i32 %21
  %23 = OpBitcast.i32.u32 %bounded
  %24 = OpBitcast.i32.u32 %index_divisor
  %25 = OpUMod.u32 %23, %24
  %index_remainder = OpBitcast.u32.i32 %25 : reg<spirv.id : index>
  return %word_remainder, %index_remainder, %word, %bounded
}
