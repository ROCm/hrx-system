// TEMPLATE: loom/src/loom/test/corpus/source_low/memory_wide_offsets.loom-test
// RUN: emit source-low target=spirv:vulkan1.3+bda+extended-types output=low control-flow=structured-low

kernel.def @wide_offset_unsigned_index() {
  %unit = index.constant 1 : index
  %lane_count = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%lane_count, %unit, %unit) : index
} launch(%input_storage: buffer, %output_storage: buffer, %base: i32) {
  %input = buffer.assume.alignment %input_storage {minimum_alignment = 4} : buffer
  %output = buffer.assume.alignment %output_storage {minimum_alignment = 4} : buffer
  %lane = kernel.workitem.id<x> : index
  %lane_bits = index.cast %lane : index to i32
  %wrapped = scalar.addi %base, %lane_bits : i32
  %unsigned = index.cast %wrapped : i32 to offset
  // ERROR@+1: SPIRV/026 {constraint_key="index_cast.s32_exact"}
  %element = index.cast %unsigned : offset to index
  %stride = index.constant 4 : offset
  // ERROR@+1: SPIRV/027 {constraint_key="spirv.index.scale_coordinate.non_negative_s32"}
  %input_offset = index.scale %element, %stride : index, offset -> offset
  %input_view = buffer.view %input[%input_offset] : buffer -> view<1xi32>
  %loaded = view.load %input_view[0] : view<1xi32> -> i32
  %output_offset = index.scale %lane, %stride : index, offset -> offset
  %output_view = buffer.view %output[%output_offset] : buffer -> view<1xi32>
  view.store %loaded, %output_view[0] : i32, view<1xi32>
  kernel.return
}

// ====

kernel.def @wide_offset_uniform() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input_storage: buffer, %output_storage: buffer, %byte_offset_input: offset) {
  %byte_offset = index.assume %byte_offset_input [mul(%byte_offset_input, 4)] : offset
  %input = buffer.assume.alignment %input_storage {minimum_alignment = 4} : buffer
  %output = buffer.assume.alignment %output_storage {minimum_alignment = 4} : buffer
  %buffer_base = index.constant 0 : offset
  %input_view = buffer.view %input[%byte_offset] : buffer -> view<1xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<1xi32>
  %loaded = view.load %input_view[0] : view<1xi32> -> i32
  view.store %loaded, %output_view[0] : i32, view<1xi32>
  kernel.return
}

// ----
low.kernel.def target<spirv.logical.core> workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @wide_offset_uniform(%byte_offset: reg<spirv.offset64>) asm {
  %input = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %output = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %14 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input, %byte_offset
  %loaded = OpLoad.storage_buffer.i32 %14
  %16 = OpConstant.offset64 0
  %17 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output, %16
  OpStore.storage_buffer.i32 %17, %loaded
  return
}

// ====

kernel.def @wide_offset_loaded_lane() {
  %unit = index.constant 1 : index
  %lanes = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%lanes, %unit, %unit) : index
} launch(%input_storage: buffer, %output_storage: buffer, %offsets_storage: buffer) {
  %input = buffer.assume.alignment %input_storage {minimum_alignment = 4} : buffer
  %output = buffer.assume.alignment %output_storage {minimum_alignment = 4} : buffer
  %offsets = buffer.assume.alignment %offsets_storage {minimum_alignment = 8} : buffer
  %lane = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %offset_view = buffer.view %offsets[%buffer_base] : buffer -> view<64xi64>
  %raw_bits = view.load %offset_view[%lane] : view<64xi64> -> i64
  %offset_mask = scalar.constant 9223372036854775804 : i64
  %raw = scalar.andi %raw_bits, %offset_mask : i64
  %byte_offset = index.cast %raw : i64 to offset
  %input_view = buffer.view %input[%byte_offset] : buffer -> view<1xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<64xi32>
  %loaded = view.load %input_view[0] : view<1xi32> -> i32
  view.store %loaded, %output_view[%lane] : i32, view<64xi32>
  kernel.return
}

// ----
low.kernel.def target<spirv.logical.core> workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @wide_offset_loaded_lane() asm {
  %input = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %output = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %offsets = resource<hal_binding> {index = 2, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %lane = OpLoadBuiltin.local_invocation_id.x
  %22 = OpBitcast.i32.u32 %lane
  %23 = OpUConvert.u32.offset64 %22
  %24 = OpConstant.offset64 8
  %25 = OpIMul.offset64 %23, %24
  %26 = OpPtrAccessChain.storage_buffer.i64.byte_offset %offsets, %25
  %raw_bits = OpLoad.storage_buffer.i64 %26
  %offset_mask = OpConstant.i64 9223372036854775804
  %raw = OpBitwiseAnd.i64 %raw_bits, %offset_mask
  %byte_offset = OpBitcast.i64.offset64 %raw
  %31 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input, %byte_offset
  %loaded = OpLoad.storage_buffer.i32 %31
  %35 = OpConstant.offset64 4
  %36 = OpIMul.offset64 %23, %35
  %37 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output, %36
  OpStore.storage_buffer.i32 %37, %loaded
  return
}

