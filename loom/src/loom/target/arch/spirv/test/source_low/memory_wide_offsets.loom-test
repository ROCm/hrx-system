  %39 = OpConstant.offset64 256
  %40 = OpIMul.offset64 %24, %39
  %45 = OpIAdd.offset64 %40, %33
  %46 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output, %45
  OpStore.storage_buffer.i32 %46, %loaded
  return
}

// ====

kernel.def @wide_offset_mixed_terms() {
  %unit = index.constant 1 : index
  %lanes = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%lanes, %unit, %unit) : index
} launch(%input_storage: buffer, %output_storage: buffer, %base_input: offset, %stride_input: offset) {
  %base = index.assume %base_input [mul(%base_input, 4)] : offset
  %stride = index.assume %stride_input [mul(%stride_input, 4)] : offset
  %input = buffer.assume.alignment %input_storage {minimum_alignment = 4} : buffer
  %output = buffer.assume.alignment %output_storage {minimum_alignment = 4} : buffer
  %lane = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %lane_offset = index.scale %lane, %stride : index, offset -> offset
  %byte_offset = index.add %base, %lane_offset : offset
  %input_view = buffer.view %input[%byte_offset] : buffer -> view<1xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<64xi32>
  %loaded = view.load %input_view[0] : view<1xi32> -> i32
  view.store %loaded, %output_view[%lane] : i32, view<64xi32>
  kernel.return
}

// ----
low.kernel.def target<spirv.logical.core> workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @wide_offset_mixed_terms(%base: reg<spirv.offset64>, %stride: reg<spirv.offset64>) asm {
  %input = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %output = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %lane = OpLoadBuiltin.local_invocation_id.x
  %22 = OpBitcast.i32.u32 %lane
  %23 = OpUConvert.u32.offset64 %22
  %lane_offset = OpIMul.offset64 %23, %stride
  %byte_offset = OpIAdd.offset64 %base, %lane_offset
  %26 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input, %byte_offset
  %loaded = OpLoad.storage_buffer.i32 %26
  %30 = OpConstant.offset64 4
  %31 = OpIMul.offset64 %23, %30
  %32 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output, %31
  OpStore.storage_buffer.i32 %32, %loaded
  return
}
