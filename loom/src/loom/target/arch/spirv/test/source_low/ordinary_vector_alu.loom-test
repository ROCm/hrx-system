// RUN: emit source-low output=low control-flow=structured-low

spirv.target<vulkan1_3> @target {contract_feature_bits = 1086626759166}

func.def target(@target) @integer_alu(%lhs0: i16, %lhs1: i16, %lhs2: i16, %rhs0: i16, %rhs1: i16, %rhs2: i16, %count: index) -> (i16) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %lhs = vector.from_elements %lhs0, %lhs1, %lhs2 : vector<3xi16>
  %rhs = vector.from_elements %rhs0, %rhs1, %rhs2 : vector<3xi16>
  %result = scf.for %iteration = [%begin to %count step %step](%state = %lhs : vector<3xi16>) -> (vector<3xi16>) {
    %sum = vector.addi %state, %rhs : vector<3xi16>
    %quotient = vector.divui %sum, %rhs : vector<3xi16>
    %signed_less = vector.cmpi slt, %quotient, %rhs : vector<3xi16> -> vector<3xi1>
    %unsigned_less = vector.cmpi ult, %quotient, %rhs : vector<3xi16> -> vector<3xi1>
    %both = vector.andi %signed_less, %unsigned_less : vector<3xi1>
    %selected = vector.select %both, %quotient, %sum : vector<3xi16>
    scf.yield %selected : vector<3xi16>
  }
  %value = vector.extract %result[1] : vector<3xi16> -> i16
  func.return %value : i16
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @integer_alu(%lhs0: reg<spirv.id : i16>, %lhs1: reg<spirv.id : i16>, %lhs2: reg<spirv.id : i16>, %rhs0: reg<spirv.id : i16>, %rhs1: reg<spirv.id : i16>, %rhs2: reg<spirv.id : i16>, %count: reg<spirv.id : index>) -> (reg<spirv.id : i16>) asm {
  %begin = OpConstant.i32 0 : reg<spirv.id : index>
  %step = OpConstant.i32 1 : reg<spirv.id : index>
  %lhs = OpCompositeConstruct.v3i16 %lhs0, %lhs1, %lhs2
  %rhs = OpCompositeConstruct.v3i16 %rhs0, %rhs1, %rhs2
  %result = low.scf.for signed [%begin to %count step %step] iter_args(%lhs: reg<spirv.id : vector<3xi16>>) -> (reg<spirv.id : vector<3xi16>>) do(%iteration: reg<spirv.id : index>, %state: reg<spirv.id : vector<3xi16>>) {
    %sum = OpIAdd.v3i16 %state, %rhs
    %38 = OpBitcast.v3i16.v3u16 %sum
    %39 = OpBitcast.v3i16.v3u16 %rhs
    %40 = OpUDiv.v3u16 %38, %39
    %quotient = OpBitcast.v3u16.v3i16 %40
    %signed_less = OpSLessThan.v3i16 %quotient, %rhs
    %43 = OpBitcast.v3i16.v3u16 %quotient
    %unsigned_less = OpULessThan.v3u16 %43, %39
    %both = OpLogicalAnd.v3bool %signed_less, %unsigned_less
    %selected = OpSelect.v3i16 %both, %quotient, %sum
    low.scf.yield %selected : reg<spirv.id : vector<3xi16>>
  }
  %value = OpCompositeExtract.v3i16.i16 %result, 1
  return %value
}

// ====
// RUN: emit spirv-low target=spirv:vulkan1.3+bda+extended-types

// Seven i64 elements exceed the native vector carrier. Count normalization
// must not recreate this rejected shape before carrier selection completes.
kernel.def @wide_integer_shifts() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %count_input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %values_view = buffer.view %input[%base] : buffer -> view<7xi64>
  %counts_view = buffer.view %count_input[%base] : buffer -> view<7xi64>
  %results = buffer.view %output[%base] : buffer -> view<3x7xi64>
  %values = vector.load %values_view[0] : view<7xi64> -> vector<7xi64>
  %counts = vector.load %counts_view[0] : view<7xi64> -> vector<7xi64>
  %left = vector.shli %values, %counts : vector<7xi64>
  %logical = vector.shrui %values, %counts : vector<7xi64>
  %arithmetic = vector.shrsi %values, %counts : vector<7xi64>
  vector.store %left, %results[0, 0] : vector<7xi64>, view<3x7xi64>
  vector.store %logical, %results[1, 0] : vector<7xi64>, view<3x7xi64>
  vector.store %arithmetic, %results[2, 0] : vector<7xi64>, view<3x7xi64>
  kernel.return
}

