// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_index_operands.loom-test
// RUN: emit source-low output=none control-flow=structured-low

spirv.target<vulkan1_3> @target

func.def target(@target) @uniform_lhs_index_operands(%input: buffer, %uniform: index) -> (index, index, index, index, index) {
  %base = index.constant 0 : offset
  %aligned_input = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %input_view = buffer.view %aligned_input[%base] : buffer -> view<1xi32>
  %word = view.load %input_view[0] : view<1xi32> -> i32
  %value = index.cast %word : i32 to index
  %multiply = index.mul %uniform, %value : index
  %and = index.andi %uniform, %value : index
  %or = index.ori %uniform, %value : index
  %xor = index.xori %uniform, %value : index
  %subtract = index.sub %uniform, %value : index
  func.return %multiply, %and, %or, %xor, %subtract : index, index, index, index, index
}

// ====

spirv.target<vulkan1_3> @target

func.def target(@target) @uniform_rhs_index_operands(%input: buffer, %uniform: index) -> (index, index, index, index, index) {
  %base = index.constant 0 : offset
  %aligned_input = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %input_view = buffer.view %aligned_input[%base] : buffer -> view<1xi32>
  %word = view.load %input_view[0] : view<1xi32> -> i32
  %value = index.cast %word : i32 to index
  %multiply = index.mul %value, %uniform : index
  %and = index.andi %value, %uniform : index
  %or = index.ori %value, %uniform : index
  %xor = index.xori %value, %uniform : index
  %subtract = index.sub %value, %uniform : index
  func.return %multiply, %and, %or, %xor, %subtract : index, index, index, index, index
}

// ====

spirv.target<vulkan1_3> @target

func.def target(@target) @constant_index_operands(%input: buffer) -> (index, index, index, index) {
  %base = index.constant 0 : offset
  %aligned_input = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %input_view = buffer.view %aligned_input[%base] : buffer -> view<1xi32>
  %word = view.load %input_view[0] : view<1xi32> -> i32
  %value = index.cast %word : i32 to index
  %inline = index.constant 64 : index
  %literal = index.constant 128 : index
  %negative = index.constant -16 : index
  %factor = index.constant 65 : index
  %masked = index.andi %value, %inline : index
  %tagged = index.ori %literal, %value : index
  %toggled = index.xori %value, %negative : index
  %scaled = index.mul %factor, %value : index
  func.return %masked, %tagged, %toggled, %scaled : index, index, index, index
}

// ====

spirv.target<vulkan1_3> @target

func.def target(@target) @uniform_index_operands(%lhs: index, %rhs: index) -> (index, index, index, index, index) {
  %multiply = index.mul %lhs, %rhs : index
  %and = index.andi %lhs, %rhs : index
  %or = index.ori %lhs, %rhs : index
  %xor = index.xori %lhs, %rhs : index
  %subtract = index.sub %lhs, %rhs : index
  func.return %multiply, %and, %or, %xor, %subtract : index, index, index, index, index
}

// ====

spirv.target<vulkan1_3> @target

func.def target(@target) @varying_index_operands(%input: buffer) -> (index, index, index, index, index) {
  %base = index.constant 0 : offset
  %aligned_input = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %input_view = buffer.view %aligned_input[%base] : buffer -> view<2xi32>
  %lhs_word = view.load %input_view[0] : view<2xi32> -> i32
  %rhs_word = view.load %input_view[1] : view<2xi32> -> i32
  %lhs = index.cast %lhs_word : i32 to index
  %rhs = index.cast %rhs_word : i32 to index
  %multiply = index.mul %lhs, %rhs : index
  %and = index.andi %lhs, %rhs : index
  %or = index.ori %lhs, %rhs : index
  %xor = index.xori %lhs, %rhs : index
  %subtract = index.sub %lhs, %rhs : index
  func.return %multiply, %and, %or, %xor, %subtract : index, index, index, index, index
}

// ====

spirv.target<vulkan1_3> @target

func.def target(@target) @bounded_offset_difference(%input: buffer, %wide_limit: offset) -> (offset) {
  %base = index.constant 0 : offset
  %aligned_input = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %input_view = buffer.view %aligned_input[%base] : buffer -> view<1xi32>
  %word = view.load %input_view[0] : view<1xi32> -> i32
  %bounded_word = scalar.assume %word [range(%word, 0, 1023)] : i32
  %position = index.cast %bounded_word : i32 to offset
  %limit = index.assume %wide_limit [range(%wide_limit, 1024, 2047)] : offset
  %remaining = index.sub %limit, %position : offset
  func.return %remaining : offset
}

// ====

spirv.target<vulkan1_3> @target

func.def target(@target) @address_constant_boundaries() -> (index, index, offset, offset, offset, offset) {
  %minimum_index = index.constant -2147483648 : index
  %maximum_index = index.constant 2147483647 : index
  %compact_offset = index.constant 1023 : offset
  %wide_offset = index.constant 1024 : offset
  %high_bit_offset = index.constant 2147483648 : offset
  %maximum_offset = index.constant 4294967295 : offset
  func.return %minimum_index, %maximum_index, %compact_offset, %wide_offset, %high_bit_offset, %maximum_offset : index, index, offset, offset, offset, offset
}

// ====

spirv.target<vulkan1_3> @target

func.def target(@target) @offset_from_constant_payloads() -> (offset, offset) {
  %high_bit = scalar.constant -2147483648 : i32
  %all_bits = scalar.constant -1 : i32
  %high_bit_offset = index.cast %high_bit : i32 to offset
  %maximum_offset = index.cast %all_bits : i32 to offset
  func.return %high_bit_offset, %maximum_offset : offset, offset
}

// ====

spirv.target<vulkan1_3> @target

func.def target(@target) @high_bit_offset_add(%input: offset) -> (i64) {
  %bounded = index.assume %input [range(%input, 0, 1023)] : offset
  %base = index.constant 2147483648 : offset
  %sum = index.add %base, %bounded : offset
  %wide = index.cast %sum : offset to i64
  func.return %wide : i64
}
