// RUN: emit source-low target=spirv:vulkan1.3+bda+extended-types output=low control-flow=structured-low

// A multidimensional nine-lane graph selects three-lane packets without
// rebuilding and immediately flattening aggregate vector shapes.
func.def @partial_predicate_packets(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %mask_view = buffer.view %input[%base] : buffer -> view<3x3xi8>
  %result_view = buffer.view %output[%base] : buffer -> view<3x3xi8>
  %mask_bytes = vector.load %mask_view[0, 0] : view<3x3xi8> -> vector<3x3xi8>
  %c0_scalar = scalar.constant 0 : i8
  %c0 = vector.splat %c0_scalar : vector<3x3xi8>
  %c1_scalar = scalar.constant 1 : i8
  %c1 = vector.splat %c1_scalar : vector<3x3xi8>
  %mask = vector.cmpi ne, %mask_bytes, %c0 : vector<3x3xi8> -> vector<3x3xi1>
  %bytes = vector.select %mask, %c1, %c0 : vector<3x3xi8>
  vector.store %bytes, %result_view[0, 0] : vector<3x3xi8>, view<3x3xi8>
  func.return
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @partial_predicate_packets(%input: reg<spirv.ptr.storage_buffer>, %output: reg<spirv.ptr.storage_buffer>) asm {
  %68 = OpConstant.offset64 0
