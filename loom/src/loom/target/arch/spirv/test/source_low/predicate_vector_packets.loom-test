// ====
// RUN: with-checks compile-report target=spirv:vulkan1.3+bda+extended-types target-legalize{mode=eager},canonicalize,dce,target-legalize{mode=final},canonicalize,dce,source-to-low,low-dce

// The five-operation, 64-lane graph requires 80 four-lane packet operations.
// Its final source-to-Low report guards the component budget and terminal
// store handoff without checking in the much larger exact scalar memory
// lowering already exercised by the execution corpus.
func.def @wide_predicate_packets(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %true_base = index.constant 64 : offset
  %false_base = index.constant 128 : offset
  %mask_view = buffer.view %input[%base] : buffer -> view<64xi8>
  %true_view = buffer.view %input[%true_base] : buffer -> view<64xi8>
  %false_view = buffer.view %input[%false_base] : buffer -> view<64xi8>
  %result_view = buffer.view %output[%base] : buffer -> view<64xi8>
  %mask_bytes = vector.load %mask_view[0] : view<64xi8> -> vector<64xi8>
  %true_bytes = vector.load %true_view[0] : view<64xi8> -> vector<64xi8>
  %false_bytes = vector.load %false_view[0] : view<64xi8> -> vector<64xi8>
  %c0_scalar = scalar.constant 0 : i8
  %c0 = vector.splat %c0_scalar : vector<64xi8>
  %c1_scalar = scalar.constant 1 : i8
  %c1 = vector.splat %c1_scalar : vector<64xi8>
  %mask = vector.cmpi ne, %mask_bytes, %c0 : vector<64xi8> -> vector<64xi1>
  %true_value = vector.cmpi ne, %true_bytes, %c0 : vector<64xi8> -> vector<64xi1>
  %false_value = vector.cmpi ne, %false_bytes, %c0 : vector<64xi8> -> vector<64xi1>
  %selected = vector.select %mask, %true_value, %false_value : vector<64xi1>
  %bytes = vector.select %selected, %c1, %c0 : vector<64xi8>
  vector.store %bytes, %result_view[0] : vector<64xi8>, view<64xi8>
  func.return
}

