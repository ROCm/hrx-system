  %72 = OpPtrAccessChain.storage_buffer.i8.byte_offset %input, %71
  %73 = OpLoad.storage_buffer.i8 %72
  %74 = OpConstant.offset64 2
  %75 = OpPtrAccessChain.storage_buffer.i8.byte_offset %input, %74
  %76 = OpLoad.storage_buffer.i8 %75
  %77 = OpConstant.offset64 3
  %78 = OpPtrAccessChain.storage_buffer.i8.byte_offset %input, %77
  %79 = OpLoad.storage_buffer.i8 %78
  %80 = OpConstant.offset64 4
  %81 = OpPtrAccessChain.storage_buffer.i8.byte_offset %input, %80
  %82 = OpLoad.storage_buffer.i8 %81
  %83 = OpConstant.offset64 5
  %84 = OpPtrAccessChain.storage_buffer.i8.byte_offset %input, %83
  %85 = OpLoad.storage_buffer.i8 %84
  %86 = OpConstant.offset64 6
  %87 = OpPtrAccessChain.storage_buffer.i8.byte_offset %input, %86
  %88 = OpLoad.storage_buffer.i8 %87
  %89 = OpConstant.offset64 7
  %90 = OpPtrAccessChain.storage_buffer.i8.byte_offset %input, %89
  %91 = OpLoad.storage_buffer.i8 %90
  %92 = OpConstant.offset64 8
  %93 = OpPtrAccessChain.storage_buffer.i8.byte_offset %input, %92
  %94 = OpLoad.storage_buffer.i8 %93
  %c0_scalar = OpConstant.i8 0
  %c1_scalar = OpConstant.i8 1
  %97 = OpCompositeConstruct.v3i8 %c0_scalar, %c0_scalar, %c0_scalar
  %98 = OpCompositeConstruct.v3i8 %c1_scalar, %c1_scalar, %c1_scalar
  %99 = OpCompositeConstruct.v3i8 %70, %73, %76
  %100 = OpINotEqual.v3i8 %99, %97
  %101 = OpSelect.v3i8 %100, %98, %97
  %102 = OpCompositeConstruct.v3i8 %79, %82, %85
  %103 = OpINotEqual.v3i8 %102, %97
  %104 = OpSelect.v3i8 %103, %98, %97
  %105 = OpCompositeConstruct.v3i8 %88, %91, %94
  %106 = OpINotEqual.v3i8 %105, %97
  %107 = OpSelect.v3i8 %106, %98, %97
  %108 = OpCompositeExtract.v3i8.i8 %101, 0
  %109 = OpCompositeExtract.v3i8.i8 %101, 1
  %110 = OpCompositeExtract.v3i8.i8 %101, 2
  %112 = OpPtrAccessChain.storage_buffer.i8.byte_offset %output, %68
  OpStore.storage_buffer.i8 %112, %108
  %114 = OpPtrAccessChain.storage_buffer.i8.byte_offset %output, %71
  OpStore.storage_buffer.i8 %114, %109
  %116 = OpPtrAccessChain.storage_buffer.i8.byte_offset %output, %74
  OpStore.storage_buffer.i8 %116, %110
  %117 = OpCompositeExtract.v3i8.i8 %104, 0
  %118 = OpCompositeExtract.v3i8.i8 %104, 1
  %119 = OpCompositeExtract.v3i8.i8 %104, 2
  %121 = OpPtrAccessChain.storage_buffer.i8.byte_offset %output, %77
  OpStore.storage_buffer.i8 %121, %117
  %123 = OpPtrAccessChain.storage_buffer.i8.byte_offset %output, %80
  OpStore.storage_buffer.i8 %123, %118
  %125 = OpPtrAccessChain.storage_buffer.i8.byte_offset %output, %83
  OpStore.storage_buffer.i8 %125, %119
  %126 = OpCompositeExtract.v3i8.i8 %107, 0
  %127 = OpCompositeExtract.v3i8.i8 %107, 1
  %128 = OpCompositeExtract.v3i8.i8 %107, 2
  %130 = OpPtrAccessChain.storage_buffer.i8.byte_offset %output, %86
  OpStore.storage_buffer.i8 %130, %126
  %132 = OpPtrAccessChain.storage_buffer.i8.byte_offset %output, %89
  OpStore.storage_buffer.i8 %132, %127
