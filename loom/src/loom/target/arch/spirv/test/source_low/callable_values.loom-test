// RUN: emit source-low target=spirv:vulkan1.3+bda output=low control-flow=structured-low

func.def public @call_mixed_i32(%input: vector<1xi32>, %delta: i32) -> (i32, i32) {
  %value = vector.extract %input[0] : vector<1xi32> -> i32
  %mixed = func.call @add_i32(%value, %delta) : (i32, i32) -> (i32)
  %uniform = func.call @add_i32(%delta, %delta) : (i32, i32) -> (i32)
  func.return %mixed, %uniform : i32, i32
}

func.def @add_i32(%value: i32, %delta: i32) -> (i32) {
  %wide_value = scalar.extui %value : i32 to i64
  %wide_delta = scalar.extui %delta : i32 to i64
  %sum = scalar.addi %wide_value, %wide_delta : i64
  %result = scalar.trunci %sum : i64 to i32
  func.return %result : i32
}

// ----
low.func.def public target<spirv.logical.core> abi(shader_entry_point) @call_mixed_i32(%value: reg<spirv.id : i32>, %delta: reg<spirv.id : i32>) -> (reg<spirv.id : i32>, reg<spirv.id : i32>) asm {
  %result$20 = OpIAdd %value, %delta
  %result$21 = OpIAdd %delta, %delta
  return %result$20, %result$21
}

// ====

func.def public @call_mixed_i64(%input: vector<1xi64>, %delta: i64) -> (i64, i64) {
  %value = vector.extract %input[0] : vector<1xi64> -> i64
  %mixed = func.call @add_i64(%value, %delta) : (i64, i64) -> (i64)
  %uniform = func.call @add_i64(%delta, %delta) : (i64, i64) -> (i64)
  func.return %mixed, %uniform : i64, i64
}

func.def @add_i64(%value: i64, %delta: i64) -> (i64) {
  %result = scalar.addi %value, %delta : i64
  func.return %result : i64
}

// ----
low.func.def public target<spirv.logical.core> abi(shader_entry_point) @call_mixed_i64(%value: reg<spirv.id : i64>, %delta: reg<spirv.id : i64>) -> (reg<spirv.id : i64>, reg<spirv.id : i64>) asm {
  %result$16 = OpIAdd.i64 %value, %delta
  %result$17 = OpIAdd.i64 %delta, %delta
  return %result$16, %result$17
}

// ====

func.def public @call_vector_result(%input: i32, %lane: index) -> (i32) where [range(%lane, 0, 3)] {
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %c3 = scalar.constant 3 : i32
  %values = vector.from_elements %input, %c1, %c2, %c3 : vector<4xi32>
  %result = func.call inline @select_lane(%values, %lane) : (vector<4xi32>, index) -> (i32)
  func.return %result : i32
}

func.def @select_lane(%values: vector<4xi32>, %lane: index) -> (i32) where [range(%lane, 0, 3)] {
  %replacement = vector.extract %values[0] : vector<4xi32> -> i32
  %updated = vector.insert %replacement into %values[%lane] : i32, vector<4xi32>
  %result = vector.extract %updated[%lane] : vector<4xi32> -> i32
  func.return %result : i32
}

// ----
low.func.def public target<spirv.logical.core> abi(shader_entry_point) @call_vector_result(%input: reg<spirv.id : i32>, %lane: reg<spirv.id : index>) -> (reg<spirv.id : i32>) where [range(%lane, 0, 3)] asm {
  %c1 = OpConstant.i32 1
  %c2 = OpConstant.i32 2
  %c3 = OpConstant.i32 3
  %values = OpCompositeConstruct.v4i32 %input, %c1, %c2, %c3
  %updated = OpVectorInsertDynamic.i32.v4i32 %values, %input, %lane
  %result = OpVectorExtractDynamic.v4i32.i32 %updated, %lane
  return %result
}

// ====

func.def public @call_loop(%input: vector<1xi32>, %delta: i32, %count: index) -> (i32) {
  %value = vector.extract %input[0] : vector<1xi32> -> i32
  %result = func.call @repeat_add(%value, %delta, %count) : (i32, i32, index) -> (i32)
  func.return %result : i32
}

func.def @repeat_add(%value: i32, %delta: i32, %count: index) -> (i32) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %result = scf.for %i = [%c0 to %count step %c1](%current = %value : i32) -> (i32) {
    %next = func.call @advance_i32(%current, %delta) : (i32, i32) -> (i32)
    scf.yield %next : i32
  }
  func.return %result : i32
}

func.def @advance_i32(%value: i32, %delta: i32) -> (i32) {
  %result = scalar.addi %value, %delta : i32
  func.return %result : i32
}

// ----
low.func.def public target<spirv.logical.core> abi(shader_entry_point) @call_loop(%value: reg<spirv.id : i32>, %delta: reg<spirv.id : i32>, %count: reg<spirv.id : index>) -> (reg<spirv.id : i32>) asm {
  %c0 = OpConstant.i32 0 : reg<spirv.id : index>
  %c1 = OpConstant.i32 1 : reg<spirv.id : index>
  %result = low.scf.for signed [%c0 to %count step %c1] iter_args(%value: reg<spirv.id : i32>) -> (reg<spirv.id : i32>) do(%i: reg<spirv.id : index>, %current: reg<spirv.id : i32>) {
    %result = OpIAdd %current, %delta
    low.scf.yield %result : reg<spirv.id : i32>
  }
  return %result
}

// ====

func.def public @call_scalar(%value: i32, %delta: i32) -> (i32) {
  %result = func.call @scalar_add(%value, %delta) : (i32, i32) -> (i32)
  func.return %result : i32
}

func.def @scalar_add(%value: i32, %delta: i32) -> (i32) {
  %result = scalar.addi %value, %delta : i32
  func.return %result : i32
}

// ----
low.func.def public target<spirv.logical.core> abi(shader_entry_point) @call_scalar(%value: reg<spirv.id : i32>, %delta: reg<spirv.id : i32>) -> (reg<spirv.id : i32>) asm {
  %result = OpIAdd %value, %delta
  return %result
}

// ====

// Callable contracts retain argument and result identities across source-to-Low
// boundary mapping. Results are signature values rather than body-local values.
func.def public @preserve_contracts(%limit: index, %value: i32) -> (%bounded: index, %echo: i32) where [range(%limit, 1, 8), eq(%bounded, %limit), eq(%echo, %value)] {
  func.return %limit, %value : index, i32
}

// ----
low.func.def public target<spirv.logical.core> abi(shader_entry_point) @preserve_contracts(%limit: reg<spirv.id : index>, %value: reg<spirv.id : i32>) -> (%bounded: reg<spirv.id : index>, %echo: reg<spirv.id : i32>) where [range(%limit, 1, 8), eq(%bounded, %limit), eq(%echo, %value)] asm {
  return %limit, %value
}

// ====

// A separately compiled definition must use the same signature as its caller's
// declaration. The declaration is resolved by IR linking, not a runtime import.
func.def public @call_external(%value: i32) -> (i32) {
  // ERROR@+1: LOWERING/044 {op_name="func.call", phase_name="inline-callables", callee_name="increment", failure_code="callee_missing_body"}
  %result = func.call @increment(%value) : (i32) -> (i32)
  func.return %result : i32
}

func.decl @increment(%value: i32) -> (%result: i32) where [eq(%result, %value)]

// ====

// Native vector arguments and tuple results cross the same callable boundary.
// The caller consumes both results and retains its original vector beside them.
func.def public @call_vector_pair(%x: f32, %y: f32, %z: f32, %scale: f32) -> (f32, f32, f32) {
  %input = vector.from_elements %x, %y, %z : vector<3xf32>
  %scaled, %first = func.call @scale_vector(%input, %scale) : (vector<3xf32>, f32) -> (vector<3xf32>, f32)
  %last = vector.extract %scaled[2] : vector<3xf32> -> f32
  %original = vector.extract %input[1] : vector<3xf32> -> f32
  func.return %original, %last, %first : f32, f32, f32
}

func.def noinline @scale_vector(%input: vector<3xf32>, %scale: f32) -> (vector<3xf32>, f32) {
  %scales = vector.splat %scale : vector<3xf32>
  %scaled = vector.mulf %input, %scales : vector<3xf32>
  %first = vector.extract %scaled[0] : vector<3xf32> -> f32
  func.return %scaled, %first : vector<3xf32>, f32
}

// ----
low.func.def public target<spirv.logical.core> abi(shader_entry_point) @call_vector_pair(%x: reg<spirv.id : f32>, %y: reg<spirv.id : f32>, %z: reg<spirv.id : f32>, %scale: reg<spirv.id : f32>) -> (reg<spirv.id : f32>, reg<spirv.id : f32>, reg<spirv.id : f32>) asm {
  %input = OpCompositeConstruct.v3f32 %x, %y, %z
  %scaled, %first = low.func.call pure @scale_vector(%input, %scale) : (reg<spirv.id : vector<3xf32>>, reg<spirv.id : f32>) -> (reg<spirv.id : vector<3xf32>>, reg<spirv.id : f32>)
  %last = OpCompositeExtract.v3f32.f32 %scaled, 2
  return %y, %last, %first
}

low.func.def noinline target<spirv.logical.core> @scale_vector(%input: reg<spirv.id : vector<3xf32>>, %scale: reg<spirv.id : f32>) -> (reg<spirv.id : vector<3xf32>>, reg<spirv.id : f32>) asm {
  %scaled = OpVectorTimesScalar.v3f32 %input, %scale
  %first = OpCompositeExtract.v3f32.f32 %scaled, 0
  return %scaled, %first
}
