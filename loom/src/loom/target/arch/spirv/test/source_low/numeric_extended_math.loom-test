spirv.target<vulkan1_3> @target

func.def target(@target) @exact_root(%input: f32) -> (f32) {
  // ERROR@+1: LOWERING/036 {op_name="scalar.sqrtf", phase_name="legalize-math", policy_name="spirv-math", math_op="sqrtf", lane_domain="scalar", element_type="f32", constraint_key="math.root.afn"}
  %result = scalar.sqrtf %input : f32
  func.return %result : f32
}

