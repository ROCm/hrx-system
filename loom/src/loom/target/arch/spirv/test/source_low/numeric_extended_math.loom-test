// RUN: emit source-low output=low control-flow=structured-low

spirv.target<vulkan1_3> @target

func.def target(@target) @scalar_transcendentals(%input: f32) -> (f32) {
  %exp = scalar.expf<afn> %input : f32
  %log = scalar.logf<afn> %exp : f32
  %exp2 = scalar.exp2f<afn> %log : f32
  %log2 = scalar.log2f<afn> %exp2 : f32
  func.return %log2 : f32
}

func.def target(@target) @vector1_transcendentals(%input: f32) -> (f32) {
  %values = vector.splat %input : vector<1xf32>
  %exp = vector.expf<afn> %values : vector<1xf32>
  %log = vector.logf<afn> %exp : vector<1xf32>
  %exp2 = vector.exp2f<afn> %log : vector<1xf32>
  %log2 = vector.log2f<afn> %exp2 : vector<1xf32>
  %result = vector.extract %log2[0] : vector<1xf32> -> f32
  func.return %result : f32
}

func.def target(@target) @vector2_transcendentals(%input: f32) -> (f32) {
  %values = vector.splat %input : vector<2xf32>
  %exp = vector.expf<afn> %values : vector<2xf32>
  %log = vector.logf<afn> %exp : vector<2xf32>
  %exp2 = vector.exp2f<afn> %log : vector<2xf32>
  %log2 = vector.log2f<afn> %exp2 : vector<2xf32>
  %result = vector.extract %log2[1] : vector<2xf32> -> f32
  func.return %result : f32
}

func.def target(@target) @vector3_transcendentals(%input: f32) -> (f32) {
  %values = vector.splat %input : vector<3xf32>
  %exp = vector.expf<afn> %values : vector<3xf32>
  %log = vector.logf<afn> %exp : vector<3xf32>
  %exp2 = vector.exp2f<afn> %log : vector<3xf32>
  %log2 = vector.log2f<afn> %exp2 : vector<3xf32>
  %result = vector.extract %log2[2] : vector<3xf32> -> f32
  func.return %result : f32
}

func.def target(@target) @vector4_transcendentals(%input: f32) -> (f32) {
  %values = vector.splat %input : vector<4xf32>
  %exp = vector.expf<afn> %values : vector<4xf32>
  %log = vector.logf<afn> %exp : vector<4xf32>
  %exp2 = vector.exp2f<afn> %log : vector<4xf32>
  %log2 = vector.log2f<afn> %exp2 : vector<4xf32>
  %result = vector.extract %log2[3] : vector<4xf32> -> f32
  func.return %result : f32
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @scalar_transcendentals(%input: reg<spirv.id : f32>) -> (reg<spirv.id : f32>) asm {
  %exp = OpExtInst.GLSL.std.450.Exp.f32 %input
  %log = OpExtInst.GLSL.std.450.Log.f32 %exp
  %exp2 = OpExtInst.GLSL.std.450.Exp2.f32 %log
  %log2 = OpExtInst.GLSL.std.450.Log2.f32 %exp2
  return %log2
}

low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @vector1_transcendentals(%values: reg<spirv.id : f32>) -> (reg<spirv.id : f32>) asm {
  %exp = OpExtInst.GLSL.std.450.Exp.f32 %values
  %log = OpExtInst.GLSL.std.450.Log.f32 %exp
  %exp2 = OpExtInst.GLSL.std.450.Exp2.f32 %log
  %result = OpExtInst.GLSL.std.450.Log2.f32 %exp2
  return %result
}

low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @vector2_transcendentals(%input: reg<spirv.id : f32>) -> (reg<spirv.id : f32>) asm {
  %values = OpCompositeConstruct.v2f32 %input, %input
  %exp = OpExtInst.GLSL.std.450.Exp.v2f32 %values
  %log = OpExtInst.GLSL.std.450.Log.v2f32 %exp
  %exp2 = OpExtInst.GLSL.std.450.Exp2.v2f32 %log
  %log2 = OpExtInst.GLSL.std.450.Log2.v2f32 %exp2
  %result = OpCompositeExtract.v2f32.f32 %log2, 1
  return %result
}

low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @vector3_transcendentals(%input: reg<spirv.id : f32>) -> (reg<spirv.id : f32>) asm {
  %values = OpCompositeConstruct.v3f32 %input, %input, %input
  %exp = OpExtInst.GLSL.std.450.Exp.v3f32 %values
  %log = OpExtInst.GLSL.std.450.Log.v3f32 %exp
  %exp2 = OpExtInst.GLSL.std.450.Exp2.v3f32 %log
  %log2 = OpExtInst.GLSL.std.450.Log2.v3f32 %exp2
  %result = OpCompositeExtract.v3f32.f32 %log2, 2
  return %result
}

low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @vector4_transcendentals(%input: reg<spirv.id : f32>) -> (reg<spirv.id : f32>) asm {
  %values = OpCompositeConstruct.v4f32 %input, %input, %input, %input
  %exp = OpExtInst.GLSL.std.450.Exp.v4f32 %values
  %log = OpExtInst.GLSL.std.450.Log.v4f32 %exp
  %exp2 = OpExtInst.GLSL.std.450.Exp2.v4f32 %log
  %log2 = OpExtInst.GLSL.std.450.Log2.v4f32 %exp2
  %result = OpCompositeExtract.v4f32.f32 %log2, 3
  return %result
}

// ====
// RUN: emit source-low target=spirv:vulkan1.3+bda+extended-types output=low

func.def @approximate_roots(%half: f16, %single0: f32, %single1: f32, %double: f64) -> (f16, f32, f64) {
  %half_sqrt = scalar.sqrtf<afn> %half : f16
  %half_rsqrt = scalar.rsqrtf<afn> %half_sqrt : f16
  %single = vector.from_elements %single0, %single1 : vector<2xf32>
  %single_sqrt = vector.sqrtf<afn> %single : vector<2xf32>
  %single_rsqrt = vector.rsqrtf<afn> %single_sqrt : vector<2xf32>
  %single_result = vector.extract %single_rsqrt[1] : vector<2xf32> -> f32
  %double_sqrt = scalar.sqrtf<afn> %double : f64
  %double_rsqrt = scalar.rsqrtf<afn> %double_sqrt : f64
  func.return %half_rsqrt, %single_result, %double_rsqrt : f16, f32, f64
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @approximate_roots(%half: reg<spirv.id : f16>, %single0: reg<spirv.id : f32>, %single1: reg<spirv.id : f32>, %double: reg<spirv.id : f64>) -> (reg<spirv.id : f16>, reg<spirv.id : f32>, reg<spirv.id : f64>) asm {
  %half_sqrt = OpExtInst.GLSL.std.450.Sqrt.f16 %half
  %half_rsqrt = OpExtInst.GLSL.std.450.InverseSqrt.f16 %half_sqrt
  %single = OpCompositeConstruct.v2f32 %single0, %single1
  %single_sqrt = OpExtInst.GLSL.std.450.Sqrt.v2f32 %single
  %single_rsqrt = OpExtInst.GLSL.std.450.InverseSqrt.v2f32 %single_sqrt
  %single_result = OpCompositeExtract.v2f32.f32 %single_rsqrt, 1
  %double_sqrt = OpExtInst.GLSL.std.450.Sqrt.f64 %double
  %double_rsqrt = OpExtInst.GLSL.std.450.InverseSqrt.f64 %double_sqrt
  return %half_rsqrt, %single_result, %double_rsqrt
}

