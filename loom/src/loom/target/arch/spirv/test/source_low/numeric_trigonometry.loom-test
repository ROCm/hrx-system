// ====
// RUN: emit spirv-low target=spirv:vulkan1.3+bda+extended-types features=FLOAT32_SIGNED_ZERO_INF_NAN_PRESERVE

func.def @periodic_cosine(%first: f32, %second: f32) -> (f32) {
  %values = vector.from_elements %first, %second : vector<2xf32>
  %result = vector.costurnsf<afn> %values : vector<2xf32>
  %observed = vector.extract %result[1] : vector<2xf32> -> f32
  func.return %observed : f32
}

