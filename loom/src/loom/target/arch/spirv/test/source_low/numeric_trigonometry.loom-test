  %57 = OpLoad.storage_buffer.f32 %56
  %58 = OpConstant.offset64 28
  %59 = OpPtrAccessChain.storage_buffer.f32.byte_offset %input, %58
  %60 = OpLoad.storage_buffer.f32 %59
  %61 = OpCompositeConstruct.v4f32 %51, %54, %57, %60
  %62 = OpExtInst.GLSL.std.450.Sin.v4f32 %48
  %63 = OpExtInst.GLSL.std.450.Cos.v4f32 %62
