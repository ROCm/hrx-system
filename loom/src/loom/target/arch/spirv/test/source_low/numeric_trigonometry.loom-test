// RUN: emit spirv-low target=spirv:vulkan1.3+bda+extended-types

func.def @native_radians(%half: f16, %single: f32) -> (f16, f16, f32, f32) {
  %half_sine = scalar.sinf<afn> %half : f16
  %half_cosine = scalar.cosf<afn> %half : f16
  %sine = scalar.sinf<afn> %single : f32
  %cosine = scalar.cosf<afn> %single : f32
  func.return %half_sine, %half_cosine, %sine, %cosine : f16, f16, f32, f32
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @native_radians(%half: reg<spirv.id : f16>, %single: reg<spirv.id : f32>) -> (reg<spirv.id : f16>, reg<spirv.id : f16>, reg<spirv.id : f32>, reg<spirv.id : f32>) asm {
  %half_sine = OpExtInst.GLSL.std.450.Sin.f16 %half
  %half_cosine = OpExtInst.GLSL.std.450.Cos.f16 %half
  %sine = OpExtInst.GLSL.std.450.Sin.f32 %single
  %cosine = OpExtInst.GLSL.std.450.Cos.f32 %single
  return %half_sine, %half_cosine, %sine, %cosine
}

// ====
// RUN: emit spirv-low target=spirv:vulkan1.3+bda+extended-types

func.def @vector_radians(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %source = buffer.view %input[%origin] : buffer -> view<8xf32>
  %destination = buffer.view %output[%origin] : buffer -> view<8xf32>
  %values = vector.load %source[0] : view<8xf32> -> vector<8xf32>
  %sine = vector.sinf<afn> %values : vector<8xf32>
  %cosine = vector.cosf<afn> %sine : vector<8xf32>
  vector.store %cosine, %destination[0] : vector<8xf32>, view<8xf32>
  func.return
}

