func.def public @rotate_buffer_views(%input: buffer, %count_input: index, %seed: i32) -> (i32) {
  %count = index.assume %count_input [range(%count_input, 0, 257)] : index
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %depth = scalar.constant 4 : i32
  %storage = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %offset0 = index.constant 0 : offset
  %slot0 = buffer.view %storage[%offset0] : buffer -> view<1xi32>
  %ordinal0 = scalar.constant 0 : i32
  %initial0 = scalar.addi %seed, %ordinal0 : i32
  view.store %initial0, %slot0[0] : i32, view<1xi32>
  %offset1 = index.constant 4 : offset
  %slot1 = buffer.view %storage[%offset1] : buffer -> view<1xi32>
  %ordinal1 = scalar.constant 1 : i32
  %initial1 = scalar.addi %seed, %ordinal1 : i32
  view.store %initial1, %slot1[0] : i32, view<1xi32>
  %offset2 = index.constant 8 : offset
  %slot2 = buffer.view %storage[%offset2] : buffer -> view<1xi32>
  %ordinal2 = scalar.constant 2 : i32
  %initial2 = scalar.addi %seed, %ordinal2 : i32
  view.store %initial2, %slot2[0] : i32, view<1xi32>
  %offset3 = index.constant 12 : offset
  %slot3 = buffer.view %storage[%offset3] : buffer -> view<1xi32>
  %ordinal3 = scalar.constant 3 : i32
  %initial3 = scalar.addi %seed, %ordinal3 : i32
  view.store %initial3, %slot3[0] : i32, view<1xi32>
  %unroll = index.constant 2 : index
  %last0, %last1, %last2, %last3 = scf.for %record = [%begin to %count step %step](%current0 = %slot0 : view<1xi32>, %current1 = %slot1 : view<1xi32>, %current2 = %slot2 : view<1xi32>, %current3 = %slot3 : view<1xi32>) -> (view<1xi32>, view<1xi32>, view<1xi32>, view<1xi32>) unroll(%unroll) {
    %number = index.cast %record : index to i32
    %future = scalar.addi %number, %depth : i32
    %value = scalar.addi %seed, %future : i32
    %refined = view.refine %current0 : view<1xi32> -> view<1xi32>
    view.store %value, %refined[0] : i32, view<1xi32>
    scf.yield %current1, %current2, %current3, %refined : view<1xi32>, view<1xi32>, view<1xi32>, view<1xi32>
  }
  %value0 = view.load %last0[0] : view<1xi32> -> i32
  func.return %value0 : i32
}

// ----
low.func.def public target<spirv.logical.core> abi(shader_entry_point) @rotate_buffer_views(%storage: reg<spirv.ptr.storage_buffer>, %count: reg<spirv.id : index>, %seed: reg<spirv.id : i32>) -> (reg<spirv.id : i32>) asm {
  %begin = OpConstant.i32 0 : reg<spirv.id : index>
  %step = OpConstant.i32 1 : reg<spirv.id : index>
  %depth = OpConstant.i32 4
  %offset0 = OpConstant.offset64 0
  %59 = OpPtrAccessChain.storage_buffer.i32.byte_offset %storage, %offset0
  OpStore.storage_buffer.i32 %59, %seed
  %offset1 = OpConstant.offset64 4
  %ordinal1 = OpConstant.i32 1
  %initial1 = OpIAdd %seed, %ordinal1
  %64 = OpPtrAccessChain.storage_buffer.i32.byte_offset %storage, %offset1
  OpStore.storage_buffer.i32 %64, %initial1
  %offset2 = OpConstant.offset64 8
  %ordinal2 = OpConstant.i32 2
  %initial2 = OpIAdd %seed, %ordinal2
  %69 = OpPtrAccessChain.storage_buffer.i32.byte_offset %storage, %offset2
  OpStore.storage_buffer.i32 %69, %initial2
  %offset3 = OpConstant.offset64 12
  %ordinal3 = OpConstant.i32 3
  %initial3 = OpIAdd %seed, %ordinal3
  %74 = OpPtrAccessChain.storage_buffer.i32.byte_offset %storage, %offset3
  OpStore.storage_buffer.i32 %74, %initial3
  %unroll = OpConstant.i32 2 : reg<spirv.id : index>
  %last0_offset, %last1_offset, %last2_offset, %last3_offset = low.scf.for signed [%begin to %count step %step] iter_args(%offset0: reg<spirv.offset64>, %offset1: reg<spirv.offset64>, %offset2: reg<spirv.offset64>, %offset3: reg<spirv.offset64>) -> (reg<spirv.offset64>, reg<spirv.offset64>, reg<spirv.offset64>, reg<spirv.offset64>) unroll(%unroll) do(%record: reg<spirv.id : index>, %current0_offset: reg<spirv.offset64>, %current1_offset: reg<spirv.offset64>, %current2_offset: reg<spirv.offset64>, %current3_offset: reg<spirv.offset64>) {
    %number = OpCopyObject.i32 %record
    %86 = OpIAdd %number, %seed
    %value = OpIAdd %86, %depth
    %88 = OpPtrAccessChain.storage_buffer.i32.byte_offset %storage, %current0_offset
    OpStore.storage_buffer.i32 %88, %value
    low.scf.yield %current1_offset, %current2_offset, %current3_offset, %current0_offset : reg<spirv.offset64>, reg<spirv.offset64>, reg<spirv.offset64>, reg<spirv.offset64>
  }
  %89 = OpPtrAccessChain.storage_buffer.i32.byte_offset %storage, %last0_offset
  %value0 = OpLoad.storage_buffer.i32 %89
  return %value0
}

