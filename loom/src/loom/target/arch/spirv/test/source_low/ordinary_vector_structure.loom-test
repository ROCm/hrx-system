// RUN: emit source-low target=spirv:vulkan1.3+bda+hal output=low control-flow=structured-low

kernel.def @ordinary_vector_structure_i32() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base_byte_offset = index.constant 0 : offset
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %input_view = buffer.view %input_aligned[%base_byte_offset] : buffer -> view<4xi32>
  %output_view = buffer.view %output_aligned[%base_byte_offset] : buffer -> view<4xi32>
  %a = view.load %input_view[0] : view<4xi32> -> i32
  %b = view.load %input_view[1] : view<4xi32> -> i32
  %c = view.load %input_view[2] : view<4xi32> -> i32
  %d = view.load %input_view[3] : view<4xi32> -> i32
  %condition = scalar.cmpi sgt, %a, %b : i32
  %singleton_from = vector.from_elements %b : vector<1xi32>
  %singleton_splat = vector.splat %a : vector<1xi32>
  %singleton_constant = vector.splati 10 : vector<1xi32>
  %singleton_selected = scf.select %condition, %singleton_splat, %singleton_from : vector<1xi32>
  %singleton_inserted = vector.insert %a into %singleton_selected[0] : i32, vector<1xi32>
  %singleton_value = vector.extract %singleton_inserted[0] : vector<1xi32> -> i32
  %singleton_constant_value = vector.extract %singleton_constant[0] : vector<1xi32> -> i32
  %from = vector.from_elements %a, %b, %c, %d : vector<4xi32>
  %shuffled = vector.shuffle<[3, 1, 1, 0]> %from : vector<4xi32>
  %constant = vector.splati 10 : vector<4xi32>
  %splat = vector.splat %singleton_value : vector<4xi32>
  %candidate = scf.select %condition, %shuffled, %constant : vector<4xi32>
  %selected = scf.if %condition -> (vector<4xi32>) {
    view.store %a, %output_view[0] : i32, view<4xi32>
    scf.yield %candidate : vector<4xi32>
  } else {
    view.store %b, %output_view[0] : i32, view<4xi32>
    scf.yield %splat : vector<4xi32>
  }
  %inserted = vector.insert %singleton_constant_value into %selected[2] : i32, vector<4xi32>
  %final = scf.select %condition, %selected, %inserted : vector<4xi32>
  %result0 = vector.extract %final[0] : vector<4xi32> -> i32
  %result1 = vector.extract %final[1] : vector<4xi32> -> i32
  %result2 = vector.extract %final[2] : vector<4xi32> -> i32
  %result3 = vector.extract %final[3] : vector<4xi32> -> i32
  view.store %result0, %output_view[0] : i32, view<4xi32>
  view.store %result1, %output_view[1] : i32, view<4xi32>
  view.store %result2, %output_view[2] : i32, view<4xi32>
  view.store %result3, %output_view[3] : i32, view<4xi32>
  kernel.return
}

// ----
low.kernel.def target<spirv.logical.core> abi_layout({signature = (buffer, buffer) -> ()}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @ordinary_vector_structure_i32() asm {
  %input_aligned = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %output_aligned = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %51 = OpConstant.offset64 0
  %52 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input_aligned, %51
  %a = OpLoad.storage_buffer.i32 %52
  %54 = OpConstant.offset64 4
  %55 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input_aligned, %54
  %b = OpLoad.storage_buffer.i32 %55
  %57 = OpConstant.offset64 8
  %58 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input_aligned, %57
  %c = OpLoad.storage_buffer.i32 %58
  %60 = OpConstant.offset64 12
  %61 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input_aligned, %60
  %d = OpLoad.storage_buffer.i32 %61
  %condition = OpSGreaterThan %a, %b
  %singleton_constant_value = OpConstant.i32 10
  %from = OpCompositeConstruct.v4i32 %a, %b, %c, %d
  %shuffled = OpVectorShuffle.v4i32.v4i32 %from, %from, 3, 1, 1, 0
  %constant = OpCompositeConstruct.v4i32 %singleton_constant_value, %singleton_constant_value, %singleton_constant_value, %singleton_constant_value
  %69 = OpCompositeConstruct.v4bool %condition, %condition, %condition, %condition
  %candidate = OpSelect.v4i32 %69, %shuffled, %constant
  %71, %72, %73, %74 = low.scf.if %condition -> (reg<spirv.id : i32>, reg<spirv.id : i32>, reg<spirv.id : i32>, reg<spirv.id : i32>) {
    %76 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output_aligned, %51
    OpStore.storage_buffer.i32 %76, %a
    %77 = OpCompositeExtract.v4i32.i32 %candidate, 0
    %78 = OpCompositeExtract.v4i32.i32 %candidate, 1
    %79 = OpCompositeExtract.v4i32.i32 %candidate, 2
    %80 = OpCompositeExtract.v4i32.i32 %candidate, 3
    low.scf.yield %77, %78, %79, %80 : reg<spirv.id : i32>, reg<spirv.id : i32>, reg<spirv.id : i32>, reg<spirv.id : i32>
  } else {
    %82 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output_aligned, %51
    OpStore.storage_buffer.i32 %82, %b
    low.scf.yield %a, %a, %a, %a : reg<spirv.id : i32>, reg<spirv.id : i32>, reg<spirv.id : i32>, reg<spirv.id : i32>
  }
  %selected = OpCompositeConstruct.v4i32 %71, %72, %73, %74
  %inserted = OpCompositeInsert.i32.v4i32 %singleton_constant_value, %selected, 2
  %final = OpSelect.v4i32 %69, %selected, %inserted
  %result0 = OpCompositeExtract.v4i32.i32 %final, 0
  %result1 = OpCompositeExtract.v4i32.i32 %final, 1
  %result2 = OpCompositeExtract.v4i32.i32 %final, 2
  %result3 = OpCompositeExtract.v4i32.i32 %final, 3
  %92 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output_aligned, %51
  OpStore.storage_buffer.i32 %92, %result0
  %94 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output_aligned, %54
  OpStore.storage_buffer.i32 %94, %result1
  %96 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output_aligned, %57
  OpStore.storage_buffer.i32 %96, %result2
  %98 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output_aligned, %60
  OpStore.storage_buffer.i32 %98, %result3
  return
}

// ====
// RUN: emit source-low target=spirv:vulkan1.3+bda output=low

// A dynamic window crossing retained load packets stays in native SSA vectors
// instead of staging the authored memory snapshot through private memory.
func.def @dynamic_snapshot_window(%input: buffer, %offset0: index) -> (i32) {
  %base = index.constant 0 : offset
  %aligned = buffer.assume.alignment %input {minimum_alignment = 16} : buffer
  %input_view = buffer.view %aligned[%base] : buffer -> view<8xi32>
  %low = vector.load %input_view[0] : view<8xi32> -> vector<4xi32>
  %high = vector.load %input_view[4] : view<8xi32> -> vector<4xi32>
  %source = vector.concat<0> %low, %high : vector<4xi32>, vector<4xi32> -> vector<8xi32>
  %offset = index.assume %offset0 [range(%offset0, 0, 4), multiple_of(%offset0, 2)] : index
  %window = vector.slice %source[%offset] : vector<8xi32> -> vector<4xi32>
  %result = vector.extract %window[0] : vector<4xi32> -> i32
  func.return %result : i32
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @dynamic_snapshot_window(%aligned: reg<spirv.ptr.storage_buffer>, %offset: reg<spirv.id : index>) -> (reg<spirv.id : i32>) asm {
  %36 = OpConstant.offset64 0
  %37 = OpPtrAccessChain.storage_buffer.i32.byte_offset %aligned, %36
  %38 = OpLoad.storage_buffer.i32 %37
  %39 = OpConstant.offset64 4
  %40 = OpPtrAccessChain.storage_buffer.i32.byte_offset %aligned, %39
  %41 = OpLoad.storage_buffer.i32 %40
  %42 = OpConstant.offset64 8
  %43 = OpPtrAccessChain.storage_buffer.i32.byte_offset %aligned, %42
  %44 = OpLoad.storage_buffer.i32 %43
  %45 = OpConstant.offset64 12
  %46 = OpPtrAccessChain.storage_buffer.i32.byte_offset %aligned, %45
  %47 = OpLoad.storage_buffer.i32 %46
  %low = OpCompositeConstruct.v4i32 %38, %41, %44, %47
  %49 = OpConstant.offset64 16
  %50 = OpPtrAccessChain.storage_buffer.i32.byte_offset %aligned, %49
  %51 = OpLoad.storage_buffer.i32 %50
  %52 = OpConstant.offset64 20
  %53 = OpPtrAccessChain.storage_buffer.i32.byte_offset %aligned, %52
  %54 = OpLoad.storage_buffer.i32 %53
  %55 = OpConstant.offset64 24
  %56 = OpPtrAccessChain.storage_buffer.i32.byte_offset %aligned, %55
  %57 = OpLoad.storage_buffer.i32 %56
  %58 = OpConstant.offset64 28
  %59 = OpPtrAccessChain.storage_buffer.i32.byte_offset %aligned, %58
  %60 = OpLoad.storage_buffer.i32 %59
  %high = OpCompositeConstruct.v4i32 %51, %54, %57, %60
  %62 = OpConstant.i32 2 : reg<spirv.id : index>
  %63 = OpIEqual %offset, %62
  %64 = OpConstant.i32 4 : reg<spirv.id : index>
  %65 = OpIEqual %offset, %64
  %66 = OpCompositeConstruct.v2i32 %44, %47
  %67 = OpCompositeConstruct.v2i32 %51, %54
  %68 = OpVectorShuffle.v2i32.v4i32 %66, %67, 0, 1, 2, 3
  %69 = OpCompositeConstruct.v4bool %63, %63, %63, %63
  %70 = OpSelect.v4i32 %69, %68, %low
  %71 = OpCompositeConstruct.v4bool %65, %65, %65, %65
  %window = OpSelect.v4i32 %71, %high, %70
  %result = OpCompositeExtract.v4i32.i32 %window, 0
  return %result
}

// ====
// RUN: emit source-low output=low control-flow=structured-low

spirv.target<vulkan1_3> @target

func.def target(@target) @rank_two_dynamic_extract(%a: i32, %b: i32, %c: i32, %d: i32, %row: index, %column: index) -> (i32) where [range(%row, 0, 1), range(%column, 0, 1)] {
  %value = vector.from_elements %a, %b, %c, %d : vector<2x2xi32>
  %result = vector.extract %value[%row, %column] : vector<2x2xi32> -> i32
  func.return %result : i32
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @rank_two_dynamic_extract(%a: reg<spirv.id : i32>, %b: reg<spirv.id : i32>, %c: reg<spirv.id : i32>, %d: reg<spirv.id : i32>, %row: reg<spirv.id : index>, %column: reg<spirv.id : index>) -> (reg<spirv.id : i32>) where [range(%row, 0, 1), range(%column, 0, 1)] asm {
  %29 = OpConstant.i32 2 : reg<spirv.id : index>
  %30 = OpIMulAdd %row, %29, %column : reg<spirv.id : index>
  %31 = OpConstant.i32 1 : reg<spirv.id : index>
  %32 = OpIEqual %30, %31
  %33 = OpSelect %32, %b, %a
  %34 = OpIEqual %30, %29
  %35 = OpSelect %34, %c, %33
  %36 = OpConstant.i32 3 : reg<spirv.id : index>
  %37 = OpIEqual %30, %36
  %result = OpSelect %37, %d, %35
  return %result
}
