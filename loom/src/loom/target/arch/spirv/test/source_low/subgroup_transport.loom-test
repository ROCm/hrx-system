// RUN: emit spirv-low target=spirv:vulkan1.3+bda+subgroup32+reductions+hal

// Encoded scalar floats use their existing physical carriers. No numerical
// conversion is needed for either FP8 encoding or software BF16.
kernel.def @encoded_scalar_transport() {
  %unit = index.constant 1 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %lane = kernel.subgroup.lane.id : index
  %selector = index.cast %lane : index to i32
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<32xi32>
  %destination = buffer.view %output[%base] : buffer -> view<32x3xi32>
  %bits = view.load %source[%lane] : view<32xi32> -> i32
  %byte = scalar.trunci %bits : i32 to i8
  %half = scalar.trunci %bits : i32 to i16
  %e4 = scalar.bitcast %byte : i8 to f8E4M3
  %e5 = scalar.bitcast %byte : i8 to f8E5M2
  %bfloat = scalar.bitcast %half : i16 to bf16
  %named = kernel.subgroup.broadcast %e4 from %selector : f8E4M3, i32
  %first = kernel.subgroup.broadcast.first %e5 : f8E5M2
  %distance = scalar.constant 1 : i32
  %width = scalar.constant 32 : i32
  %shuffled, %valid = kernel.subgroup.shuffle<xor> %bfloat, %distance, %width : bf16, i32, i32
  %named_bits = scalar.bitcast %named : f8E4M3 to i8
  %first_bits = scalar.bitcast %first : f8E5M2 to i8
  %shuffled_bits = scalar.bitcast %shuffled : bf16 to i16
  %named_word = scalar.extui %named_bits : i8 to i32
  %first_word = scalar.extui %first_bits : i8 to i32
  %shuffled_word = scalar.extui %shuffled_bits : i16 to i32
  view.store %named_word, %destination[%lane, 0] : i32, view<32x3xi32>
  view.store %first_word, %destination[%lane, 1] : i32, view<32x3xi32>
  view.store %shuffled_word, %destination[%lane, 2] : i32, view<32x3xi32>
  kernel.return
}

// ----
low.kernel.def target<spirv.logical.core> abi_layout({signature = (buffer, buffer) -> ()}) workgroup_size(32, 1, 1) workgroup_count(1, 1, 1) @encoded_scalar_transport() asm {
  %input = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %output = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %lane = OpLoadBuiltin.subgroup_local_invocation_id
  %selector = OpCopyObject.i32 %lane
  %44 = OpSConvert.i32.offset64 %lane
  %45 = OpConstant.offset64 4
  %46 = OpIMul.offset64 %44, %45
  %47 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input, %46
  %bits = OpLoad.storage_buffer.i32 %47
  %e5 = OpSConvert.i32.i8 %bits
  %half = OpSConvert.i32.i16 %bits
  %51 = OpBitcast.i16.u16 %half
  %52 = OpUConvert.u16.u32 %51
  %bfloat = OpBitcast.u32.i32 %52
  %54 = OpBitcast.i32.u32 %selector
  %named_bits = OpGroupNonUniformShuffle.i8 %e5, %54
  %first_bits = OpGroupNonUniformBroadcastFirst.i8 %e5
  %distance = OpConstant.i32 1
  %58 = OpBitcast.i32.u32 %distance
  %shuffled = OpGroupNonUniformShuffleXor.i32 %bfloat, %58
  %shuffled_bits = OpSConvert.i32.i16 %shuffled
  %61 = OpBitcast.i8.u8 %named_bits
  %62 = OpUConvert.u8.u32 %61
  %named_word = OpBitcast.u32.i32 %62
  %64 = OpBitcast.i8.u8 %first_bits
  %65 = OpUConvert.u8.u32 %64
  %first_word = OpBitcast.u32.i32 %65
  %67 = OpBitcast.i16.u16 %shuffled_bits
  %68 = OpUConvert.u16.u32 %67
  %shuffled_word = OpBitcast.u32.i32 %68
  %70 = OpSConvert.i32.offset64 %lane
  %71 = OpConstant.offset64 12
  %72 = OpIMul.offset64 %70, %71
  %73 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output, %72
  OpStore.storage_buffer.i32 %73, %named_word
  %77 = OpConstant.offset64 4
  %78 = OpIAdd.offset64 %72, %77
  %79 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output, %78
  OpStore.storage_buffer.i32 %79, %first_word
  %83 = OpConstant.offset64 8
  %84 = OpIAdd.offset64 %72, %83
  %85 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output, %84
  OpStore.storage_buffer.i32 %85, %shuffled_word
  return
}

// ====
// RUN: emit spirv-low target=spirv:vulkan1.3+bda features=BFLOAT16_TYPE_KHR,-INT16,-SUBGROUP_EXTENDED_TYPES,GROUP_NON_UNIFORM,GROUP_NON_UNIFORM_SHUFFLE,GROUP_NON_UNIFORM_SHUFFLE_RELATIVE,GROUP_NON_UNIFORM_BALLOT,STORAGE_BUFFER_16BIT_ACCESS limits=SUBGROUP_SIZE:32

// Native BF16 permits composites and bitcasts, but forbids group operations.
// Pair packing covers scalar, even, and odd vectors without Int16. Every
// component is stored, including the odd tail whose padding is unobservable.
kernel.def @native_bfloat_transport() {
  %unit = index.constant 1 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %lane = kernel.subgroup.lane.id : index
  %selector = index.cast %lane : index to i32
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<32x4xbf16>
  %destination = buffer.view %output[%base] : buffer -> view<32x10xbf16>
  %a = view.load %source[%lane, 0] : view<32x4xbf16> -> bf16
  %b = view.load %source[%lane, 1] : view<32x4xbf16> -> bf16
  %c = view.load %source[%lane, 2] : view<32x4xbf16> -> bf16
  %d = view.load %source[%lane, 3] : view<32x4xbf16> -> bf16
  %pair = vector.from_elements %a, %b : vector<2xbf16>
  %triple = vector.from_elements %a, %b, %c : vector<3xbf16>
  %quad = vector.from_elements %a, %b, %c, %d : vector<4xbf16>
  %distance = scalar.constant 1 : i32
  %width = scalar.constant 32 : i32
  %single_result, %single_valid = kernel.subgroup.shuffle<xor> %a, %distance, %width : bf16, i32, i32
  %pair_result, %pair_valid = kernel.subgroup.shuffle<up> %pair, %distance, %width : vector<2xbf16>, i32, i32
  %triple_result = kernel.subgroup.broadcast %triple from %selector : vector<3xbf16>, i32
  %quad_result = kernel.subgroup.broadcast.first %quad : vector<4xbf16>
  view.store %single_result, %destination[%lane, 0] : bf16, view<32x10xbf16>
  vector.store %pair_result, %destination[%lane, 1] : vector<2xbf16>, view<32x10xbf16>
  vector.store %triple_result, %destination[%lane, 3] : vector<3xbf16>, view<32x10xbf16>
  vector.store %quad_result, %destination[%lane, 6] : vector<4xbf16>, view<32x10xbf16>
  kernel.return
}

// ----
low.kernel.def target<spirv.logical.core> abi_layout({signature = (buffer, buffer) -> ()}) workgroup_size(32, 1, 1) workgroup_count(1, 1, 1) @native_bfloat_transport() asm {
  %input = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %output = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %lane = OpLoadBuiltin.subgroup_local_invocation_id
  %selector = OpCopyObject.i32 %lane
  %107 = OpSConvert.i32.offset64 %lane
  %108 = OpConstant.offset64 8
  %109 = OpIMul.offset64 %107, %108
  %110 = OpPtrAccessChain.storage_buffer.bf16.byte_offset %input, %109
  %111 = OpLoad.storage_buffer.bf16 %110
  %115 = OpConstant.offset64 2
  %116 = OpIAdd.offset64 %109, %115
  %117 = OpPtrAccessChain.storage_buffer.bf16.byte_offset %input, %116
  %118 = OpLoad.storage_buffer.bf16 %117
  %119 = OpCompositeConstruct.v2bf16 %111, %118
  %123 = OpConstant.offset64 4
  %124 = OpIAdd.offset64 %109, %123
  %125 = OpPtrAccessChain.storage_buffer.bf16.byte_offset %input, %124
  %126 = OpLoad.storage_buffer.bf16 %125
  %130 = OpConstant.offset64 6
  %131 = OpIAdd.offset64 %109, %130
  %132 = OpPtrAccessChain.storage_buffer.bf16.byte_offset %input, %131
  %133 = OpLoad.storage_buffer.bf16 %132
  %triple = OpCompositeConstruct.v3bf16 %111, %118, %126
  %quad = OpCompositeConstruct.v4bf16 %111, %118, %126, %133
  %distance = OpConstant.i32 1
  %137 = OpCompositeConstruct.v2bf16 %111, %111 : reg<spirv.id>
  %138 = OpBitcast.v2bf16.i32 %137 : reg<spirv.id>
  %139 = OpBitcast.i32.u32 %distance
  %140 = OpGroupNonUniformShuffleXor.i32 %138, %139 : reg<spirv.id>
  %141 = OpBitcast.i32.v2bf16 %140 : reg<spirv.id>
  %single_result = OpCompositeExtract.v2bf16.bf16 %141, 0
  %143 = OpBitcast.v2bf16.i32 %119 : reg<spirv.id>
  %144 = OpBitcast.i32.u32 %distance
  %145 = OpGroupNonUniformShuffleUp.i32 %143, %144 : reg<spirv.id>
  %pair_result = OpBitcast.i32.v2bf16 %145
  %147 = OpCompositeExtract.v3bf16.bf16 %triple, 0 : reg<spirv.id>
  %148 = OpCompositeExtract.v3bf16.bf16 %triple, 1 : reg<spirv.id>
  %149 = OpCompositeExtract.v3bf16.bf16 %triple, 2 : reg<spirv.id>
  %150 = OpCompositeConstruct.v4bf16 %147, %148, %149, %149 : reg<spirv.id>
  %151 = OpBitcast.v4bf16.v2i32 %150 : reg<spirv.id>
  %152 = OpBitcast.i32.u32 %selector
  %153 = OpGroupNonUniformShuffle.v2i32 %151, %152 : reg<spirv.id>
  %154 = OpBitcast.v2i32.v4bf16 %153 : reg<spirv.id>
  %155 = OpCompositeExtract.v4bf16.bf16 %154, 0 : reg<spirv.id>
  %156 = OpCompositeExtract.v4bf16.bf16 %154, 1 : reg<spirv.id>
  %157 = OpCompositeExtract.v4bf16.bf16 %154, 2 : reg<spirv.id>
  %triple_result = OpCompositeConstruct.v3bf16 %155, %156, %157
  %159 = OpBitcast.v4bf16.v2i32 %quad : reg<spirv.id>
  %160 = OpGroupNonUniformBroadcastFirst.v2i32 %159 : reg<spirv.id>
  %quad_result = OpBitcast.v2i32.v4bf16 %160
  %162 = OpSConvert.i32.offset64 %lane
  %163 = OpConstant.offset64 20
  %164 = OpIMul.offset64 %162, %163
  %165 = OpPtrAccessChain.storage_buffer.bf16.byte_offset %output, %164
  OpStore.storage_buffer.bf16 %165, %single_result
  %166 = OpCompositeExtract.v2bf16.bf16 %pair_result, 0
  %167 = OpCompositeExtract.v2bf16.bf16 %pair_result, 1
  %171 = OpConstant.offset64 2
  %172 = OpIAdd.offset64 %164, %171
  %173 = OpPtrAccessChain.storage_buffer.bf16.byte_offset %output, %172
  OpStore.storage_buffer.bf16 %173, %166
  %177 = OpConstant.offset64 4
  %178 = OpIAdd.offset64 %164, %177
  %179 = OpPtrAccessChain.storage_buffer.bf16.byte_offset %output, %178
  OpStore.storage_buffer.bf16 %179, %167
  %180 = OpCompositeExtract.v3bf16.bf16 %triple_result, 0
  %181 = OpCompositeExtract.v3bf16.bf16 %triple_result, 1
  %182 = OpCompositeExtract.v3bf16.bf16 %triple_result, 2
  %186 = OpConstant.offset64 6
  %187 = OpIAdd.offset64 %164, %186
  %188 = OpPtrAccessChain.storage_buffer.bf16.byte_offset %output, %187
  OpStore.storage_buffer.bf16 %188, %180
  %192 = OpConstant.offset64 8
  %193 = OpIAdd.offset64 %164, %192
  %194 = OpPtrAccessChain.storage_buffer.bf16.byte_offset %output, %193
  OpStore.storage_buffer.bf16 %194, %181
  %198 = OpConstant.offset64 10
  %199 = OpIAdd.offset64 %164, %198
  %200 = OpPtrAccessChain.storage_buffer.bf16.byte_offset %output, %199
  OpStore.storage_buffer.bf16 %200, %182
  %201 = OpCompositeExtract.v4bf16.bf16 %quad_result, 0
  %202 = OpCompositeExtract.v4bf16.bf16 %quad_result, 1
  %203 = OpCompositeExtract.v4bf16.bf16 %quad_result, 2
  %204 = OpCompositeExtract.v4bf16.bf16 %quad_result, 3
  %208 = OpConstant.offset64 12
  %209 = OpIAdd.offset64 %164, %208
  %210 = OpPtrAccessChain.storage_buffer.bf16.byte_offset %output, %209
  OpStore.storage_buffer.bf16 %210, %201
  %214 = OpConstant.offset64 14
  %215 = OpIAdd.offset64 %164, %214
  %216 = OpPtrAccessChain.storage_buffer.bf16.byte_offset %output, %215
  OpStore.storage_buffer.bf16 %216, %202
  %220 = OpConstant.offset64 16
  %221 = OpIAdd.offset64 %164, %220
  %222 = OpPtrAccessChain.storage_buffer.bf16.byte_offset %output, %221
  OpStore.storage_buffer.bf16 %222, %203
  %226 = OpConstant.offset64 18
  %227 = OpIAdd.offset64 %164, %226
  %228 = OpPtrAccessChain.storage_buffer.bf16.byte_offset %output, %227
  OpStore.storage_buffer.bf16 %228, %204
  return
}

// ====
// RUN: emit source-low target=spirv:vulkan1.3+bda+subgroup32+reductions+hal output=low control-flow=structured-low

// The first packet carries sixteen bytes, the second carries one. Packing
// consumes the captured volatile value without reading beyond its footprint.
kernel.def @wide_encoded_transport() {
  %unit = index.constant 1 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %lane = kernel.subgroup.lane.id : index
  %selector = index.cast %lane : index to i32
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<32x17xf8E4M3>
  %destination = buffer.view %output[%base] : buffer -> view<32x17xf8E4M3>
  %value = vector.load<volatile> %source[%lane, 0] : view<32x17xf8E4M3> -> vector<17xf8E4M3>
  %width = scalar.constant 32 : i32
  %result, %valid = kernel.subgroup.shuffle<index> %value, %selector, %width : vector<17xf8E4M3>, i32, i32
  scf.if %valid {
    vector.store %result, %destination[%lane, 0] : vector<17xf8E4M3>, view<32x17xf8E4M3>
  }
  kernel.return
}

