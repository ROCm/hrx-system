  %1266 = OpLoad.storage_buffer.i8<volatile> %1265
  %width = OpConstant.i32 32
  %1268 = OpBitcast.i8.u8 %1154
  %1269 = OpUConvert.u8.u32 %1268
  %1270 = OpBitcast.u32.i32 %1269
