// ====
// RUN: emit spirv-low target=spirv:vulkan1.3+bda+subgroup32+reductions+hal

// Address vectors retain native i32/offset64 packets, including scalar tails.
// Logical-width normalization applies to address payloads as to fixed integers.
kernel.def @address_vector_transport() {
  %unit = index.constant 1 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %lane = kernel.subgroup.lane.id : index
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<32x5xi32>
  %destination = buffer.view %output[%base] : buffer -> view<32x10xi32>
  %words = vector.load %source[%lane, 0] : view<32x5xi32> -> vector<5xi32>
  %indices = vector.index_cast %words : vector<5xi32> to vector<5xindex>
  %offsets = vector.index_cast %words : vector<5xi32> to vector<5xoffset>
  %selector = scalar.constant 1 : i32
  %width = scalar.constant 16 : i32
  %named = kernel.subgroup.broadcast %indices from %selector : vector<5xindex>, i32
  %shuffled, %valid = kernel.subgroup.shuffle<index> %offsets, %selector, %width : vector<5xoffset>, i32, i32
  %named_words = vector.index_cast %named : vector<5xindex> to vector<5xi32>
  %shuffled_words = vector.index_cast %shuffled : vector<5xoffset> to vector<5xi32>
  vector.store %named_words, %destination[%lane, 0] : vector<5xi32>, view<32x10xi32>
  vector.store %shuffled_words, %destination[%lane, 5] : vector<5xi32>, view<32x10xi32>
  kernel.return
}

