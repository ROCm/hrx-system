  %193 = OpConstant.offset64 6
  %194 = OpIAdd.offset64 %176, %193
  %195 = OpPtrAccessChain.storage_buffer.bf16.byte_offset %output, %194
  OpStore.storage_buffer.bf16 %195, %173
  %199 = OpConstant.offset64 8
  %200 = OpIAdd.offset64 %176, %199
  %201 = OpPtrAccessChain.storage_buffer.bf16.byte_offset %output, %200
  OpStore.storage_buffer.bf16 %201, %169
  %202 = OpConstant.i32 0
  %valid_integer = OpSelect %valid, %distance, %202
  %206 = OpIMul.offset64 %174, %187
  %207 = OpPtrAccessChain.storage_buffer.i32.byte_offset %validity, %206
  OpStore.storage_buffer.i32 %207, %valid_integer
  return
}
