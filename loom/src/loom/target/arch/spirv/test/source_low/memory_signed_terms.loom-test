kernel.def @workgroup_negative_vector_coefficient() {
  %c1 = index.constant 1 : index
  %workgroup_size = index.constant 32 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%workgroup_size, %c1, %c1) : index
} launch() {
  %lane = kernel.workitem.id<x> : index
  %c2 = index.constant 2 : index
  %bank = index.rem %lane, %c2 : index
  %c1 = index.constant 1 : index
  %next_bank = index.sub %c1, %bank : index
  %c0 = index.constant 0 : index
  %bank_bytes = index.constant 16 : offset
  %next_offset = index.scale %next_bank, %bank_bytes : index, offset -> offset
  %byte_length = index.constant 32 : offset
  %scratch = buffer.alloca<workgroup> align(16) %byte_length : buffer
  %view = buffer.view %scratch[%next_offset] : buffer -> view<4xi32>
  %stored = vector.constant 1 : vector<4xi32>
  vector.store %stored, %view[%c0] : vector<4xi32>, view<4xi32>
  %loaded = vector.load %view[%c0] : view<4xi32> -> vector<4xi32>
  vector.store %loaded, %view[%c0] : vector<4xi32>, view<4xi32>
  kernel.return
}

// ----
low.kernel.def target<spirv.logical.core> workgroup_size(32, 1, 1) workgroup_count(1, 1, 1) @workgroup_negative_vector_coefficient() asm {
  %lane = OpLoadBuiltin.local_invocation_id.x
  %27 = OpConstant.i32 1 : reg<spirv.id : index>
  %bank = OpBitwiseAnd %lane, %27 : reg<spirv.id : index>
  %scratch = storage {byte_alignment = 16, byte_length = 32} : low.storage<workgroup>
  %view = storage_address %scratch : low.storage<workgroup> -> reg<spirv.ptr.workgroup.array.i32>
  %31 = OpConstant.i32 1
  %32 = OpConstant.i32 -4 : reg<spirv.id : index>
  %33 = OpIMul %bank, %32 : reg<spirv.id : index>
  %34 = OpConstant.i32 4 : reg<spirv.id : index>
  %35 = OpIAdd %33, %34 : reg<spirv.id : index>
  %36 = OpAccessChain.workgroup.i32.element_index %view, %35
  OpStore.workgroup.i32 %36, %31
  %39 = OpConstant.i32 5 : reg<spirv.id : index>
  %40 = OpIAdd %33, %39 : reg<spirv.id : index>
  %41 = OpAccessChain.workgroup.i32.element_index %view, %40
  OpStore.workgroup.i32 %41, %31
  %44 = OpConstant.i32 6 : reg<spirv.id : index>
  %45 = OpIAdd %33, %44 : reg<spirv.id : index>
  %46 = OpAccessChain.workgroup.i32.element_index %view, %45
  OpStore.workgroup.i32 %46, %31
  %49 = OpConstant.i32 7 : reg<spirv.id : index>
  %50 = OpIAdd %33, %49 : reg<spirv.id : index>
  %51 = OpAccessChain.workgroup.i32.element_index %view, %50
  OpStore.workgroup.i32 %51, %31
  %57 = OpLoad.workgroup.i32 %36
  %63 = OpLoad.workgroup.i32 %41
  %69 = OpLoad.workgroup.i32 %46
  %75 = OpLoad.workgroup.i32 %51
  OpStore.workgroup.i32 %36, %57
  OpStore.workgroup.i32 %41, %63
  OpStore.workgroup.i32 %46, %69
  OpStore.workgroup.i32 %51, %75
  return
}
