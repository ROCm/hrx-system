// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_offset_wide.loom-test
// RUN: emit source-low target=spirv:vulkan1.3+bda+extended-types output=low control-flow=structured-low

func.def @offset_scale_unbounded(%element: index) -> (offset) {
  %stride = index.constant 4 : offset
  // ERROR@+1: SPIRV/027 {constraint_key="spirv.index.scale_coordinate.non_negative_s32"}
  %bytes = index.scale %element, %stride : index, offset -> offset
  func.return %bytes : offset
}

// ====

func.def @offset_scale_unsigned_wrap(%base: i32, %increment: i32) -> (offset) {
  %wrapped = scalar.addi %base, %increment : i32
  %unsigned = index.cast %wrapped : i32 to offset
  // ERROR@+1: SPIRV/026 {constraint_key="index_cast.s32_exact"}
  %element = index.cast %unsigned : offset to index
  %stride = index.constant 4 : offset
  // ERROR@+1: SPIRV/027 {constraint_key="spirv.index.scale_coordinate.non_negative_s32"}
  %bytes = index.scale %element, %stride : index, offset -> offset
  func.return %bytes : offset
}

// ====

func.def @offset_scale_large_stride(%element: index) -> (offset) {
  %stride = index.constant 4294967296 : offset
  // ERROR@+1: SPIRV/027 {constraint_key="spirv.index.scale_coordinate.non_negative_s32"}
  %bytes = index.scale %element, %stride : index, offset -> offset
  func.return %bytes : offset
}

// ====

func.def @offset_scale_dynamic_stride(%element: index, %stride: offset) -> (offset) {
  // ERROR@+1: SPIRV/027 {constraint_key="spirv.index.scale_coordinate.non_negative_s32"}
  %bytes = index.scale %element, %stride : index, offset -> offset
  func.return %bytes : offset
}

// ====

func.def @offset_scale_lane(%elements: vector<4xi32>, %stride: offset) -> (offset) {
  %raw = vector.extract %elements[0] : vector<4xi32> -> i32
  %unsigned = index.cast %raw : i32 to offset
  // ERROR@+1: SPIRV/026 {constraint_key="index_cast.s32_exact"}
  %element = index.cast %unsigned : offset to index
  // ERROR@+1: SPIRV/027 {constraint_key="spirv.index.scale_coordinate.non_negative_s32"}
  %bytes = index.scale %element, %stride : index, offset -> offset
  func.return %bytes : offset
}

// ====

func.def @offset_scale_bounded(%element: index) -> (offset) {
  %bounded = index.assume %element [range(%element, 0, 1023)] : index
  %stride = index.constant 4 : offset
  %bytes = index.scale %bounded, %stride : index, offset -> offset
  func.return %bytes : offset
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @offset_scale_bounded(%bounded: reg<spirv.id : index>) -> (reg<spirv.offset64>) asm {
  %stride = OpConstant.offset64 4
  %8 = OpBitcast.i32.u32 %bounded
  %9 = OpUConvert.u32.offset64 %8
  %bytes = OpIMul.offset64 %9, %stride
  return %bytes
}

// ====

func.def @offset_scale_nonnegative(%element_input: index, %stride: offset) -> (offset) {
  %element = index.assume %element_input [range(%element_input, 0, 2147483647)] : index
  %bytes = index.scale %element, %stride : index, offset -> offset
  func.return %bytes : offset
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @offset_scale_nonnegative(%element: reg<spirv.id : index>, %stride: reg<spirv.offset64>) -> (reg<spirv.offset64>) asm {
  %8 = OpBitcast.i32.u32 %element
  %9 = OpUConvert.u32.offset64 %8
  %bytes = OpIMul.offset64 %9, %stride
  return %bytes
}

// ====

func.def @offset_scale_join(%element_input: index, %choice: i32) -> (offset) {
  %element = index.assume %element_input [range(%element_input, 0, 2147483647)] : index
  %stride = index.constant 4 : offset
  %bytes = index.scale %element, %stride : index, offset -> offset
  %inactive = scalar.constant 0 : i32
  %condition = scalar.cmpi ne, %choice, %inactive : i32
  %result = scf.if %condition -> (offset) {
    scf.yield %bytes : offset
  } else {
    scf.yield %stride : offset
  }
  func.return %result : offset
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @offset_scale_join(%element: reg<spirv.id : index>, %choice: reg<spirv.id : i32>) -> (reg<spirv.offset64>) asm {
  %stride = OpConstant.offset64 4
  %14 = OpBitcast.i32.u32 %element
  %15 = OpUConvert.u32.offset64 %14
  %bytes = OpIMul.offset64 %15, %stride
  %inactive = OpConstant.i32 0
  %condition = OpINotEqual %choice, %inactive
  %result = OpSelect.offset64 %condition, %bytes, %stride
  return %result
}

// ====

func.def @offset_scale_loop(%element_input: index, %stride: offset, %count: index) -> (offset) {
  %element = index.assume %element_input [range(%element_input, 0, 2147483647)] : index
  %bytes = index.scale %element, %stride : index, offset -> offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %result = scf.for %iteration = [%begin to %count step %step](%current = %bytes : offset) -> (offset) {
    %next = index.add %current, %stride : offset
    scf.yield %next : offset
  }
  %previous = index.sub %result, %stride : offset
  func.return %previous : offset
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @offset_scale_loop(%element: reg<spirv.id : index>, %stride: reg<spirv.offset64>, %count: reg<spirv.id : index>) -> (reg<spirv.offset64>) asm {
  %17 = OpBitcast.i32.u32 %element
  %18 = OpUConvert.u32.offset64 %17
  %bytes = OpIMul.offset64 %18, %stride
  %begin = OpConstant.i32 0 : reg<spirv.id : index>
  %step = OpConstant.i32 1 : reg<spirv.id : index>
  %result = low.scf.for signed [%begin to %count step %step] iter_args(%bytes: reg<spirv.offset64>) -> (reg<spirv.offset64>) do(%iteration: reg<spirv.id : index>, %current: reg<spirv.offset64>) {
    %next = OpIAdd.offset64 %current, %stride
    low.scf.yield %next : reg<spirv.offset64>
  }
  %previous = OpISub.offset64 %result, %stride
  return %previous
}
