// RUN: emit source-low output=low control-flow=structured-low

spirv.target<vulkan1_3> @target {contract_feature_bits = 26}

func.def target(@target) @scalar_float_comparisons(%lhs: f32, %rhs: f32, %half_lhs: f16, %half_rhs: f16, %double_lhs: f64, %double_rhs: f64) -> (i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1) {
  %oeq = scalar.cmpf oeq, %lhs, %rhs : f32
  %ogt = scalar.cmpf ogt, %lhs, %rhs : f32
  %oge = scalar.cmpf oge, %lhs, %rhs : f32
  %olt = scalar.cmpf olt, %lhs, %rhs : f32
  %ole = scalar.cmpf ole, %lhs, %rhs : f32
  %one = scalar.cmpf one, %lhs, %rhs : f32
  %ord = scalar.cmpf ord, %lhs, %rhs : f32
  %ueq = scalar.cmpf ueq, %lhs, %rhs : f32
  %ugt = scalar.cmpf ugt, %lhs, %rhs : f32
  %uge = scalar.cmpf uge, %lhs, %rhs : f32
  %ult = scalar.cmpf ult, %lhs, %rhs : f32
  %ule = scalar.cmpf ule, %lhs, %rhs : f32
  %une = scalar.cmpf une, %lhs, %rhs : f32
  %uno = scalar.cmpf uno, %lhs, %rhs : f32
  %half_oeq = scalar.cmpf oeq, %half_lhs, %half_rhs : f16
  %double_uno = scalar.cmpf uno, %double_lhs, %double_rhs : f64
  func.return %oeq, %ogt, %oge, %olt, %ole, %one, %ord, %ueq, %ugt, %uge, %ult, %ule, %une, %uno, %half_oeq, %double_uno : i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1, i1
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @scalar_float_comparisons(%lhs: reg<spirv.id : f32>, %rhs: reg<spirv.id : f32>, %half_lhs: reg<spirv.id : f16>, %half_rhs: reg<spirv.id : f16>, %double_lhs: reg<spirv.id : f64>, %double_rhs: reg<spirv.id : f64>) -> (reg<spirv.id : i1>, reg<spirv.id : i1>, reg<spirv.id : i1>, reg<spirv.id : i1>, reg<spirv.id : i1>, reg<spirv.id : i1>, reg<spirv.id : i1>, reg<spirv.id : i1>, reg<spirv.id : i1>, reg<spirv.id : i1>, reg<spirv.id : i1>, reg<spirv.id : i1>, reg<spirv.id : i1>, reg<spirv.id : i1>, reg<spirv.id : i1>, reg<spirv.id : i1>) asm {
  %oeq = OpFOrdEqual.f32 %lhs, %rhs
  %ogt = OpFOrdGreaterThan.f32 %lhs, %rhs
  %oge = OpFOrdGreaterThanEqual.f32 %lhs, %rhs
  %olt = OpFOrdLessThan.f32 %lhs, %rhs
  %ole = OpFOrdLessThanEqual.f32 %lhs, %rhs
  %one = OpFOrdNotEqual.f32 %lhs, %rhs
  %ord = OpOrdered.f32 %lhs, %rhs
  %ueq = OpFUnordEqual.f32 %lhs, %rhs
  %ugt = OpFUnordGreaterThan.f32 %lhs, %rhs
  %uge = OpFUnordGreaterThanEqual.f32 %lhs, %rhs
  %ult = OpFUnordLessThan.f32 %lhs, %rhs
  %ule = OpFUnordLessThanEqual.f32 %lhs, %rhs
  %une = OpFUnordNotEqual.f32 %lhs, %rhs
  %uno = OpUnordered.f32 %lhs, %rhs
  %half_oeq = OpFOrdEqual.f16 %half_lhs, %half_rhs
  %double_uno = OpUnordered.f64 %double_lhs, %double_rhs
  return %oeq, %ogt, %oge, %olt, %ole, %one, %ord, %ueq, %ugt, %uge, %ult, %ule, %une, %uno, %half_oeq, %double_uno
}
