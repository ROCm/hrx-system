low.func.def target<spirv.logical.core> abi(shader_entry_point) @subtract_f16_2(%lhs: reg<spirv.ptr.storage_buffer>, %rhs: reg<spirv.ptr.storage_buffer>, %output: reg<spirv.ptr.storage_buffer>) asm {
  %21 = OpConstant.offset64 0
  %22 = OpPtrAccessChain.storage_buffer.f16.byte_offset %lhs, %21
  %23 = OpLoad.storage_buffer.f16 %22
  %24 = OpConstant.offset64 2
  %25 = OpPtrAccessChain.storage_buffer.f16.byte_offset %lhs, %24
  %26 = OpLoad.storage_buffer.f16 %25
  %28 = OpPtrAccessChain.storage_buffer.f16.byte_offset %rhs, %21
  %29 = OpLoad.storage_buffer.f16 %28
  %31 = OpPtrAccessChain.storage_buffer.f16.byte_offset %rhs, %24
  %32 = OpLoad.storage_buffer.f16 %31
  %33 = OpFSub.f16 %23, %29
  %34 = OpFSub.f16 %26, %32
  %36 = OpPtrAccessChain.storage_buffer.f16.byte_offset %output, %21
  OpStore.storage_buffer.f16 %36, %33
  %38 = OpPtrAccessChain.storage_buffer.f16.byte_offset %output, %24
  OpStore.storage_buffer.f16 %38, %34
  return
}

