func.def @subtract_bf16_1(%lhs: bf16, %rhs: bf16) -> (bf16) {
  %difference = scalar.subf %lhs, %rhs : bf16
  func.return %difference : bf16
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @subtract_bf16_1(%lhs: reg<spirv.id : bf16>, %rhs: reg<spirv.id : bf16>) -> (reg<spirv.id : bf16>) asm {
  %11 = OpFConvert.bf16.f32 %lhs
  %12 = OpFConvert.bf16.f32 %rhs
  %13 = OpFSub.f32 %11, %12
  %difference = OpFConvert.f32.bf16 %13
  return %difference
}

