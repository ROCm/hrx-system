// ====

spirv.target<vulkan1_3> @target

// All three shifts preserve their input and the count for later arithmetic.
func.def target(@target) @word_shifts_reuse_input(%value: i32, %count: i32) -> (i32) {
  %left = scalar.shli %value, %count : i32
  %logical = scalar.shrui %value, %count : i32
  %signed = scalar.shrsi %value, %count : i32
  %directions = scalar.xori %left, %logical : i32
  %combined = scalar.xori %directions, %signed : i32
  %with_count = scalar.addi %combined, %count : i32
  %result = scalar.xori %with_count, %value : i32
  func.return %result : i32
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @word_shifts_reuse_input(%value: reg<spirv.id : i32>, %count: reg<spirv.id : i32>) -> (reg<spirv.id : i32>) asm {
  %left = OpShiftLeftLogical %value, %count
  %logical = OpShiftRightLogical %value, %count
  %signed = OpShiftRightArithmetic %value, %count
  %directions = OpBitwiseXor %left, %logical
  %combined = OpBitwiseXor %directions, %signed
  %with_count = OpIAdd %combined, %count
  %result = OpBitwiseXor %with_count, %value
  return %result
}

// ====

spirv.target<vulkan1_3> @target

func.def target(@target) @wide_shifts_reuse_counts(%value: i64, %left_count: i64, %right_count: i64) -> (i64) {
  %left = scalar.shli %value, %left_count : i64
  %logical = scalar.shrui %value, %right_count : i64
  %signed = scalar.shrsi %left, %left_count : i64
  %directions = scalar.xori %logical, %signed : i64
  %with_left_count = scalar.addi %directions, %left_count : i64
  %with_counts = scalar.addi %with_left_count, %right_count : i64
  %result = scalar.xori %with_counts, %value : i64
  func.return %result : i64
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @wide_shifts_reuse_counts(%value: reg<spirv.id : i64>, %left_count: reg<spirv.id : i64>, %right_count: reg<spirv.id : i64>) -> (reg<spirv.id : i64>) asm {
  %left = OpShiftLeftLogical.i64 %value, %left_count
  %logical = OpShiftRightLogical.i64 %value, %right_count
  %signed = OpShiftRightArithmetic.i64 %left, %left_count
  %directions = OpBitwiseXor.i64 %logical, %signed
  %with_left_count = OpIAdd.i64 %directions, %left_count
  %with_counts = OpIAdd.i64 %with_left_count, %right_count
  %result = OpBitwiseXor.i64 %with_counts, %value
  return %result
}

// ====

spirv.target<vulkan1_3> @target

func.def target(@target) @wide_shift_value_is_count(%input: i64) -> (i64) {
  %mask = scalar.constant 63 : i64
  %value = scalar.andi %input, %mask : i64
  %result = scalar.shli %value, %value : i64
  func.return %result : i64
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @wide_shift_value_is_count(%input: reg<spirv.id : i64>) -> (reg<spirv.id : i64>) asm {
  %mask = OpConstant.i64 63
  %value = OpBitwiseAnd.i64 %input, %mask
  %result = OpShiftLeftLogical.i64 %value, %value
  return %result
}

// ====

spirv.target<vulkan1_3> @target

func.def target(@target) @index_shift_dynamic(%value: index, %count: index) -> (index, index) {
  // ERROR@+1: SPIRV/027 {op_name="index.shli", field_name="rhs", constraint_key="spirv.index.shift_amount.u5"}
  %left = index.shli %value, %count : index
  // ERROR@+1: SPIRV/027 {op_name="index.shrui", field_name="rhs", constraint_key="spirv.index.shift_amount.u5"}
  %right = index.shrui %value, %count : index
  func.return %left, %right : index, index
}

// ====

spirv.target<vulkan1_3> @target

func.def target(@target) @index_shift_constant_four(%value: index) -> (index) {
  %count = index.constant 4 : index
  %result = index.shli %value, %count : index
  func.return %result : index
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @index_shift_constant_four(%value: reg<spirv.id : index>) -> (reg<spirv.id : index>) asm {
  %count = OpConstant.i32 4 : reg<spirv.id : index>
  %result = OpShiftLeftLogical %value, %count : reg<spirv.id : index>
  return %result
}
