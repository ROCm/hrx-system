low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @wide_right_shift_word_boundaries(%value: reg<spirv.id : i64>) -> (reg<spirv.id : i64>, reg<spirv.id : i64>, reg<spirv.id : i64>, reg<spirv.id : i64>, reg<spirv.id : i64>, reg<spirv.id : i64>, reg<spirv.id : i64>, reg<spirv.id : i64>) asm {
  %last_low = OpConstant.i64 31
  %first_high = OpConstant.i64 32
  %last_high = OpConstant.i64 63
  %logical_low_edge = OpShiftRightLogical.i64 %value, %last_low
  %signed_low_edge = OpShiftRightArithmetic.i64 %value, %last_low
  %logical_high_edge = OpShiftRightLogical.i64 %value, %first_high
  %signed_high_edge = OpShiftRightArithmetic.i64 %value, %first_high
  %logical_top = OpShiftRightLogical.i64 %value, %last_high
  %signed_top = OpShiftRightArithmetic.i64 %value, %last_high
  return %value, %value, %logical_low_edge, %signed_low_edge, %logical_high_edge, %signed_high_edge, %logical_top, %signed_top
}

