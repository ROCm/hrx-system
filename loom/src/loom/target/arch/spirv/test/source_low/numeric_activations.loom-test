// RUN: emit source-low target=spirv:vulkan1.3+bda+extended-types output=low

func.def @vector_activation_family(%input: f32) -> (f32, f32, f32, f32, f32, f32) {
  %values = vector.splat %input : vector<4xf32>
  %logistic_values = vector.logisticf %values : vector<4xf32>
  %silu_values = vector.siluf %values : vector<4xf32>
  %softplus_values = vector.softplusf %values : vector<4xf32>
  %gelu_tanh_values = vector.geluf<tanh> %values : vector<4xf32>
  %gelu_logistic_values = vector.geluf<logistic> %values {scale = 1.702} : vector<4xf32>
  %tanh_values = vector.tanhf<afn> %values : vector<4xf32>
  %logistic = vector.extract %logistic_values[3] : vector<4xf32> -> f32
  %silu = vector.extract %silu_values[3] : vector<4xf32> -> f32
  %softplus = vector.extract %softplus_values[3] : vector<4xf32> -> f32
  %gelu_tanh = vector.extract %gelu_tanh_values[3] : vector<4xf32> -> f32
  %gelu_logistic = vector.extract %gelu_logistic_values[3] : vector<4xf32> -> f32
  %tanh = vector.extract %tanh_values[3] : vector<4xf32> -> f32
  func.return %logistic, %silu, %softplus, %gelu_tanh, %gelu_logistic, %tanh : f32, f32, f32, f32, f32, f32
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @vector_activation_family(%input: reg<spirv.id : f32>) -> (reg<spirv.id : f32>, reg<spirv.id : f32>, reg<spirv.id : f32>, reg<spirv.id : f32>, reg<spirv.id : f32>, reg<spirv.id : f32>) asm {
  %values = OpCompositeConstruct.v4f32 %input, %input, %input, %input
  %137 = OpConstant.f32 3216550459
  %138 = OpConstant.f32 1065353216
  %139 = OpCompositeConstruct.v4f32 %138, %138, %138, %138
  %140 = OpVectorTimesScalar.v4f32 %values, %137
  %141 = OpExtInst.GLSL.std.450.Exp2.v4f32 %140
  %142 = OpFAdd.v4f32 %139, %141
  %logistic_values = OpFDiv.v4f32 %139, %142
  %silu_values = OpVectorTimesScalar.v4f32 %logistic_values, %input
  %149 = OpConstant.f32 1060205080
  %150 = OpConstant.f32 0
  %151 = OpCompositeConstruct.v4f32 %150, %150, %150, %150
  %152 = OpConstant.f32 1065353217
  %153 = OpCompositeConstruct.v4f32 %152, %152, %152, %152
  %154 = OpBitcast.v4f32.v4i32 %values
  %155 = OpConstant.i32 2147483647
  %156 = OpCompositeConstruct.v4i32 %155, %155, %155, %155
  %157 = OpBitwiseAnd.v4i32 %154, %156
  %158 = OpBitcast.v4i32.v4f32 %157
  %159 = OpVectorTimesScalar.v4f32 %158, %137
  %160 = OpExtInst.GLSL.std.450.Exp2.v4f32 %159
  %161 = OpFAdd.v4f32 %139, %160
  %162 = OpFSub.v4f32 %161, %139
  %163 = OpFOrdGreaterThanEqual.v4f32 %161, %153
  %164 = OpSelect.v4f32 %163, %162, %139
  %165 = OpFDiv.v4f32 %160, %164
  %166 = OpExtInst.GLSL.std.450.Log2.v4f32 %161
  %167 = OpVectorTimesScalar.v4f32 %166, %149
  %168 = OpFMul.v4f32 %167, %165
  %169 = OpSelect.v4f32 %163, %168, %160
  %170 = OpFOrdGreaterThanEqual.v4f32 %values, %151
  %171 = OpSelect.v4f32 %170, %values, %151
  %softplus_values = OpFAdd.v4f32 %171, %169
  %173 = OpConstant.f32 1056964608
  %174 = OpCompositeConstruct.v4f32 %173, %173, %173, %173
  %175 = OpConstant.f32 1027024659
  %176 = OpConstant.f32 1061962282
  %177 = OpVectorTimesScalar.v4f32 %values, %input
  %178 = OpVectorTimesScalar.v4f32 %177, %input
  %179 = OpVectorTimesScalar.v4f32 %178, %175
  %180 = OpFAdd.v4f32 %values, %179
  %181 = OpVectorTimesScalar.v4f32 %180, %176
  %182 = OpConstant.f32 3212836864
  %183 = OpCompositeConstruct.v4f32 %182, %182, %182, %182
  %184 = OpConstant.f32 1073741824
  %185 = OpVectorTimesScalar.v4f32 %181, %184
  %186 = OpVectorTimesScalar.v4f32 %185, %137
  %187 = OpExtInst.GLSL.std.450.Exp2.v4f32 %186
  %188 = OpFAdd.v4f32 %139, %187
  %189 = OpFDiv.v4f32 %139, %188
  %190 = OpVectorTimesScalar.v4f32 %189, %184
  %191 = OpFAdd.v4f32 %190, %183
  %192 = OpFAdd.v4f32 %139, %191
  %193 = OpVectorTimesScalar.v4f32 %174, %input
  %gelu_tanh_values = OpFMul.v4f32 %193, %192
  %195 = OpConstant.f32 1071242019
  %196 = OpCompositeConstruct.v4f32 %195, %195, %195, %195
  %197 = OpVectorTimesScalar.v4f32 %196, %input
  %198 = OpVectorTimesScalar.v4f32 %197, %137
  %199 = OpExtInst.GLSL.std.450.Exp2.v4f32 %198
  %200 = OpFAdd.v4f32 %139, %199
  %201 = OpFDiv.v4f32 %139, %200
  %gelu_logistic_values = OpVectorTimesScalar.v4f32 %201, %input
  %203 = OpVectorTimesScalar.v4f32 %values, %184
  %204 = OpVectorTimesScalar.v4f32 %203, %137
  %205 = OpExtInst.GLSL.std.450.Exp2.v4f32 %204
  %206 = OpFAdd.v4f32 %139, %205
  %207 = OpFDiv.v4f32 %139, %206
  %208 = OpVectorTimesScalar.v4f32 %207, %184
  %tanh_values = OpFAdd.v4f32 %208, %183
  %logistic = OpCompositeExtract.v4f32.f32 %logistic_values, 3
  %silu = OpCompositeExtract.v4f32.f32 %silu_values, 3
  %softplus = OpCompositeExtract.v4f32.f32 %softplus_values, 3
  %gelu_tanh = OpCompositeExtract.v4f32.f32 %gelu_tanh_values, 3
  %gelu_logistic = OpCompositeExtract.v4f32.f32 %gelu_logistic_values, 3
  %tanh = OpCompositeExtract.v4f32.f32 %tanh_values, 3
  return %logistic, %silu, %softplus, %gelu_tanh, %gelu_logistic, %tanh
}
