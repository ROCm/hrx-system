// RUN: emit source-low target=spirv:vulkan1.3+bda+extended-types output=low

func.def @vector_activation_family(%input: f32) -> (f32, f32, f32, f32, f32, f32) {
  %values = vector.splat %input : vector<4xf32>
  %logistic_values = vector.logisticf %values : vector<4xf32>
  %silu_values = vector.siluf %values : vector<4xf32>
  %softplus_values = vector.softplusf %values : vector<4xf32>
  %gelu_tanh_values = vector.geluf<tanh> %values : vector<4xf32>
  %gelu_logistic_values = vector.geluf<logistic> %values {scale = 1.702} : vector<4xf32>
  %tanh_values = vector.tanhf<afn> %values : vector<4xf32>
  %logistic = vector.extract %logistic_values[3] : vector<4xf32> -> f32
  %silu = vector.extract %silu_values[3] : vector<4xf32> -> f32
  %softplus = vector.extract %softplus_values[3] : vector<4xf32> -> f32
  %gelu_tanh = vector.extract %gelu_tanh_values[3] : vector<4xf32> -> f32
  %gelu_logistic = vector.extract %gelu_logistic_values[3] : vector<4xf32> -> f32
  %tanh = vector.extract %tanh_values[3] : vector<4xf32> -> f32
  func.return %logistic, %silu, %softplus, %gelu_tanh, %gelu_logistic, %tanh : f32, f32, f32, f32, f32, f32
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @vector_activation_family(%input: reg<spirv.id : f32>) -> (reg<spirv.id : f32>, reg<spirv.id : f32>, reg<spirv.id : f32>, reg<spirv.id : f32>, reg<spirv.id : f32>, reg<spirv.id : f32>) asm {
  %values = OpCompositeConstruct.v4f32 %input, %input, %input, %input
  %138 = OpConstant.f32 3216550459
  %139 = OpConstant.f32 1065353216
  %140 = OpCompositeConstruct.v4f32 %139, %139, %139, %139
  %141 = OpVectorTimesScalar.v4f32 %values, %138
  %142 = OpExtInst.GLSL.std.450.Exp2.v4f32 %141
  %143 = OpFAdd.v4f32 %140, %142
  %logistic_values = OpFDiv.v4f32 %140, %143
  %silu_values = OpVectorTimesScalar.v4f32 %logistic_values, %input
  %150 = OpConstant.f32 1060205080
  %151 = OpConstant.f32 0
  %152 = OpCompositeConstruct.v4f32 %151, %151, %151, %151
  %153 = OpConstant.f32 1065353217
  %154 = OpCompositeConstruct.v4f32 %153, %153, %153, %153
  %155 = OpBitcast.v4f32.v4i32 %values
  %156 = OpConstant.i32 2147483647
  %157 = OpCompositeConstruct.v4i32 %156, %156, %156, %156
  %158 = OpBitwiseAnd.v4i32 %155, %157
  %159 = OpBitcast.v4i32.v4f32 %158
  %160 = OpVectorTimesScalar.v4f32 %159, %138
  %161 = OpExtInst.GLSL.std.450.Exp2.v4f32 %160
  %162 = OpFAdd.v4f32 %140, %161
  %163 = OpFSub.v4f32 %162, %140
  %164 = OpFOrdGreaterThanEqual.v4f32 %162, %154
  %165 = OpSelect.v4f32 %164, %163, %140
  %166 = OpFDiv.v4f32 %161, %165
  %167 = OpExtInst.GLSL.std.450.Log2.v4f32 %162
  %168 = OpVectorTimesScalar.v4f32 %167, %150
  %169 = OpFMul.v4f32 %168, %166
  %170 = OpSelect.v4f32 %164, %169, %161
  %171 = OpFOrdGreaterThanEqual.v4f32 %values, %152
  %172 = OpSelect.v4f32 %171, %values, %152
  %softplus_values = OpFAdd.v4f32 %172, %170
  %174 = OpConstant.f32 1056964608
  %175 = OpCompositeConstruct.v4f32 %174, %174, %174, %174
  %176 = OpConstant.f32 1027024659
  %177 = OpConstant.f32 1061962282
  %178 = OpVectorTimesScalar.v4f32 %values, %input
  %179 = OpVectorTimesScalar.v4f32 %178, %input
  %180 = OpVectorTimesScalar.v4f32 %179, %176
  %181 = OpFAdd.v4f32 %values, %180
  %182 = OpVectorTimesScalar.v4f32 %181, %177
  %183 = OpConstant.f32 3212836864
  %184 = OpCompositeConstruct.v4f32 %183, %183, %183, %183
  %185 = OpConstant.f32 1073741824
  %186 = OpVectorTimesScalar.v4f32 %182, %185
  %187 = OpVectorTimesScalar.v4f32 %186, %138
  %188 = OpExtInst.GLSL.std.450.Exp2.v4f32 %187
  %189 = OpFAdd.v4f32 %140, %188
  %190 = OpFDiv.v4f32 %140, %189
  %191 = OpVectorTimesScalar.v4f32 %190, %185
  %192 = OpFAdd.v4f32 %191, %184
  %193 = OpFAdd.v4f32 %140, %192
  %194 = OpVectorTimesScalar.v4f32 %175, %input
  %gelu_tanh_values = OpFMul.v4f32 %194, %193
  %196 = OpConstant.f32 1071242019
  %197 = OpCompositeConstruct.v4f32 %196, %196, %196, %196
  %198 = OpVectorTimesScalar.v4f32 %197, %input
  %199 = OpVectorTimesScalar.v4f32 %198, %138
  %200 = OpExtInst.GLSL.std.450.Exp2.v4f32 %199
  %201 = OpFAdd.v4f32 %140, %200
  %202 = OpFDiv.v4f32 %140, %201
  %gelu_logistic_values = OpVectorTimesScalar.v4f32 %202, %input
  %204 = OpVectorTimesScalar.v4f32 %values, %185
  %205 = OpVectorTimesScalar.v4f32 %204, %138
  %206 = OpExtInst.GLSL.std.450.Exp2.v4f32 %205
  %207 = OpFAdd.v4f32 %140, %206
  %208 = OpFDiv.v4f32 %140, %207
  %209 = OpVectorTimesScalar.v4f32 %208, %185
  %tanh_values = OpFAdd.v4f32 %209, %184
  %logistic = OpCompositeExtract.v4f32.f32 %logistic_values, 3
  %silu = OpCompositeExtract.v4f32.f32 %silu_values, 3
  %softplus = OpCompositeExtract.v4f32.f32 %softplus_values, 3
  %gelu_tanh = OpCompositeExtract.v4f32.f32 %gelu_tanh_values, 3
  %gelu_logistic = OpCompositeExtract.v4f32.f32 %gelu_logistic_values, 3
  %tanh = OpCompositeExtract.v4f32.f32 %tanh_values, 3
  return %logistic, %silu, %softplus, %gelu_tanh, %gelu_logistic, %tanh
}
