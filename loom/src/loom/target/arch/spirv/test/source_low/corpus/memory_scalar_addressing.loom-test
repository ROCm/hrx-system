low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @scalar_subview_dynamic_index_i32(%input_aligned: reg<spirv.ptr.storage_buffer>, %output_aligned: reg<spirv.ptr.storage_buffer>, %base_aligned: reg<spirv.offset64>, %element_bounded: reg<spirv.id : index>) -> (reg<spirv.id : i32>) asm {
  %21 = OpBitcast.i32.u32 %element_bounded
  %22 = OpUConvert.u32.offset64 %21
  %23 = OpConstant.offset64 4
  %24 = OpIMul.offset64 %22, %23
  %25 = OpIAdd.offset64 %base_aligned, %24
  %27 = OpIAdd.offset64 %25, %23
  %28 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input_aligned, %27
  %loaded = OpLoad.storage_buffer.i32 %28
  %37 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output_aligned, %27
  OpStore.storage_buffer.i32 %37, %loaded
  return %loaded
}
