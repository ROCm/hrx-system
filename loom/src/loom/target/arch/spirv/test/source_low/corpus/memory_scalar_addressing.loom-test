spirv.target<vulkan1_3> @target

func.def target(@target) @scalar_materialized_view_base_suffix_i32(%input: buffer, %output: buffer, %base: offset) -> (i32) {
  %base_aligned = index.assume %base [range(%base, 0, 4056), mul(%base, 4)] : offset
  %bias = index.constant 4 : offset
  %biased_base = index.add %base_aligned, %bias : offset
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %input_view = buffer.view %input_aligned[%biased_base] : buffer -> view<8xi32>
  %output_view = buffer.view %output_aligned[%biased_base] : buffer -> view<8xi32>
  %loaded = view.load %input_view[2] : view<8xi32> -> i32
  view.store %loaded, %output_view[3] : i32, view<8xi32>
  func.return %loaded : i32
}

