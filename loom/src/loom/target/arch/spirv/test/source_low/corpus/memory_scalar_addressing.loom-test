spirv.target<vulkan1_3> @target

func.def target(@target) @scalar_dynamic_view_base_i32(%input: buffer, %output: buffer, %base: offset) -> (i32) {
  %base_aligned = index.assume %base [range(%base, 0, 4092), mul(%base, 4)] : offset
  %output_base = index.constant 0 : offset
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %input_view = buffer.view %input_aligned[%base_aligned] : buffer -> view<4xi32>
  %output_view = buffer.view %output_aligned[%output_base] : buffer -> view<1xi32>
  %loaded = view.load %input_view[2] : view<4xi32> -> i32
  view.store %loaded, %output_view[0] : i32, view<1xi32>
  func.return %loaded : i32
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @scalar_dynamic_view_base_i32(%input_aligned: reg<spirv.ptr.storage_buffer>, %output_aligned: reg<spirv.ptr.storage_buffer>, %base_aligned: reg<spirv.offset64>) -> (reg<spirv.id : i32>) asm {
  %15 = OpConstant.offset64 8
  %16 = OpIAdd.offset64 %base_aligned, %15
  %17 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input_aligned, %16
  %loaded = OpLoad.storage_buffer.i32 %17
  %19 = OpConstant.offset64 0
  %20 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output_aligned, %19
  OpStore.storage_buffer.i32 %20, %loaded
  return %loaded
}

