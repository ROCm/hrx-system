low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @scalar_dynamic_index_i32(%input_aligned: reg<spirv.ptr.storage_buffer>, %output_aligned: reg<spirv.ptr.storage_buffer>, %element_bounded: reg<spirv.id : index>) -> (reg<spirv.id : i32>) asm {
  %15 = OpBitcast.i32.u32 %element_bounded
  %16 = OpUConvert.u32.offset64 %15
  %17 = OpConstant.offset64 4
  %18 = OpIMul.offset64 %16, %17
  %19 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input_aligned, %18
  %loaded = OpLoad.storage_buffer.i32 %19
  %25 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output_aligned, %18
  OpStore.storage_buffer.i32 %25, %loaded
  return %loaded
}

