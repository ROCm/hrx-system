low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @scalar_materialized_view_base_suffix_i32(%input_aligned: reg<spirv.ptr.storage_buffer>, %output_aligned: reg<spirv.ptr.storage_buffer>, %base_aligned: reg<spirv.offset64>) -> (reg<spirv.id : i32>) asm {
  %bias = OpConstant.offset64 4
  %biased_base = OpIAdd.offset64 %base_aligned, %bias
  %18 = OpConstant.offset64 8
  %19 = OpIAdd.offset64 %biased_base, %18
  %20 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input_aligned, %19
  %loaded = OpLoad.storage_buffer.i32 %20
  %22 = OpConstant.offset64 12
  %23 = OpIAdd.offset64 %biased_base, %22
  %24 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output_aligned, %23
  OpStore.storage_buffer.i32 %24, %loaded
  return %loaded
}

