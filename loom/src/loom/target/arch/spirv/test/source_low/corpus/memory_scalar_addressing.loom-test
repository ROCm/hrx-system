low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @scalar_mixed_rank2_i32(%input_aligned: reg<spirv.ptr.storage_buffer>, %output_aligned: reg<spirv.ptr.storage_buffer>, %base_aligned: reg<spirv.offset64>, %row_bounded: reg<spirv.id : index>, %column_bounded: reg<spirv.id : index>) -> (reg<spirv.id : i32>) asm {
  %27 = OpBitcast.i32.u32 %row_bounded
  %28 = OpUConvert.u32.offset64 %27
  %29 = OpConstant.offset64 32
  %30 = OpIMul.offset64 %28, %29
  %31 = OpIAdd.offset64 %base_aligned, %30
  %32 = OpBitcast.i32.u32 %column_bounded
  %33 = OpUConvert.u32.offset64 %32
  %34 = OpConstant.offset64 4
  %35 = OpIMul.offset64 %33, %34
  %36 = OpIAdd.offset64 %31, %35
  %37 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input_aligned, %36
  %loaded = OpLoad.storage_buffer.i32 %37
  %49 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output_aligned, %36
  OpStore.storage_buffer.i32 %49, %loaded
  return %loaded
}

