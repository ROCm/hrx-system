low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @scalar_dynamic_stride_i32(%input_aligned: reg<spirv.ptr.storage_buffer>, %output_aligned: reg<spirv.ptr.storage_buffer>, %columns_bounded: reg<spirv.id : index>, %row_bounded: reg<spirv.id : index>, %column_bounded: reg<spirv.id : index>) -> (reg<spirv.id : i32>) asm {
  %21 = OpBitcast.i32.u32 %row_bounded
  %22 = OpUConvert.u32.offset64 %21
  %23 = OpBitcast.i32.u32 %columns_bounded
  %24 = OpUConvert.u32.offset64 %23
  %25 = OpIMul.offset64 %22, %24
  %26 = OpConstant.offset64 4
  %27 = OpIMul.offset64 %25, %26
  %28 = OpBitcast.i32.u32 %column_bounded
  %29 = OpUConvert.u32.offset64 %28
  %31 = OpIMul.offset64 %29, %26
  %32 = OpIAdd.offset64 %27, %31
  %33 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input_aligned, %32
  %loaded = OpLoad.storage_buffer.i32 %33
  %47 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output_aligned, %32
  OpStore.storage_buffer.i32 %47, %loaded
  return %loaded
}

