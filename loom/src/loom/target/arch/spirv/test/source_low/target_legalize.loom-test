func.def target(@target) @reference_fallback_for_dense_logical_mma(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<12xi32>
  %destination = buffer.view %output[%base] : buffer -> view<4xi32>
  %lhs_data = vector.load %source[0] : view<12xi32> -> vector<4xi32>
  %rhs_data = vector.load %source[4] : view<12xi32> -> vector<4xi32>
  %init_data = vector.load %source[8] : view<12xi32> -> vector<4xi32>
  %m = index.constant 2 : index
  %n = index.constant 2 : index
  %k = index.constant 2 : index
  %lhs = vector.fragment<lhs> %lhs_data shape [%m, %k] : vector<4xi32>
  %rhs = vector.fragment<rhs> %rhs_data shape [%k, %n] : vector<4xi32>
  %init = vector.fragment<init> %init_data shape [%m, %n] : vector<4xi32>
  %result = vector.mma %lhs, %rhs, %init : vector<4xi32>, vector<4xi32>, vector<4xi32>
  vector.store %result, %destination[0] : vector<4xi32>, view<4xi32>
  func.return
}

