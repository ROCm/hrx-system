// RUN: emit spirv-low target=spirv:vulkan1.3+bda+hal features=FLOAT16,COOPERATIVE_MATRIX_KHR

kernel.def @keeps_supported_cooperative_matrix_contract() {
  %unit = index.constant 1 : index
  %width = target.subgroup.size : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%output: buffer, %left: f16, %right: f16, %initial: f32) {
  %base = index.constant 0 : offset
  %aligned = buffer.assume.alignment %output {minimum_alignment = 16} : buffer
  %destination = buffer.view %aligned[%base] : buffer -> view<16x16xf32>
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %lhs_data = vector.splat %left : vector<16xf16>
  %rhs_data = vector.splat %right : vector<16xf16>
  %init_data = vector.splat %initial : vector<8xf32>
  %lhs = vector.fragment<lhs> %lhs_data shape [%m, %k] : vector<16xf16>
  %rhs = vector.fragment<rhs> %rhs_data shape [%k, %n] : vector<16xf16>
  %init = vector.fragment<init> %init_data shape [%m, %n] : vector<8xf32>
  %result = vector.mma %lhs, %rhs, %init : vector<16xf16>, vector<16xf16>, vector<8xf32>
  vector.fragment.store<result> %result, %destination[0, 0] shape [%m, %n] : vector<8xf32>, view<16x16xf32>
  kernel.return
}

// ----
low.kernel.def target<spirv.logical.core> abi_layout({signature = (buffer, f16, f16, f32) -> ()}) workgroup_count(1, 1, 1) @keeps_supported_cooperative_matrix_contract(%left: reg<spirv.id : f16>, %right: reg<spirv.id : f16>, %initial: reg<spirv.id : f32>) asm {
  %aligned = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %lhs = OpCompositeConstruct.cooperative.f16.16x16.lhs %left : reg<spirv.id : spirv.cooperative_matrix<16x16xf16, subgroup, matrix_a>>
  %rhs = OpCompositeConstruct.cooperative.f16.16x16.rhs %right : reg<spirv.id : spirv.cooperative_matrix<16x16xf16, subgroup, matrix_b>>
  %init = OpCompositeConstruct.cooperative.f32.16x16.accumulator %initial : reg<spirv.id : spirv.cooperative_matrix<16x16xf32, subgroup, matrix_accumulator>>
  %result = OpCooperativeMatrixMulAddKHR.f16.16x16x16.f32.subgroup %lhs, %rhs, %init : reg<spirv.id : spirv.cooperative_matrix<16x16xf32, subgroup, matrix_accumulator>>
  %27 = OpConstant.offset64 16
  %28 = OpUConvert.offset64.u32 %27
  %29 = OpConstant.offset64 0
  %30 = OpPtrAccessChain.storage_buffer.f32.byte_offset %aligned, %29
  OpCooperativeMatrixStoreKHR.result.f32.16x16.subgroup.storage_buffer %30, %result, %28, 0
  return
}

