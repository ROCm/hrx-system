// RUN: emit spirv-low target=spirv:vulkan1.3+bda+hal features=FLOAT16,-COOPERATIVE_MATRIX_KHR

kernel.def @rejects_missing_cooperative_matrix_feature() {
  %unit = index.constant 1 : index
  %width = target.subgroup.size : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%output: buffer, %left: f16, %right: f16, %initial: f32) {
  %base = index.constant 0 : offset
  %aligned = buffer.assume.alignment %output {minimum_alignment = 16} : buffer
  %destination = buffer.view %aligned[%base] : buffer -> view<16x16xf32>
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %lhs_data = vector.splat %left : vector<16xf16>
  %rhs_data = vector.splat %right : vector<16xf16>
  %init_data = vector.splat %initial : vector<8xf32>
  %lhs = vector.fragment<lhs> %lhs_data shape [%m, %k] : vector<16xf16>
  %rhs = vector.fragment<rhs> %rhs_data shape [%k, %n] : vector<16xf16>
  %init = vector.fragment<init> %init_data shape [%m, %n] : vector<8xf32>
  // ERROR@+1: TARGET/039 {source_contract="spirv.cooperative_matrix", matrix_constraint="spirv.cooperative_matrix.khr"}
  %result = vector.mma %lhs, %rhs, %init : vector<16xf16>, vector<16xf16>, vector<8xf32>
  // ERROR@+1: TARGET/003 {constraint_key="descriptor_available", subject_name="spirv.op_cooperative_matrix_store_khr.result.f32.16x16.subgroup.storage_buffer"}
  vector.fragment.store<result> %result, %destination[0, 0] shape [%m, %n] : vector<8xf32>, view<16x16xf32>
  kernel.return
}

