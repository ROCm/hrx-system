// RUN: pass target=spirv:vulkan1.3+bda+extended-types target-legalize{mode=final},dce,canonicalize

func.def @scalarizes_unavailable_float_narrowing(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<2xf32>
  %destination = buffer.view %output[%base] : buffer -> view<2xf16>
  %values = vector.load %source[0] : view<2xf32> -> vector<2xf32>
  %result = vector.fptrunc %values : vector<2xf32> to vector<2xf16>
  vector.store %result, %destination[0] : vector<2xf16>, view<2xf16>
  func.return
}

// ----
func.def @scalarizes_unavailable_float_narrowing(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<2xf32>
  %destination = buffer.view %output[%base] : buffer -> view<2xf16>
  %14 = view.load %source[0] : view<2xf32> -> f32
  %15 = view.load %source[1] : view<2xf32> -> f32
  %10 = scalar.fptrunc %14 : f32 to f16
  %12 = scalar.fptrunc %15 : f32 to f16
  view.store %10, %destination[0] : f16, view<2xf16>
  view.store %12, %destination[1] : f16, view<2xf16>
  func.return
}

