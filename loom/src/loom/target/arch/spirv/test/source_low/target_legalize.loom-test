// RUN: pass target-legalize{mode=final}

spirv.target<vulkan1_3> @target

func.def target(@target) @reference_fallback_for_vector_transpose(%first: i32, %second: i32, %third: i32) -> (i32) {
  %source = vector.from_elements %first, %second, %third : vector<3xi32>
  %transposed = vector.transpose<[0]> %source : vector<3xi32> -> vector<3xi32>
  %result = vector.extract %transposed[1] : vector<3xi32> -> i32
  func.return %result : i32
}

// ----
spirv.target<vulkan1_3> @target

func.def target(@target) @reference_fallback_for_vector_transpose(%first: i32, %second: i32, %third: i32) -> (i32) {
  %source = vector.from_elements %first, %second, %third : vector<3xi32>
  %result = vector.extract %source[1] : vector<3xi32> -> i32
  func.return %result : i32
}

// ====

// RUN: with-checks pass target-legalize{mode=final}

// Shared fact-identity lowering accepts every result of a variadic refinement.
spirv.target<vulkan1_3> @target

func.def target(@target) @variadic_buffer_alignment(%first: buffer, %second: buffer) -> (i32) {
  %aligned_first, %aligned_second = buffer.assume.alignment %first, %second {minimum_alignment = 16} : buffer, buffer
  %base = index.constant 0 : offset
  %first_view = buffer.view %aligned_first[%base] : buffer -> view<1xi32>
  %second_view = buffer.view %aligned_second[%base] : buffer -> view<1xi32>
  %left = view.load %first_view[0] : view<1xi32> -> i32
  %right = view.load %second_view[0] : view<1xi32> -> i32
  %sum = scalar.addi %left, %right : i32
  func.return %sum : i32
}

// ----
CHECK: %aligned_first, %aligned_second = buffer.assume.alignment %first, %second {minimum_alignment = 16} : buffer, buffer
CHECK: func.return %sum : i32

// ====
// RUN: pass target=spirv:vulkan1.3+bda+extended-types target-legalize{mode=final},dce,canonicalize

// A table is a transient aggregate, not a native value required by the
// reference lookup decomposition. Its indexed extracts can use packet lanes.
func.def @decomposes_wide_table(%input: buffer, %position: i32) -> (i8) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<5xi8>
  %table = vector.load %source[0] : view<5xi8> -> vector<5xi8>
  %indices = vector.splat %position : vector<1xi32>
  %values = vector.table.lookup %table[%indices] : vector<5xi8>, vector<1xi32> -> vector<1xi8>
  %value = vector.extract %values[0] : vector<1xi8> -> i8
  func.return %value : i8
}

// ----
func.def @decomposes_wide_table(%input: buffer, %position: i32) -> (i8) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<5xi8>
  %12 = view.load %source[0] : view<5xi8> -> i8
  %13 = view.load %source[1] : view<5xi8> -> i8
  %14 = view.load %source[2] : view<5xi8> -> i8
  %15 = view.load %source[3] : view<5xi8> -> i8
  %16 = view.load %source[4] : view<5xi8> -> i8
  %9 = index.cast %position : i32 to index
  %18 = index.constant 1 : index
  %19 = index.cmp eq, %9, %18 : index
  %20 = scf.select %19, %13, %12 : i8
  %21 = index.constant 2 : index
  %22 = index.cmp eq, %9, %21 : index
  %23 = scf.select %22, %14, %20 : i8
  %24 = index.constant 3 : index
  %25 = index.cmp eq, %9, %24 : index
  %26 = scf.select %25, %15, %23 : i8
  %27 = index.constant 4 : index
  %28 = index.cmp eq, %9, %27 : index
  %29 = scf.select %28, %16, %26 : i8
  func.return %29 : i8
}

// ====
// RUN: pass target=spirv:vulkan1.3+bda+extended-types target-legalize{mode=complete},dce,canonicalize

// Quantization owns the same independently sized table boundary as lookup.
func.def @decomposes_wide_thresholds(%value: f32, %floor: f32, %lower: f32, %middle: f32, %upper: f32, %ceiling: f32) -> (i32) {
  %thresholds = vector.from_elements %floor, %lower, %middle, %upper, %ceiling : vector<5xf32>
  %values = vector.splat %value : vector<1xf32>
  %codes = vector.table.quantize %values, %thresholds {nan = max, tie = upper} : vector<1xf32>, vector<5xf32> -> vector<1xi32>
  %code = vector.extract %codes[0] : vector<1xi32> -> i32
  func.return %code : i32
}

// ----
func.def @decomposes_wide_thresholds(%value: f32, %floor: f32, %lower: f32, %middle: f32, %upper: f32, %ceiling: f32) -> (i32) {
  %11 = scalar.constant 0 : i32
  %12 = scalar.cmpf ole, %floor, %value : f32
  %41 = scalar.constant 1 : i32
  %15 = scf.select %12, %41, %11 : i32
  %16 = scalar.cmpf ole, %lower, %value : f32
  %17 = scalar.constant 1 : i32
  %18 = scalar.addi %15, %17 : i32
  %19 = scf.select %16, %18, %15 : i32
  %20 = scalar.cmpf ole, %middle, %value : f32
  %21 = scalar.constant 1 : i32
  %22 = scalar.addi %19, %21 : i32
  %23 = scf.select %20, %22, %19 : i32
  %24 = scalar.cmpf ole, %upper, %value : f32
  %25 = scalar.constant 1 : i32
  %26 = scalar.addi %23, %25 : i32
  %27 = scf.select %24, %26, %23 : i32
  %28 = scalar.cmpf ole, %ceiling, %value : f32
  %29 = scalar.constant 1 : i32
  %30 = scalar.addi %27, %29 : i32
  %31 = scf.select %28, %30, %27 : i32
  %32 = scalar.constant 5 : i32
  %36 = scalar.bitcast %value : f32 to i32
  %37 = scalar.constant 2147483647 : i32
  %38 = scalar.andi %36, %37 : i32
  %39 = scalar.constant 2139095040 : i32
  %40 = scalar.cmpi ugt, %38, %39 : i32
  %34 = scf.select %40, %32, %31 : i32
  func.return %34 : i32
}

// ====

// RUN: pass target=spirv:vulkan1.3+bda+extended-types target-legalize{mode=final},dce,canonicalize

// The reference recipe eliminates the rank-two aggregate before Low typing.
func.def @decomposes_rank_two_divrem(%a: i32, %b: i32, %c: i32, %d: i32, %divisor: i32) -> (i32) {
  %values = vector.from_elements %a, %b, %c, %d : vector<2x2xi32>
  %divisors = vector.splat %divisor : vector<2x2xi32>
  %quotients, %remainders = vector.divremui %values, %divisors : vector<2x2xi32>
  %quotient = vector.extract %quotients[0, 1] : vector<2x2xi32> -> i32
  %remainder = vector.extract %remainders[1, 0] : vector<2x2xi32> -> i32
  %result = scalar.xori %quotient, %remainder : i32
  func.return %result : i32
}

// ----
func.def @decomposes_rank_two_divrem(%a: i32, %b: i32, %c: i32, %d: i32, %divisor: i32) -> (i32) {
  %31 = scalar.divui %b, %divisor : i32
  %28 = scalar.divui %c, %divisor : i32
  %29 = scalar.muli %28, %divisor : i32
  %30 = scalar.subi %c, %29 : i32
  %result = scalar.xori %31, %30 : i32
  func.return %result : i32
}

// ====

// RUN: pass target=spirv:vulkan1.3+bda+extended-types target-legalize{mode=final},dce,canonicalize

// Transpose and axis reduction consume shaped values without a native carrier.
func.def @decomposes_shaped_reduction(%a: i32, %b: i32, %c: i32, %d: i32, %e: i32, %f: i32) -> (i32) {
  %matrix = vector.from_elements %a, %b, %c, %d, %e, %f : vector<2x3xi32>
  %transpose = vector.transpose<[1, 0]> %matrix : vector<2x3xi32> -> vector<3x2xi32>
  %initial = vector.constant 0 : vector<2xi32>
  %rows = vector.reduce.axes<addi> %transpose, %initial axes [0] : vector<3x2xi32>, vector<2xi32>
  %left = vector.extract %rows[0] : vector<2xi32> -> i32
  %right = vector.extract %rows[1] : vector<2xi32> -> i32
  %result = scalar.subi %left, %right : i32
  func.return %result : i32
}

// ----
func.def @decomposes_shaped_reduction(%a: i32, %b: i32, %c: i32, %d: i32, %e: i32, %f: i32) -> (i32) {
  %23 = vector.from_elements %a, %d : vector<2xi32>
  %22 = vector.from_elements %b, %e : vector<2xi32>
  %21 = vector.from_elements %c, %f : vector<2xi32>
  %18 = vector.addi %22, %21 : vector<2xi32>
  %19 = vector.addi %23, %18 : vector<2xi32>
  %left = vector.extract %19[0] : vector<2xi32> -> i32
  %right = vector.extract %19[1] : vector<2xi32> -> i32
  %result = scalar.subi %left, %right : i32
  func.return %result : i32
}
