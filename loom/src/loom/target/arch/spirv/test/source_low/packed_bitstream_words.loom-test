// RUN: pass target=spirv:vulkan1.3+bda+extended-types target-legalize{mode=eager}

// A q3 stream crosses the 32-bit word boundary and ends in a two-byte
// storage packet. Keeping pack and both unpack forms in one chain exercises
// partition facts produced by legalization as well as authored partitions.
func.def @q3_word_boundary(%storage: buffer) -> (i8, i8, i8) {
  %base = index.constant 0 : offset
  %view = buffer.view %storage[%base] : buffer -> view<16xi8>
  %a = vector.load %view[0] : view<16xi8> -> vector<4xi8>
  %b = vector.load %view[4] : view<16xi8> -> vector<4xi8>
  %c = vector.load %view[8] : view<16xi8> -> vector<4xi8>
  %d = vector.load %view[12] : view<16xi8> -> vector<4xi8>
  %input = vector.concat<0> %a, %b, %c, %d : vector<4xi8>, vector<4xi8>, vector<4xi8>, vector<4xi8> -> vector<16xi8>
  %packed = vector.bitpack<3> %input : vector<16xi8> -> vector<6xi8>
  %unsigned = vector.bitunpacku<3> %packed : vector<6xi8> -> vector<16xi8>
  %signed = vector.bitunpacks<3> %packed : vector<6xi8> -> vector<16xi8>
  %packed_tail = vector.extract %packed[5] : vector<6xi8> -> i8
  %unsigned_tail = vector.extract %unsigned[15] : vector<16xi8> -> i8
  %signed_tail = vector.extract %signed[15] : vector<16xi8> -> i8
  func.return %packed_tail, %unsigned_tail, %signed_tail : i8, i8, i8
}

