  %48 = OpLoad.storage_buffer.i32 %47
  %56 = OpConstant.offset64 8
  %57 = OpIAdd.offset64 %35, %56
  %58 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input, %57
  %59 = OpLoad.storage_buffer.i32 %58
  %67 = OpConstant.offset64 12
  %68 = OpIAdd.offset64 %35, %67
  %69 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input, %68
  %70 = OpLoad.storage_buffer.i32 %69
  %78 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output, %35
  OpStore.storage_buffer.i32 %78, %37
  %88 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output, %46
  OpStore.storage_buffer.i32 %88, %48
  %98 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output, %57
  OpStore.storage_buffer.i32 %98, %59
  %108 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output, %68
  OpStore.storage_buffer.i32 %108, %70
  return
}
