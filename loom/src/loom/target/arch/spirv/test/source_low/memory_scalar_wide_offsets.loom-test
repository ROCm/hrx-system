// TEMPLATE: loom/src/loom/test/corpus/source_low/memory_scalar_wide_offsets.loom-test
// RUN: emit source-low target=spirv:vulkan1.3+bda+extended-types output=low control-flow=structured-low

func.def @scalar_wide_byte_offset(%input_storage: buffer, %output_storage: buffer, %byte_offset_input: offset) -> (i32) {
  %input = buffer.assume.alignment %input_storage {minimum_alignment = 4} : buffer
  %output = buffer.assume.alignment %output_storage {minimum_alignment = 4} : buffer
  %byte_offset = index.assume %byte_offset_input [mul(%byte_offset_input, 4)] : offset
  %input_view = buffer.view %input[%byte_offset] : buffer -> view<1xi32>
  %output_view = buffer.view %output[%byte_offset] : buffer -> view<1xi32>
  %loaded = view.load %input_view[0] : view<1xi32> -> i32
  view.store %loaded, %output_view[0] : i32, view<1xi32>
  func.return %loaded : i32
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @scalar_wide_byte_offset(%input: reg<spirv.ptr.storage_buffer>, %output: reg<spirv.ptr.storage_buffer>, %byte_offset: reg<spirv.offset64>) -> (reg<spirv.id : i32>) asm {
  %14 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input, %byte_offset
  %loaded = OpLoad.storage_buffer.i32 %14
  %16 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output, %byte_offset
  OpStore.storage_buffer.i32 %16, %loaded
  return %loaded
}

// ====

func.def @scalar_wide_scaled_index(%input_storage: buffer, %output_storage: buffer, %element_input: index) -> (i32) {
  %input = buffer.assume.alignment %input_storage {minimum_alignment = 4} : buffer
  %output = buffer.assume.alignment %output_storage {minimum_alignment = 4} : buffer
  %element = index.assume %element_input [range(%element_input, 0, 2147483647)] : index
  %element_bytes = index.constant 4 : offset
  %byte_offset = index.scale %element, %element_bytes : index, offset -> offset
  %input_view = buffer.view %input[%byte_offset] : buffer -> view<1xi32>
  %output_view = buffer.view %output[%byte_offset] : buffer -> view<1xi32>
  %loaded = view.load %input_view[0] : view<1xi32> -> i32
  view.store %loaded, %output_view[0] : i32, view<1xi32>
  func.return %loaded : i32
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @scalar_wide_scaled_index(%input: reg<spirv.ptr.storage_buffer>, %output: reg<spirv.ptr.storage_buffer>, %element: reg<spirv.id : index>) -> (reg<spirv.id : i32>) asm {
  %element_bytes = OpConstant.offset64 4
  %17 = OpBitcast.i32.u32 %element
  %18 = OpUConvert.u32.offset64 %17
  %byte_offset = OpIMul.offset64 %18, %element_bytes
  %20 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input, %byte_offset
  %loaded = OpLoad.storage_buffer.i32 %20
  %22 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output, %byte_offset
  OpStore.storage_buffer.i32 %22, %loaded
  return %loaded
}

