low.func.def target<spirv.logical.core> abi(shader_entry_point) @scalar_wide_static_base(%input: reg<spirv.ptr.storage_buffer>, %output: reg<spirv.ptr.storage_buffer>) -> (reg<spirv.id : i32>) asm {
  %12 = OpConstant.offset64 1099511627784
