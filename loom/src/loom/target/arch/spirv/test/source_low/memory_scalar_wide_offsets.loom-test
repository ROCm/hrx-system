low.func.def target<spirv.logical.core> abi(shader_entry_point) @vector_wide_static_base(%input: reg<spirv.ptr.storage_buffer>, %output: reg<spirv.ptr.storage_buffer>) asm {
  %15 = OpConstant.offset64 1099511627792
  %16 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input, %15
  %17 = OpLoad.storage_buffer.i32 %16
  %18 = OpConstant.offset64 1099511627796
  %19 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input, %18
  %20 = OpLoad.storage_buffer.i32 %19
  %21 = OpConstant.offset64 1099511627800
  %22 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input, %21
  %23 = OpLoad.storage_buffer.i32 %22
  %24 = OpConstant.offset64 1099511627804
  %25 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input, %24
  %26 = OpLoad.storage_buffer.i32 %25
  %28 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output, %15
  OpStore.storage_buffer.i32 %28, %17
  %30 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output, %18
  OpStore.storage_buffer.i32 %30, %20
  %32 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output, %21
  OpStore.storage_buffer.i32 %32, %23
  %34 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output, %24
  OpStore.storage_buffer.i32 %34, %26
  return
}

