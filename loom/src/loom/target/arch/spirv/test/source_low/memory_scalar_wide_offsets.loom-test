func.def @vector_wide_static_base(%input_storage: buffer, %output_storage: buffer) {
  %input = buffer.assume.alignment %input_storage {minimum_alignment = 16} : buffer
  %output = buffer.assume.alignment %output_storage {minimum_alignment = 16} : buffer
  %byte_offset = index.constant 1099511627792 : offset
  %input_view = buffer.view %input[%byte_offset] : buffer -> view<4xi32>
  %output_view = buffer.view %output[%byte_offset] : buffer -> view<4xi32>
  %loaded = vector.load %input_view[0] : view<4xi32> -> vector<4xi32>
  vector.store %loaded, %output_view[0] : vector<4xi32>, view<4xi32>
  func.return
}

