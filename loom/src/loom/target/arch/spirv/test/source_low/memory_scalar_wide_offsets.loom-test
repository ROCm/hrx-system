func.def @scalar_wide_mixed_base(%input_storage: buffer, %output_storage: buffer, %byte_offset_input: offset) -> (i32) {
  %input = buffer.assume.alignment %input_storage {minimum_alignment = 4} : buffer
  %output = buffer.assume.alignment %output_storage {minimum_alignment = 4} : buffer
  %byte_offset = index.assume %byte_offset_input [mul(%byte_offset_input, 4)] : offset
  %static_base = index.constant 1099511627784 : offset
  %combined_offset = index.add %byte_offset, %static_base : offset
  %input_view = buffer.view %input[%combined_offset] : buffer -> view<1xi32>
  %output_view = buffer.view %output[%combined_offset] : buffer -> view<1xi32>
  %loaded = view.load %input_view[0] : view<1xi32> -> i32
  view.store %loaded, %output_view[0] : i32, view<1xi32>
  func.return %loaded : i32
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @scalar_wide_mixed_base(%input: reg<spirv.ptr.storage_buffer>, %output: reg<spirv.ptr.storage_buffer>, %byte_offset: reg<spirv.offset64>) -> (reg<spirv.id : i32>) asm {
  %static_base = OpConstant.offset64 1099511627784
  %combined_offset = OpIAdd.offset64 %byte_offset, %static_base
  %18 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input, %combined_offset
  %loaded = OpLoad.storage_buffer.i32 %18
  %20 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output, %combined_offset
  OpStore.storage_buffer.i32 %20, %loaded
  return %loaded
}

