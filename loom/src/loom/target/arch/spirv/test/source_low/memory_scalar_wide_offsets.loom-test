func.def @vector_wide_dynamic_dimensions(%input_storage: buffer, %output_storage: buffer, %row_input: index, %columns_input: index) {
  %input = buffer.assume.alignment %input_storage {minimum_alignment = 16} : buffer
  %output = buffer.assume.alignment %output_storage {minimum_alignment = 16} : buffer
  %row = index.assume %row_input [range(%row_input, 0, 1)] : index
  %columns = index.assume %columns_input [range(%columns_input, 4, 2147483647), mul(%columns_input, 4)] : index
  %buffer_base = index.constant 0 : offset
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<2x[%columns]xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<2x[%columns]xi32>
  %loaded = vector.load %input_view[%row, 0] : view<2x[%columns]xi32> -> vector<4xi32>
  vector.store %loaded, %output_view[%row, 0] : vector<4xi32>, view<2x[%columns]xi32>
  func.return
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @vector_wide_dynamic_dimensions(%input: reg<spirv.ptr.storage_buffer>, %output: reg<spirv.ptr.storage_buffer>, %row: reg<spirv.id : index>, %columns: reg<spirv.id : index>) asm {
  %29 = OpBitcast.i32.u32 %row
  %30 = OpUConvert.u32.offset64 %29
  %31 = OpBitcast.i32.u32 %columns
  %32 = OpUConvert.u32.offset64 %31
  %33 = OpIMul.offset64 %30, %32
  %34 = OpConstant.offset64 4
