func.def @scalar_wide_dynamic_dimensions(%input_storage: buffer, %output_storage: buffer, %row_input: index, %columns_input: index) -> (i32) {
  %input = buffer.assume.alignment %input_storage {minimum_alignment = 4} : buffer
  %output = buffer.assume.alignment %output_storage {minimum_alignment = 4} : buffer
  %row = index.assume %row_input [range(%row_input, 0, 1)] : index
  %columns = index.assume %columns_input [range(%columns_input, 1, 2147483647)] : index
  %buffer_base = index.constant 0 : offset
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<2x[%columns]xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<2x[%columns]xi32>
  %loaded = view.load %input_view[%row, 0] : view<2x[%columns]xi32> -> i32
  view.store %loaded, %output_view[%row, 0] : i32, view<2x[%columns]xi32>
  func.return %loaded : i32
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @scalar_wide_dynamic_dimensions(%input: reg<spirv.ptr.storage_buffer>, %output: reg<spirv.ptr.storage_buffer>, %row: reg<spirv.id : index>, %columns: reg<spirv.id : index>) -> (reg<spirv.id : i32>) asm {
  %18 = OpBitcast.i32.u32 %row
  %19 = OpUConvert.u32.offset64 %18
  %20 = OpBitcast.i32.u32 %columns
  %21 = OpUConvert.u32.offset64 %20
  %22 = OpIMul.offset64 %19, %21
  %23 = OpConstant.offset64 4
  %24 = OpIMul.offset64 %22, %23
  %25 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input, %24
  %loaded = OpLoad.storage_buffer.i32 %25
  %34 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output, %24
  OpStore.storage_buffer.i32 %34, %loaded
  return %loaded
}

