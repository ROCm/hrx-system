// ====

func.def @copy_word_volatile(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<1xbf16>
  %target = buffer.view %output[%base] : buffer -> view<2xbf16>
  %first = view.load<volatile> %source[0] : view<1xbf16> -> bf16
  %second = view.load<volatile> %source[0] : view<1xbf16> -> bf16
  view.store<volatile> %first, %target[0] : bf16, view<2xbf16>
  view.store<volatile> %second, %target[1] : bf16, view<2xbf16>
  func.return
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @copy_word_volatile(%input: reg<spirv.ptr.storage_buffer>, %output: reg<spirv.ptr.storage_buffer>) asm {
  %9 = OpConstant.offset64 0
  %10 = OpPtrAccessChain.storage_buffer.bf16.byte_offset %input, %9
  %first = OpLoad.storage_buffer.bf16<volatile> %10
  %second = OpLoad.storage_buffer.bf16<volatile> %10
  %16 = OpPtrAccessChain.storage_buffer.bf16.byte_offset %output, %9
  OpStore.storage_buffer.bf16<volatile> %16, %first
  %17 = OpConstant.offset64 2
  %18 = OpPtrAccessChain.storage_buffer.bf16.byte_offset %output, %17
  OpStore.storage_buffer.bf16<volatile> %18, %second
  return
}
