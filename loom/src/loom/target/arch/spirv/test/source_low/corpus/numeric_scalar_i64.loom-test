  %cmp = scalar.cmpi slt, %lhs, %rhs : i64
  func.return %cmp : i1
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @scalar_i64_compare_slt_return(%lhs: reg<spirv.id : i64>, %rhs: reg<spirv.id : i64>) -> (reg<spirv.id : i1>) asm {
  %cmp = OpSLessThan.i64 %lhs, %rhs
