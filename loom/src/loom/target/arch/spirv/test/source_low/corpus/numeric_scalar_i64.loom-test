// RUN: emit source-low output=low control-flow=structured-low

spirv.target<vulkan1_3> @target
func.def target(@target) @scalar_i64_bitwise_sgpr(%lhs: i64, %rhs: i64) -> (i64, i64, i64) {
  %and = scalar.andi %lhs, %rhs : i64
  %or = scalar.ori %and, %lhs : i64
  %xor = scalar.xori %or, %rhs : i64
  func.return %and, %or, %xor : i64, i64, i64
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @scalar_i64_bitwise_sgpr(%lhs: reg<spirv.id : i64>, %rhs: reg<spirv.id : i64>) -> (reg<spirv.id : i64>, reg<spirv.id : i64>, reg<spirv.id : i64>) asm {
  %and = OpBitwiseAnd.i64 %lhs, %rhs
  %or = OpBitwiseOr.i64 %and, %lhs
  %xor = OpBitwiseXor.i64 %or, %rhs
  return %and, %or, %xor
}

