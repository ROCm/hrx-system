// ====

spirv.target<vulkan1_3> @target
func.def target(@target) @scalar_i64_compare_slt_if(%lhs: i64, %rhs: i64, %then_value: i32, %else_value: i32) -> (i32) {
  %cmp = scalar.cmpi slt, %lhs, %rhs : i64
  %result = scf.if %cmp -> (i32) {
    scf.yield %then_value : i32
  } else {
    scf.yield %else_value : i32
  }
  func.return %result : i32
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @scalar_i64_compare_slt_if(%lhs: reg<spirv.id : i64>, %rhs: reg<spirv.id : i64>, %then_value: reg<spirv.id : i32>, %else_value: reg<spirv.id : i32>) -> (reg<spirv.id : i32>) asm {
  %cmp = OpSLessThan.i64 %lhs, %rhs
  %result = OpSelect %cmp, %then_value, %else_value
  return %result
}

// ====

spirv.target<vulkan1_3> @target
func.def target(@target) @scalar_i64_compare_constant_select(%lhs: i64, %true_value: f32, %false_value: f32) -> (f32) {
  %limit = scalar.constant 4294967296 : i64
  %cmp = scalar.cmpi ult, %lhs, %limit : i64
  %result = scf.select %cmp, %true_value, %false_value : f32
  func.return %result : f32
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @scalar_i64_compare_constant_select(%lhs: reg<spirv.id : i64>, %true_value: reg<spirv.id : f32>, %false_value: reg<spirv.id : f32>) -> (reg<spirv.id : f32>) asm {
  %limit = OpConstant.i64 4294967296
  %12 = OpBitcast.i64.u64 %lhs
  %13 = OpBitcast.i64.u64 %limit
  %cmp = OpULessThan.u64 %12, %13
  %result = OpSelect.f32 %cmp, %true_value, %false_value
  return %result
}

