// TEMPLATE: loom/src/loom/test/corpus/source_low/memory_scalar_addressing.loom-test
// RUN: emit source-low target=spirv:vulkan1.3+bda output=low control-flow=structured-low

func.def @scalar_static_rank2_i32(%input: buffer, %output: buffer) -> (i32) {
  %input_base = index.constant 8 : offset
  %output_base = index.constant 12 : offset
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %input_view = buffer.view %input_aligned[%input_base] : buffer -> view<2x4xi32>
  %output_view = buffer.view %output_aligned[%output_base] : buffer -> view<2x4xi32>
  %loaded = view.load %input_view[1, 2] : view<2x4xi32> -> i32
  view.store %loaded, %output_view[0, 3] : i32, view<2x4xi32>
  func.return %loaded : i32
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @scalar_static_rank2_i32(%input_aligned: reg<spirv.ptr.storage_buffer>, %output_aligned: reg<spirv.ptr.storage_buffer>) -> (reg<spirv.id : i32>) asm {
  %16 = OpConstant.offset64 32
  %17 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input_aligned, %16
  %loaded = OpLoad.storage_buffer.i32 %17
  %19 = OpConstant.offset64 24
  %20 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output_aligned, %19
  OpStore.storage_buffer.i32 %20, %loaded
  return %loaded
}

