// XFAIL: SPIR-V storage-buffer i16 addressing is unsupported
func.def @scalar_static_rank3_i16(%input: buffer, %output: buffer) -> (i16) {
  %input_base = index.constant 8 : offset
  %output_base = index.constant 12 : offset
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 2} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 2} : buffer
  %input_view = buffer.view %input_aligned[%input_base] : buffer -> view<2x3x4xi16>
  %output_view = buffer.view %output_aligned[%output_base] : buffer -> view<2x3x4xi16>
  %loaded = view.load %input_view[1, 2, 3] : view<2x3x4xi16> -> i16
  view.store %loaded, %output_view[0, 1, 2] : i16, view<2x3x4xi16>
  func.return %loaded : i16
}
