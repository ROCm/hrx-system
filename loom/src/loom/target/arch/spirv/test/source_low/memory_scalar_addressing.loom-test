low.func.def target<spirv.logical.core> abi(shader_entry_point) @scalar_dynamic_index_i32(%input_aligned: reg<spirv.ptr.storage_buffer>, %output_aligned: reg<spirv.ptr.storage_buffer>, %element_bounded: reg<spirv.id : index>) -> (reg<spirv.id : i32>) asm {
  %15 = OpSConvert.i32.offset64 %element_bounded
  %16 = OpConstant.offset64 4
  %17 = OpIMul.offset64 %15, %16
  %18 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input_aligned, %17
  %loaded = OpLoad.storage_buffer.i32 %18
  %23 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output_aligned, %17
  OpStore.storage_buffer.i32 %23, %loaded
  return %loaded
}

