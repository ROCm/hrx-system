func.def @scalar_dynamic_stride_i32(%input: buffer, %output: buffer, %columns: index, %row: index, %column: index) -> (i32) {
  %buffer_base = index.constant 0 : offset
  %columns_bounded = index.assume %columns [range(%columns, 1, 8)] : index
  %row_bounded = index.assume %row [range(%row, 0, 3)] : index
  %column_bounded = index.assume %column [range(%column, 0, 7), lt(%column, %columns_bounded)] : index
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %input_view = buffer.view %input_aligned[%buffer_base] : buffer -> view<4x[%columns_bounded]xi32>
  %output_view = buffer.view %output_aligned[%buffer_base] : buffer -> view<4x[%columns_bounded]xi32>
  %loaded = view.load %input_view[%row_bounded, %column_bounded] : view<4x[%columns_bounded]xi32> -> i32
  view.store %loaded, %output_view[%row_bounded, %column_bounded] : i32, view<4x[%columns_bounded]xi32>
  func.return %loaded : i32
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @scalar_dynamic_stride_i32(%input_aligned: reg<spirv.ptr.storage_buffer>, %output_aligned: reg<spirv.ptr.storage_buffer>, %columns_bounded: reg<spirv.id : index>, %row_bounded: reg<spirv.id : index>, %column_bounded: reg<spirv.id : index>) -> (reg<spirv.id : i32>) asm {
  %21 = OpSConvert.i32.offset64 %row_bounded
  %22 = OpSConvert.i32.offset64 %columns_bounded
  %23 = OpIMul.offset64 %21, %22
  %24 = OpConstant.offset64 4
  %25 = OpIMul.offset64 %23, %24
  %26 = OpSConvert.i32.offset64 %column_bounded
  %28 = OpIMul.offset64 %26, %24
  %29 = OpIAdd.offset64 %25, %28
  %30 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input_aligned, %29
  %loaded = OpLoad.storage_buffer.i32 %30
  %41 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output_aligned, %29
  OpStore.storage_buffer.i32 %41, %loaded
  return %loaded
}

