func.def @scalar_subview_dynamic_index_i32(%input: buffer, %output: buffer, %base: offset, %element: index) -> (i32) {
  %base_aligned = index.assume %base [range(%base, 0, 4064), multiple_of(%base, 4)] : offset
  %element_bounded = index.assume %element [range(%element, 0, 3)] : index
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %input_view = buffer.view %input_aligned[%base_aligned] : buffer -> view<8xi32>
  %output_view = buffer.view %output_aligned[%base_aligned] : buffer -> view<8xi32>
  %input_subview = view.subview %input_view[1] : view<8xi32> -> view<4xi32>
  %output_subview = view.subview %output_view[1] : view<8xi32> -> view<4xi32>
  %input_refined = view.refine %input_subview : view<4xi32> -> view<4xi32>
  %output_refined = view.refine %output_subview : view<4xi32> -> view<4xi32>
  %loaded = view.load %input_refined[%element_bounded] : view<4xi32> -> i32
  view.store %loaded, %output_refined[%element_bounded] : i32, view<4xi32>
  func.return %loaded : i32
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @scalar_subview_dynamic_index_i32(%input_aligned: reg<spirv.ptr.storage_buffer>, %output_aligned: reg<spirv.ptr.storage_buffer>, %base_aligned: reg<spirv.offset64>, %element_bounded: reg<spirv.id : index>) -> (reg<spirv.id : i32>) asm {
  %21 = OpSConvert.i32.offset64 %element_bounded
  %22 = OpConstant.offset64 4
  %23 = OpIMul.offset64 %21, %22
  %24 = OpIAdd.offset64 %base_aligned, %23
  %26 = OpIAdd.offset64 %24, %22
  %27 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input_aligned, %26
  %loaded = OpLoad.storage_buffer.i32 %27
  %35 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output_aligned, %26
  OpStore.storage_buffer.i32 %35, %loaded
  return %loaded
}

