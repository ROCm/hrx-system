low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @subview_dense_rows(%input_aligned: reg<spirv.ptr.storage_buffer>, %output_aligned: reg<spirv.ptr.storage_buffer>) -> (reg<spirv.id : i32>) asm {
  %14 = OpConstant.offset64 80
  %15 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input_aligned, %14
  %value = OpLoad.storage_buffer.i32 %15
  %17 = OpConstant.offset64 84
  %18 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output_aligned, %17
  OpStore.storage_buffer.i32 %18, %value
  return %value
}
