// TEMPLATE: loom/src/loom/test/corpus/source_low/memory_subview.loom-test
// RUN: emit source-low output=low control-flow=structured-low

spirv.target<vulkan1_3> @target

func.def target(@target) @subview_scalar_strided(%input: buffer, %output: buffer) -> (f32) {
  %input_base = index.constant 8 : offset
  %output_base = index.constant 12 : offset
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %layout = encoding.layout.strided [8, 1] : encoding<layout>
  %source = buffer.view %input_aligned[%input_base] : buffer -> view<4x8xf32, %layout>
  %destination = buffer.view %output_aligned[%output_base] : buffer -> view<4x8xf32, %layout>
  %source_crop = view.subview %source[1, 2] : view<4x8xf32, %layout> -> view<2x3xf32, %layout>
  %destination_crop = view.subview %destination[1, 1] : view<4x8xf32, %layout> -> view<2x4xf32, %layout>
  %value = view.load %source_crop[1, 1] : view<2x3xf32, %layout> -> f32
  view.store %value, %destination_crop[1, 2] : f32, view<2x4xf32, %layout>
  func.return %value : f32
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @subview_scalar_strided(%input_aligned: reg<spirv.ptr.storage_buffer>, %output_aligned: reg<spirv.ptr.storage_buffer>) -> (reg<spirv.id : f32>) asm {
  %16 = OpConstant.offset64 84
  %17 = OpPtrAccessChain.storage_buffer.f32.byte_offset %input_aligned, %16
  %value = OpLoad.storage_buffer.f32 %17
  %19 = OpConstant.offset64 88
  %20 = OpPtrAccessChain.storage_buffer.f32.byte_offset %output_aligned, %19
  OpStore.storage_buffer.f32 %20, %value
  return %value
}

