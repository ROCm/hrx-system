spirv.target<vulkan1_3> @target

func.def target(@target) @subview_nested_dynamic(%input: buffer, %output: buffer, %base: offset, %row: index, %column: index) -> (i32) {
  %origin = index.assume %base [range(%base, 4, 16), mul(%base, 4)] : offset
  %row_bounded = index.assume %row [range(%row, 0, 1)] : index
  %column_bounded = index.assume %column [range(%column, 0, 2)] : index
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %layout = encoding.layout.strided [8, 1] : encoding<layout>
  %source = buffer.view %input_aligned[%origin] : buffer -> view<6x8xi32, %layout>
  %destination = buffer.view %output_aligned[%origin] : buffer -> view<6x8xi32, %layout>
  %source_outer = view.subview %source[1, 1] : view<6x8xi32, %layout> -> view<4x6xi32, %layout>
  %source_inner = view.subview %source_outer[1, 2] : view<4x6xi32, %layout> -> view<2x3xi32, %layout>
  %source_refined = view.refine %source_inner : view<2x3xi32, %layout> -> view<2x3xi32, %layout>
  %destination_outer = view.subview %destination[1, 0] : view<6x8xi32, %layout> -> view<4x6xi32, %layout>
  %destination_inner = view.subview %destination_outer[1, 1] : view<4x6xi32, %layout> -> view<2x3xi32, %layout>
  %value = view.load %source_refined[%row_bounded, %column_bounded] : view<2x3xi32, %layout> -> i32
  view.store %value, %destination_inner[%row_bounded, %column_bounded] : i32, view<2x3xi32, %layout>
  func.return %value : i32
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @subview_nested_dynamic(%input_aligned: reg<spirv.ptr.storage_buffer>, %output_aligned: reg<spirv.ptr.storage_buffer>, %origin: reg<spirv.offset64>, %row_bounded: reg<spirv.id : index>, %column_bounded: reg<spirv.id : index>) -> (reg<spirv.id : i32>) asm {
  %26 = OpBitcast.i32.u32 %row_bounded
  %27 = OpUConvert.u32.offset64 %26
  %28 = OpConstant.offset64 32
  %29 = OpIMul.offset64 %27, %28
  %30 = OpIAdd.offset64 %origin, %29
  %31 = OpBitcast.i32.u32 %column_bounded
  %32 = OpUConvert.u32.offset64 %31
  %33 = OpConstant.offset64 4
  %34 = OpIMul.offset64 %32, %33
  %35 = OpIAdd.offset64 %30, %34
  %36 = OpConstant.offset64 76
  %37 = OpIAdd.offset64 %35, %36
  %38 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input_aligned, %37
  %value = OpLoad.storage_buffer.i32 %38
  %50 = OpConstant.offset64 68
  %51 = OpIAdd.offset64 %35, %50
  %52 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output_aligned, %51
  OpStore.storage_buffer.i32 %52, %value
  return %value
}

