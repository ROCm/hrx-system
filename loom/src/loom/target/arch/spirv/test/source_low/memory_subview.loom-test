func.def @subview_atomic_strided(%buffer: buffer) -> (i32) {
  %base = index.constant 8 : offset
  %global = buffer.assume.memory_space<global> %buffer : buffer
  %aligned = buffer.assume.alignment %global {minimum_alignment = 4} : buffer
  %layout = encoding.layout.strided [8, 1] : encoding<layout>
  %view = buffer.view %aligned[%base] : buffer -> view<4x8xi32, %layout>
  %crop = view.subview %view[1, 2] : view<4x8xi32, %layout> -> view<2x3xi32, %layout>
  %increment = scalar.constant 1 : i32
  // ERROR@+1: TARGET/003 {constraint_key="descriptor_available"}
  view.atomic.reduce<addi> %increment, %crop[1, 1] {ordering = relaxed, scope = device} : i32, view<2x3xi32, %layout>
  // ERROR@+1: TARGET/003 {constraint_key="descriptor_available"}
  %old = view.atomic.rmw<addi> %increment, %crop[1, 1] {ordering = relaxed, scope = device} : i32, view<2x3xi32, %layout> -> i32
  %replacement = scalar.constant 99 : i32
  // ERROR@+1: TARGET/003 {constraint_key="descriptor_available"}
  %observed = view.atomic.cmpxchg %old, %replacement, %crop[1, 1] {failure_ordering = relaxed, scope = device, success_ordering = relaxed} : i32, view<2x3xi32, %layout> -> i32
  func.return %observed : i32
}

