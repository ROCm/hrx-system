// RUN: emit source-low target=spirv:vulkan1.3+bda+extended-types output=low

func.def @float_arithmetic_f16(%a: f16, %b: f16) -> (f16, f16) {
  %sum = scalar.addf %a, %b : f16
  %product = scalar.mulf %a, %b : f16
  func.return %sum, %product : f16, f16
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @float_arithmetic_f16(%a: reg<spirv.id : f16>, %b: reg<spirv.id : f16>) -> (reg<spirv.id : f16>, reg<spirv.id : f16>) asm {
  %sum = OpFAdd.f16 %a, %b
  %product = OpFMul.f16 %a, %b
  return %sum, %product
}

// ====

func.def @float_arithmetic_bf16(%a: bf16, %b: bf16) -> (bf16, bf16) {
  %sum = scalar.addf %a, %b : bf16
  %product = scalar.mulf %a, %b : bf16
  func.return %sum, %product : bf16, bf16
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @float_arithmetic_bf16(%a: reg<spirv.id : bf16>, %b: reg<spirv.id : bf16>) -> (reg<spirv.id : bf16>, reg<spirv.id : bf16>) asm {
  %18 = OpFConvert.bf16.f32 %a
  %19 = OpFConvert.bf16.f32 %b
  %20 = OpFAdd.f32 %18, %19
  %21 = OpBitcast.f32.i32 %20 : reg<spirv.id>
  %22 = OpConstant.i32 16 : reg<spirv.id>
  %23 = OpShiftRightLogical %21, %22 : reg<spirv.id>
  %24 = OpConstant.i32 1 : reg<spirv.id>
  %25 = OpBitwiseAnd %23, %24 : reg<spirv.id>
  %26 = OpConstant.i32 32767 : reg<spirv.id>
  %27 = OpIAdd %26, %25 : reg<spirv.id>
  %28 = OpIAdd %21, %27 : reg<spirv.id>
  %29 = OpShiftRightLogical %28, %22 : reg<spirv.id>
  %30 = OpConstant.i32 2147483647 : reg<spirv.id>
  %31 = OpBitwiseAnd %21, %30 : reg<spirv.id>
  %32 = OpConstant.i32 2139095040 : reg<spirv.id>
  %33 = OpSGreaterThan %31, %32 : reg<spirv.id>
  %34 = OpConstant.i32 64 : reg<spirv.id>
  %35 = OpBitwiseOr %23, %34 : reg<spirv.id>
  %36 = OpSelect %33, %35, %29 : reg<spirv.id>
  %37 = OpSConvert.i32.i16 %36 : reg<spirv.id>
  %sum = OpBitcast.i16.bf16 %37
  %39 = OpFMul.f32 %18, %19
  %40 = OpBitcast.f32.i32 %39 : reg<spirv.id>
  %42 = OpShiftRightLogical %40, %22 : reg<spirv.id>
  %44 = OpBitwiseAnd %42, %24 : reg<spirv.id>
  %46 = OpIAdd %26, %44 : reg<spirv.id>
  %47 = OpIAdd %40, %46 : reg<spirv.id>
  %48 = OpShiftRightLogical %47, %22 : reg<spirv.id>
  %50 = OpBitwiseAnd %40, %30 : reg<spirv.id>
  %52 = OpSGreaterThan %50, %32 : reg<spirv.id>
  %54 = OpBitwiseOr %42, %34 : reg<spirv.id>
  %55 = OpSelect %52, %54, %48 : reg<spirv.id>
  %56 = OpSConvert.i32.i16 %55 : reg<spirv.id>
  %product = OpBitcast.i16.bf16 %56
  return %sum, %product
}
