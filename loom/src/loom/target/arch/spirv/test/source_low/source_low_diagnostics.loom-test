// A native vector body representation does not imply a vector argument ABI.
// ERROR@+1: TARGET/031 {actual_type="vector<4xi32>", type_constraint="vector.target_carrier"}
func.def target(@target) @unsupported_vector_argument(%input: vector<4xi32>, %result: i32) -> (i32) {
  func.return %result : i32
}

