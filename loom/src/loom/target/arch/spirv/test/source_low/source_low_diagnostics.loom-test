// ====

spirv.target<vulkan1_3> @hal_target_compact_matrix {abi = hal_kernel, contract_feature_bits = 2318}

kernel.def target(@hal_target_compact_matrix) @cooperative_matrix_accepts_explicit_compact_layout() {
  %unit = index.constant 1 : index
  %subgroup_size = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%subgroup_size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %byte_offset: offset) {
  %byte_offset_aligned = index.assume %byte_offset [multiple_of(%byte_offset, 16)] : offset
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %layout = encoding.layout.strided [16, 1] : encoding<layout>
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 16} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 16} : buffer
  %input_view = buffer.view %input_aligned[%byte_offset_aligned] : buffer -> view<16x16xf32, %layout>
  %output_view = buffer.view %output_aligned[%byte_offset_aligned] : buffer -> view<16x16xf32, %layout>
  %fragment = vector.fragment.load<init> %input_view[0, 0] shape [%m, %n] : view<16x16xf32, %layout> -> vector<8xf32>
  vector.fragment.store<result> %fragment, %output_view[0, 0] shape [%m, %n] : vector<8xf32>, view<16x16xf32, %layout>
  kernel.return
}

// ----
low.kernel.def target<spirv.logical.core>(@hal_target_compact_matrix) abi_layout({signature = (buffer, buffer, offset) -> ()}) workgroup_size(32, 1, 1) workgroup_count(1, 1, 1) @cooperative_matrix_accepts_explicit_compact_layout(%byte_offset_aligned: reg<spirv.offset64>) asm {
  %input_aligned = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %output_aligned = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %17 = OpConstant.offset64 16
  %18 = OpUConvert.offset64.u32 %17
  %19 = OpPtrAccessChain.storage_buffer.f32.byte_offset %input_aligned, %byte_offset_aligned
  %fragment = OpCooperativeMatrixLoadKHR.init.f32.16x16.subgroup.storage_buffer %19, %18, 0 : reg<spirv.id : spirv.cooperative_matrix<16x16xf32, subgroup, matrix_accumulator>>
  %21 = OpConstant.offset64 16
  %22 = OpUConvert.offset64.u32 %21
  %23 = OpPtrAccessChain.storage_buffer.f32.byte_offset %output_aligned, %byte_offset_aligned
  OpCooperativeMatrixStoreKHR.result.f32.16x16.subgroup.storage_buffer %23, %fragment, %22, 0
  return
}

