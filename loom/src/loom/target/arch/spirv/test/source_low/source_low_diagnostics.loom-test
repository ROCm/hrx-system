spirv.target<vulkan1_3> @target

func.def target(@target) @storage_buffer_f16_requires_target_features(%input: buffer, %output: buffer, %byte_offset: offset) {
  %byte_offset_aligned = index.assume %byte_offset [mul(%byte_offset, 2)] : offset
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 2} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 2} : buffer
  %input_view = buffer.view %input_aligned[%byte_offset_aligned] : buffer -> view<1xf16, #dense>
  // ERROR@+1: TARGET/003 {subject_role="descriptor", subject_name="spirv.op_ptr_access_chain.storage_buffer.f16.byte_offset", constraint_key="descriptor_available"}
  %loaded = view.load %input_view[0] : view<1xf16, #dense> -> f16
  %output_view = buffer.view %output_aligned[%byte_offset_aligned] : buffer -> view<1xf16, #dense>
  // ERROR@+1: TARGET/003 {subject_role="descriptor", subject_name="spirv.op_ptr_access_chain.storage_buffer.f16.byte_offset", constraint_key="descriptor_available"}
  view.store %loaded, %output_view[0] : f16, view<1xf16, #dense>
  func.return
}

