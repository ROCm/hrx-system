spirv.target<vulkan1_3> @target

func.def target(@target) @scalar_i64_right_shift_select(%value: i64, %condition: i1) -> (i64, i64, i64, i64, i64) {
  %word_count = scalar.constant 32 : i64
  %sign_count = scalar.constant 63 : i64
  %logical_word = scalar.shrui %value, %word_count : i64
  %signed_word = scalar.shrsi %value, %word_count : i64
  %logical_sign = scalar.shrui %value, %sign_count : i64
  %signed_sign = scalar.shrsi %value, %sign_count : i64
  %selected = scf.select %condition, %logical_word, %signed_word : i64
  func.return %logical_word, %signed_word, %logical_sign, %signed_sign, %selected : i64, i64, i64, i64, i64
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @scalar_i64_right_shift_select(%value: reg<spirv.id : i64>, %condition: reg<spirv.id : i1>) -> (reg<spirv.id : i64>, reg<spirv.id : i64>, reg<spirv.id : i64>, reg<spirv.id : i64>, reg<spirv.id : i64>) asm {
  %word_count = OpConstant.i64 32
  %sign_count = OpConstant.i64 63
  %logical_word = OpShiftRightLogical.i64 %value, %word_count
  %signed_word = OpShiftRightArithmetic.i64 %value, %word_count
  %logical_sign = OpShiftRightLogical.i64 %value, %sign_count
  %signed_sign = OpShiftRightArithmetic.i64 %value, %sign_count
  %selected = OpSelect.i64 %condition, %logical_word, %signed_word
  return %logical_word, %signed_word, %logical_sign, %signed_sign, %selected
}

