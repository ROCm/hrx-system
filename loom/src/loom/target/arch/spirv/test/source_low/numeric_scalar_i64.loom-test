func.def target(@target) @scalar_i32_control(%lhs: i32, %rhs: i32) -> (i32) {
  %product = scalar.muli %lhs, %rhs : i32
  %mixed = scalar.xori %product, %rhs : i32
  %less = scalar.cmpi slt, %lhs, %rhs : i32
  %selected = scf.select %less, %mixed, %product : i32
  func.return %selected : i32
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @scalar_i32_control(%lhs: reg<spirv.id : i32>, %rhs: reg<spirv.id : i32>) -> (reg<spirv.id : i32>) asm {
  %product = OpIMul %lhs, %rhs
  %mixed = OpBitwiseXor %product, %rhs
  %less = OpSLessThan %lhs, %rhs
  %selected = OpSelect %less, %mixed, %product
  return %selected
}

