func.def target(@target) @scalar_i64_compare_constant_select(%lhs: i64, %true_value: f32, %false_value: f32) -> (f32) {
  %limit = scalar.constant 4294967296 : i64
  %cmp = scalar.cmpi ult, %lhs, %limit : i64
  %result = scf.select %cmp, %true_value, %false_value : f32
  func.return %result : f32
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @scalar_i64_compare_constant_select(%lhs: reg<spirv.id : i64>, %true_value: reg<spirv.id : f32>, %false_value: reg<spirv.id : f32>) -> (reg<spirv.id : f32>) asm {
  %limit = OpConstant.i64 4294967296
  %12 = OpBitcast.i64.u64 %lhs
  %13 = OpBitcast.i64.u64 %limit
  %cmp = OpULessThan.u64 %12, %13
  %result = OpSelect.f32 %cmp, %true_value, %false_value
  return %result
}

