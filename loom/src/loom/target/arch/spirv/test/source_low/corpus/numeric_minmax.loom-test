// ====

spirv.target<vulkan1_3> @target {contract_feature_bits = 37374}
func.def target(@target) @index_minmax_sgpr(%lhs0: index, %rhs0: index) -> (index) {
  %lhs = index.assume %lhs0 [range(%lhs0, -1024, 1024)] : index
  %rhs = index.assume %rhs0 [range(%rhs0, -1024, 1024)] : index
  %min = index.min %lhs, %rhs : index
  %max = index.max %lhs, %rhs : index
  %sum = index.add %min, %max : index
  func.return %sum : index
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @index_minmax_sgpr(%lhs: reg<spirv.id : index>, %rhs: reg<spirv.id : index>) -> (reg<spirv.id : index>) asm {
  %11 = OpSLessThan %lhs, %rhs
  %min = OpSelect %11, %lhs, %rhs : reg<spirv.id : index>
  %13 = OpSGreaterThan %lhs, %rhs
  %max = OpSelect %13, %lhs, %rhs : reg<spirv.id : index>
  %sum = OpIAdd %min, %max : reg<spirv.id : index>
  return %sum
}

