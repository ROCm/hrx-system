// ====

// Short vectors preserve their exact span instead of widening the access.
func.def @copy_float8_tail(%input: buffer, %output: buffer) {
  %first = index.constant 1 : offset
  %second = index.constant 3 : offset
  %source_e4m3 = buffer.view %input[%first] : buffer -> view<2xf8E4M3>
  %source_e5m2 = buffer.view %input[%second] : buffer -> view<2xf8E5M2>
  %target_e4m3 = buffer.view %output[%first] : buffer -> view<2xf8E4M3>
  %target_e5m2 = buffer.view %output[%second] : buffer -> view<2xf8E5M2>
  %e4m3 = vector.load %source_e4m3[0] : view<2xf8E4M3> -> vector<2xf8E4M3>
  %e5m2 = vector.load %source_e5m2[0] : view<2xf8E5M2> -> vector<2xf8E5M2>
  vector.store %e4m3, %target_e4m3[0] : vector<2xf8E4M3>, view<2xf8E4M3>
  vector.store %e5m2, %target_e5m2[0] : vector<2xf8E5M2>, view<2xf8E5M2>
  func.return
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @copy_float8_tail(%input: reg<spirv.ptr.storage_buffer>, %output: reg<spirv.ptr.storage_buffer>) asm {
  %22 = OpConstant.offset64 1
  %23 = OpPtrAccessChain.storage_buffer.i8.byte_offset %input, %22
  %24 = OpLoad.storage_buffer.i8 %23
  %25 = OpConstant.offset64 2
  %26 = OpPtrAccessChain.storage_buffer.i8.byte_offset %input, %25
  %27 = OpLoad.storage_buffer.i8 %26
  %28 = OpConstant.offset64 3
  %29 = OpPtrAccessChain.storage_buffer.i8.byte_offset %input, %28
  %30 = OpLoad.storage_buffer.i8 %29
  %31 = OpConstant.offset64 4
  %32 = OpPtrAccessChain.storage_buffer.i8.byte_offset %input, %31
  %33 = OpLoad.storage_buffer.i8 %32
  %35 = OpPtrAccessChain.storage_buffer.i8.byte_offset %output, %22
  OpStore.storage_buffer.i8 %35, %24
  %37 = OpPtrAccessChain.storage_buffer.i8.byte_offset %output, %25
  OpStore.storage_buffer.i8 %37, %27
  %39 = OpPtrAccessChain.storage_buffer.i8.byte_offset %output, %28
  OpStore.storage_buffer.i8 %39, %30
  %41 = OpPtrAccessChain.storage_buffer.i8.byte_offset %output, %31
  OpStore.storage_buffer.i8 %41, %33
  return
}

// ====

// Dynamic origins, subviews and element indices remain byte coordinates.
func.def @copy_float8_index(%input: buffer, %output: buffer, %byte_offset: offset, %element: index) {
  %base = index.assume %byte_offset [range(%byte_offset, 0, 128)] : offset
  %position = index.assume %element [range(%element, 0, 15)] : index
  %source_e4m3 = buffer.view %input[%base] : buffer -> view<32xf8E4M3>
  %source_e5m2 = buffer.view %input[%base] : buffer -> view<32xf8E5M2>
  %target_e4m3 = buffer.view %output[%base] : buffer -> view<32xf8E4M3>
  %target_e5m2 = buffer.view %output[%base] : buffer -> view<32xf8E5M2>
  %source_tail = view.subview %source_e5m2[16] : view<32xf8E5M2> -> view<16xf8E5M2>
  %target_tail = view.subview %target_e5m2[16] : view<32xf8E5M2> -> view<16xf8E5M2>
  %e4m3 = view.load %source_e4m3[%position] : view<32xf8E4M3> -> f8E4M3
  %e5m2 = view.load %source_tail[%position] : view<16xf8E5M2> -> f8E5M2
  view.store %e4m3, %target_e4m3[%position] : f8E4M3, view<32xf8E4M3>
  view.store %e5m2, %target_tail[%position] : f8E5M2, view<16xf8E5M2>
  func.return
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @copy_float8_index(%input: reg<spirv.ptr.storage_buffer>, %output: reg<spirv.ptr.storage_buffer>, %base: reg<spirv.offset64>, %position: reg<spirv.id : index>) asm {
  %18 = OpSConvert.i32.offset64 %position
  %19 = OpIAdd.offset64 %base, %18
  %20 = OpPtrAccessChain.storage_buffer.i8.byte_offset %input, %19
  %e4m3 = OpLoad.storage_buffer.i8 %20
  %24 = OpConstant.offset64 16
  %25 = OpIAdd.offset64 %19, %24
  %26 = OpPtrAccessChain.storage_buffer.i8.byte_offset %input, %25
  %e5m2 = OpLoad.storage_buffer.i8 %26
  %30 = OpPtrAccessChain.storage_buffer.i8.byte_offset %output, %19
  OpStore.storage_buffer.i8 %30, %e4m3
  %35 = OpPtrAccessChain.storage_buffer.i8.byte_offset %output, %25
  OpStore.storage_buffer.i8 %35, %e5m2
  return
}

// ====

// Volatile accesses retain both observations even when their addresses match.
func.def @copy_float8_volatile(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<1xf8E4M3>
  %target = buffer.view %output[%base] : buffer -> view<2xf8E4M3>
  %first = view.load<volatile> %source[0] : view<1xf8E4M3> -> f8E4M3
  %second = view.load<volatile> %source[0] : view<1xf8E4M3> -> f8E4M3
  view.store<volatile> %first, %target[0] : f8E4M3, view<2xf8E4M3>
  view.store<volatile> %second, %target[1] : f8E4M3, view<2xf8E4M3>
  func.return
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @copy_float8_volatile(%input: reg<spirv.ptr.storage_buffer>, %output: reg<spirv.ptr.storage_buffer>) asm {
  %9 = OpConstant.offset64 0
  %10 = OpPtrAccessChain.storage_buffer.i8.byte_offset %input, %9
  %first = OpLoad.storage_buffer.i8<volatile> %10
  %second = OpLoad.storage_buffer.i8<volatile> %10
  %16 = OpPtrAccessChain.storage_buffer.i8.byte_offset %output, %9
  OpStore.storage_buffer.i8<volatile> %16, %first
  %17 = OpConstant.offset64 1
  %18 = OpPtrAccessChain.storage_buffer.i8.byte_offset %output, %17
  OpStore.storage_buffer.i8<volatile> %18, %second
  return
}

// ====

func.def @extend_float8(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source_e4m3 = buffer.view %input[%base] : buffer -> view<1xf8E4M3>
  %source_e5m2 = buffer.view %input[%base] : buffer -> view<1xf8E5M2>
  %target = buffer.view %output[%base] : buffer -> view<2xf32>
  %e4m3 = view.load %source_e4m3[0] : view<1xf8E4M3> -> f8E4M3
  %e5m2 = view.load %source_e5m2[0] : view<1xf8E5M2> -> f8E5M2
  %first = scalar.extf %e4m3 : f8E4M3 to f32
  %second = scalar.extf %e5m2 : f8E5M2 to f32
  view.store %first, %target[0] : f32, view<2xf32>
  view.store %second, %target[1] : f32, view<2xf32>
  func.return
}

