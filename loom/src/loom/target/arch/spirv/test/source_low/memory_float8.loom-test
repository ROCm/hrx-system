  %218 = OpSelect %214, %217, %212
  %second = OpBitcast.i32.f32 %218
  %221 = OpPtrAccessChain.storage_buffer.f32.byte_offset %output, %125
  OpStore.storage_buffer.f32 %221, %first
  %222 = OpConstant.offset64 4
  %223 = OpPtrAccessChain.storage_buffer.f32.byte_offset %output, %222
  OpStore.storage_buffer.f32 %223, %second
  return
}
