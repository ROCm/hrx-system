  %68 = OpVectorInsertDynamic.i64.v4i64 %66, %value, %67
  %69 = OpCompositeConstruct.v4bool %62, %62, %62, %62
  %70 = OpSelect.v4i64 %69, %68, %66
  %71 = OpCompositeExtract.v4i64.i64 %70, 0
  %72 = OpCompositeExtract.v4i64.i64 %70, 1
  %73 = OpCompositeExtract.v4i64.i64 %70, 2
  %74 = OpCompositeExtract.v4i64.i64 %70, 3
  %76 = OpPtrAccessChain.storage_buffer.i64.byte_offset %output, %43
  OpStore.storage_buffer.i64 %76, %71
  %78 = OpPtrAccessChain.storage_buffer.i64.byte_offset %output, %46
  OpStore.storage_buffer.i64 %78, %72
  %80 = OpPtrAccessChain.storage_buffer.i64.byte_offset %output, %49
