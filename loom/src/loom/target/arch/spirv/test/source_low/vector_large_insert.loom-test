  %64 = OpULessThan.u32 %62, %63
  %67 = OpUGreaterThanEqual.u32 %62, %63
  %68 = OpCompositeConstruct.v4i64 %47, %50, %53, %56
  %69 = OpSelect %64, %position, %60 : reg<spirv.id : index>
  %70 = OpVectorInsertDynamic.i64.v4i64 %68, %value, %69
  %71 = OpCompositeConstruct.v4bool %64, %64, %64, %64
  %72 = OpSelect.v4i64 %71, %70, %68
  %73 = OpSelect.i64 %67, %value, %59
  %74 = OpCompositeExtract.v4i64.i64 %72, 0
  %75 = OpCompositeExtract.v4i64.i64 %72, 1
  %76 = OpCompositeExtract.v4i64.i64 %72, 2
  %77 = OpCompositeExtract.v4i64.i64 %72, 3
  %79 = OpPtrAccessChain.storage_buffer.i64.byte_offset %output, %45
  OpStore.storage_buffer.i64 %79, %74
  %81 = OpPtrAccessChain.storage_buffer.i64.byte_offset %output, %48
  OpStore.storage_buffer.i64 %81, %75
  %83 = OpPtrAccessChain.storage_buffer.i64.byte_offset %output, %51
  OpStore.storage_buffer.i64 %83, %76
  %85 = OpPtrAccessChain.storage_buffer.i64.byte_offset %output, %54
  OpStore.storage_buffer.i64 %85, %77
  %87 = OpPtrAccessChain.storage_buffer.i64.byte_offset %output, %57
