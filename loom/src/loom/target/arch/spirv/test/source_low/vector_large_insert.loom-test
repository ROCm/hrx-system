  %52 = OpPtrAccessChain.storage_buffer.i64.byte_offset %input, %51
  %53 = OpLoad.storage_buffer.i64 %52
  %54 = OpConstant.offset64 24
  %55 = OpPtrAccessChain.storage_buffer.i64.byte_offset %input, %54
  %56 = OpLoad.storage_buffer.i64 %55
  %57 = OpConstant.offset64 32
  %58 = OpPtrAccessChain.storage_buffer.i64.byte_offset %input, %57
  %59 = OpLoad.storage_buffer.i64 %58
  %60 = OpConstant.i32 0 : reg<spirv.id : index>
  %61 = OpConstant.i32 4 : reg<spirv.id : index>
  %62 = OpBitcast.i32.u32 %position
