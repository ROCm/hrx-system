// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @insert_dynamic(%input: reg<spirv.ptr.storage_buffer>, %output: reg<spirv.ptr.storage_buffer>, %value: reg<spirv.id : i64>, %position: reg<spirv.id : index>) where [range(%position, 0, 4)] asm {
  %56 = OpConstant.offset64 0
  %57 = OpPtrAccessChain.storage_buffer.i64.byte_offset %input, %56
  %58 = OpLoad.storage_buffer.i64 %57
  %59 = OpConstant.offset64 8
  %60 = OpPtrAccessChain.storage_buffer.i64.byte_offset %input, %59
  %61 = OpLoad.storage_buffer.i64 %60
  %62 = OpConstant.offset64 16
  %63 = OpPtrAccessChain.storage_buffer.i64.byte_offset %input, %62
  %64 = OpLoad.storage_buffer.i64 %63
  %65 = OpConstant.offset64 24
  %66 = OpPtrAccessChain.storage_buffer.i64.byte_offset %input, %65
  %67 = OpLoad.storage_buffer.i64 %66
  %68 = OpConstant.offset64 32
  %69 = OpPtrAccessChain.storage_buffer.i64.byte_offset %input, %68
  %70 = OpLoad.storage_buffer.i64 %69
  %71 = OpConstant.i32 0 : reg<spirv.id : index>
  %72 = OpConstant.i32 4 : reg<spirv.id : index>
  %73 = OpBitcast.i32.u32 %position
  %74 = OpBitcast.i32.u32 %72
  %75 = OpULessThan.u32 %73, %74
  %78 = OpUGreaterThanEqual.u32 %73, %74
  %79 = OpSelect %75, %position, %71 : reg<spirv.id : index>
  %80 = OpIEqual %71, %79
  %81 = OpSelect.i64 %80, %value, %58
  %82 = OpSelect.i64 %75, %81, %58
  %83 = OpConstant.i32 1 : reg<spirv.id : index>
  %84 = OpIEqual %83, %79
  %85 = OpSelect.i64 %84, %value, %61
  %86 = OpSelect.i64 %75, %85, %61
  %87 = OpConstant.i32 2 : reg<spirv.id : index>
  %88 = OpIEqual %87, %79
  %89 = OpSelect.i64 %88, %value, %64
  %90 = OpSelect.i64 %75, %89, %64
  %91 = OpConstant.i32 3 : reg<spirv.id : index>
  %92 = OpIEqual %91, %79
  %93 = OpSelect.i64 %92, %value, %67
  %94 = OpSelect.i64 %75, %93, %67
  %95 = OpSelect.i64 %78, %value, %70
  %97 = OpPtrAccessChain.storage_buffer.i64.byte_offset %output, %56
  OpStore.storage_buffer.i64 %97, %82
  %99 = OpPtrAccessChain.storage_buffer.i64.byte_offset %output, %59
  OpStore.storage_buffer.i64 %99, %86
  %101 = OpPtrAccessChain.storage_buffer.i64.byte_offset %output, %62
  OpStore.storage_buffer.i64 %101, %90
  %103 = OpPtrAccessChain.storage_buffer.i64.byte_offset %output, %65
  OpStore.storage_buffer.i64 %103, %94
  %105 = OpPtrAccessChain.storage_buffer.i64.byte_offset %output, %68
  OpStore.storage_buffer.i64 %105, %95
  return
}
