  %55 = OpLoad.storage_buffer.i64 %54
  %56 = OpConstant.offset64 24
  %57 = OpPtrAccessChain.storage_buffer.i64.byte_offset %input, %56
  %58 = OpLoad.storage_buffer.i64 %57
  %59 = OpConstant.offset64 32
  %60 = OpPtrAccessChain.storage_buffer.i64.byte_offset %input, %59
  %61 = OpLoad.storage_buffer.i64 %60
  %62 = OpConstant.i32 0 : reg<spirv.id : index>
  %63 = OpConstant.i32 4 : reg<spirv.id : index>
