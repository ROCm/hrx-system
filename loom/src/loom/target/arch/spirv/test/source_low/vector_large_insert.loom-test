spirv.target<vulkan1_3> @target

func.def target(@target) @insert_tail(%input: buffer, %output: buffer, %value: i32) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<5xi32>
  %destination = buffer.view %output[%base] : buffer -> view<5xi32>
  %values = vector.load %source[0] : view<5xi32> -> vector<5xi32>
  %result = vector.insert %value into %values[4] : i32, vector<5xi32>
  vector.store %result, %destination[0] : vector<5xi32>, view<5xi32>
  func.return
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @insert_tail(%input: reg<spirv.ptr.storage_buffer>, %output: reg<spirv.ptr.storage_buffer>, %value: reg<spirv.id : i32>) asm {
  %21 = OpConstant.offset64 0
  %22 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input, %21
  %23 = OpLoad.storage_buffer.i32 %22
  %24 = OpConstant.offset64 4
  %25 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input, %24
  %26 = OpLoad.storage_buffer.i32 %25
  %27 = OpConstant.offset64 8
  %28 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input, %27
  %29 = OpLoad.storage_buffer.i32 %28
  %30 = OpConstant.offset64 12
  %31 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input, %30
  %32 = OpLoad.storage_buffer.i32 %31
  %34 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output, %21
  OpStore.storage_buffer.i32 %34, %23
  %36 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output, %24
  OpStore.storage_buffer.i32 %36, %26
  %38 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output, %27
  OpStore.storage_buffer.i32 %38, %29
  %40 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output, %30
  OpStore.storage_buffer.i32 %40, %32
  %41 = OpConstant.offset64 16
  %42 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output, %41
  OpStore.storage_buffer.i32 %42, %value
  return
}

