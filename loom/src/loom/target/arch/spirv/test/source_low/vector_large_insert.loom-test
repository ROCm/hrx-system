spirv.target<vulkan1_3> @target

func.def target(@target) @insert_tail(%input: buffer, %output: buffer, %value: i32) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<5xi32>
  %destination = buffer.view %output[%base] : buffer -> view<5xi32>
  %values = vector.load %source[0] : view<5xi32> -> vector<5xi32>
  %result = vector.insert %value into %values[4] : i32, vector<5xi32>
  vector.store %result, %destination[0] : vector<5xi32>, view<5xi32>
  func.return
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @insert_tail(%input: reg<spirv.ptr.storage_buffer>, %output: reg<spirv.ptr.storage_buffer>, %value: reg<spirv.id : i32>) asm {
  %45 = OpConstant.offset64 0
  %46 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input, %45
  %47 = OpLoad.storage_buffer.i32 %46
  %48 = OpConstant.offset64 4
  %49 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input, %48
  %50 = OpLoad.storage_buffer.i32 %49
  %51 = OpConstant.offset64 8
  %52 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input, %51
  %53 = OpLoad.storage_buffer.i32 %52
  %54 = OpConstant.offset64 12
  %55 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input, %54
  %56 = OpLoad.storage_buffer.i32 %55
  %58 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output, %45
  OpStore.storage_buffer.i32 %58, %47
  %60 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output, %48
  OpStore.storage_buffer.i32 %60, %50
  %62 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output, %51
  OpStore.storage_buffer.i32 %62, %53
  %64 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output, %54
  OpStore.storage_buffer.i32 %64, %56
  %65 = OpConstant.offset64 16
  %66 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output, %65
  OpStore.storage_buffer.i32 %66, %value
  return
}

