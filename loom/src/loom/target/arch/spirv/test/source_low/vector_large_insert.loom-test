// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @insert_dynamic(%input: reg<spirv.ptr.storage_buffer>, %output: reg<spirv.ptr.storage_buffer>, %value: reg<spirv.id : i64>, %position: reg<spirv.id : index>) where [range(%position, 0, 4)] asm {
  %80 = OpConstant.offset64 0
  %81 = OpPtrAccessChain.storage_buffer.i64.byte_offset %input, %80
  %82 = OpLoad.storage_buffer.i64 %81
  %83 = OpConstant.offset64 8
  %84 = OpPtrAccessChain.storage_buffer.i64.byte_offset %input, %83
  %85 = OpLoad.storage_buffer.i64 %84
  %86 = OpConstant.offset64 16
  %87 = OpPtrAccessChain.storage_buffer.i64.byte_offset %input, %86
  %88 = OpLoad.storage_buffer.i64 %87
  %89 = OpConstant.offset64 24
  %90 = OpPtrAccessChain.storage_buffer.i64.byte_offset %input, %89
  %91 = OpLoad.storage_buffer.i64 %90
  %92 = OpConstant.offset64 32
  %93 = OpPtrAccessChain.storage_buffer.i64.byte_offset %input, %92
  %94 = OpLoad.storage_buffer.i64 %93
  %95 = OpConstant.i32 0 : reg<spirv.id : index>
  %96 = OpConstant.i32 4 : reg<spirv.id : index>
  %97 = OpBitcast.i32.u32 %position
  %98 = OpBitcast.i32.u32 %96
  %99 = OpULessThan.u32 %97, %98
  %102 = OpUGreaterThanEqual.u32 %97, %98
  %103 = OpSelect %99, %position, %95 : reg<spirv.id : index>
  %104 = OpIEqual %95, %103
  %105 = OpSelect.i64 %104, %value, %82
  %106 = OpSelect.i64 %99, %105, %82
  %107 = OpConstant.i32 1 : reg<spirv.id : index>
  %108 = OpIEqual %107, %103
  %109 = OpSelect.i64 %108, %value, %85
  %110 = OpSelect.i64 %99, %109, %85
  %111 = OpConstant.i32 2 : reg<spirv.id : index>
  %112 = OpIEqual %111, %103
  %113 = OpSelect.i64 %112, %value, %88
  %114 = OpSelect.i64 %99, %113, %88
  %115 = OpConstant.i32 3 : reg<spirv.id : index>
  %116 = OpIEqual %115, %103
  %117 = OpSelect.i64 %116, %value, %91
  %118 = OpSelect.i64 %99, %117, %91
  %119 = OpSelect.i64 %102, %value, %94
  %121 = OpPtrAccessChain.storage_buffer.i64.byte_offset %output, %80
  OpStore.storage_buffer.i64 %121, %106
  %123 = OpPtrAccessChain.storage_buffer.i64.byte_offset %output, %83
  OpStore.storage_buffer.i64 %123, %110
  %125 = OpPtrAccessChain.storage_buffer.i64.byte_offset %output, %86
  OpStore.storage_buffer.i64 %125, %114
  %127 = OpPtrAccessChain.storage_buffer.i64.byte_offset %output, %89
  OpStore.storage_buffer.i64 %127, %118
  %129 = OpPtrAccessChain.storage_buffer.i64.byte_offset %output, %92
  OpStore.storage_buffer.i64 %129, %119
  return
}
