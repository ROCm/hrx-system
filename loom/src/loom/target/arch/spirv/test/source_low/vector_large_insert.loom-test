  %72 = OpVectorInsertDynamic.i64.v4i64 %70, %value, %71
  %73 = OpCompositeConstruct.v4bool %66, %66, %66, %66
  %74 = OpSelect.v4i64 %73, %72, %70
  %75 = OpSelect.i64 %69, %value, %61
  %76 = OpCompositeExtract.v4i64.i64 %74, 0
  %77 = OpCompositeExtract.v4i64.i64 %74, 1
  %78 = OpCompositeExtract.v4i64.i64 %74, 2
  %79 = OpCompositeExtract.v4i64.i64 %74, 3
  %81 = OpPtrAccessChain.storage_buffer.i64.byte_offset %output, %47
  OpStore.storage_buffer.i64 %81, %76
  %83 = OpPtrAccessChain.storage_buffer.i64.byte_offset %output, %50
  OpStore.storage_buffer.i64 %83, %77
  %85 = OpPtrAccessChain.storage_buffer.i64.byte_offset %output, %53
  OpStore.storage_buffer.i64 %85, %78
  %87 = OpPtrAccessChain.storage_buffer.i64.byte_offset %output, %56
  OpStore.storage_buffer.i64 %87, %79
