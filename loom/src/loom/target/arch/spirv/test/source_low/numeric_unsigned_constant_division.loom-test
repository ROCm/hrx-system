spirv.target<vulkan1_3> @target

func.def target(@target) @pair_by_power_of_two(%input: i32) -> (i32, i32) {
  %divisor = scalar.constant 16 : i32
  %quotient = scalar.divui %input, %divisor : i32
  %remainder = scalar.remui %input, %divisor : i32
  func.return %quotient, %remainder : i32, i32
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @pair_by_power_of_two(%input: reg<spirv.id : i32>) -> (reg<spirv.id : i32>, reg<spirv.id : i32>) asm {
  %13 = OpConstant.i32 4
  %quotient = OpShiftRightLogical %input, %13
  %15 = OpConstant.i32 15
  %remainder = OpBitwiseAnd %input, %15
  return %quotient, %remainder
}

