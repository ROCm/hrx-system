  %divisor = OpConstant.i32 20 : reg<spirv.id : index>
  %11 = OpBitcast.i32.u32 %bounded
  %12 = OpBitcast.i32.u32 %divisor
  %13 = OpUDiv.u32 %11, %12
  %quotient = OpBitcast.u32.i32 %13 : reg<spirv.id : index>
  %17 = OpUMod.u32 %11, %12
  %remainder = OpBitcast.u32.i32 %17 : reg<spirv.id : index>
  return %quotient, %remainder
}
