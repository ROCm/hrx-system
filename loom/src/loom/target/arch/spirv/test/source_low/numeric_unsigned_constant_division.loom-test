// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_unsigned_constant_division.loom-test
// RUN: emit source-low output=low control-flow=structured-low

spirv.target<vulkan1_3> @target

func.def target(@target) @quotient_by_three(%input: i32) -> (i32) {
  %divisor = scalar.constant 3 : i32
  %quotient = scalar.divui %input, %divisor : i32
  func.return %quotient : i32
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @quotient_by_three(%input: reg<spirv.id : i32>) -> (reg<spirv.id : i32>) asm {
  %divisor = OpConstant.i32 3
  %7 = OpBitcast.i32.u32 %input
  %8 = OpBitcast.i32.u32 %divisor
  %9 = OpUDiv.u32 %7, %8
  %quotient = OpBitcast.u32.i32 %9
  return %quotient
}

