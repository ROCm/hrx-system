// ====

spirv.target<vulkan1_3> @target

func.def target(@target) @index_pair_by_7(%input: index) -> (index, index) {
  %bounded = index.assume %input [range(%input, 0, 4294967295)] : index
  %divisor = index.constant 7 : index
  %quotient = index.div %bounded, %divisor : index
  %remainder = index.rem %bounded, %divisor : index
  func.return %quotient, %remainder : index, index
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @index_pair_by_7(%bounded: reg<spirv.id : index>) -> (reg<spirv.id : index>, reg<spirv.id : index>) asm {
  %divisor = OpConstant.i32 7 : reg<spirv.id : index>
  %11 = OpBitcast.i32.u32 %bounded
  %12 = OpBitcast.i32.u32 %divisor
  %13 = OpUDiv.u32 %11, %12
  %quotient = OpBitcast.u32.i32 %13 : reg<spirv.id : index>
  %17 = OpUMod.u32 %11, %12
  %remainder = OpBitcast.u32.i32 %17 : reg<spirv.id : index>
  return %quotient, %remainder
}

// ====

