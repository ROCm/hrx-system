kernel.def target(@target) @index_shli_previous_row_global_b128() {
  %unit = index.constant 1 : index
  %active_lanes = index.constant 31 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%active_lanes, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %base_offset = index.constant 0 : offset
  %column_offset = index.constant 1 : index
  %column = index.add %lane, %column_offset : index
  %previous = index.sub %column, %column_offset : index
  %shift = index.constant 2 : index
  %linear = index.shli %previous, %shift : index
  %input_view = buffer.view %input[%base_offset] : buffer -> view<128xi32>
  %output_view = buffer.view %output[%base_offset] : buffer -> view<128xi32>
  %loaded = vector.load %input_view[%linear] : view<128xi32> -> vector<4xi32>
  vector.store %loaded, %output_view[%linear] : vector<4xi32>, view<128xi32>
  kernel.return
}

