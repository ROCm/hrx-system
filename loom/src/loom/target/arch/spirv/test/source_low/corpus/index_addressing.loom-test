// XFAIL: SPIR-V ordinary vector memory lowering is unsupported
spirv.target<vulkan1_3> @target

kernel.def target(@target) @index_madd_global_b32() {
  %unit = index.constant 1 : index
  %tile = index.constant 4 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%tile, %tile, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %column = kernel.workitem.id<x> : index
  %row = kernel.workitem.id<y> : index
  %buffer_base = index.constant 0 : offset
  %row_stride = index.constant 4 : index
  %linear = index.madd %row, %row_stride, %column : index
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<16xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<16xi32>
  %loaded = vector.load %input_view[%linear] : view<16xi32> -> vector<1xi32>
  vector.store %loaded, %output_view[%linear] : vector<1xi32>, view<16xi32>
  kernel.return
}

