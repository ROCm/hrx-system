// RUN: emit source-low output=low control-flow=structured-low

spirv.target<vulkan1_3> @hal_target_coop_f16 {abi = hal_kernel, contract_feature_bits = 2318}

kernel.def target(@hal_target_coop_f16) @spirv_hal_cooperative_matrix_f16() {
  %unit = index.constant 1 : index
  %subgroup_size = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%subgroup_size, %unit, %unit) : index
} launch(%lhs_buffer: buffer, %rhs_buffer: buffer, %init_buffer: buffer, %out_buffer: buffer, %byte_offset: offset) {
  %byte_offset_aligned = index.assume %byte_offset [multiple_of(%byte_offset, 16)] : offset
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %lhs_aligned = buffer.assume.alignment %lhs_buffer {minimum_alignment = 16} : buffer
  %rhs_aligned = buffer.assume.alignment %rhs_buffer {minimum_alignment = 16} : buffer
  %init_aligned = buffer.assume.alignment %init_buffer {minimum_alignment = 16} : buffer
  %out_aligned = buffer.assume.alignment %out_buffer {minimum_alignment = 16} : buffer
  %lhs_view = buffer.view %lhs_aligned[%byte_offset_aligned] : buffer -> view<16x16xf16>
  %rhs_view = buffer.view %rhs_aligned[%byte_offset_aligned] : buffer -> view<16x16xf16>
  %init_view = buffer.view %init_aligned[%byte_offset_aligned] : buffer -> view<16x16xf32>
  %out_view = buffer.view %out_aligned[%byte_offset_aligned] : buffer -> view<16x16xf32>
  %lhs = vector.fragment.load<lhs> %lhs_view[0, 0] shape [%m, %k] : view<16x16xf16> -> vector<16xf16>
  %rhs = vector.fragment.load<rhs> %rhs_view[0, 0] shape [%k, %n] : view<16x16xf16> -> vector<16xf16>
  %init = vector.fragment.load<init> %init_view[0, 0] shape [%m, %n] : view<16x16xf32> -> vector<8xf32>
  %result = vector.mma %lhs, %rhs, %init : vector<16xf16>, vector<16xf16>, vector<8xf32>
  vector.fragment.store<result> %result, %out_view[0, 0] shape [%m, %n] : vector<8xf32>, view<16x16xf32>
  kernel.return
}

kernel.def target(@hal_target_coop_f16) @spirv_hal_cooperative_matrix_f16_loop() {
  %unit = index.constant 1 : index
  %subgroup_size = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%subgroup_size, %unit, %unit) : index
} launch(%lhs_buffer: buffer, %rhs_buffer: buffer, %init_buffer: buffer, %out_buffer: buffer, %byte_offset: offset, %iteration_count: index) {
  %byte_offset_aligned = index.assume %byte_offset [multiple_of(%byte_offset, 16)] : offset
  %loop_begin = index.constant 0 : index
  %loop_step = index.constant 1 : index
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %lhs_aligned = buffer.assume.alignment %lhs_buffer {minimum_alignment = 16} : buffer
  %rhs_aligned = buffer.assume.alignment %rhs_buffer {minimum_alignment = 16} : buffer
  %init_aligned = buffer.assume.alignment %init_buffer {minimum_alignment = 16} : buffer
  %out_aligned = buffer.assume.alignment %out_buffer {minimum_alignment = 16} : buffer
  %lhs_view = buffer.view %lhs_aligned[%byte_offset_aligned] : buffer -> view<16x16xf16>
  %rhs_view = buffer.view %rhs_aligned[%byte_offset_aligned] : buffer -> view<16x16xf16>
  %init_view = buffer.view %init_aligned[%byte_offset_aligned] : buffer -> view<16x16xf32>
  %out_view = buffer.view %out_aligned[%byte_offset_aligned] : buffer -> view<16x16xf32>
  %lhs = vector.fragment.load<lhs> %lhs_view[0, 0] shape [%m, %k] : view<16x16xf16> -> vector<4xf16>
  %rhs = vector.fragment.load<rhs> %rhs_view[0, 0] shape [%k, %n] : view<16x16xf16> -> vector<4xf16>
  %init = vector.fragment.load<init> %init_view[0, 0] shape [%m, %n] : view<16x16xf32> -> vector<1xf32>
  %result = scf.for %iteration = [%loop_begin to %iteration_count step %loop_step](%accumulator = %init : vector<1xf32>) -> (vector<1xf32>) {
    %next = vector.mma %lhs, %rhs, %accumulator : vector<4xf16>, vector<4xf16>, vector<1xf32>
    scf.yield %next : vector<1xf32>
  }
  vector.fragment.store<result> %result, %out_view[0, 0] shape [%m, %n] : vector<1xf32>, view<16x16xf32>
  kernel.return
}

kernel.def target(@hal_target_coop_f16) @cooperative_matrix_strided_workgroup_transfer() {
  %unit = index.constant 1 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %row_stride0: index, %tile_origin0: index) {
  %row_stride = index.assume %row_stride0 [range(%row_stride0, 16, 4096), multiple_of(%row_stride0, 4)] : index
  %tile_origin = index.assume %tile_origin0 [range(%tile_origin0, 0, 16), multiple_of(%tile_origin0, 16)] : index
  %base_offset = index.constant 0 : offset
  %output_row = index.constant 0 : index
  %tile = index.constant 16 : index
  %scratch_bytes = index.constant 5120 : offset
  %row_layout = encoding.layout.strided [%row_stride, 1] : encoding<layout>
  %column_layout = encoding.layout.strided [1, 40] : encoding<layout>
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 16} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 16} : buffer
  %input_view = buffer.view %input_aligned[%base_offset] : buffer -> view<32x16xf32, %row_layout>
  %output_view = buffer.view %output_aligned[%base_offset] : buffer -> view<16x16xf32, %row_layout>
  %scratch = buffer.alloca<workgroup> align(16) %scratch_bytes : buffer
  %scratch_view = buffer.view %scratch[%base_offset] : buffer -> view<16x32xf32, %column_layout>
  %fragment = vector.fragment.load<init> %input_view[%tile_origin, %output_row] shape [%tile, %tile] : view<32x16xf32, %row_layout> -> vector<4xf32>
  vector.fragment.store<result> %fragment, %scratch_view[0, 16] shape [%tile, %tile] : vector<4xf32>, view<16x32xf32, %column_layout>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %reloaded = vector.fragment.load<init> %scratch_view[0, 16] shape [%tile, %tile] : view<16x32xf32, %column_layout> -> vector<4xf32>
  vector.fragment.store<result> %reloaded, %output_view[%output_row, %output_row] shape [%tile, %tile] : vector<4xf32>, view<16x16xf32, %row_layout>
  kernel.return
}

kernel.def target(@hal_target_coop_f16) @cooperative_matrix_broadcast_rows() {
  %unit = index.constant 1 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base_offset = index.constant 0 : offset
  %tile = index.constant 16 : index
  %broadcast = encoding.layout.strided [0, 1] : encoding<layout>
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 16} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 16} : buffer
  %input_view = buffer.view %input_aligned[%base_offset] : buffer -> view<16x16xf32, %broadcast>
  %output_view = buffer.view %output_aligned[%base_offset] : buffer -> view<16x16xf32>
  %fragment = vector.fragment.load<init> %input_view[0, 0] shape [%tile, %tile] : view<16x16xf32, %broadcast> -> vector<16xf32>
  vector.fragment.store<result> %fragment, %output_view[0, 0] shape [%tile, %tile] : vector<16xf32>, view<16x16xf32>
  kernel.return
}

