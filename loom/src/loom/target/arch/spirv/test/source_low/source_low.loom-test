spirv.target<vulkan1_3> @hal_target_coop_bf16 {abi = hal_kernel, contract_feature_bits = 22790}

kernel.def target(@hal_target_coop_bf16) @spirv_hal_cooperative_matrix_bf16() {
  %unit = index.constant 1 : index
  %subgroup_size = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%subgroup_size, %unit, %unit) : index
} launch(%lhs_buffer: buffer, %rhs_buffer: buffer, %init_buffer: buffer, %out_buffer: buffer, %byte_offset: offset) {
  %byte_offset_aligned = index.assume %byte_offset [multiple_of(%byte_offset, 16)] : offset
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %lhs_aligned = buffer.assume.alignment %lhs_buffer {minimum_alignment = 16} : buffer
  %rhs_aligned = buffer.assume.alignment %rhs_buffer {minimum_alignment = 16} : buffer
  %init_aligned = buffer.assume.alignment %init_buffer {minimum_alignment = 16} : buffer
  %out_aligned = buffer.assume.alignment %out_buffer {minimum_alignment = 16} : buffer
  %lhs_view = buffer.view %lhs_aligned[%byte_offset_aligned] : buffer -> view<16x16xbf16>
  %rhs_view = buffer.view %rhs_aligned[%byte_offset_aligned] : buffer -> view<16x16xbf16>
  %init_view = buffer.view %init_aligned[%byte_offset_aligned] : buffer -> view<16x16xf32>
  %out_view = buffer.view %out_aligned[%byte_offset_aligned] : buffer -> view<16x16xf32>
  %lhs = vector.fragment.load<lhs> %lhs_view[0, 0] shape [%m, %k] : view<16x16xbf16> -> vector<4xbf16>
  %rhs = vector.fragment.load<rhs> %rhs_view[0, 0] shape [%k, %n] : view<16x16xbf16> -> vector<4xbf16>
  %init = vector.fragment.load<init> %init_view[0, 0] shape [%m, %n] : view<16x16xf32> -> vector<4xf32>
  %result = vector.mma %lhs, %rhs, %init : vector<4xbf16>, vector<4xbf16>, vector<4xf32>
  vector.fragment.store<result> %result, %out_view[0, 0] shape [%m, %n] : vector<4xf32>, view<16x16xf32>
  kernel.return
}

