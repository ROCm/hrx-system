// RUN: emit source-low output=low control-flow=structured-low

spirv.target<vulkan1_3> @target

func.def target(@target) @spirv_i32_arithmetic(%lhs: i32, %rhs: i32) -> (i32) {
  %bias = scalar.constant 7 : i32
  %sum = scalar.addi %lhs, %rhs : i32
  %difference = scalar.subi %lhs, %rhs : i32
  %product = scalar.muli %difference, %sum : i32
  %signed_quotient = scalar.divsi %product, %bias : i32
  %signed_remainder = scalar.remsi %signed_quotient, %bias : i32
  %result = scalar.addi %signed_remainder, %bias : i32
  func.return %result : i32
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @spirv_i32_arithmetic(%lhs: reg<spirv.id : i32>, %rhs: reg<spirv.id : i32>) -> (reg<spirv.id : i32>) asm {
  %bias = OpConstant.i32 7
  %sum = OpIAdd %lhs, %rhs
  %difference = OpISub %lhs, %rhs
  %product = OpIMul %difference, %sum
  %signed_quotient = OpSDiv %product, %bias
  %signed_remainder = OpSRem %signed_quotient, %bias
  %result = OpIAdd %signed_remainder, %bias
  return %result
}

// ====

spirv.target<vulkan1_3> @target

func.def target(@target) @spirv_i32_compare_select(%lhs: i32, %rhs: i32) -> (i32) {
  %less = scalar.cmpi slt, %lhs, %rhs : i32
  %selected = scf.select %less, %lhs, %rhs : i32
  func.return %selected : i32
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @spirv_i32_compare_select(%lhs: reg<spirv.id : i32>, %rhs: reg<spirv.id : i32>) -> (reg<spirv.id : i32>) asm {
  %11 = OpSLessThan %lhs, %rhs
  %selected = OpSelect %11, %lhs, %rhs
  return %selected
}

// ====

spirv.target<vulkan1_3> @target

// Division must remain guarded when the denominator can be zero.
func.def target(@target) @spirv_i32_if_else(%numerator: i32, %denominator: i32, %fallback: i32) -> (i32) {
  %c0 = scalar.constant 0 : i32
  %nonzero = scalar.cmpi ne, %denominator, %c0 : i32
  %result = scf.if %nonzero -> (i32) {
    %quotient = scalar.divui %numerator, %denominator : i32
    scf.yield %quotient : i32
  } else {
    scf.yield %fallback : i32
  }
  func.return %result : i32
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @spirv_i32_if_else(%numerator: reg<spirv.id : i32>, %denominator: reg<spirv.id : i32>, %fallback: reg<spirv.id : i32>) -> (reg<spirv.id : i32>) asm {
  %c0 = OpConstant.i32 0
  %nonzero = OpINotEqual %denominator, %c0
  %result = low.scf.if %nonzero -> (reg<spirv.id : i32>) {
    %16 = OpBitcast.i32.u32 %numerator
    %17 = OpBitcast.i32.u32 %denominator
    %18 = OpUDiv.u32 %16, %17
    %quotient = OpBitcast.u32.i32 %18
    low.scf.yield %quotient : reg<spirv.id : i32>
  } else {
    low.scf.yield %fallback : reg<spirv.id : i32>
  }
  return %result
}

// ====

spirv.target<vulkan1_3> @target

func.def target(@target) @spirv_index_counted_loop(%start: index, %limit: index, %seed: index) -> (index) {
  %step = index.constant 1 : index
  %sum = scf.for %i = [%start to %limit step %step](%acc = %seed : index) -> (index) {
    %next = index.add %acc, %i : index
    scf.yield %next : index
  }
  func.return %sum : index
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @spirv_index_counted_loop(%start: reg<spirv.id : index>, %limit: reg<spirv.id : index>, %seed: reg<spirv.id : index>) -> (reg<spirv.id : index>) asm {
  %step = OpConstant.i32 1 : reg<spirv.id : index>
  %sum = low.scf.for signed [%start to %limit step %step] iter_args(%seed: reg<spirv.id : index>) -> (reg<spirv.id : index>) do(%i: reg<spirv.id : index>, %acc: reg<spirv.id : index>) {
    %next = OpIAdd %acc, %i : reg<spirv.id : index>
    low.scf.yield %next : reg<spirv.id : index>
  }
  return %sum
}

// ====

spirv.target<vulkan1_3> @target

func.def target(@target) @spirv_i32_condition_payload_loop(%initial: i32, %limit: i32, %bias: i32) -> (i32, i32) {
  %c1 = scalar.constant 1 : i32
  %result_state, %result_payload = scf.while(%before = %initial : i32) -> (i32, i32) {
    %keep_going = scalar.cmpi slt, %before, %limit : i32
    %payload = scalar.addi %before, %bias : i32
    scf.condition %keep_going, %before, %payload : i1, i32, i32
  } do(%body_state: i32, %body_payload: i32) {
    %next = scalar.addi %body_payload, %c1 : i32
    scf.yield %next : i32
  }
  func.return %result_state, %result_payload : i32, i32
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @spirv_i32_condition_payload_loop(%initial: reg<spirv.id : i32>, %limit: reg<spirv.id : i32>, %bias: reg<spirv.id : i32>) -> (reg<spirv.id : i32>, reg<spirv.id : i32>) asm {
  %c1 = OpConstant.i32 1
  %result_state, %result_payload = low.scf.while(%before = %initial : reg<spirv.id : i32>) -> (reg<spirv.id : i32>, reg<spirv.id : i32>) {
    %keep_going = OpSLessThan %before, %limit
    %payload = OpIAdd %before, %bias
    low.scf.condition %keep_going, %before, %payload : reg<spirv.id : i1>, reg<spirv.id : i32>, reg<spirv.id : i32>
  } do(%body_state: reg<spirv.id : i32>, %body_payload: reg<spirv.id : i32>) {
    %next = OpIAdd %body_payload, %c1
    low.scf.yield %next : reg<spirv.id : i32>
  }
  return %result_state, %result_payload
}

// ====

spirv.target<vulkan1_3> @target_unsigned {contract_feature_bits = 33278}

func.def target(@target_unsigned) @spirv_unsigned_integer_views(%lhs: i32, %rhs: i32, %index: index, %limit: index) -> (i32, i32, i1, i1) {
  %quotient = scalar.divui %lhs, %rhs : i32
  %remainder = scalar.remui %quotient, %rhs : i32
  %narrow = scalar.trunci %lhs : i32 to i16
  %wide = scalar.extui %narrow : i16 to i32
  %as_float = scalar.uitofp %wide : i32 to f32
  %back_to_int = scalar.fptoui %as_float : f32 to i32
  %less = scalar.cmpi ult, %lhs, %rhs : i32
  %index_less = index.cmp ult, %index, %limit : index
  func.return %remainder, %back_to_int, %less, %index_less : i32, i32, i1, i1
}

// ----
low.func.def target<spirv.logical.core>(@target_unsigned) abi(shader_entry_point) @spirv_unsigned_integer_views(%lhs: reg<spirv.id : i32>, %rhs: reg<spirv.id : i32>, %index: reg<spirv.id : index>, %limit: reg<spirv.id : index>) -> (reg<spirv.id : i32>, reg<spirv.id : i32>, reg<spirv.id : i1>, reg<spirv.id : i1>) asm {
  %24 = OpBitcast.i32.u32 %lhs
  %25 = OpBitcast.i32.u32 %rhs
  %26 = OpUDiv.u32 %24, %25
  %quotient = OpBitcast.u32.i32 %26
  %28 = OpBitcast.i32.u32 %quotient
  %30 = OpUMod.u32 %28, %25
  %remainder = OpBitcast.u32.i32 %30
  %narrow = OpSConvert.i32.i16 %lhs
  %33 = OpBitcast.i16.u16 %narrow
  %34 = OpUConvert.u16.u32 %33
  %wide = OpBitcast.u32.i32 %34
  %36 = OpBitcast.i32.u32 %wide
  %as_float = OpConvertUToF.u32.f32 %36
  %38 = OpConvertFToU.f32.u32 %as_float
  %back_to_int = OpBitcast.u32.i32 %38
  %less = OpULessThan.u32 %24, %25
  %43 = OpBitcast.i32.u32 %index
  %44 = OpBitcast.i32.u32 %limit
  %index_less = OpULessThan.u32 %43, %44
  return %remainder, %back_to_int, %less, %index_less
}

