spirv.target<vulkan1_3> @target

func.def target(@target) @spirv_offset_addressing(%base: buffer, %row: offset) -> (i32) {
  %column = index.constant 4 : offset
  %row_aligned = index.assume %row [mul(%row, 4)] : offset
  %base_aligned = buffer.assume.alignment %base {minimum_alignment = 4} : buffer
  %byte_offset = index.add %row_aligned, %column : offset
  %view = buffer.view %base_aligned[%byte_offset] : buffer -> view<1xi32>
  %loaded = view.load %view[0] : view<1xi32> -> i32
  func.return %loaded : i32
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @spirv_offset_addressing(%base_aligned: reg<spirv.ptr.storage_buffer>, %row_aligned: reg<spirv.offset64>) -> (reg<spirv.id : i32>) asm {
  %column = OpConstant.offset64 4
  %byte_offset = OpIAdd.offset64 %row_aligned, %column
  %14 = OpPtrAccessChain.storage_buffer.i32.byte_offset %base_aligned, %byte_offset
  %loaded = OpLoad.storage_buffer.i32 %14
  return %loaded
}

