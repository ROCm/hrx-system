  %init = OpCooperativeMatrixLoadKHR.init.bf16.16x16x16.f32.subgroup.storage_buffer %38, %37, 0 : reg<spirv.id : spirv.cooperative_matrix<16x16xf32, subgroup, matrix_accumulator>>
  %result = OpCooperativeMatrixMulAddKHR.bf16.16x16x16.f32.subgroup %lhs, %rhs, %init : reg<spirv.id : spirv.cooperative_matrix<16x16xf32, subgroup, matrix_accumulator>>
  %41 = OpConstant.offset64 16
