  %28 = OpConstant.offset64 16
  %29 = OpUConvert.offset64.u32 %28
  %30 = OpPtrAccessChain.storage_buffer.bf16.byte_offset %lhs_aligned, %byte_offset_aligned
  %lhs = OpCooperativeMatrixLoadKHR.lhs.bf16.16x16x16.f32.subgroup.storage_buffer %30, %29, 0 : reg<spirv.id : spirv.cooperative_matrix<16x16xbf16, subgroup, matrix_a>>
  %32 = OpConstant.offset64 16
  %33 = OpUConvert.offset64.u32 %32
  %34 = OpPtrAccessChain.storage_buffer.bf16.byte_offset %rhs_aligned, %byte_offset_aligned
  %rhs = OpCooperativeMatrixLoadKHR.rhs.bf16.16x16x16.f32.subgroup.storage_buffer %34, %33, 0 : reg<spirv.id : spirv.cooperative_matrix<16x16xbf16, subgroup, matrix_b>>
  %36 = OpConstant.offset64 16
