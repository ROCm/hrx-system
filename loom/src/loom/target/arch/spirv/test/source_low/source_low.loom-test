  %rhs = OpCooperativeMatrixLoadKHR.rhs.u8.16x16x32.u32.subgroup.storage_buffer %63, %62, 0 : reg<spirv.id : spirv.cooperative_matrix<32x16xu8, subgroup, matrix_b>>
  %65 = OpConstant.offset64 16
  %66 = OpUConvert.offset64.u32 %65
  %67 = OpPtrAccessChain.storage_buffer.u32.byte_offset %init_aligned, %byte_offset_aligned
  %init = OpCooperativeMatrixLoadKHR.init.u8.16x16x32.u32.subgroup.storage_buffer %67, %66, 0 : reg<spirv.id : spirv.cooperative_matrix<16x16xu32, subgroup, matrix_accumulator>>
  %result = OpCooperativeMatrixMulAddKHR.u8.16x16x32.u32.subgroup %lhs, %rhs, %init : reg<spirv.id : spirv.cooperative_matrix<16x16xu32, subgroup, matrix_accumulator>>
  %70 = OpConstant.offset64 16
  %71 = OpUConvert.offset64.u32 %70
  %72 = OpPtrAccessChain.storage_buffer.u32.byte_offset %out_aligned, %byte_offset_aligned
  OpCooperativeMatrixStoreKHR.result.u8.16x16x32.u32.subgroup.storage_buffer %72, %result, %71, 0
  return
}

low.kernel.def target<spirv.logical.core>(@hal_target_coop_i8) abi_layout({signature = (buffer, buffer, buffer, buffer, offset) -> ()}) workgroup_size(32, 1, 1) workgroup_count(1, 1, 1) @spirv_hal_cooperative_matrix_s8(%byte_offset_aligned: reg<spirv.offset64>) asm {
