low.kernel.def target<spirv.logical.core>(@hal_target_coop_bf16) abi_layout({signature = (buffer, buffer, buffer, buffer, offset) -> ()}) workgroup_size(32, 1, 1) workgroup_count(1, 1, 1) @spirv_hal_cooperative_matrix_bf16(%byte_offset_aligned: reg<spirv.offset64>) asm {
