  %lhs = OpCooperativeMatrixLoadKHR.lhs.u8.16x16x32.u32.subgroup.storage_buffer %59, %58, 0 : reg<spirv.id : spirv.cooperative_matrix<16x32xu8, subgroup, matrix_a>>
  %61 = OpConstant.offset64 16
