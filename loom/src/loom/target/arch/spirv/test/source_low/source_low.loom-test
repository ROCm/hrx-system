spirv.target<vulkan1_3> @hal_target_coop_i8 {abi = hal_kernel, contract_feature_bits = 2214}

kernel.def target(@hal_target_coop_i8) @spirv_hal_cooperative_matrix_u8() {
  %unit = index.constant 1 : index
  %subgroup_size = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%subgroup_size, %unit, %unit) : index
} launch(%lhs_buffer: buffer, %rhs_buffer: buffer, %init_buffer: buffer, %out_buffer: buffer, %byte_offset: offset) {
  %byte_offset_aligned = index.assume %byte_offset [multiple_of(%byte_offset, 16)] : offset
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 32 : index
  %lhs_storage = encoding.define #encoding.storage<layout=#encoding.layout.dense, schema=#encoding.operand<element_format=u8, payload_elements=32, payload_registers=8>> : encoding<storage>
  %rhs_storage = encoding.define #encoding.storage<layout=#encoding.layout.dense, schema=#encoding.operand<element_format=u8, payload_elements=32, payload_registers=8>> : encoding<storage>
  %acc_storage = encoding.define #encoding.storage<layout=#encoding.layout.dense, schema=#encoding.operand<element_format=u32, payload_elements=8, payload_registers=8>> : encoding<storage>
  %lhs_aligned = buffer.assume.alignment %lhs_buffer {minimum_alignment = 16} : buffer
  %rhs_aligned = buffer.assume.alignment %rhs_buffer {minimum_alignment = 16} : buffer
  %init_aligned = buffer.assume.alignment %init_buffer {minimum_alignment = 16} : buffer
  %out_aligned = buffer.assume.alignment %out_buffer {minimum_alignment = 16} : buffer
  %lhs_view = buffer.view %lhs_aligned[%byte_offset_aligned] : buffer -> view<16x32xi8, %lhs_storage>
  %rhs_view = buffer.view %rhs_aligned[%byte_offset_aligned] : buffer -> view<32x16xi8, %rhs_storage>
  %init_view = buffer.view %init_aligned[%byte_offset_aligned] : buffer -> view<16x16xi32, %acc_storage>
  %out_view = buffer.view %out_aligned[%byte_offset_aligned] : buffer -> view<16x16xi32, %acc_storage>
  %lhs = vector.fragment.load<lhs> %lhs_view[0, 0] shape [%m, %k] : view<16x32xi8, %lhs_storage> -> vector<16xi8>
  %rhs = vector.fragment.load<rhs> %rhs_view[0, 0] shape [%k, %n] : view<32x16xi8, %rhs_storage> -> vector<16xi8>
  %init = vector.fragment.load<init> %init_view[0, 0] shape [%m, %n] : view<16x16xi32, %acc_storage> -> vector<4xi32>
  %result = vector.mma %lhs, %rhs, %init : vector<16xi8>, vector<16xi8>, vector<4xi32>
  vector.fragment.store<result> %result, %out_view[0, 0] shape [%m, %n] : vector<4xi32>, view<16x16xi32, %acc_storage>
  kernel.return
}

kernel.def target(@hal_target_coop_i8) @spirv_hal_cooperative_matrix_s8() {
  %unit = index.constant 1 : index
  %subgroup_size = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%subgroup_size, %unit, %unit) : index
} launch(%lhs_buffer: buffer, %rhs_buffer: buffer, %init_buffer: buffer, %out_buffer: buffer, %byte_offset: offset) {
  %byte_offset_aligned = index.assume %byte_offset [multiple_of(%byte_offset, 16)] : offset
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 32 : index
  %lhs_storage = encoding.define #encoding.storage<layout=#encoding.layout.dense, schema=#encoding.operand<element_format=i8, payload_elements=32, payload_registers=8>> : encoding<storage>
  %rhs_storage = encoding.define #encoding.storage<layout=#encoding.layout.dense, schema=#encoding.operand<element_format=i8, payload_elements=32, payload_registers=8>> : encoding<storage>
  %acc_storage = encoding.define #encoding.storage<layout=#encoding.layout.dense, schema=#encoding.operand<element_format=i32, payload_elements=8, payload_registers=8>> : encoding<storage>
  %lhs_aligned = buffer.assume.alignment %lhs_buffer {minimum_alignment = 16} : buffer
  %rhs_aligned = buffer.assume.alignment %rhs_buffer {minimum_alignment = 16} : buffer
  %init_aligned = buffer.assume.alignment %init_buffer {minimum_alignment = 16} : buffer
  %out_aligned = buffer.assume.alignment %out_buffer {minimum_alignment = 16} : buffer
  %lhs_view = buffer.view %lhs_aligned[%byte_offset_aligned] : buffer -> view<16x32xi8, %lhs_storage>
  %rhs_view = buffer.view %rhs_aligned[%byte_offset_aligned] : buffer -> view<32x16xi8, %rhs_storage>
  %init_view = buffer.view %init_aligned[%byte_offset_aligned] : buffer -> view<16x16xi32, %acc_storage>
  %out_view = buffer.view %out_aligned[%byte_offset_aligned] : buffer -> view<16x16xi32, %acc_storage>
  %lhs = vector.fragment.load<lhs> %lhs_view[0, 0] shape [%m, %k] : view<16x32xi8, %lhs_storage> -> vector<8xi8>
  %rhs = vector.fragment.load<rhs> %rhs_view[0, 0] shape [%k, %n] : view<32x16xi8, %rhs_storage> -> vector<8xi8>
  %init = vector.fragment.load<init> %init_view[0, 0] shape [%m, %n] : view<16x16xi32, %acc_storage> -> vector<16xi32>
  %result = vector.mma<saturate> %lhs, %rhs, %init : vector<8xi8>, vector<8xi8>, vector<16xi32>
  vector.fragment.store<result> %result, %out_view[0, 0] shape [%m, %n] : vector<16xi32>, view<16x16xi32, %acc_storage>
  kernel.return
}

