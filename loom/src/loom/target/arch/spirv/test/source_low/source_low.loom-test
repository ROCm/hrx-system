low.kernel.def target<spirv.logical.core>(@hal_target_coop_f16) abi_layout({signature = (buffer, buffer, buffer, buffer, offset) -> ()}) workgroup_size(32, 1, 1) workgroup_count(1, 1, 1) @spirv_hal_cooperative_matrix_f16(%byte_offset_aligned: reg<spirv.offset64>) asm {
  %lhs_aligned = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %rhs_aligned = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %init_aligned = resource<hal_binding> {index = 2, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %out_aligned = resource<hal_binding> {index = 3, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %91 = OpConstant.offset64 16
  %92 = OpUConvert.offset64.u32 %91
  %93 = OpPtrAccessChain.storage_buffer.f16.byte_offset %lhs_aligned, %byte_offset_aligned
  %lhs = OpCooperativeMatrixLoadKHR.lhs.f16.16x16x16.f32.subgroup.storage_buffer %93, %92, 0 : reg<spirv.id : spirv.cooperative_matrix<16x16xf16, subgroup, matrix_a>>
  %95 = OpConstant.offset64 16
  %96 = OpUConvert.offset64.u32 %95
  %97 = OpPtrAccessChain.storage_buffer.f16.byte_offset %rhs_aligned, %byte_offset_aligned
  %rhs = OpCooperativeMatrixLoadKHR.rhs.f16.16x16x16.f32.subgroup.storage_buffer %97, %96, 0 : reg<spirv.id : spirv.cooperative_matrix<16x16xf16, subgroup, matrix_b>>
  %99 = OpConstant.offset64 16
  %100 = OpUConvert.offset64.u32 %99
  %101 = OpPtrAccessChain.storage_buffer.f32.byte_offset %init_aligned, %byte_offset_aligned
  %init = OpCooperativeMatrixLoadKHR.init.f16.16x16x16.f32.subgroup.storage_buffer %101, %100, 0 : reg<spirv.id : spirv.cooperative_matrix<16x16xf32, subgroup, matrix_accumulator>>
  %result = OpCooperativeMatrixMulAddKHR.f16.16x16x16.f32.subgroup %lhs, %rhs, %init : reg<spirv.id : spirv.cooperative_matrix<16x16xf32, subgroup, matrix_accumulator>>
  %104 = OpConstant.offset64 16
  %105 = OpUConvert.offset64.u32 %104
  %106 = OpPtrAccessChain.storage_buffer.f32.byte_offset %out_aligned, %byte_offset_aligned
  OpCooperativeMatrixStoreKHR.result.f16.16x16x16.f32.subgroup.storage_buffer %106, %result, %105, 0
  return
}

low.kernel.def target<spirv.logical.core>(@hal_target_coop_f16) abi_layout({signature = (buffer, buffer, buffer, buffer, offset, index) -> ()}) workgroup_size(32, 1, 1) workgroup_count(1, 1, 1) @spirv_hal_cooperative_matrix_f16_loop(%byte_offset_aligned: reg<spirv.offset64>, %iteration_count: reg<spirv.id : index>) asm {
  %lhs_aligned = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %rhs_aligned = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %init_aligned = resource<hal_binding> {index = 2, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %out_aligned = resource<hal_binding> {index = 3, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %loop_begin = OpConstant.i32 0 : reg<spirv.id : index>
  %loop_step = OpConstant.i32 1 : reg<spirv.id : index>
  %115 = OpConstant.offset64 16
  %116 = OpUConvert.offset64.u32 %115
  %117 = OpPtrAccessChain.storage_buffer.f16.byte_offset %lhs_aligned, %byte_offset_aligned
  %lhs = OpCooperativeMatrixLoadKHR.lhs.f16.16x16x16.f32.subgroup.storage_buffer %117, %116, 0 : reg<spirv.id : spirv.cooperative_matrix<16x16xf16, subgroup, matrix_a>>
  %119 = OpConstant.offset64 16
  %120 = OpUConvert.offset64.u32 %119
  %121 = OpPtrAccessChain.storage_buffer.f16.byte_offset %rhs_aligned, %byte_offset_aligned
  %rhs = OpCooperativeMatrixLoadKHR.rhs.f16.16x16x16.f32.subgroup.storage_buffer %121, %120, 0 : reg<spirv.id : spirv.cooperative_matrix<16x16xf16, subgroup, matrix_b>>
  %123 = OpConstant.offset64 16
  %124 = OpUConvert.offset64.u32 %123
  %125 = OpPtrAccessChain.storage_buffer.f32.byte_offset %init_aligned, %byte_offset_aligned
  %init = OpCooperativeMatrixLoadKHR.init.f16.16x16x16.f32.subgroup.storage_buffer %125, %124, 0 : reg<spirv.id : spirv.cooperative_matrix<16x16xf32, subgroup, matrix_accumulator>>
  %result = low.scf.for signed [%loop_begin to %iteration_count step %loop_step] iter_args(%init: reg<spirv.id : spirv.cooperative_matrix<16x16xf32, subgroup, matrix_accumulator>>) -> (reg<spirv.id : spirv.cooperative_matrix<16x16xf32, subgroup, matrix_accumulator>>) do(%iteration: reg<spirv.id : index>, %accumulator: reg<spirv.id : spirv.cooperative_matrix<16x16xf32, subgroup, matrix_accumulator>>) {
    %next = OpCooperativeMatrixMulAddKHR.f16.16x16x16.f32.subgroup %lhs, %rhs, %accumulator : reg<spirv.id : spirv.cooperative_matrix<16x16xf32, subgroup, matrix_accumulator>>
    low.scf.yield %next : reg<spirv.id : spirv.cooperative_matrix<16x16xf32, subgroup, matrix_accumulator>>
  }
  %131 = OpConstant.offset64 16
  %132 = OpUConvert.offset64.u32 %131
  %133 = OpPtrAccessChain.storage_buffer.f32.byte_offset %out_aligned, %byte_offset_aligned
  OpCooperativeMatrixStoreKHR.result.f16.16x16x16.f32.subgroup.storage_buffer %133, %result, %132, 0
  return
}

low.kernel.def target<spirv.logical.core>(@hal_target_coop_f16) abi_layout({signature = (buffer, buffer, index, index) -> ()}) workgroup_size(32, 1, 1) workgroup_count(1, 1, 1) @cooperative_matrix_strided_workgroup_transfer(%row_stride: reg<spirv.id : index>, %tile_origin: reg<spirv.id : index>) asm {
  %input_aligned = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %output_aligned = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %scratch = storage {byte_alignment = 16, byte_length = 5120} : low.storage<workgroup>
  %scratch_view = storage_address %scratch : low.storage<workgroup> -> reg<spirv.ptr.workgroup.array.f32>
  %140 = OpSConvert.i32.offset64 %row_stride
  %141 = OpUConvert.offset64.u32 %140
  %142 = OpSConvert.i32.offset64 %tile_origin
  %144 = OpIMul.offset64 %142, %140
  %145 = OpConstant.offset64 4
  %146 = OpIMul.offset64 %144, %145
  %147 = OpPtrAccessChain.storage_buffer.f32.byte_offset %input_aligned, %146
  %fragment = OpCooperativeMatrixLoadKHR.init.f16.16x16x16.f32.subgroup.storage_buffer %147, %141, 0 : reg<spirv.id : spirv.cooperative_matrix<16x16xf32, subgroup, matrix_accumulator>>
  %149 = OpConstant.offset64 40
  %150 = OpUConvert.offset64.u32 %149
  %151 = OpConstant.offset64 2560
  %152 = OpAccessChain.workgroup.f32.byte_offset %scratch_view, %151
  OpCooperativeMatrixStoreKHR.result.f16.16x16x16.f32.subgroup.workgroup %152, %fragment, %150, 1
  OpControlBarrier.workgroup.workgroup.acq_rel
  %153 = OpConstant.offset64 40
  %154 = OpUConvert.offset64.u32 %153
  %155 = OpConstant.offset64 2560
  %156 = OpAccessChain.workgroup.f32.byte_offset %scratch_view, %155
  %reloaded = OpCooperativeMatrixLoadKHR.init.f16.16x16x16.f32.subgroup.workgroup %156, %154, 1 : reg<spirv.id : spirv.cooperative_matrix<16x16xf32, subgroup, matrix_accumulator>>
  %158 = OpSConvert.i32.offset64 %row_stride
  %159 = OpUConvert.offset64.u32 %158
  %160 = OpConstant.offset64 0
  %161 = OpPtrAccessChain.storage_buffer.f32.byte_offset %output_aligned, %160
  OpCooperativeMatrixStoreKHR.result.f16.16x16x16.f32.subgroup.storage_buffer %161, %reloaded, %159, 0
  return
}

low.kernel.def target<spirv.logical.core>(@hal_target_coop_f16) abi_layout({signature = (buffer, buffer) -> ()}) workgroup_size(32, 1, 1) workgroup_count(1, 1, 1) @cooperative_matrix_broadcast_rows() asm {
  %input_aligned = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %output_aligned = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %164 = OpConstant.offset64 0
  %165 = OpUConvert.offset64.u32 %164
  %167 = OpPtrAccessChain.storage_buffer.f32.byte_offset %input_aligned, %164
  %fragment = OpCooperativeMatrixLoadKHR.init.f16.16x16x16.f32.subgroup.storage_buffer %167, %165, 0 : reg<spirv.id : spirv.cooperative_matrix<16x16xf32, subgroup, matrix_accumulator>>
  %169 = OpConstant.offset64 16
  %170 = OpUConvert.offset64.u32 %169
  %171 = OpConstant.offset64 0
  %172 = OpPtrAccessChain.storage_buffer.f32.byte_offset %output_aligned, %171
  OpCooperativeMatrixStoreKHR.result.f16.16x16x16.f32.subgroup.storage_buffer %172, %fragment, %170, 0
  return
}

