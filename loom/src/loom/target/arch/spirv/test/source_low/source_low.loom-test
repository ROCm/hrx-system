spirv.target<vulkan1_3> @hal_target_scalar_payloads {abi = hal_kernel, contract_feature_bits = 37374}

kernel.def target(@hal_target_scalar_payloads) @spirv_hal_direct_scalar_payload_abi() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%i8: i8, %output: buffer, %byte_offset: offset) {
  %byte_offset_aligned = index.assume %byte_offset [multiple_of(%byte_offset, 1)] : offset
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 1} : buffer
  %output_view = buffer.view %output_aligned[%byte_offset_aligned] : buffer -> view<1xi8>
  view.store %i8, %output_view[0] : i8, view<1xi8>
  kernel.return
}

// ----
low.kernel.def target<spirv.logical.core>(@hal_target_scalar_payloads) abi_layout({signature = (i8, buffer, offset) -> ()}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @spirv_hal_direct_scalar_payload_abi(%i8: reg<spirv.id : i8>, %byte_offset_aligned: reg<spirv.offset64>) asm {
  %output_aligned = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %10 = OpPtrAccessChain.storage_buffer.i8.byte_offset %output_aligned, %byte_offset_aligned
  OpStore.storage_buffer.i8 %10, %i8
  return
}

