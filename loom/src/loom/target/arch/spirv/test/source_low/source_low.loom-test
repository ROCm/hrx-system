spirv.target<vulkan1_3> @hal_target {abi = hal_kernel}

kernel.def target(@hal_target) @spirv_dynamic_builtin_storage_buffer_i32() {
  %groups_x = index.constant 4 : index
  %groups_z = index.constant 3 : index
  %unit = index.constant 1 : index
  %workgroup_size_y = index.constant 2 : index
  kernel.launch.config workgroups(%groups_x, %unit, %groups_z) workgroup_size(%unit, %workgroup_size_y, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %workgroup_x = kernel.workgroup.id<x> : index
  %local_y = kernel.workitem.id<y> : index
  %global_z = kernel.workitem.dispatch.id<z> : index
  %subgroup_lane = kernel.subgroup.lane.id : index
  %sum = index.add %workgroup_x, %local_y : index
  %sum_with_lane = index.add %sum, %subgroup_lane : index
  %linear = index.add %sum_with_lane, %global_z : index
  %scale = index.constant 4 : index
  %byte_index = index.mul %linear, %scale : index
  %byte_offset = index.cast %byte_index : index to offset
  %byte_offset_aligned = index.assume %byte_offset [multiple_of(%byte_offset, 4)] : offset
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %input_view = buffer.view %input_aligned[%byte_offset_aligned] : buffer -> view<1xi32>
  %loaded = view.load %input_view[0] : view<1xi32> -> i32
  %output_view = buffer.view %output_aligned[%byte_offset_aligned] : buffer -> view<1xi32>
  view.store %loaded, %output_view[0] : i32, view<1xi32>
  kernel.return
}

// ----
low.kernel.def target<spirv.logical.core>(@hal_target) abi_layout({signature = (buffer, buffer) -> ()}) workgroup_size(1, 2, 1) workgroup_count(4, 1, 3) @spirv_dynamic_builtin_storage_buffer_i32() asm {
  %input_aligned = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %output_aligned = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %workgroup_x = OpLoadBuiltin.workgroup_id.x
  %local_y = OpLoadBuiltin.local_invocation_id.y
  %global_z = OpLoadBuiltin.workgroup_id.z
  %subgroup_lane = OpLoadBuiltin.subgroup_local_invocation_id
  %sum = OpIAdd %workgroup_x, %local_y : reg<spirv.id : index>
  %sum_with_lane = OpIAdd %sum, %subgroup_lane : reg<spirv.id : index>
  %linear = OpIAdd %sum_with_lane, %global_z : reg<spirv.id : index>
  %34 = OpConstant.i32 2 : reg<spirv.id : index>
  %byte_index = OpShiftLeftLogical %linear, %34 : reg<spirv.id : index>
  %36 = OpBitcast.i32.u32 %byte_index
  %byte_offset_aligned = OpUConvert.u32.offset64 %36
  %38 = OpPtrAccessChain.storage_buffer.i32.byte_offset %input_aligned, %byte_offset_aligned
  %loaded = OpLoad.storage_buffer.i32 %38
  %40 = OpPtrAccessChain.storage_buffer.i32.byte_offset %output_aligned, %byte_offset_aligned
  OpStore.storage_buffer.i32 %40, %loaded
  return
}

