spirv.target<vulkan1_3> @target

func.def target(@target) @subgroup_shared_memory_barrier() {
  kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
  func.return
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @subgroup_shared_memory_barrier() asm {
  OpControlBarrier.subgroup.workgroup.acq_rel
  return
}
