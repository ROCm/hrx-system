spirv.target<vulkan1_3> @target

func.def target(@target) @workgroup_barrier() {
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  func.return
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @workgroup_barrier() asm {
  OpControlBarrier.workgroup.workgroup.acq_rel
  return
}

