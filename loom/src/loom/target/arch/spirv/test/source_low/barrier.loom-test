// TEMPLATE: loom/src/loom/test/corpus/source_low/sync_barrier.loom-test
// RUN: emit source-low target=spirv:vulkan1.3+bda output=low control-flow=structured-low

func.def @workgroup_barrier() {
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  func.return
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @workgroup_barrier() asm {
  OpControlBarrier.workgroup.workgroup.acq_rel
  return
}

// ====

func.def @subgroup_shared_memory_barrier() {
  kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
  func.return
}

// ----
low.func.def target<spirv.logical.core> abi(shader_entry_point) @subgroup_shared_memory_barrier() asm {
  OpControlBarrier.subgroup.workgroup.acq_rel
  return
}
