spirv.target<vulkan1_3> @target {contract_feature_bits = 37374}

func.def target(@target) @workgroup_subview_refine_i32(%value: i32, %element: index) -> (i32) {
  %byte_length = index.constant 64 : offset
  %base = index.constant 4 : offset
  %element_bounded = index.assume %element [range(%element, 0, 3)] : index
  %scratch = buffer.alloca<workgroup> align(4) %byte_length : buffer
  %scratch_view = buffer.view %scratch[%base] : buffer -> view<8xi32>
  %scratch_subview = view.subview %scratch_view[2] : view<8xi32> -> view<4xi32>
  %scratch_refined = view.refine %scratch_subview : view<4xi32> -> view<4xi32>
  view.store %value, %scratch_refined[%element_bounded] : i32, view<4xi32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %loaded = view.load %scratch_refined[%element_bounded] : view<4xi32> -> i32
  func.return %loaded : i32
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @workgroup_subview_refine_i32(%value: reg<spirv.id : i32>, %element_bounded: reg<spirv.id : index>) -> (reg<spirv.id : i32>) asm {
  %scratch = storage {byte_alignment = 4, byte_length = 64} : low.storage<workgroup>
  %scratch_refined = storage_address %scratch : low.storage<workgroup> -> reg<spirv.ptr.workgroup.array.i32>
  %16 = OpConstant.i32 3 : reg<spirv.id : index>
  %17 = OpIAdd %element_bounded, %16 : reg<spirv.id : index>
  %18 = OpAccessChain.workgroup.i32.element_index %scratch_refined, %17
  OpStore.workgroup.i32 %18, %value
  OpControlBarrier.workgroup.workgroup.acq_rel
  %19 = OpConstant.i32 3 : reg<spirv.id : index>
  %20 = OpIAdd %element_bounded, %19 : reg<spirv.id : index>
  %21 = OpAccessChain.workgroup.i32.element_index %scratch_refined, %20
  %loaded = OpLoad.workgroup.i32 %21
  return %loaded
}

