low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @workgroup_float_scalar_widths(%value_f16: reg<spirv.id : f16>, %value_bf16: reg<spirv.id : bf16>, %value_f32: reg<spirv.id : f32>, %value_f64: reg<spirv.id : f64>) -> (reg<spirv.id : f16>, reg<spirv.id : bf16>, reg<spirv.id : f32>, reg<spirv.id : f64>) asm {
  %scratch_f16 = storage {byte_alignment = 2, byte_length = 16} : low.storage<workgroup>
  %scratch_bf16 = storage {byte_alignment = 2, byte_length = 16} : low.storage<workgroup>
  %scratch_f32 = storage {byte_alignment = 4, byte_length = 16} : low.storage<workgroup>
  %scratch_f64 = storage {byte_alignment = 8, byte_length = 16} : low.storage<workgroup>
  %view_f16 = storage_address %scratch_f16 : low.storage<workgroup> -> reg<spirv.ptr.workgroup.array.f16>
  %view_bf16 = storage_address %scratch_bf16 : low.storage<workgroup> -> reg<spirv.ptr.workgroup.array.bf16>
  %view_f32 = storage_address %scratch_f32 : low.storage<workgroup> -> reg<spirv.ptr.workgroup.array.f32>
  %view_f64 = storage_address %scratch_f64 : low.storage<workgroup> -> reg<spirv.ptr.workgroup.array.f64>
  %38 = OpConstant.i32 1 : reg<spirv.id : index>
  %39 = OpAccessChain.workgroup.f16.element_index %view_f16, %38
  OpStore.workgroup.f16 %39, %value_f16
  %41 = OpAccessChain.workgroup.bf16.element_index %view_bf16, %38
  OpStore.workgroup.bf16 %41, %value_bf16
  %43 = OpAccessChain.workgroup.f32.element_index %view_f32, %38
  OpStore.workgroup.f32 %43, %value_f32
  %45 = OpAccessChain.workgroup.f64.element_index %view_f64, %38
  OpStore.workgroup.f64 %45, %value_f64
  OpControlBarrier.workgroup.workgroup.acq_rel
  %46 = OpConstant.i32 1 : reg<spirv.id : index>
  %47 = OpAccessChain.workgroup.f16.element_index %view_f16, %46
  %loaded_f16 = OpLoad.workgroup.f16 %47
  %50 = OpAccessChain.workgroup.bf16.element_index %view_bf16, %46
  %loaded_bf16 = OpLoad.workgroup.bf16 %50
  %53 = OpAccessChain.workgroup.f32.element_index %view_f32, %46
  %loaded_f32 = OpLoad.workgroup.f32 %53
  %56 = OpAccessChain.workgroup.f64.element_index %view_f64, %46
  %loaded_f64 = OpLoad.workgroup.f64 %56
  return %loaded_f16, %loaded_bf16, %loaded_f32, %loaded_f64
}
