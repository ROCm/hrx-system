spirv.target<vulkan1_3> @target {contract_feature_bits = 37374}

func.def target(@target) @workgroup_integer_scalar_widths(%value_i8: i8, %value_i16: i16, %value_i32: i32, %value_i64: i64) -> (i8, i16, i32, i64) {
  %byte_length = index.constant 16 : offset
  %scratch_base = index.constant 0 : offset
  %scratch_i8 = buffer.alloca<workgroup> align(1) %byte_length : buffer
  %scratch_i16 = buffer.alloca<workgroup> align(2) %byte_length : buffer
  %scratch_i32 = buffer.alloca<workgroup> align(4) %byte_length : buffer
  %scratch_i64 = buffer.alloca<workgroup> align(8) %byte_length : buffer
  %view_i8 = buffer.view %scratch_i8[%scratch_base] : buffer -> view<2xi8>
  %view_i16 = buffer.view %scratch_i16[%scratch_base] : buffer -> view<2xi16>
  %view_i32 = buffer.view %scratch_i32[%scratch_base] : buffer -> view<2xi32>
  %view_i64 = buffer.view %scratch_i64[%scratch_base] : buffer -> view<2xi64>
  view.store %value_i8, %view_i8[1] : i8, view<2xi8>
  view.store %value_i16, %view_i16[1] : i16, view<2xi16>
  view.store %value_i32, %view_i32[1] : i32, view<2xi32>
  view.store %value_i64, %view_i64[1] : i64, view<2xi64>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %loaded_i8 = view.load %view_i8[1] : view<2xi8> -> i8
  %loaded_i16 = view.load %view_i16[1] : view<2xi16> -> i16
  %loaded_i32 = view.load %view_i32[1] : view<2xi32> -> i32
  %loaded_i64 = view.load %view_i64[1] : view<2xi64> -> i64
  func.return %loaded_i8, %loaded_i16, %loaded_i32, %loaded_i64 : i8, i16, i32, i64
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @workgroup_integer_scalar_widths(%value_i8: reg<spirv.id : i8>, %value_i16: reg<spirv.id : i16>, %value_i32: reg<spirv.id : i32>, %value_i64: reg<spirv.id : i64>) -> (reg<spirv.id : i8>, reg<spirv.id : i16>, reg<spirv.id : i32>, reg<spirv.id : i64>) asm {
  %scratch_i8 = storage {byte_alignment = 1, byte_length = 16} : low.storage<workgroup>
  %scratch_i16 = storage {byte_alignment = 2, byte_length = 16} : low.storage<workgroup>
  %scratch_i32 = storage {byte_alignment = 4, byte_length = 16} : low.storage<workgroup>
  %scratch_i64 = storage {byte_alignment = 8, byte_length = 16} : low.storage<workgroup>
  %view_i8 = storage_address %scratch_i8 : low.storage<workgroup> -> reg<spirv.ptr.workgroup.array.i8>
  %view_i16 = storage_address %scratch_i16 : low.storage<workgroup> -> reg<spirv.ptr.workgroup.array.i16>
  %view_i32 = storage_address %scratch_i32 : low.storage<workgroup> -> reg<spirv.ptr.workgroup.array.i32>
  %view_i64 = storage_address %scratch_i64 : low.storage<workgroup> -> reg<spirv.ptr.workgroup.array.i64>
  %38 = OpConstant.i32 1 : reg<spirv.id : index>
  %39 = OpAccessChain.workgroup.i8.element_index %view_i8, %38
  OpStore.workgroup.i8 %39, %value_i8
  %41 = OpAccessChain.workgroup.i16.element_index %view_i16, %38
  OpStore.workgroup.i16 %41, %value_i16
  %43 = OpAccessChain.workgroup.i32.element_index %view_i32, %38
  OpStore.workgroup.i32 %43, %value_i32
  %45 = OpAccessChain.workgroup.i64.element_index %view_i64, %38
  OpStore.workgroup.i64 %45, %value_i64
  OpControlBarrier.workgroup.workgroup.acq_rel
  %46 = OpConstant.i32 1 : reg<spirv.id : index>
  %47 = OpAccessChain.workgroup.i8.element_index %view_i8, %46
  %loaded_i8 = OpLoad.workgroup.i8 %47
  %50 = OpAccessChain.workgroup.i16.element_index %view_i16, %46
  %loaded_i16 = OpLoad.workgroup.i16 %50
  %53 = OpAccessChain.workgroup.i32.element_index %view_i32, %46
  %loaded_i32 = OpLoad.workgroup.i32 %53
  %56 = OpAccessChain.workgroup.i64.element_index %view_i64, %46
  %loaded_i64 = OpLoad.workgroup.i64 %56
  return %loaded_i8, %loaded_i16, %loaded_i32, %loaded_i64
}

