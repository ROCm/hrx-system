// TEMPLATE: loom/src/loom/test/corpus/source_low/memory_workgroup_scalar_addressing.loom-test
// RUN: emit source-low output=low control-flow=structured-low

spirv.target<vulkan1_3> @target {contract_feature_bits = 37374}

func.def target(@target) @workgroup_static_rank2_i32(%value: i32) -> (i32) {
  %byte_length = index.constant 256 : offset
  %base = index.constant 8 : offset
  %scratch = buffer.alloca<workgroup> align(4) %byte_length : buffer
  %scratch_view = buffer.view %scratch[%base] : buffer -> view<4x8xi32>
  view.store %value, %scratch_view[2, 3] : i32, view<4x8xi32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %loaded = view.load %scratch_view[2, 3] : view<4x8xi32> -> i32
  func.return %loaded : i32
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @workgroup_static_rank2_i32(%value: reg<spirv.id : i32>) -> (reg<spirv.id : i32>) asm {
  %scratch = storage {byte_alignment = 4, byte_length = 256} : low.storage<workgroup>
  %scratch_view = storage_address %scratch : low.storage<workgroup> -> reg<spirv.ptr.workgroup.array.i32>
  %13 = OpConstant.i32 21 : reg<spirv.id : index>
  %14 = OpAccessChain.workgroup.i32.element_index %scratch_view, %13
  OpStore.workgroup.i32 %14, %value
  OpControlBarrier.workgroup.workgroup.acq_rel
  %15 = OpConstant.i32 21 : reg<spirv.id : index>
  %16 = OpAccessChain.workgroup.i32.element_index %scratch_view, %15
  %loaded = OpLoad.workgroup.i32 %16
  return %loaded
}

