spirv.target<vulkan1_3> @target {contract_feature_bits = 37374}

func.def target(@target) @workgroup_dynamic_stride_rank2_i32(%value: i32, %column_count: index, %row: index, %column: index) -> (i32) {
  %byte_length = index.constant 128 : offset
  %scratch_base = index.constant 0 : offset
  %column_count_bounded = index.assume %column_count [range(%column_count, 1, 8)] : index
  %row_bounded = index.assume %row [range(%row, 0, 3)] : index
  %column_bounded = index.assume %column [range(%column, 0, 7), lt(%column, %column_count_bounded)] : index
  %scratch = buffer.alloca<workgroup> align(4) %byte_length : buffer
  %scratch_view = buffer.view %scratch[%scratch_base] : buffer -> view<4x[%column_count_bounded]xi32>
  view.store %value, %scratch_view[%row_bounded, %column_bounded] : i32, view<4x[%column_count_bounded]xi32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %loaded = view.load %scratch_view[%row_bounded, %column_bounded] : view<4x[%column_count_bounded]xi32> -> i32
  func.return %loaded : i32
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @workgroup_dynamic_stride_rank2_i32(%value: reg<spirv.id : i32>, %column_count_bounded: reg<spirv.id : index>, %row_bounded: reg<spirv.id : index>, %column_bounded: reg<spirv.id : index>) -> (reg<spirv.id : i32>) asm {
  %scratch = storage {byte_alignment = 4, byte_length = 128} : low.storage<workgroup>
  %scratch_view = storage_address %scratch : low.storage<workgroup> -> reg<spirv.ptr.workgroup.array.i32>
  %20 = OpIMul %row_bounded, %column_count_bounded : reg<spirv.id : index>
  %21 = OpIAdd %20, %column_bounded : reg<spirv.id : index>
  %22 = OpAccessChain.workgroup.i32.element_index %scratch_view, %21
  OpStore.workgroup.i32 %22, %value
  OpControlBarrier.workgroup.workgroup.acq_rel
  %23 = OpIMul %row_bounded, %column_count_bounded : reg<spirv.id : index>
  %24 = OpIAdd %23, %column_bounded : reg<spirv.id : index>
  %25 = OpAccessChain.workgroup.i32.element_index %scratch_view, %24
  %loaded = OpLoad.workgroup.i32 %25
  return %loaded
}

