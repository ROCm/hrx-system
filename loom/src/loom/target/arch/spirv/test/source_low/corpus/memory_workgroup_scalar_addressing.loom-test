spirv.target<vulkan1_3> @target {contract_feature_bits = 37374}

func.def target(@target) @workgroup_dynamic_base_and_index_i32(%value: i32, %base_element: index, %element: index) -> (i32) {
  %byte_length = index.constant 128 : offset
  %element_byte_count = index.constant 4 : index
  %base_element_bounded = index.assume %base_element [range(%base_element, 0, 15)] : index
  %element_bounded = index.assume %element [range(%element, 0, 7)] : index
  %base_byte_index = index.mul %base_element_bounded, %element_byte_count : index
  %base_byte_offset = index.cast %base_byte_index : index to offset
  %scratch = buffer.alloca<workgroup> align(4) %byte_length : buffer
  %scratch_view = buffer.view %scratch[%base_byte_offset] : buffer -> view<8xi32>
  view.store %value, %scratch_view[%element_bounded] : i32, view<8xi32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %loaded = view.load %scratch_view[%element_bounded] : view<8xi32> -> i32
  func.return %loaded : i32
}

// ----
low.func.def target<spirv.logical.core>(@target) abi(shader_entry_point) @workgroup_dynamic_base_and_index_i32(%value: reg<spirv.id : i32>, %base_element_bounded: reg<spirv.id : index>, %element_bounded: reg<spirv.id : index>) -> (reg<spirv.id : i32>) asm {
  %scratch = storage {byte_alignment = 4, byte_length = 128} : low.storage<workgroup>
  %scratch_view = storage_address %scratch : low.storage<workgroup> -> reg<spirv.ptr.workgroup.array.i32>
  %21 = OpIAdd %base_element_bounded, %element_bounded : reg<spirv.id : index>
  %22 = OpAccessChain.workgroup.i32.element_index %scratch_view, %21
  OpStore.workgroup.i32 %22, %value
  OpControlBarrier.workgroup.workgroup.acq_rel
  %23 = OpIAdd %base_element_bounded, %element_bounded : reg<spirv.id : index>
  %24 = OpAccessChain.workgroup.i32.element_index %scratch_view, %23
  %loaded = OpLoad.workgroup.i32 %24
  return %loaded
}

