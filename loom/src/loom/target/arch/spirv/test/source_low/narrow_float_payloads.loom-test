low.kernel.def target<spirv.logical.core> abi_layout({signature = (index, index, buffer, buffer) -> ()}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @constant_loop_f8e5m2_3(%iterations: reg<spirv.id : index>, %selected: reg<spirv.id : index>) asm {
  %input = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %output = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %begin = OpConstant.i32 0 : reg<spirv.id : index>
  %step = OpConstant.i32 1 : reg<spirv.id : index>
  %99 = OpConstant.offset64 0
  %100 = OpPtrAccessChain.storage_buffer.i8.byte_offset %input, %99
  %101 = OpLoad.storage_buffer.i8 %100
  %102 = OpConstant.offset64 1
  %103 = OpPtrAccessChain.storage_buffer.i8.byte_offset %input, %102
  %104 = OpLoad.storage_buffer.i8 %103
  %105 = OpConstant.offset64 2
  %106 = OpPtrAccessChain.storage_buffer.i8.byte_offset %input, %105
  %107 = OpLoad.storage_buffer.i8 %106
  %108 = OpConstant.i32 128
  %109 = OpSConvert.i32.i8 %108
  %114, %115, %116 = low.scf.for signed [%begin to %iterations step %step] iter_args(%109: reg<spirv.id : i8>, %109: reg<spirv.id : i8>, %109: reg<spirv.id : i8>) -> (reg<spirv.id : i8>, reg<spirv.id : i8>, reg<spirv.id : i8>) do(%iteration: reg<spirv.id : index>, %111: reg<spirv.id : i8>, %112: reg<spirv.id : i8>, %113: reg<spirv.id : i8>) {
    %chosen = OpIEqual %iteration, %selected
    %118 = OpSelect.i8 %chosen, %101, %111
    %119 = OpSelect.i8 %chosen, %104, %112
    %120 = OpSelect.i8 %chosen, %107, %113
    low.scf.yield %118, %119, %120 : reg<spirv.id : i8>, reg<spirv.id : i8>, reg<spirv.id : i8>
  }
  %122 = OpPtrAccessChain.storage_buffer.i8.byte_offset %output, %99
  OpStore.storage_buffer.i8 %122, %114
  %124 = OpPtrAccessChain.storage_buffer.i8.byte_offset %output, %102
  OpStore.storage_buffer.i8 %124, %115
  %126 = OpPtrAccessChain.storage_buffer.i8.byte_offset %output, %105
  OpStore.storage_buffer.i8 %126, %116
  return
}

