  %loaded = vector.load %source[0] : view<3xf8E5M2> -> vector<3xf8E5M2>
  %result = scf.for %iteration = [%begin to %iterations step %step](%state = %initial : vector<3xf8E5M2>) -> (vector<3xf8E5M2>) {
    %chosen = index.cmp eq, %iteration, %selected : index
    %next = scf.select %chosen, %loaded, %state : vector<3xf8E5M2>
    scf.yield %next : vector<3xf8E5M2>
