  %input = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %output = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %begin = OpConstant.i32 0 : reg<spirv.id : index>
  %step = OpConstant.i32 1 : reg<spirv.id : index>
  %83 = OpConstant.offset64 0
  %84 = OpPtrAccessChain.storage_buffer.i8.byte_offset %input, %83
  %85 = OpLoad.storage_buffer.i8 %84
  %86 = OpConstant.offset64 1
  %87 = OpPtrAccessChain.storage_buffer.i8.byte_offset %input, %86
  %88 = OpLoad.storage_buffer.i8 %87
  %89 = OpConstant.offset64 2
  %90 = OpPtrAccessChain.storage_buffer.i8.byte_offset %input, %89
  %91 = OpLoad.storage_buffer.i8 %90
  %92 = OpConstant.i32 128
  %93 = OpSConvert.i32.i8 %92
  %98, %99, %100 = low.scf.for signed [%begin to %iterations step %step] iter_args(%93: reg<spirv.id : i8>, %93: reg<spirv.id : i8>, %93: reg<spirv.id : i8>) -> (reg<spirv.id : i8>, reg<spirv.id : i8>, reg<spirv.id : i8>) do(%iteration: reg<spirv.id : index>, %95: reg<spirv.id : i8>, %96: reg<spirv.id : i8>, %97: reg<spirv.id : i8>) {
    %chosen = OpIEqual %iteration, %selected
    %102 = OpSelect.i8 %chosen, %85, %95
    %103 = OpSelect.i8 %chosen, %88, %96
    %104 = OpSelect.i8 %chosen, %91, %97
    low.scf.yield %102, %103, %104 : reg<spirv.id : i8>, reg<spirv.id : i8>, reg<spirv.id : i8>
  }
  %106 = OpPtrAccessChain.storage_buffer.i8.byte_offset %output, %83
  OpStore.storage_buffer.i8 %106, %98
  %108 = OpPtrAccessChain.storage_buffer.i8.byte_offset %output, %86
  OpStore.storage_buffer.i8 %108, %99
  %110 = OpPtrAccessChain.storage_buffer.i8.byte_offset %output, %89
  OpStore.storage_buffer.i8 %110, %100
  return
}

