  %112 = OpLoad.storage_buffer.bf16 %111
  %113 = OpConstant.bf16 32768
  %114 = OpCompositeConstruct.v4bf16 %113, %113, %113, %113
  %115 = OpCompositeConstruct.v3bf16 %113, %113, %113
  %119, %120 = low.scf.for signed [%begin to %iterations step %step] iter_args(%114: reg<spirv.id : vector<4xbf16>>, %115: reg<spirv.id : vector<3xbf16>>) -> (reg<spirv.id : vector<4xbf16>>, reg<spirv.id : vector<3xbf16>>) do(%iteration: reg<spirv.id : index>, %117: reg<spirv.id : vector<4xbf16>>, %118: reg<spirv.id : vector<3xbf16>>) {
    %chosen = OpIEqual %iteration, %selected
    %122 = OpCompositeConstruct.v4bool %chosen, %chosen, %chosen, %chosen
    %123 = OpSelect.v4bf16 %122, %102, %117
    %124 = OpCompositeConstruct.v2bf16 %112, %112
    %125 = OpVectorShuffle.v2bf16.v3bf16 %109, %124, 0, 1, 2
