low.kernel.def target<spirv.logical.core> abi_layout({signature = (index, index, buffer, buffer) -> ()}) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @constant_loop_f8e5m2_3(%iterations: reg<spirv.id : index>, %selected: reg<spirv.id : index>) asm {
  %input = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %output = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<spirv.ptr.storage_buffer>
  %begin = OpConstant.i32 0 : reg<spirv.id : index>
  %step = OpConstant.i32 1 : reg<spirv.id : index>
  %108 = OpConstant.offset64 0
  %109 = OpPtrAccessChain.storage_buffer.i8.byte_offset %input, %108
  %110 = OpLoad.storage_buffer.i8 %109
  %111 = OpConstant.offset64 1
  %112 = OpPtrAccessChain.storage_buffer.i8.byte_offset %input, %111
  %113 = OpLoad.storage_buffer.i8 %112
  %114 = OpConstant.offset64 2
  %115 = OpPtrAccessChain.storage_buffer.i8.byte_offset %input, %114
  %116 = OpLoad.storage_buffer.i8 %115
  %117 = OpConstant.i32 128
  %118 = OpSConvert.i32.i8 %117
  %123, %124, %125 = low.scf.for signed [%begin to %iterations step %step] iter_args(%118: reg<spirv.id : i8>, %118: reg<spirv.id : i8>, %118: reg<spirv.id : i8>) -> (reg<spirv.id : i8>, reg<spirv.id : i8>, reg<spirv.id : i8>) do(%iteration: reg<spirv.id : index>, %120: reg<spirv.id : i8>, %121: reg<spirv.id : i8>, %122: reg<spirv.id : i8>) {
    %chosen = OpIEqual %iteration, %selected
    %127 = OpSelect.i8 %chosen, %110, %120
    %128 = OpSelect.i8 %chosen, %113, %121
    %129 = OpSelect.i8 %chosen, %116, %122
    low.scf.yield %127, %128, %129 : reg<spirv.id : i8>, reg<spirv.id : i8>, reg<spirv.id : i8>
  }
  %131 = OpPtrAccessChain.storage_buffer.i8.byte_offset %output, %108
  OpStore.storage_buffer.i8 %131, %123
  %133 = OpPtrAccessChain.storage_buffer.i8.byte_offset %output, %111
  OpStore.storage_buffer.i8 %133, %124
  %135 = OpPtrAccessChain.storage_buffer.i8.byte_offset %output, %114
  OpStore.storage_buffer.i8 %135, %125
  return
}

