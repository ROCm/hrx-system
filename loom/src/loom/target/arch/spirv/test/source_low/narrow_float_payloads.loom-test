// RUN: emit spirv-low target=spirv:vulkan1.3+bda features=BFLOAT16_TYPE_KHR,-INT16,STORAGE_BUFFER_16BIT_ACCESS control-flow=structured-low

// Native BF16 retains vector carriers across the same loop without Int16.
kernel.def @constant_loop_bf16_7_native() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%iterations: index, %selected: index, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %source = buffer.view %input[%base] : buffer -> view<7xbf16>
  %destination = buffer.view %output[%base] : buffer -> view<7xbf16>
  %initial = vector.constant -0.0 : vector<7xbf16>
  %loaded = vector.load %source[0] : view<7xbf16> -> vector<7xbf16>
  %result = scf.for %iteration = [%begin to %iterations step %step](%state = %initial : vector<7xbf16>) -> (vector<7xbf16>) {
    %chosen = index.cmp eq, %iteration, %selected : index
    %next = scf.select %chosen, %loaded, %state : vector<7xbf16>
    scf.yield %next : vector<7xbf16>
  }
  vector.store %result, %destination[0] : vector<7xbf16>, view<7xbf16>
  kernel.return
}

