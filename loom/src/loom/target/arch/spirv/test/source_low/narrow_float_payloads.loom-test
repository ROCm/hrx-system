  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %source = buffer.view %input[%base] : buffer -> view<3xf8E5M2>
  %destination = buffer.view %output[%base] : buffer -> view<3xf8E5M2>
  %initial_scalar = scalar.constant -0.0 : f8E5M2
  %initial = vector.splat %initial_scalar : vector<3xf8E5M2>
  %loaded = vector.load %source[0] : view<3xf8E5M2> -> vector<3xf8E5M2>
  %result = scf.for %iteration = [%begin to %iterations step %step](%state = %initial : vector<3xf8E5M2>) -> (vector<3xf8E5M2>) {
    %chosen = index.cmp eq, %iteration, %selected : index
    %next = scf.select %chosen, %loaded, %state : vector<3xf8E5M2>
    scf.yield %next : vector<3xf8E5M2>
  }
  vector.store %result, %destination[0] : vector<3xf8E5M2>, view<3xf8E5M2>
  kernel.return
}

