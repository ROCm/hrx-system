llvmir.target<object> @target {data_layout = "e-p:64:64-i64:64-n8:16:32:64-S128", triple = "loom-direct64-unknown-none"}

func.def target(@target) @quotient_by_three(%input: i32) -> (i32) {
  %divisor = scalar.constant 3 : i32
  %quotient = scalar.divui %input, %divisor : i32
  func.return %quotient : i32
}

// ----
low.func.def target<llvmir.generic.core>(@target) abi(object_function) @quotient_by_three(%input: reg<llvmir.i32>) -> (reg<llvmir.i32>) asm {
  %divisor = const.i32 3
  %quotient = udiv.i32 %input, %divisor
  return %quotient
}

