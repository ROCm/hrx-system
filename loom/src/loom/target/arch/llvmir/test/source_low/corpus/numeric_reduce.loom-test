llvmir.target<object> @target {data_layout = "e-p:64:64-i64:64-n8:16:32:64-S128", triple = "loom-direct64-unknown-none"}

func.def target(@target) @i32_reduce_minui_select_sentinel(%values: vector<4xi32>) -> (i32) {
  %empty_value = scalar.constant 0 : i32
  %zeros = vector.splat %empty_value : vector<4xi32>
  %is_zero = vector.cmpi eq, %values, %zeros : vector<4xi32> -> vector<4xi1>
  %start = scalar.constant 0 : i32
  %step = scalar.constant 1 : i32
  %indices = vector.iota %start step %step : vector<4xi32>
  %sentinel = scalar.constant 2147483647 : i32
  %sentinels = vector.splat %sentinel : vector<4xi32>
  %selected = vector.select %is_zero, %indices, %sentinels : vector<4xi32>
  %result = vector.reduce<minui> %selected, %sentinel : vector<4xi32>, i32
  func.return %result : i32
}

// ----
low.func.def target<llvmir.generic.core>(@target) abi(object_function) @i32_reduce_minui_select_sentinel(%values: reg<llvmir.i32 x4>) -> (reg<llvmir.i32>) asm {
  %45 = const.i32 0
  %46 = const.i32 1
  %47 = const.i32 2
  %48 = const.i32 3
  %sentinel = const.i32 2147483647
  %50 = extract.v4i32 %values, 0
  %51 = cmp.eq.i32 %50, %45
  %52 = select.i32 %51, %45, %sentinel
  %53 = cmp.ult.i32 %sentinel, %52
  %54 = select.i32 %53, %sentinel, %52
  %55 = extract.v4i32 %values, 1
  %56 = cmp.eq.i32 %55, %45
  %57 = select.i32 %56, %46, %sentinel
  %58 = cmp.ult.i32 %54, %57
  %59 = select.i32 %58, %54, %57
  %60 = extract.v4i32 %values, 2
  %61 = cmp.eq.i32 %60, %45
  %62 = select.i32 %61, %47, %sentinel
  %63 = cmp.ult.i32 %59, %62
  %64 = select.i32 %63, %59, %62
  %65 = extract.v4i32 %values, 3
  %66 = cmp.eq.i32 %65, %45
  %67 = select.i32 %66, %48, %sentinel
  %68 = cmp.ult.i32 %64, %67
  %result = select.i32 %68, %64, %67
  return %result
}
