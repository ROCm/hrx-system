  %step = index.cast %step_index : index to offset
  %target_global = buffer.assume.memory_space<global> %target : buffer
  %value = vector.from_elements %pattern : vector<1xi32>
  cfg.br ^loop(%lane: offset)
^loop(%byte_offset: offset):
  %inside = index.cmp ult, %byte_offset, %byte_length : offset
  cfg.cond_br %inside, ^body, ^done
^body:
  %target_view = buffer.view %target_global[%byte_offset] : buffer -> view<1xi32>
  vector.store %value, %target_view[0] : vector<1xi32>, view<1xi32>
  %next = index.add %byte_offset, %step : offset
  cfg.br ^loop(%next: offset)
^done:
  kernel.return
}

// ----
low.kernel.def target<llvmir.generic.core>(@target) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @grid_stride_store_offset(%byte_length: reg<llvmir.i64>, %value: reg<llvmir.i32>) asm {
  %target_view = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<llvmir.ptr>
  %lane = kernel.workitem_id.x
  %step = const.i64 64
  low.br ^loop(%lane: reg<llvmir.i64>)
^loop(%byte_offset: reg<llvmir.i64>):
  %inside = cmp.ult.i64 %byte_offset, %byte_length
  low.cond_br %inside, ^body, ^done : reg<llvmir.i1>
^body:
  store.indexed.i32 %value, %target_view, %byte_offset, 0, 1
  %next = add.i64 %byte_offset, %step
  low.br ^loop(%next: reg<llvmir.i64>)
^done:
  return
}
