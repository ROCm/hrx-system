// TEMPLATE: loom/src/loom/test/corpus/source_low/memory_global.loom-test
// RUN: emit source-low output=low

llvmir.target<object> @target {data_layout = "e-p:64:64-i64:64-n8:16:32:64-S128", triple = "loom-direct64-unknown-none"}

func.def target(@target) @global_saddr_fallback(%input: buffer, %output: buffer) {
  %base = index.constant 4 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<4xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<4xi32>
  %loaded = vector.load %input_view[0] : view<4xi32> -> vector<4xi32>
  vector.store %loaded, %output_view[0] : vector<4xi32>, view<4xi32>
  func.return
}

// ----
low.func.def target<llvmir.generic.core>(@target) abi(object_function) @global_saddr_fallback(%input_view: reg<llvmir.ptr>, %output_view: reg<llvmir.ptr>) asm {
  %loaded = load.v4i32 %input_view, 4
  store.v4i32 %loaded, %output_view, 4
  return
}

