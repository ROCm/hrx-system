  %word_count = const.i64 32
  %sign_count = const.i64 63
  %logical_word = lshr.i64 %value, %word_count
  %signed_word = ashr.i64 %value, %word_count
  %logical_sign = lshr.i64 %value, %sign_count
  %signed_sign = ashr.i64 %value, %sign_count
  %selected = select.i64 %condition, %logical_word, %signed_word
  return %logical_word, %signed_word, %logical_sign, %signed_sign, %selected
}

