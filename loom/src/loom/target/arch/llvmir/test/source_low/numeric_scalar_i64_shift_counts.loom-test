low.func.def target<llvmir.generic.core>(@target) abi(object_function) @index_shift_constant_boundaries(%value: reg<llvmir.i64>) -> (reg<llvmir.i64>, reg<llvmir.i64>, reg<llvmir.i64>, reg<llvmir.i64>, reg<llvmir.i64>, reg<llvmir.i64>) asm {
  %last = const.i64 31
  %left_last = shl.i64 %value, %last
  %logical_last = lshr.i64 %value, %last
  %signed_last = ashr.i64 %value, %last
  return %value, %value, %value, %left_last, %logical_last, %signed_last
}
