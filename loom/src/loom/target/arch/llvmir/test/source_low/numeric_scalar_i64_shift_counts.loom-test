low.func.def target<llvmir.generic.core>(@target) abi(object_function) @wide_shift_word_boundaries(%value: reg<llvmir.i64>) -> (reg<llvmir.i64>, reg<llvmir.i64>, reg<llvmir.i64>, reg<llvmir.i64>) asm {
  %last_low = const.i64 31
  %first_high = const.i64 32
  %last_high = const.i64 63
  %low_edge = shl.i64 %value, %last_low
  %high_edge = shl.i64 %value, %first_high
  %top_bit = shl.i64 %value, %last_high
  return %value, %low_edge, %high_edge, %top_bit
}

