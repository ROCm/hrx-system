llvmir.target<object> @target {data_layout = "e-p:64:64-i64:64-n8:16:32:64-S128", triple = "loom-direct64-unknown-none"}

func.def target(@target) @index_shift_bounded(%value: index, %count_input: index) -> (index, index, index) {
  %count = index.assume %count_input [range(%count_input, 0, 31)] : index
  %left = index.shli %value, %count : index
  %logical = index.shrui %value, %count : index
  %signed = index.shrsi %value, %count : index
  func.return %left, %logical, %signed : index, index, index
}

