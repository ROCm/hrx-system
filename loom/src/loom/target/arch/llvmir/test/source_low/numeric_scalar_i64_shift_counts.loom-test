low.func.def target<llvmir.generic.core>(@target) abi(object_function) @word_right_shift_constants(%value: reg<llvmir.i32>) -> (reg<llvmir.i32>, reg<llvmir.i32>, reg<llvmir.i32>, reg<llvmir.i32>, reg<llvmir.i32>, reg<llvmir.i32>, reg<llvmir.i32>) asm {
  %single_bit = const.i32 1
  %middle = const.i32 16
  %last = const.i32 31
  %logical_one = lshr.i32 %value, %single_bit
  %signed_one = ashr.i32 %value, %single_bit
  %logical_middle = lshr.i32 %value, %middle
  %signed_middle = ashr.i32 %value, %middle
  %logical_last = lshr.i32 %value, %last
  %signed_last = ashr.i32 %value, %last
  return %value, %logical_one, %signed_one, %logical_middle, %signed_middle, %logical_last, %signed_last
}

