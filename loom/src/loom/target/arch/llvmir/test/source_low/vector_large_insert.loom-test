llvmir.target<object> @target {data_layout = "e-p:64:64-i64:64-n8:16:32:64-S128", triple = "loom-direct64-unknown-none"}

func.def target(@target) @i64x16_insert_static(%values: vector<16xi64>, %value: i64) -> (vector<16xi64>) {
  %result = vector.insert %value into %values[1] : i64, vector<16xi64>
  func.return %result : vector<16xi64>
}

// ----
low.func.def target<llvmir.generic.core>(@target) abi(object_function) @i64x16_insert_static(%values: reg<llvmir.i64 x16>, %value: reg<llvmir.i64>) -> (reg<llvmir.i64 x16>) asm {
  %result = insert.v16i64 %values, %value, 1
  return %result
}

