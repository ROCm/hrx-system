// TEMPLATE: loom/src/loom/test/corpus/source_low/memory_workgroup_packed16.loom-test
// RUN: emit source-low output=low

llvmir.target<object> @target {triple = "amdgcn-amd-amdhsa"}

kernel.def target(@target) @lds_f16x4_b64_roundtrip() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %bytes = index.constant 512 : offset
  %scratch = buffer.alloca<workgroup> align(8) %bytes : buffer
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<64x4xf16>
  %scratch_view = buffer.view %scratch[%buffer_base] : buffer -> view<64x4xf16>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<64x4xf16>
  %loaded = vector.load %input_view[%lane, 0] : view<64x4xf16> -> vector<4xf16>
  vector.store %loaded, %scratch_view[%lane, 0] : vector<4xf16>, view<64x4xf16>
  %roundtrip = vector.load %scratch_view[%lane, 0] : view<64x4xf16> -> vector<4xf16>
  vector.store %roundtrip, %output_view[%lane, 0] : vector<4xf16>, view<64x4xf16>
  kernel.return
}

// ----
low.kernel.def target<llvmir.generic.core>(@target) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @lds_f16x4_b64_roundtrip() asm {
  %input_view = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<llvmir.ptr>
  %output_view = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<llvmir.ptr>
  %lane = kernel.workitem_id.x
  %bytes = const.i64 512
  %scratch_view = alloca.workgroup.i8 %bytes, 8
  %loaded = load.indexed.v4f16 %input_view, %lane, 0, 8
  store.indexed.v4f16 %loaded, %scratch_view, %lane, 0, 8
  %roundtrip = load.indexed.v4f16 %scratch_view, %lane, 0, 8
  store.indexed.v4f16 %roundtrip, %output_view, %lane, 0, 8
  return
}

