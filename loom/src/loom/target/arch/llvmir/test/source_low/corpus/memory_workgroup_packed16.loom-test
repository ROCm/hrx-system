llvmir.target<object> @target {triple = "amdgcn-amd-amdhsa"}

kernel.def target(@target) @lds_f16_strided_scalar_roundtrip() {
  %unit = index.constant 1 : index
  %tile = index.constant 16 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%tile, %tile, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %row = kernel.workitem.id<x> : index
  %column = kernel.workitem.id<y> : index
  %base = index.constant 0 : offset
  %bytes = index.constant 512 : offset
  %rhs_layout = encoding.layout.strided [1, 16] : encoding<layout>
  %scratch = buffer.alloca<workgroup> align(2) %bytes : buffer
  %input_view = buffer.view %input[%base] : buffer -> view<16x16xf16>
  %scratch_view = buffer.view %scratch[%base] : buffer -> view<16x16xf16, %rhs_layout>
  %output_view = buffer.view %output[%base] : buffer -> view<16x16xf16>
  %loaded = view.load %input_view[%row, %column] : view<16x16xf16> -> f16
  view.store %loaded, %scratch_view[%row, %column] : f16, view<16x16xf16, %rhs_layout>
  %roundtrip = view.load %scratch_view[%row, %column] : view<16x16xf16, %rhs_layout> -> f16
  view.store %roundtrip, %output_view[%row, %column] : f16, view<16x16xf16>
  kernel.return
}

// ----
low.kernel.def target<llvmir.generic.core>(@target) workgroup_size(16, 16, 1) workgroup_count(1, 1, 1) @lds_f16_strided_scalar_roundtrip() asm {
  %input_view = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<llvmir.ptr>
  %output_view = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<llvmir.ptr>
  %row = kernel.workitem_id.x
  %column = kernel.workitem_id.y
  %bytes = const.i64 512
  %scratch_view = alloca.workgroup.i8 %bytes, 2
  %28 = const.i64 5
  %29 = shl.i64 %row, %28
  %30 = const.i64 1
  %31 = shl.i64 %column, %30
  %32 = add.i64 %29, %31
  %loaded = load.indexed.f16 %input_view, %32, 0, 1
  %35 = shl.i64 %row, %30
  %37 = shl.i64 %column, %28
  %38 = add.i64 %35, %37
  store.indexed.f16 %loaded, %scratch_view, %38, 0, 1
  %roundtrip = load.indexed.f16 %scratch_view, %38, 0, 1
  store.indexed.f16 %roundtrip, %output_view, %32, 0, 1
  return
}
