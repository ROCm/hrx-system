llvmir.target<object> @target {data_layout = "e-p:64:64-i64:64-n8:16:32:64-S128", triple = "loom-direct64-unknown-none"}

func.def target(@target) @f32_uniform_vector_bitops(%input: buffer) -> (vector<4xf32>) {
  %base = index.constant 0 : offset
  %input_global = buffer.assume.memory_space<global> %input : buffer
  %input_noalias = buffer.assume.noalias %input_global : buffer
  %input_view = buffer.view %input_noalias[%base] : buffer -> view<4xf32>
  %loaded = vector.load %input_view[0] : view<4xf32> -> vector<4xf32>
  %negated = vector.negf %loaded : vector<4xf32>
  %absolute = vector.absf %loaded : vector<4xf32>
  %result = vector.addf %negated, %absolute : vector<4xf32>
  func.return %result : vector<4xf32>
}

// ----
low.func.def target<llvmir.generic.core>(@target) abi(object_function) @f32_uniform_vector_bitops(%input_view: reg<llvmir.ptr>) -> (reg<llvmir.f32 x4>) asm {
  %loaded = load.v4f32 %input_view, 0
  %negated = neg.v4f32 %loaded
  %absolute = abs.v4f32 %loaded
  %result = add.v4f32 %negated, %absolute
  return %result
}

