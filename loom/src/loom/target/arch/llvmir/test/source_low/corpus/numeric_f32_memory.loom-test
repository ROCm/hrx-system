kernel.def target(@target) @f32_direct_arg_scale() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%output: buffer, %scale: f32) {
  %output_base = index.constant 0 : offset
  %output_element = index.constant 0 : index
  %output_view = buffer.view %output[%output_base] : buffer -> view<1xf32>
  %unit = scalar.constant 1.0 : f32
  %scaled = scalar.mulf %unit, %scale : f32
  view.store %scaled, %output_view[%output_element] : f32, view<1xf32>
  kernel.return
}

