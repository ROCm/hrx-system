low.func.def target<llvmir.generic.core>(@target) abi(object_function) @f32_uniform_scalar_binary(%lhs_view: reg<llvmir.ptr>, %rhs_view: reg<llvmir.ptr>) -> (reg<llvmir.f32>) asm {
  %lhs = load.f32 %lhs_view, 0
  %rhs = load.f32 %rhs_view, 0
  %sum = add.f32 %lhs, %rhs
  return %sum
}

