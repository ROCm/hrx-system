low.kernel.def target<llvmir.generic.core>(@target) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @lds_atomic_minmax_i32() asm {
  %bytes = const.i64 256
  %scratch_view = alloca.workgroup.i8 %bytes, 4
  %limit = const.i32 1
