// ====

llvmir.target<object> @target {triple = "amdgcn-amd-amdhsa"}

kernel.def target(@target) @lds_atomic_second_alloca_i32() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch() {
  %tid = kernel.workitem.id<x> : index
  %scratch_base = index.constant 0 : offset
  %first_bytes = index.constant 64 : offset
  %second_bytes = index.constant 256 : offset
  %first_scratch = buffer.alloca<workgroup> align(16) %first_bytes : buffer
  %second_scratch = buffer.alloca<workgroup> align(16) %second_bytes : buffer
  %first_view = buffer.view %first_scratch[%scratch_base] : buffer -> view<16xi32>
  %second_view = buffer.view %second_scratch[%scratch_base] : buffer -> view<64xi32>
  %initial_value = scalar.constant 1 : i32
  %increment = scalar.constant 1 : i32
  view.store %initial_value, %first_view[%tid] : i32, view<16xi32>
  view.atomic.reduce<addi> %increment, %second_view[%tid] {ordering = relaxed, scope = workgroup} : i32, view<64xi32>
  %old = view.atomic.rmw<addi> %increment, %second_view[%tid] {ordering = relaxed, scope = workgroup} : i32, view<64xi32> -> i32
  kernel.return
}

// ----
low.kernel.def target<llvmir.generic.core>(@target) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @lds_atomic_second_alloca_i32() asm {
  %first_bytes = const.i64 64
  %second_bytes = const.i64 256
  %first_view = alloca.workgroup.i8 %first_bytes, 16
  %second_view = alloca.workgroup.i8 %second_bytes, 16
  %initial_value = const.i32 1
  store.i32 %initial_value, %first_view, 0
  atomic.reduce.add.i32 %initial_value, %second_view, 0, 0, 2
  %old = atomic.rmw.add.i32 %initial_value, %second_view, 0, 0, 2
  return
}
