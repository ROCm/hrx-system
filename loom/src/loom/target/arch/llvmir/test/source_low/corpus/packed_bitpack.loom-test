llvmir.target<object> @target {
  triple = "loom-direct64-unknown-none",
  data_layout = "e-p:64:64-i64:64-n8:16:32:64-S128"
}
kernel.def target(@target) @uniform_global_i32x4_to_i8x4_bitpack_store() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%values: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %index = index.constant 0 : index
  %values_noalias, %output_noalias = buffer.assume.noalias %values, %output : buffer, buffer
  %values_view = buffer.view %values_noalias[%base] : buffer -> view<4xi32>
  %output_view = buffer.view %output_noalias[%base] : buffer -> view<4xi8>
  %codes = vector.load %values_view[%index] : view<4xi32> -> vector<4xi32>
  %packed = vector.bitpack<8> %codes : vector<4xi32> -> vector<4xi8>
  vector.store %packed, %output_view[%index] : vector<4xi8>, view<4xi8>
  kernel.return
}

// ----
low.kernel.def target<llvmir.generic.core>(@target) workgroup_size(1, 1, 1) workgroup_count(1, 1, 1) @uniform_global_i32x4_to_i8x4_bitpack_store() asm {
  %values_view = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<llvmir.ptr>
  %output_view = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<llvmir.ptr>
  %38 = load.i32 %values_view, 0
  %39 = const.i32 255
  %40 = and.i32 %38, %39
  %41 = trunc.i32.i8 %40
  %42 = load.i32 %values_view, 4
  %43 = and.i32 %42, %39
  %44 = trunc.i32.i8 %43
  %45 = load.i32 %values_view, 8
  %46 = and.i32 %45, %39
  %47 = trunc.i32.i8 %46
  %48 = load.i32 %values_view, 12
  %49 = and.i32 %48, %39
  %50 = trunc.i32.i8 %49
  %packed = from_elements.v4i8 %41, %44, %47, %50
  store.v4i8 %packed, %output_view, 0
  return
}
