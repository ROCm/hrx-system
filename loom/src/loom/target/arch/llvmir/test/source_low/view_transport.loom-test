llvmir.target<object> @target {triple = "x86_64-unknown-linux-gnu"}

func.def target(@target) @distinct_root_selection(%first: buffer, %second: buffer, %condition: i1) -> (i32) {
  %first_offset = index.constant 4 : offset
  %second_offset = index.constant 8 : offset
  %first_aligned = buffer.assume.alignment %first {minimum_alignment = 4} : buffer
  %second_aligned = buffer.assume.alignment %second {minimum_alignment = 4} : buffer
  %first_view = buffer.view %first_aligned[%first_offset] : buffer -> view<1xi32>
  %second_view = buffer.view %second_aligned[%second_offset] : buffer -> view<1xi32>
  %selected = scf.select %condition, %first_view, %second_view : view<1xi32>
  %value = view.load %selected[0] : view<1xi32> -> i32
  func.return %value : i32
}

// ----
low.func.def target<llvmir.generic.core>(@target) abi(object_function) @distinct_root_selection(%first_aligned: reg<llvmir.ptr>, %second_aligned: reg<llvmir.ptr>, %condition: reg<llvmir.i1>) -> (reg<llvmir.i32>) asm {
  %first_offset = const.i64 4
  %second_offset = const.i64 8
  low.cond_br %condition, ^_bb1, ^_bb2 : reg<llvmir.i1>
^_bb1:
  low.br ^_bb3(%first_aligned: reg<llvmir.ptr>, %first_offset: reg<llvmir.i64>)
^_bb2:
  low.br ^_bb3(%second_aligned: reg<llvmir.ptr>, %second_offset: reg<llvmir.i64>)
^_bb3(%selected: reg<llvmir.ptr>, %selected_offset: reg<llvmir.i64>):
  %value = load.indexed.i32 %selected, %selected_offset, 0, 1
  return %value
}

