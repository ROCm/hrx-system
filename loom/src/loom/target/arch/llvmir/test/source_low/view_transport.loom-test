// TEMPLATE: loom/src/loom/test/corpus/source_low/view_transport.loom-test
// RUN: emit source-low output=low

llvmir.target<object> @target {triple = "x86_64-unknown-linux-gnu"}

func.def target(@target) @wide_subview_selection(%input: buffer, %byte_base0: offset, %condition: i1) -> (i32) {
  %byte_base = index.assume %byte_base0 [range(%byte_base0, 2147483648, 4294967296), mul(%byte_base0, 4)] : offset
  %aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %root = buffer.view %aligned[%byte_base] : buffer -> view<4xi32>
  %first = view.subview %root[1] : view<4xi32> -> view<1xi32>
  %second = view.subview %root[2] : view<4xi32> -> view<1xi32>
  %selected = scf.select %condition, %first, %second : view<1xi32>
  %value = view.load %selected[0] : view<1xi32> -> i32
  func.return %value : i32
}

// ----
low.func.def target<llvmir.generic.core>(@target) abi(object_function) @wide_subview_selection(%selected: reg<llvmir.ptr>, %byte_base: reg<llvmir.i64>, %condition: reg<llvmir.i1>) -> (reg<llvmir.i32>) asm {
  %24 = const.i64 4
  %25 = add.i64 %byte_base, %24
  %26 = const.i64 8
  %27 = add.i64 %byte_base, %26
  %selected_offset = select.i64 %condition, %25, %27
  %value = load.indexed.i32 %selected, %selected_offset, 0, 1
  return %value
}

