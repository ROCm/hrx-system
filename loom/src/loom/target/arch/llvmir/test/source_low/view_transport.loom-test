llvmir.target<object> @target {triple = "x86_64-unknown-linux-gnu"}

func.def public target(@target) @rotate_buffer_views(%input: buffer, %count_input: index, %seed: i32) -> (i32) {
  %count = index.assume %count_input [range(%count_input, 0, 257)] : index
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %depth = scalar.constant 4 : i32
  %storage = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %offset0 = index.constant 0 : offset
  %slot0 = buffer.view %storage[%offset0] : buffer -> view<1xi32>
  %ordinal0 = scalar.constant 0 : i32
  %initial0 = scalar.addi %seed, %ordinal0 : i32
  view.store %initial0, %slot0[0] : i32, view<1xi32>
  %offset1 = index.constant 4 : offset
  %slot1 = buffer.view %storage[%offset1] : buffer -> view<1xi32>
  %ordinal1 = scalar.constant 1 : i32
  %initial1 = scalar.addi %seed, %ordinal1 : i32
  view.store %initial1, %slot1[0] : i32, view<1xi32>
  %offset2 = index.constant 8 : offset
  %slot2 = buffer.view %storage[%offset2] : buffer -> view<1xi32>
  %ordinal2 = scalar.constant 2 : i32
  %initial2 = scalar.addi %seed, %ordinal2 : i32
  view.store %initial2, %slot2[0] : i32, view<1xi32>
  %offset3 = index.constant 12 : offset
  %slot3 = buffer.view %storage[%offset3] : buffer -> view<1xi32>
  %ordinal3 = scalar.constant 3 : i32
  %initial3 = scalar.addi %seed, %ordinal3 : i32
  view.store %initial3, %slot3[0] : i32, view<1xi32>
  %unroll = index.constant 2 : index
  %last0, %last1, %last2, %last3 = scf.for %record = [%begin to %count step %step](%current0 = %slot0 : view<1xi32>, %current1 = %slot1 : view<1xi32>, %current2 = %slot2 : view<1xi32>, %current3 = %slot3 : view<1xi32>) -> (view<1xi32>, view<1xi32>, view<1xi32>, view<1xi32>) unroll(%unroll) {
    %number = index.cast %record : index to i32
    %future = scalar.addi %number, %depth : i32
    %value = scalar.addi %seed, %future : i32
    %refined = view.refine %current0 : view<1xi32> -> view<1xi32>
    view.store %value, %refined[0] : i32, view<1xi32>
    scf.yield %current1, %current2, %current3, %refined : view<1xi32>, view<1xi32>, view<1xi32>, view<1xi32>
  }
  %value0 = view.load %last0[0] : view<1xi32> -> i32
  func.return %value0 : i32
}

// ----
low.func.def public target<llvmir.generic.core>(@target) abi(object_function) @rotate_buffer_views(%last0: reg<llvmir.ptr>, %count: reg<llvmir.i64>, %seed: reg<llvmir.i32>) -> (reg<llvmir.i32>) asm {
  %begin = const.i64 0
  %depth = const.i32 4
  store.i32 %seed, %last0, 0
  %offset1 = const.i64 4
  %ordinal1 = const.i32 1
  %initial1 = add.i32 %seed, %ordinal1
  store.i32 %initial1, %last0, 4
  %offset2 = const.i64 8
  %ordinal2 = const.i32 2
  %initial2 = add.i32 %seed, %ordinal2
  store.i32 %initial2, %last0, 8
  %offset3 = const.i64 12
  %ordinal3 = const.i32 3
  %initial3 = add.i32 %seed, %ordinal3
  store.i32 %initial3, %last0, 12
  %117 = const.i64 2
  low.br ^_bb1(%begin: reg<llvmir.i64>, %begin: reg<llvmir.i64>, %offset1: reg<llvmir.i64>, %offset2: reg<llvmir.i64>, %offset3: reg<llvmir.i64>)
^_bb1(%record: reg<llvmir.i64>, %current0_offset: reg<llvmir.i64>, %current1_offset: reg<llvmir.i64>, %current2_offset: reg<llvmir.i64>, %current3_offset: reg<llvmir.i64>):
  %118 = cmp.slt.i64 %record, %count
  low.cond_br %118, ^_bb2, ^_bb6 : reg<llvmir.i1>
^_bb2:
  %number = trunc.i64.i32 %record
  %future = add.i32 %number, %depth
  %value = add.i32 %seed, %future
  store.indexed.i32 %value, %last0, %current0_offset, 0, 1
  %122 = const.i64 1
  %record_1 = add.i64 %record, %122
  %124 = cmp.slt.i64 %record_1, %count
  low.cond_br %124, ^_bb3, ^_bb4 : reg<llvmir.i1>
^_bb3:
  %number_1 = trunc.i64.i32 %record_1
  %future_1 = add.i32 %number_1, %depth
  %value_1 = add.i32 %seed, %future_1
  store.indexed.i32 %value_1, %last0, %current1_offset, 0, 1
  low.br ^_bb5(%current2_offset: reg<llvmir.i64>, %current3_offset: reg<llvmir.i64>, %current0_offset: reg<llvmir.i64>, %current1_offset: reg<llvmir.i64>)
^_bb4:
  low.br ^_bb5(%current1_offset: reg<llvmir.i64>, %current2_offset: reg<llvmir.i64>, %current3_offset: reg<llvmir.i64>, %current0_offset: reg<llvmir.i64>)
^_bb5(%101: reg<llvmir.i64>, %102: reg<llvmir.i64>, %103: reg<llvmir.i64>, %104: reg<llvmir.i64>):
  %128 = add.i64 %record, %117
  low.br ^_bb1(%128: reg<llvmir.i64>, %101: reg<llvmir.i64>, %102: reg<llvmir.i64>, %103: reg<llvmir.i64>, %104: reg<llvmir.i64>)
^_bb6:
  %value0 = load.indexed.i32 %last0, %current0_offset, 0, 1
  return %value0
}

