llvmir.target<object> @target {triple = "amdgcn-amd-amdhsa"}

kernel.def target(@target) @dispatch_id_xy_global_b32() {
  %unit = index.constant 1 : index
  %workgroups_x = index.constant 4 : index
  %workgroups_y = index.constant 4 : index
  %workgroup_size_x = index.constant 8 : index
  %workgroup_size_y = index.constant 4 : index
  kernel.launch.config workgroups(%workgroups_x, %workgroups_y, %unit) workgroup_size(%workgroup_size_x, %workgroup_size_y, %unit) : index
} launch(%output: buffer) {
  %dispatch_column = kernel.workitem.dispatch.id<x> : index
  %dispatch_row = kernel.workitem.dispatch.id<y> : index
  %row_stride = index.constant 32 : index
  %linear = index.madd %dispatch_row, %row_stride, %dispatch_column : index
  %output_base = index.constant 0 : offset
  %output_view = buffer.view %output[%output_base] : buffer -> view<512xi32>
  %stored_value = vector.constant 1 : vector<1xi32>
  vector.store %stored_value, %output_view[%linear] : vector<1xi32>, view<512xi32>
  kernel.return
}

