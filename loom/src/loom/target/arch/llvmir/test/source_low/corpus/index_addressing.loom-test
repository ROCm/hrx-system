  %row = kernel.workitem_id.y
  %bytes = const.i64 256
  %scratch_view = alloca.workgroup.i8 %bytes, 16
  %value = const.i32 7
  store.indexed.i32 %value, %scratch_view, %row, 0, 4
  %loaded = load.indexed.i32 %scratch_view, %row, 0, 4
  store.indexed.i32 %loaded, %output_view, %row, 0, 4
  return
}

