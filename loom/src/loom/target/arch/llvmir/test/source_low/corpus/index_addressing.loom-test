  %scratch_view = buffer.view %scratch[%scratch_base] : buffer -> view<64xi32>
  %output_view = buffer.view %output[%output_base] : buffer -> view<64xi32>
  %value = vector.constant 7 : vector<1xi32>
  vector.store %value, %scratch_view[%row] : vector<1xi32>, view<64xi32>
  %loaded = vector.load %scratch_view[%row] : view<64xi32> -> vector<1xi32>
  vector.store %loaded, %output_view[%row] : vector<1xi32>, view<64xi32>
  kernel.return
}

