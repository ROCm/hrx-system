llvmir.target<object> @target {
  triple = "amdgcn-amd-amdhsa"
}
kernel.def target(@target) @i32_scalarized() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<64x4xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<64x4xi32>
  %loaded = vector.load %input_view[%lane, 0] : view<64x4xi32> -> vector<4xi32>
  %lane0 = vector.extract %loaded[0] : vector<4xi32> -> i32
  %lane1 = vector.extract %loaded[1] : vector<4xi32> -> i32
  %mask = scalar.constant 255 : i32
  %masked = scalar.andi %lane0, %mask : i32
  %shift = scalar.constant 3 : i32
  %left = scalar.shli %masked, %shift : i32
  %logical = scalar.shrui %lane1, %shift : i32
  %tag = scalar.constant 240 : i32
  %tagged = scalar.ori %left, %tag : i32
  %invert = scalar.constant -1 : i32
  %mixed = scalar.xori %tagged, %invert : i32
  %lane2 = vector.extract %loaded[2] : vector<4xi32> -> i32
  %lane3 = vector.extract %loaded[3] : vector<4xi32> -> i32
  %result = vector.from_elements %mixed, %logical, %lane2, %lane3 : vector<4xi32>
  vector.store %result, %output_view[%lane, 0] : vector<4xi32>, view<64x4xi32>
  kernel.return
}

// ----
low.kernel.def target<llvmir.generic.core>(@target) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @i32_scalarized() asm {
  %input_view = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<llvmir.ptr>
  %output_view = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<llvmir.ptr>
  %lane = kernel.workitem_id.x
  %loaded = load.indexed.v4i32 %input_view, %lane, 0, 16
  %lane0 = extract.v4i32 %loaded, 0
  %lane1 = extract.v4i32 %loaded, 1
  %mask = const.i32 255
  %masked = and.i32 %lane0, %mask
  %shift = const.i32 3
  %left = shl.i32 %masked, %shift
  %logical = lshr.i32 %lane1, %shift
  %tag = const.i32 240
  %tagged = or.i32 %left, %tag
  %invert = const.i32 -1
  %mixed = xor.i32 %tagged, %invert
  %lane2 = extract.v4i32 %loaded, 2
  %lane3 = extract.v4i32 %loaded, 3
  %result = from_elements.v4i32 %mixed, %logical, %lane2, %lane3
  store.indexed.v4i32 %result, %output_view, %lane, 0, 16
  return
}
