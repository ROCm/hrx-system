  %lane = kernel.workitem.id<x> : index
  %limit = index.constant 16 : index
  %inside = index.cmp ult, %lane, %limit : index
  %scratch_base = index.constant 0 : offset
  %bytes = index.constant 128 : offset
  %scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  %scratch_view = buffer.view %scratch[%scratch_base] : buffer -> view<32xi32>
  %stored_value = vector.constant 1 : vector<1xi32>
  vector.store %stored_value, %scratch_view[%lane] : vector<1xi32>, view<32xi32>
  scf.if %inside {
    %loaded = vector.load %scratch_view[%lane] : view<32xi32> -> vector<1xi32>
    vector.store %loaded, %scratch_view[%lane] : vector<1xi32>, view<32xi32>
  }
  kernel.return
}

// ----
low.kernel.def target<llvmir.generic.core>(@target) workgroup_size(32, 1, 1) workgroup_count(1, 1, 1) @wave_sized_workgroup_memory_guarded_lane_load_b32() asm {
  %lane = kernel.workitem_id.x
  %limit = const.i64 16
  %bytes = const.i64 128
  %scratch_view = alloca.workgroup.i8 %bytes, 16
  %stored_value = const.i32 1
  store.indexed.i32 %stored_value, %scratch_view, %lane, 0, 4
  %inside = cmp.ult.i64 %lane, %limit
  low.cond_br %inside, ^_bb1, ^_bb2 : reg<llvmir.i1>
^_bb1:
  %loaded = load.indexed.i32 %scratch_view, %lane, 0, 4
  store.indexed.i32 %loaded, %scratch_view, %lane, 0, 4
  low.br ^_bb2
^_bb2:
  return
}
