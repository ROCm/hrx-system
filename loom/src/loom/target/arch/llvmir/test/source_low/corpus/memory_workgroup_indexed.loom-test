low.kernel.def target<llvmir.generic.core>(@target) workgroup_size(32, 1, 1) workgroup_count(1, 1, 1) @wave_sized_workgroup_memory_guarded_lane_store_b32() asm {
  %lane = kernel.workitem_id.x
  %limit = const.i64 16
  %bytes = const.i64 128
  %scratch_view = alloca.workgroup.i8 %bytes, 16
  %initial = const.i32 0
  %replacement = const.i32 1
  store.indexed.i32 %initial, %scratch_view, %lane, 0, 4
  %inside = cmp.ult.i64 %lane, %limit
  low.cond_br %inside, ^_bb1, ^_bb2 : reg<llvmir.i1>
^_bb1:
  store.indexed.i32 %replacement, %scratch_view, %lane, 0, 4
  low.br ^_bb2
^_bb2:
  %loaded = load.indexed.i32 %scratch_view, %lane, 0, 4
  store.indexed.i32 %loaded, %scratch_view, %lane, 0, 4
  return
}

