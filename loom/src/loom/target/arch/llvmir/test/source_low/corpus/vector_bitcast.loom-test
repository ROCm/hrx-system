// ----
low.func.def target<llvmir.generic.core>(@target) abi(object_function) @i32x2_to_i8x8_bitcast(%words: reg<llvmir.i32 x2>) -> (reg<llvmir.i8 x8>) asm {
  %bytes = bitcast.v2i32.v8i8 %words
  return %bytes
}

