func.def target(@target) @f8e5m2_i8x4_bitcast(%floats: vector<4xf8E5M2>, %bytes: vector<4xi8>) -> (vector<4xi8>, vector<4xf8E5M2>) {
  %encoded_bits = vector.bitcast %floats : vector<4xf8E5M2> to vector<4xi8>
  %encoded = vector.bitcast %bytes : vector<4xi8> to vector<4xf8E5M2>
