// XFAIL: LLVMIR FP8 source types and bitcasts are unsupported
llvmir.target<object> @target {data_layout = "e-p:64:64-i64:64-n8:16:32:64-S128", triple = "loom-direct64-unknown-none"}

func.def target(@target) @f8e4m3_i8x4_bitcast(%floats: vector<4xf8E4M3>, %bytes: vector<4xi8>) -> (vector<4xi8>, vector<4xf8E4M3>) {
  %encoded_bits = vector.bitcast %floats : vector<4xf8E4M3> to vector<4xi8>
  %encoded = vector.bitcast %bytes : vector<4xi8> to vector<4xf8E4M3>
  func.return %encoded_bits, %encoded : vector<4xi8>, vector<4xf8E4M3>
}

