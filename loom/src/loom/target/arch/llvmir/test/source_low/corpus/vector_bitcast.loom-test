// ====

// XFAIL: LLVMIR shape-changing narrow vector bitcasts are unsupported
llvmir.target<object> @target {data_layout = "e-p:64:64-i64:64-n8:16:32:64-S128", triple = "loom-direct64-unknown-none"}

func.def target(@target) @i8x2_f16_shape_changing_bitcast(%bytes: vector<2xi8>, %half: vector<1xf16>) -> (vector<1xf16>, vector<2xi8>) {
  %to_half = vector.bitcast %bytes : vector<2xi8> to vector<1xf16>
  %to_bytes = vector.bitcast %half : vector<1xf16> to vector<2xi8>
  func.return %to_half, %to_bytes : vector<1xf16>, vector<2xi8>
}

// ====

// XFAIL: LLVMIR shape-changing narrow vector bitcasts are unsupported
llvmir.target<object> @target {data_layout = "e-p:64:64-i64:64-n8:16:32:64-S128", triple = "loom-direct64-unknown-none"}

func.def target(@target) @i8x2_bf16_shape_changing_bitcast(%bytes: vector<2xi8>, %half: vector<1xbf16>) -> (vector<1xbf16>, vector<2xi8>) {
  %to_half = vector.bitcast %bytes : vector<2xi8> to vector<1xbf16>
  %to_bytes = vector.bitcast %half : vector<1xbf16> to vector<2xi8>
  func.return %to_half, %to_bytes : vector<1xbf16>, vector<2xi8>
}

