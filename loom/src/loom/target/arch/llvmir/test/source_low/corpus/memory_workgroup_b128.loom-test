llvmir.target<object> @target {triple = "amdgcn-amd-amdhsa"}

kernel.def target(@target) @lds_b128_xor_swizzle_roundtrip() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %bytes = index.constant 1024 : offset
  %scratch = buffer.alloca<workgroup> align(16) %bytes : buffer
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<64x4xi32>
  %scratch_view = buffer.view %scratch[%buffer_base] : buffer -> view<64x4xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<64x4xi32>
  %shift = index.constant 4 : index
  %shifted = index.shrui %lane, %shift : index
  %mask = index.constant 3 : index
  %swizzle_bits = index.andi %shifted, %mask : index
  %swizzled = index.xori %lane, %swizzle_bits : index
  %loaded = vector.load %input_view[%lane, 0] : view<64x4xi32> -> vector<4xi32>
  vector.store %loaded, %scratch_view[%swizzled, 0] : vector<4xi32>, view<64x4xi32>
  %roundtrip = vector.load %scratch_view[%swizzled, 0] : view<64x4xi32> -> vector<4xi32>
  vector.store %roundtrip, %output_view[%lane, 0] : vector<4xi32>, view<64x4xi32>
  kernel.return
}

// ----
low.kernel.def target<llvmir.generic.core>(@target) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @lds_b128_xor_swizzle_roundtrip() asm {
  %input_view = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<llvmir.ptr>
  %output_view = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<llvmir.ptr>
  %lane = kernel.workitem_id.x
  %bytes = const.i64 1024
  %scratch_view = alloca.workgroup.i8 %bytes, 16
  %shift = const.i64 4
  %shifted = lshr.i64 %lane, %shift
  %mask = const.i64 3
  %swizzle_bits = and.i64 %shifted, %mask
  %swizzled = xor.i64 %lane, %swizzle_bits
  %loaded = load.indexed.v4i32 %input_view, %lane, 0, 16
  store.indexed.v4i32 %loaded, %scratch_view, %swizzled, 0, 16
  %roundtrip = load.indexed.v4i32 %scratch_view, %swizzled, 0, 16
  store.indexed.v4i32 %roundtrip, %output_view, %lane, 0, 16
  return
}

