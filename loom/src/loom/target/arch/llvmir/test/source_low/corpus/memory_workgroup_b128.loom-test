  %lane = kernel.workitem_id.x
  %bytes = const.i64 4096
  %scratch_view = alloca.workgroup.i8 %bytes, 16
  %loaded = load.indexed.v4i32 %input_view, %lane, 0, 16
  store.indexed.v4i32 %loaded, %scratch_view, %lane, 1024, 16
  %roundtrip = load.indexed.v4i32 %scratch_view, %lane, 1024, 16
  store.indexed.v4i32 %roundtrip, %output_view, %lane, 0, 16
  return
}

// ====

llvmir.target<object> @target {triple = "amdgcn-amd-amdhsa"}

kernel.def target(@target) @lds_b128_split_second_alloca_roundtrip() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %buffer_base = index.constant 0 : offset
  %first_bytes = index.constant 64 : offset
  %second_bytes = index.constant 2048 : offset
  %first = buffer.alloca<workgroup> align(16) %first_bytes : buffer
  %second = buffer.alloca<workgroup> align(16) %second_bytes : buffer
  %first_view = buffer.view %first[%buffer_base] : buffer -> view<16xi32>
  %second_view = buffer.view %second[%buffer_base] : buffer -> view<64x8xi32>
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<64x8xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<64x8xi32>
  %loaded = vector.load %input_view[%lane, 0] : view<64x8xi32> -> vector<8xi32>
  vector.store %loaded, %second_view[%lane, 0] : vector<8xi32>, view<64x8xi32>
  %roundtrip = vector.load %second_view[%lane, 0] : view<64x8xi32> -> vector<8xi32>
  vector.store %roundtrip, %output_view[%lane, 0] : vector<8xi32>, view<64x8xi32>
  %sentinel = view.load %first_view[0] : view<16xi32> -> i32
  view.store %sentinel, %first_view[1] : i32, view<16xi32>
  kernel.return
}

// ----
low.kernel.def target<llvmir.generic.core>(@target) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @lds_b128_split_second_alloca_roundtrip() asm {
  %input_view = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<llvmir.ptr>
  %output_view = resource<hal_binding> {index = 1, source_type = hal.buffer} : reg<llvmir.ptr>
  %lane = kernel.workitem_id.x
  %first_bytes = const.i64 64
  %second_bytes = const.i64 2048
  %first_view = alloca.workgroup.i8 %first_bytes, 16
  %second_view = alloca.workgroup.i8 %second_bytes, 16
  %loaded = load.indexed.v8i32 %input_view, %lane, 0, 32
  store.indexed.v8i32 %loaded, %second_view, %lane, 0, 32
  %roundtrip = load.indexed.v8i32 %second_view, %lane, 0, 32
  store.indexed.v8i32 %roundtrip, %output_view, %lane, 0, 32
  %sentinel = load.i32 %first_view, 0
  store.i32 %sentinel, %first_view, 4
  return
}
