llvmir.target<object> @target {data_layout = "e-p:64:64-i64:64-n8:16:32:64-S128", triple = "loom-direct64-unknown-none"}

func.def target(@target) @index_minmax_sgpr(%lhs0: index, %rhs0: index) -> (index) {
  %lhs = index.assume %lhs0 [range(%lhs0, -1024, 1024)] : index
  %rhs = index.assume %rhs0 [range(%rhs0, -1024, 1024)] : index
  %min = index.min %lhs, %rhs : index
  %max = index.max %lhs, %rhs : index
  %sum = index.add %min, %max : index
  func.return %sum : index
}

// ----
low.func.def target<llvmir.generic.core>(@target) abi(object_function) @index_minmax_sgpr(%lhs: reg<llvmir.i64>, %rhs: reg<llvmir.i64>) -> (reg<llvmir.i64>) asm {
  %11 = cmp.slt.i64 %lhs, %rhs
  %min = select.i64 %11, %lhs, %rhs
  %13 = cmp.sgt.i64 %lhs, %rhs
  %max = select.i64 %13, %lhs, %rhs
  %sum = add.i64 %min, %max
  return %sum
}

