llvmir.target<object> @target {triple = "amdgcn-amd-amdhsa"}

kernel.def target(@target) @index_minmax_vgpr_select() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %limit = index.constant 31 : index
  %min = index.min %lane, %limit : index
  %max = index.max %lane, %limit : index
  %cond = index.cmp slt, %lane, %limit : index
  %selected = scf.select %cond, %min, %max : index
  %output_base = index.constant 0 : offset
  %output_view = buffer.view %output[%output_base] : buffer -> view<64xi32>
  %stored = vector.constant 1 : vector<1xi32>
  vector.store %stored, %output_view[%selected] : vector<1xi32>, view<64xi32>
  kernel.return
}

// ----
low.kernel.def target<llvmir.generic.core>(@target) workgroup_size(64, 1, 1) workgroup_count(1, 1, 1) @index_minmax_vgpr_select() asm {
  %output_view = resource<hal_binding> {index = 0, source_type = hal.buffer} : reg<llvmir.ptr>
  %lane = kernel.workitem_id.x
  %limit = const.i64 31
  %15 = cmp.slt.i64 %lane, %limit
  %min = select.i64 %15, %lane, %limit
  %17 = cmp.sgt.i64 %lane, %limit
  %max = select.i64 %17, %lane, %limit
  %selected = select.i64 %15, %min, %max
  %stored = const.i32 1
  store.indexed.i32 %stored, %output_view, %selected, 0, 4
  return
}

