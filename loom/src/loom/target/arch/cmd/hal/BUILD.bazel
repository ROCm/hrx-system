load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_cc_library(
    name = "recording",
    srcs = ["recording.c"],
    hdrs = ["recording.h"],
    visibility = ["//loom/binding/c/target/cmd:__subpackages__"],
    deps = [
        "//loom/src/loom/target/arch/cmd:program",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base:core_headers",
        "//runtime/src/iree/hal",
    ],
)
