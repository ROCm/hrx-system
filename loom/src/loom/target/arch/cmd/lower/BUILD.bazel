load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_cc_library(
    name = "schedule",
    srcs = ["schedule.c"],
    hdrs = ["schedule.h"],
    deps = [
        "//loom/src/loom/ir",
        "//loom/src/loom/ops/buffer",
        "//loom/src/loom/ops/command",
        "//loom/src/loom/ops/kernel",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
    ],
)

loom_cc_library(
    name = "program_composition",
    srcs = ["program_composition.c"],
    hdrs = ["program_composition.h"],
    deps = [
        "//loom/src/loom/analysis:scc",
        "//loom/src/loom/analysis:symbol_dependencies",
        "//loom/src/loom/error:emitter",
        "//loom/src/loom/error:error_defs",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/pass:value_facts",
        "//loom/src/loom/rewrite:callable",
        "//loom/src/loom/rewrite:rewriter",
        "//loom/src/loom/transforms/cleanup:canonicalize",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
    ],
)
