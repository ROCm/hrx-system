load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_library",
)

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_cc_library(
    name = "abi_layout",
    srcs = ["abi_layout.c"],
    hdrs = ["abi_layout.h"],
    visibility = ["//loom/src/loom/target/arch/cmd:__subpackages__"],
    deps = [
        "//loom/src/loom/ir",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "artifact_set",
    srcs = ["artifact_set.c"],
    hdrs = ["artifact_set.h"],
    visibility = [
        "//loom/binding/c/target/cmd:__pkg__",
        "//loom/src/loom/target/arch/cmd:__subpackages__",
    ],
    deps = [
        "//loom/src/loom/codegen/low:text_asm",
        "//loom/src/loom/format/text:printer",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/target/arch/cmd/descriptors:low_registry",
        "//loom/src/loom/target/arch/cmd/lower:program_plan",
        "//loom/src/loom/target/arch/cmd/lower:serialize",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "provider",
    srcs = ["provider.c"],
    hdrs = ["provider.h"],
    visibility = [
        "//loom/src/loom/target/configured:__pkg__",
    ],
    deps = [
        "//loom/src/loom/target:provider",
        "//loom/src/loom/target/arch/cmd/descriptors:low_registry",
        "//runtime/src/iree/base",
    ],
)
