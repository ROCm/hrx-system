load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_library",
    "loom_cc_test",
)

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

package_group(
    name = "hal_command_buffer_consumers",
    packages = [
        "//loom/src/loom/serve/runtime/program",
        "//loom/src/loom/tooling/execution/hal",
    ],
)

loom_cc_library(
    name = "abi_layout",
    srcs = ["abi_layout.c"],
    hdrs = ["abi_layout.h"],
    visibility = ["//loom/src/loom/target/arch/cmd:__subpackages__"],
    deps = [
        "//loom/src/loom/ir",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "program",
    srcs = [
        "format.c",
        "program.c",
    ],
    hdrs = [
        "format.h",
        "program.h",
    ],
    # Serialized command readers own neither compiler IR nor process state.
    tags = ["LINKABLE_MORE_THAN_ONCE"],
    visibility = [
        "//loom/binding/c/test/target/amdgpu:__pkg__",
        "//loom/src/loom/serve:implementation",
        "//loom/src/loom/target/arch/cmd:__subpackages__",
        "//loom/src/loom/tooling/execution/hal:__pkg__",
    ],
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/base:core_headers",
    ],
)

loom_cc_library(
    name = "hal_command_buffer",
    srcs = ["hal_command_buffer.c"],
    hdrs = ["hal_command_buffer.h"],
    visibility = [":hal_command_buffer_consumers"],
    deps = [
        ":program",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base:core_headers",
        "//runtime/src/iree/hal",
    ],
)

loom_cc_library(
    name = "artifact_set",
    srcs = ["artifact_set.c"],
    hdrs = ["artifact_set.h"],
    visibility = [
        "//loom/binding/c/target/cmd:__pkg__",
        "//loom/src/loom/target/arch/cmd:__subpackages__",
    ],
    deps = [
        "//loom/src/loom/codegen/low:text_asm",
        "//loom/src/loom/format/text:printer",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/target/arch/cmd/descriptors:low_registry",
        "//loom/src/loom/target/arch/cmd/lower:program_plan",
        "//loom/src/loom/target/arch/cmd/lower:serialize",
        "//runtime/src/iree/base",
    ],
)

loom_cc_test(
    name = "program_test",
    srcs = ["program_test.cc"],
    deps = [
        ":program",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base:core_headers",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_test(
    name = "hal_command_buffer_test",
    srcs = ["hal_command_buffer_test.cc"],
    deps = [
        ":hal_command_buffer",
        ":program",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base:core_headers",
        "//runtime/src/iree/hal",
        "//runtime/src/iree/hal/cts/util:registry",
        "//runtime/src/iree/hal/cts/util:test_base",
        "//runtime/src/iree/hal/cts/util:test_main",
        "//runtime/src/iree/hal/drivers/task/cts:backends",
        "//runtime/src/iree/testing:gtest",
    ],
)

loom_cc_library(
    name = "provider",
    srcs = ["provider.c"],
    hdrs = ["provider.h"],
    visibility = [
        "//loom/src/loom/target/configured:__pkg__",
    ],
    deps = [
        "//loom/src/loom/target:provider",
        "//loom/src/loom/target/arch/cmd/descriptors:low_registry",
        "//runtime/src/iree/base",
    ],
)
