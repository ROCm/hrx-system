load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_library",
    "loom_cc_test",
)
load(
    "//loom/build_tools/bazel:loom_check.bzl",
    "loom_check_test_suite",
)

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_cc_library(
    name = "abi_layout",
    srcs = ["abi_layout.c"],
    hdrs = ["abi_layout.h"],
    visibility = ["//loom/src/loom/target/arch/cmd:__subpackages__"],
    deps = [
        "//loom/src/loom/ir",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "program",
    srcs = [
        "format.c",
        "program.c",
    ],
    hdrs = [
        "format.h",
        "program.h",
    ],
    visibility = ["//loom/src/loom/target/arch/cmd:__subpackages__"],
    deps = [
        "//runtime/src/iree/base",
        "//runtime/src/iree/base:core_headers",
    ],
)

loom_cc_test(
    name = "program_test",
    srcs = ["program_test.cc"],
    deps = [
        ":program",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base:core_headers",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "package",
    srcs = [
        "package.c",
        "package_format.c",
    ],
    hdrs = [
        "package.h",
        "package_format.h",
    ],
    visibility = ["//loom:__subpackages__"],
    deps = [
        ":program",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base:core_headers",
    ],
)

loom_cc_test(
    name = "package_test",
    srcs = ["package_test.cc"],
    deps = [
        ":package",
        ":program",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base:core_headers",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "provider",
    srcs = ["provider.c"],
    hdrs = ["provider.h"],
    visibility = [
        "//loom/src/loom/target/all:__pkg__",
        "//loom/src/loom/target/arch/cmd/check:__pkg__",
    ],
    deps = [
        "//loom/src/loom/target:provider",
        "//loom/src/loom/target/arch/cmd/descriptors:low_registry",
        "//runtime/src/iree/base",
    ],
)

loom_check_test_suite(
    name = "loom_check_file_test",
    srcs = [
        "test/bytecode.loom-test",
        "test/diagnostics.loom-test",
        "test/kernel_units.loom-test",
        "test/low.loom-test",
        "test/preparation.loom-test",
        "test/roundtrip.loom-test",
        "test/scheduling.loom-test",
        "test/storage.loom-test",
    ],
)
