load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_library",
    "loom_low_descriptor_cc_library",
)

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_low_descriptor_cc_library(
    name = "descriptors",
    args = ["--descriptor-set=cmd_core"],
    generator = "//loom/py/loom/gen/target/low:cmd_low_descriptor_shard",
    visibility = ["//loom/src/loom/target/arch/cmd:__subpackages__"],
    deps = ["//loom/src/loom/codegen/low:descriptors"],
)

loom_cc_library(
    name = "low_registry",
    srcs = ["low_registry.c"],
    hdrs = ["low_registry.h"],
    visibility = ["//loom/src/loom/target/arch/cmd:__pkg__"],
    deps = [
        ":descriptors",
        "//loom/src/loom/codegen/low:descriptors",
        "//loom/src/loom/target:low_descriptor_registry",
        "//runtime/src/iree/base",
    ],
)
