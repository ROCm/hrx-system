  %13 = resource<command_input> {index = 1, source_type = buffer} : reg<cmd.binding>
  %14 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %15 = resource<command_input> {index = 1, source_type = index} : reg<cmd.executable>
  %16 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %17 = resource<command_input> {index = 1, source_type = index} : reg<cmd.entry>
  %18 = cmd.constant.u64 0
  %19 = cmd.constant.u64 -1
  %20 = cmd.constant.u64 12
  %21 = cmd.constant.u64 16
  %22 = cmd.constant.u32 1
  cmd.dispatch.direct<%14, %16>[%22, %22, %22](%13, %18, %20)
  %23 = cmd.buffer.ref.binding %13, %18, %20
  cmd.dispatch.indirect.dynamic.barrier<%15, %17>[%23](%12, %18, %19, %13, %20, %21)
  return
}

