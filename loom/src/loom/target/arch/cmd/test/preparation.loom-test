// RUN: emit command-program @q4_q4,@q4_q6,@q6_q4,@q6_q6

config.def @quant.q4 = #ggml.q4_0 : encoding<schema>
config.def @quant.q6 = #ggml.q6_k : encoding<schema>

kernel.def @gate_q4() {
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  kernel.launch.config workgroups(%c4, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%storage: buffer) {
  kernel.return
}

kernel.def @gate_q6() {
  %c1 = index.constant 1 : index
  %c6 = index.constant 6 : index
  kernel.launch.config workgroups(%c6, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%storage: buffer) {
  kernel.return
}

kernel.def @down_q4() {
  %c1 = index.constant 1 : index
  %c40 = index.constant 40 : index
  kernel.launch.config workgroups(%c40, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%storage: buffer) {
  kernel.return
}

kernel.def @down_q6() {
  %c1 = index.constant 1 : index
  %c60 = index.constant 60 : index
  kernel.launch.config workgroups(%c60, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%storage: buffer) {
  kernel.return
}

command.program.def @quantized_pair(%gate_schema: encoding<schema>, %down_schema: encoding<schema>) launch(%storage: buffer) {
  %gate_is_q4 = encoding.isa<#ggml.q4_0> %gate_schema : encoding<schema>
  scf.if %gate_is_q4 {
    kernel.launch @gate_q4(%storage) : (buffer)
  } else {
    kernel.launch @gate_q6(%storage) : (buffer)
  }
  %down_is_q4 = encoding.isa<#ggml.q4_0> %down_schema : encoding<schema>
  scf.if %down_is_q4 {
    kernel.launch @down_q4(%storage) : (buffer)
  } else {
    kernel.launch @down_q6(%storage) : (buffer)
  }
  command.return
}

command.program.def public @q4_q4() launch(%storage: buffer) {
  %q4 = config.get @quant.q4 : encoding<schema>
  command.program.launch @quantized_pair[%q4, %q4](%storage) : [encoding<schema>, encoding<schema>](buffer)
  command.return
}

command.program.def public @q4_q6() launch(%storage: buffer) {
  %q4 = config.get @quant.q4 : encoding<schema>
  %q6 = config.get @quant.q6 : encoding<schema>
  command.program.launch @quantized_pair[%q4, %q6](%storage) : [encoding<schema>, encoding<schema>](buffer)
  command.return
}

command.program.def public @q6_q4() launch(%storage: buffer) {
  %q4 = config.get @quant.q4 : encoding<schema>
  %q6 = config.get @quant.q6 : encoding<schema>
  command.program.launch @quantized_pair[%q6, %q4](%storage) : [encoding<schema>, encoding<schema>](buffer)
  command.return
}

command.program.def public @q6_q6() launch(%storage: buffer) {
  %q6 = config.get @quant.q6 : encoding<schema>
  command.program.launch @quantized_pair[%q6, %q6](%storage) : [encoding<schema>, encoding<schema>](buffer)
  command.return
}

