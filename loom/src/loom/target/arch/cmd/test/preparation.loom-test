// RUN: emit command-program @mixed_dispatch

kernel.def @local_entry() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%output: buffer) {
  kernel.return
}

kernel.entry.decl @provided_entry(%output: buffer) where [workgroup_size(64, 1, 1)]

command.program.def public @mixed_dispatch() launch(%output: buffer) {
  %c2 = index.constant 2 : index
  kernel.launch @local_entry(%output) : (buffer)
  kernel.dispatch @provided_entry[%c2](%output) : [index](buffer)
  command.return
}

