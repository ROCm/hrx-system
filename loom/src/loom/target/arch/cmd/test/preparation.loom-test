// RUN: emit command-program @unrolled_targetless

kernel.def @copy_element() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%source: buffer, %target: buffer) {
  %base = index.constant 0 : offset
  %element = index.constant 0 : index
  %source_view = buffer.view %source[%base] : buffer -> view<1xi32>
  %target_view = buffer.view %target[%base] : buffer -> view<1xi32>
  %value = view.load %source_view[%element] : view<1xi32> -> i32
  view.store %value, %target_view[%element] : i32, view<1xi32>
  kernel.return
}

command.program.def public @unrolled_targetless() launch(%source: buffer, %target: buffer) {
  %loop_begin = index.constant 0 : index
  %loop_end = index.constant 2 : index
  %loop_step = index.constant 1 : index
  scf.for %iteration = [%loop_begin to %loop_end step %loop_step] unroll {
    kernel.launch @copy_element(%source, %target) : (buffer, buffer)
  }
  command.return
}

// ----
low.func.def public retain target<cmd.core> abi(command_program) abi_layout({entry_count = 1, executable_count = 1, fixed_buffer_count = 0, rebindable_binding_count = 2}) @unrolled_targetless() asm {
  %0 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %1 = resource<command_input> {index = 1, source_type = buffer} : reg<cmd.binding>
  %2 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %3 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %4 = cmd.constant.u64 0
  %5 = cmd.constant.u64 -1
  %6 = cmd.constant.u32 1
  cmd.dispatch.direct<%2, %3>[%6, %6, %6](%0, %4, %5, %1, %4, %5)
  cmd.dispatch.direct.barrier<%2, %3>[%6, %6, %6](%0, %4, %5, %1, %4, %5)
  return
}

