  %22 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %23 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %24 = cmd.constant.u64 0
  %25 = cmd.constant.u64 -1
  %26 = cmd.constant.u64 64
  %27 = cmd.constant.u32 1
  cmd.dispatch.direct<%22, %23>[%27, %27, %27](%19, %24, %25, %21, %26, %26)
  cmd.dispatch.direct.barrier<%22, %23>[%27, %27, %27](%21, %24, %26, %20, %24, %25)
  return
}

