// RUN: emit command-program @bodyless_dispatch

kernel.entry.decl @configured_a(%scale: i8, %fp8e4: f8E4M3, %fp8e5: f8E5M2, %gain: f16, %offset: bf16, %bias: f32, %threshold: f64, %slice: view<4xi32>, %output: buffer)
kernel.entry.decl @configured_b(%output: buffer)

command.program.def public @bodyless_dispatch() launch(%output: buffer) {
  %count_x = index.constant 7 : index
  %count_y = index.constant 3 : index
  %c0 = index.constant 0 : offset
  %scale = scalar.constant -1 : i8
  %fp8e4 = scalar.constant 1.0 : f8E4M3
  %fp8e5 = scalar.constant 1.0 : f8E5M2
  %gain = scalar.constant -2.0 : f16
  %offset = scalar.constant 1.0 : bf16
  %bias = scalar.constant 1.5 : f32
  %threshold = scalar.constant 0x1.0000000000001p0 : f64
  %slice = buffer.view %output[%c0] : buffer -> view<4xi32>
  command.concurrent {
    kernel.dispatch @configured_a[%count_x, %count_y](%scale, %fp8e4, %fp8e5, %gain, %offset, %bias, %threshold, %slice, %output) : [index, index](i8, f8E4M3, f8E5M2, f16, bf16, f32, f64, view<4xi32>, buffer)
    kernel.dispatch @configured_a[%count_x, %count_y](%scale, %fp8e4, %fp8e5, %gain, %offset, %bias, %threshold, %slice, %output) : [index, index](i8, f8E4M3, f8E5M2, f16, bf16, f32, f64, view<4xi32>, buffer)
  }
  kernel.dispatch @configured_b[%count_x](%output) : [index](buffer)
  command.return
}

