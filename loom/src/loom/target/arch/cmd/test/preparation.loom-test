// RUN: emit command-program @dynamic_indirect_dispatch

kernel.entry.decl @produce_counts(%counts: view<3xi32>) where [workgroup_size(64, 1, 1)]
kernel.entry.decl @consume_counts(%output: buffer, %scratch: view<4xi32>) where [workgroup_size(64, 1, 1)]

command.program.def public @dynamic_indirect_dispatch() launch(%output: buffer) {
  %c0 = index.constant 0 : offset
  %c1 = index.constant 1 : index
  %count_bytes = index.constant 12 : offset
  %count_storage = buffer.alloca<global> align(4) %count_bytes : buffer
  %counts = buffer.view %count_storage[%c0] : buffer -> view<3xi32>
  kernel.dispatch @produce_counts[%c1](%counts) : [index](view<3xi32>)
  %scratch_bytes = index.constant 16 : offset
  %scratch_storage = buffer.alloca<global> align(4) %scratch_bytes : buffer
  %scratch = buffer.view %scratch_storage[%c0] : buffer -> view<4xi32>
  kernel.dispatch @consume_counts[%counts](%output, %scratch) : [view<3xi32>](buffer, view<4xi32>)
  command.return
}

