  %41 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %42 = resource<command_input> {index = 1, source_type = buffer} : reg<cmd.binding>
  %43 = resource<command_input> {index = 2, source_type = buffer} : reg<cmd.binding>
  %44 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %45 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %46 = cmd.constant.u64 0
  %47 = cmd.constant.u64 -1
  %48 = cmd.constant.u32 1
  cmd.dispatch.direct<%44, %45>[%48, %48, %48](%41, %46, %47, %42, %46, %47)
  cmd.dispatch.direct.barrier<%44, %45>[%48, %48, %48](%42, %46, %47, %43, %46, %47)
