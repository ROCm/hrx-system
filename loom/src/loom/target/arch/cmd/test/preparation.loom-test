// RUN: emit command-program @transient_direct_dispatch

kernel.entry.decl @consume_transient(%scratch: buffer)

command.program.def public @transient_direct_dispatch() launch() {
  %count = index.constant 1 : index
  %scratch_bytes = index.constant 64 : offset
  %scratch = buffer.alloca<global> align(64) %scratch_bytes : buffer
  kernel.dispatch @consume_transient[%count](%scratch) : [index](buffer)
  command.return
}

