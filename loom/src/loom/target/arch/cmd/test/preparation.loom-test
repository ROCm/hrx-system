// RUN: emit command-program @exact_composition

kernel.def @one_group() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%storage: buffer) {
  kernel.return
}

kernel.def @two_groups() {
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  kernel.launch.config workgroups(%c2, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%storage: buffer) {
  kernel.return
}

command.program.def @shape_program(%token_count: index) launch(%storage: buffer) where [range(%token_count, 1, 512)] {
  %c512 = index.constant 512 : index
  %is_full_shape = index.cmp eq, %token_count, %c512 : index
  scf.if %is_full_shape {
    kernel.launch @one_group(%storage) : (buffer)
  } else {
    kernel.launch @two_groups(%storage) : (buffer)
  }
  command.return
}

command.program.def public @exact_composition() launch(%storage: buffer) {
  %token_count = index.constant 512 : index
  command.program.launch @shape_program[%token_count](%storage) : [index](buffer)
  command.return
}

