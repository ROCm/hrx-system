low.func.def public retain target<cmd.core> abi(command_program) abi_layout({entry_count = 2, executable_count = 2, fixed_buffer_count = 0, rebindable_binding_count = 3}) @increment_then_double() asm {
  %49 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %50 = resource<command_input> {index = 1, source_type = buffer} : reg<cmd.binding>
