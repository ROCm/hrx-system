  %0 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %1 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %2 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %3 = cmd.constant.u64 0
  %4 = cmd.constant.u64 -1
  %5 = cmd.constant.u32 1
  cmd.dispatch.direct<%1, %2>[%5, %5, %5]()
  return
}

