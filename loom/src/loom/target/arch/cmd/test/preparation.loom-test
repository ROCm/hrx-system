// RUN: emit command-launch-config @prefill

config.def @project.bias = 1 : index

kernel.def @project(%row_count: index) {
  %bias = config.get @project.bias : index
  %row_groups = index.add %row_count, %bias : index
  kernel.launch.config workgroups(%row_groups, %bias, %bias) workgroup_size(%bias, %bias, %bias) : index
} launch(%storage: buffer) {
  kernel.return
}

command.program.def public @prefill(%token_count: index) launch(%storage: buffer) where [range(%token_count, 1, 512)] {
  %c1 = index.constant 1 : index
  kernel.launch.serial {
    kernel.launch.concurrent {
      kernel.launch @project[%token_count](%storage) : [index](buffer)
      kernel.launch @project[%token_count](%storage) : [index](buffer)
    }
    kernel.launch @project[%c1](%storage) : [index](buffer)
  }
  command.return
}

// ----
func.def public retain pure @prefill(%token_count: index) -> (index, index, index) where [range(%token_count, 1, 512)] {
  %bias = index.constant 1 : index
  %row_groups = index.add %token_count, %bias : index
  func.return %row_groups, %bias, %bias : index, index, index
}

// ====

// RUN: emit command-program @waves

kernel.def @copy(%element_count: index) {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%element_count, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%source: buffer, %target: buffer) {
  %base = index.constant 0 : offset
  %workgroup = kernel.workgroup.id<x> : index
  %source_view = buffer.view %source[%base] : buffer -> view<128xi32>
  %target_view = buffer.view %target[%base] : buffer -> view<128xi32>
  %value = view.load %source_view[%workgroup] : view<128xi32> -> i32
  view.store %value, %target_view[%workgroup] : i32, view<128xi32>
  kernel.return
}

command.program.def public @waves(%element_count: index) launch(%source: buffer, %first: buffer, %second: buffer, %target: buffer) where [range(%element_count, 1, 128)] {
  kernel.launch.serial {
    kernel.launch.concurrent {
      kernel.launch @copy[%element_count](%source, %first) : [index](buffer, buffer)
      kernel.launch @copy[%element_count](%source, %second) : [index](buffer, buffer)
    }
    kernel.launch @copy[%element_count](%second, %target) : [index](buffer, buffer)
  }
  command.return
}

// ----
low.func.def public retain target<cmd.core> abi(command_program) abi_layout({entry_count = 1, executable_count = 1, fixed_buffer_count = 0, rebindable_binding_count = 5}) @waves() asm {
  %0 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %1 = resource<command_input> {index = 1, source_type = buffer} : reg<cmd.binding>
  %2 = resource<command_input> {index = 2, source_type = buffer} : reg<cmd.binding>
  %3 = resource<command_input> {index = 3, source_type = buffer} : reg<cmd.binding>
  %4 = resource<command_input> {index = 4, source_type = buffer} : reg<cmd.binding>
  %5 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %6 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %7 = cmd.constant.u64 0
  %8 = cmd.constant.u64 -1
  %9 = cmd.constant.u64 12
  %10 = cmd.buffer.ref.binding %4, %7, %9
  cmd.dispatch.indirect.static<%5, %6>[%10](%0, %7, %8, %1, %7, %8)
  cmd.dispatch.indirect.static<%5, %6>[%10](%0, %7, %8, %2, %7, %8)
  cmd.dispatch.indirect.static.barrier<%5, %6>[%10](%2, %7, %8, %3, %7, %8)
  return
}

