// RUN: emit command-program @waves

kernel.def @copy() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%source: buffer, %target: buffer) {
  %base = index.constant 0 : offset
  %workgroup = kernel.workgroup.id<x> : index
  %source_view = buffer.view %source[%base] : buffer -> view<128xi32>
  %target_view = buffer.view %target[%base] : buffer -> view<128xi32>
  %value = view.load %source_view[%workgroup] : view<128xi32> -> i32
  view.store %value, %target_view[%workgroup] : i32, view<128xi32>
  kernel.return
}

command.program.def public @waves() launch(%source: buffer, %first: buffer, %second: buffer, %target: buffer) {
  kernel.launch.serial {
    kernel.launch.concurrent {
      kernel.launch @copy(%source, %first) : (buffer, buffer)
      kernel.launch @copy(%source, %second) : (buffer, buffer)
    }
    kernel.launch @copy(%second, %target) : (buffer, buffer)
  }
  command.return
}

// ----
low.func.def public retain target<cmd.core> abi(command_program) abi_layout({entry_count = 1, executable_count = 1, fixed_buffer_count = 0, rebindable_binding_count = 4}) @waves() asm {
  %21 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %22 = resource<command_input> {index = 1, source_type = buffer} : reg<cmd.binding>
  %23 = resource<command_input> {index = 2, source_type = buffer} : reg<cmd.binding>
  %24 = resource<command_input> {index = 3, source_type = buffer} : reg<cmd.binding>
  %25 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %26 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %27 = cmd.constant.u64 0
  %28 = cmd.constant.u64 -1
  %29 = cmd.constant.u32 1
  cmd.dispatch.direct<%25, %26>[%29, %29, %29](%21, %27, %28, %22, %27, %28)
  cmd.dispatch.direct<%25, %26>[%29, %29, %29](%21, %27, %28, %23, %27, %28)
  cmd.dispatch.direct.barrier<%25, %26>[%29, %29, %29](%23, %27, %28, %24, %27, %28)
  return
}

// ====

// Command helpers are specialized at their call sites before bare-unroll loops
// are expanded. The helper accepts counts 2 through 4, while the selected root
// emits exactly the two dispatches requested by its constant argument.
// RUN: emit command-program @unrolled_nested

kernel.entry.decl @step()

command.program.def @batch(%count: index) launch() where [range(%count, 2, 4)] {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  scf.for %i = [%c0 to %count step %c1] unroll {
    kernel.dispatch @step[%c1]() : [index]()
  }
  command.return
}

command.program.def public @unrolled_nested() launch() {
  %count = index.constant 2 : index
  command.program.launch @batch[%count]() : [index]()
  command.return
}

// ----
low.func.def public retain target<cmd.core> abi(command_program) abi_layout({entry_count = 1, executable_count = 1, fixed_buffer_count = 0, rebindable_binding_count = 0}) @unrolled_nested() asm {
  %8 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %9 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %10 = cmd.constant.u32 1
  cmd.dispatch.direct<%8, %9>[%10, %10, %10]()
  cmd.dispatch.direct.barrier<%8, %9>[%10, %10, %10]()
  return
}

// ====

// RUN: emit command-program @parameterized

kernel.def @combine() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%lhs: view<3xi32>, %rhs: view<4xi32>, %target: buffer, %unused: buffer) {
  %c0 = index.constant 0 : index
  %base = index.constant 0 : offset
  %lhs_value = view.load %lhs[%c0] : view<3xi32> -> i32
  %rhs_value = view.load %rhs[%c0] : view<4xi32> -> i32
  %sum = scalar.addi %lhs_value, %rhs_value : i32
  %target_view = buffer.view %target[%base] : buffer -> view<1xi32>
  view.store %sum, %target_view[%c0] : i32, view<1xi32>
  kernel.return
}

command.program.def public @parameterized() launch(%parameters: buffer, %target: buffer, %unused: buffer) {
  %layer = index.constant 3 : index
  %lhs = command.parameter %parameters, "blk.{}.lhs"[%layer] : view<3xi32>
  %rhs = command.parameter %parameters, "shared.rhs" : view<4xi32>
  kernel.launch @combine(%lhs, %rhs, %target, %unused) : (view<3xi32>, view<4xi32>, buffer, buffer)
  command.return
}

// ----
low.func.def public retain target<cmd.core> abi(command_program) abi_layout({entry_count = 1, executable_count = 1, fixed_buffer_count = 1, rebindable_binding_count = 2}) @parameterized() asm {
  %21 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.buffer>
  %22 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %23 = resource<command_input> {index = 1, source_type = buffer} : reg<cmd.binding>
  %24 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %25 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %26 = cmd.constant.u64 0
  %27 = cmd.constant.u64 -1
  %28 = cmd.constant.u64 12
  %29 = cmd.constant.u64 256
  %30 = cmd.constant.u64 16
  %31 = cmd.constant.u32 1
  cmd.dispatch.direct<%24, %25>[%31, %31, %31](%21, %26, %28, %21, %29, %30, %22, %26, %27, %23, %26, %27)
  return
}

