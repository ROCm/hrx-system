  %121 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %122 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %123 = resource<command_input> {index = 1, source_type = index} : reg<cmd.executable>
  %124 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %125 = resource<command_input> {index = 1, source_type = index} : reg<cmd.entry>
  %126 = cmd.constant.u64 0
  %127 = cmd.constant.u64 -1
  %128 = cmd.constant.u32 4
  %129 = cmd.constant.u32 1
  cmd.dispatch.direct<%122, %124>[%128, %129, %129](%121, %126, %127)
