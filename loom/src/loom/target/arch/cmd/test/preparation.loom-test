  %0 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %1 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %2 = resource<command_input> {index = 1, source_type = index} : reg<cmd.executable>
  %3 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %4 = resource<command_input> {index = 1, source_type = index} : reg<cmd.entry>
  %5 = cmd.constant.u64 0
  %6 = cmd.constant.u64 -1
  %7 = cmd.constant.u32 4
  %8 = cmd.constant.u32 1
  cmd.dispatch.direct<%1, %3>[%7, %8, %8]()
  %9 = cmd.constant.u32 40
  cmd.dispatch.direct.barrier<%2, %4>[%9, %8, %8]()
  return
}

low.func.def public retain target<cmd.core> abi(command_program) abi_layout({entry_count = 2, executable_count = 2, fixed_buffer_count = 0, rebindable_binding_count = 1}) @q4_q6() asm {
  %10 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %11 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %12 = resource<command_input> {index = 1, source_type = index} : reg<cmd.executable>
