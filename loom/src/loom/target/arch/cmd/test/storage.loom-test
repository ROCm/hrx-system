// RUN: emit command-program @attention_wave

kernel.def @copy_one() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%source: buffer, %target: buffer) {
  %base = index.constant 0 : offset
  %element = index.constant 0 : index
  %source_view = buffer.view %source[%base] : buffer -> view<1xi32>
  %target_view = buffer.view %target[%base] : buffer -> view<1xi32>
  %value = view.load %source_view[%element] : view<1xi32> -> i32
  view.store %value, %target_view[%element] : i32, view<1xi32>
  kernel.return
}

kernel.def @sum_three() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%a: buffer, %b: buffer, %c: buffer, %target: buffer) {
  %base = index.constant 0 : offset
  %element = index.constant 0 : index
  %a_view = buffer.view %a[%base] : buffer -> view<1xi32>
  %b_view = buffer.view %b[%base] : buffer -> view<1xi32>
  %c_view = buffer.view %c[%base] : buffer -> view<1xi32>
  %target_view = buffer.view %target[%base] : buffer -> view<1xi32>
  %a_value = view.load %a_view[%element] : view<1xi32> -> i32
  %b_value = view.load %b_view[%element] : view<1xi32> -> i32
  %c_value = view.load %c_view[%element] : view<1xi32> -> i32
  %ab = scalar.addi %a_value, %b_value : i32
  %abc = scalar.addi %ab, %c_value : i32
  view.store %abc, %target_view[%element] : i32, view<1xi32>
  kernel.return
}

command.program.def public @attention_wave() launch(%source: buffer, %target: buffer) {
  %branch_bytes = index.constant 64 : offset
  %post_bytes = index.constant 256 : offset
  %unused_bytes = index.constant 4096 : offset
  %query = buffer.alloca<global> align(64) %branch_bytes : buffer
  %key = buffer.alloca<global> align(256) %branch_bytes : buffer
  %value = buffer.alloca<global> align(64) %branch_bytes : buffer
  %unused = buffer.alloca<global> align(4096) %unused_bytes : buffer
  command.concurrent {
    kernel.launch @copy_one(%source, %query) : (buffer, buffer)
    kernel.launch @copy_one(%source, %key) : (buffer, buffer)
    kernel.launch @copy_one(%source, %value) : (buffer, buffer)
  }
  kernel.launch @sum_three(%query, %key, %value, %target) : (buffer, buffer, buffer, buffer)
  %post = buffer.alloca<global> align(256) %post_bytes : buffer
  kernel.launch @copy_one(%source, %post) : (buffer, buffer)
  kernel.launch @copy_one(%post, %target) : (buffer, buffer)
  command.return
}

// ----
low.func.def public retain target<cmd.core> abi(command_program) abi_layout({entry_count = 2, executable_count = 2, fixed_buffer_count = 0, rebindable_binding_count = 3}) @attention_wave() asm {
  %49 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %50 = resource<command_input> {index = 1, source_type = buffer} : reg<cmd.binding>
  %51 = resource<command_input> {index = 2, source_type = buffer} : reg<cmd.binding>
  %52 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %53 = resource<command_input> {index = 1, source_type = index} : reg<cmd.executable>
  %54 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %55 = resource<command_input> {index = 1, source_type = index} : reg<cmd.entry>
  %56 = cmd.constant.u64 0
  %57 = cmd.constant.u64 -1
  %58 = cmd.constant.u64 64
  %59 = cmd.constant.u64 256
  %60 = cmd.constant.u32 1
  cmd.dispatch.direct<%52, %54>[%60, %60, %60](%49, %56, %57, %51, %56, %58)
  cmd.dispatch.direct<%52, %54>[%60, %60, %60](%49, %56, %57, %51, %59, %58)
  cmd.dispatch.direct<%52, %54>[%60, %60, %60](%49, %56, %57, %51, %58, %58)
  cmd.dispatch.direct.barrier<%53, %55>[%60, %60, %60](%51, %56, %58, %51, %59, %58, %51, %58, %58, %50, %56, %57)
  cmd.dispatch.direct.barrier<%52, %54>[%60, %60, %60](%49, %56, %57, %51, %56, %59)
  cmd.dispatch.direct.barrier<%52, %54>[%60, %60, %60](%51, %56, %59, %50, %56, %57)
  return
}

// ====

// RUN: emit command-program @parameterized

kernel.def @combine() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%lhs: view<3xi32>, %rhs: view<4xi32>, %target: buffer) {
  %element = index.constant 0 : index
  %base = index.constant 0 : offset
  %lhs_value = view.load %lhs[%element] : view<3xi32> -> i32
  %rhs_value = view.load %rhs[%element] : view<4xi32> -> i32
  %sum = scalar.addi %lhs_value, %rhs_value : i32
  %target_view = buffer.view %target[%base] : buffer -> view<1xi32>
  view.store %sum, %target_view[%element] : i32, view<1xi32>
  kernel.return
}

command.program.def public @parameterized() launch(%parameters: buffer, %target: buffer) {
  %layer = index.constant 3 : index
  %lhs = command.parameter %parameters, "blk.{}.lhs"[%layer] : view<3xi32>
  %rhs = command.parameter %parameters, "shared.rhs" : view<4xi32>
  kernel.launch @combine(%lhs, %rhs, %target) : (view<3xi32>, view<4xi32>, buffer)
  command.return
}

// ----
low.func.def public retain target<cmd.core> abi(command_program) abi_layout({entry_count = 1, executable_count = 1, fixed_buffer_count = 1, rebindable_binding_count = 1}) @parameterized() asm {
  %18 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.buffer>
  %19 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %20 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %21 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %22 = cmd.constant.u64 0
  %23 = cmd.constant.u64 -1
  %24 = cmd.constant.u64 12
  %25 = cmd.constant.u64 256
  %26 = cmd.constant.u64 16
  %27 = cmd.constant.u32 1
  cmd.dispatch.direct<%20, %21>[%27, %27, %27](%18, %22, %24, %18, %25, %26, %19, %22, %23)
  return
}
