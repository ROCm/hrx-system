// RUN: emit command-program @attention_wave

kernel.def @copy_one() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%source: buffer, %target: buffer) {
  %base = index.constant 0 : offset
  %element = index.constant 0 : index
  %source_view = buffer.view %source[%base] : buffer -> view<1xi32>
  %target_view = buffer.view %target[%base] : buffer -> view<1xi32>
  %value = view.load %source_view[%element] : view<1xi32> -> i32
  view.store %value, %target_view[%element] : i32, view<1xi32>
  kernel.return
}

kernel.def @sum_three() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%a: buffer, %b: buffer, %c: buffer, %target: buffer) {
  %base = index.constant 0 : offset
  %element = index.constant 0 : index
  %a_view = buffer.view %a[%base] : buffer -> view<1xi32>
  %b_view = buffer.view %b[%base] : buffer -> view<1xi32>
  %c_view = buffer.view %c[%base] : buffer -> view<1xi32>
  %target_view = buffer.view %target[%base] : buffer -> view<1xi32>
  %a_value = view.load %a_view[%element] : view<1xi32> -> i32
  %b_value = view.load %b_view[%element] : view<1xi32> -> i32
  %c_value = view.load %c_view[%element] : view<1xi32> -> i32
  %ab = scalar.addi %a_value, %b_value : i32
  %abc = scalar.addi %ab, %c_value : i32
  view.store %abc, %target_view[%element] : i32, view<1xi32>
  kernel.return
}

command.program.def public @attention_wave() launch(%source: buffer, %target: buffer) {
  %branch_bytes = index.constant 64 : offset
  %post_bytes = index.constant 256 : offset
  %unused_bytes = index.constant 4096 : offset
  %query = buffer.alloca<global> align(64) %branch_bytes : buffer
  %key = buffer.alloca<global> align(256) %branch_bytes : buffer
  %value = buffer.alloca<global> align(64) %branch_bytes : buffer
  %unused = buffer.alloca<global> align(4096) %unused_bytes : buffer
  command.concurrent {
    kernel.launch @copy_one(%source, %query) : (buffer, buffer)
    kernel.launch @copy_one(%source, %key) : (buffer, buffer)
    kernel.launch @copy_one(%source, %value) : (buffer, buffer)
  }
  kernel.launch @sum_three(%query, %key, %value, %target) : (buffer, buffer, buffer, buffer)
  %post = buffer.alloca<global> align(256) %post_bytes : buffer
  kernel.launch @copy_one(%source, %post) : (buffer, buffer)
  kernel.launch @copy_one(%post, %target) : (buffer, buffer)
  command.return
}

// ----
low.func.def public retain target<cmd.core> abi(command_program) abi_layout({entry_count = 2, executable_count = 2, fixed_buffer_count = 0, rebindable_binding_count = 3}) @attention_wave() asm {
  %52 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %53 = resource<command_input> {index = 1, source_type = buffer} : reg<cmd.binding>
  %54 = resource<command_input> {index = 2, source_type = buffer} : reg<cmd.binding>
  %55 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %56 = resource<command_input> {index = 1, source_type = index} : reg<cmd.executable>
  %57 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %58 = resource<command_input> {index = 1, source_type = index} : reg<cmd.entry>
  %59 = cmd.constant.u64 0
  %60 = cmd.constant.u64 -1
  %61 = cmd.constant.u64 64
  %62 = cmd.constant.u64 256
  %63 = cmd.constant.u32 1
  cmd.dispatch.direct<%55, %57>[%63, %63, %63](%52, %59, %60, %54, %59, %61)
  cmd.dispatch.direct<%55, %57>[%63, %63, %63](%52, %59, %60, %54, %62, %61)
  cmd.dispatch.direct<%55, %57>[%63, %63, %63](%52, %59, %60, %54, %61, %61)
  cmd.dispatch.direct.barrier<%56, %58>[%63, %63, %63](%54, %59, %61, %54, %62, %61, %54, %61, %61, %53, %59, %60)
  cmd.dispatch.direct.barrier<%55, %57>[%63, %63, %63](%52, %59, %60, %54, %59, %62)
  cmd.dispatch.direct.barrier<%55, %57>[%63, %63, %63](%54, %59, %62, %53, %59, %60)
  return
}

// ====

// RUN: emit command-program @parameterized

kernel.def @combine() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%lhs: view<3xi32>, %rhs: view<4xi32>, %target: buffer) {
  %element = index.constant 0 : index
  %base = index.constant 0 : offset
  %lhs_value = view.load %lhs[%element] : view<3xi32> -> i32
  %rhs_value = view.load %rhs[%element] : view<4xi32> -> i32
  %sum = scalar.addi %lhs_value, %rhs_value : i32
  %target_view = buffer.view %target[%base] : buffer -> view<1xi32>
  view.store %sum, %target_view[%element] : i32, view<1xi32>
  kernel.return
}

command.program.def public @parameterized() launch(%parameters: buffer, %target: buffer) {
  %layer = index.constant 3 : index
  %lhs = command.parameter %parameters, "blk.{}.lhs"[%layer] : view<3xi32>
  %rhs = command.parameter %parameters, "shared.rhs" : view<4xi32>
  kernel.launch @combine(%lhs, %rhs, %target) : (view<3xi32>, view<4xi32>, buffer)
  command.return
}

// ----
low.func.def public retain target<cmd.core> abi(command_program) abi_layout({entry_count = 1, executable_count = 1, fixed_buffer_count = 1, rebindable_binding_count = 1}) @parameterized() asm {
  %18 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.buffer>
  %19 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %20 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %21 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %22 = cmd.constant.u64 0
  %23 = cmd.constant.u64 -1
  %24 = cmd.constant.u64 12
  %25 = cmd.constant.u64 256
  %26 = cmd.constant.u64 16
  %27 = cmd.constant.u32 1
  cmd.dispatch.direct<%20, %21>[%27, %27, %27](%18, %22, %24, %18, %25, %26, %19, %22, %23)
  return
}

// ====

// Parameter-relative offsets compose with fixed-root placement, while ordinary
// launch-binding ranges remain independent. The nested view reaches the last
// row of a parameter that starts after another aligned parameter.
// RUN: emit command-program @parameter_views

kernel.entry.decl @consume(%first: view<2xbf16>, %middle: view<1x4xf32>, %last: view<1x4xf32>, %adapter: view<1x4xbf16>, %input: view<1x4xbf16>)

command.program.def public @parameter_views() launch(%parameters: buffer, %adapter: buffer, %input: buffer) {
  %first = command.parameter %parameters, "first" : view<4xbf16>
  %first_part = view.subview %first[0] : view<4xbf16> -> view<2xbf16>
  %table = command.parameter %parameters, "table" : view<6x4xf32>
  %middle = view.subview %table[2, 0] : view<6x4xf32> -> view<1x4xf32>
  %tail = view.subview %table[1, 0] : view<6x4xf32> -> view<5x4xf32>
  %last = view.subview %tail[4, 0] : view<5x4xf32> -> view<1x4xf32>
  %adapter_table = command.parameter %adapter, "table" : view<6x4xbf16>
  %adapter_row = view.subview %adapter_table[3, 0] : view<6x4xbf16> -> view<1x4xbf16>
  %origin = index.constant 0 : offset
  %input_view = buffer.view %input[%origin] : buffer -> view<6x4xbf16>
  %input_row = view.subview %input_view[5, 0] : view<6x4xbf16> -> view<1x4xbf16>
  %groups = index.constant 1 : index
  kernel.dispatch @consume[%groups](%first_part, %middle, %last, %adapter_row, %input_row) : [index](view<2xbf16>, view<1x4xf32>, view<1x4xf32>, view<1x4xbf16>, view<1x4xbf16>)
  command.return
}

// ----
low.func.def public retain target<cmd.core> abi(command_program) abi_layout({entry_count = 1, executable_count = 1, fixed_buffer_count = 2, rebindable_binding_count = 1}) @parameter_views() asm {
  %20 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.buffer>
  %21 = resource<command_input> {index = 1, source_type = buffer} : reg<cmd.buffer>
  %22 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %23 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %24 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %25 = cmd.constant.u64 0
  %26 = cmd.constant.u64 -1
  %27 = cmd.constant.u64 4
  %28 = cmd.constant.u64 288
  %29 = cmd.constant.u64 16
  %30 = cmd.constant.u64 272
  %31 = cmd.constant.u64 80
  %32 = cmd.constant.u64 336
  %33 = cmd.constant.u64 24
  %34 = cmd.constant.u64 8
  %35 = cmd.constant.u64 48
  %36 = cmd.constant.u64 40
  %37 = cmd.constant.u64 256
  %38 = cmd.constant.u64 96
  %39 = cmd.constant.u32 1
  cmd.dispatch.direct<%23, %24>[%39, %39, %39](%20, %25, %27, %20, %28, %29, %20, %32, %29, %21, %33, %34, %22, %36, %34)
  return
}

// ====

// A strided crop retains the complete byte footprint, including gaps between
// rows. Refinement preserves the same parameter identity and nested offset.
// RUN: emit command-program @parameter_strided_view

kernel.def @read_first() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %source = buffer.view %input[%origin] : buffer -> view<1xi32>
  %target = buffer.view %output[%origin] : buffer -> view<1xi32>
  %value = view.load %source[0] : view<1xi32> -> i32
  view.store %value, %target[0] : i32, view<1xi32>
  kernel.return
}

command.program.def public @parameter_strided_view() launch(%parameters: buffer, %output: buffer) {
  %layout = encoding.layout.strided [8, 1] : encoding<layout>
  %table = command.parameter %parameters, "strided" : view<6x8xi32, %layout>
  %outer = view.subview %table[1, 1] : view<6x8xi32, %layout> -> view<4x6xi32, %layout>
  %inner = view.subview %outer[1, 2] : view<4x6xi32, %layout> -> view<2x3xi32, %layout>
  %refined = view.refine %inner : view<2x3xi32, %layout> -> view<2x3xi32, %layout>
  kernel.launch @read_first(%refined, %output) : (view<2x3xi32, %layout>, buffer)
  command.return
}

// ----
low.func.def public retain target<cmd.core> abi(command_program) abi_layout({entry_count = 1, executable_count = 1, fixed_buffer_count = 1, rebindable_binding_count = 1}) @parameter_strided_view() asm {
  %18 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.buffer>
  %19 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %20 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %21 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %22 = cmd.constant.u64 0
  %23 = cmd.constant.u64 -1
  %24 = cmd.constant.u64 36
  %25 = cmd.constant.u64 120
  %26 = cmd.constant.u64 76
  %27 = cmd.constant.u64 44
  %28 = cmd.constant.u64 192
  %29 = cmd.constant.u32 1
  cmd.dispatch.direct<%20, %21>[%29, %29, %29](%18, %26, %27, %19, %22, %23)
  return
}

// ====

// Indirect dispatch tuples share the same parameter-relative range contract as
// kernel arguments. These counts are fixed inputs, not device-written tuples.
// RUN: emit command-program @parameter_count_view

kernel.entry.decl @counted()

command.program.def public @parameter_count_view() launch(%parameters: buffer) {
  %table = command.parameter %parameters, "counts" : view<6xi32>
  %counts = view.subview %table[3] : view<6xi32> -> view<3xi32>
  kernel.dispatch @counted[%counts]() : [view<3xi32>]()
  command.return
}

// ----
low.func.def public retain target<cmd.core> abi(command_program) abi_layout({entry_count = 1, executable_count = 1, fixed_buffer_count = 1, rebindable_binding_count = 0}) @parameter_count_view() asm {
  %3 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.buffer>
  %4 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %5 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %6 = cmd.constant.u64 0
  %7 = cmd.constant.u64 -1
  %8 = cmd.constant.u64 12
  %9 = cmd.constant.u64 24
  %10 = cmd.buffer.ref.direct %3, %8, %8
  cmd.dispatch.indirect.static<%4, %5>[%10]()
  return
}
