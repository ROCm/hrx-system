// RUN: format bytecode

low.func.def target<cmd.core> abi(command_program) @capture_bindings() asm {
  %fixed = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.buffer>
  %dynamic = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %c0 = cmd.constant.u64 0
  %sample_bytes = cmd.constant.u64 8
  %start = cmd.buffer.ref.direct %fixed, %c0, %sample_bytes
  %end = cmd.buffer.ref.binding %dynamic, %sample_bytes, %sample_bytes
  cmd.timestamp %start
  cmd.timestamp.barrier %end
  %visibility = cmd.memory.buffer source(transfer_write) target(dispatch_read|indirect_command_read) %end
  cmd.barrier source(transfer) target(command_process|dispatch) %visibility
  cmd.barrier<acquire_system> source(none) target(dispatch)
  return
}

// ----
low.func.def target<cmd.core> abi(command_program) @capture_bindings() asm {
  %fixed = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.buffer>
  %dynamic = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %c0 = cmd.constant.u64 0
  %sample_bytes = cmd.constant.u64 8
  %start = cmd.buffer.ref.direct %fixed, %c0, %sample_bytes
  %end = cmd.buffer.ref.binding %dynamic, %sample_bytes, %sample_bytes
  cmd.timestamp %start
  cmd.timestamp.barrier %end
  %visibility = cmd.memory.buffer source(transfer_write) target(indirect_command_read|dispatch_read) %end
  cmd.barrier source(transfer) target(command_process|dispatch) %visibility
  cmd.barrier<acquire_system> source(none) target(dispatch)
  return
}

// ====

low.func.def target<cmd.core> abi(command_program) @one_dispatch() asm {
  %parameters = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.buffer>
  %output = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %executable = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %entry = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %one_u32 = cmd.constant.u32 1
  %zero_u64 = cmd.constant.u64 0
  %length = cmd.constant.u64 4096
  cmd.dispatch.direct<%executable, %entry>[%one_u32, %one_u32, %one_u32](%parameters, %zero_u64, %length, %output, %zero_u64, %length)
  return
}
