  %14 = resource<command_input> {index = 2, source_type = index} : reg<cmd.executable>
  %15 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %16 = resource<command_input> {index = 1, source_type = index} : reg<cmd.entry>
  %17 = resource<command_input> {index = 2, source_type = index} : reg<cmd.entry>
  %18 = cmd.constant.u64 0
  %19 = cmd.constant.u64 -1
  %20 = cmd.constant.u64 12
  %21 = cmd.constant.u32 1
