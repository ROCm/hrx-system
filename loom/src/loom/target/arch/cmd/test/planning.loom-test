// Target-dependent configuration is folded in each kernel's target context,
// before the helpers are inlined into the target-neutral command root.
// RUN: emit command-program @target_counts

test.target<low_core> @wave32 {subgroup_size = 32}

test.target<low_core> @wave64 {subgroup_size = 64}

kernel.def target(@wave32) @narrow() {
  %width = target.subgroup.size : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%width, %c1, %c1) workgroup_size(%width, %c1, %c1) : index
} launch() {
  kernel.return
}

kernel.def target(@wave64) @wide() {
  %width = target.subgroup.size : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%width, %c1, %c1) workgroup_size(%width, %c1, %c1) : index
} launch() {
  kernel.return
}

command.def public @target_counts() launch() {
  kernel.launch @narrow() : ()
  kernel.launch @wide() : ()
  command.return
}

// ----
low.func.def public retain target<cmd.core> abi(command_program) abi_layout({entry_count = 2, executable_count = 2, fixed_buffer_count = 0, rebindable_binding_count = 0}) @target_counts() asm {
  %18 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %19 = resource<command_input> {index = 1, source_type = index} : reg<cmd.executable>
  %20 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %21 = resource<command_input> {index = 1, source_type = index} : reg<cmd.entry>
  %22 = cmd.constant.u32 32
  %23 = cmd.constant.u32 1
  cmd.dispatch.direct<%18, %20>[%22, %23, %23]()
  %24 = cmd.constant.u32 64
  cmd.dispatch.direct.barrier<%19, %21>[%24, %23, %23]()
  return
}

// ====

// RUN: emit command-program @waves

kernel.def @copy() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%source: buffer, %target: buffer) {
  %base = index.constant 0 : offset
  %workgroup = kernel.workgroup.id<x> : index
  %source_view = buffer.view %source[%base] : buffer -> view<128xi32>
  %target_view = buffer.view %target[%base] : buffer -> view<128xi32>
  %value = view.load %source_view[%workgroup] : view<128xi32> -> i32
  view.store %value, %target_view[%workgroup] : i32, view<128xi32>
  kernel.return
}

command.def public @waves() launch(%source: buffer, %first: buffer, %second: buffer, %target: buffer) {
  kernel.launch.serial {
    kernel.launch.concurrent {
      kernel.launch @copy(%source, %first) : (buffer, buffer)
      kernel.launch @copy(%source, %second) : (buffer, buffer)
    }
    kernel.launch @copy(%second, %target) : (buffer, buffer)
  }
  command.return
}

// ----
low.func.def public retain target<cmd.core> abi(command_program) abi_layout({entry_count = 1, executable_count = 1, fixed_buffer_count = 0, rebindable_binding_count = 4}) @waves() asm {
  %23 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %24 = resource<command_input> {index = 1, source_type = buffer} : reg<cmd.binding>
  %25 = resource<command_input> {index = 2, source_type = buffer} : reg<cmd.binding>
  %26 = resource<command_input> {index = 3, source_type = buffer} : reg<cmd.binding>
  %27 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %28 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %29 = cmd.constant.u64 0
  %30 = cmd.constant.u64 -1
  %31 = cmd.constant.u32 1
  cmd.dispatch.direct<%27, %28>[%31, %31, %31](%23, %29, %30, %24, %29, %30)
  cmd.dispatch.direct<%27, %28>[%31, %31, %31](%23, %29, %30, %25, %29, %30)
  cmd.dispatch.direct.barrier<%27, %28>[%31, %31, %31](%25, %29, %30, %26, %29, %30)
  return
}

// ====

// Command helpers are specialized at their call sites before bare-unroll loops
// are expanded. The helper accepts counts 2 through 4, while the selected root
// emits exactly the two dispatches requested by its constant argument.
// RUN: emit command-program @unrolled_nested

kernel.entry.decl @step()

command.def @batch(%count: index) launch() where [range(%count, 2, 4)] {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  scf.for %i = [%c0 to %count step %c1] unroll {
    kernel.dispatch @step[%c1]() : [index]()
  }
  command.return
}

command.def public @unrolled_nested() launch() {
  %count = index.constant 2 : index
  command.launch @batch[%count]() : [index]()
  command.return
}

// ----
low.func.def public retain target<cmd.core> abi(command_program) abi_layout({entry_count = 1, executable_count = 1, fixed_buffer_count = 0, rebindable_binding_count = 0}) @unrolled_nested() asm {
  %5 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %6 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %7 = cmd.constant.u32 1
  cmd.dispatch.direct<%5, %6>[%7, %7, %7]()
  cmd.dispatch.direct.barrier<%5, %6>[%7, %7, %7]()
  return
}

// ====

// RUN: emit command-program @parameterized

kernel.def @combine() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%lhs: buffer, %rhs: buffer, %target: buffer, %unused: buffer) {
  %c0 = index.constant 0 : index
  %base = index.constant 0 : offset
  %lhs_view = buffer.view %lhs[%base] : buffer -> view<3xi32>
  %rhs_view = buffer.view %rhs[%base] : buffer -> view<4xi32>
  %target_view = buffer.view %target[%base] : buffer -> view<1xi32>
  %lhs_value = view.load %lhs_view[%c0] : view<3xi32> -> i32
  %rhs_value = view.load %rhs_view[%c0] : view<4xi32> -> i32
  %sum = scalar.addi %lhs_value, %rhs_value : i32
  view.store %sum, %target_view[%c0] : i32, view<1xi32>
  kernel.return
}

command.def @combine_views() launch(%lhs: buffer, %rhs: buffer, %target: buffer, %unused: buffer) {
  kernel.launch @combine(%lhs, %rhs, %target, %unused) : (buffer, buffer, buffer, buffer)
  command.return
}

command.def public @parameterized() launch(%parameters: buffer, %target: buffer, %unused: buffer) {
  %layer = index.constant 3 : index
  %lhs = command.parameter %parameters, "blk.{}.lhs"[%layer] : view<3xi32>
  %rhs = command.parameter %parameters, "shared.rhs" : view<4xi32>
  %target_offset = index.constant 32 : offset
  %target_view = buffer.view %target[%target_offset] : buffer -> view<1xi32>
  command.launch @combine_views(%lhs, %rhs, %target_view, %unused) : (view<3xi32>, view<4xi32>, view<1xi32>, buffer)
  command.return
}

// ----
low.func.def public retain target<cmd.core> abi(command_program) abi_layout({entry_count = 1, executable_count = 1, fixed_buffer_count = 1, rebindable_binding_count = 2}) @parameterized() asm {
  %27 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.buffer>
  %28 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %29 = resource<command_input> {index = 1, source_type = buffer} : reg<cmd.binding>
  %30 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %31 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %32 = cmd.constant.u64 0
  %33 = cmd.constant.u64 -1
  %34 = cmd.constant.u64 32
  %35 = cmd.constant.u64 4
  %36 = cmd.constant.u64 12
  %37 = cmd.constant.u64 256
  %38 = cmd.constant.u64 16
  %39 = cmd.constant.u32 1
  cmd.dispatch.direct<%30, %31>[%39, %39, %39](%27, %32, %36, %27, %37, %38, %28, %34, %35, %29, %32, %33)
  return
}

// ====

// RUN: emit command-program @copy_twice

kernel.def @copy_one() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%source: buffer, %target: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %source_view = buffer.view %source[%base] : buffer -> view<1xi32>
  %target_view = buffer.view %target[%base] : buffer -> view<1xi32>
  %value = view.load %source_view[%c0] : view<1xi32> -> i32
  view.store %value, %target_view[%c0] : i32, view<1xi32>
  kernel.return
}

command.def @copy_stage() launch(%source: buffer, %target: buffer) {
  kernel.launch @copy_one(%source, %target) : (buffer, buffer)
  command.return
}

command.def public @copy_twice() launch(%source: buffer, %scratch: buffer, %target: buffer) {
  command.launch @copy_stage(%source, %scratch) : (buffer, buffer)
  command.launch @copy_stage(%scratch, %target) : (buffer, buffer)
  command.return
}

// ----
low.func.def public retain target<cmd.core> abi(command_program) abi_layout({entry_count = 1, executable_count = 1, fixed_buffer_count = 0, rebindable_binding_count = 3}) @copy_twice() asm {
  %17 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %18 = resource<command_input> {index = 1, source_type = buffer} : reg<cmd.binding>
  %19 = resource<command_input> {index = 2, source_type = buffer} : reg<cmd.binding>
  %20 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %21 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %22 = cmd.constant.u64 0
  %23 = cmd.constant.u64 -1
  %24 = cmd.constant.u32 1
  cmd.dispatch.direct<%20, %21>[%24, %24, %24](%17, %22, %23, %18, %22, %23)
  cmd.dispatch.direct.barrier<%20, %21>[%24, %24, %24](%18, %22, %23, %19, %22, %23)
  return
}

// ====

// RUN: emit command-program @increment_twice,@increment_then_double

kernel.def @increment(%element_count: index) {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%source: buffer, %target: buffer) {
  %base = index.constant 0 : offset
  %workgroup = kernel.workgroup.id<x> : index
  %c1 = scalar.constant 1 : i32
  %source_view = buffer.view %source[%base] : buffer -> view<128xi32>
  %target_view = buffer.view %target[%base] : buffer -> view<128xi32>
  %value = view.load %source_view[%workgroup] : view<128xi32> -> i32
  %result = scalar.addi %value, %c1 : i32
  view.store %result, %target_view[%workgroup] : i32, view<128xi32>
  kernel.return
}

kernel.def @double(%element_count: index) {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%source: buffer, %target: buffer) {
  %base = index.constant 0 : offset
  %workgroup = kernel.workgroup.id<x> : index
  %c2 = scalar.constant 2 : i32
  %source_view = buffer.view %source[%base] : buffer -> view<128xi32>
  %target_view = buffer.view %target[%base] : buffer -> view<128xi32>
  %value = view.load %source_view[%workgroup] : view<128xi32> -> i32
  %result = scalar.muli %value, %c2 : i32
  view.store %result, %target_view[%workgroup] : i32, view<128xi32>
  kernel.return
}

command.def public @increment_then_double(%element_count: index) launch(%source: buffer, %scratch: buffer, %target: buffer) where [range(%element_count, 1, 128)] {
  kernel.launch @increment[%element_count](%source, %scratch) : [index](buffer, buffer)
  kernel.launch @double[%element_count](%scratch, %target) : [index](buffer, buffer)
  command.return
}

command.def public @increment_twice(%element_count: index) launch(%source: buffer, %scratch: buffer, %target: buffer) where [range(%element_count, 1, 128)] {
  kernel.launch @increment[%element_count](%source, %scratch) : [index](buffer, buffer)
  kernel.launch @increment[%element_count](%scratch, %target) : [index](buffer, buffer)
  command.return
}

// ----
low.func.def public retain target<cmd.core> abi(command_program) abi_layout({entry_count = 1, executable_count = 1, fixed_buffer_count = 0, rebindable_binding_count = 3}) @increment_twice() asm {
  %42 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %43 = resource<command_input> {index = 1, source_type = buffer} : reg<cmd.binding>
  %44 = resource<command_input> {index = 2, source_type = buffer} : reg<cmd.binding>
  %45 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %46 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %47 = cmd.constant.u64 0
  %48 = cmd.constant.u64 -1
  %49 = cmd.constant.u32 1
  cmd.dispatch.direct<%45, %46>[%49, %49, %49](%42, %47, %48, %43, %47, %48)
  cmd.dispatch.direct.barrier<%45, %46>[%49, %49, %49](%43, %47, %48, %44, %47, %48)
  return
}

low.func.def public retain target<cmd.core> abi(command_program) abi_layout({entry_count = 2, executable_count = 2, fixed_buffer_count = 0, rebindable_binding_count = 3}) @increment_then_double() asm {
  %50 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %51 = resource<command_input> {index = 1, source_type = buffer} : reg<cmd.binding>
  %52 = resource<command_input> {index = 2, source_type = buffer} : reg<cmd.binding>
  %53 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %54 = resource<command_input> {index = 1, source_type = index} : reg<cmd.executable>
  %55 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %56 = resource<command_input> {index = 1, source_type = index} : reg<cmd.entry>
  %57 = cmd.constant.u64 0
  %58 = cmd.constant.u64 -1
  %59 = cmd.constant.u32 1
  cmd.dispatch.direct<%53, %55>[%59, %59, %59](%50, %57, %58, %51, %57, %58)
  cmd.dispatch.direct.barrier<%54, %56>[%59, %59, %59](%51, %57, %58, %52, %57, %58)
  return
}

// ====

// RUN: emit command-program @unrolled_targetless

kernel.def @copy_element(%element: index) {
  %c1 = index.constant 1 : index
  %workgroups = index.add %element, %c1 : index
  kernel.launch.config workgroups(%workgroups, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%source: buffer, %target: buffer) {
  %base = index.constant 0 : offset
  %element = kernel.workgroup.id<x> : index
  %source_view = buffer.view %source[%base] : buffer -> view<1xi32>
  %target_view = buffer.view %target[%base] : buffer -> view<1xi32>
  %value = view.load %source_view[%element] : view<1xi32> -> i32
  view.store %value, %target_view[%element] : i32, view<1xi32>
  kernel.return
}

command.def public @unrolled_targetless() launch(%source: buffer, %target: buffer) {
  %loop_begin = index.constant 0 : index
  %loop_end = index.constant 2 : index
  %loop_step = index.constant 1 : index
  scf.for %iteration = [%loop_begin to %loop_end step %loop_step] unroll {
    kernel.launch @copy_element[%iteration](%source, %target) : [index](buffer, buffer)
  }
  command.return
}

// ----
low.func.def public retain target<cmd.core> abi(command_program) abi_layout({entry_count = 1, executable_count = 1, fixed_buffer_count = 0, rebindable_binding_count = 2}) @unrolled_targetless() asm {
  %26 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %27 = resource<command_input> {index = 1, source_type = buffer} : reg<cmd.binding>
  %28 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %29 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %30 = cmd.constant.u64 0
  %31 = cmd.constant.u64 -1
  %32 = cmd.constant.u32 1
  cmd.dispatch.direct<%28, %29>[%32, %32, %32](%26, %30, %31, %27, %30, %31)
  %33 = cmd.constant.u32 2
  cmd.dispatch.direct.barrier<%28, %29>[%33, %32, %32](%26, %30, %31, %27, %30, %31)
  return
}

// ====

// RUN: emit command-program @allocation_definition_lifetime

kernel.def @copy_one() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%source: buffer, %target: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %source_view = buffer.view %source[%base] : buffer -> view<1xi32>
  %target_view = buffer.view %target[%base] : buffer -> view<1xi32>
  %value = view.load %source_view[%c0] : view<1xi32> -> i32
  view.store %value, %target_view[%c0] : i32, view<1xi32>
  kernel.return
}

command.def public @allocation_definition_lifetime() launch(%source: buffer, %target: buffer) {
  %bytes = index.constant 64 : offset
  %persistent = buffer.alloca<global> align(64) %bytes : buffer
  %early = buffer.alloca<global> align(64) %bytes : buffer
  kernel.launch @copy_one(%source, %early) : (buffer, buffer)
  kernel.launch @copy_one(%persistent, %target) : (buffer, buffer)
  command.return
}

// ----
low.func.def public retain target<cmd.core> abi(command_program) abi_layout({entry_count = 1, executable_count = 1, fixed_buffer_count = 0, rebindable_binding_count = 3}) @allocation_definition_lifetime() asm {
  %20 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %21 = resource<command_input> {index = 1, source_type = buffer} : reg<cmd.binding>
  %22 = resource<command_input> {index = 2, source_type = buffer} : reg<cmd.binding>
  %23 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %24 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %25 = cmd.constant.u64 0
  %26 = cmd.constant.u64 -1
  %27 = cmd.constant.u64 64
  %28 = cmd.constant.u32 1
  cmd.dispatch.direct<%23, %24>[%28, %28, %28](%20, %25, %26, %22, %27, %27)
  cmd.dispatch.direct.barrier<%23, %24>[%28, %28, %28](%22, %25, %27, %21, %25, %26)
  return
}

// ====

// RUN: emit command-program @exact_composition

kernel.def @one_group() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%storage: view<4xi32>) {
  kernel.return
}

kernel.def @two_groups() {
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  kernel.launch.config workgroups(%c2, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%storage: view<4xi32>) {
  kernel.return
}

command.def @shape_program(%token_count: index) launch(%storage: view<4xi32>) where [range(%token_count, 1, 512)] {
  %c512 = index.constant 512 : index
  %is_full_shape = index.cmp eq, %token_count, %c512 : index
  scf.if %is_full_shape {
    kernel.launch @one_group(%storage) : (view<4xi32>)
  } else {
    kernel.launch @two_groups(%storage) : (view<4xi32>)
  }
  command.return
}

command.def public @exact_composition() launch(%storage: view<4xi32>) {
  %token_count = index.constant 512 : index
  command.launch @shape_program[%token_count](%storage) : [index](view<4xi32>)
  command.return
}

// ----
low.func.def public retain target<cmd.core> abi(command_program) abi_layout({entry_count = 1, executable_count = 1, fixed_buffer_count = 0, rebindable_binding_count = 1}) @exact_composition() asm {
  %26 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %27 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %28 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %29 = cmd.constant.u64 0
  %30 = cmd.constant.u64 -1
  %31 = cmd.constant.u32 1
  cmd.dispatch.direct<%27, %28>[%31, %31, %31](%26, %29, %30)
  return
}

// ====

// RUN: emit command-program @q4_q4,@q4_q6,@q6_q4,@q6_q6

config.def @quant.q4 = #ggml.q4_0 : encoding<schema>

config.def @quant.q6 = #ggml.q6_k : encoding<schema>

kernel.def @gate_q4() {
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  kernel.launch.config workgroups(%c4, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%storage: buffer) {
  kernel.return
}

kernel.def @gate_q6() {
  %c1 = index.constant 1 : index
  %c6 = index.constant 6 : index
  kernel.launch.config workgroups(%c6, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%storage: buffer) {
  kernel.return
}

kernel.def @down_q4() {
  %c1 = index.constant 1 : index
  %c40 = index.constant 40 : index
  kernel.launch.config workgroups(%c40, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%storage: buffer) {
  kernel.return
}

kernel.def @down_q6() {
  %c1 = index.constant 1 : index
  %c60 = index.constant 60 : index
  kernel.launch.config workgroups(%c60, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%storage: buffer) {
  kernel.return
}

command.def @quantized_pair(%gate_schema: encoding<schema>, %down_schema: encoding<schema>) launch(%storage: buffer) {
  %gate_is_q4 = encoding.isa<#ggml.q4_0> %gate_schema : encoding<schema>
  scf.if %gate_is_q4 {
    kernel.launch @gate_q4(%storage) : (buffer)
  } else {
    kernel.launch @gate_q6(%storage) : (buffer)
  }
  %down_is_q4 = encoding.isa<#ggml.q4_0> %down_schema : encoding<schema>
  scf.if %down_is_q4 {
    kernel.launch @down_q4(%storage) : (buffer)
  } else {
    kernel.launch @down_q6(%storage) : (buffer)
  }
  command.return
}

command.def public @q4_q4() launch(%storage: buffer) {
  %q4 = config.get @quant.q4 : encoding<schema>
  command.launch @quantized_pair[%q4, %q4](%storage) : [encoding<schema>, encoding<schema>](buffer)
  command.return
}

command.def public @q4_q6() launch(%storage: buffer) {
  %q4 = config.get @quant.q4 : encoding<schema>
  %q6 = config.get @quant.q6 : encoding<schema>
