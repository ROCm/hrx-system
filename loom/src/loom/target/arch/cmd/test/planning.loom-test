// ====

// The wave's leading direct dispatch owns the barrier for every indirect
// consumer in the concurrent group.
// RUN: emit command-program @concurrent_dynamic_counts

kernel.entry.decl @produce(%counts: view<3xi32>)

kernel.entry.decl @heartbeat()

kernel.entry.decl @consume(%output: buffer)

command.def public @concurrent_dynamic_counts() launch(%first: buffer, %second: buffer) {
  %c0 = index.constant 0 : offset
  %c1 = index.constant 1 : index
  %count_bytes = index.constant 12 : offset
  %count_storage = buffer.alloca<global> align(4) %count_bytes : buffer
  %counts = buffer.view %count_storage[%c0] : buffer -> view<3xi32>
  kernel.dispatch @produce[%c1](%counts) : [index](view<3xi32>)
  command.concurrent {
    kernel.dispatch @heartbeat[%c1]() : [index]()
    kernel.dispatch @consume[%counts](%first) : [view<3xi32>](buffer)
    kernel.dispatch @consume[%counts](%second) : [view<3xi32>](buffer)
  }
  command.return
}

