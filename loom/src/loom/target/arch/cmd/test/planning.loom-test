// ====

// A caller-owned count buffer can be updated between dispatches. A subview
// retains that mutable storage contract and the producer-to-consumer barrier.
// RUN: emit command-program @updated_invocation_counts

kernel.entry.decl @produce_counts(%counts: view<3xi32>)

kernel.entry.decl @consume_counts(%output: buffer)

command.def public @updated_invocation_counts() launch(%storage: buffer, %output: buffer) {
  %offset = index.constant 4 : offset
  %c1 = index.constant 1 : index
  %table = buffer.view %storage[%offset] : buffer -> view<8xi32>
  %counts = view.subview %table[1] : view<8xi32> -> view<3xi32>
  kernel.dispatch @produce_counts[%c1](%counts) : [index](view<3xi32>)
  kernel.dispatch @consume_counts[%counts](%output) : [view<3xi32>](buffer)
  command.return
}

