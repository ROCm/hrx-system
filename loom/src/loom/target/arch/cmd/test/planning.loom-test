  %count_x = index.constant 7 : index
  %count_y = index.constant 3 : index
  %c0 = index.constant 0 : offset
  %element_index = index.constant 64 : index
  %byte_offset = index.constant 4294967296 : offset
  %scale = scalar.constant -1 : i8
  %fp8e4 = scalar.constant 1.0 : f8E4M3
  %fp8e5 = scalar.constant 1.0 : f8E5M2
  %gain = scalar.constant -2.0 : f16
  %offset = scalar.constant 1.0 : bf16
  %bias = scalar.constant 1.5 : f32
  %threshold = scalar.constant 1.0000000000000002 : f64
  %slice = buffer.view %output[%c0] : buffer -> view<4xi32>
  command.concurrent {
    kernel.dispatch @configured_a[%count_x, %count_y](%element_index, %byte_offset, %scale, %fp8e4, %fp8e5, %gain, %offset, %bias, %threshold, %slice, %output) : [index, index](index, offset, i8, f8E4M3, f8E5M2, f16, bf16, f32, f64, view<4xi32>, buffer)
    kernel.dispatch @configured_a[%count_x, %count_y](%element_index, %byte_offset, %scale, %fp8e4, %fp8e5, %gain, %offset, %bias, %threshold, %slice, %output) : [index, index](index, offset, i8, f8E4M3, f8E5M2, f16, bf16, f32, f64, view<4xi32>, buffer)
  }
  kernel.dispatch @configured_b[%count_x](%output) : [index](buffer)
  command.return
}

