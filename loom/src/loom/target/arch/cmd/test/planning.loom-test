  %8 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %9 = resource<command_input> {index = 1, source_type = buffer} : reg<cmd.binding>
  %10 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %11 = resource<command_input> {index = 1, source_type = index} : reg<cmd.executable>
  %12 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %13 = resource<command_input> {index = 1, source_type = index} : reg<cmd.entry>
  %14 = cmd.constant.u64 0
  %15 = cmd.constant.u64 -1
  %16 = cmd.constant.u64 4
  %17 = cmd.constant.u64 32
  %18 = cmd.constant.u64 8
  %19 = cmd.constant.u64 12
  %20 = cmd.constant.u32 1
  cmd.dispatch.direct<%10, %12>[%20, %20, %20](%8, %18, %19)
  %21 = cmd.buffer.ref.binding %8, %18, %19
  cmd.dispatch.indirect.dynamic.barrier<%11, %13>[%21](%9, %14, %15)
  return
}
