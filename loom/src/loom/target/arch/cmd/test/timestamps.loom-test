// RUN: emit command-program @capture_twice

command.def public @capture_twice() launch(%sample: view<1xi64>) {
  command.timestamp %sample : view<1xi64>
  command.timestamp %sample : view<1xi64>
  command.return
}

// ----
low.func.def public retain target<cmd.core> abi(command_program) abi_layout({entry_count = 0, executable_count = 0, fixed_buffer_count = 0, rebindable_binding_count = 1}) @capture_twice() asm {
  %1 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %2 = cmd.constant.u64 0
  %3 = cmd.constant.u64 -1
  %4 = cmd.memory.global {source = ["dispatch_write", "transfer_write"], target = ["indirect_command_read", "dispatch_read", "dispatch_write", "transfer_read", "transfer_write"]}
  %5 = cmd.constant.u64 8
  %6 = cmd.buffer.ref.binding %1, %2, %5
  cmd.timestamp %6
  cmd.barrier(%4) {source = ["command_process", "dispatch", "transfer", "atomic"], target = ["command_process", "dispatch", "transfer", "atomic"], flags = []}
  %7 = cmd.buffer.ref.binding %1, %2, %5
  cmd.timestamp %7
  return
}

// ====

// RUN: emit command-program @misaligned_capture

command.def public @misaligned_capture() launch(%samples: buffer) {
  %offset = index.constant 4 : offset
  %sample = buffer.view %samples[%offset] : buffer -> view<1xi64>
  // ERROR@+1: LOWERING/071 {requirement="an aligned eight-byte destination"}
  command.timestamp %sample : view<1xi64>
  command.return
}

// ====

// RUN: emit command-program @unplaced_capture

command.def public @unplaced_capture(%offset: offset) launch(%samples: buffer) {
  %sample = buffer.view %samples[%offset] : buffer -> view<1xi64>
  // ERROR@+1: LOWERING/071 {requirement="an exactly placed buffer range"}
  command.timestamp %sample : view<1xi64>
  command.return
}

// ====

// RUN: emit command-program @immutable_capture

command.def public @immutable_capture() launch(%parameters: buffer) {
  %sample = command.parameter %parameters, "sample" : view<1xi64>
  // ERROR@+1: LOWERING/071 {requirement="writable invocation or transient storage"}
  command.timestamp %sample : view<1xi64>
  command.return
}

// ====

// Start precedes both siblings; end follows both. The interior capture and
// independent dispatch share a wave and have no edge between them.
// RUN: emit command-program @capture_fork

kernel.entry.decl @work(%storage: buffer)

command.def public @capture_fork() launch(%samples: buffer, %storage: buffer) {
  %start_offset = index.constant 0 : offset
  %interior_offset = index.constant 8 : offset
  %end_offset = index.constant 16 : offset
  %start = buffer.view %samples[%start_offset] : buffer -> view<1xi64>
  %interior = buffer.view %samples[%interior_offset] : buffer -> view<1xi64>
  %end = buffer.view %samples[%end_offset] : buffer -> view<1xi64>
  %group_count = index.constant 1 : index
  command.timestamp %start : view<1xi64>
  command.concurrent {
    command.timestamp %interior : view<1xi64>
    kernel.dispatch @work[%group_count](%storage) : [index](buffer)
  }
  command.timestamp %end : view<1xi64>
  command.return
}

// ----
low.func.def public retain target<cmd.core> abi(command_program) abi_layout({entry_count = 1, executable_count = 1, fixed_buffer_count = 0, rebindable_binding_count = 2}) @capture_fork() asm {
  %10 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %11 = resource<command_input> {index = 1, source_type = buffer} : reg<cmd.binding>
  %12 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %13 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %14 = cmd.constant.u64 0
  %15 = cmd.constant.u64 -1
  %16 = cmd.constant.u64 8
  %17 = cmd.constant.u64 16
  %18 = cmd.memory.global {source = ["dispatch_write", "transfer_write"], target = ["indirect_command_read", "dispatch_read", "dispatch_write", "transfer_read", "transfer_write"]}
  %19 = cmd.buffer.ref.binding %10, %14, %16
  cmd.timestamp %19
  cmd.barrier(%18) {source = ["command_process", "dispatch", "transfer", "atomic"], target = ["command_process", "dispatch", "transfer", "atomic"], flags = []}
  %20 = cmd.buffer.ref.binding %10, %16, %16
  cmd.timestamp %20
  %21 = cmd.constant.u32 1
  cmd.dispatch.direct<%12, %13>[%21, %21, %21](%11, %14, %15)
  cmd.barrier(%18) {source = ["command_process", "dispatch", "transfer", "atomic"], target = ["command_process", "dispatch", "transfer", "atomic"], flags = []}
  %22 = cmd.buffer.ref.binding %10, %17, %16
  cmd.timestamp %22
  return
}

// ====

// A timestamp is a real transient use. The second allocation cannot reuse the
// first sample until its later consumer completes. The final sample may reuse
// the retired first range. Slab alignment must satisfy the clock write even
// when the source allocation has only byte alignment.
// RUN: emit command-program @capture_storage

kernel.entry.decl @consume(%sample: view<1xi64>, %output: buffer)

command.def public @capture_storage() launch(%output: buffer) {
  %base_offset = index.constant 0 : offset
  %bytes = index.constant 8 : offset
  %group_count = index.constant 1 : index
  %first_storage = buffer.alloca<global> align(1) %bytes : buffer
  %first = buffer.view %first_storage[%base_offset] : buffer -> view<1xi64>
  command.timestamp %first : view<1xi64>
  %second_storage = buffer.alloca<global> align(1) %bytes : buffer
  %second = buffer.view %second_storage[%base_offset] : buffer -> view<1xi64>
  command.timestamp %second : view<1xi64>
  kernel.dispatch @consume[%group_count](%first, %output) : [index](view<1xi64>, buffer)
  kernel.dispatch @consume[%group_count](%second, %output) : [index](view<1xi64>, buffer)
  %last_storage = buffer.alloca<global> align(1) %bytes : buffer
  %last = buffer.view %last_storage[%base_offset] : buffer -> view<1xi64>
  command.timestamp %last : view<1xi64>
  kernel.dispatch @consume[%group_count](%last, %output) : [index](view<1xi64>, buffer)
  command.return
}

// ----
low.func.def public retain target<cmd.core> abi(command_program) abi_layout({entry_count = 1, executable_count = 1, fixed_buffer_count = 0, rebindable_binding_count = 2}) @capture_storage() asm {
  %12 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %13 = resource<command_input> {index = 1, source_type = buffer} : reg<cmd.binding>
  %14 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %15 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %16 = cmd.constant.u64 0
  %17 = cmd.constant.u64 -1
  %18 = cmd.constant.u64 8
  %19 = cmd.memory.global {source = ["dispatch_write", "transfer_write"], target = ["indirect_command_read", "dispatch_read", "dispatch_write", "transfer_read", "transfer_write"]}
  %20 = cmd.buffer.ref.binding %13, %16, %18
  cmd.timestamp %20
  cmd.barrier(%19) {source = ["command_process", "dispatch", "transfer", "atomic"], target = ["command_process", "dispatch", "transfer", "atomic"], flags = []}
  %21 = cmd.buffer.ref.binding %13, %18, %18
  cmd.timestamp %21
  cmd.barrier(%19) {source = ["command_process", "dispatch", "transfer", "atomic"], target = ["command_process", "dispatch", "transfer", "atomic"], flags = []}
  %22 = cmd.constant.u32 1
  cmd.dispatch.direct<%14, %15>[%22, %22, %22](%13, %16, %18, %12, %16, %17)
  cmd.barrier(%19) {source = ["command_process", "dispatch", "transfer", "atomic"], target = ["command_process", "dispatch", "transfer", "atomic"], flags = []}
  cmd.dispatch.direct<%14, %15>[%22, %22, %22](%13, %18, %18, %12, %16, %17)
  cmd.barrier(%19) {source = ["command_process", "dispatch", "transfer", "atomic"], target = ["command_process", "dispatch", "transfer", "atomic"], flags = []}
  %23 = cmd.buffer.ref.binding %13, %16, %18
  cmd.timestamp %23
  cmd.barrier(%19) {source = ["command_process", "dispatch", "transfer", "atomic"], target = ["command_process", "dispatch", "transfer", "atomic"], flags = []}
  cmd.dispatch.direct<%14, %15>[%22, %22, %22](%13, %16, %18, %12, %16, %17)
  return
}
