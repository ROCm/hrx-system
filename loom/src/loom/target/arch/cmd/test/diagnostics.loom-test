// RUN: emit command-program @entry

// ERROR@+1: LOWERING/049 {program_name="recursive"}
command.program.def @recursive() launch() {
  command.program.launch @recursive() : ()
  command.return
}

command.program.def public @entry() launch() {
  command.program.launch @recursive() : ()
  command.return
}

// ====

// RUN: emit command-program @external_entry

// ERROR@+1: LOWERING/050 {kernel_name="external_kernel"}
kernel.decl @external_kernel(%workgroup_count_x: index) launch()

command.program.def public @external_entry(%workgroup_count_x: index) launch() {
  kernel.launch @external_kernel[%workgroup_count_x]() : [index]()
  command.return
}

// ====

// RUN: emit command-program @dynamic_dispatch

kernel.entry.decl @configured() where [workgroup_size(64, 1, 1)]

command.program.def public @dynamic_dispatch(%workgroup_count_x: index) launch() {
  // ERROR@+1: LOWERING/051 {kernel_name="configured", dimension="0", requirement="an exact unsigned 32-bit value"}
  kernel.dispatch @configured[%workgroup_count_x]() : [index]()
  command.return
}

// ====

// RUN: emit command-program @invalid_dispatch

kernel.entry.decl @range_checked() where [workgroup_size(64, 1, 1)]

command.program.def public @invalid_dispatch() launch() {
  %negative = index.constant -1 : index
  // ERROR@+1: LOWERING/051 {kernel_name="range_checked", dimension="0", requirement="within the unsigned 32-bit range"}
  kernel.dispatch @range_checked[%negative]() : [index]()
  command.return
}

// ====

// RUN: emit command-program @dynamic_argument

kernel.entry.decl @scalar_entry(%scale: i32) where [workgroup_size(64, 1, 1)]

command.program.def public @dynamic_argument(%scale: i32) launch() {
  %c1 = index.constant 1 : index
  // ERROR@+1: LOWERING/052 {kernel_name="scalar_entry", argument_index="0", actual_type="i32", requirement="an exact scalar bit pattern"}
  kernel.dispatch @scalar_entry[%c1](%scale) : [index](i32)
  command.return
}
