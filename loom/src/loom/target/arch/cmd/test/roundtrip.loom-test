// ====

low.func.def target<cmd.core> abi(command_program) @empty_indirect() asm {
  %launch_counts = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %executable = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %entry = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %launch_count_offset = cmd.constant.u64 0
  %launch_count_length = cmd.constant.u64 12
  %count_ref = cmd.buffer.ref.binding %launch_counts, %launch_count_offset, %launch_count_length
  cmd.dispatch.indirect.static<%executable, %entry>[%count_ref]()
  return
}

// ----
low.func.def target<cmd.core> abi(command_program) @empty_indirect() asm {
  %launch_counts = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %executable = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %entry = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %launch_count_offset = cmd.constant.u64 0
  %launch_count_length = cmd.constant.u64 12
  %count_ref = cmd.buffer.ref.binding %launch_counts, %launch_count_offset, %launch_count_length
  cmd.dispatch.indirect.static<%executable, %entry>[%count_ref]()
  return
}

// ====

// Execution and payload visibility are independent. The clock range and the
// payload can have different consumers at the same execution boundary.
low.func.def target<cmd.core> abi(command_program) @scoped_dependencies() asm {
  %feedback = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %c0 = cmd.constant.u64 0
  %sample_bytes = cmd.constant.u64 8
  %clock = cmd.buffer.ref.binding %feedback, %c0, %sample_bytes
  %sample = cmd.memory.buffer source(transfer_write) target(dispatch_read) %clock
  cmd.barrier source(transfer) target(dispatch)
  %payload = cmd.memory.global source(dispatch_write) target(dispatch_read|indirect_command_read)
  cmd.barrier source(transfer|dispatch) target(command_process|dispatch) %sample, %payload
  cmd.barrier<release_system> source(dispatch) target(none)
  return
}

// ----
low.func.def target<cmd.core> abi(command_program) @scoped_dependencies() asm {
  %feedback = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %c0 = cmd.constant.u64 0
  %sample_bytes = cmd.constant.u64 8
  %clock = cmd.buffer.ref.binding %feedback, %c0, %sample_bytes
  %sample = cmd.memory.buffer source(transfer_write) target(dispatch_read) %clock
  cmd.barrier source(transfer) target(dispatch)
  %payload = cmd.memory.global source(dispatch_write) target(indirect_command_read|dispatch_read)
  cmd.barrier source(dispatch|transfer) target(command_process|dispatch) %sample, %payload
  cmd.barrier<release_system> source(dispatch) target(none)
  return
}
