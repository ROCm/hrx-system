// Template applications are command-source composition until selection and
// inlining expose the selected provider's explicit commands.
// RUN: emit command-program @selected_schedule

kernel.def @one_group() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%storage: buffer) {
  kernel.return
}

kernel.def @eight_groups() {
  %unit = index.constant 1 : index
  %c8 = index.constant 8 : index
  kernel.launch.config workgroups(%c8, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%storage: buffer) {
  kernel.return
}

template.decl @test.decode_schedule(%token_count: index, %storage: buffer)

template.def<@test.decode_schedule> @decode_one(%token_count: index, %storage: buffer) where [eq(%token_count, 1)] {
  kernel.launch @one_group(%storage) : (buffer)
  template.return
}

template.def<@test.decode_schedule> @decode_many(%token_count: index, %storage: buffer) where [range(%token_count, 2, 8)] {
  kernel.launch @eight_groups(%storage) : (buffer)
  template.return
}

command.program.def public @selected_schedule() launch(%storage: buffer) {
  %token_count = index.constant 1 : index
  template.apply<@test.decode_schedule>(%token_count, %storage) : (index, buffer)
  command.return
}

// ----
low.func.def public retain target<cmd.core> abi(command_program) abi_layout({entry_count = 1, executable_count = 1, fixed_buffer_count = 0, rebindable_binding_count = 1}) @selected_schedule() asm {
  %15 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %16 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %17 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %18 = cmd.constant.u64 0
  %19 = cmd.constant.u64 -1
  %20 = cmd.constant.u32 1
  cmd.dispatch.direct<%16, %17>[%20, %20, %20](%15, %18, %19)
  return
}

// ====

// Exact template calls use the same source-composition boundary while
// bypassing provider ranking.
// RUN: emit command-program @exact_schedule

kernel.def @eight_groups() {
  %unit = index.constant 1 : index
  %c8 = index.constant 8 : index
  kernel.launch.config workgroups(%c8, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%storage: buffer) {
  kernel.return
}

template.decl @test.decode_schedule(%token_count: index, %storage: buffer)

template.def<@test.decode_schedule> @decode_many(%token_count: index, %storage: buffer) where [range(%token_count, 2, 8)] {
  kernel.launch @eight_groups(%storage) : (buffer)
  template.return
}

command.program.def public @exact_schedule() launch(%storage: buffer) {
  %token_count = index.constant 8 : index
  template.call @decode_many(%token_count, %storage) : (index, buffer)
  command.return
}

// ----
low.func.def public retain target<cmd.core> abi(command_program) abi_layout({entry_count = 1, executable_count = 1, fixed_buffer_count = 0, rebindable_binding_count = 1}) @exact_schedule() asm {
  %16 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %17 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %18 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %19 = cmd.constant.u64 0
  %20 = cmd.constant.u64 -1
  %21 = cmd.constant.u32 8
  %22 = cmd.constant.u32 1
  cmd.dispatch.direct<%17, %18>[%21, %22, %22](%16, %19, %20)
  return
}

// ====

// Final selection expands a general provider when the public input cannot
// prove the specialized provider's requirement.
// RUN: emit command-program @fallback_schedule

kernel.entry.decl @configured()

template.decl @test.schedule(%count: index)

template.def<@test.schedule> priority(10) @single(%count: index) where [eq(%count, 1)] {
  %unit = index.constant 1 : index
  kernel.dispatch @configured[%unit, %unit, %unit]() : [index, index, index]()
  template.return
}

template.def<@test.schedule> priority(1) @general(%count: index) {
  %groups = index.constant 8 : index
  %unit = index.constant 1 : index
  kernel.dispatch @configured[%groups, %unit, %unit]() : [index, index, index]()
  template.return
}

command.program.def public @fallback_schedule(%count: index) launch() {
  template.apply<@test.schedule>(%count) : (index)
  command.return
}

// ----
low.func.def public retain target<cmd.core> abi(command_program) abi_layout({entry_count = 1, executable_count = 1, fixed_buffer_count = 0, rebindable_binding_count = 0}) @fallback_schedule() asm {
  %7 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %8 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %9 = cmd.constant.u32 8
  %10 = cmd.constant.u32 1
  cmd.dispatch.direct<%7, %8>[%9, %10, %10]()
  return
}

// ====

// An unresolved family is accepted as command source composition but cannot
// cross the final specialization boundary.
// RUN: emit command-program @unresolved_schedule

template.decl @test.missing_schedule(%storage: buffer)

command.program.def public @unresolved_schedule() launch(%storage: buffer) {
  // ERROR@+1: LOWERING/045 {op_name="template.apply", phase_name="select-templates", contract_key="test.missing_schedule", failure_code="no_provider"}
  template.apply<@test.missing_schedule>(%storage) : (buffer)
  command.return
}

// ====

// Exact-only command source still establishes provider applicability before
// the provider's commands can replace its call.
// RUN: emit command-program @invalid_schedule

template.decl @test.schedule(%count: index)

template.def<@test.schedule> @several(%count: index) where [range(%count, 2, 8)] {
  template.return
}

command.program.def public @invalid_schedule() launch() {
  %out_of_range = index.constant 1 : index
  // ERROR@+1: LOWERING/045 {op_name="template.call", phase_name="select-templates", contract_key="test.schedule", failure_code="exact_call_rejected"}
  template.call @several(%out_of_range) : (index)
  command.return
}

// ====

// Selected and exact templates may compose command programs. Their staged
// branches are resolved before the portable program's entries are retained.
// RUN: emit command-program @narrow,@wide

kernel.def @configured(%groups: index) {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%storage: buffer) {
  kernel.return
}

command.program.def @stage(%groups: index) launch(%storage: buffer) {
  kernel.launch @configured[%groups](%storage) : [index](buffer)
  command.return
}

template.decl @test.composed(%wide: i1, %storage: buffer)

template.def<@test.composed> @composed(%wide: i1, %storage: buffer) {
  scf.if %wide {
    %c8 = index.constant 8 : index
    command.program.launch @stage[%c8](%storage) : [index](buffer)
  } else {
    %c1 = index.constant 1 : index
    command.program.launch @stage[%c1](%storage) : [index](buffer)
  }
  template.return
}

command.program.def public @narrow() launch(%storage: buffer) {
  %wide = scalar.constant false : i1
  template.apply<@test.composed>(%wide, %storage) : (i1, buffer)
  command.return
}

command.program.def public @wide() launch(%storage: buffer) {
  %wide = scalar.constant true : i1
  template.call @composed(%wide, %storage) : (i1, buffer)
  command.return
}

// ----
low.func.def public retain target<cmd.core> abi(command_program) abi_layout({entry_count = 1, executable_count = 1, fixed_buffer_count = 0, rebindable_binding_count = 1}) @narrow() asm {
  %28 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %29 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %30 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %31 = cmd.constant.u64 0
  %32 = cmd.constant.u64 -1
  %33 = cmd.constant.u32 1
  cmd.dispatch.direct<%29, %30>[%33, %33, %33](%28, %31, %32)
  return
}

low.func.def public retain target<cmd.core> abi(command_program) abi_layout({entry_count = 1, executable_count = 1, fixed_buffer_count = 0, rebindable_binding_count = 1}) @wide() asm {
  %34 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %35 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %36 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %37 = cmd.constant.u64 0
  %38 = cmd.constant.u64 -1
  %39 = cmd.constant.u32 8
  %40 = cmd.constant.u32 1
  cmd.dispatch.direct<%35, %36>[%39, %40, %40](%34, %37, %38)
  return
}

// ====

// A command/template/command chain retains each helper's serial sequence
// inside its caller's concurrent region, for both shared and single-use calls.
// RUN: emit command-program @joined

kernel.entry.decl @step(%input: buffer, %output: buffer)

command.program.def @pair() launch(%input: buffer, %temporary: buffer, %output: buffer) {
  %c1 = index.constant 1 : index
  kernel.dispatch @step[%c1](%input, %temporary) : [index](buffer, buffer)
  kernel.dispatch @step[%c1](%temporary, %output) : [index](buffer, buffer)
  command.return
}

template.decl @test.pair(%input: buffer, %temporary: buffer, %output: buffer)

template.def<@test.pair> @pair_template(%input: buffer, %temporary: buffer, %output: buffer) {
  command.program.launch @pair(%input, %temporary, %output) : (buffer, buffer, buffer)
  template.return
}

command.program.def @wrapper() launch(%input: buffer, %temporary: buffer, %output: buffer) {
  template.apply<@test.pair>(%input, %temporary, %output) : (buffer, buffer, buffer)
  command.return
}

command.program.def public @joined() launch(%input: buffer, %left_temporary: buffer, %left: buffer, %right_temporary: buffer, %right: buffer) {
  command.concurrent {
    command.program.launch @pair(%input, %left_temporary, %left) : (buffer, buffer, buffer)
    command.program.launch @wrapper(%input, %right_temporary, %right) : (buffer, buffer, buffer)
  }
  %c1 = index.constant 1 : index
  kernel.dispatch @step[%c1](%left, %right) : [index](buffer, buffer)
  command.return
}

// ----
low.func.def public retain target<cmd.core> abi(command_program) abi_layout({entry_count = 1, executable_count = 1, fixed_buffer_count = 0, rebindable_binding_count = 5}) @joined() asm {
  %22 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %23 = resource<command_input> {index = 1, source_type = buffer} : reg<cmd.binding>
  %24 = resource<command_input> {index = 2, source_type = buffer} : reg<cmd.binding>
  %25 = resource<command_input> {index = 3, source_type = buffer} : reg<cmd.binding>
  %26 = resource<command_input> {index = 4, source_type = buffer} : reg<cmd.binding>
  %27 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %28 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %29 = cmd.constant.u64 0
  %30 = cmd.constant.u64 -1
  %31 = cmd.constant.u32 1
  cmd.dispatch.direct<%27, %28>[%31, %31, %31](%22, %29, %30, %23, %29, %30)
  cmd.dispatch.direct<%27, %28>[%31, %31, %31](%22, %29, %30, %25, %29, %30)
  cmd.dispatch.direct.barrier<%27, %28>[%31, %31, %31](%23, %29, %30, %24, %29, %30)
  cmd.dispatch.direct<%27, %28>[%31, %31, %31](%25, %29, %30, %26, %29, %30)
  cmd.dispatch.direct.barrier<%27, %28>[%31, %31, %31](%24, %29, %30, %26, %29, %30)
  return
}

// ====

// A rejected provider's recursive command dependency does not participate in
// the selected command/template closure.
// RUN: emit command-program @selected

kernel.entry.decl @step()

command.program.def @recursive() launch() {
  command.program.launch @recursive() : ()
  command.return
}

template.decl @test.choice(%count: index)

template.def<@test.choice> @single(%count: index) where [eq(%count, 1)] {
  kernel.dispatch @step[%count]() : [index]()
  template.return
}

template.def<@test.choice> @other(%count: index) where [eq(%count, 2)] {
  command.program.launch @recursive() : ()
  template.return
}

command.program.def public @selected() launch() {
  %c1 = index.constant 1 : index
  template.apply<@test.choice>(%c1) : (index)
  command.return
}

// ----
low.func.def public retain target<cmd.core> abi(command_program) abi_layout({entry_count = 1, executable_count = 1, fixed_buffer_count = 0, rebindable_binding_count = 0}) @selected() asm {
  %3 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %4 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %5 = cmd.constant.u32 1
  cmd.dispatch.direct<%3, %4>[%5, %5, %5]()
  return
}
