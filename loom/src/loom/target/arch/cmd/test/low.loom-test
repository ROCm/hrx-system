// RUN: verify

// A Q/K/V preparation wave follows one scratch initialization wave. The
// executable and entry values are symbol-free ABI inputs, and the argument
// suffixes preserve variable kernel arity directly on the dispatch packets.
low.func.def target<cmd.core> abi(command_program) @qkv_two_wave() asm {
  %parameters = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.buffer>
  %input = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %scratch = resource<command_input> {index = 1, source_type = buffer} : reg<cmd.binding>
  %query_output = resource<command_input> {index = 2, source_type = buffer} : reg<cmd.binding>
  %key_output = resource<command_input> {index = 3, source_type = buffer} : reg<cmd.binding>
  %value_output = resource<command_input> {index = 4, source_type = buffer} : reg<cmd.binding>
  %query_executable = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %query_entry = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %key_executable = resource<command_input> {index = 1, source_type = index} : reg<cmd.executable>
  %key_entry = resource<command_input> {index = 1, source_type = index} : reg<cmd.entry>
  %value_executable = resource<command_input> {index = 2, source_type = index} : reg<cmd.executable>
  %value_entry = resource<command_input> {index = 2, source_type = index} : reg<cmd.entry>
  %zero_u32 = cmd.constant.u32 0
  %one_u32 = cmd.constant.u32 1
  %workgroup_count_x = cmd.constant.u32 32
  %zero_u64 = cmd.constant.u64 0
  %buffer_length = cmd.constant.u64 4096

  %scratch_ref = cmd.buffer.ref.binding %scratch, %zero_u64, %buffer_length

  cmd.fill %scratch_ref, %zero_u32, %one_u32
  cmd.dispatch.direct.barrier<%query_executable, %query_entry>[%workgroup_count_x, %one_u32, %one_u32](%parameters, %zero_u64, %buffer_length, %input, %zero_u64, %buffer_length, %query_output, %zero_u64, %buffer_length)

  cmd.dispatch.direct<%key_executable, %key_entry>[%workgroup_count_x, %one_u32, %one_u32](%parameters, %zero_u64, %buffer_length, %input, %zero_u64, %buffer_length, %key_output, %zero_u64, %buffer_length)

  cmd.dispatch.direct<%value_executable, %value_entry>[%workgroup_count_x, %one_u32, %one_u32](%parameters, %zero_u64, %buffer_length, %input, %zero_u64, %buffer_length, %value_output, %zero_u64, %buffer_length)

  cmd.barrier.execution
  return
}

// ====

low.func.def target<cmd.core> abi(command_program) @indirect_modes() asm {
  %launch_counts = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %executable = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %entry = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %c0 = cmd.constant.u64 0
  %count_length = cmd.constant.u64 12
  %count_ref = cmd.buffer.ref.binding %launch_counts, %c0, %count_length
  cmd.dispatch.indirect.static<%executable, %entry>[%count_ref]()
  cmd.dispatch.indirect.dynamic.barrier<%executable, %entry>[%count_ref]()
  return
}

// ====

low.func.def target<cmd.core> abi(command_program) @transfer_waits() asm {
  %source = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %target = resource<command_input> {index = 1, source_type = buffer} : reg<cmd.binding>
  %zero_u32 = cmd.constant.u32 0
  %one_u32 = cmd.constant.u32 1
  %zero_u64 = cmd.constant.u64 0
  %length = cmd.constant.u64 4096
  %source_ref = cmd.buffer.ref.binding %source, %zero_u64, %length
  %target_ref = cmd.buffer.ref.binding %target, %zero_u64, %length
  cmd.fill.barrier %target_ref, %zero_u32, %one_u32
  cmd.copy.barrier %source_ref, %target_ref
  return
}
