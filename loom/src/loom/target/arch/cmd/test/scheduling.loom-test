// ====

// RUN: emit command-program @kernel_schedule

kernel.entry.decl @left(%storage: buffer)
kernel.entry.decl @right(%storage: buffer)

command.program.def public @kernel_schedule() launch(%count_storage: buffer, %storage: buffer) {
  %c0 = index.constant 0 : offset
  %c1 = index.constant 1 : index
  %counts = buffer.view %count_storage[%c0] : buffer -> view<3xi32>
  kernel.launch.serial {
    kernel.launch.concurrent {
      kernel.dispatch @left[%counts](%storage) : [view<3xi32>](buffer)
      kernel.dispatch @right[%counts](%storage) : [view<3xi32>](buffer)
    }
    kernel.dispatch @left[%c1](%storage) : [index](buffer)
  }
  command.return
}

// ----
low.func.def public retain target<cmd.core> abi(command_program) abi_layout({entry_count = 2, executable_count = 2, fixed_buffer_count = 0, rebindable_binding_count = 2}) @kernel_schedule() asm {
  %7 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %8 = resource<command_input> {index = 1, source_type = buffer} : reg<cmd.binding>
  %9 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %10 = resource<command_input> {index = 1, source_type = index} : reg<cmd.executable>
  %11 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %12 = resource<command_input> {index = 1, source_type = index} : reg<cmd.entry>
  %13 = cmd.constant.u64 0
  %14 = cmd.constant.u64 -1
  %15 = cmd.constant.u64 12
  %16 = cmd.buffer.ref.binding %7, %13, %15
  cmd.dispatch.indirect.static<%9, %11>[%16](%8, %13, %14)
  %17 = cmd.buffer.ref.binding %7, %13, %15
  cmd.dispatch.indirect.static<%10, %12>[%17](%8, %13, %14)
  %18 = cmd.constant.u32 1
  cmd.dispatch.direct.barrier<%9, %11>[%18, %18, %18](%8, %13, %14)
  return
}
