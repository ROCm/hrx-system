// RUN: emit command-program @attention

kernel.def @prepare() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%parameters: buffer, %input: buffer, %scratch: buffer) {
  kernel.return
}

kernel.def @query() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%parameters: buffer, %scratch: buffer, %output: buffer) {
  kernel.return
}

kernel.def @key() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%parameters: buffer, %scratch: buffer, %output: buffer) {
  kernel.return
}

kernel.def @value() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%parameters: buffer, %scratch: buffer, %output: buffer) {
  kernel.return
}

command.program.def public @attention() launch(%parameters: buffer, %input: buffer, %scratch: buffer, %query_output: buffer, %key_output: buffer, %value_output: buffer) {
  kernel.launch @prepare(%parameters, %input, %scratch) : (buffer, buffer, buffer)
  command.concurrent {
    kernel.launch @query(%parameters, %scratch, %query_output) : (buffer, buffer, buffer)
    kernel.launch @key(%parameters, %scratch, %key_output) : (buffer, buffer, buffer)
    kernel.launch @value(%parameters, %scratch, %value_output) : (buffer, buffer, buffer)
  }
  command.return
}

// ----
low.func.def public retain target<cmd.core> abi(command_program) abi_layout({entry_count = 4, executable_count = 1, fixed_buffer_count = 0, rebindable_binding_count = 6}) @attention() asm {
  %0 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %1 = resource<command_input> {index = 1, source_type = buffer} : reg<cmd.binding>
  %2 = resource<command_input> {index = 2, source_type = buffer} : reg<cmd.binding>
  %3 = resource<command_input> {index = 3, source_type = buffer} : reg<cmd.binding>
  %4 = resource<command_input> {index = 4, source_type = buffer} : reg<cmd.binding>
  %5 = resource<command_input> {index = 5, source_type = buffer} : reg<cmd.binding>
  %6 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %7 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %8 = resource<command_input> {index = 1, source_type = index} : reg<cmd.entry>
  %9 = resource<command_input> {index = 2, source_type = index} : reg<cmd.entry>
  %10 = resource<command_input> {index = 3, source_type = index} : reg<cmd.entry>
  %11 = cmd.constant.u64 0
  %12 = cmd.constant.u64 -1
  %13 = cmd.constant.u32 1
  cmd.dispatch.direct<%6, %7>[%13, %13, %13]()
  cmd.dispatch.direct.barrier<%6, %8>[%13, %13, %13]()
  cmd.dispatch.direct<%6, %9>[%13, %13, %13]()
  cmd.dispatch.direct<%6, %10>[%13, %13, %13]()
  return
}

