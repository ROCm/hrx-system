// RUN: emit command-program @nested

kernel.def @a() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch() {
  kernel.return
}

kernel.def @b() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch() {
  kernel.return
}

kernel.def @c() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch() {
  kernel.return
}

kernel.def @d() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch() {
  kernel.return
}

kernel.def @e() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch() {
  kernel.return
}

command.program.def public @nested() launch() {
  command.concurrent {
    command.serial {
      kernel.launch @a() : ()
      kernel.launch @b() : ()
    }
    command.serial {
      kernel.launch @c() : ()
      kernel.launch @d() : ()
      kernel.launch @e() : ()
    }
  }
  command.return
}

// ----
low.func.def public retain target<cmd.core> abi(command_program) abi_layout({entry_count = 5, executable_count = 1, fixed_buffer_count = 0, rebindable_binding_count = 0}) @nested() asm {
  %0 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %1 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %2 = resource<command_input> {index = 1, source_type = index} : reg<cmd.entry>
  %3 = resource<command_input> {index = 2, source_type = index} : reg<cmd.entry>
  %4 = resource<command_input> {index = 3, source_type = index} : reg<cmd.entry>
  %5 = resource<command_input> {index = 4, source_type = index} : reg<cmd.entry>
  %6 = cmd.constant.u32 1
  cmd.dispatch.direct<%0, %1>[%6, %6, %6]()
  cmd.dispatch.direct<%0, %2>[%6, %6, %6]()
  cmd.dispatch.direct.barrier<%0, %3>[%6, %6, %6]()
  cmd.dispatch.direct<%0, %4>[%6, %6, %6]()
  cmd.dispatch.direct.barrier<%0, %5>[%6, %6, %6]()
  return
}

// ====

// RUN: emit command-program @kernel_schedule

kernel.def @left(%workgroup_count: index) {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%workgroup_count, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%storage: buffer) {
  kernel.return
}

kernel.def @right(%workgroup_count: index) {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%workgroup_count, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%storage: buffer) {
  kernel.return
}

command.program.def public @kernel_schedule(%workgroup_count: index) launch(%storage: buffer) where [range(%workgroup_count, 1, 128)] {
  %c1 = index.constant 1 : index
  kernel.launch.serial {
    kernel.launch.concurrent {
      kernel.launch @left[%workgroup_count](%storage) : [index](buffer)
      kernel.launch @right[%workgroup_count](%storage) : [index](buffer)
    }
    kernel.launch @left[%c1](%storage) : [index](buffer)
  }
  command.return
}

// ----
low.func.def public retain target<cmd.core> abi(command_program) abi_layout({entry_count = 3, executable_count = 1, fixed_buffer_count = 0, rebindable_binding_count = 2}) @kernel_schedule() asm {
  %0 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %1 = resource<command_input> {index = 1, source_type = buffer} : reg<cmd.binding>
  %2 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %3 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %4 = resource<command_input> {index = 1, source_type = index} : reg<cmd.entry>
  %5 = resource<command_input> {index = 2, source_type = index} : reg<cmd.entry>
  %6 = cmd.constant.u64 0
  %7 = cmd.constant.u64 -1
  %8 = cmd.constant.u64 12
  %9 = cmd.buffer.ref.binding %1, %6, %8
  cmd.dispatch.indirect.static<%2, %3>[%9]()
  cmd.dispatch.indirect.static<%2, %4>[%9]()
  %10 = cmd.constant.u32 1
  cmd.dispatch.direct.barrier<%2, %5>[%10, %10, %10]()
  return
}
