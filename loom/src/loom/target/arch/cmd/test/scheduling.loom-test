// RUN: emit command-program @attention

kernel.def @prepare() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%parameters: buffer, %input: buffer, %scratch: buffer) {
  kernel.return
}

kernel.def @query() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%parameters: buffer, %scratch: buffer, %output: buffer) {
  kernel.return
}

kernel.def @key() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%parameters: buffer, %scratch: buffer, %output: buffer) {
  kernel.return
}

kernel.def @value() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%parameters: buffer, %scratch: buffer, %output: buffer) {
  kernel.return
}

command.program.def public @attention() launch(%parameters: buffer, %input: buffer, %scratch: buffer, %query_output: buffer, %key_output: buffer, %value_output: buffer) {
  kernel.launch @prepare(%parameters, %input, %scratch) : (buffer, buffer, buffer)
  command.concurrent {
    kernel.launch @query(%parameters, %scratch, %query_output) : (buffer, buffer, buffer)
    kernel.launch @key(%parameters, %scratch, %key_output) : (buffer, buffer, buffer)
    kernel.launch @value(%parameters, %scratch, %value_output) : (buffer, buffer, buffer)
  }
  command.return
}

// ----
low.func.def public retain target<cmd.core> abi(command_program) abi_layout({entry_count = 4, executable_count = 4, fixed_buffer_count = 0, rebindable_binding_count = 6}) @attention() asm {
  %58 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %59 = resource<command_input> {index = 1, source_type = buffer} : reg<cmd.binding>
  %60 = resource<command_input> {index = 2, source_type = buffer} : reg<cmd.binding>
  %61 = resource<command_input> {index = 3, source_type = buffer} : reg<cmd.binding>
  %62 = resource<command_input> {index = 4, source_type = buffer} : reg<cmd.binding>
  %63 = resource<command_input> {index = 5, source_type = buffer} : reg<cmd.binding>
  %64 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %65 = resource<command_input> {index = 1, source_type = index} : reg<cmd.executable>
  %66 = resource<command_input> {index = 2, source_type = index} : reg<cmd.executable>
  %67 = resource<command_input> {index = 3, source_type = index} : reg<cmd.executable>
  %68 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %69 = resource<command_input> {index = 1, source_type = index} : reg<cmd.entry>
  %70 = resource<command_input> {index = 2, source_type = index} : reg<cmd.entry>
  %71 = resource<command_input> {index = 3, source_type = index} : reg<cmd.entry>
  %72 = cmd.constant.u64 0
  %73 = cmd.constant.u64 -1
  %74 = cmd.constant.u32 1
  cmd.dispatch.direct<%64, %68>[%74, %74, %74](%58, %72, %73, %59, %72, %73, %60, %72, %73)
  cmd.dispatch.direct.barrier<%65, %69>[%74, %74, %74](%58, %72, %73, %60, %72, %73, %61, %72, %73)
  cmd.dispatch.direct<%66, %70>[%74, %74, %74](%58, %72, %73, %60, %72, %73, %62, %72, %73)
  cmd.dispatch.direct<%67, %71>[%74, %74, %74](%58, %72, %73, %60, %72, %73, %63, %72, %73)
  return
}

