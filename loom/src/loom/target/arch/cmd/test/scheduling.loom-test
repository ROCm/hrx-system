command.program.def public @nested() launch() {
  command.concurrent {
    command.serial {
      kernel.launch @a() : ()
      kernel.launch @b() : ()
    }
    command.serial {
      kernel.launch @c() : ()
      kernel.launch @d() : ()
      kernel.launch @e() : ()
    }
  }
  command.return
}

