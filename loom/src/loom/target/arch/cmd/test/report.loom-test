// ====

// Immutable parameters and mutable launch buffers select distinct indirect
// dispatch forms. Parameter keys and offsets remain available after encoding.
// RUN: emit command-program @placed report

kernel.entry.decl @work(%data: view<4xi32>)

command.def public @placed() launch(%parameters: buffer, %count_storage: buffer, %clock: view<1xi64>) {
  %c0 = index.constant 0 : offset
  %counts = buffer.view %count_storage[%c0] : buffer -> view<3xi32>
  %weights = command.parameter %parameters, "weights" : view<4xi32>
  %fixed_counts = command.parameter %parameters, "counts" : view<3xi32>
  kernel.dispatch @work[%fixed_counts](%weights) : [view<3xi32>](view<4xi32>)
  kernel.dispatch @work[%counts](%weights) : [view<3xi32>](view<4xi32>)
  command.timestamp %clock : view<1xi64>
  command.return
}

