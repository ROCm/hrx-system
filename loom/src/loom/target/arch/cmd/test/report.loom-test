// ====

// Summary mode retains aggregate requirements without per-command arrays.
// RUN: emit command-program @slab report-summary

kernel.entry.decl @consume(%storage: buffer)

command.def public @slab() launch() {
  %c1 = index.constant 1 : index
  %small_bytes = index.constant 64 : offset
  %large_bytes = index.constant 80 : offset
  %small = buffer.alloca<global> align(16) %small_bytes : buffer
  kernel.dispatch @consume[%c1](%small) : [index](buffer)
  %large = buffer.alloca<global> align(16) %large_bytes : buffer
  kernel.dispatch @consume[%c1](%large) : [index](buffer)
  command.return
}

