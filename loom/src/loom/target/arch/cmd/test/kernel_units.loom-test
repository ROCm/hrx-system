// RUN: emit command-kernel @decode dependency=0

kernel.def @project(%row_count: index, %column_count: index) {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%row_count, %column_count, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%token_count: index, %input: buffer, %scratch: buffer, %output: buffer) where [range(%token_count, 1, 1024)] {
  %base = index.constant 0 : offset
  %c1 = index.constant 1 : index
  %input_view = buffer.view %input[%base] : buffer -> view<4097xi32, #dense>
  %output_view = buffer.view %output[%base] : buffer -> view<4097xi32, #dense>
  %value = view.load %input_view[0] : view<4097xi32, #dense> -> i32
  %is_decode = index.cmp eq, %token_count, %c1 : index
  scf.if %is_decode {
    view.store %value, %output_view[0] : i32, view<4097xi32, #dense>
  } else {
    %scratch_view = buffer.view %scratch[%base] : buffer -> view<1xi32, #dense>
    view.store %value, %scratch_view[0] : i32, view<1xi32, #dense>
    %scratch_value = view.load %scratch_view[0] : view<1xi32, #dense> -> i32
    view.store %scratch_value, %output_view[0] : i32, view<4097xi32, #dense>
  }
  kernel.return
}

command.program.def public @decode(%column_count: index) launch(%input: buffer, %scratch: buffer, %output: buffer) where [range(%column_count, 8, 4096), mul(%column_count, 8), pow2(%column_count)] {
  %c1 = index.constant 1 : index
  kernel.launch @project[%c1, %column_count](%c1, %input, %scratch, %output) : [index, index](index, buffer, buffer, buffer)
  command.return
}

// ----
kernel.def retain @project(%row_count: index, %column_count: index) {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%row_count, %column_count, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<4097xi32, #dense>
  %output_view = buffer.view %output[%base] : buffer -> view<4097xi32, #dense>
  %value = view.load %input_view[0] : view<4097xi32, #dense> -> i32
  view.store %value, %output_view[0] : i32, view<4097xi32, #dense>
  kernel.return
}

