// Shared samples and fresh observations have different lifetimes. These roots
// write the original storage; only a fresh read must observe the new contents.
// The exact output includes the generated kernels, their tuples, and the
// command sequence that places those observations around the writes.
// RUN: emit command-program @shared_sample,@fresh_observations,@sample_before_write kernels

test.target<device> @device

kernel.def target(@device) @consume_sample(%word: i32, %divisor: index) {
  %wide = scalar.extui %word : i32 to i64
  %count = index.cast %wide : i64 to index
  %groups = index.div %count, %divisor : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%storage: view<1xi32>) {
  %c0 = scalar.constant 0 : i32
  %group = kernel.workgroup.id<x> : index
  %first = index.constant 0 : index
  %leader = index.cmp eq, %group, %first : index
  scf.if %leader {
    view.store %c0, %storage[0] : i32, view<1xi32>
  }
  kernel.return
}

kernel.def target(@device) @consume_current(%source: view<1xi32>) {
  %word = view.load %source[0] : view<1xi32> -> i32
  %wide = scalar.extui %word : i32 to i64
  %groups = index.cast %wide : i64 to index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%storage: view<1xi32>) {
  %c0 = scalar.constant 0 : i32
  %group = kernel.workgroup.id<x> : index
  %first = index.constant 0 : index
  %leader = index.cmp eq, %group, %first : index
  scf.if %leader {
    view.store %c0, %storage[0] : i32, view<1xi32>
  }
  kernel.return
}

command.def public @shared_sample() launch(%storage: view<1xi32>) {
  %word = view.load %storage[0] : view<1xi32> -> i32
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  kernel.launch @consume_sample[%word, %c1](%storage) : [i32, index](view<1xi32>)
  kernel.launch @consume_sample[%word, %c2](%storage) : [i32, index](view<1xi32>)
  %bytes = index.constant 4 : offset
  %c0 = index.constant 0 : offset
  %scratch = buffer.alloca<global> align(4) %bytes : buffer
  %scratch_view = buffer.view %scratch[%c0] : buffer -> view<1xi32>
  kernel.launch @consume_sample[%word, %c1](%scratch_view) : [i32, index](view<1xi32>)
  kernel.launch @consume_sample[%word, %c2](%scratch_view) : [i32, index](view<1xi32>)
  command.return
}

command.def public @fresh_observations() launch(%storage: view<1xi32>) {
  kernel.launch @consume_current[%storage](%storage) : [view<1xi32>](view<1xi32>)
  kernel.launch @consume_current[%storage](%storage) : [view<1xi32>](view<1xi32>)
  command.return
}

command.def public @sample_before_write() launch(%storage: view<1xi32>) {
  %word = view.load %storage[0] : view<1xi32> -> i32
  %c1 = index.constant 1 : index
  %clear = scalar.constant 1 : i32
  kernel.launch @consume_sample[%clear, %c1](%storage) : [i32, index](view<1xi32>)
  kernel.launch @consume_sample[%word, %c1](%storage) : [i32, index](view<1xi32>)
  kernel.launch @consume_sample[%word, %c1](%storage) : [i32, index](view<1xi32>)
  kernel.launch @consume_current[%storage](%storage) : [view<1xi32>](view<1xi32>)
  command.return
}

