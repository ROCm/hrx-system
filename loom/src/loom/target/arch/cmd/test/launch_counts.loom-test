// ====

// A saved observation feeds concurrent branches without serializing their
// numerical work. Fresh and branch-local observations retain separate producers.
// RUN: emit command-program @concurrent_sample,@nested_then_fresh,@branch_local_samples kernels

test.target<device> @device

kernel.def target(@device) @work(%count: index) {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%count, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%output: view<8xi32>) {
  %group = kernel.workgroup.id<x> : index
  %word = index.cast %group : index to i32
  view.store %word, %output[%group] : i32, view<8xi32>
  kernel.return
}

kernel.def target(@device) @publish() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%control: view<1xi32>) {
  %word = scalar.constant 2 : i32
  view.store %word, %control[0] : i32, view<1xi32>
  kernel.return
}

command.def public @concurrent_sample() launch(%control: view<1xi32>, %first: view<8xi32>, %second: view<8xi32>, %last: view<8xi32>) {
  %word = view.load %control[0] : view<1xi32> -> i32
  %wide = scalar.extui %word : i32 to i64
  %raw = index.cast %wide : i64 to index
  %count = index.assume %raw [range(%raw, 0, 8)] : index
  command.concurrent {
    kernel.launch @work[%count](%first) : [index](view<8xi32>)
    kernel.launch @work[%count](%second) : [index](view<8xi32>)
  }
  kernel.launch @work[%count](%last) : [index](view<8xi32>)
  command.return
}

command.def public @nested_then_fresh() launch(%control: view<1xi32>, %first: view<8xi32>, %second: view<8xi32>, %third: view<8xi32>, %last: view<8xi32>) {
  %word = view.load %control[0] : view<1xi32> -> i32
  %wide = scalar.extui %word : i32 to i64
  %raw = index.cast %wide : i64 to index
  %count = index.assume %raw [range(%raw, 0, 8)] : index
  command.concurrent {
    command.serial {
      kernel.launch @work[%count](%first) : [index](view<8xi32>)
      kernel.launch @publish(%control) : (view<1xi32>)
      kernel.launch @work[%count](%third) : [index](view<8xi32>)
    }
    kernel.launch @work[%count](%second) : [index](view<8xi32>)
  }
  %next_word = view.load %control[0] : view<1xi32> -> i32
  %next_wide = scalar.extui %next_word : i32 to i64
  %next_raw = index.cast %next_wide : i64 to index
  %next = index.assume %next_raw [range(%next_raw, 0, 8)] : index
  kernel.launch @work[%next](%last) : [index](view<8xi32>)
  command.return
}

command.def public @branch_local_samples() launch(%left_control: view<1xi32>, %right_control: view<1xi32>, %first: view<8xi32>, %second: view<8xi32>) {
  command.concurrent {
    command.serial {
      kernel.launch @publish(%left_control) : (view<1xi32>)
      %word = view.load %left_control[0] : view<1xi32> -> i32
      %wide = scalar.extui %word : i32 to i64
      %raw = index.cast %wide : i64 to index
      %count = index.assume %raw [range(%raw, 0, 8)] : index
      kernel.launch @work[%count](%first) : [index](view<8xi32>)
    }
    command.serial {
      kernel.launch @publish(%right_control) : (view<1xi32>)
      %word = view.load %right_control[0] : view<1xi32> -> i32
      %wide = scalar.extui %word : i32 to i64
      %raw = index.cast %wide : i64 to index
      %count = index.assume %raw [range(%raw, 0, 8)] : index
      kernel.launch @work[%count](%second) : [index](view<8xi32>)
    }
  }
  command.return
}

