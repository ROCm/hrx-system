// ====

// A shared observation does not make different representations interchangeable.
// The adjacent contexts change index width, global address space, and hardware
// identity independently. Each boundary retains a separate count producer.
// RUN: emit command-program @representation_boundaries

test.target<low_core> @wide_indices

test.target<low_core> @narrow_indices {index_bitwidth = 32}

test.target<low_core> @separate_space {index_bitwidth = 32, memory_space_global = 7}

test.target<linear_subgroups> @other_identity {index_bitwidth = 32, memory_space_global = 7}

kernel.def target(@wide_indices) @wide_counts(%count: index) {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%count, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch() {
  kernel.return
}

kernel.def target(@narrow_indices) @narrow_counts(%count: index) {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%count, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch() {
  kernel.return
}

kernel.def target(@separate_space) @mapped_counts(%count: index) {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%count, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch() {
  kernel.return
}

kernel.def target(@other_identity) @other_counts(%count: index) {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%count, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch() {
  kernel.return
}

command.def public @representation_boundaries() launch(%source: view<1xi32>) {
  %word = view.load %source[0] : view<1xi32> -> i32
  %wide = scalar.extui %word : i32 to i64
  %count = index.cast %wide : i64 to index
  kernel.launch @wide_counts[%count]() : [index]()
  kernel.launch @narrow_counts[%count]() : [index]()
  kernel.launch @mapped_counts[%count]() : [index]()
  kernel.launch @other_counts[%count]() : [index]()
  command.return
}

