low.func.def public retain target<cmd.core> abi(command_program) abi_layout({entry_count = 2, executable_count = 2, fixed_buffer_count = 0, rebindable_binding_count = 2}) @shared_sample() asm {
  %197 = resource<command_input> {index = 0, source_type = buffer} : reg<cmd.binding>
  %198 = resource<command_input> {index = 1, source_type = buffer} : reg<cmd.binding>
  %199 = resource<command_input> {index = 0, source_type = index} : reg<cmd.executable>
  %200 = resource<command_input> {index = 1, source_type = index} : reg<cmd.executable>
  %201 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %202 = resource<command_input> {index = 1, source_type = index} : reg<cmd.entry>
  %203 = cmd.constant.u64 0
  %204 = cmd.constant.u64 -1
  %205 = cmd.constant.u64 24
  %206 = cmd.constant.u64 12
  %207 = cmd.constant.u64 4
  %208 = cmd.constant.u32 1
  cmd.dispatch.direct<%199, %201>[%208, %208, %208](%197, %203, %204, %198, %203, %205)
  %209 = cmd.buffer.ref.binding %198, %203, %206
  cmd.dispatch.indirect.dynamic.barrier<%200, %202>[%209](%197, %203, %204)
  %210 = cmd.buffer.ref.binding %198, %206, %206
  cmd.dispatch.indirect.dynamic.barrier<%200, %202>[%210](%197, %203, %204)
  %211 = cmd.buffer.ref.binding %198, %203, %206
  cmd.dispatch.indirect.dynamic.barrier<%200, %202>[%211](%198, %205, %207)
  %212 = cmd.buffer.ref.binding %198, %206, %206
  cmd.dispatch.indirect.dynamic.barrier<%200, %202>[%212](%198, %205, %207)
  return
}

