// ====

// Count production shares one sample across independent symbols and subgroup
// modes. Each configuration's subgroup query folds before fusion; the repeated
// wave32 consumer reuses its tuple after the wave64 consumer.
// RUN: emit command-program @target_contexts kernels

test.target<device> @first {subgroup_size = 32}

test.target<device> @equivalent {subgroup_size = 32}

test.target<device> @wide {subgroup_size = 64}

kernel.def target(@first) @first_kernel(%count: index) {
  %width = target.subgroup.size : index
  %groups = index.mul %count, %width : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %c1, %c1) workgroup_size(%width, %c1, %c1) : index
} launch() {
  kernel.return
}

kernel.def target(@equivalent) @equivalent_kernel(%count: index) {
  %width = target.subgroup.size : index
  %groups = index.mul %count, %width : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %c1, %c1) workgroup_size(%width, %c1, %c1) : index
} launch() {
  kernel.return
}

kernel.def target(@wide) @wide_kernel(%count: index) {
  %width = target.subgroup.size : index
  %groups = index.mul %count, %width : index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %c1, %c1) workgroup_size(%width, %c1, %c1) : index
} launch() {
  kernel.return
}

command.def public @target_contexts() launch(%source: view<1xi16>) {
  %word = view.load %source[0] : view<1xi16> -> i16
  %wide = scalar.extui %word : i16 to i64
  %count = index.cast %wide : i64 to index
  kernel.launch @first_kernel[%count]() : [index]()
  kernel.launch @equivalent_kernel[%count]() : [index]()
  kernel.launch @wide_kernel[%count]() : [index]()
  kernel.launch @first_kernel[%count]() : [index]()
  command.return
}

