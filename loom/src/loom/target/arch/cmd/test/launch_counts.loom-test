  %68 = resource<command_input> {index = 1, source_type = index} : reg<cmd.executable>
  %69 = resource<command_input> {index = 2, source_type = index} : reg<cmd.executable>
  %70 = resource<command_input> {index = 3, source_type = index} : reg<cmd.executable>
  %71 = resource<command_input> {index = 4, source_type = index} : reg<cmd.executable>
  %72 = resource<command_input> {index = 0, source_type = index} : reg<cmd.entry>
  %73 = resource<command_input> {index = 1, source_type = index} : reg<cmd.entry>
  %74 = resource<command_input> {index = 2, source_type = index} : reg<cmd.entry>
  %75 = resource<command_input> {index = 3, source_type = index} : reg<cmd.entry>
  %76 = resource<command_input> {index = 4, source_type = index} : reg<cmd.entry>
  %77 = cmd.constant.u64 0
  %78 = cmd.constant.u64 -1
  %79 = cmd.constant.u64 12
  %80 = cmd.constant.u32 1
  cmd.dispatch.direct<%67, %72>[%80, %80, %80](%65, %77, %78, %66, %77, %79)
  cmd.dispatch.direct.barrier<%68, %73>[%80, %80, %80](%65, %77, %78, %66, %79, %79)
  %81 = cmd.buffer.ref.binding %66, %79, %79
  cmd.dispatch.indirect.dynamic.barrier<%69, %74>[%81]()
  %82 = cmd.buffer.ref.binding %66, %79, %79
  cmd.dispatch.indirect.dynamic.barrier<%70, %75>[%82]()
