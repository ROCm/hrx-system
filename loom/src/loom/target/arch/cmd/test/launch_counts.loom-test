// ====

// Independent target symbols with identical semantics share count production.
// A different subgroup requirement remains a separate execution context.
// RUN: emit command-program @target_contexts

test.target<device> @first {subgroup_size = 32}

test.target<device> @equivalent {subgroup_size = 32}

test.target<device> @wide {subgroup_size = 64}

kernel.def target(@first) @first_kernel(%count: index) {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%count, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch() {
  kernel.return
}

kernel.def target(@equivalent) @equivalent_kernel(%count: index) {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%count, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch() {
  kernel.return
}

kernel.def target(@wide) @wide_kernel(%count: index) {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%count, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch() {
  kernel.return
}

command.def public @target_contexts() launch(%source: view<1xi32>) {
  %word = view.load %source[0] : view<1xi32> -> i32
  %wide = scalar.extui %word : i32 to i64
  %count = index.cast %wide : i64 to index
  kernel.launch @first_kernel[%count]() : [index]()
  kernel.launch @equivalent_kernel[%count]() : [index]()
  kernel.launch @wide_kernel[%count]() : [index]()
  command.return
}

