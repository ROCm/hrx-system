// ====

// Entry storage and fresh allocations are disjoint without author assertions.
// Two independently bound entry views may alias, so that case keeps both reads.
// RUN: emit command-program @entry_source,@allocated_source,@unknown_aliases

test.target<device> @device

kernel.def target(@device) @observe(%source: view<2xi32>, %position: index) {
  %word = view.load %source[%position] : view<2xi32> -> i32
  %wide = scalar.extui %word : i32 to i64
  %count = index.cast %wide : i64 to index
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%count, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%destination: view<2xi32>) {
  %c0 = scalar.constant 0 : i32
  %group = kernel.workgroup.id<x> : index
  %first = index.constant 0 : index
  %leader = index.cmp eq, %group, %first : index
  scf.if %leader {
    view.store %c0, %destination[0] : i32, view<2xi32>
    view.store %c0, %destination[1] : i32, view<2xi32>
  }
  kernel.return
}

kernel.def target(@device) @initialize() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%destination: view<2xi32>) {
  %value = scalar.constant 2 : i32
  view.store %value, %destination[0] : i32, view<2xi32>
  view.store %value, %destination[1] : i32, view<2xi32>
  kernel.return
}

command.def public @entry_source() launch(%source: view<2xi32>) {
  %bytes = index.constant 8 : offset
  %origin = index.constant 0 : offset
  %scratch = buffer.alloca<global> align(4) %bytes : buffer
  %destination = buffer.view %scratch[%origin] : buffer -> view<2xi32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  kernel.launch @observe[%source, %c0](%destination) : [view<2xi32>, index](view<2xi32>)
  kernel.launch @observe[%source, %c1](%destination) : [view<2xi32>, index](view<2xi32>)
  command.return
}

command.def public @allocated_source() launch(%destination: view<2xi32>) {
  %bytes = index.constant 8 : offset
  %origin = index.constant 0 : offset
  %scratch = buffer.alloca<global> align(4) %bytes : buffer
  %source = buffer.view %scratch[%origin] : buffer -> view<2xi32>
  kernel.launch @initialize(%source) : (view<2xi32>)
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  kernel.launch @observe[%source, %c0](%destination) : [view<2xi32>, index](view<2xi32>)
  kernel.launch @observe[%source, %c1](%destination) : [view<2xi32>, index](view<2xi32>)
  command.return
}

command.def public @unknown_aliases() launch(%source: view<2xi32>, %destination: view<2xi32>) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  kernel.launch @observe[%source, %c0](%destination) : [view<2xi32>, index](view<2xi32>)
  kernel.launch @observe[%source, %c1](%destination) : [view<2xi32>, index](view<2xi32>)
  command.return
}

