load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_cc_library(
    name = "program_plan",
    testonly = True,
    srcs = ["program_plan.c"],
    hdrs = ["program_plan.h"],
    deps = [
        "//loom/src/loom/codegen/low:text_asm",
        "//loom/src/loom/format/text:printer",
        "//loom/src/loom/ir",
        "//loom/src/loom/link:module_index",
        "//loom/src/loom/ops/command",
        "//loom/src/loom/pass:builtin_registry",
        "//loom/src/loom/target/arch/cmd:artifact_set",
        "//loom/src/loom/target/arch/cmd:program",
        "//loom/src/loom/target/arch/cmd/lower:program_plan",
        "//loom/src/loom/target/arch/cmd/lower:program_plan_index",
        "//loom/src/loom/tooling/compile:pipeline",
        "//loom/src/loom/tools/loom-check:execute",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
    ],
)

loom_cc_library(
    name = "check_provider",
    testonly = True,
    srcs = ["provider.c"],
    hdrs = ["provider.h"],
    visibility = ["//loom/src/loom/tools/loom-check:__pkg__"],
    deps = [
        ":program_plan",
        "//loom/src/loom/target/arch/cmd:provider",
        "//loom/src/loom/tools/loom-check:provider",
        "//runtime/src/iree/base",
    ],
)
