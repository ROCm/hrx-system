load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_instance_library", "loom_cc_library", "loom_generated_cc_library")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_X86_ROOT_VISIBILITY = ["//loom/src/loom/target/arch/x86:__pkg__"]

loom_cc_library(
    name = "op_defs",
    hdrs = ["ops.h"],
    textual_hdrs = ["ops.inc"],
    visibility = ["//visibility:public"],
    deps = [
        "//loom/src/loom/ops:headers",
        "//loom/src/loom/target:types",
        "//loom/src/loom/target/arch/x86/records:record_defs",
    ],
)

loom_cc_instance_library(
    name = "builders",
    srcs = ["builders.c"],
    hdrs = ["ops.h"],
    textual_hdrs = ["ops.inc"],
    visibility = ["//visibility:public"],
    deps = [
        "//loom/src/loom/ir:builders",
        "//loom/src/loom/ops:builders",
        "//loom/src/loom/target:types",
        "//loom/src/loom/target/arch/x86/records:record_defs",
    ],
)

loom_generated_cc_library(
    name = "ops",
    srcs = [
        "fact_projection.c",
        "registry.c",
        "target.c",
    ],
    hdrs = [
        "ops.h",
        "registry.h",
        "target.h",
    ],
    args = ["--dialect=x86"],
    extra_output_flags = [
        "--ops-include",
        "--builders",
    ],
    extra_outputs = [
        "ops.inc",
        "builders.c",
    ],
    generated_src_flags = ["--tables"],
    generated_srcs = ["tables.c"],
    generator = "//loom/py/loom/gen/ops:c_tables_x86_generator",
    textual_hdrs = ["ops.inc"],
    visibility = _X86_ROOT_VISIBILITY,
    deps = [
        ":builders",
        "//loom/src/loom/error:error_defs",
        "//loom/src/loom/error:parameter",
        "//loom/src/loom/error:x86_error_defs",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/ops/target",
        "//loom/src/loom/target:resolved_target",
        "//loom/src/loom/target:types",
        "//loom/src/loom/target/arch/x86:facts",
        "//loom/src/loom/target/arch/x86:feature_bits",
        "//loom/src/loom/target/arch/x86/records:target_records",
        "//runtime/src/iree/base",
    ],
)
