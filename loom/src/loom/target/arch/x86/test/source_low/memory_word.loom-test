low.func.def target<x86.avx2.core> abi(object_function) @copy_word_tail(%input: reg<x86.gpr64>, %output: reg<x86.gpr64>) asm {
  %46 = movzx.load.u16.gpr32 %input {disp32 = 1}
  %47 = movzx.load.u16.gpr32 %input {disp32 = 3}
  %48 = movzx.load.u16.gpr32 %input {disp32 = 5}
  %49 = movzx.load.u16.gpr32 %input {disp32 = 7}
  %50 = movzx.load.u16.gpr32 %input {disp32 = 9}
  %51 = movzx.load.u16.gpr32 %input {disp32 = 11}
  %52 = movzx.load.u16.gpr32 %input {disp32 = 13}
  %53 = movzx.load.u16.gpr32 %input {disp32 = 15}
  %54 = movzx.load.u16.gpr32 %input {disp32 = 17}
  mov.store.u16.gpr32 %46, %output {disp32 = 1}
  mov.store.u16.gpr32 %47, %output {disp32 = 3}
  mov.store.u16.gpr32 %48, %output {disp32 = 5}
  mov.store.u16.gpr32 %49, %output {disp32 = 7}
  mov.store.u16.gpr32 %50, %output {disp32 = 9}
  mov.store.u16.gpr32 %51, %output {disp32 = 11}
  mov.store.u16.gpr32 %52, %output {disp32 = 13}
  mov.store.u16.gpr32 %53, %output {disp32 = 15}
  mov.store.u16.gpr32 %54, %output {disp32 = 17}
