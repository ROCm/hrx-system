// RUN: emit source-low target=x86:avx2 output=low

// The AVX2 policy assembles packed streams in 64-bit words while retaining
// the two-lane plus one-lane partition of a three-byte source tail.
func.def @unpack_q3(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<3xi8>
  %output_view = buffer.view %output[%base] : buffer -> view<8xi32>
  %source = vector.load %input_view[0] : view<3xi8> -> vector<3xi8>
  %result = vector.bitunpacku<3> %source : vector<3xi8> -> vector<8xi32>
  vector.store %result, %output_view[0] : vector<8xi32>, view<8xi32>
  func.return
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) @unpack_q3(%input: reg<x86.gpr64>, %output: reg<x86.gpr64>) asm {
  %41 = movzx.load.u8.gpr64 %input {disp32 = 2}
  %42 = movzx.load.u16.gpr32 %input {disp32 = 0}
  %43 = vmovd.xmm.gpr32 %42
  %44 = vpextrw.xmm %43, 0
  %45 = movzx.u16.gpr64 %44
  %46 = copy %41 : reg<x86.gpr64> -> reg<x86.gpr64>
  %47 = shl.imm.gpr64 %46 {shift = 16}
  %48 = copy %45 : reg<x86.gpr64> -> reg<x86.gpr64>
  %49 = or.gpr64 %48, %47
  %50 = copy %49 : reg<x86.gpr64> -> reg<x86.gpr64>
  %51 = shl.imm.gpr64 %50 {shift = 20}
  %52 = copy %49 : reg<x86.gpr64> -> reg<x86.gpr64>
  %53 = or.gpr64 %52, %51
  %54 = mov.imm64 17587891081215
  %55 = copy %53 : reg<x86.gpr64> -> reg<x86.gpr64>
  %56 = and.gpr64 %55, %54
  %57 = copy %56 : reg<x86.gpr64> -> reg<x86.gpr64>
  %58 = shl.imm.gpr64 %57 {shift = 10}
  %59 = copy %56 : reg<x86.gpr64> -> reg<x86.gpr64>
  %60 = or.gpr64 %59, %58
  %61 = mov.imm64 17733194119839807
  %62 = copy %60 : reg<x86.gpr64> -> reg<x86.gpr64>
  %63 = and.gpr64 %62, %61
  %64 = copy %63 : reg<x86.gpr64> -> reg<x86.gpr64>
  %65 = shl.imm.gpr64 %64 {shift = 5}
  %66 = copy %63 : reg<x86.gpr64> -> reg<x86.gpr64>
  %67 = or.gpr64 %66, %65
  %68 = mov.imm64 506381209866536711
  %69 = copy %67 : reg<x86.gpr64> -> reg<x86.gpr64>
  %70 = and.gpr64 %69, %68
  %71 = vmovq.xmm.gpr64 %70
  %72 = avx2.vpbroadcastq.xmm %71
  %result = vpmovzxbd.ymm %72
  vmovdqu32.store.ymm %result, %output {disp32 = 0}
  return
}
