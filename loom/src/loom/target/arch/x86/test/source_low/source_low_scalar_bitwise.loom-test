// RUN: emit source-low output=low

x86.target<scalar> @target

func.def target(@target) @scalar_i32_bitwise(%lhs: i32, %rhs: i32) -> (i32) {
  %mask = scalar.constant 255 : i32
  %masked = scalar.andi %lhs, %mask : i32
  %tag = scalar.constant 240 : i32
  %tagged = scalar.ori %masked, %tag : i32
  %invert = scalar.constant -1 : i32
  %inverted = scalar.xori %tagged, %invert : i32
  %result = scalar.xori %inverted, %rhs : i32
  func.return %result : i32
}

// ----
low.func.def target<x86.scalar.core>(@target) abi(object_function) @scalar_i32_bitwise(%lhs: reg<x86.gpr32>, %rhs: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  %13 = copy %lhs : reg<x86.gpr32> -> reg<x86.gpr32>
  %masked = and.imm.gpr32 %13 {imm32 = 255}
  %15 = copy %masked : reg<x86.gpr32> -> reg<x86.gpr32>
  %tagged = or.imm.gpr32 %15 {imm32 = 240}
  %17 = copy %tagged : reg<x86.gpr32> -> reg<x86.gpr32>
  %inverted = xor.imm.gpr32 %17 {imm32 = -1}
  %19 = copy %inverted : reg<x86.gpr32> -> reg<x86.gpr32>
  %result = xor.gpr32 %19, %rhs
  return %result
}

// ====

x86.target<scalar> @target

func.def target(@target) @scalar_i32_shift_immediates(%value: i32) -> (i32) {
  %left_amount = scalar.constant 3 : i32
  %left = scalar.shli %value, %left_amount : i32
  %arithmetic_amount = scalar.constant 1 : i32
  %arithmetic = scalar.shrsi %left, %arithmetic_amount : i32
  %logical_amount = scalar.constant 2 : i32
  %result = scalar.shrui %arithmetic, %logical_amount : i32
  func.return %result : i32
}

// ----
low.func.def target<x86.scalar.core>(@target) abi(object_function) @scalar_i32_shift_immediates(%value: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  %10 = copy %value : reg<x86.gpr32> -> reg<x86.gpr32>
  %left = shl.imm.gpr32 %10 {shift = 3}
  %12 = copy %left : reg<x86.gpr32> -> reg<x86.gpr32>
  %arithmetic = sar.imm.gpr32 %12 {shift = 1}
  %14 = copy %arithmetic : reg<x86.gpr32> -> reg<x86.gpr32>
  %result = shr.imm.gpr32 %14 {shift = 2}
  return %result
}

// ====

x86.target<scalar> @target

func.def target(@target) @scalar_narrow_float_signs(%fp8_magnitude: f8E4M3, %fp8_sign: f8E4M3, %f16_magnitude: f16, %f16_sign: f16) -> (f8E4M3, f8E4M3, f8E4M3, f16, f16, f16) {
  %fp8_absolute = scalar.absf %fp8_magnitude : f8E4M3
  %fp8_negated = scalar.negf %fp8_magnitude : f8E4M3
  %fp8_copied = scalar.copysignf %fp8_magnitude, %fp8_sign : f8E4M3
  %f16_absolute = scalar.absf %f16_magnitude : f16
  %f16_negated = scalar.negf %f16_magnitude : f16
  %f16_copied = scalar.copysignf %f16_magnitude, %f16_sign : f16
  func.return %fp8_absolute, %fp8_negated, %fp8_copied, %f16_absolute, %f16_negated, %f16_copied : f8E4M3, f8E4M3, f8E4M3, f16, f16, f16
}

// ----
low.func.def target<x86.scalar.core>(@target) abi(object_function) abi_layout({signature = (f8E4M3, f8E4M3, f16, f16) -> (f8E4M3, f8E4M3, f8E4M3, f16, f16, f16)}) @scalar_narrow_float_signs(%fp8_magnitude: reg<x86.gpr32>, %fp8_sign: reg<x86.gpr32>, %f16_magnitude: reg<x86.gpr32>, %f16_sign: reg<x86.gpr32>) -> (reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr32>) asm {
  %106 = movzx.u8.gpr32 %fp8_magnitude
  %107 = copy %106 : reg<x86.gpr32> -> reg<x86.gpr32>
  %fp8_absolute = and.imm.gpr32 %107 {imm32 = 127}
  %109 = copy %106 : reg<x86.gpr32> -> reg<x86.gpr32>
  %fp8_negated = xor.imm.gpr32 %109 {imm32 = 128}
  %111 = movzx.u8.gpr32 %fp8_sign
  %112 = copy %111 : reg<x86.gpr32> -> reg<x86.gpr32>
  %113 = and.imm.gpr32 %112 {imm32 = 128}
  %114 = movzx.u8.gpr32 %fp8_absolute
  %115 = movzx.u8.gpr32 %113
  %116 = copy %114 : reg<x86.gpr32> -> reg<x86.gpr32>
  %fp8_copied = or.gpr32 %116, %115
  %118 = movzx.u16.gpr32 %f16_magnitude
  %119 = copy %118 : reg<x86.gpr32> -> reg<x86.gpr32>
  %f16_absolute = and.imm.gpr32 %119 {imm32 = 32767}
  %121 = copy %118 : reg<x86.gpr32> -> reg<x86.gpr32>
  %f16_negated = xor.imm.gpr32 %121 {imm32 = 32768}
  %123 = movzx.u16.gpr32 %f16_sign
  %124 = copy %123 : reg<x86.gpr32> -> reg<x86.gpr32>
  %125 = and.imm.gpr32 %124 {imm32 = 32768}
  %126 = movzx.u16.gpr32 %f16_absolute
  %127 = movzx.u16.gpr32 %125
  %128 = copy %126 : reg<x86.gpr32> -> reg<x86.gpr32>
  %f16_copied = or.gpr32 %128, %127
  return %fp8_absolute, %fp8_negated, %fp8_copied, %f16_absolute, %f16_negated, %f16_copied
}
