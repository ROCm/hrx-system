// ----
low.func.def target<x86.avx2.core>(@target) abi(object_function) @f32x8_memory_indexed(%input: reg<x86.gpr64>, %output: reg<x86.gpr64>, %bounded_i: reg<x86.gpr64>) asm {
  %loaded = vmovdqu32.load.indexed.ymm %input, %bounded_i {disp32 = 0, scale = 4}
  vmovdqu32.store.indexed.ymm %loaded, %output, %bounded_i {disp32 = 0, scale = 4}
  return
}

// ====

x86.target<avx2> @target

func.def target(@target) @i32x4_index_madd_scaled_bias_memory(%input: buffer, %output: buffer, %row: index) {
  %buffer_base = index.constant 0 : offset
  %stride = index.constant 4 : index
  %bias = index.constant 1 : index
  %linear = index.madd %row, %stride, %bias : index
  %bounded_linear = index.assume %linear [range(%linear, 0, 16)] : index
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<32xi32>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<32xi32>
  %loaded = vector.load %input_view[%bounded_linear] : view<32xi32> -> vector<4xi32>
  vector.store %loaded, %output_view[%bounded_linear] : vector<4xi32>, view<32xi32>
  func.return
}

// ----
low.func.def target<x86.avx2.core>(@target) abi(object_function) @i32x4_index_madd_scaled_bias_memory(%input: reg<x86.gpr64>, %output: reg<x86.gpr64>, %row: reg<x86.gpr64>) asm {
  %14 = lea.scale %row {disp32 = 1, scale = 4}
  %loaded = vmovdqu32.load.indexed.xmm %input, %14 {disp32 = 0, scale = 4}
  vmovdqu32.store.indexed.xmm %loaded, %output, %14 {disp32 = 0, scale = 4}
  return
}

// ====

x86.target<avx2> @target

func.def target(@target) @i8x32_memory_indexed(%input: buffer, %output: buffer, %i: index) {
  %bounded_i = index.assume %i [range(%i, 0, 32)] : index
  %buffer_base = index.constant 0 : offset
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<64xi8>
  %output_view = buffer.view %output[%buffer_base] : buffer -> view<64xi8>
  %loaded = vector.load %input_view[%bounded_i] : view<64xi8> -> vector<32xi8>
  vector.store %loaded, %output_view[%bounded_i] : vector<32xi8>, view<64xi8>
  func.return
}

// ----
low.func.def target<x86.avx2.core>(@target) abi(object_function) @i8x32_memory_indexed(%input: reg<x86.gpr64>, %output: reg<x86.gpr64>, %bounded_i: reg<x86.gpr64>) asm {
  %loaded = vmovdqu32.load.indexed.ymm %input, %bounded_i {disp32 = 0, scale = 1}
  vmovdqu32.store.indexed.ymm %loaded, %output, %bounded_i {disp32 = 0, scale = 1}
  return
}
