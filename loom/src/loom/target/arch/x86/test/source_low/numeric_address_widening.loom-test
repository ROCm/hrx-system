// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_address_widening.loom-test
// RUN: emit source-low target=x86:avx2 output=low

func.def @widen_address_domains(%coordinate: index, %byte_offset: offset) -> (i64, i64) {
  %signed = index.cast %coordinate : index to i64
  %unsigned = index.cast %byte_offset : offset to i64
  func.return %signed, %unsigned : i64, i64
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) @widen_address_domains(%signed: reg<x86.gpr64>, %unsigned: reg<x86.gpr64>) -> (reg<x86.gpr64>, reg<x86.gpr64>) asm {
  return %signed, %unsigned
}

// ====

func.def @widen_address_payload(%input: i32) -> (i64, i64) {
  %coordinate = index.cast %input : i32 to index
  %byte_offset = index.cast %input : i32 to offset
  %signed = index.cast %coordinate : index to i64
  %unsigned = index.cast %byte_offset : offset to i64
  func.return %signed, %unsigned : i64, i64
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) @widen_address_payload(%input: reg<x86.gpr32>) -> (reg<x86.gpr64>, reg<x86.gpr64>) asm {
  %signed = movsxd.gpr64.gpr32 %input
  %unsigned = movzx.gpr64.gpr32 %input
  return %signed, %unsigned
}

// ====

func.def @widen_constant_addresses() -> (i64, i64, i64, i64) {
  %high_bit = scalar.constant -2147483648 : i32
  %all_bits = scalar.constant -1 : i32
  %minimum_index = index.cast %high_bit : i32 to index
  %negative_index = index.cast %all_bits : i32 to index
  %high_bit_offset = index.cast %high_bit : i32 to offset
  %maximum_offset = index.cast %all_bits : i32 to offset
  %minimum = index.cast %minimum_index : index to i64
  %negative = index.cast %negative_index : index to i64
  %high = index.cast %high_bit_offset : offset to i64
  %maximum = index.cast %maximum_offset : offset to i64
  func.return %minimum, %negative, %high, %maximum : i64, i64, i64, i64
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) @widen_constant_addresses() -> (reg<x86.gpr64>, reg<x86.gpr64>, reg<x86.gpr64>, reg<x86.gpr64>) asm {
  %minimum = mov.imm64 -2147483648
  %negative = mov.imm64 -1
  %high = mov.imm64 2147483648
  %maximum = mov.imm64 4294967295
  return %minimum, %negative, %high, %maximum
}

// ====

func.def @widen_varying_address_payload(%values: vector<4xi32>) -> (i64, i64) {
  %input = vector.extract %values[0] : vector<4xi32> -> i32
  %coordinate = index.cast %input : i32 to index
  %byte_offset = index.cast %input : i32 to offset
  %signed = index.cast %coordinate : index to i64
  %unsigned = index.cast %byte_offset : offset to i64
  func.return %signed, %unsigned : i64, i64
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) @widen_varying_address_payload(%values: reg<x86.xmm>) -> (reg<x86.gpr64>, reg<x86.gpr64>) asm {
  %input = vpextrd.xmm %values, 0
  %signed = movsxd.gpr64.gpr32 %input
  %unsigned = movzx.gpr64.gpr32 %input
  return %signed, %unsigned
}

// ====

func.def @widen_nonnegative_addresses(%coordinate: index, %byte_offset: offset) -> (i64, i64) {
  %bounded_coordinate = index.assume %coordinate [range(%coordinate, 0, 2147483647)] : index
  %bounded_offset = index.assume %byte_offset [range(%byte_offset, 0, 4294967295)] : offset
  %signed = index.cast %bounded_coordinate : index to i64
  %unsigned = index.cast %bounded_offset : offset to i64
  func.return %signed, %unsigned : i64, i64
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) @widen_nonnegative_addresses(%signed: reg<x86.gpr64>, %unsigned: reg<x86.gpr64>) -> (reg<x86.gpr64>, reg<x86.gpr64>) asm {
  return %signed, %unsigned
}
