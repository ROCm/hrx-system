// RUN: emit source-low target=x86:avx2 output=low

func.def @supported_f64_positive_zero() -> (f64, vector<2xf64>) {
  %scalar = scalar.constant 0.0 : f64
  %vector = vector.splatf 0.0 : vector<2xf64>
  func.return %scalar, %vector : f64, vector<2xf64>
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) abi_layout({signature = () -> (f64, vector<2xf64>)}) @supported_f64_positive_zero() -> (reg<x86.xmm>, reg<x86.xmm>) asm {
  %scalar = vxorps.zero.xmm
  return %scalar, %scalar
}

// ====

func.def @f64x2_constant_payloads() -> (vector<2xf64>, vector<2xf64>, vector<2xf64>, vector<2xf64>, vector<2xf64>, vector<2xf64>, vector<2xf64>) {
  %signed_payload = vector.splatf -0.0 : vector<2xf64>
  %fraction = vector.splatf -1.1000000000000001 : vector<2xf64>
  %subnormal = vector.splatf 4.9406564584124654e-324 : vector<2xf64>
  %normal = vector.splatf 2.2250738585072014e-308 : vector<2xf64>
  %positive_infinity = vector.splatf inf : vector<2xf64>
  %negative_infinity = vector.splatf -inf : vector<2xf64>
  %nan = vector.splatf nan : vector<2xf64>
  func.return %signed_payload, %fraction, %subnormal, %normal, %positive_infinity, %negative_infinity, %nan : vector<2xf64>, vector<2xf64>, vector<2xf64>, vector<2xf64>, vector<2xf64>, vector<2xf64>, vector<2xf64>
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) abi_layout({signature = () -> (vector<2xf64>, vector<2xf64>, vector<2xf64>, vector<2xf64>, vector<2xf64>, vector<2xf64>, vector<2xf64>)}) @f64x2_constant_payloads() -> (reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>) asm {
  %21 = mov.imm64 -9223372036854775808
  %22 = vmovq.xmm.gpr64 %21
  %signed_payload = avx2.vpbroadcastq.xmm %22
  %24 = mov.imm64 -4615739258092021350
  %25 = vmovq.xmm.gpr64 %24
  %fraction = avx2.vpbroadcastq.xmm %25
  %27 = mov.imm64 1
  %28 = vmovq.xmm.gpr64 %27
  %subnormal = avx2.vpbroadcastq.xmm %28
  %30 = mov.imm64 4503599627370496
  %31 = vmovq.xmm.gpr64 %30
  %normal = avx2.vpbroadcastq.xmm %31
  %33 = mov.imm64 9218868437227405312
  %34 = vmovq.xmm.gpr64 %33
  %positive_infinity = avx2.vpbroadcastq.xmm %34
  %36 = mov.imm64 -4503599627370496
  %37 = vmovq.xmm.gpr64 %36
  %negative_infinity = avx2.vpbroadcastq.xmm %37
  %39 = mov.imm64 9221120237041090560
  %40 = vmovq.xmm.gpr64 %39
  %nan = avx2.vpbroadcastq.xmm %40
  return %signed_payload, %fraction, %subnormal, %normal, %positive_infinity, %negative_infinity, %nan
}

// ====

func.def @folded_f64_splat() -> (vector<2xf64>) {
  %scalar = scalar.constant 1.1000000000000001 : f64
  %vector = vector.splat %scalar : vector<2xf64>
  func.return %vector : vector<2xf64>
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) abi_layout({signature = () -> (vector<2xf64>)}) @folded_f64_splat() -> (reg<x86.xmm>) asm {
  %5 = mov.imm64 4607632778762754458
  %6 = vmovq.xmm.gpr64 %5
  %vector = avx2.vpbroadcastq.xmm %6
  return %vector
}
