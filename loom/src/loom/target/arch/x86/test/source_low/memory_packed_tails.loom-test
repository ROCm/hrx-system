  %95 = movzx.load.u16.gpr32 %input {disp32 = 28}
  mov.store.u16.gpr32 %89, %output {disp32 = 16}
  mov.store.u16.gpr32 %90, %output {disp32 = 18}
  mov.store.u16.gpr32 %91, %output {disp32 = 20}
  mov.store.u16.gpr32 %92, %output {disp32 = 22}
  mov.store.u16.gpr32 %93, %output {disp32 = 24}
  mov.store.u16.gpr32 %94, %output {disp32 = 26}
  mov.store.u16.gpr32 %95, %output {disp32 = 28}
  %96 = movzx.load.u16.gpr32 %input {disp32 = 30}
  %97 = movzx.load.u16.gpr32 %input {disp32 = 32}
  %98 = movzx.load.u16.gpr32 %input {disp32 = 34}
