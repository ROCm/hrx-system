// RUN: emit source-low target=x86:scalar output=low

func.def @copy_narrow_static(%input: buffer, %output: buffer) {
  %byte_base = index.constant 0 : offset
  %word_base = index.constant 1 : offset
  %source_bytes = buffer.view %input[%byte_base] : buffer -> view<8xi8>
  %source_words = buffer.view %input[%word_base] : buffer -> view<4xi16, align(1)>
  %destination_bytes = buffer.view %output[%byte_base] : buffer -> view<8xi8>
  %destination_words = buffer.view %output[%word_base] : buffer -> view<4xi16, align(1)>
  %byte = view.load %source_bytes[3] : view<8xi8> -> i8
  %word = view.load %source_words[2] : view<4xi16, align(1)> -> i16
  view.store %byte, %destination_bytes[3] : i8, view<8xi8>
  view.store %word, %destination_words[2] : i16, view<4xi16, align(1)>
  func.return
}

// ----
low.func.def target<x86.scalar.core> abi(object_function) @copy_narrow_static(%input: reg<x86.gpr64>, %output: reg<x86.gpr64>) asm {
  %byte = movzx.load.u8.gpr32 %input {disp32 = 3}
  %word = movzx.load.u16.gpr32 %input {disp32 = 5}
  mov.store.u8.gpr32 %byte, %output {disp32 = 3}
  mov.store.u16.gpr32 %word, %output {disp32 = 5}
  return
}

// ====

func.def @copy_narrow_index(%input: buffer, %output: buffer, %element: index) {
  %position = index.assume %element [range(%element, 0, 15)] : index
  %byte_base = index.constant 1 : offset
  %word_base = index.constant 33 : offset
  %source_bytes = buffer.view %input[%byte_base] : buffer -> view<16xi8>
  %source_words = buffer.view %input[%word_base] : buffer -> view<16xi16, align(1)>
  %destination_bytes = buffer.view %output[%byte_base] : buffer -> view<16xi8>
  %destination_words = buffer.view %output[%word_base] : buffer -> view<16xi16, align(1)>
  %byte = view.load %source_bytes[%position] : view<16xi8> -> i8
  %word = view.load %source_words[%position] : view<16xi16, align(1)> -> i16
  view.store %byte, %destination_bytes[%position] : i8, view<16xi8>
  view.store %word, %destination_words[%position] : i16, view<16xi16, align(1)>
  func.return
}

// ----
low.func.def target<x86.scalar.core> abi(object_function) @copy_narrow_index(%input: reg<x86.gpr64>, %output: reg<x86.gpr64>, %position: reg<x86.gpr64>) asm {
  %byte = movzx.load.indexed.u8.gpr32 %input, %position {disp32 = 1, scale = 1}
  %word = movzx.load.indexed.u16.gpr32 %input, %position {disp32 = 33, scale = 2}
  mov.store.indexed.u8.gpr32 %byte, %output, %position {disp32 = 1, scale = 1}
  mov.store.indexed.u16.gpr32 %word, %output, %position {disp32 = 33, scale = 2}
  return
}

// ====

func.def @copy_narrow_origin(%input: buffer, %output: buffer, %byte_offset: offset, %element: index) {
  %base = index.assume %byte_offset [range(%byte_offset, 0, 128)] : offset
  %position = index.assume %element [range(%element, 0, 15)] : index
  %prefix = index.constant 33 : offset
  %word_base = index.add %base, %prefix : offset
  %source_bytes = buffer.view %input[%base] : buffer -> view<16xi8>
  %source_words = buffer.view %input[%word_base] : buffer -> view<16xi16, align(1)>
  %destination_bytes = buffer.view %output[%base] : buffer -> view<16xi8>
  %destination_words = buffer.view %output[%word_base] : buffer -> view<16xi16, align(1)>
  %byte = view.load<volatile> %source_bytes[%position] : view<16xi8> -> i8
  %word = view.load<volatile> %source_words[%position] : view<16xi16, align(1)> -> i16
  view.store<volatile> %byte, %destination_bytes[%position] : i8, view<16xi8>
  view.store<volatile> %word, %destination_words[%position] : i16, view<16xi16, align(1)>
  func.return
}

// ----
low.func.def target<x86.scalar.core> abi(object_function) @copy_narrow_origin(%input: reg<x86.gpr64>, %output: reg<x86.gpr64>, %base: reg<x86.gpr64>, %position: reg<x86.gpr64>) asm {
  %18 = copy %base : reg<x86.gpr64> -> reg<x86.gpr64>
  %19 = add.gpr64 %18, %position
  %byte = movzx.load.indexed.u8.gpr32<volatile> %input, %19 {disp32 = 0, scale = 1}
  %21 = mov.imm64 2
  %22 = copy %position : reg<x86.gpr64> -> reg<x86.gpr64>
  %23 = imul.gpr64 %22, %21
  %24 = copy %base : reg<x86.gpr64> -> reg<x86.gpr64>
  %25 = add.gpr64 %24, %23
  %word = movzx.load.indexed.u16.gpr32<volatile> %input, %25 {disp32 = 33, scale = 1}
  mov.store.indexed.u8.gpr32<volatile> %byte, %output, %19 {disp32 = 0, scale = 1}
  mov.store.indexed.u16.gpr32<volatile> %word, %output, %25 {disp32 = 33, scale = 1}
  return
}

// ====

func.def @copy_narrow_stride(%input: buffer, %output: buffer, %column_count: index, %row_index: index, %column_index: index) {
  %columns = index.assume %column_count [range(%column_count, 1, 16)] : index
  %row = index.assume %row_index [range(%row_index, 0, 3)] : index
  %column = index.assume %column_index [range(%column_index, 0, 15), lt(%column_index, %columns)] : index
  %byte_base = index.constant 1 : offset
  %word_base = index.constant 65 : offset
  %source_bytes = buffer.view %input[%byte_base] : buffer -> view<4x[%columns]xi8>
  %source_words = buffer.view %input[%word_base] : buffer -> view<4x[%columns]xi16, align(1)>
  %destination_bytes = buffer.view %output[%byte_base] : buffer -> view<4x[%columns]xi8>
  %destination_words = buffer.view %output[%word_base] : buffer -> view<4x[%columns]xi16, align(1)>
  %byte = view.load %source_bytes[%row, %column] : view<4x[%columns]xi8> -> i8
  %word = view.load %source_words[%row, %column] : view<4x[%columns]xi16, align(1)> -> i16
  view.store %byte, %destination_bytes[%row, %column] : i8, view<4x[%columns]xi8>
  view.store %word, %destination_words[%row, %column] : i16, view<4x[%columns]xi16, align(1)>
  func.return
}

// ----
low.func.def target<x86.scalar.core> abi(object_function) @copy_narrow_stride(%input: reg<x86.gpr64>, %output: reg<x86.gpr64>, %columns: reg<x86.gpr64>, %row: reg<x86.gpr64>, %column: reg<x86.gpr64>) asm {
  %21 = copy %row : reg<x86.gpr64> -> reg<x86.gpr64>
  %22 = imul.gpr64 %21, %columns
  %23 = copy %22 : reg<x86.gpr64> -> reg<x86.gpr64>
  %24 = add.gpr64 %23, %column
  %byte = movzx.load.indexed.u8.gpr32 %input, %24 {disp32 = 1, scale = 1}
  %28 = mov.imm64 2
  %29 = copy %22 : reg<x86.gpr64> -> reg<x86.gpr64>
  %30 = imul.gpr64 %29, %28
  %32 = copy %column : reg<x86.gpr64> -> reg<x86.gpr64>
  %33 = imul.gpr64 %32, %28
  %34 = copy %30 : reg<x86.gpr64> -> reg<x86.gpr64>
  %35 = add.gpr64 %34, %33
  %word = movzx.load.indexed.u16.gpr32 %input, %35 {disp32 = 65, scale = 1}
  mov.store.indexed.u8.gpr32 %byte, %output, %24 {disp32 = 1, scale = 1}
  mov.store.indexed.u16.gpr32 %word, %output, %35 {disp32 = 65, scale = 1}
  return
}

// ====

func.def @exchange_narrow(%buffer: buffer, %byte_value: i8, %word_value: i16) -> (i32, i32) {
  %byte_base = index.constant 0 : offset
  %word_base = index.constant 1 : offset
  %bytes = buffer.view %buffer[%byte_base] : buffer -> view<1xi8>
  %words = buffer.view %buffer[%word_base] : buffer -> view<1xi16, align(1)>
  %previous_byte = view.load %bytes[0] : view<1xi8> -> i8
  %previous_word = view.load %words[0] : view<1xi16, align(1)> -> i16
  view.store %byte_value, %bytes[0] : i8, view<1xi8>
  view.store %word_value, %words[0] : i16, view<1xi16, align(1)>
  %byte_bits = scalar.extui %previous_byte : i8 to i32
  %word_bits = scalar.extui %previous_word : i16 to i32
  func.return %byte_bits, %word_bits : i32, i32
}

// ----
low.func.def target<x86.scalar.core> abi(object_function) abi_layout({signature = (buffer, i8, i16) -> (i32, i32)}) @exchange_narrow(%buffer: reg<x86.gpr64>, %byte_value: reg<x86.gpr32>, %word_value: reg<x86.gpr32>) -> (reg<x86.gpr32>, reg<x86.gpr32>) asm {
  %byte_bits = movzx.load.u8.gpr32 %buffer {disp32 = 0}
  %word_bits = movzx.load.u16.gpr32 %buffer {disp32 = 1}
  mov.store.u8.gpr32 %byte_value, %buffer {disp32 = 0}
  mov.store.u16.gpr32 %word_value, %buffer {disp32 = 1}
  return %byte_bits, %word_bits
}

// ====

func.def @extend_narrow_loads(%input: buffer) -> (i32, i64, i32, i64, i32, i64, i32, i64, i64, i64) {
  %byte_base = index.constant 0 : offset
  %word_base = index.constant 4 : offset
  %dword_base = index.constant 12 : offset
  %bytes = buffer.view %input[%byte_base] : buffer -> view<4xi8>
  %words = buffer.view %input[%word_base] : buffer -> view<4xi16, align(1)>
  %dwords = buffer.view %input[%dword_base] : buffer -> view<2xi32, align(1)>
  %unsigned_byte32 = view.load %bytes[0] : view<4xi8> -> i8
  %unsigned_byte64 = view.load %bytes[1] : view<4xi8> -> i8
  %signed_byte32 = view.load %bytes[2] : view<4xi8> -> i8
  %signed_byte64 = view.load %bytes[3] : view<4xi8> -> i8
  %unsigned_word32 = view.load %words[0] : view<4xi16, align(1)> -> i16
  %unsigned_word64 = view.load %words[1] : view<4xi16, align(1)> -> i16
  %signed_word32 = view.load %words[2] : view<4xi16, align(1)> -> i16
  %signed_word64 = view.load %words[3] : view<4xi16, align(1)> -> i16
  %unsigned_dword64 = view.load %dwords[0] : view<2xi32, align(1)> -> i32
  %signed_dword64 = view.load %dwords[1] : view<2xi32, align(1)> -> i32
  %u8_i32 = scalar.extui %unsigned_byte32 : i8 to i32
  %u8_i64 = scalar.extui %unsigned_byte64 : i8 to i64
  %s8_i32 = scalar.extsi %signed_byte32 : i8 to i32
  %s8_i64 = scalar.extsi %signed_byte64 : i8 to i64
  %u16_i32 = scalar.extui %unsigned_word32 : i16 to i32
  %u16_i64 = scalar.extui %unsigned_word64 : i16 to i64
  %s16_i32 = scalar.extsi %signed_word32 : i16 to i32
  %s16_i64 = scalar.extsi %signed_word64 : i16 to i64
  %u32_i64 = scalar.extui %unsigned_dword64 : i32 to i64
  %s32_i64 = scalar.extsi %signed_dword64 : i32 to i64
  func.return %u8_i32, %u8_i64, %s8_i32, %s8_i64, %u16_i32, %u16_i64, %s16_i32, %s16_i64, %u32_i64, %s32_i64 : i32, i64, i32, i64, i32, i64, i32, i64, i64, i64
}

// ----
low.func.def target<x86.scalar.core> abi(object_function) @extend_narrow_loads(%input: reg<x86.gpr64>) -> (reg<x86.gpr32>, reg<x86.gpr64>, reg<x86.gpr32>, reg<x86.gpr64>, reg<x86.gpr32>, reg<x86.gpr64>, reg<x86.gpr32>, reg<x86.gpr64>, reg<x86.gpr64>, reg<x86.gpr64>) asm {
  %u8_i32 = movzx.load.u8.gpr32 %input {disp32 = 0}
  %u8_i64 = movzx.load.u8.gpr64 %input {disp32 = 1}
  %s8_i32 = movsx.load.i8.gpr32 %input {disp32 = 2}
  %s8_i64 = movsx.load.i8.gpr64 %input {disp32 = 3}
  %u16_i32 = movzx.load.u16.gpr32 %input {disp32 = 4}
  %u16_i64 = movzx.load.u16.gpr64 %input {disp32 = 6}
  %s16_i32 = movsx.load.i16.gpr32 %input {disp32 = 8}
  %s16_i64 = movsx.load.i16.gpr64 %input {disp32 = 10}
  %u32_i64 = mov.load.u32.gpr64 %input {disp32 = 12}
  %s32_i64 = movsxd.load.i32.gpr64 %input {disp32 = 16}
  return %u8_i32, %u8_i64, %s8_i32, %s8_i64, %u16_i32, %u16_i64, %s16_i32, %s16_i64, %u32_i64, %s32_i64
}

// ====

func.def @extend_byte_loads_to_words(%input: buffer) -> (i16, i16) {
  %base = index.constant 0 : offset
  %bytes = buffer.view %input[%base] : buffer -> view<2xi8>
  %unsigned_byte = view.load %bytes[0] : view<2xi8> -> i8
  %signed_byte = view.load %bytes[1] : view<2xi8> -> i8
  %unsigned_word = scalar.extui %unsigned_byte : i8 to i16
  %signed_word = scalar.extsi %signed_byte : i8 to i16
  func.return %unsigned_word, %signed_word : i16, i16
}

// ----
low.func.def target<x86.scalar.core> abi(object_function) abi_layout({signature = (buffer) -> (i16, i16)}) @extend_byte_loads_to_words(%input: reg<x86.gpr64>) -> (reg<x86.gpr32>, reg<x86.gpr32>) asm {
  %unsigned_word = movzx.load.u8.gpr32 %input {disp32 = 0}
  %signed_word = movsx.load.i8.gpr32 %input {disp32 = 1}
  return %unsigned_word, %signed_word
}
