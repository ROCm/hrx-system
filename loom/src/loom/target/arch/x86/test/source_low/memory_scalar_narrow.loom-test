// TEMPLATE: loom/src/loom/test/corpus/source_low/memory_scalar_narrow.loom
// RUN: emit source-low target=x86:scalar output=low

func.def @copy_narrow_static(%input: buffer, %output: buffer) {
  %byte_base = index.constant 0 : offset
  %word_base = index.constant 1 : offset
  %source_bytes = buffer.view %input[%byte_base] : buffer -> view<8xi8>
  %source_words = buffer.view %input[%word_base] : buffer -> view<4xi16>
  %destination_bytes = buffer.view %output[%byte_base] : buffer -> view<8xi8>
  %destination_words = buffer.view %output[%word_base] : buffer -> view<4xi16>
  %byte = view.load %source_bytes[3] : view<8xi8> -> i8
  %word = view.load %source_words[2] : view<4xi16> -> i16
  view.store %byte, %destination_bytes[3] : i8, view<8xi8>
  view.store %word, %destination_words[2] : i16, view<4xi16>
  func.return
}

// ----
low.func.def target<x86.scalar.core> abi(object_function) @copy_narrow_static(%source_words: reg<x86.gpr64>, %destination_words: reg<x86.gpr64>) asm {
  %byte = movzx.load.u8.gpr32 %source_words {disp32 = 3}
  %word = movzx.load.u16.gpr32 %source_words {disp32 = 5}
  mov.store.u8.gpr32 %byte, %destination_words {disp32 = 3}
  mov.store.u16.gpr32 %word, %destination_words {disp32 = 5}
  return
}

// ====

func.def @copy_narrow_index(%input: buffer, %output: buffer, %element: index) {
  %position = index.assume %element [range(%element, 0, 15)] : index
  %byte_base = index.constant 1 : offset
  %word_base = index.constant 33 : offset
  %source_bytes = buffer.view %input[%byte_base] : buffer -> view<16xi8>
  %source_words = buffer.view %input[%word_base] : buffer -> view<16xi16>
  %destination_bytes = buffer.view %output[%byte_base] : buffer -> view<16xi8>
  %destination_words = buffer.view %output[%word_base] : buffer -> view<16xi16>
  %byte = view.load %source_bytes[%position] : view<16xi8> -> i8
  %word = view.load %source_words[%position] : view<16xi16> -> i16
  view.store %byte, %destination_bytes[%position] : i8, view<16xi8>
  view.store %word, %destination_words[%position] : i16, view<16xi16>
  func.return
}

// ----
low.func.def target<x86.scalar.core> abi(object_function) @copy_narrow_index(%source_words: reg<x86.gpr64>, %destination_words: reg<x86.gpr64>, %position: reg<x86.gpr64>) asm {
  %byte = movzx.load.indexed.u8.gpr32 %source_words, %position {disp32 = 1, scale = 1}
  %word = movzx.load.indexed.u16.gpr32 %source_words, %position {disp32 = 33, scale = 2}
  mov.store.indexed.u8.gpr32 %byte, %destination_words, %position {disp32 = 1, scale = 1}
  mov.store.indexed.u16.gpr32 %word, %destination_words, %position {disp32 = 33, scale = 2}
  return
}

// ====

func.def @copy_narrow_origin(%input: buffer, %output: buffer, %byte_offset: offset, %element: index) {
  %base = index.assume %byte_offset [range(%byte_offset, 0, 128)] : offset
  %position = index.assume %element [range(%element, 0, 15)] : index
  %prefix = index.constant 33 : offset
  %word_base = index.add %base, %prefix : offset
  %source_bytes = buffer.view %input[%base] : buffer -> view<16xi8>
  %source_words = buffer.view %input[%word_base] : buffer -> view<16xi16>
  %destination_bytes = buffer.view %output[%base] : buffer -> view<16xi8>
  %destination_words = buffer.view %output[%word_base] : buffer -> view<16xi16>
  %byte = view.load<volatile> %source_bytes[%position] : view<16xi8> -> i8
  %word = view.load<volatile> %source_words[%position] : view<16xi16> -> i16
  view.store<volatile> %byte, %destination_bytes[%position] : i8, view<16xi8>
  view.store<volatile> %word, %destination_words[%position] : i16, view<16xi16>
  func.return
}

// ----
low.func.def target<x86.scalar.core> abi(object_function) @copy_narrow_origin(%source_words: reg<x86.gpr64>, %destination_words: reg<x86.gpr64>, %base: reg<x86.gpr64>, %position: reg<x86.gpr64>) asm {
  %18 = copy %base : reg<x86.gpr64> -> reg<x86.gpr64>
  %19 = add.gpr64 %18, %position
  %byte = movzx.load.indexed.u8.gpr32<volatile> %source_words, %19 {disp32 = 0, scale = 1}
  %21 = mov.imm64 2
  %22 = copy %position : reg<x86.gpr64> -> reg<x86.gpr64>
  %23 = imul.gpr64 %22, %21
  %24 = copy %base : reg<x86.gpr64> -> reg<x86.gpr64>
  %25 = add.gpr64 %24, %23
  %word = movzx.load.indexed.u16.gpr32<volatile> %source_words, %25 {disp32 = 33, scale = 1}
  %27 = copy %base : reg<x86.gpr64> -> reg<x86.gpr64>
  %28 = add.gpr64 %27, %position
  mov.store.indexed.u8.gpr32<volatile> %byte, %destination_words, %28 {disp32 = 0, scale = 1}
  %30 = copy %position : reg<x86.gpr64> -> reg<x86.gpr64>
  %31 = imul.gpr64 %30, %21
  %32 = copy %base : reg<x86.gpr64> -> reg<x86.gpr64>
  %33 = add.gpr64 %32, %31
  mov.store.indexed.u16.gpr32<volatile> %word, %destination_words, %33 {disp32 = 33, scale = 1}
  return
}

// ====

func.def @copy_narrow_stride(%input: buffer, %output: buffer, %column_count: index, %row_index: index, %column_index: index) {
  %columns = index.assume %column_count [range(%column_count, 1, 16)] : index
  %row = index.assume %row_index [range(%row_index, 0, 3)] : index
  %column = index.assume %column_index [range(%column_index, 0, 15), lt(%column_index, %columns)] : index
  %byte_base = index.constant 1 : offset
  %word_base = index.constant 65 : offset
  %source_bytes = buffer.view %input[%byte_base] : buffer -> view<4x[%columns]xi8>
  %source_words = buffer.view %input[%word_base] : buffer -> view<4x[%columns]xi16>
  %destination_bytes = buffer.view %output[%byte_base] : buffer -> view<4x[%columns]xi8>
  %destination_words = buffer.view %output[%word_base] : buffer -> view<4x[%columns]xi16>
  %byte = view.load %source_bytes[%row, %column] : view<4x[%columns]xi8> -> i8
  %word = view.load %source_words[%row, %column] : view<4x[%columns]xi16> -> i16
  view.store %byte, %destination_bytes[%row, %column] : i8, view<4x[%columns]xi8>
  view.store %word, %destination_words[%row, %column] : i16, view<4x[%columns]xi16>
  func.return
}

// ----
low.func.def target<x86.scalar.core> abi(object_function) @copy_narrow_stride(%source_words: reg<x86.gpr64>, %destination_words: reg<x86.gpr64>, %columns: reg<x86.gpr64>, %row: reg<x86.gpr64>, %column: reg<x86.gpr64>) asm {
  %21 = copy %row : reg<x86.gpr64> -> reg<x86.gpr64>
  %22 = imul.gpr64 %21, %columns
  %23 = copy %22 : reg<x86.gpr64> -> reg<x86.gpr64>
  %24 = add.gpr64 %23, %column
  %byte = movzx.load.indexed.u8.gpr32 %source_words, %24 {disp32 = 1, scale = 1}
  %26 = copy %row : reg<x86.gpr64> -> reg<x86.gpr64>
  %27 = imul.gpr64 %26, %columns
  %28 = mov.imm64 2
  %29 = copy %27 : reg<x86.gpr64> -> reg<x86.gpr64>
  %30 = imul.gpr64 %29, %28
  %32 = copy %column : reg<x86.gpr64> -> reg<x86.gpr64>
  %33 = imul.gpr64 %32, %28
  %34 = copy %30 : reg<x86.gpr64> -> reg<x86.gpr64>
  %35 = add.gpr64 %34, %33
  %word = movzx.load.indexed.u16.gpr32 %source_words, %35 {disp32 = 65, scale = 1}
  %37 = copy %row : reg<x86.gpr64> -> reg<x86.gpr64>
  %38 = imul.gpr64 %37, %columns
  %39 = copy %38 : reg<x86.gpr64> -> reg<x86.gpr64>
  %40 = add.gpr64 %39, %column
  mov.store.indexed.u8.gpr32 %byte, %destination_words, %40 {disp32 = 1, scale = 1}
  %41 = copy %row : reg<x86.gpr64> -> reg<x86.gpr64>
  %42 = imul.gpr64 %41, %columns
  %44 = copy %42 : reg<x86.gpr64> -> reg<x86.gpr64>
  %45 = imul.gpr64 %44, %28
  %47 = copy %column : reg<x86.gpr64> -> reg<x86.gpr64>
  %48 = imul.gpr64 %47, %28
  %49 = copy %45 : reg<x86.gpr64> -> reg<x86.gpr64>
  %50 = add.gpr64 %49, %48
  mov.store.indexed.u16.gpr32 %word, %destination_words, %50 {disp32 = 65, scale = 1}
  return
}

// ====

func.def @exchange_narrow(%buffer: buffer, %byte_value: i8, %word_value: i16) -> (i32, i32) {
  %byte_base = index.constant 0 : offset
  %word_base = index.constant 1 : offset
  %bytes = buffer.view %buffer[%byte_base] : buffer -> view<1xi8>
  %words = buffer.view %buffer[%word_base] : buffer -> view<1xi16>
  %previous_byte = view.load %bytes[0] : view<1xi8> -> i8
  %previous_word = view.load %words[0] : view<1xi16> -> i16
  view.store %byte_value, %bytes[0] : i8, view<1xi8>
  view.store %word_value, %words[0] : i16, view<1xi16>
  %byte_bits = scalar.extui %previous_byte : i8 to i32
  %word_bits = scalar.extui %previous_word : i16 to i32
  func.return %byte_bits, %word_bits : i32, i32
}

// ----
low.func.def target<x86.scalar.core> abi(object_function) @exchange_narrow(%words: reg<x86.gpr64>, %byte_value: reg<x86.gpr32>, %word_value: reg<x86.gpr32>) -> (reg<x86.gpr32>, reg<x86.gpr32>) asm {
  %previous_byte = movzx.load.u8.gpr32 %words {disp32 = 0}
  %previous_word = movzx.load.u16.gpr32 %words {disp32 = 1}
  mov.store.u8.gpr32 %byte_value, %words {disp32 = 0}
  mov.store.u16.gpr32 %word_value, %words {disp32 = 1}
  %20 = copy %previous_byte : reg<x86.gpr32> -> reg<x86.gpr32>
  %byte_bits = and.imm.gpr32 %20 {imm32 = 255}
  %22 = copy %previous_word : reg<x86.gpr32> -> reg<x86.gpr32>
  %word_bits = and.imm.gpr32 %22 {imm32 = 65535}
  return %byte_bits, %word_bits
}
