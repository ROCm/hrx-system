// RUN: emit source-low output=low

x86.target<scalar> @target

func.def target(@target) @scalar_i1_constant(%value: i1) -> (i1) {
  %true = scalar.constant 1 : i1
  %result = scalar.xori %value, %true : i1
  func.return %result : i1
}

// ----
low.func.def target<x86.scalar.core>(@target) abi(object_function) @scalar_i1_constant(%value: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  %6 = copy %value : reg<x86.gpr32> -> reg<x86.gpr32>
  %result = xor.imm.gpr32 %6 {imm32 = 1}
  return %result
}

// ====

x86.target<scalar> @target

func.def target(@target) @scalar_i1_bitwise_control(%lhs: i1, %rhs: i1, %true_value: i32, %false_value: i32) -> (i32) {
  %both = scalar.andi %lhs, %rhs : i1
  %either = scalar.ori %lhs, %rhs : i1
  %condition = scalar.xori %either, %both : i1
  cfg.cond_br %condition, ^then, ^else
^then:
  func.return %true_value : i32
^else:
  func.return %false_value : i32
}

// ----
low.func.def target<x86.scalar.core>(@target) abi(object_function) @scalar_i1_bitwise_control(%lhs: reg<x86.gpr32>, %rhs: reg<x86.gpr32>, %true_value: reg<x86.gpr32>, %false_value: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  %13 = copy %lhs : reg<x86.gpr32> -> reg<x86.gpr32>
  %both = and.gpr32 %13, %rhs
  %15 = copy %lhs : reg<x86.gpr32> -> reg<x86.gpr32>
  %either = or.gpr32 %15, %rhs
  %17 = copy %either : reg<x86.gpr32> -> reg<x86.gpr32>
  %condition = xor.gpr32 %17, %both
  low.cond_br %condition, ^then, ^else : reg<x86.gpr32>
^then:
  return %true_value
^else:
  return %false_value
}

// ====

x86.target<scalar> @target

func.def target(@target) @scalar_i32_select(%condition: i1, %true_value: i32, %false_value: i32) -> (i32) {
  %result = scf.select %condition, %true_value, %false_value : i32
  func.return %result : i32
}

// ----
low.func.def target<x86.scalar.core>(@target) abi(object_function) @scalar_i32_select(%condition: reg<x86.gpr32>, %true_value: reg<x86.gpr32>, %false_value: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  %9 = copy %false_value : reg<x86.gpr32> -> reg<x86.gpr32>
  %result = select.gpr32 %condition, %true_value, %9
  return %result
}

// ====

x86.target<scalar> @target

func.def target(@target) @index_comparisons(%lhs: index, %rhs: index) -> (i1, i1, i1, i1, i1, i1, i1, i1, i1, i1) {
  %eq = index.cmp eq, %lhs, %rhs : index
  %ne = index.cmp ne, %lhs, %rhs : index
  %slt = index.cmp slt, %lhs, %rhs : index
  %sle = index.cmp sle, %lhs, %rhs : index
  %sgt = index.cmp sgt, %lhs, %rhs : index
  %sge = index.cmp sge, %lhs, %rhs : index
  %ult = index.cmp ult, %lhs, %rhs : index
  %ule = index.cmp ule, %lhs, %rhs : index
  %ugt = index.cmp ugt, %lhs, %rhs : index
  %uge = index.cmp uge, %lhs, %rhs : index
  func.return %eq, %ne, %slt, %sle, %sgt, %sge, %ult, %ule, %ugt, %uge : i1, i1, i1, i1, i1, i1, i1, i1, i1, i1
}

// ----
low.func.def target<x86.scalar.core>(@target) abi(object_function) @index_comparisons(%lhs: reg<x86.gpr64>, %rhs: reg<x86.gpr64>) -> (reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr32>) asm {
  %eq = cmp.eq.gpr64 %lhs, %rhs
  %ne = cmp.ne.gpr64 %lhs, %rhs
  %slt = cmp.slt.gpr64 %lhs, %rhs
  %sle = cmp.sle.gpr64 %lhs, %rhs
  %sgt = cmp.sgt.gpr64 %lhs, %rhs
  %sge = cmp.sge.gpr64 %lhs, %rhs
  %ult = cmp.ult.gpr64 %lhs, %rhs
  %ule = cmp.ule.gpr64 %lhs, %rhs
  %ugt = cmp.ugt.gpr64 %lhs, %rhs
  %uge = cmp.uge.gpr64 %lhs, %rhs
  return %eq, %ne, %slt, %sle, %sgt, %sge, %ult, %ule, %ugt, %uge
}

// ====

x86.target<scalar> @target

func.def target(@target) @offset_comparisons(%lhs: offset, %rhs: offset) -> (i1, i1, i1, i1, i1, i1, i1, i1, i1, i1) {
  %eq = index.cmp eq, %lhs, %rhs : offset
  %ne = index.cmp ne, %lhs, %rhs : offset
  %slt = index.cmp slt, %lhs, %rhs : offset
  %sle = index.cmp sle, %lhs, %rhs : offset
  %sgt = index.cmp sgt, %lhs, %rhs : offset
  %sge = index.cmp sge, %lhs, %rhs : offset
  %ult = index.cmp ult, %lhs, %rhs : offset
  %ule = index.cmp ule, %lhs, %rhs : offset
  %ugt = index.cmp ugt, %lhs, %rhs : offset
  %uge = index.cmp uge, %lhs, %rhs : offset
  func.return %eq, %ne, %slt, %sle, %sgt, %sge, %ult, %ule, %ugt, %uge : i1, i1, i1, i1, i1, i1, i1, i1, i1, i1
}

// ----
low.func.def target<x86.scalar.core>(@target) abi(object_function) @offset_comparisons(%lhs: reg<x86.gpr64>, %rhs: reg<x86.gpr64>) -> (reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr32>) asm {
  %eq = cmp.eq.gpr64 %lhs, %rhs
  %ne = cmp.ne.gpr64 %lhs, %rhs
  %slt = cmp.slt.gpr64 %lhs, %rhs
  %sle = cmp.sle.gpr64 %lhs, %rhs
  %sgt = cmp.sgt.gpr64 %lhs, %rhs
  %sge = cmp.sge.gpr64 %lhs, %rhs
  %ult = cmp.ult.gpr64 %lhs, %rhs
  %ule = cmp.ule.gpr64 %lhs, %rhs
  %ugt = cmp.ugt.gpr64 %lhs, %rhs
  %uge = cmp.uge.gpr64 %lhs, %rhs
  return %eq, %ne, %slt, %sle, %sgt, %sge, %ult, %ule, %ugt, %uge
}
