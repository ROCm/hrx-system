func.def @convert_halfword(%input: i16) -> (f32, f64, f32, f64) {
  %signed32 = scalar.sitofp %input : i16 to f32
  %signed64 = scalar.sitofp %input : i16 to f64
  %unsigned32 = scalar.uitofp %input : i16 to f32
  %unsigned64 = scalar.uitofp %input : i16 to f64
  func.return %signed32, %signed64, %unsigned32, %unsigned64 : f32, f64, f32, f64
}

// ----
low.func.def target<x86.avx512.core> abi(object_function) abi_layout({signature = (i16) -> (f32, f64, f32, f64)}) @convert_halfword(%input: reg<x86.gpr32>) -> (reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>) asm {
  %14 = movsx.i16.gpr32 %input
  %15 = vxorps.zero.xmm
  %signed32 = vcvtsi2ss.xmm.gpr32 %15, %14
  %signed64 = vcvtsi2sd.xmm.gpr32 %15, %14
  %20 = movzx.u16.gpr32 %input
  %unsigned32 = vcvtsi2ss.xmm.gpr32 %15, %20
  %unsigned64 = vcvtsi2sd.xmm.gpr32 %15, %20
  return %signed32, %signed64, %unsigned32, %unsigned64
}

// ====

func.def @convert_word(%input: i32) -> (f32, f64, f32, f64) {
  %signed32 = scalar.sitofp %input : i32 to f32
  %signed64 = scalar.sitofp %input : i32 to f64
  %unsigned32 = scalar.uitofp %input : i32 to f32
  %unsigned64 = scalar.uitofp %input : i32 to f64
  func.return %signed32, %signed64, %unsigned32, %unsigned64 : f32, f64, f32, f64
}

// ----
low.func.def target<x86.avx512.core> abi(object_function) abi_layout({signature = (i32) -> (f32, f64, f32, f64)}) @convert_word(%input: reg<x86.gpr32>) -> (reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>) asm {
  %14 = vxorps.zero.xmm
  %signed32 = vcvtsi2ss.xmm.gpr32 %14, %input
  %signed64 = vcvtsi2sd.xmm.gpr32 %14, %input
  %unsigned32 = vcvtusi2ss.xmm.gpr32 %14, %input
  %unsigned64 = vcvtusi2sd.xmm.gpr32 %14, %input
  return %signed32, %signed64, %unsigned32, %unsigned64
}

