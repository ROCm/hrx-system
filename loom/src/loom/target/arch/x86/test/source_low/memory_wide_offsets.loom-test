x86.target<avx2> @target

func.def target(@target) @scalar_wide_byte_offset(%input_storage: buffer, %output_storage: buffer, %byte_offset_input: offset) -> (i32) {
  %input = buffer.assume.alignment %input_storage {minimum_alignment = 4} : buffer
  %output = buffer.assume.alignment %output_storage {minimum_alignment = 4} : buffer
  %byte_offset = index.assume %byte_offset_input [mul(%byte_offset_input, 4)] : offset
  %input_view = buffer.view %input[%byte_offset] : buffer -> view<1xi32>
  %output_view = buffer.view %output[%byte_offset] : buffer -> view<1xi32>
  %loaded = view.load %input_view[0] : view<1xi32> -> i32
  view.store %loaded, %output_view[0] : i32, view<1xi32>
  func.return %loaded : i32
}

// ----
low.func.def target<x86.avx2.core>(@target) abi(object_function) abi_layout({argument_locations = [7, 6, 2], calling_convention = "sysv_x86_64", result_locations = [0], stack_argument_bytes = 0}) @scalar_wide_byte_offset(%input_view: reg<x86.gpr64>, %output_view: reg<x86.gpr64>, %byte_offset: reg<x86.gpr64>) -> (reg<x86.gpr32>) asm {
  %loaded = mov.load.indexed.gpr32 %input_view, %byte_offset {disp32 = 0, scale = 1}
  mov.store.indexed.gpr32 %loaded, %output_view, %byte_offset {disp32 = 0, scale = 1}
  return %loaded
}

