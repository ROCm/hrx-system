// RUN: emit source-low target=x86:avx512 output=low

func.def @scalar_f32_arith(%lhs: f32, %rhs: f32, %bias: f32) -> (f32) {
  %sum = scalar.addf %lhs, %rhs : f32
  %difference = scalar.subf %sum, %bias : f32
  %product = scalar.mulf %difference, %rhs : f32
  %result = scalar.fmaf %product, %rhs, %bias : f32
  func.return %result : f32
}

// ----
low.func.def target<x86.avx512.core> abi(object_function) abi_layout({signature = (f32, f32, f32) -> (f32)}) @scalar_f32_arith(%lhs: reg<x86.xmm>, %rhs: reg<x86.xmm>, %bias: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %sum = vaddss.xmm %lhs, %rhs
  %difference = vsubss.xmm %sum, %bias
  %product = vmulss.xmm %difference, %rhs
  %15 = copy %bias : reg<x86.xmm> -> reg<x86.xmm>
  %result = vfmadd231ss.xmm %15, %product, %rhs
  return %result
}

// ====

func.def @scalar_f32_sign_bits(%input: f32) -> (f32, f32) {
  %negated = scalar.negf %input : f32
  %absolute = scalar.absf %input : f32
  func.return %negated, %absolute : f32, f32
}

// ----
low.func.def target<x86.avx512.core> abi(object_function) abi_layout({signature = (f32) -> (f32, f32)}) @scalar_f32_sign_bits(%input: reg<x86.xmm>) -> (reg<x86.xmm>, reg<x86.xmm>) asm {
  %16 = vmovd.gpr32.xmm %input
  %17 = copy %16 : reg<x86.gpr32> -> reg<x86.gpr32>
  %18 = xor.imm.gpr32 %17 {imm32 = -2147483648}
  %negated = vmovd.xmm.gpr32 %18
  %20 = copy %16 : reg<x86.gpr32> -> reg<x86.gpr32>
  %21 = and.imm.gpr32 %20 {imm32 = 2147483647}
  %absolute = vmovd.xmm.gpr32 %21
  return %negated, %absolute
}

// ====

func.def @vector_f32_sign_bits(%input: vector<4xf32>) -> (vector<4xf32>, vector<4xf32>) {
  %negated = vector.negf %input : vector<4xf32>
  %absolute = vector.absf %input : vector<4xf32>
  func.return %negated, %absolute : vector<4xf32>, vector<4xf32>
}

// ----
low.func.def target<x86.avx512.core> abi(object_function) abi_layout({signature = (vector<4xf32>) -> (vector<4xf32>, vector<4xf32>)}) @vector_f32_sign_bits(%input: reg<x86.xmm>) -> (reg<x86.xmm>, reg<x86.xmm>) asm {
  %18 = mov.imm32 -2147483648
  %19 = vpbroadcastd.xmm %18
  %negated = vpxor.xmm %input, %19
  %21 = mov.imm32 2147483647
  %22 = vpbroadcastd.xmm %21
  %absolute = vpand.xmm %input, %22
  return %negated, %absolute
}
