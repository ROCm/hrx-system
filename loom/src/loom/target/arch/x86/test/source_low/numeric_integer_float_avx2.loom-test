// ----
low.func.def target<x86.avx2.core> abi(object_function) abi_layout({signature = (i8) -> (f32, f64, f32, f64)}) @convert_byte(%input: reg<x86.gpr32>) -> (reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>) asm {
  %14 = movsx.i8.gpr32 %input
  %15 = vxorps.zero.xmm
  %signed32 = vcvtsi2ss.xmm.gpr32 %15, %14
  %signed64 = vcvtsi2sd.xmm.gpr32 %15, %14
  %20 = movzx.u8.gpr32 %input
  %unsigned32 = vcvtsi2ss.xmm.gpr32 %15, %20
  %unsigned64 = vcvtsi2sd.xmm.gpr32 %15, %20
  return %signed32, %signed64, %unsigned32, %unsigned64
}

