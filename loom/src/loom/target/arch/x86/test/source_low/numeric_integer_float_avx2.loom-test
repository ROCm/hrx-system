func.def @narrow_exact_byte_to_bfloat(%input: i8) -> (bf16) {
  %wide = scalar.sitofp %input : i8 to f32
  %result = scalar.fptrunc %wide : f32 to bf16
  func.return %result : bf16
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) abi_layout({signature = (i8) -> (bf16)}) @narrow_exact_byte_to_bfloat(%input: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  %6 = movsx.i8.gpr32 %input
  %7 = vxorps.zero.xmm
  %wide = vcvtsi2ss.xmm.gpr32 %7, %6
  %9 = vmovd.gpr32.xmm %wide
  %result = shr.imm.gpr32 %9 {shift = 16}
  return %result
}

