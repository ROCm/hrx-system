low.func.def target<x86.avx2.core> abi(object_function) abi_layout({signature = (i1) -> (f32, f64, f32, f64)}) @convert_boolean(%input: reg<x86.gpr32>) -> (reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>) asm {
  %14 = copy %input : reg<x86.gpr32> -> reg<x86.gpr32>
  %15 = shl.imm.gpr32 %14 {shift = 31}
  %16 = sar.imm.gpr32 %15 {shift = 31}
  %17 = vxorps.zero.xmm
  %signed32 = vcvtsi2ss.xmm.gpr32 %17, %16
  %19 = copy %input : reg<x86.gpr32> -> reg<x86.gpr32>
  %20 = shl.imm.gpr32 %19 {shift = 31}
  %21 = sar.imm.gpr32 %20 {shift = 31}
  %signed64 = vcvtsi2sd.xmm.gpr32 %17, %21
  %24 = copy %input : reg<x86.gpr32> -> reg<x86.gpr32>
  %25 = and.imm.gpr32 %24 {imm32 = 1}
  %unsigned32 = vcvtsi2ss.xmm.gpr32 %17, %25
  %28 = copy %input : reg<x86.gpr32> -> reg<x86.gpr32>
  %29 = and.imm.gpr32 %28 {imm32 = 1}
  %unsigned64 = vcvtsi2sd.xmm.gpr32 %17, %29
  return %signed32, %signed64, %unsigned32, %unsigned64
}

