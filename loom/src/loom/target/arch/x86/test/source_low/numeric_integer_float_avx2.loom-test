func.def @convert_word_packets(%single_words: vector<8xi32>, %double_words: vector<4xi32>) -> (vector<8xf32>, vector<8xf32>, vector<4xf64>, vector<4xf64>) {
  %signed_single = vector.sitofp %single_words : vector<8xi32> to vector<8xf32>
  %unsigned_single = vector.uitofp %single_words : vector<8xi32> to vector<8xf32>
  %signed_double = vector.sitofp %double_words : vector<4xi32> to vector<4xf64>
  %unsigned_double = vector.uitofp %double_words : vector<4xi32> to vector<4xf64>
  func.return %signed_single, %unsigned_single, %signed_double, %unsigned_double : vector<8xf32>, vector<8xf32>, vector<4xf64>, vector<4xf64>
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) abi_layout({signature = (vector<8xi32>, vector<4xi32>) -> (vector<8xf32>, vector<8xf32>, vector<4xf64>, vector<4xf64>)}) @convert_word_packets(%single_words: reg<x86.ymm>, %double_words: reg<x86.xmm>) -> (reg<x86.ymm>, reg<x86.ymm>, reg<x86.ymm>, reg<x86.ymm>) asm {
  %signed_single = vcvtdq2ps.ymm.ymm %single_words
  %17 = vpsrld.ymm %single_words, 1
  %18 = vpslld.ymm %single_words, 31
  %19 = vpsrld.ymm %18, 31
  %20 = vpor.ymm %17, %19
  %22 = vcvtdq2ps.ymm.ymm %20
  %23 = vaddps.ymm %22, %22
  %unsigned_single = vblendvps.ymm %signed_single, %23, %single_words
  %signed_double = vcvtdq2pd.ymm.xmm %double_words
  %26 = vpmovzxdq.ymm %double_words
  %27 = avx2.vmovdqu.rodata.ymm @__low_rodata_a3e49c3f
  %28 = vpor.ymm %26, %27
  %unsigned_double = vsubpd.ymm %28, %27
  return %signed_single, %unsigned_single, %signed_double, %unsigned_double
}

