func.def @convert_wide(%input: i64) -> (f32, f64, f32, f64) {
  %signed32 = scalar.sitofp %input : i64 to f32
  %signed64 = scalar.sitofp %input : i64 to f64
  %unsigned32 = scalar.uitofp %input : i64 to f32
  %unsigned64 = scalar.uitofp %input : i64 to f64
  func.return %signed32, %signed64, %unsigned32, %unsigned64 : f32, f64, f32, f64
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) abi_layout({signature = (i64) -> (f32, f64, f32, f64)}) @convert_wide(%input: reg<x86.gpr64>) -> (reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>) asm {
  %14 = vxorps.zero.xmm
  %signed32 = vcvtsi2ss.xmm.gpr64 %14, %input
  %signed64 = vcvtsi2sd.xmm.gpr64 %14, %input
  %20 = copy %input : reg<x86.gpr64> -> reg<x86.gpr64>
  %21 = shr.imm.gpr64 %20 {shift = 1}
  %22 = copy %input : reg<x86.gpr64> -> reg<x86.gpr64>
  %23 = and.imm.gpr64 %22 {imm32 = 1}
  %24 = or.gpr64 %21, %23
  %25 = vcvtsi2ss.xmm.gpr64 %14, %24
  %26 = vaddss.xmm %25, %25
  %27 = vmovq.xmm.gpr64 %input
  %unsigned32 = vblendvpd.xmm %signed32, %26, %27
  %31 = copy %input : reg<x86.gpr64> -> reg<x86.gpr64>
  %32 = shr.imm.gpr64 %31 {shift = 1}
  %33 = copy %input : reg<x86.gpr64> -> reg<x86.gpr64>
  %34 = and.imm.gpr64 %33 {imm32 = 1}
  %35 = or.gpr64 %32, %34
  %36 = vcvtsi2sd.xmm.gpr64 %14, %35
  %37 = vaddsd.xmm %36, %36
  %unsigned64 = vblendvpd.xmm %signed64, %37, %27
  return %signed32, %signed64, %unsigned32, %unsigned64
}
