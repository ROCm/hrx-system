// ----
low.func.def target<x86.avx2.core> abi(object_function) abi_layout({signature = (i32) -> (f32, f64, f32, f64)}) @convert_word(%input: reg<x86.gpr32>) -> (reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>) asm {
  %14 = vxorps.zero.xmm
  %signed32 = vcvtsi2ss.xmm.gpr32 %14, %input
  %signed64 = vcvtsi2sd.xmm.gpr32 %14, %input
  %18 = movzx.gpr64.gpr32 %input
  %unsigned32 = vcvtsi2ss.xmm.gpr64 %14, %18
  %unsigned64 = vcvtsi2sd.xmm.gpr64 %14, %18
  return %signed32, %signed64, %unsigned32, %unsigned64
