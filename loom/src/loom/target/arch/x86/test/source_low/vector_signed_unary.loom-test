// Native absolute value uses the logical lane type even in partial carriers.
// RUN: emit source-low target=x86:avx2 output=low
func.def @absolute_lanes(%bytes: vector<4xi8>, %words: vector<8xi16>, %dwords: vector<8xi32>) -> (vector<4xi8>, vector<8xi16>, vector<8xi32>) {
  %abs_bytes = vector.absi %bytes : vector<4xi8>
  %abs_words = vector.absi %words : vector<8xi16>
  %abs_dwords = vector.absi %dwords : vector<8xi32>
  func.return %abs_bytes, %abs_words, %abs_dwords : vector<4xi8>, vector<8xi16>, vector<8xi32>
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) abi_layout({signature = (vector<4xi8>, vector<8xi16>, vector<8xi32>) -> (vector<4xi8>, vector<8xi16>, vector<8xi32>)}) @absolute_lanes(%bytes: reg<x86.xmm>, %words: reg<x86.xmm>, %dwords: reg<x86.ymm>) -> (reg<x86.xmm>, reg<x86.xmm>, reg<x86.ymm>) asm {
  %abs_bytes = vpabsb.xmm %bytes
  %abs_words = vpabsw.xmm %words
  %abs_dwords = vpabsd.ymm %dwords
  return %abs_bytes, %abs_words, %abs_dwords
}

// ====

// AVX2 qwords compose every unary operation without scalar lane extraction.
// RUN: emit source-low target=x86:avx2 output=low
func.def @composed_qwords(%input: vector<4xi64>) -> (vector<4xi64>, vector<4xi64>, vector<4xi64>) {
  %negative = vector.negi %input : vector<4xi64>
  %absolute = vector.absi %input : vector<4xi64>
  %sign = vector.signi %input : vector<4xi64>
  func.return %negative, %absolute, %sign : vector<4xi64>, vector<4xi64>, vector<4xi64>
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) abi_layout({signature = (vector<4xi64>) -> (vector<4xi64>, vector<4xi64>, vector<4xi64>)}) @composed_qwords(%input: reg<x86.ymm>) -> (reg<x86.ymm>, reg<x86.ymm>, reg<x86.ymm>) asm {
  %29 = vxorps.zero.ymm
  %negative = vpsubq.ymm %29, %input
  %31 = vpcmpgtq.ymm %29, %input
  %absolute = vpblendvb.ymm %input, %negative, %31
  %33 = mov.imm64 1
  %34 = vmovq.xmm.gpr64 %33
  %35 = vpbroadcastq.ymm %34
  %36 = mov.imm64 -1
  %37 = vmovq.xmm.gpr64 %36
  %38 = vpbroadcastq.ymm %37
  %39 = vpcmpeqq.ymm %input, %29
  %40 = vpcmpeqq.ymm %input, %input
  %41 = vpxor.ymm %39, %40
  %42 = vpblendvb.ymm %29, %35, %41
  %sign = vpblendvb.ymm %42, %38, %31
  return %negative, %absolute, %sign
}

// ====

// AVX-512 adds native qword absolute value, including one-lane XMM carriers.
// RUN: emit source-low target=x86:avx512 output=low
func.def @absolute_qwords(%single: vector<1xi64>, %pair: vector<2xi64>, %quad: vector<4xi64>, %octet: vector<8xi64>) -> (vector<1xi64>, vector<2xi64>, vector<4xi64>, vector<8xi64>) {
  %a = vector.absi %single : vector<1xi64>
  %b = vector.absi %pair : vector<2xi64>
  %c = vector.absi %quad : vector<4xi64>
  %d = vector.absi %octet : vector<8xi64>
  func.return %a, %b, %c, %d : vector<1xi64>, vector<2xi64>, vector<4xi64>, vector<8xi64>
}

// ----
low.func.def target<x86.avx512.core> abi(object_function) abi_layout({signature = (vector<1xi64>, vector<2xi64>, vector<4xi64>, vector<8xi64>) -> (vector<1xi64>, vector<2xi64>, vector<4xi64>, vector<8xi64>)}) @absolute_qwords(%single: reg<x86.xmm>, %pair: reg<x86.xmm>, %quad: reg<x86.ymm>, %octet: reg<x86.zmm>) -> (reg<x86.xmm>, reg<x86.xmm>, reg<x86.ymm>, reg<x86.zmm>) asm {
  %a = avx512.vpabsq.xmm %single
  %b = avx512.vpabsq.xmm %pair
  %c = avx512.vpabsq.ymm %quad
  %d = avx512.vpabsq.zmm %octet
  return %a, %b, %c, %d
}

// ====

// Without VL, partial packets use AVX2 while full-width absolute value stays
// native. Qwords retain the shared comparison/selection recipe.
// RUN: emit source-low output=low
x86.target<avx512> @target {features = [-avx512vl]}

func.def target(@target) @without_vl(%bytes: vector<4xi8>, %qwords: vector<2xi64>, %wide: vector<8xi64>) -> (vector<4xi8>, vector<2xi64>, vector<8xi64>) {
  %a = vector.absi %bytes : vector<4xi8>
  %b = vector.absi %qwords : vector<2xi64>
  %c = vector.absi %wide : vector<8xi64>
  func.return %a, %b, %c : vector<4xi8>, vector<2xi64>, vector<8xi64>
}

// ----
low.func.def target<x86.avx512_features.core>(@target) abi(object_function) abi_layout({signature = (vector<4xi8>, vector<2xi64>, vector<8xi64>) -> (vector<4xi8>, vector<2xi64>, vector<8xi64>)}) @without_vl(%bytes: reg<x86.xmm>, %qwords: reg<x86.xmm>, %wide: reg<x86.zmm>) -> (reg<x86.xmm>, reg<x86.xmm>, reg<x86.zmm>) asm {
  %a = vpabsb.xmm %bytes
  %21 = vxorps.zero.xmm
  %22 = vpsubq.xmm %21, %qwords
  %23 = vpcmpgtq.xmm %21, %qwords
  %b = vpblendvb.xmm %qwords, %22, %23
  %c = avx512.vpabsq.zmm %wide
  return %a, %b, %c
}

// ====

// Sign remains full-width when no 512-bit sign-control instruction exists.
// RUN: emit source-low target=x86:avx512 output=low
func.def @wide_sign(%input: vector<64xi8>) -> (vector<64xi8>) {
  %sign = vector.signi %input : vector<64xi8>
  func.return %sign : vector<64xi8>
}

// ----
low.func.def target<x86.avx512.core> abi(object_function) abi_layout({signature = (vector<64xi8>) -> (vector<64xi8>)}) @wide_sign(%input: reg<x86.zmm>) -> (reg<x86.zmm>) asm {
  %15 = vxorps.zero
  %16 = vpcmpb %input, %15, 1
  %17 = mov.imm32 1
  %18 = vpbroadcastb %17
  %19 = mov.imm32 -1
  %20 = vpbroadcastb %19
  %21 = vpcmpb %input, %15, 4
  %22 = vpblendmb %21, %18, %15
  %sign = vpblendmb %16, %20, %22
  return %sign
}
