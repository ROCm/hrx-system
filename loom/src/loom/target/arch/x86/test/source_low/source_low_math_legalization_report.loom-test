// ====

// RUN: compile-report target=x86:avx2 legalize-math

func.def @activation_closure(%input: vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
  %exp = vector.expf<afn> %input : vector<8xf32>
  %sin = vector.sinf<afn> %input : vector<8xf32>
  %cos = vector.cosf<afn> %input : vector<8xf32>
  %logistic = vector.logisticf<afn> %input : vector<8xf32>
  %silu = vector.siluf<afn> %input : vector<8xf32>
  %tanh = vector.tanhf<afn> %input : vector<8xf32>
  %erf = vector.erff<afn> %input : vector<8xf32>
  %gelu_tanh = vector.geluf<tanh, afn> %input : vector<8xf32>
  %gelu_erf = vector.geluf<erf, afn> %input : vector<8xf32>
  %gelu_logistic = vector.geluf<logistic, afn> %input {scale = 1.702} : vector<8xf32>
  func.return %exp, %sin, %cos, %logistic, %silu, %tanh, %erf, %gelu_tanh, %gelu_erf, %gelu_logistic : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
}

