func.def @nonzero_initial_store(%output: buffer) {
  %begin = index.constant 2 : index
  %step = index.constant 1 : index
  %end = index.constant 6 : index
  %row_stride = index.constant 12 : offset
  cfg.br ^preheader
^preheader:
  cfg.br ^header(%begin: index)
^header(%position: index):
  %more = index.cmp slt, %position, %end : index
