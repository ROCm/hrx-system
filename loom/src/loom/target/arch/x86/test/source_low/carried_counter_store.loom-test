low.func.def target<x86.avx2.core> abi(object_function) @nonzero_initial_store(%output: reg<x86.gpr64>) asm {
  %begin = mov.imm64 2
  low.br ^header(%begin: reg<x86.gpr64>)
^header(%position: reg<x86.gpr64>):
  low.op.cond_br<x86.scalar.cmp.branch.imm.gpr64>(%position) {imm32 = 6, predicate = 12}, ^body, ^exit : (reg<x86.gpr64>)
^body:
  %value = mov.trunc.gpr32.gpr64 %position
  %15 = mov.imm64 12
  %16 = copy %position : reg<x86.gpr64> -> reg<x86.gpr64>
  %17 = imul.gpr64 %16, %15
  mov.store.indexed.gpr32 %value, %output, %17 {disp32 = 0, scale = 1}
