x86.target<scalar> @target

func.def target(@target) @remainder_requires_u32_numerator(%input: index) -> (index) {
  %divisor = index.constant 3 : index
  // ERROR@+1: TARGET/003 {op_name="index.rem", constraint_key="x86.scalar.division_u32"}
  %result = index.rem %input, %divisor : index
  func.return %result : index
}

