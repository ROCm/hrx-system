x86.target<scalar> @target

func.def target(@target) @remainder_rejects_signed_integer(%input: i32) -> (i32) {
  %divisor = scalar.constant 7 : i32
  // ERROR@+1: TARGET/001 {op_name="scalar.remsi"}
  %result = scalar.remsi %input, %divisor : i32
  func.return %result : i32
