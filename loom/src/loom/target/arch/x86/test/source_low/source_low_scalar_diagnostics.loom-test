// ====

x86.target<scalar> @target

func.def target(@target) @constant_division_requires_nonzero_divisor(%input: i32) -> (i32, i32) {
  %divisor = scalar.constant 0 : i32
  // ERROR@+1: TARGET/003 {op_name="scalar.divui", constraint_key="x86.scalar.constant_divisor"}
  %quotient = scalar.divui %input, %divisor : i32
  // ERROR@+1: TARGET/003 {op_name="scalar.remui", constraint_key="x86.scalar.constant_divisor"}
  %remainder = scalar.remui %input, %divisor : i32
  func.return %quotient, %remainder : i32, i32
}
