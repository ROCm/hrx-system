// TEMPLATE: loom/src/loom/test/corpus/source_low/nested_view_selection.loom-test
// RUN: emit source-low target=x86:avx2 output=low

// A derived selection retains both the selected buffer and its byte base.
func.def @derived_selection(%first: buffer, %second: buffer, %third: buffer, %position_input: index, %select_first: i1, %select_pair: i1) -> (i32) {
  %position = index.assume %position_input [range(%position_input, 1, 2)] : index
  %base0 = index.constant 4 : offset
  %base1 = index.constant 8 : offset
  %base2 = index.constant 12 : offset
  %first_aligned = buffer.assume.alignment %first {minimum_alignment = 4} : buffer
  %second_aligned = buffer.assume.alignment %second {minimum_alignment = 4} : buffer
  %third_aligned = buffer.assume.alignment %third {minimum_alignment = 4} : buffer
  %first_view = buffer.view %first_aligned[%base0] : buffer -> view<4xi32>
  %second_view = buffer.view %second_aligned[%base1] : buffer -> view<4xi32>
  %third_view = buffer.view %third_aligned[%base2] : buffer -> view<1xi32>
  %pair = scf.select %select_first, %first_view, %second_view : view<4xi32>
  %refined = view.refine %pair : view<4xi32> -> view<4xi32>
  %part = view.subview %refined[%position] : view<4xi32> -> view<1xi32>
  %selected = scf.select %select_pair, %part, %third_view : view<1xi32>
  %value = view.load %selected[0] : view<1xi32> -> i32
  func.return %value : i32
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) @derived_selection(%first_aligned: reg<x86.gpr64>, %second_aligned: reg<x86.gpr64>, %third_aligned: reg<x86.gpr64>, %position: reg<x86.gpr64>, %select_first: reg<x86.gpr32>, %select_pair: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  %base0 = mov.imm64 4
  %base1 = mov.imm64 8
  %base2 = mov.imm64 12
  low.cond_br %select_first, ^_bb1, ^_bb2 : reg<x86.gpr32>
^_bb1:
  low.br ^_bb3(%first_aligned: reg<x86.gpr64>, %base0: reg<x86.gpr64>)
^_bb2:
  low.br ^_bb3(%second_aligned: reg<x86.gpr64>, %base1: reg<x86.gpr64>)
^_bb3(%pair_root: reg<x86.gpr64>, %pair_offset: reg<x86.gpr64>):
  %54 = copy %position : reg<x86.gpr64> -> reg<x86.gpr64>
  %55 = shl.imm.gpr64 %54 {shift = 2}
  %56 = copy %pair_offset : reg<x86.gpr64> -> reg<x86.gpr64>
  %57 = add.gpr64 %56, %55
  low.cond_br %select_pair, ^_bb4, ^_bb5 : reg<x86.gpr32>
^_bb4:
  low.br ^_bb6(%pair_root: reg<x86.gpr64>, %57: reg<x86.gpr64>)
^_bb5:
  low.br ^_bb6(%third_aligned: reg<x86.gpr64>, %base2: reg<x86.gpr64>)
^_bb6(%selected: reg<x86.gpr64>, %selected_offset: reg<x86.gpr64>):
  %value = mov.load.indexed.gpr32 %selected, %selected_offset {disp32 = 0, scale = 1}
  return %value
}

// ====

// Nested selections compose with structured side effects and explicit CFG.
func.def @selection_with_side_effects(%first: buffer, %second: buffer, %third: buffer, %select_first: i1, %select_pair: i1, %enter: i1, %side: i1, %initial: i32) -> (i32) {
  %base = index.constant 0 : offset
  %first_aligned = buffer.assume.alignment %first {minimum_alignment = 4} : buffer
  %second_aligned = buffer.assume.alignment %second {minimum_alignment = 4} : buffer
  %third_aligned = buffer.assume.alignment %third {minimum_alignment = 4} : buffer
  %first_view = buffer.view %first_aligned[%base] : buffer -> view<1xi32>
  %second_view = buffer.view %second_aligned[%base] : buffer -> view<1xi32>
  %third_view = buffer.view %third_aligned[%base] : buffer -> view<1xi32>
  cfg.cond_br %enter, ^producer, ^exit
^producer:
  view.store %initial, %third_view[0] : i32, view<1xi32>
  scf.if %side {
    view.store %initial, %first_view[0] : i32, view<1xi32>
  }
  %pair = scf.select %select_first, %first_view, %second_view : view<1xi32>
  cfg.br ^consumer
^consumer:
  %selected = scf.select %select_pair, %pair, %third_view : view<1xi32>
  %result = view.load %selected[0] : view<1xi32> -> i32
  func.return %result : i32
^exit:
  func.return %initial : i32
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) @selection_with_side_effects(%first_view: reg<x86.gpr64>, %second_aligned: reg<x86.gpr64>, %third_view: reg<x86.gpr64>, %select_first: reg<x86.gpr32>, %select_pair: reg<x86.gpr32>, %enter: reg<x86.gpr32>, %side: reg<x86.gpr32>, %initial: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  low.cond_br %enter, ^producer, ^exit : reg<x86.gpr32>
^producer:
  mov.store.gpr32 %initial, %third_view {disp32 = 0}
  low.cond_br %side, ^_bb2, ^_bb3 : reg<x86.gpr32>
^_bb2:
  mov.store.gpr32 %initial, %first_view {disp32 = 0}
  low.br ^_bb3
^_bb3:
  low.cond_br %select_first, ^_bb4, ^_bb5 : reg<x86.gpr32>
^_bb4:
  low.br ^_bb6(%first_view: reg<x86.gpr64>)
^_bb5:
  low.br ^_bb6(%second_aligned: reg<x86.gpr64>)
^_bb6(%pair_root: reg<x86.gpr64>):
  low.cond_br %select_pair, ^_bb7, ^_bb8 : reg<x86.gpr32>
^_bb7:
  low.br ^_bb9(%pair_root: reg<x86.gpr64>)
^_bb8:
  low.br ^_bb9(%third_view: reg<x86.gpr64>)
^_bb9(%selected: reg<x86.gpr64>):
  %result = mov.load.gpr32 %selected {disp32 = 0}
  return %result
^exit:
  return %initial
}
