// RUN: emit source-low output=low

x86.target<scalar> @target

func.def target(@target) @copy(%source: buffer, %source_offset: offset, %target: buffer, %target_offset: offset, %byte_length: offset) {
  buffer.copy %source[%source_offset], %target[%target_offset], %byte_length
  func.return
}

// ----
low.func.def target<x86.scalar.core>(@target) abi(object_function) @copy(%source: reg<x86.gpr64>, %source_offset: reg<x86.gpr64>, %target: reg<x86.gpr64>, %target_offset: reg<x86.gpr64>, %byte_length: reg<x86.gpr64>) asm {
  %21 = mov.imm64 0
  low.br ^_bb1(%21: reg<x86.gpr64>)
^_bb1(%20: reg<x86.gpr64>):
  %22 = cmp.ult.gpr64 %20, %byte_length
  low.cond_br %22, ^_bb2, ^_bb3 : reg<x86.gpr32>
^_bb2:
  %23 = lea %source_offset, %20
  %24 = movzx.load.indexed.u8.gpr32 %source, %23 {disp32 = 0, scale = 1}
  %25 = lea %target_offset, %20
  mov.store.indexed.u8.gpr32 %24, %target, %25 {disp32 = 0, scale = 1}
  %26 = lea.disp %20 {disp32 = 1}
  low.br ^_bb1(%26: reg<x86.gpr64>)
^_bb3:
  return
}

