// RUN: emit source-low output=low

// The production dequantization shape fuses a dynamic scalar half load,
// extension, and four-lane splat into one memory broadcast.
x86.target<avx2> @target {features = [avxneconvert]}

func.def target(@target) @broadcast_f16x4_dynamic(%input: buffer, %position0: index) -> (vector<4xf32>) {
  %base = index.constant 0 : offset
  %position = index.assume %position0 [range(%position0, 0, 63)] : index
  %source = buffer.view %input[%base] : buffer -> view<64xf16>
  %narrow = view.load %source[%position] : view<64xf16> -> f16
  %wide = scalar.extf %narrow : f16 to f32
  %result = vector.splat %wide : vector<4xf32>
  func.return %result : vector<4xf32>
}

// ----
low.func.def target<x86.avx2_features.core>(@target) abi(object_function) abi_layout({signature = (buffer, index) -> (vector<4xf32>)}) @broadcast_f16x4_dynamic(%input: reg<x86.gpr64>, %position: reg<x86.gpr64>) -> (reg<x86.xmm>) asm {
  %result = vbcstnesh2ps.load.indexed.xmm %input, %position {disp32 = 0, scale = 2}
  return %result
}

// ====

// A static bfloat load exercises the eight-lane broadcast form.
x86.target<avx2> @target {features = [avxneconvert]}

func.def target(@target) @broadcast_bf16x8_static(%input: buffer) -> (vector<8xf32>) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<64xbf16>
  %narrow = view.load %source[3] : view<64xbf16> -> bf16
  %wide = scalar.extf<daz> %narrow : bf16 to f32
  %result = vector.splat %wide : vector<8xf32>
  func.return %result : vector<8xf32>
}

// ----
low.func.def target<x86.avx2_features.core>(@target) abi(object_function) abi_layout({signature = (buffer) -> (vector<8xf32>)}) @broadcast_bf16x8_static(%input: reg<x86.gpr64>) -> (reg<x86.ymm>) asm {
  %result = vbcstnebf162ps.load.ymm %input {disp32 = 6}
  return %result
}

// ====

// Even-lane conversion reads the full interleaved source packet directly.
x86.target<avx2> @target {features = [avxneconvert]}

func.def target(@target) @even_bf16x8_dynamic(%input: buffer, %position0: index) -> (vector<4xf32>) {
  %base = index.constant 0 : offset
  %position = index.assume %position0 [range(%position0, 0, 56)] : index
  %source = buffer.view %input[%base] : buffer -> view<64xbf16>
  %packet = vector.load %source[%position] : view<64xbf16> -> vector<8xbf16>
  %even, %odd = vector.deinterleave<0> %packet : vector<8xbf16> -> vector<4xbf16>, vector<4xbf16>
  %result = vector.extf<daz> %even : vector<4xbf16> to vector<4xf32>
  func.return %result : vector<4xf32>
}

// ----
low.func.def target<x86.avx2_features.core>(@target) abi(object_function) abi_layout({signature = (buffer, index) -> (vector<4xf32>)}) @even_bf16x8_dynamic(%input: reg<x86.gpr64>, %position: reg<x86.gpr64>) -> (reg<x86.xmm>) asm {
  %result = vcvtneebf162ps.load.indexed.xmm %input, %position {disp32 = 0, scale = 2}
  return %result
}

// ====

// Odd-lane conversion covers the full-width half source packet.
x86.target<avx2> @target {features = [avxneconvert]}

func.def target(@target) @odd_f16x16_static(%input: buffer) -> (vector<8xf32>) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<32xf16>
  %packet = vector.load %source[4] : view<32xf16> -> vector<16xf16>
  %even, %odd = vector.deinterleave<0> %packet : vector<16xf16> -> vector<8xf16>, vector<8xf16>
  %result = vector.extf %odd : vector<8xf16> to vector<8xf32>
  func.return %result : vector<8xf32>
}

// ----
low.func.def target<x86.avx2_features.core>(@target) abi(object_function) abi_layout({signature = (buffer) -> (vector<8xf32>)}) @odd_f16x16_static(%input: reg<x86.gpr64>) -> (reg<x86.ymm>) asm {
  %result = vcvtneoph2ps.load.ymm %input {disp32 = 8}
  return %result
}

// ====

// AVX-NE-CONVERT can directly narrow either native AVX2 vector width when the
// source author permits the instruction's input-subnormal behavior.
x86.target<avx2> @target {features = [avxneconvert]}

func.def target(@target) @narrow_bf16_vectors(%xmm: vector<4xf32>, %ymm: vector<8xf32>) -> (vector<4xbf16>, vector<8xbf16>) {
  %xmm_result = vector.fptrunc<daz> %xmm : vector<4xf32> to vector<4xbf16>
  %ymm_result = vector.fptrunc<daz> %ymm : vector<8xf32> to vector<8xbf16>
  func.return %xmm_result, %ymm_result : vector<4xbf16>, vector<8xbf16>
}

// ----
low.func.def target<x86.avx2_features.core>(@target) abi(object_function) abi_layout({signature = (vector<4xf32>, vector<8xf32>) -> (vector<4xbf16>, vector<8xbf16>)}) @narrow_bf16_vectors(%xmm: reg<x86.xmm>, %ymm: reg<x86.ymm>) -> (reg<x86.xmm>, reg<x86.xmm>) asm {
  %xmm_result = vcvtneps2bf16.xmm.xmm %xmm
  %ymm_result = vcvtneps2bf16.xmm.ymm %ymm
  return %xmm_result, %ymm_result
}

// ====

// The feature-aware contract must not select AVX-NE-CONVERT instructions
// when the target does not advertise the extension.
x86.target<avx2> @target {features = []}

func.def target(@target) @broadcast_f16x4_without_feature(%input: buffer) -> (vector<4xf32>) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<1xf16>
  %narrow = view.load %source[0] : view<1xf16> -> f16
  // ERROR@+1: TARGET/046 {function_name="broadcast_f16x4_without_feature", opcode="x86.f16c.vcvtph2ps.xmm.xmm", descriptor_set_key="x86.avx2_features.core", feature_word_index="0", missing_feature_bits="512"}
  %wide = scalar.extf %narrow : f16 to f32
  %result = vector.splat %wide : vector<4xf32>
  func.return %result : vector<4xf32>
}

// ====

x86.target<avx2> @target {features = [f16c]}

func.def target(@target) @widen_f16_vector(%input: vector<8xf16>) -> (vector<8xf32>) {
  %result = vector.extf %input : vector<8xf16> to vector<8xf32>
  func.return %result : vector<8xf32>
}

// ----
low.func.def target<x86.avx2_features.core>(@target) abi(object_function) abi_layout({signature = (vector<8xf16>) -> (vector<8xf32>)}) @widen_f16_vector(%input: reg<x86.xmm>) -> (reg<x86.ymm>) asm {
  %result = vcvtph2ps.ymm.xmm %input
  return %result
}
