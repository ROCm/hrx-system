func.def @scalar_f64_select(%condition: i1, %true_value: f64, %false_value: f64) -> (f64) {
  %result = scf.select %condition, %true_value, %false_value : f64
  func.return %result : f64
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) @scalar_f64_select(%condition: reg<x86.gpr32>, %true_value: reg<x86.xmm>, %false_value: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %9 = vmovd.xmm.gpr32 %condition
  %10 = vpsllq.xmm %9, 63
  %result = vblendvpd.xmm %false_value, %true_value, %10
  return %result
}

