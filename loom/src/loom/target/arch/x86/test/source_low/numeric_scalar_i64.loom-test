func.def @scalar_i64_bitwise_sgpr(%lhs: i64, %rhs: i64) -> (i64, i64, i64) {
  %and = scalar.andi %lhs, %rhs : i64
  %or = scalar.ori %and, %lhs : i64
  %xor = scalar.xori %or, %rhs : i64
  func.return %and, %or, %xor : i64, i64, i64
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) @scalar_i64_bitwise_sgpr(%lhs: reg<x86.gpr64>, %rhs: reg<x86.gpr64>) -> (reg<x86.gpr64>, reg<x86.gpr64>, reg<x86.gpr64>) asm {
  %13 = copy %lhs : reg<x86.gpr64> -> reg<x86.gpr64>
  %and = and.gpr64 %13, %rhs
  %15 = copy %and : reg<x86.gpr64> -> reg<x86.gpr64>
  %or = or.gpr64 %15, %lhs
  %17 = copy %or : reg<x86.gpr64> -> reg<x86.gpr64>
  %xor = xor.gpr64 %17, %rhs
  return %and, %or, %xor
}

