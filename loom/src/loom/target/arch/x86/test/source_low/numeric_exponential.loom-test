// RUN: emit source-low target=x86:avx2 output=low

// Double precision uses split range reduction and two normal scale factors.
func.def @natural_double(%value: f64) -> (f64) {
  %result = scalar.expf<afn> %value : f64
  func.return %result : f64
}

