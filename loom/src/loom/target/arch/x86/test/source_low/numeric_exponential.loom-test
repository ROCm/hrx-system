// RUN: emit source-low target=x86:avx2 output=low

// The same reconstruction stays in the vector carrier, including exponent bits.
func.def @binary_double(%value: vector<4xf64>) -> (vector<4xf64>) {
  %result = vector.exp2f<afn> %value : vector<4xf64>
  func.return %result : vector<4xf64>
}

