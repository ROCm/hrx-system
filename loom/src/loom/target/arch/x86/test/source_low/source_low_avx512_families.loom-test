  %i32 = vpaddd %83, %82
  %87 = avx512.vpmovzxbq.zmm.xmm %29
  %88 = vpbroadcastq %i64_step
  %89 = vpmullq %87, %88
  %90 = vpbroadcastq %i64_base
  %i64 = vpaddq %90, %89
  return %i8, %i16, %i32, %i64
}

// ====

x86.target<avx512> @target

func.def target(@target) @unit_iota(%base: i8) -> (vector<64xi8>) {
  %step = scalar.constant 1 : i8
  %result = vector.iota %base step %step : vector<64xi8>
  func.return %result : vector<64xi8>
}

// ----
low.func.def target<x86.avx512.core>(@target) abi(object_function) abi_layout({signature = (i8) -> (vector<64xi8>)}) @unit_iota(%base: reg<x86.gpr32>) -> (reg<x86.zmm>) asm {
  %6 = mov.imm64 506097522914230528
  %7 = vmovq.xmm.gpr64 %6
  %8 = mov.imm64 1084818905618843912
  %9 = vmovq.xmm.gpr64 %8
  %10 = vpunpcklqdq.xmm %7, %9
  %11 = mov.imm32 16
  %12 = avx512.vpbroadcastb.xmm %11
  %13 = vpaddb.xmm %10, %12
  %14 = vxorps.zero.ymm
  %15 = vinsertf128.ymm.xmm %14, %10, 0
  %16 = vinsertf128.ymm.xmm %15, %13, 1
  %17 = mov.imm32 32
  %18 = avx512.vpbroadcastb.ymm %17
  %19 = vpaddb.ymm %16, %18
  %20 = vxorps.zero
  %21 = vinserti64x4.zmm.ymm %20, %16, 0
  %22 = vinserti64x4.zmm.ymm %21, %19, 1
  %23 = vpbroadcastb %base
  %result = vpaddb %23, %22
  return %result
}
