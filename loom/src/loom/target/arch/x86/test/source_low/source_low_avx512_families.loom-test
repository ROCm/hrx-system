low.func.def target<x86.avx512.core>(@target) abi(object_function) abi_layout({signature = (i16, bf16) -> (vector<64xi8>, vector<32xi16>, vector<8xi64>, vector<64xf8E4M3>, vector<32xbf16>, vector<8xf64>)}) @construct_zmm_vectors(%i16_value: reg<x86.gpr32>, %bf16_value: reg<x86.gpr32>) -> (reg<x86.zmm>, reg<x86.zmm>, reg<x86.zmm>, reg<x86.zmm>, reg<x86.zmm>, reg<x86.zmm>) asm {
  %22 = mov.imm32 -7
  %i8_constant = vpbroadcastb %22
  %i16_splat = vpbroadcastw %i16_value
  %25 = mov.imm64 81985529216486895
  %i64_constant = vpbroadcastq %25
  %27 = mov.imm32 60
  %f8_constant = vpbroadcastb %27
  %bf16_splat = vpbroadcastw %bf16_value
  %30 = mov.imm64 -4610560118520545280
  %f64_constant = vpbroadcastq %30
  return %i8_constant, %i16_splat, %i64_constant, %f8_constant, %bf16_splat, %f64_constant
}

