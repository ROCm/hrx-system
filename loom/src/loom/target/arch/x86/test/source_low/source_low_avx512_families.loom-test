func.def target(@target) @integer_zmm_families(%i8_lhs: vector<64xi8>, %i8_rhs: vector<64xi8>, %i16_lhs: vector<32xi16>, %i16_rhs: vector<32xi16>, %i64_lhs: vector<8xi64>, %i64_rhs: vector<8xi64>) -> (vector<64xi8>, vector<32xi16>, vector<8xi64>) {
  %i8_add = vector.addi %i8_lhs, %i8_rhs : vector<64xi8>
  %i8_sub = vector.subi %i8_add, %i8_rhs : vector<64xi8>
  %i8_min = vector.minsi %i8_sub, %i8_rhs : vector<64xi8>
  %i8_max = vector.maxsi %i8_min, %i8_lhs : vector<64xi8>
  %i8_umin = vector.minui %i8_max, %i8_rhs : vector<64xi8>
