x86.target<avx2> @target

func.def target(@target) @subview_dense_rows(%input: buffer, %output: buffer) -> (i32) {
  %base = index.constant 4 : offset
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %source = buffer.view %input_aligned[%base] : buffer -> view<4x8xi32>
  %destination = buffer.view %output_aligned[%base] : buffer -> view<4x8xi32>
  %source_crop = view.subview %source[1, 0] : view<4x8xi32> -> view<2x8xi32>
  %destination_crop = view.subview %destination[2, 0] : view<4x8xi32> -> view<2x8xi32>
  %value = view.load %source_crop[1, 3] : view<2x8xi32> -> i32
  view.store %value, %destination_crop[0, 4] : i32, view<2x8xi32>
  func.return %value : i32
}

// ----
low.func.def target<x86.avx2.core>(@target) abi(object_function) @subview_dense_rows(%source_crop: reg<x86.gpr64>, %destination_crop: reg<x86.gpr64>) -> (reg<x86.gpr32>) asm {
  %value = mov.load.gpr32 %source_crop {disp32 = 80}
  mov.store.gpr32 %value, %destination_crop {disp32 = 84}
  return %value
}
