low.func.def target<x86.avx2.core>(@target) abi(object_function) @subview_vector_aligned(%source_crop: reg<x86.gpr64>, %destination_crop: reg<x86.gpr64>) asm {
  %value = vmovdqu32.load.ymm %source_crop {disp32 = 256}
  vmovdqu32.store.ymm %value, %destination_crop {disp32 = 192}
  return
}

