// RUN: emit source-low output=low

x86.target<avx512_packed_dot> @target

func.def target(@target) @bf16_blocked_mma_xmm(
    %lhs_data: vector<8xbf16>,
    %rhs_data: vector<8xbf16>,
    %init_data: vector<4xf32>) -> (vector<4xf32>) {
  %blocks = index.constant 4 : index
  %m = index.constant 1 : index
  %n = index.constant 1 : index
  %k = index.constant 2 : index
  %lhs = vector.fragment<lhs> %lhs_data shape [blocks(%blocks), %m, %k] : vector<8xbf16>
  %rhs = vector.fragment<rhs> %rhs_data shape [blocks(%blocks), %k, %n] : vector<8xbf16>
  %init = vector.fragment<init> %init_data shape [blocks(%blocks), %m, %n] : vector<4xf32>
  %result = vector.mma %lhs, %rhs, %init : vector<8xbf16>, vector<8xbf16>, vector<4xf32>
  func.return %result : vector<4xf32>
}

// ----
low.func.def target<x86.avx512_packed_dot.core>(@target) abi(object_function) @bf16_blocked_mma_xmm(%lhs: reg<x86.xmm>, %rhs: reg<x86.xmm>, %init: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %16 = copy %init : reg<x86.xmm> -> reg<x86.xmm>
  %result = avx512_bf16.vdpbf16ps.xmm %16, %lhs, %rhs
  return %result
}

