// RUN: emit source-low output=low

x86.target<scalar> @target

low.func.def schedule(phased) target<x86.scalar.core>(@target) @scoped_double(%value: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  %value_copy = copy %value : reg<x86.gpr32> -> reg<x86.gpr32>
  %first = add.gpr32 %value_copy, %value
  low.schedule.phase
  %first_copy = copy %first : reg<x86.gpr32> -> reg<x86.gpr32>
  %second = add.gpr32 %first_copy, %first
  return %second
}

// A helper called twice per unrolled iteration creates independent scopes.
func.def public target(@target) @unrolled_helpers(%lhs: i32, %rhs: i32) -> (i32) {
  %begin = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  %initial = scalar.constant 0 : i32
  %result = scf.for %i = [%begin to %end step %step](%sum = %initial : i32) -> (i32) unroll {
    %left = low.invoke @scoped_double(%lhs) : (i32) -> (i32)
    %right = low.invoke @scoped_double(%rhs) : (i32) -> (i32)
    %pair = scalar.addi %left, %right : i32
    %next = scalar.addi %sum, %pair : i32
    scf.yield %next : i32
  }
  func.return %result : i32
}

// ----
low.func.def public target<x86.scalar.core>(@target) abi(object_function) abi_layout({argument_locations = [7, 6], calling_convention = "sysv_x86_64", result_locations = [0], stack_argument_bytes = 0}) @unrolled_helpers(%lhs: reg<x86.gpr32>, %rhs: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  low.schedule.begin
  %value_copy$49 = copy %lhs : reg<x86.gpr32> -> reg<x86.gpr32>
  %first$50 = add.gpr32 %value_copy$49, %lhs
  low.schedule.phase
  %first_copy$51 = copy %first$50 : reg<x86.gpr32> -> reg<x86.gpr32>
  %second$52 = add.gpr32 %first_copy$51, %first$50
  low.schedule.end
  low.schedule.begin
  %value_copy$45 = copy %rhs : reg<x86.gpr32> -> reg<x86.gpr32>
  %first$46 = add.gpr32 %value_copy$45, %rhs
  low.schedule.phase
  %first_copy$47 = copy %first$46 : reg<x86.gpr32> -> reg<x86.gpr32>
  %second$48 = add.gpr32 %first_copy$47, %first$46
  low.schedule.end
  %33 = copy %second$52 : reg<x86.gpr32> -> reg<x86.gpr32>
  %pair = add.gpr32 %33, %second$48
  low.schedule.begin
  %value_copy$41 = copy %lhs : reg<x86.gpr32> -> reg<x86.gpr32>
  %first$42 = add.gpr32 %value_copy$41, %lhs
  low.schedule.phase
  %first_copy$43 = copy %first$42 : reg<x86.gpr32> -> reg<x86.gpr32>
  %second$44 = add.gpr32 %first_copy$43, %first$42
  low.schedule.end
  low.schedule.begin
  %value_copy$2 = copy %rhs : reg<x86.gpr32> -> reg<x86.gpr32>
  %first$3 = add.gpr32 %value_copy$2, %rhs
  low.schedule.phase
  %first_copy$4 = copy %first$3 : reg<x86.gpr32> -> reg<x86.gpr32>
  %second$5 = add.gpr32 %first_copy$4, %first$3
  low.schedule.end
  %37 = copy %second$44 : reg<x86.gpr32> -> reg<x86.gpr32>
  %pair_1 = add.gpr32 %37, %second$5
  %39 = copy %pair : reg<x86.gpr32> -> reg<x86.gpr32>
  %next_1 = add.gpr32 %39, %pair_1
  return %next_1
}

// ====

// RUN: emit source-low output=low

x86.target<scalar> @target

low.func.def schedule(phased) target<x86.scalar.core>(@target) @scoped_double(%value: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  %value_copy = copy %value : reg<x86.gpr32> -> reg<x86.gpr32>
  %first = add.gpr32 %value_copy, %value
  low.schedule.phase
  %first_copy = copy %first : reg<x86.gpr32> -> reg<x86.gpr32>
  %second = add.gpr32 %first_copy, %first
  return %second
}

// Partial unrolling preserves independent scopes in the loop and its tail.
func.def public target(@target) @partial_unrolled_helpers(%lhs: i32, %rhs: i32) -> (i32) {
  %begin = index.constant 0 : index
  %end = index.constant 5 : index
  %step = index.constant 1 : index
  %factor = index.constant 2 : index
  %initial = scalar.constant 0 : i32
  %result = scf.for %i = [%begin to %end step %step](%sum = %initial : i32) -> (i32) unroll(%factor) {
    %left = low.invoke @scoped_double(%lhs) : (i32) -> (i32)
    %right = low.invoke @scoped_double(%rhs) : (i32) -> (i32)
    %pair = scalar.addi %left, %right : i32
    %next = scalar.addi %sum, %pair : i32
    scf.yield %next : i32
  }
  func.return %result : i32
}

// ----
low.func.def public target<x86.scalar.core>(@target) abi(object_function) abi_layout({argument_locations = [7, 6], calling_convention = "sysv_x86_64", result_locations = [0], stack_argument_bytes = 0}) @partial_unrolled_helpers(%lhs: reg<x86.gpr32>, %rhs: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  %begin = mov.imm64 0
  %end = mov.imm64 5
  %initial = mov.imm32 0
  low.br ^_bb1(%begin: reg<x86.gpr64>, %initial: reg<x86.gpr32>)
^_bb1(%i: reg<x86.gpr64>, %sum: reg<x86.gpr32>):
  %53 = cmp.slt.gpr64 %i, %end
  low.cond_br %53, ^_bb2, ^_bb6 : reg<x86.gpr32>
^_bb2:
  low.schedule.begin
  %value_copy$77 = copy %lhs : reg<x86.gpr32> -> reg<x86.gpr32>
  %first$78 = add.gpr32 %value_copy$77, %lhs
  low.schedule.phase
  %first_copy$79 = copy %first$78 : reg<x86.gpr32> -> reg<x86.gpr32>
  %second$80 = add.gpr32 %first_copy$79, %first$78
  low.schedule.end
  low.schedule.begin
  %value_copy$73 = copy %rhs : reg<x86.gpr32> -> reg<x86.gpr32>
  %first$74 = add.gpr32 %value_copy$73, %rhs
  low.schedule.phase
  %first_copy$75 = copy %first$74 : reg<x86.gpr32> -> reg<x86.gpr32>
  %second$76 = add.gpr32 %first_copy$75, %first$74
  low.schedule.end
  %56 = copy %second$80 : reg<x86.gpr32> -> reg<x86.gpr32>
  %pair = add.gpr32 %56, %second$76
  %58 = copy %sum : reg<x86.gpr32> -> reg<x86.gpr32>
  %next = add.gpr32 %58, %pair
  %i_1 = lea.disp %i {disp32 = 1}
  %61 = cmp.slt.gpr64 %i_1, %end
  low.cond_br %61, ^_bb3, ^_bb4 : reg<x86.gpr32>
^_bb3:
  low.schedule.begin
  %value_copy$69 = copy %lhs : reg<x86.gpr32> -> reg<x86.gpr32>
  %first$70 = add.gpr32 %value_copy$69, %lhs
  low.schedule.phase
  %first_copy$71 = copy %first$70 : reg<x86.gpr32> -> reg<x86.gpr32>
  %second$72 = add.gpr32 %first_copy$71, %first$70
  low.schedule.end
  low.schedule.begin
  %value_copy$2 = copy %rhs : reg<x86.gpr32> -> reg<x86.gpr32>
  %first$3 = add.gpr32 %value_copy$2, %rhs
  low.schedule.phase
  %first_copy$4 = copy %first$3 : reg<x86.gpr32> -> reg<x86.gpr32>
  %second$5 = add.gpr32 %first_copy$4, %first$3
  low.schedule.end
  %64 = copy %second$72 : reg<x86.gpr32> -> reg<x86.gpr32>
  %pair_1 = add.gpr32 %64, %second$5
  %66 = copy %next : reg<x86.gpr32> -> reg<x86.gpr32>
  %next_1 = add.gpr32 %66, %pair_1
  low.br ^_bb5(%next_1: reg<x86.gpr32>)
^_bb4:
  low.br ^_bb5(%next: reg<x86.gpr32>)
^_bb5(%49: reg<x86.gpr32>):
  %68 = lea.disp %i {disp32 = 2}
  low.br ^_bb1(%68: reg<x86.gpr64>, %49: reg<x86.gpr32>)
^_bb6:
  return %sum
}
