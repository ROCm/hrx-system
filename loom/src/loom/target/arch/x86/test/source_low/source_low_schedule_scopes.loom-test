// RUN: emit source-low output=low

x86.target<scalar> @target

low.func.def schedule(phased) target<x86.scalar.core>(@target) @scoped_double(%value: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  %value_copy = copy %value : reg<x86.gpr32> -> reg<x86.gpr32>
  %first = add.gpr32 %value_copy, %value
  low.schedule.phase
  %first_copy = copy %first : reg<x86.gpr32> -> reg<x86.gpr32>
  %second = add.gpr32 %first_copy, %first
  return %second
}

// A helper called twice per unrolled iteration creates independent scopes.
func.def public target(@target) @unrolled_helpers(%lhs: i32, %rhs: i32) -> (i32) {
  %begin = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  %initial = scalar.constant 0 : i32
  %result = scf.for %i = [%begin to %end step %step](%sum = %initial : i32) -> (i32) unroll {
    %left = low.invoke @scoped_double(%lhs) : (i32) -> (i32)
    %right = low.invoke @scoped_double(%rhs) : (i32) -> (i32)
    %pair = scalar.addi %left, %right : i32
    %next = scalar.addi %sum, %pair : i32
    scf.yield %next : i32
  }
  func.return %result : i32
}

// ----
low.func.def schedule(phased) target<x86.scalar.core>(@target) @scoped_double(%value: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  %value_copy = copy %value : reg<x86.gpr32> -> reg<x86.gpr32>
  %first = add.gpr32 %value_copy, %value
  low.schedule.phase
  %first_copy = copy %first : reg<x86.gpr32> -> reg<x86.gpr32>
  %second = add.gpr32 %first_copy, %first
  return %second
}

low.func.def public target<x86.scalar.core>(@target) abi(object_function) abi_layout({argument_locations = [7, 6], calling_convention = "sysv_x86_64", result_locations = [0], stack_argument_bytes = 0}) @unrolled_helpers(%lhs: reg<x86.gpr32>, %rhs: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  %left = low.func.call @scoped_double(%lhs) : (reg<x86.gpr32>) -> (reg<x86.gpr32>)
  %right = low.func.call @scoped_double(%rhs) : (reg<x86.gpr32>) -> (reg<x86.gpr32>)
  %33 = copy %left : reg<x86.gpr32> -> reg<x86.gpr32>
  %pair = add.gpr32 %33, %right
  %left_1 = low.func.call @scoped_double(%lhs) : (reg<x86.gpr32>) -> (reg<x86.gpr32>)
  %right_1 = low.func.call @scoped_double(%rhs) : (reg<x86.gpr32>) -> (reg<x86.gpr32>)
  %37 = copy %left_1 : reg<x86.gpr32> -> reg<x86.gpr32>
  %pair_1 = add.gpr32 %37, %right_1
  %39 = copy %pair : reg<x86.gpr32> -> reg<x86.gpr32>
  %next_1 = add.gpr32 %39, %pair_1
  return %next_1
}

