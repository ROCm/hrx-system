// RUN: emit source-low target=x86:avx512_packed_dot output=low

func.def @bf16_dot2_zero_256(%lhs: vector<16xbf16>, %rhs: vector<16xbf16>) -> (vector<8xf32>) {
  %c0 = vector.splatf 0.0 : vector<8xf32>
  %dot = vector.dot2f %lhs, %rhs, %c0 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
  func.return %dot : vector<8xf32>
}

// ----
low.func.def target<x86.avx512_features.core> abi(object_function) abi_layout({signature = (vector<16xbf16>, vector<16xbf16>) -> (vector<8xf32>)}) @bf16_dot2_zero_256(%lhs: reg<x86.ymm>, %rhs: reg<x86.ymm>) -> (reg<x86.ymm>) asm {
  %c0 = vxorps.zero.ymm
  %9 = copy %c0 : reg<x86.ymm> -> reg<x86.ymm>
  %dot = avx512_bf16.vdpbf16ps.ymm %9, %lhs, %rhs
  return %dot
}

// ====

func.def @supported_f32_zero_widths() -> (f32, vector<4xf32>, vector<8xf32>, vector<16xf32>) {
  %scalar = scalar.constant 0.0 : f32
  %c0x4 = vector.splatf 0.0 : vector<4xf32>
  %c0x8 = vector.splatf 0.0 : vector<8xf32>
  %c0x16 = vector.splatf 0.0 : vector<16xf32>
  func.return %scalar, %c0x4, %c0x8, %c0x16 : f32, vector<4xf32>, vector<8xf32>, vector<16xf32>
}

// ----
low.func.def target<x86.avx512_features.core> abi(object_function) abi_layout({signature = () -> (f32, vector<4xf32>, vector<8xf32>, vector<16xf32>)}) @supported_f32_zero_widths() -> (reg<x86.xmm>, reg<x86.xmm>, reg<x86.ymm>, reg<x86.zmm>) asm {
  %scalar = vxorps.zero.xmm
  %c0x8 = vxorps.zero.ymm
  %c0x16 = vxorps.zero
  return %scalar, %scalar, %c0x8, %c0x16
}

// ====

func.def @f32x4_constant_payloads() -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) {
  %signed_payload = vector.splatf -0.0 : vector<4xf32>
  %fraction = vector.splatf -1.1000000000000001 : vector<4xf32>
  %subnormal = vector.splatf 1.4012984643248171e-45 : vector<4xf32>
  %normal = vector.splatf 1.1754943508222875e-38 : vector<4xf32>
  %positive_infinity = vector.splatf inf : vector<4xf32>
  %negative_infinity = vector.splatf -inf : vector<4xf32>
  %nan = vector.splatf nan : vector<4xf32>
  func.return %signed_payload, %fraction, %subnormal, %normal, %positive_infinity, %negative_infinity, %nan : vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>
}

// ----
low.func.def target<x86.avx512_features.core> abi(object_function) abi_layout({signature = () -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>)}) @f32x4_constant_payloads() -> (reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>) asm {
  %21 = mov.imm32 -2147483648
  %signed_payload = vpbroadcastd.xmm %21
  %23 = mov.imm32 -1081291571
  %fraction = vpbroadcastd.xmm %23
  %25 = mov.imm32 1
  %subnormal = vpbroadcastd.xmm %25
  %27 = mov.imm32 8388608
  %normal = vpbroadcastd.xmm %27
  %29 = mov.imm32 2139095040
  %positive_infinity = vpbroadcastd.xmm %29
  %31 = mov.imm32 -8388608
  %negative_infinity = vpbroadcastd.xmm %31
  %33 = mov.imm32 2143289344
  %nan = vpbroadcastd.xmm %33
  return %signed_payload, %fraction, %subnormal, %normal, %positive_infinity, %negative_infinity, %nan
}

// ====

func.def @folded_f32_splat_widths() -> (vector<4xf32>, vector<8xf32>, vector<16xf32>) {
  %scalar = scalar.constant 1.0000000596046448 : f32
  %x4 = vector.splat %scalar : vector<4xf32>
  %x8 = vector.splat %scalar : vector<8xf32>
  %x16 = vector.splat %scalar : vector<16xf32>
  func.return %x4, %x8, %x16 : vector<4xf32>, vector<8xf32>, vector<16xf32>
}

// ----
low.func.def target<x86.avx512_features.core> abi(object_function) abi_layout({signature = () -> (vector<4xf32>, vector<8xf32>, vector<16xf32>)}) @folded_f32_splat_widths() -> (reg<x86.xmm>, reg<x86.ymm>, reg<x86.zmm>) asm {
  %13 = mov.imm32 1065353216
  %x4 = vpbroadcastd.xmm %13
  %x8 = avx512.vpbroadcastd.ymm %13
  %x16 = vpbroadcastd %13
  return %x4, %x8, %x16
}

// ====

func.def @bf16_dot2_negative_zero_256(%lhs: vector<16xbf16>, %rhs: vector<16xbf16>) -> (vector<8xf32>) {
  %cn0 = vector.splatf -0.0 : vector<8xf32>
  %dot = vector.dot2f %lhs, %rhs, %cn0 : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
  func.return %dot : vector<8xf32>
}

// ----
low.func.def target<x86.avx512_features.core> abi(object_function) abi_layout({signature = (vector<16xbf16>, vector<16xbf16>) -> (vector<8xf32>)}) @bf16_dot2_negative_zero_256(%lhs: reg<x86.ymm>, %rhs: reg<x86.ymm>) -> (reg<x86.ymm>) asm {
  %8 = mov.imm32 -2147483648
  %cn0 = avx512.vpbroadcastd.ymm %8
  %10 = copy %cn0 : reg<x86.ymm> -> reg<x86.ymm>
  %dot = avx512_bf16.vdpbf16ps.ymm %10, %lhs, %rhs
  return %dot
}

// ====

func.def @f32x16_negative_zero() -> (vector<16xf32>) {
  %cn0 = vector.splatf -0.0 : vector<16xf32>
  func.return %cn0 : vector<16xf32>
}

// ----
low.func.def target<x86.avx512_features.core> abi(object_function) abi_layout({signature = () -> (vector<16xf32>)}) @f32x16_negative_zero() -> (reg<x86.zmm>) asm {
  %3 = mov.imm32 -2147483648
  %cn0 = vpbroadcastd %3
  return %cn0
}
