// RUN: emit source-low target=x86:avx2 output=low

func.def @avx2_low_f32(%a: vector<2xf32>, %b: vector<2xf32>, %c: vector<2xf32>) -> (vector<2xf32>) {
  %product = vector.mulf<contract> %a, %b : vector<2xf32>
  %result = vector.addf<contract> %product, %c : vector<2xf32>
  func.return %result : vector<2xf32>
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) abi_layout({signature = (vector<2xf32>, vector<2xf32>, vector<2xf32>) -> (vector<2xf32>)}) @avx2_low_f32(%a: reg<x86.xmm>, %b: reg<x86.xmm>, %c: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %11 = copy %c : reg<x86.xmm> -> reg<x86.xmm>
  %result = vfmadd231ps.xmm %11, %a, %b
  return %result
}

