x86.target<avx2> @target

func.def target(@target) @word_right_shift_constants(%value: i32) -> (i32, i32, i32, i32, i32, i32, i32) {
  %identity_count = scalar.constant 0 : i32
  %single_bit = scalar.constant 1 : i32
  %middle = scalar.constant 16 : i32
  %last = scalar.constant 31 : i32
  %unchanged = scalar.shrui %value, %identity_count : i32
  %logical_one = scalar.shrui %value, %single_bit : i32
  %signed_one = scalar.shrsi %value, %single_bit : i32
  %logical_middle = scalar.shrui %value, %middle : i32
  %signed_middle = scalar.shrsi %value, %middle : i32
  %logical_last = scalar.shrui %value, %last : i32
  %signed_last = scalar.shrsi %value, %last : i32
  func.return %unchanged, %logical_one, %signed_one, %logical_middle, %signed_middle, %logical_last, %signed_last : i32, i32, i32, i32, i32, i32, i32
}

// ----
low.func.def target<x86.avx2.core>(@target) abi(object_function) @word_right_shift_constants(%value: reg<x86.gpr32>) -> (reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr32>) asm {
  %27 = copy %value : reg<x86.gpr32> -> reg<x86.gpr32>
  %logical_one = shr.imm.gpr32 %27 {shift = 1}
  %29 = copy %value : reg<x86.gpr32> -> reg<x86.gpr32>
  %signed_one = sar.imm.gpr32 %29 {shift = 1}
  %31 = copy %value : reg<x86.gpr32> -> reg<x86.gpr32>
  %logical_middle = shr.imm.gpr32 %31 {shift = 16}
  %33 = copy %value : reg<x86.gpr32> -> reg<x86.gpr32>
  %signed_middle = sar.imm.gpr32 %33 {shift = 16}
  %35 = copy %value : reg<x86.gpr32> -> reg<x86.gpr32>
  %logical_last = shr.imm.gpr32 %35 {shift = 31}
  %37 = copy %value : reg<x86.gpr32> -> reg<x86.gpr32>
  %signed_last = sar.imm.gpr32 %37 {shift = 31}
  return %value, %logical_one, %signed_one, %logical_middle, %signed_middle, %logical_last, %signed_last
}

