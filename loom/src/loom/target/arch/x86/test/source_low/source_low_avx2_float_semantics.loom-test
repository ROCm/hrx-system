// RUN: emit source-low output=low

// Sign operations are exact bit-field transformations for every IEEE payload
// width. The four chains exercise the shared 8/16/32/64-bit legalization.
x86.target<avx2> @target

func.def target(@target) @float_sign_families(%f8_magnitude: vector<16xf8E4M3>, %f8_sign: vector<16xf8E4M3>, %bf16_magnitude: vector<16xbf16>, %bf16_sign: vector<16xbf16>, %f32_magnitude: vector<4xf32>, %f32_sign: vector<4xf32>, %f64_magnitude: vector<4xf64>, %f64_sign: vector<4xf64>) -> (vector<16xf8E4M3>, vector<16xbf16>, vector<4xf32>, vector<4xf64>) {
  %f8_abs = vector.absf %f8_magnitude : vector<16xf8E4M3>
  %f8_neg = vector.negf %f8_abs : vector<16xf8E4M3>
  %f8_result = vector.copysignf %f8_neg, %f8_sign : vector<16xf8E4M3>
  %bf16_abs = vector.absf %bf16_magnitude : vector<16xbf16>
  %bf16_neg = vector.negf %bf16_abs : vector<16xbf16>
  %bf16_result = vector.copysignf %bf16_neg, %bf16_sign : vector<16xbf16>
  %f32_abs = vector.absf %f32_magnitude : vector<4xf32>
  %f32_neg = vector.negf %f32_abs : vector<4xf32>
  %f32_result = vector.copysignf %f32_neg, %f32_sign : vector<4xf32>
  %f64_abs = vector.absf %f64_magnitude : vector<4xf64>
  %f64_neg = vector.negf %f64_abs : vector<4xf64>
  %f64_result = vector.copysignf %f64_neg, %f64_sign : vector<4xf64>
  func.return %f8_result, %bf16_result, %f32_result, %f64_result : vector<16xf8E4M3>, vector<16xbf16>, vector<4xf32>, vector<4xf64>
}

// ----
low.func.def target<x86.avx2.core>(@target) abi(object_function) abi_layout({signature = (vector<16xf8E4M3>, vector<16xf8E4M3>, vector<16xbf16>, vector<16xbf16>, vector<4xf32>, vector<4xf32>, vector<4xf64>, vector<4xf64>) -> (vector<16xf8E4M3>, vector<16xbf16>, vector<4xf32>, vector<4xf64>)}) @float_sign_families(%f8_magnitude: reg<x86.xmm>, %f8_sign: reg<x86.xmm>, %bf16_magnitude: reg<x86.ymm>, %bf16_sign: reg<x86.ymm>, %f32_magnitude: reg<x86.xmm>, %f32_sign: reg<x86.xmm>, %f64_magnitude: reg<x86.ymm>, %f64_sign: reg<x86.ymm>) -> (reg<x86.xmm>, reg<x86.ymm>, reg<x86.xmm>, reg<x86.ymm>) asm {
  %116 = mov.imm32 127
  %117 = vmovd.xmm.gpr32 %116
  %118 = vpbroadcastb.xmm %117
  %119 = vpand.xmm %f8_magnitude, %118
  %120 = mov.imm32 -128
  %121 = vmovd.xmm.gpr32 %120
  %122 = vpbroadcastb.xmm %121
  %123 = vpxor.xmm %119, %122
  %124 = vpand.xmm %123, %118
  %125 = vpand.xmm %f8_sign, %122
  %f8_result = vpor.xmm %124, %125
  %127 = mov.imm32 32767
  %128 = vmovd.xmm.gpr32 %127
  %129 = vpbroadcastw.ymm %128
  %130 = vpand.ymm %bf16_magnitude, %129
  %131 = mov.imm32 -32768
  %132 = vmovd.xmm.gpr32 %131
  %133 = vpbroadcastw.ymm %132
  %134 = vpxor.ymm %130, %133
  %135 = vpand.ymm %134, %129
  %136 = vpand.ymm %bf16_sign, %133
  %bf16_result = vpor.ymm %135, %136
  %138 = mov.imm32 2147483647
  %139 = vmovd.xmm.gpr32 %138
  %140 = avx2.vpbroadcastd.xmm %139
  %141 = vpand.xmm %f32_magnitude, %140
  %142 = mov.imm32 -2147483648
  %143 = vmovd.xmm.gpr32 %142
  %144 = avx2.vpbroadcastd.xmm %143
  %145 = vpxor.xmm %141, %144
  %146 = vpand.xmm %145, %140
  %147 = vpand.xmm %f32_sign, %144
  %f32_result = vpor.xmm %146, %147
  %149 = mov.imm64 9223372036854775807
  %150 = vmovq.xmm.gpr64 %149
  %151 = vpbroadcastq.ymm %150
  %152 = vpand.ymm %f64_magnitude, %151
  %153 = mov.imm64 -9223372036854775808
  %154 = vmovq.xmm.gpr64 %153
  %155 = vpbroadcastq.ymm %154
  %156 = vpxor.ymm %152, %155
  %157 = vpand.ymm %156, %151
  %158 = vpand.ymm %f64_sign, %155
  %f64_result = vpor.ymm %157, %158
  return %f8_result, %bf16_result, %f32_result, %f64_result
}

// ====

// Extrema use ordered comparison, an OR/AND tie path for signed zero, and
// explicit NaN selection. This preserves all four Loom semantic contracts.
x86.target<avx2> @target

func.def target(@target) @float_extrema_families(%f32_lhs: vector<4xf32>, %f32_rhs: vector<4xf32>, %f64_lhs: vector<4xf64>, %f64_rhs: vector<4xf64>) -> (vector<4xf32>, vector<4xf32>, vector<4xf64>, vector<4xf64>) {
  %f32_minimum = vector.minimumf %f32_lhs, %f32_rhs : vector<4xf32>
  %f32_minnum = vector.minnumf %f32_lhs, %f32_rhs : vector<4xf32>
  %f64_maximum = vector.maximumf %f64_lhs, %f64_rhs : vector<4xf64>
  %f64_maxnum = vector.maxnumf %f64_lhs, %f64_rhs : vector<4xf64>
  func.return %f32_minimum, %f32_minnum, %f64_maximum, %f64_maxnum : vector<4xf32>, vector<4xf32>, vector<4xf64>, vector<4xf64>
}

// ----
low.func.def target<x86.avx2.core>(@target) abi(object_function) abi_layout({signature = (vector<4xf32>, vector<4xf32>, vector<4xf64>, vector<4xf64>) -> (vector<4xf32>, vector<4xf32>, vector<4xf64>, vector<4xf64>)}) @float_extrema_families(%f32_lhs: reg<x86.xmm>, %f32_rhs: reg<x86.xmm>, %f64_lhs: reg<x86.ymm>, %f64_rhs: reg<x86.ymm>) -> (reg<x86.xmm>, reg<x86.xmm>, reg<x86.ymm>, reg<x86.ymm>) asm {
  %20 = avx2.vcmpps.xmm %f32_lhs, %f32_rhs, 17
  %21 = vpblendvb.xmm %f32_rhs, %f32_lhs, %20
  %22 = avx2.vcmpps.xmm %f32_lhs, %f32_rhs, 0
  %23 = vpor.xmm %f32_lhs, %f32_rhs
  %24 = vpblendvb.xmm %21, %23, %22
  %25 = avx2.vcmpps.xmm %f32_lhs, %f32_lhs, 3
  %26 = vpblendvb.xmm %24, %f32_lhs, %25
  %27 = avx2.vcmpps.xmm %f32_rhs, %f32_rhs, 3
  %f32_minimum = vpblendvb.xmm %26, %f32_rhs, %27
  %35 = vpblendvb.xmm %24, %f32_rhs, %25
  %f32_minnum = vpblendvb.xmm %35, %f32_lhs, %27
  %38 = avx2.vcmppd.ymm %f64_lhs, %f64_rhs, 30
  %39 = vpblendvb.ymm %f64_rhs, %f64_lhs, %38
  %40 = avx2.vcmppd.ymm %f64_lhs, %f64_rhs, 0
  %41 = vpand.ymm %f64_lhs, %f64_rhs
  %42 = vpblendvb.ymm %39, %41, %40
  %43 = avx2.vcmppd.ymm %f64_lhs, %f64_lhs, 3
  %44 = vpblendvb.ymm %42, %f64_lhs, %43
  %45 = avx2.vcmppd.ymm %f64_rhs, %f64_rhs, 3
  %f64_maximum = vpblendvb.ymm %44, %f64_rhs, %45
  %53 = vpblendvb.ymm %42, %f64_rhs, %43
  %f64_maxnum = vpblendvb.ymm %53, %f64_lhs, %45
  return %f32_minimum, %f32_minnum, %f64_maximum, %f64_maxnum
}

// ====

// Scalar extrema reuse the same IEEE recipe as packed values. The two widths
// and NaN policies share one target contract implementation.
x86.target<avx2> @target

func.def target(@target) @scalar_float_extrema(%f32_lhs: f32, %f32_rhs: f32, %f64_lhs: f64, %f64_rhs: f64) -> (f32, f32, f64, f64) {
  %f32_minimum = scalar.minimumf %f32_lhs, %f32_rhs : f32
  %f32_maxnum = scalar.maxnumf %f32_lhs, %f32_rhs : f32
  %f64_maximum = scalar.maximumf %f64_lhs, %f64_rhs : f64
  %f64_minnum = scalar.minnumf %f64_lhs, %f64_rhs : f64
  func.return %f32_minimum, %f32_maxnum, %f64_maximum, %f64_minnum : f32, f32, f64, f64
}

// ----
low.func.def target<x86.avx2.core>(@target) abi(object_function) abi_layout({signature = (f32, f32, f64, f64) -> (f32, f32, f64, f64)}) @scalar_float_extrema(%f32_lhs: reg<x86.xmm>, %f32_rhs: reg<x86.xmm>, %f64_lhs: reg<x86.xmm>, %f64_rhs: reg<x86.xmm>) -> (reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>) asm {
  %20 = avx2.vcmpps.xmm %f32_lhs, %f32_rhs, 17
  %21 = vpblendvb.xmm %f32_rhs, %f32_lhs, %20
  %22 = avx2.vcmpps.xmm %f32_lhs, %f32_rhs, 0
  %23 = vpor.xmm %f32_lhs, %f32_rhs
  %24 = vpblendvb.xmm %21, %23, %22
  %25 = avx2.vcmpps.xmm %f32_lhs, %f32_lhs, 3
  %26 = vpblendvb.xmm %24, %f32_lhs, %25
  %27 = avx2.vcmpps.xmm %f32_rhs, %f32_rhs, 3
  %f32_minimum = vpblendvb.xmm %26, %f32_rhs, %27
  %29 = avx2.vcmpps.xmm %f32_lhs, %f32_rhs, 30
  %30 = vpblendvb.xmm %f32_rhs, %f32_lhs, %29
  %32 = vpand.xmm %f32_lhs, %f32_rhs
  %33 = vpblendvb.xmm %30, %32, %22
  %35 = vpblendvb.xmm %33, %f32_rhs, %25
  %f32_maxnum = vpblendvb.xmm %35, %f32_lhs, %27
  %38 = avx2.vcmppd.xmm %f64_lhs, %f64_rhs, 30
  %39 = vpblendvb.xmm %f64_rhs, %f64_lhs, %38
  %40 = avx2.vcmppd.xmm %f64_lhs, %f64_rhs, 0
  %41 = vpand.xmm %f64_lhs, %f64_rhs
  %42 = vpblendvb.xmm %39, %41, %40
  %43 = avx2.vcmppd.xmm %f64_lhs, %f64_lhs, 3
  %44 = vpblendvb.xmm %42, %f64_lhs, %43
  %45 = avx2.vcmppd.xmm %f64_rhs, %f64_rhs, 3
  %f64_maximum = vpblendvb.xmm %44, %f64_rhs, %45
  %47 = avx2.vcmppd.xmm %f64_lhs, %f64_rhs, 17
  %48 = vpblendvb.xmm %f64_rhs, %f64_lhs, %47
  %50 = vpor.xmm %f64_lhs, %f64_rhs
  %51 = vpblendvb.xmm %48, %50, %40
  %53 = vpblendvb.xmm %51, %f64_rhs, %43
  %f64_minnum = vpblendvb.xmm %53, %f64_lhs, %45
  return %f32_minimum, %f32_maxnum, %f64_maximum, %f64_minnum
}

// ====

// With NaNs and signed zero differences disabled, native x86 MIN/MAX exactly
// implement all four source extrema semantics.
x86.target<avx2> @target

func.def target(@target) @fast_float_extrema(%f32_lhs: vector<8xf32>, %f32_rhs: vector<8xf32>, %f64_lhs: f64, %f64_rhs: f64) -> (vector<8xf32>, f64) {
  %f32 = vector.minnumf<nnan|nsz> %f32_lhs, %f32_rhs : vector<8xf32>
  %f64 = scalar.maximumf<nnan|nsz> %f64_lhs, %f64_rhs : f64
  func.return %f32, %f64 : vector<8xf32>, f64
}

// ----
low.func.def target<x86.avx2.core>(@target) abi(object_function) abi_layout({signature = (vector<8xf32>, vector<8xf32>, f64, f64) -> (vector<8xf32>, f64)}) @fast_float_extrema(%f32_lhs: reg<x86.ymm>, %f32_rhs: reg<x86.ymm>, %f64_lhs: reg<x86.xmm>, %f64_rhs: reg<x86.xmm>) -> (reg<x86.ymm>, reg<x86.xmm>) asm {
  %f32 = vminps.ymm %f32_lhs, %f32_rhs
  %f64 = vmaxsd.xmm %f64_lhs, %f64_rhs
  return %f32, %f64
}

// ====

x86.target<avx2> @target

func.def target(@target) @subnative_float_extrema(%f32_lhs: vector<2xf32>, %f32_rhs: vector<2xf32>, %f64_lhs: vector<1xf64>, %f64_rhs: vector<1xf64>) -> (vector<2xf32>, vector<2xf32>, vector<1xf64>, vector<1xf64>) {
  %f32_exact = vector.minimumf %f32_lhs, %f32_rhs : vector<2xf32>
  %f32_fast = vector.maxnumf<nnan|nsz> %f32_lhs, %f32_rhs : vector<2xf32>
  %f64_exact = vector.maximumf %f64_lhs, %f64_rhs : vector<1xf64>
  %f64_fast = vector.minnumf<nnan|nsz> %f64_lhs, %f64_rhs : vector<1xf64>
  func.return %f32_exact, %f32_fast, %f64_exact, %f64_fast : vector<2xf32>, vector<2xf32>, vector<1xf64>, vector<1xf64>
}

// ----
low.func.def target<x86.avx2.core>(@target) abi(object_function) abi_layout({signature = (vector<2xf32>, vector<2xf32>, vector<1xf64>, vector<1xf64>) -> (vector<2xf32>, vector<2xf32>, vector<1xf64>, vector<1xf64>)}) @subnative_float_extrema(%f32_lhs: reg<x86.xmm>, %f32_rhs: reg<x86.xmm>, %f64_lhs: reg<x86.xmm>, %f64_rhs: reg<x86.xmm>) -> (reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>) asm {
  %20 = avx2.vcmpps.xmm %f32_lhs, %f32_rhs, 17
  %21 = vpblendvb.xmm %f32_rhs, %f32_lhs, %20
  %22 = avx2.vcmpps.xmm %f32_lhs, %f32_rhs, 0
  %23 = vpor.xmm %f32_lhs, %f32_rhs
  %24 = vpblendvb.xmm %21, %23, %22
  %25 = avx2.vcmpps.xmm %f32_lhs, %f32_lhs, 3
  %26 = vpblendvb.xmm %24, %f32_lhs, %25
  %27 = avx2.vcmpps.xmm %f32_rhs, %f32_rhs, 3
  %f32_exact = vpblendvb.xmm %26, %f32_rhs, %27
  %f32_fast = vmaxps.xmm %f32_lhs, %f32_rhs
  %30 = avx2.vcmppd.xmm %f64_lhs, %f64_rhs, 30
  %31 = vpblendvb.xmm %f64_rhs, %f64_lhs, %30
  %32 = avx2.vcmppd.xmm %f64_lhs, %f64_rhs, 0
  %33 = vpand.xmm %f64_lhs, %f64_rhs
  %34 = vpblendvb.xmm %31, %33, %32
  %35 = avx2.vcmppd.xmm %f64_lhs, %f64_lhs, 3
  %36 = vpblendvb.xmm %34, %f64_lhs, %35
  %37 = avx2.vcmppd.xmm %f64_rhs, %f64_rhs, 3
  %f64_exact = vpblendvb.xmm %36, %f64_rhs, %37
  %f64_fast = vminpd.xmm %f64_lhs, %f64_rhs
  return %f32_exact, %f32_fast, %f64_exact, %f64_fast
}
