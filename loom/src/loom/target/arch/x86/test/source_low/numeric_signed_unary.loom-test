low.func.def target<x86.scalar.core> abi(object_function) abi_layout({signature = (i16) -> (i16, i16, i16)}) @signed_unary_i16(%input: reg<x86.gpr32>) -> (reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr32>) asm {
  %26 = movsx.i16.gpr32 %input
  %27 = copy %26 : reg<x86.gpr32> -> reg<x86.gpr32>
  %negative = neg.gpr32 %27
  %29 = copy %26 : reg<x86.gpr32> -> reg<x86.gpr32>
  %30 = sar.imm.gpr32 %29 {shift = 31}
  %31 = copy %26 : reg<x86.gpr32> -> reg<x86.gpr32>
  %32 = xor.gpr32 %31, %30
  %absolute = sub.gpr32 %32, %30
  %36 = cmp.imm.gpr32 %26, 0, "ne"
  %37 = copy %30 : reg<x86.gpr32> -> reg<x86.gpr32>
  %sign = or.gpr32 %37, %36
  return %negative, %absolute, %sign
}

