func.def @signed_unary_i32(%input: i32) -> (i32, i32, i32) {
  %negative = scalar.negi %input : i32
  %absolute = scalar.absi %input : i32
  %sign = scalar.signi %input : i32
  func.return %negative, %absolute, %sign : i32, i32, i32
