  %35 = copy %30 : reg<x86.gpr32> -> reg<x86.gpr32>
  %36 = xor.gpr32 %35, %34
  %37 = copy %36 : reg<x86.gpr32> -> reg<x86.gpr32>
  %absolute = sub.gpr32 %37, %34
  %39 = cmp.imm.gpr32 %30, 0, "ne"
  %40 = copy %34 : reg<x86.gpr32> -> reg<x86.gpr32>
