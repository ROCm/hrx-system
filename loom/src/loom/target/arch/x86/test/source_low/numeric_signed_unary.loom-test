// ----
low.func.def target<x86.scalar.core> abi(object_function) @signed_unary_i32(%input: reg<x86.gpr32>) -> (reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr32>) asm {
  %21 = copy %input : reg<x86.gpr32> -> reg<x86.gpr32>
  %negative = neg.gpr32 %21
  %23 = copy %input : reg<x86.gpr32> -> reg<x86.gpr32>
  %24 = sar.imm.gpr32 %23 {shift = 31}
  %25 = copy %input : reg<x86.gpr32> -> reg<x86.gpr32>
  %26 = xor.gpr32 %25, %24
  %27 = copy %26 : reg<x86.gpr32> -> reg<x86.gpr32>
  %absolute = sub.gpr32 %27, %24
  %29 = cmp.imm.gpr32 %input, 0, "ne"
  %30 = copy %24 : reg<x86.gpr32> -> reg<x86.gpr32>
  %sign = or.gpr32 %30, %29
  return %negative, %absolute, %sign
}

// ====

func.def @signed_unary_i64(%input: i64) -> (i64, i64, i64) {
  %negative = scalar.negi %input : i64
  %absolute = scalar.absi %input : i64
  %sign = scalar.signi %input : i64
  func.return %negative, %absolute, %sign : i64, i64, i64
}

// ----
low.func.def target<x86.scalar.core> abi(object_function) @signed_unary_i64(%input: reg<x86.gpr64>) -> (reg<x86.gpr64>, reg<x86.gpr64>, reg<x86.gpr64>) asm {
  %21 = copy %input : reg<x86.gpr64> -> reg<x86.gpr64>
  %negative = neg.gpr64 %21
  %23 = copy %input : reg<x86.gpr64> -> reg<x86.gpr64>
  %24 = sar.imm.gpr64 %23 {shift = 63}
  %25 = copy %input : reg<x86.gpr64> -> reg<x86.gpr64>
  %26 = xor.gpr64 %25, %24
  %27 = copy %26 : reg<x86.gpr64> -> reg<x86.gpr64>
  %absolute = sub.gpr64 %27, %24
  %29 = cmp.imm.gpr64 %input, 0, "ne"
  %30 = movzx.gpr64.gpr32 %29
  %31 = copy %24 : reg<x86.gpr64> -> reg<x86.gpr64>
  %sign = or.gpr64 %31, %30
  return %negative, %absolute, %sign
}
