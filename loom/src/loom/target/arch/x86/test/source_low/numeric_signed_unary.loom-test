// RUN: emit source-low target=x86:scalar output=low

func.def @signed_unary_i1(%input: i1) -> (i1, i1, i1) {
  %negative = scalar.negi %input : i1
  %absolute = scalar.absi %input : i1
  %sign = scalar.signi %input : i1
  func.return %negative, %absolute, %sign : i1, i1, i1
}

// ----
low.func.def target<x86.scalar.core> abi(object_function) abi_layout({signature = (i1) -> (i1, i1, i1)}) @signed_unary_i1(%input: reg<x86.gpr32>) -> (reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr32>) asm {
  return %input, %input, %input
}

// ====

func.def @signed_unary_i8(%input: i8) -> (i8, i8, i8) {
  %negative = scalar.negi %input : i8
  %absolute = scalar.absi %input : i8
  %sign = scalar.signi %input : i8
  func.return %negative, %absolute, %sign : i8, i8, i8
}

// ----
low.func.def target<x86.scalar.core> abi(object_function) abi_layout({signature = (i8) -> (i8, i8, i8)}) @signed_unary_i8(%input: reg<x86.gpr32>) -> (reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr32>) asm {
  %26 = movsx.i8.gpr32 %input
  %27 = copy %26 : reg<x86.gpr32> -> reg<x86.gpr32>
  %negative = neg.gpr32 %27
  %29 = copy %26 : reg<x86.gpr32> -> reg<x86.gpr32>
  %30 = sar.imm.gpr32 %29 {shift = 31}
  %31 = copy %26 : reg<x86.gpr32> -> reg<x86.gpr32>
  %32 = xor.gpr32 %31, %30
  %absolute = sub.gpr32 %32, %30
  %36 = cmp.imm.gpr32 %26, 0, "ne"
  %37 = copy %30 : reg<x86.gpr32> -> reg<x86.gpr32>
  %sign = or.gpr32 %37, %36
  return %negative, %absolute, %sign
}

