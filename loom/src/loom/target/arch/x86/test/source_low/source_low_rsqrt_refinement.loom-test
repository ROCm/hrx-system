// RUN: emit source-low output=low

// AVX2 refines a low-XMM F32 estimate once and uses a lane-wise bit-range
// guard to preserve the raw result outside the positive-normal-finite domain.
x86.target<avx2> @target

func.def target(@target) @avx2_low_rsqrt_refinement(%value: vector<2xf32>) -> (vector<2xf32>) {
  %result = vector.rsqrtf<afn> %value : vector<2xf32>
  func.return %result : vector<2xf32>
}

// ----
low.func.def target<x86.avx2.core>(@target) abi(object_function) abi_layout({signature = (vector<2xf32>) -> (vector<2xf32>)}) @avx2_low_rsqrt_refinement(%value: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %23 = mov.imm32 1056964608
  %24 = vmovd.xmm.gpr32 %23
  %25 = vbroadcastss.xmm %24
  %26 = mov.imm32 1069547520
  %27 = vmovd.xmm.gpr32 %26
  %28 = vbroadcastss.xmm %27
  %29 = vrsqrtps.xmm %value
  %30 = vmulps.xmm %value, %29
  %31 = vmulps.xmm %30, %29
  %32 = vmulps.xmm %25, %31
  %33 = vsubps.xmm %28, %32
  %34 = vmulps.xmm %29, %33
  %35 = mov.imm32 8388608
  %36 = vmovd.xmm.gpr32 %35
  %37 = avx2.vpbroadcastd.xmm %36
  %38 = mov.imm32 2130706431
  %39 = vmovd.xmm.gpr32 %38
  %40 = avx2.vpbroadcastd.xmm %39
  %41 = vpsubd.xmm %value, %37
  %42 = vpminud.xmm %41, %40
  %43 = vpcmpeqd.xmm %42, %41
  %result = vpblendvb.xmm %29, %34, %43
  return %result
}

// ====
// RUN: emit source-low output=low

// AVX-512 refines an F64 estimate twice. The one-element vector remains
// lane-wise through the recipe and lowers through the compact XMM carrier.
x86.target<avx512> @target

func.def target(@target) @avx512_single_rsqrt_refinement(%value: vector<1xf64>) -> (vector<1xf64>) {
  %result = vector.rsqrtf<afn> %value : vector<1xf64>
  func.return %result : vector<1xf64>
}

// ----
low.func.def target<x86.avx512.core>(@target) abi(object_function) abi_layout({signature = (vector<1xf64>) -> (vector<1xf64>)}) @avx512_single_rsqrt_refinement(%value: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %37 = mov.imm64 4602678819172646912
  %38 = vmovq.xmm.gpr64 %37
  %39 = vmovddup.xmm %38
  %40 = mov.imm64 4609434218613702656
  %41 = vmovq.xmm.gpr64 %40
  %42 = vmovddup.xmm %41
  %43 = vrsqrt14pd.xmm %value
  %44 = vmulpd.xmm %value, %43
  %45 = vmulpd.xmm %44, %43
  %46 = vmulpd.xmm %39, %45
  %47 = vsubpd.xmm %42, %46
  %48 = vmulpd.xmm %43, %47
  %49 = vmulpd.xmm %value, %48
  %50 = vmulpd.xmm %49, %48
  %51 = vmulpd.xmm %39, %50
  %52 = vsubpd.xmm %42, %51
  %53 = vmulpd.xmm %48, %52
  %54 = mov.imm64 9214364837600034815
  %55 = vpermilpd.xmm %value, 0
  %56 = vmovq.gpr64.xmm %55
  %57 = mov.imm64 -4503599627370496
  %58 = copy %56 : reg<x86.gpr64> -> reg<x86.gpr64>
  %59 = add.gpr64 %58, %57
  %60 = cmp.gpr64 %59, %54, "ule"
  %61 = mov.imm32 0
  %62 = sub.gpr32 %61, %60
  %63 = vmovd.xmm.gpr32 %62
  %64 = avx2.vpbroadcastd.xmm %63
  %result = vpblendvb.xmm %43, %53, %64
  return %result
}

// ====
// RUN: emit source-low output=low

// Facts retained through scalar selection and splat prove every lane is in the
// refinement domain, so no runtime domain guard remains.
x86.target<avx2> @target

func.def target(@target) @rsqrt_refinement_proven_domain(%condition: i1) -> (vector<8xf32>) {
  %positive_lower = scalar.constant 1.0 : f32
  %positive_upper = scalar.constant 4.0 : f32
  %scalar = scf.select %condition, %positive_lower, %positive_upper : f32
  %value = vector.splat %scalar : vector<8xf32>
  %result = vector.rsqrtf<afn> %value : vector<8xf32>
  func.return %result : vector<8xf32>
}

// ----
low.func.def target<x86.avx2.core>(@target) abi(object_function) abi_layout({signature = (i1) -> (vector<8xf32>)}) @rsqrt_refinement_proven_domain(%condition: reg<x86.gpr32>) -> (reg<x86.ymm>) asm {
  %19 = mov.imm32 1065353216
  %positive_lower = vmovd.xmm.gpr32 %19
  %21 = mov.imm32 1082130432
  %positive_upper = vmovd.xmm.gpr32 %21
  %23 = vmovd.xmm.gpr32 %condition
  %24 = vpsllq.xmm %23, 63
  %scalar = vblendvpd.xmm %positive_upper, %positive_lower, %24
  %value = vbroadcastss.ymm %scalar
  %27 = mov.imm32 1056964608
  %28 = vmovd.xmm.gpr32 %27
  %29 = vbroadcastss.ymm %28
  %30 = mov.imm32 1069547520
  %31 = vmovd.xmm.gpr32 %30
  %32 = vbroadcastss.ymm %31
  %33 = vrsqrtps.ymm %value
  %34 = vmulps.ymm %value, %33
  %35 = vmulps.ymm %34, %33
  %36 = vmulps.ymm %29, %35
  %37 = vsubps.ymm %32, %36
  %result = vmulps.ymm %33, %37
  return %result
}
