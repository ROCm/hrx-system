func.def @correlated_duplicate_rotation(%input: buffer, %count_input: index, %first_offset_input: offset, %second_offset_input: offset) -> (i32) {
  %count = index.assume %count_input [range(%count_input, 0, 257)] : index
  %first_offset = index.assume %first_offset_input [range(%first_offset_input, 0, 4092), mul(%first_offset_input, 4)] : offset
  %second_offset = index.assume %second_offset_input [range(%second_offset_input, 0, 4092), mul(%second_offset_input, 4)] : offset
  %storage = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %first_view = buffer.view %storage[%first_offset] : buffer -> view<1xi32>
  %second_view = buffer.view %storage[%second_offset] : buffer -> view<1xi32>
  %last_a_offset, %last_a_view, %last_a_duplicate, %last_b_offset, %last_b_view = scf.for %i = [%begin to %count step %step](%a_offset = %first_offset : offset, %a_view = %first_view : view<1xi32>, %a_duplicate = %first_view : view<1xi32>, %b_offset = %second_offset : offset, %b_view = %second_view : view<1xi32>) -> (offset, view<1xi32>, view<1xi32>, offset, view<1xi32>) {
    scf.yield %b_offset, %b_view, %b_view, %a_offset, %a_view : offset, view<1xi32>, view<1xi32>, offset, view<1xi32>
  }
  %last_a_offset_view = buffer.view %storage[%last_a_offset] : buffer -> view<1xi32>
  %a_offset_value = view.load %last_a_offset_view[0] : view<1xi32> -> i32
  %a_view_value = view.load %last_a_view[0] : view<1xi32> -> i32
  %a_duplicate_value = view.load %last_a_duplicate[0] : view<1xi32> -> i32
  %last_b_offset_view = buffer.view %storage[%last_b_offset] : buffer -> view<1xi32>
  %b_offset_value = view.load %last_b_offset_view[0] : view<1xi32> -> i32
  %b_view_value = view.load %last_b_view[0] : view<1xi32> -> i32
  %sum0 = scalar.addi %a_offset_value, %a_view_value : i32
  %sum1 = scalar.addi %sum0, %a_duplicate_value : i32
  %sum2 = scalar.addi %sum1, %b_offset_value : i32
  %sum3 = scalar.addi %sum2, %b_view_value : i32
  func.return %sum3 : i32
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) @correlated_duplicate_rotation(%storage: reg<x86.gpr64>, %count: reg<x86.gpr64>, %first_offset: reg<x86.gpr64>, %second_offset: reg<x86.gpr64>) -> (reg<x86.gpr32>) asm {
  %begin = mov.imm64 0
  low.br ^_bb1(%begin: reg<x86.gpr64>, %first_offset: reg<x86.gpr64>, %second_offset: reg<x86.gpr64>)
^_bb1(%i: reg<x86.gpr64>, %a_offset: reg<x86.gpr64>, %b_offset: reg<x86.gpr64>):
  %70 = cmp.slt.gpr64 %i, %count
  low.cond_br %70, ^_bb2, ^_bb3 : reg<x86.gpr32>
^_bb2:
  %71 = lea.disp %i {disp32 = 1}
  low.br ^_bb1(%71: reg<x86.gpr64>, %b_offset: reg<x86.gpr64>, %a_offset: reg<x86.gpr64>)
^_bb3:
  %a_offset_value = mov.load.indexed.gpr32 %storage, %a_offset {disp32 = 0, scale = 1}
  %b_offset_value = mov.load.indexed.gpr32 %storage, %b_offset {disp32 = 0, scale = 1}
  %74 = copy %a_offset_value : reg<x86.gpr32> -> reg<x86.gpr32>
  %sum0 = add.gpr32 %74, %a_offset_value
  %76 = copy %sum0 : reg<x86.gpr32> -> reg<x86.gpr32>
  %sum1 = add.gpr32 %76, %a_offset_value
  %78 = copy %sum1 : reg<x86.gpr32> -> reg<x86.gpr32>
  %sum2 = add.gpr32 %78, %b_offset_value
  %80 = copy %sum2 : reg<x86.gpr32> -> reg<x86.gpr32>
  %sum3 = add.gpr32 %80, %b_offset_value
  return %sum3
}

// ====

func.def @correlated_cfg_rotation(%input: buffer, %select: i1, %again: i1, %left_offset_input: offset, %right_offset_input: offset) -> (i32) {
  %left_offset = index.assume %left_offset_input [range(%left_offset_input, 0, 4092), mul(%left_offset_input, 4)] : offset
  %right_offset = index.assume %right_offset_input [range(%right_offset_input, 0, 4092), mul(%right_offset_input, 4)] : offset
  %storage = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  cfg.cond_br %select, ^left, ^right
^left:
  cfg.br ^loop(%left_offset: offset, %left_offset: offset)
^right:
  cfg.br ^loop(%right_offset: offset, %right_offset: offset)
^loop(%offset: offset, %duplicate_offset: offset):
  cfg.cond_br %again, ^body, ^exit
^body:
  cfg.br ^loop(%duplicate_offset: offset, %offset: offset)
^exit:
  %view = buffer.view %storage[%offset] : buffer -> view<1xi32>
  %duplicate_view = buffer.view %storage[%duplicate_offset] : buffer -> view<1xi32>
  %value = view.load %view[0] : view<1xi32> -> i32
  %duplicate_value = view.load %duplicate_view[0] : view<1xi32> -> i32
  %sum = scalar.addi %value, %duplicate_value : i32
  func.return %sum : i32
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) @correlated_cfg_rotation(%storage: reg<x86.gpr64>, %select: reg<x86.gpr32>, %again: reg<x86.gpr32>, %left_offset: reg<x86.gpr64>, %right_offset: reg<x86.gpr64>) -> (reg<x86.gpr32>) asm {
  low.cond_br %select, ^left, ^right : reg<x86.gpr32>
^left:
  low.br ^loop(%left_offset: reg<x86.gpr64>)
^right:
  low.br ^loop(%right_offset: reg<x86.gpr64>)
^loop(%offset: reg<x86.gpr64>):
  low.cond_br %again, ^body, ^exit : reg<x86.gpr32>
^body:
  low.br ^loop(%offset: reg<x86.gpr64>)
^exit:
  %value = mov.load.indexed.gpr32 %storage, %offset {disp32 = 0, scale = 1}
  %24 = copy %value : reg<x86.gpr32> -> reg<x86.gpr32>
  %sum = add.gpr32 %24, %value
  return %sum
}
