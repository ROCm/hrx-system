func.def public @rotate_buffer_views(%input: buffer, %count_input: index, %seed: i32) -> (i32) {
  %count = index.assume %count_input [range(%count_input, 0, 257)] : index
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %depth = scalar.constant 4 : i32
  %storage = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %offset0 = index.constant 0 : offset
  %slot0 = buffer.view %storage[%offset0] : buffer -> view<1xi32>
  %ordinal0 = scalar.constant 0 : i32
  %initial0 = scalar.addi %seed, %ordinal0 : i32
  view.store %initial0, %slot0[0] : i32, view<1xi32>
  %offset1 = index.constant 4 : offset
  %slot1 = buffer.view %storage[%offset1] : buffer -> view<1xi32>
  %ordinal1 = scalar.constant 1 : i32
  %initial1 = scalar.addi %seed, %ordinal1 : i32
  view.store %initial1, %slot1[0] : i32, view<1xi32>
  %offset2 = index.constant 8 : offset
  %slot2 = buffer.view %storage[%offset2] : buffer -> view<1xi32>
  %ordinal2 = scalar.constant 2 : i32
  %initial2 = scalar.addi %seed, %ordinal2 : i32
  view.store %initial2, %slot2[0] : i32, view<1xi32>
  %offset3 = index.constant 12 : offset
  %slot3 = buffer.view %storage[%offset3] : buffer -> view<1xi32>
  %ordinal3 = scalar.constant 3 : i32
  %initial3 = scalar.addi %seed, %ordinal3 : i32
  view.store %initial3, %slot3[0] : i32, view<1xi32>
  %unroll = index.constant 2 : index
  %last0, %last1, %last2, %last3 = scf.for %record = [%begin to %count step %step](%current0 = %slot0 : view<1xi32>, %current1 = %slot1 : view<1xi32>, %current2 = %slot2 : view<1xi32>, %current3 = %slot3 : view<1xi32>) -> (view<1xi32>, view<1xi32>, view<1xi32>, view<1xi32>) unroll(%unroll) {
    %number = index.cast %record : index to i32
    %future = scalar.addi %number, %depth : i32
    %value = scalar.addi %seed, %future : i32
    %refined = view.refine %current0 : view<1xi32> -> view<1xi32>
    view.store %value, %refined[0] : i32, view<1xi32>
    scf.yield %current1, %current2, %current3, %refined : view<1xi32>, view<1xi32>, view<1xi32>, view<1xi32>
  }
  %value0 = view.load %last0[0] : view<1xi32> -> i32
  func.return %value0 : i32
}

// ----
low.func.def public target<x86.avx2.core> abi(object_function) @rotate_buffer_views(%storage: reg<x86.gpr64>, %count: reg<x86.gpr64>, %seed: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  %begin = mov.imm64 0
  %depth = mov.imm32 4
  mov.store.gpr32 %seed, %storage {disp32 = 0}
  %offset1 = mov.imm64 4
  %ordinal1 = mov.imm32 1
  %112 = copy %seed : reg<x86.gpr32> -> reg<x86.gpr32>
  %initial1 = add.gpr32 %112, %ordinal1
  mov.store.gpr32 %initial1, %storage {disp32 = 4}
  %offset2 = mov.imm64 8
  %ordinal2 = mov.imm32 2
  %116 = copy %seed : reg<x86.gpr32> -> reg<x86.gpr32>
  %initial2 = add.gpr32 %116, %ordinal2
  mov.store.gpr32 %initial2, %storage {disp32 = 8}
  %offset3 = mov.imm64 12
  %ordinal3 = mov.imm32 3
  %120 = copy %seed : reg<x86.gpr32> -> reg<x86.gpr32>
  %initial3 = add.gpr32 %120, %ordinal3
  mov.store.gpr32 %initial3, %storage {disp32 = 12}
  low.br ^_bb1(%begin: reg<x86.gpr64>, %begin: reg<x86.gpr64>, %offset1: reg<x86.gpr64>, %offset2: reg<x86.gpr64>, %offset3: reg<x86.gpr64>)
^_bb1(%record: reg<x86.gpr64>, %current0_offset: reg<x86.gpr64>, %current1_offset: reg<x86.gpr64>, %current2_offset: reg<x86.gpr64>, %current3_offset: reg<x86.gpr64>):
  %122 = cmp.slt.gpr64 %record, %count
  low.cond_br %122, ^_bb2, ^_bb6 : reg<x86.gpr32>
^_bb2:
  %number = mov.trunc.gpr32.gpr64 %record
  %125 = copy %number : reg<x86.gpr32> -> reg<x86.gpr32>
  %126 = add.gpr32 %125, %seed
  %127 = copy %126 : reg<x86.gpr32> -> reg<x86.gpr32>
  %value = add.gpr32 %127, %depth
  mov.store.indexed.gpr32 %value, %storage, %current0_offset {disp32 = 0, scale = 1}
  %record_1 = lea.disp %record {disp32 = 1}
  %130 = cmp.slt.gpr64 %record_1, %count
  low.cond_br %130, ^_bb3, ^_bb4 : reg<x86.gpr32>
^_bb3:
  %number_1 = mov.trunc.gpr32.gpr64 %record_1
  %133 = copy %number_1 : reg<x86.gpr32> -> reg<x86.gpr32>
  %134 = add.gpr32 %133, %seed
  %135 = copy %134 : reg<x86.gpr32> -> reg<x86.gpr32>
  %value_1 = add.gpr32 %135, %depth
  mov.store.indexed.gpr32 %value_1, %storage, %current1_offset {disp32 = 0, scale = 1}
  low.br ^_bb5(%current2_offset: reg<x86.gpr64>, %current3_offset: reg<x86.gpr64>, %current0_offset: reg<x86.gpr64>, %current1_offset: reg<x86.gpr64>)
^_bb4:
  low.br ^_bb5(%current1_offset: reg<x86.gpr64>, %current2_offset: reg<x86.gpr64>, %current3_offset: reg<x86.gpr64>, %current0_offset: reg<x86.gpr64>)
^_bb5(%103: reg<x86.gpr64>, %104: reg<x86.gpr64>, %105: reg<x86.gpr64>, %106: reg<x86.gpr64>):
  %137 = lea.disp %record {disp32 = 2}
  low.br ^_bb1(%137: reg<x86.gpr64>, %103: reg<x86.gpr64>, %104: reg<x86.gpr64>, %105: reg<x86.gpr64>, %106: reg<x86.gpr64>)
^_bb6:
  %value0 = mov.load.indexed.gpr32 %storage, %current0_offset {disp32 = 0, scale = 1}
  return %value0
}

