x86.target<avx2> @target

func.def target(@target) @index_boundary_pairs(%input: index) -> (index, index, index, index) {
  %bounded = index.assume %input [range(%input, 0, 4294967295)] : index
  %power = index.constant 2147483648 : index
  %largest = index.constant 4294967295 : index
  %power_quotient = index.div %bounded, %power : index
  %power_remainder = index.rem %bounded, %power : index
  %large_quotient = index.div %bounded, %largest : index
  %large_remainder = index.rem %bounded, %largest : index
  func.return %power_quotient, %power_remainder, %large_quotient, %large_remainder : index, index, index, index
}

// ----
low.func.def target<x86.avx2.core>(@target) abi(object_function) @index_boundary_pairs(%bounded: reg<x86.gpr64>) -> (reg<x86.gpr64>, reg<x86.gpr64>, reg<x86.gpr64>, reg<x86.gpr64>) asm {
  %21 = copy %bounded : reg<x86.gpr64> -> reg<x86.gpr64>
  %power_quotient = shr.imm.gpr64 %21 {shift = 31}
  %23 = copy %bounded : reg<x86.gpr64> -> reg<x86.gpr64>
  %power_remainder = and.imm.gpr64 %23 {imm32 = 2147483647}
  %25 = mov.trunc.gpr32.gpr64 %bounded
  %26 = cmp.uge.imm.gpr32 %25, -1
  %large_quotient = movzx.gpr64.gpr32 %26
  %29 = copy %25 : reg<x86.gpr32> -> reg<x86.gpr32>
  %30 = sub.if_uge.imm.gpr32 %29, -1
  %large_remainder = movzx.gpr64.gpr32 %30
  return %power_quotient, %power_remainder, %large_quotient, %large_remainder
}
