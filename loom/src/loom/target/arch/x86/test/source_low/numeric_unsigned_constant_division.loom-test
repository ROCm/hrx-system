func.def target(@target) @quotient_by_three(%input: i32) -> (i32) {
  %divisor = scalar.constant 3 : i32
  %quotient = scalar.divui %input, %divisor : i32
  func.return %quotient : i32
}

// ----
low.func.def target<x86.avx2.core>(@target) abi(object_function) @quotient_by_three(%input: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  %6 = movzx.gpr64.gpr32 %input
  %7 = mov.imm64 6148914691236517206
  %8 = copy %6 : reg<x86.gpr64> -> reg<x86.rax>
  %9 = mul.high.gpr64 %8, %7
  %10 = copy %9 : reg<x86.rdx> -> reg<x86.gpr64>
  %quotient = mov.trunc.gpr32.gpr64 %10
  return %quotient
}

