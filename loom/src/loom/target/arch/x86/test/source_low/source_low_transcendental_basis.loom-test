// RUN: pass legalize-math

// The authored scalar schematics are the semantic source of truth for all
// three compact recipe programs. Exact output checks every generated operand,
// predicate, constant payload, and result selection.
x86.target<avx2> @target

func.def target(@target) @scalar_leaf_family(%input: f32) -> (f32, f32, f32) {
  %exp2 = scalar.exp2f<afn> %input : f32
  %sin = scalar.sinturnsf<afn> %input : f32
  %cos = scalar.costurnsf<afn> %input : f32
  func.return %exp2, %sin, %cos : f32, f32, f32
}

