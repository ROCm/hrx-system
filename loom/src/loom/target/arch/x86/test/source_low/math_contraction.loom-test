// RUN: emit source-low target=x86:avx512_packed_dot output=low

func.def @scalar_contract(%a: f32, %b: f32, %c: f32) -> (f32) {
  %product = scalar.mulf<contract> %a, %b : f32
  %result = scalar.addf<contract> %product, %c : f32
  func.return %result : f32
}

// ----
low.func.def target<x86.avx512_features.core> abi(object_function) abi_layout({signature = (f32, f32, f32) -> (f32)}) @scalar_contract(%a: reg<x86.xmm>, %b: reg<x86.xmm>, %c: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %11 = copy %c : reg<x86.xmm> -> reg<x86.xmm>
  %result = vfmadd231ss.xmm %11, %a, %b
  return %result
}

// ====

func.def @scalar_swapped(%a: f32, %b: f32, %c: f32) -> (f32) {
  %product = scalar.mulf<contract> %a, %b : f32
  %result = scalar.addf<contract> %c, %product : f32
  func.return %result : f32
}

// ----
low.func.def target<x86.avx512_features.core> abi(object_function) abi_layout({signature = (f32, f32, f32) -> (f32)}) @scalar_swapped(%a: reg<x86.xmm>, %b: reg<x86.xmm>, %c: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %11 = copy %c : reg<x86.xmm> -> reg<x86.xmm>
  %result = vfmadd231ss.xmm %11, %a, %b
  return %result
}

// ====

func.def @scalar_nonadjacent(%a: f32, %b: f32, %c: f32) -> (f32) {
  %product = scalar.mulf<contract> %a, %b : f32
  %addend = scalar.mulf %c, %c : f32
  %result = scalar.addf<contract> %product, %addend : f32
  func.return %result : f32
}

// ----
low.func.def target<x86.avx512_features.core> abi(object_function) abi_layout({signature = (f32, f32, f32) -> (f32)}) @scalar_nonadjacent(%a: reg<x86.xmm>, %b: reg<x86.xmm>, %c: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %addend = vmulss.xmm %c, %c
  %13 = copy %addend : reg<x86.xmm> -> reg<x86.xmm>
  %result = vfmadd231ss.xmm %13, %a, %b
  return %result
}

// ====

func.def @scalar_multiuse(%a: f32, %b: f32, %c: f32) -> (f32, f32) {
  %product = scalar.mulf<contract> %a, %b : f32
  %result = scalar.addf<contract> %product, %c : f32
  func.return %product, %result : f32, f32
}

// ----
low.func.def target<x86.avx512_features.core> abi(object_function) abi_layout({signature = (f32, f32, f32) -> (f32, f32)}) @scalar_multiuse(%a: reg<x86.xmm>, %b: reg<x86.xmm>, %c: reg<x86.xmm>) -> (reg<x86.xmm>, reg<x86.xmm>) asm {
  %product = vmulss.xmm %a, %b
  %result = vaddss.xmm %product, %c
  return %product, %result
}

// ====

func.def @scalar_one_flag(%a: f32, %b: f32, %c: f32) -> (f32) {
  %product = scalar.mulf<contract> %a, %b : f32
  %result = scalar.addf %product, %c : f32
  func.return %result : f32
}

// ----
low.func.def target<x86.avx512_features.core> abi(object_function) abi_layout({signature = (f32, f32, f32) -> (f32)}) @scalar_one_flag(%a: reg<x86.xmm>, %b: reg<x86.xmm>, %c: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %product = vmulss.xmm %a, %b
  %result = vaddss.xmm %product, %c
  return %result
}

// ====

func.def @scalar_explicit(%a: f32, %b: f32, %c: f32) -> (f32) {
  %result = scalar.fmaf %a, %b, %c : f32
  func.return %result : f32
}

// ----
low.func.def target<x86.avx512_features.core> abi(object_function) abi_layout({signature = (f32, f32, f32) -> (f32)}) @scalar_explicit(%a: reg<x86.xmm>, %b: reg<x86.xmm>, %c: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %9 = copy %c : reg<x86.xmm> -> reg<x86.xmm>
  %result = vfmadd231ss.xmm %9, %a, %b
  return %result
}

// ====

func.def @vector4_contract(%a: vector<4xf32>, %b: vector<4xf32>, %c: vector<4xf32>) -> (vector<4xf32>) {
  %product = vector.mulf<contract> %a, %b : vector<4xf32>
  %result = vector.addf<contract> %product, %c : vector<4xf32>
  func.return %result : vector<4xf32>
}

// ----
low.func.def target<x86.avx512_features.core> abi(object_function) abi_layout({signature = (vector<4xf32>, vector<4xf32>, vector<4xf32>) -> (vector<4xf32>)}) @vector4_contract(%a: reg<x86.xmm>, %b: reg<x86.xmm>, %c: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %11 = copy %c : reg<x86.xmm> -> reg<x86.xmm>
  %result = vfmadd231ps.xmm %11, %a, %b
  return %result
}

// ====

func.def @vector4_reduce(%a: vector<4xf32>, %b: vector<4xf32>, %c: f32) -> (f32) {
  %product = vector.mulf<contract> %a, %b : vector<4xf32>
  %result = vector.reduce<addf, reassoc|nnan|ninf|nsz|contract> %product, %c : vector<4xf32>, f32
  func.return %result : f32
}

// ----
low.func.def target<x86.avx512_features.core> abi(object_function) abi_layout({signature = (vector<4xf32>, vector<4xf32>, f32) -> (f32)}) @vector4_reduce(%a: reg<x86.xmm>, %b: reg<x86.xmm>, %c: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %11 = copy %c : reg<x86.xmm> -> reg<x86.xmm>
  %12 = vfmadd231ss.xmm %11, %a, %b
  %13 = vpermilps.xmm %a, 1
  %14 = vpermilps.xmm %b, 1
  %15 = vfmadd231ss.xmm %12, %13, %14
  %16 = vpermilps.xmm %a, 2
  %17 = vpermilps.xmm %b, 2
  %18 = vfmadd231ss.xmm %15, %16, %17
  %19 = vpermilps.xmm %a, 3
  %20 = vpermilps.xmm %b, 3
  %result = vfmadd231ss.xmm %18, %19, %20
  return %result
}

// ====

func.def @vector16_contract(%a: vector<16xf32>, %b: vector<16xf32>, %c: vector<16xf32>) -> (vector<16xf32>) {
  %product = vector.mulf<contract> %a, %b : vector<16xf32>
  %result = vector.addf<contract> %product, %c : vector<16xf32>
  func.return %result : vector<16xf32>
}

// ----
low.func.def target<x86.avx512_features.core> abi(object_function) abi_layout({signature = (vector<16xf32>, vector<16xf32>, vector<16xf32>) -> (vector<16xf32>)}) @vector16_contract(%a: reg<x86.zmm>, %b: reg<x86.zmm>, %c: reg<x86.zmm>) -> (reg<x86.zmm>) asm {
  %11 = copy %c : reg<x86.zmm> -> reg<x86.zmm>
  %result = vfmadd231ps %11, %a, %b
  return %result
}

// ====

// RUN: emit source-low target=x86:avx512 output=low

// Contraction still needs both permissions and a single-use product.
func.def @vector_contract_boundaries(%a: vector<8xf32>, %b: vector<8xf32>, %c: vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>) {
  %shared = vector.mulf<contract> %a, %b : vector<8xf32>
  %multiuse = vector.addf<contract> %shared, %c : vector<8xf32>
  %product = vector.mulf<contract> %b, %c : vector<8xf32>
  %strict = vector.addf %product, %a : vector<8xf32>
  func.return %shared, %multiuse, %strict : vector<8xf32>, vector<8xf32>, vector<8xf32>
}

// ----
low.func.def target<x86.avx512.core> abi(object_function) abi_layout({signature = (vector<8xf32>, vector<8xf32>, vector<8xf32>) -> (vector<8xf32>, vector<8xf32>, vector<8xf32>)}) @vector_contract_boundaries(%a: reg<x86.ymm>, %b: reg<x86.ymm>, %c: reg<x86.ymm>) -> (reg<x86.ymm>, reg<x86.ymm>, reg<x86.ymm>) asm {
  %shared = vmulps.ymm %a, %b
  %multiuse = vaddps.ymm %shared, %c
  %product = vmulps.ymm %b, %c
  %strict = vaddps.ymm %product, %a
  return %shared, %multiuse, %strict
}
