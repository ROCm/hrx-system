// TEMPLATE: loom/src/loom/test/corpus/source_low/math_contraction.loom-test
// RUN: emit source-low target=x86:avx512_packed_dot output=low

func.def @scalar_contract(%a: f32, %b: f32, %c: f32) -> (f32) {
  %product = scalar.mulf<contract> %a, %b : f32
  %result = scalar.addf<contract> %product, %c : f32
  func.return %result : f32
}

// ----
low.func.def target<x86.avx512_packed_dot.core> abi(object_function) abi_layout({signature = (f32, f32, f32) -> (f32)}) @scalar_contract(%a: reg<x86.xmm>, %b: reg<x86.xmm>, %c: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %11 = copy %c : reg<x86.xmm> -> reg<x86.xmm>
  %result = vfmadd231ss.xmm %11, %a, %b
  return %result
}

// ====

func.def @scalar_swapped(%a: f32, %b: f32, %c: f32) -> (f32) {
  %product = scalar.mulf<contract> %a, %b : f32
  %result = scalar.addf<contract> %c, %product : f32
  func.return %result : f32
}

// ----
low.func.def target<x86.avx512_packed_dot.core> abi(object_function) abi_layout({signature = (f32, f32, f32) -> (f32)}) @scalar_swapped(%a: reg<x86.xmm>, %b: reg<x86.xmm>, %c: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %11 = copy %c : reg<x86.xmm> -> reg<x86.xmm>
  %result = vfmadd231ss.xmm %11, %a, %b
  return %result
}

// ====

func.def @scalar_nonadjacent(%a: f32, %b: f32, %c: f32) -> (f32) {
  %product = scalar.mulf<contract> %a, %b : f32
  %addend = scalar.mulf %c, %c : f32
  %result = scalar.addf<contract> %product, %addend : f32
  func.return %result : f32
}

// ----
low.func.def target<x86.avx512_packed_dot.core> abi(object_function) abi_layout({signature = (f32, f32, f32) -> (f32)}) @scalar_nonadjacent(%a: reg<x86.xmm>, %b: reg<x86.xmm>, %c: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %addend = vmulss.xmm %c, %c
  %13 = copy %addend : reg<x86.xmm> -> reg<x86.xmm>
  %result = vfmadd231ss.xmm %13, %a, %b
  return %result
}

// ====

func.def @scalar_multiuse(%a: f32, %b: f32, %c: f32) -> (f32, f32) {
  %product = scalar.mulf<contract> %a, %b : f32
  %result = scalar.addf<contract> %product, %c : f32
  func.return %product, %result : f32, f32
}

// ----
low.func.def target<x86.avx512_packed_dot.core> abi(object_function) abi_layout({signature = (f32, f32, f32) -> (f32, f32)}) @scalar_multiuse(%a: reg<x86.xmm>, %b: reg<x86.xmm>, %c: reg<x86.xmm>) -> (reg<x86.xmm>, reg<x86.xmm>) asm {
  %product = vmulss.xmm %a, %b
  %result = vaddss.xmm %product, %c
  return %product, %result
}

