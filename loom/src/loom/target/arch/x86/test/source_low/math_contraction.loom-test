func.def @vector4_contract(%a: vector<4xf32>, %b: vector<4xf32>, %c: vector<4xf32>) -> (vector<4xf32>) {
  %product = vector.mulf<contract> %a, %b : vector<4xf32>
  %result = vector.addf<contract> %product, %c : vector<4xf32>
  func.return %result : vector<4xf32>
}

// ----
low.func.def target<x86.avx512_packed_dot.core> abi(object_function) abi_layout({signature = (vector<4xf32>, vector<4xf32>, vector<4xf32>) -> (vector<4xf32>)}) @vector4_contract(%a: reg<x86.xmm>, %b: reg<x86.xmm>, %c: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %product = vmulps.xmm %a, %b
  %result = vaddps.xmm %product, %c
  return %result
}

// ====

func.def @vector4_reduce(%a: vector<4xf32>, %b: vector<4xf32>, %c: f32) -> (f32) {
  %product = vector.mulf<contract> %a, %b : vector<4xf32>
  %result = vector.reduce<addf, reassoc|nnan|ninf|nsz|contract> %product, %c : vector<4xf32>, f32
  func.return %result : f32
}

// ----
low.func.def target<x86.avx512_packed_dot.core> abi(object_function) abi_layout({signature = (vector<4xf32>, vector<4xf32>, f32) -> (f32)}) @vector4_reduce(%a: reg<x86.xmm>, %b: reg<x86.xmm>, %c: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %23 = vpermilps.xmm %a, 0
  %24 = vpermilps.xmm %b, 0
  %25 = copy %c : reg<x86.xmm> -> reg<x86.xmm>
  %26 = vfmadd231ss.xmm %25, %23, %24
  %27 = vpermilps.xmm %a, 1
  %28 = vpermilps.xmm %b, 1
  %29 = copy %26 : reg<x86.xmm> -> reg<x86.xmm>
  %30 = vfmadd231ss.xmm %29, %27, %28
  %31 = vpermilps.xmm %a, 2
  %32 = vpermilps.xmm %b, 2
  %33 = copy %30 : reg<x86.xmm> -> reg<x86.xmm>
  %34 = vfmadd231ss.xmm %33, %31, %32
  %35 = vpermilps.xmm %a, 3
  %36 = vpermilps.xmm %b, 3
  %37 = copy %34 : reg<x86.xmm> -> reg<x86.xmm>
  %result = vfmadd231ss.xmm %37, %35, %36
  return %result
}

// ====

func.def @vector16_contract(%a: vector<16xf32>, %b: vector<16xf32>, %c: vector<16xf32>) -> (vector<16xf32>) {
  %product = vector.mulf<contract> %a, %b : vector<16xf32>
  %result = vector.addf<contract> %product, %c : vector<16xf32>
  func.return %result : vector<16xf32>
}

// ----
low.func.def target<x86.avx512_packed_dot.core> abi(object_function) abi_layout({signature = (vector<16xf32>, vector<16xf32>, vector<16xf32>) -> (vector<16xf32>)}) @vector16_contract(%a: reg<x86.zmm>, %b: reg<x86.zmm>, %c: reg<x86.zmm>) -> (reg<x86.zmm>) asm {
  %11 = copy %c : reg<x86.zmm> -> reg<x86.zmm>
  %result = vfmadd231ps %11, %a, %b
  return %result
}
