low.func.def target<x86.avx512_packed_dot.core> abi(object_function) abi_layout({signature = (f32, f32, f32) -> (f32)}) @scalar_one_flag(%a: reg<x86.xmm>, %b: reg<x86.xmm>, %c: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %product = vmulss.xmm %a, %b
