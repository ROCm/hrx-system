func.def @scalar_explicit(%a: f32, %b: f32, %c: f32) -> (f32) {
  %result = scalar.fmaf %a, %b, %c : f32
  func.return %result : f32
}

// ----
low.func.def target<x86.avx512_packed_dot.core> abi(object_function) abi_layout({signature = (f32, f32, f32) -> (f32)}) @scalar_explicit(%a: reg<x86.xmm>, %b: reg<x86.xmm>, %c: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %9 = copy %c : reg<x86.xmm> -> reg<x86.xmm>
  %result = vfmadd231ss.xmm %9, %a, %b
  return %result
}

