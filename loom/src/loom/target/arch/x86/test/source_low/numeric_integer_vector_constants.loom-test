// RUN: emit source-low target=x86:avx2 output=low

func.def @integer_vector_zeros() -> (vector<4xi32>, vector<2xi64>) {
  %i32 = vector.splati 0 : vector<4xi32>
  %i64 = vector.splati 0 : vector<2xi64>
  func.return %i32, %i64 : vector<4xi32>, vector<2xi64>
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) abi_layout({signature = () -> (vector<4xi32>, vector<2xi64>)}) @integer_vector_zeros() -> (reg<x86.xmm>, reg<x86.xmm>) asm {
  %i32 = vxorps.zero.xmm
  return %i32, %i32
}

// ====

func.def @i32x4_constant_payloads() -> (vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>) {
  %unit_value = vector.splati 1 : vector<4xi32>
  %negative = vector.splati -19088743 : vector<4xi32>
  %minimum = vector.splati -2147483648 : vector<4xi32>
  %all_bits = vector.splati -1 : vector<4xi32>
  %maximum = vector.splati 2147483647 : vector<4xi32>
  func.return %unit_value, %negative, %minimum, %all_bits, %maximum : vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>
}

