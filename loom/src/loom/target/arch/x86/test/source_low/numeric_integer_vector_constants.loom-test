  %high_word_scalar = mov.imm64 -4294967296
  %31 = vmovq.xmm.gpr64 %high_word_scalar
  %high_word = avx2.vpbroadcastq.xmm %31
  %near_minimum_scalar = mov.imm64 -9223372036854775807
  %34 = vmovq.xmm.gpr64 %near_minimum_scalar
  %near_minimum = avx2.vpbroadcastq.xmm %34
