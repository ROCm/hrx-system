func.def @i32x8_uniform_values(%value: i32) -> (vector<8xi32>, vector<8xi32>, vector<8xi32>) {
  %cleared_scalar = scalar.constant 0 : i32
  %cleared = vector.splat %cleared_scalar : vector<8xi32>
  %constant_scalar = scalar.constant -19088743 : i32
  %constant = vector.splat %constant_scalar : vector<8xi32>
