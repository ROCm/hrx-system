low.func.def target<x86.avx512.core> abi(object_function) abi_layout({signature = () -> (vector<4xi32>, vector<16xi32>, vector<2xi64>)}) @avx512_integer_constants() -> (reg<x86.xmm>, reg<x86.zmm>, reg<x86.xmm>) asm {
  %9 = mov.imm32 -19088743
  %i32x4 = vpbroadcastd.xmm %9
  %11 = mov.imm32 2147483647
  %i32x16 = vpbroadcastd %11
