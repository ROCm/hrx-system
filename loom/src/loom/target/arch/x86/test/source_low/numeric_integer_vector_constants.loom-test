// ====

func.def @folded_integer_splats() -> (vector<4xi32>, vector<2xi64>) {
  %i32_scalar = scalar.constant 2147483647 : i32
  %i32 = vector.splat %i32_scalar : vector<4xi32>
  %i64_scalar = scalar.constant -1 : i64
  %i64 = vector.splat %i64_scalar : vector<2xi64>
  func.return %i32, %i64 : vector<4xi32>, vector<2xi64>
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) abi_layout({signature = () -> (vector<4xi32>, vector<2xi64>)}) @folded_integer_splats() -> (reg<x86.xmm>, reg<x86.xmm>) asm {
  %10 = mov.imm32 2147483647
  %11 = vmovd.xmm.gpr32 %10
  %i32 = avx2.vpbroadcastd.xmm %11
  %13 = mov.imm64 -1
  %14 = vmovq.xmm.gpr64 %13
  %i64 = avx2.vpbroadcastq.xmm %14
  return %i32, %i64
}

// ====

func.def @i32x8_uniform_values(%value: i32) -> (vector<8xi32>, vector<8xi32>, vector<8xi32>) {
  %cleared = vector.splati 0 : vector<8xi32>
  %constant = vector.splati -19088743 : vector<8xi32>
  %splat = vector.splat %value : vector<8xi32>
  func.return %cleared, %constant, %splat : vector<8xi32>, vector<8xi32>, vector<8xi32>
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) abi_layout({signature = (i32) -> (vector<8xi32>, vector<8xi32>, vector<8xi32>)}) @i32x8_uniform_values(%value: reg<x86.gpr32>) -> (reg<x86.ymm>, reg<x86.ymm>, reg<x86.ymm>) asm {
  %cleared = vxorps.zero.ymm
  %12 = mov.imm32 -19088743
  %13 = vmovd.xmm.gpr32 %12
  %constant = vpbroadcastd.ymm %13
  %15 = vmovd.xmm.gpr32 %value
  %splat = vpbroadcastd.ymm %15
  return %cleared, %constant, %splat
}

