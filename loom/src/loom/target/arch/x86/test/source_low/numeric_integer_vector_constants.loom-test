// RUN: emit source-low target=x86:avx2 output=low

func.def @integer_vector_zeros() -> (vector<4xi32>, vector<2xi64>) {
  %i32_scalar = scalar.constant 0 : i32
  %i32 = vector.splat %i32_scalar : vector<4xi32>
  %i64_scalar = scalar.constant 0 : i64
  %i64 = vector.splat %i64_scalar : vector<2xi64>
  func.return %i32, %i64 : vector<4xi32>, vector<2xi64>
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) abi_layout({signature = () -> (vector<4xi32>, vector<2xi64>)}) @integer_vector_zeros() -> (reg<x86.xmm>, reg<x86.xmm>) asm {
  %i32 = vxorps.zero.xmm
  return %i32, %i32
}

// ====

func.def @i32x4_constant_payloads() -> (vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>) {
  %unit_value_scalar = scalar.constant 1 : i32
  %unit_value = vector.splat %unit_value_scalar : vector<4xi32>
  %negative_scalar = scalar.constant -19088743 : i32
  %negative = vector.splat %negative_scalar : vector<4xi32>
  %minimum_scalar = scalar.constant -2147483648 : i32
  %minimum = vector.splat %minimum_scalar : vector<4xi32>
  %all_bits_scalar = scalar.constant -1 : i32
  %all_bits = vector.splat %all_bits_scalar : vector<4xi32>
  %maximum_scalar = scalar.constant 2147483647 : i32
  %maximum = vector.splat %maximum_scalar : vector<4xi32>
  func.return %unit_value, %negative, %minimum, %all_bits, %maximum : vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) abi_layout({signature = () -> (vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>)}) @i32x4_constant_payloads() -> (reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>) asm {
  %unit_value_scalar = mov.imm32 1
  %21 = vmovd.xmm.gpr32 %unit_value_scalar
  %unit_value = avx2.vpbroadcastd.xmm %21
  %negative_scalar = mov.imm32 -19088743
  %24 = vmovd.xmm.gpr32 %negative_scalar
  %negative = avx2.vpbroadcastd.xmm %24
  %minimum_scalar = mov.imm32 -2147483648
  %27 = vmovd.xmm.gpr32 %minimum_scalar
  %minimum = avx2.vpbroadcastd.xmm %27
  %all_bits_scalar = mov.imm32 -1
  %30 = vmovd.xmm.gpr32 %all_bits_scalar
  %all_bits = avx2.vpbroadcastd.xmm %30
  %maximum_scalar = mov.imm32 2147483647
  %33 = vmovd.xmm.gpr32 %maximum_scalar
  %maximum = avx2.vpbroadcastd.xmm %33
  return %unit_value, %negative, %minimum, %all_bits, %maximum
}

