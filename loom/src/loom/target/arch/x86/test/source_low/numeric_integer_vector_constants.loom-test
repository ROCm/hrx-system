// RUN: emit source-low target=x86:avx512 output=low

func.def @avx512_integer_splats(%i32_value: i32, %i64_value: i64) -> (vector<4xi32>, vector<16xi32>, vector<2xi64>) {
  %i32x4 = vector.splat %i32_value : vector<4xi32>
  %i32x16 = vector.splat %i32_value : vector<16xi32>
  %i64x2 = vector.splat %i64_value : vector<2xi64>
  func.return %i32x4, %i32x16, %i64x2 : vector<4xi32>, vector<16xi32>, vector<2xi64>
}

// ----
low.func.def target<x86.avx512.core> abi(object_function) abi_layout({signature = (i32, i64) -> (vector<4xi32>, vector<16xi32>, vector<2xi64>)}) @avx512_integer_splats(%i32_value: reg<x86.gpr32>, %i64_value: reg<x86.gpr64>) -> (reg<x86.xmm>, reg<x86.zmm>, reg<x86.xmm>) asm {
  %i32x4 = vpbroadcastd.xmm %i32_value
  %i32x16 = vpbroadcastd %i32_value
  %i64x2 = vpbroadcastq.xmm %i64_value
  return %i32x4, %i32x16, %i64x2
}

