  %negative = avx2.vpbroadcastd.xmm %19
  %21 = mov.imm32 -2147483648
  %22 = vmovd.xmm.gpr32 %21
  %minimum = avx2.vpbroadcastd.xmm %22
  %24 = mov.imm32 -1
  %25 = vmovd.xmm.gpr32 %24
  %all_bits = avx2.vpbroadcastd.xmm %25
  %27 = mov.imm32 2147483647
  %28 = vmovd.xmm.gpr32 %27
  %maximum = avx2.vpbroadcastd.xmm %28
  return %unit_value, %negative, %minimum, %all_bits, %maximum
