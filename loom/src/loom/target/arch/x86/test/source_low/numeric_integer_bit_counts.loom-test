func.def @predicate_i1x8_counts(%input: vector<8xi1>) -> (vector<8xi1>, vector<8xi1>, vector<8xi1>) {
  %leading = vector.ctlzi %input : vector<8xi1>
  %trailing = vector.cttzi %input : vector<8xi1>
  %population = vector.ctpopi %input : vector<8xi1>
  func.return %leading, %trailing, %population : vector<8xi1>, vector<8xi1>, vector<8xi1>
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) abi_layout({signature = (vector<8xi1>) -> (vector<8xi1>, vector<8xi1>, vector<8xi1>)}) @predicate_i1x8_counts(%population: reg<x86.xmm>) -> (reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>) asm {
  %11 = vpcmpeqd.xmm %population, %population
  %leading = vpxor.xmm %population, %11
  return %leading, %leading, %population
}
