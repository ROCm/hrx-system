func.def @vector_i64x2_population(%input: vector<2xi64>) -> (vector<2xi64>) {
  %population = vector.ctpopi %input : vector<2xi64>
  func.return %population : vector<2xi64>
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) abi_layout({signature = (vector<2xi64>) -> (vector<2xi64>)}) @vector_i64x2_population(%input: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %5 = avx2.vmovdqu.rodata.xmm @__low_rodata_45cbf323
  %6 = avx2.vmovdqu.rodata.xmm @__low_rodata_1326489f
  %7 = vpand.xmm %input, %6
  %8 = vpsrlw.xmm %input, 4
  %9 = vpand.xmm %8, %6
  %10 = vpshufb.xmm %5, %7
  %11 = vpshufb.xmm %5, %9
  %12 = vpaddb.xmm %10, %11
  %13 = vpsrlq.xmm %12, 8
  %14 = vpaddq.xmm %12, %13
  %15 = vpsrlq.xmm %14, 16
  %16 = vpaddq.xmm %14, %15
  %17 = vpsrlq.xmm %16, 32
  %18 = vpaddq.xmm %16, %17
  %19 = vpsllq.xmm %18, 57
  %population = vpsrlq.xmm %19, 57
  return %population
}

