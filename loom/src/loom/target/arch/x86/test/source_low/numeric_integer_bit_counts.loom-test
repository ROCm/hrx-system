  %34 = vpxor.xmm %input, %11
  %35 = vpand.xmm %33, %34
  %38 = vpand.xmm %35, %21
  %39 = vpsrlw.xmm %35, 4
  %40 = vpand.xmm %39, %21
  %41 = vpshufb.xmm %25, %38
  %42 = vpshufb.xmm %25, %40
  %trailing = vpaddb.xmm %41, %42
  %46 = vpand.xmm %input, %21
  %47 = vpsrlw.xmm %input, 4
  %48 = vpand.xmm %47, %21
  %49 = vpshufb.xmm %25, %46
