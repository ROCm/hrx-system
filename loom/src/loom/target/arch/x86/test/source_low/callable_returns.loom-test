// TEMPLATE: loom/src/loom/test/corpus/source_low/callable_returns.loom-test
// TEMPLATE-EXCLUDE: @return_mixed_values Scalar f32 memory transfers have no x86 lowering.
// RUN: emit source-low target=x86:avx2 output=low

// Return representation depends on all paths, regardless of block layout.
func.def @return_loaded_or_argument(%input: buffer, %load: i1, %fallback: i32) -> (i32) {
  %origin = index.constant 0 : offset
  %view = buffer.view %input[%origin] : buffer -> view<1xi32>
  cfg.cond_br %load, ^loaded, ^argument
^loaded:
  %value = view.load %view[0] : view<1xi32> -> i32
  func.return %value : i32
^argument:
  func.return %fallback : i32
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) @return_loaded_or_argument(%input: reg<x86.gpr64>, %load: reg<x86.gpr32>, %fallback: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  low.cond_br %load, ^loaded, ^argument : reg<x86.gpr32>
^loaded:
  %value = mov.load.gpr32 %input {disp32 = 0}
  return %value
^argument:
  return %fallback
}

