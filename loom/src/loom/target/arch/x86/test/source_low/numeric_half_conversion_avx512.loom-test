// ----
low.func.def target<x86.avx512.core> abi(object_function) abi_layout({signature = (vector<16xf16>) -> (vector<16xf32>)}) @convert_f16_f32_16(%input: reg<x86.ymm>) -> (reg<x86.zmm>) asm {
