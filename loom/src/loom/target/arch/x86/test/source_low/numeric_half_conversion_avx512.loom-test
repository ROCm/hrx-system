// ====

func.def @convert_f16_f64_1(%input: f16) -> (f64) {
  %result = scalar.extf %input : f16 to f64
  func.return %result : f64
}

// ----
low.func.def target<x86.avx512.core> abi(object_function) abi_layout({signature = (f16) -> (f64)}) @convert_f16_f64_1(%input: reg<x86.gpr32>) -> (reg<x86.xmm>) asm {
  %7 = avx512.vmovd.xmm.gpr32 %input
  %8 = avx512.vcvtph2ps.xmm.xmm %7
  %result = avx512.vcvtss2sd.xmm %8, %8
  return %result
}

