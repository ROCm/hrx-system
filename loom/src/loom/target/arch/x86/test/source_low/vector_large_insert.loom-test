// ====

// Predicate packets update bits without converting through payload selection.
x86.target<avx2> @target

func.def public target(@target) @i1x40_insert_dynamic(%input: buffer, %output: buffer, %value: i1, %position: index) {
  %c0 = index.constant 0 : offset
  %input_view = buffer.view %input[%c0] : buffer -> view<40xi8>
  %output_view = buffer.view %output[%c0] : buffer -> view<40xi8>
  %values = vector.load %input_view[0] : view<40xi8> -> vector<40xi8>
  %clear_values = vector.splati 0 : vector<40xi8>
  %predicates = vector.cmpi eq, %values, %clear_values : vector<40xi8> -> vector<40xi1>
  %updated = vector.insert %value into %predicates[%position] : i1, vector<40xi1>
  %result = vector.select %updated, %values, %clear_values : vector<40xi8>
  vector.store %result, %output_view[0] : vector<40xi8>, view<40xi8>
  func.return
}

