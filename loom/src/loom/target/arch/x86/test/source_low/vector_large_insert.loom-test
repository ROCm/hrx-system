// ====

// Object-function signatures preserve their authored platform ABI instead of
// silently projecting an unsupported wide vector into private packet arguments.
x86.target<avx2> @target

// ERROR@+1: TARGET/031 {op_name="func.def", type_constraint="vector.target_carrier"}
func.def target(@target) @unsupported_wide_callable(%values: vector<16xi64>) {
  func.return
}

// ====

// Low-XMM carriers keep a four-byte storage-float vector packed through the
// dynamic predicate and preserve its payload bits through integer selection.
x86.target<avx2> @target

func.def public target(@target) @short_dynamic_insert(%output: buffer, %value: f8E4M3, %position: index) {
  %c0 = index.constant 0 : offset
  %output_view = buffer.view %output[%c0] : buffer -> view<4xf8E4M3>
  %values = vector.splatf 0.0 : vector<4xf8E4M3>
  %result = vector.insert %value into %values[%position] : f8E4M3, vector<4xf8E4M3>
  vector.store %result, %output_view[0] : vector<4xf8E4M3>, view<4xf8E4M3>
  func.return
}

// ----
low.func.def public target<x86.avx2.core>(@target) abi(object_function) abi_layout({signature = (buffer, f8E4M3, index) -> ()}) @short_dynamic_insert(%output: reg<x86.gpr64>, %value: reg<x86.gpr32>, %position: reg<x86.gpr64>) asm {
  %values = vxorps.zero.xmm
  %27 = mov.trunc.gpr32.gpr64 %position
  %28 = movsx.i16.gpr32 %27
  %29 = copy %28 : reg<x86.gpr32> -> reg<x86.gpr32>
  %30 = neg.gpr32 %29
  %31 = mov.imm32 50462976
  %32 = vmovd.xmm.gpr32 %31
  %33 = vpmovzxbw.xmm %32
  %34 = vmovd.xmm.gpr32 %30
  %35 = vpbroadcastw.xmm %34
  %36 = vpaddw.xmm %35, %33
  %38 = vpcmpeqw.xmm %36, %values
  %39 = cmp.imm.gpr64 %position, 4, "ult"
  %40 = mov.imm32 0
  %41 = sub.gpr32 %40, %39
  %42 = vmovd.xmm.gpr32 %41
  %43 = vpbroadcastw.xmm %42
  %44 = vpand.xmm %38, %43
  %45 = vmovd.xmm.gpr32 %value
  %46 = vpbroadcastb.xmm %45
  %47 = avx2.vmovdqu.rodata.xmm @__low_rodata_6497a0a7
  %48 = vpshufb.xmm %44, %47
  %result = vpblendvb.xmm %values, %46, %48
  vmovss.store.xmm %result, %output {disp32 = 0}
  return
}
