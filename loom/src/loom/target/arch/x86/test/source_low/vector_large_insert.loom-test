// ====

// Object-function signatures preserve their authored platform ABI instead of
// silently projecting an unsupported wide vector into private packet arguments.
x86.target<avx2> @target

// ERROR@+1: TARGET/031 {op_name="func.def", type_constraint="vector.target_carrier"}
func.def target(@target) @unsupported_wide_callable(%values: vector<16xi64>) {
  func.return
}

// ====

// Low-XMM carriers keep a four-byte storage-float vector packed through the
// dynamic predicate and preserve its payload bits through integer selection.
x86.target<avx2> @target

func.def public target(@target) @short_dynamic_insert(%output: buffer, %value: f8E4M3, %position: index) {
  %c0 = index.constant 0 : offset
  %output_view = buffer.view %output[%c0] : buffer -> view<4xf8E4M3>
  %values = vector.splatf 0.0 : vector<4xf8E4M3>
  %result = vector.insert %value into %values[%position] : f8E4M3, vector<4xf8E4M3>
  vector.store %result, %output_view[0] : vector<4xf8E4M3>, view<4xf8E4M3>
  func.return
