func.def public target(@target) @avx512_i16x39_insert_dynamic(%input: buffer, %output: buffer, %value: i16, %position: index) {
  %c0 = index.constant 0 : offset
  %input_view = buffer.view %input[%c0] : buffer -> view<39xi16>
  %output_view = buffer.view %output[%c0] : buffer -> view<39xi16>
  %values = vector.load %input_view[0] : view<39xi16> -> vector<39xi16>
  %result = vector.insert %value into %values[%position] : i16, vector<39xi16>
  vector.store %result, %output_view[0] : vector<39xi16>, view<39xi16>
  func.return
}

