// RUN: emit source-low output=low

// Static insertion updates only the packet owning the selected lane.
x86.target<avx2> @target

func.def public target(@target) @i32x16_insert_static(%input: buffer, %output: buffer, %value: i32) {
  %c0 = index.constant 0 : offset
  %input_view = buffer.view %input[%c0] : buffer -> view<16xi32>
  %output_view = buffer.view %output[%c0] : buffer -> view<16xi32>
  %values = vector.load %input_view[0] : view<16xi32> -> vector<16xi32>
  %result = vector.insert %value into %values[9] : i32, vector<16xi32>
  vector.store %result, %output_view[0] : vector<16xi32>, view<16xi32>
  func.return
}

// ----
low.func.def public target<x86.avx2.core>(@target) abi(object_function) @i32x16_insert_static(%input: reg<x86.gpr64>, %output: reg<x86.gpr64>, %value: reg<x86.gpr32>) asm {
  %18 = vmovdqu32.load.ymm %input {disp32 = 0}
  %19 = vmovdqu32.load.ymm %input {disp32 = 32}
  %20 = vextractf128.xmm %19, 0
  %21 = vpinsrd.xmm %20, %value, 1
  %22 = vinsertf128.ymm.xmm %19, %21, 0
  vmovdqu32.store.ymm %18, %output {disp32 = 0}
  vmovdqu32.store.ymm %22, %output {disp32 = 32}
  return
}

// ====

// A one-lane native vector uses scalar selection and rebuilds its carrier.
x86.target<avx2> @target

func.def target(@target) @i64x1_insert_dynamic(%values: vector<1xi64>, %value: i64, %position: index) -> (vector<1xi64>) {
  %result = vector.insert %value into %values[%position] : i64, vector<1xi64>
  func.return %result : vector<1xi64>
}

// ----
low.func.def target<x86.avx2.core>(@target) abi(object_function) abi_layout({signature = (vector<1xi64>, i64, index) -> (vector<1xi64>)}) @i64x1_insert_dynamic(%values: reg<x86.xmm>, %value: reg<x86.gpr64>, %position: reg<x86.gpr64>) -> (reg<x86.xmm>) asm {
  %14 = vpextrq.xmm %values, 0
  %15 = copy %14 : reg<x86.gpr64> -> reg<x86.gpr64>
  %16 = cmp.select.imm.gpr64.gpr64 %position, %value, %15, 0, "eq"
  %17 = vmovq.xmm.gpr64 %16
  %result = avx2.vpbroadcastq.xmm %17
  return %result
}

// ====

// An irregular numeric vector keeps its 256-bit and 64-bit packets while the
// final three lanes remain scalar components.
x86.target<avx2> @target

func.def public target(@target) @i16x23_insert_dynamic(%input: buffer, %output: buffer, %value: i16, %position: index) {
  %c0 = index.constant 0 : offset
  %input_view = buffer.view %input[%c0] : buffer -> view<23xi16>
  %output_view = buffer.view %output[%c0] : buffer -> view<23xi16>
  %values = vector.load %input_view[0] : view<23xi16> -> vector<23xi16>
  %result = vector.insert %value into %values[%position] : i16, vector<23xi16>
  vector.store %result, %output_view[0] : vector<23xi16>, view<23xi16>
  func.return
}

