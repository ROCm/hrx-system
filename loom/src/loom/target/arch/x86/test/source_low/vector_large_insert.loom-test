  %84 = vmovq.xmm.gpr64 %83
  %85 = vpunpcklqdq.xmm %82, %84
  %86 = vpmovzxbw.ymm %85
  %87 = vmovd.xmm.gpr32 %80
  %88 = vpbroadcastw.ymm %87
  %89 = vpaddw.ymm %88, %86
  %90 = vxorps.zero.ymm
  %91 = vpcmpeqw.ymm %89, %90
  %92 = cmp.imm.gpr64 %position, 16, "ult"
  %93 = mov.imm32 0
  %94 = sub.gpr32 %93, %92
  %95 = vmovd.xmm.gpr32 %94
  %96 = vpbroadcastw.ymm %95
  %97 = vpand.ymm %91, %96
  %98 = vmovd.xmm.gpr32 %value
  %99 = vpbroadcastw.ymm %98
  %100 = vmovdqu32.load.ymm %input {disp32 = 0}
  %101 = vpblendvb.ymm %100, %99, %97
  %102 = movzx.u16.gpr32 %77
  %103 = copy %102 : reg<x86.gpr32> -> reg<x86.gpr32>
  %104 = add.imm.gpr32 %103 {imm32 = -16}
  %105 = movsx.i16.gpr32 %104
  %106 = copy %105 : reg<x86.gpr32> -> reg<x86.gpr32>
  %107 = neg.gpr32 %106
  %108 = mov.imm32 50462976
  %109 = vmovd.xmm.gpr32 %108
  %110 = vpmovzxbw.xmm %109
  %111 = vmovd.xmm.gpr32 %107
  %112 = vpbroadcastw.xmm %111
  %113 = vpaddw.xmm %112, %110
  %114 = vxorps.zero.xmm
  %115 = vpcmpeqw.xmm %113, %114
  %116 = cmp.imm.gpr64 %position, 20, "ult"
  %117 = cmp.imm.gpr64 %position, 16, "uge"
  %118 = copy %117 : reg<x86.gpr32> -> reg<x86.gpr32>
  %119 = and.gpr32 %118, %116
  %120 = mov.imm32 0
  %121 = sub.gpr32 %120, %119
  %122 = vmovd.xmm.gpr32 %121
  %123 = vpbroadcastw.xmm %122
  %124 = vpand.xmm %115, %123
  %126 = vpbroadcastw.xmm %98
  %127 = vmovsd.load.xmm %input {disp32 = 32}
  %128 = vpblendvb.xmm %127, %126, %124
  %129 = copy %74 : reg<x86.gpr32> -> reg<x86.gpr32>
  %130 = cmp.select.imm.gpr64.gpr32 %position, %value, %129, 20, "eq"
  %131 = copy %75 : reg<x86.gpr32> -> reg<x86.gpr32>
  %132 = cmp.select.imm.gpr64.gpr32 %position, %value, %131, 21, "eq"
  %133 = copy %76 : reg<x86.gpr32> -> reg<x86.gpr32>
