// ====

func.def @narrow_f64_f32_8_memory(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<8xf64>
  %destination = buffer.view %output[%base] : buffer -> view<8xf32>
  %value = vector.load %source[0] : view<8xf64> -> vector<8xf64>
  %result = vector.fptrunc %value : vector<8xf64> to vector<8xf32>
  vector.store %result, %destination[0] : vector<8xf32>, view<8xf32>
  func.return
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) @narrow_f64_f32_8_memory(%input: reg<x86.gpr64>, %output: reg<x86.gpr64>) asm {
  %15 = vmovdqu32.load.ymm %input {disp32 = 0}
  %16 = vcvtpd2ps.xmm.ymm %15
  %17 = vmovdqu32.load.ymm %input {disp32 = 32}
  %18 = vcvtpd2ps.xmm.ymm %17
  vmovdqu32.store.xmm %16, %output {disp32 = 0}
  vmovdqu32.store.xmm %18, %output {disp32 = 16}
  return
}

