// RUN: emit source-low target=x86:avx2 output=low

func.def @widen_f32_f64_1(%input: f32) -> (f64) {
  %result = scalar.extf %input : f32 to f64
  func.return %result : f64
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) abi_layout({signature = (f32) -> (f64)}) @widen_f32_f64_1(%input: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %result = vcvtss2sd.xmm %input, %input
  return %result
}

