// ====

func.def @narrow_f64_f32_1(%input: f64) -> (f32) {
  %result = scalar.fptrunc %input : f64 to f32
  func.return %result : f32
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) abi_layout({signature = (f64) -> (f32)}) @narrow_f64_f32_1(%input: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %result = vcvtsd2ss.xmm %input, %input
  return %result
}

