// ----
low.func.def target<x86.avx2.core> abi(object_function) abi_layout({signature = (vector<4xf64>) -> (vector<4xf32>)}) @narrow_f64_f32_4(%input: reg<x86.ymm>) -> (reg<x86.xmm>) asm {
