// RUN: emit source-low output=low

x86.target<avx2> @target

func.def target(@target) @integer_xmm_families(%i8_lhs: vector<16xi8>, %i8_rhs: vector<16xi8>, %i16_lhs: vector<8xi16>, %i16_rhs: vector<8xi16>, %i32_lhs: vector<4xi32>, %i32_rhs: vector<4xi32>, %i64_lhs: vector<2xi64>, %i64_rhs: vector<2xi64>) -> (vector<16xi8>, vector<8xi16>, vector<4xi32>, vector<2xi64>) {
  %i8_add = vector.addi %i8_lhs, %i8_rhs : vector<16xi8>
  %i8_sub = vector.subi %i8_add, %i8_rhs : vector<16xi8>
  %i8_min = vector.minsi %i8_sub, %i8_rhs : vector<16xi8>
  %i8_max = vector.maxsi %i8_min, %i8_lhs : vector<16xi8>
  %i8_umin = vector.minui %i8_max, %i8_rhs : vector<16xi8>
  %i8_umax = vector.maxui %i8_umin, %i8_lhs : vector<16xi8>
  %i8_and = vector.andi %i8_umax, %i8_rhs : vector<16xi8>
  %i8_or = vector.ori %i8_and, %i8_lhs : vector<16xi8>
  %i8_result = vector.xori %i8_or, %i8_rhs : vector<16xi8>

  %i16_add = vector.addi %i16_lhs, %i16_rhs : vector<8xi16>
  %i16_sub = vector.subi %i16_add, %i16_rhs : vector<8xi16>
  %i16_mul = vector.muli %i16_sub, %i16_rhs : vector<8xi16>
  %i16_min = vector.minsi %i16_mul, %i16_rhs : vector<8xi16>
  %i16_max = vector.maxsi %i16_min, %i16_lhs : vector<8xi16>
  %i16_umin = vector.minui %i16_max, %i16_rhs : vector<8xi16>
  %i16_result = vector.maxui %i16_umin, %i16_lhs : vector<8xi16>

  %i32_add = vector.addi %i32_lhs, %i32_rhs : vector<4xi32>
  %i32_sub = vector.subi %i32_add, %i32_rhs : vector<4xi32>
  %i32_mul = vector.muli %i32_sub, %i32_rhs : vector<4xi32>
  %i32_min = vector.minsi %i32_mul, %i32_rhs : vector<4xi32>
  %i32_max = vector.maxsi %i32_min, %i32_lhs : vector<4xi32>
  %i32_umin = vector.minui %i32_max, %i32_rhs : vector<4xi32>
  %i32_umax = vector.maxui %i32_umin, %i32_lhs : vector<4xi32>
  %i32_shl = vector.shli %i32_umax, %i32_rhs : vector<4xi32>
  %i32_shrs = vector.shrsi %i32_shl, %i32_rhs : vector<4xi32>
  %i32_result = vector.shrui %i32_shrs, %i32_rhs : vector<4xi32>

  %i64_add = vector.addi %i64_lhs, %i64_rhs : vector<2xi64>
  %i64_sub = vector.subi %i64_add, %i64_rhs : vector<2xi64>
  %i64_shl = vector.shli %i64_sub, %i64_rhs : vector<2xi64>
  %i64_result = vector.shrui %i64_shl, %i64_rhs : vector<2xi64>
  func.return %i8_result, %i16_result, %i32_result, %i64_result : vector<16xi8>, vector<8xi16>, vector<4xi32>, vector<2xi64>
}

