low.func.def target<x86.avx2.core>(@target) abi(object_function) abi_layout({signature = (vector<8xi16>, vector<8xi16>) -> (vector<8xi16>)}) @halfword_rotation(%value: reg<x86.xmm>, %amount: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
