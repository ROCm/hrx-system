low.func.def target<x86.avx2.core>(@target) abi(object_function) abi_layout({signature = (vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<4xf64>, vector<4xf64>, vector<4xf64>) -> (vector<8xf32>, vector<4xf64>)}) @float_ymm_families(%f32_lhs: reg<x86.ymm>, %f32_rhs: reg<x86.ymm>, %f32_acc: reg<x86.ymm>, %f64_lhs: reg<x86.ymm>, %f64_rhs: reg<x86.ymm>, %f64_acc: reg<x86.ymm>) -> (reg<x86.ymm>, reg<x86.ymm>) asm {
  %f32_add = vaddps.ymm %f32_lhs, %f32_rhs
  %f32_sub = vsubps.ymm %f32_add, %f32_rhs
  %f32_mul = vmulps.ymm %f32_sub, %f32_rhs
  %f32_div = vdivps.ymm %f32_mul, %f32_rhs
  %30 = copy %f32_acc : reg<x86.ymm> -> reg<x86.ymm>
  %f32_result = vfmadd231ps.ymm %30, %f32_div, %f32_rhs
  %f64_add = vaddpd.ymm %f64_lhs, %f64_rhs
  %f64_sub = vsubpd.ymm %f64_add, %f64_rhs
  %f64_mul = vmulpd.ymm %f64_sub, %f64_rhs
  %f64_div = vdivpd.ymm %f64_mul, %f64_rhs
  %36 = copy %f64_acc : reg<x86.ymm> -> reg<x86.ymm>
  %f64_result = vfmadd231pd.ymm %36, %f64_div, %f64_rhs
  return %f32_result, %f64_result
}

// ====

// Scalar floating arithmetic uses the same complete f32/f64 operation family
// as packed vectors, including division and fused multiply-add.
x86.target<avx2> @target

func.def target(@target) @scalar_float_arithmetic(%f32_lhs: f32, %f32_rhs: f32, %f32_acc: f32, %f64_lhs: f64, %f64_rhs: f64, %f64_acc: f64) -> (f32, f64) {
  %f32_add = scalar.addf %f32_lhs, %f32_rhs : f32
  %f32_sub = scalar.subf %f32_add, %f32_rhs : f32
  %f32_mul = scalar.mulf %f32_sub, %f32_rhs : f32
  %f32_div = scalar.divf %f32_mul, %f32_rhs : f32
  %f32_result = scalar.fmaf %f32_div, %f32_rhs, %f32_acc : f32
  %f64_add = scalar.addf %f64_lhs, %f64_rhs : f64
  %f64_sub = scalar.subf %f64_add, %f64_rhs : f64
  %f64_mul = scalar.mulf %f64_sub, %f64_rhs : f64
  %f64_div = scalar.divf %f64_mul, %f64_rhs : f64
  %f64_result = scalar.fmaf %f64_div, %f64_rhs, %f64_acc : f64
  func.return %f32_result, %f64_result : f32, f64
}

// ----
low.func.def target<x86.avx2.core>(@target) abi(object_function) abi_layout({signature = (f32, f32, f32, f64, f64, f64) -> (f32, f64)}) @scalar_float_arithmetic(%f32_lhs: reg<x86.xmm>, %f32_rhs: reg<x86.xmm>, %f32_acc: reg<x86.xmm>, %f64_lhs: reg<x86.xmm>, %f64_rhs: reg<x86.xmm>, %f64_acc: reg<x86.xmm>) -> (reg<x86.xmm>, reg<x86.xmm>) asm {
  %f32_add = vaddss.xmm %f32_lhs, %f32_rhs
  %f32_sub = vsubss.xmm %f32_add, %f32_rhs
  %f32_mul = vmulss.xmm %f32_sub, %f32_rhs
  %f32_div = vdivss.xmm %f32_mul, %f32_rhs
  %30 = copy %f32_acc : reg<x86.xmm> -> reg<x86.xmm>
  %f32_result = vfmadd231ss.xmm %30, %f32_div, %f32_rhs
  %f64_add = vaddsd.xmm %f64_lhs, %f64_rhs
  %f64_sub = vsubsd.xmm %f64_add, %f64_rhs
  %f64_mul = vmulsd.xmm %f64_sub, %f64_rhs
  %f64_div = vdivsd.xmm %f64_mul, %f64_rhs
  %36 = copy %f64_acc : reg<x86.xmm> -> reg<x86.xmm>
  %f64_result = vfmadd231sd.xmm %36, %f64_div, %f64_rhs
  return %f32_result, %f64_result
}

// ====

// The function ABI carries a 64-bit vector in the low half of an XMM register.
// Packed operations may update its inactive physical lanes because only the
// two logical lanes are observable.
x86.target<avx2> @target

func.def target(@target) @subnative_integer_arithmetic(%condition: i1, %lhs: vector<2xi32>, %rhs: vector<2xi32>) -> (vector<2xi32>) {
  %product = vector.muli %lhs, %rhs : vector<2xi32>
  %bias = vector.splati 8388608 : vector<2xi32>
  %adjusted = vector.subi %product, %bias : vector<2xi32>
  %result = scf.select %condition, %adjusted, %product : vector<2xi32>
  func.return %result : vector<2xi32>
}

// ----
low.func.def target<x86.avx2.core>(@target) abi(object_function) abi_layout({signature = (i1, vector<2xi32>, vector<2xi32>) -> (vector<2xi32>)}) @subnative_integer_arithmetic(%condition: reg<x86.gpr32>, %lhs: reg<x86.xmm>, %rhs: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %product = vpmulld.xmm %lhs, %rhs
  %13 = mov.imm32 8388608
  %14 = vmovd.xmm.gpr32 %13
  %bias = avx2.vpbroadcastd.xmm %14
  %adjusted = vpsubd.xmm %product, %bias
  %17 = mov.imm32 0
  %18 = sub.gpr32 %17, %condition
  %19 = vmovd.xmm.gpr32 %18
  %20 = avx2.vpbroadcastd.xmm %19
  %result = vpblendvb.xmm %product, %adjusted, %20
  return %result
}

// ====

// Floating packets use packed XMM instructions while exposing only their
// 64-bit logical payload.
x86.target<avx2> @target

func.def target(@target) @subnative_float_arithmetic(%f32_lhs: vector<2xf32>, %f32_rhs: vector<2xf32>, %f64_lhs: vector<1xf64>, %f64_rhs: vector<1xf64>) -> (vector<2xf32>, vector<1xf64>) {
  %f32_acc = vector.splatf 1.0 : vector<2xf32>
  %f32_add = vector.addf %f32_lhs, %f32_rhs : vector<2xf32>
  %f32_sub = vector.subf %f32_add, %f32_rhs : vector<2xf32>
  %f32_mul = vector.mulf %f32_sub, %f32_rhs : vector<2xf32>
  %f32_div = vector.divf %f32_mul, %f32_rhs : vector<2xf32>
  %f32_result = vector.fmaf %f32_div, %f32_rhs, %f32_acc : vector<2xf32>
  %f32_bits = vector.bitcast %f32_result : vector<2xf32> to vector<2xi32>
  %f32_restored = vector.bitcast %f32_bits : vector<2xi32> to vector<2xf32>
  %f64_acc = vector.splatf 1.0 : vector<1xf64>
  %f64_add = vector.addf %f64_lhs, %f64_rhs : vector<1xf64>
  %f64_sub = vector.subf %f64_add, %f64_rhs : vector<1xf64>
  %f64_mul = vector.mulf %f64_sub, %f64_rhs : vector<1xf64>
  %f64_div = vector.divf %f64_mul, %f64_rhs : vector<1xf64>
  %f64_result = vector.fmaf %f64_div, %f64_rhs, %f64_acc : vector<1xf64>
  func.return %f32_restored, %f64_result : vector<2xf32>, vector<1xf64>
}

// ----
low.func.def target<x86.avx2.core>(@target) abi(object_function) abi_layout({signature = (vector<2xf32>, vector<2xf32>, vector<1xf64>, vector<1xf64>) -> (vector<2xf32>, vector<1xf64>)}) @subnative_float_arithmetic(%f32_lhs: reg<x86.xmm>, %f32_rhs: reg<x86.xmm>, %f64_lhs: reg<x86.xmm>, %f64_rhs: reg<x86.xmm>) -> (reg<x86.xmm>, reg<x86.xmm>) asm {
  %26 = mov.imm32 1065353216
  %27 = vmovd.xmm.gpr32 %26
  %f32_acc = avx2.vpbroadcastd.xmm %27
  %f32_add = vaddps.xmm %f32_lhs, %f32_rhs
  %f32_sub = vsubps.xmm %f32_add, %f32_rhs
  %f32_mul = vmulps.xmm %f32_sub, %f32_rhs
  %f32_div = vdivps.xmm %f32_mul, %f32_rhs
  %33 = copy %f32_acc : reg<x86.xmm> -> reg<x86.xmm>
  %f32_result = vfmadd231ps.xmm %33, %f32_div, %f32_rhs
  %35 = mov.imm64 4607182418800017408
  %36 = vmovq.xmm.gpr64 %35
  %f64_acc = avx2.vpbroadcastq.xmm %36
  %f64_add = vaddpd.xmm %f64_lhs, %f64_rhs
  %f64_sub = vsubpd.xmm %f64_add, %f64_rhs
  %f64_mul = vmulpd.xmm %f64_sub, %f64_rhs
  %f64_div = vdivpd.xmm %f64_mul, %f64_rhs
  %42 = copy %f64_acc : reg<x86.xmm> -> reg<x86.xmm>
  %f64_result = vfmadd231pd.xmm %42, %f64_div, %f64_rhs
  return %f32_result, %f64_result
}

