x86.target<avx2> @target

func.def target(@target) @halfword_rotation(%value: vector<8xi16>, %amount: vector<8xi16>) -> (vector<8xi16>) {
  %result = vector.rotli %value, %amount : vector<8xi16>
  func.return %result : vector<8xi16>
}

