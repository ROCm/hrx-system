func.def target(@target) @uniform_index_operands(%lhs: index, %rhs: index) -> (index, index, index, index, index) {
  %multiply = index.mul %lhs, %rhs : index
  %and = index.andi %lhs, %rhs : index
  %or = index.ori %lhs, %rhs : index
  %xor = index.xori %lhs, %rhs : index
  %subtract = index.sub %lhs, %rhs : index
  func.return %multiply, %and, %or, %xor, %subtract : index, index, index, index, index
}

// ----
low.func.def target<x86.avx2.core>(@target) abi(object_function) @uniform_index_operands(%lhs: reg<x86.gpr64>, %rhs: reg<x86.gpr64>) -> (reg<x86.gpr64>, reg<x86.gpr64>, reg<x86.gpr64>, reg<x86.gpr64>, reg<x86.gpr64>) asm {
  %19 = copy %lhs : reg<x86.gpr64> -> reg<x86.gpr64>
  %multiply = imul.gpr64 %19, %rhs
  %21 = copy %lhs : reg<x86.gpr64> -> reg<x86.gpr64>
  %and = and.gpr64 %21, %rhs
  %23 = copy %lhs : reg<x86.gpr64> -> reg<x86.gpr64>
  %or = or.gpr64 %23, %rhs
  %25 = copy %lhs : reg<x86.gpr64> -> reg<x86.gpr64>
  %xor = xor.gpr64 %25, %rhs
  %27 = copy %lhs : reg<x86.gpr64> -> reg<x86.gpr64>
  %subtract = sub.gpr64 %27, %rhs
  return %multiply, %and, %or, %xor, %subtract
}

