low.func.def target<x86.avx2.core>(@target) abi(object_function) @uniform_rhs_index_operands(%input_view: reg<x86.gpr64>, %uniform: reg<x86.gpr64>) -> (reg<x86.gpr64>, reg<x86.gpr64>, reg<x86.gpr64>, reg<x86.gpr64>, reg<x86.gpr64>) asm {
  %word = mov.load.gpr32 %input_view {disp32 = 0}
