x86.target<avx2> @target

func.def target(@target) @uniform_lhs_index_operands(%input: buffer, %uniform: index) -> (index, index, index, index, index) {
  %base = index.constant 0 : offset
  %aligned_input = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %input_view = buffer.view %aligned_input[%base] : buffer -> view<1xi32>
  %word = view.load %input_view[0] : view<1xi32> -> i32
  %value = index.cast %word : i32 to index
  %multiply = index.mul %uniform, %value : index
  %and = index.andi %uniform, %value : index
  %or = index.ori %uniform, %value : index
  %xor = index.xori %uniform, %value : index
  %subtract = index.sub %uniform, %value : index
  func.return %multiply, %and, %or, %xor, %subtract : index, index, index, index, index
}

// ----
low.func.def target<x86.avx2.core>(@target) abi(object_function) @uniform_lhs_index_operands(%input_view: reg<x86.gpr64>, %uniform: reg<x86.gpr64>) -> (reg<x86.gpr64>, reg<x86.gpr64>, reg<x86.gpr64>, reg<x86.gpr64>, reg<x86.gpr64>) asm {
  %word = mov.load.gpr32 %input_view {disp32 = 0}
  %value = movsxd.gpr64.gpr32 %word
  %26 = copy %uniform : reg<x86.gpr64> -> reg<x86.gpr64>
  %multiply = imul.gpr64 %26, %value
  %28 = copy %uniform : reg<x86.gpr64> -> reg<x86.gpr64>
  %and = and.gpr64 %28, %value
  %30 = copy %uniform : reg<x86.gpr64> -> reg<x86.gpr64>
  %or = or.gpr64 %30, %value
  %32 = copy %uniform : reg<x86.gpr64> -> reg<x86.gpr64>
  %xor = xor.gpr64 %32, %value
  %34 = copy %uniform : reg<x86.gpr64> -> reg<x86.gpr64>
  %subtract = sub.gpr64 %34, %value
  return %multiply, %and, %or, %xor, %subtract
}

