x86.target<avx2> @target

func.def target(@target) @varying_index_operands(%input: buffer) -> (index, index, index, index, index) {
  %base = index.constant 0 : offset
  %aligned_input = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %input_view = buffer.view %aligned_input[%base] : buffer -> view<2xi32>
  %lhs_word = view.load %input_view[0] : view<2xi32> -> i32
  %rhs_word = view.load %input_view[1] : view<2xi32> -> i32
  %lhs = index.cast %lhs_word : i32 to index
  %rhs = index.cast %rhs_word : i32 to index
  %multiply = index.mul %lhs, %rhs : index
  %and = index.andi %lhs, %rhs : index
  %or = index.ori %lhs, %rhs : index
  %xor = index.xori %lhs, %rhs : index
  %subtract = index.sub %lhs, %rhs : index
  func.return %multiply, %and, %or, %xor, %subtract : index, index, index, index, index
}

// ----
low.func.def target<x86.avx2.core>(@target) abi(object_function) @varying_index_operands(%input_view: reg<x86.gpr64>) -> (reg<x86.gpr64>, reg<x86.gpr64>, reg<x86.gpr64>, reg<x86.gpr64>, reg<x86.gpr64>) asm {
  %lhs_word = mov.load.gpr32 %input_view {disp32 = 0}
  %rhs_word = mov.load.gpr32 %input_view {disp32 = 4}
  %lhs = movsxd.gpr64.gpr32 %lhs_word
  %rhs = movsxd.gpr64.gpr32 %rhs_word
  %28 = copy %lhs : reg<x86.gpr64> -> reg<x86.gpr64>
  %multiply = imul.gpr64 %28, %rhs
  %30 = copy %lhs : reg<x86.gpr64> -> reg<x86.gpr64>
  %and = and.gpr64 %30, %rhs
  %32 = copy %lhs : reg<x86.gpr64> -> reg<x86.gpr64>
  %or = or.gpr64 %32, %rhs
  %34 = copy %lhs : reg<x86.gpr64> -> reg<x86.gpr64>
  %xor = xor.gpr64 %34, %rhs
  %36 = copy %lhs : reg<x86.gpr64> -> reg<x86.gpr64>
  %subtract = sub.gpr64 %36, %rhs
  return %multiply, %and, %or, %xor, %subtract
}

// ====

x86.target<avx2> @target

func.def target(@target) @bounded_offset_difference(%input: buffer, %wide_limit: offset) -> (offset) {
  %base = index.constant 0 : offset
  %aligned_input = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %input_view = buffer.view %aligned_input[%base] : buffer -> view<1xi32>
  %word = view.load %input_view[0] : view<1xi32> -> i32
  %bounded_word = scalar.assume %word [range(%word, 0, 1023)] : i32
  %position = index.cast %bounded_word : i32 to offset
  %limit = index.assume %wide_limit [range(%wide_limit, 1024, 2047)] : offset
  %remaining = index.sub %limit, %position : offset
  func.return %remaining : offset
}

// ----
low.func.def target<x86.avx2.core>(@target) abi(object_function) @bounded_offset_difference(%input_view: reg<x86.gpr64>, %limit: reg<x86.gpr64>) -> (reg<x86.gpr64>) asm {
  %bounded_word = mov.load.gpr32 %input_view {disp32 = 0}
  %position = movzx.gpr64.gpr32 %bounded_word
  %16 = copy %limit : reg<x86.gpr64> -> reg<x86.gpr64>
  %remaining = sub.gpr64 %16, %position
  return %remaining
}

