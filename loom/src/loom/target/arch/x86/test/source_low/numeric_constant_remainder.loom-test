// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_constant_remainder.loom-test
// RUN: emit source-low output=low

x86.target<avx2> @target

func.def target(@target) @constant_remainder_uniform(%value: i32) -> (i32) {
  %divisor = scalar.constant 3 : i32
  %remainder = scalar.remui %value, %divisor : i32
  func.return %remainder : i32
}

// ----
low.func.def target<x86.avx2.core>(@target) abi(object_function) @constant_remainder_uniform(%value: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  %6 = movzx.gpr64.gpr32 %value
  %7 = mov.imm64 2863311531
  %8 = copy %6 : reg<x86.gpr64> -> reg<x86.gpr64>
  %9 = imul.gpr64 %8, %7
  %10 = copy %9 : reg<x86.gpr64> -> reg<x86.gpr64>
  %11 = shr.imm.gpr64 %10 {shift = 33}
  %12 = lea.add_scale.gpr32 %11, %11 {disp32 = 0, scale = 2}
  %13 = copy %value : reg<x86.gpr32> -> reg<x86.gpr32>
  %remainder = sub.gpr32 %13, %12
  return %remainder
}

// ====

x86.target<avx2> @target

func.def target(@target) @constant_remainder_loaded(%input: buffer) -> (i32, index) {
  %base = index.constant 0 : offset
  %aligned_input = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %input_view = buffer.view %aligned_input[%base] : buffer -> view<1xi32>
  %value = view.load %input_view[0] : view<1xi32> -> i32
  %divisor = scalar.constant 3 : i32
  %remainder = scalar.remui %value, %divisor : i32
  %mask = scalar.constant 2147483647 : i32
  %nonnegative = scalar.andi %value, %mask : i32
  %position = index.cast %nonnegative : i32 to index
  %index_divisor = index.constant 3 : index
  %index_remainder = index.rem %position, %index_divisor : index
  func.return %remainder, %index_remainder : i32, index
}

// ----
low.func.def target<x86.avx2.core>(@target) abi(object_function) @constant_remainder_loaded(%input_view: reg<x86.gpr64>) -> (reg<x86.gpr32>, reg<x86.gpr64>) asm {
  %value = mov.load.gpr32 %input_view {disp32 = 0}
  %18 = movzx.gpr64.gpr32 %value
  %19 = mov.imm64 2863311531
  %20 = copy %18 : reg<x86.gpr64> -> reg<x86.gpr64>
  %21 = imul.gpr64 %20, %19
  %22 = copy %21 : reg<x86.gpr64> -> reg<x86.gpr64>
  %23 = shr.imm.gpr64 %22 {shift = 33}
  %24 = lea.add_scale.gpr32 %23, %23 {disp32 = 0, scale = 2}
  %25 = copy %value : reg<x86.gpr32> -> reg<x86.gpr32>
  %remainder = sub.gpr32 %25, %24
  %mask = mov.imm32 2147483647
  %28 = copy %value : reg<x86.gpr32> -> reg<x86.gpr32>
  %nonnegative = and.gpr32 %28, %mask
  %position = movzx.gpr64.gpr32 %nonnegative
  %32 = copy %position : reg<x86.gpr64> -> reg<x86.gpr64>
  %33 = imul.gpr64 %32, %19
  %34 = copy %33 : reg<x86.gpr64> -> reg<x86.gpr64>
  %35 = shr.imm.gpr64 %34 {shift = 33}
  %36 = lea.add_scale %35, %35 {disp32 = 0, scale = 2}
  %37 = copy %position : reg<x86.gpr64> -> reg<x86.gpr64>
  %index_remainder = sub.gpr64 %37, %36
  return %remainder, %index_remainder
}

// ====

x86.target<avx2> @target

func.def target(@target) @constant_remainder_factors(%word: i32, %position: index) -> (i32, i32, index, index) {
  %bounded = index.assume %position [range(%position, 0, 4294967295)] : index
  %c5 = scalar.constant 5 : i32
  %c9 = scalar.constant 9 : i32
  %c5_index = index.constant 5 : index
  %c9_index = index.constant 9 : index
  %word_five = scalar.remui %word, %c5 : i32
  %word_nine = scalar.remui %word, %c9 : i32
  %position_five = index.rem %bounded, %c5_index : index
  %position_nine = index.rem %bounded, %c9_index : index
  func.return %word_five, %word_nine, %position_five, %position_nine : i32, i32, index, index
}

// ----
low.func.def target<x86.avx2.core>(@target) abi(object_function) @constant_remainder_factors(%word: reg<x86.gpr32>, %bounded: reg<x86.gpr64>) -> (reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr64>, reg<x86.gpr64>) asm {
  %21 = movzx.gpr64.gpr32 %word
  %22 = mov.imm64 3435973837
  %23 = copy %21 : reg<x86.gpr64> -> reg<x86.gpr64>
  %24 = imul.gpr64 %23, %22
  %25 = copy %24 : reg<x86.gpr64> -> reg<x86.gpr64>
  %26 = shr.imm.gpr64 %25 {shift = 34}
  %27 = lea.add_scale.gpr32 %26, %26 {disp32 = 0, scale = 4}
  %28 = copy %word : reg<x86.gpr32> -> reg<x86.gpr32>
  %word_five = sub.gpr32 %28, %27
  %31 = imul.imm.gpr64 %21 {imm32 = 954437177}
  %32 = copy %31 : reg<x86.gpr64> -> reg<x86.gpr64>
  %33 = shr.imm.gpr64 %32 {shift = 33}
  %34 = lea.add_scale.gpr32 %33, %33 {disp32 = 0, scale = 8}
  %35 = copy %word : reg<x86.gpr32> -> reg<x86.gpr32>
  %word_nine = sub.gpr32 %35, %34
  %38 = copy %bounded : reg<x86.gpr64> -> reg<x86.gpr64>
  %39 = imul.gpr64 %38, %22
  %40 = copy %39 : reg<x86.gpr64> -> reg<x86.gpr64>
  %41 = shr.imm.gpr64 %40 {shift = 34}
  %42 = lea.add_scale %41, %41 {disp32 = 0, scale = 4}
  %43 = copy %bounded : reg<x86.gpr64> -> reg<x86.gpr64>
  %position_five = sub.gpr64 %43, %42
  %45 = imul.imm.gpr64 %bounded {imm32 = 954437177}
  %46 = copy %45 : reg<x86.gpr64> -> reg<x86.gpr64>
  %47 = shr.imm.gpr64 %46 {shift = 33}
  %48 = lea.add_scale %47, %47 {disp32 = 0, scale = 8}
  %49 = copy %bounded : reg<x86.gpr64> -> reg<x86.gpr64>
  %position_nine = sub.gpr64 %49, %48
  return %word_five, %word_nine, %position_five, %position_nine
}

// ====

x86.target<avx2> @target

func.def target(@target) @constant_remainder_by_seven(%word: i32, %position: index) -> (i32, index, i32, index) {
  %bounded = index.assume %position [range(%position, 0, 4294967295)] : index
  %word_divisor = scalar.constant 7 : i32
  %index_divisor = index.constant 7 : index
  %word_remainder = scalar.remui %word, %word_divisor : i32
  %index_remainder = index.rem %bounded, %index_divisor : index
  func.return %word_remainder, %index_remainder, %word, %bounded : i32, index, i32, index
}

// ----
low.func.def target<x86.avx2.core>(@target) abi(object_function) @constant_remainder_by_seven(%word: reg<x86.gpr32>, %bounded: reg<x86.gpr64>) -> (reg<x86.gpr32>, reg<x86.gpr64>, reg<x86.gpr32>, reg<x86.gpr64>) asm {
  %17 = copy %word : reg<x86.gpr32> -> reg<x86.gpr32>
  %18 = movzx.gpr64.gpr32 %17
  %19 = mov.imm64 2635249153617166336
  %20 = copy %18 : reg<x86.gpr64> -> reg<x86.rax>
  %21 = mul.high.gpr64 %20, %19
  %22 = copy %21 : reg<x86.rdx> -> reg<x86.gpr64>
  %23 = lea.scale %22 {disp32 = 0, scale = 8}
  %24 = copy %22 : reg<x86.gpr64> -> reg<x86.gpr64>
  %25 = sub.gpr64 %24, %23
  %26 = mov.trunc.gpr32.gpr64 %25
  %27 = copy %26 : reg<x86.gpr32> -> reg<x86.gpr32>
  %word_remainder = add.gpr32 %27, %17
  %29 = copy %bounded : reg<x86.gpr64> -> reg<x86.gpr64>
  %31 = copy %29 : reg<x86.gpr64> -> reg<x86.rax>
  %32 = mul.high.gpr64 %31, %19
  %33 = copy %32 : reg<x86.rdx> -> reg<x86.gpr64>
  %34 = lea.scale %33 {disp32 = 0, scale = 8}
  %35 = copy %33 : reg<x86.gpr64> -> reg<x86.gpr64>
  %36 = sub.gpr64 %35, %34
  %37 = copy %36 : reg<x86.gpr64> -> reg<x86.gpr64>
  %index_remainder = add.gpr64 %37, %29
  return %word_remainder, %index_remainder, %word, %bounded
}
