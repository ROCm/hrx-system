x86.target<avx2> @target

func.def target(@target) @constant_remainder_by_seven(%word: i32, %position: index) -> (i32, index, i32, index) {
  %bounded = index.assume %position [range(%position, 0, 4294967295)] : index
  %word_divisor = scalar.constant 7 : i32
  %index_divisor = index.constant 7 : index
  %word_remainder = scalar.remui %word, %word_divisor : i32
  %index_remainder = index.rem %bounded, %index_divisor : index
  func.return %word_remainder, %index_remainder, %word, %bounded : i32, index, i32, index
}

// ----
low.func.def target<x86.avx2.core>(@target) abi(object_function) @constant_remainder_by_seven(%word: reg<x86.gpr32>, %bounded: reg<x86.gpr64>) -> (reg<x86.gpr32>, reg<x86.gpr64>, reg<x86.gpr32>, reg<x86.gpr64>) asm {
  %17 = movzx.gpr64.gpr32 %word
  %18 = mov.imm64 2635249153387078803
  %19 = copy %17 : reg<x86.gpr64> -> reg<x86.gpr64>
  %20 = imul.gpr64 %19, %18
  %21 = mov.imm64 7
  %22 = copy %20 : reg<x86.gpr64> -> reg<x86.rax>
  %23 = mul.high.gpr64 %22, %21
  %24 = copy %23 : reg<x86.rdx> -> reg<x86.gpr64>
  %word_remainder = mov.trunc.gpr32.gpr64 %24
  %27 = copy %bounded : reg<x86.gpr64> -> reg<x86.gpr64>
  %28 = imul.gpr64 %27, %18
  %30 = copy %28 : reg<x86.gpr64> -> reg<x86.rax>
  %31 = mul.high.gpr64 %30, %21
  %index_remainder = copy %31 : reg<x86.rdx> -> reg<x86.gpr64>
  return %word_remainder, %index_remainder, %word, %bounded
}
