  %29 = copy %21 : reg<x86.gpr32> -> reg<x86.gpr32>
  %word_five = sub.gpr32 %29, %28
  %31 = copy %word : reg<x86.gpr32> -> reg<x86.gpr32>
  %32 = movzx.gpr64.gpr32 %31
  %33 = mov.imm64 954437177
  %34 = copy %32 : reg<x86.gpr64> -> reg<x86.gpr64>
  %35 = imul.gpr64 %34, %33
  %36 = copy %35 : reg<x86.gpr64> -> reg<x86.gpr64>
  %37 = shr.imm.gpr64 %36 {shift = 33}
  %38 = lea.add_scale.gpr32 %37, %37 {disp32 = 0, scale = 8}
  %39 = copy %31 : reg<x86.gpr32> -> reg<x86.gpr32>
  %word_nine = sub.gpr32 %39, %38
  %41 = copy %bounded : reg<x86.gpr64> -> reg<x86.gpr64>
  %43 = copy %41 : reg<x86.gpr64> -> reg<x86.gpr64>
  %44 = imul.gpr64 %43, %23
  %45 = copy %44 : reg<x86.gpr64> -> reg<x86.gpr64>
  %46 = shr.imm.gpr64 %45 {shift = 34}
  %47 = lea.add_scale %46, %46 {disp32 = 0, scale = 4}
  %48 = copy %41 : reg<x86.gpr64> -> reg<x86.gpr64>
  %position_five = sub.gpr64 %48, %47
  %50 = copy %bounded : reg<x86.gpr64> -> reg<x86.gpr64>
  %52 = copy %50 : reg<x86.gpr64> -> reg<x86.gpr64>
  %53 = imul.gpr64 %52, %33
  %54 = copy %53 : reg<x86.gpr64> -> reg<x86.gpr64>
  %55 = shr.imm.gpr64 %54 {shift = 33}
  %56 = lea.add_scale %55, %55 {disp32 = 0, scale = 8}
  %57 = copy %50 : reg<x86.gpr64> -> reg<x86.gpr64>
  %position_nine = sub.gpr64 %57, %56
  return %word_five, %word_nine, %position_five, %position_nine
}

