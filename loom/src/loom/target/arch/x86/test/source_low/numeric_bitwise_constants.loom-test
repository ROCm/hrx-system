// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_bitwise_constants.loom-test
// RUN: emit source-low output=low

x86.target<scalar> @target

func.def target(@target) @bitwise_word_constants(%input: i32, %mask_input: i32) -> (i32, i32, i32) {
  %mask = scalar.assume %mask_input [range(%mask_input, 255, 255)] : i32
  %tag = scalar.constant -2147483648 : i32
  %toggle = scalar.constant 2147483647 : i32
  %masked = scalar.andi %input, %mask : i32
  %tagged = scalar.ori %tag, %input : i32
  %toggled = scalar.xori %input, %toggle : i32
  func.return %masked, %tagged, %toggled : i32, i32, i32
}

// ----
low.func.def target<x86.scalar.core>(@target) abi(object_function) @bitwise_word_constants(%input: reg<x86.gpr32>, %mask_input: reg<x86.gpr32>) -> (reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr32>) asm {
  %17 = copy %input : reg<x86.gpr32> -> reg<x86.gpr32>
  %masked = and.imm.gpr32 %17 {imm32 = 255}
  %19 = copy %input : reg<x86.gpr32> -> reg<x86.gpr32>
  %tagged = or.imm.gpr32 %19 {imm32 = -2147483648}
  %21 = copy %input : reg<x86.gpr32> -> reg<x86.gpr32>
  %toggled = xor.imm.gpr32 %21 {imm32 = 2147483647}
  return %masked, %tagged, %toggled
}

