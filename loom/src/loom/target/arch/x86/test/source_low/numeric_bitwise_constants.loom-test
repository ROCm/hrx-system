x86.target<scalar> @target

func.def target(@target) @bitwise_wide_constant_boundaries(%input: i64) -> (i64, i64, i64) {
  %mask = scalar.constant 4294967295 : i64
  %tag = scalar.constant 2147483648 : i64
  %toggle = scalar.constant -2147483649 : i64
  %masked = scalar.andi %input, %mask : i64
  %tagged = scalar.ori %tag, %input : i64
  %toggled = scalar.xori %input, %toggle : i64
  func.return %masked, %tagged, %toggled : i64, i64, i64
}

