func.def @vector_i32x2_uniform_shift_unsigned(%input_arg: buffer, %output_arg: buffer) {
  %input_buffer = buffer.assume.alignment %input_arg {minimum_alignment = 8} : buffer
  %output_buffer = buffer.assume.alignment %output_arg {minimum_alignment = 8} : buffer
  %base = index.constant 0 : offset
  %input_view = buffer.view %input_buffer[%base] : buffer -> view<2xi32>
