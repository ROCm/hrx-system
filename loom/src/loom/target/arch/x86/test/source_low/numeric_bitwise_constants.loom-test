x86.target<scalar> @target

func.def target(@target) @bitwise_wide_signed_constants(%input: i64) -> (i64, i64, i64) {
  %mask = scalar.constant -2147483648 : i64
  %tag = scalar.constant 2147483647 : i64
  %toggle = scalar.constant -1 : i64
  %masked = scalar.andi %mask, %input : i64
  %tagged = scalar.ori %input, %tag : i64
  %toggled = scalar.xori %toggle, %input : i64
  func.return %masked, %tagged, %toggled : i64, i64, i64
}

// ----
low.func.def target<x86.scalar.core>(@target) abi(object_function) @bitwise_wide_signed_constants(%input: reg<x86.gpr64>) -> (reg<x86.gpr64>, reg<x86.gpr64>, reg<x86.gpr64>) asm {
  %14 = copy %input : reg<x86.gpr64> -> reg<x86.gpr64>
  %masked = and.imm.gpr64 %14 {imm32 = -2147483648}
  %16 = copy %input : reg<x86.gpr64> -> reg<x86.gpr64>
  %tagged = or.imm.gpr64 %16 {imm32 = 2147483647}
  %18 = copy %input : reg<x86.gpr64> -> reg<x86.gpr64>
  %toggled = xor.imm.gpr64 %18 {imm32 = -1}
  return %masked, %tagged, %toggled
}

