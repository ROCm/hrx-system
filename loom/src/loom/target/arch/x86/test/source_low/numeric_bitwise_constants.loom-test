// RUN: emit source-low target=x86:scalar output=low

func.def @bitwise_word_constants(%input: i32, %mask_input: i32) -> (i32, i32, i32) {
  %mask = scalar.assume %mask_input [range(%mask_input, 255, 255)] : i32
  %tag = scalar.constant -2147483648 : i32
  %toggle = scalar.constant 2147483647 : i32
  %masked = scalar.andi %input, %mask : i32
  %tagged = scalar.ori %tag, %input : i32
  %toggled = scalar.xori %input, %toggle : i32
  func.return %masked, %tagged, %toggled : i32, i32, i32
}

// ----
low.func.def target<x86.scalar.core> abi(object_function) @bitwise_word_constants(%input: reg<x86.gpr32>, %mask_input: reg<x86.gpr32>) -> (reg<x86.gpr32>, reg<x86.gpr32>, reg<x86.gpr32>) asm {
  %17 = copy %input : reg<x86.gpr32> -> reg<x86.gpr32>
  %masked = and.imm.gpr32 %17 {imm32 = 255}
  %19 = copy %input : reg<x86.gpr32> -> reg<x86.gpr32>
  %tagged = or.imm.gpr32 %19 {imm32 = -2147483648}
  %21 = copy %input : reg<x86.gpr32> -> reg<x86.gpr32>
  %toggled = xor.imm.gpr32 %21 {imm32 = 2147483647}
  return %masked, %tagged, %toggled
}

// ====

func.def @bitwise_wide_signed_constants(%input: i64) -> (i64, i64, i64) {
  %mask = scalar.constant -2147483648 : i64
  %tag = scalar.constant 2147483647 : i64
  %toggle = scalar.constant -1 : i64
  %masked = scalar.andi %mask, %input : i64
  %tagged = scalar.ori %input, %tag : i64
  %toggled = scalar.xori %toggle, %input : i64
  func.return %masked, %tagged, %toggled : i64, i64, i64
}

// ----
low.func.def target<x86.scalar.core> abi(object_function) @bitwise_wide_signed_constants(%input: reg<x86.gpr64>) -> (reg<x86.gpr64>, reg<x86.gpr64>, reg<x86.gpr64>) asm {
  %14 = copy %input : reg<x86.gpr64> -> reg<x86.gpr64>
  %masked = and.imm.gpr64 %14 {imm32 = -2147483648}
  %16 = copy %input : reg<x86.gpr64> -> reg<x86.gpr64>
  %tagged = or.imm.gpr64 %16 {imm32 = 2147483647}
  %18 = copy %input : reg<x86.gpr64> -> reg<x86.gpr64>
  %toggled = xor.imm.gpr64 %18 {imm32 = -1}
  return %masked, %tagged, %toggled
}

// ====

func.def @bitwise_wide_constant_boundaries(%input: i64) -> (i64, i64, i64) {
  %mask = scalar.constant 4294967295 : i64
  %tag = scalar.constant 2147483648 : i64
  %toggle = scalar.constant -2147483649 : i64
  %masked = scalar.andi %input, %mask : i64
  %tagged = scalar.ori %tag, %input : i64
  %toggled = scalar.xori %input, %toggle : i64
  func.return %masked, %tagged, %toggled : i64, i64, i64
}

// ----
low.func.def target<x86.scalar.core> abi(object_function) @bitwise_wide_constant_boundaries(%input: reg<x86.gpr64>) -> (reg<x86.gpr64>, reg<x86.gpr64>, reg<x86.gpr64>) asm {
  %mask = mov.imm64 4294967295
  %tag = mov.imm64 2147483648
  %toggle = mov.imm64 -2147483649
  %17 = copy %input : reg<x86.gpr64> -> reg<x86.gpr64>
  %masked = and.gpr64 %17, %mask
  %19 = copy %tag : reg<x86.gpr64> -> reg<x86.gpr64>
  %tagged = or.gpr64 %19, %input
  %21 = copy %input : reg<x86.gpr64> -> reg<x86.gpr64>
  %toggled = xor.gpr64 %21, %toggle
  return %masked, %tagged, %toggled
}

// ====

func.def @vector_i32x2_uniform_shift_left(%input_arg: buffer, %output_arg: buffer) {
  %input_buffer = buffer.assume.alignment %input_arg {minimum_alignment = 8} : buffer
  %output_buffer = buffer.assume.alignment %output_arg {minimum_alignment = 8} : buffer
  %base = index.constant 0 : offset
  %input_view = buffer.view %input_buffer[%base] : buffer -> view<2xi32>
  %output_view = buffer.view %output_buffer[%base] : buffer -> view<2xi32>
  %input = vector.load %input_view[0] : view<2xi32> -> vector<2xi32>
  %distance = vector.constant 23 : vector<2xi32>
  %shifted = vector.shli %input, %distance : vector<2xi32>
  vector.store %shifted, %output_view[0] : vector<2xi32>, view<2xi32>
  func.return
}

// ----
low.func.def target<x86.scalar.core> abi(object_function) @vector_i32x2_uniform_shift_left(%input_buffer: reg<x86.gpr64>, %output_buffer: reg<x86.gpr64>) asm {
  %23 = mov.load.gpr32 %input_buffer {disp32 = 0}
  %24 = mov.load.gpr32 %input_buffer {disp32 = 4}
  %25 = copy %23 : reg<x86.gpr32> -> reg<x86.gpr32>
  %26 = shl.imm.gpr32 %25 {shift = 23}
  %27 = copy %24 : reg<x86.gpr32> -> reg<x86.gpr32>
  %28 = shl.imm.gpr32 %27 {shift = 23}
  mov.store.gpr32 %26, %output_buffer {disp32 = 0}
  mov.store.gpr32 %28, %output_buffer {disp32 = 4}
  return
}

// ====

func.def @vector_i32x2_uniform_shift_signed(%input_arg: buffer, %output_arg: buffer) {
  %input_buffer = buffer.assume.alignment %input_arg {minimum_alignment = 8} : buffer
  %output_buffer = buffer.assume.alignment %output_arg {minimum_alignment = 8} : buffer
  %base = index.constant 0 : offset
  %input_view = buffer.view %input_buffer[%base] : buffer -> view<2xi32>
  %output_view = buffer.view %output_buffer[%base] : buffer -> view<2xi32>
  %input = vector.load %input_view[0] : view<2xi32> -> vector<2xi32>
  %distance = vector.constant 7 : vector<2xi32>
  %shifted = vector.shrsi %input, %distance : vector<2xi32>
  vector.store %shifted, %output_view[0] : vector<2xi32>, view<2xi32>
  func.return
}

// ----
low.func.def target<x86.scalar.core> abi(object_function) @vector_i32x2_uniform_shift_signed(%input_buffer: reg<x86.gpr64>, %output_buffer: reg<x86.gpr64>) asm {
  %23 = mov.load.gpr32 %input_buffer {disp32 = 0}
  %24 = mov.load.gpr32 %input_buffer {disp32 = 4}
  %25 = copy %23 : reg<x86.gpr32> -> reg<x86.gpr32>
  %26 = sar.imm.gpr32 %25 {shift = 7}
  %27 = copy %24 : reg<x86.gpr32> -> reg<x86.gpr32>
  %28 = sar.imm.gpr32 %27 {shift = 7}
  mov.store.gpr32 %26, %output_buffer {disp32 = 0}
  mov.store.gpr32 %28, %output_buffer {disp32 = 4}
  return
}

