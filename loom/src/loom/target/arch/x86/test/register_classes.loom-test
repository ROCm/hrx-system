// RUN: verify
// ERROR@+1: PARSE/003 {actual_token="x86.xmm", expected="register class defined by the selected descriptor set"}
low.func.decl target<x86.scalar.core> @scalar_absent_xmm(%input: reg<x86.xmm>)

// ====

