func.def target(@target) @doubleword_magnitude(%input: i64) -> (i64, i64, i1) {
  %value = scalar.assume %input [range(%input, -8, 8), ne(%input, 0)] : i64
  %absolute = scalar.absi %value : i64
  %lower = test.fact_range_lo %absolute : i64 -> i64
  %upper = test.fact_range_hi %absolute : i64 -> i64
  %nonzero = test.fact_non_zero %absolute : i64 -> i1
  func.return %lower, %upper, %nonzero : i64, i64, i1
}

// ----
x86.target<scalar> @target

func.def target(@target) @byte_magnitude(%input: i8) -> (i64, i64, i1) {
  %lower = scalar.constant 1 : i64
  %upper = scalar.constant 8 : i64
  %nonzero = scalar.constant true : i1
  func.return %lower, %upper, %nonzero : i64, i64, i1
}

func.def target(@target) @halfword_magnitude(%input: i16) -> (i64, i64, i1) {
  %lower = scalar.constant 1 : i64
  %upper = scalar.constant 8 : i64
  %nonzero = scalar.constant true : i1
  func.return %lower, %upper, %nonzero : i64, i64, i1
}

func.def target(@target) @word_magnitude(%input: i32) -> (i64, i64, i1) {
  %lower = scalar.constant 1 : i64
  %upper = scalar.constant 8 : i64
  %nonzero = scalar.constant true : i1
  func.return %lower, %upper, %nonzero : i64, i64, i1
}

func.def target(@target) @doubleword_magnitude(%input: i64) -> (i64, i64, i1) {
  %lower = scalar.constant 1 : i64
  %upper = scalar.constant 8 : i64
  %nonzero = scalar.constant true : i1
  func.return %lower, %upper, %nonzero : i64, i64, i1
