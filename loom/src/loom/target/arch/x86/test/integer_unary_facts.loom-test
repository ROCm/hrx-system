  %value = scalar.assume %input [range(%input, -8, 8), ne(%input, 0)] : i32
  %absolute = scalar.absi %value : i32
  %lower = test.fact_range_lo %absolute : i32 -> i64
  %upper = test.fact_range_hi %absolute : i32 -> i64
  %nonzero = test.fact_non_zero %absolute : i32 -> i1
  func.return %lower, %upper, %nonzero : i64, i64, i1
