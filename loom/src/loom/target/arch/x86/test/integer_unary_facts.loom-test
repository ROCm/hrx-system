// Recompute numeric facts after legalization invalidates its analysis. Native
// descriptor compositions retain the semantic operation through this boundary.
// RUN: pass target-legalize{mode=eager},canonicalize

x86.target<scalar> @target

func.def target(@target) @byte_magnitude(%input: i8) -> (i64, i64, i1) {
  %value = scalar.assume %input [range(%input, -8, 8), ne(%input, 0)] : i8
  %absolute = scalar.absi %value : i8
  %lower = test.fact_range_lo %absolute : i8 -> i64
  %upper = test.fact_range_hi %absolute : i8 -> i64
  %nonzero = test.fact_non_zero %absolute : i8 -> i1
  func.return %lower, %upper, %nonzero : i64, i64, i1
}

func.def target(@target) @halfword_magnitude(%input: i16) -> (i64, i64, i1) {
  %value = scalar.assume %input [range(%input, -8, 8), ne(%input, 0)] : i16
  %absolute = scalar.absi %value : i16
  %lower = test.fact_range_lo %absolute : i16 -> i64
  %upper = test.fact_range_hi %absolute : i16 -> i64
  %nonzero = test.fact_non_zero %absolute : i16 -> i1
  func.return %lower, %upper, %nonzero : i64, i64, i1
}

