load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")
load("//loom/build_tools/bazel:loom_check.bzl", "loom_check_test_suite")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_check_test_suite(
    name = "test",
    srcs = [
        "hal_materialization.loom-test",
        "hal_materialization_diagnostics.loom-test",
        "hal_query.loom-test",
        "instruction_immediates.loom-test",
        "integer_unary_facts.loom-test",
        "low_avx512_bf16.loom-test",
        "low_bmi2_variable_shift.loom-test",
        "target_feature_diagnostics.loom-test",
        "target_features.loom-test",
    ],
)

loom_check_test_suite(
    name = "artifact_test",
    srcs = ["register_classes.loom-test"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/emit:x86_elf",
    ]),
)
