// ====
// RUN: emit source-low output=module

x86.target<avx512> @target {features = [-avx512vl, -avx512vbmi]}

// Base AVX-512 retains a bounded byte composition without optional VBMI or VL.
// Word permutations at full width remain native even when VL is disabled.
func.def target(@target) @base_byte_zip(%even: vector<32xi8>, %odd: vector<32xi8>) -> (vector<64xi8>) {
  %result = vector.interleave<0> %even, %odd : vector<32xi8>, vector<32xi8> -> vector<64xi8>
  func.return %result : vector<64xi8>
}

func.def target(@target) @base_word_zip(%even: vector<16xf16>, %odd: vector<16xf16>) -> (vector<32xf16>) {
  %result = vector.interleave<0> %even, %odd : vector<16xf16>, vector<16xf16> -> vector<32xf16>
  func.return %result : vector<32xf16>
}

func.def target(@target) @base_dword_unzip(%source: vector<8xf32>) -> (vector<4xf32>, vector<4xf32>) {
  %even, %odd = vector.deinterleave<0> %source : vector<8xf32> -> vector<4xf32>, vector<4xf32>
  func.return %even, %odd : vector<4xf32>, vector<4xf32>
}

// ----
x86.target<avx512> @target {features = [-avx512vl, -avx512vbmi]}

low.func.def target<x86.avx512_features.core>(@target) abi(object_function) abi_layout({signature = (vector<32xi8>, vector<32xi8>) -> (vector<64xi8>)}) @base_byte_zip(%even: reg<x86.ymm>, %odd: reg<x86.ymm>) -> (reg<x86.zmm>) asm {
  %3 = vpunpcklbw.ymm %even, %odd
  %4 = vpunpckhbw.ymm %even, %odd
  %5 = vinserti64x4.concat.zmm %3, %4
  %result = vshufi64x2 %5, %5, 216
  return %result
}

low.func.def target<x86.avx512_features.core>(@target) abi(object_function) abi_layout({signature = (vector<16xf16>, vector<16xf16>) -> (vector<32xf16>)}) @base_word_zip(%even: reg<x86.ymm>, %odd: reg<x86.ymm>) -> (reg<x86.zmm>) asm {
  %10 = avx512.vmovdqu64.rodata.zmm @__low_rodata_4cab361f
  %11 = copy %even : reg<x86.ymm> -> reg<x86.zmm>
  %12 = copy %odd : reg<x86.ymm> -> reg<x86.zmm>
  %result = vpermt2w.zmm %11, %10, %12
  return %result
}

low.func.def target<x86.avx512_features.core>(@target) abi(object_function) abi_layout({signature = (vector<8xf32>) -> (vector<4xf32>, vector<4xf32>)}) @base_dword_unzip(%source: reg<x86.ymm>) -> (reg<x86.xmm>, reg<x86.xmm>) asm {
  %17 = avx2.vmovdqu.rodata.ymm @__low_rodata_793bd6bf
  %18 = vpshufb.ymm %source, %17
  %19 = vpermq.ymm %18, 216
  %even = copy %19 : reg<x86.ymm> -> reg<x86.xmm>
  %odd = vextractf128.xmm %19, 1
  return %even, %odd
}

