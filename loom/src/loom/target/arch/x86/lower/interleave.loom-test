// RUN: emit source-low output=module

x86.target<avx2> @target

// Whole-packet joins use both unpack halves; reverse byte routing must compact
// both 128-bit lanes. Returning inputs separately retains their live values.
func.def target(@target) @word_zip(%even: vector<8xi16>, %odd: vector<8xi16>) -> (vector<16xi16>, vector<8xi16>) {
  %result = vector.interleave<0> %even, %odd : vector<8xi16>, vector<8xi16> -> vector<16xi16>
  func.return %result, %even : vector<16xi16>, vector<8xi16>
}

func.def target(@target) @byte_unzip(%source: vector<32xi8>) -> (vector<16xi8>, vector<16xi8>) {
  %even, %odd = vector.deinterleave<0> %source : vector<32xi8> -> vector<16xi8>, vector<16xi8>
  func.return %even, %odd : vector<16xi8>, vector<16xi8>
}

// ----
x86.target<avx2> @target

low.func.def target<x86.avx2.core>(@target) abi(object_function) abi_layout({signature = (vector<8xi16>, vector<8xi16>) -> (vector<16xi16>, vector<8xi16>)}) @word_zip(%even: reg<x86.xmm>, %odd: reg<x86.xmm>) -> (reg<x86.ymm>, reg<x86.xmm>) asm {
  %4 = vpunpcklwd.xmm %even, %odd
  %5 = vpunpckhwd.xmm %even, %odd
  %result = vinsertf128.concat.ymm %4, %5
  return %result, %even
}

low.func.def target<x86.avx2.core>(@target) abi(object_function) abi_layout({signature = (vector<32xi8>) -> (vector<16xi8>, vector<16xi8>)}) @byte_unzip(%source: reg<x86.ymm>) -> (reg<x86.xmm>, reg<x86.xmm>) asm {
  %10 = avx2.vmovdqu.rodata.ymm @__low_rodata_4ed8f73f
  %11 = vpshufb.ymm %source, %10
  %12 = vpermq.ymm %11, 216
  %even = copy %12 : reg<x86.ymm> -> reg<x86.xmm>
  %odd = vextractf128.xmm %12, 1
  return %even, %odd
}

global.rodata.def @__low_rodata_4ed8f73f = align(32) bytes("00020406080a0c0e01030507090b0d0f00020406080a0c0e01030507090b0d0f")

// ====
// RUN: emit source-low output=module

x86.target<avx512> @target {features = [avx512vbmi]}

// The same input occupies both tables. The result has a full-width native
// carrier, and the original narrow input remains independently live.
func.def target(@target) @repeat_bfloat(%source: vector<16xbf16>) -> (vector<32xbf16>, vector<16xbf16>) {
  %result = vector.interleave<0> %source, %source : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  func.return %result, %source : vector<32xbf16>, vector<16xbf16>
}

func.def target(@target) @byte_zip(%even: vector<32xf8E4M3>, %odd: vector<32xf8E4M3>) -> (vector<64xf8E4M3>) {
  %result = vector.interleave<0> %even, %odd : vector<32xf8E4M3>, vector<32xf8E4M3> -> vector<64xf8E4M3>
  func.return %result : vector<64xf8E4M3>
}

func.def target(@target) @word_unzip(%source: vector<32xbf16>) -> (vector<16xbf16>, vector<16xbf16>) {
  %even, %odd = vector.deinterleave<0> %source : vector<32xbf16> -> vector<16xbf16>, vector<16xbf16>
  func.return %even, %odd : vector<16xbf16>, vector<16xbf16>
}

func.def target(@target) @qword_unzip(%source: vector<8xf64>) -> (vector<4xf64>, vector<4xf64>) {
  %even, %odd = vector.deinterleave<0> %source : vector<8xf64> -> vector<4xf64>, vector<4xf64>
  func.return %even, %odd : vector<4xf64>, vector<4xf64>
}

// ----
x86.target<avx512> @target {features = [avx512vbmi]}

low.func.def target<x86.avx512_features.core>(@target) abi(object_function) abi_layout({signature = (vector<16xbf16>) -> (vector<32xbf16>, vector<16xbf16>)}) @repeat_bfloat(%source: reg<x86.ymm>) -> (reg<x86.zmm>, reg<x86.ymm>) asm {
  %3 = avx512.vmovdqu64.rodata.zmm @__low_rodata_4cab361f
  %4 = copy %source : reg<x86.ymm> -> reg<x86.zmm>
  %5 = copy %source : reg<x86.ymm> -> reg<x86.zmm>
  %result = vpermt2w.zmm %4, %3, %5
  return %result, %source
}

low.func.def target<x86.avx512_features.core>(@target) abi(object_function) abi_layout({signature = (vector<32xf8E4M3>, vector<32xf8E4M3>) -> (vector<64xf8E4M3>)}) @byte_zip(%even: reg<x86.ymm>, %odd: reg<x86.ymm>) -> (reg<x86.zmm>) asm {
  %10 = avx512.vmovdqu64.rodata.zmm @__low_rodata_33de031f
  %11 = copy %even : reg<x86.ymm> -> reg<x86.zmm>
  %12 = copy %odd : reg<x86.ymm> -> reg<x86.zmm>
  %result = vpermt2b.zmm %11, %10, %12
  return %result
}

low.func.def target<x86.avx512_features.core>(@target) abi(object_function) abi_layout({signature = (vector<32xbf16>) -> (vector<16xbf16>, vector<16xbf16>)}) @word_unzip(%source: reg<x86.zmm>) -> (reg<x86.ymm>, reg<x86.ymm>) asm {
  %even = avx512.vpmovdw.ymm.zmm %source
  %18 = avx512.vpsrld.zmm %source, 16
  %odd = avx512.vpmovdw.ymm.zmm %18
  return %even, %odd
}

low.func.def target<x86.avx512_features.core>(@target) abi(object_function) abi_layout({signature = (vector<8xf64>) -> (vector<4xf64>, vector<4xf64>)}) @qword_unzip(%source: reg<x86.zmm>) -> (reg<x86.ymm>, reg<x86.ymm>) asm {
  %23 = avx512.vmovdqu64.rodata.zmm @__low_rodata_c35fdf1f
  %24 = avx512.vpermq.zmm %source, %23
  %even = copy %24 : reg<x86.zmm> -> reg<x86.ymm>
  %odd = vextracti64x4.ymm %24, 1
  return %even, %odd
}

