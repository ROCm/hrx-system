load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_library",
    "loom_config_compatible_with",
)
load("//loom/build_tools/bazel:loom_check.bzl", "loom_check_test_suite")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_X86_ROOT_VISIBILITY = ["//loom/src/loom/target/arch/x86:__pkg__"]

loom_cc_library(
    name = "source_signature",
    srcs = ["source_signature.c"],
    hdrs = ["source_signature.h"],
    visibility = _X86_ROOT_VISIBILITY,
    deps = [
        "//loom/src/loom/codegen/low/lower",
        "//loom/src/loom/codegen/low/lower/abi/c:projection",
        "//loom/src/loom/ir",
        "//loom/src/loom/target/arch/x86:call_abi",
        "//loom/src/loom/target/arch/x86:register_classes",
        "//loom/src/loom/target/arch/x86:source_signature",
        "//loom/src/loom/target/arch/x86/descriptors:entry",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
    ],
)

loom_cc_library(
    name = "lower",
    srcs = [
        "contraction.c",
        "predicate_representation.c",
        "registry.c",
        "vector_construct.c",
        "vector_slice.c",
    ],
    hdrs = [
        "contraction.h",
        "lower.h",
        "predicate_representation.h",
        "vector_construct.h",
        "vector_slice.h",
    ],
    textual_hdrs = ["//loom/src/loom/target/arch/x86/contracts:tables.inl"],
    visibility = _X86_ROOT_VISIBILITY,
    deps = [
        ":source_signature",
        "//loom/src/loom/codegen/low:descriptors",
        "//loom/src/loom/codegen/low/lower",
        "//loom/src/loom/codegen/low/lower:representation_observer",
        "//loom/src/loom/codegen/low/lower:task_abi",
        "//loom/src/loom/error:error_defs",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops/kernel",
        "//loom/src/loom/ops/low",
        "//loom/src/loom/ops/vector",
        "//loom/src/loom/target/abi/task:parameter_layout",
        "//loom/src/loom/target/arch/x86:feature_bits",
        "//loom/src/loom/target/arch/x86:packed_dot_contract",
        "//loom/src/loom/target/arch/x86:packed_dot_contract_projection",
        "//loom/src/loom/target/arch/x86:register_classes",
        "//loom/src/loom/target/arch/x86/contracts",
        "//loom/src/loom/target/arch/x86/descriptors:vector_construct",
        "//loom/src/loom/target/arch/x86/descriptors:vector_slice",
        "//loom/src/loom/util:fact_table",
        "//runtime/src/iree/base",
    ],
)

loom_check_test_suite(
    name = "predicate_bitstream_test",
    srcs = ["predicate_bitstream.loom-test"],
    tags = ["hostonly"],
    target_compatible_with = loom_config_compatible_with(["//loom/config/emit:x86_elf"]),
)

loom_check_test_suite(
    name = "memory_broadcast_test",
    srcs = ["memory_broadcast.loom-test"],
    tags = ["hostonly"],
    target_compatible_with = loom_config_compatible_with(["//loom/config/emit:x86_elf"]),
)

loom_check_test_suite(
    name = "register_transport_test",
    srcs = ["register_transport.loom-test"],
    tags = ["hostonly"],
    target_compatible_with = loom_config_compatible_with(["//loom/config/emit:x86_elf"]),
)

loom_check_test_suite(
    name = "registry_tests",
    srcs = ["registry_test.loom-test"],
    tags = ["hostonly"],
    target_compatible_with = loom_config_compatible_with(["//loom/config/emit:x86_elf"]),
)

loom_check_test_suite(
    name = "vector_construction_test",
    srcs = ["vector_construction.loom-test"],
    tags = ["hostonly"],
    target_compatible_with = loom_config_compatible_with(["//loom/config/emit:x86_elf"]),
)

loom_check_test_suite(
    name = "interleave_test",
    srcs = ["interleave.loom-test"],
    tags = ["hostonly"],
    target_compatible_with = loom_config_compatible_with(["//loom/config/emit:x86_elf"]),
)
