load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_cc_library",
    "loom_cc_test",
    "loom_generated_cc_library",
)

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_X86_LOWER_VISIBILITY = ["//loom/src/loom/target/arch/x86/lower:__pkg__"]

_X86_NATIVE_VISIBILITY = ["//loom/src/loom/target/emit/native/x86:__pkg__"]

_X86_RECORDS_VISIBILITY = ["//loom/src/loom/target/arch/x86/records:__pkg__"]

_X86_OPS_VISIBILITY = ["//loom/src/loom/target/arch/x86/ops:__pkg__"]

_X86_FACTS_VISIBILITY = _X86_NATIVE_VISIBILITY + _X86_OPS_VISIBILITY + [
    "//loom/binding/c/test/target/cpu:__pkg__",
]

_X86_PROVIDER_VISIBILITY = [
    "//loom/src/loom/target/configured:__pkg__",
    "//loom/src/loom/target/emit/native/x86:__pkg__",
]

#===------------------------------------------------------------------------===#
# x86 target support
#===------------------------------------------------------------------------===#

loom_cc_library(
    name = "facts",
    srcs = ["facts.c"],
    hdrs = ["facts.h"],
    visibility = _X86_FACTS_VISIBILITY,
    deps = [
        ":feature_bits",
        "//loom/src/loom/target:facts",
        "//loom/src/loom/target:facts_builder",
        "//loom/src/loom/target/arch/x86/records:target_records",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base:cpu_data",
    ],
)

loom_cc_library(
    name = "feature_bits",
    hdrs = ["feature_bits.h"],
    visibility = (
        _X86_LOWER_VISIBILITY +
        _X86_OPS_VISIBILITY +
        _X86_RECORDS_VISIBILITY
    ),
    deps = ["//runtime/src/iree/base"],
)

loom_cc_library(
    name = "call_abi",
    srcs = ["call_abi.c"],
    hdrs = ["call_abi.h"],
    visibility = _X86_LOWER_VISIBILITY + _X86_NATIVE_VISIBILITY,
    deps = [
        ":register_classes",
        "//loom/src/loom/ir",
    ],
)

loom_cc_library(
    name = "source_signature",
    srcs = ["source_signature.c"],
    hdrs = ["source_signature.h"],
    visibility = _X86_LOWER_VISIBILITY,
    deps = [
        "//loom/src/loom/ops/func",
        "//loom/src/loom/target/abi/c:signature_layout",
        "//runtime/src/iree/base",
    ],
)

loom_cc_test(
    name = "source_signature_test",
    srcs = ["source_signature_test.cc"],
    deps = [
        ":source_signature",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops/func",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "math_policy",
    srcs = ["math_policy.c"],
    hdrs = ["math_policy.h"],
    deps = [
        ":feature_bits",
        "//loom/src/loom/target:math_policy",
        "//runtime/src/iree/base",
    ],
)

loom_cc_test(
    name = "math_policy_test",
    srcs = ["math_policy_test.cc"],
    deps = [
        ":feature_bits",
        ":math_policy",
        "//loom/src/loom/ir",
        "//loom/src/loom/target:math_policy",
        "//loom/src/loom/target:types",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "register_classes",
    srcs = ["register_classes.c"],
    hdrs = ["register_classes.h"],
    visibility = _X86_LOWER_VISIBILITY + _X86_NATIVE_VISIBILITY,
    deps = [
        "//loom/src/loom/ir",
        "//loom/src/loom/target/arch/x86/descriptors:avx512_features_descriptors_ids",
        "//runtime/src/iree/base",
    ],
)

loom_cc_test(
    name = "register_classes_test",
    srcs = ["register_classes_test.cc"],
    deps = [
        ":feature_bits",
        ":register_classes",
        "//loom/src/loom/codegen/low:builder",
        "//loom/src/loom/codegen/low:descriptors",
        "//loom/src/loom/target/arch/x86/descriptors:shards_for_testing",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_library(
    name = "legalization",
    srcs = [
        "legalization.c",
        "vector_insert.c",
        "vector_insert.h",
    ],
    hdrs = ["legalization.h"],
    deps = [
        "//loom/src/loom/codegen/low:descriptors",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops/index",
        "//loom/src/loom/ops/scalar",
        "//loom/src/loom/ops/scf",
        "//loom/src/loom/ops/vector",
        "//loom/src/loom/target:legalization",
        "//loom/src/loom/target/arch/x86/records:target_records",
        "//loom/src/loom/transforms/scalar:target_legalization",
        "//loom/src/loom/transforms/vector:packet_legalization",
        "//loom/src/loom/transforms/vector:target_legalization",
        "//loom/src/loom/transforms/vector:to_scalar",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "hal_materialization",
    srcs = ["hal_materialization.c"],
    hdrs = ["hal_materialization.h"],
    deps = [
        ":call_abi",
        ":facts",
        ":register_classes",
        "//loom/src/loom/codegen/low:builder",
        "//loom/src/loom/codegen/low/transforms:task_abi",
        "//loom/src/loom/ir",
        "//loom/src/loom/ops:op_defs",
        "//loom/src/loom/ops/low",
        "//loom/src/loom/pass:types",
        "//loom/src/loom/target:registers",
        "//loom/src/loom/target/arch/x86/descriptors:entry",
        "//loom/src/loom/target/arch/x86/ops",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/hal/driver/task/executable/library:abi",
    ],
)

loom_cc_library(
    name = "pass_registry",
    srcs = ["pass_registry.c"],
    hdrs = ["pass_registry.h"],
    deps = [
        ":hal_materialization",
        "//loom/src/loom/codegen/low/pipeline:pass_environment",
        "//loom/src/loom/pass:registry",
        "//loom/src/loom/target:pass_environment",
        "//loom/src/loom/target:pass_requirements",
    ],
)

loom_cc_library(
    name = "ir_provider",
    srcs = ["ir_provider.c"],
    hdrs = ["ir_provider.h"],
    visibility = ["//loom/src/loom/target/configured:__pkg__"],
    deps = [
        ":facts",
        "//loom/src/loom/target:provider",
        "//loom/src/loom/target/arch/x86/descriptors:low_registry",
        "//loom/src/loom/target/arch/x86/ops",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "provider",
    srcs = ["provider.c"],
    hdrs = ["provider.h"],
    visibility = _X86_PROVIDER_VISIBILITY,
    deps = [
        ":call_abi",
        ":facts",
        ":feature_bits",
        ":legalization",
        ":math_policy",
        ":pass_registry",
        "//loom/src/loom/ir",
        "//loom/src/loom/pass:builder",
        "//loom/src/loom/target:provider",
        "//loom/src/loom/target/arch/x86/descriptors:low_registry",
        "//loom/src/loom/target/arch/x86/lower",
        "//loom/src/loom/target/arch/x86/ops",
        "//loom/src/loom/target/arch/x86/records:target_records",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base:cpu_data",
    ],
)

loom_cc_test(
    name = "provider_test",
    srcs = ["provider_test.cc"],
    deps = [
        ":facts",
        ":feature_bits",
        ":provider",
        "//loom/src/loom/ir",
        "//loom/src/loom/target:facts_builder",
        "//loom/src/loom/target/arch/x86/ops",
        "//loom/src/loom/target/arch/x86/records:target_records",
        "//loom/src/loom/testing:module_ptr",
        "//runtime/src/iree/base:cpu_data",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

#===------------------------------------------------------------------------===#
# x86 packed-dot contracts
#===------------------------------------------------------------------------===#

loom_generated_cc_library(
    name = "packed_dot_contract",
    srcs = [
        "packed_dot_contract.c",
    ],
    hdrs = [
        "packed_dot_contract.h",
        "packed_dot_contract_data.h",
    ],
    generator = "//loom/py/loom/gen/target/arch/x86:packed_dot_contract",
    source = "packed_dot_contract_data.c",
    visibility = _X86_LOWER_VISIBILITY,
    deps = [
        ":feature_bits",
        "//loom/src/loom/analysis:native_layout",
        "//loom/src/loom/codegen/low:descriptors",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "packed_dot_contract_projection",
    srcs = ["packed_dot_contract_projection.c"],
    hdrs = ["packed_dot_contract_projection.h"],
    visibility = _X86_LOWER_VISIBILITY,
    deps = [
        ":packed_dot_contract",
        "//loom/src/loom/analysis:contract",
    ],
)

loom_cc_test(
    name = "packed_dot_contract_test",
    srcs = ["packed_dot_contract_test.cc"],
    deps = [
        ":packed_dot_contract",
        "//loom/src/loom/target/arch/x86/descriptors:shards_for_testing",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_test(
    name = "packed_dot_contract_projection_test",
    srcs = ["packed_dot_contract_projection_test.cc"],
    deps = [
        ":packed_dot_contract",
        ":packed_dot_contract_projection",
        "//loom/src/loom/analysis:contract_storage",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
