#===------------------------------------------------------------------------===#
# x86 packed-dot contracts
#===------------------------------------------------------------------------===#

loom_generated_cc_library(
    name = "packed_dot_contract",
    srcs = [
        "packed_dot_contract.c",
    ],
    hdrs = [
        "packed_dot_contract.h",
        "packed_dot_contract_data.h",
    ],
    generator = "//loom/py/loom/gen/target/arch/x86:packed_dot_contract",
    source = "packed_dot_contract_data.c",
    visibility = _X86_LOWER_VISIBILITY,
    deps = [
        ":feature_bits",
        "//loom/src/loom/analysis:native_layout",
        "//loom/src/loom/codegen/low:descriptors",
        "//runtime/src/iree/base",
    ],
)

loom_cc_library(
    name = "packed_dot_contract_projection",
    srcs = ["packed_dot_contract_projection.c"],
    hdrs = ["packed_dot_contract_projection.h"],
    visibility = _X86_LOWER_VISIBILITY,
    deps = [
        ":packed_dot_contract",
        "//loom/src/loom/analysis:contract",
    ],
)

loom_cc_test(
    name = "packed_dot_contract_test",
    srcs = ["packed_dot_contract_test.cc"],
    deps = [
        ":packed_dot_contract",
        "//loom/src/loom/target/arch/x86/descriptors:shards_for_testing",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)

loom_cc_test(
    name = "packed_dot_contract_projection_test",
    srcs = ["packed_dot_contract_projection_test.cc"],
    deps = [
        ":packed_dot_contract",
        ":packed_dot_contract_projection",
        "//loom/src/loom/analysis:contract_storage",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
