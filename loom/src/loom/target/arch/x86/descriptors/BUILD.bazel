loom_low_descriptor_cc_library(
    name = "avx512_features_descriptors",
    args = [
        "--target=avx512_features",
        "--shared-strings=$(rootpath //loom/src/loom/target/arch/x86/contracts:instruction_strings.json)",
    ],
    generated_hdr_flags = [
        "--view-header=scalar",
        "--view-header=avx2",
        "--view-header=avx2_features",
        "--view-header=avx512",
        "--view-header=packed_dot",
        "--view-header=avx512_vnni",
        "--view-header=avx512_bf16",
        "--view-header=avx512_fp16",
        "--view-header=avx_vnni",
        "--view-header=avx_vnni_int8",
        "--view-header=avx_vnni_int16",
        "--view-header=avx10_2",
    ],
    generated_hdrs = [
        "scalar_descriptors.h",
        "avx2_descriptors.h",
        "avx2_features_descriptors.h",
        "avx512_descriptors.h",
        "packed_dot_descriptors.h",
        "avx512_vnni_descriptors.h",
        "avx512_bf16_descriptors.h",
        "avx512_fp16_descriptors.h",
        "avx_vnni_descriptors.h",
        "avx_vnni_int8_descriptors.h",
        "avx_vnni_int16_descriptors.h",
        "avx10_2_descriptors.h",
    ],
    generator = "//loom/py/loom/gen/target/arch/x86:low_descriptor_shard",
    ids_deps = ["//loom/src/loom/codegen/low:descriptors"],
    ids_visibility = _X86_ROOT_VISIBILITY + _X86_NATIVE_VISIBILITY,
    inputs = ["//loom/src/loom/target/arch/x86/contracts:instruction_strings.json"],
    visibility = _X86_NATIVE_VISIBILITY,
    deps = [
        "//loom/src/loom/codegen/low:descriptors",
        "//loom/src/loom/target/arch/x86/contracts:instruction_strings",
    ],
)

