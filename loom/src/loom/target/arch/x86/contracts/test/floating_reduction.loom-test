low.func.def target<x86.avx512.core>(@target) abi(object_function) @f32x16_reassociated_reduce(%values: reg<x86.zmm>, %initial: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %7 = vextractf32x4.xmm %values, 0
  %8 = vextractf32x4.xmm %values, 1
  %9 = vextractf32x4.xmm %values, 2
  %10 = vextractf32x4.xmm %values, 3
  %11 = vaddps.xmm %7, %8
