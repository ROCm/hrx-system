// ====

x86.target<avx512_packed_dot> @target

func.def target(@target) @bf16_dot2_ordered_reduce(%lhs: vector<16xbf16>, %rhs: vector<16xbf16>, %initial: vector<8xf32>, %seed: f32) -> (f32) {
  %dot = vector.dot2f %lhs, %rhs, %initial : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
  %sum = vector.reduce<addf> %dot, %seed : vector<8xf32>, f32
  func.return %sum : f32
}

// ----
low.func.def target<x86.avx512_packed_dot.core>(@target) abi(object_function) @bf16_dot2_ordered_reduce(%lhs: reg<x86.ymm>, %rhs: reg<x86.ymm>, %initial: reg<x86.ymm>, %seed: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %12 = copy %initial : reg<x86.ymm> -> reg<x86.ymm>
  %dot = avx512_bf16.vdpbf16ps.ymm %12, %lhs, %rhs
  %14 = vextractf128.xmm %dot, 0
  %15 = vextractf128.xmm %dot, 1
  %16 = vaddss.xmm %seed, %14
  %17 = vpermilps.xmm %14, 1
  %18 = vaddss.xmm %16, %17
  %19 = vpermilps.xmm %14, 2
  %20 = vaddss.xmm %18, %19
  %21 = vpermilps.xmm %14, 3
  %22 = vaddss.xmm %20, %21
  %23 = vaddss.xmm %22, %15
  %24 = vpermilps.xmm %15, 1
  %25 = vaddss.xmm %23, %24
  %26 = vpermilps.xmm %15, 2
  %27 = vaddss.xmm %25, %26
  %28 = vpermilps.xmm %15, 3
  %sum = vaddss.xmm %27, %28
  return %sum
}

// ====

x86.target<avx512_packed_dot> @target

func.def target(@target) @bf16_dot2_reassociated_reduce(%lhs: vector<16xbf16>, %rhs: vector<16xbf16>, %initial: vector<8xf32>, %seed: f32) -> (f32) {
  %dot = vector.dot2f %lhs, %rhs, %initial : vector<16xbf16>, vector<16xbf16>, vector<8xf32>
  %sum = vector.reduce<addf, reassoc> %dot, %seed : vector<8xf32>, f32
  func.return %sum : f32
}

// ----
low.func.def target<x86.avx512_packed_dot.core>(@target) abi(object_function) @bf16_dot2_reassociated_reduce(%lhs: reg<x86.ymm>, %rhs: reg<x86.ymm>, %initial: reg<x86.ymm>, %seed: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %12 = copy %initial : reg<x86.ymm> -> reg<x86.ymm>
  %dot = avx512_bf16.vdpbf16ps.ymm %12, %lhs, %rhs
  %14 = vextractf128.xmm %dot, 0
  %15 = vextractf128.xmm %dot, 1
  %16 = vaddps.xmm %14, %15
  %17 = vpermilps.xmm %16, 78
  %18 = vaddps.xmm %16, %17
  %19 = vpermilps.xmm %18, 177
  %20 = vaddps.xmm %18, %19
  %sum = vaddss.xmm %seed, %20
  return %sum
}
