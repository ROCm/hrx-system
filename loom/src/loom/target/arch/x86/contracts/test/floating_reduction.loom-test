// RUN: emit source-low output=low

x86.target<avx2> @target

func.def target(@target) @f32x4_ordered_reduce(%values: vector<4xf32>, %initial: f32) -> (f32) {
  %sum = vector.reduce<addf> %values, %initial : vector<4xf32>, f32
  func.return %sum : f32
}

// ----
low.func.def target<x86.avx2.core>(@target) abi(object_function) @f32x4_ordered_reduce(%values: reg<x86.xmm>, %initial: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %7 = vaddss.xmm %initial, %values
  %8 = vpermilps.xmm %values, 1
  %9 = vaddss.xmm %7, %8
  %10 = vpermilps.xmm %values, 2
  %11 = vaddss.xmm %9, %10
  %12 = vpermilps.xmm %values, 3
  %sum = vaddss.xmm %11, %12
  return %sum
}

// ====

x86.target<avx2> @target

func.def target(@target) @f32x4_reassociated_reduce(%values: vector<4xf32>, %initial: f32) -> (f32) {
  %sum = vector.reduce<addf, reassoc> %values, %initial : vector<4xf32>, f32
  func.return %sum : f32
}

// ----
low.func.def target<x86.avx2.core>(@target) abi(object_function) @f32x4_reassociated_reduce(%values: reg<x86.xmm>, %initial: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %7 = vpermilps.xmm %values, 78
  %8 = vaddps.xmm %values, %7
  %9 = vpermilps.xmm %8, 177
  %10 = vaddps.xmm %8, %9
  %sum = vaddss.xmm %initial, %10
  return %sum
}

