// ----
low.func.def target<x86.avx2.core>(@target) abi(object_function) @f32x8_ordered_reduce(%values: reg<x86.ymm>, %initial: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  %7 = vextractf128.xmm %values, 0
  %8 = vextractf128.xmm %values, 1
  %9 = vaddss.xmm %initial, %7
  %10 = vpermilps.xmm %7, 1
  %11 = vaddss.xmm %9, %10
  %12 = vpermilps.xmm %7, 2
  %13 = vaddss.xmm %11, %12
  %14 = vpermilps.xmm %7, 3
  %15 = vaddss.xmm %13, %14
  %16 = vaddss.xmm %15, %8
  %17 = vpermilps.xmm %8, 1
  %18 = vaddss.xmm %16, %17
  %19 = vpermilps.xmm %8, 2
  %20 = vaddss.xmm %18, %19
  %21 = vpermilps.xmm %8, 3
  %sum = vaddss.xmm %20, %21
  return %sum
}

