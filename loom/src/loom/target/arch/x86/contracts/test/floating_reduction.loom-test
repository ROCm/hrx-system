  %21 = vpermilps.xmm %8, 2
  %22 = vaddss.xmm %20, %21
  %23 = vpermilps.xmm %8, 3
  %24 = vaddss.xmm %22, %23
  %25 = vaddss.xmm %24, %9
  %26 = vpermilps.xmm %9, 1
  %27 = vaddss.xmm %25, %26
  %28 = vpermilps.xmm %9, 2
  %29 = vaddss.xmm %27, %28
  %30 = vpermilps.xmm %9, 3
  %31 = vaddss.xmm %29, %30
