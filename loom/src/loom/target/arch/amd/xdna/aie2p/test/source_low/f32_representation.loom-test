// RUN: pass target=amd.xdna.aie2p:core source-to-low

func.def @f32_accumulator_pipeline(%lhs: vector<16xbf16>, %rhs: vector<16xbf16>) -> (vector<16xbf16>) {
  %lhs_wide = vector.extf<daz> %lhs : vector<16xbf16> to vector<16xf32>
  %rhs_wide = vector.extf<daz> %rhs : vector<16xbf16> to vector<16xf32>
  %sum = vector.addf %lhs_wide, %rhs_wide : vector<16xf32>
  %baseline = vector.splatf 0.0 : vector<16xf32>
  %centered = vector.subf %sum, %baseline : vector<16xf32>
  %activated = vector.tanhf<afn> %centered : vector<16xf32>
  %result = vector.fptrunc<daz> %activated : vector<16xf32> to vector<16xbf16>
  func.return %result : vector<16xbf16>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @f32_accumulator_pipeline(%lhs: reg<aie2p.vec256 x2>, %rhs: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %13 = slice %lhs[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %14 = vconv.fp32.bf16x16 %13
  %lhs_wide = copy %14 : reg<aie2p.mbms> -> reg<aie2p.ebmll>
  %16 = slice %rhs[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %17 = vconv.fp32.bf16x16 %16
  %rhs_wide = copy %17 : reg<aie2p.mbms> -> reg<aie2p.ebmll>
  %19 = mova.i32 60
  %20 = vadd.f32x16 %lhs_wide, %rhs_wide, %19
  %21 = slice %20[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %sum = copy %21 : reg<aie2p.mbms> -> reg<aie2p.ebmll>
  %23 = acc.clear.f32x64
  %24 = slice %23[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %baseline = copy %24 : reg<aie2p.mbms> -> reg<aie2p.ebmll>
  %26 = mova.i32 60
  %27 = vsub.f32x16 %sum, %baseline, %26
  %28 = slice %27[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %centered = copy %28 : reg<aie2p.mbms> -> reg<aie2p.ebmll>
  %30 = copy %centered : reg<aie2p.ebmll> -> reg<aie2p.mbms>
  %31 = vtanh.bf16x16 %30
  %result = concat(%31, %31) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  return %result
}

// ====

func.def @f32_accumulator_reduce(%input: vector<16xbf16>) -> (f32) {
  %wide = vector.extf<daz> %input : vector<16xbf16> to vector<16xf32>
  %init = scalar.constant 0.0 : f32
  %sum = vector.reduce<addf, reassoc|nnan|ninf|nsz> %wide, %init : vector<16xf32>, f32
  func.return %sum : f32
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @f32_accumulator_reduce(%input: reg<aie2p.vec256 x2>) -> (reg<aie2p.er>) asm {
  %7 = slice %input[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %8 = vconv.fp32.bf16x16 %7
  %wide = copy %8 : reg<aie2p.mbms> -> reg<aie2p.ebmll>
  %10 = acc.clear.f32x64
  %11 = move %10 : reg<aie2p.mbms x4> -> reg<aie2p.mbms x4>
  %12 = slice %11[1] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %13 = slice %11[2] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %14 = slice %11[3] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %15 = acc.clear.f32x64
  %16 = move %15 : reg<aie2p.mbms x4> -> reg<aie2p.mbms x4>
  %17 = slice %16[1] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %18 = slice %16[2] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %19 = slice %16[3] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %20 = copy %wide : reg<aie2p.ebmll> -> reg<aie2p.mbms>
  %21 = vmov.accumulator512.to.vector512 %20
  %22 = concat(%20, %12, %13, %14) : (reg<aie2p.mbms>, reg<aie2p.mbms>, reg<aie2p.mbms>, reg<aie2p.mbms>) -> reg<aie2p.mbms x4>
  %23 = mova.i32 60
  %24 = mova.i32 11
  %25 = vshuffle.to.accumulator512 %21, %21, %24
  %26 = copy %25 : reg<aie2p.mbmsm> -> reg<aie2p.mbms>
  %27 = concat(%26, %17, %18, %19) : (reg<aie2p.mbms>, reg<aie2p.mbms>, reg<aie2p.mbms>, reg<aie2p.mbms>) -> reg<aie2p.mbms x4>
  %28 = vadd.f32x64 %22, %27, %23
  %29 = slice %28[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %30 = vmov.accumulator512.to.vector512 %29
  %31 = mova.i32 9
  %32 = vshuffle.to.accumulator512 %30, %30, %31
  %33 = copy %32 : reg<aie2p.mbmsm> -> reg<aie2p.mbms>
  %34 = concat(%33, %17, %18, %19) : (reg<aie2p.mbms>, reg<aie2p.mbms>, reg<aie2p.mbms>, reg<aie2p.mbms>) -> reg<aie2p.mbms x4>
  %35 = vadd.f32x64 %28, %34, %23
  %36 = slice %35[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %37 = vmov.accumulator512.to.vector512 %36
  %38 = mova.i32 7
  %39 = vshuffle.to.accumulator512 %37, %37, %38
  %40 = copy %39 : reg<aie2p.mbmsm> -> reg<aie2p.mbms>
  %41 = concat(%40, %17, %18, %19) : (reg<aie2p.mbms>, reg<aie2p.mbms>, reg<aie2p.mbms>, reg<aie2p.mbms>) -> reg<aie2p.mbms x4>
  %42 = vadd.f32x64 %35, %41, %23
  %43 = slice %42[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %44 = vmov.accumulator512.to.vector512 %43
  %45 = mova.i32 5
  %46 = vshuffle.to.accumulator512 %44, %44, %45
  %47 = copy %46 : reg<aie2p.mbmsm> -> reg<aie2p.mbms>
  %48 = concat(%47, %17, %18, %19) : (reg<aie2p.mbms>, reg<aie2p.mbms>, reg<aie2p.mbms>, reg<aie2p.mbms>) -> reg<aie2p.mbms x4>
  %49 = vadd.f32x64 %42, %48, %23
  %50 = slice %49[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %51 = vmov.accumulator512.to.vector512 %50
  %sum = vextract.32.imm %51, 0
  return %sum
}
