// ====
// RUN: emit aie2p-leaf @residual_call

// Direct native emission cannot bypass required helper inlining.
aie2p.target<core> @core_target

low.func.def target<amd.xdna.aie2p.core>(@core_target) @callee() asm {
  return
}

low.func.def target<amd.xdna.aie2p.core>(@core_target) @residual_call() asm {
  // ERROR@+1: TARGET/072 {target_key="core_target", export_name="residual_call", config_key="core_target", function_name="residual_call", op_name="low.func.call", callee_name="callee", reason="the selected target has no native ABI contract for this call"}
  low.func.call @callee() : ()
  return
}

// ====
// RUN: emit source-low target=amd.xdna.aie2p:core output=module

// An explicitly retained semantic helper passes typed view addresses in the
// native pointer bank and remains a direct Low call after source lowering.
aie2p.target<core> @core_target

func.def noinline @copy_one(%input: view<1xi32>, %output: view<1xi32>) {
  %c0 = index.constant 0 : index
  %value = view.load %input[%c0] : view<1xi32> -> i32
  view.store %value, %output[%c0] : i32, view<1xi32>
  func.return
}

func.def public retain target(@core_target) @worker(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %input_view = buffer.view %input[%origin] : buffer -> view<1xi32>
  %output_view = buffer.view %output[%origin] : buffer -> view<1xi32>
  func.call @copy_one(%input_view, %output_view) : (view<1xi32>, view<1xi32>)
  func.return
}

// ----
aie2p.target<core> @core_target

low.func.def noinline target<amd.xdna.aie2p.core>(@core_target) @copy_one(%input: reg<aie2p.ep>, %output: reg<aie2p.ep>) asm {
  %value = lda %input, 0
  st %value, %output, 0
  return
}

low.func.def public retain target<amd.xdna.aie2p.core>(@core_target) abi(object_function) @worker() asm {
  %input = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %output = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %input_view = copy %input : reg<aie2p.ep> -> reg<aie2p.ep>
  %output_view = copy %output : reg<aie2p.ep> -> reg<aie2p.ep>
  low.func.call @copy_one(%input_view, %output_view) : (reg<aie2p.ep>, reg<aie2p.ep>)
  return
}

// ====
// RUN: emit source-low target=amd.xdna.aie2p:core output=module

// A retained helper consumes the storage placement established by its only
// caller. The vector memory choice therefore remains native across the source
// call boundary instead of scalarizing the sixteen-byte row.
aie2p.target<core> @core_target

func.def noinline @copy_aligned_row(%input: view<8xbf16>, %output: view<8xbf16>) {
  %value = vector.load %input[0] : view<8xbf16> -> vector<8xbf16>
  vector.store %value, %output[0] : vector<8xbf16>, view<8xbf16>
  func.return
}

func.def public retain target(@core_target) @aligned_worker(%input: buffer, %output: buffer) {
  %input_aligned, %output_aligned = buffer.assume.alignment %input, %output {minimum_alignment = 16} : buffer, buffer
  %origin = index.constant 0 : offset
  %input_view = buffer.view %input_aligned[%origin] : buffer -> view<8xbf16>
  %output_view = buffer.view %output_aligned[%origin] : buffer -> view<8xbf16>
  func.call @copy_aligned_row(%input_view, %output_view) : (view<8xbf16>, view<8xbf16>)
  func.return
}

// ----
aie2p.target<core> @core_target

low.func.def noinline target<amd.xdna.aie2p.core>(@core_target) @copy_aligned_row(%input: reg<aie2p.ep>, %output: reg<aie2p.ep>) asm {
  %2 = vlda.128.bf16x8 %input, 0
  vst.128.bf16x8 %2, %output, 0
  return
}

low.func.def public retain target<amd.xdna.aie2p.core>(@core_target) abi(object_function) @aligned_worker() asm {
  %input_aligned = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %output_aligned = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %input_view = copy %input_aligned : reg<aie2p.ep> -> reg<aie2p.ep>
  %output_view = copy %output_aligned : reg<aie2p.ep> -> reg<aie2p.ep>
  low.func.call @copy_aligned_row(%input_view, %output_view) : (reg<aie2p.ep>, reg<aie2p.ep>)
  return
}

// ====
// RUN: emit source-low target=amd.xdna.aie2p:core output=module

// A private helper's argument facts describe every semantic caller. One caller
// without the required alignment therefore prevents the shared helper from
// selecting a vector memory instruction that would be invalid on that edge.
aie2p.target<core> @core_target

func.def noinline @copy_shared_row(%input: view<8xbf16>, %output: view<8xbf16>) {
  %value = vector.load %input[0] : view<8xbf16> -> vector<8xbf16>
  vector.store %value, %output[0] : vector<8xbf16>, view<8xbf16>
  func.return
}

func.def public retain target(@core_target) @mixed_caller(%aligned_input: buffer, %aligned_output: buffer, %unaligned_input: buffer, %unaligned_output: buffer) {
  %input_aligned, %output_aligned = buffer.assume.alignment %aligned_input, %aligned_output {minimum_alignment = 16} : buffer, buffer
  %origin = index.constant 0 : offset
  %input_view = buffer.view %input_aligned[%origin] : buffer -> view<8xbf16>
  %output_view = buffer.view %output_aligned[%origin] : buffer -> view<8xbf16>
  func.call @copy_shared_row(%input_view, %output_view) : (view<8xbf16>, view<8xbf16>)
  %unaligned_input_view = buffer.view %unaligned_input[%origin] : buffer -> view<8xbf16>
  %unaligned_output_view = buffer.view %unaligned_output[%origin] : buffer -> view<8xbf16>
  func.call @copy_shared_row(%unaligned_input_view, %unaligned_output_view) : (view<8xbf16>, view<8xbf16>)
  func.return
}

// ----
aie2p.target<core> @core_target

low.func.def noinline target<amd.xdna.aie2p.core>(@core_target) @copy_shared_row(%input: reg<aie2p.ep>, %output: reg<aie2p.ep>) asm {
  %2 = lda.u16 %input, 0
  %3 = lda.u16 %input, 2
  %4 = lda.u16 %input, 4
  %5 = lda.u16 %input, 6
  %6 = lda.u16 %input, 8
  %7 = lda.u16 %input, 10
  %8 = lda.u16 %input, 12
  %9 = lda.u16 %input, 14
  st.s16 %2, %output, 0
  st.s16 %3, %output, 2
  st.s16 %4, %output, 4
  st.s16 %5, %output, 6
  st.s16 %6, %output, 8
  st.s16 %7, %output, 10
  st.s16 %8, %output, 12
  st.s16 %9, %output, 14
  return
}

low.func.def public retain target<amd.xdna.aie2p.core>(@core_target) abi(object_function) @mixed_caller() asm {
  %input_aligned = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %output_aligned = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %unaligned_input = resource<native_pointer> {index = 2, source_type = buffer} : reg<aie2p.ep>
  %unaligned_output = resource<native_pointer> {index = 3, source_type = buffer} : reg<aie2p.ep>
  %input_view = copy %input_aligned : reg<aie2p.ep> -> reg<aie2p.ep>
  %output_view = copy %output_aligned : reg<aie2p.ep> -> reg<aie2p.ep>
  low.func.call @copy_shared_row(%input_view, %output_view) : (reg<aie2p.ep>, reg<aie2p.ep>)
  %unaligned_input_view = copy %unaligned_input : reg<aie2p.ep> -> reg<aie2p.ep>
  %unaligned_output_view = copy %unaligned_output : reg<aie2p.ep> -> reg<aie2p.ep>
  low.func.call @copy_shared_row(%unaligned_input_view, %unaligned_output_view) : (reg<aie2p.ep>, reg<aie2p.ep>)
  return
}

// ====
// RUN: emit source-low target=amd.xdna.aie2p:core output=module

// A helper keeps its one-pointer view ABI while its internal control-flow join
// carries the selected physical coordinate.
aie2p.target<core> @core_target

func.def noinline @read_selected(%left: view<1xi32>, %right: view<1xi32>, %choose_left: i1) -> (i32) {
  %selected = scf.if %choose_left -> (view<1xi32>) {
    scf.yield %left : view<1xi32>
  } else {
    scf.yield %right : view<1xi32>
  }
  %value = view.load %selected[0] : view<1xi32> -> i32
  func.return %value : i32
}

func.def public retain target(@core_target) @selecting_caller(%left: buffer, %right: buffer, %choose_left: i1) -> (i32) {
  %origin = index.constant 0 : offset
  %left_view = buffer.view %left[%origin] : buffer -> view<1xi32>
  %right_view = buffer.view %right[%origin] : buffer -> view<1xi32>
  %value = func.call @read_selected(%left_view, %right_view, %choose_left) : (view<1xi32>, view<1xi32>, i1) -> (i32)
  func.return %value : i32
}

// ----
aie2p.target<core> @core_target

low.func.def noinline target<amd.xdna.aie2p.core>(@core_target) @read_selected(%left: reg<aie2p.ep>, %right: reg<aie2p.ep>, %choose_left: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %4 = mov.address-to-scalar %left
  %5 = mov.address-to-scalar %right
  %6 = copy %choose_left : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %7 = sel.nez %4, %5, %6
  %selected = mov.scalar-to-address %7
  %value = lda %selected, 0
  return %value
}

low.func.def public retain target<amd.xdna.aie2p.core>(@core_target) abi(object_function) @selecting_caller(%choose_left: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %left = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %right = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %left_view = copy %left : reg<aie2p.ep> -> reg<aie2p.ep>
  %right_view = copy %right : reg<aie2p.ep> -> reg<aie2p.ep>
  %value = low.func.call @read_selected(%left_view, %right_view, %choose_left) : (reg<aie2p.ep>, reg<aie2p.ep>, reg<aie2p.er>) -> (reg<aie2p.er>)
  return %value
}

// ====
// RUN: emit source-low target=amd.xdna.aie2p:core output=module

// View arguments carry their complete address. Aligned static origins use the
// stepped pointer immediate, other static origins use a modifier, and dynamic
// origins materialize the root-relative byte coordinate before the call.
aie2p.target<core> @core_target

func.def noinline @read_byte(%input: view<1xi8>) -> (i8) {
  %value = view.load %input[0] : view<1xi8> -> i8
  func.return %value : i8
}

func.def public retain target(@core_target) @read_origins(%input: buffer, %origin_input: offset) -> (i8, i8, i8) {
  %aligned = buffer.assume.alignment %input {minimum_alignment = 64} : buffer
  %aligned_origin = index.constant 64 : offset
  %general_origin = index.constant 4 : offset
  %dynamic_origin = index.assume %origin_input [range(%origin_input, 0, 1024)] : offset
  %aligned_view = buffer.view %aligned[%aligned_origin] : buffer -> view<1xi8>
  %general_view = buffer.view %aligned[%general_origin] : buffer -> view<1xi8>
  %dynamic_view = buffer.view %input[%dynamic_origin] : buffer -> view<1xi8>
  %aligned_value = func.call @read_byte(%aligned_view) : (view<1xi8>) -> (i8)
  %general_value = func.call @read_byte(%general_view) : (view<1xi8>) -> (i8)
  %dynamic_value = func.call @read_byte(%dynamic_view) : (view<1xi8>) -> (i8)
  func.return %aligned_value, %general_value, %dynamic_value : i8, i8, i8
}

// ----
aie2p.target<core> @core_target

low.func.def noinline target<amd.xdna.aie2p.core>(@core_target) @read_byte(%input: reg<aie2p.ep>) -> (reg<aie2p.er>) asm {
  %value = lda.u8 %input, 0
  return %value
}

low.func.def public retain target<amd.xdna.aie2p.core>(@core_target) abi(object_function) @read_origins(%dynamic_origin: reg<aie2p.er>) -> (reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>) asm {
  %aligned = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %8 = copy %aligned : reg<aie2p.ep> -> reg<aie2p.ep>
  %aligned_view = paddb %8, 64
  %10 = copy %aligned : reg<aie2p.ep> -> reg<aie2p.ep>
  %11 = mova.modifier 4
  %general_view = paddb.modifier %10, %11
  %13 = copy %aligned : reg<aie2p.ep> -> reg<aie2p.ep>
  %14 = mov.modifier %dynamic_origin
  %dynamic_view = paddb.modifier %13, %14
  %aligned_value = low.func.call @read_byte(%aligned_view) : (reg<aie2p.ep>) -> (reg<aie2p.er>)
  %general_value = low.func.call @read_byte(%general_view) : (reg<aie2p.ep>) -> (reg<aie2p.er>)
  %dynamic_value = low.func.call @read_byte(%dynamic_view) : (reg<aie2p.ep>) -> (reg<aie2p.er>)
  return %aligned_value, %general_value, %dynamic_value
}

// ====
// RUN: emit source-low target=amd.xdna.aie2p:core output=module

// Complete view addresses remain one pointer while rotating through a loop,
// deriving a dynamic subview, and returning across a retained call boundary.
aie2p.target<core> @core_target

func.def noinline @rotate_crop(%left: view<4xi32>, %right: view<4xi32>, %position_input: index, %count: index) -> (view<1xi32>) {
  %position = index.assume %position_input [range(%position_input, 0, 3)] : index
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %selected, %other = scf.for %i = [%begin to %count step %step](%current = %left : view<4xi32>, %alternate = %right : view<4xi32>) -> (view<4xi32>, view<4xi32>) {
    scf.yield %alternate, %current : view<4xi32>, view<4xi32>
  }
  %crop = view.subview %selected[%position] : view<4xi32> -> view<1xi32>
  func.return %crop : view<1xi32>
}

func.def public retain target(@core_target) @read_rotated_crop(%left: buffer, %right: buffer, %position: index, %count: index) -> (i32) {
  %origin = index.constant 0 : offset
  %left_view = buffer.view %left[%origin] : buffer -> view<4xi32>
  %right_view = buffer.view %right[%origin] : buffer -> view<4xi32>
  %crop = func.call @rotate_crop(%left_view, %right_view, %position, %count) : (view<4xi32>, view<4xi32>, index, index) -> (view<1xi32>)
  %value = view.load %crop[0] : view<1xi32> -> i32
  func.return %value : i32
}

// ----
aie2p.target<core> @core_target

low.func.def noinline target<amd.xdna.aie2p.core>(@core_target) @rotate_crop(%left: reg<aie2p.ep>, %right: reg<aie2p.ep>, %position: reg<aie2p.er>, %count: reg<aie2p.er>) -> (reg<aie2p.ep>) asm {
  %begin = mov.short 0
  %step = mov.short 1
  low.br ^_bb1(%begin: reg<aie2p.er>, %left: reg<aie2p.ep>, %right: reg<aie2p.ep>)
^_bb1(%i: reg<aie2p.er>, %current: reg<aie2p.ep>, %alternate: reg<aie2p.ep>):
  %9 = lt %i, %count
  low.cond_br %9, ^_bb2, ^_bb3 : reg<aie2p.er>
^_bb2:
  %10 = add.nc %i, %step
  low.br ^_bb1(%10: reg<aie2p.er>, %alternate: reg<aie2p.ep>, %current: reg<aie2p.ep>)
^_bb3:
  %11 = copy %current : reg<aie2p.ep> -> reg<aie2p.ep>
  %12 = mov.i32 2
  %13 = lshl %position, %12
  %14 = mov.modifier %13
  %crop = paddb.modifier %11, %14
  return %crop
}

low.func.def public retain target<amd.xdna.aie2p.core>(@core_target) abi(object_function) @read_rotated_crop(%position: reg<aie2p.er>, %count: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %left = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %right = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %left_view = copy %left : reg<aie2p.ep> -> reg<aie2p.ep>
  %right_view = copy %right : reg<aie2p.ep> -> reg<aie2p.ep>
  %crop = low.func.call pure @rotate_crop(%left_view, %right_view, %position, %count) : (reg<aie2p.ep>, reg<aie2p.ep>, reg<aie2p.er>, reg<aie2p.er>) -> (reg<aie2p.ep>)
  %value = lda %crop, 0
  return %value
}
