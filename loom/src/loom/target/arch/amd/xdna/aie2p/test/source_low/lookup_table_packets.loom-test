// TEMPLATE: loom/src/loom/test/corpus/source_low/lookup_table_packets.loom-test
// RUN: with-checks emit source-low target=amd.xdna.aie2p:core output=low

func.def @i8_non_power_table_i8(%table: vector<3xi8>, %indices: vector<64xi8>) -> (vector<64xi8>) {
  %values = vector.table.lookup %table[%indices] : vector<3xi8>, vector<64xi8> -> vector<64xi8>
  func.return %values : vector<64xi8>
}

// ----
CHECK: * = vextbcst.8 %table, 0
CHECK: * = vextbcst.8 %table, 2
CHECK: * = vsel.*
CHECK-NOT: * = vextract.*
CHECK-NOT: * = vinsert.*
CHECK-NOT: * = vextbcst.8 %table, 3

// ====

func.def @i8_last_table_entry_i8(%table: vector<64xi8>) -> (vector<64xi8>) {
  %indices = vector.constant 63 : vector<64xi8>
  %values = vector.table.lookup %table[%indices] : vector<64xi8>, vector<64xi8> -> vector<64xi8>
  func.return %values : vector<64xi8>
}

// ----
CHECK: %values = vextbcst.8 %table, 63
CHECK-NOT: * = vextract.*
CHECK-NOT: * = vinsert.*

// ====

