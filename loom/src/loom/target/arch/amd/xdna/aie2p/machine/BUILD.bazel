load("//loom/build_tools/bazel:build_defs.bzl", "loom_cc_library", "loom_cc_test", "loom_generated_source")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

loom_generated_source(
    name = "tables_gen",
    generator = "//loom/py/loom/gen/target/arch/amd/xdna/aie2p:encoding_tables",
    output = "machine_tables.inl",
    output_flag = "--machine-output",
)

loom_cc_library(
    name = "machine",
    srcs = ["machine.c"],
    hdrs = ["machine.h"],
    textual_hdrs = [":machine_tables.inl"],
    visibility = ["//visibility:public"],
    deps = [
        "//loom/src/loom/target/arch/amd/xdna/aie2p/encoding",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal",
    ],
)

loom_cc_test(
    name = "machine_test",
    srcs = ["machine_test.cc"],
    deps = [
        ":machine",
        "//loom/src/loom/target/arch/amd/xdna/aie2p/encoding",
        "//runtime/src/iree/testing:gtest",
        "//runtime/src/iree/testing:gtest_main",
    ],
)
