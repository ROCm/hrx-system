// ----
CHECK: * = mova.i32 40
CHECK: * = vshift *
CHECK: * = mova.i32 24
CHECK: * = vshift *
CHECK: * = vshift *
CHECK: %result = concat(*
CHECK: return %result
CHECK-NOT: *vextract*
CHECK-NOT: *vinsert*

// ====

func.def @concat_i16_partial_before_wide(%left: vector<1xi16>, %right: vector<33xi16>) -> (vector<34xi16>) {
  %result = vector.concat<0> %left, %right : vector<1xi16>, vector<33xi16> -> vector<34xi16>
  func.return %result : vector<34xi16>
}

// ----
CHECK: * = slice %right[0] *
CHECK: * = slice %right[2] *
CHECK: * = mova.i32 2
CHECK: * = vshift *
CHECK: * = mova.i32 62
CHECK: * = vshift *
CHECK: * = vshift *
CHECK: %result = concat(*
CHECK: return %result
CHECK-NOT: *vextract*
CHECK-NOT: *vinsert*

// ====

