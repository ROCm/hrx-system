// Computed records fill a retained cache through channel.copy. Both core and
// SRAM caches survive three replays to two consumers, then accept another batch.
// A single lifetime brackets all replays; repeated lifetimes count each replay.
// The scalar reference observes all input/output guards and unmodified tails.
aie2p.target<array> @array_target

func.def inline @ingress(%input: buffer, %incoming: channel<tile<16xi32>>, %records: index) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %bytes = index.constant 64 : offset
  scf.for %record = [%begin to %records step %step] {
    %offset = index.scale %record, %bytes : index, offset -> offset
    %external = buffer.view %input[%offset] : buffer -> view<16xi32>
    %write, %payload = channel.reserve %incoming : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
    %copy = kernel.async.copy %external to %payload {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<16xi32> to view<16xi32> -> kernel.async.token
    %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
    kernel.async.wait %group {newer_groups = 0} : kernel.async.group
    %values = vector.load %payload[0] : view<16xi32> -> vector<16xi32>
    %increment = vector.splati 1 : vector<16xi32>
    %prepared = vector.addi %values, %increment : vector<16xi32>
    vector.store %prepared, %payload[0] : vector<16xi32>, view<16xi32>
    channel.publish %write : write<tile<16xi32>>
  }
  func.return
}

func.def inline @retain_copy(%source: channel<tile<16xi32>>, %cache: channel<tile<16xi32>>, %records: index) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  scf.for %record = [%begin to %records step %step] {
    %read, %input = channel.acquire %source : channel<tile<16xi32>> -> (read<tile<16xi32>>, view<16xi32>)
    %write, %output = channel.reserve %cache : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
    channel.copy %read -> %write : read<tile<16xi32>>, write<tile<16xi32>>
  }
  func.return
}

func.def inline @copy_retained(%read: read<tile<16xi32>>, %destination: channel<tile<16xi32>>) -> (read<tile<16xi32>>) {
  %retained, %outgoing = channel.fanout %read : read<tile<16xi32>> -> (read<tile<16xi32>>, read<tile<16xi32>>)
  %write, %payload = channel.reserve %destination : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
  channel.copy %outgoing -> %write : read<tile<16xi32>>, write<tile<16xi32>>
  func.return %retained : read<tile<16xi32>>
}

func.def inline @distribute(%incoming: channel<tile<16xi32>>, %left: channel<tile<16xi32>>, %right: channel<tile<16xi32>>, %batches: index) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %replays = index.constant 3 : index
  scf.for %batch = [%begin to %batches step %step] {
    %first, %first_payload = channel.acquire %incoming : channel<tile<16xi32>> -> (read<tile<16xi32>>, view<16xi32>)
    %second, %second_payload = channel.acquire %incoming : channel<tile<16xi32>> -> (read<tile<16xi32>>, view<16xi32>)
    %last_first, %last_second = scf.for %replay = [%begin to %replays step %step](%a = %first : read<tile<16xi32>>, %b = %second : read<tile<16xi32>>) -> (read<tile<16xi32>>, read<tile<16xi32>>) {
      %a_left = func.call @copy_retained(%a, %left) : (read<tile<16xi32>>, channel<tile<16xi32>>) -> (read<tile<16xi32>>)
      %a_right = func.call @copy_retained(%a_left, %right) : (read<tile<16xi32>>, channel<tile<16xi32>>) -> (read<tile<16xi32>>)
      %b_left = func.call @copy_retained(%b, %left) : (read<tile<16xi32>>, channel<tile<16xi32>>) -> (read<tile<16xi32>>)
      %b_right = func.call @copy_retained(%b_left, %right) : (read<tile<16xi32>>, channel<tile<16xi32>>) -> (read<tile<16xi32>>)
      scf.yield %a_right, %b_right : read<tile<16xi32>>, read<tile<16xi32>>
    }
    channel.release %last_first : read<tile<16xi32>>
    channel.release %last_second : read<tile<16xi32>>
  }
  func.return
}

func.def inline @egress(%source: channel<tile<16xi32>>, %output: buffer, %base: offset, %count: index) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %bytes = index.constant 64 : offset
  scf.for %record = [%begin to %count step %step] {
    %read, %payload = channel.acquire %source : channel<tile<16xi32>> -> (read<tile<16xi32>>, view<16xi32>)
    %relative = index.scale %record, %bytes : index, offset -> offset
    %offset = index.add %base, %relative : offset
    %external = buffer.view %output[%offset] : buffer -> view<16xi32>
    %copy = kernel.async.copy %payload to %external {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<16xi32> to view<16xi32> -> kernel.async.token
    %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
    kernel.async.wait %group {newer_groups = 0} : kernel.async.group
    channel.release %read : read<tile<16xi32>>
  }
  func.return
}

pipeline.def<kernel> @distributed_retained_batch(%cache_row: index, %batches: index) run(%input_arg: buffer, %output_arg: buffer) {
  %input_unique, %output_unique = buffer.assume.noalias %input_arg, %output_arg : buffer, buffer
  %input, %output = buffer.assume.alignment %input_unique, %output_unique {minimum_alignment = 64} : buffer, buffer
  %origin = index.constant 0 : offset
  %bytes = index.constant 64 : offset
  %batch_bytes = index.constant 128 : offset
  %right_offset = index.constant 768 : offset
  %single_slot = index.constant 1 : index
  %batch_records = index.constant 2 : index
  %cache_pool = pipeline.memory<workgroup>[0, %cache_row] : pool
  %first_core = pipeline.memory<workgroup>[0, 2] : pool
  %second_core = pipeline.memory<workgroup>[1, 2] : pool
  %replays = index.constant 3 : index
  %records = index.mul %batches, %batch_records : index
  %copies = index.mul %records, %replays : index
  %producer_pool = pipeline.memory<workgroup>[0, 4] : pool
  %prepared_memory = buffer.alloca<workgroup> pool(%producer_pool) align(64) %batch_bytes : buffer
  %prepared_slots = buffer.view %prepared_memory[%origin] : buffer -> view<2x16xi32>
  %prepared = channel.bind<fifo> %prepared_slots, %batch_records : view<2x16xi32>, index -> channel<tile<16xi32>>
  %batch_storage = buffer.alloca<workgroup> pool(%cache_pool) align(64) %batch_bytes : buffer
  %batch_slots = buffer.view %batch_storage[%origin] : buffer -> view<2x16xi32>
  %batch = channel.bind<fifo> %batch_slots, %batch_records : view<2x16xi32>, index -> channel<tile<16xi32>>
  %left_storage = buffer.alloca<workgroup> pool(%first_core) align(64) %bytes : buffer
  %left_slots = buffer.view %left_storage[%origin] : buffer -> view<1x16xi32>
  %left = channel.bind<fifo> %left_slots, %single_slot : view<1x16xi32>, index -> channel<tile<16xi32>>
  %right_storage = buffer.alloca<workgroup> pool(%second_core) align(64) %bytes : buffer
  %right_slots = buffer.view %right_storage[%origin] : buffer -> view<1x16xi32>
  %right = channel.bind<fifo> %right_slots, %single_slot : view<1x16xi32>, index -> channel<tile<16xi32>>
  pipeline.strand workers([0, 4], [1, 1], [1, 1]) {
    func.call @ingress(%input, %prepared, %records) : (buffer, channel<tile<16xi32>>, index)
  }
  pipeline.strand workers([0, 4], [1, 1], [1, 1]) {
    func.call @retain_copy(%prepared, %batch, %records) : (channel<tile<16xi32>>, channel<tile<16xi32>>, index)
  }
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    func.call @distribute(%batch, %left, %right, %batches) : (channel<tile<16xi32>>, channel<tile<16xi32>>, channel<tile<16xi32>>, index)
  }
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    func.call @egress(%left, %output, %origin, %copies) : (channel<tile<16xi32>>, buffer, offset, index)
  }
  pipeline.strand workers([1, 2], [1, 1], [1, 1]) {
    func.call @egress(%right, %output, %right_offset, %copies) : (channel<tile<16xi32>>, buffer, offset, index)
  }
}

func.def inline @reference(%input: buffer, %output: buffer, %batches: index) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %consumers = index.constant 2 : index
  %batch_records = index.constant 2 : index
  %replays = index.constant 3 : index
  %words = index.constant 16 : index
  %source = buffer.view %input[%origin] : buffer -> view<2x2x16xi32>
  %destination = buffer.view %output[%origin] : buffer -> view<2x2x3x2x16xi32>
  scf.for %consumer = [%begin to %consumers step %step] {
    scf.for %batch = [%begin to %batches step %step] {
      scf.for %replay = [%begin to %replays step %step] {
        scf.for %record = [%begin to %batch_records step %step] {
          scf.for %word = [%begin to %words step %step] {
            %value = view.load %source[%batch, %record, %word] : view<2x2x16xi32> -> i32
            %increment = scalar.constant 1 : i32
            %prepared = scalar.addi %value, %increment : i32
            view.store %prepared, %destination[%consumer, %batch, %replay, %record, %word] : i32, view<2x2x3x2x16xi32>
          }
        }
      }
    }
  }
  func.return
}

func.def @reference_single(%input: buffer, %output: buffer) {
  %batches = index.constant 1 : index
  func.call @reference(%input, %output, %batches) : (buffer, buffer, index)
  func.return
}

pipeline.def<kernel> public retain target(@array_target) @single_sram() run(%input: buffer, %output: buffer) {
  %cache_row = index.constant 1 : index
  %batches = index.constant 1 : index
  pipeline.compose @distributed_retained_batch[%cache_row, %batches](%input, %output) : [index, index](buffer, buffer)
}

check.scenario public @single_sram_copy {
  check.trial[3](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input_storage = check.generate.random.uniform seed(%seed) range(-1000000 to 1000000) : tensor<96xi32>
    %input = check.tensor.view %input_storage offset(64) : tensor<96xi32> -> tensor<64xi32>
    %output_storage = check.generate.fill value(-9999) : tensor<416xi32>
    %output = check.tensor.view %output_storage offset(64) : tensor<416xi32> -> tensor<384xi32>
    check.compare<@single_sram, @reference_single>(%input, %output) : (tensor<64xi32>, tensor<384xi32>) -> () {
      check.expect.equal actual(%input_storage) expected(%input_storage) : tensor<96xi32>
      check.expect.equal actual(%output_storage) expected(%output_storage) : tensor<416xi32>
    }
  }
  check.return
}

pipeline.def<kernel> public retain target(@array_target) @single_core() run(%input: buffer, %output: buffer) {
  %cache_row = index.constant 3 : index
  %batches = index.constant 1 : index
  pipeline.compose @distributed_retained_batch[%cache_row, %batches](%input, %output) : [index, index](buffer, buffer)
}

check.scenario public @single_core_copy {
  check.trial[3](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input_storage = check.generate.random.uniform seed(%seed) range(-1000000 to 1000000) : tensor<96xi32>
    %input = check.tensor.view %input_storage offset(64) : tensor<96xi32> -> tensor<64xi32>
    %output_storage = check.generate.fill value(-9999) : tensor<416xi32>
    %output = check.tensor.view %output_storage offset(64) : tensor<416xi32> -> tensor<384xi32>
    check.compare<@single_core, @reference_single>(%input, %output) : (tensor<64xi32>, tensor<384xi32>) -> () {
      check.expect.equal actual(%input_storage) expected(%input_storage) : tensor<96xi32>
      check.expect.equal actual(%output_storage) expected(%output_storage) : tensor<416xi32>
    }
  }
  check.return
}

func.def @reference_repeated(%input: buffer, %output: buffer) {
  %batches = index.constant 2 : index
  func.call @reference(%input, %output, %batches) : (buffer, buffer, index)
  func.return
}

pipeline.def<kernel> public retain target(@array_target) @repeated_sram() run(%input: buffer, %output: buffer) {
  %cache_row = index.constant 1 : index
  %batches = index.constant 2 : index
  pipeline.compose @distributed_retained_batch[%cache_row, %batches](%input, %output) : [index, index](buffer, buffer)
}

check.scenario public @repeated_sram_copy {
  check.trial[3](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input_storage = check.generate.random.uniform seed(%seed) range(-1000000 to 1000000) : tensor<96xi32>
    %input = check.tensor.view %input_storage offset(64) : tensor<96xi32> -> tensor<64xi32>
    %output_storage = check.generate.fill value(-9999) : tensor<416xi32>
    %output = check.tensor.view %output_storage offset(64) : tensor<416xi32> -> tensor<384xi32>
    check.compare<@repeated_sram, @reference_repeated>(%input, %output) : (tensor<64xi32>, tensor<384xi32>) -> () {
      check.expect.equal actual(%input_storage) expected(%input_storage) : tensor<96xi32>
      check.expect.equal actual(%output_storage) expected(%output_storage) : tensor<416xi32>
    }
  }
  check.return
}

pipeline.def<kernel> public retain target(@array_target) @repeated_core() run(%input: buffer, %output: buffer) {
  %cache_row = index.constant 3 : index
  %batches = index.constant 2 : index
  pipeline.compose @distributed_retained_batch[%cache_row, %batches](%input, %output) : [index, index](buffer, buffer)
}

check.scenario public @repeated_core_copy {
  check.trial[3](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input_storage = check.generate.random.uniform seed(%seed) range(-1000000 to 1000000) : tensor<96xi32>
    %input = check.tensor.view %input_storage offset(64) : tensor<96xi32> -> tensor<64xi32>
    %output_storage = check.generate.fill value(-9999) : tensor<416xi32>
    %output = check.tensor.view %output_storage offset(64) : tensor<416xi32> -> tensor<384xi32>
    check.compare<@repeated_core, @reference_repeated>(%input, %output) : (tensor<64xi32>, tensor<384xi32>) -> () {
      check.expect.equal actual(%input_storage) expected(%input_storage) : tensor<96xi32>
      check.expect.equal actual(%output_storage) expected(%output_storage) : tensor<416xi32>
    }
  }
  check.return
}
