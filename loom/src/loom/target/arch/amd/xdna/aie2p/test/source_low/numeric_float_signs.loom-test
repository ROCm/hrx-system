// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_float_signs.loom-test
// RUN: emit source-low target=amd.xdna.aie2p:core output=low

func.def @scalar_f32_signs(%magnitude: f32, %sign: f32) -> (f32, f32, f32) {
  %absolute = scalar.absf %magnitude : f32
  %negated = scalar.negf %magnitude : f32
  %copied = scalar.copysignf %magnitude, %sign : f32
  func.return %absolute, %negated, %copied : f32, f32, f32
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @scalar_f32_signs(%magnitude: reg<aie2p.er>, %sign: reg<aie2p.er>) -> (reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>) asm {
  %13 = mov.i32 2147483647
  %absolute = and %magnitude, %13
  %15 = mov.i32 -2147483648
  %negated = xor %magnitude, %15
  %20 = and %sign, %15
  %copied = or %absolute, %20
  return %absolute, %negated, %copied
}

