// RUN: emit source-low target=amd.xdna.aie2p:core output=low
func.def @vector_bf16_8_signs(%magnitude: vector<8xbf16>, %sign: vector<8xbf16>) -> (vector<8xbf16>, vector<8xbf16>, vector<8xbf16>, vector<8xbf16>) {
  %absolute = vector.absf %magnitude : vector<8xbf16>
  %negated = vector.negf %magnitude : vector<8xbf16>
  %copied = vector.copysignf %magnitude, %sign : vector<8xbf16>
  %signum = vector.signf %magnitude : vector<8xbf16>
  func.return %absolute, %negated, %copied, %signum : vector<8xbf16>, vector<8xbf16>, vector<8xbf16>, vector<8xbf16>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @vector_bf16_8_signs(%magnitude: reg<aie2p.vec256 x2>, %sign: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) asm {
  %35 = mov.i32 2147450879
  %36 = vbcst.32 %35
  %absolute = vband %magnitude, %36
  %38 = mov.i32 -2147450880
  %39 = vbcst.32 %38
  %40 = vbor %magnitude, %39
  %41 = vband %magnitude, %39
  %negated = vsub.32 %40, %41
  %48 = vband %sign, %39
  %copied = vbor %absolute, %48
  %50 = mov.i32 32767
  %51 = vbcst.16 %50
  %52 = vband %magnitude, %51
  %53 = mov.short 0
  %54 = vbcst.16 %53
  %55 = mov.i32 32640
  %56 = vbcst.16 %55
  %57 = vlt.u16x32.el.low32 %54, %52
  %58 = predicate.complete.zero.high32 %57, 0
  %59 = vge.u16x32.el.low32 %56, %52
  %60 = predicate.complete.zero.high32 %59, 0
  %61 = mov.i32 -32768
  %62 = vbcst.16 %61
  %63 = vband %magnitude, %62
  %64 = mov.i32 16256
  %65 = vbcst.16 %64
  %66 = vbor %63, %65
  %67 = vsel.16.mask64 %54, %66, %60
  %signum = vsel.16.mask64 %54, %67, %58
  return %absolute, %negated, %copied, %signum
}

