// RUN: emit source-low target=amd.xdna.aie2p:core output=low

func.def @widen_signed_word(%value: i32) -> (i64) {
  %result = scalar.extsi %value : i32 to i64
  func.return %result : i64
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @widen_signed_word(%value: reg<aie2p.er>) -> (reg<aie2p.er x2>) asm {
  %5 = mov.short -31
  %6 = ashl %value, %5
  %result = concat(%value, %6) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  return %result
}

// ====

func.def @widen_unsigned_word(%value: i32) -> (i64) {
  %result = scalar.extui %value : i32 to i64
  func.return %result : i64
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @widen_unsigned_word(%value: reg<aie2p.er>) -> (reg<aie2p.er x2>) asm {
  %5 = mov.short 0
  %result = concat(%value, %5) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  return %result
}

// ====

func.def @add_signed_word(%base: i64, %delta: i32) -> (i64) {
  %wide_delta = scalar.extsi %delta : i32 to i64
  %result = scalar.addi %base, %wide_delta : i64
  func.return %result : i64
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @add_signed_word(%base: reg<aie2p.er x2>, %delta: reg<aie2p.er>) -> (reg<aie2p.er x2>) asm {
  %8 = mov.short -31
  %9 = ashl %delta, %8
  %11 = slice %base[0] : reg<aie2p.er x2> -> reg<aie2p.er>
  %12 = slice %base[1] : reg<aie2p.er x2> -> reg<aie2p.er>
  %15, %16 = add.carry %11, %delta
  %17, %18 = adc %12, %9, %16
  %result = concat(%15, %17) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  return %result
}

// ====

func.def @assemble_wide_word(%low: i32, %high: i32) -> (i64, i64) {
  %low_word = scalar.extui %low : i32 to i64
  %high_word = scalar.extui %high : i32 to i64
  %word_bits = scalar.constant 32 : i64
  %high_half = scalar.shli %high_word, %word_bits : i64
  %result = scalar.ori %low_word, %high_half : i64
  %exclusive = scalar.xori %high_half, %low_word : i64
  func.return %result, %exclusive : i64, i64
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @assemble_wide_word(%low: reg<aie2p.er>, %high: reg<aie2p.er>) -> (reg<aie2p.er x2>, reg<aie2p.er x2>) asm {
  %result = concat(%low, %high) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  %exclusive = concat(%low, %high) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  return %result, %exclusive
}

// ====

// Retained facts select both word orders; overlapping operands keep bitwise ops.
func.def @join_word_facts(%low_input: i64, %high_input: i64, %overlap: i64) -> (i64, i64, i64, i64) {
  %low = scalar.assume %low_input [range(%low_input, 0, 4294967295)] : i64
  %high = scalar.assume %high_input [multiple_of(%high_input, 4294967296)] : i64
  %joined_or = scalar.ori %high, %low : i64
  %joined_xor = scalar.xori %low, %high : i64
  %overlapping_or = scalar.ori %overlap, %high : i64
  %overlapping_xor = scalar.xori %low, %overlap : i64
  func.return %joined_or, %joined_xor, %overlapping_or, %overlapping_xor : i64, i64, i64, i64
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @join_word_facts(%low: reg<aie2p.er x2>, %high: reg<aie2p.er x2>, %overlap: reg<aie2p.er x2>) -> (reg<aie2p.er x2>, reg<aie2p.er x2>, reg<aie2p.er x2>, reg<aie2p.er x2>) asm {
  %20 = slice %low[0] : reg<aie2p.er x2> -> reg<aie2p.er>
  %21 = slice %high[1] : reg<aie2p.er x2> -> reg<aie2p.er>
  %joined_or = concat(%20, %21) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  %joined_xor = concat(%20, %21) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  %26 = slice %overlap[0] : reg<aie2p.er x2> -> reg<aie2p.er>
  %27 = slice %overlap[1] : reg<aie2p.er x2> -> reg<aie2p.er>
  %28 = slice %high[0] : reg<aie2p.er x2> -> reg<aie2p.er>
  %30 = or %26, %28
  %31 = or %27, %21
  %overlapping_or = concat(%30, %31) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  %34 = slice %low[1] : reg<aie2p.er x2> -> reg<aie2p.er>
  %37 = xor %20, %26
  %38 = xor %34, %27
  %overlapping_xor = concat(%37, %38) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  return %joined_or, %joined_xor, %overlapping_or, %overlapping_xor
}

// ====

func.def @exchange_signed_position(%buffer: buffer, %position: i32, %replacement: i32) -> (i32) {
  %bounded_position = scalar.assume %position [range(%position, -4, 4)] : i32
  %wide_position = scalar.extsi %bounded_position : i32 to i64
  %element_bytes = scalar.constant 4 : i64
  %displacement = scalar.muli %wide_position, %element_bytes : i64
  %center = scalar.constant 16 : i64
  %wide_origin = scalar.addi %center, %displacement : i64
  %origin = index.cast %wide_origin : i64 to offset
  %view = buffer.view %buffer[%origin] : buffer -> view<1xi32>
  %previous = view.load %view[0] : view<1xi32> -> i32
  view.store %replacement, %view[0] : i32, view<1xi32>
  func.return %previous : i32
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @exchange_signed_position(%bounded_position: reg<aie2p.er>, %replacement: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %buffer = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %26 = mov.i32 2
  %27 = lshl %bounded_position, %26
  %28 = add.address-index.immediate %27, 16
  %previous = lda.i32.index %buffer, %28
  st.i32.index %replacement, %buffer, %28
  return %previous
}
