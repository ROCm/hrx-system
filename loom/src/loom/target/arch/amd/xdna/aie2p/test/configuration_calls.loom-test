// RUN: emit source-low output=low

// All configuration operand classes cross nested and repeated helper calls.
// Expansion preserves the effect order and the result-to-operand wiring.
aie2p.target<configuration> @configuration {device_profile = "amd.xdna.strix_halo.17f0_11"}

low.func.def target<amd.xdna.aie2p.configuration>(@configuration) @write_span(%address: reg<aie2p.config.scalar : i64>, %span: reg<aie2p.config.span>) asm {
  %address_flags = constant 0 : reg<aie2p.config.scalar : i64>
  write.address %address, %span, %address_flags
  return
}

low.func.def target<amd.xdna.aie2p.configuration>(@configuration) @forward(%address: reg<aie2p.config.scalar : i64>, %binding: reg<aie2p.config.binding>, %span: reg<aie2p.config.span>) -> (reg<aie2p.config.scalar : i64>, reg<aie2p.config.binding>, reg<aie2p.config.span>) asm {
  low.func.call @write_span(%address, %span) : (reg<aie2p.config.scalar : i64>, reg<aie2p.config.span>)
  return %address, %binding, %span
}

low.func.def public retain target<amd.xdna.aie2p.configuration>(@configuration) @configure() asm {
  %zero = constant 0 : reg<aie2p.config.scalar : i64>
  %read = constant 1 : reg<aie2p.config.scalar : i64>
  %extent = constant 64 : reg<aie2p.config.scalar : i64>
  %bytes = constant 128 : reg<aie2p.config.scalar : i64>
  %address = constant 118784 : reg<aie2p.config.scalar : i64>
  %second_address = constant 118816 : reg<aie2p.config.scalar : i64>
  %binding = binding %zero, %read, %bytes, %extent
  %span = range %binding, %zero, %extent
  %returned_address, %returned_binding, %returned_span = low.func.call @forward(%address, %binding, %span) : (reg<aie2p.config.scalar : i64>, reg<aie2p.config.binding>, reg<aie2p.config.span>) -> (reg<aie2p.config.scalar : i64>, reg<aie2p.config.binding>, reg<aie2p.config.span>)
  %second_span = range %returned_binding, %extent, %extent
  low.func.call @write_span(%second_address, %second_span) : (reg<aie2p.config.scalar : i64>, reg<aie2p.config.span>)
  write.address %returned_address, %returned_span, %zero
  return
}

// ----
low.func.def public retain target<amd.xdna.aie2p.configuration>(@configuration) @configure() asm {
  %zero = constant 0 : reg<aie2p.config.scalar : i64>
  %read = constant 1 : reg<aie2p.config.scalar : i64>
  %extent = constant 64 : reg<aie2p.config.scalar : i64>
  %bytes = constant 128 : reg<aie2p.config.scalar : i64>
  %address = constant 118784 : reg<aie2p.config.scalar : i64>
  %second_address = constant 118816 : reg<aie2p.config.scalar : i64>
  %binding = binding %zero, %read, %bytes, %extent
  %span = range %binding, %zero, %extent
  write.address %address, %span, %zero
  %second_span = range %binding, %extent, %extent
  write.address %second_address, %second_span, %zero
  write.address %address, %span, %zero
  return
}

// ====
// RUN: format bytecode

// Helpers remain ordinary callable source across serialization.
aie2p.target<configuration> @configuration {device_profile = "amd.xdna.krackan.17f0_20"}

low.func.def target<amd.xdna.aie2p.configuration>(@configuration) @identity(%scalar: reg<aie2p.config.scalar : i64>, %binding: reg<aie2p.config.binding>, %span: reg<aie2p.config.span>) -> (reg<aie2p.config.scalar : i64>, reg<aie2p.config.binding>, reg<aie2p.config.span>) asm {
  return %scalar, %binding, %span
}

low.func.def target<amd.xdna.aie2p.configuration>(@configuration) @forward(%scalar: reg<aie2p.config.scalar : i64>, %binding: reg<aie2p.config.binding>, %span: reg<aie2p.config.span>) -> (reg<aie2p.config.scalar : i64>, reg<aie2p.config.binding>, reg<aie2p.config.span>) asm {
  %a, %b, %c = low.func.call @identity(%scalar, %binding, %span) : (reg<aie2p.config.scalar : i64>, reg<aie2p.config.binding>, reg<aie2p.config.span>) -> (reg<aie2p.config.scalar : i64>, reg<aie2p.config.binding>, reg<aie2p.config.span>)
  return %a, %b, %c
}

// ====
// RUN: emit source-low output=low

// Initialization helpers expand on the other exact deployment profiles too.
aie2p.target<configuration> @configuration {device_profile = "amd.xdna.strix.17f0_10"}

low.func.def target<amd.xdna.aie2p.configuration>(@configuration) @reserve(%column: reg<aie2p.config.scalar : i64>, %row: reg<aie2p.config.scalar : i64>) asm {
  %zero = constant 0 : reg<aie2p.config.scalar : i64>
  %extent = constant 64 : reg<aie2p.config.scalar : i64>
  data.reserve %column, %row, %zero, %extent
  return
}

low.func.def public retain target<amd.xdna.aie2p.configuration>(@configuration) @initialize() asm {
  %column = constant 0 : reg<aie2p.config.scalar : i64>
  %row = constant 2 : reg<aie2p.config.scalar : i64>
  low.func.call @reserve(%column, %row) : (reg<aie2p.config.scalar : i64>, reg<aie2p.config.scalar : i64>)
  return
}

// ----
low.func.def public retain target<amd.xdna.aie2p.configuration>(@configuration) @initialize() asm {
  %column = constant 0 : reg<aie2p.config.scalar : i64>
  %row = constant 2 : reg<aie2p.config.scalar : i64>
  %extent = constant 64 : reg<aie2p.config.scalar : i64>
  data.reserve %column, %row, %column, %extent
  return
}

// ====
// RUN: emit source-low output=none

// Configuration has no native call instruction, including zero-argument calls.
aie2p.target<configuration> @configuration {device_profile = "amd.xdna.krackan.17f0_20"}

low.func.def noinline target<amd.xdna.aie2p.configuration>(@configuration) @publish() asm {
  return
}

low.func.def public retain target<amd.xdna.aie2p.configuration>(@configuration) @invoke() asm {
  // ERROR@+1: LOWERING/044 {op_name="low.func.call", phase_name="inline-callables", callee_name="publish", failure_code="target_requires_inline"}
  low.func.call @publish() : ()
  return
}

// ====
// RUN: emit source-low output=none

aie2p.target<configuration> @configuration

low.func.def public retain target<amd.xdna.aie2p.configuration>(@configuration) @recursive() asm {
  // ERROR@+1: LOWERING/044 {op_name="low.func.call", phase_name="inline-callables", callee_name="recursive", failure_code="required_cycle"}
  low.func.call @recursive() : ()
  return
}

// ====
// RUN: emit aie2p-xdna

// Direct physical emission rejects source that still needs call expansion.
aie2p.target<configuration> @configuration {device_profile = "amd.xdna.strix_halo.17f0_11"}

low.func.def public retain target<amd.xdna.aie2p.configuration>(@configuration) abi(array_program) @entry() asm {
  %one = constant 1 : reg<aie2p.config.scalar : i64>
  entry %one, @initialize, @invoke
  return
}

low.func.def target<amd.xdna.aie2p.configuration>(@configuration) @initialize() asm {
  return
}

// ERROR@+1: XDNA/059 {function_name="invoke"}
low.func.def target<amd.xdna.aie2p.configuration>(@configuration) @invoke() asm {
  low.func.call @initialize() : ()
  return
}

// ====
// RUN: emit source-low output=none

// Inlined commands retain their phase restrictions at the compile boundary.
aie2p.target<configuration> @configuration {device_profile = "amd.xdna.strix_halo.17f0_11"}

low.func.def public retain target<amd.xdna.aie2p.configuration>(@configuration) abi(array_program) @entry() asm {
  %one = constant 1 : reg<aie2p.config.scalar : i64>
  entry %one, @initialize, @invoke
  return
}

low.func.def target<amd.xdna.aie2p.configuration>(@configuration) @initialize() asm {
  low.func.call @declare_binding() : ()
  return
}

low.func.def target<amd.xdna.aie2p.configuration>(@configuration) @invoke() asm {
  return
}

low.func.def target<amd.xdna.aie2p.configuration>(@configuration) @declare_binding() asm {
  %zero = constant 0 : reg<aie2p.config.scalar : i64>
  %read = constant 1 : reg<aie2p.config.scalar : i64>
  %extent = constant 64 : reg<aie2p.config.scalar : i64>
  // ERROR@+1: XDNA/038 {function_name="initialize", phase="initialization", command="amd.xdna.aie2p.configuration.binding"}
  %binding = binding %zero, %read, %extent, %extent
  return
}

// ====
// RUN: verify

// A helper may have a signature; an entry's phase reference supplies none.
aie2p.target<configuration> @configuration

low.func.def target<amd.xdna.aie2p.configuration>(@configuration) abi(array_program) @entry() asm {
  %one = constant 1 : reg<aie2p.config.scalar : i64>
  // ERROR@+2: XDNA/037 {field_name="initialize", symbol_name="initialize", argument_count="1", result_count="0"}
  // ERROR@+1: XDNA/037 {field_name="invoke", symbol_name="invoke", argument_count="0", result_count="1"}
  entry %one, @initialize, @invoke
  return
}

low.func.def target<amd.xdna.aie2p.configuration>(@configuration) @initialize(%argument: reg<aie2p.config.scalar : i64>) asm {
  return
}

low.func.def target<amd.xdna.aie2p.configuration>(@configuration) @invoke() -> (reg<aie2p.config.scalar : i64>) asm {
  %zero = constant 0 : reg<aie2p.config.scalar : i64>
  return %zero
}

// ====
// RUN: verify

// A helper cannot supply only one half of a measurement interval.
aie2p.target<configuration> @configuration

// ERROR@+1: XDNA/057 {function_name="begin", reason="missing measure.end"}
low.func.def target<amd.xdna.aie2p.configuration>(@configuration) @begin() asm {
  measure.begin
  return
}

// ====
// RUN: verify

// A core function is independently executed worker code, not a configuration
// fragment that can be spliced into a command phase.
aie2p.target<configuration> @configuration

aie2p.target<core> @core

low.func.def target<amd.xdna.aie2p.core>(@core) @worker() asm {
  return
}

low.func.def target<amd.xdna.aie2p.configuration>(@configuration) @invoke() asm {
  // ERROR@+1: TARGET/040 {op_name="low.func.call", field_name="callee", callee_target_name="core", caller_target_name="configuration"}
  low.func.call @worker() : ()
  return
}
