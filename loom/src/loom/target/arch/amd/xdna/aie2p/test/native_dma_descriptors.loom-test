// RUN: emit source-low output=low

// Two live egress copies form one two-descriptor chain even though their
// dynamic addresses and immutable geometry have the same form. A following
// singleton cannot split that chain for reuse. The final singleton reuses the
// preceding singleton, and its fixed external address promotes the shared Shim
// descriptor to per-issue address patching.
aie2p.target<array> @device {device_profile = "amd.xdna.strix.17f0_10"}

pipeline.def<kernel> public retain target(@device) @grouped_projection() run(%output_arg: buffer) {
  %output = buffer.assume.alignment %output_arg {minimum_alignment = 4} : buffer
  %memory = pipeline.memory<workgroup>[0, 3] : pool
  %origin = index.constant 0 : offset
  %bytes = index.constant 16 : offset
  %capacity = index.constant 1 : index
  %storage = buffer.alloca<workgroup> pool(%memory) align(4) %bytes : buffer
  %slots = buffer.view %storage[%origin] : buffer -> view<1x4xi32>
  %records = channel.bind<fifo> %slots, %capacity : view<1x4xi32>, index -> channel<tile<4xi32>>
  pipeline.strand workers([0, 3], [1, 1], [1, 1]) {
    %write, %destination = channel.reserve %records : channel<tile<4xi32>> -> (write<tile<4xi32>>, view<4xi32>)
    %values = vector.splati 11 : vector<4xi32>
    vector.store %values, %destination[0] : vector<4xi32>, view<4xi32>
    channel.publish %write : write<tile<4xi32>>
    %read, %source = channel.acquire %records : channel<tile<4xi32>> -> (read<tile<4xi32>>, view<4xi32>)
    %begin = index.constant 0 : index
    %end = index.constant 2 : index
    %step = index.constant 1 : index
    %word_bytes = index.constant 4 : index
    %pair_bytes = index.constant 8 : index
    %tail_base = index.constant 16 : index
    %snapshot_offset = index.constant 24 : offset
    %snapshot = buffer.view %output[%snapshot_offset] : buffer -> view<1xi32>
    scf.for %position = [%begin to %end step %step] {
      %next = index.add %position, %step : index
      %first_source = view.subview %source[%position] : view<4xi32> -> view<1xi32>
      %second_source = view.subview %source[%next] : view<4xi32> -> view<1xi32>
      %first_index = index.mul %position, %pair_bytes : index
      %second_index = index.add %first_index, %word_bytes : index
      %first_offset = index.cast %first_index : index to offset
      %second_offset = index.cast %second_index : index to offset
      %first_output = buffer.view %output[%first_offset] : buffer -> view<1xi32>
      %second_output = buffer.view %output[%second_offset] : buffer -> view<1xi32>
      %first_copy = kernel.async.copy %first_source to %first_output {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<1xi32> to view<1xi32> -> kernel.async.token
      %second_copy = kernel.async.copy %second_source to %second_output {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<1xi32> to view<1xi32> -> kernel.async.token
      %group = kernel.async.group %first_copy, %second_copy : kernel.async.token, kernel.async.token -> kernel.async.group
      kernel.async.wait %group {newer_groups = 0} : kernel.async.group
      %tail_relative = index.mul %position, %word_bytes : index
      %tail_index = index.add %tail_base, %tail_relative : index
      %tail_offset = index.cast %tail_index : index to offset
      %tail_output = buffer.view %output[%tail_offset] : buffer -> view<1xi32>
      %tail_copy = kernel.async.copy %first_source to %tail_output {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<1xi32> to view<1xi32> -> kernel.async.token
      %tail_group = kernel.async.group %tail_copy : kernel.async.token -> kernel.async.group
      kernel.async.wait %tail_group {newer_groups = 0} : kernel.async.group
      %snapshot_copy = kernel.async.copy %second_source to %snapshot {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<1xi32> to view<1xi32> -> kernel.async.token
      %snapshot_group = kernel.async.group %snapshot_copy : kernel.async.token -> kernel.async.group
      kernel.async.wait %snapshot_group {newer_groups = 0} : kernel.async.group
    }
    channel.release %read : read<tile<4xi32>>
  }
}

