// RUN: with-checks emit source-low output=low

// Three static submissions share one two-descriptor patch body. Each caller
// supplies its own offsets and relocation/descriptor words.
aie2p.target<array> @npu {device_profile = "amd.xdna.strix.17f0_10"}

pipeline.def<kernel> public retain target(@npu) @copy_groups() run(%output_arg: buffer) {
  %output = buffer.assume.alignment %output_arg {minimum_alignment = 4} : buffer
  %memory = pipeline.memory<workgroup>[0, 3] : pool
  %storage_origin = index.constant 0 : offset
  %bytes = index.constant 128 : offset
  %capacity = index.constant 1 : index
  %storage = buffer.alloca<workgroup> pool(%memory) align(4) %bytes : buffer
  %slots = buffer.view %storage[%storage_origin] : buffer -> view<1x32xi32>
  %channel = channel.bind<fifo> %slots, %capacity : view<1x32xi32>, index -> channel<tile<32xi32>>
  pipeline.strand workers([0, 3], [1, 1], [1, 1]) {
    %write, %destination = channel.reserve %channel : channel<tile<32xi32>> -> (write<tile<32xi32>>, view<32xi32>)
    %values = vector.splati 17 : vector<32xi32>
    vector.store %values, %destination[0] : vector<32xi32>, view<32xi32>
    channel.publish %write : write<tile<32xi32>>
    %read, %source = channel.acquire %channel : channel<tile<32xi32>> -> (read<tile<32xi32>>, view<32xi32>)
    %begin = index.constant 0 : index
    %end = index.constant 3 : index
    %step = index.constant 1 : index
    %stride = index.constant 32 : index
    scf.for %position = [%begin to %end step %step] unroll {
      %record_offset = index.mul %position, %stride : index
      %element0 = index.constant 0 : index
      %word0 = index.add %position, %element0 : index
      %part0 = view.subview %source[%word0] : view<32xi32> -> view<1xi32>
      %relative0 = index.constant 0 : index
      %address0 = index.add %record_offset, %relative0 : index
      %offset0 = index.cast %address0 : index to offset
      %target0 = buffer.view %output[%offset0] : buffer -> view<1xi32>
      %copy0 = kernel.async.copy %part0 to %target0 {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<1xi32> to view<1xi32> -> kernel.async.token
      %element1 = index.constant 1 : index
      %word1 = index.add %position, %element1 : index
      %part1 = view.subview %source[%word1] : view<32xi32> -> view<1xi32>
      %relative1 = index.constant 4 : index
      %address1 = index.add %record_offset, %relative1 : index
      %offset1 = index.cast %address1 : index to offset
      %target1 = buffer.view %output[%offset1] : buffer -> view<1xi32>
      %copy1 = kernel.async.copy %part1 to %target1 {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<1xi32> to view<1xi32> -> kernel.async.token
      %group = kernel.async.group %copy0, %copy1 : kernel.async.token, kernel.async.token -> kernel.async.group
      kernel.async.wait %group {newer_groups = 0} : kernel.async.group
    }
    channel.release %read : read<tile<32xi32>>
  }
}

