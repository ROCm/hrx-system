CHECK: * = partition.sender * : reg<aie2p.array.sender : tile<4xi32>>
CHECK: * = partition.receiver * : reg<aie2p.array.receiver : tile<2x2xi32>>
CHECK: * = view.receiver * : reg<aie2p.array.receiver : tile<4xi32>>
