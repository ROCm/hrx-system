// RUN: with-checks pass aie2p-lower-pipeline

aie2p.target<array> @array_target

aie2p.target<core> @core_target

func.decl target(@core_target) @copy(%input: buffer, %output: buffer)

pipeline.def<kernel> public retain target(@array_target) @scatter_unit_unit() launch(%input: buffer, %output: buffer) {
  %lanes = index.constant 1 : index
  %base = index.constant 0 : offset
  %workers = group.create %lanes : index -> group
  %input_view = buffer.view %input[%base] : buffer -> view<1x1x4xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<1x1x2x2xi32>
  %input_flow = pipeline.scatter %input_view across %workers : view<1x1x4xi32>, group -> pipeline.flow<tile<4xi32>>
  %output_flow = pipeline.stage @copy on %workers(%input_flow) : (group, pipeline.flow<tile<4xi32>>) -> (pipeline.flow<tile<2x2xi32>>)
  pipeline.write %output_flow to %output_view : pipeline.flow<tile<2x2xi32>>, view<1x1x2x2xi32>
  pipeline.return
}

// ----
CHECK: low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) abi_layout({binding_count = 2}) @scatter_unit_unit() asm {
CHECK: * = channel * : reg<aie2p.array.channel : tile<2x2xi32>>
CHECK: * = partition.sender * : reg<aie2p.array.sender : tile<4xi32>>
CHECK: * = partition.receiver * : reg<aie2p.array.receiver : tile<2x2xi32>>

