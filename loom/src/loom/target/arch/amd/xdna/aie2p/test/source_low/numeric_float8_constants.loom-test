func.def @float8_midpoint_neighbors() -> (f8E4M3, f8E4M3, f8E5M2, f8E5M2) {
  %e4_above_even = scalar.constant 1.0625000000000002 : f8E4M3
  %e4_below_odd = scalar.constant 1.1874999999999998 : f8E4M3
  %e5_above_even = scalar.constant 1.1250000000000002 : f8E5M2
  %e5_below_odd = scalar.constant 1.3749999999999998 : f8E5M2
  func.return %e4_above_even, %e4_below_odd, %e5_above_even, %e5_below_odd : f8E4M3, f8E4M3, f8E5M2, f8E5M2
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @float8_midpoint_neighbors() -> (reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>) asm {
  %e4_above_even = mov.i32 57
  %e5_above_even = mov.i32 61
  return %e4_above_even, %e4_above_even, %e5_above_even, %e5_above_even
}

// ====

func.def @float8_vector_midpoints() -> (vector<4xf8E4M3>, vector<8xf8E5M2>) {
  %e4_above_even = vector.splatf 1.0625000000000002 : vector<4xf8E4M3>
  %e5_below_odd = vector.splatf 1.3749999999999998 : vector<8xf8E5M2>
  func.return %e4_above_even, %e5_below_odd : vector<4xf8E4M3>, vector<8xf8E5M2>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @float8_vector_midpoints() -> (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) asm {
  %6 = mov.i32 57
  %e4_above_even = vbcst.8 %6
  %8 = mov.i32 61
  %e5_below_odd = vbcst.8 %8
  return %e4_above_even, %e5_below_odd
}

// ====

func.def @float8_vector_specials() -> (vector<1xf8E4M3>, vector<5xf8E4M3>, vector<4xf8E5M2>, vector<8xf8E5M2>) {
  %e4_negative_zero = vector.splatf -0.0 : vector<1xf8E4M3>
  %e4_saturated = vector.splatf inf : vector<5xf8E4M3>
  %e5_negative_infinity = vector.splatf -inf : vector<4xf8E5M2>
  %e5_nan = vector.splatf nan : vector<8xf8E5M2>
  func.return %e4_negative_zero, %e4_saturated, %e5_negative_infinity, %e5_nan : vector<1xf8E4M3>, vector<5xf8E4M3>, vector<4xf8E5M2>, vector<8xf8E5M2>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @float8_vector_specials() -> (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) asm {
  %12 = mov.i32 128
  %e4_negative_zero = vbcst.8 %12
  %14 = mov.i32 126
  %e4_saturated = vbcst.8 %14
  %16 = mov.i32 252
  %e5_negative_infinity = vbcst.8 %16
  %18 = mov.i32 127
  %e5_nan = vbcst.8 %18
  return %e4_negative_zero, %e4_saturated, %e5_negative_infinity, %e5_nan
}
