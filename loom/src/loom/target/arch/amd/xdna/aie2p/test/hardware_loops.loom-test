// RUN: emit aie2p-xdna input=source-low output=hardware-loops

aie2p.target<array> @array_target {device_profile = "amd.xdna.strix_halo.17f0_11"}

aie2p.target<core> @core_target {device_profile = "amd.xdna.strix_halo.17f0_11"}

low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) abi_layout({binding_count = 3}) @hardware_loop_pipeline() asm {
  %worker_count = constant.u32 1 : reg<aie2p.array.scalar : index>
  %workers = group %worker_count
  %worker_rank = constant.u32 0 : reg<aie2p.array.scalar : index>
  %worker = worker %workers, %worker_rank, @hardware_loop_worker
  %lhs = binding 0, "read"
  %rhs = binding 1, "read"
  %output = binding 2, "write"
  %lhs_sender = sender %lhs, 0 : reg<aie2p.array.sender : tile<4xi32>>
  %worker_receiver_0 = receiver %worker, 0 : reg<aie2p.array.receiver : tile<4xi32>>
  %lhs_capacity = constant.u32 2 : reg<aie2p.array.scalar : index>
  %one_record = constant.u32 1 : reg<aie2p.array.scalar : index>
  %lhs_channel = channel %lhs_sender, %worker_receiver_0, %lhs_capacity, %one_record : reg<aie2p.array.channel : tile<4xi32>>
  %rhs_sender = sender %rhs, 0 : reg<aie2p.array.sender : tile<4xi32>>
  %worker_receiver_1 = receiver %worker, 1 : reg<aie2p.array.receiver : tile<4xi32>>
  %rhs_capacity = constant.u32 2 : reg<aie2p.array.scalar : index>
  %rhs_channel = channel %rhs_sender, %worker_receiver_1, %rhs_capacity, %one_record : reg<aie2p.array.channel : tile<4xi32>>
  %worker_sender_2 = sender %worker, 2 : reg<aie2p.array.sender : tile<4xi32>>
  %output_receiver = receiver %output, 0 : reg<aie2p.array.receiver : tile<4xi32>>
  %output_capacity = constant.u32 2 : reg<aie2p.array.scalar : index>
  %output_channel = channel %worker_sender_2, %output_receiver, %output_capacity, %one_record : reg<aie2p.array.channel : tile<4xi32>>
  %worker_column = constant.u32 0 : reg<aie2p.array.scalar : index>
  %worker_row = constant.u32 2 : reg<aie2p.array.scalar : index>
  constrain.location %worker, %worker_column, %worker_row
  return
}

func.def target(@core_target) @hardware_loop_worker(%lhs: buffer, %rhs: buffer, %output: buffer) {
  %lhs_aligned, %rhs_aligned, %output_aligned = buffer.assume.alignment %lhs, %rhs, %output {minimum_alignment = 64} : buffer, buffer, buffer
  %base = index.constant 0 : offset
  %lhs_view = buffer.view %lhs_aligned[%base] : buffer -> view<4xi32>
  %rhs_view = buffer.view %rhs_aligned[%base] : buffer -> view<4xi32>
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<4xi32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %count = index.constant 4 : index
  scf.for %i = [%c0 to %count step %c1] {
    %lhs_value = view.load %lhs_view[%i] : view<4xi32> -> i32
    %rhs_value = view.load %rhs_view[%i] : view<4xi32> -> i32
    %v0 = scalar.addi %lhs_value, %rhs_value : i32
    %v1 = scalar.addi %v0, %rhs_value : i32
    %v2 = scalar.addi %v1, %rhs_value : i32
    %v3 = scalar.addi %v2, %rhs_value : i32
    %v4 = scalar.addi %v3, %rhs_value : i32
    %v5 = scalar.addi %v4, %rhs_value : i32
    %v6 = scalar.addi %v5, %rhs_value : i32
    %v7 = scalar.addi %v6, %rhs_value : i32
    %v8 = scalar.addi %v7, %rhs_value : i32
    %v9 = scalar.addi %v8, %rhs_value : i32
    %v10 = scalar.addi %v9, %rhs_value : i32
    %v11 = scalar.addi %v10, %rhs_value : i32
    %v12 = scalar.addi %v11, %rhs_value : i32
    %v13 = scalar.addi %v12, %rhs_value : i32
    view.store %v13, %output_view[%i] : i32, view<4xi32>
  }
  func.return
}

// ----
.text.hardware_loop_pipeline$worker$0: hardware_loops=1
  loop 0: iterations=4 count_start_coissued=true end_setup_next=true start_aligned=true start_after_setup=true end_aligned=true end_on_bundle=true end_group_full_width=true setup_distance_valid=true trailing_nop_bundles=3 body_control=0

// ====

// RUN: emit aie2p-xdna input=source-low output=hardware-loops

// Each iteration advances to a disjoint 128-byte panel. The final store remains
// in flight past the body boundary, but the next panel can start without NOP
// tail bundles once the realized native recurrence has been admitted.

aie2p.target<array> @array_target {device_profile = "amd.xdna.strix_halo.17f0_11"}

aie2p.target<core> @core_target {device_profile = "amd.xdna.strix_halo.17f0_11"}

func.def inline @loop_worker(%storage: buffer) {
  %step_bytes = scalar.constant 128 : i32
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  %final = scf.for %index = [%c0 to %c8 step %c1](%cursor = %storage : buffer) -> (buffer) {
    %next = low.invoke @copy_and_advance(%cursor, %step_bytes) : (buffer, i32) -> (buffer)
    scf.yield %next : buffer
  }
  func.return
}

pipeline.def<kernel> public retain target(@array_target) @hardware_loop_recurrence() run(%external_arg: buffer) {
  %external_unique = buffer.assume.noalias %external_arg : buffer
  %external = buffer.assume.alignment %external_unique {minimum_alignment = 64} : buffer
  %memory = pipeline.memory<workgroup>[0, 3] : pool
  %origin = index.constant 0 : offset
  %capacity = index.constant 1 : index
  %bytes = index.constant 1024 : offset
  %storage = buffer.alloca<workgroup> pool(%memory) align(64) %bytes : buffer
  %slots = buffer.view %storage[%origin] : buffer -> view<1x256xi32>
  %records = channel.bind<fifo> %slots, %capacity : view<1x256xi32>, index -> channel<tile<256xi32>>

  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %external_view = buffer.view %external[%origin] : buffer -> view<256xi32>
    %write, %destination = channel.reserve %records : channel<tile<256xi32>> -> (write<tile<256xi32>>, view<256xi32>)
    %ingress = kernel.async.copy %external_view to %destination {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<256xi32> to view<256xi32> -> kernel.async.token
    %incoming = kernel.async.group %ingress : kernel.async.token -> kernel.async.group
    kernel.async.wait %incoming {newer_groups = 0} : kernel.async.group
    channel.publish %write : write<tile<256xi32>>
  }

  pipeline.strand workers([0, 3], [1, 1], [1, 1]) {
    %read, %payload = channel.acquire<mutable> %records : channel<tile<256xi32>> -> (read<tile<256xi32>, mutable>, view<256xi32>)
    func.call @loop_worker(%storage) : (buffer)
    %external_view = buffer.view %external[%origin] : buffer -> view<256xi32>
    %egress = kernel.async.copy %payload to %external_view {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<256xi32> to view<256xi32> -> kernel.async.token
    %outgoing = kernel.async.group %egress : kernel.async.token -> kernel.async.group
    kernel.async.wait %outgoing {newer_groups = 0} : kernel.async.group
    channel.release %read : read<tile<256xi32>, mutable>
  }
}

low.func.def inline target<amd.xdna.aie2p.core>(@core_target) @copy_and_advance(%cursor: reg<aie2p.ep>, %step_bytes: reg<aie2p.er>) -> (reg<aie2p.ep>) asm {
  %left = vlda.512.i32x16 %cursor, 0
  %right = vldb.512.i32x16 %cursor, 64
  %sum0 = vadd.32 %left, %right
  %sum1 = vadd.32 %sum0, %right
  %sum2 = vadd.32 %sum1, %right
  %sum3 = vadd.32 %sum2, %right
  %sum4 = vadd.32 %sum3, %right
  %sum5 = vadd.32 %sum4, %right
  %sum6 = vadd.32 %sum5, %right
  %sum7 = vadd.32 %sum6, %right
  %sum8 = vadd.32 %sum7, %right
  %sum9 = vadd.32 %sum8, %right
  %sum10 = vadd.32 %sum9, %right
  %sum11 = vadd.32 %sum10, %right
  %sum12 = vadd.32 %sum11, %right
  %sum13 = vadd.32 %sum12, %right
  %sum14 = vadd.32 %sum13, %right
  %sum15 = vadd.32 %sum14, %right
  %sum16 = vadd.32 %sum15, %right
  %sum17 = vadd.32 %sum16, %right
  %sum18 = vadd.32 %sum17, %right
  %sum19 = vadd.32 %sum18, %right
  vst.512.i32x16 %sum19, %cursor, 0
  %modifier = mov.modifier %step_bytes
  %next = padda.modifier %cursor, %modifier
  return %next
}

// ----
.text.__pipeline_worker_1: hardware_loops=1
  loop 0: iterations=8 count_start_coissued=true end_setup_next=true start_aligned=true start_after_setup=true end_aligned=true end_on_bundle=true end_group_full_width=true setup_distance_valid=true trailing_nop_bundles=0 body_control=0
