low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @i32x4_to_i8x4_bitpack(%codes: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %34 = vextract.32.imm %codes, 0
  %35 = mov.short 255
  %36 = and %34, %35
  %37 = vextract.32.imm %codes, 1
  %38 = and %37, %35
  %39 = vextract.32.imm %codes, 2
  %40 = and %39, %35
  %41 = vextract.32.imm %codes, 3
  %42 = and %41, %35
  %43 = vbcst.8 %36
  %44 = mov.short 1
  %45 = copy %44 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %46 = vinsert.8.reg %43, %45, %38
  %47 = mov.short 2
  %48 = copy %47 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %49 = vinsert.8.reg %46, %48, %40
  %50 = mov.short 3
  %51 = copy %50 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %packed = vinsert.8.reg %49, %51, %42
  return %packed
}

