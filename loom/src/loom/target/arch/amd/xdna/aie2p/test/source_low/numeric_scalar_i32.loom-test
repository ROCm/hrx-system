// RUN: emit source-low target=amd.xdna.aie2p:core output=low

func.def @scalar_i32_uniform_sgpr(%lhs: i32, %rhs: i32, %shift: i32) -> (i32) {
  %add = scalar.addi %lhs, %rhs : i32
  %sub = scalar.subi %add, %rhs : i32
  %product = scalar.muli %sub, %rhs : i32
  %and = scalar.andi %product, %lhs : i32
  %or = scalar.ori %and, %rhs : i32
  %xor = scalar.xori %or, %lhs : i32
  %shl = scalar.shli %xor, %shift : i32
  %ashr = scalar.shrsi %shl, %shift : i32
  %lshr = scalar.shrui %ashr, %shift : i32
  func.return %lshr : i32
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @scalar_i32_uniform_sgpr(%lhs: reg<aie2p.er>, %rhs: reg<aie2p.er>, %shift: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %product = mul %lhs, %rhs
  %and = and %product, %lhs
  %or = or %and, %rhs
  %xor = xor %or, %lhs
  %shl = lshl %xor, %shift
  %22 = mov.short 0
  %23 = sub %22, %shift
  %ashr = ashl %shl, %23
  %26 = sub %22, %shift
  %lshr = lshl %ashr, %26
  return %lshr
}

// ====

func.def @scalar_i32_multiply_add(%a: i32, %b: i32, %c: i32) -> (i32) {
  %product = scalar.muli %a, %b : i32
  %result = scalar.addi %product, %c : i32
  func.return %result : i32
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @scalar_i32_multiply_add(%a: reg<aie2p.er>, %b: reg<aie2p.er>, %c: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %11 = copy %c : reg<aie2p.er> -> reg<aie2p.er>
  %result = mac %11, %a, %b
  return %result
}

// ====

func.def @scalar_i32_bitfield_argument(%word: i32) -> (i32, i32, i32, i32, i32, i32) {
  %unsigned_byte = scalar.bitfield.extractu %word {offset = 8, width = 8} : i32 -> i32
  %signed_byte = scalar.bitfield.extracts %word {offset = 16, width = 8} : i32 -> i32
  %unsigned_nibble = scalar.bitfield.extractu %word {offset = 4, width = 4} : i32 -> i32
  %signed_nibble = scalar.bitfield.extracts %word {offset = 4, width = 4} : i32 -> i32
  %unsigned_top = scalar.bitfield.extractu %word {offset = 24, width = 8} : i32 -> i32
  %signed_top = scalar.bitfield.extracts %word {offset = 24, width = 8} : i32 -> i32
  func.return %unsigned_byte, %signed_byte, %unsigned_nibble, %signed_nibble, %unsigned_top, %signed_top : i32, i32, i32, i32, i32, i32
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @scalar_i32_bitfield_argument(%word: reg<aie2p.er>) -> (reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>) asm {
  %20 = mov.short 16
  %21 = lshl %word, %20
  %22 = mov.short -24
  %unsigned_byte = lshl %21, %22
  %24 = mov.short 8
  %25 = lshl %word, %24
  %signed_byte = ashl %25, %22
  %28 = mov.short 24
  %29 = lshl %word, %28
  %30 = mov.short -28
  %unsigned_nibble = lshl %29, %30
  %signed_nibble = ashl %29, %30
  %36 = mov.short 0
  %37 = lshl %word, %36
  %unsigned_top = lshl %37, %22
  %signed_top = ashl %37, %22
  return %unsigned_byte, %signed_byte, %unsigned_nibble, %signed_nibble, %unsigned_top, %signed_top
}

// ====

func.def @scalar_i32_bitfield_vector_lane(%packed: vector<1xi32>) -> (i32, i32, i32, i32) {
  %word = vector.extract %packed[0] : vector<1xi32> -> i32
  %unsigned_top = scalar.bitfield.extractu %word {offset = 24, width = 8} : i32 -> i32
  %signed_top = scalar.bitfield.extracts %word {offset = 24, width = 8} : i32 -> i32
  %unsigned_middle = scalar.bitfield.extractu %word {offset = 8, width = 8} : i32 -> i32
  %signed_middle = scalar.bitfield.extracts %word {offset = 8, width = 8} : i32 -> i32
  func.return %unsigned_top, %signed_top, %unsigned_middle, %signed_middle : i32, i32, i32, i32
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @scalar_i32_bitfield_vector_lane(%packed: reg<aie2p.vec256 x2>) -> (reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>) asm {
  %word = vextract.32.imm %packed, 0
  %16 = mov.short 0
  %17 = lshl %word, %16
  %18 = mov.short -24
  %unsigned_top = lshl %17, %18
  %signed_top = ashl %17, %18
  %24 = mov.short 16
  %25 = lshl %word, %24
  %unsigned_middle = lshl %25, %18
  %signed_middle = ashl %25, %18
  return %unsigned_top, %signed_top, %unsigned_middle, %signed_middle
}

// ====

func.def @scalar_i32_compare_scc(%lhs: i32, %rhs: i32) -> (i1) {
  %cmp = scalar.cmpi slt, %lhs, %rhs : i32
  func.return %cmp : i1
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @scalar_i32_compare_scc(%lhs: reg<aie2p.er>, %rhs: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %cmp = lt %lhs, %rhs
  return %cmp
}

// ====

func.def @scalar_i1_constants_scc() -> (i1, i1) {
  %true = scalar.constant true : i1
  %false = scalar.constant false : i1
  func.return %true, %false : i1, i1
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @scalar_i1_constants_scc() -> (reg<aie2p.er>, reg<aie2p.er>) asm {
  %true = mov.short 1
  %false = mov.short 0
  return %true, %false
}

// ====

func.def @scalar_i1_bitwise_scc(%lhs: i32, %rhs: i32) -> (i1) {
  %inactive_condition = scalar.constant 0 : i32
  %lhs_nonzero = scalar.cmpi ne, %lhs, %inactive_condition : i32
  %rhs_nonzero = scalar.cmpi ne, %rhs, %inactive_condition : i32
  %both_nonzero = scalar.andi %lhs_nonzero, %rhs_nonzero : i1
  %either_nonzero = scalar.ori %lhs_nonzero, %rhs_nonzero : i1
  %one_nonzero = scalar.xori %both_nonzero, %either_nonzero : i1
  func.return %one_nonzero : i1
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @scalar_i1_bitwise_scc(%lhs: reg<aie2p.er>, %rhs: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %lhs_nonzero = nez %lhs
  %rhs_nonzero = nez %rhs
  %both_nonzero = and %lhs_nonzero, %rhs_nonzero
  %either_nonzero = or %lhs_nonzero, %rhs_nonzero
  %one_nonzero = xor %both_nonzero, %either_nonzero
  return %one_nonzero
}

// ====

func.def @scalar_i32_carry_borrow(%lhs: i32, %rhs: i32) -> (i32, i1, i32, i1) {
  %sum, %carry = scalar.addcarryui %lhs, %rhs : i32
  %difference, %borrow = scalar.subborrowui %lhs, %rhs : i32
  func.return %sum, %carry, %difference, %borrow : i32, i1, i32, i1
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @scalar_i32_carry_borrow(%lhs: reg<aie2p.er>, %rhs: reg<aie2p.er>) -> (reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>) asm {
  %sum = add.nc %lhs, %rhs
  %carry = ltu %sum, %lhs
  %difference = sub %lhs, %rhs
  %borrow = ltu %lhs, %rhs
  return %sum, %carry, %difference, %borrow
}
