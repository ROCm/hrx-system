// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_scalar_i32.loom-test
// RUN: emit source-low output=low

aie2p.target<core> @target
func.def target(@target) @scalar_i32_uniform_sgpr(%lhs: i32, %rhs: i32, %shift: i32) -> (i32) {
  %add = scalar.addi %lhs, %rhs : i32
  %sub = scalar.subi %add, %rhs : i32
  %product = scalar.muli %sub, %rhs : i32
  %and = scalar.andi %product, %lhs : i32
  %or = scalar.ori %and, %rhs : i32
  %xor = scalar.xori %or, %lhs : i32
  %shl = scalar.shli %xor, %shift : i32
  %ashr = scalar.shrsi %shl, %shift : i32
  %lshr = scalar.shrui %ashr, %shift : i32
  func.return %lshr : i32
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @scalar_i32_uniform_sgpr(%lhs: reg<aie2p.er>, %rhs: reg<aie2p.er>, %shift: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %product = mul %lhs, %rhs
  %and = and %product, %lhs
  %or = or %and, %rhs
  %xor = xor %or, %lhs
  %shl = lshl %xor, %shift
  %22 = mov.short 0
  %23 = sub %22, %shift
  %ashr = ashl %shl, %23
  %26 = sub %22, %shift
  %lshr = lshl %ashr, %26
  return %lshr
}

// ====

aie2p.target<core> @target
func.def target(@target) @scalar_i32_bitfield_sgpr(%word: i32) -> (i32, i32, i32, i32) {
  %unsigned_byte = scalar.bitfield.extractu %word {offset = 8, width = 8} : i32 -> i32
  %signed_byte = scalar.bitfield.extracts %word {offset = 16, width = 8} : i32 -> i32
  %unsigned_nibble = scalar.bitfield.extractu %word {offset = 4, width = 4} : i32 -> i32
  %signed_nibble = scalar.bitfield.extracts %word {offset = 4, width = 4} : i32 -> i32
  func.return %unsigned_byte, %signed_byte, %unsigned_nibble, %signed_nibble : i32, i32, i32, i32
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @scalar_i32_bitfield_sgpr(%word: reg<aie2p.er>) -> (reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>) asm {
  %14 = mov.short 16
  %15 = lshl %word, %14
  %16 = mov.short -24
  %unsigned_byte = lshl %15, %16
  %18 = mov.short 8
  %19 = lshl %word, %18
  %signed_byte = ashl %19, %16
  %22 = mov.short 24
  %23 = lshl %word, %22
  %24 = mov.short -28
  %unsigned_nibble = lshl %23, %24
  %signed_nibble = ashl %23, %24
  return %unsigned_byte, %signed_byte, %unsigned_nibble, %signed_nibble
}

// ====

aie2p.target<core> @target
func.def target(@target) @scalar_i32_compare_scc(%lhs: i32, %rhs: i32) -> (i1) {
  %cmp = scalar.cmpi slt, %lhs, %rhs : i32
  func.return %cmp : i1
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @scalar_i32_compare_scc(%lhs: reg<aie2p.er>, %rhs: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %cmp = lt %lhs, %rhs
  return %cmp
}

// ====

aie2p.target<core> @target
func.def target(@target) @scalar_i1_constants_scc() -> (i1, i1) {
  %true = scalar.constant true : i1
  %false = scalar.constant false : i1
  func.return %true, %false : i1, i1
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @scalar_i1_constants_scc() -> (reg<aie2p.er>, reg<aie2p.er>) asm {
  %true = mov.short 1
  %false = mov.short 0
  return %true, %false
}

// ====

aie2p.target<core> @target
func.def target(@target) @scalar_i1_bitwise_scc(%lhs: i32, %rhs: i32) -> (i1) {
  %inactive_condition = scalar.constant 0 : i32
  %lhs_nonzero = scalar.cmpi ne, %lhs, %inactive_condition : i32
  %rhs_nonzero = scalar.cmpi ne, %rhs, %inactive_condition : i32
  %both_nonzero = scalar.andi %lhs_nonzero, %rhs_nonzero : i1
  %either_nonzero = scalar.ori %lhs_nonzero, %rhs_nonzero : i1
  %one_nonzero = scalar.xori %both_nonzero, %either_nonzero : i1
  func.return %one_nonzero : i1
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @scalar_i1_bitwise_scc(%lhs: reg<aie2p.er>, %rhs: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %lhs_nonzero = nez %lhs
  %rhs_nonzero = nez %rhs
  %both_nonzero = and %lhs_nonzero, %rhs_nonzero
  %either_nonzero = or %lhs_nonzero, %rhs_nonzero
  %one_nonzero = xor %both_nonzero, %either_nonzero
  return %one_nonzero
}
