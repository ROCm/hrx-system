{
  "version": 1,
  "cases": [
    {
      "name": "native allocation reports preserve accepted artifacts",
      "steps": [
        {
          "run": {
            "tool": "loom-compile",
            "args": [
              "{srcdir}/native_allocation_report.loom",
              "--pipeline=none",
              "--root=accepted",
              "--format=xdna",
              "--output={tmp}/without-report.xdna"
            ]
          },
          "files": [
            {
              "path": "{tmp}/without-report.xdna",
              "non_empty": true
            }
          ]
        },
        {
          "run": {
            "tool": "loom-compile",
            "args": [
              "{srcdir}/native_allocation_report.loom",
              "--pipeline=none",
              "--root=accepted",
              "--format=xdna",
              "--output={tmp}/with-report.xdna",
              "--compile-report=text-details",
              "--compile-report-output={tmp}/accepted-report.txt"
            ]
          },
          "files": [
            {
              "path": "{tmp}/with-report.xdna",
              "equals": "{tmp}/without-report.xdna"
            },
            {
              "path": "{tmp}/accepted-report.txt",
              "contains": [
                "COMPILE-REPORT: entry[0] function=accepted_worker "
              ],
              "not_contains": [
                "COMPILE-REPORT: allocation_failure["
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "native spill reports survive worker scratch teardown",
      "steps": [
        {
          "run": {
            "tool": "loom-compile",
            "args": [
              "{srcdir}/native_allocation_report.loom",
              "--pipeline=none",
              "--root=spilled",
              "--format=xdna",
              "--output={tmp}/spilled-without-report.xdna"
            ]
          },
          "files": [
            {
              "path": "{tmp}/spilled-without-report.xdna",
              "non_empty": true
            }
          ]
        },
        {
          "run": {
            "tool": "loom-compile",
            "args": [
              "{srcdir}/native_allocation_report.loom",
              "--pipeline=none",
              "--root=spilled",
              "--format=xdna",
              "--output={tmp}/spilled-with-report.xdna",
              "--compile-report=text-details",
              "--compile-report-output={tmp}/spilled-report.txt"
            ]
          },
          "files": [
            {
              "path": "{tmp}/spilled-with-report.xdna",
              "equals": "{tmp}/spilled-without-report.xdna"
            },
            {
              "path": "{tmp}/spilled-report.txt",
              "contains": {
                "unordered": [
                  "COMPILE-REPORT: entry[0] function=accepted_worker ",
                  "COMPILE-REPORT: entry[1] function=loop_carried_indices ",
                  {
                    "regex": "COMPILE-REPORT: spill\\[[0-9]+\\] kind=materialized function=loop_carried_indices value=\\S+ class=aie2p.edj type=register element=unknown origin=block-argument origin_op=<block-argument> semantic=- assignment=[0-9]+ slot=[0-9]+ space=stack bytes=4 align=4 stores=[1-9][0-9]* store_bytes=[0-9]+ reloads=[1-9][0-9]* reload_bytes=[0-9]+"
                  }
                ]
              },
              "not_contains": [
                "COMPILE-REPORT: allocation_failure["
              ]
            }
          ]
        }
      ]
    }
  ]
}
