{
  "version": 1,
  "cases": [
    {
      "name": "native allocation reports preserve accepted artifacts",
      "steps": [
        {
          "run": {
            "tool": "loom-compile",
            "args": [
              "{srcdir}/native_allocation_report.loom",
              "--pipeline=none",
              "--root=accepted",
              "--format=xdna",
              "--output={tmp}/without-report.xdna"
            ]
          },
          "files": [{"path": "{tmp}/without-report.xdna", "non_empty": true}]
        },
        {
          "run": {
            "tool": "loom-compile",
            "args": [
              "{srcdir}/native_allocation_report.loom",
              "--pipeline=none",
              "--root=accepted",
              "--format=xdna",
              "--output={tmp}/with-report.xdna",
              "--compile-report=text-details",
              "--compile-report-output={tmp}/accepted-report.txt"
            ]
          },
          "files": [
            {"path": "{tmp}/with-report.xdna", "equals": "{tmp}/without-report.xdna"},
            {
              "path": "{tmp}/accepted-report.txt",
              "contains": ["COMPILE-REPORT: entry[0] function=accepted_worker "],
              "not_contains": ["COMPILE-REPORT: allocation_failure["]
            }
          ]
        }
      ]
    },
    {
      "name": "terminal native allocation survives worker scratch teardown",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/native_allocation_report.loom",
          "--pipeline=none",
          "--root=rejected",
          "--format=xdna",
          "--output={tmp}/rejected.xdna",
          "--compile-report=text-details",
          "--compile-report-output={tmp}/rejected-report.txt"
        ]
      },
      "exit": 1,
      "stderr": {
        "contains": {
          "unordered": [
            "BACKEND/005",
            "aie2p.edj",
            "budget 8",
            "peak 9",
            "unspillable-register-exhausted"
          ]
        }
      },
      "files": [
        {"path": "{tmp}/rejected.xdna", "exists": false},
        {
          "path": "{tmp}/rejected-report.txt",
          "contains": {
            "unordered": [
              "COMPILE-REPORT: entry[0] function=accepted_worker ",
              "COMPILE-REPORT: entry[1] function=simultaneous_indices ",
              "COMPILE-REPORT: allocation_failure_rows count=1",
              {
                "regex": "COMPILE-REPORT: allocation_failure\\[0\\] function=simultaneous_indices value=\\S+ class=aie2p.edj code=unspillable-register-exhausted blocking=active-assignment origin=\\S+ block=\\S+ start=[0-9]+ end=[0-9]+ required_units=1 budget_units=8 peak_live_units=9 location=physical_register\\[[0-9]+:1\\] conflict_assignment=[0-9]+ conflict_value=\\S+ conflict_start=[0-9]+ conflict_end=[0-9]+ conflict_location=physical_register\\[[0-9]+:1\\]"
              }
            ]
          }
        }
      ]
    }
  ]
}
