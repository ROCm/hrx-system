// RUN: emit source-low output=low

aie2p.target<core> @target

func.def target(@target) @resident_vector_add() {
  %bytes = index.constant 64 : offset
  %base = index.constant 0 : offset
  %lhs = buffer.alloca<workgroup> align(64) %bytes : buffer
  %rhs = buffer.alloca<workgroup> align(64) %bytes : buffer
  %output = buffer.alloca<workgroup> align(64) %bytes : buffer
  %lhs_view = buffer.view %lhs[%base] : buffer -> view<16xi32>
  %rhs_view = buffer.view %rhs[%base] : buffer -> view<16xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<16xi32>
  %lhs_value = vector.load %lhs_view[0] : view<16xi32> -> vector<16xi32>
  %rhs_value = vector.load %rhs_view[0] : view<16xi32> -> vector<16xi32>
  %sum = vector.addi %lhs_value, %rhs_value : vector<16xi32>
  vector.store %sum, %output_view[0] : vector<16xi32>, view<16xi32>
  func.return
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @resident_vector_add() asm {
  %11 = storage {byte_alignment = 64, byte_length = 64} : low.storage<workgroup>
  %lhs = storage_address %11 : low.storage<workgroup> -> reg<aie2p.ep>
  %13 = storage {byte_alignment = 64, byte_length = 64} : low.storage<workgroup>
  %rhs = storage_address %13 : low.storage<workgroup> -> reg<aie2p.ep>
  %15 = storage {byte_alignment = 64, byte_length = 64} : low.storage<workgroup>
  %output = storage_address %15 : low.storage<workgroup> -> reg<aie2p.ep>
  %lhs_value = vlda.512.i32x16 %lhs, 0
  %rhs_value = vlda.512.i32x16 %rhs, 0
  %sum = vadd.32 %lhs_value, %rhs_value
  vst.512.i32x16 %sum, %output, 0
  return
}

// ====

aie2p.target<core> @target

// Volatile observation keeps a private slot addressable while the range fact
// supplies the allocation's upper bound.
func.def target(@target) @bounded_private_scalar_observation(%byte_length0: offset, %initial: i32) -> (i32) {
  %byte_length = index.assume %byte_length0 [range(%byte_length0, 64, 128)] : offset
  %base = index.constant 0 : offset
  %storage = buffer.alloca<private> align(64) %byte_length : buffer
  %view = buffer.view %storage[%base] : buffer -> view<1xi32>
  view.store<volatile> %initial, %view[0] : i32, view<1xi32>
  %value = view.load<volatile> %view[0] : view<1xi32> -> i32
  func.return %value : i32
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @bounded_private_scalar_observation(%byte_length: reg<aie2p.er>, %initial: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %11 = storage {byte_alignment = 64, byte_length = 128} : low.storage<private>
  %storage = storage_address %11 : low.storage<private> -> reg<aie2p.ep>
  st.volatile<volatile> %initial, %storage, 0
  %value = lda.volatile<volatile> %storage, 0
  return %value
}

// ====

aie2p.target<core> @target

func.def target(@target) @reused_private_arrays(%first: i32, %second: i32) -> (i32) {
  %origin = index.constant 0 : offset
  %extent = index.constant 8 : offset
  %earlier = buffer.alloca<private> align(64) %extent : buffer
  %earlier_view = buffer.view %earlier[%origin] : buffer -> view<2xi32>
  view.store<volatile> %first, %earlier_view[1] : i32, view<2xi32>
  %saved = view.load<volatile> %earlier_view[1] : view<2xi32> -> i32
  %later = buffer.alloca<private> align(16) %extent : buffer
  %later_view = buffer.view %later[%origin] : buffer -> view<2xi32>
  view.store<volatile> %second, %later_view[1] : i32, view<2xi32>
  %loaded = view.load<volatile> %later_view[1] : view<2xi32> -> i32
  %sum = scalar.addi %saved, %loaded : i32
  func.return %sum : i32
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @reused_private_arrays(%first: reg<aie2p.er>, %second: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %15 = storage {byte_alignment = 64, byte_length = 8} : low.storage<private>
  %earlier = storage_address %15 : low.storage<private> -> reg<aie2p.ep>
  st.volatile<volatile> %first, %earlier, 4
  %saved = lda.volatile<volatile> %earlier, 4
  st.volatile<volatile> %second, %earlier, 4
  %loaded = lda.volatile<volatile> %earlier, 4
  %sum = add.nc %saved, %loaded
  return %sum
}
