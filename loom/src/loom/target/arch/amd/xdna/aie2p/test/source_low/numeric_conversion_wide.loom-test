  %5 = slice %input[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %6 = mov.shift 0
  set.saturation 0
  set.ups-mode 0
  %7 = vups.2x.w-to-b.unsigned %5, %6
  %converted = vmov.accumulator512.to.vector512 %7
  return %converted
}

