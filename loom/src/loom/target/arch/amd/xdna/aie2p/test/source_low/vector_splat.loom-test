// RUN: emit source-low target=amd.xdna.aie2p:core output=low

func.def @wide_i8_splat(%value: i8) -> (vector<128xi8>) {
  %result = vector.splat %value : vector<128xi8>
  func.return %result : vector<128xi8>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @wide_i8_splat(%value: reg<aie2p.er>) -> (reg<aie2p.vec256 x4>) asm {
  %5 = vbcst.8 %value
  %result = concat(%5, %5) : (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) -> reg<aie2p.vec256 x4>
  return %result
}

// ====

func.def @shaped_partial_f32_splat(%value: f32) -> (vector<2x15xf32>) {
  %result = vector.splat %value : vector<2x15xf32>
