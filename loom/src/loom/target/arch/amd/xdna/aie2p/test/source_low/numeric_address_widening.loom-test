// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_address_widening.loom-test
// RUN: emit source-low target=amd.xdna.aie2p:core output=low

func.def @widen_address_domains(%coordinate: index, %byte_offset: offset) -> (i64, i64) {
  %signed = index.cast %coordinate : index to i64
  %unsigned = index.cast %byte_offset : offset to i64
  func.return %signed, %unsigned : i64, i64
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @widen_address_domains(%coordinate: reg<aie2p.er>, %byte_offset: reg<aie2p.er>) -> (reg<aie2p.er x2>, reg<aie2p.er x2>) asm {
  %10 = mov.short -31
  %11 = ashl %coordinate, %10
  %signed = concat(%coordinate, %11) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  %13 = mov.short 0
  %unsigned = concat(%byte_offset, %13) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  return %signed, %unsigned
}

// ====

func.def @widen_address_payload(%input: i32) -> (i64, i64) {
  %coordinate = index.cast %input : i32 to index
  %byte_offset = index.cast %input : i32 to offset
  %signed = index.cast %coordinate : index to i64
  %unsigned = index.cast %byte_offset : offset to i64
  func.return %signed, %unsigned : i64, i64
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @widen_address_payload(%byte_offset: reg<aie2p.er>) -> (reg<aie2p.er x2>, reg<aie2p.er x2>) asm {
  %10 = mov.short -31
  %11 = ashl %byte_offset, %10
  %signed = concat(%byte_offset, %11) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  %13 = mov.short 0
  %unsigned = concat(%byte_offset, %13) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  return %signed, %unsigned
}

// ====

func.def @widen_constant_addresses() -> (i64, i64, i64, i64) {
  %high_bit = scalar.constant -2147483648 : i32
  %all_bits = scalar.constant -1 : i32
  %minimum_index = index.cast %high_bit : i32 to index
  %negative_index = index.cast %all_bits : i32 to index
  %high_bit_offset = index.cast %high_bit : i32 to offset
  %maximum_offset = index.cast %all_bits : i32 to offset
  %minimum = index.cast %minimum_index : index to i64
  %negative = index.cast %negative_index : index to i64
  %high = index.cast %high_bit_offset : offset to i64
  %maximum = index.cast %maximum_offset : offset to i64
  func.return %minimum, %negative, %high, %maximum : i64, i64, i64, i64
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @widen_constant_addresses() -> (reg<aie2p.er x2>, reg<aie2p.er x2>, reg<aie2p.er x2>, reg<aie2p.er x2>) asm {
  %22 = mov.i32 -2147483648
  %23 = mov.i32 -1
  %minimum = concat(%22, %23) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  %negative = concat(%23, %23) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  %29 = mov.i32 0
  %high = concat(%22, %29) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  %maximum = concat(%23, %29) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  return %minimum, %negative, %high, %maximum
}

// ====

func.def @widen_varying_address_payload(%values: vector<4xi32>) -> (i64, i64) {
  %input = vector.extract %values[0] : vector<4xi32> -> i32
  %coordinate = index.cast %input : i32 to index
  %byte_offset = index.cast %input : i32 to offset
  %signed = index.cast %coordinate : index to i64
  %unsigned = index.cast %byte_offset : offset to i64
  func.return %signed, %unsigned : i64, i64
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @widen_varying_address_payload(%values: reg<aie2p.vec256 x2>) -> (reg<aie2p.er x2>, reg<aie2p.er x2>) asm {
  %byte_offset = vextract.32.imm %values, 0
  %12 = mov.short -31
  %13 = ashl %byte_offset, %12
  %signed = concat(%byte_offset, %13) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  %15 = mov.short 0
  %unsigned = concat(%byte_offset, %15) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  return %signed, %unsigned
}

// ====

func.def @widen_nonnegative_addresses(%coordinate: index, %byte_offset: offset) -> (i64, i64) {
  %bounded_coordinate = index.assume %coordinate [range(%coordinate, 0, 2147483647)] : index
  %bounded_offset = index.assume %byte_offset [range(%byte_offset, 0, 4294967295)] : offset
  %signed = index.cast %bounded_coordinate : index to i64
  %unsigned = index.cast %bounded_offset : offset to i64
  func.return %signed, %unsigned : i64, i64
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @widen_nonnegative_addresses(%bounded_coordinate: reg<aie2p.er>, %bounded_offset: reg<aie2p.er>) -> (reg<aie2p.er x2>, reg<aie2p.er x2>) asm {
  %12 = mov.short -31
  %13 = ashl %bounded_coordinate, %12
  %signed = concat(%bounded_coordinate, %13) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  %15 = mov.short 0
  %unsigned = concat(%bounded_offset, %15) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  return %signed, %unsigned
}
