// TEMPLATE: loom/src/loom/test/corpus/source_low/numeric_boolean_reduce.loom-test
// RUN: emit source-low target=amd.xdna.aie2p:core output=low

func.def @i1x1_any_all(%values: vector<1xi1>, %init: i1) -> (i1, i1, i1, i1) {
  %false = scalar.constant false : i1
  %true = scalar.constant true : i1
  %any = vector.reduce<ori> %values, %false : vector<1xi1>, i1
  %all = vector.reduce<andi> %values, %true : vector<1xi1>, i1
  %any_with_init = vector.reduce<ori> %values, %init : vector<1xi1>, i1
  %all_with_init = vector.reduce<andi> %values, %init : vector<1xi1>, i1
  func.return %any, %all, %any_with_init, %all_with_init : i1, i1, i1, i1
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i1x1_any_all(%values: reg<aie2p.elpredicate>, %init: reg<aie2p.er>) -> (reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>) asm {
  %18 = mov.short 1
  %19 = predicate.mask.low32 %values, %18
  %any = nez %19
  %all = eq %19, %18
  %any_with_init = or %any, %init
  %all_with_init = and %all, %init
  return %any, %all, %any_with_init, %all_with_init
}

