low.func.def target<amd.xdna.aie2p.core> abi(object_function) @scalar_wide_byte_offset(%byte_offset: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %input = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %output = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %14 = mov.address-index %byte_offset
  %loaded = lda.i32.index %input, %14
  st.i32.index %loaded, %output, %14
  return %loaded
}

