// RUN: emit source-low output=low

// Successive one-word, strided two-word, and grouped arrivals have different
// descriptor geometries but reuse one retired completion semaphore. The final
// pair and word occupy one two-descriptor chain and release that semaphore only
// after both local writes complete.
aie2p.target<array> @device {device_profile = "amd.xdna.strix.17f0_10"}

pipeline.def<kernel> public retain target(@device) @mixed_arrivals() run(%input_arg: buffer, %output_arg: buffer) {
  %input, %output = buffer.assume.alignment %input_arg, %output_arg {minimum_alignment = 4} : buffer, buffer
  %memory = pipeline.memory<workgroup>[0, 3] : pool
  %origin = index.constant 0 : offset
  %next_word = index.constant 4 : offset
  %bytes = index.constant 12 : offset
  %capacity = index.constant 1 : index
  %storage = buffer.alloca<workgroup> pool(%memory) align(4) %bytes : buffer
  %slots = buffer.view %storage[%origin] : buffer -> view<1x3xi32>
  %records = channel.bind<fifo> %slots, %capacity : view<1x3xi32>, index -> channel<tile<3xi32>>
  pipeline.strand workers([0, 3], [1, 1], [1, 1]) {
    %write, %destination = channel.reserve %records : channel<tile<3xi32>> -> (write<tile<3xi32>>, view<3xi32>)
    %first_word = view.subview %destination[0] : view<3xi32> -> view<1xi32>
    %last_pair = view.subview %destination[1] : view<3xi32> -> view<2xi32>
    %initial_input = buffer.view %input[%origin] : buffer -> view<1xi32>
    %initial = kernel.async.copy %initial_input to %first_word {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<1xi32> to view<1xi32> -> kernel.async.token
    %initial_group = kernel.async.group %initial : kernel.async.token -> kernel.async.group
    kernel.async.wait %initial_group {newer_groups = 0} : kernel.async.group
    %saved = view.load %first_word[0] : view<1xi32> -> i32
    %pair_input = buffer.view %input[%origin] : buffer -> view<2xi32>
    %word_input = buffer.view %input[%next_word] : buffer -> view<1xi32>
    %strided_input = buffer.view %input[%origin] : buffer -> view<2xi32, #encoding.layout.strided<strides=[2]>>
    %strided = kernel.async.copy %strided_input to %last_pair {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<2xi32, #encoding.layout.strided<strides=[2]>> to view<2xi32> -> kernel.async.token
    %strided_group = kernel.async.group %strided : kernel.async.token -> kernel.async.group
    kernel.async.wait %strided_group {newer_groups = 0} : kernel.async.group
    %saved_pair = view.load %last_pair[1] : view<2xi32> -> i32
    %pair = kernel.async.copy %pair_input to %last_pair {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<2xi32> to view<2xi32> -> kernel.async.token
    %word = kernel.async.copy %word_input to %first_word {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<1xi32> to view<1xi32> -> kernel.async.token
    %incoming = kernel.async.group %pair, %word : kernel.async.token, kernel.async.token -> kernel.async.group
    kernel.async.wait %incoming {newer_groups = 0} : kernel.async.group
    %value = view.load %first_word[0] : view<1xi32> -> i32
    %partial_sum = scalar.addi %saved, %value : i32
    %sum = scalar.addi %partial_sum, %saved_pair : i32
    view.store %sum, %first_word[0] : i32, view<1xi32>
    channel.publish %write : write<tile<3xi32>>
    %read, %source = channel.acquire %records : channel<tile<3xi32>> -> (read<tile<3xi32>>, view<3xi32>)
    %output_view = buffer.view %output[%origin] : buffer -> view<3xi32>
    %outgoing = kernel.async.copy %source to %output_view {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<3xi32> to view<3xi32> -> kernel.async.token
    %outgoing_group = kernel.async.group %outgoing : kernel.async.token -> kernel.async.group
    kernel.async.wait %outgoing_group {newer_groups = 0} : kernel.async.group
    channel.release %read : read<tile<3xi32>>
  }
}

