aie2p.target<core> @target

func.def public target(@target) @index_integer(%lhs0: index, %rhs0: index, %amount0: index) -> (index) {
  %lhs, %rhs, %amount = index.assume %lhs0, %rhs0, %amount0 [range(%lhs0, 0, 2147483647), range(%rhs0, 1, 1024), range(%amount0, 1, 31)] : index, index, index
  %quotient = index.div %lhs, %rhs : index
  %rotated = index.rotli %quotient, %amount : index
  %trailing_zeros = index.cttzi %rotated : index
  %accumulated = index.madd %trailing_zeros, %rhs, %lhs : index
  %minimum = index.min %accumulated, %lhs : index
  %in_range = index.cmp ult, %minimum, %rhs : index
  %result = scf.select %in_range, %minimum, %rhs : index
  func.return %result : index
}
