// RUN: emit source-low target=amd.xdna.aie2p:core output=low

func.def @prefix16(%lower_input: index, %upper_input: index) -> (vector<16xi1>) {
  %lower = index.assume %lower_input [range(%lower_input, 0, 2147483617)] : index
  %upper = index.assume %upper_input [range(%upper_input, 0, 2147483647)] : index
  %step = index.constant 1 : index
  %result = vector.mask.range [%lower to %upper step %step] : index -> vector<16xi1>
  func.return %result : vector<16xi1>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @prefix16(%lower: reg<aie2p.er>, %upper: reg<aie2p.er>) -> (reg<aie2p.elpredicate>) asm {
  %10 = sub %upper, %lower
  %11 = mov.short 0
  %12 = lt %11, %10
  %13 = copy %12 : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %14 = sel.nez %10, %11, %13
  %15 = mov.i32 16
  %16 = lt %14, %15
  %17 = copy %16 : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %18 = sel.nez %14, %15, %17
  %19 = mov.short 1
  %20 = lshl %19, %18
  %21 = add %20, -1
  %22 = predicate.copy.scalar.to.low32 %21, %21
  %result = predicate.complete.zero.high32 %22, 0
  return %result
}

