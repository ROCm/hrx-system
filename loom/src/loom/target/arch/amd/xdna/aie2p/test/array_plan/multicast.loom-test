low.func.def retain target<amd.xdna.aie2p.core>(@multicast_core_target) @multicast_array$worker$0() asm {
  %acquire_delta = mov.short -1
  %release_delta = mov.short 1
  %37 = mov.local-address 458752
  %38 = mov.local-address 475136
  low.br ^_bb1(%37: reg<aie2p.ep>, %38: reg<aie2p.ep>)
^_bb1(%input0: reg<aie2p.ep>, %input1: reg<aie2p.ep>):
  acq %acquire_delta, 49
  acq %acquire_delta, 51
  low.br ^_bb2
^_bb2:
  %lhs = lda.u8 %input0, 0
  %rhs = lda.u8 %input1, 0
  %sum = add.rr %lhs, %rhs
  st.s8 %sum, %input0, 0
  low.br ^_bb3
^_bb3:
  rel %release_delta, 48
  rel %release_delta, 50
  low.br ^_bb1(%input0: reg<aie2p.ep>, %input1: reg<aie2p.ep>)
}

