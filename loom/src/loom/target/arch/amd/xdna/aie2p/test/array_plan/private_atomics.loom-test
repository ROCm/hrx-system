// RUN: emit aie2p-array-plan @private_atomic_array

// Shared corpus programs own atomic result semantics. This target test checks
// that private provenance and the shared rewrites survive the AIE2P array ABI,
// resident materialization, and final machine lowering.
aie2p.target<array> @array_target

aie2p.target<core> @core_target

func.def target(@core_target) @private_atomic_worker(%input_arg: buffer, %output_arg: buffer) {
  %input, %output = buffer.assume.alignment %input_arg, %output_arg {minimum_alignment = 8} : buffer, buffer
  %origin = index.constant 0 : offset
  %private_bytes = index.constant 24 : offset
  %storage = buffer.alloca<private> align(8) %private_bytes : buffer

  %cell_i64 = buffer.view %storage[%origin] : buffer -> view<1xi64>
  %input_i64 = buffer.view %input[%origin] : buffer -> view<3xi64>
  %output_i64 = buffer.view %output[%origin] : buffer -> view<4xi64>
  %initial_i64 = view.load %input_i64[0] : view<3xi64> -> i64
  %update_i64 = view.load %input_i64[1] : view<3xi64> -> i64
  %expected_i64 = view.load %input_i64[2] : view<3xi64> -> i64
  view.atomic.store %initial_i64, %cell_i64[0] {ordering = release, scope = system} : i64, view<1xi64>
  %old_i64 = view.atomic.rmw<addi> %update_i64, %cell_i64[0] {ordering = acq_rel, scope = system} : i64, view<1xi64> -> i64
  %compared_i64 = view.atomic.cmpxchg %expected_i64, %update_i64, %cell_i64[0] {failure_ordering = acquire, scope = system, success_ordering = seq_cst} : i64, view<1xi64> -> i64
  view.atomic.reduce<xori> %update_i64, %cell_i64[0] {ordering = seq_cst, scope = system} : i64, view<1xi64>
  %final_i64 = view.atomic.load %cell_i64[0] {ordering = acquire, scope = system} : view<1xi64> -> i64
  view.store %old_i64, %output_i64[0] : i64, view<4xi64>
  view.store %compared_i64, %output_i64[1] : i64, view<4xi64>
  view.store %final_i64, %output_i64[2] : i64, view<4xi64>
  view.store %update_i64, %output_i64[3] : i64, view<4xi64>

  %vector_offset = index.constant 8 : offset
  %input_vector_offset = index.constant 24 : offset
  %output_vector_offset = index.constant 32 : offset
  %cells_i32 = buffer.view %storage[%vector_offset] : buffer -> view<2xi32>
  %input_i32 = buffer.view %input[%input_vector_offset] : buffer -> view<2xi32>
  %output_i32 = buffer.view %output[%output_vector_offset] : buffer -> view<8xi32>
  %initial_i32 = vector.load %input_i32[0] : view<2xi32> -> vector<2xi32>
  vector.store %initial_i32, %cells_i32[0] : vector<2xi32>, view<2xi32>
  %first = index.constant 0 : index
  %step = index.constant 1 : index
  %offsets = vector.iota %first step %step : vector<2xindex>
  %enabled = scalar.constant true : i1
  %disabled = scalar.constant false : i1
  %mask = vector.from_elements %enabled, %disabled : vector<2xi1>
  %increment_i32 = vector.constant 1 : vector<2xi32>
  %passthrough_i32 = vector.constant -101 : vector<2xi32>
  vector.atomic.reduce<addi> %increment_i32, %cells_i32[0][%offsets] {ordering = release, scope = system} : vector<2xi32>, view<2xi32>, vector<2xindex>
  vector.atomic.reduce.mask<xori> %increment_i32, %cells_i32[0][%offsets], %mask {ordering = relaxed, scope = thread} : vector<2xi32>, view<2xi32>, vector<2xindex>, vector<2xi1>
  %old_i32 = vector.atomic.rmw<subi> %increment_i32, %cells_i32[0][%offsets] {ordering = acquire, scope = device} : vector<2xi32>, view<2xi32>, vector<2xindex>
  %masked_i32 = vector.atomic.rmw.mask<addi> %increment_i32, %cells_i32[0][%offsets], %mask, %passthrough_i32 {ordering = acq_rel, scope = system} : vector<2xi32>, view<2xi32>, vector<2xindex>, vector<2xi1>, vector<2xi32>
  %observed_i32 = vector.atomic.cmpxchg %old_i32, %increment_i32, %cells_i32[0][%offsets] {failure_ordering = acquire, scope = system, success_ordering = acq_rel} : vector<2xi32>, view<2xi32>, vector<2xindex> -> vector<2xi32>
  %duplicate_offsets = vector.from_elements %first, %first : vector<2xindex>
  vector.atomic.reduce<addi> %increment_i32, %cells_i32[0][%duplicate_offsets] {ordering = seq_cst, scope = system} : vector<2xi32>, view<2xi32>, vector<2xindex>
  %final_i32 = vector.load %cells_i32[0] : view<2xi32> -> vector<2xi32>
  vector.store %old_i32, %output_i32[0] : vector<2xi32>, view<8xi32>
  vector.store %masked_i32, %output_i32[2] : vector<2xi32>, view<8xi32>
  vector.store %observed_i32, %output_i32[4] : vector<2xi32>, view<8xi32>
  vector.store %final_i32, %output_i32[6] : vector<2xi32>, view<8xi32>

  %f32_offset = index.constant 16 : offset
  %input_f32_offset = index.constant 32 : offset
  %output_f32_offset = index.constant 64 : offset
  %cell_f32 = buffer.view %storage[%f32_offset] : buffer -> view<1xf32>
  %input_f32 = buffer.view %input[%input_f32_offset] : buffer -> view<2xf32>
  %output_f32 = buffer.view %output[%output_f32_offset] : buffer -> view<2xf32>
  %initial_f32 = view.load %input_f32[0] : view<2xf32> -> f32
  %increment_f32 = view.load %input_f32[1] : view<2xf32> -> f32
  view.atomic.store %initial_f32, %cell_f32[0] {ordering = release, scope = system} : f32, view<1xf32>
  %old_f32 = view.atomic.rmw<addf> %increment_f32, %cell_f32[0] {ordering = acq_rel, scope = system} : f32, view<1xf32> -> f32
  %final_f32 = view.atomic.load %cell_f32[0] {ordering = acquire, scope = system} : view<1xf32> -> f32
  view.store %old_f32, %output_f32[0] : f32, view<2xf32>
  view.store %final_f32, %output_f32[1] : f32, view<2xf32>
  func.return
}

pipeline.def<kernel> public retain target(@array_target) @private_atomic_array() launch(%input: buffer, %output: buffer) {
  %worker_count = index.constant 1 : index
  %origin = index.constant 0 : offset
  %workers = group.create %worker_count : index -> group
  %input_view = buffer.view %input[%origin] : buffer -> view<1x1x40xi8>
  %output_view = buffer.view %output[%origin] : buffer -> view<1x1x72xi8>
  %input_flow = pipeline.scatter %input_view across %workers : view<1x1x40xi8>, group -> pipeline.flow<tile<40xi8>>
  %output_flow = pipeline.stage @private_atomic_worker on %workers(%input_flow) : (group, pipeline.flow<tile<40xi8>>) -> (pipeline.flow<tile<72xi8>>)
  pipeline.write %output_flow to %output_view : pipeline.flow<tile<72xi8>>, view<1x1x72xi8>
  pipeline.return
}

