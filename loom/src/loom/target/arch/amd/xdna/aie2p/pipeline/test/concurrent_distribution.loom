// A runtime choice selects a finite DMA-only child alongside its parent's
// compute strand. The parent starts the selected child before filling SRAM,
// consumes every replay, and retires that child before the next phase visit.
// Retiring at the nested serial exit before running the parent would deadlock.
aie2p.target<array> @device

func.def inline @replay(%retained: channel<tile<1xi32>>, %local: channel<tile<1xi32>>, %count: index) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %read, %payload = channel.acquire %retained : channel<tile<1xi32>> -> (read<tile<1xi32>>, view<1xi32>)
  %last = scf.for %iteration = [%begin to %count step %step](%current = %read : read<tile<1xi32>>) -> (read<tile<1xi32>>) {
    %copy, %keep = channel.fanout %current : read<tile<1xi32>> -> (read<tile<1xi32>>, read<tile<1xi32>>)
    %write, %destination = channel.reserve %local : channel<tile<1xi32>> -> (write<tile<1xi32>>, view<1xi32>)
    channel.copy %copy -> %write : read<tile<1xi32>>, write<tile<1xi32>>
    scf.yield %keep : read<tile<1xi32>>
  }
  channel.release %last : read<tile<1xi32>>
  func.return
}

pipeline.def @replay_two() run(%retained: channel<tile<1xi32>>, %local: channel<tile<1xi32>>) {
  %count = index.constant 2 : index
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    func.call @replay(%retained, %local, %count) : (channel<tile<1xi32>>, channel<tile<1xi32>>, index)
  }
}

pipeline.def @replay_three() run(%retained: channel<tile<1xi32>>, %local: channel<tile<1xi32>>) {
  %count = index.constant 3 : index
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    func.call @replay(%retained, %local, %count) : (channel<tile<1xi32>>, channel<tile<1xi32>>, index)
  }
}

pipeline.def @transfer_phase() run(%retained: channel<tile<1xi32>>, %local: channel<tile<1xi32>>, %input: buffer, %output: buffer, %phase: index) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %short_count = index.constant 2 : index
  %long_count = index.constant 3 : index
  %stride = index.constant 4 : offset
  %output_stride = index.constant 12 : offset
  %long_phase = index.cmp eq, %phase, %step : index
  pipeline.serial {
    scf.if %long_phase {
      pipeline.compose @replay_three(%retained, %local) : (channel<tile<1xi32>>, channel<tile<1xi32>>)
    } else {
      pipeline.compose @replay_two(%retained, %local) : (channel<tile<1xi32>>, channel<tile<1xi32>>)
    }
  }
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %input_offset = index.scale %phase, %stride : index, offset -> offset
    %output_offset = index.scale %phase, %output_stride : index, offset -> offset
    %external = buffer.view %input[%input_offset] : buffer -> view<1xi32>
    %write, %payload = channel.reserve %retained : channel<tile<1xi32>> -> (write<tile<1xi32>>, view<1xi32>)
    %copy = kernel.async.copy %external to %payload {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<1xi32> to view<1xi32> -> kernel.async.token
    %arrival = kernel.async.group %copy : kernel.async.token -> kernel.async.group
    kernel.async.wait %arrival {newer_groups = 0} : kernel.async.group
    channel.publish %write : write<tile<1xi32>>
    %count = scf.select %long_phase, %long_count, %short_count : index
    scf.for %record = [%begin to %count step %step] {
      %read, %value = channel.acquire %local : channel<tile<1xi32>> -> (read<tile<1xi32>>, view<1xi32>)
      %relative = index.scale %record, %stride : index, offset -> offset
      %offset = index.add %output_offset, %relative : offset
      %destination = buffer.view %output[%offset] : buffer -> view<1xi32>
      %outgoing = kernel.async.copy %value to %destination {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<1xi32> to view<1xi32> -> kernel.async.token
      %departure = kernel.async.group %outgoing : kernel.async.token -> kernel.async.group
      kernel.async.wait %departure {newer_groups = 0} : kernel.async.group
      channel.release %read : read<tile<1xi32>>
    }
  }
}

pipeline.def<kernel> public retain target(@device) @selected_replay() run(%input_arg: buffer, %output_arg: buffer) {
  %input, %output = buffer.assume.alignment %input_arg, %output_arg {minimum_alignment = 4} : buffer, buffer
  %origin = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %begin = index.constant 0 : index
  %capacity = index.constant 1 : index
  %count = index.constant 3 : index
  %sram = pipeline.memory<workgroup>[0, 1] : pool
  %memory = pipeline.memory<workgroup>[0, 2] : pool
  %retained_storage = buffer.alloca<workgroup> pool(%sram) align(4) %bytes : buffer
  %retained_slots = buffer.view %retained_storage[%origin] : buffer -> view<1x1xi32>
  %retained = channel.bind<fifo> %retained_slots, %capacity : view<1x1xi32>, index -> channel<tile<1xi32>>
  %local_storage = buffer.alloca<workgroup> pool(%memory) align(4) %bytes : buffer
  %local_slots = buffer.view %local_storage[%origin] : buffer -> view<1x1xi32>
  %local = channel.bind<fifo> %local_slots, %capacity : view<1x1xi32>, index -> channel<tile<1xi32>>
  pipeline.serial {
    scf.for %phase = [%begin to %count step %capacity] {
      pipeline.compose @transfer_phase(%retained, %local, %input, %output, %phase) : (channel<tile<1xi32>>, channel<tile<1xi32>>, buffer, buffer, index)
    }
  }
}

// The scalar oracle only replicates logical records. Padding stays untouched.
func.def @reference(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %short_count = index.constant 2 : index
  %long_count = index.constant 3 : index
  %source = buffer.view %input[%origin] : buffer -> view<3xi32>
  %destination = buffer.view %output[%origin] : buffer -> view<3x3xi32>
  scf.for %phase = [%begin to %long_count step %step] {
    %value = view.load %source[%phase] : view<3xi32> -> i32
    %long_phase = index.cmp eq, %phase, %step : index
    %count = scf.select %long_phase, %long_count, %short_count : index
    scf.for %record = [%begin to %count step %step] {
      view.store %value, %destination[%phase, %record] : i32, view<3x3xi32>
    }
  }
  func.return
}

check.scenario public @selected_dma_replay {
  check.trial[3](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input_storage = check.generate.random.uniform seed(%seed) range(-1000000 to 1000000) : tensor<35xi32>
    %input = check.tensor.view %input_storage offset(64) : tensor<35xi32> -> tensor<3xi32>
    %output_storage = check.generate.fill value(-9999) : tensor<41xi32>
    %output = check.tensor.view %output_storage offset(64) : tensor<41xi32> -> tensor<9xi32>
    check.compare<@selected_replay, @reference>(%input, %output) : (tensor<3xi32>, tensor<9xi32>) -> () {
      check.expect.equal actual(%input_storage) expected(%input_storage) : tensor<35xi32>
      check.expect.equal actual(%output_storage) expected(%output_storage) : tensor<41xi32>
    }
  }
  check.return
}
