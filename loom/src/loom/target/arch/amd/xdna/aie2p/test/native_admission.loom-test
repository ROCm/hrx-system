aie2p.target<array> @device {device_profile = "amd.xdna.strix.17f0_10"}

pipeline.def<kernel> public retain target(@device) @east_channel_storage() run() {
  %memory = pipeline.memory<workgroup>[1, 2] : pool
  %bytes = index.constant 64 : offset
  %origin = index.constant 0 : offset
  %capacity = index.constant 1 : index
  %storage = buffer.alloca<workgroup> pool(%memory) align(64) %bytes : buffer
  %slots = buffer.view %storage[%origin] : buffer -> view<1x16xi32>
  %channel = channel.bind<fifo> %slots, %capacity : view<1x16xi32>, index -> channel<tile<16xi32>>
  // ERROR@+1: XDNA/051 {requirement="channel storage directly visible from its consuming core"}
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %write, %payload = channel.reserve %channel : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
    %values = vector.constant 42 : vector<16xi32>
