aie2p.target<core> @target

func.def public target(@target) @vector_structure(%bytes: vector<64xi8>, %halves: vector<32xi16>, %words: vector<16xi32>, %byte_singleton: vector<1xi8>, %half_singleton: vector<1xi16>, %word_singleton: vector<1xi32>, %lane: index) -> (vector<64xi8>, vector<32xi16>, vector<16xi32>) {
  %byte_constant = scalar.constant -73 : i8
  %half_constant = scalar.constant -20000 : i16
  %word_constant = scalar.constant -2004318072 : i32

  %byte_uniform = vector.constant -17 : vector<64xi8>
  %half_uniform = vector.constant -20000 : vector<32xi16>
  %word_uniform = vector.constant -2004318072 : vector<16xi32>

  %byte_broadcast = vector.broadcast %byte_singleton : vector<1xi8> -> vector<64xi8>
  %half_broadcast = vector.broadcast %half_singleton : vector<1xi16> -> vector<32xi16>
  %word_broadcast = vector.broadcast %word_singleton : vector<1xi32> -> vector<16xi32>
  %byte_seed = vector.ori %byte_uniform, %byte_broadcast : vector<64xi8>
  %half_seed = vector.ori %half_uniform, %half_broadcast : vector<32xi16>
  %word_seed = vector.ori %word_uniform, %word_broadcast : vector<16xi32>

  %byte_static = vector.extract %bytes[17] : vector<64xi8> -> i8
  %half_static = vector.extract %halves[13] : vector<32xi16> -> i16
  %word_static = vector.extract %words[7] : vector<16xi32> -> i32
  %byte_dynamic = vector.extract %bytes[%lane] : vector<64xi8> -> i8
  %half_dynamic = vector.extract %halves[%lane] : vector<32xi16> -> i16
  %word_dynamic = vector.extract %words[%lane] : vector<16xi32> -> i32

  %byte_zero = vector.insert %byte_constant into %byte_seed[0] : i8, vector<64xi8>
  %half_zero = vector.insert %half_constant into %half_seed[0] : i16, vector<32xi16>
  %word_zero = vector.insert %word_constant into %word_seed[0] : i32, vector<16xi32>
  %byte_static_insert = vector.insert %byte_static into %byte_zero[17] : i8, vector<64xi8>
  %half_static_insert = vector.insert %half_static into %half_zero[13] : i16, vector<32xi16>
  %word_static_insert = vector.insert %word_static into %word_zero[7] : i32, vector<16xi32>
  %byte_result = vector.insert %byte_dynamic into %byte_static_insert[%lane] : i8, vector<64xi8>
  %half_result = vector.insert %half_dynamic into %half_static_insert[%lane] : i16, vector<32xi16>
  %word_result = vector.insert %word_dynamic into %word_static_insert[%lane] : i32, vector<16xi32>
  func.return %byte_result, %half_result, %word_result : vector<64xi8>, vector<32xi16>, vector<16xi32>
}
