// RUN: pass target=amd.xdna.aie2p:amd.xdna.strix.17f0_10 aie2p-realize-kernel

// All concrete source spaces translate to the staged storage space. Original
// private-versus-external disjointness permits snapshot transfers despite the
// interleaved reads and writes. Generic storage has an explicit noalias contract.
// The nested constant refinement translates, while local private storage keeps
// its refinement because its root is not replaced.
kernel.def @memory_spaces() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%external: buffer, %shared: buffer, %output: buffer, %immutable: buffer, %host: buffer, %descriptor: buffer, %generic: buffer) {
  %output_unique, %generic_unique = buffer.assume.noalias %output, %generic : buffer, buffer
  %global_buffer = buffer.assume.memory_space<global> %external : buffer
  %workgroup_buffer = buffer.assume.memory_space<workgroup> %shared : buffer
  %private_buffer = buffer.assume.memory_space<private> %output_unique : buffer
  %host_buffer = buffer.assume.memory_space<host> %host : buffer
  %descriptor_buffer = buffer.assume.memory_space<descriptor> %descriptor : buffer
  %generic_buffer = buffer.assume.memory_space<generic> %generic_unique : buffer
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 1 : index
  %step = index.constant 1 : index
  %bytes = index.constant 4 : offset
  %scratch = buffer.alloca<private> align(4) %bytes : buffer
  %local_private = buffer.assume.memory_space<private> %scratch : buffer
  %local_view = buffer.view %local_private[%origin] : buffer -> view<1xi32>
  %global_view = buffer.view %global_buffer[%origin] : buffer -> view<1xi32>
  %workgroup_view = buffer.view %workgroup_buffer[%origin] : buffer -> view<1xi32>
  %private_view = buffer.view %private_buffer[%origin] : buffer -> view<1xi32>
  %host_view = buffer.view %host_buffer[%origin] : buffer -> view<1xi32>
  %descriptor_view = buffer.view %descriptor_buffer[%origin] : buffer -> view<1xi32>
  %generic_view = buffer.view %generic_buffer[%origin] : buffer -> view<1xi32>
  %global_value = view.load %global_view[0] : view<1xi32> -> i32
  view.store %global_value, %private_view[0] : i32, view<1xi32>
  %workgroup_value = view.load %workgroup_view[0] : view<1xi32> -> i32
  view.store %workgroup_value, %private_view[0] : i32, view<1xi32>
  %host_value = view.load %host_view[0] : view<1xi32> -> i32
  view.store %host_value, %private_view[0] : i32, view<1xi32>
  %descriptor_value = view.load %descriptor_view[0] : view<1xi32> -> i32
  view.store %descriptor_value, %private_view[0] : i32, view<1xi32>
  %generic_value = view.load %generic_view[0] : view<1xi32> -> i32
  view.store %generic_value, %local_view[0] : i32, view<1xi32>
  %local_value = view.load %local_view[0] : view<1xi32> -> i32
  view.store %local_value, %private_view[0] : i32, view<1xi32>
  scf.for %ordinal = [%begin to %end step %step] {
    %constant_buffer = buffer.assume.memory_space<constant> %immutable : buffer
    %constant_view = buffer.view %constant_buffer[%origin] : buffer -> view<1xi32>
    %constant_value = view.load %constant_view[0] : view<1xi32> -> i32
    view.store %constant_value, %private_view[0] : i32, view<1xi32>
  }
  kernel.return
}

