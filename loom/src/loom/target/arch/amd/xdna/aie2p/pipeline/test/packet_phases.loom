// A broadcast, selective replay, and repeated broadcast share one DMA path.
// The middle phase introduces new classes and reverses first-use receiver order.
// Both receivers occupy a different column from the SRAM or compute source.
aie2p.target<array> @device

func.def inline @send(%read: read<tile<16xi32>>, %destination: channel<tile<16xi32>>) -> (read<tile<16xi32>>) {
  %keep, %copy = channel.fanout %read : read<tile<16xi32>> -> (read<tile<16xi32>>, read<tile<16xi32>>)
  %write, %payload = channel.reserve %destination : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
  channel.copy %copy -> %write : read<tile<16xi32>>, write<tile<16xi32>>
  func.return %keep : read<tile<16xi32>>
}

func.def inline @broadcast(%read: read<tile<16xi32>>, %left: channel<tile<16xi32>>, %right: channel<tile<16xi32>>) -> (read<tile<16xi32>>) {
  %keep, %a, %b = channel.fanout %read : read<tile<16xi32>> -> (read<tile<16xi32>>, read<tile<16xi32>>, read<tile<16xi32>>)
  %write_a, %payload_a = channel.reserve %left : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
  channel.copy %a -> %write_a : read<tile<16xi32>>, write<tile<16xi32>>
  %write_b, %payload_b = channel.reserve %right : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
  channel.copy %b -> %write_b : read<tile<16xi32>>, write<tile<16xi32>>
  func.return %keep : read<tile<16xi32>>
}

func.def inline @drain(%source: channel<tile<16xi32>>, %output: buffer, %count: index) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %bytes = index.constant 64 : offset
  scf.for %i = [%c0 to %count step %c1] {
    %read, %payload = channel.acquire %source : channel<tile<16xi32>> -> (read<tile<16xi32>>, view<16xi32>)
    %offset = index.scale %i, %bytes : index, offset -> offset
    %external = buffer.view %output[%offset] : buffer -> view<16xi32>
    %copy = kernel.async.copy %payload to %external {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<16xi32> to view<16xi32> -> kernel.async.token
    %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
    kernel.async.wait %group {newer_groups = 0} : kernel.async.group
    channel.release %read : read<tile<16xi32>>
  }
  func.return
}

func.def inline @broadcast_pair(%source: channel<tile<16xi32>>, %left: channel<tile<16xi32>>, %right: channel<tile<16xi32>>) {
  %a, %payload_a = channel.acquire %source : channel<tile<16xi32>> -> (read<tile<16xi32>>, view<16xi32>)
  %b, %payload_b = channel.acquire %source : channel<tile<16xi32>> -> (read<tile<16xi32>>, view<16xi32>)
  %keep_a = func.call @broadcast(%a, %left, %right) : (read<tile<16xi32>>, channel<tile<16xi32>>, channel<tile<16xi32>>) -> (read<tile<16xi32>>)
  %keep_b = func.call @broadcast(%b, %left, %right) : (read<tile<16xi32>>, channel<tile<16xi32>>, channel<tile<16xi32>>) -> (read<tile<16xi32>>)
  channel.release %keep_a : read<tile<16xi32>>
  channel.release %keep_b : read<tile<16xi32>>
  func.return
}

pipeline.def<kernel> @phases(%source_row: index) run(%input_arg: buffer, %left_arg: buffer, %right_arg: buffer) {
  %input_unique, %left_unique, %right_unique = buffer.assume.noalias %input_arg, %left_arg, %right_arg : buffer, buffer, buffer
  %input, %left_output, %right_output = buffer.assume.alignment %input_unique, %left_unique, %right_unique {minimum_alignment = 64} : buffer, buffer, buffer
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c6 = index.constant 6 : index
  %c7 = index.constant 7 : index
  %origin = index.constant 0 : offset
  %bytes = index.constant 64 : offset
  %batch_bytes = index.constant 128 : offset
  %memory = pipeline.memory<workgroup>[0, %source_row] : pool
  %storage = buffer.alloca<workgroup> pool(%memory) align(64) %batch_bytes : buffer
  %slots = buffer.view %storage[%origin] : buffer -> view<2x16xi32>
  %source = channel.bind<fifo> %slots, %c2 : view<2x16xi32>, index -> channel<tile<16xi32>>
  %left_memory = pipeline.memory<workgroup>[1, 2] : pool
  %left_storage = buffer.alloca<workgroup> pool(%left_memory) align(64) %bytes : buffer
  %left_slots = buffer.view %left_storage[%origin] : buffer -> view<1x16xi32>
  %left = channel.bind<fifo> %left_slots, %c1 : view<1x16xi32>, index -> channel<tile<16xi32>>
  %right_memory = pipeline.memory<workgroup>[1, 3] : pool
  %right_storage = buffer.alloca<workgroup> pool(%right_memory) align(64) %bytes : buffer
  %right_slots = buffer.view %right_storage[%origin] : buffer -> view<1x16xi32>
  %right = channel.bind<fifo> %right_slots, %c1 : view<1x16xi32>, index -> channel<tile<16xi32>>
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    scf.for %i = [%c0 to %c6 step %c1] unroll {
      %offset = index.scale %i, %bytes : index, offset -> offset
      %external = buffer.view %input[%offset] : buffer -> view<16xi32>
      %write, %payload = channel.reserve %source : channel<tile<16xi32>> -> (write<tile<16xi32>>, view<16xi32>)
      %copy = kernel.async.copy %external to %payload {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<16xi32> to view<16xi32> -> kernel.async.token
      %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
      kernel.async.wait %group {newer_groups = 0} : kernel.async.group
      channel.publish %write : write<tile<16xi32>>
    }
  }
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    func.call @broadcast_pair(%source, %left, %right) : (channel<tile<16xi32>>, channel<tile<16xi32>>, channel<tile<16xi32>>)
    %a, %payload_a = channel.acquire %source : channel<tile<16xi32>> -> (read<tile<16xi32>>, view<16xi32>)
    %b, %payload_b = channel.acquire %source : channel<tile<16xi32>> -> (read<tile<16xi32>>, view<16xi32>)
    %keep_a = func.call @send(%a, %right) : (read<tile<16xi32>>, channel<tile<16xi32>>) -> (read<tile<16xi32>>)
    %keep_b = func.call @send(%b, %left) : (read<tile<16xi32>>, channel<tile<16xi32>>) -> (read<tile<16xi32>>)
    %last_a = func.call @broadcast(%keep_a, %right, %left) : (read<tile<16xi32>>, channel<tile<16xi32>>, channel<tile<16xi32>>) -> (read<tile<16xi32>>)
    %last_b = func.call @broadcast(%keep_b, %right, %left) : (read<tile<16xi32>>, channel<tile<16xi32>>, channel<tile<16xi32>>) -> (read<tile<16xi32>>)
    channel.release %last_a : read<tile<16xi32>>
    channel.release %last_b : read<tile<16xi32>>
    func.call @broadcast_pair(%source, %left, %right) : (channel<tile<16xi32>>, channel<tile<16xi32>>, channel<tile<16xi32>>)
  }
  pipeline.strand workers([1, 2], [1, 1], [1, 1]) {
    func.call @drain(%left, %left_output, %c7) : (channel<tile<16xi32>>, buffer, index)
  }
  pipeline.strand workers([1, 3], [1, 1], [1, 1]) {
    func.call @drain(%right, %right_output, %c7) : (channel<tile<16xi32>>, buffer, index)
  }
}

// Directly select the logical records: left [0, 1, 3, 2, 3, 4, 5],
// right [0, 1, 2, 2, 3, 4, 5]. Guards and input bits remain unchanged.
func.def @reference(%input: buffer, %left: buffer, %right: buffer) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c7 = index.constant 7 : index
  %words = index.constant 16 : index
  %origin = index.constant 0 : offset
  %source = buffer.view %input[%origin] : buffer -> view<6x16xi32>
  %a = buffer.view %left[%origin] : buffer -> view<7x16xi32>
  %b = buffer.view %right[%origin] : buffer -> view<7x16xi32>
  scf.for %result = [%c0 to %c7 step %c1] {
    %middle = index.cmp eq, %result, %c2 : index
    %later = index.cmp uge, %result, %c3 : index
    %shifted = index.sub %result, %c1 : index
    %right_record = scf.select %later, %shifted, %result : index
    %left_record = scf.select %middle, %c3, %right_record : index
    scf.for %word = [%c0 to %words step %c1] {
      %x = view.load %source[%left_record, %word] : view<6x16xi32> -> i32
      %y = view.load %source[%right_record, %word] : view<6x16xi32> -> i32
      view.store %x, %a[%result, %word] : i32, view<7x16xi32>
      view.store %y, %b[%result, %word] : i32, view<7x16xi32>
    }
  }
  func.return
}

pipeline.def<kernel> public retain target(@device) @packet_phases_sram() run(%input: buffer, %left: buffer, %right: buffer) {
  %row = index.constant 1 : index
  pipeline.compose @phases[%row](%input, %left, %right) : [index](buffer, buffer, buffer)
}

check.scenario public @sram_packet_phases {
  check.trial[3](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input_storage = check.generate.random.uniform seed(%seed) range(-1000000 to 1000000) : tensor<128xi32>
    %input = check.tensor.view %input_storage offset(64) : tensor<128xi32> -> tensor<96xi32>
    %left_storage = check.generate.fill value(-9999) : tensor<144xi32>
    %left = check.tensor.view %left_storage offset(64) : tensor<144xi32> -> tensor<112xi32>
    %right_storage = check.generate.fill value(1234567) : tensor<144xi32>
    %right = check.tensor.view %right_storage offset(64) : tensor<144xi32> -> tensor<112xi32>
    check.compare<@packet_phases_sram, @reference>(%input, %left, %right) : (tensor<96xi32>, tensor<112xi32>, tensor<112xi32>) -> () {
      check.expect.equal actual(%input_storage) expected(%input_storage) : tensor<128xi32>
      check.expect.equal actual(%left_storage) expected(%left_storage) : tensor<144xi32>
      check.expect.equal actual(%right_storage) expected(%right_storage) : tensor<144xi32>
    }
  }
  check.return
}

pipeline.def<kernel> public retain target(@device) @packet_phases_compute() run(%input: buffer, %left: buffer, %right: buffer) {
  %row = index.constant 2 : index
  pipeline.compose @phases[%row](%input, %left, %right) : [index](buffer, buffer, buffer)
}

check.scenario public @compute_packet_phases {
  check.trial[3](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input_storage = check.generate.random.uniform seed(%seed) range(-1000000 to 1000000) : tensor<128xi32>
    %input = check.tensor.view %input_storage offset(64) : tensor<128xi32> -> tensor<96xi32>
    %left_storage = check.generate.fill value(-9999) : tensor<144xi32>
    %left = check.tensor.view %left_storage offset(64) : tensor<144xi32> -> tensor<112xi32>
    %right_storage = check.generate.fill value(1234567) : tensor<144xi32>
    %right = check.tensor.view %right_storage offset(64) : tensor<144xi32> -> tensor<112xi32>
    check.compare<@packet_phases_compute, @reference>(%input, %left, %right) : (tensor<96xi32>, tensor<112xi32>, tensor<112xi32>) -> () {
      check.expect.equal actual(%input_storage) expected(%input_storage) : tensor<128xi32>
      check.expect.equal actual(%left_storage) expected(%left_storage) : tensor<144xi32>
      check.expect.equal actual(%right_storage) expected(%right_storage) : tensor<144xi32>
    }
  }
  check.return
}
