func.def @f32x2x2_from_elements(%e0: f32, %e1: f32, %e2: f32, %e3: f32) -> (vector<2x2xf32>) {
  %result = vector.from_elements %e0, %e1, %e2, %e3 : vector<2x2xf32>
  func.return %result : vector<2x2xf32>
}

// ----
CHECK: return %result

// ====

func.def @f32x2x4_transpose(%values: vector<2x4xf32>) -> (vector<4x2xf32>) {
  %result = vector.transpose<[1, 0]> %values : vector<2x4xf32> -> vector<4x2xf32>
  func.return %result : vector<4x2xf32>
}

// ----
CHECK: return %result

// ====

func.def @f32x2x2x2_extract_static(%values: vector<2x2x2xf32>) -> (f32) {
  %result = vector.extract %values[1, 0, 1] : vector<2x2x2xf32> -> f32
  func.return %result : f32
}

// ----
CHECK: %result = vextract.32.imm %values, 5
CHECK: return %result

// ====

func.def @f32x2x2x2_from_elements(%e0: f32, %e1: f32, %e2: f32, %e3: f32, %e4: f32, %e5: f32, %e6: f32, %e7: f32) -> (vector<2x2x2xf32>) {
  %result = vector.from_elements %e0, %e1, %e2, %e3, %e4, %e5, %e6, %e7 : vector<2x2x2xf32>
  func.return %result : vector<2x2x2xf32>
}

// ----
CHECK: return %result

// ====

func.def @f32x2x2x2_transpose(%values: vector<2x2x2xf32>) -> (vector<2x2x2xf32>) {
  %result = vector.transpose<[2, 0, 1]> %values : vector<2x2x2xf32> -> vector<2x2x2xf32>
  func.return %result : vector<2x2x2xf32>
}

// ----
CHECK: return %result

// ====

func.def @f32x4x4_transpose(%values: vector<4x4xf32>) -> (vector<4x4xf32>) {
  %result = vector.transpose<[1, 0]> %values : vector<4x4xf32> -> vector<4x4xf32>
  func.return %result : vector<4x4xf32>
}

// ----
CHECK: * = mova.i32 34
CHECK: %result = vshuffle *
CHECK: return %result
CHECK-NOT: *vextract*
CHECK-NOT: *vinsert*

// ====

func.def @i32x4x4_transpose(%values: vector<4x4xi32>) -> (vector<4x4xi32>) {
  %result = vector.transpose<[1, 0]> %values : vector<4x4xi32> -> vector<4x4xi32>
  func.return %result : vector<4x4xi32>
}

// ----
