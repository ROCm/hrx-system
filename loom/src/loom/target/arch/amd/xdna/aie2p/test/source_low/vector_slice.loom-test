func.def @f32x3x4_slice_row(%values: vector<3x4xf32>) -> (vector<1x4xf32>) {
  %result = vector.slice %values[1, 0] : vector<3x4xf32> -> vector<1x4xf32>
  func.return %result : vector<1x4xf32>
}

// ----
CHECK: return %result

// ====

func.def @f32x2x4_insert_static(%values: vector<2x4xf32>, %value: f32) -> (vector<2x4xf32>) {
  %result = vector.insert %value into %values[1, 2] : f32, vector<2x4xf32>
  func.return %result : vector<2x4xf32>
}

// ----
CHECK: return %result

// ====

func.def @f32x4_insert_static(%values: vector<4xf32>, %value: f32) -> (vector<4xf32>) {
  %updated = vector.insert %value into %values[2] : f32, vector<4xf32>
  func.return %updated : vector<4xf32>
}

// ----
CHECK: %updated = vinsert.32.reg *
CHECK: return %updated

// ====

func.def @f16x4_insert_static(%values: vector<4xf16>, %value: f16) -> (vector<4xf16>) {
  %updated = vector.insert %value into %values[1] : f16, vector<4xf16>
  func.return %updated : vector<4xf16>
}

// ----
CHECK: %updated = vinsert.16.reg *
CHECK: return %updated

// ====

// RUN: with-checks emit source-low target=amd.xdna.aie2p:core output=low
func.def @bf16x8_insert_static_constant(%values: vector<8xbf16>) -> (vector<8xbf16>) {
  %replacement = scalar.constant 0.0 : bf16
  %updated = vector.insert %replacement into %values[5] : bf16, vector<8xbf16>
  func.return %updated : vector<8xbf16>
}

// ----
CHECK: %replacement = mov.i32 0
CHECK: * = mov.short 5
CHECK: %updated = vinsert.16.reg %values, *, %replacement
CHECK: return %updated
CHECK-NOT: *reg<aie2p.ewl>*

// ====

func.def @f32x1_insert_dynamic(%values: vector<1xf32>, %value: f32, %lane: index) -> (vector<1xf32>) {
  %updated = vector.insert %value into %values[%lane] : f32, vector<1xf32>
  func.return %updated : vector<1xf32>
}

// ----
CHECK: %updated = vinsert.32.reg *
CHECK: return %updated

