func.def @i8x128_extract_high(%values: vector<128xi8>) -> (i8) {
  %result = vector.extract %values[95] : vector<128xi8> -> i8
  func.return %result : i8
}

// ----
CHECK: * = slice %values[2] *
CHECK: %result = vextract.8.imm *, 31
CHECK: return %result

