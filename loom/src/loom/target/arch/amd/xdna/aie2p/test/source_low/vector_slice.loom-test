func.def @i8x32_concat(%low: vector<32xi8>, %high: vector<32xi8>) -> (vector<64xi8>) {
  %result = vector.concat<0> %low, %high : vector<32xi8>, vector<32xi8> -> vector<64xi8>
  func.return %result : vector<64xi8>
}

// ----
CHECK: %result = concat(*
CHECK: return %result
CHECK-NOT: *vextract*
CHECK-NOT: *vinsert*

// ====

func.def @i8x8_interleave(%even: vector<4xi8>, %odd: vector<4xi8>) -> (vector<8xi8>) {
  %result = vector.interleave<0> %even, %odd : vector<4xi8>, vector<4xi8> -> vector<8xi8>
  func.return %result : vector<8xi8>
}

// ----
CHECK: return %result

// ====

func.def @i8x8_deinterleave(%values: vector<8xi8>) -> (vector<4xi8>, vector<4xi8>) {
  %even, %odd = vector.deinterleave<0> %values : vector<8xi8> -> vector<4xi8>, vector<4xi8>
  func.return %even, %odd : vector<4xi8>, vector<4xi8>
}

// ----
CHECK: return %even, %odd

// ====

// RUN: emit source-low target=amd.xdna.aie2p:core output=low
func.def @i32x4_broadcast_rank2(%values: vector<4xi32>) -> (vector<2x4xi32>) {
  %result = vector.broadcast %values : vector<4xi32> -> vector<2x4xi32>
  func.return %result : vector<2x4xi32>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i32x4_broadcast_rank2(%values: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %7 = mova.i32 16
  %8 = vshift %values, %values, %7
  %9 = mova.i32 48
  %result = vshift %8, %values, %9
  return %result
}

// ====

// RUN: emit source-low target=amd.xdna.aie2p:core output=low
func.def @i16x1_broadcast(%value: vector<1xi16>) -> (vector<16xi16>) {
  %result = vector.broadcast %value : vector<1xi16> -> vector<16xi16>
  func.return %result : vector<16xi16>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i16x1_broadcast(%value: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %result = vextbcst.16 %value, 0
  return %result
}

