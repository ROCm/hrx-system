// TEMPLATE: loom/src/loom/test/corpus/source_low/vector_slice.loom-test
// RUN: with-checks emit source-low target=amd.xdna.aie2p:core output=low

func.def @i32x4_slice_middle(%values: vector<4xi32>) -> (vector<2xi32>) {
  %middle = vector.slice %values[1] : vector<4xi32> -> vector<2xi32>
  func.return %middle : vector<2xi32>
}

// ----
CHECK: * = mova.i32 4
CHECK: %middle = vshift *
CHECK: return %middle
CHECK-NOT: *vextract*
CHECK-NOT: *vinsert*

// ====

func.def @i8x4_slice_low_half(%bytes: vector<4xi8>) -> (vector<2xi8>) {
  %low = vector.slice %bytes[0] : vector<4xi8> -> vector<2xi8>
  func.return %low : vector<2xi8>
}

// ----
CHECK: return %low
CHECK-NOT: *vshift*
CHECK-NOT: *vextract*
CHECK-NOT: *vinsert*

