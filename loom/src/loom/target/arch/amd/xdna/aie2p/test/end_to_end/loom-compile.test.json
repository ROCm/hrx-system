{
  "version": 1,
  "cases": [
    {
      "name": "compiles a resident split-K array to one XDNA product",
      "run": {
        "tool": "loom-compile",
        "args": [
          "{srcdir}/split_k.loom",
          "--backend=xdna-strix-halo",
          "--output={tmp}/split_k.xdna",
          "--compile-report=details"
        ]
      },
      "stderr": {
        "contains": {
          "unordered": [
            "\"artifact_kind\":\"target-artifact\"",
            "\"backend\":\"amd-xdna-strix-halo\"",
            "\"artifact_format\":\"elf\"",
            "\"status\":{\"code\":0,\"name\":\"OK\"}",
            "\"entries\":{\"count\":3",
            "\"plan_key\":\"matrix.mmul.s8s8.m8n8k8\"",
            "\"spill_count\":0"
          ]
        }
      },
      "files": [
        {
          "path": "{tmp}/split_k.xdna",
          "non_empty": true
        }
      ]
    }
  ]
}
