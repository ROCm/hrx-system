// ====
// RUN: emit source-low output=none

// Source initialization still cannot depend on invocation bindings.
aie2p.target<configuration> @configuration {device_profile = "amd.xdna.strix_halo.17f0_11"}

low.func.def public retain target<amd.xdna.aie2p.configuration>(@configuration) abi(array_program) @entry() asm {
  %columns = constant 8 : reg<aie2p.config.scalar : i64>
  entry %columns, @initialize, @invoke
  return
}

func.def target(@configuration) @initialize() {
  %extent = scalar.constant 64 : i64
  low.invoke @bind(%extent) : (i64)
  func.return
}

low.func.def target<amd.xdna.aie2p.configuration>(@configuration) @invoke() asm {
  return
}

low.func.def target<amd.xdna.aie2p.configuration>(@configuration) @bind(%extent: reg<aie2p.config.scalar : i64>) asm {
  %ordinal = constant 0 : reg<aie2p.config.scalar : i64>
  %read = constant 1 : reg<aie2p.config.scalar : i64>
  // ERROR@+1: XDNA/038 {function_name="initialize", phase="initialization", command="amd.xdna.aie2p.configuration.binding"}
  %input = binding %ordinal, %read, %extent, %extent
  return
}

// ----

// ====
// RUN: emit source-low output=none

// Invocation cannot acquire storage whose lifetime belongs to initialization.
aie2p.target<configuration> @configuration {device_profile = "amd.xdna.krackan.17f0_20"}

low.func.def public retain target<amd.xdna.aie2p.configuration>(@configuration) abi(array_program) @entry() asm {
  %columns = constant 1 : reg<aie2p.config.scalar : i64>
  entry %columns, @initialize, @invoke
  return
}

low.func.def target<amd.xdna.aie2p.configuration>(@configuration) @initialize() asm {
  return
}

func.def target(@configuration) @invoke() {
  %extent = scalar.constant 64 : i64
  low.invoke @reserve(%extent) : (i64)
  func.return
}

low.func.def target<amd.xdna.aie2p.configuration>(@configuration) @reserve(%extent: reg<aie2p.config.scalar : i64>) asm {
  %column = constant 0 : reg<aie2p.config.scalar : i64>
  %row = constant 2 : reg<aie2p.config.scalar : i64>
  // ERROR@+1: XDNA/038 {function_name="invoke", phase="invocation", command="amd.xdna.aie2p.configuration.data.reserve"}
  data.reserve %column, %row, %column, %extent
  return
}

// ----

// ====
// RUN: verify

// Source phases have the same empty runtime signature as physical phases.
aie2p.target<configuration> @configuration

low.func.def public retain target<amd.xdna.aie2p.configuration>(@configuration) abi(array_program) @entry() asm {
  %columns = constant 1 : reg<aie2p.config.scalar : i64>
  // ERROR@+1: XDNA/037 {field_name="initialize", symbol_name="initialize", argument_count="1", result_count="0"}
  entry %columns, @initialize, @invoke
  return
}

func.def target(@configuration) @initialize(%runtime_extent: i64) {
  func.return
}

low.func.def target<amd.xdna.aie2p.configuration>(@configuration) @invoke() asm {
  return
}

