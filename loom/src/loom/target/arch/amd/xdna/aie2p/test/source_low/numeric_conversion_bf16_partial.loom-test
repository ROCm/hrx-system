// RUN: emit source-low target=amd.xdna.aie2p:core output=low

func.def @widen_partial_bf16(%input: vector<4xbf16>) -> (vector<4xf32>) {
  %result = vector.extf %input : vector<4xbf16> to vector<4xf32>
  func.return %result : vector<4xf32>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @widen_partial_bf16(%input: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  set.saturation 1
  set.ups-mode 0
  %5 = slice %input[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %6 = mov.shift 0
  %7 = vups.2x.w-to-b.unsigned %5, %6
  %8 = vmov.accumulator512.to.vector512 %7
  set.saturation 0
  set.ups-mode 1
  set.srs-mode 1
  set.rounding 0
  %9 = mov.shift 16
  %10 = vups.2x.x-to-c.unsigned %8, %9
  %result = vsrs.2x.c-to-x.unsigned %10, %6
  return %result
}

// ====

func.def @narrow_partial_bf16(%input: vector<4xf32>) -> (vector<4xbf16>) {
  %result = vector.fptrunc %input : vector<4xf32> to vector<4xbf16>
  func.return %result : vector<4xbf16>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @narrow_partial_bf16(%input: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  set.saturation 0
  set.rounding 0
  set.srs-mode 0
  %5 = mov.short 1
  %6 = vbcst.32 %5
  %7 = mov.i32 32767
  %8 = vbcst.32 %7
  %9 = mov.i32 2147483647
  %10 = vbcst.32 %9
  %11 = mov.i32 2139095040
  %12 = vbcst.32 %11
  %13 = mov.i32 4194304
  %14 = vbcst.32 %13
  set.ups-mode 1
  set.srs-mode 1
  %15 = mov.shift 0
  %16 = vups.2x.x-to-c.unsigned %input, %15
  %17 = mov.shift 16
  %18 = vsrs.2x.c-to-x.unsigned %16, %17
  %19 = vband %18, %6
  %20 = vadd.32 %8, %19
  %21 = vadd.32 %input, %20
  %22 = vband %input, %10
  %23 = vlt.u32x16.el.low32 %12, %22
  %24 = predicate.complete.zero.high32 %23, 0
  %25 = vbor %input, %14
  %26 = vsel.32.mask64 %21, %25, %24
  set.srs-mode 0
  %27 = slice %26[1] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %28 = vmov.vector512.to.accumulator512 %26
  %29 = vsrs.2x.b-to-w.unsigned %28, %17
  %result = concat(%29, %27) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  return %result
}

// ====

func.def @widen_partial_wide_bf16(%input: vector<24xbf16>) -> (vector<24xf32>) {
  %result = vector.extf<daz> %input : vector<24xbf16> to vector<24xf32>
  func.return %result : vector<24xf32>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @widen_partial_wide_bf16(%input: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x4>) asm {
  %5 = vconv.fp32.bf16 %input
  %6 = slice %5[0] : reg<aie2p.mbms x2> -> reg<aie2p.mbms>
  %7 = vmov.accumulator512.to.vector512 %6
  %8 = slice %5[1] : reg<aie2p.mbms x2> -> reg<aie2p.mbms>
  %9 = vmov.accumulator512.to.vector512 %8
  %result = concat(%7, %9) : (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) -> reg<aie2p.vec256 x4>
  return %result
}

// ====

func.def @narrow_partial_wide_bf16(%input: vector<24xf32>) -> (vector<24xbf16>) {
  %result = vector.fptrunc<daz> %input : vector<24xf32> to vector<24xbf16>
  func.return %result : vector<24xbf16>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @narrow_partial_wide_bf16(%input: reg<aie2p.vec256 x4>) -> (reg<aie2p.vec256 x2>) asm {
  %5 = slice %input[0] : reg<aie2p.vec256 x4> -> reg<aie2p.vec256 x2>
  %6 = slice %input[2] : reg<aie2p.vec256 x4> -> reg<aie2p.vec256 x2>
  %7 = mov.i32 2147483647
  %8 = vbcst.32 %7
  %9 = mov.i32 2139095040
  %10 = vbcst.32 %9
  %11 = mov.i32 32704
  %12 = vbcst.16 %11
  set.rounding 12
  %33 = slice %input[1] : reg<aie2p.vec256 x4> -> reg<aie2p.vec256>
  %14 = vmov.vector512.to.accumulator512 %5
  %15 = vconv.bf16.fp32x16 %14
  %16 = concat(%15, %33) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  %17 = vband %5, %8
  %18 = vlt.u32x16.el.low32 %10, %17
  %19 = predicate.complete.zero.high32 %18, 0
  %20 = vsel.16.mask64 %16, %12, %19
  %32 = slice %input[3] : reg<aie2p.vec256 x4> -> reg<aie2p.vec256>
  %22 = vmov.vector512.to.accumulator512 %6
  %23 = vconv.bf16.fp32x16 %22
  %24 = concat(%23, %32) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  %25 = vband %6, %8
  %26 = vlt.u32x16.el.low32 %10, %25
  %27 = predicate.complete.zero.high32 %26, 0
  %28 = vsel.16.mask64 %24, %12, %27
  %29 = slice %20[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %30 = slice %28[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %result = concat(%29, %30) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  return %result
}
