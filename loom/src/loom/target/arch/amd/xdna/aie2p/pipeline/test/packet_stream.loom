}

// Cross the 256-repeat task boundary without splitting source ownership.
func.def @queued_reference(%input: buffer, %left: buffer, %right: buffer) {
  %cycles = index.constant 257 : index
  func.call @reference_cycles(%input, %left, %right, %cycles) : (buffer, buffer, buffer, index)
  func.return
}

pipeline.def<kernel> public retain target(@device) @sram_queued_period() run(%input: buffer, %left: buffer, %right: buffer) {
  %capacity = index.constant 1 : index
  %source_row = index.constant 1 : index
  %cycles = index.constant 257 : index
  %epoch = index.constant 0 : index
  pipeline.compose @stream[%capacity, %source_row, %cycles](%input, %left, %right, %epoch) : [index, index, index](buffer, buffer, buffer, index)
}

check.scenario public @sram_queued_period_records {
  check.trial[3](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input_storage = check.generate.random.uniform seed(%seed) range(-1000000 to 1000000) : tensor<12368xi32>
    %input = check.tensor.view %input_storage offset(64) : tensor<12368xi32> -> tensor<12336xi32>
    %left_storage = check.generate.fill value(-9999) : tensor<12368xi32>
    %left = check.tensor.view %left_storage offset(64) : tensor<12368xi32> -> tensor<12336xi32>
    %right_storage = check.generate.fill value(1234567) : tensor<8256xi32>
    %right = check.tensor.view %right_storage offset(64) : tensor<8256xi32> -> tensor<8224xi32>
    check.compare<@sram_queued_period, @queued_reference>(%input, %left, %right) : (tensor<12336xi32>, tensor<12336xi32>, tensor<8224xi32>) -> () {
      check.expect.equal actual(%input_storage) expected(%input_storage) : tensor<12368xi32>
      check.expect.equal actual(%left_storage) expected(%left_storage) : tensor<12368xi32>
      check.expect.equal actual(%right_storage) expected(%right_storage) : tensor<8256xi32>
    }
  }
  check.return
}
