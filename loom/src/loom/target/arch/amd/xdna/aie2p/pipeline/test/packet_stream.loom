// Each child consumes whole source and destination rings, physically retires,
// and then reuses the same DMA engines for a different input epoch.
pipeline.def<kernel> public retain target(@device) @children() run(%input: buffer, %left: buffer, %right: buffer) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %epochs = index.constant 3 : index
  %capacity = index.constant 2 : index
  %sram = index.constant 1 : index
  %cycles = index.constant 6 : index
  pipeline.serial {
    scf.for %epoch = [%begin to %epochs step %step] {
      pipeline.compose @stream[%capacity, %sram, %cycles](%input, %left, %right, %epoch) : [index, index, index](buffer, buffer, buffer, index)
    }
  }
}

func.def @children_reference(%input: buffer, %left: buffer, %right: buffer) {
  %cycles = index.constant 18 : index
  func.call @reference_cycles(%input, %left, %right, %cycles) : (buffer, buffer, buffer, index)
  func.return
}

check.scenario public @independent_child_records {
  check.trial[3](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input_storage = check.generate.random.uniform seed(%seed) range(-1000000 to 1000000) : tensor<896xi32>
    %input = check.tensor.view %input_storage offset(64) : tensor<896xi32> -> tensor<864xi32>
    %left_storage = check.generate.fill value(-9999) : tensor<896xi32>
    %left = check.tensor.view %left_storage offset(64) : tensor<896xi32> -> tensor<864xi32>
    %right_storage = check.generate.fill value(1234567) : tensor<608xi32>
    %right = check.tensor.view %right_storage offset(64) : tensor<608xi32> -> tensor<576xi32>
    check.compare<@children, @children_reference>(%input, %left, %right) : (tensor<864xi32>, tensor<864xi32>, tensor<576xi32>) -> () {
      check.expect.equal actual(%input_storage) expected(%input_storage) : tensor<896xi32>
      check.expect.equal actual(%left_storage) expected(%left_storage) : tensor<896xi32>
      check.expect.equal actual(%right_storage) expected(%right_storage) : tensor<608xi32>
    }
  }
  check.return
}

// Three cycles do not complete the four-cycle source-address period.
pipeline.def<kernel> public retain target(@device) @sram_partial_only() run(%input: buffer, %left: buffer, %right: buffer) {
  %capacity = index.constant 4 : index
  %source_row = index.constant 1 : index
  %cycles = index.constant 3 : index
  %epoch = index.constant 0 : index
  pipeline.compose @stream[%capacity, %source_row, %cycles](%input, %left, %right, %epoch) : [index, index, index](buffer, buffer, buffer, index)
}

