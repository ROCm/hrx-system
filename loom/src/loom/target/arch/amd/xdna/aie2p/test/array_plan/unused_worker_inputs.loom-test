low.func.def retain target<amd.xdna.aie2p.core> @discard_then_increment$worker$0() asm {
  %acquire_delta = mov.short -1
  %release_delta = mov.short 1
  %11 = mov.local-address 491520
  low.br ^_bb1(%11: reg<aie2p.ep>)
^_bb1(%5: reg<aie2p.ep>):
  acq %acquire_delta, 49
  acq %acquire_delta, 50
  %output_view = copy %5 : reg<aie2p.ep> -> reg<aie2p.ep>
  %3 = mov.short 1
  %value = vbcst.32 %3
  vst.512.i32x16 %value, %output_view, 0
  rel %release_delta, 51
  rel %release_delta, 48
  %7 = mov.address-to-scalar %5
  %8 = mov.i32 16384
  %9 = xor %7, %8
  %10 = mov.scalar-to-address %9
  low.br ^_bb1(%10: reg<aie2p.ep>)
}

low.func.def retain target<amd.xdna.aie2p.core> @discard_then_increment$worker$1() asm {
  %acquire_delta = mov.short -1
  %release_delta = mov.short 1
  %31 = mov.local-address 294912
  %32 = mov.local-address 458752
  low.br ^_bb1(%31: reg<aie2p.ep>, %32: reg<aie2p.ep>)
^_bb1(%20: reg<aie2p.ep>, %22: reg<aie2p.ep>):
  acq %acquire_delta, 3
  acq %acquire_delta, 48
  %input_view = copy %20 : reg<aie2p.ep> -> reg<aie2p.ep>
  %output_view = copy %22 : reg<aie2p.ep> -> reg<aie2p.ep>
  %value = vlda.512.i32x16 %input_view, 0
  %17 = mov.short 1
  %increment = vbcst.32 %17
  %next = vadd.32 %value, %increment
  vst.512.i32x16 %next, %output_view, 0
  rel %release_delta, 49
  rel %release_delta, 2
  %24 = mov.address-to-scalar %20
  %25 = mov.i32 16384
  %26 = xor %24, %25
  %27 = mov.scalar-to-address %26
  %28 = mov.address-to-scalar %22
  %29 = xor %28, %25
  %30 = mov.scalar-to-address %29
  low.br ^_bb1(%27: reg<aie2p.ep>, %30: reg<aie2p.ep>)
}
