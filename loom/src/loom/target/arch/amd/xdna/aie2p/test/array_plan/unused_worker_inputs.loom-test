// RUN: emit aie2p-array-plan @discard_then_increment

// Discarding a payload keeps its channel credit protocol. A following worker
// binds its own pointers after the first worker's full topology-port range.

aie2p.target<array> @array_target

aie2p.target<core> @core_target

func.def target(@core_target) @replace(%input: buffer, %output_arg: buffer) {
  %output = buffer.assume.alignment %output_arg {minimum_alignment = 64} : buffer
  %base = index.constant 0 : offset
  %output_view = buffer.view %output[%base] : buffer -> view<16xi32>
  %value = vector.constant 1 : vector<16xi32>
  vector.store %value, %output_view[0] : vector<16xi32>, view<16xi32>
  func.return
}

func.def target(@core_target) @following(%input_arg: buffer, %output_arg: buffer) {
  %input, %output = buffer.assume.alignment %input_arg, %output_arg {minimum_alignment = 64} : buffer, buffer
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<16xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<16xi32>
  %value = vector.load %input_view[0] : view<16xi32> -> vector<16xi32>
  %increment = vector.constant 1 : vector<16xi32>
  %next = vector.addi %value, %increment : vector<16xi32>
  vector.store %next, %output_view[0] : vector<16xi32>, view<16xi32>
  func.return
}

pipeline.def<kernel> public retain target(@array_target) @discard_then_increment() launch(%input: buffer, %output: buffer) {
  %worker_count = index.constant 1 : index
  %base = index.constant 0 : offset
  %first_workers = group.create %worker_count : index -> group
  %second_workers = group.create %worker_count : index -> group
  %input_view = buffer.view %input[%base] : buffer -> view<1x4x16xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<1x4x16xi32>
  %flow = pipeline.scatter %input_view across %first_workers : view<1x4x16xi32>, group -> pipeline.flow<tile<16xi32>>
  %first = pipeline.stage @replace on %first_workers(%flow) : (group, pipeline.flow<tile<16xi32>>) -> (pipeline.flow<tile<16xi32>>)
  %second = pipeline.stage @following on %second_workers(%first) : (group, pipeline.flow<tile<16xi32>>) -> (pipeline.flow<tile<16xi32>>)
  pipeline.write %second to %output_view : pipeline.flow<tile<16xi32>>, view<1x4x16xi32>
  pipeline.return
}

