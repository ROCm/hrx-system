// RUN: with-checks emit aie2p-xdna output=sections

// An authored four-byte stack grows into a native aligned spill frame. Only
// its relocatable reservation moves; the workgroup allocation stays fixed.
aie2p.target<array> @array_target {device_profile = "amd.xdna.strix_halo.17f0_11"}

aie2p.target<core> @core_target

low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) @full_worker_storage() asm {
  %worker_count = constant.u32 2 : reg<aie2p.array.scalar : index>
  %producer_ordinal = constant.u32 0 : reg<aie2p.array.scalar : index>
  %consumer_ordinal = constant.u32 1 : reg<aie2p.array.scalar : index>
  %channel_capacity = constant.u32 1 : reg<aie2p.array.scalar : index>
  %records_per_invocation = constant.u32 1 : reg<aie2p.array.scalar : index>
  %tile_column = constant.u32 0 : reg<aie2p.array.scalar : index>
  %producer_row = constant.u32 2 : reg<aie2p.array.scalar : index>
  %consumer_row = constant.u32 3 : reg<aie2p.array.scalar : index>
  %workers = group %worker_count
  %producer = worker %workers, %producer_ordinal, @produce_record
  %consumer = worker %workers, %consumer_ordinal, @consume_with_full_storage
  %sender = sender %producer, 0 : reg<aie2p.array.sender : tile<1xi32>>
  %receiver = receiver %consumer, 0 : reg<aie2p.array.receiver : tile<1xi32>>
  %channel = channel %sender, %receiver, %channel_capacity, %records_per_invocation : reg<aie2p.array.channel : tile<1xi32>>
  constrain.location %producer, %tile_column, %producer_row
  constrain.location %consumer, %tile_column, %consumer_row
  return
