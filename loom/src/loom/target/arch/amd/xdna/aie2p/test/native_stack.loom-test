  %input = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %storage = storage {byte_alignment = 64, byte_length = 65536} : low.storage<workgroup>
  %address = storage_address %storage : low.storage<workgroup> -> reg<aie2p.ep>
  %iterations = mov.short 2
  %step = mov.short 1
  %initial_value = lda %input, 0
  %offset0 = mov.static-byte-offset 64
  %index0 = mov.address-index %offset0
  st.i32.index %initial_value, %address, %index0
  %offset1 = mov.static-byte-offset 128
  %index1 = mov.address-index %offset1
