{
  "version": 1,
  "cases": [
    {
      "name": "failed helpers retain parseable source expansion evidence",
      "steps": [
        {
          "name": "compile-rejected-helper",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{srcdir}/failed_helper_report.loom",
              "--root=@failed_helper_report",
              "--format=xdna",
              "--output={tmp}/failed-helper.xdna",
              "--compile-report=details",
              "--compile-report-output={tmp}/failed-helper.json"
            ]
          },
          "exit": 1,
          "stderr": {
            "contains": {
              "unordered": [
                "BACKEND/044",
                "unresolved state dependency",
                "amd.xdna.aie2p.add.carry.i32"
              ]
            }
          },
          "files": [
            {"path": "{tmp}/failed-helper.xdna", "exists": false},
            {
              "path": "{tmp}/failed-helper.json",
              "contains": {
                "unordered": [
                  "\"entries\":{\"count\":0,\"rows\":[]}",
                  "\"source_op\":\"scalar.mulf\"",
                  "\"plan_key\":\"exact_binary32\"",
                  "\"maximum_emitted_low_op_count\":163",
                  "\"planning\":{\"frame_build_count\":1,\"allocation_run_count\":0"
                ]
              }
            }
          ]
        },
        {
          "name": "show-retained-expansion",
          "run": {
            "tool": "loom-compile-report",
            "args": ["show", "{tmp}/failed-helper.json"]
          },
          "stdout": {
            "contains": {
              "unordered": [
                "scalar.mulf: up to 163 Low operations per source operation via exact_binary32",
                "entries: none"
              ]
            }
          }
        },
        {
          "name": "suggest-retained-expansion",
          "run": {
            "tool": "loom-compile-report",
            "args": [
              "suggest",
              "{tmp}/failed-helper.json",
              "--format=json"
            ]
          },
          "stdout": {
            "contains": {
              "unordered": [
                "\"id\":\"lowering.reduce_expansion\"",
                "\"provider\":\"source\"",
                "\"status\":\"available\"",
                "\"target_unavailable_reason\":\"compile_status_not_ok\""
              ]
            }
          }
        }
      ]
    }
  ]
}
