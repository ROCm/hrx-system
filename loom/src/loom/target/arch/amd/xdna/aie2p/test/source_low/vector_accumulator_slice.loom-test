}

// ====

func.def @f32x64_slice_shifted_accumulator(%value: vector<64xf32>) -> (vector<32xf32>) {
  %result = vector.slice %value[4] : vector<64xf32> -> vector<32xf32>
  func.return %result : vector<32xf32>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @f32x64_slice_shifted_accumulator(%value: reg<aie2p.mbms x4>) -> (reg<aie2p.mbms x2>) asm {
  %5 = slice %value[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %6 = vmov.accumulator512.to.vector512 %5
  %7 = slice %value[1] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %8 = vmov.accumulator512.to.vector512 %7
  %9 = slice %value[2] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %10 = vmov.accumulator512.to.vector512 %9
  %11 = mova.i32 16
  %12 = vshift %6, %8, %11
  %13 = vshift %8, %10, %11
  %14 = vmov.vector512.to.accumulator512 %12
  %15 = vmov.vector512.to.accumulator512 %13
  %result = concat(%14, %15) : (reg<aie2p.mbms>, reg<aie2p.mbms>) -> reg<aie2p.mbms x2>
  return %result
}
