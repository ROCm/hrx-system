// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i32x64_slice_high_half(%value: reg<aie2p.mbms x4>) -> (reg<aie2p.vec256 x4>) asm {
  %5 = slice %value[2] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %6 = vmov.accumulator512.to.vector512 %5
  %7 = slice %value[3] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %8 = vmov.accumulator512.to.vector512 %7
  %result = concat(%6, %8) : (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) -> reg<aie2p.vec256 x4>
  return %result
}

