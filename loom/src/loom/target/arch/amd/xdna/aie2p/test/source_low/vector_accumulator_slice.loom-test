// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @f32x32_slice_shifted_subpacket(%value: reg<aie2p.mbms x2>) -> (reg<aie2p.vec256 x2>) asm {
  %5 = slice %value[0] : reg<aie2p.mbms x2> -> reg<aie2p.mbms>
  %6 = vmov.accumulator512.to.vector512 %5
  %7 = slice %value[1] : reg<aie2p.mbms x2> -> reg<aie2p.mbms>
  %8 = vmov.accumulator512.to.vector512 %7
  %9 = mova.i32 16
  %result = vshift %6, %8, %9
