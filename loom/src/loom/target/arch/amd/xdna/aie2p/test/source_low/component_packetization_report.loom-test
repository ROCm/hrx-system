// RUN: compile-report target=amd.xdna.aie2p:core target-legalize{mode=eager}

// Scalar memory legalization creates a splat that a later greedy iteration
// packetizes. The report row keeps the authored load identity while its counts
// cover the generated helper lineage.
func.def @generated_splat_packet_report(%input: buffer, %byte_offset: offset) -> (vector<64xbf16>) {
  %aligned_input = buffer.assume.alignment %input {minimum_alignment = 2} : buffer
  %aligned_offset = index.assume %byte_offset [multiple_of(%byte_offset, 2)] : offset
  %view = buffer.view %aligned_input[%aligned_offset] : buffer -> view<64xbf16>
  %result = vector.load %view[0] : view<64xbf16> -> vector<64xbf16>
  func.return %result : vector<64xbf16>
}

