  %slots = buffer.view %storage[%channel_origin] : buffer -> view<2x8xi32>
  %records = channel.bind<fifo> %slots, %capacity : view<2x8xi32>, index -> channel<tile<8xi32>>
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %begin = index.constant 0 : index
    %batch_count = index.constant 2 : index
    %record_count = index.constant 4 : index
    %step = index.constant 1 : index
    %record_bytes = index.constant 64 : index
    %initial_values = vector.constant 0 : vector<8xi32>
    scf.for %batch = [%begin to %batch_count step %step] {
      %position_end = index.add %batch, %record_count : index
      scf.for %position = [%batch to %position_end step %step] {
        %relative_position = index.sub %position, %batch : index
        %record_position = index.assume %relative_position [range(%relative_position, 0, 3)] : index
        %byte_index = index.mul %record_position, %record_bytes : index
        %byte_offset = index.cast %byte_index : index to offset
        %external_offset = index.add %payload_origin, %byte_offset : offset
        %external_input = buffer.view %source[%external_offset] : buffer -> view<4xi32>
        %write, %record = channel.reserve %records : channel<tile<8xi32>> -> (write<tile<8xi32>>, view<8xi32>)
        vector.store %initial_values, %record[0] : vector<8xi32>, view<8xi32>
        %incoming_suffix = view.subview %record[4] : view<8xi32> -> view<4xi32>
        %ingress = kernel.async.copy %external_input to %incoming_suffix {cache_scope = cu, cache_temporal = regular, direction = global_to_workgroup} : view<4xi32> to view<4xi32> -> kernel.async.token
        %incoming = kernel.async.group %ingress : kernel.async.token -> kernel.async.group
        kernel.async.wait %incoming {newer_groups = 0} : kernel.async.group
        channel.publish %write : write<tile<8xi32>>
        %read, %ready = channel.acquire %records : channel<tile<8xi32>> -> (read<tile<8xi32>>, view<8xi32>)
        %outgoing_suffix = view.subview %ready[4] : view<8xi32> -> view<4xi32>
        %external_window = buffer.view %destination[%external_offset] : buffer -> view<8xi32>
        %external_output = view.subview %external_window[4] : view<8xi32> -> view<4xi32>
        %egress = kernel.async.copy %outgoing_suffix to %external_output {cache_scope = cu, cache_temporal = regular, direction = workgroup_to_global} : view<4xi32> to view<4xi32> -> kernel.async.token
        %outgoing = kernel.async.group %egress : kernel.async.token -> kernel.async.group
        kernel.async.wait %outgoing {newer_groups = 0} : kernel.async.group
        channel.release %read : read<tile<8xi32>>
