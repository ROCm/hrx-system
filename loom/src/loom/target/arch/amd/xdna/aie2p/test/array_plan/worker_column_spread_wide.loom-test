// RUN: with-checks emit aie2p-array-plan @copy_16_workers_1_records

// Sixteen scatter/gather workers, the reported copy_16 failure: without the
// shim DMA budget, placement packs eight per column before starting the
// next and route.c exhausts its stream link channels. Two per column
// spreads across all eight columns instead.

aie2p.target<array> @array_target

aie2p.target<core> @core_target

pipeline.def<kernel> public retain target(@array_target) @copy_16_workers_1_records() launch(%input: buffer, %output: buffer) {
  %lanes = index.constant 16 : index
  %input_base = index.constant 16 : offset
  %output_base = index.constant 32 : offset
  %workers = group.create %lanes : index -> group
  %input_view = buffer.view %input[%input_base] : buffer -> view<16x1x4xi32, #encoding.layout.strided<strides=[12, 8, 1]>>
  %output_view = buffer.view %output[%output_base] : buffer -> view<16x1x4xi32, #encoding.layout.strided<strides=[16, 12, 1]>>
  %input_flow = pipeline.scatter %input_view across %workers : view<16x1x4xi32, #encoding.layout.strided<strides=[12, 8, 1]>>, group -> pipeline.flow<tile<4xi32>>
  %output_flow = pipeline.stage @copy on %workers(%input_flow) : (group, pipeline.flow<tile<4xi32>>) -> (pipeline.flow<tile<4xi32>>)
  pipeline.write %output_flow to %output_view : pipeline.flow<tile<4xi32>>, view<16x1x4xi32, #encoding.layout.strided<strides=[16, 12, 1]>>
  pipeline.return
}

func.def target(@core_target) @copy(%input: buffer, %output: buffer) {
  %input_aligned, %output_aligned = buffer.assume.alignment %input, %output {minimum_alignment = 4} : buffer, buffer
  %base = index.constant 0 : offset
  %input_view = buffer.view %input_aligned[%base] : buffer -> view<4xi32>
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<4xi32>
  %word0 = view.load %input_view[0] : view<4xi32> -> i32
  view.store %word0, %output_view[0] : i32, view<4xi32>
  %word1 = view.load %input_view[1] : view<4xi32> -> i32
  view.store %word1, %output_view[1] : i32, view<4xi32>
  %word2 = view.load %input_view[2] : view<4xi32> -> i32
  view.store %word2, %output_view[2] : i32, view<4xi32>
  %word3 = view.load %input_view[3] : view<4xi32> -> i32
  view.store %word3, %output_view[3] : i32, view<4xi32>
  func.return
}

// ----
CHECK: array @copy_16_workers_1_records * workers=16 *
CHECK: worker index=0 group=0 lane=0 entry=@copy tile=(0,2) *
CHECK: worker index=1 group=0 lane=1 entry=@copy tile=(0,3) *
CHECK: worker index=2 group=0 lane=2 entry=@copy tile=(1,2) *
CHECK: worker index=3 group=0 lane=3 entry=@copy tile=(1,3) *
CHECK: worker index=4 group=0 lane=4 entry=@copy tile=(2,2) *
CHECK: worker index=5 group=0 lane=5 entry=@copy tile=(2,3) *
CHECK: worker index=6 group=0 lane=6 entry=@copy tile=(3,2) *
CHECK: worker index=7 group=0 lane=7 entry=@copy tile=(3,3) *
CHECK: worker index=8 group=0 lane=8 entry=@copy tile=(4,2) *
CHECK: worker index=9 group=0 lane=9 entry=@copy tile=(4,3) *
CHECK: worker index=10 group=0 lane=10 entry=@copy tile=(5,2) *
CHECK: worker index=11 group=0 lane=11 entry=@copy tile=(5,3) *
CHECK: worker index=12 group=0 lane=12 entry=@copy tile=(6,2) *
CHECK: worker index=13 group=0 lane=13 entry=@copy tile=(6,3) *
CHECK: worker index=14 group=0 lane=14 entry=@copy tile=(7,2) *
CHECK: worker index=15 group=0 lane=15 entry=@copy tile=(7,3) *
