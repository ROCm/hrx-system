func.def target(@target) @cmp_i32_matrix(%lhs: vector<16xi32>, %rhs: vector<16xi32>) -> (vector<16xi1>, vector<16xi1>, vector<16xi1>, vector<16xi1>, vector<16xi1>, vector<16xi1>, vector<16xi1>, vector<16xi1>, vector<16xi1>, vector<16xi1>) {
  %eq = vector.cmpi eq, %lhs, %rhs : vector<16xi32> -> vector<16xi1>
  %ne = vector.cmpi ne, %lhs, %rhs : vector<16xi32> -> vector<16xi1>
  %slt = vector.cmpi slt, %lhs, %rhs : vector<16xi32> -> vector<16xi1>
  %sle = vector.cmpi sle, %lhs, %rhs : vector<16xi32> -> vector<16xi1>
  %sgt = vector.cmpi sgt, %lhs, %rhs : vector<16xi32> -> vector<16xi1>
  %sge = vector.cmpi sge, %lhs, %rhs : vector<16xi32> -> vector<16xi1>
  %ult = vector.cmpi ult, %lhs, %rhs : vector<16xi32> -> vector<16xi1>
  %ule = vector.cmpi ule, %lhs, %rhs : vector<16xi32> -> vector<16xi1>
  %ugt = vector.cmpi ugt, %lhs, %rhs : vector<16xi32> -> vector<16xi1>
  %uge = vector.cmpi uge, %lhs, %rhs : vector<16xi32> -> vector<16xi1>
  func.return %eq, %ne, %slt, %sle, %sgt, %sge, %ult, %ule, %ugt, %uge : vector<16xi1>, vector<16xi1>, vector<16xi1>, vector<16xi1>, vector<16xi1>, vector<16xi1>, vector<16xi1>, vector<16xi1>, vector<16xi1>, vector<16xi1>
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @cmp_i32_matrix(%lhs: reg<aie2p.vec256 x2>, %rhs: reg<aie2p.vec256 x2>) -> (reg<aie2p.elpredicate>, reg<aie2p.elpredicate>, reg<aie2p.elpredicate>, reg<aie2p.elpredicate>, reg<aie2p.elpredicate>, reg<aie2p.elpredicate>, reg<aie2p.elpredicate>, reg<aie2p.elpredicate>, reg<aie2p.elpredicate>, reg<aie2p.elpredicate>) asm {
  %34 = vsub.32 %lhs, %rhs
  %35 = veqz.32.el.low32 %34
  %eq = predicate.complete.zero.high32 %35, 0
  %37 = vlt.u32x16.el.low32 %lhs, %rhs
  %38 = vlt.u32x16.el.low32 %rhs, %lhs
  %39 = predicate.or.low32 %37, %38
  %ne = predicate.complete.zero.high32 %39, 0
  %41 = vlt.s32x16.el.low32 %lhs, %rhs
  %slt = predicate.complete.zero.high32 %41, 0
  %43 = vge.s32x16.el.low32 %rhs, %lhs
  %sle = predicate.complete.zero.high32 %43, 0
  %45 = vlt.s32x16.el.low32 %rhs, %lhs
  %sgt = predicate.complete.zero.high32 %45, 0
  %47 = vge.s32x16.el.low32 %lhs, %rhs
  %sge = predicate.complete.zero.high32 %47, 0
  %49 = vlt.u32x16.el.low32 %lhs, %rhs
  %ult = predicate.complete.zero.high32 %49, 0
  %51 = vge.u32x16.el.low32 %rhs, %lhs
  %ule = predicate.complete.zero.high32 %51, 0
  %53 = vlt.u32x16.el.low32 %rhs, %lhs
  %ugt = predicate.complete.zero.high32 %53, 0
  %55 = vge.u32x16.el.low32 %lhs, %rhs
  %uge = predicate.complete.zero.high32 %55, 0
  return %eq, %ne, %slt, %sle, %sgt, %sge, %ult, %ule, %ugt, %uge
}

// ====

aie2p.target<core> @target

func.def target(@target) @predicate_logic_and_select(%lhs: vector<64xi8>, %rhs: vector<64xi8>, %true_value: vector<64xi8>, %false_value: vector<64xi8>) -> (vector<64xi8>, vector<32xi16>, vector<16xi32>) {
  %byte_lt = vector.cmpi slt, %lhs, %rhs : vector<64xi8> -> vector<64xi1>
  %byte_ne = vector.cmpi ne, %lhs, %rhs : vector<64xi8> -> vector<64xi1>
  %byte_and = vector.andi %byte_lt, %byte_ne : vector<64xi1>
  %byte_or = vector.ori %byte_lt, %byte_ne : vector<64xi1>
  %byte_mask = vector.xori %byte_and, %byte_or : vector<64xi1>
  %byte_result = vector.select %byte_mask, %true_value, %false_value : vector<64xi8>

  %half_lhs = vector.bitcast %lhs : vector<64xi8> to vector<32xi16>
  %half_rhs = vector.bitcast %rhs : vector<64xi8> to vector<32xi16>
  %half_true = vector.bitcast %true_value : vector<64xi8> to vector<32xi16>
  %half_false = vector.bitcast %false_value : vector<64xi8> to vector<32xi16>
  %half_eq = vector.cmpi eq, %half_lhs, %half_rhs : vector<32xi16> -> vector<32xi1>
  %half_uge = vector.cmpi uge, %half_lhs, %half_rhs : vector<32xi16> -> vector<32xi1>
  %half_mask = vector.ori %half_eq, %half_uge : vector<32xi1>
  %half_result = vector.select %half_mask, %half_true, %half_false : vector<32xi16>

  %word_lhs = vector.bitcast %lhs : vector<64xi8> to vector<16xi32>
  %word_rhs = vector.bitcast %rhs : vector<64xi8> to vector<16xi32>
  %word_true = vector.bitcast %true_value : vector<64xi8> to vector<16xi32>
  %word_false = vector.bitcast %false_value : vector<64xi8> to vector<16xi32>
  %word_sle = vector.cmpi sle, %word_lhs, %word_rhs : vector<16xi32> -> vector<16xi1>
  %word_ugt = vector.cmpi ugt, %word_lhs, %word_rhs : vector<16xi32> -> vector<16xi1>
  %word_mask = vector.xori %word_sle, %word_ugt : vector<16xi1>
  %word_result = vector.select %word_mask, %word_true, %word_false : vector<16xi32>

  func.return %byte_result, %half_result, %word_result : vector<64xi8>, vector<32xi16>, vector<16xi32>
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @predicate_logic_and_select(%word_lhs: reg<aie2p.vec256 x2>, %word_rhs: reg<aie2p.vec256 x2>, %word_true: reg<aie2p.vec256 x2>, %word_false: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) asm {
  %byte_lt = vlt.s8x64 %word_lhs, %word_rhs
  %37 = vlt.u8x64 %word_lhs, %word_rhs
  %38 = vlt.u8x64 %word_rhs, %word_lhs
  %39 = predicate.or.low32 %37, %38
  %byte_ne = predicate.or.high32 %37, %38, %39
  %41 = predicate.and.low32 %byte_lt, %byte_ne
  %byte_and = predicate.and.high32 %byte_lt, %byte_ne, %41
  %43 = predicate.or.low32 %byte_lt, %byte_ne
  %byte_or = predicate.or.high32 %byte_lt, %byte_ne, %43
  %45 = predicate.xor.low32 %byte_and, %byte_or
  %byte_mask = predicate.xor.high32 %byte_and, %byte_or, %45
  %byte_result = vsel.8 %word_false, %word_true, %byte_mask
  %48 = vsub.16 %word_lhs, %word_rhs
  %49 = veqz.16.el.low32 %48
  %half_eq = predicate.complete.zero.high32 %49, 0
  %51 = vge.u16x32.el.low32 %word_lhs, %word_rhs
  %half_uge = predicate.complete.zero.high32 %51, 0
  %53 = predicate.or.low32 %half_eq, %half_uge
  %half_mask = predicate.or.high32 %half_eq, %half_uge, %53
  %half_result = vsel.16.mask64 %word_false, %word_true, %half_mask
  %56 = vge.s32x16.el.low32 %word_rhs, %word_lhs
  %word_sle = predicate.complete.zero.high32 %56, 0
  %58 = vlt.u32x16.el.low32 %word_rhs, %word_lhs
  %word_ugt = predicate.complete.zero.high32 %58, 0
  %60 = predicate.xor.low32 %word_sle, %word_ugt
  %word_mask = predicate.xor.high32 %word_sle, %word_ugt, %60
  %word_result = vsel.32.mask64 %word_false, %word_true, %word_mask
  return %byte_result, %half_result, %word_result
}
