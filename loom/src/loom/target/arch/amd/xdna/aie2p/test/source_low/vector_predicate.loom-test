func.def target(@target) @cmp_i16_matrix(%lhs: vector<32xi16>, %rhs: vector<32xi16>) -> (vector<32xi1>, vector<32xi1>, vector<32xi1>, vector<32xi1>, vector<32xi1>, vector<32xi1>, vector<32xi1>, vector<32xi1>, vector<32xi1>, vector<32xi1>) {
  %eq = vector.cmpi eq, %lhs, %rhs : vector<32xi16> -> vector<32xi1>
  %ne = vector.cmpi ne, %lhs, %rhs : vector<32xi16> -> vector<32xi1>
  %slt = vector.cmpi slt, %lhs, %rhs : vector<32xi16> -> vector<32xi1>
  %sle = vector.cmpi sle, %lhs, %rhs : vector<32xi16> -> vector<32xi1>
  %sgt = vector.cmpi sgt, %lhs, %rhs : vector<32xi16> -> vector<32xi1>
  %sge = vector.cmpi sge, %lhs, %rhs : vector<32xi16> -> vector<32xi1>
  %ult = vector.cmpi ult, %lhs, %rhs : vector<32xi16> -> vector<32xi1>
  %ule = vector.cmpi ule, %lhs, %rhs : vector<32xi16> -> vector<32xi1>
  %ugt = vector.cmpi ugt, %lhs, %rhs : vector<32xi16> -> vector<32xi1>
  %uge = vector.cmpi uge, %lhs, %rhs : vector<32xi16> -> vector<32xi1>
  func.return %eq, %ne, %slt, %sle, %sgt, %sge, %ult, %ule, %ugt, %uge : vector<32xi1>, vector<32xi1>, vector<32xi1>, vector<32xi1>, vector<32xi1>, vector<32xi1>, vector<32xi1>, vector<32xi1>, vector<32xi1>, vector<32xi1>
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @cmp_i16_matrix(%lhs: reg<aie2p.vec256 x2>, %rhs: reg<aie2p.vec256 x2>) -> (reg<aie2p.elpredicate>, reg<aie2p.elpredicate>, reg<aie2p.elpredicate>, reg<aie2p.elpredicate>, reg<aie2p.elpredicate>, reg<aie2p.elpredicate>, reg<aie2p.elpredicate>, reg<aie2p.elpredicate>, reg<aie2p.elpredicate>, reg<aie2p.elpredicate>) asm {
  %34 = vsub.16 %lhs, %rhs
  %35 = veqz.16.el.low32 %34
  %eq = predicate.complete.zero.high32 %35, 0
  %37 = vlt.u16x32.el.low32 %lhs, %rhs
  %38 = vlt.u16x32.el.low32 %rhs, %lhs
  %39 = predicate.or.low32 %37, %38
  %ne = predicate.complete.zero.high32 %39, 0
  %41 = vlt.s16x32.el.low32 %lhs, %rhs
  %slt = predicate.complete.zero.high32 %41, 0
  %43 = vge.s16x32.el.low32 %rhs, %lhs
  %sle = predicate.complete.zero.high32 %43, 0
  %45 = vlt.s16x32.el.low32 %rhs, %lhs
  %sgt = predicate.complete.zero.high32 %45, 0
  %47 = vge.s16x32.el.low32 %lhs, %rhs
  %sge = predicate.complete.zero.high32 %47, 0
  %49 = vlt.u16x32.el.low32 %lhs, %rhs
  %ult = predicate.complete.zero.high32 %49, 0
  %51 = vge.u16x32.el.low32 %rhs, %lhs
  %ule = predicate.complete.zero.high32 %51, 0
  %53 = vlt.u16x32.el.low32 %rhs, %lhs
  %ugt = predicate.complete.zero.high32 %53, 0
  %55 = vge.u16x32.el.low32 %lhs, %rhs
  %uge = predicate.complete.zero.high32 %55, 0
  return %eq, %ne, %slt, %sle, %sgt, %sge, %ult, %ule, %ugt, %uge
}

