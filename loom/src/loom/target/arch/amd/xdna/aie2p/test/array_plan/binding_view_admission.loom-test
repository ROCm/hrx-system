  %source = sender %input, 0 : reg<aie2p.array.sender : tile<2x1xi32>>
  // ERROR@+1: XDNA/023 {view_type="tile<1xi32>", lane="2", lane_count="2", source_type="tile<2x1xi32>", reason="the partition lane must be within a non-empty lane set"}
