  %worker = worker %group, %zero, @consume
  %input = binding 0, "read"
  %source = sender %input, 0 : reg<aie2p.array.sender : tile<2x2xi32>>
  // ERROR@+1: XDNA/023 {view_type="tile<3xi32>", lane="0", lane_count="1", source_type="tile<2x2xi32>", reason="source and result record dimensions must resolve to equal non-negative u32 values"}
