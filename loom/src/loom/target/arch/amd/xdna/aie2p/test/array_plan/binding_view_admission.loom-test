  %receiver = receiver %worker, 0 : reg<aie2p.array.receiver : tile<3xi32>>
  %channel = channel %view, %receiver, %one, %two : reg<aie2p.array.channel : tile<3xi32>>
  constrain.location %worker, %zero, %two
