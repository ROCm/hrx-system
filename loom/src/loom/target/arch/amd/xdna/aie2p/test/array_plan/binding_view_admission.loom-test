// RUN: emit aie2p-array-plan @nested_binding_view

aie2p.target<array> @array_target

aie2p.target<core> @core_target

low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) @nested_binding_view() asm {
  %zero = constant.u32 0 : reg<aie2p.array.scalar : index>
  %one = constant.u32 1 : reg<aie2p.array.scalar : index>
  %two = constant.u32 2 : reg<aie2p.array.scalar : index>
  %offset = constant.u64 0 : reg<aie2p.array.offset : offset>
  %group = group %one
  %worker = worker %group, %zero, @consume
  %input = binding 0, "read"
  %source = sender %input, 0 : reg<aie2p.array.sender : tile<1x1xi32>>
  %first = view.sender %source, %offset : reg<aie2p.array.sender : tile<1xi32>>
  // ERROR@+1: XDNA/023 {view_type="tile<1xi32>", lane="0", lane_count="1", source_type="tile<1xi32>", reason="the source must be one direct binding endpoint"}
  %second = view.sender %first, %offset : reg<aie2p.array.sender : tile<1xi32>>
  %receiver = receiver %worker, 0 : reg<aie2p.array.receiver : tile<1xi32>>
  %channel = channel %second, %receiver, %one, %one : reg<aie2p.array.channel : tile<1xi32>>
  constrain.location %worker, %zero, %two
  return
}

low.func.def target<amd.xdna.aie2p.core>(@core_target) abi(object_function) @consume() asm {
  return
}

