        "test/end_to_end/vector_predicate.loom",
        "test/end_to_end/vector_structure.loom",
    ],
    manifests = ["test/end_to_end/loom-compile.test.json"],
    tags = ["hostonly"],
    tools = {
        "loom-compile": "//loom/src/loom/tools/loom-compile",
