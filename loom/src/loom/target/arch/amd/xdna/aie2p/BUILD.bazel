loom_check_test_suite(
    name = "loom_check_file_test",
    srcs = [
        "test/module_contracts.loom-test",
        "test/source_low/index_conversion.loom-test",
        "test/source_low/memory_scalar_addressing.loom-test",
        "test/source_low/numeric_index.loom-test",
        "test/source_low/numeric_scalar_i32.loom-test",
        "test/source_low/packed_dot_integer.loom-test",
        "test/source_low/packed_i8_arithmetic.loom-test",
        "test/source_low/packed_integer_arithmetic.loom-test",
        "test/source_low/vector_memory.loom-test",
        "test/source_low/vector_predicate.loom-test",
    ],
    data = [
        "//loom/src/loom/test/corpus/source_low:memory_scalar_addressing.loom-test",
        "//loom/src/loom/test/corpus/source_low:numeric_index.loom-test",
        "//loom/src/loom/test/corpus/source_low:numeric_scalar_i32.loom-test",
        "//loom/src/loom/test/corpus/source_low:packed_dot_integer.loom-test",
        "//loom/src/loom/test/corpus/source_low:packed_i8_arithmetic.loom-test",
        "//loom/src/loom/test/corpus/source_low:packed_integer_arithmetic.loom-test",
    ],
    runner = ":loom-check",
    test_name_prefix_to_strip = "test/source_low/",
)

iree_execution_test_suite(
    name = "loom_compile_execution_test",
