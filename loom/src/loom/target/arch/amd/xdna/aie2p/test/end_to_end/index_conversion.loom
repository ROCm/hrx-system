aie2p.target<core> @target

func.def public target(@target) @index_conversion(%flag: i1, %signed_wide0: i64, %unsigned_wide0: i64, %coordinate0: index, %byte_offset0: offset) -> (index, i1, index, offset, i64, i64, offset, index) {
  %signed_wide = scalar.assume %signed_wide0 [range(%signed_wide0, -2147483648, 2147483647)] : i64
  %unsigned_wide = scalar.assume %unsigned_wide0 [range(%unsigned_wide0, 0, 4294967295)] : i64
  %coordinate, %byte_offset = index.assume %coordinate0, %byte_offset0 [range(%coordinate0, 0, 2147483647), range(%byte_offset0, 0, 2147483647)] : index, offset
  %flag_index = index.cast %flag : i1 to index
  %index_low_bit = index.cast %coordinate : index to i1
  %from_i64_index = index.cast %signed_wide : i64 to index
  %from_i64_offset = index.cast %unsigned_wide : i64 to offset
  %to_i64_index = index.cast %coordinate : index to i64
  %to_i64_offset = index.cast %byte_offset : offset to i64
  %as_offset = index.cast %coordinate : index to offset
  %as_index = index.cast %byte_offset : offset to index
  func.return %flag_index, %index_low_bit, %from_i64_index, %from_i64_offset, %to_i64_index, %to_i64_offset, %as_offset, %as_index : index, i1, index, offset, i64, i64, offset, index
}
