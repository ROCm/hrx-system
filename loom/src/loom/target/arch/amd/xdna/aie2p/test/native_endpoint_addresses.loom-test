  %157 = mov.short 0
  %87 = mov.i32 -1
  acq %87, 48
  %held_destination = mov.local-address 458752
  %initial_bias = mov.short 11
  st %initial_bias, %held_destination, 0
  %91 = mov.i32 1
  rel %91, 49
  acq %87, 49
  %record_count = mov.short 3
  %step = mov.short 1
  low.br ^_bb1(%157: reg<aie2p.er>, %157: reg<aie2p.er>, %157: reg<aie2p.er>)
^_bb1(%value: reg<aie2p.er>, %record_read: reg<aie2p.er>, %record_write: reg<aie2p.er>):
  %163 = lt %value, %record_count
  low.cond_br %163, ^_bb2, ^_bb3 : reg<aie2p.er>
^_bb2:
  acq %87, 50
  %164 = mov.short 4
  %165 = mov.short 8
  %166 = add.rr %record_write, %164
  %167 = eq %166, %165
  %168 = copy %167 : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %169 = sel.nez %157, %166, %168
  %record_payload = mov.local-address 458756
  %171 = mov.address-index %record_write
  st.i32.index %value, %record_payload, %171
  rel %91, 51
  acq %87, 51
  %172 = add.rr %record_read, %164
  %173 = eq %172, %165
  %174 = copy %173 : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %175 = sel.nez %157, %172, %174
  acq %87, 52
  %result_destination = mov.local-address 458764
  %177 = mov.address-index %record_read
  %record_value = lda.i32.index %record_payload, %177
  %held_value = lda %held_destination, 0
  %result = add.rr %record_value, %held_value
  st %result, %result_destination, 0
  rel %91, 53
  rel %91, 50
  acq %87, 53
  %next_bias = lda %result_destination, 0
  st %next_bias, %held_destination, 0
  rel %91, 52
  %182 = add.rr %value, %step
  low.br ^_bb1(%182: reg<aie2p.er>, %175: reg<aie2p.er>, %169: reg<aie2p.er>)
^_bb3:
  rel %91, 48
  rel %91, 54
  low.br ^_bb4
^_bb4:
  %83 = mov.ss
  low.br ^_bb4
}

