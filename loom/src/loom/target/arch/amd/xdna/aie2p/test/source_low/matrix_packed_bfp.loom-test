  %170 = vextract.8.imm %107, 54
  %171 = lshl %170, %82
  %172 = or %169, %171
  %173 = vextract.8.imm %107, 63
  %174 = lshl %173, %83
  %175 = or %172, %174
  %rhs_fragment = bfp.exponents.high32.from.scalar %175, %165
  %177 = mova.i32 780
  %product = mmul.bfp16ebs8.m8n8k8 %lhs_fragment, %rhs_fragment, %177
  %179 = slice %product[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %179, %output_aligned, 0
  %180 = slice %product[1] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %180, %output_aligned, 64
  %181 = slice %product[2] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %181, %output_aligned, 128
  %182 = slice %product[3] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %182, %output_aligned, 192
  return
}
