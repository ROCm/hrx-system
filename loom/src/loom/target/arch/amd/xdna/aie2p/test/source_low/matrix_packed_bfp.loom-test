  %80 = lshl %79, %60
  %81 = or %78, %80
  %lhs_fragment = bfp.exponents.high32.from.scalar %81, %71
  %83 = slice %rhs_value[0] : reg<aie2p.vec256 x4> -> reg<aie2p.vec256 x2>
  %84 = slice %rhs_value[2] : reg<aie2p.vec256 x4> -> reg<aie2p.vec256 x2>
  %86 = vshift %83, %84, %20
  %88 = vshift %83, %84, %22
  %90 = select.mask %24, 0
