}

// ====

// Dynamic record coordinates retain the complete byte offset and exact
// 72-byte access; a wider row stride does not widen the memory read.
// RUN: emit source-low output=low

aie2p.target<core> @target

func.def target(@target) @matrix_packed_record(%lhs: buffer, %rhs: buffer, %output: buffer, %record_input: index) {
  %record = index.assume %record_input [range(%record_input, 0, 3)] : index
  %lhs_aligned, %rhs_aligned, %output_aligned = buffer.assume.alignment %lhs, %rhs, %output {minimum_alignment = 64} : buffer, buffer, buffer
  %base = index.constant 0 : offset
  %lhs_view = buffer.view %lhs_aligned[%base] : buffer -> view<4x128xi8>
  %rhs_view = buffer.view %rhs_aligned[%base] : buffer -> view<4x128xi8>
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<8x8xf32>
  %m = index.constant 8 : index
  %n = index.constant 8 : index
  %k = index.constant 8 : index
  %lhs_value = vector.load %lhs_view[%record, 0] : view<4x128xi8> -> vector<72xi8>
  %rhs_value = vector.load %rhs_view[%record, 0] : view<4x128xi8> -> vector<72xi8>
  %schema = encoding.define #encoding.operand<element_format=bfp16ebs8, payload_elements=64, payload_packing=target_fragment, payload_registers=18, rounding=flush_subnormal> : encoding<schema>
  %lhs_fragment = vector.fragment<lhs> %lhs_value shape [%m, %k] using {schema = %schema : encoding<schema>} : vector<72xi8>
  %rhs_fragment = vector.fragment<rhs> %rhs_value shape [%k, %n] using {schema = %schema : encoding<schema>} : vector<72xi8>
  %accumulator_init = vector.splatf 0.0 : vector<64xf32>
  %accumulator_fragment = vector.fragment<init> %accumulator_init shape [%m, %n] : vector<64xf32>
  %product = vector.mma %lhs_fragment, %rhs_fragment, %accumulator_fragment : vector<72xi8>, vector<72xi8>, vector<64xf32>
  vector.fragment.store<result> %product, %output_view[0, 0] shape [%m, %n] : vector<64xf32>, view<8x8xf32>
  func.return
}

