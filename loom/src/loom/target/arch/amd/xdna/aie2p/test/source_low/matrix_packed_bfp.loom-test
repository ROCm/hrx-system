// RUN: emit source-low output=low

aie2p.target<core> @target

func.def target(@target) @matrix_prepacked_bytes(%lhs: buffer, %rhs: buffer, %output: buffer) {
  %lhs_aligned, %rhs_aligned, %output_aligned = buffer.assume.alignment %lhs, %rhs, %output {minimum_alignment = 64} : buffer, buffer, buffer
  %base = index.constant 0 : offset
  %lhs_view = buffer.view %lhs_aligned[%base] : buffer -> view<72xi8>
  %rhs_view = buffer.view %rhs_aligned[%base] : buffer -> view<72xi8>
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<8x8xf32>
  %m = index.constant 8 : index
  %n = index.constant 8 : index
  %k = index.constant 8 : index
  %lhs_value = vector.load %lhs_view[0] : view<72xi8> -> vector<72xi8>
  %rhs_value = vector.load %rhs_view[0] : view<72xi8> -> vector<72xi8>
  %schema = encoding.define #encoding.operand<element_format=bfp16ebs8, payload_elements=64, payload_packing=target_fragment, payload_registers=18, rounding=flush_subnormal> : encoding<schema>
  %lhs_fragment = vector.fragment<lhs> %lhs_value shape [%m, %k] using {schema = %schema : encoding<schema>} : vector<72xi8>
  %rhs_fragment = vector.fragment<rhs> %rhs_value shape [%k, %n] using {schema = %schema : encoding<schema>} : vector<72xi8>
  %accumulator_init = vector.splatf 0.0 : vector<64xf32>
  %accumulator_fragment = vector.fragment<init> %accumulator_init shape [%m, %n] : vector<64xf32>
  %product = vector.mma %lhs_fragment, %rhs_fragment, %accumulator_fragment : vector<72xi8>, vector<72xi8>, vector<64xf32>
  vector.fragment.store<result> %product, %output_view[0, 0] shape [%m, %n] : vector<64xf32>, view<8x8xf32>
  func.return
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @matrix_prepacked_bytes() asm {
  %lhs_aligned = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %rhs_aligned = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %output_aligned = resource<native_pointer> {index = 2, source_type = buffer} : reg<aie2p.ep>
  %24 = vlda.512.i8x64 %lhs_aligned, 0
  %25 = mov.static-byte-offset 64
  %26 = mov.address-index %25
  %27 = lda.i32.index %lhs_aligned, %26
  %28 = mov.static-byte-offset 68
  %29 = mov.address-index %28
  %30 = lda.i32.index %lhs_aligned, %29
  %31 = vbcst.32 %30
  %32 = vinsert.32.zero %31, %27
  %33 = mov.short 1
  %34 = vshift %24, %32, %33
  %35 = mov.short 2
  %36 = vshift %24, %32, %35
  %37 = mov.short 12
  %38 = select.mask %37, 0
  %39 = vsel.32 %34, %36, %38
  %40 = mov.short 3
  %41 = vshift %24, %32, %40
  %42 = mov.short 48
  %43 = select.mask %42, 0
  %44 = vsel.32 %39, %41, %43
  %45 = mov.short 4
  %46 = vshift %24, %32, %45
  %47 = mov.short 192
  %48 = select.mask %47, 0
  %49 = vsel.32 %44, %46, %48
  %50 = mov.short 5
  %51 = vshift %24, %32, %50
  %52 = mov.short 768
  %53 = select.mask %52, 0
  %54 = vsel.32 %49, %51, %53
  %55 = mov.short 6
  %56 = vshift %24, %32, %55
  %57 = mov.i32 3072
  %58 = select.mask %57, 0
  %59 = vsel.32 %54, %56, %58
  %60 = mov.short 7
  %61 = vshift %24, %32, %60
  %62 = mov.i32 12288
  %63 = select.mask %62, 0
  %64 = vsel.32 %59, %61, %63
  %65 = mov.short 8
  %66 = vshift %24, %32, %65
  %67 = mov.i32 49152
  %68 = select.mask %67, 0
  %69 = vsel.32 %64, %66, %68
  %70 = bfp.mantissas.from.vector512 %69
  %72 = mov.short 16
  %73 = mov.short 24
  %74 = vextract.8.imm %24, 0
  %75 = vextract.8.imm %24, 9
  %76 = lshl %75, %65
  %77 = or %74, %76
  %78 = vextract.8.imm %24, 18
  %79 = lshl %78, %72
  %80 = or %77, %79
  %81 = vextract.8.imm %24, 27
  %82 = lshl %81, %73
  %83 = or %80, %82
  %84 = bfp.exponents.low32.from.scalar %83, %70
  %85 = vextract.8.imm %24, 36
  %86 = vextract.8.imm %24, 45
  %87 = lshl %86, %65
  %88 = or %85, %87
  %89 = vextract.8.imm %24, 54
  %90 = lshl %89, %72
  %91 = or %88, %90
  %92 = vextract.8.imm %24, 63
  %93 = lshl %92, %73
  %94 = or %91, %93
  %lhs_fragment = bfp.exponents.high32.from.scalar %94, %84
  %96 = vlda.512.i8x64 %rhs_aligned, 0
  %99 = lda.i32.index %rhs_aligned, %26
  %102 = lda.i32.index %rhs_aligned, %29
  %103 = vbcst.32 %102
  %104 = vinsert.32.zero %103, %99
  %106 = vshift %96, %104, %33
  %108 = vshift %96, %104, %35
  %110 = select.mask %37, 0
  %111 = vsel.32 %106, %108, %110
  %113 = vshift %96, %104, %40
  %115 = select.mask %42, 0
  %116 = vsel.32 %111, %113, %115
  %118 = vshift %96, %104, %45
  %120 = select.mask %47, 0
  %121 = vsel.32 %116, %118, %120
  %123 = vshift %96, %104, %50
  %125 = select.mask %52, 0
  %126 = vsel.32 %121, %123, %125
  %128 = vshift %96, %104, %55
  %130 = select.mask %57, 0
  %131 = vsel.32 %126, %128, %130
  %133 = vshift %96, %104, %60
  %135 = select.mask %62, 0
  %136 = vsel.32 %131, %133, %135
  %138 = vshift %96, %104, %65
  %140 = select.mask %67, 0
  %141 = vsel.32 %136, %138, %140
  %142 = bfp.mantissas.from.vector512 %141
  %146 = vextract.8.imm %96, 0
  %147 = vextract.8.imm %96, 9
  %148 = lshl %147, %65
  %149 = or %146, %148
  %150 = vextract.8.imm %96, 18
  %151 = lshl %150, %72
  %152 = or %149, %151
  %153 = vextract.8.imm %96, 27
  %154 = lshl %153, %73
  %155 = or %152, %154
  %156 = bfp.exponents.low32.from.scalar %155, %142
  %157 = vextract.8.imm %96, 36
  %158 = vextract.8.imm %96, 45
  %159 = lshl %158, %65
  %160 = or %157, %159
  %161 = vextract.8.imm %96, 54
  %162 = lshl %161, %72
  %163 = or %160, %162
  %164 = vextract.8.imm %96, 63
  %165 = lshl %164, %73
  %166 = or %163, %165
  %rhs_fragment = bfp.exponents.high32.from.scalar %166, %156
  %168 = mova.i32 780
  %product = mmul.bfp16ebs8.m8n8k8 %lhs_fragment, %rhs_fragment, %168
  %170 = slice %product[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %170, %output_aligned, 0
  %171 = slice %product[1] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %171, %output_aligned, 64
  %172 = slice %product[2] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %172, %output_aligned, 128
  %173 = slice %product[3] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %173, %output_aligned, 192
  return
}

// ====

// Packed arguments may also have byte-oriented users; constructing a matrix
// operand transfers the payload without changing any of its bits.
// RUN: emit source-low output=low

aie2p.target<core> @target

func.def target(@target) @matrix_packed_value(%lhs_value: vector<72xi8>, %rhs_value: vector<72xi8>, %output: buffer) {
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 64} : buffer
  %base = index.constant 0 : offset
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<8x8xf32>
  %m = index.constant 8 : index
  %n = index.constant 8 : index
  %k = index.constant 8 : index
  %schema = encoding.define #encoding.operand<element_format=bfp16ebs8, payload_elements=64, payload_packing=target_fragment, payload_registers=18, rounding=flush_subnormal> : encoding<schema>
  %lhs_fragment = vector.fragment<lhs> %lhs_value shape [%m, %k] using {schema = %schema : encoding<schema>} : vector<72xi8>
  %rhs_fragment = vector.fragment<rhs> %rhs_value shape [%k, %n] using {schema = %schema : encoding<schema>} : vector<72xi8>
  %accumulator_init = vector.splatf 0.0 : vector<64xf32>
  %accumulator_fragment = vector.fragment<init> %accumulator_init shape [%m, %n] : vector<64xf32>
  %product = vector.mma %lhs_fragment, %rhs_fragment, %accumulator_fragment : vector<72xi8>, vector<72xi8>, vector<64xf32>
  vector.fragment.store<result> %product, %output_view[0, 0] shape [%m, %n] : vector<64xf32>, view<8x8xf32>
  func.return
}


