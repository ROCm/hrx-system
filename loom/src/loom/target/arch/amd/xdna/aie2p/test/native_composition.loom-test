  %44 = mov.local-address 458752
  %48 = mov.local-address 458756
  %value$98 = mov.short 17
  st %value$98, %48, 0
  st %value$98, %44, 0
  %53 = mov.local-address 458760
  %value$101 = lda %44, 0
  %increment = mov.short 29
  %result = add.nc %value$101, %increment
  st %result, %53, 0
  %81 = mov.short 1
  rel %81, 48
  low.br ^_bb1
^_bb1:
  %82 = mov.ss
  low.br ^_bb1
}

low.func.def target<amd.xdna.aie2p.configuration>(@__aie2p_worker_helper_6) @__aie2p_worker_helper_7() asm {
  %83 = constant 2301952 : reg<aie2p.config.scalar : i64>
  %84 = constant 3 : reg<aie2p.config.scalar : i64>
  %85 = constant 2 : reg<aie2p.config.scalar : i64>
  write.mask32 %83, %84, %85
  %86 = constant 0 : reg<aie2p.config.scalar : i64>
  program.load %86, %85, @__aie2p_worker_helper_5
  %87 = constant 12 : reg<aie2p.config.scalar : i64>
  data.reserve %86, %85, %86, %87
  return
}

low.func.def target<amd.xdna.aie2p.configuration>(@__aie2p_worker_helper_6) @__aie2p_worker_helper_8() asm {
  %88 = constant 2224128 : reg<aie2p.config.scalar : i64>
  %89 = constant 0 : reg<aie2p.config.scalar : i64>
  write32 %88, %89
  measure.begin
  %90 = constant 2301952 : reg<aie2p.config.scalar : i64>
  %91 = constant 2 : reg<aie2p.config.scalar : i64>
  write.mask32 %90, %91, %89
  %92 = constant 1 : reg<aie2p.config.scalar : i64>
  write.mask32 %90, %92, %92
  %93 = constant 63 : reg<aie2p.config.scalar : i64>
  wait.mask32 %88, %93, %92
  measure.end
  %94 = constant 3 : reg<aie2p.config.scalar : i64>
  write.mask32 %90, %94, %91
  return
}

low.func.def public retain target<amd.xdna.aie2p.configuration>(@__aie2p_worker_helper_6) abi(array_program) @composed() asm {
  %95 = constant 1 : reg<aie2p.config.scalar : i64>
  entry %95, @__aie2p_worker_helper_7, @__aie2p_worker_helper_8
  return
}

// ====
// RUN: emit source-low @repeated target=amd.xdna.aie2p:amd.xdna.strix.17f0_10 output=low

// Both occurrences advance the same outer FIFO. Its cursors survive calls and
// the runtime backedge, including the third slot's wrap to the first slot.
pipeline.def @exchange() run(%records: channel<tile<1xi32>>, %output: buffer, %iteration: index) {
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %write, %destination = channel.reserve %records : channel<tile<1xi32>> -> (write<tile<1xi32>>, view<1xi32>)
    %value = index.cast %iteration : index to i32
    view.store %value, %destination[0] : i32, view<1xi32>
    channel.publish %write : write<tile<1xi32>>
    %read, %source = channel.acquire %records : channel<tile<1xi32>> -> (read<tile<1xi32>>, view<1xi32>)
    %result = view.load %source[0] : view<1xi32> -> i32
    %origin = index.constant 0 : offset
    %result_view = buffer.view %output[%origin] : buffer -> view<1xi32>
    view.store %result, %result_view[0] : i32, view<1xi32>
    channel.release %read : read<tile<1xi32>>
  }
}

pipeline.def<kernel> public retain @repeated() run() {
  %memory = pipeline.memory<workgroup>[0, 2] : pool
  %capacity = index.constant 3 : index
  %payload_bytes = index.constant 12 : offset
  %result_bytes = index.constant 4 : offset
  %origin = index.constant 0 : offset
  %storage = buffer.alloca<workgroup> pool(%memory) align(4) %payload_bytes : buffer
  %output = buffer.alloca<workgroup> pool(%memory) align(4) %result_bytes : buffer
  %slots = buffer.view %storage[%origin] : buffer -> view<3x1xi32>
  %records = channel.bind<fifo> %slots, %capacity : view<3x1xi32>, index -> channel<tile<1xi32>>
  %initial = index.constant 0 : index
  %limit = index.constant 5 : index
  %step = index.constant 1 : index
  pipeline.serial {
    scf.for %iteration = [%initial to %limit step %step] {
      pipeline.compose @exchange(%records, %output, %iteration) : (channel<tile<1xi32>>, buffer, index)
      pipeline.compose @exchange(%records, %output, %iteration) : (channel<tile<1xi32>>, buffer, index)
    }
  }
}

