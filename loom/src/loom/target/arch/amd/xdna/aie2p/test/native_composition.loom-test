// RUN: emit source-low @composed target=amd.xdna.aie2p:amd.xdna.strix.17f0_10 output=low

// Ordered children share one physical core. Their distinct storage survives
// preparation, and the complete program owns one start and completion.
aie2p.target<array> @device {device_profile = "amd.xdna.strix.17f0_10"}

pipeline.def @write_shared() run(%memory: pool, %shared: buffer) {
  %bytes = index.constant 4 : offset
  %origin = index.constant 0 : offset
  %storage = buffer.alloca<workgroup> pool(%memory) align(4) %bytes : buffer
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %local = buffer.view %storage[%origin] : buffer -> view<1xi32>
    %outer = buffer.view %shared[%origin] : buffer -> view<1xi32>
    %value = scalar.constant 17 : i32
    view.store %value, %local[0] : i32, view<1xi32>
    view.store %value, %outer[0] : i32, view<1xi32>
  }
}

pipeline.def @read_shared() run(%memory: pool, %shared: buffer) {
  %bytes = index.constant 4 : offset
  %origin = index.constant 0 : offset
  %storage = buffer.alloca<workgroup> pool(%memory) align(4) %bytes : buffer
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %local = buffer.view %storage[%origin] : buffer -> view<1xi32>
    %outer = buffer.view %shared[%origin] : buffer -> view<1xi32>
    %value = view.load %outer[0] : view<1xi32> -> i32
    %increment = scalar.constant 29 : i32
    %result = scalar.addi %value, %increment : i32
    view.store %result, %local[0] : i32, view<1xi32>
  }
}

pipeline.def<kernel> public retain target(@device) @composed() run() {
  %memory = pipeline.memory<workgroup>[0, 2] : pool
  %bytes = index.constant 4 : offset
  %storage = buffer.alloca<workgroup> pool(%memory) align(4) %bytes : buffer
  pipeline.serial {
    pipeline.compose @write_shared(%memory, %storage) : (pool, buffer)
    pipeline.compose @read_shared(%memory, %storage) : (pool, buffer)
  }
}

