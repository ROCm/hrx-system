low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @scalar_f32_carrier(%lhs: reg<aie2p.er>, %rhs: reg<aie2p.er>) -> (reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>) asm {
  %bias = mov.i32 1069547520
  %15 = vbcst.32 %lhs
  %16 = vbcst.32 %bias
  %17 = vmov.vector512.to.accumulator512.low %15
  %18 = vmov.vector512.to.accumulator512.low %16
  %19 = mova.i32 60
  %20 = vadd.f32x16 %17, %18, %19
  %21 = slice %20[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %22 = vmov.accumulator512.to.vector512 %21
  %sum = vextract.32.imm %22, 0
  %24 = vbcst.32 %sum
  %25 = vbcst.32 %rhs
  %26 = vmov.vector512.to.accumulator512.low %24
  %27 = vmov.vector512.to.accumulator512.low %25
  %29 = vsub.f32x16 %26, %27, %19
  %30 = slice %29[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %31 = vmov.accumulator512.to.vector512 %30
  %bits = vextract.32.imm %31, 0
  return %sum, %bits, %bits
}

