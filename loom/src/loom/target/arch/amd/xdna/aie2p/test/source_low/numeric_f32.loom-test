// RUN: emit source-low output=low

aie2p.target<core> @target

func.def target(@target) @reciprocal_strict(%input: f32) -> (f32) {
  %numerator = scalar.constant 1.0 : f32
  // ERROR@+1: LOWERING/036 {op_name="scalar.divf", phase_name="legalize-math", policy_name="aie2p-math", math_op="divf", lane_domain="scalar", element_type="f32", constraint_key="math.div.arcp"}
  %result = scalar.divf %numerator, %input : f32
  func.return %result : f32
}

