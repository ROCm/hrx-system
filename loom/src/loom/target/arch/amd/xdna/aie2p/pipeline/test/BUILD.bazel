load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")
load("//loom/build_tools/bazel:defs.bzl", "loom_execution_profile", "loom_test", "loom_test_module")
load("//loom/build_tools/bazel:loom_check.bzl", "loom_check_test_suite")
load("//loom/target/amd/xdna:execution_profiles.bzl", "XDNA_HARDWARE_PROFILE")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

loom_check_test_suite(
    name = "lowering_test",
    srcs = [
        "child_distribution.loom-test",
        "child_join.loom-test",
        "dma_submit_sharing.loom-test",
        "external_metadata.loom-test",
        "join_sharing.loom-test",
        "shared_entry_calls.loom-test",
    ],
    target_compatible_with = loom_config_compatible_with(["//loom/config/arch:aie2p"]),
)

loom_check_test_suite(
    name = "source_admission_test",
    srcs = ["retained_capacity.cxx-test"],
    target_compatible_with = loom_config_compatible_with([
        "//loom/config/arch:aie2p",
        "//loom/config/import:cxx",
    ]),
)

_XDNA_ONE_COLUMN_PROFILE = loom_execution_profile(
    name = "xdna_one_column",
    build_requirements = XDNA_HARDWARE_PROFILE.build_requirements,
    executor = XDNA_HARDWARE_PROFILE.executor,
    resource_group = XDNA_HARDWARE_PROFILE.resource_group,
    run_requirements = XDNA_HARDWARE_PROFILE.run_requirements,
    runner_args = ["--device=xdna://0?columns=1"],
    target_class = XDNA_HARDWARE_PROFILE.target_class,
    target_family = XDNA_HARDWARE_PROFILE.target_family,
)

_XDNA_TWO_COLUMN_PROFILE = loom_execution_profile(
    name = "xdna_two_columns",
    build_requirements = XDNA_HARDWARE_PROFILE.build_requirements,
    executor = XDNA_HARDWARE_PROFILE.executor,
    resource_group = XDNA_HARDWARE_PROFILE.resource_group,
    run_requirements = XDNA_HARDWARE_PROFILE.run_requirements,
    runner_args = ["--device=xdna://0?columns=2"],
    target_class = XDNA_HARDWARE_PROFILE.target_class,
    target_family = XDNA_HARDWARE_PROFILE.target_family,
)

_XDNA_THREE_COLUMN_PROFILE = loom_execution_profile(
    name = "xdna_three_columns",
    build_requirements = XDNA_HARDWARE_PROFILE.build_requirements,
    executor = XDNA_HARDWARE_PROFILE.executor,
    resource_group = XDNA_HARDWARE_PROFILE.resource_group,
    run_requirements = XDNA_HARDWARE_PROFILE.run_requirements,
    runner_args = ["--device=xdna://0?columns=3"],
    target_class = XDNA_HARDWARE_PROFILE.target_class,
    target_family = XDNA_HARDWARE_PROFILE.target_family,
)

loom_test(
    name = "one_column_test",
    srcs = [
        "child_cursors.loom",
        "collective_cursors.loom",
        "concurrent_distribution.loom",
        "finite_ingress.loom",
        "ordered_prefix.loom",
        "ordered_replay.loom",
        "partial_record.loom",
        "retained_lifetime.loom",
        "retained_replay.loom",
        "single_slot.loom",
    ],
    benchmark_smoke = False,
    execution_profiles = [_XDNA_ONE_COLUMN_PROFILE],
    target_compatible_with = loom_config_compatible_with(["//loom/config/execute:vm_iree_vm"]),
)

loom_test(
    name = "two_column_test",
    srcs = [
        "channel_fanout.loom",
        "joined_phases.loom",
        "packet_phases.loom",
        "retained_handoff.loom",
    ],
    benchmark_smoke = False,
    execution_profiles = [_XDNA_TWO_COLUMN_PROFILE],
    target_compatible_with = loom_config_compatible_with(["//loom/config/execute:vm_iree_vm"]),
)

loom_test_module(
    name = "channel_sram_module",
    srcs = ["channel_sram.loom"],
)

loom_test(
    name = "rotating_sram_test",
    benchmark_smoke = False,
    case = "rotating_four_row_sram_handoff",
    execution_profiles = [_XDNA_THREE_COLUMN_PROFILE],
    module = ":channel_sram_module",
    target_compatible_with = loom_config_compatible_with(["//loom/config/execute:vm_iree_vm"]),
)

loom_test(
    name = "terminal_prefetch_test",
    benchmark_smoke = False,
    case = "terminal_prefetch_replay",
    execution_profiles = [_XDNA_ONE_COLUMN_PROFILE],
    module = ":channel_sram_module",
    target_compatible_with = loom_config_compatible_with(["//loom/config/execute:vm_iree_vm"]),
)
