// ====

// RUN: emit source-low output=low

// A repeated two-descriptor chain fits within three task entries.
// A finite stream crosses compute -> SRAM -> compute storage. The tasks are
// queued before completion waits, and every descriptor owns one FIFO credit.
aie2p.target<array> @device {device_profile = "amd.xdna.strix.17f0_10"}

pipeline.def<kernel> public retain target(@device) @finite_stream() run(%output_arg: buffer) {
  %output = buffer.assume.alignment %output_arg {minimum_alignment = 4} : buffer
  %origin = index.constant 0 : offset
  %bytes = index.constant 4 : offset
  %capacity = index.constant 1 : index
  %begin = index.constant 0 : index
  %end = index.constant 1120 : index
  %step = index.constant 1 : index
  %record_bytes = index.constant 4 : index
  %source_memory = pipeline.memory<workgroup>[0, 2] : pool
  %relay_memory = pipeline.memory<workgroup>[0, 1] : pool
  %destination_memory = pipeline.memory<workgroup>[0, 3] : pool
  %source_storage = buffer.alloca<workgroup> pool(%source_memory) align(4) %bytes : buffer
  %source_slots = buffer.view %source_storage[%origin] : buffer -> view<1x1xi32>
  %source = channel.bind<fifo> %source_slots, %capacity : view<1x1xi32>, index -> channel<tile<1xi32>>
  %relay_storage = buffer.alloca<workgroup> pool(%relay_memory) align(4) %bytes : buffer
  %relay_slots = buffer.view %relay_storage[%origin] : buffer -> view<1x1xi32>
  %relay = channel.bind<fifo> %relay_slots, %capacity : view<1x1xi32>, index -> channel<tile<1xi32>>
  %destination_storage = buffer.alloca<workgroup> pool(%destination_memory) align(4) %bytes : buffer
  %destination_slots = buffer.view %destination_storage[%origin] : buffer -> view<1x1xi32>
  %destination = channel.bind<fifo> %destination_slots, %capacity : view<1x1xi32>, index -> channel<tile<1xi32>>
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    scf.for %record = [%begin to %end step %step] {
      %write, %payload = channel.reserve %source : channel<tile<1xi32>> -> (write<tile<1xi32>>, view<1xi32>)
      %value = index.cast %record : index to i32
      view.store %value, %payload[0] : i32, view<1xi32>
      channel.publish %write : write<tile<1xi32>>
    }
  }
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    scf.for %record = [%begin to %end step %step] {
