// ====

// Communication and arithmetic share one tile without reserving a transfer
// core. The grouped ingress and egress each use one descriptor chain while
// preserving the independent channel credits carried by every member. The
// 63-slot channels also exercise initial reservation at the hardware credit
// limit without overflowing on release.
aie2p.target<array> @device {device_profile = "amd.xdna.strix.17f0_10"}

pipeline.def<kernel> public retain target(@device) @pairwise_sum_difference() run(%input_arg: buffer, %output_arg: buffer) {
  %input, %output = buffer.assume.alignment %input_arg, %output_arg {minimum_alignment = 4} : buffer, buffer
  %memory = pipeline.memory<workgroup>[0, 2] : pool
  %bytes = index.constant 252 : offset
  %origin = index.constant 0 : offset
  %next_word = index.constant 4 : offset
  %capacity = index.constant 63 : index
  %left_storage = buffer.alloca<workgroup> pool(%memory) align(4) %bytes : buffer
  %left_records = buffer.view %left_storage[%origin] : buffer -> view<63x1xi32>
  %left = channel.bind<fifo> %left_records, %capacity : view<63x1xi32>, index -> channel<tile<1xi32>>
  %right_storage = buffer.alloca<workgroup> pool(%memory) align(4) %bytes : buffer
  %right_records = buffer.view %right_storage[%origin] : buffer -> view<63x1xi32>
  %right = channel.bind<fifo> %right_records, %capacity : view<63x1xi32>, index -> channel<tile<1xi32>>
  %sum_storage = buffer.alloca<workgroup> pool(%memory) align(4) %bytes : buffer
  %sum_records = buffer.view %sum_storage[%origin] : buffer -> view<63x1xi32>
  %sums = channel.bind<fifo> %sum_records, %capacity : view<63x1xi32>, index -> channel<tile<1xi32>>
  %difference_storage = buffer.alloca<workgroup> pool(%memory) align(4) %bytes : buffer
  %difference_records = buffer.view %difference_storage[%origin] : buffer -> view<63x1xi32>
  %differences = channel.bind<fifo> %difference_records, %capacity : view<63x1xi32>, index -> channel<tile<1xi32>>
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %external_left = buffer.view %input[%origin] : buffer -> view<1xi32>
    %external_right = buffer.view %input[%next_word] : buffer -> view<1xi32>
    %left_write, %left_destination = channel.reserve %left : channel<tile<1xi32>> -> (write<tile<1xi32>>, view<1xi32>)
    %right_write, %right_destination = channel.reserve %right : channel<tile<1xi32>> -> (write<tile<1xi32>>, view<1xi32>)
    %left_copy = kernel.async.copy %external_left to %left_destination {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<1xi32> to view<1xi32> -> kernel.async.token
    %right_copy = kernel.async.copy %external_right to %right_destination {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<1xi32> to view<1xi32> -> kernel.async.token
    %incoming = kernel.async.group %left_copy, %right_copy : kernel.async.token, kernel.async.token -> kernel.async.group
    kernel.async.wait %incoming {newer_groups = 0} : kernel.async.group
    channel.publish %left_write : write<tile<1xi32>>
    channel.publish %right_write : write<tile<1xi32>>
    %sum_read, %sum_source = channel.acquire %sums : channel<tile<1xi32>> -> (read<tile<1xi32>>, view<1xi32>)
    %difference_read, %difference_source = channel.acquire %differences : channel<tile<1xi32>> -> (read<tile<1xi32>>, view<1xi32>)
    %external_sum = buffer.view %output[%origin] : buffer -> view<1xi32>
    %external_difference = buffer.view %output[%next_word] : buffer -> view<1xi32>
    %sum_copy = kernel.async.copy %sum_source to %external_sum {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<1xi32> to view<1xi32> -> kernel.async.token
    %difference_copy = kernel.async.copy %difference_source to %external_difference {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<1xi32> to view<1xi32> -> kernel.async.token
    %outgoing = kernel.async.group %sum_copy, %difference_copy : kernel.async.token, kernel.async.token -> kernel.async.group
    kernel.async.wait %outgoing {newer_groups = 0} : kernel.async.group
    channel.release %sum_read : read<tile<1xi32>>
    channel.release %difference_read : read<tile<1xi32>>
  }
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %left_read, %left_source = channel.acquire %left : channel<tile<1xi32>> -> (read<tile<1xi32>>, view<1xi32>)
    %right_read, %right_source = channel.acquire %right : channel<tile<1xi32>> -> (read<tile<1xi32>>, view<1xi32>)
    %left_value = view.load %left_source[0] : view<1xi32> -> i32
    %right_value = view.load %right_source[0] : view<1xi32> -> i32
    %sum_value = scalar.addi %left_value, %right_value : i32
    %difference_value = scalar.subi %left_value, %right_value : i32
    channel.release %left_read : read<tile<1xi32>>
    channel.release %right_read : read<tile<1xi32>>
    %sum_write, %sum_destination = channel.reserve %sums : channel<tile<1xi32>> -> (write<tile<1xi32>>, view<1xi32>)
    %difference_write, %difference_destination = channel.reserve %differences : channel<tile<1xi32>> -> (write<tile<1xi32>>, view<1xi32>)
    view.store %sum_value, %sum_destination[0] : i32, view<1xi32>
    view.store %difference_value, %difference_destination[0] : i32, view<1xi32>
    channel.publish %sum_write : write<tile<1xi32>>
    channel.publish %difference_write : write<tile<1xi32>>
  }
}

