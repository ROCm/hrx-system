pipeline.def<kernel> public retain target(@device) @partial_record_core_control() run(%input: buffer, %output: buffer) {
  %row = index.constant 2 : index
  %compute = scalar.constant true : i1
  pipeline.compose @partial_record[%row, %compute](%input, %output) : [index, i1](buffer, buffer)
}

func.def @core_control_reference(%input: buffer, %output: buffer) {
  %bias = scalar.constant 17 : i32
  func.call @reference(%input, %output, %bias) : (buffer, buffer, i32)
  func.return
}

check.scenario public @core_control_partial_record {
  check.trial[3](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
