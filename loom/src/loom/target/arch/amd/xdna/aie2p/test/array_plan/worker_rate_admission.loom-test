  %one = constant.u32 1 : reg<aie2p.array.scalar : index>
  %two = constant.u32 2 : reg<aie2p.array.scalar : index>
  %three = constant.u32 3 : reg<aie2p.array.scalar : index>
  %group = group %one
  %worker = worker %group, %zero, @idle
  %input = binding 0, "read"
  %output = binding 1, "write"
  %input_sender = sender %input, 0 : reg<aie2p.array.sender : tile<1xf32>>
  %worker_receiver = receiver %worker, 0 : reg<aie2p.array.receiver : tile<1xf32>>
  %worker_sender = sender %worker, 1 : reg<aie2p.array.sender : tile<1xf32>>
  %output_receiver = receiver %output, 0 : reg<aie2p.array.receiver : tile<1xf32>>
  %input_channel = channel %input_sender, %worker_receiver, %one, %two : reg<aie2p.array.channel : tile<1xf32>>
