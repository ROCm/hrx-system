aie2p.target<array> @device {device_profile = "amd.xdna.strix_halo.17f0_11"}

// Both explicit carry values must survive until their dependent additions.
// The single architectural carry register cannot hold these overlapping values.
low.func.def noinline schedule(locked) target<amd.xdna.aie2p.core> @exhaust_carry(%value: reg<aie2p.er>, %address: reg<aie2p.ep>) asm {
  %sum0, %carry0 = add.carry %value, %value
  %sum1, %carry1 = add.carry %sum0, %value
  %result0, %discard0 = adc %sum1, %value, %carry0
  %result1, %discard1 = adc %result0, %value, %carry1
  st %result0, %address, 0
  st %result1, %address, 4
  return
}

// The source worker retains a large lowering before its direct helper rejects.
// Report consumers must still receive that source-level expansion evidence.
pipeline.def<kernel> public retain target(@device) @failed_helper_report() run() {
  %core = pipeline.memory<workgroup>[0, 3] : pool
  %bytes = index.constant 64 : offset
  %scratch = buffer.alloca<workgroup> pool(%core) align(64) %bytes : buffer
  pipeline.strand workers([0, 3], [1, 1], [1, 1]) {
    %begin = index.constant 1 : index
    %end = index.constant 3 : index
    %step = index.constant 1 : index
    scf.for %index = [%begin to %end step %step] {
      %integer = index.cast %index : index to i32
      %value = scalar.sitofp %integer : i32 to f32
      %product = scalar.mulf %value, %value : f32
      low.invoke @exhaust_carry(%product, %scratch) : (f32, buffer)
    }
  }
}
