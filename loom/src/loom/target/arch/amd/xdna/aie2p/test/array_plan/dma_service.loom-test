// RUN: emit aie2p-array-plan @neighbor_dma_service_array

// Input streams exceeding a core's DMA capacity use neighboring service tiles.

aie2p.target<array> @neighbor_dma_service_array_target

aie2p.target<core> @neighbor_dma_service_core_target

low.func.def public retain target<amd.xdna.aie2p.array>(@neighbor_dma_service_array_target) abi(array_program) @neighbor_dma_service_array() asm {
  %lanes = constant.u32 1 : reg<aie2p.array.scalar : index>
  %lane = constant.u32 0 : reg<aie2p.array.scalar : index>
  %capacity = constant.u32 2 : reg<aie2p.array.scalar : index>
  %records = constant.u32 1 : reg<aie2p.array.scalar : index>
  %column = constant.u32 0 : reg<aie2p.array.scalar : index>
  %consumer_row = constant.u32 2 : reg<aie2p.array.scalar : index>
  %producer_row = constant.u32 4 : reg<aie2p.array.scalar : index>

  %consumer_group = group %lanes
  %producer_group = group %lanes
  %consumer = worker %consumer_group, %lane, @add_four_inputs
  %producer = worker %producer_group, %lane, @produce_byte

  %input0 = binding 0, "read"
  %input1 = binding 1, "read"
  %input2 = binding 2, "read"
  %output = binding 3, "write"
  %input0_sender = sender %input0, 0 : reg<aie2p.array.sender : tile<4xi8>>
  %input1_sender = sender %input1, 0 : reg<aie2p.array.sender : tile<4xi8>>
  %input2_sender = sender %input2, 0 : reg<aie2p.array.sender : tile<4xi8>>
  %output_receiver = receiver %output, 0 : reg<aie2p.array.receiver : tile<4xi8>>
  %producer_output = sender %producer, 0 : reg<aie2p.array.sender : tile<4xi8>>
  %consumer_input0 = receiver %consumer, 0 : reg<aie2p.array.receiver : tile<4xi8>>
  %consumer_input1 = receiver %consumer, 1 : reg<aie2p.array.receiver : tile<4xi8>>
  %consumer_input2 = receiver %consumer, 2 : reg<aie2p.array.receiver : tile<4xi8>>
  %consumer_input3 = receiver %consumer, 3 : reg<aie2p.array.receiver : tile<4xi8>>
  %consumer_output = sender %consumer, 4 : reg<aie2p.array.sender : tile<4xi8>>
  %input0_channel = channel %input0_sender, %consumer_input0, %capacity, %records : reg<aie2p.array.channel : tile<4xi8>>
  %input1_channel = channel %input1_sender, %consumer_input1, %capacity, %records : reg<aie2p.array.channel : tile<4xi8>>
  %input2_channel = channel %input2_sender, %consumer_input2, %capacity, %records : reg<aie2p.array.channel : tile<4xi8>>
  %internal_channel = channel %producer_output, %consumer_input3, %capacity, %records : reg<aie2p.array.channel : tile<4xi8>>
  %output_channel = channel %consumer_output, %output_receiver, %capacity, %records : reg<aie2p.array.channel : tile<4xi8>>

  constrain.location %consumer, %column, %consumer_row
  constrain.location %producer, %column, %producer_row
  return
}

low.func.def target<amd.xdna.aie2p.core>(@neighbor_dma_service_core_target) abi(object_function) @add_four_inputs() asm {
  %input0 = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %input1 = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %input2 = resource<native_pointer> {index = 2, source_type = buffer} : reg<aie2p.ep>
  %input3 = resource<native_pointer> {index = 3, source_type = buffer} : reg<aie2p.ep>
  %output = resource<native_pointer> {index = 4, source_type = buffer} : reg<aie2p.ep>
  %value0 = lda.u8 %input0, 0
  %value1 = lda.u8 %input1, 0
  %value2 = lda.u8 %input2, 0
  %value3 = lda.u8 %input3, 0
  %sum01 = add.rr %value0, %value1
  %sum012 = add.rr %sum01, %value2
  %sum0123 = add.rr %sum012, %value3
  st.s8 %sum0123, %output, 0
  return
}

low.func.def target<amd.xdna.aie2p.core>(@neighbor_dma_service_core_target) abi(object_function) @produce_byte() asm {
  %output = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %value = mov.short 4
  st.s8 %value, %output, 0
  return
}

