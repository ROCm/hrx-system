// RUN: emit source-low target=amd.xdna.aie2p:core output=low

func.def @exact_bf16_accumulator_conversion(%lhs: vector<16xbf16>, %rhs: vector<16xbf16>) -> (vector<16xbf16>) {
  %lhs_wide = vector.extf %lhs : vector<16xbf16> to vector<16xf32>
  %rhs_wide = vector.extf %rhs : vector<16xbf16> to vector<16xf32>
  %sum = vector.addf %lhs_wide, %rhs_wide : vector<16xf32>
  %result = vector.fptrunc %sum : vector<16xf32> to vector<16xbf16>
  func.return %result : vector<16xbf16>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @exact_bf16_accumulator_conversion(%lhs: reg<aie2p.vec256 x2>, %rhs: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  set.saturation 0
  set.ups-mode 0
  %10 = mov.shift 16
  %11 = slice %lhs[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %12 = vups.2x.w-to-b.unsigned %11, %10
  %lhs_wide = copy %12 : reg<aie2p.mbms> -> reg<aie2p.ebmll>
  %15 = slice %rhs[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %16 = vups.2x.w-to-b.unsigned %15, %10
  %rhs_wide = copy %16 : reg<aie2p.mbms> -> reg<aie2p.ebmll>
  %18 = mova.i32 60
  %19 = vadd.f32x16 %lhs_wide, %rhs_wide, %18
  %20 = slice %19[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %sum = copy %20 : reg<aie2p.mbms> -> reg<aie2p.ebmll>
  %22 = copy %sum : reg<aie2p.ebmll> -> reg<aie2p.mbms>
  %23 = vmov.accumulator512.to.vector512 %22
  set.rounding 0
  set.srs-mode 0
  %24 = mov.short 1
  %25 = vbcst.32 %24
  %26 = mov.i32 32767
  %27 = vbcst.32 %26
  %28 = mov.i32 2147483647
  %29 = vbcst.32 %28
  %30 = mov.i32 2139095040
  %31 = vbcst.32 %30
  %32 = mov.i32 4194304
  %33 = vbcst.32 %32
  set.ups-mode 1
  set.srs-mode 1
  %34 = mov.shift 0
  %35 = vups.2x.x-to-c.unsigned %23, %34
  %37 = vsrs.2x.c-to-x.unsigned %35, %10
  %38 = vband %37, %25
  %39 = vadd.32 %27, %38
  %40 = vadd.32 %23, %39
  %41 = vband %23, %29
  %42 = vlt.u32x16.el.low32 %31, %41
  %43 = predicate.complete.zero.high32 %42, 0
  %44 = vbor %23, %33
  %45 = vsel.32.mask64 %40, %44, %43
  set.srs-mode 0
  %46 = slice %45[1] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %47 = vmov.vector512.to.accumulator512 %45
  %48 = vsrs.2x.b-to-w.unsigned %47, %10
  %result = concat(%48, %46) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  return %result
}
