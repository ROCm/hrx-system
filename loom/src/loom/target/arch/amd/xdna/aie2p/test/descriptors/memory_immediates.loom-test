// Accumulator loads use signed 10-bit byte offsets aligned to 64 bytes.
// RUN: verify

low.func.def target<amd.xdna.aie2p.core> @bounds(%pointer: reg<aie2p.ep>) -> (reg<aie2p.mbms>, reg<aie2p.mbms>) asm {
  %minimum = vlda.acc %pointer, -512
  %maximum = vlda.acc %pointer, 448
  return %minimum, %maximum
}

// ====

// The compiler pipeline must reject authored operands before cleanup can erase
// their unused results.
// RUN: emit source-low

aie2p.target<core> @target

low.func.def retain target<amd.xdna.aie2p.core>(@target) @unused_overflow(%pointer: reg<aie2p.ep>) asm {
  // ERROR@+1: STRUCTURE/014 "imm" "512"
  %unused = vlda.acc %pointer, 512
  return
}

// ====

// Binding the target selects cleanup. Legal unused constants and loads vanish.
// RUN: emit source-low

aie2p.target<core> @target

low.func.def retain target<amd.xdna.aie2p.core>(@target) @unused_in_range(%pointer: reg<aie2p.ep>) asm {
  %constant = mova.i32 1023
  %accumulator = vlda.acc %pointer, 448
  %byte = lda.u8 %pointer, 7
  %scalar = lda %pointer, 28
  return
}

// ----
aie2p.target<core> @target

low.func.def retain target<amd.xdna.aie2p.core>(@target) @unused_in_range(%pointer: reg<aie2p.ep>) asm {
  return
}

// ====

// RUN: verify

low.func.def target<amd.xdna.aie2p.core> @overflow(%pointer: reg<aie2p.ep>) asm {
  // ERROR@+1: STRUCTURE/014 "imm" "512"
  %unused = vlda.acc %pointer, 512
  return
}

// ====

low.func.def target<amd.xdna.aie2p.core> @underflow(%pointer: reg<aie2p.ep>) asm {
  // ERROR@+1: STRUCTURE/014 "imm" "-576"
  %unused = vlda.acc %pointer, -576
  return
}

// ====

low.func.def target<amd.xdna.aie2p.core> @misaligned(%pointer: reg<aie2p.ep>) asm {
  // ERROR@+1: STRUCTURE/014 "imm" "1"
  %unused = vlda.acc %pointer, 1
  return
}

// ====

// Byte loads use signed 4-bit byte offsets.
low.func.def target<amd.xdna.aie2p.core> @byte_load_bounds(%pointer: reg<aie2p.ep>) -> (reg<aie2p.er>, reg<aie2p.er>) asm {
  %minimum = lda.u8 %pointer, -8
  %maximum = lda.u8 %pointer, 7
  return %minimum, %maximum
}

// ====

// RUN: emit source-low

aie2p.target<core> @target

low.func.def retain target<amd.xdna.aie2p.core>(@target) @unused_byte_load_overflow(%pointer: reg<aie2p.ep>) asm {
  // ERROR@+1: STRUCTURE/014 "imm" "8"
  %unused = lda.u8 %pointer, 8
  return
}

// ====

low.func.def target<amd.xdna.aie2p.core> @byte_load_underflow(%pointer: reg<aie2p.ep>) -> (reg<aie2p.er>) asm {
  // ERROR@+1: STRUCTURE/014 "imm" "-9"
  %value = lda.u8 %pointer, -9
  return %value
}

// ====

// Scalar data registers cannot substitute for pointer registers.
low.func.def target<amd.xdna.aie2p.core> @scalar_pointer(%pointer: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  // ERROR@+1: TYPE/003 "ptr" "aie2p.ep"
  %value = lda.volatile %pointer, 0
  return %value
}

// ====

// The same register-class contract applies before unused loads are removed.
// RUN: emit source-low

aie2p.target<core> @target

low.func.def retain target<amd.xdna.aie2p.core>(@target) @unused_scalar_pointer(%pointer: reg<aie2p.er>) asm {
  // ERROR@+1: TYPE/003 "ptr" "aie2p.ep"
  %unused = lda %pointer, 0
  return
}

// ====

// Scalar stores use signed 6-bit byte offsets aligned to 4 bytes.
low.func.def target<amd.xdna.aie2p.core> @scalar_store_bounds(%pointer: reg<aie2p.ep>, %value: reg<aie2p.er>) asm {
  st %value, %pointer, -32
  st %value, %pointer, 28
  return
}

// ====

// RUN: emit source-low

aie2p.target<core> @target

low.func.def retain target<amd.xdna.aie2p.core>(@target) @scalar_store_overflow(%pointer: reg<aie2p.ep>, %value: reg<aie2p.er>) asm {
  // ERROR@+1: STRUCTURE/014 "imm" "32"
  st %value, %pointer, 32
  return
}

// ====

low.func.def target<amd.xdna.aie2p.core> @scalar_store_underflow(%pointer: reg<aie2p.ep>, %value: reg<aie2p.er>) asm {
  // ERROR@+1: STRUCTURE/014 "imm" "-36"
  st %value, %pointer, -36
  return
}

// ====

low.func.def target<amd.xdna.aie2p.core> @scalar_store_misaligned(%pointer: reg<aie2p.ep>, %value: reg<aie2p.er>) asm {
  // ERROR@+1: STRUCTURE/014 "imm" "2"
  st %value, %pointer, 2
  return
}

// ====

// Accumulator stores share the signed 10-bit, 64-byte-aligned load offsets.
low.func.def target<amd.xdna.aie2p.core> @accumulator_store_bounds(%pointer: reg<aie2p.ep>, %value: reg<aie2p.mbms>) asm {
  vst.acc %value, %pointer, -512
  vst.acc %value, %pointer, 448
  return
}

// ====

// RUN: emit source-low

aie2p.target<core> @target

low.func.def retain target<amd.xdna.aie2p.core>(@target) @accumulator_store_overflow(%pointer: reg<aie2p.ep>, %value: reg<aie2p.mbms>) asm {
  // ERROR@+1: STRUCTURE/014 "imm" "512"
  vst.acc %value, %pointer, 512
  return
}

// ====

low.func.def target<amd.xdna.aie2p.core> @accumulator_store_underflow(%pointer: reg<aie2p.ep>, %value: reg<aie2p.mbms>) asm {
  // ERROR@+1: STRUCTURE/014 "imm" "-576"
  vst.acc %value, %pointer, -576
  return
}

// ====

low.func.def target<amd.xdna.aie2p.core> @accumulator_store_misaligned(%pointer: reg<aie2p.ep>, %value: reg<aie2p.mbms>) asm {
  // ERROR@+1: STRUCTURE/014 "imm" "1"
  vst.acc %value, %pointer, 1
  return
}

// ====

// A 128-bit load defines fresh W storage without a preserved input. A possibly
// aliasing store invalidates the memory read.
// RUN: with-low-asm pass low-cse,low-dce

low.func.def target<amd.xdna.aie2p.core> @fresh_vector_loads(%pointer: reg<aie2p.ep>, %output: reg<aie2p.ep>) -> (reg<aie2p.vec256>, reg<aie2p.vec256>, reg<aie2p.vec256>) asm {
  %first = vlda.128.i32x4 %pointer, 16
  %same = vlda.128.i32x4 %pointer, 16
  vst.128.i32x4 %first, %output, 0
  %after = vlda.128.i32x4 %pointer, 16
  return %first, %same, %after
}

// ----
low.func.def target<amd.xdna.aie2p.core> @fresh_vector_loads(%pointer: reg<aie2p.ep>, %output: reg<aie2p.ep>) -> (reg<aie2p.vec256>, reg<aie2p.vec256>, reg<aie2p.vec256>) asm {
  %first = vlda.128.i32x4 %pointer, 16
  vst.128.i32x4 %first, %output, 0
  %after = vlda.128.i32x4 %pointer, 16
  return %first, %first, %after
}

// ====

// Both load lanes and BF16 storage define their whole result register without
// an input destination, including register-indexed addresses.
// RUN: verify

low.func.def target<amd.xdna.aie2p.core> @fresh_indexed_vectors(%pointer: reg<aie2p.ep>, %index: reg<aie2p.edj>) -> (reg<aie2p.vec256>, reg<aie2p.vec256>, reg<aie2p.vec256>) asm {
  %bytes = vldb.128.i8x16.index %pointer, %index
  %bf16_a = vlda.128.bf16x8.index %pointer, %index
  %bf16_b = vldb.128.bf16x8 %pointer, 16
  return %bytes, %bf16_a, %bf16_b
}
