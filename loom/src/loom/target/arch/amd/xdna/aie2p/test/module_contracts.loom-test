// RUN: emit source-low output=module

aie2p.target<array> @array_target

aie2p.target<core> @core_target

low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) @vector_add_array() asm {
  %zero = constant.u32 0 : reg<aie2p.array.scalar : index>
  %one = constant.u32 1 : reg<aie2p.array.scalar : index>
  %capacity = constant.u32 2 : reg<aie2p.array.scalar : index>
  %row = constant.u32 2 : reg<aie2p.array.scalar : index>
  %workers = group %one
  %worker = worker %workers, %zero, @vector_add_core
  %lhs_binding = binding 0, "read"
  %rhs_binding = binding 1, "read"
  %output_binding = binding 2, "write"
  %lhs_sender = sender %lhs_binding, 0 : reg<aie2p.array.sender : tile<16xi32>>
  %rhs_sender = sender %rhs_binding, 0 : reg<aie2p.array.sender : tile<16xi32>>
  %output_receiver = receiver %output_binding, 0 : reg<aie2p.array.receiver : tile<16xi32>>
  %lhs_receiver = receiver %worker, 0 : reg<aie2p.array.receiver : tile<16xi32>>
  %rhs_receiver = receiver %worker, 1 : reg<aie2p.array.receiver : tile<16xi32>>
  %output_sender = sender %worker, 2 : reg<aie2p.array.sender : tile<16xi32>>
  %lhs_channel = channel %lhs_sender, %lhs_receiver, %capacity : reg<aie2p.array.channel : tile<16xi32>>
  %rhs_channel = channel %rhs_sender, %rhs_receiver, %capacity : reg<aie2p.array.channel : tile<16xi32>>
  %output_channel = channel %output_sender, %output_receiver, %capacity : reg<aie2p.array.channel : tile<16xi32>>
  constrain.location %worker, %zero, %row
  return
}

func.def target(@core_target) @vector_add_core() {
  func.return
}

func.def target(@core_target) @unused_core() {
  func.return
}

