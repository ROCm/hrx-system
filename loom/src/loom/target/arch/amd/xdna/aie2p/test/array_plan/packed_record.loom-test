// RUN: emit aie2p-array-plan @canonical_q5_stream_array

// Packed 176-byte records preserve their strided and repeated transfer geometry.

aie2p.target<array> @canonical_q5_stream_array_target

aie2p.target<core> @canonical_q5_stream_core_target

low.func.def public retain target<amd.xdna.aie2p.array>(@canonical_q5_stream_array_target) abi(array_program) @canonical_q5_stream_array() asm {
  %lanes = constant.u32 1 : reg<aie2p.array.scalar : index>
  %lane = constant.u32 0 : reg<aie2p.array.scalar : index>
  %capacity = constant.u32 2 : reg<aie2p.array.scalar : index>
  %records = constant.u32 6 : reg<aie2p.array.scalar : index>
  %column = constant.u32 0 : reg<aie2p.array.scalar : index>
  %row = constant.u32 2 : reg<aie2p.array.scalar : index>
  %binding_offset = constant.u64 0 : reg<aie2p.array.offset : offset>

  %group = group %lanes
  %worker = worker %group, %lane, @consume_q5_record
  %weight = binding 0, "read"
  %activation = binding 1, "read"
  %output = binding 2, "write"
  %weight_sender = sender %weight, 0 : reg<aie2p.array.sender : tile<1x3x2x176xi8, #encoding.layout.strided<strides=[352, 704, 176, 1]>>>
  %activation_sender = sender %activation, 0 : reg<aie2p.array.sender : tile<1x3x2x176xi8, #encoding.layout.strided<strides=[352, 0, 176, 1]>>>
  %output_receiver = receiver %output, 0 : reg<aie2p.array.receiver : tile<64xi8>>
  %weight_lane = partition.sender %weight_sender, %binding_offset, %lane, %lanes : reg<aie2p.array.sender : tile<176xi8>>
  %activation_lane = partition.sender %activation_sender, %binding_offset, %lane, %lanes : reg<aie2p.array.sender : tile<176xi8>>
  %worker_weight = receiver %worker, 0 : reg<aie2p.array.receiver : tile<176xi8>>
  %worker_activation = receiver %worker, 1 : reg<aie2p.array.receiver : tile<176xi8>>
  %worker_output = sender %worker, 2 : reg<aie2p.array.sender : tile<64xi8>>
  %weight_channel = channel %weight_lane, %worker_weight, %capacity, %records : reg<aie2p.array.channel : tile<176xi8>>
  %activation_channel = channel %activation_lane, %worker_activation, %capacity, %records : reg<aie2p.array.channel : tile<176xi8>>
  %output_channel = channel %worker_output, %output_receiver, %capacity, %records : reg<aie2p.array.channel : tile<64xi8>>
  constrain.location %worker, %column, %row
  return
}

low.func.def target<amd.xdna.aie2p.core>(@canonical_q5_stream_core_target) abi(object_function) @consume_q5_record() asm {
  %weight = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %activation = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %output = resource<native_pointer> {index = 2, source_type = buffer} : reg<aie2p.ep>
  %weight_head = vlda.512.i8x64 %weight, 0
  %activation_head = vlda.512.i8x64 %activation, 0
  %sum = vadd.8 %weight_head, %activation_head
  vst.512.i8x64 %sum, %output, 0
  return
}

