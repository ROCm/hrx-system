// TEMPLATE: loom/src/loom/test/corpus/source_low/memory_vector64.loom-test
// RUN: with-checks emit source-low target=amd.xdna.aie2p:core output=low

func.def @copy_i64_2_static(%input: buffer, %output: buffer) {
  %source, %destination = buffer.assume.alignment %input, %output {minimum_alignment = 64} : buffer, buffer
  %offset = index.constant 0 : offset
  %source_view = buffer.view %source[%offset] : buffer -> view<2xi64>
  %destination_view = buffer.view %destination[%offset] : buffer -> view<2xi64>
  %value = vector.load %source_view[0] : view<2xi64> -> vector<2xi64>
  vector.store %value, %destination_view[0] : vector<2xi64>, view<2xi64>
  func.return
}

// ----
CHECK: * = vlda.128.i64x2 *
CHECK: vst.128.i64x2 *
CHECK-NOT: vextract
CHECK-NOT: vinsert

// ====

func.def @copy_i64_2_dynamic(%input: buffer, %output: buffer, %position: i32) {
  %source, %destination = buffer.assume.alignment %input, %output {minimum_alignment = 64} : buffer, buffer
  %coordinate = scalar.assume %position [range(%position, 0, 4096), mul(%position, 64)] : i32
  %offset = index.cast %coordinate : i32 to offset
  %source_view = buffer.view %source[%offset] : buffer -> view<2xi64>
  %destination_view = buffer.view %destination[%offset] : buffer -> view<2xi64>
  %value = vector.load %source_view[0] : view<2xi64> -> vector<2xi64>
  vector.store %value, %destination_view[0] : vector<2xi64>, view<2xi64>
  func.return
}

// ----
CHECK: * = vlda.128.i64x2.index *
CHECK: vst.128.i64x2.index *
CHECK-NOT: vextract
CHECK-NOT: vinsert

// ====

