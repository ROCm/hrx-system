func.def @copy_i64_split(%input: buffer, %output: buffer) {
  %source = buffer.assume.alignment %input {minimum_alignment = 16} : buffer
  %destination = buffer.assume.alignment %output {minimum_alignment = 32} : buffer
  %offset = index.constant 0 : offset
  %source_view = buffer.view %source[%offset] : buffer -> view<4xi64>
  %destination_view = buffer.view %destination[%offset] : buffer -> view<4xi64>
  %value = vector.load %source_view[0] : view<4xi64> -> vector<4xi64>
  vector.store %value, %destination_view[0] : vector<4xi64>, view<4xi64>
  func.return
}

