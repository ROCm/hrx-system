// RUN: emit aie2p-array-plan @temporal_fold_array

// Four input records accumulate into each output while both rings keep advancing.

aie2p.target<array> @temporal_fold_array_target

aie2p.target<core> @temporal_fold_core_target

low.func.def public retain target<amd.xdna.aie2p.array>(@temporal_fold_array_target) abi(array_program) @temporal_fold_array() asm {
  %lanes = constant.u32 1 : reg<aie2p.array.scalar : index>
  %lane = constant.u32 0 : reg<aie2p.array.scalar : index>
  %capacity = constant.u32 2 : reg<aie2p.array.scalar : index>
  %fold_records = constant.u32 4 : reg<aie2p.array.scalar : index>
  %input_records = constant.u32 12 : reg<aie2p.array.scalar : index>
  %output_records = constant.u32 3 : reg<aie2p.array.scalar : index>
  %column = constant.u32 0 : reg<aie2p.array.scalar : index>
  %row = constant.u32 2 : reg<aie2p.array.scalar : index>
  %binding_offset = constant.u64 64 : reg<aie2p.array.offset : offset>

  %group = group %lanes
  %worker = worker.fold %group, %lane, %fold_records, @copy_f32_record, 1, 1, 1, 0
  %input = binding 0, "read"
  %output = binding 1, "write"
  %input_sender = sender %input, 0 : reg<aie2p.array.sender : tile<1x3x4x32xf32, #encoding.layout.strided<strides=[0, 0, 32, 1]>>>
  %input_lane = partition.sender %input_sender, %binding_offset, %lane, %lanes : reg<aie2p.array.sender : tile<32xf32>>
  %worker_input = receiver %worker, 0 : reg<aie2p.array.receiver : tile<32xf32>>
  %worker_output = sender %worker, 1 : reg<aie2p.array.sender : tile<32xf32>>
  %output_receiver = receiver %output, 0 : reg<aie2p.array.receiver : tile<32xf32>>
  %input_channel = channel %input_lane, %worker_input, %capacity, %input_records : reg<aie2p.array.channel : tile<32xf32>>
  %output_channel = channel %worker_output, %output_receiver, %capacity, %output_records : reg<aie2p.array.channel : tile<32xf32>>
  constrain.location %worker, %column, %row
  return
}

low.func.def target<amd.xdna.aie2p.core>(@temporal_fold_core_target) abi(object_function) @copy_f32_record() asm {
  %input = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %output = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %low = vlda.acc %input, 0
  %high = vlda.acc %input, 64
  vst.acc %low, %output, 0
  vst.acc %high, %output, 64
  return
}

