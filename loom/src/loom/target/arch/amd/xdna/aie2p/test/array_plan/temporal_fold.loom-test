low.func.def retain target<amd.xdna.aie2p.core>(@temporal_fold_core_target) @temporal_fold_array$worker$0() asm {
  %acquire_delta = mov.short -1
  %release_delta = mov.short 1
  %fold_zero = mov.short 0
  %fold_record_count = mov.i32 4
  %fold_mode = mova.i32 60
  %40 = acc.clear.f32x64
  %41 = slice %40[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %60 = mov.local-address 458752
  %61 = mov.local-address 491520
  low.br ^_bb1(%60: reg<aie2p.ep>, %61: reg<aie2p.ep>)
^_bb1(%32: reg<aie2p.ep>, %33: reg<aie2p.ep>):
  acq %acquire_delta, 50
  low.br ^_bb2(%32: reg<aie2p.ep>, %33: reg<aie2p.ep>, %40: reg<aie2p.mbms x4>, %fold_record_count: reg<aie2p.er>, %release_delta: reg<aie2p.er>)
^_bb2(%input: reg<aie2p.ep>, %output: reg<aie2p.ep>, %34: reg<aie2p.mbms x4>, %35: reg<aie2p.er>, %36: reg<aie2p.er>):
  acq %acquire_delta, 49
  low.br ^_bb3
^_bb3:
  %low = vlda.acc %input, 0
  %high = vlda.acc %input, 64
  vst.acc %low, %output, 0
  vst.acc %high, %output, 64
  low.br ^_bb4
^_bb4:
  %43 = vlda.acc %output, 0
  %44 = vlda.acc %output, 64
  %45 = concat(%43, %44, %41, %41) : (reg<aie2p.mbms>, reg<aie2p.mbms>, reg<aie2p.mbms>, reg<aie2p.mbms>) -> reg<aie2p.mbms x4>
  %46 = nez %36
  low.cond_br %46, ^_bb5, ^_bb6 : reg<aie2p.er>
^_bb5:
  low.br ^_bb7(%45: reg<aie2p.mbms x4>)
^_bb6:
  %47 = vadd.f32x64 %34, %45, %fold_mode
  low.br ^_bb7(%47: reg<aie2p.mbms x4>)
^_bb7(%42: reg<aie2p.mbms x4>):
  rel %release_delta, 48
  %48 = mov.address-to-scalar %input
  %49 = mov.i32 16384
  %50 = xor %48, %49
  %51 = mov.scalar-to-address %50
  %52 = sub %35, %release_delta
  %53 = nez %52
  low.cond_br %53, ^_bb8, ^_bb9 : reg<aie2p.er>
^_bb8:
  low.br ^_bb2(%51: reg<aie2p.ep>, %output: reg<aie2p.ep>, %42: reg<aie2p.mbms x4>, %52: reg<aie2p.er>, %fold_zero: reg<aie2p.er>)
^_bb9:
  %54 = slice %42[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %54, %output, 0
  %55 = slice %42[1] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %55, %output, 64
  rel %release_delta, 51
  %56 = mov.address-to-scalar %output
  %57 = mov.i32 16384
  %58 = xor %56, %57
  %59 = mov.scalar-to-address %58
  low.br ^_bb1(%51: reg<aie2p.ep>, %59: reg<aie2p.ep>)
}
