low.func.def retain target<amd.xdna.aie2p.core> @temporal_fold_array$worker$0() asm {
  %acquire_delta = mov.short -1
  %release_delta = mov.short 1
  %fold_zero = mov.short 0
  %fold_record_count = mov.i32 4
  %fold_mode = mova.i32 60
  %18 = acc.clear.f32x64
  %19 = slice %18[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %38 = mov.local-address 458752
  %39 = mov.local-address 491520
  low.br ^_bb1(%38: reg<aie2p.ep>, %39: reg<aie2p.ep>)
^_bb1(%10: reg<aie2p.ep>, %11: reg<aie2p.ep>):
  acq %acquire_delta, 50
  low.br ^_bb2(%10: reg<aie2p.ep>, %11: reg<aie2p.ep>, %18: reg<aie2p.mbms x4>, %fold_record_count: reg<aie2p.er>, %release_delta: reg<aie2p.er>)
^_bb2(%6: reg<aie2p.ep>, %8: reg<aie2p.ep>, %12: reg<aie2p.mbms x4>, %13: reg<aie2p.er>, %14: reg<aie2p.er>):
  acq %acquire_delta, 49
  %input = copy %6 : reg<aie2p.ep> -> reg<aie2p.ep>
  %output = copy %8 : reg<aie2p.ep> -> reg<aie2p.ep>
  %low = vlda.acc %input, 0
  %high = vlda.acc %input, 64
  vst.acc %low, %output, 0
  vst.acc %high, %output, 64
  %21 = vlda.acc %8, 0
  %22 = vlda.acc %8, 64
  %23 = concat(%21, %22, %19, %19) : (reg<aie2p.mbms>, reg<aie2p.mbms>, reg<aie2p.mbms>, reg<aie2p.mbms>) -> reg<aie2p.mbms x4>
  %24 = nez %14
  low.cond_br %24, ^_bb3, ^_bb4 : reg<aie2p.er>
^_bb3:
  low.br ^_bb5(%23: reg<aie2p.mbms x4>)
^_bb4:
  %25 = vadd.f32x64 %12, %23, %fold_mode
  low.br ^_bb5(%25: reg<aie2p.mbms x4>)
^_bb5(%20: reg<aie2p.mbms x4>):
  rel %release_delta, 48
  %26 = mov.address-to-scalar %6
  %27 = mov.i32 16384
  %28 = xor %26, %27
  %29 = mov.scalar-to-address %28
  %30 = sub %13, %release_delta
  %31 = nez %30
  low.cond_br %31, ^_bb6, ^_bb7 : reg<aie2p.er>
^_bb6:
  low.br ^_bb2(%29: reg<aie2p.ep>, %8: reg<aie2p.ep>, %20: reg<aie2p.mbms x4>, %30: reg<aie2p.er>, %fold_zero: reg<aie2p.er>)
^_bb7:
  %32 = slice %20[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %32, %8, 0
  %33 = slice %20[1] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %33, %8, 64
  rel %release_delta, 51
  %34 = mov.address-to-scalar %8
  %35 = mov.i32 16384
  %36 = xor %34, %35
  %37 = mov.scalar-to-address %36
  low.br ^_bb1(%29: reg<aie2p.ep>, %37: reg<aie2p.ep>)
}

// ====
// RUN: with-checks emit aie2p-array-plan @fold_output_without_import

// A folded output belongs to the array topology even when the leaf does not
// import its pointer. Resident generation must still carry and advance that
// output ring for the fold protocol.
aie2p.target<array> @array_target

aie2p.target<core> @core_target

low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) @fold_output_without_import() asm {
  %one = constant.u32 1 : reg<aie2p.array.scalar : index>
  %zero = constant.u32 0 : reg<aie2p.array.scalar : index>
  %two = constant.u32 2 : reg<aie2p.array.scalar : index>
  %three = constant.u32 3 : reg<aie2p.array.scalar : index>
  %four = constant.u32 4 : reg<aie2p.array.scalar : index>
  %twelve = constant.u32 12 : reg<aie2p.array.scalar : index>
  %binding_offset = constant.u64 64 : reg<aie2p.array.offset : offset>

  %group = group %one
  %worker = worker.fold %group, %zero, %four, @touch_input, 1, 1, "addf", 64
  %input = binding 0, "read"
  %output = binding 1, "write"
  %input_sender = sender %input, 0 : reg<aie2p.array.sender : tile<1x3x4x32xf32, #encoding.layout.strided<strides=[0, 0, 32, 1]>>>
  %input_lane = partition.sender %input_sender, %binding_offset, %zero, %one : reg<aie2p.array.sender : tile<32xf32>>
  %worker_input = receiver %worker, 0 : reg<aie2p.array.receiver : tile<32xf32>>
  %worker_output = sender %worker, 1 : reg<aie2p.array.sender : tile<32xf32>>
  %output_receiver = receiver %output, 0 : reg<aie2p.array.receiver : tile<32xf32>>
  %input_channel = channel %input_lane, %worker_input, %two, %twelve : reg<aie2p.array.channel : tile<32xf32>>
  %output_channel = channel %worker_output, %output_receiver, %two, %three : reg<aie2p.array.channel : tile<32xf32>>
  constrain.location %worker, %zero, %two
  return
}

low.func.def target<amd.xdna.aie2p.core>(@core_target) abi(object_function) @touch_input() asm {
  %input = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %low = vlda.acc %input, 0
  %high = vlda.acc %input, 64
  vst.acc %low, %input, 0
  vst.acc %high, %input, 64
  return
}

// ----
CHECK: worker index=0 * fold-output=1+1 * resources=1 *
CHECK: resident-program workers=1
CHECK: resident worker=0 entry=@fold_output_without_import$worker$0 *
CHECK: low.func.def retain target<amd.xdna.aie2p.core> @fold_output_without_import$worker$0() asm {
CHECK: * = mov.local-address *
CHECK: * = mov.local-address *
CHECK: * = vlda.acc *, 0
CHECK: * = vlda.acc *, 64
CHECK: vst.acc *, *, 0
CHECK: vst.acc *, *, 64
CHECK: * = mov.address-to-scalar *
CHECK: * = mov.address-to-scalar *
