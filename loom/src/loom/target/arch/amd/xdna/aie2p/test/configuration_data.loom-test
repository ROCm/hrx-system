// ====
// RUN: verify

// Invocation may reuse the memory, but allocation ownership belongs to setup.
aie2p.target<configuration> @configuration

low.func.def public retain target<amd.xdna.aie2p.configuration>(@configuration) abi(array_program) @bad_phase() asm {
  %columns = constant 1 : reg<aie2p.config.scalar : i64>
  entry %columns, @initialize, @invoke
  return
}

low.func.def target<amd.xdna.aie2p.configuration>(@configuration) @initialize() asm {
  return
}

low.func.def target<amd.xdna.aie2p.configuration>(@configuration) @invoke() asm {
  %column = constant 0 : reg<aie2p.config.scalar : i64>
  %row = constant 3 : reg<aie2p.config.scalar : i64>
  %offset = constant 0 : reg<aie2p.config.scalar : i64>
  %length = constant 64 : reg<aie2p.config.scalar : i64>
  // ERROR@+1: XDNA/038 {function_name="invoke", phase="invocation", command="amd.xdna.aie2p.configuration.data.reserve"}
  data.reserve %column, %row, %offset, %length
  return
}

// ====
// RUN: emit aie2p-xdna output=sections

// Constant-bank separation survives native detachment and two placements.
global.rodata.def @first = align(32) conflicts([@second]) bytes("1122334455667788")

global.rodata.def @second = align(32) conflicts([@first]) bytes("99aabbccddeeff00")

aie2p.target<configuration> @configuration {device_profile = "amd.xdna.strix.17f0_10"}

aie2p.target<core> @core

low.func.def public retain target<amd.xdna.aie2p.configuration>(@configuration) abi(array_program) @banked_constants() asm {
  %columns = constant 2 : reg<aie2p.config.scalar : i64>
  entry %columns, @initialize, @invoke
  return
}

low.func.def target<amd.xdna.aie2p.configuration>(@configuration) @initialize() asm {
  %first_column = constant 0 : reg<aie2p.config.scalar : i64>
  %second_column = constant 1 : reg<aie2p.config.scalar : i64>
  %row = constant 3 : reg<aie2p.config.scalar : i64>
  %origin = constant 0 : reg<aie2p.config.scalar : i64>
  %bank_bytes = constant 16384 : reg<aie2p.config.scalar : i64>
  data.reserve %first_column, %row, %origin, %bank_bytes
  program.load %first_column, %row, @read_constants
  program.load %second_column, %row, @read_constants
  return
}

low.func.def target<amd.xdna.aie2p.configuration>(@configuration) @invoke() asm {
  return
}

low.func.def target<amd.xdna.aie2p.core>(@core) abi(object_function) @read_constants() asm {
  %scratch = storage {byte_alignment = 32, byte_length = 64} : low.storage<private>
  %destination = storage_address %scratch : low.storage<private> -> reg<aie2p.ep>
  %first_address = mov.local-address @first
  %second_address = mov.local-address @second
  %first_value = lda %first_address, 0
  %second_value = lda %second_address, 0
  st %first_value, %destination, 0
  st %second_value, %destination, 4
  return
}

