// ====
// RUN: emit aie2p-xdna output=sections

// Every function data domain shares the remaining SRAM after channel storage.
aie2p.target<configuration> @configuration {device_profile = "amd.xdna.strix.17f0_10"}

aie2p.target<core> @core

low.func.def public retain target<amd.xdna.aie2p.configuration>(@configuration) abi(array_program) @all_domains() asm {
  %columns = constant 1 : reg<aie2p.config.scalar : i64>
  entry %columns, @initialize, @invoke
  return
}

low.func.def target<amd.xdna.aie2p.configuration>(@configuration) @initialize() asm {
  %column = constant 0 : reg<aie2p.config.scalar : i64>
  %row = constant 3 : reg<aie2p.config.scalar : i64>
  %origin = constant 0 : reg<aie2p.config.scalar : i64>
  %channels = constant 32776 : reg<aie2p.config.scalar : i64>
  data.reserve %column, %row, %origin, %channels
  program.load %column, %row, @worker
  return
}

low.func.def target<amd.xdna.aie2p.configuration>(@configuration) @invoke() asm {
  return
}

low.func.def target<amd.xdna.aie2p.core>(@core) abi(object_function) @worker() asm {
  %stack = storage {byte_alignment = 32, byte_length = 32} : low.storage<stack>
  %scratch = storage {byte_alignment = 32, byte_length = 32} : low.storage<scratch>
  %private = storage {byte_alignment = 64, byte_length = 64} : low.storage<private>
  %shared = storage {byte_alignment = 256, byte_length = 256} : low.storage<workgroup>
  %stack_address = storage_address %stack : low.storage<stack> -> reg<aie2p.ep>
  %scratch_address = storage_address %scratch : low.storage<scratch> -> reg<aie2p.ep>
  %private_address = storage_address %private : low.storage<private> -> reg<aie2p.ep>
  %shared_address = storage_address %shared : low.storage<workgroup> -> reg<aie2p.ep>
  %identity = mov.short 0
  st %identity, %stack_address, 0
  st %identity, %scratch_address, 0
  st %identity, %private_address, 0
  st %identity, %shared_address, 0
  return
}

