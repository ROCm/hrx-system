// RUN: emit aie2p-xdna output=sections

// One compiled worker links at two placements with different resident data.
// Declarations after program.load still participate in storage admission.
aie2p.target<configuration> @configuration {device_profile = "amd.xdna.strix.17f0_10"}

aie2p.target<core> @core

low.func.def public retain target<amd.xdna.aie2p.configuration>(@configuration) abi(array_program) @retained_weights() asm {
  %columns = constant 2 : reg<aie2p.config.scalar : i64>
  entry %columns, @initialize, @invoke
  return
}

low.func.def target<amd.xdna.aie2p.configuration>(@configuration) @initialize() asm {
  %first_column = constant 0 : reg<aie2p.config.scalar : i64>
  %second_column = constant 1 : reg<aie2p.config.scalar : i64>
  %row = constant 3 : reg<aie2p.config.scalar : i64>
  %origin = constant 0 : reg<aie2p.config.scalar : i64>
  %channels = constant 32776 : reg<aie2p.config.scalar : i64>
  %large_channels = constant 65472 : reg<aie2p.config.scalar : i64>
  program.load %first_column, %row, @reduce
  program.load %second_column, %row, @reduce
  data.reserve %first_column, %row, %origin, %channels
  data.reserve %second_column, %row, %origin, %large_channels
  return
}

low.func.def target<amd.xdna.aie2p.configuration>(@configuration) @invoke() asm {
  return
}

low.func.def target<amd.xdna.aie2p.core>(@core) abi(object_function) @reduce() asm {
  %scratch = storage {byte_alignment = 64, byte_length = 64} : low.storage<private>
  %address = storage_address %scratch : low.storage<private> -> reg<aie2p.ep>
  %identity = mov.short 0
  st %identity, %address, 0
  return
}

