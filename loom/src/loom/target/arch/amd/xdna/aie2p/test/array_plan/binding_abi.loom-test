  %input_receiver = receiver %worker, 0 : reg<aie2p.array.receiver : tile<1xi32>>
  %input_channel = channel %input_sender, %input_receiver, %two, %one : reg<aie2p.array.channel : tile<1xi32>>
  %output_sender = sender %worker, 1 : reg<aie2p.array.sender : tile<1xi32>>
  %output_receiver = receiver %output, 0 : reg<aie2p.array.receiver : tile<1xi32>>
  %output_channel = channel %output_sender, %output_receiver, %two, %one : reg<aie2p.array.channel : tile<1xi32>>
  constrain.location %worker, %zero, %two
  return
}

low.func.def target<amd.xdna.aie2p.core>(@core_target) abi(object_function) @copy() asm {
  %input = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %output = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %value = lda %input, 0
  st %value, %output, 0
  return
