CHECK: array @implicit_sparse * bindings=3 *
CHECK: binding index=0 ordinal=2 access=write
CHECK: binding index=1 ordinal=0 access=read

// ====
// RUN: emit aie2p-array-plan @ordinal_outside_layout

aie2p.target<array> @array_target

aie2p.target<core> @core_target

low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) abi_layout({binding_count = 1}) @ordinal_outside_layout() asm {
  %zero = constant.u32 0 : reg<aie2p.array.scalar : index>
  %one = constant.u32 1 : reg<aie2p.array.scalar : index>
  %two = constant.u32 2 : reg<aie2p.array.scalar : index>
  %group = group %one
  %worker = worker %group, %zero, @consume
  // ERROR@+1: XDNA/031 {ordinal="1", reason="outside the dense binding table", binding_count="1"}
  %input = binding 1, "read"
  %sender = sender %input, 0 : reg<aie2p.array.sender : tile<1xi32>>
  %receiver = receiver %worker, 0 : reg<aie2p.array.receiver : tile<1xi32>>
  %channel = channel %sender, %receiver, %two, %one : reg<aie2p.array.channel : tile<1xi32>>
  constrain.location %worker, %zero, %two
  return
}

low.func.def target<amd.xdna.aie2p.core>(@core_target) abi(object_function) @consume() asm {
  %input = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %value = lda %input, 0
  st %value, %input, 0
  return
}

// ====
// RUN: emit aie2p-array-plan @duplicate_ordinal

aie2p.target<array> @array_target

aie2p.target<core> @core_target

low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) abi_layout({binding_count = 1}) @duplicate_ordinal() asm {
  %zero = constant.u32 0 : reg<aie2p.array.scalar : index>
  %one = constant.u32 1 : reg<aie2p.array.scalar : index>
  %two = constant.u32 2 : reg<aie2p.array.scalar : index>
  %group = group %one
  %worker = worker %group, %zero, @consume_two
  %input0 = binding 0, "read"
  // ERROR@+1: XDNA/031 {ordinal="0", reason="declared by more than one active binding", binding_count="1"}
  %input1 = binding 0, "read_write"
  %sender0 = sender %input0, 0 : reg<aie2p.array.sender : tile<1xi32>>
  %receiver0 = receiver %worker, 0 : reg<aie2p.array.receiver : tile<1xi32>>
  %channel0 = channel %sender0, %receiver0, %two, %one : reg<aie2p.array.channel : tile<1xi32>>
  %sender1 = sender %input1, 0 : reg<aie2p.array.sender : tile<1xi32>>
  %receiver1 = receiver %worker, 1 : reg<aie2p.array.receiver : tile<1xi32>>
  %channel1 = channel %sender1, %receiver1, %two, %one : reg<aie2p.array.channel : tile<1xi32>>
  constrain.location %worker, %zero, %two
  return
}

low.func.def target<amd.xdna.aie2p.core>(@core_target) abi(object_function) @consume_two() asm {
  %input0 = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %input1 = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %value0 = lda %input0, 0
  %value1 = lda %input1, 0
  st %value1, %input0, 0
  st %value0, %input1, 0
  return
}

// ====
// RUN: emit aie2p-array-plan @unexpected_layout_field

aie2p.target<array> @array_target

// ERROR@+1: XDNA/030 {function_name="unexpected_layout_field", field_name="resource_count"}
low.func.def target<amd.xdna.aie2p.array>(@array_target) abi_layout({resource_count = 3}) @unexpected_layout_field(%arg: reg<aie2p.array.group>) asm {
  return
}

