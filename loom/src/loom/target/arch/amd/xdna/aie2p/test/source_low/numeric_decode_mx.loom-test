// RUN: compile-report target=amd.xdna.aie2p:core source-to-low

// The semantic corpus checks decoded values across runtime inputs. This report
// pins the native rule selected for each distinct AIE2P packet shape.
func.def @decode_mx_shapes(%mxfp8_x8_payload: vector<8xf8E4M3>, %mxfp8_x8_scale: vector<1xi32>, %mxfp4_x64_payload: vector<8xi32>, %mxfp4_x64_scale: vector<1xi32>, %mxfp8_x64_payload: vector<64xf8E4M3>, %mxfp8_x64_scale: vector<1xi32>) -> (vector<8xbf16>, vector<64xbf16>, vector<64xbf16>) {
  %mxfp8_x8_schema = encoding.define #encoding.f8e4m3fn<affine=scale_only, payload_elements=8, scale_format=e8m0, scale_group_elements=8, scale_operands=1, scale_topology=block_1d> : encoding<schema>
  %mxfp4_x64_schema = encoding.define #encoding.f4e2m1<affine=scale_only, payload_elements=64, payload_packing=little_endian_nibbles, payload_registers=8, scale_format=e8m0, scale_group_elements=32, scale_operands=1, scale_topology=block_1d, zero_scale_fallback=true> : encoding<schema>
  %mxfp8_x64_schema = encoding.define #encoding.f8e4m3fn<affine=scale_only, payload_elements=64, scale_format=e8m0, scale_group_elements=32, scale_operands=1, scale_topology=block_1d> : encoding<schema>
  %mxfp8_x8 = vector.decode %mxfp8_x8_payload using %mxfp8_x8_schema {scale = %mxfp8_x8_scale : vector<1xi32>} : vector<8xf8E4M3>, encoding<schema> -> vector<8xbf16>
  %mxfp4_x64 = vector.decode %mxfp4_x64_payload using %mxfp4_x64_schema {scale = %mxfp4_x64_scale : vector<1xi32>} : vector<8xi32>, encoding<schema> -> vector<64xbf16>
  %mxfp8_x64 = vector.decode %mxfp8_x64_payload using %mxfp8_x64_schema {scale = %mxfp8_x64_scale : vector<1xi32>} : vector<64xf8E4M3>, encoding<schema> -> vector<64xbf16>
  func.return %mxfp8_x8, %mxfp4_x64, %mxfp8_x64 : vector<8xbf16>, vector<64xbf16>, vector<64xbf16>
}

