low.func.def retain target<amd.xdna.aie2p.core>(@core_target) @traced_copy_array$worker$0() asm {
  %acquire_delta = mov.short -1
  %release_delta = mov.short 1
  %54 = mov.local-address 458752
  %55 = mov.local-address 491520
  low.br ^_bb1(%54: reg<aie2p.ep>, %55: reg<aie2p.ep>)
^_bb1(%43: reg<aie2p.ep>, %45: reg<aie2p.ep>):
  acq %acquire_delta, 49
  acq %acquire_delta, 50
  low.br ^_bb2
^_bb2:
  %input_view = copy %43 : reg<aie2p.ep> -> reg<aie2p.ep>
  %output_view = copy %45 : reg<aie2p.ep> -> reg<aie2p.ep>
  %value = vlda.512.i32x16 %input_view, 0
  vst.512.i32x16 %value, %output_view, 0
  low.br ^_bb3
^_bb3:
  rel %release_delta, 51
  rel %release_delta, 48
  %47 = mov.address-to-scalar %43
  %48 = mov.i32 16384
  %49 = xor %47, %48
  %50 = mov.scalar-to-address %49
  %51 = mov.address-to-scalar %45
  %52 = xor %51, %48
  %53 = mov.scalar-to-address %52
  low.br ^_bb1(%50: reg<aie2p.ep>, %53: reg<aie2p.ep>)
}
