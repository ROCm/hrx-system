// RUN: emit aie2p-array-plan @traced_copy_array trace

aie2p.target<array> @array_target

aie2p.target<core> @core_target

// The check target's trailing "trace" option exercises
// loom_aie2p_array_plan_build's trace_enabled path independently of the
// compiled aie2p.target<array> "trace" attribute, which check/array_plan.c
// does not resolve. A single worker gains one extra write-only binding, one
// shim DMA channel, a trace-unit circuit route, and Trace_Control0/Event0/
// Event1 register writes.
pipeline.def<kernel> public retain target(@array_target) @traced_copy_array() launch(%input: buffer, %output: buffer) {
  %lane_count = index.constant 1 : index
  %base = index.constant 0 : offset
  %workers = group.create %lane_count : index -> group
  %input_view = buffer.view %input[%base] : buffer -> view<16xi32>
  %output_view = buffer.view %output[%base] : buffer -> view<16xi32>
  %input_flow = pipeline.read %input_view on %workers : view<16xi32>, group -> pipeline.flow<tile<16xi32>>
  %output_flow = pipeline.stage @copy_i32x16 on %workers(%input_flow) : (group, pipeline.flow<tile<16xi32>>) -> (pipeline.flow<tile<16xi32>>)
  pipeline.write %output_flow to %output_view : pipeline.flow<tile<16xi32>>, view<16xi32>
  pipeline.return
}

func.def target(@core_target) @copy_i32x16(%input: buffer, %output: buffer) {
  %input_aligned, %output_aligned = buffer.assume.alignment %input, %output {minimum_alignment = 64} : buffer, buffer
  %base = index.constant 0 : offset
  %input_view = buffer.view %input_aligned[%base] : buffer -> view<16xi32>
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<16xi32>
  %value = vector.load %input_view[0] : view<16xi32> -> vector<16xi32>
  vector.store %value, %output_view[0] : vector<16xi32>, view<16xi32>
  func.return
}

