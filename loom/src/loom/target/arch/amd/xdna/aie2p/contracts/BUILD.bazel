load(
    "//loom/build_tools/bazel:build_defs.bzl",
    "loom_target_contract_table_cc_libraries",
)

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loom_target_contract_table_cc_libraries(
    name = "core",
    args = ["--contract-fragment=amd.xdna.aie2p.core"],
    contract_deps = ["//loom/src/loom/target:contract"],
    generator = "//loom/py/loom/gen/target/contracts:aie2p_contract_table_family",
    lower_rule_deps = [
        "//loom/src/loom/codegen/low/lower",
        "//loom/src/loom/ops/scalar",
    ],
    visibility = ["//loom/src/loom/target/arch/amd/xdna/aie2p:__pkg__"],
)
