// RUN: emit source-low @joined target=amd.xdna.aie2p:amd.xdna.strix.17f0_10 output=low

// Every participant joins even when a child has no local work. The two inner
// scopes share their two-core lock tree; the three-core outer scope needs its
// own credits because the third core can arrive while an inner scope runs.
aie2p.target<array> @device {device_profile = "amd.xdna.strix.17f0_10"}

pipeline.def @produce() run(%storage: buffer, %value: index) {
  %origin = index.constant 0 : offset
  pipeline.strand workers([0, 2], [1, 1], [1, 1]) {
    %local = buffer.view %storage[%origin] : buffer -> view<1xi32>
    %integer = index.cast %value : index to i32
    view.store %integer, %local[0] : i32, view<1xi32>
  }
}

pipeline.def @consume() run(%storage: buffer) {
  %origin = index.constant 0 : offset
  pipeline.strand workers([1, 2], [1, 1], [1, 1]) {
    %shared = buffer.view %storage[%origin] : buffer -> view<1xi32>
    %value = view.load %shared[0] : view<1xi32> -> i32
    %increment = scalar.constant 1 : i32
    %result = scalar.addi %value, %increment : i32
    view.store %result, %shared[0] : i32, view<1xi32>
  }
}

pipeline.def @finish() run(%storage: buffer) {
  %origin = index.constant 0 : offset
  pipeline.strand workers([0, 3], [1, 1], [1, 1]) {
    %shared = buffer.view %storage[%origin] : buffer -> view<1xi32>
    %value = view.load %shared[0] : view<1xi32> -> i32
    %increment = scalar.constant 17 : i32
    %result = scalar.addi %value, %increment : i32
    view.store %result, %shared[0] : i32, view<1xi32>
  }
}

pipeline.def<kernel> public retain target(@device) @joined() run() {
  %memory = pipeline.memory<workgroup>[0, 2] : pool
  %bytes = index.constant 4 : offset
  %storage = buffer.alloca<workgroup> pool(%memory) align(4) %bytes : buffer
  %begin = index.constant 0 : index
  %count = index.constant 3 : index
  %step = index.constant 1 : index
  pipeline.serial {
    scf.for %phase = [%begin to %count step %step] {
      pipeline.serial {
        pipeline.compose @produce(%storage, %phase) : (buffer, index)
        pipeline.compose @consume(%storage) : (buffer)
      }
      pipeline.serial {
        pipeline.compose @consume(%storage) : (buffer)
        pipeline.compose @produce(%storage, %phase) : (buffer, index)
      }
      pipeline.compose @finish(%storage) : (buffer)
    }
  }
}

