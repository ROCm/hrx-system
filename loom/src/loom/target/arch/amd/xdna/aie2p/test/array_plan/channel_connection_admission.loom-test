// RUN: emit aie2p-array-plan @write_binding_as_input

aie2p.target<array> @array_target

aie2p.target<core> @core_target

low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) @write_binding_as_input() asm {
  %zero = constant.u32 0 : reg<aie2p.array.scalar : index>
  %one = constant.u32 1 : reg<aie2p.array.scalar : index>
  %two = constant.u32 2 : reg<aie2p.array.scalar : index>
  %group = group %one
  %worker = worker %group, %zero, @consume
  %input = binding 0, "write"
  %sender = sender %input, 0 : reg<aie2p.array.sender : tile<1xi32>>
  %receiver = receiver %worker, 0 : reg<aie2p.array.receiver : tile<1xi32>>
  // ERROR@+1: XDNA/026 {channel="0", sender_kind="binding", sender_owner="0", sender_port="0", receiver_kind="worker", receiver_owner="0", receiver_port="0", reason="the sending binding is write-only"}
  %channel = channel %sender, %receiver, %one, %one : reg<aie2p.array.channel : tile<1xi32>>
  constrain.location %worker, %zero, %two
  return
}

low.func.def target<amd.xdna.aie2p.core>(@core_target) abi(object_function) @consume() asm {
  return
}

// ====
// RUN: emit aie2p-array-plan @read_binding_as_output

aie2p.target<array> @array_target

aie2p.target<core> @core_target

low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) @read_binding_as_output() asm {
