  %42, %43 = divs %41, %40, %divisor
  %44, %45 = divs %43, %42, %divisor
  %46, %47 = divs %45, %44, %divisor
  %48, %49 = divs %47, %46, %divisor
  %50, %51 = divs %49, %48, %divisor
  %52, %53 = divs %51, %50, %divisor
