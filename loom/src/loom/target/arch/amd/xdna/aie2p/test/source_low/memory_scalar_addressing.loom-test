aie2p.target<core> @target
func.def target(@target) @scalar_static_rank2_i32(%input: buffer, %output: buffer) -> (i32) {
  %input_base = index.constant 8 : offset
  %output_base = index.constant 12 : offset
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %input_view = buffer.view %input_aligned[%input_base] : buffer -> view<2x4xi32>
  %output_view = buffer.view %output_aligned[%output_base] : buffer -> view<2x4xi32>
  %loaded = view.load %input_view[1, 2] : view<2x4xi32> -> i32
  view.store %loaded, %output_view[0, 3] : i32, view<2x4xi32>
  func.return %loaded : i32
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @scalar_static_rank2_i32() -> (reg<aie2p.er>) asm {
  %input_view = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %output_view = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %16 = mov.static-byte-offset 32
  %17 = mov.address-index %16
  %loaded = lda.i32.index %input_view, %17
  st %loaded, %output_view, 24
  return %loaded
}

