low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @scalar_mixed_rank2_i32(%base_aligned: reg<aie2p.er>, %row_bounded: reg<aie2p.er>, %column_bounded: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %input_view = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %output_view = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %27 = mov.i32 5
  %28 = lshl %row_bounded, %27
  %29 = add.rr %base_aligned, %28
  %30 = mov.i32 2
  %31 = lshl %column_bounded, %30
  %32 = add.rr %29, %31
  %33 = mov.address-index %32
  %loaded = lda.i32.index %input_view, %33
  %37 = add.rr %base_aligned, %28
  %40 = add.rr %37, %31
  %41 = mov.address-index %40
  st.i32.index %loaded, %output_view, %41
  return %loaded
}

