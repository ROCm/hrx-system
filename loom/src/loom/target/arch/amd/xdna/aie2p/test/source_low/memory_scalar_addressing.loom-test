low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @scalar_dynamic_view_base_i32(%base_aligned: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %input_view = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
