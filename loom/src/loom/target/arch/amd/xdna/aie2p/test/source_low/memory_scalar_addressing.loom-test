low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @scalar_subview_dynamic_index_i32(%base_aligned: reg<aie2p.er>, %element_bounded: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %input_refined = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %output_refined = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %21 = mov.i32 2
  %22 = lshl %element_bounded, %21
  %23 = add.rr %base_aligned, %22
  %24 = add %23, 4
  %25 = mov.address-index %24
  %loaded = lda.i32.index %input_refined, %25
  %29 = add.rr %base_aligned, %22
  %30 = add %29, 4
  %31 = mov.address-index %30
  st.i32.index %loaded, %output_refined, %31
  return %loaded
}
