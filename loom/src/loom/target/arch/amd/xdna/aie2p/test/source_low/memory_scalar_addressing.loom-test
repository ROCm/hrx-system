low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @scalar_dynamic_stride_i32(%columns_bounded: reg<aie2p.er>, %row_bounded: reg<aie2p.er>, %column_bounded: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %input_view = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %output_view = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %21 = mul %row_bounded, %columns_bounded
  %22 = mov.i32 2
  %23 = lshl %21, %22
  %25 = lshl %column_bounded, %22
  %26 = add.rr %23, %25
  %27 = mov.address-index %26
  %loaded = lda.i32.index %input_view, %27
  %34 = add.rr %23, %25
  %35 = mov.address-index %34
  st.i32.index %loaded, %output_view, %35
  return %loaded
}

