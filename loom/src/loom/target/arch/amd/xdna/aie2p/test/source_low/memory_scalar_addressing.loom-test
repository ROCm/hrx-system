aie2p.target<core> @target
func.def target(@target) @scalar_subview_dynamic_index_i32(%input: buffer, %output: buffer, %base: offset, %element: index) -> (i32) {
  %base_aligned = index.assume %base [range(%base, 0, 4064), mul(%base, 4)] : offset
  %element_bounded = index.assume %element [range(%element, 0, 3)] : index
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %input_view = buffer.view %input_aligned[%base_aligned] : buffer -> view<8xi32>
  %output_view = buffer.view %output_aligned[%base_aligned] : buffer -> view<8xi32>
  %input_subview = view.subview %input_view[1] : view<8xi32> -> view<4xi32>
  %output_subview = view.subview %output_view[1] : view<8xi32> -> view<4xi32>
  %input_refined = view.refine %input_subview : view<4xi32> -> view<4xi32>
  %output_refined = view.refine %output_subview : view<4xi32> -> view<4xi32>
  %loaded = view.load %input_refined[%element_bounded] : view<4xi32> -> i32
  view.store %loaded, %output_refined[%element_bounded] : i32, view<4xi32>
  func.return %loaded : i32
}

