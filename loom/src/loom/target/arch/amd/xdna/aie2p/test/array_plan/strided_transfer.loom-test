low.func.def retain target<amd.xdna.aie2p.core> @repeated_sliding_window_array$worker$0() asm {
  %acquire_delta = mov.short -1
  %release_delta = mov.short 1
  %19 = mov.local-address 458752
  %20 = mov.local-address 491520
  low.br ^_bb1(%19: reg<aie2p.ep>, %20: reg<aie2p.ep>)
^_bb1(%8: reg<aie2p.ep>, %10: reg<aie2p.ep>):
  acq %acquire_delta, 49
  acq %acquire_delta, 50
  %input = copy %8 : reg<aie2p.ep> -> reg<aie2p.ep>
  %output = copy %10 : reg<aie2p.ep> -> reg<aie2p.ep>
  %value0 = lda %input, 0
  %value1 = lda %input, 4
  %value2 = lda %input, 8
  %value3 = lda %input, 12
  st %value0, %output, 0
  st %value1, %output, 4
  st %value2, %output, 8
  st %value3, %output, 12
  rel %release_delta, 51
  rel %release_delta, 48
  %12 = mov.address-to-scalar %8
  %13 = mov.i32 16384
  %14 = xor %12, %13
  %15 = mov.scalar-to-address %14
  %16 = mov.address-to-scalar %10
  %17 = xor %16, %13
  %18 = mov.scalar-to-address %17
  low.br ^_bb1(%15: reg<aie2p.ep>, %18: reg<aie2p.ep>)
}
