// RUN: emit aie2p-array-plan @repeated_sliding_window_array

// Repeated overlapping windows preserve the binding offset and transfer span.

aie2p.target<array> @repeated_sliding_window_array_target

aie2p.target<core> @repeated_sliding_window_core_target

low.func.def public retain target<amd.xdna.aie2p.array>(@repeated_sliding_window_array_target) abi(array_program) @repeated_sliding_window_array() asm {
  %lanes = constant.u32 1 : reg<aie2p.array.scalar : index>
  %lane = constant.u32 0 : reg<aie2p.array.scalar : index>
  %capacity = constant.u32 2 : reg<aie2p.array.scalar : index>
  %records = constant.u32 6 : reg<aie2p.array.scalar : index>
  %column = constant.u32 0 : reg<aie2p.array.scalar : index>
  %row = constant.u32 2 : reg<aie2p.array.scalar : index>
  %binding_offset = constant.u64 256 : reg<aie2p.array.offset : offset>

  %group = group %lanes
  %worker = worker %group, %lane, @copy_f32x4_record
  %input = binding 0, "read"
  %output = binding 1, "write"
  %input_sender = sender %input, 0 : reg<aie2p.array.sender : tile<1x2x3x4xf32, #encoding.layout.strided<strides=[0, 0, 2, 1]>>>
  %input_lane = partition.sender %input_sender, %binding_offset, %lane, %lanes : reg<aie2p.array.sender : tile<4xf32>>
  %worker_input = receiver %worker, 0 : reg<aie2p.array.receiver : tile<4xf32>>
  %worker_output = sender %worker, 1 : reg<aie2p.array.sender : tile<4xf32>>
  %output_receiver = receiver %output, 0 : reg<aie2p.array.receiver : tile<4xf32>>
  %input_channel = channel %input_lane, %worker_input, %capacity, %records : reg<aie2p.array.channel : tile<4xf32>>
  %output_channel = channel %worker_output, %output_receiver, %capacity, %records : reg<aie2p.array.channel : tile<4xf32>>
  constrain.location %worker, %column, %row
  return
}

low.func.def target<amd.xdna.aie2p.core>(@repeated_sliding_window_core_target) abi(object_function) @copy_f32x4_record() asm {
  %input = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %output = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %value0 = lda %input, 0
  %value1 = lda %input, 4
  %value2 = lda %input, 8
  %value3 = lda %input, 12
  st %value0, %output, 0
  st %value1, %output, 4
  st %value2, %output, 8
  st %value3, %output, 12
  return
}

