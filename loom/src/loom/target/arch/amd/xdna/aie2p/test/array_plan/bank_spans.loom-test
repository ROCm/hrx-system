// RUN: emit aie2p-array-plan @oversized_ring

// No visible compute endpoint can fit three 32 KiB records, despite free DMA.
aie2p.target<array> @array_target

aie2p.target<core> @core_target

// ERROR@+1: TARGET/088 {channel="0", column="0", row="2", capacity="3", record_bytes="32768"}
low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) @oversized_ring() asm {
  %one = constant.u32 1 : reg<aie2p.array.scalar : index>
  %zero = constant.u32 0 : reg<aie2p.array.scalar : index>
  %capacity = constant.u32 3 : reg<aie2p.array.scalar : index>
  %row = constant.u32 2 : reg<aie2p.array.scalar : index>
  %group = group %one
  %worker = worker %group, %zero, @write_records
  %binding = binding 0, "write"
  %sender = sender %worker, 0 : reg<aie2p.array.sender : tile<8192xi32>>
  %receiver = receiver %binding, 0 : reg<aie2p.array.receiver : tile<8192xi32>>
  %channel = channel %sender, %receiver, %capacity, %one : reg<aie2p.array.channel : tile<8192xi32>>
  constrain.location %worker, %zero, %row
  return
}

low.func.def target<amd.xdna.aie2p.core>(@core_target) abi(object_function) @write_records() asm {
  %output = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %value = mov.short 7
  st %value, %output, 0
  return
}
