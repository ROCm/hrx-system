// RUN: emit aie2p-array-plan @occupied_bank_prefixes

// Persistent storage and small rings force the wide ring onto a visible neighbor.
aie2p.target<array> @array_target

aie2p.target<core> @core_target

low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) @occupied_bank_prefixes() asm {
  %one = constant.u32 1 : reg<aie2p.array.scalar : index>
  %zero = constant.u32 0 : reg<aie2p.array.scalar : index>
  %capacity = constant.u32 2 : reg<aie2p.array.scalar : index>
  %row = constant.u32 2 : reg<aie2p.array.scalar : index>
  %group = group %one
  %worker = worker %group, %zero, @write_records
  %small_binding = binding 0, "write"
  %small_sender = sender %worker, 0 : reg<aie2p.array.sender : tile<1xi32>>
  %small_receiver = receiver %small_binding, 0 : reg<aie2p.array.receiver : tile<1xi32>>
  %small_channel = channel %small_sender, %small_receiver, %capacity, %one : reg<aie2p.array.channel : tile<1xi32>>
  %binding = binding 1, "write"
  %sender = sender %worker, 1 : reg<aie2p.array.sender : tile<4112xi32>>
  %receiver = receiver %binding, 0 : reg<aie2p.array.receiver : tile<4112xi32>>
  %channel = channel %sender, %receiver, %capacity, %one : reg<aie2p.array.channel : tile<4112xi32>>
  constrain.location %worker, %zero, %row
  return
}

low.func.def target<amd.xdna.aie2p.core>(@core_target) abi(object_function) @write_records() asm {
  %small = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %output = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %allocation = storage {byte_alignment = 32768, byte_length = 20000} : low.storage<workgroup>
  %storage = storage_address %allocation : low.storage<workgroup> -> reg<aie2p.ep>
  %value = mov.short 7
  st %value, %output, 0
  st %value, %small, 0
  st %value, %storage, 0
  return
}

