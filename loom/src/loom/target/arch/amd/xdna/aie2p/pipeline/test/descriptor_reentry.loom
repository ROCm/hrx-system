// Exact values, untouched tails, and guards cover descriptor reentry through
// the ordinary source compiler and HAL, including repeated invocation bases.
pipeline.decl<kernel> @descriptor_reentry() run(%input: buffer, %output: buffer)

func.def @descriptor_reference(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %source = buffer.view %input[%origin] : buffer -> view<2176xi32>
  %destination = buffer.view %output[%origin] : buffer -> view<20x2x32xi32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %rows = index.constant 2 : index
  %c4 = index.constant 4 : index
  %reentry_stride = index.constant 8 : index
  %shape_count = index.constant 17 : index
  %count = index.constant 20 : index
  %stride = index.constant 128 : index
  scf.for %phase = [%c0 to %count step %c1] {
    %reentry = index.sub %phase, %shape_count : index
    %repeated_shape = index.mul %reentry, %reentry_stride : index
    %is_first_visit = index.cmp ult, %phase, %shape_count : index
    %shape = scf.select %is_first_visit, %phase, %repeated_shape : index
    %length = index.add %shape, %c1 : index
    %bias = index.cast %length : index to i32
    %input_base = index.mul %shape, %stride : index
    %row_elements = index.mul %length, %c4 : index
    %row_stride = index.add %row_elements, %c1 : index
    scf.for %row = [%c0 to %rows step %c1] {
      %row_offset = index.mul %row, %row_stride : index
      %row_base = index.add %input_base, %row_offset : index
      scf.for %i = [%c0 to %length step %c1] {
        %column_offset = index.mul %i, %rows : index
        %input_position = index.add %row_base, %column_offset : index
        %value = view.load %source[%input_position] : view<2176xi32> -> i32
        %result = scalar.addi %value, %bias : i32
        view.store %result, %destination[%phase, %row, %i] : i32, view<20x2x32xi32>
      }
    }
  }
  func.return
}

check.scenario public @descriptor_geometry_reentry {
  check.trial[3](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input_storage = check.generate.random.uniform seed(%seed) range(-1000000 to 1000000) : tensor<2208xi32>
    %output_storage = check.generate.fill value(-9999) : tensor<1312xi32>
    %input = check.tensor.view %input_storage offset(64) : tensor<2208xi32> -> tensor<2176xi32>
    %output = check.tensor.view %output_storage offset(64) : tensor<1312xi32> -> tensor<1280xi32>
    check.compare<@descriptor_reentry, @descriptor_reference>(%input, %output) : (tensor<2176xi32>, tensor<1280xi32>) -> () {
      check.expect.equal actual(%input_storage) expected(%input_storage) : tensor<2208xi32>
      check.expect.equal actual(%output_storage) expected(%output_storage) : tensor<1312xi32>
    }
  }
  check.return
}
