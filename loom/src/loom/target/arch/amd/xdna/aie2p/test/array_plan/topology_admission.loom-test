// RUN: emit aie2p-array-plan @no_channel

aie2p.target<array> @array_target

aie2p.target<core> @core_target

// ERROR@+1: XDNA/018 {worker_count="1", channel_count="0"}
low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) @no_channel() asm {
  %zero = constant.u32 0 : reg<aie2p.array.scalar : index>
  %one = constant.u32 1 : reg<aie2p.array.scalar : index>
  %two = constant.u32 2 : reg<aie2p.array.scalar : index>
  %group = group %one
  %worker = worker %group, %zero, @empty_worker
  constrain.location %worker, %zero, %two
  return
}

low.func.def target<amd.xdna.aie2p.core>(@core_target) abi(object_function) @empty_worker() asm {
  return
}

// ====
// RUN: emit aie2p-array-plan @missing_group_lane

aie2p.target<array> @array_target

aie2p.target<core> @core_target

low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) @missing_group_lane() asm {
  %zero = constant.u32 0 : reg<aie2p.array.scalar : index>
  %one = constant.u32 1 : reg<aie2p.array.scalar : index>
  %two = constant.u32 2 : reg<aie2p.array.scalar : index>
  // ERROR@+1: XDNA/019 {group="0", lane="1", lane_count="2", worker_count="0"}
  %group = group %two
  %worker = worker %group, %zero, @read_worker
  %input = binding 0, "read"
  %sender = sender %input, 0 : reg<aie2p.array.sender : tile<1xi32>>
  %receiver = receiver %worker, 0 : reg<aie2p.array.receiver : tile<1xi32>>
  %channel = channel %sender, %receiver, %one, %one : reg<aie2p.array.channel : tile<1xi32>>
  constrain.location %worker, %zero, %two
  return
}

low.func.def target<amd.xdna.aie2p.core>(@core_target) abi(object_function) @read_worker() asm {
  %input = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %value = lda %input, 0
  st %value, %input, 0
  return
}

