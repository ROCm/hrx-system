// ====
// RUN: emit aie2p-array-plan @occupied_location

aie2p.target<array> @array_target

aie2p.target<core> @core_target

low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) @occupied_location() asm {
  %zero = constant.u32 0 : reg<aie2p.array.scalar : index>
  %one = constant.u32 1 : reg<aie2p.array.scalar : index>
  %two = constant.u32 2 : reg<aie2p.array.scalar : index>
  %group = group %two
  %worker0 = worker %group, %zero, @empty_worker
  %worker1 = worker %group, %one, @empty_worker
  constrain.location %worker0, %zero, %two
  // ERROR@+1: XDNA/021 {worker="1", column="0", row="2", reason="another resident worker already occupies the tile"}
  constrain.location %worker1, %zero, %two
  return
}

low.func.def target<amd.xdna.aie2p.core>(@core_target) abi(object_function) @empty_worker() asm {
  return
}
