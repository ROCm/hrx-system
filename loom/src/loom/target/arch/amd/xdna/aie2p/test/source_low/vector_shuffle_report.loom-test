// RUN: compile-report target=amd.xdna.aie2p:core target-legalize{mode=final}

func.def @shuffle_not_scalarized(%value: vector<3xi16>) -> (vector<3xi16>) {
  %result = vector.shuffle<[1, 0, 1]> %value : vector<3xi16>
  func.return %result : vector<3xi16>
}

