// RUN: compile-report source-to-low,low-dce

aie2p.target<core> @target

func.def target(@target) @report_shuffle_strategies(%predicate: vector<2xi1>, %bytes: vector<2xi8>, %halves: vector<2xi16>, %words: vector<2xi32>, %wide: vector<2xi64>) -> (vector<2xi1>, vector<2xi8>, vector<2xi16>, vector<2xi32>, vector<2xi64>) {
  %predicate_result = vector.shuffle<[1, 0]> %predicate : vector<2xi1>
  %byte_result = vector.shuffle<[1, 0]> %bytes : vector<2xi8>
  %half_result = vector.shuffle<[1, 0]> %halves : vector<2xi16>
  %word_result = vector.shuffle<[1, 0]> %words : vector<2xi32>
  %wide_result = vector.shuffle<[1, 0]> %wide : vector<2xi64>
  func.return %predicate_result, %byte_result, %half_result, %word_result, %wide_result : vector<2xi1>, vector<2xi8>, vector<2xi16>, vector<2xi32>, vector<2xi64>
}

