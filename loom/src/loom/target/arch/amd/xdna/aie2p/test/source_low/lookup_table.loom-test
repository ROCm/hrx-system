// RUN: with-checks emit source-low target=amd.xdna.aie2p:core output=low

// XFAIL: AIE2P has no GPU workitem-addressed global memory surface
kernel.def @f32_table_lookup_i8_codes() {
  %unit = index.constant 1 : index
  %workgroup_size = index.constant 2 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%codes_buffer: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %base_offset = index.constant 0 : offset
  %code_stride = index.constant 4 : index
  %base = index.mul %lane, %code_stride : index
  %codes_view = buffer.view %codes_buffer[%base_offset] : buffer -> view<8xi8>
  %output_view = buffer.view %output[%base_offset] : buffer -> view<8xf32>
  %codes = vector.load %codes_view[%base] : view<8xi8> -> vector<4xi8>
  %g0 = scalar.constant -1.0 : f32
  %g1 = scalar.constant -0.5 : f32
  %g2 = scalar.constant 0.5 : f32
  %g3 = scalar.constant 1.5 : f32
  %grid = vector.from_elements %g0, %g1, %g2, %g3 : vector<4xf32>
  %decoded = vector.table.lookup %grid[%codes] : vector<4xf32>, vector<4xi8> -> vector<4xf32>
  vector.store %decoded, %output_view[%base] : vector<4xf32>, view<8xf32>
  kernel.return
}

// ----
CHECK: low.func.def * @f32_table_lookup_i8_codes(*) *

// ====

func.def @f32_table_lookup_i32_codes(%codes: vector<2xi32>) -> (vector<2xf32>) {
  %g0 = scalar.constant 2.0 : f32
  %g1 = scalar.constant -3.0 : f32
  %g2 = scalar.constant 5.0 : f32
  %grid = vector.from_elements %g0, %g1, %g2 : vector<3xf32>
  %decoded = vector.table.lookup %grid[%codes] : vector<3xf32>, vector<2xi32> -> vector<2xf32>
  func.return %decoded : vector<2xf32>
}

// ----
CHECK: low.func.def * @f32_table_lookup_i32_codes(*) *
CHECK: * = vextbcst.32 %grid, 0
CHECK: * = vextbcst.32 %grid, 2
CHECK: %decoded = vsel.32.mask64 *
CHECK: return %decoded
CHECK-NOT: * = vextract.32.reg %grid, *
CHECK-NOT: %decoded = vinsert.32.reg *

// ====

// RUN: emit source-low target=amd.xdna.aie2p:core output=low
func.def @f32_table_lookup_dynamic_grid(%grid: vector<3xf32>, %codes: vector<2xi32>) -> (vector<2xf32>) {
  %decoded = vector.table.lookup %grid[%codes] : vector<3xf32>, vector<2xi32> -> vector<2xf32>
  func.return %decoded : vector<2xf32>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @f32_table_lookup_dynamic_grid(%grid: reg<aie2p.vec256 x2>, %codes: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %22 = mov.short 0
  %23 = vbcst.32 %22
  %24 = mov.short 1
  %25 = vbcst.32 %24
  %26 = vband %codes, %25
  %27 = vlt.u32x16.el.low32 %23, %26
  %28 = predicate.complete.zero.high32 %27, 0
  %29 = mov.short 2
  %30 = vbcst.32 %29
  %31 = vband %codes, %30
  %32 = vlt.u32x16.el.low32 %23, %31
  %33 = predicate.complete.zero.high32 %32, 0
  %34 = vextbcst.32 %grid, 0
  %35 = vextbcst.32 %grid, 1
  %36 = vsel.32.mask64 %34, %35, %28
  %37 = vextbcst.32 %grid, 2
  %decoded = vsel.32.mask64 %36, %37, %33
  return %decoded
}

// ====

// RUN: emit source-low target=amd.xdna.aie2p:core output=low
func.def @i8_table_lookup_fact_known_codes(%grid: vector<4xi8>) -> (vector<4xi8>) {
  %c0 = scalar.constant 0 : i8
  %c1 = scalar.constant 1 : i8
  %c2 = scalar.constant 2 : i8
  %c3 = scalar.constant 3 : i8
  %codes = vector.from_elements %c2, %c0, %c3, %c1 : vector<4xi8>
  %decoded = vector.table.lookup %grid[%codes] : vector<4xi8>, vector<4xi8> -> vector<4xi8>
  func.return %decoded : vector<4xi8>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i8_table_lookup_fact_known_codes(%grid: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %11 = vextbcst.8 %grid, 2
  %12 = vextbcst.8 %grid, 0
  %13 = predicate.constant.low32 2
  %14 = predicate.complete.zero.high32 %13, 0
  %15 = vsel.8 %11, %12, %14
  %16 = vextbcst.8 %grid, 3
  %17 = predicate.constant.low32 4
  %18 = predicate.complete.zero.high32 %17, 0
  %19 = vsel.8 %15, %16, %18
  %20 = vextbcst.8 %grid, 1
  %21 = predicate.constant.low32 8
  %22 = predicate.complete.zero.high32 %21, 0
  %decoded = vsel.8 %19, %20, %22
  return %decoded
}

// ====

// RUN: emit source-low target=amd.xdna.aie2p:core output=low
func.def @i8_table_lookup_constant_table() -> (vector<4xi8>) {
  %g0 = scalar.constant -4 : i8
  %g1 = scalar.constant -1 : i8
  %g2 = scalar.constant 2 : i8
  %g3 = scalar.constant 7 : i8
  %grid = vector.from_elements %g0, %g1, %g2, %g3 : vector<4xi8>
  %c0 = scalar.constant 0 : i8
  %c1 = scalar.constant 1 : i8
  %c2 = scalar.constant 2 : i8
  %c3 = scalar.constant 3 : i8
  %codes = vector.from_elements %c3, %c2, %c1, %c0 : vector<4xi8>
  %decoded = vector.table.lookup %grid[%codes] : vector<4xi8>, vector<4xi8> -> vector<4xi8>
  func.return %decoded : vector<4xi8>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i8_table_lookup_constant_table() -> (reg<aie2p.vec256 x2>) asm {
  %g0 = mov.short -4
  %g1 = mov.short -1
  %g2 = mov.short 2
  %g3 = mov.short 7
  %18 = vbcst.8 %g3
  %19 = vpush.lo.8 %g2, %18
  %20 = vpush.lo.8 %g1, %19
  %grid = vpush.lo.8 %g0, %20
  %22 = vextbcst.8 %grid, 3
  %23 = vextbcst.8 %grid, 2
  %24 = predicate.constant.low32 2
  %25 = predicate.complete.zero.high32 %24, 0
  %26 = vsel.8 %22, %23, %25
  %27 = vextbcst.8 %grid, 1
  %28 = predicate.constant.low32 4
  %29 = predicate.complete.zero.high32 %28, 0
  %30 = vsel.8 %26, %27, %29
  %31 = vextbcst.8 %grid, 0
  %32 = predicate.constant.low32 8
  %33 = predicate.complete.zero.high32 %32, 0
  %decoded = vsel.8 %30, %31, %33
  return %decoded
}

// ====

func.def @i8_table_lookup_u4_dynamic_table(%grid: vector<16xi8>, %packed: vector<2xi8>) -> (vector<4xi8>) {
  %codes = vector.bitunpacku<4> %packed : vector<2xi8> -> vector<4xi8>
  %decoded = vector.table.lookup %grid[%codes] : vector<16xi8>, vector<4xi8> -> vector<4xi8>
  func.return %decoded : vector<4xi8>
}

// ----
CHECK: * = and *, *
CHECK: * = lshl *, *
CHECK: * = vextbcst.8 %grid, 0
CHECK: * = vextbcst.8 %grid, 15
CHECK: %decoded = vsel.8 *
CHECK-NOT: * = vextract.8.reg %grid, *
CHECK-NOT: %decoded = vinsert.8.reg *

// ====

func.def @i8_table_lookup_masked_codes(%grid: vector<16xi8>, %packed: vector<4xi8>) -> (vector<4xi8>) {
  %mask = vector.splati 15 : vector<4xi8>
  %codes = vector.andi %packed, %mask : vector<4xi8>
  %decoded = vector.table.lookup %grid[%codes] : vector<16xi8>, vector<4xi8> -> vector<4xi8>
  func.return %decoded : vector<4xi8>
}

// ----
CHECK: %codes = vband %packed, %mask
CHECK: * = vextbcst.8 %grid, 0
CHECK: * = vextbcst.8 %grid, 15
CHECK: %decoded = vsel.8 *
CHECK-NOT: * = vextract.8.reg %grid, *
CHECK-NOT: %decoded = vinsert.8.reg *

// ====

func.def @i8_table_lookup_shifted_codes(%grid: vector<16xi8>, %packed: vector<4xi8>) -> (vector<4xi8>) {
  %shift = vector.splati 4 : vector<4xi8>
  %codes = vector.shrui %packed, %shift : vector<4xi8>
  %decoded = vector.table.lookup %grid[%codes] : vector<16xi8>, vector<4xi8> -> vector<4xi8>
  func.return %decoded : vector<4xi8>
}

// ----
CHECK: * = vups.4x.x-to-d.unsigned %packed, *
CHECK: %codes = vsrs.4x.d-to-x.unsigned *, *
CHECK: * = vextbcst.8 %grid, 0
CHECK: * = vextbcst.8 %grid, 15
CHECK: %decoded = vsel.8 *
CHECK-NOT: * = vextract.8.imm %packed, *
CHECK-NOT: %codes = vinsert.8.reg *
CHECK-NOT: * = vextract.8.reg %grid, *
CHECK-NOT: %decoded = vinsert.8.reg *

