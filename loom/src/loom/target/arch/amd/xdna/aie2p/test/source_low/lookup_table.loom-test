low.func.def target<amd.xdna.aie2p.core> abi(object_function) @f32_table_lookup_i32_codes(%codes: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %g1 = mov.i32 -1069547520
  %g2 = mov.i32 1084227584
  %24 = mov.i32 1073741824
  %25 = vbcst.32 %24
  %26 = mov.short 1
  %27 = copy %26 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %28 = vinsert.32.reg %25, %27, %g1
  %29 = mov.short 2
  %30 = copy %29 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %grid = vinsert.32.reg %28, %30, %g2
  %32 = vextract.32.imm %codes, 0
  %33 = vextract.32.reg %grid, %32
  %34 = vextract.32.imm %codes, 1
  %35 = vextract.32.reg %grid, %34
  %36 = vbcst.32 %33
  %38 = copy %26 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %decoded = vinsert.32.reg %36, %38, %35
  return %decoded
}

