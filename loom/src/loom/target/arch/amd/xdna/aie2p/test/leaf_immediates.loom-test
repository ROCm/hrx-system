code: 5c 00 50 40 01 08 00 00 00 00 00 00 00 00 00 00

// ====

// Every core field is required before positional encoding can consume it.
// RUN: verify

low.func.def target<amd.xdna.aie2p.core> @missing(%address: reg<aie2p.em>, %id: reg<aie2p.er>) {
  // ERROR@+1: TARGET/047 "nw"
  low.op<amd.xdna.aie2p.stream.write.control-packet>(%address, %id) {op = 1} : (reg<aie2p.em>, reg<aie2p.er>)
  low.return
}

// ====

// Unknown dictionary fields cannot shift the positions of verified fields.
// RUN: verify

low.func.def target<amd.xdna.aie2p.core> @unexpected(%address: reg<aie2p.em>, %id: reg<aie2p.er>) {
  // ERROR@+1: TARGET/048 "extra"
  low.op<amd.xdna.aie2p.stream.write.control-packet>(%address, %id) {extra = 0, nw = 2, op = 1} : (reg<aie2p.em>, reg<aie2p.er>)
  low.return
}

// ====

// Positional fields retain their descriptor's numeric type contract.
// RUN: verify

low.func.def target<amd.xdna.aie2p.core> @wrong_kind(%address: reg<aie2p.em>, %id: reg<aie2p.er>) asm {
  // ERROR@+1: TARGET/049 "nw"
  mov.cph %address, %id, "two", 1
  return
}

// ====

// Concrete constants select short MV-slot encodings, including rematerialized
// byte offsets and DJ address indices. Neighboring values retain LNG slots.
// RUN: emit aie2p-leaf @constant_forms report=code

aie2p.target<core> @target

low.func.def target<amd.xdna.aie2p.core>(@target) @constant_forms(%output: reg<aie2p.ep>) asm {
  %lower = mov.i32 -1024
  %upper = mov.i32 1023
  %below = mov.i32 -1025
  %above = mov.i32 1024
  %mask = mov.i32 -1
  %zero = mov.i32 0
  %offset = mov.static-byte-offset 16
  %index = mov.static-address-index 20
  st.volatile %lower, %output, 0
  st.volatile %upper, %output, 4
  st.volatile %below, %output, 8
  st.volatile %above, %output, 12
  st.volatile %mask, %output, 16
  st.i32.index.volatile %zero, %output, %index
  st.volatile %offset, %output, 24
  return
}

