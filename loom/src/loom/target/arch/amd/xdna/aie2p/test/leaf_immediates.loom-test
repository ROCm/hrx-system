// Register and signed-byte additions retain their DJ destination encoding.
// RUN: emit aie2p-leaf @address_indices report=code

aie2p.target<core> @target

low.func.def target<amd.xdna.aie2p.core>(@target) @address_indices(%pointer: reg<aie2p.ep>, %origin: reg<aie2p.er>, %bias: reg<aie2p.er>, %value: reg<aie2p.er>) asm {
  %lower = add.address-index.immediate %origin, -128
  %upper = add.address-index.immediate %origin, 127
  %dynamic = add.address-index %origin, %bias
  st.i8.index.volatile %value, %pointer, %lower
  st.i8.index.volatile %value, %pointer, %upper
  st.i8.index.volatile %value, %pointer, %dynamic
  return
}

