// ====
// RUN: emit source-low target=amd.xdna.aie2p:core output=low

// Different materializing buffers require correlated root/origin selection.
// Common-root offset decomposition alone does not cover this case.
func.def @selected_distinct_root_packets(%first_input: buffer, %second_input: buffer, %first_offset: offset, %second_offset: offset, %read_first: i1, %write_first: i1) {
  %first_storage = buffer.assume.alignment %first_input {minimum_alignment = 64} : buffer
  %second_storage = buffer.assume.alignment %second_input {minimum_alignment = 64} : buffer
  %first_origin = index.assume %first_offset [range(%first_offset, 0, 128), multiple_of(%first_offset, 64)] : offset
  %second_origin = index.assume %second_offset [range(%second_offset, 256, 384), multiple_of(%second_offset, 64)] : offset
  %first = buffer.view %first_storage[%first_origin] : buffer -> view<8xbf16>
  %second = buffer.view %second_storage[%second_origin] : buffer -> view<8xbf16>
  %source = scf.select %read_first, %first, %second : view<8xbf16>
  %destination = scf.select %write_first, %first, %second : view<8xbf16>
  %packet = vector.load %source[0] : view<8xbf16> -> vector<8xbf16>
  vector.store %packet, %destination[0] : vector<8xbf16>, view<8xbf16>
  func.return
}

