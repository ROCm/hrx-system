low.func.def target<amd.xdna.aie2p.core> abi(object_function) @selected_distinct_root_packets(%first_origin: reg<aie2p.er>, %second_origin: reg<aie2p.er>, %read_first: reg<aie2p.er>, %write_first: reg<aie2p.er>) asm {
  %first_storage = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %second_storage = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  low.cond_br %read_first, ^_bb1, ^_bb2 : reg<aie2p.er>
^_bb1:
  low.br ^_bb3(%first_storage: reg<aie2p.ep>, %first_origin: reg<aie2p.er>)
^_bb2:
  low.br ^_bb3(%second_storage: reg<aie2p.ep>, %second_origin: reg<aie2p.er>)
^_bb3(%source: reg<aie2p.ep>, %source_offset: reg<aie2p.er>):
  low.cond_br %write_first, ^_bb4, ^_bb5 : reg<aie2p.er>
^_bb4:
  low.br ^_bb6(%first_storage: reg<aie2p.ep>, %first_origin: reg<aie2p.er>)
^_bb5:
  low.br ^_bb6(%second_storage: reg<aie2p.ep>, %second_origin: reg<aie2p.er>)
^_bb6(%destination: reg<aie2p.ep>, %destination_offset: reg<aie2p.er>):
  %38 = mov.address-index %source_offset
  %39 = vlda.128.bf16x8.index %source, %38
  %42 = mov.address-index %destination_offset
  vst.128.bf16x8.index %39, %destination, %42
  return
}

// ====
// RUN: emit source-low target=amd.xdna.aie2p:core output=low

// Four-byte alignment is sufficient for i32 but not a 16-byte memory packet.
// Finite dynamic origins must not be mistaken for stronger alignment.
func.def @selected_under_aligned_packets(%input: buffer, %first_input: offset, %second_input: offset, %read_first: i1, %write_first: i1) {
  %storage = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %first_origin = index.assume %first_input [range(%first_input, 0, 128), multiple_of(%first_input, 4)] : offset
  %second_origin = index.assume %second_input [range(%second_input, 256, 384), multiple_of(%second_input, 4)] : offset
  %first = buffer.view %storage[%first_origin] : buffer -> view<4xi32>
  %second = buffer.view %storage[%second_origin] : buffer -> view<4xi32>
  %source = scf.select %read_first, %first, %second : view<4xi32>
  %destination = scf.select %write_first, %first, %second : view<4xi32>
  %packet = vector.load %source[0] : view<4xi32> -> vector<4xi32>
  vector.store %packet, %destination[0] : vector<4xi32>, view<4xi32>
  func.return
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @selected_under_aligned_packets(%first_origin: reg<aie2p.er>, %second_origin: reg<aie2p.er>, %read_first: reg<aie2p.er>, %write_first: reg<aie2p.er>) asm {
  %destination = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %39 = copy %read_first : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %source_offset = sel.nez %first_origin, %second_origin, %39
  %41 = copy %write_first : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %destination_offset = sel.nez %first_origin, %second_origin, %41
  %43 = mov.address-index %source_offset
  %44 = lda.i32.index %destination, %43
  %45 = add.address-index.immediate %source_offset, 4
  %46 = lda.i32.index %destination, %45
  %47 = add.address-index.immediate %source_offset, 8
  %48 = lda.i32.index %destination, %47
  %49 = add.address-index.immediate %source_offset, 12
  %50 = lda.i32.index %destination, %49
  %51 = mov.address-index %destination_offset
  st.i32.index %44, %destination, %51
  %52 = add.address-index.immediate %destination_offset, 4
  st.i32.index %46, %destination, %52
  %53 = add.address-index.immediate %destination_offset, 8
  st.i32.index %48, %destination, %53
  %54 = add.address-index.immediate %destination_offset, 12
  st.i32.index %50, %destination, %54
  return
}
