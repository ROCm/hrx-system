// Selected and carried view origins retain packet addressing through the
// complete source pipeline, including subview biases and strided dimensions.
// RUN: emit source-low target=amd.xdna.aie2p:core output=low

func.def @selected_dynamic_rank1_packets(%input: buffer, %first_input: offset, %second_input: offset, %read_first: i1, %write_first: i1) {
  %storage = buffer.assume.alignment %input {minimum_alignment = 64} : buffer
  %first_origin = index.assume %first_input [range(%first_input, 0, 128), multiple_of(%first_input, 64)] : offset
  %second_origin = index.assume %second_input [range(%second_input, 256, 384), multiple_of(%second_input, 64)] : offset
  %first_whole = buffer.view %storage[%first_origin] : buffer -> view<32xbf16>
  %second_whole = buffer.view %storage[%second_origin] : buffer -> view<32xbf16>
  %first = view.subview %first_whole[8] : view<32xbf16> -> view<24xbf16>
  %second = view.subview %second_whole[8] : view<32xbf16> -> view<24xbf16>
  %source = scf.select %read_first, %first, %second : view<24xbf16>
  %destination = scf.select %write_first, %first, %second : view<24xbf16>
  %packet = vector.load %source[0] : view<24xbf16> -> vector<8xbf16>
  vector.store %packet, %destination[0] : vector<8xbf16>, view<24xbf16>
  func.return
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @selected_dynamic_rank1_packets(%first_origin: reg<aie2p.er>, %second_origin: reg<aie2p.er>, %read_first: reg<aie2p.er>, %write_first: reg<aie2p.er>) asm {
  %destination = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %26 = mov.short 16
  %27 = add.rr %first_origin, %26
  %28 = add.rr %second_origin, %26
  %29 = copy %read_first : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %source_offset = sel.nez %27, %28, %29
  %31 = copy %write_first : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %destination_offset = sel.nez %27, %28, %31
  %36 = mov.address-index %source_offset
  %37 = vlda.128.bf16x8.index %destination, %36
  %40 = mov.address-index %destination_offset
  vst.128.bf16x8.index %37, %destination, %40
  return
}

// ====
// RUN: emit source-low target=amd.xdna.aie2p:core output=low

func.def @selected_dynamic_rank2_packets(%input: buffer, %first_input: offset, %second_input: offset, %row_input: index, %read_first: i1, %write_first: i1) {
  %storage = buffer.assume.alignment %input {minimum_alignment = 64} : buffer
  %first_origin = index.assume %first_input [range(%first_input, 0, 128), multiple_of(%first_input, 64)] : offset
  %second_origin = index.assume %second_input [range(%second_input, 512, 640), multiple_of(%second_input, 64)] : offset
  %row = index.assume %row_input [range(%row_input, 0, 3)] : index
  %first_whole = buffer.view %storage[%first_origin] : buffer -> view<4x32xbf16, #encoding.layout.strided<strides=[32, 1]>>
  %second_whole = buffer.view %storage[%second_origin] : buffer -> view<4x32xbf16, #encoding.layout.strided<strides=[32, 1]>>
  %first = view.subview %first_whole[0, 8] : view<4x32xbf16, #encoding.layout.strided<strides=[32, 1]>> -> view<4x24xbf16, #encoding.layout.strided<strides=[32, 1]>>
  %second = view.subview %second_whole[0, 8] : view<4x32xbf16, #encoding.layout.strided<strides=[32, 1]>> -> view<4x24xbf16, #encoding.layout.strided<strides=[32, 1]>>
  %source = scf.select %read_first, %first, %second : view<4x24xbf16, #encoding.layout.strided<strides=[32, 1]>>
  %destination = scf.select %write_first, %first, %second : view<4x24xbf16, #encoding.layout.strided<strides=[32, 1]>>
  %packet = vector.load %source[%row, 0] : view<4x24xbf16, #encoding.layout.strided<strides=[32, 1]>> -> vector<8xbf16>
  vector.store %packet, %destination[%row, 0] : vector<8xbf16>, view<4x24xbf16, #encoding.layout.strided<strides=[32, 1]>>
  func.return
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @selected_dynamic_rank2_packets(%first_origin: reg<aie2p.er>, %second_origin: reg<aie2p.er>, %row: reg<aie2p.er>, %read_first: reg<aie2p.er>, %write_first: reg<aie2p.er>) asm {
  %destination = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %29 = mov.short 16
  %30 = add.rr %first_origin, %29
  %31 = add.rr %second_origin, %29
  %32 = copy %read_first : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %source_offset = sel.nez %30, %31, %32
  %34 = copy %write_first : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %destination_offset = sel.nez %30, %31, %34
  %39 = mov.i32 6
  %40 = lshl %row, %39
  %41 = add.rr %source_offset, %40
  %42 = mov.address-index %41
  %43 = vlda.128.bf16x8.index %destination, %42
  %48 = add.rr %destination_offset, %40
  %49 = mov.address-index %48
  vst.128.bf16x8.index %43, %destination, %49
  return
}

// ====
// RUN: emit source-low target=amd.xdna.aie2p:core output=low

// Loop arguments retain the view origins while current and previous roles swap.
// Reads and writes remain packet operations.
func.def @rotating_selected_rank1_packets(%input: buffer, %first_input: offset, %second_input: offset, %count_input: index, %read_first: i1, %write_first: i1) {
  %storage = buffer.assume.alignment %input {minimum_alignment = 64} : buffer
  %first_origin = index.assume %first_input [range(%first_input, 0, 128), multiple_of(%first_input, 64)] : offset
  %second_origin = index.assume %second_input [range(%second_input, 256, 384), multiple_of(%second_input, 64)] : offset
  %count = index.assume %count_input [range(%count_input, 0, 3)] : index
  %first_whole = buffer.view %storage[%first_origin] : buffer -> view<32xbf16>
  %second_whole = buffer.view %storage[%second_origin] : buffer -> view<32xbf16>
  %first = view.subview %first_whole[8] : view<32xbf16> -> view<24xbf16>
  %second = view.subview %second_whole[8] : view<32xbf16> -> view<24xbf16>
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %packet_width = index.constant 8 : index
  %last, %other = scf.for %iteration = [%begin to %count step %step](%current = %first : view<24xbf16>, %previous = %second : view<24xbf16>) -> (view<24xbf16>, view<24xbf16>) {
    %position = index.mul %iteration, %packet_width : index
    %source = scf.select %read_first, %current, %previous : view<24xbf16>
    %destination = scf.select %write_first, %current, %previous : view<24xbf16>
    %packet = vector.load %source[%position] : view<24xbf16> -> vector<8xbf16>
    vector.store %packet, %destination[%position] : vector<8xbf16>, view<24xbf16>
    scf.yield %previous, %current : view<24xbf16>, view<24xbf16>
  }
  func.return
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @rotating_selected_rank1_packets(%first_origin: reg<aie2p.er>, %second_origin: reg<aie2p.er>, %count: reg<aie2p.er>, %read_first: reg<aie2p.er>, %write_first: reg<aie2p.er>) asm {
  %destination = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %55 = mov.short 16
  %56 = add.rr %first_origin, %55
  %57 = add.rr %second_origin, %55
  %begin = mov.short 0
  %step = mov.short 1
  low.br ^_bb1(%begin: reg<aie2p.er>, %56: reg<aie2p.er>, %57: reg<aie2p.er>)
^_bb1(%iteration: reg<aie2p.er>, %current_offset: reg<aie2p.er>, %previous_offset: reg<aie2p.er>):
  %60 = lt %iteration, %count
  low.cond_br %60, ^_bb2, ^_bb3 : reg<aie2p.er>
^_bb2:
  %61 = copy %read_first : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %source_offset = sel.nez %current_offset, %previous_offset, %61
  %63 = copy %write_first : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %destination_offset = sel.nez %current_offset, %previous_offset, %63
  %68 = mov.i32 4
  %69 = lshl %iteration, %68
  %70 = add.rr %source_offset, %69
  %71 = mov.address-index %70
  %72 = vlda.128.bf16x8.index %destination, %71
  %77 = add.rr %destination_offset, %69
  %78 = mov.address-index %77
  vst.128.bf16x8.index %72, %destination, %78
  %79 = add.rr %iteration, %step
  low.br ^_bb1(%79: reg<aie2p.er>, %previous_offset: reg<aie2p.er>, %current_offset: reg<aie2p.er>)
^_bb3:
  return
}

