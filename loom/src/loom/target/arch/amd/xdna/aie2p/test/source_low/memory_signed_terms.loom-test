// RUN: emit source-low target=amd.xdna.aie2p:core output=low

// Exact AIE2P address-materialization contracts not owned by executable scenarios.

func.def @signed_irregular_stride(%input: buffer, %table: buffer) -> (i32) {
  %source_origin = index.constant 0 : offset
  %source = buffer.view %input[%source_origin] : buffer -> view<1xi32>
  %raw = view.load %source[0] : view<1xi32> -> i32
  %signed = scalar.assume %raw [range(%raw, -128, 127)] : i32
  %position = index.cast %signed : i32 to index
  %bias = index.constant 128 : index
  %ordinal = index.add %position, %bias : index
  %base = index.constant 0 : offset
  %layout = encoding.layout.strided [3] : encoding<layout>
  %view = buffer.view %table[%base] : buffer -> view<256xi32, %layout>
  %value = view.load %view[%ordinal] : view<256xi32, %layout> -> i32
  func.return %value : i32
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @signed_irregular_stride() -> (reg<aie2p.er>) asm {
  %input = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %table = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %signed = lda %input, 0
  %18 = mov.static-byte-offset 1536
  %19 = mov.i32 12
  %20 = mac %18, %signed, %19
  %21 = mov.address-index %20
  %value = lda.i32.index %table, %21
  return %value
}

// ====

func.def @signed_dynamic_stride(%input: buffer, %bias0: index, %stride0: index, %table: buffer) -> (i32) {
  %source_origin = index.constant 0 : offset
  %source = buffer.view %input[%source_origin] : buffer -> view<1xi32>
  %raw = view.load %source[0] : view<1xi32> -> i32
  %signed = scalar.assume %raw [range(%raw, -128, 127)] : i32
  %coordinate = index.cast %signed : i32 to index
  %bias = index.assume %bias0 [range(%bias0, 128, 256)] : index
  %stride = index.assume %stride0 [range(%stride0, 1, 16)] : index
  %position = index.add %coordinate, %bias : index
  %base = index.constant 0 : offset
  %layout = encoding.layout.strided [%stride] : encoding<layout>
  %view = buffer.view %table[%base] : buffer -> view<512xi32, %layout>
  %value = view.load %view[%position] : view<512xi32, %layout> -> i32
  func.return %value : i32
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @signed_dynamic_stride(%bias: reg<aie2p.er>, %stride: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %input = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %table = resource<native_pointer> {index = 3, source_type = buffer} : reg<aie2p.ep>
  %signed = lda %input, 0
  %23 = mul %bias, %stride
  %24 = mov.i32 2
  %25 = lshl %23, %24
  %26 = mul %signed, %stride
  %28 = lshl %26, %24
  %29 = add.nc %25, %28
  %30 = mov.address-index %29
  %value = lda.i32.index %table, %30
  return %value
}

// ====

func.def @dynamic_stride_static_bias(%table: buffer, %position0: index, %stride0: index) -> (i8) {
  %position = index.assume %position0 [range(%position0, 0, 31)] : index
  %stride = index.assume %stride0 [range(%stride0, 1, 16)] : index
  %base = index.constant 128 : offset
  %layout = encoding.layout.strided [%stride] : encoding<layout>
  %view = buffer.view %table[%base] : buffer -> view<32xi8, %layout>
  %value = view.load %view[%position] : view<32xi8, %layout> -> i8
  func.return %value : i8
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @dynamic_stride_static_bias(%position: reg<aie2p.er>, %stride: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %table = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %14 = mov.static-byte-offset 128
  %15 = mac %14, %position, %stride
  %16 = mov.address-index %15
  %value = lda.i8.index %table, %16
  return %value
}

// ====

func.def @signed_wide_source(%input: i64, %table: buffer) -> (i32) {
  %signed = scalar.assume %input [range(%input, -128, 127)] : i64
  %bias = scalar.constant 128 : i64
  %ordinal = scalar.addi %signed, %bias : i64
  %position = index.cast %ordinal : i64 to index
  %base = index.constant 0 : offset
  %view = buffer.view %table[%base] : buffer -> view<256xi32>
  %value = view.load %view[%position] : view<256xi32> -> i32
  func.return %value : i32
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @signed_wide_source(%signed: reg<aie2p.er x2>) -> (reg<aie2p.er>) asm {
  %table = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %13 = mov.static-byte-offset 512
  %14 = slice %signed[0] : reg<aie2p.er x2> -> reg<aie2p.er>
  %15 = mov.i32 4
  %16 = mac %13, %14, %15
  %17 = mov.address-index %16
  %value = lda.i32.index %table, %17
  return %value
}

// ====

func.def @negative_varying_coefficient(%input: buffer, %table: buffer) -> (i32) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<1xi32>
  %raw = view.load %source[0] : view<1xi32> -> i32
  %signed = scalar.assume %raw [range(%raw, -1, 0)] : i32
  %coordinate = index.cast %signed : i32 to index
  %c0 = index.constant 0 : index
  %position = index.sub %c0, %coordinate : index
  %word_bytes = index.constant 4 : offset
  %origin = index.scale %position, %word_bytes : index, offset -> offset
  %view = buffer.view %table[%origin] : buffer -> view<1xi32>
  %value = view.load %view[0] : view<1xi32> -> i32
  func.return %value : i32
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @negative_varying_coefficient() -> (reg<aie2p.er>) asm {
  %input = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %table = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %coordinate = lda %input, 0
  %c0 = mov.short 0
  %position = sub %c0, %coordinate
  %word_bytes = mov.short 4
  %origin = mul %position, %word_bytes
  %22 = mov.address-index %origin
  %value = lda.i32.index %table, %22
  return %value
}

// ====

// Backward scalar accesses and dynamic packet origins retain the target-native
// address register without widening their arithmetic.
func.def @load_before_origin(%input: buffer) -> (i32) {
  %backward = index.constant -4 : index
  %view = buffer.view %input[%backward] : buffer -> view<1xi32>
  %value = view.load %view[0] : view<1xi32> -> i32
  func.return %value : i32
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @load_before_origin() -> (reg<aie2p.er>) asm {
  %input = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %backward = mov.short -4
  %8 = mov.address-index %backward
  %value = lda.i32.index %input, %8
  return %value
}

// ====

func.def @copy_signed_origin(%input: buffer, %output: buffer, %position_input: index) {
  %aligned_input = buffer.assume.alignment %input {minimum_alignment = 16} : buffer
  %aligned_output = buffer.assume.alignment %output {minimum_alignment = 16} : buffer
  %position = index.assume %position_input [range(%position_input, -64, 64), multiple_of(%position_input, 16)] : index
  %source = buffer.view %aligned_input[%position] : buffer -> view<4xi32>
  %destination = buffer.view %aligned_output[%position] : buffer -> view<4xi32>
  %values = vector.load %source[0] : view<4xi32> -> vector<4xi32>
  vector.store %values, %destination[0] : vector<4xi32>, view<4xi32>
  func.return
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @copy_signed_origin(%position: reg<aie2p.er>) asm {
  %aligned_input = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %aligned_output = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %15 = mov.address-index %position
  %16 = vlda.128.i32x4.index %aligned_input, %15
  vst.128.i32x4.index %16, %aligned_output, %15
  return
}
