// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @signed_halfword_comparison(%lhs: reg<aie2p.vec256 x2>, %rhs: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %13 = vge.s16x32.el.low32 %lhs, %rhs
  %mask = predicate.complete.zero.high32 %13, 0
  %15 = mov.short 1
  %16 = vbcst.32 %15
  %17 = mov.short 0
  %18 = vbcst.32 %17
  %result = vsel.32.mask64 %18, %16, %mask
  return %result
}

// ====

func.def @halfword_equality(%lhs: vector<2xi16>, %rhs: vector<2xi16>) -> (vector<2xi32>) {
  %mask = vector.cmpi eq, %lhs, %rhs : vector<2xi16> -> vector<2xi1>
  %result = vector.extui %mask : vector<2xi1> to vector<2xi32>
  func.return %result : vector<2xi32>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @halfword_equality(%lhs: reg<aie2p.vec256 x2>, %rhs: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %13 = vsub.16 %lhs, %rhs
  %14 = veqz.16.el.low32 %13
  %mask = predicate.complete.zero.high32 %14, 0
  %16 = mov.short 1
  %17 = vbcst.32 %16
  %18 = mov.short 0
  %19 = vbcst.32 %18
  %result = vsel.32.mask64 %19, %17, %mask
  return %result
}

