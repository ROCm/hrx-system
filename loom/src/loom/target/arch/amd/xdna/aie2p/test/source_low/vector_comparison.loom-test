  %70 = vsub.32 %62, %66
  %71 = vsel.32.mask64 %69, %70, %68
  %72 = vsub.32 %48, %58
  %73 = veqz.32.el.low32 %72
  %74 = predicate.complete.zero.high32 %73, 0
  %75 = vsel.32.mask64 %rhs, %58, %74
  %76 = vlt.s32x16.el.low32 %75, %58
  %77 = predicate.complete.zero.high32 %76, 0
  %78 = vadd.32 %75, %60
  %79 = vsub.32 %62, %75
  %80 = vsel.32.mask64 %78, %79, %77
  %81 = vlt.u32x16.el.low32 %71, %80
  %82 = predicate.complete.zero.high32 %81, 0
  %83 = predicate.and.low32.rhs_tied %82, %56
  %84 = predicate.and.high32.rhs_tied %82, %83
