func.def @wide_integer_comparison(%lhs: vector<2xi64>, %rhs: vector<2xi64>) -> (vector<2xi32>) {
  %mask = vector.cmpi ugt, %lhs, %rhs : vector<2xi64> -> vector<2xi1>
  %result = vector.extui %mask : vector<2xi1> to vector<2xi32>
  func.return %result : vector<2xi32>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @wide_integer_comparison(%lhs: reg<aie2p.vec256 x2>, %rhs: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %13 = mova.i32 4
  %14 = mova.i32 5
  %15 = vshuffle %lhs, %lhs, %13
  %16 = vshuffle %lhs, %lhs, %14
  %17 = vshuffle %rhs, %rhs, %13
  %18 = vshuffle %rhs, %rhs, %14
  %19 = vsub.32 %18, %16
  %20 = veqz.32.el.low32 %19
  %21 = vlt.u32x16.el.low32 %18, %16
  %22 = vlt.u32x16.el.low32 %17, %15
  %23 = predicate.and.low32 %20, %22
  %24 = predicate.or.low32 %21, %23
  %mask = predicate.complete.zero.high32 %24, 0
  %26 = mov.short 1
  %27 = vbcst.32 %26
  %28 = mov.short 0
  %29 = vbcst.32 %28
  %result = vsel.32.mask64 %29, %27, %mask
  return %result
}

