func.def @observe_byte(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<1xi8>
  %destination = buffer.view %output[%base] : buffer -> view<2xi8>
  %first = view.load<volatile> %source[0] : view<1xi8> -> i8
  %second = view.load<volatile> %source[0] : view<1xi8> -> i8
  view.store<volatile> %first, %destination[0] : i8, view<2xi8>
  view.store<volatile> %second, %destination[1] : i8, view<2xi8>
  func.return
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @observe_byte() asm {
  %source = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %destination = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %first = lda.u8.volatile<volatile> %source, 0
  %second = lda.u8.volatile<volatile> %source, 0
  st.s8.volatile<volatile> %first, %destination, 0
  st.s8.volatile<volatile> %second, %destination, 1
  return
}

