aie2p.target<core> @target

low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @i32x2x2_insert_static(%values: reg<aie2p.vec256 x2>, %value: reg<aie2p.er>) -> (reg<aie2p.vec256 x2>) asm {
  %22 = vextract.32.imm %values, 0
  %23 = vextract.32.imm %values, 1
  %24 = vextract.32.imm %values, 2
  %25 = vbcst.32 %22
  %26 = mov.short 1
  %27 = copy %26 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %28 = vinsert.32.reg %25, %27, %23
  %29 = mov.short 2
  %30 = copy %29 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %31 = vinsert.32.reg %28, %30, %24
  %32 = mov.short 3
  %33 = copy %32 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %result = vinsert.32.reg %31, %33, %value
  return %result
}

