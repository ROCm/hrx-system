low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @i32x16_insert_static(%values: reg<aie2p.vec256 x2>, %value: reg<aie2p.er>) -> (reg<aie2p.vec256 x2>) asm {
  %7 = mov.short 15
  %8 = copy %7 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
