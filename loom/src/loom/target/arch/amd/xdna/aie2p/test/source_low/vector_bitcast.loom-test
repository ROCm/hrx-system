// ====

func.def @i8x2_f16_shape_changing_bitcast(%bytes: vector<2xi8>, %half: vector<1xf16>) -> (vector<1xf16>, vector<2xi8>) {
  %to_half = vector.bitcast %bytes : vector<2xi8> to vector<1xf16>
  %to_bytes = vector.bitcast %half : vector<1xf16> to vector<2xi8>
  func.return %to_half, %to_bytes : vector<1xf16>, vector<2xi8>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i8x2_f16_shape_changing_bitcast(%to_half: reg<aie2p.vec256 x2>, %to_bytes: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) asm {
  return %to_half, %to_bytes
}

// ====

func.def @i8x2_bf16_shape_changing_bitcast(%bytes: vector<2xi8>, %half: vector<1xbf16>) -> (vector<1xbf16>, vector<2xi8>) {
  %to_half = vector.bitcast %bytes : vector<2xi8> to vector<1xbf16>
  %to_bytes = vector.bitcast %half : vector<1xbf16> to vector<2xi8>
  func.return %to_half, %to_bytes : vector<1xbf16>, vector<2xi8>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i8x2_bf16_shape_changing_bitcast(%to_half: reg<aie2p.vec256 x2>, %to_bytes: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) asm {
  return %to_half, %to_bytes
}

// ====

func.def @f8e4m3_i8x4_bitcast(%floats: vector<4xf8E4M3>, %bytes: vector<4xi8>) -> (vector<4xi8>, vector<4xf8E4M3>) {
  %encoded_bits = vector.bitcast %floats : vector<4xf8E4M3> to vector<4xi8>
  %encoded = vector.bitcast %bytes : vector<4xi8> to vector<4xf8E4M3>
  func.return %encoded_bits, %encoded : vector<4xi8>, vector<4xf8E4M3>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @f8e4m3_i8x4_bitcast(%encoded_bits: reg<aie2p.vec256 x2>, %encoded: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) asm {
  return %encoded_bits, %encoded
}

// ====

func.def @f8e5m2_i8x4_bitcast(%floats: vector<4xf8E5M2>, %bytes: vector<4xi8>) -> (vector<4xi8>, vector<4xf8E5M2>) {
  %encoded_bits = vector.bitcast %floats : vector<4xf8E5M2> to vector<4xi8>
  %encoded = vector.bitcast %bytes : vector<4xi8> to vector<4xf8E5M2>
  func.return %encoded_bits, %encoded : vector<4xi8>, vector<4xf8E5M2>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @f8e5m2_i8x4_bitcast(%encoded_bits: reg<aie2p.vec256 x2>, %encoded: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) asm {
  return %encoded_bits, %encoded
}

// ====

func.def @accumulator_shapes(%floats: vector<2x4x8xf32>, %words: vector<4x12xi32>, %double_words: vector<3x8xi64>) -> (vector<64xf32>, vector<48xi32>, vector<24xi64>) {
  %flat_floats = vector.bitcast %floats : vector<2x4x8xf32> to vector<64xf32>
  %flat_words = vector.bitcast %words : vector<4x12xi32> to vector<48xi32>
  %flat_double_words = vector.bitcast %double_words : vector<3x8xi64> to vector<24xi64>
  func.return %flat_floats, %flat_words, %flat_double_words : vector<64xf32>, vector<48xi32>, vector<24xi64>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @accumulator_shapes(%flat_floats: reg<aie2p.mbms x4>, %flat_words: reg<aie2p.mbms x4>, %flat_double_words: reg<aie2p.mbms x4>) -> (reg<aie2p.mbms x4>, reg<aie2p.mbms x4>, reg<aie2p.mbms x4>) asm {
  return %flat_floats, %flat_words, %flat_double_words
}

// ====

// Address types preserve lane identity across all three carrier extents.
func.def @index_shapes(%small: vector<2x8xindex>, %wide: vector<1x4x8xindex>, %accumulator: vector<2x17xindex>) -> (vector<16xindex>, vector<32xindex>, vector<34xindex>) {
  %flat_small = vector.bitcast %small : vector<2x8xindex> to vector<16xindex>
  %flat_wide = vector.bitcast %wide : vector<1x4x8xindex> to vector<32xindex>
  %flat_accumulator = vector.bitcast %accumulator : vector<2x17xindex> to vector<34xindex>
  func.return %flat_small, %flat_wide, %flat_accumulator : vector<16xindex>, vector<32xindex>, vector<34xindex>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @index_shapes(%flat_small: reg<aie2p.vec256 x2>, %flat_wide: reg<aie2p.vec256 x4>, %flat_accumulator: reg<aie2p.mbms x4>) -> (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x4>, reg<aie2p.mbms x4>) asm {
  return %flat_small, %flat_wide, %flat_accumulator
}

// ====

func.def @offset_shapes(%small: vector<16xoffset>, %wide: vector<32xoffset>, %accumulator: vector<64xoffset>) -> (vector<2x8xoffset>, vector<1x4x8xoffset>, vector<2x4x8xoffset>) {
  %shaped_small = vector.bitcast %small : vector<16xoffset> to vector<2x8xoffset>
  %shaped_wide = vector.bitcast %wide : vector<32xoffset> to vector<1x4x8xoffset>
  %shaped_accumulator = vector.bitcast %accumulator : vector<64xoffset> to vector<2x4x8xoffset>
  func.return %shaped_small, %shaped_wide, %shaped_accumulator : vector<2x8xoffset>, vector<1x4x8xoffset>, vector<2x4x8xoffset>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @offset_shapes(%shaped_small: reg<aie2p.vec256 x2>, %shaped_wide: reg<aie2p.vec256 x4>, %shaped_accumulator: reg<aie2p.mbms x4>) -> (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x4>, reg<aie2p.mbms x4>) asm {
  return %shaped_small, %shaped_wide, %shaped_accumulator
}
