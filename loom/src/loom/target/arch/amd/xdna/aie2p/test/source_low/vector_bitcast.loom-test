// RUN: emit source-low target=amd.xdna.aie2p:core output=low

func.def @i32_to_i8x4_bitcast(%word: vector<1xi32>) -> (vector<4xi8>) {
  %bytes = vector.bitcast %word : vector<1xi32> to vector<4xi8>
  func.return %bytes : vector<4xi8>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i32_to_i8x4_bitcast(%bytes: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  return %bytes
}

// ====

func.def @i32x2_to_i8x8_bitcast(%words: vector<2xi32>) -> (vector<8xi8>) {
  %bytes = vector.bitcast %words : vector<2xi32> to vector<8xi8>
  func.return %bytes : vector<8xi8>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i32x2_to_i8x8_bitcast(%bytes: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  return %bytes
}

