// RUN: emit source-low target=amd.xdna.aie2p:core output=low

func.def @single_wide_element(%lhs: vector<1xi64>, %rhs: vector<1xi64>) -> (vector<1xi64>) {
  %result = vector.andi %lhs, %rhs : vector<1xi64>
  func.return %result : vector<1xi64>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @single_wide_element(%lhs: reg<aie2p.vec256 x2>, %rhs: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %result = vband %lhs, %rhs
  return %result
}

// ====

func.def @odd_wide_elements(%lhs: vector<3xi64>, %rhs: vector<3xi64>) -> (vector<3xi64>) {
  %result = vector.ori %lhs, %rhs : vector<3xi64>
  func.return %result : vector<3xi64>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @odd_wide_elements(%lhs: reg<aie2p.vec256 x2>, %rhs: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %result = vbor %lhs, %rhs
  return %result
}

// ====

func.def @multidimensional_wide_elements(%lhs: vector<2x2xi64>, %rhs: vector<2x2xi64>) -> (vector<2x2xi64>) {
  %result = vector.xori %lhs, %rhs : vector<2x2xi64>
  func.return %result : vector<2x2xi64>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @multidimensional_wide_elements(%lhs: reg<aie2p.vec256 x2>, %rhs: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %7 = vbor %lhs, %rhs
  %8 = vband %lhs, %rhs
  %result = vsub.32 %7, %8
  return %result
}

// ====

func.def @sixteen_wide_elements(%lhs: vector<16xi64>, %rhs: vector<16xi64>) -> (vector<16xi64>) {
  %result = vector.xori %lhs, %rhs : vector<16xi64>
  func.return %result : vector<16xi64>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @sixteen_wide_elements(%lhs: reg<aie2p.vec256 x4>, %rhs: reg<aie2p.vec256 x4>) -> (reg<aie2p.vec256 x4>) asm {
  %14 = slice %lhs[0] : reg<aie2p.vec256 x4> -> reg<aie2p.vec256 x2>
  %15 = slice %rhs[0] : reg<aie2p.vec256 x4> -> reg<aie2p.vec256 x2>
  %16 = vbor %14, %15
  %17 = vband %14, %15
  %18 = vsub.32 %16, %17
  %19 = slice %lhs[2] : reg<aie2p.vec256 x4> -> reg<aie2p.vec256 x2>
  %20 = slice %rhs[2] : reg<aie2p.vec256 x4> -> reg<aie2p.vec256 x2>
  %21 = vbor %19, %20
  %22 = vband %19, %20
  %23 = vsub.32 %21, %22
  %result = concat(%18, %23) : (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) -> reg<aie2p.vec256 x4>
  return %result
}

// ====

func.def @wide_element_constants(%lhs: vector<2xi64>, %rhs: vector<2xi64>) -> (vector<2xi64>, vector<2xi64>, vector<2xi64>) {
  %mask_scalar = scalar.constant 4294967295 : i64
  %mask = vector.splat %mask_scalar : vector<2xi64>
  %tag_scalar = scalar.constant -9223372036854775807 : i64
  %tag = vector.splat %tag_scalar : vector<2xi64>
  %toggle_scalar = scalar.constant -4294967296 : i64
  %toggle = vector.splat %toggle_scalar : vector<2xi64>
  %masked = vector.andi %lhs, %mask : vector<2xi64>
  %tagged = vector.ori %tag, %rhs : vector<2xi64>
  %toggled = vector.xori %lhs, %toggle : vector<2xi64>
  func.return %masked, %tagged, %toggled : vector<2xi64>, vector<2xi64>, vector<2xi64>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @wide_element_constants(%lhs: reg<aie2p.vec256 x2>, %rhs: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) asm {
  %19 = mov.i32 -1
  %20 = mov.i32 0
  %mask_scalar = concat(%19, %20) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  %mask = vbcst.64 %mask_scalar
  %23 = mov.i32 1
  %24 = mov.i32 -2147483648
  %tag_scalar = concat(%23, %24) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  %tag = vbcst.64 %tag_scalar
  %toggle_scalar = concat(%20, %19) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  %toggle = vbcst.64 %toggle_scalar
  %masked = vband %lhs, %mask
  %tagged = vbor %tag, %rhs
  %33 = vbor %lhs, %toggle
  %34 = vband %lhs, %toggle
  %toggled = vsub.32 %33, %34
  return %masked, %tagged, %toggled
}
