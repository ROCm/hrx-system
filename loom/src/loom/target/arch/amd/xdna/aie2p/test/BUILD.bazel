load("//build_tools/testing:build_defs.bzl", "iree_cli_test")
load("//libamdf/requirements:defs.bzl", "LIBAMDF")
load("//loom/build_tools/bazel:build_defs.bzl", "loom_config_compatible_with")
load("//loom/build_tools/bazel:defs.bzl", "loom_test")
load("//loom/build_tools/bazel:loom_check.bzl", "loom_check_test_suite")
load("//loom/target/amd/xdna:execution_profiles.bzl", "XDNA_HARDWARE_PROFILE")

package(
    default_visibility = ["//visibility:private"],
    features = ["layering_check"],
    licenses = ["notice"],
)

_XDNA_TARGET_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/arch:aie2p",
])

_XDNA_ARTIFACT_COMPATIBLE_WITH = loom_config_compatible_with([
    "//loom/config/emit:aie2p_elf",
])

_XDNA_IMAGE_COMPATIBLE_WITH = _XDNA_ARTIFACT_COMPATIBLE_WITH + loom_config_compatible_with([
    LIBAMDF.enabled_by,
])

iree_cli_test(
    name = "native_allocation_report_test",
    size = "small",
    data = ["native_allocation_report.loom"],
    manifests = ["native_allocation_report.test.json"],
    tags = ["hostonly"],
    target_compatible_with = _XDNA_IMAGE_COMPATIBLE_WITH,
    tools = {
        "loom-compile": "//loom/src/loom/tools/loom-compile",
    },
)

iree_cli_test(
    name = "failed_helper_report_test",
    size = "small",
    data = ["failed_helper_report.loom"],
    manifests = ["failed_helper_report.test.json"],
    tags = ["hostonly"],
    target_compatible_with = _XDNA_IMAGE_COMPATIBLE_WITH,
    tools = {
        "loom-compile": "//loom/src/loom/tools/loom-compile",
        "loom-compile-report": "//loom/py/loom/tools:loom-compile-report",
    },
)

iree_cli_test(
