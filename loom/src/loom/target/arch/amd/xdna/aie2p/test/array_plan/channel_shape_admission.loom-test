// ----
CHECK: channel index=0 * capacity=1 records=1 *
CHECK: channel index=1 * capacity=2 records=1 *
CHECK: binding-patch ordinal=0 channel=0 * repeat=1
CHECK-NOT: binding-patch ordinal=0 channel=1
