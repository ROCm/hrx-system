// Forwarded state stays live through the return while body temporaries use
// other storage. The return reads LR; it does not clobber it.
// RUN: emit aie2p-leaf @forward fixed=%state:physical_register:201:1 fixed=%carry:physical_register:253:1 registers=p1,r0,r1,l0,lr

low.func.def target<amd.xdna.aie2p.core> @forward(%state: reg<aie2p.ep>, %carry: reg<aie2p.er>) -> (reg<aie2p.ep>, reg<aie2p.er>) asm {
  %one = mov.i32 1
  st %one, %state, 0
  return %state, %carry
}

// ----
p1: preserved
r0: preserved
r1: written
l0: written
lr: preserved

// ====

// An updated result can use the incoming location once that input dies.
// RUN: emit aie2p-leaf @increment fixed=%carry:physical_register:253:1 fixed=%next:physical_register:253:1 registers=r0,r1,lr

low.func.def target<amd.xdna.aie2p.core> @increment(%carry: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %next = add %carry, 1
  return %next
}

// ----
r0: written
r1: preserved
lr: preserved

// ====

// Fixing a dead input does not reserve its register for the entire leaf.
// RUN: emit aie2p-leaf @reuse fixed=%unused:physical_register:253:1 registers=r0,r1

low.func.def target<amd.xdna.aie2p.core> @reuse(%unused: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %one = mov.i32 1
  return %one
}

// ----
r0: written
r1: preserved

// ====

// A generated scalar move writes its destination even though low.copy has
// no instruction encoding of its own. It also writes the overlapping L view.
// RUN: emit aie2p-leaf @copy fixed=%source:physical_register:253:1 fixed=%result:physical_register:254:1 registers=r0,r1,l0,r2

low.func.def target<amd.xdna.aie2p.core> @copy(%source: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %result = copy %source {detached = true} : reg<aie2p.er> -> reg<aie2p.er>
  return %result
}

// ----
r0: preserved
r1: written
l0: written
r2: preserved

// ====

// Only the low predicate word is written. The high word remains untouched,
// despite belonging to the same allocated 64-bit physical register.
// RUN: emit aie2p-leaf @predicate fixed=%input:physical_register:341:2 fixed=%mask:physical_register:170:1 registers=r26,r27,l13,x0

low.func.def target<amd.xdna.aie2p.core> @predicate(%input: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %mask = veqz.32.el.low32 %input
  %selected = vsel.32.mask64 %input, %input, %mask
  return %selected
}

// ----
r26: written
r27: preserved
l13: written
x0: written

// ====

// The 3D recurrence updates two count fields and the pointer, preserving
// sizes, strides and wrap fields inside the allocated aggregate.
// RUN: emit aie2p-leaf @advance fixed=%pointer:physical_register:200:1 fixed=%dimension:physical_register:47:1 registers=p0,dc0,dc4,dn0,dn4,dj0,dj4,m0,m4,d0,d0_3d

low.func.def target<amd.xdna.aie2p.core> @advance(%pointer: reg<aie2p.ep>, %dimension: reg<aie2p.eds>) -> (reg<aie2p.ep>, reg<aie2p.eds>) asm {
  %next_pointer, %next_dimension = padda.3d %pointer, %dimension
  return %next_pointer, %next_dimension
}

// ----
p0: written
dc0: written
dc4: written
dn0: preserved
dn4: preserved
dj0: preserved
dj4: preserved
m0: preserved
m4: preserved
d0: written
d0_3d: written

// ====

// The fused maximum has an implicit fixed comparison output. Both scalar
// halves and the 64-bit alias must be visible in the detached write facts.
// RUN: emit aie2p-leaf @implicit fixed=%left:physical_register:341:2 fixed=%right:physical_register:342:2 registers=r16,r17,l8,r26,r27,x0,wh0,wl0,x1,lr

low.func.def target<amd.xdna.aie2p.core> @implicit(%left: reg<aie2p.vec256 x2>, %right: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %maximum = max.s8x64 %left, %right
  return %maximum
}

// ----
r16: written
r17: written
l8: written
r26: preserved
r27: preserved
x0: written
wh0: written
wl0: written
x1: preserved
lr: preserved

// ====

// Symbolic storage-address materialization contributes a physical write even
// though its final absolute address is fixed up only during tile placement.
// RUN: emit aie2p-leaf @storage fixed=%address:physical_register:203:1 registers=p0,p3,lr

low.func.def target<amd.xdna.aie2p.core> @storage() -> (reg<aie2p.ep>) asm {
  %allocation = storage {byte_alignment = 64, byte_length = 64} : low.storage<workgroup>
  %address = storage_address %allocation : low.storage<workgroup> -> reg<aie2p.ep>
  return %address
}

// ----
p0: preserved
p3: written
lr: preserved

// ====

// A parallel edge-copy cycle writes both swapped values and the temporary
// used to break the cycle. These moves have no source descriptor operations.
// RUN: emit aie2p-leaf @swap fixed=%condition:physical_register:253:1 fixed=%first:physical_register:254:1 fixed=%second:physical_register:265:1 fixed=%left:physical_register:254:1 fixed=%right:physical_register:265:1 registers=r0,r1,r2,r3,lr

low.func.def target<amd.xdna.aie2p.core> @swap(%condition: reg<aie2p.er>, %first: reg<aie2p.er>, %second: reg<aie2p.er>) -> (reg<aie2p.er>, reg<aie2p.er>) asm {
  low.br ^loop(%first: reg<aie2p.er>, %second: reg<aie2p.er>)
^loop(%left: reg<aie2p.er>, %right: reg<aie2p.er>):
  low.cond_br %condition, ^body, ^exit : reg<aie2p.er>
^body:
  low.br ^loop(%right: reg<aie2p.er>, %left: reg<aie2p.er>)
^exit:
  return %left, %right
}

// ----
r0: preserved
r1: written
r2: written
r3: written
lr: preserved

// ====

// Each fixed result binds its own required input, including descriptor-local
// pointer and dimension views. Unrelated pointer storage remains untouched.
// RUN: emit aie2p-leaf @fixed_recurrence_results fixed=%next_pointer:physical_register:203:1 fixed=%next_dimension:physical_register:47:1 registers=p0,p3,dc0,dc4,dn0,dn4,lr

low.func.def target<amd.xdna.aie2p.core> @fixed_recurrence_results(%pointer: reg<aie2p.ep>, %dimension: reg<aie2p.eds>) -> (reg<aie2p.ep>, reg<aie2p.eds>) asm {
  %next_pointer, %next_dimension = padda.3d %pointer, %dimension
  return %next_pointer, %next_dimension
}

// ----
p0: preserved
p3: written
dc0: written
dc4: written
dn0: preserved
dn4: preserved
lr: preserved

// ====

// A recurrence cannot read one fixed pointer and update a different one.
// RUN: emit aie2p-leaf @conflicting_recurrence fixed=%pointer:physical_register:200:1 fixed=%next_pointer:physical_register:203:1

low.func.def target<amd.xdna.aie2p.core> @conflicting_recurrence(%pointer: reg<aie2p.ep>, %dimension: reg<aie2p.eds>) -> (reg<aie2p.ep>, reg<aie2p.eds>) asm {
  // ERROR@+1: BACKEND/049 {first_value_name="pointer", first_location_base="200", second_value_name="next_pointer", second_location_base="203"}
  %next_pointer, %next_dimension = padda.3d %pointer, %dimension
  return %next_pointer, %next_dimension
}
