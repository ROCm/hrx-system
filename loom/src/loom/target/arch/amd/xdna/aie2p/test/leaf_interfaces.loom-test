// A linked representation contract is not necessarily accepted by the selected
// native emitter. This function verifies but is not an AIE core function.
// RUN: emit aie2p-leaf @foreign_function

// ERROR@+1: TARGET/044 "foreign_function" "test.low.core"
low.func.def target<test.low.core> @foreign_function() asm {
  return
}

// ====

// Array orchestration and core instructions use distinct representation
// contracts even though they belong to the same target family.
// RUN: emit aie2p-leaf @array_function

// ERROR@+1: TARGET/044 "array_function" "amd.xdna.aie2p.array"
low.func.def target<amd.xdna.aie2p.array> @array_function() asm {
  return
}

// ====

// A result-bearing function may have a direct body path that source control
// proves cannot reach its ordinary return. AIE2P keeps that path terminal
// without allocating or moving a fabricated result value.
// RUN: emit aie2p-leaf @unreachable_tail report=code

aie2p.target<core> @target

low.func.def target<amd.xdna.aie2p.core>(@target) @unreachable_tail() -> (reg<aie2p.er>) asm {
  low.unreachable
}

