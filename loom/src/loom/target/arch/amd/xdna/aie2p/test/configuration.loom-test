// ====
// RUN: emit aie2p-xdna

// Unused arguments preserve public ordinals without access or relocations.
aie2p.target<configuration> @configuration {device_profile = "amd.xdna.strix.17f0_10"}

low.func.def public retain target<amd.xdna.aie2p.configuration>(@configuration) abi(array_program) @with_unused_arguments() asm {
  %columns = constant 1 : reg<aie2p.config.scalar : i64>
  entry %columns, @initialize, @invoke
  return
}

low.func.def target<amd.xdna.aie2p.configuration>(@configuration) @initialize() asm {
  return
}

low.func.def target<amd.xdna.aie2p.configuration>(@configuration) @invoke() asm {
  %first_unused = constant 0 : reg<aie2p.config.scalar : i64>
  %input_ordinal = constant 1 : reg<aie2p.config.scalar : i64>
  %middle_unused = constant 2 : reg<aie2p.config.scalar : i64>
  %output_ordinal = constant 3 : reg<aie2p.config.scalar : i64>
  %last_unused = constant 4 : reg<aie2p.config.scalar : i64>
  %read_access = constant 1 : reg<aie2p.config.scalar : i64>
  %write_access = constant 2 : reg<aie2p.config.scalar : i64>
  %extent = constant 64 : reg<aie2p.config.scalar : i64>
  %origin = constant 0 : reg<aie2p.config.scalar : i64>
  %input_address = constant 2588608 : reg<aie2p.config.scalar : i64>
  %output_address = constant 2588616 : reg<aie2p.config.scalar : i64>
  binding.unused %first_unused
  %input = binding %input_ordinal, %read_access, %extent, %extent
  binding.unused %middle_unused
  %output = binding %output_ordinal, %write_access, %extent, %extent
  binding.unused %last_unused
  %input_range = range %input, %origin, %extent
  %output_range = range %output, %origin, %extent
  write.address %input_address, %input_range
  write.address %output_address, %output_range
  return
}

