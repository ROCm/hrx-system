// ====

// Return placement preserves the same calendar contract without introducing
// an additional branch block or extending the architectural delay window.
// RUN: emit aie2p-leaf @return_after_removed_constant report=emission

aie2p.target<core> @target

low.func.def schedule(locked) target<amd.xdna.aie2p.core>(@target) @return_after_removed_constant(%output: reg<aie2p.ep>) asm {
  %first = mov.short 0
  %second = mov.short 0
  st %second, %output, 0
  return
}

