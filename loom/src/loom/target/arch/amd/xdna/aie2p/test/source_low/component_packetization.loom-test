  %83 = predicate.complete.zero.high32 %82, 0
  %84 = vsel.16.mask64 %76, %47, %83
  %85 = slice %80[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %86 = slice %84[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
