  %86 = vmov.vector512.to.accumulator512 %70
  %87 = vconv.bf16.fp32x16 %86
  %88 = concat(%87, %85) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  %89 = vband %70, %42
  %90 = vlt.u32x16.el.low32 %44, %89
  %91 = predicate.complete.zero.high32 %90, 0
  %92 = vsel.16.mask64 %88, %46, %91
  %93 = slice %84[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %94 = slice %92[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %95 = concat(%93, %94) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  %99 = mova.i32 52
  %100 = vshuffle %65, %95, %99
