  vst.128.bf16x8.index %116, %output_aligned, %117
  %120 = mova.i32 48
  %121 = vshift %100, %102, %120
  %122 = slice %121[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %123 = mov.static-address-index 768
  vst.128.bf16x8.index %122, %output_aligned, %123
  %143 = slice %102[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %126 = mov.static-address-index 1024
  vst.128.bf16x8.index %143, %output_aligned, %126
