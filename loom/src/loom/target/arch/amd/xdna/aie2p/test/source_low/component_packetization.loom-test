// RUN: pass target=amd.xdna.aie2p:core target-legalize{mode=final},canonicalize

func.def @bf16x64_unary(%input: vector<64xbf16>) -> (vector<64xbf16>) {
  %result = vector.negf %input : vector<64xbf16>
  func.return %result : vector<64xbf16>
}

// ----
func.def @bf16x64_unary(%input: vector<64xbf16>) -> (vector<64xbf16>) {
  %3 = vector.slice %input[0] : vector<64xbf16> -> vector<32xbf16>
  %4 = vector.negf %3 : vector<32xbf16>
  %5 = vector.slice %input[32] : vector<64xbf16> -> vector<32xbf16>
  %6 = vector.negf %5 : vector<32xbf16>
  %result = vector.concat<0> %4, %6 : vector<32xbf16>, vector<32xbf16> -> vector<64xbf16>
  func.return %result : vector<64xbf16>
}

// ====

func.def @i8x128_fanout(%lhs: vector<128xi8>, %rhs: vector<128xi8>, %mask: vector<128xi8>) -> (vector<128xi8>, vector<128xi8>) {
  %sum = vector.addi %lhs, %rhs : vector<128xi8>
  %xor = vector.xori %sum, %mask : vector<128xi8>
  %or = vector.ori %sum, %mask : vector<128xi8>
  func.return %xor, %or : vector<128xi8>, vector<128xi8>
}

// ----
func.def @i8x128_fanout(%lhs: vector<128xi8>, %rhs: vector<128xi8>, %mask: vector<128xi8>) -> (vector<128xi8>, vector<128xi8>) {
  %8 = vector.slice %lhs[0] : vector<128xi8> -> vector<64xi8>
  %9 = vector.slice %rhs[0] : vector<128xi8> -> vector<64xi8>
  %10 = vector.addi %8, %9 : vector<64xi8>
  %11 = vector.slice %mask[0] : vector<128xi8> -> vector<64xi8>
  %12 = vector.xori %10, %11 : vector<64xi8>
  %13 = vector.ori %10, %11 : vector<64xi8>
  %14 = vector.slice %lhs[64] : vector<128xi8> -> vector<64xi8>
  %15 = vector.slice %rhs[64] : vector<128xi8> -> vector<64xi8>
  %16 = vector.addi %14, %15 : vector<64xi8>
  %17 = vector.slice %mask[64] : vector<128xi8> -> vector<64xi8>
  %18 = vector.xori %16, %17 : vector<64xi8>
  %19 = vector.ori %16, %17 : vector<64xi8>
  %xor = vector.concat<0> %12, %18 : vector<64xi8>, vector<64xi8> -> vector<128xi8>
  %or = vector.concat<0> %13, %19 : vector<64xi8>, vector<64xi8> -> vector<128xi8>
  func.return %xor, %or : vector<128xi8>, vector<128xi8>
}

// ====

func.def @i8x128_legal_boundary(%lhs: vector<128xi8>, %rhs: vector<128xi8>, %mask: vector<128xi8>) -> (vector<128xi8>, vector<128xi8>) {
  %sum = vector.addi %lhs, %rhs : vector<128xi8>
  %minimum = vector.minsi %sum, %rhs : vector<128xi8>
  %xor = vector.xori %sum, %mask : vector<128xi8>
  func.return %minimum, %xor : vector<128xi8>, vector<128xi8>
}

// ----
func.def @i8x128_legal_boundary(%lhs: vector<128xi8>, %rhs: vector<128xi8>, %mask: vector<128xi8>) -> (vector<128xi8>, vector<128xi8>) {
  %8 = vector.slice %lhs[0] : vector<128xi8> -> vector<64xi8>
  %9 = vector.slice %rhs[0] : vector<128xi8> -> vector<64xi8>
  %10 = vector.addi %8, %9 : vector<64xi8>
  %11 = vector.slice %lhs[64] : vector<128xi8> -> vector<64xi8>
  %12 = vector.slice %rhs[64] : vector<128xi8> -> vector<64xi8>
  %13 = vector.addi %11, %12 : vector<64xi8>
  %sum = vector.concat<0> %10, %13 : vector<64xi8>, vector<64xi8> -> vector<128xi8>
  %minimum = vector.minsi %sum, %rhs : vector<128xi8>
  %15 = vector.slice %mask[0] : vector<128xi8> -> vector<64xi8>
  %16 = vector.xori %10, %15 : vector<64xi8>
  %17 = vector.slice %mask[64] : vector<128xi8> -> vector<64xi8>
  %18 = vector.xori %13, %17 : vector<64xi8>
  %xor = vector.concat<0> %16, %18 : vector<64xi8>, vector<64xi8> -> vector<128xi8>
  func.return %minimum, %xor : vector<128xi8>, vector<128xi8>
}

// ====

func.def @i8x33_signed_extension(%input: vector<33xi8>) -> (vector<33xi32>) {
  %result = vector.extsi %input : vector<33xi8> to vector<33xi32>
  func.return %result : vector<33xi32>
}

// ----
func.def @i8x33_signed_extension(%input: vector<33xi8>) -> (vector<33xi32>) {
  %3 = vector.slice %input[0] : vector<33xi8> -> vector<32xi8>
  %4 = vector.extsi %3 : vector<32xi8> to vector<32xi32>
  %5 = vector.slice %input[32] : vector<33xi8> -> vector<1xi8>
  %6 = vector.extsi %5 : vector<1xi8> to vector<1xi32>
  %result = vector.concat<0> %4, %6 : vector<32xi32>, vector<1xi32> -> vector<33xi32>
  func.return %result : vector<33xi32>
}

// ====

func.def @f32x64_native_producer(%lhs: vector<64xf32>, %rhs: vector<64xf32>) -> (vector<64xbf16>) {
  %sum = vector.addf %lhs, %rhs : vector<64xf32>
  %result = vector.fptrunc %sum : vector<64xf32> to vector<64xbf16>
  func.return %result : vector<64xbf16>
}

// ----
func.def @f32x64_native_producer(%lhs: vector<64xf32>, %rhs: vector<64xf32>) -> (vector<64xbf16>) {
  %sum = vector.addf %lhs, %rhs : vector<64xf32>
  %5 = vector.slice %sum[0] : vector<64xf32> -> vector<32xf32>
  %6 = vector.fptrunc %5 : vector<32xf32> to vector<32xbf16>
  %7 = vector.slice %sum[32] : vector<64xf32> -> vector<32xf32>
  %8 = vector.fptrunc %7 : vector<32xf32> to vector<32xbf16>
  %result = vector.concat<0> %6, %8 : vector<32xbf16>, vector<32xbf16> -> vector<64xbf16>
  func.return %result : vector<64xbf16>
}

// ====

func.def @bf16_origin_closure_with_early_native_use(%input: vector<64xbf16>, %bias: vector<64xf32>) -> (vector<64xf32>, vector<64xbf16>) {
  %widened = vector.extf %input : vector<64xbf16> to vector<64xf32>
  %early = vector.addf %widened, %bias : vector<64xf32>
  %scale = vector.splatf 1.4453125 : vector<64xf32>
  %scaled = vector.mulf<nnan|ninf|nsz|contract> %widened, %scale : vector<64xf32>
  %rounded = vector.fptrunc %scaled : vector<64xf32> to vector<64xbf16>
  func.return %early, %rounded : vector<64xf32>, vector<64xbf16>
}

// ----
func.def @bf16_origin_closure_with_early_native_use(%input: vector<64xbf16>, %bias: vector<64xf32>) -> (vector<64xf32>, vector<64xbf16>) {
  %9 = vector.slice %input[0] : vector<64xbf16> -> vector<16xbf16>
  %10 = vector.extf %9 : vector<16xbf16> to vector<16xf32>
  %11 = vector.slice %input[16] : vector<64xbf16> -> vector<16xbf16>
  %12 = vector.extf %11 : vector<16xbf16> to vector<16xf32>
  %13 = vector.slice %input[32] : vector<64xbf16> -> vector<16xbf16>
  %14 = vector.extf %13 : vector<16xbf16> to vector<16xf32>
  %15 = vector.slice %input[48] : vector<64xbf16> -> vector<16xbf16>
  %16 = vector.extf %15 : vector<16xbf16> to vector<16xf32>
  %34 = vector.concat<0> %10, %12 : vector<16xf32>, vector<16xf32> -> vector<32xf32>
  %35 = vector.concat<0> %14, %16 : vector<16xf32>, vector<16xf32> -> vector<32xf32>
  %widened = vector.concat<0> %34, %35 : vector<32xf32>, vector<32xf32> -> vector<64xf32>
  %early = vector.addf %widened, %bias : vector<64xf32>
  %40 = vector.splatf 1.4453125 : vector<16xf32>
  %19 = vector.mulf<nnan|ninf|nsz|contract> %10, %40 : vector<16xf32>
  %20 = vector.fptrunc %19 : vector<16xf32> to vector<16xbf16>
  %39 = vector.splatf 1.4453125 : vector<16xf32>
  %22 = vector.mulf<nnan|ninf|nsz|contract> %12, %39 : vector<16xf32>
  %23 = vector.fptrunc %22 : vector<16xf32> to vector<16xbf16>
  %38 = vector.splatf 1.4453125 : vector<16xf32>
  %25 = vector.mulf<nnan|ninf|nsz|contract> %14, %38 : vector<16xf32>
  %26 = vector.fptrunc %25 : vector<16xf32> to vector<16xbf16>
  %37 = vector.splatf 1.4453125 : vector<16xf32>
  %28 = vector.mulf<nnan|ninf|nsz|contract> %16, %37 : vector<16xf32>
  %29 = vector.fptrunc %28 : vector<16xf32> to vector<16xbf16>
  %31 = vector.concat<0> %20, %23 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %32 = vector.concat<0> %26, %29 : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %rounded = vector.concat<0> %31, %32 : vector<32xbf16>, vector<32xbf16> -> vector<64xbf16>
  func.return %early, %rounded : vector<64xf32>, vector<64xbf16>
}

// ====

// Shape-alias packet reuse is independent of rank and element type. Other
// shaped inputs retain the ordinary rank-one slicing path.
func.def @rank3_i8_add(%quarter0: vector<32xi8>, %quarter1: vector<32xi8>, %quarter2: vector<32xi8>, %quarter3: vector<32xi8>, %bias: vector<2x2x32xi8>) -> (vector<2x2x32xi8>) {
  %flat = vector.concat<0> %quarter0, %quarter1, %quarter2, %quarter3 : vector<32xi8>, vector<32xi8>, vector<32xi8>, vector<32xi8> -> vector<128xi8>
  %shaped = vector.bitcast %flat : vector<128xi8> to vector<2x2x32xi8>
  %result = vector.addi %shaped, %bias : vector<2x2x32xi8>
  func.return %result : vector<2x2x32xi8>
}

// ----
func.def @rank3_i8_add(%quarter0: vector<32xi8>, %quarter1: vector<32xi8>, %quarter2: vector<32xi8>, %quarter3: vector<32xi8>, %bias: vector<2x2x32xi8>) -> (vector<2x2x32xi8>) {
  %9 = vector.concat<0> %quarter0, %quarter1 : vector<32xi8>, vector<32xi8> -> vector<64xi8>
  %10 = vector.bitcast %bias : vector<2x2x32xi8> to vector<128xi8>
  %11 = vector.slice %10[0] : vector<128xi8> -> vector<64xi8>
  %12 = vector.addi %9, %11 : vector<64xi8>
  %13 = vector.concat<0> %quarter2, %quarter3 : vector<32xi8>, vector<32xi8> -> vector<64xi8>
  %14 = vector.slice %10[64] : vector<128xi8> -> vector<64xi8>
  %15 = vector.addi %13, %14 : vector<64xi8>
  %16 = vector.concat<0> %12, %15 : vector<64xi8>, vector<64xi8> -> vector<128xi8>
  %result = vector.bitcast %16 : vector<128xi8> to vector<2x2x32xi8>
  func.return %result : vector<2x2x32xi8>
}

// ====

// RUN: pass target=amd.xdna.aie2p:core target-legalize{mode=eager}

// Packetizing another component invalidates transient query state. The shaped
// load component remains authored for later view access linearization.
func.def @eager_shaped_load_deferral(%input: buffer, %output: buffer, %values: vector<64xbf16>) -> (vector<64xbf16>) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<8x8xf32>
  %output_view = buffer.view %output[%base] : buffer -> view<8x8xbf16>
  %loaded = vector.load %input_view[0, 0] : view<8x8xf32> -> vector<8x8xf32>
  %narrow = vector.fptrunc<daz> %loaded : vector<8x8xf32> to vector<8x8xbf16>
  vector.store %narrow, %output_view[0, 0] : vector<8x8xbf16>, view<8x8xbf16>
  %negated = vector.negf %values : vector<64xbf16>
  func.return %negated : vector<64xbf16>
}

// ----
func.def @eager_shaped_load_deferral(%input: buffer, %output: buffer, %values: vector<64xbf16>) -> (vector<64xbf16>) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<8x8xf32>
  %output_view = buffer.view %output[%base] : buffer -> view<8x8xbf16>
  %loaded = vector.load %input_view[0, 0] : view<8x8xf32> -> vector<8x8xf32>
  %narrow = vector.fptrunc<daz> %loaded : vector<8x8xf32> to vector<8x8xbf16>
  vector.store %narrow, %output_view[0, 0] : vector<8x8xbf16>, view<8x8xbf16>
  %10 = vector.slice %values[0] : vector<64xbf16> -> vector<32xbf16>
  %11 = vector.negf %10 : vector<32xbf16>
  %12 = vector.slice %values[32] : vector<64xbf16> -> vector<32xbf16>
  %13 = vector.negf %12 : vector<32xbf16>
  %negated = vector.concat<0> %11, %13 : vector<32xbf16>, vector<32xbf16> -> vector<64xbf16>
  func.return %negated : vector<64xbf16>
}

// ====

// RUN: emit source-low output=low

aie2p.target<core> @target

// A contiguous tile retains its full shape until conversion selects native
// accumulator loads. The transposed, strided result still stores by row.
func.def target(@target) @shaped_convert_transpose_store(%input: buffer, %output: buffer) {
  %input_aligned, %output_aligned = buffer.assume.alignment %input, %output {minimum_alignment = 64} : buffer, buffer
  %base = index.constant 0 : offset
  %input_view = buffer.view %input_aligned[%base] : buffer -> view<8x8xf32>
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<32x128xbf16>
  %loaded = vector.load %input_view[0, 0] : view<8x8xf32> -> vector<8x8xf32>
  %narrow = vector.fptrunc<daz> %loaded : vector<8x8xf32> to vector<8x8xbf16>
  %transposed = vector.transpose<[1, 0]> %narrow : vector<8x8xbf16> -> vector<8x8xbf16>
  vector.store %transposed, %output_view[0, 0] : vector<8x8xbf16>, view<32x128xbf16>
  func.return
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @shaped_convert_transpose_store() asm {
  %input_aligned = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %output_aligned = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %31 = vlda.acc %input_aligned, 0
  %32 = vlda.acc %input_aligned, 64
  %33 = vlda.acc %input_aligned, 128
  %34 = vlda.acc %input_aligned, 192
  %35 = concat(%31, %32, %33, %34) : (reg<aie2p.mbms>, reg<aie2p.mbms>, reg<aie2p.mbms>, reg<aie2p.mbms>) -> reg<aie2p.mbms x4>
  %36 = slice %35[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms x2>
  set.rounding 12
  %37 = vconv.bf16.fp32 %36
  %39 = vmov.accumulator512.to.vector512 %31
  %41 = vmov.accumulator512.to.vector512 %32
  %42 = mov.i32 2147483647
  %43 = vbcst.32 %42
  %44 = mov.i32 2139095040
  %45 = vbcst.32 %44
  %46 = mov.i32 32704
  %47 = vbcst.16 %46
  %48 = slice %37[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %49 = slice %37[1] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %50 = concat(%49, %48) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  %51 = vband %39, %43
  %52 = vlt.u32x16.el.low32 %45, %51
  %53 = predicate.complete.zero.high32 %52, 0
  %54 = vsel.16.mask64 %37, %47, %53
  %55 = vband %41, %43
  %56 = vlt.u32x16.el.low32 %45, %55
  %57 = predicate.complete.zero.high32 %56, 0
  %58 = vsel.16.mask64 %50, %47, %57
  %59 = slice %54[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %60 = slice %58[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %61 = concat(%59, %60) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  %62 = slice %35[2] : reg<aie2p.mbms x4> -> reg<aie2p.mbms x2>
  %63 = vconv.bf16.fp32 %62
  %65 = vmov.accumulator512.to.vector512 %33
  %67 = vmov.accumulator512.to.vector512 %34
  %74 = slice %63[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %75 = slice %63[1] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %76 = concat(%75, %74) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  %77 = vband %65, %43
  %78 = vlt.u32x16.el.low32 %45, %77
  %79 = predicate.complete.zero.high32 %78, 0
  %80 = vsel.16.mask64 %63, %47, %79
  %81 = vband %67, %43
  %82 = vlt.u32x16.el.low32 %45, %81
  %83 = predicate.complete.zero.high32 %82, 0
  %84 = vsel.16.mask64 %76, %47, %83
  %85 = slice %80[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %86 = slice %84[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %87 = concat(%85, %86) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  %91 = mova.i32 52
  %92 = vshuffle %61, %87, %91
  %93 = mova.i32 53
  %94 = vshuffle %61, %87, %93
  %137 = slice %92[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  vst.128.bf16x8 %137, %output_aligned, 0
  %100 = mova.i32 16
  %101 = vshift %92, %94, %100
  %102 = slice %101[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %103 = mov.static-address-index 256
  vst.128.bf16x8.index %102, %output_aligned, %103
  %106 = mova.i32 32
  %107 = vshift %92, %94, %106
  %108 = slice %107[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %109 = mov.static-address-index 512
  vst.128.bf16x8.index %108, %output_aligned, %109
  %112 = mova.i32 48
  %113 = vshift %92, %94, %112
  %114 = slice %113[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %115 = mov.static-address-index 768
  vst.128.bf16x8.index %114, %output_aligned, %115
  %135 = slice %94[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %118 = mov.static-address-index 1024
  vst.128.bf16x8.index %135, %output_aligned, %118
  %121 = vshift %94, %94, %100
  %122 = slice %121[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %123 = mov.static-address-index 1280
