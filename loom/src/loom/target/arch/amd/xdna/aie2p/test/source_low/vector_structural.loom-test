  func.return %result : i64
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @i64x16_extract_dynamic(%values: reg<aie2p.vec256 x4>, %lane: reg<aie2p.er>) -> (reg<aie2p.er x2>) asm {
  %7 = slice %values[0] : reg<aie2p.vec256 x4> -> reg<aie2p.vec256 x2>
  %8 = slice %values[2] : reg<aie2p.vec256 x4> -> reg<aie2p.vec256 x2>
  %9 = mov.short 7
  %10 = mov.short 8
  %11 = and %lane, %9
  %12 = and %lane, %10
  %13 = vextract.64.reg %7, %11
  %14 = vextract.64.reg %8, %11
  %15 = slice %13[0] : reg<aie2p.er x2> -> reg<aie2p.er>
  %16 = slice %14[0] : reg<aie2p.er x2> -> reg<aie2p.er>
  %17 = copy %12 : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %18 = sel.nez %16, %15, %17
  %19 = slice %13[1] : reg<aie2p.er x2> -> reg<aie2p.er>
  %20 = slice %14[1] : reg<aie2p.er x2> -> reg<aie2p.er>
  %21 = copy %12 : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %22 = sel.nez %20, %19, %21
  %result = concat(%18, %22) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  return %result
}

// ====

aie2p.target<core> @target

// A BF16 sliding convolution reads a 32-element register window using two
// 256-bit aligned loads. Every tap reuses that window, including slices that
// cross its physical W-register boundary.
func.def target(@target) @bf16_convolution_windows(%input: buffer, %output: buffer) {
  %source = buffer.assume.alignment %input {minimum_alignment = 32} : buffer
  %destination = buffer.assume.alignment %output {minimum_alignment = 32} : buffer
  %base = index.constant 0 : offset
  %input_view = buffer.view %source[%base] : buffer -> view<32xbf16>
  %output_view = buffer.view %destination[%base] : buffer -> view<6x16xbf16>
  %low = vector.load %input_view[0] : view<32xbf16> -> vector<16xbf16>
  %high = vector.load %input_view[16] : view<32xbf16> -> vector<16xbf16>
  %window = vector.concat<0> %low, %high : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %first = vector.slice %window[0] : vector<32xbf16> -> vector<16xbf16>
  %second = vector.slice %window[1] : vector<32xbf16> -> vector<16xbf16>
  %eighth = vector.slice %window[7] : vector<32xbf16> -> vector<16xbf16>
  %ninth = vector.slice %window[8] : vector<32xbf16> -> vector<16xbf16>
  %sixteenth = vector.slice %window[15] : vector<32xbf16> -> vector<16xbf16>
  %last = vector.slice %window[16] : vector<32xbf16> -> vector<16xbf16>
  vector.store %first, %output_view[0, 0] : vector<16xbf16>, view<6x16xbf16>
  vector.store %second, %output_view[1, 0] : vector<16xbf16>, view<6x16xbf16>
  vector.store %eighth, %output_view[2, 0] : vector<16xbf16>, view<6x16xbf16>
  vector.store %ninth, %output_view[3, 0] : vector<16xbf16>, view<6x16xbf16>
  vector.store %sixteenth, %output_view[4, 0] : vector<16xbf16>, view<6x16xbf16>
  vector.store %last, %output_view[5, 0] : vector<16xbf16>, view<6x16xbf16>
  func.return
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @bf16_convolution_windows() asm {
  %source = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %destination = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %22 = vlda.256.bf16x16 %source, 0
  %27 = vlda.256.bf16x16 %source, 32
  %window = concat(%22, %27) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  %32 = mova.i32 2
  %second = vshift %window, %window, %32
  %34 = mova.i32 14
  %eighth = vshift %window, %window, %34
  %36 = mova.i32 16
  %ninth = vshift %window, %window, %36
  %38 = mova.i32 30
  %sixteenth = vshift %window, %window, %38
  vst.256.bf16x16 %22, %destination, 0
  %41 = slice %second[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  vst.256.bf16x16 %41, %destination, 32
  %42 = slice %eighth[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  vst.256.bf16x16 %42, %destination, 64
  %43 = slice %ninth[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  vst.256.bf16x16 %43, %destination, 96
  %44 = slice %sixteenth[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  vst.256.bf16x16 %44, %destination, 128
  vst.256.bf16x16 %27, %destination, 160
  return
}

