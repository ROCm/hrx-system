// RUN: emit source-low output=low

aie2p.target<core> @target

func.def target(@target) @extract_i32x32_halves(%values: vector<32xi32>) -> (i32, i32, i32, i32) {
  %low_last = vector.extract %values[15] : vector<32xi32> -> i32
  %high_first = vector.extract %values[16] : vector<32xi32> -> i32
  %high_next = vector.extract %values[17] : vector<32xi32> -> i32
  %high_last = vector.extract %values[31] : vector<32xi32> -> i32
  func.return %low_last, %high_first, %high_next, %high_last : i32, i32, i32, i32
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @extract_i32x32_halves(%values: reg<aie2p.vec256 x4>) -> (reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>, reg<aie2p.er>) asm {
  %14 = slice %values[0] : reg<aie2p.vec256 x4> -> reg<aie2p.vec256 x2>
  %low_last = vextract.32.imm %14, 15
  %16 = slice %values[2] : reg<aie2p.vec256 x4> -> reg<aie2p.vec256 x2>
  %high_first = vextract.32.imm %16, 0
  %high_next = vextract.32.imm %16, 1
  %high_last = vextract.32.imm %16, 15
  return %low_last, %high_first, %high_next, %high_last
}

