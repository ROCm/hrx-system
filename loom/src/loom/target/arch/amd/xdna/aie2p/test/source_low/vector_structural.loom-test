aie2p.target<core> @target

func.def target(@target) @i32x32_extract_dynamic(%values: vector<32xi32>, %lane: index) -> (i32) {
  %result = vector.extract %values[%lane] : vector<32xi32> -> i32
  func.return %result : i32
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @i32x32_extract_dynamic(%values: reg<aie2p.vec256 x4>, %lane: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %7 = slice %values[0] : reg<aie2p.vec256 x4> -> reg<aie2p.vec256 x2>
  %8 = slice %values[2] : reg<aie2p.vec256 x4> -> reg<aie2p.vec256 x2>
  %9 = mov.short 15
  %10 = mov.short 16
  %11 = and %lane, %9
  %12 = and %lane, %10
  %13 = vextract.32.reg %7, %11
  %14 = vextract.32.reg %8, %11
  %15 = copy %12 : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %result = sel.nez %14, %13, %15
  return %result
}

