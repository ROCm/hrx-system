func.def target(@target) @concat_and_slice_i16_halves(%low: vector<16xi16>, %high: vector<16xi16>) -> (vector<16xi16>) {
  %window = vector.concat<0> %low, %high : vector<16xi16>, vector<16xi16> -> vector<32xi16>
  %result = vector.slice %window[3] : vector<32xi16> -> vector<16xi16>
  func.return %result : vector<16xi16>
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @concat_and_slice_i16_halves(%low: reg<aie2p.vec256 x2>, %high: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %8 = slice %low[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %9 = slice %high[0] : reg<aie2p.vec256 x2> -> reg<aie2p.vec256>
  %window = concat(%8, %9) : (reg<aie2p.vec256>, reg<aie2p.vec256>) -> reg<aie2p.vec256 x2>
  %11 = mova.i32 6
  %result = vshift %window, %window, %11
  return %result
}

