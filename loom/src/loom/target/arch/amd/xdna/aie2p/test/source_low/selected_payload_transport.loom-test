func.def public @selected_extended_truncation(%input: vector<4xi32>, %left: i64, %right: i64) -> (i64) {
  %value = vector.extract %input[0] : vector<4xi32> -> i32
  %threshold = scalar.constant 0 : i32
  %condition = scalar.cmpi sgt, %value, %threshold : i32
  %selected = scf.select %condition, %left, %right : i64
  %narrowed = scalar.trunci %selected : i64 to i32
  %payload = scalar.extsi %narrowed : i32 to i64
  cfg.br ^forward(%payload: i64)
^forward(%carried: i64):
  func.return %carried : i64
}

// ----
low.func.def public target<amd.xdna.aie2p.core> abi(object_function) @selected_extended_truncation(%input: reg<aie2p.vec256 x2>, %left: reg<aie2p.er x2>, %right: reg<aie2p.er x2>) -> (reg<aie2p.er x2>) asm {
  %value = vextract.32.imm %input, 0
  %threshold = mov.short 0
  %condition = lt %threshold, %value
  %19 = slice %left[0] : reg<aie2p.er x2> -> reg<aie2p.er>
  %20 = slice %left[1] : reg<aie2p.er x2> -> reg<aie2p.er>
  %21 = slice %right[0] : reg<aie2p.er x2> -> reg<aie2p.er>
  %22 = slice %right[1] : reg<aie2p.er x2> -> reg<aie2p.er>
  %23 = copy %condition : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %24 = sel.nez %19, %21, %23
  %25 = copy %condition : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %26 = sel.nez %20, %22, %25
  %selected = concat(%24, %26) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  %narrowed = slice %selected[0] : reg<aie2p.er x2> -> reg<aie2p.er>
  %29 = mov.short -31
  %30 = ashl %narrowed, %29
  %payload = concat(%narrowed, %30) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  low.br ^forward(%payload: reg<aie2p.er x2>)
^forward(%carried: reg<aie2p.er x2>):
  return %carried
}

