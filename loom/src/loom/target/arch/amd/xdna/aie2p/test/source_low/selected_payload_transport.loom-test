  %18 = slice %right[0] : reg<aie2p.er x2> -> reg<aie2p.er>
  %19 = slice %right[1] : reg<aie2p.er x2> -> reg<aie2p.er>
  %20 = copy %condition : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %21 = sel.nez %16, %18, %20
  %22 = copy %condition : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %23 = sel.nez %17, %19, %22
  %selected = concat(%21, %23) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  %payload = slice %selected[0] : reg<aie2p.er x2> -> reg<aie2p.er>
  low.br ^forward(%payload: reg<aie2p.er>)
^forward(%carried: reg<aie2p.er>):
  return %carried
}

