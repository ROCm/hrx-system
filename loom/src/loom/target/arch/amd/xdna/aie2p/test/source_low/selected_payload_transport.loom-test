// TEMPLATE: loom/src/loom/test/corpus/source_low/selected_payload_transport.loom-test
// RUN: pass target=amd.xdna.aie2p:core source-to-low

func.def public @selected_truncated(%input: vector<4xi32>, %left: i64, %right: i64) -> (i32) {
  %value = vector.extract %input[0] : vector<4xi32> -> i32
  %threshold = scalar.constant 0 : i32
  %condition = scalar.cmpi sgt, %value, %threshold : i32
  %selected = scf.select %condition, %left, %right : i64
  %payload = scalar.trunci %selected : i64 to i32
  cfg.br ^forward(%payload: i32)
^forward(%carried: i32):
  func.return %carried : i32
}

// ----
low.func.def public target<amd.xdna.aie2p.core> abi(object_function) @selected_truncated(%input: reg<aie2p.vec256 x2>, %left: reg<aie2p.er x2>, %right: reg<aie2p.er x2>) -> (reg<aie2p.er>) asm {
  %value = vextract.32.imm %input, 0
  %threshold = mov.short 0
  %condition = lt %threshold, %value
  %18 = slice %left[0] : reg<aie2p.er x2> -> reg<aie2p.er>
  %19 = slice %left[1] : reg<aie2p.er x2> -> reg<aie2p.er>
  %20 = slice %right[0] : reg<aie2p.er x2> -> reg<aie2p.er>
  %21 = slice %right[1] : reg<aie2p.er x2> -> reg<aie2p.er>
  %22 = copy %condition : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %23 = sel.nez %18, %20, %22
  %24 = copy %condition : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %25 = sel.nez %19, %21, %24
  %selected = concat(%23, %25) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  %payload = slice %selected[0] : reg<aie2p.er x2> -> reg<aie2p.er>
  low.br ^forward(%payload: reg<aie2p.er>)
^forward(%carried: reg<aie2p.er>):
  return %carried
}

