  %value = vextract.32.imm %input, 0
  %threshold = mov.short 0
  %condition = lt %threshold, %value
  %23 = copy %condition : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %bounded = sel.nez %left, %right, %23
  %increment = mov.short 3
  %transformed = add.rr %payload, %increment
  low.br ^forward(%transformed: reg<aie2p.er>)
^forward(%carried: reg<aie2p.er>):
  return %carried
}

