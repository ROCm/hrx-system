  %97, %98, %99, %100 = vlda.pop.bfp16ebs8.volatile<volatile> %94, %95, %96
  %101, %102, %103, %104 = vlda.pop.bfp16ebs8.volatile<volatile> %98, %99, %100
  %105, %106, %107 = vlda.fill.512.volatile<volatile> %102, %103, %104
  %109, %110, %111, %112 = vlda.pop.bfp16ebs8.buffered64.volatile<volatile> %105, %106, %107
  %113, %114, %115, %116 = vlda.pop.bfp16ebs8.volatile<volatile> %110, %111, %112
  %117, %118, %119, %120 = vlda.pop.bfp16ebs8.volatile<volatile> %114, %115, %116
  %121, %122, %123, %124 = vlda.pop.bfp16ebs8.volatile<volatile> %118, %119, %120
  %125, %126, %127, %128 = vlda.pop.bfp16ebs8.volatile<volatile> %122, %123, %124
  %129, %130, %131, %132 = vlda.pop.bfp16ebs8.volatile<volatile> %126, %127, %128
  %133, %134, %135, %136 = vlda.pop.bfp16ebs8.volatile<volatile> %130, %131, %132
  %137, %138, %139, %140 = vlda.pop.bfp16ebs8.volatile<volatile> %134, %135, %136
  %145 = mova.i32 780
  %product = mmul.bfp16ebs8.m8n8k8 %37, %137, %145
  %147 = slice %product[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %147, %output_aligned, 0
  %148 = slice %product[1] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %148, %output_aligned, 64
  %149 = slice %product[2] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %149, %output_aligned, 128
  %150 = slice %product[3] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %150, %output_aligned, 192
  return
}

// ====
// RUN: emit source-low output=low

aie2p.target<core> @target

func.def target(@target) @misaligned_record(%input: buffer) -> (vector<64xf32>) {
  %aligned = buffer.assume.alignment %input {minimum_alignment = 64} : buffer
  %origin = index.constant 0 : offset
  %tile_extent = index.constant 8 : index
  %block_count = index.constant 8 : index
  %schema = encoding.define #encoding.operand<element_format=bfp16ebs8, payload_elements=64, payload_packing=target_fragment, payload_registers=18, rounding=flush_subnormal> : encoding<schema>
  %view = buffer.view %aligned[%origin] : buffer -> view<576xi8>
  %bytes = vector.load %view[0] : view<576xi8> -> vector<576xi8>
  %group = vector.fragment<lhs> %bytes shape [blocks(%block_count), %tile_extent, %tile_extent] using {schema = %schema : encoding<schema>} : vector<576xi8>
  // ERROR@+1: TARGET/003 {constraint_key="element_0_multiple_of_72"}
  %slice = vector.slice %group[1] : vector<576xi8> -> vector<72xi8>
  %left = vector.fragment<lhs> %slice shape [%tile_extent, %tile_extent] using {schema = %schema : encoding<schema>} : vector<72xi8>
  %right = vector.fragment<rhs> %slice shape [%tile_extent, %tile_extent] using {schema = %schema : encoding<schema>} : vector<72xi8>
  %initial_values = vector.splatf 0.0 : vector<64xf32>
  %init = vector.fragment<init> %initial_values shape [%tile_extent, %tile_extent] : vector<64xf32>
  %product = vector.mma %left, %right, %init : vector<72xi8>, vector<72xi8>, vector<64xf32>
  func.return %product : vector<64xf32>
}

// ====
// RUN: pass source-to-low

aie2p.target<core> @target

func.def target(@target) @incomplete_group(%input: buffer) {
  %aligned = buffer.assume.alignment %input {minimum_alignment = 64} : buffer
  %origin = index.constant 0 : offset
  %tile_extent = index.constant 8 : index
  %block_count = index.constant 9 : index
  %schema = encoding.define #encoding.operand<element_format=bfp16ebs8, payload_elements=64, payload_packing=target_fragment, payload_registers=18, rounding=flush_subnormal> : encoding<schema>
  %view = buffer.view %aligned[%origin] : buffer -> view<648xi8>
  // ERROR@+1: TARGET/004 {subject_name="result", constraint_key="static_dim0_multiple", expected_count="576"}
  %bytes = vector.load<volatile> %view[0] : view<648xi8> -> vector<648xi8>
  %group = vector.fragment<lhs> %bytes shape [blocks(%block_count), %tile_extent, %tile_extent] using {schema = %schema : encoding<schema>} : vector<648xi8>
  func.return
}
