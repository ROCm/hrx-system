  %aligned = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %output_aligned = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %28 = mov.load-fifo.pointer %aligned
  %29 = mov.static-byte-offset 64
  %30 = mov.i32 576
  %31 = mac %29, %record, %30
  %32 = mov.modifier %31
  %33 = paddb.modifier %28, %32
  %34 = vlda.load-fifo.low512.volatile<volatile> %33, 0
  %35 = mova.fifo.position 64
  %36, %37, %38, %39 = vlda.pop.bfp16ebs8.buffered64.volatile<volatile> %33, %34, %35
  %40, %41, %42, %43 = vlda.pop.bfp16ebs8.volatile<volatile> %37, %38, %39
  %44, %45, %46, %47 = vlda.pop.bfp16ebs8.volatile<volatile> %41, %42, %43
  %48, %49, %50, %51 = vlda.pop.bfp16ebs8.volatile<volatile> %45, %46, %47
  %52, %53, %54, %55 = vlda.pop.bfp16ebs8.volatile<volatile> %49, %50, %51
  %56, %57, %58, %59 = vlda.pop.bfp16ebs8.volatile<volatile> %53, %54, %55
  %60, %61, %62, %63 = vlda.pop.bfp16ebs8.volatile<volatile> %57, %58, %59
  %64, %65, %66, %67 = vlda.pop.bfp16ebs8.volatile<volatile> %61, %62, %63
  %71 = mova.i32 780
  %product = mmul.bfp16ebs8.m8n8k8 %36, %64, %71
  %73 = slice %product[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %73, %output_aligned, 0
  %74 = slice %product[1] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %74, %output_aligned, 64
  %75 = slice %product[2] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %75, %output_aligned, 128
  %76 = slice %product[3] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %76, %output_aligned, 192
