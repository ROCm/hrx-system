// RUN: emit source-low output=low
aie2p.target<core> @target

func.def target(@target) @matrix_bfp_group(%left: buffer, %right: buffer, %output: buffer) {
  %left_aligned, %right_aligned, %output_aligned = buffer.assume.alignment %left, %right, %output {minimum_alignment = 64} : buffer, buffer, buffer
  %origin = index.constant 0 : offset
  %tile_extent = index.constant 8 : index
  %schema = encoding.define #encoding.operand<element_format=bfp16ebs8, payload_elements=64, payload_packing=target_fragment, payload_registers=18, rounding=flush_subnormal> : encoding<schema>
  %out = buffer.view %output_aligned[%origin] : buffer -> view<8x8xf32>
  %left_view = buffer.view %left_aligned[%origin] : buffer -> view<576xi8>
  %left_bytes = vector.load %left_view[0] : view<576xi8> -> vector<576xi8>
  %left_group = vector.fragment<lhs> %left_bytes shape [blocks(%tile_extent), %tile_extent, %tile_extent] using {schema = %schema : encoding<schema>} : vector<576xi8>
  %right_view = buffer.view %right_aligned[%origin] : buffer -> view<576xi8>
  %right_bytes = vector.load %right_view[0] : view<576xi8> -> vector<576xi8>
  %right_group = vector.fragment<rhs> %right_bytes shape [blocks(%tile_extent), %tile_extent, %tile_extent] using {schema = %schema : encoding<schema>} : vector<576xi8>
  %initial_values = vector.splatf 0.0 : vector<64xf32>
  %acc0 = vector.fragment<init> %initial_values shape [%tile_extent, %tile_extent] : vector<64xf32>
  %left_0 = vector.slice %left_group[0] : vector<576xi8> -> vector<72xi8>
  %left_tile_0 = vector.fragment<lhs> %left_0 shape [%tile_extent, %tile_extent] using {schema = %schema : encoding<schema>} : vector<72xi8>
  %right_0 = vector.slice %right_group[0] : vector<576xi8> -> vector<72xi8>
  %right_tile_0 = vector.fragment<rhs> %right_0 shape [%tile_extent, %tile_extent] using {schema = %schema : encoding<schema>} : vector<72xi8>
  %acc1 = vector.mma %left_tile_0, %right_tile_0, %acc0 : vector<72xi8>, vector<72xi8>, vector<64xf32>
  %left_1 = vector.slice %left_group[72] : vector<576xi8> -> vector<72xi8>
  %left_tile_1 = vector.fragment<lhs> %left_1 shape [%tile_extent, %tile_extent] using {schema = %schema : encoding<schema>} : vector<72xi8>
  %right_1 = vector.slice %right_group[72] : vector<576xi8> -> vector<72xi8>
  %right_tile_1 = vector.fragment<rhs> %right_1 shape [%tile_extent, %tile_extent] using {schema = %schema : encoding<schema>} : vector<72xi8>
  %acc2 = vector.mma %left_tile_1, %right_tile_1, %acc1 : vector<72xi8>, vector<72xi8>, vector<64xf32>
  %left_2 = vector.slice %left_group[144] : vector<576xi8> -> vector<72xi8>
  %left_tile_2 = vector.fragment<lhs> %left_2 shape [%tile_extent, %tile_extent] using {schema = %schema : encoding<schema>} : vector<72xi8>
  %right_2 = vector.slice %right_group[144] : vector<576xi8> -> vector<72xi8>
  %right_tile_2 = vector.fragment<rhs> %right_2 shape [%tile_extent, %tile_extent] using {schema = %schema : encoding<schema>} : vector<72xi8>
  %acc3 = vector.mma %left_tile_2, %right_tile_2, %acc2 : vector<72xi8>, vector<72xi8>, vector<64xf32>
  %left_3 = vector.slice %left_group[216] : vector<576xi8> -> vector<72xi8>
  %left_tile_3 = vector.fragment<lhs> %left_3 shape [%tile_extent, %tile_extent] using {schema = %schema : encoding<schema>} : vector<72xi8>
  %right_3 = vector.slice %right_group[216] : vector<576xi8> -> vector<72xi8>
  %right_tile_3 = vector.fragment<rhs> %right_3 shape [%tile_extent, %tile_extent] using {schema = %schema : encoding<schema>} : vector<72xi8>
  %acc4 = vector.mma %left_tile_3, %right_tile_3, %acc3 : vector<72xi8>, vector<72xi8>, vector<64xf32>
  %left_4 = vector.slice %left_group[288] : vector<576xi8> -> vector<72xi8>
  %left_tile_4 = vector.fragment<lhs> %left_4 shape [%tile_extent, %tile_extent] using {schema = %schema : encoding<schema>} : vector<72xi8>
  %right_4 = vector.slice %right_group[288] : vector<576xi8> -> vector<72xi8>
  %right_tile_4 = vector.fragment<rhs> %right_4 shape [%tile_extent, %tile_extent] using {schema = %schema : encoding<schema>} : vector<72xi8>
  %acc5 = vector.mma %left_tile_4, %right_tile_4, %acc4 : vector<72xi8>, vector<72xi8>, vector<64xf32>
  %left_5 = vector.slice %left_group[360] : vector<576xi8> -> vector<72xi8>
  %left_tile_5 = vector.fragment<lhs> %left_5 shape [%tile_extent, %tile_extent] using {schema = %schema : encoding<schema>} : vector<72xi8>
  %right_5 = vector.slice %right_group[360] : vector<576xi8> -> vector<72xi8>
  %right_tile_5 = vector.fragment<rhs> %right_5 shape [%tile_extent, %tile_extent] using {schema = %schema : encoding<schema>} : vector<72xi8>
  %acc6 = vector.mma %left_tile_5, %right_tile_5, %acc5 : vector<72xi8>, vector<72xi8>, vector<64xf32>
  %left_6 = vector.slice %left_group[432] : vector<576xi8> -> vector<72xi8>
  %left_tile_6 = vector.fragment<lhs> %left_6 shape [%tile_extent, %tile_extent] using {schema = %schema : encoding<schema>} : vector<72xi8>
  %right_6 = vector.slice %right_group[432] : vector<576xi8> -> vector<72xi8>
  %right_tile_6 = vector.fragment<rhs> %right_6 shape [%tile_extent, %tile_extent] using {schema = %schema : encoding<schema>} : vector<72xi8>
  %acc7 = vector.mma %left_tile_6, %right_tile_6, %acc6 : vector<72xi8>, vector<72xi8>, vector<64xf32>
  %left_7 = vector.slice %left_group[504] : vector<576xi8> -> vector<72xi8>
  %left_tile_7 = vector.fragment<lhs> %left_7 shape [%tile_extent, %tile_extent] using {schema = %schema : encoding<schema>} : vector<72xi8>
  %right_7 = vector.slice %right_group[504] : vector<576xi8> -> vector<72xi8>
  %right_tile_7 = vector.fragment<rhs> %right_7 shape [%tile_extent, %tile_extent] using {schema = %schema : encoding<schema>} : vector<72xi8>
  %acc8 = vector.mma %left_tile_7, %right_tile_7, %acc7 : vector<72xi8>, vector<72xi8>, vector<64xf32>
  vector.fragment.store<result> %acc8, %out[0, 0] shape [%tile_extent, %tile_extent] : vector<64xf32>, view<8x8xf32>
  func.return
}

