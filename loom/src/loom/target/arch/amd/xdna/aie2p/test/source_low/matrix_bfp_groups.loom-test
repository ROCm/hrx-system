func.def target(@target) @matrix_bfp_group_static(%input: buffer, %output: buffer) {
  %aligned, %output_aligned = buffer.assume.alignment %input, %output {minimum_alignment = 64} : buffer, buffer
  %base = index.constant 64 : offset
  %origin = index.constant 0 : offset
  %tile_extent = index.constant 8 : index
  %schema = encoding.define #encoding.operand<element_format=bfp16ebs8, payload_elements=64, payload_packing=target_fragment, payload_registers=18, rounding=flush_subnormal> : encoding<schema>
  %input_view = buffer.view %aligned[%base] : buffer -> view<576xi8>
  %bytes = vector.load %input_view[0] : view<576xi8> -> vector<576xi8>
  %group = vector.fragment<lhs> %bytes shape [blocks(%tile_extent), %tile_extent, %tile_extent] using {schema = %schema : encoding<schema>} : vector<576xi8>
  %first_bytes = vector.slice %group[0] : vector<576xi8> -> vector<72xi8>
  %last_bytes = vector.slice %group[504] : vector<576xi8> -> vector<72xi8>
  %first = vector.fragment<lhs> %first_bytes shape [%tile_extent, %tile_extent] using {schema = %schema : encoding<schema>} : vector<72xi8>
  %last = vector.fragment<rhs> %last_bytes shape [%tile_extent, %tile_extent] using {schema = %schema : encoding<schema>} : vector<72xi8>
  %initial_values = vector.splatf 0.0 : vector<64xf32>
  %init = vector.fragment<init> %initial_values shape [%tile_extent, %tile_extent] : vector<64xf32>
  %product = vector.mma %first, %last, %init : vector<72xi8>, vector<72xi8>, vector<64xf32>
  %out = buffer.view %output_aligned[%origin] : buffer -> view<8x8xf32>
  vector.fragment.store<result> %product, %out[0, 0] shape [%tile_extent, %tile_extent] : vector<64xf32>, view<8x8xf32>
  func.return
}

