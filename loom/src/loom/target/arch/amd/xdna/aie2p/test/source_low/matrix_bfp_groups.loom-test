low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @matrix_bfp_group() asm {
  %left_aligned = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %right_aligned = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %output_aligned = resource<native_pointer> {index = 2, source_type = buffer} : reg<aie2p.ep>
  %61 = mov.load-fifo.pointer %left_aligned
  %62 = vlda.load-fifo.low512 %61, 0
  %63 = mova.fifo.position 64
  %64, %65, %66, %67 = vlda.pop.bfp16ebs8.buffered64 %61, %62, %63
  %68, %69, %70, %71 = vlda.pop.bfp16ebs8 %65, %66, %67
  %72, %73, %74, %75 = vlda.pop.bfp16ebs8 %69, %70, %71
  %76, %77, %78, %79 = vlda.pop.bfp16ebs8 %73, %74, %75
  %80, %81, %82, %83 = vlda.pop.bfp16ebs8 %77, %78, %79
  %84, %85, %86, %87 = vlda.pop.bfp16ebs8 %81, %82, %83
  %88, %89, %90, %91 = vlda.pop.bfp16ebs8 %85, %86, %87
  %92, %93, %94, %95 = vlda.pop.bfp16ebs8 %89, %90, %91
  %97 = mov.load-fifo.pointer %right_aligned
  %98 = vlda.load-fifo.low512 %97, 0
  %99 = mova.fifo.position 64
  %100, %101, %102, %103 = vlda.pop.bfp16ebs8.buffered64 %97, %98, %99
  %104, %105, %106, %107 = vlda.pop.bfp16ebs8 %101, %102, %103
  %108, %109, %110, %111 = vlda.pop.bfp16ebs8 %105, %106, %107
  %112, %113, %114, %115 = vlda.pop.bfp16ebs8 %109, %110, %111
  %116, %117, %118, %119 = vlda.pop.bfp16ebs8 %113, %114, %115
  %120, %121, %122, %123 = vlda.pop.bfp16ebs8 %117, %118, %119
  %124, %125, %126, %127 = vlda.pop.bfp16ebs8 %121, %122, %123
  %128, %129, %130, %131 = vlda.pop.bfp16ebs8 %125, %126, %127
  %135 = mova.i32 780
  %acc1 = mmul.bfp16ebs8.m8n8k8 %64, %100, %135
  %acc2 = mma.bfp16ebs8.m8n8k8 %acc1, %68, %104, %135
  %acc3 = mma.bfp16ebs8.m8n8k8 %acc2, %72, %108, %135
  %acc4 = mma.bfp16ebs8.m8n8k8 %acc3, %76, %112, %135
  %acc5 = mma.bfp16ebs8.m8n8k8 %acc4, %80, %116, %135
  %acc6 = mma.bfp16ebs8.m8n8k8 %acc5, %84, %120, %135
  %acc7 = mma.bfp16ebs8.m8n8k8 %acc6, %88, %124, %135
  %acc8 = mma.bfp16ebs8.m8n8k8 %acc7, %92, %128, %135
  %165 = slice %acc8[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %165, %output_aligned, 0
  %166 = slice %acc8[1] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %166, %output_aligned, 64
  %167 = slice %acc8[2] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %167, %output_aligned, 128
  %168 = slice %acc8[3] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  vst.acc %168, %output_aligned, 192
