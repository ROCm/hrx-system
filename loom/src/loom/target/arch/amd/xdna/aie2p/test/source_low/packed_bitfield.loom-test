func.def @i32_bitfield_extracts_top_aligned(%value: i32) -> (i32) {
  %packed = vector.from_elements %value : vector<1xi32>
  %nibble = vector.bitfield.extracts %packed {offset = 28, width = 4} : vector<1xi32> -> vector<1xi32>
  %result = vector.extract %nibble[0] : vector<1xi32> -> i32
  func.return %result : i32
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i32_bitfield_extracts_top_aligned(%value: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %11 = mov.short 0
  %12 = lshl %value, %11
  %13 = mov.short -28
  %14 = ashl %12, %13
  return %14
}

// ====

func.def @i32_bitfield_insert(%field_value: i32, %base_value: i32) -> (i32) {
  %field = vector.from_elements %field_value : vector<1xi32>
  %base = vector.from_elements %base_value : vector<1xi32>
  %inserted = vector.bitfield.insert %field into %base {offset = 8, width = 4} : vector<1xi32>, vector<1xi32>
  %result = vector.extract %inserted[0] : vector<1xi32> -> i32
  func.return %result : i32
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i32_bitfield_insert(%field_value: reg<aie2p.er>, %base_value: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %24 = mov.short 15
  %25 = and %field_value, %24
  %26 = mov.short 8
  %27 = lshl %25, %26
  %28 = mov.i32 -3841
  %29 = and %base_value, %28
  %30 = or %29, %27
  return %30
}

// ====

func.def @i32_bitfield_insert_offset0(%field_value: i32, %base_value: i32) -> (i32) {
  %field = vector.from_elements %field_value : vector<1xi32>
