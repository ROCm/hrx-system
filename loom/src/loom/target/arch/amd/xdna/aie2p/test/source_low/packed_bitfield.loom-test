// RUN: emit source-low target=amd.xdna.aie2p:core output=low

func.def @i32_bitfield_extractu(%value: i32) -> (i32) {
  %packed = vector.from_elements %value : vector<1xi32>
  %nibble = vector.bitfield.extractu %packed {offset = 4, width = 4} : vector<1xi32> -> vector<1xi32>
  %result = vector.extract %nibble[0] : vector<1xi32> -> i32
  func.return %result : i32
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i32_bitfield_extractu(%value: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %11 = mov.short 24
  %12 = lshl %value, %11
  %13 = mov.short -28
  %14 = lshl %12, %13
  return %14
}

// ====

func.def @i32_bitfield_extracts(%value: i32) -> (i32) {
  %packed = vector.from_elements %value : vector<1xi32>
  %nibble = vector.bitfield.extracts %packed {offset = 4, width = 4} : vector<1xi32> -> vector<1xi32>
  %result = vector.extract %nibble[0] : vector<1xi32> -> i32
