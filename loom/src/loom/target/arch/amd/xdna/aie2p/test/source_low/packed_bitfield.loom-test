// ====

func.def @i32_bitfield_b128_shape(%loaded: vector<4xi32>) -> (vector<4xi32>) {
  %low = vector.bitfield.extractu %loaded {offset = 0, width = 4} : vector<4xi32> -> vector<4xi32>
  %high = vector.bitfield.extractu %loaded {offset = 4, width = 2} : vector<4xi32> -> vector<4xi32>
  %merged = vector.bitfield.insert %high into %low {offset = 4, width = 2} : vector<4xi32>, vector<4xi32>
  %bias = vector.constant 32 : vector<4xi32>
  %result = vector.subi %merged, %bias : vector<4xi32>
  func.return %result : vector<4xi32>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i32_bitfield_b128_shape(%loaded: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %78 = vextract.32.imm %loaded, 0
  %79 = mov.short 26
  %80 = lshl %78, %79
  %81 = mov.short -30
  %82 = lshl %80, %81
  %83 = mov.short 15
  %84 = and %78, %83
  %85 = mov.short 4
  %86 = lshl %82, %85
  %87 = mov.short -49
  %88 = and %84, %87
  %89 = or %88, %86
  %90 = vextract.32.imm %loaded, 1
  %92 = lshl %90, %79
  %94 = lshl %92, %81
  %95 = and %90, %83
  %96 = lshl %94, %85
  %97 = and %95, %87
  %98 = or %97, %96
  %99 = vextract.32.imm %loaded, 2
  %101 = lshl %99, %79
  %103 = lshl %101, %81
  %104 = and %99, %83
  %105 = lshl %103, %85
  %106 = and %104, %87
  %107 = or %106, %105
  %108 = vextract.32.imm %loaded, 3
  %110 = lshl %108, %79
  %112 = lshl %110, %81
  %113 = and %108, %83
  %114 = lshl %112, %85
  %115 = and %113, %87
  %116 = or %115, %114
  %117 = vbcst.32 %89
  %118 = mov.short 1
  %119 = copy %118 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %120 = vinsert.32.reg %117, %119, %98
  %121 = mov.short 2
  %122 = copy %121 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %123 = vinsert.32.reg %120, %122, %107
  %124 = mov.short 3
  %125 = copy %124 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %merged = vinsert.32.reg %123, %125, %116
  %127 = mov.short 32
  %bias = vbcst.32 %127
  %result = vsub.32 %merged, %bias
  return %result
}
