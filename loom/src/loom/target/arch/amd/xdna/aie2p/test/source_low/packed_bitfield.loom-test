func.def @i32_bitfield_extracts_top_aligned(%value: i32) -> (i32) {
  %packed = vector.from_elements %value : vector<1xi32>
  %nibble = vector.bitfield.extracts %packed {offset = 28, width = 4} : vector<1xi32> -> vector<1xi32>
  %result = vector.extract %nibble[0] : vector<1xi32> -> i32
  func.return %result : i32
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i32_bitfield_extracts_top_aligned(%value: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %10 = mov.short 0
  %11 = lshl %value, %10
  %12 = mov.short -28
  %13 = ashl %11, %12
  return %13
