aie2p.target<core> @core_target

func.decl target(@core_target) @worker()

low.func.def target<amd.xdna.aie2p.configuration>(@configuration_target) @initialize() asm {
  %zero = constant 0 : reg<aie2p.config.scalar : i64>
  %row = constant 2 : reg<aie2p.config.scalar : i64>
  // ERROR@+1: XDNA/036 {field_name="program", symbol_name="worker", definition_kind="source or Low function"}
  program.load %zero, %row, @worker
  return
}

// ====
// RUN: verify

// Configuration phases require definitions before physical materialization.
aie2p.target<configuration> @configuration_target

func.decl target(@configuration_target) @initialize()

low.func.def target<amd.xdna.aie2p.configuration>(@configuration_target) @invoke() asm {
  return
}

low.func.def target<amd.xdna.aie2p.configuration>(@configuration_target) abi(array_program) @stream() asm {
  %one = constant 1 : reg<aie2p.config.scalar : i64>
  // ERROR@+1: XDNA/036 {field_name="initialize", symbol_name="initialize", definition_kind="source or Low function"}
  entry %one, @initialize, @invoke
  return
}

// ====
// RUN: with-checks emit source-low output=module

// The configuration reference survives ordinary source compilation. Its
// complete worker and helper call lower for the core target, with the volatile
// publication read and store preserved. Register choices are unconstrained.
aie2p.target<configuration> @configuration_target {device_profile = "amd.xdna.strix_halo.17f0_11"}

aie2p.target<core> @core_target

low.func.def public retain target<amd.xdna.aie2p.configuration>(@configuration_target) abi(array_program) @stream() asm {
  %one = constant 1 : reg<aie2p.config.scalar : i64>
  entry %one, @initialize, @invoke
  return
}

low.func.def target<amd.xdna.aie2p.configuration>(@configuration_target) @initialize() asm {
  %zero = constant 0 : reg<aie2p.config.scalar : i64>
  %row = constant 2 : reg<aie2p.config.scalar : i64>
  program.load %zero, %row, @worker
  return
}

low.func.def target<amd.xdna.aie2p.configuration>(@configuration_target) @invoke() asm {
  return
}

low.func.def target<amd.xdna.aie2p.core>(@core_target) @storage() -> (reg<aie2p.ep>) asm {
  %address = mov.local-address 458752
  return %address
}

func.def @advance(%state: view<1xi32>) {
  %increment = scalar.constant 1 : i32
  %previous = view.load<volatile> %state[0] : view<1xi32> -> i32
  %next = scalar.addi %previous, %increment : i32
  view.store %next, %state[0] : i32, view<1xi32>
  func.return
}

func.def target(@core_target) @worker() {
  %memory = low.invoke @storage() : () -> (buffer)
  %aligned = buffer.assume.alignment %memory {minimum_alignment = 4} : buffer
  %origin = index.constant 0 : offset
  %state = buffer.view %aligned[%origin] : buffer -> view<1xi32>
  func.call @advance(%state) : (view<1xi32>)
  func.return
}

// ----
CHECK: program.load *, @worker
CHECK: low.func.def target<amd.xdna.aie2p.core>(@core_target) abi(object_function) @worker() asm {
CHECK: %* = lda.volatile<volatile> *, 0
CHECK: st *, *, 0
CHECK-NOT: func.def *
CHECK-NOT: func.call *
CHECK-NOT: *low.invoke *

// ====
// RUN: emit source-low output=module

// Configuration worker references preserve the ordinary helper-inlining path.
aie2p.target<configuration> @configuration_target

aie2p.target<core> @core_target

low.func.def target<amd.xdna.aie2p.core>(@core_target) @helper() asm {
  return
}

low.func.def target<amd.xdna.aie2p.core>(@core_target) @worker() asm {
  low.func.call @helper() : ()
  return
}

low.func.def public retain target<amd.xdna.aie2p.configuration>(@configuration_target) @initialize() asm {
  %column = constant 0 : reg<aie2p.config.scalar : i64>
  %row = constant 2 : reg<aie2p.config.scalar : i64>
  program.load %column, %row, @worker
  return
}

