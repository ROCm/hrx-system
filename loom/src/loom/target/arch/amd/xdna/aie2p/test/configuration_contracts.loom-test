  %row = constant 2 : reg<aie2p.config.scalar : i64>
  // ERROR@+1: TARGET/079 {function_name="initialize", descriptor_key="amd.xdna.aie2p.configuration.program.load", immediate_name="program", symbol_name="initialize", actual_contract="amd.xdna.aie2p.configuration", expected_contract="amd.xdna.aie2p.core"}
