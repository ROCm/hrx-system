// RUN: format bytecode

// The worker owns the complete acquire/consume/release loop. Configuration
// only places its image and initializes the physical resources it addresses.
aie2p.target<configuration> @configuration_target {device_profile = "amd.xdna.strix_halo.17f0_11"}
aie2p.target<core> @core_target

low.func.def public retain target<amd.xdna.aie2p.configuration>(@configuration_target) abi(array_program) @stream() asm {
  %columns = constant 2 : reg<aie2p.config.scalar : i64>
  entry %columns, @initialize, @invoke
  return
}

low.func.def target<amd.xdna.aie2p.configuration>(@configuration_target) @initialize() asm {
  %zero = constant 0 : reg<aie2p.config.scalar : i64>
  %one = constant 1 : reg<aie2p.config.scalar : i64>
  %row = constant 2 : reg<aie2p.config.scalar : i64>
  %control = constant 2293760 : reg<aie2p.config.scalar : i64>
  write32 %control, %zero
  program.load %zero, %row, @worker
  program.load %one, %row, @worker
  write.mask32 %control, %one, %one
  return
}

low.func.def target<amd.xdna.aie2p.configuration>(@configuration_target) @invoke() asm {
  %zero = constant 0 : reg<aie2p.config.scalar : i64>
  %one = constant 1 : reg<aie2p.config.scalar : i64>
  %alignment = constant 64 : reg<aie2p.config.scalar : i64>
  %header_length = constant 256 : reg<aie2p.config.scalar : i64>
  %payload_length = constant 4096 : reg<aie2p.config.scalar : i64>
  %binding_length = constant 4352 : reg<aie2p.config.scalar : i64>
  %words = constant 1024 : reg<aie2p.config.scalar : i64>
  %binding = binding %zero, %one, %binding_length, %alignment
  %payload = range %binding, %header_length, %payload_length
  %header = range %binding, %zero, %header_length
  %header_address = constant 2588608 : reg<aie2p.config.scalar : i64>
  write.address %header_address, %header
  %descriptor_address = constant 118784 : reg<aie2p.config.scalar : i64>
  shim.descriptor %descriptor_address, %payload, %words, %zero, %zero, %zero, %zero, %zero, %one
  %queue = constant 119316 : reg<aie2p.config.scalar : i64>
  write.block32 (%queue) [%zero, %one]
  dma.wait %zero, %zero, %one, %zero, %one, %one
  return
}

low.func.def target<amd.xdna.aie2p.core>(@core_target) abi(object_function) @worker() asm {
  %one = mova.i32 1
  %header = mov.local-address 458752
  %count = lda %header, 0
  low.br ^next(%count: reg<aie2p.er>)
^next(%remaining: reg<aie2p.er>):
  low.cond_br %remaining, ^consume, ^done : reg<aie2p.er>
^consume:
  acq %one, 0
  %record = lda %header, 4
  st %record, %header, 8
  rel %one, 1
  %decremented = sub %remaining, %one
  low.br ^next(%decremented: reg<aie2p.er>)
^done:
  return
}

