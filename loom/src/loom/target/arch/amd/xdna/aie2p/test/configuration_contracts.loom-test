// Ordered register completion waits survive bytecode round trips.
// RUN: format bytecode

aie2p.target<configuration> @configuration_target {device_profile = "amd.xdna.strix_halo.17f0_11"}

low.func.def public retain target<amd.xdna.aie2p.configuration>(@configuration_target) abi(array_program) @completion() asm {
  %columns = constant 1 : reg<aie2p.config.scalar : i64>
  entry %columns, @initialize, @invoke
  return
}

low.func.def target<amd.xdna.aie2p.configuration>(@configuration_target) @initialize() asm {
  return
}

low.func.def target<amd.xdna.aie2p.configuration>(@configuration_target) @invoke() asm {
  %status = constant 2224128 : reg<aie2p.config.scalar : i64>
  %mask = constant 63 : reg<aie2p.config.scalar : i64>
  %value = constant 1 : reg<aie2p.config.scalar : i64>
  wait.mask32 %status, %mask, %value
  return
}

