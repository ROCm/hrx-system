// RUN: emit source-low target=amd.xdna.aie2p:core output=low

func.def @aligned_copy(%input: buffer, %output: buffer) {
  %source = buffer.assume.alignment %input {minimum_alignment = 64} : buffer
  %destination = buffer.assume.alignment %output {minimum_alignment = 64} : buffer
  %origin = index.constant 0 : offset
  %length = index.constant 129 : offset
  buffer.copy %source[%origin], %destination[%origin], %length
  func.return
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @aligned_copy() asm {
  %source = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %destination = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %28 = mov.short 0
  %29 = mov.short 128
  %30 = mov.short 64
  low.br ^_bb1(%28: reg<aie2p.er>)
^_bb1(%25: reg<aie2p.er>):
  %31 = ltu %25, %29
  low.cond_br %31, ^_bb2, ^_bb3 : reg<aie2p.er>
^_bb2:
  %32 = mov.address-index %25
  %33 = vlda.512.i32x16.index %source, %32
  vst.512.i32x16.index %33, %destination, %32
  %35 = add.nc %25, %30
  low.br ^_bb1(%35: reg<aie2p.er>)
^_bb3:
  %36 = mov.static-address-index 128
  %37 = lda.i8.index %source, %36
  st.i8.index %37, %destination, %36
  return
}

// ====

func.def @aligned_fill(%pattern: i16, %output: buffer) {
  %destination = buffer.assume.alignment %output {minimum_alignment = 64} : buffer
  %origin = index.constant 0 : offset
  %length = index.constant 129 : offset
  buffer.fill %pattern, %destination[%origin], %length : i16
  func.return
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @aligned_fill(%pattern: reg<aie2p.er>) asm {
  %destination = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %27 = mov.short 0
  %28 = extend.u16 %pattern
  %29 = mov.short 16
  %30 = lshl %28, %29
  %31 = or %28, %30
  %32 = mov.short 128
  %33 = vbcst.32 %31
  %34 = mov.short 64
  low.br ^_bb1(%27: reg<aie2p.er>)
^_bb1(%25: reg<aie2p.er>):
  %35 = ltu %25, %32
  low.cond_br %35, ^_bb2, ^_bb3 : reg<aie2p.er>
^_bb2:
  %36 = mov.address-index %25
  vst.512.i32x16.index %33, %destination, %36
  %37 = add.nc %25, %34
  low.br ^_bb1(%37: reg<aie2p.er>)
^_bb3:
  %38 = mov.static-address-index 128
  st.i8.index %31, %destination, %38
  return
}

// ====

func.def @aligned_compare(%input: buffer, %output: buffer) -> (i32) {
  %source = buffer.assume.alignment %input {minimum_alignment = 64} : buffer
  %destination = buffer.assume.alignment %output {minimum_alignment = 64} : buffer
  %origin = index.constant 0 : offset
  %length = index.constant 129 : offset
  %order = buffer.compare %source[%origin], %destination[%origin], %length
  func.return %order : i32
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @aligned_compare() -> (reg<aie2p.er>) asm {
  %source = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %destination = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %81 = mov.short 0
  %83 = mov.short -1
  %84 = mov.short 1
  %85 = mov.short 128
  %86 = mov.short 4
  low.br ^_bb1(%81: reg<aie2p.er>, %81: reg<aie2p.er>, %81: reg<aie2p.er>)
^_bb1(%73: reg<aie2p.er>, %74: reg<aie2p.er>, %75: reg<aie2p.er>):
  %87 = ltu %73, %85
  %88 = eq %74, %75
  %89 = and %87, %88
  low.cond_br %89, ^_bb2, ^_bb3 : reg<aie2p.er>
^_bb2:
  %90 = mov.address-index %73
  %91 = lda.i32.index %source, %90
  %93 = lda.i32.index %destination, %90
  %94 = add.nc %73, %86
  low.br ^_bb1(%94: reg<aie2p.er>, %91: reg<aie2p.er>, %93: reg<aie2p.er>)
^_bb3:
  low.cond_br %88, ^_bb4, ^_bb5 : reg<aie2p.er>
^_bb4:
  %95 = mov.static-address-index 128
  %96 = lda.i8.index %source, %95
  %98 = lda.i8.index %destination, %95
  low.br ^_bb6(%96: reg<aie2p.er>, %98: reg<aie2p.er>)
^_bb5:
  low.br ^_bb6(%74: reg<aie2p.er>, %75: reg<aie2p.er>)
^_bb6(%76: reg<aie2p.er>, %77: reg<aie2p.er>):
  %99 = ne %76, %77
  low.cond_br %99, ^_bb7, ^_bb8 : reg<aie2p.er>
^_bb7:
  %100 = xor %76, %77
  %102 = xor %100, %83
  %103 = add.nc.immediate %100, -1
  %104 = and %102, %103
  %105 = popcount %104
  %106 = mov.short 32
  %107 = copy %100 : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %108 = sel.eqz %106, %105, %107
  %109 = mov.short -8
  %110 = and %108, %109
  %111 = mov.short 255
  %113 = sub %81, %110
  %114 = lshl %76, %113
  %115 = and %114, %111
  %117 = sub %81, %110
  %118 = lshl %77, %117
  %119 = and %118, %111
  %120 = ltu %115, %119
  %121 = copy %120 : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %122 = sel.nez %83, %84, %121
  low.br ^_bb9(%122: reg<aie2p.er>)
^_bb8:
  low.br ^_bb9(%81: reg<aie2p.er>)
^_bb9(%order: reg<aie2p.er>):
  return %order
}

// ====

func.def @dynamic_aligned_copy(%input: buffer, %output: buffer, %input_length: i32) {
  %source = buffer.assume.alignment %input {minimum_alignment = 64} : buffer
  %destination = buffer.assume.alignment %output {minimum_alignment = 64} : buffer
  %bounded = scalar.assume %input_length [range(%input_length, 0, 1024)] : i32
  %length = index.cast %bounded : i32 to offset
  %origin = index.constant 0 : offset
  buffer.copy %source[%origin], %destination[%origin], %length
  func.return
}

