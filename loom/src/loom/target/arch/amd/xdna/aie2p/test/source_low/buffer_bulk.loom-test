^_bb5:
  %102 = mov.short -16
  %103 = and %length, %102
  %104 = ltu %92, %103
  low.cond_br %104, ^_bb6, ^_bb7 : reg<aie2p.er>
^_bb6:
  %108 = mov.address-index %92
  %109 = vlda.128.i32x4.index %source, %108
  vst.128.i32x4.index %109, %destination, %108
