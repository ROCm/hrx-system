^_bb10:
  %121 = mov.short -2
  %122 = and %length, %121
  %123 = ltu %114, %122
  low.cond_br %123, ^_bb11, ^_bb12 : reg<aie2p.er>
^_bb11:
  %124 = mov.address-index %114
  %125 = lda.i16.index %source, %124
