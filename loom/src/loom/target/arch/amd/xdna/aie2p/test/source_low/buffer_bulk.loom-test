^_bb7:
  %113 = mov.short -4
  %114 = and %length, %113
  %115 = mov.short 4
  low.br ^_bb8(%103: reg<aie2p.er>)
^_bb8(%79: reg<aie2p.er>):
  %116 = ltu %79, %114
  low.cond_br %116, ^_bb9, ^_bb10 : reg<aie2p.er>
^_bb9:
