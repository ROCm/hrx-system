// RUN: with-checks emit aie2p-array-plan @copy_4_workers_1_records

// Four scatter/gather workers share no producer/consumer edge, so column
// adjacency buys them nothing. Placement spreads two per column to match
// one shim's two DMA channels per direction instead of packing a column
// past what its own shim can serve.

aie2p.target<array> @array_target

aie2p.target<core> @core_target

pipeline.def<kernel> public retain target(@array_target) @copy_4_workers_1_records() launch(%input: buffer, %output: buffer) {
  %lanes = index.constant 4 : index
  %input_base = index.constant 16 : offset
  %output_base = index.constant 32 : offset
  %workers = group.create %lanes : index -> group
  %input_view = buffer.view %input[%input_base] : buffer -> view<4x1x4xi32, #encoding.layout.strided<strides=[12, 8, 1]>>
  %output_view = buffer.view %output[%output_base] : buffer -> view<4x1x4xi32, #encoding.layout.strided<strides=[16, 12, 1]>>
  %input_flow = pipeline.scatter %input_view across %workers : view<4x1x4xi32, #encoding.layout.strided<strides=[12, 8, 1]>>, group -> pipeline.flow<tile<4xi32>>
  %output_flow = pipeline.stage @copy on %workers(%input_flow) : (group, pipeline.flow<tile<4xi32>>) -> (pipeline.flow<tile<4xi32>>)
  pipeline.write %output_flow to %output_view : pipeline.flow<tile<4xi32>>, view<4x1x4xi32, #encoding.layout.strided<strides=[16, 12, 1]>>
  pipeline.return
}

func.def target(@core_target) @copy(%input: buffer, %output: buffer) {
  %input_aligned, %output_aligned = buffer.assume.alignment %input, %output {minimum_alignment = 4} : buffer, buffer
  %base = index.constant 0 : offset
  %input_view = buffer.view %input_aligned[%base] : buffer -> view<4xi32>
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<4xi32>
  %word0 = view.load %input_view[0] : view<4xi32> -> i32
  view.store %word0, %output_view[0] : i32, view<4xi32>
  %word1 = view.load %input_view[1] : view<4xi32> -> i32
  view.store %word1, %output_view[1] : i32, view<4xi32>
  %word2 = view.load %input_view[2] : view<4xi32> -> i32
  view.store %word2, %output_view[2] : i32, view<4xi32>
  %word3 = view.load %input_view[3] : view<4xi32> -> i32
  view.store %word3, %output_view[3] : i32, view<4xi32>
  func.return
}

// ----
CHECK: array @copy_4_workers_1_records * workers=4 *
CHECK: worker index=0 group=0 lane=0 entry=@copy tile=(0,2) *
CHECK: worker index=1 group=0 lane=1 entry=@copy tile=(0,3) *
CHECK: worker index=2 group=0 lane=2 entry=@copy tile=(1,2) *
CHECK: worker index=3 group=0 lane=3 entry=@copy tile=(1,3) *
