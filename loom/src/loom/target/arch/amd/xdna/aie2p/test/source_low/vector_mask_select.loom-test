  %condition = scalar.cmpi slt, %lhs, %rhs : i32
  %mask = vector.splat %condition : vector<16xi1>
  %selected = vector.select %mask, %true_value, %false_value : vector<16xbf16>
  func.return %selected : vector<16xbf16>
}

