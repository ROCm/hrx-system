  %58 = xor %lhs, %45
  %59 = xor %lhs, %44
  %60 = copy %57 : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %61 = sel.nez %58, %59, %60
  %62 = and %rhs, %44
  %63 = xor %rhs, %45
  %64 = xor %rhs, %44
  %65 = copy %62 : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %66 = sel.nez %63, %64, %65
  %67 = xor %23, %15
  %70 = ltu %66, %61
  %71 = and %70, %67
  %greater = and %71, %41
  %equal_masked = and %equal, %tie_mask
  %selected = or %greater, %equal_masked
  return %selected
}
