  %44 = xor %rhs, %35
  %45 = copy %42 : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %46 = sel.nez %43, %44, %45
  %47 = ltu %46, %41
  %49 = xor %20, %23
  %50 = and %47, %49
  %greater = and %50, %24
  %equal_masked = and %equal, %tie_mask
  %selected = or %greater, %equal_masked
  return %selected
