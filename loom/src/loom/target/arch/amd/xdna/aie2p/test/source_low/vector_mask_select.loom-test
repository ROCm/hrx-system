func.def @f32_compare_masks(%lhs: f32, %rhs: f32, %tie_mask: i1) -> (i1) {
  %equal = scalar.cmpf oeq, %lhs, %rhs : f32
  %greater = scalar.cmpf ogt, %lhs, %rhs : f32
  %equal_masked = scalar.andi %equal, %tie_mask : i1
  %selected = scalar.ori %greater, %equal_masked : i1
  func.return %selected : i1
}

