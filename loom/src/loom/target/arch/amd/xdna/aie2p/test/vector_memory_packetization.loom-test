func.def @store_i32x17_aligned64(%value: vector<17xi32>, %output: buffer) {
  %aligned = buffer.assume.alignment %output {minimum_alignment = 64} : buffer
  %origin = index.constant 0 : offset
  %output_view = buffer.view %aligned[%origin] : buffer -> view<17xi32>
  %5 = vector.slice %value[0] : vector<17xi32> -> vector<16xi32>
