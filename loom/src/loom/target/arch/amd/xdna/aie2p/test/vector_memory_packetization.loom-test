// ----
func.def @store_i32x17_aligned32(%value: vector<17xi32>, %output: buffer) {
  %aligned = buffer.assume.alignment %output {minimum_alignment = 32} : buffer
  %origin = index.constant 0 : offset
  %output_view = buffer.view %aligned[%origin] : buffer -> view<17xi32>
  %5 = vector.slice %value[0] : vector<17xi32> -> vector<8xi32>
  vector.store %5, %output_view[0] : vector<8xi32>, view<17xi32>
  %6 = vector.slice %value[8] : vector<17xi32> -> vector<8xi32>
  vector.store %6, %output_view[8] : vector<8xi32>, view<17xi32>
  %9 = vector.extract %value[16] : vector<17xi32> -> i32
  view.store %9, %output_view[16] : i32, view<17xi32>
  func.return
}

