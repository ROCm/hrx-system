// ====

// RUN: pass target=amd.xdna.aie2p:core target-legalize{mode=final},canonicalize

// A producer load constrains the common packet shape to the widest width
// admitted by its own alignment, even when the destination admits wider stores.
func.def @copy_i32x17_source_aligned16(%input: buffer, %output: buffer) {
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 16} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 64} : buffer
  %origin = index.constant 0 : offset
  %input_view = buffer.view %input_aligned[%origin] : buffer -> view<17xi32>
  %output_view = buffer.view %output_aligned[%origin] : buffer -> view<17xi32>
  %value = vector.load %input_view[0] : view<17xi32> -> vector<17xi32>
  vector.store %value, %output_view[0] : vector<17xi32>, view<17xi32>
  func.return
}

// ----
func.def @copy_i32x17_source_aligned16(%input: buffer, %output: buffer) {
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 16} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 64} : buffer
  %origin = index.constant 0 : offset
  %input_view = buffer.view %input_aligned[%origin] : buffer -> view<17xi32>
  %output_view = buffer.view %output_aligned[%origin] : buffer -> view<17xi32>
  %8 = vector.load %input_view[0] : view<17xi32> -> vector<8xi32>
  %9 = vector.load %input_view[8] : view<17xi32> -> vector<8xi32>
  %10 = view.load %input_view[16] : view<17xi32> -> i32
  vector.store %8, %output_view[0] : vector<8xi32>, view<17xi32>
  vector.store %9, %output_view[8] : vector<8xi32>, view<17xi32>
  view.store %10, %output_view[16] : i32, view<17xi32>
  func.return
}

// ====

// RUN: pass target=amd.xdna.aie2p:core target-legalize{mode=final},canonicalize

// Generated packet loops retain the induction facts needed to prove native
// stores through dynamic outer coordinates. The cases span every physical
// element width and all native packet carrier widths.
func.def @generated_constant_store_packets(%i8_output: buffer, %bf16_output: buffer, %i32_output: buffer, %i64_output: buffer, %row: index, %column: index) {
  %i8_aligned = buffer.assume.alignment %i8_output {minimum_alignment = 16} : buffer
  %bf16_aligned = buffer.assume.alignment %bf16_output {minimum_alignment = 32} : buffer
  %i32_aligned = buffer.assume.alignment %i32_output {minimum_alignment = 64} : buffer
  %i64_aligned = buffer.assume.alignment %i64_output {minimum_alignment = 64} : buffer
  %origin = index.constant 0 : offset
  %i8_view = buffer.view %i8_aligned[%origin] : buffer -> view<3x2x128xi8>
  %bf16_view = buffer.view %bf16_aligned[%origin] : buffer -> view<3x2x64xbf16>
  %i32_view = buffer.view %i32_aligned[%origin] : buffer -> view<3x2x32xi32>
  %i64_view = buffer.view %i64_aligned[%origin] : buffer -> view<3x2x16xi64>
  %i8_value = vector.splati 0 : vector<128xi8>
  %bf16_value = vector.splatf 0.0 : vector<64xbf16>
  %i32_value = vector.splati 0 : vector<32xi32>
  %i64_value = vector.splati 0 : vector<16xi64>
  vector.store %i8_value, %i8_view[%row, %column, 0] : vector<128xi8>, view<3x2x128xi8>
  vector.store %bf16_value, %bf16_view[%row, %column, 0] : vector<64xbf16>, view<3x2x64xbf16>
  vector.store %i32_value, %i32_view[%row, %column, 0] : vector<32xi32>, view<3x2x32xi32>
  vector.store %i64_value, %i64_view[%row, %column, 0] : vector<16xi64>, view<3x2x16xi64>
  func.return
}

// ----
func.def @generated_constant_store_packets(%i8_output: buffer, %bf16_output: buffer, %i32_output: buffer, %i64_output: buffer, %row: index, %column: index) {
  %i8_aligned = buffer.assume.alignment %i8_output {minimum_alignment = 16} : buffer
  %bf16_aligned = buffer.assume.alignment %bf16_output {minimum_alignment = 32} : buffer
  %i32_aligned = buffer.assume.alignment %i32_output {minimum_alignment = 64} : buffer
  %i64_aligned = buffer.assume.alignment %i64_output {minimum_alignment = 64} : buffer
  %origin = index.constant 0 : offset
  %i8_view = buffer.view %i8_aligned[%origin] : buffer -> view<3x2x128xi8>
  %bf16_view = buffer.view %bf16_aligned[%origin] : buffer -> view<3x2x64xbf16>
  %i32_view = buffer.view %i32_aligned[%origin] : buffer -> view<3x2x32xi32>
  %i64_view = buffer.view %i64_aligned[%origin] : buffer -> view<3x2x16xi64>
  %34 = index.constant 0 : index
  %35 = index.constant 128 : index
  %36 = index.constant 16 : index
  scf.for %37 = [%34 to %35 step %36] {
    %38 = vector.splati 0 : vector<16xi8>
    vector.store %38, %i8_view[%row, %column, %37] : vector<16xi8>, view<3x2x128xi8>
  }
  %29 = index.constant 0 : index
  %30 = index.constant 64 : index
  %31 = index.constant 16 : index
  scf.for %32 = [%29 to %30 step %31] {
    %33 = vector.splatf 0.0 : vector<16xbf16>
    vector.store %33, %bf16_view[%row, %column, %32] : vector<16xbf16>, view<3x2x64xbf16>
  }
  %24 = index.constant 0 : index
  %25 = index.constant 32 : index
  %26 = index.constant 16 : index
  scf.for %27 = [%24 to %25 step %26] {
    %28 = vector.splati 0 : vector<16xi32>
    vector.store %28, %i32_view[%row, %column, %27] : vector<16xi32>, view<3x2x32xi32>
  }
  %19 = index.constant 0 : index
  %20 = index.constant 16 : index
  %21 = index.constant 8 : index
  scf.for %22 = [%19 to %20 step %21] {
    %23 = vector.splati 0 : vector<8xi64>
    vector.store %23, %i64_view[%row, %column, %22] : vector<8xi64>, view<3x2x16xi64>
  }
  func.return
}
