// ====

// RUN: pass target=amd.xdna.aie2p:core target-legalize{mode=final},canonicalize

// A producer load constrains the common packet shape to the widest width
// admitted by its own alignment, even when the destination admits wider stores.
func.def @copy_i32x17_source_aligned16(%input: buffer, %output: buffer) {
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 16} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 64} : buffer
  %origin = index.constant 0 : offset
  %input_view = buffer.view %input_aligned[%origin] : buffer -> view<17xi32>
  %output_view = buffer.view %output_aligned[%origin] : buffer -> view<17xi32>
  %value = vector.load %input_view[0] : view<17xi32> -> vector<17xi32>
  vector.store %value, %output_view[0] : vector<17xi32>, view<17xi32>
  func.return
}

// ----
func.def @copy_i32x17_source_aligned16(%input: buffer, %output: buffer) {
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 16} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 64} : buffer
  %origin = index.constant 0 : offset
  %input_view = buffer.view %input_aligned[%origin] : buffer -> view<17xi32>
  %output_view = buffer.view %output_aligned[%origin] : buffer -> view<17xi32>
  %8 = vector.load %input_view[0] : view<17xi32> -> vector<8xi32>
  %9 = vector.load %input_view[8] : view<17xi32> -> vector<8xi32>
  %12 = view.load %input_view[16] : view<17xi32> -> i32
  vector.store %8, %output_view[0] : vector<8xi32>, view<17xi32>
  vector.store %9, %output_view[8] : vector<8xi32>, view<17xi32>
  view.store %12, %output_view[16] : i32, view<17xi32>
  func.return
}
