// RUN: emit source-low output=low

// A source-typed Low call can supply the local storage for ordinary memory ops.
aie2p.target<core> @target

low.func.def target<amd.xdna.aie2p.core>(@target) @input_storage() -> (reg<aie2p.ep>) asm {
  %address = mov.local-address 458752
  return %address
}

low.func.def target<amd.xdna.aie2p.core>(@target) @output_storage() -> (reg<aie2p.ep>) asm {
  %address = mov.local-address 516096
  return %address
}

func.def target(@target) @copy_packet() -> (i32) {
  %input = low.invoke @input_storage() : () -> (buffer)
  %output = low.invoke @output_storage() : () -> (buffer)
  %aligned_input = buffer.assume.alignment %input {minimum_alignment = 64} : buffer
  %aligned_output = buffer.assume.alignment %output {minimum_alignment = 64} : buffer
  %begin = index.constant 0 : offset
  %source = buffer.view %aligned_input[%begin] : buffer -> view<16xi32>
  %destination = buffer.view %aligned_output[%begin] : buffer -> view<16xi32>
  %header = view.load<volatile> %source[0] : view<16xi32> -> i32
  %payload = vector.load %source[0] : view<16xi32> -> vector<16xi32>
  vector.store %payload, %destination[0] : vector<16xi32>, view<16xi32>
  func.return %header : i32
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @copy_packet() -> (reg<aie2p.er>) asm {
  %address$1 = mov.local-address 458752
  %address$3 = mov.local-address 516096
  %header = lda.volatile<volatile> %address$1, 0
  %payload = vlda.512.i32x16 %address$1, 0
  vst.512.i32x16 %payload, %address$3, 0
  return %header
}

// ====

// Loop-carried pointer state stays in address registers while the scalar
// iteration number indexes the destination view.
aie2p.target<core> @target

low.func.def target<amd.xdna.aie2p.core>(@target) @ring_storage() -> (reg<aie2p.ep>) asm {
  %address = mov.local-address 458752
  return %address
}

low.func.def target<amd.xdna.aie2p.core>(@target) @rotate(%current: reg<aie2p.ep>) -> (reg<aie2p.ep>) asm {
  %bits = mov.address-to-scalar %current
  %stride = mov.i32 28672
  %next_bits = xor %bits, %stride
  %next = mov.scalar-to-address %next_bits
  return %next
}

func.def target(@target) @consume_ring(%output: buffer) {
  %initial = low.invoke @ring_storage() : () -> (buffer)
  %begin = index.constant 0 : index
  %base = index.constant 0 : offset
  %count = index.constant 4 : index
  %step = index.constant 1 : index
  %aligned_output = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %result = buffer.view %aligned_output[%base] : buffer -> view<4xi32>
  %last = scf.for %record = [%begin to %count step %step](%cursor = %initial : buffer) -> (buffer) {
    %aligned = buffer.assume.alignment %cursor {minimum_alignment = 4} : buffer
    %source = buffer.view %aligned[%base] : buffer -> view<1xi32>
    %value = view.load %source[0] : view<1xi32> -> i32
    view.store %value, %result[%record] : i32, view<4xi32>
    %next = low.invoke @rotate(%cursor) : (buffer) -> (buffer)
    scf.yield %next : buffer
  }
  func.return
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @consume_ring() asm {
  %aligned_output = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %address = mov.local-address 458752
  %begin = mov.short 0
  %count = mov.short 4
  %step = mov.short 1
  low.br ^_bb1(%begin: reg<aie2p.er>, %address: reg<aie2p.ep>)
^_bb1(%record: reg<aie2p.er>, %aligned: reg<aie2p.ep>):
  %36 = lt %record, %count
  low.cond_br %36, ^_bb2, ^_bb3 : reg<aie2p.er>
^_bb2:
  %value = lda %aligned, 0
  %38 = mov.i32 2
  %39 = lshl %record, %38
  %40 = mov.address-index %39
  st.i32.index %value, %aligned_output, %40
  %bits = mov.address-to-scalar %aligned
  %stride = mov.i32 28672
  %next_bits = xor %bits, %stride
  %next = mov.scalar-to-address %next_bits
  %42 = add.nc %record, %step
  low.br ^_bb1(%42: reg<aie2p.er>, %next: reg<aie2p.ep>)
^_bb3:
  return
}

// ====

// A callable result does not make global memory addressable by core loads.
aie2p.target<core> @target

low.func.def target<amd.xdna.aie2p.core>(@target) @storage() -> (reg<aie2p.ep>) asm {
  %address = mov.local-address 458752
  return %address
}

func.def target(@target) @reject_global_memory() -> (i32) {
  %input = low.invoke @storage() : () -> (buffer)
  %global = buffer.assume.memory_space<global> %input : buffer
  %aligned = buffer.assume.alignment %global {minimum_alignment = 4} : buffer
  %begin = index.constant 0 : offset
  %source = buffer.view %aligned[%begin] : buffer -> view<1xi32>
  // ERROR@+1: TARGET/003 {constraint_key="source_memory.memory_space"}
  %value = view.load %source[0] : view<1xi32> -> i32
  func.return %value : i32
}

// ====
// RUN: emit source-low output=low

// Borrowed source views preserve their origin through ordinary helper calls.
// The Low storage helper supplies only the root; the source memory plan carries
// the record's nonzero byte offset through inlining and instruction selection.
aie2p.target<core> @target

low.func.def target<amd.xdna.aie2p.core>(@target) @storage() -> (reg<aie2p.ep>) asm {
  %base = mov.local-address 458752
  return %base
}

func.def inline @read_record(%record: view<16xi32>) -> (i32) {
  %value = view.load %record[0] : view<16xi32> -> i32
  func.return %value : i32
}

func.def public target(@target) @read_projected_record() -> (i32) {
  %storage = low.invoke @storage() : () -> (buffer)
  %aligned = buffer.assume.alignment %storage {minimum_alignment = 64} : buffer
  %origin = index.constant 64 : offset
  %record = buffer.view %aligned[%origin] : buffer -> view<16xi32>
  %value = func.call @read_record(%record) : (view<16xi32>) -> (i32)
  func.return %value : i32
}

// ----
low.func.def public target<amd.xdna.aie2p.core>(@target) abi(object_function) @read_projected_record() -> (reg<aie2p.er>) asm {
  %base = mov.local-address 458752
  %13 = mov.static-address-index 64
  %value = lda.i32.index %base, %13
  return %value
}

// ====
// RUN: emit source-low output=low

// Updating a helper's pointer leaves the caller's buffer value available for
// another invocation and for the caller's own returned observation.
aie2p.target<core> @target

low.func.def inline target<amd.xdna.aie2p.core>(@target) @advance(%base: reg<aie2p.ep>, %offset: reg<aie2p.er>) -> (reg<aie2p.ep>) asm {
  %modifier = mov.modifier %offset
  %next = padda.modifier %base, %modifier
  return %next
}

func.def target(@target) @independent_offsets(%base: buffer, %first_offset: offset, %second_offset: offset) -> (buffer, buffer, buffer) {
  %first = low.invoke @advance(%base, %first_offset) : (buffer, offset) -> (buffer)
  %second = low.invoke @advance(%base, %second_offset) : (buffer, offset) -> (buffer)
  func.return %first, %second, %base : buffer, buffer, buffer
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @independent_offsets(%first_offset: reg<aie2p.er>, %second_offset: reg<aie2p.er>) -> (reg<aie2p.ep>, reg<aie2p.ep>, reg<aie2p.ep>) asm {
  %base = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %21 = copy %base : reg<aie2p.ep> -> reg<aie2p.ep>
  %modifier$23 = mov.modifier %first_offset
  %next$24 = padda.modifier %21, %modifier$23
  %22 = copy %base : reg<aie2p.ep> -> reg<aie2p.ep>
  %modifier$3 = mov.modifier %second_offset
  %next$4 = padda.modifier %22, %modifier$3
  return %next$24, %next$4, %base
}

// ====
// RUN: with-low-asm pass inline-callables

// An identity helper still returns an independent captured value when its
// caller consumes that result. Both cloned and moved bodies preserve the base.
aie2p.target<core> @target

low.func.def inline target<amd.xdna.aie2p.core>(@target) @identity_pointer(%base: reg<aie2p.ep>) -> (reg<aie2p.ep>) asm {
  return %base
}

low.func.def public target<amd.xdna.aie2p.core>(@target) @offset_identity(%base: reg<aie2p.ep>) -> (reg<aie2p.ep>, reg<aie2p.ep>, reg<aie2p.ep>) asm {
  %first = low.func.call @identity_pointer(%base) : (reg<aie2p.ep>) -> (reg<aie2p.ep>)
  %first_offset = padda %first, 64
  %second = low.func.call @identity_pointer(%base) : (reg<aie2p.ep>) -> (reg<aie2p.ep>)
  %second_offset = paddb %second, -64
  return %first_offset, %second_offset, %base
}

// ----
aie2p.target<core> @target

low.func.def public target<amd.xdna.aie2p.core>(@target) @offset_identity(%base: reg<aie2p.ep>) -> (reg<aie2p.ep>, reg<aie2p.ep>, reg<aie2p.ep>) asm {
  %10 = copy %base : reg<aie2p.ep> -> reg<aie2p.ep>
  %first_offset = padda %10, 64
  %11 = copy %base : reg<aie2p.ep> -> reg<aie2p.ep>
  %second_offset = paddb %11, -64
  return %first_offset, %second_offset, %base
}

// ====
// RUN: with-low-asm pass inline-callables

// Independent CFG clones and the final consuming splice capture their own
// pointer contents before the callee's entry block updates them.
aie2p.target<core> @target

low.func.def inline target<amd.xdna.aie2p.core>(@target) @cfg_advance(%base: reg<aie2p.ep>) -> (reg<aie2p.ep>) asm {
  %next = padds %base, 64
  low.br ^finish(%next: reg<aie2p.ep>)
^finish(%result: reg<aie2p.ep>):
  return %result
}

low.func.def public target<amd.xdna.aie2p.core>(@target) @independent_cfg_offsets(%base: reg<aie2p.ep>) -> (reg<aie2p.ep>, reg<aie2p.ep>, reg<aie2p.ep>, reg<aie2p.ep>) asm {
  %first = low.func.call @cfg_advance(%base) : (reg<aie2p.ep>) -> (reg<aie2p.ep>)
  %second = low.func.call @cfg_advance(%base) : (reg<aie2p.ep>) -> (reg<aie2p.ep>)
  %third = low.func.call @cfg_advance(%base) : (reg<aie2p.ep>) -> (reg<aie2p.ep>)
  return %first, %second, %third, %base
}

// ----
aie2p.target<core> @target

low.func.def public target<amd.xdna.aie2p.core>(@target) @independent_cfg_offsets(%base: reg<aie2p.ep>) -> (reg<aie2p.ep>, reg<aie2p.ep>, reg<aie2p.ep>, reg<aie2p.ep>) asm {
  %12 = copy %base : reg<aie2p.ep> -> reg<aie2p.ep>
  low.br ^_bb1
^_bb1:
  %next$20 = padds %12, 64
  low.br ^_bb2(%next$20: reg<aie2p.ep>)
^_bb2(%result$21: reg<aie2p.ep>):
  low.br ^_bb3(%result$21: reg<aie2p.ep>)
^_bb3(%first: reg<aie2p.ep>):
  %13 = copy %base : reg<aie2p.ep> -> reg<aie2p.ep>
  low.br ^_bb4
^_bb4:
  %next$16 = padds %13, 64
  low.br ^_bb5(%next$16: reg<aie2p.ep>)
^_bb5(%result$17: reg<aie2p.ep>):
  low.br ^_bb6(%result$17: reg<aie2p.ep>)
^_bb6(%second: reg<aie2p.ep>):
  %14 = copy %base : reg<aie2p.ep> -> reg<aie2p.ep>
  low.br ^_bb7
^_bb7:
  %next$2 = padds %14, 64
  low.br ^_bb8(%next$2: reg<aie2p.ep>)
^_bb8(%result$3: reg<aie2p.ep>):
  low.br ^_bb9(%result$3: reg<aie2p.ep>)
^_bb9(%third: reg<aie2p.ep>):
  return %first, %second, %third, %base
}
