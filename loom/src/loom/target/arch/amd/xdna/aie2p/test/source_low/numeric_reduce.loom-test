low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i32_reduce_add(%loaded: reg<aie2p.vec256 x2>) -> (reg<aie2p.er>) asm {
  %6 = mova.i32 7
  %7 = vshuffle %loaded, %loaded, %6
  %8 = vadd.32 %loaded, %7
  %9 = mova.i32 5
  %10 = vshuffle %8, %8, %9
  %11 = vadd.32 %8, %10
  %sum = vextract.32.imm %11, 0
  return %sum
}

