func.def @i32_reduce_minui_select_sentinel(%values: vector<4xi32>) -> (i32) {
  %empty_value = scalar.constant 0 : i32
  %zeros = vector.splat %empty_value : vector<4xi32>
  %is_zero = vector.cmpi eq, %values, %zeros : vector<4xi32> -> vector<4xi1>
  %start = scalar.constant 0 : i32
  %step = scalar.constant 1 : i32
  %indices = vector.iota %start step %step : vector<4xi32>
  %sentinel = scalar.constant 2147483647 : i32
  %sentinels = vector.splat %sentinel : vector<4xi32>
  %selected = vector.select %is_zero, %indices, %sentinels : vector<4xi32>
  %result = vector.reduce<minui> %selected, %sentinel : vector<4xi32>, i32
  func.return %result : i32
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i32_reduce_minui_select_sentinel(%values: reg<aie2p.vec256 x2>) -> (reg<aie2p.er>) asm {
  %26 = mov.short 0
  %zeros = vbcst.32 %26
  %28 = vsub.32 %values, %zeros
  %29 = veqz.32.el.low32 %28
  %is_zero = predicate.complete.zero.high32 %29, 0
  %31 = mov.short 1
  %32 = mov.short 2
  %33 = mov.short 3
  %35 = copy %31 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %36 = vinsert.32.reg %zeros, %35, %31
  %38 = copy %32 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %39 = vinsert.32.reg %36, %38, %32
  %41 = copy %33 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %indices = vinsert.32.reg %39, %41, %33
  %sentinel = mov.i32 2147483647
  %sentinels = vbcst.32 %sentinel
  %selected = vsel.32.mask64 %sentinels, %indices, %is_zero
  %48 = min.u32x16 %selected, %sentinels
  %49 = mova.i32 8
  %50 = vshift %48, %48, %49
  %51 = min.u32x16 %48, %50
  %52 = mova.i32 4
  %53 = vshift %51, %51, %52
  %54 = min.u32x16 %51, %53
  %result = vextract.32.imm %54, 0
  return %result
}

