low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i32x2x3_reduce_columns(%values: reg<aie2p.vec256 x2>, %init: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %12 = mova.i32 12
  %13 = vshift %values, %values, %12
  %14 = vadd.32 %values, %13
  %result = vadd.32 %init, %14
  return %result
}
