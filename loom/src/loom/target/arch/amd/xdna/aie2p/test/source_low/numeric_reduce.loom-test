  %signed_minimum = vector.reduce<minsi> %values, %init : vector<3xi32>, i32
  %signed_maximum = vector.reduce<maxsi> %values, %init : vector<3xi32>, i32
  %unsigned_minimum = vector.reduce<minui> %values, %init : vector<3xi32>, i32
  %unsigned_maximum = vector.reduce<maxui> %values, %init : vector<3xi32>, i32
  %bitwise_and = vector.reduce<andi> %values, %init : vector<3xi32>, i32
  %bitwise_or = vector.reduce<ori> %values, %init : vector<3xi32>, i32
  %bitwise_xor = vector.reduce<xori> %values, %init : vector<3xi32>, i32
  func.return %product, %signed_minimum, %signed_maximum, %unsigned_minimum, %unsigned_maximum, %bitwise_and, %bitwise_or, %bitwise_xor : i32, i32, i32, i32, i32, i32, i32, i32
}

