  %signed_maximum = vextract.32.imm %78, 0
  %81 = predicate.constant.low32 7
  %82 = predicate.complete.zero.high32 %81, 0
  %83 = vsel.32.mask64 %58, %values, %82
  %85 = vshift %83, %83, %62
  %86 = min.u32x16 %83, %85
  %88 = vshift %86, %86, %65
  %89 = min.u32x16 %86, %88
  %unsigned_minimum = vextract.32.imm %89, 0
  %92 = predicate.constant.low32 7
  %93 = predicate.complete.zero.high32 %92, 0
  %94 = vsel.32.mask64 %58, %values, %93
  %96 = vshift %94, %94, %62
  %97 = max.u32x16 %94, %96
  %99 = vshift %97, %97, %65
  %100 = max.u32x16 %97, %99
  %unsigned_maximum = vextract.32.imm %100, 0
