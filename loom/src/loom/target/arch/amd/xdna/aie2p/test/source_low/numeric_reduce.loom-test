  %31 = vinsert.32.reg %28, %30, %23
  %32 = mov.short 3
  %33 = copy %32 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %loaded = vinsert.32.reg %31, %33, %24
  %35 = mova.i32 7
  %36 = vshuffle %loaded, %loaded, %35
  %37 = vadd.32 %loaded, %36
  %38 = mova.i32 5
  %39 = vshuffle %37, %37, %38
  %40 = vadd.32 %37, %39
  %sum = vextract.32.imm %40, 0
  return %sum
}

