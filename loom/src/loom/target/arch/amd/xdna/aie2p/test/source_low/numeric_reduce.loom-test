config.def @runtime.vector_width = 4 : index

func.def @i32_configured_width_sum(%input: buffer) -> (i32) {
  %buffer_base = index.constant 0 : offset
  %vector_width = config.get @runtime.vector_width : index
  %vector_width_bounded = index.assume %vector_width [range(%vector_width, 2, 4)] : index
  %input_view = buffer.view %input[%buffer_base] : buffer -> view<4xi32>
  %loaded = vector.load %input_view[0] : view<4xi32> -> vector<[%vector_width_bounded]xi32>
  %initial_sum = scalar.constant 0 : i32
  %sum = vector.reduce<addi> %loaded, %initial_sum : vector<[%vector_width_bounded]xi32>, i32
  func.return %sum : i32
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @i32_configured_width_sum() -> (reg<aie2p.er>) asm {
  %input_view = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %21 = lda %input_view, 0
  %22 = lda %input_view, 4
  %23 = lda %input_view, 8
  %24 = lda %input_view, 12
  %25 = vbcst.32 %21
  %26 = mov.short 1
  %27 = copy %26 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %28 = vinsert.32.reg %25, %27, %22
  %29 = mov.short 2
  %30 = copy %29 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %31 = vinsert.32.reg %28, %30, %23
  %32 = mov.short 3
  %33 = copy %32 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %loaded = vinsert.32.reg %31, %33, %24
  %35 = mova.i32 7
  %36 = vshuffle %loaded, %loaded, %35
  %37 = vadd.32 %loaded, %36
  %38 = mova.i32 5
  %39 = vshuffle %37, %37, %38
  %40 = vadd.32 %37, %39
  %sum = vextract.32.imm %40, 0
  return %sum
}

