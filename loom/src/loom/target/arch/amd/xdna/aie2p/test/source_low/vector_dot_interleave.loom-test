// RUN: emit source-low output=low

aie2p.target<core> @target

func.def target(@target) @dot_interleaved_source(%lhs: vector<32xbf16>, %even: vector<16xbf16>, %odd: vector<16xbf16>, %initial: vector<16xf32>) -> (vector<16xf32>) {
  %rhs = vector.interleave<0> %even, %odd : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %result = vector.dot2f %lhs, %rhs, %initial : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  func.return %result : vector<16xf32>
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @dot_interleaved_source(%lhs: reg<aie2p.vec256 x2>, %even: reg<aie2p.vec256 x2>, %odd: reg<aie2p.vec256 x2>, %initial: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %12 = mova.i32 2
  %13 = vshuffle %lhs, %lhs, %12
  %14 = mova.i32 3
  %15 = vshuffle %lhs, %lhs, %14
  %16 = vmov.vector512.to.accumulator512.low %initial
  %17 = mova.i32 60
  %18 = vmac.bf16x16 %16, %13, %even, %17
  %19 = vmac.bf16x32 %18, %15, %odd, %17
  %20 = slice %19[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %result = vmov.accumulator512.to.vector512 %20
  return %result
}

// ====

aie2p.target<core> @target

func.def target(@target) @dot_interleaved_zero(%lhs: vector<32xbf16>, %even: vector<16xbf16>, %odd: vector<16xbf16>) -> (vector<16xf32>) {
  %initial = vector.constant 0.0 : vector<16xf32>
  %rhs = vector.interleave<0> %even, %odd : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %result = vector.dot2f %lhs, %rhs, %initial : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  func.return %result : vector<16xf32>
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @dot_interleaved_zero(%lhs: reg<aie2p.vec256 x2>, %even: reg<aie2p.vec256 x2>, %odd: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %11 = mova.i32 2
  %12 = vshuffle %lhs, %lhs, %11
  %13 = mova.i32 3
  %14 = vshuffle %lhs, %lhs, %13
  %15 = acc.clear.f32x64
  %16 = mova.i32 60
  %17 = vmac.bf16x32 %15, %12, %even, %16
  %18 = vmac.bf16x32 %17, %14, %odd, %16
  %19 = slice %18[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %result = vmov.accumulator512.to.vector512 %19
  return %result
}

// ====

aie2p.target<core> @target

func.def target(@target) @dot_interleaved_shared(%lhs: vector<32xbf16>, %even: vector<16xbf16>, %odd: vector<16xbf16>, %initial: vector<16xf32>) -> (vector<16xf32>, vector<32xbf16>) {
  %rhs = vector.interleave<0> %even, %odd : vector<16xbf16>, vector<16xbf16> -> vector<32xbf16>
  %result = vector.dot2f %lhs, %rhs, %initial : vector<32xbf16>, vector<32xbf16>, vector<16xf32>
  func.return %result, %rhs : vector<16xf32>, vector<32xbf16>
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @dot_interleaved_shared(%lhs: reg<aie2p.vec256 x2>, %even: reg<aie2p.vec256 x2>, %odd: reg<aie2p.vec256 x2>, %initial: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) asm {
  %14 = mova.i32 18
  %rhs = vshuffle %even, %odd, %14
  %16 = mova.i32 2
  %17 = vshuffle %lhs, %lhs, %16
  %18 = vshuffle %rhs, %rhs, %16
  %19 = mova.i32 3
  %20 = vshuffle %lhs, %lhs, %19
  %21 = vshuffle %rhs, %rhs, %19
  %22 = vmov.vector512.to.accumulator512.low %initial
  %23 = mova.i32 60
  %24 = vmac.bf16x16 %22, %17, %18, %23
  %25 = vmac.bf16x32 %24, %20, %21, %23
  %26 = slice %25[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %result = vmov.accumulator512.to.vector512 %26
  return %result, %rhs
}

// ====

// Partial packets retain only their observed lanes, including factored shapes.
aie2p.target<core> @target

func.def target(@target) @dot_partial_rank_two(%lhs: vector<1x6xbf16>, %rhs: vector<1x6xbf16>, %initial: vector<1x3xf32>) -> (vector<1x3xf32>) {
  %result = vector.dot2f %lhs, %rhs, %initial : vector<1x6xbf16>, vector<1x6xbf16>, vector<1x3xf32>
  func.return %result : vector<1x3xf32>
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @dot_partial_rank_two(%lhs: reg<aie2p.vec256 x2>, %rhs: reg<aie2p.vec256 x2>, %initial: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>) asm {
  %9 = mova.i32 2
  %10 = vshuffle %lhs, %lhs, %9
  %11 = vshuffle %rhs, %rhs, %9
  %12 = mova.i32 3
  %13 = vshuffle %lhs, %lhs, %12
  %14 = vshuffle %rhs, %rhs, %12
  %15 = vmov.vector512.to.accumulator512.low %initial
  %16 = mova.i32 60
  %17 = vmac.bf16x16 %15, %10, %11, %16
  %18 = vmac.bf16x32 %17, %13, %14, %16
  %19 = slice %18[0] : reg<aie2p.mbms x4> -> reg<aie2p.mbms>
  %result = vmov.accumulator512.to.vector512 %19
  return %result
}
