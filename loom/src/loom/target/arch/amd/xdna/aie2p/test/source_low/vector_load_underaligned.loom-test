// RUN: emit source-low output=low

aie2p.target<core> @target

func.def target(@target) @load_i8x32_dynamic(%source: buffer, %element0: index) -> (vector<32xi8>) {
  %source_generic = buffer.assume.memory_space<generic> %source : buffer
  %source_aligned = buffer.assume.alignment %source_generic {minimum_alignment = 2} : buffer
  %element = index.assume %element0 [range(%element0, 0, 32)] : index
  %base = index.constant 0 : offset
  %source_view = buffer.view %source_aligned[%base] : buffer -> view<64xi8>
  %value = vector.load %source_view[%element] : view<64xi8> -> vector<32xi8>
  func.return %value : vector<32xi8>
}

