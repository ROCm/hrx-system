low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @load_i32x17_workgroup() -> (reg<aie2p.vec256 x4>) asm {
  %source_aligned = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %9 = mov.static-byte-offset 4
  %10 = mov.modifier %9
  %11 = copy %source_aligned : reg<aie2p.ep> -> reg<aie2p.ep>
  %12 = padda.modifier %11, %10
  %13, %14 = lda.i32.post %12, 4
  %15 = vbcst.32 %13
  %16, %17 = lda.i32.post %14, 4
  %18 = vpush.hi.32 %15, %16
  %19, %20 = lda.i32.post %17, 4
  %21 = vpush.hi.32 %18, %19
  %22, %23 = lda.i32.post %20, 4
  %24 = vpush.hi.32 %21, %22
  %25, %26 = lda.i32.post %23, 4
  %27 = vpush.hi.32 %24, %25
  %28, %29 = lda.i32.post %26, 4
  %30 = vpush.hi.32 %27, %28
  %31, %32 = lda.i32.post %29, 4
  %33 = vpush.hi.32 %30, %31
  %34, %35 = lda.i32.post %32, 4
  %36 = vpush.hi.32 %33, %34
  %37, %38 = lda.i32.post %35, 4
  %39 = vpush.hi.32 %36, %37
  %40, %41 = lda.i32.post %38, 4
  %42 = vpush.hi.32 %39, %40
  %43, %44 = lda.i32.post %41, 4
  %45 = vpush.hi.32 %42, %43
  %46, %47 = lda.i32.post %44, 4
  %48 = vpush.hi.32 %45, %46
  %49, %50 = lda.i32.post %47, 4
  %51 = vpush.hi.32 %48, %49
  %52, %53 = lda.i32.post %50, 4
  %54 = vpush.hi.32 %51, %52
  %55, %56 = lda.i32.post %53, 4
  %57 = vpush.hi.32 %54, %55
  %58, %59 = lda.i32.post %56, 4
  %60 = vpush.hi.32 %57, %58
  %61 = add.nc.immediate %9, 64
  %62 = mov.modifier %61
  %63 = copy %source_aligned : reg<aie2p.ep> -> reg<aie2p.ep>
  %64 = padda.modifier %63, %62
  %65, %66 = lda.i32.post %64, -4
  %67 = vbcst.32 %65
  %value = concat(%60, %67) : (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) -> reg<aie2p.vec256 x4>
  return %value
}

