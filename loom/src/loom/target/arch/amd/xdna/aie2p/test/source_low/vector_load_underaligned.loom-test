  %45, %46 = lda.i32.post %44, 4
  %47 = concat(%43, %45) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  %48 = vpush.hi.64 %42, %47
  %49, %50 = lda.i32.post %46, 4
  %51, %52 = lda.i32.post %50, 4
  %53 = concat(%49, %51) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  %54 = vpush.hi.64 %48, %53
  %55, %56 = lda.i32.post %52, 4
  %57, %58 = lda.i32.post %56, 4
  %59 = concat(%55, %57) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
