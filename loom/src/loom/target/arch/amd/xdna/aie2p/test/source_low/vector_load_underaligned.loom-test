// RUN: emit source-low output=low

aie2p.target<core> @target

func.def target(@target) @load_i32x17_workgroup(%source: buffer) -> (vector<17xi32>) {
  %source_workgroup = buffer.assume.memory_space<workgroup> %source : buffer
  %source_aligned = buffer.assume.alignment %source_workgroup {minimum_alignment = 4} : buffer
  %base = index.constant 4 : offset
  %source_view = buffer.view %source_aligned[%base] : buffer -> view<17xi32>
  %value = vector.load %source_view[0] : view<17xi32> -> vector<17xi32>
  func.return %value : vector<17xi32>
}

