  %65, %66 = lda.i32.post %64, 4
  %67, %68 = lda.i32.post %66, -12
  %69 = concat(%65, %67) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  %70 = vbcst.64 %69
  %value = concat(%60, %70) : (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) -> reg<aie2p.vec256 x4>
