  %39 = vpush.lo.8 %37, %36
  %40, %41 = lda.u8.post %38, -1
  %42 = vpush.lo.8 %40, %39
  %43, %44 = lda.u8.post %41, -1
  %45 = vpush.lo.8 %43, %42
  %46, %47 = lda.u8.post %44, -1
  %48 = vpush.lo.8 %46, %45
  %49, %50 = lda.u8.post %47, -1
