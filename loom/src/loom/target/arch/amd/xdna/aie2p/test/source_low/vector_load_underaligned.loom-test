// RUN: emit source-low output=low

aie2p.target<core> @target

func.def target(@target) @load_i16x17_volatile_constant(%source: buffer) -> (vector<17xi16>) {
  %source_constant = buffer.assume.memory_space<constant> %source : buffer
  %source_aligned = buffer.assume.alignment %source_constant {minimum_alignment = 2} : buffer
  %base = index.constant 0 : offset
  %source_view = buffer.view %source_aligned[%base] : buffer -> view<17xi16>
  %value = vector.load<volatile> %source_view[0] : view<17xi16> -> vector<17xi16>
  func.return %value : vector<17xi16>
}

// ----
low.func.def target<amd.xdna.aie2p.core>(@target) abi(object_function) @load_i16x17_volatile_constant() -> (reg<aie2p.vec256 x2>) asm {
  %source_aligned = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %9 = mov.static-byte-offset 0
  %10 = add.nc.immediate %9, 32
  %11 = mov.modifier %10
  %12 = copy %source_aligned : reg<aie2p.ep> -> reg<aie2p.ep>
  %13 = padda.modifier %12, %11
  %14, %15 = lda.u16.post.volatile<volatile> %13, -2
  %16 = vbcst.16 %14
  %17, %18 = lda.u16.post.volatile<volatile> %15, -2
  %19 = vpush.lo.16 %17, %16
  %20, %21 = lda.u16.post.volatile<volatile> %18, -2
  %22 = vpush.lo.16 %20, %19
  %23, %24 = lda.u16.post.volatile<volatile> %21, -2
  %25 = vpush.lo.16 %23, %22
  %26, %27 = lda.u16.post.volatile<volatile> %24, -2
  %28 = vpush.lo.16 %26, %25
  %29, %30 = lda.u16.post.volatile<volatile> %27, -2
  %31 = vpush.lo.16 %29, %28
  %32, %33 = lda.u16.post.volatile<volatile> %30, -2
  %34 = vpush.lo.16 %32, %31
  %35, %36 = lda.u16.post.volatile<volatile> %33, -2
  %37 = vpush.lo.16 %35, %34
  %38, %39 = lda.u16.post.volatile<volatile> %36, -2
  %40 = vpush.lo.16 %38, %37
  %41, %42 = lda.u16.post.volatile<volatile> %39, -2
  %43 = vpush.lo.16 %41, %40
  %44, %45 = lda.u16.post.volatile<volatile> %42, -2
  %46 = vpush.lo.16 %44, %43
  %47, %48 = lda.u16.post.volatile<volatile> %45, -2
  %49 = vpush.lo.16 %47, %46
  %50, %51 = lda.u16.post.volatile<volatile> %48, -2
  %52 = vpush.lo.16 %50, %49
  %53, %54 = lda.u16.post.volatile<volatile> %51, -2
  %55 = vpush.lo.16 %53, %52
  %56, %57 = lda.u16.post.volatile<volatile> %54, -2
  %58 = vpush.lo.16 %56, %55
  %59, %60 = lda.u16.post.volatile<volatile> %57, -2
  %61 = vpush.lo.16 %59, %58
  %62, %63 = lda.u16.post.volatile<volatile> %60, -2
  %value = vpush.lo.16 %62, %61
  return %value
}

