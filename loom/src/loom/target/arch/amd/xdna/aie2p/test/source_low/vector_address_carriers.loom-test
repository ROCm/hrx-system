func.def @wide_address_structure(%left: vector<16xindex>, %right: vector<16xindex>, %position: index) -> (vector<32xindex>, vector<16xindex>, index) {
  %joined = vector.concat<0> %left, %right : vector<16xindex>, vector<16xindex> -> vector<32xindex>
  %window = vector.slice %joined[1] : vector<32xindex> -> vector<16xindex>
  %lane = vector.extract %joined[%position] : vector<32xindex> -> index
  func.return %joined, %window, %lane : vector<32xindex>, vector<16xindex>, index
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @wide_address_structure(%left: reg<aie2p.vec256 x2>, %right: reg<aie2p.vec256 x2>, %position: reg<aie2p.er>) -> (reg<aie2p.vec256 x4>, reg<aie2p.vec256 x2>, reg<aie2p.er>) asm {
  %joined = concat(%left, %right) : (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) -> reg<aie2p.vec256 x4>
  %18 = mova.i32 4
  %window = vshift %left, %right, %18
  %22 = mov.short 15
  %23 = mov.short 16
  %24 = and %position, %22
  %25 = and %position, %23
  %26 = vextract.32.reg %left, %24
  %27 = vextract.32.reg %right, %24
  %28 = copy %25 : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %lane = sel.nez %27, %26, %28
  return %joined, %window, %lane
}

