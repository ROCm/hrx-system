// RUN: emit source-low target=amd.xdna.aie2p:core output=low

func.def @address_constant_carriers() -> (vector<16xindex>, vector<32xoffset>, vector<64xindex>) {
  %native = vector.splati -7 : vector<16xindex>
  %wide = vector.splati 4294967295 : vector<32xoffset>
  %accumulator = vector.splati 7 : vector<64xindex>
  func.return %native, %wide, %accumulator : vector<16xindex>, vector<32xoffset>, vector<64xindex>
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @address_constant_carriers() -> (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x4>, reg<aie2p.mbms x4>) asm {
  %9 = mov.short -7
  %native = vbcst.32 %9
  %11 = mov.i32 -1
  %12 = vbcst.32 %11
  %wide = concat(%12, %12) : (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>) -> reg<aie2p.vec256 x4>
  %14 = mov.short 7
  %15 = vbcst.32 %14
  %16 = vmov.vector512.to.accumulator512 %15
  %accumulator = concat(%16, %16, %16, %16) : (reg<aie2p.mbms>, reg<aie2p.mbms>, reg<aie2p.mbms>, reg<aie2p.mbms>) -> reg<aie2p.mbms x4>
  return %native, %wide, %accumulator
}

// ====

func.def @native_address_operations(%coordinate: index, %condition: vector<16xi1>, %true_value: vector<16xoffset>, %false_value: vector<16xoffset>, %choose: i1, %other: vector<16xindex>) -> (vector<16xindex>, vector<16xoffset>, vector<16xindex>, offset) {
  %splat = vector.splat %coordinate : vector<16xindex>
  %selected = vector.select %condition, %true_value, %false_value : vector<16xoffset>
  %whole = scf.select %choose, %splat, %other : vector<16xindex>
  %lane = vector.extract %selected[15] : vector<16xoffset> -> offset
  func.return %splat, %selected, %whole, %lane : vector<16xindex>, vector<16xoffset>, vector<16xindex>, offset
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @native_address_operations(%coordinate: reg<aie2p.er>, %condition: reg<aie2p.elpredicate>, %true_value: reg<aie2p.vec256 x2>, %false_value: reg<aie2p.vec256 x2>, %choose: reg<aie2p.er>, %other: reg<aie2p.vec256 x2>) -> (reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>, reg<aie2p.vec256 x2>, reg<aie2p.er>) asm {
  %splat = vbcst.32 %coordinate
  %selected = vsel.32.mask64 %false_value, %true_value, %condition
  %26 = select.mask %choose, -1
  %whole = vsel.32 %splat, %other, %26
  %lane = vextract.32.imm %selected, 15
  return %splat, %selected, %whole, %lane
}

