  %joined = vector.concat<0> %left, %right : vector<32xoffset>, vector<32xoffset> -> vector<64xoffset>
  %high = vector.slice %joined[32] : vector<64xoffset> -> vector<32xoffset>
  func.return %joined, %high : vector<64xoffset>, vector<32xoffset>
