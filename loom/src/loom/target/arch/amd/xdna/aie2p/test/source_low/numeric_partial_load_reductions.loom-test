func.def target(@target) @bf16x31_shared_extrema_load(%input: buffer) -> (bf16, bf16) {
  %base = index.constant 0 : offset
  %aligned = buffer.assume.alignment %input {minimum_alignment = 64} : buffer
  %view = buffer.view %aligned[%base] : buffer -> view<31xbf16>
  %values = vector.load %view[0] : view<31xbf16> -> vector<31xbf16>
  %minimum_initial = scalar.constant 3.0 : bf16
  %minimum = vector.reduce<minnumf, reassoc|nnan|nsz> %values, %minimum_initial : vector<31xbf16>, bf16
  %maximum_initial = scalar.constant -3.0 : bf16
  %maximum = vector.reduce<maximumf, reassoc|nnan|nsz> %values, %maximum_initial : vector<31xbf16>, bf16
  func.return %minimum, %maximum : bf16, bf16
}

