  %27 = vmov.accumulator512.to.vector512 %26
  %28 = slice %shifted[1] : reg<aie2p.mbms x2> -> reg<aie2p.mbms>
  %29 = vmov.accumulator512.to.vector512 %28
  %30 = vmov.vector512.to.accumulator512 %29
  %31 = vexp2.bf16x16 %30
  %32 = vconv.fp32.bf16x16 %31
  %33 = vmov.accumulator512.to.vector512 %32
  %34 = vmov.vector512.to.accumulator512 %27
  %35 = vmov.vector512.to.accumulator512 %33
