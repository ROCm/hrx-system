// ====

func.def @f32x32_shift_exp_accumulate(%input: vector<32xf32>, %shift: vector<32xf32>, %accumulator: vector<32xf32>) -> (vector<32xf32>) {
  %shifted = vector.subf<nnan|ninf|nsz> %input, %shift : vector<32xf32>
  %exponent = vector.exp2f<nnan|ninf|nsz|afn> %shifted : vector<32xf32>
  %result = vector.addf<reassoc|nnan|ninf|nsz> %accumulator, %exponent : vector<32xf32>
  func.return %result : vector<32xf32>
}

