func.def @f32x32_captured_add_reduce(%values: vector<32xf32>, %count: index) -> (f32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %captured = scf.for %position = [%begin to %count step %step](%carried = %values : vector<32xf32>) -> (vector<32xf32>) {
    %next = vector.addf<reassoc|nnan|ninf|nsz> %carried, %values : vector<32xf32>
    scf.yield %next : vector<32xf32>
  }
  %initial = scalar.constant 0.0 : f32
  %result = vector.reduce<addf, reassoc|nnan|ninf|nsz> %captured, %initial : vector<32xf32>, f32
  func.return %result : f32
}

