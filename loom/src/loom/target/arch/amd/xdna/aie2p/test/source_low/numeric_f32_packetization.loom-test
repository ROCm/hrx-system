func.def @f32x32_maximum(%lhs: vector<32xf32>, %rhs: vector<32xf32>) -> (vector<32xf32>) {
  %result = vector.maxnumf<nnan|ninf|nsz> %lhs, %rhs : vector<32xf32>
  func.return %result : vector<32xf32>
}

