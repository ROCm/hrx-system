aie2p.target<core> @target

func.def target(@target) @compare_bf16_1(%lhs: vector<1xbf16>, %rhs: vector<1xbf16>) -> (vector<1xi8>) {
  %test = vector.cmpf uno, %lhs, %rhs : vector<1xbf16> -> vector<1xi1>
  %yes = vector.constant 19 : vector<1xi8>
  %no = vector.constant 7 : vector<1xi8>
  %result = vector.select %test, %yes, %no : vector<1xi8>
  func.return %result : vector<1xi8>
}

