  %small_view = buffer.view %small_source[%base] : buffer -> view<16xi8>
  %wide_view = buffer.view %wide_source[%base] : buffer -> view<17xi8>
  %small = vector.load %small_view[0] : view<16xi8> -> vector<16xi8>
  %wide = vector.load %wide_view[0] : view<17xi8> -> vector<17xi8>
  func.return %small, %wide : vector<16xi8>, vector<17xi8>
}

