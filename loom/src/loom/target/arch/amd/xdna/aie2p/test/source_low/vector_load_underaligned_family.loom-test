func.def @load_alignment_boundary(%under_source: buffer, %native_source: buffer) -> (vector<32xi8>, vector<32xi8>) {
  %under_aligned = buffer.assume.alignment %under_source {minimum_alignment = 8} : buffer
  %native_aligned = buffer.assume.alignment %native_source {minimum_alignment = 16} : buffer
  %base = index.constant 0 : offset
  %under_view = buffer.view %under_aligned[%base] : buffer -> view<32xi8>
  %native_view = buffer.view %native_aligned[%base] : buffer -> view<32xi8>
  %under = vector.load %under_view[0] : view<32xi8> -> vector<32xi8>
  %native = vector.load %native_view[0] : view<32xi8> -> vector<32xi8>
  func.return %under, %native : vector<32xi8>, vector<32xi8>
}

