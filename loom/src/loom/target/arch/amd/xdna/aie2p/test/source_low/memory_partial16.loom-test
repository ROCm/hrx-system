// TEMPLATE: loom/src/loom/test/corpus/source_low/memory_partial16.loom-test
// RUN: with-checks emit source-low target=amd.xdna.aie2p:core output=low

func.def @store_i16_17(%value: vector<17xi16>, %output: buffer) {
  %destination = buffer.assume.alignment %output {minimum_alignment = 64} : buffer
  %offset = index.constant 0 : offset
  %view = buffer.view %destination[%offset] : buffer -> view<17xi16>
  vector.store %value, %view[0] : vector<17xi16>, view<17xi16>
  func.return
}

// ----
CHECK: vst.256.*
CHECK-NOT: vinsert

// ====

func.def @store_i16_17_dynamic(%value: vector<17xi16>, %output: buffer, %position: i32) {
  %destination = buffer.assume.alignment %output {minimum_alignment = 64} : buffer
  %coordinate = scalar.assume %position [range(%position, 0, 4096), mul(%position, 64)] : i32
  %offset = index.cast %coordinate : i32 to offset
  %view = buffer.view %destination[%offset] : buffer -> view<17xi16>
  vector.store %value, %view[0] : vector<17xi16>, view<17xi16>
  func.return
}

// ----
CHECK: vst.256.*
CHECK-NOT: vinsert

// ====

