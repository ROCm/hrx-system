func.def public @call_vector_result(%input: i32, %lane: index) -> (i32) where [range(%lane, 0, 3)] {
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %c3 = scalar.constant 3 : i32
  %values = vector.from_elements %input, %c1, %c2, %c3 : vector<4xi32>
  %result = func.call @select_lane(%values, %lane) : (vector<4xi32>, index) -> (i32)
  func.return %result : i32
}

func.def @select_lane(%values: vector<4xi32>, %lane: index) -> (i32) where [range(%lane, 0, 3)] {
  %result = vector.extract %values[%lane] : vector<4xi32> -> i32
  func.return %result : i32
}

// ----
low.func.def public target<amd.xdna.aie2p.core> abi(object_function) @call_vector_result(%input: reg<aie2p.er>, %lane: reg<aie2p.er>) -> (reg<aie2p.er>) where [range(%lane, 0, 3)] asm {
  %c1 = mov.short 1
  %c2 = mov.short 2
  %c3 = mov.short 3
  %22 = vbcst.32 %input
  %24 = copy %c1 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %25 = vinsert.32.reg %22, %24, %c1
  %27 = copy %c2 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %28 = vinsert.32.reg %25, %27, %c2
  %30 = copy %c3 : reg<aie2p.er> -> reg<aie2p.mr29_insert>
  %values = vinsert.32.reg %28, %30, %c3
  %result = vextract.32.reg %values, %lane
  return %result
}

// ====

func.def public @call_loop(%input: vector<1xi32>, %delta: i32, %count: index) -> (i32) {
  %value = vector.extract %input[0] : vector<1xi32> -> i32
  %result = func.call @repeat_add(%value, %delta, %count) : (i32, i32, index) -> (i32)
  func.return %result : i32
}

func.def @repeat_add(%value: i32, %delta: i32, %count: index) -> (i32) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %result = scf.for %i = [%c0 to %count step %c1](%current = %value : i32) -> (i32) {
    %next = func.call @advance_i32(%current, %delta) : (i32, i32) -> (i32)
    scf.yield %next : i32
  }
  func.return %result : i32
}

func.def @advance_i32(%value: i32, %delta: i32) -> (i32) {
  %result = scalar.addi %value, %delta : i32
  func.return %result : i32
}

// ----
low.func.def public target<amd.xdna.aie2p.core> abi(object_function) @call_loop(%input: reg<aie2p.vec256 x2>, %delta: reg<aie2p.er>, %count: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %value = vextract.32.imm %input, 0
  %c0 = mov.short 0
  %c1 = mov.short 1
  low.br ^_bb1(%c0: reg<aie2p.er>, %value: reg<aie2p.er>)
^_bb1(%i: reg<aie2p.er>, %current: reg<aie2p.er>):
  %36 = lt %i, %count
  low.cond_br %36, ^_bb2, ^_bb3 : reg<aie2p.er>
^_bb2:
  %result = add.rr %current, %delta
  %38 = add.rr %i, %c1
  low.br ^_bb1(%38: reg<aie2p.er>, %result: reg<aie2p.er>)
^_bb3:
  return %current
}

// ====

func.def public @call_scalar(%value: i32, %delta: i32) -> (i32) {
  %result = func.call @scalar_add(%value, %delta) : (i32, i32) -> (i32)
  func.return %result : i32
}

func.def @scalar_add(%value: i32, %delta: i32) -> (i32) {
  %result = scalar.addi %value, %delta : i32
  func.return %result : i32
}

// ----
low.func.def public target<amd.xdna.aie2p.core> abi(object_function) @call_scalar(%value: reg<aie2p.er>, %delta: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %result = add.rr %value, %delta
  return %result
}
