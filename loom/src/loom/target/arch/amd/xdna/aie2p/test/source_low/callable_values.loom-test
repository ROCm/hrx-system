// TEMPLATE: loom/src/loom/test/corpus/source_low/callable_values.loom-test
// RUN: emit source-low target=amd.xdna.aie2p:core output=low

func.def public @call_mixed_i32(%input: vector<1xi32>, %delta: i32) -> (i32, i32) {
  %value = vector.extract %input[0] : vector<1xi32> -> i32
  %mixed = func.call @add_i32(%value, %delta) : (i32, i32) -> (i32)
  %uniform = func.call @add_i32(%delta, %delta) : (i32, i32) -> (i32)
  func.return %mixed, %uniform : i32, i32
}

func.def @add_i32(%value: i32, %delta: i32) -> (i32) {
  %wide_value = scalar.extui %value : i32 to i64
  %wide_delta = scalar.extui %delta : i32 to i64
  %sum = scalar.addi %wide_value, %wide_delta : i64
  %result = scalar.trunci %sum : i64 to i32
  func.return %result : i32
}

// ----
low.func.def public target<amd.xdna.aie2p.core> abi(object_function) @call_mixed_i32(%input: reg<aie2p.vec256 x2>, %delta: reg<aie2p.er>) -> (reg<aie2p.er>, reg<aie2p.er>) asm {
  %value = vextract.32.imm %input, 0
  %31, %32 = add.carry %value, %delta
  %41, %42 = add.carry %delta, %delta
  return %31, %41
}

// ====

func.def public @call_mixed_i64(%input: vector<1xi64>, %delta: i64) -> (i64, i64) {
  %value = vector.extract %input[0] : vector<1xi64> -> i64
  %mixed = func.call @add_i64(%value, %delta) : (i64, i64) -> (i64)
  %uniform = func.call @add_i64(%delta, %delta) : (i64, i64) -> (i64)
  func.return %mixed, %uniform : i64, i64
}

func.def @add_i64(%value: i64, %delta: i64) -> (i64) {
  %result = scalar.addi %value, %delta : i64
  func.return %result : i64
}

// ----
low.func.def public target<amd.xdna.aie2p.core> abi(object_function) @call_mixed_i64(%input: reg<aie2p.vec256 x2>, %delta: reg<aie2p.er x2>) -> (reg<aie2p.er x2>, reg<aie2p.er x2>) asm {
  %value = vextract.64.imm %input, 0
  %17 = slice %value[0] : reg<aie2p.er x2> -> reg<aie2p.er>
  %18 = slice %value[1] : reg<aie2p.er x2> -> reg<aie2p.er>
  %19 = slice %delta[0] : reg<aie2p.er x2> -> reg<aie2p.er>
  %20 = slice %delta[1] : reg<aie2p.er x2> -> reg<aie2p.er>
  %21, %22 = add.carry %17, %19
  %23, %24 = adc %18, %20, %22
  %result$25 = concat(%21, %23) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  %30, %31 = add.carry %19, %19
  %32, %33 = adc %20, %20, %31
  %result$34 = concat(%30, %32) : (reg<aie2p.er>, reg<aie2p.er>) -> reg<aie2p.er x2>
  return %result$25, %result$34
}

