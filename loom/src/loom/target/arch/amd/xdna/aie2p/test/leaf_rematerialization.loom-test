  %retained0, %read1 = lda.i32.post %record_input, 4
  %retained1, %read2 = lda.i32.post %read1, 4
  %retained2, %read3 = lda.i32.post %read2, 4
  %retained3, %read4 = lda.i32.post %read3, 4
  %retained4, %read5 = lda.i32.post %read4, 4
  %retained5, %read6 = lda.i32.post %read5, 4
  %retained6, %read7 = lda.i32.post %read6, 4
  %retained7, %read8 = lda.i32.post %read7, 4
  %retained8, %read9 = lda.i32.post %read8, 4
  %retained9, %read10 = lda.i32.post %read9, 4
  %retained10, %read11 = lda.i32.post %read10, 4
  %retained11, %read12 = lda.i32.post %read11, 4
  %retained12, %read13 = lda.i32.post %read12, 4
  %retained13, %read14 = lda.i32.post %read13, 4
  %retained14, %read15 = lda.i32.post %read14, 4
  %retained15, %read16 = lda.i32.post %read15, 4
  %retained16, %read17 = lda.i32.post %read16, 4
  %retained17, %read18 = lda.i32.post %read17, 4
  %retained18, %read19 = lda.i32.post %read18, 4
  %retained19, %read20 = lda.i32.post %read19, 4
  %retained20, %read21 = lda.i32.post %read20, 4
  %retained21, %read22 = lda.i32.post %read21, 4
  %retained22, %read23 = lda.i32.post %read22, 4
  %retained23, %read24 = lda.i32.post %read23, 4
  %retained24, %read25 = lda.i32.post %read24, 4
  %retained25, %read26 = lda.i32.post %read25, 4
  %scale_shift = mov.short 2
  %offset0 = mov.static-byte-offset 0
  %offset1 = mov.static-byte-offset 4
  %offset2 = mov.static-byte-offset 8
  %offset3 = mov.static-byte-offset 12
  %offset4 = mov.static-byte-offset 16
  %offset5 = mov.static-byte-offset 20
  %offset6 = mov.static-byte-offset 24
  low.br ^work
^work:
  %index0 = mov.address-index %offset0
  %value0 = lda.i32.index %stream_input, %index0
  %scaled0 = lshl %value0, %scale_shift
  st.i32.index %scaled0, %stream_output, %index0
  %index1 = mov.address-index %offset1
  %value1 = lda.i32.index %stream_input, %index1
  %scaled1 = lshl %value1, %scale_shift
  st.i32.index %scaled1, %stream_output, %index1
  %index2 = mov.address-index %offset2
  %value2 = lda.i32.index %stream_input, %index2
  %scaled2 = lshl %value2, %scale_shift
  st.i32.index %scaled2, %stream_output, %index2
  %index3 = mov.address-index %offset3
  %value3 = lda.i32.index %stream_input, %index3
  %scaled3 = lshl %value3, %scale_shift
  st.i32.index %scaled3, %stream_output, %index3
  %index4 = mov.address-index %offset4
  %value4 = lda.i32.index %stream_input, %index4
  %scaled4 = lshl %value4, %scale_shift
  st.i32.index %scaled4, %stream_output, %index4
  %index5 = mov.address-index %offset5
  %value5 = lda.i32.index %stream_input, %index5
  %scaled5 = lshl %value5, %scale_shift
  st.i32.index %scaled5, %stream_output, %index5
  %index6 = mov.address-index %offset6
  %value6 = lda.i32.index %stream_input, %index6
  %scaled6 = lshl %value6, %scale_shift
  st.i32.index %scaled6, %stream_output, %index6
  low.br ^finish
^finish:
  %write1 = st.i32.post %retained0, %record_output, 4
  %write2 = st.i32.post %retained1, %write1, 4
  %write3 = st.i32.post %retained2, %write2, 4
  %write4 = st.i32.post %retained3, %write3, 4
  %write5 = st.i32.post %retained4, %write4, 4
  %write6 = st.i32.post %retained5, %write5, 4
  %write7 = st.i32.post %retained6, %write6, 4
  %write8 = st.i32.post %retained7, %write7, 4
  %write9 = st.i32.post %retained8, %write8, 4
  %write10 = st.i32.post %retained9, %write9, 4
  %write11 = st.i32.post %retained10, %write10, 4
  %write12 = st.i32.post %retained11, %write11, 4
  %write13 = st.i32.post %retained12, %write12, 4
  %write14 = st.i32.post %retained13, %write13, 4
  %write15 = st.i32.post %retained14, %write14, 4
  %write16 = st.i32.post %retained15, %write15, 4
  %write17 = st.i32.post %retained16, %write16, 4
  %write18 = st.i32.post %retained17, %write17, 4
  %write19 = st.i32.post %retained18, %write18, 4
  %write20 = st.i32.post %retained19, %write19, 4
  %write21 = st.i32.post %retained20, %write20, 4
  %write22 = st.i32.post %retained21, %write21, 4
  %write23 = st.i32.post %retained22, %write22, 4
  %write24 = st.i32.post %retained23, %write23, 4
  %write25 = st.i32.post %retained24, %write24, 4
  %write26 = st.i32.post %retained25, %write25, 4
  return
}

// ----
%retained0 -> st.i32.post operand=0 (%retained0, %record_output)
%retained1 -> st.i32.post operand=0 (%retained1, %write1)
%retained2 -> st.i32.post operand=0 (%retained2, %write2)
%retained3 -> st.i32.post operand=0 (%retained3, %write3)
%retained4 -> st.i32.post operand=0 (%retained4, %write4)
%retained5 -> st.i32.post operand=0 (%retained5, %write5)
%retained6 -> st.i32.post operand=0 (%retained6, %write6)
%retained7 -> st.i32.post operand=0 (%retained7, %write7)
%retained8 -> st.i32.post operand=0 (%retained8, %write8)
%retained9 -> st.i32.post operand=0 (%retained9, %write9)
%retained10 -> st.i32.post operand=0 (%retained10, %write10)
%retained11 -> st.i32.post operand=0 (%retained11, %write11)
%retained12 -> st.i32.post operand=0 (%retained12, %write12)
%retained13 -> st.i32.post operand=0 (%retained13, %write13)
%retained14 -> st.i32.post operand=0 (%retained14, %write14)
%retained15 -> st.i32.post operand=0 (%retained15, %write15)
%retained16 -> st.i32.post operand=0 (%retained16, %write16)
%retained17 -> st.i32.post operand=0 (%retained17, %write17)
%retained18 -> st.i32.post operand=0 (%retained18, %write18)
%retained19 -> st.i32.post operand=0 (%retained19, %write19)
%retained20 -> st.i32.post operand=0 (%retained20, %write20)
%retained21 -> st.i32.post operand=0 (%retained21, %write21)
%retained22 -> st.i32.post operand=0 (%retained22, %write22)
%retained23 -> st.i32.post operand=0 (%retained23, %write23)
%retained24 -> st.i32.post operand=0 (%retained24, %write24)
%retained25 -> st.i32.post operand=0 (%retained25, %write25)
%value0 -> lshl operand=0 (%value0, %scale_shift_remat)
%value1 -> lshl operand=0 (%value1, %scale_shift_remat)
%value2 -> lshl operand=0 (%value2, %scale_shift_remat)
%value3 -> lshl operand=0 (%value3, %scale_shift_remat)
%value4 -> lshl operand=0 (%value4, %scale_shift_remat)
%value5 -> lshl operand=0 (%value5, %scale_shift_remat)
%value6 -> lshl operand=0 (%value6, %scale_shift_remat)
%scaled0 -> st.i32.index operand=0 (%scaled0, %stream_output, %index0)
%scaled1 -> st.i32.index operand=0 (%scaled1, %stream_output, %index1)
%scaled2 -> st.i32.index operand=0 (%scaled2, %stream_output, %index2)
%scaled3 -> st.i32.index operand=0 (%scaled3, %stream_output, %index3)
%scaled4 -> st.i32.index operand=0 (%scaled4, %stream_output, %index4)
%scaled5 -> st.i32.index operand=0 (%scaled5, %stream_output, %index5)
%scaled6 -> st.i32.index operand=0 (%scaled6, %stream_output, %index6)
%index0 -> lda.i32.index operand=1 (%stream_input, %index0)
%index0 -> st.i32.index operand=2 (%scaled0, %stream_output, %index0)
%index1 -> lda.i32.index operand=1 (%stream_input, %index1)
%index1 -> st.i32.index operand=2 (%scaled1, %stream_output, %index1)
%index2 -> lda.i32.index operand=1 (%stream_input, %index2)
%index2 -> st.i32.index operand=2 (%scaled2, %stream_output, %index2)
%index3 -> lda.i32.index operand=1 (%stream_input, %index3)
%index3 -> st.i32.index operand=2 (%scaled3, %stream_output, %index3)
%index4 -> lda.i32.index operand=1 (%stream_input, %index4)
%index4 -> st.i32.index operand=2 (%scaled4, %stream_output, %index4)
%index5 -> lda.i32.index operand=1 (%stream_input, %index5)
%index5 -> st.i32.index operand=2 (%scaled5, %stream_output, %index5)
%index6 -> lda.i32.index operand=1 (%stream_input, %index6)
%index6 -> st.i32.index operand=2 (%scaled6, %stream_output, %index6)

// ====

// Source-order allocation has no scheduling consumer for retained placement.
// Each data-dependent index has one user, but all nine results must coexist:
// genuine per-user cloning cannot make them fit the eight-register class.
// RUN: pass low-materialize-allocation

low.func.def target<amd.xdna.aie2p.core> @irreducible_private_indices(%position0: reg<aie2p.er>, %position1: reg<aie2p.er>, %position2: reg<aie2p.er>, %position3: reg<aie2p.er>, %position4: reg<aie2p.er>, %position5: reg<aie2p.er>, %position6: reg<aie2p.er>, %position7: reg<aie2p.er>, %position8: reg<aie2p.er>) -> (reg<aie2p.edj>, reg<aie2p.edj>, reg<aie2p.edj>, reg<aie2p.edj>, reg<aie2p.edj>, reg<aie2p.edj>, reg<aie2p.edj>, reg<aie2p.edj>, reg<aie2p.edj>) asm {
  %index0 = mov.address-index %position0
  %index1 = mov.address-index %position1
  %index2 = mov.address-index %position2
  %index3 = mov.address-index %position3
  %index4 = mov.address-index %position4
  %index5 = mov.address-index %position5
  %index6 = mov.address-index %position6
  // ERROR@+1: BACKEND/005 "aie2p.edj" "budget 8" "peak 9" "spill-traffic-register-exhausted"
  %index7 = mov.address-index %position7
  %index8 = mov.address-index %position8
  return %index0, %index1, %index2, %index3, %index4, %index5, %index6, %index7, %index8
}

// ----

// ====

// Fifteen two-register live-ins leave two ER registers available. Three early
// extract/zero-extend pairs exceed the bank until allocation replays both
// instructions next to their reduction uses. The extracts read immutable
// vaddSign0 target state, so replay preserves their zero-extension mode.
// RUN: emit aie2p-leaf @packed_extract_extend_pressure diagnostics=predicted-spills

// Each spill plan contributes a consumer-first replay batch. Rebuilding
// allocation exposes the next extraction and extension repair.
aie2p.target<core> @target

// REMARK@+2: BACKEND/045 {function_name="packed_extract_extend_pressure", trigger_kind="spill-plan", repaired_value_count="1", cloned_packet_count="1", rewritten_operand_count="1", retained_placement_count="0"}
// REMARK@+1: BACKEND/045 {function_name="packed_extract_extend_pressure", trigger_kind="spill-plan", repaired_value_count="1", cloned_packet_count="1", rewritten_operand_count="1", retained_placement_count="0"}
low.func.def schedule(locked) target<amd.xdna.aie2p.core>(@target) @packed_extract_extend_pressure(%packed: reg<aie2p.vec256 x2>, %keep0: reg<aie2p.er x2>, %keep1: reg<aie2p.er x2>, %keep2: reg<aie2p.er x2>, %keep3: reg<aie2p.er x2>, %keep4: reg<aie2p.er x2>, %keep5: reg<aie2p.er x2>, %keep6: reg<aie2p.er x2>, %keep7: reg<aie2p.er x2>, %keep8: reg<aie2p.er x2>, %keep9: reg<aie2p.er x2>, %keep10: reg<aie2p.er x2>, %keep11: reg<aie2p.er x2>, %keep12: reg<aie2p.er x2>, %keep13: reg<aie2p.er x2>, %keep14: reg<aie2p.er x2>) -> (reg<aie2p.er>, reg<aie2p.er x2>, reg<aie2p.er x2>, reg<aie2p.er x2>, reg<aie2p.er x2>, reg<aie2p.er x2>, reg<aie2p.er x2>, reg<aie2p.er x2>, reg<aie2p.er x2>, reg<aie2p.er x2>, reg<aie2p.er x2>, reg<aie2p.er x2>, reg<aie2p.er x2>, reg<aie2p.er x2>, reg<aie2p.er x2>, reg<aie2p.er x2>) asm {
  %byte0 = vextract.8.imm %packed, 0
  %wide0 = extend.u8 %byte0
  %byte1 = vextract.8.imm %packed, 1
  %wide1 = extend.u8 %byte1
  %byte2 = vextract.8.imm %packed, 2
  %wide2 = extend.u8 %byte2
  %sum1 = add.rr %wide0, %wide1
  %sum2 = add.rr %sum1, %wide2
  return %sum2, %keep0, %keep1, %keep2, %keep3, %keep4, %keep5, %keep6, %keep7, %keep8, %keep9, %keep10, %keep11, %keep12, %keep13, %keep14
}

// ----

// ====

// Six record fields and their maximum remain live while binary32
// multiplication computes a nonzero row's scale. Shared constants use ordinary
// rematerialization under scalar pressure. A private zero feeding a fixed-r27
// select must wait for arithmetic to release ordinary storage; exposing the
// fixed copy alone does not make that setup actionable while it incurs debt.
// Retained private constants share their consumer's prerequisite ordering.
// The emission summary bounds the resulting scalar schedule and code size.
// RUN: emit aie2p-leaf @retained_scale_select report=emission

aie2p.target<core> @target

low.func.def target<amd.xdna.aie2p.core>(@target) @retained_scale_select(%record_input: reg<aie2p.ep>, %record_output: reg<aie2p.ep>) asm {
  %retained0, %read1 = lda.i32.post %record_input, 4
  %retained1, %read2 = lda.i32.post %read1, 4
  %retained2, %read3 = lda.i32.post %read2, 4
  %retained3, %read4 = lda.i32.post %read3, 4
  %retained4, %read5 = lda.i32.post %read4, 4
  %retained5, %read6 = lda.i32.post %read5, 4
  %maximum_f32_bits, %read7 = lda.i32.post %read6, 4
  %zero = mov.short 0
  %unit_bit = mov.short 1
  %inverse_code_limit = mov.i32 1006699012
  %sign_mask = mov.i32 -2147483648
  %halfword_right_shift = mov.short -16
  %halfword_left_shift = mov.short 16
  %product_alignment_shift = mov.short 8
  %infinity = mov.i32 2139095040
  low.br ^scale
^scale:
  %magnitude_mask = mov.i32 2147483647
  %fraction_width = mov.short 23
  %negative_fraction_width = mov.short -23
  %implicit_bit = mov.i32 8388608
  %left_magnitude = and %maximum_f32_bits, %magnitude_mask
  %right_magnitude = and %inverse_code_limit, %magnitude_mask
  %operand_signs = xor %maximum_f32_bits, %inverse_code_limit
  %product_sign = and %operand_signs, %sign_mask
  %left_exponent = lshl %left_magnitude, %negative_fraction_width
  %left_exponent_bits = lshl %left_exponent, %fraction_width
  %left_fraction = sub %left_magnitude, %left_exponent_bits
  %left_leading_zeros = clz %left_fraction
  %left_normalization = add %left_leading_zeros, -8
  %left_exponent_condition = copy %left_exponent : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %left_shift = sel.eqz %left_normalization, %zero, %left_exponent_condition
  %left_shifted_fraction = lshl %left_fraction, %left_shift
  %left_significand = or %left_shifted_fraction, %implicit_bit
  %left_negative_normalization = sub %zero, %left_normalization
  %left_subnormal_exponent = add %left_negative_normalization, 1
  %left_adjusted_condition = copy %left_exponent : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %left_adjusted_exponent = sel.eqz %left_subnormal_exponent, %left_exponent, %left_adjusted_condition
  %right_exponent = lshl %right_magnitude, %negative_fraction_width
  %right_exponent_bits = lshl %right_exponent, %fraction_width
  %right_fraction = sub %right_magnitude, %right_exponent_bits
  %right_leading_zeros = clz %right_fraction
  %right_normalization = add %right_leading_zeros, -8
  %right_exponent_condition = copy %right_exponent : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %right_shift = sel.eqz %right_normalization, %zero, %right_exponent_condition
  %right_shifted_fraction = lshl %right_fraction, %right_shift
  %right_significand = or %right_shifted_fraction, %implicit_bit
  %right_negative_normalization = sub %zero, %right_normalization
  %right_subnormal_exponent = add %right_negative_normalization, 1
  %right_adjusted_condition = copy %right_exponent : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %right_adjusted_exponent = sel.eqz %right_subnormal_exponent, %right_exponent, %right_adjusted_condition
  %halfword_mask = mov.i32 65535
  %product_cross_word_shift = mov.short -24
  %left_lower = and %left_significand, %halfword_mask
  %left_upper = lshl %left_significand, %halfword_right_shift
  %right_lower = and %right_significand, %halfword_mask
  %right_upper = lshl %right_significand, %halfword_right_shift
  %lower_product = mul %left_lower, %right_lower
  %cross_product_left = mul %left_lower, %right_upper
  %cross_product_right = mul %left_upper, %right_lower
  %cross_product = add.rr %cross_product_left, %cross_product_right
  %shifted_cross_product = lshl %cross_product, %halfword_left_shift
  %lower_sum = add.rr %lower_product, %shifted_cross_product
  %lower_carry = ltu %lower_sum, %lower_product
  %upper_product = mul %left_upper, %right_upper
  %cross_upper = lshl %cross_product, %halfword_right_shift
  %upper_partial = add.rr %upper_product, %cross_upper
  %upper_sum = add.rr %upper_partial, %lower_carry
  %upper_shifted = lshl %upper_sum, %product_alignment_shift
  %lower_high_bits = lshl %lower_sum, %product_cross_word_shift
  %product_upper = or %upper_shifted, %lower_high_bits
  %product_lower = lshl %lower_sum, %product_alignment_shift
  %negative_exponent_bias = mov.short -127
  %top_bit_shift = mov.short -31
  %exponent_sum = add.rr %left_adjusted_exponent, %right_adjusted_exponent
  %unbiased_exponent = add.rr %exponent_sum, %negative_exponent_bias
  %product_implicit_bit = and %product_upper, %implicit_bit
  %product_normalization = nez %product_implicit_bit
  %product_exponent = add.rr %unbiased_exponent, %product_normalization
  %upper_doubled = lshl %product_upper, %unit_bit
  %lower_top_bit = lshl %product_lower, %top_bit_shift
  %normalized_upper = or %upper_doubled, %lower_top_bit
  %normalized_lower = lshl %product_lower, %unit_bit
  %upper_normalization_condition = copy %product_implicit_bit : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %upper_word = sel.nez %product_upper, %normalized_upper, %upper_normalization_condition
  %lower_normalization_condition = copy %product_implicit_bit : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %lower_word = sel.nez %product_lower, %normalized_lower, %lower_normalization_condition
  %word_shift_mask = mov.short 31
  %negative_product_exponent = sub %zero, %product_exponent
  %subnormal_shift = add %negative_product_exponent, 1
  %wrapped_shift = and %subnormal_shift, %word_shift_mask
  %negative_shift = sub %zero, %wrapped_shift
  %complementary_shift = and %negative_shift, %word_shift_mask
  %shifted_lower = lshl %lower_word, %negative_shift
  %upper_remainder = lshl %upper_word, %complementary_shift
  %lower_remainder = lshl %lower_word, %complementary_shift
  %lower_sticky = nez %lower_remainder
  %shifted_upper = lshl %upper_word, %negative_shift
  %joined_lower = or %shifted_lower, %upper_remainder
  %sticky_lower = or %joined_lower, %lower_sticky
  %nonzero_shift_condition = copy %wrapped_shift : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %shifted_remainder = sel.nez %upper_remainder, %zero, %nonzero_shift_condition
  %whole_lower_remainder = or %lower_word, %shifted_remainder
  %whole_lower_sticky = nez %whole_lower_remainder
  %sticky_upper = or %shifted_upper, %whole_lower_sticky
  %whole_product = or %upper_word, %lower_word
  %whole_product_sticky = nez %whole_product
  %beyond_first_word = add %subnormal_shift, -32
  %inside_first_word = lt %beyond_first_word, %zero
  %beyond_second_word = add %subnormal_shift, -64
  %inside_second_word = lt %beyond_second_word, %zero
  %second_word_condition = copy %inside_second_word : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %wide_shift_lower = sel.nez %sticky_upper, %whole_product_sticky, %second_word_condition
  %first_word_lower_condition = copy %inside_first_word : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %subnormal_lower = sel.nez %sticky_lower, %wide_shift_lower, %first_word_lower_condition
  %first_word_upper_condition = copy %inside_first_word : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %subnormal_upper = sel.nez %shifted_upper, %zero, %first_word_upper_condition
  %fraction_mask = add %implicit_bit, -1
  %normal_fraction = and %upper_word, %fraction_mask
  %normal_exponent = lshl %product_exponent, %fraction_width
  %normal_upper = or %normal_fraction, %normal_exponent
  %is_subnormal = ge %zero, %product_exponent
  %upper_selection_condition = copy %is_subnormal : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %rounded_upper_source = sel.nez %subnormal_upper, %normal_upper, %upper_selection_condition
  %lower_selection_condition = copy %is_subnormal : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %rounded_lower_source = sel.nez %subnormal_lower, %lower_word, %lower_selection_condition
  %above_midpoint = ltu %sign_mask, %rounded_lower_source
  %at_midpoint = eq %rounded_lower_source, %sign_mask
  %low_significand_bit = and %rounded_upper_source, %unit_bit
  %odd_midpoint = and %at_midpoint, %low_significand_bit
  %round_increment = or %above_midpoint, %odd_midpoint
  %signed_significand = or %rounded_upper_source, %product_sign
  %rounded_product = add.rr %signed_significand, %round_increment
  %negative_exponent_limit = mov.short -255
  %quiet_nan_bit = mov.i32 4194304
  %signed_infinity = or %infinity, %product_sign
  %exponent_overflow = add.rr %product_exponent, %negative_exponent_limit
  %overflow = ge %exponent_overflow, %zero
  %overflow_condition = copy %overflow : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %finite_or_overflow = sel.nez %signed_infinity, %rounded_product, %overflow_condition
  %left_is_zero = eqz %left_magnitude
  %right_is_zero = eqz %right_magnitude
  %either_is_zero = or %left_is_zero, %right_is_zero
  %zero_product_condition = copy %either_is_zero : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %finite_or_zero = sel.nez %product_sign, %finite_or_overflow, %zero_product_condition
  %canonical_nan = or %infinity, %quiet_nan_bit
  %left_is_infinite = eq %left_magnitude, %infinity
  %right_is_infinite = eq %right_magnitude, %infinity
  %right_zero_condition = copy %right_is_zero : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %left_infinite_result = sel.nez %canonical_nan, %signed_infinity, %right_zero_condition
  %left_zero_condition = copy %left_is_zero : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %right_infinite_result = sel.nez %canonical_nan, %signed_infinity, %left_zero_condition
  %right_infinite_condition = copy %right_is_infinite : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %right_special_result = sel.nez %right_infinite_result, %finite_or_zero, %right_infinite_condition
  %left_infinite_condition = copy %left_is_infinite : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %infinite_result = sel.nez %left_infinite_result, %right_special_result, %left_infinite_condition
  %left_is_nan = ltu %infinity, %left_magnitude
  %right_is_nan = ltu %infinity, %right_magnitude
  %left_nan = or %maximum_f32_bits, %quiet_nan_bit
  %right_nan = or %inverse_code_limit, %quiet_nan_bit
  %right_nan_condition = copy %right_is_nan : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %right_nan_result = sel.nez %right_nan, %infinite_result, %right_nan_condition
  %left_nan_condition = copy %left_is_nan : reg<aie2p.er> -> reg<aie2p.mr27_select>
  %scale_f32 = sel.nez %left_nan, %right_nan_result, %left_nan_condition
  low.br ^finish
^finish:
  %write1 = st.i32.post %retained0, %record_output, 4
  %write2 = st.i32.post %retained1, %write1, 4
  %write3 = st.i32.post %retained2, %write2, 4
  %write4 = st.i32.post %retained3, %write3, 4
  %write5 = st.i32.post %retained4, %write4, 4
  %write6 = st.i32.post %retained5, %write5, 4
  %write7 = st.i32.post %maximum_f32_bits, %write6, 4
  %write8 = st.i32.post %scale_f32, %write7, 4
  return
}

