// ====

// Loading the store payload leaves a feasible initial schedule. Private
// indices retain normal latency scheduling until allocation requires repair.
// Eagerly forcing every index next to its store would serialize this control.
// RUN: emit aie2p-leaf @payload_dependent_store_indices report=emission

low.func.def target<amd.xdna.aie2p.core> @payload_dependent_store_indices(%source: reg<aie2p.ep>, %destination: reg<aie2p.ep>, %cell: reg<aie2p.er>, %position0: reg<aie2p.er>, %position1: reg<aie2p.er>, %position2: reg<aie2p.er>, %position3: reg<aie2p.er>, %position4: reg<aie2p.er>, %position5: reg<aie2p.er>, %position6: reg<aie2p.er>, %position7: reg<aie2p.er>, %position8: reg<aie2p.er>) asm {
  %cell_offset = mov.static-byte-offset 256
  %cell_stride = mov.i32 256
  %load_position = mac %cell_offset, %cell, %cell_stride
  %load_index = mov.address-index %load_position
  %payload = vlda.acc.index %source, %load_index
  %store_index0 = mov.address-index %position0
  vst.acc.index %payload, %destination, %store_index0
  %store_index1 = mov.address-index %position1
  vst.acc.index %payload, %destination, %store_index1
  %store_index2 = mov.address-index %position2
  vst.acc.index %payload, %destination, %store_index2
  %store_index3 = mov.address-index %position3
  vst.acc.index %payload, %destination, %store_index3
  %store_index4 = mov.address-index %position4
  vst.acc.index %payload, %destination, %store_index4
  %store_index5 = mov.address-index %position5
  vst.acc.index %payload, %destination, %store_index5
  %store_index6 = mov.address-index %position6
  vst.acc.index %payload, %destination, %store_index6
  %store_index7 = mov.address-index %position7
  vst.acc.index %payload, %destination, %store_index7
  %store_index8 = mov.address-index %position8
  vst.acc.index %payload, %destination, %store_index8
  return
}

