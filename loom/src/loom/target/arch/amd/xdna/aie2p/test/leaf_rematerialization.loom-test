// ====

// Symbolic bases have the same EP pressure. Every rematerialized address keeps
// its data identity, and its absolute relocation follows each worker placement.
// The final pointer update consumes the output address, so pricing that value
// as freely reconstructible would choose real stack traffic over these bases.
// RUN: emit aie2p-xdna output=sections

global.rodata.def @coefficient0 = align(4) bytes("01000000")

global.rodata.def @coefficient1 = align(4) bytes("02000000")

global.rodata.def @coefficient2 = align(4) bytes("03000000")

global.rodata.def @coefficient3 = align(4) bytes("04000000")

global.rodata.def @coefficient4 = align(4) bytes("05000000")

global.rodata.def @coefficient5 = align(4) bytes("06000000")

global.rodata.def @coefficient6 = align(4) bytes("07000000")

global.rodata.def @coefficient7 = align(4) bytes("08000000")

global.rodata.def @coefficient8 = align(4) bytes("09000000")

aie2p.target<configuration> @configuration {device_profile = "amd.xdna.strix.17f0_10"}

aie2p.target<core> @core

low.func.def public retain target<amd.xdna.aie2p.configuration>(@configuration) abi(array_program) @symbolic_address_pressure() asm {
  %columns = constant 2 : reg<aie2p.config.scalar : i64>
  entry %columns, @initialize, @invoke
  return
}

low.func.def target<amd.xdna.aie2p.configuration>(@configuration) @initialize() asm {
  %first_column = constant 0 : reg<aie2p.config.scalar : i64>
  %second_column = constant 1 : reg<aie2p.config.scalar : i64>
  %row = constant 3 : reg<aie2p.config.scalar : i64>
  %origin = constant 0 : reg<aie2p.config.scalar : i64>
  %bank_bytes = constant 16384 : reg<aie2p.config.scalar : i64>
  data.reserve %first_column, %row, %origin, %bank_bytes
  program.load %first_column, %row, @read_coefficients
  program.load %second_column, %row, @read_coefficients
  return
}

low.func.def target<amd.xdna.aie2p.configuration>(@configuration) @invoke() asm {
  return
}

low.func.def target<amd.xdna.aie2p.core>(@core) abi(object_function) @read_coefficients() asm {
  %scratch = storage {byte_alignment = 64, byte_length = 64} : low.storage<private>
  %output = storage_address %scratch : low.storage<private> -> reg<aie2p.ep>
  %table0 = mov.local-address @coefficient0
  %table1 = mov.local-address @coefficient1
  %table2 = mov.local-address @coefficient2
  %table3 = mov.local-address @coefficient3
  %table4 = mov.local-address @coefficient4
  %table5 = mov.local-address @coefficient5
  %table6 = mov.local-address @coefficient6
  %table7 = mov.local-address @coefficient7
  %table8 = mov.local-address @coefficient8
  low.br ^read
^read:
  %value0 = lda %table0, 0
  st %value0, %output, 0
  %value1 = lda %table1, 0
  st %value1, %output, 4
  %value2 = lda %table2, 0
  st %value2, %output, 8
  %value3 = lda %table3, 0
  st %value3, %output, 12
  %value4 = lda %table4, 0
  st %value4, %output, 16
  %value5 = lda %table5, 0
  st %value5, %output, 20
  %value6 = lda %table6, 0
  st %value6, %output, 24
  %value7 = lda %table7, 0
  st %value7, %output, 28
  %value8 = lda %table8, 0
  %output_end = padda %output, 64
  st %value8, %output_end, -32
  return
}

