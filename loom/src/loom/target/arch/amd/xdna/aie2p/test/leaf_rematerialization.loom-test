// ====

// Nine endpoint bases exceed the eight EP registers across the block boundary.
// Recreate each constant address near its store without retaining all bases.
// RUN: emit aie2p-leaf @literal_address_pressure report=code uses=payload

aie2p.target<core> @target

low.func.def target<amd.xdna.aie2p.core>(@target) @literal_address_pressure(%payload: reg<aie2p.er>) asm {
  %endpoint0 = mov.local-address 458752
  %endpoint1 = mov.local-address 458816
  %endpoint2 = mov.local-address 458880
  %endpoint3 = mov.local-address 458944
  %endpoint4 = mov.local-address 459008
  %endpoint5 = mov.local-address 459072
  %endpoint6 = mov.local-address 459136
  %endpoint7 = mov.local-address 459200
  %endpoint8 = mov.local-address 459264
  low.br ^publish
^publish:
  st %payload, %endpoint0, 0
  st %payload, %endpoint1, 0
  st %payload, %endpoint2, 0
  st %payload, %endpoint3, 0
  st %payload, %endpoint4, 0
  st %payload, %endpoint5, 0
  st %payload, %endpoint6, 0
  st %payload, %endpoint7, 0
  st %payload, %endpoint8, 0
  return
}

