issue cycles: 185
code bytes: 744
coissued bundles: 10
coissued components: 21

// ====

// Keep a record's 26 loaded fields resident across a seven-word stream. The
// initial scalar pressure requires rematerializing stream offsets and shifts.
// Their input-free clones must remain use-local while indexed memory consumers
// are blocked, or rescheduling exceeds the same 32-register bank again.
// RUN: with-checks emit aie2p-leaf @retained_scalar_stream report=emission

low.func.def target<amd.xdna.aie2p.core> @retained_scalar_stream(%record_input: reg<aie2p.ep>, %stream_input: reg<aie2p.ep>, %stream_output: reg<aie2p.ep>, %record_output: reg<aie2p.ep>) asm {
  %retained0, %read1 = lda.i32.post %record_input, 4
  %retained1, %read2 = lda.i32.post %read1, 4
  %retained2, %read3 = lda.i32.post %read2, 4
  %retained3, %read4 = lda.i32.post %read3, 4
