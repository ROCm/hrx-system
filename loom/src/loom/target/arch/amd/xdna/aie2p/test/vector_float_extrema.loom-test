  %14 = vector.cmpi slt, %11, %5 : vector<4xi16> -> vector<4xi1>
  %15 = vector.addi %11, %9 : vector<4xi16>
  %16 = vector.subi %10, %11 : vector<4xi16>
  %17 = vector.select %14, %16, %15 : vector<4xi16>
  %18 = vector.bitcast %lower : vector<4xf16> to vector<4xi16>
  %19 = vector.andi %18, %6 : vector<4xi16>
  %20 = vector.cmpi ugt, %19, %7 : vector<4xi16> -> vector<4xi1>
  %21 = vector.cmpi slt, %18, %5 : vector<4xi16> -> vector<4xi1>
  %22 = vector.addi %18, %9 : vector<4xi16>
  %23 = vector.subi %10, %18 : vector<4xi16>
  %24 = vector.select %21, %23, %22 : vector<4xi16>
  %25 = vector.bitcast %upper : vector<4xf16> to vector<4xi16>
  %26 = vector.andi %25, %6 : vector<4xi16>
  %27 = vector.cmpi ugt, %26, %7 : vector<4xi16> -> vector<4xi1>
  %28 = vector.cmpi slt, %25, %5 : vector<4xi16> -> vector<4xi1>
  %29 = vector.addi %25, %9 : vector<4xi16>
  %30 = vector.subi %10, %25 : vector<4xi16>
