  %12 = vector.andi %11, %6 : vector<4xi32>
  %13 = vector.cmpi ugt, %12, %7 : vector<4xi32> -> vector<4xi1>
  %14 = vector.cmpi slt, %11, %5 : vector<4xi32> -> vector<4xi1>
  %15 = vector.addi %11, %9 : vector<4xi32>
  %16 = vector.subi %10, %11 : vector<4xi32>
  %17 = vector.select %14, %16, %15 : vector<4xi32>
  %18 = vector.bitcast %lower : vector<4xf32> to vector<4xi32>
  %19 = vector.andi %18, %6 : vector<4xi32>
  %20 = vector.cmpi ugt, %19, %7 : vector<4xi32> -> vector<4xi1>
  %21 = vector.cmpi slt, %18, %5 : vector<4xi32> -> vector<4xi1>
  %22 = vector.addi %18, %9 : vector<4xi32>
  %23 = vector.subi %10, %18 : vector<4xi32>
  %24 = vector.select %21, %23, %22 : vector<4xi32>
  %25 = vector.bitcast %upper : vector<4xf32> to vector<4xi32>
  %26 = vector.andi %25, %6 : vector<4xi32>
  %27 = vector.cmpi ugt, %26, %7 : vector<4xi32> -> vector<4xi1>
  %28 = vector.cmpi slt, %25, %5 : vector<4xi32> -> vector<4xi1>
  %29 = vector.addi %25, %9 : vector<4xi32>
  %30 = vector.subi %10, %25 : vector<4xi32>
  %31 = vector.select %28, %30, %29 : vector<4xi32>
  %32 = vector.cmpi ugt, %17, %24 : vector<4xi32> -> vector<4xi1>
  %33 = vector.select %32, %11, %18 : vector<4xi32>
  %34 = vector.select %32, %17, %24 : vector<4xi32>
  %35 = vector.ori %13, %20 : vector<4xi1>
  %36 = vector.select %20, %18, %33 : vector<4xi32>
  %37 = vector.select %20, %24, %34 : vector<4xi32>
  %38 = vector.select %13, %11, %36 : vector<4xi32>
  %39 = vector.select %13, %17, %37 : vector<4xi32>
  %40 = vector.cmpi ult, %39, %31 : vector<4xi32> -> vector<4xi1>
  %41 = vector.select %40, %38, %25 : vector<4xi32>
  %42 = vector.ori %35, %27 : vector<4xi1>
  %43 = vector.select %27, %25, %41 : vector<4xi32>
  %44 = vector.select %35, %38, %43 : vector<4xi32>
  %45 = vector.ori %44, %8 : vector<4xi32>
  %46 = vector.select %42, %45, %44 : vector<4xi32>
  %result = vector.bitcast %46 : vector<4xi32> to vector<4xf32>
