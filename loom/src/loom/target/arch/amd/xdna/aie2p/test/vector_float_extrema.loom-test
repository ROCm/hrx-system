// RUN: pass target=amd.xdna.aie2p:core target-legalize{mode=final}

// The finite-only E4M3 encoding reserves its maximum magnitude for NaN and
// has no quiet-NaN bit.
func.def @finite_nan_minimum_f8e4m3(%lhs: vector<4xf8E4M3>, %rhs: vector<4xf8E4M3>) -> (vector<4xf8E4M3>) {
  %result = vector.minimumf %lhs, %rhs : vector<4xf8E4M3>
  func.return %result : vector<4xf8E4M3>
}

// ----
func.def @finite_nan_minimum_f8e4m3(%lhs: vector<4xf8E4M3>, %rhs: vector<4xf8E4M3>) -> (vector<4xf8E4M3>) {
  %4 = vector.splati 0 : vector<4xi8>
  %5 = vector.splati 127 : vector<4xi8>
  %6 = vector.splati 127 : vector<4xi8>
  %7 = vector.splati -128 : vector<4xi8>
  %8 = vector.splati -1 : vector<4xi8>
  %9 = vector.bitcast %lhs : vector<4xf8E4M3> to vector<4xi8>
  %10 = vector.andi %9, %5 : vector<4xi8>
  %11 = vector.cmpi eq, %10, %6 : vector<4xi8> -> vector<4xi1>
  %12 = vector.cmpi slt, %9, %4 : vector<4xi8> -> vector<4xi1>
  %13 = vector.addi %9, %7 : vector<4xi8>
  %14 = vector.subi %8, %9 : vector<4xi8>
  %15 = vector.select %12, %14, %13 : vector<4xi8>
  %16 = vector.bitcast %rhs : vector<4xf8E4M3> to vector<4xi8>
  %17 = vector.andi %16, %5 : vector<4xi8>
  %18 = vector.cmpi eq, %17, %6 : vector<4xi8> -> vector<4xi1>
  %19 = vector.cmpi slt, %16, %4 : vector<4xi8> -> vector<4xi1>
  %20 = vector.addi %16, %7 : vector<4xi8>
  %21 = vector.subi %8, %16 : vector<4xi8>
  %22 = vector.select %19, %21, %20 : vector<4xi8>
  %23 = vector.cmpi ult, %15, %22 : vector<4xi8> -> vector<4xi1>
  %24 = vector.select %23, %9, %16 : vector<4xi8>
  %26 = vector.select %18, %16, %24 : vector<4xi8>
  %27 = vector.select %11, %9, %26 : vector<4xi8>
  %result = vector.bitcast %27 : vector<4xi8> to vector<4xf8E4M3>
  func.return %result : vector<4xf8E4M3>
}

// ====

// The IEEE E5M2 encoding selects a numeric operand over one NaN and quiets
// the selected payload when both operands are NaNs.
func.def @ieee_minnum_f8e5m2(%lhs: vector<4xf8E5M2>, %rhs: vector<4xf8E5M2>) -> (vector<4xf8E5M2>) {
  %result = vector.minnumf %lhs, %rhs : vector<4xf8E5M2>
  func.return %result : vector<4xf8E5M2>
}

// ----
func.def @ieee_minnum_f8e5m2(%lhs: vector<4xf8E5M2>, %rhs: vector<4xf8E5M2>) -> (vector<4xf8E5M2>) {
  %4 = vector.splati 0 : vector<4xi8>
  %5 = vector.splati 127 : vector<4xi8>
  %6 = vector.splati 124 : vector<4xi8>
  %7 = vector.splati 2 : vector<4xi8>
  %8 = vector.splati -128 : vector<4xi8>
  %9 = vector.splati -1 : vector<4xi8>
  %10 = vector.bitcast %lhs : vector<4xf8E5M2> to vector<4xi8>
  %11 = vector.andi %10, %5 : vector<4xi8>
  %12 = vector.cmpi ugt, %11, %6 : vector<4xi8> -> vector<4xi1>
  %13 = vector.cmpi slt, %10, %4 : vector<4xi8> -> vector<4xi1>
  %14 = vector.addi %10, %8 : vector<4xi8>
  %15 = vector.subi %9, %10 : vector<4xi8>
  %16 = vector.select %13, %15, %14 : vector<4xi8>
  %17 = vector.bitcast %rhs : vector<4xf8E5M2> to vector<4xi8>
  %18 = vector.andi %17, %5 : vector<4xi8>
  %19 = vector.cmpi ugt, %18, %6 : vector<4xi8> -> vector<4xi1>
  %20 = vector.cmpi slt, %17, %4 : vector<4xi8> -> vector<4xi1>
  %21 = vector.addi %17, %8 : vector<4xi8>
  %22 = vector.subi %9, %17 : vector<4xi8>
  %23 = vector.select %20, %22, %21 : vector<4xi8>
  %24 = vector.cmpi ult, %16, %23 : vector<4xi8> -> vector<4xi1>
  %25 = vector.select %24, %10, %17 : vector<4xi8>
  %26 = vector.andi %12, %19 : vector<4xi1>
  %27 = vector.select %19, %10, %25 : vector<4xi8>
  %28 = vector.select %12, %17, %27 : vector<4xi8>
  %29 = vector.ori %28, %7 : vector<4xi8>
  %30 = vector.select %26, %29, %28 : vector<4xi8>
  %result = vector.bitcast %30 : vector<4xi8> to vector<4xf8E5M2>
  func.return %result : vector<4xf8E5M2>
}

// ====

// Ordered clamp preserves strict compare/select behavior, including retaining
// the value operand when signed-zero encodings compare equal.
func.def @ordered_clamp_bf16(%value: vector<4xbf16>, %lower: vector<4xbf16>, %upper: vector<4xbf16>) -> (vector<4xbf16>) {
  %result = vector.clampf<ordered> %value, %lower, %upper : vector<4xbf16>
  func.return %result : vector<4xbf16>
}

// ----
func.def @ordered_clamp_bf16(%value: vector<4xbf16>, %lower: vector<4xbf16>, %upper: vector<4xbf16>) -> (vector<4xbf16>) {
  %5 = vector.splati 0 : vector<4xi16>
  %6 = vector.splati 32767 : vector<4xi16>
  %7 = vector.splati 32640 : vector<4xi16>
  %8 = vector.splati -32768 : vector<4xi16>
  %9 = vector.splati -1 : vector<4xi16>
  %10 = vector.bitcast %value : vector<4xbf16> to vector<4xi16>
  %11 = vector.andi %10, %6 : vector<4xi16>
  %12 = vector.cmpi ugt, %11, %7 : vector<4xi16> -> vector<4xi1>
  %13 = vector.cmpi slt, %10, %5 : vector<4xi16> -> vector<4xi1>
  %14 = vector.addi %10, %8 : vector<4xi16>
  %15 = vector.subi %9, %10 : vector<4xi16>
  %16 = vector.select %13, %15, %14 : vector<4xi16>
  %17 = vector.bitcast %lower : vector<4xbf16> to vector<4xi16>
  %18 = vector.andi %17, %6 : vector<4xi16>
  %19 = vector.cmpi ugt, %18, %7 : vector<4xi16> -> vector<4xi1>
  %20 = vector.cmpi slt, %17, %5 : vector<4xi16> -> vector<4xi1>
  %21 = vector.addi %17, %8 : vector<4xi16>
  %22 = vector.subi %9, %17 : vector<4xi16>
  %23 = vector.select %20, %22, %21 : vector<4xi16>
  %24 = vector.bitcast %upper : vector<4xbf16> to vector<4xi16>
  %25 = vector.andi %24, %6 : vector<4xi16>
  %26 = vector.cmpi ugt, %25, %7 : vector<4xi16> -> vector<4xi1>
  %27 = vector.cmpi slt, %24, %5 : vector<4xi16> -> vector<4xi1>
  %28 = vector.addi %24, %8 : vector<4xi16>
  %29 = vector.subi %9, %24 : vector<4xi16>
  %30 = vector.select %27, %29, %28 : vector<4xi16>
  %31 = vector.cmpi eq, %11, %5 : vector<4xi16> -> vector<4xi1>
  %32 = vector.select %31, %8, %16 : vector<4xi16>
  %33 = vector.cmpi eq, %18, %5 : vector<4xi16> -> vector<4xi1>
  %34 = vector.select %33, %8, %23 : vector<4xi16>
  %35 = vector.cmpi eq, %25, %5 : vector<4xi16> -> vector<4xi1>
  %36 = vector.select %35, %8, %30 : vector<4xi16>
  %37 = vector.cmpi uge, %32, %34 : vector<4xi16> -> vector<4xi1>
  %38 = vector.select %37, %10, %17 : vector<4xi16>
  %39 = vector.select %37, %32, %34 : vector<4xi16>
  %40 = vector.select %19, %10, %38 : vector<4xi16>
  %41 = vector.select %19, %32, %39 : vector<4xi16>
  %42 = vector.select %12, %10, %40 : vector<4xi16>
  %43 = vector.select %12, %32, %41 : vector<4xi16>
  %44 = vector.cmpi ule, %43, %36 : vector<4xi16> -> vector<4xi1>
  %45 = vector.select %44, %42, %24 : vector<4xi16>
  %46 = vector.select %26, %42, %45 : vector<4xi16>
  %47 = vector.select %12, %42, %46 : vector<4xi16>
  %result = vector.bitcast %47 : vector<4xi16> to vector<4xbf16>
  func.return %result : vector<4xbf16>
}

// ====

// Number clamp composes maxnum and minnum selection.
func.def @number_clamp_f16(%value: vector<4xf16>, %lower: vector<4xf16>, %upper: vector<4xf16>) -> (vector<4xf16>) {
  %result = vector.clampf<number> %value, %lower, %upper : vector<4xf16>
  func.return %result : vector<4xf16>
}

