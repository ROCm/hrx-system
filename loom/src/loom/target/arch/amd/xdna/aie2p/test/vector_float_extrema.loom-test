// RUN: pass target=amd.xdna.aie2p:core target-legalize{mode=final}

// The finite-only E4M3 encoding reserves its maximum magnitude for NaN and
// has no quiet-NaN bit.
func.def @finite_nan_minimum_f8e4m3(%lhs: vector<4xf8E4M3>, %rhs: vector<4xf8E4M3>) -> (vector<4xf8E4M3>) {
  %result = vector.minimumf %lhs, %rhs : vector<4xf8E4M3>
  func.return %result : vector<4xf8E4M3>
}

// ----
func.def @finite_nan_minimum_f8e4m3(%lhs: vector<4xf8E4M3>, %rhs: vector<4xf8E4M3>) -> (vector<4xf8E4M3>) {
  %4 = scalar.constant 0 : i8
  %5 = vector.splat %4 : vector<4xi8>
  %6 = scalar.constant 127 : i8
  %7 = vector.splat %6 : vector<4xi8>
  %8 = scalar.constant 127 : i8
  %9 = vector.splat %8 : vector<4xi8>
  %10 = scalar.constant -128 : i8
  %11 = vector.splat %10 : vector<4xi8>
  %12 = scalar.constant -1 : i8
  %13 = vector.splat %12 : vector<4xi8>
  %14 = vector.bitcast %lhs : vector<4xf8E4M3> to vector<4xi8>
  %15 = vector.andi %14, %7 : vector<4xi8>
  %16 = vector.cmpi eq, %15, %9 : vector<4xi8> -> vector<4xi1>
  %17 = vector.cmpi slt, %14, %5 : vector<4xi8> -> vector<4xi1>
  %18 = vector.addi %14, %11 : vector<4xi8>
  %19 = vector.subi %13, %14 : vector<4xi8>
  %20 = vector.select %17, %19, %18 : vector<4xi8>
  %21 = vector.bitcast %rhs : vector<4xf8E4M3> to vector<4xi8>
  %22 = vector.andi %21, %7 : vector<4xi8>
  %23 = vector.cmpi eq, %22, %9 : vector<4xi8> -> vector<4xi1>
  %24 = vector.cmpi slt, %21, %5 : vector<4xi8> -> vector<4xi1>
  %25 = vector.addi %21, %11 : vector<4xi8>
  %26 = vector.subi %13, %21 : vector<4xi8>
  %27 = vector.select %24, %26, %25 : vector<4xi8>
  %28 = vector.cmpi ult, %20, %27 : vector<4xi8> -> vector<4xi1>
  %29 = vector.select %28, %14, %21 : vector<4xi8>
  %31 = vector.select %23, %21, %29 : vector<4xi8>
  %32 = vector.select %16, %14, %31 : vector<4xi8>
  %result = vector.bitcast %32 : vector<4xi8> to vector<4xf8E4M3>
  func.return %result : vector<4xf8E4M3>
}

// ====

// The IEEE E5M2 encoding selects a numeric operand over one NaN and quiets
// the selected payload when both operands are NaNs.
func.def @ieee_minnum_f8e5m2(%lhs: vector<4xf8E5M2>, %rhs: vector<4xf8E5M2>) -> (vector<4xf8E5M2>) {
  %result = vector.minnumf %lhs, %rhs : vector<4xf8E5M2>
  func.return %result : vector<4xf8E5M2>
}

// ----
func.def @ieee_minnum_f8e5m2(%lhs: vector<4xf8E5M2>, %rhs: vector<4xf8E5M2>) -> (vector<4xf8E5M2>) {
  %4 = scalar.constant 0 : i8
  %5 = vector.splat %4 : vector<4xi8>
  %6 = scalar.constant 127 : i8
  %7 = vector.splat %6 : vector<4xi8>
  %8 = scalar.constant 124 : i8
  %9 = vector.splat %8 : vector<4xi8>
  %10 = scalar.constant 2 : i8
  %11 = vector.splat %10 : vector<4xi8>
  %12 = scalar.constant -128 : i8
  %13 = vector.splat %12 : vector<4xi8>
  %14 = scalar.constant -1 : i8
  %15 = vector.splat %14 : vector<4xi8>
  %16 = vector.bitcast %lhs : vector<4xf8E5M2> to vector<4xi8>
  %17 = vector.andi %16, %7 : vector<4xi8>
  %18 = vector.cmpi ugt, %17, %9 : vector<4xi8> -> vector<4xi1>
  %19 = vector.cmpi slt, %16, %5 : vector<4xi8> -> vector<4xi1>
  %20 = vector.addi %16, %13 : vector<4xi8>
  %21 = vector.subi %15, %16 : vector<4xi8>
  %22 = vector.select %19, %21, %20 : vector<4xi8>
  %23 = vector.bitcast %rhs : vector<4xf8E5M2> to vector<4xi8>
  %24 = vector.andi %23, %7 : vector<4xi8>
  %25 = vector.cmpi ugt, %24, %9 : vector<4xi8> -> vector<4xi1>
  %26 = vector.cmpi slt, %23, %5 : vector<4xi8> -> vector<4xi1>
  %27 = vector.addi %23, %13 : vector<4xi8>
  %28 = vector.subi %15, %23 : vector<4xi8>
  %29 = vector.select %26, %28, %27 : vector<4xi8>
  %30 = vector.cmpi ult, %22, %29 : vector<4xi8> -> vector<4xi1>
  %31 = vector.select %30, %16, %23 : vector<4xi8>
  %32 = vector.andi %18, %25 : vector<4xi1>
  %33 = vector.select %25, %16, %31 : vector<4xi8>
  %34 = vector.select %18, %23, %33 : vector<4xi8>
  %35 = vector.ori %34, %11 : vector<4xi8>
  %36 = vector.select %32, %35, %34 : vector<4xi8>
  %result = vector.bitcast %36 : vector<4xi8> to vector<4xf8E5M2>
  func.return %result : vector<4xf8E5M2>
}

// ====

// Ordered clamp preserves strict compare/select behavior, including retaining
// the value operand when signed-zero encodings compare equal.
func.def @ordered_clamp_bf16(%value: vector<4xbf16>, %lower: vector<4xbf16>, %upper: vector<4xbf16>) -> (vector<4xbf16>) {
  %result = vector.clampf<ordered> %value, %lower, %upper : vector<4xbf16>
  func.return %result : vector<4xbf16>
}

// ----
func.def @ordered_clamp_bf16(%value: vector<4xbf16>, %lower: vector<4xbf16>, %upper: vector<4xbf16>) -> (vector<4xbf16>) {
  %5 = scalar.constant 0 : i16
  %6 = vector.splat %5 : vector<4xi16>
  %7 = scalar.constant 32767 : i16
  %8 = vector.splat %7 : vector<4xi16>
  %9 = scalar.constant 32640 : i16
  %10 = vector.splat %9 : vector<4xi16>
  %11 = scalar.constant -32768 : i16
  %12 = vector.splat %11 : vector<4xi16>
  %13 = scalar.constant -1 : i16
  %14 = vector.splat %13 : vector<4xi16>
  %15 = vector.bitcast %value : vector<4xbf16> to vector<4xi16>
  %16 = vector.andi %15, %8 : vector<4xi16>
  %17 = vector.cmpi ugt, %16, %10 : vector<4xi16> -> vector<4xi1>
  %18 = vector.cmpi slt, %15, %6 : vector<4xi16> -> vector<4xi1>
  %19 = vector.addi %15, %12 : vector<4xi16>
  %20 = vector.subi %14, %15 : vector<4xi16>
  %21 = vector.select %18, %20, %19 : vector<4xi16>
  %22 = vector.bitcast %lower : vector<4xbf16> to vector<4xi16>
  %23 = vector.andi %22, %8 : vector<4xi16>
  %24 = vector.cmpi ugt, %23, %10 : vector<4xi16> -> vector<4xi1>
  %25 = vector.cmpi slt, %22, %6 : vector<4xi16> -> vector<4xi1>
  %26 = vector.addi %22, %12 : vector<4xi16>
  %27 = vector.subi %14, %22 : vector<4xi16>
  %28 = vector.select %25, %27, %26 : vector<4xi16>
  %29 = vector.bitcast %upper : vector<4xbf16> to vector<4xi16>
  %30 = vector.andi %29, %8 : vector<4xi16>
  %31 = vector.cmpi ugt, %30, %10 : vector<4xi16> -> vector<4xi1>
  %32 = vector.cmpi slt, %29, %6 : vector<4xi16> -> vector<4xi1>
  %33 = vector.addi %29, %12 : vector<4xi16>
  %34 = vector.subi %14, %29 : vector<4xi16>
  %35 = vector.select %32, %34, %33 : vector<4xi16>
  %36 = vector.cmpi eq, %16, %6 : vector<4xi16> -> vector<4xi1>
  %37 = vector.select %36, %12, %21 : vector<4xi16>
  %38 = vector.cmpi eq, %23, %6 : vector<4xi16> -> vector<4xi1>
  %39 = vector.select %38, %12, %28 : vector<4xi16>
  %40 = vector.cmpi eq, %30, %6 : vector<4xi16> -> vector<4xi1>
  %41 = vector.select %40, %12, %35 : vector<4xi16>
  %42 = vector.cmpi uge, %37, %39 : vector<4xi16> -> vector<4xi1>
  %43 = vector.select %42, %15, %22 : vector<4xi16>
  %44 = vector.select %42, %37, %39 : vector<4xi16>
  %45 = vector.select %24, %15, %43 : vector<4xi16>
  %46 = vector.select %24, %37, %44 : vector<4xi16>
  %47 = vector.select %17, %15, %45 : vector<4xi16>
  %48 = vector.select %17, %37, %46 : vector<4xi16>
  %49 = vector.cmpi ule, %48, %41 : vector<4xi16> -> vector<4xi1>
  %50 = vector.select %49, %47, %29 : vector<4xi16>
  %51 = vector.select %31, %47, %50 : vector<4xi16>
  %52 = vector.select %17, %47, %51 : vector<4xi16>
  %result = vector.bitcast %52 : vector<4xi16> to vector<4xbf16>
  func.return %result : vector<4xbf16>
}

// ====

// Number clamp composes maxnum and minnum selection.
func.def @number_clamp_f16(%value: vector<4xf16>, %lower: vector<4xf16>, %upper: vector<4xf16>) -> (vector<4xf16>) {
  %result = vector.clampf<number> %value, %lower, %upper : vector<4xf16>
  func.return %result : vector<4xf16>
}

// ----
func.def @number_clamp_f16(%value: vector<4xf16>, %lower: vector<4xf16>, %upper: vector<4xf16>) -> (vector<4xf16>) {
  %5 = scalar.constant 0 : i16
  %6 = vector.splat %5 : vector<4xi16>
  %7 = scalar.constant 32767 : i16
  %8 = vector.splat %7 : vector<4xi16>
  %9 = scalar.constant 31744 : i16
  %10 = vector.splat %9 : vector<4xi16>
  %11 = scalar.constant 512 : i16
  %12 = vector.splat %11 : vector<4xi16>
  %13 = scalar.constant -32768 : i16
  %14 = vector.splat %13 : vector<4xi16>
  %15 = scalar.constant -1 : i16
  %16 = vector.splat %15 : vector<4xi16>
  %17 = vector.bitcast %value : vector<4xf16> to vector<4xi16>
  %18 = vector.andi %17, %8 : vector<4xi16>
  %19 = vector.cmpi ugt, %18, %10 : vector<4xi16> -> vector<4xi1>
  %20 = vector.cmpi slt, %17, %6 : vector<4xi16> -> vector<4xi1>
  %21 = vector.addi %17, %14 : vector<4xi16>
  %22 = vector.subi %16, %17 : vector<4xi16>
  %23 = vector.select %20, %22, %21 : vector<4xi16>
  %24 = vector.bitcast %lower : vector<4xf16> to vector<4xi16>
  %25 = vector.andi %24, %8 : vector<4xi16>
  %26 = vector.cmpi ugt, %25, %10 : vector<4xi16> -> vector<4xi1>
  %27 = vector.cmpi slt, %24, %6 : vector<4xi16> -> vector<4xi1>
  %28 = vector.addi %24, %14 : vector<4xi16>
  %29 = vector.subi %16, %24 : vector<4xi16>
  %30 = vector.select %27, %29, %28 : vector<4xi16>
  %31 = vector.bitcast %upper : vector<4xf16> to vector<4xi16>
  %32 = vector.andi %31, %8 : vector<4xi16>
  %33 = vector.cmpi ugt, %32, %10 : vector<4xi16> -> vector<4xi1>
  %34 = vector.cmpi slt, %31, %6 : vector<4xi16> -> vector<4xi1>
  %35 = vector.addi %31, %14 : vector<4xi16>
  %36 = vector.subi %16, %31 : vector<4xi16>
  %37 = vector.select %34, %36, %35 : vector<4xi16>
  %38 = vector.cmpi ugt, %23, %30 : vector<4xi16> -> vector<4xi1>
  %39 = vector.select %38, %17, %24 : vector<4xi16>
  %40 = vector.select %38, %23, %30 : vector<4xi16>
  %41 = vector.andi %19, %26 : vector<4xi1>
  %42 = vector.select %26, %17, %39 : vector<4xi16>
  %43 = vector.select %26, %23, %40 : vector<4xi16>
  %44 = vector.select %19, %24, %42 : vector<4xi16>
  %45 = vector.select %19, %30, %43 : vector<4xi16>
  %46 = vector.cmpi ult, %45, %37 : vector<4xi16> -> vector<4xi1>
  %47 = vector.select %46, %44, %31 : vector<4xi16>
  %48 = vector.andi %41, %33 : vector<4xi1>
  %49 = vector.select %33, %44, %47 : vector<4xi16>
  %50 = vector.select %41, %31, %49 : vector<4xi16>
  %51 = vector.ori %50, %12 : vector<4xi16>
  %52 = vector.select %48, %51, %50 : vector<4xi16>
  %result = vector.bitcast %52 : vector<4xi16> to vector<4xf16>
