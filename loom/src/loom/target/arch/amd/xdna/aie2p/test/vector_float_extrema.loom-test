// ====

// IEEE clamp propagates and quiets a NaN from any operand.
func.def @ieee_clamp_f32(%value: vector<4xf32>, %lower: vector<4xf32>, %upper: vector<4xf32>) -> (vector<4xf32>) {
  %result = vector.clampf<ieee> %value, %lower, %upper : vector<4xf32>
  func.return %result : vector<4xf32>
}

// ----
func.def @ieee_clamp_f32(%value: vector<4xf32>, %lower: vector<4xf32>, %upper: vector<4xf32>) -> (vector<4xf32>) {
  %5 = scalar.constant 0 : i32
  %6 = vector.splat %5 : vector<4xi32>
  %7 = scalar.constant 2147483647 : i32
  %8 = vector.splat %7 : vector<4xi32>
  %9 = scalar.constant 2139095040 : i32
  %10 = vector.splat %9 : vector<4xi32>
  %11 = scalar.constant 4194304 : i32
  %12 = vector.splat %11 : vector<4xi32>
  %13 = scalar.constant -2147483648 : i32
  %14 = vector.splat %13 : vector<4xi32>
  %15 = scalar.constant -1 : i32
  %16 = vector.splat %15 : vector<4xi32>
  %17 = vector.bitcast %value : vector<4xf32> to vector<4xi32>
  %18 = vector.andi %17, %8 : vector<4xi32>
  %19 = vector.cmpi ugt, %18, %10 : vector<4xi32> -> vector<4xi1>
  %20 = vector.cmpi slt, %17, %6 : vector<4xi32> -> vector<4xi1>
  %21 = vector.addi %17, %14 : vector<4xi32>
  %22 = vector.subi %16, %17 : vector<4xi32>
  %23 = vector.select %20, %22, %21 : vector<4xi32>
  %24 = vector.bitcast %lower : vector<4xf32> to vector<4xi32>
  %25 = vector.andi %24, %8 : vector<4xi32>
  %26 = vector.cmpi ugt, %25, %10 : vector<4xi32> -> vector<4xi1>
  %27 = vector.cmpi slt, %24, %6 : vector<4xi32> -> vector<4xi1>
  %28 = vector.addi %24, %14 : vector<4xi32>
  %29 = vector.subi %16, %24 : vector<4xi32>
  %30 = vector.select %27, %29, %28 : vector<4xi32>
  %31 = vector.bitcast %upper : vector<4xf32> to vector<4xi32>
  %32 = vector.andi %31, %8 : vector<4xi32>
  %33 = vector.cmpi ugt, %32, %10 : vector<4xi32> -> vector<4xi1>
  %34 = vector.cmpi slt, %31, %6 : vector<4xi32> -> vector<4xi1>
  %35 = vector.addi %31, %14 : vector<4xi32>
  %36 = vector.subi %16, %31 : vector<4xi32>
  %37 = vector.select %34, %36, %35 : vector<4xi32>
  %38 = vector.cmpi ugt, %23, %30 : vector<4xi32> -> vector<4xi1>
  %39 = vector.select %38, %17, %24 : vector<4xi32>
  %40 = vector.select %38, %23, %30 : vector<4xi32>
  %41 = vector.ori %19, %26 : vector<4xi1>
  %42 = vector.select %26, %24, %39 : vector<4xi32>
  %43 = vector.select %26, %30, %40 : vector<4xi32>
  %44 = vector.select %19, %17, %42 : vector<4xi32>
  %45 = vector.select %19, %23, %43 : vector<4xi32>
  %46 = vector.cmpi ult, %45, %37 : vector<4xi32> -> vector<4xi1>
  %47 = vector.select %46, %44, %31 : vector<4xi32>
  %48 = vector.ori %41, %33 : vector<4xi1>
  %49 = vector.select %33, %31, %47 : vector<4xi32>
  %50 = vector.select %41, %44, %49 : vector<4xi32>
  %51 = vector.ori %50, %12 : vector<4xi32>
  %52 = vector.select %48, %51, %50 : vector<4xi32>
  %result = vector.bitcast %52 : vector<4xi32> to vector<4xf32>
  func.return %result : vector<4xf32>
}

// ====

// Relaxed extrema discard NaN classification and signed-zero normalization.
// The F64 clamp is the highest-pressure form because each 512-bit packet
// consumes the complete eight-lane predicate carrier.
func.def @relaxed_clamp_f64(%value: vector<8xf64>, %lower: vector<8xf64>, %upper: vector<8xf64>) -> (vector<8xf64>) {
  %result = vector.clampf<ieee, nnan|nsz> %value, %lower, %upper : vector<8xf64>
  func.return %result : vector<8xf64>
}

// ----
func.def @relaxed_clamp_f64(%value: vector<8xf64>, %lower: vector<8xf64>, %upper: vector<8xf64>) -> (vector<8xf64>) {
  %5 = scalar.constant 0 : i64
  %6 = vector.splat %5 : vector<8xi64>
  %7 = scalar.constant -9223372036854775808 : i64
  %8 = vector.splat %7 : vector<8xi64>
  %9 = scalar.constant -1 : i64
  %10 = vector.splat %9 : vector<8xi64>
  %11 = vector.bitcast %value : vector<8xf64> to vector<8xi64>
  %12 = vector.cmpi slt, %11, %6 : vector<8xi64> -> vector<8xi1>
  %13 = vector.select %12, %10, %8 : vector<8xi64>
  %14 = vector.xori %11, %13 : vector<8xi64>
  %15 = vector.bitcast %lower : vector<8xf64> to vector<8xi64>
  %16 = vector.cmpi slt, %15, %6 : vector<8xi64> -> vector<8xi1>
  %17 = vector.select %16, %10, %8 : vector<8xi64>
  %18 = vector.xori %15, %17 : vector<8xi64>
  %19 = vector.bitcast %upper : vector<8xf64> to vector<8xi64>
  %20 = vector.cmpi slt, %19, %6 : vector<8xi64> -> vector<8xi1>
  %21 = vector.select %20, %10, %8 : vector<8xi64>
  %22 = vector.xori %19, %21 : vector<8xi64>
  %23 = vector.cmpi ugt, %14, %18 : vector<8xi64> -> vector<8xi1>
  %24 = vector.select %23, %11, %15 : vector<8xi64>
  %25 = vector.select %23, %14, %18 : vector<8xi64>
  %26 = vector.cmpi ult, %25, %22 : vector<8xi64> -> vector<8xi1>
  %27 = vector.select %26, %24, %19 : vector<8xi64>
  %result = vector.bitcast %27 : vector<8xi64> to vector<8xf64>
  func.return %result : vector<8xf64>
}

// ====

// The shaped F64 case crosses one 512-bit integer and predicate packet.
func.def @wide_shaped_maximum_f64(%lhs: vector<3x3xf64>, %rhs: vector<3x3xf64>) -> (vector<3x3xf64>) {
  %result = vector.maximumf %lhs, %rhs : vector<3x3xf64>
  func.return %result : vector<3x3xf64>
}

// ----
func.def @wide_shaped_maximum_f64(%lhs: vector<3x3xf64>, %rhs: vector<3x3xf64>) -> (vector<3x3xf64>) {
  %4 = vector.bitcast %lhs : vector<3x3xf64> to vector<9xf64>
  %5 = vector.bitcast %rhs : vector<3x3xf64> to vector<9xf64>
  %6 = vector.slice %4[0] : vector<9xf64> -> vector<8xf64>
  %7 = vector.slice %5[0] : vector<9xf64> -> vector<8xf64>
  %8 = scalar.constant 0 : i64
  %9 = vector.splat %8 : vector<8xi64>
  %10 = scalar.constant 9223372036854775807 : i64
  %11 = vector.splat %10 : vector<8xi64>
  %12 = scalar.constant 9218868437227405312 : i64
  %13 = vector.splat %12 : vector<8xi64>
  %14 = scalar.constant 2251799813685248 : i64
  %15 = vector.splat %14 : vector<8xi64>
  %16 = scalar.constant -9223372036854775808 : i64
  %17 = vector.splat %16 : vector<8xi64>
  %18 = scalar.constant -1 : i64
  %19 = vector.splat %18 : vector<8xi64>
  %20 = vector.bitcast %6 : vector<8xf64> to vector<8xi64>
  %21 = vector.andi %20, %11 : vector<8xi64>
  %22 = vector.cmpi ugt, %21, %13 : vector<8xi64> -> vector<8xi1>
  %23 = vector.cmpi slt, %20, %9 : vector<8xi64> -> vector<8xi1>
  %24 = vector.select %23, %19, %17 : vector<8xi64>
  %25 = vector.xori %20, %24 : vector<8xi64>
  %26 = vector.bitcast %7 : vector<8xf64> to vector<8xi64>
  %27 = vector.andi %26, %11 : vector<8xi64>
  %28 = vector.cmpi ugt, %27, %13 : vector<8xi64> -> vector<8xi1>
  %29 = vector.cmpi slt, %26, %9 : vector<8xi64> -> vector<8xi1>
  %30 = vector.select %29, %19, %17 : vector<8xi64>
  %31 = vector.xori %26, %30 : vector<8xi64>
  %32 = vector.cmpi ugt, %25, %31 : vector<8xi64> -> vector<8xi1>
  %33 = vector.select %32, %20, %26 : vector<8xi64>
  %34 = vector.ori %22, %28 : vector<8xi1>
  %35 = vector.select %28, %26, %33 : vector<8xi64>
  %36 = vector.select %22, %20, %35 : vector<8xi64>
  %37 = vector.ori %36, %15 : vector<8xi64>
  %38 = vector.select %34, %37, %36 : vector<8xi64>
  %39 = vector.bitcast %38 : vector<8xi64> to vector<8xf64>
  %40 = vector.slice %4[8] : vector<9xf64> -> vector<1xf64>
  %41 = vector.slice %5[8] : vector<9xf64> -> vector<1xf64>
  %42 = scalar.constant 0 : i64
  %43 = vector.splat %42 : vector<1xi64>
  %44 = scalar.constant 9223372036854775807 : i64
  %45 = vector.splat %44 : vector<1xi64>
  %46 = scalar.constant 9218868437227405312 : i64
  %47 = vector.splat %46 : vector<1xi64>
  %48 = scalar.constant 2251799813685248 : i64
  %49 = vector.splat %48 : vector<1xi64>
  %50 = scalar.constant -9223372036854775808 : i64
  %51 = vector.splat %50 : vector<1xi64>
  %52 = scalar.constant -1 : i64
  %53 = vector.splat %52 : vector<1xi64>
  %54 = vector.bitcast %40 : vector<1xf64> to vector<1xi64>
  %55 = vector.andi %54, %45 : vector<1xi64>
  %56 = vector.cmpi ugt, %55, %47 : vector<1xi64> -> vector<1xi1>
  %57 = vector.cmpi slt, %54, %43 : vector<1xi64> -> vector<1xi1>
  %58 = vector.select %57, %53, %51 : vector<1xi64>
